"+        \"@abseil-cpp//absl/status\",","+        \"@abseil-cpp//absl/status:statusor\",","+        \"@abseil-cpp//absl/strings\",","+        \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","+        \"@envoy_api//envoy/extensions/load_balancing_policies/host_allowlist/v3:pkg_cc_proto\",","+    ],","+)"],"additions":53,"deletions":0,"truncated":false},{"path":"source/extensions/load_balancing_policies/host_allowlist/config.cc","lines":["@@ -0,0 +1,51 @@","+#include \"source/extensions/load_balancing_policies/host_allowlist/config.h\"","+","+#include \"envoy/common/exception.h\"","+#include \"envoy/extensions/load_balancing_policies/host_allowlist/v3/host_allowlist.pb.h\"","+#include \"envoy/extensions/load_balancing_policies/host_allowlist/v3/host_allowlist.pb.validate.h\"","+#include \"envoy/registry/registry.h\"","+#include \"envoy/server/factory_context.h\"","+","+#include \"source/common/common/assert.h\"","+#include \"source/common/protobuf/utility.h\"","+#include \"source/extensions/load_balancing_policies/host_allowlist/load_balancer.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace LoadBalancingPolicies {","+namespace HostAllowlist {","+","+using HostAllowlistProto =","+    envoy::extensions::load_balancing_policies::host_allowlist::v3::HostAllowlist;","+","+absl::StatusOr<Upstream::LoadBalancerConfigPtr>","+HostAllowlistLoadBalancerFactory::loadConfig(Server::Configuration::ServerFactoryContext& context,","+                                             const Protobuf::Message& config) {","+  const HostAllowlistProto& host_allowlist_config =","+      MessageUtil::downcastAndValidate<const HostAllowlistProto&>(","+          config, context.messageValidationVisitor());","+  ASSERT(host_allowlist_config.has_child_policy());","+  return HostAllowlistLbConfig::make(host_allowlist_config, context);","+}","+","+Upstream::ThreadAwareLoadBalancerPtr","+HostAllowlistLoadBalancerFactory::create(OptRef<const Upstream::LoadBalancerConfig> lb_config,","+                                         const ClusterInfo& cluster_info,","+                                         const PrioritySet& priority_set, Loader& runtime,","+                                         RandomGenerator& random, TimeSource& time_source) {","+  ASSERT(lb_config.has_value());","+  const auto& host_allowlist_lb_config =","+      dynamic_cast<const HostAllowlistLbConfig&>(lb_config.ref());","+  Upstream::ThreadAwareLoadBalancerPtr child_lb =","+      host_allowlist_lb_config.create(cluster_info, priority_set, runtime, random, time_source);","+  ASSERT(child_lb != nullptr);","+  return std::make_unique<HostAllowlistLoadBalancer>(host_allowlist_lb_config, std::move(child_lb),","+                                                     cluster_info.statsScope());","+}","+","+REGISTER_FACTORY(HostAllowlistLoadBalancerFactory, Upstream::TypedLoadBalancerFactory);","+","+} // namespace HostAllowlist","+} // namespace LoadBalancingPolicies","+} // namespace Extensions","+} // namespace Envoy"],"additions":51,"deletions":0,"truncated":false},{"path":"source/extensions/load_balancing_policies/host_allowlist/config.h","lines":["@@ -0,0 +1,47 @@","+#pragma once","+","+#include \"envoy/common/optref.h\"","+#include \"envoy/common/random_generator.h\"","+#include \"envoy/common/time.h\"","+#include \"envoy/extensions/load_balancing_policies/host_allowlist/v3/host_allowlist.pb.h\"","+#include \"envoy/runtime/runtime.h\"","+#include \"envoy/upstream/load_balancer.h\"","+#include \"envoy/upstream/upstream.h\"","+","+#include \"source/common/protobuf/protobuf.h\"","+#include \"source/common/upstream/load_balancer_factory_base.h\"","+","+#include \"absl/status/statusor.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace LoadBalancingPolicies {","+namespace HostAllowlist {","+","+using HostAllowlistProto =","+    envoy::extensions::load_balancing_policies::host_allowlist::v3::HostAllowlist;","+using ::Envoy::Random::RandomGenerator;","+using ::Envoy::Runtime::Loader;","+using ::Envoy::Upstream::ClusterInfo;","+using ::Envoy::Upstream::PrioritySet;","+","+class HostAllowlistLoadBalancerFactory","+    : public Upstream::TypedLoadBalancerFactoryBase<HostAllowlistProto> {","+public:","+  HostAllowlistLoadBalancerFactory()","+      : TypedLoadBalancerFactoryBase(\"envoy.load_balancing_policies.host_allowlist\") {}","+","+  absl::StatusOr<Upstream::LoadBalancerConfigPtr>","+  loadConfig(Server::Configuration::ServerFactoryContext& context,","+             const Protobuf::Message& config) override;","+","+  Upstream::ThreadAwareLoadBalancerPtr","+  create(Envoy::OptRef<const Upstream::LoadBalancerConfig> lb_config,","+         const ClusterInfo& cluster_info, const PrioritySet& priority_set, Loader& runtime,","+         RandomGenerator& random, TimeSource& time_source) override;","+};","+","+} // namespace HostAllowlist","+} // namespace LoadBalancingPolicies","+} // namespace Extensions","+} // namespace Envoy"],"additions":47,"deletions":0,"truncated":false},{"path":"source/extensions/load_balancing_policies/host_allowlist/load_balancer.cc","lines":["@@ -0,0 +1,508 @@","+#include \"source/extensions/load_balancing_policies/host_allowlist/load_balancer.h\"","+","+#include <algorithm>","+#include <cstdint>","+#include <functional>","+#include <memory>","+#include <optional>","+#include <string>","+#include <utility>","+#include <vector>","+","+#include \"envoy/common/exception.h\"","+#include \"envoy/common/optref.h\"","+#include \"envoy/config/core/v3/base.pb.h\"","+#include \"envoy/http/codes.h\"","+#include \"envoy/upstream/load_balancer.h\"","+#include \"envoy/upstream/upstream.h\"","+","+#include \"source/common/common/assert.h\"","+#include \"source/common/common/logger.h\"","+#include \"source/common/config/metadata.h\"","+#include \"source/common/config/utility.h\"","+#include \"source/common/protobuf/protobuf.h\"","+","+#include \"absl/container/inlined_vector.h\"","+#include \"absl/status/status.h\"","+#include \"absl/strings/str_cat.h\"","+#include \"absl/strings/str_join.h\"","+#include \"absl/strings/string_view.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace LoadBalancingPolicies {","+namespace HostAllowlist {","+namespace {","+","+using ::Envoy::Upstream::HealthyAndDegradedLoad;","+using ::Envoy::Upstream::Host;","+using ::Envoy::Upstream::HostConstSharedPtr;","+using ::Envoy::Upstream::HostSelectionResponse;","+using ::Envoy::Upstream::LoadBalancerConfig;","+using ::Envoy::Upstream::LoadBalancerContext;","+using ::Envoy::Upstream::TypedLoadBalancerFactory;","+","+// Equal, or host_id is a '/' -delimited child of candidate_id.","+bool hierarchicalIdMatches(absl::string_view host_id, absl::string_view candidate_id) {","+  if (candidate_id.empty() || host_id.size() < candidate_id.size()) {","+    return false;","+  }","+  if (host_id.substr(0, candidate_id.size()) != candidate_id) {","+    return false;","+  }","+  return host_id.size() == candidate_id.size() || host_id[candidate_id.size()] == '/';","+}","+","+class PassedCandidates {","+public:","+  void add(std::vector<std::string> values) {","+    if (values.empty() || values[0].empty()) {","+      return;","+    }","+    entries_.push_back(std::move(values));","+  }","+","+  bool matches(const std::vector<absl::string_view>& host_values) const {","+    for (const auto& candidate : entries_) {","+      if (!hierarchicalIdMatches(host_values[0], candidate[0])) {","+        continue;","+      }","+      bool ok = true;","+      const size_t n = std::min(candidate.size(), host_values.size());","+      for (size_t i = 1; i < n; ++i) {","+        // Host missing a later key matches any candidate value for it.","+        if (!host_values[i].empty() && host_values[i] != candidate[i]) {","+          ok = false;","+          break;","+        }","+      }","+      if (ok) {","+        return true;","+      }","+    }","+    return false;","+  }","+","+private:","+  // Candidate lists are small (one entry per live group). Linear scan.","+  std::vector<std::vector<std::string>> entries_;","+};","+","+std::vector<absl::string_view> hostMetadataValues(const Host& host,","+                                                  const HostAllowlistLbConfig& config) {","+  std::vector<absl::string_view> values;","+  values.reserve(config.hostMetadataKeys().size());","+  const auto metadata = host.metadata();","+  for (const auto& key : config.hostMetadataKeys()) {","+    if (metadata == nullptr) {","+      values.push_back({});","+      continue;","+    }","+    const Protobuf::Value& value =","+        Config::Metadata::metadataValue(metadata.get(), config.hostMetadataNamespace(), key);","+    if (value.has_string_value()) {","+      values.push_back(value.string_value());","+    } else {","+      values.push_back({});","+    }","+  }","+  return values;","+}","+","+bool hostOnAllowlist(const Host& host, const HostAllowlistLbConfig& config,","+                     const PassedCandidates& passed) {","+  const auto values = hostMetadataValues(host, config);","+  if (values.empty() || values[0].empty()) {","+    return true;","+  }","+  return passed.matches(values);","+}","+","+std::string structFieldString(const Protobuf::Struct& fields, const std::string& key) {","+  const auto it = fields.fields().find(key);","+  if (it != fields.fields().end() && it->second.has_string_value()) {","+    return it->second.string_value();","+  }","+  return {};","+}","+","+// nullopt: key missing or not a list. value: parsed set, possibly empty.","+std::optional<PassedCandidates> parseCandidates(const envoy::config::core::v3::Metadata& metadata,","+                                                const HostAllowlistLbConfig& config) {","+  const Protobuf::Value& value =","+      Config::Metadata::metadataValue(&metadata, config.metadataNamespace(), config.metadataKey());","+  if (!value.has_list_value()) {","+    return std::nullopt;","+  }","+  PassedCandidates passed;","+  for (const auto& item : value.list_value().values()) {","+    if (!item.has_struct_value()) {","+      continue;","+    }","+    std::vector<std::string> values;","+    values.reserve(config.hostMetadataKeys().size());","+    for (const auto& key : config.hostMetadataKeys()) {","+      values.push_back(structFieldString(item.struct_value(), key));","+    }","+    passed.add(std::move(values));","+  }","+  return passed;","+}","+","+// Zero load on priorities with no allowlisted host, then renormalize to 100.","+void redistributeLoad(HealthyAndDegradedLoad& load,","+                      const absl::InlinedVector<uint8_t, 8>& healthy_ok,","+                      const absl::InlinedVector<uint8_t, 8>& degraded_ok) {","+  auto& healthy = load.healthy_priority_load_.get();","+  auto& degraded = load.degraded_priority_load_.get();","+  const size_t n = healthy_ok.size();","+  ASSERT(healthy.size() == n && degraded.size() == n);","+","+  for (size_t i = 0; i < n; ++i) {","+    if (!healthy_ok[i]) {","+      healthy[i] = 0;","+    }","+    if (!degraded_ok[i]) {","+      degraded[i] = 0;","+    }","+  }","+","+  uint32_t total = 0;","+  for (size_t i = 0; i < n; ++i) {","+    total += healthy[i];","+    total += degraded[i];","+  }","+","+  if (total == 0) {","+    for (size_t i = 0; i < n; ++i) {","+      if (healthy_ok[i]) {","+        healthy[i] = 100;","+        return;","+      }","+    }","+    for (size_t i = 0; i < n; ++i) {","+      if (degraded_ok[i]) {","+        degraded[i] = 100;","+        return;","+      }","+    }","+    return;","+  }","+","+  uint32_t assigned = 0;","+  int first = -1;","+  for (size_t i = 0; i < n; ++i) {","+    if (healthy[i] != 0 && first < 0) {","+      first = static_cast<int>(i);","+    }","+    const uint32_t scaled =","+        static_cast<uint32_t>((static_cast<uint64_t>(healthy[i]) * 100) / total);","+    healthy[i] = scaled;","+    assigned += scaled;","+  }","+  for (size_t i = 0; i < n; ++i) {","+    if (degraded[i] != 0 && first < 0) {","+      first = static_cast<int>(i) + static_cast<int>(n);","+    }","+    const uint32_t scaled =","+        static_cast<uint32_t>((static_cast<uint64_t>(degraded[i]) * 100) / total);","+    degraded[i] = scaled;","+    assigned += scaled;","+  }","+  if (assigned < 100 && first >= 0) {","+    const uint32_t rem = 100 - assigned;","+    if (first < static_cast<int>(n)) {","+      healthy[first] += rem;","+    } else {","+      degraded[first - static_cast<int>(n)] += rem;","+    }","+  }","+}","+","+class HostAllowlistExclusionContext : public LoadBalancerContext {","+public:","+  HostAllowlistExclusionContext(LoadBalancerContext& inner, const HostAllowlistLbConfig& config,","+                                const PassedCandidates& passed, const PrioritySet& priority_set)","+      : inner_(inner), config_(config), passed_(passed), priority_set_(priority_set) {","+    uint32_t host_count = 0;","+    for (const auto& host_set : priority_set_.hostSetsPerPriority()) {","+      host_count += host_set->healthyHosts().size() + host_set->degradedHosts().size();","+    }","+    retry_count_ = std::max(inner_.hostSelectionRetryCount(), host_count == 0 ? 1u : host_count);","+  }","+","+  std::optional<uint64_t> computeHashKey() override { return inner_.computeHashKey(); }","+  const Router::MetadataMatchCriteria* metadataMatchCriteria() override {","+    return inner_.metadataMatchCriteria();","+  }","+  const Network::Connection* downstreamConnection() const override {","+    return inner_.downstreamConnection();","+  }","+  StreamInfo::StreamInfo* requestStreamInfo() const override { return inner_.requestStreamInfo(); }","+  const Http::RequestHeaderMap* downstreamHeaders() const override {","+    return inner_.downstreamHeaders();","+  }","+","+  const HealthyAndDegradedLoad&","+  determinePriorityLoad(const PrioritySet& priority_set,","+                        const HealthyAndDegradedLoad& original_priority_load,","+                        const Upstream::RetryPriority::Pri