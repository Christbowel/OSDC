/../../workbench/contrib/chat/common/model/chatModel.js';","+import { ISessionsService } from '../../../services/sessions/browser/sessionsService.js';","+import { IChat, ISession, SessionStatus } from '../../../services/sessions/common/session.js';","+import { ISessionsManagementService } from '../../../services/sessions/common/sessionsManagement.js';","+","+export interface INewChatUserInteractionSource {","+\treadonly window: Window;","+\treadonly visible: IObservable<boolean>;","+\treadonly hostVisible?: IObservable<boolean>;","+}","+","+/**","+ * Adapts the composer's deliberate transfer to a response widget without","+ * restarting its measurement or mistaking composer replacement for hiding.","+ */","+export class NewChatUserInteraction extends Disposable {","+\treadonly timer: ChatUserInteraction;","+\tprivate readonly _session = observableValue<ISession | undefined>(this, undefined);","+\tprivate readonly _widgets = this._register(new DisposableMap<IChatWidget, DisposableStore>());","+\tprivate _chatResource: URI | undefined;","+\tprivate _response: IChatResponseModel | undefined;","+\tprivate _sourceAvailable = true;","+\tprivate _handedOff = false;","+\tprivate _newSession = false;","+\tprivate _visibilityCheckScheduled = false;","+","+\tconstructor(","+\t\tprivate readonly _source: INewChatUserInteractionSource,","+\t\t@IInstantiationService instantiationService: IInstantiationService,","+\t\t@IChatWidgetService private readonly _widgetService: IChatWidgetService,","+\t\t@ISessionsService private readonly _sessionsService: ISessionsService,","+\t\t@ISessionsManagementService private readonly _managementService: ISessionsManagementService,","+\t) {","+\t\tsuper();","+\t\tthis.timer = instantiationService.createInstance(ChatUserInteraction, {","+\t\t\twindow: _source.window,","+\t\t\tvisible: _source.visible.get() && (_source.hostVisible?.get() ?? true),","+\t\t\tcontext: { location: ChatAgentLocation.Chat },","+\t\t});","+\t\tthis.timer.addDisposable(this);","+\t\tif (!this.timer.isActive) {","+\t\t\treturn;","+\t\t}","+\t\tthis._register(autorun(reader => {","+\t\t\tconst visible = _source.visible.read(reader);","+\t\t\tconst hostVisible = _source.hostVisible?.read(reader) ?? visible;","+\t\t\tif (!hostVisible || (!this._handedOff && !visible)) {","+\t\t\t\tthis.cancel('hidden');","+\t\t\t}","+\t\t}));","+\t}","+","+\t/** Called only after the composer has accepted a foreground send, before preparation can replace it. */","+\thandoff(session: ISession, chat: IChat): void {","+\t\tif (!this.timer.isActive || this._handedOff) {","+\t\t\treturn;","+\t\t}","+\t\tthis._handedOff = true;","+\t\tthis._newSession = session.status.get() === SessionStatus.Untitled;","+\t\tthis._chatResource = chat.resource;","+\t\tthis._session.set(session, undefined);","+\t\tthis.timer.setContext(getChatSessionTelemetryContext(chat.resource));","+\t\tconst replace = ({ from, to }: { from: ISession; to: ISession }) => {","+\t\t\tif (from.sessionId === this._session.get()?.sessionId) {","+\t\t\t\tthis._session.set(to, undefined);","+\t\t\t\tif (this._newSession && !this._response) {","+\t\t\t\t\tthis._chatResource = to.mainChat.get().resource;","+\t\t\t\t}","+\t\t\t}","+\t\t};","+\t\tthis._register(this._managementService.onDidReplaceSession(replace));","+\t\tthis._register(this._managementService.onDidReplaceNewDraftSession(replace));","+\t\tthis._register(autorun(reader => {","+\t\t\tconst sessionId = this._session.read(reader)?.sessionId;","+\t\t\tconst session = this._sessionsService.visibleSessions.read(reader).find(candidate => candidate?.sessionId === sessionId);","+\t\t\tsession?.activeChat.read(reader);","+\t\t\tsession?.isNewSessionRequestInProgress?.read(reader);","+\t\t\tthis._scheduleVisibilityCheck();","+\t\t}));","+\t\tconst observeWidget = (widget: IChatWidget) => {","+\t\t\tif (!this.timer.isActive || getWindow(widget.domNode) !== this._source.window || this._widgets.has(widget)) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tconst store = new DisposableStore();","+\t\t\tthis._widgets.set(widget, store);","+\t\t\tstore.add(widget.onDidChangeViewModel(() => {","+\t\t\t\tthis.timer.checkResponse();","+\t\t\t\tthis._scheduleVisibilityCheck();","+\t\t\t}));","+\t\t\tstore.add(widget.onDidHide(() => {","+\t\t\t\tif (isEqual(widget.viewModel?.sessionResource, this._response?.session.sessionResource ?? this._chatResource)) {","+\t\t\t\t\tthis.cancel('hidden');","+\t\t\t\t} else {","+\t\t\t\t\tthis._scheduleVisibilityCheck();","+\t\t\t\t}","+\t\t\t}));","+\t\t\tstore.add(widget.onDidShow(() => this.timer.checkResponse()));","+\t\t\tthis.timer.checkResponse();","+\t\t};","+\t\tthis._register(this._widgetService.onDidAddWidget(observeWidget));","+\t\tthis._register(this._widgetService.onDidRemoveWidget(widget => {","+\t\t\tthis._widgets.deleteAndDispose(widget);","+\t\t\tthis.timer.checkResponse();","+\t\t\tthis._scheduleVisibilityCheck();","+\t\t}));","+\t\tfor (const widget of this._widgetService.getAllWidgets()) {","+\t\t\tobserveWidget(widget);","+\t\t}","+\t}","+","+\t/** This callback is carried with this exact send, never inferred from prompt text or focus. */","+\treadonly onDidCreateResponse: NonNullable<IChatSendRequestOptions['onDidCreateResponse']> = (response, kind) => {","+\t\tif (kind === 'queued') {","+\t\t\tthis.cancel('queued');","+\t\t\treturn;","+\t\t}","+\t\tif (!this.timer.isActive || this._response) {","+\t\t\treturn;","+\t\t}","+\t\tthis._response = response;","+\t\tthis.timer.observeResponse(response, () => this._getResponseWidget());","+\t};","+","+\t/** Disposal of a deliberately replaced composer is not abandonment of its send. */","+\tdisposeSource(): void {","+\t\tthis._sourceAvailable = false;","+\t\tif (!this._handedOff) {","+\t\t\tthis.cancel('disposed');","+\t\t} else {","+\t\t\tthis._scheduleVisibilityCheck();","+\t\t}","+\t}","+","+\tcancel(result: Exclude<ChatUserInteractionTimingResult, 'success'>): void {","+\t\tthis.timer.cancel(result);","+\t}","+","+\tprivate _getResponseWidget(): IChatWidget | undefined {","+\t\tconst response = this._response;","+\t\treturn this._widgetService.getAllWidgets().find(widget =>","+\t\t\twidget.visible && getWindow(widget.domNode) === this._source.window","+\t\t\t&& (response ? widget.viewModel?.model === response.session : isEqual(widget.viewModel?.sessionResource, this._chatResource)));","+\t}","+","+\tprivate _scheduleVisibilityCheck(): void {","+\t\tif (this._visibilityCheckScheduled || !this.timer.isActive) {","+\t\t\treturn;","+\t\t}","+\t\tthis._visibilityCheckScheduled = true;","+\t\t// Replacement notifications also update the visible-session wrappers. Read","+\t\t// their settled identities, not the intermediate state between listeners.","+\t\tqueueMicrotask(() => {","+\t\t\tthis._visibilityCheckScheduled = false;","+\t\t\tif (!this.timer.isActive) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tconst session = this._sessionsService.visibleSessions.get().find(candidate => candidate?.sessionId === this._session.get()?.sessionId);","+\t\t\tconst expectedChat = this._response?.session.sessionResource ?? this._chatResource;","+\t\t\tconst preparing = this._newSession && !this._response && session?.isNewSessionRequestInProgress?.get();","+\t\t\tif (!this._getResponseWidget() && (!session || (!preparing","+\t\t\t\t&& !(this._sourceAvailable && this._source.visible.get())","+\t\t\t\t&& !isEqual(session.activeChat.get().resource, expectedChat)))) {","+\t\t\t\tthis.cancel('hidden');","+\t\t\t} else {","+\t\t\t\tthis.timer.checkResponse();","+\t\t\t}","+\t\t});","+\t}","+}"],"additions":185,"deletions":0,"truncated":false},{"path":"src/vs/sessions/contrib/chat/browser/newChatWidget.ts","lines":["@@ -42,6 +42,7 @@ import { NoAgentHostEmptyState } from './noAgentHostEmptyState.js';"," import { IChatRequestVariableEntry } from '../../../../workbench/contrib/chat/common/attachments/chatVariableEntries.js';"," import { IAgentHostFilterService } from '../../../services/agentHostFilter/common/agentHostFilt