{"id":"473cccecefa50b2d966b76ae46c4f6357d720719","axis":"silent","repo":"pnpm/pnpm","sha":"473cccecefa50b2d966b76ae46c4f6357d720719","parsed":{"files":[{"path":".changeset/prune-extraneous-and-workspace-selection.md","lines":["@@ -0,0 +1,10 @@","+---","+\"@pnpm/installing.commands\": patch","+\"@pnpm/installing.context\": patch","+\"@pnpm/installing.deps-installer\": patch","+\"@pnpm/installing.deps-restorer\": patch","+\"@pnpm/installing.linking.modules-cleaner\": patch","+\"pnpm\": patch","+---","+","+`pnpm prune` now removes extraneous direct packages from `node_modules` when `package.json` and `pnpm-lock.yaml` are already in sync. `pnpm prune` also accepts `--filter` and `--recursive` (`-r`) to prune selected workspace projects without removing dependencies of unselected projects."],"additions":10,"deletions":0,"truncated":false},{"path":".changeset/prune-v12-extraneous-and-workspace-selection.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm prune` now removes extraneous direct packages from `node_modules` when `package.json` and `pnpm-lock.yaml` are already in sync. `pnpm prune` also honors workspace project selection (`--filter`, `-r`) and `sharedWorkspaceLockfile: false` in workspaces."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -367,6 +367,7 @@ impl CliCommand {","             self,","             CliCommand::Install(_)","                 | CliCommand::Dedupe(_)","+                | CliCommand::Prune(_)","                 | CliCommand::InstallTest(_)","                 | CliCommand::Import(_)","                 | CliCommand::List(_)"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_install/maintenance.rs","lines":["@@ -72,8 +72,15 @@ pub(in super::super) fn prune<'a>(","     Ok(Box::pin(async move {","         let config_root = derive_config_root(&mut *cfg, dir, reporter)","             .wrap_err(\"derive workspace root and package manager policy\")?;","-        let pipeline =","-            PrunePipeline { args, cfg, config_root, manifest_path: manifest_path.to_path_buf() };","+        let recursive_sort = cfg.sort;","+        let pipeline = PrunePipeline {","+            args,","+            cfg,","+            config_root,","+            prefix: dir.to_path_buf(),","+            manifest_path: manifest_path.to_path_buf(),","+            recursive_sort,","+        };","         Box::pin(pipeline.run::<CliReporter>()).await?;","         Ok(())","     }))"],"additions":9,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines/maintenance.rs","lines":["@@ -1,7 +1,7 @@"," use super::{","     Config, Context, DedicatedProjectRuns, DedicatedProjects, DedupeArgs, InstallFamilyPlan, Path,","-    PathBuf, PruneArgs, Reporter, RuntimePolicy, State, dedupe, prepare_root_config,","-    resolve_bool_override, select_install_family_plan,","+    PathBuf, PruneArgs, Reporter, RuntimePolicy, State, anchor_active_project, dedupe,","+    prepare_root_config, resolve_bool_override, select_install_family_plan,"," };"," "," /// The reporter-generic body of `pacquet dedupe`: snapshots the lockfile","@@ -119,19 +119,14 @@ pub(crate) struct PrunePipeline {","     pub(crate) args: PruneArgs,","     pub(crate) cfg: &'static mut Config,","     pub(crate) config_root: PathBuf,","+    pub(crate) prefix: PathBuf,","     pub(crate) manifest_path: PathBuf,","+    pub(crate) recursive_sort: bool,"," }"," "," impl PrunePipeline {","     pub(crate) async fn run<Reporter: self::Reporter + 'static>(self) -> miette::Result<()> {","-        let PrunePipeline {","-            args,","-            cfg,","-            config_root,","-            manifest_path,","-        } = self;","-","-        let root_config = (&*manifest_path, &mut *cfg, &*config_root);","+        let root_config = (&*self.manifest_path, &mut *self.cfg, &*self.config_root);","         prepare_root_config::<Reporter>(root_config, (false, RuntimePolicy::Always)).await?;","         // Validate path containment AFTER hooks: updateConfig can mutate","         // modules_dir / install_state_dir via WorkspaceSettings::apply_to,","@@ -144,25 +139,116 @@ impl PrunePipeline {","         // `config_root` is `cfg.workspace_dir` when present, or the","         // canonicalized `--dir` otherwise — a meaningful containment","         // boundary in both cases.","-        if !cfg.modules_dir.starts_with(&config_root) {","-            let modules_dir = cfg.modules_dir.display();","-            let cr = config_root.display();","-            return Err(miette::miette!(","-                \"refusing prune: modules_dir ({modules_dir}) is outside workspace root ({cr})\",","-            ));","-        }","+        ensure_modules_dir_within_config_root(&self.cfg.modules_dir, &self.config_root)?;","         // Apply prune-specific overrides after hooks so that:","         // - `modules_cache_max_age = 0` forces the virtual-store sweep","         //   on the final (post-hook) config paths.","         // - `--ignore-scripts` from the CLI wins over any value the","         //   hooks set via `WorkspaceSettings::apply_to`.","-        cfg.modules_cache_max_age = 0;","-        cfg.ignore_scripts =","-            resolve_bool_override(args.ignore_scripts, args.no_ignore_scripts, cfg.ignore_scripts);","-        let cfg: &'static Config = cfg;","-        let state = State::init(manifest_path, cfg, false).wrap_err(\"initialize the state\")?;","-        Box::pin(args.run::<Reporter>(state)).await","+        self.cfg.modules_cache_max_age = 0;","+        self.cfg.ignore_scripts = resolve_bool_override(","+            self.args.ignore_scripts,","+            self.args.no_ignore_scripts,","+            self.cfg.ignore_scripts,","+        );","+        let plan = select_install_family_plan::<Reporter>(","+            self.cfg,","+            &self.prefix,","+            &self.manifest_path,","+            self.recursive_sort,","+            false,","+            false,","+        )?;","+        self.run_plan::<Reporter>(plan).await","+    }","+","+    async fn run_plan<Reporter: self::Reporter + 'static>(","+        self,","+        plan: InstallFamilyPlan,","+    ) -> miette::Result<()> {","+        match plan {","+            InstallFamilyPlan::PerProject(projects) => {","+                run_dedicated_prune::<Reporter>(self.args, self.cfg, *projects, self.config_root)","+                    .await","+            }","+            InstallFamilyPlan::Shared(selection) => {","+                if selection.selected_dirs.is_empty() {","+                    return Ok(());","+                }","+                let state = State::init(self.manifest_path, self.cfg, false)","+                    .wrap_err(\"initialize the state\")?;","+                Box::pin(self.args.run::<Reporter>(state, Some(&selection))).await","+            }","+            InstallFamilyPlan::Single => {","+                if !self.cfg.shares_one_lockfile() && self.cfg.workspace_dir.is_some() {","+                    anchor_active_project(self.cfg, &self.manifest_path);","+                    ensure_modules_dir_within_config_root(","+                        &self.cfg.modules_dir,","+                        &self.config_root,","+                    )?;","+                }","+                let state = State::init(self.manifest_path, self.cfg, false)","+                    .wrap_err(\"initialize the state\")?;","+                Box::pin(self.args.run::<Reporter>(state, None)).await","+            }","+        }","+    }","+}","+","+async fn run_dedicated_prune<Reporter: self::Reporter + 'static>(","+    args: PruneArgs,","+    cfg: &'static Config,","+    projects: DedicatedProjects,","+    config_root: PathBuf,","+) -> miette::Result<()> {","+    for project_dir in projects.dependencies.keys() {","+        let mut project_config = cfg.clone();","+        project_config.anchor_dedicated_project(","+            project_dir,","+            projects.names.get(project_dir).map(String::as_str),","+        );","+        ensure_modules_dir_within_config_root(&project_config.modules_dir, &config_root)?;","     }","+    DedicatedProjectRuns {","+        config: cfg,","+        projects,","+        require_lockfile: false,","+        http_client: Some(State::new_http_client(cfg)?),","+        prune_excludes: false,","+        sync_injected_deps: false,","+        pipelined: false,","+    }","+    .run(move |state| {","+        let args = args.clone();","+        let config_root = config_root.clone();","+        Box::pin(async move {","+            ensure_modules_dir_within_config_root(&state.config.modules_dir, &config_root)?;","+            args.run::<Reporter>(state, None).await","+        })","+    })","+    .await","+}","+","+fn ensure_modules_dir_within_config_root(","+    modules_dir: &Path,","+    config_root: &Path,","+) -> miette::Result<()> {","+    let normalized_root = pnpm_fs::lexical_normalize(config_root);","+    let resolved_root = pnpm_fs::realpath_missing(&normalized_root).unwrap_or(normalized_root);","+    let normalized_modules = pnpm_fs::lexical_normalize(modules_dir);","+    let within_root = pnpm_fs::realpath_missing(&normalized_modules)","+        .is_ok_and(|resolved_modules| resolved_modules.starts_with(&resolved_root))","+        && pnpm_fs::realpath_missing(modules_dir)","+            .unwrap_or(normalized_modules)","+            .starts_with(&resolved_root);","+    if !within_root {","+        let modules_dir = modules_dir.display();","+        let cr = config_root.display();","+        return Err(miette::miette!(","+            \"refusing prune: modules_dir ({modules_dir}) is outside workspace root ({cr})\",","+        ));","+    }","+    Ok(())"," }"," "," async fn run_dedicated_dedupe<Reporter: self::Reporter + 'static>("],"additions":109,"deletions":23,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/prune.rs","lines":["@@ -1,11 +1,16 @@","-use crate::{State, cli_args::install::resolve_bool_override};","+use crate::{","+    State,","+    cli_args::{","+        install::{resolve_bool_override, workspace_install_selection},","+        pipelines::InstallFamilySelection,","+    },","+};"," use clap::Args;"," use miette::Context;","-use pnpm_package_manager::Install;"," use pnpm_package_manifest::DependencyGroup;"," use pnpm_reporter::Reporter;"," ","-#[derive(Debug, Args)]","+#[derive(Debug, Clone, Args)]"," pub struct PruneArgs {","     #[clap(short = 'P', long, visible_alias = \"production\")]","     prod: bool,","@@ -42,38 +47,29 @@ impl PruneArgs {","             .chain(has_optional.then_some(DependencyGroup::Optional))","     }"," ","-    pub async fn run<Reporter: self::Reporter + 'static>(self, state: State) -> miette::Result<()> {","+    pub(crate) async fn run<Reporter: self::Reporter + 'static>(","+        self,","+        state: State,","+        selection: Option<&InstallFamilySelection>,","+    ) -> miette::Result<()> {","         let lockfile_path = state.lockfile_path();","-        let State {","-            tarball_mem_cache,","-            http_client,","-            config,","-            manifest,","-            lockfile,","-            resolved_packages,","-            dedicated: _,","-        } = &state;","-","         let dependency_groups: Vec<DependencyGroup> =","-            self.dependency_groups(config.optional).collect();","+            self.dependency_groups(state.config.optional).collect();","+        let selection = selection.map(|sel| {","+            let mut ws_selection = workspace_install_selection(sel);","+            ws_selection.install_dirs = sel.selected_dirs.as_ref();","+            ws_selection","+        });"," ","         {","-            let mut base_install = Install::new(","-                std::sync::Arc::clone(tarball_mem_cache),","-                resolved_packages,","-                (http_client, std::sync::Arc::clone(http_client)),","-                config,","-                manifest,","-                pnpm_lockfile::MaybeLazyLockfile::Lazy(lockfile),","-                dependency_groups,","-            );","-            base_install.lockfile_policy.trust = config.trust_lockfile;","+            let mut base_install = state.install(dependency_groups);","+            base_install.lockfile_policy.trust = state.config.trust_lockfile;","             base_install.lockfile_policy.disable_optimistic_repeat = true;","             base_install.execution.skip_runtimes = false;","             base_install.context.lockfile_path = Some(&lockfile_path);","             base_install","         }","-        .run::<Reporter>()","+        .run_prune::<Reporter>(selection)","         .await","         .wrap_err(\"pruning dependencies\")","     }"],"additions":22,"deletions":26,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/tests/global_options.rs","lines":["@@ -452,7 +452,7 @@ fn recursive_by_default_command_is_promoted_inside_workspace() {","     let workspace = tempfile::tempdir().expect(\"creates workspace\");","     std::fs::write(workspace.path().join(\"pnpm-workspace.yaml\"), \"packages: []\\n\")","         .expect(\"writes workspace manifest\");","-    for command in [\"install\", \"dedupe\", \"import\", \"list\", \"why\", \"peers\"] {","+    for command in [\"install\", \"dedupe\", \"prune\", \"import\", \"list\", \"why\", \"peers\"] {","         let mut parsed = CliArgs::try_parse_from([","             \"pacquet\",","             \"--dir\",","@@ -520,7 +520,8 @@ fn color_accepts_modes_and_boolean_spellings() {"," #[test]"," fn recursive_by_default_command_stays_non_recursive_outside_workspace() {","     let project = tempfile::tempdir().expect(\"creates project\");","-    for command in [\"dedupe\", \"list\", \"why\", \"peers\"] {","+    std::fs::write(project.path().join(\"package.json\"), \"{}\\n\").expect(\"writes package.json\");","+    for command in [\"dedupe\", \"prune\", \"list\", \"why\", \"peers\"] {","         let mut parsed = CliArgs::try_parse_from([","             \"pacquet\",","             \"--dir\","],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/prune.rs","lines":["@@ -309,3 +309,298 @@ fn prune_offline_honors_trust_lockfile() {"," ","     drop((root, mock_instance));"," }","+","+#[test]","+fn prune_removes_extraneous_direct_packages_when_lockfile_is_up_to_date() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"dependencies\": { \"is-positive\": \"1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let extraneous_dir = workspace.join(\"node_modules\").join(\"extraneous-pkg\");","+    fs::create_dir_all(&extraneous_dir).expect(\"create extraneous package dir\");","+    fs::write(","+        extraneous_dir.join(\"package.json\"),","+        r#\"{\"name\":\"extraneous-pkg\",\"version\":\"1.0.0\"}\"#,","+    )","+    .expect(\"write extraneous package.json\");","+","+    let linked_target = workspace.join(\"linked-extraneous\");","+    fs::create_dir_all(&linked_target).expect(\"create linked-extraneous target\");","+    fs::write(linked_target.join(\"cli.js\"), \"#!/usr/bin/env node\\n\")","+        .expect(\"write linked-extraneous bin\");","+    fs::write(","+        linked_target.join(\"package.json\"),","+        r#\"{\"name\":\"linked-extraneous\",\"version\":\"1.0.0\",\"bin\":{\"linked-extraneous\":\"cli.js\"}}\"#,","+    )","+    .expect(\"write linked-extraneous package.json\");","+    let extraneous_link = workspace.join(\"node_modules\").join(\"linked-extraneous\");","+    pnpm_fs::symlink_dir(&linked_target, &extraneous_link).expect(\"symlink linked-extraneous\");","+    let bin_dir = workspace.join(\"node_modules\").join(\".bin\");","+    fs::create_dir_all(&bin_dir).expect(\"create .bin dir\");","+    let extraneous_bin =","+        bin_dir.join(if cfg!(windows) { \"linked-extraneous.cmd\" } else { \"linked-extraneous\" });","+    fs::write(&extraneous_bin, \"shim\").expect(\"write extraneous bin shim\");","+","+    let extraneous_scoped_dir = workspace","+        .join(\"node_modules\")","+        .join(\"@extraneous\")","+        .join(\"scoped-pkg\");","+    fs::create_dir_all(&extraneous_scoped_dir).expect(\"create extraneous scoped package dir\");","+    fs::write(","+        extraneous_scoped_dir.join(\"package.json\"),","+        r#\"{\"name\":\"@extraneous/scoped-pkg\",\"version\":\"1.0.0\"}\"#,","+    )","+    .expect(\"write extraneous scoped package.json\");","+","+    let non_package_dir = workspace.join(\"node_modules\").join(\"_tmp\");","+    fs::create_dir_all(&non_package_dir).expect(\"create _tmp dir\");","+","+    pacquet_in(&workspace)","+        .with_arg(\"prune\")","+        .assert()","+        .success();","+","+    assert!(has_link(&workspace, \"is-positive\"));","+    assert!(!extraneous_dir.exists(), \"extraneous direct package must be removed\");","+    assert!(","+        fs::symlink_metadata(&extraneous_link).is_err(),","+        \"extraneous direct package symlink must be removed\",","+    );","+    assert!(!extraneous_bin.exists(), \"extraneous direct package bin shim must be removed\");","+    assert!(linked_target.exists(), \"symlink target must not be deleted\");","+    assert!(","+        !workspace","+            .join(\"node_modules\")","+            .join(\"@extraneous\")","+            .exists(),","+        \"emptied extraneous scope dir must be removed\",","+    );","+    assert!(non_package_dir.exists(), \"non-package _tmp dir must not abort prune\");","+","+    // Also verify pruning extraneous direct packages when the project has zero dependencies.","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"empty-project\",\"version\":\"1.0.0\"}\"#)","+        .expect(\"write empty package.json\");","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    fs::create_dir_all(&extraneous_dir).expect(\"recreate extraneous package dir\");","+    fs::write(","+        extraneous_dir.join(\"package.json\"),","+        r#\"{\"name\":\"extraneous-pkg\",\"version\":\"1.0.0\"}\"#,","+    )","+    .expect(\"write extraneous package.json\");","+","+    pacquet_in(&workspace)","+        .with_arg(\"prune\")","+        .assert()","+        .success();","+","+    assert!(","+        !extraneous_dir.exists(),","+        \"extraneous direct package must be removed even when project has zero dependencies\",","+    );","+","+    // An in-workspace `node_modules -> src` symlink must never redirect prune into `src`.","+    let src_subdir = workspace.join(\"src\").join(\"components\");","+    fs::create_dir_all(&src_subdir).expect(\"create src/components\");","+    let modules_dir = workspace.join(\"node_modules\");","+    if modules_dir.exists() {","+        fs::remove_dir_all(&modules_dir).expect(\"remove node_modules\");","+    }","+    pnpm_fs::symlink_dir(&workspace.join(\"src\"), &modules_dir)","+        .expect(\"symlink node_modules -> src\");","+    let _ = pacquet_in(&workspace).with_arg(\"prune\").output();","+    assert!(","+        src_subdir.exists(),","+        \"in-workspace node_modules symlink must not delete src/components\",","+    );","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn prune_respects_workspace_filter() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"workspace-root\",","+            \"private\": true,","+            \"devDependencies\": { FILTERED: \"1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write root package.json\");","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write pnpm-workspace.yaml\");","+","+    let pkg_a = workspace.join(\"packages/pkg-a\");","+    let pkg_b = workspace.join(\"packages/pkg-b\");","+    fs::create_dir_all(&pkg_a).expect(\"create pkg-a\");","+    fs::create_dir_all(&pkg_b).expect(\"create pkg-b\");","+","+    fs::write(","+        pkg_a.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"pkg-a\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"is-positive\": \"1.0.0\", \"pkg-b\": \"workspace:*\" },","+            \"devDependencies\": { \"is-negative\": \"1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write pkg-a package.json\");","+    fs::write(","+        pkg_b.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"pkg-b\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"is-positive\": \"1.0.0\" },","+            \"devDependencies\": { \"is-negative\": \"1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write pkg-b package.json\");","+","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let extraneous_a = pkg_a.join(\"node_modules\").join(\"extraneous-a\");","+    let extraneous_b = pkg_b.join(\"node_modules\").join(\"extraneous-b\");","+    fs::create_dir_all(&extraneous_a).expect(\"create extraneous-a\");","+    fs::create_dir_all(&extraneous_b).expect(\"create extraneous-b\");","+","+    assert!(has_link(&workspace, FILTERED));","+    assert!(has_link(&pkg_a, \"is-positive\"));","+    assert!(has_link(&pkg_a, \"is-negative\"));","+    assert!(has_link(&pkg_b, \"is-positive\"));","+    assert!(has_link(&pkg_b, \"is-negative\"));","+","+    pacquet_in(&workspace)","+        .with_args([\"--filter\", \"pkg-a\", \"prune\", \"--prod\"])","+        .assert()","+        .success();","+","+    assert!(has_link(&pkg_a, \"is-positive\"));","+    assert!(!has_link(&pkg_a, \"is-negative\"), \"selected package devDependencies must be pruned\");","+    assert!(!extraneous_a.exists(), \"selected package extraneous dep must be pruned\");","+    assert!(has_link(&pkg_b, \"is-positive\"));","+    assert!(","+        has_link(&pkg_b, \"is-negative\"),","+        \"unselected sibling package devDependencies must remain linked\",","+    );","+    assert!(extraneous_b.exists(), \"unselected sibling extraneous dep must remain untouched\");","+    assert!(","+        has_link(&workspace, FILTERED),","+        \"unselected workspace root devDependencies must remain linked\",","+    );","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn prune_supports_dedicated_workspace_lockfiles() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"workspace-root\",\"private\":true}\"#)","+        .expect(\"write root package.json\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nsharedWorkspaceLockfile: false\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+","+    let pkg_a = workspace.join(\"packages/pkg-a\");","+    let pkg_b = workspace.join(\"packages/pkg-b\");","+    fs::create_dir_all(&pkg_a).expect(\"create pkg-a\");","+    fs::create_dir_all(&pkg_b).expect(\"create pkg-b\");","+","+    for (name, dir) in [(\"pkg-a\", &pkg_a), (\"pkg-b\", &pkg_b)] {","+        fs::write(","+            dir.join(\"package.