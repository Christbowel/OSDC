{"id":"771308790bd72a701a9ab7e99780a5df52a12a20","axis":"silent","repo":"pnpm/pnpm","sha":"771308790bd72a701a9ab7e99780a5df52a12a20","parsed":{"files":[{"path":".changeset/compact-progress-output.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+An install from a project inside a workspace with a shared lockfile no longer prefixes its progress lines with the path to the workspace root. In CI and piped output, a large download now prints one line when it finishes, without the `0.00 B` line at its start."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch.rs","lines":["@@ -207,6 +207,7 @@ impl CliArgs {","         }","         config.progress = self.progress_enabled(config.progress);","         self.configure_reporter();","+        crate::cli_args::reporter::configure_progress_prefix(&config);","         if self.output.presentation.loglevel.is_none()","             && let Some(config_loglevel) = config.loglevel","         {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/configuration.rs","lines":["@@ -463,6 +463,7 @@ impl CliArgs {","         anchors: &RunAnchors,","     ) {","         pnpm_default_reporter::set_progress(cfg.progress);","+        crate::cli_args::reporter::configure_progress_prefix(cfg);","         if self.output.presentation.loglevel.is_none()","             && let Some(config_loglevel) = cfg.loglevel","         {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/reporter.rs","lines":["@@ -346,6 +346,15 @@ pub(crate) fn configure_default_reporter(setup: &DefaultReporterSetup<'_>) {","     }"," }"," ","+/// Drop the project prefix from progress lines when the workspace shares","+/// one lockfile: its directory is then the only project that reports","+/// progress, so the prefix names nothing.","+pub(crate) fn configure_progress_prefix(config: &pnpm_config::Config) {","+    if config.workspace_dir.is_some() && config.shared_workspace_lockfile {","+        pnpm_default_reporter::hide_progress_prefix();","+    }","+}","+"," /// Seed the default reporter's verbosity ceiling from the `--loglevel`"," /// value. `silent` and an absent flag leave the [`MaxLogLevel::Info`]"," /// default in place, `silent` never reaches the default reporter (see"],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install/diagnostics.rs","lines":["@@ -261,3 +261,40 @@ fn an_override_to_a_missing_version_is_reported_on_the_override() {","         }","     }"," }","+","+/// With a shared workspace lockfile, the workspace root is the only","+/// project that reports progress, so an install from a workspace project","+/// prints its progress without a prefix pointing at the root.","+#[test]","+fn progress_from_a_workspace_project_has_no_prefix() {","+    let fixture = CommandTempCwd::init().add_mocked_registry();","+    let workspace = &fixture.workspace;","+    let project = workspace.join(\"packages/a\");","+    fs::create_dir_all(&project).expect(\"create the workspace project\");","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"root\"}\"#).expect(\"write package.json\");","+    fs::write(","+        project.join(\"package.json\"),","+        r#\"{\"name\":\"a\",\"dependencies\":{\"@pnpm.e2e/pkg-with-1-dep\":\"100.0.0\"}}\"#,","+    )","+    .expect(\"write the project's package.json\");","+    let settings = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&settings).unwrap_or_default();","+    fs::write(&settings, format!(\"{yaml}\\npackages:\\n  - packages/*\\n\"))","+        .expect(\"write pnpm-workspace.yaml\");","+","+    let output = fixture.pacquet","+        .with_current_dir(&project)","+        .with_args([\"install\", \"--reporter=append-only\"])","+        .output()","+        .expect(\"run pnpm install\");","+","+    assert!(output.status.success(), \"install failed: {output:?}\");","+    let stdout = String::from_utf8_lossy(&output.stdout);","+    assert!(","+        stdout","+            .lines()","+            .any(|line| line.starts_with(\"Progress: resolved\")),","+        \"stdout:\\n{stdout}\",","+    );","+    assert!(!stdout.contains(\"| Progress\"), \"stdout:\\n{stdout}\");","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/src/lib.rs","lines":["@@ -31,7 +31,10 @@ pub use lifecycle_settings::{","     stream_lifecycle_output,","     summarize_scripts,"," };","-pub use progress::set_progress;","+pub use progress::{","+    hide_progress_prefix,","+    set_progress,","+};"," "," mod progress;"," ","@@ -67,7 +70,6 @@ use pnpm_reporter::{"," use crate::{","     colors::Colors,","     format::visible_width,","-    progress::is_coalesceable,","     state::{","         Output,","         ReporterState,","@@ -247,8 +249,9 @@ impl Reporter for DefaultReporter {","             sink.on_prompt(log.action);","             return;","         }","+        let coalesceable = sink.state.is_coalesceable(event);","         let output = sink.state.handle(event);","-        sink.write(output, is_coalesceable(event));","+        sink.write(output, coalesceable);","         if sink.state.scripts_running() && !SCRIPTS_TICKER.swap(true, Ordering::SeqCst) {","             std::thread::spawn(tick_scripts);","         }","@@ -549,7 +552,7 @@ fn reporter_options(append_only: bool) -> state::ReporterOptions {","         lifecycle: lifecycle_settings::lifecycle_options(),","         progress: crate::state::ProgressOptions {","             hide_added_pkgs: HIDE_ADDED_PKGS_PROGRESS.get().is_some_and(|value| *value),","-            ..Default::default()","+            hide_prefix: progress::prefix_hidden(),","         },","         scope: crate::state::ScopeOptions {","             summary: SUMMARY_SCOPE"],"additions":7,"deletions":4,"truncated":false},{"path":"pnpm/crates/default-reporter/src/progress.rs","lines":["@@ -1,16 +1,17 @@"," //! The gate the `progress` setting puts in front of the progress streams."," ","-use std::sync::atomic::{","-    AtomicBool,","-    Ordering,","+use std::sync::{","+    OnceLock,","+    atomic::{","+        AtomicBool,","+        Ordering,","+    },"," };"," ","-use pnpm_reporter::{","-    FetchingProgressMessage,","-    LogEvent,","-};","+use pnpm_reporter::LogEvent;"," "," static ENABLED: AtomicBool = AtomicBool::new(true);","+static HIDE_PREFIX: OnceLock<bool> = OnceLock::new();"," "," /// Configure whether dependency and download progress is rendered. Starts"," /// enabled, as the `progress` setting defaults to.","@@ -23,6 +24,17 @@ pub fn set_progress(progress: bool) {","     ENABLED.store(progress, Ordering::Relaxed);"," }"," ","+/// Drop the project prefix from progress lines, see","+/// [`ProgressOptions::hide_prefix`](crate::state::ProgressOptions::hide_prefix).","+/// Call once before the first event.","+pub fn hide_progress_prefix() {","+    let _ = HIDE_PREFIX.set(true);","+}","+","+pub(crate) fn prefix_hidden() -> bool {","+    HIDE_PREFIX.get().is_some_and(|value| *value)","+}","+"," /// Whether `event` is one of the progress updates a disabled `progress`"," /// setting drops. Only the two progress streams are gated: warnings,"," /// lifecycle output, and the summary still render.","@@ -30,16 +42,3 @@ pub(crate) fn is_suppressed(event: &LogEvent) -> bool {","     !ENABLED.load(Ordering::Relaxed)","         && matches!(event, LogEvent::Progress(_) | LogEvent::FetchingProgress(_))"," }","-","-/// Whether an event is a high-volume progress update that may be dropped","-/// under throttling, mirroring pnpm's `throttleProgress` on the progress","-/// stream.","-pub(crate) fn is_coalesceable(event: &LogEvent) -> bool {","-    match event {","-        LogEvent::Progress(_) => true,","-        LogEvent::FetchingProgress(log) => {","-            matches!(log.message, FetchingProgressMessage::InProgress { .. })","-        }","-        _ => false,","-    }","-}"],"addi