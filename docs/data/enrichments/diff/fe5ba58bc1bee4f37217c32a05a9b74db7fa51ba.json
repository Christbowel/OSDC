{"id":"fe5ba58bc1bee4f37217c32a05a9b74db7fa51ba","axis":"silent","repo":"apache/tika","sha":"fe5ba58bc1bee4f37217c32a05a9b74db7fa51ba","parsed":{"files":[{"path":"CHANGES.txt","lines":["@@ -1,5 +1,13 @@"," Release 4.2.0 - unreleased"," ","+   * The docx parser now applies bold and italics set by a run's character style","+     (e.g. Word's built-in Strong and Emphasis), following basedOn chains; previously","+     only direct formatting was emitted. The new OfficeParserConfig option","+     includeCharacterStyleClasses wraps such runs in <span class=\"...\"> named after","+     the style. Style-derived classes (paragraph and character) now replace every","+     character other than letters, digits, '_' and '-' with '_' and are capped at 128","+     characters, so a style name can no longer yield extra class tokens (TIKA-4966).","+","    * OpenAI-compatible VLM parser can send the output token limit as","      max_completion_tokens for models that reject max_tokens. The new","      useMaxCompletionTokens setting is opt-in; max_tokens remains the default."],"additions":8,"deletions":0,"truncated":false},{"path":"tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-microsoft-module/src/main/java/org/apache/tika/parser/microsoft/OfficeParserConfig.java","lines":["@@ -46,6 +46,7 @@ public class OfficeParserConfig implements Serializable {","     private int rtfEmbeddedMaxBytesInKb = 2 * 1024 * 1024; // 2 GB"," ","     private boolean includeGlossary = true;","+    private boolean includeCharacterStyleClasses = false;","     private String dateOverrideFormat = null;","     private int maxOverride = 0;//ignore"," ","@@ -203,6 +204,23 @@ public void setIncludeGlossary(boolean includeGlossary) {","         this.includeGlossary = includeGlossary;","     }"," ","+    public boolean isIncludeCharacterStyleClasses() {","+        return includeCharacterStyleClasses;","+    }","+","+    /**","+     * Whether to wrap docx runs that carry a character style in","+     * <code>&lt;span class=\"...\"&gt;</code>, named after the style the same way","+     * paragraph styles are.","+     * <p/>","+     * Default: <code>false</code>","+     *","+     * @param includeCharacterStyleClasses whether to emit character style classes","+     */","+    public void setIncludeCharacterStyleClasses(boolean includeCharacterStyleClasses) {","+        this.includeCharacterStyleClasses = includeCharacterStyleClasses;","+    }","+","     public boolean isIncludeMissingRows() {","         return includeMissingRows;","     }"],"additions":18,"deletions":0,"truncated":false},{"path":"tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-microsoft-module/src/main/java/org/apache/tika/parser/microsoft/WordExtractor.java","lines":["@@ -29,6 +29,7 @@"," import java.util.Locale;"," import java.util.Map;"," import java.util.Set;","+import java.util.regex.Pattern;"," "," import org.apache.poi.hwpf.HWPFDocument;"," import org.apache.poi.hwpf.HWPFOldDocument;","@@ -78,6 +79,8 @@ public class WordExtractor extends AbstractPOIFSExtractor {","     private static final String LIST_DELIMITER = \" \";","     private static final Map<String, TagAndStyle> fixedParagraphStyles = new HashMap<>();","     private static final TagAndStyle defaultParagraphStyle = new TagAndStyle(\"p\", null);","+    private static final int MAX_STYLE_CLASS_LENGTH = 128;","+    private static final Pattern NON_STYLE_CLASS_CHARS = Pattern.compile(\"[^\\\\p{L}\\\\p{N}_-]\");","     private static final Logger LOG = LoggerFactory.getLogger(WordExtractor.class);"," ","     static {","@@ -170,14 +173,30 @@ public static TagAndStyle buildParagraphTagAndStyle(String styleName, boolean is","             // Turn it into a H1 - H6 (H7+ isn't valid!)","             tag = \"h\" + Math.min(num, 6);","         } else {","-            styleClass = styleName.replace(' ', '_');","-            styleClass =","-                    styleClass.substring(0, 1).toLowerCase(Locale.ROOT)