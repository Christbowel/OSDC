{"id":"c4c5e37ff8f8d7ef215a16228c47006ad844a346","axis":"silent","repo":"TYPO3/typo3","sha":"c4c5e37ff8f8d7ef215a16228c47006ad844a346","parsed":{"files":[{"path":"typo3/sysext/core/Classes/DataHandling/DataHandler.php","lines":["@@ -683,6 +683,7 @@ public function process_datamap(): void"," ","         $this->datamap = $this->dataMapProcessor->process($this->datamap, $this->BE_USER, $this->referenceIndexUpdater, $this->correlationId);","         $registerDBList = [];","+        $inlineParents = [];","         $orderOfTables = [];","         if (isset($this->datamap['pages'])) {","             // Handling pages table is always the first task to make sure they are done if other records are added to them.","@@ -863,6 +864,7 @@ public function process_datamap(): void","                         } else {","                             $this->insertDB($table, $id, $fieldArray, (int)($incomingFieldArray['uid'] ?? 0));","                         }","+                        $inlineParents = $this->registerInlineParent($inlineParents, $table, (int)($this->substNEWwithIDs[$id] ?? 0));","                     }","                     // Note: When using the hook after INSERT operations, you will only get the temporary NEW... id passed to your hook as $id,","                     // but you can easily translate it to the real uid of the inserted record using the $this->substNEWwithIDs array.","@@ -986,6 +988,9 @@ public function process_datamap(): void","                         }","                         $this->updateDB($table, $id, $fieldArray, (int)$currentRecord['pid']);","                     }","+                    if ($this->isInlineChildLanguageAlignmentRequired($table, $fieldArray, $incomingFieldArray)) {","+                        $inlineParents = $this->registerInlineParent($inlineParents, $table, $id);","+                    }","                     // Note: When using the hook after INSERT operations, you will only get the temporary NEW... id passed to your hook as $id,","                     // but you can easily translate it to the real uid of the inserted record using the $this->substNEWwithIDs array.","                     $this->hook_processDatamap_afterDatabaseOperations($hookObjectsArr, 'update', $table, $id, $fieldArray);","@@ -996,6 +1001,7 @@ public function process_datamap(): void","         // Process the stack of relations to remap/correct","         $this->processRemapStack();","         $this->dbAnalysisStoreExec();","+        $this->alignLanguageOfInlineChildren($inlineParents);"," ","         foreach ($hookObjectsArr as $hookObj) {","             if (method_exists($hookObj, 'processDatamap_afterAllOperations')) {","@@ -9798,6 +9804,163 @@ protected function postProcessPostgresqlInsert(Connection $connection, string $t","         }","     }"," ","+    /**","+     * @param array<string, array<int, true>> $inlineParents","+     * @return array<string, array<int, true>>","+     */","+    private function registerInlineParent(array $inlineParents, string $table, int $id): array","+    {","+        if ($id > 0 && $this->tcaSchemaFactory->get($table)->isLanguageAware()) {","+            $inlineParents[$table][$id] = true;","+        }","+        return $inlineParents;","+    }","+","+    /**","+     * Whether the language of an updated record has changed, or new inline children were submitted for it.","+     */","+    private function isInlineChildLanguageAlignmentRequired(string $table, array $fieldArray, array $incomingFieldArray): bool","+    {","+        $schema = $this->tcaSchemaFactory->get($table);","+        if (!$schema->isLanguageAware()) {","+            return false;","+        }","+        if (isset($fieldArray[$schema->getCapability(TcaSchemaCapability::Language)->getLanguageField()->getName()])) {","+            return true;","+        }","+        foreach ($schema->getFields() as $field) {","+            if (($field instanceof InlineFieldType || $field instanceof FileFieldType)","+                && is_string($incomingFieldArray[$field->getName()] ?? null)","+                && str_contains($incomingFieldArray[$field->getName()], 'NEW')","+            ) {","+                return true;","+            }","+        }","+        return false;","+    }","+","+    /**","+     * Inline children (type \"inline\" without \"MM\" and type \"file\") belong to","+     * exactly one parent and must share its language. Children submitted together","+     * with their parent may carry a different language, and existing children keep","+     * their language when the language of their parent is changed. Both cases are","+     * aligned here, after all relations have been remapped to their final parent,","+     * using the language actually stored for the parent.","+     * The language of a child is not edited by the user, but follows the parent, so","+     * it is written regardless of the access to the language field of the child.","+     * A child is realigned when a parent processed later changes its language","+     * again, which makes the result independent of the order of the data map.","+     * Each child is aligned to a language at most once per run, which keeps","+     * invalid cyclic relations from being processed endlessly.","+     *","+     * @param array<string, array<int, true>> $inlineParents Parent records per table and uid","+     */","+    private function alignLanguageOfInlineChildren(array $inlineParents): void","+    {","+        $alignedRecords = [];","+        while ($inlineParents !== []) {","+            $parents = $inlineParents;","+            $inlineParents = [];","+            foreach ($parents as $table => $ids) {","+                $schema = $this->tcaSchemaFactory->get($table);","+                $languageField = $schema->getCapability(TcaSchemaCapability::Language)->getLanguageField()->getName();","+                $parentLanguages = [];","+                foreach (array_keys($ids) as $id) {","+                    $parent = BackendUtility::getRecord($table, $id, [$languageField]);","+                    if ($parent !== null) {","+                        $parentLanguages[$id] = (int)$parent[$languageField];","+                    }","+                }","+                foreach ($schema->getFields() as $field) {","+                    if (!$field instanceof InlineFieldType && !$field instanceof FileFieldType) {","+                        continue;","+                    }","+                    $configuration = $field->getConfiguration();","+                    $foreignTable = $configuration['foreign_table'] ?? '';","+                    if (!empty($configuration['MM']) || !$this->tcaSchemaFactory->has($foreignTable)) {","+                        continue;","+                    }","+                    $foreignSchema = $this->tcaSchemaFactory->get($foreignTable);","+                    if (!$foreignSchema->isLanguageAware()) {","+                        continue;","+                    }","+                    $foreignLanguageCapability = $foreignSchema->getCapability(TcaSchemaCapability::Language);","+                    $foreignLanguageField = $foreignLanguageCapability->getLanguageField()->getName();","+                    $foreignTranslationFields = [$foreignLanguageCapability->getTranslationOriginPointerField()->getName()];","+                    if ($foreignLanguageCapability->hasTranslationSourceField()) {","+                        $foreignTranslationFields[] = $foreignLanguageCapability->getTranslationSourceField()->getName();","+                    }","+                    foreach ($parentLanguages as $id => $language) {","+                        $itemList = '';","+                        if (empty($configuration['foreign_field'])) {","+                            $itemList = (string)(BackendUtility::getRecord($table, $id, [$field->getName()])[$field->getName()] ?? '');","+                        }","+                        $relationHandler = $this->createRelationHandlerInstance();","+                        $relationHandler->start($itemList, $foreignTable, '', $id, $table, $configuration);","+                        foreach ($relationHandler->itemArray as $item) {","+                            $child = $this->getRecordToWriteInCurrentWorkspace($foreignTable, (int)$item['id'], [$foreignLanguageField, ...$foreignTranslationFields]);","+                            if ($child === null","+                                || isset($alignedRecords[$foreignTable . ':' . $child['uid']][$language])","+                                || (int)$child[$foreignLanguageField] === $language","+                            ) {","+                                continue;","+                            }","+                            $newData = [$foreignLanguageField => $language];","+                            // A child in default language or \"all languages\" is no translation","+                            if ($language <= 0) {","+                                foreach ($foreignTranslationFields as $translationField) {","+                                    if ((int)$child[$translationField] !== 0) {","+                                        $newData[$translationField] = 0;","+                                    }","+                                }","+                            }","+                            $this->updateFixedFields($foreignTable, $child, $newData);","+                            $alignedRecords[$foreignTable . ':' . $child['uid']][$language] = true;","+                            $inlineParents[$foreignTable][(int)$child['uid']] = true;","+                        }","+                    }","+                }","+            }","+        }","+    }","+","+    /**","+     * Returns the record a change of the given record is written to: the record itself or,","+     * in a workspace, its workspace version, which is created if it does not exist yet.","+     * Records of tables that are not workspace aware are never changed from a workspace.","+     */","+    private function getRecordToWriteInCurrentWorkspace(string $table, int $id, array $fieldNames): ?array","+    {","+        $fields = ['uid', 'pid', ...$fieldNames];","+        $workspace = $this->BE_USER->workspace;","+        if ($workspace === 0) {","+            return BackendUtility::getRecord($table, $id, $fields);","+        }","+        if (!$this->tcaSchemaFactory->get($table)->isWorkspaceAware()) {","+            return null;","+        }","+        $row = BackendUtility::getRecord($table, $id, [...$fields, 't3ver_wsid']);","+        if ($row === null || (int)$row['t3ver_wsid'] === $workspace) {","+            return $row;","+        }","+        $version = BackendUtility::getWorkspaceVersionOfRecord($workspace, $table, $id, $fields);","+        if (is_array($version)) {","+            return $version;","+        }","+        $localDataHandler = $this->getLocalTCE();","+        $localDataHandler->start(","+            [],","+            [$table => [$id => ['version' => ['action' => 'new', 'label' => 'Auto-created for WS #' . $workspace]]]],","+            $this->BE_USER,","+            $this->referenceIndexUpdater,","+            $this->correlationId","+        );","+        $localDataHandler->process_cmdmap();","+        $this->errorLog = array_merge($this->errorLog, $localDataHandler->errorLog);","+        $versionId = (int)($localDataHandler->copyMappingArray[$table][$id] ?? 0);","+        return $versionId > 0 ? BackendUtility::getRecord($table, $versionId, $fields) : null;","+    }","+","     protected function createRelationHandlerInstance(): RelationHandler","     {","         $isWorkspacesLoaded = ExtensionManagementUtility::isLoaded('workspaces');"],"additions":163,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/14.3.x/Important-103970-InlineChildrenFollowTheLanguageOfTheirParent.rst","lines":["@@ -0,0 +1,121 @@","+..  include:: /Includes.rst.txt","+","+..  _important-103970-1792102654:","+","+========================================================================","+Important: #103970 - Inline children follow the language of their parent","+========================================================================","+","+See :issue:`103970`","+","+Description","+===========","+","+Records in inline relations of type :php:`'inline'` and type :php:`'file'`","+belong to exactly one parent record. DataHandler now ensures that these","+children always have the same language as their parent when records are","+persisted.","+","+Before, children could end up with a different language than their parent:","+","+*   New children created together with their parent kept the language the","+    backend form sent for them, which was the language of the parent when the","+    form was opened, not the one selected before saving.","+","+*   New children added to an existing record in a non-default language got","+    the default language when no language was submitted for them.","+","+*   Existing children kept their language when the language of their parent","+    was changed, for example from \"All languages\" to the default language.","+    Localizing such a parent duplicated the children, or failed with","+    \"Child record was not processed\" when","+    :php:`'allowLanguageSynchronization'` is enabled for the inline field.","+","+Language of inline children on persistence","+------------------------------------------","+","+Once all relations of a DataHandler run are resolved, the language of the","+children is aligned for each parent record that","+","+*   has been created,","+*   had its language changed, or","+*   received new inline children.","+","+All children of such a parent are aligned, including existing children when","+only a new child is added. The language stored for the parent record is used,","+not the one submitted for it. Nested inline children follow their aligned","+parent, so a whole tree of inline records ends up in the same language,","+regardless of the order of the records in the data map.","+","+The children are aligned after the records have been written. Hooks of","+:php:`processDatamap_afterDatabaseOperations` therefore still receive the","+language submitted for a child. The aligned language is available in","+:php:`processDatamap_afterAllOperations` and in the database.","+","+A child that is aligned to the default language or to \"All languages\" is no","+translation anymore. Its translation parent (:php:`transOrigPointerField`)","+and translation source (:php:`translationSource`) are reset as well. The","+translation pointers of the parent record itself are not changed.","+","+This applies to inline relations using :php:`'foreign_field'` as well as to","+inline relations stored as comma-separated list in the parent field, and to","+all fields of type :php:`'file'`.","+","+Permissions and workspaces","+--------------------------","+","+The language of an inline child is not edited on its own, it follows from its","+parent. It is therefore written like the pointer to the parent and the sorting","+DataHandler already writes to inline children: without checking the access to","+the child table, its page or its language field. An editor who is allowed to","+change the language of a parent record does not need access to the language","+field of the child table, which is excluded by default.","+","+In a workspace, only workspace versions of the children are written. A","+workspace version is created if a child does not have one yet. Live records","+are never changed from a workspace, and children of tables that are not","+workspace aware are left untouched.","+","+Recommendation for TCA of inline child tables","+---------------------------------------------","+","+Since DataHandler sets the language of inline children from their parent,","+the language field (:php:`languageField`) and the translation parent","+(:php:`transOrigPointerField`) of a table that is only used as inline child","+do not need to be part of its :php:`'showitem'` configuration anymore, neither","+as visible fields nor in a hidden palette.","+","+Rendering an editable language field for inline children is discouraged: an","+editor could change the language of a single child, which is not aligned back","+to the language of its parent.","+","+Keep the fields in :php:`'showitem'` for tables that are also edited on their","+own, outside of an inline relation, and for children of inline relations","+stored in an MM table.","+","+What is not covered","+-------------------","+","+*   Inline relations stored in an MM table (:php:`'MM'`) are not aligned.","+    Their children are not owned by a single parent: the same child can be","+    related to several parents with different languages, and with","+    :php:`'MM_opposite_field'` both records are parent and child of each","+    other.","+","+*   A child that is listed in the comma-separated inline field of several","+    parents with different languages gets the language of the parent that is","+    processed last.","+","+*   Changing the language of an inline child directly, for example in a","+    backend form where the language field of the child is editable, is not","+    aligned back to the language of its parent.","+","+*   Records that already have a different language than their parent are not","+    changed automatically. They are aligned the next time the language of","+    their parent is changed or new children are added to it.","+","+*   Changing the language of a record does not reset its own translation","+    pointers. A translated record that is copied to another page and switched","+    to the default language still points to its original translation parent.","+","+..  index:: Backend, Database, TCA, ext:core"],"additions":121,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguage.csv","lines":["@@ -0,0 +1,38 @@","+\"be_users\"","+,\"uid\",\"pid\",\"username\",\"usergroup\",\"deleted\",\"admin\",\"db_mountpoints\",\"workspace_perms\"","+,1,0,\"admin\",,0,1,,1","+,2,0,\"editor\",1,0,0,1,1","+,3,0,\"editorWithoutHotelLanguage\",2,0,0,1,1","+,4,0,\"editorWithoutFileReferenceAccess\",3,0,0,1,1","+\"be_groups\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"db_mountpoints\",\"tables_select\",\"tables_modify\",\"non_exclude_fields\",\"explicit_allowdeny\"","+,1,0,\"editors\",0,1,\"pages,tt_content,sys_file_reference\",\"pages,tt_content,sys_file_reference\",\"tt_content:sys_language_uid\",\"tt_content:CType:text\"","+,2,0,\"editors without hotel language\",0,1,\"pages,tx_testirrecsv_hotel,tx_testirrecsv_offer\",\"pages,tx_testirrecsv_hotel,tx_testirrecsv_offer\",\"tx_testirrecsv_hotel:title,tx_testirrecsv_hotel:offers,tx_testirrecsv_offer:title,tx_testirrecsv_offer:sys_language_uid\",","+,3,0,\"editors without file reference modify access\",0,1,\"pages,tt_content,sys_file_reference\",\"pages,tt_content\",\"tt_content:sys_language_uid\",\"tt_content:CType:text\"","+\"sys_workspace\"","+,\"uid\",\"pid\",\"deleted\",\"title\",\"members\"","+,1,0,0,\"Workspace #1\",\"be_users_2,be_users_4\"","+\"pages\"","+,\"uid\",\"pid\",\"sorting\",\"title\",\"deleted\",\"perms_everybody\"","+,1,0,128,\"Root 1\",0,31","+\"tt_content\"","+,\"uid\",\"pid\",\"sorting\",\"header\",\"deleted\",\"sys_language_uid\",\"image\"","+,1,1,256,\"Content with image\",0,-1,1","+\"sys_file_reference\"","+,\"uid\",\"pid\",\"uid_local\",\"uid_foreign\",\"tablenames\",\"fieldname\",\"deleted\",\"sys_language_uid\"","+,1,1,1,1,\"tt_content\",\"image\",0,-1","+\"tx_testirremm_hotel\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"offers\"","+,1,1,\"Hotel #1\",0,0,1","+\"tx_testirremm_offer\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"hotels\"","+,1,1,\"Offer #1\",0,0,1","+\"tx_testirremm_hotel_offer_rel\"","+,\"uid_local\",\"uid_foreign\",\"sorting\",\"sorting_foreign\"","+,1,1,1,1","+\"tx_testirrecsv_hotel\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"offers\"","+,1,1,\"Hotel #1\",0,0,\"1\"","+\"tx_testirrecsv_offer\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"prices\"","+,1,1,\"Offer #1\",0,0,\"1\""],"additions":38,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageChanged.csv","lines":["@@ -0,0 +1,6 @@","+\"tt_content\"","+,\"uid\",\"pid\",\"header\",\"deleted\",\"sys_language_uid\",\"t3ver_wsid\",\"t3ver_oid\",\"image\"","+,1,1,\"Content with image\",0,0,0,0,1","+\"sys_file_reference\"","+,\"uid\",\"pid\",\"uid_local\",\"uid_foreign\",\"deleted\",\"sys_language_uid\",\"t3ver_wsid\",\"t3ver_oid\"","+,1,1,1,1,0,0,0,0"],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageChangedInWorkspace.csv","lines":["@@ -0,0 +1,8 @@","+\"tt_content\"","+,\"uid\",\"pid\",\"header\",\"deleted\",\"sys_language_uid\",\"t3ver_wsid\",\"t3ver_oid\"","+,1,1,\"Content with image\",0,-1,0,0","+,2,1,\"Content with image\",0,0,1,1","+\"sys_file_reference\"","+,\"uid\",\"pid\",\"uid_local\",\"uid_foreign\",\"deleted\",\"sys_language_uid\",\"t3ver_wsid\",\"t3ver_oid\"","+,1,1,1,1,0,-1,0,0","+,2,1,1,1,0,0,1,1"],"additions":8,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageOfCyclicRelation.csv","lines":["@@ -0,0 +1,6 @@","+\"tx_testirrecsv_hotel\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"offers\"","+,1,1,\"Hotel #1\",0,-1,\"1\"","+\"tx_testirrecsv_offer\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"prices\"","+,1,1,\"Offer #1\",0,-1,\"1\""],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageOfMmRelation.csv","lines":["@@ -0,0 +1,6 @@","+\"tx_testirremm_hotel\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"offers\"","+,1,1,\"Hotel #1\",0,-1,1","+\"tx_testirremm_offer\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"hotels\"","+,1,1,\"Offer #1\",0,0,1"],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageOfNewParentWithoutLanguageAccess.csv","lines":["@@ -0,0 +1,8 @@","+\"tx_testirrecsv_hotel\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"offers\"","+,1,1,\"Hotel #1\",0,0,\"1\"","+,2,1,\"Hotel #2\",0,0,\"2\"","+\"tx_testirrecsv_offer\"","+,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"prices\"","+,1,1,\"Offer #1\",0,0,\"1\"","+,2,1,\"Offer #2\",0,0,\"\""],"additions":8,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/InlineChildLanguageTest.php","lines":["@@ -0,0 +1,110 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Tests\\Functional\\DataHandling\\DataHandler;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\DataHandling\\DataHandler;","+use TYPO3\\CMS\\Core\\Localization\\LanguageServiceFactory;","+use TYPO3\\CMS\\Core\\Schema\\TcaSchemaFactory;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class InlineChildLanguageTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = ['workspaces'];","+","+    protected array $testExtensionsToLoad = [","+        'typo3/sysext/core/Tests/Functional/Fixtures/Extensions/test_irre_csv',","+        'typo3/sysext/core/Tests/Functional/Fixtures/Extensions/test_irre_mm',","+    ];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguage.csv');","+    }","+","+    #[Test]","+    public function childrenFollowStoredLanguageOfNewParent(): void","+    {","+        $dataHandler = $this->processDataMapAsUser(3, [","+            'tx_testirrecsv_hotel' => ['NEW1' => ['pid' => 1, 'title' => 'Hotel #2', 'sys_language_uid' => -1, 'offers' => 'NEW2']],","+            'tx_testirrecsv_offer' => ['NEW2' => ['pid' => 1, 'title' => 'Offer #2', 'sys_language_uid' => -1]],","+        ]);","+","+        self::assertSame([], $dataHandler->errorLog);","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageOfNewParentWithoutLanguageAccess.csv');","+    }","+","+    #[Test]","+    public function childrenOfMmInlineRelationKeepTheirLanguage(): void","+    {","+        $dataHandler = $this->processDataMapAsUser(1, ['tx_testirremm_hotel' => [1 => ['sys_language_uid' => -1]]]);","+","+        self::assertSame([], $dataHandler->errorLog);","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageOfMmRelation.csv');","+    }","+","+    #[Test]","+    public function childrenOfCyclicInlineRelationAreAligned(): void","+    {","+        $GLOBALS['TCA']['tx_testirrecsv_offer']['columns']['prices']['config']['foreign_table'] = 'tx_testirrecsv_hotel';","+        $this->get(TcaSchemaFactory::class)->rebuild($GLOBALS['TCA']);","+","+        $dataHandler = $this->processDataMapAsUser(1, ['tx_testirrecsv_hotel' => [1 => ['sys_language_uid' => -1]]]);","+","+        self::assertSame([], $dataHandler->errorLog);","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageOfCyclicRelation.csv');","+    }","+","+    #[Test]","+    public function editorWithoutAccessToChildLanguageFieldChangesLanguageOfChildren(): void","+    {","+        $dataHandler = $this->processDataMapAsUser(2, ['tt_content' => [1 => ['sys_language_uid' => 0]]]);","+","+        self::assertSame([], $dataHandler->errorLog);","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageChanged.csv');","+    }","+","+    #[Test]","+    public function editorWithoutAccessToChildLanguageFieldChangesLanguageOfChildrenInWorkspace(): void","+    {","+        $dataHandler = $this->processDataMapAsUser(2, ['tt_content' => [1 => ['sys_language_uid' => 0]]], 1);","+","+        self::assertSame([], $dataHandler->errorLog);","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageChangedInWorkspace.csv');","+    }","+","+    #[Test]","+    public function editorWithoutAccessToChildTableChangesLanguageOfChildrenInWorkspace(): void","+    {","+        $this->processDataMapAsUser(4, ['tt_content' => [1 => ['sys_language_uid' => 0]]], 1);","+","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageChangedInWorkspace.csv');","+    }","+","+    private function processDataMapAsUser(int $userId, array $dataMap, int $workspaceId = 0): DataHandler","+    {","+        $backendUser = $this->setUpBackendUser($userId);","+        $backendUser->setWorkspace($workspaceId);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+        $dataHandler = $this->get(DataHandler::class);","+        $dataHandler->start($dataMap, [], $backendUser);","+        $dataHandler->process_datamap();","+        return $dataHandler;","+    }","+}"],"additions":110,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataScenarios/FAL/AbstractActionTestCase.php","lines":["@@ -148,6 +148,100 @@ public function createContentWithFileReference(): void","         $this->recordIds['newContentId'] = $newTableIds[self::TABLE_Content][0];","     }"," ","+    /**","+     * A new file reference without la