m, map, type Observable, of, tap } from 'rxjs';","+import { Readable } from 'stream';","+","+const encoder = new TextEncoder();","+","+/**","+ * What the handlers report to the spec.","+ */","+export const streaming = {","+  started: 0,","+  stopped: 0,","+  pulled: 0,","+  storeWhenStopped: undefined as string | undefined,","+  upstreamUrl: '',","+  // Holds a handler back until the spec has seen what it wanted to","+  gate: Promise.resolve(),","+  openGate: () => {},","+  reset() {","+    this.started = 0;","+    this.stopped = 0;","+    this.pulled = 0;","+    this.storeWhenStopped = undefined;","+    this.gate = new Promise(resolve => (this.openGate = resolve));","+  },","+};","+","+const requestStore = new AsyncLocalStorage<{ id: string }>();","+","+function webStream(chunks: (string | Uint8Array)[], failure?: Error) {","+  const pending = [...chunks];","+  return new ReadableStream({","+    // Not all at once: an error discards what is still queued","+    pull(controller) {","+      const chunk = pending.shift();","+      if (chunk !== undefined) {","+        controller.enqueue(","+          typeof chunk === 'string' ? encoder.encode(chunk) : chunk,","+        );","+      } else if (failure) {","+        controller.error(failure);","+      } else {","+        controller.close();","+      }","+    },","+  });","+}","+","+/**","+ * Sends one chunk, then has nothing more to say, as an upstream that went quiet","+ * in the middle of an LLM answer.","+ */","+function quietWebStream(chunks: string[] = []) {","+  return new ReadableStream({","+    start(controller) {","+      streaming.started++;","+      chunks.forEach(chunk => controller.enqueue(encoder.encode(chunk)));","+    },","+    pull() {","+      return new Promise<void>(() => undefined);","+    },","+    cancel() {","+      streaming.stopped++;","+      streaming.storeWhenStopped = requestStore.getStore()?.id;","+    },","+  });","+}","+","+async function* endlessGenerator() {","+  streaming.started++;","+