  expect(res.headers['content-type']).toMatch(/^text\\/x-decorated/);","+        expect(res.text).toBe('decorated');","+      });","+","+      it('should keep the default status of POST', async () => {","+        const res = await send('/generator/created', { method: 'POST' });","+","+        expect(res.status).toBe(201);","+      });","+","+      it('should iterate any other async iterable', async () => {","+        expect((await send('/generator/iterable')).text).toBe('01');","+      });","+","+      it('should go through the exception filters when it fails before the first chunk', async () => {","+        const res = await send('/generator/fail-first-http');","+","+        expect(res.status).toBe(404);","+        expect(JSON.parse(res.text).message).toBe('not there');","+      });","+","+      it('should reach the filters of the controller', async () => {","+        const res = await send('/generator/fail-first-filtered');","+","+        expect(res.status).toBe(418);","+        expect(res.text).toBe('caught by the filter');","+      });","+","+      it('should not expose an unknown error', async () => {","+        const res = await send('/generator/fail-first-unknown');","+","+        expect(res.status).toBe(500);","+        expect(res.text).not.toContain('private details');","+      });","+","+      it('should end the connection when it fails after the first chunk', async () => {","+        const res = await send('/generator/fail-later');","+","+        expect(res.status).toBe(200);","+        expect(res.text).toBe('partial');","+        expect(res.complete).toBe(false);","+      });","+","+      it('should end the connection when it fails right after the first chunk', async () => {","+        const res = await send('/generator/fail-right-after-first');","+","+        expect(res.status).toBe(200);","+        expect(res.complete).toBe(false);","+      });","+","+      it('should answer 500 and stop it when the first chunk cannot be serialized', async () => {","+        const res = await send('/generator/unserializable-first');","+","+        expect(res.status).toBe(500);","+        await vi.waitFor(() => expect(streaming.stopped).toBe(1));","+      });","+","+      it('should end the connection and stop it when a later chunk cannot be serialized', async () => {","+        const res = await send('/generator/unserializable-later');","+","+        expect(res.text).toBe('{\"n\":1}\\n');","+        expect(res.complete).toBe(false);","+        await vi.waitFor(() => expect(streaming.stopped).toBe(1));","+      });","+","+      it('should call return() when the client leaves', async () => {","+        await sendAndLeave('/generator/endless', 'headers');","+","+        await vi.waitFor(() => expect(streaming.stopped).toBe(1));","+      });","+","+      it('should call return() when the client leaves before the first chunk', async () => {","+        await sendAndLeave('/generator/slow-start', 'sent');","+","+        await vi.waitFor(() => expect(streaming.stopped).toBe(1));","+        expect(streaming.started).toBe(1);","+        expect(streaming.pulled).toBe(0);","+      });","+","+      it('should not read ahead of a client that does not read', async () => {","+        const { port } = new URL(baseUrl);","+        const socket = connect(Number(port), '127.0.0.1');","+        socket.on('error', () => undefined);","+        socket.write(","+          'GET /generator/big HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n',","+        );","+        socket.pause();","+","+        // The socket buffers some of it, up to some MB. The rest has to wait.","+        await vi.waitFor(() => expect(streaming.pulled).toBeGreaterThan(0));","+        await new Promise(resolve => setTimeout(resolve, 300));","+        const pulled = streaming.pulled;","+        expect(pulled).toBeLessThan(32);","+        await new Promise(resolve => setTimeout(resolve, 100));","+        expect(streaming.pulled).toBe(pulled);","+","+        socket.destroy();","+        await vi.waitFor(() => expect(streaming.stopped).toBe(1));","+        // return() is called when the socket closes, outside of the request","+        expect(streaming.storeWhenStopped).toBe('request');","+      });","+","+      it('should keep the AsyncLocalStorage store of the request across reads', async () => {","+        const res = await send('/generator/context');","+","+        expect(res.text.split('\\n').pop()).toBe('[\"request\"]');","+      });","+","+      it('should not start it for HEAD', async () => {","+        const res = await send('/generator', { method: 'HEAD' });","+","+        expect(res.status).toBe(200);","+        expect(res.text).toBe('');","+        expect(res.complete).toBe(true);","+","+        const declared = await send('/generator/head-only', { method: 'HEAD' });","+","+        expect(declared.status).toBe(200);","+        expect(streaming.started).toBe(0);","+      });","+","+      it('should leave the connection reusable after HEAD', async () => {","+        const agent = new Agent({ keepAlive: true, maxSockets: 1 });","+","+        await send('/generator/endless', { method: 'HEAD', agent });","+        const res = await send('/generator', { agent });","+        agent.destroy();","+","+        expect(res.text).toBe('from a generator');","+      });","+    });","+","+    describe('a Node.js Readable', () => {","+      it('should send it', async () => {","+        const res = await send('/node-stream');","+","+        expect(res.status).toBe(200);","+        expect(res.text).toBe('from a node stream');","+        expect(res.headers['content-type']).toBe('text/plain; charset=utf-8');","+      });","+","+      it('should send bytes as binary', async () => {","+        const res = await send('/node-stream/bytes');","+","+        expect(res.text).toBe('from bytes');","+        expect(res.headers['content-type']).toBe('application/octet-stream');","+      });","+","+      it('should send objects as lines of JSON', async ()