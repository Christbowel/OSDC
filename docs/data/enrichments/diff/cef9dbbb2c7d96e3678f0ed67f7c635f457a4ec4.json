it send('/response/content-type-from-decorator');","+","+        expect(res.headers['content-type']).toMatch(/^text\\/x-decorated/);","+        expect(res.text).toBe('decorated');","+      });","+","+      it('should keep the headers a guard set', async () => {","+        const res = await send('/response/guarded');","+","+        expect(res.headers['x-guard']).toBe('ran');","+        expect(res.headers['x-from-response']).toBe('yes');","+      });","+","+      it('should win over the default status of POST', async () => {","+        const res = await send('/response/created', { method: 'POST' });","+","+        expect(res.status).toBe(200);","+        expect(res.text).toBe('created');","+      });","+","+      it('should go through the exception filters when it fails before the first chunk', async () => {","+        const res = await send('/response/fail-first');","+","+        expect(res.status).toBe(404);","+        expect(JSON.parse(res.text).message).toBe('not there');","+        expect(res.headers['x-from-response']).toBeUndefined();","+      });","+","+      it('should end the connection when it fails after the first chunk', async () => {","+        const res = await send('/response/fail-later');","+","+        expect(res.status).toBe(200);","+        expect(res.text).toBe('partial');","+        expect(res.complete).toBe(false);","+      });","+","+      it('should send what fetch() returns, with the body as it decoded it', async () => {","+        const res = await send('/response/fetched');","+","+        expect(res.status).toBe(200);","+        expect(res.text).toBe('hello from upstream');","+        expect(res.headers['content-type']).toMatch(/^text\\/x-upstream/);","+        expect(res.headers['x-upstream']).toBe('yes');","+        expect(res.headers['content-encoding']).toBeUndefined();","+        expect(res.headers['content-length']).toBeUndefined();","+        expect(res.headers['keep-alive']).not.toBe('upstream');","+      });","+","+      it('should