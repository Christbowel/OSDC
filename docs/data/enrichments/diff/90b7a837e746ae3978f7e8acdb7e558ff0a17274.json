hBuf]) {","+        let order = fs::read_to_string(workspace.join(\"order.txt\")).expect(\"read order.txt\");","+        assert_eq!(order.lines().collect::<Vec<&str>>(), [\"root\"]);","+        for member_dir in member_dirs {","+            assert!(","+                !member_dir.join(\"order.txt\").exists(),","+                \"member order.txt exists with: {:?}\",","+                fs::read_to_string(member_dir.join(\"order.txt\")),","+            );","+        }","+    }","+","+    #[test]","+    fn runs_once_for_the_workspace_root_when_shared_workspace_lockfile_is_false() {","+        let CommandTempCwd {","+            pacquet,","+            root,","+            workspace,","+            npmrc_info,","+            ..","+        } = CommandTempCwd::init().add_mocked_registry();","+        let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+        let member_dirs = write_dedicated_workspace_with_hooks(&workspace);","+","+        pacquet","+            .with_arg(\"install\")","+            .assert()","+            .success();","+","+        assert_only_the_root_ran(&workspace, &member_dirs);","+        drop((root, mock_instance));","+    }","+","+    #[test]","+    fn runs_for_the_workspace_root_when_a_filtered_install_excludes_it() {","+        let CommandTempCwd {","+            pacquet,","+            root,","+            workspace,","+            npmrc_info,","+            ..","+        } = CommandTempCwd::init().add_mocked_registry();","+        let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+        let member_dirs = write_dedicated_workspace_with_hooks(&workspace);","+","+        pacquet","+            .with_args([\"--filter\", \"member-a\", \"install\"])","+            .assert()","+            .success();","+","+        assert_only_the_root_ran(&workspace, &member_dirs);","+        drop((root, mock_instance));","+    }","+","+    #[test]","+    fn runs_the_workspace_roots_script_with_the_roots_bin_dir_when_a_member_reaches_it_firs