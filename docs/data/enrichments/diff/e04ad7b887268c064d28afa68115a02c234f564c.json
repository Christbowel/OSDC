len, client_path, path_len + 1);","+    return ret_str;","+}","+","+/**","+ * Map a client path to a server path when the request does not create a","+ * sequential node.","+ */","+static char* prepend_string(zhandle_t *zh, const char* client_path) {","+    return prepend_chroot(zh, client_path, 0);"," }"," "," /**","-   strip off the chroot string from the server path","-   if there is one else return the exact path","+ * Give the error for a null result of prepend_chroot. An absolute client","+ * path maps to null only if the allocation fails.","+ */","+static int prepend_error(const char* client_path) {","+    return (client_path != NULL && client_path[0] == '/') ?","+        ZSYSTEMERROR : ZBADARGUMENTS;","+}","+","+/**","+ * Map a server path to a client path.","+ *","+ * The chroot prefix matches only at a path component boundary, f.e. a chroot","+ * of /app does not match the path /app2. Cluster configuration is not in","+ * the chroot namespace, so it is not affected by the chroot prefix.","+ * A chroot of /zookeeper is the exception. The configuration node is then","+ * inside the chroot, so the client reports its path as /config.","  */"," char* sub_string(zhandle_t *zh, const char* server_path) {","-    char *ret_str;","-    if (zh->chroot == NULL)","+    size_t chroot_len;","+    if (zh->chroot == NULL || server_path == NULL)","         return (char *) server_path;","     //ZOOKEEPER-1027","-    if (strncmp(server_path, zh->chroot, strlen(zh->chroot)) != 0) {","+    chroot_len = strlen(zh->chroot);","+    if (strncmp(server_path, zh->chroot, chroot_len) == 0) {","+        if (server_path[chroot_len] == '\\0') {","+            return strdup(\"/\");","+        }","+        if (server_path[chroot_len] == '/') {","+            return strdup(server_path + chroot_len);","+        }","+    }","+    if (strcmp(server_path, ZOO_CONFIG_NODE) != 0) {","         LOG_ERROR(LOGCALLBACK(zh), \"server path %s does not include chroot path %s\",","                    serv