{"id":"3d553600b9ce1f3d69e2e8b40183b1f1ce638eeb","axis":"silent","repo":"pnpm/pnpm","sha":"3d553600b9ce1f3d69e2e8b40183b1f1ce638eeb","parsed":{"files":[{"path":".changeset/lone-project-version-bump.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.status\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`verifyDepsBeforeRun` no longer reports dependencies as out of sync when only the `version` field of a single-project repository changed. A script run after such a change no longer starts an install first [#17560](https://github.com/pnpm/pnpm/issues/17560)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install.rs","lines":["@@ -194,6 +194,7 @@ pub(crate) fn check_optimistic_repeat_install_with_state(","         &state,","         check.workspace_root,","         check.project_manifests.as_slice(),","+        check.config,","     )","     .map_or((state, false), |relocated| (relocated, true));","     let policy = GatePolicy {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/deps_status.rs","lines":["@@ -76,8 +76,12 @@ pub fn check_deps_status_before_run(","     if check.layout.node_linker == NodeLinker::Pnp {","         return RunDepsStatus::SkippedPnp;","     }","-    let relocated =","-        relocated_state(state, check.workspace_root, check.project_manifests.as_slice());","+    let relocated = relocated_state(","+        state,","+        check.workspace_root,","+        check.project_manifests.as_slice(),","+        check.config,","+    );","     let moved = relocated.is_some();","     let state = relocated.as_ref().unwrap_or(state);","     let config = check.config;"],"additions":6,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/freshness.rs","lines":["@@ -255,7 +255,7 @@ fn check_settings_and_workspace_freshness(","     if !catalogs_cache_matches(state.settings.cata