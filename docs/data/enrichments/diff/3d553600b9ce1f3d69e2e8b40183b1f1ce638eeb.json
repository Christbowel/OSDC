pnpm_workspace_state::{ProjectEntry, WorkspaceState};"," use std::path::{Path, PathBuf};","@@ -30,7 +31,7 @@ fn relocated_onto(","         .cloned()","         .zip(&manifests)","         .collect();","-    relocated_state(state, workspace_root, &project_manifests)","+    relocated_state(state, workspace_root, &project_manifests, &Config::new())"," }"," "," fn path_string(path: &Path) -> String {"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settle.rs","lines":["@@ -118,13 +118,21 @@ pub(super) fn wanted_lockfile_file_has_content(workspace_root: &Path, config: &C"," /// cached state and today's walk. The key is the project's root dir;"," /// `build_workspace_state` and pnpm both use it as the map key, so a"," /// renamed / removed / added project trips the check immediately.","+///","+/// A version decides only how dependencies resolve to the project. The","+/// version of a lone project is compared only under","+/// [`LinkWorkspacePackages::Deep`], where a transitive dependency may resolve","+/// to it."," pub(super) fn project_structure_matches(","     state: &WorkspaceState,","     project_manifests: &[(PathBuf, &PackageManifest)],","+    config: &Config,"," ) -> bool {","     if state.projects.len() != project_manifests.len() {","         return false;","     }","+    let compare_versions = project_manifests.len() > 1","+        || config.link_workspace_packages == LinkWorkspacePackages::Deep;","     project_manifests","         .iter()","         .all(|(root_dir, manifest)| {","@@ -133,7 +141,8 @@ pub(super) fn project_structure_matches(","                 return false;","             };","             entry.name.as_deref() == manifest_string_field(manifest, \"name\").as_deref()","-                && entry.version.as_deref().unwrap_or(\"0.0.0\")","-                    == manifest_string_field(manifest, \"version\").as_deref().unwrap_or(\"0.0.0\")","+                && (!compare_versions","+                    || entry.version.as_deref().unwrap_or(\"0.0.0\")","+                        == manifest_string_field(manifest, \"version\").as_deref().unwrap_or(\"0.0.0\"))","         })"," }"],"additions":11,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/workspace.rs","lines":["@@ -292,6 +292,90 @@ fn install_and_run_refuse_a_changed_workspace_project_set() {","     let state = load_workspace_state(dir.path()).unwrap().unwrap();","     assert_eq!(state.projects.len(), 2, \"a rejected project set must not refresh the state\");"," }","+/// [pnpm/pnpm#17560](https://github.com/pnpm/pnpm/issues/17560)","+#[test]","+fn install_and_run_accept_a_version_bump_of_a_lone_project() {","+    let (dir, config, manifest) =","+        bump_lone_project_version(pnpm_config::LinkWorkspacePackages::DirectOnly);","+    let projects = [(dir.path().to_path_buf(), &manifest)];","+    let recorded = load_workspace_state(dir.path()).unwrap().unwrap();","+","+    let decision = check(dir.path(), config, pnpm_config::NodeLinker::Isolated, &projects);","+    assert_eq!(decision, Decision::UpToDate);","+    update_workspace_state(dir.path(), &recorded).unwrap();","+    let status = workspace_deps_status(&dir, config, &projects);","+    assert_eq!(status, RunDepsStatus::UpToDate);","+}","+/// Under `linkWorkspacePackages: deep` a transitive dependency may resolve to","+/// the lone project by its version.","+#[test]","+fn install_and_run_refuse_a_version_bump_of_a_lone_project_under_deep_linking() {","+    let (dir, config, manifest) =","+        bump_lone_project_version(pnpm_config::LinkWorkspacePackages::Deep);","+    let projects = [(dir.path().to_path_buf(), &manifest)];","+","+    let decision = check(dir.path(), config, pnpm_config::NodeLinker::Isolated, &projects);","+    assert!(matches!(decision, Decision::Skipped { reason } if reason.contains(\"project list\")));","+    let status = workspace_deps_status(&dir, config, &projects);","+    assert_eq!(","+        status,","+        RunDepsStatus::Outdated {","+            issue: \"The workspace structure has changed since last install\".to_string(),","+            install_args: Vec::new(),","+        },","+    );","+}","+/// A project installed as `root@1.0.0` whose manifest now says `1.0.1`. The","+/// new manifest is recorded as validated, so only the project-structure check","+/// can tell the two apart.","+fn bump_lone_project_version(","+    link_workspace_packages: pnpm_config::LinkWorkspacePackages,","+) -> (tempfile::TempDir, &'static Config, PackageManifest) {","+    let (dir, config, _) = setup_fresh_install_with_config(","+        pnpm_config::NodeLinker::Isolated,","+        \"root\",","+        \"1.0.0\",","+        \"\",","+        |config| config.link_workspace_packages = link_workspace_packages,","+    );","+    let manifest_path = dir.path().join(\"package.json\");","+    fs::write(&manifest_path, r#\"{\"name\":\"root\",\"version\":\"1.0.1\"}\"#).unwrap();","+    validate_existing_files(dir.path());","+    (dir, config, PackageManifest::from_path(manifest_path).unwrap())","+}","+/// Another project's dependency may resolve to a workspace project by its","+/// version, so a version bump in a workspace of several projects is drift.","+#[test]","+fn install_and_run_refuse_a_version_bump_in_a_workspace_of_several_projects() {","+    let (dir, config, root) =","+        setup_fresh_install(pnpm_config::NodeLinker::Isolated, \"root\", \"1.0.0\", \"\");","+    let pkg_dir = dir.path().join(\"pkg-a\");","+    fs::create_dir_all(&pkg_dir).unwrap();","+    fs::write(pkg_dir.join(\"package.json\"), r#\"{\"name\":\"pkg-a\",\"version\":\"1.0.1\"}\"#).unwrap();","+    let pkg = PackageManifest::from_path(pkg_dir.join(\"package.json\")).unwrap();","+    let mut state = load_workspace_state(dir.path()).unwrap().unwrap();","+    state.projects.insert(","+        pkg_dir.to_string_lossy().into_owned(),","+        ProjectEntry {","+            name: Some(\"pkg-a\".into()),","+            version: Some(\"1.0.0\".into()),","+            has_modules_dir: false,","+        },","+    );","+    update_workspace_state(dir.path(), &state).unwrap();","+    let projects = [(dir.path().to_path_buf(), &root), (pkg_dir, &pkg)];","+","+    let decision = check(dir.path(), config, pnpm_config::NodeLinker::Isolated, &projects);","+    assert!(matches!(decision, Decision::Skipped { reason } if reason.contains(\"project list\")));","+    let status = workspace_deps_status(&dir, config, &projects);","+    assert_eq!(","+        status,","+        RunDepsStatus::Outdated {","+            issue: \"The workspace structure has changed since last install\".to_string(),","+            install_args: Vec::new(),","+        },","+    );","+}"," /// Record the only project under a sibling of `workspace_root`, as a tree"," /// copied from there carries it. Returns the recorded dir."," fn record_projects_elsewhere(workspace_root: &std::path::Path) -> String {"],"additions":84,"deletions":0,"truncated":false},{"path":"pnpm11/deps/status/src/findWorkspaceStructureIssue.ts","lines":["@@ -10,11 +10,15 @@ export function findWorkspaceStructureIssue ({ allProjects, opts, workspaceState","   )) {","     return 'Catalogs cache outdated'","   }","+  // A version decides only how dependencies resolve to the project. A lone","+  // project's version matters only when a transitive dependency may resolve to it.","+  const compareVersions = allProjects.length > 1 || opts.linkWorkspacePackages === 'deep'","   if (allProjects.length !== Object.keys(workspaceState.projects).length ||","     !allProjects.every((currentProject) => {","       const prevProject = workspaceState.projects[currentProject.rootDir]","       if (!prevProject) return false","-      return prevProject.name === currentProject.manifest.name && (prevProject.version ?? '0.0.0') === (currentProject.manifest.version ?? '0.0.0')","+      return prevProject.name === currentProject.manifest.name &&","+        (!compareVersions || (prevProject.version ?? '0.0.0') === (currentProject.manifest.version ?? '0.0.0'))","     })","   ) {","     return 'The workspace structure has changed since last install'"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpm11/deps/status/test/findWorkspaceStructureIssue.test.ts","lines":["@@ -0,0 +1,59 @@","+import path from 'node:path'","+","+import { expect, test } from '@jest/globals'","+import type { ProjectRootDir } from '@pnpm/types'","+import type { ProjectsList } from '@pnpm/workspace.state'","+","+import type { WorkspaceDepsStatusContext } from '../src/checkWorkspaceDepsStatus.js'","+import { findWorkspaceStructureIssue } from '../src/findWorkspaceStructureIssue.js'","+","+const workspaceDir = path.resolve('workspace')","+const pkgDir = path.join(workspaceDir, 'packages/a')","+","+// https://github.com/pnpm/pnpm/issues/17560","+test('a version bump of a lone project is not a structure change', () => {","+  const allProjects: ProjectsList = [","+    { rootDir: workspaceDir as ProjectRootDir, manifest: { name: 'root', version: '1.0.1' } },","+  ]","+  expect(findWorkspaceStructureIssue(context(allProjects))).toBeUndefined()","+})","+","+test('a version bump of a lone project is a structure change under deep workspace linking', () => {","+  const allProjects: ProjectsList = [","+    { rootDir: workspaceDir as ProjectRootDir, manifest: { name: 'root', version: '1.0.1' } },","+  ]","+  expect(findWorkspaceStructureIssue(context(allProjects, { linkWorkspacePackages: 'deep' })))","+    .toBe('The workspace structure has changed since last install')","+})","+","+test('a version bump in a workspace of several projects is a structure change', () => {","+  const allProjects: ProjectsList = [","+    { rootDir: workspaceDir as ProjectRootDir, manifest: { name: 'root', version: '1.0.0' } },","+    { rootDir: pkgDir as ProjectRootDir, manifest: { name: 'a', version: '1.0.1' } },","+  ]","+  expect(findWorkspaceStructureIssue(context(allProjects))).toBe('The workspace structure has changed since last install')","+})","+","+test('a rename of a lone project is a structure change', () => {","+  const allProjects: ProjectsList = [","+    { rootDir: workspaceDir as ProjectRootDir, manifest: { name: 'renamed', version: '1.0.0' } },","+  ]","+  expect(findWorkspaceStructureIssue(context(allProjects))).toBe('The workspace structure has changed since last install')","+})","+","+function context (","+  allProjects: ProjectsList,","+  opts: Partial<WorkspaceDepsStatusContext['opts']> = {}","+): WorkspaceDepsStatusContext {","+  const recorded = {","+    [workspaceDir]: { name: 'root', version: '1.0.0' },","+    [pkgDir]: { name: 'a', version: '1.0.0' },","+  }","+  const projects = Object.fromEntries(allProjects.map(({ rootDir }) => [rootDir, recorded[rootDir]]))","+  return {","+    allProjects,","+    opts,","+    workspaceDir,","+    workspaceState: { projects, settings: {} },","+  } as unknown as WorkspaceDepsStatusContext","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"pnpm11/pnpm/test/verifyDepsBeforeRun/singleProjectWorkspace.ts","lines":["@@ -189,6 +189,27 @@ test('no dependencies', async () => {","   }"," })"," ","+// https://github.com/pnpm/pnpm/issues/17560","+test('a version bump of the project runs the script without an install', async () => {","+  const manifest: ProjectManifest = {","+    name: 'root',","+    version: '1.0.0',","+    private: true,","+    scripts: {","+      start: 'echo hello from script',","+    },","+  }","+","+  const project = prepare(manifest)","+  writeYamlFileSync('pnpm-workspace.yaml', { verifyDepsBeforeRun: 'error' })","+  await execPnpm(['install'])","+","+  project.writePackageJson({ ...manifest, version: '1.0.1' })","+","+  const { stdout } = execPnpmSync([...CONFIG, 'start'], { expectSuccess: true })","+  expect(stdout.toString()).toContain('hello from script')","+})","+"," test('nested `pnpm run` should not check for mutated manifest', async () => {","   const manifest: ProjectManifest = {","     name: 'root',",""],"additions":21,"deletions":0,"truncated":false}],"additions":201,"deletions":9,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-02T17:24:52.977411+00:00"}