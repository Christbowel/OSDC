{"id":"b0d61e5d26561f865bf89688eb0aea5000133a42","axis":"silent","repo":"vllm-project/vllm","sha":"b0d61e5d26561f865bf89688eb0aea5000133a42","parsed":{"files":[{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -11,9 +11,12 @@ steps:","   - \"!vllm/distributed/kv_transfer/\"","   - tests/models/test_initialization.py","   - tests/models/registry.py","+  - tests/models/test_beam_construction.py","   commands:","     # Run a subset of model initialization tests","     - pytest -v -s models/test_initialization.py::test_can_initialize_small_subset","+    # Exercise Beam construction and generation without a checkpoint download.","+    - pytest -v -s models/test_beam_construction.py","   mirror:","     amd:","       label: \":amd: (MI355 DPX) Basic Models (Initialization)\"","@@ -258,6 +261,8 @@ steps:","   - tests/models/test_qwen3_5_mtp_config.py","   - tests/models/test_alice_ai.py","   - tests/models/test_alice_ai_config.py","+  - tests/models/test_beam_weight_mapping.py","+  - tests/models/test_beam_numerics.py","   - tests/models/transformers/fusers/","   - tests/models/transformers/test_dynamic_rope.py","   - tests/model_executor/layers/test_activation.py","@@ -268,7 +273,7 @@ steps:","   - tests/models/transformers/test_layer_registry.py","   device: cpu-small","   commands:","-    - pytest -v -s models/test_utils.py models/test_vision.py models/test_adapters.py models/test_qwen3_5_mtp_config.py models/transformers/fusers/ models/transformers/test_dynamic_rope.py model_executor/layers/test_activation.py models/test_language_model_cache_is_weak.py models/deepseek_v32/test_sequence_parallel.py models/test_deepseek_v4_fi_moe_ep.py models/test_dspark_mla.py models/transformers/test_layer_registry.py models/test_alice_ai.py models/test_alice_ai_config.py","+    - pytest -v -s models/test_utils.py models/test_vision.py models/test_adapters.py models/test_qwen3_5_mtp_config.py models/transformers/fusers/ models/transformers/test_dynamic_rope.py model_executor/layers/test_activation.py models/test_language_model_cache_is_weak.py models/deepseek_v32/test_sequence_parallel.py models/test_deepseek_v4_fi_moe_ep.py models/test_dspark_mla.py models/transformers/test_layer_registry.py models/test_alice_ai.py models/test_alice_ai_config.py models/test_beam_weight_mapping.py models/test_beam_numerics.py"," "," - label: ':amd: (MI355) DeepSeek-V4.1 Mono Decode Numerics'","   key: dsv41-mono-decode-numerics-amd"],"additions":6,"deletions":1,"truncated":false},{"path":"docs/models/supported_models.md","lines":["@@ -379,6 +379,7 @@ th {"," | `BailingMoeV2ForCausalLM` | Ling | `inclusionAI/Ling-mini-2.0`, etc. | ✅︎ | ✅︎ |"," | `BailingMoeV2_5ForCausalLM` | Ling | `inclusionAI/Ling-2.5-1T`, `inclusionAI/Ring-2.5-1T` | | ✅︎ |"," | `BailingMoeV3ForCausalLM` | Ling | `inclusionAI/Ling-3.0-flash` | | ✅︎ |","+| `BeamForCausalLM` | Beam | `reflection/Beam-1.0-501B-A23B-NVFP4`, etc. | | ✅︎ |"," | `BloomForCausalLM` | BLOOM, BLOOMZ, BLOOMChat | `bigscience/bloom`, `bigscience/bloomz`, etc. | | ✅︎ |"," | `ChatGLMModel`, `ChatGLMForConditionalGeneration` | ChatGLM | `zai-org/chatglm2-6b`, `zai-org/chatglm3-6b`, `thu-coai/ShieldLM-6B-chatglm3`, etc. | ✅︎ | ✅︎ |"," | `CohereForCausalLM`, `Cohere2ForCausalLM` | Command-R, Command-A | `CohereLabs/c4ai-command-r-v01`, `CohereLabs/c4ai-command-r7b-12-2024`, `CohereLabs/c4ai-command-a-03-2025`, `CohereLabs/command-a-reasoning-08-2025`, etc. | ✅︎ | ✅︎ |"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -216,6 +216,12 @@ def check_available_online(","     \"BailingMoeV3ForCausalLM\": _HfExamplesInfo(","         \"inclusionAI/Ling-3.0-flash\", trust_remote_code=True","     ),","+    \"BeamForCausalLM\": _HfExamplesInfo(","+        \"reflection/Beam-1.0-501B-A23B-NVFP4\",","+        is_available_online=False,","+        # Include MoE in the reduced one-layer initialization test.","+        hf_overrides={\"mlp_layer_types\": [\"sparse\"]},","+    ),","     \"BloomForCausalLM\": _HfExamplesInfo(","         \"bigscience/bloom-560m\", {\"1b\": \"bigscience/bloomz-1b1\"}","     ),","@@ -1490,6 +1496,12 @@ def check_available_online(","         max_model_len=8192,","         max_num_seqs=32,","     ),","+    \"DFlash2BeamDraftModel\": _HfExamplesInfo(","+        \"reflection/Beam-1.0-501B-A23B-NVFP4\",","+        speculative_model=\"reflection/Beam-1.0-501B-A23B-DFlash2\",","+        is_available_online=False,","+        use_original_num_layers=True,","+    ),","     \"DFlashLagunaForCausalLM\": _HfExamplesInfo(","         \"poolside/Laguna-XS-2.1-NVFP4\",","         speculative_model=\"poolside/Laguna-XS-2.1-DFlash-NVFP4\","],"additions":12,"deletions":0,"truncated":false},{"path":"tests/models/test_beam_construction.py","lines":["@@ -0,0 +1,212 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Construct Beam from a synthetic config and generate with dummy weights.","+","+Exercises NoPE + SSMax, hybrid sliding-window attention, the sigmoid output","+gate and its per-head bias, sandwich norm, depth-scaled residuals, grouped","+sigmoid routing, and logit softcapping without downloading a checkpoint.","+\"\"\"","+","+import json","+from operator import attrgetter","+from types import SimpleNamespace","+","+import pytest","+import torch","+from torch import nn","+","+from vllm import LLM, SamplingParams","+from vllm.models.beam.nvidia import model as beam","+from vllm.platforms import current_platform","+from vllm.transformers_utils.configs.beam import BeamConfig","+from vllm.v1.worker.gpu.spec_decode.eagle.eagle3_utils import (","+    set_eagle3_aux_hidden_state_layers,","+)","+","+# `moe_intermediate_size` must be a multiple of 128 for the BF16 MoE kernel.","+TINY_CONFIG = {","+    \"architectures\": [\"BeamForCausalLM\"],","+    \"model_type\": \"beam\",","+    \"vocab_size\": 1024,","+    \"hidden_size\": 128,","+    \"intermediate_size\": 256,","+    \"num_hidden_layers\": 2,","+    \"num_attention_heads\": 8,","+    \"num_key_value_heads\": 2,","+    \"head_dim\": 16,","+    \"max_position_embeddings\": 512,","+    \"rms_norm_eps\": 1e-6,","+    \"sliding_window\": 128,","+    \"moe_intermediate_size\": 256,","+    \"num_experts_per_tok\": 2,","+    \"num_experts\": 8,","+    \"n_group\": 2,","+    \"topk_group\": 1,","+    \"routed_scaling_factor\": 1.0,","+    \"norm_topk_prob\": True,","+    # Layer 1 is NoPE, so it takes the SSMax path and full attention while","+    # layer 0 stays RoPE + sliding. Exercises both branches in one model.","+    \"layer_types\": [\"sliding_attention\", \"full_attention\"],","+    \"rope_parameters\": {","+        \"sliding_attention\": {\"rope_type\": \"default\", \"rope_theta\": 10000.0},","+        \"full_attention\": None,","+    },","+    \"mlp_layer_types\": [\"dense\", \"sparse\"],","+    \"final_logit_softcapping\": 30.0,","+    \"torch_dtype\": \"bfloat16\",","+    \"bos_token_id\": 1,","+    \"eos_token_id\": 2,","+}","+","+","+@pytest.mark.skipif(not current_platform.is_cuda(), reason=\"Beam targets CUDA\")","+@pytest.mark.usefixtures(\"enable_pickle\")","+@pytest.mark.parametrize(","+    \"enforce_eager,tp_size,num_experts,enable_ep\",","+    [","+        (True, 1, 8, False),","+        (False, 1, 8, False),","+        (True, 4, 2, False),","+        (True, 4, 8, True),","+    ],","+)","+def test_beam_builds_and_generates(","+    tmp_path, enforce_eager, tp_size, num_experts, enable_ep","+):","+    \"\"\"Release-style metadata must load and generate in both execution modes.\"\"\"","+    if torch.accelerator.device_count() < tp_size:","+        pytest.skip(f\"Requires {tp_size} GPUs\")","+    config = {","+        **TINY_CONFIG,","+        \"num_experts\": num_experts,","+        \"moe_intermediate_size\": max(256, 128 * tp_size),","+        \"n_group\": 1 if num_experts == 2 else 2,","+    }","+    (tmp_path / \"config.json\").write_text(json.dumps(config))","+","+    llm = LLM(","+        model=str(tmp_path),","+        load_format=\"dummy\",","+        skip_tokenizer_init=True,","+        max_model_len=256,","+        max_num_seqs=1,","+        max_num_batched_tokens=256,","+        kv_cache_memory_bytes=16 * 1024**2,","+        gpu_memory_utilization=0.25,","+        enforce_eager=enforce_eager,","+        tensor_parallel_size=tp_size,","+        enable_expert_parallel=enable_ep,","+    )","+    outputs = llm.generate(","+        {\"prompt_token_ids\": [5, 6, 7, 8]},","+        SamplingParams(max_tokens=8, ignore_eos=True),","+    )","+","+    assert len(outputs[0].outputs[0].token_ids) == 8","+    # TP shards every expert; only EP partitions the expert set across ranks.","+    local_experts = num_experts // tp_size if enable_ep else num_experts","+    assert llm.apply_model(attrgetter(\"num_local_physical_experts\")) == (","+        [local_experts] * tp_size","+    )","+","+","+def test_eplb_is_rejected_until_validated(monkeypatch):","+    \"\"\"Expert parallelism is validated; expert rebalancing is not.\"\"\"","+    config = SimpleNamespace(","+        model_config=SimpleNamespace(hf_config=BeamConfig()),","+        quant_config=None,","+        parallel_config=SimpleNamespace(","+            enable_eplb=True, use_sequence_parallel_moe=False","+        ),","+    )","+    with pytest.raises(NotImplementedError, match=\"EPLB\"):","+        beam.BeamForCausalLM(vllm_config=config)","+","+","+def test_sequence_parallel_moe_is_rejected_until_validated():","+    \"\"\"DP attention with EP MoE takes the sequence-parallel path; unvalidated.\"\"\"","+    config = SimpleNamespace(","+        model_config=SimpleNamespace(hf_config=BeamConfig()),","+        quant_config=None,","+        parallel_config=SimpleNamespace(","+            enable_eplb=False, use_sequence_parallel_moe=True","+        ),","+    )","+    with pytest.raises(NotImplementedError, match=\"sequence-parallel\"):","+        beam.BeamForCausalLM(vllm_config=config)","+","+","+def test_dense_only_pipeline_stage_initializes(monkeypatch):","+    \"\"\"A stage with dense layers and remote MoE layers needs no local experts.\"\"\"","+    layer = beam.BeamDecoderLayer.__new__(beam.BeamDecoderLayer)","+    nn.Module.__init__(layer)","+    layer.mlp = nn.Identity()","+    stage = nn.Module()","+    stage.layers = nn.ModuleList([layer, beam.PPMissingLayer()])","+    stage.make_empty_intermediate_tensors = lambda *args, **kwargs: None","+    monkeypatch.setattr(beam, \"BeamModel\", lambda **kwargs: stage)","+    monkeypatch.setattr(","+        beam, \"get_pp_group\", lambda: SimpleNamespace(is_last_rank=False)","+    )","+    monkeypatch.setattr(beam, \"LogitsProcessor\", lambda *args: nn.Identity())","+    config = SimpleNamespace(","+        model_config=SimpleNamespace(hf_config=BeamConfig()),","+        quant_config=None,","+        parallel_config=SimpleNamespace(","+            enable_eplb=False, use_sequence_parallel_moe=False","+        ),","+    )","+","+    model = beam.BeamForCausalLM(vllm_config=config)","+","+    assert model.moe_layers == []","+    assert model.num_moe_layers == 0","+    assert model.num_logical_experts == 0","+    assert model.num_local_physical_experts == 0","+","+","+class _AddOneLayer(nn.Module):","+    \"\"\"Adds one to the residual stream and hands the next layer double that.\"\"\"","+","+    def __init__(self):","+        super().__init__()","+        self.input_layernorm = nn.Identity()","+","+    def forward(self, positions, hidden_states, normalized_states, next_norm_weight):","+        hidden_states = hidden_states + 1","+        return hidden_states, hidden_states * 2","+","+","+@pytest.mark.cpu_test","+def test_dflash_target_layers_capture_layer_outputs(monkeypatch):","+    \"\"\"DFlash `target_layer_ids` name the layer whose output is captured.\"\"\"","+    model = beam.BeamModel.__new__(beam.BeamModel)","+    nn.Module.__init__(model)","+    model.start_layer, model.end_layer = 0, 3","+    model.layers = nn.ModuleList([_AddOneLayer() for _ in range(3)])","+    model.norm = nn.Identity()","+    target = beam.BeamForCausalLM.__new__(beam.BeamForCausalLM)","+    nn.Module.__init__(target)","+    target.model = model","+    monkeypatch.setattr(","+        beam,","+        \"get_pp_group\",","+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),","+    )","+    spec_config = SimpleNamespace(","+        draft_model_config=SimpleNamespace(","+            hf_config=SimpleNamespace(dflash_config={\"target_layer_ids\": [0, 1]})","+        )","+    )","+","+    set_eagle3_aux_hidden_state_layers(target, spec_config)","+    output, aux_hidden_states = target(","+        input_ids=None,","+        positions=torch.tensor([0]),","+        inputs_embeds=torch.tensor([[1.0, 2.0]]),","+    )","+","+    torch.testing.assert_close(output, torch.tensor([[8.0, 10.0]]))","+    assert len(aux_hidden_states) == 2","+    torch.testing.assert_close(aux_hidden_states[0], torch.tensor([[2.0, 3.0]]))","+    torch.testing.assert_close(aux_hidden_states[1], torch.tensor([[3.0, 4.0]]))"],"additions":212,"deletions":0,"truncated":false},{"path":"tests/models/test_beam_numerics.py","lines":["@@ -0,0 +1,481 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Regressions for Beam normalization and activation rounding.\"\"\"","+","+import pytest","+import torch","+","+","+def _torch_rms_norm(x, weight, eps):","+    y = x.float()","+    y = y * torch.rsqrt(y.square().mean(-1, keepdim=True) + eps) * weight.float()","+    return y.to(x.dtype)","+","+","+def _torch_boundary(x, residual, post_weight, post_eps, next_weight, next_eps, scales):","+    x = _torch_rms_norm(x, post_weight, post_eps) * scales[0]","+    hidden = x + residual.to(x.dtype) * scales[1]","+    normalized = (","+        _torch_rms_norm(hidden, next_weight, next_eps) if next_eps is not None else None","+    )","+    return hidden, normalized","+","+","+def _assert_boundary_close(actual, expected, *, relative_tolerance=1e-4):","+    for value, reference in zip(actual, expected):","+        if reference is None:","+            assert value is None","+            continue","+        bf16 = reference.dtype == torch.bfloat16","+        torch.testing.assert_close(","+            value,","+            reference,","+            rtol=0.016 if bf16 else 2e-5,","+            atol=0.016 if bf16 else 2e-6,","+        )","+        # Allow isolated BF16 rounding differences, but catch omitted casts.","+        if reference.numel():","+            error = (value.float() - reference.float()).norm()","+            assert error <= reference.float().norm() * (","+                relative_tolerance if bf16 else 2e-6","+            )","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")","+@pytest.mark.parametrize(\"dtype\", [torch.bfloat16, torch.float32])","+@pytest.mark.parametrize(\"rows\", [0, 1, 8, 128])","+@pytest.mark.parametrize(\"cap\", [7.3, 30.0])","+@torch.inference_mode()","+def test_softcap_rounds_into_original_logits_without_touching_padding(dtype, rows, cap):","+    from vllm.models.beam.nvidia.activation import beam_softcap_logits","+","+    torch.manual_seed(42)","+    storage = torch.randn(rows, 264, device=\"cuda\", dtype=dtype) * (cap * 3)","+    logits = storage[:, :257]","+    if rows:","+        logits[0, :6] = torch.tensor(","+            [0.0, -0.0, float(\"inf\"), -float(\"inf\"), float(\"nan\"), 1e-38],","+            device=logits.device,","+            dtype=dtype,","+        )","+    original = storage.clone()","+    expected = (torch.tanh(logits.float() / cap) * cap).to(dtype)","+    actual = beam_softcap_logits(logits, cap)","+","+    assert actual is logits","+    assert actual.dtype == dtype","+    torch.testing.assert_close(actual, expected, rtol=0, atol=0, equal_nan=True)","+    torch.testing.assert_close(","+        storage[:, 257:], original[:, 257:], rtol=0, atol=0, equal_nan=True","+    )","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")","+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])","+@pytest.mark.parametrize(","+    \"rows,width\", [(0, 2560), (1, 5120), (8, 2560), (33, 513), (2048, 2560)]","+)","+@torch.inference_mode()","+def test_dense_activation_rounds_after_product(default_vllm_config, dtype, rows, width):","+    \"\"\"BF16 I/O must not round the SiLU result before multiplication.\"\"\"","+    import vllm._custom_ops  # noqa: F401","+    from vllm.models.beam.nvidia.activation import beam_silu_mul","+","+    torch.manual_seed(42)","+    x = torch.randn(rows, 2 * width, device=\"cuda\", dtype=dtype) * 4","+    expected = torch.empty(rows, width, device=\"cuda\", dtype=torch.float32)","+    if rows:","+        torch.ops._C.silu_and_mul(expected, x.float())","+    actual = beam_silu_mul(x)","+    torch.testing.assert_close(","+        actual,","+        expected.to(dtype),","+        rtol=0.008 if dtype == torch.bfloat16 else 1e-6,","+        atol=1e-7,","+    )","+    if rows:","+        error = (actual.float() - expected.to(dtype).float()).norm()","+        assert error <= expected.norm() * 1e-5","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")","+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])","+@pytest.mark.parametrize(\"shape\", [(33, 513), (17, 6, 128)])","+@torch.inference_mode()","+def test_fused_norm_preserves_fp32_affine_for_strided_rows(dtype, shape):","+    \"\"\"QKV slices and near-epsilon values retain the reference's FP32 affine.\"\"\"","+    from vllm.models.beam.nvidia.layernorm import beam_rms_norm","+","+    generator = torch.Generator(device=\"cuda\").manual_seed(42)","+    storage = torch.randn(","+        (*shape[:-1], shape[-1] + 64),","+        device=\"cuda\",","+        dtype=dtype,","+        generator=generator,","+    )","+    x = storage[..., 1 : shape[-1] + 1]","+    x[::2].mul_(1e-3)","+    weight = torch.randn(shape[-1], device=\"cuda\", dtype=dtype, generator=generator)","+    expected = _torch_rms_norm(x, weight, 1e-6)","+    actual = beam_rms_norm(x, weight, 1e-6)","+    # FP32 reduction trees may differ; allow one BF16 ULP after final rounding.","+    torch.testing.assert_close(","+        actual,","+        expected,","+        rtol=0.008 if dtype == torch.bfloat16 else 1e-6,","+        atol=1e-7,","+    )","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")","+@pytest.mark.parametrize(\"dtype\", [torch.bfloat16, torch.float32])","+@pytest.mark.parametrize(\"shape\", [(0, 5120), (33, 513)])","+@pytest.mark.parametrize(\"next_\", [False, True])","+@torch.inference_mode()","+def test_norm_residual_norm_preserves_intermediate_rounding(dtype, shape, next_):","+    \"\"\"Both residual and next input must retain BF16 casts between fused stages.\"\"\"","+    from vllm.models.beam.nvidia.layernorm import beam_norm_residual_norm","+","+    torch.manual_seed(42)","+    x = torch.randn(shape[0], shape[1] + 32, device=\"cuda\", dtype=dtype)[","+        :, 1 : shape[1] + 1","+    ]","+    residual = torch.randn_like(x)","+    x[::2].mul_(1e-3)","+    post_weight = torch.randn(shape[1], device=\"cuda\", dtype=dtype)","+    next_weight = torch.randn(shape[1], device=\"cuda\", dtype=dtype) if next_ else None","+    scales = (0.125, 0.9682458365518543)","+    original_x, original_residual = x.clone(), residual.clone()","+    args = (","+        x,","+        residual,","+        post_weight,","+        1e-6,","+        next_weight,","+        1e-6 if next_ else None,","+        scales,","+    )","+    expected = _torch_boundary(*args)","+    actual = beam_norm_residual_norm(*args)","+    _assert_boundary_close(actual, expected)","+    torch.testing.assert_close(x, original_x, rtol=0, atol=0)","+    torch.testing.assert_close(residual, original_residual, rtol=0, atol=0)","+","+","+def _separate_qk_norm_rope(","+    q,","+    k,","+    qw,","+    kw,","+    eps,","+    positions,","+    cache,","+    head_dim,","+    rotary_dim=0,","+    neox=True,","+    ssmax=False,","+):","+    from vllm import _custom_ops as ops","+","+    q = _torch_rms_norm(","+        q.reshape(-1, q.shape[-1] // head_dim, head_dim), qw, eps","+    ).reshape_as(q)","+    k = _torch_rms_norm(","+        k.reshape(-1, k.shape[-1] // head_dim, head_dim), kw, eps","+    ).reshape_as(k)","+    if rotary_dim and q.shape[0]:","+        qf, kf = q.float(), k.float()","+        ops.rotary_embedding(positions, qf, kf, head_dim, cache, neox)","+        q, k = qf.to(q.dtype), kf.to(k.dtype)","+    elif ssmax:","+        scale = (0.1 * torch.log1p((positions.float() + 1) / 2048)).exp()","+        q = (q * scale[:, None]).to(q.dtype)","+    return q, k","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")","+@pytest.mark.parametrize(\"dtype\", [torch.bfloat16, torch.float32])","+@pytest.mark.parametrize(\"rows\", [0, 1, 17, 512, 2049])","+@pytest.mark.parametrize(\"packed\", [False, True])","+@torch.inference_mode()","+def test_output_gate_preserves_activation_dtype_rounding(dtype, rows, packed):","+    from vllm.models.beam.nvidia.attention_ops import beam_output_gate","+","+    torch.manual_seed(42)","+    x = torch.randn(rows, 768, device=\"cuda\", dtype=dtype)","+    gate = torch.randn(rows, 1792 if packed else 768, device=\"cuda\", dtype=dtype) * 8","+    gate = gate[:, -768:]","+    weight = torch.randn(6, device=\"cuda\", dtype=dtype)","+    # Preserve each activation-dtype operation in the parent implementation.","+    g = gate.view(rows, 6, 128) + weight[None, :, None]","+    expected = x * torch.sigmoid(g.reshape_as(gate))","+    actual = beam_output_gate(x, gate, weight, num_heads=6, head_dim=128)","+    torch.testing.assert_close(actual, expected, rtol=2e-6, atol=1e-7)","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA