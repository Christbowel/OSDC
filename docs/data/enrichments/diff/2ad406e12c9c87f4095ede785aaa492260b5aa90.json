val>,","+","+    /// Prefetch workers of the backends created by this handler.","+    prefetches: Vec<super::prefetch::Prefetch>,"," }"," "," impl<","@@ -385,6 +388,7 @@ impl<","             pending_tasks: Default::default(),","             forks: Default::default(),","             flush_cache_interval: None,","+            prefetches: Default::default(),","         }","     }"," ","@@ -546,6 +550,11 @@ impl<","                 // We're emptying all fork backends, this way we ensure all caches get flushed.","                 self.forks.clear();","                 self.handlers.clear();","+                // Reads fail once the handlers are gone, so the workers exit promptly, and the","+                // last of them flushes the cache before the shutdown completes.","+                for prefetch in self.prefetches.drain(..) {","+                    prefetch.stop();","+                }","                 let _ = sender.send(());","             }","             Request::GetForkInfo(fork_id, sender) => {","@@ -628,6 +637,19 @@ impl<","                                 // Only a new backend loads the disk cache.","                                 let (backend, handler) =","                                     create_backend(&opts, &resolved, &evm_env.block_env)?;","+                                // Only a fork of `latest` starts cold on each new head; rolls and","+                                // pinned blocks do not prefetch. Prefetching reads older cache","+                                // files, so it follows the disk caching settings.","+                                let evm_opts = &opts.evm_opts;","+                                if evm_opts.fork_prefetch","+                                    && opts.enable_caching","+                                    && !resolved.state_by_number","+                                    && (evm_opts.fork_block_number.is_none()","+                                        || evm_opts.fork_block_number_is_inferred)","+                                {","+                                    this.prefetches","+                                        .extend(super::prefetch::spawn(&resolved, &backend));","+                                }","                                 this.handlers.push((fork_id.clone(), handler));","                                 (fork_id, CreatedFork::new(opts, resolved, evm_env, backend))","                             };"],"additions":22,"deletions":0,"truncated":false},{"path":"crates/evm/core/src/fork/prefetch.rs","lines":["@@ -0,0 +1,170 @@","+//! Prefetches a new fork block's remote cache from the keys of an older cached block.","+//!","+//! A fork of `latest` gets an empty cache on each new head, and every cold account or storage read","+//! then blocks the EVM for one RPC round trip. Earlier runs on the same chain read mostly the same","+//! accounts and slots, so the keys of the newest older cache file predict the reads. The keys are","+//! read again at the new block through the fork backend, which caches each value like an EVM read,","+//! so the cache stays exact for that block. A wrong prediction only costs an RPC request.","+","+use super::Fork;","+use alloy_network::Network;","+use alloy_primitives::{Address, U256};","+use foundry_config::Config;","+use foundry_fork_db::{","+    ForkBlockEnv, SharedBackend,","+    backend::BlockingMode,","+    cache::{JsonBlockCacheDB, MemDb},","+};","+use parking_lot::Mutex;","+use revm::DatabaseRef;","+use std::{","+    path::{Path, PathBuf},","+    sync::{","+        Arc,","+        atomic::{AtomicBool, Ordering},","+        mpsc,","+    },","+};","+use tracing::subscriber::{NoSubscriber, with_default};","+","+/// Prefetch requests in flight at once. The fork backend sends its own cold reads without a limit;","+/// this bound keeps a large key set from flooding a public endpoint.","+const MAX_CONCURRENT_REQUESTS: usize = 32;","+","+/// Largest number of accounts and slots to prefetch. Older cache files can hold the union of many","+/// runs; past this size, a prefetch can cost more requests than it saves.","+const MAX_KEYS: usize = 4096;","+","+enum Key {","+    Account(Address),","+    Slot(Address, U256),","+}","+","+/// Starts a background prefetch through `backend` if its cache is empty.","+///","+/// Each key is read through the backend like an EVM read, so the backend fetches and caches it with","+/// its own request path, and a key it already has costs no request. Loading the previous cache file","+/// runs in the background too, so it does not block the fork handler.","+pub(crate) fn spawn<N: Network, B: ForkBlockEnv>(","+    fork: &Fork,","+    backend: &SharedBackend<N, B>,","+) -> Option<Prefetch> {","+    if !backend.data().accounts.read().is_empty() {","+        return None;","+    }","+    let runtime = tokio::runtime::Handle::try_current().ok()?;","+    let (chain, number) = (fork.context().source_chain_id, fork.number());","+    let stop = Arc::new(AtomicBool::new(false));","+    let (done_tx, done) = mpsc::channel::<()>();","+    let backend = backend.with_blocking_mode(BlockingMode::Block);","+    let coordinator_stop = Arc::clone(&stop);","+    runtime.clone().spawn_blocking(move || {","+        let stop = coordinator_stop;","+        if let Some(path) =","+            Config::foundry_chain_cache_dir(chain).and_then(|dir| previous_cache_file(&dir, number))","+            && let Ok(previous) = JsonBlockCacheDB::<B>::load(&path)","+            && !stop.load(Ordering::Relaxed)","+        {","+            let keys = keys(previous.db());","+            debug!(target: \"fork::prefetch\", ?path, keys = keys.len(), \"prefetching fork cache\");","+            // Workers take the next key without a lock held during a read.","+            let keys = Arc::new(Mutex::new(keys.into_iter()));","+            for _ in 0..MAX_CONCURRENT_REQUESTS {","+                let (keys, stop, done_tx) = (Arc::clone(&keys), Arc::clone(&stop), done_tx.clone());","+                let backend = backend.clone();","+                runtime.spawn_blocking(move || {","+                    // A failed speculative read is not an error: the backend logs one per failure,","+                    // and every remaining read fails once the run ends, so keep","+                    // these reads quiet.","+                    with_default(NoSubscriber::default(), || {","+                        while !stop.load(Ordering::Relaxed) {","+                            let Some(key) = keys.lock().next() else { break };","+                            let read = match key {","+                                Key::Account(address) => backend.basic_ref(address).map(drop),","+                                Key::Slot(address, slot) => {","+                                    backend.storage_ref(address, slot).map(drop)","+                                }","+                            };","+                            // The EVM fetches any key it still needs, so stop at the first","+                            // failure.","+                            if read.is_err() {","+                                break;","+                            }","+                        }","+                    });","+                    // Drop the backend clone before reporting done, as below.","+                    drop(backend);","+                    drop(done_tx);","+                });","+            }","+        }","+        // The last backend clone flushes the disk cache, so drop it before reporting done.","+        drop(backend);","+        drop(done_tx);","+    });","+    Some(Prefetch { stop, done })","+}","+","+/// Background prefetch workers of one fork backend.","+pub(crate) struct Prefetch {","+    stop: Arc<AtomicBool>,","+    done: mpsc::Receiver<()>,","+}","+","+impl Prefetch {","+    /// Stops the workers and waits until they and their coordinator exit, so whichever holds the","+    /// last backend clone flushes the disk cache before shutdown completes.","+    pub(crate) fn stop(self) {","+        self.stop.store(true, Ordering::Relaxed);","+        // Returns once every worker has dropped its sender.","+        let _ = self.done.recv();","+    }","+}","+","+/// Returns the cache file of the newest block below `number` in a chain cache directory.","+fn previous_cache_file(dir: &Path, number: u64) -> Option<PathBuf> {","+    std::fs::read_dir(dir)","+        .ok()?","+        .filter_map(|entry| {","+            let entry = entry.ok()?;","+            let block = entry.file_name().to_str()?.parse::<u64>().ok()?;","+            (block < number && entry.file_type().ok()?.is_file()).then_some((block, entry.path()))","+        })","+        .max_by_key(|(block, _)| *block)","+        .map(|(_, path)| path)","+}","+","+/// Returns the accounts first, then the slots, up to [`MAX_KEYS`].","+fn keys(db: &MemDb) -> Vec<Key> {","+    let accounts = db.accounts.read();","+    let storage = db.storage.read();","+    accounts","+        .keys()","+        .map(|&address| Key::Account(address))","+        .chain(","+            storage.iter().flat_map(|(&address, slots)| {","+                slots.keys().map(move |&slot| Key::Slot(address, slot))","+            }),","+        )","+        .take(MAX_KEYS)","+        .collect()","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn picks_newest_cache_file_below_block() {","+        let dir = std::env::temp_dir().join(format!(\"foundry-prefetch-{}\", std::process::id()));","+        std::fs::create_dir_all(dir.join(\"120\")).unwrap();","+        for block in [\"90\", \"100\", \"110\", \"130\", \"notes\"] {","+            std::fs::write(dir.join(block), b\"{}\").unwrap();","+        }","+","+        // `120` is a directory, as anvil writes it, and `130` is not below the block.","+        assert_eq!(previous_cache_file(&dir, 125), Some(dir.join(\"110\")));","+        assert_eq!(previous_cache_file(&dir, 90), None);","+        std::fs::remove_dir_all(&dir).unwrap();","+    }","+}"],"additions":170,"deletions":0,"truncated":false},{"path":"crates/evm/core/src/opts.rs","lines":["@@ -101,6 +101,10 @@ pub struct EvmOpts {","     #[serde(default)]","     pub no_fork_bal: bool,"," ","+    /// Prefetches a new fork block's cache from the keys of an older cached block.","+    #[serde(default)]","+    pub fork_prefetch: bool,","+","     /// The initial balance of each deployed test contract.","     pub initial_balance: U256,"," ","@@ -326,6 +330,7 @@ impl Default for EvmOpts {","             no_rpc_rate_limit: false,","             no_storage_caching: false,","             no_fork_bal: false,","+            fork_prefetch: false,","             initial_balance: U256::default(),","             sender: Address::default(),","             ffi: false,"],"additions":5,"deletions":0,"truncated":false},{"path":"crates/forge/src/multi_runner.rs","lines":["@@ -507,6 +507,7 @@ impl<FEN: FoundryEvmNetwork> TestRunnerConfig<FEN> {","         // TODO: `self.evm_opts` and `self.evm_env` are only partially reconfigured.","         self.evm_opts.always_use_create_2_factory = config.always_use_create_2_factory;","         self.evm_opts.no_fork_bal = config.no_fork_bal;","+        self.evm_opts.fork_prefetch = config.fork_prefetch;","         self.evm_opts.fork_state_by_number = config.fork_state_by_number;","         self.config = config;","     }"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/forge/tests/cli/config.rs","lines":["@@ -107,6 +107,7 @@ experimental = false"," ast = false"," no_storage_caching = false"," no_fork_bal = false","+fork_prefetch = false"," no_rpc_rate_limit = false"," use_literal_content = false"," bytecode_hash = \"ipfs\"","@@ -475,6 +476,7 @@ fn can_extract_config_values(prj: _, cmd: _) {","         },","         no_storage_caching: true,","         no_fork_bal: true,","+        fork_prefetch: true,","         no_rpc_rate_limit: true,","         use_literal_content: false,","         bytecode_hash: Default::default(),","@@ -2437,6 +2439,7 @@ fn test_default_config(prj: _, cmd: _) {","   },","   \"no_storage_caching\": false,","   \"no_fork_bal\": false,","+  \"fork_prefetch\": false,","   \"no_rpc_rate_limit\": false,","   \"use_literal_content\": false,","   \"bytecode_hash\": \"ipfs\",",""],"additions":3,"deletions":0,"truncated":false}],"additions":273,"deletions":0,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-22T13:45:26.884713+00:00"}