{"id":"7d1c2338398e6ec424c6bfb392efd1b3e908138b","axis":"silent","repo":"foundry-rs/foundry","sha":"7d1c2338398e6ec424c6bfb392efd1b3e908138b","parsed":{"files":[{"path":".github/scripts/check-tempo-deps.sh","lines":["@@ -0,0 +1,51 @@","+#!/usr/bin/env bash","+set -euo pipefail","+","+# Keeps Foundry's Tempo crates decoupled from mpp-rs and foundry-wallets.","+#","+# Foundry takes tempo-* crates from tempoxyz/tempo by git revision. mpp-rs keeps its own crates.io","+# tempo-* release, and foundry-wallets has no Tempo dependency, so Tempo releases and API changes","+# never have to compile through either crate. This fails if:","+#   - foundry-wallets depends on a tempo-* crate;","+#   - mpp-rs, or a crates.io tempo-* crate it pulls, takes a tempo-* crate from anywhere but","+#     crates.io, for example through a [patch.crates-io] entry that forces tempo-alloy or","+#     tempo-primitives onto Foundry's Tempo revision;","+#   - anything other than mpp-rs, or crates.io tempo-* crates themselves, depends on crates.io","+#     tempo-* crates.","+#","+# Usage:","+#   ./.github/scripts/check-tempo-deps.sh","+","+violations=\"$(","+  cargo metadata --locked --format-version 1 --all-features |","+    jq -r '","+      (.packages | map({key: .id, value: .}) | from_entries) as $pkgs","+      | .resolve.nodes[] as $node","+      | $pkgs[$node.id] as $parent","+      | $node.deps[]","+      | $pkgs[.pkg] as $dep","+      | select($dep.name | startswith(\"tempo-\"))","+      | (($dep.source // \"\") | startswith(\"registry+\")) as $dep_from_registry","+      | (($parent.source // \"\") | startswith(\"registry+\")) as $parent_from_registry","+      | select(","+          $parent.name == \"foundry-wallets\"","+          or ((($parent.name | IN(\"mpp\", \"alloy-transport-mpp\"))","+               or (($parent.name | startswith(\"tempo-\")) and $parent_from_registry))","+              and ($dep_from_registry | not))","+          or ($dep_from_registry","+              and ($parent.name | IN(\"mpp\", \"alloy-transport-mpp\") | not)","+              and (($parent.name | startswith(\"tempo-\")) and $parent_from_registry | not))","+        )","+      | \"\\($parent.name) \\($parent.version) -> \\($dep.name) \\($dep.version) (\\($dep.source // \"path\"))\"","+    ' |","+    sort -u","+)\"","+","+if [[ -n \"$violations\" ]]; then","+  echo \"ERROR: Tempo crates are coupled across mpp-rs or foundry-wallets:\" >&2","+  echo \"$violations\" >&2","+  echo \"Foundry's tempo-* crates must not reach foundry-wallets or replace mpp-rs's crates.io release.\" >&2","+  exit 1","+fi","+","+echo \"Tempo dependencies are decoupled.\""],"additions":51,"deletions":0,"truncated":false},{"path":".github/workflows/ci.yml","lines":["@@ -228,6 +228,25 @@ jobs:","         shell: bash","         run: ./.github/scripts/format.sh --check"," ","+  tempo-deps:","+    runs-on: depot-ubuntu-latest","+    timeout-minutes: 15","+    permissions:","+      contents: read","+    env:","+      # Only reads the dependency graph, so no compiler cache is set up.","+      RUSTC_WRAPPER: \"\"","+    steps:","+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+        with:","+          persist-credentials: false","+      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8","+        with:","+          toolchain: stable","+      - name: Check Tempo dependencies stay decoupled","+        shell: bash","+        run: ./.github/scripts/check-tempo-deps.sh","+","   deny:","     uses: tempoxyz/gh-actions/.github/workflows/rust-deny.yml@2ab28a31ae569be9f780c7675b684471060afa40","     permissions:","@@ -294,6 +313,7 @@ jobs:","       - clippy","       - rustfmt","       - forge-fmt","+      - tempo-deps","       - deny","       - codeql","       - workflow-validation"],"additions":20,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -391,7 +391,7 @@ dependencies = [","  \"alloy-sol-types\",","  \"auto_impl\",","  \"derive_more\",","