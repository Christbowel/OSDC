{"id":"3549ce7488544caf04472f29ae638d68fe239e8e","axis":"silent","repo":"sanity-io/sanity","sha":"3549ce7488544caf04472f29ae638d68fe239e8e","parsed":{"files":[{"path":".github/workflows/bench.yml","lines":["@@ -55,13 +55,40 @@ concurrency:","   cancel-in-progress: ${{ github.event.action != 'labeled' || github.event.label.name == 'trigger:perf-bench' }}"," "," jobs:","+  # bench-listener-stall runs on these paths without the trigger:perf-bench label","+  listener-stall-changes:","+    runs-on: ubuntu-latest","+    timeout-minutes: 5","+    permissions:","+      contents: read","+      pull-requests: read","+    outputs:","+      has_changes: ${{ steps.filter.outputs.listener_stall }}","+    steps:","+      - uses: actions/checkout@v7","+        with:","+          persist-credentials: false","+      - uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4","+        id: filter","+        with:","+          filters: |","+            listener_stall:","+              - 'packages/sanity/src/core/network/**'","+              - 'packages/sanity/src/core/studio/telemetry/**'","+              - 'packages/@repo/debug-proxy/**'","+              - 'perf/bench/**'","+","   build:","-    # The labeled-event guard keeps unrelated label additions from re-running","-    # the whole suite (the label set still gates via contains())","+    needs: [listener-stall-changes]","+    # The labeled-event guards keep unrelated label additions from re-running","+    # the whole suite (the label set still gates via contains()); bench-listener-stall","+    # needs this job's bench-dist-customizations artifact without the label","     if: >-","       (github.event_name == 'pull_request' &&","-       contains(github.event.pull_request.labels.*.name, 'trigger:perf-bench') &&","-       (github.event.action != 'labeled' || github.event.label.name == 'trigger:perf-bench')) ||","+       ((contains(github.event.pull_request.labels.*.name, 'trigger:perf-bench') &&","+         (github.event.action != 'labeled' || github.event.label.name == 'trigger:perf-bench')) ||","+        (needs.listener-stall-changes.outputs.has_changes == 'true' &&","+         github.event.action != 'labeled'))) ||","       github.event_name == 'workflow_dispatch' ||","       github.event_name == 'schedule'","     runs-on: ubuntu-8core","@@ -332,11 +359,14 @@ jobs:","     # The ab_to clause requires build-reference success: on the PR path a","     # broken reference falls back to absolute mode (comparison=skipped, job","     # green), but `prepare-reference --at` fails the job instead — benching","-    # on regardless would produce a comparison-less run wearing an A/B label","+    # on regardless would produce a comparison-less run wearing an A/B label.","+    # On PRs, build-reference carries the label gate; build also runs unlabelled","+    # for bench-listener-stall","     if: >-","       !cancelled() && needs.build.result == 'success' &&","       (inputs.ab_to == '' || needs.build-reference.result == 'success') &&","       ((github.event_name == 'pull_request' &&","+        needs.build-reference.result != 'skipped' &&","         needs.build.outputs.has_code_changes == 'true') ||","        (github.event_name == 'schedule' && github.event.schedule == '0 5 * * *') ||","        (github.event_name == 'workflow_dispatch' && (inputs.run_suite || inputs.ab_to != '')))","@@ -442,11 +472,14 @@ jobs:","     # The ab_to clause requires build-reference success: on the PR path a","     # broken reference falls back to absolute mode (comparison=skipped, job","     # green), but `prepare-reference --at` fails the job instead — benching","-    # on regardless would produce a comparison-less run wearing an A/B label","+    # on regardless would produce a comparison-less run wearing an A/B label.","+    # On PRs, build-reference carries the label gate; build also runs unlabelled","+    # for bench-listener-stall","     if: >-","       !cancelled() && needs.build.result == 'success' &&","       (inputs.ab_to == '' || needs.build-reference.result == 'success') &&","       ((github.event_name == 'pull_request' &&","+        needs.build-reference.result != 'skipped' &&","         needs.build.outputs.has_code_changes == 'true') ||","        (github.event_name == 'schedule' && github.event.schedule == '0 5 * * *') ||","        (github.event_name == 'workflow_dispatch' && (inputs.run_suite || inputs.ab_to != '')))","@@ -562,6 +595,72 @@ jobs:","           overwrite: true","           retention-days: 30"," ","+  bench-listener-stall:","+    needs: [build, listener-stall-changes]","+    if: >-","+      !cancelled() && needs.build.result == 'success' &&","+      ((github.event_name == 'pull_request' &&","+        needs.listener-stall-changes.outputs.has_changes == 'true' &&","+        needs.build.outputs.has_code_changes == 'true') ||","+       (github.event_name == 'schedule' && github.event.schedule == '0 5 * * *') ||","+       (github.event_name == 'workflow_dispatch' && inputs.run_suite &&","+        inputs.ab_to == '' && needs.build.outputs.backfill_sha == ''))","+    runs-on: ubuntu-8core","+    timeout-minutes: 15","+    permissions:","+      contents: read","+    steps:","+      - uses: actions/checkout@v7","+        with:","+          persist-credentials: false","+      - uses: ./.github/actions/setup","+","+      - name: Store Playwright's Version","+        id: playwright-version","+        run: |","+          PLAYWRIGHT_VERSION=$(pnpm exec playwright --version | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1)","+          echo \"version=${PLAYWRIGHT_VERSION}\" >> \"$GITHUB_OUTPUT\"","+","+      - name: Cache Playwright Browsers for Playwright's Version","+        id: cache-playwright-browsers","+        uses: actions/cache@v6","+        with:","+          path: ~/.cache/ms-playwright","+          key: ${{ steps.playwright-version.outputs.version }}-playwright-browsers-all","+","+      - name: Install Playwright Browsers","+        if: steps.cache-playwright-browsers.outputs.cache-hit != 'true'","+        run: pnpm playwright install --with-deps","+","+      # Chromium on Linux validates TLS against the NSS store; the SPKI","+      # allowlist launch flag used locally is not reliably honored here, and","+      # a bypassed-instead-of-valid cert disables the browser HTTP cache","+      # (breaking warm-load measurements) - so import the bench cert properly","+      - name: Trust the bench TLS certificate","+        run: |","+          command -v certutil >/dev/null || sudo apt-get install -y -qq libnss3-tools >/dev/null","+          CERT_PATH=$(pnpm --silent bench cert-path | tail -n 1)","+          mkdir -p \"$HOME/.pki/nssdb\"","+          certutil -d \"sql:$HOME/.pki/nssdb\" -N --empty-password 2>/dev/null || true","+          certutil -d \"sql:$HOME/.pki/nssdb\" -A -t \"CT,,\" -n sanity-bench -i \"$CERT_PATH\"","+","+      - uses: actions/download-artifact@v8","+        with:","+          name: bench-dist-customizations","+          path: perf/bench/dist-customizations","+","+      - name: Run listener stall check","+        run: |","+          set -o pipefail","+          pnpm bench listener-stall 2>&1 | tee \"$RUNNER_TEMP/listener-stall.log\"","+","+      - uses: actions/upload-artifact@v7","+        if: failure()","+        with:","+          name: bench-listener-stall-log","+          path: ${{ runner.temp }}/listener-stall.log","+          retention-days: 30","+","   report:","     needs: [build-reference, bench-interaction, bench-pageload]","     if: >-","@@ -1112,7 +1211,17 @@ jobs:","   # `cancelled` is included because job timeouts conclude as cancelled, not","   # failure (see the report job's note).","   alert-scheduled-failure:","-    needs: [build, bench-interaction, bench-pageload, self-test, track-main, sqrl-score]","+    needs:","+      [","+        listener-stall-changes,","+        build,","+        bench-interaction,","+        bench-pageload,","+        bench-listener-stall,","+        self-test,","+        track-main,","+        sqrl-score,","+      ]","     if: >-","       always() && github.event_name == 'schedule' &&","       (contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') ||"],"additions":116,"deletions":7,"truncated":false},{"path":"perf/bench/README.md","lines":["@@ -71,6 +71,17 @@ Every row is labelled `nav:<step label> / <metric>`, e.g. `nav:document-open / s"," - **The listener is rev-chained**: every mutation event must chain `previousRev → resultRev` from the snapshot's `_rev`; `previousRev` must be _absent_ for `appear`. See `getPairListener.ts` and `utils/sequentializeListenerEvents.ts`. The contract test (`mock-api/__tests__/contract.test.ts`) drives a real `@sanity/client` through all of this."," - Unknown endpoints 404 and are recorded; a session **fails** on unexpected endpoints (mock-drift detector). If your studio change adds an API call, extend the mock in the same PR — like updating types."," ","+### Listener stall checks","+","+`pnpm bench listener-stall` checks the Studio's `Studio Listener Stall Detected` telemetry over one HTTP/2 connection capped at 100 concurrent streams, the API's real cap, so the classifier's budget of 80 applies unchanged. It runs against the customization build (`pnpm --filter bench build:customizations`), which holds the `listenerStall` workspace and its listener tool, and starts the mock with `maxConcurrentStreams: 100`. The checks pass or fail; nothing is reported or stored.","+","+- **too-many-tabs:** desk tabs (`singleString`) open until the listeners outnumber the streams, up to 24 tabs. One event per stalled tab, kind `too-many-tabs`, with `listenersAllTabs` equal to the presence locks' sum and `knownStudioTabs` equal to the open tabs.","+- **this-tab-over-limit** and **second-occurrence:** one listener tool tab opens 105 listeners, closes them, and opens them again. Two events, the second with `stallOccurrence: 2`.","+- **this-tab-heavy:** a desk tab plus a listener tool tab with 95 listeners.","+- **single-default-tab:** one desk tab never sends an event with a listener-limit kind.","+","+Each check group runs in its own browser context. The session answers `/intake/*` in the browser: a stalled tab's telemetry would queue behind the same capped connection. The Studio flushes telemetry 30s after its first buffered event, so a run takes about 3 minutes. Requests the network refused or dropped are listed per check, never retried: on Linux, Node's HTTP/2 server can refuse a queued stream with `ENHANCE_YOUR_CALM` when the client cancels another stream in the same read.","+"," ### Metrics"," "," | Bucket                  | Metrics                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             | Gated?           |","@@ -165,6 +176,10 @@ pnpm bench dev"," # same, serving the customization studio with every customization scenario seeded"," pnpm bench dev --customizations"," ","+# listener stall telemetry over a connection capped at 100 HTTP/2 streams (pass/fail)","+pnpm --filter bench build:customizations","+pnpm bench listener-stall","+"," pnpm bench:unit                                   # mock contract + stats unit tests"," ```"," "],"additions":15,"deletions":0,"truncated":false},{"path":"perf/bench/cli/commands/listenerStall.ts","lines":["@@ -0,0 +1,35 @@","+/**","+ * `bench listener-stall` — Studio tabs over one HTTP/2 connection capped at the API's 100","+ * concurrent streams, asserting on the `Studio Listener Stall Detected` telemetry each stall","+ * fires (runner/session/listenerStall.ts). Pass/fail, not a measurement: nothing is reported or","+ * stored. Runs against the customization build, which holds the listener tool workspace.","+ */","+import path from 'node:path'","+","+import {object} from '@optique/core/constructs'","+import {message} from '@optique/core/message'","+import {withDefault} from '@optique/core/modifiers'","+import {type InferValue} from '@optique/core/parser'","+import {command, constant, option} from '@optique/core/primitives'","+import {string} from '@optique/core/valueparser'","+","+import {BENCH_ROOT} from '../benchRoot'","+","+export const listenerStallCommand = command(","+  'listener-stall',","+  object({","+    action: constant('listener-stall'),","+    dist: withDefault(","+      option('--dist', string({metavar: 'DIR'}), {","+        description: message`Path to the built customization studio (pnpm --filter bench build:customizations)`,","+      }),","+      path.join(BENCH_ROOT, 'dist-customizations'),","+    ),","+    headed: option('--headed', {description: message`Run the browser headed`}),","+  }),","+  {","+    description: message`Check the listener stall telemetry over a connection capped at 100 HTTP/2 streams`,","+  },","+)","+","+export type ListenerStallArgs = InferValue<typeof listenerStallCommand>"],"additions":35,"deletions":0,"truncated":false},{"path":"perf/bench/cli/commands/listenerStallImpl.ts","lines":["@@ -0,0 +1,78 @@","+// oxlint-disable no-console","+/** The `bench listener-stall` implementation — see ./listenerStall.ts for the parser and docs. */","+import path from 'node:path'","+import process from 'node:process'","+","+import chalk from 'chalk'","+","+import {EXPERIMENT} from '../../constants'","+import {getBenchTls} from '../../mock-api/tls'","+import {launchBrowser} from '../../runner/browser'","+import {startSide} from '../../runner/servers'","+import {","+  API_MAX_CONCURRENT_STREAMS,","+  type ListenerStallCheck,","+  type ListenerStallEvent,","+  runListenerStallSession,","+} from '../../runner/session/listenerStall'","+import {resolveFromInvocation} from '../benchRoot'","+import {type ListenerStallArgs} from './listenerStall'","+import {readBuildFlags} from './runImpl'","+","+function describeEvent(event: ListenerStallEvent): string {","+  return (","+    `${event.kind} #${event.stallOccurrence}: ${event.listenersAllTabs} listeners ` +","+    `(${event.listenersThisTab} here + ${event.listenersOtherTabs} in other tabs), ` +","+    `${event.knownStudioTabs} tabs, ${event.stalledListenersThisTab} stalled here, ` +","+    `stalled ${event.stalledForMs}ms, ${event.protocol}, budget ${event.budget}`","+  )","+}","+","+function printCheck(check: ListenerStallCheck): void {","+  const passed = check.failures.length === 0","+  const status = passed ? chalk.green('PASS') : chalk.red('FAIL')","+  console.log(`\\n${status} ${chalk.bold(check.name)} (${(check.durationMs / 1000).toFixed(0)}s)`)","+  check.events.forEach((event) => console.log(`  event ${describeEvent(event)}`))","+  check.failures.forEach((failure) => console.log(chalk.red(`  ${failure}`)))","+  check.notes.forEach((note) => console.log(chalk.dim(`  ${note}`)))","+  if (check.networkFailures.length > 0) {","+    console.log(chalk.yellow(`  ${check.networkFailures.length} refused or dropped requests:`))","+    check.networkFailures","+      .slice(0, 5)","+      .forEach((failure) => console.log(chalk.yellow(`    ${failure}`)))","+  }","+}","+","+export async function runListenerStall(argv: ListenerStallArgs): Promise<void> {","+  const dist = resolveFromInvocation(argv.dist)","+  if (readBuildFlags(dist).customizations === undefined) {","+    console.error(","+      `No customization build at ${dist} — run \\`pnpm --filter bench build:customizations\\` first`,","+    )","+    process.exit(1)","+  }","+","+  const running = await startSide(EXPERIMENT, dist, {","+    maxConcurrentStreams: API_MAX_CONCURRENT_STREAMS,","+  })","+  const browser = await launchBrowser(!argv.headed, (await getBenchTls()).spki)","+  console.log(","+    `listener stall checks against ${path.relative(process.cwd(), dist) || dist}, ` +","+      `mock capped at ${API_MAX_CONCURRENT_STREAMS} concurrent HTTP/2 streams`,","+  )","+","+  try {","+    const checks = await runListenerStallSession({","+      browser,","+      running,","+      log: (line) => console.log(chalk.cyan(line)),","+    })","+    checks.forEach(printCheck)","+    const failed = checks.filter((check) => check.failures.length > 0)","+    console.log(`\\n${checks.length - failed.length}/${checks.length} listener stall checks passed`)","+    if (failed.length > 0) process.exitCode = 1","+  } finally {","+    await browser.close()","+    await running.close()","+  }","+}"],"additions":78,"deletions":0,"truncated":false},{"path":"perf/bench/cli/commands/runImpl.ts","lines":["@@ -121,7 +121,7 @@ function logStyleCensus(sessions: {styles: StyleCensus | null}[]): void {"," }"," "," /** Flags stamped into a dist by its build script (absent = pristine build). */","-function readBuildFlags(dist: string): {customizations?: boolean} {","+export function readBuildFlags(dist: string): {customizations?: boolean} {","   try {","     return JSON.parse(fs.readFileSync(path.join(dist, 'bench-build-flags.json'), 'utf8'))","   } catch {"],"additions":1,"deletions":1,"truncated":false},{"path":"perf/bench/cli/index.ts","lines":["@@ -15,6 +15,7 @@ import {run} from '@optique/run'"," import {resolveFromInvocation} from './benchRoot'"," import {certPathCommand, writeCertificateFile} from './commands/certPath'"," import {devCommand} from './commands/dev'","+import {listenerStallCommand} from './commands/listenerStall'"," import {prepareBackfill, prepareBackfillCommand} from './commands/prepareBackfill'"," import {prepareReference, prepareReferenceCommand} from './commands/prepareReference'"," import {reportCommand} from './commands/report'","@@ -28,6 +29,7 @@ const result = run(","     reportCommand,","     storeCommand,","     devCommand,","+    listenerStallCommand,","     scenariosCommand,","     prepareReferenceCommand,","     prepareBackfillCommand,","@@ -68,6 +70,9 @@ switch (result.action) {","       await import('../runner/devServer')","     ).startBenchDev({customizations: result.customizations})","     break","+  case 'listener-stall':","+    await (await import('./commands/listenerStallImpl')).runListenerStall(result)","+    break","   case 'scenarios':","     listScenarios(result.json)","     break"],"additions":5,"deletions":0,"truncated":false},{"path":"perf/bench/mock-api/createServer.ts","lines":["@@ -23,6 +23,8 @@ export interface MockApiConfig {","   dataset: string","   /** TLS key/cert (PEM). Omit for a plain HTTP/1.1 listener (contract tests, bench:dev). */","   tls?: {key: string | Buffer; cert: string | Buffer}","+  /** Cap concurrent HTTP/2 streams per session, as the real API does at 100. No cap by default. */","+  maxConcurrentStreams?: number"," }"," "," export interface MockApiServer {","@@ -210,7 +212,11 @@ export function createMockApi(config: MockApiConfig): MockApiServer {","       return","     }","     if (path === '/ping' || path.startsWith('/data/ping')) {","-      record('ping', json(req, res, 200, {pong: true}, {'x-sanity-shard': 'bench'}))","+      // As the real API does: the Studio reads its protocol off this request's resource timing","+      record(","+        'ping',","+        json(req, res, 200, {pong: true}, {'x-sanity-shard': 'bench', 'timing-allow-origin': '*'}),","+      )","       return","     }","     if (path === '/intake/telemetry-status') {","@@ -316,7 +322,14 @@ export function createMockApi(config: MockApiConfig): MockApiServer {","     // closed mid-run and every other listener failed with","     // ERR_CONNECTION_CLOSED. The mock only listens on loopback, so the","     // protection is not needed here.","-    http2Options: {streamResetBurst: 1_000_000, streamResetRate: 1_000_000},","+    http2Options: {","+      streamResetBurst: 1_000_000,","+      streamResetRate: 1_000_000,","+      settings:","+        config.maxConcurrentStreams === undefined","+          ? undefined","+          : {maxConcurrentStreams: config.maxConcurrentStreams},","+    },","     routes: [],","     // bifur presence socket: parked unless a soak goes live (see presence.ts)","     upgradeHandler: presence.handleUpgrade,"],"additions":15,"deletions":2,"truncated":false},{"path":"perf/bench/runner/servers.ts","lines":["@@ -15,13 +15,18 @@ export interface RunningSide {","  * instance (perfect state isolation between sides). Both speak HTTP/2+TLS —","  * see mock-api/tls.ts for why h1 is not an option.","  */","-export async function startSide(side: BenchSide, distDir: string): Promise<RunningSide> {","+export async function startSide(","+  side: BenchSide,","+  distDir: string,","+  options: {maxConcurrentStreams?: number} = {},","+): Promise<RunningSide> {","   const tls = await getBenchTls()","   const mock = createMockApi({","     port: side.apiPort,","     projectId: side.projectId,","     dataset: DATASET,","     tls,","+    maxConcurrentStreams: options.maxConcurrentStreams,","   })","   try {","     await mock.listen()"],"additions":6,"deletions":1,"truncated":false},{"path":"perf/bench/runner/session/listenerStall.ts","lines":["@@ -0,0 +1,580 @@","+import {setTimeout as delay} from 'node:timers/promises'","+","+import {type Browser, type Page} from 'playwright'","+","+import {getScenario} from '../../scenarios'","+import {scenarioFixture} from '../../scenarios/types'","+import {attachPage, createSessionContext, type SessionContext} from '../browser'","+import {type RunningSide} from '../servers'","+import {DEFAULT_READY_SELECTOR, scenarioUrl} from './navigation'","+","+/**","+ * Listener stall session: drives real Studio tabs over one HTTP/2 connection capped at the API's","+ * 100 concurrent streams and asserts on the `Studio Listener Stall Detected` telemetry event each","+ * stall fires. The Studio's detector, ledger and classifier do all the work; the session only","+ * opens tabs and listeners and reads the events the tabs send.","+ */","+","+/** The real API's per-connection stream cap, so the classifier's budget of 80 applies unchanged. */","+export const API_MAX_CONCURRENT_STREAMS = 100","+","+const STALL_EVENT_NAME = 'Studio Listener Stall Detected'","+const LISTENER_LIMIT_KINDS = ['too-many-tabs', 'this-tab-heavy', 'this-tab-over-limit']","+const EXPECTED_BUDGET = 80","+const STALL_TRIGGER_MS = 10_000","+const TAB_LOCK_PREFIX = 'sanity-listener-tab:'","+const STALLED_LOCK_SUFFIX = 's'","+","+const POLL_INTERVAL_MS = 500","+const READY_TIMEOUT_MS = 30_000","+const STALL_FLAG_TIMEOUT_MS = STALL_TRIGGER_MS + 20_000","+// The Studio's telemetry store flushes 30s after the first event it buffers","+const EVENT_TIMEOUT_MS = 50_000","+const MAX_DESK_TABS = 24","+const OVER_LIMIT_LISTENERS = 105","+const HEAVY_TAB_LISTENERS = 95","+","+const DESK_SCENARIO = getScenario('singleString')","+const LISTENER_TOOL_PATH = 'listenerStall/listeners'","+","+/** The `Studio Listener Stall Detected` fields the session asserts on. */","+export interface ListenerStallEvent {","+  kind: string","+  listenersAllTabs: number","+  listenersThisTab: number","+  listenersOtherTabs: number","+  knownStudioTabs: number","+  unknownStudioTabs: number","+  stalledListenersThisTab: number","+  stalledOtherTabs: number","+  isBootStall: boolean","+  stallOccurrence: number","+  stalledForMs: number","+  protocol: string","+  budget: number","+}","+","+export type ListenerStallCheckName =","+  | 'too-many-tabs'","+  | 'second-occurrence'","+  | 'single-default-tab'","+  | 'this-tab-over-limit'","+  | 'this-tab-heavy'","+","+export interface ListenerStallCheck {","+  name: ListenerStallCheckName","+  failures: string[]","+  events: ListenerStallEvent[]","+  /** Requests the network refused or dropped (not client aborts), e.g. ENHANCE_YOUR_CALM. */","+  networkFailures: string[]","+  notes: string[]","+  durationMs: number","+}","+","+interface CapturedEvent {","+  page: Page","+  event: ListenerStallEvent","+}","+","+interface TabLock {","+  tabId: string","+  count: number","+  isStalled: boolean","+}","+","+interface StallHarness {","+  running: RunningSide","+  session: SessionContext","+  pages: Page[]","+  stallEvents: CapturedEvent[]","+  /** When each page sent a Studio telemetry batch, stall event or not. */","+  studioBatchTimes: Map<Page, number[]>","+  networkFailures: string[]","+  notes: string[]","+}","+","+interface CheckOutcome {","+  name: ListenerStallCheckName","+  failures: string[]","+  events: ListenerStallEvent[]","+}","+","+interface TelemetryBatchBody {","+  batch?: {name?: string; data?: unknown}[]","+}","+","+const STUDIO_BATCH_TAG = 'sanity.studio'","+const CLIENT_SIDE_FAILURES = ['net::ERR_ABORTED', 'net::ERR_BLOCKED_BY_CLIENT']","+","+async function openHarness(browser: Browser, running: RunningSide): Promise<StallHarness> {","+  running.mock.store.reset()","+  running.mock.ledger.reset()","+  running.mock.store.seed(scenarioFixture(DESK_SCENARIO))","+","+  const session = await createSessionContext(browser, running.side, running.studioUrl)","+  const harness: StallHarness = {","+    running,","+    session,","+    pages: [],","+    stallEvents: [],","+    studioBatchTimes: new Map(),","+    networkFailures: [],","+    notes: [],","+  }","+","+  session.context.on('requestfailed', (request) => {","+    const errorText = request.failure()?.errorText ?? 'unknown'","+    if (CLIENT_SIDE_FAILURES.some((failure) => errorText.startsWith(failure))) return","+    harness.networkFailures.push(`${errorText} ${request.method()} ${request.url()}`)","+  })","+","+  // Answered in the browser: a stalled tab's telemetry requests would queue behind the capped connection","+  await session.context.route(","+    new RegExp(`^https://([^/]+\\\\.)?localhost:${running.side.apiPort}/v[^/]+/intake/`),","+    (route) => {","+      c