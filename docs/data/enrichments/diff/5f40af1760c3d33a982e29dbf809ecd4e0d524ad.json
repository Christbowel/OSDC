{"id":"5f40af1760c3d33a982e29dbf809ecd4e0d524ad","axis":"silent","repo":"elsa-workflows/elsa-core","sha":"5f40af1760c3d33a982e29dbf809ecd4e0d524ad","parsed":{"files":[{"path":".github/release-pins/consolidated.json","lines":["@@ -0,0 +1,13 @@","+{","+  \"3.10.1\": {","+    \"run_id\": 43236516383,","+    \"artifact_id\": 13955429317,","+    \"source_sha\": \"1a95b12fa70254831114ea517948604fb62d695b\",","+    \"archive_sha256\": \"9c975053b3113b62eec664fcb498a776e7dedcfbbc578a1df391650541955c19\",","+    \"manifest_sha256\": \"c20fc5eee0d579055c1fd045f93cf7ef3b24468ed066c3dc124c9d1192e77d6e\",","+    \"feedz_count\": 231,","+    \"nuget_count\": 230,","+    \"exclude_ids\": [\"Elsa.Platform.Integration\"],","+    \"ancestry_branch\": \"release/3.10.0\"","+  }","+}"],"additions":13,"deletions":0,"truncated":false},{"path":".github/workflows/packages.yml","lines":["@@ -4,7 +4,7 @@ on:","   workflow_dispatch:","     inputs:","       publish_preview_feedz:","-        description: Publish this run's packages to Feedz - branch previews, or a 3.10.x prerelease tag (requires publisher approval). Stable 3.10.x Feedz is owned by publish-consolidated-original-candidate.yml.","+        description: Publish this run's packages to Feedz - branch previews, or a 3.10.x prerelease tag (requires publisher approval). Stable 3.10.x Feedz is owned by promote_candidate_version.","         required: true","         type: boolean","         default: false","@@ -28,6 +28,20 @@ on:","         required: false","         type: string","         default: ''","+      promote_candidate_version:","+        description: Promote the already-built candidate pinned for this version in .github/release-pins/consolidated.json (for example 3.10.1) to Feedz and nuget.org, each behind its environment approval. Main only; no rebuild, no tag. Leave empty for every other run.","+        required: false","+        type: string","+        default: ''","+      promote_target:","+        description: Which publisher a candidate promotion runs, only with promote_candidate_version. all runs Feedz and nuget.org; feedz or nuget runs just that one. Every verification step runs either way. Leave as all for every other run.","+        required: true","+        type: choice","+        options:","+          - all","+          - feedz","+          - nuget","+        default: all","   push:","     branches:","       - 'main'","@@ -69,10 +83,14 @@ jobs:","           PUBLISH_NPM: ${{ inputs.publish_npm }}","           DEPLOY_COVERAGE: ${{ inputs.deploy_coverage }}","           EXCLUDE_IDS: ${{ inputs.exclude_ids }}","+          PROMOTE_CANDIDATE_VERSION: ${{ inputs.promote_candidate_version }}","+          PROMOTE_TARGET: ${{ inputs.promote_target }}","         run: python3 scripts/validate_packages_publication_selection.py"," ","   test_unit_integration:","     name: Test unit/integration with coverage","+    # A candidate promotion installs pinned, already-tested bytes: nothing is built or tested.","+    if: ${{ inputs.promote_candidate_version == '' }}","     runs-on: ubuntu-latest","     timeout-minutes: 30","     steps:","@@ -173,6 +191,8 @@ jobs:"," ","   test_component:","     name: Test component with coverage","+    # A candidate promotion installs pinned, already-tested bytes: nothing is built or tested.","+    if: ${{ inputs.promote_candidate_version == '' }}","     runs-on: ubuntu-latest","     timeout-minutes: 30","     steps:","@@ -664,3 +684,204 @@ jobs:","       - name: Deploy to GitHub Pages","         id: deployment","         uses: actions/deploy-pages@v4","+","+  # --- Candidate promotion (promote_candidate_version) ---------------------------------------------------","+  # Installs an already-built, unpublished candidate pinned in .github/release-pins/consolidated.json to Feedz","+  # and nuget.org. The same steps run for every version: adding a version is one reviewed pin entry. Nothing is","+  # rebuilt and no tag is created (Release pushes the tag manually after the uploads succeed). Guards live in","+  # scripts/verify_consolidated_candidate.py and are tested in scripts/test_consolidated_candidate.py.","+  validate_candidate_pin:","+    name: Validate the candidate pin","+    needs: validate_publication_selection","+    if: ${{ github.event_name == 'workflow_dispatch' && inputs.promote_candidate_version != '' }}","+    runs-on: ubuntu-latest","+    timeout-minutes: 10","+    permissions:","+      contents: read","+    steps:","+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","+        with:","+          sparse-checkout: |","+            scripts","+            .github/release-pins","+          persist-credentials: false","+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","+        with:","+          python-version: '3.12'","+      - name: Fail before any download on an unknown version or a missing or malformed pin field","+        env:","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: python3 scripts/verify_consolidated_candidate.py validate-pin --version \"$VERSION\"","+","+  retrieve_candidate:","+    name: Retrieve and verify the pinned candidate","+    needs: validate_candidate_pin","+    # No publisher secret or environment here; only the read-only token used to fetch the artifact.","+    runs-on: ubuntu-latest","+    timeout-minutes: 30","+    permissions:","+      actions: read","+      contents: read","+    steps:","+      - name: Require the reviewed repository and ref","+        run: |","+          set -euo pipefail","+          test \"$GITHUB_REPOSITORY\" = 'elsa-workflows/elsa-core'","+          test \"$GITHUB_REF\" = 'refs/heads/main'","+          test \"$GITHUB_REF_TYPE\" = 'branch'","+          test \"$GITHUB_RUN_ATTEMPT\" = '1'","+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","+        with:","+          sparse-checkout: |","+            scripts","+            .github/release-pins","+          persist-credentials: false","+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","+        with:","+          python-version: '3.12'","+      - name: Check the verifier before trusting it","+        run: python3 -B -m unittest scripts.test_consolidated_candidate","+      - name: Fetch run, artifact and ancestry metadata and the artifact; verify run, artifact, source, ancestry and hashes","+        env:","+          GH_TOKEN: ${{ github.token }}","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: python3 scripts/verify_consolidated_candidate.py retrieve --version \"$VERSION\" --output \"$RUNNER_TEMP/transport\"","+      - name: Transfer the verified bytes to the publish jobs","+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2","+        with:","+          name: consolidated-candidate-transport","+          path: ${{ runner.temp }}/transport","+          if-no-files-found: error","+          overwrite: false","+          retention-days: 7","+","+  publish_candidate_feedz:","+    name: Publish the pinned candidate to Feedz","+    needs: retrieve_candidate","+    # Keys on the target only, never on a version. Retrieval and every verification above it always run.","+    if: ${{ inputs.promote_target == 'all' || inputs.promote_target == 'feedz' }}","+    environment: feedz-publish","+    # One feedz promotion per version at a time; a second dispatch waits instead of racing.","+    concurrency:","+      group: promote-candidate-feedz-${{ inputs.promote_candidate_version }}","+      cancel-in-progress: false","+    runs-on: ubuntu-latest","+    # Keep the job timeout above the push action's deadline (see push-nuget-packages).","+    timeout-minutes: 30","+    permissions:","+      contents: read","+    steps:","+      - name: Require the reviewed repository and ref","+        run: |","+          set -euo pipefail","+          test \"$GITHUB_REPOSITORY\" = 'elsa-workflows/elsa-core'","+          test \"$GITHUB_REF\" = 'refs/heads/main'","+          test \"$GITHUB_REF_TYPE\" = 'branch'","+          test \"$GITHUB_RUN_ATTEMPT\" = '1'","+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","+        with:","+          sparse-checkout: |","+            .github/actions","+            .github/release-pins","+            scripts","+          persist-credentials: false","+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","+        with:","+          python-version: '3.12'","+      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0","+        with:","+          name: consolidated-candidate-transport","+          path: ${{ runner.temp }}/transport","+      - name: Re-verify the pin (run, artifact, source, ancestry, archive, manifest and per-package seal hashes) and stage the sealed packages","+        # Blank every GitHub token name, as the verifier refuses to run with one set.","+        env:","+          GITHUB_TOKEN: ''","+          GH_TOKEN: ''","+          ACTIONS_READ_TOKEN: ''","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: python3 scripts/verify_consolidated_candidate.py verify --version \"$VERSION\" --transport \"$RUNNER_TEMP/transport\" --stage \"$GITHUB_WORKSPACE\"","+      - name: Guard the full ID set before Feedz","+        env:","+          PACKAGES_DIR: ${{ github.workspace }}","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: |","+          set -euo pipefail","+          python3 scripts/validate_packages_id_set.py","+          python3 scripts/verify_consolidated_candidate.py count --version \"$VERSION\" --feed feedz --dir \"$PACKAGES_DIR\"","+      - name: Publish the candidate to feedz.io","+        uses: ./.github/actions/push-nuget-packages","+        with:","+          feed-source: ${{ env.feedz_feed_source }}","+          api-key: ${{ secrets.ELSA_CONSOLIDATED_FEEDZ_PUBLISH_KEY }}","+","+  publish_candidate_nuget:","+    name: Publish the pinned candidate to nuget.org","+    # On 'all', nuget.org waits for Feedz and runs only if Feedz succeeded. On 'nuget', Feedz is skipped","+    # and !cancelled() stops that skip from also skipping this job; the pin and retrieval must still succeed.","+    needs: [validate_candidate_pin, retrieve_candidate, publish_candidate_feedz]","+    if: ${{ !cancelled() && needs.validate_candidate_pin.result == 'success' && needs.retrieve_candidate.result == 'success' && (inputs.promote_target == 'all' || inputs.promote_target == 'nuget') && (needs.publish_candidate_feedz.result == 'success' || (inputs.promote_target == 'nuget' && needs.publish_candidate_feedz.result == 'skipped')) }}","+    environment: nuget-org","+    # One nuget promotion per version at a time; a second dispatch waits instead of racing.","+    concurrency:","+      group: promote-candidate-nuget-${{ inputs.promote_candidate_version }}","+      cancel-in-progress: false","+    runs-on: ubuntu-latest","+    timeout-minutes: 30","+    permissions:","+      contents: read","+      id-token: write # Lets this job request the OIDC token that nuget.org exchanges for a temporary API key.","+    steps:","+      - name: Require the reviewed repository and ref","+        run: |","+          set -euo pipefail","+          test \"$GITHUB_REPOSITORY\" = 'elsa-workflows/elsa-core'","+          test \"$GITHUB_REF\" = 'refs/heads/main'","+          test \"$GITHUB_REF_TYPE\" = 'branch'","+          test \"$GITHUB_RUN_ATTEMPT\" = '1'","+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","+        with:","+          sparse-checkout: |","+            .github/actions","+            .github/release-pins","+            scripts","+          persist-credentials: false","+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","+        with:","+          python-version: '3.12'","+      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0","+        with:","+          name: consolidated-candidate-transport","+          path: ${{ runner.temp }}/transport","+      - name: Re-verify the pin (run, artifact, source, ancestry, archive, manifest and per-package seal hashes) and stage the sealed packages","+        env:","+          GITHUB_TOKEN: ''","+          GH_TOKEN: ''","+          ACTIONS_READ_TOKEN: ''","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: python3 scripts/verify_consolidated_candidate.py verify --version \"$VERSION\" --transport \"$RUNNER_TEMP/transport\" --stage \"$GITHUB_WORKSPACE\"","+      - name: Read the pinned exclusions","+        id: pin","+        env:","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: python3 scripts/verify_consolidated_candidate.py pin-output --version \"$VERSION\" --feed nuget >> \"$GITHUB_OUTPUT\"","+      - name: Guard the ID set (pinned exclusions applied) before nuget.org","+        env:","+          PACKAGES_DIR: ${{ github.workspace }}","+          EXCLUDE_IDS: ${{ steps.pin.outputs.exclude_ids }}","+          VERSION: ${{ inputs.promote_candidate_version }}","+        run: |","+          set -euo pipefail","+          python3 scripts/validate_packages_id_set.py","+          python3 scripts/verify_consolidated_candidate.py count --version \"$VERSION\" --feed nuget --dir \"$PACKAGES_DIR\"","+      # Exchanges a GitHub OIDC token for a temporary nuget.org API key. The Trusted Publishing policy on","+      # nuget.org must name this workflow file (packages.yml).","+      - name: NuGet login for the candidate (OIDC)","+        uses: NuGet/login@8d196754b4036150537f80ac539e15c2f1028841 # v1","+        id: nuget_login","+        with:","+          user: ${{ secrets.NUGET_USER }} # nuget.org username (profile name), not an email address.","+      - name: Publish the candidate to nuget.org","+        uses: ./.github/actions/push-nuget-packages","+        with:","+          feed-source: ${{ env.nuget_feed_source }}","+          api-key: ${{ steps.nuget_login.outputs.NUGET_API_KEY }}"],"additions":222,"deletions":1,"truncated":false},{"path":".github/workflows/prepare-consolidated-3.10.1-release-candidate.yml","lines":["@@ -1,231 +0,0 @@","-name: Consolidated 3.10.1 release candidate","-","-on:","-  # Branch or SHA dispatch. No 3.10.1 tag is required. Publication stays","-  # a separate pin/packet/signoff/QA decision after this unpublished artifact exists.","-  workflow_dispatch:","-    inputs:","-      version:","-        description: Candidate package version. Must be 3.10.1. The 3.10.0 producer is a different workflow.","-        required: true","-        type: choice","-        options:","-          - '3.10.1'","-      source_commit:","-        description: Full 40-character SHA to pack. Must match this run's github.sha. Do not use 5cff67228 (the 3.10.0 pin).","-        required: true","-        type: string","-","-permissions: {}","-","-env:","-  # Imports and contract tests must preserve the producer's clean checkout.","-  PYTHONDONTWRITEBYTECODE: '1'","-  CANDIDATE_VERSION: '3.10.1'","-","-jobs:","-  prepare:","-    permissions:","-      contents: read","-      actions: none","-    runs-on: ubuntu-latest","-    timeout-minutes: 180","-    outputs:","-      artifact-id: ${{ steps.candidate.outputs.artifact-id }}","-      archive-digest: ${{ steps.candidate.outputs.artifact-digest }}","-      manifest-digest: ${{ steps.seal.outputs.manifest-digest }}","-    steps:","-      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","-        with:","-          ref: release/3.10.0","-          fetch-depth: 0","-          persist-credentials: false","-      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","-        with:","-          python-version: '3.12'","-      - name: Reject reused 3.10.0 identity and unpinned source","-        env:","-          INPUT_VERSION: ${{ inputs.version }}","-          CANDIDATE_SOURCE: ${{ inputs.source_commit }}","-          RUN_SHA: ${{ github.sha }}","-        run: |","-          set -euo pipefail","-          test \"$INPUT_VERSION\" = \"3.10.1\"","-          test \"$GITHUB_REF\" = \"refs/heads/release/3.10.0\"","-          test \"$CANDIDATE_SOURCE\" = \"$RUN_SHA\"","-          git rev-parse --verify origin/release/3.10.0","-          git merge-base --is-ancestor \"$CANDIDATE_SOURCE\" origin/release/3.10.0","-          git checkout --detach \"$CANDIDATE_SOURCE\"","-          test \"$(git rev-parse HEAD)\" = \"$CANDIDATE_SOURCE\"","-          python3 scripts/integration-program/prepare_consolidated_release_candidate.py \\","-            check-source --version 3.10.1 --source \"$CANDIDATE_SOURCE\"","-      - uses: actions/setup-dotnet@67a3573c9a986a3f9c594539f4ab511d57bb3ce9 # v4.3.1","-        with:","-          dotnet-version: |","-            8.0.x","-            9.0.x","-            10.0.300","-      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0","-        with:","-          node-version: '22'","-      - name: Check candidate contracts before package preparation","-        run: |","-          python3 -m unittest discover -s scripts/integration-program -p 'test_prove_consolidated*.py'","-          python3 -m unittest discover -s scripts/integration-program -p 'test_prepare_consolidated_release_candidate.py'","-          python3 -m unittest discover -s scripts -p 'test_validate_packages_publication_selection.py'","-      - name: Prepare and verify whole 3.10.1 candidate without publication","-        env:","-          CANDIDATE_SOURCE: ${{ github.sha }}","-        run: |","-          set -euo pipefail","-          test \"$(git rev-parse HEAD)\" = \"$CANDIDATE_SOURCE\"","-          python3 scripts/integration-program/prepare_consolidated_release_candidate.py \\","-            --version 3.10.1 --output \"$RUNNER_TEMP/consolidated-candidate\" --remote-sources","-      - name: Guard the 231-ID inventory on 3.10.1 artifacts","-        env:","-          PACKAGES_DIR: ${{ runner.temp }}/consolidated-candidate/artifacts","-        run: |","-          set -euo pipefail","-          python3 scripts/validate_packages_id_set.py","-          python3 scripts/integration-program/prepare_consolidated_release_candidate.py \\","-            check-nupkgs --packages-dir \"$PACKAGES_DIR\" --version 3.10.1","-      - name: Bind pre-upload manifest","-        id: seal","-        run: |","-          set -euo pipefail","-          digest=$(sha256sum \"$RUNNER_TEMP/consolidated-candidate/preupload-manifest.json\" | cut -d ' ' -f 1)","-          echo \"manifest-digest=$digest\" >> \"$GITHUB_OUTPUT\"","-      - name: Retain immutable unpublished candidate for 30 days","-        id: candidate","-        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2","-        with:","-          name: consolidated-candidate-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}","-          path: ${{ runner.temp }}/consolidated-candidate","-          include-hidden-files: true","-          if-no-files-found: error","-          overwrite: false","-          retention-days: 30","-","-  retrieve:","-    needs: prepare","-    permissions:","-      actions: read","-    runs-on: ubuntu-latest","-    timeout-minutes: 20","-    outputs:","-      transport-id: ${{ steps.transport.outputs.artifact-id }}","-      envelope: ${{ steps.envelope.outputs.envelope }}","-    steps:","-      # No checkout: artifact-reading credentials execute only fixed requests","-      # and validation, never repository Python/package/consumer code.","-      - name: Retrieve exact original archive and write separate envelope","-        id: envelope","-        env:","-          GH_TOKEN: ${{ github.token }}","-          ARTIFACT_ID: ${{ needs.prepare.outputs.artifact-id }}","-          ARCHIVE_DIGEST: ${{ needs.prepare.outputs.archive-digest }}","-          MANIFEST_DIGEST: ${{ needs.prepare.outputs.manifest-digest }}","-          SOURCE_SHA: ${{ github.sha }}","-          RUN_ID: ${{ github.run_id }}","-          RUN_ATTEMPT: ${{ github.run_attempt }}","-        run: |","-          set -euo pipefail","-          [[ \"$ARTIFACT_ID\" =~ ^[1-9][0-9]*$ ]]","-          [[ \"$RUN_ID\" =~ ^[1-9][0-9]*$ && \"$RUN_ATTEMPT\" =~ ^[1-9][0-9]*$ ]]","-          [[ \"$SOURCE_SHA\" =~ ^[a-f0-9]{40}$ ]]","-          test \"$SOURCE_SHA\" != \"5cff67228e550b353b3483eb3b37dfdb73a41c74\"","-          test \"$ARTIFACT_ID\" != \"12664519771\"","-          [[ \"$ARCHIVE_DIGEST\" =~ ^[a-f0-9]{64}$ && \"$MANIFEST_DIGEST\" =~ ^[a-f0-9]{64}$ ]]","-          input=\"$RUNNER_TEMP/candidate-input\"","-          mkdir -p \"$input\"","-          gh api \"repos/elsa-workflows/elsa-core/actions/runs/$RUN_ID\" > \"$input/run.json\"","-          jq -e --arg sha \"$SOURCE_SHA\" --argjson attempt \"$RUN_ATTEMPT\" '","-            .head_sha == $sha and .run_attempt == $attempt and","-            (.event == \"workflow_dispatch\") and","-            (.path == \".github/workflows/prepare-consolidated-3.10.1-release-candidate.yml\")","-          ' \"$input/run.json\" > /dev/null","-          gh api \"repos/elsa-workflows/elsa-core/actions/artifacts/$ARTIFACT_ID\" > \"$input/artifact.json\"","-          jq -e --argjson id \"$ARTIFACT_ID\" --arg sha \"$SOURCE_SHA\" --argjson run \"$RUN_ID\" \\","-            --arg name \"consolidated-candidate-$SOURCE_SHA-$RUN_ID-$RUN_ATTEMPT\" --arg digest \"sha256:$ARCHIVE_DIGEST\" '","-              .id == $id and .name == $name and .expired == false and","-              .workflow_run.id == $run and .workflow_run.head_sha == $sha and","-              .digest == $digest and (.expires_at | fromdateiso8601) > now","-          ' \"$input/artifact.json\" > /dev/null","-          gh api \"repos/elsa-workflows/elsa-core/actions/artifacts/$ARTIFACT_ID/zip\" > \"$input/candidate.zip\"","-          printf '%s  %s\\n' \"$ARCHIVE_DIGEST\" \"$input/candidate.zip\" | sha256sum --check --status","-          test \"$(stat --format=%s \"$input/candidate.zip\")\" = \"$(jq -r .size_in_bytes \"$input/artifact.json\")\"","-          jq -c --arg source \"$SOURCE_SHA\" --argjson run \"$RUN_ID\" --argjson attempt \"$RUN_ATTEMPT\" \\","-            --arg manifest \"$MANIFEST_DIGEST\" --arg observed \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" '{schema:1,published:false,version:\"3.10.1\",","-              source_commit:$source,run_id:$run,run_attempt:$attempt,artifact_id:.id,artifact_name:.name,","-              archive_sha256:(.digest | ltrimstr(\"sha256:\")),archive_size:.size_in_bytes,","-              expires_at:.expires_at,retention_days:30,retrieved_at:$observed,preupload_manifest_sha256:$manifest}' \\","-            \"$input/artifact.json\" > \"$input/envelope.json\"","-          echo \"envelope=$(cat \"$input/envelope.json\")\" >> \"$GITHUB_OUTPUT\"","-          {","-            echo 'Unpublished 3.10.1 candidate post-upload envelope (outside original archive)'","-            echo '```json'","-            cat \"$input/envelope.json\"","-            echo '```'","-          } >> \"$GITHUB_STEP_SUMMARY\"","-      - name: Transfer original bytes and independent metadata","-        id: transport","-        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2","-        with:","-          name: candidate-transport-${{ github.run_id }}-${{ github.run_attempt }}","-          path: |","-            ${{ runner.temp }}/candidate-input/candidate.zip","-            ${{ runner.temp }}/candidate-input/artifact.json","-            ${{ runner.temp }}/candidate-input/envelope.json","-          if-no-files-found: error","-          retention-days: 1","-          compression-level: 0","-","-  consumers:","-    needs: retrieve","-    permissions:","-      contents: read","-      actions: none","-    runs-on: ubuntu-latest","-    timeout-minutes: 90","-    steps:","-      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0","-        with:","-          artifact-ids: ${{ needs.retrieve.outputs.transport-id }}","-          merge-multiple: true","-          path: ${{ runner.temp }}/candidate-input","-      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","-        with:","-          ref: ${{ github.sha }}","-          persist-credentials: false","-      - uses: actions/setup-dotnet@67a3573c9a986a3f9c594539f4ab511d57bb3ce9 # v4.3.1","-        with:","-          dotnet-version: |","-            8.0.x","-            9.0.x","-            10.0.300","-      - name: Verify 3.10.1 envelope and original archive before clean consumers","-        env:","-          EXPECTED_ENVELOPE: ${{ needs.retrieve.outputs.envelope }}","-          SOURCE_SHA: ${{ github.sha }}","-          RUN_ID: ${{ github.run_id }}","-          RUN_ATTEMPT: ${{ github.run_attempt }}","-        run: |","-          set -euo pipefail","-          test \"$(cat \"$RUNNER_TEMP/candidate-input/envelope.json\")\" = \"$EXPECTED_ENVELOPE\"","-          python3 scripts/integration-program/prepare_consolidated_release_candidate.py --consume \\","-            --version 3.10.1 \\","-            --archive \"$RUNNER_TEMP/candidate-input/candidate.zip\" \\","-            --metadata \"$RUNNER_TEMP/candidate-input/artifact.json\" \\","-            --envelope \"$RUNNER_TEMP/candidate-input/envelope.json\" \\","-            --source \"$SOURCE_SHA\" --run-id \"$RUN_ID\" --attempt \"$RUN_ATTEMPT\" \\","-            --output \"$RUNNER_TEMP/verified-candidate\"","-      - name: Retain representative consumer evidence separately","-        if: always()","-        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2","-        with:","-          name: candidate-consumers-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}","-          path: |","-            ${{ runner.temp }}/candidate-consumers","-            ${{ runner.temp }}/candidate-consumer-receipt.json","-          if-no-files-found: warn","-          retention-days: 30"],"additions":0,"deletions":231,"truncated":false},{"path":".github/workflows/prepare-consolidated-release-candidate.yml","lines":["@@ -1,9 +1,21 @@"," name: Consolidated release candidate"," "," on:","-  # Repository-write events and trusted workflow review establish authority.","-  # Editable YAML is not an immutable security boundary.","+  # Dispatch from main. The tooling (this workflow's scripts) is main's checkout; the product source is a separate","+  # checkout of source_commit, which must be on the version's release branch (release/<major>.<minor>.0, derived from the version).","+  # No tag is required. The same steps run for every version. Publication stays a separate decision: the unpublished","+  # artifact is pinned in .github/release-pins/consolidated.json and promoted by packages.yml","+  # (promote_candidate_version).","   workflow_dispatch:","+    inputs:","+      version:","+        description: Candidate package version, for example 3.10.1. Its release branch is release/<major>.<minor>.0.","+        required: true","+        type: string","+      source_commit:","+        description: Full 40-character SHA on the version's release branch to pack. Do not use 5cff67228 (the staged 3.10.0 source).","+        required: true","+        type: string"," "," permissions: {}"," ","@@ -12,7 +24,49 @@ env:","   PYTHONDONTWRITEBYTECODE: '1'"," "," jobs:","+  # No checkout here: source_commit is proven to be on the version's release line through the compare API before any job","+  # checks it out. Fails closed on a malformed input, a missing release branch, an API error or a commit off the line.","+  verify_source:","+    permissions:","+      contents: read","+      actions: none","+    runs-on: ubuntu-latest","+    timeout-minutes: 10","+    outputs:","+      # The commit GitHub itself reports as the merge base on the release line (equal to the input once the check passes).","+      verified-revision: ${{ steps.line.outputs.verified-revision }}","+    steps:","+      - name: Require the reviewed repository and main as the tooling ref","+        run: |","+          set -euo pipefail","+          test \"$GITHUB_REPOSITORY\" = 'elsa-workflows/elsa-core'","+          test \"$GITHUB_REF\" = 'refs/heads/main'","+          test \"$GITHUB_REF_TYPE\" = 'branch'","+      - name: Require source_commit to be on the version's release line","+        id: line","+        env:","+          GH_TOKEN: ${{ github.token }}","+          VERSION: ${{ inputs.version }}","+          CANDIDATE_SOURCE: ${{ inputs.source_commit }}","+        run: |","+          set -euo pipefail","+          [[ \"$VERSION\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]","+          IFS=. read -r major minor _ <<< \"$VERSION\"","+          branch=\"release/$major.$minor.0\"","+          [[ \"$CANDIDATE_SOURCE\" =~ ^[a-f0-9]{40}$ ]]","+          test \"$CANDIDATE_SOURCE\" != \"5cff67228e550b353b3483eb3b37dfdb73a41c74\"","+          gh api \"repos/$GITHUB_REPOSITORY/compare/$branch...$CANDIDATE_SOURCE\" > \"$RUNNER_TEMP/compare.json\"","+          jq -e --arg source \"$CANDIDATE_SOURCE\" '","+            (.status == \"behind\" or .status == \"identical\") and","+            .merge_base_commit.sha == $source","+          ' \"$RUNNER_TEMP/compare.json\" > /dev/null","+          proven=\"$(jq -r .merge_base_commit.sha \"$RUNNER_TEMP/compare.json\")\"","+          [[ \"$proven\" =~ ^[a-f0-9]{40}$ ]]","+          test \"$proven\" = \"$CANDIDATE_SOURCE\"","+          echo \"verified-revision=$proven\" >> \"$GITHUB_OUTPUT\"","+","   prepare:","+    needs: verify_source","     permissions:","       contents: read","       actions: none","@@ -23,36 +77,78 @@ jobs:","       archive-digest: ${{ steps.candidate.outputs.artifact-digest }}","       manifest-digest: ${{ steps.seal.outputs.manifest-digest }}","     steps:","+      - name: Require the reviewed repository and main as the tooling ref","+        run: |","+          set -euo pipefail","+          test \"$GITHUB_REPOSITORY\" = 'elsa-workflows/elsa-core'","+          test \"$GITHUB_REF\" = 'refs/heads/main'","+          test \"$GITHUB_REF_TYPE\" = 'branch'","+      # Tooling: the workflow's own ref (main). All scripts below run from ./tooling.","       - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2","         with:","           ref: ${{ github.sha }}","-          fetch-depth: 0","+          path: tooling","           persist-credentials: false","+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","+        with:","+          python-version: '3.12'","       - uses: actions/setup-dotnet@67a3573c9a986a3f9c594539f4ab511d57bb3ce9 # v4.3.1","         with:","           dotnet-version: |","             8.0.x","             9.0.x","             10.0.300","-      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5","-        with:","-          python-version: '3.12'","       - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0","         with:","           node-version: '22'","       - name: Check candidate contracts before package preparation","+        working-directory: tooling","         run: |","           python3 -m unittest discover -s scripts/integration-program -p 'test_prove_consolidated*.py'","           python3 -m unittest discover -s scripts/integration-program -p 'test_prepare_consolidated_release_candidate.py'","           python3 -m unittest discover -s scripts -p 'test_validate_packages_publication_selection.py'","-      - name: Prepare and verify whole stable candidate without publication"],"additions":68,"deletions":7,"truncated":false}],"additions":303,"deletions":239,"truncated":true,"file_count":4},"error":null,"fetched_at":"2026-11-13T17:05:08.199868+00:00"}