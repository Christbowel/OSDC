ht ? node.width / node.height : DEFAULT_EMAIL_ASPECT_RATIO;","     const emailSpacerWidth = Math.round(emailTemplateMaxWidth / 4);","@@ -155,9 +157,9 @@ function emailCardTemplate({node, options, cardClasses}: {node: VideoNodeData, o","                     cellspacing=\"0\"","                     border=\"0\"","                     width=\"100%\"","-                    background=\"${thumbnailSrc}\"","+                    background=\"${escapeHtml(thumbnailSrc)}\"","                     role=\"presentation\"","-                    style=\"background: url('${thumbnailSrc}') left top / cover; mso-hide: all\"","+                    style=\"background: ${cssUrl(thumbnailSrc)} left top / cover; mso-hide: all\"","                 >","                     <tr style=\"mso-hide: all\">","                         <td width=\"25%\" style=\"visibility: hidden; mso-hide: all\">","@@ -174,7 +176,7 @@ function emailCardTemplate({node, options, cardClasses}: {node: VideoNodeData, o"," ","             <!--[if vml]>","             <v:group xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" coordsize=\"${emailTemplateMaxWidth},${emailSpacerHeight}\" coordorigin=\"0,0\" href=\"${postUrl}\" style=\"width:${emailTemplateMaxWidth}px;height:${emailSpacerHeight}px;\">","-                <v:rect fill=\"t\" stroked=\"f\" style=\"position:absolute;width:${emailTemplateMaxWidth};height:${emailSpacerHeight};\"><v:fill src=\"${thumbnailSrc}\" type=\"frame\"/></v:rect>","+                <v:rect fill=\"t\" stroked=\"f\" style=\"position:absolute;width:${emailTemplateMaxWidth};height:${emailSpacerHeight};\"><v:fill src=\"${escapeHtml(thumbnailSrc)}\" type=\"frame\"/></v:rect>","                 <v:oval fill=\"t\" strokecolor=\"white\" strokeweight=\"4px\" style=\"position:absolute;left:${outlookCircleLeft};top:${outlookCircleTop};width:78;height:78\"><v:fill color=\"black\" opacity=\"30%\" /></v:oval>","                 <v:shape coordsize=\"24,32\" path=\"m,l,32,24,16,xe\" fillcolor=\"white\" stroked=\"f\" style=\"position:absolute;left:${outlookPlayLeft};top:${outlookPlayTop};width:30;height:34;\" />","             </v:group>","@@ -190,7 +192,7 @@ function getCardClasses(node: VideoNodeData) {","     const cardClasses = ['kg-card kg-video-card'];"," ","     if (node.cardWidth) {","-        cardClasses.push(`kg-width-${node.cardWidth}`);","+        cardClasses.push(`kg-width-${escapeHtml(node.cardWidth)}`);","     }","     if (node.caption) {","         cardClasses.push(`kg-card-hascaption`);"],"additions":12,"deletions":10,"truncated":false},{"path":"koenig/kg-default-nodes/src/utils/css-url.ts","lines":["@@ -0,0 +1,29 @@","+import {decodeHTMLStrict} from 'entities';","+","+/**","+ * Write a URL as a CSS `url('…')` for a declaration inside a double-quoted HTML attribute.","+ *","+ * The quotes are part of the result so every caller gets the quoted form, where brackets are","+ * ordinary characters and a URL containing them is written unchanged. The characters that","+ * can't appear inside the CSS string are percent-encoded, as a browser encodes most of them","+ * when it requests the URL: quotes, backslash, whitespace and control characters. Then `&`,","+ * `<` and `>` are escaped for the attribute.","+ *","+ * Percent-encoding rather than CSS escapes (`\\'`), because the result is also read by email","+ * clients, which fetch a percent-encoded URL as it stands.","+ */","+export function cssUrl(url: string | null | undefined) {","+    // Entities are decoded first, so a URL stored with them isn't escaped twice (see escapeHtml).","+    // The whitespace a URL parser drops is dropped here too, rather than encoded into the path.","+    const encoded = decodeHTMLStrict(String(url ?? ''))","+        // eslint-disable-next-line no-control-regex","+        .replace(/^[\\u0000- ]+|[\\u0000- ]+$/g, '')","+        .replace(/[\\t\\n\\r]/g, '')","+        // eslint-disable-next-line no-control-regex","+        .replace(/[\"'\\\\\\s\\u0000-\\u001f\\u007f]/g, char => (char === '\\'' ? '%27' : encodeURIComponent(char)))","+        .replace(/&/g, '&amp;')","+        .replace(/</g, '&lt;')","+        .replace(/>/g, '&gt;');","+","+    return `url('${encoded}')`;","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"koenig/kg-default-nodes/src/utils/escape-html.ts","lines":["@@ -7,7 +7,8 @@ import {decodeHTMLStrict} from 'entities';","  * end in a semicolon: legacy ones without one would turn a URL's `&region=` into `®ion=`.","  */"," export function escapeHtml(unsafe: string | null | undefined) {","-    return decodeHTMLStrict(unsafe ?? '')","+    // Stored card data isn't always the type it's declared as, so anything else is written as text","+    return decodeHTMLStrict(String(unsafe ?? ''))","         .replace(/&/g, '&amp;')","         .replace(/</g, '&lt;')","         .replace(/>/g, '&gt;')"],"additions":2,"deletions":1,"truncated":false},{"path":"koenig/kg-default-nodes/test/renderers/audio-renderer.test.ts","lines":["@@ -1,5 +1,5 @@"," import assert from 'node:assert/strict';","-import {assertPrettifiesTo, callRenderer, html} from '../test-utils/index.js';","+import {assertPrettifiesTo, callRenderer, createDocument, html} from '../test-utils/index.js';"," "," describe('renderers/audio-renderer', function () {","     function getTestData(overrides = {}) {","@@ -13,6 +13,10 @@ describe('renderers/audio-renderer', function () {","         };","     }"," ","+    // Values containing characters that are special in HTML","+    const badTitle = 'Q&A <live> \"special\"';","+    const badUrl = 'https://example.org/a\"b>c.mp3?x=1&y=<2>';","+","     function renderForWeb(data: Record<string, unknown>, options?: Record<string, unknown>) {","         return callRenderer('audio', data, options);","     }","@@ -77,6 +81,14 @@ describe('renderers/audio-renderer', function () {","             const result = renderForWeb(getTestData({src: ''}));","             assert.equal(result.html, '');","   