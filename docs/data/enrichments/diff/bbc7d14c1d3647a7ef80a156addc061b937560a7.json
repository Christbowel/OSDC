nullptr);","+\tConnection con(db);","+\tConnection empty_con(db);","+\tauto result = empty_con.Query(\"SELECT 1\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Collection().GetValue(0, 0) == Value::INTEGER(1));","+\tauto base_grammar = CompiledGrammar::Get(*con.context);","+\t// registration alone activates nothing","+\tGrammarExtension::Register(*db.instance, make_shared_ptr<SevenGrammarExtension>(\"seven\"));","+\tresult = con.Query(\"SELECT 1\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Collection().GetValue(0, 0) == Value::INTEGER(1));","+","+\t// one iterator across the global SET: the second statement must parse with the new default,","+\t// the snapshot identity (not only the registry version) invalidates the session cache","+\tParseIterator iterator(*empty_con.context, \"SELECT 1; SELECT 1\", false, nullptr);","+\tREQUIRE(iterator.Peek());","+\tauto first = iterator.GetStatement();","+\tREQUIRE(ParsedSelectConstant(*first) == \"1\");","+\tSetDefaultGrammarExtensions(db, {Value(\"seven\")});","+\tREQUIRE(iterator.Peek());","+\tauto second = iterator.GetStatement();","+\tREQUIRE(ParsedSelectConstant(*second) == \"7\");","+","+\t// every session without an explicit selection parses with the default, existing or new","+\tRequireSeven(con);","+\tRequireSeven(empty_con);","+\tConnection later(db);","+\tRequireSeven(later);","+\tREQUIRE(CompiledGrammar::Get(*con.context) != base_grammar);","+","+\t// an explicitly empty session selection opts out, RESET returns to the database default","+\tSetActiveGrammarExtensions(con, {});","+\tresult = con.Query(\"SELECT 1\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Collection().GetValue(0, 0) == Value::INTEGER(1));","+\tRequireSeven(later);","+\tREQUIRE_NO_FAIL(*con.Query(\"RESET active_grammar_extensions\"));","+\tRequireSeven(con);","+","+\t// resetting the global deactivates it for every session without an explicit selection","+\tDefaultGrammarExtensionsSetting::ResetGlobal(db.instance.get(), db.instance->config);","+\tresult = con.Query(\"SELECT 1\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Collection().GetValue(0, 0) == Value::INTEGER(1));","+}","+","+class ConstantEightTransformProcess final : public TransformProcess {","+public:","+\texplicit ConstantEightTransformProcess(PEGTransformer &transformer_p) : transformer(transformer_p) {","+\t}","+","+\tTransformStep Resume(arena_ptr<TransformResultValue> child_result) override {","+\t\tD_ASSERT(!child_result);","+\t\treturn TransformStep::Complete(","+\t\t    transformer.MakeResult<unique_ptr<ParsedExpression>>(ConstantExpression::Integer(8)));","+\t}","+","+private:","+\tPEGTransformer &transformer;","+};","+","+static arena_ptr<TransformProcess> StartConstantEightTransform(PEGTransformer &transformer, ParseResult &) {","+\treturn transformer.MakeProcess<ConstantEightTransformProcess>(transformer);","+}","+","+//! Overrides the same rule as SevenGrammarExtension and yields 8","+class OverrideAdditiveExpressionEight final : public GrammarExtension {","+public:","+\texplicit OverrideAdditiveExpressionEight(const string &name)","+\t    : GrammarExtension(name, \"OverrideAdditiveExpressionEight\") {","+\t}","+","+\tvector<GrammarChange> GetChanges() const override {","+\t\tvector<GrammarChange> changes;","+\t\tchanges.push_back(GrammarChange::SetTransformProcess(\"AdditiveExpression\", StartConstantEightTransform, false));","+\t\treturn changes;","+\t}","+};","+","+static void RequireEight(Connection &con) {","+\tauto result = con.Query(\"SELECT 1\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Collection().GetValue(0, 0) == Value::INTEGER(8));","+}","+","+TEST_CASE(\"The session selection replaces the database default\", \"[api][grammar_extension]\") {","+\tDuckDB db(nullptr);","+\tGrammarExtension::Register(*db.instance, make_shared_ptr<SevenGrammarExtension>(\"seven\"));","+\tGrammarExtension::Register(*db.instance, make_shared_ptr<OverrideAdditiveExpressionEight>(\"explicit_eight\"));","+\tSetDefaultGrammarExtensions(db, {Value(\"seven\")});","+\tConnection con(db);","+\tRequireSeven(con);","+\t// a session selection does not compose with the default, it replaces it"],"additions":128,"deletions":0,"truncated":false}],"additions":381,"deletions":61,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-05T16:30:05.140642+00:00"}