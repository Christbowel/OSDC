 new View('/' . $user->getUID() . '/files');","+\t\t$rootInfo = $view->getFileInfo('', 'ext');","+\t\tif (!$rootInfo instanceof FileInfo) {","+\t\t\tthrow new NotFoundException('The root directory of the user\\'s files is missing');","+\t\t}"," \t\t/** @var int|float $used */"," \t\t$used = $rootInfo['size'];"," \t\tif ($used < 0) {"],"additions":21,"deletions":2,"truncated":false},{"path":"tests/lib/Files/QuotaIncludeExternalStorageTest.php","lines":["@@ -0,0 +1,324 @@","+<?php","+","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+declare(strict_types=1);","+","+namespace Test\\Files;","+","+use OC\\Files\\Cache\\FileAccess;","+use OC\\Files\\Config\\MountProviderCollection;","+use OC\\Files\\Filesystem;","+use OC\\Files\\Mount\\HomeMountPoint;","+use OC\\Files\\SetupManager;","+use OC\\Files\\Storage\\Home;","+use OC\\Files\\Storage\\StorageFactory;","+use OC\\Files\\Storage\\Temporary;","+use OC\\Files\\Storage\\Wrapper\\Quota;","+use OC\\Files\\View;","+use OC\\Share20\\ShareDisableChecker;","+use OCP\\App\\IAppManager;","+use OCP\\Diagnostics\\IEventLogger;","+use OCP\\EventDispatcher\\IEventDispatcher;","+use OCP\\Files\\Config\\IUserMountCache;","+use OCP\\Files\\Mount\\IMountManager;","+use OCP\\Files\\NotFoundException;","+use OCP\\Files\\Storage\\IStorageFactory;","+use OCP\\IAppConfig;","+use OCP\\ICache;","+use OCP\\ICacheFactory;","+use OCP\\IConfig;","+use OCP\\ITempManager;","+use OCP\\IUser;","+use OCP\\IUserManager;","+use OCP\\IUserSession;","+use OCP\\Lockdown\\ILockdownManager;","+use OCP\\Server;","+use Psr\\Log\\LoggerInterface;","+use Test\\TestCase;","+use Test\\Traits\\UserTrait;","+","+/**","+ * Tests the usage measured for a quota when `quota_include_external_storage`","+ * is enabled and the files belong to another user than the one of the session.","+ */","+#[\\PHPUnit\\Framework\\Attributes\\Group('DB')]","+class QuotaIncludeExternalStorageTest extends TestCase {","+\tuse UserTrait;","+","+\tprivate IUser $owner;","+\tprivate IUser $otherUser;","+\tprivate mixed $previousIncludeExternalStorage;","+","+\t#[\\Override]","+\tprotected function setUp(): void {","+\t\tparent::setUp();","+","+\t\t$ownerUid = $this->getUniqueID('quota_owner_');","+\t\t$otherUid = $this->getUniqueID('quota_other_');","+\t\t$this->createUser($ownerUid, $ownerUid);","+\t\t$this->createUser($otherUid, $otherUid);","+","+\t\t$userManager = Server::get(IUserManager::class);","+\t\t$this->owner = $userManager->get($ownerUid);","+\t\t$this->otherUser = $userManager->get($otherUid);","+","+\t\t$this->previousIncludeExternalStorage = Server::get(IConfig::class)->getSystemValue('quota_include_external_storage', null);","+","+\t\tFilesystem::tearDown();","+\t\t\\OC_User::setUserId($otherUid);","+\t\tFilesystem::init($otherUid, '/' . $otherUid . '/files');","+","+\t\t// Complete the setup for both users so that the lazy setup triggered","+\t\t// while looking up mounts keeps the mounts installed by the tests.","+\t\t$setupManager = Server::get(SetupManager::class);","+\t\t$setupManager->setupForUser($this->owner);","+\t\t$setupManager->setupForUser($this->otherUser);","+","+\t\t$mountManager = Server::get(IMountManager::class);","+\t\t$mountManager->removeMount('/' . $ownerUid);","+\t\t$mountManager->removeMount('/' . $otherUid);","+\t}","+","+\t#[\\Override]","+\tprotected function tearDown(): void {","+\t\t$config = Server::get(IConfig::class);","+\t\tif ($this->previousIncludeExternalStorage === null) {","+\t\t\t$config->deleteSystemValue('quota_include_external_storage');","+\t\t} else {","+\t\t\t$config->setSystemValue('quota_include_external_storage', $this->previousIncludeExternalStorage);","+\t\t}","+\t\t\\OC_Helper::reset();","+","+\t\tFilesystem::tearDown();","+\t\t\\OC_User::setUserId('');","+","+\t\tparent::tearDown();","+\t}","+","+\t/**","+\t * Mounts a scanned temporary storage holding a single file of $size bytes.","+\t */","+\tprivate function mountStorageWithUsage(string $mountPoint, int $size): Temporary {","+\t\t$storage = new Temporary([]);","+\t\t$storage->file_put_contents('usage.bin', str_repeat('x', $size));","+\t\t$storage->getScanner()->scan('');","+\t\tFilesystem::mount($storage, [], $mountPoint);","+\t\treturn $storage;","+\t}","+","+\tprivate function wrapInQuota(Temporary $storage, int $quota, string $mountPoint): Quota {","+\t\t$wrapped = new Quota([","+\t\t\t'storage' => $storage,","+\t\t\t'quota' => $quota,","+\t\t\t'include_external_storage' => true,","+\t\t\t'user' => $this->owner,","+\t\t]);","+\t\tFilesystem::mount($wrapped, [], $mountPoint);","+\t\treturn $wrapped;","+\t}","+","+\t/**","+\t * Builds a setup manager that registers its storage wrappers in","+\t * $storageFactory with `quota_include_external_storage` enabled.","+\t */","+\tprivate function createSetupManager(IStorageFactory $storageFactory): SetupManager {","+\t\t$config = $this->createMock(IConfig::class);","+\t\t$config->method('getSystemValue')","+\t\t\t->willReturnCallback(fn (string $key, mixed $default = '') => $key === 'quota_include_external_storage' ? true : $default);","+\t\t$config->method('getSystemValueBool')","+\t\t\t->willReturnCallback(fn (string $key, bool $default = false) => $default);","+","+\t\t$cacheFactory = $this->createMock(ICacheFactory::class);","+\t\t$cacheFactory->method('createDistributed')->willReturn($this->createMock(ICache::class));","+","+\t\t$mountManager = $this->createMock(IMountManager::class);","+\t\t$mountManager->method('getAll')->willReturn([]);","+","+\t\t$mountProviderCollection = $this->createMock(MountProviderCollection::class);","+\t\t$mountProviderCollection->method('getRootMounts')->willReturn([]);","+","+\t\treturn new SetupManager(","+\t\t\t$this->createMock(IEventLogger::class),","+\t\t\t$mountProviderCollection,","+\t\t\t$mountManager,","+\t\t\t$this->createMock(IUserManager::class),","+\t\t\t$this->createMock(IEventDispatcher::class),","+\t\t\t$this->createMock(IUserMountCache::class),","+\t\t\t$this->createMock(ILockdownManager::class),","+\t\t\t$this->createMock(IUserSession::class),","+\t\t\t$cacheFactory,","+\t\t\t$this->createMock(LoggerInterface::class),","+\t\t\t$config,","+\t\t\t$this->createMock(ShareDisableChecker::class),","+\t\t\t$this->createMock(IAppManager::class),","+\t\t\t$this->createMock(FileAccess::class),","+\t\t\t$this->createMock(IAppConfig::class),","+\t\t\t$storageFactory,","+\t\t);","+\t}","+","+\t/**","+\t * Writing into a share is accounted against the quota of the share owner,","+\t * so the usage has to be read from the owner's home and not from the home","+\t * of the session user performing the write.","+\t */","+\tpublic function testFreeSpaceMeasuresStorageOwnerAndNotSessionUser(): void {","+\t\t$ownerRoot = '/' . $this->owner->getUID() . '/files';","+\t\t$ownerStorage = $this->mountStorageWithUsage($ownerRoot, 5);","+\t\t$quotaStorage = $this->wrapInQuota($ownerStorage, 100, $ownerRoot);","+","+\t\t$this->mountStorageWithUsage('/' . $this->otherUser->getUID() . '/files', 90);","+","+\t\t$this->assertEquals(95, $quotaStorage->free_space(''));","+\t}","+","+\t/**","+\t * The session user being over the owner's quota must not make the share","+\t * read-only for them.","+\t */","+\tpublic function testFreeSpaceIsNotExhaustedBySessionUserUsage(): void {","+\t\t$ownerRoot = '/' . $this->owner->getUID() . '/files';","+\t\t$ownerStorage = $this->mountStorageWithUsage($ownerRoot, 5);","+\t\t$quotaStorage = $this->wrapInQuota($ownerStorage, 100, $ownerRoot);","+","+\t\t$this->mountStorageWithUsage('/' . $this->otherUser->getUID() . '/files', 150);","+","+\t\t$this->assertEquals(95, $quotaStorage->free_space(''));","+\t}","+","+\t/**","+\t * External storages mounted in the owner's files count towards the owner's","+\t * quota, which is what `quota_include_external_storage` enables.","+\t */","+\tpublic function testFreeSpaceIncludesStorageMountedInOwnerHome(): void {","+\t\t$ownerRoot = '/' . $this->owner->getUID() . '/files';","+\t\t$ownerStorage = $this->mountStorageWithUsage($ownerRoot, 5);","+\t\t$quotaStorage = $this->wrapInQuota($ownerStorage, 100, $ownerRoot);","+","+\t\t$this->mountStorageWithUsage($ownerRoot . '/external', 20);","+","+\t\t$this->assertEquals(75, $quotaStorage->free_space(''));","+\t}","+","+\t/**","+\t * Without a known user the wrapper reads the session's view, the only one it","+\t * can resolve.","+\t */","+\tpublic function testFreeSpaceFallsBackToSessionViewWithoutUser(): void {","+\t\t$otherRoot = '/' . $this->otherUser->getUID() . '/files';","+\t\t$storage = $this->mountStorageWithUsage($otherRoot, 30);","+","+\t\t$quotaStorage = new Quota([","+\t\t\t'storage' => $storage,","+\t\t\t'quota' => 100,","+\t\t\t'include_external_storage' => true,","+\t\t]);","+\t\tFilesystem::mount($quotaStorage, [], $otherRoot);","+","+\t\t$this->assertEquals(70, $quotaStorage->free_space(''));","+\t}","+","+\t/**","+\t * The quota wrapper the setup manager installs on a home mount point has to","+\t * measure the user of that home, which is what makes writes into shares of","+\t * other users use the right usage.","+\t */","+\tpublic function testSetupManagerWrapsHomeWithQuotaOfHomeUser(): void {","+\t\t$ownerUid = $this->owner->getUID();","+\t\t$ownerStorage = $this->mountStorageWithUsage('/' . $ownerUid . '/files', 5);","+\t\t$this->mountStorageWithUsage('/' . $this->otherUser->getUID() . '/files', 90);","+\t\t$this->owner->setQuota('100 B');","+","+\t\t$storageFactory = new StorageFactory();","+\t\t$this->createSetupManager($storageFactory)->setupForUser($this->owner);","+\t\t$wrapped = $storageFactory->wrap(new HomeMountPoint($this->owner, $ownerStorage, '/' . $ownerUid), $ownerStorage);","+","+\t\t$this->assertTrue($wrapped->instanceOfStorage(Quota::class));","+\t\t$this->assertEquals(95, $wrapped->free_space('files'));","+\t}","+","+\t/**","+\t * The storage info of another user's home reports the quota of that user,","+\t * so the usage it reports has to be the one of that user as well.","+\t */","+\tpublic function testStorageInfoOfOtherUsersHomeReportsUsageOfHomeUser(): void {","+\t\t$homeUid = $this->getUniqueID('quota_home_');","+\t\t$homeUser = $this->createMock(IUser::class);","+\t\t$homeUser->method('getUID')->willReturn($homeUid);","+\t\t$homeUser->method('getHome')->willReturn(Server::get(ITempManager::class)->getTemporaryFolder());","+\t\t$homeUser->method('getQuotaBytes')->willReturn(100);","+\t\t$homeUser->method('getDisplayName')->willReturn('Home user');","+","+\t\t$home = new Home(['user' => $homeUser]);","+\t\t$home->mkdir('files');","+\t\t$home->file_put_contents('files/usage.bin', str_repeat('x', 5));","+\t\t$home->getScanner()->scan('');","+\t\tFilesystem::mount($home, [], '/' . $homeUid);","+","+\t\t$this->mountStorageWithUsage('/' . $this->otherUser->getUID() . '/files', 90);","+","+\t\tServer::get(IConfig::class)->setSystemValue('quota_include_external_storage', true);","+\t\t\\OC_Helper::reset();","+","+\t\t$rootInfo = (new View('/' . $homeUid . '/files'))->getFileInfo('');","+\t\t$storageInfo = \\OC_Helper::getStorageInfo('', $rootInfo, true, false);","+","+\t\t$this->assertSame($homeUid, $storageInfo['owner']);","+\t\t$this->assertEquals(5, $storageInfo['used']);","+\t\t$this->assertEquals(95, $storageInfo['free']);","+\t}","+","+\t/**","+\t * When a user's files root is not their home storage, e.g. an external storage","+\t * mounted at `/`, the storage info of that root reports that user's quota and","+\t * usage, not the ones of the session user asking for it.","+\t */","+\tpublic function testStorageInfoOfNonHomeFilesRootReportsQuotaOfItsUser(): void {","+\t\t$ownerUid = $this->owner->getUID();","+\t\t$this->mountStorageWithUsage('/' . $ownerUid . '/files', 5);","+\t\t$this->mountStorageWithUsage('/' . $this->otherUser->getUID() . '/files', 90);","+\t\t$this->owner->setQuota('100 B');","+\t\t$this->otherUser->setQuota('1000 B');","+","+\t\tServer::get(IConfig::class)->setSystemValue('quota_include_external_storage', true);","+\t\t\\OC_Helper::reset();","+","+\t\t$rootInfo = (new View('/' . $ownerUid . '/files'))->getFileInfo('');","+\t\t$storageInfo = \\OC_Helper::getStorageInfo('', $rootInfo, true, false);","+","+\t\t$this->assertSame($ownerUid, $storageInfo['owner']);","+\t\t$this->assertEquals(100, $storageInfo['quota']);","+\t\t$this->assertEquals(5, $storageInfo['used']);","+\t\t$this->assertEquals(95, $storageInfo['free']);","+\t}","+","+\t/**","+\t * A home storage whose user has no files root in the filesystem has no usage","+\t * that could be reported.","+\t */","+\tpublic function testStorageInfoOfHomeWithoutFilesRootThrows(): void {","+\t\t$homeUid = $this->getUniqueID('quota_home_');","+\t\t$homeUser = $this->createMock(IUser::class);","+\t\t$homeUser->method('getUID')->willReturn($homeUid);","+\t\t$homeUser->method('getHome')->willReturn(Server::get(ITempManager::class)->getTemporaryFolder());","+\t\t$homeUser->method('getQuotaBytes')->willReturn(100);","+","+\t\t$home = new Home(['user' => $homeUser]);","+\t\t$home->mkdir('files');","+\t\t$home->getScanner()->scan('');","+\t\t$mountPoint = '/' . $this->getUniqueID('quota_elsewhere_');","+\t\tFilesystem::mount($home, [], $mountPoint);","+","+\t\tServer::get(IConfig::class)->setSystemValue('quota_include_external_storage', true);","+\t\t\\OC_Helper::reset();","+","+\t\t$rootInfo = (new View($mountPoint . '/files'))->getFileInfo('');","+","+\t\t$this->expectException(NotFoundException::class);","+\t\t\\OC_Helper::getStorageInfo('', $rootInfo, true, false);","+\t}","+}",""],"additions":324,"deletions":0,"truncated":false}],"additions":376,"deletions":8,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-05T16:29:27.612124+00:00"}