",","     ],"," )"],"additions":5,"deletions":1,"truncated":false},{"path":"jws/internal/jwsbb/BUILD.bazel","lines":["@@ -2,11 +2,15 @@ load(\"@rules_go//go:def.bzl\", \"go_library\", \"go_test\")"," "," go_library(","     name = \"jwsbb\",","-    srcs = [\"header.go\"],","+    srcs = [","+        \"ecdsacurve.go\",","+        \"header.go\",","+    ],","     importpath = \"github.com/lestrrat-go/jwx/v4/jws/internal/jwsbb\",","     visibility = [\"//jws:__subpackages__\"],","     deps = [","         \"//internal/base64\",","+        \"@com_github_lestrrat_go_dsig//:dsig\",","         \"@com_github_valyala_fastjson//:fastjson\",","     ],"," )","@@ -19,9 +23,13 @@ alias("," "," go_test(","     name = \"jwsbb_test\",","-    srcs = [\"header_test.go\"],","+    srcs = [","+        \"ecdsacurve_test.go\",","+        \"header_test.go\",","+    ],","     deps = [","         \":jwsbb\",","+        \"@com_github_lestrrat_go_dsig//:dsig\",","         \"@com_github_stretchr_testify//require\",","     ],"," )"],"additions":10,"deletions":2,"truncated":false},{"path":"jws/internal/jwsbb/ecdsacurve.go","lines":["@@ -0,0 +1,117 @@","+package jwsbb","+","+import (","+\t\"crypto\"","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"fmt\"","+","+\t\"github.com/lestrrat-go/dsig\"","+)","+","+// This file enforces the RFC 7518 Section 3.4 binding between an ECDSA JWS","+// algorithm and the curve its key must sit on (ES256/P-256, ES384/P-384,","+// ES512/P-521). It is sign-side only, and jws reaches it only when the caller","+// passes jws.WithStrictECDSA(true).","+//","+// The check is opt-in because the old permissive behavior is an interop","+// defect, not a security hole: the signer controls both the key and the","+// algorithm at the call site, and the JWS it produces is a genuine signature","+// under its own key. Turning the check on by default would break working","+// callers to fix a conformance problem they may not have.","+//","+// jws.Verify never reaches this file at all. It infers algorithms from a key","+// when a JWKS entry carries no \"alg\" (see jws/internal/keyalg.Candidates and","+// the deprecated jws.AlgorithmsForKey, whose godoc freezes that inference),","+// and it must stay exactly as permissive as it is today.","+","+// RequireECDSACurve reports whether key sits on the curve RFC 7518 Section","+// 3.4 binds joseAlg to. It returns nil -- never an error -- when the binding","+// cannot be established: dsigAlg is an ECDSA-family algorithm outside the","+// three JOSE built-ins (e.g. ES256K from an extension module), or key","+// carries no readable curve. Only positive evidence of a mismatch is an","+// error.","+func RequireECDSACurve(joseAlg, dsigAlg string, key any) error {","+\twant, ok := curveForDsigAlgorithm(dsigAlg)","+\tif !ok {","+\t\treturn nil","+\t}","+","+\tpub := ecdsaPublicKeyOf(key)","+\tif pub == nil || pub.Curve == nil {","+\t\treturn nil","+\t}","+","+\tif pub.Curve == want {","+\t\treturn nil","+\t}","+\tgotParams := pub.Curve.Params()","+\tif gotParams == nil {","+\t\treturn nil","+\t}","+\twantParams := want.Params()","+\tif wantParams != nil && gotParams.Name == wantParams.Name {","+\t\treturn nil","+\t}","+","+\treturn fmt.Errorf(`ECDSA curve mismatch: key is on %s, algorithm %q requires %s`,","+\t\tcurveName(pub.Curve), joseAlg, curveName(want))","+}","+","+// curveForDsigAlgorithm maps a dsig ECDSA algorithm name to the curve RFC","+// 7518 Section 3.4 requires for it. Only the three JOSE built-ins are","+// known; anything else (custom-curve extensions such as ES256K) misses","+// deliberately, so the caller passes the key through unchecked.","+func curveForDsigAlgorithm(dsigAlg string) (elliptic.Curve, bool) {","+\tswitch dsigAlg {","+\tcase dsig.ECDSAWithP256AndSHA256:","+\t\treturn elliptic.P256(), true","+\tcase dsig.ECDSAWithP384AndSHA384:","+\t\treturn elliptic.P384(), true","+\tcase dsig.ECDSAWithP521AndSHA512:","+\t\treturn elliptic.P521(), true","+\tdefault:","+\t\treturn nil, false","+\t}","+}","+","+// ecdsaPublicKeyOf extracts an *ecdsa.PublicKey from key, or nil when key is","+// not (or does not expose) an ECDSA key. Callers pass an already-converted","+// key (jwk.Key unwrapping happens before this is called), so only the raw Go","+// crypto forms and an opaque crypto.Signer are handled here.","+func ecdsaPublicKeyOf(key any) *ecdsa.PublicKey {","+\tswitch k := key.(type) {","+\tcase *ecdsa.PrivateKey:","+\t\tif k == nil {","+\t\t\treturn nil","+\t\t}","+\t\treturn &k.PublicKey","+\tcase ecdsa.PrivateKey:","+\t\treturn &k.PublicKey","+\tcase *ecdsa.PublicKey:","+\t\treturn k","+\tcase ecdsa.PublicKey:","+\t\treturn &k","+\tcase crypto.Signer:","+\t\tpub, ok := k.Public().(*ecdsa.PublicKey)","+\t\tif !ok {","+\t\t\treturn nil","+\t\t}","+\t\treturn pub","+\tdefault:","+\t\treturn nil","+\t}","+}","+","+// curveName returns crv.Params().Name, guarding a nil Params() the same way","+// the comparison in RequireECDSACurve does.","+func curveName(crv elliptic.Curve) string {","+\tif crv == nil {","+\t\treturn \"<nil>\"","+\t}","+\tparams := crv.Params()","+\tif params == nil {","+\t\treturn \"<unknown>\"","+\t}","+\treturn params.Name","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"jws/internal/jwsbb/ecdsacurve_test.go","lines":["@@ -0,0 +1,184 @@","+package jwsbb_test","+","+import (","+\t\"crypto\"","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"io\"","+\t\"math/big\"","+\t\"testing\"","+","+\t\"github.com/lestrrat-go/dsig\"","+\t\"github.com/stretchr/testify/require\"","+","+\tjwsbb \"github.com/lestrrat-go/jwx/v4/jws/internal/jwsbb\"","+)","+","+// nilParamsCurve is an elliptic.Curve whose Params() returns nil, standing in","+// for a custom curve implementation that does not fill in CurveParams.","+// Stdlib curves never do this; this exercises the documented fail-open","+// contract of RequireECDSACurve for that case.","+type nilParamsCurve struct{}","+","+func (nilParamsCurve) Params() *elliptic.CurveParams { return nil }","+func (nilParamsCurve) IsOnCurve(_, _ *big.Int) bool  { return false }","+func (nilParamsCurve) Add(_, _, _, _ *big.Int) (*big.Int, *big.Int) {","+\treturn nil, nil","+}","+func (nilParamsCurve) Double(_, _ *big.Int) (*big.Int, *big.Int) {","+\treturn nil, nil","+}","+func (nilParamsCurve) ScalarMult(_, _ *big.Int, _ []byte) (*big.Int, *big.Int) {","+\treturn nil, nil","+}","+func (nilParamsCurve) ScalarBaseMult(_ []byte) (*big.Int, *big.Int) {","+\treturn nil, nil","+}","+","+// nonECDSASigner is a crypto.Signer whose Public() does not return an ECDSA","+// public key. RequireECDSACurve must treat it the same as a key with no","+// discoverable curve: nil error, allowed through.","+type nonECDSASigner struct{}","+","+func (nonECDSASigner) Public() crypto.PublicKey                                  { return \"not-a-key\" }","+func (nonECDSASigner) Sign(io.Reader, []byte, crypto.SignerOpts) ([]byte, error) { return nil, nil }","+","+// ecdsaCryptoSigner wraps an *ecdsa.PrivateKey behind crypto.Signer, mirroring","+// the shape an HSM/KMS-backed signer takes.","+type ecdsaCryptoSigner struct {","+\traw *ecdsa.PrivateKey","+}","+","+func (s *ecdsaCryptoSigner) Public() crypto.PublicKey { return &s.raw.PublicKey }","+func (s *ecdsaCryptoSigner) Sign(rand io.Reader, digest []byte, opts crypto.SignerOpts) ([]byte, error) {","+\treturn s.raw.Sign(rand, digest, opts)","+}","+","+func generateECDSAKey(t *testing.T, crv elliptic.Curve) *ecdsa.PrivateKey {","+\tt.Helper()","+\tkey, err := ecdsa.GenerateKey(crv, rand.Reader)","+\trequire.NoError(t, err)","+\treturn key","+}","+","+func TestRequireECDSACurve(t *testing.T) {","+\tt.Parallel()","+","+\tp256Key := generateECDSAKey(t, elliptic.P256())","+\tp384Key := generateECDSAKey(t, elliptic.P384())","+\tp521Key := generateECDSAKey(t, elliptic.P521())","+","+\tt.Run(\"built-in dsig algorithm x curve matrix\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tcurves := []struct {","+\t\t\tname string","+\t\t\tkey  *ecdsa.PrivateKey","+\t\t\tcrv  elliptic.Curve","+\t\t}{","+\t\t\t{\"P-256\", p256Key, elliptic.P256()},","+\t\t\t{\"P-384\", p384Key, elliptic.P384()},","+\t\t\t{\"P-521\", p521Key, elliptic.P521()},","+\t\t}","+\t\tdsigAlgs := []struct {","+\t\t\tjwsAlg  string","+\t\t\tdsigAlg string","+\t\t\twant    elliptic.Curve","+\t\t}{","+\t\t\t{\"ES256\", dsig.ECDSAWithP256AndSHA256, elliptic.P256()},","+\t\t\t{\"ES384\", dsig.ECDSAWithP384AndSHA384, elliptic.P384()},","+\t\t\t{\"ES512\", dsig.ECDSAWithP521AndSHA512, elliptic.P521()},","+\t\t}","+","+\t\tfor _, da := range dsigAlgs {","+\t\t\tfor _, c := range curves {","+\t\t\t\tmatch := c.crv == da.want","+\t\t\t\tname := da.jwsAlg + \"/\" + c.name","+\t\t\t\tt.Run(name, func(t *testing.T) {","+\t\t\t\t\tt.Parallel()","+\t\t\t\t\terr := jwsbb.RequireECDSACurve(da.jwsAlg, da.dsigAlg, c.key)","+\t\t\t\t\tif match {","+\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\treturn","+\t\t\t\t\t}","+\t\t\t\t\trequire.Error(t, err)","+\t\t\t\t\trequire.Contains(t, err.Error(), \"ECDSA curve mismatch\")","+\t\t\t\t})","+\t\t\t}","+\t\t}","+\t})","+","+\tt.Run(\"nil key returns nil error\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, nil)","+\t\trequire.NoError(t, err)","+\t})","+","+\tt.Run(\"key with nil curve returns nil error\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, &ecdsa.PublicKey{})","+\t\trequire.NoError(t, err)","+\t})","+","+\tt.Run(\"unrelated dsig algorithm returns nil error\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\terr := jwsbb.RequireECDSACurve(\"ES256TEST\", \"ECDSA_WITH_TEST_CURVE_AND_SHA256\", p384Key)","+\t\trequire.NoError(t, err)","+\t})","+","+\tt.Run(\"crypto.Signer with non-ECDSA public key returns nil error\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, nonECDSASigner{})","+\t\trequire.NoError(t, err)","+\t})","+","+\tt.Run(\"crypto.Signer wrapping a matching ECDSA key is accepted\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, &ecdsaCryptoSigner{raw: p256Key})","+\t\trequire.NoError(t, err)","+\t})","+","+\tt.Run(\"crypto.Signer wrapping a mismatched ECDSA key is rejected\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, &ecdsaCryptoSigner{raw: p521Key})","+\t\trequire.Error(t, err)","+\t\trequire.Contains(t, err.Error(), \"ECDSA curve mismatch\")","+\t})","+","+\tt.Run(\"value forms of the key are accepted\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\trequire.NoError(t, jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, *p256Key))","+\t\trequire.NoError(t, jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, p256Key.PublicKey))","+\t\trequire.NoError(t, jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, &p256Key.PublicKey))","+\t})","+","+\tt.Run(\"curve built from Params() falls back to name comparison\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\t// A key whose Curve is elliptic.P256().Params() rather than the","+\t\t// elliptic.P256() singleton must still be accepted: pointer identity","+\t\t// fails, but the curve name (\"P-256\") still matches.","+\t\tkey := &ecdsa.PublicKey{","+\t\t\tCurve: elliptic.P256().Params(),","+\t\t\tX:     p256Key.PublicKey.X,","+\t\t\tY:     p256Key.PublicKey.Y,","+\t\t}","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, key)","+\t\trequire.NoError(t, err)","+\t})","+","+\tt.Run(\"key with a curve reporting nil Params returns nil error\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\t// RequireECDSACurve's doc comment promises nil, never an error,","+\t\t// whenever the binding cannot be established. A curve implementation","+\t\t// that returns nil from Params() falls into that case, even though","+\t\t// no stdlib curve does this in practice.","+\t\tkey := &ecdsa.PublicKey{","+\t\t\tCurve: nilParamsCurve{},","+\t\t\tX:     p256Key.PublicKey.X,","+\t\t\tY:     p256Key.PublicKey.Y,","+\t\t}","+\t\terr := jwsbb.RequireECDSACurve(\"ES256\", dsig.ECDSAWithP256AndSHA256, key)","+\t\trequire.NoError(t, err)","+\t})","+}"],"additions":184,"deletions":0,"truncated":false},{"path":"jws/jws_test.go","lines":["@@ -12,6 +12,7 @@ import ("," \t\"crypto/rand\""," \t\"crypto/rsa\""," \t\"crypto/sha256\"","+\t\"crypto/sha512\""," \t\"encoding/asn1\""," \t\"errors\""," \t\"fmt\"","@@ -27,6 +28,8 @@ import ("," \t\"testing\""," \t\"time\""," ","+\t\"github.com/lestrrat-go/dsig\"","+"," \t\"github.com/lestrrat-go/jwx/v4/internal/base64\""," \t\"github.com/lestrrat-go/jwx/v4/internal/json\""," \t\"github.com/lestrrat-go/jwx/v4/internal/jwxtest\"","@@ -62,7 +65,7 @@ func TestSanity(t *testing.T) {"," \t\tkey2, err := jwxtest.GenerateRsaJwk()"," \t\trequire.NoError(t, err, `jwxtest.GenerateRsaJwk should succeed`)"," \t\trequire.NoError(t, key2.Set(jwk.KeyIDKey, \"key2\"), `key2.Set should succeed`)","-\t\tkey3, err := jwxtest.GenerateEcdsaJwk()","+\t\tkey3, err := jwxtest.GenerateEcdsaJwk(jwa.P256())"," \t\trequire.NoError(t, err, `jwxtest.GenerateEcdsaJwk should succeed`)"," \t\trequire.NoError(t, key3.Set(jwk.KeyIDKey, \"key3\"), `key3.Set should succeed`)"," ","@@ -105,7 +108,7 @@ func TestSanity(t *testing.T) {"," \t\t\tkey2, err := jwxtest.GenerateRsaJwk()"," \t\t\trequire.NoError(t, err, `jwxtest.GenerateRsaJwk should succeed`)"," \t\t\trequire.NoError(t, key2.Set(jwk.KeyIDKey, \"key2\"), `key2.Set should succeed`)","-\t\t\tkey3, err := jwxtest.GenerateEcdsaJwk()","+\t\t\tkey3, err := jwxtest.GenerateEcdsaJwk(jwa.P256())"," \t\t\trequire.NoError(t, err, `jwxtest.GenerateEcdsaJwk should succeed`)"," \t\t\trequire.NoError(t, key3.Set(jwk.KeyIDKey, \"key3\"), `key3.Set should succeed`)"," ","@@ -416,18 +419,29 @@ func TestRoundtrip(t *testing.T) {"," \t})"," \tt.Run(\"ECDSA\", func(t *testing.T) {"," \t\tt.Parallel()","-\t\tkey, err := jwxtest.GenerateEcdsaKey(jwa.P521())","-\t\trequire.NoError(t, err, \"ECDSA key generated\")","-\t\tjwkKey, _ := jwk.Import[jwk.Key](key.PublicKey)","-\t\tkeys := map[string]any{","-\t\t\t\"Verify(ecdsa.PublicKey)\":  key.PublicKey,","-\t\t\t\"Verify(*ecdsa.PublicKey)\": &key.PublicKey,","-\t\t\t\"Verify(jwk.Key)\":          jwkKey,","+\t\t// One key per algorithm: RFC 7518 Section 3.4 binds each ES*","+\t\t// algorithm to exactly one curve, so a single key can no longer","+\t\t// be reused across ES256/ES384/ES512.","+\t\talgsAndCurves := []struct {","+\t\t\talg jwa.SignatureAlgorithm","+\t\t\tcrv jwa.EllipticCurveAlgorithm","+\t\t}{","+\t\t\t{jwa.ES256(), jwa.P256()},","+\t\t\t{jwa.ES384(), jwa.P384()},","+\t\t\t{jwa.ES512(), jwa.P521()},"," \t\t}","-\t\tfor _, alg := range []jwa.SignatureAlgorithm{jwa.ES256(), jwa.ES384(), jwa.ES512()} {","-\t\t\tt.Run(alg.String(), func(t *testing.T) {","+\t\tfor _, ac := range algsAndCurves {","+\t\t\tt.Run(ac.alg.String(), func(t *testing.T) {"," \t\t\t\tt.Parallel()","-\t\t\t\ttestRoundtrip(t, payload, alg, key, keys)","+\t\t\t\tkey, err := jwxtest.GenerateEcdsaKey(ac.crv)","+\t\t\t\trequire.NoError(t, err, \"ECDSA key generated\")","+\t\t\t\tjwkKey, _ := jwk.Import[jwk.Key](key.PublicKey)","+\t\t\t\tkeys := map[string]any{","+\t\t\t\t\t\"Verify(ecdsa.PublicKey)\":  key.PublicKey,","+\t\t\t\t\t\"Verify(*ecdsa.PublicKey)\": &key.PublicKey,","+\t\t\t\t\t\"Verify(jwk.Key)\":          jwkKey,","+\t\t\t\t}","+\t\t\t\ttestRoundtrip(t, payload, ac.alg, key, keys)"," \t\t\t})"," \t\t}"," \t})","@@ -1405,7 +1419,7 @@ func TestAlgorithmsForKey(t *testing.T) {"," \trsapubkey, err := rsaprivkey.PublicKey()"," \trequire.NoError(t, err, `jwk (RSA) PublicKey() should succeed`)"," ","-\tecdsaprivkey, err := jwxtest.GenerateEcdsaJwk()","+\tecdsaprivkey, err := jwxtest.GenerateEcdsaJwk(jwa.P256())"," \trequire.NoError(t, err, `jwxtest.GenerateEcdsaPrivateKey should succeed`)"," \tecdsapubkey, err := ecdsaprivkey.PublicKey()"," \trequire.NoError(t, err, `jwk (ECDSA) PublicKey() should succeed`)","@@ -2418,3 +2432,279 @@ func TestVerifyHonorsContextCancellation(t *testing.T) {"," \trequire.ErrorIs(t, err, context.Canceled,"," \t\t`cancellation must propagate as context.Canceled`)"," }","+","+// assertECDSACurveSignOutcome asserts the shared expectation for a","+// jws.Sign call made under jws.WithStrictECDSA(true) with a (curve,","+// algorithm) pair: success when they match RFC 7518 Section 3.4, and an","+// \"ECDSA curve mismatch\" jws.SignError otherwise.","+func assertECDSACurveSignOutcome(t *testing.T, err error, match bool) {","+\tt.Helper()","+\tif match {","+\t\trequire.NoError(t, err)","+\t\treturn","+\t}","+\trequire.Error(t, err)","+\trequire.Contains(t, err.Error(), \"ECDSA curve mismatch\")","+\trequire.True(t, errors.Is(err, jws.SignError()), `errors.Is(err, jws.SignError()) should be true, got %v`, err)","+}","+","+// TestStrictECDSARejectsCurveMismatch covers all six wrong (curve, alg)","+// combinations of P-256/P-384/P-521 x ES256/ES384/ES512 across every sign","+// path that produces an ECDSA JWS signature: jws.Sign with a raw key, with","+// an imported jwk.Key, with the streaming detached-payload path, and with a","+// crypto.Signer wrapper. Every call opts in with jws.WithStrictECDSA(true);","+// the default behavior is covered by TestSignAllowsECDSACurveMismatchByDefault.","+// The three matching pairs must still succeed and round-trip through","+// jws.Verify.","+func TestStrictECDSARejectsCurveMismatch(t *testing.T) {","+\tt.Parallel()","+","+\tpayload := []byte(`Lorem Ipsum Dolor Sit Amet`)","+","+\tcurves := []jwa.EllipticCurveAlgorithm{jwa.P256(), jwa.P384(), jwa.P521()}","+\tkeys := make(map[jwa.EllipticCurveAlgorithm]*ecdsa.PrivateKey, len(curves))","+\tfor _, crv := range curves {","+\t\tkey, err := jwxtest.GenerateEcdsaKey(crv)","+\t\trequire.NoError(t, err, `jwxtest.GenerateEcdsaKey should succeed for %s`, crv)","+\t\tkeys[crv] = key","+\t}","+","+\talgs := []struct {","+\t\talg jwa.SignatureAlgorithm","+\t\tcrv jwa.EllipticCurveAlgorithm","+\t}{","+\t\t{jwa.ES256(), jwa.P256()},","+\t\t{jwa.ES384(), jwa.P384()},","+\t\t{jwa.ES512(), jwa.P521()},","+\t}","+","+\tfor _, a := range algs {","+\t\tfor _, crv := range curves {","+\t\t\tmatch := a.crv == crv","+\t\t\tkey := keys[crv]","+\t\t\tt.Run(fmt.Sprintf(\"%s/%s\", a.alg, crv), func(t *testing.T) {","+\t\t\t\tt.Parallel()","+","+\t\t\t\tt.Run(\"raw *ecdsa.PrivateKey\", func(t *testing.T) {","+\t\t\t\t\tt.Parallel()","+\t\t\t\t\t_, err := jws.Sign(payload, jws.WithKey(a.alg, key), jws.WithStrictECDSA(true))","+\t\t\t\t\tassertECDSACurveSignOutcome(t, err, match)","+\t\t\t\t})","+","+\t\t\t\tt.Run(\"jwk.Key\", func(t *testing.T) {","+\t\t\t\t\tt.Parallel()","+\t\t\t\t\tjwkKey, err := jwk.Import[jwk.Key](key)","+\t\t\t\t\trequire.NoError(t, err, `jwk.Import should succeed`)","+\t\t\t\t\t_, err = jws.Sign(payload, jws.WithKey(a.alg, jwkKey), jws.WithStrictECDSA(true))","+\t\t\t\t\tassertECDSACurveSignOutcome(t, err, match)","+\t\t\t\t})","+","+\t\t\t\tt.Run(\"JSON serialization\", func(t *testing.T) {","+\t\t\t\t\tt.Parallel()","+\t\t\t\t\t_, err := jws.Sign(payload,"],"additions":97,"deletions":13,"truncated":false}],"additions":459,"deletions":30,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-08-27T18:53:59.565338+00:00"}