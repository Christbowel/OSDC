smatch error names only the opt-out fix, not the token help.\"\"\"","+    from ray._private.authentication.authentication_constants import (","+        TOKEN_AUTH_FIX_MESSAGE,","+    )","+","+    assert _AUTH_MODE_MISMATCH in output, output","+    assert TOKEN_AUTH_FIX_MESSAGE not in output, output","+","+","+@pytest.fixture","+def disabled_head_with_token_file():","+    \"\"\"A head with RAY_AUTH_MODE=disabled, and a token file in the default path.\"\"\"","+    from ray._common.network_utils import find_free_port","+    from ray._private.authentication_test_utils import set_default_auth_token","+","+    set_default_auth_token(\"c\" * 64)","+    port = find_free_port()","+    client_server_port = find_free_port()","+    env = os.environ.copy()","+    env.pop(\"RAY_AUTH_TOKEN\", None)","+    env.pop(\"RAY_AUTH_TOKEN_PATH\", None)","+    # Keep the default GCS connect retries (~20s) so a client that retries a","+    # rejection exceeds the 15s timeouts below instead of passing.","+    env.pop(\"RAY_NUM_REDIS_GET_RETRIES\", None)","+    env[\"RAY_AUTH_MODE\"] = \"disabled\"","+    try:","+        _run_ray_start_and_verify_status(","+            [","+                \"--head\",","+                f\"--port={port}\",","+                f\"--ray-client-server-port={client_server_port}\",","+            ],","+            env,","+            expect_success=True,","+        )","+        yield env, f\"127.0.0.1:{port}\", f\"ray://127.0.0.1:{client_server_port}\"","+    finally:","+        _cleanup_ray_start(env)","+","+","+@pytest.mark.skipif(","+    client_test_enabled(),","+    reason=\"Uses subprocess ray start, not compatible with client mode\",","+)","+@pytest.mark.parametrize(\"driver_auth_mode\", [\"disabled\", \"token\"])","+def test_driver_on_auth_disabled_cluster(","+    driver_auth_mode, disabled_head_with_token_file","+):","+    \"\"\"A driver with a token file works on a cluster with RAY_AUTH_MODE=disabled","+    only if it sets RAY_AUTH_MODE=disabled too.\"\"\"","+    env, address, _ = disabled_head_with_token_file","+    driver = (","+        \"import ray\\n\"","+        f\"ray.init(address='{address}')\\n\"","+        \"print(ray.get(ray.remote(lambda: 'driver ok').remote()))\\n\"","+    )","+    result = subprocess.run(","+        [sys.executable, \"-c\", driver],","+        env={**env, \"RAY_AUTH_MODE\": driver_auth_mode},","+        capture_output=True,","+        text=True,","+        # The rejection must not wait out the ~20s of GCS connect retries.","+        timeout=15 if driver_auth_mode == \"token\" else 60,","+    )","+    output = result.stdout + result.stderr","+","+    if driver_auth_mode == \"disabled\":","+        assert result.returncode == 0, output","+        assert \"driver ok\" in output","+    else:","+        assert result.returncode != 0, output","+        _assert_auth_mode_mismatch_only(output)","+","+","+@pytest.mark.skipif(","+    client_test_enabled(),","+    reason=\"Uses subprocess ray start, not compatible with client mode\",","+)","+def test_ray_start_address_in_token_mode_on_auth_disabled_cluster(","+    disabled_head_with_token_file,","+):","+    \"\"\"ray start --address in token mode fails fast with AuthModeMismatch against a","+    head with RAY_AUTH_MODE=disabled.\"\"\"","+    env, address, _ = disabled_head_with_token_file","+    result = subprocess.run(","+        [\"ray\", \"start\", f\"--address={address}\", \"--num-cpus=1\"],","+        env={**env, \"RAY_AUTH_MODE\": \"token\"},","+        capture_output=True,","+        text=True,","+        timeout=15,","+    )","+    assert result.returncode != 0","+    _assert_auth_mode_mismatch_only(result.stdout + result.stderr)","+","+","+@pytest.mark.skipif(","+    client_test_enabled(),","+    reason=\"Uses subprocess ray start, not compatible with client mode\",","+)","+@pytest.mark.parametrize(\"client_auth_mode\", [\"disabled\", \"token\"])","+def test_ray_client_on_auth_disabled_cluster(","+    client_auth_mode, disabled_head_with_to