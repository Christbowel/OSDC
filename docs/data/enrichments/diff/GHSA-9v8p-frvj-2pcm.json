eports whether the named route in the given API package exists and is open.","+func (c APIRoutesConfig) IsRouteEnabled(pkg, name string) bool {","+\treturn c.routeHasFlag(pkg, name, func(r RouteConfig) bool { return r.Open })","+}","+","+// IsRouteSecured reports whether the named route in the given API package exists and is secured.","+func (c APIRoutesConfig) IsRouteSecured(pkg, name string) bool {","+\treturn c.routeHasFlag(pkg, name, func(r RouteConfig) bool { return r.Secured })","+}","+","+func (c APIRoutesConfig) routeHasFlag(pkg, name string, hasFlag func(RouteConfig) bool) bool {","+\tpkgConfig, ok := c.APIPackages[pkg]","+\tif !ok {","+\t\treturn false","+\t}","+","+\tfor _, route := range pkgConfig.Routes {","+\t\tif route.Name == name && hasFlag(route) {","+\t\t\treturn true","+\t\t}","+\t}","+","+\treturn false","+}","+"," // Credential holds an username and a password"," type Credential struct {"," \tUsername string `yaml:\"username\"`"],"additions":25,"deletions":0,"truncated":false},{"path":"config/api_test.go","lines":["@@ -0,0 +1,43 @@","+package config_test","+","+import (","+\t\"testing\"","+","+\t\"github.com/klever-io/klever-go/config\"","+\t\"github.com/stretchr/testify/assert\"","+)","+","+func sampleRoutesConfig() config.APIRoutesConfig {","+\treturn config.APIRoutesConfig{","+\t\tAPIPackages: map[string]config.APIPackageConfig{","+\t\t\t\"log\": {Routes: []config.RouteConfig{{Name: \"/log\", Open: true, Secured: true}}},","+\t\t\t\"node\": {Routes: []config.RouteConfig{","+\t\t\t\t{Name: \"/status\", Open: true, Secured: false},","+\t\t\t\t{Name: \"/metrics\", Open: false, Secured: false},","+\t\t\t}},","+\t\t},","+\t}","+}","+","+func TestAPIRoutesConfig_IsRouteEnabled(t *testing.T) {","+\tt.Parallel()","+\tcfg := sampleRoutesConfig()","+","+\tassert.True(t, cfg.IsRouteEnabled(\"log\", \"/log\"))","+\tassert.True(t, cfg.IsRouteEnabled(\"node\", \"/status\"))","+\tassert.False(t, cfg.IsRouteEnabled(\"node\", \"/metrics\"), \"open:false\")",