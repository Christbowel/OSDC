 `target` with the package files only.","+#[cfg(unix)]","+fn sync_package_files(source: &std::path::Path, target: &std::path::Path) {","+    fs::create_dir_all(target).expect(\"create target\");","+    let patchers =","+        DirPatcher::from_multiple_targets(source, &[target.to_path_buf()], true).expect(\"diff\");","+    for patcher in patchers {","+        patcher.apply().expect(\"apply patch\");","+    }","+}","+","+/// The packlist lists a symlinked directory as one entry. The copy gets the","+/// files under it, and a link inside it may point anywhere in the package.","+#[cfg(unix)]","+#[test]","+fn sync_of_package_files_copies_the_files_under_a_symlinked_directory() {","+    let dir = TempDir::new().expect(\"temp dir\");","+    let (source, target) = (dir.path().join(\"source\"), dir.path().join(\"target\"));","+    create_file(&source.join(\"package.json\"), r#\"{\"name\":\"pkg\",\"version\":\"1.0.0\"}\"#);","+    create_file(&source.join(\"files/foo/bar.txt\"), \"bar\");","+    create_file(&source.join(\"other/sibling.txt\"), \"sibling\");","+    std::os::unix::fs::symlink(\"../../other\", source.join(\"files/foo/other\")).expect(\"symlink\");","+    std::os::unix::fs::symlink(\"files/foo\", source.join(\"link-to-a-dir\")).expect(\"symlink\");","+","+    sync_package_files(&source, &target);","+","+    for (path, content) in","+        [(\"link-to-a-dir/bar.txt\", \"bar\"), (\"link-to-a-dir/other/sibling.txt\", \"sibling\")]","+    {","+        assert_eq!(fs::read_to_string(target.join(path)).expect(\"read synced file\"), content);","+    }","+}","+","+/// Only the listed directories are walked, so a link the packlist leaves out","+/// may point outside the package.","+#[cfg(unix)]","+#[test]","+fn sync_of_package_files_ignores_an_unlisted_link_outside_the_package() {","+    let dir = TempDir::new().expect(\"temp dir\");"],"additions":72,"deletions":6,"truncated":false}],"additions":409,"deletions":143,"truncated":true,"file_count":12},"error":null,"fetche