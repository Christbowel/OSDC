{"id":"335517767f45d5b36c74d3e2ad7e883372d9da5d","axis":"silent","repo":"payloadcms/payload","sha":"335517767f45d5b36c74d3e2ad7e883372d9da5d","parsed":{"files":[{"path":"docs/upload/storage-adapters.mdx","lines":["@@ -525,6 +525,78 @@ export default buildConfig({"," })"," ```"," ","+### Upload receipts#custom-upload-receipts","+","+When the browser uploads directly to your storage provider, the document request only carries an `uploadReference` that says where the file went. Set `uploadInstructions.requiresUploadReceipt` to `true` so that Payload only accepts references it signed. Sign them with `resolveSignedURLKey` from `@payloadcms/plugin-cloud-storage/utilities` and return its `uploadReference` from `generate`:","+","+```ts","+import { resolveSignedURLKey } from '@payloadcms/plugin-cloud-storage/utilities'","+","+const adapter: GeneratedAdapter = {","+  // ...","+  uploadInstructions: {","+    enabled: true,","+    generate: async ({","+      collectionSlug,","+      docPrefix,","+      filename,","+      filesize,","+      mimeType,","+      req,","+    }) => {","+      // Check access before issuing an upload URL.","+      const { sanitizedFilename, storageFilePath, uploadReference } =","+        await resolveSignedURLKey({","+          adapterData: { providerUploadID: 'upload-123' },","+          collectionPrefix: 'media',","+          collectionSlug,","+          docPrefix,","+          filename,","+          req,","+        })","+","+      return {","+        type: 'http',","+        file: {","+          filename: sanitizedFilename,","+          mimeType,","+          size: filesize,","+          uploadReference,","+        },","+        request: {","+          method: 'PUT',","+          url: await createProviderUploadURL(storageFilePath),","+        },","+      }","+    },","+    requiresUploadReceipt: true,","+    useInAdmin: true,","+  },","+}","+```","+","+The receipt binds the upload to the user, collection, filename, and storage key, and expires after six hours. Upload the file to the returned `storageFilePath`; Payload rejects a receipt whose key does not end with `<prefix>/<_objectKey>/<original filename>`.","+","+Payload rebuilds `uploadReference` from the verified receipt before calling your upload handlers. Handlers receive `_objectKey`, `prefix`, `signedReceipt`, and `adapterData`:","+","+- `adapterData` is optional data your adapter needs back after the upload, such as a provider upload ID. Payload signs it into the receipt, so the browser cannot change it. It is not stored on the document.","+","+Some providers return an ID only after the upload finishes. To sign it, call `resignClientUploadReceipt` from an endpoint your adapter's client handler calls after the upload, and send the new receipt with the document. It adds to `adapterData` and keeps every other field, including the user and expiry, so it only works before the receipt expires and, for a logged-in user, only in a request from that user. If your access check allows uploads without a login, anyone who has the receipt can re-sign it, so check ownership in your endpoint if you need it. The first receipt is still valid, so the browser can send it instead. If the field you add is required, reject the upload in your handler when it is missing.","+","+```ts","+import { resignClientUploadReceipt } from '@payloadcms/plugin-cloud-storage/utilities'","+","+// In your upload-complete endpoint, after confirming the object with the provider:","+const signedReceipt = resignClientUploadReceipt({","+  adapterData: { providerObjectID },","+  collectionSlug,","+  req,","+  signedReceipt: uploadReference.signedReceipt,","+})","+```","+","+Client uploads keep an [original and file history](./overview#file-versioning) only when a receipt is verified. Without `requiresUploadReceipt`, Payload passes `uploadReference` to your handlers as the browser sent it, and the upload has no original or file history.","+"," ## Plugin options"," "," This plugin is configurable to work across many different Payload collections. A `*` denotes that the property is required."],"additions":72,"deletions":0,"truncated":false},{"path":"packages/payload/src/exports/internal.ts","lines":["@@ -18,6 +18,7 @@ export { assertClientUploadAccess } from '../uploads/assertClientUploadAccess.js"," export { assertClientUploadAllowed } from '../uploads/assertClientUploadAllowed.js'"," export {","   createClientUploadReceipt,","+  resignClientUploadReceipt,","   verifyClientUploadReceipt,"," } from '../uploads/clientUploadReceipt.js'"," export { downloadFileToBuffer } from '../uploads/downloadFileToBuffer.js'"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/payload/src/uploads/clientUploadReceipt.spec.ts","lines":["@@ -0,0 +1,137 @@","+import type { PayloadRequest } from '../types/index.js'","+","+import crypto from 'node:crypto'","+import { afterEach, describe, expect, it, vi } from 'vitest'","+","+import {","+  createClientUploadReceipt,","+  resignClientUploadReceipt,","+  verifyClientUploadReceipt,","+} from './clientUploadReceipt.js'","+","+const secret = 'test-secret'","+","+const req = {","+  payload: { secret },","+  user: { id: 'user-1', collection: 'users' },","+} as unknown as PayloadRequest","+","+const receiptArgs = {","+  _objectKey: 'upload-1',","+  collectionSlug: 'media',","+  filename: 'photo.jpg',","+  filePrefix: 'media',","+  req,","+  storageFilePath: 'media/upload-1/photo-original.jpg',","+}","+","+// Signs data the same way createClientUploadReceipt does, so a test can sign data it would refuse to build.","+const signReceipt = (data: Record<string, unknown>): string => {","+  const encodedReceipt = Buffer.from(JSON.stringify(data)).toString('base64url')","+  const signature = crypto","+    .createHmac('sha256', `payload-client-upload-receipt-v1:${secret}`)","+    .update(encodedReceipt)","+    .digest('base64url')","+","+  return `${encodedReceipt}.${signature}`","+}","+","+describe('clientUploadReceipt', () => {","+  it('should return signed adapterData from a verified receipt', () => {","+    const signedReceipt = createClientUploadReceipt({","+      ...receiptArgs,","+      adapterData: { providerUploadID: 'provider-1' },","+    })","+","+    const receipt = verifyClientUploadReceipt({ req, signedReceipt })","+","+    expect(receipt.adapterData).toEqual({ providerUploadID: 'provider-1' })","+  })","+","+  it('should reject a receipt whose adapterData is not a plain object', () => {","+    const signedReceipt = signReceipt({","+      _objectKey: 'upload-1',","+      adapterData: ['provider-1'],","+      collectionSlug: 'media',","+      expiresAt: Date.now() + 60_000,","+      filename: 'photo.jpg',","+      filePrefix: 'media',","+      storageFilePath: 'media/upload-1/photo-original.jpg',","+      userCollection: 'users',","+      userID: 'user-1',","+    })","+","+    expect(() => verifyClientUploadReceipt({ req, signedReceipt })).toThrow(","+      'Invalid upload reference.',","+    )","+  })","+","+  describe('resignClientUploadReceipt', () => {","+    afterEach(() => {","+      vi.useRealTimers()","+    })","+","+    it('should add adapterData and keep the other receipt fields', () => {","+      const signedReceipt = createClientUploadReceipt({","+        ...receiptArgs,","+        adapterData: { providerUploadID: 'provider-1' },","+      })","+      const original = verifyClientUploadReceipt({ req, signedReceipt })","+","+      const resigned = resignClientUploadReceipt({","+        adapterData: { providerObjectID: 'object-1' },","+        req,","+        signedReceipt,","+      })","+","+      expect(verifyClientUploadReceipt({ req, signedReceipt: resigned })).toEqual({","+        ...original,","+        adapterData: { providerObjectID: 'object-1', providerUploadID: 'provider-1' },","+      })","+    })","+","+    it('should reject a receipt issued to another user', () => {","+      const otherUserReq = {","+        ...req,","+        user: { id: 'user-2', collection: 'users' },","+      } as unknown as PayloadRequest","+      const signedReceipt = createClientUploadReceipt({ ...receiptArgs, req: otherUserReq })","+","+      expect(() =>","+        resignClientUploadReceipt({","+          adapterData: { providerObjectID: 'object-1' },","+          req,","+          signedReceipt,","+        }),","+      ).toThrow('Invalid upload reference.')","+    })","+","+    it('should reject a receipt for another collection when collectionSlug is passed', () => {","+      const signedReceipt = createClientUploadReceipt(receiptArgs)","+","+      expect(() =>","+        resignClientUploadReceipt({","+          adapterData: { providerObjectID: 'object-1' },","+          collectionSlug: 'documents',","+          req,","+          signedReceipt,","+        }),","+      ).toThrow('Invalid upload reference.')","+    })","+","+    it('should keep the original expiry', () => {","+      vi.useFakeTimers()","+      const signedReceipt = createClientUploadReceipt(receiptArgs)","+      const { expiresAt } = verifyClientUploadReceipt({ req, signedReceipt })","+      vi.advanceTimersByTime(60_000)","+","+      const resigned = resignClientUploadReceipt({","+        adapterData: { providerObjectID: 'object-1' },","+        req,","+        signedReceipt,","+      })","+","+      expect(verifyClientUploadReceipt({ req, signedReceipt: resigned }).expiresAt).toBe(expiresAt)","+    })","+  })","+})"],"additions":137,"deletions":0,"truncated":false},{"path":"packages/payload/src/uploads/clientUploadReceipt.ts","lines":["@@ -6,6 +6,8 @@ import { APIError } from '../errors/APIError.js'"," "," type ClientUploadReceipt = {","   _objectKey?: string","+  /** Signed data the storage adapter needs back after upload, such as a provider upload ID. */","+  adapterData?: Record<string, unknown>","   allowOverwrite?: boolean","   collectionSlug: string","   expiresAt: number","@@ -23,6 +25,7 @@ const DOMAIN = 'payload-client-upload-receipt-v1'"," "," export const createClientUploadReceipt = ({","   _objectKey,","+  adapterData,","   allowOverwrite,","   collectionSlug,","   filename,","@@ -31,6 +34,7 @@ export const createClientUploadReceipt = ({","   storageFilePath,"," }: {","   _objectKey?: string","+  adapterData?: Record<string, unknown>","   allowOverwrite?: boolean","   collectionSlug: string","   filename: string","@@ -40,6 +44,7 @@ export const createClientUploadReceipt = ({"," }): `${string}.${string}` => {","   const data: ClientUploadReceipt = {","     ...(_objectKey !== undefined && { _objectKey }),","+    ...(adapterData !== undefined && { adapterData }),","     ...(allowOverwrite && { allowOverwrite: true }),","     collectionSlug,","     expiresAt: Date.now() + LIFETIME_MS,","@@ -48,9 +53,32 @@ export const createClientUploadReceipt = ({","     storageFilePath,","     ...getUser(req),","   }","-  const encodedReceipt = Buffer.from(JSON.stringify(data)).toString('base64url')"," ","-  return `${encodedReceipt}.${sign({ encodedReceipt, secret: req.payload.secret })}`","+  return encodeReceipt({ data, secret: req.payload.secret })","+}","+","+/**","+ * Signs a copy of a receipt with more `adapterData`, such as a provider ID that exists only after","+ * the upload. Every other field, including the user and expiry, is kept from the original receipt.","+ */","+export const resignClientUploadReceipt = ({","+  adapterData,","+  collectionSlug,","+  req,","+  signedReceipt,","+}: {","+  adapterData: Record<string, unknown>","+  /** Rejects a receipt issued for another collection. */","+  collectionSlug?: string","+  req: PayloadRequest","+  signedReceipt: unknown","+}): `${string}.${string}` => {","+  const receipt = verifyClientUploadReceipt({ collectionSlug, req, signedReceipt })","+","+  return encodeReceipt({","+    data: { ...receipt, adapterData: { ...receipt.adapterData, ...adapterData } },","+    secret: req.payload.secret,","+  })"," }"," "," export const verifyClientUploadReceipt = ({","@@ -105,6 +133,18 @@ const getUser = (req: PayloadRequest) => ({","   userID: req.user?.id ?? null,"," })"," ","+const encodeReceipt = ({","+  data,","+  secret,","+}: {","+  data: ClientUploadReceipt","+  secret: string","+}): `${string}.${string}` => {","+  const encodedReceipt = Buffer.from(JSON.stringify(data)).toString('base64url')","+","+  return `${encodedReceipt}.${sign({ encodedReceipt, secret })}`","+}","+"," const sign = ({ encodedReceipt, secret }: { encodedReceipt: string; secret: string }) =>","   crypto.createHmac('sha256', `${DOMAIN}:${secret}`).update(encodedReceipt).digest('base64url')"," ","@@ -124,6 +164,10 @@ const isReceipt = (value: unknown): value is ClientUploadReceipt => {","   const data = value as Partial<ClientUploadReceipt>","   return (","     (data._objectKey === undefined || typeof data._objectKey === 'string') &&","+    (data.adapterData === undefined ||","+      (typeof data.adapterData === 'object' &&","+        data.adapterData !== null &&","+        !Array.isArray(data.adapterData))) &&","     (data.allowOverwrite === undefined || typeof data.allowOverwrite === 'boolean') &&","     typeof data.collectionSlug === 'string' &&","     typeof data.expiresAt === 'number' &&"],"additions":46,"deletions":2,"truncated":false},{"path":"packages/payload/src/uploads/getFileFromUploadInstructions.spec.ts","lines":["@@ -311,6 +311,50 @@ describe('getFileFromUploadInstructions', () => {","     expect(handler).not.toHaveBeenCalled()","   })"," ","+  it('should pass signed adapterData to the handler', async () => {","+    const handler = vi.fn(async () => new Response(Buffer.alloc(18), { status: 200 }))","+    const req = createReq([handler])","+    const file = createUploadReferenceFile()","+    file.uploadReference.signedReceipt = JSON.stringify({","+      ...JSON.parse(file.uploadReference.signedReceipt as string),","+      adapterData: { providerUploadID: 'provider-1' },","+    })","+","+    const result = await getFileFromUploadInstructions({ collectionSlug: 'media', file, req })","+","+    tempFilesToClean.push(result.tempFilePath!)","+    expect(handler).toHaveBeenCalledWith(","+      expect.anything(),","+      expect.objectContaining({","+        params: expect.objectContaining({","+          uploadReference: expect.objectContaining({","+            adapterData: { providerUploadID: 'provider-1' },","+          }),","+        }),","+      }),","+    )","+  })","+","+  it('should keep prefix and _objectKey from the receipt when adapterData contains them', async () => {","+    const handler = vi.fn(async () => new Response(Buffer.alloc(18), { status: 200 }))","+    const req = createReq([handler])","+    const file = createUploadReferenceFile()","+    file.uploadReference.signedReceipt = JSON.stringify({","+      ...JSON.parse(file.uploadReference.signedReceipt as string),","+      adapterData: { _objectKey: 'other-upload', prefix: 'private' },","+    })","+","+    const result = await getFileFromUploadInstructions({ collectionSlug: 'media', file, req })","+","+    tempFilesToClean.push(result.tempFilePath!)","+    expect(result.uploadReference).toEqual({","+      _objectKey: 'upload-1',","+      adapterData: { _objectKey: 'other-upload', prefix: 'private' },","+      prefix: '',","+      signedReceipt: expect.any(String),","+    })","+  })","+","   it('fetches only a bounded header for an image with no configured adjustments', async () => {","     const handler = vi.fn(async (handlerReq: PayloadRequest) => {","       expect(handlerReq.headers.get('range')).toBe(`bytes=0-${HEADER_PROBE_BYTE_LENGTH - 1}`)"],"additions":44,"deletions":0,"truncated":false},{"path":"packages/payload/src/uploads/getFileFromUploadInstructions.ts","lines":["@@ -122,6 +122,7 @@ export const getFileFromUploadInstructions = async ({","       ...file,","       uploadReference: {","         _objectKey: receipt._objectKey,","+        ...(receipt.adapterData && { adapterData: receipt.adapterData }),","         prefix: receipt.filePrefix,","         signedReceipt,","       },"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/payload/src/uploads/types.ts","lines":["@@ -401,7 +401,11 @@ export type GenerateUploadInstructions = ("," export type UploadInstructionsCapability = {","   /** Generates upload instructions. The generator or supporting endpoint must check access. */","   generate: GenerateUploadInstructions","-  /** Require a signed server-issued reference before invoking upload handlers. @internal */","+  /**","+   * Require a receipt signed by `resolveSignedURLKey` before invoking upload handlers. Client","+   * uploads keep an `original` and file history only when a receipt is verified.","+   * @see https://payloadcms.com/docs/upload/storage-adapters#custom-upload-receipts","+   */","   requiresUploadReceipt?: boolean","   /**","    * Whether the Admin panel should use these instructions before saving a document."],"additions":5,"deletions":1,"truncated":false},{"path":"packages/plugin-cloud-storage/src/exports/utilities.ts","lines":["@@ -6,3 +6,4 @@ export {"," export { getFilePrefix } from '../utilities/getFilePrefix.js'"," export { resolveSignedURLKey } from '../utilities/resolveSignedURLKey.js'"," export { sanitizePrefix } from '../utilities/sanitizePrefix.js'","+export { resignClientUploadReceipt } from 'payload/internal'"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/plugin-cloud-storage/src/types.ts","lines":["@@ -33,6 +33,8 @@ export type ClientUploadsConfig = { access?: UploadInstructionsAccess } | boolea","  */"," export type UploadReference = {","   _objectKey?: string","+  /** Data the adapter signed into the receipt with `resolveSignedURLKey`. Not stored on the document. */","+  adapterData?: Record<string, unknown>","   prefix: string","   signedReceipt: `${string}.${string}`"," }"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/plugin-cloud-storage/src/utilities/resolveSignedURLKey.spec.ts","lines":["@@ -84,4 +84,17 @@ describe('resolveSignedURLKey', () => {","       },","     })","   })","+","+  it('should sign adapterData into the receipt', async () => {","+    await resolveSignedURLKey({","+      adapterData: { providerUploadID: 'provider-1' },","+      collectionSlug: 'media',","+      filename: 'photo.jpg',","+      req: {} as never,","+    })","+","+    expect(createClientUploadReceipt).toHaveBeenCalledWith(","+      expect.objectContaining({ adapterData: { providerUploadID: 'provider-1' } }),","+    )","+  })"," })"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/plugin-cloud-storage/src/utilities/resolveSignedURLKey.ts","lines":["@@ -14,6 +14,8 @@ import type { UploadReference } from '../types.js'"," import { buildUploadPrefix, buildUploadStoragePathData } from './buildStoragePathData.js'"," "," type Args = {","+  /** Signed into the receipt and returned to the upload handler as `uploadReference.adapterData`. */","+  adapterData?: Record<string, unknown>","   collectionPrefix?: string","   collectionSlug: string","   docPrefix?: string","@@ -40,6 +42,7 @@ type Args = {","  * beneath the configured collection prefix.","  */"," export async function resolveSignedURLKey({","+  adapterData,","   collectionPrefix = '',","   collectionSlug,","   docPrefix,","@@ -87,6 +90,7 @@ export async function resolveSignedURLKey({","     prefix: sanitizedDocPrefix,","     signedReceipt: createClientUploadReceipt({","       _objectKey,","+      ...(adapterData !== undefined && { adapterData }),","       collectionSlug,","       filename: sanitizedFilename,","       filePrefix: sanitizedDocPrefix,",""],"additions":4,"deletions":0,"truncated":false}],"additions":326,"deletions":3,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-27T15:03:25.758021+00:00"}