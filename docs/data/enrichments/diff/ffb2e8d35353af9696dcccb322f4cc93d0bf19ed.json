n std::nullopt;","+    }","+    auto job = std::move(queue_.front());","+    queue_.pop_front();","+    return job;","+  }","+","+ private:","+  jsi::Runtime& runtime_;","+  std::mutex mutex_;","+  std::condition_variable gateOpened_;","+  std::condition_variable dispatched_;","+  std::list<CallFunc> queue_;","+  std::optional<SchedulerPriority> lastPriority_;","+  size_t dispatchCount_{0};","+  bool gateOpen_{true};","+};","+","+// Where and how often a value owned by a long lived object was destroyed.","+struct ReleaseRecord {","+  void record() {","+    std::scoped_lock lock(mutex);","+    ++count;","+    thread = std::this_thread::get_id();","+  }","+","+  int releaseCount() {","+    std::scoped_lock lock(mutex);","+    return count;","+  }","+","+  std::thread::id releaseThread() {","+    std::scoped_lock lock(mutex);","+    return thread;","+  }","+","+  std::mutex mutex;","+  int count{0};","+  std::thread::id thread{};","+};","+","+// A payload that reports its own destruction. Moving it hands the report over,","+// so a moved-from temporary never counts as a release.","+class ProbePayload {","+ public:","+  explicit ProbePayload(std::function<void()> onDestroy)","+      : onDestroy_(std::move(onDestroy)) {}","+","+  ProbePayload(ProbePayload&& other) noexcept","+      : onDestroy_(std::exchange(other.onDestroy_, nullptr)) {}","+","+  ProbePayload& operator=(ProbePayload&&) = delete;","+","+  ProbePayload(const ProbePayload&) = delete;","+  ProbePayload& operator=(const ProbePayload&) = delete;","+","+  ~ProbePayload() {","+    if (onDestroy_) {","+      onDestroy_();","+    }","+  }","+","+ private:","+  std::function<void()> onDestroy_;","+};","+","+ProbePayload recordingPayload(const std::shared_ptr<ReleaseRecord>& record) {","+  return ProbePayload([record] { record->record(); });","+}","+","+} // namespace","+","+TEST_F(BridgingTest, syncCallbackDestroyedOffJsThreadReleasesOnJsThread) {","+  auto jsInvoker = std::make_shared<ConcurrentTestCallInvoker>(rt);","+  auto& collection = LongLivedObjectCollection::get(rt);","+","+  {","+    // Kept on the heap so that a cleanup job reaching back into the destroyed","+    // native owner is a use-after-free the sanitizers report, rather than a","+    // read of stack storage that is still mapped.","+    auto callback = std::make_unique<SyncCallback<void()>>(","+        rt, function(\"() => {}\"), jsInvoker);","+    EXPECT_EQ(1, collection.size());","+","+    std::thread worker([&] { callback.reset(); });","+    worker.join();","+","+    // Dropping the last native owner away from the JavaScript thread must not","+    // reach into the collection: the function stays rooted until a JavaScript","+    // task releases it.","+    EXPECT_EQ(1, collection.size());","+  }","+","+  jsInvoker->flushQueue();","+  EXPECT_EQ(0, collection.size());","+}","+","+TEST_F(BridgingTest, syncCallbackMoveAssignmentReleasesReplacedCallback) {","+  auto jsInvoker = std::make_shared<ConcurrentTestCallInvoker>(rt);","+  auto& collection = LongLivedObjectCollection::get(rt);","+","+  {","+    SyncCallback<std::string()> callback(","+        rt, function(\"() => 'first'\"), jsInvoker);","+","+    {","+      SyncCallback<std::string()> replacement(","+          rt, function(\"() => 'second'\"), jsInvoker);","+      EXPECT_EQ(2, collection.size());","+","+      callback = std::move(replacement);","+","+      // Assignment has no runtime access, so even on the JavaScript thread the","+      // replaced root stays until its queued release runs.","+      EXPECT_EQ(2, collection.size());","+      EXPECT_EQ(1, jsInvoker->queueSize());","+      EXPECT_EQ(\"second\"s, callback());","+","+      jsInvoker->flushQueue();","+      EXPECT_EQ(1, collection.size());","+    }","+","+    // Destroying the moved-from source must not release what it handed over.","+    EXPECT_EQ(1, collection.size());","+    EXPECT_EQ(\"second\"s, callback());","+","+    // Assignment resets the destination before taking ownership, so self","+    // assignment has to be guarded.","+    auto& alias = callback;","+    callback = std::move(alias);","+    EXPECT_EQ(1, collection.size());","+    EXPECT_EQ(0, jsInvoker->queueSize());","+    EXPECT_EQ(\"second\"s, callback());","+  }","+","+  EXPECT_EQ(1, jsInvoker->queueSize());","+  jsInvoker->flushQueue();","+  EXPECT_EQ(0, collection.size());","+}","+","+TEST_F(BridgingTest, asyncCallbackClearedDuringDispatchNeverCallsJs) {","+  enum class Path {","+    Arguments,","+    ArgumentsWithPriority,","+    Function,","+    FunctionWithPriority,","+  };","+","+  for (auto path :","+       {Path::Arguments,","+        Path::ArgumentsWithPriority,","+        Path::Function,","+        Path::FunctionWithPriority}) {","+    auto jsInvoker = std::make_shared<ConcurrentTestCallInvoker>(rt);","+    std::string output;","+    auto nativeFunc = std::function<void(std::string)>(","+        [&](auto str) { output = std::move(str); });","+","+    {","+      auto callback =","+          bridging::fromJs<AsyncCallback<decltype(nativeFunc), std::string>>(","+              rt, function(\"(func, str) => func(str)\"), jsInvoker);","+","+      auto callImpl = [nativeFunc, jsInvoker](","+                          jsi::Runtime& runtime, jsi::Function& jsFunc) {","+        jsFunc.call(","+            runtime,","+            bridging::toJs(runtime, nativeFunc, jsInvoker),","+            bridging::toJs(runtime, \"called\", jsInvoker));","+      };","+","+      jsInvoker->closeGate();","+","+      std::thread worker([&] {","+        switch (path) {","+          case Path::Arguments:","+            callback(nativeFunc, \"called\");","+            break;","+          case Path::ArgumentsWithPriority:","+            callback.callWithPriority(","+                SchedulerPriority::IdlePriority, nativeFunc, \"called\");","+            break;","+          case Path::Function:","+            callback.call(callImpl);","+            break;","+          case Path::FunctionWithPriority:","+            callback.callWithPriority(","+                SchedulerPriority::IdlePriority, callImpl);","+            break;","+        }","+      });","+","+      // The dispatching thread is now parked inside the invoker, past the","+      // point where it found the callback alive.","+      jsInvoker->waitForDispatch(1);","+      LongLivedObjectCollection::get(rt).clear(rt);","+      jsInvoker->openGate();","+      worker.join();","+","+      jsInvoker->flushQueue();","+      EXPECT_EQ(\"\"s, output) << \"dispatch path \" << static_cast<int>(path);","+    }","+","+    jsInvoker->flushQueue();","+  }","+}","+","+TEST_F(BridgingTest, asyncCallbackDispatchAfterInvalidationEnqueuesNothing) {","+  auto jsInvoker = std::make_shared<ConcurrentTestCallInvoker>(rt);","+  std::string output;","+  auto nativeFunc = std::function<void(std::string)>(","+      [&](auto str) { output = std::move(str); });","+","+  {","+    auto callback =","+        bridging::fromJs<AsyncCallback<decltype(nativeFunc), std::string>>(","+            rt, function(\"(func, str) => func(str)\"), jsInvoker);","+","+    auto callImpl = [nativeFunc, jsInvoker](","+                        jsi::Runtime& runtime, jsi::Function& jsFunc) {","+      jsFunc.call(","+          runtime,","+          bridging::toJs(runtime, nativeFunc, jsInvoker),","+          bridging::toJs(runtime, \"called\", jsInvoker));","+    };","+","+    LongLivedObjectCollection::get(rt).clear(rt);","+","+    callback(nativeFunc, \"called\");","+    callback.callWithPriority(","+        SchedulerPriority::IdlePriority, nativeFunc, \"called\");","+    callback.call(callImpl);","+    callback.callWithPriority(SchedulerPriority::IdlePriority, callImpl);","+","+    EXPECT_EQ(0, jsInvoker->queueSize());","+  }","+","+  jsInvoker->flushQueue();","+  EXPECT_EQ(\"\"s, output);"],"additions":338,"deletions":1,"truncated":false}],"additions":568,"deletions":93,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-12T17:12:24.972627+00: