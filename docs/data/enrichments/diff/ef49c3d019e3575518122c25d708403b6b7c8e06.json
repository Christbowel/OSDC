{"id":"ef49c3d019e3575518122c25d708403b6b7c8e06","axis":"silent","repo":"pnpm/pnpm","sha":"ef49c3d019e3575518122c25d708403b6b7c8e06","parsed":{"files":[{"path":".changeset/pnpr-security-audit-routing-gzip-osv.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Router registries now partition npm security audit requests by package route, keeping hosted packages local and sending each upstream only the packages routed to it. The audit endpoints now accept `Content-Encoding: gzip` requests such as those sent by `npm audit`. `POST /-/npm/v1/security/audits` and `POST /-/npm/v1/security/audits/quick` now also evaluate advisories from the local OSV database when `--osv` is enabled."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/osv/src/lib.rs","lines":["@@ -184,6 +184,23 @@ impl OsvIndex {","         result","     }"," ","+    /// Query [`BulkAdvisory`] entries matching a single `(name, version)` pair.","+    #[must_use]","+    pub fn advisories_for_version(&self, name: &str, version: &str) -> Vec<BulkAdvisory> {","+        let Some(advisories) = self.advisories(name) else {","+            return Vec::new();","+        };","+        let parsed = Version::parse(version).ok();","+        let mut matched = Vec::new();","+        let mut seen_ids = HashSet::new();","+        for advisory in advisories {","+            if advisory.affects(version, parsed.as_ref()) && seen_ids.insert(advisory.bulk.id) {","+                matched.push(advisory.bulk.clone());","+            }","+        }","+        matched","+    }","+","     fn advisories(&self, name: &str) -> Option<&[Advisory]> {","         self.packages","             .get(normalized_name(name).as_ref())"],"additions":17,"deletions":0,"truncated":false},{"path":"pnpr/crates/osv/tests/bulk_advisories.rs","lines":["@@ -151,6 +151,11 @@ fn bulk_advisories_sorts_out_of_order_events_when_formatting() {","     assert_eq!(result.len(), 1);","     let adv = &result[\"reversed\"][0];","     assert_eq!(adv.vulnerable_versions, \">=1.0.0 <1.2.0\");","+","+    let per_version = index.advisories_for_version(\"reversed\", \"1.1.0\");","+    assert_eq!(per_version.len(), 1);","+    assert_eq!(per_version[0].vulnerable_versions, \">=1.0.0 <1.2.0\");","+    assert!(index.advisories_for_version(\"reversed\", \"1.2.0\").is_empty());"," }"," "," #[test]"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/security_audit.rs","lines":["@@ -1,24 +1,64 @@","+mod encoding;","+mod legacy;","+mod legacy_merge;","+mod legacy_nodes;","+mod legacy_report;","+mod legacy_sanitize;","+mod legacy_specs;","+","+#[cfg(test)]","+mod tests;","+"," use std::collections::HashMap;"," "," use axum::{","     Router,","     body::Bytes,","     extract::{DefaultBodyLimit, State},","+    http::HeaderMap,","     response::{IntoResponse, Response},","     routing::post,"," };","-use reqwest::{StatusCode, header};","-","-use pnpr_package_name::Ecosystem;","+use indexmap::IndexMap;","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};"," use pnpr_policy::Identity;","-use pnpr_upstream::FetchOutcome;","+use pnpr_upstream::{FetchOutcome, Upstream};","+use reqwest::{StatusCode, header};","+use serde_json::{Map, Value};"," "," use super::{","-    AppState, AuthedCaller, JsonObject, RegistryError, TargetRegistry, addressed_registry,","-    authorized_upstream, ecosystem::upstream_sources, not_found,","+    Action, AppState, AuthedCaller, HostedGate, RegistryError, RegistrySource, TargetRegistry,","+    addressed_registry, authorize, authorized_upstream,","+    ecosystem::{hosted_sources, upstream_sources},","+    hosted_gate, not_found, resolve_registry_source,"," };"," "," const MAX_AUDIT_BODY_BYTES: usize = 16 * 1024 * 1024;","+const CACHE_CONTROL_NO_STORE: &str = \"private, no-cache, no-store, must-revalidate\";","+","+type BulkPackageQuery = HashMap<String, Vec<String>>;","+","+pub(super) enum PackageDestination {","+    Hosted,","+    Upstream(String),","+    Skip,","+}","+","+struct BulkPartition {","+    osv_packages: BulkPackageQuery,","+    by_upstream: IndexMap<String, BulkPackageQuery>,","+}","+","+struct PreparedBulkUpstream {","+    client: Upstream,","+    subset: BulkPackageQuery,","+    payload: Vec<u8>,","+}","+","+struct BulkUpstreamOutcome {","+    subset: BulkPackageQuery,","+    outcome: FetchOutcome<Vec<u8>>,","+}"," "," pub(super) fn routes(router: Router<AppState>, base: &str) -> Router<AppState> {","     let path = |tail: &str| format!(\"{base}{tail}\");","@@ -39,50 +79,181 @@ async fn post_bulk_advisories(","     State(state): State<AppState>,","     AuthedCaller(identity): AuthedCaller,","     TargetRegistry(registry): TargetRegistry,","+    headers: HeaderMap,","     body: Bytes,"," ) -> Response {","     let Some(target) = addressed_registry(&state, registry.as_deref(), Ecosystem::Npm) else {","         return not_found();","     };","-","-    let packages: HashMap<String, Vec<String>> = if body.is_empty() {","-        HashMap::new()","-    } else {","-        match serde_json::from_slice(&body) {","-            Ok(parsed) => parsed,","-            Err(_) => return bad_request_json(),","-        }","+    let packages = match parse_bulk_request(&headers, &body) {","+        Ok(parsed) => parsed,","+        Err(response) => return response,","+    };","+    let is_empty_query = packages.is_empty();","+    let partition = match partition_bulk_packages(&state, &identity, &target, packages) {","+        Ok(partition) => partition,","+        Err(err) => return err.into_response(),","     };"," ","     if let Some(osv_index) = state.inner.osv_index.as_ref() {","-        let advisories = osv_index.bulk_advisories(&packages);","+        let advisories = osv_index.bulk_advisories(&partition.osv_packages);","         return json_response(&advisories);","     }","+    if partition.by_upstream.is_empty() {","+        return empty_bulk_response(&state, &identity, &target, is_empty_query);","+    }"