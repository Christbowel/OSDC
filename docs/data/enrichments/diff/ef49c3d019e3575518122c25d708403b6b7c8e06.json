y in outcomes {","+        let FetchOutcome::Ok(bytes) = entry.outcome else {","+            return not_found();","+        };","+        let parsed: Map<String, Value> = match serde_json::from_slice(&bytes) {","+            Ok(map) => map,","+            Err(err) => return RegistryError::Json(err).into_response(),","+        };","+        insert_provenance_filtered_bulk(parsed, &entry.subset, &mut merged);","+    }","+    json_response(&merged)","+}","+","+fn insert_provenance_filtered_bulk(","+    parsed: Map<String, Value>,","+    subset: &BulkPackageQuery,","+    merged: &mut Map<String, Value>,","+) {","+    for (package_name, advisories) in parsed {","+        if subset.contains_key(&package_name) && advisories.is_array() {","+            merged.insert(package_name, advisories);","+        }","     }"," }"," ","@@ -90,21 +261,31 @@ async fn post_security_audits(","     State(state): State<AppState>,","     AuthedCaller(identity): AuthedCaller,","     TargetRegistry(registry): TargetRegistry,","+    headers: HeaderMap,","     body: Bytes,"," ) -> Response {","-    forward_legacy_audit(&state, &identity, registry.as_deref(), \"/-/npm/v1/security/audits\", &body)","-        .await","+    legacy::serve_legacy_audit(","+        &state,","+        &identity,","+        &headers,","+        registry.as_deref(),","+        \"/-/npm/v1/security/audits\",","+        &body,","+    )","+    .await"," }"," "," async fn post_security_audits_quick(","     State(state): State<AppState>,","     AuthedCaller(identity): AuthedCaller,","     TargetRegistry(registry): TargetRegistry,","+    headers: HeaderMap,","     body: Bytes,"," ) -> Response {","-    forward_legacy_audit(","+    legacy::serve_legacy_audit(","         &state,","         &identity,","+        &headers,","         registry.as_deref(),","         \"/-/npm/v1/security/audits/quick\",","         &body,","@@ -112,62 +293,7 @@ async fn post_security_audits_quick(","     .await"," }"," ","-async fn forward_legacy_audit(","-    state: &AppState,","-    identity: &Identity,","-    registry: Option<&str>,","-    endpoint: &str,","-    body: &[u8],","-) -> Response {","-    let Some(target) = addressed_registry(state, registry, Ecosystem::Npm) else {","-        return not_found();","-    };","-    if !body.is_empty() && serde_json::from_slice::<JsonObject>(body).is_err() {","-        return bad_request_json();","-    }","-","-    let upstreams = upstream_sources(state, &target, Ecosystem::Npm);","-    let Some(upstream_name) = upstreams.first() else {","-        return empty_legacy_audit_response();","-    };","-","-    let upstream = match authorized_upstream(state, identity, upstream_name) {","-        Ok(client) => client,","-        Err(err) => return err.into_response(),","-    };","-","-    let payload = if body.is_empty() { b\"{}\" } else { body };","-    match upstream.post_audit(endpoint, payload).await {","-        Ok(FetchOutcome::Ok(bytes)) => audit_bytes_response(bytes),","-        Ok(FetchOutcome::NotFound) => empty_legacy_audit_response(),","-        Err(err) => err.into_response(),","-    }","-}","-","-fn empty_legacy_audit_response() -> Response {","-    let body = serde_json::json!({","-        \"actions\": [],","-        \"advisories\": {},","-        \"muted\": [],","-        \"metadata\": {","-            \"vulnerabilities\": {","-                \"info\": 0,","-                \"low\": 0,","-                \"moderate\": 0,","-                \"high\": 0,","-                \"critical\": 0,","-                \"total\": 0,","-            },","-            \"dependencies\": 0,","-            \"devDependencies\": 0,","-            \"optionalDependencies\": 0,","-            \"totalDependencies\": 0,","-        },","-    });","-    json_response(&body)","-}","-","-fn json_response<Payload: serde::Serialize>(value: &Payload) -> Response {","+pub(super) fn json_response<Payload: serde::Serialize>(value: &Payload) -> Response {","     let body = match serde_json::to_vec(value) {","         Ok(bytes) => bytes,","         Err(err) => return RegistryError::Json(err).into_response(),","@@ -180,21 +306,21 @@ fn audit_bytes_response(bytes: Vec<u8>) -> Response {","         StatusCode::OK,","         [","             (header::CONTENT_TYPE, \"application/json\"),","-            (header::CACHE_CONTROL, \"private, no-cache, no-store, must-revalidate\"),","+            (header::CACHE_CONTROL, CACHE_CONTROL_NO_STORE),","         ],","         bytes,","     )","         .into_response()"," }"," ","-fn bad_request_json() -> Response {","-    let mut response =","-        pnpr_error::json_error(StatusCode::BAD_REQUEST, \"invalid json payload\", None);","+pub(super) fn bad_request_json() -> Response {","+    audit_error_response(StatusCode::BAD_REQUEST, \"invalid json payload\")","+}","+","+pub(super) fn audit_error_response(status: StatusCode, message: &str) -> Response {","+    let mut response = pnpr_error::json_error(status, message, None);","     response","         .headers_mut()","-        .insert(","-            header::CACHE_CONTROL,","-            \"private, no-cache, no-store, must-revalidate\".parse().unwrap(),","-        );","+        .insert(header::CACHE_CONTROL, header::HeaderValue::from_static(CACHE_CONTROL_NO_STORE));","     response"," }"],"additions":220,"deletions":94,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/security_audit/encoding.rs","lines":["@@ -0,0 +1,93 @@","+use std::{borrow::Cow, io::Read};","+","+use axum::{","+    body::Bytes,","+    http::{HeaderMap, StatusCode, header},","+    response::Response,","+};","+","+use super::{MAX_AUDIT_BODY_BYTES, audit_error_response};","+","+const INITIAL_DECODE_CAPACITY_CAP: usize = 64 * 1024;","+","+#[derive(Clone, Copy)]","+enum ContentCoding {","+    Identity,","+    Gzip,","+}","+","+pub(super) fn decode_request_body<'body>(","+    headers: &HeaderMap,","+    body: &'body Bytes,","+) -> Result<Cow<'body, [u8]>, Response> {","+    match parse_content_coding(headers)? {","+        ContentCoding::Identity => Ok(Cow::Borrowed(body.as_ref())),","+        ContentCoding::Gzip => {","+            decompress_gzip_bounded(body.as_ref(), MAX_AUDIT_BODY_BYTES).map(Cow::Owned)","+        }","+    }","+}","+","+fn parse_content_coding(headers: &HeaderMap) -> Result<ContentCoding, Response> {","+    let mut values = headers.get_all(header::CONTENT_ENCODING).iter();","+    let Some(first) = values.next() else {","+        return Ok(ContentCoding::Identity);","+    };","+    if values.next().is_some() {","+        return Err(unsupported_encoding_response());","+    }","+    let Ok(raw) = first.to_str() else {","+        return Err(unsupported_encoding_response());","+    };","+    let token = raw.trim();","+    if token.eq_ignore_ascii_case(\"identity\") {","+        return Ok(ContentCoding::Identity);","+    }","+    if token.eq_ignore_ascii_case(\"gzip\") || token.eq_ignore_ascii_case(\"x-gzip\") {","+        return Ok(ContentCoding::Gzip);","+    }","+    Err(unsupported_encoding_response())","+}","+","+pub(super) fn decompress_gzip_bounded(","+    compressed: &[u8],","+    limit: usize,","+) -> Result<Vec<u8>, Response> {","+    if compressed.is_empty() {","+        return Err(invalid_gzip_response());","+    }","+    let mut decompressed = Vec::with_capacity(compressed.len().min(INITIAL_DECODE_CAPACITY_CAP));","+    let mut remaining = compressed;","+    while !remaining.is_empty() {","+        let before_len = remaining.len();","+        let allowance = (limit - decompressed.len()) as u64;","+        let mut decoder = flate2::bufread::GzDecoder::new(&mut remaining);","+        if decoder","+            .by_ref()","+            .take(allowance + 1)","+            .read_to_end(&mut decompressed)","+            .is_err()","+        {","+            return Err(invalid_gzip_response());","+        }","+        if decompressed.len() > limit {","+            return Err(payload_too_large_response());","+        }","+        if remaining.len() == before_len {","+            return Err(invalid_gzip_response());","+        }","+    }","+    Ok(decompressed)","+}","+","+fn unsupported_encoding_response() -> Response {","+    audit_error_response(StatusCode::UNSUPPORTED_MEDIA_TYPE, \"unsupported content-encoding\")","+}","+","+fn invalid_gzip_response() -> Response {","+    audit_error_response(StatusCode::BAD_REQUEST, \"invalid gzip payload\")","+}","+","+fn payload_too_large_response() -> Response {","+    audit_error_response(StatusCode::PAYLOAD_TOO_LARGE, \"request body too large\")","+}"],"additions":93,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/security_audit/legacy.rs","lines":["@@ -0,0 +1,213 @@","+use std::collections::{HashMap, HashSet};","+","+use axum::{","+    body::Bytes,","+    http::HeaderMap,","+    response::{IntoResponse, Response},","+};","+use pnpr_error::RegistryError;","+use pnpr_package_name::Ecosystem;","+use pnpr_policy::Identity;","+use pnpr_upstream::{FetchOutcome, Upstream};","+use serde_json::{Map, Value};","+","+use super::{","+    AppState, PackageDestination, addressed_registry, authorized_upstream, bad_request_json,","+    encoding::decode_request_body,","+    json_response,","+    legacy_merge::{merge_upstream_legacy_responses, sanitize_upstream_legacy_response},","+    legacy_nodes::{LegacyClassification, classify_legacy_packages, collect_installed_nodes},","+    legacy_report::{InstalledNode, LegacyAuditReport, build_osv_legacy_report},","+    legacy_sanitize::build_upstream_legacy_payload,","+    not_found, upstream_sources,","+};","+","+struct PreparedLegacyUpstream {","+    client: Upstream,","+    allowed: HashSet<String>,","+    payload: Vec<u8>,","+}","+","+pub(super) async fn serve_legacy_audit(","+    state: &AppState,","+    identity: &Identity,","+    headers: &HeaderMap,","+    registry: Option<&str>,","+    endpoint: &str,","+    body: &Bytes,","+) -> Response {","+    let Some(target) = addressed_registry(state, registry, Ecosystem::Npm) else {","+        return not_found();","+    };","+    let decoded = match decode_request_body(headers, body) {","+        Ok(bytes) => bytes,","+        Err(response) => return response,","+    };","+    let payload: Map<String, Value> = if decoded.is_empty() {","+        Map::new()","+    } else {","+        match serde_json::from_slice(&decoded) {","+            Ok(parsed) => parsed,","+            Err(_) => return bad_request_json(),","+        }","+    };","+","+    let Ok(raw_nodes) = collect_installed_nodes(&payload) else {","+        return bad_request_json();","+    };","+    let classification =","+        match classify_legacy_packages(state, identity, &target, &payload, &raw_nodes) {","+            Ok(classification) => classification,","+            Err(err) => return err.into_response(),","+        };","+","+    if let Some(osv_index) = state.inner.osv_index.as_ref() {","+        let allowed_nodes = retain_osv_nodes(raw_nodes, &classification.destinations);","+        return json_response(&build_osv_legacy_report(osv_index, &allowed_nodes));","+    }","+","+    forward_partitioned_legacy(state, identity, &target, endpoint, &payload, &classification).await","+}","+","+fn retain_osv_nodes(","+    raw_nodes: Vec<InstalledNode>,","+    destinations: &HashMap<String, PackageDestination>,","+) -> Vec<InstalledNode> {","+    raw_nodes","+        .into_iter()","+        .filter(|node| match destinations.get(&node.package) {","+            Some(PackageDestination::Hosted | PackageDestination::Upstream(_)) => true,","+            Some(PackageDestination::Skip) | None => false,","+        })","+        .collect()","+}","+","+async fn forward_partitioned_legacy(","+    state: &AppState,","+    identity: &Identity,","+    target: &str,","+    endpoint: &str,","+    payload: &Map<String, Value>,","+    classification: &LegacyClassification,","+) -> Response {","+    let active_upstreams =","+        select_legacy_upstreams(state, target, payload, &classification.referenced_upstreams);","+    if active_upstreams.is_empty() {","+        return json_response(&LegacyAuditReport::default());","+    }","+","+    let mut prepared = Vec::with_capacity(active_upstreams.len());","+    for upstream_name in active_upstreams {","+        let client = match authorized_upstream(state, identity, &upstream_name) {","+            Ok(client) => client,","+            Err(err) => return err.into_response(),","+        };","+        let sanitized =","+            build_upstream_legacy_payload(payload, &upstream_name, &classification.destinations);","+        let serialized = match serde_json::to_vec(&sanitized) {","+            Ok(bytes) => bytes,","+            Err(err) => return RegistryError::Json(err).into_response(),","+        };","+        let allowed = allowed_packages_for_upstream(&upstream_name, &classification.destinations);","+        prepared.push(PreparedLegacyUpstream { client, allowed, payload: serialized });","+    }","+","+    execute_legacy_upstream_requests(endpoint, prepared).await","+}","+","+async fn execute_legacy_upstream_requests(","+    endpoint: &str,","+    prepared: Vec<PreparedLegacyUpstream>,","+) -> Response {","+    let is_single = prepared.len() == 1;","+    let futures = prepared","+        .into_iter()","+        .map(|item| async move {","+            let outcome = item.client.post_audit(endpoint, &item.payload).await?;","+            Ok::<_, RegistryError>((item.allowed, outcome))","+        });","+    let outcomes = match futures_util::future::try_join_all(futures).await {","+        Ok(outcomes) => outcomes,","+        Err(err) => return err.into_response(),","+    };","+","+    let mut parsed_docs = Vec::new();","+    for (allowed, outcome) in outcomes {","+        if let FetchOutcome::Ok(bytes) = outcome {","+            let doc: Map<String, Value> = match serde_json::from_slice(&bytes) {","+                Ok(doc) => doc,","+                Err(err) => return RegistryError::Json(err).into_respons