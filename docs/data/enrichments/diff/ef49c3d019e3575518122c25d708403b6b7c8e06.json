       HostedGate::Denied(err) => Err(err),","+            }","+        }","+        RegistrySource::Upstream(source) => {","+            authorize(state, identity, &resolved, canonical.as_str(), Action::Read)?;","+            Ok(PackageDestination::Upstream(source.clone()))","+        }","+        RegistrySource::Unclaimed | RegistrySource::NotFound => Ok(PackageDestination::Skip),","+    }","+}","+","+fn partition_bulk_packages(","+    state: &AppState,","+    identity: &Identity,","+    target: &str,","+    packages: HashMap<String, Vec<String>>,","+) -> Result<BulkPartition, RegistryError> {","+    let ordered_upstreams = upstream_sources(state, target, Ecosystem::Npm);","+    let mut osv_packages = HashMap::new();","+    let mut raw_by_upstream: HashMap<String, HashMap<String, Vec<String>>> = HashMap::new();","+","+    for (package_name, versions) in packages {","+        match classify_package(state, identity, target, &package_name)? {","+            PackageDestination::Hosted => {","+                osv_packages.insert(package_name, versions);","+            }","+            PackageDestination::Upstream(upstream_name) => {","+                osv_packages.insert(package_name.clone(), versions.clone());","+                let safe_versions: Vec<String> = versions","+                    .into_iter()","+                    .filter(|ver| legacy_specs::is_safe_semver_version(ver))","+                    .collect();","+                if !safe_versions.is_empty() {","+                    raw_by_upstream","+                        .entry(upstream_name)","+                        .or_default()","+                        .insert(package_name, safe_versions);","+                }","+            }","+            PackageDestination::Skip => {}","+        }","+    }"," ","-    let upstream = match authorized_upstream(state, identity, upstream_name) {","-        Ok(client) => client,","+    let mut by_upstream = IndexMap::new();","+    for upstream_name in ordered_upstreams