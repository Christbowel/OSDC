$UNIT_NAME\"/*)"," [[ ! -e \"$POST_FLAG_FILE\" ]]"," "," OUTPUT_FILE_USER=\"/tmp/TEST-54-CREDS-refreshing-user.out\"","+USER_REFRESH_SOURCE=\"/tmp/TEST-54-CREDS-refreshing-user.cred\"","+echo \"initial\" >\"$USER_REFRESH_SOURCE\"","+chmod 0644 \"$USER_REFRESH_SOURCE\""," "," systemd-notify --fork -- \\","     systemd-run -M testuser@ --user --wait \\","@@ -707,7 +718,9 @@ systemd-notify --fork -- \\","         --service-type=notify-reload \\","         -p NotifyAccess=all \\","         -p 'ImportCredential=brummbaer*' \\","+        -p \"LoadCredential=reload-timeout:$USER_REFRESH_SOURCE\" \\","         -p RefreshOnReload=credentials \\","+        -p TimeoutStartSec=10s \\","         -p ProtectSystem=strict \\","         -p ReadWritePaths=/tmp \\","         /usr/lib/systemd/tests/testdata/TEST-54-CREDS.units/refresh.sh \"$OUTPUT_FILE_USER\"","@@ -723,4 +736,19 @@ systemctl -M testuser@ --user reload brummbaer-refresh.service"," assert_eq \"$(cat \"$TESTUSER_CRED_DIR\"/brummbaer-refresh.service/brummbaer.refreshed)\" \"refreshed\""," diff \"$OUTPUT_FILE_USER\" <(grep . \"$TESTUSER_CRED_DIR\"/brummbaer-refresh.service/*)"," ","+# A stale workspace left by a timed-out credential refresh must not break the next refresh.","+rm \"$USER_REFRESH_SOURCE\"","+mkfifo \"$USER_REFRESH_SOURCE\"","+chmod 0644 \"$USER_REFRESH_SOURCE\"","+(! systemctl -M testuser@ --user reload brummbaer-refresh.service)","+assert_eq \"$(systemctl -M testuser@ --user show brummbaer-refresh.service -P ReloadResult)\" \"timeout\"","+[[ -d \"/run/user/$(id -u testuser)/systemd/temporary-credentials/brummbaer-refresh.service\" ]]","+","+rm \"$USER_REFRESH_SOURCE\"","+echo \"after-timeout\" >\"$USER_REFRESH_SOURCE\"","+chmod 0644 \"$USER_REFRESH_SOURCE\"","+systemctl -M testuser@ --user reload brummbaer-refresh.service","+assert_eq \"$(cat \"$TESTUSER_CRED_DIR\"/brummbaer-refresh.service/reload-timeout)\" \"after-timeout\"","+[[ ! -e \"/run/user/$(id -u testuser)/systemd/temporary-credentials/brummbaer-refresh.service\" ]]","+"," touch /testok",""],"additions":28,"deletions":0,"truncated":false}],"additions":76,"deletions":4,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-21T16:33:19.458571+00:00"}