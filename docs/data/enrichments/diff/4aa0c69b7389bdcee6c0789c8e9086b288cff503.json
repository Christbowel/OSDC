{"id":"4aa0c69b7389bdcee6c0789c8e9086b288cff503","axis":"silent","repo":"systemd/systemd","sha":"4aa0c69b7389bdcee6c0789c8e9086b288cff503","parsed":{"files":[{"path":"src/core/exec-credential.c","lines":["@@ -37,6 +37,8 @@"," #include \"unit.h\""," #include \"user-util.h\""," ","+#define CREDENTIALS_WORKSPACE_DIRECTORY \"systemd/temporary-credentials\"","+"," ExecSetCredential* exec_set_credential_free(ExecSetCredential *sc) {","         if (!sc)","                 return NULL;","@@ -279,6 +281,25 @@ static int get_credential_directory(","         return 1;"," }"," ","+static int get_credential_workspace(","+                const char *runtime_prefix,","+                const char *unit,","+                char **ret) {","+","+        char *p;","+","+        assert(runtime_prefix);","+        assert(unit);","+        assert(ret);","+","+        p = path_join(runtime_prefix, CREDENTIALS_WORKSPACE_DIRECTORY, unit);","+        if (!p)","+                return -ENOMEM;","+","+        *ret = p;","+        return 0;","+}","+"," int exec_context_get_credential_directory(","                 const ExecContext *context,","                 const ExecParameters *params,","@@ -298,6 +319,17 @@ int exec_context_get_credential_directory(","         return get_credential_directory(params->prefix[EXEC_DIRECTORY_RUNTIME], unit, ret);"," }"," ","+int exec_context_destroy_credentials_workspace(const char *runtime_prefix, const char *unit) {","+        _cleanup_free_ char *workspace = NULL;","+        int r;","+","+        r = get_credential_workspace(runtime_prefix, unit, &workspace);","+        if (r < 0)","+                return r;","+","+        return rm_rf(workspace, REMOVE_ROOT|REMOVE_CHMOD|REMOVE_MISSING_OK);","+}","+"," int exec_context_destroy_credentials(const ExecContext *c, const char *runtime_prefix, const char *unit) {","         _cleanup_free_ char *p = NULL;","         int r;","@@ -313,6 +345,9 @@ int exec_context_destroy_credentials(const ExecContext *c, const char *