o validate.","+\tcounts.push_back(0);","+\tcounts.push_back(65535);","+\tconst auto row_count = expected.size();","+\tauto segment = MakeRLETestSegment(db, function, counts, row_count);","+\tColumnScanState state(nullptr);","+\tsegment->InitializeScan(state);","+\tVector result(LogicalType::INTEGER, row_count + 3);","+\tauto check = [&](idx_t offset, idx_t count, idx_t expected_offset) {","+\t\tauto values = result.Values<int32_t>();","+\t\tfor (idx_t i = 0; i < count; i++) {","+\t\t\tREQUIRE(values[offset + i].GetValue() == expected[expected_offset + i]);","+\t\t}","+\t};","+","+\tSECTION(\"scan\") {","+\t\tsegment->Scan(state, row_count, result, 0, ScanVectorType::SCAN_ENTIRE_VECTOR);","+\t\tcheck(0, row_count, 0);","+\t}","+\tSECTION(\"partial scans reuse the validation frontier\") {","+\t\tconst auto first = MinValue<idx_t>(31, row_count - 1);","+\t\tsegment->Scan(state, first, result, 0, ScanVectorType::SCAN_FLAT_VECTOR);","+\t\tstate.offset_in_column = first;","+\t\tsegment->Scan(state, row_count - first, result, first, ScanVectorType::SCAN_FLAT_VECTOR);","+\t\tcheck(0, row_count, 0);","+\t}","+\tSECTION(\"selection advances over the unselected tail\") {","+\t\tSelectionVector selection(1);","+\t\tselection.set_index(0, 0);","+\t\tsegment->Select(state, row_count - 1, result, selection, 1, 0, ScanVectorType::SCAN_FLAT_VECTOR);","+\t\tcheck(0, 1, 0);","+\t\tstate.offset_in_column = row_count - 1;","+\t\tsegment->Scan(state, 1, result, 1, ScanVectorType::SCAN_FLAT_VECTOR);","+\t\tcheck(1, 1, row_count - 1);","+\t}","+\tSECTION(\"skip then scan\") {","+\t\tstate.offset_in_column = row_count - 1;","+\t\tsegment->Skip(state);","+\t\tsegment->Scan(state, 1, result, 0, ScanVectorType::SCAN_ENTIRE_VECTOR);","+\t\tcheck(0, 1, row_count - 1);","+\t}","+\tSECTION(\"filter validates the complete dictionary\") {","+\t\tauto filter = ExpressionFilter::CreateComparisonFilter(ExpressionType::COMPARE_GREATERTHAN, Value::INTEGER(0));","+\t\tauto filter_state = TableFilterState::Initialize(*con.context, *filter);","+\t\tFlatVector::SetSize(result, count_t(row_count));","+\t\tSelectionVector selection;","+\t\tidx_t selected_count = row_count;","+\t\tsegment->Filter(state, row_count, result, selection, selected_count, *filter, *filter_state);","+\t\tREQUIRE(selected_count == row_count);","+\t\tcheck(0, row_count, 0);","+\t}","+}","+","+TEST_CASE(\"Malformed RLE batches fail before unchecked run access\", \"[storage][compression][rle]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto function = RLEFun::GetFunction(PhysicalType::INT32);","+\tconst auto entries = GENERATE(31, 32, 33, 64, 65);","+\tconst auto corruption = GENERATE(0, 1, 2);","+\tvector<uint16_t> counts(entries, 1);","+\tidx_t row_count = entries + 1;","+\tif (corruption == 1) {","+\t\t// A nonnegative batch cannot hide a run exceeding the logical remainder.","+\t\tcounts[MinValue<idx_t>(31, entries - 1)] = 65535;","+\t} else if (corruption == 2) {","+\t\tstd::fill(counts.begin(), counts.end(), 0);","+\t}","+\tauto segment = MakeRLETestSegment(db, function, counts, row_count);","+\tColumnScanState state(nullptr);","+\tsegment->InitializeScan(state);","+\tVector result(LogicalType::INTEGER, row_count);","+","+\tSECTION(\"scan\") {","+\t\tREQUIRE_THROWS_AS(segment->Scan(state, row_count, result, 0, ScanVectorType::SCAN_ENTIRE_VECTOR),","+\t\t                  DataCorruptionException);","+\t}","+\tSECTION(\"partial scan\") {","+\t\tREQUIRE_THROWS_AS(segment->Scan(state, row_count, result, 0, ScanVectorType::SCAN_FLAT_VECTOR),","+\t\t                  DataCorruptionException);","+\t}","+\tSECTION(\"selection validates its unselected tail\") {","+\t\tSelectionVector selection(1);","+\t\tselection.set_index(0, 0);","+\t\tREQUIRE_THROWS_AS(segment->Select(state, row_count, result, selection, 1, 0, ScanVectorType::SCAN_FLAT_VECTOR),","+\t\t                  DataCorruptionException);","+\t}","+\tSECTION(\"skip\") {","+\t\tstate.offset_in_column = row_count;","+\t\tREQUIRE_T