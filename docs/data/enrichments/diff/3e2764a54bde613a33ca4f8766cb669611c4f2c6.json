nerInvokesCallbacks() throws Throwable {","+\t\tRetryPolicy retryPolicy = RetryPolicy.builder().maxRetries(2).delay(Duration.ZERO).build();","+\t\tObject[] arguments = new Object[] { \"message\" };","+\t\tMethodInvocation invocation = mock(MethodInvocation.class);","+\t\tgiven(invocation.getArguments()).willReturn(arguments);","+\t\tgiven(invocation.proceed()).willThrow(new IllegalStateException(\"initial\"))","+\t\t\t\t.willThrow(new IllegalStateException(\"retry-1\")).willThrow(new IllegalStateException(\"retry-2\"));","+\t\tgiven(this.recoverer.apply(eq(arguments), any())).willReturn(\"recovered\");","+\t\tAtomicInteger beforeRetryCalls = new AtomicInteger();","+\t\tAtomicInteger retryFailureCalls = new AtomicInteger();","+\t\tAtomicInteger exhaustionCalls = new AtomicInteger();","+\t\tStatelessRetryOperationsInterceptor interceptor = createInterceptor(retryPolicy);","+\t\tinterceptor.setRetryListener(new RetryListener() {","+","+\t\t\t@Override","+\t\t\tpublic void beforeRetry(RetryPolicy policy, Retryable<?> retryable, RetryState retryState) {","+\t\t\t\tbeforeRetryCalls.incrementAndGet();","+\t\t\t}","+","+\t\t\t@Override","+\t\t\tpublic void onRetryFailure(RetryPolicy policy, Retryable<?> retryable, Throwable throwable) {","+\t\t\t\tretryFailureCalls.incrementAndGet();","+\t\t\t}","+","+\t\t\t@Override","+\t\t\tpublic void onRetryPolicyExhaustion(RetryPolicy policy, Retryable<?> retryable,","+\t\t\t\t\tRetryException retryException) {","+","+\t\t\t\texhaustionCalls.incrementAndGet();","+\t\t\t}","+","+\t\t});","+\t\tassertThat(interceptor.invoke(invocation)).isEqualTo(\"recovered\");","+\t\tassertThat(beforeRetryCalls).hasValue(2);","+\t\tassertThat(retryFailureCalls).hasValue(2);","+\t\tassertThat(exhaustionCalls).hasValue(1);","+\t}","+","+\t@Test","+\tvoid invokeWithRetryListenerAppliedViaFactoryBean() throws Throwable {","+\t\tAtomicInteger exhaustionCalls = new AtomicInteger();","+\t\tStatelessRetryOperationsInterceptorFactoryBean factoryBean =","+\t\t\t