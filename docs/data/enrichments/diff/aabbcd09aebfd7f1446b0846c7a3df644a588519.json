el:list');","+","+        $output = $app->output();","+","+        $this->assertStringContainsString('orders.{order}', $output);","+        $this->assertStringContainsString('Showing [1] private channels', $output);","+    }","+","+    protected function makeApplication(array $channels): Application","+    {","+        $laravel = new FoundationApplication(__DIR__);","+","+        $broadcaster = m::mock(BroadcasterContract::class);","+        $broadcaster->shouldReceive('getChannels')->andReturn(new Collection($channels));","+","+        $laravel->instance(BroadcasterContract::class, $broadcaster);","+","+        $artisan = new Application(","+            $laravel,","+            m::mock(Dispatcher::class, ['dispatch' => null, 'fire' => null]),","+            'testing'","+        );","+","+        $command = new ChannelListCommand;","+        $command->setLaravel($laravel);","+","+        $artisan->addCommands([$command]);","+","+        return $artisan;","+    }","+}",""],"additions":63,"deletions":0,"truncated":false}],"additions":149,"deletions":43,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-08-03T11:10:36.551748+00:00"}