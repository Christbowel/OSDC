text_tag:\\n\");","+","+EXTERN_C void RhThrowEx(uintptr_t sp, Object* exception, ExInfo* pExInfo);","+EXTERN_C void RhRethrow(uintptr_t sp, ExInfo* pActiveExInfo, ExInfo* pExInfo);","+","+__attribute__((naked)) void ThrowRestoreContextTag()","+{","+    asm(\"throw __nativeaot_wasm_restore_context_tag\\n\"","+        \"unreachable\\n\" ::);","+}","+","+static uintptr_t GetFuncletAddress(void* virtualIP)","+{","+    WasmCodeManager* pCodeManager = static_cast<WasmCodeManager*>(","+        GetRuntimeInstance()->GetCodeManagerForAddress(virtualIP));","+    ASSERT(pCodeManager != nullptr);","+    return pCodeManager->GetFuncletAddress(reinterpret_cast<uintptr_t>(virtualIP));","+}","+","+// Native-stack storage for the ExInfo and throw-site context. Both remain live","+// while the managed dispatcher and funclets run, until catch resumption unwinds them.","+struct alignas(16) WasmThrowFrame","+{","+    ExInfo m_exInfo;","+    PAL_LIMITED_CONTEXT m_context;","+};","+","+// RhThrowEx/RhRethrow need a bridge at their incoming managed SP so stack walks","+// can reconnect to callerSP. Allocate it below the actual native SP to keep","+// their managed frames below all live native locals.","+static __attribute__((naked, noreturn)) void CallThrowHelper(","+    Object* exception, ExInfo* pActiveExInfo, ExInfo* pExInfo, uintptr_t callerSP, bool rethrow)","+{","+    asm(\"global.get      __stack_pointer\\n\" // Allocate space for the throw-site bridge","+        \"i32.const       %[frameSize]\\n\"","+        \"i32.sub\\n\"","+        \"global.set      __stack_pointer\\n\"","+","+        \"global.get      __stack_pointer\\n\"","+        \"i32.const       %[identity]\\n\"","+        \"i32.store       %[identityOffset]\\n\" // Mark this frame as a runtime EH bridge","+        \"global.get      __stack_pointer\\n\"","+        \"i32.const       %[throwIP]\\n\"","+        \"i32.store       %[returnIPOffset]\\n\" // Identify the throw-site thunk to stack walks","+        \"global.get      __stack_pointer\\n\"","+        \"local.get       3\\n\"","+        \"i32.store       %[callerSPOffset]\\n\" // Save the managed caller SP for unwinding through the bridge","+        \"global.get      __stack_pointer\\n\"","+        \"i32.const       0\\n\"","+        \"i32.store       %[paddingOffset]\\n\" // padding","+","+        \"local.get       4\\n\" // Select throw or rethrow dispatch","+        \"if\\n\"","+        \"global.get      __stack_pointer\\n\" // SP points to the throw-site bridge","+        \"local.get       1\\n\"               // currently active ExInfo","+        \"local.get       2\\n\"               // address of the new ExInfo","+        \"call            %[rethrowHelper]\\n\"","+        \"else\\n\"","+        \"global.get      __stack_pointer\\n\" // SP points to the throw-site bridge","+        \"local.get       0\\n\"               // exception object","+        \"local.get       2\\n\"               // address of the ExInfo","+        \"call            %[throwHelper]\\n\"","+        \"end_if\\n\"","+        \"unreachable\\n\" // no return","+        :: [frameSize] \"i\"(sizeof(WasmEHFrame)),","+           [identity] \"i\"(WasmEHFrame::Identity),","+           [throwIP] \"i\"(StackFrameIterator::ThrowSiteThunkIP),","+           [identityOffset] \"i\"(offsetof(WasmEHFrame, m_identity)),","+           [returnIPOffset] \"i\"(offsetof(WasmEHFrame, m_returnIP)),","+           [callerSPOffset] \"i\"(offsetof(WasmEHFrame, m_callerSP)),","+           [paddingOffset] \"i\"(offsetof(WasmEHFrame, m_padding)),","+           [rethrowHelper] \"i\"(RhRethrow),","+           [throwHelper] \"i\"(RhThrowEx)","+        : \"memory\");","+}","+","+static void ThrowException(uintptr_t callerSP, Object* exception, bool rethrow, bool exact)","+{","+    // Allocate space for the ExInfo and context; init the exception object to null.","+    WasmThrowFrame frame = {};","+    frame.m_context.SP = callerSP; // save the SP of the throw site","+    frame.m_context.IP = ICodeManager::GetIPFromSP(callerSP);","+    // set the exception context field on the ExInfo","+    frame.m_exInfo.m_pExContext = &frame.m_context;","+    frame.m_exInfo.m_kind =","+        rethrow ? EK_None : // init to a deterministic value (ExKind.None)","+        exact ? EK_RethrowFlag :","+        EK_Throw;","+    frame.m_exInfo.m_passNumber = 1; // init to the first pass","+    frame.m_exInfo.m_idxCurClause = UINT32_MAX; // no clause is being invoked","+    Thread* pThread = ThreadStore::GetCurrentThread();","+    ExInfo* pActiveExInfo = pThread->GetCurExInfo(); // currently active ExInfo","+    ASSERT(!rethrow || pActiveExInfo != nullptr);","+    // link the ExInfo into the thread's ExInfo chain","+    pThread->PushExInfo(&frame.m_exInfo);","+    CallThrowHelper(exception, pActiveExInfo, &frame.m_exInfo, callerSP, rethrow);","+}","+","+// These CallFunclet functions are used to call funclets from the VM.","+// They set up a new stack frame for calling a function which provides a NativeAOT EH bridge so that unwinds from the funclet reach the exception dispatcher.","+// then invoke the new funclet with SP pointing to the top of the new frame.","+// There are two versions of the function, one for funclets that need to pass a Throwable (catch/filter), and one for those that do not (finally/fault)","+// Unlike CoreCLR's terminator-only frame, the bridge records the invocation kind and managed caller SP so stack walks can continue through the dispatcher.","+__attribute__((naked)) uintptr_t CallFuncletWithThrowable(","+    uintptr_t pFuncletToInvoke, uintptr_t fp, Object* pThrowable, uintptr_t callerSP, uintptr_t returnIP)","+{","+    asm (\"global.get      __stack_pointer\\n\" // Capture original value of stack pointer","+         \"global.get      __stack_pointer\\n\" // Allocate the EH bridge below the native stack pointer.","+         \"i32.const       %[frameSize]\\n\"","+         \"i32.sub \\n\"","+         \"global.set      __stack_pointer\\n\" // Update the global stack pointer","+         \"global.get      __stack_pointer\\n\"","+         \"i32.const       %[identity]\\n\"","+         \"i32.store       %[identityOffset]\\n\" // Mark this frame as a runtime EH bridge","+         \"global.get      __stack_pointer\\n\"","+         \"local.get       4\\n\"","+         \"i32.store       %[returnIPOffset]\\n\" // Distinguish catch invocation from filter invocation","+         \"global.get      __stack_pointer\\n\"","+         \"local.get       3\\n\"","+         \"i32.store       %[callerSPOffset]\\n\" // Save the managed caller SP for unwinding through the bridge","+         \"global.get      __stack_pointer\\n\"","+         \"i32.const       0\\n\"","+         \"i32.store       %[paddingOffset]\\n\" // padding","+","+         \"global.get      __stack_pointer\\n\" // Get the stack pointer","+         \"local.get       1\\n\"               // Get the frame pointer argument for the original function","+         \"local.get       2\\n\"               // Get the exception object for the funclet","+         \"local.get       0\\n\"               // Get the funclet address to call","+         \"call_indirect    __indirect_function_table, (i32, i32, i32) -> (i32)\\n\"","+         \"local.set       0\\n\"               // Capture the return into a local so that we can return it after restoring the original stack pointer","+         \"global.set      __stack_pointer\\n\" // Restore the original stack pointer before returning to the caller of the funclet","+         \"local.get       0\\n\"               // Return the value from the funclet call","+         \"return\"","+          :: [frameSize] \"i\"(sizeof(WasmEHFrame)),","+             [identity] \"i\"(WasmEHFrame::Identity),"],"additions":159,"deletions":0,"truncated":false}],"additions":264,"deletions":110,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-10-31T14:36:50.856725+00:00"}