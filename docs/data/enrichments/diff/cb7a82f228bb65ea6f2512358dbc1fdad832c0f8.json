{"id":"cb7a82f228bb65ea6f2512358dbc1fdad832c0f8","axis":"silent","repo":"pnpm/pnpm","sha":"cb7a82f228bb65ea6f2512358dbc1fdad832c0f8","parsed":{"files":[{"path":".changeset/local-directory-yaml-manifest.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+`pnpm install` now reads a `package.yaml` or `package.json5` manifest for a `file:` directory dependency. It does the same for an injected workspace project declared by path, such as `workspace:../lib`. The dependencies of such a package were not installed. `pnpm install --frozen-lockfile` then rejected the lockfile that `pnpm install` had written."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/local_directory_manifest_formats.rs","lines":["@@ -0,0 +1,83 @@","+//! A local directory dependency is described by whichever manifest file its","+//! directory holds, and a frozen install accepts the lockfile written from it.","+","+use crate::_utils::{","+    ManifestDeps,","+    WorkspaceFixture,","+    write_manifest_value,","+};","+use serde_json::json;","+use std::{","+    fs,","+    path::Path,","+};","+","+const MANIFESTS: [(&str, &str); 2] = [","+    (\"package.yaml\", \"name: lib\\nversion: 1.0.0\\ndependencies:\\n  is-positive: 1.0.0\\n\"),","+    (\"package.json5\", \"{name: 'lib', version: '1.0.0', dependencies: {'is-positive': '1.0.0'}}\"),","+];","+","+fn write_lib(dir: &Path, (basename, contents): (&str, &str)) {","+    fs::create_dir_all(dir).expect(\"create the lib directory\");","+    fs::write(dir.join(basename), contents).expect(\"write the lib manifest\");","+    fs::write(dir.join(\"index.js\"), \"\").expect(\"write index.js\");","+}","+","+/// Installs, then installs again from the lockfile alone. `lib` must bring","+/// the dependency its manifest declares both times.","+fn assert_lib_dependency_is_installed_and_frozen(fixture: &WorkspaceFixture) {","+    let lib_dependency = || {","+        let lib = fs::canonicalize(fixture.workspace.join(\"packages/app/node_modules/lib\"))","+            .expect(\"resolve the installed lib\");","+        lib.parent()","+            .expect(\"lib sits in a node_modules directory\")","+            .join(\"is-positive\")","+            .join(\"package.json\")","+    };","+    fixture.run([\"install\"]);","+    assert!(lib_dependency().exists(), \"the install links the dependency lib declares\");","+    fs::remove_dir_all(fixture.workspace.join(\"node_modules\")).expect(\"remove node_modules\");","+    fs::remove_dir_all(fixture.workspace.join(\"packages/app/node_modules\"))","+        .expect(\"remove the project's node_modules\");","+    fixture.run([\"install\", \"--frozen-lockfile\"]);","+    assert!(lib_dependency().exists(), \"the frozen install links the dependency lib declares\");","+}","+","+#[test]","+fn a_file_directory_is_described_by_its_yaml_or_json5_manifest() {","+    for manifest in MANIFESTS {","+        let fixture = WorkspaceFixture::new();","+        fixture.write_root_manifest(\"root\", ManifestDeps::default());","+        write_lib(&fixture.workspace.join(\"lib\"), manifest);","+        fixture.project(","+            \"app\",","+            \"app\",","+            ManifestDeps { prod: &[(\"lib\", \"file:../../lib\")], ..Default::default() },","+        );","+        assert_lib_dependency_is_installed_and_frozen(&fixture);","+    }","+}","+","+/// A workspace project reached by a path gets the manifest it gets when","+/// reached by a `workspace:` range.","+#[test]","+fn an_injected_project_reached_by_path_is_described_by_its_yaml_or_json5_manifest() {","+    for manifest in MANIFESTS {","+        let fixture = WorkspaceFixture::new();","+        fixture.append_workspace_yaml(\"dedupeInjectedDeps: false\\n\");","+        fixture.write_root_manifest(\"root\", ManifestDeps::default());","+        write_lib(&fixture.workspace.join(\"packages/lib\"), manifest);","+        let app = fixture.workspace.join(\"packages/app\");","+        fs::create_dir_all(&app).expect(\"create the app directory\");","+        write_manifest_value(","+            &app,","+            &json!({","+                \"name\": \"app\",","+                \"version\": \"1.0.0\",","+                \"dependencies\": { \"lib\": \"workspace:../lib\" },","+                \"dependenciesMeta\": { \"lib\": { \"injected\": true } },","+            }),","+        );","+        assert_lib_dependency_is_installed_and_frozen(&fixture);","+    }","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -116,6 +116,7 @@ mod link;"," mod linker_parity;"," mod list;"," mod local_child_freshness;","+mod local_directory_manifest_formats;"," mod local_directory_manifest_hooks;"," mod local_directory_without_manifest;"," mod local_override_metadata_cache;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/aliasless.rs","lines":["@@ -125,6 +125,7 @@ pub(super) async fn resolve_aliasless_local(","         // `is_local_filesystem_specifier` above never claims a `workspace:`","         // spec, so this setting has nothing to apply to here.","         inject_workspace_packages: false,","+        workspace_projects: None,","     };","     let mut claimed =","         resolve_from_local_scheme(&ctx, &wanted, &opts).await.map_err(AddError::ResolveLocal)?;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/injected_manifest.rs","lines":["@@ -1,5 +1,12 @@"," use crate::install_state::ProjectManifestsByDir;"," use pnpm_package_manifest::PackageManifest;","+use pnpm_resolving_local_resolver::{","+    LocalDirectory,","+    LocalDirectoryUse,","+    PublishingProjectSearch,","+    directory_name_manifest,","+    local_directory_manifest,","+};"," use std::{","     borrow::Cow,","     path::{","@@ -59,73 +66,27 @@ pub(in crate::install::lockfile_freshness) struct InjectedDirectory<'a> {","     pub(in crate::install::lockfile_freshness) manifests_by_dir: &'a ProjectManifestsByDir<'a>,"," }"," ","-/// The manifest the resolver described the dependency with, before any hook,","-/// whichever spec declared it, in the resolver's order:","-///","-/// - the project inside the workspace that publishes from the directory","-///   (`publishConfig.directory`), so a `package.json` a build wrote there does","-///   not describe it;","-/// - the workspace project at the directory;","-/// - the directory's `package.json`;","-/// - without one, a publishing project outside the workspace, else the","-///   directory's name.","+/// The manifest [`local_directory_manifest`] describes the dependency with,","+/// before any hook, else the directory's name. `None` when a manifest fails","+/// to read, or when nothing describes the directory and it does not exist."," pub(in crate::install::lockfile_freshness) fn unhooked_manifest(","     injected: &InjectedDirectory<'_>,"," ) -> Option<PackageManifest> {","-    let workspace_root = pnpm_fs::lexical_normalize(injected.workspace_root);","-    let described = manifest_of_project_publishing_from(injected, Some(&workspace_root))","-        .or_else(|| {","-            injected.manifests_by_dir","-                .get(&pnpm_fs::lexical_normalize(injected.dir))","-                .map(|manifest| (*manifest).clone())","-        });","-    if described.is_some() {","-        return described;","-    }","-    match pnpm_workspace::safe_read_project_manifest_only(injected.dir) {","-        Ok(Some(manifest)) => Some(manifest),","-        Ok(None) => manifest_of_project_publishing_from(injected, None)","-            .or_else(|| directory_name_manifest(injected.dir)),","-        Err(_) => None,","-    }","-}","-","-/// The manifest the resolver gives an existing directory that nothing else","-/// describes: its name alone.","-fn directory_name_manifest(dir: &Path) -> Option<PackageManifest> {","-    if !dir.is_dir() {","-        return None;","-    }","-    let name = dir","-        .file_name()?","-        .to_string_lossy()","-        .into_owned();","-    Some(PackageManifest::from_value(dir.join(\"package.json\"), serde_json::json!({ \"name\": name })))","-}","-","-/// The manifest of the project whose `publishConfig.directory` is","-/// `injected.dir`, among the ancestors inside `root` when it is given: the","-/// project's entry in `manifests_by_dir` when it has one, else its","-/// `package.json`. A manifest that fails to read is no such project.","-fn manifest_of_project_publishing_from(","-    injected: &InjectedDirectory<'_>,","-    root: Option<&Path>,","-) -> Option<PackageManifest> {","-    let target = pnpm_fs::lexical_normalize(injected.dir);","-    target","-        .ancestors()","-        .skip(1)","-        .take_while(|candidate| root.is_none_or(|root| candidate.starts_with(root)))","-        .find_map(|candidate| {","-            let manifest = injected.manifests_by_dir","-                .get(candidate)","-                .map(|manifest| (*manifest).clone())","-                .or_else(|| {","-                    pnpm_workspace::safe_read_project_manifest_only(candidate).ok().flatten()","-                })?;","-            pnpm_package_manifest::publishes_from_directory(candidate, manifest.value(), &target)","-                .then_some(manifest)","-        })","+    let directory = LocalDirectory {","+        dir: injected.dir,","+        usage: LocalDirectoryUse::Copied,","+        workspace_root: injected.workspace_root,","+        project_manifest: &|dir| {","+            injected.manifests_by_dir.get(dir).map(|manifest| manifest.value())","+        },","+        publishing_project_search: PublishingProjectSearch::Anywhere,","+    };","+    let manifest = match local_directory_manifest(&directory).ok()? {","+        Some(manifest) => manifest,","+        None if injected.dir.is_dir() => directory_name_manifest(injected.dir),","+        None => return None,","+    };","+    Some(PackageManifest::from_value(injected.dir.join(\"package.json\"), manifest))"," }"," "," pub(super) fn workspace_path_matches_target("],"additions":25,"deletions":64,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/tests.rs","lines":["@@ -741,6 +741,137 @@ fn a_publish_directory_is_described_by_its_project_however_it_was_declared() {","     assert_eq!(describe(&outside_dist).value()[\"name\"], \"built\");"," }"," ","+/// A workspace with one directory per source a directory package's manifest","+/// can come from. Returns the workspace root and each directory.","+fn manifest_source_fixture(tmp: &Path) -> (PathBuf, Vec<PathBuf>) {","+    let workspace_root = tmp.join(\"ws\");","+    let write = |dir: &str, basename: &str, contents: &str| {","+        let dir = workspace_root.join(dir);","+        std::fs::create_dir_all(&dir).expect(\"create a fixture directory\");","+        std::fs::write(dir.join(basename), contents).expect(\"write a fixture manifest\");","+    };","+    write(\"json\", \"package.json\", r#\"{\"name\":\"json\",\"dependencies\":{\"dep\":\"1.0.0\"}}\"#);","+    write(\"json5\", \"package.json5\", \"{name: 'json5', dependencies: {dep: '1.0.0'}}\");","+    write(\"yaml\", \"package.yaml\", \"name: yaml\\ndependencies:\\n  dep: 1.0.0\\n\");","+    write(","+        \"publisher\",","+        \"package.json\",","+        r#\"{\"name\":\"publisher\",\"publishConfig\":{\"directory\":\"dist\"},\"dependencies\":{\"dep\":\"1.0.0\"}}\"#,","+    );","+    write(\"publisher/dist\", \"package.json\", r#\"{\"name\":\"publisher\"}\"#);","+    write(\"in-memory\", \"package.json\", r#\"{\"name\":\"in-memory\",\"version\":\"1.0.0\"}\"#);","+    write(","+        \"in-memory-publisher\",","+        \"package.json\",","+        r#\"{\"name\":\"in-memory-publisher\",\"version\":\"1.0.0\"}\"#,","+    );","+    std::fs::create_dir_all(workspace_root.join(\"in-memory-publisher/dist\"))","+        .expect(\"create the in-memory publish directory\");","+    std::fs::create_dir_all(workspace_root.join(\"unnamed\")).expect(\"create the bare directory\");","+    let directories = [","+        \"json\",","+        \"json5\",","+        \"yaml\",","+        \"publisher/dist\",","+        \"in-memory\",","+        \"in-memory-publisher/dist\",","+        \"unnamed\",","+    ];","+    (","+        workspace_root.clone(),","+        directories","+            .map(|dir| workspace_root.join(dir))","+            .to_vec(),","+    )","+}","+","+#[tokio::test]","+async fn directory_manifest_reader_agrees_across_callers() {","+    let tmp = tempfile::tempdir().expect(\"create a temporary directory\");","+    let (workspace_root, directories) = manifest_source_fixture(tmp.path());","+    let in_memory = [","+        PackageManifest::from_value(","+            workspace_root.join(\"in-memory/package.json\"),","+            serde_json::json!({","+                \"name\": \"in-memory\",","+                \"version\": \"1.0.0\",","+                \"dependencies\": { \"dep\": \"1.0.0\" },","+            }),","+        ),","+        PackageManifest::from_value(","+            workspace_root.join(\"in-memory-publisher/package.json\"),","+            serde_json::json!({","+                \"name\": \"in-memory-publisher\",","+                \"version\": \"1.0.0\",","+                \"publishConfig\": { \"directory\": \"dist\" },","+                \"dependencies\": { \"dep\": \"1.0.0\" },","+            }),","+        ),","+    ];","+    let projects: Vec<(PathBuf, &PackageManifest)> = in_memory","+        .iter()","+        .map(|manifest| {","+            (","+                manifest","+                    .path()","+                    .parent()","+                    .expect(\"project directory\")","+                    .to_path_buf(),","+                manifest,","+            )","+        })","+        .collect();","+    let workspace_packages =","+        crate::install::workspace_state::build_workspace_packages_map_from_manifests(","+            &projects, None,","+        );","+    let resolver_projects =","+        std::sync::Arc::new(pnpm_resolving_local_resolver::WorkspaceProjectManifests::new(","+            std::sync::Arc::new(workspace_packages),","+        ));","+    let manifests_by_dir = project_manifests_by_dir(in_memory.iter(), None);","+    let consumer = workspace_root.join(\"app\");","+    std::fs::create_dir_all(&consumer).expect(\"create the consumer\");","+","+    for dir in &directories {","+        let resolved = pnpm_resolving_local_resolver::resolve_from_local_scheme(","+            &pnpm_resolving_local_resolver::LocalResolverContext::default(),","+            &pnpm_resolving_local_resolver::WantedLocalDependency {","+                bare_specifier: format!(\"file:{}\", dir.display()),","+                injected: false,","+            },","+            &pnpm_resolving_local_resolver::LocalResolverOptions {","+                project_dir: consumer.clone(),","+                lockfile_dir: Some(workspace_root.clone()),","+                workspace_dir: Some(workspace_root.clone()),","+                current_pkg: None,","+                update: pnpm_resolving_local_resolver::LocalResolverUpdate::On,","+                inject_workspace_packages: false,","+                workspace_projects: Some(std::sync::Arc::clone(&resolver_projects)),","+            },","+        )","+        .await","+        .expect(\"resolve the directory\")","+        .expect(\"the local resolver claims a file: specifier\")","+        .manifest","+        .expect(\"a directory resolution carries its manifest\");","+        let checked = super::unhooked_manifest(&super::InjectedDirectory {","+            dir,","+            workspace_root: &workspace_root,","+            manifests_by_dir: &manifests_by_dir,","+        })","+        .expect(\"the check describes the directory\");","+        assert_eq!(*resolved, *checked.value(), \"the manifest of {}\", dir.dis