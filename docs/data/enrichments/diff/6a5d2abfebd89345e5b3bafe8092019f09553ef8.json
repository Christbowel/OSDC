 = &encoded_buffer_ptr[encoded_buffer.cur_pos];","++\t\tconst char *current = input + pos;","+ \t\tconst auto first = static_cast<uint8_t>(*current);","+ \t\t// Prefer the longest matching byte sequence","+ \t\tconst map_entry_encoding *match = nullptr;","+@@ -87,29 +85,46 @@ void GeneratedEncodedFunction::Decode(CSVEncoderBuffer &encoded_buffer, char *ta","+ \t\t}","+ \t\tif (!match) {","+ \t\t\t// No mapping for this byte: pass it through unchanged","+-\t\t\tencoded_buffer.cur_pos++;","+-\t\t\tif (target_buffer_current_position == target_buffer_size) {","+-\t\t\t\t// The target buffer is full: hand the byte to the next chunk instead of writing past the end","+-\t\t\t\tremaining_bytes_buffer[0] = *current;","+-\t\t\t\tremaining_bytes_size = 1;","+-\t\t\t\treturn;","+-\t\t\t}","+-\t\t\ttarget_buffer[target_buffer_current_position++] = *current;","++\t\t\toutput[out++] = *current;","++\t\t\tpos++;","+ \t\t\tcontinue;","+ \t\t}","+-\t\tencoded_buffer.cur_pos += match_len;","+-\t\tfor (idx_t byte_pos = 0; byte_pos < match->value_len; ++byte_pos) {","+-\t\t\tif (target_buffer_current_position == target_buffer_size) {","+-\t\t\t\t// The target buffer is full: store the rest of this character for the next chunk","+-\t\t\t\tremaining_bytes_size = match->value_len - byte_pos;","+-\t\t\t\tfor (idx_t remaining_pos = 0; remaining_pos < remaining_bytes_size; ++remaining_pos) {","+-\t\t\t\t\tremaining_bytes_buffer[remaining_pos] = static_cast<char>(match->value[byte_pos + remaining_pos]);","+-\t\t\t\t}","+-\t\t\t\treturn;","+-\t\t\t}","+-\t\t\ttarget_buffer[target_buffer_current_position++] = match->value[byte_pos];","+-\t\t}","++\t\tstd::memcpy(output + out, match->value, match->value_len);","++\t\tout += match->value_len;","++\t\tpos += match_len;","+ \t}","++\tconsumed = pos;","++\twritten = out;","++}","++","++static std::mutex &RegisteredLock() {","++\tstatic std::mutex lock;","++\treturn lock;","++}","++","++static std::unordered_map<string, RegisteredEncoding> &Registered