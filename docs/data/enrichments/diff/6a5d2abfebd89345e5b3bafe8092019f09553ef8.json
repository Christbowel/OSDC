nst char *value;","++} map_entry_encoding;","++","++//! A conversion table encoding. This shadows duckdb::EncodingFunction for the generated code, which describes its","++//! encodings with it. Registering one creates the scalar functions in the system.encodings schema.","++class EncodingFunction {","++public:","++\t//! Decodes with the conversion table of the encoding, see duckdb::decode_t","++\ttypedef void (*decode_table_t)(const EncodingFunction &encoding, const char *input, idx_t input_size, bool is_last,","++\t                               char *output, idx_t &consumed, idx_t &written);","++","++\tEncodingFunction(const string &name, decode_table_t decode, idx_t max_bytes_per_byte, idx_t lookup_bytes,","++\t                 const map_entry_encoding *map, idx_t map_size)","++\t    : conversion_map(map), map_size(map_size), name(name), decode(decode), max_output_bytes(max_bytes_per_byte),","++\t      lookup_bytes(lookup_bytes) {","++\t}","++","++\tconst map_entry_encoding *conversion_map;","++\tidx_t map_size;","++\tstring name;","++\tdecode_table_t decode;","++\t//! The maximum number of UTF-8 bytes produced for one input byte","++\tidx_t max_output_bytes;","++\t//! The maximum number of input bytes that make up a single character","++\tidx_t lookup_bytes;","++};","++","++//! Where the generated code registers its encodings. This shadows duckdb::DBConfig for the generated code.","++class DBConfig {","++public:","++\texplicit DBConfig(ExtensionLoader &loader) : loader(loader) {","++\t}","++","++\tvoid RegisterEncodeFunction(const EncodingFunction &function) const;","++","++private:","++\tExtensionLoader &loader;","++};","++","++//! What the extension knows about a registered encoding, beyond what its scalar functions say","++struct RegisteredEncoding {","++\tidx_t max_output_bytes = 0;","++\tidx_t map_size = 0;","++};","++//! The conversion table encoding with the given lowercase name (zeros if there is none)","++RegisteredEncoding GetRegisteredEncoding(const s