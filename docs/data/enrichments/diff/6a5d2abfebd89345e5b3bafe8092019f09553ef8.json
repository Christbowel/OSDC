p\"","+#include \"duckdb/catalog/catalog_entry/scalar_function_catalog_entry.hpp\"","+#include \"duckdb/catalog/catalog_entry/schema_catalog_entry.hpp\""," #include \"duckdb/function/encoding_function.hpp\""," #include \"duckdb/main/extension_helper.hpp\"","+#include \"duckdb/planner/expression/bound_function_expression.hpp\"","+#include \"duckdb/planner/expression/bound_reference_expression.hpp\""," "," namespace duckdb {"," ","@@ -39,21 +42,49 @@ void CSVEncoderBuffer::Reset() {"," \tactual_encoded_buffer_size = 0;"," }"," ","+static optional_ptr<ScalarFunctionCatalogEntry> FindEncoding(ClientContext &context, const string &encoding_name) {","+\t// look in the encodings schema directly: the generic lookup would autoload extensions by function name","+\tauto transaction = CatalogTransaction::GetSystemCatalogTransaction(context);","+\tauto &schema = Catalog::GetSystemCatalog(context).GetSchema(transaction, Identifier(EncodingFunction::SCHEMA));","+\tauto entry = schema.GetEntry(transaction, CatalogType::SCALAR_FUNCTION_ENTRY,","+\t                             Identifier(EncodingFunction::FunctionName(encoding_name)));","+\tif (!entry) {","+\t\treturn nullptr;","+\t}","+\treturn &entry->Cast<ScalarFunctionCatalogEntry>();","+}","+","+//! The names of all encodings: the scalar functions in the encodings schema","+static vector<string> GetLoadedEncodings(ClientContext &context) {","+\tvector<string> result {\"utf-8\"};","+\tauto &catalog = Catalog::GetSystemCatalog(context);","+\tauto &schema = catalog.GetSchema(context, Identifier(EncodingFunction::SCHEMA));","+\tschema.Scan(context, CatalogType::SCALAR_FUNCTION_ENTRY, [&](CatalogEntry &entry) {","+\t\tif (entry.type != CatalogType::SCALAR_FUNCTION_ENTRY) {","+\t\t\treturn;","+\t\t}","+\t\tresult.push_back(entry.name.GetIdentifierName());","+\t});","+\tstd::sort(result.begin(), result.end());","+\treturn result;","+}","+"," CSVEncoder::CSVEncoder(ClientContext &context_p, const string &encoding_name_to_find, idx_t buffer_size)","     : context(context_p), pass_on_byte(0) {","-\tauto &config = DBConfig::GetConfig(context_p);"," \tencoding_name = StringUtil::Lower(encoding_name_to_find);","-\tauto function = config.GetEncodeFunction(encoding_name_to_find);","-\tif (!function) {","+\tif (encoding_name == \"utf-8\") {","+\t\t// UTF-8 is read straight into the CSV buffers (see CSVFileHandle::Read), the encoder buffers are never used","+\t\treturn;","+\t}","+\tauto entry = FindEncoding(context_p, encoding_name);","+\tif (!entry) {"," \t\t// Maybe we can try to auto-load from our encodings extension, if this somehow fails, we just error."," \t\tif (Catalog::TryAutoLoad(context_p, \"encodings\")) {","-\t\t\t// If it successfully loaded, we can try to get our function again","-\t\t\tfunction = config.GetEncodeFunction(encoding_name_to_find);","+\t\t\tentry = FindEncoding(context_p, encoding_name);"," \t\t}"," \t}","-\tif (!function) {","+\tif (!entry) {"," \t\t// If at this point we still do not have a function we throw an error.","-\t\tauto loaded_encodings = config.GetLoadedEncodedFunctions();"," \t\tstd::ostringstream error;"," \t\terror << \"The CSV Reader does not support the encoding: \\\"\" << encoding_name_to_find << \"\\\"\\n\";"," \t\tif (!context_p.db->ExtensionIsLoaded(\"encodings\")) {","@@ -62,73 +93,113 @@ CSVEncoder::CSVEncoder(ClientContext &context_p, const string &encoding_name_to_"," \t\t\t      << \"\\n\";"," \t\t}"," \t\terror << \"The currently supported encodings are: \" << '\\n';","-\t\tfor (auto &encoding_function : loaded_encodings) {","-\t\t\terror << \"*  \" << encoding_function.get().GetName() << '\\n';","+\t\tfor (auto &name : GetLoadedEncodings(context_p)) {","+\t\t\terror << \"*  \" << name << '\\n';"," \t\t}"," \t\tthrow InvalidInputException(error.str());"," \t}"," ","-\tencoding_function = function;","-\tif (encoding_name == \"utf-8\") {","-\t\t// UTF-8 is read straight into the CSV buffers (see CSVFileHandle::Read), the encoder buffers are never used","-\t\treturn;","+\t// Bind the streaming overload: decode_<name>(encoded BLOB, is_last BOOLEAN)","+\tauto function = entry->functions.GetFunctionByArguments(context_p, {LogicalType::BLOB, LogicalType::BOOLEAN});","+\tvector<unique_ptr<Expression>> children;","+\tchildren.push_back(make_uniq<BoundReferenceExpression>(LogicalType::BLOB, 0));","+\tchildren.push_back(make_uniq<BoundReferenceExpression>(LogicalType::BOOLEAN, 1));","+\tdecode_expression = function->Bind(context_p, std::move(children));","+\tdecode_executor = make_uniq<ExpressionExecutor>(context_p, *decode_expression);","+\tdecode_input.Initialize(context_p, {LogicalType::BLOB, LogicalType::BOOLEAN}, 1);","+","+\tauto window = function->GetProperties().GetProperty(EncodingFunction::MINIMUM_INPUT_WINDOW_PROPERTY);","+\tif (window) {","+\t\tminimum_input_window = MaxValue<idx_t>(window->GetValue<idx_t>(), 1);"," \t}","-\t// The encoded buffer is even for the two byte lookup of utf-16, and fits a full lookup plus the probe byte","-\tconst idx_t lookup_bytes = function->GetLookupBytes();","-\tencoded_buffer.Initialize(MaxValue<idx_t>(buffer_size - buffer_size % 2, lookup_bytes + lookup_bytes % 2));","-\tremaining_bytes_buffer.Initialize(function->GetBytesPerIteration());","+\t// The encoded buffer is even for utf-16, and fits a full input window plus the probe byte","+\tencoded_buffer.Initialize(MaxValue<idx_t>(buffer_size - buffer_size % 2, 2 * minimum_input_window + 2));"," }"," "," void CSVEncoder::Reset() {"," \tencoded_buffer.Reset();"," \tencoded_buffer.last_buffer = false;","-\tremaining_bytes_buffer.Reset();","+\tpending_decoded.clear();","+\tpending_pos = 0;"," \thas_pass_on_byte = false;"," \tencoded_bytes_read = 0;"," }"," ","+idx_t CSVEncoder::Decode(const char *input, idx_t input_size, bool is_last, string &decoded) {","+\tdecode_input.Reset();","+\tdecode_input.SetChildCardinality(1);","+\tFlatVector::GetDataMutable<string_t>(decode_input.data[0])[0] =","+\t    string_t(input, UnsafeNumericCast