ion as `cast wallet owners --json` prints it.","-#[derive(Deserialize)]","-struct ConfigJson {","+/// A configuration as `cast wallet owners --json` prints it, and as `forge script` saves it for","+/// owners on other machines.","+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]","+pub struct ConfigJson {","     salt: B256,","     version: u64,","     threshold: u8,","     owners: Vec<OwnerJson>,"," }"," ","-#[derive(Deserialize)]","+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]"," struct OwnerJson {","     owner: Address,","     weight: u8,"," }"," ","+impl From<&ConfigurableAccountConfig> for ConfigJson {","+    fn from(config: &ConfigurableAccountConfig) -> Self {","+        Self {","+            salt: config.salt,","+            version: config.version,","+            threshold: config.threshold,","+            owners: config","+                .owners","+                .iter()","+                .map(|owner| OwnerJson { owner: owner.owner, weight: owner.weight })","+                .collect(),","+        }","+    }","+}","+","+impl TryFrom<ConfigJson> for ConfigurableAccountConfig {","+    type Error = eyre::Report;","+","+    /// Sorts the owners by address and validates the configuration.","+    fn try_from(json: ConfigJson) -> Result<Self> {","+        let ConfigJson { salt, version, threshold, owners } = json;","+        let mut owners = owners","+            .into_iter()","+            .map(|owner| ConfigurableAccountOwner { owner: owner.owner, weight: owner.weight })","+            .collect::<Vec<_>>();","+        owners.sort_by_key(|owner| owner.owner);","+        let config = Self { salt, version, threshold, owners };","+        config.validate().map_err(|err| eyre::eyre!(\"invalid configuration: {err}\"))?;","+        Ok(config)","+    }","+}","+"," /// Parses a configuration given as JSON, or as the path of a JSON file: `salt`, `version`,"," /// `threshold` and `owners` (each an `owner` and a `weight`), as `cast wallet owners --json`"," /// prints it, with or without its JSON envelope.","@@ -597,16 +668,23 @@ pub fn parse_config(value: &str) -> Result<ConfigurableAccountConfig> {","     if let Some(data) = json.get_mut(\"data\") {","         json = data.take();","     }","-    let ConfigJson { salt, version, threshold, owners } =","-        serde_json::from_value(json).wrap_err(\"invalid configurable account configuration\")?;","-    let mut owners = owners","-        .into_iter()","-        .map(|owner| ConfigurableAccountOwner { owner: owner.owner, weight: owner.weight })","-        .collect::<Vec<_>>();","-    owners.sort_by_key(|owner| owner.owner);","-    let config = ConfigurableAccountConfig { salt, version, threshold, owners };","-    config.validate().map_err(|err| eyre::eyre!(\"invalid configuration: {err}\"))?;","-    Ok(config)","+    serde_json::from_value::<ConfigJson>(json)","+        .wrap_err(\"invalid configurable account configuration\")?","+        .try_into()","+}","+","+/// Decodes an unsigned Tempo transaction as `cast mktx --raw-unsigned` encodes it.","+pub fn decode_unsigned_tx(bytes: &[u8]) -> Result<TempoTransaction> {","+    let Some((&TEMPO_TX_TYPE_ID, mut fields)) = bytes.split_first() else {","+        eyre::bail!(","+            \"expected an unsigned Tempo (0x76) transaction from `cast mktx --raw-unsigned`\"","+        );","+    };","+    let tx = <TempoTransaction as alloy_rlp::Decodable>::decode(&mut fields).map_err(|_| {","+        eyre::eyre!(\"invalid unsigned Tempo transaction; sponsored transactions are not supported\")","+    })?;","+    eyre::ensure!(fields.is_empty(), \"trailing bytes after the unsigned Tempo transaction\");","+    Ok(tx)"," }"," "," /// A local key that approves the transactions of the configurable accounts it owns.","@@ -639,7 +717,8 @@ impl ConfigurableAccountOwnerKey {","         }","     }"," ","-    async fn sign(&self, digest: &B256) -> Result<PrimitiveSignature> {","+    /// Approves `digest`.","+    pub async fn 