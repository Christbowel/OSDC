+/// and estimated exactly."," #[forgetest_init]"," async fn tempo_t14_script_broadcasts_as_configurable_account(prj: _, cmd: _) {","     prj.initialize_default_contracts();","@@ -10204,20 +10205,6 @@ contract CaDeployScript is Script {","         \"100\",","     ];"," ","-    // One owner does not reach the threshold.","-    cmd.forge_fuse().arg(\"script\").arg(&script).args(common).args([\"--private-key\", &keys[1]]);","-    let [low, mid, high] = [&keys[0], &keys[1], &keys[2]]","-        .map(|key| key.parse::<alloy_signer_local::PrivateKeySigner>().unwrap().address());","-    cmd.assert_failure().stderr_eq(format!(","-        \"...\\nError: {account} is a Tempo configurable account that needs owner weight 2, but the \\","-         local owner keys {mid} reach weight 1. Its owners are {low} (weight 1), {mid} (weight 1), \\","-         {high} (weight 1). forge script needs enough owner keys locally to sign as a \\","-         configurable account: pass them with --private-keys, --account, --tempo.owner or other \\","-         wallet options, or keep them in the Tempo Accounts store. Signing with owners on \\","-         separate machines is not supported yet.\\n\"","-    ));","-    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 0);","-","     cmd.forge_fuse().arg(\"script\").arg(&script).args(common).args([","         \"--private-keys\",","         &keys[2],","@@ -10282,6 +10269,7 @@ contract CaDeployScript is Script {","         \"--tempo.owner\",","         &owner,","     ];","+    let high = keys[2].parse::<PrivateKeySigner>().unwrap().address();","     let high_arg = high.to_string();","     cmd.forge_fuse().arg(\"script\").arg(&script).args(explicit).args([\"--sender\", &high_arg]);","     cmd.assert_failure().stderr_eq(format!(","@@ -10584,3 +10572,913 @@ contract UpgradedResumeScript is Script {","     }","     assert_eq!(provider.get_transaction_count(root.address()).await.unwrap(), nonce + 1);"," }","+","+/// `forge script` with one local owner of a 2-of-3 Tempo configurable account saves the account's","+/// transactions with their digests instead of sending them. An owner on another machine signs the","+/// digests with `cast wallet sign --no-hash`, and `--resume` sends the transactions in order once","+/// each is approved, with the gas limits fixed before signing. Invalid and missing approvals fail","+/// before anything is sent, and valid ones are kept across runs.","+#[forgetest_init]","+async fn tempo_t14_script_resumes_configurable_account_with_offline_owners(prj: _, cmd: _) {","+    prj.initialize_default_contracts();","+    let script = prj.add_script(","+        \"CaOffline.s.sol\",","+        r#\"","+import {Script} from \"forge-std/Script.sol\";","+import {Counter} from \"../src/Counter.sol\";","+","+contract CaOfflineScript is Script {","+    function run() external {","+        vm.startBroadcast();","+        Counter counter = new Counter();","+        counter.setNumber(41);","+        counter.increment();","+        vm.stopBroadcast();","+    }","+}","+\"#,","+    );","+    let (api, handle) =","+        spawn(NodeConfig::test_tempo().with_hardfork(Some(TempoHardfork::T14.into()))).await;","+    let rpc = handle.http_endpoint();","+    let provider = handle.http_provider();","+    let (account, config, keys) = crate::utils::tempo_two_of_three_account();","+    api.anvil_deal_tip20(","+        account,","+        foundry_common::tempo::ALPHA_USD_ADDRESS,","+        U256::from(1_000_000_000_000u64),","+    )","+    .await","+    .unwrap();","+    let account_arg = account.to_string();","+    let fee_token = foundry_common::tempo::ALPHA_USD_ADDRESS.to_string();","+    let local_owner = keys[0].parse::<PrivateKeySigner>().unwrap().address();","+    let offline_owner = keys[1].parse::<PrivateKeySigner>().unwrap().address();","+","+    // One local owner does not reach the threshold, so nothing is sent.","+    cmd.forge_fuse().arg(\"script\").arg(&script).args([","+        \"--rpc-url\",","+        rpc.as_str(),","+        \"--sender\",","+        &account_arg,","+        \"--broadcast\",","+        \"--network\",","+        \"tempo\",","+        \"--tempo.fee-token\",","+        &fee_token,","+        \"--tempo.config\",","+        &config,","+        \"--private-key\",","+        &keys[0],","+    ]);","+    let stdout = cmd.assert_success().get_output().stdout_lossy();","+    assert!(","+        stdout.contains(&format!(","+            \"Transactions of the Tempo configurable account {account} on chain 31337 await \\","+             approvals from its owners, with threshold 2:\"","+        )) && stdout.contains(\"cast wallet sign --no-hash <DIGEST>\")","+            && stdout.contains(\"--tempo.owner-signature <SIGNATURE>\")","+            && !stdout.contains(\"ONCHAIN EXECUTION COMPLETE\"),","+        \"{stdout}\"","+    );","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 0);","+","+    let sequence: Value =","+        foundry_common::fs::read_json_file(&latest_broadcast_path(prj.root())).unwrap();","+    let saved = sequence[\"awaiting_owners\"].as_array().unwrap();","+    assert_eq!(saved.len(), 3, \"{sequence}\");","+    let mut digests = Vec::new();","+    let mut unsigned_txs = Vec::new();","+    for (index, entry) in saved.iter().enumerate() {","+        assert_eq!(entry[\"index\"], index);","+        assert_eq!(entry[\"account\"].as_str().unwrap().parse::<Address>().unwrap(), account);","+        assert_eq!(entry[\"approvals\"].as_array().unwrap().len(), 1, \"{entry}\");","+        // The nonces are fixed in order, and the digest is printed for the owners.","+        let unsigned = hex::decode(entry[\"unsignedTx\"].as_str().unwrap()).unwrap();","+        let tx =","+            foundry_common::tempo::configurable_account::decode_unsigned_tx(&unsigned).unwrap();","+        assert_eq!(tx.nonce, index as u64);","+        unsigned_txs.push(tx);","+        let digest = entry[\"digest\"].as_str().unwrap().to_string();","+        assert!(","+            stdout.contains(&format!(\"digest {digest}, approved by {local_owner}\")),","+            \"{stdout}\"","+        );","+        digests.push(digest);","+    }","+","+    // The offline owner signs each digest on its own machine.","+    let sign = |cmd: &mut TestCommand, digest: &str, key: &str| {","+        cmd.cast_fuse()","+            .args([\"wallet\", \"sign\", \"--no-hash\", digest, \"--private-key\", key])","+            .assert_success()","+            .get_output()","+            .stdout_lossy()","+            .trim()","+            .to_string()","+    };","+    let approvals =","+        digests.iter().map(|digest| sign(&mut cmd, digest, &keys[1])).collect::<Vec<_>>();","+    let resume = |cmd: &mut TestCommand, signatures: &[&str]| {","+        cmd.forge_fuse().arg(\"script\").arg(&script).args([","+            \"--rpc-url\",","+            rpc.as_str(),","+            \"--resume\",","+            \"--network\",","+            \"tempo\",","+        ]);","+        for signature in signatures {","+            cmd.args([\"--tempo.owner-signature\", signature]);","+        }","+    };","+","+    // A signature by a key that is not an owner approves nothing.","+    let stranger = sign(&mut cmd, &digests[0], &format!(\"0x{}\", \"64\".repeat(32)));","+    resume(&mut cmd, &[&approvals[0], &stranger]);","+    let stderr = cmd.assert_failure().get_output().stderr_lossy();","+    assert!(","+        stderr.contains(","+            \"--tempo.owner-signature 2 is not an owner's approval of any transaction awaiting \\","+             owner approvals\"","+        ),","+        \"{stderr}\"","+    );","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 0);","+","+    // Two of the three transactions are approved: nothing is sent, but the approvals are kept.","+    resume(&mut cmd, &[&approvals[0], &approvals[1]]);","+    let stderr = cmd.assert_failure().get_output().stderr_lossy();","+    assert!(","+        stderr.contains(\"transactions await more owner approvals, so nothing was sent\")","+            && stderr.contains(&format!(","+                \"digest {}, approved by {local_owner}, {offline_owner} (weight 2 of 2)\",","+                digests[0]","+            ))","+            && stderr.contains(&format!(","+                \"digest {}, approved by {local_owner} (weight 1 of 2)\",","+                digests[2]","+            )),","+        \"{stderr}\"","+    );","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 0);","+","+    // A new broadcast does not replace the approvals collected so far.","+    cmd.forge_fuse().arg(\"script\").arg(&script).args([","+        \"--rpc-url\",","+        rpc.as_str(),","+        \"--sender\",","+        &account_arg,","+        \"--broadcast\",","+        \"--network\",","+        \"tempo\",","+        \"--tempo.fee-token\",","+        &fee_token,","+        \"--tempo.config\",","+        &config,","+        \"--private-key\",","+        &keys[0],","+    ]);","+    let stderr = cmd.assert_failure().get_output().stderr_lossy();","+    assert!(stderr.contains(\"has unfinished operations\"), \"{stderr}\");","+    let sequence: Value =","+        foundry_common::fs::read_json_file(&latest_broadcast_path(prj.root())).unwrap();","+    let counts = sequence[\"awaiting_owners\"]","+        .as_array()","+        .unwrap()","+        .iter()","+        .map(|entry| entry[\"approvals\"].as_array().unwrap().len())","+        .collect::<Vec<_>>();","+    assert_eq!(counts, [2, 2, 1]);","+","+    // The last approval completes them, and the transactions are sent in order.","+    resume(&mut cmd, &[&approvals[2]]);","+    cmd.assert_success();","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 3);","+","+    let sequence: Value =","+        foundry_common::fs::read_json_file(&latest_broadcast_path(prj.root())).unwrap();","+    let receipts = sequence[\"receipts\"].as_array().unwrap();","+    assert_eq!(receipts.len(), 3);","+    for (receipt, unsigned) in receipts.iter().zip(unsigned_txs) {","+        assert_eq!(receipt[\"status\"], \"0x1\", \"{receipt}\");","+        assert_eq!(receipt[\"from\"].as_str().unwrap().parse::<Address>().unwrap(), account);","+        let hash = receipt[\"transactionHash\"].as_str().unwrap().parse::<B256>().unwrap();","+        let raw = provider","+            .raw_request::<_, Bytes>(\"eth_getRawTransactionByHash\".into(), (hash,))","+            .await","+            .unwrap();","+        let TempoTxEnvelope::AA(signed) = TempoTxEnvelope::decode_2718_exact(&raw).unwrap() else {","+            panic!(\"expected a Tempo transaction\");","+        };","+        // The owners approved exactly the transaction that was sent.","+        assert_eq!(*signed.tx(), unsigned);","+        let signature = signed.signature().as_configurable_account().expect(\"a 0x05 signature\");","+        assert_eq!(signature.signatures().len(), 2);","+    }","+}","+","+/// Transactions that owners on other machines approved are only sent in order: once one of them","+/// reverts, `--resume` refuses to send the ones after it, as for any other script transaction.","+#[forgetest_init]","+async fn tempo_t14_script_offline_owner_approvals_stop_at_revert(prj: _, cmd: _) {","+    let script = prj.add_script(","+        \"CaPing.s.sol\",","+        r#\"","+import {Script} from \"forge-std/Script.sol\";","+","+contract CaPingScript is Script {","+    function run() external {","+        vm.startBroadcast();","+        (bool ok,) = address(0xC0FFEE).call(\"\");","+        (ok,) = address(0xC0FFEE).call(\"\");","+        vm.stopBroadcast();","+    }","+}","+\"#,","+    );","+    let (api, handle) =","+        spawn(NodeConfig::test_tempo().with_hardfork(Some(TempoHardfork::T14.into()))).await;","+    let rpc = handle.http_endpoint();","+    let provider = handle.http_provider();","+    let target = address!(\"0x0000000000000000000000000000000000C0FFEE\");","+    // `STOP`, so that every call succeeds.","+    api.anvil_set_code(target, bytes!(\"00\")).await.unwrap();","+    let (account, config, keys) = crate::utils::tempo_two_of_three_account();","+    api.anvil_deal_tip20(","+        account,","+        foundry_common::tempo::ALPHA_USD_ADDRESS,","+        U256::from(1_000_000_000_000u64),","+    )","+    .await","+    .unwrap();","+    let fee_token = foundry_common::tempo::ALPHA_USD_ADDRESS.to_string();","+    cmd.forge_fuse().arg(\"script\").arg(&script).args([","+        \"--rpc-url\",","+        rpc.as_str(),","+        \"--sender\",","+        &account.to_string(),","+        \"--broadcast\",","+        \"--network\",","+        \"tempo\",","+        \"--tempo.fee-token\",","+        &fee_token,","+        \"--tempo.config\",","+        &config,","+        \"--private-key\",","+        &keys[0],","+    ]);","+    cmd.assert_success();","+    let sequence: Value =","+        foundry_common::fs::read_json_file(&latest_broadcast_path(prj.root())).unwrap();","+    let approvals = sequence[\"awaiting_owners\"]","+        .as_array()","+        .unwrap()","+        .iter()","+        .map(|entry| {","+            cmd.cast_fuse()","+                .args([\"wallet\", \"sign\", \"--no-hash\", entry[\"digest\"].as_str().unwrap()])","+                .args([\"--private-key\", &keys[1]])","+                .assert_success()","+                .get_output()","+                .stdout_lossy()","+                .trim()","+                .to_string()","+        })","+        .collect::<Vec<_>>();","+    assert_eq!(approvals.len(), 2);","+","+    // The first transaction now reverts.","+    api.anvil_set_code(target, bytes!(\"5f5ffd\")).await.unwrap();","+    let resume = |cmd: &mut TestCommand| {","+        cmd.forge_fuse().arg(\"script\").arg(&script).args([","+            \"--rpc-url\",","+            rpc.as_str(),","+            \"--resume\",","+            \"--network\",","+            \"tempo\",","+        ]);","+    };","+    resume(&mut cmd);","+    for approval in &approvals {","+        cmd.args([\"--tempo.owner-signature\", approval]);","+    }","+    cmd.assert_failure();","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 1);","+","+    resume(&mut cmd);","+    let stderr = cmd.assert_failure().get_output().stderr_lossy();","+    assert!(stderr.contains(\"resume will not send them\"), \"{stderr}\");","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 1);","+}","+","+/// `--broadcast` refuses to save a configurable account's transactions for owners on other","+/// machines with the expiring nonce key, whose deadline would pass before they approve. `--resume`","+/// checks again transactions that an earlier resume signed but did not send: here a missing","+/// wallet stops the first resume, and the later ones fail before sending anything once the","+/// transaction's deadline passes and once the account spends its nonce.","+#[forgetest_init]","+async fn tempo_t14_script_offline_owner_approvals_revalidated_on_resume(prj: _, cmd: _) {","+    let script = prj.add_script(","+        \"CaThenEoa.s.sol\",","+        r#\"","+import {Script} from \"forge-std/Script.sol\";","+","+contract CaThenEoaScript is Script {","+    function run() external {","+        vm.startBroadcast();","+        (bool ok,) = address(0xC0FFEE).call(\"\");","+        vm.stopBroadcast();","+        vm.startBroadcast(vm.envAddress(\"CA_EOA\"));","+        (ok,) = address(0xC0FFEE).call(\"\");","+        vm.stopBroadcast();","+    }","+}","+\"#,","+    );","+    let (api, handle) =","+        spawn(NodeConfig::test_tempo().with_hardfork(Some(TempoHardfork::T14.into()))).await;","+    let rpc = handle.http_endpoint();","+    let provider = handle.http_provider();","+    let target = address!(\"0x0000000000000000000000000000000000C0FFEE\");","+    api.anvil_set_code(target, bytes!(\"00\")).await.unwrap();","+    let (account, config, keys) = crate::utils::tempo_two_of_three_account();","+    let eoa_key = format!(\"0x{}\", \"65\".repeat(32));","+    let eoa = eoa_key.parse::<PrivateKeySigner>().unwrap().address();","+    for funded in [account, eoa] {","+        api.anvil_deal_tip20(","+            funded,","+            foundry_common::tempo::ALPHA_USD_ADDRESS,","+            U256::from(1_000_000_000_000u64),","+        )","+        .await","+        .unwrap();","+    }","+    let fee_token = foundry_common::tempo::ALPHA_USD_ADDRESS.to_string();","+    let account_arg = account.to_string();","+    let broadcast = [","+        \"--rpc-url\",","+        rpc.as_str(),","+        \"--sender\",","+        &account_arg,","+        \"--broadcast\",","+        \"--network\",","+        \"tempo\",","+        \"--tempo.fee-token\",","+        &fee_token,","+        \"--tempo.config\",","+        &config,","+        \"--private-keys\",","+        &keys[0],","+        \"--private-keys\",","+        &eoa_key,","+    ];","+","+    let expiring_key = format!(\"{:#x}\", U256::MAX);","+    for expiring in [","+        &[\"--tempo.expires\", \"300\"][..],","+        &[\"--tempo.nonce-key\", &expiring_key, \"--tempo.valid-before\", \"4102444800\"],","+    ] {","+        cmd.forge_fuse().arg(\"script\").arg(&script).args(broadcast).args(expiring);","+        cmd.env(\"CA_EOA\", eoa.to_string());","+        cmd.assert_failure().stderr_eq(str![[r#\"","+...","+Error: the owners of a Tempo configurable account sender approve its transactions on other machines, so they cannot be sponsored with --tempo.sponsor or use the expiring nonce key (--tempo.expiring-nonce, --tempo.expires or --tempo.nonce-key 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff), whose validity window is too short for them","+","+\"#]]);","+    }","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 0);","+","+    // A deadline of another nonce key is kept, and checked when resuming.","+    let latest = provider.get_block_by_number(\"latest\".parse().unwrap()).await.unwrap().unwrap();","+    let valid_before = latest.header.timestamp + 3600;","+    cmd.forge_fuse().arg(\"script\").arg(&script).args(broadcast);","+    cmd.args([\"--tempo.valid-before\", &valid_before.to_string()]);","+    cmd.env(\"CA_EOA\", eoa.to_string());","+    cmd.assert_success();","+    let sequence: Value =","+        foundry_common::fs::read_json_file(&latest_broadcast_path(prj.root())).unwrap();","+    let digest = sequence[\"awaiting_owners\"][0][\"digest\"].as_str().unwrap().to_string();","+    let approval = cmd","+        .cast_fuse()","+        .args([\"wallet\", \"sign\", \"--no-hash\", &digest, \"--private-key\", &keys[1]])","+        .assert_success()","+        .get_output()","+        .stdout_lossy()","+        .trim()","+        .to_string();","+","+    // The approvals complete the account's transaction, but the EOA has no wallet. Repeating","+    // the same command fails the same way, with the approvals kept.","+    let first_resume = [","+        \"--rpc-url\",","+        rpc.as_str(),","+        \"--resume\",","+        \"--network\",","+        \"tempo\",","+        \"--tempo.owner-signature\",","+        &approval,","+    ];","+    for _ in 0..2 {","+        cmd.forge_fuse().arg(\"script\").arg(&script).args(first_resume);","+        cmd.env(\"CA_EOA\", eoa.to_string());","+        cmd.assert_failure().stderr_eq(format!(","+            \"Error: No associated wallet for addresses: [{}]. Unlocked wallets: []\\n\",","+            eoa.to_string().to_lowercase()","+        ));","+    }","+    assert_eq!(provider.get_transaction_count(account).await.unwrap(), 0);","+","+    // Once the deadline passes, the same `--resume` with the local owner saves the transaction","+    // again for the owners, with a new digest, and sends nothing.","+    api.evm_increase_time(U256::from(7200)).await.unwrap();","+    api.mine_one().await.unwrap();","+    let resume = ["],"additions":424,"deletions":15,"truncated":false}],"additions":528,"deletions