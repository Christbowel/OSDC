e(svc *port.Service) *xmlService {"," \t}"," }"," ","+func newXMLExtraPorts(state, reason string, count int) xmlExtraPorts {","+\treturn xmlExtraPorts{State: state, Count: count, Reasons: []xmlExtraReason{{Reason: reason, Count: count}}}","+}","+"," // writeNmapXML renders hosts as an nmap-compatible XML document."," func writeNmapXML(w io.Writer, hosts []nmapHostData, scanType string, start, end time.Time) error {"," \trun := xmlRun{","@@ -170,6 +189,8 @@ func writeNmapXML(w io.Writer, hosts []nmapHostData, scanType string, start, end"," \t\thostReason := \"user-set\""," \t\tif len(h.ports) > 0 {"," \t\t\thostReason = \"syn-ack\"","+\t\t} else if len(h.closed) > 0 {","+\t\t\thostReason = reasonReset"," \t\t}"," \t\txh := xmlHost{"," \t\t\tStatus:    xmlStatus{State: \"up\", Reason: hostReason},","@@ -181,8 +202,14 @@ func writeNmapXML(w io.Writer, hosts []nmapHostData, scanType string, start, end"," \t\tif h.hostname != \"\" && h.hostname != h.ip {"," \t\t\txh.Hostnames = &xmlHostnames{Hostnames: []xmlHostname{{Name: h.hostname, Type: \"user\"}}}"," \t\t}","-\t\tif len(h.ports) > 0 {","+\t\tif len(h.ports) > 0 || len(h.closed) > 0 || h.filtered > 0 {"," \t\t\txp := &xmlPorts{}","+\t\t\tif h.filtered > 0 {","+\t\t\t\txp.Extra = append(xp.Extra, newXMLExtraPorts(stateFiltered, reasonNoReply, h.filtered))","+\t\t\t}","+\t\t\tif len(h.closed) > collapseThreshold {","+\t\t\t\txp.Extra = append(xp.Extra, newXMLExtraPorts(stateClosed, reasonReset, len(h.closed)))","+\t\t\t}"," \t\t\tfor _, p := range h.ports {"," \t\t\t\t// nmap reports the probe that elicited the reply; a UDP open port"," \t\t\t\t// is confirmed by a udp-response, not a syn-ack.","@@ -193,10 +220,20 @@ func writeNmapXML(w io.Writer, hosts []nmapHostData, scanType string, start, end"," \t\t\t\txp.Ports = append(xp.Ports, xmlPort{"," \t\t\t\t\tProtocol: p.Protocol.String(),"," \t\t\t\t\tPortID:   p.Port,","-\t\t\t\t\tState:    xmlPortState{State: \"open\", Reason: reason},","+\t\t\t\t\tState:    xmlPortState{State: stateOpen, Reason: reason},"," \t\t\t\t\tService:  newXMLService(p.Service),"," \t\t\t\t})"," \t\t\t}","+\t\t\tif len(h.closed) <= collapseThreshold {","+\t\t\t\tfor _, p := range h.closed {","+\t\t\t\t\txp.Ports = append(xp.Ports, xmlPort{","+\t\t\t\t\t\tProtocol: p.Protocol.String(),","+\t\t\t\t\t\tPortID:   p.Port,","+\t\t\t\t\t\tState:    xmlPortState{State: stateClosed, Reason: reasonReset},","+\t\t\t\t\t})","+\t\t\t\t}","+\t\t\t\tsort.SliceStable(xp.Ports, func(i, j int) bool { return xp.Ports[i].PortID < xp.Ports[j].PortID })","+\t\t\t}"," \t\t\txh.Ports = xp"," \t\t}"," \t\trun.Hosts = append(run.Hosts, xh)","@@ -241,13 +278,17 @@ func writeGreppable(w io.Writer, hosts []nmapHostData, start, end time.Time) err"," \t\tif name == \"\" {"," \t\t\tname = h.ip"," \t\t}","-\t\tif len(h.ports) == 0 {","+\t\tif len(h.ports) == 0 && len(h.closed) == 0 && h.filtered <= 0 {"," \t\t\tif _, err := fmt.Fprintf(w, \"Host: %s (%s)\\tStatus: Up\\n\", h.ip, name); err != nil {"," \t\t\t\treturn err"," \t\t\t}"," \t\t\tcontinue"," \t\t}","-\t\tvar parts []string","+\t\ttype entry struct {","+\t\t\tport int","+\t\t\ttext string","+\t\t}","+\t\tvar entries []entry"," \t\tfor _, p := range h.ports {"," \t\t\tsvcName := \"\""," \t\t\tversion := \"\"","@@ -256,9 +297,29 @@ func writeGreppable(w io.Writer, hosts []nmapHostData, start, end time.Time) err"," \t\t\t\tversion = grepSanitize(strings.TrimSpace(p.Service.Product + \" \" + p.Service.Version))"," \t\t\t}"," \t\t\t// portid/state/protocol/owner/service/rpc/version","-\t\t\tparts = append(parts, fmt.Sprintf(\"%d/open/%s//%s//%s/\", p.Port, p.Protocol.String(), svcName, version))","+\t\t\tentries = append(entries, entry{p.Port, fmt.Sprintf(\"%d/open/%s//%s//%s/\", p.Port, p.Protocol.String(), svcName, version)})"," \t\t}","-\t\tif _, err := fmt.Fprintf(w, \"Host: %s (%s)\\tPorts: %s\\n\", h.ip, name, strings.Join(parts, \", \")); err != nil {","+\t\tignoredState, ignored := stateFiltered, h.filtered","+\t\t// Greppable output has room for one ignored state. Filtered takes it","+\t\t// whenever there is any, since it can only be a count; closed ports","+\t\t// are then listed.","+\t\tif h.filtered == 0 && len(h.closed) > collapseThreshold {","+\t\t\tignoredState, ignored = stateClosed, len(h.closed)","+\t\t} else {","+\t\t\tfor _, p := range h.closed {","+\t\t\t\tentries = append(entries, entry{p.Port, fmt.Sprintf(\"%d/closed/%s/////\", p.Port, p.Protocol.String())})","+\t\t\t}","+\t\t}","+\t\tsort.SliceStable(entries, func(i, j int) bool { return entries[i].port < entries[j].port })","+\t\tparts := make([]string, 0, len(entries))","+\t\tfor _, e := range entries {","+\t\t\tparts = append(parts, e.text)","+\t\t}","+\t\tline := fmt.Sprintf(\"Host: %s (%s)\\tPorts: %s\", h.ip, name, strings.Join(parts, \", \"))","+\t\tif ignored > 0 {","+\t\t\tline += fmt.Sprintf(\"\\tIgnored State: %s (%d)\", ignoredState, ignored)","+\t\t}","+\t\tif _, err := fmt.Fprintln(w, line); err != nil {"," \t\t\treturn err"," \t\t}"," \t}","@@ -299,6 +360,7 @@ func (r *Runner) collectNmapHosts(scanResults *result.Result) []nmapHostData {"," \t\t\t})"," \t\t}"," \t}","+\thosts = r.addPortStates(hosts, r.portStates(scanResults))"," \t// The result store is map-backed, so host and port order is otherwise random"," \t// per run; sort for reproducible output (and to match nmap's ordering)."," \tsort.Slice(hosts, func(i, j int) bool {","@@ -307,6 +369,28 @@ func (r *Runner) collectNmapHosts(scanResults *result.Result) []nmapHostData {"," \treturn hosts"," }"," ","+// addPortStates merges -port-state results into hosts, adding the hosts that","+// answered only with resets.","+func (r *Runner) addPortStates(hosts []nmapHostData, states map[string]hostPortStates) []nmapHostData {","+\tindex := make(map[string]int, len(hosts))","+\tfor i, h := range hosts {","+\t\tindex[h.ip] = i","+\t}","+\tfor ip, s := range states {","+\t\tif !ipMatchesIpVersions(ip, r.options.IPVersion...) {","+\t\t\tcontinue","+\t\t}","+\t\ti, ok := index[ip]","+\t\tif !ok {","+\t\t\thosts = append(hosts, nmapHostData{ip: ip, hostname: r.primaryHostname(ip)})","+\t\t\ti = len(hosts) - 1","+\t\t}","+\t\thosts[i].closed = s.closed","+\t\thosts[i].filtered = max(s.filtered, 0)","+\t}","+\treturn hosts","+}","+"," // sortedPorts returns a copy of ports ordered by (port, protocol) so the output"," // is deterministic without mutating the shared result store."," func sortedPorts(ports []*port.Port) []*port.Port {"],"additions":91,"deletions":7,"truncated":false},{"path":"pkg/runner/portstate.go","lines":["@@ -0,0 +1,174 @@","+package runner","+","+import (","+\t\"bytes\"","+\t\"encoding/csv\"","+\t\"fmt\"","+\t\"os\"","+\t\"sort\"","+\t\"time\"","+","+\t\"github.com/projectdiscovery/gologger\"","+\t\"github.com/projectdiscovery/naabu/v2/pkg/port\"","+\t\"github.com/projectdiscovery/naabu/v2/pkg/protocol\"","+\t\"github.com/projectdiscovery/naabu/v2/pkg/result\"","+)","+","+// Port states and reasons, named as nmap names them.","+const (","+\tstateOpen     = \"open\"","+\tstateClosed   = \"closed\"","+\tstateFiltered = \"filtered\"","+\treasonReset   = \"reset\"","+\treasonNoReply = \"no-response\"","+\t// nmap lists a state port by port up to this many ports per host and","+\t// collapses it into a count above it.","+\tcollapseThreshold = 25","+)","+","+// hostPortStates is what -port-state adds to a host: its closed ports and how","+// many probed tcp ports never answered. filtered is -1 when it is unknown.","+type hostPortStates struct {","+\tclosed   []*port.Port","+\tfiltered int","+}","+","+// enableFilteredCount turns on the filtered count when every host was probed","+// on the same port list. Smart scan picks ports per host, ip:port targets","+// probe only their own port and a shard probes a slice of the (host, port)","+// space, so any of them would make the count wrong.","+func (r *Runner) enableFilteredCount(targetsWithPort []string) {","+\tr.countFiltered = r.options.PortState && !r.options.SmartScan && len(targetsWithPort) == 0 && r.options.ShardTotal <= 1","+}","+","+// portStates returns the -port-state view of every host with an open or","+// closed tcp port, keyed by ip. It is nil unless -port-state is set.","+func (r *Runner) portStates(scanResults *result.Result) map[string]hostPortStates {","+\tif !r.options.PortState {","+\t\treturn nil","+\t}","+\tr.portStatesMu.Lock()","+\tdefer r.portStatesMu.Unlock()","+\tif r.portStatesFor != scanResults {","+\t\tr.portStatesCache = r.computePortStates(scanResults)","+\t\tr.portStatesFor = scanResults","+\t}","+\treturn r.portStatesCache","+}","+","+func (r *Runner) computePortStates(scanResults *result.Result) map[string]hostPortStates {","+\tstates := make(map[string]hostPortStates)","+\tfor ip, ports := range scanResults.GetClosedPorts() {","+\t\tstates[ip] = hostPortStates{closed: sortedPorts(ports), filtered: -1}","+\t}","+\tif !r.countFiltered {","+\t\treturn states","+\t}","+\topenCounts := scanResults.GetTCPPortCounts()","+\tfor ip := range openCounts {","+\t\tif _, ok := states[ip]; !ok {","+\t\t\tstates[ip] = hostPortStates{filtered: -1}","+\t\t}","+\t}","+\tallTCP, webTCP := r.probedTCPPorts()","+\tfor ip, s := range states {","+\t\t// -port-threshold stops probing a host early, so its silent ports","+\t\t// were not all probed.","+\t\tif scanResults.HasSkipped(ip) {","+\t\t\tcontinue","+\t\t}","+\t\tprobed := allTCP","+\t\t// Port 0 passes only for hosts the CDN rule leaves unrestricted.","+\t\tif !r.canIScanIfCDN(ip, &port.Port{}) {","+\t\t\tprobed = webTCP","+\t\t}","+\t\tif answered := len(s.closed) + openCounts[ip]; probed >= answered {","+\t\t\ts.filtered = probed - answered","+\t\t\tstates[ip] = s","+\t\t}","+\t}","+\treturn states","+}","+","+// probedTCPPorts counts the tcp ports in the scan list, and those of them a","+// CDN host is still probed on (see canIScanIfCDN).","+func (r *Runner) probedTCPPorts() (all, web int) {","+\tfor _, p := range r.scanner.Ports {","+\t\tif p.Protocol != protocol.TCP {","+\t\t\tcontinue","+\t\t}","+\t\tall++","+\t\tif p.Port == 80 || p.Port == 443 {","+\t\t\tweb++","+\t\t}","+\t}","+\treturn all, web","+}","+","+// outputPortStates logs closed and filtered counts per host and, in JSON and","+// CSV modes, writes one closed record per port. Plain stdout stays open-only,","+// so piping naabu into other tools is unchanged.","+func (r *Runner) outputPortStates(states map[string]hostPortStates, file *os.File, stdoutHeader, fileHeader *bool) {","+\tips := make([]string, 0, len(states))","+\tfor ip := range states {","+\t\tif ipMatchesIpVersions(ip, r.options.IPVersion...) {","+\t\t\tips = append(ips, ip)","+\t\t}","+\t}","+\tsort.Slice(ips, func(i, j int) bool { return compareIPStrings(ips[i], ips[j]) < 0 })","+","+\tfor _, ip := range ips {","+\t\ts := states[ip]","+\t\thosts, _ := r.hostsForIP(ip)","+\t\tif len(hosts) == 0 {","+\t\t\thosts = []string{ip}","+\t\t}","+\t\tfor _, host := range hosts {","+\t\t\tif host == \"ip\" {","+\t\t\t\thost = ip","+\t\t\t}","+\t\t\tif s.filtered >= 0 {","+\t\t\t\tgologger.Info().Msgf(\"Found %d closed and %d filtered ports on host %s (%s)\\n\", len(s.closed), s.filtered, host, ip)","+\t\t\t} else {","+\t\t\t\tgologger.Info().Msgf(\"Found %d closed ports on host %s (%s)\\n\", len(s.closed), host, ip)","+\t\t\t}","+\t\t\tif (!r.options.JSON && !r.options.CSV) || len(s.closed) == 0 {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif !r.options.DisableStdout {","+\t\t\t\tgologger.Silent().Msgf(\"%s\", r.closedRecords(host, ip, s.closed, stdoutHeader))","+\t\t\t}","+\t\t\tif file != nil {","+\t\t\t\tif _, err := file.WriteString(r.closedRecords(host, ip, s.closed, fileHeader)); err != nil {","+\t\t\t\t\tgologger.Error().Msgf(\"Could not write closed ports of %s to file: %s\\n\", ip, err)","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}","+","+func (r *Runner) closedRecords(host, ip string, closed []*port.Port, csvHeader *bool) string {","+\tvar buffer bytes.Buffer","+\twriter := csv.NewWriter(&buffer)","+\tfor _, p := range closed {","+\t\tdata := &Result{IP: ip, Port: p.Port, Protocol: p.Protocol.String(), State: stateClosed, TimeStamp: time.Now().UTC()}","+\t\tif host != ip {","+\t\t\tdata.Host = host","+\t\t}","+\t\tif r.options.JSON {","+\t\t\tb, err := data.JSON(r.options.ExcludeOutputFields)","+\t\t\tif err != nil {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\t_, _ = fmt.Fprintf(&buffer, \"%s\\n\", b)","+\t\t\tcontinue","+\t\t}","+\t\tif *csvHeader {","+\t\t\twriteCSVHeaders(data, writer, r.options.ExcludeOutputFields)","+\t\t\t*csvHeader = false","+\t\t}","+\t\twriteCSVRow(data, writer, r.options.ExcludeOutputFields)","+\t}","+\twriter.Flush()","+\treturn buffer.String()","+}"],"additions":174,"deletions":0,"truncated":false},{"path":"pkg/runner/portstate_test.go","lines":["@@ -0,0 +1,183 @@","+package runner","+","+import (","+\t\"bytes\"","+\t\"context\"","+\t\"encoding/json\"","+\t\"encoding/xml\"","+\t\"net\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/projectdiscovery/naabu/v2/pkg/port\"","+\t\"github.com/projectdiscovery/naabu/v2/pkg/protocol\"","+\t\"github.com/projectdiscovery/naabu/v2/pkg/result\"","+\t\"github.com/projectdiscovery/ratelimit\"","+\t\"github.com/remeh/sizedwaitgroup\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func tcpPorts(nums ...int) []*port.Port {","+\tports := make([]*port.Port, 0, len(nums))","+\tfor _, n := range nums {","+\t\tports = append(ports, &port.Port{Port: n, Protocol: protocol.TCP})","+\t}","+\treturn ports","+}","+","+func portRange(from, to int) []int {","+\tvar nums []int","+\tfor n := from; n <= to; n++ {","+\t\tnums = append(nums, n)","+\t}","+\treturn nums","+}","+","+func TestPortStatesCountsFiltered(t *testing.T) {","+\trunner := newConnectRunner(t)","+\trunner.options.PortState = true","+\trunner.scanner.Ports = append(tcpPorts(22, 80, 443, 8080), &port.Port{Port: 53, Protocol: protocol.UDP})","+\trunner.enableFilteredCount(nil)","+","+\tres := result.NewResult()","+\tres.AddPort(\"203.0.113.7\", &port.Port{Port: 80, Protocol: protocol.TCP})","+\tres.AddClosedPort(\"203.0.113.7\", &port.Port{Port: 22, Protocol: protocol.TCP})","+\tres.AddClosedPort(\"203.0.113.8\", &port.Port{Port: 443, Protocol: protocol.TCP})","+\tres.AddPort(\"203.0.113.9\", &port.Port{Port: 80, Protocol: protocol.TCP})","+\tres.AddSkipped(\"203.0.113.9\")","+","+\tstates := runner.portStates(res)","+\trequire.Len(t, states, 3)","+\trequire.Equal(t, 2, states[\"203.0.113.7\"].filtered, \"4 tcp probes, 1 open, 1 closed\")","+\trequire.Len(t, states[\"203.0.113.7\"].closed, 1)","+\trequire.Equal(t, 3, states[\"203.0.113.8\"].filtered)","+\trequire.Equal(t, -1, states[\"203.0.113.9\"].filtered, \"a -port-threshold host was not fully probed\")","+}","+","+func TestPortStatesFilteredUnknown(t *testing.T) {","+\tfor name, setup := range map[string]func(r *Runner){","+\t\t\"smart scan\":      func(r *Runner) { r.options.SmartScan = true; r.enableFilteredCount(nil) },","+\t\t\"ip:port targets\": func(r *Runner) { r.enableFilteredCount([]string{\"203.0.113.7:80\"}) },","+\t\t\"shard\":           func(r *Runner) { r.options.ShardTotal = 2; r.enableFilteredCount(nil) },","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\trunner := newConnectRunner(t)","+\t\t\trunner.options.PortState = true","+\t\t\tsetup(runner)","+","+\t\t\tres := result.NewResult()","+\t\t\tres.AddPort(\"203.0.113.7\", &port.Port{Port: 80, Protocol: protocol.TCP})","+\t\t\tres.AddClosedPort(\"203.0.113.8\", &port.Port{Port: 22, Protocol: protocol.TCP})","+","+\t\t\tstates := runner.portStates(res)","+\t\t\trequire.Len(t, states, 1, \"only hosts with closed ports are reported\")","+\t\t\trequire.Equal(t, -1, states[\"203.0.113.8\"].filtered)","+\t\t})","+\t}","+}","+","+func TestPortStatesOff(t *testing.T) {","+\trunner := newConnectRunner(t)","+\tres := result.NewResult()","+\tres.AddClosedPort(\"203.0.113.8\", &port.Port{Port: 22, Protocol: protocol.TCP})","+\trequire.Nil(t, runner.portStates(res))","+}","+","+func TestWriteNmapXMLPortStates(t *testing.T) {","+\thosts := []nmapHostData{","+\t\t{ip: \"203.0.113.7\", ports: tcpPorts(80), closed: tcpPorts(22, 443), filtered: 997},","+\t\t{ip: \"203.0.113.8\", closed: tcpPorts(portRange(1, collapseThreshold+1)...)},","+\t}","+\tvar buf bytes.Buffer","+\tstart := time.Unix(1_700_000_000, 0)","+\trequire.NoError(t, writeNmapXML(&buf, hosts, SynScan, start, start.Add(time.Second)))","+","+\tvar run xmlRun","+\trequire.NoError(t, xml.Unmarshal(buf.Bytes(), &run))","+\trequire.Len(t, run.Hosts, 2)","+","+\tlisted := run.Hosts[0].Ports","+\trequire.Equal(t, []xmlExtraPorts{newXMLExtraPorts(\"filtered\", \"no-response\", 997)}, listed.Extra)","+\trequire.Len(t, listed.Ports, 3)","+\trequire.Equal(t, xmlPortState{State: \"closed\", Reason: \"reset\"}, listed.Ports[0].State, \"ports sort by number\")","+\trequire.Equal(t, \"open\", listed.Ports[1].State.State)","+\trequire.Equal(t, \"closed\", listed.Ports[2].State.State)","+","+\tcollapsed := run.Hosts[1]","+\trequire.Equal(t, \"reset\", collapsed.Status.Reason)","+\trequire.Empty(t, collapsed.Ports.Ports)","+\trequire.Equal(t, []xmlExtraPorts{newXMLExtraPorts(\"closed\", \"reset\", collapseThreshold+1)}, collapsed.Ports.Extra)","+}","+","+func TestWriteGreppablePortStates(t *testing.T) {","+\thosts := []nmapHostData{","+\t\t{ip: \"203.0.113.7\", ports: tcpPorts(80), closed: tcpPorts(22), filtered: 997},","+\t\t{ip: \"203.0.113.8\", closed: tcpPorts(portRange(1, collapseThreshold+1)...), filtered: 3},","+\t\t{ip: \"203.0.113.9\", closed: tcpPorts(portRange(1, collapseThreshold+1)...)},","+\t}","+\tvar buf bytes.Buffer","+\tstart := time.Unix(1_700_000_000, 0)","+\trequire.NoError(t, writeGreppable(&buf, hosts, start, start.Add(time.Second)))","+","+\tout := buf.String()","+\trequire.Contains(t, out, \"Host: 203.0.113.7 (203.0.113.7)\\tPorts: 22/closed/tcp/////, 80/open/tcp/////\\tIgnored State: filtered (997)\\n\")","+\trequire.Contains(t, out, \"Host: 203.0.113.8 (203.0.113.8)\\tPorts: 1/closed/tcp/////, \")","+\trequire.Contains(t, out, \"26/closed/tcp/////\\tIgnored State: filtered (3)\\n\", \"filtered keeps the one ignored state\")","+\trequire.Contains(t, out, \"Host: 203.0.113.9 (203.0.113.9)\\tPorts: \\tIgnored State: closed (26)\\n\")","+}","+","+func TestOutputPortStatesJSON(t *testing.T) {","+\trunner := newConnectRunner(t)","+\trunner.options.PortState = true","+\trunner.options.JSON = true","+\trunner.options.DisableStdout = true","+","+\tfile, err := os.Create(filepath.Join(t.TempDir(), \"out.json\"))","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { _ = file.Close() })","+","+\theader := true","+\tstates := map[string]hostPortStates{\"203.0.113.8\": {closed: tcpPorts(22, 23), filtered: 5}}","+\trunner.outputPortStates(states, file, &header, &header)","+","+\tdata, err := os.ReadFile(file.Name())","+\trequire.NoError(t, err)","+\tlines := strings.Split(strings.TrimSpace(string(data)), \"\\n\")","+\trequire.Len(t, lines, 2)","+\tvar record map[string]any","+\trequire.NoError(t, json.Unmarshal([]byte(lines[0]), &record))","+\trequire.Equal(t, \"closed\", record[\"state\"])","+\trequire.EqualValues(t, 22, record[\"port\"])","+\trequire.Equal(t, \"203.0.113.8\", record[\"ip\"])","+}","+","+func TestHandleHostPortClosed(t *testing.T) {","+\tl, err := net.Listen(\"tcp\", \"127.0.0.1:0\")","+\trequire.NoError(t, err)","+\tclosedAddr := l.Addr().(*net.TCPAddr)","+\trequire.NoError(t, l.Close())","+","+\tfor name, proxy := range map[string]string{\"direct\": \"\", \"proxy refused\": closedAddr.String()} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\toptions := &Options{Host: []string{\"127.0.0.1\"}, Ports: \"80\", ScanType: ConnectScan, IPVersion: []string{\"4\"}, PortState: true, Proxy: proxy}","+\t\t\trunner, err := NewRunner(options)","+\t\t\trequire.NoError(t, err)","+\t\t\tt.Cleanup(func() { _ = runner.Close() })","+\t\t\trunner.limiter = ratelimit.NewUnlimited(context.Background())","+\t\t\trunner.wgscan = sizedwaitgroup.New(1)","+","+\t\t\trunner.wgscan.Add()","+\t\t\trunner.handleHostPort(context.Background(), \"127.0.0.1\", \"\", &port.Port{Port: closedAddr.Port, Protocol: protocol.TCP})","+","+\t\t\tclosed := runner.scanner.ScanResults.GetClosedPorts()","+\t\t\tif proxy == \"\" {","+\t\t\t\trequire.Len(t, closed[\"127.0.0.1\"], 1)","+\t\t\t} else {","+\t\t\t\trequire.Empty(t, closed, \"the proxy refused, not the target\")","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":183,"deletions":0,"truncated":false},{"path":"pkg/runner/runner.go","lines":["@@ -65,6 +65,14 @@ type Runner struct {"," \tstats          *clistats.Statistics"," \tstreamChannel  chan Target"," \texcludedIpsNP  *networkpolicy.NetworkPolicy","+\t// countFiltered is set when -port-state can derive filtered ports; see","+\t// enableFilteredCount.","+\tcountFiltered bool","+\t// portStatesFor and portStatesCache memoize portStates for one result set,","+\t// since the console, file and nmap outputs all need the same view.","+\tportStatesMu    sync.Mutex","+\tportStatesFor   *result.Result","+\tportStatesCache map[string]hostPortStates"," "," \tunique gcache.Cache[string, struct{}]"," ","@@ -239,6 +247,7 @@ func NewRunner(options *Options) (*Runner, error) {"," \t\tOnReceive:            options.OnReceive,"," \t\tScanType:             options.ScanType,"," \t\tNetworkPolicyOptions: options.NetworkPolicyOptions,","+\t\tPortState:            options.PortState,"," \t}"," "," \tif scanOpts.OnReceive == nil {","@@ -800,6 +809,7 @@ func (r *Runner) RunEnumeration(pctx context.Context) error {"],"additions":9,"deletions":0,"truncated":false}],"additions":644,"deletions":7,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-27T19:03:53.867911+00:00"}