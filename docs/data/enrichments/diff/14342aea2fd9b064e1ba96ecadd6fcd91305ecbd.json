odules<'a> {","     }"," }"," ","+/// Which of an importer's direct dependencies an install links: those in","+/// its dependency groups that do not resolve to a skipped snapshot.","+#[derive(Debug, Clone, Copy)]","+pub struct LinkedDirectDeps<'a> {","+    pub included_groups: &'a [DependencyGroup],","+    /// The snapshots the install does not materialize. A link a previous","+    /// install created for one of them is stale.","+    pub skipped: &'a SkippedSnapshots,","+}","+","+impl<'a> LinkedDirectDeps<'a> {","+    fn of(","+        self,","+        snapshot: &'a ProjectSnapshot,","+    ) -> Vec<(&'a PkgName, &'a ResolvedDependencySpec, DependencyGroup)> {","+        direct_deps_of(snapshot, self.included_groups)","+            .into_iter()","+            .filter(|(alias, spec, _)| {","+                spec.version","+                    .resolved_key(alias)","+                    .is_none_or(|key| !self.skipped.contains(&key))","+            })","+            .collect()","+    }","+}","+"," /// Where [`prune_workspace_hoists`] looks for each kind of workspace"," /// hoist link. Both are confined to `workspace_root`."," pub(crate) struct WorkspaceHoistDirs<'a> {"],"additions":31,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/prepare_modules_state/up_to_date.rs","lines":["@@ -66,12 +66,8 @@ pub(super) fn frozen_tree_up_to_date<'a>(","     // has to be retaken; the TypeScript CLI has no gate at this level at","     // all and instead forces every directory dep through materialization","     // in `lockfileToDepGraph`.","-    if !materialized_shape_matches(","-        wanted_lockfile,","-        current,","-        context.tree.included,","-        config.peer_edge_options(),","-    ) || has_directory_snapshot(current)","+    if !materialized_shape_matches(wanted_lockfile, current, context.tree.included, config)","+        || has_directory_snapshot(current)","     {","         return None;","     }"],"additions":2,"deletions":6,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/current_lockfile.rs","lines":["@@ -1,4 +1,5 @@"," use super::{DependencyGroup, Lockfile, OptimisticRepeatInstallCheck, Path, WorkspaceState};","+use pnpm_config::Config;"," use pnpm_modules_yaml::IncludedDependencies;"," use std::{cell::OnceCell, collections::HashSet};"," ","@@ -79,14 +80,21 @@ pub(crate) fn assert_loaded_current_lockfile_records("," /// settle instead of re-materializing on every run."," ///"," /// The equal case is the common one and answers without building the","-/// filtered shape at all.","+/// filtered shape at all. Under `config.skip_runtimes` the direct runtimes are","+/// left out of the shape, so a tree that still holds one does not match."," pub(crate) fn materialized_shape_matches(","     wanted: &Lockfile,","     current: &Lockfile,","     included: IncludedDependencies,","-    peer_edges: pnpm_lockfile::PeerEdgeOptions,","+    config: &Config,"," ) -> bool {","-    if wanted == current {","+    let mut skipped = crate::SkippedSnapshots::new();","+    if config.skip_runtimes","+        && let Some(packages) = wanted.packages.as_ref()","+    {","+        crate::add_direct_runtime_skips(&mut skipped, &wanted.importers, packages);","+    }","+    if skipped.is_empty() && wanted == current {","         return true;","     }","     // A transient skip (a failed optional fetch) prunes the current lockfile","@@ -95,8 +103,8 @@ pub(crate) fn materialized_shape_matches(","     current","         == &crate::filter_lockfile_for_current(","             wanted,","-            &crate::GroupSelection::classify(wanted, included, peer_edges),","-            &crate::SkippedSnapshots::new(),","+            &crate::GroupSelection::classify(wanted, included, config.peer_edge_options()),","+            &skipped,","         )"," }"," "],"additions":13,"deletions":5,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/relocation.rs","lines":["@@