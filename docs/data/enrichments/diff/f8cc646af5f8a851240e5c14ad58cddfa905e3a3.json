{"id":"f8cc646af5f8a851240e5c14ad58cddfa905e3a3","axis":"silent","repo":"pnpm/pnpm","sha":"f8cc646af5f8a851240e5c14ad58cddfa905e3a3","parsed":{"files":[{"path":".changeset/giant-snails-lie.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.deps-resolver\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Conflicting non-semver peer dependencies now remain missing when `autoInstallPeersFromHighestMatch` is enabled. Identical non-semver peer specifiers are preserved. Preferred registry versions no longer replace local paths or protocol-prefixed specifiers when installing missing peers [pnpm/tasks#272](https://github.com/pnpm/tasks/issues/272)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/peer_provider.rs","lines":["@@ -128,25 +128,24 @@ fn hoisted_specifier(opts: &HoistPeersOptions<'_>, peer_name: &str, range: &str)","     let Some(selectors) = opts.all_preferred_versions.get(peer_name) else {","         return opts.auto_install_peers.then(|| range.to_string());","     };","-    // A `workspace:` range resolves to the workspace project. A preferred","-    // version may belong to a registry package of the same name, so the","-    // peer is not deduped onto one.","-    if range.starts_with(\"workspace:\") {","+    if !is_registry_peer_specifier(range) {","         return opts.auto_install_peers.then(|| range.to_string());","     }","     preferred_version_specifier(opts, selectors, opts.resolved_versions.get(peer_name), range)"," }"," ","+/// `false` for a path or a protocol-prefixed locator. `node_semver` parses","+/// some of those, such as `file:../lib 1.0.0`, as ranges.","+pub(crate) fn is_registry_peer_specifier(range: &str) -> bool {","+    !range.contains([':', '/', '\\\\'])","+}","+"," /// Dedupe onto a preferred version only when it actually satisfies the wanted"," /// peer range. Picking the highest preferred version regardless of the range"," /// lets a version resolved for one importer be auto-installed as another"," /// importer's peer even though nothing in that importer's closure accepts it,","-/// silently producing a peer graph that mixes incompatible majors. Scheme","-/// specifiers (named-registry, `npm:` aliases) contribute a","-/// comparable range through `get_peer_version_range`, so they get range-aware","-/// selection too; specs with no version body (`catalog:`, dist-tags) yield a","-/// non-semver value and keep the dedupe-to-highest behavior. The raw scheme is","-/// preserved so the fallback still selects the package to install.","+/// silently producing a peer graph that mixes incompatible majors. Dist-tags","+/// yield a non-semver value and keep the dedupe-to-highest behavior."," fn preferred_version_specifier(","     opts: &HoistPeersOptions<'_>,","     selectors: &VersionSelectors,"],"additions":9,"deletions":10,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/peer_provider/tests.rs","lines":["@@ -109,6 +109,17 @@ fn picks_already_available_prerelease_version() {","     assert_eq!(result, expected);"," }"," ","+#[test]","+fn still_deduplicates_registry_tags_onto_preferred_versions() {","+    let preferred = preferred(&[(\"foo\", &[(\"1.0.0\", plain(VersionSelectorType::Version))])]);","+    for range in [\"latest\", \"next\"] {","+        assert_eq!(","+            hoist_peers(&opts(true, &preferred), &[missing(\"foo\", range)]),","+            BTreeMap::from([(\"foo\".to_string(), \"1.0.0\".to_string())]),","+        );","+    }","+}","+"," #[test]"," fn respects_peer_dep_range_when_preferred_versions_exist() {","     let preferred = preferred(&[(","@@ -233,7 +244,7 @@ fn leaves_a_workspace_peer_missing_without_auto_install_peers() {"," }"," "," #[test]","-fn dedupes_named_registry_peer_onto_a_preferred_version_that_satisfies_its_extracted_range() {","+fn preserves_named_registry_peer_specifiers_when_preferred_versions_exist() {","     let preferred = preferred(&[(","         \"foo\",","         &[","@@ -243,7 +254,7 @@ fn dedupes_named_registry_peer_onto_a_preferred_version_that_satisfies_its_extra","     )]);","     let result = hoist_peers(&opts(true, &preferred), &[missing(\"foo\", \"work:^1.0.0\")]);","     let mut expected = BTreeMap::new();","-    expected.insert(\"foo\".to_string(), \"1.0.0\".to_string());","+    expected.insert(\"foo\".to_string(), \"work:^1.0.0\".to_string());","     assert_eq!(result, expected);"," }"," ","@@ -257,9 +268,7 @@ fn falls_back_to_raw_scheme_specifier_when_no_preferred_version_satisfies_its_ex"," }"," "," #[test]","-fn respects_a_merged_union_of_scheme_specifiers_instead_of_picking_the_highest() {","-    // `4.0.0` is the highest but satisfies neither `^2.0.0` nor `^3.0.0`, so a","-    // blind highest-version pick would be wrong; `3.0.0` is the highest match.","+fn preserves_registry_prefixes_in_merged_peer_specifiers() {","     let preferred = preferred(&[(","         \"foo\",","         &[","@@ -271,7 +280,7 @@ fn respects_a_merged_union_of_scheme_specifiers_instead_of_picking_the_highest()","     let result =","         hoist_peers(&opts(true, &preferred), &[missing(\"foo\", \"work:^2.0.0 || work:^3.0.0\")]);","     let mut expected = BTreeMap::new();","-    expected.insert(\"foo\".to_string(), \"3.0.0\".to_string());","+    expected.insert(\"foo\".to_string(), \"work:^2.0.0 || work:^3.0.0\".to_string());","     assert_eq!(result, expected);"," }"," "],"additions":15,"deletions":6,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_importer/missing_peers.rs","lines":["@@ -1,4 +1,5 @@"," use super::{BTreeMap, BTreeSet, HashMap, HashSet, MissingPeer, MissingPeerInfo};","+use crate::peer_provider::is_registry_peer_specifier;"," use node_semver::Range;"," use std::borrow::Cow;"," ","@@ -184,9 +185,9 @@ pub(super) fn distinct_wanted_ranges(entries: &[MissingPeer]) -> Vec<String> {"," /// Combine multiple consumers' wanted ranges into a single specifier,"," /// the upstream `mergePkgsDeps` policy: a single (or single unique)"," /// range passes through unchanged, distinct compatible ranges reduce to","-/// their semver intersection, and an empty intersection falls back to a","-/// `||`-join under `auto_install_peers_from_highest_match` — or `None`,","-/// dropping the peer on an unresolvable conflict.","+/// their semver intersection, and disjoint semver ranges fall back to a","+/// `||`-join under `auto_install_peers_from_highest_match`. Conflicting","+/// non-semver specifiers return `None`, leaving the peer missing."," ///"," /// Only the unique ranges reach [`intersect_ranges`]: folding a range in"," /// a second time cannot narrow the result, and every pass costs another","@@ -207,10 +208,17 @@ pub(super) fn merge_ranges(","     if unique.len() == 1 {","         return Some(ranges[0].to_string());","     }","+    if !unique.iter().all(|range| is_registry_peer_specifier(range)) {","+        return None;","+    }","     if let Some(intersection) = intersect_ranges(&unique) {","         return Some(intersection);","     }","-    if auto_install_peers_from_highest_match {","+    if auto_install_peers_from_highest_match","+        && unique","+            .iter()","+            .all(|range| Range::parse(range).is_ok())","+    {","         return Some(ranges.join(\" || \"));","     }","     None"],"additions":12,"deletions":4,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_importer/tests/behavior.rs","lines":["@@ -2,6 +2,76 @@ use super::{","     DepPath, DependencyGroup, HashMap, Mutex, ResolveResult, StubResolver, assert_eq, default_opts,","     fake_manifest, fake_result, merge_ranges, resolve_importer,"," };","+use crate::{HoistPeersOptions, MissingPeerInfo, hoist_peers};","+use pnpm_resolving_resolver_base::{","+    PreferredVersions, VersionSelectorEntry, VersionSelectorType, VersionSelectorWithWeight,","+};","+use std::{collections::BTreeMap, path::Path};","+","+#[test]","+fn merged_peer_locators_survive_preferred_registry_versions() {","+    let preferred = PreferredVersions::from_iter([(","+        \"b\".to_string(),","+        BTreeMap::from([","+            (\"1.0.0\".to_string(), VersionSelectorEntry::Plain(VersionSelectorType::Version)),","+            (","+                \"2.0.0\".to_string(),","+                VersionSelectorEntry::Weighted(VersionSelectorWithWeight {","+                    selector_type: VersionSelectorType::Version,","+                    weight: 1000,","+                }),","+            ),","+        ]),","+    )]);","+    for range in [","+        \"file:../b\",","+        \"link:../b\",","+        \"../b\",","+        r\"..\\b\",","+        \"./b\",","+        \"/packages/b\",","+        \"~/b\",","+        \"npm:other@1.0.0\",","+        \"workspace:*\",","+        \"workspace:other@^1\",","+        \"http://example.test/b.tgz\",","+        \"https://example.test/b.tgz\",","+        \"git+https://example.test/b.git\",","+        \"git+ssh://git@example.test/b.git\",","+        \"github:example/b\",","+        \"gitlab:example/b\",","+        \"bitbucket:example/b\",","+        \"example/b\",","+        \"catalog:default\",","+        \"work:^1.0.0\",","+        \"work:other@1.0.0\",","+    ] {","+        for auto_install_peers_from_highest_match in [false, true] {","+            let merged = merge_ranges(&[range, range], auto_install_peers_from_highest_match)","+                .expect(\"identical peer locators merge\");","+            for auto_install_peers in [false, true] {","+                let opts = HoistPeersOptions {","+                    auto_install_peers,","+                    all_preferred_versions: &preferred,","+                    workspace_root_deps: &[],","+                    override_bare_specifier: None,","+                    project_dir: Path::new(\"/workspace\"),","+                    resolved_versions: &HashMap::default(),","+                };","+                let hoisted = hoist_peers(","+                    &opts,","+                    &[(\"b\".to_string(), MissingPeerInfo { range: merged.clone() })],","+                );","+                assert_eq!(","+                    hoisted.get(\"b\").map(String::as_str),","+                    auto_install_peers.then_some(range),","+                    \"range={range}, highest_match={auto_install_peers_from_highest_match}, auto_install={auto_install_peers}\",","+                );","+                assert_eq!(hoisted.len(), usize::from(auto_install_peers));","+            }","+        }","+    }","+}"," "," #[tokio::test]"," async fn does_not_hoist_when_disabled() {","@@ -149,6 +219,84 @@ fn repeated_scheme_specifier_stays_verbatim() {","     );"," }"," ","+#[test]","+fn conflicting_non_semver_peer_ranges_are_not_joined() {","+    for ranges in [","+        [\"file:../packages/b\", \"file:../libs/b\"],","+        [\"link:../b\", \"link:../c\"],","+        [\"../b\", \"../c\"],","+        [\"file:../b\", \"^1.0.0\"],","+        [\"^1.0.0\", \"file:../b\"],","+        [\"npm:b@^1\", \"npm:b@^2\"],","+        [\"latest\", \"next\"],","+        [\"file:../lib 1.0.0\", \"file:../lib 2.0.0\"],","+        [\"file:../a 1.0.0\", \"file:../b 1.0.0\"],","+        [\"../a 1.0.0\", \"../b 2.0.0\"],","+        [r\"..\\a\", r\"..\\b\"],","+    ] {","+        for highest_match in [false, true] {","+            assert_eq!(merge_ranges(&ranges, highest_match), None, \"{ranges:?}\");","+        }","+    }","+}","+","+#[test]","+fn repeated_non_semver_peer_ranges_stay_verbatim() {","+    for range in [\"file:../b\", \"link:../b\", \"../b\", \"npm:b@^1\", \"latest\"] {","+        for highest_match in [false, true] {","+            assert_eq!(merge_ranges(&[range, range], highest_match).as_deref(), Some(range));","+        }","+    }","+}","+","+#[tokio::test]","+async fn conflicting_path_peers_stay_missing_without_resolution() {","+    for ranges in [","+        [\"file:../packages/b\", \"file:../libs/b\", \"file:../other/b\"],","+        [\"file:../b\", \"^1.0.