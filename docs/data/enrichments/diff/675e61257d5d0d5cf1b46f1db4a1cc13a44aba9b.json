,"+\tcontainer: DefinitionContainer | undefined;","+\tkey: string;","+} {","+\tfor (const container of DEFINITION_CONTAINERS) {","+\t\tconst prefix = `#/${container}/`;","+","+\t\tif (definition.startsWith(prefix)) {","+\t\t\treturn { container, key: definition.slice(prefix.length) };","+\t\t}","+\t}","+","+\treturn { container: undefined, key: definition };","+}","+","+function getDefinitionContainers("," \tschema: SchemaObject | ReferenceObject | ObjectSubtype,","-): schema is SchemaWithDefinitions {","-\treturn \"definitions\" in schema && isRecord(schema.definitions);","+\tpreferred: DefinitionContainer | undefined,","+): Record<string, unknown>[] {","+\tconst record: Record<string, unknown> = { ...schema };","+\tconst order = preferred","+\t\t? [preferred, ...DEFINITION_CONTAINERS.filter((key) => key !== preferred)]","+\t\t: [...DEFINITION_CONTAINERS];","+","+\treturn order.flatMap((key) => {","+\t\tconst container = record[key];","+\t\treturn isRecord(container) ? [container] : [];","+\t});"," }"," ","+/**","+ * Resolves a `$ref` such as `#/definitions/Foo` or `#/$defs/Foo` against the","+ * root schema. Pydantic emits `$defs` while Prefect rewrites refs to","+ * `#/definitions/`, so schemas in the wild mix the two. The container named in","+ * the ref is checked first and the other container is used as a fallback.","+ */"," export function getSchemaDefinition("," \tschema: SchemaObject | ReferenceObject | ObjectSubtype,"," \tdefinition: string,"," ): SchemaObject {","-\tif (isSchemaWithDefinitions(schema)) {","-\t\tconst definitionKey = definition.replace(\"#/definitions/\", \"\");","-\t\tconst definitionSchema = schema.definitions?.[definitionKey];","-","-\t\tif (!definitionSchema) {","-\t\t\tthrow new Error(`Definition not found for ${definition}`);","-\t\t}","+\tconst { container: preferred, key: definitionKey } =","+\t\tparseDefinitionReference(definition);","+\tconst containers = getDefinitionContainers(schema, preferred);"," ","-\t\treturn definitionSchema;","+\tif (containers.length === 0) {","+\t\treturn {} as SchemaObject;"," \t}","-\tif (\"$defs\" in schema && isRecord(schema.$defs)) {","-\t\tconst definitionKey = definition.replace(\"#/$defs/\", \"\");","-\t\tconst definitionSchema = schema.$defs?.[definitionKey];","-\t\tif (!definitionSchema) {","-\t\t\tthrow new Error(`Definition not found for ${definition}`);","-\t\t}"," ","-\t\treturn definitionSchema;","+\tfor (const container of containers) {","+\t\tconst definitionSchema = container[definitionKey];","+","+\t\tif (isRecord(definitionSchema)) {","+\t\t\treturn definitionSchema as SchemaObject;","+\t\t}"," \t}"," ","-\treturn {} as SchemaObject;","+\tthrow new Error(`Definition not found for ${definition}`);"," }"," "," export function mergeSchemaPropertyDefinition("],"additions":48,"deletions":23,"truncated":false},{"path":"ui-v2/src/components/schemas/utilities/removePrefectKindValues.test.ts","lines":["@@ -0,0 +1,76 @@","+import { describe, expect, test } from \"vitest\";","+import { removePrefectKindValues } from \"./removePrefectKindValues\";","+","+describe(\"removePrefectKindValues\", () => {","+\ttest(\"parses json kind values into native objects\", () => {","+\t\tconst result = removePrefectKindValues({","+\t\t\tenv: {","+\t\t\t\t__prefect_kind: \"json\",","+\t\t\t\tvalue: '{\"CDWH_ENVIRONMENT\":\"dev\"}',","+\t\t\t},","+\t\t});","+","+\t\texpect(result).toEqual({ env: { CDWH_ENVIRONMENT: \"dev\" } });","+\t});","+","+\ttest(\"drops json kind values that have no content\", () => {","+\t\tconst result = removePrefectKindValues({","+\t\t\tenv: { __prefect_kind: \"json\", value: undefined },","+\t\t\tlabels: { __prefect_kind: \"json\", value: \"  \" },","+\t\t});","+","+\t\texpect(result).toEqual({ env: undefined, labels: undefined });","+\t});","+","+\ttest(\"drops json kind values with invalid json instead of saving text\", () => {","+\t\tconst result = removePrefectKindValues({","+\t\t\tenv: { __prefect_kind: \"json\", value: '{\"CDWH_ENVIRONMENT