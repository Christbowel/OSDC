{"id":"387c836cfdedbfd62c063210a708db378ca9ba7c","axis":"silent","repo":"TYPO3/typo3","sha":"387c836cfdedbfd62c063210a708db378ca9ba7c","parsed":{"files":[{"path":"typo3/sysext/core/Documentation/Changelog/14.3.x/Important-110471-AllowRestrictingRequestHostsOfRssDashboardWidgets.rst","lines":["@@ -0,0 +1,54 @@","+..  include:: /Includes.rst.txt","+","+..  _important-110471-1792652849:","+","+=============================================================================","+Important: #110471 - Allow restricting request hosts of RSS dashboard widgets","+=============================================================================","+","+See :issue:`110471`","+","+Description","+===========","+","+Feeds of RSS dashboard widgets are fetched by http(s) only, other sources, such","+as local files, are not read anymore. This applies to feed urls configured in","+the settings of a widget as well as to the :yaml:`feedUrl` option of the widget","+registration. The :yaml:`feedUrl` option cannot be overridden by the settings","+of a widget anymore.","+","+By default, RSS dashboard widgets may still request any host. Backend users","+who are allowed to configure an RSS widget can therefore let the server send","+requests to arbitrary hosts, including hosts of internal networks (Server-Side","+Request Forgery). This is only prevented once the hosts RSS dashboard widgets","+connect to are restricted in","+:php:`$GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss']`.","+","+It is strongly recommended to configure this option and to only allow the","+hosts of the feeds actually used, for example in","+:file:`config/system/additional.php`:","+","+..  code-block:: php","+","+    $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'] = [","+        // Hosts of the TYPO3 news feed","+        'typo3.org',","+        'news.typo3.com',","+    ];","+","+The restriction applies to all feed requests, including redirect targets and","+feed urls of the widget registration. Feeds of hosts that are not allowed are","+not loaded, and the widget shows a corresponding notice.","+","+Parts of the domain can be substituted with a wildcard character :php:`'*'`","+(matches one or multiple characters, no regex syntax supported). For example,","+:php:`'*.example.com'` accepts all domains ending in `.example.com`:","+","+..  code-block:: php","+","+    $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'][] = '*.example.com';","+","+As long as the option is unset or :php:`null`, all hosts are allowed. An empty","+array blocks all feed requests.","+","+..  index:: LocalConfiguration, ext:dashboard"],"additions":54,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Exception/DisallowedRssFeedHostException.php","lines":["@@ -0,0 +1,20 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Dashboard\\Exception;","+","+class DisallowedRssFeedHostException extends InvalidRssFeedException {}"],"additions":20,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Exception/DisallowedRssFeedSchemeException.php","lines":["@@ -0,0 +1,20 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Dashboard\\Exception;","+","+class DisallowedRssFeedSchemeException extends InvalidRssFeedException {}"],"additions":20,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Widgets/RssWidget.php","lines":["@@ -17,12 +17,18 @@"," "," namespace TYPO3\\CMS\\Dashboard\\Widgets;"," ","+use GuzzleHttp\\Exception\\GuzzleException;","+use GuzzleHttp\\Promise\\RejectionException;"," use Symfony\\Component\\DependencyInjection\\Attribute\\Autowire;"," use TYPO3\\CMS\\Backend\\View\\BackendViewFactory;"," use TYPO3\\CMS\\Core\\Cache\\Frontend\\FrontendInterface;","+use TYPO3\\CMS\\Core\\Http\\RequestFactory;","+use TYPO3\\CMS\\Core\\Log\\LogManager;"," use TYPO3\\CMS\\Core\\Settings\\SettingDefinition;"," use TYPO3\\CMS\\Core\\Settings\\SettingsInterface;"," use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","+use TYPO3\\CMS\\Dashboard\\Exception\\DisallowedRssFeedHostException;","+use TYPO3\\CMS\\Dashboard\\Exception\\DisallowedRssFeedSchemeException;"," use TYPO3\\CMS\\Dashboard\\Exception\\InvalidRssFeedException;"," "," /**","@@ -32,8 +38,8 @@","  * can add a button to the widget by defining a button provider.","  *","  * The following options are available during registration:","- * - feedUrl        string                      Defines the URL or file providing the RSS Feed.","- *                                              This is read by the widget in order to fetch entries to show.","+ * - feedUrl        string                      Defines the URL providing the RSS Feed.","+ *                                              This is fetched by the widget in order to show its entries.","  * - limit          int     default: 5          Defines how many RSS items should be shown.","  * - lifetime       int     default: 43200      Defines how long to wait, in seconds, until fetching RSS Feed again","  *","@@ -63,7 +69,7 @@ public function getSettingsDefinitions(): array","                 default: '',","                 label: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.setting.label.label',","                 description: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.setting.label.description',","-                readonly: array_key_exists('feedUrl', $this->options),","+                readonly: $this->isFeedUrlDefinedByWidgetRegistration(),","             ),","             new SettingDefinition(","                 key: 'feedUrl',","@@ -71,9 +77,9 @@ public function getSettingsDefinitions(): array","                 default: (string)($this->options['feedUrl'] ?? ''),","                 label: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.setting.fieldUrl.label',","                 description: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.setting.fieldUrl.description',","-                readonly: array_key_exists('feedUrl', $this->options),","+                readonly: $this->isFeedUrlDefinedByWidgetRegistration(),","                 options: [","-                    'pattern' => 'https?://.+',","+                    'pattern' => '^https?://.+',","                 ],","             ),","             new SettingDefinition(","@@ -98,11 +104,15 @@ public function getSettingsDefinitions(): array","     public function renderWidget(WidgetContext $context): WidgetResult","     {","         $view = $this->backendViewFactory->create($context->request);","-        $feedUrl = $context->settings->get('feedUrl');","+        $feedUrl = $this->getFeedUrl($context->settings);","         $items = [];","         if ($feedUrl) {","             try {","                 $items = $this->getFeedItems($context->settings);","+            } catch (DisallowedRssFeedHostException) {","+                $view->assign('disallowedHost', true);","+            } catch (DisallowedRssFeedSchemeException) {","+                $view->assign('disallowedScheme', true);","             } catch (InvalidRssFeedException) {","                 $view->assign('invalidFeed', true);","             }","@@ -122,17 +132,18 @@ public function renderWidget(WidgetContext $context): WidgetResult","         );","     }"," ","+    /**","+     * @throws InvalidRssFeedException","+     */","     protected function getFeedItems(SettingsInterface $settings): array","     {","-        $cacheHash = md5($settings->get('feedUrl') . '-' . $settings->get('limit'));","+        $feedUrl = $this->getFeedUrl($settings);","+        $cacheHash = md5($feedUrl . '-' . $settings->get('limit'));","         if ($items = $this->cache->get($cacheHash)) {","             return $items;","         }"," ","-        $feedContent = GeneralUtility::getUrl($settings->get('feedUrl'));","-        if ($feedContent === false) {","-            throw new InvalidRssFeedException('RSS URL could not be fetched', 1573385431);","-        }","+        $feedContent = $this->fetchFeedContent($feedUrl);","         try {","             $feedXml = simplexml_load_string($feedContent);","         } catch (\\Exception $e) {","@@ -155,6 +166,54 @@ protected function getFeedItems(SettingsInterface $settings): array","         return $items;","     }"," ","+    /**","+     * A feed url of the widget registration is defined by developers, and is never","+     * overridden by the settings of a widget instance.","+     */","+    protected function getFeedUrl(SettingsInterface $settings): string","+    {","+        return $this->isFeedUrlDefinedByWidgetRegistration() ? $this->options['feedUrl'] : (string)$settings->get('feedUrl');","+    }","+","+    protected function isFeedUrlDefinedByWidgetRegistration(): bool","+    {","+        return is_string($this->options['feedUrl'] ?? null);","+    }","+","+    /**","+     * Feeds are fetched by http(s) only, the hosts can be restricted with","+     * $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'].","+     *","+     * @throws DisallowedRssFeedHostException","+     * @throws DisallowedRssFeedSchemeException","+     * @throws InvalidRssFeedException","+     */","+    protected function fetchFeedContent(string $feedUrl): string","+    {","+        if (!in_array(strtolower((string)parse_url($feedUrl, PHP_URL_SCHEME)), ['http', 'https'], true)) {","+            throw new DisallowedRssFeedSchemeException('Scheme of RSS URL is not allowed', 1794390041);","+        }","+        try {","+            return GeneralUtility::makeInstance(RequestFactory::class)","+                ->request($feedUrl, 'GET', [], 'dashboard_rss')","+                ->getBody()","+                ->getContents();","+        } catch (RejectionException $e) {","+            $this->logFetchError($feedUrl, $e);","+            throw new DisallowedRssFeedHostException('Host of RSS URL is not allowed', 1793039663, $e);","+        } catch (GuzzleException|\\InvalidArgumentException $e) {","+            $this->logFetchError($feedUrl, $e);","+            throw new InvalidRssFeedException('RSS URL could not be fetched', 1573385431, $e);","+        }","+    }","+","+    protected function logFetchError(string $feedUrl, \\Throwable $exception): void","+    {","+        GeneralUtility::makeInstance(LogManager::class)","+            ->getLogger(self::class)","+            ->warning('Could not fetch feed content from {url}', ['url' => $feedUrl, 'exception' => $exception]);","+    }","+","     protected function determineFeedType(\\SimpleXMLElement $feedXml): string","     {","         return $feedXml->getName() === 'feed' ? 'atom' : 'rss';"],"additions":70,"deletions":11,"truncated":false},{"path":"typo3/sysext/dashboard/Documentation/Widgets/RssWidget.rst","lines":["@@ -101,8 +101,8 @@ The following options are available via :yaml:`services.dashboard.widget.t3news.","     :type: string","     :name: rss-widget-feedUrl"," ","-    Defines the URL or file providing the RSS Feed.","-    This is read by the widget in order to fetch entries to show.","+    Defines the URL providing the RSS Feed.","+    This is fetched by the widget in order to show its entries."," "," ..  confval:: lifeTime","     :type: int"],"additions":2,"deletions":2,"truncated":false},{"path":"typo3/sysext/dashboard/Resources/Private/Language/locallang_widget_rss.xlf","lines":["@@ -19,7 +19,7 @@","         <source>RSS Feed</source>","       </trans-unit>","       <trans-unit id=\"widget.rss.setting.fieldUrl.description\">","-        <source>Defines the URL or file providing the RSS Feed. This is read by the widget in order to fetch entries to show.</source>","+        <source>Defines the URL providing the RSS Feed. This is fetched by the widget in order to show its entries.</source>","       </trans-unit>","       <trans-unit id=\"widget.rss.setting.limit.label\">","         <source>Limit</source>","@@ -39,6 +39,18 @@","       <trans-unit id=\"widget.rss.missingFeedConfiguration.message\">","         <source>Please configure a feed URL to retrieve items from.</source>","       </trans-unit>","+      <trans-unit id=\"widget.rss.disallowedHost.title\">","+        <source>Feed host not allowed</source>","+      </trans-unit>","+      <trans-unit id=\"widget.rss.disallowedHost.message\">","+        <source>The feed at \"%1$s\" was not loaded, because its host, or the host it redirects to, is not allowed in $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'].</source>","+      </trans-unit>","+      <trans-unit id=\"widget.rss.disallowedScheme.title\">","+        <source>Feed URL not supported</source>","+      </trans-unit>","+      <trans-unit id=\"widget.rss.disallowedScheme.message\">","+        <source>The feed at \"%1$s\" was not loaded, because feed URLs must start with http:// or https://.</source>","+      </trans-unit>","       <trans-unit id=\"widget.rss.feedError.title\">","         <source>Feed error</source>","       </trans-unit>"],"additions":13,"deletions":1,"truncated":false},{"path":"typo3/sysext/dashboard/Resources/Private/Templates/Widget/RssWidget.fluid.html","lines":["@@ -21,6 +21,12 @@","         <f:else if=\"!{feedUrl}\">","             <f:be.infobox title=\"{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.missingFeedConfiguration.title')}\" state=\"-1\">{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.missingFeedConfiguration.message')}</f:be.infobox>","         </f:else>","+        <f:else if=\"{disallowedHost}\">","+            <f:be.infobox title=\"{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.disallowedHost.title')}\" state=\"2\">{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.disallowedHost.message', arguments: '{0: feedUrl}')}</f:be.infobox>","+        </f:else>","+        <f:else if=\"{disallowedScheme}\">","+            <f:be.infobox title=\"{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.disallowedScheme.title')}\" state=\"2\">{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.disallowedScheme.message', arguments: '{0: feedUrl}')}</f:be.infobox>","+        </f:else>","         <f:else if=\"{invalidFeed}\">","             <f:be.infobox title=\"{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.feedError.title')}\" state=\"2\">{f:translate(key: 'LLL:EXT:dashboard/Resources/Private/Language/locallang_widget_rss.xlf:widget.rss.feedError.message', arguments: '{0: feedUrl}')}</f:be.infobox>","         </f:else>"],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Tests/Functional/Fixtures/feed.xml","lines":["@@ -0,0 +1,14 @@","+<?xml version=\"1.0\" encoding=\"utf-8\"?>","+<rss version=\"2.0\">","+    <channel>","+        <title>Fixture feed</title>","+        <link>https://example.org/</link>","+        <description>Fixture feed</description>","+        <item>","+            <title>Fixture item</title>","+            <link>https://example.org/item</link>","+            <description>Fixture item description</description>","+            <pubDate>Wed, 21 Oct 2026 10:00:00 +0000</pubDate>","+        </item>","+    </channel>","+</rss>"],"additions":14,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Tests/Functional/Widgets/RssWidgetTest.php","lines":["@@ -0,0 +1,267 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Dashboard\\Tests\\Functional\\Widgets;","+","+use GuzzleHttp\\Promise\\FulfilledPromise;","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Test;","+use Psr\\Http\\Message\\RequestInterface;","+use TYPO3\\CMS\\Backend\\Routing\\Route;","+use TYPO3\\CMS\\Backend\\View\\BackendViewFactory;","+use TYPO3\\CMS\\Core\\Cache\\Frontend\\NullFrontend;","+use TYPO3\\CMS\\Core\\Core\\SystemEnvironmentBuilder;","+use TYPO3\\CMS\\Core\\Http\\NormalizedParams;","+use TYPO3\\CMS\\Core\\Http\\ResponseFactory;","+use TYPO3\\CMS\\Core\\Http\\ServerRequest;","+use TYPO3\\CMS\\Core\\Http\\StreamFactory;","+use TYPO3\\CMS\\Core\\Localization\\LanguageServiceFactory;","+use TYPO3\\CMS\\Core\\Settings\\Settings;","+use TYPO3\\CMS\\Dashboard\\Factory\\WidgetSettingsFactory;","+use TYPO3\\CMS\\Dashboard\\Widgets\\RssWidget;","+use TYPO3\\CMS\\Dashboard\\Widgets\\WidgetConfiguration;","+use TYPO3\\CMS\\Dashboard\\Widgets\\WidgetContext;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class RssWidgetTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = ['dashboard'];","+","+    /**","+     * @var string[]","+     */","+    private array $requestedUrls = [];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/be_users.csv');","+        $backendUser = $this->setUpBackendUser(1);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['handler']['feed'] = function () {","+            return function (RequestInterface $request) {","+                $this->requestedUrls[] = (string)$request->getUri();","+                return new FulfilledPromise(","+                    new ResponseFactory()->createResponse()","+                        ->withBody(new StreamFactory()->createStreamFromFile(__DIR__ . '/../Fixtures/feed.xml'))","+                );","+            };","+        };","+    }","+","+    #[Test]","+    public function feedOfConfiguredUrlIsFetched(): void","+    {","+        $result = $this->render(['feedUrl' => 'https://typo3.org/rss']);","+","+        self::assertStringContainsString('Fixture item', $result);","+        self::assertSame(['https://typo3.org/rss'], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function localFileOfConfiguredUrlIsNotRead(): void","+    {","+        $result = $this->render(['feedUrl' => __DIR__ . '/../Fixtures/feed.xml']);","+","+        self::assertStringContainsString('Feed URL not supported', $result);","+        self::assertStringNotContainsString('Fixture item', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function localFileUrlOfConfiguredUrlIsNotRead(): void","+    {","+        $result = $this->render(['feedUrl' => 'file://' . realpath(__DIR__ . '/../Fixtures/feed.xml')]);","+","+        self::assertStringContainsString('Feed URL not supported', $result);","+        self::assertStringNotContainsString('Fixture item', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    public static function feedOfAnyHostIsFetchedWithoutAllowedHostsDataProvider(): array","+    {","+        return [","+            'allowed hosts not configured' => [false],","+            'allowed hosts set to null' => [true],","+        ];","+    }","+","+    #[DataProvider('feedOfAnyHostIsFetchedWithoutAllowedHostsDataProvider')]","+    #[Test]","+    public function feedOfAnyHostIsFetchedWithoutAllowedHosts(bool $setNull): void","+    {","+        $this->setUpBackendUser(2);","+        if ($setNull) {","+            $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'] = null;","+        }","+","+        $result = $this->render(['feedUrl' => 'http://127.0.0.1/feed.xml']);","+","+        self::assertStringContainsString('Fixture item', $result);","+        self::assertSame(['http://127.0.0.1/feed.xml'], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function malformedFeedUrlIsReportedAsFeedError(): void","+    {","+        $result = $this->render(['feedUrl' => 'http://exa mple.org/feed.xml']);","+","+        self::assertStringContainsString('Feed error', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function feedOfConfiguredUrlRespectsAllowedHosts(): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'] = ['typo3.org'];","+","+        $result = $this->render(['feedUrl' => 'http://127.0.0.1/feed.xml']);","+","+        self::assertStringNotContainsString('Fixture item', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function feedOfDisallowedHostIsReportedAsNotAllowed(): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'] = ['typo3.org'];","+","+        $result = $this->render(['feedUrl' => 'https://example.org/feed.xml']);","+","+        self::assertStringContainsString('Feed host not allowed', $result);","+        self::assertStringNotContainsString('could not be parsed', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function feedOfAllowedHostIsFetched(): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'] = ['*.example.org'];","+","+        $result = $this->render(['feedUrl' => 'https://feeds.example.org/feed.xml']);","+","+        self::assertStringContainsString('Fixture item', $result);","+        self::assertSame(['https://feeds.example.org/feed.xml'], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function emptyAllowedHostsBlockAllFeeds(): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['dashboard_rss'] = [];","+","+        $result = $this->render(['feedUrl' => 'https://typo3.org/rss']);","+","+        self::assertStringNotContainsString('Fixture item', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function allowedHostsOfOtherContextsDoNotApply(): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['allowed_hosts']['webhooks'] = [];","+","+        $result = $this->render(['feedUrl' => 'https://typo3.org/rss']);","+","+        self::assertStringContainsString('Fixture item', $result);","+        self::assertSame(['https://typo3.org/rss'], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function feedUrlOfWidgetRegistrationCanNotBeOverriddenBySettings(): void","+    {","+        $result = $this->render(['feedUrl' => 'https://example.org/other.xml'], ['feedUrl' => 'https://typo3.org/rss']);","+","+        self::assertStringContainsString('Fixture item', $result);","+        self::assertSame(['https://typo3.org/rss'], $this->requestedUrls);","+    }","+","+    #[Test]","+    public function localFileOfSettingsIsNotReadForFeedUrlOptionSetToNull(): void","+    {","+        $result = $this->render(['feedUrl' => __DIR__ . '/../Fixtures/feed.xml'], ['feedUrl' => null]);","+","+        self::assertStringContainsString('Feed URL not supported', $result);","+        self::assertStringNotContainsString('Fixture item', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    public static function localFileOfWidgetRegistrationIsNotReadDataProvider(): array","+    {","+        return [","+            'file path' => [__DIR__ . '/../Fixtures/feed.xml'],","+            'file url' => ['file://' . realpath(__DIR__ . '/../Fixtures/feed.xml')],","+        ];","+    }","+","+    #[DataProvider('localFileOfWidgetRegistrationIsNotReadDataProvider')]","+    #[Test]","+    public function localFileOfWidgetRegistrationIsNotRead(string $feedFile): void","+    {","+        $result = $this->render(['feedUrl' => $feedFile], ['feedUrl' => $feedFile]);","+","+        self::assertStringContainsString('Feed URL not supported', $result);","+        self::assertStringNotContainsString('Fixture item', $result);","+        self::assertSame([], $this->requestedUrls);","+    }","+","+    public static function feedUrlSettingIsValidatedDataProvider(): array","+    {","+        return [","+            'http url' => ['http://example.org/feed.xml', 'http://example.org/feed.xml'],","+            'https url' => ['https://example.org/feed.xml', 'https://example.org/feed.xml'],","+            'file url' => ['file:///etc/passwd', ''],","+            'url of other scheme containing http url' => ['php://filter/http://example.org/resource=/etc/passwd', ''],","+        ];","+    }","+","+    #[DataProvider('feedUrlSettingIsValidatedDataProvider')]","+    #[Test]","+   