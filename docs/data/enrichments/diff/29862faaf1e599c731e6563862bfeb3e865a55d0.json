Private/Templates/Environment/ImageProcessing.fluid.html","lines":["@@ -310,7 +310,8 @@ <h2 class=\"panel-heading\" role=\"tab\">","                 <p>","                     GDLib is accessed through internal functions in PHP, you'll need a version of PHP","                     with GDLib compiled in. Also in order to use TrueType fonts with GDLib you'll","-                    need FreeType compiled in as well.","+                    need FreeType compiled in as well. Without it, GIFBUILDER leaves out its TEXT","+                    objects.","                 </p>","             </div>","         </div>"],"additions":2,"deletions":1,"truncated":false},{"path":"typo3/sysext/install/Tests/Functional/Controller/EnvironmentControllerTest.php","lines":["@@ -0,0 +1,108 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Install\\Tests\\Functional\\Controller;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Test;","+use Psr\\Http\\Message\\ResponseInterface;","+use TYPO3\\CMS\\Core\\Core\\Bootstrap;","+use TYPO3\\CMS\\Core\\Core\\ClassLoadingInformation;","+use TYPO3\\CMS\\Core\\Imaging\\GraphicsCanvas;","+use TYPO3\\CMS\\Core\\Package\\PackageManager;","+use TYPO3\\CMS\\Core\\Utility\\ExtensionManagementUtility;","+use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","+use TYPO3\\CMS\\Install\\Controller\\EnvironmentController;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class EnvironmentControllerTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = ['install'];","+","+    protected array $configurationToUseInTestInstance = [","+        'BE' => [","+            // Non-empty to satisfy the install tool integrity checks, value irrelevant.","+            'installToolPassword' => '$argon2i$v=19$m=65536,t=16,p=1$placeholder',","+        ],","+    ];","+","+    public static function textTestActionsDataProvider(): array","+    {","+        return [","+            'true type' => ['imageProcessingTrueTypeAction'],","+            'GD text' => ['imageProcessingGdlibRenderTextAction'],","+            'GD nice text' => ['imageProcessingGdlibNiceTextAction'],","+            'GD nice text with shadow' => ['imageProcessingGdlibNiceTextShadowAction'],","+        ];","+    }","+","+    /**","+     * A GD build without FreeType cannot render the text of these tests, they","+     * are skipped with a note instead of showing an image without text.","+     */","+    #[Test]","+    #[DataProvider('textTestActionsDataProvider')]","+    public function textTestIsSkippedWithoutFreeTypeSupport(string $action): void","+    {","+        $response = $this->dispatchEnvironmentAction($action, false);","+","+        $body = json_decode((string)$response->getBody(), true, 512, JSON_THROW_ON_ERROR);","+        self::assertTrue($body['success']);","+        self::assertArrayNotHasKey('outputFile', $body);","+        self::assertSame('Skipped test', $body['status'][0]['title'] ?? null);","+        self::assertStringContainsString('no FreeType support', $body['status'][0]['message'] ?? '');","+    }","+","+    #[Test]","+    #[DataProvider('textTestActionsDataProvider')]","+    public function textTestIsNotSkippedWithFreeTypeSupport(string $action): void","+    {","+        if (!GraphicsCanvas::canRenderText()) {","+            self::markTestSkipped('GD of this PHP cannot render text.');","+        }","+","+        $response = $this->dispatchEnvironmentAction($action, null);","+","+        $body = json_decode((string)$response->getBody(), true, 512, JSON_THROW_ON_ERROR);","+        self::assertTrue($body['success']);","+        self::assertNotContains('Skipped test', array_column($body['status'] ?? [], 'title'));","+    }","+","+    private function dispatchEnvironmentAction(string $action, ?bool $hasFreeTypeSupport): ResponseInterface","+    {","+        $testContainer = GeneralUtility::getContainer();","+        $testSingletonInstances = GeneralUtility::getSingletonInstances();","+        $outputBufferingLevel = ob_get_level();","+        try {","+            $failsafeContainer = Bootstrap::init(ClassLoadingInformation::getClassLoader(), true);","+            if ($hasFreeTypeSupport !== null) {","+                new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, $hasFreeTypeSupport);","+            }","+            return $failsafeContainer->get(EnvironmentController::class)->{$action}();","+        } finally {","+            new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, null);","+            // Drop output buffers opened by the bootstrap, but never phpunit's own one.","+            while (ob_get_level() > $outputBufferingLevel) {","+                ob_end_clean();","+            }","+            GeneralUtility::purgeInstances();","+            GeneralUtility::setContainer($testContainer);","+            GeneralUtility::resetSingletonInstances($testSingletonInstances);","+            ExtensionManagementUtility::setPackageManager($testContainer->get(PackageManager::class));","+        }","+    }","+}"],"additions":108,"deletions":0,"truncated":false},{"path":"typo3/sysext/install/Tests/Unit/SystemEnvironment/CheckTest.php","lines":["@@ -0,0 +1,71 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Install\\Tests\\Unit\\SystemEnvironment;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\Imaging\\GraphicsCanvas;","+use TYPO3\\CMS\\Core\\Messaging\\FlashMessage;","+use TYPO3\\CMS\\Core\\Type\\ContextualFeedbackSeverity;","+use TYPO3\\CMS\\Install\\SystemEnvironment\\Check;","+use TYPO3\\TestingFramework\\Core\\Unit\\UnitTestCase;","+","+final class CheckTest extends UnitTestCase","+{","+    protected function tearDown(): void","+    {","+        new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, null);","+        parent::tearDown();","+    }","+","+    /**","+     * A GD build without FreeType still has imagettftext(), so its existence","+     * says nothing about text rendering.","+     */","+    #[Test]","+    public function checkGdLibFreeTypeSupportReportsMissingFreeType(): void","+    {","+        new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, false);","+","+        $messages = $this->checkGdLibFreeTypeSupport();","+","+        self::assertCount(1, $messages);","+        self::assertSame('PHP GD library freetype support missing', $messages[0]->getTitle());","+        self::assertSame(ContextualFeedbackSeverity::ERROR, $messages[0]->getSeverity());","+    }","+","+    #[Test]","+    public function checkGdLibFreeTypeSupportReportsFreeType(): void","+    {","+        new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, true);","+","+        $messages = $this->checkGdLibFreeTypeSupport();","+","+        self::assertCount(1, $messages);","+        self::assertSame('PHP GD library has freetype font support', $messages[0]->getTitle());","+    }","+","+    /**","+     * @return FlashMessage[]","+     */","+    private function checkGdLibFreeTypeSupport(): array","+    {","+        $subject = new Check();","+        new \\ReflectionMethod($subject, 'checkGdLibFreeTypeSupport')->invoke($subject);","+        return $subject->getMessageQueue()->getAllMessages();","+    }","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"typo3/sysext/install/Tests/Unit/SystemEnvironment/SetupCheckTest.php","lines":["@@ -0,0 +1,72 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Install\\Tests\\Unit\\SystemEnvironment;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\Imaging\\GraphicsCanvas;","+use TYPO3\\CMS\\Core\\Messaging\\FlashMessage;","+use TYPO3\\CMS\\Core\\Messaging\\FlashMessageQueue;","+use TYPO3\\CMS\\Core\\Type\\ContextualFeedbackSeverity;","+use TYPO3\\CMS\\Install\\SystemEnvironment\\SetupCheck;","+use TYPO3\\TestingFramework\\Core\\Unit\\UnitTestCase;","+","+final class SetupCheckTest extends UnitTestCase","+{","+    protected function tearDown(): void","+    {","+        new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, null);"],"additions":32,"deletions":0,"truncated":false}],"additions":503,"deletions":11,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-23T14:16:28.576084+00:00"}