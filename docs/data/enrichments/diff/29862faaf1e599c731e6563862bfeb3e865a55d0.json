$effect,","+            '20.' => ['textObjNum' => '10', ...$effectConf],","+        ]);","+","+        self::assertImageIsWhite($image);","+    }","+","+    /**","+     * An empty TEXT object is left out the same way, also when GD can render text.","+     */","+    #[DataProvider('textEffectObjectsDataProvider')]","+    #[Test]","+    public function textEffectObjectOfEmptyTextIsLeftOut(string $effect, array $effectConf): void","+    {","+        $image = $this->renderPng([","+            'XY' => '60,30',","+            'backColor' => '#ffffff',","+            'format' => 'png',","+            '10' => 'TEXT',","+            '10.' => ['text' => '', 'fontColor' => '#000000', 'fontSize' => '18', 'offset' => '2,22'],","+            '20' => $effect,","+            '20.' => ['textObjNum' => '10', ...$effectConf],","+        ]);","+","+        self::assertImageIsWhite($image);","+    }","+","+    private static function assertImageIsWhite(\\GdImage $image): void","+    {","+        for ($x = 0; $x < imagesx($image); $x++) {","+            for ($y = 0; $y < imagesy($image); $y++) {","+                self::assertSame([255, 255, 255], self::rgb($image, $x, $y));","+            }","+        }","+    }","+","     #[Test]","     public function adjustRemapsInputLevelsOnATruecolourCanvas(): void","     {"],"additions":144,"deletions":0,"truncated":false},{"path":"typo3/sysext/install/Classes/Controller/EnvironmentController.php","lines":["@@ -353,6 +353,9 @@ public function imageProcessingGetDataAction(ServerRequestInterface $request): R","      */","     public function imageProcessingTrueTypeAction(): ResponseInterface","     {","+        if (!GraphicsCanvas::canRenderText()) {","+            return $this->getImageTestResponse(['status' => [$this->freeTypeMissingMessage()]]);","+        }","         $image = @imagecreate(200, 50);","         imagecolorallocate($image, 255, 255, 55);","         $textColor = imagecolorallocate($image, 233, 14, 91);","@@ -1005,6 +1008,9 @@ privat