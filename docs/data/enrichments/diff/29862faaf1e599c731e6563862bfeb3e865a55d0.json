   $gifBuilder->setLogger($logger);","+            }","+            $gifBuilder->start($conf, []);","+            $imageResource = $gifBuilder->gifBuild();","+            self::assertNotNull($imageResource);","+        } finally {","+            restore_error_handler();","+            new \\ReflectionProperty(GraphicsCanvas::class, 'freeTypeSupport')->setValue(null, null);","+        }","+        $image = imagecreatefrompng(Environment::getPublicPath() . '/' . $imageResource->getPublicUrl());","+        self::assertInstanceOf(\\GdImage::class, $image);","+        return $image;","+    }","+","     /**","      * Renders a GIFBUILDER configuration and returns the written PNG, for tests","      * that assert on actual pixels rather than on dimensions.","@@ -586,6 +620,116 @@ public function niceTextLeavesTheTransparentBackgroundTransparent(): void","         self::assertSame(127, (imagecolorat($image, 59, 0) >> 24) & 0x7f);","     }"," ","+    /**","+     * A GD build without FreeType cannot render text, the image is built","+     * without it instead of failing with a warning.","+     */","+    #[Test]","+    public function textIsLeftOutWithoutFreeTypeSupport(): void","+    {","+        $image = $this->renderPngWithoutFreeType([","+            'XY' => '60,30',","+            'backColor' => '#ffffff',","+            'format' => 'png',","+            '10' => 'TEXT',","+            '10.' => [","+                'text' => 'Hi',","+                'fontColor' => '#000000',","+                'fontSize' => '18',","+                'fontFile' => 'EXT:core/Resources/Private/Font/nimbus.ttf',","+                'offset' => '2,22',","+            ],","+        ]);","+","+        self::assertSame(60, imagesx($image));","+        self::assertImageIsWhite($image);","+    }","+","+    /**","+     * Every GIFBUILDER image of a page is built by its own GifBuilder, also","+     * when the image file exists already. One built without a logger does","+     * not keep the next one from 