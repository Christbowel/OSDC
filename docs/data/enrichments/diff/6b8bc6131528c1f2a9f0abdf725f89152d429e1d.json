{"id":"6b8bc6131528c1f2a9f0abdf725f89152d429e1d","axis":"silent","repo":"pnpm/pnpm","sha":"6b8bc6131528c1f2a9f0abdf725f89152d429e1d","parsed":{"files":[{"path":".changeset/private-workspace-dependency.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`pnpm pack` and `pnpm publish` now fail if a package that is not private lists a private workspace package in `dependencies`. A private package is never published, so the published package could not be installed. `devDependencies`, `optionalDependencies`, `peerDependencies`, and bundled dependencies are still allowed [pnpm/pnpm#2321](https://github.com/pnpm/pnpm/issues/2321)."],"additions":5,"deletions":0,"truncated":false},{"path":".config/crate-layers.toml","lines":["@@ -308,7 +308,7 @@ pnpm-engine-runtime-node-resolver = 7"," pnpm-engine-size-probe = 7"," pnpm-env-installer = 16"," pnpm-executor = 9","-pnpm-exportable-manifest = 5","+pnpm-exportable-manifest = 6"," pnpm-ffi-fs = 1"," pnpm-ffi-webcontainer = 1"," pnpm-fs = 7"],"additions":1,"deletions":1,"truncated":false},{"path":"Cargo.lock","lines":["@@ -5616,6 +5616,7 @@ dependencies = [","  \"miette 7.6.0\",","  \"pnpm-catalogs-resolver\",","  \"pnpm-catalogs-types\",","+ \"pnpm-local-spec\",","  \"pnpm-package-manifest\",","  \"pnpm-resolving-jsr-specifier-parser\",","  \"pnpm-workspace-spec\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/workspace_packages.rs","lines":["@@ -33,6 +33,7 @@ pub fn build_workspace_package_manifest_map(","                 .or_insert_with(|| WorkspacePackageManifest {","                     name: name.to_string(),","                     version: version.to_string(),","+                    private: manifest.get(\"private\") == Some(&serde_json::Value::Bool(true)),","                 });","             if entry.version.is_empty() && !version.is_empty() {","                 entry.version = version.to_string();"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pack.rs","lines":["@@ -23,6 +23,7 @@ use std::{"," };"," "," mod output;","+mod private_dependency;"," mod publish_directory;"," "," #[test]"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pack/private_dependency.rs","lines":["@@ -0,0 +1,118 @@","+use super::read_manifest_from_tarball;","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::{","+    bin::CommandTempCwd,","+    diagnostics::assert_diagnostic_contains,","+};","+use serde_json::{","+    Value,","+    json,","+};","+use std::{","+    fs,","+    path::Path,","+    process::Command,","+};","+","+fn app_with(field: &str) -> Value {","+    json!({","+        \"name\": \"app\",","+        \"version\": \"1.0.0\",","+        field: { \"secret\": \"workspace:*\" },","+    })","+}","+","+fn write_workspace(workspace: &Path, app: Value) {","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write workspace manifest\");","+    let secret = json!({ \"name\": \"secret\", \"version\": \"1.0.0\", \"private\": true });","+    for (name, manifest) in [(\"app\", app), (\"secret\", secret)] {","+        let dir = workspace.join(\"packages\").join(name);","+        fs::create_dir_all(&dir).expect(\"create project dir\");","+        fs::write(dir.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+    }","+}","+","+fn pnpm(dir: &Path, args: &[&str]) -> Command {","+    Command::cargo_bin(\"pnpm\")","+        .expect(\"find the pnpm binary\")","+        .with_current_dir(dir)","+        .with_args(args)","+}","+","+fn assert_fails_with_the_private_dependency(command: &mut Command) {","+    let output = command.assert().failure();","+    let stderr = String::from_utf8_lossy(&output.get_output().stderr);","+    assert_diagnostic_contains(&stderr, \"ERR_PNPM_PRIVATE_WORKSPACE_DEPENDENCY\");","+    assert_diagnostic_contains(","+        &stderr,","+        r#\"\"app\" depends on the private workspace package \"secret\"\"#,","+    );","+}","+","+#[test]","+fn pack_rejects_a_private_workspace_package_in_dependencies() {","+    let CommandTempCwd { root: _root, workspace, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    write_workspace(&workspace, app_with(\"dependencies\"));","+    pnpm(&workspace, &[\"install\"]).assert().success();","+","+    assert_fails_with_the_private_dependency(&mut pnpm(&workspace.join(\"packages/app\"), &[\"pack\"]));","+}","+","+/// Without an install the dependency is found among the workspace projects.","+#[test]","+fn recursive_pack_rejects_it_before_install() {","+    let CommandTempCwd { root: _root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(&workspace, app_with(\"dependencies\"));","+","+    assert_fails_with_the_private_dependency(&mut pnpm(&workspace, &[\"-r\", \"pack\"]));","+}","+","+#[test]","+fn pack_allows_a_private_workspace_package_in_dev_dependencies() {","+    let CommandTempCwd { root: _root, workspace, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    write_workspace(&workspace, app_with(\"devDependencies\"));","+    pnpm(&workspace, &[\"install\"]).assert().success();","+","+    let app_dir = workspace.join(\"packages/app\");","+    pnpm(&app_dir, &[\"pack\"]).assert().success();","+    let manifest: Value = read_manifest_from_tarball(&app_dir.join(\"app-1.0.0.tgz\"));","+    assert_eq!(manifest[\"devDependencies\"][\"secret\"], \"1.0.0\");","+}","+","+/// Pack decides what is bundled the way the tarball's file list does: from","+/// `bundleDependencies`, or from `bundledDependencies` only when the first is","+/// absent.","+#[test]","+fn pack_exempts_only_a_bundled_private_workspace_package_it_ships() {","+    let CommandTempCwd { root: _root, workspace, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let mut bundled = app_with(\"dependencies\");","+    bundled[\"bundleDependencies\"] = json!([\"secret\"]);","+    write_workspace(&workspace, bundled);","+    pnpm(&workspace, &[\"install\"]).assert().success();","+    pnpm(&workspace.join(\"packages/app\"), &[\"pack\"]).assert().success();","+","+    let mut shadowed = app_with(\"dependencies\");","+    shadowed[\"bundleDependencies\"] = json!([]);","+    shadowed[\"bundledDependencies\"] = json!([\"secret\"]);","+    let app_dir = workspace.join(\"packages/app\");","+    fs::write(app_dir.join(\"package.json\"), shadowed.to_string()).expect(\"write package.json\");","+    assert_fails_with_the_private_dependency(&mut pnpm(&app_dir, &[\"pack\"]));","+","+    // The file list leaves out a bundled dependency that is not installed.","+    bundled_without_install(&app_dir);","+    assert_fails_with_the_private_dependency(&mut pnpm(&app_dir, &[\"pack\"]));","+}","+","+fn bundled_without_install(app_dir: &Path) {","+    let mut bundled = app_with(\"dependencies\");","+    bundled[\"bundleDependencies\"] = json!([\"secret\"]);","+    fs::write(app_dir.join(\"package.json\"), bundled.to_string()).expect(\"write package.json\");","+    fs::remove_file(app_dir.join(\"node_modules/secret\"))","+        .or_else(|_| fs::remove_dir_all(app_dir.join(\"node_modules/secret\")))","+        .expect(\"remove the installed secret\");","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"pnpm/crates/exportable-manifest/Cargo.toml","lines":["@@ -13,6 +13,7 @@ repository.workspace = true"," [dependencies]"," pnpm-catalogs-resolver = { workspace = true }"," pnpm-catalogs-types = { workspace = true }","+pnpm-local-spec = { workspace = true }"," pnpm-package-manifest = { workspace = true }"," pnpm-resolving-jsr-specifier-parser = { workspace = true }"," pnpm-workspace-spec = { workspace = true }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/exportable-manifest/src/create.rs","lines":["@@ -302,7 +302,7 @@ fn convert_dependency_for_publish("," /// the package being exported, so it means the same place a local"," /// dependency written directly in that package's manifest would. Both"," /// are read relative to the exported manifest.","-fn replace_catalog_protocol(","+pub(crate) fn replace_catalog_protocol(","     alias: String,","     spec: &str,","     dir: &Path,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/exportable-manifest/src/lib.rs","lines":["@@ -13,6 +13,11 @@ pub use create::{","     create_exportable_manifest,","     read_readme_file,"," };","+pub use private_dependency::{","+    PrivateWorkspaceDependencies,","+    PrivateWorkspaceDependencyError,","+    private_workspace_dependencies,","+};"," pub use replace::{","     CannotResolveReason,","     CannotResolveWorkspaceProtocolError,","@@ -25,6 +30,7 @@ pub use replace::{"," pub use transform::TransformError;"," "," mod create;","+mod private_dependency;"," mod replace;"," mod transform;"," "],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/exportable-manifest/src/private_dependency.rs","lines":["@@ -0,0 +1,223 @@","+//! Rejects a publishable manifest whose `dependencies` name a private","+//! workspace package. The published manifest would point at a version","+//! that never reaches the registry, so nobody could install it.","+","+use crate::{","+    create::{","+        CreateExportableManifestError,","+        CreateExportableManifestOptions,","+        replace_catalog_protocol,","+    },","+    replace::{","+        WorkspacePackageLookup,","+        workspace_target_manifest,","+    },","+};","+use derive_more::{","+    Display,","+    Error,","+};","+use miette::Diagnostic;","+use pnpm_local_spec::is_local_filesystem_specifier;","+use serde_json::{","+    Map,","+    Value,","+};","+use std::path::Path;","+","+const DEPENDENCY_FIELDS: &[&str] =","+    &[\"dependencies\", \"devDependencies\", \"optionalDependencies\", \"peerDependencies\"];","+","+/// A publishable package lists a private workspace package in","+/// `dependencies`.","+#[derive(Debug, Display, Error, Diagnostic)]","+#[display(r#\"\"{package_name}\" depends on the private workspace package \"{dep_name}\"\"#)]","+#[diagnostic(","+    code(ERR_PNPM_PRIVATE_WORKSPACE_DEPENDENCY),","+    help(","+        r#\"A private package is never published. Move \"{dep_name}\" to devDependencies or bundleDependencies, or remove \"private\": true from its package.json.\"#","+    )","+)]","+pub struct PrivateWorkspaceDependencyError {","+    #[error(not(source))]","+    pub package_name: String,","+    pub dep_name: String,","+}","+","+/// The private workspace packages a manifest points at through `workspace:`","+/// specifiers, collected by [`private_workspace_dependencies`] before the","+/// `beforePacking` hooks run and checked by [`Self::reject`] after them.","+#[derive(Debug, Default)]","+pub struct PrivateWorkspaceDependencies {","+    /// Registry names of the private targets.","+    packages: Vec<String>,","+    /// Keys of `dependencies` whose `workspace:` specifier names one of","+    /// `packages`.","+    keys: Vec<String>,","+    /// The `dependencies` of the exported manifest, before the hooks.","+    exported: Map<String, Value>,","+}","+","+/// Collect the private workspace packages that any of `original`'s dependency","+/// fields point at through a `workspace:` specifier, once a `catalog:` entry","+/// is resolved. Every field counts, because a hook can move an entry into","+/// `dependencies`. Record the exported manifest with","+/// [`PrivateWorkspaceDependencies::record_exported`] before the hooks run.","+pub fn private_workspace_dependencies(","+    dir: &Path,","+    original: &Value,","+    opts: &CreateExportableManifestOptions<'_>,","+) -> Result<PrivateWorkspaceDependencies, CreateExportableManifestError> {","+    let dependencies = DEPENDENCY_FIELDS","+        .iter()","+        .filter_map(|field| {","+            let entries = original.get(*field).and_then(Value::as_object)?;","+            Some(","+                entries","+                    .iter()","+                    .map(move |entry| (*field, entry)),","+            )","+        });","+    let mut private = PrivateWorkspaceDependencies::default();","+    for (field, (dep_name, spec)) in dependencies.flatten() {","+        let Some(spec) = spec.as_str() else {","+            continue;","+        };","+        let spec = replace_catalog_protocol(dep_name.clone(), spec, dir, opts)?;","+        let Some(package) = private_workspace_package(dep_name, &spec, dir, opts)? else {","+            continue;","+        };","+        if !private.packages.contains(&package) {","+            private.packages.push(package);","+        }","+        if field == \"dependencies\" {","+            private.keys.push(dep_name.clone());","+        }","+    }","+    Ok(private)","+}","+","+impl PrivateWorkspaceDependencies {","+    /// Keep the `dependencies` of the manifest pack exported, before the","+    /// `beforePacking` hooks change it.","+    pub fn record_exported(&mut self, exported: &Value) {","+        if let Some(dependencies) = exported.get(\"dependencies\").and_then(Value::as_object) {","+            self.exported.clone_from(dependencies);","+        }","+    }","+","+    /// Fail when a `dependencies` entry of the publishable manifest","+    /// `published` installs one of the private packages from the registry.","+    /// An entry counts when it was a private `workspace:` dependency, or when","+    /// a hook added or changed it, so an untouched registry dependency that","+    /// shares the private package's name is allowed. Not checked: the entries","+    /// named in `bundled`, which ship inside the tarball, entries shadowed by","+    /// an `optionalDependencies` entry of the same name, which is installed","+    /// instead, and a private manifest, which is never published.","+    pub fn reject(","+        &self,","+        published: &Value,","+        bundled: &[String],","+    ) -> Result<(), PrivateWorkspaceDependencyError> {","+        let Some(published) = published.as_object() else {","+            return Ok(());","+        };","+        if self.packages.is_empty() || is_private(published) {","+            return Ok(());","+        }","+        let Some(dependencies) = published.get(\"dependencies\").and_then(Value::as_object) else {","+            return Ok(());","+        };","+        let optional = published.get(\"optionalDependencies\").and_then(Value::as_object);","+        let rejected = dependencies","+            .iter()","+            .filter(|(dep_name, _)| !bundled.contains(dep_name))","+            .filter(|(dep_name, _)| {","+                !optional.is_some_and(|optional| optional.contains_key(dep_name.as_str()))","+            })","+            .filter(|(dep_name, spec)| {","+                self.keys.contains(dep_name) || self.exported.get(dep_name.as_str()) != Some(spec)","+            })","+            .filter_map(|(dep_name, spec)| Some((dep_name.as_str(), spec.as_str()?)))","+            .flat_map(|(dep_name, spec)| registry_packages(dep_name, spec))","+            .flatten()","+            .find(|package| {","+                self.packages","+                    .iter()","+                    .any(|private| private == package)","+            });","+        let Some(dep_name) = rejected else {","+            return Ok(());","+        };","+        let package_name = published","+            .get(\"name\")","+            .and_then(Value::as_str)","+            .unwrap_or_default();","+        Err(PrivateWorkspaceDependencyError {","+            package_name: package_name.to_string(),","+            dep_name: dep_name.to_string(),","+        })","+    }","+}","+","+/// The registry name of the private workspace package `spec` points at, when","+/// it is a `workspace:` specifier whose target, resolved the way the","+/// workspace-protocol rewrite resolves it, is private.","+fn private_workspace_package(","+    dep_name: &str,","+    spec: &str,","+    dir: &Path,","+    opts: &CreateExportableManifestOptions<'_>,","+) -> Result<Option<String>, CreateExportableManifestError> {","+    let lookup = WorkspacePackageLookup {","+        packages: opts.workspace_packages,","+        prefer_workspace_for: opts.bumped_workspace_packages,","+    };","+    let target = workspace_target_manifest(dep_name, spec, dir, opts.modules_dir, lookup)","+        .map_err(CreateExportableManifestError::ReplaceWorkspaceProtocol)?;","+    Ok(target","+        .filter(|manifest| manifest.private)","+        .map(","+            |manifest| {","+                if manifest.name.is_empty() { dep_name.to_string() } else { manifest.name }","+            },","+        ))","+}","+","+/// The registry packages a published dependency may install, read","+/// conservatively so no form that reaches the private package slips by:","+/// - `npm:<name>@<range>` names `<name>`.","+/// - A bare `npm:<x>` is `<x>` at the default tag, or a range for `dep_name`,","+///   so it names both.","+/// - A local path names none, and so does a URL, a git source, or another","+///   protocol: a first `||` member with a `:` or `/`.","+/// - Anything else, a range or a tag, is read as `dep_name`, even when a","+///   later union member names another protocol.","+fn registry_packages<'a>(dep_name: &'a str, spec: &'a str) -> [Option<&'a str>; 2] {","+    if is_local_filesystem_specifier(spec) {","+        return [None, None];","+    }","+    match spec.strip_prefix(\"npm:\") {","+        Some(aliased) => match aliased.rfind('@') {","+            Some(index) if index > 0 => [Some(&aliased[..index]), None],","+            _ => [Some(aliased), Some(dep_name)],","+        },","+        None if names_another_source(spec) => [None, None],","+        None => [Some(dep_name), None],","+    }","+}","+","+fn names_another_source(spec: &str) -> bool {","+    let first_member = spec","+        .split(\"||\")","+        .next()","+        .unwrap_or_default();","+    first_member.contains(':') || first_member.contains('/')","+}","+","+fn is_private(manifest: &Map<String, Value>) -> bool {","+    manifest.get(\"private\") == Some(&Value::Bool(true))","+}","+","+#[cfg(test)]","+mod tests;"],"additions":223,"deletions":0,"truncated":false},{"path":"pnpm/crates/exportable-manifest/src/private_dependency/tests.rs","lines":["@@ -0,0 +1,309 @@","+use super::{","+    PrivateWorkspaceDependencyError,","+    private_workspace_dependencies,","+};","+use crate::{","+    CreateExportableManifestOptions,","+    WorkspacePackageManifest,","+    create_exportable_manifest,","+};","+use pnpm_catalogs_types::{","+    Catalog,","+    Catalogs,","+};","+use serde_json::{","+    Value,","+    json,","+};","+use std::{","+    collections::HashMap,","+    fs,","+};","+use tempfile::TempDir;","+","+fn fixture(secret_private: bool) -> TempDir {","+    let temp = TempDir::new().expect(\"tempdir\");","+    let secret = json!({ \"name\": \"secret\", \"version\": \"1.0.0\", \"private\": secret_private });","+    for dir in [temp.path().join(\"app/node_modules/secret\"), temp.path().join(\"secret\")] {","+        fs::create_dir_all(&dir).unwrap();","+        fs::write(dir.join(\"package.json\"), secret.to_string()).unwrap();","+    }","+    temp","+}","+","+fn export_with(","+    temp: &TempDir,","+    manifest: &Value,","+    workspace_packages: Option<&HashMap<String, WorkspacePackageManifest>>,","+    before_packing: impl FnOnce(&mut Value),","+) -> Result<Value, PrivateWorkspaceDependencyError> {","+    let catalogs = Catalogs::from([(","+        \"default\".to_string(),","+        Catalog::from([(\"secret\".to_string(), \"workspace:*\".to_string())]),","+    )]);","+    let dir = temp.path().join(\"app\");","+    let opts = CreateExportableManifestOptions {","+        catalogs: &catalogs,","+        workspace_dir: None,","+        modules_dir: None,","+        skip_manifest_obfuscation: false,","+        embed_readme: false,","+        workspace_packages,","+        bumped_workspace_packages: None,","+    };","+    let mut private = private_workspace_dependencies(&dir, manifest, &opts).expect(\"find private\");","+    let mut published = create_exportable_manifest(&dir, manifest, &opts).expect(\"exportable\");","+    private.record_exported(&published);","+    before_packing(&mut published);","+    private.reject(&published, &[])?;","+    Ok(published)","+}","+","+fn export(","+    temp: &TempDir,","+    manifest: &Value,","+    workspace_packages: Option<&HashMap<String, WorkspacePackageManifest>>,","+) -> Result<Value, PrivateWorkspaceDependencyError> {","+    export_with(temp, manifest, workspace_packages, |_| {})","+}","+","+fn app(field: &str, spec: &str) -> Value {","+    json!({ \"name\": \"app\", \"version\": \"1.0.0\", field: { \"secret\": spec } })","+}","+","+fn assert_rejected(result: Result<Value, PrivateWorkspaceDependencyError>) {","+    let error = result.expect_err(\"the private dependency is rejected\");","+    assert_eq!((error.package_name.as_str(), error.dep_name.as_str()), (\"app\", \"secret\"));","+}","+","+#[test]","+fn rejects_a_private_workspace_package_in_dependencies() {","+    let temp = fixture(true);","+    for spec in","+        [\"workspace:*\", \"workspace:^1.0.0\", \"workspace:secret@*\", \"workspace:../secret\", \"catalog:\"]","+    {","+        assert_rejected(export(&temp, &app(\"dependencies\", spec), None));","+    }","+}","+","+#[test]","+fn falls_back_to_the_workspace_packages_when_not_installed() {","+    let temp = fixture(true);","+    fs::remove_dir_all(temp.path().join(\"app/node_modules\")).unwrap();","+    let packages = HashMap::from([(","+        \"secret\".to_string(),","+        WorkspacePackageManifest {","+            name: \"secret\".to_string(),","+            version: \"1.0.0\".to_string(),","+            private: true,","+        },","+    )]);","+    assert_rejected(export(&temp, &app(\"dependencies\", \"workspace:*\"), Some(&packages)));","+}","+","+#[test]","+fn allows_what_does_not_need_the_private_package_from_the_registry() {","+    let temp = fixture(true);","+    let mut private = app(\"dependencies\", \"workspace:*\");","+    private[\"private\"] = json!(true);","+    for manifest in [","+        app(\"devDependencies\", \"workspace:*\"),","+        app(\"optionalDependencies\", \"workspace:*\"),","+        app(\"peerDependencies\", \"workspace:*\"),","+        private,","+    ] {","+        export(&temp, &manifest, None).expect(\"manifest is exportable\");","+    }","+}","+","+#[test]","+fn allows_a_publishable_workspace_package() {","+    let temp = fixture(false);","+    let published = export(&temp, &app(\"dependencies\", \"workspace:*\"), None).expect(\"exportable\");","+    assert_eq!(published[\"dependencies\"][\"secret\"], \"1.0.0\");","+}","+","+#[test]","+fn ignores_a_registry_dependency_installed_from_elsewhere() {","+    let temp = fixture(true);","+    export(&temp, &app(\"dependencies\", \"^1.0.0\"), None).expect(\"manifest is exportable\");","+}","+","+#[test]","+fn allows_a_dependency_a_before_packing_hook_removes_or_replaces() {","+    let temp = fixture(true);","+    let manifest = app(\"dependencies\", \"workspace:*\");","+    export_with(&temp, &manifest, None, |published| {","+        published[\"dependencies\"]","+            .as_object_mut()","+            .unwrap()","+            .remove(\"secret\");","+    })","+    .expect(\"the hook removed the dependency\");","+    export_with(&temp, &manifest, None, |published| {","+        published[\"dependencies\"][\"secret\"] = json!(\"npm:public-secret@^1.0.0\");","+    })","+    .expect(\"the hook pointed the dependency at a public package\");","+    export_with(&temp, &manifest, None, |published| {","+        published[\"dependencies\"][\"secret\"] = json!(r\".\\vendor\\public-secret.tgz\");","+    })","+    .expect(\"the hook pointed the dependency at a local tarball\");","+    for remote in [\"https://example.com/public-secret.tgz\", \"github:owner/public-secret\"] {","+        export_with(&temp, &manifest, None, |published| {","+            published[\"dependencies\"][\"secret\"] = json!(remote);","+        })","+        .expect(\"the hook pointed the dependency at a remote source\");","+    }","+}","+","+/// The check falls back to the workspace packages wherever the rewrite does:","+/// an installed manifest without a version, or a missing relative target.","+#[test]","+fn follows_the_rewrite_to_the_workspace_packages() {","+    let temp = fixture(true);","+    fs::write(","+        temp.path().join(\"app/node_modules/secret/package.json\"),","+        json!({ \"name\": \"secret\" }).to_string(),","+    )","+    .unwrap();","+    fs::remove_dir_all(temp.path().join(\"secret\")).unwrap();","+    let packages = HashMap::from([(","+        \"secret\".to_string(),","+        WorkspacePackageManifest {","+            name: \"secret\".to_string(),","+            version: \"1.0.0\".to_string(),","+            private: true,","+        },","+    )]);","+    for spec in [\"workspace:*\", \"workspace:../secret\"] {","+        assert_rejected(export(&temp, &app(\"dependencies\", spec), Some(&packages)));","+    }","+}","+","+/// A private package without a `version` is still private, even though the","+/// rewrite cannot resolve `workspace:*` to it.","+#[test]","+fn rejects_a_private_workspace_package_without_a_version() {","+    let temp = TempDir::new().expect(\"tempdir\");","+    let secret = json!({ \"name\": \"secret\", \"private\": true });","+    let installed = temp.path().join(\"app/node_modules/secret\");","+    fs::create_dir_all(&installed).unwrap();","+    fs::write(installed.join(\"package.json\"), secret.to_string()).unwrap();","+    assert_rejected(export(&temp, &app(\"dependencies\", \"workspace:^1.0.0\"), None));","+","+    fs::remove_dir_all(temp.path().join(\"app/node_modules\")).unwrap();","+    let packages = HashMap::from([(","+        \"secret\".to_string(),","+        WorkspacePackageManifest {"