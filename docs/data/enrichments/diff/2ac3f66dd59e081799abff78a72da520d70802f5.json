{"id":"2ac3f66dd59e081799abff78a72da520d70802f5","axis":"silent","repo":"redis/redis","sha":"2ac3f66dd59e081799abff78a72da520d70802f5","parsed":{"files":[{"path":"redis.conf","lines":["@@ -909,7 +909,7 @@ replica-priority 100"," # Enable client compression for replication at specified level when connecting to"," # master 0-22 (0 for disabled compression). Currently only zstd compression lib"," # is supported hence the compression values 1-22 are related to it.","-# NOTE: This setting only works when io-threads > 1","+# Requires io-threads > 1."," # repl-compression 0"," #"," # When compression is enabled specify maximum latency in ms before the","@@ -1440,6 +1440,33 @@ lazyfree-lazy-user-flush no"," # --threads option to match the number of Redis threads, otherwise you'll not"," # be able to notice the improvements."," ","+# Select the client types eligible for I/O threads. Multiple values can be","+# combined. Other clients remain on the main thread. Replication connections","+# must also satisfy the usual synchronization and safety requirements.","+#","+# normal                  Ordinary client connections.","+# replica                 Downstream replica connections, compressed or not.","+# master                  Upstream master connections, compressed or not.","+# replication             Both replica and master.","+# replica-compressed      Compressed downstream replica connections.","+# master-compressed       Compressed upstream master connections.","+# replication-compressed  Both replica-compressed and master-compressed.","+# all                     All of the above (the default).","+#","+# Compression categories refer to the compression actually negotiated by the","+# connection. Compression-only selections require compression support and","+# repl-compression > 0, unless the corresponding generic type is also selected.","+# Conversely, repl-compression > 0 requires a replication type in this setting.","+# Compression can be negotiated only for directions eligible for I/O workers.","+# This setting never creates threads; io-threads must be greater than 1 to","+# enable I/O workers.","+#","+# For example, to use I/O threads for ordinary clients and compressed","+# replication connections:","+# io-threads-client-types \"normal replication-compressed\"","+#","+# io-threads-client-types all","+"," ############################ KERNEL OOM CONTROL ##############################"," "," # On Linux, it is possible to hint the kernel OOM killer on what processes"],"additions":28,"deletions":1,"truncated":false},{"path":"src/config.c","lines":["@@ -105,6 +105,18 @@ configEnum cluster_slot_stats_enum[] = {","     {NULL, 0}"," };"," ","+configEnum io_threads_client_types_enum[] = {","+    {\"all\", IO_THREADS_CLIENT_TYPE_ALL},","+    {\"replication-compressed\", IO_THREADS_CLIENT_TYPE_REPLICATION_COMPRESSED},","+    {\"master-compressed\", IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED},","+    {\"replica-compressed\", IO_THREADS_CLIENT_TYPE_REPLICA_COMPRESSED},","+    {\"replication\", IO_THREADS_CLIENT_TYPE_REPLICATION},","+    {\"master\", IO_THREADS_CLIENT_TYPE_MASTER},","+    {\"replica\", IO_THREADS_CLIENT_TYPE_REPLICA},","+    {\"normal\", IO_THREADS_CLIENT_TYPE_NORMAL},","+    {NULL, 0}","+};","+"," configEnum repl_diskless_load_enum[] = {","     {\"disabled\", REPL_DISKLESS_LOAD_DISABLED},","     {\"on-empty-db\", REPL_DISKLESS_LOAD_WHEN_DB_EMPTY},","@@ -703,6 +715,23 @@ void loadServerConfigFromString(char *config) {","             goto loaderr;","         }"," ","+        int client_types = server.io_threads_client_types;","+        int compression_only =","+            ((client_types & IO_THREADS_CLIENT_TYPE_REPLICA_COMPRESSED) &&","+             !(client_types & IO_THREADS_CLIENT_TYPE_REPLICA)) ||","+            ((client_types & IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED) &&","+             !(client_types & IO_THREADS_CLIENT_TYPE_MASTER));","+        if (compression_only && server.repl_compression == 0) {","+            err = \"io-threads-client-types compression-only selectors require compression support and repl-compression > 0\";","+            goto loaderr;","+        }","+        if (server.repl_compression > 0 &&","+            !(client_types & (IO_THREADS_CLIENT_TYPE_REPLICATION | IO_THREADS_CLIENT_TYPE_REPLICATION_COMPRESSED)))","+        {","+            err = \"repl-compression requires io-threads-client-types to include replication clients\";","+            goto loaderr;","+        }","+","         /* in case cluster mode is enabled dbnum must be 1 */","         if (server.cluster_enabled && server.dbnum > 1) {","             serverLog(LL_WARNING, \"WARNING: Changing databases number from %d to 1 since we are in cluster mode\", server.dbnum);","@@ -3577,6 +3606,7 @@ standardConfig static_configs[] = {","     createEnumConfig(\"propagation-error-behavior\", NULL, MODIFIABLE_CONFIG, propagation_error_behavior_enum, server.propagation_error_behavior, PROPAGATION_ERR_BEHAVIOR_IGNORE, NULL, NULL),","     createEnumConfig(\"shutdown-on-sigint\", NULL, MODIFIABLE_CONFIG | MULTI_ARG_CONFIG, shutdown_on_sig_enum, server.shutdown_on_sigint, 0, isValidShutdownOnSigFlags, NULL),","     createEnumConfig(\"shutdown-on-sigterm\", NULL, MODIFIABLE_CONFIG | MULTI_ARG_CONFIG, shutdown_on_sig_enum, server.shutdown_on_sigterm, 0, isValidShutdownOnSigFlags, NULL),","+    createEnumConfig(\"io-threads-client-types\", NULL, IMMUTABLE_CONFIG | MULTI_ARG_CONFIG, io_threads_client_types_enum, server.io_threads_client_types, IO_THREADS_CLIENT_TYPE_ALL, NULL, NULL),"," ","     /* Integer configs */","     createIntConfig(\"databases\", NULL, IMMUTABLE_CONFIG, 1, INT_MAX, server.dbnum, 16, INTEGER_CONFIG, NULL, NULL),"],"additions":30,"deletions":0,"truncated":false},{"path":"src/iothread.c","lines":["@@ -71,8 +71,9 @@ void updateClientDataFromIOThread(client *c) {","         c->read_reploff = c->io_read_reploff;","     }"," ","-    /* Update replication buffer referenced node if IO thread has sent some data. */","-    if (c->flags & CLIENT_SLAVE && c->ref_repl_buf_node != NULL &&","+    /* A normal client can become a replica while its command is processed in","+     * main. Its IO replication state exists only after the first replica handoff. */","+    if (c->flags & CLIENT_SLAVE && c->ref_repl_buf_node != NULL && c->io_curr_repl_node != NULL &&","         (c->io_curr_repl_node != c->ref_repl_buf_node ||","          c->io_curr_block_pos != c->ref_block_pos))","     {","@@ -290,6 +291,20 @@ void fetchClientFromIOThread(client *c) {","  *   that may overlap with CLIENT_MASTER/SLAVE - CLOSE_ASAP, MONITOR,","  *   (UN)BLOCKED, TRACKING. */"," int isClientMustHandledByMainThread(client *c) {","+    /* Select replication connections by their role and negotiated compression,","+     * then apply the safety and replication-state checks below. */","+    if (server.io_threads_client_types != IO_THREADS_CLIENT_TYPE_ALL) {","+        int type = IO_THREADS_CLIENT_TYPE_NORMAL;","+        if (c->flags & CLIENT_SLAVE) {","+            type = IO_THREADS_CLIENT_TYPE_REPLICA;","+            if (c->compression_level > 0) type |= IO_THREADS_CLIENT_TYPE_REPLICA_COMPRESSED;","+        } else if (c->flags & CLIENT_MASTER) {","+            type = IO_THREADS_CLIENT_TYPE_MASTER;","+            if (server.repl_master_compression_level > 0) type |= IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED;","+        }","+        if (!(server.io_threads_client_types & type)) return 1;","+    }","+","     if (c->flags & (CLIENT_CLOSE_ASAP |","                     CLIENT_PUBSUB | CLIENT_MONITOR | CLIENT_BLOCKED |","                     CLIENT_UNBLOCKED | CLIENT_TRACKING | CLIENT_LUA_DEBUG |"],"additions":17,"deletions":2,"truncated":false},{"path":"src/networking.c","lines":["@@ -1745,7 +1745,8 @@ void clientAcceptHandler(connection *conn) {","                           c);"," ","     /* Assign the client to an IO thread */","-    if (server.io_threads_num > 1) assignClientToIOThread(c);","+    if (server.io_threads_num > 1 && !isClientMustHandledByMainThread(c))","+        assignClientToIOThread(c);"," }"," "," void acceptCommonHandler(connection *conn, int flags, char *ip) {"],"additions":2,"deletions":1,"truncated":false},{"path":"src/replication.c","lines":["@@ -78,6 +78,11 @@ void setReplCompression(int level) {"," #endif"," }"," ","+/* Compression requires an IO worker eligible for this replication direction. */","+static int canUseReplCompression(int client_types) {","+    return server.io_threads_num > 1 && (server.io_threads_client_types & client_types);","+}","+"," "," /* A reference to diskless loading rio to abort it asynchronously. It's needed","  * for rdbchannel replication. While loading from rdbchannel connection, we may","@@ -1508,7 +1513,7 @@ void replconfCommand(client *c) {","             if ((getLongFromObjectOrReply(c,c->argv[j+1], &level,NULL) != C_OK))","                 return;"," ","-            if (server.io_threads_num > 1) {","+            if (canUseReplCompression(IO_THREADS_CLIENT_TYPE_REPLICA | IO_THREADS_CLIENT_TYPE_REPLICA_COMPRESSED)) {","                 if (level == (long)server.repl_compression) {","                     serverLog(LL_NOTICE, \"Client #%llu request for replication \"","                             \"compression with level %ld accepted\",","@@ -1527,7 +1532,7 @@ void replconfCommand(client *c) {","             } else {","                 serverLog(LL_NOTICE, \"Client #%llu request for replication \"","                           \"compression rejected. Replication compression is only \"","-                          \"enabled with IO threads.\",","+                          \"enabled with eligible IO threads.\",","                           (unsigned long long)c->id);","                 c->compression_level = 0;","                 addReplyError(c, \"Master has not enabled replication compression\");","@@ -3254,12 +3259,17 @@ void syncWithMaster(connection *conn) {","             if (err) goto write_error;","         }"," ","-        /* Try to setup client compression if we're configured so */","-        if (server.repl_compression > 0) {","+        /* Request compression only if the upstream connection can use an IO worker. */","+        if (server.repl_compression > 0 &&","+            canUseReplCompression(IO_THREADS_CLIENT_TYPE_MASTER | IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED))","+        {","             sds level = sdsfromlonglong(server.repl_compression);","             err = sendCommand(conn, \"REPLCONF\", \"compression\", level, NULL);","             sdsfree(level);","             if (err) goto write_error;","+        } else if (server.repl_compression > 0) {","+            serverLog(LL_NOTICE, \"Not requesting replication compression from master: \"","+                                \"no eligible IO thread for master connections.\");","         }"," ","         /* Inform the master of our (slave) capabilities.","@@ -3347,8 +3357,12 @@ void syncWithMaster(connection *conn) {","         return;","     }"," ","-    if (server.repl_state == REPL_STATE_RECEIVE_CLIENT_COMP && server.repl_compression <= 0)","+    if (server.repl_state == REPL_STATE_RECEIVE_CLIENT_COMP &&","+        (server.repl_compression <= 0 ||","+         !canUseReplCompression(IO_THREADS_CLIENT_TYPE_MASTER | IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED)))","+    {","         server.repl_state = REPL_STATE_RECEIVE_CAPA_REPLY;","+    }"," ","     if (server.repl_state == REPL_STATE_RECEIVE_CLIENT_COMP) {","         err = receiveSynchronousResponse(conn);"],"additions":19,"deletions":5,"truncated":false},{"path":"src/server.h","lines":["@@ -242,6 +242,21 @@ extern int configOOMScoreAdjValuesDefaults[CONFIG_OOM_COUNT];"," /* Max number of IO threads */"," #define IO_THREADS_MAX_NUM 128"," ","+/* Client types eligible for IO threads. Replication roles refer to the remote","+ * endpoint: replicas connect downstream, while the master is upstream.","+ * Generic replication types include both compressed and uncompressed links. */","+#define IO_THREADS_CLIENT_TYPE_NORMAL (1 << 0)","+#define IO_THREADS_CLIENT_TYPE_REPLICA (1 << 1)","+#define IO_THREADS_CLIENT_TYPE_MASTER (1 << 2)","+#define IO_THREADS_CLIENT_TYPE_REPLICA_COMPRESSED (1 << 3)","+#define IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED (1 << 4)","+#define IO_THREADS_CLIENT_TYPE_REPLICATION \\","+    (IO_THREADS_CLIENT_TYPE_REPLICA | IO_THREADS_CLIENT_TYPE_MASTER)","+#define IO_THREADS_CLIENT_TYPE_REPLICATION_COMPRESSED \\","+    (IO_THREADS_CLIENT_TYPE_REPLICA_COMPRESSED | IO_THREADS_CLIENT_TYPE_MASTER_COMPRESSED)","+#define IO_THREADS_CLIENT_TYPE_ALL \\","+    (IO_THREADS_CLIENT_TYPE_NORMAL | IO_THREADS_CLIENT_TYPE_REPLICATION | IO_THREADS_CLIENT_TYPE_REPLICATION_COMPRESSED)","+"," /* To make IO threads and main thread run in parallel, we will transfer clients","  * between them if the number of clients in the pending list reaches this value. */"," #define IO_THREAD_MAX_PENDING_CLIENTS 16","@@ -2210,6 +2225,7 @@ struct redisServer {","     redisAtomic uint64_t next_client_id; /* Next client unique ID. Incremental. */","     int protected_mode;         /* Don't accept external connections. */","     int io_threads_num;         /* Number of IO threads to use. */","+    int io_threads_client_types; /* Client types eligible for IO threads. */","     int io_threads_clients_num[IO_THREADS_MAX_NUM]; /* Number of clients assigned to each IO thread. */","     int io_threads_do_reads;    /* Read and parse from IO threads? */","     int io_threads_active;      /* Is IO threads currently active? */"],"additions":16,"deletions":0,"truncated":false},{"path":"tests/integration/iothread-client-types.tcl","lines":["@@ -0,0 +1,397 @@","+#","+# Copyright (c) 2026-Present, Redis Ltd.","+# All rights reserved.","+#","+# Licensed under your choice of (a) the Redis Source Available License 2.0","+# (RSALv2); or (b) the Server Side Public License v1 (SSPLv1); or (c) the","+# GNU Affero General Public License v3 (AGPLv3).","+#","+","+proc compression_client_io_thread {info} {","+    assert {[regexp {io-thread=(\\d+)} $info - tid]}","+    return $tid","+}","+","+# Identify the replica by its listening port so connection order does not matter.","+proc compression_replica_io_thread {master port} {","+    foreach line [split [$master info replication] \"\\r\\n\"] {","+        if {[string match \"slave*:*,port=$port,*\" $line]} {","+            return [compression_client_io_thread $line]","+        }","+    }","+    return -1","+}","+","+start_server {tags {repl iothreads external:skip} overrides {io-threads 4} omit {io-threads-client-types repl-compression repl-compression-max-latency}} {","+    test {IO thread client types default to all and are immutable} {","+        assert_equal {io-threads-client-types all} [r config get io-threads-client-types]","+        assert {[compression_client_io_thread [r client info]] > 0}","+        assert_error {*immutable config*} {r config set io-threads-client-types normal}","+    }","+","+    test {IO thread client types reject unknown selectors} {","+        catch {exec src/redis-server --port 0 --io-threads-client-types unknown} err","+        assert_match {*io-threads-client-types*unknown*argument(s) must be one of the following*} $err","+    }","+","+    test {Compression-only IO thread selectors require enabled compression} {","+        foreach client_types {","+            replica-compressed","+            master-compressed","+            replication-compressed","+            {normal replica-compressed}","+            {replica master-compressed}","+        } {","+            catch {exec src/redis-server --port 0 --io-threads 4 --io-threads-client-types $client_types} err","+            assert_match {*io-threads-client-types compression-only selectors require compression support and repl-compression > 0*} $err","+        }","+    }","+","+    if {$::compression} {","+        test {Compression-only IO thread selector validation is independent of argument order} {","+            foreach options {","+                {--io-threads-client-types replication-compressed --repl-compression 0}","+                {--repl-compression 0 --io-threads-client-types replication-compressed}","+            } {","+                catch {exec src/redis-server --port 0 --io-threads 4 {*}$options} err","+                assert_match {*io-threads-client-types compression-only selectors require compression support and repl-compression > 0*} $err","+            }","+        }","+","+        test {Replication compression requires an eligible replication client type} {","+            foreach options {","+                {--io-threads-client-types normal --repl-compression 1}","+                {--repl-compression 1 --io-threads-client-types normal}","+            } {","+                catch {exec src/redis-server --port 0 --io-threads 4 {*}$options} err","+                assert_match {*repl-compression requires io-threads-client-types to include replication clients*} $err","+            }","+        }","+    }","+}","+","+# Generic role selectors include both plain and compressed connections.","+# Compression-only selectors require a compression build and repl-compression > 0.","+set selector_cases {","+    0 normal normal                                               1 1 0 0 0","+    0 replica replica                                             0 0 1 0 0","+    0 master master                                             0 0 0 1 0","+    0 replication replication                                     0 0 1 1 0","+    0 all all                                                     1 1 1 1 0","+    0 {replica master} {replica master}                           0 0 1 1 0","+    0 {normal replica} {normal master}                            1 1 1 1 0","+    0 {replica replica-compressed} {master master-compressed}   0 0 1 1 0","+}","+if {$::compression} {","+    lappend selector_cases \\","+        1 replica all                                             0 1 1 1 1 \\","+        1 all master                                             1 0 1 1 1 \\","+        1 replication replication                                 0 0 1 1 1 \\","+        1 replica-compressed all                                 0 1 1 1 1 \\","+        1 all master-compressed                                 1 0 1 1 1 \\","+        1 replication-compressed replication-compressed         0 0 1 1 1 \\","+        1 all all                                                 1 1 1 1 1 \\","+        1 {replica-compressed master-compressed} {replica-compressed master-compressed} 0 0 1 1 1 \\","+        1 {normal replica master-compressed} {normal replica master-compressed} 1 1 1 1 1 \\","+        1 replica replica                                         0 0 1 0 0 \\","+        1 master master                                         0 0 0 1 0","+}","+foreach {compression_level master_types replica_types master_normal_worker replica_normal_worker replica_worker primary_worker compressed} $selector_cases {","+    set overrides [list io-threads 4 io-threads-client-types $master_types save \"\"]","+    set omit {repl-compression repl-compression-max-latency}","+    if {$compression_level} {","+        lappend overrides repl-compression $compression_level repl-compression-max-latency 10","+        set omit {}","+    }","+    set context \"master-types=$master_types replica-types=$replica_types compression=$compression_level\"","+","+    start_server [list tags {repl iothreads external:skip} overrides $overrides omit $omit] {","+        start_server [list overrides [concat $overrides [list io-threads-client-types $replica_types]] omit $omit] {","+            test \"IO thread client type selection: $context\" {","+                set master [srv -1 client]","+                set replica [srv 0 client]","+","+                # Individual selectors and their bitwise aliases must be","+                # accepted by the configuration parser in every build.","+                foreach client [list $master $replica] client_types [list $master_types $replica_types] {","+                    set expected_types $client_types","+                    if {$client_types eq \"replica master\"} {","+                        set expected_types replication","+                    } elseif {$client_types eq \"replica-compressed master-compressed\"} {","+                        set expected_types replication-compressed","+                    }","+                    if {[llength $client_types] == 1 || $expected_types ne $client_types} {","+                        assert_equal $expected_types [lindex [$client config get io-threads-client-types] 1]","+                    }","+                    # A selector never creates more than the configured workers.","+                    assert_equal -1 [get_io_thread_clients 4 $client]","+                }","+","+                $master set initial [string repeat initial 1000]","+                $replica replicaof [srv -1 host] [srv -1 port]","+                wait_for_sync $replica","+                wait_replica_online $master","+                $master set streamed [string repeat streamed 1000]","+                assert_equal 1 [$master wait 1 5000]","+                wait_for_ofs_sync $master $replica","+                # Thread selection must preserve the replicated dataset.","+                assert_equal [$master debug digest] [$replica debug digest]","+","+                wait_for_condition 50 100 {","+                    ([compression_client_io_thread [$master client list type replica]] > 0) == $replica_worker &&","+                    ([compression_client_io_thread [$replica client list type master]] > 0) == $primary_worker","+                } else {","+                    fail \"Unexpected replication thread assignment: $context\"","+                }","+                foreach client [list $master $replica] normal_worker [list $master_normal_worker $replica_normal_worker] {","+                    # Normal command connections follow only the normal selector.","+                    assert_equal $normal_worker [expr {[compression_client_io_thread [$client client info]] > 0}]","+                }","+                if {$compressed} {","+                    # These links negotiated compression and use eligible workers.","+                    assert {[status $master total_net_repl_uncompressed_bytes] > 0}","+                    assert {[status $replica total_net_repl_decompressed_bytes] > 0}","+                } elseif {$compression_level} {","+                    # A direction excluded by its selector must decline compression.","+                    assert_equal {} [status $master total_net_repl_uncompressed_bytes]","+                    assert_equal {} [status $replica total_net_repl_decompressed_bytes]","+                }","+","+                # A reconnect must apply the same role filter after PSYNC.","+                set partial_syncs [status $master sync_partial_ok]","+                $replica client kill type master","+                $master set reconnected [string repeat reconnected 1000]","+                wait_for_condition 100 100 {","+                    [status $master sync_partial_ok] > $partial_syncs &&","+                    [$replica get reconnected] eq [string repeat reconnected 1000]","+                } else {","+                    fail \"Replication did not resume via partial sync: $context\"","+                }","+                assert_equal 1 [$master wait 1 5000]","+                wait_for_condition 50 100 {","+                    ([compression_client_io_thread [$master client list type replica]] > 0) == $replica_worker &&","+                    ([compression_client_io_thread [$replica client list type master]] > 0) == $primary_worker","+                } else {","+                    fail \"Unexpected replication thread assignment after partial sync: $context\"","+                }","+            }","+        }","+    }","+}","+","+start_server {tags {repl iothreads external:skip} overrides {io-threads 1 io-threads-client-types all} omit {repl-compression repl-compression-max-latency}} {","+    test {IO thread client types do not create workers when io-threads is one} {","+        assert_equal 1 [lindex [r config get io-threads] 1]","+        assert_equal -1 [get_io_thread_clients 1]","+        assert_equal 0 [compression_client_io_thread [r client info]]","+    }","+}","+","+# The remaining tests configure repl-compression, which is only registered in","+# builds with BUILD_COMPRESSION=yes. The compression CI job passes --compression.","+if {!$::compression} {","+    return","+}","+","+start_server {tags {repl iothreads external:skip} overrides {io-threads 4 io-threads-client-types replication repl-compression 1 save \"\"}} {","+    start_server {overrides {io-threads 4 io-threads-client-types replication repl-compression 2 save \"\"}} {","+        test {IO thread client types follow uncompressed fallback after compression negotiation fails} {","+            set master [srv -1 client]","+            set replica [srv 0 client]","+            $replica replicaof [srv -1 host] [srv -1 port]","+            wait_for_sync $replica","+            wait_replica_online $master","+            $master set fallback [string repeat fallback 1000]","+            assert_equal 1 [$master wait 1 5000]","+            wait_for_condition 50 100 {","+                [compression_client_io_thread [$master client list type replica]] > 0 &&","+                [compression_client_io_thread [$replica client list type master]] > 0","+            } else {","+                fail \"Uncompressed fallback connections were not assigned to IO workers\"","+            }","+            # Rejected compression must not leave either side using compression.","+            assert_equal {} [status $master total_net_repl_uncompressed_bytes]","+            assert_equal {} [status $replica total_net_repl_decompressed_bytes]","+            assert_equal [string repeat fallback 1000] [$replica get fallback]","+        }","+    }","+}","+","+# Cover matching level 1, rejected level 2, and compression without IO workers.","+foreach io_threads {1 4} {","+    foreach replica_compression {1 2} {","+        foreach rdb_channel {no yes} {","+            set master_compression 1","+            set compressed [expr {$io_threads > 1 && $replica_compression == 1}]","+            set overrides [list io-threads $io_threads io-threads-client-types replication-compressed \\","+                repl-rdb-channel $rdb_channel repl-compression $master_compression \\","+                repl-compression-max-latency 10 save \"\"]","+            set context \"io-threads=$io_threads compression=$replica_compression rdb-channel=$rdb_channel\"","+","+            start_server [list tags {repl iothreads external:skip} overrides $overrides] {","+                start_server [list overrides [concat $overrides [list repl-compression $replica_compression]]] {","+                    set master [srv -1 client]","+                    set replica [srv 0 client]","+","+                    test \"Replication compression thread assignment: $context\" {","+                        assert_equal $io_threads [lindex [$master config get io-threads] 1]","+                        foreach client [list $master $replica] {","+                            assert_equal -1 [get_io_thread_clients $io_threads $client]","+                            for {set tid 1} {$tid < $io_threads} {incr tid} {","+                                assert_equal 0 [get_io_thread_clients $tid $client]","+                            }","+                            assert_equal 0 [compression_client_io_thread [$client client info]]","+                        }","+","+                        # Include data in the initial RDB as well as in the stream.","+                        $master set initial [string repeat initial 1000]","+                        $replica replicaof [srv -1 host] [srv -1 port]","+                        wait_for_sync $replica","+                        wait_replica_online $master","+                        for {set i 0} {$i < 20} {incr i} {","+                            $master set streamed:$i [string repeat \"value:$i\" 1000]","+                        }","+                        assert_equal 1 [$master wait 1 5000]","+                        wait_for_ofs_sync $master $replica","+                        assert_equal [$master debug digest] [$replica debug digest]","+","+                        wait_for_condition 50 100 {","+                            ([compression_client_io_thread [$master client list type replica]] > 0) == $compressed &&","+                            ([compression_client_io_thread [$replica client list type master]] > 0) == $compressed","+                        } else {","+                            fail \"Unexpected replication thread assignment: $context\"","+                        }","+                        assert_equal $compressed [expr {[status $master total_net_repl_uncompressed_bytes] > 0}]","+                        assert_equal $compressed [expr {[status $replica total_net_repl_decompressed_bytes] > 0}]","+","+                        foreach client [list $master $replica] {","+                            # Only the compressed replication link may use a worker.","+                            for {set tid 1} {$tid < $io_threads} {incr tid} {","+                                assert_equal [expr {$tid == 1 ? $compressed : 0}] [get_io_thread_clients $tid $client]","+                            }","+                            assert_equal 0 [compression_client_io_thread [$client client info]]","+                        }","+                    }","+","+                    test \"Replication compression thread assignment after partial sync: $context\" {","+                        set partial_syncs [status $master sync_partial_ok]","+                        $replica client kill type master","+                        $master set reconnected [string repeat reconnected 1000]","+                        wait_for_condition 100 100 {","+                            [status $master sync_partial_ok] > $partial_syncs &&","+                            [$replica get reconnected] eq [string repeat reconnected 1000]","+                        } else {","+                            fail \"Replication did not resume via partial sync: $context\"","+                        }","+                        assert_equal 1 [$master wait 1 5000]","+                        wait_for_condition 50 100 {","+                            ([compression_client_io_thread [$master client list type replica]] > 0) == $compressed &&","+                            ([compression_client_io_thread [$replica client list type master]] > 0) == $compressed","+                        } else {","+                            fail \"Unexpected replication thread assignment after partial sync: $context\"","+                        }","+                    }","+                }","+            }","+        }","+    }","+}","+","+set overrides {io-threads 4 io-threads-client-types replication-compressed repl-compression 1 repl-compression-max-latency 10 save \"\"}","+start_server [list tags {repl iothreads external:skip} overrides $overrides] {","+    start_server [list overrides $overrides] {","+        start_server [list overrides $overrides] {","+            start_server [list overrides [concat $overrides {io-threads 1 io-threads-client-types all repl-compression 0}]] {"],"additions":304,"deletions":0,"truncated":false}],"additions":416,"deletions":9,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-22T13:47:13.510447+00:00"}