et\").await;"," ","     // 1. user.create","@@ -316,7 +322,7 @@ async fn audit_log_user_admin_and_registration() {"," async fn audit_log_rule_admin() {","     let logs = init_audit_subscriber();","     let dir = TempDir::new().unwrap();","-    let app = router(load_config(dir.path()));","+    let app = app_router(load_config(dir.path())).await;","     let root = login(&app, \"root\", \"secret\").await;"," ","     // 1. rules.replace","@@ -350,7 +356,7 @@ async fn audit_log_rule_admin() {"," async fn audit_log_team_admin() {","     let logs = init_audit_subscriber();","     let dir = TempDir::new().unwrap();","-    let app = router(load_config(dir.path()));","+    let app = app_router(load_config(dir.path())).await;","     let root = login(&app, \"root\", \"secret\").await;"," ","     // 1. team.create","@@ -433,7 +439,7 @@ async fn audit_log_team_admin() {"," async fn audit_log_scim_operations() {","     let logs = init_audit_subscriber();","     let dir = TempDir::new().unwrap();","-    let app = router(load_config(dir.path()));","+    let app = app_router(load_config(dir.path())).await;"," ","     // 1. scim.user_create","     let (status, _) = send(","@@ -512,7 +518,7 @@ async fn audit_log_scim_operations() {"," async fn audit_log_unpublish_and_dist_tags() {","     let logs = init_audit_subscriber();","     let dir = TempDir::new().unwrap();","-    let app = router(load_config(dir.path()));","+    let app = app_router(load_config(dir.path())).await;","     let publisher = login(&app, \"aud_publisher\", \"pass\").await;"," ","     // Publish package"],"additions":12,"deletions":6,"truncated":false},{"path":"pnpr/crates/pnpr/tests/reserved_usernames.rs","lines":["@@ -0,0 +1,253 @@","+//! Tests ensuring reserved usernames cannot be squatted via self-registration","+//! (`PUT /-/user/org.couchdb.user:{name}`), including:","+//! - configured admins (`auth.admins`)","+//! - OIDC login bindings (`auth.oidc[].login.users[].username`)","+//! - OIDC workload bindings (`auth.oidc[].workloads[].identity.username`)","+//!","+//! Existing accounts logging in with their correct password continue to work.","+","+use axum::{","+    body::{Body, to_bytes},","+    http::{Request, StatusCode},","+};","+use pnpr::{AuthState, Config, cli_commands::Command, router, router_with_auth};","+use serde_json::{Value, json};","+use std::{","+    net::{Ipv4Addr, SocketAddr, SocketAddrV4},","+    path::Path,","+};","+use tempfile::TempDir;","+use tower::ServiceExt;","+","+fn test_config(dir: &Path) -> Config {","+    let storage = dir.join(\"storage\");","+    std::fs::create_dir_all(&storage).unwrap();","+    let yaml = format!(","+        \"\\","+storage: {}","+auth:","+  admins: [admin_alice]","+  htpasswd:","+    max_users: 100","+  oidc:","+    - name: idp","+      issuer: https://issuer.example.com","+      audience: pnpr","+      login:","+        users:","+          - subject: sub-100","+            username: oidc_bob","+      workloads:","+        - identity:","+            subject: repo:pnpm/pnpm","+            username: release-ci","+          registry: local","+          packages: ['@pnpm/pkg']","+registries:","+  local:","+    type: hosted","+\",","+        storage.display(),","+    );","+    let path = dir.join(\"config.yaml\");","+    std::fs::write(&path, yaml).unwrap();","+    let listen = SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST, 4873));","+    Config::from_yaml(&path, listen, Some(\"https://example.test\".to_string())).unwrap()","+}","+","+async fn send_request(","+    app: &axum::Router,","+    method: &str,","+    path: &str,","+    token: Option<&str>,","+    content_type: &str,","+    body: Option<Value>,","+) -> (StatusCode, String, Value) {","+    let mut builder = Request::builder()","+        .method(method)","+        .uri(path)","+        .header(\"content-type\", content_type);","+    if let Some(token) = token {","+        builder = builder.header(\"authorization\", format!(\"Bearer {token}\"));","+    }","+    let body_bytes =","+        body.map(|payload| Body::from(payload.to_string())).unwrap_or_else(Body::empty);","+    let response = app","+        .clone()","+        .oneshot(builder.body(body_bytes).unwrap())","+        .await","+        .unwrap();","+    let status = response.status();","+    let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+    let text = String::from_utf8_lossy(&bytes).into_owned();","+    let json = serde_json::from_slice(&bytes).unwrap_or(Value::Null);","+    (status, text, json)","+}","+","+async fn put_login(","+    app: &axum::Router,","+    username: &str,","+    password: &str,","+) -> (StatusCode, String, Value) {","+    let body = json!({","+        \"name\": username,","+        \"password\": password,","+        \"type\": \"user\",","+        \"roles\": [],","+    });","+    let path = format!(\"/-/user/org.couchdb.user:{username}\");","+    send_request(app, \"PUT\", &path, None, \"application/json\", Some(body)).await","+}","+","+#[tokio::test]","+async fn cannot_self_register_configured_admin() {","+    let dir = TempDir::new().unwrap();","+    let app = router(test_config(dir.path()));","+    let (status, text, _) = put_login(&app, \"admin_alice\", \"malicious_password\").await;","+    assert_eq!(status, StatusCode::FORBIDDEN);","+    assert_eq!(text, r#\"Username \"admin_alice\" is reserved\"#);","+}","+","+#[tokio::test]","+async fn cannot_self_register_oidc_login_bound_user() {","+    let dir = TempDir::new().unwrap();","+    let app = router(test_config(dir.path()));","+    let (status, text, _) = put_login(&app, \"oidc_bob\", \"malicious_password\").await;","+    assert_eq!(status, StatusCode::FORBIDDEN);","+    assert_eq!(text, r#\"Username \"oidc_bob\" is reserved\"#);","+}","+","+#[tokio::test]","+async fn cannot_self_register_oidc_workload_bound_user() {","+    let dir = TempDir::new().unwrap();","+    let app = router(test_config(dir.path()));","+    let (status, text, _) = put_login(&app, \"release