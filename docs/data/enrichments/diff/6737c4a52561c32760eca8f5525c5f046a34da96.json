() {","+        dialoguer::Password::new()","+            .with_prompt(\"Enter password\")","+            .allow_empty_password(true)","+            .interact()","+            .map_err(|err| miette::miette!(\"could not read password from terminal: {err}\"))?","+    } else {","+        let mut line = String::new();","+        std::io::stdin()","+            .read_line(&mut line)","+            .map_err(|err| miette::miette!(\"could not read password from stdin: {err}\"))?;","+        line.trim_end_matches(['\\r', '\\n'])","+            .to_string()","+    };","+    if trimmed.is_empty() {","+        return Err(miette::miette!(\"password cannot be empty\"));","+    }","+    Ok(trimmed)","+}","+","+async fn run_add_user_command(","+    config: &Config,","+    username: String,","+    password: Option<String>,","+) -> miette::Result<()> {","+    if matches!(config.identity.backend, pnpr_config::BackendConfig::Local)","+        && config.identity.auth.htpasswd.file.is_none()","+    {","+        return Err(miette::miette!(","+            \"standalone add-user requires a persistent auth backend (configure auth.htpasswd.file or a database backend)\"","+        ));","+    }","+    let password = match password {","+        Some(password) => password,","+        None => read_password()?,","+    };","+    if password.is_empty() {","+        return Err(miette::miette!(\"password cannot be empty\"));","+    }","+    if password.len() > pnpr_auth::MAX_PASSWORD_BYTES {","+        return Err(miette::miette!(","+            \"password cannot exceed {} bytes\",","+            pnpr_auth::MAX_PASSWORD_BYTES,","+        ));","+    }","+    let auth = pnpr_auth::AuthState::load(&config.identity.auth, &config.identity.backend)","+        .await","+        .map_err(|err| miette::miette!(\"could not connect to auth backend: {err}\"))?;","+    let users = &auth.users;","+    if users","+        .create_user(&username, &password)","+        .await","+        .map_err(|err| miette::miette!(\"{err}\"))?","+    {","+        println!(\"User '{username}' created successfully.\");","+    } else if users","+        .set_password(&username, &password)","+        .await","+        .map_err(|err| miette::miette!(\"{err}\"))?","+    {","+        println!(\"Password for user '{username}' updated successfully.\");","+    } else {","+        return Err(miette::miette!(\"failed to create or update user '{username}'\"));","+    }","+    Ok(())","+}"],"additions":99,"deletions":19,"truncated":false},{"path":"pnpr/crates/pnpr/src/lib.rs","lines":["@@ -15,6 +15,7 @@"," #![recursion_limit = \"256\"]"," "," pub mod cache_maintenance;","+pub mod cli_commands;"," pub mod config_check;"," pub mod export;"," pub mod htpasswd_import;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/main.rs","lines":["@@ -93,8 +93,7 @@ struct FeatureArgs {","     disable_artifacts: bool,"," }"," ","-mod cli_commands;","-use cli_commands::{Command, ConfigSubcommand, run_command};","+use pnpr::cli_commands::{Command, ConfigSubcommand, run_command};"," "," impl Args {","     fn feature_overrides(&self) -> pnpr::FeatureOverrides {"],"additions":1,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/user_accounts.rs","lines":["@@ -117,7 +117,9 @@ pub(super) async fn add_user(","         Err(err) => {","             if matches!(","                 err,","-                RegistryError::Unauthenticated { .. } | RegistryError::Forbidden { .. },","+                RegistryError::Unauthenticated { .. }","+                    | RegistryError::Forbidden { .. }","+                    | RegistryError::ReservedUsername { .. },","             ) {","                 state.inner.identity.login_rate_limiter.record_failure(client_ip, name);","             }","@@ -136,6 +138,10 @@ pub(super) async fn add_user(","     user_upsert_response(outcome, &username, &token)"," }"," ","+fn is_reserved_username(state: &AppState, name: &str) -> bool {","+    state.inner.config.ident