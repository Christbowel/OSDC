{"id":"6737c4a52561c32760eca8f5525c5f046a34da96","axis":"silent","repo":"pnpm/pnpm","sha":"6737c4a52561c32760eca8f5525c5f046a34da96","parsed":{"files":[{"path":".changeset/pnpr-reserved-usernames.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Prevent self-registration from squatting configured admin usernames, OIDC bindings, and workload bindings, and add the `pnpr add-user` CLI command for provisioning reserved admin accounts [pnpm/tasks#131](https://github.com/pnpm/tasks/issues/131)."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -6677,6 +6677,7 @@ dependencies = [","  \"clap\",","  \"dashmap\",","  \"derive_more\",","+ \"dialoguer\",","  \"flate2\",","  \"futures-util\",","  \"getrandom 0.4.3\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/backend_config.rs","lines":["@@ -226,6 +226,34 @@ impl IdentityConfig {","             Identity::Anonymous | _ => false,","         }","     }","+","+    /// Whether `username` is a configured admin, an OIDC login user,","+    /// or an OIDC workload binding. Such names cannot be self-registered.","+    #[must_use]","+    pub fn is_reserved_name(&self, username: &str) -> bool {","+        if self.admins.contains(username) {","+            return true;","+        }","+        for provider in &self.auth.oidc {","+            if provider.login","+                .as_ref()","+                .is_some_and(|login| {","+                    login.users","+                        .iter()","+                        .any(|binding| binding.username == username)","+                })","+            {","+                return true;","+            }","+            if provider.workloads","+                .iter()","+                .any(|workload| workload.identity.username == username)","+            {","+                return true;","+            }","+        }","+        false","+    }"," }"," "," pub(super) fn build_identity_config("],"ad