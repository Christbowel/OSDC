{"id":"7456fb941ba89c0ccec4aac0e78e8b02fd4d7838","axis":"silent","repo":"grafana/tempo","sha":"7456fb941ba89c0ccec4aac0e78e8b02fd4d7838","parsed":{"files":[{"path":".chloggen/distributor-external-forwarder-queue.yaml","lines":["@@ -0,0 +1,21 @@","+# Changelog entry. Generate a copy with `make chlog-new`, then fill in the fields.","+","+# One of: breaking | change | feature | enhancement | bug_fix | security","+change_type: feature","+","+# Component or area of the change. Must be one of the components in .chloggen/config.yaml,","+# e.g. distributor, querier, query-frontend, storage, operations.","+component: distributor","+","+# A brief description of the change. Surround with quotes (\"\") if it must start with a backtick (`).","+note: Control external forwarder queue size and parallelism per tenant with the forwarder.queue_size and forwarder.workers overrides.","+","+# (Optional) PR number(s), e.g. [7339]. Leave blank to auto-fill at release. See","+# .chloggen/README.md.","+issues: []","+","+# (Optional) Additional lines rendered under the note. Use a pipe (|) for multiline text.","+subtext:","+","+# The GitHub handle (without the leading @) of the change's author. Rendered as \"(@handle)\".","+user: javiermolinar"],"additions":21,"deletions":0,"truncated":false},{"path":".gitignore","lines":["@@ -2,6 +2,7 @@"," .idea"," .vscode"," .claude/settings.local.json","+/.plans/"," *.test"," *.out"," .coverage/"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/_index.md","lines":["@@ -2691,6 +2691,15 @@ overrides:","     # must refer by name to a forwarder defined in the distributor.forwarders configuration.","     forwarders: <list of string>"," ","+    # Distributor -> external forwarder queue controls.","+    # Each tenant has a separate queue for each enabled forwarder on each distributor.","+    # The same settings apply to every external forwarder enabled for the tenant.","+    forwarder:","+      # Maximum queued batches, not spans or bytes. 0 uses 100; negative values are invalid.","+      [queue_size: <int> | default = 100]","+      # Parallel forwarding workers per queue. 0 uses 2; negative values are invalid.","+      [workers: <int> | default = 2]","+","     # Global enforced overrides","     global:","       # Maximum size of a single trace in bytes. A value of 0 disables the size","@@ -2804,6 +2813,11 @@ overrides:","         # Optional per-tenant remote write headers, for example for per-tenant authentication.","         remote_write_headers:","           [<header-name>: <string>]","+      # External forwarder names must match distributor.forwarders entries.","+      [forwarders: <list of strings>]","+      forwarder:","+        [queue_size: <int> | default = 100]","+        [workers: <int> | default = 2]"," ","   # A \"wildcard\" override can be used that will apply to all tenants if a match is not found otherwise.","   \"*\":","@@ -2825,6 +2839,45 @@ These tenant-specific overrides are stored in an object store and can be modifie"," User-configurable overrides have priority over runtime overrides."," Refer to [user-configurable overrides](https://grafana.com/docs/tempo/<TEMPO_VERSION>/operations/manage-advanced-systems/user-configurable-overrides/) for more details."," ","+#### External forwarder queues","+","+Configure `overrides.defaults.forwarder`, or `forwarder` in a tenant runtime override:","+","+- `queue_size`: maximum buffered batches per queue (default: `100`).","+- `workers`: concurrent forwarding workers per queue (default: `2`).","+","+Each distributor creates a separate queue per tenant and enabled forwarder.","+These operator-only settings don't affect metrics-generator forwarding.","+","+Omitted or zero values use the built-in defaults; negative values are invalid.","+Tenant and wildcard entries don't inherit custom values from `overrides.defaults.forwarder` for omitted fields.","+","+After runtime overrides reload, queue settings update on the next 10-second check.","+Old queues drain asynchronously while replacement queues accept new batches.","+","+For example, use default queue settings and larger queues for one tenant.","+The `external-otlp` name must match a forwarder defined in `distributor.forwarders`:","+","+```yaml","+# /conf/tempo.yaml","+overrides:","+  defaults:","+    forwarders: [external-otlp]","+    forwarder:","+      queue_size: 100","+      workers: 2","+  per_tenant_override_config: /conf/overrides.yaml","+","+---","+# /conf/overrides.yaml","+overrides:","+  tenant-a:","+    forwarders: [external-otlp]","+    forwarder:","+      queue_size: 1000","+      workers: 4","+```","+"," #### Ingestion rate strategy"," "," Ingestion limits are enforced at different points in the write path. The distributor enforces rate and burst limits before writing to Kafka. Live-stores and block-builders enforce per-trace size and active trace count limits asynchronously after consuming from Kafka."],"additions":53,"deletions":0,"truncated":false},{"path":"modules/distributor/forwarder/manager.go","lines":["@@ -17,13 +17,10 @@ import ("," \t\"github.com/grafana/tempo/v3/modules/overrides\""," )"," ","-const (","-\tdefaultWorkerCount = 2","-\tdefaultQueueSize   = 100","-)","-"," type Overrides interface {"," \tForwarders(tenantID string) []string","+\tForwarderQueueSize(tenantID string) int","+\tForwarderWorkers(tenantID string) int"," }"," "," var _ Overrides = overrides.Interface(nil)","@@ -91,7 +88,9 @@ func (m *Manager) getOrCreateQueueList(tenantID string) (*queueList, bool) {"," \tdefer m.tenantToQueueListMu.Unlock()"," "," \tforwarderNames := m.overrides.Forwarders(tenantID)","-\tql, err := newQueueList(m.logger, tenantID, forwarderNames, m.forwarderNameToForwarder)","+\tqueueSize := m.overrides.ForwarderQueueSize(tenantID)","+\tworkerCount := m.overrides.ForwarderWorkers(tenantID)","+\tql, err := newQueueList(m.logger, tenantID, forwarderNames, m.forwarderNameToForwarder, queueSize, workerCount)"," \tif err != nil {"," \t\t_ = level.Warn(m.logger).Log(\"msg\", \"failed to create queue list\", \"err\", err)"," ","@@ -155,11 +154,13 @@ func (m *Manager) updateQueueLists() {"," \t\t\tcontinue"," \t\t}"," ","-\t\tif ql.shouldUpdate(forwarderNames) {","+\t\tqueueSize := m.overrides.ForwarderQueueSize(tenantID)","+\t\tworkerCount := m.overrides.ForwarderWorkers(tenantID)","+\t\tif ql.shouldUpdate(forwarderNames, queueSize, workerCount) {"," \t\t\tgo m.shutdownQueueList(tenantID, ql)"," \t\t\tdelete(m.tenantToQueueList, tenantID)"," ","-\t\t\tnewQl, err := newQueueList(m.logger, tenantID, forwarderNames, m.forwarderNameToForwarder)","+\t\t\tnewQl, err := newQueueList(m.logger, tenantID, forwarderNames, m.forwarderNameToForwarder, queueSize, workerCount)"," \t\t\tif err != nil {"," \t\t\t\t_ = level.Warn(m.logger).Log(\"msg\", \"failed to create queue list\", \"err\", err)"," ","@@ -215,7 +216,7 @@ type queueList struct {"," \tlist                 List"," }"," ","-func newQueueList(logger log.Logger, tenantID string, forwarderNames []string, forwarderNameToForwarder map[string]Forwarder) (*queueList, error) {","+func newQueueList(logger log.Logger, tenantID string, forwarderNames []string, forwarderNameToForwarder map[string]Forwarder, queueSize, workerCount int) (*queueList, error) {"," \tforwarderNameToQueue := make(map[string]*queue.Queue[ptrace.Traces], len(forwarderNames))"," \tlist := make(List, 0, len(forwarderNames))"," \tfor _, forwarderName := range forwarderNames {","@@ -227,8 +228,8 @@ func newQueueList(logger log.Logger, tenantID string, forwarderNames []string, f"," \t\tqueueCfg := queue.Config{"," \t\t\tName:        forwarderName,"," \t\t\tTenantID:    tenantID,","-\t\t\tSize:        defaultQueueSize,","-\t\t\tWorkerCount: defaultWorkerCount,","+\t\t\tSize:        queueSize,","+\t\t\tWorkerCount: workerCount,"," \t\t}"," "," \t\tprocessFunc := func(ctx context.Context, traces ptrace.Traces) {","@@ -250,13 +251,14 @@ func newQueueList(logger log.Logger, tenantID string, forwarderNames []string, f"," \t}, nil"," }"," ","-func (l *queueList) shouldUpdate(forwarderNames []string) bool {","+func (l *queueList) shouldUpdate(forwarderNames []string, queueSize, workerCount int) bool {"," \tif len(forwarderNames) != len(l.forwarderNameToQueue) {"," \t\treturn true"," \t}"," "," \tfor _, forwarderName := range forwarderNames {","-\t\tif _, found := l.forwarderNameToQueue[forwarderName]; !found {","+\t\tq, found := l.forwarderNameToQueue[forwarderName]","+\t\tif !found || q.ShouldUpdate(queueSize, workerCount) {"," \t\t\treturn true"," \t\t}"," \t}"],"additions":15,"deletions":13,"truncated":false},{"path":"modules/distributor/forwarder/manager_queue_test.go","lines":["@@ -0,0 +1,173 @@","+package forwarder","+","+import (","+\t\"context\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-kit/log\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/collector/pdata/ptrace\"","+)","+","+func TestManager_QueueConfig(t *testing.T) {","+\to := &mockWorkingOverrides{","+\t\ttenantIDToForwarders: map[string][]string{","+\t\t\t\"default\": {\"first\", \"second\"},","+\t\t\t\"custom\":  {\"first\", \"second\"},","+\t\t},","+\t\ttenantIDToQueueSize: map[string]int{\"custom\": 17},","+\t\ttenantIDToWorkers:   map[string]int{\"custom\": 3},","+\t}","+\tmanager := newManagerWithForwarders(t, map[string]Forwarder{","+\t\t\"first\": &mockWorkingForwarder{}, \"second\": &mockWorkingForwarder{},","+\t}, log.NewNopLogger(), o)","+","+\tfor _, tc := range []struct {","+\t\ttenant        string","+\t\tsize, workers int","+\t}{","+\t\t{\"default\", 100, 2},","+\t\t{\"custom\", 17, 3},","+\t} {","+\t\tt.Run(tc.tenant, func(t *testing.T) {","+\t\t\trequire.Len(t, manager.ForTenant(tc.tenant), 2)","+\t\t\tql, found := manager.getQueueList(tc.tenant)","+\t\t\trequire.True(t, found)","+\t\t\tfor _, q := range ql.forwarderNameToQueue {","+\t\t\t\trequire.Equal(t, tc.size, q.Size())","+\t\t\t\trequire.Equal(t, tc.workers, q.WorkerCount())","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestManager_QueueConfigRefresh(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname                        string","+\t\tinitialSize, initialWorkers int","+\t\tupdatedSize, updatedWorkers int","+\t\twantSize, wantWorkers       int","+\t\treplace                     bool","+\t}{","+\t\t{\"size only\", 3, 1, 7, 1, 7, 1, true},","+\t\t{\"workers only\", 3, 1, 3, 2, 3, 2, true},","+\t\t{\"unchanged\", 3, 1, 3, 1, 3, 1, false},","+\t\t{\"explicit defaults\", 0, 0, 100, 2, 100, 2, false},","+\t\t{\"reset defaults\", 3, 1, 0, 0, 100, 2, true},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\to := &mockWorkingOverrides{","+\t\t\t\ttenantIDToForwarders: map[string][]string{","+\t\t\t\t\t\"updated\": {\"external\"}, \"unchanged\": {\"external\"},","+\t\t\t\t},","+\t\t\t\ttenantIDToQueueSize: map[string]int{\"updated\": tc.initialSize, \"unchanged\": 11},","+\t\t\t\ttenantIDToWorkers:   map[string]int{\"updated\": tc.initialWorkers, \"unchanged\": 1},","+\t\t\t}","+\t\t\ttraces := make(chan ptrace.Traces, 1)","+\t\t\tmanager := newManagerWithForwarders(t, map[string]Forwarder{","+\t\t\t\t\"external\": &mockChannelledInterceptorForwarder{next: &mockWorkingForwarder{}, traces: traces},","+\t\t\t}, log.NewNopLogger(), o)","+\t\t\trequire.Len(t, manager.ForTenant(\"updated\"), 1)","+\t\t\trequire.Len(t, manager.ForTenant(\"unchanged\"), 1)","+\t\t\toldList, _ := manager.getQueueList(\"updated\")","+\t\t\tunaffectedList, _ := manager.getQueueList(\"unchanged\")","+","+\t\t\to.tenantIDToQueueSize[\"updated\"] = tc.updatedSize","+\t\t\to.tenantIDToWorkers[\"updated\"] = tc.updatedWorkers","+\t\t\tmanager.updateQueueLists()","+","+\t\t\tnewList, found := manager.getQueueList(\"updated\")","+\t\t\trequire.True(t, found)","+\t\t\tif tc.replace {","+\t\t\t\trequire.NotSame(t, oldList, newList)","+\t\t\t} else {","+\t\t\t\trequire.Same(t, oldList, newList)","+\t\t\t}","+\t\t\trequire.Equal(t, tc.wantSize, newList.forwarderNameToQueue[\"external\"].Size())","+\t\t\trequire.Equal(t, tc.wantWorkers, newList.forwarderNameToQueue[\"external\"].WorkerCount())","+\t\t\tgotUnaffected, _ := manager.getQueueList(\"unchanged\")","+\t\t\trequire.Same(t, unaffectedList, gotUnaffected)","+","+\t\t\tbatch := ptrace.NewTraces()","+\t\t\trequire.NoError(t, manager.ForTenant(\"updated\").ForwardTraces(context.Background(), batch))","+\t\t\tselect {","+\t\t\tcase got := <-traces:","+\t\t\t\trequire.Equal(t, batch, got)","+\t\t\tcase <-time.After(5 * time.Second):","+\t\t\t\tt.Fatal(\"replacement queue did not forward the batch\")","+\t\t\t}","+\t\t})","+\t}","+}","+","+type drainingTestForwarder struct {","+\tstarted chan struct{}","+\trelease chan struct{}","+\ttraces  chan ptrace.Traces","+}","+","+func (f *drainingTestForwarder) ForwardTraces(ctx context.Context, traces ptrace.Traces) error {","+\tif traces.ResourceSpans().At(0).SchemaUrl() == \"blocked\" {","+\t\tclose(f.started)","+\t\tselect {","+\t\tcase <-f.release:","+\t\tcase <-ctx.Done():","+\t\t\treturn ctx.Err()","+\t\t}","+\t}","+\tselect {","+\tcase f.traces <- traces:","+\t\treturn nil","+\tcase <-ctx.Done():","+\t\treturn ctx.Err()","+\t}","+}","+","+func (*drainingTestForwarder) Shutdown(context.Context) error { return nil }","+","+func TestManager_QueueConfigRefreshDrainsOldQueue(t *testing.T) {","+\to := &mockWorkingOverrides{","+\t\ttenantIDToForwarders: map[string][]string{\"tenant\": {\"external\"}},","+\t\ttenantIDToQueueSize:  map[string]int{\"tenant\": 2},","+\t\ttenantIDToWorkers:    map[string]int{\"tenant\": 1},","+\t}","+\tforwarder := &drainingTestForwarder{","+\t\tstarted: make(chan struct{}), release: make(chan struct{}), traces: make(chan ptrace.Traces, 3),","+\t}","+\tmanager := newManagerWithForwarders(t, map[string]Forwarder{\"external\": forwarder}, log.NewNopLogger(), o)","+\t// Unblock the old worker before manager cleanup even if an assertion fails.","+\tdefer close(forwarder.release)","+\tbatch := func(name string) ptrace.Traces {","+\t\ttraces := ptrace.NewTraces()","+\t\ttraces.ResourceSpans().AppendEmpty().SetSchemaUrl(name)","+\t\treturn traces","+\t}","+\treceive := func() string {","+\t\tt.Helper()","+\t\tselect {","+\t\tcase traces := <-forwarder.traces:","+\t\t\treturn traces.ResourceSpans().At(0).SchemaUrl()","+\t\tcase <-time.After(5 * time.Second):","+\t\t\tt.Fatal(\"timed out waiting for forwarded batch\")","+\t\t\treturn \"\"","+\t\t}","+\t}","+","+\trequire.NoError(t, manager.ForTenant(\"tenant\").ForwardTraces(context.Background(), batch(\"blocked\")))","+\tselect {","+\tcase <-forwarder.started:","+\tcase <-time.After(5 * time.Second):","+\t\tt.Fatal(\"old worker did not start\")","+\t}","+\trequire.NoError(t, manager.ForTenant(\"tenant\").ForwardTraces(context.Background(), batch(\"queued\")))","+","+\to.tenantIDToQueueSize[\"tenant\"] = 4","+\tmanager.updateQueueLists()","+\trequire.NoError(t, manager.ForTenant(\"tenant\").ForwardTraces(context.Background(), batch(\"new\")))","+\trequire.Equal(t, \"new\", receive(), \"new queue must forward while the old worker is blocked\")","+","+\tforwarder.release <- struct{}{}","+\trequire.Equal(t, \"blocked\", receive())","+\trequire.Equal(t, \"queued\", receive(), \"old queue must drain its buffered batch\")","+}"],"additions":173,"deletions":0,"truncated":false},{"path":"modules/distributor/forwarder/manager_test.go","lines":["@@ -14,6 +14,8 @@ import ("," type mockWorkingOverrides struct {"," \ttenantIDs            []string"," \ttenantIDToForwarders map[string][]string","+\ttenantIDToQueueSize  map[string]int","+\ttenantIDToWorkers    map[string]int"," }"," "," func (m *mockWorkingOverrides) TenantIDs() []string {","@@ -24,6 +26,20 @@ func (m *mockWorkingOverrides) Forwarders(tenantID string) []string {"," \treturn m.tenantIDToForwarders[tenantID]"," }"," ","+func (m *mockWorkingOverrides) ForwarderQueueSize(tenantID string) int {","+\tif size := m.tenantIDToQueueSize[tenantID]; size != 0 {","+\t\treturn size","+\t}","+\treturn 100","+}","+","+func (m *mockWorkingOverrides) ForwarderWorkers(tenantID string) int {","+\tif workers := m.tenantIDToWorkers[tenantID]; workers != 0 {","+\t\treturn workers","+\t}","+\treturn 2","+}","+"," type mockWorkingForwarder struct{}"," "," func (m *mockWorkingForwarder) ForwardTraces(_ context.Context, _ ptrace.Traces) error {","@@ -70,6 +86,7 @@ func newManagerWithForwarders(t *testing.T, forwarderNameToForwarder map[string]"," "," \trequire.NoError(t, manager.start(context.Background()))"," \tt.Cleanup(func() {","+\t\trequire.NoError(t, manager.shutdown())"," \t\trequire.NoError(t, manager.stop(nil))"," \t})"," ","@@ -370,7 +387,7 @@ func TestManager_ForTenant_List_ForwardTraces_ReturnsNoErrorAndCorrectlyForwards"," \t// Step 2 - Remove one forwarder, simulate \"tick\" and verify that remaining forwarders receive the trace."," \tidx := slices.Index(o.tenantIDToForwarders[\"testTenantID\"], \"testForwarder2\")"," \trequire.NotEqual(t, -1, idx)","-\tslices.Delete(o.tenantIDToForwarders[\"testTenantID\"], idx, idx)","+\to.tenantIDToForwarders[\"testTenantID\"] = slices.Delete(o.tenantIDToForwarders[\"testTenantID\"], idx, idx+1)"," \tmanager.updateQueueLists()"," "," \t// When"],"additions":18,"deletions":1,"truncated":false},{"path":"modules/overrides/config.go","lines":["@@ -90,11 +90,26 @@ type IngestionOverrides struct {"," \tCreationGracePeriod *time.Duration `yaml:\"creation_grace_period,omitempty\" json:\"creation_grace_period,omitempty\"`"," }"," ","+const (","+\tdefaultForwarderQueueSize = 100","+\tdefaultForwarderWorkers   = 2","+)","+"," type ForwarderOverrides struct {"," \tQueueSize int `yaml:\"queue_size,omitempty\" json:\"queue_size,omitempty\"`"," \tWorkers   int `yaml:\"workers,omitempty\" json:\"workers,omitempty\"`"," }"," ","+func (cfg ForwarderOverrides) validate() error {","+\tif cfg.QueueSize < 0 {","+\t\treturn fmt.Errorf(\"forwarder.queue_size must be non-negative\")","+\t}","+\tif cfg.Workers < 0 {","+\t\treturn fmt.Errorf(\"forwarder.workers must be non-negative\")","+\t}","+\treturn nil","+}","+"," type ServiceGraphsOverrides struct {"," \tHistogramBuckets                      []float64                   `yaml:\"histogram_buckets,omitempty\" json:\"histogram_buckets,omitempty\"`"," \tDimensions                            []string                    `yaml:\"dimensions,omitempty\" json:\"dimensions,omitempty\"`","@@ -237,8 +252,10 @@ type Overrides struct {"," \tCompaction CompactionOverrides `yaml:\"compaction,omitempty\" json:\"compaction,omitempty\"`"," \t// MetricsGenerator enforced overrides."," \tMetricsGenerator MetricsGeneratorOverrides `yaml:\"metrics_generator,omitempty\" json:\"metrics_generator,omitempty\"`","-\t// Forwarders","+\t// External forwarder destinations and per-tenant queue controls."," \tForwarders []string `yaml:\"forwarders,omitempty\" json:\"forwarders,omitempty\"`","+\t// The override accessors interpret zero values as 100 queued batches and 2 workers.","+\tForwarder ForwarderOverrides `yaml:\"forwarder,omitempty\" json:\"forwarder,omitempty\"`"," \t// Global enforced overrides."," \tGlobal GlobalOverrides `yaml:\"global,omitempty\" json:\"global,omitempty\"`"," \t// Storage enforced overrides."],"additions":18,"deletions":1,"truncated":false},{"path":"modules/overrides/config_legacy.go","lines":["@@ -31,7 +31,9 @@ func (c *Overrides) toLegacy() LegacyOverrides {"," "," \t\tIngestionCreationGracePeriod: c.Ingestion.CreationGracePeriod,"," ","-\t\tForwarders: c.Forwarders,","+\t\tForwarders:         c.Forwarders,","+\t\tForwarderQueueSize: c.Forwarder.QueueSize,","+\t\tForwarderWorkers:   c.Forwarder.Workers,"," "," \t\tMetricsGeneratorRingSize:                                                    c.MetricsGenerator.RingSize,"," \t\tMetricsGeneratorProcessors:                                                  c.MetricsGenerator.Processors,","@@ -118,7 +120,9 @@ type LegacyOverrides struct {"," \tMaxGlobalTracesPerUser int `yaml:\"max_global_traces_per_user\" json:\"max_global_traces_per_user\"`"," "," \t// Forwarders","-\tForwarders []string `yaml:\"forwarders\" json:\"forwarders\"`","+\tForwarders         []string `yaml:\"forwarders\" json:\"forwarders\"`","+\tForwarderQueueSize int      `yaml:\"forwarder_queue_size\" json:\"forwarder_queue_size\"`","+\tForwarderWorkers   int      `yaml:\"forwarder_workers\" json:\"forwarder_workers\"`"," "," \t// Metrics-generator config"," \tMetricsGeneratorRingSize                                                    int                              `yaml:\"metrics_generator_ring_size\" json:\"metrics_generator_ring_size\"`","@@ -395,6 +399,10 @@ func (l *LegacyOverrides) toNewLimits() *Overrides {"," \t\t\tMaxCardinalityPerLabel:          l.MetricsGeneratorMaxCardinalityPerLabel,"," \t\t},"," \t\tForwarders: l.Forwarders,","+\t\tForwarder: ForwarderOverrides{","+\t\t\tQueueSize: l.ForwarderQueueSize,","+\t\t\tWorkers:   l.ForwarderWorkers,","+\t\t},"," \t\tGlobal: GlobalOverrides{"," \t\t\tMaxBytesPerTrace: l.MaxBytesPerTrace,"," \t\t},"],"additions":10,"deletions":2,"truncated":false},{"path":"modules/overrides/config_test.go","lines":["@@ -402,7 +402,9 @@ func generateTestLegacyOverrides() LegacyOverrides {"," \t\tMaxLocalTracesPerUser:  1000,"," \t\tMaxGlobalTracesPerUser: 2000,"," ","-\t\tForwarders: []string{\"forwarder-1\", \"forwarder-2\"},","+\t\tForwarders:         []string{\"forwarder-1\", \"forwarder-2\"},","+\t\tForwarderQueueSize: 250,","+\t\tForwarderWorkers:   4,"," "," \t\tMetricsGeneratorRingSize:                                                    3,"," \t\tMetricsGeneratorProcessors:                                                  makeListToMap([]string{\"processor-1\", \"processor-2\"}),"],"additions":3,"deletions":1,"truncated":false},{"path":"modules/overrides/forwarder_test.go","lines":["@@ -0,0 +1,231 @@","+package overrides","+","+import (","+\t\"bytes\"","+\t\"encoding/json\"","+\t\"fmt\"","+\t\"testing\"","+","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.yaml.in/yaml/v2\"","+","+\t\"github.com/grafana/tempo/v3/modules/overrides/userconfigurable/client\"","+)","+","+func TestForwarderOverridesSerialization(t *testing.T) {","+\tfor _, queueConfig := range []ForwarderOverrides{{}, {QueueSize: 250, Workers: 4}} {","+\t\tt.Run(fmt.Sprintf(\"size=%d/workers=%d\", queueConfig.QueueSize, queueConfig.Workers), func(t *testing.T) {","+\t\t\twant := Overrides{","+\t\t\t\tForwarders: []string{\"external-otlp\"},","+\t\t\t\tForwarder:  queueConfig,","+\t\t\t\tMetricsGenerator: MetricsGeneratorOverrides{","+\t\t\t\t\tForwarder: ForwarderOverrides{QueueSize: 500, Workers: 8},","+\t\t\t\t},","+\t\t\t}","+\t\t\tfor _, format := range []struct {","+\t\t\t\tname      string","+\t\t\t\tmarshal   func(any) ([]byte, error)","+\t\t\t\tunmarshal func([]byte, any) error","+\t\t\t}{","+\t\t\t\t{\"yaml\", yaml.Marshal, yaml.UnmarshalStrict},","+\t\t\t\t{\"json\", json.Marshal, json.Unmarshal},","+\t\t\t} {","+\t\t\t\tt.Run(format.name, func(t *testing.T) {","+\t\t\t\t\tdata, err := format.marshal(want)","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\tvar got Overrides","+\t\t\t\t\trequire.NoError(t, format.unmarshal(data, &got))","+\t\t\t\t\trequire.Equal(t, want, got)","+","+\t\t\t\t\tlegacy := want.toLegacy()","+\t\t\t\t\trequire.Equal(t, queueConfig.QueueSize, legacy.ForwarderQueueSize)","+\t\t\t\t\trequire.Equal(t, queueConfig.Workers, legacy.ForwarderWorkers)","+\t\t\t\t\tdata, err = format.marshal(legacy)","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\tvar gotLegacy LegacyOverrides","+\t\t\t\t\trequire.NoError(t, format.unmarshal(data, &gotLegacy))","+\t\t\t\t\tconverted := gotLegacy.toNewLimits()","+\t\t\t\t\trequire.Equal(t, want.Forwarder, converted.Forwarder)","+\t\t\t\t\trequire.Equal(t, want.Forwarders, converted.Forwarders)","+\t\t\t\t\trequire.Equal(t, want.MetricsGenerator.Forwarder, converted.MetricsGenerator.Forwarder)","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestForwarderOverridesConfigParsing(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname string","+\t\tyaml string","+\t\ttyp  ConfigType","+\t}{","+\t\t{\"modern\", \"defaults:\\n  forwarders: [external-otlp]\\n  forwarder:\\n    queue_size: 250\\n    workers: 4\\n\", ConfigTypeNew},","+\t\t{\"legacy\", \"forwarders: [external-otlp]\\nforwarder_queue_size: 250\\nforwarder_workers: 4\\n\", ConfigTypeLegacy},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tvar cfg Config","+\t\t\trequire.NoError(t, yaml.UnmarshalStrict([]byte(tc.yaml), &cfg))","+\t\t\trequire.Equal(t, tc.typ, cfg.ConfigType)","+\t\t\trequire.Equal(t, []string{\"external-otlp\"}, cfg.Defaults.Forwarders)","+\t\t\trequire.Equal(t, ForwarderOverrides{QueueSize: 250, Workers: 4}, cfg.Defaults.Forwarder)","+\t\t})","+\t}","+}","+","+func TestForwarderOverridesLookup(t *testing.T) {","+\tdefaults := Overrides{","+\t\tForwarders: []string{\"default-forwarder\"},","+\t\tForwarder:  ForwarderOverrides{QueueSize: 250, Workers: 4},","+\t}","+\tfor _, wildcard := range []bool{false, true} {","+\t\tt.Run(fmt.Sprintf(\"wildcard=%t\", wildcard), func(t *testing.T) {","+\t\t\tpto := &perTenantOverrides{TenantLimits: map[string]*Overrides{","+\t\t\t\t\"custom\": {Forwarders: []string{\"tenant-forwarder\"}, Forwarder: ForwarderOverrides{QueueSize: 500, Workers: 8}},","+\t\t\t\t\"zero\":   {Forwarders: []string{\"zero-forwarder\"}},","+\t\t\t\t\"null\":   nil,","+\t\t\t}}","+\t\t\tfallback := defaults.Forwarder","+\t\t\tif wildcard {","+\t\t\t\tfallback = ForwarderOverrides{QueueSize: 300, Workers: 6}","+\t\t\t\tpto.TenantLimits[\"*\"] = &Overrides{Forwarder: fallback}","+\t\t\t}","+\t\t\tmgr, cleanup := createAndInitializeRuntimeOverridesManager(t, defaults, toYamlBytes(t, pto))","+\t\t\tdefer cleanup()","+\t\t\tfor tenant, want := range map[string]ForwarderOverrides{","+\t\t\t\t\"custom\": {QueueSize: 500, Workers: 8},","+\t\t\t\t\"zero\":   {QueueSize: 100, Workers: 2},","+\t\t\t\t\"other\":  fallback,","+\t\t\t\t\"null\":   fallback,","+\t\t\t} {","+\t\t\t\trequire.Equal(t, want.QueueSize, mgr.ForwarderQueueSize(tenant), tenant)","+\t\t\t\trequire.Equal(t, want.Workers, mgr.ForwarderWorkers(tenant), tenant)","+\t\t\t}","+\t\t\trequire.Equal(t, []string{\"tenant-forwarder\"}, mgr.Forwarders(\"custom\"))","+\t\t})","+\t}","+}","+","+func TestForwarderOverridesDefaultsValidation(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname string","+\t\tcfg  ForwarderOverrides","+\t\twant ForwarderOverrides","+\t\terr  string","+\t}{","+\t\t{\"zero\", ForwarderOverrides{}, ForwarderOverrides{QueueSize: 100, Workers: 2}, \"\"},","+\t\t{\"positive\", ForwarderOverrides{QueueSize: 250, Workers: 4}, ForwarderOverrides{QueueSize: 250, Workers: 4}, \"\"},","+\t\t{\"size only\", ForwarderOverrides{QueueSize: 250}, ForwarderOverrides{QueueSize: 250, Workers: 2}, \"\"},","+\t\t{\"workers only\", ForwarderOverrides{Workers: 4}, ForwarderOverrides{QueueSize: 100, Workers: 4}, \"\"},","+\t\t{\"negative size\", ForwarderOverrides{QueueSize: -1, Workers: 4}, ForwarderOverrides{}, \"forwarder.queue_size\"},","+\t\t{\"negative workers\", ForwarderOverrides{QueueSize: 250, Workers: -1}, ForwarderOverrides{}, \"forwarder.workers\"},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tmgr, err := newRuntimeConfigOverrides(Config{Defaults: Overrides{Forwarder: tc.cfg}}, nil, prometheus.NewRegistry())","+\t\t\tif tc.err != \"\" {","+\t\t\t\trequire.ErrorContains(t, err, tc.err)","+\t\t\t\trequire.Nil(t, mgr)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, tc.want.QueueSize, mgr.ForwarderQueueSize(\"tenant\"))","+\t\t\trequire.Equal(t, tc.want.Workers, mgr.ForwarderWorkers(\"tenant\"))","+\t\t\trequire.Equal(t, tc.cfg, mgr.GetRuntimeOverridesFor(\"tenant\").Forwarder)","+\t\t})","+\t}","+}","+","+func TestForwarderOverridesAccessorDefaults(t *testing.T) {","+\tfor _, source := range []string{\"defaults\", \"