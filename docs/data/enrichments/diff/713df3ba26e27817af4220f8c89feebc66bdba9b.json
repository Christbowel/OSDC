-passthrough-option","+  namespace: istio-system","+  labels:","+    topology.istio.io/network: \"network-1\"","+spec:","+  gatewayClassName: istio-east-west","+  listeners:","+  - name: mesh","+    port: 15008","+    protocol: HBONE","+    tls:","+      mode: Terminate","+      options:","+        gateway.istio.io/tls-terminate-mode: ISTIO_MUTUAL","+  - name: cross-network","+    port: 35443","+    protocol: TLS","+    tls:","+      mode: Passthrough","+      options:","+        gateway.istio.io/listener-protocol: auto-passthrough"],"additions":52,"deletions":0,"truncated":false},{"path":"pilot/pkg/config/kube/gateway/testdata/east-west-ambient.yaml.golden","lines":["@@ -1,5 +1,47 @@"," apiVersion: networking.istio.io/v1"," kind: Gateway","+metadata:","+  annotations:","+    internal.istio.io/gateway-semantics: gateway","+    internal.istio.io/gateway-service: with-auto-passthrough-option.istio-system.svc.domain.suffix","+    internal.istio.io/parents: Gateway/with-auto-passthrough-option/cross-network.istio-system","+    internal.istio.io/service-account-name: with-auto-passthrough-option","+  name: with-auto-passthrough-option~istio-autogenerated-k8s-gateway~cross-network","+  namespace: istio-system","+spec:","+  servers:","+  - hosts:","+    - istio-system/*","+    port:","+      name: default","+      number: 35443","+      protocol: TLS","+    tls:","+      mode: AUTO_PASSTHROUGH","+---","+apiVersion: networking.istio.io/v1","+kind: Gateway","+metadata:","+  annotations:","+    internal.istio.io/gateway-semantics: gateway","+    internal.istio.io/gateway-service: with-auto-passthrough.istio-system.svc.domain.suffix","+    internal.istio.io/parents: Gateway/with-auto-passthrough/cross-network.istio-system","+    internal.istio.io/service-account-name: with-auto-passthrough","+  name: with-auto-passthrough~istio-autogenerated-k8s-gateway~cross-network","+  namespace: istio-system","+spec:","+  servers:","+  - hosts:","+    - istio-system/*.local","+    port:","+      name: default","+      number: 15443","+      protocol: TLS","+    tls:","+      mode: AUTO_PASSTHROUGH","+---","+apiVersion: networking.istio.io/v1","+kind: Gateway"," metadata:","   annotations:","     internal.istio.io/gateway-semantics: gateway"],"additions":42,"deletions":0,"truncated":false},{"path":"pilot/pkg/networking/core/cluster.go","lines":["@@ -358,6 +358,12 @@ func (configgen *ConfigGeneratorImpl) buildClusters(proxy *model.Proxy, req *mod"," \t\tob, cs := configgen.buildOutboundClusters(cb, proxy, outboundPatcher, outboundServices)"," \t\tcacheStats = cacheStats.merge(cs)"," \t\tresources = append(resources, ob...)","+\t\t// An ambient E/W gateway can also expose an AUTO_PASSTHROUGH listener (port 15443 by default) so that","+\t\t// sidecar multi-network traffic can be served by the same gateway. Those listeners route by SNI to","+\t\t// the SNI-DNAT clusters, exactly like a classic (Router) east-west gateway does.","+\t\tif isAmbientEastWestGateway(proxy) && proxy.MergedGateway != nil && proxy.MergedGateway.ContainsAutoPassthroughGateways {","+\t\t\tclusters = append(clusters, configgen.buildOutboundSniDnatClusters(proxy, req, outboundPatcher)...)","+\t\t}"," \t\t// Setup inbound clusters"," \t\tinboundPatcher := clusterPatcher{efw: envoyFilterPatches, pctx: networking.EnvoyFilter_SIDECAR_INBOUND}"," \t\tclusters = append(clusters, configgen.buildWaypointInboundClusters(cb, proxy, req.Push, wps.services)...)"],"additions":6,"deletions":0,"truncated":false},{"path":"pilot/pkg/networking/core/listener_waypoint.go","lines":["@@ -170,7 +170,7 @@ func (lb *ListenerBuilder) buildEastWestTLSPassthroughListeners() []*listener.Li"," \tfor _, ml := range mutableopts {"," \t\tml.mutable.Listener = buildGatewayListener(*ml.opts, ml.transport)"," \t\tif err := ml.mutable.build(lb, *ml.opts); err != nil {","-\t\t\tlog.Warnf(\"east-west gateway: omitting TLS passthrough listener %q: %v\", ml.mutable.Listener.Name, err)","+\t\t\tlog.Warnf(\"east-west gateway: omitting passthrough listener %q: %v\", ml.mutable.Listener.Name, err)"," \t\t\tcontinue"," \t\t}"," \t\tl := ml.mutable.Listener","@@ -193,7 +193,8 @@ func (lb *ListenerBuilder) buildWaypointInbound() []*listener.Listener {"," \t// twice - we only need that in waypoints, so we skip generating those in E/W gateway."," \t//"," \t// For E/W gateways, we also might need TLS passthrough, so that internal services (eg.","-\t// the Kubernetes API Server) can be exposed through the E/W gateways.","+\t// the Kubernetes API Server) can be exposed through the E/W gateways, and AUTO_PASSTHROUGH,","+\t// so that the same gateway can serve sidecar (non-ambient) multi-network traffic."," \tvar orderedWPS []*model.Service"," \twls, wps := findWaypointResources(lb.node, lb.push)"," \tif wps != nil {"],"additions":3,"deletions":2,"truncated":false},{"path":"pilot/pkg/xds/cds.go","lines":["@@ -88,7 +88,9 @@ func cdsNeedsPush(req *model.PushRequest, proxy *model.Proxy) (*model.PushReques"," \t\t\theadlessOnly = false"," \t\t}"," ","-\t\tif proxy.Type == model.Router {","+\t\t// Ambient east-west gateways merge Gateway resources like routers do, and their AUTO_PASSTHROUGH","+\t\t// servers drive the SNI-DNAT clusters, so Gateway changes must be considered for them as well.","+\t\tif proxy.Type == model.Router || proxy.IsAmbientEastWestGateway() {"," \t\t\tif config.Kind == kind.Gateway {"," \t\t\t\t// Do the check outside of the loop since its slow; just trigger we need it"," \t\t\t\tcheckGateway = true"],"additions":3,"deletions":1,"truncated":false},{"path":"pilot/pkg/xds/eastwest_gateway_test.go","lines":["@@ -0,0 +1,179 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package xds_test","+","+import (","+\t\"testing\"","+","+\tlistenerv3 \"github.com/envoyproxy/go-control-plane/envoy/config/listener/v3\"","+","+\t\"istio.io/api/label\"","+\t\"istio.io/istio/pilot/pkg/features\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\t\"istio.io/istio/pilot/test/xds\"","+\t\"istio.io/istio/pilot/test/xdstest\"","+\t\"istio.io/istio/pkg/config/constants\"","+\t\"istio.io/istio/pkg/slices\"","+\t\"istio.io/istio/pkg/test\"","+\t\"istio.io/istio/pkg/test/util/assert\"","+\t\"istio.io/istio/pkg/util/sets\"","+)","+","+const (","+\t// Istio Gateway as produced by the Gateway API conversion of an istio-east-west Gateway with a","+\t// TLS passthrough listener on port 15443 (see testdata/east-west-ambient.yaml).","+\teastWestAutoPassthroughGateway = `apiVersion: networking.istio.io/v1","+kind: Gateway","+metadata:","+  name: eastwestgateway","+  namespace: istio-system","+spec:","+  selector:","+    istio: eastwestgateway","+  servers:","+  - port:","+      number: 15443","+      name: cross-network","+      protocol: TLS","+    hosts:","+    - \"*\"","+    tls:","+      mode: AUTO_PASSTHROUGH","+`","+\teastWestAppServiceEntry = `apiVersion: networking.istio.io/v1","+kind: ServiceEntry","+metadata:","+  name: app","+  namespace: default","+spec:","+  hosts: [app.com]","+  addresses: [1.2.3.4]","+  location: MESH_INTERNAL","+  ports:","+  - number: 80","+    name: http","+    protocol: HTTP","+  resolution: STATIC","+  workloadSelector:","+    labels:","+      app: app","+`","+\t// A sidecar workload: it advertises Istio mTLS, so AUTO_PASSTHROUGH may forward to it.","+\teastWestSidecarWorkloadEntry = `apiVersion: networking.istio.io/v1","+kind: WorkloadEntry","+metadata:","+  name: app-sidecar","+  namespace: default","+  labels:","+    app: app","+    security.istio.io/tlsMode: istio","+spec:","+  address: 1.1.1.1","+  network: network-1","+`","+\t// An ambient workload: it only speaks HBONE, so it must not receive passthrough mTLS traffic.","+\teastWestAmbientWorkloadEntry = `apiVersion: networking.istio.io/v1","+kind: WorkloadEntry","+metadata:","+  name: app-ambient","+  namespace: default","+  labels:","+    app: app","+  annotations:","+    ambient.istio.io/redirection: enabled","+spec:","+  address: 1.1.1.2","+  network: network-1","+`","+)","+","+func setupAmbientEastWestGatewayTest(t *testing.T, configs ...string) (*xds.FakeDiscoveryServer, *model.Proxy) {","+\ttest.SetForTest(t, &features.EnableAmbientMultiNetwork, true)","+\td := xds.NewFakeDiscoveryServer(t, xds.FakeOptions{","+\t\tConfigString: joinYaml(configs...),","+\t})","+\tproxy := d.SetupProxy(&model.Proxy{","+\t\tType:            model.Waypoint,","+\t\tConfigNamespace: \"istio-system\",","+\t\tIPAddresses:     []string{\"10.0.0.1\"},","+\t\tLabels: map[string]string{","+\t\t\t\"istio\":                   \"eastwestgateway\",","+\t\t\tlabel.GatewayManaged.Name: constants.ManagedGatewayEastWestControllerLabel,","+\t\t},","+\t\tMetadata: &model.NodeMetadata{","+\t\t\tNetwork: \"network-1\",","+\t\t},","+\t})","+\treturn d, proxy","+}","+","+// TestAmbientEastWestGatewayAutoPassthrough verifies that a single ambient east-west gateway can serve","+// both HBONE (ambient) and AUTO_PASSTHROUGH (sidecar multi-network) traffic.","+func TestAmbientEastWestGatewayAutoPassthrough(t *testing.T) {","+\tsniDnatCluster := model.BuildDNSSrvSubsetKey(model.TrafficDirectionOutbound, \"\", \"app.com\", 80)","+","+\tt.Run(\"with auto passthrough server\", func(t *testing.T) {","+\t\td, proxy := setupAmbientEastWestGatewayTest(t,","+\t\t\teastWestAutoPassthroughGateway, eastWestAppServiceEntry, eastWestSidecarWorkloadEntry, eastWestAmbientWorkloadEntry)","+","+\t\tif proxy.MergedGateway == nil || !proxy.MergedGateway.ContainsAutoPassthroughGateways {","+\t\t\tt.Fatalf(\"expected the east-west gateway to merge an AUTO_PASSTHROUGH server, got %+v\", proxy.MergedGateway)","+\t\t}","+","+\t\t// LDS: the HBONE path is untouched, and an AUTO_PASSTHROUGH listener routes by SNI-DNAT cluster name.","+\t\tlisteners := d.Listeners(proxy)","+\t\tnames := sets.New(xdstest.ExtractListenerNames(listeners)...)","+\t\tfor _, expected := range []string{\"connect_terminate\", \"main_internal\", \"0.0.0.0_15443\"} {","+\t\t\tassert.Equal(t, names.Contains(expected), true, \"missing listener \"+expected)","+\t\t}","+\t\tl := xdstest.ExtractListener(\"0.0.0.0_15443\", listeners)","+\t\tassert.Equal(t, l.GetAddress().GetSocketAddress().GetPortValue(), uint32(15443))","+\t\t_, hasTLSInspector := xdstest.ExtractListenerFilters(l)[\"envoy.filters.listener.tls_inspector\"]","+\t\tassert.Equal(t, hasTLSInspector, true, \"auto passthrough listener needs the TLS inspector for SNI routing\")","+\t\tfc := slices.FindFunc(l.FilterChains, func(fc *listenerv3.FilterChain) bool {","+\t\t\treturn slices.Equal(fc.GetFilterChainMatch().GetServerNames(), []string{sniDnatCluster})","+\t\t})","+\t\tif fc == nil {","+\t\t\tt.Fatalf(\"no filter chain matching SNI %q, got %v\", sniDnatCluster, xdstest.ExtractFilterChainNames(l))","+\t\t}","+\t\tassert.Equal(t, sets.New((*fc).GetFilterChainMatch().GetApplicationProtocols()...).Contains(\"istio\"), true,","+\t\t\t\"auto passthrough filter chain must match Istio mTLS ALPNs\")","+\t\tassert.Equal(t, xdstest.ExtractTCPProxy(t, *fc).GetCluster(), sniDnatCluster)","+","+\t\t// CDS: the SNI-DNAT cluster exists, like on a classic east-west gateway.","+\t\tclusters := d.Clusters(proxy)","+\t\tc := xdstest.ExtractCluster(sniDnatCluster, clusters)","+\t\tif c == nil {","+\t\t\tt.Fatalf(\"missing SNI-DNAT cluster %q, got %v\", sniDnatCluster, xdstest.ExtractEdsClusterNames(clusters))","+\t\t}","+","+\t\t// EDS: only workloads that accept Istio mTLS are reachable through passthrough; ambient workloads","+\t\t// (HBONE only) are filtered out, exactly like on a classic east-west gateway.","+\t\teps := xdstest.ExtractLoadAssignments(d.Endpoints(proxy))","+\t\tassert.Equal(t, eps[sniDnatCluster], []string{\"1.1.1.1:80\"})","+\t})","+","+\tt.Run(\"without auto passthrough server\", func(t *testing.T) {","+\t\td, proxy := setupAmbientEastWestGatewayTest(t,","+\t\t\teastWestAppServiceEntry, eastWestSidecarWorkloadEntry, eastWestAmbientWorkloadEntry)","+","+\t\tlisteners := d.Listeners(proxy)","+\t\tnames := sets.New(xdstest.ExtractListenerNames(listeners)...)","+\t\tassert.Equal(t, names.Contains(\"connect_terminate\"), true)","+\t\tassert.Equal(t, names.Contains(\"0.0.0.0_15443\"), false)","+\t\tassert.Equal(t, xdstest.ExtractCluster(sniDnatCluster, d.Clusters(proxy)) == nil, true,","+\t\t\t\"SNI-DNAT clusters must only be built for AUTO_PASSTHROUGH gateways\")","+\t})","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"pilot/pkg/xds/eastwest_push_test.go","lines":["@@ -0,0 +1,71 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package xds","+","+import (","+\t\"testing\"","+","+\t\"istio.io/api/label\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\t\"istio.io/istio/pkg/config/constants\"","+\t\"istio.io/istio/pkg/config/schema/kind\"","+\t\"istio.io/istio/pkg/util/sets\"","+)","+","+// TestAmbientEastWestGatewayPushOnGatewayChange verifies that Gateway changes, which routers never skip,","+// are also not skipped for ambient east-west gateways: their passthrough listeners and SNI-DNAT clusters","+// are built from the merged Gateway resources.","+func TestAmbientEastWestGatewayPushOnGatewayChange(t *testing.T) {","+\treq := &model.PushRequest{","+\t\tConfigsUpdated: sets.New(model.ConfigKey{Kind: kind.Gateway, Name: \"eastwestgateway\", Namespace: \"istio-system\"}),","+\t\tReason:         model.NewReasonStats(model.ConfigUpdate),","+\t\tPush:           &model.PushContext{},","+\t}","+\tcases := []struct {","+\t\tname   string","+\t\tlabels map[string]string","+\t\twant   bool","+\t}{","+\t\t{","+\t\t\tname:   \"ambient east-west gateway\",","+\t\t\tlabels: map[string]string{label.GatewayManaged.Name: constants.ManagedGatewayEastWestControllerLabel},","+\t\t\twant:   true,","+\t\t},","+\t\t{","+\t\t\tname:   \"regular waypoint\",","+\t\t\tlabels: map[string]string{label.GatewayManaged.Name: constants.ManagedGatewayMeshControllerLabel},","+\t\t\twant:   false,","+\t\t},","+\t}","+\tfor _, tt := range cases {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tproxy := &model.Proxy{","+\t\t\t\tType:              model.Waypoint,","+\t\t\t\tIPAddresses:       []string{\"1.1.1.1\"},","+\t\t\t\tID:                \"eastwestgateway.istio-system\",","+\t\t\t\tLabels:            tt.labels,","+\t\t\t\tMetadata:          &model.NodeMetadata{},","+\t\t\t\tMergedGateway:     &model.MergedGateway{},","+\t\t\t\tPrevMergedGateway: &model.PrevMergedGateway{},","+\t\t\t}","+\t\t\tif got := ldsNeedsPush(proxy, req); got != tt.want {","+\t\t\t\tt.Errorf(\"ldsNeedsPush() = %v, want %v\", got, tt.want)","+\t\t\t}","+\t\t\tif _, got := cdsNeedsPush(req, proxy); got != tt.want {","+\t\t\t\tt.Errorf(\"cdsNeedsPush() = %v, want %v\", got, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"pilot/pkg/xds/lds.go","lines":["@@ -85,6 +85,14 @@ func ldsNeedsPush(proxy *model.Proxy, req *model.PushRequest) bool {"," \theadlessOnly := proxy.Type == model.Router && req.Reason.Has(model.HeadlessEndpointUpdate) && !req.Reason.Has(model.ServiceUpdate)"," \tsawServiceEntry := false"," ","+\tskipped := skippedLdsConfigs[proxy.Type]","+\tif proxy.IsAmbientEastWestGateway() {","+\t\t// Ambient east-west gateways build gateway listeners (TLS passthrough and AUTO_PASSTHROUGH) from","+\t\t// their merged Gateway resources, so Gateway changes cannot be skipped for them. Address changes","+\t\t// have already been handled by waypointNeedsPush above, so the router set is the right one here.","+\t\tskipped = skippedLdsConfigs[model.Router]","+\t}","+"," \tfor config := range req.ConfigsUpdated {"," \t\tif headlessOnly {"," \t\t\tif config.Kind == kind.ServiceEntry {","@@ -96,7 +104,7 @@ func ldsNeedsPush(proxy *model.Proxy, req *model.PushRequest) bool {"," \t\t\t// headless-only update, none of them need to trigger a push on their own."," \t\t\theadlessOnly = false"," \t\t}","-\t\tif !skippedLdsConfigs[proxy.Type].Contains(config.Kind) {","+\t\tif !skipped.Contains(config.Kind) {"," \t\t\tif config.Kind == kind.PeerAuthentication && config.Namespace != proxy.ConfigNamespace &&"," \t\t\t\tconfig.Namespace != req.Push.Mesh.RootNamespace {"," \t\t\t\t// PeerAuthentication of the configNamespace or rootNamespace can only impact lds"],"additions":9,"deletions":1,"truncated":false},{"path":"releasenotes/notes/ewgw-auto-passthrough.yaml","lines":["@@ -0,0 +1,13 @@","+apiVersion: release-notes/v2","+kind: feature","+area: traffic-management","+issue:","+  - 60887","+","+releaseNotes:","+- |","+  **Added** support for `AUTO_PASSTHROUGH` listeners on ambient east-west gateways (`istio-east-west`","+  GatewayClass). A TLS passthrough listener on port 15443 (or any port using the","+  `gateway.istio.io/listener-protocol: auto-passthrough` option) now serves sidecar multi-network","+  traffic alongside the HBONE listener, so a mixed ambient and sidecar mesh no longer needs two","+  east-west gateways per cluster. This requires `AMBIENT_ENABLE_MULTI_NETWORK` to be enabled."],"additions":13,"deletions":0,"truncated":false},{"path":"tests/integration/ambient/multicluster_test.go","lines":["@@ -19,6 +19,8 @@ package ambient"," import ("," \t\"context\""," \t\"fmt\"","+\t\"strconv\"","+\t\"strings\""," \t\"testing\""," \t\"time\""," ","@@ -955,3 +957,180 @@ func addPassthroughListenerOrFail(t framework.TestContext, c cluster.Cluster, ns"," \t\t}, retry.Timeout(time.Minute), retry.Delay(time.Second))"," \t})"," }","+","+// TestEastWestGatewaySidecarAutoPassthrough checks that a single ambient east-west gateway can also serve","+// sidecar (non-ambient) multi-network traffic. Adding a TLS passthrough listener on port 15443 to the","+// istio-east-west Gateway makes it an AUTO_PASSTHROUGH listener, which routes the sidecar's mTLS traffic by","+// SNI to the SNI-DNAT cluster of the target service, exactly like a classic east-west gateway does. A mixed","+// ambient and sidecar mesh therefore no longer needs a second east-west gateway per cluster.","+func TestEastWestGatewaySidecarAutoPassthrough(t *testing.T) {","+\tframework.NewMulticlusterTest(t).Run(func(t framework.TestContext) {","+\t\tif !t.Settings().Ambient || !t.Settings().AmbientMultiNetwork {","+\t\t\tt.Skip(\"this test is ambient multi-cluster specific\")","+\t\t}","+\t\tallClusters := slices.Group(t.Clusters(), func(c cluster.Cluster) string {","+\t\t\treturn c.NetworkName()","+\t\t})","+\t\tnetworks := maps.Keys(allClusters)","+\t\tif len(networks) < 2 {","+\t\t\tt.Skip(\"east-west gateway auto passthrough test requires at least 2 clusters on different networks\")","+\t\t}","+","+\t\t// gwCluster hosts the east-west gateway under test and a backend; remoteCluster hosts the sidecar client.","+\t\tgwCluster := allClusters[networks[0]][0]","+\t\tremoteCluster := allClusters[networks[1]][0]","+","+\t\tcrd.DeployGatewayAPIOrSkip(t)","+\t\tfor _, c := range []cluster.Cluster{gwCluster, remoteCluster} {","+\t\t\t_, err := c.Kube().AdmissionregistrationV1().MutatingWebhookConfigurations().","+\t\t\t\tGet(t.Context(), \"istio-sidecar-injector\", metav1.GetOptions{})","+\t\t\tif kerrors.IsNotFound(err) {","+\t\t\t\tt.Skipf(\"sidecar injector is not installed in cluster %s\", c.Name())","+\t\t\t}","+\t\t\tif err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t}","+","+\t\t// Sidecar-injected namespace (not ambient), so that the client and backends are classic sidecar workloads.","+\t\tnsConfig := namespace.NewOrFail(t, namespace.Config{","+\t\t\tPrefix: \"ew-autopassthrough\",","+\t\t\tInject: true,","+\t\t})","+","+\t\tconst backendSvc = \"autopassthrough-backend\"","+\t\tconst clientSvc = \"autopassthrough-client\"","+\t\t// Port 15443 with TLS passthrough on a network-labeled gateway is implicitly AUTO_PASSTHROUGH.","+\t\tconst autoPassthroughPort = 15443","+","+\t\techos := deployment.New(t).","+\t\t\tWithClusters(gwCluster, remoteCluster).","+\t\t\tWithConfig(echo.Config{","+\t\t\t\tService:        backendSvc,","+\t\t\t\tNamespace:      nsConfig,","+\t\t\t\tPorts:          echo.Ports{ports.HTTP},","+\t\t\t\tServiceAccount: true,","+\t\t\t\tServiceLabels: map[string]string{","+\t\t\t\t\t// In ambient multi-network, a service is only exported across clusters when it is global.","+\t\t\t\t\t\"istio.io/global\": \"true\",","+\t\t\t\t},","+\t\t\t}).","+\t\t\tWithConfig(echo.Config{","+\t\t\t\tService:        clientSvc,","+\t\t\t\tNamespace:      nsConfig,","+\t\t\t\tCluster:        remoteCluster,","+\t\t\t\tPorts:          echo.Ports{ports.HTTP},","+\t\t\t\tServiceAccount: true,","+\t\t\t}).","+\t\t\tBuildOrFail(t)","+","+\t\tbackends := match.ServiceName(echo.NamespacedName{Name: backendSvc, Namespace: nsConfig}).GetMatches(echos)","+\t\tclients := match.ServiceName(echo.NamespacedName{Name: clientSvc, Namespace: nsConfig}).GetMatches(echos)","+\t\tif len(backends) == 0 || len(clients) == 0 {","+\t\t\tt.Fatalf(\"missing echo instances: %d backends, %d clients\", len(backends), len(clients))","+\t\t}","+","+\t\tsystemNS := i.Settings().SystemNamespace","+\t\tconst ewGatewayName = \"istio-eastwestgateway\"","+\t\tconst autoPassthroughListenerName = \"cross-network\"","+","+\t\t// Add the AUTO_PASSTHROUGH listener to the existing shared ambient east-west gateway, which keeps","+\t\t// serving HBONE on port 15008 at the same time.","+\t\taddPassthroughListenerOrFail(t, gwCluster, systemNS, ewGatewayName, autoPassthroughListenerName, autoPassthroughPort)","+\t\twaitForListenerProgrammedOrFail(t, gwCluster, systemNS, ewGatewayName, autoPassthroughListenerName)","+","+\t\tewgw := i.EastWestGatewayForAmbient(gwCluster)","+\t\tif addrs, portList := ewgw.AddressesForPort(autoPassthroughPort); len(addrs) == 0 || len(portList) == 0 {","+\t\t\tt.Fatal(\"east-west gateway auto passthrough address or port not found\")","+\t\t}","+\t\tsniDNATCluster := fmt.Sprintf(\"outbound_.%d_._.%s.%s.svc.cluster.local\", ports.HTTP.ServicePort, backendSvc, nsConfig.Name())","+","+\t\t// The sidecar client must reach the backends on every network. The backend on the gateway's network is","+\t\t// only reachable through the east-west gateway's AUTO_PASSTHROUGH listener.","+\t\tclients[0].CallOrFail(t, echo.CallOptions{","+\t\t\tTo:    backends,","+\t\t\tPort:  ports.HTTP,","+\t\t\tCount: 10,","+\t\t\tCheck: check.And(","+\t\t\t\tcheck.OK(),","+\t\t\t\tcheck.ReachedClusters(t.AllClusters(), backends.Clusters()),","+\t\t\t),","+\t\t\tRetry: echo.Retry{","+\t\t\t\tOptions: []retry.Option{retry.Timeout(2 * time.Minute), retry.Delay(time.Second)},","+\t\t\t},","+\t\t})","+","+\t\t// Confirm the traffic really went through the gateway: its SNI-DNAT cluster for the backend must have","+\t\t// forwarded connections to the local backend pod.","+\t\tretry.UntilSuccessOrFail(t, func() error {","+\t\t\tconnections, err := eastWestGatewayUpstreamConnections(t, gwCluster, systemNS, ewGatewayName, sniDNATCluster)","+\t\t\tif err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t\tif connections == 0 {","+\t\t\t\treturn fmt.Errorf(\"east-west gateway cluster %q has not forwarded any connection yet\", sniDNATCluster)","+\t\t\t}","+\t\t\treturn nil","+\t\t}, retry.Timeout(time.Minute), retry.Delay(time.Second))","+\t})","+}","+","+// waitForListenerProgrammedOrFail waits until the given listener of a Gateway reports Programmed=True.","+func waitForListenerProgrammedOrFail(t framework.TestContext, c cluster.Cluster, ns, gatewayName, listenerName string) {","+\tt.Helper()","+\tretry.UntilSuccessOrFail(t, func() error {","+\t\tgw, err := c.GatewayAPI().GatewayV1().Gateways(ns).Get(t.Context(), gatewayName, metav1.GetOptions{})","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"gateway not found: %v\", err)","+\t\t}","+\t\tfor _, ls := range gw.Status.Listeners {","+\t\t\tif string(ls.Name) != listenerName {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tfor _, cond := range ls.Conditions {","+\t\t\t\tif cond.Type == string(k8sv1.ListenerConditionProgrammed) && string(cond.Status) == \"True\" {","+\t\t\t\t\treturn nil","+\t\t\t\t}","+\t\t\t}","+\t\t\treturn fmt.Errorf(\"listener %q is not yet programmed\", listenerName)","+\t\t}","+\t\treturn fmt.Errorf(\"listener %q not found in gateway status\", listenerName)","+\t}, retry.Timeout(2*time.Minute), retry.Delay(time.Second))","+}","+","+// eastWestGatewayUpstreamConnections returns the number of connections the east-west gateway pods of the","+// given cluster have forwarded to the hosts of the given Envoy cluster, read from their Envoy admin","+// clusters endpoint.","+func eastWestGatewayUpstreamConnections(t framework.TestContext, c cluster.Cluster, ns, gatewayName, clusterName string) (int, error) {","+\tpods, err := c.Kube().CoreV1().Pods(ns).List(t.Context(), metav1.ListOptions{","+\t\tLabelSelector: label.IoK8sNetworkingGatewayGatewayName.Name + \"=\" + gatewayName,","+\t})","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tif len(pods.Items) == 0 {","+\t\treturn 0, fmt.Errorf(\"no east-west gateway pods found for %s/%s in cluster %s\", ns, gatewayName, c.Name())","+\t}","+\tout := \"\"","+\tfor _, pod := range pods.Items {","+\t\tstdout, _, err := c.PodExec(pod.Name, ns, \"istio-proxy\", \"pilot-agent request GET clusters\")","+\t\tif err != nil {","+\t\t\treturn 0, fmt.Errorf(\"failed reading clusters from east-west gateway pod %s: %v\", pod.Name, err)","+\t\t}","+\t\tout += stdout + \"\\n\"","+\t}","+\t// Lines look like: <cluster>::<host:port>::cx_total::<count>","+\ttotal := 0","+\tfor _, line := range strings.Split(out, \"\\n\") {","+\t\tfields := strings.Split(strings.TrimSpace(line), \"::\")","+\t\tif len(fields) != 4 || fields[0] != clusterName || fields[2] != \"cx_total\" {"],"additions":169,"deletions":0,"truncated":false}],"additions":699,"deletions":4,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-30T15:56:12.248634+00:00"}