sors, not views of input 0.","         std::vector<size_t> element_ids;","+        bool same_tensor = false;","     };","     std::map<size_t, AliasInfo> m_may_be_alias;","     // Aliases of tuple elements returned by inlined subgraphs, keyed by tuple tensor id and element index and"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/layer_tests/py_frontend_tests/test_torch_container_aliases.py","lines":["@@ -0,0 +1,428 @@","+# Copyright (C) 2018-2026 Intel Corporation","+# SPDX-License-Identifier: Apache-2.0","+","+from copy import deepcopy","+from typing import List, Tuple","+","+import numpy as np","+import openvino as ov","+import pytest","+import torch","+","+","+class ContainerMetadataMutation(torch.nn.Module):","+    __constants__ = [\"mutation\", \"right\", \"update_other\"]","+","+    def __init__(self, mutation, right, update_other):","+        super().__init__()","+        self.mutation = mutation","+        self.right = right","+        self.update_other = update_other","+","+    def forward(self, cache: Tuple[torch.Tensor, torch.Tensor]):","+        return self.mutate(cache)","+","+    def mutate(self, cache: Tuple[torch.Tensor, torch.Tensor]):","+        left, right = cache","+        member = right if self.right else left","+        other = left if self.right else right","+        view = member[:, :2]","+        if self.update_other:","+            other.add_(1)","+        if self.mutation == \"chain\":","+            member.transpose_(0, 1).unsqueeze_(0)","+        elif self.mutation == \"transpose\":","+            member.transpose_(0, 1)","+        elif self.mutation == \"unsqueeze\":","+            member.unsqueeze_(0)","+        else:","+            member.squeeze_(0)","+        if self.update_other:","+            other.unsqueeze_(-1)","+            member.add_(2)","+        return cache, view","+","+","+class NestedContainerMetadataMutation(ContainerMetadataMutation):","+    def forward(self, cache: Tuple[Tuple[torch.Tensor, torch.Tensor]]):","+        inner, = cache","+        _, view = self.mutate(inner)","+        return cache, view","+","+","+class ListMetadataMutation(torch.nn.Module):","+    __constants__ = [\"operation\"]","+","+    def __init__(self, operation):","+        super().__init__()","+        self.operation = operation","+","+    def forward(self, cache: List[torch.Tensor]):","+        left, right = cache","+        view = left[:, :2]","+        if self.operation == \"storage\":","+            cache[0].add_(1)","+        cache[0].transpose_(0, 1)","+        if self.operation == \"metadata\":","+            cache[0].unsqueeze_(0)","+        return cache, left, view","+","+","+@pytest.mark.precommit","+@pytest.mark.nightly","+def test_torch_metadata_mutation_after_unrelated_append():","+    class Model(torch.nn.Module):","+        def forward(self, cache: List[torch.Tensor], extra: torch.Tensor, target: torch.Tensor):","+            left, right = cache","+            before = left + right","+            cache.append(extra)","+            target.unsqueeze_(0)","+            return before, torch.cat(cache), target","+","+    model = torch.jit.script(Model())","+    inputs = ([torch.ones(2, 3), torch.full((2, 3), 2.0)], torch.full((2, 3), 3.0), torch.arange(6.0).reshape(2, 3))","+    converted = ov.convert_model(model, example_input=deepcopy(inputs))","+    compiled = ov.Core().compile_model(converted, \"CPU\", {\"INFERENCE_PRECISION_HINT\": \"f32\"})","+    results = list(compiled([value.numpy() for value in (*inputs[0], *inputs[1:])]).values())","+    assert len(results) == 3","+    for actual, reference in zip(results, model(*deepcopy(inputs))):","+        np.testing.assert_array_equal(actual, reference.numpy())","+","+","+@pytest.mark.precommit","+@pytest.mark.nightly","+@pytest.mark.parametrize(\"mutate_clone\", [False, True])","+@pytest.mark.parametrize(\"operation\", [\"clone\", \"detach\"])","+def test_torch_tensor_metadata_identity(mutate_clone, operation):","+    class Model(torch.nn.Module):","+        __constants__ = [\"mutate_clone\", \"operation\"]","+","+        def __init__(self):","+            super().__init__()","+            self.mutate_clone = mutate_clone","+            self.operation = operation","+","+        def forward(self, source):","+            clone = source.clone() if self.operation == \"clone\" else source.detach()","+            target = clone if self.mutate_clone else source","+            target.unsqueeze_(0)","+            return source, clone","+","+    model = torch.jit.script(Model())","+    source = torch.arange(6, dtype=torch.float32).reshape(2, 3)","+    converted = ov.convert_model(model, example_input=source)","+    compiled = ov.Core().compile_model(converted, \"CPU\", {\"INFERENCE_PRECISION_HINT\": \"f32\"})","+    results = list(compiled([source.numpy()]).values())","+    expected = model(source.clone())","+    assert len(results) == 2","+    for actual, reference in zip(results, expected):","+        np.testing.assert_array_equal(actual, reference.numpy())","+","+","+@pytest.mark.precommit","+@pytest.mark.nightly","+@pytest.mark.parametrize(\"operation\", [\"transpose\", \"storage\", \"metadata\"])","+def test_torch_list_member_metadata_preserves_views(operation):","+    inputs = [torch.arange(6, dtype=torch.float32).reshape(2, 3), torch.ones(2, 3)]","+    model = torch.jit.script(ListMetadataMutation(operation))","+    converted = ov.convert_model(model, example_input=(deepcopy(inputs),))","+    compiled = ov.Core().compile_model(converted, \"CPU\", {\"INFERENCE_PRECISION_HINT\": \"f32\"})","+    cache, left, view = model(deepcopy(inputs))","+    results = list(compiled([x.numpy() for x in inputs]).values())","+    assert len(results) == 4","+    for expected, actual in zip((*cache, left, view), results):","+        np.testing.assert_array_equal(actual, expected.numpy())","+","+","+@pytest.mark.precommit","+@pytest.mark.nightly","+def test_torch_wrapped_chunk_base_mutation():","+    from open