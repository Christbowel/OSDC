uffix\": \"z\"}),","+            json!({\"model\": \"render-model\", \"prompt\": [\"a\", \"\"], \"suffix\": \"z\", \"add_special_tokens\": false}),","+        ] {","+            let (status, json) = post_json(&mut app, \"/v1/completions/render\", body.clone()).await;","+            assert_eq!(status, StatusCode::OK, \"{body} -> {json}\");","+            let token_ids = (json.as_array().unwrap().iter())","+                .map(|request| request[\"token_ids\"].to_string())","+                .collect::<Vec<_>>()","+                .join(\" \");","+            results.push(format!(\"{body} -> {token_ids}\"));","+        }","+        expect_test::expect![[r#\"","+            {\"model\":\"render-model\",\"prompt\":\"a\",\"suffix\":\"z\"} -> [256,128801,97,128800,122,128802]","+            {\"model\":\"render-model\",\"prompt\":[\"a\",\"\"],\"suffix\":\"z\",\"add_special_tokens\":false} -> [128801,97,128800,122,128802] [128801,128800,122,128802]\"#]]","+        .assert_eq(&results.join(\"\\n\"));","+    }","+}","+","+/// Like Python, a `suffix` is rejected with `echo`, prompt truncation, which","+/// could cut off the fill-in-the-middle markers, token-ID prompts, and models","+/// without a fill-in-the-middle format.","+#[tokio::test]","+async fn completions_render_suffix_rejects_unsupported_inputs() {","+    let mut fim_app =","+        completion_suffix_render_app(Arc::new(vllm_chat::DeepSeekV4ChatRenderer::default()));","+    let mut results = Vec::new();","+    for body in [","+        json!({\"model\": \"render-model\", \"prompt\": \"a\", \"suffix\": \"z\", \"echo\": true}),","+        json!({\"model\": \"render-model\", \"prompt\": \"a\", \"suffix\": \"z\", \"truncate_prompt_tokens\": 4}),","+        json!({\"model\": \"render-model\", \"prompt\": [97], \"suffix\": \"z\"}),","+    ] {","+        let (status, json) = post_json(&mut fim_app, \"/v1/completions/render\", body.clone()).await;","+        results.push(format!(\"{body} -> {status} {}\", json[\"error\"]));","+    }","+    let body = json!({\"model\": \"render-model\", \"prompt\": \"a\", \"suffix\": \"z\"});","+    let (status, json) = post_json(","+        &mut test_render_app(),","+        \"/v1/completions/render\",","+        body.clone(),","+    )","+    .await;","+    results.push(format!(\"{body} without FIM -> {status} {}\", json[\"error\"]));","+    expect_test::expect![[r#\"","+        {\"model\":\"render-model\",\"prompt\":\"a\",\"suffix\":\"z\",\"echo\":true} -> 400 Bad Request {\"message\":\"Echo is unsupported with suffix.\",\"type\":\"BadRequestError\",\"param\":\"suffix\",\"code\":400}","+        {\"model\":\"render-model\",\"prompt\":\"a\",\"suffix\":\"z\",\"truncate_prompt_tokens\":4} -> 400 Bad Request {\"message\":\"suffix is not supported with truncate_prompt_tokens\",\"type\":\"BadRequestError\",\"param\":\"suffix\",\"code\":400}","+        {\"model\":\"render-model\",\"prompt\":[97],\"suffix\":\"z\"} -> 400 Bad Request {\"message\":\"suffix requires text prompt input for FIM completion rendering\",\"type\":\"BadRequestError\",\"param\":\"suffix\",\"code\":400}","+        {\"model\":\"render-model\",\"prompt\":\"a\",\"suffix\":\"z\"} without FIM -> 400 Bad Request {\"message\":\"suffix is only supported for models with FIM completion rendering\",\"type\":\"BadRequestError\",\"param\":\"suffix\",\"code\":400}\"#]].assert_eq(&results.join(\"\\n\"));","+}","+","+/// `/v1/completions` lowers a `suffix` like the render route and submits the","+/// fill-in-the-middle prompt to the engine.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+#[serial]","+async fn completions_suffix_submits_fill_in_the_middle_prompt() {","+    let (app, engine_task) = test_app_with_backend_and_engine_request_check(","+        Arc::new(FakeChatBackend::with_chat_renderer(Arc::new(","+            vllm_chat::DeepSeekV4ChatRenderer::default(),","+        ))),","+        |request| {","+            assert_eq!(","+                decode_prompt_token_ids(request),","+                Some(vec![256, 128801, 97, 128800, 122, 128802])","+            );","+        },","+    )","+    .await;","+    let (status, json) = post_json(","+        &mut app.clone(),","+        \"/v1/completions\",","+        json!({\"model\": \"Qwen/Qwen1.5-0.5B-Chat\", \"prompt\": \"a\", \"suffix\": \"z\"}),","+    )","+    .await;","+    assert_eq!(status, StatusCode::OK, \"{json}\");","+    engine_task.await.expect(\"mock engine task\");","+}","+"," /// Like Python's `TokenizeParams` check, a requested output budget above the"," /// context window is a 400, while one that fits the window is accepted."," #[tokio::test]",""],"additions":117,"deletions":7,"truncated":false}],"additions":264,"deletions":54,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-24T20:29:28.395089+00:00"}