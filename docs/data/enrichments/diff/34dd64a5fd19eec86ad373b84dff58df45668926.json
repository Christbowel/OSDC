iteComprehensionTerms() {"],"additions":17,"deletions":0,"truncated":false},{"path":"v1/ast/compile_bench_test.go","lines":["@@ -184,3 +184,38 @@ func makeQueriesForRewriteDynamicsBenchmark(sizes []int, body Body) [][]Body {"," "," \treturn queries"," }","+","+func BenchmarkCompileRuleReuse(b *testing.B) {","+\tpopts := ParserOptions{RegoVersion: RegoV1, ProcessAnnotation: true, DropLocations: true}","+\tparse := func(changed int) map[string]*Module {","+\t\tmods := map[string]*Module{}","+\t\tfor name, src := range generatedSources(20000, changed) {","+\t\t\tmods[name] = MustParseModuleWithOpts(src, popts)","+\t\t}","+\t\treturn mods","+\t}","+\tprev := NewCompiler().WithRuleReuse(nil)","+\tif prev.Compile(parse(-1)); prev.Failed() {","+\t\tb.Fatal(prev.Errors)","+\t}","+\t// One rule changed.","+\tnext := parse(10000)","+","+\tfor _, reuse := range []bool{false, true} {","+\t\tb.Run(fmt.Sprintf(\"reuse=%v\", reuse), func(b *testing.B) {","+\t\t\tb.ReportAllocs()","+\t\t\tfor b.Loop() {","+\t\t\t\tc := NewCompiler()","+\t\t\t\tif reuse {","+\t\t\t\t\tc = c.WithRuleReuse(prev)","+\t\t\t\t}","+\t\t\t\tif c.Compile(next); c.Failed() {","+\t\t\t\t\tb.Fatal(c.Errors)","+\t\t\t\t}","+\t\t\t\tif reuse && !c.RuleReuseStats().Incremental {","+\t\t\t\t\tb.Fatal(\"not incremental\")","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":35,"deletions":0,"truncated":false},{"path":"v1/ast/compile_reuse.go","lines":["@@ -0,0 +1,791 @@","+// Copyright 2026 The OPA Authors.  All rights reserved.","+// Use of this source code is governed by an Apache2","+// license that can be found in the LICENSE file.","+","+package ast","+","+import (","+\t\"context\"","+\t\"crypto/sha256\"","+\t\"encoding/binary\"","+\t\"io\"","+\t\"maps\"","+\t\"runtime\"","+\t\"slices\"","+\t\"strings\"","+\t\"sync\"","+","+\t\"github.com/open-policy-agent/opa/v1/types\"","+)","+","+// RuleKey identifies the source of a rule, see ReuseKey. The zero value is no","+// key.","+type RuleKey [16]byte","+","+// ReuseKey returns the key ReusableRule finds a compiled rule of package pkg","+// (e.g. \"data.a.b\") under, from the source texts of its annotations and then","+// the rule: the first 16 bytes of their SHA-256.","+func ReuseKey(pkg string, texts ...[]byte) RuleKey {","+\th := sha256.New()","+\tvar n [binary.MaxVarintLen64]byte","+\th.Write(n[:binary.PutUvarint(n[:], uint64(len(pkg)))])","+\t_, _ = io.WriteString(h, pkg)","+\tfor _, t := range texts {","+\t\th.Write(n[:binary.PutUvarint(n[:], uint64(len(t)))])","+\t\th.Write(t)","+\t}","+\tvar sum [sha256.Size]byte","+\treturn RuleKey(h.Sum(sum[:0]))","+}","+","+// setReuseKeys keys a parsed module and its rules by their source, so that","+// the keys don't depend on what is kept of it after parsing.","+func setReuseKeys(m *Module) {","+\tm.reuseKey = moduleSourceKey(m)","+\tpkg := m.Package.Path.String()","+\tfor _, r := range m.Rules {","+\t\tr.reuseKey, _ = ruleSourceKeyIn(pkg, r)","+\t}","+}","+","+func moduleKey(m *Module) RuleKey {","+\t// Rules appended after parsing aren't covered by the parse-time key.","+\tif m.reuseKey != (RuleKey{}) && !slices.ContainsFunc(m.Rules, isPlaceholder) {","+\t\treturn m.reuseKey","+\t}","+\treturn moduleSourceKey(m)","+}","+","+// moduleSourceKey keys a module by its source text, or if it has none (built","+// in Go or decoded from JSON), by its printed form.","+func moduleSourceKey(m *Module) RuleKey {","+\ttexts := make([][]byte, 1, 2+len(m.Imports)+len(m.Rules)+len(m.Annotations)+len(m.Comments))","+\ttexts[0] = []byte(m.regoVersion.String())","+\tadd := func(l *Location) bool {","+\t\tif l == nil || len(l.Text) == 0 {","+\t\t\treturn false","+\t\t}","+\t\ttexts = append(texts, l.Text)","+\t\treturn true","+\t}","+\tok := add(m.Package.Location)","+\tfor _, imp := range m.Imports {","+\t\tok = ok && add(imp.Location)","+\t}","+\tfor _, r := range m.Rules {","+\t\tok = ok && add(r.Location)","+\t}","+\tfor _, a := range m.Annotations {","+\t\tok = ok && add(a.Location)","+\t}","+\tif !ok {","+\t\treturn ReuseKey(\"printed\", []byte(m.regoVersion.String()), []byte(m.String()))","+\t}","+\tfor _, cm := range m.Comments {","+\t\ttexts = append(texts, cm.Text)","+\t}","+\treturn ReuseKey(\"\", texts...)","+}","+","+func reuseKey(r *Rule) (RuleKey, bool) {","+\treturn r.reuseKey, r.reuseKey != (RuleKey{})","+}","+","+func ruleSourceKeyIn(pkg string, r *Rule) (RuleKey, bool) {","+\tif r.Location == nil || len(r.Location.Text) == 0 {","+\t\treturn RuleKey{}, false","+\t}","+\tvar buf [2][]byte","+\ttexts := buf[:0]","+\tfor _, a := range r.Annotations {","+\t\tif a.Location == nil {","+\t\t\treturn RuleKey{}, false","+\t\t}","+\t\ttexts = append(texts, a.Location.Text)","+\t}","+\treturn ReuseKey(pkg, append(texts, r.Location.Text)...), true","+}","+","+// WithRuleReuse makes Compile carry over prev's compiled rules whose source is","+// unchanged, compiling only the added ones when that gives the same result as","+// compiling everything. prev must have been compiled with rule reuse too. Only","+// the rules of modules parsed with DropLocations are carried over.","+func (c *Compiler) WithRuleReuse(prev *Compiler) *Compiler {","+\tc.reuse.enabled = true","+\tc.reuse.prev = prev","+\treturn c","+}","+","+// WithReparser sets how Compile gets a fully parsed module back when it must","+// compile everything but the module holds rules returned by ReusableRule.","+func (c *Compiler) WithReparser(f func(name string) (*Module, error)) *Compiler {","+\tc.reuse.reparse = f","+\treturn c","+}","+","+// ReusableRule returns the compiled rule for key, for a parser to put in place","+// of a rule it skipped. Only a Compile with rule reuse accepts such modules.","+func (c *Compiler) ReusableRule(key RuleKey) *Rule {","+\treturn c.reuse.rules[key]","+}","+","+// RuleReuseStats describes what the last Compile with rule reuse did.","+type RuleReuseStats struct {","+\tEnabled      bool // WithRuleReuse was set","+\tIncremental  bool // only added rules were compiled","+\tReused       int  // compiled rules carried over","+\tParseSkipped int  // rules a parser left out, see ReusableRule","+}","+","+// RuleReuseStats returns what the last Compile did about rule reuse.","+func (c *Compiler) RuleReuseStats() RuleReuseStats {","+\treturn RuleReuseStats{","+\t\tEnabled:      c.reuse.enabled,","+\t\tIncremental:  c.reuse.incremental,","+\t\tReused:       c.reuse.reused,","+\t\tParseSkipped: c.reuse.parseSkipped,","+\t}","+}","+","+type ruleReuseState struct {","+\tenabled      bool","+\tprev         *Compiler","+\treparse      func(name string) (*Module, error)","+\tbase         map[string]RuleKey      // source keys of the modules that aren't reusable","+\tpkgs         map[string]reusePackage // packages of reusable modules","+\trules        map[RuleKey]*Rule       // compiled rules of reusable modules, by key","+\treused       int","+\tincremental  bool","+\tparseSkipped int","+\treserved     map[Var]Var // locals of reused rules, which a delta compiler mustn't generate","+}","+","+type reusePackage struct {","+\tpath        Ref","+\timports     []*Import","+\tregoVersion RegoVersionSpan","+}","+","+// Reusable modules of a package must agree on imports and rego-version, as","+// keys don't cover them.","+func splitReusable(modules map[string]*Module) (map[string][]RuleKey, map[string]*Module, map[string]reusePackage) {","+\tkeys := make(map[string][]RuleKey, len(modules))","+\tbase := map[string]*Module{}","+\tpkgs := map[string]reusePackage{}","+\tfor _, name := range slices.Sorted(maps.Keys(modules)) {","+\t\tmod := modules[name]","+\t\tmkeys, ok := reusableKeys(mod)","+\t\tif ok {","+\t\t\tp := mod.Package.Path.String()","+\t\t\tif pkg, seen := pkgs[p]; !seen {","+\t\t\t\tpkgs[p] = reusePackage{mod.Package.Path, mod.Imports, mod.regoVersion}","+\t\t\t} else if !slices.EqualFunc(pkg.imports, mod.Imports, (*Import).Equal) || pkg.regoVersion != mod.regoVersion {","+\t\t\t\tok = false","+\t\t\t}","+\t\t}","+\t\tif ok {","+\t\t\tkeys[name] = mkeys","+\t\t} else {","+\t\t\tbase[name] = mod","+\t\t}","+\t}","+\treturn keys, base, pkgs","+}","+","+func reusableKeys(mod *Module) ([]RuleKey, bool) {","+\t// Reused rules keep the locations they were compiled at, which would go stale.","+\tif len(mod.Rules) == 0 || mod.Package.Location != nil {","+\t\treturn nil, false","+\t}","+\tfor _, a := range mod.Annotations {","+\t\t// A document annotation applies to the rules of other modules too.","+\t\tif _, ok := a.node.(*Rule); !ok || a.Scope == annotationScopeDocument {","+\t\t\treturn nil, false","+\t\t}","+\t}","+\tkeys := make([]RuleKey, len(mod.Rules))","+\tfor i, r := range mod.Rules {","+\t\tk, ok := reuseKey(r)","+\t\t// Functions aren't reusable: added rules may call them.","+\t\tif !ok || r.Default || r.Else != nil || len(r.Head.Args) > 0 {","+\t\t\treturn nil, false","+\t\t}","+\t\tkeys[i] = k","+\t}","+\treturn keys, true","+}","+","+func (c *Compiler) compileWithReuse(modules map[string]*Module) {","+\tkeys, base, pkgs := splitReusable(modules)","+\tc.reuse.incremental = c.compileIncremental(modules, keys, base, pkgs)","+\tc.reuse.parseSkipped = 0","+\tif c.reuse.incremental {","+\t\tfor _, m := range modules {","+\t\t\tfor _, r := range m.Rules {","+\t\t\t\tif isPlaceholder(r) {","+\t\t\t\t\tc.reuse.parseSkipped++","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t} else {","+\t\tc.reuse.reused = 0","+\t\treparsed, ok := c.reparsePlaceholders(modules)","+\t\tif !ok {","+\t\t\treturn","+\t\t}","+\t\tif reparsed != nil {","+\t\t\tmodules = reparsed","+\t\t\tkeys, base, pkgs = splitReusable(modules)","+\t\t}","+\t\tif c.compileModules(modules); c.Failed() {","+\t\t\treturn","+\t\t}","+\t}","+","+\tif c.reuse.incremental { // reuseApplies found the base modules' keys equal to prev's","+\t\tc.reuse.base = c.reuse.prev.reuse.base","+\t} else {","+\t\tc.reuse.base = make(map[string]RuleKey, len(base))","+\t\tfor name, m := range base {","+\t\t\tc.reuse.base[name] = moduleKey(m)","+\t\t}","+\t}","+\tc.reuse.pkgs = pkgs","+\tn := 0","+\tfor _, mkeys := range keys {","+\t\tn += len(mkeys)","+\t}","+\tc.reuse.rules = make(map[RuleKey]*Rule, n)","+\tfor name := range keys {","+\t\tm := c.Modules[name]","+\t\tif !m.reusable { // unchanged modules are prev's, which may be serving queries","+\t\t\tm.reusable = true","+\t\t}","+\t\tfor _, r := range m.Rules {","+\t\t\tif k, ok := reuseKey(r); ok {","+\t\t\t\tc.reuse.rules[k] = r","+\t\t\t}","+\t\t}","+\t}","+}","+","+type reuseDelta struct {","+\tprev    *Compiler","+\tmodules map[string]*Module","+\tkeys    map[string][]RuleKey // of reusable modules, aligned with their rules","+\tbase    map[string]*Module","+\tpkgs    map[string]reusePackage","+","+\tseen      map[RuleKey]struct{} // keys of all reusable rules","+\tadded     map[string]*Module   // per reusable module, the rules prev lacks","+\treused    int","+\tunchanged map[string]bool // reusable modules with the same rules as in prev","+\tdc        *Compiler       // compiled the added rules","+\text       []externalIndex","+}","+","+func (c *Compiler) compileIncremental(modules map[string]*Module, keys map[string][]RuleKey, base map[string]*Module, pkgs map[string]reusePackage) bool {","+\td := &reuseDelta{prev: c.reuse.prev, modules: modules, keys: keys, base: base, pkgs: pkgs}","+\treturn c.reuseApplies(d) && d.splitRules() && d.checkRemovals() && c.compileAdded(d) && c.assemble(d)","+}","+","+func (c *Compiler) reuseApplies(d *reuseDelta) bool {","+\tprev := d.prev","+\tif prev == nil || prev.reuse.rules == nil || len(c.after) > 0 ||","+\t\tc.moduleLoader != nil || c.keepModules || !c.sameOptions(prev) {","+\t\treturn false","+\t}","+\t// Strict mode's unused-import check spans all rules of a module.","+\tif c.strict {","+\t\treturn false","+\t}","+\t// Which refs are external decides how rules referring to them compile.","+\tif c.externalSources.Len() != prev.externalSources.Len() ||","+\t\tslices.ContainsFunc(c.externalSources.Keys(), func(r Ref) bool { _, ok := prev.externalSources.Get(r); return !ok }) {","+\t\treturn false","+\t}","+\tif len(d.base) != len(prev.reuse.base) || len(d.pkgs) != len(prev.reuse.pkgs) {","+\t\treturn false","+\t}","+\tfor name, m := range d.base {","+\t\tif k, ok := prev.reuse.base[name]; !ok || k != moduleKey(m) {","+\t\t\treturn false","+\t\t}","+\t}","+\tfor p, pkg := range d.pkgs {","+\t\tpp, ok := prev.reuse.pkgs[p]","+\t\tif !ok || !slices.EqualFunc(pkg.imports, pp.imports, (*Import).Equal) || pkg.regoVersion != pp.regoVersion {","+\t\t\treturn false","+\t\t}","+\t}","+\treturn true","+}","+","+// sameOptions reports whether c compiles like prev.","+func (c *Compiler) sameOptions(prev *Compiler) bool {","+\tswitch {","+\tcase c.enablePrintStatements != prev.enablePrintStatements:","+\tcase c.strict != prev.strict:","+\tcase c.useTypeCheckAnnotations != prev.useTypeCheckAnnotations:","+\tcase c.allowUndefinedFuncCalls != prev.allowUndefinedFuncCalls:","+\tcase c.evalMode != prev.evalMode:","+\tcase c.rewriteTestRulesForTracing != prev.rewriteTestRulesForTracing:","+\tcase c.defaultRegoVersion != prev.defaultRegoVersion:","+\tcase c.schemaSet != prev.schemaSet:","+\tcase c.injectedVirtual != nil || prev.injectedVirtual != nil:","+\tcase !maps.Equal(c.unsafeBuiltinsMap, prev.unsafeBuiltinsMap):","+\tcase !maps.Equal(c.skipStages, prev.skipStages):","+\tcase !slices.Equal(c.capabilities.Features, prev.capabilities.Features):","+\tcase !slices.Equal(c.capabilities.FutureKeywords, prev.capabilities.FutureKeywords):","+\tcase !slices.Equal(c.capabilities.AllowNet, prev.capabilities.AllowNet):","+\tdefault:","+\t\treturn maps.EqualFunc(c.builtins, prev.builtins, func(a, b *Builtin) bool {","+\t\t\treturn a == b || a.Name == b.Name && types.Compare(a.Decl, b.Decl) == 0","+\t\t})","+\t}","+\treturn false","+}","+","+func (d *reuseDelta) splitRules() bool {","+\td.added = map[string]*Module{}","+\td.seen = make(map[RuleKey]struct{}, len(d.prev.reuse.rules))","+\tfor name, mkeys := range d.keys {","+\t\tmod := d.modules[name]","+\t\tvar a *Module","+\t\tfor i, r := range mod.Rules {","+\t\t\tk := mkeys[i]","+\t\t\tif _, dup := d.seen[k]; dup {","+\t\t\t\treturn false","+\t\t\t}","+\t\t\td.seen[k] = struct{}{}","+\t\t\tif _, ok := d.prev.reuse.rules[k]; ok {","+\t\t\t\td.reused++","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif isPlaceholder(r) {","+\t\t\t\treturn false","+\t\t\t}","+\t\t\tif a == nil {","+\t\t\t\ta = &Module{Package: mod.Package, Imports: mod.Imports, regoVersion: mod.regoVersion}","+\t\t\t\td.added[name] = a","+\t\t\t}","+\t\t\ta.Rules = append(a.Rules, r)","+\t\t}","+\t\tif a != nil {","+\t\t\tin := make(map[*Rule]struct{}, len(a.Rules))","+\t\t\tfor _, r := range a.Rules {","+\t\t\t\tin[r] = struct{}{}","+\t\t\t}","+\t\t\tfor _, ann := range mod.Annotations {","+\t\t\t\tif _, ok := in[ann.node.(*Rule)]; ok {","+\t\t\t\t\ta.Annotations = append(a.Annotations, ann)","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+\treturn true","+}","+","+// An emptied rule set changes the rules depending on it.","+func (d *reuseDelta) checkRemovals() bool {","+\tvar removed map[string][]*Rule","+\tif d.reused < len(d.prev.reuse.rules) { // else every rule of prev is still there","+\t\tremoved = map[string][]*Rule{}","+\t\tfor k, r := range d.prev.reuse.rules {","+\t\t\tif _, ok := d.seen[k]; !ok {","+\t\t\t\tref := r.Ref().String()","+\t\t\t\tremoved[ref] = append(removed[ref], r)","+\t\t\t}","+\t\t}","+\t}","+\tfor _, rs := range removed {","+\t\tref := rs[0].Ref()","+\t\tif len(rs) >= len(d.prev.GetRulesExact(ref)) || hasUnion(d.prev.TypeEnv.Get(ref)) {","+\t\t\treturn false","+\t\t}","+\t}","+","+\td.unchanged = map[string]bool{}","+\tfor name, mkeys := range d.keys {","+\t\tif pm, ok := d.prev.Modules[name]; ok && pm.reusable && d.added[name] == nil &&","+\t\t\tslices.EqualFunc(mkeys, pm.Rules, func(k RuleKey, r *Rule) bool { return d.prev.reuse.rules[k] == r }) {","+\t\t\td.unchanged[name] = true","+\t\t}","+\t}","+\treturn true","+}","+","+func (c *Compiler) compileAdded(d *reuseDelta) bool {","+\text, ok := c.initExternalSources()","+\tif !ok {","+\t\treturn false","+\t}","+\td.ext = ext","+\td.dc = c.newDeltaCompiler()","+\td.dc.reuse.reserved = d.prev.RewrittenVars","+\tfor _, e := range ext {","+\t\td.dc.externalSources.Put(e.ref, e)","+\t}","+\tin := make(map[string]*Module, len(d.base)+len(d.added))","+\tmaps.Copy(in, d.base)","+\tmaps.Copy(in, d.added)","+\tif d.dc.Compile(in); d.dc.Failed() {","+\t\treturn false","+\t}","+\tvar roots []*Rule","+\tfor name := range d.added {","+\t\tfor _, r := range d.dc.Modules[name].Rules {","+\t\t\tif !c.isCompatibleAddedRule(r, d.dc) {","+\t\t\t\treturn false","+\t\t\t}","+\t\t\troots = append(roots, r)","+\t\t}","+\t}","+\treturn !c.reachesReusable(roots, d.dc)","+}","+","+// dc saw rules of other modules refer to reusable rules as unknown data, so an","+// added rule must not depend on them, e.g. through a function.","+func (c *Compiler) reachesReusable(roots []*Rule, dc *Compiler) bool {","+\tseen := map[*Rule]struct{}{}","+\tfor len(roots) > 0 {","+\t\tr := roots[len(roots)-1]","+\t\troots = roots[:len(roots)-1]","+\t\tif _, ok := seen[r]; ok {","+\t\t\tcontinue","+\t\t}","+\t\tseen[r] = struct{}{}","+\t\tif c.refsReusable(r) {","+\t\t\treturn true","+\t\t}","+\t\tfor dep := range dc.Graph.Dependencies(r) {","+\t\t\tif dr, ok := dep.(*Rule); ok {","+\t\t\t\troots = append(roots, dr)","+\t\t\t}","+\t\t}","+\t}","+\treturn false","+}","+","+func (c *Compiler) refsReusable(x any) bool {","+\tfound := false","+\tWalkRefs(x, func(ref Ref) bool {","+\t\tfor _, pkg := range c.reuse.prev.reuse.pkgs {","+\t\t\tif ref.HasPrefix(pkg.path) || pkg.path.HasPrefix(ref) {","+\t\t\t\tfound = true","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t\treturn found","+\t})","+\treturn found","+}","+","+// prev keeps serving queries, so its rules are copied rather than re-pointed.","+func (c *Compiler) assemble(d *reuseDelta) bool {","+\tprev, dc := d.prev, d.dc","+\tc.Modules = make(map[string]*Module,