n false","+\t\t})","+\t}","+","+\tc.setModuleTree()","+\tc.RuleTree = NewRuleTree(c.ModuleTree)","+\tfor _, e := range d.ext {","+\t\tc.RuleTree.add(e.ref, e.index)","+\t}","+\tc.setGraph()","+","+\tvis := NewVarVisitor()","+\tfor name := range d.added {","+\t\tvis.Walk(c.Modules[name])","+\t}","+\texclude := prev.localvargen.exclude.Copy()","+\texclude.Update(vis.vars)","+\tc.localvargen = &localVarGenerator{exclude: exclude, suffix: LocalVarPrefix}","+","+\tc.TypeEnv = c.rebindTypeEnv(prev.TypeEnv)","+\tc.setAnnotationSet()","+\treuseRuleIndices(prev.RuleTree, c.RuleTree)","+\tc.buildRuleIndices()","+\tc.reuse.reused = d.reused","+\t// A conflict is reported by the full compile that follows.","+\treturn !c.Failed() && (c.pathExists == nil || len(CheckPathConflicts(c, c.pathExists)) == 0)","+}","+","+type externalIndex struct {","+\tref   Ref","+\tindex ExternalRuleIndex","+}","+","+func (e externalIndex) Refs() []Ref { return []Ref{e.ref} }","+","+func (e externalIndex) Init(context.Context, Ref) (ExternalRuleIndex, error) {","+\treturn e.index, nil","+}","+","+// The sources are replaced with their indices so that a full compile after","+// this doesn't initialize them again.","+func (c *Compiler) initExternalSources() ([]externalIndex, bool) {","+\tvar out []externalIndex","+\tok := true","+\tc.externalSources.Iter(func(ref Ref, source ExternalRuleSource) bool {","+\t\tindex, err := source.Init(context.TODO(), ref)","+\t\tif err != nil {","+\t\t\tok = false","+\t\t\treturn true","+\t\t}","+\t\tout = append(out, externalIndex{ref, index})","+\t\treturn false","+\t})","+\tif ok {","+\t\tfor _, e := range out {","+\t\t\tc.externalSources.Put(e.ref, e)","+\t\t}","+\t}","+\treturn out, ok","+}"],"additions":791,"deletions":0,"truncated":true},{"path":"v1/ast/compile_reuse_fuzz_test.go","lines":["@@ -0,0 +1,269 @@","+// Copyright 2026 The OPA Authors.  All rights reserved.","+// Use of this source code is governed by an Apache2","+// license that can be found in the L