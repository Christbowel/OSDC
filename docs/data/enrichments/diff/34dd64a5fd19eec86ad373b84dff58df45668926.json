 13}[rng.Intn(11)]","+\t}","+\tswitch kind {","+\tcase 0:","+\t\tbody = fmt.Sprintf(\"allow if input.x == %d\", id%7)","+\tcase 1:","+\t\tbody = fmt.Sprintf(\"allow if data.%s.v > %d\", other, id%5)","+\tcase 2:","+\t\tbody = fmt.Sprintf(\"v := %d\", id%3)","+\tcase 3:","+\t\tbody = fmt.Sprintf(\"v := \\\"s%d\\\"\", id%2)","+\tcase 4:","+\t\tbody = fmt.Sprintf(\"s contains %d if input.y\", id%4)","+\tcase 5:","+\t\tbody = fmt.Sprintf(\"s contains x if { some x in input.zs; x > %d }\", id%3)","+\tcase 6:","+\t\tbody = fmt.Sprintf(\"f(x) := x + %d\", id%2)","+\tcase 7:","+\t\tbody = fmt.Sprintf(\"allow if data.%s.f(1) > %d\", other, id%3)","+\tcase 8:","+\t\tbody = \"default allow := false\"","+\tcase 9:","+\t\tbody = fmt.Sprintf(\"w := 1 if input.q == %d\\nelse := 2\", id%3)","+\tcase 10:","+\t\tbody = fmt.Sprintf(\"m := rego.metadata.chain() if input.m == %d\", id%2)","+\tcase 11:","+\t\tbody = fmt.Sprintf(\"allow if count(data.%s.s) > %d\", other, id%3)","+\tcase 12:","+\t\tbody = fmt.Sprintf(\"allow if { x := data.%s.v; x == %d }\", other, id%3)","+\tcase 13:","+\t\tbody = fmt.Sprintf(\"o.k%d := %d\", id%3, id%4)","+\t}","+\treturn fuzzRule{pkg: pkg, text: meta + body}","+}","+","+func fuzzModules(rules []fuzzRule, files int, rng *rand.Rand) map[string]string {","+\tout := map[string]string{}","+\tfor _, r := range rules {","+\t\tname := fmt.Sprintf(\"%s/f%d.rego\", r.pkg, rng.Intn(files))","+\t\tif out[name] == \"\" {","+\t\t\tout[name] = \"package \" + r.pkg + \"\\n\\n\"","+\t\t\tif rng.Intn(10) == 0 {","+\t\t\t\tout[name] += \"import data.b as bb\\n\\n\"","+\t\t\t}","+\t\t}","+\t\tout[name] += r.text + \"\\n\\n\"","+\t}","+\treturn out","+}","+","+func fuzzParse(files map[string]string) (map[string]*Module, bool) {","+\tmods := map[string]*Module{}","+\tfor name, src := range files {","+\t\tm, err := ParseModuleWithOpts(name, src, ParserOptions{RegoVersion: RegoV1, ProcessAnnotation: true, DropLocations: true})","+\t\tif err != nil {","+\t\t\treturn nil, false"