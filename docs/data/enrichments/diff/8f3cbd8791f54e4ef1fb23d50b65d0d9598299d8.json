{"id":"8f3cbd8791f54e4ef1fb23d50b65d0d9598299d8","axis":"silent","repo":"vllm-project/vllm","sha":"8f3cbd8791f54e4ef1fb23d50b65d0d9598299d8","parsed":{"files":[{"path":"docs/getting_started/installation/gpu.cuda.inc.md","lines":["@@ -136,6 +136,8 @@ If you need to recompile the `vllm-rs` Rust frontend binary, you can rebuild and"," ","     This will install the required Rust toolchain if needed, build the binary, and place it in `vllm/vllm-rs`."," ","+    With `VLLM_USE_RUST_FRONTEND=1`, `vllm serve` warns at startup when `rust/` in your checkout differs from the commit the packaged `vllm/vllm-rs` was built from, for example after changing `rust/` on a branch installed with `VLLM_USE_PRECOMPILED=1`. Rebuild the binary as above.","+"," Wheels are published an hour or two after a commit lands on `main`. If the wheel for"," your merge-base with upstream `main` is not available yet, the installer uses the"," nearest older commit that has one, searching up to 20 commits back. It stops with an"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/entrypoints/common/test_stale_rust_frontend.py","lines":["@@ -0,0 +1,208 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Tests for detecting a `vllm-rs` binary built without the checkout's `rust/`.\"\"\"","+","+import shutil","+import subprocess","+from pathlib import Path","+","+import pytest","+","+import vllm","+from vllm.entrypoints.common import stale_rust_frontend","+from vllm.entrypoints.common.stale_rust_frontend import (","+    find_unbuilt_rust_changes,","+    warn_if_rust_frontend_stale,","+)","+","+pytestmark = pytest.mark.skipif(shutil.which(\"git\") is None, reason=\"needs git\")","+","+","+def _git(repo: Path, *args: str) -> str:","+    return subprocess.run(","+        [\"git\", \"-C\", str(repo), *args],","+        capture_output=True,","+        text=True,","+        check=True,","+    ).stdout.strip()","+","+","+def _commit(repo: Path, path: str, content: str) -> str:","+    file = repo / path","+    file.parent.mkdir(parents=True, exist_ok=True)","+    file.write_text(content)","+    _git(repo, \"add\", path)","+    _git(repo, \"commit\", \"-q\", \"-m\", path)","+    return _git(repo, \"rev-parse\", \"HEAD\")","+","+","+@pytest.fixture","+def checkout(tmp_path: Path) -> Path:","+    repo = tmp_path / \"vllm-checkout\"","+    repo.mkdir()","+    _git(repo, \"init\", \"-q\")","+    _git(repo, \"config\", \"user.email\", \"test@example.com\")","+    _git(repo, \"config\", \"user.name\", \"test\")","+    _commit(repo, \"vllm/__init__.py\", \"\")","+    _commit(repo, \"rust/src/lib.rs\", \"// v1\\n\")","+    return repo","+","+","+def _binary(package_dir: Path, version: str) -> str:","+    path = package_dir / \"vllm-rs\"","+    path.write_text(f\"#!/bin/sh\\necho 'vllm-rs {version}'\\n\")","+    path.chmod(0o755)","+    return str(path)","+","+","+def _binary_printing(package_dir: Path, output: bytes) -> str:","+    path = package_dir / \"vllm-rs\"","+    path.write_bytes(b\"#!/bin/sh\\nprintf '\" + output + b\"'\\n\")","+    path.chmod(0o755)","+    return str(path)","+","+","+def _version(commit: str, dirty: bool = False) -> str:","+    return f\"0.1.0.dev3+g{commit[:9]}\" + (\".d20261123\" if dirty else \"\")","+","+","+def test_reports_rust_changes_committed_after_the_binary(checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+    _commit(checkout, \"vllm/model.py\", \"\")","+","+    unbuilt = find_unbuilt_rust_changes(","+        _binary(checkout / \"vllm\", _version(built)), str(checkout / \"vllm\")","+    )","+","+    assert unbuilt is not None","+    assert unbuilt.binary_commit == built","+    assert unbuilt.changed_paths == [\"rust/src/lib.rs\"]","+","+","+def test_reports_uncommitted_rust_changes(checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    (checkout / \"rust/src/lib.rs\").write_text(\"// edited\\n\")","+","+    unbuilt = find_unbuilt_rust_changes(","+        _binary(checkout / \"vllm\", _version(built)), str(checkout / \"vllm\")","+    )","+","+    assert unbuilt is not None","+    assert unbuilt.changed_paths == [\"rust/src/lib.rs\"]","+","+","+def test_reports_untracked_rust_files(checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    # Cargo discovers a new build script without any tracked file changing.","+    (checkout / \"rust/build.rs\").write_text(\"fn main() {}\\n\")","+","+    unbuilt = find_unbuilt_rust_changes(","+        _binary(checkout / \"vllm\", _version(built)), str(checkout / \"vllm\")","+    )","+","+    assert unbuilt is not None","+    assert unbuilt.changed_paths == [\"rust/build.rs\"]","+","+","+def test_reports_a_symlinked_packaged_binary(tmp_path, checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+    # E.g. linked from another worktree's build.","+    (checkout / \"vllm/vllm-rs\").symlink_to(_binary(tmp_path, _version(built)))","+","+    unbuilt = find_unbuilt_rust_changes(","+        str(checkout / \"vllm/vllm-rs\"), str(checkout / \"vllm\")","+    )","+","+    assert unbuilt is not None","+    assert unbuilt.changed_paths == [\"rust/src/lib.rs\"]","+","+","+def test_ignores_changes_outside_rust(checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"vllm/model.py\", \"\")","+","+    assert (","+        find_unbuilt_rust_changes(","+            _binary(checkout / \"vllm\", _version(built)), str(checkout / \"vllm\")","+        )","+        is None","+    )","+","+","+@pytest.mark.parametrize(","+    \"version\",","+    [","+        pytest.param(None, id=\"dirty-build\"),","+        pytest.param(\"0.1.0\", id=\"release-tag\"),","+        pytest.param(\"0.1.0+gdeadbeef12\", id=\"unknown-commit\"),","+    ],","+)","+def test_no_evidence_without_a_known_clean_build_commit(checkout, version):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+    if version is None:","+        version = _version(built, dirty=True)","+","+    assert (","+        find_unbuilt_rust_changes(","+            _binary(checkout / \"vllm\", version), str(checkout / \"vllm\")","+        )","+        is None","+    )","+","+","+def test_no_evidence_from_undecodable_version_output(checkout):","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+","+    assert (","+        find_unbuilt_rust_changes(","+            _binary_printing(checkout / \"vllm\", rb\"vllm-rs \\377\"),","+            str(checkout / \"vllm\"),","+        )","+        is None","+    )","+","+","+def test_no_evidence_for_a_package_outside_the_checkout_sources(checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+    # A non-editable install into a venv that lives inside the checkout.","+    site_vllm = checkout / \".venv/lib/site-packages/vllm\"","+    site_vllm.mkdir(parents=True)","+","+    assert (","+        find_unbuilt_rust_changes(_binary(site_vllm, _version(built)), str(site_vllm))","+        is None","+    )","+","+","+def test_no_evidence_for_a_binary_outside_the_package(tmp_path, checkout):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+","+    assert (","+        find_unbuilt_rust_changes(","+            _binary(tmp_path, _version(built)), str(checkout / \"vllm\")","+        )","+        is None","+    )","+","+","+def test_warns_about_a_stale_binary(checkout, monkeypatch):","+    built = _git(checkout, \"rev-parse\", \"HEAD\")","+    _commit(checkout, \"rust/src/lib.rs\", \"// v2\\n\")","+    monkeypatch.setattr(vllm, \"__file__\", str(checkout / \"vllm/__init__.py\"))","+    warnings: list[str] = []","+    monkeypatch.setattr(","+        stale_rust_frontend.logger,","+        \"warning\",","+        lambda msg, *args: warnings.append(msg % args),","+    )","+","+    warn_if_rust_frontend_stale(_binary(checkout / \"vllm\", _version(built)))","+","+    assert len(warnings) == 1","+    assert \"differs from that commit in 1 file (rust/src/lib.rs)\" in warnings[0]","+    assert \"`./tools/build_rust.sh`\" in warnings[0]"],"additions":208,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/cli/serve.py","lines":["@@ -15,6 +15,7 @@","     propagate_flash_late_interaction,","     validate_parsed_serve_args,"," )","+from vllm.entrypoints.common.stale_rust_frontend import warn_if_rust_frontend_stale"," from vllm.entrypoints.common.startup import VLLM_SUBCMD_PARSER_EPILOG"," from vllm.entrypoints.launchers.api_server.entry import run_server, setup_server"," from vllm.entrypoints.launchers.dp_supervisor import run_dp_supervisor","@@ -289,6 +290,8 @@ def run_multi_api_server(args: argparse.Namespace):","         raise ValueError(","             \"VLLM_RUST_FRONTEND_PATH does not support api_server_count > 1\"","         )","+    if rust_frontend_path:","+        warn_if_rust_frontend_stale(rust_frontend_path)"," ","     if num_api_servers > 1:","         setup_multiprocess_prometheus()"],"additions":3,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/common/stale_rust_frontend.py","lines":["@@ -0,0 +1,132 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Detect a packaged `vllm-rs` binary that lacks the checkout's `rust/` sources.","+","+Precompiled installs (`VLLM_USE_PRECOMPILED=1` or","+`VLLM_USE_PRECOMPILED_RUST=1`) take `vllm-rs` from the wheel of an upstream","+main commit, so `rust/` changes on a local branch are never built, and an","+editable install keeps the old binary across `git pull`. The check warns only","+on clear evidence and stays silent whenever the evidence is missing.","+\"\"\"","+","+import os","+import subprocess","+from dataclasses import dataclass","+","+import regex as re","+","+import vllm","+from vllm.logger import init_logger","+","+logger = init_logger(__name__)","+","+# The setuptools-scm local version: `+g<commit>` for a clean tree, followed by","+# `.dYYYYMMDD` when built from a dirty one.","+_VERSION_COMMIT_RE = re.compile(r\"\\+g([0-9a-f]{7,40})(\\.d\\d{8})?$\")","+_SUBPROCESS_TIMEOUT_S = 10","+_MAX_LISTED_PATHS = 5","+","+","+@dataclass","+class UnbuiltRustChanges:","+    checkout: str","+    binary_commit: str","+    changed_paths: list[str]","+","+","+def _run(args: list[str], env: dict[str, str] | None = None) -> str | None:","+    try:","+        result = subprocess.run(","+            args,","+            capture_output=True,","+            text=True,","+            timeout=_SUBPROCESS_TIMEOUT_S,","+            check=True,","+            env=env,","+            errors=\"replace\",","+        )","+    except (OSError, subprocess.SubprocessError):","+        return None","+    return result.stdout.strip()","+","+","+def find_unbuilt_rust_changes(","+    binary_path: str, package_dir: str","+) -> UnbuiltRustChanges | None:","+    \"\"\"Return the `rust/` changes the packaged `binary_path` was not built with.","+","+    Returns None unless `package_dir` is the `vllm/` directory of a git","+    checkout, `binary_path` is the `vllm-rs` packaged next to it (possibly a","+    symlink), and the binary reports a clean commit that the checkout has.","+    \"\"\"","+    package_dir = os.path.realpath(package_dir)","+    # A binary chosen through VLLM_RUST_FRONTEND_PATH has its own provenance.","+    if (","+        os.path.basename(binary_path) != \"vllm-rs\"","+        or os.path.realpath(os.path.dirname(binary_path)) != package_dir","+    ):","+        return None","+","+    # Stay local: no lazy fetches in partial clones, no index refresh writes.","+    git_env = {**os.environ, \"GIT_NO_LAZY_FETCH\": \"1\", \"GIT_OPTIONAL_LOCKS\": \"0\"}","+    checkout = _run([\"git\", \"-C\", package_dir, \"rev-parse\", \"--show-toplevel\"], git_env)","+    if checkout is None:","+        return None","+    # A non-editable install inside a checkout (e.g. a venv in the repo) does","+    # not run the checkout's sources.","+    if os.path.realpath(os.path.join(checkout, \"vllm\")) != package_dir:","+        return None","+","+    version = _run([binary_path, \"--version\"])","+    match = _VERSION_COMMIT_RE.search(version.split()[-1]) if version else None","+    if match is None or match.group(2) is not None:","+        return None","+    reported = match.group(1)","+","+    git = [\"git\", \"-C\", checkout]","+    binary_commit = _run(","+        [*git, \"rev-parse\", \"--verify\", \"--quiet\", f\"{reported}^{{commit}}\"], git_env","+    )","+    # `rev-parse` prefers a ref with the same name over an abbreviated hash.","+    if binary_commit is None or not binary_commit.startswith(reported):","+        return None","+    changed = _run([*git, \"diff\", \"--name-only\", binary_commit, \"--\", \"rust/\"], git_env)","+    if changed is None:","+        return None","+    # Cargo also builds untracked files it discovers, such as a new `build.rs`.","+    untracked = _run(","+        [*git, \"ls-files\", \"--others\", \"--exclude-standard\", \"--\", \"rust/\"], git_env","+    )","+    paths = changed.splitlines() + (untracked or \"\").splitlines()","+    if not paths:","+        return None","+    return UnbuiltRustChanges(checkout, binary_commit, paths)","+","+","+def warn_if_rust_frontend_stale(binary_path: str) -> None:","+    \"\"\"Warn when the packaged `vllm-rs` was built without this checkout's","+    `rust/` changes.\"\"\"","+    package_dir = os.path.dirname(os.path.abspath(vllm.__file__))","+    unbuilt = find_unbuilt_rust_changes(binary_path, package_dir)","+    if unbuilt is None:","+        return","+","+    paths = unbuilt.changed_paths","+    listed = \", \".join(paths[:_MAX_LISTED_PATHS])","+    if len(paths) > _MAX_LISTED_PATHS:","+        listed += \", ...\"","+    files = \"1 file\" if len(paths) == 1 else f\"{len(paths)} files\"","+    logger.warning(","+        \"The Rust frontend binary %s was built from commit %s, but rust/ in %s \"","+        \"differs from that commit in %s (%s). The binary was not rebuilt after \"","+        \"local edits or a checkout update, or it came from an install with \"","+        \"VLLM_USE_PRECOMPILED=1 or VLLM_USE_PRECOMPILED_RUST=1 on a branch that \"","+        \"changes rust/. It may not match this checkout's Python code, so the \"","+        \"server can fail at startup or on requests, or return wrong results. \"","+        \"Rebuild it with `./tools/build_rust.sh`.\",","+        binary_path,","+        unbuilt.binary_commit[:10],","+        unbuilt.checkout,","+        files,","+        listed,","+    )",""],"additions":132,"deletions":0,"truncated":false}],"additions":345,"deletions":0,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-26T18:55:54.558637+00:00"}