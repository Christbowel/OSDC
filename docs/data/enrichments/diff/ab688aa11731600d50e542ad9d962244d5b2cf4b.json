{"id":"ab688aa11731600d50e542ad9d962244d5b2cf4b","axis":"silent","repo":"pixelfed/pixelfed","sha":"ab688aa11731600d50e542ad9d962244d5b2cf4b","parsed":{"files":[{"path":"app/Http/Controllers/Settings/SecuritySettings.php","lines":["@@ -4,6 +4,7 @@"," "," use App\\Models\\AccountLog;"," use App\\Models\\UserDevice;","+use App\\Services\\PendingLoginService;"," use BaconQrCode\\Renderer\\Image\\SvgImageBackEnd;"," use BaconQrCode\\Renderer\\ImageRenderer;"," use BaconQrCode\\Renderer\\RendererStyle\\RendererStyle;","@@ -145,18 +146,37 @@ public function securityTwoFactorUpdate(Request $request)"," ","         $this->validate($request, [","             'action' => 'required|string|max:12',","+            'code' => 'required|string|min:6|max:24',","         ]);"," ","         if ($request->action !== 'remove') {","             abort(403);","         }"," ","+        // Removing 2FA is a security-critical change: require proof of the","+        // second factor (a current TOTP code or an unused backup code), not","+        // just an authenticated session. Mirrors the login verification path.","+        if (! PendingLoginService::verifyCode($user, $request->input('code'))) {","+            return response()->json(['msg' => 'Invalid 2FA code'], 403);","+        }","+","         $user->{'2fa_enabled'} = false;","         $user->{'2fa_secret'} = null;","         $user->{'2fa_backup_codes'} = null;","         $user->{'2fa_setup_at'} = null;","         $user->save();"," ","+        $log = new AccountLog;","+        $log->user_id = $user->id;","+        $log->item_id = $user->id;","+        $log->item_type = 'App\\Models\\User';","+        $log->action = 'account.security.2fa.remove';","+        $log->message = 'Two-factor authentication removed';","+        $log->link = null;","+        $log->ip_address = $request->ip();","+        $log->user_agent = $request->userAgent();","+        $log->save();","+","         return response()->json([","             'msg' => 'Successfully removed 2fa device',","         ], 200);"],"additions":20,"deletions":0,"truncated":false},{"path":"resources/views/settings/security/2fa/edit.blade.php","lines":["@@ -57,28 +57,33 @@ className: 'btn-danger'"," \t\t.then((value) => {"," \t\t\tif(value == true) {"," \t\t\t\tswal({","-\t\t\t\t\ttitle: 'Are you really sure?',","-\t\t\t\t\ttext: 'Are you really sure you want to remove this two-factor authentication device from your account?',","+\t\t\t\t\ttitle: 'Confirm your 2FA code',","+\t\t\t\t\ttext: 'Enter a current 2FA code or a backup code to confirm removal:',","+\t\t\t\t\tcontent: 'input',"," \t\t\t\t\ticon: 'warning',","-\t\t\t\t\tbutton: {","-\t\t\t\t\t\ttext: 'Confirm Removal',","-\t\t\t\t\t\tclassName: 'btn-danger'","+\t\t\t\t\tbuttons: {","+\t\t\t\t\t\tcancel: true,","+\t\t\t\t\t\tconfirm: {","+\t\t\t\t\t\t\ttext: 'Confirm Removal',","+\t\t\t\t\t\t\tclassName: 'btn-danger'","+\t\t\t\t\t\t}"," \t\t\t\t\t}"," \t\t\t\t})","-\t\t\t\t.then((value) => {","-\t\t\t\t\tif(value == true) {","+\t\t\t\t.then((code) => {","+\t\t\t\t\tif(code) {"," \t\t\t\t\t\taxios.post('/settings/security/2fa/edit', {","-\t\t\t\t\t\t\taction: 'remove'","+\t\t\t\t\t\t\taction: 'remove',","+\t\t\t\t\t\t\tcode: code"," \t\t\t\t\t\t})"," \t\t\t\t\t\t.then(function(res) {"," \t\t\t\t\t\t\twindow.location.href = '/settings/security';"," \t\t\t\t\t\t})","-\t\t\t\t\t\t.catch(function(res) {","-\t\t\t\t\t\t\tswal(","-\t\t\t\t\t\t\t\t'Oops!',","-\t\t\t\t\t\t\t\t'Something went wrong. Please try again.',","-\t\t\t\t\t\t\t\t'error'","-\t\t\t\t\t\t\t);","+\t\t\t\t\t\t.catch(function(err) {","+\t\t\t\t\t\t\tlet msg = 'Something went wrong. Please try again.';","+\t\t\t\t\t\t\tif(err.response && err.response.status === 403) {","+\t\t\t\t\t\t\t\tmsg = 'Invalid 2FA code. Please try again.';","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\tswal('Oops!', msg, 'error');"," \t\t\t\t\t\t})"," \t\t\t\t\t}"," \t\t\t\t});"],"additions":19,"deletions":14,"truncated":false},{"path":"tests/Feature/Settings/TwoFactorRemovalRequiresCodeTest.php","lines":["@@ -0,0 +1,119 @@","+<?php","+","+use App\\Models\\AccountLog;","+use App\\Models\\User;","+use Illuminate\\Foundation\\Testing\\LazilyRefreshDatabase;","+use Illuminate\\Routing\\Middleware\\ThrottleRequests;","+use PragmaRX\\Google2FA\\Google2FA;","+","+uses(LazilyRefreshDatabase::class);","+","+/*","+|--------------------------------------------------------------------------","+| Removing 2FA must require proof of the second factor","+|--------------------------------------------------------------------------","+|","+| securityTwoFactorUpdate previously disabled 2FA on password/sudo alone, so","+| anyone with an authenticated session could permanently remove 2FA without","+| the device. Removal now requires a current TOTP code or an unused backup","+| code, and writes an audit log entry.","+|","+*/","+","+beforeEach(function () {","+    $this->withoutMiddleware(ThrottleRequests::class);","+    config(['instance.enable_cc' => false]);","+});","+","+function twoFactorUser(array $backupCodes = ['BACKUPCODEONE12345678901']): User","+{","+    $google2fa = new Google2FA;","+    $secret = $google2fa->generateSecretKey();","+","+    $user = User::factory()->create([","+        '2fa_enabled' => true,","+        '2fa_secret' => $secret,","+        '2fa_backup_codes' => json_encode($backupCodes),","+        '2fa_setup_at' => now(),","+    ]);","+    $user->refresh();","+","+    return $user;","+}","+","+function sudoSession(): array","+{","+    return ['auth.password_confirmed_at' => time()];","+}","+","+it('rejects removal when no code is supplied', function () {","+    $user = twoFactorUser();","+","+    $this->actingAs($user)","+        ->withSession(sudoSession())","+        ->postJson('/settings/security/2fa/edit', ['action' => 'remove'])","+        ->assertStatus(422);","+","+    $fresh = $user->fresh();","+    expect((bool) $fresh->{'2fa_enabled'})->toBeTrue();","+    expect($fresh->{'2fa_secret'})->not->toBeNull();","+});","+","+it('rejects removal with an invalid code', function () {","+    $user = twoFactorUser();","+","+    $this->actingAs($user)","+        ->withSession(sudoSession())","+        ->postJson('/settings/security/2fa/edit', ['action' => 'remove', 'code' => '000000'])","+        ->assertStatus(403);","+","+    $fresh = $user->fresh();","+    expect((bool) $fresh->{'2fa_enabled'})->toBeTrue();","+    expect($fresh->{'2fa_secret'})->not->toBeNull();","+});","+","+it('removes 2FA with a valid TOTP code and writes an audit log', function () {","+    $user = twoFactorUser();","+    $code = (new Google2FA)->getCurrentOtp($user->{'2fa_secret'});","+","+    $this->actingAs($user)","+        ->withSession(sudoSession())","+        ->postJson('/settings/security/2fa/edit', ['action' => 'remove', 'code' => $code])","+        ->assertOk()","+        ->assertJson(['msg' => 'Successfully removed 2fa device']);","+","+    $fresh = $user->fresh();","+    expect((bool) $fresh->{'2fa_enabled'})->toBeFalse();","+    expect($fresh->{'2fa_secret'})->toBeNull();","+    expect($fresh->{'2fa_backup_codes'})->toBeNull();","+    expect($fresh->{'2fa_setup_at'})->toBeNull();","+","+    expect(AccountLog::whereUserId($user->id)->whereAction('account.security.2fa.remove')->exists())->toBeTrue();","+});","+","+it('removes 2FA with a valid backup code', function () {","+    $backup = 'BACKUPCODEONE12345678901';","+    $user = twoFactorUser([$backup, 'SECONDBACKUPCODE12345678']);","+","+    $this->actingAs($user)","+        ->withSession(sudoSession())","+        ->postJson('/settings/security/2fa/edit', ['action' => 'remove', 'code' => $backup])","+        ->assertOk()","+        ->assertJson(['msg' => 'Successfully removed 2fa device']);","+","+    $fresh = $user->fresh();","+    expect((bool) $fresh->{'2fa_enabled'})->toBeFalse();","+    expect($fresh->{'2fa_secret'})->toBeNull();","+});","+","+it('rejects a non-remove action', function () {","+    $user = twoFactorUser();","+    $code = (new Google2FA)->getCurrentOtp($user->{'2fa_secret'});","+","+    $this->actingAs($user)","+        ->withSession(sudoSession())","+        ->postJson('/settings/security/2fa/edit', ['action' => 'disable', 'code' => $code])","+        ->assertStatus(403);","+","+    expect((bool) $user->fresh()->{'2fa_enabled'})->toBeTrue();","+});",""],"additions":119,"deletions":0,"truncated":false}],"additions":158,"deletions":14,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-09-26T13:10:51.293108+00:00"}