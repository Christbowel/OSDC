m vllm.v1.engine.core import EngineCore","+","+    core = object.__new__(EngineCore)","+    core.vllm_config = VllmConfig()","+    core.vllm_config.watermark_config = watermark_config","+    core.mm_receiver_cache = None","+    core.request_block_hasher = None","+    core.prefix_hash_config = None","+    request = _engine_core_request(params)","+    core.preprocess_add_request(request)","+    return request.sampling_params","+","+","+# EngineCore applies enforce again for frontends that never ran the check","+# (Rust HTTP and gRPC), so these params arrive unresolved.","+@pytest.mark.parametrize(\"enforce\", [False, True])","+def test_enforce_engine_core_backstop_warns_once(","+    enforce, caplog_vllm, reset_warning_once","+):","+    config = VllmConfig()","+    config.watermark_config = WatermarkConfig(key=42, enforce=enforce)","+    with caplog_vllm.at_level(\"WARNING\"):","+        for params in (","+            SamplingParams(temperature=0, watermarking=False),","+            SamplingParams(trace_decode_token_ids=[1, 2], watermarking=False),","+        ):","+            params = _preprocess_in_engine_core(params, config.watermark_config)","+            assert params.watermarking is False","+        assert \"overriding watermarking=False\" not in caplog_vllm.text","+        params = _preprocess_in_engine_core(","+            SamplingParams(watermarking=False), config.watermark_config","+        )","+        assert params.watermarking is enforce","+        assert caplog_vllm.text.count(\"overriding watermarking=False\") == int(enforce)","+        for _ in range(2):","+            config._check_supports_watermarking(SamplingParams(watermarking=False))","+            params = _preprocess_in_engine_core(","+                SamplingParams(watermarking=False), config.watermark_config","+            )","+            assert params.watermarking is enforce","+    assert caplog_vllm.text.count(\"overriding watermarking=False\") == int(enforce)","+","+","+@pytest.mark.parame