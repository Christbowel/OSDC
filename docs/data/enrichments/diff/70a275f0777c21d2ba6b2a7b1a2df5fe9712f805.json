,"lines":["@@ -59,11 +59,11 @@ impl CustomFetcherSession {","             package: pnpm_tarball::TarballPackage { integrity: locked, ..download.package },","             ..download","         };","-        if let Some(integrity) = locked","+        if let Some(identity) = fetch_identity(original, locked)","             && let Some(tarball) = self.completed","                 .lock()","                 .unwrap()","-                .get(&(package_id.to_owned(), integrity.to_string()))","+                .get(&(package_id.to_owned(), identity))","                 .cloned()","         {","             return Ok(CustomFetchOutcome::Fetched { resolution: original.clone(), tarball });","@@ -94,6 +94,19 @@ impl CustomFetcherSession {","     }"," }"," ","+/// What a completed fetch of `resolution` is filed under besides its package","+/// id: the integrity its archive was checked against, or for a custom","+/// resolution, which carries none pacquet can check, the resolution itself.","+fn fetch_identity(","+    resolution: &LockfileResolution,","+    integrity: Option<&Integrity>,","+) -> Option<String> {","+    match resolution {","+        LockfileResolution::Custom(_) => serde_json::to_string(resolution).ok(),","+        _ => integrity.map(ToString::to_string),","+    }","+}","+"," /// Run the hook's fetch to completion, servicing the native-fetch"," /// callbacks it makes along the way. The tarballs those callbacks"," /// verified come back with the response so the caller can match the"],"additions":15,"deletions":2,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/custom_fetcher/metadata.rs","lines":["@@ -1,6 +1,7 @@"," use super::{","     CustomFetchOutcome, CustomFetcherSession, FetchedTarball, InstallPackageBySnapshotError,","     LockfileResolution, ResolvedTarballMetadata, decode_resolution, fetch_custom_tarball,","+    fetch_identity,"," };"," use crate::install_package_by_snapshot::tarball_url_and_integrity;"," use pnpm_config::Config;","@@ -45,18 +46,21 