{"id":"8498c4efbe604e81c68dcd17ecbb18c0915b072d","axis":"silent","repo":"argoproj/argo-workflows","sha":"8498c4efbe604e81c68dcd17ecbb18c0915b072d","parsed":{"files":[{"path":".features/pending/strip-managed-fields.md","lines":["@@ -0,0 +1,8 @@","+Description: Strip managedFields from controller informer caches to reduce memory usage","+Authors: [Alan Clucas](https://github.com/Joibel)","+Component: General","+Issues: 16564","+","+The workflow-controller now removes `metadata.managedFields` from objects before storing them in its informer caches.","+`managedFields` can be 20% or more of a cached object and nothing reads it, so this reduces controller memory usage at scale with no functional change.","+Objects stored in the cluster are unaffected."],"additions":8,"deletions":0,"truncated":false},{"path":"docs/scaling.md","lines":["@@ -15,6 +15,9 @@ You can scale the controller vertically in these ways:"," "," If you observe the Controller using its total CPU or memory requests, you should increase those."," ","+At scale the Controller's memory usage is dominated by its informer caches, which hold every live Workflow, Pod and related object it watches.","+Since v4.1 the Controller strips `metadata.managedFields` from objects before caching them, which reduces the memory needed per cached object; keep this in mind when comparing heap profiles across versions.","+"," ### Adding Goroutines to Increase Concurrency"," "," If you have sufficient CPU cores, you can take advantage of them with more goroutines:"],"additions":3,"deletions":0,"truncated":false},{"path":"docs/upgrading.md","lines":["@@ -7,6 +7,12 @@ the [conventional commits](https://www.conventionalcommits.org/en/v1.0.0/#summar"," "," ## Upgrading to v4.1"," ","+### Controller caches no longer store `managedFields`","+","+The workflow-controller (and the parts of the argo-server that share its informers) now strips `metadata.managedFields` from objects before storing them in its informer caches ([#16563](https://github.com/argoproj/argo-workflows/pull/16563)).","+This reduces controller memory usage — As a rough guide `managedFields` might be about 20% of the memory usage of objects, and at scale informer objects use most of the controllers memory footprint.","+This is internal to the controller's caches; objects stored in the cluster are unaffected.","+"," ### `argo archive` commands accept a workflow name as well as a UID"," "," The `argo archive get`, `delete`, `resubmit` and `retry` commands previously took a workflow UID as their argument."],"additions":6,"deletions":0,"truncated":false},{"path":"util/informer/transform.go","lines":["@@ -0,0 +1,23 @@","+// Package informer provides helpers shared by the informers used in the","+// workflow-controller and argo-server.","+package informer","+","+import (","+\t\"k8s.io/apimachinery/pkg/api/meta\"","+)","+","+// StripManagedFields is a cache.TransformFunc that removes","+// metadata.managedFields before objects enter an informer cache.","+// Nothing reads managedFields from the cache, and the API server ignores","+// a nil managedFields on non-apply updates, so this is loss-free. It can","+// be 20% or more of the object size.","+func StripManagedFields(i any) (any, error) {","+\tobj, err := meta.Accessor(i)","+\t// err != nil: tombstones (DeletedFinalStateUnknown) etc — pass through.","+\t// The nil-check avoids mutating objects that already lack managedFields","+\t// (kubernetes/kubernetes#124337).","+\tif err == nil && obj.GetManagedFields() != nil {","+\t\tobj.SetManagedFields(nil)","+\t}","+\treturn i, nil","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"util/informer/transform_test.go","lines":["@@ -0,0 +1,62 @@","+package informer","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tapiv1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured\"","+\t\"k8s.io/client-go/tools/cache\"","+)","+","+func TestStripManagedFields(t *testing.T) {","+\tt.Run(\"typed object\", func(t *testing.T) {","+\t\tpod := &apiv1.Pod{","+\t\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\t\tName:          \"my-pod\",","+\t\t\t\tManagedFields: []metav1.ManagedFieldsEntry{{Manager: \"kubelet\"}},","+\t\t\t},","+\t\t}","+\t\tout, err := StripManagedFields(pod)","+\t\trequire.NoError(t, err)","+\t\tassert.Same(t, pod, out)","+\t\tassert.Nil(t, pod.ManagedFields)","+\t\tassert.Equal(t, \"my-pod\", pod.Name)","+\t})","+\tt.Run(\"unstructured object\", func(t *testing.T) {","+\t\tun := &unstructured.Unstructured{Object: map[string]any{","+\t\t\t\"apiVersion\": \"argoproj.io/v1alpha1\",","+\t\t\t\"kind\":       \"Workflow\",","+\t\t\t\"metadata\": map[string]any{","+\t\t\t\t\"name\":          \"my-wf\",","+\t\t\t\t\"managedFields\": []any{map[string]any{\"manager\": \"workflow-controller\"}},","+\t\t\t},","+\t\t}}","+\t\tout, err := StripManagedFields(un)","+\t\trequire.NoError(t, err)","+\t\tassert.Same(t, un, out)","+\t\tassert.Nil(t, un.GetManagedFields())","+\t\tassert.NotContains(t, un.Object[\"metadata\"], \"managedFields\")","+\t\tassert.Equal(t, \"my-wf\", un.GetName())","+\t})","+\tt.Run(\"nil managedFields is not mutated\", func(t *testing.T) {","+\t\tun := &unstructured.Unstructured{Object: map[string]any{","+\t\t\t\"apiVersion\": \"argoproj.io/v1alpha1\",","+\t\t\t\"kind\":       \"Workflow\",","+\t\t\t\"metadata\":   map[string]any{\"name\": \"my-wf\"},","+\t\t}}","+\t\twant := un.DeepCopy()","+\t\tout, err := StripManagedFields(un)","+\t\trequire.NoError(t, err)","+\t\tassert.Same(t, un, out)","+\t\tassert.Equal(t, want, un)","+\t})","+\tt.Run(\"non-object input passes through\", func(t *testing.T) {","+\t\ttombstone := cache.DeletedFinalStateUnknown{Key: \"my-ns/my-pod\"}","+\t\tout, err := StripManagedFields(tombstone)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, tombstone, out)","+\t})","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"workflow/controller/controller.go","lines":["@@ -48,6 +48,7 @@ import ("," \t\"github.com/argoproj/argo-workflows/v4/util/deprecation\""," \t\"github.com/argoproj/argo-workflows/v4/util/env\""," \t\"github.com/argoproj/argo-workflows/v4/util/errors\"","+\tinformerutil \"github.com/argoproj/argo-workflows/v4/util/informer\""," \trbacutil \"github.com/argoproj/argo-workflows/v4/util/rbac\""," \t\"github.com/argoproj/argo-workflows/v4/util/retry\""," \tutilsqldb \"github.com/argoproj/argo-workflows/v4/util/sqldb\"","@@ -1361,6 +1362,8 @@ func (wfc *WorkflowController) newTypedConfigMapInformer(ctx context.Context) ca"," \t}, func(opts *metav1.ListOptions) {"," \t\topts.LabelSelector = common.LabelKeyConfigMapType"," \t})","+\t//nolint:errcheck // the error only happens if the informer was already started, and it hasn't been","+\tindexInformer.SetTransform(informerutil.StripManagedFields)"," \tctx, logger := logging.RequireLoggerFromContext(ctx).WithField(\"component\", \"config_map_informer\").InContext(ctx)"," \tlogger.WithField(\"executorPlugins\", wfc.executorPlugins != nil).Info(ctx, \"Plugins\")"," \tif wfc.executorPlugins != nil {","@@ -1542,7 +1545,8 @@ func (wfc *WorkflowController) newWorkflowTaskSetInformer() wfextvv1alpha1.Workf"," \t\texternalversions.WithTweakListOptions(func(x *metav1.ListOptions) {"," \t\t\tr := util.InstanceIDRequirement(wfc.Config.InstanceID)"," \t\t\tx.LabelSelector = r.String()","-\t\t})).Argoproj().V1alpha1().WorkflowTaskSets()","+\t\t}),","+\t\texternalversions.WithTransform(informerutil.StripManagedFields)).Argoproj().V1alpha1().WorkflowTaskSets()"," \t//nolint:errcheck // the error only happens if the informer was stopped, and it hasn't even started (https://github.com/kubernetes/client-go/blob/46588f2726fa3e25b1704d6418190f424f95a990/tools/cache/shared_informer.go#L580)"," \tinformer.Informer().AddEventHandler("," \t\tcache.ResourceEventHandlerFuncs{","@@ -1564,7 +1568,8 @@ func (wfc *WorkflowController) newArtGCTaskInformer() wfextvv1alpha1.WorkflowArt"," \t\texternalversions.WithTweakListOptions(func(x *metav1.ListOptions) {"," \t\t\tr := util.InstanceIDRequirement(wfc.Config.InstanceID)"," \t\t\tx.LabelSelector = r.String()","-\t\t})).Argoproj().V1alpha1().WorkflowArtifactGCTasks()","+\t\t}),","+\t\texternalversions.WithTransform(informerutil.StripManagedFields)).Argoproj().V1alpha1().WorkflowArtifactGCTasks()"," \t//nolint:errcheck // the error only happens if the informer was stopped, and it hasn't even started (https://github.com/kubernetes/client-go/blob/46588f2726fa3e25b1704d6418190f424f95a990/tools/cache/shared_informer.go#L580)"," \tinformer.Informer().AddEventHandler("," \t\tcache.ResourceEventHandlerFuncs{"],"additions":7,"deletions":2,"truncated":false},{"path":"workflow/controller/informer/tolerant_cluster_workflow_template_informer.go","lines":["@@ -13,6 +13,7 @@ import ("," \t\"github.com/argoproj/argo-workflows/v4/pkg/apis/workflow\""," \textwfv1 \"github.com/argoproj/argo-workflows/v4/pkg/client/informers/externalversions/workflow/v1alpha1\""," \t\"github.com/argoproj/argo-workflows/v4/pkg/client/listers/workflow/v1alpha1\"","+\tinformerutil \"github.com/argoproj/argo-workflows/v4/util/informer\""," )"," "," type tolerantClusterWorkflowTemplateInformer struct {","@@ -21,14 +22,17 @@ type tolerantClusterWorkflowTemplateInformer struct {"," "," // NewTolerantClusterWorkflowTemplateInformer is a drop-in replacement for `extwfv1.ClusterWorkflowTemplateInformer` that ignores malformed resources."," func NewTolerantClusterWorkflowTemplateInformer(dynamicInterface dynamic.Interface, defaultResync time.Duration) extwfv1.ClusterWorkflowTemplateInformer {","-\treturn &tolerantClusterWorkflowTemplateInformer{delegate: dynamicinformer.NewFilteredDynamicSharedInformerFactory(dynamicInterface, defaultResync, \"\", func(options *metav1.ListOptions) {","+\tdelegate := dynamicinformer.NewFilteredDynamicSharedInformerFactory(dynamicInterface, defaultResync, \"\