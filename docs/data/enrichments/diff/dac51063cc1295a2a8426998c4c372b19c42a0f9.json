{"id":"dac51063cc1295a2a8426998c4c372b19c42a0f9","axis":"silent","repo":"vllm-project/vllm","sha":"dac51063cc1295a2a8426998c4c372b19c42a0f9","parsed":{"files":[{"path":"tests/v1/attention/mxfp4_mla/test_mxfp4_mla_plumbing.py","lines":["@@ -0,0 +1,194 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"mxfp4_mla dtype selection, page sizing, and routing to the kernels that can","+read a packed cache.\"\"\"","+","+import contextlib","+import types","+from typing import Any","+","+import pytest","+import torch","+","+from vllm.v1.attention.ops.mxfp4_mla import row_bytes","+","+# GLM-5.3's latent; the other widths check nothing is pinned to it.","+LATENT = 512","+ROW = row_bytes(LATENT)","+LATENT_WIDTHS = [256, LATENT, 1024]","+","+","+def _layer_spec(block_size: int = 64, latent: int = LATENT):","+    \"\"\"The spec the MLA layer publishes for a GLM-5.3 main layer.\"\"\"","+    from vllm.model_executor.layers.attention.mla_attention import MLAAttention","+","+    layer = types.SimpleNamespace(","+        kv_cache_dtype=\"mxfp4_mla\",","+        head_size=latent,","+        sliding_window=None,","+        indexer=None,","+        topk_buffer_width=None,","+        non_causal_multi_token_decode=False,","+        attn_backend=types.SimpleNamespace(get_name=lambda: \"ROCM_AITER_MLA_SPARSE\"),","+        _uses_flat_kv_cache=lambda: False,","+    )","+    config = types.SimpleNamespace(","+        cache_config=types.SimpleNamespace(block_size=block_size),","+        model_config=types.SimpleNamespace(dtype=torch.bfloat16),","+    )","+    return MLAAttention.get_kv_cache_spec(layer, config)","+","+","+def test_row_is_272_bytes_for_a_512_wide_latent():","+    assert ROW == 272","+","+","+@pytest.mark.parametrize(\"latent\", LATENT_WIDTHS)","+def test_dtype_selects_a_packed_uint8_row(latent: int):","+    from vllm.config.cache import CacheConfig","+    from vllm.utils.torch_utils import STR_DTYPE_TO_TORCH_DTYPE","+    from vllm.v1.attention.backends.mla.rocm_aiter_mla_sparse import (","+        ROCMAiterMLASparseBackend,","+    )","+","+    assert CacheConfig(block_size=64, cache_dtype=\"mxfp4_mla\").cache_dtype == (","+        \"mxfp4_mla\"","+    )","+    assert STR_DTYPE_TO_TORCH_DTYPE[\"mxfp4_mla\"] is torch.uint8","+    assert \"mxfp4_mla\" in ROCMAiterMLASparseBackend.supported_kv_cache_dtypes","+","+    spec = _layer_spec(latent=latent)","+    assert spec.dtype is torch.uint8","+    assert spec.page_size_bytes == 64 * (latent // 2 + latent // 32)","+","+","+def test_hybrid_block_size_matches_the_layer_page(monkeypatch):","+    \"\"\"The platform sizes the hybrid block from the same row the layer uses.","+","+    GLM-5.3-Flash at TP=4 has a 1085440-byte mamba state; the glm5_next KV","+    grouping rejects the config if that exceeds the real MLA page.","+    \"\"\"","+    import vllm.config.vllm as vllm_config_mod","+    from vllm.model_executor.models import ModelRegistry","+    from vllm.platforms.interface import Platform","+","+    mamba_page = 1085440","+    model_cls = types.SimpleNamespace(","+        get_mamba_specs_from_config=lambda _: [","+            types.SimpleNamespace(page_size_bytes=mamba_page)","+        ]","+    )","+    monkeypatch.setattr(","+        ModelRegistry, \"resolve_model_cls\", lambda *a, **k: (model_cls, None)","+    )","+    monkeypatch.setattr(","+        vllm_config_mod, \"set_current_vllm_config\", lambda _: contextlib.nullcontext()","+    )","+    cache = types.SimpleNamespace(","+        cache_dtype=\"mxfp4_mla\",","+        block_size=64,","+        mamba_block_size=None,","+        user_specified_mamba_block_size=False,","+        mamba_cache_mode=\"none\",","+        mamba_page_size_padded=None,","+        kv_cache_dtype_skip_layers=None,","+    )","+    config = types.SimpleNamespace(","+        cache_config=cache,","+        parallel_config=None,","+        model_config=types.SimpleNamespace(","+            dtype=torch.bfloat16,","+            use_mla=True,","+            architecture=\"GlmMoeDsaForCausalLM\",","+            get_num_kv_heads=lambda _: 1,","+            get_head_size=lambda: LATENT,","+        ),","+    )","+    backend = types.SimpleNamespace(get_supported_kernel_block_sizes=lambda: [64])","+    monkeypatch.setattr(","+        Platform, \"_find_non_ssm_backends\", classmethod(lambda cls, _: [backend])","+    )","+","+    Platform._align_hybrid_block_size(config, backend)","+","+    layer_page = _layer_spec(cache.block_size).page_size_bytes","+    assert layer_page >= mamba_page","+    assert cache.mamba_page_size_padded == layer_page","+","+","+@pytest.mark.parametrize(\"latent\", LATENT_WIDTHS)","+def test_decode_and_prefill_take_the_triton_route(latent: int):","+    \"\"\"Only the Triton kernels read a packed cache; AITER's would misread it.\"\"\"","+    from vllm.v1.attention.backends.mla.rocm_aiter_mla_sparse import (","+        _use_rocm_sparse_triton,","+    )","+","+    decode = dict(num_prefills=0, num_decodes=8, num_decode_tokens=8, max_query_len=1)","+    prefill = dict(","+        num_prefills=2, num_decodes=0, num_decode_tokens=0, max_query_len=128","+    )","+    for step in (decode, prefill):","+        assert _use_rocm_sparse_triton(","+            kv_cache_dtype=\"mxfp4_mla\", head_size=latent, kv_lora_rank=latent, **step","+        )","+","+","+@pytest.mark.parametrize(\"kv_cache_dtype\", [\"auto\", \"fp8\"])","+def test_other_dtypes_forward_skip_scale_to_the_base_update(","+    monkeypatch, kv_cache_dtype","+):","+    \"\"\"MLAAttention.update_kv_cache passes skip_scale as a 7th positional arg.\"\"\"","+    from vllm.v1.attention.backends.mla import rocm_aiter_mla_sparse as sparse_mod","+","+    captured = []","+    monkeypatch.setattr(","+        sparse_mod.SparseMLACommonImpl,","+        \"do_kv_cache_update\",","+        lambda self, *args: captured.append(args),","+    )","+    impl = object.__new__(sparse_mod.ROCMAiterMLASparseImpl)","+    args = (None, None, None, None, kv_cache_dtype, None, True)","+    impl.do_kv_cache_update(*args)","+    assert captured == [args]","+","+","+@pytest.mark.skipif(","+    not torch.cuda.is_available(),","+    reason=\"_forward_mla imports vllm.platforms.rocm, which queries the GPU\",","+)","+def test_long_decode_takes_split_k_with_the_packed_cache(monkeypatch):","+    from vllm.v1.attention.backends.mla import rocm_aiter_mla_sparse as sparse_mod","+","+    def no_single_pass(**kwargs):","+        raise AssertionError(\"expected the split-K decode\")","+","+    captured: dict[str, Any] = {}","+    monkeypatch.setattr(sparse_mod, \"rocm_sparse_decode_bf16_num_splits\", lambda *a: 4)","+    monkeypatch.setattr(sparse_mod, \"rocm_sparse_attn_decode_bf16\", captured.update)","+    monkeypatch.setattr(sparse_mod, \"rocm_sparse_attn_prefill\", no_single_pass)","+","+    impl = object.__new__(sparse_mod.ROCMAiterMLASparseImpl)","+    impl.num_heads = 16","+    impl.kv_lora_rank = LATENT","+    impl.kv_cache_dtype = \"mxfp4_mla\"","+    impl.scale = LATENT**-0.5","+    impl.sinks = None","+    metadata = types.SimpleNamespace(","+        attn_out_dtype=torch.bfloat16,","+        num_prefills=0,","+        num_decodes=2,","+        num_decode_tokens=2,","+        max_query_len=1,","+        max_seq_len=8192,","+        topk_tokens=2048,","+        paged_kv_indices=torch.zeros(4, dtype=torch.int32),","+        paged_kv_indptr=torch.tensor([0, 2, 4], dtype=torch.int32),","+    )","+    q = torch.zeros(2, 16, LATENT, dtype=torch.bfloat16)","+    cache = torch.zeros(4, 1, ROW, dtype=torch.uint8)","+","+    impl._forward_mla(types.SimpleNamespace(), q, cache, metadata)","+","+    assert captured[\"kv_cache_dtype\"] == \"mxfp4_mla\"","+    assert captured[\"kv\"].shape == (4, 1, ROW)","+    assert captured[\"num_splits\"] == 4"],"additions":194,"deletions":0,"truncated":false},{"path":"tests/v1/attention/mxfp4_mla/test_mxfp4_mla_read.py","lines":["@@ -0,0 +1,150 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The mxfp4_mla read path: the row unpack on its own, with the gfx950","+hardware converter and with the software path used elsewhere, and the","+attention kernels that read a packed cache through it.\"\"\"","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+from vllm.triton_utils import tl, triton","+from vllm.utils.torch_utils import set_random_seed","+from vllm.v1.attention.ops.mxfp4_mla.read import _load_mxfp4_rows","+","+if current_platform.is_rocm() and torch.cuda.is_available():","+    from vllm.platforms.rocm import get_cdna_version","+","+    _CDNA_VERSION = get_cdna_version()","+else:","+    _CDNA_VERSION = 0","+pytestmark = pytest.mark.skipif(","+    _CDNA_VERSION not in (3, 4), reason=\"mxfp4_mla needs CDNA 3 or 4 (gfx942 or gfx950)\"","+)","+","+LATENT, ROW, GROUP, BLOCK_K = 512, 272, 32, 16","+_E2M1_VALUES = torch.tensor([0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0])","+","+","+def _dequantize(rows: torch.Tensor) -> torch.Tensor:","+    \"\"\"Packed `[n, ROW]` uint8 rows -> fp32 `[n, LATENT]`.\"\"\"","+    rows = rows.cpu()","+    data = rows[:, : LATENT // 2]","+    codes = torch.stack([data & 0x0F, data >> 4], dim=-1).reshape(len(rows), LATENT)","+    sign = torch.where(codes & 0x08 != 0, -1.0, 1.0)","+    values = _E2M1_VALUES[(codes & 0x07).long()] * sign","+    scales = torch.exp2(rows[:, LATENT // 2 :].float() - 127.0)","+    return values * scales.repeat_interleave(GROUP, dim=1)","+","+","+@triton.jit","+def _gather_kernel(","+    cache_ptr,","+    slots_ptr,","+    out_ptr,","+    num_slots,","+    row_pitch,","+    BLOCK_K: tl.constexpr,","+    LATENT: tl.constexpr,","+    HW_UNPACK: tl.constexpr,","+):","+    offsets = tl.program_id(0) * BLOCK_K + tl.arange(0, BLOCK_K)","+    slots = tl.load(slots_ptr + offsets).to(tl.int64)","+    valid = (slots >= 0) & (slots < num_slots)","+    values = _load_mxfp4_rows(","+        cache_ptr,","+        tl.where(valid, slots, 0),","+        valid,","+        row_pitch,","+        BLOCK_K,","+        LATENT,","+        HW_UNPACK,","+    )","+    tl.store(","+        out_ptr + offsets[:, None] * LATENT + tl.arange(0, LATENT)[None, :], values","+    )","+","+","+@pytest.mark.parametrize(","+    \"hw_unpack\",","+    [","+        False,","+        pytest.param(","+            True,","+            marks=pytest.mark.skipif(_CDNA_VERSION != 4, reason=\"needs gfx950\"),","+        ),","+    ],","+    ids=[\"software\", \"gfx950\"],","+)","+def test_load_rows_matches_reference(hw_unpack: bool):","+    \"\"\"Every code and a wide spread of scales, gathered from scattered slots;","+    padded and out-of-range slots read as zero.\"\"\"","+    set_random_seed(0)","+    num_rows = 64","+    cache = torch.randint(0, 256, (num_rows, ROW), dtype=torch.uint8)","+    cache[:, LATENT // 2 :] = torch.randint(100, 151, (num_rows, LATENT // GROUP))","+    slots = torch.randperm(num_rows)[: 2 * BLOCK_K]","+    slots[3], slots[20] = -1, num_rows + 5","+","+    out = torch.empty(len(slots), LATENT, dtype=torch.bfloat16, device=\"cuda\")","+    _gather_kernel[(len(slots) // BLOCK_K,)](","+        cache.cuda(),","+        slots.cuda(),","+        out,","+        num_rows,","+        ROW,","+        BLOCK_K=BLOCK_K,","+        LATENT=LATENT,","+        HW_UNPACK=hw_unpack,","+    )","+","+    valid = (slots >= 0) & (slots < num_rows)","+    want = torch.zeros(len(slots), LATENT)","+    want[valid] = _dequantize(cache[slots[valid]])","+    assert torch.equal(out.float().cpu(), want)","+","+","+@pytest.mark.parametrize(\"num_splits\", [1, 4], ids=[\"ragged\", \"split_k\"])","+def test_attention_matches_dequantized_cache(num_splits: int):","+    \"\"\"Attention over the packed cache equals attention over the same values","+    stored as bf16, through the ragged kernel and the split-K decode kernel.\"\"\"","+    from vllm.v1.attention.ops.mxfp4_mla.store import store_mxfp4_mla","+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import (","+        rocm_sparse_attn_decode_bf16,","+        rocm_sparse_attn_prefill,","+    )","+","+    set_random_seed(0)","+    num_queries, heads, num_kv, per_query = 4, 16, 128, 64","+    q = torch.randn(num_queries, heads, LATENT, dtype=torch.bfloat16).cuda()","+    latent = torch.randn(num_kv, LATENT, dtype=torch.bfloat16)","+    latent[:, ::97] *= 8.0","+    indices = torch.randint(0, num_kv, (num_queries * per_query,), dtype=torch.int32)","+    indptr = torch.arange(num_queries + 1, dtype=torch.int32) * per_query","+","+    packed = torch.zeros(num_kv, ROW, dtype=torch.uint8, device=\"cuda\")","+    store_mxfp4_mla(latent.cuda(), torch.arange(num_kv).cuda(), packed)","+    dequantized = _dequantize(packed).to(torch.bfloat16).cuda()","+","+    def attend(kv: torch.Tensor) -> torch.Tensor:","+        out = torch.empty(num_queries, heads, LATENT, dtype=torch.bfloat16).cuda()","+        common = dict(","+            q=q,","+            kv=kv.unsqueeze(1),","+            scale=LATENT**-0.5,","+            head_dim=LATENT,","+            nope_head_dim=LATENT,","+            rope_head_dim=0,","+            attn_sink=None,","+            output=out,","+            ragged_indices=indices.cuda(),","+            ragged_indptr=indptr.cuda(),","+            kv_cache_dtype=\"mxfp4_mla\" if kv.dtype == torch.uint8 else \"auto\",","+        )","+        if num_splits == 1:","+            rocm_sparse_attn_prefill(indices=None, topk_length=None, **common)","+        else:","+            rocm_sparse_attn_decode_bf16(num_splits=num_splits, **common)","+        return out.cpu()","+","+    assert torch.equal(attend(packed), attend(dequantized))"],"additions":150,"deletions":0,"truncated":false},{"path":"tests/v1/attention/mxfp4_mla/test_mxfp4_mla_store.py","lines":["@@ -0,0 +1,61 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The mxfp4_mla store kernel must write exactly what AITER's MXFP4 quantizer","+produces, into the right rows of the paged cache.\"\"\"","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+from vllm.utils.torch_utils import set_random_seed","+","+pytestmark = pytest.mark.skipif(","+    not (current_platform.is_rocm() and torch.cuda.is_available()),","+    reason=\"mxfp4_mla is ROCm-only\",","+)","+","+LATENT, ROW = 512, 272","+UNTOUCHED = 0xCD","+","+","+def test_store_matches_aiter():","+    \"\"\"Bit-exact against `per_1x32_f4_quant` on the layout the backend hands","+    the kernel: blocks strided past `block_size` rows by other layers' pages,","+    padded slots, and a latent that is a slice of a wider buffer.\"\"\"","+    pytest.importorskip(\"aiter\")","+    quant = pytest.importorskip(\"aiter.ops.quant\")","+    from vllm.v1.attention.ops.mxfp4_mla.store import store_mxfp4_mla","+","+    set_random_seed(0)","+    num_blocks, block_size, gap = 8, 8, 5","+    backing = torch.full(","+        (num_blocks, block_size + gap, ROW), UNTOUCHED, dtype=torch.uint8","+    ).cuda()","+    cache = backing[:, :block_size]","+","+    # 64 tokens, two of them padding; two slots are never written.","+    num_slots = num_blocks * block_size","+    wide = torch.randn(num_slots, 2 * LATENT, dtype=torch.bfloat16)","+    wide[:, ::97] *= 8.0","+    latent = wide.cuda()[:, :LATENT]","+    written = torch.randperm(num_slots)[: num_slots - 2]","+    slots = torch.cat([written, torch.tensor([-1, -1])])","+","+    store_mxfp4_mla(latent, slots.cuda(), cache)","+","+    packed, scales = quant.per_1x32_f4_quant(latent.float().cpu(), pack_dim=-1)","+    want = torch.cat(","+        [","+            packed.contiguous().view(torch.uint8).reshape(len(slots), -1),","+            scales.contiguous().view(torch.uint8).reshape(len(slots), -1),","+        ],","+        dim=1,","+    )","+    got = backing.cpu()","+    for token, slot in enumerate(written.tolist()):","+        block, offset = divmod(slot, block_size)","+        assert torch.equal(got[block, offset], want[token]), f\"slot {slot}\"","+    for slot in set(range(num_slots)) - set(written.tolist()):","+        block, offset = divmod(slot, block_size)","+        assert (got[block, offset] == UNTOUCHED).all(), f\"slot {slot} was written\"","+    assert (got[:, block_size:] == UNTOUCHED).all(), \"a write landed between blocks\""],"additions":61,"deletions":0,"truncated":false},{"path":"vllm/config/cache.py","lines":["@@ -64,6 +64,7 @@ def _layout_from_name(layout_name: str) -> KVCacheLayout:","     \"fp8_per_token_head\",","     \"nvfp4\",","     \"nvfp4_4over6\",","+    \"mxfp4_mla\","," ]"," "," # Mutable mirror of the CacheDType Literal. Custom dtypes registered by"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/attention/mla_attention.py","lines":["@@ -296,6 +296,7 @@"," )"," from vllm.v1.attention.ops.dcp import MLADCPManager"," from vllm.v1.attention.ops.merge_attn_states import merge_attn_states","+from vllm.v1.attention.ops.mxfp4_mla import row_bytes as mxfp4_row_bytes"," from vllm.v1.attention.ops.pcp import (","     finalize_mla_pcp_decode,","     maybe_gather_mla_latent_cache_inputs,","@@ -1541,7 +1542,9 @@ def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:","             # ds_mla layouts pack NoPE + RoPE + scales into one opaque per-token","             # blob, so the size is not derivable from head_size.","             state_content_bytes=(","-                cast(MLAAttentionImpl, self.impl).get_fp8_ds_mla_row_bytes()","+                mxfp4_row_bytes(self.head_size)","+                if self.kv_cache_dtype == \"mxfp4_mla\"","+                else cast(MLAAttentionImpl, self.impl).get_fp8_ds_mla_row_bytes()","                 if self.kv_cache_dtype == \"fp8_ds_mla\"","                 else DS_MLA_STATE_CONTENT_BYTES.get(self.kv_cache_dtype)","             ),"],"additions":4,"deletions":1,"truncated":false},{"path":"vllm/platforms/interface.py","lines":["@@ -986,6 +986,7 @@ def _align_hybrid_block_size("," ","         # Compute attention page size for 1 token","         if model_config.use_mla:","+            from vllm.v1.attention.ops.mxfp4_mla import row_bytes as mxfp4_row_bytes","             from vllm.v1.kv_cache_interface import DS_MLA_STATE_CONTENT_BYTES"," ","             attn_page_size_1_token = MLAAttentionSpec(","@@ -995,8 +996,13 @@ def _align_hybrid_block_size(","                 dtype=kv_cache_dtype,","                 cache_dtype_str=cache_config.cache_dtype,","                 kv_quant_mode=kv_quant_mode,","-                state_content_bytes=DS_MLA_STATE_CONTENT_BYTES.get(","-                    cache_config.cache_dtype","+                # Must match MLAAttention.get_kv_cache_spec, else the mamba","+                # state no longer fits the real (smaller) MLA page.","+                # test_hybrid_block_size_matches_the_layer_page checks both.","+                state_content_bytes=(","+                    mxfp4_row_bytes(model_config.get_head_size())","+                    if cache_config.cache_dtype == \"mxfp4_mla\"","+                    else DS_MLA_STATE_CONTENT_BYTES.get(cache_config.cache_dtype)","                 ),","             ).page_size_bytes","         elif ("],"additions":8,"deletions":2,"truncated":false},{"path":"vllm/utils/torch_utils.py","lines":["@@ -64,6 +64,7 @@","     \"ultraquant_4bit\": torch.uint8,","     \"nvfp4\": torch.uint8,","     \"nvfp4_4over6\": torch.uint8,","+    \"mxfp4_mla\": torch.uint8,"," }"," "," TORCH_DTYPE_TO_NUMPY_DTYPE = {"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/v1/attention/backends/mla/rocm_aiter_mla_sparse.py","lines":["@@ -35,6 +35,8 @@","     align_blocks_to_rows,","     flat_kv_row_view,"," )","+from vllm.v1.attention.ops.mxfp4_mla import row_bytes as mxfp4_row_bytes","+from vllm.v1.attention.ops.mxfp4_mla.store import store_mxfp4_mla"," from vllm.v1.attention.ops.rocm_aiter_mla_sparse import (","     rocm_sparse_attn_decode_bf16,","     rocm_sparse_attn_prefill,","@@ -373,6 +375,7 @@ class ROCMAiterMLASparseBackend(AttentionBackend):","         \"bfloat16\",","         \"fp8\",","         \"fp8_e4m3\",","+        \"mxfp4_mla\",","         \"fp8_ds_mla\",","     ]"," ","@@ -867,7 +870,11 @@ def __init__(","                     \"requires gfx950 (aiter Triton sparse_mla_fwd, \"","                     \"fp8_dsv32_mla layout).\"","                 )","-        self.supports_dense_mha_prefill = sinks is None  # type: ignore[misc]","+        # Dense-MHA prefill gathers cache rows into a bf16 workspace and would","+        # misread packed mxfp4_mla rows.","+        self.supports_dense_mha_prefill = (  # type: ignore[misc]","+            sinks is None and kv_cache_dtype != \"mxfp4_mla\"","+        )","         self.masked_mha_available = False"," ","         vllm_config = get_current_vllm_config()","@@ -881,6 +888,18 @@ def __init__(","             (q_concat_shape, vllm_config.model_config.dtype),","         )","         self.qk_rope_head_dim: int = mla_args[\"qk_rope_head_dim\"]","+        rank = self.kv_lora_rank","+        if kv_cache_dtype == \"mxfp4_mla\" and (rank < 128 or rank & (rank - 1)):","+            # The read loads each packed row as int32 words into one","+            # power-of-two tile.","+            raise ValueError(","+                f\"mxfp4_mla needs kv_lora_rank to be a power of two >= 128, got {rank}\"","+            )","+        if kv_cache_dtype == \"mxfp4_mla\" and self.qk_rope_head_dim != 0:","+            raise ValueError(","+                \"mxfp4_mla stores only the latent, so it needs a rope-free (NoPE) \"","+                f\"model; got qk_rope_head_dim={self.qk_rope_head_dim}\"","+            )"," ","         if rocm_aiter_ops.is_triton_sparse_mla_enabled():","             reason = self._aiter_sparse_mla_unsupported_reason(vllm_config)","@@ -907,6 +926,34 @@ def _aiter_sparse_mla_unsupported_reason(","             return \"context parallelism is not supported\"","         return None"," ","+    def do_kv_cache_update(","+        self,","+        kv_c_normed: torch.Tensor,","+        k_pe: torch.Tensor,","+        kv_cache: torch.Tensor,","+        slot_mapping: torch.Tensor,","+        kv_cache_dtype: str,","+        k_scale: torch.Tensor,","+        skip_scale: bool = False,","+    ) -> None:","+        if kv_cache_dtype != \"mxfp4_mla\":","+            return super().do_kv_cache_update(","+                kv_c_normed,","+                k_pe,","+                kv_cache,","+                slot_mapping,","+                kv_cache_dtype,","+                k_scale,","+                skip_scale,","+            )","+        if kv_cache.numel() == 0:","+            return","+        assert k_pe.numel() == 0, (","+            f\"mxfp4_mla expects a rope-free latent, got k_pe with {k_pe.numel()} \"","+            \"elements\"","+        )","+        store_mxfp4_mla(kv_c_normed, slot_mapping.flatten(), kv_cache)","+","     def record_logical_topk_ready(self) -> None:","         # This impl shares the top-k indices buffer via SharedTopkIndicesBuffer","         # but does not participate in sparse-MLA index groups.","@@ -971,7 +1018,9 @@ def _forward_mla(","                     self.sinks.reshape(1, self.num_heads, 1),","                     q.shape[1],","                 ).reshape(-1)","-            kv = kv_c_and_k_pe_cache.view(-1, 1, q.shape[-1])","+            is_mxfp4 = self.kv_cache_dtype == \"mxfp4_mla\"","+            row_width = mxfp4_row_bytes(self.kv_lora_rank) if is_mxfp4 else q.shape[-1]","+            kv = kv_c_and_k_pe_cache.view(-1, 1, row_width)","             decode_num_splits = (","                 rocm_sparse_decode_bf16_num_splits(","                     num_tokens,","@@ -994,6 +1043,7 @@ def _forward_mla(","                     ragged_indices=attn_metadata.paged_kv_indices,","                     ragged_indptr=attn_metadata.paged_kv_indptr,","                     num_splits=decode_num_splits,","+                    kv_cache_dtype=self.kv_cache_dtype,","                 )","             else:","                 rocm_sparse_attn_prefill(","@@ -1009,6 +1059,7 @@ def _forward_mla(","                     output=output,","                     ragged_indices=attn_metadata.paged_kv_indices,","                     ragged_indptr=attn_metadata.paged_kv_indptr,","+                    kv_cache_dtype=self.kv_cache_dtype,","                 )","             output = AiterMLAHelper.get_mla_unpadded_o(self.num_heads, output)","             return output, None"],"additions":53,"deletions":2,"truncated":false},{"path":"vllm/v1/attention/ops/mxfp4_mla/__init__.py","lines":["@@ -0,0 +1,24 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Row layout of the mxfp4_mla KV cache.","+","+OCP MXFP4, group 32: E2M1 elements packed two per byte (the low nibble holds","+the lower index) and one E8M0 scale per group. A row is the packed data","+followed by its scales, `row_bytes(d) == d // 2 + d // 32`.","+\"\"\"","+","+from vllm.model_executor.layers.quantization.utils.ocp_mx_utils import (","+    OCP_MX_BLOCK_SIZE,","+)","+from vllm.triton_utils import tl","+","+GROUP_SIZE = OCP_MX_BLOCK_SIZE","+# A tl.constexpr so the store and read kernels can use it directly.","+E8M0_BIAS = tl.constexpr(127)","+","+","+def row_bytes(latent_dim: int, group: int = GROUP_SIZE) -> int:","+    \"\"\"Packed row size: data bytes + scale bytes. 272 for a 512-wide latent.\"\"\"","+    if latent_dim % group:","+        raise ValueError(f\"latent dim {latent_dim} not divisible by group {group}\")","+    return latent_dim // 2 + latent_dim // group"],"additions":24,"deletions":0,"truncated":false},{"path":"vllm/v1/attention/ops/mxfp4_mla/read.py","lines":["@@ -0,0 +1,201 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Triton read-side unpack for the mxfp4_mla KV cache.","+","+A row is packed data then scales, `row_bytes(d) == d // 2 + d // 32`.","+Unpacks a gathered tile to bf16 once and hands it to the existing `tl.dot`","+calls. On gfx950 `tl.dot_scaled` lowers to the same convert plus a bf16","+MFMA, so it would only convert twice.","+\"\"\"","+","+from __future__ import annotations","+","+from vllm.model_executor.layers.quantization.utils.nvfp4_emulation_utils import (","+    _e2m1_inline,","+)","+from vllm.platforms import current_platform","+from vllm.triton_utils import tl, triton","+from vllm.v1.attention.ops.mxfp4_mla import E8M0_BIAS, GROUP_SIZE","+","+if current_platform.is_rocm():","+    from vllm.platforms.rocm import _ON_GFX950","+else:","+    _ON_GFX950 = False","+","+# v_cvt_scalef32_pk_bf16_fp4 exists only on gfx950.","+_HW_UNPACK = tl.constexpr(_ON_GFX950)","+_GROUP = tl.constexpr(GROUP_SIZE)","+","+# fp32 is 1-8-23, so the exponent field starts at bit 23. Scaling by a power of","+# two is exactly an integer add there, which is how the E8M0 group scale is","+# applied without a transcendental.","+_F32_MANT_BITS = tl.constexpr(23)","+","+","+@triton.jit","+def _apply_e8m0_scale(values, encoded_scales):","+    \"\"\"Multiply fp32 `values` by `2**(X - 127)` via an integer exponent add.","+","+    Exact, because scaling by a power of two only shifts the exponent. Zero must","+    be special-cased: adding to a zero's exponent field manufactures a denormal","+    instead of leaving it zero.","+    \"\"\"","+    delta = (encoded_scales.to(tl.int32) - E8M0_BIAS) << _F32_MANT_BITS","+    bits = values.to(tl.int32, bitcast=True) + delta","+    scaled = bits.to(tl.float32, bitcast=True)","+    return tl.where(values == 0.0, 0.0, scaled)","+","+","+# Must be tl.constexpr *instances*: the JIT refuses plain module globals, and","+# annotating is not the same thing.","+_ASM_P01 = tl.constexpr(\"v_cvt_scalef32_pk_bf16_fp4 $0, $1, 1.0 op_sel:[0,0,0]\")","+_ASM_P23 = tl.constexpr(\"v_cvt_scalef32_pk_bf16_fp4 $0, $1, 1.0 op_sel:[1,0,0]\")","+_ASM_P45 = tl.constexpr(\"v_cvt_scalef32_pk_bf16_fp4 $0, $1, 1.0 op_sel:[0,1,0]\")","+_ASM_P67 = tl.constexpr(\"v_cvt_scalef32_pk_bf16_fp4 $0, $1, 1.0 op_sel:[1,1,0]\")","+","+","+@triton.jit","+def _cvt_pair(packed_i32, ASM: tl.constexpr):","+    \"\"\"One int32 word -> one int32 holding two packed bf16 (a nibble pair).\"\"\"","+    return tl.inline_asm_elementwise(","+        asm=ASM,","+        constraints=\"=v,v\",","+        args=[packed_i32],","+        dtype=tl.int32,","+        is_pure=True,","+        pack=1,","+    )","+","+","+@triton.jit","+def _split_pair(pair):","+    \"\"\"int32 of two packed bf16 -> (low fp32, high fp32).","+","+    A bf16 occupies the *top* 16 bits of the matching fp32, so the low bf16 is","+    recovered by shifting it up and the high one by masking in place.","+    \"\"\"","+    lo = (pair << 16).to(tl.float32, bitcast=True)","+    # -65536 is 0xFFFF0000 as a signed int32; the unsigned literal is out of","+    # range for the type Triton infers here.","+    hi = (pair & -65536).to(tl.float32, bitcast=True)","+    return lo, hi","+","+","+@triton.jit","+def unpack_mxfp4_tile_hw(","+    packed_i32,  # [BLOCK_K, LATENT // 8] int32 view of the row's data region","+    encoded_scales,  # [BLOCK_K, LATENT // GROUP] uint8","+    BLOCK_K: tl.constexpr,","+    LATENT: tl.constexpr,","+    GROUP: tl.constexpr,","+):","+    \"\"\"Packed MXFP4 -> bf16 [BLOCK_K, LATENT], using the hardware converter.","+","+    Four instructions cover all eight nibbles of each int32 word, in natural","+    order: value `j` of word `w` is latent dim `8w + j`.","+    \"\"\"","+    v0, v1 = _split_pair(_cvt_pair(packed_i32, _ASM_P01))","+    v2, v3 = _split_pair(_cvt_pair(packed_i32, _ASM_P23))","+    v4, v5 = _split_pair(_cvt_pair(packed_i32, _ASM_P45))","+    v6, v7 = _split_pair(_cvt_pair(packed_i32, _ASM_P67))","+","+    # Assemble so that out[8w + j] == vj[w]. Splitting the target index by the","+    # bits of j gives a bit-reversed interleave tree: pairing stride-4 tensors","+    # first, then stride-2, then stride-1.","+    even = tl.interleave(tl.interleave(v0, v4), tl.interleave(v2, v6))","+    odd = tl.interleave(tl.interleave(v1, v5), tl.interleave(v3, v7))","+    values = tl.interleave(even, odd)  # [BLOCK_K, LATENT]","+","+    scales = tl.broadcast_to(","+        encoded_scales[:, :, None], (BLOCK_K, LATENT // GROUP, GROUP)","+    ).reshape(BLOCK_K, LATENT)","+    return _apply_e8m0_scale(values, scales).to(tl.bfloat16)","+","+","+@triton.jit","+def unpack_mxfp4_tile(","+    packed,  # [BLOCK_K, LATENT // 2] uint8","+    encoded_scales,  # [BLOCK_K, LATENT // GROUP] uint8","+    BLOCK_K: tl.constexpr,","+    LATENT: tl.constexpr,","+    GROUP: tl.constexpr,","+):","+    \"\"\"Packed MXFP4 tile -> bf16 `[BLOCK_K, LATENT]` in latent order.","+","+    The low nibble holds the lower element index, so the two nibble streams are","+    interleaved back into value order rather than concatenated.","+    \"\"\"","+    low = _e2m1_inline((packed & 0x0F).to(tl.int32))","+    high = _e2m1_inline(((packed >> 4) & 0x0F).to(tl.int32))","+    values = tl.interleave(low, high)  # [BLOCK_K, LATENT]","+","+    # Broadcast the per-group scale byte across its 32 values, then apply it as","+    # an exponent add rather than an exp2 and a multiply.","+    scales = tl.broadcast_to(","+        encoded_scales[:, :, None], (BLOCK_K, LATENT // GROUP, GROUP)","+    ).reshape(BLOCK_K, LATENT)","+    return _apply_e8m0_scale(values, scales).to(tl.bfloat16)","+","+","+@triton.jit","+def load_mxfp4_rows(","+    cache_ptr, slots, valid, row_pitch, BLOCK_K: tl.constexpr, LATENT: tl.constexpr","+):","+    \"\"\"Gather BLOCK_K packed rows as a bf16 [BLOCK_K, LATENT] tile, using the","+    gfx950 hardware unpack where available.\"\"\"","+    return _load_mxfp4_rows(","+        cache_ptr, slots, valid, row_pitch, BLOCK_K, LATENT, _HW_UNPACK","+    )","+","+","+@triton.jit","+def _load_mxfp4_rows("],"additions":152,"deletions":0,"truncated":false}],"additions":648,"deletions":5,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-12T17:13:20.700559+00:00"}