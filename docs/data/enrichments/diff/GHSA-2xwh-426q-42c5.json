)"," "," \texecutionCache := &model.ExecutionCache{","-\t\tExecutionCacheKey: \"f5fe913be7a4516ebfe1b5de29bcb35edd12ecc776b2f33f10ca19709ea3b2f0\",","+\t\tNamespace:         \"default\",","+\t\tExecutionCacheKey: \"5ea9e9f07d01e21f5bbda698d3bb7d29db34b6f7462e796e8832718d336b410f\","," \t\tExecutionOutput:   \"testOutput\","," \t\tExecutionTemplate: `{\"container\":{\"command\":[\"echo\", \"Hello\"],\"image\":\"python:3.11\"},\"nodeSelector\":{\"disktype\":\"ssd\"}}`,"," \t\tMaxCacheStaleness: -1,","@@ -239,7 +243,8 @@ func TestCacheNodeRestriction(t *testing.T) {"," "," func TestMutatePodIfCachedWithTeamplateCleanup(t *testing.T) {"," \texecutionCache := &model.ExecutionCache{","-\t\tExecutionCacheKey: \"4b868c5d0b64e4d93e529eadaa04f0451eb5ae5c652dd79c08bdc47a6a1fe67a\",","+\t\tNamespace:         \"default\",","+\t\tExecutionCacheKey: \"71ad0d3873235ed88b5a3a2934b82cc180987e3a5a4107f8cb42bffe2de6cf64\","," \t\tExecutionOutput:   \"testOutput\","," \t\tExecutionTemplate: `Cache key was calculated from this: {\"container\":{\"command\":[\"echo\", \"Hello\"],\"image\":\"python:3.11\"},\"outputs\":\"anything\"}`,"," \t\tMaxCacheStaleness: -1,"],"additions":10,"deletions":5,"truncated":false},{"path":"backend/src/cache/server/namespace_isolation_test.go","lines":["@@ -0,0 +1,179 @@","+// Copyright 2026 The Kubeflow Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+// https://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package server","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\t\"github.com/kubeflow/pipelines/backend/src/cache/model\"","+\t\"github.com/kubeflow/pipelines/backend/src/common/util\"","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+)","+","+func namespaceCacheManager(t *testing.T) *FakeClientManager {","+\tt.Helper()","+\tm := NewFakeClientManagerOrFatal(util.NewFakeTimeForEpoch())","+\tt.Cleanup(func() { require.NoError(t, m.Close()) })","+\treturn m","+}","+","+func cachePod(namespace string) *corev1.Pod {","+\tp := fakePod.DeepCopy()","+\tp.Namespace = namespace","+\tp.Name = \"cache-step\"","+\tp.Labels[CacheIDLabelKey] = \"\"","+\tp.Status.Phase = corev1.PodSucceeded","+\tp.Annotations[ArgoWorkflowOutputs] = `{\"parameters\":[{\"name\":\"result\",\"value\":\"tenant-output\"}]}`","+\treturn p","+}","+","+// admitCachePod uses the production admission handler and applies the metadata patches.","+func admitCachePod(t *testing.T, p *corev1.Pod, m *FakeClientManager) bool {","+\tt.Helper()","+\treq := GetFakeRequestFromPod(p)","+\treq.Namespace = p.Namespace","+\tpatches, err := MutatePodIfCached(req, m)","+\trequire.NoError(t, err)","+\thit := false","+\tfor _, patch := range patches {","+\t\tswitch patch.Path {","+\t\tcase AnnotationPath:","+\t\t\tp.Annotations = patch.Value.(map[string]string)","+\t\tcase LabelPath:","+\t\t\tp.Labels = patch.Value.(map[string]string)","+\t\t}","+\t\tif patch.Op == OperationTypeReplace {","+\t\t\thit = true","+\t\t}","+\t}","+\treturn hit","+}","+","+func TestCacheNamespaceIsolationThroughWatcherAndAdmission(t *testing.T) {","+\tm := namespaceCacheManager(t)","+\tattacker := cachePod(\"attacker\")","+\tvictim := cachePod(\"victim\")","+\trequire.False(t, admitCachePod(t, attacker, m))","+\trequire.False(t, admitCachePod(t, victim, m))","+\tattackerKey, victimKey := attacker.Annotations[ExecutionKey], victim.Annotations[ExecutionKey]","+\trequire.NotEmpty(t, attackerKey)","+\trequire.NotEqual(t, attackerKey, victimKey)","+","+\t// A tenant changes its mutable key to the victim's deterministic hash.","+\tattacker.Annotations[ExecutionKey] = victimKey","+\trequire.ErrorContains(t, cacheCompletedPod(context.Background(), attacker, m), \"does not match\")","+\tvar rows int64","+\trequire.NoError(t, m.DB().Model(&model.ExecutionCache{}).Count(&rows).Error)","+\trequire.Zero(t, rows)","+\trequire.False(t, admitCachePod(t, cachePod(\"victim\"), m))","+","+\t// Normal completion may populate only the attacker's namespace.","+\tattacker.Annotations[ExecutionKey] = attackerKey","+\trequire.NoError(t, cacheCompletedPod(context.Background(), attacker, m))","+\trequire.NotEmpty(t, attacker.Labels[CacheIDLabelKey])","+\trequire.True(t, admitCachePod(t, cachePod(\"attacker\"), m))","+\trequire.False(t, admitCachePod(t, cachePod(\"victim\"), m))","+","+\t// Victim completion becomes reusable within the victim namespace.","+\tvictim.Annotations[ArgoWorkflowOutputs] = `{\"parameters\":[{\"name\":\"result\",\"value\":\"victim-output\"}]}`","+\trequire.NoError(t, cacheCompletedPod(context.Background(), victim, m))","+\tnextVictim := cachePod(\"victim\")","+\trequire.True(t, admitCachePod(t, nextVictim, m))","+\trequire.Equal(t, victim.Annotations[ArgoWorkflowOutputs], nextVictim.Annotations[ArgoWorkflowOutputs])","+}","+","+func TestCacheWatcherSkipsInvalidIdentityAndExcludedPods(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname      string","+\t\tmutate    func(*corev1.Pod)","+\t\twantError bool","+\t}{","+\t\t{\"missing namespace\", func(p *corev1.Pod) { p.Namespace = \"\" }, true},","+\t\t{\"missing key\", func(p *corev1.Pod) { delete(p.Annotations, ExecutionKey) }, true},","+\t\t{\"malformed template\", func(p *corev1.Pod) { p.Spec.Containers[0].Env[0].Value = \"{\" }, true},","+\t\t{\"missing template\", func(p *corev1.Pod) { p.Spec.Containers[0].Env = nil }, false},","+\t\t{\"no containers\", func(p *corev1.Pod) { p.Spec.Containers = nil }, false},","+\t\t{\"cache disabled\", func(p *corev1.Pod) { delete(p.Labels, KFPCacheEnabledLabelKey) }, false},","+\t\t{\"v2 pod\", func(p *corev1.Pod) { p.Annotations[V2ComponentAnnotationKey] = V2ComponentAnnotationValue }, false},","+\t\t{\"tfx pod\", func(p *corev1.Pod) { p.Labels[SdkTypeLabel] = TfxSdkTypeLabel }, false},","+\t\t{\"unfinished pod\", func(p *corev1.Pod) { p.Status.Phase = corev1.PodRunning }, false},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tm := namespaceCacheManager(t)","+\t\t\tp := cachePod(\"tenant\")","+\t\t\trequire.False(t, admitCachePod(t, p, m))","+\t\t\ttc.mutate(p)","+\t\t\terr := cacheCompletedPod(context.Background(), p, m)","+\t\t\tif tc.wantError {","+\t\t\t\trequire.Error(t, err)","+\t\t\t} else {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t}","+\t\t\tvar rows int64","+\t\t\trequire.NoError(t, m.DB().Model(&model.ExecutionCache{}).Count(&rows).Error)","+\t\t\trequire.Zero(t, rows)","+\t\t})","+\t}","+}","+","+func TestCacheAdmissionSkipsUnknownNamespaceAndMalformedTemplate(t *testing.T) {","+\tfor _, tc := range []struct{ name, requestNamespace, podNamespace, template string }{","+\t\t{\"missing admission namespace\", \"\", \"tenant\", \"{}\"},","+\t\t{\"namespace mismatch\", \"victim\", \"attacker\", \"{}\"},","+\t\t{\"malformed template\", \"tenant\", \"tenant\", \"{\"},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tm := namespaceCacheManager(t)","+\t\t\tp := cachePod(tc.podNamespace)","+\t\t\tp.Spec.Containers[0].Env[0].Value = tc.template","+\t\t\treq := GetFakeRequestFromPod(p)","+\t\t\treq.Namespace = tc.requestNamespace","+\t\t\tpatches, err := MutatePodIfCached(req, m)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Empty(t, patches)","+\t\t})","+\t}","+}","+","+func TestCacheRejectsWrongShapedTemplates(t *testing.T) {","+\tfor _, template := range []string{","+\t\t`null`, `[]`, `\"template\"`,","+\t\t`{\"container\":null}`, `{\"container\":[]}`, `{\"container\":\"image\"}`,","+\t\t`{\"container\":42}`, `{\"container\":true}`,","+\t} {","+\t\tt.Run(template, func(t *testing.T) {","+\t\t\tm := namespaceCacheManager(t)","+\t\t\tp := cachePod(\"tenant\")","+\t\t\tp.Spec.Containers[0].Env[0].Value = template","+\t\t\tkey, err := generateCacheKeyFromTemplate(template, p.Namespace)","+\t\t\trequire.Error(t, err)","+\t\t\trequire.Empty(t, key)","+\t\t\tlegacyKey, err := generateLegacyCacheKeyFromTemplate(template)","+\t\t\trequire.Error(t, err)","+\t\t\trequire.Empty(t, legacyKey)","+\t\t\treq := GetFakeRequestFromPod(p)","+\t\t\treq.Namespace = p.Namespace","+\t\t\tpatches, err := MutatePodIfCached(req, m)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Empty(t, patches)","+\t\t\trequire.Error(t, cacheCompletedPod(context.Background(), p, m))","+\t\t\tvar rows int64","+\t\t\trequire.NoError(t, m.DB().Model(&model.ExecutionCache{}).Count(&rows).Error)","+\t\t\trequire.Zero(t, rows)","+\t\t})","+\t}","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"backend/src/cache/server/watcher.go","lines":["@@ -6,7 +6,6 @@ import ("," \t\"fmt\""," \t\"log\""," \t\"os\"","-\t\"reflect\""," \t\"strconv\""," \t\"time\""," ","@@ -41,71 +40,84 @@ func WatchPods(ctx context.Context, namespaceToWatch string, clientManager Clien"," \t\t}"," "," \t\tfor event := range watcher.ResultChan() {","-\t\t\tpod := reflect.ValueOf(event.Object).Interface().(*corev1.Pod)"," \t\t\tif event.Type == watch.Error {"," \t\t\t\tcontinue"," \t\t\t}","-\t\t\tlog.Printf(\"%s\", (*pod).GetName())","-","-\t\t\tif !isPodCompletedAndSucceeded(pod) {","-\t\t\t\tlog.Printf(\"Pod %s is not completed or not in successful status.\", pod.ObjectMeta.Name)","+\t\t\tpod, ok := event.Object.(*corev1.Pod)","+\t\t\tif !ok {"," \t\t\t\tcontinue"," \t\t\t}","+\t\t\tlog.Printf(\"%s\", (*pod).GetName())"," ","-\t\t\tif isCacheWriten(pod.ObjectMeta.Labels) {","-\t\t\t\tcontinue","+\t\t\tif err := cacheCompletedPod(ctx, pod, clientManager); err != nil {","+\t\t\t\tlog.Printf(\"%s\", err.Error())"," \t\t\t}","+\t\t}","+\t}","+}"," ","-\t\t\texecutionKey, exists := pod.ObjectMeta.Annotations[ExecutionKey]","-\t\t\tif !exists {","-\t\t\t\tcontinue","-\t\t\t}","+// cacheCompletedPod validates a watched pod's cache identity before publishing its outputs.","+func cacheCompletedPod(ctx context.Context, pod *corev1.Pod, clientManager ClientManagerInterface) error {","+\tif !isKFPCacheEnabled(pod) || isTFXPod(pod) || isV2Pod(pod) || !isPodCompletedAndSucceeded(pod) {","+\t\tlog.Printf(\"Pod %s is not eligible for a cache write.\", pod.Name)","+\t\treturn nil","+\t}"," ","-\t\t\texecutionOutput, exists := pod.ObjectMeta.Annotations[ArgoWorkflowOutputs]","+\tif isCacheWriten(pod.Labels) {","+\t\treturn nil","+\t}"," ","-\t\t\texecutionOutputMap := make(map[string]interface{})","-\t\t\texecutionOutputMap[ArgoWorkflowOutputs] = executionOutput","-\t\t\texecutionOutputMap[MetadataExecutionIDKey] = pod.ObjectMeta.Labels[MetadataExecutionIDKey]","-\t\t\texecutionOutputJSON, _ := json.Marshal(executionOutputMap)","+\texecutionTemplate, exists := getArgoTemplate(pod)","+\tif !exists {","+\t\treturn nil"],"additions":20,"deletions":17,"truncated":false}],"additions":544,"deletions":33,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-10T17:04:49.169676+00:00"}