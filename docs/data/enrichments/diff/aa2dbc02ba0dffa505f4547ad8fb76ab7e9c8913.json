 {","+\tt.Parallel()","+","+\tui := cli.NewMockUi()","+\tcmd := &OperatorRaftJoinCommand{BaseCommand: &base.BaseCommand{UI: ui}}","+","+\trequire.Equal(t, 1, cmd.Run([]string{\"provider=aws region=eu-west-1\"}), \"auto-join arguments should be rejected\")","+\trequire.Contains(t, ui.ErrorWriter.String(), \"configure raft.retry_join in the Vault server configuration\", \"the error should explain the supported alternative\")","+}","+","+// TestOperatorRaftJoinCommand_HelpExplainsAutoJoinConfiguration verifies the","+// command help documents that auto-join belongs in server configuration.","+func TestOperatorRaftJoinCommand_HelpExplainsAutoJoinConfiguration(t *testing.T) {","+\tt.Parallel()","+","+\tcmd := &OperatorRaftJoinCommand{BaseCommand: &base.BaseCommand{UI: cli.NewMockUi()}}","+","+\thelp := cmd.Help()","+\trequire.Contains(t, help, \"raft.retry_join\", \"help should name the supported configuration\")","+\trequire.NotContains(t, help, \"auto-join-scheme\", \"help should not advertise removed request flags\")","+\trequire.NotContains(t, help, \"provider=aws\", \"help should not show request-based auto-join\")","+\trequire.Contains(t, help, \"http://127.0.0.2:8200\", \"help should retain the direct leader-address example\")","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"http/sys_raft.go","lines":["@@ -7,7 +7,6 @@ import ("," \t\"context\""," \t\"crypto/tls\""," \t\"errors\"","-\t\"fmt\""," \t\"io\""," \t\"net/http\""," ","@@ -56,6 +55,11 @@ func handleSysRaftJoinPost(core *vault.Core, w http.ResponseWriter, r *http.Requ"," \t\treturn"," \t}"," ","+\tif req.AutoJoin != \"\" {","+\t\trespondError(w, http.StatusBadRequest, errors.New(\"auto-join metadata must be configured using raft.retry_join\"))","+\t\treturn","+\t}","+"," \tif req.NonVoter && !nonVotersAllowed {"," \t\trespondError(w, http.StatusBadRequest, errors.New(\"non-voting nodes not allowed\"))"," \t\treturn","@@ -72,19 +76,11 @@ func handleSysRaftJoinPost(core *vault.Core, w http.Resp