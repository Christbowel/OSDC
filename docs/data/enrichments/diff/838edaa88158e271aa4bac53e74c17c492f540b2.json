ace('\\\\', '/', $file->getPathname());","+","+            if ('php' !== $file->getExtension() || preg_match('{/(?:Tests|Resources)/}', $path)) {","+                continue;","+            }","+","+            $code = file_get_contents($path);","+            $name = $file->getBasename('.php');","+","+            if (str_contains($code, 'class_alias(') && !preg_match('{\\b(?:class|interface|trait|enum)\\s+'.preg_quote($name, '{}').'\\b}', $code)) {","+                $missing[] = substr($path, 1 + \\strlen($root));","+            }","+        }","+","+        sort($missing);","+","+        $this->assertSame([], $missing, 'Composer cannot index a file that declares no class, so these aliases are unreachable with an authoritative class map. Declare the aliased class in an \"if (false)\" block.');","+    }","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Translation/Translator.php","lines":["@@ -16,3 +16,12 @@"," trigger_deprecation('symfony/framework-bundle', '8.2', 'The \"%s\" class is deprecated, use \"%s\" instead.', 'Symfony\\Bundle\\FrameworkBundle\\Translation\\Translator', BaseTranslator::class);"," "," class_alias(BaseTranslator::class, 'Symfony\\Bundle\\FrameworkBundle\\Translation\\Translator');","+","+if (false) {","+    /**","+     * @deprecated since Symfony 8.2, use Symfony\\Component\\Translation\\DependencyInjection\\Translator instead","+     */","+    class Translator","+    {","+    }","+}",""],"additions":9,"deletions":0,"truncated":false}],"additions":236,"deletions":0,"truncated":false,"file_count":22},"error":null,"fetched_at":"2026-09-21T15:30:17.303989+00:00"}