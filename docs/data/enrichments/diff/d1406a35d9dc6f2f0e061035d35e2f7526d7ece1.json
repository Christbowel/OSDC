_ability()` receive natively typed input","-\t * regardless of transport.","+\t * Registered as the `input` argument `sanitize_callback` so request input is coerced","+\t * before any route callback runs, regardless of transport. `check_ability_permissions()`","+\t * and `WP_Ability::execute()` coerce the input again after normalization and validation,","+\t * so schema defaults and values from normalization filters are coerced too."," \t *"," \t * @since 7.1.0"," \t *","-\t * @see WP_REST_Abilities_V1_Run_Controller::coerce_input_to_schema()","+\t * @see WP_Ability::coerce_input()"," \t *"," \t * @param mixed           $input   Raw input extracted from the request."," \t * @param WP_REST_Request $request The request object.","-\t * @return mixed Coerced input, or the raw input when it cannot be safely coerced.","+\t * @return mixed|WP_Error Coerced input, raw input when validation fails, or WP_Error when coercion fails."," \t */"," \tpublic function sanitize_input_for_ability( $input, $request ) {"," \t\t$ability = wp_has_ability( $request['name'] ) ? wp_get_ability( $request['name'] ) : null;","@@ -258,89 +264,12 @@ public function sanitize_input_for_ability( $input, $request ) {"," \t\t\treturn $input;"," \t\t}"," ","-\t\treturn $this->coerce_input_to_schema( $input, $ability );","-\t}","-","-\t/**","-\t * Coerces raw request input to the types declared in the ability input schema.","-\t *","-\t * GET and DELETE deliver every scalar as a string (\"10\", \"true\") and a list as a single","-\t * comma-separated string, so without coercion an ability receives raw strings where its","-\t * schema declares integers, booleans, or arrays.","-\t *","-\t * Coercion never changes what validation accepts. Input is coerced only when","-\t * {@see WP_Ability::validate_input()} already accepts it, and any error surfaced while","-\t * sanitizing falls back to the raw input, so `validate_input()` stays the single authority","-\t * on what is rejected.","-\t *","-\t * @since 7.1.0","-\t *","-\t * @param mixed      $input   Raw input extracted from the request.","-\t * @param WP_Ability $ability The ability being executed.","-\t * @return mixed Coerced input, or the raw input when it cannot be safely coerced.","-\t */","-\tprivate function coerce_input_to_schema( $input, WP_Ability $ability ) {","-\t\tif ( null === $input ) {","-\t\t\treturn $input;","-\t\t}","-","-\t\t$schema = $ability->get_input_schema();","-\t\tif ( empty( $schema ) ) {","-\t\t\treturn $input;","-\t\t}","-","-\t\t/*","-\t\t * Only coerce input that already validates. Sanitizing invalid input can silently","-\t\t * change which values are accepted -- `additionalProperties: false` strips unknown","-\t\t * keys, and a non-numeric string casts to 0 -- so leaving invalid input untouched","-\t\t * lets validate_input() reject it exactly as it does without coercion.","-\t\t *","-\t\t * validate_input() is asked rather than rest_validate_value_from_schema() so that the","-\t\t * `wp_ability_validate_input` filter decides what counts as valid here as well. A filter","-\t\t * that overrides a schema failure accepts the input, so the input is coerced; a filter","-\t\t * that rejects otherwise valid input leaves it untouched for validate_input() to report.","-\t\t */","-\t\tif ( is_wp_error( $ability->validate_input( $input ) ) ) {","-\t\t\treturn $input;","-\t\t}","-","-\t\t$sanitized = rest_sanitize_value_from_schema( $input, $schema, 'input' );","-","-\t\t/*","-\t\t * Sanitizing can still surface an error the lenient validation above did not, such as","-\t\t * items that are unique as strings but collide once cast to integers (`uniqueItems`).","-\t\t * The error may be returned at the top level or nested inside the returned array, so","-\t\t * scan recursively and fall back to the raw input on any error.","-\t\t */","-\t\tif ( $this->input_contains_error( $sanitized ) ) {","+\t\t// Validate before coercion so sanitization cannot rescue invalid input.","+\t\tif ( null === $input || empty( $ability->get_input_schema() ) || is_wp_error( $ability->validate_input( $input ) ) ) {"," \t\t\treturn $input;"," \t\t}"," ","-\t\treturn $sanitized;","-\t}","-","-\t/**","-\t * Determines whether a sanitized value is, or contains, a WP_Error.","-\t *","-\t * @since 7.1.0","-\t *","-\t * @param mixed $value The value to inspect.","-\t * @return bool True if the value is, or contains, a WP_Error.","-\t */","-\tprivate function input_contains_error( $value ): bool {","-\t\tif ( is_wp_error( $value ) ) {","-\t\t\treturn true;","-\t\t}","-","-\t\tif ( is_array( $value ) ) {","-\t\t\tforeach ( $value as $item ) {","-\t\t\t\tif ( $this->input_contains_error( $item ) ) {","-\t\t\t\t\treturn true;","-\t\t\t\t}","-\t\t\t}","-\t\t}","-","-\t\treturn false;","+\t\treturn $ability->coerce_input( $input );"," \t}"," "," \t/**"],"additions":14,"deletions":85,"truncated":false},{"path":"tests/phpunit/tests/abilities-api/wpAbilitiesRegistry.php","lines":["@@ -68,7 +68,7 @@ public function set_up(): void {"," \t\t\t\t'description' => 'The result of adding the two numbers.',"," \t\t\t\t'required'    => true,"," \t\t\t),","-\t\t\t'execute_callback'    => static function ( array $input ): int {","+\t\t\t'execute_callback'    => static function ( array $input ): float {"," \t\t\t\treturn $input['a'] + $input['b'];"," \t\t\t},"," \t\t\t'permission_callback' => static function (): bool {","@@ -348,7 +348,7 @@ public function test_register_with_custom_ability_class_without_execute_callback"," \t\t\t\t'b' => 3,"," \t\t\t)"," \t\t);","-\t\t$this->assertSame( 15, $execute_result, 'Custom do_execute should multiply instead of add.' );","+\t\t$this->assertSame( 15.0, $execute_result, 'Custom do_execute should multiply instead of add.' );"," \t}"," "," \t/**","@@ -679,7 +679,7 @@ static function ( $args ) use ( &$was_filter_callback_fired ) {"," \t\t);"," "," \t\t$this->assertTrue( $was_filter_callback_fired, 'The execute callback defined in the filter was not fired.' );","-\t\t$this->