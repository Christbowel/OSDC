n purpose, from a route that expects a token in its URL.","+  it('does not redirect while Ghost reports the session still works', async () => {","+    const handleSessionExpiry = await signedIn();","+","+    await handleSessionExpiry(","+      'http://localhost:3000/ghost/api/admin/schedules/posts/1/',","+      unauthorized(),","+    );","+    await handleSessionExpiry(POSTS, expiredSession());","+","+    expect(window.location.replace).not.toHaveBeenCalled();","+  });","+","+  it('does not redirect when the session check gets no response', async () => {","+    const handleSessionExpiry = await signedIn();","+    server.use(http.get(USERS_ME, () => HttpResponse.error()));","+","+    await handleSessionExpiry(POSTS, unauthorized());","+","+    expect(window.location.replace).not.toHaveBeenCalled();","+  });","+","+  it('gives up on a session check that doesn’t answer in time, without redirecting', async () => {","+    const handleSessionExpiry = await signedIn();","+    const timeout = new AbortController();","+    const timeoutFor = vi.spyOn(AbortSignal, 'timeout').mockReturnValue(timeout.signal);","+    server.use(http.get(USERS_ME, () => new Promise<Response>(() => {})));","+","+    try {","+      const handled = handleSessionExpiry(POSTS, unauthorized());","+      await vi.waitFor(() => expect(timeoutFor).toHaveBeenCalledWith(10_000));","+      timeout.abort(new DOMException('The session check timed out', 'TimeoutError'));","+      await handled;","+    } finally {","+      timeoutFor.mockRestore();","+    }","+","+    expect(window.location.replace).not.toHaveBeenCalled();","+  });","+","+  it('redirects only once across several expired responses, checking the session once', async () => {"],"additions":93,"deletions":1,"truncated":false}],"additions":495,"deletions":31,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-21T13:27:33.372548+00:00"}