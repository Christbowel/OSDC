+    assert_eq!(strict.tarball_authorization(first, \"pkg\")(first), None);","+    assert_eq!(global.auth_headers.tarball_authorization(first, \"node@runtime:1\")(first), None);","+    assert_eq!(authorize(\"http://other.example/npm/pkg.tgz\"), None);","+","+    let project = load_with_auth_file(STORED_LOGIN, Some(routes));","+    assert_eq!(project.auth_headers.tarball_authorization(first, \"pkg\")(first), None);","+    let project_ini =","+        load_with_auth_file_and_npmrc(STORED_LOGIN, \"registry=http://private.example/npm/\");","+    assert_eq!(project_ini.auth_headers.tarball_authorization(first, \"pkg\")(first), None);","+    let https = \"https://private.example/npm/pkg.tgz\";","+    assert_eq!(global.auth_headers.tarball_authorization(https, \"pkg\")(first), None);","+}","+","+#[test]","+fn http_tarball_auth_uses_only_effective_trusted_registry_aliases() {","+    let alias = \"namedRegistries:\\n  custom: http://private.example/npm/\\n\";","+    let first = \"http://private.example/npm/pkg.tgz\";","+    let accepted = load_with_auth_file(&format!(\"{STORED_LOGIN}{alias}\"), None);","+    assert_eq!(","+        accepted.auth_headers.tarball_authorization(first, \"pkg\")(first).as_deref(),","+        Some(\"Bearer stored-token\"),","+    );","+","+    for declarations in [","+        \"registries:\\n  http://private.example/npm/: { ecosystem: pypi }\\n\",","+        \"registries:\\n  https://canonical.example/: { prefix: custom }\\n\",","+    ] {","+        let config = load_with_auth_file(&format!(\"{STORED_LOGIN}{declarations}{alias}\"), None);","+        assert_eq!(config.auth_headers.tarball_authorization(first, \"pkg\")(first), None);","+    }","+    let project = load_with_auth_file(STORED_LOGIN, Some(alias));","+    assert_eq!(project.auth_headers.tarball_authorization(first, \"pkg\")(first), None);","+}","+","+#[test]","+fn both_user_auth_files_can_declare_http_registries() {","+    fake_env!(load_with_fake_env);","+    let root = tempdir().unwrap(