{"id":"ab6906ae82ea5a3d57b9725cbefd9a3c567c1e02","axis":"silent","repo":"pnpm/pnpm","sha":"ab6906ae82ea5a3d57b9725cbefd9a3c567c1e02","parsed":{"files":[{"path":".changeset/http-registry-tarball-auth.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": minor","+---","+","+Package tarball downloads can use credentials over plain HTTP when the user's global settings explicitly declare the HTTP registry URL [#18427](https://github.com/pnpm/pnpm/issues/18427)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/auth_sources.rs","lines":["@@ -82,6 +82,12 @@ pub(super) fn npmrc_source<Sys: FsReadFile>("," "," fn parse_trusted_source<Sys: EnvVar>(text: &str, dir: &Path, path: &Path) -> NpmrcAuth {","     let mut auth = NpmrcAuth::from_ini::<Sys>(text, dir);","+    auth.routes.trusted_http_registries = auth.routes.default","+        .iter()","+        .chain(auth.routes.scoped.values())","+        .filter(|url| is_http_registry(url))","+        .cloned()","+        .collect();","     auth.rescope_unscoped(&path.display().to_string());","     auth"," }","@@ -147,6 +153,50 @@ pub(super) fn note_declared_registries(","     }"," }"," ","+fn npm_registry_urls(settings: &WorkspaceSettings) -> impl Iterator<Item = &String> {","+    use crate::workspace_yaml::registries::{","+        Ecosystem,","+        RegistryEntry,","+    };","+","+    let declared = settings.registries","+        .iter()","+        .flatten()","+        .filter_map(|(key, entry)| match entry {","+            RegistryEntry::ScopeRoute(url) => Some(url),","+            RegistryEntry::Declaration(declaration)","+                if declaration.ecosystem() == Ecosystem::Npm =>","+            {","+                Some(key)","+            }","+            RegistryEntry::Declaration(_) => None,","+        });","+    settings.registry.iter().chain(declared)","+}","+","+fn is_http_registry(url: &str) -> bool {","+    url.split_once(\"://\")","+        .is_some_and(|(scheme, _)| scheme.eq_ignore