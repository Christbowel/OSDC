ries, settings);","+        sources.npmrc_auth.routes.trusted_http_registries.clone_from(registries);","+        Ok(sources)","     }"," ","     /// The global `config.yaml` settings that name credential sources. A"],"additions":66,"deletions":4,"truncated":false},{"path":"pnpm/crates/config/src/derive_layout.rs","lines":["@@ -255,6 +255,15 @@ impl Config {","         // so this is independent of the final `config.registry` (which","         // yaml may have overridden), the security boundary holds even","         // when the workspace points the default registry elsewhere.","+        // A workspace-selected proxy must not receive the user's cleartext credentials.","+        if !npmrc_auth.routes.trusted_http_registries.is_empty()","+            && self.proxy != self.package_manager_bootstrap.proxy","+        {","+            tracing::debug!(","+                \"HTTP tarball credentials withheld because the project overrides the user proxy settings\",","+            );","+            npmrc_auth.routes.trusted_http_registries.clear();","+        }","         std::mem::take(npmrc_auth).build_auth_headers(self)?;"," ","         // Re-resolve `store_dir` against the project's volume when no"],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/global_packages.rs","lines":["@@ -56,6 +56,8 @@ impl Config {","         explicit.note(&settings);","         note_declared_registries(declared_registries, &settings);","         collect_explicit_settings(&mut self.explicit_settings, &settings);","+        let bootstrap = &mut self.package_manager_bootstrap;","+        settings.apply_proxy_to(&mut bootstrap.proxy, &mut bootstrap.proxy_keys);","         let saved_workspace_dir = self.workspace_dir.take();","         let base_dir = self.dir.clone();","         settings.apply_to(self, &base_dir);"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/npmrc_auth.rs","lines":["@@ -144,6 +144,7 @@ pub(crate) struct NpmrcTls {"," "," 