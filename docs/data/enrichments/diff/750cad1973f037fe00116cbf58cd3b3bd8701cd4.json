 pytest -s -v evals/gsm8k/test_gsm8k_correctness.py --config-list-file=configs/models-spec-decode-rocm.txt"," ","+- label: \":nvidia: (B200) [Nightly] LM Eval ReplaySSM\"","+  key: lm-eval-replayssm-2xb200","+  timeout_in_minutes: 60","+  device: b200-k8s","+  optional: true","+  num_devices: 2","+  source_file_dependencies:","+  - .buildkite/test_areas/lm_eval.yaml","+  - tests/evals/gsm8k/configs/models-replayssm.txt","+  - tests/evals/gsm8k/configs/Nemotron-3-Super-120B-A12B-NVFP4-ReplaySSM-align.yaml","+  - tests/evals/gsm8k/test_gsm8k_correctness.py","+  - tests/evals/gsm8k/gsm8k_eval.py","+  - tests/evals/gsm8k/conftest.py","+  - vllm/model_executor/layers/mamba/abstract.py","+  - vllm/model_executor/layers/mamba/mamba_mixer2.py","+  - vllm/model_executor/layers/mamba/ops/ssu_dispatch.py","+  - vllm/model_executor/layers/mamba/ops/replayssm_config.py","+  - vllm/model_executor/warmup/kernel_warmup.py","+  - vllm/model_executor/warmup/replayssm_warmup.py","+  - vllm/v1/attention/backends/mamba_attn.py","+  - vllm/v1/worker/mamba_utils.py","+  - vllm/v1/worker/replayssm_utils.py","+  - vllm/v1/worker/gpu/model_states/mamba_hybrid.py","+  commands:","+  - pytest -s -v evals/gsm8k/test_gsm8k_correctness.py --config-list-file=configs/models-replayssm.txt","+"," - label: \":nvidia: (B200) [Nightly] LM Eval Large Models EP\"","   key: lm-eval-large-models-ep-2xb200","   automatic_shard: true"],"additions":26,"deletions":0,"truncated":false},{"path":"docs/features/automatic_prefix_caching.md","lines":["@@ -34,6 +34,37 @@ vllm serve <hybrid-model> \\"," "," Choose a value that divides the block size of every prefix-cacheable KV cache group, and that is a multiple of the per-state compression ratio for models that use one, such as sparse MLA. vLLM validates both at startup and names the offending sizes in the error. Read the served block size from the startup log. 64 is a reasonable starting point."," ","+### FlashInfer ReplaySSM","+","+FlashInfer ReplaySSM caches recent inputs to reduce full-state writes during Mamba2 decoding. It is disabled by default. Both Model Runners V1 and V2 support prefix caching with ReplaySSM, including MTP speculative decoding.","+","+This example enables ReplaySSM and prefix caching with three MTP draft tokens:","+","+```bash","+VLLM_USE_V2_MODEL_RUNNER=1 vllm serve nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 \\","+    --tensor-parallel-size 2 \\","+    --max-model-len 12288 \\","+    --dtype bfloat16 \\","+    --mamba-backend flashinfer \\","+    --mamba-ssm-cache-dtype float16 \\","+    --enable-mamba-cache-stochastic-rounding \\","+    --mamba-cache-philox-rounds 5 \\","+    --use-replayssm \\","+    --replayssm-buffer-len 16 \\","+    --enable-prefix-caching \\","+    --speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":3}'","+```","+","+`--enable-prefix-caching` selects Mamba cache mode `align`. To use ReplaySSM without prefix caching, replace this flag with `--no-enable-prefix-caching`. This selects mode `none`. To disable speculative decoding, remove `--speculative-config`.","+","+FlashInfer ReplaySSM has these limits:","+","+- `align` requires BF16 model inputs for its replay rings. The SSM state dtype is independent. The example uses FP16 state with stochastic rounding.","+- The logical replay buffer cannot exceed 16 tokens. For speculative decoding, it must contain at least `1 + num_speculative_tokens` tokens.","+- Pipeline parallelism, microbatching, and KV connectors are not supported.","+","+Prefix reuse still requires a shared prefix with a saved Mamba checkpoint. The matching rules for hybrid Mamba models above also apply.","+"," ## Example workloads"," "," We describe two example workloads, where APC can provide huge performance benefit:"],"additions":31,"deletions":0,"truncated":false},{"path":"tests/evals/gsm8k/configs/Nemotron-3-Super-120B-A12B-NVFP4-ReplaySSM-align.yaml","lines":["@@ -0,0 +1,27 @@","+model_name: \"nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4\"","+accuracy_threshold: 0.93","+num_questions: 1319","+num_fewshot: 5","+startup_max_wait_seconds: 1200","+# Require draft steps and report natural acceptance without a performance bound.","+min_acceptance_length: 1.0","+expect_prefix_cache_hits: true","+env:","+  VLLM_USE_V2_MODEL_RUNNER: \"1\"","+# 327 divides each 5232-token page and preserves the shared 654-token boundary.","+server_args: >-","+  --enforce-eager","+  --max-model-len 4096","+  --tensor-parallel-size 2","+  --enable-expert-parallel","+  --dtype bfloat16","+  --mamba-backend flashinfer","+  --mamba-ssm-cache-dtype float16","+  --enable-mamba-cache-stochastic-rounding","+  --mamba-cache-philox-rounds 5","+  --use-replayssm","+  --replayssm-buffer-len 16","+  --enable-prefix-caching","+  --prefix-match-unit 327","+  --mamba-cache-mode align","+  --speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":5}'"],"additions":27,"deletions":0,"truncated":false},{"path":"tests/evals/gsm8k/configs/models-replayssm.txt","lines":["@@ -0,0 +1 @@","+Nemotron-3-Super-120B-A12B-NVFP4-ReplaySSM-align.yaml"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/evals/gsm8k/test_gsm8k_correctness.py","lines":["@@ -87,6 +87,28 @@ def get_acceptance_length(server_url: str) -> float:","     return 1.0 + num_accepted / num_drafts"," "," ","+def check_prefix_cache_hits(server_url: str, expected: bool) -> None:","+    \"\"\"Check that the evaluated requests exercised the configured cache mode.\"\"\"","+    response = requests.get(f\"{server_url.rstrip('/').removesuffix('/v1')}/metrics\")","+    response.raise_for_status()","+    hits = []","+    for line in response.text.splitlines():","+        name, _, value = line.rpartition(\" \")","+        if name.split(\"{\")[0] == \"vllm:prefix_cache_hits_total\":","+            hits.append(float(value))","+    assert hits, \"prefix-cache hit metric is missing\"","+    total_hits = sum(hits)","+    print(f\"  Prefix-cache hit tokens: {total_hits:g}\")","+    if expected:","+        assert total_hits > 0, (","+            \"prefix caching was enabled but no cached tokens were reused\"","+        )","+    else:","+        assert total_hits == 0, (","+            \"prefix caching was disabled but cached tokens were reused\"","+        )","+","+"," def test_gsm8k_correctness(config_filename):","     \"\"\"Test GSM8K correctness for a given model configuration.\"\"\"","     eval_config = yaml.safe_load(config_filename.read_text(encoding=\"utf-8\"))","@@ -189,6 +211,8 @@ def test_gsm8k_correctness(config_filename):","             assert results and not any(results), f\"{method} failed: {results}\""," ","         results = run_gsm8k_eval(eval_config, server_url)","+        if \"expect_prefix_cache_hits\" in eval_config:","+            check_prefix_cache_hits(server_url, eval_config[\"expect_prefix_cache_hits\"])"," ","         measured_metric = results[\"accuracy\"]","         expected_metric = eval_config[\"accuracy_threshold\"]"],"additions":24,"deletions":0,"truncated":false},{"path":"tests/kernels/mamba/test_precopy_mamba_align.py","lines":["@@ -336,6 +336,7 @@ def __init__(self, n):","         self.mamba_state_idx_buf = _FakeCpuGpuBuffer(n)","         self.precopy_src_col_buf = _FakeCpuGpuBuffer(n)","         self.precopy_token_bias_buf = _FakeCpuGpuBuffer(n)","+        self.replayssm = None","         self.calls = []"," ","     def initialize_from_forward_context(self, *args, **kwargs):"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/kernels/mamba/test_replayssm_plan.py","lines":["@@ -11,10 +11,7 @@"," import pytest"," import torch"," ","-from vllm.model_executor.layers.mamba.ops.ssu_dispatch import (","-    plan_replayssm_decode,","-    reset_replayssm_ring_trackers,","-)","+from vllm.model_executor.layers.mamba.ops.ssu_dispatch import plan_replayssm_decode"," from vllm.platforms import current_platform"," from vllm.v1.attention.backends.utils import NULL_BLOCK_ID"," ","@@ -44,25 +41,13 @@ class _Planner