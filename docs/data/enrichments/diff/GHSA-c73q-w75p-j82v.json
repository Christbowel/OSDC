{"id":"GHSA-c73q-w75p-j82v","axis":"advisories","repo":"authlib/authlib","sha":"1bd2a313492ce0a4d0571c150730907aa3fc91ff","parsed":{"files":[{"path":"authlib/oauth2/rfc7592/endpoint.py","lines":["@@ -39,6 +39,11 @@ def create_configuration_response(self, request):","                 status_code=401, description=\"The client does not exist on this server.\"","             )"," ","+        # The registration access token is only valid for the client it was","+        # issued to.","+        if not token.check_client(client):","+            raise AccessDeniedError()","+","         if not self.check_permission(client, request):","             # If the client does not have permission to read its record, the server","             # MUST return an HTTP 403 Forbidden.","@@ -146,25 +151,35 @@ def generate_client_registration_info(self, client, request):{","         raise NotImplementedError()"," ","     def authenticate_token(self, request):","-        \"\"\"Authenticate current credential who is requesting to register a client.","+        \"\"\"Authenticate the registration access token of the request.","         Developers MUST implement this method in subclass::"," ","             def authenticate_token(self, request):","                 auth = request.headers.get(\"Authorization\")","                 return get_token_by_auth(auth)"," ","+        The token MUST implement","+        :meth:`~authlib.oauth2.rfc6749.TokenMixin.check_client`. Requests","+        are denied when the token was not issued to the requested client.","+","         :return: token instance","         \"\"\"","         raise NotImplementedError()"," ","     def authenticate_client(self, request):","-        \"\"\"Read a client from the request payload.","+        \"\"\"Read the client from the client configuration endpoint URL.","         Developers MUST implement this method in subclass::"," ","+            from urllib.parse import urlparse","+","+","             def authenticate_client(self, request):","-                client_id = request.payload.data.get(\"client_id\")","+                path = urlparse(request.uri).path","+                client_id = path.rstrip(\"/\").rsplit(\"/\", 1)[-1]","                 return Client.get(client_id=client_id)"," ","+        The route parameter of the web framework can also be used.","+","         :return: client instance","         \"\"\"","         raise NotImplementedError()"],"additions":18,"deletions":3,"truncated":false},{"path":"docs/oauth2/specs/rfc7592.rst","lines":["@@ -18,8 +18,16 @@ of :ref:`specs/rfc7591`."," Client Configuration Endpoint"," -----------------------------"," ","+The endpoint URL identifies the client, for instance","+``/oauth/register/<client_id>``. The registration access token returned by the","+:ref:`specs/rfc7591` registration endpoint is only valid for this client. The","+endpoint calls :meth:`~authlib.oauth2.rfc6749.TokenMixin.check_client` on the","+token, and denies the request when the token was issued to another client.","+"," Before register the endpoint, developers MUST implement the missing methods::"," ","+    from urllib.parse import urlparse","+","     from authlib.oauth2.rfc7592 import ClientConfigurationEndpoint"," "," ","@@ -33,7 +41,11 @@ Before register the endpoint, developers MUST implement the missing methods::","             return token"," ","         def authenticate_client(self, request):","-            client_id = request.payload.data.get('client_id')","+            # read the client_id from the endpoint URL, not from the body:","+            # GET and DELETE requests have no body.","+            # The route parameter of the web framework can also be used.","+            path = urlparse(request.uri).path","+            client_id = path.rstrip('/').rsplit('/', 1)[-1]","             return Client.get(client_id=client_id)"," ","         def revoke_access_token(self, token, request):","@@ -46,13 +58,8 @@ Before register the endpoint, developers MUST implement the missing methods::","         def delete_client(self, client, request):","             client.delete()"," ","-        def save_client(self, client_info, client_metadata, request):","-            client = OAuthClient(","-                user_id=request.credential.user_id,","-                client_id=client_info['client_id'],","-                client_secret=client_info['client_secret'],","-                **client_metadata,","-            )","+        def update_client(self, client, client_metadata, request):","+            client.set_client_metadata(client_metadata)","             client.save()","             return client"," "],"additions":15,"deletions":8,"truncated":false},{"path":"tests/flask/test_oauth2/test_client_configuration_endpoint.py","lines":["@@ -141,6 +141,8 @@ def test_read_unauthorized_client(test_client, token):","         client_secret=\"unauthorized_client_secret\",","     )","     db.session.add(client)","+    token.client_id = \"unauthorized_client_id\"","+    db.session.add(token)"," ","     headers = {\"Authorization\": f\"bearer {token.access_token}\"}","     rv = test_client.get(\"/configure_client/unauthorized_client_id\", headers=headers)","@@ -267,6 +269,8 @@ def test_update_unauthorized_client(test_client, token):","         client_secret=\"unauthorized_client_secret\",","     )","     db.session.add(client)","+    token.client_id = \"unauthorized_client_id\"","+    db.session.add(token)"," ","     headers = {\"Authorization\": f\"bearer {token.access_token}\"}","     rv = test_client.put(","@@ -487,9 +491,54 @@ def test_delete_unauthorized_client(test_client, token):","         client_secret=\"unauthorized_client_secret\",","     )","     db.session.add(client)","+    token.client_id = \"unauthorized_client_id\"","+    db.session.add(token)"," ","     headers = {\"Authorization\": f\"bearer {token.access_token}\"}","     rv = test_client.delete(\"/configure_client/unauthorized_client_id\", headers=headers)","     resp = json.loads(rv.data)","     assert rv.status_code == 403","     assert resp[\"error\"] == \"unauthorized_client\"","+","+","+@pytest.fixture","+def other_client(db):","+    client = Client(client_id=\"other-client-id\", client_secret=\"other-client-secret\")","+    client.set_client_metadata({\"client_name\": \"Other\"})","+    db.session.add(client)","+    db.session.commit()","+    yield client","+    db.session.delete(client)","+","+","+def test_read_token_of_another_client(test_client, other_client, token):","+    \"\"\"A registration access token cannot read another client.\"\"\"","+    headers = {\"Authorization\": f\"bearer {token.access_token}\"}","+    rv = test_client.get(\"/configure_client/other-client-id\", headers=headers)","+    resp = json.loads(rv.data)","+    assert rv.status_code == 400","+    assert resp[\"error\"] == \"access_denied\"","+    assert \"client_secret\" not in resp","+","+","+def test_update_token_of_another_client(test_client, other_client, token):","+    \"\"\"A registration access token cannot update another client.\"\"\"","+    headers = {\"Authorization\": f\"bearer {token.access_token}\"}","+    body = {\"client_id\": \"other-client-id\", \"client_name\": \"Hijacked\"}","+    rv = test_client.put(","+        \"/configure_client/other-client-id\", json=body, headers=headers","+    )","+    resp = json.loads(rv.data)","+    assert rv.status_code == 400","+    assert resp[\"error\"] == \"access_denied\"","+    assert other_client.client_name == \"Other\"","+","+","+def test_delete_token_of_another_client(test_client, other_client, token):","+    \"\"\"A registration access token cannot delete another client.\"\"\"","+    headers = {\"Authorization\": f\"bearer {token.access_token}\"}","+    rv = test_client.delete(\"/configure_client/other-client-id\", headers=headers)","+    resp = json.loads(rv.data)","+    assert rv.status_code == 400","+    assert resp[\"error\"] == \"access_denied\"","+    assert Client.query.filter_by(client_id=\"other-client-id\").first()",""],"additions":49,"deletions":0,"truncated":false}],"additions":82,"deletions":11,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-31T14:35:19.731993+00:00"}