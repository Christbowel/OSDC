{"id":"d846616dd9b6551f7fb7d0e3741afbc16f368aed","axis":"silent","repo":"mongodb/mongo","sha":"d846616dd9b6551f7fb7d0e3741afbc16f368aed","parsed":{"files":[{"path":"jstests/with_mongot/e2e/search_disallowed_on_timeseries.js","lines":["@@ -7,6 +7,7 @@"," "," import {assertArrayEq} from \"jstests/aggregation/extras/utils.js\";"," import {assertDropCollection} from \"jstests/libs/collection_drop_recreate.js\";","+import {FixtureHelpers} from \"jstests/libs/fixture_helpers.js\";"," import {","     expectCreateSearchIndexFails,","     expectDropSearchIndexFails,","@@ -206,6 +207,75 @@ assert.commandWorked(bulk.execute());","     assert.eq(results, [], \"Expected no search indexes for timeseries collection\");"," })();"," ","+// The timeseries ban on search index commands must also apply when the command is","+// addressed to a view that resolves to a timeseries collection. The ban should be","+// evaluated against the resolved namespace, not just the namespace named in the request.","+(function testSearchIndexCommandsDisallowedOnViewOverTsCollection() {","+    const viewName = \"viewon_\" + timeseriesCollName;","+    assertDropCollection(db, viewName);","+    assert.commandWorked(db.createView(viewName, timeseriesCollName, []));","+    const viewColl = db.getCollection(viewName);","+","+    const tsSearchIndexName = \"tsSearchIndexViaView\";","+    let searchIndexDef = {","+        mappings: {dynamic: true, fields: {}},","+    };","+","+    // Which component rejects depends on the topology: through a mongos the router rejects","+    // via the isTimeseries field of the _shardsvrResolveView reply, while on a mongod the","+    // ban is enforced by the shard after resolving the view.","+    const expectedCodes = FixtureHelpers.isMongos(db) ? [13717000] : [13717001];","+","+    expectCreateSearchIndexFails(","+        viewColl,","+        {name: tsSearchIndexName, definition: searchIndexDef},","+        expectedCodes,","+    );","+","+    searchIndexDef.storedSource = {","+        exclude: [metaFieldName],","+    };","+    expectUpdateSearchIndexFails(","+        viewColl,","+        {name: tsSearchIndexName, definition: searchIndexDef},","+        expectedCodes,","+    );","+","+    expectDropSearchIndexFails(viewColl, {name: tsSearchIndexName}, expectedCodes);","+","+    // The ban must survive a multi-hop view chain: a view on top of the view above must be","+    // rejected just like the direct view.","+    const nestedViewName = \"nestedviewon_\" + timeseriesCollName;","+    assertDropCollection(db, nestedViewName);","+    assert.commandWorked(db.createView(nestedViewName, viewName, []));","+    const nestedViewColl = db.getCollection(nestedViewName);","+","+    expectCreateSearchIndexFails(","+        nestedViewColl,","+        {name: tsSearchIndexName, definition: searchIndexDef},","+        expectedCodes,","+    );","+","+    expectUpdateSearchIndexFails(","+        nestedViewColl,","+        {name: tsSearchIndexName, definition: searchIndexDef},","+        expectedCodes,","+    );","+","+    expectDropSearchIndexFails(nestedViewColl, {name: tsSearchIndexName}, expectedCodes);","+","+    // $listSearchIndexes should still return an empty array through a view (or a nested view)","+    // on a timeseries collection (the ban does not apply to listing).","+    const results = viewColl.aggregate([{$listSearchIndexes: {}}]).toArray();","+    assert.eq(results, [], \"Expected no search indexes via a view on a timeseries collection\");","+    const nestedResults = nestedViewColl.aggregate([{$listSearchIndexes: {}}]).toArray();","+    assert.eq(","+        nestedResults,","+        [],","+        \"Expected no search indexes via a nested view on a timeseries collection\",","+    );","+})();","+"," // Validates that a $search stage works in a subpipeline when the inner collection is non-timeseries, but the outer collection is timeseries."," (function testSearchAllowedInSubpipelineNonTimeseries() {","     // Create a non-timeseries collection."],"additions":70,"deletions":0,"truncated":false},{"path":"src/mongo/db/commands/shardsvr_resolve_view_command.cpp","lines":["@@ -70,9 +70,12 @@ class ShardSvrResolveViewCommand : public TypedCommand<ShardSvrResolveViewComman","                 view_catalog_helpers::resolveView(opCtx, catalog, nss, boost::none));","             Response res;","             res.setResolvedView(resolvedView);","-            if (auto uuid = catalog->lookupUUIDByNSS(opCtx, resolvedView.getResolvedNamespace())) {","-                res.setCollectionUUID(","-                    catalog->lookupUUIDByNSS(opCtx, resolvedView.getResolvedNamespace()));","+            if (auto coll = catalog->lookupCollectionByNamespace(","+                    opCtx, resolvedView.getResolvedNamespace())) {","+                res.setCollectionUUID(coll->uuid());","+                // Report whether the resolved namespace is a timeseries. This is used by the router","+                // so it can enforce the ban on search index commands on timeseries collections.","+                res.setIsTimeseries(coll->isTimeseriesCollection());","             }"," ","             return res;"],"additions":6,"deletions":3,"truncated":false},{"path":"src/mongo/db/commands/shardsvr_resolve_view_command.idl","lines":["@@ -28,6 +28,10 @@ structs:","             collectionUUID:","                 type: uuid","                 optional: true","+            isTimeseries:","+                description: \"Whether the resolved namespace is a timeseries collection.\"","+                type: bool","+                optional: true","             resolvedView:","                 type: resolved_view","                 optional: true"],"additions":4,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/search/search_index_process_router.cpp","lines":["@@ -38,7 +38,10 @@ namespace {"," // eliminate this race condition and get a single/locked instance of the view graph for each search"," // index command."," StatusWith<std::pair<boost::optional<UUID>, boost::optional<ResolvedNamespace>>> resolveViewHelper(","-    OperationContext* opCtx, const CachedDatabaseInfo& cdb, NamespaceString nss) {","+    OperationContext* opCtx,","+    const CachedDatabaseInfo& cdb,","+    NamespaceString nss,","+    bool failOnTsColl) {"," ","     BSONObjBuilder bob;","     bob.append(\"_shardsvrResolveView\", 1);","@@ -65,6 +68,13 @@ StatusWith<std::pair<boost::optional<UUID>, boost::optional<ResolvedNamespace>>>","     if (data.hasField(\"collectionUUID\")) {","         uuid = boost::make_optional(uassertStatusOK(UUID::parse(data[\"collectionUUID\"])));","     }","+","+    // Apply the timeseries ban to the resolved namespace, not just the namespace named in the","+    // request.","+    uassert(13717000,","+            \"search index commands are not allowed on timeseries collections\",","+            !(failOnTsColl && data.hasField(\"isTimeseries\") && data[\"isTimeseries\"].trueValue()));","+","     return std::make_pair(uuid, resolvedView);"," }"," }  // namespace","@@ -105,7 +115,7 @@ SearchIndexProcessRouter::fetchCollectionUUIDAndResolveView(OperationContext* op"," ","             if (bsonDoc[\"type\"].String() == \"view\") {","                 auto sourceCollection = bsonDoc[\"options\"][\"viewOn\"].String();","-                auto status = resolveViewHelper(opCtx, cdb, nss);","+                auto status = resolveViewHelper(opCtx, cdb, nss, failOnTsColl);","                 return uassertStatusOK(status);","             }"," "],"additions":12,"deletions":2,"truncated":false},{"path":"src/mongo/db/query/search/search_index_process_shard.cpp","lines":["@@ -41,9 +41,22 @@ SearchIndexProcessShard::fetchCollectionUUIDAndResolveView(OperationContext* opC","     } else {","         auto resolvedView =","             view_catalog_helpers::resolveView(opCtx, catalog, nss, boost::none).getValue();","+        auto resolvedNss = resolvedView.getResolvedNamespace();","+        auto resolvedColl = catalog->lookupCollectionByNamespace(opCtx, resolvedNss);"," ","-        return std::make_pair(catalog->lookupUUIDByNSS(opCtx, resolvedView.getResolvedNamespace()),","-                              boost::make_optional(resolvedView));","+        // Double-check the timeseries collection ban now that we've resolved the namespace","+        // (otherwise views could get around it).","+        if (failOnTsColl) {","+            uassert(13717001,","+                    \"search index commands are not allowed on timeseries collections\",","+                    !(resolvedColl && resolvedColl->isTimeseriesCollection()));","+        }","+","+        boost::optional<UUID> resolvedUuid;","+        if (resolvedColl) {","+            resolvedUuid = resolvedColl->uuid();","+        }","+        return std::make_pair(resolvedUuid, boost::make_optional(resolvedView));","     }"," }"," "],"additions":15,"deletions":2,"truncated":false},{"path":"src/mongo/db/s/shardsvr_resolve_view_command_test.cpp","lines":["@@ -91,5 +91,78 @@ TEST_F(ShardsvrResolveViewCommandTest, ValidCommandWithMatchingDBVersion) {","     ASSERT_EQ(response[\"resolvedView\"].Obj()[\"ns\"].str(), nssView.toString_forTest());"," }"," ","+/**","+ * Tests that ShardsvrResolveView reports, via the isTimeseries reply field, when the namespace","+ * resolves to a timeseries collection. The router uses this to reject search index commands","+ * on timeseries.","+ */","+TEST_F(ShardsvrResolveViewCommandTest, ViewOverTimeseriesReportsIsTimeseriesTrue) {","+    OperationContext* opCtx = operationContext();","+","+    const NamespaceString nssTsColl =","+        NamespaceString::createNamespaceString_forTest(dbNameTestDb, \"ts\");","+    const NamespaceString nssTsView =","+        NamespaceString::createNamespaceString_forTest(dbNameTestDb, \"tsview\");","+","+    DBDirectClient client(opCtx);","+    BSONObj response;","+    ASSERT_TRUE(client.runCommand(","+        dbNameTestDb,","+        BSON(\"create\" << nssTsColl.coll() << \"timeseries\" << BSON(\"timeField\" << \"t\")),","+        response));","+    ASSERT_TRUE(client.runCommand(dbNameTestDb,","+                                  BSON(\"create\" << nssTsView.coll() << \"viewOn\" << nssTsColl.coll()","+                                                << \"pipeline\" << BSONArray()),","+                                  response));","+","+    // Resolving a view onto a timeseries collection succeeds, resolves to the timeseries","+    // collection namespace, and reports that the resolved namespace is a timeseries","+    // collection.","+    ShardsvrResolveView cmd(nssTsView);","+    ASSERT_TRUE(client.runCommand(nssTsView.dbName(), cmd.toBSON(), response));","+    ASSERT_EQ(response[\"resolvedView\"].Obj()[\"ns\"].str(), nssTsColl.toString_forTest());","+    ASSERT(response.hasField(\"isTimeseries\"));","+    ASSERT_TRUE(response[\"isTimeseries\"].trueValue());","+","+    // The timeseries collection namespace itself is also reported as a timeseries collection.","+    ShardsvrResolveView cmdTsColl(nssTsColl);","+    ASSERT_TRUE(client.runCommand(nssTsColl.dbName(), cmdTsColl.toBSON(), response));","+    ASSERT(response.hasField(\"isTimeseries\"));","+    ASSERT_TRUE(response[\"isTimeseries\"].trueValue());","+}","+","+/**","+ * Tests that ShardsvrResolveView reports isTimeseries false for a view that resolves to a","+ * normal (non-timeseries) collection.","+ */","+TEST_F(ShardsvrResolveViewCommandTest, ViewOverNormalCollectionReportsIsTimeseriesFalse) {","+    OperationContext* opCtx = operationContext();","+","+    const NamespaceString nssNormalColl =","+        NamespaceString::createNamespaceString_forTest(dbNameTestDb, \"normal\");","+    const NamespaceString nssNormalView =","+        NamespaceString::createNamespaceString_forTest(dbNameTestDb, \"normalview\");","+","+    DBDirectClient client(opCtx);","+    BSONObj response;","+    ASSERT_TRUE(client.runCommand(dbNameTestDb, BSON(\"create\" << nssNormalColl.coll()), response));","+    ASSERT_TRUE(","+        client.runCommand(dbNameTestDb,","+                          BSON(\"create\" << nssNormalView.coll() << \"viewOn\" << nssNormalColl.coll()","+                                        << \"pipeline\" << BSONArray()),","+                          response));","+","+    ShardsvrResolveView cmd(nssNormalView);","+    ASSERT_TRUE(client.runCommand(nssNormalView.dbName(), cmd.toBSON(), response));","+    ASSERT_EQ(response[\"resolvedView\"].Obj()[\"ns\"].str(), nssNormalColl.toString_forTest());","+    ASSERT(response.hasField(\"isTimeseries\"));","+    ASSERT_FALSE(response[\"isTimeseries\"].trueValue());","+","+    ShardsvrResolveView cmdColl(nssNormalColl);","+    ASSERT_TRUE(client.runCommand(nssNormalColl.dbName(), cmdColl.toBSON(), response));","+    ASSERT(response.hasField(\"isTimeseries\"));","+    ASSERT_FALSE(response[\"isTimeseries\"].trueValue());","+}","+"," }  // namespace"," }  // namespace mongo",""],"additions":73,"deletions":0,"truncated":false}],"additions":180,"deletions":7,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-30T15:57:10.322233+00:00"}