: &'a str,","     raw: &'a str,","+    trailing: &'a str,","     exclude: bool,","     exclude_self: bool,","     include_dependencies: bool,","     include_dependents: bool,"," }"," ","+/// Parse one raw `--filter` selector string against `prefix` (the","+/// directory that directory-selectors resolve relative to)."," pub fn parse_project_selector(raw_selector: &str, prefix: &Path) -> ProjectSelector {","     let SelectorModifiers {","         raw,","@@ -57,6 +60,7 @@ pub fn parse_project_selector(raw_selector: &str, prefix: &Path) -> ProjectSelec","         exclude_self,","         include_dependencies,","         include_dependents,","+        ..","     } = strip_selector_modifiers(raw_selector);"," ","     match match_selector_pattern(raw) {","@@ -92,32 +96,85 @@ pub fn parse_project_selector(raw_selector: &str, prefix: &Path) -> ProjectSelec","     }"," }"," ","+/// Rewrite a directory selector resolved against `from_prefix` so it selects","+/// the same directory when resolved against `to_prefix`. Name and diff-only","+/// selectors are returned unchanged.","+#[must_use]","+pub fn rebase_project_selector(raw_selector: &str, from_prefix: &Path, to_prefix: &Path) -> String {","+    if from_prefix == to_prefix {","+        return raw_selector.to_string();","+    }","+    let SelectorModifiers { leading, raw, trailing, .. } = strip_selector_modifiers(raw_selector);","+    match match_selector_pattern(raw) {","+        Some(SelectorParts {","+            name,","+            brace_inner: Some(brace_inner),","+            bracket_inner,","+        }) => {","+            let Some(rebased) = rebase_dir(brace_inner, from_prefix, to_prefix) else {","+                return raw_selector.to_string();","+            };","+            let name = name.unwrap_or_default();","+            let bracket = bracket_inner","+                .map(|inner| format!(\"[{inner}]\"))","+                .unwrap_or_default();","+            format!(\"{leading}{name}{{{rebased}}}{bracket}{trailing}\")","+        }","+        None if is_selector_by_location(raw) => {","+            let Some(rebased) = rebase_dir(raw, from_prefix, to_prefix) else {","+                return raw_selector.to_string();","+            };","+            let location =","+                if is_selector_by_location(&rebased) { rebased } else { format!(\"./{rebased}\") };","+            format!(\"{leading}{location}{trailing}\")","+        }","+        _ => raw_selector.to_string(),","+    }","+}","+","+fn rebase_dir(raw_dir: &str, from_prefix: &Path, to_prefix: &Path) -> Option<String> {","+    let target = lexical_join(from_prefix, raw_dir);","+    let to_prefix = lexical_normalize(to_prefix);","+    let rel = pathdiff::diff_paths(&target, &to_prefix)?;","+    let normalized = rel.to_string_lossy().replace('\\\\', \"/\");","+    Some(if normalized.is_empty() { \".\".to_string() } else { normalized })","+}","+"," /// Peel the leading `!` and the `...`/`^` traversal modifiers from a selector,"," /// leaving the pattern they apply to."," fn strip_selector_modifiers(raw_selector: &str) -> SelectorModifiers<'_> {","-    let mut raw = raw_selector;","-    let exclude = raw.starts_with('!');","+    let mut start = 0;","+    let mut end = raw_selector.len();","+    let exclude = raw_selector[start..end].starts_with('!');","     if exclude {","-        raw = &raw[1..];","+        start += 1;","     }","     let mut exclude_self = false;","-    let include_dependencies = raw.ends_with(\"...\");","+    let include_dependencies = raw_selector[start..end].ends_with(\"...\");","     if include_dependencies {","-        raw = &raw[..raw.len() - 3];","-        if let Some(rest) = raw.strip_suffix('^') {","+        end -= 3;","+        if raw_selector[start..end].ends_with('^') {","             exclude_self = true;","-            raw = rest;","+            end -= 1;","         }","     }","-    let include_dependents = raw.starts_with(\"...\");","+    let include_dependents = raw_selector[start..end].starts_with(\"...\");","     if include_dependents {","-        raw = &raw[3..];","-        if let Some(rest) = raw.strip_prefix('^') {","+        start += 3;","+        if raw_selector[start..end].starts_with('^') {","             exclude_self = true;","-            raw = rest;","+            start += 1;","         }","     }","-    SelectorModifiers { raw, exclude, exclude_self, include_dependencies, include_dependents }","+    SelectorModifiers {","+        leading: &raw_selector[..start],","+        raw: &raw_selector[start..end],","+        trailing: &raw_selector[end..],","+        exclude,","+        exclude_self,","+        include_dependencies,","+        include_dependents,","+    }"," }"," "," /// The three optional capture groups of the selector regex"],"additions":71,"deletions":14,"truncated":false},{"path":"pnpm/crates/workspace-projects-filter/src/parse_project_selector/tests.rs","lines":["@@ -1,4 +1,6 @@","-use crate::parse_project_selector::{ProjectSelector, parse_project_selector};","+use crate::parse_project_selector::{","+    ProjectSelector, parse_project_selector, rebase_project_selector,","+};"," use std::path::{Path, PathBuf};"," "," const PREFIX: &str = \"/prefix\";","@@ -296,3 +298,34 @@ fn empty_braces_fall_back_to_name() {"," fn dot_prefixed_name_is_not_a_location() {","     assert_eq!(parse(\".foo\"), ProjectSelector { name_pattern: name(\".foo\"), ..Default::default() });"," }","+","+#[test]","+fn rebase_project_selector_preserves_target_dir_and_modifiers() {","+    let from = Path::new(\"/ws\");","+    let to = Path::new(\"/ws/packages/other\");","+    let same = Path::new(\"/ws/packages/app\");","+    for raw in [","+        \"./packages/app\",","+        \"!./packages/app\",","+        \".\",","+        \"{packages/*}\",","+        \"...^pattern{./packages/app}[main]...\",","+        \"app\",","+        \"[main]\",","+    ] {","+        let rebased = rebase_project_selector(raw, from, to);","+        assert_eq!(parse_project_selector(&rebased, to), parse_project_selector(raw, from));","+        let rebased_same = rebase_project_selector(raw, from, same);","+        assert_eq!(parse_project_selector(&rebased_same, same), parse_project_selector(raw, from));","+    }","+    assert_eq!(rebase_project_selector(\"./packages/app\", from, from), \"./packages/app\");","+    assert_eq!(rebase_project_selector(\"./packages/app\", from, to), \"../app\");","+    assert_eq!(rebase_project_selector(\"./packages/app\", from, same), \".\");","+    assert_eq!(rebase_project_selector(\"./packages/app/sub\", from, same), \"./sub\");","+    let abs = std::env::temp_dir();","+    assert_eq!(rebase_project_selector(\"./packages/app\", Path::new(\"rel\"), &abs), \"./packages/app\");","+    assert_eq!(","+        rebase_project_selector(\"{./packages/app}\", Path::new(\"rel\"), &abs),","+        \"{./packages/app}\",","+    );","+}"],"additions":34,"deletions":1,"truncated":false},{"path":"pnpm11/pnpm/src/getConfig.ts","lines":["@@ -12,6 +12,7 @@ import { logger } from '@pnpm/logger'"," import { createStoreController } from '@pnpm/store.connection-manager'"," import { lexCompare } from '@pnpm/text.ordinal-comparator'"," import type { ConfigDependencies } from '@pnpm/types'","+import { rebaseProjectSelector } from '@pnpm/workspace.projects-filter'"," import camelcase from 'camelcase'"," import { equals } from 'ramda'"," ","@@ -175,12 +176,17 @@ async function applyUpdateConfigHooks (config: Config, context: ConfigContext):","     registry: config.registry,","     registriesByScope: { ...config.registriesByScope },","   }","+  const filtersBeforeHooks = {","+    filter: cloneCliSetting(config.filter),","+    filterProd: cloneCliSetting(config.filterProd),","+  }","   const cliSettings = pickCliSettings(config, context.cliOptions)","   for (const updateConfig of context.hooks?.updateConfig ?? []) {","     const updateConfigResult = updateConfig(config)","     config = updateConfigResult instanceof Promise ? await 