{"id":"c613a152f25abb5f3b6d3dd595da3e8f4fb76465","axis":"silent","repo":"mongodb/mongo","sha":"c613a152f25abb5f3b6d3dd595da3e8f4fb76465","parsed":{"files":[{"path":"buildscripts/idl/idl_check_compatibility.py","lines":["@@ -99,6 +99,9 @@ def create_from(cls, privilege: syntax.Privilege):","     aggregate=[","         # Added in 9.1 for $collStats to support querying unfiltered metrics (SERVER-133544).","         AllowedNewPrivilege(\"cluster\", [\"getUnfilteredMetrics\"], \"collStats\"),","+        # $changeStream showSystemEvents on whole-cluster streams checks system.js read access to","+        # decide whether to filter out system.js events (SERVER-135203).","+        AllowedNewPrivilege(\"collection\", [\"find\", \"changeStream\"]),","     ],","     # This list is only used in unit-tests.","     complexChecksSupersetAllowed=["],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/auth/change_streams_show_system_events_auth.js","lines":["@@ -0,0 +1,279 @@","+/**","+ * Tests that 'showSystemEvents' change streams do not require privileges beyond those of the","+ * stream's scope, and that events on system.js are only returned to users who are authorized to","+ * read system.js. Users without that authorization can open the stream but do not see system.js","+ * events, while events on other collections remain visible.","+ *","+ * @tags: [","+ *   requires_majority_read_concern,","+ *   requires_replication,","+ *   requires_sharding,","+ *   uses_change_streams,","+ * ]","+ */","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {listIdleCursors} from \"jstests/libs/query/change_stream_util.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+import {ShardingTest} from \"jstests/libs/shardingtest.js\";","+","+const kKeyFile = \"jstests/libs/key1\";","+const kPassword = \"password\";","+const kDbName = jsTestName();","+const kCollName = \"coll\";","+const kAnyNormalReadPrivilege = {","+    resource: {db: \"\", collection: \"\"},","+    actions: [\"find\", \"changeStream\"],","+};","+const kSystemJsReadPrivilege = {","+    resource: {db: \"\", collection: \"system.js\"},","+    actions: [\"find\", \"changeStream\"],","+};","+","+// Creates the admin user, a user that may read every normal collection but not system.js, and a","+// user that may additionally read system.js in every database.","+function createUsers(conn) {","+    const adminDB = conn.getDB(\"admin\");","+    assert.commandWorked(","+        adminDB.runCommand({createUser: \"admin\", pwd: kPassword, roles: [\"root\"]}),","+    );","+    assert(adminDB.auth(\"admin\", kPassword));","+    assert.commandWorked(","+        adminDB.runCommand({","+            createRole: \"readNormal\",","+            privileges: [kAnyNormalReadPrivilege],","+            roles: [],","+        }),","+    );","+    assert.commandWorked(","+        adminDB.runCommand({","+            createRole: \"readNormalAndSystemJs\",","+            privileges: [kAnyNormalReadPrivilege, kSystemJsReadPrivilege],","+            roles: [],","+        }),","+    );","+    assert.commandWorked(","+        adminDB.runCommand({createUser: \"noSystemJs\", pwd: kPassword, roles: [\"readNormal\"]}),","+    );","+    assert.commandWorked(","+        adminDB.runCommand({","+            createUser: \"withSystemJs\",","+            pwd: kPassword,","+            roles: [\"readNormalAndSystemJs\"],","+        }),","+    );","+    assert.commandWorked(adminDB.getSiblingDB(kDbName).createCollection(kCollName));","+    adminDB.logout();","+}","+","+// Returns a connection to 'host' authenticated as 'user'.","+function connectAs(host, user) {","+    const conn = new Mongo(host);","+    assert(conn.getDB(\"admin\").auth(user, kPassword));","+    return conn;","+}","+","+// Opens a 'showSystemEvents' change stream as 'user', either on the test database or on the whole","+// cluster. Opening the stream must succeed regardless of the user's system.js privileges. If","+// 'targetShard' is set, the stream is opened on mongos as a per-shard cursor on that shard.","+function openStream(host, user, {wholeCluster, targetShard, comment}) {","+    const conn = connectAs(host, user);","+    const db = conn.getDB(wholeCluster ? \"admin\" : kDbName);","+    const res = assert.commandWorked(","+        db.runCommand({","+            aggregate: 1,","+            pipeline: [","+                {$changeStream: {allChangesForCluster: wholeCluster, showSystemEvents: true}},","+            ],","+            cursor: {},","+            comment,","+            ...(targetShard ? {$_passthroughToShard: {shard: targetShard}} : {}),","+        }),","+    );","+    return {conn, cursor: new DBCommandCursor(db, res)};","+}","+","+// The stage the router adds after $changeStream to drop system.js events from a per-shard stream","+// of a user who may not read system.js.","+const kSystemJsFilter = {","+    $match: {\"ns.coll\": {$ne: \"system.js\"}, \"to.coll\": {$ne: \"system.js\"}},","+};","+","+// Returns the pipeline that 'shard' runs for the change stream opened with 'comment'.","+function getShardPipeline(host, shard, comment) {","+    const conn = connectAs(host, \"admin\");","+    let cursors;","+    assert.soon(() => {","+        cursors = listIdleCursors(conn.getDB(\"admin\"), {","+            shard,","+            \"cursor.originatingCommand.comment\": comment,","+        });","+        return cursors.length > 0;","+    });","+    conn.close();","+    assert.eq(cursors.length, 1, {cursors});","+    return cursors[0].cursor.originatingCommand.pipeline;","+}","+","+// Returns the events of 'cursor' up to and including the insert of 'sentinelId' into the test","+// collection.","+function readUntilSentinel(cursor, sentinelId) {","+    const events = [];","+    assert.soon(() => {","+        // 'hasNext()' returns false once a getMore comes back empty, so poll until the sentinel.","+        while (cursor.hasNext()) {","+            const event = cursor.next();","+            events.push(event);","+            if (","+                event.operationType === \"insert\" &&","+                event.ns.coll === kCollName &&","+                event.documentKey._id === sentinelId","+            ) {","+                return true;","+            }","+        }","+        return false;","+    });","+    return events;","+}","+","+function eventsOn(events, collName) {","+    return events.filter((event) => event.ns && event.ns.coll === collName);","+}","+","+// Shared by all scenarios, since several of them may write to the same cluster.","+let sentinelId = 0;","+","+// Runs the scenarios against 'cluster.host'. If 'cluster.targetShard' is set, the streams are","+// per-shard streams on that shard. Both fields are read when the tests run, so they can be set in a","+// 'before' block.","+function runTests(cluster) {","+    // Performs writes on system.js followed by a sentinel insert into a regular collection. Returns","+    // the sentinel's _id.","+    function writeSystemEvents() {","+        const conn = connectAs(cluster.host, \"admin\");","+        const db = conn.getDB(kDbName);","+        const id = ++sentinelId;","+        assert.commandWorked(db.system.js.insert({_id: id, value: \"secret\"}));","+        assert.commandWorked(db.system.js.update({_id: id}, {$set: {value: \"updated secret\"}}));","+        assert.commandWorked(db.system.js.remove({_id: id}));","+        assert.commandWorked(db.getCollection(kCollName).insert({_id: id}));","+        conn.close();","+        return id;","+    }","+","+    // Asserts that the router added the system.js filter to the per-shard stream opened with","+    // 'comment' if and only if 'expectFilter' is set. No-op for streams that are not per-shard.","+    function assertShardFilter(comment, expectFilter) {","+        if (!cluster.targetShard) {","+            return;","+        }","+        const pipeline = getShardPipeline(cluster.host, cluster.targetShard, comment);","+        assert(pipeline[0].$changeStream, {pipeline});","+        if (expectFilter) {","+            assert.docEq(kSystemJsFilter, pipeline[1], {pipeline});","+        } else {","+            assert(!pipeline.some((stage) => bsonWoCompare(stage, kSystemJsFilter) === 0), {","+                pipeline,","+            });","+        }","+    }","+","+    for (const wholeCluster of [false, true]) {","+        const scope = wholeCluster ? \"whole-cluster\" : \"whole-db\";","+","+        it(`hides system.js events from a ${scope} stream without system.js privileges`, function () {","+            const comment = `hides ${scope} ${++sentinelId}`;","+            const {conn, cursor} = openStream(cluster.host, \"noSystemJs\", {","+                wholeCluster,","+                targetShard: cluster.targetShard,","+                comment,","+            });","+            assertShardFilter(comment, true);","+            const events = readUntilSentinel(cursor, writeSystemEvents());","+","+            assert.eq(eventsOn(events, \"system.js\"), [], {events});","+            cursor.close();","+            conn.close();","+        });","+","+        it(`shows system.js events to a ${scope} stream with system.js privileges`, function () {","+            const comment = `shows ${scope} ${++sentinelId}`;","+            const {conn, cursor} = openStream(cluster.host, \"withSystemJs\", {","+                wholeCluster,","+                targetShard: cluster.targetShard,","+                comment,","+            });","+            assertShardFilter(comment, false);","+            const events = readUntilSentinel(cursor, writeSystemEvents());","+","+            const systemJsEvents = eventsOn(events, \"system.js\");","+            assert.eq(","+                systemJsEvents.map((event) => event.operationType),","+                [\"insert\", \"update\", \"delete\"],","+                {events},","+            );","+            cursor.close();","+            conn.close();","+        });","+    }","+}","+","+describe(\"showSystemEvents change stream authorization on a replica set\", function () {","+    let rst;","+    const cluster = {};","+","+    before(function () {","+        rst = new ReplSetTest({nodes: 1});","+        rst.startSet({keyFile: kKeyFile});","+        rst.initiate();","+        createUsers(rst.getPrimary());","+        cluster.host = rst.getPrimary().host;","+    });","+","+    after(function () {","+        rst.stopSet();","+    });","+","+    runTests(cluster);","+});","+","+describe(\"showSystemEvents change stream authorization on a sharded cluster\", function () {","+    let st;","+    const cluster = {};","+","+    before(function () {","+        st = new ShardingTest({","+            shards: 2,","+            mongos: 1,","+            // Idle shards must advance their oplog for the router to return events from other shards.","+            rs: {nodes: 1, setParameter: {writePeriodicNoops: true, periodicNoopIntervalSecs: 1}},","+            other: {keyFile: kKeyFile},","+        });","+        createUsers(st.s);","+        cluster.host = st.s.host;","+    });","+","+    after(function () {","+        st.stop();","+    });","+","+    runTests(cluster);","+","+    // With '$_passthroughToShard' the router forwards the stream to the shard unparsed, so the","+    // system.js filtering must not depend on the shard knowing the user.","+    describe(\"with $_passthroughToShard\", function () {","+        const perShardCluster = {};","+","+        before(function () {","+            // Target the primary shard of the test database, which receives its system.js writes.","+            const conn = connectAs(st.s.host, \"admin\");","+            perShardCluster.host = st.s.host;","+            perShardCluster.targetShard = conn","+                .getDB(\"config\")","+                .databases.findOne({_id: kDbName}).primary;","+            conn.close();","+        });","+","+        runTests(perShardCluster);","+    });","+});"],"additions":279,"deletions":0,"truncated":false},{"path":"jstests/auth/lib/commands_lib.js","lines":["@@ -3017,6 +3017,79 @@ export const authCommandsLib = {","                 },","             ],","         },","+        // 'showSystemEvents' requires no privileges beyond those of the stream's scope. Events on","+        // system.js are filtered out of the stream if the user cannot read system.js.","+        {","+            testname: \"aggregate_changeStream_whole_db_showSystemEvents\",","+            command: {","+                aggregate: 1,","+                pipeline: [{$changeStream: {showSystemEvents: true}}],","+                cursor: {},","+            },","+            testcases: [","+                {","+                    runOnDb: firstDbName,","+                    roles: {","+                        read: 1,","+                        readAnyDatabase: 1,","+                        readWrite: 1,","+                        readWriteAnyDatabase: 1,","+                        dbOwner: 1,","+                        root: 1,","+                        searchCoordinator: 1,","+                        __system: 1,","+                    },","+                    privileges: [","+                        {","+                            resource: {db: firstDbName, collection: \"\"},","+                            actions: [\"changeStream\", \"find\"],","+                        },","+                    ],","+                    expectFail: true, // because no replication enabled","+                },","+                {","+                    runOnDb: secondDbName,","+                    roles: {","+                        readAnyDatabase: 1,","+                        readWriteAnyDatabase: 1,","+                        root: 1,","+                        searchCoordinator: 1,","+                        __system: 1,","+                    },","+                    privileges: [","+                        {","+                            resource: {db: secondDbName, collection: \"\"},","+                            actions: [\"changeStream\", \"find\"],","+                        },","+                    ],","+                    expectFail: true, // because no replication enabled","+                },","+            ],","+        },","+        {","+            testname: \"aggregate_changeStream_whole_cluster_showSystemEvents\",","+            command: {","+                aggregate: 1,","+                pipeline: [{$changeStream: {allChangesForCluster: true, showSystemEvents: true}}],","+                cursor: {},","+            },","+            testcases: [","+                {","+                    runOnDb: adminDbName,","+                    roles: {","+                        readAnyDatabase: 1,","+                        readWriteAnyDatabase: 1,","+                        root: 1,","+                        searchCoordinator: 1,","+                        __system: 1,","+                    },","+                    privileges: [","+                        {resource: {db: \"\", collection: \"\"}, actions: [\"changeStream\", \"find\"]},","+                    ],","+                    expectFail: true, // because no replication enabled","+                },","+            ],","+        },","         {","             testname: \"aggregate_changeStreamSplitLargeEvent_one_collection\",","             command: {"],"additions":73,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/BUILD.bazel","lines":["@@ -1393,6 +1393,7 @@ mongo_cc_unit_test(","         \"//src/mongo/db:change_stream_pre_image_util\",","         \"//src/mongo/db:change_stream_pre_images_collection_manager\",","         \"//src/mongo/db:service_context_d_test_fixture\",","+        \"//src/mongo/db/auth:authorization_session_test_fixture\",","         \"//src/mongo/db/commands/server_status:server_status_metric\",","         \"//src/mongo/db/exec/document_value\",","         \"//src/mongo/db/exec/document_value:document_value_test_util\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/aggregate_command.idl","lines":["@@ -113,6 +113,12 @@ commands:","                 - privilege: # $changeStream","                       resource_pattern: any_normal","                       action_type: find","+                - privilege: # $changeStream with 'showSystemEvents' on a whole-cluster stream checks","+                      # (but does not require) read access to system.js, to decide whether to","+                      # filter out system.js events. The whole-db case is covered by the","+                      # exact_namespace entries above.","+                      resource_pattern: collection","+                      action_type: [find, changeStream]","                 - privilege: # $changeStream, $_internalListCollections","                       resource_pattern: cluster","                       action_type: internal"],"additions":6,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/document_source_change_stream.cpp","lines":["@@ -3,9 +3,14 @@"," "," #include \"mongo/db/pipeline/document_source_change_stream.h\""," ","+#include \"mongo/db/auth/action_set.h\"","+#include \"mongo/db/auth/action_type.h\"","+#include \"mongo/db/auth/authorization_session.h\"","+#include \"mongo/db/auth/resource_pattern.h\""," #include \"mongo/db/commands/server_status/server_status_metric.h\""," #include \"mongo/db/curop.h\""," #include \"mongo/db/database_name.h\"","+#include \"mongo/db/namespace_string_util.h\""," #include \"mongo/db/pipeline/change_stream.h\""," #include \"mongo/db/pipeline/change_stream_helpers.h\""," #include \"mongo/db/pipeline/change_stream_pipeline_helpers.h\"","@@ -325,6 +330,40 @@ REGISTER_DOCUMENT_SOURCE_CONTAINER_WITH_STAGE_PARAMS_DEFAULT(changeStream,"," "," ALLOCATE_DOCUMENT_SOURCE_ID(_internalChangeStreamStage, DocumentSourceInternalChangeStreamStage::id)"," ","+bool DocumentSourceChangeStream::isAuthorizedForSystemJsEvents(OperationContext* opCtx,","+                                                               const NamespaceString& nss) {","+    if (!opCtx || !opCtx->getClient()) {","+        // Without a client we cannot check authorization, so do not expose system.js.","+        return false;","+    }","+","+    auto* client = opCtx->getClient();","+    if (!AuthorizationSession::exists(client)) {","+        // No authorization manager is set up for this service, so authorization is not enforced.","+        return true;","+    }","+","+    const ActionSet actions{ActionType::find, ActionType::changeStream};","+    constexpr auto systemJs = NamespaceString::kSystemDotJavascriptCollectionName;","+    auto* authzSession = AuthorizationSession::get(client);","+    switch (ChangeStream::getChangeStreamType(nss)) {","+        case ChangeStreamType::kCollection:","+            // A collection stream only matches its own namespace, which is authorized by the","+            // privileges required to open the stream.","+            return true;","+        case ChangeStreamType::kDatabase:","+            return authzSession->isAuthorizedForActionsOnResource(","+                ResourcePattern::forExactNamespace(","+                    NamespaceStringUtil::deserialize(nss.dbName(), systemJs)),","+                actions);","+        case ChangeStreamType::kAllDatabases:","+            // Grants on system.js of individual databases are not considered: a whole-cluster","+            // stream only shows system.js events if system.js is readable in every database.","+            return authzSession->isAuthorizedForActionsOnResource(","+                ResourcePattern::forCollectionName(nss.tenantId(), systemJs), actions);","+    }","+    MONGO_UNREACHABLE_TASSERT(13818300);","+}"," "," void DocumentSourceChangeStream::checkValueType(const Value v,","                                                 const std::string_view fieldName,","@@ -349,10 +388,16 @@ std::string_view DocumentSourceChangeStream::resolveAllCollectionsRegex(","     tassert(6189300,","             \"Expected change stream spec to be set on the expression context\",","             expCtx->getChangeStreamSpec());","-    // If 'showSystemEvents' is set, return a less stringent regex.","-    return (expCtx->getChangeStreamSpec()->getShowSystemEvents()","-                ? DocumentSourceChangeStream::kRegexAllCollectionsShowSystemEvents","-                : DocumentSourceChangeStream::kRegexAllCollections);","+    if (!expCtx->getChangeStreamSpec()->getShowSystemEvents()) {","+        return DocumentSourceChangeStream::kRegexAllCollections;","+    }","+","+    // If 'showSystemEvents' is set, return a less stringent regex. system.js is only included if","+    // the user is authorized to read it.","+    return isAuthorizedForSystemJsEvents(expCtx->getOperationContext(),","+                                         expCtx->getNamespaceString())","+        ? DocumentSourceChangeStream::kRegexAllCollectionsShowSystemEvents","+        : DocumentSourceChangeStream::kRegexAllCollectionsShowSystemEventsExceptSystemJs;"," }"," "," std::string DocumentSourceChangeStream::getNsRegexForChangeStream("],"additions":49,"deletions":4,"truncated":false},{"path":"src/mongo/db/pipeline/document_source_change_stream.h","lines":["@@ -76,6 +76,9 @@ class [[MONGO_MOD_NEEDS_REPLACEMENT]] DocumentSourceChangeStream final {","         }"," ","         ActionSet actions{ActionType::changeStream, ActionType::find};","+        // Note: 'showSystemEvents' does not require additional privileges. Instead, system.js","+        // events are filtered out of the stream unless the user may read system.js, see","+        // 'DocumentSourceChangeStream::resolveAllCollectionsRegex()'.","         PrivilegeVector requiredPrivileges(bool isMongos,","                                            bool bypassDocumentValidation) const override {","             if (_nss.isAdminDB() && _nss.isCollectionlessAggregateNS()) {","@@ -273,19 +276,37 @@ class [[MONGO_MOD_NEEDS_REPLACEMENT]] DocumentSourceChangeStream final {","     // Regex matching all user collections plus collections exposed when 'showSystemEvents' is set.","     // Does not match a collection named $ or a collection with 'system.' in the name.","     // However, it will still match collection names starting with system.buckets or","-    // system.resharding, or a collection exactly named system.js","+    // system.resharding, or a collection exactly named system.js or system.views.","     static constexpr std::string_view kRegexAllCollectionsShowSystemEvents{","         R\"((?!(\\$|system\\.(?!(js$|resharding\\.|buckets\\.|views$)))))\"};"," ","+    // Same as 'kRegexAllCollectionsShowSystemEvents', but without system.js. Used when the user is","+    // not authorized to read the system.js collections covered by the stream.","+    static constexpr std::string_view kRegexAllCollectionsShowSystemEventsExceptSystemJs{","+        R\"((?!(\\$|system\\.(?!(resharding\\.|buckets\\.|views$)))))\"};","+","     static constexpr std::string_view kRegexAllDBs{R\"(^(?!(admin|config|local)\\.)[^.]+)\"};","     static constexpr std::string_view kRegexCmdColl{R\"(\\$cmd$)\"};"," ","     /**","      * Helpers for determining which regex to match a change stream against.","+     *","+     * When 'showSystemEvents' is set, 'resolveAllCollectionsRegex()' only includes system.js if","+     * the user is authorized for 'find' and 'changeStream' on every system.js collection covered by","+     * the stream. The scope privileges of whole-db and whole-cluster streams do not cover system","+     * collections, so without such a grant system.js events are filtered out.","      */","     static std::string_view resolveAllCollectionsRegex(","         const boost::intrusive_ptr<ExpressionContext>& expCtx);"," ","+    /**","+     * Returns whether the client of 'opCtx' may read the events on every system.js collection","+     * covered by a change stream on 'nss'. 'showSystemEvents' exposes system.js, but the privileges","+     * required to open a whole-db or whole-cluster stream do not cover system collections, so","+     * system.js events are filtered out when this returns false.","+     */","+    static bool isAuthorizedForSystemJsEvents(OperationContext* opCtx, const NamespaceString& nss);","+","     static std::string getNsRegexForChangeStream(","         const boost::intrusive_ptr<ExpressionContext>& expCtx);","     static std::string getCollRegexForChangeStream("],"additions":22,"deletions":1,"truncated":false},{"path":"src/mongo/db/pipeline/document_source_change_stream_test.cpp","lines":["@@ -6,6 +6,13 @@"," #include \"mongo/bson/bsonobj.h\""," #include \"mongo/bson/bsonobjbuilder.h\""," #include \"mongo/bson/json.h\"","+#include \"mongo/db/auth/action_set.h\"","+#include \"mongo/db/auth/action_type.h\"","+#include \"mongo/db/auth/authorization_session.h\"","+#include \"mongo/db/auth/authorization_session_for_test.h\"","+#include \"mongo/db/auth/authz_session_external_state_mock.h\"","+#include \"mongo/db/auth/privilege.h\"","+#include \"mongo/db/auth/resource_pattern.h\""," #include \"mongo/db/commands/server_status/server_status_metric.h\""," #include \"mongo/db/database_name.h\""," //#include \"mongo/db/end_of_transaction_cluster_parameter_gen.h\"","@@ -62,6 +69,7 @@"," #include \"mongo/unittest/death_test.h\""," #include \"mongo/unittest/server_parameter_guard.h\""," #include \"mongo/unittest/unittest.h\"","+#include \"mongo/util/pcre.h\""," #include \"mongo/util/str.h\""," #include \"mongo/util/uuid.h\""," ","@@ -286,6 +294,143 @@ TEST_F(ChangeStreamStageTest, ShouldRejectUnrecognizedFullDocumentOption) {","                        ErrorCodes::BadValue);"," }"," ","+// Resource patterns $changeStream requires on 'nss'. 'boost::none' omits 'showSystemEvents'.","+std::set<std::string> changeStreamRequiredResources(const NamespaceString& nss,","+                                                    boost::optional<bool> showSystemEvents) {","+    BSONObjBuilder specBuilder;","+    if (showSystemEvents) {","+        specBuilder.append(\"showSystemEvents\", *showSystemEvents);","+    }","+    auto spec = BSON(DSChangeStream::kStageName << specBuilder.obj());","+    auto liteParsed =","+        DSChangeStream::LiteParsed::parse(nss, spec.firstElement(), LiteParserOptions{});","+","+    std::set<std::string> resources;","+    for (const auto& privilege :","+         liteParsed->requiredPrivileges(false /*isMongos*/, false /*bypass*/)) {","+        // Every privilege must require both actions, or it could be satisfied without read access.","+        ASSERT_TRUE(privilege.includesAction(ActionType::find)) << privilege.getResourcePattern();","+        ASSERT_TRUE(privilege.includesAction(ActionType::changeStream))","+            << privilege.getResourcePattern();","+        resources.insert(privilege.getResourcePattern().toString());","+    }","+    return resources;","+}","+","+TEST_F(ChangeStreamStageTest, ShowSystemEventsDoesNotChangeRequiredPrivileges) {","+    // 'showSystemEvents' must not require privileges beyond those of the stream's scope. Events on","+    // system.js are filtered out instead when the user cannot read system.js.","+    const auto collNss = NamespaceString::createNamespaceString_forTest(\"testdb\", \"userColl\");","+    const auto dbNss = NamespaceString::makeCollectionlessAggregateNSS(","+        DatabaseName::createDatabaseName_forTest(boost::none, \"testdb\"));","+    const auto clusterNss = NamespaceString::makeCollectionlessAggregateNSS(DatabaseName::kAdmin);","+","+    for (const auto& showSystemEvents :","+         {boost::optional<bool>{}, boost::optional<bool>{false}, boost::optional<bool>{true}}) {","+        ASSERT_EQ(changeStreamRequiredResources(collNss, showSystemEvents),","+                  std::set<std::string>{\"<testdb.userColl>\"});","+        ASSERT_EQ(changeStreamRequiredResources(dbNss, showSystemEvents),","+                  std::set<std::string>{\"<database testdb>\"});","+        ASSERT_EQ(changeStreamRequiredResources(clusterNss, showSystemEvents),","+                  std::set<std::string>{\"<all normal resources>\"});","+    }","+}","+","+const ActionSet kChangeStreamReadActions{ActionType::changeStream, ActionType::find};","+","+// Replaces the authorization session of 'client' with an enforcing one holding 'privileges'.","+void setClientPrivileges(Client* client, PrivilegeVector privileges) {","+    // A session must be logged out before it is destroyed.","+    if (AuthorizationSession::exists(client)) {","+        AuthorizationSession::get(client)->logoutAllDatabases(\"Replaced by test\");","+    }","+    auto session = std::make_unique<AuthorizationSessionForTest>(","+        std::make_unique<AuthzSessionExternalStateMock>(client), client);","+    session->assumePrivilegesForDB(std::move(privileges), DatabaseName::kAdmin);","+    AuthorizationSession::set(client, std::move(session));","+}","+","+/**","+ * Tests the namespace regex of 'showSystemEvents' streams: system.js is only matched when the user","+ * can read it, while the other system namespaces exposed by the flag are always matched.","+ */","+class ChangeStreamShowSystemEventsAuthTest : public ChangeStreamStageTest {","+protected:","+    const DatabaseName testDb = DatabaseName::createDatabaseName_forTest(boost::none, \"testdb\");","+    const NamespaceString dbStreamNss = NamespaceString::makeCollectionlessAggregateNSS(testDb);","+    const NamespaceString clusterStreamNss =","+        NamespaceString::makeCollectionlessAggregateNSS(DatabaseName::kAdmin);","+","+    // Returns whether a 'showSystemEvents' stream on 'streamNss' matches events on 'eventNs'.","+    bool streamMatches(const NamespaceString& streamNss, std::string_view eventNs) {","+        auto expCtx = getExpCtx();","+        expCtx->setNamespaceString(streamNss);","+        DocumentSourceChangeStreamSpec spec;","+        spec.setShowSystemEvents(true);","+        expCtx->setChangeStreamSpec(spec);","+        return static_cast<bool>(","+            pcre::Regex(DSChangeStream::getNsRegexForChangeStream(expCtx)).matchView(eventNs));","+    }","+","+    // Grants 'scopePrivilege' plus 'extra', then returns whether system.js is matched. Also checks","+    // that the other system namespaces exposed by 'showSystemEvents' are always matched.","+    bool systemJsVisible(const NamespaceString& streamNss,","+                         const Privilege& scopePrivilege,","+                         PrivilegeVector extra = {}) {","+        extra.push_back(scopePrivilege);","+        setClientPrivileges(getExpCtx()->getOperationContext()->getClient(), std::move(extra));","+        for (auto ns : {\"testdb.userColl\",","+                        \"testdb.system.buckets.coll\",","+                        \"testdb.system.resharding.coll\",","+                        \"testdb.system.views\"}) {","+            ASSERT_TRUE(streamMatches(streamNss, ns)) << ns;","+        }","+        return streamMatches(streamNss, \"testdb.system.js\");","+    }","+","+    Privilege systemJsPrivilege(std::string_view ns, ActionSet actions = kChangeStreamReadActions) {","+        return Privilege(","+            ResourcePattern::forExactNamespace(NamespaceString::createNamespaceString_forTest(ns)),","+            actions);","+    }","+};","+","+TEST_F(ChangeStreamShowSystemEventsAuthTest, SystemJsVisibleWhenAuthorizationIsNotEnforced) {","+    ASSERT_TRUE(streamMatches(dbStreamNss, \"testdb.system.js\"));","+    ASSERT_TRUE(streamMatches(clusterStreamNss, \"testdb.system.js\"));","+}","+","+TEST_F(ChangeStreamShowSystemEventsAuthTest, DbStream) {","+    const Privilege dbPrivilege(ResourcePattern::forDatabaseName(testDb), kChangeStreamReadActions);"],"additions":116,"deletions":0,"truncated":false}],"additions":549,"deletions":5,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-19T18:00:33.901183+00:00"}