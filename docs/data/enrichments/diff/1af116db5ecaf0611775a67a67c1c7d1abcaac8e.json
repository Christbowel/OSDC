+\t\t\t\t'value' => 'chocolate-chip',","+\t\t\t)","+\t\t);","+\t\t$cookie_no_name->name = null;","+\t\t$this->assertSame( 'chocolate-chip', $cookie_no_name->value );","+\t\t$this->assertSame( '', $cookie_no_name->getHeaderValue() );","+\t}","+","+\t/**","+\t * Tests getFullHeader() with and without cookie values.","+\t *","+\t * @covers ::getFullHeader","+\t */","+\tpublic function test_get_full_header(): void {","+\t\t$cookie = new WP_Http_Cookie(","+\t\t\tarray(","+\t\t\t\t'name'  => 'flavor',","+\t\t\t\t'value' => 'chocolate-chip',","+\t\t\t)","+\t\t);","+","+\t\t$this->assertSame( 'Cookie: flavor=chocolate-chip', $cookie->getFullHeader() );","+","+\t\t$cookie_empty = new WP_Http_Cookie( array() );","+\t\t$this->assertSame( 'Cookie: ', $cookie_empty->getFullHeader() );","+\t}","+","+\t/**","+\t * Tests that properties default to null when not provided.","+\t *","+\t * @covers ::__construct","+\t */","+\tpublic function test_properties_null_when_not_provided(): void {","+\t\t$cookie = new WP_Http_Cookie( 'foo=bar' );","+","+\t\t$this->assertSame( 'foo', $cookie->name );","+\t\t$this->assertSame( 'bar', $cookie->value );","+\t\t$this->assertNull( $cookie->domain );","+","+\t\t$empty_cookie = new WP_Http_Cookie( array() );","+\t\t$this->assertNull( $empty_cookie->name );","+\t\t$this->assertNull( $empty_cookie->value );","+\t\t$this->assertNull( $empty_cookie->domain );","+\t}","+","+\t/**","+\t * Tests get_attributes() returns expected cookie attributes.","+\t *","+\t * @covers ::get_attributes","+\t */","+\tpublic function test_get_attributes(): void {","+\t\t$cookie = new WP_Http_Cookie(","+\t\t\tarray(","+\t\t\t\t'name'    => 'session',","+\t\t\t\t'value'   => 'abc123xyz',","+\t\t\t\t'expires' => 1700000000,","+\t\t\t\t'path'    => '/wp-admin/',","+\t\t\t\t'domain'  => 'example.org',","+\t\t\t)","+\t\t);","+","+\t\t$expected = array(","+\t\t\t'expires' => 1700000000,","+\t\t\t'path'    => '/wp-admin/',","+\t\t\t'domain'  => 'example.org',","+\t\t);","+","+\t\t$this->assertSame( $expected, $cookie->get_attributes() );","+\t}","+","+\t/**","+\t * Tests that the expiration date is stored as a Unix timestamp, false if unparsable, or null if not provided.","+\t *","+\t * @covers ::__construct","+\t *","+\t * @dataProvider data_expires","+\t *","+\t * @param string|array{ name: string, value: string, expires?: int|string } $data     Cookie data.","+\t * @param int|false|null                                                    $expected Expected expiration.","+\t */","+\tpublic function test_expires( $data, $expected ): void {","+\t\t$cookie = new WP_Http_Cookie( $data );","+","+\t\t$this->assertSame( $expected, $cookie->expires );","+\t}","+","+\t/**","+\t * Data provider for {@see self::test_expires()}.","+\t *","+\t * @return array<non-falsy-string, array{ 0: string|array{ name: string, value: string, expires?: int|string }, 1: int|false|null }>","+\t */","+\tpublic function data_expires(): array {","+\t\treturn array(","+\t\t\t'timestamp from array'    => array(","+\t\t\t\tarray(","+\t\t\t\t\t'name'    => 'flavor',","+\t\t\t\t\t'value'   => 'chocolate-chip',","+\t\t\t\t\t'expires' => 1445412480,","+\t\t\t\t),","+\t\t\t\t1445412480,","+\t\t\t),","+\t\t\t'date string from array'  => array(","+\t\t\t\tarray(","+\t\t\t\t\t'name'    => 'flavor',","+\t\t\t\t\t'value'   => 'chocolate-chip',","+\t\t\t\t\t'expires' => 'Wed, 21 Oct 2015 07:28:00 GMT',","+\t\t\t\t),","+\t\t\t\t1445412480,","+\t\t\t),","+\t\t\t'unparsable from array'   => array(","+\t\t\t\tarray(","+\t\t\t\t\t'name'    => 'flavor',","+\t\t\t\t\t'value'   => 'chocolate-chip',","+\t\t\t\t\t'expires' => 'garbage',","+\t\t\t\t),","+\t\t\t\tfalse,","+\t\t\t),","+\t\t\t'missing from array'      => array(","+\t\t\t\tarray(","+\t\t\t\t\t'name'  => 'flavor',","+\t\t\t\t\t'value' => 'chocolate-chip',","+\t\t\t\t),","+\t\t\t\tnull,","+\t\t\t),","+\t\t\t'date string from header' => array( 'flavor=chocolate-chip; expires=Wed, 21 Oct 2015 07:28:00 GMT', 1445412480 ),","+\t\t\t'unparsab