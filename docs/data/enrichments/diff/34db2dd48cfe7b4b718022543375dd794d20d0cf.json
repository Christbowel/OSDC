>= static_cast<double>(maximum) ? maximum : static_cast<idx_t>(value);","+\t}","+","+\tCardinalityValue operator*(const CardinalityValue &other) const {","+\t\treturn CardinalityValue(numerator * other.numerator, Product(denominator * other.denominator));","+\t}","+","+\tCardinalityValue operator/(const CardinalityValue &other) const {","+\t\tD_ASSERT(!other.IsZero());","+\t\treturn CardinalityValue(numerator * other.denominator, other.numerator * denominator);","+\t}","+","+\tCardinalityValue &operator*=(const CardinalityValue &other) {","+\t\t*this = *this * other;","+\t\treturn *this;","+\t}","+","+\tbool operator>(const CardinalityValue &other) const {","+\t\treturn numerator * other.denominator > other.numerator * denominator;","+\t}","+","+\tbool operator<(const CardinalityValue &other) const {","+\t\treturn other > *this;","+\t}","+","+private:","+\tstruct Product {","+\t\texplicit Product(double value) {","+\t\t\tD_ASSERT(std::isfinite(value) && value >= 0);","+\t\t\tint value_exponent;","+\t\t\tsignificand = std::frexp(value, &value_exponent);","+\t\t\texponent = value_exponent;","+\t\t}","+","+\t\tProduct operator*(const Product &other) const {","+\t\t\tauto result = *this * other.significand;","+\t\t\tif (result.significand != 0) {","+\t\t\t\tresult.exponent += other.exponent;","+\t\t\t}","+\t\t\treturn result;","+\t\t}","+","+\t\tProduct operator*(double other) const {","+\t\t\tProduct result(significand * other);","+\t\t\tif (result.significand != 0) {","+\t\t\t\tresult.exponent += exponent;","+\t\t\t}","+\t\t\treturn result;","+\t\t}","+","+\t\tbool operator>(const Product &other) const {","+\t\t\tif (significand == 0 || other.significand == 0) {","+\t\t\t\treturn significand > other.significand;","+\t\t\t}","+\t\t\treturn exponent == other.exponent ? significand > other.significand : exponent > other.exponent;","+\t\t}","+","+\t\tdouble significand;","+\t\tint64_t exponent;","+\t};","+","+\tCardinalityValue(Product numerator, Product denominator)","+\