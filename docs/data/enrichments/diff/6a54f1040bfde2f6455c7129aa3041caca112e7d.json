s, PropertyInfoBundle::class, UidBundle::class, SchedulerBundle::class, JsonStreamerBundle::class, AssetMapperBundle::class, RateLimiterBundle::class, WebhookBundle::class, HttpClientBundle::class, MailerBundle::class, NotifierBundle::class, ProcessBundle::class, JsonPathBundle::class, MimeBundle::class, ObjectMapperBundle::class, KeyManagementBundle::class] as $class) {","             if (class_exists($class)) {","                 $expected[$class] = ['all' => true];","             }"],"additions":2,"deletions":1,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/composer.json","lines":["@@ -55,6 +55,7 @@","         \"symfony/html-sanitizer\": \"^8.2\",","         \"symfony/http-client\": \"^8.2\",","         \"symfony/json-streamer\": \"^8.2\",","+        \"symfony/key-management\": \"^8.2\",","         \"symfony/lock\": \"^8.2\",","         \"symfony/mailer\": \"^8.2\",","         \"symfony/messenger\": \"^8.2\",","@@ -96,6 +97,7 @@","         \"symfony/http-client\": \"<8.2\",","         \"symfony/json-path\": \"<8.2\",","         \"symfony/json-streamer\": \"<8.2\",","+        \"symfony/key-management\": \"<8.2\",","         \"symfony/mailer\": \"<8.2\",","         \"symfony/lock\": \"<8.2\",","         \"symfony/notifier\": \"<8.2\","],"additions":2,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/WebProfilerBundle/CHANGELOG.md","lines":["@@ -6,6 +6,7 @@ CHANGELOG"," ","  * Add dump indicator to profiler list view for profiles with dumped content","  * Log the profiler URL of each request at debug level on the `profiler` channel","+ * Add a Key Management panel, reporting what a request encrypted per call site and per key rather than call by call"," "," 8.1"," ---"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/WebProfilerBundle/Resources/views/Collector/key_management.html.twig","lines":["@@ -0,0 +1,327 @@","+{% extends '@WebProfiler/Profiler/layout.html.twig' %}","+","+{% block stylesheets %}","+    {{ parent() }}","+","+    <style>","+        .sf-profiler-kms .kms-detail {","+            display: block;","+            font-size: 12px;","+        }","+        .sf-profiler-kms .kms-ops .badge {","+            margin-right: 4px;","+            white-space: nowrap;","+        }","+        .sf-profiler-kms .kms-keys {","+            font-size: 12px;","+            list-style: none;","+            margin: 0;","+            padding: 0;","+        }","+    </style>","+{% endblock %}","+","+{% block toolbar %}","+    {% if collector.operationCount %}","+        {% set icon %}","+            {{ source('@WebProfiler/Icon/key-management.svg') }}","+            <span class=\"sf-toolbar-value\">{{ collector.kmsCallCount }}</span>","+        {% endset %}","+","+        {% set text %}","+            <div class=\"sf-toolbar-info-piece\">","+                <b>KMS round trips</b>","+                <span class=\"sf-toolbar-status\">{{ collector.kmsCallCount }}</span>","+            </div>","+            <div class=\"sf-toolbar-info-piece\">","+                <b>Operations</b>","+                <span class=\"sf-toolbar-status\">{{ collector.operationCount }}</span>","+            </div>","+            <div class=\"sf-toolbar-info-piece\">","+                <b>Keys and scopes</b>","+                <span class=\"sf-toolbar-status\">{{ collector.keys|length }}</span>","+            </div>","+            <div class=\"sf-toolbar-info-piece\">","+                <b>Errors</b>","+                <span class=\"sf-toolbar-status {{ collector.errorCount ? 'sf-toolbar-status-red' }}\">{{ collector.errorCount }}</span>","+            </div>","+            <div class=\"sf-toolbar-info-piece\">","+                <b>Total time</b>","+                <span>{{ '%.2f'|format(collector.totalTime * 1000) }} <span class=\"unit\">ms</span></span>","+            </div>","+        {% endset %}","+","+        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: collector.errorCount ? 'red' : ''}) }}","+    {% endif %}","+{% endblock %}","+","+{% block menu %}","+    <span class=\"label {{ collector.operationCount == 0 ? 'disabled' }}\">","+        <span class=\"icon\" aria-hidden=\"true\">{{ source('@WebProfiler/Icon/key-management.svg') }}</span>","+        <strong>Key Management</strong>","+        {% if collector.operationCount %}","+            <span class=\"count\">","+                <span>{{ collector.operationCount }}</span>","+            </span>","+        {% endif %}","+    </span>","+{% endblock %}","+","+{% block panel %}","+    <h2>Key Management</h2>","+","+    {% if collector.operationCount == 0 %}","+        <div class=\"empty empty-panel\">","+            <p>Nothing was encrypted or decrypted.</p>","+        </div>","+","+        {{ _self.render_clients(collector) }}","+    {% else %}","+        <div class=\"metrics\">","+            <div class=\"metric\">","+                <span class=\"value\">{{ collector.kmsCallCount }}</span>","+                <span class=\"label\">KMS round trips</span>","+            </div>","+            <div class=\"metric\">","+                <span class=\"value\">{{ collector.operationCount }}</span>","+                <span class=\"label\">Operations</span>","+            </div>","+            <div class=\"metric\">","+                <span class=\"value\">{{ collector.keys|length }}</span>","+                <span class=\"label\">Keys and scopes</span>","+            </div>","+            <div class=\"metric\">","+                <span class=\"value\">{{ collector.errorCount }}</span>","+                <span class=\"label\">Errors</span>","+            </div>","+            <div class=\"metric\">","+                <span class=\"value\">{{ '%.2f'|format(collector.totalTime * 1000) }} <span class=\"unit\">ms</span></span>","+                <span class=\"label\">Total time</span>","+            </div>","+            <div class=\"metric\">","+                <span class=\"value\">{{ '%.2f'|format(collector.kmsTime * 1000) }} <span class=\"unit\">ms</span></span>","+                <span class=\"label\">Spent in a KMS</span>","+            </div>","+        </div>","+","+        <div class=\"sf-tabs sf-profiler-kms\">","+            <div class=\"tab\">","+                <h3 class=\"tab-title\">By caller <span class=\"badge\">{{ collector.callers|length }}</span></h3>","+","+                <div class=\"tab-content\">","+                    <p class=\"text-muted\">What each piece of code asked for, whatever the number of values it went through.</p>","+","+                    <table>","+                        <thead>","+                            <tr>","+                                <th>Caller</th>","+                                <th>Operations</th>","+                                <th>KMS</th>","+                                <th>Keys and scopes</th>","+                                <th>Bytes</th>","+                                <th>Time</th>","+                            </tr>","+                        </thead>","+                        <tbody>","+                            {% for caller in collector.callers %}","+                                <tr>","+                                    <td>","+                                        {{ _self.render_caller(caller) }}","+                                        {{ _self.render_error(caller) }}","+                                    </td>","+                                    <td class=\"kms-ops\">{{ _self.render_operations(caller) }}</td>","+                                    <td class=\"nowrap {{ caller.layers.kms ? '' : 'text-muted' }}\">{{ caller.layers.kms }}</td>","+                                    <td>","+                                        <ul class=\"kms-keys\">","+                                            {% for key in caller.keys|slice(0, 6) %}","+                                                <li><code>{{ key }}</code></li>","+                                            {% endfor %}","+                                            {% if caller.keys|length > 6 %}","+                                                <li class=\"text-muted\">and {{ caller.keys|length - 6 }} more</li>","+                                            {% endif %}","+                                        </ul>","+                                    </td>","+                                    <td class=\"nowrap\">{{ _self.render_bytes(caller.in) }} &rarr; {{ _self.render_bytes(caller.out) }}</td>","+                                    <td class=\"nowrap\">{{ _self.render_time(caller) }}</td>","+                                </tr>","+                            {% endfor %}","+                        </tbody>","+                    </table>","+                </div>","+            </div>","+","+            <div class=\"tab\">","+                <h3 class=\"tab-title\">By key <span class=\"badge\">{{ collector.keys|length }}</span></h3>","+","+                <div class=\"tab-content\">","+                    <p class=\"text-muted\">What each master key, scope and data key was used for. A scope reusing one data key over many payloads is a store doing its job.</p>","+","+                    <table>","+                        <thead>","+                            <tr>","+                                <th>Key</th>","+                                <th>Operations</th>","+                                <th>KMS</th>","+                                <th>Data keys</th>","+                                <th>Bytes</th>","+                                <th>Time</th>","+                            </tr>","+                        </thead>","+                        <tbody>","+                            {% for key in collector.keys %}","+                                <tr>","+                                    <td>","+                                        <code>{{ key.label }}</code>","+                                        <span class=\"kms-detail text-muted\">","+                                            {{ key.kind|replace({_: ' '}) }}","+                                            {%- for backend in key.backends %} &bull; {{ backend|split('\\\\')|last }}{% endfor %}","+                                        </span>","+                                        {{ _self.render_error(key) }}","+                                    </td>","+                                    <td class=\"kms-ops\">","+                                        {{ _self.render_operations(key) }}","+                                        {% if key.aad %}","+                                            <span class=\"kms-detail text-muted\">{{ key.aad }} with an AAD</span>","+                                        {% endif %}","+                                        {% if key.deterministic %}","+                                            <span class=\"kms-detail text-muted\">{{ key.deterministic }} deterministic</span>","+                                        {% endif %}","+                                    </td>","+                                    <td class=\"nowrap {{ key.layers.kms ? '' : 'text-muted' }}\">","+                                        {{ key.layers.kms }}","+                                        <span class=\"kms-detail text-muted\">{{ key.origins.bridge ? 'bridge' : 'core' }}</span>","+                                    </td>","+                                    <td>","+                                        {% if key.data_keys is empty %}","+                                            <span class=\"text-muted\">&ndash;</span>","+                                        {% else %}","+                                            <ul class=\"kms-keys\">","+                                                {% for reference in key.data_keys %}","+                                                    <li><code>{{ reference }}</code></li>","+                                                {% endfor %}","+                                            </ul>","+                                        {% endif %}","+                                    </td>","+                                    <td class=\"nowrap\">{{ _self.render_bytes(key.in) }} &rarr; {{ _self.render_bytes(key.out) }}</td>","+                                    <td class=\"nowrap\">{{ _self.render_time(key) }}</td>","+                                </tr>","+                            {% endfor %}","+                        </tbody>","+                    </table>","+                </div>","+            </div>","+","+            <div class=\"tab\">","+                <h3 class=\"tab-title\">Services <span class=\"badge\">{{ collector.services|reduce((total, services) => total + services|length, 0) }}</span></h3>","+","+                <div class=\"tab-content\">","+                    <p class=\"text-muted\">Which configured service did the work. The origin is read from the backend class: a bridge reaches a provider, core is one of the backends the component ships, which may still load its key material from elsewhere.</p>","+","+                    <table>","+                        <thead>","+                            <tr>","+                                <th>Layer</th>","+                                <th>Service</th>","+                                <th>Class</th>","+                                <th>Origin</th>","+                                <th>Operations</th>","+                                <th>Time</th>","+                                <th>Errors</th>","+                            </tr>","+                        </thead>","+                        <tbody>","+                            {% for layer, services in collector.services %}","+                                {% for name, service in services %}","+                                    <tr>","+                                        <td class=\"nowrap\">{{ layer }}</td>","+                                        <td class=\"nowrap\">{{ name }}</td>","+                                        <td><code>{{ service.backend|default('(unknown)') }}</code></td>","+                                        <td class=\"nowrap\">{{ service.origins.bridge ? 'bridge' : 'core' }}</td>","+                                        <td class=\"nowrap\">{{ service.ops }}</td>","+                                        <td class=\"nowrap\">{{ _self.render_time(service) }}</td>","+                                        <td class=\"nowrap {{ service.errors ? 'text-danger' }}\">{{ service.errors }}</td>","+                                    </tr>","+                                {% endfor %}","+                            {% endfor %}","+                        </tbody>","+                    </table>","+","+                    {{ _self.render_clients(collector) }}","+                </div>","+            </div>","+        </div>","+    {% endif %}","+{% endblock %}","+","+{% macro render_time(group) %}","+    {%- set average = group.time * 1000 / group.ops -%}","+    {{ '%.2f'|format(group.time * 1000) }} ms","+    <span class=\"kms-detail text-muted\">","+        {%- if average < 0.01 -%}","+            {{ '%.0f'|format(average * 1000) }} &micro;s / operation","+        {%- else -%}","+            {{ '%.2f'|format(average) }} ms / operation","+        {%- endif -%}","+    </span>","+{% endmacro %}","+","+{% macro render_operations(group) %}","+    {%- for operation, count in group.operations -%}","+        <span class=\"badge\">{{ count }} {{ operation|replace({_: ' '}) }}</span>","+    {%- endfor -%}","+{% endmacro %}","+","+{% macro render_error(group) %}","+    {%- if group.error -%}","+        <span class=\"kms-detail text-danger\">","+            {{- group.errors }} &times; {{ group.error.class|split('\\\\')|last }}: {{ group.error.message -}}","+        </span>","+    {%- endif -%}","+{% endmacro %}","+","+{% macro render_clients(collector) %}","+    {% if collector.clients %}","+        <h3>Configured clients</h3>","+","+        <table>","+            <thead>","+                <tr>","+                    <th>Name</th>","+                    <th>Operations</th>","+                </tr>","+            </thead>","+            <tbody>","+                {% for name in collector.clients %}","+                    <tr>","+                        <td class=\"nowrap\">{{ name }}</td>","+                        <td class=\"nowrap\">{{ collector.services.kms[name].ops|default(0) }}</td>","+                    </tr>","+                {% endfor %}","+            </tbody>","+        </table>","+    {% endif %}","+{% endmacro %}","+","+{% macro render_bytes(bytes) %}","+    {%- if bytes is null or bytes == 0 -%}","+        <span class=\"text-muted\">&ndash;</span>","+    {%- elseif bytes < 1024 -%}","+        {{- bytes }} B","+    {%- else -%}","+        {{- (bytes / 1024)|number_format(1) }} KiB","+    {%- endif -%}","+{% endmacro %}","+","+{% macro render_caller(caller) %}","+    {%- if caller.file is null -%}","+        <span class=\"text-muted\">unknown</span>","+    {%- else -%}","+        {%- set link = caller.file|file_link(caller.line) -%}","+        {%- if link -%}","+            <a href=\"{{ link }}\" title=\"{{ caller.file }}\">{{ caller.name }}</a>","+        {%- else -%}","+            <abbr title=\"{{ caller.file }}\">{{ caller.name }}</abbr>","+        {%- endif -%}","+        <span class=\"kms-detail text-muted\">line {{ caller.line }}</span>","+    {%- endif -%}","+{% endmacro %}"],"additions":327,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/WebProfilerBundle/Resources/views/Icon/key-management.svg","lines":["@@ -0,0 +1,6 @@","+<svg xmlns=\"http://www.w3.org/2000/svg\" data-icon-name=\"icon-tabler-key\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" role=\"img\">","+    <title>Key Management</title>","+    <path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path>","+    <path d=\"M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0z\"></path>","+    <path d=\"M15 9h.01\"></path>","+</svg>"],"additions":6,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineDbal/README.md","lines":["@@ -186,10 +186,10 @@ such as `order` or a hyphenated name, is not supported, as for the Lock and"," Messenger stores. `configureSchema()` declares the table alongside the ones"," Doctrine generates, the way the Lock and Messenger tables are picked up:"," `symfony/doctrine-orm-key-management` ships the listener that calls it, and the","-FrameworkBundle registers it beside the store. Outside that wiring, create the","+`KeyManagementBundle` registers it beside the store. Outside that wiring, create the"," table with `createTable()` or with your own migration."," ","-In a Symfony application, `framework.key_management.store` wires all of this: the","+In a Symfony application, `key_management.store` wires all of this: the"," store is what `DataKeyStoreInterface` resolves to, and the store-backed encrypter"," becomes what `EnvelopeEncrypterInterface` injects, with the default client's"," encrypter behind it so the payloads written before the store keep being read. The","@@ -337,7 +337,7 @@ Requirements","   * Doctrine DBAL >= 4.3, which lifted the `final` constructor on `Type` that","     the encrypted type needs","   * An `EnvelopeEncrypterInterface` configured by the application (typically","-    via `framework.key_management`)","+    via the `key_management` configuration of `KeyManagementBundle`)"," "," Trade-offs"," ----------"],"additions":3,"deletions":3,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/Flysystem/README.md","lines":["@@ -33,7 +33,7 @@ and one per data key with a data key store."," DSN schemes"," -----------"," ","-When the FrameworkBundle is installed and `framework.key_management` is configured,","+When `KeyManagementBundle` is registered and `key_management` is configured,"," this bridge exposes three DSN schemes: one per local backend: that read"," keys through Flysystem:"," ","@@ -52,10 +52,9 @@ flysystem:","             adapter: 'asyncaws'","             options: { client: 'app.s3_client', bucket: 'kms-keys' }"," ","-framework:","-    key_management:","-        clients:","-            app: 'sodium+fly://keys.storage/keys?ext=.key'","+key_management:","+    clients:","+        app: 'sodium+fly://keys.storage/keys?ext=.key'"," ```"," "," A Flysystem instance registered by hand, or one that has to answer to another"],"additions":4,"deletions":5,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/DataCollector/KeyManagementDataCollector.php","lines":["@@ -0,0 +1,542 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\KeyManagement\\DataCollector;","+","+use Symfony\\Component\\HttpFoundation\\Request;","+use Symfony\\Component\\HttpFoundation\\Response;","+use Symfony\\Component\\HttpKernel\\DataCollector\\DataCollector;","+use Symfony\\Component\\HttpKernel\\DataCollector\\LateDataCollectorInterface;","+","+/**","+ * Gathers what the debug decorators of the component recorded during a request.","+ *","+ * What is collected is metadata and nothing else: which key an operation used, how many bytes went","+ * in and came back, how long it took. Never a plaintext, never a ciphertext, never a data key, and","+ * not the AAD either, of which only the presence is counted.","+ *","+ * Nothing is kept per call. An entity with ten encrypted columns read over fifty rows makes a","+ * thousand operations, which no reader wants listed, and which nobody wants serialized into a","+ * profile either. Each call is folded on arrival into three aggregates, so what the collector holds","+ * is bounded by the number of call sites and of keys rather than by the number of payloads:","+ *","+ *   - by caller, which answers what a piece of code costs;","+ *   - by key, which answers what a scope or a master key costs, and whether a data key is being","+ *     shared as intended;","+ *   - by service, which answers which client and which layer did the work.","+ *","+ * Durations are unioned rather than summed: an envelope call contains the store lookup and the KMS","+ * round trip it made, so adding the three would report more time than the request spent. The","+ * decorators mark where a call starts through {@see enter()}, which is what tells an outermost call","+ * from a nested one.","+ *","+ * @author Florent Morselli <florent.morselli@spomky-labs.com>","+ *","+ * @final","+ *","+ * @experimental","+ */","+class KeyManagementDataCollector extends DataCollector implements LateDataCollectorInterface","+{","+    public const string LAYER_KMS = 'kms';"],"additions":49,"deletions":0,"truncated":false}],"additions":405,"deletions":10,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-09-14T15:17:04.125371+00:00"}