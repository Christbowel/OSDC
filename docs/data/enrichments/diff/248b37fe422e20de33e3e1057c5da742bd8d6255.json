alue, err := snapshotRequest(client, http.MethodGet, namespace).Param(\"limit\", fmt.Sprint(pageLimit)).Param(\"continue\", continuation).Do(ctx).Raw()","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tvar list snapshot.SnapshotList","+\t\tif err := json.Unmarshal(value, &list); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tfor i := range list.Items {","+\t\t\tdto := snapshotDTO(&list.Items[i])","+\t\t\tif query == \"\" || matcher.MatchString(dto.Name) {","+\t\t\t\tresult = append(result, dto)","+\t\t\t}","+\t\t\tif len(result) == limit {","+\t\t\t\treturn result, nil","+\t\t\t}","+\t\t}","+\t\tif list.Continue == \"\" {","+\t\t\t// Legacy LIST cannot filter by title or continue past its limit. A dual-writer","+\t\t\t// token may come only from unified storage; its next legacy page is empty.","+\t\t\tdecoded, err := base64.StdEncoding.DecodeString(continuation)","+\t\t\tunifiedOnly := err == nil && strings.HasPrefix(string(decoded), \",\")","+\t\t\tif query != \"\" && ((continuation == \"\" && len(list.Items) >= pageLimit) ||","+\t\t\t\t(unifiedOnly && prefixFull && len(list.Items) == 0)) {","+\t\t\t\tif prefixLimit > math.MaxInt/2 {","+\t\t\t\t\treturn nil, fmt.Errorf(\"snapshot search limit is too large\")","+\t\t\t\t}","+\t\t\t\tprefixLimit *= 2","+\t\t\t\tpageLimit = prefixLimit","+\t\t\t\tcontinuation = \"\"","+\t\t\t\tprefixFull = false","+\t\t\t\tresult = result[:0]","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\treturn result, nil","+\t\t}","+\t\tif continuation == \"\" {","+\t\t\tprefixFull = len(list.Items) >= pageLimit","+\t\t}","+\t\tif list.Continue == continuation {","+\t\t\treturn nil, fmt.Errorf(\"snapshot pagination did not advance\")","+\t\t}","+\t\tcontinuation = list.Continue","+\t\tpageLimit = limit - len(result)","+\t}","+}","+","+func (hs *HTTPServer) deleteSnapshotFromAPI(c *contextmodel.ReqContext, key string, byDeleteKey bool) response.Response {","+\tclient, ctx, namespace, err := hs.snapshotClient(c)","+\tif err != nil {","+