CT, false);","+\top->children[0] = left_pullup.Rewrite(std::move(op->children[0]));","+\top->children[1] = right_pullup.Rewrite(std::move(op->children[1]));","+\tauto comparisons = setop.GetComparisons(*context);","+","+\t// EXCEPT and INTERSECT return some of the rows of the left child that they treat as equal. A filter of the left","+\t// child may run above them if it keeps or removes all equal rows: one that compares a column with constants.","+\t// A filter that stays below and can throw keeps the filters that guard it there","+\tauto &left_filters = left_pullup.filters_expr_pullup;","+\tbool keep_all = false;","+\tfor (auto &filter : left_filters) {","+\t\tkeep_all = keep_all || (filter->CanThrow() && !ComparesSetOperationColumn(*filter, comparisons, true));","+\t}","+\tvector<unique_ptr<Expression>> kept_filters;","+\tvector<unique_ptr<Expression>> pulled_filters;","+\tfor (auto &filter : left_filters) {","+\t\tif (keep_all || !ComparesSetOperationColumn(*filter, comparisons, true)) {","+\t\t\tkept_filters.push_back(std::move(filter));","+\t\t} else {","+\t\t\tpulled_filters.push_back(std::move(filter));"," \t\t}"," \t}","-\treturn op;","+\tleft_filters.clear();","+\tif (!kept_filters.empty()) {","+\t\top->children[0] = GeneratePullupFilter(std::move(op->children[0]), kept_filters);","+\t}","+\tif (!right_pullup.filters_expr_pullup.empty()) {","+\t\t// INTERSECT: a left row with an equal right row passes what the filters of the right child imply for it","+\t\tvector<reference<const Expression>> right_filters;","+\t\tfor (auto &filter : right_pullup.filters_expr_pullup) {","+\t\t\tright_filters.push_back(*filter);","+\t\t}","+\t\tFilterCombiner::GenerateJoinFilters(","+\t\t    comparisons, right_filters, JoinSide::LEFT,","+\t\t    [&](unique_ptr<Expression> left_filter) { pulled_filters.push_back(std::move(left_filter)); });","+\t\top->children[1] = GeneratePullupFilter(std::move(op->children[1]), right_pullup.filters_expr_pullup);","+\t}","+\tif (pulled_filters.empty()) {","+\t\treturn op;","+\t}","+\t// the filters refer to the columns of the left child: above the set operation these are its columns","+\tauto left_bindings = op->children[0]->GetColumnBindings();","+\tfor (auto &filter : pulled_filters) {","+\t\tfilter = ExpressionIterator::PreorderReplace<BoundColumnRefExpression>(","+\t\t    std::move(filter), [&](const BoundColumnRefExpression &colref) {","+\t\t\t    D_ASSERT(colref.Depth() == 0);","+\t\t\t    for (idx_t i = 0; i < left_bindings.size(); i++) {","+\t\t\t\t    if (left_bindings[i] == colref.Binding()) {","+\t\t\t\t\t    return colref.WithBinding(ColumnBinding(setop.table_index, ProjectionIndex(i)));","+\t\t\t\t    }","+\t\t\t    }","+\t\t\t    throw InternalException(\"Filter of a set operation refers to a column that is not one of its child\");","+\t\t    });","+\t}","+\treturn GeneratePullupFilter(std::move(op), pulled_filters);"," }"," "," } // namespace duckdb"],"additions":74,"deletions":16,"truncated":false},{"path":"src/optimizer/pushdown/pushdown_set_operation.cpp","lines":["@@ -1,4 +1,5 @@"," #include \"duckdb/optimizer/filter_pushdown.hpp\"","+#include \"duckdb/optimizer/filter_combiner.hpp\""," #include \"duckdb/optimizer/optimizer.hpp\""," #include \"duckdb/planner/binder.hpp\""," #include \"duckdb/planner/expression/bound_columnref_expression.hpp\"","@@ -25,21 +26,86 @@ static void ReplaceSetOpBindings(vector<ColumnBinding> &bindings, Filter &filter"," \t    });"," }"," ","+//! Whether a filter on the left child of an EXCEPT / INTERSECT keeps or removes all the rows that the set operation","+//! treats as equal. Only such a filter may run before the set operation, which returns some of the equal rows: it","+//! reads only columns that are compared as they are, or it compares what a column is compared as (the column under","+//! its collation) with constants. This is what a filter needs to pass the row_number() windows of CreateJoin as well.","+static bool KeepsEqualRowsTogether(const Expre