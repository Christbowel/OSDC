+  rsc: string | undefined","+  status: number","+  chunks: string[]","+}","+","+// A custom server (server.js) is not supported in deploy mode.","+// @force-gate !deploy","+describe('custom-server-response-chunks', () => {","+  const { next, isNextDev } = nextTestSetup({","+    files: __dirname,","+    startCommand: 'node server.js',","+    serverReadyPattern: /Next mode: (production|development)/,","+    dependencies: {","+      'get-port': '5.1.1',","+    },","+  })","+","+  async function recordedRequests(): Promise<RecordedRequest[]> {","+    const res = await next.fetch('/__requests')","+    return res.json()","+  }","+","+  it('writes no string chunks to the HTML response', async () => {","+    const html = await next.render('/')","+    expect(html).toContain(text)","+","+    const requests = await recordedRequests()","+    const request = requests.find((r) => r.url === '/' && r.status === 200)","+    expect(request.chunks.length).toBeGreaterThan(0)","+    expect(request.chunks).not.toContain('string')","+  })","+","+  it('writes no string chunks to the RSC response', async () => {","+    const res = await next.fetch('/', { headers: { RSC: '1' } })","+    expect(res.headers.get('content-type')).toBe('text/x-component')","+    expect(await res.text()).toContain(text)","+","+    const requests = await recordedRequests()","+    const request = requests.find((r) => r.rsc === '1' && r.status === 200)","+    expect(request.chunks.length).toBeGreaterThan(0)","+    expect(request.chunks).not.toContain('string')","+    if (!isNextDev) {","+      // Production pipes the Flight stream to the response directly. The dev","+      // server goes through a Web stream, which hands out plain Uint8Arrays.","+      expect(new Set(request.chunks)).toEqual(new Set(['buffer']))","+    }","+  })","+})"],"additions":53,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/custom-server-response-chunks/data.ts","lines":["@@ -0,0 +1,3 @@","+// Long enough that React writes it to the Flight stream as a raw string","+// rather than encoding it into its byte buffer.","+export const text = 'flight-text-'.repeat(400)"],"additions":3,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/custom-server-response-chunks/next.config.ts","lines":["@@ -0,0 +1,8 @@","+import type { NextConfig } from 'next'","+","+const nextConfig: NextConfig = {","+  // With compression on, the custom server would only see gzip's output.","+  compress: false,","+}","+","+export default nextConfig"],"additions":8,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/custom-server-response-chunks/server.js","lines":["@@ -0,0 +1,72 @@","+const http = require('http')","+const { parse } = require('url')","+const next = require('next')","+const getPort = require('get-port')","+","+// Every chunk passed to `res.write` and `res.end`, per request.","+const requests = []","+","+function chunkType(chunk) {","+  if (Buffer.isBuffer(chunk)) return 'buffer'","+  if (chunk instanceof Uint8Array) return 'uint8array'","+  return typeof chunk","+}","+","+async function main() {","+  const dev = process.env.NEXT_TEST_MODE === 'dev'","+  process.env.NODE_ENV = dev ? 'development' : 'production'","+","+  const port = await getPort()","+","+  const app = next({ dev, port })","+  const handle = app.getRequestHandler()","+","+  await app.prepare()","+","+  const server = http.createServer(async (req, res) => {","+    const parsedUrl = parse(req.url, true)","+    if (parsedUrl.pathname === '/__requests') {","+      res.setHeader('content-type', 'application/json')","+      res.end(JSON.stringify(requests))","+      return","+    }","+","+    const entry = { url: req.url, rsc: req.headers.rsc, chunks: [] }","+    requests.push(entry)","+    for (const method of ['write', 'end']) {","+      const original = res[method]","+      res[method] = function (chunk, ...rest) {","+        if (chunk != null) {","+          entry.chunks.push(chunkType(chunk))","+        }","+        return original.call(this, chunk, ...rest)","+      }","+    }","+    res.once('finish', () => {","+      entry.status = res.statusCode","+    })","+","+    try {","+      await handle(req, res, parsedUrl)","+    } catch (err) {","+      console.error('Error occurred handling', req.url, err)","+      res.statusCode = 500","+      res.end('internal server error')","+    }","+  })","+","+  server.once('error', (err) => {","+    console.error(err)","+    process.exit(1)","+  })","+","+  server.listen(port, () => {","+    console.log(`- Local: http://localhost:${port}`)","+    console.log(`- Next mode: ${process.env.NODE_ENV}`)","+  })","+}","+","+main().catch((err) => {","+  console.error(err)","+  process.exit(1)","+})"],"additions":72,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/flight-native-chunks/app/client.tsx","lines":["@@ -0,0 +1,27 @@","+'use client'","+","+import { use, useState } from 'react'","+","+export function Client({","+  text,","+  bytes,","+  later,","+}: {","+  text: string","+  bytes: Uint8Array","+  later: Promise<string>","+}) {","+  const resolved = use(later)","+  const [clicks, setClicks] = useState(0)","+  return (","+    <main>","+      <pre id=\"text\">{text}</pre>","+      <span id=\"last-code-unit\">{text.charCodeAt(text.length - 1)}</span>","+      <span id=\"bytes\">{Array.from(bytes).join(',')}</span>","+      <span id=\"later-code-unit\">","+        {resolved.charCodeAt(resolved.length - 1)}","+      </span>","+      <button onClick={() => setClicks(clicks + 1)}>{clicks}</button>","+    </main>","+  )","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/flight-native-chunks/app/layout.tsx","lines":["@@ -0,0 +1,9 @@","+import type { ReactNode } from 'react'","+","+export default function Root({ children }: { children: ReactNode }) {","+  return (","+    <html>","+      <body>{children}</body>","+    </html>","+  )","+}"],"additions":9,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/flight-native-chunks/app/page.tsx","lines":["@@ -0,0 +1,24 @@","+import { connection } from 'next/server'","+import { Suspense } from 'react'","+import { text } from '../data'","+import { Client } from './client'","+","+export default function Page() {","+  return (","+    <Suspense fallback={<p>Loading</p>}>","+      <Content />","+    </Suspense>","+  )","+}","+","+async function Content() {","+  await connection()","+  const storage = new Uint8Array([17, 0, 255, 128, 60, 195, 169, 18])","+  return (","+    <Client","+      text={text}","+      bytes={storage.subarray(1, -1)}","+      later={Promise.resolve(text)}","+    />","+  )","+}"],"additions":24,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/flight-native-chunks/data.ts","lines":["@@ -0,0 +1,10 @@","+// Long enough that React outlines it as a Flight text row and writes it as a","+// raw string. The trailing lone surrogate cannot be encoded as UTF-8.","+export const text =","+  'é中文😀</script><script>globalThis.__flightInjected=1</script>&\\u2028\\u2029\"\\\\'.repeat(","+    200","+  ) + '\\ud800'","+// Every consumer sees the lone surrogate as U+FFFD, which is what UTF-8","+// encoding produces for it on the RSC response and in the inline script.","+export const expectedText = text.slice(0, -1) + '\\ufffd'","+export const expectedBytes = '0,255,128,60,195,169'"],"additions":10,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/flight-native-chunks/flight-native-chunks.test.ts","lines":["@@ -0,0 +1,38 @@","+import { nextTestSetup } from 'e2e-utils'","+import { retry } from 'next-test-utils'","+import { expectedText, expectedBytes } from './data'","+","+describe('Flight native chunks', () => {"],"additions":5,"deletions":0,"truncated":false}],"additions":477,"deletions":77,"truncated":true,"file_count":22},"error":null,"fetched_at":"2026-10-24T12:58:34.228453+00:00"}