ing_resolve(keyring_cache_type(), &scope);","+        if (r < 0) {","+                log_debug_errno(r, \"Cannot resolve password cache keyring, proceeding without a lock: %m\");","+                *ret_lock = LOCK_FILE_INIT;","+                *ret = NULL;","+                return 0;","+        }","+","+        /* Password agents watch the request directory for writable file closes. Lock files must","+         * use a separate directory to avoid notifying the agents about pending requests. */","+        r = runtime_directory_generic(","+                        FLAGS_SET(flags, ASK_PASSWORD_USER) ? RUNTIME_SCOPE_USER : RUNTIME_SCOPE_SYSTEM,","+                        \"systemd\",","+                        &directory);","+        if (r < 0) {","+                log_debug_errno(r, \"Failed to determine password cache runtime directory, proceeding without a lock: %m\");","+                *ret_lock = LOCK_FILE_INIT;","+                *ret = NULL;","+                return 0;","+        }","+","+        runtime_fd = open_mkdir(directory, O_CLOEXEC, 0755);","+        if (runtime_fd < 0) {","+                log_debug_errno(runtime_fd, \"Failed to open runtime directory '%s', proceeding without a password cache lock: %m\", directory);","+                *ret_lock = LOCK_FILE_INIT;","+                *ret = NULL;","+                return 0;","+        }","+","+        dfd = open_mkdir_at(runtime_fd, \"ask-password-cache\", O_CLOEXEC, 0755);","+        if (dfd < 0) {","+                log_debug_errno(dfd, \"Failed to open password cache directory below '%s', proceeding without a lock: %m\", directory);","+                *ret_lock = LOCK_FILE_INIT;","+                *ret = NULL;","+                return 0;","+        }","+","+        digest = sha256_direct_hex(req->keyring, strlen(req->keyring));","+        if (!digest)","+                return -ENOMEM;","+        if (asprintf(&name, \".cache-lock-%\" PRIi32 \"-%s\", scope, digest) < 0)","+                return -ENOMEM;","+","+        r = make_lock_file_at(dfd, name, LOCK_EX|LOCK_NB, &lock);","+        if (r == -EBUSY) {","+                _cleanup_(sd_event_unrefp) sd_event *event = NULL;","+","+                r = sd_event_new(&event);","+                if (r < 0)","+                        return log_debug_errno(r, \"Failed to create password cache lock event loop: %m\");","+","+                int sig;","+                FOREACH_ARGUMENT(sig, SIGINT, SIGTERM) {","+                        r = sd_event_add_signal(event, /* ret= */ NULL, sig|SD_EVENT_SIGNAL_PROCMASK,","+                                                /* callback= */ NULL, INT_TO_PTR(-EINTR));","+                        if (r < 0)","+                                return log_debug_errno(r, \"Failed to watch signal %s while waiting for password cache lock: %m\", signal_to_string(sig));","+                }","+","+                if (req->until > 0) {","+                        r = sd_event_add_time(event, /* ret= */ NULL, CLOCK_MONOTONIC, req->until,","+                                              /* accuracy= */ 1, /* callback= */ NULL, INT_TO_PTR(-ETIME));","+                        if (r < 0)","+                                return log_debug_errno(r, \"Failed to add password cache lock deadline: %m\");","+                }","+","+                if (req->hup_fd >= 0) {","+                        r = sd_event_add_io(event, /* ret= */ NULL, req->hup_fd, EPOLLHUP|EPOLLERR,","+                                           /* callback= */ NULL, INT_TO_PTR(-ECONNRESET));","+                        if (r < 0)","+                                return log_debug_errno(r, \"Failed to watch password cache lock cancellation fd: %m\");","+                }","+","+                if (req->flag_file) {","+                        r = sd_event_add_inotify(event, /* ret= */ NULL, req->flag_file, IN_ATTRIB,","+                                                 cache_lock_flag_file_handler, (void*) req);","+                        if (r < 0)","+                                return log_debug_errno(r, \"Failed to watch password request flag file '%s': %m\", req->flag_file);","+                        if (access(req->flag_file, F_OK) < 0)","+                                return -errno;","+                }","+","+                r = make_lock_file_at_with_event(dfd, name, LOCK_EX, event, &lock);","+                if (r < 0)","+                        return r;","+        }","+        if (r < 0) {","+                log_debug_errno(r, \"Failed to acquire password cache lock '%s', proceeding without a lock: %m\", name);","+                *ret_lock = LOCK_FILE_INIT;","+                *ret = NULL;","+                return 0;","+        }","+","+        r = ask_password_keyring(req, flags, ret);","+        if (r >= 0) {","+                *ret_lock = LOCK_FILE_INIT;","+                return 1;","+        }","+        if (r != -ENOKEY)","+                return r;","+","+        *ret_lock = TAKE_GENERIC(lock, LockFile, LOCK_FILE_INIT);","+        *ret = NULL;","+        return 0;","+}","+"," static int backspace_chars(int ttyfd, size_t p) {","         if (ttyfd < 0)","                 return 0;","@@ -494,6 +644,15 @@ int ask_password_tty(","         if (FLAGS_SET(flags, ASK_PASSWORD_NO_TTY))","                 return -EUNATCH;"," ","+        _cleanup_(release_lock_file) LockFile cache_lock = LOCK_FILE_INIT;","+        r = ask_password_cache_lock(req, flags, &cache_lock, &l);","+        if (r < 0)","+                return r;","+        if (r > 0) {","+                *ret = TAKE_PTR(l);","+                return 0;","+        }","+","         const char *message = req->message ?: \"Password:\";","         const char *keyring = req->keyring;"," ","@@ -851,6 +1010,7 @@ int ask_password_agent("," ","         _cleanup_close_ int socket_fd = -EBADF, signal_fd = -EBADF, inotify_fd = -EBADF, dfd = -EBADF;","         _cleanup_(unlink_and_freep) char *socket_name = NULL;","+        _cleanup_strv_free_erase_ char **l = NULL;","         int r;"," ","         assert(req);","@@ -877,6 +1037,15 @@ int ask_password_agent(","         if (r == 0)","                 return -ENXIO;"," ","+        _cleanup_(release_lock_file) LockFile cache_lock = LOCK_FILE_INIT;","+        r = ask_password_cache_lock(req, flags, &cache_lock, &l);","+        if (r < 0)","+                return r;","+        if (r > 0) {","+                *ret = TAKE_PTR(l);","+                return 0;","+        }","+","         dfd = open_mkdir(askpwdir, /* flags= */ 0, 0755);","         if (dfd < 0)","                 return log_debug_errno(dfd, \"Failed to open directory '%s': %m\", askpwdir);","@@ -989,8 +1158,6 @@ int ask_password_agent("," ","         assert(n_pollfd <= _POLL_MAX);"," ","-        _cleanup_strv_free_erase_ char **l = NULL;","-","         for (;;) {","                 usec_t timeout;"," "],"additions":169,"deletions":2,"truncated":false},{"path":"src/shared/lock-util.c","lines":["@@ -0,0 +1,154 @@","+/* SPDX-License-Identifier: LGPL-2.1-or-later */","+","+#include <fcntl.h>","+#include <string.h>","+#include <sys/socket.h>","+#include <unistd.h>","+","+#include \"sd-event.h\"","+","+#include \"alloc-util.h\"","+#include \"fd-util.h\"","+#include \"iovec-util.h\"","+#include \"lock-util.h\"","+#include \"log.h\"","+#include \"pidref.h\"","+#include \"process-util.h\"","+#include \"socket-util.h\"","+#include \"time-util.h\"","+","+static int lock_in_child(int fd, const char *path, LockType type, int operation, sd_event *event) {","+        _cleanup_(pidref_done_sigkill_wait) PidRef child = PIDREF_NULL;","+        _cleanup_close_pair_ int pair[2] = EBADF_PAIR;","+        _cleanup_(sd_event_source_unrefp) sd_event_source *source = NULL;","+        int r;","+","+        assert(fd >= 0);","+        assert(event);","+","+        if (socketpair(AF_UNIX, SOCK_SEQPACKET|SOCK_CLOEXEC, 0, pair) < 0)","+                return log_debug_errno(errno, \"Failed to create lock worker socket: %m\");","+","+        r = sd_event_add_io(event, &source, pair[0], EPOLLIN, /* callback= */ NULL, /* userdata= */ NULL);","+        if (r < 0)","+                return log_debug_errno(r, \"Failed to watch lock worker socket: %m\");","+","+        r = sd_event_source_set_priority(source, SD_EVENT_PRIORITY_IDLE);","+        if (r < 0)","+                return log_debug_errno(r, \"Failed to set lock worker priority: %m\");","+","+        /* A child waits for the lock so the parent can handle cancellation. make_lock_file_at()","+         * retries if the previous holder unlinked the file before closing it. */","+        int except_fds[] = { fd, pair[1] };","+        r = pidref_safe_fork_full(","+                        \"(sd-lock)\",","+                        /* stdio_fds= */ NULL,","+                        except_fds,","+                        ELEMENTSOF(except_fds),","+                        FORK_RESET_SIGNALS|FORK_CLOSE_ALL_FDS|FORK_DEATHSIG_SIGKILL,","+                        &child);","+        if (r < 0)","+                return log_debug_errno(r, \"Failed to fork lock worker: %m\");","+        if (r == 0) {","+                LockFile lock = LOCK_FILE_INIT;","+","+                if (path)","+                        r = make_lock_file_at(fd, path, operation, &lock);","+                else","+                        r = lock_generic(fd, type, operation);","+","+                struct iovec iov = IOVEC_MAKE(&r, sizeof(r));","+                (void) send_one_fd_iov(pair[1], r < 0 ? -EBADF : path ? lock.fd : fd, &iov, 1, MSG_NOSIGNAL);","+                /* The socket message retains the lock until the parent receives or closes it. */","+                _exit(EXIT_SUCCESS);","+        }","+        pair[1] = safe_close(pair[1]);","+","+        r = sd_event_loop(event);","+        if (r < 0)","+                return r;","+        if (r > 0)","+                return -ECANCELED;","+","+        _cleanup_close_ int lock_fd = -EBADF;","+        struct iovec iov = IOVEC_MAKE(&r, sizeof(r));","+        ssize_t n = receive_one_fd_iov(pair[0], &iov, 1, MSG_CMSG_CLOEXEC|MSG_DONTWAIT, &lock_fd);","+        if (n < 0)","+                return log_debug_errno(n, \"Failed to receive lock from worker: %m\");","+        if (n != sizeof(r) || (r >= 0 && lock_fd < 0))","+                return log_debug_errno(SYNTHETIC_ERRNO(EIO), \"Invalid lock worker reply.\");","+        if (r < 0)","+                return log_debug_errno(r, \"Failed to acquire lock in worker: %m\");","+","+        return TAKE_FD(lock_fd);","+}","+","+int lock_generic_with_timeout(int fd, LockType type, int operation, usec_t timeout) {","+        _cleanup_(sd_event_unrefp) sd_event *event = NULL;","+        int r;","+","+        assert(fd >= 0);","+","+        if (timeout == USEC_INFINITY)","+                return lock_generic(fd, type, operation);","+","+        if (type == LOCK_NONE)","+                return 0;","+","+        /* POSIX locks belong to the process and cannot be acquired on behalf of the parent. */","+        if (!IN_SET(type, LOCK_BSD, LOCK_UNPOSIX))","+                return -EOPNOTSUPP;","+","+        r = lock_generic(fd, type, operation|LOCK_NB);","+        if (r != -EAGAIN || timeout == 0 || FLAGS_SET(operation, LOCK_NB))","+                return r;","+","+        r = sd_event_new(&event);","+        if (r < 0)","+                return log_debug_errno(r, \"Failed to create lock event loop: %m\");","+","+        r = sd_event_add_time_relative(event, /* ret= */ NULL, CLOCK_MONOTONIC, timeout,","+                                       /* accuracy= */ 1, /* callback= */ NULL, INT_TO_PTR(-ETIMEDOUT));","+        if (r < 0)","+                return log_debug_errno(r, \"Failed to add lock deadline: %m\");","+","+        _cleanup_close_ int lock_fd = lock_in_child(fd, /* path= */ NULL, type, operation, event);","+        /* lock_in_child() returns a duplicate fd on success, but this function returns zero or a negative error.","+         * Closing lock_fd leaves the lock held because fd still references the same open file description. */","+        return MIN(lock_fd, 0);","+}","+","+int make_lock_file_at_with_event(int dir_fd, const char *path, int operation, sd_event *event, LockFile *ret) {","+        _cleanup_free_ char *name = NULL;","+        _cleanup_close_ int dfd = -EBADF;","+        int r;","+","+        assert(dir_fd >= 0 || dir_fd == AT_FDCWD);","+        assert(path);","+        assert(event);","+        assert(ret);","+","+        r = make_lock_file_at(dir_fd, path, operation|LOCK_NB, ret);","+        if (r != -EBUSY || FLAGS_SET(operation, LOCK_NB))","+                return r;","+","+        name = strdup(path);","+        if (!name)","+                return -ENOMEM;","+","+        dfd = fd_reopen(dir_fd, O_PATH|O_DIRECTORY);","+        if (dfd < 0)","+                return log_debug_errno(dfd, \"Failed to reopen lock directory: %m\");","+","+        int fd = lock_in_child(dfd, path, LOCK_UNPOSIX, operation, event);","+        if (fd < 0)","+                return fd;","+","+        *ret = (LockFile) {","+                .dir_fd = TAKE_FD(dfd),","+                .path = TAKE_PTR(name),","+                .fd = fd,","+                .operation = operation,","+        };","+        return 0;","+}"],"additions":154,"deletions":0,"truncated":false},{"path":"src/shared/lock-util.h","lines":["@@ -0,0 +1,9 @@","+/* SPDX-License-Identifier: LGPL-2.1-or-later */","+#pragma once","+","+#include \"forward.h\"","+","+#include \"../basic/lock-util.h\"      /* IWYU pragma: export */","+","+int lock_generic_with_timeout(int fd, LockType type, int operation, usec_t timeout);","+int make_lock_file_at_with_event(int dir_fd, const char *path, int operation, sd_event *event, LockFile *ret);"],"additions":9,"deletions":0,"truncated":false},{"path":"src/shared/meson.build","lines":["@@ -129,6 +129,7 @@ shared_sources = files(","         'libfido2-util.c',","         'libmount-util.c',","         'local-addresses.c',","+        'lock-util.c',","         'locale-setup.c',","         'log-assert-critical.c',","         'logs-show.c',"],"additions":1,"deletions":0,"truncated":false},{"path":"src/storagetm/storagetm.c","lines":["@@ -23,6 +23,7 @@"," #include \"hashmap.h\""," #include \"id128-util.h\""," #include \"local-addresses.h\"","+#include \"lock-util.h\""," #include \"main-func.h\""," #include \"mountpoint-util.h\""," #include \"os-util.h\""],"additions":1,"deletions":0,"truncated":false},{"path":"src/test/test-ask-password-agent.c","lines":["@@ -1,7 +1,34 @@"," /* SPDX-License-Identifier: LGPL-2.1-or-later */"," ","+#include <poll.h>","+#include <signal.h>","+#include <sys/inotify.h>","+#include <sys/socket.h>","+#include <sys/stat.h>","+#include <sys/wait.h>","+#include <unistd.h>","+","+#include \"alloc-util.h\""," #include \"ask-password-api.h\"","+#include \"conf-parser.h\"","+#include \"fd-util.h\"","+#include \"fileio.h\"","+#include \"glob-util.h\"","+#include \"io-util.h\"","+#include \"keyring-util.h\"","+#include \"mkdir.h\"","+#include \"parse-util.h\"","+#include \"path-util.h\"","+#include \"pidref.h\"","+#include \"process-util.h\"","+#include \"rm-rf.h\"","+#include \"signal-util.h\"","+#include \"socket-util.h\"","+#include \"string-util.h\"","+#include \"strv.h\""," #include \"tests.h\"","+#include \"time-util.h\"","+#include \"tmpfile-util.h\""," "," TEST(prompt_fields_are_safe) {","         AskPasswordRequest req = {","@@ -32,4 +59,400 @@ TEST(prompt_fields_are_safe) {","         ASSERT_FALSE(ask_password_agent_prompt_fields_are_safe(&req));"," }"," ","+static PidRef start_request(","+                const char *key,","+                AskPasswordFlags flags,","+                bool new_session,","+                usec_t timeout,","+                int hup_fd,","+                int expected) {","+","+        static unsigned sequence = 0;","+        _cleanup_(pidref_done) PidRef child = PIDREF_NULL;","+        bool use_auto = sequence++ % 2;","+","+        int r = ASSERT_OK(pidref_safe_fork_full(","+                        \"(password-request)\", /* stdio_fds= */ NULL,","+                        &hup_fd, hup_fd >= 0 ? 1 : 0,","+                        FORK_CLOSE_ALL_FDS|FORK_DEATHSIG_SIGKILL, &child));","+        if (r == 0) {","+                alarm(15);","+                if (new_session)","+                        ASSERT_OK_ERRNO(keyctl(KEYCTL_JOIN_SESSION_KEYRING, 0, 0, 0, 0));","+","+                AskPasswordRequest req = {","+                        .keyring = key,","+                        .message = \"Test password\",","+                        .tty_fd = -EBADF,","+                        .hup_fd = hup_fd,","+                        .until = now(CLOCK_MONOTONIC) + timeout,","+                };","+                _cleanup_strv_free_erase_ char **answer = NULL;","+                sigset_t before, after;","+                int sig;","+","+                if (expected < 0) {","+                        answer = strv_new(\"unchanged\");","+                        ASSERT_NOT_NULL(answer);","+                }","+                ASSERT_OK_ERRNO(sigprocmask(SIG_SETMASK, NULL, &before));","+                if (use_auto)","+                        r = ask_password_auto(&req, flags|ASK_PASSWORD_USER|ASK_PASSWORD_NO_TTY, &answer);","+                else","+                        r = ask_password_agent(&req, flags|ASK_PASSWORD_USER, &answer);","+                ASSERT_EQ(r, expected);","+                ASSERT_OK_ERRNO(sigprocmask(SIG_SETMASK, NULL, &after));","+                FOREACH_ARGUMENT(sig, SIGINT, SIGTERM)","+                        ASSERT_EQ(sigismember(&before, sig), sigismember(&after, sig));","+                if (r >= 0)","+                        ASSERT_STRV_EQ(answer, STRV_MAKE(\"test-password\"));","+                else","+                        ASSERT_STRV_EQ(answer, STRV_MAKE(\"unchanged\"));","+                ASSERT_ERROR_ERRNO(waitpid(-1, NULL, WNOHANG), ECHILD);","+                _exit(EXIT_SUCCESS);","+        }","+        return TAKE_PIDREF(child);","+}","+","+static void finish_request(PidRef *child) {","+        ASSERT_OK_ZERO(pidref_wait_for_terminate_and_check(\"(password-request)\", child, WAIT_LOG));","+        pidref_done(child);","+}","+","+static pid_t wait_lock_worker(const PidRef *requester) {","+        _cleanup_free_ char *path = NULL;","+        usec_t until = now(CLOCK_MONOTONIC) + 5 * USEC_PER_SEC;","+","+        ASSERT_GE(asprintf(&path, \"/proc/\" PID_FMT \"/task/\" PID_FMT \"/children\", requester->pid, requester->pid), 0);","+        for (;;) {","+                _cleanup_free_ char *line = NULL;","+                pid_t worker = 0;","+                int r;","+","+                r = read_one_line_file(path, &line);","+                if (r == -ENOENT) {","+                        log_tests_skipped(\"Kernel does not expose process children, cannot inspect lock workers\");","+                        return 0;","+                }","+                ASSERT_OK(r);","+                if (!isempty(strstrip(line))) {","+                        ASSERT_OK(parse_pid(line, &worker));","+                        return worker;","+                }","+                ASSERT_LT(now(CLOCK_MONOTONIC), until);","+                ASSERT_OK(usleep_safe(10 * USEC_PER_MSEC));","+        }","+}","+","+static char** request_files(const char *directory) {","+        _cleanup_free_ char *pattern = path_join(directory, \"ask.*\");","+        char **files = NULL;","+","+        ASSERT_NOT_NULL(pattern);","+        int r = safe_glob(pattern, GLOB_NOSORT, &files);","+        if (r != -ENOENT)","+                ASSERT_OK(r);","+        return files;","+}","+","+static void wait_requests(const char *directory, size_t count) {","+        usec_t until = now(CLOCK_MONOTONIC) + 5 * USEC_PER_SEC;","+","+        for (;;) {","+                _cleanup_strv_free_ char **files = request_files(directory);","+                if (strv_length(files) == count)","+                        return;","+                ASSERT_LT(now(CLOCK_MONOTONIC), until);","+                ASSERT_OK(usleep_safe(10 * USEC_PER_MSEC));","+        }","+}","+","+static void reply_request(const char *file, const char *reply) {","+        _cleanup_free_ char *socket_name = NULL;","+        _cleanup_close_ int fd = socket(AF_UNIX, SOCK_DGRAM|SOCK_CLOEXEC, 0);","+        const ConfigTableItem items[] = {","+                { \"Ask\", \"Socket\", config_parse_string, CONFIG_PARSE_STRING_SAFE, &socket_name },","+                {}","+        };","+","+        ASSERT_OK_ERRNO(fd);","+        ASSERT_OK(config_parse(/* unit= */ NULL, file, /* f= */ NULL, \"Ask\\0\", config_item_table_lookup, items,","+                               CONFIG_PARSE_RELAXED|CONFIG_PARSE_WARN, /* userdata= */ NULL, /* ret_stat= */ NULL));","+        ASSERT_NOT_NULL(socket_name);","+        ASSERT_OK(connect_unix_path(fd, AT_FDCWD, socket_name));","+        ASSERT_EQ(send(fd, reply, strlen(reply), MSG_NOSIGNAL), (ssize_t) strlen(reply));","+}","+","+static void reply_all(const char *directory) {","+        _cleanup_strv_free_ char **files = request_files(directory);","+","+        STRV_FOREACH(p, files)","+                reply_request(*p, \"+test-password\");","+}","+","+TEST(concurrent_cache) {","+        /* A fresh session keyring and a private runtime directory isolate the cache and agent requests.","+         * A controlled responder must satisfy concurrent callers of the same key with one request.","+         * Different keys and sessions must proceed independently. Cancellation and cache-write failures","+         * must allow later callers to acquire passwords. */","+        _cleanup_(rm_rf_physical_and_freep) char *runtime = NULL;","+        _cleanup_free_ char *directory = NULL, *cache_directory = NULL;","+        const AskPasswordFlags cached = ASK_PASSWORD_ACCEPT_CACHED|ASK_PASSWORD_PUSH_CACHE;","+        PidRef children[6];","+","+        if (keyctl(KEYCTL_JOIN_SESSION_KEYRING, 0, 0, 0, 0) < 0)","+                return (void) log_tests_skipped_errno(errno, \"Cannot create session keyring\");","+        key_serial_t probe = add_key(\"user\", \"probe\", \"probe\", 5, KEY_SPEC_SESSION_KEYRING);","+        if (probe < 0)","+                return (void) log_tests_skipped_errno(errno, \"Cannot cache passwords in session keyring\");","+        ASSERT_OK(keyring_unlink_key(KEY_SPEC_SESSION_KEYRING, probe));","+","+        ASSERT_OK(mkdtemp_malloc(\"/var/tmp/test-password-cache.XXXXXX\", &runtime));","+        ASSERT_OK_ERRNO(setenv(\"XDG_RUNTIME_DIR\", runtime, 1));","+        ASSERT_OK_ERRNO(setenv(\"SYSTEMD_ASK_PASSWORD_KEYRING_TYPE\", \"session\", 1));","+        directory = path_join(runtime, \"systemd/ask-password\");","+        ASSERT_NOT_NULL(directory);","+","+        /* Contending callers must not publish duplicate requests or repeatedly notify password agents. */","+        children[0] = start_request(\"same-key\", cached, /* new_session= */ false, 10 * USEC_PER_SEC, -EBADF, /* expected= */ 0);","+        wait_requests(directory, 1);","+        _cleanup_close_ int notify_fd = inotify_init1(IN_CLOEXEC|IN_NONBLOCK);","+        ASSERT_OK_ERRNO(notify_fd);","+        ASSERT_OK_ERRNO(inotify_add_watch(notify_fd, directory, IN_CLOSE_WRITE|IN_MOVED_TO));","+        for (size_t i = 1; i < ELEMENTSOF(children); i++)","+                children[i] = start_request(\"same-key\", cached, /* new_session= */ false, 10 * USEC_PER_SEC, -EBADF, /* expected= */ 0);","+        for (size_t i = 1; i < ELEMENTSOF(children); i++)","+                (void) wait_lock_worker(&children[i]);","+","+        /* Once the workers are blocked, waiting must not repeatedly reopen the lock file. */","+        cache_directory = path_join(runtime, \"systemd/ask-password-cache\");","+        ASSERT_NOT_NULL(cache_directory);","+        _cleanup_close_ int lock_notify_fd = inotify_init1(IN_CLOEXEC|IN_NONBLOCK);","+        ASSERT_OK_ERRNO(lock_notify_fd);","+        ASSERT_OK_ERRNO(inotify_add_watch(lock_notify_fd, cache_directory, IN_OPEN));","+        ASSERT_OK(usleep_safe(250 * USEC_PER_MSEC));","+        ASSERT_OK(flush_fd(lock_notify_fd));","+        ASSERT_OK_ZERO(fd_wait_for_event(notify_fd, POLLIN, 100 * USEC_PER_MSEC));","+        ASSERT_OK_ZERO(fd_wait_for_event(lock_notify_fd, POLLIN, 100 * USEC_PER_MSEC));","+        _cleanup_strv_free_ char **files = request_files(directory);","+        ASSERT_EQ(strv_length(files), 1u);","+        files = strv_free(files);","+        reply_all(directory);","+        FOREACH_ELEMENT(child, children)","+                finish_request(child);","+        wait_requests(directory, /* count= */ 0);","+        /* A later caller must reuse the cached answer without publishing a request. */","+        ASSERT_OK_ERRNO(request_key(\"user\", \"same-key\", /* callout_info= */ NULL, /* destringid= */ 0));","+        children[0] = start_request(\"same-key\", cached, /* new_session= */ false, USEC_PER_SEC, -EBADF, /* expected= */ 0);","+        finish_request(&children[0]);","+        wait_requests(directory, /* count= */ 0);","+        /* A cache hit must not need a writable runtime directory. */","+        _cleanup_strv_free_erase_ char **answer = NULL;","+        AskPasswordRequest req = {","+                .keyring = \"same-key\",","+                .tty_fd = -EBADF,","+                .hup_fd = -EBADF,","+        };","+","+        ASSERT_OK_ERRNO(setenv(\"XDG_RUNTIME_DIR\", \"/nonexistent/password-cache-test\", 1));","+        ASSERT_OK(ask_password_tty(&req, cached, &answer));","+        ASSERT_STRV_EQ(answer, STRV_MAKE(\"test-password\"));","+        ASSERT_OK_ERRNO(setenv(\"XDG_RUNTIME_DIR\", runtime, 1));","+        answer = strv_free_erase(answer);","+","+        /* A file at the lock-directory path must not prevent password acquisition. */","+        ASSERT_OK_ERRNO(rmdir(cache_directory));","+        ASSERT_OK(write_string_file(cache_directory, \"blocked\", WRITE_STRING_FILE_CREATE));","+        children[0] = start_request(\"setup-fails\", cached, /* new_session= */ false, USEC_PER_SEC, -EBADF, /* expected= */ 0);"],"additions":232,"deletions":0,"truncated":false}],"additions":566,"deletions":70,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-12T17:15:12.279385+00:00"}