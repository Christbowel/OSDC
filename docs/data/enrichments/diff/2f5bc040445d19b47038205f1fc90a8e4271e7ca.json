;","-        if (r != -EAGAIN || timeout == 0 || FLAGS_SET(operation, LOCK_NB))","-                return r;","-","-        /* If that didn't work, try with a child */","-        _cleanup_(pidref_done_sigkill_wait) PidRef pidref = PIDREF_NULL;","-        r = pidref_safe_fork(\"(sd-flock)\", FORK_RESET_SIGNALS|FORK_DEATHSIG_SIGKILL, &pidref);","-        if (r < 0)","-                return log_error_errno(r, \"Failed to flock block device in child process: %m\");","-        if (r == 0) {","-                r = lock_generic(fd, type, operation);","-                if (r < 0) {","-                        log_error_errno(r, \"Unable to get an exclusive lock on the device: %m\");","-                        _exit(EXIT_FAILURE);","-                }","-","-                _exit(EXIT_SUCCESS);","-        }","-","-        siginfo_t status;","-        r = pidref_wait_for_terminate_full(&pidref, timeout, &status);","-        if (r < 0)","-                return r;","-","-        pidref_done(&pidref);","-","-        switch (status.si_code) {","-","-        case CLD_EXITED:","-                if (status.si_status != EXIT_SUCCESS)","-                        return -EPROTO;","-","-                return 0;","-","-        case CLD_KILLED:","-        case CLD_DUMPED:","-                return -EPROTO;","-","-        default:","-                assert_not_reached();","-        }","-}"],"additions":0,"deletions":66,"truncated":false},{"path":"src/basic/lock-util.h","lines":["@@ -44,5 +44,3 @@ typedef enum LockType {"," } LockType;"," "," int lock_generic(int fd, LockType type, int operation);","-","-int lock_generic_with_timeout(int fd, LockType type, int operation, usec_t timeout);"],"additions":0,"deletions":2,"truncated":false},{"path":"src/shared/ask-password-api.c","lines":["@@ -9,6 +9,8 @@"," #include <termios.h>"," #include <unistd.h>"," ","+#include \"sd-event.h\"","+"," #include \"alloc-util.h\""," #include \"ansi-color.h\""," #include \"ask-password-api.h\"","@@ -22,6 +24,7 