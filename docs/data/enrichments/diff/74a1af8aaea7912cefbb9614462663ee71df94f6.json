eturn this._checked;","+\t}","+","+\t/** Sets the state without firing {@link onChange}. */","+\tset checked(checked: boolean) {","+\t\tif (this._checked !== checked) {","+\t\t\tthis._checked = checked;","+\t\t\tthis._applyState();","+\t\t}","+\t}","+","+\tget disabled(): boolean {","+\t\treturn this.domNode.disabled;","+\t}","+","+\tset disabled(disabled: boolean) {","+\t\tthis.domNode.disabled = disabled;","+\t}","+","+\tsetAriaLabel(ariaLabel: string, title = ariaLabel): void {","+\t\tthis.domNode.setAttribute('aria-label', ariaLabel);","+\t\tthis._title = title;","+\t}","+","+\tprivate _applyState(): void {","+\t\tthis.domNode.setAttribute('aria-checked', String(this._checked));","+\t\tthis.domNode.classList.toggle('checked', this._checked);","+\t}","+}"],"additions":99,"deletions":0,"truncated":false},{"path":"src/vs/base/test/browser/domSanitize.test.ts","lines":["@@ -4,10 +4,13 @@","  *--------------------------------------------------------------------------------------------*/"," "," import * as assert from 'assert';","-import { sanitizeHtml } from '../../browser/domSanitize.js';","+import { sanitizeHtml, sanitizeSurvivingStalePolicy } from '../../browser/domSanitize.js';"," import { Schemas } from '../../common/network.js';"," import { ensureNoDisposablesAreLeakedInTestSuite } from '../common/utils.js';"," ","+/** Derived from the function under test, since dompurify may not be imported directly. */","+type SanitizeConfig = Parameters<typeof sanitizeSurvivingStalePolicy>[1];","+"," suite('DomSanitize', () => {"," "," \tensureNoDisposablesAreLeakedInTestSuite();","@@ -257,4 +260,52 @@ suite('DomSanitize', () => {"," \t\t\tassert.strictEqual(result.toString(), '<div><custom>allowed</custom>&lt;forbidden&gt;not allowed&lt;/forbidden&gt;</div>');"," \t\t});"," \t});","+","+\tsuite('stale trusted types policy', () => {","+","+\t\tconst STALE_POLICY_ERROR = `Failed to execute 'createHTML' on 'TrustedTypePolicy': The provided callback is no longer runnable.`;","+","+\t\t/**","+\t\t * Stands in for dompurify, failing the first call the way a policy whose creating","+\t\t * realm is gone fails. The sanitizer keeps one policy for the lifetime of the","+\t\t * module, so a stand-in policy installed after anything has sanitized is never","+\t\t * consulted; driving the call itself is what makes this independent of test order.","+\t\t */","+\t\tfunction failingOnce(message: string) {","+\t\t\tconst configs: (SanitizeConfig | undefined)[] = [];","+\t\t\tlet failed = false;","+\t\t\tconst sanitize = (untrusted: string, config: SanitizeConfig) => {","+\t\t\t\tconfigs.push(config);","+\t\t\t\tif (!failed) {","+\t\t\t\t\tfailed = true;","+\t\t\t\t\tthrow new Error(message);","+\t\t\t\t}","+\t\t\t\treturn `sanitized:${untrusted}`;","+\t\t\t};","+\t\t\treturn { sanitize, configs };","+\t\t}","+","+\t\ttest('retries with a replacement policy when the sanitizer policy stops working', () => {","+\t\t\tconst { sanitize, configs } = failingOnce(STALE_POLICY_ERROR);","+","+\t\t\tconst result = sanitizeSurvivingStalePolicy('<div>safe</div>', {}, sanitize);","+","+\t\t\tassert.deepStrictEqual(","+\t\t\t\t{","+\t\t\t\t\tresult,","+\t\t\t\t\tattempts: configs.length,","+\t\t\t\t\tfirstHadPolicy: configs[0]?.TRUSTED_TYPES_POLICY !== undefined,","+\t\t\t\t\tretriedWithPolicy: typeof configs[1]?.TRUSTED_TYPES_POLICY?.createHTML === 'function',","+\t\t\t\t},","+\t\t\t\t{ result: 'sanitized:<div>safe</div>', attempts: 2, firstHadPolicy: false, retriedWithPolicy: true },","+\t\t\t);","+\t\t});","+","+\t\ttest('a failure that is not a stale policy is not retried', () => {","+\t\t\tconst { sanitize, configs } = failingOnce('Some other sanitizer failure');","+","+\t\t\tassert.throws(() => sanitizeSurvivingStalePolicy('<div>safe</div>', {}, sanitize), /Some other sanitizer failure/);","+\t\t\tassert.strictEqual(configs.length, 1);","+\t\t});","+\t});"," });"],"additions":52,"deletions":1,"truncated":false},{"path":"src/vs/platform/actionWidget/browser/acti