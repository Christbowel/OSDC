{"id":"73e41883b714a935b7f28ea0a9c112a727f541f8","axis":"silent","repo":"TYPO3/typo3","sha":"73e41883b714a935b7f28ea0a9c112a727f541f8","parsed":{"files":[{"path":"typo3/sysext/core/Classes/Imaging/GraphicalFunctions.php","lines":["@@ -130,6 +130,11 @@ class GraphicalFunctions","     protected bool $processorEnabled;","     protected bool $mayScaleUp = true;"," ","+    /**","+     * Whether a scaled-down JPEG, WebP or AVIF image is sharpened slightly (GFX/sharpen)","+     */","+    protected bool $sharpen = false;","+","     /**","      * Filename prefix for images scaled in imageMagickConvert()","      *","@@ -227,16 +232,7 @@ public function __construct()","         $this->addFrameSelection = (bool)$gfxConf['processor_allowFrameSelection'];","         $this->imageFileExt = GeneralUtility::trimExplode(',', $gfxConf['imagefile_ext']);"," ","-        // Processor Effects. This is necessary if using ImageMagick 5+.","-        // Effects in Imagemagick 5+ tends to render very slowly!","-        // Therefore, must be disabled in order not to perform sharpen, blurring and such.","-        // but if 'processor_effects' is set, enable effects","-        if ($gfxConf['processor_effects']) {","-            $this->cmds['jpg'] = $this->v5_sharpen(10);","-            $this->cmds['jpeg'] = $this->v5_sharpen(10);","-            $this->cmds['webp'] = $this->v5_sharpen(10);","-            $this->cmds['avif'] = $this->v5_sharpen(10);","-        }","+        $this->sharpen = (bool)($gfxConf['sharpen'] ?? false);","         // Secures that images are not scaled up.","         $this->mayScaleUp = (bool)$gfxConf['processor_allowUpscaling'];"," ","@@ -461,6 +457,15 @@ public function resize(string $sourceFile, string $targetFileExtension, int|stri","         // Add params","         $additionalParameters = $this->modifyImageMagickStripProfileParameters($additionalParameters, $options);","         $command .= ($additionalParameters ? ' ' . $additionalParameters : $this->cmds[$targetFileExtension] ?? '');","+        if (!$additionalParameters && $this->sharpen && in_array($targetFileExtension, ['jpg', 'jpeg', 'webp', 'avif'], true)) {","+            $sourceWidth = $processingInstructions->cropArea ? (int)round($processingInstructions->cropArea->getWidth()) : $info->getWidth();","+            $sourceHeight = $processingInstructions->cropArea ? (int)round($processingInstructions->cropArea->getHeight()) : $info->getHeight();","+            $scaledDown = $processingInstructions->width <= $sourceWidth && $processingInstructions->height <= $sourceHeight","+                && ($processingInstructions->width < $sourceWidth || $processingInstructions->height < $sourceHeight);","+            if ($scaledDown) {","+                $command .= ' -unsharp 1x2+0.25+0';","+            }","+        }"," ","         // Add quality parameter for jpg, jpeg or webp if not already set","         if (!str_contains($command, '-quality') && ($targetFileExtension === 'jpg' || $targetFileExtension === 'jpeg')) {"],"additions":15,"deletions":10,"truncated":false},{"path":"typo3/sysext/core/Classes/Service/SilentConfigurationUpgradeService.php","lines":["@@ -241,7 +241,7 @@ public function execute(): void","         $this->migrateImageProcessorSetting();","         $this->transferHttpSettings();","         $this->disableImageMagickDetailSettingsIfImageMagickIsDisabled();","-        $this->setImageMagickDetailSettings();","+        $this->migrateSharpenSetting();","         $this->removeDefaultColorspaceSettings();","         $this->migrateLockSslSetting();","         $this->migrateDatabaseConnectionSettings();","@@ -557,39 +557,21 @@ protected function disableImageMagickDetailSettingsIfImageMagickIsDisabled(): vo","     }"," ","     /**","-     * Detail configuration of Image Magick and Graphics Magick settings","-     * depending on main values.","-     *","-     * \"Configuration presets\" in install tool is not type safe, so value","-     * comparisons here are not type safe too, to not trigger changes to","-     * LocalConfiguration again.","+     * GFX/processor_effects only ever sharpened the scaled JPEG, WebP and","+     * AVIF output, so it is renamed to GFX/sharpen.","      *","      * @throws ConfigurationChangedException","      */","-    protected function setImageMagickDetailSettings(): void","+    protected function migrateSharpenSetting(): void","     {","-        $changedValues = [];","-        try {","-            $currentProcessorValue = $this->configurationManager->getLocalConfigurationValueByPath('GFX/processor');","-        } catch (MissingArrayPathException) {","-            $currentProcessorValue = $this->configurationManager->getDefaultConfigurationValueByPath('GFX/processor');","-        }","-","         try {","-            $currentProcessorEffectsValue = $this->configurationManager->getLocalConfigurationValueByPath('GFX/processor_effects');","+            $sharpen = (bool)$this->configurationManager->getLocalConfigurationValueByPath('GFX/processor_effects');","         } catch (MissingArrayPathException) {","-            $currentProcessorEffectsValue = $this->configurationManager->getDefaultConfigurationValueByPath('GFX/processor_effects');","-        }","-","-        if ((string)$currentProcessorValue !== '') {","-            if (!is_bool($currentProcessorEffectsValue)) {","-                $changedValues['GFX/processor_effects'] = (int)$currentProcessorEffectsValue > 0;","-            }","-        }","-        if (!empty($changedValues)) {","-            $this->configurationManager->setLocalConfigurationValuesByPathValuePairs($changedValues);","-            $this->throwConfigurationChangedException();","+            return;","         }","+        $this->configurationManager->setLocalConfigurationValueByPath('GFX/sharpen', $sharpen);","+        $this->configurationManager->removeLocalConfigurationKeysByPath(['GFX/processor_effects']);","+        $this->throwConfigurationChangedException();","     }"," ","     /**","@@ -604,7 +586,6 @@ protected function migrateImageProcessorSetting(): void","         $settingsToRename = [","             'GFX/im' => 'GFX/processor_enabled',","             'GFX/im_version_5' => 'GFX/processor',","-            'GFX/im_v5effects' => 'GFX/processor_effects',","             'GFX/im_path' => 'GFX/processor_path',","             'GFX/im_path_lzw' => 'GFX/processor_path_lzw',","             'GFX/im_mask_temp_ext_gif' => 'GFX/processor_allowTemporaryMasksAsPng',"],"additions":9,"deletions":28,"truncated":false},{"path":"typo3/sysext/core/Configuration/DefaultConfiguration.php","lines":["@@ -55,7 +55,7 @@","         'processor_enabled' => true,","         'processor_path' => '/usr/bin/',","         'processor' => 'ImageMagick',","-        'processor_effects' => false,","+        'sharpen' => true,","         'processor_allowUpscaling' => true,","         'processor_allowFrameSelection' => true,","         'processor_stripColorProfileByDefault' => true,"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Configuration/DefaultConfigurationDescription.yaml","lines":["@@ -24,9 +24,9 @@ GFX:","               'ImageMagick': 'Choose ImageMagick for processing images'","               'GraphicsMagick': 'Choose GraphicsMagick for processing images'","             description: 'Select which external software on the server should process images - see also the Preset functionality to see what is available.'","-        processor_effects:","+        sharpen:","             type: bool","-            description: 'If enabled, apply blur and sharpening in ImageMagick/GraphicMagick functions'","+            description: 'If enabled, ImageMagick and GraphicsMagick sharpen JPEG, WebP and AVIF images slightly when they scale them down.'","         processor_allowUpscaling:","             type: bool","             description: 'If set, images can be scaled up if told so (in <code>\\TYPO3\\CMS\\Core\\Imaging\\GraphicalFunctions</code>)'"],"additions":2,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Breaking-111109-GFXSettingProcessorEffectsRenamedToSharpen.rst","lines":["@@ -0,0 +1,60 @@","+..  include:: /Includes.rst.txt","+","+..  _breaking-111109-1792229915:","+","+====================================================================","+Breaking: #111109 - GFX setting processor_effects renamed to sharpen","+====================================================================","+","+See :issue:`111109`","+","+Description","+===========","+","+The setting :php:`$GLOBALS['TYPO3_CONF_VARS']['GFX']['processor_effects']`","+has been renamed to :php:`$GLOBALS['TYPO3_CONF_VARS']['GFX']['sharpen']`,","+which is what it does. Its description claimed that it enabled blurring and","+sharpening, which it did not.","+","+What the setting does has changed as well. ImageMagick and GraphicsMagick","+used to sharpen every scaled JPEG, WebP and AVIF image with","+`-sharpen 1x2`, which made edges noticeably harder and the files a quarter","+larger. They now sharpen these images with the lighter `-unsharp 1x2+0.25+0`,","+and only when they scale them down. A scaled-up image gains next to nothing","+from sharpening and is no longer sharpened. Which formats are sharpened does","+not change: JPEG, WebP and AVIF, as before; PNG and GIF never were.","+","+The setting is enabled by default, and both the ImageMagick and the","+GraphicsMagick preset of the Install Tool enable it. GraphicsMagick sharpens","+with the same parameters as ImageMagick.","+","+The upgrade migrates the setting in :file:`config/system/settings.php`.","+","+Impact","+======","+","+Extensions that read the setting `processor_effects` no longer find it.","+","+Installations that sharpened images look slightly softer after the processed","+files are generated again, and the processed JPEG, WebP and AVIF files get","+smaller. Installations that did not sharpen and have not set the option now","+sharpen scaled-down images slightly.","+","+:php:`GraphicalFunctions->cmds` no longer carries the sharpening parameters.","+","+Affected installations","+======================","+","+Extensions that read the setting. The extension scanner reports them.","+","+Installations that process images with ImageMagick or GraphicsMagick.","+","+Migration","+=========","+","+Read :php:`$GLOBALS['TYPO3_CONF_VARS']['GFX']['sharpen']` instead.","+","+To keep images unsharpened, set","+:php:`$GLOBALS['TYPO3_CONF_VARS']['GFX']['sharpen']` to :php:`false`.","+","+..  index:: LocalConfiguration, PartiallyScanned, ext:core"],"additions":60,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Imaging/GraphicalFunctionsResizeTest.php","lines":["@@ -152,4 +152,84 @@ public function resizeReturnsOriginalFileIfNothingChanges(string $fileName): voi","         self::assertNotNull($result);","         self::assertSame(realpath($sourceFile), realpath($result->getRealPath()));","     }","+","+    /**","+     * @return array<string, array{sharpen: bool, targetFileExtension: string, width: int, additionalParameters: string, expectSharpening: bool}>","+     */","+    public static function resizeSharpensOnlyScaledDownLossyImagesDataProvider(): array","+    {","+        return [","+            'scaled down to jpg' => [","+                'sharpen' => true,","+                'targetFileExtension' => 'jpg',","+                'width' => 320,","+                'additionalParameters' => '',","+                'expectSharpening' => true,","+            ],","+            'scaled down to webp' => [","+                'sharpen' => true,","+                'targetFileExtension' => 'webp',","+                'width' => 320,","+                'additionalParameters' => '',","+                'expectSharpening' => true,","+            ],","+            'scaled up to jpg' => [","+                'sharpen' => true,","+                'targetFileExtension' => 'jpg',","+                'width' => 1280,","+                'additionalParameters' => '',","+                'expectSharpening' => false,","+            ],","+            'scaled down to png' => [","+                'sharpen' => true,","+                'targetFileExtension' => 'png',","+                'width' => 320,","+                'additionalParameters' => '',","+                'expectSharpening' => false,","+            ],","+            'scaled down to jpg with own parameters' => [","+                'sharpen' => true,","+                'targetFileExtension' => 'jpg',","+                'width' => 320,","+                'additionalParameters' => '-quality 70',","+                'expectSharpening' => false,","+            ],","+            'scaled down to jpg with sharpen disabled' => [","+                'sharpen' => false,","+                'targetFileExtension' => 'jpg',","+                'width' => 320,","+                'additionalParameters' => '',","+                'expectSharpening' => false,","+            ],","+        ];","+    }","+","+    #[DataProvider('resizeSharpensOnlyScaledDownLossyImagesDataProvider')]","+    #[Test]","+    public function resizeSharpensOnlyScaledDownLossyImages(","+        bool $sharpen,","+        string $targetFileExtension,","+        int $width,","+        string $additionalParameters,","+        bool $expectSharpening","+    ): void {","+        $GLOBALS['TYPO3_CONF_VARS']['GFX']['sharpen'] = $sharpen;","+        $graphicalFunctions = new GraphicalFunctions();","+        if (!$graphicalFunctions->isProcessingEnabled()) {","+            self::markTestSkipped('Image processor (ImageMagick/GraphicsMagick) is not enabled.');","+        }","+","+        $sourceFile = Environment::getPublicPath() . '/fileadmin/user_upload/GraphicalFunctionsResize.png';","+        $result = $graphicalFunctions->resize($sourceFile, $targetFileExtension, (string)$width, '', $additionalParameters, [], true);","+","+        self::assertNotNull($result);","+        self::assertSame($width, $result->getWidth());","+        $command = end($graphicalFunctions->IM_commands)[1];","+        if ($expectSharpening) {","+            self::assertStringContainsString(' -unsharp 1x2+0.25+0 ', $command);","+        } else {","+            self::assertStringNotContainsString(' -unsharp ', $command);","+            self::assertStringNotContainsString(' -sharpen ', $command);","+        }","+    }"," }"],"additions":80,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Service/SilentConfigurationUpgradeServiceTest.php","lines":["@@ -317,16 +317,10 @@ public function doNotDisableImageMagickDetailSettingsIfImageMagickIsEnabled(): v","     }"," ","     #[Test]","-    public function doNotSetImageMagickDetailSettings(): void","+    public function sharpenSettingIsLeftAsItIs(): void","     {","-        $testConfig = [","-            'GFX' => [","-                'processor' => '',","-                'processor_effects' => 0,","-            ],","-        ];","         $configurationManager = $this->get(ConfigurationManager::class);","-        $configurationManager->updateLocalConfiguration($testConfig);","+        $configurationManager->updateLocalConfiguration(['GFX' => ['processor' => '', 'sharpen' => false]]);"," ","         $subject = $this->get(SilentConfigurationUpgradeService::class);","         $exceptionCaught = false;","@@ -339,59 +333,28 @@ public function doNotSetImageMagickDetailSettings(): void","         }","     }"," ","-    public static function migratesGraphicsProcessorEffectsDataProvider(): array","+    public static function formerEffectsSettingDataProvider(): iterable","     {","-        return [","-            'integer 1' => [","-                1,","-                true,","-            ],","-            'integer 0' => [","-                0,","-                false,","-            ],","-            'integer -1' => [","-                -1,","-                false,","-            ],","-            'string \"1\"' => [","-                '1',","-                true,","-            ],","-            'string \"0\"' => [","-                '0',","-                false,","-            ],","-            'string \"-1\"' => [","-                '-1',","-                false,","-            ],","-        ];","+        yield 'enabled' => [true];","+        yield 'disabled' => [false];","     }"," ","-    #[DataProvider('migratesGraphicsProcessorEffectsDataProvider')]","+    /**","+     * GFX/processor_effects only ever sharpened the scaled output, so it","+     * is named after what it does.","+     */","+    #[DataProvider('formerEffectsSettingDataProvider')]","     #[Test]","-    public function migratesGraphicsProcessorEffects(string|int $currentValue, bool $expectedMigratedValue): void","+    public function formerEffectsSettingBecomesSharpen(bool $value): void","     {","-        $testConfig = [","-            'GFX' => [","-                'processor' => 'GraphicsMagick',","-                'processor_effects' => $currentValue,","-            ],","-        ];","         $configurationManager = $this->get(ConfigurationManager::class);","-        $configurationManager->updateLocalConfiguration($testConfig);","+        $configurationManager->updateLocalConfiguration(['GFX' => ['processor_effects' => $value]]);"," ","-        $subject = $this->get(SilentConfigurationUpgradeService::class);","-        $exceptionCaught = false;","-        try {","-            $subject->execute();","-        } catch (ConfigurationChangedException) {","-            $exceptionCaught = true;","-        } finally {","-            self::assertTrue($exceptionCaught);","-            self::assertSame($expectedMigratedValue, $configurationManager->getLocalConfigurationValueByPath('GFX/processor_effects'));","-        }","+        $this->executeUntilConfigurationIsStable();","+","+        $graphicsConfiguration = $configurationManager->getLocalConfiguration()['GFX'];","+        self::assertArrayNotHasKey('processor_effects', $graphicsConfiguration);","+        self::assertSame($value, $graphicsConfiguration['sharpen']);","     }"," ","     public static function removesDefaultColorspaceSettingsDataProvider(): array","@@ -784,4 +747,21 @@ public function obsoleteThumbnailsSettingIsRemoved(): void","             self::assertArrayNotHasKey('thumbnails', $configurationManager->getLocalConfiguration()['GFX']);","         }","     }","+","+    /**","+     * Each migration step throws once it changed something, so an upgrade","+     * runs as many requests as it takes until nothing changes anymore.","+     */","+    private function executeUntilConfigurationIsStable(): void","+    {","+        $subject = $this->get(SilentConfigurationUpgradeService::class);","+        for ($run = 0; $run < 20; $run++) {","+            try {","+                $subject->execute();","+                return;","+            } catch (ConfigurationChangedException) {","+            }","+        }","+        self::fail('Configuration did not settle after 20 runs of the upgrade.');","+    }"," }"],"additions":34,"deletions":54,"truncated":false},{"path":"typo3/sysext/fluid/Tests/Functional/ViewHelpers/ImageViewHelperTest.php","lines":["@@ -711,7 +711,7 @@ public function base64Argument(): void","         $context = $this->get(RenderingContextFactory::class)->create();","         $context->getTemplatePaths()->setTemplateSource('<f:image src=\"fileadmin/ImageViewHelperTest.jpg\" base64=\"1\" width=\"5\" height=\"5\" />');","         self::assertEquals(","-            '<img src=\"data:image/jpeg;base64,\" width=\"5\" height=\"5\" alt=\"\" />',","+            '<img src=\"data:image/jpeg;base64,\" width=\"5\" height=\"5\" alt=\"\" />',","             new TemplateView($context)->render(),","         );","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/fluid/Tests/Functional/ViewHelpers/Uri/ImageViewHelperTest.php","lines":["@@ -399,7 +399,7 @@ public function base64Argument(): void","     