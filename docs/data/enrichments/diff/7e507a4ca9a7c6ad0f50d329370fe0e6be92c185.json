equantizationBeforeTransformation,","+                         ::testing::ValuesIn(testValues),","+                         MoveDequantizationBeforeTransformation::getTestCaseName);","+}  // namespace","+","+// With a dynamic rank the Concat axis can't be mapped onto a non-scalar constant, so whether it has","+// to be split per input is unknown.","+TEST(LPT, MoveDequantizationBeforeTransformationDynamicRankNegative) {","+    const std::vector<DequantizationOperations> dequantizations = {","+        {{ov::element::f32}, {2.f}, {{0.1f, 0.2f}, ov::element::f32, {2, 1}}},","+        {{ov::element::f32}, {{1.f, 2.f}, ov::element::f32, {2, 1}}, {0.2f}},","+    };","+    for (const auto& dequantization : dequantizations) {","+        const auto model = MoveDequantizationBeforeFunction::getOriginal(ov::element::u8,","+                                                                         ov::PartialShape::dynamic(),","+                                                                         1,","+                                                                         dequantization);","+        EXPECT_THROW(moveDequantizationBeforeConcat(model), ov::Exception) << dequantization;","+    }","+}"],"additions":172,"deletions":0,"truncated":false},{"path":"src/common/low_precision_transformations/tests/move_fake_quantize_transformation.cpp","lines":["@@ -343,6 +343,30 @@ const std::vector<MoveFakeQuantizeTransformationTestValues> testValues = {","          {},","          {},","      }},","+    // Q/DQ concat by the last axis with rank-2 dequantization constants","+    {LayerTransformation::createParamsU8I8(),","+     false,","+     3,","+     {","+         2,","+         {},","+         {},","+         {},","+         \"\",","+         {256ul, {}, {0.f}, {2.55f}, {0.f}, {2.55f}},","+         {ov::element::u8},","+         {{element::f32}, {{0.01f}, element::f32, {1, 1}}, {{0.01f}, element::f32, {1, 1}}},","+     },","+     {","+         2,","+         {{256ul, {}, {0.f}, {2