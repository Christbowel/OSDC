{"id":"33845e6b3055442738e039717df2d717a296a634","axis":"silent","repo":"pnpm/pnpm","sha":"33845e6b3055442738e039717df2d717a296a634","parsed":{"files":[{"path":".changeset/patch-apply-fixes-v11.md","lines":["@@ -0,0 +1,10 @@","+---","+\"@pnpm/patching.apply-patch\": patch","+\"pnpm\": patch","+---","+","+Fixed several bugs in applying patches:","+","+- Deleting a file whose path contains ` b/` no longer deletes a different file.","+- A hunk without context lines now inserts its lines after the line its header names.","+- A patch that creates a file no longer overwrites an existing file with different content. pnpm reports the patch as failed."],"additions":10,"deletions":0,"truncated":false},{"path":".changeset/patch-apply-fixes-v12.md","lines":["@@ -0,0 +1,11 @@","+---","+\"pacquet\": patch","+---","+","+Fixed several bugs in applying and committing patches:","+","+- A patch that only changes a file's mode no longer corrupts a binary file.","+- A patch with CRLF line endings now applies when a blank context line has lost its leading space.","+- A unified diff without `diff --git` lines now applies.","+- A patch that creates a symlink now fails with `ERR_PNPM_INVALID_PATCH`. Previously pnpm wrote the symlink as a regular file.","+- `pnpm patch-commit --patches-dir ../outside` now fails with `ERR_PNPM_PATCHES_DIR_OUTSIDE_PROJECT`. Previously pnpm wrote the patch to `outside` inside the project."],"additions":11,"deletions":0,"truncated":false},{"path":".changeset/patch-commit-keeps-missing-final-newline.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/patching.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm patch-commit` now keeps a file without a final newline unterminated when that file comes last in the patch. Previously the patch dropped the final `\\ No newline at end of file` marker, so the patched file gained a trailing newline."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_commit.rs","lines":["@@ -237,12 +237,14 @@ impl PatchCommitArgs {","         patch_content: &str,","     ) -> Result<IndexMap<String, String>, PatchCommitError> {","         let workspace_dir = state.config.workspace_dir.clone().unwrap_or_else(|| dir.to_path_buf());","-        let patches_dir_name = normalize_patches_dir_name(","-            self.patches_dir","-                .as_deref()","-                .or(state.config.patches_dir.as_deref())","-                .unwrap_or(\"patches\"),","-        );","+        let patches_dir_setting = self.patches_dir","+            .as_deref()","+            .or(state.config.patches_dir.as_deref())","+            .unwrap_or(\"patches\");","+        let patches_dir_name = normalize_patches_dir_name(patches_dir_setting)","+            .ok_or_else(|| PatchCommitError::PatchesDirOutsideProject {","+                patches_dir: patches_dir_setting.to_string(),","+            })?;","         let patches_dir = workspace_dir.join(path_from_forward_slash(&patches_dir_name));","         fs::create_dir_all(&patches_dir)","             .map_err(|source| PatchCommitError::CreatePatchesDir {"],"additions":8,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_commit/paths.rs","lines":["@@ -152,21 +152,21 @@ pub(super) fn remove_dir_if_exists(path: &Path) -> io::Result<()> {","     }"," }"," ","-pub(super) fn normalize_patches_dir_name(input: &str) -> String {","+/// The patches directory setting as a `/`-separated path relative to the","+/// project, or `None` when a `..` segment climbs out of the project.","+pub(super) fn normalize_patches_dir_name(input: &str) -> Option<String> {","     let mut parts = Vec::new();","     for component in Path::new(input).components() {","         match component {","             Component::CurDir => {}","             Component::ParentDir => {","-                if !parts.is_empty() {","-                    parts.pop();","-                }","+                parts.pop()?;","             }",