y","lines":["@@ -211,6 +211,26 @@ def _delayedRender(self, request: Request, n: float) -> None:","         request.finish()"," "," ","+class Trickle(LeafResource):","+    \"\"\"Send a body of *n* bytes one byte at a time, one every *interval*","+    seconds.\"\"\"","+","+    def render_GET(self, request: Request) -> int:","+        n = getarg(request, b\"n\", 10, type_=int)","+        interval = getarg(request, b\"interval\", 0.1, type_=float)","+        self._write(request, n, interval)","+        return NOT_DONE_YET","+","+    def _write(self, request: Request, remaining: int, interval: float) -> None:","+        request.write(b\"x\")","+        if remaining == 1:","+            request.finish()","+            return","+        self.deferRequest(","+            request, interval, self._write, request, remaining - 1, interval","+        )","+","+"," class Status(LeafResource):","     def render_GET(self, request: Request) -> bytes:","         n = getarg(request, b\"n\", 200, type_=int)"],"additions":20,"deletions":0,"truncated":false},{"path":"tests/test_downloader_handler_aioftp.py","lines":["@@ -231,12 +231,28 @@ async def test_connection_lost() -> None:","             await _download(Request(url))"," "," ","+async def _write_slowly(","+    writer: asyncio.StreamWriter, data: bytes, interval: float","+) -> None:","+    \"\"\"Write *data* one byte every *interval* seconds, until *writer* is","+    closed.\"\"\"","+    for i in range(len(data)):","+        if writer.is_closing():","+            return","+        writer.write(data[i : i + 1])","+        await asyncio.sleep(interval)","+","+"," def _fake_ftp(","-    retr_reply: bytes | None, data: bytes = b\"\"","+    retr_reply: bytes | None, data: bytes = b\"\", interval: float = 0"," ) -> Callable[[asyncio.StreamReader, asyncio.StreamWriter], Any]:","     \"\"\"Return a minimal FTP server connection handler that sends *data*, if","     any, and then answers RETR with *retr_reply*, or hangs if *retr_reply* is","-  