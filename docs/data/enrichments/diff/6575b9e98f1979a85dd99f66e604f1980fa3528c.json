{"id":"6575b9e98f1979a85dd99f66e604f1980fa3528c","axis":"silent","repo":"envoyproxy/envoy","sha":"6575b9e98f1979a85dd99f66e604f1980fa3528c","parsed":{"files":[{"path":"api/envoy/extensions/common/ratelimit/v3/ratelimit.proto","lines":["@@ -47,6 +47,22 @@ enum VhRateLimitsOptions {","   IGNORE = 2;"," }"," ","+// Determines how the embedded ``rate_limits`` of the filter configs at different levels (from least","+// to most specific: filter level, route configuration, virtual host, route, weighted cluster) are","+// applied.","+enum RateLimitsOverrideOption {","+  // Not specified. The behavior is determined by the filter. See the documentation of the","+  // filter's ``rate_limits_override_option``.","+  RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED = 0;","+","+  // Only the ``rate_limits`` of the most specific filter config are applied.","+  MOST_SPECIFIC_ONLY = 1;","+","+  // The ``rate_limits`` of the filter configs at all levels are applied. How they are applied is","+  // determined by the filter. See the documentation of the filter's ``rate_limits_override_option``.","+  ALL_LEVELS = 2;","+}","+"," // A RateLimitDescriptor is a list of hierarchical entries that are used by the service to"," // determine the final rate limit key and overall allowed limit. Here are some examples of how"," // they might be used for the domain \"envoy\"."],"additions":16,"deletions":0,"truncated":false},{"path":"api/envoy/extensions/filters/http/local_ratelimit/v3/local_rate_limit.proto","lines":["@@ -23,7 +23,7 @@ option (udpa.annotations.file_status).package_version_status = ACTIVE;"," // Local Rate limit :ref:`configuration overview <config_http_filters_local_rate_limit>`."," // [#extension: envoy.filters.http.local_ratelimit]"," ","-// [#next-free-field: 20]","+// [#next-free-field: 21]"," message LocalRateLimit {","   // The human readable prefix to use when emitting stats.","   string stat_prefix = 1 [(validate.rules).string = {min_len: 1}];","@@ -204,4 +204,37 @@ message LocalRateLimit {","   //","   // Disabled by default.","   bool enable_retry_after_header = 19;","+","+  // Determines how the ``rate_limits`` of the filter level config and the per-route configs","+  // (``typed_per_filter_config``) at different levels are applied. The value of the most specific","+  // config that is not ``RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED`` takes effect, and the filter","+  // level config is the least specific one.","+  //","+  // * If all of them are ``RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED``, only the most specific config","+  //   is used, and the","+  //   :ref:`VirtualHost.rate_limits <envoy_v3_api_field_config.route.v3.VirtualHost.rate_limits>`","+  //   and :ref:`RouteAction.rate_limits <envoy_v3_api_field_config.route.v3.RouteAction.rate_limits>`","+  //   are used if the most specific config has no ``rate_limits``.","+  // * Otherwise, the ``VirtualHost.rate_limits`` and ``RouteAction.rate_limits`` are ignored","+  //   completely, and every applied config only matches the descriptors generated by its own","+  //   ``rate_limits`` against its own ``descriptors`` and token buckets, including the default","+  //   token bucket. The descriptors generated by the ``apply_on_stream_done`` rate limits of every","+  //   applied config are also consumed from the config's own token buckets at stream completion.","+  //","+  //   * ``MOST_SPECIFIC_ONLY``: only the most specific config is applied.","+  //   * ``ALL_LEVELS``: every config is applied, from the most specific to the least specific.","+  //     The request is rate limited if any of them rate limits it. A rejection by a shadow mode","+  //     descriptor does not stop the evaluation of the less specific configs.","+  //","+  //   Per connection rate limiting is not supported in this case. Setting this option and","+  //   :ref:`local_rate_limit_per_downstream_connection","+  //   <envoy_v3_api_field_extensions.filters.http.local_ratelimit.v3.LocalRateLimit.local_rate_limit_per_downstream_connection>`","+  //   in the same config is rejected, and ``local_rate_limit_per_downstream_connection`` of a","+  //   config that inherits the option from a less specific level is ignored, so the token buckets","+  //   of every config are always shared across connections.","+  //","+  // All other settings, such as ``filter_enabled``, ``filter_enforced``, ``status`` and the stats,","+  // always come from the most specific config.","+  common.ratelimit.v3.RateLimitsOverrideOption rate_limits_override_option = 20","+      [(validate.rules).enum = {defined_only: true}];"," }"],"additions":34,"deletions":1,"truncated":false},{"path":"api/envoy/extensions/filters/http/ratelimit/v3/BUILD","lines":["@@ -9,6 +9,7 @@ api_proto_package(","         \"//envoy/config/core/v3:pkg\",","         \"//envoy/config/ratelimit/v3:pkg\",","         \"//envoy/config/route/v3:pkg\",","+        \"//envoy/extensions/common/ratelimit/v3:pkg\",","         \"//envoy/type/v3:pkg\",","         \"@xds//udpa/annotations:pkg\",","     ],"],"additions":1,"deletions":0,"truncated":false},{"path":"api/envoy/extensions/filters/http/ratelimit/v3/rate_limit.proto","lines":["@@ -5,6 +5,7 @@ package envoy.extensions.filters.http.ratelimit.v3;"," import \"envoy/config/core/v3/base.proto\";"," import \"envoy/config/ratelimit/v3/rls.proto\";"," import \"envoy/config/route/v3/route_components.proto\";","+import \"envoy/extensions/common/ratelimit/v3/ratelimit.proto\";"," import \"envoy/type/v3/http_status.proto\";"," "," import \"google/protobuf/duration.proto\";","@@ -23,7 +24,7 @@ option (udpa.annotations.file_status).package_version_status = ACTIVE;"," // Rate limit :ref:`configuration overview <config_http_filters_rate_limit>`."," // [#extension: envoy.filters.http.ratelimit]"," ","-// [#next-free-field: 20]","+// [#next-free-field: 21]"," message RateLimit {","   option (udpa.annotations.versioning).previous_message_type =","       \"envoy.config.filter.http.rate_limit.v2.RateLimit\";","@@ -174,7 +175,9 @@ message RateLimit {","   // :ref:`VirtualHost.rate_limits<envoy_v3_api_field_config.route.v3.VirtualHost.rate_limits>` or","   // :ref:`RouteAction.rate_limits<envoy_v3_api_field_config.route.v3.RouteAction.rate_limits>` fields","   // will be ignored. However, :ref:`RateLimitPerRoute.rate_limits<envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimitPerRoute.rate_limits>`","-  // will take precedence over this field.","+  // will take precedence over this field, unless :ref:`rate_limits_override_option","+  // <envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimit.rate_limits_override_option>`","+  // resolves to ``ALL_LEVELS``, in which case both are applied.","   //","   // .. note::","   //   Not all configuration fields of","@@ -200,8 +203,17 @@ message RateLimit {","   //","   // Disabled by default.","   bool enable_retry_after_header = 19;","+","+  // The filter level default of","+  // :ref:`rate_limits_override_option","+  // <envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimitPerRoute.rate_limits_override_option>`.","+  // The filter level config is the least specific one, so the value is only used if all the","+  // per-route configs leave the option ``RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED``.","+  common.ratelimit.v3.RateLimitsOverrideOption rate_limits_override_option = 20","+      [(validate.rules).enum = {defined_only: true}];"," }"," ","+// [#next-free-field: 6]"," message RateLimitPerRoute {","   // [#next-major-version: unify with local ratelimit, should use common.ratelimit.v3.VhRateLimitsOptions instead.]","   enum VhRateLimitsOptions {","@@ -246,7 +258,10 @@ message RateLimitPerRoute {","   // :ref:`VirtualHost.rate_limits<envoy_v3_api_field_config.route.v3.VirtualHost.rate_limits>`,","   // :ref:`RouteAction.rate_limits<envoy_v3_api_field_config.route.v3.RouteAction.rate_limits>` and","   // :ref:`RateLimit.rate_limits<envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimit.rate_limits>` fields","-  // will be ignored.","+  // will be ignored. If :ref:`rate_limits_override_option","+  // <envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimitPerRoute.rate_limits_override_option>`","+  // resolves to ``ALL_LEVELS``, the ``rate_limits`` of the less specific per-route configs and","+  // ``RateLimit.rate_limits`` are applied as well.","   //","   // .. note::","   //   Not all configuration fields of","@@ -261,4 +276,22 @@ message RateLimitPerRoute {"," ","   // Overrides the domain. If not set, uses the filter-level domain instead.","   string domain = 4;","+","+  // Determines how the ``rate_limits`` of the per-route configs at different levels and the","+  // filter level :ref:`rate_limits <envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimit.rate_limits>`","+  // are applied. The value of the most specific config that is not","+  // ``RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED`` takes effect, and the filter level","+  // :ref:`rate_limits_override_option","+  // <envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimit.rate_limits_override_option>`","+  // is the least specific one. If all of them are ``RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED``,","+  // :ref:`MOST_SPECIFIC_ONLY <envoy_v3_api_enum_value_extensions.common.ratelimit.v3.RateLimitsOverrideOption.MOST_SPECIFIC_ONLY>`","+  // is used.","+  //","+  // If ``ALL_LEVELS`` is used, the descriptors generated from the ``rate_limits`` of all levels,","+  // including the filter level, are merged and sent to the rate limit service in a single request,","+  // with the descriptors from the more specific levels first. The :ref:`domain","+  // <envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimitPerRoute.domain>` of the most","+  // specific per-route config is still used if set, otherwise the filter level domain is used.","+  common.ratelimit.v3.RateLimitsOverrideOption rate_limits_override_option = 5","+      [(validate.rules).enum = {defined_only: true}];"," }"],"additions":36,"deletions":3,"truncated":false},{"path":"changelogs/current/new_features/ratelimit__rate-limits-override-option.rst","lines":["@@ -0,0 +1,10 @@","+Added ``rate_limits_override_option`` to the rate limit filter (:ref:`filter level","+<envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimit.rate_limits_override_option>` and :ref:`per-route","+<envoy_v3_api_field_extensions.filters.http.ratelimit.v3.RateLimitPerRoute.rate_limits_override_option>`) and the","+local rate limit filter (:ref:`rate_limits_override_option","+<envoy_v3_api_field_extensions.filters.http.local_ratelimit.v3.LocalRateLimit.rate_limits_override_option>`). When","+set to ``ALL_LEVELS``, the embedded ``rate_limits`` of the configs at all levels are applied instead of only the most","+specific one. The rate limit filter merges the generated descriptors into a single request, and the local rate limit","+filter checks every level against its own descriptors and token buckets. For the local rate limit filter, setting","+the option also ignores ``VirtualHost.rate_limits`` and ``RouteAction.rate_limits``, and it cannot be combined with","+``local_rate_limit_per_downstream_connection``."],"additions":10,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/local_ratelimit/BUILD","lines":["@@ -32,6 +32,7 @@ envoy_cc_library(","         \"//source/extensions/filters/common/ratelimit_config:ratelimit_config_lib\",","         \"//source/extensions/filters/http/common:pass_through_filter_lib\",","         \"//source/extensions/filters/http/common:ratelimit_headers_lib\",","+        \"@abseil-cpp//absl/container:inlined_vector\",","         \"@envoy_api//envoy/config/route/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/common/ratelimit/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/filters/http/local_ratelimit/v3:pkg_cc_proto\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/local_ratelimit/local_ratelimit.cc","lines":["@@ -68,6 +68,7 @@ FilterConfig::FilterConfig(","       enable_retry_after_header_(config.enable_retry_after_header() &&","                                  status_ == Http::Code::TooManyRequests),","       vh_rate_limits_(config.vh_rate_limits()),","+      rate_limits_override_option_(config.rate_limits_override_option()),","       rate_limited_grpc_status_(","           config.rate_limited_as_resource_exhausted()","               ? std::make_optional(Grpc::Status::WellKnownGrpcStatus::ResourceExhausted)","@@ -93,6 +94,17 @@ FilterConfig::FilterConfig(","     return;","   }"," ","+  // TODO(wbpcode): support the per connection rate limiting with the rate limits override option","+  // after the per connection limiter is fixed to be keyed by the config that creates it.","+  if (rate_limit_per_connection_ &&","+      rate_limits_override_option_ !=","+          envoy::extensions::common::ratelimit::v3::RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED) {","+    creation_status =","+        absl::InvalidArgumentError(\"rate_limits_override_option is set and \"","+                                   \"local_rate_limit_per_downstream_connection is set to true\");","+    return;","+  }","+","   rate_limit_config_ = std::make_unique<Filters::Common::RateLimit::RateLimitConfig>(","       config.rate_limits(), context, creation_status);","   if (!creation_status.ok()) {","@@ -167,20 +179,13 @@ bool FilterConfig::enforced() const {","   return filter_enforced_.has_value() ? filter_enforced_->enabled() : false;"," }"," ","-Filter::Filter(FilterConfigSharedPtr config)","-    : config_(std::move(config)), used_config_(config_.get()) {}","+Filter::Filter(FilterConfigSharedPtr config) : config_(std::move(config)), used_config_(*config_) {}"," "," Http::FilterHeadersStatus Filter::decodeHeaders(Http::RequestHeaderMap& headers, bool) {","-  const auto* route_config =","-      Http::Utility::resolveMostSpecificPerFilterConfig<FilterConfig>(decoder_callbacks_);","-","   // We can never assume that the configuration/route will not change between","   // decodeHeaders() and encodeHeaders().","-  // Store the configuration because we will use it later in encodeHeaders().","-  if (route_config != nullptr) {","-    ASSERT(used_config_ == config_.get());","-    used_config_ = route_config; // Overwrite the used configuration.","-  }","+  // Store the configurations because we will use them later in encodeHeaders().","+  initializeUsedConfigs();"," ","   rate_limit_enabled_ = used_config_->enabled();","   if (!rate_limit_enabled_) {","@@ -189,24 +194,32 @@ Http::FilterHeadersStatus Filter::decodeHeaders(Http::RequestHeaderMap& headers,"," ","   used_config_->stats().enabled_.inc();"," ","-  std::vector<RateLimit::Descriptor> descriptors;","-  if (used_config_->hasDescriptors()) {","-    if (used_config_->hasRateLimitConfigs()) {","-      used_config_->populateDescriptors(headers, /*response_headers=*/nullptr,","-                                        decoder_callbacks_->streamInfo(), descriptors,","-                                        /*on_stream_done=*/false);","-    } else {","-      populateDescriptors(descriptors, headers);","+  Filters::Common::LocalRateLimit::LocalRateLimiter::Result result;","+  if (override_option_ !=","+      envoy::extensions::common::ratelimit::v3::RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED) {","+    // The legacy rate limits of the route and virtual host are ignored completely.","+    result = requestAllowedByConfigs(headers);","+  } else {","+    std::vector<RateLimit::Descriptor> descriptors;","+    if (used_config_->hasDescriptors()) {","+      if (used_config_->hasRateLimitConfigs()) {","+        used_config_->populateDescriptors(headers, /*response_headers=*/nullptr,","+                                          decoder_callbacks_->streamInfo(), descriptors,","+                                          /*on_stream_done=*/false);","+      } else {","+        populateDescriptors(descriptors, headers);","