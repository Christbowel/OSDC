t_headers = decoder_callbacks_->requestHeaders();","+  if (!request_headers.has_value()) {","+    return;","+  }","+  const auto response_headers = decoder_callbacks_->responseHeaders();","+","+  // Same as the request path: every applied level consumes its own shared token buckets with the","+  // descriptors generated by its own rate limits.","+  std::vector<RateLimit::Descriptor> descriptors;","+  for (const FilterConfig& config : configs) {","+    if (!config.hasStreamDoneActions()) {","+      continue;","+    }","+    descriptors.clear();","+    config.populateDescriptors(*request_headers, response_headers.ptr(),","+                               decoder_callbacks_->streamInfo(), descriptors,","+                               /*on_stream_done=*/true);","+    config.consumeDescriptors(descriptors);","+  }","+}","+"," Filters::Common::LocalRateLimit::LocalRateLimiterImpl::Result"," Filter::requestAllowed(absl::Span<const RateLimit::Descriptor> request_descriptors) {","   return used_config_->rateLimitPerConnection()","@@ -308,6 +356,8 @@ Filter::requestAllowed(absl::Span<const RateLimit::Descriptor> request_descripto"," }"," "," Filters::Common::LocalRateLimit::LocalRateLimiterImpl& Filter::getPerConnectionRateLimiter() {","+  // TODO(wbpcode): the limiter is stored under a single key, so the config of the first request","+  // on a connection is used for all the following requests on it, even if they use other configs.","   ASSERT(used_config_->rateLimitPerConnection());"," ","   auto typed_state =","@@ -328,6 +378,77 @@ Filters::Common::LocalRateLimit::LocalRateLimiterImpl& Filter::getPerConnectionR","   return const_cast<Filters::Common::LocalRateLimit::LocalRateLimiterImpl&>(typed_state->value());"," }"," ","+void Filter::initializeUsedConfigs() {","+  used_configs_.clear();","+  // In ascending order of specificity. Reverse it to put the most specific one first.","+  const auto route_configs = Http::Utility::getAllPerFilterConfig<FilterConfig>(decoder_callbacks_);","+  for (auto it = route_configs.rbegin(); it != route_configs.rend(); ++it) {","+    used_configs_.push_back(*it);","+  }","+  // The filter level config is the least specific one.","+  used_configs_.push_back(*config_);","+  used_config_ = used_configs_.front().get();","+","+  // The most specific set option wins.","+  override_option_ =","+      envoy::extensions::common::ratelimit::v3::RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED;","+  for (const FilterConfig& config : used_configs_) {","+    if (config.rateLimitsOverrideOption() !=","+        envoy::extensions::common::ratelimit::v3::RATE_LIMITS_OVERRIDE_OPTION_UNSPECIFIED) {","+      override_option_ = config.rateLimitsOverrideOption();","+      break;","+    }","+  }","+}","+","+absl::Span<const std::reference_wrapper<const FilterConfig>> Filter::appliedConfigs() const {","+  return absl::MakeConstSpan(used_configs_)","+      .subspan(0, override_option_ == envoy::extensions::common::ratelimit::v3::ALL_LEVELS","+                      ? used_configs_.size()","+                      : 1);","+}","+","+Filters::Common::LocalRateLimit::LocalRateLimiter::Result","+Filter::requestAllowedByConfigs(const Http::RequestHeaderMap& headers) {","+  ASSERT(used_config_.has_value());","+  ASSERT(!used_configs_.empty());","+","+  std::optional<Filters::Common::LocalRateLimit::LocalRateLimiter::Result> result;","+  std::vector<RateLimit::Descriptor> descriptors;","+  for (const FilterConfig& config : appliedConfigs()) {","+    descriptors.clear();","+","+    // Every level only matches the descriptors generated by its own rate limits against its own","+    // token buckets.","+    if (config.hasRateLimitConfigs()) {","+      config.populateDescriptors(headers, /*response_headers=*/nullptr,","+                                 decoder_callbacks_->streamInfo(), descriptors,","+                                 /*on_stream_done=*/false);","+    }","+","+    if (ENVOY_LOG_CHECK_LEVEL(debug)) {","+      for (const auto& request_de