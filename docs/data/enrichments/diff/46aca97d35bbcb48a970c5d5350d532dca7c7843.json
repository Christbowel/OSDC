t) PHONGO_BSON_MAX_LENGTH, Z_STRLEN_P(value));","+\t\treturn false;","+\t}","+"," \tif (!bson_append_utf8(opts, opts_key, strlen(opts_key), Z_STRVAL_P(value), Z_STRLEN_P(value))) {"," \t\tphongo_throw_exception(PHONGO_ERROR_INVALID_ARGUMENT, \"Error appending \\\"%s\\\" option\", opts_key);"," \t\treturn false;"],"additions":5,"deletions":0,"truncated":false},{"path":"src/libmongoc","lines":["@@ -1 +1 @@","-Subproject commit 9e951e1d683ddd5767dc5d3e4510e85a171d6dba","+Subproject commit 61049c015af6f23630e3cb2ff9419fd12be842a1"],"additions":1,"deletions":1,"truncated":false},{"path":"src/libmongocrypt","lines":["@@ -1 +1 @@","-Subproject commit ab45a792fd995db28b6fde3e730edf6a7a90fbf4","+Subproject commit f2158c3304df5ecdd7853e74b6c96a7bba96a11f"],"additions":1,"deletions":1,"truncated":false},{"path":"src/phongo_bson.h","lines":["@@ -26,6 +26,12 @@"," #define PHONGO_ODM_FIELD_NAME \"__pclass\""," #define BSON_MAX_NESTING_LEVEL 100"," ","+/* Maximum length for a BSON string or binary value. BSON encodes these lengths","+ * as int32, so anything larger cannot be represented on the wire and would be","+ * silently truncated (or wrap an allocation) by the narrowing casts in the","+ * encoder. */","+#define PHONGO_BSON_MAX_LENGTH INT32_MAX","+"," typedef enum {"," \tPHONGO_FIELD_PATH_ITEM_NONE,"," \tPHONGO_FIELD_PATH_ITEM_ARRAY,"],"additions":6,"deletions":0,"truncated":false},{"path":"src/phongo_bson_encode.c","lines":["@@ -30,12 +30,10 @@"," #define MONGOC_LOG_DOMAIN \"PHONGO-BSON\""," "," #if SIZEOF_ZEND_LONG == 8","-#define BSON_APPEND_INT(b, key, keylen, val)    \\","-\tif (val > INT32_MAX || val < INT32_MIN) {   \\","-\t\tbson_append_int64(b, key, keylen, val); \\","-\t} else {                                    \\","-\t\tbson_append_int32(b, key, keylen, val); \\","-\t}","+#define BSON_APPEND_INT(b, key, keylen, val)      \\","+\t(val > INT32_MAX || val < INT32_MIN           \\","+\t\t ? bson_append_int64(b, key, keylen, val) \\","+\t\t : bson_append_int32(b, key,