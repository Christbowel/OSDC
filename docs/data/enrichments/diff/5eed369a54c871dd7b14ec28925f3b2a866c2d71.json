  &self,","         query: FastProviderQuery<'_>,","+        item: &PeersCacheItem,","         name: &str,","         cached_node_id: &NodeId,","     ) -> CacheMatch {","         match self.fast_provider_for_name(query, name) {","             FastProvider::Missing => CacheMatch::NoMatch,","             FastProvider::Inherited(current_ref) => {","-                if self.parent_ref_matches_cached(current_ref, cached_node_id) {","+                if self.has_restriction_of(item, name, current_ref)","+                    && self.parent_ref_matches_cached(current_ref, cached_node_id)","+                {","                     CacheMatch::Match","                 } else {","                     CacheMatch::NoMatch","                 }","             }","+            FastProvider::Child(_) if item.restricted_providers.contains_key(name) => {","+                CacheMatch::NoMatch","+            }","             FastProvider::Child(child_pkg_id) => {","                 self.fast_child_provider_matches(child_pkg_id, cached_node_id)","             }"],"additions":10,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/cache/restricted_providers.rs","lines":["@@ -0,0 +1,63 @@","+use super::{Arc, HashMap, ParentRef, ParentRefs, PeersCacheItem, Walker};","+","+impl Walker<'_> {","+    /// The version of `parent` when it is restricted: a hoisted provider","+    /// that some optional peer range in the tree rejects. Only such a","+    /// provider can resolve a subtree differently from a declared one, so","+    /// a cached verdict is reused only under the restriction it was","+    /// recorded under.","+    pub(in super::super) fn restricted_version<'refs>(","+        &self,","+        peer_name: &str,","+        parent: &'refs ParentRef,","+    ) -> Option<&'refs Arc<str>> {","+        let is_restricted = parent.hoisted_provider","+            && self.caches.peers_cache.optional_peer_ranges.rejects(","+                self.tree,","+                self.caches.view_generation(),","+                (peer_name, &parent.version),","+            );","+        is_restricted.then_some(&parent.version)","+    }","+","+    /// The [`PeersCacheItem::restricted_providers`] of a verdict over","+    /// `peer_names`, resolved against `parent_refs`.","+    pub(in super::super) fn restricted_providers<'names>(","+        &self,","+        parent_refs: &ParentRefs,","+        peer_names: impl Iterator<Item = &'names String>,","+    ) -> HashMap<String, Arc<str>> {","+        peer_names","+            .filter_map(|name| {","+                let version = self.restricted_version(name, parent_refs.get(name)?)?;","+                Some((name.clone(), Arc::clone(version)))","+            })","+            .collect()","+    }","+","+    pub(in super::super) fn has_restriction_of(","+        &self,","+        item: &PeersCacheItem,","+        peer_name: &str,","+        current_ref: &ParentRef,","+    ) -> bool {","+        self.restricted_version(peer_name, current_ref)","+            == item.restricted_providers.get(peer_name)","+    }","+","+    /// A missing peer stays missing when nothing provides it, or when the","+    /// restricted provider that the cached walk rejected provides it.","+    pub(in super::super) fn missing_peer_still_missing(","+        &self,","+        item: &PeersCacheItem,","+        peer_name: &str,","+        parent_refs: &ParentRefs,","+    ) -> bool {","+        parent_refs","+            .get(peer_name)","+            .is_none_or(|current_ref| {","+                item.restricted_providers.contains_key(peer_name)","+                    && self.has_restriction_of(item, peer_name, current_ref)","+            })","+    }","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/cache/tests.rs","lines":["@@ -99,8 +99,12 @@ fn equal_provisional_paths_require_matching_nested_providers() {","         cached.clone(),","         Arc::new(HashMap::from_iter([(\"inner\".into(), cached_inner.clone())])),","     );","-    let current_ref =","-        ParentRef { node_id: Some(current.clone()), version: \"1.0.0\".into(), alias: None };","+    let current_ref = ParentRef {","+        node_id: Some(current.clone()),","+        version: \"1.0.0\".into(),","+        alias: None,","+        hoisted_provider: false,","+    };"," ","     assert_eq!(walker.provider_identity_match(&current, &cached), CacheMatch::Ambiguous);","     assert!(!walker.parent_ref_matches_cached(&current_ref, &cached));","@@ -139,3 +143,140 @@ fn provider_identity_comparison_terminates_on_peer_cycles() {","     }","     assert_eq!(walker.provider_identity_match(&current, &cached), CacheMatch::Match);"," }","+","+/// `strict` rejects `plugin@1.0.0` through an optional peer, which makes a","+/// hoisted `plugin@1.0.0` a restricted provider.","+fn tree_with_a_rejecting_optional_peer() -> ResolvedTree {","+    use crate::resolve_peers::test_support::package_with_peer_dependencies;","+","+    let (optional, is_leaf) = (true, true);","+    let strict = package_with_peer_dependencies(","+        \"strict\",","+        \"1.0.0\",","+        &[(\"plugin\", \"^2.0.0\", optional)],","+        is_leaf,","+    );","+    let plugin = package(\"plugin\", \"1.0.0\", &[], is_leaf);","+    let mut tree = ResolvedTree::default();","+    tree.dependencies_tree.insert(","+        NodeId::leaf(&plugin.id),","+        tree_node(&plugin.id, BTreeMap::new(), 0),","+    );","+    for pkg in [strict, plugin] {","+        tree.packages.insert(Arc::clone(&pkg.id), pkg);","+    }","+    tree","+}","+","+/// How an importer comes to provide `plugin@1.0.0`.","+#[derive(Clone, Copy)]","+enum PluginProvider {","+    Hoisted,","+    Declared,","+}","+","+/// What the cached walk did with its `plugin` peer.","+#[derive(Clone, Copy)]","+enum PluginPeer {","+    Resolved,","+    Missing,","+}","+","+fn plugin_ref(provider: PluginProvider) -> crate::resolve_peers::context::ParentRefs {","+    use crate::resolve_peers::context::ParentRef;","+","+    let hoisted_provider = match provider {","+        PluginProvider::Hoisted => true,","+        PluginProvider::Declared => false,","+    };","+","+    HashMap::from_iter([(","+        \"plugin\".to_string(),","+        ParentRef {","+            node_id: Some(NodeId::leaf(\"plugin@1.0.0\")),","+            version: \"1.0.0\".into(),","+            alias: None,","+            hoisted_provider,","+        },","+    )])","+}","+","+fn cache_item_of_consumer(","+    walker: &crate::resolve_peers::walker::Walker<'_>,","+    recorded_under: &crate::resolve_peers::context::ParentRefs,","+    plugin_peer: PluginPeer,","+) -> super::PeersCacheItem {","+    use crate::resolve_peers::walker::MissingPeerInfo;","+","+    let plugin = \"plugin\".to_string();","+    let resolved = HashMap::from_iter([(plugin.clone(), NodeId::leaf(\"plugin@1.0.0\"))]);","+    let missing = HashMap::from_iter([(","+        plugin.clone(),","+        MissingPeerInfo {","+            range: \"^2.0.0\".to_string(),","+            declaring_pkg_id: \"strict@1.0.0\".into(),","+            optional: true,","+        },","+    )]);","+    let (resolved, missing) = match plugin_peer {","+        PluginPeer::Missing => (HashMap::default(), missing),","+        PluginPeer::Resolved => (resolved, HashMap::default()),","+    };","+    super::PeersCacheItem {","+        owner_node_id: NodeId::next(),","+        dep_path: DepPath::from(\"consumer@1.0.0\"),","+        restricted_providers: walker.restricted_providers(recorded_under, std::iter::once(&plugin)),","+        resolved_peers: Arc::new(resolved),","+        missing_peers: Arc::new(missing),","+        missing_peers_of_children: Arc::new(HashMap::default()),","+        subtree_missing_by_pkg: None,","+    }","+}","+","+#[test]","+fn a_cached_verdict_is_reused_only_under_the_restriction_it_was_recorded_under() {","+    use crate::resolve_peers::test_support::PeerCacheMode;","+","+    let mut tree = tree_with_a_rejecting_optional_peer();","+    let mut walker = walker_for_tests(&mut tree);","+    walker.opts.cache_mode = PeerCacheMode::Enabled;","+    let consumer: Arc<str> = \"consumer@1.0.0\".into();","+    let hoisted = plugin_ref(PluginProvider::Hoisted);","+    let declared = plugin_ref(PluginProvider::Declared);","+","+    let bound_to_hoisted = cache_item_of_consumer(&walker, &hoisted, PluginPeer::Resolved);","+    walker.caches.peers_cache.push(&consumer, bound_to_hoisted);","+    assert!(walker.find_hit(&hoisted, &consumer).is_some());","+    assert!(walker.find_hit(&declared, &consumer).is_none());","+","+    let rejected_hoisted = cache_item_of_consumer(&walker, &hoisted, PluginPeer::Missing);","+    let rejecter: Arc<str> = \"rejecter@1.0.0\".into();","+    walker.caches.peers_cache.push(&rejecter, rejected_hoisted);","+    assert!(walker.find_hit(&hoisted, &rejecter).is_some());","+    assert!(walker.find_hit(&declared, &rejecter).is_none());","+","+    let bound_to_declared = cache_item_of_consumer(&walker, &declared, PluginPeer::Resolved);","+    let other: Arc<str> = \"other@1.0.0\".into();","+    walker.caches.peers_cache.push(&other, bound_to_declared);","+    assert!(walker.find_hit(&declared, &other).is_some());","+    assert!(walker.find_hit(&hoisted, &other).is_none());","+}","+","+/// No optional peer range rejects `plugin@1.0.0` here, so a hoisted","+/// provider resolves every subtree as a declared one does.","+#[test]","+fn an_unrestricted_hoisted_provider_reuses_a_verdict_recorded_under_a_declared_one() {","+    use crate::resolve_peers::test_support::PeerCacheMode;","+","+    let mut tree = tree_with_a_rejecting_optional_peer();","+    tree.packages.remove(\"strict@1.0.0\");","+    let mut walker = walker_for_tests(&mut tree);","+    walker.opts.cache_mode = PeerCacheMode::Enabled;","+    let consumer: Arc<str> = \"consumer@1.0.0\".into();","+    let hoisted = plugin_ref(PluginProvider::Hoisted);","+    let declared = plugin_ref(PluginProvider::Declared);","+","+    let bound_to_declared = cache_item_of_consumer(&walker, &declared, PluginPeer::Resolved);","+    walker.caches.peers_cache.push(&consumer, bound_to_declared);","+    assert!(walker.find_hit(&hoisted, &consumer).is_some());","+}"],"additions":143,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/context.rs","lines":["@@ -38,6 +38,10 @@ pub(super) struct ParentRef {","     /// Local install name in `node_modules`. May differ from the","     /// package's real name for npm-alias entries.","     pub(super) alias: Option<String>,","+    /// Set when the importer has this provider only because it was hoisted","+    /// for another subtree's peer. See","+    /// [`crate::ImporterPeerInput::hoisted_peer_provider_node_ids`].","+    pub(super) hoisted_provider: bool,"," }"," "," /// `name → ParentRef` map propagated down the walk. Entries are indexed","@@ -441,12 +445,14 @@ pub(super) fn insert_parent_ref(","     direct_alias: &str,","     parent_node_id: NodeId,","     pkg: &ResolvedPackage,","+    hoisted_provider: bool,"," ) {","     let real_name: &str = pkg.name();","     let parent_ref = ParentRef {","         version: Arc::clone(pkg.version()),","         node_id: Some(parent_node_id),","         alias: (direct_alias != real_name).then(|| direct_alias.to_string()),","+        hoisted_provider,","     };","     update_parent_refs(refs, direct_alias, &parent_ref);","     if direct_alias != real_name {"],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/context/peer_specifier.rs","lines":["@@ -208,6 +208,7 @@ pub(super) fn satisfies_with_parsed_prereleases("," /// yields, paired with its parsed form so a range that many nodes"," /// declare is parsed once. Holding the two together is what keeps the"," /// parsed range in step with the text it came from.","+#[derive(Debug)]"," pub(in super::super) struct ComparablePeerRange {","     /// The comparable range, as peer-dependency issues quote it.","     pub(in super::super) text: String,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/discovery/peers_cache.rs","lines":["@@ -1,4 +1,5 @@"," use super::{Arc, HashMap, HashSet, NodeId, PeersCacheItem};","+use crate::resolve_peers::optional_peer_ranges::OptionalPeerRanges;"," use std::collections::{BTreeMap, btree_map};"," "," #[derive(Debug, Default)]","@@ -11,6 +12,8 @@ struct PkgCacheEntries {"," pub(in super::super) struct PeersCache {","     by_pkg: HashMap<Arc<str>, PkgCacheEntries>,","     items_by_provider: HashMap<NodeId, HashSet<(Arc<str>, usize)>>,","+    /// Decides whether a hit may bind a hoisted provider.","+    pub(in super::super) optional_peer_ranges: OptionalPeerRanges,"," }"," "," impl PeersCache {"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/discovery/tests/refresh_bounds.rs","lines":["@@ -414,6 +414,7 @@ fn discovery_and_workspace_peer_walks_honor_cancellation() {","         root_dir: Path::new(\"/workspace\").to_path_buf(),","         modules_dir: None,","         rejected_optional_peers: HashSet::default(),","+        hoisted_peer_provider_node_ids: HashSet::default(),","     };","     let ws_polls = Arc::new(AtomicUsize::new(0));","     let ws_result = resolve_peers_workspace("],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_peers/optional_peer_ranges.rs","lines":["@@ -0,0 +1,70 @@","+//! Index of the optional peer ranges a tree view declares.","+","+use super::{context::ComparablePeerRange, discovery::ViewGeneration};","+use crate::resolved_tree::ResolvedTree;","+use rustc_hash::{FxHashMap as HashMap, FxHashSet as HashSet};","+use std::{cell::RefCell, sync::Arc};","+","+type RangesByPeerName = HashMap<String, Vec<ComparablePeerRange>>;","+","+/// Every optional peer range the packages of one tree view declare, by","+/// peer name. Built on the first read under a [`ViewGeneration`].","+#[derive(Debug, Default)]","+pub(super) struct OptionalPeerRanges {","+    table: RefCell<Option<(ViewGeneration, Arc<RangesByPeerName>)>>,","+}","+","+impl OptionalPeerRanges {","+    /// Whether some optional peer range declared for `peer_name` rejects","+    /// `version`.","+    pub(super) fn rejects(","+        &self,","+        tree: &ResolvedTree,","+        view_generation: ViewGeneration,","+        (peer_name, version): (&str, &str),","+    ) -> bool {","+        self.table(tree, view_generation)","+            .get(peer_name)","+            .is_some_and(|ranges| {","+                ranges","+                    .iter()","+                    .any(|range| !range.satisfies(version))","+            })","+    }","+","+    fn table(&self, tree: &ResolvedTree, view_generation: ViewGeneration) -> Arc<RangesByPeerName> {","+        let mut table = self.table.borrow_mut();","+        if let Some((generation, ranges)) = table.as_ref()","+            && *generation == view_generation","+        {","+            return Arc::clone(ranges);","+        }","+        let ranges = Arc::new(collect_optional_peer_ranges(tree));","+        *table = Some((view_generation, Arc::clone(&ranges)));","+        ranges","+    }","+}","+","+fn collect_optional_peer_ranges(tree: &ResolvedTree) -> RangesByPeerName {","+    let mut raw_ranges: HashMap<&str, HashSet<&str>> = HashMap::default();","+    for pkg in tree.packages.values() {","+        for (peer_name, peer) in pkg.peer_set.taken() {","+            if peer.optional {","+                raw_ranges","+                    .entry(peer_name)","+                    .or_default()","+                    .insert(&peer.version);","+            }","+        }","+    }","+    raw_ranges","+        .into_iter()","+        .map(|(peer_name, ranges)| {","+            let ranges = ranges","+                .into_iter()","+           