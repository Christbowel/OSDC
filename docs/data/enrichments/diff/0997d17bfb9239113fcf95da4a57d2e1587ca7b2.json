","+        prepare(config(List.of(\"html\")), \"second\", \"second\", \"html\");","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(\"success\");","+    }","+","+    public void testNullMappingExtensionCountsAsEmpty() throws Exception {","+        prepare(config(List.of(\"action\", \"\")), \"second\", \"second\", null);","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(\"success\");","+    }","+","+    public void testRejectedWithoutResultSends404() throws Exception {","+        prepare(config(List.of(\"html\")), \"second\", \"second\", \"action\");","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(Action.NONE);","+        assertThat(response.getStatus()).isEqualTo(HttpServletResponse.SC_NOT_FOUND);","+    }","+","+    public void testRejectedUsesBadExtensionResult() throws Exception {","+        prepare(config(List.of(\"html\"), \"bad-extension\"), \"second\", \"second\", \"action\");","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(\"bad-extension\");","+        assertThat(response.getStatus()).isEqualTo(HttpServletResponse.SC_OK);","+    }","+","+    public void testCustomResultName() throws Exception {","+        interceptor.setBadExtensionResultName(\"wrong-ext\");","+        prepare(config(List.of(\"html\"), \"wrong-ext\"), \"second\", \"second\", \"action\");","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(\"wrong-ext\");","+    }","+","+    public void testChainedInvocationNotEnforced() throws Exception {","+        prepare(config(List.of(\"html\")), \"first\", \"second\", \"action\");","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(\"success\");","+    }","+","+    public void testNoMappingPasses() throws Exception {","+        prepare(config(List.of(\"html\")), null, \"second\", null);","+","+        assertThat(interceptor.intercept(invocation)).isEqualTo(\"success\");","+    }","+","+    private ActionConfig config(List<String> extensions, String... resultNames) {","+        ActionConfig.Builder builder = new ActionConfig.Builder(\"pkg\", \"second\", TestAction.class.getName())","+            .extensions(extensions);","+        for (String resultName : resultNames) {","+            builder.addResultConfig(new ResultConfig.Builder(resultName, \"result\").build());","+        }","+        return builder.build();","+    }","+","+    private void prepare(ActionConfig config, String mappingName, String proxyName, String extension) {","+        MockActionProxy proxy = new MockActionProxy();","+        proxy.setConfig(config);","+        proxy.setActionName(proxyName);","+        proxy.setNamespace(\"/\");","+        invocation = new MockActionInvocation();","+        invocation.setProxy(proxy);","+        invocation.setAction(new TestAction());","+        invocation.setResultCode(\"success\");","+        response = new MockHttpServletResponse();","+        ActionContext context = ActionContext.getContext()","+            .withServletRequest(new MockHttpServletRequest(\"GET\", \"/x\"))","+            .withServletResponse(response);","+        if (mappingName != null) {","+            ActionMapping mapping = new ActionMapping(mappingName, \"/\", \"\", null);","+            mapping.setExtension(extension);","+            context.withActionMapping(mapping);","+        }","+        invocation.setInvocationContext(context);","+    }","+}",""],"additions":130,"deletions":0,"truncated":false}],"additions":351,"deletions":19,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-07T15:04:07.441390+00:00"}