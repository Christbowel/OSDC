ptor;","+","+import jakarta.servlet.http.HttpServletResponse;","+import org.apache.logging.log4j.LogManager;","+import org.apache.logging.log4j.Logger;","+import org.apache.struts2.ActionInvocation;","+import org.apache.struts2.ActionProxy;","+import org.apache.struts2.action.Action;","+import org.apache.struts2.dispatcher.mapper.ActionExtensions;","+import org.apache.struts2.dispatcher.mapper.ActionMapping;","+","+import java.io.IOException;","+import java.util.List;","+import java.util.Objects;","+","+/**","+ * Rejects requests whose URL extension is not among the extensions declared on the action or its package","+ * with the {@code extension} attribute. Actions without a declaration are not restricted.","+ * <p>","+ * A rejected request resolves to {@link #setBadExtensionResultName(String) badExtensionResultName}","+ * when the action maps that result, otherwise the response is {@code 404 Not Found}.","+ * <p>","+ * Only the request's own action is checked; actions reached by chaining are not.","+ *","+ * @since 7.5.0","+ */","+public class ActionExtensionInterceptor extends AbstractInterceptor {","+","+    private static final Logger LOG = LogManager.getLogger(ActionExtensionInterceptor.class);","+","+    private String badExtensionResultName = \"bad-extension\";","+","+    @Override","+    public String intercept(ActionInvocation invocation) throws Exception {","+        ActionProxy proxy = invocation.getProxy();","+        List<String> allowed = proxy.getConfig().getExtensions();","+        if (allowed == null) {","+            return invocation.invoke();","+        }","+","+        ActionMapping mapping = invocation.getInvocationContext().getActionMapping();","+        if (mapping == null","+                || !Objects.equals(mapping.getName(), proxy.getActionName())","+                || !Objects.equals(mapping.getNamespace(), proxy.getNamespace())) {","+            return invocation.invoke();","+        }","+","+        if (ActionExtensions.allows(allowed,