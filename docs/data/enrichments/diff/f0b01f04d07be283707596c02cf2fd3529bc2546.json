 opt_name;"," \t\tinfo.metric_type = \"double\";","@@ -128,7 +130,24 @@ vector<MetricInfo> MetricsManager::GetAllMetrics() const {"," \treturn result;"," }"," ","+static bool IsInternalMetric(const string &name) {","+\tfor (idx_t i = 0; internal_metrics[i].name; i++) {","+\t\tif (name == internal_metrics[i].name) {","+\t\t\treturn true;","+\t\t}","+\t}","+\tfor (auto &optimizer : ListAllOptimizers()) {","+\t\tif (name == OptimizerMetricName(optimizer)) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+"," void MetricsManager::RegisterMetric(MetricInfo info) {","+\tif (IsInternalMetric(info.name)) {","+\t\treturn; // the profiler's own metrics are already known, and are not set by extensions","+\t}"," \tlock_guard<mutex> guard(registered_metrics_lock);"," \tfor (const auto &existing : registered_metrics) {"," \t\tif (existing.name == info.name) {","@@ -138,4 +157,14 @@ void MetricsManager::RegisterMetric(MetricInfo info) {"," \tregistered_metrics.push_back(std::move(info));"," }"," ","+bool MetricsManager::IsRegisteredMetric(const string &name) const {","+\tlock_guard<mutex> guard(registered_metrics_lock);","+\tfor (const auto &existing : registered_metrics) {","+\t\tif (existing.name == name) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+"," } // namespace duckdb"],"additions":36,"deletions":7,"truncated":false},{"path":"src/main/profiler/profiling_utils.cpp","lines":["@@ -3,13 +3,23 @@"," "," namespace duckdb {"," ","+void QueryMetrics::FinalizeMetricValues(GatheredMetrics &info) {","+\tannotated_lock_guard<annotated_mutex> guard(string_metrics_lock);","+\tfor (const auto &[key, value] : string_values) {","+\t\tinfo.SetMetric(key, value);","+\t}","+}","+"," void QueryMetrics::FinalizeMetrics(GatheredMetrics &info) {"," \tinfo.SetMetric<MetricQuerySQL>(query_sql);","-\tfor (const auto &[key, timing] : string_timings) {","-\t\tinfo.SetMetric(key, static_cast<double>(timing.duration) / 1e9);","-\t}","-\tfor (const auto &[key, coun