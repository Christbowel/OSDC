x_t elapsed_ns) {","+\tif (IsEnabled() && running) {","+\t\tquery_metrics.UpdateMetric(key, elapsed_ns);","+\t}","+}","+"," void QueryProfiler::SetMetric(const string &key, Value new_value) {","-\tif (!IsEnabled()) {","+\tif (!IsEnabled() || !running) {"," \t\treturn;"," \t}","-\tmetrics->SetMetric(key, std::move(new_value));","+\t// only the metrics extensions registered: the profiler sets its own, and leaves some out on purpose","+\tif (!MetricsManager::Get(context).IsRegisteredMetric(key)) {","+\t\treturn;","+\t}","+\t// the query's metrics are only gathered once its plan is built, so the value is kept with the query until then:","+\t// an extension may set it while the query binds","+\tquery_metrics.SetMetricValue(key, std::move(new_value));"," }"," "," bool QueryProfiler::MetricIsTracked(const string &key) const {","-\tif (!IsEnabled()) {","+\tif (!IsEnabled() || !running) {"," \t\treturn false;"," \t}","-\treturn metrics->MetricIsTracked(key);","+\tif (metrics) {","+\t\treturn metrics->MetricIsTracked(key);","+\t}","+\t// before the plan is built there are no gathered metrics to ask","+\treturn tracked_metric_patterns && tracked_metric_patterns->MetricIsTracked(key);"," }"," "," idx_t QueryProfiler::GetBytesRead() const {","@@ -1207,6 +1226,7 @@ void QueryProfiler::FinalizeMetricsInternal() {"," \tif (query_metrics.latency_timer) {"," \t\tquery_metrics.latency_timer->EndTimer();"," \t}","+\tquery_metrics.FinalizeMetricValues(*metrics);"," \tif (root) {"," \t\t// collapse secure views first - the query-wide totals are sums over the operator tree, so leaving the"," \t\t// operators of the view in would expose how much of the table behind it was scanned. The time of the view"],"additions":25,"deletions":5,"truncated":false},{"path":"test/api/CMakeLists.txt","lines":["@@ -57,6 +57,7 @@ set(TEST_API_OBJECTS","     test_stream_result_buffer.cpp","     test_operator_memory_limit.cpp","     test_query_profiler.cpp","+    test_extension_metrics.cpp","     test_read_ahead_abandon.cpp","     test_read_ahead_progress.cpp","     test_read_ahead_failure.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"test/api/test_extension_metrics.cpp","lines":["@@ -0,0 +1,200 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+#include \"duckdb/catalog/catalog.hpp\"","+#include \"duckdb/common/atomic.hpp\"","+#include \"duckdb/function/scalar_function.hpp\"","+#include \"duckdb/main/profiler/metrics_manager.hpp\"","+#include \"duckdb/main/query_profiler.hpp\"","+#include \"duckdb/parser/parsed_data/create_scalar_function_info.hpp\"","+","+using namespace duckdb;","+","+// The metrics an extension reports through the QueryProfiler, from the functions it runs: these tests call the","+// profiler the way an extension's scalar functions would.","+","+static void RegisterFunction(Connection &con, ScalarFunction function) {","+\tCreateScalarFunctionInfo info(std::move(function));","+\tcon.context->RunFunctionInTransaction(","+\t    [&]() { Catalog::GetSystemCatalog(*con.context).CreateFunction(*con.context, info); });","+}","+","+// A table of a million rows, profiling enabled and eight threads: a scan of the table runs on several threads, where a","+// scan of range() would not.","+static constexpr idx_t ROW_COUNT = 1000000;","+static void SetUpParallelScan(Connection &con, const string &profile_name) {","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE numbers AS SELECT range AS i FROM range(\" + to_string(ROW_COUNT) + \")\"));","+\tREQUIRE_NO_FAIL(con.Query(\"SET threads = 8\"));","+\tcon.EnableProfiling();","+\tcon.context->config.profiler_save_location = TestCreatePath(profile_name);","+}","+","+// The value of the metric `key` in the profile of the last query, or NULL when it is not there.","+static Value GetProfiledMetric(Connection &con, const string &key) {","+\tValue result;","+\tQueryProfiler::Get(*con.context)","+\t    .GetFinalizedProfileUnderLock(","+\t        [&](optional_ptr<const GatheredMetrics> metrics, optional_ptr<const ProfilingNode>) {","+\t\t        REQUIRE(metrics);","+\t\t        auto entry = metrics->GetMetrics().find(key);","+\t\t        if (entry != metrics->GetMetrics().end()) {","+\t\t\t        result = entry->second;","+\t\t        }","+\t        });","+\treturn result;","+}","+","+// Adds the rows of every chunk to a counter shared by all threads, and to one of 64 counters picked by the chunk's","+// first value, so the threads also add new keys to the counters while others are adding to them.","+static void CountRowsExec(DataChunk &args, ExpressionState &state, Vector &result) {","+\tauto &profiler = QueryProfiler::Get(state.GetContext());","+\tauto first = args.data[0].GetValue(0).GetValue<int64_t>();","+\tprofiler.AddToMetricCounter(\"test.rows_counted\", args.size());","+\tprofiler.AddToMetricCounter(\"test.rows_counted_by_chunk_\" + to_string(first / STANDARD_VECTOR_SIZE % 64),","+\t                            args.size());","+\tresult.Reference(args.data[0]);","+}","+","+TEST_CASE(\"Metric counters can be added to from several threads at once\", \"[api][intraquery]\") {","+\tif (STANDARD_VECTOR_SIZE < 1024) {","+\t\t// hundreds of thousands of chunks would take too long","+\t\treturn;","+\t}","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tScalarFunction fn(\"count_rows\", {LogicalType::BIGINT}, LogicalType::BIGINT, CountRowsExec);","+\tfn.SetStability(FunctionStability::VOLATILE);","+\tRegisterFunction(con, std::move(fn));","+\tSetUpParallelScan(con, \"test_metric_counters_output.txt\");","+","+\tREQUIRE_NO_FAIL(con.Query(\"SELECT max(count_rows(i)) FROM numbers\"));","+\tREQUIRE(GetProfiledMetric(con, \"test.rows_counted\") == Value::UBIGINT(ROW_COUNT));","+\tidx_t total_by_chunk = 0;","+\tfor (idx_t chunk = 0; chunk < 64; chunk++) {","+\t\tauto value = GetProfiledMetric(con, \"test.rows_counted_by_chunk_\" + to_string(chunk));","+\t\ttotal_by_chunk += value.IsNull() ? 0 : value.GetValue<idx_t>();","+\t}","+\tREQUIRE(total_by_chunk == ROW_COUNT);","+}","+","+// Ends 16 scoped timers for every chunk, for 16 of 64 timing metrics picked by the chunk's first value, from every","+// thread that runs the scan, so the timers also add new keys while others are ending. Core's own timers can end on","+// several threads too, e.g. the vacuum tasks of a checkpoint.","+static atomic<idx_t> timed_chunks {0};","+static void TimeChunkExec(DataChunk &args, ExpressionState &state, Vector &result) {","+\tauto &profiler = QueryProfiler::Get(state.GetContext());","+\tauto first = NumericCast<idx_t>(args.data[0].GetValue(0).GetValue<int64_t>()) / STANDARD_VECTOR_SIZE;","+\tfor (idx_t i = 0; i < 16; i++) {","+\t\tauto timer = profiler.StartTimerInternal(\"test.chunk_time_\" + to_string((first + i) % 64));","+\t}","+\tresult.Reference(args.data[0]);","+\ttimed_chunks++;","+}","+","+TEST_CASE(\"Scoped timers can end on several threads at once\", \"[api][intraquery]\") {","+\tif (STANDARD_VECTOR_SIZE < 1024) {","+\t\t// sixteen timers for each of the hundreds of thousands of chunks would take too long","+\t\treturn;","+\t}","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tScalarFunction fn(\"time_chunk\", {LogicalType::BIGINT}, LogicalType::BIGINT, TimeChunkExec);","+\tfn.SetStability(FunctionStability::VOLATILE);","+\tRegisterFunction(con, std::move(fn));","+\tSetUpParallelScan(con, \"test_metric_timers_output.txt\");","+","+\ttimed_chunks = 0;","+\tREQUIRE_NO_FAIL(con.Query(\"SELECT max(time_chunk(i)) FROM numbers\"));","+\tREQUIRE(timed_chunks > 64);","+\tfor (idx_t chunk = 0; chunk < 64; chunk++) {","+\t\tauto seconds = GetProfiledMetric(con, \"test.chunk_time_\" + to_string(chunk));","+\t\tREQUIRE(!seconds.IsNull());","+\t\tREQUIRE(seconds.GetValue<double>() > 0);","+\t}","+}","+","+// Adds one millisecond to a timing metric for every chunk, from every thread that runs the scan.","+static atomic<idx_t> add_timing_calls {0};","+static void AddTimingExec(DataChunk &args, ExpressionState &state, Vector &result) {","+\tQueryProfiler::Get(state.GetContext()).AddToMetricTiming(\"test.time_added\", 1000000);","+\tadd_timing_calls++;","+\tresult.Reference(args.data[0]);","+}","+","+TEST_CASE(\"Time measured elsewhere can be added to a timing metric\", \"[api][intraquery]\") {","+\tif (STANDARD_VECTOR_SIZE < 1024) {","+\t\t// hundreds of thousands of chunks would take too long","+\t\treturn;","+\t}","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tScalarFunction fn(\"add_timing\", {LogicalType::BIGINT}, LogicalType::BIGINT, AddTimingExec);","+\tfn.SetStability(FunctionStability::VOLATILE);","+\tRegisterFunction(con, std::move(fn));","+\tSetUpParallelScan(con, \"test_metric_timing_output.txt\");","+","+\tadd_timing_calls = 0;","+\tREQUIRE_NO_FAIL(con.Query(\"SELECT max(add_timing(i)) FROM numbers\"));","+\t// one millisecond for each call, reported in seconds","+\tREQUIRE(add_timing_calls > 1);","+\tauto seconds = GetProfiledMetric(con, \"test.time_added\");","+\tREQUIRE(!seconds.IsNull());","+\tREQUIRE(seconds.GetValue<double>() == Approx(static_cast<double>(add_timing_calls.load()) / 1000.0));","+}","+","+// While the query binds, before its plan is built: sets one metric if it is tracked, one whether or not it is, one that","+// was not registered, and two of the profiler's own, one of which it may leave out.","+static bool tracked_while_binding = false;","+static unique_ptr<FunctionData> SetMetricBind(BindScalarFunctionInput &input) {","+\tauto &profiler = QueryProfiler::Get(input.GetClientContext());","+\ttracked_while_binding = profiler.MetricIsTracked(\"test.set_if_tracked\");","+\tif (tracked_while_binding) {","+\t\tprofiler.SetMetric(\"test.set_if_tracked\", Value::UBIGINT(42));","+\t}","+\tprofiler.SetMetric(\"test.set_always\", Value::UBIGINT(7));","+\tprofiler.SetMetric(\"test.not_registered\", Value::UBIGINT(1));","+\tprofiler.SetMetric(\"query.total_rows_scanned\", Value::UBIGINT(123456789));","+\tprofiler.SetMetric(\"query.total_bytes_scanned\", Value::UBIGINT(123456789));","+\treturn nullptr;","+}","+","+static void PassThroughExec(DataChunk &args, ExpressionState &state, Vector &result) {","+\tresult.Reference(args.data[0]);","+}","+","+TEST_CASE(\"A metric can be set while the query binds\", \"[api]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tScalarFunction fn(\"set_metric_while_binding\", {LogicalType::BIGINT}, LogicalType::BIGINT, PassThroughExec);","+\tfn.SetBindCallback(SetMetricBind);","+\tRegisterFunction(con, std::move(fn));","+\tauto &metrics_manager = MetricsManager::Get(*con.context);","+\tmetrics_manager.RegisterMetric({\"test.set_if_tracked\", \"uint64\", \"Set while binding if tracked\", \"values\"});","+\tmetrics_manager.RegisterMetric({\"test.set_always\", \"uint64\", \"Set while binding\", \"values\"});","+\t// the profiler's own metrics cannot be registered","+\tmetrics_manager.RegisterMetric({\"query.total_bytes_scanned\", \"uint64\", \"Not an extension's\", \"bytes\"});","+\tREQUIRE(!metrics_manager.IsRegisteredMetric(\"query.total_bytes_scanned\"));","+\tmetrics_manager.RegisterMetric({\"optimizer.window_join_pushdown\", \"double\", \"Not an extension's\", \"seconds\"});","+\tREQUIRE(!metrics_manager.IsRegisteredMetric(\"optimizer.window_join_pushdown\"));","+\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE numbers AS SELECT range AS i FROM range(10)\"));","+\tcon.EnableProfiling();","+\tcon.context->config.profiler_save_location = TestCreatePath(\"test_set_metric_output.txt\");","+","+\tREQUIRE_NO_FAIL(con.Query(\"SELECT max(set_metric_while_binding(i)) FROM numbers\"));","+\tREQUIRE(tracked_while_binding);","+\tREQUIRE(GetProfiledMetric(con, \"test.set_if_tracked\") == Value::UBIGINT(42));","+\tREQUIRE(GetProfiledMetric(con, \"test.set_always\") == Value::UBIGINT(7));","+\tREQUIRE(GetProfiledMetric(con, \"test.not_registered\").IsNull());","+\t// the profiler's own metrics keep its values, and stay out when it leaves them out","+\tauto rows_scanned = GetProfiledMetric(con, \"query.total_rows_scanned\");","+\tREQUIRE(!rows_scanned.IsNull());","+\tREQUIRE(rows_scanned.GetValue<idx_t>() == 10);","+\t// a scan of a table does not count the bytes it scans, so the profiler leaves this out","+\tREQUIRE(GetProfiledMetric(con, \"query.total_bytes_scanned\").IsNull());","+","+\t// neither is reported when it is not tracked","+\tREQUIRE_NO_FAIL(con.Query(\"SET tracked_metrics = ['query.*']\"));","+\tREQUIRE_NO_FAIL(con.Query(\"SELECT max(set_metric_while_binding(i)) FROM numbers\"));","+\tREQUIRE(!tracked_while_binding);","+\tREQUIRE(GetProfiledMetric(con, \"test.set_if_tracked\").IsNull());","+\tREQUIRE(GetProfiledMetric(con, \"test.set_always\").IsNull());","+}",""],"additions":200,"deletions":0,"truncated":false}],"additions":345,"deletions":35,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-31T14:37:00.345669+00:00"}