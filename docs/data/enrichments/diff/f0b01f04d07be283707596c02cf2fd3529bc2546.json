y first. Make","+\t// them on threads the query waits for: an update that arrives after the query ends may be lost, or counted for the","+\t// next query.","+","+\t//! Add to a metric counter (profiling-only, thread-safe)."," \tDUCKDB_API void AddToMetricCounter(const string &key, idx_t amount);","+\t//! Add time measured elsewhere, in nanoseconds, to a timing metric, which is reported in seconds (profiling-only,","+\t//! thread-safe). Unlike a timer it records no start and end time. For time a timer cannot measure, e.g. requests","+\t//! that were made on other threads.","+\tDUCKDB_API void AddToMetricTiming(const string &key, idx_t elapsed_ns);"," \t//! Add parser time measured before the per-statement profiler was started."," \tvoid AddParserTime(const Profiler &parser_timer, timestamp_t start_time, timestamp_t end_time);"," ","-\t//! Set an arbitrary metric value (profiling-only; no-op when profiling is disabled).","+\t//! Set the value of a metric an extension registered with ExtensionLoader::RegisterMetric, for the running query","+\t//! (profiling-only). Any other name, including the profiler's own metrics, is ignored. Thread-safe, and may be","+\t//! called while the statement binds or executes; a value set while a prepared statement binds is not kept for its","+\t//! executions."," \tDUCKDB_API void SetMetric(const string &key, Value new_value);","-\t//! Returns true if the given metric is currently being tracked.","-\t//! Always returns false when profiling is disabled.","+\t//! Returns true if the given metric is being tracked for the running query, also while the statement binds.","+\t//! Always returns false when profiling is disabled or no query is being profiled."," \tDUCKDB_API bool MetricIsTracked(const string &key) const;"," "," \t//! Start a timer for a metric identified by its struct type.","@@ -225,6 +237,8 @@ class QueryProfiler {"," \tunique_ptr<ProfilingNode> root;"," "," \tunique_ptr<GatheredMetrics> metrics;","+\t//! The tracked_metrics pat