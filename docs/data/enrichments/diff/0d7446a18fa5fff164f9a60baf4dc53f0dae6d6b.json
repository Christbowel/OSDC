{"id":"0d7446a18fa5fff164f9a60baf4dc53f0dae6d6b","axis":"silent","repo":"envoyproxy/envoy","sha":"0d7446a18fa5fff164f9a60baf4dc53f0dae6d6b","parsed":{"files":[{"path":"api/envoy/extensions/compression/zstd/decompressor/v3/zstd.proto","lines":["@@ -31,4 +31,15 @@ message Zstd {","   // Value for decompressor's next output buffer. If not set, defaults to the zstd recommended","   // output buffer size, ``ZSTD_DStreamOutSize()`` (128 KiB).","   google.protobuf.UInt32Value chunk_size = 2 [(validate.rules).uint32 = {lte: 65536 gte: 4096}];","+","+  // Ratio used to calculate the per-call output threshold before adding ``max_block_size``.","+  // Defaults to 100.","+  google.protobuf.UInt32Value max_inflate_ratio = 3 [(validate.rules).uint32 = {gte: 1}];","+","+  // Additional output allowance in bytes per decompression call. Set this to the sender's maximum","+  // uncompressed zstd block size to allow for a block that spans input chunks. The output threshold","+  // for a call is its compressed input size times ``max_inflate_ratio`` plus ``max_block_size``.","+  // The decompressor forwards the output step that crosses the threshold and ends the call.","+  // Defaults to 0. The largest zstd block is 128 KiB.","+  google.protobuf.UInt32Value max_block_size = 4 [(validate.rules).uint32 = {lte: 131072}];"," }"],"additions":11,"deletions":0,"truncated":false},{"path":"changelogs/current/bug_fixes/zstd__decompressor-output-limit.rst","lines":["@@ -0,0 +1,3 @@","+Added ``max_inflate_ratio`` and ``max_block_size`` to the zstd decompressor. Setting the block allowance to the","+sender's maximum uncompressed block size allows a small input chunk to complete a buffered block. Each call","+still forwards the output step that crosses its threshold before returning."],"additions":3,"deletions":0,"truncated":false},{"path":"docs/root/configuration/http/http_filters/decompressor_filter.rst","lines":["@@ -21,6 +21,17 @@ Currently the filter supports :ref:`gzip <envoy_v3_api_msg_extensions.compressio"," and :ref:`zstd <envoy_v3_api_msg_extensions.compression.zstd.decompressor.v3.Zstd>`"," compression only. Other compression libraries can be supported as extensions."," ","+The zstd decompressor computes a threshold for each call from the compressed input size multiplied by","+:ref:`max_inflate_ratio <envoy_v3_api_field_extensions.compression.zstd.decompressor.v3.Zstd.max_inflate_ratio>`,","+plus :ref:`max_block_size <envoy_v3_api_field_extensions.compression.zstd.decompressor.v3.Zstd.max_block_size>` bytes.","+A small input chunk can complete a block started in an earlier chunk. If this happens, set","+``max_block_size`` to the sender's maximum uncompressed block size (up to 128 KiB).","+The defaults are a ratio of 100 and a block allowance of zero.","+","+Envoy forwards the output of the step that crosses the threshold, increments ``zstd_generic_error``,","+and ends the current call. Output can exceed the threshold by up to one decompressor output buffer.","+Later calls can continue decoding with a fresh threshold.","+"," An example configuration of the filter may look like the following:"," "," .. code-block:: yaml"],"additions":11,"deletions":0,"truncated":false},{"path":"source/extensions/compression/zstd/decompressor/config.cc","lines":["@@ -10,7 +10,9 @@ ZstdDecompressorFactory::ZstdDecompressorFactory(","     const envoy::extensions::compression::zstd::decompressor::v3::Zstd& zstd, Stats::Scope& scope,","     Event::Dispatcher& dispatcher, Api::Api& api, ThreadLocal::SlotAllocator& tls)","     : scope_(scope),","-      chunk_size_(PROTOBUF_GET_WRAPPED_OR_DEFAULT(zstd, chunk_size, ZSTD_DStreamOutSize())) {","+      chunk_size_(PROTOBUF_GET_WRAPPED_OR_DEFAULT(zstd, chunk_size, ZSTD_DStreamOutSize())),","+      max_inflate_ratio_(PROTOBUF_GET_WRAPPED_OR_DEFAULT(zstd, max_inflate_ratio, 100)),","+      max_block_size_(PROTOBUF_GET_WRAPPED_OR_DEFAULT(zstd, max_block_size, 0)) {","   if (zstd.dictionaries_size() > 0) {","     ddict_manager_ = std::make_unique<ZstdDDictManager>(","         zstd.dictionaries(), dispatcher, api, tls, false,","@@ -22,7 +24,8 @@ ZstdDecompressorFactory::ZstdDecompressorFactory("," "," Envoy::Compression::Decompressor::DecompressorPtr"," ZstdDecompressorFactory::createDecompressor(const std::string& stats_prefix) {","-  return std::make_unique<ZstdDecompressorImpl>(scope_, stats_prefix, ddict_manager_, chunk_size_);","+  return std::make_unique<ZstdDecompressorImpl>(scope_, stats_prefix, ddict_manager_, chunk_size_,","+                                                max_inflate_ratio_, max_block_size_);"," }"," "," Envoy::Compression::Decompressor::DecompressorFactoryPtr"],"additions":5,"deletions":2,"truncated":false},{"path":"source/extensions/compression/zstd/decompressor/config.h","lines":["@@ -39,6 +39,8 @@ class ZstdDecompressorFactory : public Envoy::Compression::Decompressor::Decompr"," private:","   Stats::Scope& scope_;","   const uint32_t chunk_size_;","+  const uint32_t max_inflate_ratio_;","+  const uint32_t max_block_size_;","   ZstdDDictManagerPtr ddict_manager_{nullptr};"," };"," "],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/compression/zstd/decompressor/zstd_decompressor_impl.cc","lines":["@@ -1,30 +1,31 @@"," #include \"source/extensions/compression/zstd/decompressor/zstd_decompressor_impl.h\""," ","+#include <limits>","+"," namespace Envoy {"," namespace Extensions {"," namespace Compression {"," namespace Zstd {"," namespace Decompressor {"," ","-namespace {","-","-// How many times the output buffer is allowed to be bigger than the size of","-// accumulated input. This value is used to detect compression bombs.","-// TODO(rojkov): Re-design the Decompressor interface to handle compression","-// bombs gracefully instead of this quick solution.","-constexpr uint64_t MaxInflateRatio = 100;","-","-} // namespace","-"," ZstdDecompressorImpl::ZstdDecompressorImpl(Stats::Scope& scope, const std::string& stats_prefix,","                                            const ZstdDDictManagerPtr& ddict_manager,","-                                           uint32_t chunk_size)","+                                           uint32_t chunk_size, uint32_t max_inflate_ratio,","+                                           uint32_t max_block_size)","     : Envoy::Compression::Zstd::Common::Base(chunk_size), dctx_(ZSTD_createDCtx(), &ZSTD_freeDCtx),","-      ddict_manager_(ddict_manager), stats_(generateStats(stats_prefix, scope)) {}","+      ddict_manager_(ddict_manager), stats_(generateStats(stats_prefix, scope)),","+      max_inflate_ratio_(max_inflate_ratio), max_block_size_(max_block_size) {}"," "," void ZstdDecompressorImpl::decompress(const Buffer::Instance& input_buffer,","                                       Buffer::Instance& output_buffer) {","-  uint64_t limit = MaxInflateRatio * input_buffer.length();","+  const uint64_t input_size = input_buffer.length();","+  if (input_size == 0) {","+    return;","+  }","+  constexpr uint64_t max_output = std::numeric_limits<uint64_t>::max();","+  uint64_t remaining_output = max_inflate_ratio_ > (max_output - max_block_size_) / input_size","+                                  ? max_output","+                                  : input_size * max_inflate_ratio_ + max_block_size_;"," ","   for (const Buffer::RawSlice& input_slice : input_buffer.getRawSlices()) {","     if (input_slice.len_ > 0) {","@@ -47,32 +48,29 @@ void ZstdDecompressorImpl::decompress(const Buffer::Instance& input_buffer,","       }"," ","       setInput(input_slice);","-      if (!process(output_buffer, limit)) {","+      if (!process(output_buffer, remaining_output)) {","         return;","       }","     }","   }"," }"," ","-bool ZstdDecompressorImpl::process(Buffer::Instance& output_buffer, uint64_t limit) {","+bool ZstdDecompressorImpl::process(Buffer::Instance& output_buffer, uint64_t& remaining_output) {","   while (input_.pos < input_.size) {","     const size_t result = ZSTD_decompressStream(dctx_.get(), &output_, &input_);","     if (isError(result)) {","       return false;","     }"," ","+    const size_t step_size = output_.pos;","     getOutput(output_buffer);","-","-    // Check bomb protection after every decompression step, not after the","-    // entire slice is drained. This matches gzip and brotli behavior.","-    if (output_buffer.length() > limit) {","+    if (step_size > remaining_output) {","       stats_.zstd_generic_error_.inc();","-      ENVOY_LOG(trace,","-                \"excessive decompression ratio detected: output \"","-                \"size {} for limit {}\",","-                output_buffer.length(), limit);","+      ENVOY_LOG(trace, \"excessive decompression ratio detected: {} bytes for {} bytes remaining\",","+                step_size, remaining_output);","       return false;","     }","+    remaining_output -= step_size;","   }"," ","   return true;"],"additions":21,"deletions":23,"truncated":false},{"path":"source/extensions/compression/zstd/decompressor/zstd_decompressor_impl.h","lines":["@@ -45,7 +45,8 @@ class ZstdDecompressorImpl : public Envoy::Compression::Zstd::Common::Base,","                              NonCopyable {"," public:","   ZstdDecompressorImpl(Stats::Scope& scope, const std::string& stats_prefix,","-                       const ZstdDDictManagerPtr& ddict_manager, uint32_t chunk_size);","+                       const ZstdDDictManagerPtr& ddict_manager, uint32_t chunk_size,","+                       uint32_t max_inflate_ratio = 100, uint32_t max_block_size = 0);"," ","   // Envoy::Compression::Decompressor::Decompressor","   void decompress(const Buffer::Instance& input_buffer, Buffer::Instance& output_buffer) override;","@@ -56,12 +57,14 @@ class ZstdDecompressorImpl : public Envoy::Compression::Zstd::Common::Base,","   }"," ","   friend class ZstdDecompressorStatsTest;","-  bool process(Buffer::Instance& output_buffer, uint64_t limit);","+  bool process(Buffer::Instance& output_buffer, uint64_t& remaining_output);","   bool isError(size_t result);"," ","   std::unique_ptr<ZSTD_DCtx, decltype(&ZSTD_freeDCtx)> dctx_;","   const ZstdDDictManagerPtr& ddict_manager_;","   const ZstdDecompressorStats stats_;","+  const uint32_t max_inflate_ratio_;","+  const uint32_t max_block_size_;","   bool is_dictionary_set_{false};"," };"," "],"additions":5,"deletions":2,"truncated":false},{"path":"test/extensions/compression/zstd/decompressor/zstd_decompressor_impl_test.cc","lines":["@@ -63,6 +63,63 @@ TEST_F(ZstdDecompressorImplTest, DecompressWithSmallOutputBuffer) {","   EXPECT_EQ(0, stats_store.counterFromString(\"test.zstd_generic_error\").value());"," }"," ","+TEST_F(ZstdDecompressorImplTest, FinalByteCanReleaseBufferedBlock) {","+  constexpr uint32_t max_block_size = 12288;","+  constexpr uint32_t max_inflate_ratio = 200;","+  Buffer::OwnedImpl buffer;","+  TestUtility::feedBufferWithRandomCharacters(buffer, 4096, 42);","+  buffer.add(std::string(max_block_size + max_inflate_ratio - buffer.length(), 'a'));","+  const std::string expected = buffer.toString();","+  Zstd::Compressor::ZstdCompressorImpl compressor{default_compression_level_,","+                                                  default_enable_checksum_, default_strategy_,","+                                                  default_cdict_manager_, 4096};","+  compressor.compress(buffer, Envoy::Compression::Compressor::State::Finish);","+  const std::string compressed = buffer.toString();","+","+  envoy::extensions::compression::zstd::decompressor::v3::Zstd config;","+  config.mutable_chunk_size()->set_value(4096);","+  config.mutable_max_inflate_ratio()->set_value(max_inflate_ratio);","+  config.mutable_max_block_size()->set_value(max_block_size);","+  NiceMock<Server::Configuration::MockFactoryContext> context;","+  ZstdDecompressorLibraryFactory lib_factory;","+  auto factory = lib_factory.createDecompressorFactoryFromProto(config, context);","+  auto decompressor = factory->createDecompressor(\"test.\");","+","+  Buffer::OwnedImpl prefix(compressed.substr(0, compressed.size() - 1));","+  Buffer::OwnedImpl output;","+  decompressor->decompress(prefix, output);","+  ASSERT_EQ(0, output.length());","+  Buffer::OwnedImpl last_byte(compressed.substr(compressed.size() - 1));","+  decompressor->decompress(last_byte, output);","+  Buffer::OwnedImpl empty;","+  decompressor->decompress(empty, output);","+  EXPECT_EQ(expected, output.toString());","+  EXPECT_EQ(0, context.store_.counterFromString(\"test.zstd_generic_error\").value());","+}","+","+TEST_F(ZstdDecompressorImplTest, InflateLimitDoesNotWrap) {","+  class LargeInput : public Buffer::OwnedImpl {","+  public:","+    using Buffer::OwnedImpl::OwnedImpl;","+    uint64_t length() const override { return uint64_t{1} << 63; }","+  };","+","+  const std::string expected = \"zstd payload\";","+  Buffer::OwnedImpl buffer(expected);","+  Zstd::Compressor::ZstdCompressorImpl compressor{default_compression_level_,","+                                                  default_enable_checksum_, default_strategy_,","+                                                  default_cdict_manager_, 4096};","+  compressor.compress(buffer, Envoy::Compression::Compressor::State::Finish);","+  LargeInput input(buffer.toString());","+  Buffer::OwnedImpl output;","+  Stats::IsolatedStoreImpl stats_store;","+  ZstdDecompressorImpl decompressor{","+      *stats_store.rootScope(), \"test.\", default_ddict_manager_, 4096, 2, 0};","+  decompressor.decompress(input, output);","+  EXPECT_EQ(expected, output.toString());","+  EXPECT_EQ(0, stats_store.counterFromString(\"test.zstd_generic_error\").value());","+}","+"," TEST_F(ZstdDecompressorImplTest, WrongInput) {","   Buffer::OwnedImpl buffer;","   Buffer::OwnedImpl output_buffer;","@@ -171,6 +228,70 @@ TEST_F(ZstdDecompressorImplTest, DetectExcessiveCompressionRatio) {","   ASSERT_EQ(stats_store.counterFromString(\"test.zstd_generic_error\").value(), 1);"," }"," ","+TEST_F(ZstdDecompressorImplTest, ForwardsCrossingStepAndDecodesNextCall) {","+  Zstd::Compressor::ZstdCompressorImpl compressor{default_compression_level_,","+                                                  default_enable_checksum_, default_strategy_,","+                                                  default_cdict_manager_, 4096};","+  const std::string block_text(4096, 'a');","+  Buffer::OwnedImpl prefix(\"prefix\");","+  Buffer::OwnedImpl block(block_text);","+  Buffer::OwnedImpl suffix(\"suffix\");","+  compressor.compress(prefix, Envoy::Compression::Compressor::State::Flush);","+  compressor.compress(block, Envoy::Compression::Compressor::State::Flush);","+  compressor.compress(suffix, Envoy::Compression::Compressor::State::Finish);","+  ASSERT_GT(block_text.size(), 100 * block.length());","+","+  Stats::IsolatedStoreImpl stats_store;","+  ZstdDecompressorImpl decompressor{*stats_store.rootScope(), \"test.\", default_ddict_manager_,","+                                    4096};","+  Buffer::OwnedImpl output;","+  decompressor.decompress(prefix, output);","+  ASSERT_EQ(\"prefix\", output.toString());","+  decompressor.decompress(block, output);","+  EXPECT_EQ(\"prefix\" + block_text, output.toString());","+  EXPECT_EQ(1, stats_store.counterFromString(\"test.zstd_generic_error\").value());","+  decompressor.decompress(suffix, output);","+  EXPECT_EQ(\"prefix\" + block_text + \"suffix\", output.toString());","+  EXPECT_EQ(1, stats_store.counterFromString(\"test.zstd_generic_error\").value());","+}","+","+TEST_F(ZstdDecompressorImplTest, BlockAllowanceIsSharedAcrossSlicesInOneCall) {","+  constexpr uint32_t max_inflate_ratio = 4;","+  constexpr uint32_t max_block_size = 16384;","+  Zstd::Compressor::ZstdCompressorImpl compressor{default_compression_level_,","+                                                  default_enable_checksum_, default_strategy_,","+                                                  default_cdict_manager_, 4096};","+  Buffer::OwnedImpl prefix;","+  TestUtility::feedBufferWithRandomCharacters(prefix, 32768, 42);","+  compressor.compress(prefix, Envoy::Compression::Compressor::State::Flush);","+","+  Stats::IsolatedStoreImpl stats_store;","+  ZstdDecompressorImpl decompressor{*stats_store.rootScope(), \"test.\",","+                                    default_ddict_manager_,   32768,","+                                    max_inflate_ratio,        max_block_size};","+  Buffer::OwnedImpl prefix_output;","+  decompressor.decompress(prefix, prefix_output);","+  ASSERT_EQ(32768, prefix_output.length());","+","+  Buffer::OwnedImpl first_block(std::string(max_block_size, 'a'));","+  Buffer::OwnedImpl second_block(std::string(max_block_size, 'b'));","+  Buffer::OwnedImpl third_block(std::string(max_block_size, 'c'));","+  compressor.compress(first_block, Envoy::Compression::Compressor::State::Flush);","+  compressor.compress(second_block, Envoy::Compression::Compressor::State::Flush);","+  compressor.compress(third_block, Envoy::Compression::Compressor::State::Finish);","+  Buffer::OwnedImpl input;","+  input.appendSliceForTest(first_block.toString());","+  input.appendSliceForTest(second_block.toString());","+  input.appendSliceForTest(third_block.toString());","+  const uint64_t limit = input.length() * max_inflate_ratio + max_block_size;","+  ASSERT_LT(limit, 2 * max_block_size);","+","+  Buffer::OwnedImpl output;","+  decompressor.decompress(input, output);","+  EXPECT_EQ(1, stats_store.counterFromString(\"test.zstd_generic_error\").value());","+  EXPECT_EQ(std::string(max_block_size, 'a') + std::string(max_block_size, 'b'), output.toString());","+}","+"," } // namespace"," "," // Copy from",""],"additions":121,"deletions":0,"truncated":false}],"additions":179,"deletions":27,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-17T18:45:28.710929+00:00"}