{"id":"3d304b003200054c77e1a928824b09553c072d00","axis":"silent","repo":"tensorflow/tensorflow","sha":"3d304b003200054c77e1a928824b09553c072d00","parsed":{"files":[{"path":"third_party/xla/xla/backends/gpu/codegen/triton/lowering_util.cc","lines":["@@ -250,13 +250,13 @@ bool IsGuaranteedDivisible(mlir::Value value, int64_t divisor) {","   return false;"," }"," ","-bool IsGuaranteedInBounds(mlir::Value value, int64_t tile_size,","+bool IsGuaranteedInBounds(mlir::Value offset, int64_t tile_size,","                           int64_t original_shape) {","-  if (auto const_op = value.getDefiningOp<arith::ConstantIndexOp>()) {","+  if (auto const_op = offset.getDefiningOp<arith::ConstantIndexOp>()) {","     return const_op.value() >= 0 &&","            const_op.value() + tile_size <= original_shape;","   }","-  if (auto apply_indexing = value.getDefiningOp<::xla::ApplyIndexingOp>()) {","+  if (auto apply_indexing = offset.getDefiningOp<::xla::ApplyIndexingOp>()) {","     IndexingMap indexing_map = apply_indexing.getIndexingMap();","     if (indexing_map.GetNumResults() != 1) {","       return false;"],"additions":3,"deletions":3,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/lowering_util.h","lines":["@@ -100,6 +100,13 @@ mlir::Value ExpandAndBroadcastValue(mlir::ImplicitLocOpBuilder& builder,"," // This assumes that 'value' is a constant or an apply indexing op."," bool IsGuaranteedDivisible(mlir::Value value, int64_t divisor);"," ","+// Returns true if `0 <= offset` and `offset + tile_size <= original_shape` are","+// guaranteed, i.e. a contiguous (stride 1) tile of `tile_size` elements","+// starting at `offset` lies within the dimension. Returns false if `offset` is","+// not a constant or an apply indexing op.","+bool IsGuaranteedInBounds(mlir::Value offset, int64_t tile_size,","+                          int64_t original_shape);","+"," // Creates a tensor of pointers and a tensor of masks for loading and"," // storing tiles. Reduced dimensions are the dimensions that are reduced by"," // the tile."],"additions":7,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/transforms/tdm_lowering_util.cc","lines":["@@ -56,7 +56,7 @@ ::xla::Decision CanUseTdm(bool allow_tdm, ArrayRef<int64_t> original_shape,","                           ArrayRef<int64_t> tile_sizes,","                           ArrayRef<int64_t> tile_strides,","                           ArrayRef<int64_t> minor_to_major_layout,","-                          int64_t element_bit_width) {","+                          ValueRange tile_offsets, int64_t element_bit_width) {","   if (!allow_tdm) {","     return ::xla::Decision::Forbid(\"TDM is disabled.\");","   }","@@ -97,6 +97,16 @@ ::xla::Decision CanUseTdm(bool allow_tdm, ArrayRef<int64_t> original_shape,","     return ::xla::Decision::Forbid(","         \"surviving minor-most dim spans fewer than 2 dwords.\");","   }","+  // Singleton dims are folded into the base pointer and escape the hardware","+  // bounds check, so their offsets must be provably in bounds.","+  CHECK_EQ(tile_offsets.size(), tile_sizes.size());","+  for (auto [dim, size] : llvm::enumerate(tile_sizes)) {","+    if (size == 1 && !xtriton::IsGuaranteedInBounds(tile_offsets[dim], size,","+                                                    original_shape[dim])) {","+      return ::xla::Decision::Forbid(","+          \"singleton tile dim offset is not provably in bounds.\");","+    }","+  }","   return ::xla::Decision::Allow();"," }"," "],"additions":11,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/transforms/tdm_lowering_util.h","lines":["@@ -38,9 +38,14 @@ llvm::SmallVector<int64_t> GetSingletonTileDims("," //   - non-unit tile strides"," //   - tiles the singleton fold cannot turn into a valid TDM box"," //   - tiles whose surviving minor-most dim spans fewer than 2 dwords","+//   - tiles with a singleton dim whose offset is not provably in bounds"," //"," // Singleton (size-1) tile dims are folded into the base pointer (at any"," // position, not just trailing) and dropped from the descriptor.","+// Folded dims are no longer bounds checked by the hardware, so their offsets","+// must be provably within [0, original_shape) (e.g. tiles of a high-padded","+// operand may have offsets past the end of the dimension); otherwise TDM is","+// declined and the masked pointer lowering is used."," // TDM requires the descriptor's minor-most dim to have global stride 1. After"," // folding, that dim is the minor-most survivor, which keeps stride 1 only if no"," // folded singleton was more-minor than it. A batch-major operand [1, M, K]","@@ -60,7 +65,7 @@ ::xla::Decision CanUseTdm(bool allow_tdm,","                           llvm::ArrayRef<int64_t> tile_sizes,","                           llvm::ArrayRef<int64_t> tile_strides,","                           llvm::ArrayRef<int64_t> minor_to_major_layout,","-                          int64_t element_bit_width);","+                          ValueRange tile_offsets, int64_t element_bit_width);"," "," // Wraps CanUseTdm, logging the reason when TDM is declined."," bool TdmAllowed(const ::xla::Decision& decision);"],"additions":6,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/transforms/tests/triton_xla_extract_insert_to_triton.mlir","lines":["@@ -436,10 +436,10 @@ module {"," "," // CHECK-TDM-LABEL: tt.func @incompatible_tma_dynamic_offset_not_divisible_by_16_bytes"," // CHECK-TDM:         tt.descriptor_load","-// CHECK-TDM:         %[[PTR1:.*]] = tt.addptr %arg1, %{{.*}} : !tt.ptr<bf16>, i64","-// CHECK-TDM:         %[[DESC1:.*]] = tt.make_tensor_descriptor %[[PTR1]]","-// CHECK-TDM-SAME:       <bf16>, <16x16xbf16>","-// CHECK-TDM:         tt.descriptor_store %[[DESC1]]","+// The insert's singleton dim 1 (size 1) has offsets in [0, 63], which are not","+// provably in bounds, so TDM is declined and the masked pointer path is used.","+// CHECK-TDM-NOT:     tt.descriptor_store","+// CHECK-TDM:         tt.store"," "," // ============================================================================="," // Tests for TMA condition: (num_stages > 1 && HasBroadcast && (tile_bytes % 128 != 0))","@@ -655,3 +655,36 @@ func.func @extract_with_transposing_layout("," // CHECK-TMA:         %[[TRANS:.*]] = tt.trans %[[LOAD]]"," // CHECK-TMA-SAME:        tensor<64x2x128xbf16> -> tensor<2x64x128xbf16>"," // CHECK-TMA:         tt.descriptor_store %arg1[{{.*}}], %[[TRANS]]","+","+","+// -----","+","+// Tiles of a high-padded operand: the singleton dim 0 offset (pid mod 16)","+// ranges over [0, 15] for a dimension of size 4. TDM would fold that offset into","+// the base pointer without a bounds check, so it must be declined in favor of","+// the masked pointer lowering.","+#indexing_map_pad_oob = #xla.indexing_map<\"(pid) -> (pid mod 16), domain: pid in [0, 63]\">","+#indexing_map_pad_in_bounds = #xla.indexing_map<\"(pid) -> (pid floordiv 16), domain: pid in [0, 63]\">","+module {","+  func.func @tdm_declined_for_out_of_bounds_singleton_offset(","+      %arg0: !tt.ptr<bf16>, %arg1: !tt.ptr<bf16>) {","+    %0 = tt.get_program_id x : i32","+    %1 = arith.index_cast %0 : i32 to index","+    %2 = xla.apply_indexing #indexing_map_pad_oob(%1)","+    %3 = xla.apply_indexing #indexing_map_pad_in_bounds(%1)","+    %extracted_tile = triton_xla.extract from %arg0","+        as memref<4x64xbf16, #xtile.layout<[1, 0]>>","+        [%2, 0] [1, 64] [1, 1] : tensor<64xbf16>","+    triton_xla.insert %extracted_tile into %arg1","+        as memref<4x64xbf16, #xtile.layout<[1, 0]>>","+        [%3, 0] [1, 64] [1, 1] : tensor<64xbf16>","+    func.return","+  }","+}","+","+// CHECK-TDM-LABEL: tt.func @tdm_declined_for_out_of_bounds_singleton_offset","+// CHECK-TDM-NOT:     tt.descriptor_load","+// CHECK-TDM:         arith.cmpi slt","+// CHECK-TDM:         tt.load","+// CHECK-TDM:         tt.make_tensor_descriptor","+// CHECK-TDM:         tt.descriptor_store"],"additions":37,"deletions":4,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/transforms/triton_xla_extract_insert_to_triton_pass.cc","lines":["@@ -405,9 +405,9 @@ class RewriteExtract : public mlir::OpRewritePattern<ExtractOp> {","       return mlir::success();","     }"," ","-    if (TdmAllowed(","-            CanUseTdm(allow_tdm_, src_shape, sizes, strides, src_layout,","-                      tile_type.getElementType().getIntOrFloatBitWidth()))) {","+    if (TdmAllowed(CanUseTdm(","+            allow_tdm_, src_shape, sizes, strides, src_layout, offsets,","+            tile_type.getElementType().getIntOrFloatBitWidth()))) {","       SmallVector<int64_t> singleton_dims =","           GetSingletonTileDims(sizes, src_layout);","       TdmDescriptorOperands operands(op.getSrc(), src_shape, src_layout, sizes,","@@ -554,7 +554,7 @@ class RewriteInsert : public mlir::OpRewritePattern<InsertOp> {","           builder, cast_to_tensor_desc.getResult(0), src,","           xtriton::IndexCast(builder, builder.getI32Type(), ordered_offsets));","     } else if (TdmAllowed(CanUseTdm(","-                   allow_tdm_, dst_shape, sizes, strides, dst_layout,","+                   allow_tdm_, dst_shape, sizes, strides, dst_layout, offsets,","                    tile_type.getElementType().getIntOrFloatBitWidth()))) {","       SmallVector<int64_t> singleton_dims =","           GetSingletonTileDims(sizes, dst_layout);"],"additions":4,"deletions":4,"truncated":false},{"path":"third_party/xla/xla/codegen/xtile/ir/xtile_ops.td","lines":["@@ -215,6 +215,16 @@ def MemRefBitcastOp : XTile_Op<\"memref_bitcast\","," def ExtractTileOp : XTile_Op<\"extract\", [TiledBufferInterface]> {","   let summary = \"Extract a tile from a memref.\";","   let description = [{","+    Reads the elements `source[offsets[d] + i_d * strides[d]]` for every","+    `i_d` in `[0, full_tile_shape[d])`.","+","+    Neither the offsets nor the indices they address are required to be in","+    bounds: tiling may produce offsets past the end of a dimension (e.g. for","+    tiles of a high-padded operand), and even an in-bounds offset may address","+    indices `offsets[d] + i_d * strides[d]` past the end. Lowerings must never","+    access memory outside the `source` buffer. Elements whose index lies","+    outside `[0, dim_size)` in any dimension are not read and have an","+    unspecified value in the result.","   }];"," ","   let arguments = (ins","@@ -243,6 +253,15 @@ def ExtractTileOp : XTile_Op<\"extract\", [TiledBufferInterface]> {"," def InsertTileOp : XTile_Op<\"insert\", [TiledBufferInterface]> {","   let summary = \"Insert a tile into a memref.\";","   let description = [{","+    Writes the tile to `destination[offsets[d] + i_d * strides[d]]` for every","+    `i_d` in `[0, full_tile_shape[d])`.","+","+    Neither the offsets nor the indices they address are required to be in","+    bounds: e.g. the last tile of a dimension that is not a multiple of the","+    tile size starts in bounds but addresses indices","+    `offsets[d] + i_d * strides[d]` past the end. Lowerings must never access","+    memory outside the `destination` buffer. Elements whose index lies outside","+    `[0, dim_size)` in any dimension are not written.","   }];"," ","   let arguments = (ins",""],"additions":19,"deletions":0,"truncated":false}],"additions":87,"deletions":13,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-31T14:36:09.831909+00:00"}