ious_buffer_handle->buffer_size - previous_buffer_handle->buffer_start;"," \tauto prev_buffer_ptr = char_ptr_cast(previous_buffer_handle->buffer.get()) + previous_buffer_handle->buffer_size;","-\tauto prev_object_start = PreviousNewline(prev_buffer_ptr, prev_buffer_size);","+\t// the first buffer of a file that is only a byte order mark holds nothing past it","+\tauto prev_object_start =","+\t    prev_buffer_size == 0 ? prev_buffer_ptr : PreviousNewline(prev_buffer_ptr, prev_buffer_size);"," \tauto prev_object_size = NumericCast<idx_t>(prev_buffer_ptr - prev_object_start);"," "," \tD_ASSERT(scan_state.buffer_offset == options.maximum_object_size);","@@ -935,13 +937,16 @@ bool JSONReader::CopyRemainderFromPreviousBuffer(JSONReaderScanState &scan_state"," \t// Now copy the data to our reconstruct buffer"," \tmemcpy(scan_state.buffer_ptr + scan_state.buffer_offset - prev_object_size, prev_object_start, prev_object_size);"," ","+\t// Just a newline, or nothing. A single byte without a newline before it is a value, such as a 1 at the end of a","+\t// file. This is checked before the previous buffer is released","+\tconst bool no_remainder = prev_object_size == 0 || (prev_object_size == 1 && *prev_object_start == '\\n');","+"," \t// We copied the object, so we are no longer reading the previous buffer"," \tif (--previous_buffer_handle->readers == 0) {"," \t\tRemoveBuffer(*previous_buffer_handle);"," \t}"," ","-\tif (prev_object_size == 1) {","-\t\t// Just a newline","+\tif (no_remainder) {"," \t\treturn false;"," \t}"," \tscan_state.buffer_offset -= prev_object_size;","@@ -1109,7 +1114,12 @@ void JSONReader::FinalizeBuffer(JSONReaderScanState &scan_state) {"," \t// skip over the array start if required"," \tif (!scan_state.is_last) {"," \t\tif (scan_state.buffer_index.GetIndex() == 0) {","-\t\t\tStringUtil::SkipBOM(scan_state.buffer_ptr, scan_state.buffer_size, scan_state.buffer_offset);","+\t\t\t// the file starts at the buffer offset, which leaves room for the end of a previous buffer when the file","+\t\t\t// is read in parallel","+\t\t\tidx_t bom_size = 0;","+\t\t\tStringUtil::SkipBOM(scan_state.buffer_ptr + scan_state.buffer_offset,","+\t\t\t                    scan_state.buffer_size - scan_state.buffer_offset, bom_size);","+\t\t\tscan_state.buffer_offset += bom_size;"," \t\t\tif (GetFormat() == JSONFormat::ARRAY) {"," \t\t\t\tSkipOverArrayStart(scan_state);"," \t\t\t}"],"additions":14,"deletions":4,"truncated":false},{"path":"src/common/tree_renderer/text_tree_renderer.cpp","lines":["@@ -34,9 +34,16 @@ static bool IsCharacter(char c) {"," //===--------------------------------------------------------------------===//"," struct ExplainSpan {"," \tExplainSpan(string text_p, TreeRenderType type_p) : text(std::move(text_p)), type(type_p) {","+\t\twidth = RenderLength(text);","+\t}","+\tvoid SetText(string text_p) {","+\t\ttext = std::move(text_p);","+\t\twidth = RenderLength(text);"," \t}"," \tstring text;"," \tTreeRenderType type;","+\t//! The render width of the text, measured once, as lines are measured many times while a plan is laid out","+\tidx_t width;"," };"," "," using ExplainLine = vector<ExplainSpan>;","@@ -53,7 +60,7 @@ struct ExplainBlock {"," static idx_t LineWidth(const ExplainLine &line) {"," \tidx_t width = 0;"," \tfor (auto &span : line) {","-\t\twidth += RenderLength(span.text);","+\t\twidth += span.width;"," \t}"," \treturn width;"," }","@@ -103,7 +110,7 @@ static void AppendAt(ExplainLine &dst, const ExplainLine &src, idx_t content_col"," \t\t}"," \t\tif (i < span.text.size()) {"," \t\t\tExplainSpan trimmed = span;","-\t\t\ttrimmed.text = span.text.substr(i);","+\t\t\ttrimmed.SetText(span.text.substr(i));"," \t\t\tdst.push_back(std::move(trimmed));"," \t\t}"," \t}","@@ -113,7 +120,7 @@ static void AppendAt(ExplainLine &dst, const ExplainLine &src, idx_t content_col"," static bool RenderCharEquals(const ExplainLine &line, idx_t col, const char *expected) {"," \tidx_t col_offset = 0;"," \tfor (auto &span : line) 