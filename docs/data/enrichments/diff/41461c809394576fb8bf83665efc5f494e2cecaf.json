yQuota::NO_RETRY_REFUND);"," \t\t}","+\t\tfor (auto &charge : earlier_throttled_retries) {","+\t\t\tcharge.quota->Release(charge.cost);","+\t\t}"," \t}"," \tForgetLastRetry();"," }","@@ -190,6 +193,8 @@ void HTTPRetryBudget::Settle(bool success) {"," void HTTPRetryBudget::ForgetLastRetry() {"," \tlast_retry_quota.reset();"," \tlast_retry_cost = 0;","+\tlast_retry_throttled = false;","+\tearlier_throttled_retries.clear();"," }"," "," uint64_t HTTPRetryBudget::BackoffMs(uint64_t retry_wait_ms, float retry_backoff, uint64_t retry, uint64_t floor_ms,","@@ -335,8 +340,12 @@ bool HTTPRetryBudget::ConsumeAndWait(const HTTPRetryDecision &decision) {"," \t\treturn false;"," \t}"," \t// The admitted retry is the one a later success refunds; its outcome is still open.","+\tif (last_retry_quota && last_retry_throttled) {","+\t\tearlier_throttled_retries.push_back(HTTPThrottledRetryCharge {std::move(last_retry_quota), last_retry_cost});","+\t}"," \tlast_retry_quota = quota;"," \tlast_retry_cost = cost;","+\tlast_retry_throttled = throttled;"," \toutcome_settled = false;"," \tretries_used++;"," \tif (throttled) {"],"additions":9,"deletions":0,"truncated":false},{"path":"src/storage/metadata/metadata_manager.cpp","lines":["@@ -437,6 +437,20 @@ void MetadataManager::ClearModifiedBlocks(const vector<MetaBlockPointer> &pointe"," \tif (pointers.empty()) {"," \t\treturn;"," \t}","+\tvector<MetaBlockPointer> next_pointers;","+\tif (keep_next_blocks) {","+\t\t// several pointers can be in one block, whose header is read once","+\t\tunordered_set<idx_t> kept_blocks;","+\t\tfor (auto &pointer : pointers) {","+\t\t\tif (!kept_blocks.insert(pointer.block_pointer).second) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tauto next_block = GetNextBlock(pointer);","+\t\t\tif (next_block.IsValid()) {","+\t\t\t\tnext_pointers.push_back(next_block);","+\t\t\t}","+\t\t}","+\t}"," \tunique_lock<mutex> guard(block_lock);"," \tfor (auto &pointer : pointers) {"," \t\tauto block_id = pointer.GetBlockId();","@@ -449,6 +463,24 @@ void MetadataManager::ClearModifiedBlocks(const vector<MetaBlockPointer> &pointe"," \t\t// unset the bit"," \t\tmodified_list &= ~(1ULL << block_index);"," \t}","+\tfor (auto &pointer : next_pointers) {","+\t\t// the next block was in use before this checkpoint, otherwise it is left as it is","+\t\tauto entry = modified_blocks.find(pointer.GetBlockId());","+\t\tif (entry != modified_blocks.end()) {","+\t\t\tentry->second &= ~(1ULL << pointer.GetBlockIndex());","+\t\t}","+\t}","+}","+","+void MetadataManager::SetStorageVersion(StorageVersion storage_version) {","+\tkeep_next_blocks = storage_version < StorageVersion::V1_5_0;","+}","+","+MetaBlockPointer MetadataManager::GetNextBlock(MetaBlockPointer pointer) {","+\tauto metadata_pointer = FromDiskPointer(pointer);","+\tauto handle = Pin(metadata_pointer);","+\tauto next_block = Load<idx_t>(handle.handle.Ptr() + metadata_pointer.index * GetMetadataBlockSize());","+\treturn MetaBlockPointer(next_block, 0);"," }"," "," bool MetadataManager::BlockIsModified(const MetaBlockPointer &pointer) {"],"additions":32,"deletions":0,"truncated":false},{"path":"src/storage/single_file_block_manager.cpp","lines":["@@ -538,6 +538,7 @@ void SingleFileBlockManager::CreateNewDatabase(QueryContext context) {"," "," \toptions.version_number = GetVersionNumber();"," \tdb.GetStorageManager().SetStorageVersion(options.storage_version);","+\tGetMetadataManager().SetStorageVersion(options.storage_version);"," \tAddStorageVersionTag();"," "," \tMainHeader main_header = ConstructMainHeader(options.version_number);","@@ -854,6 +855,7 @@ void SingleFileBlockManager::Initialize(const DatabaseHeader &header, const opti"," \t}"," "," \tdb.GetStorageManager().SetStorageVersion(options.storage_version);","+\tGetMetadataManager().SetStorageVersion(options.storage_version);"," "," \tif (block_alloc_size.IsValid() && block_alloc_size.GetIndex() != header.block_alloc_size) {"," \t\tthrow InvalidInputException("],"additions":2,"deletions":0,"truncated":false},{"path":"test/api/CMakeLists.txt","lines":["@@ -31,6 +31,7 @@ set(TEST_API_OBJECTS","     test_extension_setting_autoload.cpp","     test_instance_cache.cpp","     test_metadata_pin_race.cpp","+    test_metadata_chain_old_readers.cpp","     test_storage_extension_alias.cpp","     test_storage_extension_remote_path.cpp","     test_static_database_callback.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"test/api/test_metadata_chain_old_readers.cpp","lines":["@@ -0,0 +1,117 @@","+#include \"catch.hpp\"","+#include \"duckdb/catalog/catalog.hpp\"","+#include \"duckdb/common/types/value.hpp\"","+#include \"duckdb/main/client_context.hpp\"","+#include \"duckdb/storage/block_manager.hpp\"","+#include \"duckdb/storage/database_size.hpp\"","+#include \"duckdb/storage/metadata/metadata_manager.hpp\"","+#include \"duckdb/storage/storage_manager.hpp\"","+#include \"duckdb/catalog/catalog_entry/table_catalog_entry.hpp\"","+#include \"duckdb/parser/qualified_name.hpp\"","+#include \"duckdb/storage/data_table.hpp\"","+#include \"duckdb/storage/table/row_group_collection.hpp\"","+#include \"test_helpers.hpp\"","+","+#include <set>","+","+using namespace duckdb;","+","+namespace {","+","+struct MetadataBlock {","+\tblock_id_t block_id;","+\tidx_t index;","+","+\tbool operator<(const MetadataBlock &other) const {","+\t\treturn block_id < other.block_id || (block_id == other.block_id && index < other.index);","+\t}","+};","+","+//! The blocks of the table data that readers before v1.4.2 enter and whose next pointer leads to a block that is","+//! not in use. Those readers resolve the next pointer of a block as soon as they enter it, so such a pointer makes","+//! them fail to open the file.","+idx_t CountNextPointersToFreeBlocks(Connection &con, idx_t table_count) {","+\tcon.BeginTransaction();","+\tauto &catalog = Catalog::GetCatalog(*con.context, \"\");","+\tauto &metadata_manager = StorageManager::Get(catalog).GetBlockManager().GetMetadataManager();","+\tstd::set<MetadataBlock> in_use;","+\tfor (auto &info : metadata_manager.GetMetadataInfo()) {","+\t\tstd::set<idx_t> free_blocks(info.free_list.begin(), info.free_list.end());","+\t\tfor (idx_t i = 0; i < info.total_blocks; i++) {","+\t\t\tif (free_blocks.find(i) == free_blocks.end()) {","+\t\t\t\tin_use.insert(MetadataBlock {info.block_id, i});","+\t\t\t}","+\t\t}","+\t}","+\tidx_t result = 0;","+\tfor (idx_t t = 0; t < table_count; t++) {","+\t\tauto &table = Catalog::GetEntry<TableCatalogEntry>(","+\t\t    *con.context, QualifiedName(INVALID_CATALOG, DEFAULT_SCHEMA, Identifier(\"candles_\" + std::to_string(t))));","+\t\tauto &collection = *table.GetStorage().GetRowGroupCollection();","+\t\t// loading every row group adds the rest of the table metadata to the pointers","+\t\tREQUIRE(collection.GetRowGroupCount() > 0);","+\t\tauto &pointers = collection.GetMetadataPointers();","+\t\tREQUIRE(!pointers.empty());","+\t\tfor (auto &pointer : pointers) {","+\t\t\tauto next_block = metadata_manager.GetNextBlock(pointer);","+\t\t\tif (!next_block.IsValid()) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tif (in_use.find(MetadataBlock {next_block.GetBlockId(), next_block.GetBlockIndex()}) == in_use.end()) {","+\t\t\t\tresult++;","+\t\t\t}","+\t\t}","+\t}","+\tcon.Commit();","+\treturn result;","+}","+","+} // namespace","+","+TEST_CASE(\"Metadata of a file for older versions has no next pointers into free blocks\", \"[storage]\") {","+\t// every storage format below v1.5.0","+\tauto storage_version = GENERATE(as<string> {}, \"v1.0.0\", \"v1.2.0\", \"v1.3.0\", \"v1.4.0\");","+\tINFO(\"storage version \" << storage_version);","+\tauto path = TestCreatePath(\"metadata_chain_old_readers.db\");","+\tDeleteDatabase(path);","+\tauto config = GetTestConfig();","+\tconfig->SetOptionByName(\"storage_compatibility_version\", Value(storage_version));","+\t// only the explicit checkpoints below write the file, automatic ones would rewrite the tables this relies on","+\tconfig->options.checkpoint_wal_size = idx_t(1) << 40;","+\tconfig->options.checkpoint_on_shutdown = false;","+\tconst idx_t table_count = 9;","+\t// the database that creates the file drops the first tables, the database that opens it again drops the others","+\tconst idx_t dropped_before_reopen = 4;","+\t{","+\t\tDuckDB db(path, config.get());","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TEMP TABLE wide AS PIVOT (SELECT i, j, i * j AS v FROM range(1000) t(i), \"","+\t\t                          \"range(100) s(j)) ON j USING first(v) ORDER BY i\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TEMP TABLE narrow AS SELECT i, i * 2 AS b, i * 3 AS c, i * 4 AS d, i * 5 AS \"","+\t\t                          \"e FROM range(1000) t(i)\"));","+\t\tfor (idx_t i = 0; i < table_count; i++) {","+\t\t\tauto suffix = std::to_string(i);","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE candles_\" + suffix + \" AS FROM narrow\"));","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE other_\" + suffix + \" AS FROM wide\"));","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t\t}","+\t\tfor (idx_t i = 0; i < dropped_before_reopen; i++) {","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"DROP TABLE other_\" + std::to_string(i)));","+\t\t}","+\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t}","+\t{","+\t\tDuckDB db(path, config.get());","+\t\tConnection con(db);","+\t\tfor (idx_t i = dropped_before_reopen; i < table_count; i++) {","+\t\t\tREQUIRE_NO_FAIL(con.Query(\"DROP TABLE other_\" + std::to_string(i)));","+\t\t}","+\t\tREQUIRE_NO_FAIL(con.Query(\"CHECKPOINT\"));","+\t}","+\tDuckDB db(path, config.get());","+\tConnection con(db);","+\tauto result = con.Query(\"SELECT count(*) FROM duckdb_tables()\");","+\tREQUIRE(CHECK_COLUMN(result, 0, {Value::UBIGINT(table_count)}));","+\tREQUIRE(CountNextPointersToFreeBlocks(con, table_count) == 0);","+\tDeleteDatabase(path);","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"test/common/test_http_retry_budget.cpp","lines":["@@ -199,6 +199,95 @@ TEST_CASE(\"HTTP retry budget stops when the host quota is exhausted\", \"[http]\")"," \tREQUIRE(quota->Available() == HTTPRetryQuota::NO_RETRY_REFUND);"," }"," ","+TEST_CASE(\"HTTP retry quota is not drained by requests that get through after being throttled\", \"[http]\") {","+\tHTTPUtil http_util;","+\tHTTPParams params(http_util);","+\tparams.retry_wait_ms = 0;","+\tauto quota = make_shared_ptr<HTTPRetryQuota>();","+\t// start below the capacity, so that a refund beyond what was charged would show","+\tREQUIRE(quota->TryAcquire(100));","+\tconst auto available = HTTPRetryQuota::INITIAL_CAPACITY - 100;","+","+\t// as for a glob over many objects of a host that throttles each object twice (duckdb/duckdb#6153)","+\tfor (idx_t object = 0; object < 1000; object++) {","+\t\tHTTPRetryBudget budget(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\t\tbudget.BindQuota(quota);","+\t\tidx_t attempts = 0;","+\t\tbudget.Run([&]() {","+\t\t\tattempts++;","+\t\t\treturn attempts <= 2 ? HTTPRetryDecision::Throttled(\"0\") : HTTPRetryDecision::Finish();","+\t\t});","+\t\tREQUIRE(attempts == 3);","+\t\tREQUIRE_FALSE(budget.QuotaExhausted());","+\t\tbudget.ReportSuccess();","+\t}","+\tREQUIRE(quota->Available() == available);","+","+\t// a server error before the throttle is not refunded, as for an operation that retried server errors only","+\tHTTPRetryBudget error_then_throttle(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\terror_then_throttle.BindQuota(quota);","+\tidx_t attempts = 0;","+\terror_then_throttle.Run([&]() {","+\t\tattempts++;","+\t\tif (attempts == 1) {","+\t\t\treturn HTTPRetryDecision::Retry();","+\t\t}","+\t\treturn attempts == 2 ? HTTPRetryDecision::Throttled(\"0\") : HTTPRetryDecision::Finish();","+\t});","+\terror_then_throttle.ReportSuccess();","+\tREQUIRE(quota->Available() == available - HTTPRetryQuota::RETRY_COST);","+","+\t// throttles before a server error are refunded with it","+\tHTTPRetryBudget throttle_then_error(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tthrottle_then_error.BindQuota(quota);","+\tattempts = 0;","+\tthrottle_then_error.Run([&]() {","+\t\tattempts++;","+\t\tif (attempts <= 2) {","+\t\t\treturn HTTPRetryDecision::Throttled(\"0\");","+\t\t}","+\t\treturn attempts == 3 ? HTTPRetryDecision::Retry() : HTTPRetryDecision::Finish();","+\t});","+\tthrottle_then_error.ReportSuccess();","+\tREQUIRE(quota->Available() == available - HTTPRetryQuota::RETRY_COST);","+","+\t// a request that keeps being throttled is not refunded, so the quota still stops a host that never lets one through","+\tHTTPRetryBudget throttled(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tthrottled.BindQuota(quota);","+\tthrottled.Run([&]() { return HTTPRetryDecision::Throttled(\"0\"); });","+\tthrottled.ReportFailure();","+\tREQUIRE(quota->Available() == available - HTTPRetryQuota::RETRY_COST -","+\t                                  static_cast<int64_t>(throttled.RetriesUsed()) * HTTPRetryQuota::RETRY_COST);","+","+\t// a failure after throttles refunds nothing, and a later clean run of the same budget refunds a single token","+\tconst auto before_failure = quota->Available();","+\tHTTPRetryBudget failed(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tfailed.BindQuota(quota);","+\tattempts = 0;","+\tfailed.Run([&]() {","+\t\tattempts++;","+\t\treturn attempts <= 2 ? HTTPRetryDecision::Throttled(\"0\") : HTTPRetryDecision::Failure();","+\t});","+\tREQUIRE(quota->Available() == before_failure - 2 * HTTPRetryQuota::RETRY_COST);","+\tfailed.Run([&]() { return HTTPRetryDecision::Success(); });","+\tREQUIRE(quota->Available() == before_failure - 2 * HTTPRetryQuota::RETRY_COST + HTTPRetryQuota::NO_RETRY_REFUND);","+","+\t// throttles charged to another host are refunded to that host","+\tauto other_quota = make_shared_ptr<HTTPRetryQuota>();","+\tHTTPRetryBudget redirected(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tredirected.BindQuota(other_quota);","+\tattempts = 0;","+\tredirected.Run([&]() {","+\t\tattempts++;","+\t\tif (attempts == 2) {","+\t\t\tredirected.BindQuota(quota);","+\t\t}","+\t\treturn attempts <= 2 ? HTTPRetryDecision::Throttled(\"0\") : HTTPRetryDecision::Finish();","+\t});","+\tredirected.ReportSuccess();","+\tREQUIRE(other_quota->Available() == HTTPRetryQuota::INITIAL_CAPACITY);","+}","+"," TEST_CASE(\"HTTP retry budget charges the host of the request being retried\", \"[http]\") {"," \tHTTPUtil http_util;"," \tHTTPParams params(http_util);"],"additions":89,"deletions":0,"truncated":false},{"path":"test/configs/verify_statement_explain_sql.json","lines":["@@ -4,6 +4,12 @@","   \"on_new_connection\": \"SET debug_verify_statement='explain_sql';\",","   \"skip_compiled\": true,","   \"skip_tests\": [","+    {","+      \"reason\": \"The generated SQL changes the query pipelines whose tasks the fixture counts\",","+      \"paths\": [","+        \"test/sql/json/table/json_table_in_out_threads.test\"","+      ]","+    },","     {","       \"reason\": \"A second binding pass adds transaction or file-operation log events\",","       \"paths\": ["],"additions":6,"deletions":0,"truncated":false},{"path":"test/sql/json/issues/ndjson_parallel_bom.test","lines":["@@ -0,0 +1,92 @@","+# name: test/sql/json/issues/ndjson_parallel_bom.test","+# description: A newline-delimited file with a UTF-8 BOM read in parallel parts (duckdblabs/bot-issue-tracker#586)","+# group: [issues]","+","+require json","+","+# a BOM, then 5000 lines of about 4 KB, more than a buffer of 16 MiB holds, so lines cross from one part to the next","+statement ok","+COPY (","+\tSELECT CASE WHEN i = 0 THEN from_hex('EFBBBF') ELSE ''::BLOB END","+\t       || encode(to_json({'a': i, 's': repeat('x', 4096)})::VARCHAR || chr(10))","+\tFROM range(5000) t(i) ORDER BY i","+) TO '{TEST_DIR}/bom_parts.jsonl' (FORMAT BLOB);","+","+statement ok","+COPY (SELECT content FROM read_blob('{TEST_DIR}/bom_parts.jsonl')) TO '{TEST_DIR}/bom_parts.jsonl.gz' (FORMAT BLOB, COMPRESSION 'gzip');","+","+statement ok","+SET threads = 4;","+","+query IIII","+SELECT count(*), count(DISTINCT a), sum(a), sum(length(s))","+FROM read_ndjson('{TEST_DIR}/bom_parts.jsonl', columns = {a: 'INTEGER', s: 'VARCHAR'});","+----","+5000\t5000\t12497500\t20480000","+","+query II","+SELECT count(*), sum(a) FROM read_json('{TEST_DIR}/bom_parts.jsonl', format = 'newline_delimited', columns = {a: 'INTEGER', s: 'VARCHAR'});","+----","+5000\t12497500","+","+query I","+SELECT count(*) FROM read_json_objects('{TEST_DIR}/bom_parts.jsonl', format = 'newline_delimited');","+----","+5000","+","+# a compressed file, which is read in parts without seeking","+query IIII","+SELECT count(*), count(DISTINCT a), sum(a), sum(length(s))","+FROM read_ndjson('{TEST_DIR}/bom_parts.jsonl.gz', columns = {a: 'INTEGER', s: 'VARCHAR'});","+----","+5000\t5000\t12497500\t20480000","+","+# a small file, read in one part","+statement ok","+COPY (SELECT from_hex('EFBBBF') || encode('{\"a\":1}' || chr(10) || '{\"a\":2}' || chr(10))) TO '{TEST_DIR}/bom_small.jsonl' (FORMAT BLOB);","+","+query II","+SELECT count(*), sum(a) FROM read_ndjson('{TEST_DIR}/bom_small.jsonl');","+----","+2\t3","+","+statement ok","+SET threads = 1;","+","+query II","+SELECT count(*), sum(a) FROM read_ndjson('{TEST_DIR}/bom_parts.jsonl', columns = {a: 'INTEGER', s: 'VARCHAR'});","+----","+5000\t12497500","+","+# a file that is only a BOM, or a BOM and a newline","+statement ok","+SET threads = 4;","+","+statement ok","+COPY (SELECT from_hex('EFBBBF')) TO '{TEST_DIR}/only_bom.jsonl' (FORMAT BLOB);","+","+statement ok","+COPY (SELECT from_hex('EFBBBF0A')) TO '{TEST_DIR}/bom_newline.jsonl' (FORMAT BLOB);","+","+query II","+SELECT (SELECT count(*) FROM read_ndjson('{TEST_DIR}/only_bom.jsonl', columns = {a: 'INTEGER'})), (SELECT count(*) FROM read_ndjson('{TEST_DIR}/bom_newline.jsonl', columns = {a: 'INTEGER'}));","+----","+0\t0","+","+# a value of one byte without a newline after it, with and without a BOM, plain and compressed","+statement ok","+COPY (SELECT from_hex('EFBBBF31')) TO '{TEST_DIR}/bom_one_byte.jsonl' (FORMAT BLOB);","+","+statement ok","+COPY (SELECT from_hex('EFBBBF31')) TO '{TEST_DIR}/bom_one_byte.jsonl.gz' (FORMAT BLOB, COMPRESSION 'gzip');","+","+statement ok","+COPY (SELECT from_hex('31')) TO '{TEST_DIR}/one_byte.jsonl' (FORMAT BLOB);","+","+query IIII","+SELECT (SELECT list(json) FROM read_json_objects('{TEST_DIR}/bom_one_byte.jsonl', format = 'newline_delimited')),","+\t(SELECT list(json) FROM read_json_objects('{TEST_DIR}/bom_one_byte.jsonl.gz', format = 'newline_delimited')),","+\t(SELECT list(json) FROM read_json_objects('{TEST_DIR}/one_byte.jsonl', format = 'newline_delimited')),","+\t(SELECT list(a) FROM read_ndjson('{TEST_DIR}/bom_one_byte.jsonl', records = false, columns = {a: 'INTEGER'}));","+----","+[1]\t[1]\t[1]\t[1]"],"additions":92,"deletions":0,"truncated":false},{"path":"test/sql/json/table/json_table_in_out_threads.test","lines":["@@ -0,0 +1,98 @@","+# name: test/sql/json/table/json_table_in_out_threads.test","+# description: json_each and json_tree called per input row schedule as many pipeline tasks as unnest (duckdblabs/bot-issue-tracker#651)","+# group: [table]","+","+require json","+","+# the logs of a restarted database start over","+require skip_reload","+","+statement ok","+SET threads = 4;","+","+# plan unnest with the same delim join as the JSON functions","+statement ok","+SET disabled_optimizers = 'unnest_rewriter';","+","+statement ok","+CREATE TABLE j AS SELECT json_object('a', i, 'b', [i, i + 1]) AS doc FROM range(10000) t(i);","+","+statement ok","+CALL enable_logging('QueryLog');","+","+# every pipeline task allocates a logging context, so the context ids between two probes grow with the tasks of the first","+statement ok","+CREATE VIEW probe_spans AS","+SELECT probe, lead(first_context) OVER (ORDER BY first_context) - first_context AS span","+FROM (","+    SELECT split_part(message, ' ', 4) AS probe, min(context_id) AS first_context","+    FROM duckdb_logs()","+    WHERE type = 'QueryLog' AND starts_with(message, 'SELECT count(*) AS probe_')","+    GROUP BY probe","+);","+","+statement ok","+SELECT count(*) AS probe_unnest FROM j, LATERAL unnest([j.doc]) r(x);","+","+statement ok","+SELECT count(*) AS probe_json_each FROM j, LATERAL json_each(j.doc);","+","+statement ok","+SELECT count(*) AS probe_json_tree FROM j, LATERAL json_tree(j.doc);"],"additions":41,"deletions":0,"truncated":false}],"additions":465,"deletions":12,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-10-29T15:21:14.233136+00:00"}