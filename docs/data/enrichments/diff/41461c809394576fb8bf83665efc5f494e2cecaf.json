eded, refund the last admitted retry to the quota it was charged to, or NO_RETRY_REFUND to the","-\t//! bound quota. Settles once; a later report of the same operation changes nothing. Coordinator-owned budgets only.","+\t//! operation succeeded, refund the last admitted retry and the throttled retries before it to the quotas they were","+\t//! charged to, or NO_RETRY_REFUND to the bound quota. Settles once; a later report of the same operation changes","+\t//! nothing. Coordinator-owned budgets only."," \tDUCKDB_API void ReportSuccess();"," \t//! The coordinator's final word: the operation failed, the last admitted retry is not refunded. Coordinator-owned"," \t//! budgets only.","@@ -188,7 +195,7 @@ class HTTPRetryBudget {"," \tvoid Settle(bool success);"," \t//! Explicit decisions and reports belong to a coordinator-owned budget; anything else is a programming error."," \tvoid RequireCoordinator(const char *what) const;","-\t//! Forget the last admitted retry, so that nothing is refunded for it.","+\t//! Forget the last admitted retry and the throttled retries before it, so that nothing is refunded for them."," \tvoid ForgetLastRetry();"," "," private:","@@ -218,6 +225,10 @@ class HTTPRetryBudget {"," \t//! Quota and tokens of the most recent admitted retry, refunded on success."," \tshared_ptr<HTTPRetryQuota> last_retry_quota;"," \tint64_t last_retry_cost = 0;","+\tbool last_retry_throttled = false;","+\t//! Quotas and tokens of the throttled retries before the most recent one, refunded on success as well, as a host","+\t//! that throttles requests which then get through is not failing","+\tvector<HTTPThrottledRetryCharge> earlier_throttled_retries;"," \tbool quota_exhausted = false;"," \tbool corrections_exhausted = false;"," };"],"additions":14,"deletions":3,"truncated":false},{"path":"src/include/duckdb/storage/metadata/metadata_manager.hpp","lines":["@@ -85,6 +85,10 @@ class MetadataManager {"," "," \tvoid MarkBlocksAsModified();"," \tvoid ClearModifiedBlocks