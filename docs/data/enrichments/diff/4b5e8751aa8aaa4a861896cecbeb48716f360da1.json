{"id":"4b5e8751aa8aaa4a861896cecbeb48716f360da1","axis":"silent","repo":"kestra-io/kestra","sha":"4b5e8751aa8aaa4a861896cecbeb48716f360da1","parsed":{"files":[{"path":"core/src/main/java/io/kestra/core/docs/JsonSchemaCache.java","lines":["@@ -50,6 +50,7 @@ public JsonSchemaCache(final JsonSchemaGenerator jsonSchemaGenerator, final Plug","         registerClassForType(SchemaType.DASHBOARD, Dashboard.class);","     }"," ","+    /** Returns the schema compacted by {@link JsonSchemaCompactor}, so a consumer must resolve {@code $ref}; the same instance until the registry changes. */","     public Map<String, Object> getSchemaForType(final SchemaType type,","         final boolean arrayOf) {","         invalidateIfPluginRegistryChanged();","@@ -58,7 +59,7 @@ public Map<String, Object> getSchemaForType(final SchemaType type,"," ","             Class<?> cls = Optional.ofNullable(classesBySchemaType.get(type))","                 .orElseThrow(() -> new IllegalArgumentException(\"Cannot found schema for type '\" + type + \"'\"));","-            return jsonSchemaGenerator.schemas(cls, arrayOf);","+            return JsonSchemaCompactor.compact(jsonSchemaGenerator.schemas(cls, arrayOf));","         });","     }"," "],"additions":2,"deletions":1,"truncated":false},{"path":"core/src/main/java/io/kestra/core/docs/JsonSchemaCompactor.java","lines":["@@ -0,0 +1,255 @@","+package io.kestra.core.docs;","+","+import java.util.Collections;","+import java.util.HashMap;","+import java.util.HashSet;","+import java.util.IdentityHashMap;","+import java.util.LinkedHashMap;","+import java.util.List;","+import java.util.Map;","+import java.util.Set;","+import java.util.function.BiPredicate;","+import java.util.function.Consumer;","+","+import com.fasterxml.jackson.core.type.TypeReference;","+import com.fasterxml.jackson.databind.JsonNode;","+import com.fasterxml.jackson.databind.ObjectMapper;","+import com.fasterxml.jackson.databind.node.ArrayNode;","+import com.fasterxml.jackson.databind.node.ObjectNode;","+import com.fasterxml.jackson.databind.node.TextNode;","+","+import io.kestra.core.serializers.JacksonMapper;","+","+/** Replaces repeated subtrees with a {@code $ref} to one {@code shared-*} definition, which the UI's {@code inflateCompactSchema} undoes. */","+public final class JsonSchemaCompactor {","+    private static final ObjectMapper MAPPER = JacksonMapper.ofJson();","+    private static final TypeReference<Map<String, Object>> MAP_TYPE = new TypeReference<>() {","+    };","+    private static final String DEFINITIONS_REF = \"#/definitions/\";","+    private static final String SHARED_KEY_PREFIX = \"shared-property-\";","+    private static final String SHARED_SUBTYPES_KEY = \"shared-subtypes\";","+    // Below this serialized size, the $ref and its definition key cost about as much as the copy they replace.","+    private static final int MIN_SHARED_LENGTH = 128;","+","+    private JsonSchemaCompactor() {","+    }","+","+    /** Returns a compacted copy of {@code schema}: examples dropped, subtype lists hoisted, then repeated property schemas shared. */","+    public static Map<String, Object> compact(Map<String, Object> schema) {","+        ObjectNode root = MAPPER.convertValue(schema, ObjectNode.class);","+        dropExamples(root);","+        hoistSubtypeLists(root);","+        sharePropertySchemas(root);","+        return MAPPER.convertValue(root, MAP_TYPE);","+    }","+","+    /** Safe to run again on a schema that gained definitions since, as a property already behind a {@code $ref} is left alone. */","+    public static void sharePropertySchemas(ObjectNode schema) {","+        if (!(schema.get(\"definitions\") instanceof ObjectNode definitions)) {","+            return;","+        }","+","+        Map<String, String> refByContent = new HashMap<>();","+        Set<String> usedKeys = new HashSet<>();","+        definitions.fieldNames().forEachRemaining(usedKeys::add);","+","+        // Sharing a schema leaves a single copy of whatever it contains, so occurrences are counted again until nothing repeats.","+        Map<String, ObjectNode> added;","+        do {","+            Map<String, Integer> occurrences = new HashMap<>();","+            walkProperties(schema, (name, property) ->","+            {","+                occurrences.merge(property.toString(), 1, Integer::sum);","+                return true;","+            });","+","+            added = new LinkedHashMap<>();","+            Map<String, ObjectNode> newDefinitions = added;","+            walkProperties(schema, (name, property) ->","+            {","+                String content = property.toString();","+                if (content.length() < MIN_SHARED_LENGTH || (occurrences.get(content) < 2 && !refByContent.containsKey(content))) {","+                    return true;","+                }","+                String ref = refByContent.computeIfAbsent(content, ignored ->","+                {","+                    String key = uniqueKey(SHARED_KEY_PREFIX + name, usedKeys);","+                    newDefinitions.put(key, property.deepCopy());","+                    return DEFINITIONS_REF + key;","+                });","+                property.removeAll().put(\"$ref\", ref);","+                return false;","+            });","+            definitions.setAll(added);","+        } while (!added.isEmpty());","+    }","+","+    private static void hoistSubtypeLists(ObjectNode schema) {","+        if (!(schema.get(\"definitions\") instanceof ObjectNode definitions)) {","+            return;","+        }","+","+        Map<JsonNode, String> holderBySubtypes = new HashMap<>();","+        Set<JsonNode> hoisted = Collections.newSetFromMap(new IdentityHashMap<>());","+        definitions.properties().forEach(entry ->","+        {","+            if (SubtypeSite.of(entry.getValue()) instanceof SubtypeSite site && site.annotation() == null","+                && holderBySubtypes.putIfAbsent(site.subtypes(), DEFINITIONS_REF + entry.getKey()) == null) {","+                hoisted.add(entry.getValue());","+            }","+        });","+","+        Map<JsonNode, Integer> occurrences = new LinkedHashMap<>();","+        countSubtypeLists(schema, hoisted, occurrences);","+        Set<String> usedKeys = new HashSet<>();","+        definitions.fieldNames().forEachRemaining(usedKeys::add);","+        Map<JsonNode, String> refBySubtypes = new HashMap<>();","+        Map<String, ObjectNode> added = new LinkedHashMap<>();","+        occurrences.forEach((subtypes, count) ->","+        {","+            // A site never references a holding definition directly: other properties do, and a shared-* key is what marks a hoisted list.","+            if (holderBySubtypes.get(subtypes) instanceof String holder) {","+                String key = uniqueKey(SHARED_SUBTYPES_KEY, usedKeys);","+                added.put(key, MAPPER.createObjectNode().put(\"$ref\", holder));","+                refBySubtypes.put(subtypes, DEFINITIONS_REF + key);","+            } else if (count >= 2 && subtypes.toString().length() >= MIN_SHARED_LENGTH) {","+                String key = uniqueKey(SHARED_SUBTYPES_KEY, usedKeys);","+                added.put(key, MAPPER.createObjectNode().set(\"anyOf\", subtypes));","+                refBySubtypes.put(subtypes, DEFINITIONS_REF + key);","+            }","+        });","+","+        if (!refBySubtypes.isEmpty()) {","+            replaceSubtypeLists(schema, refBySubtypes, hoisted);","+            definitions.setAll(added);","+        }","+    }","+","+    private static void countSubtypeLists(JsonNode node, Set<JsonNode> hoisted, Map<JsonNode, Integer> occurrences) {","+        if (hoisted.contains(node)) {","+            return;","+        }","+        if (SubtypeSite.of(node) instanceof SubtypeSite site) {","+            occurrences.merge(site.subtypes(), 1, Integer::sum);","+            return;","+        }","+        node.forEach(child -> countSubtypeLists(child, hoisted, occurrences));","+    }","+","+    private static void replaceSubtypeLists(JsonNode node, Map<JsonNode, String> refBySubtypes, Set<JsonNode> hoisted) {","+        if (hoisted.contains(node)) {","+            return;","+        }","+        if (SubtypeSite.of(node) instanceof SubtypeSite site) {","+            if (refBySubtypes.get(site.subtypes()) instanceof String ref) {","+                ObjectNode replaced = ((ObjectNode) node).removeAll();","+                if (site.annotation() == null || site.annotation().isEmpty()) {","+                    replaced.put(\"$ref\", ref);","+                } else {","+                    // Kept as a one-branch anyOf beside the annotation: the language service then completes the key and hovers it as before.","+                    replaced.setAll(site.annotation());","+                    replaced.putArray(\"anyOf\").addObject().put(\"$ref\", ref);","+                }","+            }","+            return;","+        }","+        node.forEach(child -> replaceSubtypeLists(child, refBySubtypes, hoisted));","+    }","+","+    /** One branch per subtype, either a bare {@code $ref} or the generator's {@code allOf: [$ref, annotation]} for a single-subtype property. */","+    private record SubtypeSite(ArrayNode subtypes, ObjectNode annotation) {","+        static SubtypeSite of(JsonNode node) {","+            if (!(node instanceof ObjectNode object) || object.size() != 1 || !(object.get(\"anyOf\") instanceof ArrayNode anyOf) || anyOf.isEmpty()) {","+                return null;","+            }","+            if (isBareRef(anyOf.get(0))) {","+                for (JsonNode branch : anyOf) {","+                    if (!isBareRef(branch)) {","+                        return null;","+                    }","+                }","+                return new SubtypeSite(anyOf, null);","+            }","+","+            if (!(anyOf.get(0).path(\"allOf\").path(1) instanceof ObjectNode annotation) || annotation.has(\"anyOf\") || annotation.has(\"$ref\")) {","+                return null;","+            }","+            ArrayNode subtypes = MAPPER.createArrayNode();","+            for (JsonNode branch : anyOf) {","+                if (branch.size() != 1 || !(branch.get(\"allOf\") instanceof ArrayNode allOf) || allOf.size() != 2","+                    || !isBareRef(allOf.get(0)) || !allOf.get(1).equals(annotation)) {","+                    return null;","+                }","+                subtypes.add(allOf.get(0));","+            }","+            return new SubtypeSite(subtypes, annotation);","+        }","+","+        private static boolean isBareRef(JsonNode node) {","+            return node.size() == 1 && node.path(\"$ref\").isTextual();","+        }","+    }","+","+    public static String withoutExamples(String markdown) {","+        int heading = markdown.indexOf(JsonSchemaGenerator.EXAMPLES_HEADING);","+        return heading < 0 ? markdown : markdown.substring(0, heading).stripTrailing();","+    }","+","+    private static void dropExamples(JsonNode schema) {","+        if (!(schema instanceof ObjectNode object)) {","+            return;","+        }","+        if (object.get(\"markdownDescription\") instanceof TextNode description) {","+            String trimmed = withoutExamples(description.asText());","+            if (trimmed.isEmpty()) {","+                object.remove(\"markdownDescription\");","+            } else {","+                object.put(\"markdownDescription\", trimmed);","+            }","+        }","+        if (object.get(\"properties\") instanceof ObjectNode properties) {","+            properties.forEach(JsonSchemaCompactor::dropExamples);","+        }","+        forEachSubschema(object, JsonSchemaCompactor::dropExamples);","+    }","+","+    private static void walkProperties(JsonNode schema, BiPredicate<String, ObjectNode> shouldDescend) {","+        if (!(schema instanceof ObjectNode object)) {","+            return;","+        }","+        if (object.get(\"properties\") instanceof ObjectNode properties) {","+            properties.properties().forEach(entry ->","+            {","+                if (!(entry.getValue() instanceof ObjectNode property) || shouldDescend.test(entry.getKey(), property)) {","+                    walkProperties(entry.getValue(), shouldDescend);","+                }","+            });","+        }","+        forEachSubschema(object, subschema -> walkProperties(subschema, shouldDescend));","+    }","+","+    // Follows schema keywords only: a literal under `default`, `const` or `enum` may hold keys that look like schema keywords.","+    private static void forEachSubschema(ObjectNode schema, Consumer<JsonNode> action) {","+        if (schema.get(\"definitions\") instanceof ObjectNode definitions) {","+            definitions.forEach(action);","+        }","+        for (String keyword : List.of(\"items\", \"additionalProperties\", \"not\")) {","+            if (schema.get(keyword) instanceof ObjectNode subschema) {","+                action.accept(subschema);","+            }","+        }","+        for (String keyword : List.of(\"anyOf\", \"allOf\", \"oneOf\")) {","+            if (schema.get(keyword) instanceof ArrayNode branches) {","+                branches.forEach(action);","+            }","+        }","+    }","+","+    private static String uniqueKey(String base, Set<String> usedKeys) {","+        String key = base;","+        for (int suffix = 2; !usedKeys.add(key); suffix++) {","+            key = base + \"-\" + suffix;","+        }","+        return key;","+    }","+}"],"additions":255,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/docs/JsonSchemaGenerator.java","lines":["@@ -103,6 +103,8 @@ public class JsonSchemaGenerator {","         .mapToObj(i -> escapeRegex(PebbleUtil.openingBlockDelimiters().get(i)) + \".*\" + escapeRegex(PebbleUtil.closingBlockDelimiters().get(i)))","         .collect(Collectors.joining(\"|\", \".*(\", \").*\"));"," ","+    static final String EXAMPLES_HEADING = \"##### Examples\\n\";","+","     private final PluginRegistry pluginRegistry;"," ","     @Inject","@@ -1094,7 +1096,7 @@ public CustomDefinition provideCustomSchemaDefinition(ResolvedType javaType, Sch"," ","                     String description = collectedTypeAttributes.has(\"markdownDescription\") ? collectedTypeAttributes.get(\"markdownDescription\").asText() : \"\";"," ","-                    description += \"##### Examples\\n\" + doc;","+                    description += EXAMPLES_HEADING + doc;"," ","                     collectedTypeAttributes.set(\"markdownDescription\", new TextNode(description));"," "],"additions":3,"deletions":1,"truncated":false},{"path":"core/src/main/java/io/kestra/core/plugins/PluginSchemaBundleMerger.java","lines":["@@ -12,6 +12,7 @@"," import com.fasterxml.jackson.databind.node.JsonNodeFactory;"," import com.fasterxml.jackson.databind.node.ObjectNode;"," ","+import io.kestra.core.docs.JsonSchemaCompactor;"," import io.kestra.core.docs.SchemaType;"," "," import jakarta.annotation.Nullable;","@@ -183,7 +184,8 @@ private static ObjectNode lightweightDefinition(String fqcn, @Nullable ObjectNod","         }"," ","         JsonNode doc = definition.get(\"markdownDescription\");","-        definition.put(\"markdownDescription\", doc != null && doc.isTextual() ? doc.asText() + \"\\n\\n\" + STUB_NOTE : STUB_NOTE);","+        String description = doc != null && doc.isTextual() ? JsonSchemaCompactor.withoutExamples(doc.asText()) : \"\";","+        definition.put(\"markdownDescription\", description.isEmpty() ? STUB_NOTE : description + \"\\n\\n\" + STUB_NOTE);","         return definition;","     }"," "],"additions":3,"deletions":1,"truncated":false},{"path":"core/src/main/java/io/kestra/core/plugins/PluginSchemaBundleService.java","lines":["@@ -25,7 +25,10 @@"," import com.fasterxml.jackson.databind.ObjectMapper;"," import com.fasterxml.jackson.databind.node.JsonNodeFactory;"," import com.fasterxml.jackson.databind.node.ObjectNode;","+import com.github.benmanes.caffeine.cache.Cache;","+import com.github.benmanes.caffeine.cache.Caffeine;"," ","+import io.kestra.core.docs.JsonSchemaCompactor;"," import io.kestra.core.docs.SchemaType;"," import io.kestra.core.plugins.PluginCatalogService.PluginManifest;"," import io.kestra.core.serializers.JacksonMapper;","@@ -65,6 +68,9 @@ public class PluginSchemaBundleService {"," ","     private final String resolvedBundleUrl;"," ","+    // Weak keys compare by identity, so a schema regenerated after a plugin change gets a fresh merge and the old one is collected.","+    private final Cache<Map<String, Object>, Map<String, Object>> mergedSchemas = Caffeine.newBuilder().weakKeys().build();","+","     private volatile Bundle bundle;","     private volatile Instant lastFailureAt;"," ","@@ -175,7 +181,8 @@ public Optional<PluginArtifact> fileRendererArtifact(final String extension) {","      * Returns a copy of {@code localSchema} enriched with a lightweight definition and a","      * {@code $ref} branch for every catalog subtype not installed locally — see","      * {@link PluginSchemaBundleMerger}. When the service is disabled or no bundle could be loaded,","-     * the original {@code localSchema} is returned unchanged.","+     * the original {@code localSchema} is returned unchanged. The merge is cached per","+     * {@code localSchema} instance, so callers must treat the result as read-only.","      *","      * @param type the schema type to look up in the bundle","      * @param localSchema the locally-generated schema (not modified)","@@ -191,9 +198,14 @@ public Map<String, Object> mergeWithBundle(SchemaType type, Map<String, Object>","             return localSchema;","         }"," ","-        ObjectNode mutable = MAPPER.convertValue(localSchema, ObjectNode.class);","-        PluginSchemaBundleMerger.mergeLightweightSubtypes(mutable, loaded.definitions(), loaded.roots());","-        return MAPPER.convertValue(mutable, MAP_TYPE);","+        return mergedSchemas.get(localSchema, local ->","+        {","+            ObjectNode mutable = MAPPER.convertValue(local, ObjectNode.class);","+            PluginSchemaBundleMerger.mergeLightweightSubtypes(mutable, loaded.definitions(), loaded.roots());","+            // The stubs repeat the documentation of every inherited property, once per catalog type.","+            JsonSchemaCompactor.sharePropertySchemas(mutable);","+            return MAPPER.convertValue(mutable, MAP_TYPE);","+        });","     }"," ","     // The bundle is immutable per release: load it once on first use, keep it forever. On failure"],"additions":16,"deletions":4,"truncated":false},{"path":"core/src/test/java/io/kestra/core/docs/JsonSchemaCompactorTest.java","lines":["@@ -0,0 +1,158 @@","+package io.kestra.core.docs;","+","+import java.util.List;","+import java.util.Map;","+","+import org.junit.jupiter.api.Test;","+","+import io.kestra.core.serializers.JacksonMapper;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+class JsonSchemaCompactorTest {","+    private static final String LONG_DOC = \"x\".repeat(200);","+","+    @Test","+    @SuppressWarnings(\"unchecked\")","+    void shouldShareOnlyRepeatedPropertySchemasWhenCompacting() throws Exception {","+        // `retry` repeats, `timeout` shares a name but not a schema, `id` is too small to be worth a $ref","+        Map<String, Object> schema = JacksonMapper.ofJson().readValue(\"\"\"","+            {","+              \"definitions\": {","+                \"a.First\": {\"properties\": {","+                  \"id\": {\"type\": \"string\"},","+                  \"retry\": {\"type\": \"object\", \"title\": \"%1$s\"},","+                  \"timeout\": {\"type\": \"string\", \"title\": \"%1$s\"}","+                }},","+                \"a.Second\": {\"properties\": {","+                  \"id\": {\"type\": \"string\"},","+                  \"retry\": {\"type\": \"object\", \"title\": \"%1$s\"},","+                  \"timeout\": {\"type\": \"integer\", \"title\": \"%1$s\"}","+                }}","+              }","+            }","+            \"\"\".formatted(LONG_DOC), Map.class);","+","+        Map<String, Object> compact = JsonSchemaCompactor.compact(schema);","+","+        Map<String, Object> definitions = (Map<String, Object>) compact.get(\"definitions\");","+        assertThat(definitions).containsOnlyKeys(\"a.First\", \"a.Second\", \"shared-property-retry\");","+        assertThat(definitions.get(\"shared-property-retry\")).isEqualTo(Map.of(\"type\", \"object\", \"title\", LONG_DOC));","+        for (String key : new String[] { \"a.First\", \"a.Second\" }) {","+            Map<String, Object> properties = (Map<String, Object>) ((Map<String, Object>) definitions.get(key)).get(\"properties\");","+            assertThat(properties.get(\"retry\")).isEqualTo(Map.of(\"$ref\", \"#/definitions/shared-property-retry\"));","+            assertThat(properties.get(\"id\")).isEqualTo(Map.of(\"type\", \"string\"));","+            assertThat((Map<String, Object>) properties.get(\"timeout\")).containsKey(\"title\");","+        }","+    }","+","+    @Test","+    @SuppressWarnings(\"unchecked\")","+    void shouldReferenceOneSubtypeListWhenSitesRepeatItBareOrPerBranchAnnotated() throws Exception {","+        // no definition holds the list, `single` repeats its annotation on every branch, `mixed` does not","+        Map<String, Object> schema = JacksonMapper.ofJson().readValue(\"\"\"","+            {","+              \"definitions\": {","+                \"a.Flow\": {\"properties\": {","+                  \"tasks\": {\"type\": \"array\", \"items\": {\"anyOf\": [{\"$ref\": \"#/definitions/%1$s.First\"}, {\"$ref\": \"#/definitions/%1$s.Second\"}]}},","+                  \"errors\": {\"type\": \"array\", \"items\": {\"anyOf\": [{\"$ref\": \"#/definitions/%1$s.First\"}, {\"$ref\": \"#/definitions/%1$s.Second\"}]}},","+                  \"single\": {\"anyOf\": [","+                    {\"allOf\": [{\"$ref\": \"#/definitions/%1$s.First\"}, {\"title\": \"One task\"}]},","+                    {\"allOf\": [{\"$ref\": \"#/definitions/%1$s.Second\"}, {\"title\": \"One task\"}]}","+                  ]},","+                  \"mixed\": {\"anyOf\": [","+                    {\"allOf\": [{\"$ref\": \"#/definitions/%1$s.First\"}, {\"title\": \"One task\"}]},","+                    {\"allOf\": [{\"$ref\": \"#/definitions/%1$s.Second\"}, {\"title\": \"Another task\"}]}","+                  ]}","+                }}","+              }","+            }","+            \"\"\".formatted(\"x\".repeat(80)), Map.class);","+","+        Map<String, Object> compact = JsonSchemaCompactor.compact(schema);","+","+        Map<String, Object> definitions = (Map<String, Object>) compact.get(\"definitions\");","+        Map<String, Object> ref = Map.of(\"$ref\", \"#/definitions/shared-subtypes\");","+        Map<String, Map<String, Object>> properties = (Map<String, Map<String, Object>>) ((Map<String, Object>) definitions.get(\"a.Flow\")).get(\"properties\");","+        assertThat((Map<String, Object>) definitions.get(\"shared-subtypes\")).containsOnlyKeys(\"anyOf\");","+        assertThat(((Map<String, List<Object>>) definitions.get(\"shared-subtypes\")).get(\"anyOf\")).hasSize(2);","+        assertThat(properties.get(\"tasks\").get(\"items\")).isEqualTo(ref);","+        assertThat(properties.get(\"errors\").get(\"items\")).isEqualTo(ref);","+        assertThat(properties.get(\"single\")).isEqualTo(Map.of(\"title\", \"One task\", \"anyOf\", List.of(ref)));","+        assertThat(properties.get(\"mixed\")).containsOnlyKeys(\"anyOf\");","+    }","+","+    @Test","+    @SuppressWarnings(\"unchecked\")","+    void shouldAliasTheDefinitionHoldingASubtypeListAndLeaveDirectReferencesToItAlone() throws Exception {","+        // `a.Task` holds the list `tasks` repeats, and `cases` references that definition itself","+        Map<String, Object> schema = JacksonMapper.ofJson().readValue(\"\"\"","+            {","+              \"definitions\": {","+                \"a.Task\": {\"anyOf\": [{\"$ref\": \"#/definitions/a.First\"}, {\"$ref\": \"#/definitions/a.Second\"}]},","+                \"a.Flow\": {\"properties\": {","+                  \"tasks\": {\"type\": \"array\", \"items\": {\"anyOf\": [{\"$ref\": \"#/definitions/a.First\"}, {\"$ref\": \"#/definitions/a.Second\"}]}},","+                  \"cases\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/definitions/a.Task\"}}","+                }}","+              }","+            }","+            \"\"\", Map.class);","+","+        Map<String, Object> compact = JsonSchemaCompactor.compact(schema);","+","+        // Only a shared-* key marks a list the compactor moved, so a direct reference must stay one.","+        Map<String, Object> definitions = (Map<String, Object>) compact.get(\"definitions\");","+        Map<String, Map<String, Object>> properties = (Map<String, Map<String, Object>>) ((Map<String, Object>) definitions.get(\"a.Flow\")).get(\"properties\");","+        assertThat(definitions.get(\"shared-subtypes\")).isEqualTo(Map.of(\"$ref\", \"#/definitions/a.Task\"));","+        assertThat((Map<String, Object>) definitions.get(\"a.Task\")).containsOnlyKeys(\"anyOf\");","+        assertThat(properties.get(\"tasks\").get(\"items\")).isEqualTo(Map.of(\"$ref\", \"#/definitions/shared-subtypes\"));","+        assertThat(properties.get(\"cases\").get(\"items\")).isEqualTo(Map.of(\"$ref\", \"#/definitions/a.Task\"));","+    }","+","+    @Test","+    void shouldKeepTheHintsTheNoCodeEditorsRead() throws Exception {","+        Map<String, Object> schema = JacksonMapper.ofJson().readValue(\"\"\"","+            {\"definitions\": {\"a.Task\": {\"properties\": {\"level\": {\"type\": \"string\", \"$dynamic\": true, \"$group\": \"main\"}}}}}","+            \"\"\", Map.class);","+","+        assertThat(JsonSchemaCompactor.compact(schema)).isEqualTo(schema);","+    }","+","+    @Test","+    @SuppressWarnings(\"unchecked\")","+    void shouldDropTheExamplesSectionButKeepTheDescriptionBeforeIt() throws Exception {","+        // one description with prose before its examples, one made of examples only","+        Map<String, Object> schema = JacksonMapper.ofJson().readValue(\"\"\"","+            {","+              \"definitions\": {","+                \"a.Log\": {\"type\": \"object\", \"markdownDescription\": \"Emit a log.##### Examples\\\\n```yaml\\\\nid: x\\\\n```\"},","+                \"a.Bare\": {\"type\": \"object\", \"title\": \"Bare\", \"markdownDescription\": \"##### Examples\\\\n```yaml\\\\nid: y\\\\n```\"}","+              }","+            }","+            \"\"\", Map.class);","+","+        Map<String, Object> compact = JsonSchemaCompactor.compact(schema);","+","+        Map<String, Object> definitions = (Map<String, Object>) compact.get(\"definitions\");","+        assertThat(definitions.get(\"a.Log\")).isEqualTo(Map.of(\"type\", \"object\", \"markdownDescription\", \"Emit a log.\"));","+        assertThat(definitions.get(\"a.Bare\")).isEqualTo(Map.of(\"type\", \"object\", \"title\", \"Bare\"));","+    }","+","+    @Test","+    @SuppressWarnings(\"unchecked\")","+    void shouldLeaveLiteralValuesAloneWhenTheyLookLikeASchema() throws Exception {","+        // two defaults that are data, each holding a `properties` key with a repeated, large value","+        Map<String, Object> schema = JacksonMapper.ofJson().readValue(\"\"\"","+            {","+              \"definitions\": {","+                \"a.First\": {\"properties\": {\"spec\": {\"type\": \"object\", \"default\": {\"properties\": {\"doc\": {\"title\": \"%1$s\"}}}}}},","+                \"a.Second\": {\"properties\": {\"other\": {\"type\": \"string\", \"default\": {\"properties\": {\"doc\": {\"title\": \"%1$s\"}}}}}}","+              }","+            }","+            \"\"\".formatted(LONG_DOC), Map.class);","+","+        Map<String, Object> compact = JsonSchemaCompactor.compact(schema);","+","+        assertThat(compact).isEqualTo(schema);","+    }",