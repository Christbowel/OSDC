{"id":"1691cc0cb1e32b31fecb183b19ab8c9b9161f07f","axis":"silent","repo":"ianstormtaylor/slate","sha":"1691cc0cb1e32b31fecb183b19ab8c9b9161f07f","parsed":{"files":[{"path":".changeset/disposable-location-refs.md","lines":["@@ -0,0 +1,5 @@","+---","+'slate': minor","+---","+","+Support Symbol.dispose on path, point and range refs so using declarations can release tracked locations automatically. TypeScript consumers now need TypeScript 5.2 or later with `esnext.disposable` in `lib`, or `skipLibCheck`."],"additions":5,"deletions":0,"truncated":false},{"path":"docs/api/locations/path-ref.md","lines":["@@ -7,6 +7,7 @@ interface PathRef {","   current: Path | null","   affinity: 'forward' | 'backward' | null","   unref(): Path | null","+  [Symbol.dispose](): void"," }"," ```"," ","@@ -22,6 +23,12 @@ Free the resources used by the PathRef. This should be called when you no longer"," "," This removes the ref from `Editor.pathRefs(editor)` and sets `current` to `null`. If an operation removes the tracked node, the editor releases the ref automatically. Calling `unref()` again returns `null`."," ","+#### `[Symbol.dispose]() => void`","+","+Release the ref by calling `unref()`. This supports `using` declarations in runtimes or build tools with explicit resource management support. Repeated disposal is safe, including after an operation removes the tracked location.","+","+TypeScript consumers need TypeScript 5.2 or later with `esnext.disposable` in their `lib` configuration. If the runtime lacks `Symbol.dispose`, install a polyfill before creating refs to use `using`; the fallback key is `Symbol.for('Symbol.dispose')`. Calling `unref()` continues to work without a polyfill.","+"," ## Static methods"," "," ### Transform methods"],"additions":7,"deletions":0,"truncated":false},{"path":"docs/api/locations/point-ref.md","lines":["@@ -7,6 +7,7 @@ interface PointRef {","   current: Point | null","   affinity: 'forward' | 'backward' | null","   unref(): Point | null","+  [Symbol.dispose](): void"," }"," ```"," ","@@ -23,6 +24,12 @@ It also returns the current value."," "," This removes the ref from `Editor.pointRefs(editor)` and sets `current` to `null`. If an operation removes the node containing the point, the editor releases the ref automatically. Calling `unref()` again returns `null`."," ","+#### `[Symbol.dispose]() => void`","+","+Release the ref by calling `unref()`. This supports `using` declarations in runtimes or build tools with explicit resource management support. Repeated disposal is safe, including after an operation removes the tracked location.","+","+TypeScript consumers need TypeScript 5.2 or later with `esnext.disposable` in their `lib` configuration. If the runtime lacks `Symbol.dispose`, install a polyfill before creating refs to use `using`; the fallback key is `Symbol.for('Symbol.dispose')`. Calling `unref()` continues to work without a polyfill.","+"," ## Static methods"," "," ### Transform methods"],"additions":7,"deletions":0,"truncated":false},{"path":"docs/api/locations/range-ref.md","lines":["@@ -7,6 +7,7 @@ interface RangeRef {","   current: Range | null","   affinity: 'forward' | 'backward' | 'outward' | 'inward' | null","   unref(): Range | null","+  [Symbol.dispose](): void"," }"," ```"," ","@@ -34,6 +35,12 @@ It also returns the current value."," "," This removes the ref from `Editor.rangeRefs(editor)` and sets `current` to `null`. If an operation removes a node containing either endpoint, the editor releases the ref automatically. Calling `unref()` again returns `null`."," ","+#### `[Symbol.dispose]() => void`","+","+Release the ref by calling `unref()`. This supports `using` declarations in runtimes or build tools with explicit resource management support. Repeated disposal is safe, including after an operation removes the tracked location.","+","+TypeScript consumers need TypeScript 5.2 or later with `esnext.disposable` in their `lib` configuration. If the runtime lacks `Symbol.dispose`, install a polyfill before creating refs to use `using`; the fallback key is `Symbol.for('Symbol.dispose')`. Calling `unref()` continues to work without a polyfill.","+"," ## Static methods"," "," ### Transform methods"],"additions":7,"deletions":0,"truncated":false},{"path":"packages/slate/src/editor/path-ref.ts","lines":["@@ -1,4 +1,5 @@"," import { Editor, EditorInterface } from '../interfaces/editor'","+import { getSymbolDispose } from '../utils/symbol-dispose'"," import { PathRef } from '../interfaces/path-ref'"," "," export const pathRef: EditorInterface['pathRef'] = (","@@ -10,6 +11,9 @@ export const pathRef: EditorInterface['pathRef'] = (","   const ref: PathRef = {","     current: path,","     affinity,","+    [getSymbolDispose()]() {","+      ref.unref()","+    },","     unref() {","       const { current } = ref","       const pathRefs = Editor.pathRefs(editor)"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/slate/src/editor/point-ref.ts","lines":["@@ -1,4 +1,5 @@"," import { Editor, EditorInterface } from '../interfaces/editor'","+import { getSymbolDispose } from '../utils/symbol-dispose'"," import { PointRef } from '../interfaces/point-ref'"," "," export const pointRef: EditorInterface['pointRef'] = (","@@ -10,6 +11,9 @@ export const pointRef: EditorInterface['pointRef'] = (","   const ref: PointRef = {","     current: point,","     affinity,","+    [getSymbolDispose()]() {","+      ref.unref()","+    },","     unref() {","       const { current } = ref","       const pointRefs = Editor.pointRefs(editor)"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/slate/src/editor/range-ref.ts","lines":["@@ -1,4 +1,5 @@"," import { Editor, EditorInterface } from '../interfaces/editor'","+import { getSymbolDispose } from '../utils/symbol-dispose'"," import { RangeRef } from '../interfaces/range-ref'"," "," export const rangeRef: EditorInterface['rangeRef'] = (","@@ -10,6 +11,9 @@ export const rangeRef: EditorInterface['rangeRef'] = (","   const ref: RangeRef = {","     current: range,","     affinity,","+    [getSymbolDispose()]() {","+      ref.unref()","+    },","     unref() {","       const { current } = ref","       const rangeRefs = Editor.rangeRefs(editor)"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/slate/src/interfaces/path-ref.ts","lines":["@@ -10,6 +10,7 @@ export interface PathRef {","   current: Path | null","   affinity: 'forward' | 'backward' | null","   unref(): Path | null","+  [Symbol.dispose](): void"," }"," "," export interface PathRefInterface {"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/slate/src/interfaces/point-ref.ts","lines":["@@ -11,6 +11,7 @@ export interface PointRef {","   current: Point | null","   affinity: TextDirection | null","   unref(): Point | null","+  [Symbol.dispose](): void"," }"," "," export interface PointRefInterface {"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/slate/src/interfaces/range-ref.ts","lines":["@@ -10,6 +10,7 @@ export interface RangeRef {","   current: Range | null","   affinity: 'forward' | 'backward' | 'outward' | 'inward' | null","   unref(): Range | null","+  [Symbol.dispose](): void"," }"," "," export interface RangeRefInterface {"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/slate/src/utils/symbol-dispose.ts","lines":["@@ -0,0 +1,2 @@","+export const getSymbolDispose = (): typeof Symbol.dispose =>","+  Symbol.dispose ?? (Symbol.for('Symbol.dispose') as typeof Symbol.dispose)"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/slate/test/interfaces/Editor/disposable-refs.spec.ts","lines":["@@ -0,0 +1,99 @@","+import assert from 'assert'","+import { readFileSync } from 'fs'","+import { runInNewContext } from 'vm'","+import { createEditor, Editor, Transforms } from 'slate'","+","+describe('disposable location refs', () => {","+  for (const kind of ['path', 'point', 'range'] as const) {","+    const makeRef = (editor: Editor) => {","+      const point = { path: [0, 0], offset: 1 }","+      return kind === 'path'","+        ? Editor.pathRef(editor, point.path)","+        : kind === 'point'","+        ? Editor.pointRef(editor, point)","+        : Editor.rangeRef(editor, { anchor: point, focus: point })","+    }","+    const refs = (editor: Editor) =>","+      kind === 'path'","+        ? Editor.pathRefs(editor)","+        : kind === 'point'","+        ? Editor.pointRefs(editor)","+        : Editor.rangeRefs(editor)","+","+    it(`disposes a tracked ${kind} ref and leaves other refs active`, () => {","+      const editor = createEditor()","+      editor.children = [{ children: [{ text: 'text' }] }]","+      const ref = makeRef(editor)","+      const other = makeRef(editor)","+      Transforms.insertNodes(","+        editor,","+        { children: [{ text: 'before' }] },","+        { at: [0] }","+      )","+      assert.strictEqual(refs(editor).size, 2)","+      assert.strictEqual(ref[Symbol.dispose](), undefined)","+      assert.strictEqual(ref.current, null)","+      assert.strictEqual(refs(editor).size, 1)","+      ref[Symbol.dispose]()","+      assert.strictEqual(ref.unref(), null)","+      other.unref()","+      assert.strictEqual(refs(editor).size, 0)","+    })","+","+    it(`allows disposal after explicit and automatic ${kind} release`, () => {","+      const editor = createEditor()","+      editor.children = [{ children: [{ text: 'text' }] }]","+      const manual = makeRef(editor)","+      const removed = makeRef(editor)","+      assert.notStrictEqual(manual.unref(), null)","+      manual[Symbol.dispose]()","+      Transforms.removeNodes(editor, { at: [0] })","+      assert.strictEqual(removed.current, null)","+      removed[Symbol.dispose]()","+      assert.strictEqual(refs(editor).size, 0)","+    })","+  }","+})","+","+describe('refs without native Symbol.dispose', () => {","+  it('keeps unref working and uses the fallback symbol without changing globals', () => {","+    const symbol = (description?: string) => Symbol(description)","+    for (const key of Reflect.ownKeys(Symbol)) {","+      if (key !== 'dispose') {","+        Object.defineProperty(","+          symbol,","+          key,","+          Object.getOwnPropertyDescriptor(Symbol, key)!","+        )","+      }","+    }","+    const slate = runInNewContext(","+      `${readFileSync(require.resolve('slate'), 'utf8')}; exports`,","+      { exports: {}, require, Symbol: symbol }","+    ) as typeof import('slate')","+    const editor = slate.createEditor()","+    editor.children = [{ children: [{ text: 'text' }] }]","+    const point = { path: [0, 0], offset: 1 }","+    const range = { anchor: point, focus: point }","+    for (const ref of [","+      slate.Editor.pathRef(editor, point.path),","+      slate.Editor.pointRef(editor, point),","+      slate.Editor.rangeRef(editor, range),","+    ]) {","+      assert(!Object.hasOwn(ref, 'undefined'))","+      const dispose = Reflect.get(ref, Symbol.for('Symbol.dispose'))","+      assert.strictEqual(typeof dispose, 'function')","+      dispose()","+      assert.strictEqual(ref.current, null)","+      assert.strictEqual(ref.unref(), null)","+    }","+    assert.strictEqual(slate.Editor.pathRefs(editor).size, 0)","+    assert.strictEqual(slate.Editor.pointRefs(editor).size, 0)","+    assert.strictEqual(slate.Editor.rangeRefs(editor).size, 0)","+    assert.strictEqual(Reflect.get(symbol, 'dispose'), undefined)","+    Object.defineProperty(symbol, 'dispose', { value: Symbol.dispose })","+    const late = slate.Editor.pathRef(editor, [0, 0])","+    late[Symbol.dispose]()","+    assert.strictEqual(late.current, null)","+  })","+})",""],"additions":99,"deletions":0,"truncated":false}],"additions":142,"deletions":0,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-14T13:05:04.595393+00:00"}