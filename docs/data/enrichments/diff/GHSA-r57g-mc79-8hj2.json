{"id":"GHSA-r57g-mc79-8hj2","axis":"advisories","repo":"djust-org/djust","sha":"45a5045793ebe7c9c2df86b0ad34275af6822619","parsed":{"files":[{"path":"changelog.d/mcp-path-containment.security.md","lines":["@@ -0,0 +1,10 @@","+- **MCP tools keep filesystem paths inside the project.**","+  `find_handlers_for_template` read any absolute path that existed, so it","+  confirmed which files existed anywhere on disk and returned `dj-*`-shaped","+  strings from them. It now reads an absolute path only when the file resolves","+  (symlinks and `..` followed) inside a directory the template loaders serve or","+  inside `BASE_DIR`, and answers any other absolute path like a missing","+  template. `seed_fixtures` compared paths with a string prefix, so","+  `/app-data` passed for a `BASE_DIR` of `/app`, and skipped the check when","+  `BASE_DIR` was unset; it now compares whole path components and refuses to","+  load anything without `BASE_DIR`. Both use one containment helper."],"additions":10,"deletions":0,"truncated":false},{"path":"docs/website/guides/mcp-server.md","lines":["@@ -231,11 +231,16 @@ serializes dry-runs."," template file against every view that uses it. Returns the `dj-*`"," handlers wired in the template AND the diff against the view's"," handler methods, so you can catch dead bindings (template uses","-`dj-click=\"missing\"`) at author time.","+`dj-click=\"missing\"`) at author time. `template_path` is a logical name or","+an absolute path to a file inside a directory the template engines serve, or","+inside `BASE_DIR`; any other absolute path gets the same \"Could not resolve","+template\" answer as a missing file."," "," **`seed_fixtures(fixture_paths)`** — Subprocess wrapper around"," `manage.py loaddata` for regression-fixture DB setup before a","-`reset_view_state` + `eval_handler` cycle.","+`reset_view_state` + `eval_handler` cycle. Every fixture path must resolve","+inside `BASE_DIR` (relative paths are joined to it, symlinks are followed);","+with no `BASE_DIR` set it loads nothing."," "," > **Security model.** Mirrors django-debug-toolbar: only fires when"," > `DEBUG=True` AND the request originates from `127.0.0.1` / `::1`."],"additions":7,"deletions":2,"truncated":false},{"path":"python/djust/mcp/server.py","lines":["@@ -15,7 +15,7 @@"," import logging"," import os"," import sys","-from typing import TYPE_CHECKING, Dict, cast","+from typing import TYPE_CHECKING, Any, Dict, cast"," "," if TYPE_CHECKING:","     from mcp.server.fastmcp import FastMCP","@@ -24,6 +24,60 @@"," "," __all__ = [\"create_server\", \"_django_ready\"]"," ","+# ---------------------------------------------------------------------------","+# Path containment shared by the tools that take a filesystem path","+# ---------------------------------------------------------------------------","+","+","+def _path_within(path: str, roots: \"list[Any]\") -> bool:","+    \"\"\"Whether ``path`` resolves inside one of ``roots``.","+","+    Both sides go through ``os.path.realpath``, so ``..`` segments and symlinks","+    are followed before comparing, and the comparison is","+    ``os.path.commonpath`` on whole path components, so ``/app-data`` is not","+    inside ``/app``. An empty ``roots`` contains nothing.","+    \"\"\"","+    real = os.path.realpath(path)","+    for root in roots:","+        if not root:","+            continue","+        base = os.path.realpath(str(root))","+        try:","+            if os.path.commonpath([real, base]) == base:","+                return True","+        except ValueError:  # different drives, or mixed absolute/relative","+            continue","+    return False","+","+","+def _template_roots() -> \"list[str]\":","+    \"\"\"Directories the configured template engines serve from, plus ``BASE_DIR``.\"\"\"","+    from django.conf import settings","+    from django.template import engines","+","+    roots: list[str] = []","+    for backend in engines.all():","+        try:","+            roots.extend(str(d) for d in getattr(backend, \"template_dirs\", None) or [])","+        except Exception:  # noqa: BLE001 -- a backend without dirs contributes none","+            pass","+        engine = getattr(backend, \"engine\", None)","+        pending = list(getattr(engine, \"template_loaders\", None) or [])","+        while pending:","+            loader = pending.pop()","+            pending.extend(getattr(loader, \"loaders\", None) or [])  # cached.Loader","+            get_dirs = getattr(loader, \"get_dirs\", None)","+            if callable(get_dirs):","+                try:","+                    roots.extend(str(d) for d in get_dirs())","+                except Exception:  # noqa: BLE001 -- a loader without dirs contributes none","+                    pass","+    base_dir = getattr(settings, \"BASE_DIR\", None)","+    if base_dir:","+        roots.append(str(base_dir))","+    return roots","+","+"," # ---------------------------------------------------------------------------"," # Django availability detection"," # ---------------------------------------------------------------------------","@@ -261,7 +315,8 @@ def seed_fixtures(fixture_paths: list[str]) -> str:","             fixture_paths: Absolute or relative paths to fixture files","                 (JSON, XML, YAML — whatever django-admin recognizes).","                 Relative paths are resolved against the Django project's","-                BASE_DIR (i.e. settings.BASE_DIR / path).","+                BASE_DIR (i.e. settings.BASE_DIR / path). Every path must","+                resolve inside BASE_DIR; without BASE_DIR nothing is loaded."," ","         Returns JSON: {ok, loaded_count, stdout, stderr, returncode}."," ","@@ -289,17 +344,22 @@ def seed_fixtures(fixture_paths: list[str]) -> str:","         from django.conf import settings as dj_settings"," ","         base_dir = getattr(dj_settings, \"BASE_DIR\", None)","+        if not base_dir:","+            return json.dumps(","+                {","+                    \"error\": \"settings.BASE_DIR is not set, so fixture paths cannot be \"","+                    \"confined to the project directory\",","+                }","+            )","         resolved = []","         for p in fixture_paths:","             if os.path.isabs(p):","                 candidate = os.path.realpath(p)","-            elif base_dir:","-                candidate = os.path.realpath(os.path.join(str(base_dir), p))","             else:","-                candidate = os.path.realpath(p)","-            # Security: reject paths outside the project directory.","-            # Prevents ../../../etc/evil.json style traversal.","-            if base_dir and not candidate.startswith(os.path.realpath(str(base_dir))):","+                candidate = os.path.realpath(os.path.join(str(base_dir), p))","+            # Reject paths outside the project directory (``..`` segments,","+            # symlinks, and sibling directories that share a name prefix).","+            if not _path_within(candidate, [base_dir]):","                 return json.dumps(","                     {","                         \"error\": f\"fixture path '{p}' resolves outside the project directory\",","@@ -311,8 +371,8 @@ def seed_fixtures(fixture_paths: list[str]) -> str:"," ","         # manage.py is the canonical entry point; fall back to -m if","         # we can't find one (e.g. during tests).","-        manage_py = os.path.join(str(base_dir), \"manage.py\") if base_dir else None","-        if manage_py and os.path.isfile(manage_py):","+        manage_py = os.path.join(str(base_dir), \"manage.py\")","+        if os.path.isfile(manage_py):","             cmd = [sys.executable, manage_py, \"loaddata\", *resolved]","         else:","             cmd = [sys.executable, \"-m\", \"django\", \"loaddata\", *resolved]","@@ -323,7 +383,7 @@ def seed_fixtures(fixture_paths: list[str]) -> str:","                 capture_output=True,","                 text=True,","                 timeout=60,","-                cwd=str(base_dir) if base_dir else None,","+                cwd=str(base_dir),","             )","         except subprocess.TimeoutExpired:","             return json.dumps(","@@ -360,7 +420,9 @@ def find_handlers_for_template(template_path: str) -> str:","         Args:","             template_path: Either a logical template name (e.g.","                 'demos/counter.html' — what you'd pass to `render`) OR","-                an absolute filesystem path. Both are searched.","+                an absolute path to a file inside a directory the template","+                engines serve, or inside BASE_DIR. Other absolute paths get","+                the answer a missing template gets."," ","         Returns JSON:","           {","@@ -393,8 +455,24 @@ def find_handlers_for_template(template_path: str) -> str:","         # Resolve the template to an absolute path. Accept both logical","         # names and absolute paths so callers can hand either form.","         resolved_path: str | None = None","-        if os.path.isabs(template_path) and os.path.isfile(template_path):","-            resolved_path = template_path","+        hint = (","+            \"Pass either a logical name (e.g. 'demos/counter.html') or an absolute \"","+            \"path inside the project's template directories or BASE_DIR.\"","+        )","+        if os.path.isabs(template_path):","+            # Read directly only a file that resolves (symlinks and ``..``","+            # followed) inside a directory the template engines serve, or","+            # inside BASE_DIR. Anything else gets the answer a missing","+            # template gets, so the reply says nothing about files elsewhere.","+            real_path = os.path.realpath(template_path)","+            if not (os.path.isfile(real_path) and _path_within(real_path, _template_roots())):","+                return json.dumps(","+                    {","+                        \"error\": f\"Could not resolve template '{template_path}': {template_path}\",","+                        \"hint\": hint,","+                    }","+                )","+            resolved_path = real_path","         else:","             try:","                 from django.template.loader import get_template","@@ -407,7 +485,7 @@ def find_handlers_for_template(template_path: str) -> str:","                 return json.dumps(","                     {","                         \"error\": f\"Could not resolve template '{template_path}': {e}\",","-                        \"hint\": \"Pass either a logical name (e.g. 'demos/counter.html') or an absolute filesystem path.\",","+                        \"hint\": hint,","                     }","                 )"," "],"additions":93,"deletions":15,"truncated":false},{"path":"python/djust/tests/test_mcp_path_containment.py","lines":["@@ -0,0 +1,205 @@","+\"\"\"MCP tools that take a filesystem path stay inside the project.","+","+``find_handlers_for_template`` reads an absolute","+path directly only when it lies inside a directory the template loaders serve","+or inside ``BASE_DIR``, and then opens the resolved path; any other absolute","+path gets the reply a missing template gets, so a file outside the project is","+neither read nor distinguishable from a missing one. ``seed_fixtures`` keeps every fixture inside ``BASE_DIR``","+and loads nothing when ``BASE_DIR`` is unset.","+","+Both use one helper, ``_path_within``: ``os.path.realpath`` on both sides","+(``..`` and symlinks are followed) and ``os.path.commonpath`` on whole path","+components, so a sibling directory that shares a name prefix (``/app-data``","+next to ``/app``) is outside.","+\"\"\"","+","+from __future__ import annotations","+","+import json","+import os","+","+import pytest","+from django.test import override_settings","+","+from djust.mcp.server import _path_within","+","+","+def _tool(name, **kwargs):","+    from djust.mcp.server import create_server","+","+    server = create_server()","+    tool = next(t for t in server._tool_manager._tools.values() if t.name == name)","+    return json.loads(tool.fn(**kwargs))","+","+","+def template_handler_report(template_path):","+    return _tool(\"find_handlers_for_template\", template_path=template_path)","+","+","+OUTSIDE_TEMPLATE = '<button dj-click=\"outside_handler\">x</button>\\n'","+","+","+@pytest.fixture","+def layout(tmp_path):","+    \"\"\"templates/ (served), templates-extra/ (sibling prefix), outside/.\"\"\"","+    templates = tmp_path / \"proj\" / \"templates\"","+    templates.mkdir(parents=True)","+    (templates / \"inside.html\").write_text('<button dj-click=\"inside_handler\">i</button>\\n')","+    sibling = tmp_path / \"proj\" / \"templates-extra\"","+    sibling.mkdir()","+    (sibling / \"sibling.html\").write_text(OUTSIDE_TEMPLATE)","+    outside = tmp_path / \"outside\"","+    outside.mkdir()","+    (outside / \"outside.html\").write_text(OUTSIDE_TEMPLATE)","+    (templates / \"link.html\").symlink_to(outside / \"outside.html\")","+    settings = [","+        {","+            \"BACKEND\": \"django.template.backends.django.DjangoTemplates\",","+            \"DIRS\": [str(templates)],","+            \"APP_DIRS\": False,","+        }","+    ]","+    # BASE_DIR is the templates directory itself, so the sibling and outside","+    # directories are outside every root.","+    with override_settings(TEMPLATES=settings, BASE_DIR=str(templates)):","+        yield {","+            \"templates\": templates,","+            \"sibling\": sibling / \"sibling.html\",","+            \"outside\": outside / \"outside.html\",","+            \"link\": templates / \"link.html\",","+            \"missing\": outside / \"missing.html\",","+        }","+","+","+def _assert_refused(report, path):","+    assert \"outside_handler\" not in json.dumps(report)","+    assert report.get(\"resolved_path\") is None, report","+    assert \"dj_handlers_in_template\" not in report, report","+    assert report[\"error\"].startswith(\"Could not resolve template %r\" % str(path))","+","+","+def test_absolute_path_inside_the_template_dirs_is_read(layout):","+    path = layout[\"templates\"] / \"inside.html\"","+    report = template_handler_report(str(path))","+    assert report.get(\"error\") is None, report","+    assert report[\"resolved_path\"] == os.path.realpath(path)","+    assert report[\"dj_handlers_in_template\"] == [\"inside_handler\"]","+","+","+def test_the_resolved_path_is_what_is_read(layout):","+    \"\"\"The file opened is the one the containment check resolved.\"\"\"","+    (layout[\"templates\"] / \"sub\").mkdir()","+    dotted = os.path.join(str(layout[\"templates\"]), \"sub\", \"..\", \"inside.html\")","+    report = template_handler_report(dotted)","+    assert report.get(\"error\") is None, report","+    assert report[\"resolved_path\"] == os.path.realpath(layout[\"templates\"] / \"inside.html\")","+    assert report[\"dj_handlers_in_template\"] == [\"inside_handler\"]","+","+","+def test_absolute_path_outside_the_project_is_refused(layout):","+    _assert_refused(template_handler_report(\"/etc/passwd\"), \"/etc/passwd\")","+    _assert_refused(template_handler_report(str(layout[\"outside\"])), layout[\"outside\"])","+","+","+def test_refusal_matches_a_missing_file(layout):","+    \"\"\"An outside file gets the same reply as a missing file.\"\"\"","+    existing = template_handler_report(str(layout[\"outside\"]))","+    missing = template_handler_report(str(layout[\"missing\"]))","+    assert set(existing) == set(missing)","+    assert existing[\"error\"].replace(str(layout[\"outside\"]), \"X\") == missing[\"error\"].replace(","+        str(layout[\"missing\"]), \"X\"","+    )","+","+","+def test_sibling_directory_sharing_a_prefix_is_refused(layout):","+    _assert_refused(template_handler_report(str(layout[\"sibling\"])), layout[\"sibling\"])","+","+","+def test_dotdot_segments_are_resolved_before_the_check(layout):","+    dotted = os.path.join(str(layout[\"templates\"]), \"..\", \"..\", \"outside\", \"outside.html\")","+    _assert_refused(template_handler_report(dotted), dotted)","+","+","+def test_symlink_out_of_the_template_dirs_is_refused(layout):","+    _assert_refused(template_handler_report(str(layout[\"link\"])), layout[\"link\"])","+","+","+def test_logical_names_still_resolve(layout):","+    report = template_handler_report(\"inside.html\")","+    assert report[\"dj_handlers_in_template\"] == [\"inside_handler\"]","+","+","+# --------------------------------------------------------------------------- #","+# The shared helper","+# --------------------------------------------------------------------------- #","+def test_path_within(tmp_path):","+    root = tmp_path / \"app\"","+    (root / \"sub\").mkdir(parents=True)","+    (tmp_path / \"app-data\").mkdir()","+    (tmp_path / \"elsewhere\").mkdir()","+    (root / \"elsewhere-link\").symlink_to(tmp_path / \"elsewhere\")","+","+    assert _path_within(str(root / \"sub\" / \"f.json\"), [root])","+    assert _path_within(str(root), [root])","+    assert not _path_within(str(tmp_path / \"app-data\" / \"f.json\"), [root])","+    assert not _path_within(str(root / \"..\" / \"elsewhere\" / \"f.json\"), [root])","+    assert not _path_within(str(root / \"elsewhere-link\" / \"f.json\"), [root])","+    assert not _path_within(str(root / \"sub\" / \"f.json\"), [])","+    assert not _path_within(str(root / \"sub\" / \"f.json\"), [None, \"\"])","+","+","+# --------------------------------------------------------------------------- #","+# seed_fixtures","+# --------------------------------------------------------------------------- #","+def _seed(paths):","+    return _tool(\"seed_fixtures\", fixture_paths=paths)","+","+","+@pytest.fixture","+def no_subprocess(monkeypatch):","+    import subprocess","+","+    def _refuse(*args, **kwargs):  # pragma: no cover - reached only on a regression","+        raise AssertionError(\"loaddata ran for a path that should have been refused\")","+","+    monkeypatch.setattr(subprocess, \"run\", _refuse)","+","+","+@pytest.mark.usefixtures(\"no_subprocess\")","+def test_seed_fixtures_refuses_a_sibling_prefix_directory(tmp_path):","+    base = tmp_path / \"app\"","+    base.mkdir()","+    sibling = tmp_path / \"app-other\"","+    sibling.mkdir()","+    (sibling / \"users.json\").write_text(\"[]\")","+    with override_settings(BASE_DIR=str(base)):","+        result = _seed([str(sibling / \"users.json\")])","+    assert \"outside the project directory\" in result[\"error\"]","+","+","+@pytest.mark.usefixtures(\"no_subprocess\")","+def test_seed_fixtures_refuses_a_relative_path_outside_base_dir(tmp_path):","+    base = tmp_path / \"app\"","+    base.mkdir()","+    with override_settings(BASE_DIR=str(base)):","+        result = _seed([\"../outside.json\"])","+    assert \"outside the project directory\" in result[\"error\"]","+","+","+@pytest.mark.usefixtures(\"no_subprocess\")","+def test_seed_fixtures_refuses_a_symlink_outside_base_dir(tmp_path):","+    base = tmp_path / \"app\"","+    base.mkdir()","+    (tmp_path / \"outside.json\").write_text(\"[]\")","+    (base / \"link.json\").symlink_to(tmp_path / \"outside.json\")","+    with override_settings(BASE_DIR=str(base)):","+        result = _seed([\"link.json\"])","+    assert \"outside the project directory\" in result[\"error\"]","+","+","+@pytest.mark.usefixtures(\"no_subprocess\")","+def test_seed_fixtures_requires_base_dir(tmp_path):","+    (tmp_path / \"users.json\").write_text(\"[]\")","+    with override_settings(BASE_DIR=None):","+        result = _seed([str(tmp_path / \"users.json\")])","+    assert \"BASE_DIR\" in result[\"error\"]",""],"additions":205,"deletions":0,"truncated":false}],"additions":315,"deletions":17,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-22T13:44:01.842757+00:00"}