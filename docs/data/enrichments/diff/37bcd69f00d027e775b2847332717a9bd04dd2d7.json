{"id":"37bcd69f00d027e775b2847332717a9bd04dd2d7","axis":"silent","repo":"grafana/tempo","sha":"37bcd69f00d027e775b2847332717a9bd04dd2d7","parsed":{"files":[{"path":".chloggen/metrics-extrapolate-override.yaml","lines":["@@ -0,0 +1,21 @@","+# Changelog entry. Generate a copy with `make chlog-new`, then fill in the fields.","+","+# One of: breaking | change | feature | enhancement | bug_fix | security","+change_type: enhancement","+","+# Component or area of the change. Must be one of the components in .chloggen/config.yaml,","+# e.g. distributor, querier, query-frontend, storage, operations.","+component: traceql","+","+# A brief description of the change. Surround with quotes (\"\") if it must start with a backtick (`).","+note: \"Operators can turn on extrapolation by default for TraceQL metrics queries per tenant with the new `metrics_extrapolate` override. A query can still opt out with `with(extrapolate=false)`.\"","+","+# (Optional) PR number(s), e.g. [7339]. Leave blank to auto-fill at release. See","+# .chloggen/README.md.","+issues: []","+","+# (Optional) Additional lines rendered under the note. Use a pipe (|) for multiline text.","+subtext:","+","+# The GitHub handle (without the leading @) of the change's author. Rendered as \"(@handle)\".","+user: csmarchbanks"],"additions":21,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/_index.md","lines":["@@ -2486,6 +2486,12 @@ overrides:","       # May be overridden by query hints.","       [metrics_spanonly_fetch: <bool> | default = true]"," ","+      # EXPERIMENTAL","+      # Per-user toggle for extrapolating TraceQL metrics from the per-span","+      # sampling probability by default. May be overridden by the","+      # extrapolate query hint.","+      [metrics_extrapolate: <bool> | default = false]","+","       # EXPERIMENTAL","       # When enabled, queries report an additional metric indicating whether the","       # matched spans include span-pruning summary spans (spans carrying the"],"additions":6,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/metrics-from-traces/metrics-queries/_index.md","lines":["@@ -141,3 +141,38 @@ overrides:"," "," When `unsafe_query_hints` is also enabled for the tenant, the `spanonly_fetch` query hint takes precedence over the per-tenant override. "," You can set `spanonly_fetch=false` to opt out, or `spanonly_fetch=true` to opt back in even when the override disables it for the tenant.","+","+### Extrapolation from ingest-time sampling","+","+{{< docs/experimental product=\"TraceQL metrics extrapolation\" >}}","+","+If your traces are sampled at ingest time by an OpenTelemetry probability sampler,","+TraceQL metrics can scale each matched span by the sampling probability recorded in its W3C tracestate,","+so results reflect the un-sampled traffic.","+Extrapolation requires vParquet4 or later blocks and is off by default.","+You can turn it on using a query hint or a per-tenant override.","+","+#### Turn on with a query hint","+","+Add the `extrapolate=true` hint to your query to turn on extrapolation for that query.","+This hint doesn't require `unsafe_query_hints`.","+For supported functions, refer to [Extrapolation from ingest-time sampling](/docs/tempo/<TEMPO_VERSION>/metrics-from-traces/metrics-queries/functions/#extrapolation-from-ingest-time-sampling-withextrapolatetrue-experimental).","+","+```","+{ resource.service.name = \"frontend\" } | rate() with (extrapolate=true)","+```","+","+#### Turn on with a per-tenant override","+","+Operators can turn on extrapolation by default for a tenant using the `metrics_extrapolate` override.","+When set to `true`, all metrics queries for that tenant are extrapolated.","+","+```yaml","+overrides:","+  'tenant-id':","+    read:","+      metrics_extrapolate: true","+```","+","+The `extrapolate` query hint takes precedence over the per-tenant override.","+You can set `extrapolate=false` to opt a query out, or `extrapolate=true` to opt in even when the override is off for the tenant."],"additions":35,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/metrics-from-traces/metrics-queries/functions.md","lines":["@@ -559,7 +559,7 @@ Samples a fixed percentage of traces for trace-level aggregations."," "," ## Extrapolation from ingest-time sampling: `with(extrapolate=true)` (experimental)"," ","-{{< docs/experimental product=\"Tempo\" >}}","+{{< docs/experimental product=\"TraceQL metrics extrapolation\" >}}"," "," If your traces were sampled at ingest time by an OpenTelemetry probability"," sampler (for example, an OTel Collector `probabilistic_sampler` in","@@ -580,6 +580,8 @@ Applies to `rate`, `count_over_time`, `sum_over_time`, `avg_over_time`,"," and `max_over_time` are intentionally unaffected because extremes don't"," scale with sampling."," ","+Operators can also [turn on extrapolation by default for a tenant](/docs/tempo/<TEMPO_VERSION>/metrics-from-traces/metrics-queries/#extrapolation-from-ingest-time-sampling).","+"," ## The `compare` function"," "," {{< admonition type=\"note\">}}"],"additions":3,"deletions":1,"truncated":false},{"path":"integration/api/metrics/extrapolate_test.go","lines":["@@ -0,0 +1,91 @@","+package metrics","+","+import (","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/grafana/e2e\"","+\t\"github.com/grafana/tempo/v3/integration/util\"","+\t\"github.com/grafana/tempo/v3/modules/overrides\"","+\t\"github.com/grafana/tempo/v3/pkg/tempopb\"","+\t\"github.com/grafana/tempo/v3/pkg/util/test\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// TestQueryRangeExtrapolateOverride checks that the metrics_extrapolate override is resolved by the","+// query-frontend and honored by the querier and live-store, including for live-store complete blocks","+// whose results were already cached without extrapolation.","+func TestQueryRangeExtrapolateOverride(t *testing.T) {","+\tutil.RunIntegrationTests(t, util.TestHarnessConfig{}, func(h *util.TempoHarness) {","+\t\th.WaitTracesWritable(t)","+","+\t\tconst (","+\t\t\ttraces        = 10","+\t\t\tspansPerTrace = 5","+\t\t\tspans         = traces * spansPerTrace","+\t\t)","+","+\t\tfor range traces {","+\t\t\ttrace := test.MakeTraceWithSpanCount(1, spansPerTrace, test.ValidTraceID(nil))","+\t\t\tfor _, rs := range trace.ResourceSpans {","+\t\t\t\tfor _, ss := range rs.ScopeSpans {","+\t\t\t\t\tfor _, s := range ss.Spans {","+\t\t\t\t\t\ts.TraceState = \"ot=th:8\" // 50% sampling, so each span extrapolates to 2","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t\trequire.NoError(t, h.WriteTempoProtoTraces(trace, \"\"))","+\t\t}","+","+\t\th.WaitTracesQueryable(t, traces)","+","+\t\t// wait for both live-stores to complete their blocks so the queries below go through the","+\t\t// complete-block cache","+\t\tfor _, service := range []string{util.ServiceLiveStoreZoneA, util.ServiceLiveStoreZoneB} {","+\t\t\trequire.NoError(t, h.Services[service].WaitSumMetricsWithOptions(","+\t\t\t\te2e.Greater(0),","+\t\t\t\t[]string{\"tempo_live_store_blocks_completed_total\"},","+\t\t\t\te2e.WaitMissingMetrics,","+\t\t\t))","+\t\t}","+","+\t\t// use the same time range for every query so the plain query hits the same complete-block cache","+\t\t// entries with the override off and on. the frontend aligns the end of the range down to the step","+\t\t// after applying query_end_cutoff, so use a short step to keep the spans just written in range.","+\t\tnow := time.Now()","+\t\tstart, end := now.Add(-5*time.Minute), now.Add(time.Minute)","+\t\tconst step = \"1s\"","+","+\t\trequireCount := func(t *testing.T, query string, expected float64) {","+\t\t\tt.Helper()","+\t\t\tcallQueryRange(t, h, queryRangeRequest{Query: query, Start: start, End: end, Step: step}, func(res *tempopb.QueryRangeResponse, err error) {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Len(t, res.GetSeries(), 1)","+\t\t\t\trequire.InDelta(t, expected, sumSamples(res.GetSeries()[0].GetSamples()), 0.000001)","+\t\t\t})","+\t\t}","+","+\t\tconst query = \"{} | count_over_time()\"","+","+\t\t// later cases depend on this one warming the cache, so stop if it fails","+\t\trequire.True(t, t.Run(\"override off\", func(t *testing.T) {","+\t\t\trequireCount(t, query, spans)","+\t\t}))","+","+\t\trequire.NoError(t, h.UpdateOverrides(map[string]*overrides.Overrides{","+\t\t\t\"single-tenant\": {","+\t\t\t\tRead: overrides.ReadOverrides{","+\t\t\t\t\tMetricsExtrapolate: new(true),","+\t\t\t\t},","+\t\t\t},","+\t\t}))","+","+\t\tt.Run(\"override on\", func(t *testing.T) {","+\t\t\trequireCount(t, query, 2*spans)","+\t\t})","+","+\t\tt.Run(\"override on, hint off\", func(t *testing.T) {","+\t\t\trequireCount(t, query+\" with(extrapolate=false)\", spans)","+\t\t})","+\t})","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"modules/frontend/metrics_query_range_sharder.go","lines":["@@ -28,6 +28,9 @@ import ("," "," const ("," \tdefaultStreamingShards = 200","+","+\t// extrapolationCacheKeySalt is mixed into the job cache key when a request extrapolates.","+\textrapolationCacheKeySalt = 3147483637"," )"," "," type queryRangeSharder struct {","@@ -127,6 +130,10 @@ func (s queryRangeSharder) RoundTrip(pipelineRequest pipeline.Request) (pipeline"," \t\tcutoff                = time.Now().Add(-s.cfg.QueryBackendAfter)"," \t)"," ","+\t// Resolve extrapolation once here so queriers, live-stores, and cache keys all use the same value","+\t// instead of each reading their own snapshot of the overrides.","+\treq.Extrapolate = resolveExtrapolate(expr, s.overrides.MetricsExtrapolate(tenantID), allowUnsafe)","+"," \tbackendExemplars, generatorExemplars := s.exemplarsCutoff(*req, cutoff)"," \treq.Exemplars = generatorExemplars"," \tgeneratorReq, jobMetadata := s.generatorRequest(tenantID, pipelineRequest, *req, cutoff)","@@ -293,6 +300,7 @@ func (s *queryRangeSharder) buildBackendRequests(ctx context.Context, tenantID s"," \t\t\t\tMaxSeries:              searchReq.MaxSeries,"," \t\t\t\tXInstant:               searchReq.XInstant,"," \t\t\t\tSkipASTTransformations: searchReq.SkipASTTransformations,","+\t\t\t\tExtrapolate:            searchReq.Extrapolate,"," \t\t\t}"," "," \t\t\treturn api.BuildQueryRangeRequest(r, queryRangeReq, dedColsJSON), nil","@@ -383,6 +391,15 @@ func (s *queryRangeSharder) exemplarsForBlock(m *backend.BlockMeta, totalExempla"," \treturn max(uint32(math.Ceil(share)), 1)"," }"," ","+// resolveExtrapolate returns whether the query should be extrapolated. The extrapolate query hint takes","+// precedence over the tenant's override, and extrapolation is off when neither is set.","+func resolveExtrapolate(expr *traceql.RootExpr, override *bool, allowUnsafe bool) bool {","+\tif b, ok := expr.Hints.GetBool(traceql.HintExtrapolate, allowUnsafe); ok {","+\t\treturn b","+\t}","+\treturn override != nil && *override","+}","+"," func hashForQueryRangeRequest(req *tempopb.QueryRangeRequest) uint64 {"," \tif req.Query == \"\" {"," \t\treturn 0","@@ -415,5 +432,10 @@ func hashForQueryRangeRequest(req *tempopb.QueryRangeRequest) uint64 {"," \t\thash = fnv1a.AddUint64(hash, 1147483619)"," \t}"," ","+\t// Only mixed in when set so that cache keys are unchanged for queries that don't extrapolate.","+\tif req.Extrapolate {","+\t\thash = fnv1a.AddUint64(hash, extrapolationCacheKeySalt)","+\t}","+"," \treturn hash"," }"],"additions":22,"deletions":0,"truncated":false},{"path":"modules/frontend/metrics_query_range_sharder_test.go","lines":["@@ -1,18 +1,26 @@"," package frontend"," "," import (","+\t\"context\""," \t\"net/http/httptest\""," \t\"strconv\""," \t\"strings\"","+\t\"sync\""," \t\"testing\""," \t\"time\""," "," \t\"github.com/go-kit/log\""," \t\"github.com/google/uuid\"","+\t\"github.com/grafana/dskit/user\"","+\t\"github.com/prometheus/client_golang/prometheus\""," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\""," ","+\t\"github.com/grafana/tempo/v3/modules/frontend/combiner\""," \t\"github.com/grafana/tempo/v3/modules/frontend/pipeline\"","+\t\"github.com/grafana/tempo/v3/modules/overrides\"","+\t\"github.com/grafana/tempo/v3/modules/querier\"","+\t\"github.com/grafana/tempo/v3/pkg/api\""," \t\"github.com/grafana/tempo/v3/pkg/tempopb\""," \t\"github.com/grafana/tempo/v3/tempodb/backend\""," )","@@ -457,3 +465,108 @@ func TestHashCollision(t *testing.T) {"," \tinstantHash := hashForQueryRangeRequest(&instant)"," \tassert.False(t, baseHash == instantHash, \"Hash collision detected between range and instant query\")"," }","+","+func TestHashForQueryRangeRequestExtrapolate(t *testing.T) {","+\treq := tempopb.QueryRangeRequest{","+\t\tQuery:     \"{} | rate()\",","+\t\tStep:      60,","+\t\tMaxSeries: 100,","+\t}","+","+\textrapolated := req","+\textrapolated.Extrapolate = true","+","+\tassert.NotEqual(t, hashForQueryRangeRequest(&req), hashForQueryRangeRequest(&extrapolated))","+}","+","+// TestQueryRangeSharderResolvesExtrapolate verifies that the sharder resolves extrapolation once from","+// the query hint and the tenant's override, and sends the result on every generator and backend request.","+func TestQueryRangeSharderResolvesExtrapolate(t *testing.T) {","+\ttests := []struct {","+\t\tname     string","+\t\toverride *bool","+\t\tquery    string","+\t\turlParam bool // client-supplied extrapolate=true, which the sharder should ignore","+\t\twant     bool","+\t}{","+\t\t{name: \"neither set\", query: \"{} | rate()\", want: false},","+\t\t{name: \"override on\", override: new(true), query: \"{} | rate()\", want: true},","+\t\t{name: \"override off\", override: new(false), query: \"{} | rate()\", want: false},","+\t\t{name: \"hint on\", query: \"{} | rate() with(extrapolate=true)\", want: true},","+\t\t{name: \"override on, hint off\", override: new(true), query: \"{} | rate() with(extrapolate=false)\", want: false},","+\t\t{name: \"override off, hint on\", override: new(false), query: \"{} | rate() with(extrapolate=true)\", want: true},","+\t\t{name: \"client param ignored\", query: \"{} | rate()\", urlParam: true, want: false},","+\t}","+","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tvar (","+\t\t\t\tmtx      sync.Mutex","+\t\t\t\tcaptured = map[string][]bool{} // query mode -> extrapolate values seen","+\t\t\t)","+\t\t\tnext := pipeline.AsyncRoundTripperFunc[combiner.PipelineResponse](func(r pipeline.Request) (pipeline.Responses[combiner.PipelineResponse], error) {","+\t\t\t\treq, err := api.ParseQueryRangeRequest(r.HTTPRequest())","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tmtx.Lock()","+\t\t\t\tcaptured[req.QueryMode] = append(captured[req.QueryMode], req.Extrapolate)","+\t\t\t\tmtx.Unlock()","+\t\t\t\treturn pipeline.NewAsyncResponse(nil), nil","+\t\t\t})","+","+\t\t\to, err := overrides.NewOverrides(overrides.Config{","+\t\t\t\tDefaults: overrides.Overrides{","+\t\t\t\t\tRead: overrides.ReadOverrides{MetricsExtrapolate: tc.override},","+\t\t\t\t},","+\t\t\t}, nil, prometheus.NewRegistry())","+\t\t\trequire.NoError(t, err)","+","+\t\t\tnow := time.Now()","+\t\t\treader := &mockReader{metas: []*backend.BlockMeta{{","+\t\t\t\tBlockID:           backend.MustParse(uuid.NewString()),","+\t\t\t\tTenantID:          \"test-tenant\",","+\t\t\t\tStartTime:         now.Add(-2 * time.Hour),","+\t\t\t\tEndTime:           now.Add(-90 * time.Minute),","+\t\t\t\tTotalRecords:      1,","+\t\t\t\tSize_:             1000,","+\t\t\t\tReplicationFactor: backend.MetricsGeneratorReplicationFactor,","+\t\t\t}}}","+","+\t\t\tsharder := newAsyncQueryRangeSharder(reader, o, QueryRangeSharderConfig{","+\t\t\t\tConcurrentRequests:    defaultConcurrentRequests,","+\t\t\t\tTargetBytesPerRequest: defaultTargetBytesPerRequest,","+\t\t\t\tQueryBackendAfter:     time.Hour,","+\t\t\t}, nil, false, nil, log.NewNopLogger())","+\t\t\ttestRT := sharder.Wrap(next)","+","+\t\t\treq := &tempopb.QueryRangeRequest{","+\t\t\t\tQuery:       tc.query,","+\t\t\t\tStart:       uint64(now.Add(-3 * time.Hour).UnixNano()),","+\t\t\t\tEnd:         uint64(now.UnixNano()),","+\t\t\t\tStep:        uint64(time.Minute),","+\t\t\t\tExtrapolate: tc.urlParam,","+\t\t\t}","+\t\t\thttpReq := api.BuildQueryRangeRequest(httptest.NewRequest(\"GET\", \"/\", nil), req, \"\")","+\t\t\thttpReq = httpReq.WithContext(user.InjectOrgID(httpReq.Context(), \"test-tenant\"))","+","+\t\t\tresps, err := testRT.RoundTrip(pipeline.NewHTTPRequest(httpReq))","+\t\t\trequire.NoError(t, err)","+\t\t\tfor {","+\t\t\t\t_, done, err := resps.Next(context.Background())","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tif done {","+\t\t\t\t\tbreak","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tmtx.Lock()","+\t\t\tdefer mtx.Unlock()","+\t\t\trequire.NotEmpty(t, captured[querier.QueryModeRecent], \"expected a generator request\")","+\t\t\trequire.NotEmpty(t, captured[\"\"], \"expected a backend request\")","+\t\t\tfor mode, values := range captured {","+\t\t\t\tfor _, v := range values {","+\t\t\t\t\tassert.Equal(t, tc.want, v, \"query mode %q\", mode)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"modules/livestore/instance_search.go","lines":["@@ -51,6 +51,9 @@ var ("," "," const ("," \ttimeBuffer = 5 * time.Minute","+","+\t// extrapolationCacheKeySalt is mixed into the complete-block cache name when a request extrapolates.","+\textrapolationCacheKeySalt = 3147483637"," )"," "," type block interface {","@@ -761,6 +764,8 @@ func (i *instance) QueryRange(ctx context.Context, req *tempopb.QueryRangeReques"," \t\tcompileOpts = append(compileOpts, traceql.WithSpanOnlyFetch(*p))"," \t}"," ","+\tcompileOpts = append(compileOpts, traceql.WithExtrapolation(req.Extrapolate))","+"," \tcompileOpts = append(compileOpts, overrides.SpanPruningAwarenessCompileOptions(i.overrides.SpanPruningAwareness(i.tenantID))...)"," \tif p := i.overrides.EngineBytesTracking(i.tenantID); p != nil {"," \t\tcompileOpts = append(compileOpts, traceql.WithEngineBytesTracking(*p))","@@ -1015,6 +1020,11 @@ func queryRangeHashForBlock(req tempopb.QueryRangeRequest) uint64 {"," \th = fnv1a.AddUint64(h, req.End)"," \th = fnv1a.AddUint64(h, req.Step)"," ","+\t// Only mixed in when set so that cache names are unchanged for queries that don't extrapolate.","+\tif req.Extrapolate {","+\t\th = fnv1a.AddUint64(h, extrapolationCacheKeySalt)","+\t}","+"," \t// TODO - caching for WAL blocks"," \t// Including trace count means we can safely cache results"," \t// for wal blocks which might receive new data"],"additions":10,"deletions":0,"truncated":false},{"path":"modules/livestore/instance_search_test.go","lines":["@@ -1788,6 +1788,109 @@ func TestQueryRangeReportsInspectedBytes(t *testing.T) {"," \trequire.NoError(t, services.StopAndAwaitTerminated(t.Context(), ls))"," }"," ","+func TestQueryRangeExtrapolate(t *testing.T) {","+\ttests := []struct {","+\t\tname        string","+\t\textrapolate bool","+\t\tquery       string","+\t\tmultiplier  float64","+\t}{","+\t\t{\"off\", false, \"{} | count_over_time()\", 1},","+\t\t{\"on\", true, \"{} | count_over_time()\", 2},","+\t\t{\"on, hint off\", true, \"{} | count_over_time() with(extrapolate=false)\", 1},","+\t\t{\"off, hint on\", false, \"{} | count_over_time() with(extrapolate=true)\", 2},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\ti, ls := defaultInstance(t)","+","+\t\t\tspanCount := pushSampledTrace(t, i)","+\t\t\t_, err := i.cutBlocks(t.Context(), true)","+\t\t\trequire.NoError(t, err)","+","+\t\t\tnow := time.Now()","+\t\t\ttotal := queryRangeTotal(t, i, tt.query, tt.extrapolate, now.Add(-time.Minute), now.Add(time.Minute))","+\t\t\trequire.Equal(t, tt.multiplier*float64(spanCount), total)","+","+\t\t\trequire.NoError(t, services.StopAndAwaitTerminated(t.Context(), ls))","+\t\t})","+\t}","+}","+","+// TestQueryRangeExtrapolateCache verifies that results cached for a complete block","+// without extrapolation aren't returned for an extrapolated request, and vice versa.","+func TestQueryRangeExtrapolateCache(t *testing.T) {","+\ti, ls := defaultInstance(t)","+","+\tspanCount := pushSampledTrace(t, i)","+\tblockID, err := i.cutBlocks(t.Context(), true)","+\trequire.NoError(t, err)","+\t_, err = i.completeBlock(t.Context(), blockID)","+\trequire.NoError(t, err)","+","+\tvar block *LocalBlock","+\tfor _, b := range i.blocks.Load().completeBlocks {","+\t\tblock = b","+\t\tbreak","+\t}","+\trequire.NotNil(t, block)","+\tstart := block.BlockMeta().StartTime.Add(-time.Minute)","+\tend := block.BlockMeta().EndTime.Add(time.Minute)","+\tquery := \"{} | count_over_time()\"","+","+\trequire.Equal(t, float64(spanCount), queryRangeTotal(t, i, query, false, start, end))","+\trequire.Equal(t, 2*float64(spanCount), queryRangeTotal(t, i, query, true, start, end))","+\trequire.Equal(t, float64(spanCount), queryRangeTotal(t, i, query, false, start, end))","+","+\trequire.NoError(t, services.StopAndAwaitTerminated(t.Context(), ls))","+}","+","+// pushSampledTrace pushes a trace whose spans all carry a 50% sampling threshold","+// (ot=th:8), so each span extrapolates to 2. It returns the number of spans pushed.","+func pushSampledTrace(t *testing.T, i *instance) int {","+\tnow := time.Now()","+\tid := test.ValidTraceID(nil)","+\ttr := test.MakeTrace(2, id)","+\tvar spanCount int","+\tfor _, rs := range tr.ResourceSpans {","+\t\tfor _, ss := range rs.ScopeSpans {","+\t\t\tfor _, s := range ss.Spans {","+\t\t\t\ts.StartTimeUnixNano = uint64(now.UnixNano())","+\t\t\t\ts.EndTimeUnixNano = uint64(now.UnixNano())","+\t\t\t\ts.TraceState = \"ot=th:8\"","+\t\t\t\tspanCount++","+\t\t\t}","+\t\t}","+\t}","+\trequire.Positive(t, spanCount)","+\tpushTrace(t.Context(), t, i, tr, id)","+","+\tdrained, err := i.cutIdleTraces(t.Context(), true)","+\trequire.NoError(t, err)","+\trequire.True(t, drained)","+\treturn spanCount","+}","+","+func queryRangeTotal(t *testing.T, i *instance, query string, extrapolate bool, start, end time.Time) float64 {","+\tresp, err := i.QueryRange(t.Context(), &tempopb.QueryRangeRequest{","+\t\tQuery:      