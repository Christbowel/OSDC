pdf += b\"2 0 obj\\n<< /Type /Pages /Kids [] /Count 0 >>\\nendobj\\n\"","+","+    prev_offset = len(pdf) if prev else None","+    if prev:","+        pdf += (","+            f\"3 0 obj\\n<< /Type /XRef /Size 12 /Index [10 2] /W [1 0 0] /Root 1 0 R /Filter /FlateDecode \"","+            f\"/Length {len(encoded)} >>\\nstream\\n\"","+        ).encode()","+        pdf += encoded + b\"\\nendstream\\nendobj\\n\"","+","+    startxref = len(pdf)","+    index_entry = f\"/Index {index} \" if index is not None else \"\"","+    prev_entry = f\"/Prev {prev_offset} \" if prev_offset is not None else \"\"","+","+    pdf += (","+        f\"3 0 obj\\n<< /Type /XRef /Size {size} {index_entry}/W [1 0 0] /Root 1 0 R \"","+        f\"{prev_entry}/Filter /FlateDecode /Length {len(encoded)} >>\\nstream\\n\"","+    ).encode()","+    pdf += encoded + b\"\\nendstream\\nendobj\\n\"","+    pdf += f\"startxref\\n{startxref}\\n%%EOF\\n\".encode()","+    return pdf","+","+","+@pytest.mark.timeout(10)","+@pytest.mark.parametrize(\"strict\", [\"True\", \"False\"])","+def test_read_pdf15_xref_stream__entry_limit(strict: bool, caplog):","+    encoded = FlateDecode.encode(b\"\\x02\" * 10)","+    pdf = _generate_pdf15_xref_stream_pdf_file(size=10, encoded=encoded)","+","+    with pytest.raises(","+            PdfReadError,","+            match=r\"^Trailer cannot be read: Maximum XRef stream entry limit reached: 10 > 3\\.$\"","+    ):","+        _ = PdfReader(BytesIO(pdf), strict=strict, xref_stream_maximum_entries=3)","+    assert caplog.messages == []","+","+","+@pytest.mark.timeout(10)","+def test_read_pdf15_xref_stream__entry_limit__prev(caplog):","+    encoded = FlateDecode.encode(b\"\\x02\\x02\")","+    pdf = _generate_pdf15_xref_stream_pdf_file(size=22, encoded=encoded, index=\"[20 2]\", prev=True)","+    reader = PdfReader(BytesIO(pdf), xref_stream_maximum_entries=3)","+","+    assert list(reader.xref_objStm) == [20, 21]","+    assert \"Previous trailer cannot be read: ('Maximum XRef stream entry limit reached: 4 > 3.',)\" in caplog.messages","+","+","+@pytest.mark.timeout(10)","+def test_read_pdf15_xref_stream__negative_count(caplog):","+    encoded = FlateDecode.encode(b\"\\x02\" * 2)","+    pdf = _generate_pdf15_xref_stream_pdf_file(size=12, encoded=encoded, index=\"[0 -5 10 2]\")","+","+    with pytest.raises(PdfReadError, match=r\"^Trailer cannot be read: Negative XRef count -5\\.$\"):","+        _ = PdfReader(BytesIO(pdf), strict=True)","+    assert caplog.messages == []","+","+    reader = PdfReader(BytesIO(pdf), strict=False)","+    assert list(reader.xref_objStm) == [10, 11]","+    assert caplog.messages == [\"Negative XRef count -5, using 0.\"]",""],"additions":67,"deletions":1,"truncated":false}],"additions":90,"deletions":1,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-10-31T14:35:31.594856+00:00"}