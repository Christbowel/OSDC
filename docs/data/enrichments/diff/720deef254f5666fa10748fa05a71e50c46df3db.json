     await require('./lib/util/start_bundle').loadStartBundle(__dirname)","+","+      return","+    }","+","     const tsx = require('tsx/cjs/api')"," ","     // @see https://tsx.hirok.io/dev-api/register-cjs"],"additions":10,"deletions":0,"truncated":false},{"path":"packages/server/lib/cloud/encryption.ts","lines":["@@ -2,7 +2,6 @@ import type { BinaryLike } from 'crypto'"," import crypto from 'crypto'"," import { TextEncoder, promisify } from 'util'"," import type { DecryptOptions, GeneralJWE } from 'jose'","-import { generalDecrypt } from 'jose'"," import base64Url from 'base64url'"," import type { CypressRequestOptions } from './api'"," import { deflateRaw as deflateRawCb, inflateRaw as inflateRawCb } from 'zlib'","@@ -116,6 +115,8 @@ export async function encryptRequest (params: Pick<CypressRequestOptions, 'body'","  * decrypts the response payload, which is assumed to be JSON","  */"," export async function decryptResponse (jwe: GeneralJWE, encryptionKey: crypto.KeyObject): Promise<any> {","+  // loaded on first use, since start-cypress loads this module during startup","+  const { generalDecrypt } = await import('jose')","   const result = await generalDecrypt(jwe, encryptionKey, DECRYPT_OPTIONS)","   const plaintext = Buffer.from(result.plaintext).toString('utf8')"," "],"additions":2,"deletions":1,"truncated":false},{"path":"packages/server/lib/project-base.ts","lines":["@@ -10,7 +10,6 @@ import * as config from './config'"," import * as errors from './errors'"," import preprocessor from './plugins/preprocessor'"," import runEvents from './plugins/run_events'","-import { Reporter } from './reporter'"," import * as savedState from './saved_state'"," import { SocketCt } from './socket-ct'"," import { SocketE2E } from './socket-e2e'","@@ -363,6 +362,9 @@ export class ProjectBase extends EE {","       return","     }"," ","+    // the reporter loads mocha, which open mode only needs once a spec runs","+    const { Reporter }: typeof import('./reporter') = require('./reporter')","+","     try {","       Reporter.loadReporter(reporter, projectRoot)","     } catch (error: any) {"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/server/lib/util/process_profiler.ts","lines":["@@ -1,7 +1,7 @@"," import Debug from 'debug'"," import la from 'lazy-ass'"," import _ from 'lodash'","-import si from 'systeminformation'","+import type si from 'systeminformation'"," import { concatStream } from '@packages/network'"," "," const browsers = require('../browsers').default","@@ -230,7 +230,10 @@ export const _printGroupedProcesses = (groupTotals) => {"," }"," "," function _checkProcesses () {","-  return si.processes()","+  // the profiler only runs with its debug namespace enabled, so don't load systeminformation at startup","+  const systemInformation: typeof si = require('systeminformation')","+","+  return systemInformation.processes()","   .then(groupCyProcesses)","   .then(_renameBrowserGroup)","   .then(_aggregateGroups)"],"additions":5,"deletions":2,"truncated":false},{"path":"packages/server/lib/util/start_bundle.ts","lines":["@@ -0,0 +1,67 @@","+import fs from 'fs'","+import Module from 'module'","+import path from 'path'","+import vm from 'vm'","+import Debug from 'debug'","+","+const debug = Debug('cypress:server:start-bundle')","+","+const START_BUNDLE_FILE = 'start-cypress.bundle.js'","+","+export const getStartBundlePaths = (serverDir: string) => {","+  const bundlePath = path.join(serverDir, START_BUNDLE_FILE)","+","+  return { bundlePath, cachePath: `${bundlePath}.cache` }","+}","+","+const readCachedData = (cachePath: string) => {","+  try {","+    // eslint-disable-next-line no-restricted-syntax","+    return fs.readFileSync(cachePath)","+  } catch {","+    return undefined","+  }","+}","+","+/**","+ * Runs the main process bundle that the binary build produces in place of `start-cypress.js`, with the V8 code cache","+ * the build generated for it. With CYPRESS_INTERNAL_WRITE_START_BUNDLE_CACHE set, it writes that cache when the process","+ * exits instead, so the cache also holds the functions that compiled lazily during startup.","+ */","+export const loadStartBundle = (serverDir: string): unknown => {","+  const { bundlePath, cachePath } = getStartBundlePaths(serverDir)","+  const writeCache = !!process.env.CYPRESS_INTERNAL_WRITE_START_BUNDLE_CACHE","+  // Synchronous on purpose: start-cypress appends Electron switches, which are ignored once the app is ready","+  // eslint-disable-next-line no-restricted-syntax","+  const bundleSource = fs.readFileSync(bundlePath, 'utf8')","+  const cachedData = writeCache ? undefined : readCachedData(cachePath)","+  // The wrapper sits on its own line so that lineOffset keeps stack positions in the bundle accurate","+  const source = `(function (exports, require, module, __filename, __dirname) {\\n${bundleSource}\\n})`","+","+  const script = new vm.Script(source, {","+    filename: bundlePath,","+    lineOffset: -1,","+    cachedData,","+    importModuleDynamically: vm.constants.USE_MAIN_CONTEXT_DEFAULT_LOADER,","+  })","+","+  if (cachedData) {","+    debug('code cache %s (%d bytes)', script.cachedDataRejected ? 'rejected' : 'accepted', cachedData.length)","+  }","+","+  if (writeCache) {","+    process.once('exit', () => {","+      // 'exit' listeners must be synchronous","+      // eslint-disable-next-line no-restricted-syntax","+      fs.writeFileSync(cachePath, script.createCachedData())","+    })","+  }","+","+  const bundleModule = new Module(bundlePath, module)","+","+  bundleModule.filename = bundlePath","+  script.runInThisContext()(bundleModule.exports, Module.createRequire(bundlePath), bundleModule, bundlePath, serverDir)","+  bundleModule.loaded = true","+","+  return bundleModule.exports","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"packages/server/test/unit/util/start_bundle.spec.ts","lines":["@@ -0,0 +1,66 @@","+import fs from 'fs-extra'","+import os from 'os'","+import path from 'path'","+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'","+import { getStartBundlePaths, loadStartBundle } from '../../../lib/util/start_bundle'","+","+describe('lib/util/start_bundle', () => {","+  let serverDir: string","+","+  const writeBundle = (source: string) => fs.outputFile(getStartBundlePaths(serverDir).bundlePath, source)","+","+  beforeEach(async () => {","+    serverDir = await fs.mkdtemp(path.join(os.tmpdir(), 'start-bundle-'))","+  })","+","+  afterEach(async () => {","+    vi.unstubAllEnvs()","+    vi.restoreAllMocks()","+    await fs.remove(serverDir)","+  })","+","+  it('runs the bundle as a module located at the bundle path', async () => {","+    await fs.outputFile(path.join(serverDir, 'sibling.js'), `module.exports = 'sibling'`)","+    await writeBundle(`module.exports = { filename: __filename, dirname: __dirname, sibling: require('./sibling') }`)","+","+    const { bundlePath } = getStartBundlePaths(serverDir)","+","+    expect(await loadStartBundle(serverDir)).toEqual({ filename: bundlePath, dirname: serverDir, sibling: 'sibling' })","+  })","+","+  it('supports dynamic import inside the bundle', async () => {","+    await writeBundle(`module.exports = import('path').then((m) => m.sep)`)","+","+    expect(await loadStartBundle(serverDir)).toEqual(path.sep)","+  })","+","+  it('reports stack positions relative to the bundle', async () => {","+    await writeBundle(`\\n  module.exports = new Error('here').stack`)","+","+    const { bundlePath } = getStartBundlePaths(serverDir)","+","+    expect(await loadStartBundle(serverDir)).toContain(`${bundlePath}:2:20`)","+  })","+","+  it('writes the code cache on exit when asked to', async () => {","+    vi.stubEnv('CYPRESS_INTERNAL_WRITE_START_BUNDLE_CACHE', '1')","+    const once = vi.spyOn(process, 'once')","+","+    await writeBundle(`module.exports = 'ok'`)","+    await loadStartBundle(serverDir)","+","+    const writeCache = once.mock.calls.find(([event]) => event === 'exit')?.[1]","+","+    expect(writeCache).toBeTypeOf('function')","+    writeCache?.()","+","+    expect((await fs.readFile(getStartBundlePaths(serverDir).cachePath)).length).toBeGreaterThan(0)","+  })","+","+  it('still runs the bundle when V8 rejects the code cache', async () => {","+    await writeBundle(`module.exports = 'ok'`)","+    await fs.outputFile(getStartBundlePaths(serverDir).cachePath, 'not a code cache')","+","+    expect(await loadStartBundle(serverDir)).toEqual('ok')","+  })","+})"],"additions":66,"deletions":0,"truncated":false},{"path":"patches/@graphql-tools+utils+8.6.9.patch","lines":["@@ -0,0 +1,26 @@","+diff --git a/node_modules/@graphql-tools/utils/index.js b/node_modules/@graphql-tools/utils/index.js","+index 40705e4..7cb7aab 100644","+--- a/node_modules/@graphql-tools/utils/index.js","+@@ -25,7 +25,7 @@ function isDocumentString(str) {","+     catch (e) { }","+     return false;","+ }","+-const invalidPathRegex = /[‘“!%&^<=>`]/;","++const invalidPathRegex = /[\\u2018\\u201C!%&^<=>`]/;","+ function isValidPath(str) {","+     return typeof str === 'string' && !invalidPathRegex.test(str);","+ }","+diff --git a/node_modules/@graphql-tools/utils/index.mjs b/node_modules/@graphql-tools/utils/index.mjs","+index 7bcbb7b..74f1ee7 100644","+--- a/node_modules/@graphql-tools/utils/index.mjs","+@@ -21,7 +21,7 @@ function isDocumentString(str) {","+     catch (e) { }","+     return false;","+ }","+-const invalidPathRegex = /[‘“!%&^<=>`]/;","++const invalidPathRegex = /[\\u2018\\u201C!%&^<=>`]/;","+ function isValidPath(str) {","+     return typeof str === 'string' && !invalidPathRegex.test(str);","+ }"],"additions":24,"deletions":0,"truncated":false},{"path":"patches/bytenode+1.3.7.dev.patch","lines":["@@ -1,124 +0,0 @@","-diff --git a/node_modules/bytenode/lib/cli.js b/node_modules/bytenode/lib/cli.js","-index 9f57493..3ba173e 100755","-+++ b/node_modules/bytenode/lib/cli.js","-@@ -2,11 +2,15 @@","- ","- 'use strict';","- ","--const fs = require('fs');","--const path =