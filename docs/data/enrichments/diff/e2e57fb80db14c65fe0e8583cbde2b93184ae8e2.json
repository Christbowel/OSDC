nfig/core/v3\"","+\tlistener \"github.com/envoyproxy/go-control-plane/envoy/config/listener/v3\"","+\ttcp \"github.com/envoyproxy/go-control-plane/envoy/extensions/filters/network/tcp_proxy/v3\"","+\twrappers \"google.golang.org/protobuf/types/known/wrapperspb\"","+","+\tnetworking \"istio.io/api/networking/v1alpha3\"","+\t\"istio.io/istio/pilot/pkg/features\"","+\t\"istio.io/istio/pilot/pkg/model\"","+\tistionetworking \"istio.io/istio/pilot/pkg/networking\"","+\t\"istio.io/istio/pilot/pkg/networking/core/match\"","+\tistio_route \"istio.io/istio/pilot/pkg/networking/core/route\"","+\t\"istio.io/istio/pilot/pkg/networking/plugin/authz\"","+\t\"istio.io/istio/pilot/pkg/networking/util\"","+\txdsfilters \"istio.io/istio/pilot/pkg/xds/filters\"","+\t\"istio.io/istio/pkg/config/host\"","+\t\"istio.io/istio/pkg/config/protocol\"","+\t\"istio.io/istio/pkg/slices\"","+\t\"istio.io/istio/pkg/util/sets\"","+)","+","+// gatewayWildcardTLSInternalName is the name of the internal listener of all wildcard DYNAMIC_DNS destinations of","+// ISTIO_MUTUAL gateway servers, and of the cluster that sends to it.","+const gatewayWildcardTLSInternalName = \"wildcard_tls_internal\"","+","+// gatewayWildcardTLSTarget is a wildcard DYNAMIC_DNS destination of an ISTIO_MUTUAL gateway server. As on a","+// waypoint, the real host is only visible on an internal listener, after the gateway terminates the mTLS.","+type gatewayWildcardTLSTarget struct {","+\tservice *model.Service","+\t// port is the upstream port of the destination.","+\tport int","+\t// dfpCluster is the dynamic forward proxy cluster of the destination.","+\tdfpCluster string","+\t// subset is the route destination subset.","+\tsubset string","+}","+","+// name is the name of the filter chain of the target on the internal listener.","+func (t gatewayWildcardTLSTarget) name() string {","+\treturn model.BuildSubsetKey(model.TrafficDirectionOutboundWildcardTLS, t.subset, t.service.Hostname, t.port)","+}","+","+// key identifies the target to the internal listener, as \"<host>:<port>\", or \"<host>:<port>/<subset>\" for a subset.","+func (t gatewayWildcardTLSTarget) key() string {","+\tkey := string(t.service.Hostname) + \":\" + strconv.Itoa(t.port)","+\tif t.subset != \"\" {","+\t\tkey += \"/\" + t.subset","+\t}","+\treturn key","+}","+","+// gatewayWildcardDestination returns the wildcard DYNAMIC_DNS service and upstream port when wildcard TLS is","+// enabled and the routes send to a single such service, as the chain has one SNI dynamic forward proxy filter.","+func gatewayWildcardDestination(","+\tnode *model.Proxy, routes []*networking.RouteDestination, serverPort int,","+) (*model.Service, int) {","+\tif !features.EnableWildcardHostServiceEntriesForTLS || len(routes) != 1 {","+\t\treturn nil, 0","+\t}","+\tsvc := node.SidecarScope.GetService(host.Name(routes[0].Destination.Host))","+\tif svc == nil || !svc.Hostname.IsWildCarded() || svc.Resolution != model.DynamicDNS {","+\t\treturn nil, 0","+\t}","+\t// Must match the port of the destination cluster.","+\t_, _, _, port := model.ParseSubsetKey(istio_route.GetDestinationCluster(routes[0].Destination, svc, serverPort))","+\treturn svc, port","+}","+","+// sniHostsUnder returns true if there are SNI hosts and all of them are under the wildcard host.","+func sniHostsUnder(sniHosts []string, wildcardHost host.Name) bool {","+\treturn len(sniHosts) > 0 && !slices.ContainsFunc(sniHosts, func(h string) bool { return !host.Name(h).SubsetOf(wildcardHost) })","+}","+","+// gatewayWildcardTLSTargetForServer returns the target of an ISTIO_MUTUAL TLS server whose routes send to a","+// wildcard DYNAMIC_DNS service.","+func gatewayWildcardTLSTargetForServer(","+\tnode *model.Proxy, server *networking.Server, routes []*networking.RouteDestination,","+) (gatewayWildcardTLSTarget, bool) {","+\tif server.GetTls().GetMode() != networking.ServerTLSSettings_ISTIO_MUTUAL || protocol.Parse(server.GetPort().GetProtocol()) != protocol.TLS {","+\t\treturn gatewayWildcardTLSTarget{}, false","+\t}","+\tsvc, port := gatewayWildcardDestination(node, routes, int(server.GetPort().GetNumber()))","+\tif svc == nil {","+\t\treturn gatewayWildcardTLSTarget{}, false","+\t}","+\treturn gatewayWildcardTLSTarget{","+\t\tservice:    svc,","+\t\tport:       port,","+\t\tdfpCluster: istio_route.GetDestinationCluster(routes[0].Destination, svc, int(server.GetPort().GetNumber())),","+\t\tsubset:     routes[0].Destination.GetSubset(),","+\t}, true","+}","+","+// buildGatewayWildcardTLSFilters builds the network filters of the ISTIO_MUTUAL gateway chain, and records the target","+// for the internal listener. The chain hands the peer identity, the original addresses and the target to the internal","+// listener and has no authorization filters: on this chain, the SNI is the mesh mTLS SNI, so AuthorizationPolicy is","+// applied on the internal listener instead.","+func (lb *ListenerBuilder) buildGatewayWildcardTLSFilters(target gatewayWildcardTLSTarget, port *model.Port) []*listener.Filter {"],"additions":119,"deletions":0,"truncated":false}],"additions":507,"deletions":23,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-06T17:01:17.744007+00:00"}