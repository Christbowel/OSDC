e: number, end: number }} the decoded value and the index just past it; `end` equals `start` when there is no valid value at `start`","+ */","+const decodeVLQ = (mappings, start) => {","+\tlet value = 0;","+\tlet shift = 0;","+\tlet index = start;","+\tlet digit;","+\tdo {","+\t\tdigit = index < mappings.length ? VLQ_BASE64.indexOf(mappings[index]) : -1;","+\t\tif (digit < 0) return { value: 0, end: start };","+\t\tvalue += (digit & 0x1f) << shift;","+\t\tshift += 5;","+\t\tindex++;","+\t} while (digit & 0x20);","+\treturn { value: value & 1 ? -(value >>> 1) : value >>> 1, end: index };","+};","+"," /**","  * @typedef {object} MappingSegment","  * @property {number=} generatedColumn 0-based generated column (defaults to 0)","@@ -114,5 +135,6 @@ const encodeMappings = (lines) => {"," \treturn encodedLines.join(\";\");"," };"," ","+module.exports.decodeVLQ = decodeVLQ;"," module.exports.encodeMappings = encodeMappings;"," module.exports.encodeVLQ = encodeVLQ;"],"additions":25,"deletions":3,"truncated":false},{"path":"lib/util/removeBOM.js","lines":["@@ -5,12 +5,17 @@"," "," \"use strict\";"," ","+const { decodeVLQ, encodeVLQ } = require(\"./createMappings\");","+","+/** @import { RawSourceMap } from \"webpack-sources\" */","+/** @import { Result } from \"../NormalModule\" */","+"," /**","  * Returns result without BOM.","  * @param {string | Buffer} strOrBuffer string or buffer","  * @returns {string | Buffer} result without BOM","  */","-module.exports = (strOrBuffer) => {","+const removeBOM = (strOrBuffer) => {"," \tif (typeof strOrBuffer === \"string\" && strOrBuffer.charCodeAt(0) === 0xfeff) {"," \t\treturn strOrBuffer.slice(1);"," \t} else if (","@@ -24,3 +29,79 @@ module.exports = (strOrBuffer) => {"," "," \treturn strOrBuffer;"," };","+","+/**","+ * A BOM occupies generated column 0 of the first line, so a map describing","+ * BOM-prefixed content starts that line at column 1 or later. Removing the BOM","+ * moves the line one column left; the segments after the first are encoded","+ * relative to it, so only the first is rewritten. A map already starting at","+ * column 0 describes the content without its BOM and is left alone.","+ * @param {string} mappings VLQ encoded `mappings` of a map for BOM-prefixed content","+ * @returns {string} `mappings` for the same content without its BOM","+ */","+const shiftMappings = (mappings) => {","+\tconst { value, end } = decodeVLQ(mappings, 0);","+\tif (end === 0 || value <= 0) return mappings;","+\treturn encodeVLQ(value - 1) + mappings.slice(end);","+};","+","+/**","+ * Adjust a source map that accompanied BOM-prefixed content for the removal of","+ * that BOM. Anything without VLQ `mappings` is passed through untouched, as is","+ * a map declaring a version other than 3 — earlier versions spell `mappings`","+ * differently. A map that declares no version at all is taken as version 3.","+ * @param {(string | RawSourceMap)=} sourceMap the map, as an object or as JSON","+ * @returns {(string | RawSourceMap)=} the adjusted map","+ */","+const adjustSourceMapForRemovedBOM = (sourceMap) => {","+\tif (!sourceMap) return sourceMap;","+","+\tif (typeof sourceMap === \"string\") {","+\t\t/** @type {RawSourceMap} */","+\t\tlet parsed;","+\t\ttry {","+\t\t\tparsed = JSON.parse(sourceMap);","+\t\t} catch (_err) {","+\t\t\treturn sourceMap;","+\t\t}","+\t\tconst adjusted = adjustSourceMapForRemovedBOM(parsed);","+\t\treturn adjusted === parsed ? sourceMap : JSON.stringify(adjusted);","+\t}","+","+\tif (sourceMap.version !== undefined && sourceMap.version !== 3) {","+\t\treturn sourceMap;","+\t}","+","+\tif (typeof sourceMap.mappings !== \"string\") return sourceMap;","+","+\tconst mappings = shiftMappings(sourceMap.mappings);","+","+\treturn mappings === sourceMap.mappings","+\t\t? sourceMap","+\t\t: { ...sourceMap, mappings };","+};","+","+/**","+ * @param {Result} result a loader result: content, an optional source map, extra info","+ * @returns {Result} the result with a leading BOM removed from its content and its source map kept in sync","+ */","+const removeBOMFromResult = (result) => {","+\tconst content = result[0];","+\tconst withoutBOM = removeBOM(content);","+","+\tif (withoutBOM === content) return result;","+","+\t// Copied rather than rebuilt, so a result carrying no source map keeps its","+\t// arity.","+\tconst adjusted = /** @type {Result} */ ([...result]);","+","+\tadjusted[0] = withoutBOM;","+","+\tif (adjusted[1]) adjusted[1] = adjustSourceMapForRemovedBOM(adjusted[1]);","+","+\treturn adjusted;","+};","+","+module.exports.adjustSourceMapForRemovedBOM = adjustSourceMapForRemovedBOM;","+module.exports.removeBOM = removeBOM;","+module.exports.removeBOMFromResult = removeBOMFromResult;"],"additions":82,"deletions":1,"truncated":false},{"path":"test/configCases/source-map/bom-from-loader-counting-map/bom-loader.js","lines":["@@ -0,0 +1,53 @@","+// Emulates dart-sass: the map counts the BOM, so line 1 starts at column 1.","+// `options.stringifyMap` returns it as JSON, the other shape a loader may use.","+const { encodeMappings } = require(\"../../../../lib/util/createMappings\");","+","+/** @type {import(\"../../../../\").LoaderDefinition<{ stringifyMap?: boolean }>} */","+module.exports = function bomLoader(source) {","+\tconst lines = source.split(\"\\n\");","+\t// Line 1 gets a second segment on the opening quote, so a shift that moved","+\t// more than the first segment would misplace the string literal.","+\tconst quote = lines[0].indexOf('\"');","+\tconst mappings = encodeMappings(","+\t\tlines.map((_, line) =>","+\t\t\tline === 0","+\t\t\t\t? [","+\t\t\t\t\t\t{","+\t\t\t\t\t\t\tgeneratedColumn: 1,","+\t\t\t\t\t\t\tsourceIndex: 0,","+\t\t\t\t\t\t\toriginalLine: 0,","+\t\t\t\t\t\t\toriginalColumn: 0","+\t\t\t\t\t\t},","+\t\t\t\t\t\t{","+\t\t\t\t\t\t\tgeneratedColumn: 1 + quote,","+\t\t\t\t\t\t\tsourceIndex: 0,","+\t\t\t\t\t\t\toriginalLine: 0,","+\t\t\t\t\t\t\toriginalColumn: quote","+\t\t\t\t\t\t}","+\t\t\t\t\t]","+\t\t\t\t: {","+\t