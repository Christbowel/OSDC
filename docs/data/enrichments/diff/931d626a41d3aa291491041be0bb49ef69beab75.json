).updatedProject.manifest","+","+  expect(manifest.dependencies).toStrictEqual({})","+  expect(project.readLockfile().importers['.'].dependencies).toBeUndefined()","+  expect(fs.existsSync('node_modules/@local/pkg')).toBe(false)","+  expect(fs.existsSync(path.join(localPkgDir, 'package.json'))).toBe(true)","+","+  await install(manifest, testDefaults({ frozenLockfile: true, nodeLinker: 'hoisted' }))","+  expect(fs.existsSync('node_modules/@local/pkg')).toBe(false)","+})","+","+test('uninstall a linked dependency does not unlink through a symlinked scope directory', async () => {","+  prepareEmpty()","+  const localPkgDir = path.resolve('..', 'local-pkg')","+  fs.mkdirSync(localPkgDir, { recursive: true })","+  fs.writeFileSync(path.join(localPkgDir, 'package.json'), JSON.stringify({ name: '@local/pkg', version: '1.0.0' }))","+","+  let { updatedManifest: manifest } = await addDependenciesToPackage(","+    {},","+    ['link:../local-pkg'],","+    testDefaults({ nodeLinker: 'hoisted', save: true })","+  )","+","+  const externalScopeDir = path.resolve('..', 'external-scope')","+  fs.mkdirSync(externalScopeDir)","+  await symlinkDir(localPkgDir, path.join(externalScopeDir, 'pkg'))","+  fs.rmSync('node_modules/@local', { recursive: true })","+  await symlinkDir(externalScopeDir, 'node_modules/@local')","+","+  manifest = (await mutateModulesInSingleProject({","+    dependencyNames: ['@local/pkg'],","+    manifest,","+    mutation: 'uninstallSome',","+    rootDir: process.cwd() as ProjectRootDir,","+  }, testDefaults({ nodeLinker: 'hoisted', save: true }))).updatedProject.manifest","+","+  expect(manifest.dependencies).toStrictEqual({})","+  expect(fs.lstatSync(path.join(externalScopeDir, 'pkg')).isSymbolicLink()).toBe(true)","+})"],"additions":63,"deletions":0,"truncated":false},{"path":"pnpm11/installing/deps-restorer/src/linkHoistedLayout.ts","lines":["@@ -14,6 +14,7 @@ import type { HeadlessContext, HeadlessDepGraph, LinkedDependencies } from './co"," import { linkHoistedModules } from './linkHoistedModules.js'"," import { reportDirectDependencyChanges } from './reportDirectDependencyChanges.js'"," import { symlinkDirectDependencies } from './symlinkDirectDependencies.js'","+import { unlinkStaleDirectLinks } from './unlinkStaleDirectLinks.js'"," import { getHoistedWorkspacePackages, removeBinsOfWorkspaceHoists } from './workspaceHoists.js'"," "," export interface HoistedLayout {","@@ -32,6 +33,7 @@ export async function linkHoistedLayout (ctx: HeadlessContext, depGraph: Headles","     // a project's name keeps the modules directory of what it replaces, which","     // through the symlink is the project's own node_modules.","     await unlinkPriorWorkspaceHoists(ctx)","+    await unlinkStaleDirectLinks(ctx, depGraph.filteredLockfile)","   }","   const heldBackBinsDirs = await linkHoistedTree(ctx, depGraph, layout)","   stageLogger.debug({"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm11/installing/deps-restorer/src/linkIsolatedLayout.ts","lines":["@@ -2,7 +2,6 @@ import { promises as fs } from 'node:fs'"," "," import { stageLogger } from '@pnpm/core-loggers'"," import * as dp from '@pnpm/deps.path'","-import { isError } from '@pnpm/error'"," import { safeJoinModulesDir } from '@pnpm/fs.symlink-dependency'"," import { hoist, pruneStaleWorkspaceHoists } from '@pnpm/installing.linking.hoist'"," import { logger } from '@pnpm/logger'","@@ -15,6 +14,7 @@ import { linkAllBins } from './linkAllBins.js'"," import { linkAllModules } from './linkAllModules.js'"," import { linkAllPkgs } from './linkAllPkgs.js'"," import { symlinkDirectDependencies } from './symlinkDirectDependencies.js'","+import { unlinkIfSymlink } from './unlinkIfSymlink.js'"," import { getHoistedWorkspacePackages, workspaceHoistPointsToProject } from './workspaceHoists.js'"," "," export async function linkIsolatedLayout (ctx: HeadlessContext, depGraph: HeadlessDepGraph): Promise<LinkedDependencies> {","@@ -124,21 +124,6 @@ async function unlinkFetchFailedChildren (depNodes: HeadlessDepGraph['depNodes']","   ))"," }"," ","-async function unlinkIfSymlink (link: string): Promise<void> {","-  const stats = await fs.lstat(link).catch((err: unknown) => {","-    if (isError(err) && 'code' in err && err.code === 'ENOENT') return undefined","-    throw err","-  })","-  if (!stats?.isSymbolicLink()) return","-  // A non-recursive unlink: an entry that stopped being a link since the","-  // check is a directory, which unlink refuses to remove.","-  try {","-    await fs.unlink(link)","-  } catch (err: unknown) {","-    if (!isError(err) || !('code' in err) || err.code !== 'ENOENT') throw err","-  }","-}","-"," function shouldHoistDependencies ({ opts, skipPostImportLinking }: HeadlessContext): boolean {","   return opts.ignorePackageManifest !== true && !skipPostImportLinking && (opts.hoistPattern != null || opts.publicHoistPattern != null)"," }"],"additions":1,"deletions":16,"truncated":false},{"path":"pnpm11/installing/deps-restorer/src/unlinkIfSymlink.ts","lines":["@@ -0,0 +1,22 @@","+import { promises as fs } from 'node:fs'","+","+import { isError } from '@pnpm/error'","+","+export async function unlinkIfSymlink (link: string): Promise<void> {","+  if (!await isSymlink(link)) return","+  // A non-recursive unlink: an entry that stopped being a link since the","+  // check is a directory, which unlink refuses to remove.","+  try {","+    await fs.unlink(link)","+  } catch (err: unknown) {","+    if (!isError(err) || !('code' in err) || err.code !== 'ENOENT') throw err","+  }","+}","+","+export async function isSymlink (path: string): Promise<boolean> {","+  const stats = await fs.lstat(path).catch((err: unknown) => {","+    if (isError(err) && 'code' in err && err.code === 'ENOENT') return undefined","+    throw err","+  })","+  return stats?.isSymbolicLink() === true","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"pnpm11/installing/deps-restorer/src/unlinkStaleDirectLinks.ts","lines":["@@ -0,0 +1,54 @@","+import { promises as fs } from 'node:fs'","+import path from 'node:path'","+","+import { removeBinsOfDependency } from '@pnpm/bins.remover'","+import { safeJoinModulesDir } from '@pnpm/fs.symlink-dependency'","+import type { LockfileObject, ProjectSnapshot } from '@pnpm/lockfile.fs'","+import { DEPENDENCIES_FIELDS } from '@pnpm/types'","+","+import type { HeadlessContext } from './context.js'","+import { isSymlink, unlinkIfSymlink } from './unlinkIfSymlink.js'","+","+/**","+ * Unlinks the direct dependencies of the selected projects that the wanted","+ * lockfile no longer records at the same version. The hoisted linker's orphan","+ * diff covers only the package directories it imported, so the `link:` and","+ * workspace links written beside them need this pass. Real directories are","+ * left to the orphan diff.","+ */","+export async function unlinkStaleDirectLinks (","+  { currentLockfile, selectedProjects }: HeadlessContext,","+  wantedLockfile: LockfileObject","+): Promise<void> {","+  if (currentLockfile == null) return","+  await Promise.all(selectedProjects.map(async ({ binsDir, id, modulesDir }) => {","+    const wantedImporter = wantedLockfile.importers[id]","+    if (wantedImporter == null) return","+    const wantedDeps = mergeDependencies(wantedImporter)","+    const staleAliases = Object.entries(mergeDependencies(currentLockfile.importers[id]))","+      .filter(([alias, ref]) => wantedDeps[alias] !== ref)","+      .map(([alias]) => alias)","+    await Promise.all(staleAliases.map(async (alias) => unlinkDirectLink(modulesDir, alias, binsDir)))","+  }))","+}","+","+function mergeDependencies (snapshot: ProjectSnapshot | undefined): Record<string, string> {","+  return Object.assign({}, ...DEPENDENCIES_FIELDS.map((depType) => snapshot?.[depType]))","+}","+","+async function unlinkDirectLink (modulesDir: string, alias: string, binsDir: string): Promise<void> {","+  const link = safeJoinModulesDir(modulesDir, alias)","+  // A symlinked `@scope` directory would redirect the unlink outside the modules directory.","+  if (alias.startsWith('@') && !await isRealDir(path.dirname(link))) return","+  if (!await isSymlink(link)) return","+  // Unlinking through a symlinked `.bin` would delete files outside the project.","+  if (await isRealDir(binsDir)) {","+    await removeBinsOfDependency(link, { binsDir })","+  }","+  await unlinkIfSymlink(link)","+}","+","+async function isRealDir (dir: string): Promise<boolean> {","+  const stats = await fs.lstat(dir).catch(() => undefined)","+  return stats?.isDirectory() === true","+}",""],"additions":54,"deletions":0,"truncated":false}],"additions":295,"deletions":44,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-13T15:27:34.882977+00:00"}