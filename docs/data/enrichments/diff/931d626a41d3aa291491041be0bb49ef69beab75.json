],"additions":4,"deletions":20,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/hoisted/stale_links.rs","lines":["@@ -0,0 +1,39 @@","+//! Links a previous install wrote that this one no longer wants, removed","+//! before the linker writes the tree.","+","+use super::{HoistedLinkerError, HoistedLinkerInputs};","+","+/// Runs before the linker writes the tree, so no package is imported at","+/// a path that is still a project's link.","+pub(super) fn unlink_prior_workspace_hoists(","+    inputs: &HoistedLinkerInputs<'_>,","+) -> Result<(), HoistedLinkerError> {","+    let modules_dir = &inputs.config.modules_dir;","+    crate::prune_stale_modules::prune_workspace_hoists(","+        &crate::prune_stale_modules::WorkspaceHoistDirs {","+            workspace_root: inputs.projects.walker_lockfile_dir,","+            private: modules_dir,","+            public: modules_dir,","+        },","+        inputs.prior.current_lockfile.unwrap_or(inputs.graph.lockfile),","+        inputs.prior.hoisted_dependencies,","+        None,","+    )","+    .map_err(HoistedLinkerError::PruneStaleLinks)","+}","+","+/// Runs before the linker writes the tree, so a package that replaces a","+/// removed `link:` dependency is not imported through the old link.","+pub(super) fn unlink_stale_direct_links(","+    inputs: &HoistedLinkerInputs<'_>,","+) -> Result<(), HoistedLinkerError> {","+    let Some(current_lockfile) = inputs.prior.current_lockfile else { return Ok(()) };","+    crate::prune_stale_modules::prune_stale_hoisted_direct_links(","+        inputs.projects.symlink_workspace_root,","+        inputs.config.modules_dir_name(),","+        inputs.graph.lockfile,","+        current_lockfile,","+        inputs.projects.dependency_groups,","+    )","+    .map_err(HoistedLinkerError::PruneStaleLinks)","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/linking.rs","lines":["@@ -76,9 +76,7 @@ impl From<HoistedLinkerError> for LinkPhaseError {","                 LinkPhaseError::SymlinkDirectDependencies(error)","             }","             HoistedLinkerError::WritePackageMap(error) => LinkPhaseError::WritePackageMap(error),","-            HoistedLinkerError::PruneWorkspaceHoists(error) => {","-                LinkPhaseError::PruneStaleModules(error)","-            }","+            HoistedLinkerError::PruneStaleLinks(error) => LinkPhaseError::PruneStaleModules(error),","             HoistedLinkerError::HoistSymlink(error) => LinkPhaseError::HoistSymlink(error),","             HoistedLinkerError::HoistLinkBins(error) => LinkPhaseError::HoistLinkBins(error),","         }"],"additions":1,"deletions":3,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/prune_stale_modules.rs","lines":["@@ -240,9 +240,7 @@ fn unlink_stale_direct_deps<Reporter: self::Reporter>(","     dedupe_against_root: Option<&HashMap<&PkgName, &ImporterDepVersion>>,"," ) -> Result<(), PruneDirectDepsError> {","     for (alias, current_spec, group) in direct_deps_of(current_snapshot, &RECORDED_GROUPS) {","-        let still_wanted = wanted_specs","-            .iter()","-            .any(|(name, spec, _)| *name == alias && spec.version == current_spec.version);","+        let still_wanted = is_still_wanted(alias, current_spec, wanted_specs);","         let deduped_by_root = dedupe_against_root.is_some_and(|root_deps| {","             root_deps","                 .get(alias)","@@ -267,6 +265,53 @@ fn unlink_stale_direct_deps<Reporter: self::Reporter>(","     Ok(())"," }"," ","+/// The hoisted linker's share of [`PruneStaleModules`]: unlink every","+/// direct-dependency link whose alias the wanted lockfile no longer","+/// records at the same version. Its orphan diff only covers the package","+/// directories it imported, so the `link:` and workspace links it wrote","+/// beside them would otherwise outlive their removal from the manifest.","+/// The link pass reports these removals, so nothing is emitted here.","+pub(crate) fn prune_stale_hoisted_direct_links(","+    workspace_root: &Path,","+    modules_dir_name: &OsStr,","+    wanted_lockfile: &Lockfile,","+    current_lockfile: &Lockfile,","+    included_groups: &[DependencyGroup],","+) -> Result<(), PruneDirectDepsError> {","+    for (importer_id, current_snapshot) in &current_lockfile.importers {","+        let Some(wanted_snapshot) = wanted_lockfile.importers.get(importer_id) else {","+            continue;","+        };","+        if validate_importer_id(importer_id).is_err() {","+            continue;","+        }","+        let importer_dir = importer_root_dir(workspace_root, importer_id);","+        let Some(modules_dir) =","+            confined_modules_dir(&importer_dir.join(modules_dir_name), workspace_root)","+        else {","+            continue;","+        };","+        let wanted_specs = direct_deps_of(wanted_snapshot, included_groups);","+        for (alias, current_spec, _) in direct_deps_of(current_snapshot, &RECORDED_GROUPS) {","+            if is_still_wanted(alias, current_spec, &wanted_specs) {","+                continue;","+            }","+            remove_direct_dep_link(&modules_dir, &alias.to_string())?;","+        }","+    }","+    Ok(())","+}","+","+fn is_still_wanted(","+    alias: &PkgName,","+    current_spec: &ResolvedDependencySpec,","+    wanted_specs: &[(&PkgName, &ResolvedDependencySpec, DependencyGroup)],","+) -> bool {","+    wanted_specs","+        .iter()","+        .any(|(name, spec, _)| *name == alias && spec.version == current_spec.version)","+}","+"," /// Diff the snapshot key sets, unlink the hoisted aliases the orphans"," /// owned, and return the unique orphan-package count."," fn prune_orphan_snapshots("],"additions":48,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/errors.rs","lines":["@@ -253,7 +253,7 @@ impl From<crate::install_frozen_lockfile::HoistedLinkerError> for InstallWithFre","             HoistedLinker