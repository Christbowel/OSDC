{"id":"931d626a41d3aa291491041be0bb49ef69beab75","axis":"silent","repo":"pnpm/pnpm","sha":"931d626a41d3aa291491041be0bb49ef69beab75","parsed":{"files":[{"path":".changeset/hoisted-remove-link-dep.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.deps-restorer\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Removing a `link:` dependency now also removes its symlink from `node_modules` when `nodeLinker` is `hoisted` [#16884](https://github.com/pnpm/pnpm/issues/16884)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hoisted_node_linker/repeat_install.rs","lines":["@@ -806,3 +806,55 @@ fn a_repeat_install_restores_a_removed_workspace_project_modules_dir() {"," ","     drop((root, mock_instance));"," }","+","+/// The hoisted linker's orphan diff covers only the package directories","+/// it imported, so a removed `link:` dependency needs its own cleanup.","+#[test]","+fn removing_a_linked_dependency_unlinks_it_under_the_hoisted_linker() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace_yaml(&workspace, \"nodeLinker: hoisted\\n\");","+","+    let local = workspace.join(\"local-pkg\");","+    fs::create_dir_all(&local).expect(\"create the local package dir\");","+    fs::write(","+        local.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"@local/pkg\", \"version\": \"1.0.0\" }).to_string(),","+    )","+    .expect(\"write the local package.json\");","+    write_manifest(&workspace, serde_json::json!({ \"@local/pkg\": \"link:./local-pkg\" }));","+","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let link = workspace.join(\"node_modules/@local/pkg\");","+    assert!(","+        is_symlink_or_junction(&link).expect(\"stat the link\"),","+        \"the install should link the local package\",","+    );","+","+    pacquet_in(&workspace)","+        .with_args([\"remove\", \"@local/pkg\"])","+        .assert()","+        .success();","+","+    assert!(fs::symlink_metadata(&link).is_err(), \"the link should be removed\");","+    assert!(local.join(\"package.json\").exists(), \"the link target should be left alone\");","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read the lockfile\");","+    assert!(!lockfile.contains(\"@local/pkg\"), \"the lockfile should drop the dependency\");","+","+    pacquet_in(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+    assert!(fs::symlink_metadata(&link).is_err(), \"a frozen install should not relink it\");","+","+    drop((root, mock_instance));","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile.rs","lines":["@@ -239,7 +239,7 @@ impl From<HoistedLinkerError> for InstallFrozenLockfileError {","             HoistedLinkerError::WritePackageMap(error) => {","                 InstallFrozenLockfileError::WritePackageMap(error)","             }","-            HoistedLinkerError::PruneWorkspaceHoists(error) => {","+            HoistedLinkerError::PruneStaleLinks(error) => {","                 InstallFrozenLockfileError::PruneStaleModules(error)","             }","             HoistedLinkerError::HoistSymlink(error) => {"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/hoisted.rs","lines":["@@ -10,8 +10,10 @@ pub use hoist_plan::{"," mod direct_links;"," mod hoist_plan;"," mod package_root_links;","+mod stale_links;"," mod workspace_links;"," ","+use stale_links::{unlink_prior_workspace_hoists, unlink_stale_direct_links};"," use workspace_links::link_hoisted_workspace_dependencies;"," "," use super::{","@@ -98,7 +100,7 @@ pub enum