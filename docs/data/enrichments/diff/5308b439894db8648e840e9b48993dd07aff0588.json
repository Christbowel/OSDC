els.NamedPorts{{Name: \"http\", Port: 8080, Protocol: \"TCP\"}},","+\t}","+\tif withWorkload {","+\t\tendpoint.Workload = workloadBenchmarkEndpointWorkload(i)","+\t}","+\treturn endpoint","+}","+","+func workloadBenchmarkCEP(withWorkload bool) *cilium_v2.CiliumEndpoint {","+\tendpoint := &cilium_v2.CiliumEndpoint{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      \"checkout-7c9f55d4b9-abcde\",","+\t\t\tNamespace: \"shop\",","+\t\t},","+\t\tStatus: cilium_v2.EndpointStatus{","+\t\t\tIdentity:   &cilium_v2.EndpointIdentity{ID: 10000},","+\t\t\tNetworking: workloadBenchmarkCoreEndpoint(0, false).Networking,","+\t\t},","+\t}","+\tif withWorkload {","+\t\tendpoint.Status.Workload = workloadBenchmarkEndpointWorkload(0)","+\t}","+\treturn endpoint","+}","+","+func workloadBenchmarkCES(withWorkload bool) *cilium_v2alpha1.CiliumEndpointSlice {","+\tslice := &cilium_v2alpha1.CiliumEndpointSlice{Namespace: \"shop\"}","+\tfor i := range workloadBenchmarkCESEndpoints {","+\t\tslice.Endpoints = append(slice.Endpoints, workloadBenchmarkCoreEndpoint(i, withWorkload))","+\t}","+\treturn slice","+}","+","+func BenchmarkEndpointWorkloadSerialization(b *testing.B) {","+\tbenchmarks := []struct {","+\t\tname      string","+\t\tendpoints int","+\t\tobject    any","+\t}{","+\t\t{name: \"CEP/without-workload\", endpoints: 1, object: workloadBenchmarkCEP(false)},","+\t\t{name: \"CEP/with-workload\", endpoints: 1, object: workloadBenchmarkCEP(true)},","+\t\t{name: \"CES/without-workload\", endpoints: workloadBenchmarkCESEndpoints, object: workloadBenchmarkCES(false)},","+\t\t{name: \"CES/with-workload\", endpoints: workloadBenchmarkCESEndpoints, object: workloadBenchmarkCES(true)},","+\t}","+","+\tfor _, benchmark := range benchmarks {","+\t\tb.Run(benchmark.name, func(b *testing.B) {","+\t\t\tpayload, err := json.Marshal(benchmark.object)","+\t\t\trequire.NoError(b, err)","+\t\t\tserializedBytesPerEndpoint := float64(len(payload)) / float64(benchmark.endpoints)","+\t\t\tb.ReportAllocs()","+\t\t\tb.ResetTimer()","+","+\t\t\tfor b.Loop() {","+\t\t\t\tworkloadSerializationSink, err = json.Marshal(benchmark.object)","+\t\t\t\tif err != nil {","+\t\t\t\t\tb.Fatal(err)","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tb.ReportMetric(serializedBytesPerEndpoint, \"bytes/endpoint\")","+\t\t})","+\t}","+}",""],"additions":104,"deletions":0,"truncated":false}],"additions":493,"deletions":6,"truncated":false,"file_count":20},"error":null,"fetched_at":"2026-10-08T16:17:09.948297+00:00"}