r();","+        if (deser == null) {","+            return false;","+        }","+        if (deser.hasAnySetter()) {","+            return true;","+        }","+        // [databind#6001]: collect into a temp set so we can tell whether this","+        //   deserializer contributed any names of its own; if not, it is \"opaque\"","+        //   (typically a custom unwrapping deserializer capturing arbitrary fields).","+        Set<String> propNames = new HashSet<>();","+        deser.collectAllPropertyNamesTo(propNames);","+        names.addAll(propNames);","+        // [databind#6332]: polymorphic unwrapped value also needs its type id property","+        TypeDeserializer typeDeser = getValueTypeDeserializer();","+        if (typeDeser != null) {","+            JsonTypeInfo.As incl = typeDeser.getTypeInclusion();","+            if (incl == JsonTypeInfo.As.PROPERTY || incl == JsonTypeInfo.As.EXISTING_PROPERTY) {","+                names.add(typeDeser.getPropertyName());","+            }","+        }","+        return propNames.isEmpty();","+    }","+","     public NullValueProvider getNullValueProvider() { return _nullProvider; }"," ","     public boolean visibleInView(Class<?> activeView) {"],"additions":49,"deletions":0,"truncated":false},{"path":"src/main/java/tools/jackson/databind/deser/impl/UnwrappedPropertyHandler.java","lines":["@@ -2,8 +2,6 @@"," "," import java.util.*;"," ","-import com.fasterxml.jackson.annotation.JsonTypeInfo;","-"," import tools.jackson.core.*;"," import tools.jackson.databind.DeserializationContext;"," import tools.jackson.databind.DeserializationFeature;","@@ -11,7 +9,6 @@"," import tools.jackson.databind.ValueDeserializer;"," import tools.jackson.databind.deser.SettableBeanProperty;"," import tools.jackson.databind.deser.bean.PropertyValueBuffer;","-import tools.jackson.databind.jsontype.TypeDeserializer;"," import tools.jackson.databind.util.NameTransformer;"," import tools.jackson.databind.util.TokenBuffer;"," ","@@ -259,50 +256,15 