n child = task.getTaskRun();","+            harness.taskOutputRepository().save(new TaskOutput(child.getParentTaskRunId(), child.getTenantId(), child.getExecutionId(), \"{}\".getBytes(), null));","+            return onWorker(Results.failed(task, T0));","+        };","+","+        harness.run(created, worker);","+        for (int i = 0; i < 4; i++) {","+            harness.tickExecutionDelays(AFTER_ANY_RETRY_DELAY);","+            harness.run(List.of(), worker);","+        }","+","+        assertThat(harness).hasExecutionInState(created, State.Type.SUCCESS);","+        return created;","+    }","+","+    private static WorkerTaskResult onWorker(WorkerTaskResult result) {","+        List<TaskRunAttempt> attempts = result.getTaskRun().getAttempts().stream()","+            .map(attempt -> TaskRunAttempt.builder().state(attempt.getState()).workerId(\"worker\").build())","+            .toList();","+        return new WorkerTaskResult(result.getTaskRun().withAttempts(attempts));","+    }","+","+    private TaskRun taskRun(Execution execution, String taskId) {","+        return harness.executionStateStore().findByIdWithoutAcl(execution.getId()).findTaskRunsByTaskId(taskId).getFirst();","+    }","+","     private Map<String, Object> executionOutputs(Execution execution) throws Exception {","         return harness.executionOutputService().getOutputs(harness.executionStateStore().findByIdWithoutAcl(execution.getId()));","     }"],"additions":98,"deletions":0,"truncated":false},{"path":"executor/src/test/java/io/kestra/executor/testkit/InMemoryTaskOutputRepository.java","lines":["@@ -34,6 +34,11 @@ public List<TaskOutput> findByExecution(Execution execution) {","             .toList();","     }"," ","+    @Override","+    public void deleteById(String tenantId, String taskRunId) {","+        outputs.remove(key(tenantId, taskRunId));","+    }","+","     @Override","     public int purgeByExecutionIds(List<String> executionIds) {","         int before = outputs.size();"],"addit