","+// Stale files must be ignored during config discovery so they aren't mistaken for the","+// primary CNI config (a leftover file sorts to a high priority).","+func staleIstioOwnedNames(cfg *config.InstallConfig) (sets.String, string) {","+\tpreviousNames := sets.New(constants.DefaultIstioOwnedCNIConfigFilename)","+","+\tcurrentName := \"\"","+\tif useIstioOwnedCNIConfig(cfg) {","+\t\tcurrentName = cfg.IstioOwnedCNIConfigFilename","+\t\tif currentName == \"\" {","+\t\t\tcurrentName = constants.DefaultIstioOwnedCNIConfigFilename","+\t\t}","+\t} else if cfg.IstioOwnedCNIConfigFilename != \"\" {","+\t\tpreviousNames.Insert(cfg.IstioOwnedCNIConfigFilename)","+\t}","+","+\tif previousName := readPreviousIstioOwnedMarker(cfg); previousName != \"\" {","+\t\tpreviousNames.Insert(previousName)","+\t}","+\tpreviousNames.Delete(currentName)","+\treturn previousNames, currentName","+}","+","+// removeStaleIstioOwnedConfig removes an istio-owned CNI config file that is no longer","+// the one istio should own. It must run after the current CNI config has been written","+// (or validated) so the node is never left without the istio-cni plugin configured.","+// Until then, config discovery ignores the stale files (see staleIstioOwnedNames).","+func removeStaleIstioOwnedConfig(cfg *config.InstallConfig) error {","+\tstale, currentName := staleIstioOwnedNames(cfg)","+\tfor p := range stale {","+\t\tif err := removeIstioOwnedFile(cfg, p); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\t// Keep the marker in sync with what istio owns now."],"additions":74,"deletions":0,"truncated":false}],"additions":347,"deletions":128,"truncated":true,"file_count":4},"error":null,"fetched_at":"2026-10-22T13:46:15.241504+00:00"}