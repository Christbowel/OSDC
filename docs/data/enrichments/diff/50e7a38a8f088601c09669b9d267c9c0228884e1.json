{"id":"50e7a38a8f088601c09669b9d267c9c0228884e1","axis":"silent","repo":"symfony/symfony","sha":"50e7a38a8f088601c09669b9d267c9c0228884e1","parsed":{"files":[{"path":"src/Symfony/Component/HtmlSanitizer/Tests/HtmlSanitizerCustomTest.php","lines":["@@ -491,6 +491,201 @@ public function testAllowedHostsApplyToHostZero()","         $this->assertSame('<img />', $this->sanitize($config, '<img src=\"https://0/image.png\" />'));","     }"," ","+    public function testAllowMediasHostsInSrcset()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('img', ['src', 'srcset'])","+            ->allowMediaHosts(['trusted.com'])","+        ;","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/b.png 2x\" />',","+            $this->sanitize($config, '<img srcset=\"https://untrusted.com/a.png 1x, https://trusted.com/b.png 2x\" />')","+        );","+","+        $this->assertSame(","+            '<img />',","+            $this->sanitize($config, '<img srcset=\"https://untrusted.com/a.png 1x\" />')","+        );","+","+        $this->assertSame(","+            '<img />',","+            $this->sanitize($config, '<img src=\"https://untrusted.com/a.png\" />')","+        );","+    }","+","+    public function testAllowMediasSchemesInSrcset()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('picture')","+            ->allowElement('source', ['srcset'])","+            ->allowElement('img', ['src'])","+            ->allowMediaSchemes(['https'])","+        ;","+","+        $this->assertSame(","+            '<picture><source /><img /></picture>',","+            $this->sanitize($config, '<picture><source srcset=\"http://trusted.com/a.png 1x\"><img src=\"http://trusted.com/a.png\"></picture>')","+        );","+","+        $this->assertSame(","+            '<picture><source srcset=\"https://trusted.com/a.png 1x\" /></picture>',","+            $this->sanitize($config, '<picture><source srcset=\"