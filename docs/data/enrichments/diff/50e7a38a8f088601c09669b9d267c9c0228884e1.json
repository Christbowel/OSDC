"+            ->allowMediaHosts(['trusted.com'])","+        ;","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a,b.png 1x, https://trusted.com/c,d.png 2x\" />',","+            $this->sanitize($config, '<img srcset=\"https://trusted.com/a,b.png 1x,https://trusted.com/c,d.png 2x\" />')","+        );","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png, https://trusted.com/b.png 2x\" />',","+            $this->sanitize($config, '<img srcset=\"https://trusted.com/a.png,,, https://trusted.com/b.png 2x\" />')","+        );","+    }","+","+    public function testSrcsetCommasInsideDescriptorParenthesesAreNotCandidateSeparators()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('img', ['srcset'])","+            ->allowMediaHosts(['trusted.com'])","+        ;","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png (a,b)\" />',","+            $this->sanitize($config, '<img srcset=\"https://trusted.com/a.png (a,b) , https://evil.com/x.png 1x\" />')","+        );","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png (a,b), https://trusted.com/c.png 1x\" />',","+            $this->sanitize($config, '<img srcset=\"https://trusted.com/a.png (a,b), https://trusted.com/c.png 1x\" />')","+        );","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png 1x\" />',","+            $this->sanitize($config, '<img srcset=\"https://evil.com/x.png (a,b) , https://trusted.com/a.png 1x\" />')","+        );","+","+        // An unterminated parenthesis swallows the rest of the value, as the specification requires","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png (a,b\" />',","+            $this->sanitize($config, '<img srcset=\"https://trusted.com/a.png (a,b\" />')","+        );","+","+        // Parentheses do not nest, so the first one closes the run and the next comma separates","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png (a(b)\" />',","+            $this->sanitize($config, '<img srcset=\"https://trusted.com/a.png (a(b),c) 2x, https://evil.com/x.png 1x\" />')","+        );","+    }","+","+    public function testSrcsetDescriptorWhitespaceIsNormalized()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('img', ['srcset'])","+            ->allowMediaHosts(['trusted.com'])","+        ;","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png 100w 2x, https://trusted.com/b.png 1x\" />',","+            $this->sanitize($config, \"<img srcset=\\\"https://trusted.com/a.png \\t 100w\\n\\n2x ,\\t https://trusted.com/b.png   1x\\\" />\")","+        );","+    }","+","+    public function testForceHttpsUrlsInSrcset()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('img', ['srcset'])","+            ->forceHttpsUrls()","+        ;","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/a.png 1x\" />',","+            $this->sanitize($config, '<img srcset=\"http://trusted.com/a.png 1x\" />')","+        );","+    }","+","+    public function testAllowRelativeMediasInSrcset()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('img', ['srcset'])","+        ;","+","+        $this->assertSame(","+            '<img />',","+            $this->sanitize($config, '<img srcset=\"/a.png 1x\" />')","+        );","+","+        $this->assertSame(","+            '<img srcset=\"/a.png 1x\" />',","+            $this->sanitize($config->allowRelativeMedias(), '<img srcset=\"/a.png 1x\" />')","+        );","+    }","+","+    public function testAllowRelativeMediasInSrcsetDoesNotAllowSchemeRelativeHosts()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowElement('img', ['srcset'])","+            ->allowMediaHosts(['trusted.com'])","+            ->allowRelativeMedias()","+        ;","+","+        $this->assertSame(","+            '<img srcset=\"/b.png 2x\" />',","+            $this->sanitize($config, '<img srcset=\"https:untrusted.com/a.png 1x, /b.png 2x\" />')","+        );","+","+        $this->assertSame(","+            '<img srcset=\"https://trusted.com/c.png 3x\" />',","+            $this->sanitize($config, '<img srcset=\"https:/untrusted.com/a.png 1x, ///untrusted.com/b.png 2x, https://trusted.com/c.png 3x\" />')","+        );","+","+        $this->assertSame(","+            '<img />',","+            $this->sanitize($config, '<img srcset=\"https:untrusted.com/a.png 1x\" />')","+        );","+    }","+","     public function testActionAttributeIsSanitized()","     {","         $config = (new HtmlSanitizerConfig())"],"additions":195,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/HtmlSanitizer/Visitor/AttributeSanitizer/UrlAttributeSanitizer.php","lines":["@@ -27,27 +27,106 @@ public function getSupportedElements(): ?array"," ","     public function getSupportedAttributes(): ?array","     {","-        return ['src', 'href', 'lowsrc', 'background', 'ping', 'action', 'formaction', 'poster', 'cite', 'data', 'codebase', 'archive', 'longdesc'];","+        return ['src', 'srcset', 'imagesrcset', 'href', 'lowsrc', 'background', 'ping', 'action', 'formaction', 'poster', 'cite', 'data', 'codebase', 'archive', 'longdesc'];","     }"," ","     public function sanitizeAttribute(string $element, string $attribute, string $value, HtmlSanitizerConfig $config): ?string","     {","         if (\\in_array($element, ['a', 'area'], true) || \\in_array($attribute, ['action', 'formaction', 'cite'], true)) {","-            return UrlSanitizer::sanitize(","-                $value,","-                $config->getAllowedLinkSchemes(),","-                $config->getForceHttpsUrls(),","-                $config->getAllowedLinkHosts(),","-                $config->getAllowRelativeLinks(),","-            );","+            $allowedSchemes = $config->getAllowedLinkSchemes();","+            $allowedHosts = $config->getAllowedLinkHosts();","+            $allowRelative = $config->getAllowRelativeLinks();","+        } else {","+            $allowedSchemes = $config->getAllowedMediaSchemes();","+            $allowedHosts = $config->getAllowedMediaHosts();","+            $allowRelative = $config->getAllowRelativeMedias();","         }"," ","-        return UrlSanitizer::sanitize(","-            $value,","-            $config->getAllowedMediaSchemes(),","-            $config->getForceHttpsUrls(),","-            $config->getAllowedMediaHosts(),","-            $config->getAllowRelativeMedias(),","-        );","+        if (\\in_array($attribute, ['srcset', 'imagesrcset'], true)) {","+            return self::sanitizeSrcset($value, $allowedSchemes, $config->getForceHttpsUrls(), $allowedHosts, $allowRelative);","+        }","+","+        return UrlSanitizer::sanitize($value, $allowedSchemes, $config->getForceHttpsUrls(), $allowedHosts, $allowRelative);","+    }","+","+    /**","+     * Sanitizes an image candidate strings list: a comma-separated list of candidates,","+     * each made of an URL optionally followed by width or pixel density descriptors.","+     *","+     * Candidates whose URL doesn't pass the policy are dropped; the attribute itself is","+     * dropped when no candidate is left, as an empty list would be invalid anyway.","+     *","+     * @see https://html.spec.whatwg.org/multipage/images.html#parsing-a-srcset-attribute","+     */","+    private static function sanitizeSrcset(string $value, ?array $allowedSchemes, bool $forceHttps, ?array $allowedHosts, bool $allowRelative): ?string","+    {","+        $candidates = [];","+        $length = \\strlen($value);","+        $position = 0;","+","+        while ($position < $length) {","+            $position += strspn($value, \" \\t\\n\\f\\r,\", $position);","+","+            if ($position >= $length) {","+                break;","+            }","+","+            $urlLength = strcspn($value, \" \\t\\n\\f\\r\", $position);","+            $url = substr($value, $position, $urlLength);","+            $position += $urlLength;","+","+            // An URL may contain commas, so only trailing ones separate candidates","+            if (str_ends_with($url, ',')) {","+                $url = rtrim($url, ',');","+                $descriptors = '';","+            } else {","+                $descriptors = self::consumeSrcsetDescriptors($value, $position, $length);","+            }","+","+            if (null === $url = UrlSanitizer::sanitize($url, $allowedSchemes, $forceHttps, $allowedHosts, $allowRelative)) {","+                continue;","+            }","+","+            $candidates[] = '' === $descriptors ? $url : $url.' '.$descriptors;","+        }","+","+        return $candidates ? implode(', ', $candidates) : null;","+    }","+","+    /**","+     * Consumes the descriptors of the current candidate, up to the next separating comma,","+     * ignoring commas nested in parentheses as the HTML specification requires.","+     */","+    private static function consumeSrcsetDescriptors(string $value, int &$position, int $length): string","+    {","+        $start = $position;","+        $inParens = false;","+","+        while ($position < $length) {","+            $char = $value[$position];","+","+            if ($inParens) {","+                $inParens = ')' !== $char;","+            } elseif ('(' === $char) {","+                $inParens = true;","+            } elseif (',' === $char) {","+                break;","+            }","+","+            ++$position;","+        }","+","+        $consumed = strtr(substr($value, $start, $position - $start), \"\\t\\n\\f\\r\", '    ');","+        ++$position;","+","+        $descriptors = [];","+","+        foreach (explode(' ', $consumed) as $descriptor) {","+            if ('' !== $descriptor) {","+                $descriptors[] = $descriptor;","+            }","+        }","+","+        return implode(' ', $descriptors);","     }"," }",""],"additions":94,"deletions":15,"truncated":false}],"additions":289,"deletions":15,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-04T16:06:11.688989+00:00"}