{"id":"2ea3566decd2ac567f1d8c91a46262a77b919a0f","axis":"silent","repo":"supabase/supabase","sha":"2ea3566decd2ac567f1d8c91a46262a77b919a0f","parsed":{"files":[{"path":"apps/kb/src/content.config.ts","lines":["@@ -73,4 +73,19 @@ const troubleshooting = defineCollection({","   }),"," })"," ","-export const collections = { guides, troubleshooting }","+// Question-and-answer entries in src/content/faqs. `title` holds the question,","+// and the body holds the answer. Entries are not rendered by a page yet — this","+// collection only defines the schema so content can be authored against it.","+const faqs = defineCollection({","+  loader: glob({ pattern: '**/*.{md,mdx}', base: './src/content/faqs', generateId }),","+  // Every entry is tagged with the FAQs topic in addition to any topics its","+  // frontmatter lists, so it appears on /topics/faqs and its product topic pages.","+  schema: z","+    .object({","+      title: z.string(),","+      topics: z.array(z.string()).default([]),","+    })","+    .transform((data) => ({ ...data, topics: [...new Set(['FAQs', ...data.topics])] })),","+})","+","+export const collections = { guides, troubleshooting, faqs }"],"additions":16,"deletions":1,"truncated":false},{"path":"apps/kb/src/content/faqs/auth/oidc-providers-supabase-project.mdx","lines":["@@ -0,0 +1,10 @@","+---","+title: Can I use OpenID Connect identity providers in Supabase projects?","+topics: ['Auth']","+---","+","+Yes. Any identity provider that supports OpenID Connect (OIDC) can be used as a third-party authentication provider alongside Supabase Auth, or standalone, with your Supabase project.","+","+For more details, refer to [Custom OIDC providers](https://supabase.com/docs/guides/auth/third-party/custom-oidc).","+","+Supabase also provides first-class support for specific [third-party authentication providers](https://supabase.com/docs/guides/auth/third-party/overview)."],"additions":10,"deletions":0,"truncated":false},{"path":"apps/kb/src/content/faqs/auth/oidc-providers-supported.mdx","lines":["@@ -0,0 +1,10 @@","+---","+title: Can I use a third-party authentication provider and Supabase Auth in the same project?","+topics: ['Auth']","+---","+","+Yes. You can use a third-party authentication provider alongside [Supabase Auth](https://supabase.com/docs/guides/auth), or on its own. Supabase Auth stays enabled in every project, but your users do not need to sign in with it.","+","+These third-party providers can then access Supabase features (like the [Data API (REST and GraphQL)](/docs/guides/database/overview), [Storage](/docs/guides/storage), [Realtime](/docs/guides/realtime) and [Edge functions](/docs/guides/functions)) from your existing apps.","+","+For more details how this affects pricing, refer to [Manage Monthly Active Third-Party Users usage](https://supabase.com/docs/guides/platform/manage-your-usage/monthly-active-users-third-party)."],"additions":10,"deletions":0,"truncated":false},{"path":"apps/kb/src/content/faqs/auth/supabase-auth-required-for-supabase.mdx","lines":["@@ -0,0 +1,10 @@","+---","+title: Do I have to move my users to Supabase Auth to use Supabase?","+topics: ['Auth']","+---","+","+No, you do not have to move your users to Supabase Auth to use Supabase.","+","+If you want to use Supabase features (like the [Data API (REST and GraphQL)](/docs/guides/database/overview), [Storage](/docs/guides/storage), [Realtime](/docs/guides/realtime) and [Edge Functions](/docs/guides/functions)), Supabase provides first-class support for several [third-party authentication providers](https://supabase.com/docs/guides/auth/third-party/overview), so your existing users can stay where they are. These providers (Clerk, Firebase Auth, WorkOS, etc.) can then access Supabase features from your existing apps. For details about how this affects pricing, refer to [Manage Monthly Active Third-Party Users usage](https://supabase.com/docs/guides/platform/manage-your-usage/monthly-active-users-third-party).","+","+You can also use Supabase as a standalone Postgres database, setting up your own authentication and authorization flows as needed."],"additions":10,"deletions":0,"truncated":false},{"path":"apps/kb/src/lib/cover-compositions.ts","lines":["@@ -76,6 +76,13 @@ const PLATFORM_LAYERS: IsoBox[] = [0, 1, 2].map((i) => ({","   fillFace: 'top',"," }))"," ","+const FAQ_BLOCKS: IsoBox[] = [","+  cube(0, 0, 0, 1),","+  cube(1.4, 0, 0, 1),","+  cube(0, 1.4, 0, 1),","+  cube(1.4, 1.4, 0, 1),","+]","+"," export const ISO_COMPOSITIONS: Record<Topic, IsoComposition> = {","   Auth: {","     titleAt: 'bottom',","@@ -159,6 +166,10 @@ export const ISO_COMPOSITIONS: Record<Topic, IsoComposition> = {","     nudgeY: 13,","     zoom: 0.645,","   },","+  FAQs: {","+    titleAt: 'top',","+    boxes: FAQ_BLOCKS,","+  },"," }"," "," export const FALLBACK_COMPOSITION: IsoComposition = { titleAt: 'top', boxes: [cube(0, 0, 0, 1)] }"],"additions":11,"deletions":0,"truncated":false},{"path":"apps/kb/src/lib/guides.ts","lines":["@@ -54,6 +54,15 @@ export const toSummary = (guide: CollectionEntry<'guides'>): GuideSummary => ({","   date: guide.data.date,"," })"," ","+// FAQ entries have no description in frontmatter.","+export const toFaqSummary = (faq: CollectionEntry<'faqs'>): GuideSummary => ({","+  id: faq.id,","+  title: faq.data.title,","+  description: '',","+  topics: faq.data.topics.filter((topic): topic is Topic => isKnownTopic(topic)),","+  href: `${import.meta.env.BASE_URL}/faqs/${faq.id}`,","+})","+"," export const toTroubleshootingSummary = (","   entry: CollectionEntry<'troubleshooting'>"," ): GuideSummary => ({"],"additions":9,"deletions":0,"truncated":false},{"path":"apps/kb/src/lib/hero-shapes.ts","lines":["@@ -3,6 +3,13 @@ import type { Topic } from './topics'"," "," const SHACKLE_LIFT = 2"," ","+const FAQ_BLOCKS: IsoBox[] = [","+  cube(0, 0, 0, 1),","+  cube(1.4, 0, 0, 1),","+  cube(0, 1.4, 0, 1),","+  cube(1.4, 1.4, 0, 1),","+]","+"," export const HERO_SHAPES: Record<Topic, IsoBox[]> = {","   Auth: [","     { x: 0, y: 0, z: 0, w: 0.8, d: 1.8, h: 1.3, inset: 'front' },","@@ -34,6 +41,7 @@ export const HERO_SHAPES: Record<Topic, IsoBox[]> = {","   ],","   Tutorials: [0, 1, 2].map((i) => ({ ...cube(0, -i * 1.4, i * 0.85, 1.1), h: 0.6 })),","   Platform: [0, 1, 2].map((i) => ({ x: 0, y: 0, z: i * 0.9, w: 2.2, d: 2.2, h: 0.18 })),","+  FAQs: FAQ_BLOCKS,"," }"," "," // a share of the shape's long side added on each edge, so a lone shape does not fill the flank."],"additions":8,"deletions":0,"truncated":false},{"path":"apps/kb/src/lib/topics.ts","lines":["@@ -83,11 +83,17 @@ export const TOPICS = [","     pinned: false,","     visible: true,","   },","+  {","+    name: 'FAQs',","+    description: 'Frequently asked questions and their answers.',","+    pinned: false,","+    visible: true,","+  },"," ] as const"," "," export type Topic = (typeof TOPICS)[number]['name']"," ","-type ContentCollection = 'guides' | 'troubleshooting'","+type ContentCollection = 'guides' | 'troubleshooting' | 'faqs'"," "," interface ListedTopicsParams {","   guides: { topics: readonly string[] }[]"],"additions":7,"deletions":1,"truncated":false},{"path":"apps/kb/src/pages/faqs/[...slug].astro","lines":["@@ -0,0 +1,54 @@","+---","+import { getCollection, render } from 'astro:content'","+import remarkParse from 'remark-parse'","+import { Admonition } from 'ui-patterns/Admonition'","+import { unified } from 'unified'","+import { visit } from 'unist-util-visit'","+","+import ArticleLayout from '../../layouts/ArticleLayout.astro'","+","+export async function getStaticPaths() {","+\tconst faqs = await getCollection('faqs')","+\treturn faqs.map((faq) => ({","+\t\tparams: { slug: faq.id },","+\t\tprops: { faq },","+\t}))","+}","+","+const { faq } = Astro.props","+const { title, topics } = faq.data","+const { Content } = await render(faq)","+","+// faq.filePath is relative to the kb app root, e.g. \"src/content/faqs/auth/foo.mdx\"","+const viewGitHubLink = `https://github.com/supabase/supabase/blob/master/apps/kb/${faq.filePath}`","+","+// Plain text of the answer's paragraphs and headings, for the schema below.","+const blocks: string[] = []","+visit(unified().use(remarkParse).parse(faq.body ?? ''), (node) => {","+\tif (node.type !== 'paragraph' && node.type !== 'heading') return","+\tlet text = ''","+\tvisit(node, (child) => {","+\t\tif (child.type === 'text' || child.type === 'inlineCode') text += child.value","+\t})","+\tif (text) blocks.push(text)","+})","+","+// https://schema.org/FAQPage for this page's single question. \"<\" is escaped so","+// the JSON can't close the script tag early.","+const faqPageJsonLd = JSON.stringify({","+\t'@context': 'https://schema.org',","+\t'@type': 'FAQPage',","+\tmainEntity: [","+\t\t{","+\t\t\t'@type': 'Question',","+\t\t\tname: title,","+\t\t\tacceptedAnswer: { '@type': 'Answer', text: blocks.join('\\n\\n') },","+\t\t},","+\t],","+}).replace(/</g, '\\\\u003c')","+---","+","+<ArticleLayout title={title} topics={topics} viewGitHubLink={viewGitHubLink}>","+\t<script type=\"application/ld+json\" set:html={faqPageJsonLd} />","+\t<Content components={{ Admonition }} />","+</ArticleLayout>"],"additions":54,"deletions":0,"truncated":false},{"path":"apps/kb/src/pages/topics/[topic].astro","lines":["@@ -5,13 +5,14 @@ import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList } from 'ui'"," import { GuideBrowser } from '../../components/GuideBrowser'"," import { TopicHero } from '../../components/Hero'"," import Layout from '../../layouts/Layout.astro'","-import { toSummary, toTroubleshootingSummary } from '../../lib/guides'","+import { toFaqSummary, toSummary, toTroubleshootingSummary } from '../../lib/guides'"," import { breadcrumbListSchema, canonicalUrl, KB_BASE_URL } from '../../lib/json-ld'"," import { isInTopic, TOPICS, topicToSlug } from '../../lib/topics'"," "," export async function getStaticPaths() {"," \tconst guides = (await getCollection('guides')).map(toSummary)"," \tconst troubleshooting = (awai