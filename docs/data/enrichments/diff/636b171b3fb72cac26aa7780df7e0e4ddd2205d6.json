dencies\": {","     \"@expo/internal-scripts\": \"workspace:*\",","     \"@types/jest\": \"^30.0.0\",","+    \"@types/node\": \"^22.14.0\",","     \"expo\": \"workspace:*\"","   },","   \"peerDependencies\": {","     \"expo\": \"*\",","     \"react\": \"*\",","     \"react-native\": \"*\"","-  },","-  \"jest\": {","-    \"preset\": \"@expo/internal-scripts\"","   }"," }"],"additions":17,"deletions":5,"truncated":false},{"path":"packages/expo-media-session/plugin/index.d.ts","lines":["@@ -0,0 +1 @@","+export { default } from './build';"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/plugin/index.js","lines":["@@ -0,0 +1 @@","+module.exports = require('./build');"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/plugin/jest.config.js","lines":["@@ -0,0 +1 @@","+module.exports = require('@expo/internal-scripts/jest-preset-plugin');"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/plugin/src/__tests__/withMediaSession-test.ts","lines":["@@ -0,0 +1,116 @@","+import { AndroidConfig, type InfoPlist } from 'expo/config-plugins';","+","+import { setBackgroundModes, setPlaybackService } from '../withMediaSession';","+","+const SERVICE = 'expo.modules.mediasession.service.MediaPlaybackService';","+const FGS = 'android.permission.FOREGROUND_SERVICE';","+const FGS_MEDIA = 'android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK';","+","+function manifest(): AndroidConfig.Manifest.AndroidManifest {","+  return {","+    manifest: {","+      $: { 'xmlns:android': 'http://schemas.android.com/apk/res/android' },","+      queries: [],","+      application: [{ $: { 'android:name': '.MainApplication' } }],","+    },","+  };","+}","+","+function services(androidManifest: AndroidConfig.Manifest.AndroidManifest) {","+  return (AndroidConfig.Manifest.getMainApplicationOrThrow(androidManifest).service ?? []).filter(","+    (service) => service.$['android:name'] === SERVICE","+  );","+}","+","+describe('setBackgroundModes', () => {","+  it('addsBackgroundModeWhenEnabled', () => {","+    expect(setBackgroundModes({}, { supportsBackgroundPlayback: true }).UIBackgroundModes).toEqual([","+      'audio',","+    ]);","+  });","+","+  it('doesNotAddBackgroundModeByDefault', () => {","+    expect(setBackgroundModes({}, {}).UIBackgroundModes).toBeUndefined();","+  });","+","+  it('neverRemovesExistingAudioBackgroundMode', () => {","+    const infoPlist: InfoPlist = { UIBackgroundModes: ['audio', 'fetch'] };","+    expect(","+      setBackgroundModes(infoPlist, { supportsBackgroundPlayback: false }).UIBackgroundModes","+    ).toEqual(['audio', 'fetch']);","+  });","+","+  it('replacesNonArrayBackgroundModes', () => {","+    const infoPlist = { UIBackgroundModes: 'audio' } as unknown as InfoPlist;","+    expect(","+      setBackgroundModes(infoPlist, { supportsBackgroundPlayback: true }).UIBackgroundModes","+    ).toEqual(['audio']);","+  });","+});","+","+describe('setPlaybackService', () => {","+  it('changesNothingByDefault', () => {","+    expect(setPlaybackService(manifest(), {})).toEqual(manifest());","+  });","+","+  it('fgsTypeAndPermissionsWhenBackgroundEnabled', () => {","+    const enabled = setPlaybackService(manifest(), { supportsBackgroundPlayback: true });","+    expect(AndroidConfig.Permissions.getPermissions(enabled)).toEqual([FGS, FGS_MEDIA]);","+    expect(services(enabled)).toEqual([","+      {","+        $: {","+          'android:name': SERVICE,","+          'android:exported': 'false',","+          'android:foregroundServiceType': 'mediaPlayback',","+        },","+      },","+    ]);","+  });","+","+  it('addsForegroundServiceTypeToExistingService', () => {","+    const androidManifest = manifest();","+    AndroidConfig.Manifest.getMainApplicationOrThrow(androidManifest).service = [","+      { $: { 'android:name': SERVICE, 'android:exported': 'false' } },","+    ];","+    const result = setPlaybackService(androidManifest, { supportsBackgroundPlayback: true });","+    expect(services(result)).toHaveLength(1);","+    expect(services(result)[0]?.$['android:foregroundServiceType']).toBe('mediaPlayback');","+  });","+","+  it('mergesForegroundServiceTypeWithExistingType', () => {","+    const androidManifest = manifest();","+    AndroidConfig.Manifest.getMainApplicationOrThrow(androidManifest).service = [","+      { $: { 'android:name': SERVICE, 'android:foregroundServiceType': 'dataSync' } },","+    ];","+    const result = setPlaybackService(androidManifest, { supportsBackgroundPlayback: true });","+    expect(services(result)[0]?.$['android:foregroundServiceType']).toBe('dataSync|mediaPlayback');","+  });","+","+  it('keepsExportedOnExistingService', () => {","+    const exported = manifest();","+    AndroidConfig.Manifest.getMainApplicationOrThrow(exported).service = [","+      { $: { 'android:name': SERVICE, 'android:exported': 'true' } },","+    ];","+    const result = setPlaybackService(exported, { supportsBackgroundPlayback: true });","+    expect(services(result)[0]?.$['android:exported']).toBe('true');","+  });","+","+  it('neverStripsForegroundServiceTypeOrPermissions', () => {","+    const result = setPlaybackService(","+      setPlaybackService(manifest(), { supportsBackgroundPlayback: true }),","+      { supportsBackgroundPlayback: false }","+    );","+    expect(services(result)[0]?.$['android:foregroundServiceType']).toBe('mediaPlayback');","+    expect(AndroidConfig.Permissions.getPermissions(result)).toEqual([FGS, FGS_MEDIA]);","+  });","+});","+","+it('isIdempotent', () => {","+  const props = { supportsBackgroundPlayback: true };","+  const infoPlist = setBackgroundModes(setBackgroundModes({}, props), props);","+  expect(infoPlist.UIBackgroundModes).toEqual(['audio']);","+","+  const result = setPlaybackService(setPlaybackService(manifest(), props), props);","+  expect(services(result)).toHaveLength(1);","+  expect(AndroidConfig.Permissions.getPermissions(result)).toEqual([FGS, FGS_MEDIA]);","+});"],"additions":116,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/plugin/src/index.ts","lines":["@@ -0,0 +1,3 @@","+import { Props } from './withMediaSession';","+","+export default (props: Props = {}): [string, Props] => ['expo-media-session', props];"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/plugin/src/withMediaSession.ts","lines":["@@ -0,0 +1,71 @@","+import {","+  AndroidConfig,","+  type ConfigPlugin,","+  type InfoPlist,","+  withAndroidManifest,","+  withInfoPlist,","+} from 'expo/config-plugins';","+","+const SERVICE_NAME = 'expo.modules.mediasession.service.MediaPlaybackService';","+","+export type Props = {","+  /**","+   * Whether to enable background playback support.","+   * @default false","+   */","+  supportsBackgroundPlayback?: boolean;","+};","+","+export function setBackgroundModes(","+  infoPlist: InfoPlist,","+  { supportsBackgroundPlayback = false }: Props","+): InfoPlist {","+  if (!supportsBackgroundPlayback) {","+    return infoPlist;","+  }","+  if (!Array.isArray(infoPlist.UIBackgroundModes)) {","+    infoPlist.UIBackgroundModes = [];","+  }","+  if (!infoPlist.UIBackgroundModes.includes('audio')) {","+    infoPlist.UIBackgroundModes.push('audio');","+  }","+  return infoPlist;","+}","+","+export function setPlaybackService(","+  androidManifest: AndroidConfig.Manifest.AndroidManifest,","+  { supportsBackgroundPlayback = false }: Props","+): AndroidConfig.Manifest.AndroidManifest {","+  if (!supportsBackgroundPlayback) {","+    return androidManifest;","+  }","+  const application = AndroidConfig.Manifest.getMainApplicationOrThrow(androidManifest);","+  application.service ??= [];","+  let service = application.service.find((it) => it.$['android:name'] === SERVICE_NAME);","+  if (!service) {","+    service = { $: { 'android:name': SERVICE_NAME, 'android:exported': 'false' } };","+    application.service.push(service);","+  }","+  const types = service.$['android:foregroundServiceType']?.split('|') ?? [];","+  if (!types.includes('mediaPlayback')) {","+    service.$['android:foregroundServiceType'] = [...types, 'mediaPlayback'].join('|');","+  }","+  AndroidConfig.Permissions.ensurePermissions(androidManifest, [","+    'android.permission.FOREGROUND_SERVICE',","+    'android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK',","+  ]);","+  return androidManifest;","+}","+","+export const withMediaSession: ConfigPlugin<Props | void> = (config, props) => {","+  config = withInfoPlist(config, (config) => {","+    config.modResults = setBackgroundModes(config.modResults, props ?? {});","+    return config;","+  });","+  return withAndroidManifest(config, (config) => {","+    config.modResults = setPlaybackService(config.modResults, props ?? {});","+    return config;","+  });","+};","+","+export default withMediaSession;"],"additions":71,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/plugin/tsconfig.json","lines":["@@ -0,0 +1,10 @@","+{","+  \"extends\": \"@expo/internal-scripts/tsconfig.plugin\",","+  \"compilerOptions\": {","+    \"composite\": true,","+    \"rootDir\": \"./src\",","+    \"noEmit\": true,","+    \"types\": [\"node\", \"jest\"]","+  },","+  \"include\": [\"./src\"]","+}"],"additions":10,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/tsconfig.all.json","lines":["@@ -0,0 +1,11 @@","+{","+  \"files\": [],","+  \"references\": [","+    {","+      \"path\": \"./tsconfig.json\"","+    },","+    {","+      \"path\": \"./plugin\"","+    }","+  ]","+}"],"additions":11,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/tsconfig.json","lines":["@@ -2,6 +2,7 @@"," {","   \"extends\": \"@expo/internal-scripts/tsconfig.base\",","   \"compilerOptions\": {","+    \"composite\": true,","     \"rootDir\": \"./src\",","     \"noEmit\": true","   },"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -5323,6 +5323,9 @@ importers:",