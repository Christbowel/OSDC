{"id":"a8c2a17846ffcf873a041e4aa90ba341f89dd916","axis":"silent","repo":"tannerlinsley/react-query","sha":"a8c2a17846ffcf873a041e4aa90ba341f89dd916","parsed":{"files":[{"path":".changeset/solid-svelte-query-devtools-production-entry.md","lines":["@@ -0,0 +1,6 @@","+---","+'@tanstack/solid-query-devtools': minor","+'@tanstack/svelte-query-devtools': minor","+---","+","+feat({solid,svelte}-query-devtools): add './production' entry to lazy load the devtools in production builds"],"additions":6,"deletions":0,"truncated":false},{"path":"docs/framework/solid/devtools.md","lines":["@@ -143,3 +143,52 @@ function App() {"," - `theme?: \"light\" | \"dark\" | \"system\"`","   - Defaults to the theme selected in the devtools Settings menu, or `system` if none is selected.","   - Set this to change the theme of the devtools panel. This overrides the theme selected in the Settings menu.","+","+## Devtools in production","+","+Devtools are excluded in production builds. However, it might be desirable to lazy load the devtools in production:","+","+```tsx","+import { createSignal, lazy, onMount, Show, Suspense } from 'solid-js'","+import { QueryClient, QueryClientProvider } from '@tanstack/solid-query'","+import { SolidQueryDevtools } from '@tanstack/solid-query-devtools'","+import { Example } from './Example'","+","+const queryClient = new QueryClient()","+","+const SolidQueryDevtoolsProduction = lazy(() =>","+  import('@tanstack/solid-query-devtools/production').then((d) => ({","+    default: d.SolidQueryDevtools,","+  })),","+)","+","+function App() {","+  const [showDevtools, setShowDevtools] = createSignal(false)","+","+  onMount(() => {","+    Object.assign(window, {","+      toggleDevtools: () => setShowDevtools((old) => !old),","+    })","+  })","+","+  return (","+    <QueryClientProvider client={queryClient}>","+      <Example />","+      <SolidQueryDevtools initialIsOpen />","+      <Show when={showDevtools()}>","+        <Suspense fallback={null}>","+          <SolidQueryDevtoolsProduction />","+        </Suspense>","+      </Show>","+    </QueryClientProvider>","+  )","+}","+","+export default App","+```","+","+With this, calling `window.toggleDevtools()` will download the devtools bundle and show them.","+","+`@tanstack/solid-query-devtools/production` also exports `SolidQueryDevtoolsPanel` for Embedded Mode.","+","+For TypeScript, you would need to set `moduleResolution` to `'bundler'`, `'node16'`, or `'nodenext'` in your tsconfig."],"additions":49,"deletions":0,"truncated":false},{"path":"docs/framework/svelte/devtools.md","lines":["@@ -41,6 +41,8 @@ You can import the devtools like this:"," import { SvelteQueryDevtools } from '@tanstack/svelte-query-devtools'"," ```"," ","+By default, Svelte Query Devtools are only rendered in development, using `DEV` from `esm-env`. In production, the devtools component renders nothing.","+"," ## Floating Mode"," "," Floating Mode will mount the devtools as a fixed, floating element in your app and provide a toggle in the corner of the screen to show and hide the devtools. This toggle state will be stored and remembered in localStorage across reloads.","@@ -85,3 +87,40 @@ Place the following code as high in your Svelte app as you can. The closer it is"," - `theme?: Theme`","   - Defaults to the theme selected in the devtools Settings menu, or `system` if none is selected.","   - Set this to change the theme of the devtools panel. This overrides the theme selected in the Settings menu.","+","+## Devtools in production","+","+Devtools are excluded in production builds. However, it might be desirable to lazy load the devtools in production:","+","+```svelte","+<script lang=\"ts\">","+  import { onMount } from 'svelte'","+  import { QueryClient, QueryClientProvider } from '@tanstack/svelte-query'","+  import { SvelteQueryDevtools } from '@tanstack/svelte-query-devtools'","+  import Example from './Example.svelte'","+","+  const queryClient = new QueryClient()","+","+  let showDevtools = $state(false)","+","+  onMount(() => {","+    Object.assign(window, {","+      toggleDevtools: () => (showDevtools = !showDevtools),","+    })","+  })","+</script>","+","+<QueryClientProvider client={queryClient}>","+  <Example />","+  <SvelteQueryDevtools initialIsOpen />","+  {#if showDevtools}","+    {#await import('@tanstack/svelte-query-devtools/production') then { SvelteQueryDevtools: SvelteQueryDevtoolsProduction }}","+      <SvelteQueryDevtoolsProduction />","+    {/await}","+  {/if}","+</QueryClientProvider>","+```","+","+With this, calling `window.toggleDevtools()` will download the devtools bundle and show them.","+","+For TypeScript, you would need to set `moduleResolution` to `'bundler'`, `'node16'`, or `'nodenext'` in your tsconfig."],"additions":39,"deletions":0,"truncated":false},{"path":"packages/solid-query-devtools/.attw.json","lines":["@@ -0,0 +1,3 @@","+{","+  \"ignoreRules\": [\"no-resolution\"]","+}"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/solid-query-devtools/package.json","lines":["@@ -37,23 +37,35 @@","   \"types\": \"./build/index.d.ts\",","   \"browser\": {},","   \"exports\": {","-    \"@tanstack/custom-condition\": \"./src/index.tsx\",","-    \"solid\": {","-      \"development\": \"./build/dev.jsx\",","-      \"import\": \"./build/index.jsx\"","-    },","-    \"development\": {","+    \".\": {","+      \"@tanstack/custom-condition\": \"./src/index.tsx\",","+      \"solid\": {","+        \"development\": \"./build/dev.jsx\",","+        \"import\": \"./build/index.jsx\"","+      },","+      \"development\": {","+        \"import\": {","+          \"types\": \"./build/index.d.ts\",","+          \"default\": \"./build/dev.js\"","+        },","+        \"require\": \"./build/dev.cjs\"","+      },","       \"import\": {","         \"types\": \"./build/index.d.ts\",","-        \"default\": \"./build/dev.js\"","+        \"default\": \"./build/index.js\"","       },","-      \"require\": \"./build/dev.cjs\"","+      \"require\