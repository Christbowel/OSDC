**","+     * A red picture with rectangles painted over it.","+     *","+     * @param  array<int, array{int, int, int, int}>  $rectangles  Left, top, right and bottom, keyed by colour","+     */","+    private function picture(int $width, int $height, array $rectangles = []): \\GdImage","+    {","+        $picture = imagecreatetruecolor(max(1, $width), max(1, $height));","+        $this->assertInstanceOf(\\GdImage::class, $picture);","+        foreach ([0xFF0000 => [0, 0, $width, $height]] + $rectangles as $color => [$left, $top, $right, $bottom]) {","+            imagefilledrectangle($picture, $left, $top, $right, $bottom, $color);","+        }","+","+        return $picture;","+    }","+","+    private function encode(\\GdImage $picture, string $type = 'png'): string","+    {","+        ob_start();","+        match ($type) {","+            'jpg' => imagejpeg($picture),","+            'gif' => imagegif($picture),","+            'avif' => imageavif($picture),","+            default => imagepng($picture),","+        };","+","+        return ob_get_clean() ?: '';","+    }","+","+    /**","+     * @param  non-empty-list<\\GdImage>  $frames","+     * @param  int  $delay  Of every frame, in hundredths of a second","+     */","+    private function animatedGif(array $frames, int $delay): string","+    {","+        $gif = 'GIF89a' . pack('vv', imagesx($frames[0]), imagesy($frames[0])) . \"\\0\\0\\0\";","+        foreach ($frames as $frame) {","+            // GD writes one picture after a global palette, which becomes the frame's own here.","+            $single = $this->encode($frame, 'gif');","+            $bits = \\ord($single[10]) & 7;","+            $descriptor = 13 + (6 << $bits);","+            $this->assertSame(',', $single[$descriptor]);","+            $gif .= \"!\\xf9\\x04\\x04\" . pack('v', $delay) . \"\\0\\0\"","+                . substr($single, $descriptor, 9) . \\chr(0x80 | $bits)","+                . substr($single, 13, 6 << $bits)","+                . substr($single, $descriptor + 10, -1);","+        }","+","+        return $gif . ';';","+    }","+","+    private function decode(string $data): \\GdImage","+    {","+        // GD does not read HEIC, so that is looked at through the PNG the class makes of it.","+        if ($this->format($data) === 'image/heic') {","+            $data = (new Image($data))->output('png') ?? '';","+        }","+        $picture = imagecreatefromstring($data);","+        $this->assertInstanceOf(\\GdImage::class, $picture);","+","+        return $picture;","+    }","+","+    private function format(string $data): string","+    {","+        if (substr($data, 4, 8) === 'ftypheic') {","+            return 'image/heic';","+        }","+        $size = getimagesizefromstring($data);","+","+        return $size === false ? '' : $size['mime'];","+    }","+","+    /**","+     * @return array{r: int, g: int, b: int, a: int} The alpha is GD's: 0 is opaque and 127 transparent","+     */","+    private function color(\\GdImage $picture, int $x, int $y): array","+    {","+        $color = imagecolorsforindex($picture, (int) imagecolorat($picture, $x, $y));","+","+        return ['r' => $color['red'], 'g' => $color['green'], 'b' => $color['blue'], 'a' => $color['alpha']];","+    }","+","+    private function littleEndian(string $bytes): int","+    {","+        return (int) hexdec(bin2hex(strrev($bytes)));","+    }","+","+    /**","+     * @return list<array{int, \\GdImage}> Each frame's delay in hundredths of a second, and its picture","+     */","+    private function frames(string $data): array","+    {","+        return $this->format($data) === 'image/gif' ? $this->gifFrames($data) : $this->webpFrames($data);","+    }","+","+    /**","+     * @return list<array{int, \\GdImage}>","+     */","+    private function gifFrames(string $gif): array","+    {","+        $flags = \\ord($gif[10]);","+        $head = substr($gif, 0, 13 + (($flags & 0x80) !== 0 ? 6 << ($flags & 7) : 0));","+        $frames = [];","+        $delay = 0;","+        for ($at = \\strlen($head); $gif[$at] !== ';';) {","+            $block = $at;","+            if ($gif[$at] === '!') {","+                if ($gif[$at + 1] === \"\\xf9\") {","+                    $delay = $this->littleEndian(substr($gif, $at + 4, 2));","+                }","+                $at += 2;","+            } else {","+                $flags = \\ord($gif[$at + 9]);","+                $at += 11 + (($flags & 0x80) !== 0 ? 6 << ($flags & 7) : 0);","+            }","+            while (($length = \\ord($gif[$at++])) !== 0) {","+                $at += $length;","+            }","+            if ($gif[$block] === ',') {","+                $frames[] = [$delay, $this->decode($head . substr($gif, $block, $at - $block) . ';')];","+            }","+        }","+","+        return $frames;","+    }","+","+    /**","+     * @return list<array{int, \\GdImage}>","+     */","+    private function webpFrames(string $webp): array","+    {","+        $frames = [];","+        for ($at = 12; $at < \\strlen($webp); $at += 8 + $size + ($size & 1)) {","+            $size = $this->littleEndian(substr($webp, $at + 4, 4));","+            if (substr($webp, $at, 4) !== 'ANMF') {","+                continue;","+            }","+            // A frame is its offset, size, delay and flags, then the chunks of a still picture.","+            $frame = substr($webp, $at + 8, $size);","+            $this->assertSame(0, $this->littleEndian(substr($frame, 0, 6)), 'The frame covers the canvas');","+            $still = \"VP8X\\x0a\\0\\0\\0\" . (substr($frame, 16, 4) === 'ALPH' ? \"\\x10\" : \"\\0\") . \"\\0\\0\\0\" . substr($frame, 6, 6) . substr($frame, 16);","+            $frames[] = [","+                intdiv($this->littleEndian(substr($frame, 12, 3)), 10),","+                $this->decode('RIFF' . pack('V', \\strlen($still) + 4) . 'WEBP' . $still),","+            ];","+        }","+","+        return $frames;","+    }","+","     private function jpegWithExif