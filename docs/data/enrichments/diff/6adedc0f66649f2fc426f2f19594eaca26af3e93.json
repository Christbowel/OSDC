{"id":"6adedc0f66649f2fc426f2f19594eaca26af3e93","axis":"silent","repo":"appwrite/appwrite","sha":"6adedc0f66649f2fc426f2f19594eaca26af3e93","parsed":{"files":[{"path":"Cargo.lock","lines":["@@ -1998,6 +1998,12 @@ version = \"1.2.0+spec-1.1.0\""," source = \"registry+https://github.com/rust-lang/crates.io-index\""," checksum = \"009dbb7700f11c55ef83aebbe4c0e9cf1f1ac0844bd8d6f00dc38f302026e13a\""," ","+[[package]]","+name = \"ttf-parser\"","+version = \"0.25.1\"","+source = \"registry+https://github.com/rust-lang/crates.io-index\"","+checksum = \"d2df906b07856748fa3f6e0ad0cbaa047052d4a7dd609e231c4f72cee8c36f31\"","+"," [[package]]"," name = \"typed-path\""," version = \"0.13.0\"","@@ -2086,7 +2092,9 @@ dependencies = [","  \"php-std\",","  \"png\",","  \"thiserror 2.0.21\",","+ \"ttf-parser\",","  \"webp\",","+ \"zeno\","," ]"," "," [[package]]","@@ -2241,6 +2249,12 @@ version = \"0.8.0\""," source = \"registry+https://github.com/rust-lang/crates.io-index\""," checksum = \"7a5a4b21e1a62b67a2970e6831bc091d7b87e119e7f9791aef9702e3bef04448\""," ","+[[package]]","+name = \"zeno\"","+version = \"0.3.3\"","+source = \"registry+https://github.com/rust-lang/crates.io-index\"","+checksum = \"6df3dc4292935e51816d896edcd52aa30bc297907c26167fec31e2b0c6a32524\"","+"," [[package]]"," name = \"zerocopy\""," version = \"0.8.63\""],"additions":14,"deletions":0,"truncated":false},{"path":"Dockerfile","lines":["@@ -144,6 +144,10 @@ RUN mkdir -p /etc/letsencrypt/live/ && chmod -Rf 755 /etc/letsencrypt/live/"," COPY --from=extension-build /usr/local/src/target/release/libutopia.so /usr/local/lib/php/utopia.so"," RUN echo 'extension=/usr/local/lib/php/utopia.so' > /usr/local/etc/php/conf.d/utopia.ini"," ","+# Nothing uses ImageMagick any more. Removed here until appwrite/base stops shipping it.","+RUN apk del --no-cache imagemagick imagemagick-heic && \\","+    rm /usr/local/etc/php/conf.d/docker-php-ext-imagick.ini \"$(php-config --extension-dir)/imagick.so\"","+"," FROM base AS production"," "," RUN rm -rf /usr/src/code/app/config/specs && \\"],"additions":4,"deletions":0,"truncated":false},{"path":"app/assets/fonts/inter-v8-latin-regular.ttf","lines":["Binary files /dev/null and b/app/assets/fonts/inter-v8-latin-regular.ttf differ"],"additions":0,"deletions":0,"truncated":false},{"path":"app/assets/fonts/inter-v8-latin-regular.woff2","lines":["Binary files a/app/assets/fonts/inter-v8-latin-regular.woff2 and /dev/null differ"],"additions":0,"deletions":0,"truncated":false},{"path":"composer.json","lines":["@@ -141,7 +141,6 @@","     \"require\": {","         \"php\": \">=8.5.0\",","         \"ext-curl\": \"*\",","-        \"ext-imagick\": \"*\",","         \"ext-mbstring\": \"*\",","         \"ext-json\": \"*\",","         \"ext-yaml\": \"*\","],"additions":0,"deletions":1,"truncated":false},{"path":"crates/extension/README.md","lines":["@@ -25,6 +25,11 @@ Over `crates/utopia/image`, with the signatures in `packages/image/stubs/Image.p"," `crates/extension/tests/image.php` runs without Composer; `packages/image/tests` is the"," full suite, and is skipped where the extension is not loaded."," ","+Beyond previews, the class draws what Appwrite used ImageMagick for: `Image::create()` makes a","+canvas, `path()` fills SVG path data and `text()` draws a line of text from a TrueType or OpenType","+file (no kerning or shaping), which is how the fallback and initials avatars are made.","+`Image::hasGlyph()` says whether a font draws a character.","+"," The extension turns on the crate's `libwebp` and `libheif` features, so it needs"," libheif's headers to build (`libheif-dev`) and the library at run time; libwebp is"," built from source. AVIF and HEIC follow the system's libheif, as they do for"],"additions":5,"deletions":0,"truncated":false},{"path":"crates/extension/src/image.rs","lines":["@@ -9,7 +9,7 @@ use ext_php_rs::exception::PhpException;"," use ext_php_rs::prelude::*;"," use ext_php_rs::types::ZendClassObject;"," use ext_php_rs::zend::{ClassEntry, ce};","-use utopia_image::{Error, FocalPoint, Gravity, OutputFormat, Resource, set_resource_limit};","+use utopia_image::{Error, FocalPoint, Gravity, OutputFormat, Resource, has_glyph, set_resource_limit};"," "," /// `Utopia\\Image\\Image`."," #[php_class]","@@ -31,6 +31,11 @@ fn size(value: i64, negative: &str) -> Result<u32, Error> {","     u32::try_from(value).map_err(|_| Error::InvalidArgument(negative.into()))"," }"," ","+/// The font file at `path`.","+fn font(path: &str) -> Result<Vec<u8>, Error> {","+    std::fs::read(path).map_err(|error| Error::InvalidArgument(format!(\"Can't read font {path}: {error}\")))","+}","+"," /// The `$type` of `output()` and `save()`."," fn format(kind: &str) -> Result<OutputFormat, Error> {","     kind.parse()","@@ -53,6 +58,63 @@ impl Image {","         utopia_image::Image::new(&data).map(Self).map_err(thrown)","     }"," ","+    /// `create(int $width, int $height, string $background = ''): static`: one colour, PNG by default.","+    #[php(defaults(background = \"\\\"\\\"\"))]","+    pub fn create(width: i64, height: i64, background: String) -> PhpResult<Self> {","+        let negative = \"Width and height must not be negative\";","+        let blank = size(width, negative)","+            .and_then(|width| Ok((width, size(height, negative)?)))","+            .and_then(|(width, height)| utopia_image::Image::blank(width, height, &background));","+        blank.map(Self).map_err(thrown)","+    }","+","+    /// `hasGlyph(string $font, string $character): bool`: whether the font file draws the character.","+    pub fn has_glyph(font: String, character: String) -> PhpResult<bool> {","+        let mut characters = character.chars();","+        let (Some(character), None) = (characters.next(), characters.next()) else {","+            return Err(thrown(Error::InvalidArgument(\"Expected one character\".into())));","+        };","+        self::font(&font).and_then(|font| has_glyph(&font, character)).map_err(thrown)","+    }","+","+    /// `getWidth(): int`: the decoded width, then the last crop's.","+    pub fn get_width(&self) -> i64 {","+        self.0.width()","+    }","+","+    /// `getHeight(): int`.","+    pub fn get_height(&self) -> i64 {","+        self.0.height()","+    }","+","+    /// `getOrientation(): int`: the EXIF orientation of the source, 1 to 8.","+    pub fn get_orientation(&self) -> i64 {","+        i64::from(self.0.orientation())","+    }","+","+    /// `path(string $path, string $color, float $x = 0, float $y = 0, float $scale = 1): static`:","+    /// fills SVG path data.","+    #[php(defaults(x = 0.0, y = 0.0, scale = 1.0))]","+    pub fn path<'a>(self_: This<'a>, path: String, color: String, x: f64, y: f64, scale: f64) -> PhpResult<This<'a>> {","+        let drawn = self_.0.fill_path(&path, &color, x, y, scale).map(|_| ());","+        drawn.map(|()| self_).map_err(thrown)","+    }","+","+    /// `text(string $text, string $font, float $size, string $color, float $x, float $y): static`:","+    /// centred on `$x`, baseline at `$y`.","+    pub fn text<'a>(","+        self_: This<'a>,","+        text: String,","+        font: String,","+        size: f64,","+        color: String,","+        x: f64,","+        y: f64,","+    ) -> PhpResult<This<'a>> {","+        let drawn = self::font(&font).and_then(|font| self_.0.draw_text(&text, &font, size, &color, x, y).map(|_| ()));","+        drawn.map(|()| self_).map_err(thrown)","+    }","+","     /// `getGravityTypes(): array`.","     pub fn get_gravity_types() -> Vec<&'static str> {","         Gravity::ALL.map(Gravity::name).to_vec()"],"additions":63,"deletions":1,"truncated":false},{"path":"crates/extension/tests/image.php","lines":["@@ -79,6 +79,17 @@ function thrown(callable $call): string"," check('unknown gravity is a centred focal point', $unknown === (new Image(png(16, 8)))->crop(6, 4, x: 0.5, y: 0.5)->output('png'));"," check('argument type', str_starts_with(thrown(fn () => $image->crop('wide', 2)), 'TypeError: '));"," ","+$font = __DIR__ . '/../../../app/assets/fonts/inter-v8-latin-regular.ttf';","+$drawn = Image::create(32, 16, '#000000');","+check('create size', [$drawn->getWidth(), $drawn->getHeight(), $drawn->getOrientation()] === [32, 16, 1]);","+check('path and text chain', $drawn->path('M0 0h4v4h-4Z', '#ffffff', 2, 2, 2) === $drawn && $drawn->text('A', $font, 12, '#ffffff', 16, 12) === $drawn);","+check('drawn png size', array_slice(getimagesizefromstring($drawn->output('png')), 0, 2) === [32, 16]);","+check('glyphs', Image::hasGlyph($font, 'A') && ! Image::hasGlyph($font, '山'));","+check('more than one character', thrown(fn () => Image::hasGlyph($font, 'AB')) === 'InvalidArgumentException: Expected one character');","+check('invalid path', thrown(fn () => $drawn->path('M0 0 Q bogus', '#fff')) === 'InvalidArgumentException: Invalid path at offset 7');","+check('missing font', str_starts_with(thrown(fn () => $drawn->text('A', '/no/such/font.ttf', 12, '#fff', 0, 0)), \"InvalidArgumentException: Can't read font /no/such/font.ttf\"));","+check('empty canvas', thrown(fn () => Image::create(0, 4)) === 'InvalidArgumentException: Width and height must be positive');","+"," Image::setResourceLimit('memory', 64 * 1024 * 1024);"," Image::setResourceLimit('unknown', 1);"," "],"additions":11,"deletions":0,"truncated":false},{"path":"crates/utopia/image/Cargo.toml","lines":["@@ -30,7 +30,9 @@ libheif-rs = { workspace = true, optional = true }"," php-std.workspace = true"," png.workspace = true"," thiserror.workspace = true","+ttf-parser = \"0.25\""," webp = { workspace = true, optional = true }","+zeno = \"0.3\""," "," [package.metadata.utopia]"," category = \"utilities\""],"additions":2,"deletions":0,"truncated":false},{"path":"crates/utopia/image/src/draw.rs","lines":["@@ -0,0 +1,176 @@","+//! Filled paths and text, drawn onto an image's current frame.","+","+use image::RgbaImage;","+use ttf_parser::{Face, OutlineBuilder};","+use zeno::{Command, Fill, Mask, PathData, Transform, Vector};","+","+use crate::color::Color;","+use crate::error::{Error, Result};","+","+/// Fills `path` (SVG path data, or commands), transformed, with `color`,","+/// anti-aliased and composited over what is there.","+pub(crate) fn fill(pixels: &mut RgbaImage, path: impl PathData, transform: Transform, color: Color) {","+    let (mask, placement) = Mask::new(path).style(Fill::NonZero).transform(Some(transform)).render();","+    let [red, green, blue, alpha] = color.0.map(f32::from);","+    for (index, coverage) in mask.iter().enumerate().filter(|(_, coverage)| **coverage > 0) {","+        let x = i64::from(placement.left) + (index as u32 % placement.width) as i64;","+        let y = i64::from(placement.top) + (index as u32 / placement.width) as i64;","+        if x < 0 || y < 0 || x >= i64::from(pixels.width()) || y >= i64::from(pixels.height()) {","+            continue;","+        }","+        // Source-over on straight alpha.","+        let pixel = pixels.get_pixel_mut(x as u32, y as u32);","+        let source = f32::from(*coverage) / 255.0 * alpha / 255.0;","+        let under = f32::from(pixel.0[3]) / 255.0 * (1.0 - source);","+        let out = source + under;","+        for (channel, value) in [red, green, blue].into_iter().enumerate() {","+            pixel.0[channel] = ((value * source + f32::from(pixel.0[channel]) * under) / out).round() as u8;","+        }","+        pixel.0[3] = (out * 255.0).round() as u8;","+    }","+}","+","+/// Fails unless `path` is SVG path data.","+pub(crate) fn validate(path: &str) -> Result<()> {","+    zeno::validate_svg(path).map_err(|at| Error::InvalidArgument(format!(\"Invalid path at offset {at}\")))","+}","+","+fn face(font: &[u8]) -> Result<Face<'_>> {","+    Face::parse(font, 0).map_err(|error| Error::InvalidArgument(format!(\"Invalid font: {error}\")))","+}","+","+/// A glyph's outline as path commands, in font units with y up.","+#[derive(Default)]","+struct Outline(Vec<Command>);","+","+impl OutlineBuilder for Outline {","+    fn move_to(&mut self, x: f32, y: f32) {","+        self.0.push(Command::MoveTo(Vector::new(x, y)));","+    }","+","+    fn line_to(&mut self, x: f32, y: f32) {","+        self.0.push(Command::LineTo(Vector::new(x, y)));","+    }","+","+    fn quad_to(&mut self, x1: f32, y1: f32, x: f32, y: f32) {","+        self.0.push(Command::QuadTo(Vector::new(x1, y1), Vector::new(x, y)));","+    }","+","+    fn curve_to(&mut self, x1: f32, y1: f32, x2: f32, y2: f32, x: f32, y: f32) {","+        self.0.push(Command::CurveTo(Vector::new(x1, y1), Vector::new(x2, y2), Vector::new(x, y)));","+    }","+","+    fn close(&mut self) {","+        self.0.push(Command::Close);","+    }","+}","+","+/// Whether `font` (TrueType or OpenType data) draws something for `character`:","+/// a missing glyph, or one with no outline, draws nothing.","+pub fn has_glyph(font: &[u8], character: char) -> Result<bool> {","+    let face = face(font)?;","+    Ok(face.glyph_index(character).is_some_and(|glyph| face.outline_glyph(glyph, &mut Outline::default()).is_some()))","+}","+","+/// Draws `text` in `font` at `size` pixels an em, centred on `x` with its","+/// baseline at `y`. Glyphs are placed by their advances, without kerning or","+/// shaping; a character the font has no glyph for takes no space.","+pub(crate) fn text(","+    pixels: &mut RgbaImage,","+    text: &str,","+    font: &[u8],","+    size: f32,","+    color: Color,","+    x: f32,","+    y: f32,","+) -> Result<()> {","+    let face = face(font)?;","+    let scale = size / f32::from(face.units_per_em());","+    let glyphs: Vec<_> = text.chars().filter_map(|character| face.glyph_index(character)).collect();","+    let advance = |glyph| f32::from(face.glyph_hor_advance(glyph).unwrap_or(0)) * scale;","+    let mut pen = x - glyphs.iter().map(|glyph| advance(*glyph)).sum::<f32>() / 2.0;","+    for glyph in glyphs {","+        let mut outline = Outline::default();","+        if face.outline_glyph(glyph, &mut outline).is_some() {","+            fill(pixels, &outline.0, Transform::scale(scale, -scale).then_translate(pen, y), color);","+        }","+        pen += advance(glyph);","+    }","+    Ok(())","+}","+","+#[cfg(test)]","+mod tests {","+    use image::Rgba;","+","+    use super::*;","+","+    const FONT: &[u8] = include_bytes!(\"../../../../app/assets/fonts/inter-v8-latin-regular.ttf\");","+","+    fn canvas() -> RgbaImage {","+        RgbaImage::from_pixel(40, 40, Rgba([0, 0, 255, 255]))","+    }","+","+    #[test]","+    fn a_path_is_scaled_then_moved() {","+        let mut pixels = canvas();","+        fill(","+            &mut pixels,","+            \"M0 0h5v5h-5Z\",","+            Transform::scale(2.0, 2.0).then_translate(10.0, 20.0),","+            Color::rgba(255, 0, 0, 255),","+        );","+        assert_eq!(pixels.get_pixel(15, 25).0, [255, 0, 0, 255]);","+        assert_eq!(pixels.get_pixel(9, 25).0, [0, 0, 255, 255]);","+        assert_eq!(pixels.get_pixel(20, 25).0, [0, 0, 255, 255]);","+        assert_eq!(pixels.get_pixel(15, 30).0, [0, 0, 255, 255]);","+    }","+","+    #[test]","+    fn a_translucent_fill_blends_and_what_falls_outside_is_dropped() {","+        let mut pixels = canvas();","+        fill(&mut pixels, \"M-10 -10h20v20h-20Z\", Transform::IDENTITY, Color::rgba(255, 0, 0, 128));","+        assert_eq!(pixels.get_pixel(5, 5).0, [128, 0, 127, 255]);","+        assert_eq!(pixels.get_pixel(15, 15).0, [0, 0, 255, 255]);","+    }","+","+    #[test]","+    fn a_fill_on_a_transparent_pixel_keeps_its_own_colour() {","+        let mut pixels = RgbaImage::new(4, 4);","+        fill(&mut pixels, \"M0 0h4v4h-4Z\", Transform::IDENTITY, Color::rgba(10, 20, 30, 128));","+        assert_eq!(pixels.get_pixel(1, 1).0, [10, 20, 30, 128]);","+    }","+","+    #[test]","+    fn path_data_is_validated() {","+        assert!(validate(\"M7.5 6a4.5 4.5 0 1 1 9 0a4.5 4.5 0 0 1-9 0Z\").is_ok());","+        assert!(matches!(validate(\"M0 0 Q bogus\"), Err(Error::InvalidArgument(_))));","+    }","+","+    #[test]","+    fn a_glyph_needs_an_outline() {","+        assert!(has_glyph(FONT, 'A').unwrap());","+        assert!(!has_glyph(FONT, ' ').unwrap());","+        assert!(!has_glyph(FONT, '山').unwrap());","+        assert!(matches!(has_glyph(b\"not a font\", 'A'), Err(Error::InvalidArgument(_))));","+    }","+","+    #[test]","+    fn text_is_centred_on_x_above_the_baseline() {","+        let mut pixels = canvas();","+        text(&mut pixels, \"II\", FONT, 20.0, Color::WHITE, 20.0, 30.0).unwrap();","+        let drawn: Vec<(u32, u32)> = pixels","+            .enumerate_pixels()","+            .filter(|(_, _, pixel)| pixel.0 != [0, 0, 255, 255])","+            .map(|(x, y, _)| (x, y))","+            .collect();","+        assert!(!drawn.is_empty());","+        let (left, right) = (drawn.iter().map(|p| p.0).min().unwrap(), drawn.iter().map(|p| p.0).max().unwrap());","+        assert!((i64::from(left) + i64::from(right) - 40).abs() <= 2, \"{left}..{right} is not centred on 20\");","+        assert!(drawn.iter().all(|p| p.1 <= 30), \"nothing of a capital I is below the baseline\");","+        // A character without a glyph draws nothing and takes no space.","+        let mut same = canvas();","+        text(&mut same, \"I山I\", FONT, 20.0, Color::WHITE, 20.0, 30.0).unwrap();","+        assert_eq!(pixels, same);","+    }","+}"],"additions":176,"deletions":0,"truncated":false},{"path":"crates/utopia/image/src/image.rs","lines":["@@ -7,6 +7,7 @@ use php_std::value::Number;"," "," use crate::color::Color;"," use crate::decode;","+use crate::draw;"," use crate::encode;"," use crate::error::{Error, Result};"," use crate::frame::{Format, Frame};","@@ -55,6 +56,7 @@ pub struct Image {","     border_width: u32,","     border_color: String,","     rotation: i32,","+    orientation: u32,","     wand_quality: Option<i64>,"," }"," ","@@ -84,10 +86,12 @@ impl Image {","         let frames = decode::decode(data, format)?;","         // An AVIF or HEIC decodes already rotated as the file says.","         let oriented = matches!(format, Format::Avif | Format::Heic);","-        let rotation = match decode::orientation(data).filter(|_| !oriented) {","-            Some(3) => 180,","-            Some(6) => 90,","-            Some(8) => -90,","+        let orientation = decode::orientation(data).unwrap_or(1);","+        let rotation = match orientation {","+            _ if oriented => 0,","+            3 => 180,","+            6 => 90,","+            8 => -90,","             _ => 0,","         };","         let (width, height) = (i64::from(frames[0].width()), i64::from(frames[0].height()));","@@ -99,10 +103,72 @@ impl Image {","             border_width: 0,","             border_color: String::new(),","             rotation,","+            orientation,","             wand_quality: None,","         })","     }"," ","+    /// A `width` x `height` image of one colour, written as PNG unless another","+    /// format is asked for.","+    ///","+    /// PHP: `Image::create($width, $height, $background)`.","+    ///","+    /// ```","+    /// use utopia_image::{Image, OutputFormat};","+    ///","+    /// let mut image = Image::blank(64, 64, \"#e5e5e5\")?;","+    /// image.fill_path(\"M0 0h10v10h-10Z\", \"#333333\", 27.0, 27.0, 1.0)?;","+    /// assert_eq!(&image.output(OutputFormat::Png, 75)?[1..4], b\"PNG\");","+    /// # Ok::<(), utopia_image::Error>(())","+    /// ```","+    pub fn blank(width: u32, height: u32, background: &str) -> Result<Image> {","+        if width == 0 || height == 0 {","+            return Err(Error::InvalidArgument(\"Width and height must be positive\".into()));","+        }","+        crate::options::check_dimensions(u64::from(width), u64::from(height))?;","+        let color = Color::parse(background)?;","+        let pixels = image::RgbaImage::from_pixel(width, height, image::Rgba(color.0));","+        Ok(Image {","+            frames: vec![Frame::new(pixels, color.has_alpha(), 0, Format::Png)],","+            current: 0,","+            width: i64::from(width),","+            height: i64::from(height),","+            border_width: 0,","+            border_color: String::new(),","+            rotation: 0,","+            orientation: 1,","+            wand_quality: None,","+        })","+    }","+","+    /// The EXIF orientation the image was read with (1 to 8; 1 when it had none).","+    ///","+    /// PHP: `getOrientation()`.","+    pub fn orientation(&self) -> u32 {","+        self.orientation","+    }","+","+    /// Fills SVG path data with `color` on the current frame, scaled by `scale`","+    /// and then moved by `x` and `y`.","+    ///","+    /// PHP: `path($path, $color, $x, $y, $scale)`.","+    pub fn fill_path(&mut self, path: &str, color: &str, x: f64, y: f64, scale: f64) -> Result<&mut Self> {","+        draw::validate(path)?;","+        let transform = zeno::Transform::scale(scale as f32, scale as f32).then_translate(x as f32, y as f32);","+        draw::fill(&mut self.frames[self.current].pixels, path, transform, Color::parse(color)?);","+        Ok(self)","+    }","+","+    /// Draws `text` on the current frame in `font` (TrueType or OpenType data)","+    /// at `size` pixels an em, centred on `x` with its baseline at `y`.","+    ///","+    /// PHP: `text($text, $font, $size, $color, $x, $y)`, where `$font` is a path.","+    pub fn draw_text(&mut self, text: &str, font: &[u8], size: f64, color: &str, x: f64, y: f64) -> Result<&mut Self> {","+        let color = Color::parse(color)?;","+        draw::text(&mut self.frames[self.current].pixels, text, font, size as f32, color, x as f32, y as f32)?;","+        Ok(self)","+    }","+","     /// The width the operations work from: the decoded width, then the last","     /// crop's (borders and rotations do not change it, as in PHP).","     pub fn width(&self) -> i64 {"],"additions":70,"deletions":4,"truncated":false},{"path":"crates/utopia/image/src/lib.rs","lines":["@@ -62,6 +62,7 @@"," "," mod color;"," mod decode;","+mod draw;","