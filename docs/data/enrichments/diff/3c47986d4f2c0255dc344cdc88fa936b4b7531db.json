ptyWithoutNonceSupport()","+    {","+        // security.default.json sets csp.nonce = false","+        $this->enableReportOnly();","+        Security::applyHeader(true);","+","+        $this->assertStringStartsWith(","+            \"script-src  'self';\",","+            Yii::$app->response->headers->get(SecuritySettings::HEADER_CONTENT_SECRUITY_POLICY_REPORT_ONLY),","+        );","+    }","+","+    public function testEnabledReplacesLegacyReportOnlySection()","+    {","+        $this->setConfigFile('security.reportonly2.json');","+        $this->enableReportOnly();","+        Security::applyHeader(true);","+","+        $values = Yii::$app->response->headers->get(SecuritySettings::HEADER_CONTENT_SECRUITY_POLICY_REPORT_ONLY, null, false);","+        $this->assertCount(1, $values);","+        $this->assertStringContainsString('report-to csp-report-only-endpoint', $values[0]);","+    }","+","+    public function testLegacyReportOnlySectionUnchangedWhenDisabled()","+    {","+        $this->setConfigFile('security.reportonly2.json');","+        Security::applyHeader(true);","+","+        $values = Yii::$app->response->headers->get(SecuritySettings::HEADER_CONTENT_SECRUITY_POLICY_REPORT_ONLY, null, false);","+        $this->assertCount(1, $values);","+        $this->assertStringContainsString('report-uri ' . SecuritySettings::getReportUrl(true), $values[0]);","+        $this->assertStringNotContainsString('report-to', $values[0]);","+        $this->assertNull(Yii::$app->response->headers->get(SecuritySettings::HEADER_REPORTING_ENDPOINTS));","+    }","+","+    public function testReportingPlaceholderInEnforcedHeader()","+    {","+        $this->setConfigFile('security.headers-reporting.json');"],"additions":106,"deletions":0,"truncated":false}],"additions":648,"deletions":18,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-21T13:29:07.566658+00:00"}