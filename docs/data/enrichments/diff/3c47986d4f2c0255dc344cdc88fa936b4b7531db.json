{"id":"3c47986d4f2c0255dc344cdc88fa936b4b7531db","axis":"silent","repo":"humhub/humhub","sha":"3c47986d4f2c0255dc344cdc88fa936b4b7531db","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -3,6 +3,7 @@ HumHub Changelog"," "," 1.19.1 (Unreleased)"," -------------------","+- Enh #8612: Optional `Content-Security-Policy-Report-Only` header (`web.enableCspReportOnly`) to test a stricter policy; violations are logged as warnings, also reports from guests"," - Fix #8607: The two-step login picked a random user when the entered login was one user's username and another user's email"," - Fix #8594: Images in emails already sent (mail header, logo, profile images) broke whenever the published assets were removed, e.g. by the cache flush after every update; absolute `AssetImage` URLs now point to a controller that republishes the image and redirects to it"," - Fix #8605: Users of a user source other than \"local\" could not log in with their password although their source allowed the Password client; a source allowing it also blocked the password login of local users"],"additions":1,"deletions":0,"truncated":false},{"path":"protected/humhub/modules/web/Module.php","lines":["@@ -37,6 +37,21 @@ class Module extends \\humhub\\components\\Module","      */","     public $enableServiceWorker = true;"," ","+    /**","+     * @var bool sends a Content-Security-Policy-Report-Only header with the policy of [[cspReportOnly]],","+     * to see which resources a stricter policy would block before enforcing it","+     * @since 1.19.1","+     */","+    public $enableCspReportOnly = false;","+","+    /**","+     * @var string policy of the Content-Security-Policy-Report-Only header, sent when [[enableCspReportOnly]] is set.","+     * `{{ nonce }}` is replaced with the script nonce of the session, `{{ reporting }}` with the","+     * `report-uri` and `report-to` directives pointing to the report endpoint.","+     * @since 1.19.1","+     */","+    public $cspReportOnly = \"script-src {{ nonce }} 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; {{ reporting }}\";","+","     /**","      * @inheritdoc","      */"],"additions":15,"deletions":0,"truncated":false},{"path":"protected/humhub/modules/web/security/controllers/ReportController.php","lines":["@@ -2,12 +2,21 @@"," "," namespace humhub\\modules\\web\\security\\controllers;"," ","+use humhub\\components\\access\\ControllerAccess;"," use humhub\\components\\Controller;","+use humhub\\modules\\web\\security\\helpers\\CspReport;"," use humhub\\modules\\web\\security\\models\\SecuritySettings;"," use Yii;"," "," class ReportController extends Controller"," {","+    /**","+     * Reports are sent by the browser without a session, independently of the guest mode setting.","+     *","+     * @inheritdoc","+     */","+    protected $access = ControllerAccess::class;","+","     public function init()","     {","         $this->enableCsrfValidation = false;","@@ -21,11 +30,8 @@ public function actionIndex()","             return;","         }"," ","-        $json_data = file_get_contents('php://input');","-        if ($json_data = json_decode($json_data)) {","-            $json_data = json_encode($json_data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);","-            $json_data = preg_replace('/\\'nonce-[^\\']*\\'/', \"'nonce-xxxxxxxxxxxxxxxxxxxxxxxx'\", $json_data);","-            Yii::error($json_data, 'web.security');","+        foreach (CspReport::parse(Yii::$app->request->getRawBody(), Yii::$app->request->get('disposition') === 'report') as $report) {","+            $report->log();","         }","     }"," "],"additions":11,"deletions":5,"truncated":false},{"path":"protected/humhub/modules/web/security/helpers/CspReport.php","lines":["@@ -0,0 +1,147 @@","+<?php","+","+/**","+ * @link https://www.humhub.org/","+ * @copyright Copyright (c) HumHub GmbH & Co. KG","+ * @license https://www.humhub.com/licences","+ */","+","+namespace humhub\\modules\\web\\security\\helpers;","+","+use Yii;","+use yii\\base\\InvalidArgumentException;","+use yii\\helpers\\Json;","+","+/**","+ * A single Content Security Policy violation report, as posted by the browser to the report endpoint.","+ *","+ * Browsers use two formats: the `report-uri` format (`application/csp-report`) holds one report under the","+ * key `csp-report`, the Reporting API format (`application/reports+json`) a list of reports of different","+ * types, of which only `csp-violation` entries are used.","+ *","+ * @since 1.19.1","+ */","+class CspReport","+{","+    /**","+     * Larger request bodies are discarded completely.","+     */","+    public const MAX_BODY_SIZE = 65536;","+","+    public const LOG_CATEGORY = 'web.security';","+","+    private function __construct(private readonly array $report, private readonly bool $reportOnly = false)","+    {","+    }","+","+    /**","+     * @param bool $reportOnly whether the reports were sent to the Report-Only URL (disposition=report); they then","+     * count as Report-Only regardless of their disposition field","+     * @return self[] the CSP violation reports contained in the request body, empty if it holds none","+     */","+    public static function parse(string $body, bool $reportOnly = false): array","+    {","+        if ($body === '' || strlen($body) > self::MAX_BODY_SIZE) {","+            return [];","+        }","+","+        try {","+            $data = Json::decode($body);","+        } catch (InvalidArgumentException) {","+            return [];","+        }","+","+        if (!is_array($data)) {","+            return [];","+        }","+","+        // Reporting API: a list of reports of different types","+        if (array_is_list($data)) {","+            $reports = [];","+            foreach ($data as $entry) {","+                if (is_array($entry) && ($entry['type'] ?? null) === 'csp-violation' && is_array($entry['body'] ?? null)) {","+                    $reports[] = new self($entry['body'], $reportOnly);","+                }","+            }","+","+            return $reports;","+        }","+","+        // report-uri: a single report","+        if (is_array($data['csp-report'] ?? null)) {","+            return [new self($data['csp-report'], $reportOnly)];","+        }","+","+        return [];","+    }","+","+    /**","+     * The Report-Only URL decides first; otherwise a report without a disposition counts as enforced, so a real","+     * violation is never logged as a warning.","+     */","+    public function isReportOnly(): bool","+    {","+        return $this->reportOnly || ($this->report['disposition'] ?? null) === 'report';","+    }","+","+    /**","+     * @return string one line naming the directive, the blocked resource and the source file, e.g.","+     * `CSP violation (report-only): script-src-elem https://example.org/x.js in https://example.com/dashboard`","+     */","+    public function getSummary(): string","+    {","+        $directive = $this->field('effective-directive', 'effectiveDirective')","+            ?? $this->field('violated-directive', 'violatedDirective')","+            ?? 'unknown directive';","+","+        $summary = 'CSP violation (' . ($this->isReportOnly() ? 'report-only' : 'enforced') . '): ' . $directive;","+","+        $blocked = $this->field('blocked-uri', 'blockedURL');","+        if ($blocked !== null) {","+            $summary .= ' ' . $blocked;","+        }","+","+        $source = $this->field('source-file', 'sourceFile');","+        if ($source !== null) {","+            $summary .= ' in ' . $source;","+        }","+","+        return $summary;","+    }","+","+    /**","+     * Logs the summary and the full report, as warning for a Report-Only violation and as error otherwise.","+     */","+    public function log(): void","+    {","+        $message = $this->getSummary() . \"\\n\"","+            . json_encode($this->report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);","+","+        // The report quotes the policy, and with it the nonce of the reporting session","+        $message = preg_replace('/\\'nonce-[^\\']*\\'/', \"'nonce-xxxxxxxxxxxxxxxxxxxxxxxx'\", $message);","+","+        if ($this->isReportOnly()) {","+            Yii::warning($message, self::LOG_CATEGORY);","+        } else {","+            Yii::error($message, self::LOG_CATEGORY);","+        }","+    }","+","+    /**","+     * @return string|null the first non-empty string value of the given keys, without control characters","+     */","+    private function field(string ...$names): ?string","+    {","+        foreach ($names as $name) {","+            $value = $this->report[$name] ?? null;","+            if (is_string($value)) {","+                $value = preg_replace('/[\\x00-\\x1F\\x7F]/', '', $value);","+                if ($value !== '') {","+                    return $value;","+                }","+            }","+        }","+","+        return null;","+    }","+}"],"additions":147,"deletions":0,"truncated":false},{"path":"protected/humhub/modules/web/security/helpers/Security.php","lines":["@@ -34,13 +34,22 @@ public static function applyHeader($withCsp = false)","                 static::setHeader($key, $header);","             }"," ","-            if ($settings->hasSection(SecuritySettings::CSP_SECTION_REPORT_ONLY)) {","+            $reportOnlyHeader = $settings->getReportOnlyHeader();","+            if ($reportOnlyHeader !== null) {","+                // Replaces a legacy `csp-report-only` section, so violations are not reported twice","+                static::setHeader(SecuritySettings::HEADER_CONTENT_SECRUITY_POLICY_REPORT_ONLY, $reportOnlyHeader);","+            } elseif ($settings->hasSection(SecuritySettings::CSP_SECTION_REPORT_ONLY)) {","                 $reportOnlySettings = new SecuritySettings(['cspSection' => SecuritySettings::CSP_SECTION_REPORT_ONLY]);","                 $header = $reportOnlySettings->getHeader(SecuritySettings::HEADER_CONTENT_SECRUITY_POLICY_REPORT_ONLY);","                 foreach ($reportOnlySettings->getCSPHeaderKeys() as $key) {","                     static::setHeader($key, $header);","                 }","             }","+","+            $reportingEndpoints = $settings->getReportingEndpointsHeader();","+            if ($reportingEndpoints !== null) {","+                static::setHeader(SecuritySettings::HEADER_REPORTING_ENDPOINTS, $reportingEndpoints);","+            }","         }"," ","         /*if (!empty($_SERVER['HTTPS']) && strtolower($_SERVER['HTTPS']) !== 'off') {"],"additions":10,"deletions":1,"truncated":false},{"path":"protected/humhub/modules/web/security/models/SecuritySettings.php","lines":["@@ -46,6 +46,34 @@ class SecuritySettings extends Model"," ","     public const CSP_SECTION_REPORT_ONLY = 'csp-report-only';"," ","+    /**","+     * @since 1.19.1","+     */","+    public const HEADER_REPORTING_ENDPOINTS = 'Reporting-Endpoints';","+","+    /**","+     * Replaced with the script nonce of the session, e.g. `'nonce-xZnHrdklZksbCle1zhrmDj9g'`","+     * @since 1.19.1","+     */","+    public const PLACEHOLDER_NONCE = '{{ nonce }}';","+","+    /**","+     * Replaced with the `report-uri` and `report-to` directives pointing to the report endpoint","+     * @since 1.19.1","+     */","+    public const PLACEHOLDER_REPORTING = '{{ reporting }}';","+","+    /**","+     * @since 1.19.1","+     */","+    public const REPORTING_ENDPOINT_NAME = 'csp-endpoint';","+","+    /**","+     * Endpoint name of the Report-Only policy, its URL carries `disposition=report`","+     * @since 1.19.1","+     */","+    public const REPORT_ONLY_ENDPOINT_NAME = 'csp-report-only-endpoint';","+","     /**","      * @var [] static config cache","      */","@@ -67,13 +95,16 @@ class SecuritySettings extends Model","     private $nonceAttached = false;"," ","     /**","-     * @return bool checks if any csp section has reporting enabled","+     * @return bool checks if any csp section, the Report-Only policy of the web module or a configured","+     * header has reporting enabled","      */","     public static function isReportingEnabled()","     {","         $instance = new static();","         return $instance->isCspReportEnabled()","-            || $instance->hasSection(static::CSP_SECTION_REPORT_ONLY);","+            || $instance->hasSection(static::CSP_SECTION_REPORT_ONLY)","+            || Yii::$app->getModule('web')->enableCspReportOnly","+            || $instance->usesReportingPlaceholder();","     }"," ","     /**","@@ -99,7 +130,7 @@ private function initCSP()","         $this->csp = CSPBuilder::fromArray(static::$rules[$this->cspSection]);"," ","         if ($this->isCspReportEnabled()) {","-            $this->csp->setReportUri(Url::toRoute('/web/security-report'));","+            $this->csp->setReportUri(static::getReportUrl($this->isReportOnlyCSP()));","         }","     }"," ","@@ -205,9 +236,7 @@ public function getHeader(string $header): ?string","     }"," ","     /**","-     * Converts mask in header param like 'Content-Security-Policy' to proper value:","-     *  - {{ nonce }} is converted to 'nonce-xZnHrdklZksbCle1zhrmDj9g'","-     *                when config `web.csp.nonce` === `true`, otherwise","+     * Converts the placeholders in a header value of the `headers` section, see [[applyPlaceholders()]]","      *","      * @param string $header","      * @return string|null","@@ -221,21 +250,113 @@ private function applyHeaderMasks(string $header): ?string","         $headerValue = static::$rules['headers'][$header];"," ","         if (is_string($headerValue)) {","-            $headerValue = $this->applyMaskNonce($headerValue);","+            $headerValue = $this->applyPlaceholders($headerValue);","         }"," ","         return $headerValue;","     }"," ","-    private function applyMaskNonce(string $value): string","+    /**","+     * Converts placeholders to their values:","+     *  - {{ nonce }} is converted to 'nonce-xZnHrdklZksbCle1zhrmDj9g'","+     *                when config `web.csp.nonce` === `true`, otherwise to an empty string","+     *  - {{ reporting }} is converted to the `report-uri` and `report-to` directives of the report endpoint,","+     *                of the Report-Only endpoint if `$reportOnly` is set","+     */","+    private function applyPlaceholders(string $value, bool $reportOnly = false): string","     {","-        if (!str_contains($value, '{{ nonce }}')) {","-            return $value;","+        if (str_contains($value, static::PLACEHOLDER_NONCE)) {","+            $nonce = $this->isNonceSupportActive() ? Security::getNonce(true) : null;","+            $value = str_replace(static::PLACEHOLDER_NONCE, $nonce ? '\\'nonce-' . $nonce . '\\'' : '', $value);","+        }","+","+        if (str_contains($value, static::PLACEHOLDER_REPORTING)) {","+            $value = str_replace(","+                static::PLACEHOLDER_REPORTING,","+                'report-uri ' . static::getReportUrl($reportOnly) . '; report-to '","+                . ($reportOnly ? static::REPORT_ONLY_ENDPOINT_NAME : static::REPORTING_ENDPOINT_NAME),","+                $value,","+            );","+        }","+","+        return $value;","+    }","+","+    /**","+     * @return string|null the Report-Only policy of the web module with its placeholders converted,","+     * null when it is not enabled","+     * @since 1.19.1","+     */","+    public function getReportOnlyHeader(): ?string","+    {","+        $module = Yii::$app->getModule('web');","+","+        if (!$module->enableCspReportOnly || !is_string($module->cspReportOnly) || $module->cspReportOnly === '') {","+            return null;","         }"," ","-        $nonce = $this->isNonceSupportActive() ? Security::getNonce(true) : null;","+        return $this->applyPlaceholders($module->cspReportOnly, true);","+    }","+","+    /**","+     * @return bool whether a sent CSP header contains the {{ reporting }} placeholder","+     * @since 1.19.1","+     */","+    public function usesReportingPlaceholder(): bool","+    {","+        return $this->usesReportingInHeaders() || $this->usesReportingInReportOnly();","+    }","+","+    private function usesReportingInHeaders(): bool","+    {","+        $header = static::$rules['headers'][static::HEADER_CONTENT_SECRUITY_POLICY] ?? null;","+","+        return is_string($header) && str_contains($header, static::PLACEHOLDER_REPORTING);","+    }","+","+    private function usesReportingInReportOnly(): bool","+    {","+        $module = Yii::$app->getModule('web');","+","+        return $module->enableCspReportOnly","+            && is_string($module->cspReportOnly)","+            && str_contains($module->cspReportOnly, static::PLACEHOLDER_REPORTING);","+    }","+","+    /**","+     * @return string|null value of the Reporting-Endpoints header for the `report-to` directives in use,","+     * null if none is used","+     * @since 1.19.1","+     */","+    public function getReportingEndpointsHeader(): ?string","+    {","+        $endpoints = [];","+","+        if ($this->usesReportingInHeaders()) {","+            $endpoints[] = static::REPORTING_ENDPOINT_NAME . '=\"' . static::getReportUrl() . '\"';","+        }","+","+        if ($this->usesReportingInReportOnly()) {","+            $endpoints[] = static::REPORT_ONLY_ENDPOINT_NAME . '=\"' . static::getReportUrl(true) . '\"';","+        }","+","+        return $endpoints === [] ? null : implode(', ', $endpoints);","+    }","+","+    /**","+     * @param bool $reportOnly whether the URL is used by a Report-Only policy; adds `disposition=report`,","+     * so the endpoint can classify reports of browsers that omit the disposition field","+     * @return string absolute URL of the report endpoint, absolute because Reporting-Endpoints requires it","+     * @since 1.19.1","+     */","+    public static function getReportUrl(bool $reportOnly = false): string","+    {","+        $route = ['/web/security-report'];","+        if ($reportOnly) {","+            $route['disposition'] = 'report';","+        }"," ","-        return str_replace('{{ nonce }}', $nonce ? '\\'nonce-' . $nonce . '\\'' : '', $value);","+        return Url::to($route, true);","     }"," ","     /**"],"additions":133,"deletions":12,"truncated":false},{"path":"protected/humhub/modules/web/tests/codeception/data/security/security.headers-reporting.json","lines":["@@ -0,0 +1,8 @@","+{","+    \"headers\": {","+        \"Content-Security-Policy\": \"default-src *; script-src {{ nonce }} 'self'; {{ reporting }}\"","+    },","+    \"csp\": {","+        \"nonce\": true","+    }","+}"],"additions":8,"deletions":0,"truncated":false},{"path":"protected/humhub/modules/web/tests/codeception/functional/SecurityReportCest.php","lines":["@@ -0,0 +1,28 @@","+<?php","+","+namespace web\\functional;","+","+use web\\FunctionalTester;","+use Yii;","+use yii\\helpers\\Url;","+","+class SecurityReportCest","+{","+    public function testGuestReportIsAcceptedWithoutGuestAccess(FunctionalTester $I)","+    {","+        $I->wantTo('post a CSP report as guest while guest access is disabled');","+        Yii::$app->getModule('user')->settings->set('auth.allowGuestAccess', 0);","+","+        $I->sendAjaxPostRequest(Url::to(['/web/security-report']));","+        $I->seeResponseCodeIs(204);","+    }","+","+    public function testUserReportIsAccepted(FunctionalTester $I)","+    {","+        $I->wantTo('post a CSP report as logged in user');","+        $I->amUser();","+","+        $I->sendAjaxPostRequest(Url::to(['/web/security-report']));","+        $I->seeResponseCodeIs(204);","+    }","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"protected/humhub/modules/web/tests/codeception/unit/security/CspReportTest.php","lines":["@@ -0,0 +1,189 @@","+<?php","+","+namespace tests\\codeception\\unit\\modules\\web\\security;","+","+use humhub\\modules\\web\\security\\helpers\\CspReport;","+use tests\\codeception\\_support\\HumHubDbTestCase;","+use yii\\log\\Logger;","+","+class CspReportTest extends HumHubDbTestCase","+{","+    private const POLICY = \"script-src 'nonce-SECRETNONCE123' 'self'\";","+","+    public function _before()","+    {","+        parent::_before();","+        self::logInitialize();","+        self::logFlush();","+    }","+","+    public function testLegacyReportOnly()","+    {","+        $reports = CspReport::parse($this->legacyBody());","+","+        $this->assertCount(1, $reports);","+        $this->assertTrue($reports[0]->isReportOnly());","+        $this->assertSame(","+            'CSP violation (report-only): script-src-elem https://cdn.example.org/x.js in https://example.com/dashboard',","+            $reports[0]->getSummary(),","+        );","+    }","+","+    public function testLegacyEnforced()","+    {","+        $reports = CspReport::parse($this->legacyBody(['disposition' => 'enforce']));","+","+        $this->assertCount(1, $reports);","+        $this->assertFalse($reports[0]->isReportOnly());","+        $this->assertStringStartsWith('CSP violation (enforced): ', $reports[0]->getSummary());","+    }","+","+    public function testMissingDispositionCountsAsEnforced()","+    {","+        $reports = CspReport::parse($this->legacyBody(['disposition' => null]));","+","+        $this->assertCount(1, $reports);","+        $this->assertFalse($reports[0]->isReportOnly());","+    }","+","+    public function testReportOnlyUrlOverridesMissingDisposition()","+    {","+        $reports = CspReport::parse($this->legacyBody(['disposition' => null]), true);","+","+        $this->assertCount(1, $reports);","+        $this->assertTrue($reports[0]->isReportOnly());","+        $this->assertStringStartsWith('CSP violation (report-only): ', $reports[0]->getSummary());","+    }","+","+    public function testReportOnlyUrlAppliesToReportingApiEntries()","+    {","+        $reports = CspReport::parse(json_encode([$this->reportingApiEntry(['disposition' => 'enforce'])]), true);","+","+        $this->assertCount(1, $reports);","+        $this->assertTrue($reports[0]->isReportOnly());","+    }","+","+    public function testReportingApiUsesOnlyCspViolations()","+    {","+        $reports = CspReport::parse(json_encode([","+            $this->reportingApiEntry(),","+            ['type' => 'deprecation', 'age' => 1, 'url' => 'https://example.com/', 'body' => ['id' => 'x']],","+            $this->reportingApiEntry(['disposition' => 'enforce']),","+        ]));","+","+        $this->assertCount(2, $reports);","+        $this->assertTrue($reports[0]->isReportOnly());","+        $this->assertSame(","+            'CSP violation (report-only): script-src-elem https://cdn.example.org/y.js in https://example.com/dashboard',","+            $reports[0]->getSummary(),","+        );","+        $this->assertFalse($reports[1]->isReportOnly());","+    }","+","+    public function testSummaryFallsBackToViolatedDirective()","+    {","+        $reports = CspReport::parse($this->legacyBody([","+            'effective-directive' => null,","+            'blocked-uri' => null,","+            'source-file' => null,","+        ]));","+","+        $this->assertSame('CSP violation (report-only): script-src-elem', $reports[0]->getSummary());","+    }","+","+    public function testSummaryStripsControlCharacters()","+    {","+        $reports = CspReport::parse($this->legacyBody(['blocked-uri' => \"https://cdn.example.org/x.js\\nFAKE LINE\"]));","+","+        $this->assertStringNotContainsString(\"\\n\", $reports[0]->getSummary());","+    }","+","+    /**","+     * @dataProvider invalidBodies","+     */","+    public function testInvalidBodiesYieldNoReports(string $body)","+    {","+        $this->assertSame([], CspReport::parse($body));","+    }","+","+    public static function invalidBodies(): array","+    {","+        return [","+            'empty' => [''],","+            'no json' => ['not json'],","+            'null' => ['null'],","+            'string' => ['\"report\"'],","+            'unknown object' => ['{\"foo\": 1}'],","+            'empty list' => ['[]'],","+            'violation without body' => ['[{\"type\": \"csp-violation\"}]'],","+        ];","+    }","+","+    public function testOversizedBodyIsDiscarded()","+    {","+        $body = $this->legacyBody(['script-sample' => str_repeat('a', CspReport::MAX_BODY_SIZE)]);","+","+        $this->assertGreaterThan(CspReport::MAX_BODY_SIZE, strlen($body));","+        $this->assertSame([], CspReport::parse($body));","+    }","+","+    public function testLogLevels()","+    {","+        CspReport::parse($this->legacyBody())[0]->log();","+        CspReport::parse($this->legacyBody(['disposition' => 'enforce']))[0]->log();","+","+        $messages = self::logFilterMessages();","+        $this->assertCount(2, $messages);","+        $this->assertSame(Logger::LEVEL_WARNING, $messages[0][1]);","+        $this->assertSame('web.security', $messages[0][2]);","+        $this->assertSame(Logger::LEVEL_ERROR, $messages[1][1]);","+        $this->assertSame('web.security', $messages[1][2]);","+    }","+","+    public function testLogMasksNonceInBothFormats()","+    {","+        CspReport::parse($this->legacyBody())[0]->log();","+        CspReport::parse(json_encode([$this->reportingApiEntry()]))[0]->log();","+","+        $messages = self::logFilterMessages();","+        $this->assertCount(2, $messages);","+        foreach ($messages as $message) {","+            $this->assertStringStartsWith('CSP violation (report-only): ', $message[0]);","+            $this->assertStringContainsString(\"'nonce-xxxxxxxxxxxxxxxxxxxxxxxx'\", $message[0]);","+            $this->assertStringNotContainsString('SECRETNONCE123', $message[0]);","+        }","+    }","+","+    private function legacyBody(array $override = []): string","+    {","+        $report = array_merge([","+            'document-uri' => 'https://example.com/dashboard',","+            'effective-directive' => 'script-src-elem',","+            'violated-directive' => 'script-src-elem',","+            'blocked-uri' => 'https://cdn.example.or