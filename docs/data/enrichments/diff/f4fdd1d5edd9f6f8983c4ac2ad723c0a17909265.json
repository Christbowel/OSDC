ead($this->getPath($key));","-            $time = $this->readTime($stream);","+            $modifiedSince = new DateTimeImmutable('@' . (time() - $ttl));"," ","-            return $time !== null && $time + $ttl > time() ? $stream->getContents() : false;","+            return $this->device->read($this->getPath($key), modifiedSince: $modifiedSince)->getContents();","         } catch (StorageException | RuntimeException) {","             return false;","         }","@@ -80,7 +77,7 @@ public function save(string $key, array|string $data, string $hash = '', int $tt","         }"," ","         try {","-            $this->device->write($this->getPath($key), new Stream($this->header() . $body), self::CONTENT_TYPE);","+            $this->device->write($this->getPath($key), new Stream($body), self::CONTENT_TYPE);"," ","             return $data;","         } catch (StorageException | RuntimeException) {","@@ -89,9 +86,9 @@ public function save(string $key, array|string $data, string $hash = '', int $tt","     }"," ","     /**","-     * Rewrites the object with a new write time: a HEAD, a GET and a conditional PUT","-     * on S3. The condition stops it bringing back an entry purged or replaced","-     * meanwhile, which returns false.","+     * Objects have no writable modified time, so this rewrites the object: a HEAD, a","+     * GET and a conditional PUT on S3. The condition stops it bringing back an entry","+     * purged or replaced meanwhile, which returns false.","      *","      * @param  string  $hash optional","      */","@@ -106,13 +103,7 @@ public function touch(string $key, string $hash = ''): bool","                 return false;","             }"," ","-            $stream = $this->device->read($path, etag: $etag);","-","-            if ($this->readTime($stream) === null) {","-                return false;","-            }","-","-            $this->device->replace($path, new Stream($this->header() . $stream->getContents()), $etag, self::CONTENT_TYPE);","+            $this->device->replace($path, $this->device->read($path, etag: $etag), $etag, self::CONTENT_TYPE);"," ","             return true;","         } catch (StorageException | RuntimeException) {","@@ -195,29 +186,6 @@ public function getPath(string $key): string","         });","     }"," ","-    /**","-     * The write time at the start of the stream, or null if the object was not","-     * written by this adapter: too short, or a time outside the past.","-     */","-    private function readTime(StreamInterface $stream): ?int","-    {","-        $header = $stream->read(self::HEADER_SIZE);","-","-        if (\\strlen($header) !== self::HEADER_SIZE) {","-            return null;","-        }","-","-        /** @var array{1: int} $time */","-        $time = unpack('J', $header);","-","-        return $time[1] >= 0 && $time[1] <= time() ? $time[1] : null;","-    }","-","-    private function header(): string","-    {","-        return pack('J', time());","-    }","-","     public function getName(?string $key = null): string","     {","         return 'storage';"],"additions":14,"deletions":46,"truncated":false},{"path":"packages/cache/tests/StorageTest.php","lines":["@@ -132,7 +132,7 @@ public function testOutageDuringThePayloadReadIsAMiss(): void","     {","         $path = self::scratch('storage-read');","         $device = new class ($path) extends Local {","-            public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null): StreamInterface","+            public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null, ?\\DateTimeInterface $modifiedSince = null): StreamInterface","             {","                 throw new TransportException('Connection timed out');","             }","@@ -145,14 +145,15 @@ public function read(string $path, int $offset = 0, ?int $length = null, ?string"," ","     public function testLoadMakesOneReadAndNoOtherRequest(): void","     {","-        $device = new class (self::scratch('storage-requests')) extends Local {","+        $path = self::scratch('storage-requests');","+        $device = new class ($path) extends Local {","             public int $reads = 0;"," ","-            public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null): StreamInterface","+            public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null, ?\\DateTimeInterface $modifiedSince = null): StreamInterface","             {","                 $this->reads++;"," ","-                return parent::read($path, $offset, $length, $etag);","+                return parent::read($path, $offset, $length, $etag, $modifiedSince);","             }"," ","             public function getFileInfo(string $path): FileInfo","@@ -169,20 +170,24 @@ public function getFileInfo(string $path): FileInfo"," ","         $this->assertSame('value', $adapter->load('key', 60));","         $this->assertSame(2, $device->reads);","+","+        touch($path . '/key', time() - 100);","+","+        $this->assertFalse($adapter->load('key', 60));","+        $this->assertSame(3, $device->reads);","+        $this->assertSame('value', $adapter->load('key', 200));","     }"," ","-    public function testObjectNotWrittenByTheAdapterIsAMiss(): void","+    public function testObjectsHoldOnlyTheCachedBytes(): void","     {","-        $path = self::scratch('storage-foreign');","+        $path = self::scratch('storage-plain');","         $adapter = new Storage(new Local($path));"," ","-        foreach (['short', 'written by something else', \"\\x89PNG\\r\\n\\x1a\\n\\x00\\xff\"] as $body) {","-            file_put_contents($path . '/key', $body);","+        $adapter->save('key', 'value');","+        $this->assertSame('value', file_get_contents($path . '/key'));"," ","-            $this->assertFalse($adapter->load('key', 60), $body);","-            $this->assertFalse($adapter->touch('key'), $body);","-            $this->assertSame($body, file_get_contents($path . '/key'));","-        }","+        file_put_contents($path . '/other', 'written elsewhere');","+        $this->assertSame('written elsewhere', $adapter->load('other', 60));","     }"," ","     public function testRunsBesideFilesystemWithTheSameKeys(): void"],"additions":17,"deletions":12,"truncated":false},{"path":"packages/storage/README.md","lines":["@@ -282,6 +282,7 @@ $device->move('source/path.jpg', 'target/path.jpg');"," Every file carries an ETag, reported by `getFileInfo()` and returned by every write, conditional or not. Naming it makes an operation apply to that version of the file and no other, which is what coordinating several processes through one file takes: a lock, a lease, or a dataset that must never be read half old and half new."," "," ```php","+use Utopia\\Storage\\Exception\\NotModifiedException;"," use Utopia\\Storage\\Exception\\PreconditionFailedException;"," "," // Write only where nothing is yet; exactly one of several racing callers succeeds","@@ -296,6 +297,13 @@ $etag = $device->replace('locks/refresh', new Stream($token), $etag, 'text/plain"," "," // Read only while the file still is the version you know"," $chunk = $device->read('dataset.bin', $offset, $length, $etag);","+","+// Read only if the file changed after a time: one request, and no body if it did not","+try {","+    $body = $device->read('report.pdf', modifiedSince: new DateTimeImmutable('-1 hour'));","+} catch (NotModifiedException) {","+    // Unchanged in the last hour","+}"," ```"," "," On S3 the check and the operation are one request (`If-None-Match`, `If-Match`), so nothing can slip in between. On the local disk the ETag is the file's MD5 hash. `create()` opens the file exclusively and has no window at all; `replace()` checks the hash before writing, so a replacement landing between the two goes unnoticed and the last writer wins. Local writes land by renaming a finished temporary file over the path, so a reader never sees two versions mixed and a write that fails part way leaves the previous one in place. A conditional read on `Local` pins the file open and hashes it, one full pass before the first byte comes back."],"additions":8,"deletions":0,"truncated":false},{"path":"packages/storage/src/Device.php","lines":["@@ -6,6 +6,7 @@"," "," use Psr\\Http\\Message\\StreamInterface;"," use Utopia\\Storage\\Exception\\NotFoundException;","+use Utopia\\Storage\\Exception\\NotModifiedException;"," use Utopia\\Storage\\Exception\\PreconditionFailedException;"," use Utopia\\Storage\\Exception\\StorageException;"," use Utopia\\Storage\\Exception\\UploadException;","@@ -119,6 +120,9 @@ abstract public function abort(string $path, string $uploadId = ''): bool;","      * file replaced meanwhile are never mistaken for the one the caller knows.","      * S3 checks the ETag as part of the read; `Local` pins the file open and","      * hashes it, which costs a full pass over it before any byte is returned.","+     * With a time, the read only happens if the file was modified after it, which","+     * tells age and bytes apart in one request. A time and an ETag cannot be","+     * combined, because services disagree on which one wins.","      *","      * @param  int<0, max>  $offset","      * @param  int<0, max>|null  $length","@@ -126,8 +130,10 @@ abstract public function abort(string $path, string $uploadId = ''): bool;","      *","      * @throws NotFoundException When there is no file at the path","      * @throws PreconditionFailedException When the file's ETag is not the given one","+     * @throws NotModifiedException When the file has not been modified after the given time","+     * @throws \\InvalidArgumentException When given both an ETag and a time","      */","-    abstract public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null): StreamInterface;","+    abstract public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null, ?\\DateTimeInterface $modifiedSince = null): StreamInterface;"," ","     /**","      * Deliver bytes without requiring a seekable copy of the entire object."],"additions":7,"deletions":1,"truncated":false},{"path":"packages/storage/src/Device/Local.php","lines":["@@ -9,6 +9,7 @@"," use Utopia\\Storage\\Device;"," use Utopia\\Storage\\DeviceType;"," use Utopia\\Storage\\Exception\\NotFoundException;","+use Utopia\\Storage\\Exception\\NotModifiedException;"," use Utopia\\Storage\\Exception\\PreconditionFailedException;"," use Utopia\\Storage\\Exception\\StorageException;"," use Utopia\\Storage\\Exception\\UploadException;","@@ -246,8 +247,12 @@ public function abort(string $path, string $uploadId = ''): bool","      *","      * @throws StorageException","      */","-    public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null): StreamInterface","+    public function read(string $path, int $offset = 0, ?int $length = null, ?string $etag = null, ?\\DateTimeInterface $modifiedSince = null): StreamInterface","     {","+        if ($etag !== null && $modifiedSince instanceof \\DateTimeInterface) {","+            throw new \\InvalidArgumentException('A read cannot be conditional on both an ETag and a time');","+        }","+","         if (! $this->exists($path)) {","             throw new NotFoundException('File not found');","         }","@@ -257,6 +262,15 @@ public function read(string $path, int $offset = 0, ?int $length = null, ?string","             throw new StorageException('Failed to read file ' . $path);","         }"," ","+        if ($modifiedSince instanceof \\DateTimeInterface) {","+            $stat = fstat($handle);","+            if ($stat !== false && $stat['mtime'] <= $modifiedSince->getTimestamp()) {","+                fclose($handle);","+","+                throw new NotModifiedException('File ' . $path . ' has not been modified');","+            }","+        }","+","         if ($etag !== null && $this->hashHandle($ha