{"id":"f7cfd51185872a98ba590a405d4d018cf0ef9e88","axis":"silent","repo":"mongodb/mongo","sha":"f7cfd51185872a98ba590a405d4d018cf0ef9e88","parsed":{"files":[{"path":"buildscripts/resmokelib/testing/hooks/drop_sessions_collection.py","lines":["@@ -1,4 +1,4 @@","-\"\"\"Test hook that periodically drops and rereates the sessions collection.\"\"\"","+\"\"\"Test hook that periodically drops and recreates the sessions collection.\"\"\""," "," import os.path"," import random","@@ -7,7 +7,7 @@"," "," import pymongo.errors"," ","-from buildscripts.resmokelib import errors","+from buildscripts.resmokelib import core, errors"," from buildscripts.resmokelib.testing.fixtures import replicaset, shardedcluster"," from buildscripts.resmokelib.testing.hooks import interface"," from buildscripts.resmokelib.testing.hooks import lifecycle as lifecycle_interface","@@ -197,106 +197,75 @@ def _rs_drop_collection(self, rs_fixture):","         primary = rs_fixture.get_primary().mongo_client()","         primary.config.system.sessions.drop()"," ","-    def _sc_block_sessions_refresh(self, sc_fixture):","-        # First configure the failpoint on all CSRS nodes - this will fail any refresh which tries","-        # to create the sessions collection.","-        failpoint_cmd = {","-            \"configureFailPoint\": \"preventSessionsCollectionSharding\",","-            \"mode\": \"alwaysOn\",","-        }","-        for node in sc_fixture.configsvr.nodes:","-            client = node.mongo_client()","-            client.admin.command(failpoint_cmd)","-        # Now run a refresh, this will take the mutex protecting collection creation thus ensuring","-        # any ongoing periodic refresh is drained.","+    def _sc_drop_collection(self, sc_fixture):","         try:","-            with_naive_retry(lambda: self._refresh_sessions_collection(sc_fixture))","-        except pymongo.errors.OperationFailure as err:","-            # 117 = ConflictingOperationInProgress - this is the error code the failpoint throws.","-            if err.code != 117:","-                raise err","-","-    def _sc_unblock_sessions_refresh(self, sc_fixture):","-        # Turn off the failpoint on all nodes, thus re-allowing refreshes","-        failpoint_cmd = {","-            \"configureFailPoint\": \"preventSessionsCollectionSharding\",","-            \"mode\": \"off\",","-        }","-        for node in sc_fixture.configsvr.nodes:","-            client = node.mongo_client()","-            client.admin.command(failpoint_cmd)","-","-    def _is_authoritative_shards_crud_enabled(self, mongo_client):","-        # TODO (SERVER-98118): Remove this once 9.0 becomes last LTS.","-        try:","-            flag_doc = mongo_client.admin.command(","-                {\"getParameter\": 1, \"featureFlagAuthoritativeShardsCRUD\": 1}","+            self._set_allow_drop(sc_fixture, True)","+            sc_fixture.mongos[0].mongo_client().get_database(\"config\").command(","+                {\"drop\": \"system.sessions\"}","             )","-        except pymongo.errors.OperationFailure:","-            # The parameter doesn't exist on this binary version; treat it as disabled.","-            return False","-        return bool(","-            flag_doc.get(\"featureFlagAuthoritativeShardsCRUD\", {}).get(\"currentlyEnabled\", False)","-        )","-","-    def _sc_drop_collection(self, sc_fixture, uuid):","-        config_primary = sc_fixture.configsvr.get_primary().mongo_client()","-        config_db = config_primary.get_database(","-            \"config\",","-            read_concern=pymongo.read_concern.ReadConcern(level=\"majority\"),","-            write_concern=pymongo.write_concern.WriteConcern(w=\"majority\"),","-        )","-        # Drop sharding catalog metadata","-        config_db.collections.delete_one({\"_id\": \"config.system.sessions\"})","-        config_db.chunks.delete_many({\"uuid\": uuid})","-        # Drop collection on all replica sets","-        config_db.system.sessions.drop()","-        # _flushRoutingTableCacheUpdatesWithWriteConcern is deprecated and rejected once shards are","-        # authoritative for collection metadata (config.cache collections are no longer relied","-        # upon), so only issue it against the legacy (non-authoritative) refresh protocol.","-        if not self._is_authoritative_shards_crud_enabled(config_primary):","-            config_primary.admin.command(","-                {","-                    \"_flushRoutingTableCacheUpdatesWithWriteConcern\": \"config.system.sessions\",","-                    \"writeConcern\": {\"w\": \"majority\"},","-                }","+        finally:","+            self._set_allow_drop(sc_fixture, False)","+","+    @staticmethod","+    def _set_allow_drop(sc_fixture, enabled):","+        \"\"\"Toggle the allowDropSystemSessionCollection server parameter on all mongos.\"\"\"","+        for mongos in sc_fixture.mongos:","+            mongos.mongo_client().admin.command(","+                {\"setParameter\": 1, \"allowDropSystemSessionCollection\": enabled}","             )","-        for shard in sc_fixture.shards:","-            shard_primary = shard.get_primary().mongo_client()","-            shard_primary.get_database(","-                \"config\",","-                read_concern=pymongo.read_concern.ReadConcern(level=\"majority\"),","-                write_concern=pymongo.write_concern.WriteConcern(w=\"majority\"),","-            ).system.sessions.drop()","-            if not self._is_authoritative_shards_crud_enabled(shard_primary):","-                shard_primary.admin.command(","-                    {","-                        \"_flushRoutingTableCacheUpdatesWithWriteConcern\": \"config.system.sessions\",","-                        \"writeConcern\": {\"w\": \"majority\"},","-                    }","-                )"," ","     def _drop_sessions_collection(self, fixture):","-        self.logger.info(\"Starting drop of the sessions collection.\")","+        # The production escape hatch is intended only for repairing a corrupted sessions","+        # collection; this hook deliberately exercises it. Since checkMetadataConsistency does not","+        # serialize with the drop, bracket the operation with consistency checks. The independent","+        # background CMC hook ignores transient sessions inconsistencies during the drop.","+        self._check_metadata_consistency(fixture, \"beforeDrop\")","+        self.logger.info(","+            \"Starting sessions collection drop (cluster=%s).\",","+            fixture.get_driver_connection_url(),","+        )","         if isinstance(fixture, replicaset.ReplicaSetFixture):","             with_naive_retry(lambda: self._rs_drop_collection(fixture))","         elif isinstance(fixture, shardedcluster.ShardedClusterFixture):","-            coll_doc = with_naive_retry(","-                lambda: fixture.configsvr.get_primary()","-                .mongo_client()","-                .config.get_collection(","-                    \"collections\",","-                    read_concern=pymongo.read_concern.ReadConcern(level=\"majority\"),","-                    write_concern=pymongo.write_concern.WriteConcern(w=\"majority\"),","-                )","-                .find_one({\"_id\": \"config.system.sessions\"})","+            with_naive_retry(lambda: self._sc_drop_collection(fixture))","+        self.logger.info(","+            \"Finished sessions collection drop (cluster=%s).\",","+            fixture.get_driver_connection_url(),","+        )","+        self._check_metadata_consistency(fixture, \"afterDrop\")","+","+    def _check_metadata_consistency(self, fixture, when):","+        \"\"\"Run cluster-level checkMetadataConsistency, including config.system.sessions.\"\"\"","+        if not isinstance(fixture, shardedcluster.ShardedClusterFixture) or not fixture.mongos:","+            return","+","+        cluster_url = fixture.get_driver_connection_url()","+        self.logger.info(","+            \"Running checkMetadataConsistency (phase=%s, cluster=%s).\", when, cluster_url","+        )","+        # Reuse the JS MetadataConsistencyChecker so the error handling (transient errors,","+        # Unauthorized on auth suites, sessions-collection filtering) lives in one place.","+        js_cmds = \"\"\"","+            const {MetadataConsistencyChecker} = await import(","+                \"jstests/libs/server_catalog/check_metadata_consistency_helpers.js\");","+            MetadataConsistencyChecker.run(db.getMongo());","+        \"\"\"","+        shell_proc = core.programs.mongo_shell_program(","+            self.logger,","+            test_name=\"check_metadata_consistency_sessions_drop\",","+            connection_string=fixture.get_shell_connection_url(),","+            global_vars={\"TestData\": {\"skipCheckingIndexesConsistentAcrossCluster\": True}},","+            eval=js_cmds,","+        )","+        shell_proc.start()","+        return_code = shell_proc.wait()","+        if return_code:","+            raise errors.ServerFailure(","+                f\"checkMetadataConsistency failed (phase={when}, cluster={cluster_url})\"","             )","-            if not coll_doc or \"uuid\" not in coll_doc:","-                return","-            self._sc_block_sessions_refresh(fixture)","-            with_naive_retry(lambda: self._sc_drop_collection(fixture, coll_doc[\"uuid\"]))","-            self._sc_unblock_sessions_refresh(fixture)","-        self.logger.info(\"Finished drop of the sessions collection.\")","+        self.logger.info(","+            \"Completed checkMetadataConsistency (phase=%s, cluster=%s).\", when, cluster_url","+        )"," ","     def _refresh_sessions_collection(self, fixture):","         primary_conn = None"],"additions":62,"deletions":93,"truncated":false},{"path":"buildscripts/tests/resmokelib/testing/hooks/OWNERS.yml","lines":["@@ -6,6 +6,9 @@ filters:","   - \"test_add_remove_shards.py\":","     approvers:","       - 10gen/server-catalog-and-routing-routing-and-topology","+  - \"test_drop_sessions_collection.py\":","+    approvers:","+      - 10gen/server-catalog-and-routing-ddl","   - \"test_generate_and_check_perf_results.py\":","     approvers:","       - 10gen/devprod-performance-infrastructure"],"additions":3,"deletions":0,"truncated":false},{"path":"buildscripts/tests/resmokelib/testing/hooks/test_drop_sessions_collection.py","lines":["@@ -0,0 +1,70 @@","+\"\"\"Unit tests for the sessions collection drop hook.\"\"\"","+","+import logging","+import unittest","+from unittest import mock","+","+from buildscripts.resmokelib import errors","+from buildscripts.resmokelib.testing.fixtures import replicaset, shardedcluster","+from buildscripts.resmokelib.testing.hooks import drop_sessions_collection","+from buildscripts.resmokelib.testing.hooks import lifecycle as lifecycle_interface","+","+","+class TestCheckMetadataConsistency(unittest.TestCase):","+    def setUp(self):","+        self.fixture = mock.MagicMock(spec=shardedcluster.ShardedClusterFixture)","+        self.fixture.mongos = [mock.MagicMock()]","+        self.fixture.get_driver_connection_url.return_value = \"mongodb://localhost:20000\"","+        self.fixture.get_shell_connection_url.return_value = \"mongodb://localhost:20001\"","+        self.thread = drop_sessions_collection._DropSessionsCollectionThread(","+            logging.getLogger(\"test\"),","+            lifecycle_interface.FlagBasedThreadLifecycle(),","+            self.fixture,","+        )","+        self.shell_program = mock.patch.object(","+            drop_sessions_collection.core.programs, \"mongo_shell_program\"","+        ).start()","+        self.addCleanup(mock.patch.stopall)","+        self.shell_program.return_value.wait.return_value = 0","+","+    def test_uses_shell_connection_url(self):","+        \"\"\"The shell must use its gRPC port rather than the driver's MongoDB port.\"\"\"","+        self.thread._check_metadata_consistency(self.fixture, \"beforeDrop\")","+","+        self.assertEqual(","+            self.shell_program.call_args.kwargs[\"connection_string\"],","+            \"mongodb://localhost:20001\",","+        )","+        self.shell_program.return_value.start.assert_called_once_with()","+        self.shell_program.return_value.wait.assert_called_once_with()","+","+    def test_disables_index_checks_in_hook_shell(self):","+        \"\"\"Preserve the previous cluster check without enabling cross-shard index checks.\"\"\"","+        self.thread._check_metadata_consistency(self.fixture, \"beforeDrop\")","+","+        shell_options = self.shell_program.call_args.kwargs","+        self.assertEqual(","+            shell_options.get(\"global_vars\"),","+            {\"TestData\": {\"skipCheckingIndexesConsistentAcrossCluster\": True}},","+        )","+        self.assertIn(\"MetadataConsistencyChecker.run(db.getMongo());\", shell_options[\"eval\"])","+","+    def test_failed_check_raises_server_failure(self):","+        self.shell_program.return_value.wait.return_value = 1","+","+        with self.assertRaisesRegex(errors.ServerFailure, \"phase=afterDrop\"):","+            self.thread._check_metadata_consistency(self.fixture, \"afterDrop\")","+","+    def test_skips_replica_set(self):","+        fixture = mock.MagicMock(spec=replicaset.ReplicaSetFixture)","+","+        self.thread._check_metadata_consistency(fixture, \"beforeDrop\")","+","+        self.shell_program.assert_not_called()","+","+    def test_skips_cluster_without_mongos(self):","+        self.fixture.mongos = []","+","+        self.thread._check_metadata_consistency(self.fixture, \"beforeDrop\")","+","+        self.shell_program.assert_not_called()"],"additions":70,"deletions":0,"truncated":false},{"path":"jstests/auth/lib/commands_lib.js","lines":["@@ -5376,6 +5376,83 @@ export const authCommandsLib = {","                 },","             ],","         },","+        {","+            testname: \"drop_config_system_sessions\",","+            command: {drop: \"system.sessions\"},","+            skipUnlessSharded: true,","+            setup: function (db) {","+                const adminDb = db.getSiblingDB(adminDbName);","+                assert.commandWorked(","+                    adminDb.runCommand({setParameter: 1, allowDropSystemSessionCollection: true}),","+                );","+                // refreshLogicalSessionCacheNow only refreshes an existing sharded session","+                // collection. This test is also run independently from the other auth cases, so","+                // establish the required catalog entry here when it is not already present.","+                if (","+                    db.getSiblingDB(configDbName).collections.findOne({","+                        _id: \"config.system.sessions\",","+                    }) === null","+                ) {","+                    assert.commandWorked(","+                        adminDb.runCommand({","+                            shardCollection: \"config.system.sessions\",","+                            key: {_id: 1},","+                        }),","+                    );","+                }","+                assert.commandWorked(adminDb.runCommand({refreshLogicalSessionCacheNow: 1}));","+                assert.soon(() => {","+                    return (","+                        db.getSiblingDB(configDbName).collections.findOne({","+                            _id: \"config.system.sessions\",","+                        }) !== null","+                    );","+                }, \"config.system.sessions was not tracked\");","+            },","+            teardown: function (db) {","+                const adminDb = db.getSiblingDB(adminDbName);","+                assert.commandWorked(","+                    adminDb.runCommand({","+                        setParameter: 1,","+                        allowDropSystemSessionCollection: false,","+                    }),","+                );","+                // Subsequent auth cases (e.g. refreshLogicalSessionCacheNow) require a sharded","+                // sessions collection. Restore it after the authorized drops above.","+                if (","+                    db.getSiblingDB(configDbName).collections.findOne({","+                        _id: \"config.system.sessions\",","+                    }) === null","+                ) {","+                    assert.commandWorked(","+                        adminDb.runCommand({","+                            shardCollection: \"config.system.sessions\",","+                            key: {_id: 1},","+                        }),","+                    );","+                }","+                assert.commandWorked(adminDb.runCommand({refreshLogicalSessionCacheNow: 1}));","+                assert.soon(() => {","+                    return (","+                        db.getSiblingDB(configDbName).collections.findOne({","+                            _id: \"config.system.sessions\",","+                        }) !== null","+                    );","+                }, \"config.system.sessions was not tracked\");","+            },","+            testcases: [","+                {","+                    runOnDb: configDbName,","+                    roles: {clusterAdmin: 1, root: 1, __system: 1},","+                    privileges: [","+                        {","+                            resource: {db: configDbName, collection: \"system.sessions\"},","+                            actions: [\"dropCollection\"],","+                        },","+                    ],","+                },","+            ],","+        },","         {","             testname: \"drop_views\",","             setup: function (db) {"],"additions":77,"deletions":0,"truncated":false},{"path":"jstests/libs/server_catalog/check_metadata_consistency_helpers.js","lines":["@@ -88,6 +88,7 @@ export var MetadataConsistencyChecker = (function () {","             // Note that we check TestData here rather than jsTestOptions because this option is","             // used in passthroughs which use the python class of this hook and thus we pass","             // arguments via the suite + testData.","+            // Also note that the DropSessionCollection hook will run manually the cmc before and after the drop.","             const isSessionsCollectionDropSuite = Boolean(TestData.backgroundSessionCollectionDrop);","             if (isSessionsCollectionDropSuite) {","                 for (let i = inconsistencies.length - 1; i >= 0; i--) {"],"additions":1,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/ddl/drop_sessions_collection_via_mongos.js","lines":["@@ -0,0 +1,642 @@","+/**","+ * Verifies that dropping config.system.sessions through mongos is rejected by default and allowed","+ * only when the runtime server parameter is enabled.","+ *","+ * @tags: [","+ *   requires_sharding,","+ *   multiversion_incompatible,","+ *   # refreshLogicalSessionCacheNow is sent directly to the config primary. A concurrent","+ *   # config-server stepdown can make the command fail with NotWritablePrimary.","+ *   does_not_support_stepdowns,","+ * ]","+ */","+","+import {configureFailPoint} from \"jstests/libs/fail_point_util.js\";","+import {after, afterEach, before, beforeEach, describe, it} from \"jstests/libs/mochalite.js\";","+import {Thread} from \"jstests/libs/parallelTester.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+import {ShardingTest} from \"jstests/libs/shardingtest.js\";","+import {removeShard} from \"jstests/sharding/libs/remove_shard_util.js\";","+","+// The test deliberately creates local/global UUID mismatches before cleaning them up.","+TestData.skipCheckMetadataConsistency = true;","+","+describe(\"drop config.system.sessions via mongos\", function () {","+    const kSessionsNs = \"config.system.sessions\";","+    const kTestDbs = [","+        \"crud_after_drop\",","+        \"read_after_drop\",","+        \"transaction_after_drop\",","+        \"retryable_write_after_drop\",","+    ];","+    // Name the extra shard so it sorts first alphabetically and becomes the","+    // \"first shard\" once added.","+    const kExtraShardName = \"aaaa\";","+","+    let st;","+    let extraShard;","+","+    function assertSessionsCollectionTracked() {","+        assert.soon(() => {","+            return st.s.getDB(\"config\").collections.findOne({_id: kSessionsNs}) !== null;","+        }, \"config.system.sessions was not tracked in time\");","+    }","+","+    function refreshSessions() {","+        assert.commandWorked(","+            st.configRS.getPrimary().adminCommand({refreshLogicalSessionCacheNow: 1}),","+        );","+        assertSessionsCollectionTracked();","+    }","+","+    function getSessionsCollection() {","+        const sessions = st.s.getDB(\"config\").collections.findOne({_id: kSessionsNs});","+        assert.neq(null, sessions, \"config.system.sessions was not tracked\");","+        return sessions;","+    }","+","+    function getDataShardPrimaries() {","+        const shardPrimaries = st._rs.map((rs) => rs.test.getPrimary());","+        if (extraShard) {","+            shardPrimaries.push(extraShard.getPrimary());","+        }","+        return shardPrimaries;","+    }","+","+    function assertNoSessionsCollectionOnServer(server) {","+        assert.eq(","+            0,","+            server.getDB(\"config\").getCollectionInfos({name: \"system.sessions\"}).length,","+            \"system.sessions should not exist\",","+            {host: server.host},","+        );","+    }","+","+    function assertNoSessionsShardCatalogOnServer(server, sessionsUUID) {","+        const configDB = server.getDB(\"config\");","+        assert.eq(","+            null,","+            configDB.getCollection(\"shard.catalog.collections\").findOne({_id: kSessionsNs}),","+            \"sessions metadata should be removed from the shard catalog\",","+            {host: server.host},","+        );","+        assert.eq(","+            0,","+            configDB.getCollection(\"shard.catalog.chunks\").countDocuments({uuid: sessionsUUID}),","+            \"sessions chunk metadata should be removed from the shard catalog\",","+            {host: server.host, sessionsUUID},","+        );","+    }","+","+    function assertSessionsCollectionDropped(sessionsUUID) {","+        const configDB = st.s.getDB(\"config\");","+        assert.eq(null, configDB.collections.findOne({_id: kSessionsNs}));","+        assert.eq(","+            0,","+            configDB.chunks.countDocuments({uuid: sessionsUUID}),","+            \"sessions chunks should be removed from the global catalog\",","+            {sessionsUUID},","+        );","+","+        assertNoSessionsCollectionOnServer(st.configRS.getPrimary());","+        assertNoSessionsShardCatalogOnServer(st.configRS.getPrimary(), sessionsUUID);","+        for (const shardPrimary of getDataShardPrimaries()) {","+            assertNoSessionsCollectionOnServer(shardPrimary);","+            assertNoSessionsShardCatalogOnServer(shardPrimary, sessionsUUID);","+        }","+    }","+","+    // Drop sessions collection, run the callaback and re-create it.","+    // The helper enables a failpoint to prevent re-creation of the sessions collection","+    // so that the after-drop state can be tested in isolation.","+    function withSessionsCollectionDropped(callback) {","+        const sessionsUUID = getSessionsCollection().uuid;","+","+        setPreventSessionsCollectionSharding(true);","+        try {","+            assert.commandWorked(st.s.getDB(\"config\").runCommand({drop: \"system.sessions\"}));","+            assertSessionsCollectionDropped(sessionsUUID);","+            callback();","+        } finally {","+            setPreventSessionsCollectionSharding(false);","+            refreshSessions();","+        }","+    }","+","+    function dropSessionsCollection() {","+        withSessionsCollectionDropped(function () {});","+    }","+","+    function dropTestDatabases() {","+        for (const dbName of kTestDbs) {","+            st.s.getDB(dbName).dropDatabase();","+        }","+    }","+","+    // Best-effort cleanup used when a drop leaves local or shard-catalog leftovers.","+    function dropLocalSessionsLeftovers(sessionsUUID) {","+        const servers = getDataShardPrimaries();","+        servers.push(st.configRS.getPrimary());","+        for (const server of servers) {","+            const configDB = server.getDB(\"config\");","+            configDB.runCommand({drop: \"system.sessions\"});","+            configDB.getCollection(\"shard.catalog.collections\").deleteOne({_id: kSessionsNs});","+            configDB.getCollection(\"shard.catalog.chunks\").deleteMany({uuid: sessionsUUID});","+        }","+        const configDB = st.s.getDB(\"config\");","+        configDB.getCollection(\"collections\").deleteOne({_id: kSessionsNs});","+        configDB.getCollection(\"chunks\").deleteMany({uuid: sessionsUUID});","+    }","+","+    function setAllowDrop(enabled) {","+        assert.commandWorked(","+            st.s.adminCommand({setParameter: 1, allowDropSystemSessionCollection: enabled}),","+        );","+    }","+","+    function setPreventSessionsCollectionSharding(enabled) {","+        assert.commandWorked(","+            st.configRS.getPrimary().adminCommand({","+                configureFailPoint: \"preventSessionsCollectionSharding\",","+                mode: enabled ? \"alwaysOn\" : \"off\",","+            }),","+        );","+    }","+","+    function startExtraShard() {","+        extraShard = new ReplSetTest({name: kExtraShardName, nodes: 1});","+        extraShard.startSet({shardsvr: \"\"});","+        extraShard.initiate();","+        assert.commandWorked(","+            st.s.adminCommand({addShard: extraShard.getURL(), name: kExtraShardName}),","+        );","+    }","+","+    function stopExtraShard() {","+        if (extraShard) {","+            // Drop test databases so removeShard doesn't get stuck draining","+            // unsharded collections (the balancer is off).","+            dropTestDatabases();","+            // If the sessions chunk is on the extra shard, move it back to rs0","+            // before removing so removeShard doesn't get stuck (balancer is off).","+            const configDB = st.s.getDB(\"config\");","+            const sessions = configDB.collections.findOne({_id: kSessionsNs});","+            if (sessions) {","+                const chunk = configDB.chunks.findOne({uuid: sessions.uuid});","+                if (chunk && chunk.shard === kExtraShardName) {","+                    assert.commandWorked(","+                        st.s.adminCommand({","+                            moveChunk: kSessionsNs,","+                            find: {_id: 0},","+                            to: st.shard0.shardName,","+                        }),","+                    );","+                }","+            }","+            removeShard(st, kExtraShardName);","+            extraShard.stopSet();","+            extraShard = null;","+        }","+    }","+","+    function runCrudAfterDrop() {","+        const crudDB = st.s.getDB(\"crud_after_drop\");","+        assert.commandWorked(crudDB.createCollection(\"coll\"));","+","+        withSessionsCollectionDropped(function () {","+            assert.commandWorked(crudDB.coll.insert({_id: 1, value: 1}));","+            assert.commandWorked(crudDB.coll.update({_id: 1}, {$set: {value: 2}}));","+            assert.commandWorked(crudDB.coll.remove({_id: 1}));","+            assert.eq(null, crudDB.coll.findOne({_id: 1}));","+        });","+    }","+","+    function runReadsAfterDrop() {","+        const readDB = st.s.getDB(\"read_after_drop\");","+        assert.commandWorked(readDB.createCollection(\"coll\"));","+        assert.commandWorked(readDB.coll.insert({_id: 1, value: 1}));","+","+        withSessionsCollectionDropped(function () {","+            const readResult = assert.commandWorked(","+       