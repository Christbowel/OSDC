().unwrap();","+        assert!(!output.status.success());","+        assert!(","+            String::from_utf8_lossy(&output.stderr)","+                .contains(\"minimumReleaseAgeExclude setting has changed\"),","+        );","+    }","+}","+","+#[test]","+fn verify_selected_project_after_filtered_install_prunes_excludes() {","+    let (_root, workspace, _anchor) = setup();","+    write_manifest(&workspace, \"{}\");","+    write_exclude_workspace_projects(&workspace);","+    append_workspace_yaml(","+        &workspace,","+        &format!(","+            \"packages: ['packages/*']\\nverifyDepsBeforeRun: error\\nminimumReleaseAgeExcludePrune: true\\nminimumReleaseAgeExclude: ['{FOO}@1.0.0']\\n\",","+        ),","+    );","+    run_ok(&workspace, &[\"install\"]);","+    let manifest = workspace.join(\"packages/a/package.json\");","+    let mut json: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&manifest).unwrap()).unwrap();","+    json[\"dependencies\"][FOO] = \"2.0.0\".into();","+    fs::write(&manifest, json.to_string()).unwrap();","+    run_ok(&workspace, &[\"--filter\", \"a\", \"install\"]);","+    assert!(!read(&workspace, \"pnpm-workspace.yaml\").contains(&format!(\"{FOO}@1.0.0\")));","+    run_ok(&workspace, &[\"--filter\", \"a\", \"exec\", \"node\", \"--version\"]);","+    let output =","+        pacquet(&workspace, [\"--filter\", \"b\", \"exec\", \"node\", \"--version\"]).output().unwrap();","+    assert!(!output.status.success());","+    assert!(","+        String::from_utf8_lossy(&output.stderr)","+            .contains(\"minimumReleaseAgeExclude setting has changed\"),","+    );","+}","+","+#[test]","+fn verify_deps_after_pruning_the_last_exclusion_in_an_empty_project() {","+    let (_root, workspace, _anchor) = setup();","+    write_manifest(&workspace, \"{}\");","+    append_workspace_yaml(","+        &workspace,","+        \"trustPolicyExcludePrune: true\\ntrustPolicyExclude: [obsolete]\\nverifyDepsBeforeRun: error\\n\",",