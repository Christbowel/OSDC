"+    }","+    pub(super) fn trust_policy_drift(&self) -> Option<&'static str> {","+        let recorded = self.recorded;","+        let live = self.live;","+        return_drift_if!(self, \"trustPolicy\", recorded.trust_policy != live.trust_policy);","+        let excludes_changed = !self.excludes_match(","+            recorded.trust_policy_exclude.as_deref(),","+            live.trust_policy_exclude.as_deref(),","+            self.config.trust_policy_exclude_prune,","+        );","+        return_drift_if!(self, \"trustPolicyExclude\", excludes_changed);","+        return_drift_if!(","+            self,","+            \"trustPolicyIgnoreAfter\",","+            recorded.trust_policy_ignore_after != live.trust_policy_ignore_after,","+        );","+        None","+    }","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/lib.rs","lines":["@@ -149,6 +149,7 @@ mod update_project_manifest;"," mod update_project_manifest_object;"," mod warn_on_stale_convergence_overrides;"," mod workspace_cycles;","+mod workspace_root;"," "," /// The dependency groups a project installs directly (`dependencies`,"," /// `devDependencies`, `optionalDependencies`) in the order pnpm's"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/freshness.rs","lines":["@@ -47,6 +47,7 @@ use std::collections::HashSet;"," "," mod drift;"," mod missing_lockfile;","+mod pruned_excludes;"," mod registry_keys;"," mod stand_in_writes;"," ","@@ -254,24 +255,13 @@ fn check_settings_and_workspace_freshness(","     scope: Scope<'_>,"," ) -> Result<(), Stale> {","     let &OptimisticRepeatInstallCheck {","-        config,","-        project_manifests,","-        catalogs,","-        layout:","-            crate::RepeatInstallLayout {","-                node_linker,","-                included,","-                supported_architectures,","-                ..","-            },","-        ..","+        config