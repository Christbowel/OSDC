ace_updates(project_dirs, &context, options)?;","+    let updated = !updates.is_empty();","+    execute_cargo_workspace_updates::<ReporterType>(updates, context, options).await?;","+    Ok(updated)","+}","+","+fn collect_cargo_workspace_updates(","+    project_dirs: &[PathBuf],","+    context: &InstallContext,","+    options: &CargoUpdateOptions<'_>,","+) -> Result<CargoWorkspaceUpdates> {","+    let mut updates = BTreeMap::new();","+    for project_dir in project_dirs {","+        collect_project_cargo_updates(project_dir, context, options, &mut updates)?;","+    }","+    Ok(updates)","+}","+","+fn collect_project_cargo_updates(","+    project_dir: &Path,","+    context: &InstallContext,","+    options: &CargoUpdateOptions<'_>,","+    updates: &mut CargoWorkspaceUpdates,","+) -> Result<()> {","+    let manifest_path = project_dir.join(\"Cargo.toml\");","+    if !context.config.cargo.enabled || !manifest_path.is_file() {","+        return Ok(());","+    }","+    let declared = declared_cargo_deps(project_dir, context.config.workspace_dir.as_deref())?;","+    let selected = select_cargo_deps_to_update(&declared, options);","+    if selected.is_empty() {","+        return Ok(());","+    }","+    let root = find_cargo_workspace_root(project_dir, context.config.workspace_dir.as_deref());","+    merge_selected_cargo_deps(updates.entry(root).or_default(), selected);","+    Ok(())","+}","+","+fn merge_selected_cargo_deps(","+    updates: &mut Vec<CargoWorkspaceSelection>,","+    selected: Vec<SelectedCargoDep<'_>>,","+) {","+    for selection in selected {","+        match updates.iter_mut().find(|existing| same_declared_dep(&existing.dep, selection.dep)) {","+            Some(existing) => {","+                if existing.explicit_spec.is_none() {","+                    existing.explicit_spec = selection.explicit_spec.map(str::to_string);","+                }","+                existing.named |= selection.named;","+            }","+            None => updates.push(CargoWorkspaceSelection {","+                dep: selection.dep.clone(),","+                explicit_spec: selection.explicit_spec.map(str::to_string),","+                named: selection.named,","+            }),","+        }","+    }","+}","+","+async fn execute_cargo_workspace_updates<ReporterType: CargoReporter + 'static>(","+    updates: CargoWorkspaceUpdates,","+    context: InstallContext,","+    options: &CargoUpdateOptions<'_>,","+) -> Result<()> {","+    for (cargo_root, selected) in updates {","+        let manifest_path = cargo_root.join(\"Cargo.toml\");","+        let mut declared =","+            declared_cargo_deps(&cargo_root, context.config.workspace_dir.as_deref())?;","+        for selection in &selected {","+            if !declared.iter().any(|declared| same_declared_dep(declared, &selection.dep)) {","+                declared.push(selection.dep.clone());","+            }","+        }","+        let selected: Vec<_> = selected","+            .iter()","+            .filter_map(|selection| {","+                declared","+                    .iter()","+                    .find(|declared| same_declared_dep(declared, &selection.dep))","+                    .map(|dependency| SelectedCargoDep {","+                        dep: dependency,","+                        explicit_spec: selection.explicit_spec.as_deref(),","+                        named: selection.named,","+                    })","+            })","+            .collect();","+        execute_cargo_update::<ReporterType>(","+            &cargo_root,","+            &manifest_path,","+            &declared,","+            &selected,","+            context.clone(),","+            options,","+        )","+        .await?;","+    }","+    Ok(())","+}"],"additions":125,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/ecosystem_deps/cargo_manifest_ops.rs","lines":["@@ -1,9 +1,12 @@","+pub(crate) use saved_spec::format_cargo_saved_spec;","+mod saved_spec;","+"," use crate::{","     cargo_manifest::{upsert_dependency, workspace_includes_member},","     cli_args::outdated::OutdatedQuery,"," };"," use cargo_lock::Lockfile as CargoLockfile;","-use miette::{IntoDiagnostic, Result, WrapErr, bail};","+use miette::{IntoDiagnostic, Result, WrapErr};"," use pnpm_package_manifest::DependencyGroup;"," use semver::{Version, VersionReq};"," use std::{","@@ -13,6 +16,9 @@ use std::{","     str::FromStr,"," };"," ","+#[cfg(test)]","+mod tests;","+"," #[derive(Debug, Clone)]"," pub(crate) struct DeclaredCargoDep {","     pub(crate) alias: String,","@@ -260,77 +266,6 @@ pub(crate) fn select_locked_version<'a>(","         .or_else(|| (versions.len() == 1).then(|| &versions[0]))"," }"," ","-pub(crate) fn format_cargo_saved_spec(","-    existing_raw: &str,","-    resolved: &Version,","-    explicit_spec: Option<&str>,","-    save_exact: bool,","-    save_prefix: Option<&str>,","-) -> Result<String> {","-    if save_exact {","-        return Ok(format!(\"={resolved}\"));","-    }","-    if let Some(prefix) = save_prefix {","-        if !matches!(prefix, \"\" | \"^\" | \"~\" | \"=\") {","-            bail!(\"Cargo --save-prefix must be empty, ^, ~, or =\");","-        }","-        return Ok(format!(\"{prefix}{resolved}\"));","-    }","-    if let Some(spec) = explicit_spec","-        && spec.starts_with(['^', '~', '=', '>', '<'])","-    {","-        return Ok(spec.to_string());","-    }","-    Ok(format_existing_cargo_spec(existing_raw, resolved))","-}","-","-fn format_existing_cargo_spec(existing_raw: &str, resolved: &Version) -> String {","-    if !existing_raw.contains(',') {","-        let prefix = existing_prefix(existing_raw);","-        return format!(\"{prefix}{resolved}\");","-    }","-    let matches_existing = VersionReq::parse(existing_raw).is_ok_and(|req| req.matches(resolved));","-    if !matches_existing {","-        return format!(\"^{resolved}\");","-    }","-    let mut replaced_lower = false;","-    let clauses: Vec<String> = existing_raw","-        