);","+\tawait flushPromises();","+\tawait resolveHydrate();","+","+\texpect(push).toHaveBeenCalledWith('/file-view/xy');","+});","+","+test('falls back to /content when there is no redirect query and no last_page', async () => {","+\tvi.mocked(api.get).mockResolvedValue({","+\t\tdata: { data: { email: 'admin@example.com', first_name: 'Ad', last_name: 'Min', last_page: null } },","+\t});","+","+\tawait router.push('/login?continue=');","+","+\tconst push = vi.spyOn(router, 'push');","+","+\tmountContinueAs();","+\tawait flushPromises();","+\tawait resolveHydrate();","+","+\texpect(push).toHaveBeenCalledWith('/content');","+});","+","+test('uses the first value when the redirect query is repeated', async () => {","+\tawait router.push('/login?redirect=/settings/data-model&redirect=/users&continue=');","+","+\tconst push = vi.spyOn(router, 'push');","+","+\tmountContinueAs();","+\tawait flushPromises();","+\tawait resolveHydrate();","+","+\texpect(push).toHaveBeenCalledWith('/settings/data-model');","+});","+","+test('does not navigate without the continue query until the button is clicked', async () => {","+\tawait router.push('/login?redirect=/settings/data-model');","+","+\tconst push = vi.spyOn(router, 'push');","+","+\tconst wrapper = mountContinueAs();","+\tawait flushPromises();","+","+\texpect(hydrate).not.toHaveBeenCalled();","+\texpect(push).not.toHaveBeenCalled();","+","+\twrapper.findComponent(VButton).vm.$emit('click');","+\tawait flushPromises();","+\tawait resolveHydrate();","+","+\texpect(push).toHaveBeenCalledOnce();","+\texpect(push).toHaveBeenCalledWith('/settings/data-model');","+});"],"additions":226,"deletions":0,"truncated":false},{"path":"app/src/routes/login/components/continue-as.vue","lines":["@@ -1,3 +1,8 @@","+<script lang=\"ts\">","+/** Shared between instances: hydrating re-mounts this component, so only the first should navigate. */","+let navigating = false;","+</script>","+"," <script setup lang=\"ts\">"," import { onMounted, ref } fro