lable","+\t\"node.kubernetes.io/\",","+\t// uninitialized, shutdown","+\t\"node.cloudprovider.kubernetes.io/\",","+}","+","+// IsTransient returns true when the taint is a node lifecycle taint that a","+// controller adds and removes on its own, rather than a durable taint set by an","+// administrator or by the cluster's role configuration.","+func IsTransient(taint v1.Taint) bool {","+\tfor _, prefix := range transientTaintPrefixes {","+\t\tif strings.HasPrefix(taint.Key, prefix) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// Sort orders taints in place by key, then effect, then value.","+func Sort(taints []v1.Taint) {","+\tsort.Slice(taints, func(i, j int) bool {","+\t\tif taints[i].Key != taints[j].Key {","+\t\t\treturn taints[i].Key < taints[j].Key","+\t\t}","+\t\tif taints[i].Effect != taints[j].Effect {","+\t\t\treturn taints[i].Effect < taints[j].Effect","+\t\t}","+\t\treturn taints[i].Value < taints[j].Value","+\t})","+}","+"," func GetTaintsString(taint v1.Taint) string {"," \treturn fmt.Sprintf(\"%s=%s:%s\", taint.Key, taint.Value, taint.Effect)"," }"],"additions":39,"deletions":0,"truncated":false},{"path":"pkg/taints/utils_test.go","lines":["@@ -77,6 +77,57 @@ func TestMergeTaints(t *testing.T) {"," \t}"," }"," ","+func TestIsTransient(t *testing.T) {","+\ttestCases := []struct {","+\t\tkey      string","+\t\texpected bool","+\t}{","+\t\t// node lifecycle taints, added and removed by a controller","+\t\t{key: \"node.kubernetes.io/not-ready\", expected: true},","+\t\t{key: \"node.kubernetes.io/unreachable\", expected: true},","+\t\t{key: \"node.kubernetes.io/memory-pressure\", expected: true},","+\t\t{key: \"node.kubernetes.io/unschedulable\", expected: true},","+\t\t{key: \"node.cloudprovider.kubernetes.io/uninitialized\", expected: true},","+\t\t{key: \"node.cloudprovider.kubernetes.io/shutdown\", expected: true},","+\t\t// durable taints, set by the role configuration or an administrator","+\t\t{key: \"node-role.kubernetes.io/