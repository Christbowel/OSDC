 {","+\treturn nil, nil","+}","+","+var _ v3.NodeLister = &fakeNodeLister{}","+","+func controlPlaneNode(name string, taints ...corev1.Taint) *apimgmtv3.Node {","+\treturn &apimgmtv3.Node{","+\t\tObjectMeta: metav1.ObjectMeta{Name: name},","+\t\tSpec: apimgmtv3.NodeSpec{","+\t\t\tInternalNodeSpec: corev1.NodeSpec{Taints: taints},","+\t\t},","+\t\tStatus: apimgmtv3.NodeStatus{","+\t\t\tNodeName:   name,","+\t\t\tNodeLabels: map[string]string{\"node-role.kubernetes.io/control-plane\": \"true\"},","+\t\t},","+\t}","+}","+","+func workerNode(name string, taints ...corev1.Taint) *apimgmtv3.Node {","+\treturn &apimgmtv3.Node{","+\t\tObjectMeta: metav1.ObjectMeta{Name: name},","+\t\tSpec: apimgmtv3.NodeSpec{","+\t\t\tInternalNodeSpec: corev1.NodeSpec{Taints: taints},","+\t\t},","+\t\tStatus: apimgmtv3.NodeStatus{","+\t\t\tNodeName:   name,","+\t\t\tNodeLabels: map[string]string{\"node-role.kubernetes.io/worker\": \"true\"},","+\t\t},","+\t}","+}","+","+var (","+\tcontrolPlaneTaint  = corev1.Taint{Key: \"node-role.kubernetes.io/control-plane\", Effect: corev1.TaintEffectNoSchedule}","+\tetcdTaint          = corev1.Taint{Key: \"node-role.kubernetes.io/etcd\", Effect: corev1.TaintEffectNoExecute}","+\tuninitializedTaint = corev1.Taint{Key: \"node.cloudprovider.kubernetes.io/uninitialized\", Value: \"true\", Effect: corev1.TaintEffectPreferNoSchedule}","+\tnotReadyTaint      = corev1.Taint{Key: \"node.kubernetes.io/not-ready\", Effect: corev1.TaintEffectNoSchedule}","+)","+","+func TestGetControlPlaneTaints(t *testing.T) {","+\ttests := []struct {","+\t\tname     string","+\t\tnodes    []*apimgmtv3.Node","+\t\texpected []corev1.Taint","+\t}{","+\t\t{","+\t\t\tname:     \"no nodes\",","+\t\t\tnodes:    nil,","+\t\t\texpected: nil,","+\t\t},","+\t\t{","+\t\t\tname: \"only worker nodes are ignored\",","+\t\t\tnodes: []*apimgmtv3.Node{","+\t\t\t\tworkerNode(\"w1\", corev1.Taint{Key: \"dedicated\", Value: \"gpu\", Effect: corev1.TaintEffectNoSchedule}),","+\t\t\t},","+\t\t\texpecte