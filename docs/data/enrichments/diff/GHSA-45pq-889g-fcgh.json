e the directory served.","+//","+// The memory backend is used because it resolves \"..\" by joining paths,","+// unlike the local backend which encodes the components as file names.","+func TestResticPathTraversal(t *testing.T) {","+\tctx := context.Background()","+","+\t// outside is the parent of the directory served and holds an object","+\t// which must stay unreachable through the server.","+\toutside := cmd.NewFsSrc([]string{\":memory:traversal-test\"})","+\t_, err := operations.Rcat(ctx, outside, \"outside-secret.txt\", io.NopCloser(strings.NewReader(\"SECRET\")), time.Now(), nil)","+\trequire.NoError(t, err)","+","+\tf := cmd.NewFsSrc([]string{\":memory:traversal-test/served-root\"})","+\t_, err = operations.Rcat(ctx, f, \"inside.txt\", io.NopCloser(strings.NewReader(\"INSIDE\")), time.Now(), nil)","+\trequire.NoError(t, err)","+","+\topt := newOpt()","+\ts, err := newServer(ctx, f, &opt)","+\trequire.NoError(t, err)","+\trouter := s.server.Router()","+","+\t// A path inside the served root is unaffected","+\tcheckRequest(t, router.ServeHTTP,","+\t\tnewRequest(t, \"GET\", \"/inside.txt\", nil),","+\t\t[]wantFunc{wantCode(http.StatusOK), wantBody(\"INSIDE\")})","+","+\tfor _, urlpath := range []string{","+\t\t\"..\",","+\t\t\"../\",","+\t\t\"../../\",","+\t\t\"../outside-secret.txt\",","+\t\t\"../../outside-secret.txt\",","+\t\t\"%2e%2e/outside-secret.txt\",","+\t\t\"../outside-write.txt\",","+\t\t\"a/../outside-secret.txt\",","+\t\t\"a/../../outside-secret.txt\",","+\t\t\".\",","+\t\t\"./inside.txt\",","+\t} {","+\t\tfor _, method := range []string{\"GET\", \"HEAD\", \"POST\", \"DELETE\"} {","+\t\t\tt.Run(method+\" /\"+urlpath, func(t *testing.T) {","+\t\t\t\treq := newRequest(t, method, \"/\"+urlpath, strings.NewReader(\"EVIL\"))","+\t\t\t\tcheckRequest(t, router.ServeHTTP, req, []wantFunc{wantCode(http.StatusBadRequest)})","+\t\t\t})","+\t\t}","+\t}","+","+\t// The object outside the served root was neither read nor modified, and","+\t// no new object was