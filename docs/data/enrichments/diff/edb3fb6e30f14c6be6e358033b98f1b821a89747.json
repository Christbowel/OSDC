earchRequest *ldapv3.SearchRequest, pagingSize uint32) (*ldapv3.SearchResult, error) {","+\t\t\tpagingAttributes = append(pagingAttributes, searchRequest.Attributes)","+\t\t\tswitch searchRequest.Filter {","+\t\t\tcase \"(&(objectClass=group)(|(distinguishedName=\" + groupDN + \")))\":","+\t\t\t\treturn &ldapv3.SearchResult{Entries: []*ldapv3.Entry{adGroupEntry(groupDN, \"group\")}}, nil","+\t\t\tcase \"(&(member=\" + groupDN + \")(objectClass=group))\":","+\t\t\t\treturn &ldapv3.SearchResult{Entries: []*ldapv3.Entry{adGroupEntry(parentDN, \"parent\")}}, nil","+\t\t\t}","+\t\t\treturn &ldapv3.SearchResult{}, nil","+\t\t},","+\t}","+","+\tuserPrincipal, groupPrincipals, err := provider.loginUser(conn, &credentials, &config)","+\trequire.NoError(t, err)","+","+\tassert.Equal(t, \"activedirectory_user://user\", userPrincipal.Name)","+\tassert.Equal(t, \"user\", userPrincipal.LoginName)","+","+\tvar groupNames []string","+\tfor _, g := range groupPrincipals {","+\t\tgroupNames = append(groupNames, g.Name)","+\t}","+\tassert.Equal(t, []string{\"activedirectory_group://S-1-5-group\", \"activedirectory_group://S-1-5-parent\"}, groupNames)"],"additions":260,"deletions":0,"truncated":false}],"additions":475,"deletions":34,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-10-01T15:00:22.837452+00:00"}