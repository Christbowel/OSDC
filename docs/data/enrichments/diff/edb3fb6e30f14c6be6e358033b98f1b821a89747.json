 UserScope,","+\t\t\texternalID: \"jdoe\",","+\t\t\tentries:    []*ldapv3.Entry{adUserEntry(\"cn=John Doe,\"+baseDN, \"jdoe\", \"512\")},","+\t\t\twantBase:   baseDN,","+\t\t\twantFilter: \"(&(objectClass=person)(sAMAccountName=jdoe))\",","+\t\t\twant: &v3.Principal{","+\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"activedirectory_user://jdoe\"},","+\t\t\t\tDisplayName:   \"jdoe\",","+\t\t\t\tLoginName:     \"jdoe\",","+\t\t\t\tPrincipalType: \"user\",","+\t\t\t\tProvider:      Name,","+\t\t\t\tMe:            true,","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:       \"group found in group search base\",","+\t\t\tscope:      GroupScope,","+\t\t\texternalID: \"engineering\",","+\t\t\tentries:    []*ldapv3.Entry{adGroupEntry(\"cn=Engineering,ou=groups,dc=foo,dc=bar\", \"engineering\")},","+\t\t\twantBase:   \"ou=groups,dc=foo,dc=bar\",","+\t\t\twantFilter: \"(&(objectClass=group)(sAMAccountName=engineering))\",","+\t\t\twant: &v3.Principal{","+\t\t\t\tObjectMeta:    metav1.ObjectMeta{Name: \"activedirectory_group://engineering\"},","+\t\t\t\tDisplayName:   \"engineering\",","+\t\t\t\tLoginName:     \"engineering\",","+\t\t\t\tPrincipalType: \"group\",","+\t\t\t\tProvider:      Name,","+\t\t\t\tMe:            true,","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:       \"filter value is escaped\",","+\t\t\tscope:      UserScope,","+\t\t\texternalID: \"j*doe(1)\",","+\t\t\twantBase:   baseDN,","+\t\t\twantFilter: `(&(objectClass=person)(sAMAccountName=j\\2adoe\\281\\29))`,","+\t\t\twantNotFnd: true,","+\t\t},","+\t\t{","+\t\t\tname:       \"not found is non-transient\",","+\t\t\tscope:      UserScope,","+\t\t\texternalID: \"ghost\",","+\t\t\twantBase:   baseDN,","+\t\t\twantFilter: \"(&(objectClass=person)(sAMAccountName=ghost))\",","+\t\t\twantNotFnd: true,","+\t\t},","+\t\t{","+\t\t\tname:       \"multiple entries\",","+\t\t\tscope:      UserScope,","+\t\t\texternalID: \"jdoe\",","+\t\t\tentries:    []*ldapv3.Entry{adUserEntry(\"cn=a,\"+baseDN, \"jdoe\", \"512\"), adUserEntry(\"cn=b,\"+baseDN, \"jdoe\", \"512\")},","+\t\t\twantBase:   baseDN,","+\t\t\twantFilter: \"(&(objectClass=person)(sAMAccountName=jdoe))\",","+\t\t\twantErr:    \"multiple entries found for sAMAccountName=jdoe\",","+\t\t},","+\t\t{","+\t\t\tname:       \"disabled user\",","+\t\t\tscope:      UserScope,","+\t\t\texternalID: \"jdoe\",","+\t\t\tentries:    []*ldapv3.Entry{adUserEntry(\"cn=John Doe,\"+baseDN, \"jdoe\", \"514\")},","+\t\t\twantBase:   baseDN,","+\t\t\twantFilter: \"(&(objectClass=person)(sAMAccountName=jdoe))\",","+\t\t\twantErr:    \"permission denied\",","+\t\t},","+\t\t{","+\t\t\tname:       \"search error\",","+\t\t\tscope:      UserScope,","+\t\t\texternalID: \"jdoe\",","+\t\t\tsearchErr:  ldapv3.NewError(ldapv3.LDAPResultUnavailable, fmt.Errorf(\"unavailable\")),","+\t\t\twantBase:   baseDN,","+\t\t\twantFilter: \"(&(objectClass=person)(sAMAccountName=jdoe))\",","+\t\t\twantErr:    \"error searching for sAMAccountName=jdoe\",","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\tconfig := identifierTestConfig()","+\t\t\tvar gotSearch *ldapv3.SearchRequest","+\t\t\tconn := &ldapFakes.FakeLdapConn{","+\t\t\t\tSearchFunc: func(searchRequest *ldapv3.SearchRequest) (*ldapv3.SearchResult, error) {","+\t\t\t\t\tgotSearch = searchRequest","+\t\t\t\t\tif tt.searchErr != nil {","+\t\t\t\t\t\treturn nil, tt.searchErr","+\t\t\t\t\t}","+\t\t\t\t\treturn &ldapv3.SearchResult{Entries: tt.entries}, nil","+\t\t\t\t},","+\t\t\t}","+","+\t\t\tgot, err := provider.searchPrincipalByAttribute(conn, tt.externalID, tt.scope, \"sAMAccountName\", &config)","+","+\t\t\trequire.NotNil(t, gotSearch)","+\t\t\tassert.Equal(t, tt.wantBase, gotSearch.BaseDN)","+\t\t\tassert.Equal(t, ldapv3.ScopeWholeSubtree, gotSearch.Scope)","+\t\t\tassert.Equal(t, tt.wantFilter, gotSearch.Filter)","+\t\t\tassert.Contains(t, gotSearch.Attributes, \"sAMAccountName\")","+","+\t\t\tswitch {","+\t\t\tcase tt.wantNotFn