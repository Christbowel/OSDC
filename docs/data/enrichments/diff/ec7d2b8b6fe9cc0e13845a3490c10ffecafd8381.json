uted with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Backend\\Tests\\Functional\\Controller;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Backend\\Controller\\SimpleDataHandlerController;","+use TYPO3\\CMS\\Core\\Cache\\Backend\\Typo3DatabaseBackend;","+use TYPO3\\CMS\\Core\\Cache\\CacheManager;","+use TYPO3\\CMS\\Core\\Http\\ServerRequest;","+use TYPO3\\CMS\\Core\\Localization\\LanguageServiceFactory;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class SimpleDataHandlerControllerTest extends FunctionalTestCase","+{","+    protected array $configurationToUseInTestInstance = [","+        'SYS' => [","+            'caching' => [","+                'cacheConfigurations' => [","+                    'pages' => [","+                        'backend' => Typo3DatabaseBackend::class,","+                    ],","+                ],","+            ],","+        ],","+    ];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/../../../../core/Tests/Functional/Fixtures/be_users.csv');","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/ClearCacheController/pages.csv');","+        $pageCache = $this->get(CacheManager::class)->getCache('pages');","+        $pageCache->set('root', ['dummy'], ['pageId_1']);","+        $pageCache->set('page', ['dummy'], ['pageId_2']);","+    }","+","+    #[Test]","+    public function cacheCommandFlushesCacheOfThePageAndLogsTheCommand(): void","+    {","+        $this->setUpBackendUserWithLanguage(1);","+","+        $this->get(SimpleDataHandlerController::class)->processAjaxRequest(","+            new ServerRequest()->withParsedBody(['cacheCmd' => '2'])","+        );","+","+        $pageCache = $this->get(CacheManager::class)->getCache('pages');","+        self::assertTrue($pageCache->has('root'));","+        self::assertFalse($pageCache->has('page'));","+        self::assertSame(1, $this->getConnectionPool()->getConnectionForTable('sys_log')->count('*', 'sys_log', ['type' => 3]));","+    }","+","+    #[Test]","+    public function cacheCommandPagesIsNotFlushedForEditorsWithoutPermission(): void","+    {","+        $this->setUpBackendUserWithLanguage(3);","+","+        $this->get(SimpleDataHandlerController::class)->processAjaxRequest(","+            new ServerRequest()->withParsedBody(['cacheCmd' => 'pages'])","+        );","+","+        $pageCache = $this->get(CacheManager::class)->getCache('pages');","+        self::assertTrue($pageCache->has('root'));","+        self::assertTrue($pageCache->has('page'));","+    }","+","+    private function setUpBackendUserWithLanguage(int $uid): void","+    {","+        $backendUser = $this->setUpBackendUser($uid);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+    }","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/DataHandling/DataHandler.php","lines":["@@ -8895,13 +8895,15 @@ protected function processClearCacheQueue(): void","      * $cacheCmd='cacheTag:[string]'","      * Flush page cache by given tag","      *","-     * Code that does not need a DataHandler otherwise should use","-     * \\TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher directly.","-     *","      * @param int|string $cacheCmd The cache command, see above description","+     * @deprecated since TYPO3 v15.0, will be removed in TYPO3 v16.0. Use \\TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher instead.","      */","     public function clear_cacheCmd($cacheCmd): void","     {","+        trigger_error(","+            'DataHandler->clear_cacheCmd() is deprecated since TYPO3 v15.0 and will be removed in TYPO3 v16.0. Use CacheFlusher->flush() with CacheFlushDemand::forCommand() instead.',","+            E_USER_DEPRECATED","+        );","         $demand = CacheFlushDemand::forCommand($cacheCmd);","         $this->cacheFlushLogger->logCommands($this->BE_USER, $demand->commands);","         $this->cacheFlusher->flush($demand, CacheFlushingContext::fromBackendUser($this->BE_USER));"],"additions":5,"deletions":3,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Deprecation-111298-DataHandlerClearCacheCmd.rst","lines":["@@ -0,0 +1,76 @@","+..  include:: /Includes.rst.txt","+","+..  _deprecation-111298-1793396636:","+","+====================================================","+Deprecation: #111298 - DataHandler->clear_cacheCmd()","+====================================================","+","+See :issue:`111298`","+","+Description","+===========","+","+The method","+:php:`\\TYPO3\\CMS\\Core\\DataHandling\\DataHandler->clear_cacheCmd()` has been","+deprecated. Cache commands such as \"pages\", \"all\", a page id or","+\"cacheTag:<tag>\" are flushed by","+:php:`\\TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher`, which needs no","+:php-short:`\\TYPO3\\CMS\\Core\\DataHandling\\DataHandler` instance, see","+:ref:`feature-111263-1793181135`.","+","+Impact","+======","+","+Calling the method triggers a PHP :php:`E_USER_DEPRECATED` error. The","+extension scanner reports usages.","+","+Affected installations","+======================","+","+Installations with extensions calling","+:php:`DataHandler->clear_cacheCmd()`, usually to flush caches without","+processing any data map or command map.","+","+Migration","+=========","+","+Flush the cache command with","+:php-short:`\\TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher`. Pass a","+:php-short:`\\TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushingContext` created from","+the backend user to keep checking the permissions of User TSconfig","+:typoscript:`options.clearCache`. Without it, the command is flushed","+unrestricted, which fits scheduler tasks or console commands.","+","+Before:","+","+..  code-block:: php","+","+    use TYPO3\\CMS\\Core\\DataHandling\\DataHandler;","+    use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","+","+    $dataHandler = GeneralUtility::makeInstance(DataHandler::class);","+    $dataHandler->start([], []);","+    $dataHandler->clear_cacheCmd('pages');","+","+After:","+","+..  code-block:: php","+","+    use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushDemand;","+    use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher;","+    use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushingContext;","+","+    public function __construct(","+        private readonly CacheFlusher $cacheFlusher,","+    ) {}","+","+    public function flushPageCaches(): void","+    {","+        $this->cacheFlusher->flush(","+            CacheFlushDemand::forCommand('pages'),","+            CacheFlushingContext::fromBackendUser($GLOBALS['BE_USER'])","+        );","+    }","+","+..  index:: PHP-API, FullyScanned, ext:core"],"additions":76,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Cache/Flush/DataHandlerCacheFlushTest.php","lines":["@@ -17,6 +17,7 @@"," "," namespace TYPO3\\CMS\\Core\\Tests\\Functional\\Cache\\Flush;"," ","+use PHPUnit\\Framework\\Attributes\\IgnoreDeprecations;"," use PHPUnit\\Framework\\Attributes\\Test;"," use Symfony\\Component\\DependencyInjection\\Container;"," use TYPO3\\CMS\\Core\\Cache\\Backend\\Typo3DatabaseBackend;","@@ -152,6 +153,7 @@ public function dataHandlerRunWithoutChangesDoesNotFlushCaches(): void","     }"," ","     #[Test]","+    #[IgnoreDeprecations]","     public function clearCacheCmdFlushesPageCacheAndReportsTheCommand(): void","     {","         $pageCache = $this->get(CacheManager::class)->getCache('pages');"],"additions":2,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Classes/Controller/FormEditorController.php","lines":["@@ -25,7 +25,8 @@"," use TYPO3\\CMS\\Backend\\Template\\ModuleTemplate;"," use TYPO3\\CMS\\Backend\\Template\\ModuleTemplateFactory;"," use TYPO3\\CMS\\Backend\\Utility\\BackendUtility;","-use TYPO3\\CMS\\Core\\Cache\\CacheManager;","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushD