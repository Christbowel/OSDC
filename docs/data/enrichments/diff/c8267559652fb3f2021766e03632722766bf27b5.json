onNumeric,","+        ..Default::default()","+    };","+    assert_eq!(want.to_pb().min_reader_ver, 193);","+    assert_eq!(","+        CsvFileFormatParams::default().to_pb().min_reader_ver,","+        MIN_READER_VER","+    );","+    common::test_load_old(","+        func_name!(),","+        &csv_file_format_params_v193,","+        193,","+        want.clone(),","+    )?;","+    common::test_pb_from_to(func_name!(), want)?;","+    Ok(())","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"src/query/formats/README.md","lines":["@@ -11,12 +11,26 @@ are preserved literally. The `ESCAPE` file-format option is **load only**:"," it changes neither output contents nor the decision to quote an output field."," This applies to both data and headers."," ","-For string-encoded values and headers:","-","-- `QUOTE_STYLE = 'quote_not_null'` always adds quotes.","-- `QUOTE_STYLE = 'quote_minimal'` adds quotes when the value contains the","-  configured quote, field delimiter, or the record delimiter's first byte. An","-  `ESCAPE` character alone does not require quoting.","+`QUOTE_STYLE` controls quoting of all non-NULL values:","+","+- `quote_not_null` (the default) quotes every non-NULL value, including numbers,","+  decimals, booleans, and BINARY.","+- `quote_non_numeric` quotes every non-NULL value except numbers and decimals.","+  Booleans, BINARY, dates/timestamps, and complex values are quoted.","+- `quote_minimal` quotes a value when it is empty, equals `NULL_DISPLAY`, or","+  contains the configured quote, field delimiter, or the record delimiter's","+  first byte. An `ESCAPE` character alone does not require quoting.","+","+Empty values and non-NULL values equal to `NULL_DISPLAY` are always quoted,","+including numeric values under `quote_non_numeric`. NULL itself is written as","+an unquoted `NULL_DISPLAY`. Headers follow the string/non-numeric quoting rules.","+With the default load options, quoted empty STRING and BINARY fields remain","+empty values, while unquoted empty fields are read as NULL.","+","+Compatibility note: `quote_not_null` previously left numbers, decimals,","+booleans, and non-empty BINARY unquoted. It now quotes these values as its name","+specifies. Use `quote_non_numeric` to keep ordinary numbers and decimals","+unquoted; unlike the old behavior, it also quotes booleans and BINARY."," "," To read this output without interpreting backslashes as escapes, use"," `ESCAPE = ''` on load (the default). For example, a quoted field containing a","@@ -28,10 +42,11 @@ not convert the pair to a tab."," "," Using the same named file format for load and unload does not guarantee a"," lossless round trip. Other options must also match the intended data semantics.","-For example, minimal quoting can make an empty string indistinguishable from","-an empty field representing NULL, or a literal `NULL_DISPLAY` string","-indistinguishable from NULL. Disabling input escaping does not resolve those","-collisions.","+For example, loading with `ALLOW_QUOTED_NULLS = true` interprets quoted literal","+NULL markers as NULL even though output quoted them for protection. Changing","+`QUOTED_EMPTY_FIELD_AS` or enabling `TRIM_SPACE` can also change values on load.","+Use a NULL marker without CSV delimiters, record delimiters, or quote characters;","+NULL markers are emitted verbatim, without CSV quoting or escaping."," "," Outputting a backslash-escaped CSV dialect is not currently supported. Setting"," `ESCAPE` does not opt into such an output dialect."],"additions":25,"deletions":10,"truncated":false},{"path":"src/query/formats/src/field_encoder/csv.rs","lines":["@@ -40,6 +40,7 @@ pub struct CsvQuoteSettings {","     pub quote_style: CsvQuoteStyle,","     pub field_delimiter: u8,","     pub record_delimiter: Vec<u8>,","+    pub null_display: Vec<u8>,"," }"," "," impl CsvQuoteSettings {","@@ -49,6 +50,7 @@ impl CsvQuoteSettings {","             quote_style: params.quote_style,","             field_delimiter: params.field_delimiter.as_bytes()[0],","             record_delimiter: params.record_delimiter.as_bytes().to_vec(),","+            null_display: params.null_display.as_bytes().to_vec(),","         }","     }"," }","@@ -59,6 +61,13 @@ pub enum StringFormatter {"," }"," "," impl StringFormatter {","+    fn write_binary(&self, bytes: &[u8], buf: &mut Vec<u8>) {","+        match self {","+            StringFormatter::Csv(settings) => write_csv_string_maybe_quoted(bytes, buf, settings),","+            StringFormatter::Text { .. } => buf.extend_from_slice(bytes),","+        }","+    }","+","     fn write_string(&self, bytes: &[u8], buf: &mut Vec<u8>) {","         match self {","             StringFormatter::Csv(settings) => write_csv_string_maybe_quoted(bytes, buf, settings),","@@ -91,11 +100,14 @@ pub fn write_csv_string(bytes: &[u8], buf: &mut Vec<u8>, quote: u8) {"," }"," "," fn csv_string_needs_quotes(bytes: &[u8], settings: &CsvQuoteSettings) -> bool {","-    bytes.iter().any(|byte| {","-        *byte == settings.quote_char","-            || *byte == settings.field_delimiter","-            || settings.record_delimiter[0] == *byte","-    })","+    // An unquoted empty field is read as NULL by default.","+    bytes.is_empty()","+        || bytes == settings.null_display","+        || bytes.iter().any(|byte| {","+            *byte == settings.quote_char","+                || *byte == settings.field_delimiter","+                || settings.record_delimiter[0] == *byte","+        })"," }"," "," pub fn write_csv_string_maybe_quoted(bytes: &[u8], buf: &mut Vec<u8>, settings: &CsvQuoteSettings) {","@@ -152,7 +164,7 @@ impl FieldEncoderCSV {","                     .settings","                     .binary_format","                     .encode(buf)?;","-                out_buf.extend_from_slice(&encoded);","+                self.string_formatter.write_binary(&encoded, out_buf);","             }","             Column::Opaque(c) => self.write_opaque(c, row_index, out_buf)?,","             Column::String(c) => {","@@ -160,6 +172,17 @@ impl FieldEncoderCSV {","                 self.string_formatter.write_string(buf.as_bytes(), out_buf);","             }"," ","+            Column::Boolean(c) => {","+                let bytes = if c.get_bit(row_index) {","+                    &self.simple.common_settings.true_bytes","+                } else {","+                    &self.simple.common_settings.false_bytes","+                };","+                self.string_formatter.write_string(bytes, out_buf);","+            }","+            Column::EmptyArray { .. } => self.string_formatter.write_string(b\"[]\", out_buf),","+            Column::EmptyMap { .. } => self.string_formatter.write_string(b\"{}\", out_buf),","+","             Column::Date(..)","             | Column::Timestamp(..)","             | Column::TimestampTz(..)","@@ -190,13 +213,36 @@ impl FieldEncoderCSV {","                 self.string_formatter.write_string(&buf, out_buf);","             }"," ","-            Column::Decimal(c) => self.write_decimal_trimmed(c, row_index, out_buf),","+            Column::Number(_) | Column::Decimal(_) => {","+                self.write_numeric(column, row_index, out_buf)?;","+            }","+","+            Column::Null { .. } => self.simple.write_null(out_buf),","+        }","+        Ok(())","+    }"," ","-            Column::Null { .. }","-            | Column::EmptyArray { .. }","-            | Column::EmptyMap { .. }","-            | Column::Number(_)","-            | Column::Boolean(_) => self.simple.write_field(column, row_index, out_buf, false)?,","+    fn write_numeric(","+        &self,","+        column: &Column,","+        row_index: usize,","+        out_buf: &mut Vec<u8>,","+    ) -> Result<()> {","+        let start = out_buf.len();","+        if let Column::Decimal(c) = column {","+            self.write_decimal_trimmed(c, row_index, out_buf);","+        } else {","+            self.simple.write_field(column, row_index, out_buf, false)?;","+        }","+        if let StringFormatter::Csv(settings) = &self.string_formatter {","+            if settings.quote_style == CsvQuoteStyle::QuoteNotNull","+                || csv_string_needs_quotes(&out_buf[start..], settings)","+            {","+                // Numeric renderings cannot contain any supported QUOTE character,","+                // so surround the appended value without allocating a scratch buffer.","+                out_buf.insert(start, settings.quote_char);","+                out_buf.push(settings.quote_char);","+            }","         }","         Ok(())","     }","@@ -250,7 +296,7 @@ impl FieldEncoderCSV {","             .settings","             .binary_format","             .encode(&bytes)?;","-        out_buf.extend_from_slice(&encoded);","+        self.string_formatter.write_binary(&encoded, out_buf);","         Ok(())","     }"," }"],"additions":59,"deletions":13,"truncated":false},{"path":"src/query/formats/src/output_format/csv.rs","lines":["@@ -127,6 +127,7 @@ mod tests {","     use databend_common_expression::FromData;","     use databend_common_expression::TableDataType;","     use databend_common_expression::TableField;","+    use databend_common_expression::types::BinaryType;","     use databend_common_expression::types::StringType;","     use databend_common_meta_app::principal::CsvFileFormatParams;","     use databend_common_meta_app::principal::CsvQuoteStyle;","@@ -137,6 +138,32 @@ mod tests {","     use crate::get_output_format;","     use crate::output_format::test_utils::gen_schema_and_block;"," ","+    #[test]","+    fn test_csv_output_empty_values() -> Result<()> {","+        let (schema, block) = gen_schema_and_block(","+            vec![","+                TableField::new(\"binary\", TableDataType::Binary.wrap_nullable()),","+                TableField::new(\"string\", TableDataType::String.wrap_nullable()),","+            ],","+            vec![","+                BinaryType::from_opt_data(vec![Some(b\"\".as_slice()), None]),",