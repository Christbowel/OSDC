{"id":"dcbd04da82b17bd3d1835b26d10a25b5cb16f34a","axis":"silent","repo":"directus/directus","sha":"dcbd04da82b17bd3d1835b26d10a25b5cb16f34a","parsed":{"files":[{"path":".changeset/ai-text-operation.md","lines":["@@ -0,0 +1,7 @@","+---","+'@directus/ai': minor","+'@directus/api': minor","+'@directus/app': minor","+---","+","+Added an AI Text flow operation that generates text or structured data with any configured AI provider and model"],"additions":7,"deletions":0,"truncated":false},{"path":".changeset/select-other-icons.md","lines":["@@ -0,0 +1,5 @@","+---","+'@directus/app': patch","+---","+","+Fixed choice icons not showing in the dropdown list when the field allows other values"],"additions":5,"deletions":0,"truncated":false},{"path":"api/src/ai/files/controllers/upload.ts","lines":["@@ -1,5 +1,5 @@"," import type { IncomingHttpHeaders } from 'node:http';","-import { AI_ALLOWED_MIME_TYPES, isFileUploadProviderType } from '@directus/ai';","+import { AI_ALLOWED_MIME_TYPES, AI_MAX_FILE_SIZE, isFileUploadProviderType } from '@directus/ai';"," import { ForbiddenError, InvalidPayloadError } from '@directus/errors';"," import Busboy from 'busboy';"," import type { RequestHandler } from 'express';","@@ -7,8 +7,6 @@ import { useLogger } from '../../../logger/index.js';"," import { uploadToProvider } from '../lib/upload-to-provider.js';"," import type { UploadedFile } from '../types.js';"," ","-const MAX_FILE_SIZE = 50 * 1024 * 1024; // 50MB","-"," const ALLOWED_MIME_TYPES: Set<string> = new Set(AI_ALLOWED_MIME_TYPES);"," "," interface ParsedMultipart {","@@ -36,7 +34,7 @@ async function parseMultipart(headers: IncomingHttpHeaders, stream: NodeJS.Reada"," "," \t\tconst bb = Busboy({"," \t\t\theaders: headers as Record<string, string>,","-\t\t\tlimits: { fileSize: MAX_FILE_SIZE, files: 1 },","+\t\t\tlimits: { fileSize: AI_MAX_FILE_SIZE, files: 1 },"," \t\t});"," "," \t\tbb.on('file', (_name, fileStream, info) => {","@@ -50,7 +48,7 @@ async function parseMultipart(headers: IncomingHttpHeaders, stream: NodeJS.Reada"," \t\t\t\tfileStream.destroy();"," "," \t\t\t\tsafeReject(","-\t\t\t\t\tnew InvalidPayloadError({ reason: `File exceeds maximum size of ${MAX_FILE_SIZE / (1024 * 1024)}MB` }),","+\t\t\t\t\tnew InvalidPayloadError({ reason: `File exceeds maximum size of ${AI_MAX_FILE_SIZE / (1024 * 1024)}MB` }),"," \t\t\t\t);"," \t\t\t});"," "],"additions":3,"deletions":5,"truncated":false},{"path":"api/src/ai/flow-operations/utils.test.ts","lines":["@@ -0,0 +1,252 @@","+import { Readable } from 'node:stream';","+import { AI_MAX_FILE_SIZE } from '@directus/ai';","+import { InvalidPayloadError, ServiceUnavailableError } from '@directus/errors';","+import { APICallError, RetryError, TypeValidationError } from 'ai';","+import { afterEach, describe, expect, test, vi } from 'vitest';","+import { getAccountabilityForRole } from '../../utils/get-accountability-for-role.js';","+import {","+\tassertAIEnabled,","+\tgetFileIds,","+\tgetOperationAccountability,","+\tparseModelKey,","+\treadFilesForModel,","+\treadPrompt,","+\ttoOperationError,","+} from './utils.js';","+","+const env = vi.hoisted(() => ({ AI_ENABLED: true as unknown }));","+","+vi.mock('@directus/env', async (importOriginal) => {","+\tconst actual = await importOriginal<typeof import('@directus/env')>();","+\treturn { ...actual, useEnv: () => ({ ...actual.useEnv(), AI_ENABLED: env.AI_ENABLED }) };","+});","+","+const { warn } = vi.hoisted(() => ({ warn: vi.fn() }));","+","+vi.mock('../../logger/index.js', () => ({","+\tuseLogger: () => ({ warn }),","+}));","+","+vi.mock('../../utils/get-accountability-for-role.js', () => ({","+\tgetAccountabilityForRole: vi.fn(async (role) => ({ role })),","+}));","+","+afterEach(() => {","+\tvi.clearAllMocks();","+\tenv.AI_ENABLED = true;","+});","+","+describe('assertAIEnabled', () => {","+\ttest.each([true, 'true'])('passes when AI_ENABLED is %s', (value) => {","+\t\tenv.AI_ENABLED = value;","+\t\texpect(() => assertAIEnabled()).not.toThrow();","+\t});","+","+\ttest.each([false, 'false'])('throws when AI_ENABLED is %s', (value) => {","+\t\tenv.AI_ENABLED = value;","+\t\texpect(() => assertAIEnabled()).toThrow(ServiceUnavailableError);","+\t});","+});","+","+describe('parseModelKey', () => {","+\ttest('splits the provider from the model id, keeping colons in the id', () => {","+\t\texpect(parseModelKey('openai:gpt-5')).toEqual({ provider: 'openai', model: 'gpt-5' });","+\t\texpect(parseModelKey('openai-compatible:llama3:8b')).toEqual({ provider: 'openai-compatible', model: 'llama3:8b' });","+\t});","+","+\ttest('allows the characters real model ids use', () => {","+\t\texpect(parseModelKey('openai-compatible:hf.co/org/model:Q4_K_M@latest').model).toBe(","+\t\t\t'hf.co/org/model:Q4_K_M@latest',","+\t\t);","+\t});","+","+\ttest.each(['gpt-5', 'mistral:large', 'openai:', '', null, undefined, 'google:../x', 'google:a?b', 'google:a#b'])(","+\t\t'rejects %s',","+\t\t(key) => {","+\t\t\texpect(() => parseModelKey(key)).toThrow(InvalidPayloadError);","+\t\t},","+\t);","+});","+","+describe('readPrompt', () => {","+\ttest('keeps strings and turns other values into JSON', () => {","+\t\texpect(readPrompt('Hi')).toBe('Hi');","+\t\texpect(readPrompt({ a: 1 })).toBe('{\"a\":1}');","+\t\texpect(readPrompt(0)).toBe('0');","+\t});","+","+\ttest.each([null, undefined, '', '  '])('rejects an empty prompt (%s)', (prompt) => {","+\t\texpect(() => readPrompt(prompt)).toThrow('\"prompt\" is required');","+\t});","+});","+","+describe('toOperationError', () => {","+\tconst apiError = (statusCode?: number) =>","+\t\tnew APICallError({","+\t\t\tmessage: 'Bad key sk-SECRET for PRIVATE PROMPT',","+\t\t\turl: 'https://api.example.com',","+\t\t\trequestBodyValues: { prompt: 'PRIVATE PROMPT' },","+\t\t\t...(statusCode ? { statusCode } : {}),","+\t\t});","+","+\tconst asText = (error: unknown) => JSON.stringify(error) + (error as Error).message;","+","+\ttest.each([","+\t\t[400, InvalidPayloadError, 'rejected the request (HTTP 400)'],","+\t\t[401, ServiceUnavailableError, 'refused the API key'],","+\t\t[429, ServiceUnavailableError, 'limiting requests'],","+\t\t[503, ServiceUnavailableError, 'failed (HTTP 503)'],","+\t\t[undefined, ServiceUnavailableError, \"couldn't be reached\"],","+\t])('maps HTTP %s to its own message, without the provider text', (status, type, message) => {","+\t\tconst error = toOperationError(apiError(status), 'openai');","+","+\t\texpect(error).toBeInstanceOf(type);","+\t\texpect((error as Error).message).toContain(message);","+\t\texpect(asText(error)).not.toMatch(/SECRET|PRIVATE/);","+\t});","+","+\ttest('logs the error name and status, not its message', () => {","+\t\ttoOperationError(apiError(401), 'openai');","+","+\t\texpect(warn).toHaveBeenCalledWith(","+\t\t\t{ provider: 'openai', error: 'AI_APICallError', status: 401 },","+\t\t\texpect.any(String),","+\t\t);","+","+\t\texpect(JSON.stringify(warn.mock.calls)).not.toMatch(/SECRET|PRIVATE/);","+\t});","+","+\ttest('reads the last attempt of a retried call', () => {","+\t\tconst retry = new RetryError({ message: 'Failed', reason: 'maxRetriesExceeded', errors: [apiError(429)] });","+","+\t\texpect((toOperationError(retry, 'openai') as Error).message).toContain('limiting requests');","+\t});","+","+\ttest('keeps a retry message out when the last error is not from the SDK', () => {","+\t\tconst retry = new RetryError({","+\t\t\tmessage: 'Failed: PRIVATE PROMPT',","+\t\t\treason: 'maxRetriesExceeded',","+\t\t\terrors: [new Error('PRIVATE PROMPT')],","+\t\t});","+","+\t\texpect(asText(toOperationError(retry, 'openai'))).not.toContain('PRIVATE');","+\t});","+","+\ttest(\"keeps other SDK errors' messages out, since they can quote the reply\", () => {","+\t\tconst error = new TypeValidationError({ value: { secret: 'PRIVATE REPLY' }, cause: new Error('bad') });","+","+\t\tconst result = toOperationError(error, 'openai');","+","+\t\texpect(result).toBeInstanceOf(InvalidPayloadError);","+\t\texpect(asText(result)).not.toContain('PRIVATE');","+\t});","+","+\ttest('returns other errors unchanged', () => {","+\t\tconst error = new Error('boom');","+","+\t\texpect(toOperationError(error, 'openai')).toBe(error);","+\t});","+});","+","+describe('getFileIds', () => {","+\ttest('counts a repeated id once', () => {","+\t\texpect(getFileIds(['a', 'a', { id: 'a' }, 'b'])).toEqual(['a', 'b']);","+\t});","+","+\ttest('reads ids from strings, arrays, and file objects', () => {","+\t\texpect(getFileIds('a, b,,c ')).toEqual(['a', 'b', 'c']);","+\t\texpect(getFileIds(['a', { id: 'b' }, 3])).toEqual(['a', 'b', '3']);","+\t\texpect(getFileIds({ id: 'a' })).toEqual(['a']);","+\t});","+","+\ttest('returns nothing for empty values', () => {","+\t\texpect(getFileIds(null)).toEqual([]);","+\t\texpect(getFileIds(undefined)).toEqual([]);","+\t\texpect(getFileIds([null, {}, ''])).toEqual([]);","+\t});","+});","+","+describe('getOperationAccountability', () => {","+\tconst context = { accountability: { user: 'user-1' }, database: {}, schema: {} } as any;","+","+\ttest('uses the trigger accountability by default', async () => {","+\t\texpect(await getOperationAccountability(undefined, context)).toBe(context.accountability);","+\t\texpect(await getOperationAccountability('$trigger', context)).toBe(context.accountability);","+\t\texpect(getAccountabilityForRole).not.toHaveBeenCalled();","+\t});","+","+\ttest.each([","+\t\t['$full', 'system'],","+\t\t['$public', null],","+\t\t['role-1', 'role-1'],","+\t])('maps %s to role %s', async (permissions, role) => {","+\t\tawait getOperationAccountability(permissions, context);","+\t\texpect(getAccountabilityForRole).toHaveBeenCalledWith(role, context);","+\t});","+});","+","+describe('readFilesForModel', () => {","+\tfunction mockAssets(files: Record<string, { file: Record<string, unknown>; chunks?: Buffer[] }>) {","+\t\tconst streams: Readable[] = [];","+","+\t\tconst getAsset = vi.fn(async (id: string) => {","+\t\t\tconst stream = Readable.from(files[id]!.chunks ?? []);","+\t\t\tvi.spyOn(stream, 'destroy');","+\t\t\tstreams.push(stream);","+\t\t\treturn { stream, file: files[id]!.file };","+\t\t});","+","+\t\tconst destroyed = () => streams.some((stream) => vi.mocked(stream.destroy).mock.calls.length > 0);","+","+\t\treturn { assets: { getAsset } as any, destroyed };","+\t}","+","+\ttest('reads each file with its type and name', async () => {","+\t\tconst { assets } = mockAssets({","+\t\t\t'file-1': {","+\t\t\t\tfile: { type: 'image/png', filename_download: 'cat.png' },","+\t\t\t\tchunks: [Buffer.from('ca'), Buffer.from('t')],","+\t\t\t},","+\t\t});","+","+\t\texpect(await readFilesForModel(assets, ['file-1'])).toEqual([","+\t\t\t{ data: Buffer.from('cat'), mediaType: 'image/png', filename: 'cat.png' },","+\t\t]);","+\t});","+","+\ttest('rejects types AI models cannot read and closes the stream', async () => {","+\t\tconst { assets, destroyed } = mockAssets({ 'file-1': { file: { type: 'application/zip' } } });","+","+\t\tawait expect(readFilesForModel(assets, ['file-1'])).rejects.toThrow(InvalidPayloadError);","+\t\texpect(destroyed()).toBe(true);","+\t});","+","+\ttest('rejects more than 20 files before reading any', async () => {","+\t\tconst { assets } = mockAssets({});","+\t\tconst ids = Array.from({ length: 21 }, (_, index) => `file-${index}`);","+","+\t\tawait expect(readFilesForModel(assets, ids)).rejects.toThrow('at most 20 files');","+\t\texpect(assets.getAsset).not.toHaveBeenCalled();","+\t});","+","+\ttest('rejects files that add up to more than the size limit', async () => {","+\t\tconst half = AI_MAX_FILE_SIZE / 2 + 1;","+","+\t\tconst { assets, destroyed } = mockAssets({","+\t\t\t'file-1': { file: { type: 'image/png', filesize: half }, chunks: [Buffer.alloc(half)] },","+\t\t\t'file-2': { file: { type: 'image/png', filesize: half } },","+\t\t});","+","+\t\tawait expect(readFilesForModel(assets, ['file-1', 'file-2'])).rejects.toThrow(InvalidPayloadError);","+\t\texpect(destroyed()).toBe(true);","+\t});","+","+\ttest('counts bytes while reading when the file size is unknown', async () => {","+\t\tconst { assets, destroyed } = mockAssets({","+\t\t\t'file-1': { file: { type: 'image/png', filesize: null }, chunks: [Buffer.alloc(AI_MAX_FILE_SIZE + 1)] },","+\t\t});","+","+\t\tawait expect(readFilesForModel(assets, ['file-1'])).rejects.toThrow(InvalidPayloadError);","+\t\texpect(destroyed()).toBe(true);","+\t});","+});"],"additions":252,"deletions":0,"truncated":false},{"path":"api/src/ai/flow-operations/utils.ts","lines":["@@ -0,0 +1,182 @@","+import { AI_ALLOWED_MIME_TYPES, AI_MAX_FILE_SIZE, isProviderType, type ProviderType } from '@directus/ai';","+import { useEnv } from '@directus/env';","+import { InvalidPayloadError, isDirectusError, ServiceUnavailableError } from '@directus/errors';","+import type { Accountability, SchemaOverview } from '@directus/types';","+import { toBoolean } from '@directus/utils';","+import { AISDKError, APICallError, RetryError } from 'ai';","+import type { Knex } from 'knex';","+import { useLogger } from '../../logger/index.js';","+import type { AssetsService } from '../../services/assets.js';","+import { getAccountabilityForRole } from '../../utils/get-accountability-for-role.js';","+","+/** `AI_ENABLED=false` turns off all AI features. The `/ai` routes aren't mounted, and flow steps refuse to run. */","+export function assertAIEnabled(): void {","+\tif (toBoolean(useEnv()['AI_ENABLED']) !== true) {","+\t\tthrow new ServiceUnavailableError({","+\t\t\tservice: 'ai',","+\t\t\treason: 'AI is turned off on this server (AI_ENABLED is false)',","+\t\t});","+\t}","+}","+","+/** Model ids can come from flow data, and some providers put them in the request URL. */","+const MODEL_ID = /^[\\w.\\-:/@]+$/;","+","+/** Splits `provider:model-id`. Model ids may contain colons. */","+export function parseModelKey(key: string | null | undefined): { provider: ProviderType; model: string } {","+\tconst [provider, ...rest] = (key ?? '').split(':');","+\tconst model = rest.join(':');","+","+\tif (!isProviderType(provider) || !model) {","+\t\tthrow new InvalidPayloadError({ reason: `\"model\" must look like \"provider:model-id\"` });","+\t}","+","+\tif (!MODEL_ID.test(model) || model.includes('..')) {","+\t\tthrow new InvalidPayloadError({ reason: `\"${model}\" isn't a valid model id` });","+\t}","+","+\treturn { provider, model };","+}","+","+/** The prompt after flow data is filled in. A missing value from the data chain is an empty prompt, not `\"\"`. */","+export function readPrompt(prompt: unknown): string {","+\tlet text = '';","+","+\tif (typeof prompt === 'string') text = prompt;","+\telse if (prompt !== null && prompt !== undefined) text = JSON.stringify(prompt);","+","+\tif (!text.trim()) {","+\t\tthrow new InvalidPayloadError({ reason: `\"prompt\" is required` });","+\t}","+","+\treturn text;","+}","+","+/**","+ * Turns AI SDK errors into ones Directus writes. Flows keep a failed step's error as its data, and can return it to a","+ * webhook caller. SDK errors hold the whole request, and their messages can quote the request, the reply, or","+ * credentials a provider echoed back, so none of that text is kept or logged.","+ */","+export function toOperationError(error: unknown, provider: ProviderType): unknown {","+\tif (isDirectusError(error) || !AISDKError.isInstance(error)) return error;","+","+\tconst cause = RetryError.isInstance(error) && AISDKError.isInstance(error.lastError) ? error.lastError : error;","+\tconst status = APICallError.isInstance(cause) ? cause.statusCode : undefined;","+","+\tuseLogger().warn({ provider, error: cause.name, status }, 'AI provider request failed');","+","+\tif (status === 401 || status === 403) {","+\t\treturn new ServiceUnavailableError({ service: provider, reason: 'The provider refused the API key' });","+\t}","+","+\tif (status === 429) {","+\t\treturn new ServiceUnavailableError({","+\t\t\tservice: provider,","+\t\t\treason: 'The provider is limiting requests. Try again later',","+\t\t});","+\t}","+","+\tif (status && status < 500) {","+\t\treturn new InvalidPayloadError({ reason: `The provider rejected the request (HTTP ${status})` });","+\t}","+","+\tif (status || APICallError.isInstance(cause) || RetryError.isInstance(cause)) {","+\t\treturn new ServiceUnavailableError({","+\t\t\tservice: provider,","+\t\t\treason: status ? `The provider failed (HTTP ${status})` : `The provider couldn't be reached`,","+\t\t});","+\t}","+","+\treturn new InvalidPayloadError({ reason: `The AI request failed (${cause.name})` });","+}","+","+/** Accepts ids, comma-separated ids, or file objects, as they come out of the data chain. Repeated ids count once. */","+export function getFileIds(value: unknown): string[] {","+\tconst values: unknown[] = typeof value === 'string' ? value.split(',') : [value].flat();","+","+\tconst ids = values","+\t\t.map((item) => (item && typeof item === 'object' ? (item as { id?: unknown }).id : item))","+\t\t.filter((id): id is string | number => typeof id === 'string' || typeof id === 'number')","+\t\t.map((id) => String(id).trim())","+\t\t.filter(Boolean);","+","+\treturn [...new Set(ids)];","+}","+","+/** Same `permissions` option as the item operations: $trigger, $public, $full, or a role id. */","+export async function getOperationAccountability(","+\tpermissions: string | undefined,","+\tcontext: { accountability: Accountability | null; database: Knex; schema: SchemaOverview },","+): Promise<Accountability | null> {","+\tconst { accountability } = context;","+","+\tif (!permissions || permissions === '$trigger') return accountability;","+\tif (permissions === '$full') return getAccountabilityForRole('system', context);","+\tif (permissions === '$public') return getAccountabilityForRole(null, context);","+\treturn getAccountabilityForRole(permissions, context);","+}","+","+const ALLOWED_TYPES: ReadonlySet<string> = new Set(AI_ALLOWED_MIME_TYPES);","+","+/** Ids can come from flow data, so the number of reads is capped too, not just their size */","+const MAX_FILES = 20;","+","+const MAX_SIZE_MB = AI_MAX_FILE_SIZE / (1024 * 1024);","+","+export interface ModelFile {","+\tdata: Buffer;","+\tmediaType: string;","+\tfilename: string | null;","+}","+","+/** Reads files one at a time, stopping once they add up to more than the AI file size limit. */","+export async function readFilesForModel(assets: AssetsService, ids: string[]): Promise<ModelFile[]> {","+\tif (ids.length > MAX_FILES) {","+\t\tthrow new InvalidPayloadError({ reason: `Send at most ${MAX_FILES} files to the model` });","+\t}","+","+\tconst files: ModelFile[] = [];","+\tlet remaining = AI_MAX_FILE_SIZE;","+","+\tfor (const id of ids) {","+\t\tconst file = await readFileForModel(assets, id, remaining);","+\t\tremaining -= file.data.length;","+\t\tfiles.push(file);","+\t}","+","+\treturn files;","+}","+","+async function readFileForModel(assets: AssetsService, id: string, limit: number): Promise<ModelFile> {","+\tconst { stream, file } = await assets.getAsset(id);","+","+\tif (!ALLOWED_TYPES.has(file.type)) {","+\t\tstream.destroy();","+\t\tthrow new InvalidPayloadError({ reason: `File \"${id}\" has type \"${file.type}\", which isn't supported here` });","+\t}","+","+\tconst tooLarge = () =>","+\t\tnew InvalidPayloadError({ reason: `Files sent to the model can't add up to more than ${MAX_SIZE_MB}MB` });","+","+\tif (Number(file.filesize) > limit) {","+\t\tstream.destroy();","+\t\tthrow tooLarge();","+\t}","+","+\tconst chunks: Buffer[] = [];","+\tlet size = 0;","+","+\t// `filesize` can be missing, so count while reading too","+\tfor await (const chunk of stream) {","+\t\tsize += chunk.length;","+","+\t\tif (size > limit) {","+\t\t\tstream.destroy();","+\t\t\tthrow tooLarge();","+\t\t}","+","+\t\tchunks.push(Buffer.from(chunk));","+\t}","+","+\treturn { data: Buffer.concat(chunks), mediaType: file.type, filename: file.filename_download ?? null };","+}"],"additions":182,"deletions":0,"truncated":false},{"path":"api/src/ai/tools/operations/prompt.md","lines":["@@ -63,6 +63,7 @@ Omit `position_x`/`position_y` - positions are handled automatically (see Positi"," "," <available_operations> Core operations available in Directus:"," ","+- **ai-text** - Generate text or structured data with a configured AI provider"," - **condition** - Evaluate filter rules to determine execution path"," - **exec** - Execute custom JavaScript/TypeScript code in sandboxed environment"," - **item-create** - Create items in a collection","@@ -163,7 +164,20 @@ same row, `reject` one row down. Wiring up the chain is all it takes to keep the"," Explicit positions are applied as-is (no layout pass) and re-derived on the next link change. Grid: 14x14 panels,"," columns every 18 units, rows every 16, first operation at (19,1). </positioning_system>"," ","-<operation_examples> **condition** - Evaluates filter rules","+<operation_examples> **ai-text** - Generate text or structured data. `model` is `provider:model-id` and the provider","+needs an API key in AI settings. Returns `{ text }`, or `{ output }` when `output` is `object`.","+","+```json","+{","+\t\"type\": \"ai-text\",","+\t\"options\": { \"model\": \"anthropic:claude-sonnet-5-5\", \"prompt\": \"Summarize: {{ $trigger.payload.body }}\" }","+}","+// Object: \"output\": \"object\", \"schema\": {\"type\": \"object\", \"properties\": {\"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"tags\"]} -> {{ op_key.output.tags }}","+// Keys left out of \"required\" are sent as nullable, so later steps always see every key (null when missing).","+// Optional: \"system\", \"files\" (file ids), \"maxOutputTokens\", \"permissions\"","+```","+","+**condition** - Evaluates filter rules"," "," ```json"," { \"type\": \"condition\", \"options\": { \"filter\": { \"$trigger\": { \"payload\": { \"status\": { \"_eq\": \"published\" } } } } } }"],"additions":15,"deletions":1,"truncated":false},{"path":"api/src/flows.test.ts","lines":["@@ -45,6 +45,7 @@ vi.mock('./services/flows.js', () => ({"," "," vi.mock('./utils/get-schema.js', () => ({ getSchema }));"," vi.mock('./utils/schedule.js', () => ({ scheduleSynchronizedJob, validateCron: () => true }));","+vi.mock('./utils/redact-object.js', () => ({ redactObject: vi.fn((obj: unknown) => obj) }));"," "," function flushPromises() {"," \treturn new Promise((resolve) => setImmediate(resolve));","@@ -77,6 +78,24 @@ describe('FlowManager', () => {"," \t\tvi.resetAllMocks();"," \t});"," ","+\ttest.each([","+\t\t['log', true],","+\t\t['ai-text', true],","+\t\t['item-read', false],","+\t])('redacts secrets from flow data before a %s step: %s', async (type, redacted) => {","+\t\tconst { redactObject } = await import('./utils/redact-object.js');","+\t\tconst { FLOW_SECRET_KEYS } = await import('./constants.js');","+","+\t\tconst manager = getFlowManager();","+\t\tmanager.addOperation(type, vi.fn());","+","+\t\tconst operation = { type, options: {}, resolve: null, reject: null } as any;","+\t\tawait (manager as any).executeOperation(operation, { $trigger: {} });","+","+\t\tconst calls = vi.mocked(redactObject).mock.calls.filter(([, redact]) => redact.keys === FLOW_SECRET_KEYS);","+\t\texpect(calls.length > 0).toBe(redacted);","+\t});","+"," \tasync function initializeWith(flows: FlowRaw[]) {"," \t\treadByQuery.mockResolvedValueOnce(flows);"," "],"additions":19,"deletions":0,"truncated":false},{"path":"api/src/flows.ts","lines":["@@ -61,6 +61,9 @@ const ACCOUNTABILITY_KEY = '$accountability';"," const LAST_KEY = '$last';"," const ENV_KEY = '$env';"," ","+/** Log and the AI steps are often given whole trigger objects, so secrets are redacted before they're logged or sent out */","+const REDACTED_OPERATIONS = ['log', 'ai-text'];","+"," /** Retries of a failed flows read on reload, waiting 1s then 2s */"," const RELOAD_READ_RETRIES = 2;"," ","@@ -571,7 +574,7 @@ class FlowManager {"," "," \t\tlet optionData = keyedData;"," ","-\t\tif (operation.type === 'log') {","+\t\tif (REDACTED_OPERATIONS.includes(ope