ess(c, filepath.ToSlash(relativePath), model.GetPublishAccess())","+\t})"," }"," "," func serveTemplates(ginServer *gin.Engine) {","-\ttemplates := ginServer.Group(\"/templates/\", model.CheckAuth)","-\ttemplates.Static(\"\", filepath.Join(util.DataDir, \"templates\"))","+\ttemplates := ginServer.Group(\"/templates/\", model.CheckAuth, model.CheckAdminRole)","+\tregisterStaticFileHandlers(templates, filepath.Join(util.DataDir, \"templates\"), true, nil)"," }"," "," func servePublic(ginServer *gin.Engine) {","@@ -437,7 +454,12 @@ func servePublic(ginServer *gin.Engine) {"," "," func serveSnippets(ginServer *gin.Engine) {"," \tginServer.Handle(\"GET\", \"/snippets/*filepath\", model.CheckAuth, func(c *gin.Context) {","-\t\tfilePath := strings.TrimPrefix(c.Request.URL.Path, \"/snippets/\")","+\t\tfilePath, ok := cleanStaticRelativePath(c.Param(\"filepath\"))","+\t\tif !ok {","+\t\t\tc.Status(http.StatusForbidden)","+\t\t\treturn","+\t\t}","+\t\tfilePath = filepath.ToSlash(filePath)"," \t\tif !model.IsAdminRoleContext(c) {"," \t\t\tif \"conf.json\" == filePath {"," \t\t\t\tc.Status(http.StatusUnauthorized)","@@ -447,6 +469,18 @@ func serveSnippets(ginServer *gin.Engine) {"," "," \t\text := filepath.Ext(filePath)"," \t\tname := strings.TrimSuffix(filePath, ext)","+\t\tif model.IsReadOnlyRoleContext(c) {","+\t\t\tfound, accessable := model.CheckSnippetAccessableInPublish(name, strings.TrimPrefix(ext, \".\"))","+\t\t\tif !found {","+\t\t\t\tc.Status(http.StatusNotFound)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif !accessable {","+\t\t\t\tc.Status(http.StatusForbidden)","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+"," \t\tconfSnippets, err := model.LoadSnippets()"," \t\tif err != nil {"," \t\t\tlogging.LogErrorf(\"load snippets failed: %s\", err)","@@ -463,21 +497,97 @@ func serveSnippets(ginServer *gin.Engine) {"," \t\t}"," "," \t\t// 没有在配置文件中命中时在文件系统上查找","-\t\tfilePath = filepath.Join(util.SnippetsPath, filePath)","+\t\tserveStaticFile(c, util.SnippetsPath, filePath, false)","+\t