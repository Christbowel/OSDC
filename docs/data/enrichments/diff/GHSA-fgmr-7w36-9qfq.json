+\treturn","+}","+","+func CheckPluginAccessableInPublish(name string) bool {","+\tif name == \"\" || !IsPetalsEnabled() {","+\t\treturn false","+\t}","+","+\tpetal := getPetalByName(name, getPetals())","+\tif petal == nil || !petal.Enabled {","+\t\treturn false","+\t}","+","+\tfound, _, _, _, disabledInPublish, disallowInstall, _ := bazaar.ParseInstalledPlugin(name, \"\")","+\treturn found && !disabledInPublish && !disallowInstall","+}","+","+func CheckWidgetAccessableInPublish(name string) bool {","+\tif name == \"\" {","+\t\treturn false","+\t}","+\twidget, err := bazaar.ParsePackageJSON(filepath.Join(util.DataDir, \"widgets\", name, \"widget.json\"))","+\treturn err == nil && widget != nil && !widget.DisabledInPublish","+}","+","+func CheckWidgetAccessableByPublishAccess(c *gin.Context, name string, publishAccess PublishAccess) bool {","+\tif !CheckWidgetAccessableInPublish(name) {","+\t\treturn false","+\t}","+\treturn checkResourceAccessableByPublishAccess(c, name, publishAccess, true)","+}","+","+func CheckEmojiAccessableByPublishAccess(c *gin.Context, relativePath string, publishAccess PublishAccess) bool {","+\trelativePath = normalizePublishResourcePath(relativePath)","+\tif relativePath == \"\" {","+\t\treturn false","+\t}","+\treturn checkResourceAccessableByPublishAccess(c, relativePath, publishAccess, false)","+}","+","+func checkResourceAccessableByPublishAccess(c *gin.Context, resource string, publishAccess PublishAccess, widget bool) bool {","+\tfor _, bt := range treenode.GetBlockTreesByType(\"d\") {","+\t\tif !checkBlockTreeAccessableByPublishAccess(c, publishAccess, bt) {","+\t\t\tcontinue","+\t\t}","+","+\t\trefs := getPublishResourceRefs(bt)","+\t\tif widget {","+\t\t\tif _, ok := refs.widgets[resource]; ok {","+\t\t\t\treturn true","+\t\t\t}","+\t\t} else if _, ok := refs.emojis[resource]; ok {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func getPublishResourceRefs(bt *treenode.BlockTree) *publishResourceRefs {","+\tcacheKey := bt.BoxID + \"/\" + bt.RootID","+\tif cached, ok := publishResourceRefsCache.Load(cacheKey); ok {","+\t\trefs := cached.(*publishResourceRefs)","+\t\tif refs.updated == bt.Updated {","+\t\t\treturn refs","+\t\t}","+\t}","+","+\trefs := &publishResourceRefs{","+\t\tupdated: bt.Updated,","+\t\twidgets: map[string]struct{}{},","+\t\temojis:  map[string]struct{}{},","+\t}","+\ttree, err := loadTreeByBlockIDInBox(bt.RootID, bt.BoxID)","+\tif err != nil || tree == nil {","+\t\treturn refs","+\t}","+","+\trefs.widgets = widgetPackagesInTree(tree)","+\tfor _, emoji := range emojisInTree(tree) {","+\t\tif relativePath := publishResourceURLPath(emoji, \"/emojis/\"); relativePath != \"\" {","+\t\t\trefs.emojis[relativePath] = struct{}{}","+\t\t}","+\t}","+\tpublishResourceRefsCache.Store(cacheKey, refs)","+\treturn refs","+}","+","+func widgetPackagesInTree(tree *parse.Tree) map[string]struct{} {","+\tret := map[string]struct{}{}","+\tast.Walk(tree.Root, func(n *ast.Node, entering bool) ast.WalkStatus {","+\t\tif !entering || (n.Type != ast.NodeWidget && n.Type != ast.NodeIFrame &&","+\t\t\tn.Type != ast.NodeHTMLBlock && n.Type != ast.NodeInlineHTML) {","+\t\t\treturn ast.WalkContinue","+\t\t}","+","+\t\tnodes, err := lutehtml.ParseFragment(bytes.NewReader(n.Tokens), &lutehtml.Node{Type: lutehtml.ElementNode})","+\t\tif err != nil {","+\t\t\treturn ast.WalkContinue","+\t\t}","+\t\tfor _, node := range nodes {","+\t\t\twalkPublishResourceHTML(node, func(value string) {","+\t\t\t\trelativePath := publishResourceURLPath(value, \"/widgets/\")","+\t\t\t\tif relativePath == \"\" {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tname, _, _ := strings.Cut(relativePath, \"/\")","+\t\t\t\tif name != \"\" {","+\t\t\t\t\tret[name] = struct{}{}","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t\treturn ast.WalkContinue","+\t})","+\treturn ret","+}","+","+func walkPublishResourceHTML(node *lutehtml.Node, visit func(string)) {","+\tfor _, attr := range node.Attr {","+\t\tvisit(attr.Val)","+\t}","+\tfor child := node.FirstChild; child != nil; child = child.NextSibling {","+\t\twalkPublishResourceHTML(child, visit)","+\t}","+}","+","+func publishResourceURLPath(value, prefix string) string {","+\tvalue = strings.TrimSpace(stdhtml.UnescapeString(value))","+\tparsed, err := url.Parse(value)","+\tif err != nil {","+\t\treturn \"\"","+\t}","+\tif parsed.Host != \"\" && !util.IsLocalHostname(parsed.Hostname()) {","+\t\treturn \"\"","+\t}","+\tcleanPath := path.Clean(parsed.Path)","+\tif !strings.HasPrefix(cleanPath, prefix) {","+\t\treturn \"\"","+\t}","+\treturn normalizePublishResourcePath(strings.TrimPrefix(cleanPath, prefix))","+}","+","+func normalizePublishResourcePath(relativePath string) string {","+\trelativePath = filepath.ToSlash(filepath.Clean(filepath.FromSlash(strings.TrimPrefix(relativePath, \"/\"))))","+\tif relativePath == \".\" || relativePath == \"..\" || strings.HasPrefix(relativePath, \"../\") {","+\t\treturn \"\"","+\t}","+\treturn relativePath","+}"],"additions":202,"deletions":0,"truncated":false},{"path":"kernel/model/publish_resource_access_test.go","lines":["@@ -0,0 +1,181 @@","+// SiYuan - Refactor your thinking","+// Copyright (c) 2020-present, b3log.org","+//","+// This program is free software: you can redistribute it and/or modify","+// it under the terms of the GNU Affero General Public License as published by","+// the Free Software Foundation, either version 3 of the License, or","+// (at your option) any later version.","+//","+// This program is distributed in the hope that it will be useful,","+// but WITHOUT ANY WARRANTY; without even the implied warranty of","+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the","+// GNU Affero General Public License for more details.","+//","+// You should have received a copy of the GNU Affero General Public License","+// along with this program.  If not, see <https://www.gnu.org/licenses/>.","+","+package model","+","+import (","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+","+\t\"github.com/88250/lute/ast\"","+\t\"github.com/88250/lute/parse\"","+\t\"github.com/siyuan-note/siyuan/kernel/conf\"","+\t\"github.com/siyuan-note/siyuan/kernel/util\"","+)","+","+func TestPublishResourceURLPath(t *testing.T) {","+\ttests := []struct {","+\t\tvalue    string","+\t\tprefix   string","+\t\texpected string","+\t}{","+\t\t{\"/widgets/example/\", \"/widgets/\", \"example\"},","+\t\t{\"http://127.0.0.1:6806/emojis/icon.png?v=1\", \"/emojis/\", \"icon.png\"},","+\t\t{\"https://example.com/widgets/external/\", \"/widgets/\", \"\"},","+\t\t{\"/assets/icon.png\", \"/emojis/\", \"\"},","+\t\t{\"/widgets/../templates/private.md\", \"/widgets/\", \"\"},","+\t}","+\tfor _, test := range tests {","+\t\tif actual := publishResourceURLPath(test.value, test.prefix); actual != test.expected {","+\t\t\tt.Fatalf(\"publishResourceURLPath(%q, %q) = %q, expected %q\", test.value, test.prefix, actual, test.expected)","+\t\t}","+\t}","+}","+","+func TestWidgetPackagesInTree(t *testing.T) {","+\troot := &ast.Node{Type: ast.NodeDocument}","+\troot.AppendChild(&ast.Node{","+\t\tType:   ast.NodeWidget,","+\t\tTokens: []byte(`<iframe src=\"/widgets/example/\"></iframe>`),","+\t})","+\troot.AppendChild(&ast.Node{","+\t\tType:   ast.NodeHTMLBlock,","+\t\tTokens: []byte(`<img data-resource=\"/widgets/from-html/image.png\">`),","+\t})","+\troot.AppendChild(&ast.Node{","+\t\tType:   ast.NodeIFrame,","+\t\tTokens: []byte(`<iframe src=\"https://example.com/widgets/external/\"></iframe>`),","+\t})","+","+\twidgets := widgetPackagesInTree(&parse.Tree{Root: root})","+\tfor _, name := range []string{\"example\", \"from-html\"} {","+\t\tif _, ok := widgets[name]; !ok {","+\t\t\tt.Fatalf(\"widget package [%s] was not extracted\", name)","+\t\t}","+\t}","+\tif _, ok := widgets[\"external\"]; ok {","+\t\tt.Fatal(\"external widget URL should not authorize a local widget package\")","+\t}","+}","+","+func TestCheckSnippetAccessableInPublish(t *testing.T) {","+\toriginalSnippetsPath := util.SnippetsPath","+\tutil.SnippetsPath = t.TempDir()","+\tt.Cleanup(func() {","+\t\tutil.SnippetsPath = originalSnippetsPath","+\t})","+","+\tif err := SetSnippet([]*conf.Snippet{","+\t\t{Name: \"allowed\", Type: \"css\"},","+\t\t{Name: \"disabled\", Type: \"js\", DisabledInPublish: true},","+\t}); err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\tif found, accessable := CheckSnippetAccessableInPublish(\"allowed\", \"css\"); !found || !accessable {","+\t\tt.Fatal(\"publish-enabled snippet should be accessable\")","+\t}","+\tif found, accessable := CheckSnippetAccessableInPublish(\"disabled\", \"js\"); !found || accessable {","+\t\tt.Fatal(\"publish-disabled snippet should not be accessable\")","+\t}","+\tif found, _ := CheckSnippetAccessableInPublish(\"missing\", \"js\"); found {","+\t\tt.Fatal(\"missing snippet should not be found\")","+\t}","+}","+","+func TestCheckPluginAccessableInPublish(t *testing.T) {","+\toriginalDataDir := util.DataDir","+\toriginalConf := Conf","+\tutil.DataDir = t.TempDir()","+\tConf = NewAppConf()","+\tConf.Bazaar = &conf.Bazaar{Trust: true}","+\tt.Cleanup(func() {","+\t\tutil.DataDir = originalDataDir","+\t\tConf = originalConf","+\t})","+","+\twritePlugin := func(name string, disabledInPublish bool) {","+\t\tdir := filepath.Join(util.DataDir, \"plugins\", name)","+\t\tif err := os.MkdirAll(dir, 0755); err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t\tdisabled := \"false\"","+\t\tif disabledInPublish {","+\t\t\tdisabled = \"true\"","+\t\t}","+\t\tdata := []byte(`{\"name\":\"` + name + `\",\"version\":\"1.0.0\",\"minAppVersion\":\"0.0.1\",\"disabledInPublish\":` + disabled + `}`)","+\t\tif err := os.WriteFile(filepath.Join(dir, \"plugin.json\"), data, 0644); err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t}","+\twritePlugin(\"allowed\", false)","+\twritePlugin(\"publish-disabled\", true)","+\twritePlugin(\"disabled\", false)","+\tif err := os.MkdirAll(filepath.Join(util.DataDir, \"storage\", \"petal\"), 0755); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tsavePetals([]*Petal{","+\t\t{Name: \"allowed\", Enabled: true},","+\t\t{Name: \"publish-disabled\", Enabled: true},","+\t\t{Name: \"disabled\", Enabled: false},","+\t})","+","+\tif !CheckPluginAccessableInPublish(\"allowed\") {","+\t\tt.Fatal(\"enabled plugin should be accessable in publish\")","+\t}","+\tif CheckPluginAccessableInPublish(\"publish-disabled\") {","+\t\tt.Fatal(\"publish-disabled plugin should not be accessable\")","+\t}","+\tif CheckPluginAccessableInPublish(\"disabled\") {","+\t\tt.Fatal(\"disabled plugin should not be accessable\")","+\t}","+}","+","+func TestCheckWidgetAccessableInPublish(t *testing.T) {","+\toriginalDataDir := util.DataDir","+\tutil.DataDir = t.TempDir()","+\tt.Cleanup(func() {","+\t\tutil.DataDir = originalDataDir","+\t})","+","+\twriteWidget := func(name string, disabledInPublish bool) {","+\t\tdir := filepath.Join(util.DataDir, \"widgets\", name)","+\t\tif err := os.MkdirAll(dir, 0755); err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t\tdisabled := \"false\"","+\t\tif disabledInPublish {","+\t\t\tdisabled = \"true\"","+\t\t}","+\t\tdata := []byte(`{\"name\":\"` + name + `\",\"disabledInPublish\":` + disabled + `}`)","+\t\tif err := os.WriteFile(filepath.Join(dir, \"widget.json\"), data, 0644); err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t}","+\twriteWidget(\"allowed\", false)","+\twriteWidget(\"disabled\", true)","+","+\tif !CheckWidgetAccessableInPublish(\"allowed\") {","+\t\tt.Fatal(\"publish-enabled widget should be accessable\")","+\t}","+\tif CheckWidgetAccessableInPublish(\"disabled\") {","+\t\tt.Fatal(\"publish-disabled widget should not be accessable\")","+\t}","+\tif CheckWidgetAccessableInPublish(\"missing\") {","+\t\tt.Fatal(\"missing widget should not be accessable\")","+\t}","+}"],"additions":181,"deletions":0,"truncated":false},{"path":"kernel/server/serve.go","lines":["@@ -322,7 +322,7 @@ func rewritePortJSON(pid, port string) {"," "," func serveExport(ginServer *gin.Engine) {"," \t// Po