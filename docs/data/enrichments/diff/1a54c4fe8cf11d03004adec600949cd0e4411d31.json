int: false,","+  });","+  await clientSession.opened;","+  const serverSession = await serverSessionReady.promise;","+  await clientSession.close({","+    code: 1n,","+    type: 'application',","+    reason,","+  });","+","+  await assert.rejects(serverSession.closed, {","+    code: 'ERR_QUIC_APPLICATION_ERROR',","+    reason: expectedReason,","+  });","+  await serverEndpoint.close();","+}","+","+// Client close where truncating at the byte limit would split a UTF-8 sequence.","+{","+  const prefix = 'a'.repeat(kMaxReasonLength - 1);","+  const reason = `${prefix}€`;","+  const serverSessionReady = Promise.withResolvers();","+","+  const serverEndpoint = await listen(mustCall(async (serverSession) => {","+    serverSession.onerror = mustCall((error) => {","+      assert.strictEqual(error.reason, prefix);","+    });","+    await serverSession.opened;","+    serverSessionReady.resolve(serverSession);","+  }));","+","+  const clientSession = await connect(serverEndpoint.address, {","+    reuseEndpoint: false,","+  });","+  await clientSession.opened;","+  const serverSession = await serverSessionReady.promise;","+  await clientSession.close({","+    code: 2n,","+    type: 'application',","+    reason,","+  });","+","+  await assert.rejects(serverSession.closed, {","+    code: 'ERR_QUIC_APPLICATION_ERROR',","+    reason: prefix,","+  });","+  await serverEndpoint.close();","+}","+","+// Server close exercises the server-specific CONNECTION_CLOSE packet path.","+{","+  const reason = 's'.repeat(kMaxReasonLength + 1);","+  const expectedReason = reason.slice(0, kMaxReasonLength);","+  const serverSessionReady = Promise.withResolvers();","+","+  const serverEndpoint = await listen(mustCall(async (serverSession) => {","+    await serverSession.opened;","+    serverSessionReady.resolve(serverSession);","+  }));","+","+  const clientSession = await connect(serverEndpoint.address, {","+    reuseEndpoint: false,","+    onerror: mustCall((error) => {","+      assert.strictEqual(error.reason, expectedReason);","+    }),","+  });","+  await clientSession.opened;","+  const serverSession = await serverSessionReady.promise;","+  await serverSession.close({","+    code: 3n,","+    type: 'application',","+    reason,","+  });","+","+  await assert.rejects(clientSession.closed, {","+    code: 'ERR_QUIC_APPLICATION_ERROR',","+    reason: expectedReason,","+  });","+  await serverEndpoint.close();","+}",""],"additions":110,"deletions":0,"truncated":false}],"additions":139,"deletions":10,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-21T13:27:19.672839+00:00"}