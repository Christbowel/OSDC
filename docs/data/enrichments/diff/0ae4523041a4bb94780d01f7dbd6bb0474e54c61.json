ck_n`) is omitted if the LHS (RHS) has no non-contracting dimension.","   // TODO(b/515334583): when supported, we can propagate tile from the dot","   // directly, avoiding the need to play with the output tiles.","   using TilingSpace = experimental::TilingSpace;","   using DimensionSemantics = TilingSpace::DimensionSemantics;","   using DimensionInfo = TilingSpace::DimensionInfo;"," ","-  int64_t dot_rank = dot->shape().dimensions().size();","-  if (dot_rank < 2) {","-    return absl::InternalError(absl::StrCat(","-        \"Expected dot instruction shape to have rank >= 2, got \", dot_rank));","+  // An operand without non-contracting dimensions (vector-matrix product) has","+  // no M (or N) tile.","+  ABSL_ASSIGN_OR_RETURN(auto operands_dims, DotOperandDims::FromDot(dot));","+  llvm::SmallVector<int64_t, 2> mn_tile_sizes;","+  if (operands_dims[0].Rank(DotOperandDims::kNonContracting) > 0) {","+    mn_tile_sizes.push_back(config.block_m);","   }","-  llvm::SmallVector<int64_t> expected_dot_tile_sizes(dot_rank - 2, 1);","-  expected_dot_tile_sizes.append({config.block_m, config.block_n});","+  if (operands_dims[1].Rank(DotOperandDims::kNonContracting) > 0) {","+    mn_tile_sizes.push_back(config.block_n);","+  }","+  auto with_leading_ones = [&](int64_t rank) {","+    llvm::SmallVector<int64_t> tile_sizes(rank - mn_tile_sizes.size(), 1);","+    tile_sizes.append(mn_tile_sizes);","+    return tile_sizes;","+  };","+","+  llvm::SmallVector<int64_t> expected_dot_tile_sizes =","+      with_leading_ones(dot->shape().dimensions().size());","   if (fusion_adaptor.GetRoots().size() != 1) {","     return absl::InternalError(","         absl::StrCat(\"Expected fusion to have a single root, got \",","                      fusion_adaptor.GetRoots().size()));","   }","   int64_t root_rank = fusion_adaptor.GetRoots()[0].shape().dimensions().size();","-  if (root_rank < 2) {","-    return absl::InternalError(absl::StrCat(","-        \"Expected computation root shape to have rank >= 2, got \", root_rank));","+  if (root_rank < mn_tile_sizes.size()) {","+    return absl::InternalError(","+        absl::StrCat(\"Expected computation root shape to have rank >= \",","+                     mn_tile_sizes.size(), \", got \", root_rank));","   }","-  llvm::SmallVector<int64_t> parallel_tile_sizes(root_rank - 2, 1);","-  parallel_tile_sizes.append({config.block_m, config.block_n});","+  llvm::SmallVector<int64_t> parallel_tile_sizes = with_leading_ones(root_rank);","   absl::c_sort(parallel_tile_sizes);"," ","   do {"],"additions":29,"deletions":17,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/convert_triton_gemm_config_test.cc","lines":["@@ -290,5 +290,34 @@ ENTRY entry {"," )\"));"," }"," ","+TEST_F(ConvertTritonGemmConfigTest, VectorMatrixDot) {","+  absl::string_view hlo = R\"(","+dot {","+  lhs = f32[512] parameter(0)","+  rhs = f32[512,8192] parameter(1)","+  ROOT dot = f32[8192] dot(lhs, rhs),","+    lhs_contracting_dims={0}, rhs_contracting_dims={0}","+}","+","+ENTRY entry {","+  p0 = f32[512] parameter(0)","+  p1 = f32[512,8192] parameter(1)","+  ROOT fusion = f32[8192] fusion(p0, p1),","+    kind=kCustom, calls=dot, backend_config={","+      \"fusion_backend_config\": {","+        \"kind\":\"__triton_gemm\", \"triton_gemm_config\": {","+          \"block_m\":\"16\", \"block_n\":\"256\", \"block_k\":\"32\",","+          \"num_stages\":\"5\", \"num_warps\":\"4\", \"num_ctas\":\"1\"","+        }","+      }","+    }","+})\";","+","+  std::unique_ptr<VerifiedHloModule> module = RunConvertTritonGemmConfig(hlo);","+  EXPECT_TRUE(*RunFileCheck(module->ToString(), R\"(","+    CHECK: \"output_tiles\":[{\"sizes\":[\"256\"]}]","+)\"));","+}","+"," }  // namespace"," }  // namespace xla::gpu",""],"additions":29,"deletions":0,"truncated":false}],"additions":161,"deletions":20,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-23T14:15:10.522614+00:00"}