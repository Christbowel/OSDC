{"id":"GHSA-h6v6-rg66-fqj4","axis":"advisories","repo":"flavorjones/loofah","sha":"7ba1e7b77e043fb7dc832ef746fcbf83137135e6","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -13,6 +13,7 @@"," ### Added"," "," * `Loofah::HTML5::Scrub.prefixed_attribute_name` and `Loofah::HTML5::Scrub.scrub_attribute_value` expose the html5lib attribute name and value rules, so downstream consumers can apply them instead of carrying their own copy. @flavorjones","+* Ensure HTML5 scrubber output does not turn into new markup when a browser parses it again. The fix is in Nokogiri v1.19.5, which escapes `<` and `>` in attribute values as the HTML standard requires, so Loofah now requires Nokogiri >= 1.19.5. See [GHSA-h6v6-rg66-fqj4](https://github.com/flavorjones/loofah/security/advisories/GHSA-h6v6-rg66-fqj4). @flavorjones @hackvertor"," "," ### Fixed"," "],"additions":1,"deletions":0,"truncated":false},{"path":"lib/loofah.rb","lines":["@@ -5,13 +5,7 @@"," module Loofah","   class << self","     def html5_support?","-      # Note that Loofah can only support HTML5 in Nokogiri >= 1.14.0 because it requires the","-      # subclassing fix from https://github.com/sparklemotion/nokogiri/pull/2534","-      return @html5_support if defined? @html5_support","-","-      @html5_support =","-        Gem::Version.new(Nokogiri::VERSION) > Gem::Version.new(\"1.14.0\") &&","-        Nokogiri.uses_gumbo?","+      Nokogiri.uses_gumbo?","     end","   end"," end"],"additions":1,"deletions":7,"truncated":false},{"path":"loofah.gemspec","lines":["@@ -46,5 +46,5 @@ Gem::Specification.new do |spec|","   spec.required_ruby_version = \">= 2.5.0\""," ","   spec.add_dependency(\"crass\", [\"~> 1.0.2\"])","-  spec.add_dependency(\"nokogiri\", [\">= 1.12.0\"])","+  spec.add_dependency(\"nokogiri\", [\">= 1.19.5\"])"," end"],"additions":1,"deletions":1,"truncated":false},{"path":"test/integration/test_ad_hoc.rb","lines":["@@ -438,12 +438,10 @@ def test_dont_remove_whitespace_between_tags"," ","           it \"handles < character in an attribute\" do","             input = %{<div alt=\"this < that\">wave</div>}","-            possible_answers = [%{<div alt=\"this &lt; that\">wave</div>}]","-            # Before sparklemotion/nokogiri#3741, the HTML5 serializer did not escape < in attribute values","-            possible_answers << %{<div alt=\"this < that\">wave</div>} if html_version == :html5","+            expected = %{<div alt=\"this &lt; that\">wave</div>}","             actual = scrub_fragment(input, :escape)"," ","-            assert_includes(possible_answers, actual.to_html)","+            assert_equal(expected, actual.to_html)","           end"," ","           it \"handles multiple < characters\" do","@@ -462,6 +460,14 @@ def test_dont_remove_whitespace_between_tags","             assert_equal(expected, actual.to_html)","           end","         end","+","+        it \"does not let an attribute value become markup when stripped MathML is reparsed\" do","+          html = %{<math><mtext><mglyph><textarea><a title=\"</textarea><img src=x onerror=alert(1)>\">}","+","+          reparsed = fragment(scrub_fragment(html, :strip).to_html)","+","+          assert_nil(reparsed.at_css(\"[onerror]\"))","+        end","       end","     end","   end",""],"additions":10,"deletions":4,"truncated":false}],"additions":13,"deletions":12,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-13T17:02:32.222636+00:00"}