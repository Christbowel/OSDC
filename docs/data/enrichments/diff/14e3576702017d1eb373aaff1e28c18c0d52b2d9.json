@ -3387,6 +3388,81 @@ public void testColumnarGeoPointMixedShapesFallBackCleanly() throws IOException","         });","     }"," ","+    /**","+     * A leaf array with more elements than fit in a sorted doc value ({@code IndexWriter.MAX_TERM_LENGTH} bytes of encoded","+     * offsets) cannot be indexed through the columnar path: {@code ColumnarOffsetsBuilder} bails out, the batch falls back to","+     * the row path, and only that document is rejected, with an explicit error instead of Lucene's. The other documents in","+     * the bulk request are indexed by the row path, with their array order intact.","+     */","+    public void testColumnarOversizedArrayOffsetsRejectOnlyThatDocument() throws IOException {","+        final String index = \"test-columnar-oversized-offsets\";","+        assertAcked(","+            indicesAdmin().prepareCreate(index)","+                .setSettings(","+                    Settings.builder()","+                        .put(\"index.number_of_shards\", 1)","+                        .put(\"index.number_of_replicas\", 0)","+                        .put(IndexSettings.MODE.getKey(), IndexMode.COLUMNAR.getName())","+                        .put(IndexSettings.RECOVERY_USE_SYNTHETIC_SOURCE_SETTING.getKey(), true)","+                )","+                .setMapping(\"\"\"","+                    {\"dynamic\":\"strict\",\"properties\":{\"n\":{\"type\":\"long\"}}}\"\"\")","+        );","+        ensureGreen(index);","+        final String coordinatingNode = findCoordinatingNode();","+","+        final Map<String, String> sources = new LinkedHashMap<>();","+        final int numDocs = between(3, 10);","+        for (int i = 0; i < numDocs; i++) {","+            // Out-of-order values with duplicates, so the offsets sidecar carries real ordering information.","+            sources.put(\"doc-\" + i, \"{\\\"n\\\":[3,1,3,2,\" + i + \"]}\");","+        }","+        // One more slot than the limit guarantees the encoded offsets exceed it, since every slot takes at least one byte.","+        final StringBuilder oversized = new StringBuilder(\"{\\\"n\\\":[\");","+        final int numSlots = IndexWriter.MAX_TERM_LENGTH + between(1, 500);","+        for (int i = 0; i < numSlots; i++) {","+            oversized.append(i == 0 ? \"\" : \",\").append(randomInt(3));","+        }","+        oversized.append(\"]}\");","+        sources.put(\"oversized\", oversized.toString());","+","+        final BulkResponse response;","+        try (var mockLog = MockLog.capture(ShardBatchMapper.class)) {","+            mockLog.addExpectation(","+                new MockLog.SeenEventExpectation(","+                    \"columnar batch mapping bails out\",","+                    ShardBatchMapper.class.getName(),","+                    Level.WARN,","+                    \"columnar batch mapping failed on *, falling back\"","+                )","+            );","+            response = client(coordinatingNode).bulk(bulkOf(index, sources)).actionGet();","+            mockLog.assertAllExpectationsMatched();","+        }","+","+        assertTrue(response.hasFailures());","+        for (BulkItemResponse item : response.getItems()) {","+            if (item.getId().equals(\"oversized\")) {","+                assertTrue(\"oversized array must be rejected, but got: \" + item.getResponse(), item.isFailed());","+                assertThat(item.getFailure().getStatus(), equalTo(RestStatus.BAD_REQUEST));","+                assertThat(item.getFailure().getMessage(), containsString(\"encoded offsets of field [n.offsets] are too large to store\"));","+                assertThat(item.getFailure().getMessage(), containsString(\"cannot be preserved in [_ignored_source]\"));","+            } else {","+                assertFalse(item.getFailureMessage(), item.isFailed());","+            }","+        }","+","+        refresh(index);","+        assertResponse(prepareSearch(index).setQuery(QueryBuilders.matchAllQuery()).setSize(0).setTrackTotalHits(true), searchResponse -> {","+            assertNoFailures(searchResponse);","+            assertThat(searchResponse.getHits().getTotalHits().value(), equalTo((long) numDocs));","+        });","+        // A document the row path indexed after the fallback still reproduces its array order and duplicates.","+        var getResponse = client().get(new GetRequest(index).id(\"doc-0\")).actionGet();","+        assertTrue(getResponse.isExists());","+        assertThat(getResponse.getSourceAsMap().get(\"n\"), equalTo(List.of(3, 1, 3, 2, 0)));","+    }","+","     private static BulkRequest bulkOf(String index, Map<String, String> sources) {","         final BulkRequest request = new BulkRequest();","         sources.forEach("],"additions":76,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/elasticsearch/index/mapper/OversizedArrayOffsetsSyntheticSourceIT.java","lines":["@@ -0,0 +1,128 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the \"Elastic License","+ * 2.0\", the \"GNU Affero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+","+package org.elasticsearch.index.mapper;","+","+import org.apache.lucene.index.IndexWriter;","+import org.elasticsearch.action.get.GetResponse;","+import org.elasticsearch.action.search.SearchRequestBuilder;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.index.IndexSettings;","+import org.elasticsearch.index.query.QueryBuilders;","+import org.elasticsearch.search.SearchHit;","+import org.elasticsearch.test.ESSingleNodeTestCase;","+","+import java.util.ArrayList;","+import java.util.Arrays;","+import java.util.LinkedHashMap;","+import java.util.List;","+import java.util.Map;","+","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertNoFailures;","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertResponse;","+import static org.hamcrest.Matchers.equalTo;","+","+/**","+ * End-to-end check of the {@code _ignored_source} fallback for arrays whose encoded offsets are too large for a sorted doc","+ * value, on a standard index with synthetic source and {@code synthetic_source_keep: arrays}. Unlike the mapper-level tests,","+ * documents go through flush, optionally an index sort and a force merge, so the {@code _ignored_source} entry must stay with","+ * its document when segments are sorted and merged.","+ */","+public class OversizedArrayOffsetsSyntheticSourceIT extends ESSingleNodeTestCase {","+","+    public void testOversizedArraysSurviveSortAndMerge() throws Exception {","+        final String index = \"test-oversized-offsets\";","+        final boolean indexSort = randomBoolean();","+        Settings.Builder settings = Settings.builder()","+            .put(\"index.number_of_shards\", 1)","+            .put(IndexSettings.INDEX_MAPPER_SOURCE_MODE_SETTING.getKey(), \"synthetic\")","+            .put(Mapper.SYNTHETIC_SOURCE_KEEP_INDEX_SETTING.getKey(), \"arrays\");","+        if (indexSort) {","+            settings.put(\"index.sort.field\", \"sort_key\").put(\"index.sort.order\", \"desc\");","+        }","+        assertAcked(indicesAdmin().prepareCreate(index).setSettings(settings).setMapping(\"\"\"","+            {","+              \"properties\": {","+                \"sort_key\": { \"type\": \"long\" },","+                \"kw\": { \"type\": \"keyword\" },","+                \"n\": { \"type\": \"long\" }","+              }","+            }\"\"\"));","+","+        // Regular documents with small arrays, which get native offsets, and one or two documents with an oversized array,","+        // which fall back to _ignored_source. All arrays have out-of-order values, duplicates and nulls.","+        final Map<String, Map<String, Object>> documents = new LinkedHashMap<>();","+        final int numDocs = between(3, 10);","+        for (int i = 0; i < numDocs; i++) {","+            Map<String, Object> document = new LinkedHashMap<>();","+            document.put(\"sort_key\", i);","+            document.put(\"kw\", Arrays.asList(\"b\", \"a\", null, \"b\", \"doc-\" + i));","+            document.put(\"n\", Arrays.asList(3, 1, null, 3, 2, i));","+            documents.put(\"doc-\" + i, document);","+        }","+        Map<String, Object> oversized = new LinkedHashMap<>();","+        oversized.put(\"sort_key\", numDocs);","+        oversized.put(\"kw\", Arrays.asList(\"b\", \"a\", null, \"b\"));","+        oversized.put(\"n\", oversizedValues(List.of(0, 1, 2, 3)));","+        documents.put(\"oversized-n\", oversized);","+        if (randomBoolean()) {","+            Map<String, Object> bothOversized = new LinkedHashMap<>();","+            bothOversized.put(\"sort_key\", numDocs + 1);","+            bothOversized.put(\"kw\", oversizedValues(List.of(\"a\", \"b\", \"c\", \"d\")));","+            bothOversized.put(\"n\", oversizedValues(List.of(0, 1, 2, 3)));","+            documents.put(\"oversized-kw-n\", bothOversized);","+        }","+","+        // Index in random order, with refreshes in between so that the index has several segments to sort and merge.","+        List<String> ids = new ArrayList<>(documents.keySet());","+        for (String id : shuffledList(ids)) {","+            prepareIndex(index).setId(id).setSource(documents.get(id)).get();","+            if (randomBoolean()) {","+                indicesAdmin().prepareRefresh(index).get();","+            }","+        }","+        indicesAdmin().prepareRefresh(index).get();","+        if (randomBoolean()) {","+            assertNoFailures(indicesAdmin().prepareForceMerge(index).setMaxNumSegments(1).get());","+            indicesAdmin().prepareRefresh(index).get();","+        }","+","+        for (String id : ids) {","+            // Read from the index rather than from the translog, so the synthesized source is what is compared.","+            GetResponse response = client().prepareGet(index, id).setRealtime(false).get();","+            assertTrue(id, response.isExists());","+            assertThat(id, response.getSourceAsMap(), equalTo(documents.get(id)));","+        }","+        SearchRequestBuilder search = client().prepareSearch(index)","+            .setQuery(QueryBuilders.matchAllQuery())","+            .setSize(documents.size())","+            .setFetchSource(true);","+        assertResponse(search, response -> {","+            assertNoFailures(response);","+            assertThat(response.getHits().getTotalHits().value(), equalTo((long) documents.size()));","+            for (SearchHit hit : response.getHits().getHits()) {","+                assertThat(hit.getId(), hit.getSourceAsMap(), equalTo(documents.get(hit.getId())));","+            }","+        });","+    }","+","+    /**","+     * An array with more elements than a sorted doc value can hold offsets for: one more slot than","+     * {@link IndexWriter#MAX_TERM_LENGTH} guarantees that, since every slot takes at least one byte on top of the length prefix.","+     */","+    private static <T> List<T> oversizedValues(List<T> pool) {","+        int numSlots = IndexWriter.MAX_TERM_LENGTH + between(1, 500);","+        List<T> values = new ArrayList<>(numSlots);","+        for (int i = 0; i < numSlots; i++) {","+            values.add(randomInt(10) == 1 ? null : randomFrom(pool));","+        }","+        return values;","+    }","+}"],"additions":128,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/escf/ColumnarOffsetsBuilder.java","lines":["@@ -12,6 +12,7 @@"," import org.apache.lucene.document.SortedDocValuesField;"," import org.apache.lucen