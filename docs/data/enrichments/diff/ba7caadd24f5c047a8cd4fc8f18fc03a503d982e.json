er.MAX_VALUE;","+  }","+","   @Override","   public Collection<IntervalsSource> pullUpDisjunctions() {","     return Disjunctions.pullUp(subSources, UnorderedIntervalsSource::new);"],"additions":5,"deletions":0,"truncated":false},{"path":"lucene/queries/src/test/org/apache/lucene/queries/intervals/OneTimeIntervalSource.java","lines":["@@ -165,6 +165,11 @@ public int minExtent() {","     return 0;","   }"," ","+  @Override","+  public int maxExtent() {","+    return Integer.MAX_VALUE;","+  }","+","   @Override","   public Collection<IntervalsSource> pullUpDisjunctions() {","     return Collections.singleton(this);"],"additions":5,"deletions":0,"truncated":false},{"path":"lucene/queries/src/test/org/apache/lucene/queries/intervals/TestDisjunctionRewrites.java","lines":["@@ -27,6 +27,7 @@"," import static org.apache.lucene.queries.intervals.Intervals.or;"," import static org.apache.lucene.queries.intervals.Intervals.ordered;"," import static org.apache.lucene.queries.intervals.Intervals.phrase;","+import static org.apache.lucene.queries.intervals.Intervals.prefix;"," import static org.apache.lucene.queries.intervals.Intervals.term;"," "," import org.apache.lucene.tests.util.LuceneTestCase;","@@ -97,8 +98,9 @@ public void testPhraseDisjunctionWithNestedDifferentLengthClauses() {"," ","   public void testDisjunctionRewritePreservesFilters() {"," ","+    // Both alternatives have the same fixed width, so no rewrite is needed","     // BLOCK(a, MAXGAPS/3(OR(BLOCK(a, b), BLOCK(c, d))), c)","-    // => or(BLOCK(a, MAXGAPS/3(BLOCK(a, b)), c), BLOCK(a, MAXGAPS/3(BLOCK(c, d)), c))","+    // => BLOCK(a, MAXGAPS/3(OR(BLOCK(a, b), BLOCK(c, d))), c)"," ","     IntervalsSource actual =","         Intervals.phrase(","@@ -108,15 +110,11 @@ public void testDisjunctionRewritePreservesFilters() {","             Intervals.term(\"c\"));"," ","     IntervalsSource expected =","-        Intervals.or(","-            Intervals.phrase(","-                Intervals.term(\"a\"),","-                Intervals.maxgaps(3, Intervals.phrase(\"a\", \"b\")),","-                Intervals.term(\"c\")),","-            Intervals.phrase(","-                Intervals.term(\"a\"),","-                Intervals.maxgaps(3, Intervals.phrase(\"c\", \"d\")),","-                Intervals.term(\"c\")));","+        Intervals.phrase(","+            Intervals.term(\"a\"),","+            Intervals.maxgaps(","+                3, Intervals.or(Intervals.phrase(\"a\", \"b\"), Intervals.phrase(\"c\", \"d\"))),","+            Intervals.term(\"c\"));"," ","     assertEquals(expected, actual);","   }","@@ -231,4 +229,64 @@ public void testBlockedRewrites() {","     IntervalsSource ifRewritten = or(phrase(\"a\", \"b\", \"c\"), phrase(\"a\", \"c\"));","     assertNotEquals(ifRewritten, actual);","   }","+","+  public void testFixedWidthAlternativesAreGrouped() {","+    IntervalsSource source =","+        Intervals.unordered(","+            term(\"a\"), or(phrase(\"b\", \"c\"), phrase(\"d\", \"e\"), term(\"f\"), term(\"g\")));","+    // one group of width 2, one of width 1","+    assertEquals(2, source.pullUpDisjunctions().size());","+  }","+","+  public void testFixedWidthGroupingShrinksCrossProduct() {","+    IntervalsSource left =","+        or(","+            term(\"a\"),","+            prefix(new org.apache.lucene.util.BytesRef(\"b\")),","+            phrase(\"c\", \"d\"),","+            phrase(\"e\", \"f\"),","+            phrase(\"g\", \"h\", \"i\"));","+    IntervalsSource right =","+        or(phrase(\"j\", \"k\"), phrase(\"l\", \"m\"), term(\"n\"), phrase(\"o\", \"p\", \"q\"));","+    // 3 widths on each side","+    assertEquals(9, Intervals.unordered(left, right).pullUpDisjunctions().size());","+    assertEquals(9, maxgaps(3, Intervals.unordered(left, right)).pullUpDisjunctions().size());","+  }","+","+  public void testFixedWidthIsCarriedThroughWrappers() {","+    IntervalsSource wrapped =","+        or(maxgaps(0, phrase(\"a\", \"b\")), containing(phrase(\"c\", \"d\"), term(\"c\")),