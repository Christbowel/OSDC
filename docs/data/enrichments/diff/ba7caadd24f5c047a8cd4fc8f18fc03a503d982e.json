idual sources","-  // Clauses that have a minExtent of 1 are grouped together and treated as a single","-  // source, as any overlapping intervals of length 1 can be treated as identical,","-  // and we know that all combinatorial sources have a minExtent > 1","+  // Clauses that always match intervals of the same fixed width are grouped together by width","+  // and treated as a single source, as intervals of equal width can never strictly contain one","+  // another, so minimization cannot cause one to hide another. This covers single terms (width 1)","+  // and, for example, phrases of the same length. Variable-width clauses are kept separate.","   private static List<IntervalsSource> splitDisjunctions(IntervalsSource source) {","-    List<IntervalsSource> singletons = new ArrayList<>();","-    List<IntervalsSource> nonSingletons = new ArrayList<>();","+    Map<Integer, List<IntervalsSource>> fixedByWidth = new LinkedHashMap<>();","+    List<IntervalsSource> variableWidth = new ArrayList<>();","     for (IntervalsSource disj : source.pullUpDisjunctions()) {","-      if (disj.minExtent() == 1) {","-        singletons.add(disj);","+      int width = disj.minExtent();","+      if (width == disj.maxExtent()) {","+        fixedByWidth.computeIfAbsent(width, _ -> new ArrayList<>()).add(disj);","       } else {","-        nonSingletons.add(disj);","+        variableWidth.add(disj);","       }","     }","     List<IntervalsSource> split = new ArrayList<>();","-    if (singletons.size() > 0) {","-      split.add(Intervals.or(singletons.toArray(IntervalsSource[]::new)));","+    for (List<IntervalsSource> group : fixedByWidth.values()) {","+      split.add(group.size() == 1 ? group.get(0) : Intervals.or(group));","     }","-    split.addAll(nonSingletons);","+    split.addAll(variableWidth);","     return split;","   }"," }"],"additions":15,"deletions":11,"truncated":false},{"path":"lucene/queries/src/java/org/apache/lucene/queries/intervals/ExtendedIntervalsSource.java","lines":["@@ -131,6 +131,16 @@ public int minExtent() {","     return minExtent;","   }"," ","+  @Override","+  public int maxExtent() {","+    if (before > 0) {","+      // the start is clamped to 0, so intervals near the start of a document can be shorter","+      return Integer.MAX_VALUE;","+    }","+    long maxExtent = (long) before + source.maxExtent() + after;","+    return (int) Math.max(0, Math.min(maxExtent, Integer.MAX_VALUE));","+  }","+","   @Override","   public Collection<IntervalsSource> pullUpDisjunctions() {","     Collection<IntervalsSource> inner = source.pullUpDisjunctions();"],"additions":10,"deletions":0,"truncated":false},{"path":"lucene/queries/src/java/org/apache/lucene/queries/intervals/FilteredIntervalsSource.java","lines":["@@ -21,7 +21,6 @@"," import java.util.Collection;"," import java.util.Collections;"," import java.util.Objects;","-import java.util.stream.Collectors;"," import org.apache.lucene.index.LeafReaderContext;"," import org.apache.lucene.search.QueryVisitor;"," ","@@ -29,10 +28,7 @@"," public abstract class FilteredIntervalsSource extends IntervalsSource {"," ","   public static IntervalsSource maxGaps(IntervalsSource in, int maxGaps) {","-    return Intervals.or(","-        in.pullUpDisjunctions().stream()","-            .map(s -> new MaxGaps(s, maxGaps))","-            .collect(Collectors.toList()));","+    return Intervals.or(Disjunctions.pullUp(in, s -> new MaxGaps(s, maxGaps)));","   }"," ","   private static class MaxGaps extends FilteredIntervalsSource {","@@ -68,6 +64,11 @@ protected boolean accept(IntervalIterator it) {","       return (it.end() - it.start()) + 1 <= maxWidth;","     }"," ","+    @Override","+    public int maxExtent() {","+      return Math.min(in.maxExtent(), maxWidth);","+    }","+","     @Override","     public Collection<IntervalsSource> pullUpDisjunctions() {","       return Disjunctions.pullUp(in, s -> new MaxWidth(s, maxWidth));","@@ -129,6 +130,11 @@ public int minExtent() {","     return in.minExtent();","   }"," ","+  @Override","+  public int maxExtent() {","+    return in.maxExtent();","+  }","+","   @Override","   public Collection<IntervalsSource> pullUpDisjunctions() {","     return Collections.singletonList(this);"],"additions":11,"deletions":5,"truncated":false},{"path":"lucene/queries/src/java/org/apache/lucene/queries/intervals/FixedFieldIntervalsSource.java","lines":["@@ -56,6 +56,11 @@ public int minExtent() {","     return source.minExtent();","   }"," ","+  @Override","+  public int maxExtent() {","+    return source.maxExtent();","+  }","+","   @Override","   public Collection<IntervalsSource> pullUpDisjunctions() {","     Collection<IntervalsSource> inner = source.pullUpDisjunctions();"],"additions":5,"deletions":0,"truncated":false},{"path":"lucene/queries/src/java/org/apache/lucene/queries/intervals/IntervalsSource.java","lines":["@@ -63,6 +63,16 @@ public abstract IntervalMatchesIterator matches(String field, LeafReaderContext","   /** Return the minimum possible width of an interval returned by this source */","   public abstract int minExtent();"," ","+  /**","+   * Return the maximum possible width of an interval returned by this source, or {@link","+   * Integer#MAX_VALUE} if the width is unbounded","+   *","+   * <p>Sources whose minimum and maximum extents are equal always return intervals of the same","+   * width, which allows disjunctions of them to be combined without risking minimization problems.","+   * Sources that cannot guarantee a bound should return {@code Integer.MAX_VALUE}","+   */","+  public abstract int maxExtent();","+","   /**","    * Expert: return the set of disjunctions that make up this IntervalsSource","    *"],"additions":10,"deletions":0,"truncated":false},{"path":"lucene/queries/src/java/org/apache/lucene/queries/intervals/MinimumShouldMatchIntervalsSource.java","lines":["@@ -114,6 +114,11 @@ public int minExtent() {","     return minExtent;","   }"," ","+  @Override","+  public int maxExtent() {","+ 