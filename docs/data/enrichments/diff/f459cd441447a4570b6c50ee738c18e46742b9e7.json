ed_lockfile, ..SHARED });","+        for setting in [\"minimumReleaseAgeExclude\", \"trustPolicyExclude\"] {","+            scenario.set_workspace_setting(&format!(\"{setting}Prune\"), Some(\"true\"));","+            scenario.set_workspace_setting(","+                setting,","+                Some(\"['@pnpm.e2e/foo@100.0.0', '@pnpm.e2e/fo?', '!example', obsolete]\"),","+            );","+        }","+        scenario.install(&[]);","+        let yaml = std::fs::read_to_string(scenario.workspace().join(\"pnpm-workspace.yaml\"))","+            .expect(\"read the pruned workspace settings\");","+        assert_pruned_state(&scenario);","+        assert!(!yaml.contains(\"obsolete\"));","+        assert!(yaml.contains(\"@pnpm.e2e/fo?\"));","+        assert!(yaml.contains(\"!example\"));","+        scenario.check_gates();","+    }","+}","+","+fn assert_pruned_state(scenario: &Scenario) {","+    let lockfiles = if scenario.layout.shared_lockfile {","+        vec![scenario.lockfile_of(\"a\")]","+    } else {","+        vec![scenario.lockfile_of(\"a\"), scenario.lockfile_of(\"b\")]","+    };","+    for lockfile in lockfiles {","+        let state = pnpm_workspace_state::load_workspace_state(lockfile.parent().unwrap())","+            .unwrap()","+            .unwrap();","+        for rules in","+            [state.settings.minimum_release_age_exclude, state.settings.trust_policy_exclude]","+        {","+            assert_eq!(rules.unwrap(), [\"@pnpm.e2e/foo@100.0.0\", \"@pnpm.e2e/fo?\", \"!example\"]);","+        }","+    }","+}","+","+#[test]","+fn recursive_update_records_pruned_exclusions_for_dedicated_lockfiles() {","+    let scenario = Scenario::new(Layout { shared_lockfile: false, ..SHARED });","+    scenario.install(&[]);","+    for setting in [\"minimumReleaseAgeExclude\", \"trustPolicyExclude\"] {","+        scenario.set_workspace_setting(&format!(\"{setting}Prune\"), Some(\"true\"));","+        scenario.set_workspace_setting(","+            setting,","+            Some(\"['@pnpm.e2e/foo@100.0.0', '@pnpm.e2e/fo?', '!example', obsolete]\"),","+        );","+    }","+    let update = scenario.command_at(","+        scenario.workspace(),","+        [\"--recursive\", \"--include-workspace-root\", \"update\"],","+    );","+    super::assert_success(&update);","+    assert_pruned_state(&scenario);","+}","+","+#[test]","+fn a_dependent_script_can_read_workspace_state_before_exclusions_are_pruned() {","+    let scenario = Scenario::new(Layout { shared_lockfile: false, ..SHARED });","+    scenario.set_workspace_setting(\"minimumReleaseAgeExcludePrune\", Some(\"true\"));","+    scenario.set_workspace_setting(\"minimumReleaseAgeExclude\", Some(\"[obsolete]\"));","+    scenario.write_manifest(\"c\", json!({","+        \"dependencies\": {\"a\": \"workspace:*\"},","+        \"scripts\": {","+            \"postinstall\": r#\"node -e \"require('../a/node_modules/.pnpm-workspace-state-v1.json')\"\"#","+        }","+    }));","+    scenario.install(&[]);","+    let lockfile = scenario.lockfile_of(\"a\");","+    let state =","+        pnpm_workspace_state::load_workspace_state(lockfile.parent().unwrap()).unwrap().unwrap();","+    assert_eq!(state.settings.minimum_release_age_exclude, None);","+}","+","+#[test]","+fn frozen_then_filtered_install_after_a_scope_route_moves() {","+    let scenario = Scenario::new(SHARED);","+    let new_registry =","+        super::TestRegistry::start_with_own_storage(scenario.workspace().parent().unwrap());","+    scenario.set_workspace_setting(\"trustLockfile\", Some(\"true\"));","+    let registry = &scenario.fixture.registry.mock_instance;","+    let route = |url: &str| {","+        scenario.set_workspace_setting(\"registries\", Some(&format!(\"{{ '@pnpm.e2e': '{url}' }}\")));","+    };","+    route(registry.url());","+    scenario.install(&[]);","+    let child = \"@pnpm.e2e/dep-of-pkg-with-1-dep\";","+    let locked = super::read_lockfile(&scenario.lockfile_of(\"b\")).packages","+        .unwrap()","+       