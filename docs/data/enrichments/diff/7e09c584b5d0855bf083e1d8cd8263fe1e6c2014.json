{"id":"7e09c584b5d0855bf083e1d8cd8263fe1e6c2014","axis":"silent","repo":"ramsey/uuid","sha":"7e09c584b5d0855bf083e1d8cd8263fe1e6c2014","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -6,6 +6,19 @@ The format is based on [Keep a Changelog](http://keepachangelog.com/en/1.0.0/)"," and this project adheres to [Semantic Versioning](http://semver.org/spec/v2.0.0.html)."," "," ","+## Unreleased","+","+### Changed","+","+* For times before the Unix epoch, `GenericTimeConverter::convertTime()` and `PhpTimeConverter::convertTime()` now return the seconds rounded down, with microseconds that count forward from them. For example, 1.5 seconds before the epoch is now -2 seconds and 500000 microseconds, where it was -1 seconds and 500000 microseconds. The microseconds are added to the seconds, so -2 seconds plus 0.5 seconds is -1.5 seconds. `Time::toString()` returns `-1.500000` for this time. The `getDateTime()` methods read the time from any `TimeConverterInterface` implementation in the same way.","+","+### Fixed","+","+* `PhpTimeConverter::convertTime()` no longer returns wrong microseconds, such as dropping a leading zero, depending on the `precision` ini setting. It now uses integer math.","+* `getDateTime()` no longer returns a time after the Unix epoch for UUIDs whose time is less than one second before it.","+* `GenericTimeConverter::convertTime()` and `PhpTimeConverter::convertTime()` no longer return a wrong time for times before the Unix epoch. For times less than one second before the epoch, the minus sign was lost. For earlier times, `calculateTime()` read the returned seconds and microseconds as a different time, so a timestamp 1.5 seconds before the epoch converted back as 0.5 seconds before it.","+","+"," ## 4.9.4 - 2026-09-16"," "," ### Fixed"],"additions":13,"deletions":0,"truncated":false},{"path":"src/Converter/Time/GenericTimeConverter.php","lines":["@@ -21,7 +21,6 @@"," use Ramsey\\Uuid\\Type\\Integer as IntegerObject;"," use Ramsey\\Uuid\\Type\\Time;"," ","-use function explode;"," use function str_pad;"," "," use const STR_PAD_LEFT;","@@ -48,6 +47,11 @@ class GenericTimeConverter implements TimeConverterInterface","      */","     private const MICROSECOND_INTERVALS = '10';"," ","+    /**","+     * The number of microseconds in one second.","+     */","+    private const SECOND_MICROSECONDS = '1000000';","+","     public function __construct(private CalculatorInterface $calculator)","     {","     }","@@ -96,17 +100,39 @@ public function convertTime(Hexadecimal $uuidTimestamp): Time","             new IntegerObject(self::GREGORIAN_TO_UNIX_INTERVALS), /** @phpstan-ignore possiblyImpure.new */","         );"," ","-        // Convert the 100-nanosecond intervals into seconds and microseconds.","-        $unixTimestamp = $this->calculator->divide(","-            RoundingMode::HALF_UP,","-            6,","+        // Round the seconds down, so the remainder is never negative.","+        $seconds = $this->calculator->divide(","+            RoundingMode::FLOOR,","+            0,","             $epochNanoseconds,","             new IntegerObject(self::SECOND_INTERVALS), /** @phpstan-ignore possiblyImpure.new */","         );"," ","-        $split = explode('.', (string) $unixTimestamp, 2);","+        $remainder = $this->calculator->subtract(","+            $epochNanoseconds,","+            $this->calculator->multiply(","+                $seconds,","+                new IntegerObject(self::SECOND_INTERVALS), /** @phpstan-ignore possiblyImpure.new */","+            ),","+        );","+","+        // Round the remainder to the nearest microsecond, with halves rounded up.","+        $microseconds = $this->calculator->divide(","+            RoundingMode::HALF_UP,","+            0,","+            $remainder,","+            new IntegerObject(self::MICROSECOND_INTERVALS), /** @phpstan-ignore possiblyImpure.new */","+        );","+","+        if ($microseconds->toString() === self::SECOND_MICROSECONDS) {","+            $seconds = $this->calculator->add(","+                $seconds,","+                new IntegerObject(1), /** @phpstan-ignore possiblyImpure.new */","+            );","+            $microseconds = new IntegerObject(0); /** @phpstan-ignore possiblyImpure.new */","+        }"," ","         /** @phpstan-ignore possiblyImpure.new */","-        return new Time($split[0], $split[1] ?? 0);","+        return new Time($seconds->toString(), $microseconds->toString());","     }"," }"],"additions":33,"deletions":7,"truncated":false},{"path":"src/Converter/Time/PhpTimeConverter.php","lines":["@@ -21,17 +21,12 @@"," use Ramsey\\Uuid\\Type\\Integer as IntegerObject;"," use Ramsey\\Uuid\\Type\\Time;"," ","-use function count;"," use function dechex;","-use function explode;","-use function is_float;","+use function intdiv;"," use function is_int;"," use function str_pad;","-use function strlen;","-use function substr;"," "," use const STR_PAD_LEFT;","-use const STR_PAD_RIGHT;"," "," /**","  * PhpTimeConverter uses built-in PHP functions and standard math operations available to the PHP programming language","@@ -56,7 +51,11 @@ class PhpTimeConverter implements TimeConverterInterface","      */","     private const MICROSECOND_INTERVALS = 10;"," ","-    private int $phpPrecision;","+    /**","+     * The number of microseconds in one second.","+     */","+    private const SECOND_MICROSECONDS = 1_000_000;","+","     private CalculatorInterface $calculator;","     private TimeConverterInterface $fallbackConverter;"," ","@@ -74,7 +73,6 @@ public function __construct("," ","         $this->calculator = $calculator;","         $this->fallbackConverter = $fallbackConverter;","-        $this->phpPrecision = (int) ini_get('precision');","     }"," ","     public function calculateTime(string $seconds, string $microseconds): Hexadecimal","@@ -106,72 +104,35 @@ public function calculateTime(string $seconds, string $microseconds): Hexadecima"," ","     public function convertTime(Hexadecimal $uuidTim