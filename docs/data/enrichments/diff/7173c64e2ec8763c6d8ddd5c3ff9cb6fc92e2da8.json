{"id":"7173c64e2ec8763c6d8ddd5c3ff9cb6fc92e2da8","axis":"silent","repo":"vllm-project/vllm","sha":"7173c64e2ec8763c6d8ddd5c3ff9cb6fc92e2da8","parsed":{"files":[{"path":"docs/usage/security.md","lines":["@@ -94,7 +94,9 @@ denial of service:"," | Environment Variable | Default | Description |"," | --- | --- | --- |"," | `VLLM_MAX_MEDIA_DOWNLOAD_SIZE_MB` | `256` | Maximum size in MB for a single remote media response. Oversized responses are rejected while streaming before the full body is materialized in memory. |","+| `VLLM_MAX_MEDIA_REQUEST_DOWNLOAD_SIZE_MB` | `256` | Maximum total HTTP media bytes downloaded for one request, including concurrent downloads. Enforced while streaming. |"," | `VLLM_MAX_IMAGE_PIXELS` | `178956970` (~179M pixels) | Maximum decoded image size in pixels. Images exceeding this are rejected before raster memory is allocated. Default matches PIL's built-in 2x decompression-bomb threshold (~680 MB for RGB). |","+| `VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES` | `715827880` (~683 MiB) | Maximum aggregate decoded image, video-frame, and audio bytes in one request. Images are charged at four bytes per pixel before decoding; audio is limited before decoding; video files are charged after frame extraction. |"," | `VLLM_MAX_AUDIO_CLIP_FILESIZE_MB` | `25` | Maximum compressed filesize in MB for a single audio file. Enforced on all audio inputs (multimodal chat URLs, speech-to-text uploads, data: URLs, and local file paths) before decoding begins. |"," | `VLLM_MAX_AUDIO_DECODE_DURATION_S` | `600` | Maximum decoded audio duration in seconds. Prevents compressed audio from expanding into gigabytes of float32 PCM. |"," | `VLLM_MAX_AUDIO_DECODE_BYTES` | `268435456` (256 MiB) | Maximum float32 PCM bytes that audio decoding may allocate. Guards against sample-rate forgery where an inflated header sample rate bypasses the duration guard while the actual frame count causes a multi-GiB allocation. |"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/multimodal/media/test_audio.py","lines":["@@ -1,5 +1,7 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import threading","+from concurrent.futures import ThreadPoolExecutor"," from io import BytesIO"," from pathlib import Path"," from unittest.mock import patch","@@ -9,6 +11,7 @@"," import pytest"," import soundfile as sf"," ","+import vllm.envs as envs"," from vllm.multimodal.media import AudioMediaIO"," from vllm.multimodal.media import audio as audio_module"," from vllm.multimodal.media.audio import (","@@ -16,6 +19,7 @@","     load_audio_soundfile,","     load_audio_torchcodec,"," )","+from vllm.multimodal.media.base import MediaDecodedBudget"," "," from ...conftest import AudioTestAssets"," ","@@ -118,6 +122,102 @@ def _make_flac_bytes(frames: int, channels: int, samplerate: int) -> bytes:","     return buf.getvalue()"," "," ","+@pytest.mark.skip_global_cleanup","+def test_request_budget_rejects_second_decoded_audio_clip(monkeypatch):","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 384)","+    clip = _make_flac_bytes(frames=64, channels=1, samplerate=16000)","+    audio_io = AudioMediaIO(decoded_budget=MediaDecodedBudget())","+","+    audio_io.load_bytes(clip)","+    with pytest.raises(ValueError, match=\"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\"):","+        audio_io.load_bytes(clip)","+","+","+@pytest.mark.skip_global_cleanup","+def test_request_budget_allows_parallel_audio_decodes(monkeypatch):","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 512)","+    monkeypatch.setattr(envs, \"VLLM_MAX_AUDIO_DECODE_BYTES\", 256)","+    budget = MediaDecodedBudget()","+    audio_io = AudioMediaIO(decoded_budget=budget)","+    decoding = threading.Barrier(2)","+","+    def decode(*args, **kwargs):","+        assert kwargs[\"max_decode_bytes\"] == 256","+        decoding.wait(timeout=5)","+        return np.zeros(32, dtype=np.float32), 16000","+","+    with (","+        patch.object(audio_module, \"load_audio\", side_effect=decode),","+        ThreadPoolExecutor(max_workers=2) as pool,","+    ):","+        results = list(pool.map(audio_io.load_bytes, [b\"a\", b\"b\"]))","+","+    assert len(results) == 2","+    assert budget.used == 256","+","+","+@pytest.mark.skip_global_cleanup","+def test_request_budget_waits_for_inflight_audio_decode(monkeypatch):","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 256)","+    monkeypatch.setattr(envs, \"VLLM_MAX_AUDIO_DECODE_BYTES\", 256)","+    budget = MediaDecodedBudget()","+    audio_io = AudioMediaIO(decoded_budget=budget)","+    decoding = threading.Event()","+    finish_decoding = threading.Event()","+    second_reservation = threading.Event()","+    reserve = budget.reserve","+    decode_calls = 0","+","+    def track_reservation(max_bytes):","+        if decoding.is_set():","+            second_reservation.set()","+        return reserve(max_bytes)","+","+    def decode(*args, **kwargs):","+        nonlocal decode_calls","+        decode_calls += 1","+        decoding.set()","+        assert finish_decoding.wait(timeout=5)","+        return np.zeros(64, dtype=np.float32), 16000","+","+    with (","+        patch.object(budget, \"reserve\", side_effect=track_reservation),","+        patch.object(audio_module, \"load_audio\", side_effect=decode),","+        ThreadPoolExecutor(max_workers=2) as pool,","+    ):","+        first = pool.submit(audio_io.load_bytes, b\"a\")","+        assert decoding.wait(timeout=5)","+        second = pool.submit(audio_io.load_bytes, b\"b\")","+        try:","+            assert second_reservation.wait(timeout=5)","+        finally:","+            finish_decoding.set()","+        first.result(timeout=5)","+        with pytest.raises(ValueError, match=\"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\"):","+            second.result(timeout=5)","+","+    assert decode_calls == 1","+    assert budget.used == 256","+","+","+@pytest.mark.skip_