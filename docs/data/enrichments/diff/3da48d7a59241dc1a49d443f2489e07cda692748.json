&bytes) {","+      Ok(()) => Ok(Ok(())),","+      Err(err) => Ok(Err(io_exception(ctx, &err, \"open\", &path)?)),","+    }","+  }","+","+  fn copy_file_internal<'js>(","+    ctx: Ctx<'js>,","+    src: String,","+    dest: String,","+    mode: Option<&Value<'js>>,","+  ) -> rquickjs::Result<Result<(), Exception<'js>>> {","+    let mode = match mode.filter(|m| !m.is_undefined()) {","+      Some(mode) => mode","+        .as_number()","+        .ok_or_else(|| Exception::throw_type(&ctx, \"mode must be a number\"))?","+        as u32,","+      None => 0,","+    };","+    let fs = match output_fs(&ctx, \"copyfile\", &src)? {","+      Ok(fs) => fs,","+      Err(exception) => return Ok(Err(exception)),","+    };","+    let from = resolve_fs_path(&ctx, &src)?;","+    let to = resolve_fs_path(&ctx, &dest)?;","+    let result = if mode & COPYFILE_EXCL != 0 && fs.lstat(to).is_some() {","+      Err(std::io::Error::from(std::io::ErrorKind::AlreadyExists))","+    } else {","+      fs.copy(from, to)","+    };","+    match result {","+      Ok(()) => Ok(Ok(())),","+      Err(err) => {","+        let exception = io_exception(ctx, &err, \"copyfile\", &src)?;","+        exception.set(\"dest\", dest)?;","+        Ok(Err(exception))","+      }","+    }","+  }","+","+  fn unlink_internal<'js>(","+    ctx: Ctx<'js>,","+    path: String,","+  ) -> rquickjs::Result<Result<(), Exception<'js>>> {","+    let fs = match output_fs(&ctx, \"unlink\", &path)? {","+      Ok(fs) => fs,","+      Err(exception) => return Ok(Err(exception)),","+    };","+    match fs.remove_file(resolve_fs_path(&ctx, &path)?) {","+      Ok(()) => Ok(Ok(())),","+      Err(err) => Ok(Err(io_exception(ctx, &err, \"unlink\", &path)?)),","+    }","+  }","+","+  /// Returns the first directory created when `recursive` is set, as Node does.","+  fn mkdir_internal<'js>(","+    ctx: Ctx<'js>,","+    path: String,","+    options: Option<&Value<'js>>,","+  ) -> rquickjs::Result<Result<Option<String>, Exception<'js>>> {","+    // `mode` (given alone as a number, or in the object) is ignored.","+    let recursive = bool_option(&ctx, options, \"recursive\")?;","+    let fs = match output_fs(&ctx, \"mkdir\", &path)? {","+      Ok(fs) => fs,","+      Err(exception) => return Ok(Err(exception)),","+    };","+    let resolved = resolve_fs_path(&ctx, &path)?;","+    let result = if recursive {","+      let first_created = resolved","+        .ancestors()","+        .take_while(|ancestor| fs.kind(*ancestor).is_empty())","+        .last();","+      fs.create_dir_all(resolved)","+        .map(|()| first_created.map(|dir| dir.to_path_buf().to_string_lossy().into_owned()))","+    } else {","+      fs.create_dir(resolved).map(|()| None)","+    };","+    match result {","+      Ok(created) => Ok(Ok(created)),","+      Err(err) => Ok(Err(io_exception(ctx, &err, \"mkdir\", &path)?)),","+    }","+  }","+","+  fn rmdir_internal<'js>(","+    ctx: Ctx<'js>,","+    path: String,","+    options: Option<&Value<'js>>,","+  ) -> rquickjs::Result<Result<(), Exception<'js>>> {","+    // Deprecated in Node in favor of `rm`, but still supported.","+    let recursive = bool_option(&ctx, options, \"recursive\")?;","+    let fs = match output_fs(&ctx, \"rmdir\", &path)? {","+      Ok(fs) => fs,","+      Err(exception) => return Ok(Err(exception)),","+    };","+    let resolved = resolve_fs_path(&ctx, &path)?;","+    let result = if recursive {","+      fs.remove_dir_all(resolved)","+    } else {","+      fs.remove_dir(resolved)","+    };","+    match result {","+      Ok(()) => Ok(Ok(())),","+      Err(err) => Ok(Err(io_exception(ctx, &err, \"rmdir\", &path)?)),","+    }","+  }","+","+  fn rm_internal<'js>(","+    ctx: Ctx<'js>,","+    path: String,","+    options: Option<&Value<'js>>,","+  ) -> rquickjs::Result<Result<(), Exception<'js>>> {","+    let recursive = bool_option(&ctx, options, \"recursive\")?;","+    let force = bool_option(&ctx, options, \"force\")?;","+    let fs = match output_fs(&ctx, \"rm\", &path)? {","+      Ok(fs) => fs,","+      Err(exception) => return Ok(Err(exception)),","+    };","+    let resolved = resolve_fs_path(&ctx, &path)?;","+    let result = match fs.lstat(resolved) {","+      None => Err(std::io::Error::from(std::io::ErrorKind::NotFound)),","+      Some(stat) if stat.kind.contains(FileKind::IS_DIR) => {","+        if !recursive {","+          let exception = Exception::from_message(","+            ctx,","+            &format!(\"Path is a directory: rm returned EISDIR (is a directory) {path}\"),","+          )?;","+          exception.set(\"code\", \"ERR_FS_EISDIR\")?;","+          exception.set(\"errno\", 21)?;","+          exception.set(\"syscall\", \"rm\")?;","+          exception.set(\"path\", path)?;","+          return Ok(Err(exception));","+        }","+        fs.remove_dir_all(resolved)","+      }","+      Some(_) => fs.remove_file(resolved),","+    };","+    match result {","+      Ok(()) => Ok(Ok(())),","+      Err(err) if force && err.kind() == std::io::ErrorKind::NotFound => Ok(Ok(())),","+      Err(err) => Ok(Err(io_exception(ctx, &err, \"rm\", &path)?)),","+    }","+  }","+}","+","+/// A boolean property of an options object, defaulting to false. Other kinds of options, e.g. a","+/// `mode` number, have none.","+fn bool_option<'js>(","+  ctx: &Ctx<'js>,","+  options: Option<&Value<'js>>,","+  name: &str,","+) -> rquickjs::Result<bool> {","+  let Some(object) = options.and_then(|options| options.as_object()) else {","+    return Ok(false);","+  };","+  match object.get::<_, Value>(name)? {","+    value if value.is_undefined() => Ok(false),","+    value => value.as_bool().ok_or_else(|| {","+      Exception::throw_type(","+        ctx,","+        &format!(\"The \\\"options.{name}\\\" property must be a boolean\"),","+      )","+    }),","+  }","+}","+","+/// `fs.constants.COPYFILE_EXCL`: fail if the destination exists.","+const COPYFILE_EXCL: u32 = 1;","+","+/// The file system writes go to, or an `EROFS` error when there is none.","+fn output_fs<'js>(","+  ctx: &Ctx<'js>,","+  syscall: &str,","+  path: &str,","+) -> rquickjs::Result<Result<Arc<dyn FileSystem>, Exception<'js>>> {","+  if let Some(fs) = ctx.userdata::<OutputFileSystemData>() {","+    return Ok(Ok(fs.0.clone()));","+  }","+  let exception = Exception::from_message(","+    ctx.clone(),","+    &format!(\"EROFS: read-only file system, {syscall} '{path}'\"),","+  )?;","+  exception.set(\"code\", \"EROFS\")?;","+  exception.set(\"syscall\", syscall)?;","+  exception.set(\"path\", path)?;","+  Ok(Err(exception))","+}","+","+/// Calls a Node-style callback with only an error argument, e.g. `writeFile`'s.","+fn handle_async_void<'js>(","+  callback: &Function<'js>,","+  result: Result<(), Exception<'js>>,","+) -> rquickjs::Result<()> {","+  match result {","+    Ok(()) => callback.call((rquickjs::Null,)),","+    Err(exception) => callback.call((exception,)),","+  }","+}","+","+/// Splits a Node-style `(...optional, callback)` argument list.","+fn split_callback<'a, 'js>(","+  ctx: &Ctx<'js>,","+  rest: &'a [Value<'js>],","+) -> rquickjs::Result<(Option<&'a Value<'js>>, &'a Function<'js>)> {","+  let (option, callback) = if rest.len() >= 2 {","+    (Some(&rest[0]), rest[1].as_function())","+  } else {","+    (None, rest.first().and_then(|v| v.as_function()))","+  };","+  match callback {","+    Some(callback) => Ok((option, callback)),","+    None => Err(Exception::throw_message(","+      ctx,","+      \"Required callback not provided\",","+    )),","+  }","+}","+","+/// Like `to_promise`, but rejects with an exception `result` threw (e.g. for an invalid","+/// argument), as Node's promise API does, rather than throwing it.","+fn try_to_promise<'js, V: IntoJs<'js>>(","+  ctx: &Ctx<'js>,","+  result: rquickjs::Result<Result<V, Exception<'js>>>,","+) -> rquickjs::Result<Promise<'js>> {","+  match result {","+    Ok(result) => to_promise(ctx, result),","+    Err(rquickjs::Error::Exception) => {","+      let error = ctx.catch();","+      let (promise, _, reject) = Promise::new(ctx)?;","+      reject.call::<_, Value>((error,))?;","+      Ok(promise)","+    }","+    Err(err) => Err(err),","+  }","+}","+","+/// `fs.constants`, with the flags these functions understand.","+fn constants<'js>(ctx: &Ctx<'js>) -> rquickjs::Result<rquickjs::Object<'js>> {","+  let constants = rquickjs::Object::new(ctx.clone())?;","+  constants.set(\"F_OK\", 0)?;","+  constants.set(\"R_OK\", 4)?;","+  constants.set(\"W_OK\", 2)?;","+  constants.set(\"X_OK\", 1)?;","+  constants.set(\"COPYFILE_EXCL\", COPYFILE_EXCL)?;"],"additions":318,"deletions":1,"truncated":false}],"additions":583,"deletions":52,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-22T16:22:36.572374+00:00"}