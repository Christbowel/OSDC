ble()) {","     return false;","   }","   // Relative positions of the first and last accessed element of the tile,","@@ -260,24 +262,12 @@ bool IsGuaranteedInBounds(mlir::Value offset, int64_t tile_size,","   const int64_t last = (tile_size - 1) * tile_stride;","   const int64_t min_delta = std::min<int64_t>(0, last);","   const int64_t max_delta = std::max<int64_t>(0, last);","-","-  Interval range;","-  if (auto const_op = offset.getDefiningOp<arith::ConstantIndexOp>()) {","-    range = Interval{const_op.value(), const_op.value()};","-  } else if (auto apply_indexing =","-                 offset.getDefiningOp<::xla::ApplyIndexingOp>()) {","-    IndexingMap indexing_map = apply_indexing.getIndexingMap();","-    if (indexing_map.GetNumResults() != 1) {","-      return false;","-    }","-    // Compute the range of possible offsets for the given indexing map.","-    range = indexing_map.GetRangeEvaluator().ComputeExpressionRange(","-        indexing_map.GetSymbolicMap().GetResult(0));","-  } else {","-    return false;","-  }","-  return range.lower + min_delta >= 0 &&","-         range.upper + max_delta < original_shape;","+  // Written as `lower >= -min_delta` and `upper < original_shape - max_delta`","+  // rather than `lower + min_delta >= 0` and `upper + max_delta <","+  // original_shape` so that unbounded ranges (e.g. `[0, INT64_MAX]`) cannot","+  // overflow.","+  return range->lower >= -min_delta &&","+         range->upper < original_shape - max_delta;"," }"," "," std::pair<mlir::Value, mlir::Value> CreateTensorOfPointersAndMask(","@@ -328,13 +318,10 @@ std::pair<mlir::Value, mlir::Value> CreateTensorOfPointersAndMask(","     // Expand and broadcast range to tile shape.","     range = ExpandAndBroadcastValue(builder, range, i, i64_tile_type);"," ","-    // Create a mask for values that are inside bounds.","-    // We need to check the offset alignment with the tile size as well,","-    // otherwise we might load/store outside the valid range of the tile, even","-    // if the original shape is divisible by the tile size.","-    if (original_shape[dim] % sizes[dim] != 0 ||","-        !IsGuaranteedDivisible(offsets[dim], sizes[dim]) ||","-        !IsGuaranteedInBounds(offsets[dim], sizes[dim], strides[dim],","+    // Create a mask for values that are inside bounds, unless every accessed","+    // element `offset + i * stride` is provably within `[0, original_shape)`,","+    // in which case the mask would be all-true.","+    if (!IsGuaranteedInBounds(offsets[dim], sizes[dim], strides[dim],","                               original_shape[dim])) {","       mlir::Value upper_bound =","           arith::ConstantIntOp::create(builder, i64_type, original_shape[dim]);"],"additions":14,"deletions":27,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/lowering_util.h","lines":["@@ -101,8 +101,9 @@ mlir::Value ExpandAndBroadcastValue(mlir::ImplicitLocOpBuilder& builder,"," bool IsGuaranteedDivisible(mlir::Value value, int64_t divisor);"," "," // Returns true if every element `offset + i * tile_stride`, i in","-// [0, tile_size), is guaranteed to lie in [0, original_shape). Returns false if","-// `offset` is not a constant or an apply indexing op.","+// [0, tile_size), is guaranteed to lie in [0, original_shape). The range of","+// `offset` is taken from `xla::GetRange`, i.e. constants, apply indexing ops","+// and values annotated with `xla.range`. Returns false if no range is known."," bool IsGuaranteedInBounds(mlir::Value offset, int64_t tile_size,","                           int64_t tile_stride, int64_t original_shape);"," "],"additions":3,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/codegen/triton/lowering_util_test.cc","lines":["@@ -15,6 +15,8 @@ limitations under the License."," "," #include \"xla/backends/gpu/codegen/triton/lowering_util.h\""," ","+#include <cstdint>","+#include <limits>"," #include <string>"," #include <utility>"," ","@@ -22,6 +24,7 @@ limitations u