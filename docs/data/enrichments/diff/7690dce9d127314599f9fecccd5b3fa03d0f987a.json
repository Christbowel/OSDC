\", &name)","+        .await","+        .unwrap()","+        .unwrap();","+    let doc: Value = serde_json::from_slice(&bytes).unwrap();","+    assert_eq!(","+        doc[\"versions\"][\"1.0.0\"][\"dist\"][\"integrity\"],","+        ssri::IntegrityOpts::new()","+            .algorithm(ssri::Algorithm::Sha512)","+            .chain(b\"new\")","+            .result()","+            .to_string(),","+    );","+    assert!(","+        state.inner.storage","+            .open_upstream_blob(\"test\", &name, \"old.tgz\")","+            .await","+            .unwrap()","+            .is_none(),","+    );","+    assert!(","+        state.inner.storage","+            .open_upstream_blob(\"test\", &name, \"new.tgz\")","+            .await","+            .unwrap()","+            .is_some(),","+    );","+    old.assert_async().await;","+    new.assert_async().await;","+}","+","+#[tokio::test]","+async fn failed_pins_are_not_retried_by_download_requests() {","+    let mut server = mockito::Server::new_async().await;","+    let tmp = tempfile::tempdir().unwrap();","+    let state = state(tmp.path(), &server.url());","+    let upstream = &state.inner.proxy.upstreams[\"mirror\"];","+    let name = CanonicalPackageName::parse(\"example\", Ecosystem::Npm).unwrap();","+    let filename = \"example-1.0.0.tgz\";","+    let archive = server","+        .mock(\"GET\", \"/example/-/example-1.0.0.tgz\")","+        .with_status(404)","+        .expect(1)","+        .create_async()","+        .await;","+    let doc = json!({\"versions\":{\"1.0.0\":{\"dist\":{\"tarball\":format!(\"{}/example/-/{filename}\", server.url())}}}});","+    state.inner.storage","+        .write_upstream_document(\"test\", &name, &serde_json::to_vec(&doc).unwrap())","+        .await","+        .unwrap();","+    schedule(&state, \"test\", upstream, &name);","+    wait(&state, \"test\", &name).await;","+    for _ in 0..2 {","+        super::wait_for_pin(&state, \"test\", upstream, &name, filename).await.unwrap();"],"additi