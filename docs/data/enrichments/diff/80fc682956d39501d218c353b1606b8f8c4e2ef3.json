 'params' in request ? request.params : undefined,","+    })","+  }","+","+  receive(message: unknown) {","+    this.dispatchEvent(new MessageEvent('message', {data: JSON.stringify(message)}))","+  }","+","+  reply(method: string, result: unknown) {","+    const request = this.requests.findLast((entry) => entry.method === method)","+    if (!request) throw new Error(`No ${method} request`)","+    this.receive({jsonrpc: '2.0', id: request.id, result})","+  }","+","+  closeFromServer(code: number) {","+    this.readyState = this.CLOSED","+    this.onclose?.(new CloseEvent('close', {code, reason: 'Connection closed'}))","+  }","+","+  close() {","+    this.readyState = this.CLOSED","+  }","+}","+","+function socketAt(index: number) {","+  const socket = sockets[index]","+  if (!socket) throw new Error(`Socket ${index} hasn't been created`)","+  return socket","+}","+","+describe('connection status authorization rejection', () => {","+  let subscriptions: Subscription","+","+  beforeEach(() => {","+    subscriptions = new Subscription()","+    sockets.length = 0","+    vi.useFakeTimers()","+    vi.setSystemTime(new Date('2026-10-30T12:00:00Z'))","+    vi.stubGlobal('WebSocket', TestWebSocket)","+  })","+","+  afterEach(() => {","+    subscriptions.unsubscribe()","+    vi.clearAllTimers()","+    vi.useRealTimers()","+    vi.unstubAllGlobals()","+  })","+","+  function connect(token$ = new BehaviorSubject<string | null>('rejected-token')) {","+    const options = createBifurClient(client, token$)","+    const store = createConnectionStatusStore(options)","+    const statuses: ConnectionStatus[] = []","+    subscriptions.add(store.connectionStatus$.subscribe((status) => statuses.push(status)))","+    return {bifur: options.bifur, store, token$, statuses}","+  }","+","+  it('reports connecting while waiting for the initial token', () => {","+    const token$ = new ReplaySubject<string | null>(1)","+    const options = createBifurClient(client, token$)","+    const store = c