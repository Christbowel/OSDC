en')","+    socket.reply('authorization', {})","+","+    expect(sockets).toHaveLength(1)","+    expect(socket.requests.filter((request) => request.method === 'authorization')).toEqual([","+      expect.objectContaining({params: {authorization: 'Bearer rejected-token', apiVersion: 'v1'}}),","+      expect.objectContaining({","+        params: {authorization: 'Bearer refreshed-token', apiVersion: 'v1'},","+      }),","+    ])","+    expect(statuses.at(-1)?.type).toBe('connected')","+  })","+","+  it('allows an explicit retry when the client uses cookies', async () => {","+    const store = createConnectionStatusStore(createBifurClient(client))","+    subscriptions.add(store.connectionStatus$.subscribe())","+    socketAt(0).open()","+    socketAt(0).closeFromServer(4001)","+    await vi.advanceTimersByTimeAsync(1000)","+    expect(sockets).toHaveLength(1)","+","+    onRetry()","+    socketAt(1).open()","+    expect(sockets).toHaveLength(2)","+  })","+","+  it('shares retries across status subscribers', async () => {","+    const {store} = connect()","+    const otherStatuses: ConnectionStatus[] = []","+    subscriptions.add(store.connectionStatus$.subscribe((status) => otherStatuses.push(status)))","+    socketAt(0).open()","+    socketAt(0).closeFromServer(4001)","+    await vi.advanceTimersByTimeAsync(1000)","+    expect(sockets).toHaveLength(1)","+","+    onRetry()","+    const recovered = socketAt(1)","+    recovered.open()","+    recovered.reply('authorization', {})","+","+    expect(sockets).toHaveLength(2)","+    expect(recovered.requests.filter((request) => request.method === 'authorization')).toHaveLength(","+      1,","+    )","+    expect(otherStatuses.at(-1)?.type).toBe('connected')","+  })","+","+  it('preserves increasing delays for transient failures without traffic', async () => {","+    const {statuses} = connect()","+    socketAt(0).closeFromServer(1006)","+    expect(statuses.at(-1)).toMatchObject({","+      type: 'error',","+      attemptNo: 1,","+ 