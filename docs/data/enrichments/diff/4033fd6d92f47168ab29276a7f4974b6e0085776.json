.UTF-8'],","+        ]));","+","+        self::assertSame(['main'], array_keys($this->get(SiteConfiguration::class)->resolveAllExistingSitesRaw()));","+        self::assertStringContainsString('site=main', $response->getHeaderLine('Location'));","+    }","+","+    #[Test]","+    public function saveCreatesSiteWithSingleLanguageAsLanguageZero(): void","+    {","+        $this->get(SiteConfigurationController::class)->saveAction($this->createSaveRequest(1, 'new-site', [","+            'NEW1' => ['languageId' => 1, 'title' => 'German', 'base' => '/', 'locale' => 'de_DE.UTF-8'],","+        ]));","+","+        self::assertSame([0], $this->getStoredLanguageIds('new-site'));","+        self::assertSame([], $this->getFlashMessageTitles());","+    }","+","+    #[Test]","+    public function saveDoesNotCreateSiteWithoutLanguageZeroAndShowsCreationFormAgain(): void","+    {","+        $response = $this->get(SiteConfigurationController::class)->saveAction($this->createSaveRequest(1, 'new-site', [","+            'NEW1' => ['languageId' => 1, 'title' => 'German', 'base' => '/de/', 'locale' => 'de_DE.UTF-8'],","+            'NEW2' => ['languageId' => 2, 'title' => 'French', 'base' => '/fr/', 'locale' => 'fr_FR.UTF-8'],","+        ]));","+","+        self::assertArrayNotHasKey('new-site', $this->get(SiteConfiguration::class)->resolveAllExistingSitesRaw());","+        self::assertSame(['Site configuration not saved'], $this->getFlashMessageTitles());","+        $location = $response->getHeaderLine('Location');","+        self::assertStringContainsString('pageUid=1', $location);","+        self::assertStringNotContainsString('site=', $location);","+    }","+","+    #[Test]","+    public function detailShowsErrorIfLanguageZeroIsNotConfigured(): void","+    {","+        $this->writeSiteWithLanguages([1, 2]);","+","+        $response = $this->get(SiteConfigurationController::class)->detailAction($this->createModuleRequest('detail', ['site' => 'main']));","+","+        self::assertStringContainsString('Default language missing', (string)$response->getBody());","+    }","+","+    #[Test]","+    public function detailShowsNoErrorIfLanguageZeroIsConfigured(): void","+    {","+        $this->writeSiteWithLanguages([1, 0]);","+","+        $response = $this->get(SiteConfigurationController::class)->detailAction($this->createModuleRequest('detail', ['site' => 'main']));","+","+        self::assertStringNotContainsString('Default language missing', (string)$response->getBody());","+    }","+","     public static function overviewTilesDataProvider(): array","     {","         return [","@@ -72,6 +160,36 @@ public function overviewTilesShowDefaultLanguage(array $languageIds, string $exp","         self::assertStringNotContainsString($otherLanguageTitle, $body);","     }"," ","+    public static function overviewDataProvider(): array","+    {","+        return [","+            'list without language 0' => [SetupModuleViewMode::LIST, [1, 2], true],","+            'list with language 0' => [SetupModuleViewMode::LIST, [1, 0], false],","+            'tiles without language 0' => [SetupModuleViewMode::TILES, [1, 2], true],","+            'tiles with language 0' => [SetupModuleViewMode::TILES, [1, 0], false],","+        ];","+    }","+","+    /**","+     * @param list<int> $languageIds","+     */","+    #[DataProvider('overviewDataProvider')]","+    #[Test]","+    public function overviewShowsErrorOnlyIfLanguageZeroIsNotConfigured(SetupModuleViewMode $viewMode, array $languageIds, bool $expectError): void","+    {","+        $this->writeSiteWithLanguages($languageIds);","+        $request = $this->createModuleRequest('', []);","+        $request = $request->withAttribute(","+            'moduleData',","+            ModuleData::createFromModule($request->getAttribute('module'), ['viewMode' => $viewMode->value])","+        );","+","+        $body = (string)$this->get(SiteConfigurationController::class)->overviewAction($request)->getBody();","+","+        self::assertStringContainsString('https://example.com/', $body);","+        self::assertSame($expectError, str_contains($body, 'Default language missing'));","+    }","+","     /**","      * @param list<int> $languageIds","      */","@@ -94,6 +212,47 @@ private function writeSiteWithLanguages(array $languageIds): void","         ]);","     }"," ","+    /**","+     * @return list<int>","+     */","+    private function getStoredLanguageIds(string $siteIdentifier): array","+    {","+        $configuration = $this->get(SiteConfiguration::class)->load($siteIdentifier);","+        return array_map(static fn(array $language): int => (int)$language['languageId'], $configuration['languages']);","+    }","+","+    /**","+     * @return list<string>","+     */","+    private function getFlashMessageTitles(): array","+    {","+        $messages = $this->get(FlashMessageService::class)->getMessageQueueByIdentifier()->getAllMessages();","+        return array_map(static fn(FlashMessage $message): string => $message->getTitle(), $messages);","+    }","+","+    /**","+     * @param array<int|string, array<string, int|string>> $siteLanguages","+     */","+    private function createSaveRequest(int $rootPageId, string $siteIdentifier, array $siteLanguages): ServerRequestInterface","+    {","+        return $this->createModuleRequest('save', [])","+            ->withMethod('POST')","+            ->withParsedBody([","+                '_savedok' => '1',","+                'rootPageId' => (string)$rootPageId,","+                'data' => [","+                    'site' => [","+                        $rootPageId => [","+                            'identifier' => $siteIdentifier,","+                            'base' => 'https://example.com/',","+                            'languages' => implode(',', array_keys($siteLanguages)),","+                        ],","+                    ],","+                    'site_language' => $siteLanguages,","+                ],","+            ]);","+    }","+","     /**","      * @param array<string, string> $queryParams","      */"],"additions":159,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Command/SiteValidateCommand.php","lines":["@@ -77,7 +77,7 @@ protected function execute(InputInterface $input, OutputInterface $output): int","             $errorsBySite[$invalidSite['identifier']][] = $invalidSite;","         }","         foreach ($sites as $site) {","-            foreach ($this->validateBases($site) as $error) {","+            foreach ([...$this->validateBases($site), ...$this->validateDefaultLanguage($site)] as $error) {","                 $errorsBySite[$site->getIdentifier()][] = $error;","             }","         }","@@ -100,7 +100,7 @@ protected function execute(InputInterface $input, OutputInterface $output): int","                     ['Root page ID' => $error['rootPageId'] ?? '-'],","                     ['Configuration option' => $error['field'] ?? '-'],","                     ['Error' => OutputFormatter::escape($error['message'])],","-                    ['Exception' => OutputFormatter::escape($error['type']) . ' (#' . $error['code'] . ')'],","+                    ...(isset($error['type']) ? [['Exception' => OutputFormatter::escape($error['type']) . ' (#' . $error['code'] . ')']] : []),","                 );","                 $errorCount++;","             }","@@ -111,6 +111,25 @@ protected function execute(InputInterface $input, OutputInterface $output): int","         return Command::FAILURE;","     }"," ","+    /**","+     * A site without language 0 still works, as Site::getDefaultLanguage() falls back to","+     * the first configured language, but it cannot be saved in the backend anymore.","+     *","+     * @return list<array{identifier: string, rootPageId: int, message: string, field: string}>","+     */","+    private function validateDefaultLanguage(Site $site): array","+    {","+        if (isset($site->getAllLanguages()[0])) {","+            return [];","+        }","+        return [[","+            'identifier' => $site->getIdentifier(),","+            'rootPageId' => $site->getRootPageId(),","+            'message' => sprintf('Site \"%s\" has no language with ID 0, which is required as default language.', $site->getIdentifier()),","+            'field' => 'languages',","+        ]];","+    }","+","     /**","      * A Site object only validates the base of the base variant matching the current context,","      * which differs between deployment, CLI and web requests. Validate the base and the base of"],"additions":21,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Important-111285-SitesRequireLanguageZero.rst","lines":["@@ -0,0 +1,30 @@","+..  include:: /Includes.rst.txt","+","+..  _important-111285-1793311928:","+","+========================================================","+Important: #111285 - Sites require language 0 as default","+========================================================","+","+See :issue:`111285`","+","+Description","+===========","+","+TYPO3 expects every site to configure a language with ID `0`, which is used","+as the default language of the site. The position of this language in the","+site configuration does not matter.","+","+The :guilabel:`System > Sites` module now shows an error for sites without","+a language `0` in the site overview and in the site details, and refuses to","+save a site configuration without a language `0`. The command","+:bash:`vendor/bin/typo3 site:validate` reports such sites as an error of the","+configuration option `languages`.","+","+Sites without a language `0` keep working in the frontend: the first","+configured language is used as default language. Add a language with ID `0`","+to the configuration of such sites, either by editing the site in the","+:guilabel:`System > Sites` module, which adds the language to the form, or","+by editing the :file:`config/sites/<identifier>/config.yaml` file.","+","+..  index:: Backend, YAML, ext:backend"],"additions":30,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Command/SiteValidateCommandValidSitesTest.php","lines":["@@ -231,4 +231,31 @@ public function validatingSiteReportsMalformedBaseOverriddenByActiveBaseVariant(","         self::assertStringContainsString('The parsedUri \"https:///\" appears to be malformed', $output);","         self::assertStringContainsString('One site configuration error was found.', $output);","     }","+","+    #[Test]","+    public function validatingSiteReportsMissingLanguageZero(): void","+    {","+        $this->get(SiteWriter::class)->write('no-language-zero', [","+            'rootPageId' => 9,","+            'base' => 'https://no-language-zero.example.com/',","+            'languages' => [","+                [","+                    'languageId' => 1,","+                    'title' => 'German',","+                    'locale' => 'de_DE.UTF-8',","+                    'base' => '/',","+                ],","+            ],","+        ]);","+","+        $tester = new CommandTester($this->get(SiteValidateCommand::class));","+        $tester->execute(['identifier' => 'no-language-zero']);","+        $output = $tester->getDisplay();","+","+        self::assertSame(Command::FAILURE, $tester->getStatusCode(), $output);","+        self::assertStringContainsString('Site \"no-language-zero\"', $output);","+        self::assertMatchesRegularExpression('/Configuration option\\s+languages\\s/', $output);","+        self::assertStringContainsString('has no language with ID 0', $output);","+        self::assertStringContainsString('One site configuration error was found.', $output);","+    }"," }",""],"additions":27,"deletions":0,"truncated":false}],"additions":298,"deletions":7,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-14T15:14:12.011128+00:00"}