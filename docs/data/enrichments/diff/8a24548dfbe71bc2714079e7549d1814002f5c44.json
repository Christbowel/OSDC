at holds this","+# script.  Source files under SOURCE-ROOT/src and SOURCE-ROOT/ext are","+# scanned.","+#","+# The following checks are made:","+#","+#   (1) The declared size of sqlite3Tuning[] equals the number of","+#       initializers.","+#   (2) sqlite3Tuning[0] holds the index of the largest element in the","+#       array, that is, the number of initializers minus 1.","+#   (3) Every Tuning(D,ID) that is not on a line that begins with \"**\",","+#       \"#\" or \"/*\" has no surplus whitespace, and both D and ID are","+#       integers.  (ID must additionally be in the range 1..N.)","+#   (4) All Tuning() macros that have the same ID have the same D.","+#   (5) The D and ID of every Tuning() macro match the default value","+#       held in the sqlite3Tuning[] array.","+#","+# Produce no output and exit 0 if all is well.  Otherwise, write error","+# messages to stderr and exit 1.","+#","+","+set nErr 0","+proc error_msg {msg} {","+  global nErr","+  puts stderr $msg","+  incr nErr","+}","+","+if {[llength $argv]>1} {","+  puts stderr \"Usage: $argv0 ?SOURCE-ROOT?\"","+  exit 1","+}","+if {[llength $argv]==1} {","+  set root [lindex $argv 0]","+} else {","+  set root [file dirname [file dirname [file normalize [info script]]]]","+}","+","+# Return a list of all source files below directory $dir.","+#","+proc find_sources {dir} {","+  set res {}","+  foreach f [lsort [glob -nocomplain -directory $dir/src *]] {","+    if {[lsearch -exact {.c .h .y .in} [file extension $f]]>=0} {","+      lappend res $f","+    }","+  }","+  return $res","+}","+","+# Read a whole file.","+#","+proc readfile {fn} {","+  set in [open $fn rb]","+  set x [read $in]","+  close $in","+  return $x","+}","+","+# ---------------------------------------------------------------------","+# Parse the sqlite3Tuning[] array out of src/global.c.","+#","+set globalc [file join $root src global.c]","+if {![file exists $globalc]} {","+  puts stderr \"cannot find $globalc\"","+  exit 1","+}","+set content [readfile $globalc]","+# (Tcl regular expressions take their greediness from the first quantifier,","+# so locate the initializer using string operations instead.)","+set body \"\"","+if {![regexp -indices {int\\s+sqlite3Tuning\\s*\\[\\s*([^\\]]*)\\]\\s*=\\s*\\{} \\","+        $content all sz]} {","+  puts stderr \"$globalc: cannot find the initialized sqlite3Tuning\\[\\] array\"","+  exit 1","+}","+set declSize [string trim [string range $content {*}$sz]]","+set iStart [expr {[lindex $all 1]+1}]","+set iEnd [string first \\} $content $iStart]","+if {$iEnd<0} {","+  puts stderr \"$globalc: unterminated sqlite3Tuning\\[\\] initializer\"","+  exit 1","+}","+set body [string range $content $iStart [expr {$iEnd-1}]]","+regsub -all {/\\*.*?\\*/} $body {} body     ;# remove comments","+set aDflt {}                              ;# Initializer values, by index","+foreach term [split $body ,] {","+  set term [string trim $term]","+  if {$term eq \"\"} continue","+  if {![regexp {^[-+]?\\d+$} $term]} {","+    error_msg \"$globalc: sqlite3Tuning\\[\\] initializer \\\"$term\\\" is not\\","+               an integer\"","+    continue","+  }","+  lappend aDflt [scan $term %d]","+}","+set nElem [llength $aDflt]","+set iLast [expr {$nElem-1}]","+","+# (1) The array size must be correct.","+if {![regexp {^\\d+$} $declSize]} {","+  error_msg \"$globalc: size of sqlite3Tuning\\[\\] is \\\"$declSize\\\", which is\\","+             not an integer constant\"","+} elseif {$declSize != $nElem} {","+  error_msg \"$globalc: sqlite3Tuning\\[$declSize\\] has $nElem initializers\"","+}","+","+# (2) Element 0 holds the index of the largest element.","+if {$nElem==0} {","+  error_msg \"$globalc: sqlite3Tuning\\[\\] is empty\"","+} elseif {[lindex $aDflt 0] != $iLast} {","+  error_msg \"$globalc: sqlite3Tuning\\[0\\] is [lindex $aDflt 0] but the index\\","+             of the largest element is $iLast\"","+}","+","+# ---------------------------------------------------------------------","+# Scan the source for Tuning(D,ID) macros."],"additions":124,"deletions":0,"truncated":false}],"additions":285,"deletions":74,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-16T17:24:17.355391+00:00"}