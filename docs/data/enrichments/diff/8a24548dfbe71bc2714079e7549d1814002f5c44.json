38,6 +335,49 @@ unsigned int sqlite3CoverageCounter;"," sqlite3_uint64 sqlite3NProfileCnt = 0;"," #endif"," ","+#if defined(SQLITE_DEBUG) || defined(SQLITE_ENABLE_TUNING)","+/* Query planner tuning parameters.  Development and testing use","+** only.","+**","+** This array must be kept in synchronization with the various","+** \"Tuning(D,ID)\" macros in the code (mostly in where.c and select.c).","+** Updates in the code must be replicated in this array.  The","+** tool/tuningverify.tcl script runs at build time to verify that","+** this array is in alignment with all Tuning() macros.","+*/","+int sqlite3Tuning[28] = {","+  27,  /* Number of tuning parameters */","+  30,  /*  1 */","+  20,  /*  2 */","+  20,  /*  3 */","+  46,  /*  4 */","+  10,  /*  5 */","+  10,  /*  6 */","+  10,  /*  7 */","+  42,  /*  8 */","+   5,  /*  9 */","+  16,  /* 10 */","+   3,  /* 11 */","+  28,  /* 12 */","+  25,  /* 13 */","+  43,  /* 14 */","+   1,  /* 15 */","+  10,  /* 16 */","+   6,  /* 17 */","+  10,  /* 18 */","+   5,  /* 19 */","+   3,  /* 20 */","+   2,  /* 21 */","+  33,  /* 22 */","+  39,  /* 23 */","+  30,  /* 24 */","+  18,  /* 25 */","+  12,  /* 26 */","+  48,  /* 27 */","+};","+#endif /* SQLITE_DEBUG || SQLITE_ENABLE_TUNING */","+","+"," /*"," ** The value of the \"pending\" byte must be 0x40000000 (1 byte past the"," ** 1-gibabyte boundary) in a compatible database.  SQLite never uses"],"additions":43,"deletions":3,"truncated":false},{"path":"src/main.c","lines":["@@ -4833,31 +4833,40 @@ int sqlite3_test_control(int op, ...){","       break;","     }"," ","-#if defined(SQLITE_DEBUG) && !defined(SQLITE_OMIT_WSD)","+#if defined(SQLITE_DEBUG) || defined(SQLITE_ENABLE_TUNING)","     /* sqlite3_test_control(SQLITE_TESTCTRL_TUNE, id, *piValue)","     **","-    ** If \"id\" is an integer between 1 and SQLITE_NTUNE then set the value","-    ** of the id-th tuning parameter to *piValue.  If \"id\" is between -1","-    ** and -SQLITE_NTUNE, then write the current value of the (-id)-th","-    ** tuning parameter into *piValue.","+    ** If \"id\" is an integer between 1 and N (where N is the number of","+    ** tuning parameters) then set the value of the id-th tuning parameter","+    ** to *piValue.  If \"id\" is between -1 and -N, then write the current","+    ** value of the (-id)-th tuning parameter into *piValue.  If \"id\" is","+    ** zero, return the number of tuning parameters (N).","     **","-    ** Tuning parameters are for use during transient development builds,","+    ** Tuning parameters are for use during development builds,","     ** to help find the best values for constants in the query planner.","-    ** Access tuning parameters using the Tuning(ID) macro.  Set the","+    ** Access tuning parameters using the Tuning(D,ID) macro.  Set the","     ** parameters in the CLI using \".testctrl tune ID VALUE\".","     **","-    ** Transient use only.  Tuning parameters should not be used in","-    ** checked-in code.","+    ** See source code comments","+    **","+    ** Tuning parameters apply across all database connections for a process.","+    **","+    ** This interface is not threadsafe.  Do not change tuning parameters","+    ** while database connections are running on other threads.","     */","     case SQLITE_TESTCTRL_TUNE: {","       int id = va_arg(ap, int);","       int *piValue = va_arg(ap, int*);","-      if( id>0 && id<=SQLITE_NTUNE ){","-        Tuning(id) = *piValue;","-      }else if( id<0 && id>=-SQLITE_NTUNE ){","-        *piValue = Tuning(-id);","-      }else{","+      int N = sqlite3Tuning[0];","+      if( id>N || id<(-N) ){","         rc = SQLITE_NOTFOUND;","+        break;","+      }","+      rc = SQLITE_OK;","+      if( id>0 ){","+        sqlite3Tuning[id] = *piValue;","+      }else if( id<=0 ){","+        *piValue = sqlite3Tuning[-id];","       }","       break;","     }"],"additions":23,"deletions":14,"truncated":false},{"path":"src/select.c","lines":["@@ -8630,7 +8630,7 @@ int sqlite3Select(","    