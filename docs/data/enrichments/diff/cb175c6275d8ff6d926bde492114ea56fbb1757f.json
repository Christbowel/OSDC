r.operationDuration.Record(ctx, durationSeconds, metric.WithAttributes(attrs...))"," }"," ","+// skipNilReply reports whether err is redis.Nil and Nil replies are not","+// recorded as errors. A Nil reply is a successful command with no value.","+func (r *metricsRecorder) skipNilReply(err error) bool {","+\treturn !r.recordNilErrors() && errors.Is(err, redis.Nil)","+}","+","+func (r *metricsRecorder) recordNilErrors() bool {","+\treturn r.cfg != nil && r.cfg.recordNilErrors","+}","+"," // classifyError returns the error.type attribute value"," // Format: <category>:<subcategory>:<error_name>"," func classifyError(err error) string {","@@ -195,6 +205,10 @@ func classifyError(err error) string {"," \t\treturn \"\""," \t}"," ","+\tif errors.Is(err, redis.Nil) {","+\t\treturn redis.ErrorTypeNil","+\t}","+"," \t// Timeout errors"," \tif isTimeoutError(err) {"," \t\treturn \"timeout\"","@@ -309,6 +323,10 @@ func extractRedisErrorPrefix(err error) string {"," \t\treturn \"\""," \t}"," ","+\tif errors.Is(err, redis.Nil) {","+\t\treturn redis.ErrorTypeNil","+\t}","+"," \terrStr := err.Error()"," "," \t// Redis errors typically start with an uppercase prefix","@@ -364,6 +382,10 @@ func getErrorCategory(err error) string {"," \t\treturn \"\""," \t}"," ","+\tif errors.Is(err, redis.Nil) {","+\t\treturn redis.ErrorTypeNil","+\t}","+"," \terrStr := err.Error()"," "," \t// For actual errors, also check error types","@@ -386,6 +408,10 @@ func getErrorCategoryFromString(errStr string) string {"," \t\treturn \"\""," \t}"," ","+\tif errStr == redis.ErrorTypeNil {","+\t\treturn redis.ErrorTypeNil","+\t}","+"," \terrLower := strings.ToLower(errStr)"," "," \t// Check for TLS errors","@@ -591,6 +617,9 @@ func (r *metricsRecorder) RecordError("," \tif r.clientErrors == nil {"," \t\treturn"," \t}","+\tif errorType == redis.ErrorTypeNil && !r.recordNilErrors() {","+\t\treturn","+\t}"," "," \t// Extract server address and peer address from connection (may be nil for some errors)"," \t// For client connections, peer address is the same as server address (remote endpoint)"],"additions":31,"deletions":2,"truncated":false},{"path":"extra/redisotel-native/metrics_nil_reply_test.go","lines":["@@ -0,0 +1,165 @@","+package redisotel","+","+import (","+\t\"context\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/redis/go-redis/v9\"","+\t\"go.opentelemetry.io/otel/attribute\"","+\t\"go.opentelemetry.io/otel/sdk/metric\"","+\t\"go.opentelemetry.io/otel/sdk/metric/metricdata\"","+)","+","+// TestOperationDurationSkipsNilReplyAttributes verifies a Nil reply records no","+// error attributes on db.client.operation.duration.","+func TestOperationDurationSkipsNilReplyAttributes(t *testing.T) {","+\tctx := context.Background()","+\treader := metric.NewManualReader()","+\tmeterProvider := metric.NewMeterProvider(metric.WithReader(reader))","+\tdefer func() {","+\t\t_ = meterProvider.Shutdown(ctx)","+\t}()","+","+\thistogram, err := meterProvider.Meter(\"test\").Float64Histogram(MetricOperationDuration)","+\tif err != nil {","+\t\tt.Fatalf(\"Failed to create histogram: %v\", err)","+\t}","+\trecorder := &metricsRecorder{operationDuration: histogram}","+","+\trecorder.RecordOperationDuration(ctx, time.Millisecond, redis.NewStringCmd(ctx, \"get\", \"k\"), 1, redis.Nil, nil, 0)","+","+\tvar rm metricdata.ResourceMetrics","+\tif err := reader.Collect(ctx, &rm); err != nil {","+\t\tt.Fatalf(\"Failed to collect metrics: %v\", err)","+\t}","+","+\tpoints := 0","+\tfor _, sm := range rm.ScopeMetrics {","+\t\tfor _, m := range sm.Metrics {","+\t\t\tif m.Name != MetricOperationDuration {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tfor _, dp := range m.Data.(metricdata.Histogram[float64]).DataPoints {","+\t\t\t\tpoints++","+\t\t\t\tfor _, attr := range dp.Attributes.ToSlice() {","+\t\t\t\t\tswitch string(attr.Key) {","+\t\t\t\t\tcase AttrErrorType, AttrRedisClientErrorsCategory, AttrDBResponseStatusCode:","+\t\t\t\t\t\tt.Errorf(\"Nil reply tagged %s=%v, expected no error attributes\", attr.Key, attr.Value.AsString())","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+\tif points != 1 {","+\t\tt.Fatalf(\"Recorded %d data points, expected 1\", points)","+\t}","+}","+","+// TestOperationDurationRecordsNilReplyAttributes verifies a Nil reply is tagged","+// with the NIL error type on db.client.operation.duration when WithRecordNilErrors is set.","+func TestOperationDurationRecordsNilReplyAttributes(t *testing.T) {","+\tctx := context.Background()","+\treader := metric.NewManualReader()","+\tmeterProvider := metric.NewMeterProvider(metric.WithReader(reader))","+\tdefer func() {","+\t\t_ = meterProvider.Shutdown(ctx)","+\t}()","+","+\thistogram, err := meterProvider.Meter(\"test\").Float64Histogram(MetricOperationDuration)","+\tif err != nil {","+\t\tt.Fatalf(\"Failed to create histogram: %v\", err)","+\t}","+\trecorder := &metricsRecorder{","+\t\toperationDuration: histogram,","+\t\tcfg:               &config{recordNilErrors: true},","+\t}","+","+\trecorder.RecordOperationDuration(ctx, time.Millisecond, redis.NewStringCmd(ctx, \"get\", \"k\"), 1, redis.Nil, nil, 0)","+","+\tvar rm metricdata.ResourceMetrics","+\tif err := reader.Collect(ctx, &rm); err != nil {","+\t\tt.Fatalf(\"Failed to collect metrics: %v\", err)","+\t}","+","+\tpoints := 0","+\tfor _, sm := range rm.ScopeMetrics {","+\t\tfor _, m := range sm.Metrics {","+\t\t\tif m.Name != MetricOperationDuration {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tfor _, dp := range m.Data.(metricdata.Histogram[float64]).DataPoints {","+\t\t\t\tpoints++","+\t\t\t\tfor _, key := range []string{AttrErrorType, AttrRedisClientErrorsCategory, AttrDBResponseStatusCode} {","+\t\t\t\t\tvalue, ok := dp.Attributes.Value(attribute.Key(key))","+\t\t\t\t\tif !ok || value.AsString() != redis.ErrorTypeNil {","+\t\t\t\t\t\tt.Errorf(\"Nil reply tagged %s=%v, expected %s\", key, value.AsString(), redis.ErrorTypeNil)","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+\tif points != 1 {","+\t\tt.Fatalf(\"Recorded %d data points, expected 1\", points)","+\t}","+}","+","+// TestRecordErrorNilReply verifies RecordError drops the NIL error type by","+// default, records it with WithRecordNilErrors, and always records real errors.","+func TestRecordErrorNilReply(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname      string","+\t\trecordNil bool","+\t\twant      map[string]int64","+\t}{","+\t\t{name: \"default\", recordNil: false, want: map[string]int64{\"WRONGTYPE\": 1}},","+\t\t{name: \"record nil\", recordNil: true, want: map[string]int64{\"WRONGTYPE\": 1, \"NIL\": 1}},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tctx := context.Background()","+\t\t\treader := metric.NewManualReader()","+\t\t\tmeterProvider := metric.NewMeterProvider(metric.WithReader(reader))","+\t\t\tdefer func() {","+\t\t\t\t_ = meterProvider.Shutdown(ctx)","+\t\t\t}()","+","+\t\t\tcounter, err := meterProvider.Meter(\"test\").Int64Counter(MetricClientErrors)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"Failed to create counter: %v\", err)","+\t\t\t}","+\t\t\trecorder := &metricsRecorder{","+\t\t\t\tclientErrors: counter,","+\t\t\t\tcfg:          &config{recordNilErrors: tc.recordNil},","+\t\t\t}","+","+\t\t\trecorder.RecordError(ctx, \"NIL\", nil, \"NIL\", false, 0)","+\t\t\trecorder.RecordError(ctx, \"WRONGTYPE\", nil, \"WRONGTYPE\", false, 0)","+","+\t\t\tvar rm metricdata.ResourceMetrics","+\t\t\tif err := reader.Collect(ctx, &rm); err != nil {","+\t\t\t\tt.Fatalf(\"Failed to collect metrics: %v\", err)","+\t\t\t}","+","+\t\t\tgot := map[string]int64{}","+\t\t\tfor _, sm := range rm.ScopeMetrics {","+\t\t\t\tfor _, m := range sm.Metrics {","+\t\t\t\t\tif m.Name != MetricClientErrors {","+\t\t\t\t\t\tcontinue","+\t\t\t\t\t}","+\t\t\t\t\tfor _, dp := range m.Data.(metricdata.Sum[int64]).DataPoints {","+\t\t\t\t\t\terrorType, _ := dp.Attributes.Value(AttrErrorType)","+\t\t\t\t\t\tgot[errorType.AsString()] += dp.Value","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t\tif len(got) != len(tc.want) {","+\t\t\t\tt.Fatalf(\"Recorded %v, expected %v\", got, tc.want)","+\t\t\t}","+\t\t\tfor k, v := range tc.want {","+\t\t\t\tif got[k] != v {","+\t\t\t\t\tt.Fatalf(\"Recorded %v, expected %v\", got, tc.want)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":165,"deletions":0,"truncated":false},{"path":"extra/redisotel-native/redisotel.go","lines":["@@ -168,6 +168,7 @@ func (o *ObservabilityInstance) configToInternal(cfg *Config) config {"," \t\texcludeCommands:                 cfg.ExcludeCommands,"," \t\thidePubSubChannelNames:          cfg.HidePubSubChannelNames,"," \t\thideStreamNames:                 cfg.HideStreamNames,","+\t\trecordNilErrors:                 cfg.RecordNilErrors,"," \t\thistAggregation:                 cfg.HistogramAggregation,"," \t\tbucketsOperationDuration:        cfg.BucketsOperationDuration,"," \t\tbucketsStreamProcessingDuration: cfg.BucketsStreamLag,"],"additions":1,"deletions":0,"truncated":false},{"path":"metrics_nil_reply_test.go","lines":["@@ -0,0 +1,69 @@","+package redis","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"sync/atomic\"","+\t\"testing\"","+","+\t\"github.com/redis/go-redis/v9/internal/pool\"","+\t\"github.com/redis/go-redis/v9/internal/proto\"","+)","+","+// TestClassifyCommandErrorNilReply pins that a Nil reply (GET on a missing key)","+// gets its own NIL type, so the recorder can drop it. Before, Nil matched no case","+// and every cache miss was counted as an UNKNOWN internal client error.","+func TestClassifyCommandErrorNilReply(t *testing.T) {","+\tfor _, err := range []error{Nil, fmt.Errorf(\"hook: %w\", Nil)} {","+\t\terrorType, statusCode, isInternal := classifyCommandError(err)","+\t\tif errorType != \"NIL\" || statusCode != \"NIL\" || isInternal {","+\t\t\tt.Fatalf(\"classifyCommandError(%v) = %q, %q, %v, want NIL, NIL, false\", err, errorType, statusCode, isInternal)","+\t\t}","+\t}","+","+\terrorType, _, _ := classifyCommandError(proto.RedisError(\"WRONGTYPE Operation\"))","+\tif errorType != \"WRONGTYPE\" {","+\t\tt.Fatalf(\"errorType = %q, want WRONGTYPE\", errorType)","+\t}","+}","+","+// TestPipelineNilReplyErrorType is the pipeline twin: generalProcessPipeline","+// reports the first command's error, so a batch led by a miss emitted one UNKNOWN","+// error per Exec. Needs a server — the error surfaces only from a real reply.","+func TestPipelineNilReplyErrorType(t *testing.T) {","+\tif err := probeRedis(internalTestRedisAddr()); err != nil {","+\t\tt.Skipf(\"no redis: %v\", err)","+\t}","+","+\tvar calls atomic.Int64","+\tvar gotType atomic.Value","+\tpool.SetAllMetricCallbacks(&pool.MetricCallbacks{","+\t\tError: func(_ context.Context, errorType string, _ *pool.Conn, _ string, _ bool, _ int) {","+\t\t\tcalls.Add(1)","+\t\t\tgotType.Store(errorType)","+\t\t},","+\t})","+\tdefer pool.SetAllMetricCallbacks(nil)","+","+\tctx := context.Background()","+\tclient := NewClient(&Options{Addr: internalTestRedisAddr()})","+\tdefer client.Close()","+","+\tif err := client.Del(ctx, \"nil-reply-metric\").Err(); err != nil {","+\t\tt.Fatalf(\"del: %v\", err)","+\t}","+\tcalls.Store(0)","+","+\tpipe := client.Pipeline()","+\tpipe.Get(ctx, \"nil-reply-metric\")","+\tpipe.Ping(ctx)","+\tif _, err := pipe.Exec(ctx); err != Nil {","+\t\tt.Fatalf(\"Exec err = %v, want Nil\", err)","+\t}","+\tif got := calls.Load(); got != 1 {","+\t\tt.Fatalf(\"error callback invoked %d times for a pipelined miss, want 1\", got)","+\t}","+\tif got := gotType.Load(); got != \"NIL\" {","+\t\tt.Fatalf(\"errorType = %v, want NIL\", got)","+\t}","+}"],"additions":69,"deletions":0,"truncated":false},{"path":"otel.go","lines":["@@ -9,6 +9,9 @@ import ("," \t\"github.com/redis/go-redis/v9/internal/pool\""," )"," ","+// ErrorTypeNil is the error type reported to OTelRecorder.RecordError for a Nil reply.","+const ErrorTypeNil = \"NIL\"","+"," // ConnInfo provides information about a Redis connection for metrics."," type ConnInfo interface {"," \tRemoteAddr() net.Addr"],"additions":3,"deletions":0,"truncated":false},{"path":"redis.go","lines":["@@ -1661,6 +1661,12 @@ func classifyCommandError(err error) (errorType, statusCode string, isInternal b"," \t\treturn \"\", \"\", false"," \t}"," ","+\t// A Nil reply is a successful command with no value. It gets its own type so","+\t// the recorder can tell it apart from a real failure.","+\tif errors.Is(err, Nil) {","+\t\treturn ErrorTypeNil, ErrorTypeNil, false","+\t}","+"," \terrStr := err.Error()"," "," \t// Check for timeout errors",""],"additions":6,"deletions":0,"truncated":false}],"additions":312,"deletions":2,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-09-25T13:32:26.156829+00:00"}