mmitService.cs","lines":["@@ -127,6 +127,7 @@ public PassOperation(string data)","         /// <returns><see langword=\"true\"/> when the remote commit succeeds.</returns>","         public async Task<bool> Commit(Guid transactionId, IRemoteCommitService service)","         {","+            ArgumentNullException.ThrowIfNull(service);","             return await service.Pass(transactionId, this.Data);","         }","     }","@@ -161,6 +162,7 @@ public FailOperation(string data)","         /// <returns><see langword=\"false\"/> to reject the remote commit.</returns>","         public async Task<bool> Commit(Guid transactionId, IRemoteCommitService service)","         {","+            ArgumentNullException.ThrowIfNull(service);","             return await service.Fail(transactionId, this.Data);","         }","     }","@@ -195,6 +197,7 @@ public ThrowOperation(string data)","         /// <returns>A task which always faults.</returns>","         public async Task<bool> Commit(Guid transactionId, IRemoteCommitService service)","         {","+            ArgumentNullException.ThrowIfNull(service);","             return await service.Throw(transactionId, this.Data);","         }","     }"],"additions":3,"deletions":0,"truncated":false},{"path":"src/Orleans.Transactions.TestKit.Base/Grains/TransactionAttributionGrain.cs","lines":["@@ -13,6 +13,7 @@ public class NoAttributionGrain : Grain, INoAttributionGrain","         /// <inheritdoc/>","         public Task<List<string?>?[]> GetNestedTransactionIds(int tier, List<ITransactionAttributionGrain>[] tiers)","         {","+            ArgumentNullException.ThrowIfNull(tiers);","             return AttributionGrain.GetNestedTransactionIds(tier, tiers);","         }","     }","@@ -25,6 +26,7 @@ public class SuppressAttributionGrain : Grain, ISuppressAttributionGrain","         /// <inheritdoc/>","         public Task<List<string?>?[]> GetNestedTransactionIds(int tier, List<ITransactionAttributionGrain>[] tiers)","         {","+   