{"id":"fc0b67b27332cee24001f90004817049867b3d5f","axis":"silent","repo":"JetBrains/Exposed","sha":"fc0b67b27332cee24001f90004817049867b3d5f","parsed":{"files":[{"path":"exposed-r2dbc-tests/build.gradle.kts","lines":["@@ -53,7 +53,7 @@ dependencies {","     testImplementation(project(\":exposed-jodatime\"))","     // --- end ----"," ","-    testRuntimeOnly(libs.r2dbc.pool)","+    testImplementation(libs.r2dbc.pool)","     testImplementation(libs.r2dbc.h2) {","         exclude(group = \"com.h2database\", module = \"h2\")","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"exposed-r2dbc-tests/src/test/kotlin/org/jetbrains/exposed/v1/r2dbc/sql/tests/h2/IdentifierManagerDeadlockTests.kt","lines":["@@ -0,0 +1,141 @@","+package org.jetbrains.exposed.v1.r2dbc.sql.tests.h2","+","+import io.r2dbc.pool.ConnectionPool","+import io.r2dbc.pool.ConnectionPoolConfiguration","+import io.r2dbc.spi.Connection","+import io.r2dbc.spi.ConnectionFactories","+import io.r2dbc.spi.ConnectionFactory","+import io.r2dbc.spi.ConnectionFactoryMetadata","+import kotlinx.coroutines.CompletableDeferred","+import kotlinx.coroutines.CoroutineScope","+import kotlinx.coroutines.asCoroutineDispatcher","+import kotlinx.coroutines.awaitAll","+import kotlinx.coroutines.delay","+import kotlinx.coroutines.flow.toList","+import kotlinx.coroutines.joinAll","+import kotlinx.coroutines.launch","+import kotlinx.coroutines.runBlocking","+import kotlinx.coroutines.withTimeoutOrNull","+import org.jetbrains.exposed.v1.core.Table","+import org.jetbrains.exposed.v1.core.vendors.H2Dialect","+import org.jetbrains.exposed.v1.core.vendors.PostgreSQLDialect","+import org.jetbrains.exposed.v1.r2dbc.R2dbcDatabase","+import org.jetbrains.exposed.v1.r2dbc.R2dbcDatabaseConfig","+import org.jetbrains.exposed.v1.r2dbc.SchemaUtils","+import org.jetbrains.exposed.v1.r2dbc.selectAll","+import org.jetbrains.exposed.v1.r2dbc.tests.LogDbInTestName","+import org.jetbrains.exposed.v1.r2dbc.tests.TestDB","+import org.jetbrains.exposed.v1.r2dbc.transactions.TransactionManager","+import org.jetbrains.exposed.v1.r2dbc.transactions.suspendTransaction","+import org.junit.jupiter.api.Assumptions","+import org.junit.jupiter.api.Test","+import org.reactivestreams.Publisher","+import java.util.concurrent.Executors","+import kotlin.test.assertEquals","+import kotlin.test.assertNotNull","+import kotlin.time.Duration.Companion.milliseconds","+import kotlin.time.Duration.Companion.seconds","+","+class IdentifierManagerDeadlockTests : LogDbInTestName() {","+    object Tester : Table(\"identifier_manager_deadlock\") {","+        val id = integer(\"id\")","+    }","+","+    /**","+     * A fresh database's identifier manager is resolved when its first query is rendered.","+     * Resolving it must not hold the lazy lock, or block the calling thread, while waiting for a pooled connection:","+     * transactions that already hold the pool's connections may themselves be waiting for that lock, or for that thread.","+     */","+    @Test","+    fun testFirstQueryDoesNotDeadlockWhenPoolIsExhausted() {","+        Assumptions.assumeTrue(TestDB.H2_V2 in TestDB.enabledDialects())","+","+        val poolSize = 2","+        val url = \"r2dbc:h2:mem:///identifierManagerDeadlock;DB_CLOSE_DELAY=-1\"","+","+        val setupDb = R2dbcDatabase.connect(url)","+        runBlocking { suspendTransaction(setupDb) { SchemaUtils.create(Tester) } }","+","+        val pool = ConnectionPool(","+            ConnectionPoolConfiguration.builder(ConnectionFactories.get(url))","+                .initialSize(0)","+                .maxSize(poolSize)","+                .build()","+        )","+        // a new instance, so its identifier manager is not yet resolved","+        val db = R2dbcDatabase.connect(pool, R2dbcDatabaseConfig.Builder().apply { explicitDialect = H2Dialect() })","+","+        // stands in for a server's event loop threads","+        val eventLoops = Executors.newFixedThreadPool(poolSize) { Thread(it, \"event-loop\").apply { isDaemon = true } }","+        val scope = CoroutineScope(eventLoops.asCoroutineDispatcher())","+","+        val holdersReady = List(poolSize) { CompletableDeferred<Unit>() }","+        val release = CompletableDeferred<Unit>()","+","+        // transactions that check out every pooled connection before their first DSL query","+        val holders = holdersReady.map { ready ->","+            scope.launch {","+                suspendTransaction(db) {","+                    exec(\"SELECT 1\")","+                    ready.complete(Unit)","+                    release.await()","+                    Tester.selectAll().toList()","+                }","+            }","+        }","+","+        try {","+            val finished = runBlocking {","+                withTimeoutOrNull(10.seconds) {","+                    holdersReady.awaitAll()","+","+                    // the first DSL query on the database, made while the pool is exhausted","+                    val firstQuery = scope.launch {","+                        suspendTransaction(db) { Tester.selectAll().toList() }","+                    }","+                    while (pool.metrics.get().pendingAcquireSize() == 0) {","+                        delay(10.milliseconds)","+                    }","+","+                    release.complete(Unit)","+                    (holders + firstQuery).joinAll()","+                }","+            }","+            assertNotNull(finished, \"Transactions deadlocked while resolving R2dbcDatabase.identifierManager\")","+","+            TransactionManager.closeAndUnregister(db)","+            pool.dispose()","+        } finally {","+            eventLoops.shutdownNow()","+            runBlocking { suspendTransaction(setupDb) { SchemaUtils.drop(Tester) } }","+            TransactionManager.closeAndUnregister(setupDb)","+        }","+    }","+","+    @Test","+    fun testIdentifierManagerOfResolvedVendorNeedsNoConnection() {","+        Assumptions.assumeTrue(TestDB.H2_V2 in TestDB.enabledDialects())","+","+        val connectionFactory = object : ConnectionFactory {","+            var connectCount = 0","+","+            override fun create(): Publisher<out Connection> {","+                connectCount++","+                error(\"No connection should be opened\")","+            }","+","+            override fun getMetadata(): ConnectionFactoryMetadata = throw NotImplementedError()","+        }","+        val db = R2dbcDatabase.connect(","+            connectionFactory,","+            R2dbcDatabaseConfig.Builder().apply { explicitDialect = PostgreSQLDialect() }","+        )","+","+        try {","+            assertEquals(\"\\\"\", db.identifierManager.quoteString)","+            assertEquals(0, connectionFactory.connectCount)","+        } finally {","+            TransactionManager.closeAndUnregister(db)","+        }","+    }","+}"],"additions":141,"deletions":0,"truncated":false},{"path":"exposed-r2dbc/src/main/kotlin/org/jetbrains/exposed/v1/r2dbc/R2dbcDatabase.kt","lines":["@@ -118,7 +118,10 @@ class R2dbcDatabase private constructor("," ","     override val supportsSelectForUpdate: Boolean by lazy { localMetadata { supportsSelectForUpdate } }"," ","-    override val identifierManager: IdentifierManagerApi by lazy { connectionMetadata { identifierManager } }","+    override val identifierManager: IdentifierManagerApi by lazy {","+        // resolved locally when possible, so the lazy lock is never held while waiting for a connection","+        if (resolvedVendor != null) localMetadata { identifierManager } else connectionMetadata { identifierManager }","+    }"," ","     companion object {"," "],"additions":4,"deletions":1,"truncated":false},{"path":"exposed-r2dbc/src/main/kotlin/org/jetbrains/exposed/v1/r2dbc/statements/api/R2dbcDatabaseMetadataImpl.kt","lines":["@@ -83,7 +83,7 @@ class R2dbcDatabaseMetadataImpl(","         // To use an identical url string, we would need to save/parse it to/from ConnectionFactoryOptions & pass to this class.","         // This is what is done for R2dbcDatabase.url, for example.","         // So far this is the only use for us storing ConnectionFactoryOptions details in this class, but perhaps if other cases arise?","-        identityManagerCache.getOrPut(database) { R2dbcIdentifierManager(metadataProvider, connectionData) }","+        identityManagerCache.getOrPut(database) { R2dbcIdentifierManager(metadataProvider, isOracle = connectionData.databaseProductName == \"Oracle\") }","     }"," ","     private var currentSchema: String? = null"],"additions":1,"deletions":1,"truncated":false},{"path":"exposed-r2dbc/src/main/kotlin/org/jetbrains/exposed/v1/r2dbc/statements/api/R2dbcIdentifierManager.kt","lines":["@@ -1,15 +1,16 @@"," package org.jetbrains.exposed.v1.r2dbc.statements.api"," ","-import io.r2dbc.spi.ConnectionMetadata"," import org.jetbrains.exposed.v1.core.statements.api.IdentifierManagerApi"," import org.jetbrains.exposed.v1.r2dbc.vendors.metadata.MetadataProvider"," "," /**","  * Class responsible for the parsing and processing of identifier tokens in SQL command syntax.","+ *","+ * All values are resolved from the hard-coded [metadata] of the vendor dialect, so no connection is required.","  */"," internal class R2dbcIdentifierManager(","     metadata: MetadataProvider,","-    connectionData: ConnectionMetadata","+    isOracle: Boolean"," ) : IdentifierManagerApi() {","     override val quoteString = metadata.propertyProvider.identifierQuoteString.trim()"," ","@@ -31,11 +32,7 @@ internal class R2dbcIdentifierManager("," ","     override val extraNameCharacters = metadata.propertyProvider.extraNameCharacters"," ","-    @Suppress(\"MagicNumber\")","-    override val oracleVersion = when {","-        connectionData.databaseProductName != \"Oracle\" -> OracleVersion.NonOracle","-        else -> OracleVersion.Oracle12plus","-    }","+    override val oracleVersion = if (isOracle) OracleVersion.Oracle12plus else OracleVersion.NonOracle"," ","     override val m