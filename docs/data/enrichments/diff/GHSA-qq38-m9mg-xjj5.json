{"id":"GHSA-qq38-m9mg-xjj5","axis":"advisories","repo":"sporkmonger/addressable","sha":"25c7c412a2f7e06c3cac92872e831f6d053703c5","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -1,6 +1,19 @@"," # Changelog"," "," ## Addressable 2.9.1 (unreleased) <a name=\"v2.9.1\">","+- fixes denial of service in `Addressable::URI.normalize_path`, which took","+  quadratic time on paths with many dot segments; `URI#normalize`, `#join`,","+  `#==` and `#===` were affected (GHSA-qq38-m9mg-xjj5)","+- fixes `Addressable::URI.normalize_path` keeping segments that a `..` should","+  have removed after a `..` above the root, e.g.","+  `/../../public/x/../../secret` normalized to `/public/x/secret` instead of","+  `/secret` (GHSA-8gmh-2hhj-2hv9)","+- fixes `Addressable::URI.normalize_path` treating a raw line feed as a","+  segment boundary, e.g. joining `..\\n/secret` onto `/public/` gave","+  `/\\n/secret`","+- deprecates `Addressable::URI::RULE_2A`, `RULE_2B_2C`, `RULE_2D` and","+  `RULE_PREFIXED_PARENT`, which are no longer used; they will be removed in","+  2.10.0"," - fixes `Addressable::URI#route_from` and `#route_to` raising","   `InvalidURIError` when the route's first segment contains a colon","   (e.g. `/a:b` from `/a`); the route is now `./a:b` ([#625])"],"additions":13,"deletions":0,"truncated":false},{"path":"lib/addressable/uri.rb","lines":["@@ -2436,10 +2436,14 @@ def init_with(coder)","     SELF_REF = '.'","     PARENT = '..'"," ","+    # Deprecated. No longer used by normalize_path; will be removed in 2.10.0.","     RULE_2A = /\\/\\.\\/|\\/\\.$/","     RULE_2B_2C = /\\/([^\\/]*)\\/\\.\\.\\/|\\/([^\\/]*)\\/\\.\\.$/","     RULE_2D = /^\\.\\.?\\/?/","     RULE_PREFIXED_PARENT = /^\\/\\.\\.?\\/|^(\\/\\.\\.?)+\\/?$/","+    if respond_to?(:deprecate_constant, true)","+      deprecate_constant :RULE_2A, :RULE_2B_2C, :RULE_2D, :RULE_PREFIXED_PARENT","+    end"," ","     ##","     # Resolves paths to their simplest form.","@@ -2448,37 +2452,52 @@ def init_with(coder)","     #","     # @return [String] The normalized path.","     def self.normalize_path(path)","-      # Section 5.2.4 of RFC 3986","+      # Section 5.2.4 of RFC 3986, as a single pass over the segments so that","+      # the running time is linear in the length of the path."," ","       return if path.nil?","-      normalized_path = path.dup","-      loop do","-        mod ||= normalized_path.gsub!(RULE_2A, SLASH)","-","-        pair = normalized_path.match(RULE_2B_2C)","-        if pair","-          parent  = pair[1]","-          current = pair[2]","+      segments = path.split(SLASH, -1)","+      return path.dup if segments.empty?","+","+      # The first segment is never removed by a parent reference. For an","+      # absolute path it is the empty segment before the leading slash.","+      output = [segments.first]","+      last = segments.size - 1","+      (1..last).each do |index|","+        segment = segments[index]","+        if segment == SELF_REF","+          output << EMPTY_STR if index == last","+        elsif segment == PARENT","+          if output.size > 1","+            output.pop","+            output << EMPTY_STR if index == last","+          else","+            output << PARENT","+          end","         else","-          parent  = nil","-          current = nil","+          output << segment","         end","-","-        regexp = \"/#{Regexp.escape(parent.to_s)}/\\\\.\\\\./|\"","-        regexp += \"(/#{Regexp.escape(current.to_s)}/\\\\.\\\\.$)\"","-","-        if pair && ((parent != SELF_REF && parent != PARENT) ||","-            (current != SELF_REF && current != PARENT))","-          mod ||= normalized_path.gsub!(Regexp.new(regexp), SLASH)","+      end","+      normalized_path = output.join(SLASH)","+","+      # Non-standard, removes prefixed dotted segments from path. At this","+      # point an absolute path can only start with a single \"/..\", and a","+      # relative path keeps its leading dots.","+      start = 0","+      if normalized_path.start_with?(SLASH)","+        if normalized_path == \"/#{PARENT}\"","+          return normalized_path[0, 1]","+        elsif normalized_path.start_with?(\"/#{PARENT}/\")","+          start = PARENT.size + 1","+        end","+      else","+        while normalized_path[start] == SELF_REF","+          start += 1","+          start += 1 if normalized_path[start] == SELF_REF","+          start += 1 if normalized_path[start] == SLASH","         end","-","-        mod ||= normalized_path.gsub!(RULE_2D, EMPTY_STR)","-        # Non-standard, removes prefixed dotted segments from path.","-        mod ||= normalized_path.gsub!(RULE_PREFIXED_PARENT, SLASH)","-        break if mod.nil?","       end","-","-      normalized_path","+      start.zero? ? normalized_path : normalized_path[start..-1]","     end"," ","     ##"],"additions":44,"deletions":25,"truncated":false},{"path":"spec/addressable/normalize_path_spec.rb","lines":["@@ -0,0 +1,363 @@","+# frozen_string_literal: true","+","+# Copyright (C) Bob Aman","+#","+#    Licensed under the Apache License, Version 2.0 (the \"License\");","+#    you may not use this file except in compliance with the License.","+#    You may obtain a copy of the License at","+#","+#        http://www.apache.org/licenses/LICENSE-2.0","+#","+#    Unless required by applicable law or agreed to in writing, software","+#    distributed under the License is distributed on an \"AS IS\" BASIS,","+#    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+#    See the License for the specific language governing permissions and","+#    limitations under the License.","+","+","+require \"spec_helper\"","+","+require \"timeout\"","+require \"addressable/uri\"","+","+module NormalizePathSpec","+  # Addressable 2.9.0's URI.normalize_path, kept verbatim as a compatibility","+  # oracle. It runs in quadratic time, so only give it short inputs.","+  module Legacy","+    SLASH = '/'","+    EMPTY_STR = ''","+    SELF_REF = '.'","+    PARENT = '..'","+","+    RULE_2A = /\\/\\.\\/|\\/\\.$/","+    RULE_2B_2C = /\\/([^\\/]*)\\/\\.\\.\\/|\\/([^\\/]*)\\/\\.\\.$/","+    RULE_2D = /^\\.\\.?\\/?/","+    RULE_PREFIXED_PARENT = /^\\/\\.\\.?\\/|^(\\/\\.\\.?)+\\/?$/","+","+    def self.normalize_path(path)","+      return if path.nil?","+      normalized_path = path.dup","+      loop do","+        mod ||= normalized_path.gsub!(RULE_2A, SLASH)","+","+        pair = normalized_path.match(RULE_2B_2C)","+        if pair","+          parent  = pair[1]","+          current = pair[2]","+        else","+          parent  = nil","+          current = nil","+        end","+","+        regexp = \"/#{Regexp.escape(parent.to_s)}/\\\\.\\\\./|\"","+        regexp += \"(/#{Regexp.escape(current.to_s)}/\\\\.\\\\.$)\"","+","+        if pair && ((parent != SELF_REF && parent != PARENT) ||","+            (current != SELF_REF && current != PARENT))","+          mod ||= normalized_path.gsub!(Regexp.new(regexp), SLASH)","+        end","+","+        mod ||= normalized_path.gsub!(RULE_2D, EMPTY_STR)","+        mod ||= normalized_path.gsub!(RULE_PREFIXED_PARENT, SLASH)","+        break if mod.nil?","+      end","+","+      normalized_path","+    end","+  end","+","+  # remove_dot_segments transcribed directly from the input/output buffer","+  # description in Section 5.2.4 of RFC 3986.","+  module RFC3986","+    def self.remove_dot_segments(input)","+      input = input.dup","+      output = +\"\"","+      until input.empty?","+        if input.start_with?(\"../\")","+          input = input[3..-1]","+        elsif input.start_with?(\"./\")","+          input = input[2..-1]","+        elsif input.start_with?(\"/./\")","+          input = input[2..-1]","+        elsif input == \"/.\"","+          input = \"/\"","+        elsif input.start_with?(\"/../\") || input == \"/..\"","+          input = input == \"/..\" ? \"/\" : input[3..-1]","+          output = output.sub(/\\/?[^\\/]*\\z/, \"\")","+        elsif input == \".\" || input == \"..\"","+          input = \"\"","+        else","+          segment = input[/\\A\\/?[^\\/]*/]","+          output << segment","+          input = input[segment.size..-1]","+        end","+      end","+      output","+    end","+  end","+","+  # Every string of up to max_length characters drawn from alphabet.","+  def self.strings(alphabet, max_length)","+    (0..max_length).flat_map do |length|","+      alphabet.repeated_permutation(length).map(&:join)","+    end","+  end","+","+  # Random paths built from segments that exercise every dot-segment rule.","+  def self.random_paths(count, seed)","+    random = Random.new(seed)","+    segments = [\"a\", \"b\", \"..\", \".\", \"\", \".x\", \"..y\", \"...\"]","+    Array.new(count) do","+      path = Array.new(random.rand(1..14)) do","+        segments[random.rand(segments.size)]","+      end.join(\"/\")","+      random.rand < 0.6 ? \"/\" + path : path","+    end","+  end","+end","+","+describe Addressable::URI, \".normalize_path\" do","+  it \"returns nil for nil\" do","+    expect(Addressable::URI.normalize_path(nil)).to be_nil","+  end","+","+  context \"compared with 2.9.0\" do","+    # Several of these are not RFC 3986 behavior but are kept for","+    # compatibility.","+    {","+      \"\" => \"\",","+      \"/\" => \"/\",","+      \"//\" => \"//\",","+      \"/.\" => \"/\",","+      \"/./\" => \"/\",","+      \"/..\" => \"/\",","+      \"/../\" => \"/\",","+      \"/../..\" => \"/\",","+      \"/a/..\" => \"/\",","+      \"/a/../../b\" => \"/b\",","+      \"/a/./../b\" => \"/b\",","+      \"/a//../b\" => \"/a/b\",","+      \"/a/b/c/./../../g\" => \"/a/g\",","+      \".\" => \"\",","+      \"..\" => \"\",","+      \"./\" => \"\",","+      \"../\" => \"\",","+      \"./.\" => \"\",","+      \"./a\" => \"a\",","+      \"../a\" => \"a\",","+      \"a/.\" => \"a/\",","+      \"a/./b\" => \"a/b\",","+      # The first segment of a relative path is never removed by \"..\".","+      \"a/..\" => \"a/..\",","+      \"a/../b\" => \"a/../b\",","+      \"a//../..\" => \"a/..\",","+      # Inherited from the 2.9.0 rules, which strip leading dots without","+      # checking for a segment boundary.","+      \"a/../../b\" => \"a/b\",","+      \".htaccess\" => \"htaccess\",","+      \"..x/y\" => \"x/y\",","+      \"...\" => \"\",","+      \".../\" => \"\",","+      \"..//x\" => \"/x\",","+      \".//x\" => \"/x\",","+      \".//..\" => \"\",","+      \"./..//x\" => \"/x\",","+      \"mid/content=5/../6\" => \"mid/6\",","+      \"/%2E%2E/a\" => \"/%2E%2E/a\",","+      \"\\r/../a\" => \"\\r/../a\"","+    }.each do |input, expected|","+      it \"normalizes #{input.inspect} to #{expected.inspect}\" do","+        expect(Addressable::URI.normalize_path(input)).to eq(expected)","+        expect(NormalizePathSpec::Legacy.normalize_path(input)).to eq(expected)","+      end","+    end","+","+    it \"agrees on every path of up to 10 characters from '/', '.' and 'a'\" do","+      NormalizePathSpec.strings([\"/\", \".\", \"a\"], 10).each do |path|","+        expect(Addressable::URI.normalize_path(path)).to eq(","+          NormalizePathSpec::Legacy.normalize_path(path)","+        ), \"for #{path.inspect}\"","+      end","+    end","+","+    it \"agrees on every path of up to 7 characters from '/', '.', 'a' and 'b'\" do","+      NormalizePathSpec.strings([\"/\", \".\", \"a\", \"b\"], 7).each do |path|","+        expect(Addressable::URI.normalize_path(path)).to eq(","+          NormalizePathSpec::Legacy.normalize_path(path)","+        ), \"for #{path.inspect}\"","+      end","+    end","+  end","+","+  context \"with absolute paths\" do","+    it \"matches RFC 3986 remove_dot_segments on random paths\" do","+      NormalizePathSpec.random_paths(20_000, 3986).each do |path|","+        next unless path.start_with?(\"/\")","+        expect(Addressable::URI.normalize_path(path)).to eq(","+          NormalizePathSpec::RFC3986.remove_dot_segments(path)","+        ), \"for #{path.inspect}\"","+      end","+    end","+","+    # 2.9.0 removed every textual copy of the first \"/X/../\" pair it found,","+    # so a later \"/../../\" was collapsed on its own instead of each \"..\"","+    # removing the segment before it.","+    {","+      \"/../../c/d/../../\" => \"/\",","+      \"/../../a/../../.\" => \"/\",","+      \"/../../a/../..//a\" => \"//a\",","+      \"/../../..y/.././../b\" => \"/b\",","+      \"/../.././/../../a/..\" => \"/\"","+    }.each do |input, expected|","+      it \"normalizes #{input.inspect} to #{expected.inspect}\" do","+        expect(Addressable::URI.normalize_path(input)).to eq(expected)","+        expect(NormalizePathSpec::RFC3986.remove_dot_segments(input)).to eq(","+          expected","+        )","+      end","+    end","+","+    it \"does not keep segments that a parent reference removed\" do","+      # 2.9.0 gave \"/public/x/secret\", which passes a \"/public/\" prefix check","+      # for a path that resolves outside of it.","+      path = \"/../../public/x/../../secret\"","+      expect(Addressable::URI.normalize_path(path)).to eq(\"/secret\")","+      uri = Addressable::URI.parse(\"http://example.com\" + path)","+      expect(uri.normalize.path).to eq(\"/secret\")","+      base = Addressable::URI.parse(\"http://example.com/a\")","+      expect(base.join(path).path).to eq(\"/secret\")","+    end","+  end","+","+  context \"with relative paths\" do","+    it \"matches the RFC 3986 result for dot segments after the first one\" do","+      expect(Addressable::URI.normalize_path(\"../../../a/.././../\")).to eq(\"\")","+      expect(Addressable::URI.normalize_path(\"b/../..//../../.x\")).to eq(","+        \"b/../.x\"","+      )","+    end","+  end","+","+  context \"with line breaks in the path\" do","+    # 2.9.0 used ^ and $, which also match around a line break, so a raw","+    # newline acted like a segment boundary.","+    it \"treats a line feed as an ordinary character\" do","+      expect(Addressable::URI.normalize_path(\"/a/..\\nb\")).to eq(\"/a/..\\nb\")","+      expect(Addressable::URI.normalize_path(\"/x/..\\n/y/..\")).to eq(\"/x/..\\n/\")","+      expect(Addressable::URI.normalize_path(\"a\\n../b\")).to eq(\"a\\n../b\")","+      expect(Addressable::URI.normalize_path(\"\\n.a\")).to eq(\"\\n.a\")","+    end","+","+    it \"gives the same path from join as from normalize\" do","+      uri = Addressable::URI.parse(\"http://example.com/\")","+      uri.path = \"/a/..\\n/b\"","+      joined = Addressable::URI.parse(\"http://example.com/\").join(uri.path)","+      expect(joined.path).to eq(\"/a/..\\n/b\")","+      expect(uri.normalize.path).to eq(\"/a/..%0A/b\")","+    end","+","+    it \"does not treat a segment ending in a line feed as a parent reference\" do","+      # 2.9.0 joined this to \"/\\n/secret\", leaving the base directory.","+      base = Addressable::URI.parse(\"http://example.com/public/\")","+      expect(base.join(\"..\\n/secret\").path).to eq(\"/public/..\\n/secret\")","+    end","+","+    it \"does not remove characters from the middle of a segment\" do","+      # 2.9.0 gave \"/public/a\\nb\".","+      expect(Addressable::URI.normalize_path(\"/public/a\\n../b\")).to eq(","+        \"/public/a\\n../b\"","+      )","+    end","+  end","+","+  context \"return value\" do","+    it \"is a new, unfrozen string\" do","+      [\"\", \"/a/b\", \"/a/../b\", \"a\", \"../a\"].each do |path|","+        input = path.dup.freeze","+        result = Addressable::URI.normalize_path(input)","+        expect(result).not_to equal(input)","+        expect(result).not_to be_frozen","+      end","+    end","+","+    it \"keeps the encoding of the input\" do","+      [\"UTF-8\", \"US-ASCII\", \"ASCII-8BIT\"].each do |encoding|","+        [\"\", \"/\", \"/..\", \"/../a\", \"/a/../b\", \"../a\", \"a\"].each do |path|","+          path = path.dup.force_encoding(encoding)","+          result = Addressable::URI.normalize_path(path)","+          expect(result.encoding).to eq(","+            NormalizePathSpec::Legacy.normalize_path(path).encoding","+          ), \"for #{path.inspect} in #{encoding}\"","+          expect(result.encoding.to_s).to eq(encoding)","+        end","+      end","+      expect(Addressable::URI.normalize_path(\"/é/../ü\")).to eq(\"/ü\")","+      expect(Addressable::URI.normalize_path(\"/\\xFF/../b\".b)).to eq(\"/b\".b)","+    end","+","+    it \"raises ArgumentError for invalid UTF-8, as 2.9.0 did\" do","+      path = \"/\\xFF/../b\".dup.force_encoding(\"UTF-8\")","+      expect { NormalizePathSpec::Legacy.normalize_path(path) }.to raise_error(","+        ArgumentError","+      )","+      expect { Addressable::URI.normalize_path(path) }.to raise_error(","+        ArgumentError","+      )","+    end","+  end","+","+  context \"with adversarial input\" do","+    # On 2.9.0 each of these takes minutes, since every pass over the path","+    # removed at most one dot segment.","+    {","+      \"nested parent references\" => \"/\" + (\"a/\" * 20_000) + (\"../\" * 20_000),","+      \"nested distinct segments\" =>","+        \"/\" + (1..20_000).map { |i| \"s#{i}/\" }.join + (\"../\" * 20_000),","+      \"a chain of distinct segments\" =>","+        (1..20_000).map { |i| \"/s#{i}/..\" }.join,","+      \"nested segments in a relative path\" =>","+        \"x/\" + (\"a/\" * 20_000) + (\"../\" * 20_000),","+      \"leading dots in a relative path\" => (\".\" * 200_000) + \"x\",","+      \"leading parent references\" => \"/\" + (\"../\" * 200_000) + \"a\",","+      \"self references\" => \"/\" + (\"./\" * 200_000) + \"a\"","+    }.each do |name, path|","+      it \"normalizes #{name} in linear time\" do","+        expect do","+          Timeout.timeout(10) { Addressable::URI.normalize_path(path) }","+        end.not_to raise_error","+      end","+    end","+","+    let(:nested) { \"a/\" * 20_000 + \"../\" * 20_000 }","+","+    it \"normalizes a URI with nested dot segments in linear time\" do","+      uri = Addressable::URI.parse(\"http://example.com/\" + nested)","+      expect do","+        Timeout.timeout(10) { expect(uri.normalize.path).to eq(\"/\") }","+      end.not_to raise_error","+    end","+","+    it \"joins a reference with nested dot segments in linear time\" do","+      base = Addressable::URI.parse(\"http://example.com/b/c\")","+      expect do","+        Timeout.timeout(10) do","+          expect(base.join(nested + \"d\").path).to eq(\"/b/d\")","+          expect(base.join(\"/\" + nested + \"d\").path).to eq(\"/d\")","+          expect(base.join(\"http://example.org/\" + nested).path).to eq(\"/\")","+        end","+      end.not_to raise_error","+    end","+","+    it \"compares URIs with nested dot segments in linear time\" do","+      uri = Addressable::URI.parse(\"http://example.com/\" + nested + \"x\")","+      expect do","+        Timeout.timeout(10) do","+          expect(uri == Addressable::URI.parse(\"http://example.com/x\")).to be(","+            true","+          )","+          expect(uri === \"http://example.com/x\").to be(true)","+        end","+      end.not_to raise_error","+    end","+  end","+end",""],"additions":363,"deletions":0,"truncated":false}],"additions":420,"deletions":25,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-13T17:02:34.414293+00:00"}