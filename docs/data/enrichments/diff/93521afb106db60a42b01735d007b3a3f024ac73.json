inConfig(Path configPath) {","-        return Optional.ofNullable(getPluginConfig(configPath)).orElseGet(() -> PluginHelper.createPluginConfig(configPath));","+        JsonObject existing = getPluginConfig(configPath);","+        if (existing != null) {","+            return existing;","+        }","+        return createPluginConfig(configPath);","     }"," ","     public static JsonObject getPluginConfig() {","@@ -795,7 +829,12 @@ public static JsonObject getPluginConfig(Path configPath) {","                 return (JsonObject) Jsoner.deserialize(text);","             }","         } catch (Exception e) {","-            // ignore","+            // The file exists but cannot be read (AccessDeniedException, MalformedInputException)","+            // or the JSON is corrupt — either way throw so the caller does not silently overwrite it.","+            throw new RuntimeCamelException(","+                    \"Plugin configuration file exists but is corrupt or unreadable: \"","+                                            + getCustomPluginConfigPath(configPath) + \" (\" + e.getMessage() + \")\",","+                    e);","         }"," ","         return null;","@@ -813,10 +852,7 @@ public static JsonObject createPluginConfig(Path configPath) {","             if (parent != null) {","                 Files.createDirectories(parent);","             }","-            Files.writeString(f, config.toJson(),","-                    StandardOpenOption.CREATE,","-                    StandardOpenOption.WRITE,","-                    StandardOpenOption.TRUNCATE_EXISTING);","+            atomicWriteJson(f, config.toJson());","         } catch (IOException e) {","             throw new RuntimeCamelException(\"Failed to create plugin configuration\", e);","         }","@@ -824,6 +860,49 @@ public static JsonObject createPluginConfig(Path configPath) {","         return config;","     }"," ","+    /**","+     * Writes {@code content} to {@code target} atomically: writes to a sibling temp file first, then moves it into","+     * place with {@link StandardCopyOption#REPLACE_EXISTING}. When atomic move is not supported by the underlying","+     * filesystem, falls back to a plain overwriting move (rename(2)), which is still safe — a reader never observes a","+     * half-written file.","+     */","+    private static void atomicWriteJson(Path target, String content) throws IOException {","+        // Resolve symlinks so the move replaces the target file, not the symlink itself.","+        Path realTarget;","+        try {","+            realTarget = target.toRealPath();","+        } catch (IOException e) {","+            // file does not exist yet — no symlink to resolve","+            realTarget = target;","+        }","+        Path dir = realTarget.getParent();","+        if (dir != null) {","+            Files.createDirectories(dir);","+        }","+        Path tmp = dir != null","+                ? Files.createTempFile(dir, \".\" + realTarget.getFileName(), \".tmp\")","+                : Files.createTempFile(\".\" + realTarget.getFileName(), \".tmp\");","+        try {","+            Files.writeString(tmp, content, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING);","+            try {","+                Files.move(tmp, realTarget, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);","+                tmp = null; // moved successfully, nothing to delete","+            } catch (AtomicMoveNotSupportedException e) {","+                // fall back: non-atomic replace — still better than truncate-then-write","+                Files.move(tmp, realTarget, StandardCopyOption.REPLACE_EXISTING);","+                tmp = null;","+            }","+        } finally {","+            if (tmp != null) {","+                try {","+                    Files.deleteIfExists(tmp);","+                } catch (IOException ignored) {","+                    // best effort","+                }","+            }","+        }","+    }","+","     public static void savePluginConfig(JsonObject plugins) {","         savePluginConfig(plugins, null);","     }","@@ -831,15 +910,23 @@ public static void savePluginConfig(JsonObject plugins) {","     public static void savePluginConfig(JsonObject plugins, Path configPath) {","         Path f = getCustomPluginConfigPath(configPath);","         try {","-            Files.writeString(f, plugins.toJson(),","-                    StandardOpenOption.CREATE,","-                    StandardOpenOption.WRITE,","-                    StandardOpenOption.TRUNCATE_EXISTING);","+            atomicWriteJson(f, plugins.toJson());","         } catch (IOException e) {","             throw new RuntimeCamelException(\"Failed to save plugin configuration\", e);","         }","     }"," ","+    /**","+     * Warns about a corrupt or unreadable plugin configuration file, once per path per JVM run, so multiple callers","+     * (e.g. {@code getActivePlugins} and {@code printAvailablePlugins}) do not repeat the message.","+     */","+    public static void warnCorruptPluginConfig(Printer printer, Exception e) {","+        String key = e.getMessage() != null ? e.getMessage() : \"unknown-corrupt-plugin-config\";","+        if (WARNED_PLUGIN_PATHS.add(key)) {","+            printer.printErr(\"Warning: \" + e.getMessage() + \". Fix the JSON by hand or delete the file.\");","+        }","+    }","+","     /**","      * Loads the list of known 3rd party plugins from the classpath resource known-plugins.json.","      */"],"additions":107,"deletions":20,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/test/java/org/apache/camel/dsl/jbang/core/commands/UserConfigDefaultsTest.java","lines":["@@ -78,6 +78,91 @@ void localConfigurationTakesPrecedence() throws Exception {","         assertThat(run(\"echo\")).isEqualTo(\"sort=age repos=null\");","     }"," ","+    @Test","+    void malformedUserConfigDoesNotCrashCli() throws Exception {","+        // A Windows-style path stored without escaping produces a malformed \\\\uXXXX sequence,","+        // which throws IllegalArgumentException from Properties.load — not IOException.","+        // The CLI must warn and continue instead of propagating the exception.","+        UserConfigHelper.createUserConfig(\"path=C:\\\\users\\\\name\");","+","+        // The command must succeed (not throw); the option falls back to its own default.","+        assertThat(runCapturingWarning(\"echo\")).isEqualTo(\"sort=pid repos=null\");","+    }","+","+    @Test","+    void malformedConfigLoadPropertiesReturnsFalseAndWarns() throws Exception {","+        // loadProperties must not throw and must return false for a malformed config file","+        UserConfigHelper.createUserConfig(\"path=C:\\\\users\\\\name\");","+","+        StringPrinter out = new StringPrinter();","+        boolean[] consumerCalled = { false };","+        boolean loaded = CommandLineHelper.loadProperties(props -> {","+            // should NOT be called since the 3-arg overload does not call consumer on failure","+            consumerCalled[0] = true;","+        }, false, out);","+","+        assertThat(loaded).as(\"loadProperties should return false for a malformed file\").isFalse();","+        assertThat(consumerCalled[0]).as(\"consumer must not be called on failure\").isFalse();","+        assertThat(out.getStderr()).contains(\"could not parse\");","+        assertThat(out.getStderr()).contains(\"escaping\");","+    }","+","+    @Test","+    void malformedConfigLoadPropertiesTwoArgCallsConsumerWithEmpty() throws Exception {","+        // The 2-arg overload (used by read-only callers) calls consumer with empty props","+        UserConfigHelper.createUserConfig(\"path=C:\\\\users\\\\name\");","+","+        boolean[] consumerCalled = { false };","+        CommandLineHelper.loadProperties(props -> {","+            consumerCalled[0] = true;","+            assertThat(props).isEmpty();","+        }, false);","+","+        assertThat(consumerCalled[0]).as(\"2-arg overload should call consumer with empty props\").isTrue();","+    }","+","+    @Test","+    void malformedConfigWarningIsOnlyPrintedOnce() throws Exception {","+        // When a command calls loadProperties multiple times for the same malformed file","+        // (e.g. resolveRepos, augmentWithUserConfiguration, printConfigurationValues all do so for camel run),","+        // the warning must only appear once to avoid flooding the terminal.","+        UserConfigHelper.createUserConfig(\"path=C:\\\\users\\\\name\");","+","+        StringPrinter out = new StringPrinter();","+        // Simulate multiple calls that would each trigger the warning for the same file","+        CommandLineHelper.loadProperties(props -> {","+        }, false, out);","+        CommandLineHelper.loadProperties(props -> {","+        }, false, out);","+        CommandLineHelper.loadProperties(props -> {","+        }, false, out);","+","+        long warningCount = out.getStderr().lines()","+                .filter(l -> l.contains(\"could not parse\"))","+                .count();","+        assertThat(warningCount).as(\"warning must appear exactly once, not once per loadProperties call\").isOne();","+    }","+","+    private static String runCapturingWarning(String... args) {","+        StringPrinter out = new StringPrinter();","+        CamelJBangMain main = new CamelJBangMain().withPrinter(out);","+        CommandTree commandLine = new CommandTree(main)","+                .addSubcommand(\"echo\", new CommandTree(new EchoCommand(main)))","+                .addSubcommand(\"other\", new CommandTree(new EchoCommand(main)))","+                .addSubcommand(\"dev\", new CommandTree(new DevCommand(main)))","+                .addSubcommand(\"plugin\", new CommandTree(new PluginCommand(main))","+                        .addSubcommand(\"echo\", new CommandTree(new EchoCommand(main))));","+        // augmentWithUserConfiguration must NOT throw for a malformed config","+        CommandLineHelper.augmentWithUserConfiguration(commandLine, out);","+","+        try {","+            assertThat(commandLine.execute(args).getResultValue()).isZero();","+        } catch (Exception e) {","+            throw new IllegalStateException(e);","+        }","+        return out.getStdout();","+    }","+","     @Test","     void pluginCommandsDoNotUseTheConfiguration() throws Exception {","         UserConfigHelper.createUserConfig(\"sort=name\");"],"additions":85,"deletions":0,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/test/java/org/apache/camel/dsl/jbang/core/commands/version/VersionSetTest.java","lines":["@@ -22,6 +22,7 @@"," import org.apache.camel.dsl.jbang.core.commands.CamelJBangMain;"," import org.apache.camel.dsl.jbang.core.commands.UserConfigHelper;"," import org.apache.camel.dsl.jbang.core.commands.config.BaseConfigTestSupport;","+import org.apache.camel.dsl.jbang.core.common.CliExitCode;"],"additions":1,"deletions":0,"truncated":false}],"additions":289,"deletions":46,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-14T15:13:54.430191+00:00"}