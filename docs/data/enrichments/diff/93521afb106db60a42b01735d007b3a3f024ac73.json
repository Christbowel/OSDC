rning has already been printed this JVM run, to avoid repeating it. */","+    private static final Set<String> WARNED_PATHS = ConcurrentHashMap.newKeySet();","+","     public static final String USER_CONFIG = \".camel-cli.properties\";","     public static final String LOCAL_USER_CONFIG = \"camel-cli.properties\";","     public static final String LEGACY_USER_CONFIG = \".camel-jbang-user.properties\";","@@ -127,12 +132,25 @@ public static boolean hasLocalUserConfig() {","     }"," ","     public static void augmentWithUserConfiguration(CommandTree commandLine) {","+        augmentWithUserConfiguration(commandLine, new Printer.SystemOutPrinter());","+    }","+","+    public static void augmentWithUserConfiguration(CommandTree commandLine, Printer printer) {","         Path file = getUserConfigurationFile();","         if (Files.isRegularFile(file) && Files.exists(file)) {","             Properties properties = new Properties();","             try (Reader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {","                 properties.load(reader);","-            } catch (IOException e) {","+            } catch (Exception e) {","+                // best-effort: a malformed config file (e.g. malformed unicode escape) must never break the CLI;","+                // warn the user so they know to fix it, but let the command continue without defaults.","+                // Warn once per path: loadProperties may also warn for the same file, so we deduplicate here.","+                String key = file.toAbsolutePath().toString();","+                if (WARNED_PATHS.add(key)) {","+                    printer.printErr(","+                            \"Warning: could not parse '\" + file.toAbsolutePath() + \"' (\" + e.getMessage()","+                                     + \"). Edit the file by hand, escaping '\\\\' as '\\\\\\\\' or using '/'.\");","+                }","                 return;","             }"," ","@@ -162,16 +180,43 @@ public static void loadProperties(Consumer<Properties> consumer) {","     }"," ","     public static void loadProperties(Consumer<Properties> consumer, boolean local) {","+        boolean ok = loadProperties(consumer, local, new Printer.SystemOutPrinter());","+        if (!ok) {","+            // Read-only callers get empty props so the command continues with defaults.","+            // Write callers (config set/unset) use the 3-arg overload and check the return value.","+            consumer.accept(new OrderedProperties());","+        }","+    }","+","+    /**","+     * Loads user properties from the configuration file. When the file exists but is malformed (e.g. a Windows-style","+     * path stored without escaping produces a malformed \\\\uXXXX sequence), the method warns via the given printer and","+     * returns {@code false} <b>without</b> calling the consumer. This lets callers that write back to the file (config","+     * set, config unset) detect the failure and refuse to overwrite a malformed file.","+     *","+     * @return {@code true} if the file was loaded successfully (or did not exist), {@code false} if the file exists but","+     *         could not be parsed.","+     */","+    public static boolean loadProperties(Consumer<Properties> consumer, boolean local, Printer printer) {","         Path file = getUserPropertyFile(local);","         if (Files.isRegularFile(file) && Files.exists(file)) {","+            Properties prop = new OrderedProperties();","             try (InputStream is = Files.newInputStream(file)) {","-                Properties prop = new OrderedProperties();","                 prop.load(is);","-                consumer.accept(prop);","             } catch (Exception e) {","-                throw new RuntimeException(\"Cannot load user configuration: \" + file);","+                // Warn once per path per JVM run: camel run calls loadProperties from multiple code paths","+                // (resolveRepos, augmentWithUserConfiguration, printConfigurationValues) and each would","+                // print the same message. Using the absolute path as the key deduplicates the warning.","+                String key = file.toAbsolutePath().toString();","+                if (WARNED_PATHS.add(key)) {","+                    printer.printErr(\"Warning: could not parse '\" + file.toAbsolutePath() + \"' (\" + e.getMessage()","+                                     + \"). Edit the file by hand, escaping '\\\\' as '\\\\\\\\' or using '/'.\");","+                }","+                return false;","             }","+            consumer.accept(prop);","         }","+        return true;","     }"," ","     public static void storeProperties(Properties properties, Printer printer, boolean local) {"],"additions":49,"deletions":4,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/main/java/org/apache/camel/dsl/jbang/core/common/PluginHelper.java","lines":["@@ -23,9 +23,11 @@"," import java.net.URL;"," import java.net.URLClassLoader;"," import java.nio.charset.StandardCharsets;","+import java.nio.file.AtomicMoveNotSupportedException;"," import java.nio.file.Files;"," import java.nio.file.InvalidPathException;"," import java.nio.file.Path;","+import java.nio.file.StandardCopyOption;"," import java.nio.file.StandardOpenOption;"," import java.util.ArrayList;"," import java.util.Arrays;","@@ -84,6 +86,9 @@ public final class PluginHelper {","     // the plugins warned about by compatibilityCheck, to warn once","     private static final Set<String> COMPATIBILITY_WARNED = ConcurrentHashMap.newKeySet();"," ","+    /** Plugin config paths whose corrupt-file warning has already been printed this JVM run. */","+    private static final Set<String> WARNED_PLUGIN_PATHS = ConcurrentHashMap.newKeySet();","+","     private static final FactoryFinder FACTORY_FINDER","             = new DefaultFactoryFinder(new DefaultClassResolver(), FactoryFinder.DEFAULT_PATH + \"camel-jbang-plugin/\");"," ","@@ -156,6 +161,11 @@ public static boolean