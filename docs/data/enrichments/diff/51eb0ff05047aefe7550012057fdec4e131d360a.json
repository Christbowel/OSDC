egistry   # same app with Emotion registry","+```","+","+Then open http://localhost:3010/ (one-pass) and http://localhost:3010/stream","+(Suspense).","+","+Use a cold server for `/stream`. Emotion’s module cache hides the mismatch after","+the first request."],"additions":14,"deletions":0,"truncated":false},{"path":"sandbox/next-app-streaming/app/layout.tsx","lines":["@@ -0,0 +1,13 @@","+import { Provider } from \"@/components/ui/provider\"","+","+export default function RootLayout(props: { children: React.ReactNode }) {","+  return (","+    <html suppressHydrationWarning>","+      <body>","+        <Provider withRegistry={process.env.USE_EMOTION_REGISTRY === \"1\"}>","+          {props.children}","+        </Provider>","+      </body>","+    </html>","+  )","+}"],"additions":13,"deletions":0,"truncated":false},{"path":"sandbox/next-app-streaming/app/page.tsx","lines":["@@ -0,0 +1,19 @@","+import { Container, Heading, Link, Text } from \"@chakra-ui/react\"","+import NextLink from \"next/link\"","+","+export default function Home() {","+  return (","+    <Container py=\"10\" maxW=\"lg\">","+      <Heading size=\"lg\" mb=\"2\">","+        Acme Store","+      </Heading>","+      <Text color=\"fg.muted\" mb=\"6\">","+        One-pass catalog page. Product details stream reviews in after the","+        shell.","+      </Text>","+      <Link asChild>","+        <NextLink href=\"/stream\">Wireless Headphones — $129</NextLink>","+      </Link>","+    </Container>","+  )","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"sandbox/next-app-streaming/app/stream/page.tsx","lines":["@@ -0,0 +1,95 @@","+import {","+  Avatar,","+  Badge,","+  Container,","+  HStack,","+  Heading,","+  RatingGroup,","+  Separator,","+  Text,","+  VStack,","+} from \"@chakra-ui/react\"","+import { connection } from \"next/server\"","+import { Suspense } from \"react\"","+","+const reviews = [","+  {","+    name: \"Maya Chen\","],"additions":17,"deletions":0,"truncated":false}],"additions":705,"deletions":68,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-08-23T08:42:56.663576+00:00"}