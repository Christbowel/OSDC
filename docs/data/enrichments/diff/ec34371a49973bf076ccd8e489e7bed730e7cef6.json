{"id":"ec34371a49973bf076ccd8e489e7bed730e7cef6","axis":"silent","repo":"swc-project/swc","sha":"ec34371a49973bf076ccd8e489e7bed730e7cef6","parsed":{"files":[{"path":".changeset/fixer-invalid-assignment-targets.md","lines":["@@ -0,0 +1,6 @@","+---","+swc_core: patch","+swc_ecma_transforms_base: patch","+---","+","+fix(es/fixer): Avoid panicking on parser-recovered parenthesized assignment targets whose inner expressions cannot be converted to `AssignTarget`."],"additions":6,"deletions":0,"truncated":false},{"path":"crates/swc_ecma_transforms_base/src/fixer.rs","lines":["@@ -257,7 +257,13 @@ impl VisitMut for Fixer<'_> {","         match n {","             AssignTarget::Simple(a) => {","                 if let SimpleAssignTarget::Paren(s) = a {","-                    *n = AssignTarget::try_from(s.expr.take()).unwrap();","+                    match AssignTarget::try_from(s.expr.take()) {","+                        Ok(target) => *n = target,","+                        // Parser recovery can retain expressions that have no","+                        // assignment-target variant. Keep their wrapper so","+                        // the recovered expression is neither lost nor invalidated.","+                        Err(expr) => s.expr = expr,","+                    }","                 }","             }","             AssignTarget::Pat(b) => {"],"additions":7,"deletions":1,"truncated":false},{"path":"crates/swc_ecma_transforms_base/tests/fixer.rs","lines":["@@ -8,6 +8,8 @@ use swc_ecma_transforms_base::fixer::fixer;"," use swc_ecma_visit::{noop_visit_mut_type, VisitMut, VisitMutWith};"," use testing::fixture;"," ","+#[path = \"fixer/assignment_targets.rs\"]","+mod assignment_targets;"," #[path = \"fixer/metadata.rs\"]"," mod metadata;"," "],"additions":2,"deletions":0,"truncated":false},{"path":"crates/swc_ecma_transforms_base/tests/fixer/assignment-targets/unsupported/input.ts","lines":["@@ -0,0 +1,13 @@","+export {};","+(value as const) += other;","+((0 as const)) = ot