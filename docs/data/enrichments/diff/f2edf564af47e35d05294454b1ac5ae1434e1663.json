llbacks\", \"priority\"] = \"callbacks\"","+","+    def build_query(self, *, replaying: bool) -> Select[tuple[DagProcessorCallback]]:","+        query = select(self.model).order_by(self.model.priority_weight.desc(), self.model.id)","+        if not replaying:","+            query = query.where(self.model.state.is_(None))","+        return query","+","+    def get_payload(self, work: DagProcessorCallback) -> tuple[str, CallbackRequest]:","+        request = work.get_callback_request()","+        return request.filepath, request","+","+    def parse_key(self, work_id: str) -> UUID:","+        try:","+            return UUID(work_id)","+        except ValueError as error:","+            raise HTTPException(","+                status.HTTP_422_UNPROCESSABLE_CONTENT, detail=\"Invalid callback ID\"","+            ) from error","+","+","+class _PriorityWork:","+    model = DagPriorityParsingRequest","+    kind: Literal[\"callbacks\", \"priority\"] = \"priority\"","+","+    def build_query(self, *, replaying: bool) -> Select[tuple[DagPriorityParsingRequest]]:","+        return select(self.model).order_by(self.model.id)","+","+    def get_payload(self, work: DagPriorityParsingRequest) -> tuple[str, None]:","+        return work.relative_fileloc, None","+","+    def parse_key(self, work_id: str) -> str:","+        return work_id","+","+","+@router.post(","+    \"/{job_id}/requested-work/{kind}/claim\",","+    responses=create_openapi_http_exception_doc(","+        [status.HTTP_403_FORBIDDEN, status.HTTP_404_NOT_FOUND, status.HTTP_409_CONFLICT]","+    ),","+    dependencies=[Security(require_auth, scopes=[\"token:dag_processor\"])],","+)","+def claim_work(","+    job_id: int,","+    kind: Literal[\"callbacks\", \"priority\"],","+    body: ProcessorWorkClaimBody,","+    *,","+    session: SessionDep,","+    token: DagProcessorToken = CurrentDagProcessorToken,","+) -> list[ProcessorWorkItem]:","+    \"\"\"Replay outstanding work without letting an old or empty claim take new requests.\"\"\"","+    if not set(body.bundle_names) <= token.claims.dag_bundles:","+        raise HTTPException(status.HTTP_403_FORBIDDEN, detail={\"reason\": \"bundle_not_granted\"})","+    _validate_job(job_id, token, session=session)","+    if kind == \"callbacks\":","+        return _claim_work(_CallbackWork(), job_id, body, token.claims.dag_bundles, session=session)","+    return _claim_work(_PriorityWork(), job_id, body, token.claims.dag_bundles, session=session)","+","+","+def _claim_work(","+    source: _RequestedWork[WorkT],","+    job_id: int,","+    body: ProcessorWorkClaimBody,","+    granted_bundles: frozenset[str],","+    *,","+    session: Session,","+) -> list[ProcessorWorkItem]:","+    model = source.model","+    receipt = session.get(DagProcessorWorkClaim, (job_id, source.kind))","+    payload_hash = _compute_payload_hash(body)","+    replaying = receipt is not None and body.claim_sequence <= receipt.claim_sequence","+    query = source.build_query(replaying=replaying)","+    if receipt is not None and replaying:","+        if body.claim_sequence < receipt.claim_sequence:","+            return []","+        if receipt.claim_id != body.claim_id or receipt.payload_hash != payload_hash:","+            raise HTTPException(status.HTTP_409_CONFLICT, detail={\"reason\": \"claim_conflict\"})","+        query = query.where(model.processor_job_id == job_id, model.processor_claim_id == body.claim_id)","+    else:","+        if receipt is None:","+            receipt = DagProcessorWorkClaim(job_id=job_id, kind=source.kind)","+            session.add(receipt)","+        receipt.claim_id = body.claim_id","+        receipt.claim_sequence = body.claim_sequence","+        receipt.payload_hash = payload_hash","+        ready = select(DagBundleModel.name).where(DagBundleModel.active.is_(True))","+        query = query.where(","+            model.bundle_name.in_(body.bundle_names),","+            model.bundle_name.in_(ready),","+            get_available_work_filter(model.processor_job_id),","+        )","+    if not replaying:","+        query = with_row_locks(query.limit(body.limit), session=session, skip_locked=True)","+    replay = session.scalars(query).all()","+    if not replaying:","+        for work in replay:","+            work.processor_job_id = job_id","+            work.processor_claim_id = body.claim_id","+    result = []","+    for work in replay:","+        if work.bundle_name is None or work.bundle_name not in granted_bundles:","+            raise HTTPException(status.HTTP_403_FORBIDDEN, detail={\"reason\": \"bundle_not_granted\"})","+        path, callback = source.get_payload(work)","+        result.append(","+            ProcessorWorkItem(","+                id=str(work.id),","+                claim_id=body.claim_id,","+                bundle_name=work.bundle_name,","+                relative_fileloc=path,","+                callback=callback,","+            )","+        )","+    return result","+","+","+@router.post(","+    \"/{job_id}/requested-work/{kind}/{work_id}/ack\",","+    responses=create_openapi_http_exception_doc(","+        [","+            status.HTTP_403_FORBIDDEN,","+            status.HTTP_404_NOT_FOUND,","+            status.HTTP_409_CONFLICT,","+            status.HTTP_422_UNPROCESSABLE_CONTENT,","+        ]","+    ),","+    status_code=status.HTTP_204_NO_CONTENT,","+    dependencies=[Security(require_auth, scopes=[\"token:dag_processor\"])],","+)","+def acknowledge_work(","+    job_id: int,","+    kind: Literal[\"callbacks\", \"priority\"],","+    work_id: str,","+    body: ProcessorWorkAckBody,","+    *,","+    session: SessionDep,","+    token: DagProcessorToken = CurrentDagProcessorToken,","+) -> None:","+    \"\"\"Reject acknowledgments that could consume a replacement owner's claim.\"\"\"","+    _validate_job(job_id, token, session=session)","+    if kind == \"callbacks\":","+        _acknowledge_work(_CallbackWork(), job_id, work_id, body, token.claims.dag_bundles, session=session)","+    else:","+        _acknowledge_work(_PriorityWork(), job_id, work_id, body, token.claims.dag_bundles, session=session)","+","+","+def _acknowledge_work(","+    source: _RequestedWork[WorkT],","+    job_id: int,","+    work_id: str,","+    body: ProcessorWorkAckBody,","+    granted_bundles: frozenset[str],","+    *,","+    session: Session,","+) -> None:","+    key = source.parse_key(work_id)","+    work = session.scalar(","+        select(source.model).where(source.model.id == key).with_for_update(),","+    )","+    if work is None:","+        return","+    if work.bundle_name not in granted_bundles:","+        raise HTTPException(status.HTTP_403_FORBIDDEN, detail={\"reason\": \"bundle_not_granted\"})","+    if (work.processor_job_id, work.processor_claim_id) != (job_id, body.claim_id):","+        raise HTTPException(status.HTTP_409_CONFLICT, detail={\"reason\": \"claim_replaced\"})","+    # Callback runners log individual failures without failing the child process;","+    # an acknowledgment confirms delivery, not successful execution of user code.","+    session.delete(work)"],"additions":198,"deletions":1,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/routes/jobs.py","lines":["@@ -53,6 +53,8 @@"," )"," from airflow.configuration import conf"," from airflow.dag_processing.bundles.manager import get_configured_bundle_team_names","+from airflow.dag_processing.timeouts import get_job_heartbeat_timeout","+from airflow.exceptions import AirflowConfigException"," from airflow.jobs.dag_processor_job_runner import DagProcessorJobRunner"," from airflow.jobs.job import Job, JobState"," from airflow.models.dag_processor_publication_receipt import DagProcessorPublicationReceipt","@@ -158,6 +160,7 @@ def _resume_registration(","                 status.HTTP_409_CONFLICT,","                 \"The registration has ended, conflicts with an earlier one, or another process's Job is running\",","             ),","+            (status.HTTP_503_SERVIC