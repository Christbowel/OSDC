verFeatureProps: null,","+  }),","+})","+```","+","+If an affected adapter or feature performs asynchronous work, move that work to an asynchronous plugin before config sanitization or to a runtime hook. Projects that only use `buildConfig(...)` and `lexicalEditor(...)` normally are not affected; `buildConfig` remains asynchronous.","+"," ### `transactionIDPromise` removed from `PayloadRequest`"," "," The `transactionIDPromise` property on `PayloadRequest` has been removed. It was deprecated and unused — `transactionID` (which already supports `Promise<number | string>`) is the correct property to use for both resolved values and pending transactions."],"additions":34,"deletions":1,"truncated":false},{"path":"docs/rich-text/converters.mdx","lines":["@@ -34,7 +34,7 @@ const config: SanitizedConfig = {} as SanitizedConfig"," If you require the default editor config:"," "," ```ts","-const defaultEditorConfig = await editorConfigFactory.default({ config })","+const defaultEditorConfig = editorConfigFactory.default({ config })"," ```"," "," ### Option 2: Extract from a Lexical Field","@@ -54,7 +54,7 @@ You can create a custom editor configuration by specifying additional features:"," ```ts"," import { FixedToolbarFeature } from '@payloadcms/richtext-lexical'"," ","-const customEditorConfig = await editorConfigFactory.fromFeatures({","+const customEditorConfig = editorConfigFactory.fromFeatures({","   config,","   features: ({ defaultFeatures }) => [","     ...defaultFeatures,","@@ -75,7 +75,7 @@ const editor = lexicalEditor({","   ],"," })"," ","-const instantiatedEditorConfig = await editorConfigFactory.fromEditor({","+const instantiatedEditorConfig = editorConfigFactory.fromEditor({","   config,","   editor,"," })"],"additions":3,"deletions":3,"truncated":false},{"path":"docs/rich-text/converting-html.mdx","lines":["@@ -239,7 +239,7 @@ import {"," import { JSDOM } from 'jsdom'"," "," const lexicalJSON = convertHTMLToLexical({","-  editorConfig: await editorConfigFactor