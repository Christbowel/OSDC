er(const string &text) const {","+\t\tif (text.empty()) {","+\t\t\treturn false;","+\t\t}","+\t\tif (IsSingleQuoted(text) && SupportsStringLiteral()) {","+\t\t\treturn true;","+\t\t}","+\t\tif (IsQuoted(text)) {","+\t\t\treturn true;","+\t\t}","+\t\tif (Tokenizer::CharacterIsInitialNumber(text[0])) {","+\t\t\treturn false;","+\t\t}","+\t\treturn Tokenizer::CharacterIsKeyword(text[0]);","+\t}","+","+\tMatchResultType Match(MatchState &state) const override {","+\t\tif (!MatchIdentifier(state)) {","+\t\t\treturn MatchResultType::FAIL;","+\t\t}","+\t\tstate.token_iterator.SetPreviousTokenType(GetTokenType());","+\t\treturn MatchResultType::SUCCESS;","+\t}","+","+\toptional_ptr<ParseResult> MatchParseResultInternal(MatchState &state) const override {","+\t\tauto token = state.token_iterator.Current();","+\t\tif (!token) {","+\t\t\treturn nullptr;","+\t\t}","+\t\tconst auto &token_text = token->text;","+\t\tauto start_offset = optional_idx(token->offset);","+\t\tauto token_length = optional_idx(token->length);","+\t\tif (!MatchIdentifier(state)) {","+\t\t\treturn nullptr;","+\t\t}","+","+\t\tstring result_text = token_text;","+\t\tif (IsQuoted(result_text)) {","+\t\t\tresult_text = result_text.substr(1, result_text.size() - 2);","+\t\t\tresult_text = StringUtil::Replace(result_text, \"\\\"\\\"\", \"\\\"\");","+\t\t} else if (!state.preserve_identifier_case) {","+\t\t\tresult_text = StringUtil::Lower(result_text);","+\t\t}","+\t\tif (IsSingleQuoted(result_text) && SupportsStringLiteral()) {","+\t\t\tresult_text = result_text.substr(1, result_text.size() - 2);","+\t\t\tresult_text = StringUtil::Replace(result_text, \"''\", \"'\");","+\t\t}","+\t\treturn state.allocator.Allocate(make_uniq<IdentifierParseResult>(result_text, start_offset, token_length));","+\t}","+","+\tTokenType GetTokenType() const {","+\t\tswitch (suggestion_type) {","+\t\tcase SuggestionState::SUGGEST_CATALOG_NAME:","+\t\t\treturn TokenType::CATALOG_NAME;","+\t\tcase SuggestionState::SUGGEST_SCHEMA_NAME: