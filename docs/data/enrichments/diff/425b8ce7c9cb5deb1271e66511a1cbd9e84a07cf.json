apper","+\tclient             *dashboardDeleteClient","+\tuids               []string","+\tcompletedAtCleanup int","+}","+","+func (p *dashboardDeletePublicService) DeleteByDashboardUIDs(_ context.Context, _ int64, uids []string) error {","+\tp.uids = uids","+\tp.client.mu.Lock()","+\tp.completedAtCleanup = p.client.completed","+\tp.client.mu.Unlock()","+\treturn nil","+}","+","+type dashboardDeleteStore struct {","+\tfolder.Store","+\tdeleted bool","+}","+","+func (s *dashboardDeleteStore) GetDescendants(context.Context, int64, string) ([]*folder.Folder, error) {","+\treturn nil, nil","+}","+func (s *dashboardDeleteStore) Delete(context.Context, []string, int64) error {","+\ts.deleted = true","+\treturn nil","+}","+","+type emptyFolderRegistry struct{ folder.RegistryService }","+","+func (*emptyFolderRegistry) CountInFolders(context.Context, int64, []string, identity.Requester) (int64, error) {","+\treturn 0, nil","+}","+func (*emptyFolderRegistry) DeleteInFolders(context.Context, int64, []string, identity.Requester) error {","+\treturn nil","+}","+","+func newDashboardDeleteService(t *testing.T, enabled bool, concurrency, count int) (*Service, *dashboardDeleteClient, *folder.DeleteFolderCommand, context.Context) {","+\trequester := &user.SignedInUser{UserID: 42, OrgID: 1}","+\tcli := &dashboardDeleteClient{requester: requester}","+\tfor i := range count {","+\t\tcli.uids = append(cli.uids, fmt.Sprintf(\"dashboard-%d\", i))","+\t}","+\tcfg := setting.NewCfg()","+\tcfg.FolderParallelDashboardDeleteEnabled = enabled","+\tcfg.FolderParallelDashboardDeleteConcurrency = concurrency","+\tsvc := &Service{","+\t\tcfg: cfg, dashboardK8sClient: cli, variableK8sClient: &dashboardDeleteClient{}, unifiedStore: &dashboardDeleteStore{},","+\t\tpublicDashboardService: &dashboardDeletePublicService{client: cli},","+\t\ttracer:                 noop.NewTracerProvider().Tracer(\"test\"), log: slog.New(logtest.NewNopHandler(t)),","+\t\tregistry: map[string]folder.RegistryService{entity.StandardKindAlertRule: &emptyFolderRegistry{}, entity.StandardKindLibraryPanel: &emptyFolderRegistry{}},","+\t}","+\treturn svc, cli, &folder.DeleteFolderCommand{UID: \"folder\", OrgID: 1, SignedInUser: requester}, identity.WithRequester(context.Background(), requester)","+}","+","+// deleteGate holds every delete until open is called, so a test can see how many run at once.","+type deleteGate struct {","+\tentered chan struct{}","+\trelease chan struct{}","+\tonce    sync.Once","+}","+","+func newDeleteGate(t *testing.T) *deleteGate {","+\tg := &deleteGate{entered: make(chan struct{}, 100), release: make(chan struct{})}","+\tt.Cleanup(g.open)","+\treturn g","+}","+","+func (g *deleteGate) hold(context.Context, string) error {","+\tg.entered <- struct{}{}","+\t<-g.release","+\treturn nil","+}","+","+func (g *deleteGate) open() { g.once.Do(func() { close(g.release) }) }","+","+func (g *deleteGate) waitForDeletes(t *testing.T, n int) {","+\tt.Helper()","+\tsynctest.Wait()","+\trequire.Len(t, g.entered, n, \"unexpected number of in-flight deletes\")","+}","+","+func runInBackground(f func() error) <-chan error {","+\tdone := make(chan error, 1)","+\tgo func() { done <- f() }()","+\treturn done","+}","+","+func waitForResult(t *testing.T, done <-chan error) error {","+\tt.Helper()","+\tsynctest.Wait()","+\tselect {","+\tcase err := <-done:","+\t\treturn err","+\tdefault:","+\t\tt.Fatal(\"delete did not finish\")","+\t\treturn nil","+\t}","+}","+","+func TestDeleteFolderDashboardConcurrency(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname                 string","+\t\tenabled              bool","+\t\tworkers, count, want int","+\t}{","+\t\t{\"disabled deletes one at a time\", false, 8, 12, 1},","+\t\t{\"enabled is bounded by the worker count\", true, 4, 12, 4},","+\t\t{\"enabled with more workers than dashboards\", true, 8, 2, 2},","+\t\t{\"non-positive worker count uses one worker\", true, 0, 12, 1},","+\t\t{\"empty folder\", true, 4, 0, 0},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\t\tsvc, cli, cmd, ctx := newDashboardDeleteService(t, tc.enabled, tc.workers, tc.count)","+\t\t\t\tgate := newDeleteGate(t)","+\t\t\t\tcli.deleteFn = gate.hold","+\t\t\t\tdone := runInBackground(func() error { return svc.Delete(ctx, cmd) })","+","+\t\t\t\tgate.waitForDeletes(t, tc.want)","+\t\t\t\tgate.open()","+\t\t\t\trequire.NoError(t, waitForResult(t, done))","+","+\t\t\t\trequire.Equal(t, tc.want, cli.maximum)","+\t\t\t\tif tc.enabled {","+\t\t\t\t\trequire.ElementsMatch(t, cli.uids, cli.calls)","+\t\t\t\t} else {","+\t\t\t\t\trequire.Equal(t, cli.uids, cli.calls)","+\t\t\t\t}","+\t\t\t\trequire.False(t, cli.badOptions)","+\t\t\t\trequire.False(t, cli.badRequester)","+\t\t\t\tpublic := svc.publicDashboardService.(*dashboardDeletePublicService)","+\t\t\t\trequire.Equal(t, tc.count, public.completedAtCleanup)","+\t\t\t\trequire.ElementsMatch(t, cli.uids, public.uids)","+\t\t\t\trequire.True(t, svc.unifiedStore.(*dashboardDeleteStore).deleted)","+\t\t\t})","+\t\t})","+\t}","+}","+","+func TestDeleteFolderDashboardRequestCancellation(t *testing.T) {","+\tsynctest.Test(t, func(t *testing.T) {","+\t\tsvc, cli, cmd, ctx := newDashboardDeleteService(t, true, 4, 20)","+\t\tctx, cancel := context.WithCancel(ctx)","+\t\tgate := newDeleteGate(t)","+\t\tcli.deleteFn = func(ctx context.Context, uid string) error {","+\t\t\t_ = gate.hold(ctx, uid)","+\t\t\t<-ctx.Done()","+\t\t\treturn ctx.Err()","+\t\t}","+\t\tdone := runInBackground(func() error { return svc.Delete(ctx, cmd) })","+","+\t\tgate.waitForDeletes(t, 4)","+\t\tcancel()","+\t\tsynctest.Wait()","+\t\tselect {","+\t\tcase <-done:","+\t\t\tt.Fatal(\"returned before in-flight deletes finished\")","+\t\tdefault:","+\t\t}","+\t\tgate.open()","+","+\t\trequire.ErrorIs(t, waitForResult(t, done), context.Canceled)","+\t\trequire.Len(t, cli.calls, 4)","+\t\trequire.Nil(t, svc.publicDashboardService.(*dashboardDeletePublicService).uids)","+\t\trequire.False(t, svc.unifiedStore.(*dashboardDeleteStore).deleted)","+\t})","+}","+","+func TestDeleteFolderDashboardFailureLetsInFlightDeletesFinish(t *testing.T) {","+\tsynctest.Test(t, func(t *testing.T) {","+\t\tsvc, cli, cmd, ctx := newDashboardDeleteService(t, true, 4, 20)","+\t\tgate := newDeleteGate(t)","+\t\treleaseFailure := make(chan struct{})","+\t\tcanceled := make(chan string, 20)","+\t\tfailure := errors.New(\"dashboard delete failed\")","+\t\tcli.deleteFn = func(ctx context.Context, uid string) error {","+\t\t\tgate.entered <- struct{}{}","+\t\t\tif uid == \"dashboard-0\" {","+\t\t\t\t<-releaseFailure","+\t\t\t\treturn failure","+\t\t\t}","+\t\t\tselect {","+\t\t\tcase <-ctx.Done():","+\t\t\t\tcanceled <- uid","+\t\t\t\treturn ctx.Err()","+\t\t\tcase <-gate.release:","+\t\t\t\treturn nil","+\t\t\t}","+\t\t}","+\t\tdone := runInBackground(func() error { return svc.Delete(ctx, cmd) })","+","+\t\tgate.waitForDeletes(t, 4)","+\t\tclose(releaseFailure)","+\t\tsynctest.Wait()","+\t\tselect {","+\t\tcase uid := <-canceled:","+\t\t\tt.Fatalf(\"a failed sibling canceled the in-flight delete of %s\", uid)","+\t\tcase <-done:","+\t\t\tt.Fatal(\"returned before in-flight deletes finished\")","+\t\tdefault:","+\t\t}","+\t\tgate.open()","+","+\t\trequire.ErrorIs(t, waitForResult(t, done), failure)","+\t\trequire.Len(t, cli.calls, 4, \"no new deletes may start after the first failure\")","+\t\trequire.Nil(t, svc.publicDashboardService.(*dashboardDeletePublicService).uids)","+\t\trequire.False(t, svc.unifiedStore.(*dashboardDeleteStore).deleted)","+\t})","+}"],"additions":253,"deletions":0,"truncated":false},{"path":"pkg/setting/setting.go","lines":["@@ -622,6 +622,11 @@ type Cfg struct {"," \t// MaxNestedFolderDepth is the hard ceiling for folder nesting depth."," \t// The SQL query builders use this value to generate JOIN chains."," \tMaxNestedFolderDepth int","+\t// FolderParallelDashboardDeleteEnabled deletes the dashboards of a deleted folder concurr