{","+\t\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\t\tsvc, client, requester := newFolderDeleteService(t, tc.enabled, tc.workers, tc.count, nil)","+\t\t\t\tgate := newDeleteGate(t)","+\t\t\t\tclient.deleteFn = gate.hold","+\t\t\t\tdone := runInBackground(func() error { return svc.DeleteInFolders(t.Context(), 1, []string{\"folder\"}, requester) })","+","+\t\t\t\tgate.waitForDeletes(t, tc.want)","+\t\t\t\tgate.open()","+\t\t\t\trequire.NoError(t, waitForResult(t, done))","+","+\t\t\t\trequire.Equal(t, tc.want, client.maximum)","+\t\t\t\tdeleted := make([]string, 0, len(client.calls))","+\t\t\t\tfor _, call := range client.calls {","+\t\t\t\t\tdeleted = append(deleted, call.uid)","+\t\t\t\t\trequire.Equal(t, int64(1), call.orgID)","+\t\t\t\t\trequire.Same(t, requester, call.requester)","+\t\t\t\t\trequire.NotNil(t, call.options.GracePeriodSeconds)","+\t\t\t\t\trequire.Zero(t, *call.options.GracePeriodSeconds)","+\t\t\t\t}","+\t\t\t\tif tc.enabled {","+\t\t\t\t\trequire.ElementsMatch(t, client.uids, deleted)","+\t\t\t\t} else {","+\t\t\t\t\trequire.Equal(t, client.uids, deleted)","+\t\t\t\t}","+\t\t\t})","+\t\t})","+\t}","+}","+","+func TestDeleteInFoldersCancellationWaitsForInFlightDeletes(t *testing.T) {","+\tsynctest.Test(t, func(t *testing.T) {","+\t\tsvc, client, requester := newFolderDeleteService(t, true, 4, 20, nil)","+\t\tctx, cancel := context.WithCancel(t.Context())","+\t\tgate := newDeleteGate(t)","+\t\tclient.deleteFn = gate.hold","+\t\tdone := runInBackground(func() error { return svc.DeleteInFolders(ctx, 1, []string{\"folder\"}, requester) })","+","+\t\tgate.waitForDeletes(t, 4)","+\t\tcancel()","+\t\tsynctest.Wait()","+\t\tselect {","+\t\tcase <-done:","+\t\t\tt.Fatal(\"returned before in-flight deletes finished\")","+\t\tdefault:","+\t\t}","+\t\tgate.open()","+","+\t\trequire.ErrorIs(t, waitForResult(t, done), context.Canceled)","+\t\trequire.Len(t, client.calls, 4)","+\t})","+}","+","+func TestDeleteInFoldersErrors(t *testing.T) {","+\tfor _, enabled := range []bool{false, true} {","+\t\tt.Run(fmt.Sprintf(\"enabled=%v\", enabled), func(t *testing.T) {","+\t\t\tt.Run(\"a failed delete does not skip the others\", func(t *testing.T) {","+\t\t\t\tsvc, client, requester := newFolderDeleteService(t, enabled, 4, 10, nil)","+\t\t\t\tclient.deleteFn = func(context.Context, string) error { return errors.New(\"delete failure\") }","+\t\t\t\trequire.NoError(t, svc.DeleteInFolders(t.Context(), 1, []string{\"folder\"}, requester))","+\t\t\t\trequire.Len(t, client.calls, 10)","+\t\t\t})","+\t\t\tt.Run(\"a failed public dashboard cleanup prevents deletes\", func(t *testing.T) {","+\t\t\t\tcleanupErr := errors.New(\"public cleanup failed\")","+\t\t\t\tsvc, client, requester := newFolderDeleteService(t, enabled, 4, 10, cleanupErr)","+\t\t\t\trequire.ErrorIs(t, svc.DeleteInFolders(t.Context(), 1, []string{\"folder\"}, requester), cleanupErr)","+\t\t\t\trequire.Empty(t, client.calls)","+\t\t\t})","+\t\t})","+\t}","+\tt.Run(\"an already canceled request deletes nothing\", func(t *testing.T) {","+\t\tsvc, client, requester := newFolderDeleteService(t, true, 4, 10, nil)","+\t\tctx, cancel := context.WithCancel(t.Context())","+\t\tcancel()","+\t\trequire.ErrorIs(t, svc.DeleteInFolders(ctx, 1, []string{\"folder\"}, requester), context.Canceled)","+\t\trequire.Empty(t, client.calls)","+\t})","+}"],"additions":189,"deletions":0,"truncated":false},{"path":"pkg/services/dashboards/service/delete_in_folders.go","lines":["@@ -0,0 +1,41 @@","+package service","+","+import (","+\t\"context\"","+\t\"sync\"","+","+\t\"github.com/grafana/grafana/pkg/services/dashboards\"","+)","+","+func (dr *DashboardServiceImpl) deleteInFoldersParallel(ctx context.Context, orgID int64, folderUIDs []string, dashes []*dashboards.Dashboard) error {","+\tjobs := make(chan *dashboards.Dashboard)","+\tvar workers sync.WaitGroup","+\t// Settings reject non-positive values, but a hand-built Cfg can still carry one. Without a","+\t// worker, the unbuffered send below would block forever.","+\tfor range min(max(dr.cfg.FolderParallelDashboardDeleteConcurrency, 1), len(dashes)) {","+\t\tworkers.Go(func() {","+\t\t\tfor dash := range jobs {","+\t\t\t\t// A ready send can race cancellation; do not start another delete afterwards.","+\t\t\t\tif ctx.Err() != nil {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tif err := dr.deleteDashboard(ctx, dash.ID, dash.UID, orgID, false); err != nil {","+\t\t\t\t\t// Keep the sequential path's best-effort behavior: one failure must not skip the rest.","+\t\t\t\t\tdr.log.Error(\"failed to delete dashboard inside folder\", \"dashboardUID\", dash.UID, \"folderUIDs\", folderUIDs, \"error\", err)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+","+scheduling:","+\tfor _, dash := range dashes {","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\tbreak scheduling","+\t\tcase jobs <- dash:","+\t\t}","+\t}","+\tclose(jobs)","+\tworkers.Wait()","+\treturn ctx.Err()","+}"],"additions":41,"deletions":0,"truncated":false},{"path":"pkg/services/folder/folderimpl/delete_dashboards.go","lines":["@@ -0,0 +1,62 @@","+package folderimpl","+","+import (","+\t\"context\"","+","+\t\"golang.org/x/sync/errgroup\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+)","+","+// deleteDashboards deletes each dashboard with its own request. When parallel deletes are","+// enabled, up to the configured number of requests are in flight at once.","+func (s *Service) deleteDashboards(ctx context.Context, orgID int64, uids []string) error {","+\tif s.cfg == nil || !s.cfg.FolderParallelDashboardDeleteEnabled {","+\t\tfor _, uid := range uids {","+\t\t\tif err := s.dashboardK8sClient.Delete(ctx, uid, orgID, metav1.DeleteOptions{}); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t\treturn nil","+\t}","+\t// stop only prevents new deletes from starting. In-flight deletes keep the request context, so a","+\t// failing sibling cannot cut one short after storage removed the dashboard but before its","+\t// post-delete cleanup, such as permission removal, has run.","+\tstopCtx, stop := context.WithCancel(ctx)","+\tdefer stop()","+","+\tjobs := make(chan string)","+\tvar workers errgroup.Group","+\t// Settings reject non-positive values, but a hand-built Cfg can still carry one. Without a","+\t// worker, the unbuffered send below would block forever.","+\tfor range min(max(s.cfg.FolderParallelDashboardDeleteConcurrency, 1), len(uids)) {","+\t\tworkers.Go(func() error {","+\t\t\tfor uid := range jobs {","+\t\t\t\t// A ready send can race the stop signal; do not start another delete afterwards.","+\t\t\t\tif stopCtx.Err() != nil {","+\t\t\t\t\treturn nil","+\t\t\t\t}","+\t\t\t\tif err := s.dashboardK8sClient.Delete(ctx, uid, orgID, metav1.DeleteOptions{}); err != nil {","+\t\t\t\t\tstop()","+\t\t\t\t\treturn err","+\t\t\t\t}","+\t\t\t}","+\t\t\treturn nil","+\t\t})","+\t}","+","+scheduling:","+\tfor _, uid := range uids {","+\t\tselect {","+\t\tcase <-stopCtx.Done():","+\t\t\tbreak scheduling","+\t\tcase jobs <- uid:","+\t\t}","+\t}","+\tclose(jobs)","+\t// Like the sequential loop, stop at the first failure. Waiting for in-flight deletes keeps","+\t// public dashboard and folder cleanup from starting while children are still being deleted.","+\tif err := workers.Wait(); err != nil {","+\t\treturn err","+\t}","+\treturn ctx.Err()","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"pkg/services/folder/folderimpl/folder.go","lines":["@@ -40,6 +40,7 @@ var ("," )"," "," type Service struct {","+\tcfg                    *setting.Cfg"," \tunifiedStore           folder.Store"," \tlog                    *slog.Logger"," \tfeatures               featuremgmt.FeatureToggles","@@ -69,6 +70,7 @@ func ProvideService("," \trestConfig apiserver.RestConfigProvider,"," ) *Service {"," \tsrv := &Service{","+\t\tcfg:                    cfg,"," \t\tlog:                    slog.Default().With(\"logger\", \"folder-service\"),"," \t\tfeatures:               features,"," \t\taccessControl:          ac,"]