   metav1.DeleteOptions","+}","+","+type folderDeleteClient struct {","+\tdashboardclient.K8sHandlerWithFallback","+\tuids            []string","+\tdeleteFn        func(context.Context, string) error","+\tmu              sync.Mutex","+\tactive, maximum int","+\tcalls           []folderDeleteCall","+}","+","+func (c *folderDeleteClient) GetNamespace(int64) string { return \"default\" }","+func (c *folderDeleteClient) Search(context.Context, int64, *resourcepb.ResourceSearchRequest) (*resourcepb.ResourceSearchResponse, error) {","+\trows := make([]*resourcepb.ResourceTableRow, len(c.uids))","+\tfor i, uid := range c.uids {","+\t\trows[i] = &resourcepb.ResourceTableRow{Key: &resourcepb.ResourceKey{Name: uid, Group: \"dashboard.grafana.app\", Resource: \"dashboards\"}}","+\t}","+\treturn &resourcepb.ResourceSearchResponse{TotalHits: int64(len(rows)), Results: &resourcepb.ResourceTable{Rows: rows}}, nil","+}","+func (c *folderDeleteClient) Delete(ctx context.Context, uid string, orgID int64, options metav1.DeleteOptions) error {","+\trequester, _ := identity.GetRequester(ctx)","+\tc.mu.Lock()","+\tc.calls = append(c.calls, folderDeleteCall{uid, orgID, requester, options})","+\tc.active++","+\tc.maximum = max(c.maximum, c.active)","+\tc.mu.Unlock()","+\tdefer func() { c.mu.Lock(); c.active--; c.mu.Unlock() }()","+\tif c.deleteFn != nil {","+\t\treturn c.deleteFn(ctx, uid)","+\t}","+\treturn nil","+}","+","+func newFolderDeleteService(t *testing.T, enabled bool, workers, count int, cleanupErr error) (*DashboardServiceImpl, *folderDeleteClient, *user.SignedInUser) {","+\tpublic := publicdashboards.NewFakePublicDashboardServiceWrapper(t)","+\tpublic.On(\"DeleteByDashboardUIDs\", mock.Anything, int64(1), mock.Anything).Return(cleanupErr).Maybe()","+\tclient := &folderDeleteClient{}","+\tfor i := range count {","+\t\tclient.uids = append(client.uids, fmt.Sprintf(\"dashboard-%d\", i))","+\t}","+\tcfg := setting.NewCfg()","+\tcfg.FolderParallelDashboardDeleteEnabled = enabled","