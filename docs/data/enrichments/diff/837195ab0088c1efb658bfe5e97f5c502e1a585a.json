;","+            let high = builder.ins().ushr_imm_u(value, 32);","+            let high = builder.ins().ireduce(ir::types::I32, high);","+            (","+                bitcast(builder, natural_type(first, config), low),","+                bitcast(builder, natural_type(second, config), high),","+            )","+        }","+        PairSlot::F32Vector(_, _) => {","+            let bits = bitcast(builder, ir::types::I64, value);","+            let low = builder.ins().ireduce(ir::types::I32, bits);","+            let high = builder.ins().ushr_imm_u(bits, 32);","+            let high = builder.ins().ireduce(ir::types::I32, high);","+            (","+                bitcast(builder, ir::types::F32, low),","+                bitcast(builder, ir::types::F32, high),","+            )","+        }","+    };","+    match abi {","+        ReturnAbi::Void => SmallVec::new(),","+        ReturnAbi::Single(_) => smallvec![values[0]],","+        ReturnAbi::Pair(a, b) => smallvec![","+            unpack_slot(builder, values[0], *a),","+            unpack_slot(builder, values[1], *b)","+        ],","+        ReturnAbi::PackedPair(pair) => {","+            let (a, b) = unpack_pair_with_config(builder, values[0], *pair);","+            smallvec![a, b]","+        }","+        ReturnAbi::PackedFirst(pair, slot) => {","+            let (a, b) = unpack_pair_with_config(builder, values[0], *pair);","+            smallvec![a, b, unpack_slot(builder, values[1], *slot)]","+        }","+        ReturnAbi::PackedLast(slot, pair) => {","+            let (a, b) = unpack_pair_with_config(builder, values[1], *pair);","+            smallvec![unpack_slot(builder, values[0], *slot), a, b]","+        }","+        ReturnAbi::PackedQuads(a, b) => {","+            let (a0, a1) = unpack_pair_with_config(builder, values[0], *a);","+            let (b0, b1) = unpack_pair_with_config(builder, values[1], *b);","+            smallvec![a0, a1, b0, b1]","+        }","+        ReturnAbi::Unpacked(_) => values.it