);","+      assert.dom(GENERAL.infoRowLabel('Password')).hasText('Password', 'Password row is displayed');","+      if (roleType === 'dynamic') {","+        assert.dom(GENERAL.infoRowValue('Lease ID')).hasText('database/creds/my-role/test-lease');","+        assert.dom(GENERAL.infoRowValue('Lease Duration')).hasText('1 hour');","+      } else {","+        assert.dom(GENERAL.infoRowValue('Rotation Period')).hasText('1 day');","+        assert.dom(GENERAL.infoRowValue('Time Remaining')).hasText('1 hour');","+      }","+    });","+","+    test(`an explicit ${roleType} role only calls its matching endpoint and displays RSA credentials`, async function (assert) {","+      const successful = roleType === 'static' ? this.staticRequest : this.dynamicRequest;","+      const unused = roleType === 'static' ? this.dynamicRequest : this.staticRequest;","+      successful.resolves({","+        data: {","+          username: 'test-user',","+          rsa_private_key: 'test-private-key',","+          last_vault_rotation: '2026-01-01T00:00:00Z',","+        },","+      });","+","+      this.set('model', await this.route.model({ secret: 'my-role', roleType }));","+      await render(credentialsTemplate);","+","+      assert.true(successful.calledOnceWithExactly('my-role', 'database'), 'Matching endpoint called once');","+      assert.true(unused.notCalled, 'The other endpoint is not called');","+      assert.strictEqual(this.model.dbCred.rsaPrivateKey, 'test-private-key', 'RSA key is normalized');","+      assert.dom(GENERAL.infoRowLabel('RSA Private Key')).hasText('RSA Private Key');","+      assert.dom(GENERAL.infoRowLabel('Password')).doesNotExist('No password row for key-pair credentials');","+    });","+  }","+","+  test('a successful static response takes precedence if both endpoints succeed', async function (assert) {","+    this.staticRequest.resolves({ data: { username: 'static-user' } });","+    this.dynamicRequest.resolves({ data: { username: 'dynamic-user' } });","+","+    const credential = await this.route.getDatabaseCredential('database', 'my-role');","+","+    assert.strictEqual(","+      credential.roleType,","+      'static',","+      'Static success is preferred, matching the old adapter'","+    );","+    assert.strictEqual(credential.username, 'static-user', 'Static credentials are returned');","+  });","+","+  for (const errorType of ['static', 'dynamic']) {","+    test(`when both requests fail, the higher-status ${errorType} error is displayed`, async function (assert) {","+      const higher = errorType === 'static' ? this.staticRequest : this.dynamicRequest;","+      const lower = errorType === 'static' ? this.dynamicRequest : this.staticRequest;","+      higher.rejects(","+        new ResponseError(new Response(JSON.stringify({ errors: ['database unavailable'] }), { status: 500 }))","+      );","+      lower.rejects(new ResponseError(new Response(JSON.stringify({ errors: [] }), { status: 404 })));","+","+      this.set('model', await this.route.model({ secret: 'my-role', roleType: '' }));","+      await render(credentialsTemplate);","+","+      assert.strictEqual(this.model.dbCred.status, 500, 'The more informative error is selected');","+      assert.dom().includesText('database unavailable', 'API error message is rendered');","+      assert.dom(GENERAL.infoRowLabel('Password')).doesNotExist('Errors are not rendered as credentials');","+    });","+","+    test(`${errorType} control-group errors are propagated when neither request succeeds`, async function (assert) {","+      const locked = errorType === 'static' ? this.staticRequest : this.dynamicRequest;","+      const other = errorType === 'static' ? this.dynamicRequest : this.staticRequest;","+      locked.rejects(","+        new ResponseError(","+          new Response(JSON.stringify({ isControlGroupError: true, message: 'Control Group encountered' }), {","+            status: 403,","+          })","+        )","+      );","+      other.rejects(new ResponseError(new Response(JSON.stringify({ errors: [] }), { status: 404 })));","+","+      await assert.rejects(","+        this.route.getDatabaseCredential('database', 'my-role'),","+        (error) => error.isControlGroupError === true,","+        'Control-group authorization is not swallowed or replaced by the other endpoint error'","+      );","+    });","+  }","+});"],"additions":134,"deletions":0,"truncated":false},{"path":"ui/tests/integration/components/get-credentials-card-test.js","lines":["@@ -5,13 +5,14 @@"," "," import { module, test } from 'qunit';"," import { setupRenderingTest } from 'vault/tests/helpers';","-import { click, render } from '@ember/test-helpers';","+import { click, fillIn, render, typeIn } from '@ember/test-helpers';"," import { clickTrigger } from 'ember-power-select/test-support/helpers';"," import { selectChoose } from 'ember-power-select/test-support';","-import hbs from 'htmlbars-inline-precompile';","+import { hbs } from 'ember-cli-htmlbars';"," import sinon from 'sinon';"," import { setRunOptions } from 'ember-a11y-testing/test-support';"," import { GENERAL } from 'vault/tests/helpers/general-selectors';","+import { getErrorResponse } from 'vault/tests/helpers/api/error-response';"," "," module('Integration | Component | get-credentials-card', function (hooks) {","   setupRenderingTest(hooks);","@@ -22,6 +23,9 @@ module('Integration | Component | get-credentials-card', function (hooks) {","     this.dbListStub = sinon","       .stub(this.owner.lookup('service:api').secrets, 'databaseListRoles')","       .resolves({ keys: ['my-role'] });","+    this.staticListStub = sinon","+      .stub(this.owner.lookup('service:api').secrets, 'databaseListStaticRoles')","+      .resolves({ keys: [] });"," ","     this.set('title', 'Get Credentials');","     this.set('searchLabel', 'Role to use');","@@ -70,4 +74,136 @@ module('Integration | Component | get-credentials-card', function (hooks) {","       'transitionTo is called with correct route and role name'",