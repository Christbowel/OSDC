RAL.secretTab('Roles'));","+      assert.strictEqual(","+        currentURL(),","+        `/vault/secrets-engines/${backend}/list?tab=role`,","+        'The tab opens the role list'","+      );","+      assert.dom(SES.secretLink('static-role-1')).exists('The first static role is listed');","+      assert.dom(SES.secretLink('static-role-2')).exists('The second static role is listed');","+      assert.dom(SES.secretLink('dynamic-role-1')).doesNotExist('Dynamic roles remain inaccessible');","+      assert.dom(SES.secretLink('dynamic-role-2')).doesNotExist('No dynamic-role list permission is added');","+    } finally {","+      await visit('/vault/secrets-engines');","+      await login();","+      await runCmd(`delete sys/policies/acl/${policyName}`);","+    }","+  });","+","   test('root and limited access', async function (assert) {","     const backend = this.backend;","     const NO_ROLES_POLICY = `"],"additions":58,"deletions":0,"truncated":false},{"path":"ui/tests/integration/components/generate-credentials-database-test.js","lines":["@@ -8,6 +8,9 @@ import { setupRenderingTest } from 'vault/tests/helpers';"," import { render } from '@ember/test-helpers';"," import { hbs } from 'ember-cli-htmlbars';"," import { GENERAL } from 'vault/tests/helpers/general-selectors';","+import sinon from 'sinon';","+import { ResponseError } from '@hashicorp/vault-client-typescript';","+import credentialsTemplate from 'vault/templates/vault/cluster/secrets/backend/credentials';"," "," module('Integration | Component | GenerateCredentialsDatabase', function (hooks) {","   setupRenderingTest(hooks);","@@ -142,3 +145,134 @@ module('Integration | Component | GenerateCredentialsDatabase', function (hooks)","       .doesNotExist('Password row should not render when credential type is rsa_private_key');","   });"," });","+","+module('Integration | database credentials route and template', function (hooks) {","+  setupRenderingTest(hooks);","+","+  hooks.beforeEach(function () {","+    thi