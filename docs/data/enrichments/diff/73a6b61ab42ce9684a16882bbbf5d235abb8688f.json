{"id":"73a6b61ab42ce9684a16882bbbf5d235abb8688f","axis":"silent","repo":"apache/airflow","sha":"73a6b61ab42ce9684a16882bbbf5d235abb8688f","parsed":{"files":[{"path":"providers/fab/docs/changelog.rst","lines":["@@ -25,9 +25,11 @@ Changelog","     ``ab_user`` table. Run ``airflow db migrate`` after upgrading the provider."," ","     Changing or resetting a password now ends the API tokens and UI sessions issued before the","-    change. API servers cache users for up to ``[fab] cache_ttl`` seconds, so for a change made","-    from another process, such as ``airflow users reset-password`` or another API server, the","-    earlier API tokens stop working there once its cached user expires.","+    change, and deactivating or deleting a user in the UI, or deleting one through the API, now","+    ends their API tokens. API servers cache users for up to ``[fab] cache_ttl`` seconds, so for a","+    change made from another process, such as ``airflow users reset-password``,","+    ``airflow users delete`` or another API server, the earlier API tokens stop working there once","+    its cached user expires."," "," 3.11.1"," ......"],"additions":5,"deletions":3,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/api_fastapi/services/users.py","lines":["@@ -27,6 +27,7 @@","     UserResponse,"," )"," from airflow.providers.fab.auth_manager.api_fastapi.sorting import build_ordering","+from airflow.providers.fab.auth_manager.fab_auth_manager import FabAuthManager"," from airflow.providers.fab.auth_manager.models import User"," from airflow.providers.fab.auth_manager.security_manager.override import FabAirflowSecurityManagerOverride"," from airflow.providers.fab.www.utils import get_fab_auth_manager","@@ -235,3 +236,4 @@ def delete_user(cls, username: str) -> None:","         user.roles = []","         security_manager.session.delete(user)","         security_manager.session.commit()","+        FabAuthManager.evict_cached_user(user.id)"],"additions":2,"deletions":0,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/fab_auth_manager.py","lines":["@@ -215,8 +215,6 @@ class FabAuthManager(BaseAuthManager[User]):","     This auth manager is responsible for providing a backward compatible user management experience to users.","     \"\"\""," ","-    # Pop a user only after their change is committed: a request served in between would","-    # cache the row as it was before the change.","     cache: TTLCache = TTLCache(maxsize=1024, ttl=CACHE_TTL)","     # ``TTLCache`` is not thread-safe: requests read it on the event loop, while user updates pop","     # from it in threadpool and WSGI threads. Hold this lock for every access to ``cache``.","@@ -226,6 +224,17 @@ class FabAuthManager(BaseAuthManager[User]):","     flask_app: Flask | None = None","     _flask_app_lock = threading.Lock()"," ","+    @classmethod","+    def evict_cached_user(cls, user_id: int) -> None:","+        \"\"\"","+        Drop a user from the cache so that their next request reloads them from the database.","+","+        Call it only after the change to the user is committed: a request served in between would","+        cache the row as it was before the change.","+        \"\"\"","+        with cls.cache_lock:","+            cls.cache.pop(user_id, None)","+","     def init_flask_resources(self) -> None:","         self._sync_appbuilder_roles()"," "],"additions":11,"deletions":2,"truncated":false},{"path":"providers/fab/src/airflow/providers/fab/auth_manager/security_manager/override.py","lines":["@@ -1714,8 +1714,7 @@ def update_user(self, user: User) -> bool:","             return False","         from airflow.providers.fab.auth_manager.fab_auth_manager import FabAuthManager"," ","-        with FabAuthManager.cache_lock:","-            FabAuthManager.cache.pop(user.id, None)","+        FabAuthManager.evict_cached_user(user.id)","         return True"," ","     @staticmethod"],"additions":1,"deletions":2,"truncated":false