{"id":"07048440a6a055cf20187eb1683a17c855788adc","axis":"silent","repo":"facebookresearch/faiss","sha":"07048440a6a055cf20187eb1683a17c855788adc","parsed":{"files":[{"path":".github/workflows/build-pull-request.yml","lines":["@@ -76,6 +76,61 @@ jobs:","       - name: Build C++ demos","         run: |","           make -C build demo_diversity_result_handler","+  linux-x86_64-static-disk-ivf-cmake:","+    name: Linux x86_64 static DISK_IVF install (cmake)","+    needs: [linux-x86_64-cmake, changes]","+    if: ${{ needs.changes.outputs.has_cpu_changes == 'true' || github.event_name != 'pull_request' }}","+    runs-on: ubuntu-latest","+    steps:","+      - name: Checkout","+        uses: actions/checkout@v4","+      - name: Install dependencies","+        run: |","+          sudo apt-get -qq update","+          sudo apt-get -qq install -y libopenblas-dev libaio-dev","+      - name: Build and install a static Faiss with IndexIVFRaBitQSSD","+        run: |","+          cmake -B build \\","+                -DFAISS_ENABLE_DISK_IVF=ON \\","+                -DBUILD_SHARED_LIBS=OFF \\","+                -DFAISS_ENABLE_GPU=OFF \\","+                -DFAISS_ENABLE_PYTHON=OFF \\","+                -DFAISS_ENABLE_MKL=OFF \\","+                -DFAISS_ENABLE_EXTRAS=OFF \\","+                -DBUILD_TESTING=OFF \\","+                -DCMAKE_BUILD_TYPE=Release \\","+                -DCMAKE_INSTALL_PREFIX=\"$PWD/install\" \\","+                .","+          cmake --build build --target faiss -j$(nproc)","+          cmake --install build","+          # no libaio path of the build machine in the installed targets","+          ! grep -n \"/libaio\" install/share/faiss/faiss-targets*.cmake","+      - name: Build and run a program that uses the installed Faiss","+        run: |","+          # the installed package must bring libaio and OpenMP itself","+          mkdir consumer","+          cat > consumer/CMakeLists.txt <<'EOF'","+          cmake_minimum_required(VERSION 3.24)","+          project(faiss_consumer CXX)","+          find_package(faiss REQUIRED)","+          add_executable(consumer main.cpp)","+          target_link_libraries(consumer faiss)","+          EOF","+          cat > consumer/main.cpp <<'EOF'","+          #include <faiss/IndexFlat.h>","+          #include <faiss/IndexIVFRaBitQSSD.h>","+          #include <faiss/utils/utils.h>","+          #include <string>","+          int main() {","+              faiss::IndexFlatL2 quantizer(64);","+              faiss::IndexIVFRaBitQSSD index(&quantizer, 64, 4, 64, 4);","+              return faiss::get_compile_options().find(\"DISK_IVF\") ==","+                      std::string::npos;","+          }","+          EOF","+          cmake -B consumer/build -S consumer -DCMAKE_PREFIX_PATH=\"$PWD/install\"","+          cmake --build consumer/build","+          consumer/build/consumer","   linux-x86_64-AVX2-cmake:","     name: Linux x86_64 AVX2 (cmake)","     needs: [linux-x86_64-cmake, changes]"],"additions":55,"deletions":0,"truncated":false},{"path":"cmake/FindLibAIO.cmake","lines":["@@ -0,0 +1,23 @@","+# Copyright (c) Meta Platforms, Inc. and affiliates.","+#","+# This source code is licensed under the MIT license found in the","+# LICENSE file in the root directory of this source tree.","+","+# Finds libaio and defines the imported target LibAIO::LibAIO. Installed next","+# to faiss-config.cmake, which finds libaio with it for a static Faiss.","+","+find_path(LIBAIO_INCLUDE_DIR NAMES libaio.h)","+find_library(LIBAIO_LIBRARY NAMES aio)","+","+include(FindPackageHandleStandardArgs)","+find_package_handle_standard_args(LibAIO","+  REQUIRED_VARS LIBAIO_LIBRARY LIBAIO_INCLUDE_DIR)","+","+if(LibAIO_FOUND AND NOT TARGET LibAIO::LibAIO)","+  add_library(LibAIO::LibAIO UNKNOWN IMPORTED)","+  set_target_properties(LibAIO::LibAIO PROPERTIES","+    IMPORTED_LOCATION \"${LIBAIO_LIBRARY}\"","+    INTERFACE_INCLUDE_DIRECTORIES \"${LIBAIO_INCLUDE_DIR}\")","+endif()","+","+mark_as_advanced(LIBAIO_INCLUDE_DIR LIBAIO_LIBRARY)"],"additions":23,"deletions":0,"truncated":false},{"path":"cmake/faiss-config.cmake.in","lines":["@@ -4,4 +4,15 @@"," # This source code is licensed under the BSD-style license found in the"," # LICENSE file in the root directory of this source tree."," ","+# A static Faiss is linked with its private dependencies by the consumer.","+if(\"@FAISS_LIBRARY_TYPE@\" STREQUAL \"STATIC_LIBRARY\")","+  include(CMakeFindDependencyMacro)","+  find_dependency(OpenMP)","+  if(\"@FAISS_ENABLE_DISK_IVF@\")","+    list(PREPEND CMAKE_MODULE_PATH \"${CMAKE_CURRENT_LIST_DIR}\")","+    find_dependency(LibAIO)","+    list(POP_FRONT CMAKE_MODULE_PATH)","+  endif()","+endif()","+"," include(\"${CMAKE_CURRENT_LIST_DIR}/faiss-targets.cmake\")"],"additions":11,"deletions":0,"truncated":false},{"path":"faiss/CMakeLists.txt","lines":["@@ -483,7 +483,6 @@ endif()"," if(FAISS_ENABLE_DISK_IVF)","   list(APPEND FAISS_HEADERS","     IndexIVFRaBitQSSD.h","-    invlists/DiskIOBackend.h","     invlists/RaBitQSSDInvertedLists.h","   )"," endif()","@@ -723,11 +722,9 @@ if(FAISS_ENABLE_SVS)"," endif()"," "," if(FAISS_ENABLE_DISK_IVF)","-  find_path(LIBAIO_INCLUDE_DIR NAMES libaio.h REQUIRED)","-  find_library(LIBAIO_LIBRARY NAMES aio REQUIRED)","+  find_package(LibAIO REQUIRED)","   foreach(t faiss faiss_avx2 faiss_avx512 faiss_avx512_spr faiss_sve)","-    target_include_directories(${t} PRIVATE ${LIBAIO_INCLUDE_DIR})","-    target_link_libraries(${t} PUBLIC ${LIBAIO_LIBRARY})","+    target_link_libraries(${t} PRIVATE LibAIO::LibAIO)","   endforeach()"," endif()"," ","@@ -907,14 +904,22 @@ write_basic_package_version_file(","   COMPATIBILITY AnyNewerVersion"," )"," ","+# A static library leaves its private dependencies to the consumer's link:","+# faiss-config.cmake finds the ones that are imported targets.","+get_target_property(FAISS_LIBRARY_TYPE faiss TYPE)"," configure_file(${PROJECT_SOURCE_DIR}/cmake/faiss-config.cmake.in","   ${PROJECT_BINARY_DIR}/cmake/faiss-config.cmake","-  COPY