ore/Bundles/BundleFetcher.php',","         'OC\\\\App\\\\AppStore\\\\Bundles\\\\EducationBundle' => __DIR__ . '/../../..' . '/lib/private/App/AppStore/Bundles/EducationBundle.php',"],"additions":1,"deletions":0,"truncated":false},{"path":"lib/private/App/AppStore/AppStoreLinkVisibility.php","lines":["@@ -0,0 +1,45 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+namespace OC\\App\\AppStore;","+","+use OC\\Core\\AppInfo\\ConfigLexicon;","+use OCP\\IAppConfig;","+use OCP\\IConfig;","+use OCP\\Support\\Subscription\\IRegistry;","+","+/**","+ * Decides whether the app store link is offered to accounts without admin rights.","+ */","+class AppStoreLinkVisibility {","+\tpublic function __construct(","+\t\tprivate readonly IConfig $config,","+\t\tprivate readonly IAppConfig $appConfig,","+\t\tprivate readonly IRegistry $registry,","+\t) {","+\t}","+","+\t/**","+\t * An explicitly set value wins. Without one, a disabled app store or an","+\t * available subscription hides the link.","+\t */","+\tpublic function isShownToUsers(): bool {","+\t\tif (!$this->appConfig->hasKey('core', ConfigLexicon::APPSTORE_LINK_SHOWN)) {","+\t\t\tif (!$this->config->getSystemValueBool('appstoreenabled', true)) {","+\t\t\t\treturn false;","+\t\t\t}","+","+\t\t\tif ($this->registry->delegateHasValidSubscription()) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+","+\t\treturn $this->appConfig->getValueBool('core', ConfigLexicon::APPSTORE_LINK_SHOWN);","+\t}","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"lib/private/TemplateLayout.php","lines":["@@ -11,6 +11,7 @@"," namespace OC;"," "," use bantu\\IniGetWrapper\\IniGetWrapper;","+use OC\\App\\AppStore\\AppStoreLinkVisibility;"," use OC\\AppFramework\\Http\\Request;"," use OC\\Authentication\\Token\\IProvider;"," use OC\\Core\\AppInfo\\Application;","@@ -83,6 +84,7 @@ public function getPageTemplate(string $renderAs, string $appId): ITemplate {"," \t\t\t\t$this->initialState->provideInitialState('core', 'active-app', $this->navigationManager->getActiveEntry());"," \t\t\t\t$this->initialState->provideInitialState('core', 'apps', array_values($this->navigationManager->getAll()));"," \t\t\t\t$this->initialState->provideInitialState('core', 'navigationActions', array_values($this->navigationManager->getAll(INavigationManager::TYPE_ACTION)));","+\t\t\t\t$this->initialState->provideInitialState('core', 'appStoreLinkShown', Server::get(AppStoreLinkVisibility::class)->isShownToUsers());"," "," \t\t\t\t$this->initialState->provideInitialState('unified-search', 'min-search-length', $this->appConfig->getValueInt(Application::APP_ID, ConfigLexicon::UNIFIED_SEARCH_MIN_SEARCH_LENGTH));"," \t\t\t\tif ($this->config->getSystemValueBool('unified_search.enabled', false) || !$this->config->getSystemValueBool('enable_non-accessible_features', true)) {"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/lib/App/AppStore/AppStoreLinkVisibilityTest.php","lines":["@@ -0,0 +1,123 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+namespace Test\\App\\AppStore;","+","+use OC\\App\\AppStore\\AppStoreLinkVisibility;","+use OC\\Core\\AppInfo\\ConfigLexicon;","+use OCP\\Config\\Lexicon\\Entry;","+use OCP\\Config\\Lexicon\\Preset;","+use OCP\\IAppConfig;","+use OCP\\IConfig;","+use OCP\\Support\\Subscription\\IRegistry;","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\MockObject\\MockObject;","+use Test\\TestCase;","+","+class AppStoreLinkVisibilityTest extends TestCase {","+\tprivate IConfig&MockObject $config;","+\tprivate IAppConfig&MockObject $appConfig;","+\tprivate IRegistry&MockObject $registry;","+\tprivate AppStoreLinkVisibility $visibility;","+","+\t#[\\Override]","+\tprotected function setUp(): void {","+\t\tparent::setUp();","+","+\t\t$this->config = $this->createMock(IConfig::class);","+\t\t$this->appConfig = $this->createMock(IAppConfig::class);","+\t\t$this->registry = $this->createMock(IRegistry::class);","+","+\t\t$this->visibility = new AppStoreLinkVisibility(","+\t\t\t$this->config,","+\t\t\t$this->appConfig,","+\t\t\t$this->registry,","+\t\t);","+\t}","+","+\t/**","+\t * @param bool $stored whether an admin set the config key","+\t * @param bool $value the stored value, or the lexicon default when $stored is false","+\t */","+\tprivate function arrange(bool $stored, bool $value, bool $appStoreEnabled, bool $subscription): void {","+\t\t$this->appConfig->method('hasKey')","+\t\t\t->with('core', ConfigLexicon::APPSTORE_LINK_SHOWN)","+\t\t\t->willReturn($stored);","+\t\t$this->appConfig->method('getValueBool')","+\t\t\t->with('core', ConfigLexicon::APPSTORE_LINK_SHOWN)","+\t\t\t->willReturn($value);","+\t\t$this->config->method('getSystemValueBool')","+\t\t\t->with('appstoreenabled', true)","+\t\t\t->willReturn($appStoreEnabled);","+\t\t$this->registry->method('delegateHasValidSubscription')","+\t\t\t->willReturn($subscription);","+\t}","+","+\tpublic static function dataBool(): array {","+\t\treturn [","+\t\t\t'shown' => [true],","+\t\t\t'hidden' => [false],","+\t\t];","+\t}","+","+\t#[DataProvider('dataBool')]","+\tpublic function testStoredValueWinsOverSubscriptionAndDisabledAppStore(bool $stored): void {","+\t\t$this->arrange(stored: true, value: $stored, appStoreEnabled: false, subscription: true);","+","+\t\tself::assertSame($stored, $this->visibility->isShownToUsers());","+\t}","+","+\tpublic function testHiddenWhenAppStoreIsDisabled(): void {","+\t\t$this->arrange(stored: false, value: true, appStoreEnabled: false, subscription: false);","+","+\t\tself::assertFalse($this->visibility->isShownToUsers());","+\t}","+","+\tpublic function testHiddenWhenSubscriptionIsAvailable(): void {","+\t\t$this->arrange(stored: false, value: true, appStoreEnabled: true, subscription: true);","+","+\t\tself::assertFalse($this->visibility->isShownToUsers());","+\t}","+","+\t#[DataProvider('dataBool')]","+\tpublic function testUnstoredKeyReturnsTheLexiconDefault(bool $default): void {","+\t\t$this->arrange(stored: false, value: $default, appStoreEnabled: true, subscription: false);","+","+\t\tself::assertSame($default, $this->visibility->isShownToUsers());","+\t}","+","+\tpublic static function dataLexiconPreset(): array {","+\t\treturn [","+\t\t\t// Existing instances run without a preset and must keep the link.","+\t\t\t[Preset::NONE, '1'],","+\t\t\t[Preset::FAMILY, '1'],","+\t\t\t[Preset::UNIVERSITY, '0'],","+\t\t];","+\t}","+","+\t/**","+\t * The lexicon default {@see AppStoreLinkVisibility} falls back to is preset","+\t * dependent. A fresh entry is built per case because {@see Entry::getDefault()}","+\t * memoizes the first default it is asked for.","+\t */","+\t#[DataProvider('dataLexiconPreset')]","+\tpublic function testLexiconPresetDefault(Preset $preset, string $expected): void {","+\t\tself::assertSame($expected, $this->lexiconEntry()->getDefault($preset));","+\t}","+","+\tprivate function lexiconEntry(): Entry {","+\t\tforeach ((new ConfigLexicon())->getAppConfigs() as $entry) {","+\t\t\tif ($entry->getKey() === ConfigLexicon::APPSTORE_LINK_SHOWN) {","+\t\t\t\treturn $entry;","+\t\t\t}","+\t\t}","+","+\t\tself::fail('No lexicon entry for ' . ConfigLexicon::APPSTORE_LINK_SHOWN);","+\t}","+}"],"additions":123,"deletions":0,"truncated":false},{"path":"tests/playwright/e2e/core/admin-settings-appstore-link.spec.ts","lines":["@@ -0,0 +1,43 @@","+/*","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import { runOcc } from '@nextcloud/e2e-test-server'","+import { expect } from '@playwright/test'","+import { test as userTest } from '../../support/fixtures/random-user-session.ts'","+import { NavigationHeaderPage } from '../../support/sections/NavigationHeaderPage.ts'","+","+/**","+ * Set the app config key that decides whether the app store tile is offered.","+ *","+ * @param shown - Whether the tile should be offered","+ */","+async function setAppStoreLinkShown(shown: boolean): Promise<void> {","+\tawait runOcc(['config:app:set', 'core', 'appstore_link_shown', '--value', String(shown), '--type', 'boolean'])","+}","+","+// The `admin-settings-` prefix puts this in the serial project: it changes","+// instance-wide config. Both states are set explicitly because the test server","+// runs with `appstoreenabled` disabled, which hides the tile when the key is unset.","+userTest.describe('core: app store link visibility', () => {","+\tuserTest.afterAll(async () => {","+\t\tawait runOcc(['config:app:delete', 'core', 'appstore_link_shown'])","+\t})","+","+\tuserTest('offers the \"App store\" tile only while an admin allows it', async ({ page }) => {","+\t\tconst navigationHeader = new NavigationHeaderPage(page)","+\t\tconst appStoreTile = () => navigationHeader.navigationEntries().filter({ hasText: 'App store' })","+","+\t\tawait setAppStoreLinkShown(true)","+\t\tawait page.goto('/')","+\t\tawait navigationHeader.openMenu()","+\t\tawait expect(appStoreTile()).toBeVisible()","+","+\t\tawait setAppStoreLinkShown(false)","+\t\tawait page.goto('/')","+\t\tawait navigationHeader.openMenu()","+\t\tawait expect(navigationHeader.navigationEntries()).not.toHaveCount(0)","+\t\tawait expect(appStoreTile()).toHaveCount(0)","+\t})","+})",""],"additions":43,"deletions":0,"truncated":false}],"additions":283,"deletions":47,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-09-01T13:40:00.422336+00:00"}