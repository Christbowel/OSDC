ntains AWS credentials information.","+//","+// This is a copy of the AWS SDK v2 aws.Credentials struct:","+// https://pkg.go.dev/github.com/aws/aws-sdk-go-v2@v1.28.0/aws#Credentials","+//","+// It is declared as a type alias to an anonymous struct so that its field layout","+// matches aws.Credentials exactly. That lets us convert an aws.Credentials value","+// with a plain type conversion in Retrieve, while keeping this package's public","+// API free of any dependency on the AWS SDK's named type.","+type AWSCredentials = struct {","+\tAccessKeyID     string","+\tSecretAccessKey string","+\tSessionToken    string","+\tSource          string","+\tCanExpire       bool","+\tExpires         time.Time","+\tAccountID       string","+}","+","+// Retrieve returns the credentials.","+func (p *CredentialsProvider) Retrieve(ctx context.Context) (AWSCredentials, error) {","+\tcreds, err := p.provider.Retrieve(ctx)","+\treturn AWSCredentials(creds), err","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"ext/awsauth/doc.go","lines":["@@ -0,0 +1,37 @@","+// Copyright (C) MongoDB, Inc. 2017-present.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\"); you may","+// not use this file except in compliance with the License. You may obtain","+// a copy of the License at http://www.apache.org/licenses/LICENSE-2.0","+","+// This package allows credential providers in AWS SDK v2 to be supplied to the","+// MongoDB Go Driver for use with the MONGODB-AWS authentication mechanism.","+//","+// # Pre-release and unstable","+//","+// This module is pre-release software. Its API is unstable and may change in","+// backward-incompatible ways, or be removed entirely, without notice. It is not","+// yet covered by the MongoDB Go Driver's semantic-versioning guarantees. Pin an","+// exact version and review the changelog before upgrading.","+//","+// # No dependency on the Go Driver","+//","+// This module is a separate Go module that intentionally does not take a","+// dependency on the MongoDB Go Driver. Rather than importing the driver, it","+// adapts to the driver's options.AWSCredentialsProvider interface structurally:","+// the exported types in this package are defined to match that interface, so the","+// adapter satisfies it without an import.","+//","+// This decoupling exists for two reasons:","+//","+//   - It keeps the AWS SDK out of the main driver's dependency graph. Users who","+//     don't need AWS authentication never pull in the AWS SDK transitively.","+//   - It lets the two modules version independently and avoids a circular","+//     dependency between the driver and this adapter.","+//","+// NewCredentialsProvider() adapts an AWS CredentialsProvider to be used in:","+//","+//\tClientOptions","+//\tClientEncryptionOptions","+//\tAutoEncryptionOptions","+package awsauth"],"additions":37,"deletions":0,"truncated":false},{"path":"ext/awsauth/go.mod","lines":["@@ -0,0 +1,7 @@","+module go.mongodb.org/mongo-driver/ext/awsauth","+","+go 1.26","+","+require github.com/aws/aws-sdk-go-v2 v1.28.0","+","+require github.com/aws/smithy-go v1.20.2 // indirect"],"additions":7,"deletions":0,"truncated":false},{"path":"ext/awsauth/go.sum","lines":["@@ -0,0 +1,4 @@","+github.com/aws/aws-sdk-go-v2 v1.28.0 h1:ne6ftNhY0lUvlazMUQF15FF6NH80wKmPRFG7g2q6TCw=","+github.com/aws/aws-sdk-go-v2 v1.28.0/go.mod h1:ffIFB97e2yNsv4aTSGkqtHnppsIJzw7G7BReUZ3jCXM=","+github.com/aws/smithy-go v1.20.2 h1:tbp628ireGtzcHDDmLT/6ADHidqnwgF57XOXZe6tp4Q=","+github.com/aws/smithy-go v1.20.2/go.mod h1:krry+ya/rV9RDcV/Q16kpu6ypI4K2czasz0NC3qS14E="],"additions":4,"deletions":0,"truncated":false},{"path":"go.work","lines":["@@ -3,9 +3,11 @@ go 1.26.0"," use ("," \t."," \t./examples","+\t./ext/awsauth"," \t./internal/cmd/benchmark"," \t./internal/cmd/check-fmt"," \t./internal/cmd/faas/awslambda/mongodb","+\t./internal/test/awsauth"," \t./internal/test/compilecheck"," \t./internal/test/goleak"," )"],"additions":2,"deletions":0,"truncated":false},{"path":"internal/aws/credentials/credentials.go","lines":["@@ -24,10 +24,6 @@ import ("," // A Value is also used to represent Azure credentials."," // Azure credentials only consist of an access token, which is stored in the `SessionToken` field."," type Value struct {","-\t// The time the credentials will expire at. Should be ignored if CanExpire","-\t// is false.","-\tExpires time.Time","-"," \t// AWS Access key ID"," \tAccessKeyID string"," ","@@ -40,11 +36,15 @@ type Value struct {"," \t// Source of the credentials"," \tSource string"," ","-\t// The ID of the account for the credentials.","-\tAccountID string","-"," \t// States if the credentials can expire or not."," \tCanExpire bool","+","+\t// The time the credentials will expire at. Should be ignored if CanExpire","+\t// is false.","+\tExpires time.Time","+","+\t// The ID of the account for the credentials.","+\tAccountID string"," }"," "," // Expired returns if the credentials have expired."],"additions":7,"deletions":7,"truncated":false},{"path":"internal/credutil/aws_options_provider.go","lines":["@@ -0,0 +1,29 @@","+// Copyright (C) MongoDB, Inc. 2017-present.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\"); you may","+// not use this file except in compliance with the License. You may obtain","+// a copy of the License at http://www.apache.org/licenses/LICENSE-2.0","+","+package credutil","+","+import (","+\t\"context\"","+","+\t\"go.mongodb.org/mongo-driver/v2/internal/aws/credentials\"","+\t\"go.mongodb.org/mongo-driver/v2/mongo/options\"","+)","+","+// AWSOptionsProvider adapts options.AWSCredentialsProvider to the credentials.Provider","+// interface used internally by the driver.","+type AWSOptionsProvider struct {","+\tProvider options.AWSCredentialsProvider","+}","+","+// Retrieve returns the credentials from the wrapped options.AWSCredentialsProvider.","+func (p AWSOptionsProvider) Retrieve(ctx context.Context) (credentials.Value, error) {","+\tcreds, err := p.Provider.Retrieve(ctx)","+\tif err != nil {","+\t\treturn credentials.Value{}, err","+\t}","+\treturn credentials.Value(creds), nil","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"internal/integration/client_side_encryption_prose_26_test.go","lines":["@@ -0,0 +1,126 @@","+// Copyright (C) MongoDB, Inc. 2026-present.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\"); you may","+// not use this file except in compliance with the License. You may obtain","+// a copy of the License at http://www.apache.org/licenses/LICENSE-2.0","+","+//go:build cse","+","+package integration","+","+import (","+\t\"context\"","+\t\"os\"","+\t\"testing\"","+","+\t\"go.mongodb.org/mongo-driver/v2/bson\"","+\t\"go.mongodb.org/mongo-driver/v2/internal/integration/mtest\"","+\t\"go.mongodb.org/mongo-driver/v2/internal/integtest\"","+\t\"go.mongodb.org/mongo-driver/v2/internal/require\"","+\t\"go.mongodb.org/mongo-driver/v2/mongo\"","+\t\"go.mongodb.org/mongo-driver/v2/mongo/options\"","+)","+","+type awsCredentialsProvider struct {","+\tcnt int","+}","+","+func (p *awsCredentialsProvider) Retrieve(context.Context) (options.AWSCredentials, error) {","+\tp.cnt++","+\treturn options.AWSCredentials{","+\t\tAccessKeyID:     awsAccessKeyID,","+\t\tSecretAccessKey: awsSecretAccessKey,","+\t}, nil","+}","+","+func TestClientSideEncryptionProse_26_CustomAWS_Case1_CE_WithCredProvidersAndIncorrectKMSProviders(t *testing.T) {","+\topts := options.Client().ApplyURI(mtest.ClusterURI())","+\tintegtest.AddTestServerAPIVersion(opts)","+\tkeyVaultClient, err := mongo.Connect(opts)","+\trequire.NoErrorf(t, err, \"error on Connect: %v\", err)","+","+\tvar provider awsCredentialsProvider","+\tceo := options.ClientEncryption().","+\t\tSetKeyVaultNamespace(\"keyvault.datakeys\").","+\t\tSetKmsProviders(map[string]map[string]any{","+\t\t\t\"aws\": {","+\t\t\t\t\"accessKeyId\":     awsAccessKeyID,","+\t\t\t\t\"secretAccessKey\": awsSecretAccessKey,","+\t\t\t},","+\t\t}).","+\t\tSetAWSCredentialsProvider(&provider)","+\t_, err = mongo.NewClientEncryption(keyVaultClient, ceo)","+\trequire.ErrorContains(t, err, \"can only provide a custom AWS credential provider\",","+\t\t\"unexpected error: %v\", err)","+}","+","+func TestClientSideEncryptionProse_26_CustomAWS_Case2_CE_WithCredProviders(t *testing.T) {","+\topts := options.Client().ApplyURI(mtest.ClusterURI())","+\tintegtest.AddTestServerAPIVersion(opts)","+\tkeyVaultClient, err := mongo.Connect(opts)","+\trequire.NoErrorf(t, err, \"error on Connect: %v\", err)","+","+\tvar provider awsCredentialsProvider","+\tceo := options.ClientEncryption().","+\t\tSetKeyVaultNamespace(\"keyvault.datakeys\").","+\t\tSetKmsProviders(map[string]map[string]any{","+\t\t\t\"aws\": {},","+\t\t}).","+\t\tSetAWSCredentialsProvider(&provider)","+\tclientEncryption, err := mongo.NewClientEncryption(keyVaultClient, ceo)","+\trequire.NoErrorf(t, err, \"error on NewClientEncryption: %v\", err)","+","+\tdkOpts := options.DataKey().SetMasterKey(bson.D{","+\t\t{\"region\", \"us-east-1\"},","+\t\t{\"key\", \"arn:aws:kms:us-east-1:579766882180:key/89fcc2c4-08b0-4bd9-9f25-e30687b580d0\"},","+\t})","+\t_, err = clientEncryption.CreateDataKey(context.Background(), \"aws\", dkOpts)","+\trequire.NoErrorf(t, err, \"unexpected error %v\", err)","+\trequire.GreaterOrEqual(t, provider.cnt, 1, \"expected credential provider to be called once\")","+}","+","+func TestClientSideEncryptionProse_26_CustomAWS_Case3_AE_WithCredProvidersAndIncorrectKMSProviders(t *testing.T) {","+\tvar provider awsCredentialsProvider","+\taeo := options.AutoEncryption().","+\t\tSetKeyVaultNamespace(\"keyvault.datakeys\").","+\t\tSetKmsProviders(map[string]map[string]any{","+\t\t\t\"aws\": {","+\t\t\t\t\"accessKeyId\":     awsAccessKeyID,","+\t\t\t\t\"secretAccessKey\": awsSecretAccessKey,","+\t\t\t},","+\t\t}).","+\t\tSetAWSCredentialsProvider(&provider)","+\tco := options.Client().SetAutoEncryptionOptions(aeo).ApplyURI(mtest.ClusterURI())","+\tintegtest.AddTestServerAPIVersion(co)","+\t_, err := mongo.Connect(co)","+\trequire.ErrorContainsf(t, err, \"can only provide a custom AWS credential provider\",","+\t\t\"unexpected error: %v\", err)","+}","+","+func TestClientSideEncryptionProse_26_CustomAWS_Case4_CE_WithCredProvidersAndEnvVars(t *testing.T) {","+\tt.Setenv(\"AWS_ACCESS_KEY_ID\", os.Getenv(\"FLE_AWS_ACCESS_KEY_ID\"))","+\tt.Setenv(\"AWS_SECRET_ACCESS_KEY\", os.Getenv(\"FLE_AWS_SECRET_ACCESS_KEY\"))","+","+\topts := options.Client().ApplyURI(mtest.ClusterURI())","+\tintegtest.AddTestServerAPIVersion(opts)","+\tkeyVaultClient, err := mongo.Connect(opts)","+\trequire.NoErrorf(t, err, \"error on Connect: %v\", err)","+","+\tvar provider awsCredentialsProvider","+\tceo := options.ClientEncryption().","+\t\tSetKeyVaultNamespace(\"keyvault.datakeys\").","+\t\tSetKmsProviders(map[string]map[string]any{","+\t\t\t\"aws\": {},","+\t\t}).","+\t\tSetAWSCredentialsProvider(&provider)","+\tclientEncryption, err := mongo.NewClientEncryption(keyVaultClient, ceo)","+\trequire.NoErrorf(t, err, \"error on NewClientEncryption: %v\", err)","+","+\tdkOpts := options.DataKey().SetMasterKey(bson.D{","+\t\t{\"region\", \"us-east-1\"},","+\t\t{\"key\", \"arn:aws:kms:us-east-1:579766882180:key/89fcc2c4-08b0-4bd9-9f25-e30687b580d0\"},","+\t})","+\t_, err = clientEncryption.CreateDataKey(context.Background(), \"aws\", dkOpts)","+\trequire.NoErrorf(t, err, \"unexpected error %v\", err)","+\trequire.GreaterOrEqual(t, provider.cnt, 1, \"expected credential provider to be called once\")","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"internal/test/aws/aws_test.go","lines":["@@ -13,12 +13,73 @@ import ("," \t\"testing\""," "," \t\"go.mongodb.org/mongo-driver/v2/bson\"","+\t\"go.mongodb.org/mongo-driver/v2/internal/assert\""," \t\"go.mongodb.org/mongo-driver/v2/internal/require\""," \t\"go.mongodb.org/mongo-driver/v2/mongo\""," \t\"go.mongodb.org/mongo-driver/v2/mongo/options\""," )"," ","+// staticAWSProvider returns fixed credentials on every call.","+type staticAWSProvider struct {","+\tcreds options.AWSCredentials","+}","+","+func (p *staticAWSProvider) Retrieve(_ context.Context) (options.AWSCredentials, error) {","+\treturn p.creds, nil","+}","+","+// trackingAWSProvider wraps another provider and counts invocations.","+type trackingAWSProvider struct {","+\tinner  options.AWSCredentialsProvider","+\tcalled int","+}","+","+func (p *trackingAWSProvider) Retrieve(ctx context.Context) (options.AWSCredentials, error) {","+\tp.called++","+\treturn p.inner.Retrieve(ctx)","+}","+","+// requireAWSAuthSupport skips t if the server at the given URI does not support","+// MONGODB-AWS (introduced in MongoDB 4.4, maxWireVersion 9). The check is performed","+// without auth so that it works even when the URI carries AWS credentials.","+// The original URI's TLS and topology settings are preserved so that the probe","+// connection is valid on TLS-required servers.","+func requireAWSAuthSupport(t *testing.T, rawURI string) {","+\tt.Helper()","+\t// Reuse all options from the original URI (TLS, replica set, etc.) but clear","+\t// auth so hello can be sent without triggering AWS credential negotiation.","+\tcheckOpts := options.Client().ApplyURI(rawURI)","+\tcheckOpts.Auth = nil","+\tclient, err := mongo.Connect(checkOpts)","+\tif err != nil {","+\t\treturn // cannot probe; let the real connection surface any error","+\t}","+\tdefer func() { _ = client.Disconnect(context.Background()) }()","+","+\tvar result struct {","+\t\tMaxWireVersion int32 `bson:\"maxWireVersion\"`","+\t}","+\tif err := client.Database(\"admin\").RunCommand(context.Background(), bson.D{{Key: \"hello\", Value: 1}}).Decode(&result); err != nil {","+\t\treturn","+\t}","+\tif result.MaxWireVersion < 9 {","+\t\tt.Skip(\"MONGODB-AWS requires MongoDB 4.4+ (maxWireVersion 9)\")","+\t}","+}","+","+func awsFindOne(t *testing.T, client *mongo.Client) {","+\tt.Helper()","+\terr := client.Database(\"aws\").Collection(\"test\").FindOne(context.Background(), bson.D{{Key: \"x\", Value: 1}}).Err()","+\tif err != nil && !errors.Is(err, mongo.ErrNoDocuments) {","+\t\tt.Fatalf(\"unexpected FindOne error: %v\", err)","+\t}","+}","+"," func TestAWS(t *testing.T) {","+\tif os.Getenv(\"AWS_TEST\") == \"\" {","+\t\tt.Skip(\"Skipping test: AWS_TEST environment variable is not set\")","+\t}","+"," \turi := os.Getenv(\"MONGODB_URI\")"," \tif uri == \"\" {"," \t\tt.Skip(\"Skipping test: MONGODB_URI environment variable is not set\")","@@ -31,10 +92,110 @@ func TestAWS(t *testing.T) {"," \t\trequire.NoError(t, err)"," \t}()"," ","-\tcoll := client.Database(\"aws\").Collection(\"test\")","+\tawsFindOne(t, client)","+}"," ","-\terr = coll.FindOne(context.Background(), bson.D{{Key: \"x\", Value: 1}}).Err()","-\tif err != nil && !errors.Is(err, mongo.ErrNoDocuments) {","-\t\tt.Logf(\"FindOne error: %v\", err)","+// Custom Credential Provider Authenticates","+//","+// Scenarios where MONGODB_URI contains no inline credentials (EC2, ECS, WebIdentity)","+// are skipped because a valid custom provider for those environments requires the AWS","+// SDK, which is not available in this module.","+func TestAWSCustomCredentialProviderAuthenticates(t *testing.T) {","+\tif os.Getenv(\"AWS_TEST\") == \"\" {","+\t\tt.Skip(\"Skipping test: AWS_TEST environment variable is not set\")","+\t}","+","+\trawURI := os.Getenv(\"MONGODB_URI\")","+\tif rawURI == \"\" {","+\t\tt.Skip(\"MONGODB_URI not set\")","+\t}","+","+\t// Extract inline credentials from the URI, if any. For scenarios where the CI","+\t// tooling embeds credentials in the URI (Regular, AssumeRole, Lambda), we return","+\t// them directly from the custom provider rather than using the AWS SDK default","+\t// provider, per the spec allowance.","+\tparsedOpts := options.Client().ApplyURI(rawURI)","+\tif parsedOpts.Auth == nil || parsedOpts.Auth.Username == \"\" {","+\t\tt.Skip(\"no inline credentials in MONGODB_URI; scenario requires AWS SDK default provider\")","+\t}","+\trequireAWSAuthSupport(t, rawURI)","+","+\tcreds := options.AWSCredentials{","+\t\tAccessKeyID:     parsedOpts.Auth.Username,","+\t\tSecretAccessKey: parsedOpts.Auth.Password,","+\t}","+\tif parsedOpts.Auth.AuthMechanismProperties != nil {","+\t\tcreds.SessionToken = parsedOpts.Auth.AuthMechanismProperties[\"AWS_SESSION_TOKEN\"]"," \t}","+","+\ttracking := &trackingAWSProvider{inner: &staticAWSProvider{creds: creds}}","+","+\tclient, err := mongo.Connect(","+\t\toptions.Client().","+\t\t\tApplyURI(rawURI).","+\t\t\tSetAuth(options.Credential{","+\t\t\t\tAuthMechanism:          \"MONGODB-AWS\",","+\t\t\t\tAWSCredentialsProvider: tracking,","+\t\t\t}),","+\t)","+\trequire.NoError(t, err)","+\tdefer func() { require.NoError(t, client.Disconnect(context.Background())) }()","+","+\tawsFindOne(t, client)","+\tassert.Greater(t, tracking.called, 0, \"expected custom credential provider to be called at least once\")","+}","+","+// Custom Credential Provider Authentication Precedence — Custom Provider Takes","+// Precedence Over Environment Variables","+func TestAWSCustomCredentialProviderPrecedence(t *testing.T) {","+\tif os.Getenv(\"AWS_TEST\") == \"\" {","+\t\tt.Skip(\"Skipping test: AWS_TEST environment variable is not set\")","+\t}","+","+\tt.Setenv(\"AWS_ACCESS_KEY_ID\", \"AWS_ACCESS_KEY_ID\")","+\tt.Setenv(\"AWS_SECRET_ACCESS_KEY\", \"AWS_SECRET_ACCESS_KEY\")","+","+\trawURI := os.Getenv(\"MONGODB_URI\")","+\tif rawURI == \"\" {","+\t\tt.Skip(\"MONGODB_URI not set\")","+\t}","+\t// Ensure the URI targets a server configured for MONGODB-AWS; without this","+\t// guard the test runs (and fails) on any 4.4+ server where AWS env vars","+\t// happen to be set in the developer's shell.","+\tif uriOpts := options.Client().ApplyURI(rawURI); uriOpts.Auth == nil ||","+\t\turiOpts.Auth.AuthMechanism != \"MONGODB-AWS\" {","+\t\tt.Skip(\"MONGODB_URI does not specify MONGODB-AWS authentication mechanism\")","+\t}","+\trequireAWSAuthSupport(t, rawURI)","+","+\t// Populate the custom provider with the valid inline credentials from the URI","+\t// so that auth actually succeeds via the provider. The bogus AWS_ACCESS_KEY_ID","+\t// and AWS_SECRET_ACCESS_KEY env vars set above would fail if the driver fell","+\t// back to the environment-variable provider, so a successful query proves the","+\t// custom provider took precedence.","+\turiOpts := options.Client().ApplyURI(rawURI)","+\tcreds := options.AWSCredentials{","+\t\tAccessKeyID:     uriOpts.Auth.Username,","+\t\tSecretAccessKey: uriOpts.Auth.Password,","+\t}","+\tif uriOpts.Auth.AuthMechanismProperties != nil {","+\t\tcreds.SessionToken = uriOpts.Auth.AuthMechanismProperties[\"AWS_SESSION_TOKEN\"]","+\t}","+\ttracking := &trackingAWSProvider{inner: &staticAWSProvider{creds: creds}}","+","+\t// SetAuth overrides any inline credentials that ApplyURI may have parsed from the","+\t// URI, so the chain is: custom provider -> env-var provider.","+\tclient, err := mongo.Connect(","+\t\toptions.Client().","+\t\t\tApplyURI(rawURI).","+\t\t\tSetAuth(options.Credential{","+\t\t\t\tAuthMechanism:          \"MONGODB-AWS\",","+\t\t\t\tAWSCredentialsProvider: tracking,","+\t\t\t}),","+\t)","+\trequire.NoError(t, err)","+\tdefer func() { require.NoError(t, client.Disconnect(context.Background())) }()","+","+\tawsFindOne(t, client)","+\tassert.Greater(t, tracking.called, 0, \"expected custom credential provider to be called at least once\")"," }"],"additions":165,"deletions":4,"truncated":false},{"path":"internal/test/awsauth/aws_test.go","lines":["@@ -0,0 +1,89 @@","+// Copyright (C) MongoDB, Inc. 2025-present.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\"); you may","+// not use this file except in compliance with the License. You may obtain","+// a copy of the License at http://www.apache.org/licenses/LICENSE-2.0","+","+package main","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"os\"","+\t\"testing\"","+","+\t\"github.com/aws/aws-sdk-go-v2/config\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.mongodb.org/mongo-driver/ext/awsauth\"","+\t\"go.mongodb.org/mongo-driver/v2/bson\"","+\t\"go.mongodb.org/mongo-driver/v2/mongo\"","+\t\"go.mongodb.org/mongo-driver/v2/mongo/options\"","+)","+","+// trackingCredentialsProvider wraps an options.AWSCredentialsProvider and counts calls.","+type trackingCredentialsProvider struct {","+\tinner  options.AWSCredentialsProvider","+\tcalled int","+}","+","+func (p *trackingCredentialsProvider) Retrieve(ctx context.Context) (awsauth.AWSCredentials, error) {","+\tp.called++","+\treturn p.inner.Retrieve(ctx)","+}","+","+// TestAWSDefaultCustomCredentialProviderAuthenticates is prose test 1:","+// \"Custom Credential Provider Authenticates\" from the MongoDB AWS auth spec.","+// https://github.com/mongodb/specifications/blob/master/source/auth/tests/mongodb-aws.md","+//","+// Uses the AWS SDK default credential chain so EC2, ECS, WebIdentity, Lambda are","+// covered in environments where the SDK can resolve credentials automatically","+// without needing inline credentials in the URI. Regular/AssumeRole are covered","+// separately.","+func TestAWSDefaultCustomCredentialProviderAuthenticates(t *testing.T) {","+\t// The \"assume-role\" and \"regular\" scenarios are intentionally skipped. This","+\t// test exercises the AWS SDK default credential chain and calls SetAuth,","+\t// which overrides any inline credentials ApplyURI extracted from the URI.","+\t// Those two scenarios provide credentials inline in MONGODB_URI, which the","+\t// default chain cannot resolve on its own, so this default-chain approach","+\t// does not apply to them. They are instead covered in","+\t// internal/test/aws/aws_test.go, which runs alongside this test via","+\t// etc/run-mongodb-aws-test.sh.","+\tif test := os.Getenv(\"AWS_TEST\"); test == \"assume-role\" || test == \"regular\" {","+\t\tt.Skipf(\"Skipping test for %s\", test)","+\t}","+","+\trawURI := os.Getenv(\"MONGODB_URI\")","+\tif rawURI == \"\" {","+\t\tt.Skip(\"MONGODB_URI not set\")","+\t}","+","+\tcfg, err := config.LoadDefaultConfig(context.Background())","+\trequire.NoError(t, err, \"failed to load AWS config\")","+","+\ttracking := &trackingCredentialsProvider{","+\t\tinner: awsauth.NewCredentialsProvider(cfg.Credentials),","+\t}","+","+\t// SetAuth overrides any inline credentials that ApplyURI may have extracted","+\t// from the URI; the AWS SDK default chain provides credentials instead.","+\tclient, err := mongo.Connect(","+\t\toptions.Client().","+\t\t\tApplyURI(rawURI).","+\t\t\tSetAuth(options.Credential{","+\t\t\t\tAuthMechanism:          \"MONGODB-AWS\",","+\t\t\t\tAWSCredentialsProvider: tracking,","+\t\t\t}),","+\t)","+\trequire.NoError(t, err, \"failed to connect\")","+\tdefer func() {"],"additions":78,"deletions":0,"truncated":false}],"additions":608,"deletions":12,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-08-01T09:54:04.447588+00:00"}