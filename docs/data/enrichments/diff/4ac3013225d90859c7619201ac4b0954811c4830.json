{"id":"4ac3013225d90859c7619201ac4b0954811c4830","axis":"silent","repo":"wolfSSL/wolfssl","sha":"4ac3013225d90859c7619201ac4b0954811c4830","parsed":{"files":[{"path":"doc/dox_comments/header_files/cryptocb.h","lines":["@@ -422,14 +422,41 @@ int wc_CryptoCb_Ed25519MakePub(ed25519_key* key, byte* pubKey,"," */"," int wc_CryptoCb_Ed25519CheckKey(ed25519_key* key);"," ","+/*!","+    \\ingroup CryptoCb","+","+    \\brief Offload Ed448 key generation to a CryptoCB device.","+","+    Used by wc_ed448_make_key. The device receives wc_CryptoInfo.pk.ed448kg","+    (\\c rng, \\c size, \\c key). On success it stores the private key followed","+    by the public key in key->k, the public key in key->p, and sets","+    key->privKeySet and key->pubKeySet. For a key bound by id or label, the","+    device may keep the private key and leave key->k and key->privKeySet","+    clear. No make-public callback follows a device-generated key.","+","+    \\param rng     random number generator for the device to use","+    \\param keySize private key size, ED448_KEY_SIZE","+    \\param key     Ed448 key providing the device id, receives the new key","+","+    \\return 0 on success","+    \\return CRYPTOCB_UNAVAILABLE if no device handles the operation (wolfCrypt","+            falls back to software key generation)","+    \\return other negative values are device errors, returned to the caller","+            without a software fallback","+","+    \\sa wc_CryptoCb_RegisterDevice","+    \\sa wc_ed448_make_key","+*/","+int wc_CryptoCb_Ed448Gen(WC_RNG* rng, int keySize, ed448_key* key);","+"," /*!","     \\ingroup CryptoCb"," ","     \\brief Offload deriving an Ed448 public key from its private key to a","     CryptoCB device."," ","-    Used by wc_ed448_make_public (and so by key generation and private-key","-    import). The device writes the compressed public key into","+    Used by wc_ed448_make_public (and so by software key generation and","+    private-key import). The device writes the compressed public key into","     wc_CryptoInfo.pk.ed448makepub (\\c pubOut / \\c pubOutSz, always","     ED448_PUB_KEY_SIZE)."," "],"additions":29,"deletions":2,"truncated":false},{"path":"tests/api/test_ed448.c","lines":["@@ -2046,3 +2046,82 @@ int test_wc_ed448_make_public_dev_key(void)"," #endif","     return EXPECT_RESULT();"," } /* END test_wc_ed448_make_public_dev_key */","+","+#if defined(HAVE_ED448) && defined(WOLF_CRYPTO_CB) && !defined(WC_NO_RNG) && \\","+    !defined(HAVE_FIPS)","+typedef struct ed448DevKgCtx {","+    int decline;","+    int calls;","+    int makePubCalls;","+} ed448DevKgCtx;","+","+/* Device that fails key generation unless told to decline it. */","+static int ed448_dev_kg_cb(int devIdArg, wc_CryptoInfo* info, void* ctx)","+{","+    ed448DevKgCtx* dev = (ed448DevKgCtx*)ctx;","+","+    (void)devIdArg;","+","+    if (info->algo_type != WC_ALGO_TYPE_PK) {","+        return WC_NO_ERR_TRACE(CRYPTOCB_UNAVAILABLE);","+    }","+    if (info->pk.type == WC_PK_TYPE_ED448_MAKE_PUB) {","+        dev->makePubCalls++;","+        return WC_NO_ERR_TRACE(CRYPTOCB_UNAVAILABLE);","+    }","+    if (info->pk.type != WC_PK_TYPE_ED448_KEYGEN) {","+        return WC_NO_ERR_TRACE(CRYPTOCB_UNAVAILABLE);","+    }","+    dev->calls++;","+    if (dev->decline) {","+        return WC_NO_ERR_TRACE(CRYPTOCB_UNAVAILABLE);","+    }","+    return WC_NO_ERR_TRACE(WC_HW_E);","+}","+#endif","+","+/*","+ * Testing wc_ed448_make_key() with a device that fails or declines keygen.","+ */","+int test_wc_ed448_make_key_dev_error(void)","+{","+    EXPECT_DECLS;","+#if defined(HAVE_ED448) && defined(WOLF_CRYPTO_CB) && !defined(WC_NO_RNG) && \\","+    !defined(HAVE_FIPS)","+    int devId = 4481;","+    ed448DevKgCtx dev;","+    WC_RNG rng;","+    ed448_key key;","+","+    XMEMSET(&dev, 0, sizeof(dev));","+    XMEMSET(&rng, 0, sizeof(rng));","+    XMEMSET(&key, 0, sizeof(key));","+","+    ExpectIntEQ(wc_CryptoCb_RegisterDevice(devId, ed448_dev_kg_cb, &dev), 0);","+    ExpectIntEQ(wc_InitRng(&rng), 0);","+","+    ExpectIntEQ(wc_ed448_init_ex(&key, HEAP_HINT, devId), 0);","+    ExpectIntEQ(wc_ed448_make_key(&rng, ED448_KEY_SIZE, &key),","+        WC_NO_ERR_TRACE(WC_HW_E));","+    ExpectIntEQ(dev.calls, 1);","+    ExpectIntEQ(dev.makePubCalls, 0);","+    ExpectIntEQ(key.privKeySet, 0);","+    ExpectIntEQ(key.pubKeySet, 0);","+    wc_ed448_free(&key);","+","+    /* Declined by the device, software generates the key. */","+    dev.decline = 1;","+    ExpectIntEQ(wc_ed448_init_ex(&key, HEAP_HINT, devId), 0);","+    ExpectIntEQ(wc_ed448_make_key(&rng, ED448_KEY_SIZE, &key), 0);","+    ExpectIntEQ(dev.calls, 2);","+    ExpectIntEQ(dev.makePubCalls, 1);","+    ExpectIntEQ(key.privKeySet, 1);","+    ExpectIntEQ(key.pubKeySet, 1);","+    ExpectIntEQ(wc_ed448_check_key(&key), 0);","+    wc_ed448_free(&key);","+","+    DoExpectIntEQ(wc_FreeRng(&rng), 0);","+    wc_CryptoCb_UnRegisterDevice(devId);","+#endif","+    return EXPECT_RESULT();","+} /* END test_wc_ed448_make_key_dev_error */"],"additions":79,"deletions":0,"truncated":false},{"path":"tests/api/test_ed448.h","lines":["@@ -49,6 +49,7 @@ int test_wc_ed448_import_private_only(void);"," int test_wc_ed448_check_key_decisions(void);"," int test_wc_ed448_cryptocb(void);"," int test_wc_ed448_make_public_dev_key(void);","+int test_wc_ed448_make_key_dev_error(void);"," "," #define TEST_ED448_DECLS                                          \\","     TEST_DECL_GROUP(\"ed448\", test_wc_ed448_make_key),             \\","@@ -75,6 +76,7 @@ int test_wc_ed448_make_public_dev_key(void);","     TEST_DECL_GROUP(\"ed448\", test_wc_ed448_check_key_decisions),  \\","     TEST_DECL_GROUP(\"ed448\", test_wc_Ed448PrivateKeyDecode_ex),   \\","     TEST_DECL_GROUP(\"ed448\", test_wc_ed448_cryptocb),             \\","-    TEST_DECL_GROUP(\"ed448\", test_wc_ed448_make_public_dev_key)","+    TEST_DECL_GROUP(\"ed448\", test_wc_ed448_make_public_dev_key),  \\","+    TEST_DECL_GROUP(\"ed448\", test_wc_ed448_make_key_dev_error)"," "," 