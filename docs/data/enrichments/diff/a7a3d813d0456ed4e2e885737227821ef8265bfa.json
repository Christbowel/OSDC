slices.ContainsFunc(slices.Collect(maps.Keys(cfg.Plugins)), func(id string) bool {","+\t\treturn strings.HasPrefix(id, string(plugins.ServerPlugin)+\".\")","+\t})","+\tif serverSettings || !reflect.ValueOf(ignored).IsZero() {","+\t\tlog.G(ctx).WithField(\"dir\", dir).Warn(\"embedded containerd ignores server and process settings in config drop-ins; only plugin, disabled_plugins, and required_plugins settings apply\")","+\t}","+\treturn cfg, nil","+}","+","+// configDropInFiles returns the containerd configuration files (*.toml) in","+// dir, in lexical order.","+// A missing directory has no files.","+// Files with a configuration version older than 4 or non-empty imports are","+// rejected.","+func configDropInFiles(dir string) ([]string, error) {","+\tentries, err := os.ReadDir(dir)","+\tif errors.Is(err, os.ErrNotExist) {","+\t\treturn nil, nil","+\t}","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to find containerd config drop-ins: %w\", err)","+\t}","+\tvar files []string","+\tfor _, entry := range entries {","+\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".toml\") {","+\t\t\tcontinue","+\t\t}","+\t\tpath := filepath.Join(dir, entry.Name())","+\t\tdata, err := os.ReadFile(path)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"failed to read containerd config drop-in %q: %w\", path, err)","+\t\t}","+\t\tvar dropIn struct {","+\t\t\tVersion int      `toml:\"version\"`","+\t\t\tImports []string `toml:\"imports\"`","+\t\t}","+\t\tif err := toml.Unmarshal(data, &dropIn); err != nil {","+\t\t\treturn nil, fmt.Errorf(\"failed to parse containerd config drop-in %q: %w\", path, err)","+\t\t}","+\t\t// Drop-ins have no legacy files to support, so require the configuration","+\t\t// version introduced in containerd 2.3 instead of relying on migrations","+\t\t// of older versions, including a missing version being treated as 1.","+\t\tif dropIn.Version < 4 {","+\t\t\treturn nil, fmt.Errorf(\"containerd config drop-in %q must set version 4 or later\", path)","+\t\t}","+\t\t// Keep the merge order defined only by the lexical order of the files","+\t\t// in the directory.","+\t\tif len(dropIn.Imports) != 0 {","+\t\t\treturn nil, fmt.Errorf(\"containerd config drop-in %q must not contain imports\", path)","+\t\t}","+\t\tfiles = append(files, path)","+\t}","+\treturn files, nil","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"daemon/internal/containerd/server/embedded/dropin_test.go","lines":["@@ -0,0 +1,109 @@","+//go:build (linux || windows) && !no_embedded_containerd","+","+package embedded","+","+import (","+\t\"os\"","+\t\"path/filepath\"","+\t\"strconv\"","+\t\"testing\"","+","+\tsrvconfig \"github.com/containerd/containerd/v2/cmd/containerd/server/config\"","+\t\"github.com/containerd/plugin\"","+\t\"gotest.tools/v3/assert\"","+\tis \"gotest.tools/v3/assert/cmp\"","+)","+","+func TestConfigDropInsConfigurePlugins(t *testing.T) {","+\tt.Parallel()","+","+\t// Brackets must not be interpreted as a glob pattern.","+\tdir := filepath.Join(t.TempDir(), \"docker[prod]\")","+\terr := os.Mkdir(dir, 0o755)","+\tassert.NilError(t, err)","+\terr = os.WriteFile(filepath.Join(dir, \"10-custom.toml\"), []byte(`","+version = 4","+","+[plugins.\"io.moby.test.v1.configured\"]","+  value = \"from-drop-in\"","+`), 0o644)","+\tassert.NilError(t, err)","+","+\tcontainerdConfig, err := loadConfigDropIns(t.Context(), dir)","+\tassert.NilError(t, err)","+","+\ttype testConfig struct {","+\t\tValue string `toml:\"value\"`","+\t}","+\tvar got any","+\tcfg := &serverConfig{","+\t\troot:       filepath.Join(t.TempDir(), \"root\"),","+\t\tstate:      filepath.Join(t.TempDir(), \"state\"),","+\t\tcontainerd: containerdConfig,","+\t}","+\tserver, err := newServerWithRegistrations(t.Context(), cfg, []plugin.Registration{{","+\t\tType:   \"io.moby.test.v1\",","+\t\tID:     \"configured\",","+\t\tConfig: &testConfig{Value: \"default\"},","+\t\tInitFn: func(initContext *plugin.InitContext) (any, error) {","+\t\t\tgot = initContext.Config","+\t\t\treturn struct{}{}, nil","+\t\t},","+\t}})","+\tassert.NilError(t, err)","+\tserver.Stop()","+\tassert.Check(t, is.DeepEqual(got, &testConfig{Value: \"from-drop-in\"}))","+}","+","+func TestConfigDropInsRequireMissingPlugin(t *testing.T) {","+\tt.Parallel()","+","+\tcfg := &serverConfig{","+\t\troot:  filepath.Join(t.TempDir(), \"root\"),","+\t\tstate: filepath.Join(t.TempDir(), \"state\"),","+\t\tcontainerd: srvconfig.Config{","+\t\t\tRequiredPlugins: []string{\"io.moby.test.v1.missing\"},","+\t\t},","+\t}","+\tserver, err := newServerWithRegistrations(t.Context(), cfg, nil)","+\tassert.Check(t, is.Nil(server))","+\tassert.Check(t, is.ErrorContains(err, \"required plugins not loaded: io.moby.test.v1.missing\"))","+}","+","+func TestConfigDropInsRejectInvalidFiles(t *testing.T) {","+\tt.Parallel()","+","+\ttests := []struct {","+\t\tname    string","+\t\tcontent string","+\t\texpErr  string","+\t}{","+\t\t{","+\t\t\tname: \"imports\",","+\t\t\tcontent: `","+version = 4","+imports = [\"nested.conf\"]","+`,","+\t\t\texpErr: \"must not contain imports\",","+\t\t},","+\t\t{","+\t\t\tname:    \"legacy version\",","+\t\t\tcontent: `version = 3`,","+\t\t\texpErr:  \"must set version 4 or later\",","+\t\t},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\tdir := t.TempDir()","+\t\t\tdropInFile := filepath.Join(dir, \"10-custom.toml\")","+\t\t\terr := os.WriteFile(dropInFile, []byte(tc.content), 0o644)","+\t\t\tassert.NilError(t, err)","+","+\t\t\t_, err = loadConfigDropIns(t.Context(), dir)","+\t\t\tassert.ErrorContains(t, err, tc.expErr)","+\t\t\tassert.ErrorContains(t, err, strconv.Quote(dropInFile))","+\t\t})","+\t}","+}"],"additions":109,"deletions":0,"truncated":false},{"path":"daemon/internal/containerd/server/embedded/embedded_test.go","lines":["@@ -21,7 +21,7 @@ func TestPluginGraphResolves(t *testing.T) {"," \tctx, cancel := context.WithCancel(t.Context())"," \tdefer c