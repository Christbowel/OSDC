ort]))),","+        ]))->dispatch(new DummyMessage('Hello'));","+","+        $handled = [];","+        $bus = new MessageBus([","+            new FlowContextMiddleware(true),","+            new HandleMessageMiddleware(new HandlersLocator([DummyMessage::class => [static function (DummyMessage $message, Envelope $envelope) use (&$handled) {","+                $handled[] = $envelope;","+            }]])),","+        ]);","+        $dispatcher = new EventDispatcher();","+        $dispatcher->addSubscriber(new StopWorkerOnIdleListener());","+        (new Worker(['orders' => $transport], $bus, $dispatcher))->run();","+","+        $this->assertCount(1, $handled);","+        $this->assertSame($sent->last(MessageIdStamp::class)->getId(), $handled[0]->last(MessageIdStamp::class)?->getId());","+        $this->assertSame($sent->last(CorrelationStamp::class)->getId(), $handled[0]->last(CorrelationStamp::class)?->getId());","+    }","+","     private function sendFromAppA(SenderInterface $sender, object $message): void","     {","         $this->createBusOfAppA($sender)->dispatch($message);"],"additions":29,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Tests/MessengerBundleTest.php","lines":["@@ -58,6 +58,10 @@"," use Symfony\\Component\\Messenger\\Tests\\Fixtures\\ThirdMessage;"," use Symfony\\Component\\Messenger\\Transport\\InMemory\\InMemoryTransport;"," use Symfony\\Component\\Messenger\\Transport\\Serialization\\PhpSerializer;","+use Symfony\\Component\\Messenger\\Transport\\Serialization\\StampHeaderMapperInterface;","+use Symfony\\Component\\Serializer\\Encoder\\JsonEncoder;","+use Symfony\\Component\\Serializer\\Normalizer\\ObjectNormalizer;","+use Symfony\\Component\\Serializer\\Serializer;"," use Symfony\\Component\\Uid\\Uuid;"," "," use function Symfony\\Component\\DependencyInjection\\Loader\\Configurator\\inline_service;","@@ -403,6 +407,23 @@ public function testAFailureTransportThatSignsEveryMessageKeepsTheFailuresOfATra","         $thi