questHeaders = \"content-type, x-custom\";","+    }","+","+    [Benchmark]","+    public CorsResult EvaluateActualRequest() => _corsService.EvaluatePolicy(_actualRequest, _policy);","+","+    [Benchmark]","+    public void EvaluateAndApplyActualRequest()","+    {","+        var result = _corsService.EvaluatePolicy(_actualRequest, _policy);","+        _actualRequest.Response.Headers.Clear();","+        _corsService.ApplyResult(result, _actualRequest.Response);","+    }","+","+    [Benchmark]","+    public void EvaluateAndApplyPreflightRequest()","+    {","+        var result = _corsService.EvaluatePolicy(_preflightRequest, _policy);","+        _preflightRequest.Response.Headers.Clear();","+        _corsService.ApplyResult(result, _preflightRequest.Response);","+    }","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"src/Middleware/perf/CORS.Microbenchmarks/Microsoft.AspNetCore.Cors.Microbenchmarks.csproj","lines":["@@ -0,0 +1,18 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+","+  <PropertyGroup>","+    <OutputType>Exe</OutputType>","+    <TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>","+  </PropertyGroup>","+","+  <ItemGroup>","+    <PackageReference Include=\"BenchmarkDotNet\" />","+","+    <ProjectReference Include=\"$(RepoRoot)src\\Http\\Http.Abstractions\\src\\Microsoft.AspNetCore.Http.Abstractions.csproj\" />","+    <ProjectReference Include=\"$(RepoRoot)src\\Http\\Http.Features\\src\\Microsoft.AspNetCore.Http.Features.csproj\" />","+    <ProjectReference Include=\"$(RepoRoot)src\\Http\\Http\\src\\Microsoft.AspNetCore.Http.csproj\" />","+    <ProjectReference Include=\"$(RepoRoot)src\\Middleware\\CORS\\src\\Microsoft.AspNetCore.Cors.csproj\" />","+","+    <Compile Include=\"$(SharedSourceRoot)BenchmarkRunner\\*.cs\" />","+  </ItemGroup>","+</Project>",""],"additions":18,"deletions":0,"truncated":false}],"additions":157,"deletions":28,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-27T19:04:27.573242+00:00"}