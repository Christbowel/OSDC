ror"," from vllm.utils.async_utils import make_async","-from vllm.utils.sparse_utils import (","-    check_sparse_tensor_invariants_threadsafe,","-    check_torch_archive_size,","-    safe_to_dense,","-)","+from vllm.utils.sparse_utils import load_torch_payload"," "," if TYPE_CHECKING:","     from vllm.config import ModelConfig"," "," ","-# How much of torch's own reason is repeated back to the caller. The reason is","-# built from bytes the caller sent, so it is bounded rather than echoed whole.","-_MAX_EMBED_ERROR_REASON_CHARS: Final = 200","-","-","-def _truncated_reason(exc: Exception) -> str:","-    \"\"\"`exc`'s message, capped, saying how much was left out when it is capped.","-","-    Without the count a capped reason reads like the whole one, so a caller","-    debugging a large payload cannot tell that torch said more than this.","-    \"\"\"","-    reason: Final = str(exc).strip() or type(exc).__name__","-    omitted: Final = len(reason) - _MAX_EMBED_ERROR_REASON_CHARS","-    if omitted <= 0:","-        return reason","-    return (","-        f\"{reason[:_MAX_EMBED_ERROR_REASON_CHARS]}\"","-        f\"... ({omitted} more characters truncated)\"","-    )","-","-"," def safe_load_prompt_embeds(","     model_config: \"ModelConfig\",","     embed: bytes | str,","@@ -49,40 +23,10 @@ def safe_load_prompt_embeds(","             parameter=\"prompt_embeds\",","         )"," ","-    # Decoded outside the try below so that a body which is not base64 keeps","-    # raising binascii.Error, which is a ValueError and already answered 400.","+    # Decode before loading so a body which is not base64 keeps raising","+    # binascii.Error, which is a ValueError and already answered 400.","     payload: Final = pybase64.b64decode(embed, validate=True)","-    check_torch_archive_size(payload, parameter=\"prompt_embeds\")","-","-    with check_sparse_tensor_invariants_threadsafe():","-        try:","-            tensor = torch.load(","-                BytesIO(payload),","-                weights_only=True,","-                map_location=torch.device(\"cpu\"),","-            )","-        except (torch.OutOfMemoryError, MemoryError):","-            # Running out of memory is the server's condition, not the caller's.","-            raise","-        except Exception as exc:","-            # Everything else here is about the bytes the caller sent, and torch","-            # has no single error type for \"this is not a tensor file\": the zip","-            # reader raises `RuntimeError`, the legacy pickle path raises","-            # `UnpicklingError`, `KeyError` or `IndexError`, an empty payload","-            # raises `EOFError`. None of them is a `ValueError`, so the","-            # entrypoints' fallback mapped them all to 500. Catching by","-            # behaviour rather than by type also survives torch changing which","-            # error it raises for a given malformed payload.","-            #","-            # torch's reason is worth keeping -- for a malformed sparse tensor","-            # it names the offending index -- but it is built from the caller's","-            # own bytes, so it is truncated rather than echoed whole.","-            raise VLLMValidationError(","-                \"`prompt_embeds` could not be deserialized as a torch tensor: \"","-                f\"{_truncated_reason(exc)}\",","-                parameter=\"prompt_embeds\",","-            ) from exc","-        tensor = safe_to_dense(tensor, parameter=\"prompt_embeds\")","+    tensor = load_torch_payload(payload, parameter=\"prompt_embeds\")"," ","     if tensor.dim() > 2:","         tensor = tensor.squeeze(0)"],"additions":4,"deletions":60,"truncated":false},{"path":"vllm/utils/sparse_utils.py","lines":["@@ -5,6 +5,7 @@"," `check_sparse_tensor_invariants_threadsafe()` is a thread-safe wrapper for"," sparse tensor invariant validation. `check_torch_archive_size()` bounds the"," memory `torch.load` allocates for the tensor storages of a payload.","+`load_torch_payload()` maps unreadable client bytes to a validation error."," `safe_to_dense()` bounds the memory a deserialized tensor may allocate when"," densified."," ","@@ -22,6 +23,7 @@"," import threading"," import zipfile"," from io import BytesIO","+from typing import Final"," "," import torch"," ","@@ -31,6 +33,22 @@"," "," _SPARSE_LOAD_LOCK = threading.Lock()"," ","+# How much of torch's own reason is repeated back to the caller. The reason is","+# built from bytes the caller sent, so it is bounded rather than echoed whole.","+_MAX_EMBED_ERROR_REASON_CHARS: Final = 200","+","+","+def _truncated_reason(exc: Exception) -> str:","+    \"\"\"Return `exc`'s message, capped with the omitted character count.\"\"\"","+    reason: Final = str(exc).strip() or type(exc).__name__","+    omitted: Final = len(reason) - _MAX_EMBED_ERROR_REASON_CHARS","+    if omitted <= 0:","+        return reason","+    return (","+        f\"{reason[:_MAX_EMBED_ERROR_REASON_CHARS]}\"","+        f\"... ({omitted} more characters truncated)\"","+    )","+"," "," @contextlib.contextmanager"," def check_sparse_tensor_invariants_threadsafe():","@@ -76,6 +94,52 @@ def check_torch_archive_size(payload: bytes, *, parameter: str) -> None:","         )"," "," ","+def load_torch_payload(","+    payload: bytes,","+    *,","+    parameter: str,","+) -> torch.Tensor:","+    \"\"\"Safely deserialize a tensor from client-supplied bytes.","+","+    Payload storages are always mapped to CPU so checkpoint metadata cannot","+    select a server device. Unreadable payloads are client validation errors.","+    Memory exhaustion remains a server error because it can also be caused by","+    server capacity.","+","+    Args:","+        payload: Bytes supplied by the client.","+        parameter: Request parameter used in validation errors.","+","+    Returns:","+        The deserialized dense tensor.","+","+    Raises:","+        VLLMValidationError: If the payload cannot be deserialized as a tensor.","+        MemoryError: If deserialization exhausts host memory.","+        torch.OutOfMemoryError: If deserialization exhausts device memory.","+","+    \"\"\"","+    check_torch_archive_size(payload, parameter=parameter)","+","+    with check_sparse_tensor_invariants_threadsafe():","+        try:","+            tensor = torch.load(","+                BytesIO(payload),","+                weights_only=True,","+                map_location=torch.device(\"cpu\"),","+            )","+        except (torch.OutOfMemoryError, MemoryError):","+            raise","+        except Exception as exc:","+            raise VLLMValidationError(","+                f\"`{parameter}` could not be deserialized as a torch tensor: \"","+                f\"{_truncated_reason(exc)}\",","+                parameter=parameter,","+            ) from exc","+","+        return safe_to_dense(tensor, parameter=parameter)","+","+"," def safe_to_dense(tensor: object, *, parameter: str) -> torch.Tensor:","     \"\"\"Densify a client-supplied embedding tensor within a memory budget."," ",""],"additions":64,"deletions":0,"truncated":false}],"additions":190,"deletions":108,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-21T16:32:10.868755+00:00"}