{"id":"c2fb5c5aba0a904fdbecb8e01b7c41db5bfaeadf","axis":"silent","repo":"vllm-project/vllm","sha":"c2fb5c5aba0a904fdbecb8e01b7c41db5bfaeadf","parsed":{"files":[{"path":"docs/features/multimodal_inputs.md","lines":["@@ -1329,6 +1329,10 @@ e.g. `--limit-mm-per-prompt '{\"video\": {\"count\": 0, \"allow_embeds\": false}}'`.","     The vLLM engine may crash if incorrect shape of embeddings is passed.","     Only enable this flag for trusted users!"," ","+Embedding payloads that cannot be decoded in a supported format are rejected","+as client input errors with HTTP status 400. Memory exhaustion while loading an","+otherwise valid payload remains a server error.","+"," NumPy image and video embeddings serialized as `.npy` data are accepted in either native or non-native byte order. The embedding readers convert non-native arrays to native byte order while preserving their numeric values and element precision. For example, `numpy2base64` from `vllm.utils.serial_utils` can encode a big-endian floating-point NumPy array for the image or video embedding fields. The array must still have the shape required by the model; object arrays are not supported."," "," #### Image Embedding Inputs"],"additions":4,"deletions":0,"truncated":false},{"path":"tests/entrypoints/multimodal/openai/chat_completion/test_chat_completion_with_image_embeds.py","lines":["@@ -4,8 +4,10 @@"," import json"," "," import openai  # use the official client for correctness check","+import pybase64 as base64"," import pytest"," import pytest_asyncio","+import requests"," import torch"," from transformers import AutoConfig"," ","@@ -84,3 +86,37 @@ async def test_chat_completions_with_image_embeds(","     assert chat_completion.choices[0].message.content is not None","     assert isinstance(chat_completion.choices[0].message.content, str)","     assert len(chat_completion.choices[0].message.content) > 0","+","+","+@pytest.mark.asyncio","+async def test_unreadable_image_embeds_returns_bad_request(","+    client_with_image_embeds: openai.AsyncOpenAI,","+    server_with_image_embeds: RemoteOpenAIServer,","+):","+    unreadable = base64.b64encode(b\"not a torch tensor\").decode()","+","+    with pytest.raises(openai.BadRequestError) as excinfo:","+        await client_with_image_embeds.chat.completions.create(","+            model=MODEL_NAME,","+            messages=[","+                {","+                    \"role\": \"user\",","+                    \"content\": [","+                        {","+                            \"type\": \"image_embeds\",","+                            \"image_embeds\": unreadable,","+                        },","+                        {\"type\": \"text\", \"text\": \"Describe the image.\"},","+                    ],","+                }","+            ],","+            max_tokens=1,","+        )","+","+    error = excinfo.value","+    assert error.status_code == 400","+    error_details = error.response.json()[\"error\"]","+    assert error_details[\"type\"] == \"BadRequestError\"","+    assert error_details[\"param\"] == \"image_embeds\"","+    health = requests.get(server_with_image_embeds.url_for(\"health\"), timeout=30)","+    health.raise_for_status()"],"additions":36,"deletions":0,"truncated":false},{"path":"tests/renderers/test_prompt_embeds_payload_validation.py","lines":["@@ -27,9 +27,12 @@","     create_error_response,"," )"," from vllm.exceptions import VLLMValidationError","-from vllm.renderers.embed_utils import (","+from vllm.multimodal.media import AudioEmbeddingMediaIO, ImageEmbeddingMediaIO","+from vllm.multimodal.media.video import VideoEmbeddingMediaIO","+from vllm.renderers.embed_utils import safe_load_prompt_embeds","+from vllm.utils.sparse_utils import (","     _MAX_EMBED_ERROR_REASON_CHARS,","-    safe_load_prompt_embeds,","+    load_torch_payload,"," )"," "," ","@@ -121,6 +124,25 @@ def test_unreadable_prompt_embeds_payload_is_a_client_error(model_config, payloa","     assert int(create_error_response(excinfo.value).