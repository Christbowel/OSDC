{"id":"b0e25ede5963d96fb94ac5520af662761a83427d","axis":"silent","repo":"pnpm/pnpm","sha":"b0e25ede5963d96fb94ac5520af662761a83427d","parsed":{"files":[{"path":".changeset/file-dependency-manifest-hooks.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pacquet\": patch","+---","+","+Fixed `pnpm install --frozen-lockfile` when a pnpmfile `readPackage` hook changes the dependencies of a `file:` directory dependency. It reported an outdated lockfile right after the install that wrote it.","+","+A repeat `pnpm install` now takes the fast path when `ignoredOptionalDependencies` removes an optional dependency of a `file:` directory dependency. It used to resolve again on every run."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/local_directory_manifest_hooks.rs","lines":["@@ -0,0 +1,161 @@","+//! The lockfile checks read a `file:` directory package's manifest with the","+//! hooks the resolver applies to it, at any depth and in either lockfile","+//! layout.","+","+use crate::_utils::{","+    ManifestDeps, WorkspaceFixture, assert_success, ndjson_records, write_manifest_value,","+};","+use serde_json::{Value, json};","+use std::{fs, path::Path};","+","+/// A workspace whose `app` depends on `ext`, a `file:` directory outside the","+/// workspace patterns, so no project describes it.","+fn file_dependency_workspace(shared_lockfile: bool, ext_manifest: &Value) -> WorkspaceFixture {","+    let fixture = WorkspaceFixture::new();","+    if !shared_lockfile {","+        fixture.append_workspace_yaml(\"sharedWorkspaceLockfile: false\\n\");","+    }","+    fixture.write_root_manifest(\"root\", ManifestDeps::default());","+    write_package(&fixture.workspace.join(\"ext\"), ext_manifest);","+    write_package(","+        &fixture.workspace.join(\"packages/app\"),","+        &json!({ \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"ext\": \"file:../../ext\" } }),","+    );","+    fixture","+}","+","+fn write_package(dir: &Path, manifest: &Value) {","+    fs::create_dir_all(dir).expect(\"create package directory\");","+    write_manifest_value(dir, manifest);","+}","+","+fn install(fixture: &WorkspaceFixture, args: &[&str]) -> Vec<Value> {","+    let output = fixture.command_at(&fixture.workspace, std::iter::once(&\"install\").chain(args));","+    assert_success(&output);","+    ndjson_records(&output)","+}","+","+#[test]","+fn read_package_hook_on_a_file_dependency_passes_frozen_install() {","+    for shared_lockfile in [true, false] {","+        let fixture = file_dependency_workspace(","+            shared_lockfile,","+            &json!({ \"name\": \"ext\", \"version\": \"1.0.0\", \"dependencies\": { \"gone\": \"file:./missing\" } }),","+        );","+        write_package(","+            &fixture.workspace.join(\"ext/real\"),","+            &json!({ \"name\": \"real\", \"version\": \"1.0.0\" }),","+        );","+        write_package(","+            &fixture.workspace.join(\"ext/real/nested\"),","+            &json!({ \"name\": \"nested\", \"version\": \"1.0.0\", \"dependencies\": { \"gone\": \"file:./missing\" } }),","+        );","+        fs::write(","+            fixture.workspace.join(\".pnpmfile.cjs\"),","+            \"module.exports = { hooks: { readPackage(pkg) {\\n\\","+               if (pkg.name === 'ext') pkg.dependencies = { real: 'file:./real' };\\n\\","+               if (pkg.name === 'real') pkg.dependencies = { nested: 'file:./nested' };\\n\\","+               if (pkg.name === 'nested') pkg.dependencies = {};\\n\\","+               return pkg;\\n\\","+             } } };\\n\",","+        )","+        .expect(\"write .pnpmfile.cjs\");","+","+        install(&fixture, &[]);","+        install(&fixture, &[\"--frozen-lockfile\"]);","+    }","+}","+","+#[test]","+fn ignored_optional_dependency_of_a_file_dependency_does_not_resolve_again() {","+    for shared_lockfile in [true, false] {","+        let fixture = file_dependency_workspace(","+            shared_lockfile,","+            &json!({ \"name\": \"ext\", \"version\": \"1.0.0\", \"optionalDependencies\": { \"opt\": \"file:./opt\" } }),","+        );","+        write_package(","+            &fixture.workspace.join(\"ext/opt\"),","+            &json!({ \"name\": \"opt\", \"version\": \"1.0.0\" }),","+        );","+        fixture.append_workspace_yaml(\"ignoredOptionalDependencies:\\n  - opt\\n\");","+","+        install(&fixture, &[]);","+        let resolved_again = install(&fixture, &[])","+            .iter()","+            .any(|record| {","+                record[\"name\"] == \"pnpm:stage\" && record[\"stage\"] == \"resolution_started\"","+            });","+        assert!(!resolved_again, \"shared_lockfile: {shared_lockfile}\");","+    }","+}","+","+/// A `file:` dependency on another package's `publishConfig.directory` reads","+/// the directory's own `package.json`. The publishing package's manifest is","+/// what a workspace spec would read, so the check does not hook it.","+#[test]","+fn file_dependency_on_a_publish_directory_hooks_only_its_own_manifest() {","+    let fixture = WorkspaceFixture::new();","+    fixture.write_root_manifest(\"root\", ManifestDeps::default());","+    write_package(","+        &fixture.workspace.join(\"ext\"),","+        &json!({ \"name\": \"ext-src\", \"version\": \"1.0.0\", \"publishConfig\": { \"directory\": \"dist\" } }),","+    );","+    write_package(","+        &fixture.workspace.join(\"ext/dist\"),","+        &json!({ \"name\": \"ext\", \"version\": \"1.0.0\" }),","+    );","+    write_package(","+        &fixture.workspace.join(\"packages/app\"),","+        &json!({ \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"ext\": \"file:../../ext/dist\" } }),","+    );","+    fs::write(","+        fixture.workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { readPackage(pkg) {\\n\\","+           if (pkg.name === 'ext-src') throw new Error('ext-src is not a dependency');\\n\\","+           return pkg;\\n\\","+         } } };\\n\",","+    )","+    .expect(\"write .pnpmfile.cjs\");","+","+    install(&fixture, &[]);","+    install(&fixture, &[\"--frozen-lockfile\"]);","+}","+","+/// With its own lockfile, a project reaching one publish directory through","+/// both a workspace spec and a `file:` spec checks a nested workspace range","+/// on it against the publishing project's version, not the directory's own.","+#[test]","+fn publish_directory_reached_both_ways_keeps_the_workspace_version() {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(","+        \"sharedWorkspaceLockfile: false\\ninjectWorkspacePackages: true\\n\",","+    );","+    fixture.write_root_manifest(\"root\", ManifestDeps::default());","+    write_package(","+        &fixture.workspace.join(\"packages/lib\"),","+        &json!({ \"name\": \"lib\", \"version\": \"1.0.0\", \"publishConfig\": { \"directory\": \"dist\" } }),","+    );","+    write_package(","+        &fixture.workspace.join(\"packages/lib/dist\"),","+        &json!({ \"name\": \"lib\", \"version\": \"2.0.0\" }),","+    );","+    write_package(","+        &fixture.workspace.join(\"ext\"),","+        &json!({ \"name\": \"ext\", \"version\": \"1.0.0\", \"dependencies\": { \"lib\": \"workspace:^1.0.0\" } }),","+    );","+    write_package(","+        &fixture.workspace.join(\"packages/app\"),","+        &json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": {","+                \"lib\": \"workspace:^1.0.0\",","+                \"lib-dist\": \"file:../lib/dist\",","+                \"ext\": \"file:../../ext\",","+            },","+        }),","+    );","+","+    install(&fixture, &[]);","+    install(&fixture, &[\"--frozen-lockfile\"]);","+}"],"additions":161,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -100,6 +100,7 @@ mod licenses;"," mod lifecycle_scripts;"," mod link;"," mod list;","+mod local_directory_manifest_hooks;"," mod local_directory_without_manifest;"," mod local_override_metadata_cache;"," mod local_tarball_dependency;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install.rs","lines":["@@ -4,11 +4,11 @@ pub use entry_points::apply_deploy_manifest_hook;"," pub(crate) use entry_points::apply_deploy_manifest_hook_to_arc;"," pub use errors::{InstallError, defer_ignored_builds};"," pub(crate) use lockfile_freshness::{","-    CheckLockfileSettingsDriftOptions, FreshnessCheckError, FreshnessScope,","+    CheckLockfileSettingsDriftOptions, DirectoryManifests, FreshnessCheckError, FreshnessScope,","     ImporterSatisfactionCheck, OptionalDependencyExclusions, ProjectManifestsByDir,","     WorkspaceProjects, check_importer_satisfies, check_lockfile_settings_drift,","-    dependency_manifests_by_dir, is_declared_local_directory, parse_config_overrides,","-    project_manifests_by_dir, spec_target_and_range,","+    dependency_manifests_by_dir, ignored_optional_matcher, is_declared_local_directory,","+    parse_config_overrides, project_manifests_by_dir, spec_target_and_range,"," };"," pub use lockfile_freshness::{","     WantedLockfileSatisfactionCheck, wanted_lockfile_satisfies_workspace,"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness.rs","lines":["@@ -5,6 +5,7 @@ pub(crate) use directory_deps::{","     ProjectManifestsByDir, dependency_manifests_by_dir, is_declared_local_directory,","     project_manifests_by_dir, spec_target_and_range,"," };","+pub(crate) use directory_manifests::DirectoryManifests;"," pub(crate) use error::FreshnessCheckError;"," pub(super) use manifest::manifest_has_effective_dependencies;"," pub(crate) use manifest::{","@@ -15,7 +16,7 @@ pub(crate) use settings::{","     CheckLockfileSettingsDriftOptions, check_lockfile_settings_drift, parse_config_overrides,"," };"," ","-mod injected_manifests;","+mod directory_manifests;"," "," use rayon::prelude::*;"," ","@@ -387,17 +388,26 @@ pub(super) async fn check_lockfile_freshness(","         }));","     }"," ","-    let injected = injected_manifests::hooked_injected_manifests(lockfile, inputs).await?;","-    check_importer_freshness(lockfile, inputs, (parsed_overrides_opt.as_deref(), &injected))","+    let directory_manifests = directory_manifests::hooked_directory_manifests(","+        lockfile,","+        inputs,","+        parsed_overrides_opt.as_deref(),","+    )","+    .await?;","+    check_importer_freshness(","+        lockfile,","+        inputs,","+        (parsed_overrides_opt.as_deref(), &directory_manifests),","+    )"," }"," "," // Parallel checks settle before the serial fold reports the first error in importer order."," fn check_importer_freshness(","     lockfile: &Lockfile,","     inputs: &LockfileFreshnessInputs<'_, '_>,","-    (parsed_overrides, injected): (","+    (parsed_overrides, directory_manifests): (","         Option<&[pnpm_config_parse_overrides::VersionOverride]>,","-        &[(PathBuf, PackageManifest)],","+        &DirectoryManifests,","     ),"," ) -> Result<Vec<UnresolvedOptionalDependency>, FreshnessCheckError> {","     let ignored_optional_matcher = ignored_optional_matcher(inputs.config);","@@ -405,15 +415,16 @@ fn check_importer_freshness(","         inputs.manifests.iter().map(|(_, manifest)| *manifest),","         inputs.dependency_manifests,","     );","-    project_manifests.extend(","-        injected","-            .iter()","-            .map(|(dir, manifest)| (dir.clone(), manifest)),","-    );","+    project_manifests.extend(directory_manifests::injected_project_manifests(","+        lockfile,","+        inputs,","+        directory_manifests,","+    ));","     let registries = inputs.registry_context();","     let workspace = WorkspaceProjects {","         packages: inputs.workspace_packages,","         manifests_by_dir: &project_manifests,","+        directory_manifests,","         catalogs: inputs.catalogs,","         canonical_paths: &pnpm_fs::CanonicalPaths::default(),","         registries: &registries,","@@ -484,7 +495,7 @@ fn check_single_importer(","         .collect())"," }"," ","-fn ignored_optional_matcher(config: &Config) -> pnpm_matcher::Matcher {","+pub(crate) fn ignored_optional_matcher(config: &Config) -> pnpm_matcher::Matcher {","     pnpm_matcher::create_matcher(","         config.ignored_optional_dependencies.as_deref().unwrap_or_default(),","     )"],"additions":22,"deletions":11,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps.rs","lines":["@@ -2,6 +2,7 @@ pub(crate) use importer_deps::check_directory_dependencies_freshness;"," pub use injected_manifest::ProjectManifestsByDir;"," pub(super) use injected_manifest::{InjectedDirectory, is_deploy_file_url_key, unhooked_manifest};"," pub(crate) use injected_manifest::{dependency_manifests_by_dir, project_manifests_by_dir};","+pub(super) use package::overridden_unhooked_manifest;"," pub(crate) use spec::spec_target_and_range;"," "," mod children;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/package.rs","lines":["@@ -11,22 +11,39 @@ use super::{"," };"," use pnpm_package_manifest::PackageManifest;"," ","+/// The manifest the resolver read for `dep`: the hooked one the check holds,","+/// else [`overridden_unhooked_manifest`]."," fn read_and_override_manifest(","     check: &ImporterSatisfactionCheck<'_>,","     dep: &LocalDepContext<'_>,"," ) -> Result<PackageManifest, FreshnessCheckError> {","-    let mut local_manifest = unhooked_manifest(&InjectedDirectory {","+    let hooked = check.workspace.directory_manifests.get(dep.rel_path, dep.declared_as_file);","+    if let Some(manifest) = hooked {","+        return Ok(manifest.clone());","+    }","+    let injected = InjectedDirectory {","         dir: dep.dir,","         declared_as_file: dep.declared_as_file,","         workspace_root: dep.dirs.workspace_root,","         manifests_by_dir: check.workspace.manifests_by_dir,","-    })","-    .ok_or_else(|| dep.outdated())?;","-    if let Some(parsed) = check.parsed_overrides {","-        crate::VersionsOverrider::new(parsed, check.lockfile_dir)","-            .apply(&mut local_manifest, Some(dep.dir));","+    };","+    overridden_unhooked_manifest(&injected, check.parsed_overrides, check.lockfile_dir)","+        .ok_or_else(|| dep.outdated())","+}","+","+/// [`unhooked_manifest`] with the overrides applied, as the check reads a","+/// directory package that no hooked manifest covers.","+pub(in crate::install::lockfile_freshness) fn overridden_unhooked_manifest(","+    injected: &InjectedDirectory<'_>,","+    parsed_overrides: Option<&[pnpm_config_parse_overrides::VersionOverride]>,","+    lockfile_dir: &std::path::Path,","+) -> Option<PackageManifest> {","+    let mut manifest = unhooked_manifest(injected)?;","+    if let Some(parsed) = parsed_overrides {","+        crate::VersionsOverrider::new(parsed, lockfile_dir)","+            .apply(&mut manifest, Some(injected.dir));","     }","-    Ok(local_manifest)","+    Some(manifest)"," }"," "," pub(super) fn check_single_directory_dep_freshness("],"additions":24,"deletions":7,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/tests.rs","lines":["@@ -282,6 +282,7 @@ fn check_directory_dep_in_scope(","         workspace: crate::install::lockfile_freshness::WorkspaceProjects {","             packages: None,","             manifests_by_dir: &manifests_by_dir,","+            directory_manifests: crate::install::DirectoryManifests::none(),","             catalogs,","             canonical_paths: Box::leak(Box::default()),","             registries: Box::leak(Box::default()),","@@ -803,6 +804,7 @@ snapshots:","         workspace: crate::install::lockfile_freshness::WorkspaceProjects {","             packages: None,","             manifests_by_dir: &manifests_by_dir,","+            directory_manifests: crate::install::DirectoryManifests::none(),","             catalogs: &catalogs,","             canonical_paths: Box::leak(Box::default()),","             registries: Box::leak(Box::default()),","@@ -864,6 +866,7 @@ fn check_root_with_directories(","         workspace: crate::install::lockfile_freshness::WorkspaceProjects {","             packages: None,","             manifests_by_dir: &manifests_by_dir,","+            directory_manifests: crate::install::DirectoryManifests::none(),","             catalogs: &catalogs,","             canonical_paths: Box::leak(Box::default()),","             registries: Box::leak(Box::default()),"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_manifests.rs","lines":["@@ -0,0 +1,296 @@","+//! The manifests of the directory packages a lockfile check reads, as the","+//! resolver read them.","+","+use super::{","+    FreshnessCheckError, LockfileFreshnessInputs,","+    directory_deps::{","+        InjectedDirectory, is_declared_local_directory, is_deploy_file_url_key,","+        overridden_unhooked_manifest, unhooked_manifest,","+    },","+    project_manifests_by_dir,","+};","+use crate::install::{Arc, Lockfile, PackageManifest, PathBuf};","+use pnpm_package_manifest::DependencyGroup;","+use pnpm_resolving_deps_resolver::{ChildCatalogs, ManifestTransformHooks};","+use std::collections::{HashMap, HashSet};","+","+/// A directory dependency as the check reaches it: the directory the","+/// lockfile records, as written, and whether a `file:` spec declared it.","+/// The two declarations can read different manifests; see","+/// [`unhooked_manifest`].","+type DirectoryDep = (String, bool);","+","+/// The manifests [`hooked_directory_manifests`] returns, by [`DirectoryDep`].","+#[derive(Default)]","+pub(crate) struct DirectoryManifests(HashMap<DirectoryDep, PackageManifest>);","+","+impl DirectoryManifests {","+    /// No manifests: every directory package is read from its directory.","+    pub(crate) fn none() -> &'static Self {","+        static NONE: std::sync::OnceLock<DirectoryManifests> = std::sync::OnceLock::new();","+        NONE.get_or_init(Self::default)","+    }","+","+    pub(crate) fn get(&self, directory: &str, declared_as_file: bool) -> Option<&PackageManifest> {","+        self.0.get(&(directory.to_string(), declared_as_file))","+    }","+}","+","+/// The manifest of every directory package the importers of `inputs` reach","+/// through directory packages, that no project in `inputs` describes, with","+/// the resolver's manifest hooks applied as the resolver applies them:","+/// `packageExtensions`, the pnpmfile's `readPackage` with the recorded","+/// directory, overrides, and `ignoredOptionalDependencies`.","+///","+/// The children of a package come from its hooked manifest, so the packages","+/// are hooked one level of the graph at a time.","+pub(super) async fn hooked_directory_manifests(","+    lockfile: &Lockfile,","+    inputs: &LockfileFreshnessInputs<'_, '_>,","+    parsed_overrides: Option<&[pnpm_config_parse_overrides::VersionOverride]>,","+) -> Result<DirectoryManifests, FreshnessCheckError> {","+    let mut level = direct_directory_deps(lockfile, inputs);","+    if level.is_empty() {","+        return Ok(DirectoryManifests::default());","+    }","+    let walk = DirectoryWalk {","+        lockfile,","+        inputs,","+        parsed_overrides,","+        manifests_by_dir: project_manifests_by_dir(","+            inputs.manifests.iter().map(|(_, manifest)| *manifest),","+            inputs.dependency_manifests,","+        ),","+        hooks: resolver_hooks(inputs, parsed_overrides)?,","+    };","+    // A directory is read once, but each snapshot of it is walked: peer","+    // variants of one package can record different children.","+    let mut walked: HashSet<(pnpm_lockfile::PackageKey, DirectoryDep)> = HashSet::new();","+    let mut read: HashMap<DirectoryDep, Option<(PackageManifest, bool)>> = HashMap::new();","+    while !level.is_empty() {","+        level.retain(|visit| walked.insert((visit.key.clone(), visit.dep.clone())));","+        walk.read_level(&level, &mut read).await?;","+        level = level","+            .iter()","+            .filter_map(|visit| {","+                let (manifest, _) = read.get(&visit.dep)?.as_ref()?;","+                Some(walk.children(visit, manifest))","+            })","+            .flatten()","+            .collect();","+    }","+    let manifests = read","+        .into_iter()","+        .filter_map(|(dep, manifest)| match manifest {","+            Some((manifest, true)) => Some((dep, manifest)),","+            _ => None,","+        })","+        .collect();","+    Ok(DirectoryManifests(manifests))","+}","+","+fn resolver_hooks(","+    inputs: &LockfileFreshnessInputs<'_, '_>,","+    parsed_overrides: Option<&[pnpm_config_parse_overrides::VersionOverride]>,","+) -> Result<ManifestTransformHooks, FreshnessCheckError> {","+    let versions_overrider = parsed_overrides.map(|parsed| {","+        Arc::new(crate::VersionsOverrider::new(parsed, inputs.lockfile_dir))","+    });","+    Ok(crate::install_with_fresh_lockfile::resolver_manifest_hooks(","+        inputs.config,","+        versions_overrider,","+    )","+    .map_err(FreshnessCheckError::InvalidPackageExtensionSelector)?","+    .with_pnpmfile(inputs.pnpmfile_hook.cloned()))","+}","+","+/// The manifests a project with its own lockfile injects: the workspace","+/// projects it does not hold among its own importers. Every other install","+/// holds them, already hooked. Later entries replace earlier ones for the","+/// same directory.","+pub(super) fn injected_project_manifests<'a>(","+    lockfile: &Lockfile,","+    inputs: &LockfileFreshnessInputs<'_, '_>,","+    directory_manifests: &'a DirectoryManifests,","+) -> Vec<(PathBuf, &'a PackageManifest)> {","+    if inputs.config.shares_one_lockfile() {","+        return Vec::new();","+    }","+    let groups = [DependencyGroup::Prod, DependencyGroup::Dev, DependencyGroup::Optional];","+    let mut injected: Vec<(bool, PathBuf, &PackageManifest)> = inputs.manifests","+        .iter()","+        .flat_map(|(importer_id, _)| lockfile.injected_dependencies(importer_id, groups))","+        .filter_map(|dependency| {","+            let directory = &dependency.directory.directory;","+            let declared_as_file = is_declared_local_directory(&dependency.spec.specifier);","+            let manifest = directory_manifests.get(directory, declared_as_file)?;","+            let dir = pnpm_fs::lexical_normalize(&inputs.lockfile_dir.join(directory));","+            Some((declared_as_file, dir, manifest))","+        })","+        .collect();","+    // The map these extend is keyed by directory and serves workspace specs,","+    // so a directory reached both ways keeps the workspace declaration's","+    // manifest: it comes last.","+    injected.sort_by_key(|(declared_as_file, ..)| !declared_as_file);","+    injected","+        .into_iter()","+        .map(|(_, dir, manifest)| (dir, manifest))","+        .collect()","+}","+","+/// A directory package the walk reads, and the lockfile entry that records","+/// its children.","+struct Visit {","+    dep: DirectoryDep,","+    alias: String,","+    key: pnpm_lockfile::PackageKey,","+}","+","+/// The importers' own directory dependencies, except a `pnpm deploy` entry,","+/// whose snapshot already carries its hooks.","+fn direct_directory_deps(","+    lockfile: &Lockfile,","+    inputs: &LockfileFreshnessInputs<'_, '_>,","+) -> Vec<Visit> {","+    let groups = [DependencyGroup::Prod, DependencyGroup::Dev, DependencyGroup::Optional];","+    inputs.manifests","+        .iter()","+        .flat_map(|(importer_id, _)| lockfile.injected_dependencies(importer_id, groups))","+        .filter_map(|dependency| {","+            let key = dependency.spec.version.resolved_key(dependency.alias)?;","+            let directory = &dependency.directory.directory;","+            (!is_deploy_file_url_key(dependency.spec, &key, directory)).then(|| Visit {","+                dep: (directory.clone(), is_declared_local_directory(&dependency.spec.specifier)),","+                alias: dependency.alias.to_string(),","+                key,","+            })","+        })","+        .collect()","+}","+","+struct DirectoryWalk<'a, 'i> {","+    lockfile: &'a Lockfile,","+    inputs: &'a LockfileFreshnessInputs<'i, 'i>,","+    parsed_overrides: Option<&'a [pnpm_config_parse_overrides::VersionOverride]>,","+    manifests_by_dir: super::ProjectManifestsByDir<'a>,","+    hooks: ManifestTransformHooks,","+}","+","+impl DirectoryWalk<'_, '_> {","+    /// [`Self::read`] each directory of `level` that `read` does not hold yet.","+    async fn read_level(","+        &self,","+        level: &[Visit],","+        read: &mut HashMap<DirectoryDep, Option<(PackageManifest, bool)>>,","+    ) -> Result<(), FreshnessCheckError> {","+        let mut queued: HashSet<&DirectoryDep> = HashSet::new();","+        let unread: Vec<&Visit> = level","+            .iter()","+            .filter(|visit| !read.contains_key(&visit.dep) && queued.insert(&visit.dep))","+            .collect();","+        let manifests = futures_util::future::try_join_all(","+            unread","+                .iter()","+                .map(|visit| self.read(visit)),","+        )","+        .await?;","+        read.extend(","+            unread","+                .into_iter()","+                .map(|visit| visit.dep.clone())","+                .zip(manifests),","+        );","+        Ok(())","+    }","+","+    /// The manifest the check reads for `visit`, and whether it was hooked","+    /// here. A project's manifest comes in already hooked.","+    async fn read(","+        &self,","+        visit: &Visit,","+    ) -> Result<Option<(PackageManifest, bool)>, FreshnessCheckError> {","+        let (direct