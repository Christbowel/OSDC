uginsettings\""," \t\"github.com/grafana/grafana/pkg/services/pluginsintegration/pluginstore\"","-\t\"github.com/grafana/grafana/pkg/util\""," )"," "," // The Knowledge Graph's version of the \"Application\" page.","@@ -662,46 +660,21 @@ func (s *ServiceImpl) readNavigationSettings() {"," \t\t},"," \t}"," ","-\tappSections := s.cfg.Raw.Section(\"navigation.app_sections\")","-\tappStandalonePages := s.cfg.Raw.Section(\"navigation.app_standalone_pages\")","-","-\tfor _, key := range appSections.Keys() {","-\t\tpluginId := key.Name()","-\t\t// Support <id> <weight> value","-\t\tvalues := util.SplitString(appSections.Key(key.Name()).MustString(\"\"))","-","-\t\tappCfg := &NavigationAppConfig{SectionID: values[0]}","-\t\tif len(values) > 1 {","-\t\t\tif weight, err := strconv.ParseInt(values[1], 10, 64); err == nil {","-\t\t\t\tappCfg.SortWeight = weight","-\t\t\t}","-\t\t}","-","+\tfor pluginID, placement := range navtree.ParseNavigationPlacements(s.cfg.Raw.Section(\"navigation.app_sections\")) {"," \t\t// Only apply the new values, don't completely overwrite the entry if it exists","-\t\tif entry, ok := s.navigationAppConfig[pluginId]; ok {","-\t\t\tentry.SectionID = appCfg.SectionID","-\t\t\tif appCfg.SortWeight != 0 {","-\t\t\t\tentry.SortWeight = appCfg.SortWeight","+\t\tif entry, ok := s.navigationAppConfig[pluginID]; ok {","+\t\t\tentry.SectionID = placement.SectionID","+\t\t\tif placement.SortWeight != 0 {","+\t\t\t\tentry.SortWeight = placement.SortWeight"," \t\t\t}","-\t\t\ts.navigationAppConfig[pluginId] = entry","+\t\t\ts.navigationAppConfig[pluginID] = entry"," \t\t} else {","-\t\t\ts.navigationAppConfig[pluginId] = *appCfg","+\t\t\ts.navigationAppConfig[pluginID] = NavigationAppConfig{SectionID: placement.SectionID, SortWeight: placement.SortWeight}"," \t\t}"," \t}"," ","-\tfor _, key := range appStandalonePages.Keys() {","-\t\turl := key.Name()","-\t\t// Support <id> <weight> value","-\t\tvalues := util.SplitString(appStandalonePages.Key(key.Name()).MustString(\"\"))","-","-\t\tappCfg := &NavigationAppConfig{SectionID: values[0]}","-\t\tif len(values) > 1 {","-\t\t\tif weight, err := strconv.ParseInt(values[1], 10, 64); err == nil {","-\t\t\t\tappCfg.SortWeight = weight","-\t\t\t}","-\t\t}","-","-\t\ts.navigationAppPathConfig[url] = *appCfg","+\tfor url, placement := range navtree.ParseNavigationPlacements(s.cfg.Raw.Section(\"navigation.app_standalone_pages\")) {","+\t\ts.navigationAppPathConfig[url] = NavigationAppConfig{SectionID: placement.SectionID, SortWeight: placement.SortWeight}"," \t}"," }"," "],"additions":9,"deletions":36,"truncated":false},{"path":"pkg/services/navtree/placements.go","lines":["@@ -0,0 +1,52 @@","+package navtree","+","+import (","+\t\"strconv\"","+","+\t\"gopkg.in/ini.v1\"","+","+\t\"github.com/grafana/grafana/pkg/util\"","+)","+","+// NavigationPlacement is one `<sectionId> <sortWeight>` value from the","+// [navigation.app_sections] and [navigation.app_standalone_pages] INI sections,","+// keyed by plugin id and by page path respectively.","+type NavigationPlacement struct {","+\tSectionID  string `json:\"sectionId\"`","+\tSortWeight int64  `json:\"sortWeight,omitempty\"`","+}","+","+// ParseNavigationPlacements parses one of those sections. Shared by the","+// server-built tree and by the frontend settings the client-built tree reads, so","+// the two cannot come to disagree about the format.","+//","+// Values are read key by key rather than through KeysHash, which returns them","+// raw: only Key.String expands the %(name)s macros the ini format allows.","+//","+// A value with no weight, or an unparseable one, yields a zero weight, which","+// both trees sort as \"wherever it was appended\".","+func ParseNavigationPlacements(section *ini.Section) map[string]NavigationPlacement {","+\tkeys := section.Keys()","+\tif len(keys) == 0 {","+\t\treturn nil","+\t}","+","+\tplacements := make(map[string]NavigationPlacement, len(keys))","+\tfor _, key := range keys {","+\t\t// util.SplitString, as the server-built tree has always parsed these","+\t\tfields := util.SplitString(key.MustString(\"\"))","+\t\tif len(fields) == 0 {","+\t\t\tcontinue","+\t\t}","+","+\t\tplacement := NavigationPlacement{SectionID: fields[0]}","+\t\tif len(fields) > 1 {","+\t\t\tif weight, err := strconv.ParseInt(fields[1], 10, 64); err == nil {","+\t\t\t\tplacement.SortWeight = weight","+\t\t\t}","+\t\t}","+\t\tplacements[key.Name()] = placement","+\t}","+","+\treturn placements","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"pkg/services/navtree/placements_test.go","lines":["@@ -0,0 +1,66 @@","+package navtree","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"gopkg.in/ini.v1\"","+)","+","+func TestParseNavigationPlacements(t *testing.T) {","+\t// The section as an operator would write it, so the test exercises the same","+\t// value handling the ini file goes through","+\tsection := func(t *testing.T, body string) *ini.Section {","+\t\tt.Helper()","+\t\tfile, err := ini.Load([]byte(body))","+\t\trequire.NoError(t, err)","+\t\treturn file.Section(\"navigation.app_sections\")","+\t}","+","+\tt.Run(\"reads a section id with and without a weight\", func(t *testing.T) {","+\t\tplacements := ParseNavigationPlacements(section(t, `","+[navigation.app_sections]","+grafana-collector-app = connections 1","+grafana-dbcfg-app = cfg","+`))","+","+\t\tassert.Equal(t, map[string]NavigationPlacement{","+\t\t\t\"grafana-collector-app\": {SectionID: \"connections\", SortWeight: 1},","+\t\t\t\"grafana-dbcfg-app\":     {SectionID: \"cfg\"},","+\t\t}, placements)","+\t})","+","+\t// Both trees sort a zero weight as \"wherever it was appended\", so a value we","+\t// cannot read is better dropped than guessed at","+\tt.Run(\"ignores an unparseable weight and an empty value\", func(t *testing.T) {","+\t\tplacements := ParseNavigationPlacements(section(t, `","+[navigation.app_sections]","+grafana-collector-app = connections notanumber","+grafana-empty-app =","+`))","+","+\t\tassert.Equal(t, map[string]NavigationPlacement{","+\t\t\t\"grafana-collector-app\": {SectionID: \"connections\"},","+\t\t}, placements)","+\t})","+","+\t// KeysHash would hand back \"%(default_section)s\" verbatim","+\tt.Run(\"expands a macro in the value\", func(t *testing.T) {","+\t\tplacements := ParseNavigationPlacements(section(t, `","+default_section = connections","+default_weight = 2","+","+[navigation.app_sections]","+grafana-collector-app = %(default_section)s %(default_weight)s","+`))","+","+\t\tassert.Equal(t, map[string]NavigationPlacement{","+\t\t\t\"grafana-collector-app\": {SectionID: \"connections\", SortWeight: 2},","+\t\t}, placements)","+\t})","+","+\tt.Run(\"returns nothing for a section with no keys\", func(t *testing.T) {","+\t\tassert.Nil(t, ParseNavigationPlacements(ini.Empty().Section(\"navigation.app_sections\")))","+\t})","+}",""],"additions":66,"deletions":0,"truncated":false}],"additions":226,"deletions":36,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-04T16:05:48.592967+00:00"}