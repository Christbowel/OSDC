gation.AppSections)","+","+\t\tassert.Equal(t, map[string]dtos.FrontendSettingsNavigationPlacementDTO{","+\t\t\t// a section that does not exist is how an operator hides a page","+\t\t\t\"/a/grafana-pdc-app\": {SectionID: \"nonexistent\"},","+\t\t\t// an unparseable weight is ignored rather than failing the whole setting","+\t\t\t\"/connections/infrastructure\": {SectionID: \"connections\"},","+\t\t}, settings.Navigation.AppStandalonePages)","+\t})","+","+\tt.Run(\"leaves the nav overrides empty when no sections are configured\", func(t *testing.T) {","+\t\tcfg := setting.NewCfg()","+\t\tlicense := &licensing.OSSLicensingService{Cfg: cfg}","+","+\t\tsettings, err := GetBaseFrontendSettings(newTestReqContext(), cfg, license, nil)","+\t\trequire.NoError(t, err)","+\t\tassert.Empty(t, settings.Navigation.AppSections)","+\t\tassert.Empty(t, settings.Navigation.AppStandalonePages)","+\t})"," }"],"additions":45,"deletions":0,"truncated":false},{"path":"pkg/services/frontend/frontend_settings.go","lines":["@@ -51,4 +51,6 @@ type FSFrontendSettings struct {"," \tReportingStaticContext           map[string]string `json:\"reportingStaticContext,omitempty\"`"," "," \tLoginError string `json:\"loginError,omitempty\"`","+","+\tNavigation dtos.FrontendSettingsNavigationDTO `json:\"navigation,omitempty\"`"," }"],"additions":2,"deletions":0,"truncated":false},{"path":"pkg/services/frontend/request_config.go","lines":["@@ -72,6 +72,9 @@ func NewFSRequestConfig(ctx context.Context, cfg *setting.Cfg, license licensing"," \t\tTrustedTypesDefaultPolicyEnabled:     (cfg.CSPEnabled && strings.Contains(cfg.CSPTemplate, \"require-trusted-types-for\")) || (cfg.CSPReportOnlyEnabled && strings.Contains(cfg.CSPReportOnlyTemplate, \"require-trusted-types-for\")),"," \t\tVerifyEmailEnabled:                   cfg.VerifyEmailEnabled,"," \t\tBuildInfo:                            getBuildInfo(license, cfg),","+\t\t// The nav overrides travel in the slim settings too: the client-built nav","+\t\t// tr