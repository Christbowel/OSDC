 config = Config::default();","+    let settings: WorkspaceSettings = serde_saphyr::from_str(\"tag: ''\\n\").unwrap();","+    settings.apply_to(&mut config, Path::new(\"/workspace\"));","+    assert_eq!(config.default_tag(), \"latest\");","+}","+","+#[test]","+fn tag_is_read_from_a_config_override() {","+    let values = BTreeMap::from([(\"tag\".to_string(), \"beta\".to_string())]);","+    let mut config = Config::default();","+    WorkspaceSettings::from_string_values(&values).apply_to(&mut config, Path::new(\"/workspace\"));","+    assert_eq!(config.default_tag(), \"beta\");","+}","+","+#[test]","+fn tag_can_be_reset() {","+    let mut config = Config { tag: Some(\"next\".to_string()), ..Config::default() };","+    assert!(WorkspaceSettings::reset_setting_to_default::<crate::Host>(","+        &mut config,","+        &Config::default(),","+        \"tag\",","+        Path::new(\"/workspace\"),","+    ));","+    assert_eq!(config.tag, None);","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_package_from_registry/tests.rs","lines":["@@ -259,6 +259,7 @@ fn create_config(","         minimum_release_age_exclude_prune: false,","         catalogs: None,","         save_catalog_name: None,","+        tag: None,","         save_prefix: None,","         save_exact: false,","         save_peer: false,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/install.rs","lines":["@@ -108,29 +108,26 @@ pub(super) fn seed_picked_versions(","     seed: (&mut HashSet<String>, &mut PreferredVersions),"," ) {","     let (dropped_pins, preferred) = seed;","-    for PickedVersion { name, version, specifier } in picked_versions {","-        let (Ok(package), Ok(semver)) = (name.parse::<PkgName>(), version.parse::<Version>())","-        else {","+    for picked in picked_versions {","+        let Some(lock) = locked.unsettled_pick(picked) else {","             continue;","         };","-        let 