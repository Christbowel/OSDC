s.http.rate-limit.\";","+    private static final String CONTEXT_KEY = \"test.request-context\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest()","+            .withApplicationRoot(jar -> jar.addClasses(TestHttp.class, TestClient.class, TestHttp.Resource.class,","+                    TestRateLimitClock.class, ForeignThreadResolver.class, ContextCheckingResolver.class,","+                    ContextRecorder.class))","+            .overrideConfigKey(\"quarkus.vertx.event-loops-pool-size\", \"1\")","+            .overrideConfigKey(PREFIX + \"foreign.paths\", \"/*\")","+            .overrideConfigKey(PREFIX + \"foreign.phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"foreign.request-key\", \"custom:foreign-thread\")","+            .overrideRuntimeConfigKey(PREFIX + \"foreign.permits\", \"10\")","+            .overrideRuntimeConfigKey(PREFIX + \"foreign.window\", \"1m\")","+            .overrideConfigKey(PREFIX + \"checking.paths\", \"/*\")","+            .overrideConfigKey(PREFIX + \"checking.phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"checking.request-key\", \"custom:context-check\")","+            .overrideRuntimeConfigKey(PREFIX + \"checking.permits\", \"10\")","+            .overrideRuntimeConfigKey(PREFIX + \"checking.window\", \"1h\");","+","+    static final AtomicReference<Boolean> onRequestContext = new AtomicReference<>();","+","+    @Inject","+    Vertx vertx;","+","+    @TestHTTPResource","+    URL url;","+","+    TestClient http;","+","+    @BeforeEach","+    void createClient() {","+        http = new TestClient(vertx, url);","+    }","+","+    @AfterEach","+    void closeClient() {","+        http.close();","+    }","+","+    @Test","+    void nextResolverRunsOnTheRequestContext() {","+        assertThat(http.get(\"/x\").statusCode()).isEqualTo(200);","+        assertThat(onRequestContext.get()).isTrue();","+    }","+","+    @Singleton","+    @Identifier(\"foreign-thread\")","+    public static class ForeignThreadResolver implements RateLimitKeyResolver {","+","+        @Override","+        public Uni<Optional<String>> resolve(RateLimitContext context) {","+            return Uni.createFrom().emitter(emitter -> new Thread(() -> emitter.complete(Optional.of(\"k\"))).start());","+        }","+    }","+","+    @Singleton","+    @Identifier(\"context-check\")","+    public static class ContextCheckingResolver implements RateLimitKeyResolver {","+","+        @Override","+        public Uni<Optional<String>> resolve(RateLimitContext context) {","+            Context requestContext = context.routingContext().get(CONTEXT_KEY);","+            onRequestContext.set(requestContext != null && Vertx.currentContext() == requestContext);","+            return Uni.createFrom().item(Optional.of(\"k\"));","+        }","+    }","+","+    @Singleton","+    public static class ContextRecorder {","+","+        void init(@Observes Router router) {","+            router.route().order(Integer.MIN_VALUE + 2).handler(ctx -> {","+                ctx.put(CONTEXT_KEY, Vertx.currentContext());","+                ctx.next();","+            });","+        }","+    }","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/HttpRateLimitBuildConfigValidatorTest.java","lines":["@@ -21,7 +21,7 @@"," public class HttpRateLimitBuildConfigValidatorTest {"," ","     private static final String P = \"quarkus.http.rate-limit.\";","-    private static final Set<String> KEY_RESOLVERS = Set.of(\"ip\", \"global\", \"principal\");","+    private static final Set<String> KEY_RESOLVERS = Set.of(\"ip\", \"global\", \"principal\", \"tenant\");"," ","     /** A valid pre-authentication rule named {@code api} with the given overrides applied on top. */","     private static HttpRateLimitBuildTimeConfig config(String... overrides) {","@@ -101,11 +101,18 @@ void phaseAndRequestKeyDefaultToTheGlobalOnes() {","     }"," ","     @Test","-    void requestKeyMustBeABuiltInKey() {","-        assertThat(validate(g(\"request-key\"), \"unknown\")).containsExactly(","-                \"Rate limit rule 'api' request-key 'unknown' is not a built-in key: ip, principal, global or header:<name>\");","+    void requestKeyMustMatchAResolver() {","+        assertThat(validate(g(\"request-key\"), \"custom:unknown\")).containsExactly(","+                \"Rate limit rule 'api' request-key 'custom:unknown' matches no RateLimitKeyResolver bean annotated @Identifier(\\\"unknown\\\")\");","+        assertThat(validate(g(\"request-key\"), \"custom:tenant\")).isEmpty();","         assertThat(validate(g(\"request-key\"), \"header:X-Client\")).isEmpty();","+        // a bare name is a built-in key: an application's resolver has a namespace of its own, so that a later","+        // built-in key cannot take its place","+        assertThat(validate(g(\"request-key\"), \"tenant\")).containsExactly(","+                \"Rate limit rule 'api' request-key 'tenant' is not a built-in key (ip, global, principal), header:<name> or custom:<identifier>; for the RateLimitKeyResolver bean annotated @Identifier(\\\"tenant\\\"), use custom:tenant\");","         assertThat(validate(g(\"request-key\"), \"header:\")).containsExactly(","-                \"Rate limit rule 'api' request-key 'header:' is not a built-in key: ip, principal, global or header:<name>\");","+                \"Rate limit rule 'api' request-key 'header:' is not a built-in key (ip, global, principal), header:<name> or custom:<identifier>\");","+        assertThat(validate(g(\"request-key\"), \"custom:\")).containsExactly(","+                \"Rate limit rule 'api' request-key 'custom:' is not a built-in key (ip, global, principal), header:<name> or custom:<identifier>\");","     }"," }"],"additions":12,"deletions":5,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/LongKeyTest.java","lines":["@@ -0,0 +1,95 @@","+package io.quarkus.http.ratelimit;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.net.URL;","+import java.util.List;","+import java.util.Map;","+import java.util.Optional;","+import java.util.concurrent.CopyOnWriteArrayList;","+","+import jakarta.enterprise.event.Observes;","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.smallrye.common.annotation.Identifier;","+import io.smallrye.mutiny.Uni;","+import io.vertx.core.Vertx;","+","+/**","+ * A key longer than 256 characters is replaced by its SHA-256 before it reaches the store, so that {@code max-keys}","+ * bounds the memory of the store; equal long keys still share a bucket. A test resolver supplies the raw header value","+ * because a built-in {@code header:} key holds the hash of the value already.","+ */","+public class LongKeyTest {","+","+    private static final String PREFIX = \"quarkus.http.rate-limit.api.\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest()","+            .withApplicationRoot(jar -> jar.addClasses(TestHttp.class, TestClient.class, TestHttp.Resource.class,","+                    RejectionObserver.class, TestKeyResolver.class))","+            .overrideConfigKey(PREFIX + \"paths\", \"/api/*\")","+            .overrideConfigKey(PREFIX + \"phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"request-key\", \"custom:test-key\")","+            .overrideRuntimeConfigKey(PREFIX + \"permits\", \"1\")","+            .overrideRuntimeConfigKey(PREFIX + \"window\", \"1m\");","+","+    @Inject","+    Vertx vertx;","+","+    @Inject","+    RejectionObserver observer;","+","+    @TestHTTPResource","+    URL url;","+","+    TestClient http;","+","+    @BeforeEach","+    void createClient() {","+        http = new TestClient(vertx, url);","+    }","+","+    @AfterEach","+    void closeClient() {","+        http.close();","+    }","+","+    @Test","+    void equalLongKeysShareABucketAndDifferentOnesDoNot() {","+        String first = \"a\".repeat(300);","+        String second = \"a\".repeat(299) + \"b\";","+        assertThat(http.get(\"/api/x\", Map.of(\"X-Test-Key\", first)).statusCode()).isEqualTo(200);","+        assertThat(http.get(\"/api/x\", Map.of(\"X-Test-Key\", first)).statusCode()).isEqualTo(429);","+        assertThat(http.get(\"/api/x\", Map.of(\"X-Test-Key\", second)).statusCode()).isEqualTo(200);","+        assertThat(observer.keys).singleElement().asString().matches(\"sha256:[0-9a-f]{64}\");","+    }","+","+    @Singleton","+    @Identifier(\"test-key\")","+    public static class TestKeyResolver implements RateLimitKeyResolver {","+","+        @Override","+        public Uni<Optional<String>> resolve(RateLimitContext context) {","+            return Uni.createFrom().item(Optional.ofNullable(context.routingContext().request().getHeader(\"X-Test-Key\")));","+        }","+    }","+","+    @Singleton","+    public static class RejectionObserver {","+","+        final List<String> keys = new CopyOnWriteArrayList<>();","+","+        void observe(@Observes RateLimitRejectionInfo rejection) {","+            keys.add(rejection.key());","+        }","+    }","+}"],"additions":95,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/NullKeyResolverTest.java","lines":["@@ -0,0 +1,80 @@","+package io.quarkus.http.ratelimit;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.net.URL;","+import java.util.Optional;","+","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.smallrye.common.annotation.Identifier;","+import io.smallrye.mutiny.Uni;","+import io.vertx.core.Vertx;","+","+/**","+ * A resolver that emits {@code null} instead of an {@link Optional} is handled like one that fails: the request is","+ * keyed by its client address and a warning is logged, rather than the request failing.","+ */","+public class NullKeyResolverTest {","+","+    private static final String RULE = \"quarkus.http.rate-limit.lenient.\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest()","+            .withApplicationRoot(jar -> jar.addClasses(TestHttp.class, TestClient.class, TestHttp.Resource.class,","+                    NullResolver.class))","+            .overrideConfigKey(RULE + \"paths\", \"/lenient/*\")","+            .overrideConfigKey(RULE + \"phase\", \"pre-authentication\")","+            .overrideConfigKey(RULE + \"request-key\", \"custom:null\")","+            .overrideRuntimeConfigKey(RULE + \"permits\", \"1\")","+            .overrideRuntimeConfigKey(RULE + \"window\", \"1m\")","+            .setLogRecordPredicate(r -> r.getLoggerName().startsWith(\"io.quarkus.http.ratelimit\"))","+            .assertLogRecords(records -> assertThat(records)","+                    .filteredOn(r -> r.getMessage().contains(\"key resolution failed\"))","+                    .singleElement()","+                    .satisfies(r -> assertThat(String.format(r.getMessage(), r.getParameters()))","+                            .isEqualTo(\"Rate limit rule 'lenient' key resolution failed; the request is keyed by its\"","+                                    + \" client address\")));","