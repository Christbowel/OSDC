its file_mounts gain the token.","+        keep_cluster_auth_token: Leave the cluster's current token in place,","+            for a head whose running Ray won't restart to pick up a new one.","+","+    Returns:","+        The temporary file holding a RAY_AUTH_TOKEN value, or None; keep it","+        open until the file mounts are synced. Then the token's SHA-256 hex","+        digest, or None when this process isn't in token auth mode or the YAML","+        mounts the token.","+    \"\"\"","+    if not _ships_local_auth_token(config):","+        return None, None","+    token = load_or_create_cluster_token()","+    token_sha256 = hashlib.sha256(token.encode()).hexdigest()","+    if keep_cluster_auth_token:","+        cli_logger.warning(","+            \"If your local auth token differs from the cluster's, `{}` leaves \"","+            \"the cluster's in place. Run `ray up` without it to replace it.\",","+            cf.bold(\"--no-restart\"),","+        )","+        return None, token_sha256","+","+    token_path = os.environ.get(\"RAY_AUTH_TOKEN_PATH\")","+    if not os.environ.get(\"RAY_AUTH_TOKEN\"):","+        # Mount the token file itself: Ray writes no copy of a token it can read","+        # from a file. rsync would copy a symlink as a dangling link.","+        source_path = os.path.realpath(token_path or _get_default_token_path())","+        # rsync keeps the file's mode, so the head's copy is as readable as this.","+        if os.stat(source_path).st_mode & 0o077:","+            cli_logger.warning(","+                \"The auth token file {} can be read by other users, and the \"","+                \"cluster's copy keeps its mode. Run `chmod 600 {}`.\",","+                source_path,","+                source_path,","+            )","+        config[\"file_mounts\"][AUTH_TOKEN_REMOTE_PATH] = source_path","+        return None, token_sha256","+","+    is_windows = sys.platform == \"win32\"","+    # NamedTemporaryFile creates the file with mode 0600.","+    token_file = tempfile.NamedTemporaryFile(","+        \"w\", prefix=\"ray-auth-token-\", delete=not is_windows","+    )","+    token_file.write(token)","+    token_file.flush()","+    if is_windows:","+        # rsync and scp can't open the file while it is open on Windows, so it","+        # is closed now and removed at exit, even when `ray up` fails.","+        token_file.close()","+        atexit.register(_remove_file_if_exists, token_file.name)","+    config[\"file_mounts\"][AUTH_TOKEN_REMOTE_PATH] = token_file.name","+    return token_file, token_sha256","+","+","+def _remove_file_if_exists(path: str) -> None:","+    with contextlib.suppress(FileNotFoundError):","+        os.remove(path)","+","+"," def _set_up_config_for_head_node(","-    config: Dict[str, Any], provider: NodeProvider, no_restart: bool","+    config: Dict[str, Any],","+    provider: NodeProvider,","+    no_restart: bool,","+    map_head_auth_token: bool,"," ) -> Tuple[Dict[str, Any], Any]:","     \"\"\"Prepares autoscaling config and, if needed, ssh key, to be mounted onto","     the Ray head node for use by the autoscaler.","@@ -1090,6 +1208,11 @@ def _set_up_config_for_head_node(","     new_mounts = {}","     for remote_path in config[\"file_mounts\"]:","         new_mounts[remote_path] = remote_path","+    if map_head_auth_token:","+        # The head keeps its own token file, which workers launched later need.","+        # A head started before token file mounts has none, and its autoscaler","+        # can't load this config until a `ray up` without --no-restart.","+        new_mounts[AUTH_TOKEN_REMOTE_PATH] = AUTH_TOKEN_REMOTE_PATH","     remote_config[\"file_mounts\"] = new_mounts","     remote_config[\"no_restart\"] = no_restart"," "],"additions":127,"deletions":4,"truncated":false},{"path":"python/ray/autoscaler/_private/fake_multi_node/command_runner.py","lines":["@@ -2,6 +2,10 @@"," import subprocess"," from typing import Dict, List, Tuple"," ","+from ray.autoscaler._private.auth_token import (","+    AUTH_TOKEN_REMOTE_PATH,","+    token_auth_enabled_locally,","+)"," from ray.autoscaler._private.docker import with_docker_exec"," from ray.autoscaler.command_runner import CommandRunnerInterface"," ","@@ -65,6 +69,10 @@ def run_rsync_down(self, source, target, options=None):","         self._run_shell(f\"docker cp {self.container_name}:{docker_dir} {target}\")"," ","     def run_rsync_up(self, source, target, options=None):","+        if target == AUTH_TOKEN_REMOTE_PATH and token_auth_enabled_locally():","+            # In token mode FakeMultiNodeDockerProvider mounts the token as a","+            # read-only volume, which `docker cp` cannot overwrite.","+            return","         docker_dir = os.path.dirname(self._docker_expand_user(target))","         self.run(cmd=f\"mkdir -p {docker_dir}\")"," "],"additions":8,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/_private/fake_multi_node/node_provider.py","lines":["@@ -14,6 +14,10 @@"," import ray"," import ray._private.ray_constants as ray_constants"," from ray._common.network_utils import build_address","+from ray.autoscaler._private.auth_token import (","+    load_local_token,","+    token_auth_enabled_locally,","+)"," from ray.autoscaler._private.fake_multi_node.command_runner import (","     FakeDockerCommandRunner,"," )","@@ -136,6 +140,7 @@ def create_node_spec(","     bootstrap_config_path: Optional[str] = None,","     private_key_path: Optional[str] = None,","     public_key_path: Optional[str] = None,","+    auth_token_path: Optional[str] = None,"," ):","     node_spec = copy.deepcopy(DOCKER_NODE_SKELETON)","     node_spec[\"image\"] = docker_image","@@ -222,6 +227,13 @@ def create_node_spec(","         f\"{host_dir(mounted_node_dir)}:/cluster/node\",","         f\"{host_dir(public_key_path)}:/home/ray/.ssh/authorized_keys\",","     ]","+    # `ray up`'s token file mount can't deliver the token here: worker updaters","+    # are disabled, and the head's `ray start` runs when its container starts,","+    # before `ray up` syncs files.","+    if auth_token_path:","+        node_spec[\"volumes\"].append(","+            f\"{host_dir(auth_token_path)}:/home/ray/.ray/auth_token:ro\"","+        )"," ","     # Pass these environment variables (to the head node)","     # These variables are propagated by the `docker compose` command.","@@ -234,6 +246,26 @@ def create_node_spec(","     return node_spec"," "," ","+def _write_cluster_auth_token(path: str) -> None:","+    \"\"\"Write the local token for the nodes to mount. Never creates one: every","+    CLI command that builds this provider, such as `ray down`, gets here.\"\"\"","+    token = load_local_token()","+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)","+    try:","+        try:","+            os.write(fd, token.encode())","+        finally:","+            os.close(fd)","+        if hasattr(os, \"getuid\") and os.getuid() == 0:","+            # Nodes run as the image's `ray` user (uid 1000) and the mount is","+            # read-only, so a root-owned 0600 token would be unreadable to them.","+            os.chown(path, 1000, -1)","+    except BaseException:","+        # A partial file would be reused by every later construction.","+        os.unlink(path)","+        raise","+","+"," class FakeMultiNodeProvider(NodeProvider):","     \"\"\"A node provider that implements multi-node on a single machine."," ","@@ -493,6 +525,13 @@ def __init__(self, provider_config, cluster_name):","         )","         self._docker_compose_config = None"," ","+        self._auth_token_path = None","+        # shortcut: in token mode this mounts the local token even when the","+        # cluster YAML mounts its own ~/.ray/auth_token, which the provider","+        # can't see. Pass the YAML's file_mounts in if a test needs it.","+        if token_auth_enabled_locally():","+            self._auth_token_path = os.path.join(self._volume_dir, \"auth_token\")","+","         self._node_state_path = os.path.join(self._volume_dir, \"nodes.json\")","         self._docker_status_path = os.path.join(self._volume_dir, \"status.json\")"," ","@@ -531,6 +570,17 @@ def _create_node_spec_with_resources("," ","         resource_str = json.dumps(resources, indent=None)"," ","+        # The docker monitor may start a node before the token is written, and","+        # Docker would create a missing bind mount source as a directory. Inside","+        # the head the host file always exists: `ray up` wrote it first.","+        auth_token_path = self._auth_token_path","+        if (","+            auth_token_path","+            and not self.in_docker_container","+            and not os.path.exists(auth_token_path)","+        ):","+            auth_token_path = None","+","         return create_node_spec(","             head=head,","             docker_image=self._docker_image,","@@ -554,6 +604,7 @@ def _create_node_spec_with_resources(","             bootstrap_config_path=self._boostrap_config_path,","             public_key_path=self._public_key_path,","             private_key_path=self._private_key_path,","+            auth_token_path=auth_token_path,","         )"," ","     def _load_node_state(self) -> bool:","@@ -704,6 +755,15 @@ def create_node_with_resources_and_labels(","             else:","                 next_id = self._next_hex_node_id()"," ","+            # Written on the first launch, by then `ray up` has created the","+            # local token. Later launches reuse it: nodes bind-mount the file.","+            if (","+                self._auth_token_path","+                and not self.in_docker_container","+                and not os.path.exists(self._auth_token_path)","+            ):","+                _write_cluster_auth_token(self._auth_token_path)","+","             self._nodes[next_id] = {","                 \"tags\": tags,","                 \"node_spec\": self._create_node_spec_with_resources("],"additions":60,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/_private/fake_multi_node/test_utils.py","lines":["@@ -183,7 +183,7 @@ def update_config(self, config: Optional[Dict[str, Any]] = None):","         if config:","             self._partial_config = config"," ","-        if not config.get(\"provider\", {}).get(\"image\"):","+        if not (self._partial_config or {}).get(\"provider\", {}).get(\"image\"):","             # No image specified, trying to parse from buildkite","             docker_image = os.environ.get(\"RAY_DOCKER_IMAGE\", None)"," "],"additions":1,"deletions":1,"truncated":false},{"path":"python/ray/tests/BUILD.bazel","lines":["@@ -712,6 +712,22 @@ py_test_module_list(","     ],"," )"," ","+py_test(","+    name = \"test_autoscaler_fake_docker_auth_token\",","+    size = \"large\",","+    srcs = [\"test_autoscaler_fake_docker_auth_token.py\"],","+    tags = [","+        \"custom_setup\",","+        \"exclusive\",","+        \"ha_integration\",","+        \"team:core\",","+    ],","+    deps = [","+        \":conftest\",","+        \"//:ray_lib\",","+    ],","+)","+"," py_test_module_list(","     size = \"medium\",","     files = [","@@ -785,6 +801,7 @@ py_test_module_list(","     size = \"medium\",","     files = [","         \"test_autoscaler.py\",","+        \"test_autoscaler_auth_token.py\",","         \"test_symmetric_run.py\",","     ],","     tags = ["],"additions":17,"deletions":0,"truncated":false},{"path":"python/ray/tests/test_autoscaler.py","lines":["@@ -537,6 +537,7 @@ def testHeadNodeConfigDropsSshProxyOptions(self):","             config,","             MockProvider(),","             no_restart=False,","+            map_head_auth_token=False,","         )"," ","         try:"],"additions":1,"deletions":0,"truncated":false},{"path":"python/ray/tests/test_autoscaler_auth_token.py","lines":["@@ -0,0 +1,565 @@","+import copy","+import os","+import re","+import sys","+from pathlib import Path","+from typing import Callable, Dict, Iterator, List, Optional, Tuple","+from unittest.mock import patch","+","+import pytest","+import yaml","+","+from ray._private.authentication_test_utils import reset_auth_token_state","+from ray.autoscaler._private import commands","+from ray.autoscaler._private.fake_multi_node.command_runner import (","+    FakeDockerCommandRunner,","+)","+from ray.autoscaler._private.fake_multi_node.node_provider import (","+    FakeMultiNodeDockerProvider,","+)","+from ray.autoscaler.tags import (","+    NODE_KIND_HEAD,","+    NODE_KIND_WORKER,","+    TAG_RAY_NODE_KIND,","+    TAG_RAY_USER_NODE_TYPE,","+)","+from ray.exceptions import AuthenticationError","+from ray.tests.autoscaler_test_utils import MockProcessRunner, MockProvider","+","+REMOTE_TOKEN_PATH = \"~/.ray/auth_token\"","+","+CLUSTER_CONFIG = {","+    \"cluster_name\": \"default\",","+    \"max_workers\": 2,","+    \"provider\": {\"type\": \"mock\"},","+    \"auth\": {\"ssh_user\": \"ubuntu\", \"ssh_private_key\": os.devnull},","+    \"available_node_types\": {","+        \"head\": {\"node_config\": {}, \"resources\": {\"CPU\": 1}, \"max_workers\": 0},","+        \"worker\": {\"node_config\": {}, \"resources\": {\"CPU\": 1}, \"max_workers\": 2},","+    },","+    \"head_node_type\": \"head\",","+    \"file_mounts\": {},","+    \"cluster_synced_files\": [],","+    \"initialization_commands\": [],","+    \"setup_commands\": [],","+    \"head_setup_commands\": [],","+    \"worker_setup_commands\": [],","+    \"head_start_ray_commands\": [\"start_ray_head\"],","+    \"worker_start_ray_commands\": [],","+}","+","+","+@pytest.fixture","+def clean_auth_env(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> Iterator[Path]:","+    \"\"\"An empty HOME and no token sources, with this process in token mode.\"\"\"","+    monkeypatch.setenv(\"HOME\", str(tmp_path / \"home\"))","+    for var in [\"RAY_AUTH_TOKEN\", \"RAY_AUTH_TOKEN_PATH\"]:","+        monkeypatch.delenv(var, raising=False)","+    set_local_auth_mode(monkeypatch, \"token\")","+    yield tmp_path","+    # Restore the caller's RAY_AUTH_MODE before refreshing the cached config.","+    monkeypatch.undo()","+    reset_auth_token_state()","+","+","+def set_local_auth_mode(monkeypatch: pytest.MonkeyPatch, mode: Optional[str]) -> None:","+    \"\"\"Set RAY_AUTH_MODE in this process, or unset it for None, and refresh the","+    cached RayConfig that get_authentication_mode reads.\"\"\"","+    if mode is None:","+        monkeypatch.delenv(\"RAY_AUTH_MODE\", raising=False)","+    else:","+        monkeypatch.setenv(\"RAY_AUTH_MODE\", mode)","+    reset_auth_token_state()","+","+","+class RayUpResult:","+    def __init__(","+        self,","+        runner: MockProcessRunner,","+        remote_config: Optional[dict],","+        token_uploads: List[Tuple[str, str, int]],","+    ):","+        self.runner = runner","+        self.remote_config = remote_config","+        # (source path, content, mode) of each upload to ~/.ray/auth_token,","+        # captured while the source still exists.","+        self.token_uploads = token_uploads","+","+","+def ray_up(","+    config: Optional[dict] = None,","+    no_monitor_on_head: bool = False,","+    no_restart: bool = False,","+    provider: Optional[MockProvider] = None,","+    script_runner: Optional[Callable[[MockProcessRunner], None]] = None,","+) -> RayUpResult:","+    config = copy.deepcopy(config or CLUSTER_CONFIG)","+    provider = provider or MockProvider()","+    remote_configs = []","+","+    def capture_remote_config(cluster_config):","+        remote_configs.append(copy.deepcopy(cluster_config))","+        return cluster_config","+","+    provider.prepare_for_head_node = capture_remote_config","+","+    token_uploads = []","+    runner = MockProcessRunner()","+","+    def capture_token_upload():","+        cmd = runner.calls[-1]","+        if cmd[0] != \"rsync\" or not cmd[-1].endswith(REMOTE_TOKEN_PATH):","+            return","+        source = cmd[-2]","+        assert \"/\" in source, cmd","+        with open(source) as f:","+            content = f.read()","+        token_uploads.append((source, content, os.stat(source).st_mode & 0o777))","+","+    runner.cmd_to_callback = {REMOTE_TOKEN_PATH: capture_token_upload}","+    if script_runner:","+        script_runner(runner)","+","+    commands.get_or_create_head_node(","+        config,","+        printable_config_file=\"cluster.yaml\",","+        no_restart=no_restart,","+        restart_only=False,","+        yes=True,","+        override_cluster_name=None,","+        no_monitor_on_head=no_monitor_on_head,","+        _provider=provider,","+        _runner=runner,","+    )","+    return RayUpResult(","+        runner, remote_configs[0] if remote_configs else None, token_uploads","+    )","+","+","+def test_generates_default_token_and_ships_it_to_head_and_workers(clean_auth_env):","+    result = ray_up()","+","+    default_token_path = clean_auth_env / \"home\" / \".ray\" / \"auth_token\"","+    assert default_token_path.read_text()","+    # Ray writes no copy of a token it can read from a file.","+    assert result.token_uploads == [","+        (str(default_token_path), default_token_path.read_text(), 0o600)","+    ]","+    assert result.remote_config[\"file_mounts\"][REMOTE_TOKEN_PATH] == REMOTE_TOKEN_PATH","+","+","+def test_ships_env_var_token_through_owner_only_temp_file(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"env-token\")","+","+    result = ray_up()","+","+    [(source, content, mode)] = result.token_uploads","+    assert (content, mode) == (\"env-token\", 0o600)","+    assert not os.path.exists(source)","+    assert not any(\"env-token\" in str(cmd) for cmd in result.runner.calls)","+    assert not (clean_auth_env / \"home\" / \".ray\" / \"auth_token\").exists()","+    assert result.remote_config[\"file_mounts\"][REMOTE_TOKEN_PATH] == REMOTE_TOKEN_PATH","+","+","+def test_ships_token_from_token_path(clean_auth_env, monkeypatch):","+    token_path = clean_auth_env / \"custom_token\"","+    token_path.write_text(\"path-token\")","+    token_path.chmod(0o600)","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN_PATH\", str(token_path))","+","+    result = ray_up()","+","+    assert result.token_uploads == [(str(token_path), \"path-token\", 0o600)]","+    assert not (clean_auth_env / \"home\" / \".ray\" / \"auth_token\").exists()","+","+","+# None (RAY_AUTH_MODE unset) means disabled until AUTH_MODE defaults to token.","+@pytest.mark.parametrize(\"auth_mode\", [\"disabled\", \"DISABLED\", \"none\", None])","+def test_disabled_auth_mode_ships_no_token(clean_auth_env, monkeypatch, auth_mode):","+    set_local_auth_mode(monkeypatch, auth_mode)","+","+    result = ray_up()","+","+    assert result.token_uploads == []","+    assert REMOTE_TOKEN_PATH not in result.remote_config[\"file_mounts\"]","+    assert not (clean_auth_env / \"home\" / \".ray\" / \"auth_token\").exists()","+","+","+def test_keeps_token_mount_from_cluster_yaml(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"env-token\")","+    user_token_path = clean_auth_env / \"user_token\"","+    user_token_path.write_text(\"yaml-token\")","+    user_token_path.chmod(0o600)","+    config = copy.deepcopy(CLUSTER_CONFIG)","+    config[\"file_mounts\"] = {REMOTE_TOKEN_PATH: str(user_token_path)}","+","+    result = ray_up(config)","+","+    assert result.token_uploads == [(str(user_token_path), \"yaml-token\", 0o600)]","+","+","+def test_ships_token_to_head_without_monitor(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"env-token\")","+","+    result = ray_up(no_monitor_on_head=True)","+","+    [(_, content, mode)] = result.token_uploads","+    assert (content, mode) == (\"env-token\", 0o600)","+","+","+def make_fake_docker_provider(volume_dir: Path) -> FakeMultiNodeDockerProvider:","+    return FakeMultiNodeDockerProvider(","+        {","+            \"project_name\": \"fake_docker\",","+            \"image\": \"rayproject/ray:nightly\",","+            \"head_resources\": {\"CPU\": 1},","+            \"shared_volume_dir\": str(volume_dir),","+        },","+        \"fake_docker\",","+    )","+","+","+def fake_docker_node_volumes(volume_dir: Path) -> Dict[str, List[str]]:","+    \"\"\"Launches a fake docker head, as `ray up` does, and one worker, and","+    returns each node's volumes.\"\"\"","+    provider = make_fake_docker_provider(volume_dir)","+    for kind in [NODE_KIND_HEAD, NODE_KIND_WORKER]:","+        provider.create_node_with_resources_and_labels(","+            {},","+            {TAG_RAY_NODE_KIND: kind, TAG_RAY_USER_NODE_TYPE: kind},","+            1,","+            {\"CPU\": 1},","+            {},","+        )","+    with open(volume_dir / \"docker-compose.yaml\") as f:","+        services = yaml.safe_load(f)[\"services\"]","+    return {node_id: spec[\"volumes\"] for node_id, spec in services.items()}","+","+","+def test_fake_docker_cluster_mounts_token_read_only(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_FAKE_CLUSTER\", \"1\")","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"env-token\")","+    volume_dir = clean_auth_env / \"fake_docker\"","+    volume_dir.mkdir()","+","+    node_volumes = fake_docker_node_volumes(volume_dir)","+","+    token_file = volume_dir / \"auth_token\"","+    assert token_file.read_text() == \"env-token\"","+    assert token_file.stat().st_mode & 0o777 == 0o600","+    assert len(node_volumes) == 2","+    for volumes in node_volumes.values():","+        assert f\"{token_file}:/home/ray/.ray/auth_token:ro\" in volumes","+","+","+def test_fake_docker_cluster_disabled_auth_mounts_no_token(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_FAKE_CLUSTER\", \"1\")","+    set_local_auth_mode(monkeypatch, \"disabled\")","+    volume_dir = clean_auth_env / \"fake_docker\"","+    volume_dir.mkdir()","+","+    node_volumes = fake_docker_node_volumes(volume_dir)","+","+    assert not (volume_dir / \"auth_token\").exists()","+    for volumes in node_volumes.values():","+        assert not any(v.endswith(\":/home/ray/.ray/auth_token:ro\") for v in volumes)","+","+","+def test_replaces_empty_default_token_before_shipping(clean_auth_env):","+    default_token_path = clean_auth_env / \"home\" / \".ray\" / \"auth_token\"","+    default_token_path.parent.mkdir(parents=True)","+    default_token_path.write_text(\"\")","+","+    result = ray_up()","+","+    [(_, content, mode)] = result.token_uploads","+    assert content and content == default_token_path.read_text()","+    assert mode == 0o600","+","+","+def test_ships_existing_default_token_unchanged(clean_auth_env):","+    default_token_path = clean_auth_env / \"home\" / \".ray\" / \"auth_token\"","+    default_token_path.parent.mkdir(parents=True)","+    default_token_path.write_text(\"existing-token\")","+","+    result = ray_up()","+","+    [(_, content, _)] = result.token_uploads","+    assert content == \"existing-token\"","+    assert default_token_path.read_text() == \"existing-token\"","+","+","+def test_rejects_whitespace_only_env_token(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"   \")","+","+    with pytest.raises(AuthenticationError, match=\"RAY_AUTH_TOKEN\") as error:","+        ray_up()","+    assert \"ray get-auth-token\" in str(error.value)","+    assert \"RAY_AUTH_MODE=disabled\" in str(error.value)","+    assert \"..\" not in str(error.value)","+","+","+def test_missing_token_path_error_names_the_fix(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN_PATH\", str(clean_auth_env / \"missing\"))","+","+    with pytest.raises(AuthenticationError, match=\"RAY_AUTH_TOKEN_PATH\") as error:","+        ray_up()","+    assert \"ray get-auth-token\" in str(error.value)","+    assert \"RAY_AUTH_MODE=disabled\" in str(error.value)","+","+","+def test_bad_token_source_launches_no_head(clean_auth_env, monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"   \")","+    provider = MockProvider()","+","+    wi