{"id":"efebbfa8ff83d926ad4583636d79224f58d2c33b","axis":"silent","repo":"ray-project/ray","sha":"efebbfa8ff83d926ad4583636d79224f58d2c33b","parsed":{"files":[{"path":".buildkite/core.rayci.yml","lines":["@@ -575,6 +575,7 @@ steps:","         --platform cpu --canonical-tag ha_integration","       - bazel run //ci/ray_ci:test_in_docker -- //python/ray/tests/... core --only-tags ha_integration","         --python-version 3.10 --build-name corebuild-py3.10","+        --test-env=RAY_TEMPDIR=/artifact-mount --test-env=RAY_HOSTDIR=/tmp/artifacts","     depends_on:","       - manylinux-x86_64","       - forge"],"additions":1,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/_private/auth_token.py","lines":["@@ -0,0 +1,63 @@","+import os","+","+from ray._raylet import (","+    AuthenticationMode,","+    AuthenticationTokenLoader,","+    get_authentication_mode,","+)","+from ray.exceptions import AuthenticationError","+","+AUTH_TOKEN_REMOTE_PATH = \"~/.ray/auth_token\"","+","+","+def token_auth_enabled_locally() -> bool:","+    \"\"\"Whether this process runs in token auth mode, so a launcher ships a token.","+","+    Until AUTH_MODE defaults to \"token\", an unset RAY_AUTH_MODE means disabled:","+    then nodes don't turn token mode on, and a shipped token would split a","+    cluster into a token-mode head and workers it rejects.","+    \"\"\"","+    return get_authentication_mode() == AuthenticationMode.TOKEN","+","+","+def load_local_token() -> str:","+    \"\"\"Return the local token, by the usual source precedence, without","+    creating one.","+","+    Returns:","+        The token.","+","+    Raises:","+        AuthenticationError: No token source holds a token, or","+            RAY_AUTH_TOKEN_PATH names a file that can't be read.","+    \"\"\"","+    token_loader = AuthenticationTokenLoader.instance()","+    token_loader.reset_cache()","+    if not token_loader.has_token(ignore_auth_mode=True):","+        raise AuthenticationError(\"No auth token found on this machine\")","+    return token_loader.get_raw_token(ignore_auth_mode=True)","+","+","+def load_or_create_cluster_token() -> str:","+    \"\"\"Return the local token, by the usual source precedence, for a launcher","+    that creates a cluster and ships it the token, such as `ray up`.","+","+    Creates ~/.ray/auth_token only when no token source holds a token.","+","+    Returns:","+        The token.","+","+    Raises:","+        AuthenticationError: RAY_AUTH_TOKEN is set but yields no token, or","+            RAY_AUTH_TOKEN_PATH names a file that can't be read or is empty.","+        RuntimeError: ~/.ray/auth_token can't be written.","+    \"\"\"","+    token_loader = AuthenticationTokenLoader.instance()","+    token_loader.reset_cache()","+    if not token_loader.has_token(ignore_auth_mode=True) and os.environ.get(","+        \"RAY_AUTH_TOKEN\"","+    ):","+        raise AuthenticationError(\"RAY_AUTH_TOKEN is set but yields no token\")","+    token_loader.create_token_if_missing()","+    token_loader.reset_cache()","+    return token_loader.get_raw_token(ignore_auth_mode=True)"],"additions":63,"deletions":0,"truncated":false},{"path":"python/ray/autoscaler/_private/commands.py","lines":["@@ -1,3 +1,5 @@","+import atexit","+import contextlib"," import copy"," import datetime"," import hashlib","@@ -12,14 +14,22 @@"," import time"," from concurrent.futures import ThreadPoolExecutor"," from types import ModuleType","-from typing import Any, Dict, List, Optional, Tuple, Union","+from typing import IO, Any, Dict, List, Optional, Tuple, Union"," "," import click"," import yaml"," "," import ray"," from ray._common.usage import usage_lib","+from ray._private.authentication.authentication_token_setup import (","+    _get_default_token_path,","+)"," from ray.autoscaler._private import subprocess_output_util as cmd_output_util","+from ray.autoscaler._private.auth_token import (","+    AUTH_TOKEN_REMOTE_PATH,","+    load_or_create_cluster_token,","+    token_auth_enabled_locally,","+)"," from ray.autoscaler._private.autoscaler import AutoscalerSummary"," from ray.autoscaler._private.cli_logger import cf, cli_logger"," from ray.autoscaler._private.cli_output_helpers import (","@@ -792,6 +802,13 @@ def get_or_create_head_node(","     creating_new_head = _should_create_new_head(","         head_node, launch_hash, head_node_type, provider","     )","+    # Resolve the token before launching a head, so a bad token source fails","+    # first. Keep auth_token_file open until the head updater has synced it.","+    # A digest with no token file mount means the cluster keeps its own token.","+    keep_cluster_auth_token = no_restart and not creating_new_head","+    auth_token_file, auth_token_sha256 = _add_auth_token_file_mount(","+        config, keep_cluster_auth_token","+    )","     if creating_new_head:","         with cli_logger.group(\"Acquiring an up-to-date head node\"):","             global_event_system.execute_callback(","@@ -834,19 +851,41 @@ def get_or_create_head_node(","         # cf.bold(provider.node_tags(head_node)[TAG_RAY_NODE_NAME]),","         _tags=dict(),","     ):  # add id, ARN to tags?","+        hashed_config = config","+        ships_auth_token = (","+            auth_token_sha256 is not None","+            and AUTH_TOKEN_REMOTE_PATH in config[\"file_mounts\"]","+        )","+        if ships_auth_token:","+            # The mount's source may be a temp file whose path changes on every","+            # run, so hash the token itself: a changed token, or a cluster that","+            # lacked it, syncs it.","+            hashed_config = {","+                **config,","+                \"file_mounts\": {","+                    remote: local","+                    for remote, local in config[\"file_mounts\"].items()","+                    if remote != AUTH_TOKEN_REMOTE_PATH","+                },","+                \"auth_token_sha256\": auth_token_sha256,","+            }","         # TODO(ekl) right now we