EST_DIR__/detach_same_name_modified.db' AS b","+","+statement ok","+CREATE TABLE b.tbl AS SELECT 1 AS i","+","+statement error","+DETACH b","+----","+outstanding work","+","+statement ok","+ROLLBACK","+","+statement ok","+BEGIN","+","+statement ok","+ATTACH '__TEST_DIR__/detach_same_name_read.db' AS c","+","+statement ok","+CREATE TABLE c.tbl AS SELECT 1 AS i","+","+statement ok","+COMMIT","+","+statement ok","+BEGIN","+","+query I","+SELECT * FROM c.tbl","+----","+1","+","+statement error","+DETACH c","+----","+outstanding work","+","+statement ok","+ROLLBACK"],"additions":77,"deletions":0,"truncated":false},{"path":"test/sql/copy/parquet/writer/parquet_write_interval.test","lines":["@@ -49,3 +49,13 @@ SELECT i = INTERVAL '580063 hours 44 minutes 54 seconds',"," FROM '{TEST_DIR}/large_interval.parquet'"," ----"," true\t0\t24169\t7\t44\t54","+","+# Intervals whose microseconds fit in the milliseconds field keep their days/micros split.","+statement ok","+COPY (SELECT INTERVAL 720 HOUR AS i, INTERVAL 36 HOUR AS j) TO '{TEST_DIR}/split_interval.parquet'","+","+query TIITII","+SELECT i::VARCHAR, datepart('day', i), datepart('hour', i), j::VARCHAR, datepart('day', j), datepart('hour', j)","+FROM '{TEST_DIR}/split_interval.parquet'","+----","+720:00:00\t0\t720\t36:00:00\t0\t36"],"additions":10,"deletions":0,"truncated":false},{"path":"test/sql/error/test_try_common_subexpression.test","lines":["@@ -0,0 +1,52 @@","+# name: test/sql/error/test_try_common_subexpression.test","+# description: TRY suppresses errors of sub-expressions that are shared with another TRY","+# group: [error]","+","+statement ok","+CREATE TABLE t AS SELECT 'bad' AS s, 0 AS z, '2x' AS ds, 'bad' AS s2;","+","+query II","+SELECT TRY(s::INTEGER) AS a, TRY(s::INTEGER + 5) AS b FROM t;","+----","+NULL\tNULL","+","+query II","+SELECT TRY(s::INTEGER) AS a, TRY(s::INTEGER * 2) AS b FROM t;","+----","+NULL\tNULL","+","+query II","+SELECT TRY(100 // z) AS a, TRY(100 // z + 1) AS b FROM t;","+----","+NULL\tNULL","+","+query II","+SELECT TRY(ds::DATE) AS a, TRY(ds::DATE + 1) AS b FROM t;","+----","+NULL\tNULL","+","+# shared sub-expression repeated outside of the TRY","+statement error","+SELECT s::INTEGER AS a, s::INTEGER + 1 AS b, TRY(s::INTEGER + 5) AS c FROM t;","+----","+Conversion Error","+","+# the sub-expression is shared between two TRY expressions and a non-erroring row","+query II","+SELECT TRY(x::INTEGER) AS a, TRY(x::INTEGER + 5) AS b FROM (VALUES ('1'), ('bad'), ('3')) v(x);","+----","+1\t6","+NULL\tNULL","+3\t8","+","+# identical TRY expressions are still shared","+query II","+SELECT TRY(s::INTEGER + 5) AS a, TRY(s::INTEGER + 5) AS b FROM t;","+----","+NULL\tNULL","+","+# aggregates","+query II","+SELECT sum(TRY(x::INTEGER)) AS a, sum(TRY(x::INTEGER + 5)) AS b FROM (VALUES ('1'), ('bad'), ('3')) v(x);","+----","+4\t14"],"additions":52,"deletions":0,"truncated":false},{"path":"test/sql/error/test_try_constant_regex.test","lines":["@@ -0,0 +1,73 @@","+# name: test/sql/error/test_try_constant_regex.test","+# description: TRY suppresses the error of an invalid constant regular expression","+# group: [error]","+","+statement ok","+CREATE TABLE t AS SELECT 'abc' AS s, '(' AS pat;","+","+query I","+SELECT TRY(regexp_matches(s, pat)) FROM t;","+----","+NULL","+","+query I","+SELECT TRY(regexp_matches('abc', '('));","+----","+NULL","+","+query I","+SELECT TRY(regexp_matches(s, '(')) FROM t;","+----","+NULL","+","+query IIIII","+SELECT TRY(regexp_full_match(s, '(')), TRY(regexp_replace(s, '(', 'x')), TRY(regexp_extract(s, '(')),","+       TRY(regexp_extract_all(s, '(')), TRY(regexp_split_to_array(s, '(')) FROM t;","+----","+NULL\tNULL\tNULL\tNULL\tNULL","+","+# a valid pattern is unaffected","+query I","+SELECT TRY(regexp_matches(s, 'b')) FROM t;","+----","+true","+","+# the error is only suppressed inside of TRY","+statement error","+SELECT regexp_matches(s, '(') FROM t;","+----","+Invalid Input Error: missing ): (","+","+statement error","+SELECT regexp_matches('abc', '(');","+----","+Invalid Input Error: missing ): (","+","+statement error","+SELECT regexp_replace(s, '(', 'x') FROM t;","+----","+Invalid Input Error: missing ): (","+","+statement ok","+CREATE TABLE e(s VARCHAR);","+","+statement error","+SELECT regexp_matches(s, '(') FROM e;","+----","+Invalid Input Error: missing ): (","+","+# the error of a function inside of TRY is thrown when it is evaluated","+query I","+SELECT TRY(CASE WHEN s = 'x' THEN regexp_matches(s, '(') ELSE true END) FROM t;","+----","+true","+","+query I","+SELECT TRY(CASE WHEN s = 'abc' THEN regexp_matches(s, '(') ELSE true END) FROM t;","+----","+NULL","+","+query I","+SELECT coalesce(TRY(regexp_matches(s, '(')), false) FROM t;","+----","+false"],"additions":73,"deletions":0,"truncated":false},{"path":"test/sql/function/list/generate_series_timestamp_range_end.test","lines":["@@ -0,0 +1,22 @@","+# name: test/sql/function/list/generate_series_timestamp_range_end.test","+# description: Timestamp series that end at the edge of the timestamp range","+# group: [list]","+","+query I","+SELECT * FROM generate_series(TIMESTAMP '294247-01-01', TIMESTAMP '294247-01-10', INTERVAL 3 DAY);","+----","+294247-01-01 00:00:00","+294247-01-04 00:00:00","+294247-01-07 00:00:00","+294247-01-10 00:00:00","+","+query I","+SELECT * FROM generate_series(TIMESTAMP '290309-12-23 (BC)', TIMESTAMP '290309-12-22 (BC)', INTERVAL '-1 day');","+----","+290309-12-23 (BC) 00:00:00","+290309-12-22 (BC) 00:00:00","+","+query I","+SELECT count(*) FROM range(TIMESTAMP '294247-01-01', TIMESTAMP '294247-01-10', INTERVAL 3 DAY);","+----","+3"],"additions":22,"deletions":0,"truncated":false},{"path":"test/sql/optimizer/remove_unused_columns_nested_struct_cast.test","lines":["@@ -0,0 +1,36 @@","+# name: test/sql/optimizer/remove_unused_columns_nested_struct_cast.test","+# description: Nested struct child referenced through a sub-path and a cast","+# group: [optimizer]","+","+require json","+","+statement ok","+CREATE TABLE t AS SELECT {'payload': {'x': 1}} AS s FROM range(1);","+","+query IT","+SELECT s.payload.x AS a, s.payload::VARCHAR AS b FROM t;","+----","+1\t{'x': 1}","+","+query IT","+SELECT s.payload::VARCHAR AS b, s.payload.x AS a FROM t;","+----","+{'x': 1}\t1","+","+query IT","+SELECT s.payload.x AS a, s.payload::JSON AS b FROM t;","+----","+1\t{\"x\":1}","+","+statement ok","+CREATE TABLE t2 AS SELECT {'payload': {'x': {'deep': 1}}} AS s FROM range(1);","+","+query IT","+SELECT s.payload.x.deep AS a, s.payload::VARCHAR AS b FROM t2;","+----","+1\t{'x': {'deep': 1}}","+","+query ITI","+SELECT s.payload.x.deep AS a, s.payload::VARCHAR AS b, s.payload.x.deep + 1 AS c FROM t2;","+----","+1\t{'x': {'deep': 1}}\t2"],"additions":36,"deletions":0,"truncated":false},{"path":"test/sql/order/limit_percent_cardinality_overflow.test","lines":["@@ -0,0 +1,17 @@","+# name: test/sql/order/limit_percent_cardinality_overflow.test","+# description: LIMIT PERCENT cardinality estimation must not overflow idx_t for a large child cardinality","+# group: [order]","+","+# cardinality estimation runs at plan time; a huge child cardinality must not overflow the idx_t cast","+statement ok","+EXPLAIN SELECT * FROM range(9223372036854775807) LIMIT 50 PERCENT;","+","+# the largest valid percentage against a huge child cardinality must also be safe","+statement ok","+EXPLAIN SELECT * FROM range(9223372036854775807) LIMIT 100 PERCENT;","+","+# normal percentages still produce the right number of rows","+query I","+SELECT count(*) FROM (SELECT * FROM range(100) LIMIT 50 PERCENT);","+----","+50"],"additions":17,"deletions":0,"truncated":false},{"path":"test/sql/settings/test_disabled_file_systems_whitespace.test","lines":["@@ -0,0 +1,13 @@","+# name: test/sql/settings/test_disabled_file_systems_whitespace.test","+# description: Test disabled file systems list entries with surrounding whitespace","+# group: [settings]","+","+require skip_reload","+","+statement ok","+SET disabled_filesystems='x, LocalFileSystem ';","+","