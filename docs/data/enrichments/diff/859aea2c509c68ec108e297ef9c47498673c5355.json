he shared legacy fixtures keep the legacy","+// format. Fixtures in the current format would let the fallback tests pass","+// without the fallback.","+func TestLegacyFixtures(t *testing.T) {","+\tfor name, schema := range map[string][]string{","+\t\t\"legacy-cluster-a\": {\"label:cluster\"},","+\t\t\"legacy-cluster-b\": {\"label:cluster\"},","+\t\t\"legacy-app\":       {\"label:app\"},","+\t} {","+\t\tt.Run(name+\" records its layout only in its logs sections\", func(t *testing.T) {","+\t\t\tdata, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"testdata\", \"legacy\", name+\".dataobj\"))","+\t\t\trequire.NoError(t, err)","+\t\t\tobj, err := dataobj.FromReaderAt(bytes.NewReader(data), int64(len(data)))","+\t\t\trequire.NoError(t, err)","+","+\t\t\trequire.Positive(t, obj.Sections().Count(streams.CheckSection))","+\t\t\tfor _, sec := range obj.Sections().Filter(streams.CheckSection) {","+\t\t\t\topened, err := streams.Open(t.Context(), sec)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\t_, ok, err := opened.Layout()","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.False(t, ok)","+\t\t\t}","+","+\t\t\tvar sections []*dataobj.Section","+\t\t\tfor _, sec := range obj.Sections().Filter(CheckSection) {","+\t\t\t\tsections = append(sections, sec)","+\t\t\t}","+\t\t\tgot, err := LegacyLayoutOf(t.Context(), sections)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.True(t, streams.NewLayout(streams.DefaultShardLayout(), schema).Equal(got), \"got layout %+v\", got)","+\t\t})","+\t}","+}","+","+func TestLegacyLayoutOf(t *testing.T) {","+\tlegacy := func(schemaLabels ...string) *datasetmd.SortInfo {","+\t\treturn &datasetmd.SortInfo{","+\t\t\tSchemaLabels: schemaLabels,","+\t\t\tStreamOrder:  datasetmd.STREAM_ORDER_STABLE_HASH_V1,","+\t\t\tShardCount:   streams.DefaultShardLayout().Buckets(),","+\t\t}","+\t}","+\tsections := func(t *testing.T, infos ...*datasetmd.SortInfo) []*dataobj.Section {","+\t\tt.Helper()","+\t\tobjBuilder := dataobj.NewBuilder(nil)","+\t\tfor _, info := range infos {","+\t\t\trequire.NoError(t, objBuilder.Append(&sortInfoSectionBuilder{info: info}))","+\t\t}","+\t\tobj, closer, err := objBuilder.Flush()","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(func() { _ = closer.Close() })","+\t\tvar out []*dataobj.Section","+\t\tfor _, sec := range obj.Sections().Filter(CheckSection) {","+\t\t\tout = append(out, sec)","+\t\t}","+\t\treturn out","+\t}","+\tclusterLayout := streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:cluster\"})","+","+\tt.Run(\"returns the layout that every section records\", func(t *testing.T) {","+\t\tgot, err := LegacyLayoutOf(t.Context(), sections(t, legacy(\"label:cluster\"), legacy(\"label:cluster\")))","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, clusterLayout.Equal(got))","+\t})","+","+\tt.Run(\"skips nil sections\", func(t *testing.T) {","+\t\tsecs := sections(t, legacy(\"label:cluster\"))","+\t\tgot, err := LegacyLayoutOf(t.Context(), []*dataobj.Section{nil, secs[0], nil})","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, clusterLayout.Equal(got))","+\t})","+","+\tt.Run(\"returns an error when the sections record different layouts\", func(t *testing.T) {","+\t\t_, err := LegacyLayoutOf(t.Context(), sections(t, legacy(\"label:cluster\"), legacy(\"label:app\")))","+\t\trequire.ErrorContains(t, err, \"different legacy layouts\")","+\t})","+","+\tt.Run(\"returns an error when a section records no legacy layout\", func(t *testing.T) {","+\t\t_, err := LegacyLayoutOf(t.Context(), sections(t, legacy(\"label:cluster\"), &datasetmd.SortInfo{}))","+\t\trequire.ErrorContains(t, err, \"no legacy layout\")","+\t})","+","+\tt.Run(\"returns an error when every section is nil\", func(t *testing.T) {","+\t\t_, err := LegacyLayoutOf(t.Context(), []*dataobj.Section{nil})","+\t\trequire.ErrorContains(t, err, \"records no layout\")","+\t})","+}","+","+// sortInfoSectionBuilder encodes a logs section with stream ID and timestamp","+// columns and the given sort info.","+type sor