crt\",","+\t\t\t\t\tSNI:        \"api.openai.com\",","+\t\t\t\t\tCredential: &GatewayServiceCredential{Mode: \"inject\", BindingID: \"openai-a\"},","+\t\t\t\t}},","+\t\t\t},","+\t\t\twantErr: \"credential injection is a consul enterprise feature\",","+\t\t},","+\t\t\"gateway credential injection without services rejected\": {","+\t\t\tentry: &TerminatingGatewayConfigEntry{","+\t\t\t\tKind:                TerminatingGateway,","+\t\t\t\tName:                \"camp-egress\",","+\t\t\t\tCredentialInjection: &GatewayCredentialInjection{UDSPath: \"/run/camp-auth/processor.sock\"},","+\t\t\t},","+\t\t\twantErr: \"credential injection is a consul enterprise feature\",","+\t\t},","+\t\t\"service credential rejected\": {","+\t\t\tentry: &TerminatingGatewayConfigEntry{","+\t\t\t\tKind: TerminatingGateway,","+\t\t\t\tName: \"camp-egress\",","+\t\t\t\tServices: []LinkedService{{","+\t\t\t\t\tName:       \"openai-a\",","+\t\t\t\t\tCredential: &GatewayServiceCredential{Mode: \"none\"},","+\t\t\t\t}},","+\t\t\t},","+\t\t\twantErr: `service \"openai-a\": credential injection is a consul enterprise feature`,","+\t\t},","+\t\t\"plain terminating gateway accepted\": {","+\t\t\tentry: &TerminatingGatewayConfigEntry{","+\t\t\t\tKind: TerminatingGateway,","+\t\t\t\tName: \"egress\",","+\t\t\t\tServices: []LinkedService{{","+\t\t\t\t\tName:   \"openai-a\",","+\t\t\t\t\tCAFile: \"/etc/ssl/certs/ca-certificates.crt\",","+\t\t\t\t\tSNI:    \"api.openai.com\",","+\t\t\t\t}},","+\t\t\t},","+\t\t},","+\t}","+","+\tfor name, tc := range cases {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\trequire.NoError(t, tc.entry.Normalize())","+\t\t\terr := tc.entry.Validate()","+\t\t\tif tc.wantErr == \"\" {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.EqualError(t, err, tc.wantErr)","+\t\t})","+\t}","+}"],"additions":82,"deletions":0,"truncated":false},{"path":"agent/structs/config_entry_routes.go","lines":["@@ -522,11 +522,20 @@ type ExtProcFilter struct {"," \tOverr