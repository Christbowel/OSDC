ngMiddleware(t *testing.T) {"," \t\t\t},"," \t\t}"," ","+\t\tt.Run(\"QueryChunkedData bypasses the cache entirely\", func(t *testing.T) {","+\t\t\tt.Cleanup(func() {","+\t\t\t\tcs.Reset()","+\t\t\t})","+","+\t\t\t// Even with a cache hit configured, chunked queries must not consult the cache.","+\t\t\tcs.ReturnHit = true","+\t\t\tcs.ReturnQueryResponse = dataResponse","+","+\t\t\terr := cdt.MiddlewareHandler.QueryChunkedData(req.Context(), &backend.QueryChunkedDataRequest{","+\t\t\t\tPluginContext: pluginCtx,","+\t\t\t}, nopChunkedWriter{})","+\t\t\tassert.NoError(t, err)","+\t\t\t// The caching service is never called for chunked queries","+\t\t\tcs.AssertCalls(t, \"HandleQueryRequest\", 0)","+\t\t\t// The request reached the underlying handler","+\t\t\tassert.NotNil(t, cdt.QueryChunkedDataReq)","+\t\t})","+"," \t\tt.Run(\"If cache returns a hit, no queries are issued\", func(t *testing.T) {"," \t\t\tt.Cleanup(func() {"," \t\t\t\tupdateCacheCalled = false"],"additions":19,"deletions":0,"truncated":false},{"path":"pkg/services/pluginsintegration/clientmiddleware/chunked_instrumentation.go","lines":["@@ -0,0 +1,100 @@","+package clientmiddleware","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"sync\"","+","+\t\"github.com/grafana/grafana-plugin-sdk-go/backend\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/genproto/pluginv2\"","+","+\t\"github.com/grafana/grafana/pkg/plugins/backendplugin/chunked\"","+\t\"github.com/grafana/grafana/pkg/plugins/instrumentationutils\"","+)","+","+// Ensure the wrapper forwards the RawChunkReceiver interface so the raw HTTP streaming","+// fast path (coreplugin type-asserts the writer to chunked.RawChunkReceiver) is preserved","+// through instrumentation. Without this the assertion fails, the raw writer is bypassed,","+// and frames are silently dropped.","+var _ chunked.RawChunkReceiver = (*errorRecordingChunkedWriter)(nil)","+","+// errorRecordingChunkedWriter wraps a backend.ChunkedDataWriter to record per-refID","+// errors streamed via WriteError. A chunked plugin can report partial failures","+// through the writer while returning a nil top-level error (see","+// chunked.ProcessTypedResponse), so instrumentation must inspect these streamed","+// errors to derive request status the same way QueryData inspects per-refID","+// DataResponse errors.","+type errorRecordingChunkedWriter struct {","+\tbackend.ChunkedDataWriter","+","+\tmu   sync.Mutex","+\terrs []chunkedRefError","+}","+","+type chunkedRefError struct {","+\trefID  string","+\tstatus backend.Status","+\terr    error","+}","+","+func (w *errorRecordingChunkedWriter) WriteError(ctx context.Context, refID string, status backend.Status, err error) error {","+\tif err != nil {","+\t\tw.mu.Lock()","+\t\tw.errs = append(w.errs, chunkedRefError{refID: refID, status: status, err: err})","+\t\tw.mu.Unlock()","+\t}","+\treturn w.ChunkedDataWriter.WriteError(ctx, refID, status, err)","+}","+","+// OnChunk keeps the wrapper transparent to the raw HTTP streaming path: coreplugin","+// type-asserts the writer to chunked.RawChunkReceiver and, on success, streams raw","+// bytes straight to the HTTP response. In that path per-refID failures arrive as","+// chunks carrying an Error rather than via WriteError, so record those here too","+// before forwarding, mirroring WriteError.","+func (w *errorRecordingChunkedWriter) OnChunk(chunk *pluginv2.QueryChunkedDataResponse) error {","+\traw, ok := w.ChunkedDataWriter.(chunked.RawChunkReceiver)","+\tif !ok {","+\t\treturn errors.New(\"chunked writer does not support raw chunks\")","+\t}","+\tif chunk != nil && chunk.Error != \"\" {","+\t\tw.mu.Lock()","+\t\tw.errs = append(w.errs, chunkedRefError{","+\t\t\trefID:  chunk.RefId,","+\t\t\tstatus: backend.Status(chunk.Status),","+\t\t\terr:    errors.New(chunk.Error),","+\t\t})","+\t\tw.mu.Unlock()","+\t}","+\treturn raw.OnChunk(chunk)","+}","+","+// requestStatus derives the overall request status, mirroring","+// instrumentationutils.RequestStatusFromQueryDataResponse: a non-nil top-level error","+// wins, otherwise the worst streamed per-refID error is used.","+func (w *errorRecordingChunkedWriter) requestStatus(err error) instrumentationutils.RequestStatus {","+\tif err != nil {","+\t\treturn instrumentationutils.RequestStatusFromError(err)","+\t}","+","+\tw.mu.Lock()","+\tdefer w.mu.Unlock()","+","+\tstatus := instrumentationutils.RequestStatusOK","+\tfor _, e := range w.errs {","+\t\tif s := instrumentationutils.RequestStatusFromError(e.err); s > status {","+\t\t\tstatus = s","+\t\t\tif status == instrumentationutils.RequestStatusError {","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t}","+\treturn status","+}","+","+// refErrors returns the per-refID errors streamed through WriteError. It must only be","+// called after the QueryChunkedData call has returned, when no more writes can occur.","+func (w *errorRecordingChunkedWriter) refErrors() []chunkedRefError {","+\tw.mu.Lock()","+\tdefer w.mu.Unlock()","+\treturn w.errs","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"pkg/services/pluginsintegration/clientmiddleware/chunked_instrumentation_test.go","lines":["@@ -0,0 +1,72 @@","+package clientmiddleware","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/grafana/grafana-plugin-sdk-go/backend\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/data\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/genproto/pluginv2\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/plugins/backendplugin/chunked\"","+\t\"github.com/grafana/grafana/pkg/plugins/instrumentationutils\"","+)","+","+// fakeRawChunkWriter mimics chunked.rawChunkWriter: it implements both","+// backend.ChunkedDataWriter and chunked.RawChunkReceiver, and only the OnChunk","+// path actually accepts writes (WriteFrame/WriteError are unsupported), matching","+// the real raw HTTP streaming writer used by the datasource apiserver.","+type fakeRawChunkWriter struct {","+\tchunks []*pluginv2.QueryChunkedDataResponse","+}","+","+var (","+\t_ backend.ChunkedDataWriter = (*fakeRawChunkWriter)(nil)","+\t_ chunked.RawChunkReceiver  = (*fakeRawChunkWriter)(nil)","+)","+","+func (w *fakeRawChunkWriter) OnChunk(chunk *pluginv2.QueryChunkedDataResponse) error {","+\tw.chunks = append(w.chunks, chunk)","+\treturn nil","+}","+","+func (w *fakeRawChunkWriter) WriteFrame(context.Context, string, string, *data.Frame) error {","+\treturn errors.New(\"WriteFrame not supported\")","+}","+","+func (w *fakeRawChunkWriter) WriteError(context.Context, string, backend.Status, error) error {","+\treturn errors.New(\"WriteError not supported\")","+}","+","+// The raw HTTP streaming fast path in coreplugin type-asserts the writer to","+// chunked.RawChunkReceiver; the instrumentation wrapper must stay transparent to","+// that assertion, otherwise the raw writer is bypassed and frames are dropped.","+func TestErrorRecordingChunkedWriterForwardsOnChunk(t *testing.T) {","+\traw := &fakeRawChunkWriter{}","+\tw := &errorRecordingChunkedWriter{ChunkedDataWriter: raw}","+","+\treceiver, ok := interface{}(w).(chunked.RawChunkReceiver)","+\trequire.True(t, ok, \"wrapper must satisfy chunked.RawChunkReceiver\")","+","+\trequire.NoError(t, receiver.OnChunk(&pluginv2.QueryChunkedDataResponse{RefId: \"A\"}))","+\trequire.NoError(t, receiver.OnChunk(&pluginv2.QueryChunkedDataResponse{","+\t\tRefId:  \"B\",","+\t\tError:  \"boom\",","+\t\tStatus: int32(backend.StatusBadRequest),","+\t}))","+","+\t// Chunks are forwarded to the underlying raw writer unchanged.","+\trequire.Len(t, raw.chunks, 2)","+\trequire.Equal(t, \"A\", raw.chunks[0].RefId)","+\trequire.Equal(t, \"B\", raw.chunks[1].RefId)","+","+\t// Per-refID errors carried in chunks are recorded so status derivation works on","+\t// the raw path, where errors never flow through WriteError.","+\terrs := w.refErrors()","+\trequire.Len(t, errs, 1)","+\trequire.Equal(t, \"B\", errs[0].refID)","+\trequire.Equal(t, backend.StatusBadRequest, errs[0].status)","+\trequire.Equal(t, instrumentationutils.RequestStatusError, w.requestStatus(nil))","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"pkg/services/pluginsintegration/clientmiddleware/clear_auth_headers_middleware.go","lines":["@@ -51,6 +51,16 @@ func (m *ClearAuthHeadersMiddleware) QueryData(ctx context.Context, req *backend"," \treturn m.BaseHandler.QueryData(ctx, req)"," }"," ","+func (m *ClearAuthHeadersMiddleware) QueryChunkedData(ctx context.Context, req *backend.QueryChunkedDataRequest, w backend.ChunkedDataWriter) error {","+\tif req == nil {","+\t\treturn m.BaseHandler.QueryChunkedData(ctx, req, w)","+\t}","+","+\tm.clearHeaders(ctx, req)","+","+\treturn m.BaseHandler.QueryChunkedData(ctx, req, w)","+}","+"," func (m *ClearAuthHeadersMiddleware) CallResource(ctx context.Context, req *backend.CallResourceRequest, sender backend.CallResourceResponseSender) error {"," \tif req == nil {"," \t\treturn m.BaseHandler.CallResource(ctx, req, sender)"],"additions":10,"deletions":0,"truncated":false},{"path":"pkg/services/pluginsintegration/clientmiddleware/clear_auth_headers_middleware_test.go","lines":["@@ -45,6 +45,22 @@ func TestClearAuthHeadersMiddleware(t *testing.T) {"," \t\t\trequire.Empty(t, cdt.QueryDataReq.GetHTTPHeaders())"," \t\t})"," ","+\t\tt.Run(\"Should clear auth headers when calling QueryChunkedData\", func(t *testing.T) {","+\t\t\terr = cdt.MiddlewareHandler.QueryChunkedData(req.Context(), &backend.QueryChunkedDataRequest{","+\t\t\t\tPluginContext: pluginCtx,","+\t\t\t\tHeaders: map[string]string{","+\t\t\t\t\totherHeader:           \"test\",","+\t\t\t\t\t\"Authorization\":       \"secret\",","+\t\t\t\t\t\"X-Grafana-Device-Id\": \"secret\",","+\t\t\t\t},","+\t\t\t}, nopChunkedWriter{})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NotNil(t, cdt.QueryChunkedDataReq)","+\t\t\trequire.Len(t, cdt.QueryChunkedDataReq.Headers, 1)","+\t\t\trequire.Equal(t, \"test\", cdt.QueryChunkedDataReq.Headers[other