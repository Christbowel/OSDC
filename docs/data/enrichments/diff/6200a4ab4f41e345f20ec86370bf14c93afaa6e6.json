{"id":"6200a4ab4f41e345f20ec86370bf14c93afaa6e6","axis":"silent","repo":"mlflow/mlflow","sha":"6200a4ab4f41e345f20ec86370bf14c93afaa6e6","parsed":{"files":[{"path":"docs/docs/genai/governance/ai-gateway/usage-tracking.mdx","lines":["@@ -25,6 +25,7 @@ Navigate to **AI Gateway > Usage** in the sidebar, or click the **Usage** tab on"," The dashboard provides the following charts:"," "," - **Requests** — Total request count over time with daily/hourly averages","+- **Usage by Feature** — Requests, tokens, and cost of each built-in MLflow feature that calls the endpoint (see [Usage by MLflow Feature](#usage-by-mlflow-feature))"," - **Latency** — Response time distribution (p50, p90, p99)"," - **Errors** — Error rate and error count breakdown"," - **Token Usage** — Input and output tokens over time","@@ -39,6 +40,7 @@ Note: Token usage and cost metrics are not supported for all LLM providers or mo"," Use the controls at the top of the dashboard to:"," "," - **Endpoint** — View all endpoints or filter to a specific one","+- **Filters** — Narrow the charts by request state, or by **Feature** to see the usage of a single built-in MLflow feature"," - **Time Unit** — Aggregate by hour, day, or week"," - **Time Range** — Select a preset range (last 7 days, 30 days, etc.) or a custom range"," ","@@ -47,3 +49,37 @@ Use the controls at the top of the dashboard to:"," Each endpoint's detail page also has a **Usage** tab that shows the same charts scoped to that endpoint, with a **View full dashboard** link to the main Usage page."," "," ![Endpoint Usage Tab](/images/genai/governance/ai-gateway/usage-tracking-endpoint-usage-tab.png)","+","+## Usage by MLflow Feature","+","+MLflow's built-in AI features call an LLM: LLM judges and scorers, the conversation simulator, issue detection, and prompt optimization. Point them at an AI Gateway endpoint with a `gateway:/<endpoint-name>` model URI, and their calls get the endpoint's governance, such as budgets, guardrails, and usage tracking:","+","+```python","+import mlflow","+from mlflow.genai.optimize.optimizers import GepaPromptOptimizer","+from mlflow.genai.scorers import Correctness","+from mlflow.genai.simulators import ConversationSimulator","+","+# Gateway endpoints are served by the MLflow tracking server.","+mlflow.set_tracking_uri(\"http://localhost:5000\")","+model = \"gateway:/my-endpoint\"","+","+# LLM judges and scorers","+correctness = Correctness(model=model)","+","+# Conversation simulator","+simulator = ConversationSimulator(test_cases=test_cases, user_model=model)","+","+# Prompt optimization","+optimizer = GepaPromptOptimizer(reflection_model=model)","+```","+","+For issue detection, select the endpoint as the model when you run or schedule detection.","+","+Each request is attributed to the feature that made it, and the **Usage by Feature** chart breaks the endpoint's requests, tokens, and cost down accordingly. Use **Filters > Feature** to scope every chart to one feature. The attribution follows these rules:","+","+- **Judges** covers the judges and scorers you configure, wherever they run, including when prompt optimization uses them to score candidate prompts.","+- **Issue detection** covers all of its analysis, including the judge it runs internally to triage traces.","+- **Other** covers requests that no MLflow feature made, such as calls from your applications or the playground. It also includes requests the gateway recorded without a caller, such as those from before it tracked callers.","+","+MLflow identifies the feature with the `X-MLflow-Gateway-Caller` request header, which the gateway records as the `mlflow.gateway.caller` metadata of each trace."],"additions":36,"deletions":0,"truncated":false},{"path":"mlflow/server/js/scripts/componentId-registry.js","lines":["@@ -1602,6 +1602,7 @@ module.exports = {","   \"mlflow.gateway.usage-modal.unified-view-mode\": \"\",","   \"mlflow.gateway.usage.breadcrumb_gateway_link\": \"\",","   \"mlflow.gateway.usage.endpoint-selector\": \"\",","+  \"mlflow.gateway.usage.feature_usage\": \"\",","   \"mlflow.gateway.usage.go_to_endpoints_link\": \"\",","   \"mlflow.gateway.usage.go_to_endpoints_link_logs\": \"\",","   \"mlflow.gateway.usage.tabs\": \"\","],"additions":1,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/common/components/MetricsFilter.utils.test.ts","lines":["@@ -11,6 +11,7 @@ jest.mock('@databricks/web-shared/model-trace-explorer', () => ({","   SESSION_ID_METADATA_KEY: 'mlflow.trace.session',","   MLFLOW_GIT_BRANCH_KEY: 'mlflow.source.git.branch',","   MLFLOW_GIT_COMMIT_KEY: 'mlflow.source.git.commit',","+  GATEWAY_CALLER_METADATA_KEY: 'mlflow.gateway.caller',","   TraceFilterKey: { STATUS: 'status', TAG: 'tag', METADATA: 'metadata' },","   TraceStatus: { IN_PROGRESS: 'IN_PROGRESS', OK: 'OK', ERROR: 'ERROR' },","   createTraceMetadataFilter: jest.fn((key: string, value: string) => `trace.metadata.\\`${key}\\` = \"${value}\"`),","@@ -23,6 +24,7 @@ jest.mock('@databricks/web-shared/genai-traces-table', () => ({","   STATE_COLUMN_ID: 'state',","   GIT_BRANCH_COLUMN_ID: 'git_branch',","   GIT_COMMIT_COLUMN_ID: 'git_commit',","+  CUSTOM_METADATA_COLUMN_ID: 'custom_metadata',","   FilterOperator: { EQUALS: '=' },"," }));"," ","@@ -197,3 +199,15 @@ describe('translateToTracesPageFilters', () => {","     ]);","   });"," });","+","+describe('gateway caller filter', () => {","+  const filters: MetricFilter[] = [{ column: 'gateway_caller', value: 'judge' }];","+","+  it('filters chart metrics on the gateway caller trace metadata', () => {","+    expect(translateToMetricsFilters(filters)).toEqual(['trace.metadata.`mlflow.gateway.caller` = \"judge\"']);","+  });","+","+  it('forwards to the traces table as a custom metadata filter', () => {","+    expect(translateToTracesPageFilters(filters)).toEqual(['custom_metadata:mlflow.gateway.caller::=::judge']);","+  });","+});"],"additions":14,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/common/components/MetricsFilter.utils.ts","lines":["@@ -1,4 +1,5 @@"," import {","+  CUSTOM_METADATA_COLUMN_ID,","   FilterOperator,","   GIT_BRANCH_COLUMN_ID,","   GIT_COMMIT_COLUMN_ID,","@@ -7,6 +8,7 @@ import {","   USER_COLUMN_ID,"," } from '@databricks/web-shared/genai-traces-table';"," import {","+  GATEWAY_CALLER_METADATA_KEY,","   MLFLOW_GIT_BRANCH_KEY,","   MLFLOW_GIT_COMMIT_KEY,","   MLFLOW_TRACE_USER_KEY,","@@ -22,7 +24,7 @@ import {","  * Add a new entry here AND in `COLUMN_TO_METRICS_FILTER_BUILDER` and","  * `COLUMN_TO_TRACES_COLUMN_ID` to expose more dimensions.","  */","-export type MetricFilterColumn = 'user' | 'session' | 'state' | 'git_branch' | 'git_commit';","+export type MetricFilterColumn = 'user' | 'session' | 'state' | 'git_branch' | 'git_commit' | 'gateway_caller';"," "," export interface MetricFilter {","   column: MetricFilterColumn;","@@ -55,6 +57,7 @@ const COLUMN_TO_METRICS_FILTER_BUILDER: Record<MetricFilterColumn, (value: strin","   state: (v) => createTraceFilter(TraceFilterKey.STATUS, v),","   git_branch: (v) => createTraceMetadataFilter(MLFLOW_GIT_BRANCH_KEY, v),","   git_commit: (v) => createTraceMetadataFilter(MLFLOW_GIT_COMMIT_KEY, v),","+  gateway_caller: (v) => createTraceMetadataFilter(GATEWAY_CALLER_METADATA_KEY, v),"," };"," "," /**","@@ -79,6 +82,7 @@ const COLUMN_TO_TRACES_COLUMN_ID: Record<MetricFilterColumn, string> = {","   state: STATE_COLUMN_ID,","   git_branch: GIT_BRANCH_COLUMN_ID,","   git_commit: GIT_COMMIT_COLUMN_ID,","+  gateway_caller: `${CUSTOM_METADATA_COLUMN_ID}:${GATEWAY_CALLER_METADATA_KEY}`,"," };"," "," /**"],"additions":5,"deletions":1,"truncated":false},{"path":"mlflow/server/js/src/gateway/components/GatewayChartsPanel.tsx","lines":["@@ -20,6 +20,7 @@ import {","   calculateDefaultTimeUnit,"," } from '../../experiment-tracking/pages/experiment-overview/utils/timeUtils';"," import { generateTimeBuckets } from '../../experiment-tracking/pages/experiment-overview/utils/chartUtils';","+import { GatewayFeatureUsageSummary } from './GatewayFeatureUsageSummary';"," "," interface GatewayChartsPanelProps {","   experimentIds: string[];","@@ -100,6 +101,8 @@ const GatewayChartsPanelImpl = ({","             title={<FormattedMessage defaultMessage=\"Requests\" description=\"Title for the requests chart in gateway\" />}","           />"," ","+          <GatewayFeatureUsageSummary />","+","           {/* Latency and Errors charts - side by side */}","           <ChartGrid>","             <LazyTraceLatencyChart />"],"additions":3,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/gateway/components/GatewayFeatureUsageSummary.test.tsx","lines":["@@ -0,0 +1,91 @@","+import { describe, it, expect } from '@jest/globals';","+import { screen } from '@testing-library/react';","+import userEvent from '@testing-library/user-event';","+import { rest } from 'msw';","+import { DesignSystemProvider } from '@databricks/design-system';","+import { QueryClient, QueryClientProvider } from '@mlflow/mlflow/src/common/utils/reactQueryHooks';","+import { getAjaxUrl } from '@mlflow/mlflow/src/common/utils/FetchUtils';","+import { renderWithIntl } from '../../common/utils/TestUtils.react18';","+import { setupServer } from '../../common/utils/setup-msw';","+import { OverviewChartProvider } from '../../experiment-tracking/pages/experiment-overview/OverviewChartContext';","+import { GatewayFeatureUsageSummary } from './GatewayFeatureUsageSummary';","+","+describe('GatewayFeatureUsageSummary', () => {","+  const server = setupServer();","+","+  const respondWith = (valuesByMetric: Record<string, Record<string, number>>) => {","+    server.use(","+      rest.post(getAjaxUrl('ajax-api/3.0/mlflow/traces/metrics'), async (req, res, ctx) => {","+        const body = await req.json();","+        const aggregation = body.aggregations[0].aggregation_type;","+        return res(","+          ctx.json({","+            data_points: Object.entries(valuesByMetric[body.metric_name] ?? {}).map(([caller, value]) => ({","+              metric_name: body.metric_name,","+              dimensions: { gateway_caller: caller },","+              values: { [aggregation]: value },","+            })),","+          }),","+        );","+      }),","+    );","+  };","+","+  const renderComponent = () =>","+    renderWithIntl(","+      <QueryClientProvider client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}>","+        <DesignSystemProvider>","+          <OverviewChartProvider experimentIds={['exp-1']} timeIntervalSeconds={3600} timeBuckets={[]}>","+            <GatewayFeatureUsageSummary />","+          </OverviewChartProvider>","+        </DesignSystemProvider>","+      </QueryClientProvider>,","+    );","+","+  const rowTexts = () =>","+    screen","+      .getAllByText(/^(Judges|Conversation simulator|Issue detection|Prompt optimization|Other)$/)","+      .map((cell) => cell.textContent);","+","+  it('lists usage for each MLflow feature, with other callers last', async () => {","+    respondWith({","+      trace_count: { judge: 12, issue_detection: 30, OpenAI: 50 },","+      total_tokens: { judge: 1800, issue_detection: 4500, OpenAI: 7500 },","+      total_cost: { judge: 0.5, issue_detection: 1.25, OpenAI: 2 },","+    });","+","+    renderComponent();","+","+    expect(await screen.findByText('Usage by Feature')).toBeInTheDocument();","+    // Sorted by requests, but \"Other\" stays last even though it has the most.","+    expect(rowTexts()).toEqual(['Issue detection', 'Judges', 'Other']);","+","+    expect(screen.getByText('30')).toBeInTheDocument();","+    expect(screen.getByText('4.50K')).toBeInTheDocument();","+    expect(screen.getByText('≈$1.25')).toBeInTheDocument();","+    expect(screen.queryByText(/gateway:\\/<endpoint-name>/)).not.toBeInTheDocument();","+  });","+","+  it('re-sorts features from a column header', async () => {","+    respondWith({","+      trace_count: { judge: 12, issue_detection: 30 },","+      total_tokens: { judge: 1800, issue_detection: 4500 },","+    });","+","+    renderComponent();","+    await screen.findByText('Usage by Feature');","+","+    await userEvent.click(screen.getByText('Feature'));","+","+    expect(rowTexts()).toEqual(['Judges', 'Issue detection']);","+  });","+","+  it('explains how to route MLflow features through the gateway when none have used it', async () => {","+    respondWith({ trace_count: { OpenAI: 50 }, total_tokens: { OpenAI: 7500 } });","+","+    renderComponent();","+","+    expect(await screen.findByText('Other')).toBeInTheDocument();","+    expect(screen.getByText(/as the model for judges, the conversation simulator/)).toBeInTheDocument();","+  });","+});"],"additions":91,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/gateway/components/GatewayFeatureUsageSummary.tsx","lines":["@@ -0,0 +1,173 @@","+import { useMemo } from 'react';","+import { SparkleDoubleIcon, Typography, useDesignSystemTheme } from '@databricks/design-system';","+import { FormattedMessage, useIntl } from 'react-intl';","+import {","+  estimatedCostMessages,","+  formatCostUSD,","+  formatEstimatedCostUSD,","+} from '@databricks/web-shared/model-trace-explorer';","+import { shouldEnableNewEvalRunsUi } from '../../common/utils/FeatureUtils';","+import {","+  OverviewChartContainer,","+  OverviewChartEmptyState,","+  OverviewChartErrorState,","+  OverviewChartHeader,","+  OverviewChartLoadingState,","+} from '../../experiment-tracking/pages/experiment-overview/components/OverviewChartComponents';","+import {","+  SortableHeader,","+  useSortState,","+  useSummaryTableStyles,","+} from '../../experiment-tracking/pages/experiment-overview/components/SummaryTableComponents';","+import { formatCount, useChartColors } from '../../experiment-tracking/pages/experiment-overview/utils/chartUtils';","+import { OTHER_CALLERS, useGatewayFeatureUsageData } from '../hooks/useGatewayFeatureUsageData';","+import { GATEWAY_FEATURES, GatewayFeatureLabels } from '../utils/gatewayFeatures';","+","+type SortColumn = 'feature' | 'requests' | 'tokens' | 'cost';","+","+// Matches the cost charts, which mark pricing-table costs as estimated.","+const formatCost = (cost: number): string =>","+  shouldEnableNewEvalRunsUi() ? formatEstimatedCostUSD(cost) : formatCostUSD(cost);","+","+const FeatureNameCell = ({ name, color }: { name: string; color: string }) => {","+  const { theme } = useDesignSystemTheme();","+  return (","+    <div css={{ display: 'flex', alignItems: 'center', gap: theme.spacing.sm, minWidth: 0 }}>","+      <div css={{ width: 8, height: 8, borderRadius: '50%', backgroundColor: color, flexShrink: 0 }} />","+      <Typography.Text css={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>","+        {name}","+      </Typography.Text>","+    </div>","+  );","+};","+","+const RouteFeaturesHint = () => (","+  <FormattedMessage","+    defaultMessage=\"To track their usage here, use {modelUri} as the model for judges, the conversation simulator, issue detection or prompt optimization.\"","+    description=\"Gateway usage > usage by feature > hint for routing MLflow features through an endpoint\"","+    values={{ modelUri: <code>gateway:/&lt;endpoint-name&gt;</code> }}","+  />","+);","+","+/**","+ * Gateway requests, tokens and cost for each built-in MLflow feature (LLM judges, the","+ * conversation simulator, issue detection and prompt optimization), with every other caller","+ * combined into an \"Other\" row.","+ */","+export const GatewayFeatureUsageSummary = () => {","+  const { theme } = useDesignSystemTheme();","+  const intl = useIntl();","+  const { getChartColor } = useChartColors();","+  const { sortColumn, sortDirection, handleSort } = useSortState<SortColumn>('requests');","+  const { headerRowStyle, bodyRowStyle, cellStyle } = useSummaryTableStyles('minmax(120px, 2fr) 1fr 1fr 1fr');","+  const { usage, hasFeatureUsage, isLoading, error } = useGatewayFeatureUsageData();","+","+  const rows = useMemo(() => {","+    const labelOf = (feature: string) =>","+      feature === OTHER_CALLERS","+        ? intl.formatMessage({","+            defaultMessage: 'Other',","+            description: 'Gateway usage > usage by feature > row for requests not made by an MLflow feature',","+          })","+        : intl.formatMessage(GatewayFeatureLabels[feature as keyof typeof GatewayFeatureLabels]);","+","+    const labeled = usage.map((row) => ({ ...row, label: labelOf(row.feature) }));","+    const features = labeled.filter(({ feature }) => feature !== OTHER_CALLERS);","+    features.sort((a, b) => {","+      const comparison = sortColumn === 'feature' ? a.label.localeCompare(b.label) : a[sortColumn] - b[sortColumn];","+      return sortDirection === 'asc' ? comparison : -comparison;","+    });","+    // \"Other\" is not a feature, so it stays last regardless of the sort.","+    return [...features, ...labeled.filter(({ feature }) => feature === OTHER_CALLERS)];","+  }, [usage, sortColumn, sortDirection, intl]);","+","+  if (isLoading) {","+    return <OverviewChartLoadingState />;","+  }","+","+  if (error) {","+    return <OverviewChartErrorState />;","+  }","+","+  const sortableHeader = (column: SortColumn, label: React.ReactNode, centered = true) => (","+    <SortableHeader","+      column={column}","+      sortColumn={sortColumn}","+      sortDirection={sortDirection}","+      onSort={handleSort}","+      centered={centered}","+    >","+      {label}","+    </SortableHeader>","+  );","+","+  return (","+    <OverviewChartContainer componentId=\"mlflow.gateway.usage.feature_usage\">","+      <OverviewChartHeader","+        icon={<SparkleDoubleIcon />}","+        title={","+          <FormattedMessage","+            defaultMessage=\"Usage by Feature\"","+            description=\"Title for the gateway usage breakdown by built-in MLflow feature\"","+          />","+        }","+      />","+","+      {rows.length > 0 ? (","+        <div css={{ display: 'flex', flexDirection: 'column' }}>","+          <div css={headerRowStyle}>","+            {sortableHeader(","+              'feature',","+              <FormattedMessage defaultMessage=\"Feature\" description=\"Column header for the MLflow feature name\" />,","+              false,","+            )}","+            {sortableHeader(","+              'requests',","+              <FormattedMessage defaultMessage=\"Requests\" description=\"Column header for gateway request count\" />,","+            )}","+            {sortableHeader(","+              'tokens',","+              <FormattedMessage defaultMessage=\"Tokens\" description=\"Column header for gateway token count\" />,","+            )}","+            {sortableHeader(","+              'cost',","+              <FormattedMessage defaultMessage=\"Cost\" description=\"Column header for gateway cost\" />,","+            )}","+          </div>","+          {rows.map((row) => (","+            <div key={row.feature} css={bodyRowStyle}>","+              <FeatureNameCell","+                name={row.label}","+                color={","+                  row.feature === OTHER_CALLERS","+                    ? theme.colors.grey400","+                    : getChartColor(GATEWAY_FEATURES.indexOf(row.feature))","+                }","+              />","+              <Typography.Text css={cellStyle}>{formatCount(row.requests)}</Typography.Text>","+              <Typography.Text css={cellStyle}>{formatCount(row.tokens)}</Typography.Text>","+              <Typography.Text css={cellStyle}>{formatCost(row.cost)}</Typography.Text>","+            </div>","+          ))}","+        </div>","+      ) : (","+        <OverviewChartEmptyState height={120} />","+      )}","+","+      {(!hasFeatureUsage || shouldEnableNewEvalRunsUi()) && (","+        <div css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.xs, marginTop: theme.spacing.sm }}>","+          {!hasFeatureUsage && (","+            <Typography.Text size=\"sm\" color=\"secondary\">","+              <RouteFeaturesHint />","+            </Typography.Text>","+          )}","+          {shouldEnableNewEvalRunsUi() && (","+            <Typography.Text size=\"sm\" color=\"secondary\">","+              <FormattedMessage {...estimatedCostMessages.tooltip} />","+            </Typography.Text>","+          )}","+        </div>","+      )}","+    </OverviewChartContainer>","+  );","+};"],"additions":173,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/gateway/components/edit-endpoint/EditEndpointFormRenderer.tsx","lines":["@@ -31,6 +31,7 @@ import { EditableEndpointName } from './EditableEndpointName';"," import { GatewayUsageSection } from './GatewayUsageSection';"," import type { Endpoint, EndpointModelMapping } from '../../types';"," import { hasMixedTypeSafeProviders } from '../../utils/gatewayUtils';","+import { getGatewayFeatureFilterOption } from '../../utils/gatewayFeatures';"," import { GuardrailsTabContent } from '../guardrails/GuardrailsTabContent';"," import { TracesV3Logs } from '../../../experiment-tracking/components/experiment-page/components/traces-v3/TracesV3Logs';"," import { MonitoringConfigProvider } from '../../../experiment-tracking/hooks/useMonitoringConfig';","@@ -171,6 +172,7 @@ export const EditEndpointFormRenderer = ({","           label: intl.formatMessage(ExperimentViewTracesStatusLabels[value]),","         })),","       },","+      getGatewayFeatureFilterOption(intl),","     ],","     [intl],","   );"],"additions":2,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/gateway/hooks/useGatewayFeatureUsageData.test.tsx","lines":["@@ -0,0 +1,167 @@","+import { describe, it, expect, beforeEach } from '@jest/globals';","+import { renderHook, waitFor } from '@testing-library/react';","+import type { ReactNode } from 'react';","+import { rest } from 'msw';","+import { QueryClient, QueryClientProvider } from '@mlflow/mlflow/src/common/utils/reactQueryHooks';","+import { getAjaxUrl } from '@mlflow/mlflow/src/common/utils/FetchUtils';","+import { setupServer } from '../../common/utils/setup-msw';","+import { OverviewChartProvider } from '../../experiment-tracking/pages/experiment-overview/OverviewChartContext';","+import { OTHER_CALLERS, useGatewayFeatureUsageData } from './useGatewayFeatureUsageData';","+","+type ValuesByCaller = Record<string, number>;","+","+describe('useGatewayFeatureUsageData', () => {","+  const server = setupServer();","+  let capturedRequests: any[] = [];","+","+  // Queries grouped by caller get a data point per caller. Ungrouped totals default to the sum over","+  // the callers; `totals` overrides them to include traces that have no caller.","+  const respondWith = (valuesByMetric: Record<string, ValuesByCaller>, totals: Record<string, number> = {}) => {","+    server.use(","+      rest.post(getAjaxUrl('ajax-api/3.0/mlflow/traces/metrics'), async (req, res, ctx) => {","+        const body = await req.json();","+        capturedRequests.push(body);","+        const aggregation = body.aggregations[0].aggregation_type;","+        const values: ValuesByCaller = valuesByMetric[body.metric_name] ?? {};","+        if (!body.dimensions?.includes('gateway_caller')) {","+          const total = totals[body.metric_name] ?? Object.values(values).reduce((sum, value) => sum + value, 0);","+          return res(","+            ctx.json({","+              data_points: [{ metric_name: body.metric_name, dimensions: {}, values: { [aggregation]: total } }],","+            }),","+          );","+        }","+        return res(","+          ctx.json({","+            data_points: Object.entries(values).map(([caller, value]) => ({","+              metric_name: body.metric_name,","+              dimensions: { gateway_caller: caller },","+              values: { [aggregation]: value },","+            })),","+          }),","+        );","+      }),","+    );","+  };","+","+  const wrapper = ({ children }: { children: ReactNode }) => (","+    <QueryClientProvider client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}>","+      <OverviewChartProvider","+        experimentIds={['exp-1']}","+        startTimeMs={1000}","+        endTimeMs={2000}","+        timeIntervalSeconds={3600}","+        timeBuckets={[]}","+        filters={['trace.status = \"OK\"']}","+      >","+        {children}","+      </OverviewChartProvider>","+    </QueryClientProvider>","+  );","+","+  beforeEach(() => {","+    capturedRequests = [];","+  });","+","+  it('breaks usage down by MLflow feature and combines every other caller', async () => {","+    respondWith({","+      trace_count: { simulator: 4, judge: 12, OpenAI: 3, Mozilla: 2 },","+      total_tokens: { simulator: 600, judge: 1800, OpenAI: 450, Mozilla: 300 },","+      total_cost: { simulator: 0.125, judge: 0.5, OpenAI: 0.25, Mozilla: 0.5 },","+    });","+","+    const { result } = renderHook(() => useGatewayFeatureUsageData(), { wrapper });","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+","+    expect(result.current.usage).toEqual([","+      { feature: 'judge', requests: 12, tokens: 1800, cost: 0.5 },","+      { feature: 'simulator', requests: 4, tokens: 600, cost: 0.125 },","+      { feature: OTHER_CALLERS, requests: 5, tokens: 750, cost: 0.75 },","+    ]);","+    expect(result.current.hasFeatureUsage).toBe(true);","+  });","+","+  it('counts gateway traces without a caller as other usage', async () => {","+    // Grouping by caller leaves out traces without one, such as requests sent with neither a caller","+    // header nor a User-Agent, but the totals the other charts show include them.","+    respondWith(","+      {","+        trace_count: { judge: 2, OpenAI: 1 },","+        total_tokens: { judge: 300, OpenAI: 150 },","+        total_cost: { judge: 0.5, OpenAI: 0.25 },","+      },","+      { trace_count: 5, total_tokens: 750, total_cost: 1.25 },","+    );","+","+    const { result } = renderHook(() => useGatewayFeatureUsageData(), { wrapper });","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+","+    expect(result.current.usage).toEqual([","+      { feature: 'judge', requests: 2, tokens: 300, cost: 0.5 },","+      { feature: OTHER_CALLERS, requests: 3, tokens: 450, cost: 0.75 },","+    ]);","+  });","+","+  it('leaves out other usage when MLflow features made every request', async () => {","+    respondWith({ trace_count: { judge: 2 }, total_tokens: { judge: 300 }, total_cost: { judge: 0.1 } });","+","+    const { result } = renderHook(() => useGatewayFeatureUsageData(), { wrapper });","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+","+    expect(result.current.usage).toEqual([{ feature: 'judge', requests: 2, tokens: 300, cost: 0.1 }]);","+  });","+","+  it('queries usage by gateway caller and the totals within the chart filters', async () => {","+    respondWith({});","+","+    const { result } = renderHook(() => useGatewayFeatureUsageData(), { wrapper });","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+","+    expect(","+      // None of these queries are time-bucketed: a bucketed total can be cut off by the metrics API's","+      // result limit while the feature counts cover the whole range.","+      capturedRequests.map(({ view_type, metric_name, dimensions, filters, time_interval_seconds }) => ({","+        view_type,","+        metric_name,","+        dimensions,","+        filters,","+        time_interval_seconds,","+      })),","+    ).toEqual(","+      expect.arrayContaining([","+        {","+          view_type: 'TRACES',","+          metric_name: 'trace_count',","+          dimensions: ['gateway_caller'],","+          filters: ['trace.status = \"OK\"'],","+        },","+        {","+          view_type: 'TRACES',","+          metric_name: 'total_tokens',","+          dimensions: ['gateway_caller'],","+          filters: ['trace.status = \"OK\"'],","+        },","+        {","+          view_type: 'SPANS',","+          metric_name: 'total_cost',","+          dimensions: ['gateway_caller'],","+          filters: ['trace.status = \"OK\"'],","+        },","+        { view_type: 'TRACES', metric_name: 'trace_count', dimensions: undefined, filters: ['trace.status = \"OK\"'] },","+        { view_type: 'TRACES', metric_name: 'total_tokens', dimensions: undefined, filters: ['trace.status = \"OK\"'] },","+        { view_type: 'SPANS', metric_name: 'total_cost', dimensions: undefined, filters: ['trace.status = \"OK\"'] },","+      ]),","+    );","+    expect(result.current.usage).toEqual([]);","+  });","+","+  it('reports no feature usage when only other callers used the gateway', async () => {","+    respondWith({ trace_count: { OpenAI: 3 }, total_tokens: { OpenAI: 450 } });","+","+    const { result } = renderHook(() => useGatewayFeatureUsageData(), { wrapper });","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+","+    expect(result.current.usage).toEqual([{ feature: OTHER_CALLERS, requests: 3, tokens: 450, cost: 0 }]);","+    expect(result.current.hasFeatureUsage).toBe(false);","+  });","+});"],"additions":167,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/gateway/hooks/useGatewayFeatureUsageData.ts","lines":["@@ -0,0 +1,155 @@","+import { useMemo } from 'react';","+import {","+  AggregationType,","+  MetricViewType,","+  SpanDimensionKey,","+  SpanMetricKey,","+  TraceDimensionKey,","+  TraceMetricKey,","+  type MetricDataPoint,","+} from '@databricks/web-shared/model-trace-explorer';","+import { useTraceMetricsQuery } from '../../experiment-tracking/pages/experiment-overview/hooks/useTraceMetricsQuery';","+import { useOverviewChartContext } from '../../experiment-tracking/pages/experiment-overview/OverviewChartContext';","+import { GATEWAY_FEATURES, isGatewayFeature, type GatewayFeature } from '../utils/gatewayFeatures';","+","+/**","+ * Requests no built-in MLflow feature made, such as calls from applications or the playground, and","+ * requests recorded without a caller.","+ */","+export const OTHER_CALLERS = 'other';","+","+export type GatewayFeatureUsageKey = GatewayFeature | typeof OTHER_CALLERS;","+","+export interface GatewayFeatureUsage {","+  feature: GatewayFeatureUsageKey;","+  requests: number;","+  tokens: number;","+  cost: number;","+}","+","+const sumByFeature = (","+  dataPoints: MetricDataPoint[] | undefined,","+  dimensionKey: string,","+  aggregation: AggregationType,","+): Map<GatewayFeature, number> => {","+  const totals = new Map<GatewayFeature, number>();","+  for (const dataPoint of dataPoints ?? []) {","+    const caller = dataPoint.dimensions?.[dimensionKey];","+    if (!caller || !isGatewayFeature(caller)) continue;","+    totals.set(caller, (totals.get(caller) ?? 0) + (dataPoint.values?.[aggregation] ?? 0));","+  }","+  return totals;","+};","+","+const sumValues = (dataPoints: MetricDataPoint[] | undefined, aggregation: AggregationType): number =>","+  (dataPoints ?? []).reduce((sum, dataPoint) => sum + (dataPoint.values?.[aggregation] ?? 0), 0);","+","+/**","+ * Gateway requests, tokens and cost broken down by the built-in MLflow feature that made them.","+ * The `OTHER_CALLERS` entry is the rest of the totals rather than a sum of the other callers,","+ * because grouping by caller leaves out traces that have none, and the rows should add up to the","+ * totals shown by the other charts."],"additions":51,"deletions":0,"truncated":false}],"additions":543,"deletions":1,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-16T17:23:18.502869+00:00"}