d := range []string{http.MethodGet, http.MethodDelete} {","+\t\t\treq := httptest.NewRequest(method, \"/\", http.NoBody)","+\t\t\treq.Header.Set(\"Accept\", \"text/event-stream\")","+\t\t\treq.Header.Set(\"Mcp-Session-Id\", \"not-a-session\")","+\t\t\trr := httptest.NewRecorder()","+\t\t\th.ServeHTTP(rr, req)","+\t\t\tassert.Equal(t, http.StatusMethodNotAllowed, rr.Code, method)","+\t\t\tassert.Equal(t, \"POST\", rr.Header().Get(\"Allow\"), method)","+\t\t}","+\t})","+}","+","+func TestNewHandler_JSONResponse(t *testing.T) {","+\tinitialize := `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0\"}}}`","+\tsvc := querysvc.NewQueryService(&tracestoremocks.Reader{}, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\ttenancyMgr := tenancy.NewManager(&tenancy.Options{})","+\tcontentType := func(t *testing.T, h http.Handler) string {","+\t\treq := httptest.NewRequest(http.MethodPost, \"/\", strings.NewReader(initialize))","+\t\treq.Header.Set(\"Content-Type\", \"application/json\")","+\t\treq.Header.Set(\"Accept\", \"application/json, text/event-stream\")","+\t\trr := httptest.NewRecorder()","+\t\th.ServeHTTP(rr, req)","+\t\trequire.Equal(t, http.StatusOK, rr.Code)","+\t\treturn rr.Header().Get(\"Content-Type\")","+\t}","+","+\tt.Run(\"default answers with an event stream\", func(t *testing.T) {","+\t\th := NewHandler(telemetry.NoopSettings(), svc, tenancyMgr, DefaultServerParams())","+\t\tassert.Equal(t, \"text/event-stream\", contentType(t, h))","+\t})","+","+\tt.Run(\"json_response answers with a JSON body\", func(t *testing.T) {","+\t\tparams := DefaultServerParams()","+\t\tparams.StreamableHTTP.JSONResponse = true","+\t\th := NewHandler(telemetry.NoopSettings(), svc, tenancyMgr, params)","+\t\tassert.Equal(t, \"application/json\", contentType(t, h))","+\t})","+","+\tt.Run(\"go-sdk client completes a session against the JSON form\", func