{"id":"00bcbe488e627b60c91e9e244a8ab21bd8dd1e8d","axis":"silent","repo":"jaegertracing/jaeger","sha":"00bcbe488e627b60c91e9e244a8ab21bd8dd1e8d","parsed":{"files":[{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/jaegerai/endpoint_turn_mcp.go","lines":["@@ -35,9 +35,8 @@ const ("," "," // mcpRouteIDContextKey carries the URL route id from ServeHTTP into the"," // UI-dispatch middleware. ServeHTTP stamps it on the request context before","-// delegating to the streamable handler; the go-sdk propagates the initialize","-// request's context values onto the resulting ServerSession, so every later","-// tools/list and tools/call for that turn can recover the id here.","+// delegating to the MCP handler, which serves each tools/list and tools/call","+// from that request's own context."," type mcpRouteIDContextKey struct{}"," "," // mcpRouteIDFromContext returns the URL route id stamped by ServeHTTP, or \"\"","@@ -56,6 +55,9 @@ type turnScopedEndpoint struct {"," \t// streamable is the telemetry MCP endpoint's handler, which the query server"," \t// built and still owns. Serving it here means both mounts share one *mcp.Server,"," \t// so the telemetry tools are registered once and this endpoint closes nothing.","+\t// The handler keeps no session between requests and issues no session id, so","+\t// each tool call is served from its own request and nothing outlives it that","+\t// another request could name."," \tstreamable http.Handler"," \tturns      *turnRegistry"," \tbasePath   string"],"additions":5,"deletions":3,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/jaegerai/endpoint_turn_mcp_test.go","lines":["@@ -8,6 +8,7 @@ import ("," \t\"encoding/json\""," \t\"net/http\""," \t\"net/http/httptest\"","+\t\"strings\""," \t\"testing\""," \t\"time\""," ","@@ -38,14 +39,9 @@ func rawUITool(t *testing.T, name string) json.RawMessage {"," // and hands to the gateway — the same server both mounts are served from."," func sharedMCPHandler(t *testing.T) *mcptools.Handler {"," \tt.Helper()","-\treturn sharedMCPHandlerWithParams(t, mcptools.DefaultServerParams())","-}","-","-func sharedMCPHandlerWithParams(t *testing.T, params mcptools.ServerParams) *mcptools.Handler {","-\tt.Helper()","+\tparams := mcptools.DefaultServerParams()"," \tsvc := querysvc.NewQueryService(&tracestoremocks.Reader{}, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})"," \th := mcptools.NewHandler(telemetry.NoopSettings(), svc, tenancy.NewManager(&tenancy.Options{}), params)","-\tt.Cleanup(func() { h.Close() })"," \treturn h"," }"," ","@@ -53,18 +49,13 @@ func sharedMCPHandlerWithParams(t *testing.T, params mcptools.ServerParams) *mcp"," // (\"sess-1\") holding the given UI tools, and returns the test HTTP server plus"," // the recorder backing that turn's SSE stream (to observe UI-tool dispatch)."," func turnMCPServer(t *testing.T, uiTools []json.RawMessage) (ts *httptest.Server, rec *httptest.ResponseRecorder, routeID string) {","-\tt.Helper()","-\treturn turnMCPServerWithParams(t, mcptools.DefaultServerParams(), uiTools)","-}","-","-func turnMCPServerWithParams(t *testing.T, params mcptools.ServerParams, uiTools []json.RawMessage) (ts *httptest.Server, rec *httptest.ResponseRecorder, routeID string) {"," \tt.Helper()"," \tturns := newTurnRegistry()"," \trec = httptest.NewRecorder()"," \trouteID = registerTurn(turns, newAGUIRun(context.Background(), rec, \"thread\", \"run\"), uiTools)"," "," \th := turnScopedEndpointBuilder{","-\t\tshared: sharedMCPHandlerWithParams(t, params),","+\t\tshared: sharedMCPHandler(t),"," \t\tturns:  turns,"," \t\tlogger: telemetry.NoopSettings().Logger,"," \t}.build()","@@ -109,23 +100,47 @@ func TestTurnScopedEndpointServesTelemetryPlusUITools(t *testing.T) {"," \tassert.NotContains(t, got, \"show_chart\", \"the bare frontend name is not an MCP tool\")"," }"," ","-// TestTurnScopedEndpointStateless checks that the turn's UI tools are still","-// advertised when the shared handler runs in stateless mode. ServeHTTP stamps the","-// route id on every request, and in stateless mode the SDK builds the session from","-// each request's context, so uiToolsMiddleware finds the turn without a session","-// that outlives the request. The test talks to the endpoint through the real","-// go-sdk client, which after initialize sends a GET to open a stream for","-// server-to-client messages; a stateless server answers that GET with 405, and the","-// client has to treat that as \"no stream\" and continue, or ListTools below would","-// fail.","-func TestTurnScopedEndpointStateless(t *testing.T) {","-\tparams := mcptools.DefaultServerParams()","-\tparams.StreamableHTTP.Stateless = true","-\tts, _, routeID := turnMCPServerWithParams(t, params, []json.RawMessage{rawUITool(t, \"show_chart\")})","-","-\tgot := listToolNames(t, ts, \"/api/ai/mcp/\"+routeID+\"/\")","-\tassert.Contains(t, got, \"get_services\", \"built-in telemetry tools must be advertised\")","-\tassert.Contains(t, got, UIToolPrefix+\"show_chart\", \"the turn's UI tools must be advertised under the namespace\")","+// The turn-scoped endpoint issues no session id, not even to a client on an","+// older protocol revision whose initialize would open a session elsewhere, so","+// nothing outlives a request that another request could name. A client that","+// sends one anyway is served as if it had not, and the GET and DELETE of older","+// revisions are refused: there is no standing stream and no session to end.","+func TestTurnScopedEndpointIssuesNoSessionID(t *testing.T) {","+\tts, _, routeID := turnMCPServer(t, nil)","+","+\tpost := func(body, sessionID string) *http.Response {","+\t\treq, err := http.NewRequestWithContext(context.Background(), http.MethodPost, ts.URL+\"/api/ai/mcp/\"+routeID+\"/\",","+\t\t\tstrings.NewReader(body))","+\t\trequire.NoError(t, err)","+\t\treq.Header.Set(\"Content-Type\", \"application/json\")","+\t\treq.Header.Set(\"Accept\", \"application/json, text/event-stream\")","+\t\tif sessionID != \"\" {","+\t\t\treq.Header.Set(\"Mcp-Session-Id\", sessionID)","+\t\t}","+\t\tresp, err := ts.Client().Do(req)","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(func() { resp.Body.Close() })","+\t\treturn resp","+\t}","+\t// This is the initialize an agent on a pre-2026-07-28 revision opens with,","+\t// and the one request a server that keeps sessions answers with a session id.","+\tinitialize := `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test-client\",\"version\":\"0.0.0\"}}}`","+\tresp := post(initialize, \"\")","+\tassert.Equal(t, http.StatusOK, resp.StatusCode)","+\tassert.Empty(t, resp.Header.Get(\"Mcp-Session-Id\"), \"the turn-scoped endpoint issues no session id\")","+\ttoolsList := `{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}`","+\tassert.Equal(t, http.StatusOK, post(toolsList, \"some-session\").StatusCode, \"a session id sent anyway is ignored\")","+","+\tfor _, method := range []string{http.MethodGet, http.MethodDelete} {","+\t\treq, err := http.NewRequestWithContext(context.Background(), method, ts.URL+\"/api/ai/mcp/\"+routeID+\"/\", http.NoBody)","+\t\trequire.NoError(t, err)","+\t\treq.Header.Set(\"Accept\", \"text/event-stream\")","+\t\treq.Header.Set(\"Mcp-Session-Id\", \"some-session\")","+\t\tresp, err := ts.Client().Do(req)","+\t\trequire.NoError(t, err)","+\t\tresp.Body.Close()","+\t\tassert.Equal(t, http.StatusMethodNotAllowed, resp.StatusCode, \"%s on a live turn: no standing stream and no session to end\", method)","+\t}"," }"," "," // TestSharedMCPHandlerServesTelemetryOnly pins the shared mount's contract while a"],"additions":44,"deletions":29,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/jaegerai/http_handler_test.go","lines":["@@ -4,13 +4,11 @@"," package jaegerai"," "," import (","-\t\"context\""," \t\"net/http\""," \t\"net/http/httptest\""," \t\"strings\""," \t\"testing\""," ","-\t\"github.com/modelcontextprotocol/go-sdk/mcp\""," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\""," \t\"go.uber.org/zap\"","@@ -150,37 +148,6 @@ func TestRegisterRoutesOmitsMCPEndpointWhenDisabled(t *testing.T) {"," \tassert.Equal(t, http.StatusNotFound, rr.Code, \"turn-scoped MCP endpoint must not be mounted when disabled\")"," }"," ","-// TestSharedCloseReapsTurnScopedSessions pins the turn-scoped endpoint into","-// jaeger-query's teardown chain (Server.Close → httpServer.Close → closers.Close →","-// mcptools.Handler.Close). The gateway holds nothing itself, so closing the shared","-// MCP handler has to reap the sessions the turn-scoped mount bound; the SDK reaps a","-// session only when it goes idle, so otherwise a live turn's session would outlive","-// the server.","-func TestSharedCloseReapsTurnScopedSessions(t *testing.T) {","-\tshared := sharedMCPHandler(t)","-\th := NewHandler(HandlerParams{","-\t\tLogger:             zap.NewNop(),","-\t\tAgentURL:           \"ws://127.0.0.1:1\",","-\t\tMaxRequestBodySize: 1 << 20,","-\t\tMCP:                shared,","-\t})","-","-\tmux := http.NewServeMux()","-\th.RegisterRoutes(mux)","-\trouteID := registerTurn(h.mcp.turns, testAGUIRun(), nil)","-\tts := httptest.NewServer(mux)","-\tt.Cleanup(ts.Close)","-","-\tsession := connectTurnMCP(t, ts, \"/api/ai/mcp/\"+routeID+\"/\")","-\t_, err := session.ListTools(context.Background(), &mcp.ListToolsParams{})","-\trequire.NoError(t, err, \"the session works before Close\")","-","-\trequire.NoError(t, shared.Close())","-","-\t_, err = session.ListTools(context.Background(), &mcp.ListToolsParams{})","-\trequire.Error(t, err, \"closing the shared handler must reap the turn-scoped session too\")","-}","-"," // The ai.auth check arrives as ChatMiddleware. It must stop at the chat endpoint:"," // the turn-scoped MCP endpoint is dialed by the sidecar, which carries no user"," // credential, so wrapping it would break every chat turn."],"additions":0,"deletions":33,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/jaegerai/mcp_ui_tools.go","lines":["@@ -44,10 +44,9 @@ const ("," //     telemetry handlers."," //"," // The turn is resolved from the request context: ServeHTTP stamps the URL","-// route id before delegating, and the go-sdk propagates the initialize","-// request's context values onto the ServerSession, so the id is recoverable on","-// tools/list and tools/call alike. A request with no active turn degrades to","-// telemetry-only. UI-tool dispatch short-circuits before the telemetry tracing/","+// route id before delegating, and the MCP handler serves tools/list","+// and tools/call from that request's context. A request with no active turn","+// degrades to telemetry-only. UI-tool dispatch short-circuits before the telemetry tracing/"," // metrics middleware (which this wraps), so browser dispatches don't pollute the"," // query-tool instrumentation."," func uiToolsMiddleware(turns *turnRegistry, logger *zap.Logger) mcp.Middleware {"],"additions":3,"deletions":4,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/jaegerai/routes.go","lines":["@@ -104,7 +104,6 @@ func Register(ctx context.Context, r *http.ServeMux, p RegisterParams) (*Routes,"," \t\tmcpParams.StreamableHTTP = mcp.StreamableHTTP"," "," \t\tmcpHandler = mcptools.NewHandler(telset, p.QueryService, p.Tenancy, mcpParams)","-\t\tcs = append(cs, mcpHandler)"," \t\t// The shared endpoint and the gateway's turn-scoped /api/ai/mcp/<id>/ patterns"," \t\t// coexist because the latter are strictly more specific for ServeMux."," \t\tprefix := strings.TrimSuffix(p.BasePath, \"/\") + \"/api/ai/mcp\""],"additions":0,"deletions":1,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/mcptools/handler.go","lines":["@@ -0,0 +1,73 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package mcptools","+","+import (","+\t\"net/http\"","+","+\t\"github.com/modelcontextprotocol/go-sdk/mcp\"","+\t\"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp\"","+","+\t\"github.com/jaegertracing/jaeger/cmd/jaeger/internal/extension/jaegerquery/querysvc\"","+\t\"github.com/jaegertracing/jaeger/internal/telemetry\"","+\t\"github.com/jaegertracing/jaeger/internal/tenancy\"","+)","+","+// Handler serves an *mcp.Server over HTTP. jaeger-query serves the Handler itself","+// at /api/ai/mcp/; the AI gateway serves the same Handler under its turn-scoped","+// routes, so both mounts share one server and its tools are registered once.","+type Handler struct {","+\t// http is the chain a request runs through: the jaeger_mcp server span, then","+\t// tenant extraction, then the SDK's streamable HTTP handler.","+\thttp   http.Handler","+\tserver *mcp.Server","+\t// recovery guards the middleware added through AddReceivingMiddleware, which","+\t// the SDK places outside the recovery newServer installs.","+\trecovery mcp.Middleware","+}","+","+// NewHandler serves the Jaeger telemetry MCP tools over streamable HTTP, backed by","+// queryAPI. It speaks MCP revision 2026-07-28, which has no sessions: each request","+// is served from its own context and nothing outlives it, so any replica can serve","+// any request, and GET and DELETE are answered 405. The caller mounts the handler","+// on an existing mux.","+func NewHandler(telset telemetry.Settings, queryAPI *querysvc.QueryService, tenancyMgr *tenancy.Manager, params ServerParams) *Handler {","+\th := &Handler{","+\t\tserver:   newServer(telset, queryAPI, params),","+\t\trecovery: createRecoveryMiddleware(telset.Logger),","+\t}","+\tstreamable := mcp.NewStreamableHTTPHandler(","+\t\tfunc(*http.Request) *mcp.Server { return h.server },","+\t\t&mcp.StreamableHTTPOptions{","+\t\t\tJSONResponse:               params.StreamableHTTP.JSONResponse,","+\t\t\tStateless:                  true,","+\t\t\tDisableLocalhostProtection: params.StreamableHTTP.DisableLocalhostProtection,","+\t\t},","+\t)","+\th.http = otelhttp.NewHandler(","+\t\ttenancy.ExtractTenantHTTPHandler(tenancyMgr, streamable),","+\t\t\"jaeger_mcp\",","+\t\totelhttp.WithTracerProvider(telset.TracerProvider),","+\t)","+\treturn h","+}","+","+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {","+\th.http.ServeHTTP(w, r)","+}","+","+// AddReceivingMiddleware layers middleware onto the wrapped server after it has","+// been built, so a caller that did not construct the server can still extend what","+// it dispatches: the AI gateway uses this to add its per-turn UI tools to the","+// shared telemetry server. Call it during startup, before the HTTP server begins","+// serving; middleware added here applies to every later request.","+//","+// The SDK wraps the existing chain with each later call, so the given middleware","+// runs outside the tracing, metrics and recovery middleware newServer installs,","+// and a call it answers itself (as the gateway does for its UI tools) never","+// reaches them. A recovery middleware is therefore added outside it, so a panic","+// in the caller's middleware fails only that request.","+func (h *Handler) AddReceivingMiddleware(middleware ...mcp.Middleware) {","+\th.server.AddReceivingMiddleware(append([]mcp.Middleware{h.recovery}, middleware...)...)","+}"],"additions":73,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/mcptools/handler_test.go","lines":["@@ -0,0 +1,316 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package mcptools","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"slices\"","+\t\"strings\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/modelcontextprotocol/go-sdk/mcp\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/mock\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/otel/sdk/trace/tracetest\"","+","+\t\"github.com/jaegertracing/jaeger/cmd/jaeger/internal/extension/jaegerquery/querysvc\"","+\tdepstoremocks \"github.com/jaegertracing/jaeger/internal/storage/v2/api/depstore/mocks\"","+\ttracestoremocks \"github.com/jaegertracing/jaeger/internal/storage/v2/api/tracestore/mocks\"","+\t\"github.com/jaegertracing/jaeger/internal/telemetry\"","+\t\"github.com/jaegertracing/jaeger/internal/telemetry/otelsemconv\"","+\t\"github.com/jaegertracing/jaeger/internal/tenancy\"","+)","+","+// connectTestClient starts an httptest server around the handler and returns a","+// connected MCP client session.","+func connectTestClient(t *testing.T, handler http.Handler) *mcp.ClientSession {","+\tt.Helper()","+\tts := httptest.NewServer(handler)","+\tt.Cleanup(ts.Close)","+","+\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)","+\tt.Cleanup(cancel)","+","+\tclient := mcp.NewClient(&mcp.Implementation{Name: \"test-client\", Version: \"0.0.0\"}, nil)","+\tsession, err := client.Connect(ctx, &mcp.StreamableClientTransport{","+\t\tEndpoint:   ts.URL,","+\t\tHTTPClient: ts.Client(),","+\t}, nil)","+\trequire.NoError(t, err)","+\tt.Cleanup(func() { session.Close() })","+\treturn session","+}","+","+func TestNewHandler_ListTools(t *testing.T) {","+\tsvc := querysvc.NewQueryService(&tracestoremocks.Reader{}, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\thandler := NewHandler(telemetry.NoopSettings(), svc, tenancy.NewManager(&tenancy.Options{}), DefaultServerParams())","+","+\tsession := connectTestClient(t, handler)","+\tlisted, err := session.ListTools(context.Background(), &mcp.ListToolsParams{})","+\trequire.NoError(t, err)","+","+\tgot := make([]string, 0, len(listed.Tools))","+\tfor _, tool := range listed.Tools {","+\t\tgot = append(got, tool.Name)","+\t}","+\tassert.ElementsMatch(t, []string{","+\t\t\"get_services\", \"get_span_names\", \"search_traces\", \"get_span_details\",","+\t\t\"get_trace_errors\", \"get_trace_topology\", \"get_critical_path\", \"get_service_dependencies\",","+\t\t\"read_skill\",","+\t}, got)","+}","+","+func TestNewHandler_CallTool(t *testing.T) {","+\treader := &tracestoremocks.Reader{}","+\treader.On(\"GetServices\", mock.Anything).Return([]string{\"svc-a\", \"svc-b\"}, nil)","+\tsvc := querysvc.NewQueryService(reader, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\thandler := NewHandler(telemetry.NoopSettings(), svc, tenancy.NewManager(&tenancy.Options{}), DefaultServerParams())","+","+\tsession := connectTestClient(t, handler)","+\tresult, err := session.CallTool(context.Background(), &mcp.CallToolParams{Name: \"get_services\"})","+\trequire.NoError(t, err)","+\tassert.False(t, result.IsError)","+","+\trequire.NotEmpty(t, result.Content)","+\ttext, ok := result.Content[0].(*mcp.TextContent)","+\trequire.True(t, ok)","+\tassert.Contains(t, text.Text, \"svc-a\")","+\tassert.Contains(t, text.Text, \"svc-b\")","+}","+","+func TestNewHandler_ToolPanicFailsOnlyThatCall(t *testing.T) {","+\treader := &tracestoremocks.Reader{}","+\treader.On(\"GetServices\", mock.Anything).Run(func(mock.Arguments) { panic(\"storage failed\") }).Once()","+\treader.On(\"GetServices\", mock.Anything).Return([]string{\"svc-a\"}, nil)","+\tsvc := querysvc.NewQueryService(reader, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\tcapture := newTraceCapture(t)","+\ttelset := telemetry.NoopSettings()","+\ttelset.TracerProvider = capture.provider","+\thandler := NewHandler(telset, svc, tenancy.NewManager(&tenancy.Options{}), DefaultServerParams())","+","+\tsession := connectTestClient(t, handler)","+\tresult, err := session.CallTool(context.Background(), &mcp.CallToolParams{Name: \"get_services\"})","+\trequire.NoError(t, err)","+\tassert.True(t, result.IsError)","+","+\tresult, err = session.CallTool(context.Background(), &mcp.CallToolParams{Name: \"get_services\"})","+\trequire.NoError(t, err)","+\tassert.False(t, result.IsError, \"the session must keep serving after a panic\")","+","+\tvar toolSpans []tracetest.SpanStub","+\tfor _, span := range capture.exporter.GetSpans() {","+\t\tif span.Name == mcpMethodToolsCall+\" get_services\" {","+\t\t\ttoolSpans = append(toolSpans, span)","+\t\t}","+\t}","+\trequire.Len(t, toolSpans, 2)","+\tassertHasStringAttribute(t, toolSpans[0].Attributes, string(otelsemconv.ErrorType(\"\").Key), errorTypeTool)","+}","+","+func TestHandlerAddReceivingMiddleware(t *testing.T) {","+\tsvc := querysvc.NewQueryService(&tracestoremocks.Reader{}, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\th := NewHandler(telemetry.NoopSettings(), svc, tenancy.NewManager(&tenancy.Options{}), DefaultServerParams())","+","+\tvar saw atomic.Bool","+\th.AddReceivingMiddleware(func(next mcp.MethodHandler) mcp.MethodHandler {","+\t\treturn func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {","+\t\t\tif method == \"tools/list\" {","+\t\t\t\tsaw.Store(true)","+\t\t\t}","+\t\t\treturn next(ctx, method, req)","+\t\t}","+\t})","+","+\tsession := connectTestClient(t, h)","+\t_, err := session.ListTools(context.Background(), &mcp.ListToolsParams{})","+\trequire.NoError(t, err)","+\tassert.True(t, saw.Load(), \"middleware added after the handler is built must run for later requests\")","+}","+","+func TestHandlerAddReceivingMiddlewarePanicFailsOnlyThatCall(t *testing.T) {","+\treader := &tracestoremocks.Reader{}","+\treader.On(\"GetServices\", mock.Anything).Return([]string{\"svc-a\"}, nil)","+\tsvc := querysvc.NewQueryService(reader, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\th := NewHandler(telemetry.NoopSettings(), svc, tenancy.NewManager(&tenancy.Options{}), DefaultServerParams())","+","+\th.AddReceivingMiddleware(func(next mcp.MethodHandler) mcp.MethodHandler {","+\t\treturn func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {","+\t\t\tif toolNameFromRequest(method, req) == \"ui_tool\" {","+\t\t\t\tpanic(\"ui tool failed\")","+\t\t\t}","+\t\t\treturn next(ctx, method, req)","+\t\t}","+\t})","+","+\tsession := connectTestClient(t, h)","+\tresult, err := session.CallTool(context.Background(), &mcp.CallToolParams{Name: \"ui_tool\"})","+\trequire.NoError(t, err)","+\tassert.True(t, result.IsError)","+","+\tresult, err = session.CallTool(context.Background(), &mcp.CallToolParams{Name: \"get_services\"})","+\trequire.NoError(t, err)","+\tassert.False(t, result.IsError, \"the session must keep serving after a panic\")","+}","+","+func TestNewHandler_LocalhostProtection(t *testing.T) {","+\tinitialize := `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0\"}}}`","+\tpost := func(t *testing.T, h http.Handler) *http.Response {","+\t\tts := httptest.NewServer(h)","+\t\tt.Cleanup(ts.Close)","+\t\treq, err := http.NewRequestWithContext(context.Background(), http.MethodPost, ts.URL, strings.NewReader(initialize))","+\t\trequire.NoError(t, err)","+\t\treq.Host = \"jaeger.example.com\"","+\t\treq.Header.Set(\"Content-Type\", \"application/json\")","+\t\treq.Header.Set(\"Accept\", \"application/json, text/event-stream\")","+\t\tresp, err := ts.Client().Do(req)","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(func() { resp.Body.Close() })","+\t\treturn resp","+\t}","+\tsvc := querysvc.NewQueryService(&tracestoremocks.Reader{}, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\ttenancyMgr := tenancy.NewManager(&tenancy.Options{})","+","+\tt.Run(\"default rejects a non-loopback Host over loopback\", func(t *testing.T) {","+\t\th := NewHandler(telemetry.NoopSettings(), svc, tenancyMgr, DefaultServerParams())","+\t\tresp := post(t, h)","+\t\tassert.Equal(t, http.StatusForbidden, resp.StatusCode)","+\t\tbody, err := io.ReadAll(resp.Body)","+\t\trequire.NoError(t, err)","+\t\tassert.Contains(t, string(body), \"invalid Host header\")","+\t})","+","+\tt.Run(\"disable_localhost_protection admits it\", func(t *testing.T) {","+\t\tparams := DefaultServerParams()","+\t\tparams.StreamableHTTP.DisableLocalhostProtection = true","+\t\th := NewHandler(telemetry.NoopSettings(), svc, tenancyMgr, params)","+\t\tresp := post(t, h)","+\t\tassert.Equal(t, http.StatusOK, resp.StatusCode)","+\t})","+}","+","+func TestNewHandler_Sessionless(t *testing.T) {","+\tinitialize := `{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0\"}}}`","+\tlistTools := `{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}`","+\tpost := func(h http.Handler, body, sessionID string) *http.Response {","+\t\treq := httptest.NewRequest(http.MethodPost, \"/\", strings.NewReader(body))","+\t\treq.Header.Set(\"Content-Type\", \"application/json\")","+\t\treq.Header.Set(\"Accept\", \"application/json, text/event-stream\")","+\t\tif sessionID != \"\" {","+\t\t\treq.Header.Set(\"Mcp-Session-Id\", sessionID)","+\t\t}","+\t\trr := httptest.NewRecorder()","+\t\th.ServeHTTP(rr, req)","+\t\treturn rr.Result()","+\t}","+\tsvc := querysvc.NewQueryService(&tracestoremocks.Reader{}, &depstoremocks.Reader{}, querysvc.QueryServiceOptions{})","+\ttenancyMgr := tenancy.NewManager(&tenancy.Options{})","+\tnewReplica := func() *Handler {","+\t\treturn NewHandler(telemetry.NoopSettings(), svc, tenancyMgr, DefaultServerParams())","+\t}","+","+\tt.Run(\"a legacy initialize is answered without a session id and the other replica serves the next request\", func(t *testing.T) {","+\t\tfirst, second := newReplica(), newReplica()","+\t\tresp := post(first, initialize, \"\")","+\t\trequire.Equal(t, http.StatusOK, resp.StatusCode)","+\t\tassert.Empty(t, resp.Header.Get(\"Mcp-Session-Id\"), \"the endpoint issues no session id\")","+\t\tresp = post(second, listTools, \"\")","+\t\trequire.Equal(t, http.StatusOK, resp.StatusCode)","+\t\tbody, err := io.ReadAll(resp.Body)",