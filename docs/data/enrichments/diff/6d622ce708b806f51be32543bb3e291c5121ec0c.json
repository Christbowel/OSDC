ClientKey &HTTPClientPool::BucketHandle::GetKey() const {","+\tD_ASSERT(bucket);","+\treturn bucket->key;","+}","+","+HTTPClientPool::HTTPClientPool(idx_t capacity_p) : capacity(capacity_p) {","+\tclient_buckets.reserve(capacity);","+\tnon_empty_buckets.reserve(capacity);","+}","+","+bool HTTPClientPool::HasAdmissionResource() const {","+\treturn reserved_clients < capacity || !non_empty_buckets.empty();","+}","+","+void HTTPClientPool::WaitForAdmission(annotated_unique_lock<annotated_mutex> &guard, bool owns_capacity) {","+\tif (closed) {","+\t\tthrow InvalidInputException(\"HTTP transport manager is closed\");","+\t}","+\tif (admission_waiters.empty() && HasAdmissionResource()) {","+\t\treturn;","+\t}","+\tif (owns_capacity) {","+\t\tthrow InvalidInputException(\"Nested HTTP client acquisition would wait for manager capacity\");","+\t}","+\tAdmissionWaiter waiter;","+\tadmission_waiters.emplace_back(waiter);","+\ttry {","+\t\twaiter.availability.wait(","+\t\t    guard, [&]() { return closed || (admission_waiters.front().get() == &waiter && HasAdmissionResource()); });","+\t} catch (...) {","+\t\tRemoveAdmissionWaiter(waiter);","+\t\tthrow;","+\t}","+\tif (closed) {","+\t\tRemoveAdmissionWaiter(waiter);","+\t\tthrow InvalidInputException(\"HTTP transport manager is closed\");","+\t}","+\tD_ASSERT(admission_waiters.front().get() == &waiter);","+\tadmission_waiters.pop_front();","+}","+","+void HTTPClientPool::WakeNextAdmission() {","+\tif (!admission_waiters.empty() && (closed || HasAdmissionResource())) {","+\t\tadmission_waiters.front()->availability.notify_one();","+\t}","+}","+","+void HTTPClientPool::RemoveAdmissionWaiter(AdmissionWaiter &waiter) {","+\tfor (auto entry = admission_waiters.begin(); entry != admission_waiters.end(); ++entry) {","+\t\tif (entry->get() != &waiter) {","+\t\t\tcontinue;","+\t\t}","+\t\tconst bool was_front = entry == admission_waiters.begin();","+\t\tadmission_waiters.erase(entry);","+\t\tif (was_front) {","+\t\t\tWakeNextAdmission();","+\t\t}","+\t\treturn;","+\t}","+\tD_ASSERT(false);","+}","+","+void HTTPClientPool::Close() noexcept {","+\tclosed = true;","+\tfor (auto waiter : admission_waiters) {","+\t\twaiter->availability.notify_one();","+\t}","+}","+","+bool HTTPClientPool::IsClosed() const {","+\treturn closed;","+}","+","+HTTPClientPool::Reservation HTTPClientPool::Reserve(const ClientKey &key, const string &origin, bool cacheable) {","+\tD_ASSERT(!closed);","+\tD_ASSERT(HasAdmissionResource());","+\tauto exact = cacheable ? FindBucket(key, origin) : client_buckets.end();","+\tReservation result;","+\tresult.key = key;","+\tresult.cacheable = cacheable;","+\tif (exact != client_buckets.end() && !exact->second.idle_clients.empty()) {","+\t\tresult.bucket = BucketHandle(exact->second);","+\t\tresult.client = TakeIdleClient(exact->second);","+\t\tresult.kind = ReservationKind::REUSE;","+\t\tWakeNextAdmission();","+\t\treturn result;","+\t}","+","+\tD_ASSERT(reserved_clients <= capacity);","+\tresult.bucket_capacity = capacity;","+\tif (reserved_clients < capacity) {","+\t\treserved_clients++;","+\t} else {","+\t\tauto replacement_bucket = non_empty_buckets.back();","+\t\tresult.client = TakeIdleClient(*replacement_bucket);","+\t\tD_ASSERT(replacement_bucket->reserved_clients > 0);","+\t\treplacement_bucket->reserved_clients--;","+\t\tif (replacement_bucket->reserved_clients == 0) {","+\t\t\tresult.bucket_node.node = ExtractBucket(*replacement_bucket);","+\t\t}","+\t}","+\tif (exact != client_buckets.end()) {","+\t\texact->second.reserved_clients++;","+\t\tresult.bucket = BucketHandle(exact->second);","+\t}","+\tWakeNextAdmission();","+\treturn result;","+}","+","+bool HTTPClientPool::Reservation::PrepareBucket(const string &origin) {","+\tif (!cacheable || bucket.IsValid()) {","+\t\treturn false;","+\t}","+\tif (bucket_node.node) {","+\t\tauto &new_bucket = bucket_node.node.mapped();","+\t\tD_ASSERT(new_bucket.reserved_clients == 0);","+\t\tD_ASSERT(new_bucket.idle_clients.empty());","+\t\tD_ASSERT(!new_bucket.non_empty_index.IsValid());","+\t\tD_ASSERT(new_bucket.idle_clients.capacity() >= bucket_capacity);","+\t\tbucket_node.node.key() = key;","+\t\tnew_bucket.key = key;","+\t\tnew_bucket.origin = origin;","+\t\tnew_bucket.reserved_clients = 1;","+\t} else {","+\t\tClientBucket new_bucket;","+\t\tnew_bucket.key = key;","+\t\tnew_bucket.origin = origin;","+\t\tnew_bucket.idle_clients.reserve(bucket_capacity);","+\t\tnew_bucket.reserved_clients = 1;","+\t\tClientBucketMap pending;","+\t\tpending.emplace(key, std::move(new_bucket));","+\t\tbucket_node.node = pending.extract(pending.begin());","+\t}","+\treturn true;","+}"],"additions":165,"deletions":0,"truncated":false}],"additions":581,"deletions":21,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-09-08T12:20:07.095900+00:00"}