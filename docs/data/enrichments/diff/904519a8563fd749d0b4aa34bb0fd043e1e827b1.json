'5.62.0' });","+    const userHashes = ['a'.repeat(64), 'b'.repeat(64)];","+","+    await fetchLicense({ strapi }, 'the-key', 'the-project-id', { userHashes });","+","+    const body = sentBody(fetchImpl);","+    expect(body.instanceId).toMatch(","+      /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/","+    );","+    expect(body.strapiVersion).toBe('5.62.0');","+    expect(body.userHashes).toEqual(userHashes);","+  });","+","+  it('keeps the same instance id across checks of the same process', async () => {","+    const fetchImpl = vi","+      .fn<Promise<Response>, FetchArgs>()","+      .mockImplementation(async () =>","+        createResponse({ status: 200, body: { data: { license: 'the-license' } } })","+      );","+    const strapi = createStrapi(fetchImpl);","+","+    await fetchLicense({ strapi }, 'key', 'project');","+    await fetchLicense({ strapi }, 'key', 'project');","+","+    const [first, second] = fetchImpl.mock.calls.map(([, init]) =>","+      JSON.parse((init as RequestInit).body as string)","+    );","+    expect(first.instanceId).toBe(second.instanceId);","+  });","+","+  it('still sends the check, without userHashes, when no hashes are given', async () => {","+    const fetchImpl = mockFetch(","+      createResponse({ status: 200, body: { data: { license: 'the-license' } } })","+    );","+","+    const license = await fetchLicense({ strapi: createStrapi(fetchImpl) }, 'key', 'project', {","+      userHashes: undefined,","     });","+","+    expect(license).toBe('the-license');","+    const body = sentBody(fetchImpl);","+    expect(body).not.toHaveProperty('userHashes');","+    expect(body.instanceId).toEqual(expect.any(String));","+    expect(body.strapiVersion).toBe('5.0.0');","   });"," ","   it('returns the license string on a 200 response', async () => {"],"additions":63,"deletions":7,"truncated":false},{"path":"packages/core/core/src/ee/__tests__/online-update.vitest.test.ts","lines":["@@ -0,0 +1,146 @@","+/**","+ * Covers what `onlineUpdate` sends to and keeps from the license registry beyond the license","+ * itself. Same module-reset dance as license-retention.vitest.test.ts: the license state is a","+ * closure singleton, so each test re-imports the module fresh.","+ */","+","+import { describe, it, expect, vi, afterEach, type Mock } from 'vitest';","+","+vi.mock('../license', async (importOriginal) => ({","+  ...(await importOriginal<typeof import('../license')>()),","+  readLicense: vi.fn(),","+  verifyLicense: vi.fn(),","+  fetchLicense: vi.fn(),","+}));","+","+type LicenseModuleMock = {","+  readLicense: Mock;","+  verifyLicense: Mock;","+  fetchLicense: Mock;","+};","+","+type EEModule = typeof import('../index').default;","+","+const LICENSE_KEY = 'a-license-key';","+","+const GOLD_LICENSE_INFO = {","+  type: 'gold',","+  isTrial: false,","+  seats: 10,","+  expireAt: new Date(Date.now() + 1000 * 60 * 60 * 24).toISOString(),","+  features: [{ name: 'sso' }],","+  licenseKey: LICENSE_KEY,","+};","+","+const createChainableDb = (storedRow: unknown) => {","+  const chainable: any = new Proxy(","+    {},","+    {","+      get(_target, prop) {","+        if (prop === 'then') return undefined;","+        if (prop === 'execute') {","+          return vi","+            .fn()","+            .mockResolvedValue(storedRow ? { value: JSON.stringify(storedRow) } : undefined);","+        }","+        return () => chainable;","+      },","+    }","+  );","+  return chainable;","+};","+","+const createMockStrapi = ({","+  users = [] as Array<{ email: string }>,","+  findManyError,","+  storedRow = null as unknown,","+}: {","+  users?: Array<{ email: string }>;","+  findManyError?: Error;","+  storedRow?: unknown;","+} = {}) => {","+  const findMany = findManyError","+    ? vi.fn().mockRejectedValue(findManyError)","+    : vi.fn().mockResolvedValue(users);","+","+  const strapi = {","+    eventHub: { emit: vi.fn() },","+    log: { warn: vi.fn(), debug: vi.fn() },","+    db: {","+      transaction: vi.fn().mockResolvedValue({","+        get: vi.fn().mockReturnValue({}),","+        commit: vi.fn().mockResolvedValue(undefined),","+        rollback: vi.fn().mockResolvedValue(undefined),","+      }),","+      queryBuilder: vi.fn().mockImplementation(() => createChainableDb(storedRow)),","+      query: vi.fn().mockReturnValue({ findMany }),","+    },","+    store: { get: vi.fn().mockResolvedValue(null), set: vi.fn().mockResolvedValue(undefined) },","+    config: { get: vi.fn().mockReturnValue('project-uuid') },","+    cron: { add: vi.fn() },","+  };","+","+  return strapi as any;","+};","+","+const setup = async (strapiOptions?: Parameters<typeof createMockStrapi>[0]) => {","+  vi.resetModules();","+  const strapi = createMockStrapi(strapiOptions);","+  (global as any).strapi = strapi;","+","+  const license = (await import('../license')) as unknown as LicenseModuleMock;","+  license.readLicense.mockReset().mockReturnValue('raw-license');","+  license.verifyLicense.mockReset().mockReturnValue({ ...GOLD_LICENSE_INFO });","+  license.fetchLicense.mockReset().mockResolvedValue('fresh-license');","+","+  delete process.env.STRAPI_LICENSE;","+  delete process.env.STRAPI_DISABLE_EE;","+  delete process.env.STRAPI_DISABLE_LICENSE_PING;","+","+  const eeModule: EEModule = (await import('../index')).default;","+  eeModule.init('/fake/license/dir');","+","+  return { strapi, license, eeModule };","+};","+","+afterEach(() => {","+  delete (global as any).strapi;","+  delete process.env.STRAPI_DISABLE_LICENSE_PING;","+});","+","+describe('onlineUpdate user hashes', () => {","+  it('sends the hashes of the active admin users with the license check', async () => {","+    const { strapi, license, eeModule } = await setup({","+      users: [{ email: 'a@example.com' }, { email: 'A@example.com' }],","+    });","+    const { hashAdminEmail } = await import('../user-hashes');","+","+    await eeModule.checkLicense({ strapi });","+","+    expect(license.fetchLicense).toHaveBeenCalledWith({ strapi }, LICENSE_KEY, 'project-uuid', {","+      userHashes: [hashAdminEmail(LICENSE_KEY, 'a@example.com')],","+    });","+  });","+","+  it('still sends the license check, without hashes, when they cannot be computed', async () => {","+    const { strapi, license, eeModule } = await setup({ findManyError: new Error('db down') });","+","+    await eeModule.checkLicense({ strapi });","+","+    expect(license.fetchLicense).toHaveBeenCalledWith({ strapi }, LICENSE_KEY, 'project-uuid', {","+      userHashes: undefined,","+    });","+    expect(strapi.log.warn).toHaveBeenCalledWith(expect.stringContaining('db down'));","+    expect(eeModule.isEE).toBe(true);","+  });","+","+  it('does not read the admin users for an offline license', async () => {","+    const { strapi, license, eeModule } = await setup();","+    process.env.STRAPI_DISABLE_LICENSE_PING = 'true';","+","+    await eeModule.checkLicense({ strapi });","+","+    expect(license.fetchLicense).not.toHaveBeenCalled();","+    expect(strapi.db.query).not.toHaveBeenCalled();","+  });","+});"],"additions":146,"deletions":0,"truncated":false},{"path":"packages/core/core/src/ee/__tests__/user-hashes.vitest.test.ts","lines":["@@ -0,0 +1,115 @@","+import crypto from 'crypto';","+import { describe, it, expect, vi } from 'vitest';","+","+import { MAX_USER_HASHES, computeUserHashes, getUserHashes, hashAdminEmail } from '../user-hashes';","+","+const LICENSE_KEY = 'the-license-key';","+","+const expectedHash = (email: string) =>","+  crypto.createHmac('sha256', LICENSE_KEY).update(email).digest('hex');","+","+const createStrapi = (findMany: (...args: any[]) => Promise<unknown>) => {","+  const warn = vi.fn();","+  const query = vi.fn(() => ({ findMany: vi.fn(findMany) }));","+","+  return { strapi: { db: { query }, log: { warn } } as any, query, warn };","+};","+","+describe('hashAdminEmail', () => {","+  it('is the HMAC-SHA256 of the email keyed with the license key, as lowercase hex', () => {","+    const hash = hashAdminEmail(LICENSE_KEY, 'admin@example.com');","+","+    expect(hash).toBe(expectedHash('admin@example.com'));","+    expect(hash).toMatch(/^[0-9a-f]{64}$/);","+  });","+","+  it('trims and lowercases the email before hashing', () => {","+    expect(hashAdminEmail(LICENSE_KEY, '  Admin@Example.COM \\n')).toBe(","+      hashAdminEmail(LICENSE_KEY, 'admin@example.com')","+    );","+  });","+","+  it('depends on the license key', () => {","+    expect(hashAdminEmail('another-key', 'admin@example.com')).not.toBe(","+      hashAdminEmail(LICENSE_KEY, 'admin@example.com')","+    );","+  });","+});","+","+describe('computeUserHashes', () => {","+  it('reads only the email of active admin users', async () => {","+    const { strapi, query } = createStrapi(async () => []);","+","+    await computeUserHashes(strapi, LICENSE_KEY);","+","+    expect(query).toHaveBeenCalledWith('admin::user');","+    const findMany = query.mock.results[0].value.findMany;","+    expect(findMany).toHaveBeenCalledWith(","+      expect.objectContaining({ select: ['email'], where: { isActive: true } })","+    );","+  });","+","+  it('returns one hash per unique normalized email', async () => {","+    const { strapi } = createStrapi(async () => [","+      { email: 'a@example.com' },","+      { email: 'A@Example.com ' },","+      { email: 'b@example.com' },","+    ]);","+","+    const hashes = await computeUserHashes(strapi, LICENSE_KEY);","+","+    expect(hashes).toEqual([expectedHash('a@example.com'), expectedHash('b@example.com')]);","+  });","+","+  it('skips users without a usable email', async () => {","+    const { strapi } = createStrapi(async () => [","+      { email: null },","+      { email: '   ' },","+      {},","+      { email: 'a@example.com' },","+    ]);","+","+    expect(await computeUserHashes(strapi, LICENSE_KEY)).toEqual([expectedHash('a@example.com')]);","+  });","+","+  it(`caps the list at ${MAX_USER_HASHES} hashes`, async () => {","+    const users = Array.from({ length: MAX_USER_HASHES + 5 }, (_, index) => ({","+      email: `user-${index}@example.com`,","+    }));","+    const { strapi } = createStrapi(async () => users);","+","+    const hashes = await computeUserHashes(strapi, LICENSE_KEY);","+","+    expect(hashes).toHaveLength(MAX_USER_HASHES);","+    expect(hashes[0]).toBe(expectedHash('user-0@example.com'));","+  });","+","+  it('throws when the users cannot be read', async () => {","+    const { strapi } = createStrapi(async () => {","+      throw new Error('db down');","+    });","+","+    await expect(computeUserHashes(strapi, LICENSE_KEY)).rejects.toThrow('db down');","+  });","+});","+","+describe('getUserHashes', () => {","+  it('returns the hashes', async () => {","+    const { strapi } = createStrapi(async () => [{ email: 'a@example.com' }]);","+","+    expect(await getUserHashes(strapi, LICENSE_KEY)).toEqual([expectedHash('a@example.com')]);","+  });","+","+  it('logs a warning and returns undefined instead of throwing', async () => {","+    const { strapi, warn } = createStrapi(async () => {","+      throw new Error('db down');","+    });","+","+    await expect(getUserHashes(strapi, LICENSE_KEY)).resolves.toBeUndefined();","+    expect(warn).toHaveBeenCalledWith(expect.stringContaining('db down'));","+  });","+","+  it('does not throw without a database or logger', async () => {","+    await expect(getUserHashes({} as any, LICENSE_KEY)).resolves.toBeUndefined();","+  });","+});"],"additions":115,"deletions":0,"truncated":false},{"path":"packages/core/core/src/ee/index.ts","lines":["@@ -11,6 +11,7 @@ import {","   PLAN_FEATURE_CATALOG,"," } from './license';"," import { createEntitlementsRegistry, parseNumericString } from './entitlements';","+import { getUserHashes } from './user-hashes';"," import { shiftCronExpression } from '../utils/cron';"," "," const ONE_MINUTE = 1000 * 60;","@@ -144,6 +145,13 @@ const init = (licenseDir: string, logger?: Logger) => {","  * Store the result in database to avoid unecessary requests, and will fallback to that in case of a network failure.","  */"," const onlineUpdate = async ({ strapi }: { strapi: Core.Strapi }) => {","+  // Read before the transaction opens: SQLite pools hold a single connection, which the","+  // transaction below keeps busy, and on Postgres a failed query would abort the transaction.","+  // Never throws: without hashes the license check is still sent, just without them.","+  const userHashes = ee.licenseInfo.licenseKey","+    ? await getUserHashes(strapi, ee.licenseInfo.licenseKey)","+    : undefined;","+","   const { get, commit, rollback } = await strapi.db.transaction();","   const transaction = get();"," ","@@ -192,9 +200,9 @@ const onlineUpdate = async ({ strapi }: { strapi: Core.Strapi }) => {","     }"," ","     const license = shouldContactRegistry","-      ? await fetchLicense({ strapi }, ee.licenseInfo.licenseKey, strapi.config.get('uuid')).catch(","-          fallback","-        )","+      ? await fetchLicense({ strapi }, ee.licenseInfo.licenseKey, strapi.config.get('uuid'), {","+          userHashes,","+        }).catch(fallback)","       : storedInfo.license;"," ","     if (license) {"],"additions":11,"deletions":3,"truncated":false},{"path":"packages/core/core/src/ee/license.ts","lines":["@@ -71,6 +71,12 @@ const licenseErrorSchema = z.object({","   }),"," });"," ","+/**","+ * Identifies this running process to the license registry, so it can tell instances of a","+ * project apart. Generated once per process: it changes on every restart.","+ */","+const INSTANCE_ID = crypto.randomUUID();","+"," const publicKey = fs.readFileSync(resolve(__dirname, '../../resources/key.pub'));"," "," class LicenseCheckError extends Error {","@@ -135,10 +141,21 @@ const throwShouldFallbackError = () => {","   throw createShouldFallbackError();"," };"," ","+interface FetchLicenseOptions {","+  /** HMAC hashes of the active admin users (see `./user-hashes`). Omitted when unavailable. */","+  userHashes?: string[];","+}","+","+const getStrapiVersion = (strapi: Core.Strapi): string | undefined => {","+  const version = strapi.config.get('info.strapi');","+  return typeof version === 'string' ? version : undefined;","+};","+"," const fetchLicense = async (","   { strapi }: { strapi: Core.Strapi },","   key: string,","-  projectId: string","+  projectId: string,","+  { userHashes }: FetchLicenseOptions = {}"," ) => {","   const installIdFromPackageJson = strapi.config.get<string | undefined>('installId');"," ","@@ -146,10 +163,15 @@ const fetchLicense = async (","     .fetch(`${LICENSE_REGISTRY_URI}/api/licenses/validate`, {","       method: 'POST',","       headers: { 'Content-Type': 'application/json' },","+      // `instanceId`, `strapiVersion` and `userHashes` are optional: registries that do not know","+      // them ignore them. `JSON.stringify` drops the ones that are undefined.","       body: JSON.stringify({","         key,","         projectId,","         deviceId: generateInstallId(projectId, installIdFromPackageJson),","+        instanceId: INSTANCE_ID,","+        strapiVersion: getStrapiVersion(strapi),","+        userHashes,","       }), // NOTE: Doing nothing on the LR with the installId","     })","     .catch(throwShouldFallbackError);"],"additions":23,"deletions":1,"truncated":false},{"path":"packages/core/core/src/ee/user-hashes.ts","lines":["@@ -0,0 +1,64 @@","+import crypto from 'crypto';","+import type { Core } from '@strapi/types';","+","+/**","+ * Upper bound on the hashes sent with one license check, to keep the request body bounded.","+ */","+export const MAX_USER_HASHES = 10_000;","+","+/**","+ * Hashes an admin email for the license registry: HMAC-SHA256 keyed with the license key over","+ * the trimmed, lowercased email, as lowercase hex. The registry only ever sees these hashes, so","+ * it can count unique admins across every instance of a license without receiving any email.","+ */","+export const hashAdminEmail = (licenseKey: string, email: string): string =>","+  crypto.createHmac('sha256', licenseKey).update(email.trim().toLowerCase()).digest('hex');","+","+/**","+ * Hashes of the active admin users, deduplicated and capped at {@link MAX_USER_HASHES}.","+ * Throws when the users cannot be read; see {@link getUserHashes} for the safe variant.","+ */","+export const computeUserHashes = async (","+  strapi: Core.Strapi,","+  licenseKey: string","+): Promise<string[]> => {","+  const users: Array<{ email?: unknown }> = await strapi.db.query('admin::user').findMany({","+    select: ['email'],","+    where: { isActive: true },","+    orderBy: { id: 'asc' },","+  });","+","+  const hashes = new Set<string>();","+","+  for (const { email } of users) {","+    if (hashes.size >= MAX_USER_HASHES) {","+      break;","+    }","+","+    if (typeof email === 'string' && email.trim() !== '') {","+      hashes.add(hashAdminEmail(licenseKey, email));","+    }","+  }","+","+  return [...hashes];","+};","+","+/**","+ * Same as {@link computeUserHashes}, but never throws: on failure it logs a warning and returns","+ * `undefined`, so the license check is still sent, only without user hashes.","+ */","+export const getUserHashes = async (","+  strapi: Core.Strapi,","+  licenseKey: string","+): Promise<string[] | undefined> => {","+  try {","+    return await computeUserHashes(strapi, licenseKey);","+  } catch (error) {","+    strapi.log?.warn(","+      `Could not compute the active admin users for the license check: ${","+        error instanceof Error ? error.message : String(error)","+      }`","+    );","+    return undefined;","+  }","+};",""],"additions":64,"deletions":0,"truncated":false}],"additions":422,"deletions":11,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-26T18:55:31.807487+00:00"}