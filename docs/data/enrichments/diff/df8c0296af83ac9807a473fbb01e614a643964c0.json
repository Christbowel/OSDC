","+            workspace_buffer=workspace,","+            qk_nope_head_dim=512,","+            kv_lora_rank=512,","+            qk_rope_head_dim=64,","+            block_tables=indices,","+            seq_lens=seq_lens,","+            max_seq_len=topk,","+            out=out,","+            bmm1_scale=0.04,","+            bmm2_scale=1.0,","+            sparse_mla_top_k=topk,","+        )","+        return out","+","+    out = decode(kv[:rows])","+    assert out.any()","+    torch.testing.assert_close(out, decode(kv), rtol=0, atol=0)","+","+"," def _triton_convert_reference_impl(","     req_ids: torch.Tensor,","     block_table: torch.Tensor,","@@ -3520,7 +3574,10 @@ def test_hisparse_row_dma_copies_discontiguous_spans_across_layers():"," "," "," @requires_hisparse_ops","-def test_hisparse_remaps_strided_hma_rows_for_attention():","+@pytest.mark.parametrize(\"stride_rows\", [12, 13])","+def test_hisparse_remaps_strided_hma_rows_for_attention(stride_rows):","+    \"\"\"Hot rows are addressed by the row stride between blocks, which need","+    only be whole rows apart.\"\"\"","     device = torch.device(DEVICE_TYPE)","     block_size, row_width = 4, 8","     runtime = _make_hisparse_runtime(","@@ -3529,7 +3586,7 @@ def test_hisparse_remaps_strided_hma_rows_for_attention():","         row_width=row_width,","     )","     page_elements = block_size * row_width","-    stride_elements = 3 * page_elements","+    stride_elements = stride_rows * row_width","     byte_offset = page_elements * torch.float32.itemsize","     raw = torch.zeros(2 * stride_elements, dtype=torch.float32, device=device).view(","         torch.int8","@@ -3563,7 +3620,9 @@ def test_hisparse_remaps_strided_hma_rows_for_attention():","     )"," ","     assert runtime.hot.attention_cache is not None","-    assert runtime.hot.attention_cache.is_contiguous()","+    assert runtime.hot.attention_cache.is_contiguous() == (","+        stride_rows % block_size == 0","+    )","     physical_indices = runtime.inde