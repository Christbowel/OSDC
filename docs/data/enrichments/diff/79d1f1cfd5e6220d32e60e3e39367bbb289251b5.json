\[a-zA-Z_\\x80-\\xff][\\w\\x80-\\xff]*)*$/', $var_id) === 1;","     }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/PrintAnalyzer.php","lines":["@@ -48,7 +48,7 @@ public static function analyze(","                     | TaintKind::INPUT_HAS_QUOTES","                     | TaintKind::USER_SECRET","                     | TaintKind::SYSTEM_SECRET)","-                & ~(CliOutput::isInCliOnlyCode($statements_analyzer) ? CliOutput::HTML_TAINTS : 0),","+                & ~(CliOutput::isInCliOnlyCode($statements_analyzer, $context) ? CliOutput::HTML_TAINTS : 0),","             );"," ","             $statements_analyzer->taint_flow_graph->addSink($print_param_sink);"],"additions":1,"deletions":1,"truncated":false},{"path":"src/Psalm/Internal/Codebase/CliOutput.php","lines":["@@ -5,19 +5,30 @@"," namespace Psalm\\Internal\\Codebase;"," "," use PhpParser\\Node\\Arg;","+use PhpParser\\Node\\Expr\\New_;","+use Psalm\\CodeLocation;","+use Psalm\\Codebase;","+use Psalm\\Context;"," use Psalm\\Internal\\Analyzer\\ClosureAnalyzer;"," use Psalm\\Internal\\Analyzer\\FunctionLikeAnalyzer;"," use Psalm\\Internal\\Analyzer\\MethodAnalyzer;"," use Psalm\\Internal\\Analyzer\\StatementsAnalyzer;","+use Psalm\\Internal\\MethodIdentifier;","+use Psalm\\Issue\\CliOnlyCall;","+use Psalm\\IssueBuffer;","+use Psalm\\Storage\\ClassLikeStorage;","+use Psalm\\Type\\Atomic\\TLiteralString;"," use Psalm\\Type\\TaintKind;"," "," use function array_key_exists;","+use function in_array;"," "," /**","  * What the code that only runs from the command line prints goes to a terminal, not to an HTML response: in the","- * function-likes with `@psalm-cli-only`, the methods of the classes with it, and the closures in their bodies, what","- * echo, print, printf(), vprintf(), var_dump(), debug_zval_dump(), and print_r() and var_export() not returning it","- * print isn't an HTML sink. They stay sinks of the other taints (secrets), and the values stay tainted elsewhere.","+ * function-likes with `@psalm-cli-only`, the methods of the classes with it, the code a PHP_SAPI check guards, and","+ * the closures in their bodies, what echo, print, printf(), vprintf(), var_dump(), debug_zval_dump(), and print_r()","+ * and var_export() not returning it print isn't an HTML sink. They stay sinks of the other taints (secrets), and the","+ * values stay tainted elsewhere. Such code is only called from code only running from the command line too.","  *","  * @internal","  */","@@ -41,12 +52,30 @@ final class CliOutput","         'var_export' => 1,","     ];"," ","+    /** The SAPIs running scripts from the command line */","+    private const CLI_SAPIS = ['cli', 'phpdbg'];","+","     /**","      * Whether the code being analyzed only runs from the command line: that of a function-like with `@psalm-cli-only`,","-     * of a method of a class with it, or of a closure in their bodies","+     * of a method of a class with it, the code a PHP_SAPI or php_sapi_name() check guards, or a closure in them","      */","-    public static function isInCliOnlyCode(StatementsAnalyzer $statements_analyzer): bool","+    public static function isInCliOnlyCode(StatementsAnalyzer $statements_analyzer, Context $context): bool","     {","+        $sapi_type = $context->vars_in_scope[Context::PHP_SAPI_VAR_ID] ?? null;","+        if ($sapi_type !== null) {","+            $is_cli_sapi = true;","+            foreach ($sapi_type->getAtomicTypes() as $atomic) {","+                if (!$atomic instanceof TLiteralString || !in_array($atomic->value, self::CLI_SAPIS, true)) {","+                    $is_cli_sapi = false;","+                    break;","+                }","+            }","+","+            if ($is_cli_sapi) {","+                return true;","+            }","+        }","+","         $source = $statements_analyzer->getSource();"," ","         // a closure runs in the process of the code creating it","@@ -70,7 +99,8 @@ public static fun