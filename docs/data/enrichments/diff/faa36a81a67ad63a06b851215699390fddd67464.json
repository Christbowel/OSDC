{"id":"faa36a81a67ad63a06b851215699390fddd67464","axis":"silent","repo":"pnpm/pnpm","sha":"faa36a81a67ad63a06b851215699390fddd67464","parsed":{"files":[{"path":".changeset/hoisted-orphan-through-symlinked-scope.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+With `nodeLinker: hoisted`, pnpm no longer deletes a directory outside `node_modules` when it removes a package whose scope directory is a symlink."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/modules-dir-outside-the-project.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Fixed installs in a workspace whose `modulesDir` is an absolute path or starts with `..`. A fresh install no longer puts the dependencies of workspace projects outside the workspace. A frozen install now links the root project's dependencies into the configured directory. pnpm now also removes a dependency you remove from such a directory [pnpm/tasks#285](https://github.com/pnpm/tasks/issues/285)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/install.rs","lines":["@@ -160,11 +160,12 @@ pub(super) fn create_deploy_install_config(","     let mut deploy_config = base_config.clone();","     deploy_config.modules_dir = deploy_dir.join(\"node_modules\");","     deploy_config.install_state_dir = deploy_virtual_store_dir(base_config, deploy_dir);","-    // The deploy directory owns the lockfile this install runs against —","+    // The deploy directory owns the lockfile this install runs against:","     // the generated one for a shared deploy, its own resolution for the","-    // legacy path. A `lockfileDir` pinning the *source* workspace's","-    // lockfile must not redirect either.","-    deploy_config.lockfile_dir = None;","+    // legacy path. Pinning it keeps the source workspace, found above the","+    // deploy directory or set by `lockfileDir`, from becoming the root its","+    // importers are placed against.","+    deploy_config.lockfile_dir = Some(deploy_dir.to_path_buf());","     deploy_config.global_virtual_store_dir = deploy_config.install_state_dir.clone();","     deploy_config.enable_global_virtual_store = false;","     deploy_config.pnpr_server = None;"],"additions":5,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/modules_dir.rs","lines":["@@ -568,3 +568,125 @@ fn registry_bin_sets_node_path(project_dir: &Path) -> bool {","     };","     fs::read_to_string(project_dir.join(shim)).expect(\"read the shim\").contains(\"NODE_PATH=\")"," }","+","+#[test]","+fn a_modules_dir_outside_the_project_is_the_root_projects_only() {","+    for linker in [\"isolated\", \"hoisted\"] {","+        for setting in [ModulesDirSetting::Absolute, ModulesDirSetting::Climbing] {","+            install_with_modules_dir_outside_the_project(linker, setting);","+        }","+    }","+}","+","+#[derive(Clone, Copy)]","+enum IsPositive {","+    Declared,","+    Removed,","+}","+","+#[derive(Debug, Clone, Copy)]","+enum ModulesDirSetting {","+    Absolute,","+    Climbing,","+}","+","+fn install_with_modules_dir_outside_the_project(linker: &str, setting: ModulesDirSetting) {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let root_modules_dir = workspace","+        .parent()","+        .expect(\"workspace parent\")","+        .join(\"vendor\");","+    let project_modules_dir = workspace.join(\"project-1/vendor\");","+    let modules_dir = match setting {","+        ModulesDirSetting::Absolute => root_modules_dir.to_string_lossy().replace('\\\\', \"/\"),","+        ModulesDirSetting::Climbing => \"../vendor\".to_string(),","+    };","+    append_workspace_yaml_key(&workspace, \"modulesDir\", &modules_dir);","+    append_workspace_yaml_key(&workspace, \"nodeLinker\", linker);","+    append_workspace_yaml_key(&workspace, \"packages\", \"['project-1']\");","+    append_workspace_yaml_key(&workspace, \"allowBuilds\", \"{'@pnpm.e2e/generated-bins': true}\");","+    let write_manifests = |is_positive: IsPositive| {","+        let dependencies = |version: &str| {","+            let mut dependencies = serde_json::json!({ \"@pnpm.e2e/hello-world-js-bin\": \"1.0.0\" });","+            match is_positive {","+                IsPositive::Declared => dependencies[\"is-positive\"] = version.into(),","+                IsPositive::Removed => {}","+            }","+            dependencies","+        };","+        let mut root_dependencies = dependencies(\"3.1.0\");","+        root_dependencies[\"@pnpm.e2e/generated-bins\"] = \"1.0.0\".into();","+        write_manifest(","+            &workspace,","+            &serde_json::json!({ \"name\": \"root\", \"dependencies\": root_dependencies }),","+        );","+        write_manifest(","+            &workspace.join(\"project-1\"),","+            &serde_json::json!({","+                \"name\": \"project-1\",","+                \"version\": \"1.0.0\",","+                \"dependencies\": dependencies(\"1.0.0\"),","+            }),","+        );","+    };","+    let installed_version = |dir: &Path| -> String {","+        let manifest = fs::read_to_string(dir.join(\"is-positive/package.json\"))","+            .unwrap_or_else(|error| panic!(\"read {}: {error}\", dir.display()));","+        let manifest: serde_json::Value = serde_json::from_str(&manifest).expect(\"parse manifest\");","+        manifest[\"version\"]","+            .as_str()","+            .expect(\"version\")","+            .to_string()","+    };","+    let has_bin = |dir: &Path, command: &str| {","+        fs::read_dir(dir.join(\".bin\"))","+            .into_iter()","+            .flatten()","+            .flatten()","+            .any(|entry| {","+                entry","+                    .file_name()","+                    .to_string_lossy()","+                    .starts_with(command)","+            })","+    };","+    let assert_nothing_outside = |context: &str| {","+        assert!(!workspace.join(\"vendor\").exists(), \"{context}\");","+        assert!(!root_modules_dir.join(\"../project-1\").exists(), \"{context}\");","+    };","+    write_manifests(IsPositive::Declared);","+","+    for args in [&[\"install\"][..], &[\"install\", \"--frozen-lockfile\"]] {","+        let context = format!(\"{linker} {setting:?} {args:?}\");","+        pacquet_in(&workspace)","+            .with_args(args)","+            .assert()","+            .success();","+        assert_eq!(installed_version(&root_modules_dir), \"3.1.0\", \"{context}\");","+        assert_eq!(installed_version(&project_modules_dir), \"1.0.0\", \"{context}\");","+        assert!(has_bin(&root_modules_dir, \"hello-world-js-bin\"), \"{context}\");","+        assert!(has_bin(&root_modules_dir, \"cmd1\"), \"{context}\");","+        assert_nothing_outside(&context);","+        fs::remove_dir_all(&root_modules_dir).expect(\"remove the root modules dir\");","+        fs::remove_dir_all(&project_modules_dir).expect(\"remove project-1/vendor\");","+    }","+","+    let context = format!(\"{linker} {setting:?} removal\");","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    write_manifests(IsPositive::Removed);","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!root_modules_dir.join(\"is-positive\").exists(), \"{context}\");","+    assert!(!project_modules_dir.join(\"is-positive\").exists(), \"{context}\");","+    assert!(has_bin(&root_modules_dir, \"hello-world-js-bin\"), \"{context}\");","+    assert_nothing_outside(&context);","+","+    drop((root, mock_instance));","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/importer_modules_dirs.rs","lines":["@@ -84,6 +84,26 @@ impl ImporterModulesDirs {","         self.of(&self.lockfile_dir.join(importer_id))","     }"," ","+    /// The directory that removals under `dir` must stay inside: the","+    /// lockfile directory for a path inside it, else the root's modules","+    /// directory for a path inside that one, else the lockfile directory.","+    #[must_use]","+    pub fn removal_bound(&self, dir: &Path) -> &Path {","+        let dir = lexical_normalize(dir);","+        if !dir.starts_with(lexical_normalize(&self.lockfile_dir)) && dir.starts_with(&self.root) {","+            &self.root","+        } else {","+            &self.lockfile_dir","+        }","+    }","+","+    /// The canonical path of `modules_dir` when it resolves inside its","+    /// [`Self::removal_bound`]. See [`crate::confined_modules_dir`].","+    #[must_use]","+    pub fn confined(&self, modules_dir: &Path) -> Option<PathBuf> {","+        crate::confined_modules_dir(modules_dir, self.removal_bound(modules_dir))","+    }","+","     #[must_use]","     pub fn lockfile_dir(&self) -> &Path {","         &self.lockfile_dir"],"additions":20,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/importer_modules_dirs/tests.rs","lines":["@@ -32,3 +32,68 @@ fn a_dir_holds_the_importers_inside_it() {","         assert!(!dirs.holds_importer(Path::new(dir)), \"{dir}\");","     }"," }","+","+#[test]","+fn removals_inside_the_root_modules_dir_are_bound_by_it() {","+    let dirs = ImporterModulesDirs::new(","+        Path::new(\"/ws\"),","+        Path::new(\"/elsewhere/mods\"),","+        OsStr::new(\"mods\"),","+    );","+    assert_eq!(dirs.removal_bound(Path::new(\"/elsewhere/mods\")), Path::new(\"/elsewhere/mods\"));","+    assert_eq!(","+        dirs.removal_bound(Path::new(\"/elsewhere/mods/.pnpm\")),","+        Path::new(\"/elsewhere/mods\"),","+    );","+    assert_eq!(dirs.removal_bound(Path::new(\"/elsewhere\")), Path::new(\"/ws\"));","+    assert_eq!(dirs.removal_bound(Path::new(\"/ws/packages/foo/mods\")), Path::new(\"/ws\"));","+}","+","+#[test]","+fn removals_inside_the_workspace_are_bound_by_it_when_the_root_modules_dir_contains_it() {","+    let dirs = ImporterModulesDirs::new(","+        Path::new(\"/parent/ws\"),","+        Path::new(\"..\"),","+        OsStr::new(\"node_modules\"),","+    );","+    assert_eq!(","+        dirs.removal_bound(Path::new(\"/parent/ws/packages/foo/node_modules\")),","+        Path::new(\"/parent/ws\"),","+    );","+    assert_eq!(dirs.removal_bound(Path::new(\"/parent/.pnpm\")), Path::new(\"/parent\"));","+}","+","+#[test]","+fn removals_inside_a_root_modules_dir_in_the_workspace_are_bound_by_the_workspace() {","+    let dirs =","+        ImporterModulesDirs::new(Path::new(\"/ws\"), Path::new(\"vendor\"), OsStr::new(\"vendor\"));","+    assert_eq!(dirs.removal_bound(Path::new(\"/ws/vendor\")), Path::new(\"/ws\"));","+    assert_eq!(dirs.removal_bound(Path::new(\"/ws/vendor/.pnpm\")), Path::new(\"/ws\"));","+}","+","+#[cfg(windows)]","+#[test]","+fn removal_bounds_use_windows_paths() {","+    let external = ImporterModulesDirs::new(","+        Path::new(r\"C:\\ws\"),","+        Path::new(r\"D:\\elsewhere\\mods\"),","+        OsStr::new(\"mods\"),","+    );","+    assert_eq!(","+        external.removal_bound(Path::new(r\"D:\\elsewhere\\mods\\.pnpm\")),","+        Path::new(r\"D:\\elsewhere\\mods\"),","+    );","+    assert_eq!(external.removal_bound(Path::new(r\"D:\\elsewhere\")), Path::new(r\"C:\\ws\"));","+    assert_eq!(external.removal_bound(Path::new(r\"C:\\ws\\packages\\foo\\mods\")), Path::new(r\"C:\\ws\"));","+","+    let containing = ImporterModulesDirs::new(","+        Path::new(r\"C:\\parent\\ws\"),","+        Path::new(\"..\"),","+        OsStr::new(\"node_modules\"),","+    );","+    assert_eq!(","+        containing.removal_bound(Path::new(r\"C:\\parent\\ws\\packages\\foo\\node_modules\")),","+        Path::new(r\"C:\\parent\\ws\"),","+    );","+    assert_eq!(containing.removal_bound(Path::new(r\"C:\\parent\\.pnpm\")), Path::new(r\"C:\\parent\"));","+}"],"additions":65,"deletions":0,"tr