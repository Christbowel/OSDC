ull();","+    }","+","+    @Test","+    @DisplayName(\"an answered stream keeps Google's own finish reason\")","+    void answeredStreamKeepsItsFinishReason() throws Exception {","+        stubStream(\"data: \" + ANSWER_CHUNK.replace(\"\\n\", \" \") + \"\\n\\n\");","+","+        var outcome = stream(request(20, null));","+","+        assertThat(outcome.errors()).isEmpty();","+        assertThat(outcome.content()).isEqualTo(\"Hello\");","+        assertThat(outcome.lastChoice().finishReason()).isEqualTo(\"stop\");","+    }","+","+    private static Stream<Arguments> finishReasonCases() {","+        var empty = response(null, null, null);","+        return Stream.of(","+                Arguments.of(\"empty under a limit\", 20, null, empty, FinishReason.LENGTH),","+                Arguments.of(\"empty under a limit, thinking level auto\", 20,","+                        Map.of(\"thinking\", Map.of(\"level\", \"auto\")), empty, FinishReason.LENGTH),","+                Arguments.of(\"empty without a limit\", null, null, empty, null),","+                Arguments.of(\"empty with a limit of 0\", 0, null, empty, null),","+                Arguments.of(\"empty with thinking off by a zero budget\", 20,","+                        Map.of(\"thinking\", Map.of(\"budget_tokens\", 0)), empty, null),","+                Arguments.of(\"empty with thinking level off\", 20,","+                        Map.of(\"thinking\", Map.of(\"level\", \"off\")), empty, null),","+                Arguments.of(\"text without a finish reason\", 20, null, response(\"Hello\", null, null), null),","+                Arguments.of(\"usage without a finish reason\", 20, null,","+                        response(null, null, new TokenUsage(22, 0, 38)), null),","+                Arguments.of(\"Google's own stop\", 20, null,","+                        response(\"Hello\", FinishReason.STOP, new TokenUsage(3, 1, 40)), FinishReason.STOP),","+                Arguments.of(\"Google's own length\", 20, null,","+                        response(null, FinishReason.LENGTH, new TokenUsage(22, 0, 38)), FinishReason.LENGTH));","+    }","+","+    @ParameterizedTest(name = \"{0}\")","+    @MethodSource(\"finishReasonCases\")","+    @DisplayName(\"keeps each finish reason, except an empty stream under an output limit with thinking not turned off, which gets length\")","+    void addsLengthOnlyToAnEmptyStreamUnderALimit(String name, Integer maxCompletionTokens,","+            Map<String, Object> customParameters, ChatResponse response, FinishReason expected) {","+        var result = LlmProviderGemini.withCutOffWhileThinking(request(maxCompletionTokens, customParameters),","+                response);","+","+        assertThat(result.finishReason()).as(\"[%s] finish reason\", name).isEqualTo(expected);","+        assertThat(result.aiMessage()).as(\"[%s] message\", name).isEqualTo(response.aiMessage());","+        assertThat(result.tokenUsage()).as(\"[%s] token usage\", name).isEqualTo(response.tokenUsage());","+    }","+","+    private static ChatResponse response(String text, FinishReason finishReason, TokenUsage tokenUsage) {","+        return ChatResponse.builder()","+                .aiMessage(AiMessage.builder().text(text).build())","+                .finishReason(finishReason)","+                .tokenUsage(tokenUsage)","+                .build();","+    }","+","+    private static ChatCompletionRequest request(Integer maxCompletionTokens, Map<String, Object> customParameters) {","+        return ChatCompletionRequest.builder()","+                .model(MODEL)","+                .addUserMessage(\"hello\")","+                .maxCompletionTokens(maxCompletionTokens)","+                .customParameters(customParameters)","+                .build();","+    }","+","+    private void stubStream(String body) {","+        wireMock.server().stubFor(post(urlPathMatching(STREAM_GENERATE_CONTENT_PATH))","+                .willReturn(aResponse()","+                        .withHeader(\"Content-Type\", \"text/event-stream\")","+                        .withBody(body)));","+    }","+","+    private record StreamOutcome(List<ChatCompletionResponse> messages, List<Throwable> errors) {","+","+        String content() {","+            return messages.stream()","+                    .map(message -> message.choices().getFirst().delta().content())","+                    .filter(Objects::nonNull)","+                    .collect(Collectors.joining());","+        }","+","+        ChatCompletionChoice lastChoice() {","+            return messages.getLast().choices().getFirst();","+        }","+    }","+","+    private StreamOutcome stream(ChatCompletionRequest request) throws Exception {","+        var messages = new CopyOnWriteArrayList<ChatCompletionResponse>();","+        var errors = new CopyOnWriteArrayList<Throwable>();","+        var terminal = new CountDownLatch(1);","+        var delegate = new ChunkedResponseHandler(messages::add, terminal::countDown, error -> {","+            errors.add(error);","+            terminal.countDown();","+        }, MODEL);","+","+        GoogleAiGeminiStreamingChatModel.builder()","+                .baseUrl(\"http://localhost:%d/v1beta\".formatted(wireMock.server().port()))","+                .apiKey(\"test-api-key\")","+                .modelName(MODEL)","+                .maxOutputTokens(request.maxCompletionTokens())","+                .returnThinking(false)","+                .build()","+                .chat(List.of(UserMessage.from(\"hello\")),","+                        LlmProviderGemini.streamHandler(request, delegate,","+                                new StreamingResponseLogger(\"model=\" + MODEL, MODEL)));","+","+        assertThat(terminal.await(10, TimeUnit.SECONDS)).isTrue();","+        return new StreamOutcome(messages, errors);","+    }","+}"],"additions":189,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/playground/useCompletionProxyStreaming.test.ts","lines":["@@ -417,3 +417,93 @@ describe(\"the penalties a playground run sends\", () => {","     },","   );"," });","+","+describe(\"the finish reason a playground run reports\", () => {","+  afterEach(() => {","+    vi.restoreAllMocks();","+  });","+","+  const sse = (...events: object[]) =>","+    events.map((event) => `data: ${JSON.stringify(event)}\\n\\n`).join(\"\") +","+    \"data: [DONE]\\n\\n\";","+","+  const runAgainst = async (body: string) => {","+    vi.spyOn(globalThis, \"fetch\").mockResolvedValue(new Response(body));","+    const { result } = renderHook(() =>","+      useCompletionProxyStreaming({ workspaceName: \"default\" }),","+    );","+","+    return result.current({","+      model: PROVIDER_MODEL_TYPE.GPT_5_NANO,","+      messages: [{ role: LLM_MESSAGE_ROLE.user, content: \"hi\" }],","+      configs: { maxCompletionTokens: 60 } as LLMPromptConfigsType,","+      onAddChunk: vi.fn(),","+      signal: new AbortController().signal,","+    });","+  };","+","+  const USAGE = { prompt_tokens: 58, completion_tokens: 60, total_tokens: 118 };","+","+  it.each<[string, string, string | null, typeof USAGE | null]>([","+    [","+      \"keeps OpenAI's length although the usage chunk after it has no choices\",","+      sse(","+        { choices: [{ index: 0, delta: { content: \"\" } }] },","+        { choices: [{ index: 0, delta: {}, finish_reason: \"length\" }] },","+        { choices: [], usage: USAGE },","+      ),","+      \"length\",","+      USAGE,","+    ],","+    [","+      \"reads a finish reason sent together with the usage\",","+      sse(","+        { choices: [{ delta: { content: \"\" } }] },","+        {","+          choices: [{ delta: { content: \"\" }, finish_reason: \"length\" }],","+          usage: USAGE,","+        },","+      ),","+      \"length\",","+      USAGE,","+    ],","+    [","+      \"reports stop for an answer that finished normally without usage\",","+      sse(","+        { choices: [{ delta: { content: \"hi\" } }] },","+        { choices: [{ delta: { content: \"\"