Google's stream drops the last chunk because it","+    // has no parts, so the body is empty: no text, no finish reason, no usage. The same call without streaming says","+    // MAX_TOKENS. Asking for thought summaries keeps that chunk, but it delays every answer and models that cannot","+    // think reject it, so the empty stream is read as the limit running out instead.","+    static ChatResponse withCutOffWhileThinking(ChatCompletionRequest request, ChatResponse response) {","+        if (response.finishReason() != null","+                || response.tokenUsage() != null","+                || StringUtils.isNotEmpty(response.aiMessage().text())","+                || !hasOutputLimit(request)","+                || isThinkingTurnedOff(request)) {","+            return response;","+        }","+        log.info(\"Gemini stream for model '{}' ended empty with max output tokens '{}', reporting finish reason '{}'\",","+                request.model(), request.maxCompletionTokens(), FinishReason.LENGTH);","+        return response.toBuilder()","+                .metadata(response.metadata().toBuilder().finishReason(FinishReason.LENGTH).build())","+                .build();","+    }","+","+    private static boolean hasOutputLimit(ChatCompletionRequest request) {","+        return request.maxCompletionTokens() != null && request.maxCompletionTokens() > 0;","+    }","+","+    private static boolean isThinkingTurnedOff(ChatCompletionRequest request) {","+        return GeminiThinkingParams.from(request.customParameters())","+                .wireBudgetFor(request.model())","+                .filter(budget -> budget == 0)","+                .isPresent();","+    }","+","     @Override","     public void validateRequest(@NonNull ChatCompletionRequest request) {","     }"],"additions":45,"deletions":1,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/llm/openai/LlmProviderOpenAiResponsesMapper.java","lines":["@@ -1,6 +1,7 @@"," package co