r's Git connect sits behind, or null when it is","+ * always available. A new provider has to pick one.","+ */","+const VCS_CONNECT_FLAGS: Record<VcsProviderId, VcsConnectFlag | null> = {","+  github: null,","+  entire: 'vcsEntire',","+  origin: 'extraVcsOAuth',","+  gitlab: null,","+  bitbucket: null,","+}"," "," /**","  * Connect/authorize providers shown in Git installation UI.","  * Existing installations of a hidden provider still render; only new OAuth","  * connect actions are filtered.","- *","- * `extraVcsOAuth` gates Origin and Entire; every other provider is always visible.","  */"," export function getVisibleVcsOAuthProviders(","-  extraVcsOAuth: boolean,","+  features: Pick<ConsoleProfileFeatures, VcsConnectFlag>,"," ): VcsProviderMeta[] {","-  return Object.values(VCS_PROVIDERS).filter(","-    (provider) =>","-      ALWAYS_ENABLED_VCS_PROVIDERS.has(provider.id) || extraVcsOAuth,","-  )","+  return Object.values(VCS_PROVIDERS).filter((provider) => {","+    const flag = VCS_CONNECT_FLAGS[provider.id]","+    return flag === null || features[flag]","+  })"," }"," "," /**"],"additions":22,"deletions":13,"truncated":false},{"path":"apps/console/tests/unit/vcs-connect-providers.test.ts","lines":["@@ -0,0 +1,32 @@","+import { describe, expect, test } from 'bun:test'","+import { CONSOLE_PROFILES } from '@/lib/console-profiles'","+import { getVisibleVcsOAuthProviders } from '@/lib/vcs/providers'","+","+const ids = (features: { extraVcsOAuth: boolean; vcsEntire: boolean }) =>","+  getVisibleVcsOAuthProviders(features).map((provider) => provider.id)","+","+describe('Git connect providers', () => {","+  test('both profiles hide Origin and Entire by default', () => {","+    for (const profile of Object.values(CONSOLE_PROFILES)) {","+      expect(ids(profile.features)).toEqual(['github', 'gitlab', 'bitbucket'])","+    }","+  })","+","+  test('vcsEntire shows only Entire, second after GitHub', () => {","+    expect(ids({ extraVcsOAuth: false, vcsEntire: true })).toEqual([","+      'github',","+      'entire',","+      'gitlab',","+      'bitbucket',","+    ])","+  })","+","+  test('extraVcsOAuth shows only Origin', () => {","+    expect(ids({ extraVcsOAuth: true, vcsEntire: false })).toEqual([","+      'github',","+      'origin',","+      'gitlab',","+      'bitbucket',","+    ])","+  })","+})",""],"additions":32,"deletions":0,"truncated":false}],"additions":96,"deletions":20,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-10-20T14:24:46.311527+00:00"}