dy()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowSafeElements()","+        ;","+","+        $this->assertSame('<p>Hello</p>', $this->sanitize($config, '<body inert><p>Hello</p></body>'));","+        $this->assertSame('<p>Hello</p>', $this->sanitize($config, '<html dir=\"rtl\"><p>Hello</p></html>'));","+        $this->assertSame('<div>Hello</div>', $this->sanitize($config, '<div><body inert>Hello</body></div>'));","+","+        $document = '<html dir=\"rtl\"><head><title>Hello</title></head><body inert><p>world</p></body></html>';","+        $this->assertSame('<p>world</p>', $this->sanitize($config, $document));","+        $this->assertSame('<p>world</p>', (new HtmlSanitizer($config))->sanitizeFor('html', $document));","+    }","+","+    public function testSanitizeWithSafeElementsDropsTheOpenerLinkType()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowSafeElements()","+        ;","+","+        $this->assertSame(","+            '<a href=\"https://example.com/\" target=\"_blank\">Hello</a>',","+            $this->sanitize($config, '<a href=\"https://example.com/\" target=\"_blank\" rel=\"opener\">Hello</a>')","+        );","+","+        $this->assertSame(","+            '<a href=\"https://example.com/\" target=\"_blank\" rel=\"nofollow noreferrer\">Hello</a>',","+            $this->sanitize($config, '<a href=\"https://example.com/\" target=\"_blank\" rel=\"nofollow OPENER noreferrer\">Hello</a>')","+        );","+","+        $this->assertSame(","+            '<area href=\"https://example.com/\" target=\"_blank\" />',","+            $this->sanitize($config, '<area href=\"https://example.com/\" target=\"_blank\" rel=\"opener\">')","+        );","+    }","+","+    public function testSanitizeWithSafeElementsTurnsNamedTargetsIntoBlank()","+    {","+        $config = (new HtmlSanitizerConfig())","+            ->allowSafeElements()","+        ;","+","+        foreach (['foo', '_new', ' _blank'] as $target) {","+            $this->assertSame(","+                '<a href=\"https://example.com/\" target=\"_blank\">Hello</a>',","+                $this->sanitize($config, \\sprintf('<a href=\"https://example.com/\" target=\"%s\">Hello</a>', $target))","+            );","+        }","+","+        foreach (['_blank', '_BLANK', '_self', '_parent', '_top'] as $target) {","+            $this->assertSame(","+                \\sprintf('<a href=\"https://example.com/\" target=\"%s\" rel=\"noopener\">Hello</a>', $target),","+                $this->sanitize($config, \\sprintf('<a href=\"https://example.com/\" target=\"%s\" rel=\"noopener\">Hello</a>', $target))","+            );","+        }","+    }","+","     public function testSanitizeForTextarea()","     {","         $config = (new HtmlSanitizerConfig())"],"additions":58,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/HtmlSanitizer/Visitor/AttributeSanitizer/LinkTargetAttributeSanitizer.php","lines":["@@ -0,0 +1,53 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\HtmlSanitizer\\Visitor\\AttributeSanitizer;","+","+use Symfony\\Component\\HtmlSanitizer\\HtmlSanitizerConfig;","+use Symfony\\Component\\HtmlSanitizer\\TextSanitizer\\StringSanitizer;","+","+/**","+ * Prevents links from giving the pages they open access to the current page.","+ *","+ * Browsers expose the current page as window.opener when a link uses the \"opener\"","+ * link type or a named target. Named targets are turned into \"_blank\", which also","+ * prevents links from navigating the frames of the page.","+ *","+ * @internal","+ */","+final class LinkTargetAttributeSanitizer implements AttributeSanitizerInterface","+{","+    public function getSupportedElements(): ?array","+    {","+        return ['a', 'area'];","+    }","+","+    public function getSupportedAttributes(): ?array","+    {","+        return ['rel', 'target'];","+    }","+","+    public function sanitizeAttribute(string $element, string $attribute, string $value, HtmlSanitizerConfig $config): ?string","+    {","+        if ('target' === $attribute) {","+            return \\in_array(StringSanitizer::htmlLower($value), ['', '_blank', '_self', '_parent', '_top'], true) ? $value : '_blank';","+        }","+","+        $linkTypes = preg_split('/[ \\t\\n\\f\\r]+/', $value, -1, \\PREG_SPLIT_NO_EMPTY);","+        $kept = array_filter($linkTypes, static fn (string $linkType) => 'opener' !== StringSanitizer::htmlLower($linkType));","+","+        if (\\count($kept) === \\count($linkTypes)) {","+            return $value;","+        }","+","+        return $kept ? implode(' ', $kept) : null;","+    }","+}",""],"additions":53,"deletions":0,"truncated":false}],"additions":116,"deletions":3,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-06T17:01:44.142660+00:00"}