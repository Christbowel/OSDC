s (`aws`, `azure` or `gcp`) or `encryption.kms-impl` with the client class path for custom KMS clients.","+1. Catalog property that specifies the KMS (\"key management service\"). It can be either `encryption.kms-type` for pre-defined KMS clients (`aws`, `azure`, `gcp` or `aliyun`) or `encryption.kms-impl` with the client class path for custom KMS clients."," 2. Table property `encryption.key-id`, that specifies the ID of a master key used to encrypt and decrypt the table. Master keys are stored and managed in the KMS."," "," For more details on table encryption, see the \"Appendix: Internals Overview\" [subsection](#appendix-internals-overview)."],"additions":1,"deletions":1,"truncated":false},{"path":"gradle/libs.versions.toml","lines":["@@ -21,7 +21,8 @@"," "," [versions]"," activation = \"1.1.1\"","-aliyun-credentials-java = \"0.3.12\"","+aliyun-credentials-java = \"1.0.3\"","+aliyun-sdk-kms = \"2.3.0\""," aliyun-sdk-oss = \"3.18.5\""," aliyun-tea = \"1.4.2\""," analyticsaccelerator = \"1.3.1\"","@@ -98,6 +99,7 @@ tez08 = { strictly = \"0.8.4\"}  # see rich version usage explanation above"," activation = { module = \"javax.activation:activation\", version.ref = \"activation\" }"," aircompressor = { module = \"io.airlift:aircompressor\", version.ref = \"aircompressor\" }"," aliyun-credentials-java = { module = \"com.aliyun:credentials-java\", version.ref = \"aliyun-credentials-java\" }","+aliyun-sdk-kms = { module = \"com.aliyun:kms20160120\", version.ref = \"aliyun-sdk-kms\" }"," aliyun-sdk-oss = { module = \"com.aliyun.oss:aliyun-sdk-oss\", version.ref = \"aliyun-sdk-oss\" }"],"additions":3,"deletions":1,"truncated":false}],"additions":558,"deletions":4,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-10T14:53:13.263720+00:00"}