{"id":"bfbbf8b141c32816fda2f143c3dd688cfa2b4f6e","axis":"silent","repo":"envoyproxy/envoy","sha":"bfbbf8b141c32816fda2f143c3dd688cfa2b4f6e","parsed":{"files":[{"path":"changelogs/current/bug_fixes/dynamic_modules__scheduler-commit-owner-thread.rst","lines":["@@ -0,0 +1,7 @@","+Fixed a crash when a dynamic module committed an event through a scheduler from one of its own threads","+while Envoy released the last other reference to the scheduler's owner, for example during a listener","+update. The owner's destructor and the module's destroy hook could then run on the module's thread and","+cancel callouts or reset streams that belong to the main or worker thread. The HTTP, network and listener","+filter, filter configuration, bootstrap extension, stats sink and TLS certificate selector schedulers no","+longer hold a reference to their owner, so a commit can no longer destroy it. Events committed after the","+owner starts its teardown are dropped."],"additions":7,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/BUILD","lines":["@@ -198,6 +198,7 @@ envoy_cc_library(","         \"//source/common/stats:utility_lib\",","         \"//source/extensions/dynamic_modules:dynamic_modules_lib\",","         \"//source/extensions/dynamic_modules:metric_registry\",","+        \"//source/extensions/dynamic_modules:scheduler_lib\",","     ],"," )"," "],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/abi_impl.cc","lines":["@@ -52,7 +52,7 @@ envoy_dynamic_module_type_bootstrap_extension_config_scheduler_module_ptr"," envoy_dynamic_module_callback_bootstrap_extension_config_scheduler_new(","     envoy_dynamic_module_type_bootstrap_extension_config_envoy_ptr extension_config_envoy_ptr) {","   auto* config = static_cast<DynamicModuleBootstrapExtensionConfig*>(extension_config_envoy_ptr);","-  return new DynamicModuleBootstrapExtensionConfigScheduler(config->weak_from_this());","+  return new DynamicModuleBootstrapExtensionConfigScheduler(config->scheduler_target_);"," }"," "," void envoy_dynamic_module_callback_bootstrap_extension_config_scheduler_delete("],"additions":1,"deletions":1,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/extension_config.cc","lines":["@@ -48,6 +48,9 @@ DynamicModuleBootstrapExtensionConfig::DynamicModuleBootstrapExtensionConfig("," }"," "," DynamicModuleBootstrapExtensionConfig::~DynamicModuleBootstrapExtensionConfig() {","+  // Stop the schedulers before the destroy hook, which may join a module thread that is committing","+  // an event.","+  scheduler_target_->clear();","   xds_update_handle_.reset();","   extension_config_subscription_.reset();","   // Cancel any pending HTTP callouts before destroying the config.","@@ -836,6 +839,7 @@ newDynamicModuleBootstrapExtensionConfig(","   auto config = std::make_shared<DynamicModuleBootstrapExtensionConfig>(","       extension_name, extension_config, metrics_namespace, std::move(dynamic_module),","       main_thread_dispatcher, context, stats_store);","+  config->scheduler_target_->initialize(main_thread_dispatcher, config);"," ","   // The module constructor can enable the writers, which capture their done hooks, so the optional","   // hooks are resolved first."],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/extension_config.h","lines":["@@ -26,6 +26,7 @@"," #include \"source/extensions/dynamic_modules/abi/abi.h\""," #include \"source/extensions/dynamic_modules/dynamic_modules.h\""," #include \"source/extensions/dynamic_modules/metric_registry.h\"","+#include \"source/extensions/dynamic_modules/scheduler.h\""," "," #include \"absl/container/flat_hash_map.h\""," #include \"absl/functional/function_ref.h\"","@@ -383,6 +384,12 @@ class DynamicModuleBootstrapExtensionConfig","   // The main thread dispatcher.","   Event::Dispatcher& main_thread_dispatcher_;"," ","+  // Shared with the schedulers of this config. Initialized once the config is held by a shared","+  // pointer, before the module can create a scheduler, and cleared at the start of the destructor.","+  using SchedulerTarget = Extensions::DynamicModules::DynamicModuleSchedulerTarget<","+      DynamicModuleBootstrapExtensionConfig>;","+  const std::shared_ptr<SchedulerTarget> scheduler_target_{std::make_shared<SchedulerTarget>()};","+","   // File watchers created by","   // envoy_dynamic_module_callback_bootstrap_extension_file_watcher_add_watch. Envoy owns the","   // lifetime, so watchers are destroyed when the config is destroyed.","@@ -522,30 +529,8 @@ using DynamicModuleBootstrapExtensionConfigSharedPtr =","  * envoy_dynamic_module_callback_bootstrap_extension_config_scheduler_new and deleted via","  * envoy_dynamic_module_callback_bootstrap_extension_config_scheduler_delete.","  */","-class DynamicModuleBootstrapExtensionConfigScheduler {","-public:","-  explicit DynamicModuleBootstrapExtensionConfigScheduler(","-      std::weak_ptr<DynamicModuleBootstrapExtensionConfig> config)","-      : config_(std::move(config)) {}","-","-  void commit(uint64_t event_id) {","-    // Lock the config so its dispatcher member stays valid across `post`.","-    auto config_shared = config_.lock();","-    if (!config_shared) {","-      return;","-    }","-    config_shared->main_thread_dispatcher_.post([config = config_, event_id]() {","-      if (std::shared_ptr<DynamicModuleBootstrapExtensionConfig> cs = config.lock()) {","-        cs->onScheduled(event_id);","-      }","-    });","-  }","-","-private:","-  // The config that this scheduler is associated with. Using a weak pointer to avoid unnecessarily","-  // extending the lifetime of the config.","-  std::weak_ptr<DynamicModuleBootstrapExtensionConfig> config_;","-};","+using DynamicModuleBootstrapExtensionConfigScheduler =","+    Extensions::DynamicModules::DynamicModuleScheduler<DynamicModuleBootstrapExtensionConfig>;"," "," /**","  * This class wraps an Envoy timer for use by bootstrap extension dynamic modules. It is created via"],"additions":9,"deletions":24,"truncated":false},{"path":"source/extensions/dynamic_modules/BUILD","lines":["@@ -68,6 +68,16 @@ envoy_cc_library(","     ],"," )"," ","+envoy_cc_library(","+    name = \"scheduler_lib\",","+    hdrs = [\"scheduler.h\"],","+    deps = [","+        \"//envoy/event:dispatcher_interface\",","+        \"@abseil-cpp//absl/base:core_headers\",","+        \"@abseil-cpp//absl/synchronization\",","+    ],","+)","+"," envoy_cc_library(","     name = \"abi_context_accessors_lib\",","     srcs = [\"abi_context_accessors.cc\"],"],"additions":10,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/abi/abi.h","lines":["@@ -15165,9 +15165,8 @@ envoy_dynamic_module_on_tls_certificate_selector_config_new(","  * envoy_dynamic_module_on_tls_certificate_selector_config_destroy is called when the certificate","  * selector configuration is destroyed in Envoy, after every selector created from it is destroyed.","  * The module should release any resources associated with the in-module configuration. This may","- * run on a worker thread when a connection outlives the TLS context, or on a thread that calls","- * envoy_dynamic_module_callback_tls_certificate_selector_config_scheduler_commit, so it must not","- * assume the main thread.","+ * run on a worker thread when a connection outlives the TLS context, so it must not assume the main","+ * thread.","  *","  * @param config_module_ptr is the pointer to the in-module certificate selector configuration being","  * destroyed."],"additions":2,"deletions":3,"truncated":false},{"path":"source/extensions/dynamic_modules/scheduler.h","lines":["@@ -0,0 +1,102 @@","+#pragma once","+","+#include <cstdint>","+#include <memory>","+","+#include \"envoy/event/dispatcher.h\"","+","+#include \"absl/base/thread_annotations.h\"","+#include \"absl/synchronization/mutex.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace DynamicModules {","+","+/**","+ * The state that an object shares with the schedulers the module creates for it. A scheduler holds","+ * this target instead of the object, so it never extends the lifetime of the object, and the","+ * object is always destroyed by its own thread rather than by a module thread that commits an","+ * event.","+ *","+ * The owner initializes the target once it is held by a shared pointer and before the module can","+ * commit an event, and clears it at the start of its teardown. Events committed before the target","+ * is initialized or after it is cleared are dropped, and so are events that run after the owner is","+ * destroyed. Events that are delivered call Owner::onScheduled(uint64_t) on the owner's thread.","+ */","+template <class Owner> class DynamicModuleSchedulerTarget {","+public:","+  /**","+   * Starts posting committed events for the owner to the dispatcher.","+   * @param dispatcher the dispatcher of the thread the owner runs on.","+   * @param owner the owner of this target.","+   */","+  void initialize(Event::Dispatcher& dispatcher, std::weak_ptr<Owner> owner) {","+    absl::MutexLock lock(mutex_);","+    dispatcher_ = &dispatcher;","+    owner_ = std::move(owner);","+  }","+","+  /**","+   * Stops posting committed events. After this returns, no thread is posting to the dispatcher","+   * through this target. The owner calls this before its teardown calls any module hook, since a","+   * destroy hook may join a module thread that is waiting in commit().","+   */","+  void clear() {","+    absl::MutexLock lock(mutex_);","+    dispatcher_ = nullptr;","+  }","+","+  /**","+   * Posts the event to the owner's dispatcher. Safe to call from any thread.","+   * @param event_id the module defined ID of the event.","+   */","+  void commit(uint64_t event_id) {","+    // The lock keeps the dispatcher alive across `post`, since the owner clears the pointer under","+    // the same lock before the dispatcher can be destroyed.","+    // TODO(wbpcode): find a lock-free way to do this, for example an atomic dispatcher pointer plus","+    // a count of in-flight commits that the teardown waits on. An atomic pointer alone is not","+    // enough: commit() could load a non-null pointer, then the owner and its dispatcher could be","+    // destroyed before post() runs.","+    absl::MutexLock lock(mutex_);","+    if (dispatcher_ == nullptr) {","+      return;","+    }","+    dispatcher_->post([owner = owner_, event_id]() {","+      if (std::shared_ptr<Owner> owner_shared = owner.lock()) {","+        owner_shared->onScheduled(event_id);","+      }","+    });","+  }","+","+private:","+  absl::Mutex mutex_;","+  Event::Dispatcher* dispatcher_ ABSL_GUARDED_BY(mutex_){nullptr};","+  std::weak_ptr<Owner> owner_ ABSL_GUARDED_BY(mutex_);","+};","+","+template <class Owner>","+using DynamicModuleSchedulerTargetSharedPtr = std::shared_ptr<DynamicModuleSchedulerTarget<Owner>>;","+","+/**","+ * A scheduler that a module creates to run an event hook of an object on the object's thread from","+ * any thread, including the ones the module manages.","+ */","+template <class Owner> class DynamicModuleScheduler {","+public:","+  explicit DynamicModuleScheduler(DynamicModuleSchedulerTargetSharedPtr<Owner> target)","+      : target_(std::move(target)) {}","+","+  /**","+   * Schedules the event hook of the owner. Safe to call from any thread, and a no-op once the","+   * owner has started its teardown.","+   * @param event_id the module defined ID of the event.","+   */","+  void commit(uint64_t event_id) { target_->commit(event_id); }","+","+private:","+  const DynamicModuleSchedulerTargetSharedPtr<Owner> target_;","+};","+","+} // namespace DynamicModules","+} // namespace Extensions","+} // namespace Envoy"],"additions":102,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/go/internal/scheduler/scheduler.go","lines":["@@ -37,8 +37,8 @@ func (s *Scheduler) Schedule(task func()) {"," \ts.active++"," \ts.mu.Unlock()"," ","-\t// A native commit can release its last reference to the Envoy object and re-enter","-\t// Close. Keep the native scheduler alive until every in-flight commit returns.","+\t// Close can run on the main thread while a commit is in flight. Keep the native","+\t// scheduler alive until every in-flight commit returns."," \tdefer func() {"," \t\ts.mu.Lock()"," \t\ts.active--"],"additions":2,"deletions":2,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/go/shared/bootstrap_api.go","lines":["@@ -13,9 +13,8 @@ type BootstrapExtensionConfigFactory interface {"," type BootstrapExtensionConfig interface {"," \t// Create creates an instance. Returning nil rejects the extension."," \tCreate(handle BootstrapExtensionHandle) BootstrapExtension","-\t// OnDestroy releases configuration resources. It can run on the goroutine","-\t// whose scheduler commit releases the last native configuration reference.","-\t// Do not call main-thread-only host services or wait for that commit to return.","+\t// OnDestroy releases configuration resources. Schedulers do not keep the","+\t// configuration alive, and tasks scheduled after it starts are discarded."," \tOnDestroy()"," }"," "],"additions":2,"deletions":3,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/abi.rs","lines":["@@ -15652,9 +15652,8 @@ unsafe extern \"C\" {","     /** envoy_dynamic_module_on_tls_certificate_selector_config_destroy is called when the certificate","  selector configuration is destroyed in Envoy, after every selector created from it is destroyed.","  The module should release any resources associated with the in-module configuration. This may","- run on a worker thread when a connection outlives the TLS context, or on a thread that calls","- envoy_dynamic_module_callback_tls_certificate_selector_config_scheduler_commit, so it must not","- assume the main thread.","+ run on a worker thread when a connection outlives the TLS context, so it must not assume the main","+ thread."," ","  @param config_module_ptr is the pointer to the in-module certificate selector configuration being","  destroyed.*/"],"additions":2,"deletions":3,"truncated":false},{"path":"source/extensions/filters/http/dynamic_modules/BUILD","lines":["@@ -23,6 +23,7 @@ envoy_cc_library(","         \"//source/common/secret:secret_provider_impl_lib\",","         \"//source/extensions/dynamic_modules:dynamic_modules_lib\",","         \"//source/extensions/dynamic_modules:metric_registry\",","+        \"//source/extensions/dynamic_modules:scheduler_lib\",","         \"//source/extensions/filters/http/common:pass_through_filter_lib\",","         \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","     ],","@@ -37,6 +38,7 @@ envoy_cc_library(","         \"//envoy/event:dispatcher_interface\",","         \"//source/common/event:deferred_task\",","         \"//source/common/tracing:null_span_lib\",","+        \"//source/extensions/dynamic_modules:scheduler_lib\",","         \"//source/extensions/filters/http/common:pass_through_filter_lib\",","     ],"," )"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/dynamic_modules/abi_impl.cc","lines":["@@ -2599,7 +2599,7 @@ envoy_dynamic_module_type_http_filter_scheduler_module_ptr"," envoy_dynamic_module_callback_http_filter_scheduler_new(","     envoy_dynamic_module_type_http_filter_envoy_ptr filter_envoy_ptr) {","   auto filter = static_cast<DynamicModuleHttpFilter*>(filter_envoy_ptr);","-  return new DynamicModuleHttpFilterScheduler(filter->weak_from_this());","+  return new DynamicModuleHttpFilterScheduler(filter->schedulerTarget());"," }"," "," void envoy_dynamic_module_callback_http_filter_scheduler_delete(","@@ -2619,7 +2619,7 @@ envoy_dynamic_module_type_http_filter_config_scheduler_module_ptr"," envoy_dynamic_module_callback_http_filter_config_scheduler_new(","     envoy_dynamic_module_type_http_filter_config_envoy_ptr filter_config_envoy_ptr) {","   auto filter_config = static_cast<DynamicModuleHttpFilterConfig*>(filter_config_envoy_ptr);","-  return new DynamicModuleHttpFilterConfigScheduler(filter_config->weak_from_this());","+  return new DynamicModuleHttpFilterConfigScheduler(filter_config->scheduler_target_);"," }"," "," void envoy_dynamic_module_callback_http_filter_config_scheduler_delete("],"additions":2,"deletions":2,"truncated":false},{"path":"source/extensions/filters/http/dynamic_modules/filter.cc","lines":["@@ -15,7 +15,8 @@ namespace DynamicModules {"," namespace HttpFilters {"," "," DynamicModuleHttpFilter::~DynamicModuleHttpFilter() {","-  // In a well-formed filter chain onDestroy() has already run and this is a no-op.","+  // In a well-formed filter chain onDestroy() has already run and these are no-ops.","+  scheduler_target_->clear();","   destroy();"," }"," ","@@ -43,10 +44,12 @@ void DynamicModuleHttpFilter::onStreamComplete() {"," }"," "," void DynamicModuleHttpFilter::onDestroy() {","+  // Stop the schedulers before the module hooks below, which may join a module thread that is","+  // committing an event.","+  scheduler_target_->clear();","   destroyed_ = true;","   // Read before the cache is cleared below, because destroy() defers the module hook onto it.","   OptRef<Event::Dispatcher> worker_dispatcher = makeOptRefFromPtr(dispatcher());","-  // Clear the cached dispatcher so any concurrent foreign-thread `commit()` short-circuits.","   cached_dispatcher_.store(nullptr, std::memory_order_release);","   // Pair with the register in maybeRegisterDownstreamWatermarkCallbacks(); the underlying","   // removeDownstreamWatermarkCallbacks() asserts the callback was previously added."],"additions":5,"deletions":2,"truncated":false},{"path":"source/extensions/filters/http/dynamic_modules/filter.h","lines":["@@ -8,6 +8,7 @@"," "," #include \"source/common/tracing/null_span_impl.h\""," #include \"source/extensions/dynamic_modules/dynamic_modules.h\"","+#include \"source/extensions/dynamic_modules/scheduler.h\""," #include \"source/extensions/filters/http/common/pass_through_filter.h\""," #include \"source/extensions/filters/http/dynamic_modules/filter_config.h\""," ","@@ -48,8 +49,8 @@ class DynamicModuleHttpFilter : public Http::StreamFilter,","   FilterMetadataStatus decodeMetadata(MetadataMap&) override;","   void setDecoderFilterCallbacks(StreamDecoderFilterCallbacks& callbacks) override {","     decoder_callbacks_ = &callbacks;","-    // Publish the worker dispatcher for cross-thread `commit()`; see `dispatcher()`.","     cached_dispatcher_.store(&callbacks.dispatcher(), std::memory_order_release);","+    scheduler_target_->initialize(callbacks.dispatcher(), weak_from_this());","     // Registration is deferred until the in-module filter exists: the factory wires callbacks","     // before initializeInModuleFilter(), and addDownstreamWatermarkCallbacks() synchronously","     // replays any pending onAboveWriteBufferHighWatermark() into the newly registered callback.","@@ -99,6 +100,13 @@ class DynamicModuleHttpFilter : public Http::StreamFilter,","    */","   Event::Dispatcher* dispatcher() { return cached_dispatcher_.load(std::memory_order_acquire); }"," ","+  /**","+   * Returns the target that the schedulers of this filter post through.","+   */","+  const DynamicModuleSchedulerTargetSharedPtr<DynamicModuleHttpFilter>& schedulerTarget() const {","+    return scheduler_target_;","+  }","+","   // ----------  Http::DownstreamWatermarkCallbacks  ----------","   void onAboveWriteBufferHighWatermark() override;","   void onBelowWriteBufferLowWatermark() override;","@@ -335,6 +343,11 @@ class DynamicModuleHttpFilter : public Http::StreamFilter,","   // Worker dispatcher published at callback-init, cleared on destroy. Read via `dispatcher()`.","   std::atomic<Event::Dispatcher*> cached_dispatcher_{nullptr};"," ","+  // Shared with the schedulers of this filter. Initialized when the decoder callbacks are set and","+  // cleared at the start of the teardown.","+  const DynamicModuleSchedulerTargetSharedPtr<DynamicModuleHttpFilter> scheduler_target_{","+      std::make_shared<DynamicModuleSchedulerTarget<DynamicModuleHttpFilter>>()};","+","   /**","    * This implementation of the AsyncClient::Callbacks is used to handle the response from the HTTP","    * callout from the parent HTTP filter.","@@ -469,35 +482,7 @@ using DynamicModuleHttpFilterWeakPtr = std::weak_ptr<DynamicModuleHttpFilter>;","  * envoy_dynamic_module_callback_http_filter_scheduler_new and deleted via","  * envoy_dynamic_module_callback_http_filter_scheduler_delete.","  */","-class DynamicModuleHttpFilterScheduler {","-public:","-  explicit DynamicModuleHttpFilterScheduler(DynamicModuleHttpFilterWeakPtr filter)","-      : filter_(std::move(filter)) {}","-","-  // Safe to call from any thread. Reads only the weak_ptr and the atomic dispatcher cache (see","-  // `DynamicModuleHttpFilter::dispatcher()`); it never dereferences `decoder_callbacks_` from a","-  // foreign thread.","-  void commit(uint64_t event_id) {","-    DynamicModuleHttpFilterSharedPtr filter_shared = filter_.lock();","-    if (!filter_shared) {","-      return;","-    }","-    Event::Dispatcher* dispatcher = filter_shared->dispatcher();","-    if (dispatcher == nullptr) {","-      return;","-    }","-    dispatcher->post([filter = filter_, event_id]() {","-      if (DynamicModuleHttpFilterSharedPtr fs = filter.lock()) {","-        fs->onScheduled(event_id);","-      }","-    });","-  }","-","-private:","-  // The filter that this scheduler is associated with. Using a weak pointer to avoid unnecessarily","-  // extending the lifetime of the filter.","-  DynamicModuleHttpFilterWeakPtr filter_;","-};","+using DynamicModuleHttpFilterScheduler = DynamicModuleScheduler<DynamicModuleHttpFilter>;"," "," } // namespace HttpFilters"," } // namespace DynamicModules"],"additions":15,"deletions":30,"truncated":false},{"path":"source/extensions/filters/http/dynamic_modules/filter_config.cc","lines":["@@ -113,6 +113,9 @@ size_t DynamicModuleHttpFilterConfig::subscribeGenericSecret(absl::string_view n"," }"," "," DynamicModuleHttpFilterConfig::~DynamicModuleHttpFilterConfig() {","+  // Stop the schedulers before the destroy hook, which may join a module thread that is committing","+  // an event.","+  scheduler_target_->clear();","   // When the initialization of the dynamic module fails, the in_module_config_ is nullptr,","   // and there's nothing to destroy from the module's point of view.","   if (on_http_filter_config_destroy_) {","@@ -315,6 +318,7 @@ absl::StatusOr<DynamicModuleHttpFilterConfigSharedPtr> newDynamicModuleHttpFilte","   auto config = std::make_shared<DynamicModuleHttpFilterConfig>(","       filter_name, filter_config, metrics_namespace, std::move(dynamic_module), stats_scope,","       context, init_manager, load_shed_point_provider);","+  config->scheduler_target_->initialize(config->main_thread_dispatcher_, config);"," ","   const void* filter_config_envoy_ptr = (*constructor.value())(","       static_cast<void*>(config.get()), {filter_name.data(), filter_name.size()},"],"additions":4,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/dynamic_modules/filter_config.h","lines":["@@ -12,6 +12,7 @@"," #include \"source/extensions/dynamic_modules/abi/abi.h\""," #include \"source/extensions/dynamic_modules/dynamic_modules.h\""," #include \"source/extensions/dynamic_modules/metric_registry.h\"","+#include \"source/extensions/dynamic_modules/scheduler.h\""," "," namespace Envoy {"," namespace Extensions {","@@ -143,6 +144,10 @@ class DynamicModuleHttpFilterConfig"," ","   Envoy::Upstream::ClusterManager& cluster_manager_;","   Event::Dispatcher& main_thread_dispatcher_;","+  // Shared with the schedulers of this config. Initialized once the config is held by a shared","+  // pointer, before the module can create a scheduler, and cleared at the start of the destructor.","+  const DynamicModuleSchedulerTargetSharedPtr<DynamicModuleHttpFi