ed together\")","+\tcase s.ClientCertificateData != \"\" && s.ClientCertificateKeyData != \"\":","+\t\tcert, err := base64.StdEncoding.DecodeString(s.ClientCertificateData)","+\t\tif err != nil {","+\t\t\treturn nil, nil, err","+\t\t}","+\t\tkey, err := base64.StdEncoding.DecodeString(s.ClientCertificateKeyData)","+\t\tif err != nil {","+\t\t\treturn nil, nil, err","+\t\t}","+\t\treturn cert, key, nil","+\tcase s.ClientCertificateData != \"\" || s.ClientCertificateKeyData != \"\":","+\t\treturn nil, nil, errors.New(\"client-certificate-data and client-certificate-key-data must always be specified together\")","+\t}","+\treturn nil, nil, nil","+}","+"," // User contains user authentication information"," type User struct {"," \tName         string `json:\"name\"`"],"additions":38,"deletions":0,"truncated":false},{"path":"util/localconfig/localconfig_test.go","lines":["@@ -3,6 +3,7 @@"," package localconfig"," "," import (","+\t\"encoding/base64\""," \t\"errors\""," \t\"os\""," \t\"path\"","@@ -365,3 +366,70 @@ func TestReadLocalConfig_ValidConfig(t *testing.T) {"," \trequire.Equal(t, \"localhost:8080\", config.CurrentContext)"," \trequire.Len(t, config.Contexts, 3)"," }","+","+func TestServerClientCertPEM(t *testing.T) {","+\tdir := t.TempDir()","+\tcertPath := filepath.Join(dir, \"client.crt\")","+\tkeyPath := filepath.Join(dir, \"client.key\")","+\trequire.NoError(t, os.WriteFile(certPath, []byte(\"cert-from-file\"), 0o600))","+\trequire.NoError(t, os.WriteFile(keyPath, []byte(\"key-from-file\"), 0o600))","+","+\tt.Run(\"not configured\", func(t *testing.T) {","+\t\tcert, key, err := (&Server{}).ClientCertPEM()","+\t\trequire.NoError(t, err)","+\t\trequire.Nil(t, cert)","+\t\trequire.Nil(t, key)","+\t})","+","+\tt.Run(\"from files\", func(t *testing.T) {","+\t\tserver := Server{ClientCertificate: certPath, ClientCertificateKey: keyPath}","+\t\tcert, key, err := server.ClientCertPEM()","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, \"cert-from-file\", string(