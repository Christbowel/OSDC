liLoginPersistsClientCert(t *testing.T) {","+\tEnsureCleanState(t)","+","+\tdir := t.TempDir()","+\tconfigPath := filepath.Join(dir, \"config\")","+\tcertPath := filepath.Join(dir, \"client.crt\")","+\tkeyPath := filepath.Join(dir, \"client.key\")","+","+\tclientCert, err := tlsutil.GenerateX509KeyPair(tlsutil.CertOptions{","+\t\tHosts:        []string{\"localhost\"},","+\t\tOrganization: \"Argo CD E2E\",","+\t\tECDSACurve:   \"P256\",","+\t\tValidFor:     24 * time.Hour,","+\t\tExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth},","+\t})","+\trequire.NoError(t, err)","+\tcertPEM, keyPEM := tlsutil.EncodeX509KeyPair(*clientCert)","+\trequire.NoError(t, os.WriteFile(certPath, certPEM, 0o600))","+\trequire.NoError(t, os.WriteFile(keyPath, keyPEM, 0o600))","+","+\targs := []string{","+\t\t\"login\", GetApiServerAddress(),","+\t\t\"--username\", \"admin\",","+\t\t\"--password\", AdminPassword,","+\t\t\"--config\", configPath,","+\t\t\"--insecure\",","+\t\t\"--client-crt\", certPath,","+\t\t\"--client-crt-key\", keyPath,","+\t}","+\tif IsPlainText() {","+\t\targs = append(args, \"--plaintext\")","+\t}","+\toutput, err := Run(\"\", \"../../dist/argocd\", args...)","+\trequire.NoError(t, err, \"login with a client certificate should succeed: %s\", output)","+","+\tlocalCfg, err := localconfig.ReadLocalConfig(configPath)","+\trequire.NoError(t, err)","+\trequire.NotNil(t, localCfg)","+\tserver, err := localCfg.GetServer(GetApiServerAddress())","+\trequire.NoError(t, err)","+\tassert.Equal(t, certPath, server.ClientCertificate)","+\tassert.Equal(t, keyPath, server.ClientCertificateKey)","+","+\t// The persisted certificate is picked up without passing the flags again.","+\toutput, err = RunCliWithConfigFile(configPath, \"account\", \"get-user-info\")","+\trequire.NoError(t, err, \"output: %s\", output)","+\tassert.Contains(t, NormalizeOutput(output), \"Logged In: true\")","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"util/localconfig/localconfig.go"