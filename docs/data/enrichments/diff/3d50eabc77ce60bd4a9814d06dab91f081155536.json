({ codecId: 'pg/text@1' }).many({ elementsNullable: true }).optional(),","+      },","+    }).sql({ table: 'samples' }),","+  },","+});","+","+const db = postgresStatic({ contract });","+const columns = {","+  status: {","+    codecId: 'pg/enum@1',","+    nullable: false,","+    codec: { codecId: 'pg/enum@1', typeParams: { typeName: 'sample_status' } },","+  },","+  tags: {","+    codecId: 'pg/text@1',","+    nullable: true,","+    codec: { codecId: 'pg/text@1', many: true },","+  },","+};","+","+describe('raw contract-column codec bindings', () => {","+  it('carries parameterized and array metadata from an aliased table', () => {","+    const table = db.sql.public.samples.as('s');","+","+    expect({ status: table.columns.status, tags: table.columns.tags }).toEqual(columns);","+  });","+","+  it('preserves the bindings through row specs and inherited result references', () => {","+    const table = db.sql.public.samples;","+    const inner = db.raw.sql`SELECT status, tags FROM samples`.returnsRow({","+      status: table.columns.status,","+      tags: table.columns.tags,","+    });","+    const outer = db.raw.sql`WITH sample AS (${inner}) SELECT status, tags FROM sample`.returnsRow({","+      status: inner.returns.status,","+      tags: inner.returns.tags,","+    });","+","+    expect({ inner: inner.buildAst().result, outer: outer.buildAst().result }).toEqual({","+      inner: { kind: 'rows', columns },","+      outer: { kind: 'rows', columns },","+    });","+  });","+});"],"additions":55,"deletions":0,"truncated":false},{"path":"test/integration/test/raw-column-codecs.integration.test.ts","lines":["@@ -0,0 +1,45 @@","+import { defineContract, field, model, nativeEnum, pg } from '@internal/postgres/contract-builder';","+import postgresStatic from '@internal/postgres/static';","+import { describe, expect, it } from 'vitest';","+import { timeouts, withPushedContractRuntime } from './sql-orm-client/integration-helpers';","+","+const Status = nativeEnum('Status', 'draft', 'published').map('sample_status');","+const contract = defineContract({","+  models: {","+    Sample: model('Sample', {","+      fields: {","+        id: field.column({ codecId: 'pg/int4@1' }).id(),","+        status: field.column(pg.enum(Status)),","+        tags: field.column({ codecId: 'pg/text@1' }).many({ elementsNullable: true }).optional(),","+      },","+    }).sql({ table: 'samples' }),","+  },","+});","+","+describe('raw column codec metadata through Postgres', () => {","+  it(","+    'decodes parameterized codecs and nullable arrays through inherited row specs',","+    async () => {","+      await withPushedContractRuntime(contract, async (runtime) => {","+        const db = postgresStatic({ contract });","+        const table = db.sql.public.samples;","+        const inner = db.raw.sql`","+          SELECT 'draft'::sample_status AS status,","+                 ARRAY['one,two', NULL, 'three']::text[] AS tags","+        `.returnsRow({ status: table.columns.status, tags: table.columns.tags });","+        const plan = db.raw.sql`WITH sample AS (${inner}) SELECT status, tags FROM sample`","+          .returnsRow({ status: inner.returns.status, tags: inner.returns.tags })","+          .build();","+        const nullArray = db.raw.sql`SELECT NULL::text[] AS tags`","+          .returnsRow({ tags: table.columns.tags })","+          .build();","+","+        expect(await runtime.query(plan)).toEqual([","+          { status: 'draft', tags: ['one,two', null, 'three'] },","+        ]);","+        expect(await runtime.query(nullArray)).toEqual([{ tags: null }]);","+      });","+    },","+    timeouts.spinUpPpgDev,","+  );","+});",""],"additions":45,"deletions":0,"truncated":false}],"additions":250,"deletions":19,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-18T16:49:43.826384+00:00"}