ow          = errors.New(\"proto: integer overflow\")","+\tErrRecursionDepth       = errors.New(\"proto: exceeded max recursion depth\")"," \tErrUnexpectedEndOfGroup = errors.New(\"proto: unexpected end of group\")"," )"," "],"additions":3,"deletions":0,"truncated":false},{"path":"pdata/internal/proto_recursion_bench_test.go","lines":["@@ -0,0 +1,109 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package internal","+","+import (","+\t\"strconv\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+// benchAnyTree builds a value that alternates ArrayValue and KeyValueList levels. Every","+// level has two leaves and two subtrees, so it exercises all four depth-tracked types.","+func benchAnyTree(depth int) AnyValue {","+\tif depth == 0 {","+\t\treturn AnyValue{Value: &AnyValue_StringValue{StringValue: \"leaf-value\"}}","+\t}","+\tif depth%2 == 0 {","+\t\tav := NewArrayValue()","+\t\tav.Values = []AnyValue{","+\t\t\t{Value: &AnyValue_IntValue{IntValue: int64(depth)}},","+\t\t\t{Value: &AnyValue_StringValue{StringValue: \"str\"}},","+\t\t\tbenchAnyTree(depth - 1),","+\t\t\tbenchAnyTree(depth - 1),","+\t\t}","+\t\treturn AnyValue{Value: &AnyValue_ArrayValue{ArrayValue: av}}","+\t}","+\tkvl := NewKeyValueList()","+\tkvl.Values = []KeyValue{","+\t\t{Key: \"int\", Value: AnyValue{Value: &AnyValue_IntValue{IntValue: int64(depth)}}},","+\t\t{Key: \"str\", Value: AnyValue{Value: &AnyValue_StringValue{StringValue: \"str\"}}},","+\t\t{Key: \"left\", Value: benchAnyTree(depth - 1)},","+\t\t{Key: \"right\", Value: benchAnyTree(depth - 1)},","+\t}","+\treturn AnyValue{Value: &AnyValue_KvlistValue{KvlistValue: kvl}}","+}","+","+func benchMarshalProto(b *testing.B, size func() int, marshal func([]byte) int) []byte {","+\tb.Helper()","+\tbuf := make([]byte, size())","+\trequire.Equal(b, len(buf), marshal(buf))","+\treturn buf","+}","+","+func BenchmarkUnmarshalProtoAnyValue(b *testing.B) {","+\tsrc := benchAnyTree(5)","+\tbuf := benchMarshalProto(b, src.SizeProto, src.MarshalProto)","+\tb.SetBytes(int64(len(buf)))","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\trequire.NoError(b, NewAnyValue().UnmarshalProto(buf))","+\t}","+}","+","+func BenchmarkUnmarshalProtoArrayValue(b *testing.B) {","+\tsrc := NewArrayValue()","+\tfor range 8 {","+\t\tsrc.Values = append(src.Values, benchAnyTree(4))","+\t}","+\tbuf := benchMarshalProto(b, src.SizeProto, src.MarshalProto)","+\tb.SetBytes(int64(len(buf)))","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\trequire.NoError(b, NewArrayValue().UnmarshalProto(buf))","+\t}","+}","+","+func BenchmarkUnmarshalProtoKeyValueList(b *testing.B) {","+\tsrc := NewKeyValueList()","+\tfor i := range 8 {","+\t\tsrc.Values = append(src.Values, KeyValue{Key: \"k\" + strconv.Itoa(i), Value: benchAnyTree(4)})","+\t}","+\tbuf := benchMarshalProto(b, src.SizeProto, src.MarshalProto)","+\tb.SetBytes(int64(len(buf)))","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\trequire.NoError(b, NewKeyValueList().UnmarshalProto(buf))","+\t}","+}","+","+func BenchmarkUnmarshalProtoKeyValue(b *testing.B) {","+\tsrc := &KeyValue{Key: \"k\", Value: benchAnyTree(5)}","+\tbuf := benchMarshalProto(b, src.SizeProto, src.MarshalProto)","+\tb.SetBytes(int64(len(buf)))","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\trequire.NoError(b, NewKeyValue().UnmarshalProto(buf))","+\t}","+}","+","+// The flat variants measure the per-element cost when there is no nesting at all.","+func BenchmarkUnmarshalProtoAnyValueFlat(b *testing.B) {","+\tsrc := &AnyValue{Value: &AnyValue_StringValue{StringValue: \"v\"}}","+\tbuf := benchMarshalProto(b, src.SizeProto, src.MarshalProto)","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\trequire.NoError(b, NewAnyValue().UnmarshalProto(buf))","+\t}","+}","+","+func BenchmarkUnmarshalProtoKeyValueFlat(b *testing.B) {","+\tsrc := &KeyValue{Key: \"k\", Value: AnyValue{Value: &AnyValue_StringValue{StringValue: \"v\"}}}","+\tbuf := benchMarshalProto(b, src.SizeProto, src.MarshalProto)","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\trequire.NoError(b, NewKeyValue().UnmarshalProto(buf))","+\t}","+}"],"additions":109,"deletions":0,"truncated":false},{"path":"pdata/internal/proto_recursion_test.go","lines":["@@ -0,0 +1,67 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package internal","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"go.opentelemetry.io/collector/pdata/internal/proto\"","+)","+","+func TestUnmarshalProtoAnyValueArrayValueRecursionLimit(t *testing.T) {","+\tdest := NewAnyValue()","+\terr := dest.UnmarshalProto(nestedArrayValueProto(proto.RecursionLimit/2 + 1))","+\trequire.ErrorIs(t, err, proto.ErrRecursionDepth)","+}","+","+func TestUnmarshalProtoAnyValueKeyValueListRecursionLimit(t *testing.T) {","+\tdest := NewAnyValue()","+\terr := dest.UnmarshalProto(nestedKeyValueListProto(proto.RecursionLimit/3 + 1))","+\trequire.ErrorIs(t, err, proto.ErrRecursionDepth)","+}","+","+func TestUnmarshalProtoArrayValueRecursionLimitDirect(t *testing.T) {","+\trequire.ErrorIs(t, NewArrayValue().unmarshalProto(nil, proto.RecursionLimit), proto.ErrRecursionDepth)","+}","+","+func TestUnmarshalProtoKeyValueRecursionLimitDirect(t *testing.T) {","+\trequire.ErrorIs(t, (&KeyValue{}).unmarshalProto(nil, proto.RecursionLimit), proto.ErrRecursionDepth)","+}","+","+func nestedArrayValueProto(depth int) []byte {","+\tvar payload []byte","+\tfor range depth {","+\t\tarrayValue := protoField(0x0a, payload)","+\t\tpayload = protoField(0x2a, arrayValue)","+\t}","+\treturn payload","+}","+","+func nestedKeyValueListProto(depth int) []byte {","+\tvar payload []byte","+\tfor range depth {","+\t\tkeyValue := protoField(0x12, payload)","+\t\tkeyValueList := protoField(0x0a, keyValue)","+\t\tpayload = protoField(0x32, keyValueList)","+\t}","+\treturn payload","+}","+","+func protoField(tag byte, payload []byte) []byte {","+\tfield := make([]byte, 0, 1+proto.Sov(uint64(len(payload)))+len(payload))","+\tfield = append(field, tag)","+\tfield = appendRecursionVarint(field, uint64(len(payload)))","+\tfield = append(field, payload...)","+\treturn field","+}","+","+func appendRecursionVarint(buf []byte, v uint64) []byte {","+\tfor v >= 1<<7 {","+\t\tbuf = append(buf, uint8(v&0x7f|0x80))","+\t\tv >>= 7","+\t}","+\treturn append(buf, uint8(v))","+}",""],"additions":67,"deletions":0,"truncated":false}],"additions":329,"deletions":33,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-11-03T16:48:28.895251+00:00"}