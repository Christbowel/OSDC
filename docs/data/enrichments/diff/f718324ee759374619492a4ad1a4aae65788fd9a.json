{"id":"f718324ee759374619492a4ad1a4aae65788fd9a","axis":"silent","repo":"bytecodealliance/wasmtime","sha":"f718324ee759374619492a4ad1a4aae65788fd9a","parsed":{"files":[{"path":".github/dependabot.yml","lines":["@@ -5,3 +5,23 @@ updates:","     schedule:","       interval: \"weekly\"","     open-pull-requests-limit: 1","+","+  # The base images of CI's docker containers are pinned by digest so that","+  # CI's docker layer caches, keyed on the Dockerfile contents, stay valid.","+  # This is intended to keep those up-to-date as they change over time and","+  # receive minor updates.","+  - package-ecosystem: \"docker\"","+    directories:","+      - \"/ci/docker/*\"","+    schedule:","+      interval: \"weekly\"","+    open-pull-requests-limit: 1","+    ignore:","+      - dependency-name: \"*\"","+        update-types:","+          - \"version-update:semver-major\"","+          - \"version-update:semver-minor\"","+    groups:","+      docker-base-images:","+        patterns:","+          - \"*\""],"additions":20,"deletions":0,"truncated":false},{"path":"ci/docker/aarch64-linux/Dockerfile","lines":["@@ -1,4 +1,4 @@","-FROM ubuntu:16.04","+FROM ubuntu:16.04@sha256:1f1a2d56de1d604801a9671f301190704c25d604a416f59e03c04f5c6ffee0d6"," "," RUN apt-get update -y && apt-get install -y gcc gcc-aarch64-linux-gnu ca-certificates curl make git ninja-build"," RUN git config --global --add safe.directory '*'"],"additions":1,"deletions":1,"truncated":false},{"path":"ci/docker/aarch64-musl/Dockerfile","lines":["@@ -1,4 +1,4 @@","-FROM ghcr.io/cross-rs/aarch64-unknown-linux-musl","+FROM ghcr.io/cross-rs/aarch64-unknown-linux-musl:0.2.5@sha256:702154f52b2d8091671aa2c84d5582d849f949977228c735ff8462f93cc0e1e4"," "," RUN apt-get update -y && apt-get install -y ninja-build"," RUN git config --global --add safe.directory '*'"],"additions":1,"deletions":1,"truncated":false},{"path":"ci/docker/armv7-linux/Dockerfile","lines":["@@ -1,4 +1,4 @@","-FROM ubuntu:16.04","+FROM ubuntu:16.04@sha256:1f