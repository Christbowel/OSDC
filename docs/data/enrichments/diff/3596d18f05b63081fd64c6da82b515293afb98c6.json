,"+    name: Invalidate next queue after main advances","+    if: github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main'","+    runs-on: ubuntu-latest","+    timeout-minutes: 5","+    concurrency:","+      group: castiron-budget-writes-${{ github.repository_id }}","+      cancel-in-progress: false","+      queue: max","+    permissions:","+      actions: write","+      contents: read","+      pull-requests: read","+      statuses: write","+    steps:","+      - name: Re-evaluate live next queue after main advances","+        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0","+        with:","+          script: |","+            // Main pushes only invalidate. The normal authenticated evaluator","+            // and serialized publisher are the only paths that restore success.","+            const repo = `${context.repo.owner}/${context.repo.repo}`;","+            const signal = context.payload.workflow_run;","+            const {data: run} = await github.rest.actions.getWorkflowRun({...context.repo, run_id: signal.id});","+            const {data: workflow} = await github.rest.actions.getWorkflow({","+              ...context.repo, workflow_id: 'castiron-custom-code.yml',","+            });","+            if (!Number.isSafeInteger(run.workflow_id) || run.workflow_id !== workflow.id ||","+                workflow.path !== '.github/workflows/castiron-custom-code.yml') return;","+            if (run.repository.full_name !== repo || run.head_repository?.full_name !== repo ||","+                run.event !== 'push' || run.head_branch !== 'main' || run.status !== 'completed' ||","+                run.id !== signal.id || run.run_attempt !== signal.run_attempt || run.head_sha !== signal.head_sha ||","+                !/^[0-9a-f]{40}$/.test(run.head_sha) ||","+                run.path.split('@', 1)[0] !== '.github/workflows/castiron-custom-code.yml') {","+              throw new Error('Unexpected or superseded main signal');","+            }","+            const {data: main} = await github.rest.git.getRef({...context.repo, ref: 'heads/main'});","+            // A newer main push has its own signal. An old retry must not churn","+            // candidates already qualified against that newer snapshot.","+            if (run.head_sha !== main.object.sha) return;","+            const targets = new Set();","+            let cursor = null;","+            do {","+              const result = await github.graphql(`query($owner:String!,$name:String!,$branch:String!,$cursor:String) {","+                repository(owner:$owner,name:$name) { mergeQueue(branch:$branch) {","+                  entries(first:100,after:$cursor) {","+                    nodes { headCommit { oid } }","+                    pageInfo { hasNextPage endCursor }","+                  }","+                } }","+              }`, {owner: context.repo.owner, name: context.repo.repo, branch: 'next', cursor});","+              const page = result.repository.mergeQueue?.entries;","+              if (!page) break;","+              for (const entry of page.nodes) {","+                if (entry.headCommit === null) continue; // Unprepared entries have no statuses to invalidate.","+                const sha = entry.headCommit?.oid;","+                if (!/^[0-9a-f]{40}$/.test(sha || '')) throw new Error('Invalid live queue SHA');","+                targets.add(sha);","+              }","+              if (!page.pageInfo.hasNextPage) break;","+              const next = page.pageInfo.endCursor;","+              if (!next || next === cursor) throw new Error('Invalid queue pagination');","+              cursor = next;","+            } while (true);","+            const url = `${context.serverUrl}/${repo}/actions/runs/${context.runId}`;","+            // Invalidate the entire live next queue before slower rerun discovery.","+            // This also covers bootstraps whose policy pin is now stale. Ordinary","+            //