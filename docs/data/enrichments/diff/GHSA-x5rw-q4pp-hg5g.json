+\t\t}","+\t\tawait delay(50);","+\t});","+});","+","+test('handles serialization errors in a later resolved promise', () => {","+\tin_subprocess(async ({ assert, delay, stringifyAsync }) => {","+\t\ttry {","+\t\t\tawait stringifyAsync({ slow: delay(50, 42), invalid: Promise.resolve(() => {}) });","+\t\t\tassert.unreachable('should have thrown');","+\t\t} catch (e) {","+\t\t\tassert.is(e.name, 'DevalueError');","+\t\t\tassert.is(e.message, 'Cannot stringify a function');","+\t\t}","+\t});","+});","+","+test('handles rejected thenables', () => {","+\tin_subprocess(async ({ assert, delay, stringifyAsync }) => {","+\t\tconst error = new Error('thenable failure');","+\t\ttry {","+\t\t\tawait stringifyAsync({","+\t\t\t\tslow: delay(50, 42),","+\t\t\t\tfailing: { then: (resolve, reject) => reject(error) }","+\t\t\t});","+\t\t\tassert.unreachable('should have thrown');","+\t\t} catch (e) {","+\t\t\tassert.is(e, error);","+\t\t}","+\t});","+});","+","+test.run();",""],"additions":115,"deletions":0,"truncated":false}],"additions":125,"deletions":0,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-02T14:42:40.159157+00:00"}