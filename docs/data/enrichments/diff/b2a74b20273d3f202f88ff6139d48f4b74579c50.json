{"id":"b2a74b20273d3f202f88ff6139d48f4b74579c50","axis":"silent","repo":"grafana/grafana","sha":"b2a74b20273d3f202f88ff6139d48f4b74579c50","parsed":{"files":[{"path":"conf/defaults.ini","lines":["@@ -191,7 +191,29 @@ notifier = false"," # Only applies when notifier = true. A value of 0 disables expiry."," notifier_watch_max_age = 0"," ","-# Transport security for client connections.","+# Open client_port on client_listen_address for clients outside Grafana, for example the nats CLI.","+# Grafana connects to its embedded server in-process, so by default client_port is not opened and socket","+# clients are rejected. The port has no TLS or authentication, so Grafana logs a warning when it is open;","+# keep client_listen_address on loopback or a trusted network. It is separate from listen_address so","+# binding the cluster port to 0.0.0.0 doesn't expose the client port. Other Grafana instances join over","+# cluster_port, not this port.","+client_listen = false","+client_listen_address = 127.0.0.1","+","+# Mutual TLS between embedded servers on cluster_port. Set all three to require every instance to present","+# a certificate signed by the CA when it connects to a peer, and to verify the peer's certificate in turn.","+# The certificate must allow both server and client auth, and its SANs must match the host this instance","+# advertises to its peers (advertise_address, or listen_address). Every instance must use the same mode:","+# instances with and without cluster TLS can't connect to each other. Changed files are picked up within","+# about 15 seconds without a restart; established routes keep their TLS session. Files that can't be loaded","+# keep the current certificates in use, are logged when the failure starts and every 10 minutes until fixed,","+# and count in grafana_nats_cluster_tls_reload_failures_total.","+cluster_tls_cert_path =","+cluster_tls_key_path =","+cluster_tls_ca_path =","+","+# Transport security for client connections to an external NATS server (mode = external). Ignored in","+# embedded mode, where Grafana connects in-process."," tls_enabled = false"," tls_ca_cert_path ="," tls_cert_path ="],"additions":23,"deletions":1,"truncated":false},{"path":"pkg/infra/nats/client_port.go","lines":["@@ -0,0 +1,23 @@","+package nats","+","+import (","+\tnatsserver \"github.com/nats-io/nats-server/v2/server\"","+)","+","+// restrictToInProcessClients keeps the client port off the network. Grafana","+// connects in-process, but DontListen also stops nats-server from routing, so","+// bind an ephemeral loopback port instead and reject every socket client on it.","+func restrictToInProcessClients(opts *natsserver.Options) {","+\topts.Host = \"127.0.0.1\"","+\topts.Port = natsserver.RANDOM_PORT","+\topts.CustomClientAuthentication = inProcessOnly{}","+}","+","+// inProcessOnly accepts only in-process clients, which reach the server over","+// net.Pipe instead of a socket.","+type inProcessOnly struct{}","+","+func (inProcessOnly) Check(c natsserver.ClientAuthentication) bool {","+\taddr := c.RemoteAddress()","+\treturn addr != nil && addr.Network() == \"pipe\"","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"pkg/infra/nats/cluster_tls.go","lines":["@@ -0,0 +1,176 @@","+package nats","+","+import (","+\t\"context\"","+\t\"crypto/sha256\"","+\t\"crypto/tls\"","+\t\"crypto/x509\"","+\t\"fmt\"","+\t\"os\"","+\t\"time\"","+","+\t\"github.com/grafana/grafana/pkg/infra/log\"","+\t\"github.com/grafana/grafana/pkg/setting\"","+)","+","+// clusterTLSReloadInterval is how often the certificate files are checked for","+// changes. NoSigs rules out reloading on SIGHUP.","+const clusterTLSReloadInterval = 15 * time.Second","+","+type clusterTLSFiles struct {","+\tcert, key, ca []byte","+}","+","+func readClusterTLSFiles(c setting.NATSClusterTLSSettings) (clusterTLSFiles, error) {","+\tvar f clusterTLSFiles","+\tvar err error","+\tif f.cert, err = os.ReadFile(c.CertPath); err != nil {","+\t\treturn f, fmt.Errorf(\"read nats cluster tls cert: %w\", err)","+\t}","+\tif f.key, err = os.ReadFile(c.KeyPath); err != nil {","+\t\treturn f, fmt.Errorf(\"read nats cluster tls key: %w\", err)","+\t}","+\tif f.ca, err = os.ReadFile(c.CAPath); err != nil {","+\t\treturn f, fmt.Errorf(\"read nats cluster tls ca: %w\", err)","+\t}","+\treturn f, nil","+}","+","+func (f clusterTLSFiles) fingerprint() [sha256.Size]byte {","+\th := sha256.New()","+\tfor _, b := range [][]byte{f.cert, f.key, f.ca} {","+\t\t// Length-prefix each file so moving bytes between files changes the hash.","+\t\t_, _ = fmt.Fprintf(h, \"%d:\", len(b))","+\t\t_, _ = h.Write(b)","+\t}","+\treturn [sha256.Size]byte(h.Sum(nil))","+}","+","+// tlsConfig builds the route TLS config. Every instance both accepts and dials","+// routes, so the CA verifies peers in both directions.","+func (f clusterTLSFiles) tlsConfig(c setting.NATSClusterTLSSettings) (*tls.Config, error) {","+\tcert, err := tls.X509KeyPair(f.cert, f.key)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"load nats cluster tls key pair: %w\", err)","+\t}","+\tpool := x509.NewCertPool()","+\tif !pool.AppendCertsFromPEM(f.ca) {","+\t\treturn nil, fmt.Errorf(\"no valid certificates found in nats cluster tls ca %q\", c.CAPath)","+\t}","+\treturn &tls.Config{","+\t\tMinVersion:   tls.VersionTLS12,","+\t\tCertificates: []tls.Certificate{cert},","+\t\tRootCAs:      pool,","+\t\tClientCAs:    pool,","+\t\tClientAuth:   tls.RequireAndVerifyClientCert,","+\t}, nil","+}","+","+func loadClusterTLS(c setting.NATSClusterTLSSettings) (*tls.Config, [sha256.Size]byte, error) {","+\tf, err := readClusterTLSFiles(c)","+\tif err != nil {","+\t\treturn nil, [sha256.Size]byte{}, err","+\t}","+\ttc, err := f.tlsConfig(c)","+\tif err != nil {","+\t\treturn nil, [sha256.Size]byte{}, err","+\t}","+\treturn tc, f.fingerprint(), nil","+}","+","+// clusterTLSFailureReminder is how often a persistent reload failure is logged","+// again, so it stays visible without logging every tick.","+const clusterTLSFailureReminder = 10 * time.Minute","+","+// Reasons a reload can fail, used as the failures metric label.","+const (","+\tclusterTLSReasonRead    = \"read\"","+\tclusterTLSReasonInvalid = \"invalid\"","+\tclusterTLSReasonApply   = \"apply\"","+)","+","+// clusterTLSWatcher reloads the route TLS config when the certificate files","+// change. It keeps serving the last valid config while the files can't be applied.","+type clusterTLSWatcher struct {","+\tlog      log.Logger","+\tmetrics  *clusterTLSMetrics","+\tcfg      setting.NATSClusterTLSSettings","+\tinterval time.Duration","+\tapply    func(*tls.Config) error","+","+\t// last is the fingerprint of the applied files. It changes only on a","+\t// successful apply, so every failure is retried on the next tick.","+\tlast [sha256.Size]byte","+","+\t// failing is the reason of the current failure, empty while the applied","+\t// config matches the files.","+\tfailing  string","+\tsince    time.Time","+\tremindAt time.Time","+}","+","+func (w *clusterTLSWatcher) run(ctx context.Context) {","+\tticker := time.NewTicker(w.interval)","+\tdefer ticker.Stop()","+\tfor {","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\treturn","+\t\tcase <-ticker.C:","+\t\t\tw.check()","+\t\t}","+\t}","+}","+","+func (w *clusterTLSWatcher) check() {","+\tf, err := readClusterTLSFiles(w.cfg)","+\tif err != nil {","+\t\tw.fail(clusterTLSReasonRead, err)","+\t\treturn","+\t}","+\tsum := f.fingerprint()","+\tif sum == w.last {","+\t\tw.recover()","+\t\treturn","+\t}","+","+\ttc, err := f.tlsConfig(w.cfg)","+\tif err != nil {","+\t\tw.fail(clusterTLSReasonInvalid, err)","+\t\treturn","+\t}","+\tif err := w.apply(tc); err != nil {","+\t\tw.fail(clusterTLSReasonApply, err)","+\t\treturn","+\t}","+\tw.last = sum","+\tw.metrics.recordReloadSuccess(time.Now())","+\tw.log.Info(\"reloaded nats cluster tls certificates\")","+\tw.recover()","+}","+","+// fail logs a new or changed failure at once and a persistent one every","+// clusterTLSFailureReminder.","+func (w *clusterTLSWatcher) fail(reason string, err error) {","+\tw.metrics.recordReloadFailure(reason)","+\tnow := time.Now()","+\tswitch {","+\tcase w.failing != reason:","+\t\tw.since = now","+\t\tw.log.Error(\"nats cluster tls reload failing; keeping the current certificates\", \"reason\", reason, \"err\", err)","+\tcase !now.Before(w.remindAt):","+\t\tw.log.Error(\"nats cluster tls reload still failing; keeping the current certificates\", \"reason\", reason, \"since\", w.since, \"err\", err)","+\tdefault:","+\t\treturn","+\t}","+\tw.failing = reason","+\tw.remindAt = now.Add(clusterTLSFailureReminder)","+}","+","+func (w *clusterTLSWatcher) recover() {","+\tif w.failing == \"\" {","+\t\treturn","+\t}","+\tw.log.Info(\"nats cluster tls reload recovered\", \"reason\", w.failing, \"since\", w.since)","+\tw.failing = \"\"","+}"],"additions":176,"deletions":0,"truncated":false},{"path":"pkg/infra/nats/config.go","lines":["@@ -92,6 +92,11 @@ func (c *Config) URLs() []string {"," \treturn append([]string(nil), c.cfg.ClientURLs...)"," }"," ","+// inProcess reports whether connections go to the embedded server in-process.","+func (c *Config) inProcess() bool {","+\treturn c.server != nil && !c.server.IsDisabled()","+}","+"," // DialOptions returns extra dial options. In embedded mode this carries the"," // in-process server hop so the local connection bypasses TCP/TLS. Safe for"," // concurrent use."],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/infra/nats/connection.go","lines":["@@ -311,7 +311,9 @@ func (c *connection) connectOptions() ([]natsclient.Option, error) {"," \t\t}),"," \t}"," ","-\tif tls := c.config.TLS(); tls.Enabled {","+\t// The in-process connection has no transport to secure; requesting TLS on it","+\t// fails every connect with ErrSecureConnWanted.","+\tif tls := c.config.TLS(); tls.Enabled && !c.config.inProcess() {"," \t\ttc, err := buildTLSConfig(tls)"," \t\tif err != nil {"," \t\t\treturn nil, err"],"additions":3,"deletions":1,"truncated":false},{"path":"pkg/infra/nats/discovery.go","lines":["@@ -55,7 +55,7 @@ type peerRegistry interface {"," type discovery struct {"," \tlog      log.Logger"," \tserver   *natsserver.Server","-\tbaseOpts natsserver.Options","+\treload   func(routes []*url.URL) error"," \tregistry peerRegistry"," \tself     peer"," \tinterval time.Duration","@@ -65,11 +65,11 @@ type discovery struct {"," \troutes map[string]struct{}"," }"," ","-// discoveryOptions bundles the embedded server's base options with the","-// discovery loop cadence. baseOpts is the template applyRoutes reloads routes","-// from; interval/ttl fall back to package defaults when non-positive.","+// discoveryOptions bundles how routes reach the embedded server with the","+// discovery loop cadence. reload replaces the server's solicited routes;","+// interval/ttl fall back to package defaults when non-positive."," type discoveryOptions struct {","-\tbaseOpts natsserver.Options","+\treload   func(routes []*url.URL) error"," \tinterval time.Duration"," \tttl      time.Duration"," }","@@ -86,7 +86,7 @@ func newDiscovery(logger log.Logger, server *natsserver.Server, registry peerReg"," \treturn &discovery{"," \t\tlog:      logger,"," \t\tserver:   server,","-\t\tbaseOpts: opts.baseOpts,","+\t\treload:   opts.reload,"," \t\tregistry: registry,"," \t\tself:     self,"," \t\tinterval: interval,","@@ -172,11 +172,7 @@ func (d *discovery) applyRoutes(routes map[string]struct{}) error {"," \t\turls = append(urls, u)"," \t}"," ","-\t// Reload from a copy: ReloadOptions mutates what it's given, so we keep baseOpts","-\t// stable and rebuild Routes from scratch each time.","-\topts := d.baseOpts","-\topts.Routes = urls","-\treturn d.server.ReloadOptions(&opts)","+\treturn d.reload(urls)"," }"," "," // deregister removes this node's row so peers stop dialing it immediately instead"],"additions":7,"deletions":11,"truncated":false},{"path":"pkg/infra/nats/discovery_test.go","lines":["@@ -2,6 +2,7 @@ package nats"," "," import ("," \t\"context\"","+\t\"net/url\""," \t\"sync\""," \t\"testing\""," \t\"time\"","@@ -91,7 +92,12 @@ func newTestDiscovery(t *testing.T, reg peerRegistry, self peer) *discovery {"," \tgo srv.Start()"," \trequire.True(t, srv.ReadyForConnections(5*time.Second), \"test nats server not ready\")"," \tt.Cleanup(srv.Shutdown)","-\treturn newDiscovery(log.NewNopLogger(), srv, reg, self, discoveryOptions{baseOpts: opts})","+\treload := func(routes []*url.URL) error {","+\t\tnext := opts","+\t\tnext.Routes = routes","+\t\treturn srv.ReloadOptions(&next)","+\t}","+\treturn newDiscovery(log.NewNopLogger(), srv, reg, self, discoveryOptions{reload: reload})"," }"," "," func TestDiscoveryReconcile(t *testing.T) {"],"additions":7,"deletions":1,"truncated":false},{"path":"pkg/infra/nats/helpers_test.go","lines":["@@ -2,6 +2,18 @@ package nats"," "," import ("," \t\"context\"","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"crypto/tls\"","+\t\"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"encoding/pem\"","+\t\"math/big\"","+\t\"net\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\""," \t\"sync\""," \t\"sync/atomic\""," \t\"testing\"","@@ -10,6 +22,7 @@ import ("," \tauthnlib \"github.com/grafana/authlib/authn\""," \t\"github.com/grafana/dskit/services\""," \tnatsserver \"github.com/nats-io/nats-server/v2/server\"","+\tnatsclient \"github.com/nats-io/nats.go\""," \t\"github.com/prometheus/client_golang/prometheus\""," \tdto \"github.com/prometheus/client_model/go\""," \t\"github.com/stretchr/testify/require\"","@@ -166,3 +179,184 @@ func (e *blockingTokenExchanger) Exchange(ctx context.Context, _ authnlib.TokenE"," \t\treturn nil, ctx.Err()"," \t}"," }","+","+type testCA struct {","+\tcert *x509.Certificate","+\tkey  *ecdsa.PrivateKey","+}","+","+func newTestCA(t *testing.T, name string) *testCA {","+\tt.Helper()","+\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err)","+\ttmpl := &x509.Certificate{","+\t\tSerialNumber:          randomSerial(t),","+\t\tSubject:               pkix.Name{CommonName: name},","+\t\tNotBefore:             time.Now().Add(-time.Hour),","+\t\tNotAfter:              time.Now().Add(time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t\tKeyUsage:              x509.KeyUsageCertSign,","+\t}","+\tder, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)","+\trequire.NoError(t, err)","+\tcert, err := x509.ParseCertificate(der)","+\trequire.NoError(t, err)","+\treturn &testCA{cert: cert, key: key}","+}","+","+func (ca *testCA) pem() []byte {","+\treturn pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: ca.cert.Raw})","+}","+","+func (ca *testCA) pool() *x509.CertPool {","+\tpool := x509.NewCertPool()","+\tpool.AddCert(ca.cert)","+\treturn pool","+}","+","+// issue signs a leaf for 127.0.0.1 usable as both route server and client.","+func (ca *testCA) issue(t *testing.T, name string) tls.Certificate {","+\tt.Helper()","+\treturn ca.issueWith(t, name, func(*x509.Certificate) {})","+}","+","+// issueWith is issue with the template adjusted by edit, e.g. other SANs or validity.","+func (ca *testCA) issueWith(t *testing.T, name string, edit func(*x509.Certificate)) tls.Certificate {","+\tt.Helper()","+\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err)","+\ttmpl := &x509.Certificate{","+\t\tSerialNumber: randomSerial(t),","+\t\tSubject:      pkix.Name{CommonName: name},","+\t\tNotBefore:    time.Now().Add(-time.Hour),","+\t\tNotAfter:     time.Now().Add(time.Hour),","+\t\tKeyUsage:     x509.KeyUsageDigitalSignature,","+\t\tExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth, x509.ExtKeyUsageClientAuth},","+\t\tIPAddresses:  []net.IP{net.ParseIP(\"127.0.0.1\")},","+\t}","+\tedit(tmpl)","+\tder, err := x509.CreateCertificate(rand.Reader, tmpl, ca.cert, &key.PublicKey, ca.key)","+\trequire.NoError(t, err)","+\tleaf, err := x509.ParseCertificate(der)","+\trequire.NoError(t, err)","+\treturn tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key, Leaf: leaf}","+}","+","+func randomSerial(t *testing.T) *big.Int {","+\tt.Helper()","+\tn, err := rand.Int(rand.Reader, new(big.Int).Lsh(big.NewInt(1), 62))","+\trequire.NoError(t, err)","+\treturn n","+}","+","+// writeTestClusterTLS writes a leaf signed by issuer plus a CA bundle of trusted.","+func writeTestClusterTLS(t *testing.T, issuer *testCA, trusted ...*testCA) setting.NATSClusterTLSSettings {","+\tt.Helper()","+\tdir := t.TempDir()","+\tcfg := setting.NATSClusterTLSSettings{","+\t\tCertPath: filepath.Join(dir, \"tls.crt\"),","+\t\tKeyPath:  filepath.Join(dir, \"tls.key\"),","+\t\tCAPath:   filepath.Join(dir, \"ca.crt\"),","+\t}","+\twriteTestKeyPair(t, cfg, issuer.issue(t, \"grafana-nats\"))","+\tvar bundle []byte","+\tfor _, ca := range trusted {","+\t\tbundle = append(bundle, ca.pem()...)","+\t}","+\twriteFileAtomic(t, cfg.CAPath, bundle)","+\treturn cfg","+}","+","+func writeTestKeyPair(t *testing.T, cfg setting.NATSClusterTLSSettings, cert tls.Certificate) {","+\tt.Helper()","+\twriteFileAtomic(t, cfg.CertPath, certPEM(cert))","+\twriteFileAtomic(t, cfg.KeyPath, keyPEM(t, cert))","+}","+","+func certPEM(cert tls.Certificate) []byte {","+\treturn pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: cert.Certificate[0]})","+}","+","+func keyPEM(t *testing.T, cert tls.Certificate) []byte {","+\tt.Helper()","+\tder, err := x509.MarshalPKCS8PrivateKey(cert.PrivateKey)","+\trequire.NoError(t, err)","+\treturn pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: der})","+}","+","+func writeFileAtomic(t *testing.T, path string, data []byte) {","+\tt.Helper()","+\trequire.NoError(t, replaceFile(path, data))","+}","+","+// replaceFile swaps path in one step so the watcher never reads a partial file.","+func replaceFile(path string, data []byte) error {","+\ttmp := path + \".tmp\"","+\tif err := os.WriteFile(tmp, data, 0o600); err != nil { //nolint:gosec // paths are under t.TempDir()","+\t\treturn err","+\t}","+\treturn os.Rename(tmp, path)","+}","+","+// hangGuard bounds event waits so a regression fails instead of hanging.","+const hangGuard = 15 * time.Second","+","+// logHook is a logger that hands info, warning and error messages to the test,","+// prefixed with their level.","+type logHook struct {","+\tlog.Logger","+\tmsgs chan string","+}","+","+func newLogHook() *logHook {","+\treturn &logHook{Logger: log.NewNopLogger(), msgs: make(chan string, 1024)}","+}","+","+func (h *logHook) Info(msg string, _ ...any)  { h.send(\"info: \" + msg) }","+func (h *logHook) Warn(msg string, _ ...any)  { h.send(\"warn: \" + msg) }","+func (h *logHook) Error(msg string, _ ...any) { h.send(\"error: \" + msg) }","+","+func (h *logHook) send(msg string) {","+\tselect {","+\tcase h.msgs <- msg:","+\tdefault:","+\t}","+}","+","+// waitForLog blocks until a message containing substr is logged.","+func (h *logHook) waitForLog(t *testing.T, substr string) {","+\tt.Helper()","+\tguard := time.After(hangGuard)","+\tfor {","+\t\tselect {","+\t\tcase msg := <-h.msgs:","+\t\t\tif strings.Contains(msg, substr) {","+\t\t\t\treturn","+\t\t\t}","+\t\tcase <-guard:","+\t\t\tt.Fatalf(\"no log containing %q\", substr)","+\t\t}","+\t}","+}","+","+// drain returns the messages logged so far.","+func (h *logHook) drain() []string {","+\tvar msgs []string","+\tfor {","+\t\tselect {","+\t\tcase msg := <-h.msgs:","+\t\t\tmsgs = append(msgs, msg)","+\t\tdefault:","+\t\t\treturn msgs","+\t\t}","+\t}","+}","+","+func connectInProcess(t *testing.T, s *Server) *natsclient.Conn {","+\tt.Helper()","+\tnc, err := natsclient.Connect(s.clientURL(), s.dialOptions()...)","+\trequire.NoError(t, err)","+\tt.Cleanup(nc.Close)","+\treturn nc","+}"],"additions":194,"deletions":0,"truncated":false},{"path":"pkg/infra/nats/metrics.go","lines":["@@ -1,6 +1,8 @@"," package nats"," "," import (","+\t\"time\"","+"," \tnatsclient \"github.com/nats