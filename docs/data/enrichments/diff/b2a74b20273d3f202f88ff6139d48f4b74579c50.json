known certificate authority\")","+\t})","+","+\tt.Run(\"a peer without cluster tls cannot join\", func(t *testing.T) {","+\t\tca := newTestCA(t, \"grafana-nats-ca\")","+\t\tstore := newSharedTestKV(t)","+\t\thook := newLogHook()","+\t\tsecured := startTestTLSServerWithLog(t, store, writeTestClusterTLS(t, ca, ca), hook)","+\t\tplain := startTestTLSServer(t, store, setting.NATSClusterTLSSettings{})","+","+\t\thook.waitForLog(t, \"TLS route handshake error\")","+\t\trequire.Zero(t, numRoutes(secured))","+\t\trequire.Zero(t, numRoutes(plain))","+\t})","+","+\tt.Run(\"a route to a peer whose certificate doesn't match its address is rejected\", func(t *testing.T) {","+\t\tca := newTestCA(t, \"grafana-nats-ca\")","+\t\thookA := newLogHook()","+\t\t// No discovery: only A dials, so the failure is A verifying B's server certificate.","+\t\ta := startTestTLSServerWithLog(t, nil, writeTestClusterTLS(t, ca, ca), hookA)","+\t\ttlsB := writeTestClusterTLS(t, ca, ca)","+\t\twriteTestKeyPair(t, tlsB, ca.issueWith(t, \"elsewhere\", func(c *x509.Certificate) {","+\t\t\tc.IPAddresses = []net.IP{net.ParseIP(\"10.9.9.9\")}","+\t\t}))","+\t\tb := startTestTLSServer(t, nil, tlsB)","+","+\t\trequire.NoError(t, a.setRoutes(natsserver.RoutesFromStr(routeURLForServer(b.cfg, b.server))))","+\t\thookA.waitForLog(t, \"certificate is valid for 10.9.9.9, not 127.0.0.1\")"],"additions":71,"deletions":0,"truncated":false}],"additions":694,"deletions":18,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-04T16:05:47.214753+00:00"}