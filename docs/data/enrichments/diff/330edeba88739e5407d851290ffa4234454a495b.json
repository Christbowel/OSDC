    \"^(fs|hive\\\\.security|hadoop\\\\.security)\\\\.|^tmp(jars|files|archives)$\" +","+          \"|(^|\\\\.)([^.]*opts|env|classloader|classpath|jars?|files|archives|hooks?|class(es)?|[^.]*class\" +","+          \"|impl|factory|keytab|principal|credential[^.]*|[^.]*password[^.]*|[^.]*secret[^.]*|[^.]*token[^.]*\" +","+          \"|log4j[^.]*|provider|encrypt|mask|plugin\" +","+          \"|whitelist|logger|listeners?|scratchdir|stagingdir|tmp\\\\.dir|temp\\\\.dir|input\\\\.dir|plan|trust\" +","+          \"|params|codecs?|submitviachild|via\\\\.child|user\\\\.access|wrapper|script|ssl|tls\" +","+          \"|kryo|publisher|aggregator|table\\\\.props|is\\\\.compressed)(\\\\.|$)\",","+          \"A Java regex, matched case insensitively against the parameters that \" +","+          \"hive.compactor.conf.allowlist admits. Some config parameters may hold security risk, therefore \" +","+          \"restricting the list of parameters is necessary. \" +","+          \"Denied properties are skipped with a warning and do not fail the compaction.\" +","+          \"If this is set to an empty value, only hive.conf.restricted.list, hive.conf.hidden.list and \" +","+          \"hive.conf.locked.list are checked on top of the allow list.\"),","+","     // If a parameter is added to the restricted list, add a test in TestRestrictedList.Java","     HIVE_CONF_RESTRICTED_LIST(\"hive.conf.restricted.list\",","         \"hive.security.authenticator.manager,hive.security.authorization.manager,\" +","@@ -7073,26 +7107,8 @@ public void setModifiableWhiteListRegex(String paramNameRegex) {","    * including HIVE_CONF_RESTRICTED_LIST itself","    */","   private void setupRestrictList() {","-    String restrictListStr = this.getVar(ConfVars.HIVE_CONF_RESTRICTED_LIST);","     restrictList.clear();","-    if (restrictListStr != null) {","-      for (String entry : restrictListStr.split(\",\")) {","-        restrictList.add(entry.trim());","-      }","-    }","-","-    String internalVariab