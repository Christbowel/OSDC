,"+        restrictedSet.add(entry.trim());","+      }","+    }","+","+    restrictedSet.add(ConfVars.HIVE_IN_TEST.varname);","+    restrictedSet.add(ConfVars.HIVE_CONF_RESTRICTED_LIST.varname);","+    restrictedSet.add(ConfVars.HIVE_CONF_HIDDEN_LIST.varname);","+    restrictedSet.add(ConfVars.HIVE_CONF_INTERNAL_VARIABLE_LIST.varname);","+    restrictedSet.add(ConfVars.HIVE_CONF_LOCKED_LIST.varname);","+    restrictedSet.add(ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST.varname);","+    restrictedSet.add(ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST_APPEND.varname);","+    restrictedSet.add(ConfVars.HIVE_COMPACTOR_CONF_DENYLIST.varname);","+    return restrictedSet;","+  }","+","   /**","    * Getting the set of locked configurations","    * @param configuration The original configuration"],"additions":34,"deletions":0,"truncated":false},{"path":"itests/hive-unit/src/test/java/org/apache/hadoop/hive/ql/txn/compactor/TestCompactorBase.java","lines":["@@ -96,6 +96,7 @@ public void setup() throws Exception {","     MetastoreConf.setBoolVar(hiveConf, MetastoreConf.ConfVars.COMPACTOR_CLEANER_ON, true);","     MetastoreConf.setBoolVar(hiveConf, MetastoreConf.ConfVars.COMPACTOR_CLEAN_ABORTS_USING_CLEANER, true);","     HiveConf.setTimeVar(hiveConf, HIVE_COMPACTOR_CLEANER_RETENTION_TIME, 0, TimeUnit.SECONDS);","+    HiveConf.setVar(hiveConf, HiveConf.ConfVars.HIVE_COMPACTOR_CONF_DENYLIST, \"(?!)\");"," ","     TestTxnDbUtil.setConfValues(hiveConf);","     TestTxnDbUtil.cleanDb(hiveConf);"],"additions":1,"deletions":0,"truncated":false},{"path":"ql/src/java/org/apache/hadoop/hive/ql/txn/compactor/CompactorPropertyValidator.java","lines":["@@ -0,0 +1,153 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.hadoop.hive.ql.txn.compactor;","+","+import org.apache.commons.lang3.StringUtils;","+import org.apache.hadoop.conf.Configuration;","+import org.apache.hadoop.hive.conf.HiveConf;","+import org.apache.hadoop.hive.conf.HiveConfUtil;","+import org.slf4j.Logger;","+import org.slf4j.LoggerFactory;","+","+import java.util.Map;","+import java.util.Set;","+import java.util.concurrent.ConcurrentHashMap;","+import java.util.regex.Pattern;","+import java.util.regex.PatternSyntaxException;","+","+/**","+ * The allow list bounding which configuration parameters a table property may override on a compaction","+ * job, read from {@link HiveConf.ConfVars#HIVE_COMPACTOR_CONF_ALLOWLIST}. This config limits the scope","+ * of the overridable config parameters, because most of the parameters have no effect on a compaction job.","+ * With this limitation, the regex defined by the deny list can be kept simple and short.","+ * <p>","+ * The config parameters are first evaluated against the allow list config. If they match, then they will be","+ * evaluated against the deny list, read from {@link HiveConf.ConfVars#HIVE_COMPACTOR_CONF_DENYLIST}.","+ * The purpose of the deny list is to filter for parameters which could lead to security gaps.","+ * <p>","+ * The admins can extend the allow list through {@link HiveConf.ConfVars#HIVE_COMPACTOR_CONF_ALLOWLIST_APPEND}.","+ * The config parameters listed here are also evaluated against the deny list to prevent accidentally allowing","+ * configs which hold security risk.","+ * <p>","+ * As last step, all config parameters are checked against the already existing lists such as","+ * {@link HiveConf.ConfVars#HIVE_CONF_RESTRICTED_LIST}, {@link HiveConf.ConfVars#HIVE_CONF_HIDDEN_LIST}","+ * and {@link HiveConf.ConfVars#HIVE_CONF_LOCKED_LIST}","+ * This applies for the parameters defined through {@link HiveConf.ConfVars#HIVE_COMPACTOR_CONF_ALLOWLIST_APPEND}","+ * as well.","+ */","+final class CompactorPropertyValidator {","+","+  private static final Logger LOG = LoggerFactory.getLogger(CompactorPropertyValidator.class);","+  private static final Map<String, Pattern> ALLOW_PATTERN_CACHE = new ConcurrentHashMap<>();","+  private static final Map<String, Pattern> DENY_PATTERN_CACHE = new ConcurrentHashMap<>();","+","+  private static final Pattern MATCHES_NOTHING = Pattern.compile(\"(?!)\");","+  private static final Pattern DENY_EVERYTHING = Pattern.compile(\".*\");","+","+  private CompactorPropertyValidator() {","+  }","+","+  /**","+   * Decides whether a parameter is within the set a table property may override.","+   *","+   * @param conf configuration the allow list settings are read from","+   * @param parameterName the config parameter name with its \"compactor.\" or \"tblprops.\" prefix already removed","+   */","+  static boolean isParameterAllowed(Configuration conf, String parameterName) {","+    String key = parameterName.trim();","+    if (StringUtils.isBlank(key)) {","+      return false;","+    }","+","+    Pattern allowPattern =","+        getAllowPattern(HiveConf.getVar(conf, HiveConf.ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST), MATCHES_NOTHING,","+            HiveConf.ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST.varname);","+","+    if ((allowPattern != null && allowPattern.matcher(key).find()) || isOnAllowListAppend(conf, key)) {","+      Pattern denyPattern =","+          getDenyPattern(HiveConf.getVar(conf, HiveConf.ConfVars.HIVE_COMPACTOR_CONF_DENYLIST), DENY_EVERYTHING,","+              HiveConf.ConfVars.HIVE_COMPACTOR_CONF_DENYLIST.varname);","+      if (denyPattern != null && denyPattern.matcher(key).find()) {","+        LOG.warn(\"Ignoring compaction property '{}', as it is not permitted to override by table properties per {}.\",","+            key, HiveConf.ConfVars.HIVE_COMPACTOR_CONF_DENYLIST.varname);","+        return false;","+      }","+","+      if (matchesAnyPrefix(HiveConfUtil.getHiddenSet(conf), key) || matchesAnyPrefix(HiveConfUtil.getLockedSet(conf),","+          key) || matchesAnyPrefix(HiveConfUtil.getRestrictedSet(conf), key)) {","+        LOG.warn(\"Ignoring compaction property '{}' as it is immutable at runtime per {}, {} or {}.\", key,","+            HiveConf.ConfVars.HIVE_CONF_RESTRICTED_LIST.varname, HiveConf.ConfVars.HIVE_CONF_HIDDEN_LIST.varname,","+            HiveConf.ConfVars.HIVE_CONF_LOCKED_LIST.varname);","+        return false;","+      }","+      return true;","+    } else {","+      LOG.warn(\"Ignoring compaction property '{}', as it is not allowed by {} or {}.\", key,","+          HiveConf.ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST.varname,","+          HiveConf.ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST_APPEND.varname);","+      return false;","+    }","+  }","+","+  private static boolean isOnAllowListAppend(Configuration conf, String key) {","+    String configured = HiveConf.getVar(conf, HiveConf.ConfVars.HIVE_COMPACTOR_CONF_ALLOWLIST_APPEND);","+    if (StringUtils.isBlank(configured)) {","+      return false;","+    }","+    for (String exception : configured.split(\",\")) {","+      if (key.equalsIgnoreCase(exception.trim())) {","+        return true;","+      }","+    }","+    return false;","+  }","+","+  private static Pattern getAllowPattern(String regexConfig, Pattern fallbackRegex, String configName) {","+    return getPattern(regexConfig, fallbackRegex, configName, ALLOW_PATTERN_CACHE);","+  }","+","+  private static Pattern getDenyPattern(String regexConfig, Pattern fallbackRegex, String configName) {","+    return getPattern(regexConfig, fallbackRegex, configName, DENY_PATTERN_CACHE);","+  }","+","+  private static Pattern getPattern(String regexConfig, Pattern fallbackRegex, String configName,","+      Map<String, Pattern> patternCache) {","+","+    String regex = StringUtils.trimToEmpty(regexConfig);","+","+    if (regex.isEmpty()) {","+      return null;","+    }","+    return patternCache.computeIfAbsent(regex, r -> {","+      try {","+        return Pattern.compile(r, Pattern.CASE_INSENSITIVE);","+      } catch (PatternSyntaxException e) {","+        LOG.error(\"Invalid regex '{}' is set in '{}'. No property will be applied until it is fixed.\", r, configName,","+            e);","+        return fallbackRegex;","+      }","+    });","+  }","+","+  private static boolean matchesAnyPrefix(Set<String> prefixes, String key) {","+    return prefixes.stream().anyMatch(prefix -> !prefix.isEmpty() && key.startsWith(prefix));","+  }","+}","+","+"],"additions":153,"deletions":0,"truncated":false},{"path":"ql/src/java/org/apache/hadoop/hive/ql/txn/compactor/CompactorUtil.java","lines":["@@ -598,7 +598,9 @@ public static void overrideConfProps(","             .filter(entry -> entry.getKey().startsWith(COMPACTOR_PREFIX))","             .forEach(entry -> {","               String property = entry.getKey().substring(COMPACTOR_PREFIX.length());","-              conf.set(property, entry.getValue());","+              if (CompactorPropertyValidator.isParameterAllowed(conf, property)) {","+                conf.set(property, entry.getValue());","+              }","             });","   }"," }"],"additions":3,"deletions":1,"truncated":false},{"path":"ql/src/java/org/apache/hadoop/hive/ql/txn/compactor/MRCompactor.java","lines":["@@ -209,8 +209,10 @@ private void overrideTblProps(JobConf job, Map<String, String> tblproperties, St","     // mingle existing tblproperties with those specified on the ALTER TABLE command","     for (String key : stringableMap.keySet()) {","       if (key.startsWith(TBLPROPS_PREFIX)) {","-        String propKey = key.substring(9);  // 9 is the length of \"tblprops.\". We only keep the rest","-        tblproperties.put(propKey, stringableMap.get(key));","+        String propKey = key.substring(TBLPROPS_PREFIX.length());","+        if (CompactorPropertyValidator.isParameterAllowed(job, propKey)) {","+          tblproperties.put(propKey, stringableMap.get(key));","+        }","       }","     }","     // re-set TABLE_PROPS with reloaded tblproperties","@@ -226,8 +228,10 @@ private void overrideTblProps(JobConf job, Map<String, String> tblproperties, St","   private void overrideMRProps(JobConf job, Map<String, String> properties) {","     for (String key : properties.keySet()) {","       if (key.startsWith(COMPACTOR_PREFIX)) {","-        String mrKey = key.substring(10); // 10 is the length of \"compactor.\" We only keep the rest.","-        job.set(mrKey, properties.get(key));","+        String mrKey = key.substring(COMPACTOR_PREFIX.length());","+        if (CompactorPropertyValidator.isParameterAllowed(job, mrKey)) {","+          job.set(mrKey, properties.get(key));","+        }","       }","     }","   }"],"additions":8,"deletions":4,"truncated":false},{"path":"ql/src/test/org/apache/hadoop/hive/ql/txn/compactor/TestCompactorPropertyValidator.java","lines":["@@ -0,0 +1,339 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.hadoop.hive.ql.txn.compactor;","+","+import org.apache.hadoop.hive.conf.HiveConf;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.params.ParameterizedTest;","+import org.junit.jupiter.params.provider.ValueSource;","+","+import static org.junit.jupiter.api.Assertions.assertFalse;","+import static org.junit.jupiter.api.Assertions.assertTrue;","+","+public class TestCompactorPropertyValidator {","+","+  @ParameterizedTest","+  @ValueSource(strings = {","+      \"mapreduce.map.memory.mb\",","+      \"mapreduce.reduce.memory.mb\",","+      \"mapreduce.map.cpu.vcores\",","+      \"mapreduce.reduce.cpu.vcores\",","+      \"hive.tez.container.size\",","+      \"tez.task.resource.memory.mb\",","+      \"mapreduce.job.heap.memory-mb.ratio\",","+      \"mapreduce.task.io.sort.factor\",","+      \"mapreduce.task.io.sort.mb\",","+      \"yarn.app.mapreduce.am.resource.cpu-vcores\",","+      \"yarn.app.mapreduce.am.resource.mb\",","+      \"tez.am.resource.memory.mb\",","+      \"tez.am.resource.cpu.vcores\",","+      \"tez.grouping.min-size\",","+      \"tez.grouping.max-size\",","+      \"tez.grouping.split-waves\"})","+  void testResourceConfigs(String key) {","+    assertTrue(allowed(new HiveConf(), key), key + \" has to be settable in compaction job config.\");","+  }","+","+  @ParameterizedTest","+  @ValueSource(strings = {","+      \"hive.compactor.gather.stats\",","+      \"hive.mr.compactor.gather.stats\",","+      \"hive.compactor.compact.insert.only\",","+      \"hive.compactor.crud.query.based\",","+      \"hive.compactor.max.num.delta\",","+      \"hive.compactor.aborted.txn.time.threshold\",","+      \"hive.compactor.abortedtxn.threshold\",","+      \"hive.compactor.active.delta.dir.th