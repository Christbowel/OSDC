{"id":"884a2d1c1675f2e86f9adc9de36506ddb3d208fa","axis":"silent","repo":"pnpm/pnpm","sha":"884a2d1c1675f2e86f9adc9de36506ddb3d208fa","parsed":{"files":[{"path":".changeset/catalog-migrate-command.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+Added `pnpm catalog migrate`, which moves dependency specifiers into the default catalog and replaces them in the workspace projects' `package.json` files with `catalog:`. A dependency moves only when every project declares it with the same specifier. The command lists the dependencies it leaves unchanged [#7072](https://github.com/pnpm/pnpm/issues/7072)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args.rs","lines":["@@ -7,6 +7,7 @@ pub mod bugs;"," pub mod cache;"," pub mod cat_file;"," pub mod cat_index;","+pub mod catalog;"," pub(crate) mod catalogs;"," pub mod change;"," pub mod changelog;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/catalog.rs","lines":["@@ -0,0 +1,332 @@","+use crate::{","+    cli_args::{","+        catalogs::{configured_catalogs, workspace_manifest_catalogs},","+        recursive::discover_workspace_projects,","+        reporter::CliReporter,","+    },","+    config_deps::{apply_config_dependency_settings, update_config_hook_catalogs},","+};","+use clap::{Args, Subcommand};","+use derive_more::{Display, Error};","+use miette::{Context, Diagnostic, IntoDiagnostic};","+use pnpm_catalogs_protocol_parser::parse_catalog_protocol;","+use pnpm_catalogs_types::{Catalog, Catalogs, DEFAULT_CATALOG_NAME};","+use pnpm_config::Config;","+use pnpm_package_manager::stays_out_of_catalogs;","+use pnpm_package_manifest::DependencyGroup;","+use pnpm_text_sanitize::sanitize_inline;","+use pnpm_workspace::Project;","+use pnpm_workspace_manifest_writer::{UpdateWorkspaceManifestOptions, update_workspace_manifest};","+use serde_json::Value;","+use std::{","+    collections::{BTreeMap, BTreeSet},","+    fmt,","+    path::Path,","+};","+","+const MIGRATED_GROUPS: [DependencyGroup; 4] =","+    [DependencyGroup::Prod, DependencyGroup::Dev, DependencyGroup::Optional, DependencyGroup::Peer];","+","+#[derive(Debug, Display, Error, Diagnostic)]","+#[non_exhaustive]","+pub enum CatalogError {","+    #[display(\"Catalogs are declared in pnpm-workspace.yaml, but no workspace was found\")]","+    #[diagnostic(code(ERR_PNPM_CATALOG_NO_WORKSPACE))]","+    NoWorkspace,","+}","+","+#[derive(Debug, Args)]","+pub struct CatalogArgs {","+    #[clap(subcommand)]","+    pub command: CatalogSubcommand,","+}","+","+#[derive(Debug, Subcommand)]","+pub enum CatalogSubcommand {","+    /// Moves the dependency specifiers that all workspace projects agree on","+    /// into the default catalog and references them with `catalog:`.","+    ///","+    /// A dependency declared with different specifiers, or with a specifier","+    /// other than the default catalog's entry for it, is listed and left","+    /// unchanged. Run `pnpm install` afterwards to update the lockfile.","+    Migrate,","+}","+","+impl CatalogArgs {","+    /// `dir` is the command's working directory. `config` has had the","+    /// `updateConfig` hooks applied; `pre_hook_config` is the same","+    /// configuration before they ran, which an install starts from.","+    pub async fn run(","+        self,","+        config: &Config,","+        pre_hook_config: Config,","+        dir: &Path,","+    ) -> miette::Result<()> {","+        match self.command {","+            CatalogSubcommand::Migrate => Box::pin(migrate(config, pre_hook_config, dir)).await,","+        }","+    }","+}","+","+/// The specifiers each dependency is declared with across the workspace,","+/// counting only those a catalog can hold.","+type DeclaredSpecifiers = BTreeMap<String, BTreeSet<String>>;","+","+#[derive(Debug, Default, PartialEq, Eq)]","+struct MigrationPlan {","+    /// Dependency name → the specifier that every project declares it","+    /// with and that becomes (or already is) its default catalog entry.","+    migrated: BTreeMap<String, String>,","+    /// The entries to add to the default catalog.","+    new_entries: Catalog,","+    conflicts: Vec<Conflict>,","+    /// Dependencies the projects agree on whose catalog entry an","+    /// `updateConfig` hook would drop or change, in the order found.","+    changed_by_hooks: Vec<String>,","+}","+","+#[derive(Debug, PartialEq, Eq)]","+struct Conflict {","+    name: String,","+    declared: BTreeSet<String>,","+    catalog_entry: Option<String>,","+}","+","+async fn migrate(config: &Config, pre_hook_config: Config, dir: &Path) -> miette::Result<()> {","+    let workspace_dir = config.workspace_dir.as_deref().ok_or(CatalogError::NoWorkspace)?;","+    let (mut projects, _patterns) = discover_workspace_projects(workspace_dir, config)?;","+    let catalogs = configured_catalogs(config)?;","+    let mut plan =","+        plan_migration(&declared_specifiers(&projects), catalogs.get(DEFAULT_CATALOG_NAME));","+    if !plan.new_entries.is_empty() {","+        keep_entries_the_hooks_keep(&mut plan, pre_hook_config, dir).await?;","+    }","+","+    // The catalog is written before the manifests that reference it, so a","+    // failed manifest write leaves an unused entry rather than a dangling","+    // `catalog:` reference.","+    if !plan.new_entries.is_empty() {","+        let updated_catalogs =","+            Catalogs::from([(DEFAULT_CATALOG_NAME.to_string(), plan.new_entries.clone())]);","+        update_workspace_manifest(","+            workspace_dir,","+            &UpdateWorkspaceManifestOptions {","+                updated_catalogs: Some(&updated_catalogs),","+                ..Default::default()","+            },","+        )","+        .into_diagnostic()","+        .wrap_err(\"write the default catalog to pnpm-workspace.yaml\")?;","+    }","+    for project in &mut projects {","+        if reference_catalog(project, &plan.migrated) {","+            project.manifest","+                .save()","+                .into_diagnostic()","+                .wrap_err_with(|| format!(\"write {}\", project.manifest.path().display()))?;","+        }","+    }","+","+    pnpm_diagnostics::println!(\"{}\", render_report(&plan));","+    Ok(())","+}","+","+fn declared_specifiers(projects: &[Project]) -> DeclaredSpecifiers {","+    let mut declared = DeclaredSpecifiers::new();","+    for project in projects {","+        for (name, specifier) in project.manifest.dependencies(MIGRATED_GROUPS) {","+            if is_migratable(specifier) {","+                declared","+                    .entry(name.to_string())","+                    .or_default()","+                    .insert(specifier.to_string());","+            }","+        }","+    }","+    declared","+}","+","+/// Whether a declared specifier can move into the default catalog. A","+/// `workspace:` specifier stays, because it names a workspace project","+/// rather than a version to share.","+fn is_migratable(specifier: &str) -> bool {","+    parse_catalog_protocol(specifier).is_none()","+        && !specifier.starts_with(\"workspace:\")","+        && !stays_out_of_catalogs(specifier)","+}","+","+fn plan_migration(","+    declared: &DeclaredSpecifiers,","+    default_catalog: Option<&Catalog>,","+) -> MigrationPlan {","+    let mut plan = MigrationPlan::default();","+    for (name, specifiers) in declared {","+        let catalog_entry = default_catalog.and_then(|catalog| catalog.get(name));","+        let agreed = match specifiers","+            .iter()","+            .collect::<Vec<_>>()","+            .as_slice()","+        {","+            [only] => Some(*only),","+            _ => None,","+        };","+        match (agreed, catalog_entry) {","+            (Some(specifier), None) => {","+                plan.new_entries.insert(name.clone(), specifier.clone());","+                plan.migrated.insert(name.clone(), specifier.clone());","+            }","+            (Some(specifier), Some(entry)) if specifier == entry => {","+                plan.migrated.insert(name.clone(), specifier.clone());","+            }","+            _ => plan.conflicts.push(Conflict {","+                name: name.clone(),","+                declared: specifiers.clone(),","+                catalog_entry: catalog_entry.cloned(),","+            }),","+        }","+    }","+    plan","+}","+","+/// An `updateConfig` hook's output replaces the workspace catalogs, so a new","+/// entry written to `pnpm-workspace.yaml` reaches installs only if the hooks","+/// pass it through, and the entries it brings can change what the hooks do","+/// with the existing ones. Run the hooks the way an install would, from the","+/// configuration before they applied, with the proposed entries added, and","+/// hold back every migrated dependency whose entry does not come back as","+/// declared. Holding one back changes the hooks' input, so repeat until a","+/// run holds back nothing.","+async fn keep_entries_the_hooks_keep(","+    plan: &mut MigrationPlan,","+    mut hook_config: Config,","+    dir: &Path,","+) -> miette::Result<()> {","+    // The first pass installed the config dependencies; an install applies","+    // their settings before it runs the hooks.","+    apply_config_dependency_settings(&mut hook_config)?;","+    let root_dir = hook_config.root_project_manifest_dir(dir).to_path_buf();","+    let workspace_catalogs = workspace_manifest_catalogs(&hook_config)?;","+    loop {","+        let mut seed = workspace_catalogs.clone();","+        seed.entry(DEFAULT_CATALOG_NAME.to_string())","+            .or_default()","+            .extend(plan.new_entries.clone());","+        let Some(hook_catalogs) =","+            update_config_hook_catalogs::<CliReporter>(&hook_config, &root_dir, &seed).await?","+        else {","+            return Ok(());","+        };","+        if !plan.hold_back_entries_changed_by(hook_catalogs.get(DEFAULT_CATALOG_NAME)) {","+            return Ok(());","+        }","+    }","+}","+","+impl MigrationPlan {","+    /// Hold back each migrated dependency whose entry in `hook_catalog` is","+    /// missing or differs from the agreed specifier. Returns whether any was","+    /// held back.","+    fn hold_back_entries_changed_by(&mut self, hook_catalog: Option<&Catalog>) -> bool {","+        let changed: Vec<String> = self.migrated","+            .iter()","+            .filter(|(name, specifier)| {","+                hook_catalog.and_then(|catalog| catalog.get(*name)) != Some(*specifier)","+            })","+            .map(|(name, _)| name.clone())","+            .collect();","+        for name in &changed {","+            self.new_entries.remove(name);","+            self.migrated.remove(name);","+        }","+        let held_back = !changed.is_empty();","+        self.changed_by_hooks.extend(changed);","+        held_back","+    }","+}","+","+/// Replace each of `project`'s specifiers that `migrated` moved into the","+/// default catalog with `catalog:`. Returns whether anything changed.","+fn reference_catalog(project: &mut Project, migrated: &BTreeMap<String, String>) -> bool {","+    let mut changed = false;","+    let manifest = project.manifest.value_mut();","+    for group in MIGRATED_GROUPS {","+        let field: &str = group.into();","+        let Some(dependencies) = manifest.get_mut(field).and_then(Value::as_object_mut) else {","+            continue;","+        };","+        for (name, specifier) in dependencies.iter_mut() {","+            if migrated","+                .get(name)","+                .is_some_and(|agreed| specifier.as_str() == Some(agreed))","+            {","+                *specifier = Value::String(\"catalog:\".to_string());","+                changed = true;","+            }","+        }","+    }","+    changed","+}","+","+fn render_report(plan: &MigrationPlan) -> String {","+    let mut report = String::new();","+    if !plan.conflicts.is_empty() {","+        report.push_str(","+            \"These dependencies were left unchanged because the projects or the default catalog disagree on their specifier:\\n\",","+        );","+        for conflict in &plan.conflicts {","+            report.push_str(\"  \");","+            report.push_str(&conflict.to_string());","+            report.push('\\n');","+        }","+    }","+    report.push_str(&render_changed_by_hooks(&plan.changed_by_hooks));","+    report.push_str(&render_summary(plan.migrated.len()));","+    report","+}","+","+fn render_changed_by_hooks(names: &[String]) -> String {","+    if names.is_empty() {","+        return String::new();","+    }","+    let names = names","+        .iter()","+        .map(|name| sanitize_inline(name))","+        .collect::<Vec<_>>()","+        .join(\", \");","+    format!(","+        \"These dependencies were left unchanged because an updateConfig hook would not keep their catalog entry as declared: {names}\\n\",","+    )","+}","+","+fn render_summary(migrated: usize) -> String {","+    match migrated {","+        0 => \"No dependencies were moved to the default catalog.\".to_string(),","+        1 => {","+            \"Moved 1 dependency to the default catalog. Run `pnpm install` to update the lockfile.\"","+                .to_string()","+        }","+        count => format!(","+            \"Moved {count} dependencies to the default catalog. Run `pnpm install` to update the lockfile.\",","+        ),","+    }","+}","+","+impl fmt::Display for Conflict {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        // The names and specifiers come from the workspace manifests, so","+        // control characters are stripped before they reach the terminal.","+        let declared = self.declared","+            .iter()","+            .map(|specifier| sanitize_inline(specifier))","+            .collect::<Vec<_>>()","+            .join(\", \");","+        write!(f, \"{}: {declared}\", sanitize_inline(&self.name))?;","+        match &self.catalog_entry {","+            Some(entry) => write!(f, \" (catalog: {})\", sanitize_inline(entry)),","+            None => Ok(()),","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":332,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/catalog/tests.rs","lines":["@@ -0,0 +1,134 @@","+use super::{","+    Conflict, DeclaredSpecifiers, MigrationPlan, is_migratable, plan_migration, render_report,","+};","+use pnpm_catalogs_types::Catalog;","+use pretty_assertions::assert_eq;","+use std::collections::{BTreeMap, BTreeSet};","+","+fn declared(entries: &[(&str, &[&str])]) -> DeclaredSpecifiers {","+    entries","+        .iter()","+        .map(|(name, specifiers)| {","+            (","+                name.to_string(),","+                specifiers","+                    .iter()","+                    .map(ToString::to_string)","+                    .collect(),","+            )","+        })","+        .collect()","+}","+","+fn catalog(entries: &[(&str, &str)]) -> Catalog {","+    entries","+        .iter()","+        .map(|(name, specifier)| (name.to_string(), specifier.to_string()))","+        .collect()","+}","+","+#[test]","+fn keeps_specifiers_a_catalog_cannot_share() {","+    for specifier in [","+        \"catalog:\",","+        \"catalog:react18\",","+        \"workspace:*\",","+        \"workspace:^\",","+        \"workspace:../foo\",","+        \"link:../foo\",","+        \"file:../foo\",","+        \"../foo\",","+        \"runtime:22\",","+    ] {","+        assert!(!is_migratable(specifier), \"{specifier} must stay direct\");","+    }","+    for specifier in [\"^1.0.0\", \"1.2.3\", \"latest\", \"npm:bar@^1\", \"github:user/repo\"] {","+        assert!(is_migratable(specifier), \"{specifier} must be migratable\");","+    }","+}","+","+#[test]","+fn moves_agreed_specifiers_and_lists_the_rest() {","+    let plan = plan_migration(","+        &declared(&[","+            (\"agreed\", &[\"^1.0.0\"]),","+            (\"split\", &[\"^1.0.0\", \"^2.0.0\"]),","+            (\"cataloged\", &[\"^3.0.0\"]),","+            (\"off-catalog\", &[\"^4.0.0\"]),","+        ]),","+        Some(&catalog(&[(\"cataloged\", \"^3.0.0\"), (\"off-catalog\", \"^4.1.0\")])),","+    );","+    assert_eq!(","+        plan,","+        MigrationPlan {","+            migrated: BTreeMap::from([","+                (\"agreed\".to_string(), \"^1.0.0\".to_string()),","+                (\"cataloged\".to_string(), \"^3.0.0\".to_string()),","+            ]),","+            new_entries: catalog(&[(\"agreed\", \"^1.0.0\")]),","+            conflicts: vec![","+                Conflict {","+                    name: \"off-catalog\".to_string(),","+                    declared: BTreeSet::from([\"^4.0.0\".to_string()]),","+                    catalog_entry: Some(\"^4.1.0\".to_string()),","+                },","+                Conflict {","+                    name: \"split\".to_string(),","+                    declared: BTreeSet::from([\"^1.0.0\".to_string(), \"^2.0.0\".to_string()]),","+                    catalog_entry: None,","+                },","+            ],","+            changed_by_hooks: Vec::new(),","+        },","+    );","+    assert_eq!(","+        render_report(&plan),","+        \"These dependencies were left unchanged because the projects or the default catalog disagree on their specifier:","+  off-catalog: ^4.0.0 (catalog: ^4.1.0)","+  split: ^1.0.0, ^2.0.0","+Moved 2 dependencies to the default catalog. Run `pnpm install` to update the lockfile.\",","+    );","+}","+","+#[test]","+fn reports_when_nothing_moves() {","+    let plan = plan_migration(&DeclaredSpecifiers::new(), None);","+    assert_eq!(render_report(&plan), \"No dependencies were moved to the default catalog.\");","+}","+","+#[test]","+fn strips_control_characters_from_conflicts() {","+    let conflict = Conflict {","+        name: \"evil\\u{1b}[2J\".to_string(),","+        declared: BTreeSet::from([\"^1.0.0\\u{1b}[31m\".to_string(), \"^2.0.0\".to_string()]),","+        catalog_entry: Some(\"^3.0.0\\u{7}\".to_string()),","+    };","+    assert_eq!(conflict.to_string(), \"evil[2J: ^1.0.0[31m, ^2.0.0 (catalog: ^3.0.0)\");","+}","+","+#[test]","+fn holds_back_entries_the_hooks_drop_or_change() {","+    let mut plan = plan_migration(","+        &declared(&[(\"kept\", &[\"^1.0.0\"]), (\"dropped\", &[\"^2.0.0\"]), (\"changed\", &[\"^3.0.0\"])]),","+        None,","+    );","+    assert!(plan.hold_back_entries_changed_by(Some(&catalog(&[","+        (\"kept\", \"^1.0.0\"),","+        (\"changed\", \"^3.1.0\"),","+    ]))));","+    assert!(!plan.hold_back_entries_changed_by(Some(&catalog(&[(\"kept\", \"^1.0.0\")]))));","+    assert_eq!(","+        plan,","+        MigrationPlan {","+            migrated: BTreeMap::from([(\"kept\".to_string(), \"^1.0.0\".to_string())]),","+            new_entries: catalog(&[(\"kept\", \"^1.0.0\")]),","+            conflicts: Vec::new(),","+            changed_by_hooks: vec![\"changed\".to_string(), \"dropped\".to_string()],","+        },","+    );","+    assert_eq!(","+        render_report(&plan),","+        \"These dependencies were left unchanged because an updateConfig hook would not keep their catalog entry as declared: changed, dropped","+Moved 1 dependency to the default catalog. Run `pnpm install` to update the lockfile.\",","+    );","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/catalogs.rs","lines":["@@ -13,9 +13,15 @@ use pnpm_workspace_projects_graph::WorkspaceCatalogs;"," /// install performs. Empty outside a workspace, where no catalog can be"," /// declared."," pub(crate) fn configured_catalogs(config: &Config) -> miette::Result<Catalogs> {","-    if let Some(catalogs) = &config.catalogs {","-        return Ok(catalogs.clone());","+    match &config.catalogs {","+        Some(catalogs) => Ok(catalogs.clone()),","+        None => workspace_manifest_catalogs(config),","     }","+}","+","+/// The `catalog:` / `catalogs:` tables of the workspace manifest, ignoring","+/// what an `updateConfig` hook made of them. Empty outside a workspace.","+pub(crate) fn workspace_manifest_catalogs(config: &Config) -> miette::Result<Catalogs> {","     let Some(workspace_dir) = config.workspace_dir.as_deref() else {","         return Ok(Catalogs::default());","     };"],"additions":8,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command.rs","lines":["@@ -13,6 +13,7 @@ use super::{","     cache::CacheCommand,","     cat_file::CatFileArgs,","     cat_index::CatIndexArgs,","+    catalog::CatalogArgs,","     change::ChangeArgs,","     ci::CiArgs,","     clean::CleanArgs,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -1,9 +1,9 @@"," use super::{","     AccessArgs, AddArgs, ApproveArgs, ApproveBuildsArgs, AuditArgs, BinArgs, BugsArgs,","-    CacheCommand, CatFileArgs, CatIndexArgs, ChangeArgs, CiArgs, CleanArgs, CompletionArgs,","-    CompletionServerArgs, ConfigArgs, ConfigGetAliasArgs, ConfigSetAliasArgs, CreateArgs,","-    DedupeArgs, DeployArgs, DeprecateArgs, DistTagArgs, DlxArgs, DocsArgs, DoctorArgs, EnvArgs,","-    ExecArgs, FetchArgs, FindHashArgs, FundArgs, IgnoredBuildsArgs, ImportArgs, InitArgs,","+    CacheCommand, CatFileArgs, CatIndexArgs, CatalogArgs, ChangeArgs, CiArgs, CleanArgs,","+    CompletionArgs, CompletionServerArgs, ConfigArgs, ConfigGetAliasArgs, ConfigSetAliasArgs,","+    CreateArgs, DedupeArgs, DeployArgs, DeprecateArgs, DistTagArgs, DlxArgs, DocsArgs, DoctorArgs,","+    EnvArgs, ExecArgs, FetchArgs, FindHashArgs, FundArgs, IgnoredBuildsArgs, ImportArgs, InitArgs,","     InstallArgs, InstallTestArgs, LaneArgs, LicensesArgs, LinkArgs, ListArgs, LoginArgs,","     LogoutArgs, NotImplementedArgs, OutdatedArgs, OwnerArgs, PackAppArgs, PackArgs, PatchArgs,","     PatchCommitArgs, PatchRemoveArgs, PeersArgs, PermissionsArgs, PingArgs, PipelineArgs, PkgArgs,","@@ -214,6 +214,8 @@ pub enum CliCommand {","     /// Inspect and manage the metadata cache.","     #[clap(subcommand)]","     Cache(CacheCommand),","+    /// Manage the catalogs of the workspace.","+    Catalog(CatalogArgs),","     /// Prints the contents of a file based on the hash value stored in the index file.","     CatFile(CatFileArgs),","     /// Prints the index file of a specific package from the store."],"additions":6,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/routing.rs","lines":["@@ -96,6 +96,7 @@ fn route_project<'a>(command: CliCommand, ctx: &RunCtx<'a>) -> miette::Result<Co","         CliCommand::Stop(args) => dispatch_script::stop(ctx, args),","         CliCommand::Restart(args) => dispatch_script::restart(ctx, args),","         CliCommand::Pkg(args) => dispatch_script::pkg(ctx, args),","+        CliCommand::Catalog(args) => dispatch_script::catalog(ctx, args),","         CliCommand::Edit(_) => dispatch_query::not_implemented(\"edit\"),","         CliCommand::Xmas(_) => dispatch_query::not_implemented(\"xmas\"),","         command => route_maintenance(command, ctx),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_script.rs","lines":["@@ -1,4 +1,5 @@"," use super::{","+    catalog::CatalogArgs,","     dispatch::{CommandFuture, RunCtx, apply_update_config},","     exec::{ExecArgs, ExecDirs},","     init::InitArgs,","@@ -78,6 +79,21 @@ pub(super) fn pkg<'a>(ctx: &RunCtx<'a>, args: PkgArgs) -> miette::Result<Command","     Ok(Box::pin(std::future::ready(result)))"," }"," ","+// `catalog` compares against the catalogs an install resolves through, so","+// the `updateConfig` hooks apply first.","+pub(super) fn catalog<'a>(","+    ctx: &RunCtx<'a>,","+    args: CatalogArgs,","+) -> miette::Result<CommandFuture<'a>> {","+    let config = (ctx.loaders.config)()?;","+    let pre_hook_config = config.clone();","+    let dir = ctx.locations.dir;","+    Ok(Box::pin(async move {","+        apply_update_config(config, dir).await?;","+        Box::pin(args.run(config, pre_hook_config, dir)).await","+    }))","+}","+"," pub(super) fn test<'a>(","     ctx: &RunCtx<'a>,","     args: ScriptShortcutArgs,"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps.rs","lines":["@@ -11,7 +11,7 @@ pub use declarations::{add_config_dependencies, update_config_dependencies};"," pub use engine_policy::mature_pnpm_version_for_range;"," pub use hooks::{","     apply_config_dependency_settings, load_before_packing_hooks, may_update_config, prepare_config,","-    run_update_config_hooks,","+    run_update_config_hooks, update_config_hook_catalogs,"," };"," "," pub(crate) use declarations::declared_specifier;"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks.rs","lines":["@@ -1,4 +1,6 @@","-pub use self::package_settings::apply_config_dependency_settings;","+pub use self::{","+    catalogs::update_config_hook_catalogs, package_settings::apply_config_dependency_settings,","+};"," "," use self::apply::apply_hook_delta;"," use super::{","@@ -124,8 +126,14 @@ pub async fn run_update_config_hooks<Reporter: self::Reporter>(","         .wrap_err(\"serialize the resolved settings for updateConfig hooks\")?;","     seed_hook_input(&mut input, config, root_dir, &pnpmfiles, manifest_catalogs_value(root_dir)?)?;"," ","-    let current =","-        execute_update_config_hooks::<Reporter>(&pnpmfiles, &hooks, input.clone(), root_dir).await?;","+    let current = execute_update_config_hooks::<Reporter>(","+        &pnpmfiles,","+        &hooks,","+        input.clone(),","+        root_dir,","+        IgnoredHookWarnings::Emit,","+    )","+    .await?;","     adopt_hook_catalogs(config, &current)?;"," ","     apply_hook_delta(config, &input, &current, &base_dir)?;","@@ -133,11 +141,20 @@ pub async fn run_update_config_hooks<Reporter: self::Reporter>(","     Ok(hooks)"," }"," ","+/// Whether a hook run reports the hooks a pnpmfile defines but pnpm ignores.","+/// A repeated run skips them, so each warning appears once per command.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+enum IgnoredHookWarnings {","+    Emit,","+    Skip,","+}","+"," async fn execute_update_config_hooks<Reporter: self::Reporter>(","     pnpmfiles: &[PathBuf],","     hooks: &[Arc<dyn PnpmfileHooks>],","     mut current: Value,","     root_dir: &Path,","+    warnings: IgnoredHookWarnings,"," ) -> Result<Value> {","     let prefix = root_dir.to_string_lossy().into_owned();","     let mut ignored_hooks = Vec::new();","@@ -149,7 +166,9 @@ async fn execute_update_config_hooks<Reporter: self::Reporter>(","             .map_err(|err| update_config_hook_error(pnpmfile, err))?;","         ignored_hooks.push((pnpmfile.as_path(), hook.ignored_hooks().await));","     }","-    warn_ignored_hooks::<Reporter>(&ignored_hooks, &prefix);","+    if warnings == IgnoredHookWarnings::Emit {","+        warn_ignored_hooks::<Reporter>(&ignored_hooks, &prefix);","+    }","     Ok(current)"," }"," ","@@ -492,19 +511,10 @@ fn hook_logger<Reporter: self::Reporter>(pnpmfile: &Path, prefix: &str) -> LogFn"," "," /// Hook output replaces the seeded catalogs, including removed entries."," fn adopt_hook_catalogs(config: &mut Config, current: &Value) -> Result<()> {","-    config.catalogs = Some(","-        current","-            .get(\"catalogs\")","-            .cloned()","-            .map(serde_json::from_value)","-            .transpose()","-            .into_diagnostic()","-            .wrap_err(\"the updateConfig hook produced an invalid catalogs value\")?","-            .unwrap_or_default(),","-    );","-","+    config.catalogs = Some(catalogs::hook_output_catalogs(current)?);","     Ok(())"," }"," "," mod apply;","+mod catalogs;"," mod package_settings;"],"additions":25,"deletions":15,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks/catalogs.rs","lines":["@@ -0,0 +1,53 @@","+use super::{","+    Arc, Config, IgnoredHookWarnings, IntoDiagnostic, Path, PnpmfileHooks, Reporter, Result,","+    TrustedSettings, Value, execute_update_config_hooks, finder, resolve_pnpmfile_paths,","+    seed_hook_input,","+};","+use miette::WrapErr;","+use pnpm_catalogs_types::Catalogs;","+","+/// The catalogs the `updateConfig` hooks for `root_dir` produce when handed","+/// `seed` as the workspace catalogs, or `None` when no pnpmfile runs.","+/// Nothing else the hooks change is applied to `config`.","+pub async fn update_config_hook_catalogs<Reporter: self::Reporter>(","+    config: &Config,","+    root_dir: &Path,","+    seed: &Catalogs,","+) -> Result<Option<Catalogs>> {","+    let pnpmfiles = resolve_pnpmfile_paths(config, root_dir)","+        .map_err(|error| miette::miette!(code = \"ERR_PNPM_PNPMFILE_NOT_FOUND\", \"{error}\"))?;","+    if pnpmfiles.is_empty() {","+        return Ok(None);","+    }","+    let hooks: Vec<Arc<dyn PnpmfileHooks>> = pnpmfiles","+        .iter()","+        .cloned()","+        .map(finder::load_pnpmfile_at)","+        .collect();","+    let mut input = TrustedSettings::from_resolved(config)","+        .to_json()","+        .into_diagnostic()","+        .wrap_err(\"serialize the resolved settings for updateConfig hooks\")?;","+    let seed = serde_json::to_value(seed).into_diagnostic()?;","+    seed_hook_input(&mut input, config, root_dir, &pnpmfiles, seed)?;","+    let current = execute_update_config_hooks::<Reporter>(","+        &pnpmfiles,","+        &hooks,","+        input,","+        root_dir,","+        IgnoredHookWarnings::Skip,","+    )","+    .await?;","+    hook_output_catalogs(&current).map(Some)","+}","+","+pub(super) fn hook_output_catalogs(current: &Value) -> Result<Catalogs> {","+    Ok(current","+        .get(\"catalogs\")","+        .cloned()","+        .map(serde_json::from_value)","+        .transpose()","+        .into_diagnostic()","+        .wrap_err(\"the updateConfig hook produced an invalid catalogs value\")?","+        .unwrap_or_default())","+}"],"add