{"id":"fff8cf2b38a07dc3e4b585e62b85070d88a3b928","axis":"silent","repo":"elastic/elasticsearch","sha":"fff8cf2b38a07dc3e4b585e62b85070d88a3b928","parsed":{"files":[{"path":"docs/changelog/164601.yaml","lines":["@@ -0,0 +1,5 @@","+area: ES|QL","+issues: []","+pr: 164601","+summary: Add the DESCRIBE command","+type: enhancement"],"additions":5,"deletions":0,"truncated":false},{"path":"docs/reference/query-languages/esql/kibana/generated/x-pack-esql/definition/commands/describe.json","lines":["@@ -0,0 +1,5 @@","+{","+  \"comment\" : \"This is generated by ESQL's DocsV3Support. Do not edit it. See docs/reference/query-languages/esql/README.md for how to regenerate it.\",","+  \"type\" : \"command\",","+  \"name\" : \"describe\"","+}"],"additions":5,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/qa/testFixtures/src/main/resources/datasources/external-describe.csv-spec","lines":["@@ -0,0 +1,36 @@","+// DESCRIBE over a dataset. The columns come from the dataset schema, which has no mapping,","+// so only what the schema says is reported.","+","+describeDataset","+required_capability: dataset_in_from_command","+required_capability: describe_command","+dataset: employees_no_mv: \"{{employees_no_mv}}\"","+","+FROM employees_no_mv","+| KEEP emp_no, first_name, salary","+| RENAME salary AS pay","+| EVAL double_pay = pay * 2","+| DESCRIBE","+| KEEP name, type, field, origin, role, searchable, aggregatable;","+","+name:keyword | type:keyword | field:keyword | origin:keyword | role:keyword | searchable:boolean | aggregatable:boolean","+emp_no       | integer      | emp_no        | dataset        | null         | null               | null","+first_name   | keyword      | first_name    | dataset        | null         | null               | null","+pay          | integer      | salary        | renamed        | null         | null               | null","+double_pay   | integer      | null          | computed       | null         | null               | null","+;","+","+describeDatasetFileMetadata","+required_capability: dataset_in_from_command","+required_capability: describe_command","+dataset: employees_no_mv: \"{{employees_no_mv}}\"","+","+FROM employees_no_mv METADATA _file.path","+| KEEP emp_no, _file.path","+| DESCRIBE","+| KEEP name, field, origin, role;","+","+name:keyword | field:keyword | origin:keyword | role:keyword","+emp_no       | emp_no        | dataset        | null","+_file.path   | _file.path    | metadata       | metadata","+;"],"additions":36,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/qa/testFixtures/src/main/resources/describe.csv-spec","lines":["@@ -0,0 +1,146 @@","+// DESCRIBE: one row per input column with what the mappings say about it.","+","+describeRoles","+required_capability: describe_command","+","+FROM k8s","+| DESCRIBE","+| WHERE name IN (\"@timestamp\", \"cluster\", \"event\", \"event_log\", \"client.ip\", \"network.bytes_in\", \"network.total_bytes_in\", \"network.eth0.rx\")","+| KEEP name, type, role, origin, metric_type, unit, searchable, aggregatable","+| SORT name","+;","+","+name:keyword           | type:keyword  | role:keyword | origin:keyword | metric_type:keyword | unit:keyword | searchable:boolean | aggregatable:boolean","+@timestamp             | date          | time         | mapped         | null                | null         | true               | true","+client.ip              | ip            | attribute    | mapped         | null                | null         | true               | true","+cluster                | keyword       | dimension    | mapped         | null                | null         | true               | true","+event                  | keyword       | attribute    | mapped         | null                | null         | true               | true","+event_log              | text          | text         | mapped         | null                | null         | true               | false","+network.bytes_in       | long          | numeric      | mapped         | null                | null         | true               | true","+network.eth0.rx        | integer       | metric       | mapped         | gauge               | packets      | true               | true","+network.total_bytes_in | counter_long  | metric       | mapped         | counter             | bytes        | true               | true","+;","+","+describeMetricsUnderTs","+required_capability: describe_command","+","+TS k8s","+| DESCRIBE","+| WHERE role == \"metric\"","+| KEEP name, metric_type, unit","+| SORT name","+;","+","+name:keyword            | metric_type:keyword | unit:keyword","+network.eth0.rx         | gauge               | packets","+network.eth0.tx         | gauge               | packets","+network.total_bytes_in  | counter             | bytes","+network.total_bytes_out | counter             | bytes","+network.total_cost      | counter             | usd","+;","+","+describeRolesSummary","+required_capability: describe_command","+","+FROM k8s","+| DESCRIBE","+| STATS fields = COUNT(*) BY role","+| SORT role","+;","+","+fields:long | role:keyword","+7           | attribute","+3           | dimension","+5           | metric","+4           | numeric","+2           | other","+1           | text","+1           | time","+;","+","+describeLineage","+required_capability: describe_command","+","+FROM employees","+| KEEP emp_no, salary, first_name","+| RENAME salary AS pay","+| EVAL bonus = pay * 2","+| DESCRIBE","+| KEEP name, type, field, origin, role","+;","+","+name:keyword | type:keyword | field:keyword | origin:keyword | role:keyword","+emp_no       | integer      | emp_no        | mapped         | numeric","+pay          | integer      | salary        | renamed        | numeric","+first_name   | keyword      | first_name    | mapped         | attribute","+bonus        | integer      | null          | computed       | null","+;","+","+describeAfterStats","+required_capability: describe_command","+skip_flattened_rewrite: describe_sees_rewritten_field_as_computed","+","+TS k8s","+| STATS rate = SUM(RATE(network.total_bytes_in)) BY cluster, bucket = TBUCKET(1 hour)","+| EVAL kib_rate = rate / 1024","+| DESCRIBE","+| KEEP name, type, origin, role, metric_type","+;","+","+name:keyword | type:keyword | origin:keyword | role:keyword | metric_type:keyword","+rate         | double       | computed       | null         | null","+cluster      | keyword      | mapped         | dimension    | null","+bucket       | date         | computed       | null         | null","+kib_rate     | double       | computed       | null         | null","+;","+","+describeRolesAfterStats","+required_capability: describe_command","+skip_flattened_rewrite: describe_sees_rewritten_field_as_computed","+","+FROM employees","+| STATS avg_salary = AVG(salary), hires = COUNT(*) BY gender","+| DESCRIBE","+| KEEP name, origin, role","+;","+","+name:keyword | origin:keyword | role:keyword","+avg_salary   | computed       | null","+hires        | computed       | null","+gender       | mapped         | attribute","+;","+","+describeUnitsThroughRename","+required_capability: describe_command","+","+FROM k8s","+| KEEP network.total_bytes_in, network.bytes_in","+| RENAME network.total_bytes_in AS total","+| DESCRIBE","+| KEEP name, field, origin, unit","+;","+","+name:keyword     | field:keyword          | origin:keyword | unit:keyword","+total            | network.total_bytes_in | renamed        | bytes","+network.bytes_in | network.bytes_in       | mapped         | null","+;","+","+describeStatsAfterTs","+required_capability: describe_command","+","+TS k8s","+| DESCRIBE","+| STATS fields = COUNT(*) BY role, metric_type","+| SORT role, metric_type","+;","+","+fields:long | role:keyword | metric_type:keyword","+7           | attribute    | null","+3           | dimension    | null","+3           | metric       | counter","+2           | metric       | gauge","+4           | numeric      | null","+2           | other        | null","+1           | text 