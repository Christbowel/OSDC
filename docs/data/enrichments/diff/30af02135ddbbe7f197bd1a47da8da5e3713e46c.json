Key = 'a_device_' . $projectId;","+        $sessionKey = 'a_session_' . $projectId;","+        ['userId' => $userId] = $this->createUser();","+        $client = [","+            'origin' => 'http://localhost',","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $projectId,","+        ];","+","+        // An account switching device holds one session per user: signing in again replaces the held one","+        $device = $this->client->call(Client::METHOD_POST, '/account/devices', $client);","+        $this->assertSame(201, $device['headers']['status-code']);","+        $deviceCookie = $device['cookies'][$deviceKey];","+","+        $signIn = fn () => $this->client->call(Client::METHOD_POST, '/account/sessions/email', array_merge($client, [","+            'cookie' => $deviceKey . '=' . $deviceCookie,","+        ]), [","+            'email' => 'mqtt-' . $userId . '@appwrite.io',","+            'password' => 'password',","+        ]);","+","+        $replaced = $signIn();","+        $this->assertSame(201, $replaced['headers']['status-code']);","+        $kept = $this->createSession($userId);","+","+        $replacedSubscriber = $this->subscribeToUserTopic($projectId, $userId, $replaced['cookies'][$sessionKey], 'e2e-revoke-device-replaced-', 'appwrite-session');","+        $keptSubscriber = $this->subscribeToUserTopic($projectId, $userId, $kept, 'e2e-revoke-device-kept-', 'appwrite-session');","+","+        try {","+            $again = $signIn();","+            $this->assertSame(201, $again['headers']['status-code']);","+            $this->assertNotSame($replaced['body']['$id'], $again['body']['$id']);","+","+            // Test for SUCCESS: the connection opened with the replaced session is ended.","+            $this->assertSame(Disconnect::NOT_AUTHORIZED, $replacedSubscriber->awaitDisconnect(self::REVOKE_TIMEOUT), 'the broker did not disconnect a connection whose session was replaced on its device');","+","+            // Test for SUCCESS: a connection on another session of the user, not on the device, stays open.","+            $this->assertTrue($keptSubscriber->ping(), 'a connection on a session still active was disconnected');","+        } finally {","+            $replacedSubscriber->disconnect();","+            $keptSubscriber->disconnect();","+        }","+    }","+","     public function testEnablingMfaDisconnectsSessionMissingFactor(): void","     {","         $projectId = $this->getProject()['$id'];",""],"additions":47,"deletions":0,"truncated":false}],"additions":62,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-07T15:03:46.409034+00:00"}