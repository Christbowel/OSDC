 unlocked, so that it may take the owner's lock to synchronize against the","+\t// incremental updates applied to the current map state.","+\tPreviousMapStateSizes() MapStateSizes"," \tRegenerateIfAlive(regenMetadata *regeneration.ExternalRegenerationMetadata) <-chan bool"," }"," ","@@ -401,6 +405,13 @@ func (p *selectorPolicy) Detach() {"," func (p *selectorPolicy) DistillPolicy(logger *slog.Logger, policyOwner PolicyOwner, redirects map[string]uint16) *EndpointPolicy {"," \tvar calculatedPolicy *EndpointPolicy"," ","+\t// Size the new map state after the owner's current one. This must be done before taking","+\t// the selector cache read lock below: the accessor takes the PolicyOwner's (endpoint)","+\t// lock, and the established lock order is endpoint lock first, selector cache lock second","+\t// (e.g. Detach takes the selector cache write lock while the endpoint lock is held).","+\t// Taking the endpoint lock inside 'WithRLock' would invert that order and deadlock.","+\tsizes := policyOwner.PreviousMapStateSizes()","+"," \t// EndpointPolicy is initialized while 'WithRLock' keeps the selector cache read"," \t// locked. This syncronizes the selector snapshot creation and the registration of the new"," \t// EndpointPolicy as a user of the selectorPolicy 'p' before any new incremental updated can","@@ -420,7 +431,7 @@ func (p *selectorPolicy) DistillPolicy(logger *slog.Logger, policyOwner PolicyOw"," \t\tcalculatedPolicy = &EndpointPolicy{"," \t\t\tSelectorPolicy: p,"," \t\t\tselectors:      selectors,","-\t\t\tpolicyMapState: newMapState(logger, policyOwner.PreviousMapState(), features, p.clusterInfo),","+\t\t\tpolicyMapState: newMapState(logger, sizes, features, p.clusterInfo),"," \t\t\tpolicyMapChanges: MapChanges{"," \t\t\t\tlogger:   logger,"," \t\t\t\tfirstRev: selectors.Revision,","@@ -718,7 +729,7 @@ func (p *EndpointPolicy) ConsumeMapChanges() (closer func(), changes ChangeState"," func NewEndpointPolicy(logger *slog.Logger, repo PolicyRepository) *EndpointPolicy {"," \treturn &EndpointPolicy{"," \t\tSelectorPolicy: newSelectorPolicy(repo.GetSelectorCache(), repo.GetClusterInfo()),","-\t\tpolicyMapState: newMapState(logger, nil, 0, repo.GetClusterInfo()),","+\t\tpolicyMapState: newMapState(logger, MapStateSizes{}, 0, repo.GetClusterInfo()),"," \t}"," }"," "],"additions":14,"deletions":3,"truncated":false},{"path":"pkg/policy/resolve_race_test.go","lines":["@@ -0,0 +1,179 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package policy","+","+import (","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/cilium/hive/hivetest\"","+\t\"github.com/stretchr/testify/require\"","+","+\tcmtypes \"github.com/cilium/cilium/pkg/clustermesh/types\"","+\t\"github.com/cilium/cilium/pkg/identity\"","+\t\"github.com/cilium/cilium/pkg/lock\"","+\t\"github.com/cilium/cilium/pkg/policy/types\"","+\t\"github.com/cilium/cilium/pkg/u8proto\"","+)","+","+// racingPolicyOwner mimics the endpoint's locking: the current EndpointPolicy is mutated by","+// incremental map changes while holding 'mutex', which is the only lock a policy recomputation","+// can use to synchronize with it. The selector cache read lock held by DistillPolicy provides no","+// mutual exclusion here, as incremental changes are applied without it.","+type racingPolicyOwner struct {","+\tDummyOwner","+","+\tmutex   lock.RWMutex","+\tcurrent *EndpointPolicy","+}","+","+func (o *racingPolicyOwner) PreviousMapStateSizes() MapStateSizes {","+\to.mutex.RLock()","+\tdefer o.mutex.RUnlock()","+\treturn o.current.GetMapState().Sizes()","+}","+","+// TestDistillPolicyMapStateRace checks that deriving the map state of a new EndpointPolicy from","+// the owner's current one does not race with incremental map changes applied to that current","+// policy. Run with -race.","+func TestDistillPolicyMapStateRace(t *testing.T) {","+\tlogger := hivetest.Logger(t)","+","+\tsp := &selectorPolicy{","+\t\tRevision:      1,","+\t\tSelectorCache: testNewSelectorCache(t, logger, nil),","+\t\tL4Policy:      NewL4Policy(1),","+\t}","+\t// named port rules make the map state maintain the identity index ('byId') that both the","+\t// reader and the writer touch.","+\tsp.L4Policy.Ingress.features.setFeature(namedPortRules)","+\tfeatures := sp.L4Policy.Ingress.features | sp.L4Policy.Egress.features","+","+\tcurrent := &EndpointPolicy{","+\t\tSelectorPolicy:   sp,","+\t\tpolicyMapState:   newMapState(logger, MapStateSizes{}, features, cmtypes.DefaultClusterInfo),","+\t\tpolicyMapChanges: MapChanges{logger: logger},","+\t}","+\t// the id index must be in use for the race on it to be covered","+\trequire.NotNil(t, current.policyMapState.byId)","+\towner := &racingPolicyOwner{","+\t\tDummyOwner: DummyOwner{logger: logger},","+\t\tcurrent:    current,","+\t}","+\tcurrent.PolicyOwner = owner","+","+\tconst numIdentities = 128","+\tkey := egressKey(0, u8proto.TCP, 80, 0)","+\tentry := newMapStateEntry(0, types.HighestPriority, types.LowestPriority, NilRuleOrigin, 0, 0, types.Allow, NoAuthRequirement)","+\tfor i := range numIdentities {","+\t\tcurrent.policyMapState.upsert(key.WithIdentity(identity.NumericIdentity(i+1000)), entry)","+\t}","+","+\tconst iterations = 1000","+","+\tvar wg sync.WaitGroup","+\twg.Add(2)","+","+\t// Writer: incremental map changes, as applied by Endpoint.ApplyPolicyMapChanges while","+\t// holding the endpoint lock.","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tfor i := range iterations {","+\t\t\tid := identity.NumericIdentity(i%numIdentities + 1000)","+\t\t\towner.mutex.Lock()","+\t\t\tcurrent.policyMapChanges.AccumulateMapChanges(0, 0,","+\t\t\t\tidentity.NumericIdentitySlice{id}, nil, key, entry)","+\t\t\tcurrent.policyMapChanges.SyncMapChanges(types.MockSelectorSnapshot())","+\t\t\tcurrent.policyMapChanges.consumeMapChanges(current, features)","+","+\t\t\tcurrent.policyMapChanges.AccumulateMapChanges(0, 0,","+\t\t\t\tnil, identity.NumericIdentitySlice{id}, key, entry)","+\t\t\tcurrent.policyMapChanges.SyncMapChanges(types.MockSelectorSnapshot())","+\t\t\tcurrent.policyMapChanges.consumeMapChanges(current, features)","+\t\t\towner.mutex.Unlock()","+\t\t}","+\t}()","+","+\t// Reader: policy recomputation, which runs with the endpoint unlocked.","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tfor range iterations {","+\t\t\tep := sp.DistillPolicy(logger, owner, nil)","+\t\t\tep.Ready()","+\t\t\tep.Detach(logger)","+\t\t}","+\t}()","+","+\twg.Wait()","+}","+","+// TestDistillPolicyLockOrder guards the lock order documented in DistillPolicy: the map state","+// sizes accessor takes the PolicyOwner's lock, and the owner takes the selector cache write","+// lock while holding its own lock (as the endpoint's setDesiredPolicy does via Detach), so the","+// accessor must be called before the selector cache read lock is taken. Calling it inside","+// 'WithRLock' inverts the order and deadlocks this test.","+func TestDistillPolicyLockOrder(t *testing.T) {","+\tlogger := hivetest.Logger(t)","+","+\tsp := &selectorPolicy{","+\t\tRevision:      1,","+\t\tSelectorCache: testNewSelectorCache(t, logger, nil),","+\t\tL4Policy:      NewL4Policy(1),","+\t}","+\tsp.L4Policy.Ingress.features.setFeature(namedPortRules)","+","+\tcurrent := &EndpointPolicy{","+\t\tSelectorPolicy:   sp,","+\t\tpolicyMapState:   emptyMapState(logger),","+\t\tpolicyMapChanges: MapChanges{logger: logger},","+\t}","+\towner := &racingPolicyOwner{","+\t\tDummyOwner: DummyOwner{logger: logger},","+\t\tcurrent:    current,","+\t}","+\tcurrent.PolicyOwner = owner","+","+\tconst iterations = 1000","+","+\tvar wg sync.WaitGroup","+\twg.Add(2)","+","+\t// Owner: takes the selector cache write lock while holding its own lock, as the endpoint","+\t// does when setDesiredPolicy detaches a superseded policy (Detach -> removeUser ->","+\t// finishDetach -> RemoveSelectors).","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tsc := sp.SelectorCache","+\t\tfor range iterations {","+\t\t\towner.mutex.Lock()","+\t\t\tsc.