{"id":"008ab736b26b2549bcebb25ab298972daaac369d","axis":"silent","repo":"cilium/cilium","sha":"008ab736b26b2549bcebb25ab298972daaac369d","parsed":{"files":[{"path":"pkg/endpoint/policy.go","lines":["@@ -48,9 +48,21 @@ var ("," \terrPolicyComputationNotFound      = errors.New(\"policy computation result not found in statedb\")"," )"," ","-// PreviousMapState returns an empty policy.MapState with preallocated map sizes from the current one.","-func (e *Endpoint) PreviousMapState() *policy.MapState {","-\treturn e.desiredPolicy.GetMapState()","+// PreviousMapStateSizes returns the map sizes of the endpoint's current desired policy map state,","+// used as capacity hints when computing a new policy.","+//","+// The endpoint lock must not be held, as it is taken here to synchronize with the incremental","+// updates ApplyPolicyMapChanges applies to the current map state.","+func (e *Endpoint) PreviousMapStateSizes() policy.MapStateSizes {","+\tif err := e.rlockAlive(); err != nil {","+\t\treturn policy.MapStateSizes{}","+\t}","+\tdefer e.runlock()","+","+\tif e.desiredPolicy == nil {","+\t\treturn policy.MapStateSizes{}","+\t}","+\treturn e.desiredPolicy.GetMapState().Sizes()"," }"," "," // GetIngressNamedPort returns one port for the given name."],"additions":15,"deletions":3,"truncated":false},{"path":"pkg/endpoint/policy_race_test.go","lines":["@@ -0,0 +1,155 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package endpoint","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"sync\"","+\t\"testing\"","+","+\t\"github.com/cilium/hive/hivetest\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\tcmtypes \"github.com/cilium/cilium/pkg/clustermesh/types\"","+\t\"github.com/cilium/cilium/pkg/completion\"","+\t\"github.com/cilium/cilium/pkg/identity\"","+\t\"github.com/cilium/cilium/pkg/identity/identitymanager\"","+\tk8sConst \"github.com/cilium/cilium/pkg/k8s/apis/cilium.io\"","+\t\"github.com/cilium/cilium/pkg/labels\"","+\t\"github.com/cilium/cilium/pkg/policy\"","+\t\"github.com/cilium/cilium/pkg/policy/api\"","+\ttestcompute \"github.com/cilium/cilium/pkg/testutils/compute\"","+\ttestidentity \"github.com/cilium/cilium/pkg/testutils/identity\"","+\ttestpolicy \"github.com/cilium/cilium/pkg/testutils/policy\"","+)","+","+// TestPreviousMapStateSizesRace checks that PreviousMapStateSizes, which policy computation","+// calls with the endpoint unlocked, does not race with the incremental map changes","+// ApplyPolicyMapChanges applies to the endpoint's current desired policy. The named port in","+// the rule below makes the desired policy's map state maintain the identity index that both","+// sides touch. Run with -race.","+func TestPreviousMapStateSizesRace(t *testing.T) {","+\tpe := policy.GetPolicyEnabled()","+\tpolicy.SetPolicyEnabled(\"always\")","+\tdefer policy.SetPolicyEnabled(pe)","+","+\tlogger := hivetest.Logger(t)","+\tfakeAllocator := testidentity.NewMockIdentityAllocator(nil)","+\tidManager := identitymanager.NewIDManager(logger)","+\trepo := policy.NewPolicyRepository(logger, cmtypes.DefaultClusterInfo, fakeAllocator.GetIdentityCache(), nil, nil, idManager, testpolicy.NewPolicyMetricsNoop())","+\tpolComputer := testcompute.InstantiateCellForTesting(t, logger, \"endpoint-policy_race_test\", t.Name(), repo, idManager)","+","+\taddIdentity := func(labelKeys ...string) *identity.Identity {","+\t\tlbls := labels.Labels{}","+\t\tfor _, labelKey := range labelKeys {","+\t\t\tlbls[labelKey] = labels.NewLabel(\"k8s:\"+labelKey, \"\", \"\")","+\t\t}","+\t\tid, _, err := fakeAllocator.AllocateIdentity(context.Background(), lbls, false, 0)","+\t\tassert.NoError(t, err)","+\t\twg := &sync.WaitGroup{}","+\t\trepo.GetSelectorCache().UpdateIdentities(identity.IdentityMap{","+\t\t\tid.ID: id.LabelArray,","+\t\t}, nil, wg)","+\t\twg.Wait()","+\t\treturn id","+\t}","+","+\tpodID := addIdentity(\"pod\")","+\tidManager.Add(podID)","+","+\tep := Endpoint{","+\t\tpolicyRepo:       repo,","+\t\tpolicyFetcher:    polComputer,","+\t\tdesiredPolicy:    policy.NewEndpointPolicy(logger, repo),","+\t\tlabels:           labels.NewOpLabels(),","+\t\tSecurityIdentity: podID,","+\t\tidentityManager:  idManager,","+\t\tstatus:           NewEndpointStatus(),","+\t}","+\tep.UpdateLogger(nil)","+","+\t// Deny egress from the pod to all 'peer' identities. The named port makes the computed","+\t// policy maintain the map state identity index.","+\tegressDenyRule := &api.Rule{","+\t\tEndpointSelector: api.NewESFromLabels(labels.ParseSelectLabel(\"pod\")),","+\t\tEgressDeny: []api.EgressDenyRule{{","+\t\t\tEgressCommonRule: api.EgressCommonRule{","+\t\t\t\tToEndpoints: []api.EndpointSelector{","+\t\t\t\t\tapi.NewESFromLabels(labels.ParseSelectLabel(\"peer\")),","+\t\t\t\t},","+\t\t\t},","+\t\t\tToPorts: []api.PortDenyRule{{","+\t\t\t\tPorts: []api.PortProtocol{","+\t\t\t\t\t{Port: \"80\", Protocol: \"TCP\"},","+\t\t\t\t\t{Port: \"http-alt\", Protocol: \"TCP\"},","+\t\t\t\t},","+\t\t\t}},","+\t\t}},","+\t\tLabels: labels.LabelArray{","+\t\t\tlabels.NewLabel(k8sConst.PolicyLabelName, \"egressDenyRule\", labels.LabelSourceAny),","+\t\t},","+\t}","+\t_, rev := repo.MustAddList(api.Rules{egressDenyRule})","+\tcomputePolicyForEPAndWait(t, &ep, polComputer, rev)","+","+\tstats := new(regenerationStatistics)","+\tdatapathRegenCtxt := new(datapathRegenerationContext)","+\tdatapathRegenCtxt.policyRevisionToWaitFor = rev","+\trequire.NoError(t, ep.regeneratePolicy(stats, datapathRegenCtxt))","+\trequire.NoError(t, ep.lockAlive())","+\terr := ep.setDesiredPolicy(datapathRegenCtxt)","+\tep.unlock()","+\trequire.NoError(t, err)","+\trequire.True(t, ep.desiredPolicy.IsValid())","+","+\tconst numIdentities = 256","+","+\tvar wg sync.WaitGroup","+\twg.Add(2)","+\tdone := make(chan struct{})","+","+\t// Writer: allocate identities selected by the rule and apply the resulting incremental","+\t// map changes to the desired policy while holding the endpoint lock.","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tdefer close(done)","+\t\tcmp := completion.NewWaitGroup(context.Background())","+\t\tfor i := range numIdentities {","+\t\t\taddIdentity(\"peer\", fmt.Sprintf(\"peer%d\", i))","+\t\t\terr, _, finalizeFunc := ep.ApplyPolicyMapChanges(cmp)","+\t\t\tif !assert.NoError(t, err) {","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif finalizeFunc != nil {","+\t\t\t\tfinalizeFunc()","+\t\t\t}","+\t\t}","+\t}()","+","+\t// Reader: policy recomputation sizes the new map state after the current one with the","+\t// endpoint unlocked.","+\tgo func() {","+\t\tdefer wg.Done()","+\t\tfor {","+\t\t\tselect {","+\t\t\tcase <-done:","+\t\t\t\treturn","+\t\t\tdefault:","+\t\t\t\tep.PreviousMapStateSizes()","+\t\t\t}","+\t\t}","+\t}()","+","+\twg.Wait()","+","+\t// All the identity additions must have been applied to the desired policy.","+\trequire.GreaterOrEqual(t, ep.desiredPolicy.Len(), numIdentities)","+}","+","+// PreviousMapStateSizes must return zero sizes when the endpoint has no computed policy.","+func TestPreviousMapStateSizesNilPolicy(t *testing.T) {","+\trequire.Equal(t, policy.MapStateSizes{}, (&Endpoint{}).PreviousMapStateSizes())","+}"],"additions":155,"deletions":0,"truncated":false},{"path":"pkg/envoy/xds_server_test.go","lines":["@@ -65,7 +65,9 @@ func (m *listenerProxyUpdaterMock) PolicyDebug(string, ...any) {}"," "," func (m *listenerProxyUpdaterMock) IsHost() bool { return false }"," ","-func (m *listenerProxyUpdaterMock) PreviousMapState() *policy.MapState { return nil }","+func (m *listenerProxyUpdaterMock) PreviousMapStateSizes() policy.MapStateSizes {","+\treturn policy.MapStateSizes{}","+}"," "," func (m *listenerProxyUpdaterMock) RegenerateIfAlive(*regeneration.ExternalRegenerationMetadata) <-chan bool {"," \tch := make(chan bool)"],"additions":3,"deletions":1,"truncated":false},{"path":"pkg/policy/commands/mapstate_diff.go","lines":["@@ -512,8 +512,8 @@ func (o *dummyPolicyOwner) IsHost() bool {"," \treturn o.ep.I