ed when","+\t// the id index is in use; consumers must not distinguish nil from empty.","+\tbyId map[identity.NumericIdentity]int","+}","+","+// Sizes returns the map sizes of 'ms'. The caller must synchronize against any concurrent","+// modification of 'ms'.","+func (ms *mapState) Sizes() MapStateSizes {","+\tif ms == nil {","+\t\treturn MapStateSizes{}","+\t}"," ","-\tif old != nil {","-\t\tnEntries = len(old.entries)","+\tsizes := MapStateSizes{","+\t\tentries: ms.Len(),","+\t}","+\tif ms.byId != nil {","+\t\tsizes.byId = make(map[identity.NumericIdentity]int, len(ms.byId))","+\t\tfor id, keys := range ms.byId {","+\t\t\tsizes.byId[id] = len(keys)","+\t\t}"," \t}","+\treturn sizes","+}"," ","+// newMapState returns a new mapState with capacities from the given map sizes, according to the","+// given policy features.","+func newMapState(logger *slog.Logger, sizes MapStateSizes, features policyFeatures, clusterInfo cmtypes.ClusterInfo) mapState {"," \tms := mapState{"," \t\tlogger:      logger,"," \t\tclusterInfo: clusterInfo,","-\t\tentries:     make(mapStateMap, nEntries),","+\t\tentries:     make(mapStateMap, sizes.entries),"," \t\ttrie:        bitlpm.NewTrie[types.LPMKey, IDSet](types.MapStatePrefixLen),"," \t}"," "," \tif features&(passRules|namedPortRules) != 0 {","-\t\tif old == nil {","-\t\t\tms.byId = make(map[identity.NumericIdentity]LPMKeys)","-\t\t} else {","-\t\t\tms.byId = make(map[identity.NumericIdentity]LPMKeys, len(old.byId))","-\t\t\t// preallocate id index keysets to their current sizes, if any","-\t\t\tfor k, v := range old.byId {","-\t\t\t\tms.byId[k] = make(LPMKeys, len(v))","-\t\t\t}","+\t\tms.byId = make(map[identity.NumericIdentity]LPMKeys, len(sizes.byId))","+\t\t// preallocate id index keysets to their previous sizes, if any","+\t\tfor id, n := range sizes.byId {","+\t\t\tms.byId[id] = make(LPMKeys, n)"," \t\t}"," \t}"," \treturn ms"],"additions":35,"deletions":15,"truncated":false},{"path":"pkg/policy/mapstate_test.go","lines":["@@ -34