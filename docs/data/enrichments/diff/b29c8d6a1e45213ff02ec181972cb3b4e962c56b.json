{"id":"b29c8d6a1e45213ff02ec181972cb3b4e962c56b","axis":"silent","repo":"systemd/systemd","sha":"b29c8d6a1e45213ff02ec181972cb3b4e962c56b","parsed":{"files":[{"path":"man/systemd.exec.xml","lines":["@@ -2502,17 +2502,26 @@ BindReadOnlyPaths=/var/lib/systemd</programlisting>","         activation with socket units, see","         <citerefentry><refentrytitle>systemd.socket</refentrytitle><manvolnum>5</manvolnum></citerefentry>)","         are unaffected. Also, sockets created with <function>socketpair()</function> (which creates connected","-        AF_UNIX sockets) or the","-        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>","-        functions, are not affected. Thus, it is recommended to combined this setting with","+        AF_UNIX sockets) are not affected. Thus, it is recommended to combine this setting with","         <varname>SystemCallFilter=@service</varname>, to only allow a limited subset of system calls.</para>"," ","-        <para>Note that this option is limited to some ABIs, in particular x86-64, but currently has no","-        effect on 32-bit x86, s390, s390x, mips, mips-le, ppc, ppc-le, ppc64, or ppc64-le, and is ignored. On","-        systems supporting multiple ABIs (such as x86/x86-64) it is recommended to turn off alternative ABIs","-        for services, so that they cannot be used to circumvent the restrictions of this option.","-        Specifically, it is recommended to combine this option with","-        <varname>SystemCallArchitectures=native</varname> or similar. </para>","+        <para>On kernels that support io_uring BPF filters (Linux 7.0 and newer), this setting also applies","+        to sockets created with the <constant>IORING_OP_SOCKET</constant> operation of","+        <citerefentry project='man-pages'><refentrytitle>io_uring</refentrytitle><manvolnum>7</manvolnum></citerefentry>.","+        Such requests fail with <constant>EACCES</constant> for denied address families. The restriction","+        applies to all io_uring instances that the processes of the unit create, but not to io_uring","+        instances that they receive from other processes. On such kernels,","+        <constant>IORING_REGISTER_RESTRICTIONS</constant> without an io_uring instance fails with","+        <constant>EPERM</constant> for the processes of the unit. On older kernels, sockets created with","+        io_uring are not affected.</para>","+","+        <para>Note that the system call restriction of this option is limited to some ABIs, in particular","+        x86-64, but currently has no effect on 32-bit x86, s390, s390x, mips, mips-le, ppc, ppc-le, ppc64, or","+        ppc64-le, and is ignored. The io_uring restriction applies on all ABIs. On systems supporting","+        multiple ABIs (such as x86/x86-64) it is recommended to turn off alternative ABIs for services, so","+        that they cannot be used to circumvent the restrictions of this option. Specifically, it is","+        recommended to combine this option with <varname>SystemCallArchitectures=native</varname> or similar.","+        </para>"," ","         <xi:include href=\"version-info.xml\" xpointer=\"v211\"/></listitem>","       </varlistentry>"],"additions":18,"deletions":9,"truncated":false},{"path":"src/core/exec-invoke.c","lines":["@@ -49,6 +49,7 @@"," #include \"hexdecoct.h\""," #include \"hostname-setup.h\""," #include \"image-policy.h\"","+#include \"io-uring-filter.h\""," #include \"io-util.h\""," #include \"iovec-util.h\""," #include \"journal-send.h\"","@@ -1743,20 +1744,6 @@ static void rename_process_from_path(const char *path) {","         (void) rename_process_full(comm, invocation ?: comm);"," }"," ","-static bool context_has_address_families(const ExecContext *c) {","-        assert(c);","-","-        return c->address_families_allow_list ||","-                !set_isempty(c->address_families);","-}","-","-static bool context_has_syscall_filters(const ExecContext *c) {","-        assert(c);","-","-        return c->syscall_allow_list ||","-                !hashmap_isempty(c->syscall_filter);","-}","-"," static bool context_has_syscall_logs(const ExecContext *c) {","         assert(c);"," ","@@ -1776,12 +1763,12 @@ static bool context_has_seccomp(const ExecContext *c) {","                 c->protect_kernel_tunables ||","                 c->protect_kernel_modules ||","                 c->protect_kernel_logs ||","-                context_has_address_families(c) ||","+                exec_context_has_address_families(c) ||","                 exec_context_restrict_namespaces_set(c) ||","                 c->restrict_realtime ||","                 c->restrict_suid_sgid ||","                 !set_isempty(c->syscall_archs) ||","-                context_has_syscall_filters(c) ||","+                exec_context_has_syscall_filters(c) ||","                 context_has_syscall_logs(c);"," }"," ","@@ -1797,6 +1784,28 @@ static bool context_has_no_new_privileges(const ExecContext *c) {","         return context_has_seccomp(c);"," }"," ","+static bool check_io_uring_bpf_filters(const char *setting) {","+        assert(setting);","+","+        if (!p->io_uring_bpf_filter_supported)","+                log_debug(\"io_uring BPF filters are not supported, not applying %s to io_uring requests.\", setting);","+","+        return p->io_uring_bpf_filter_supported;","+}","+","+static int apply_io_uring_address_families(const ExecContext *c, const ExecParameters *p) {","+        assert(c);","+        assert(p);","+","+        if (!exec_context_has_address_families(c))","+                return 0;","+","+        if (!check_io_uring_bpf_filters(\"RestrictAddressFamilies=\"))","+                return 0;","+","+        return io_uring_restrict_address_families(c->address_families, c->address_families_allow_list);","+}","+"," #if HAVE_SECCOMP"," "," static bool seccomp_allows_drop_privileges(const ExecContext *c) {","@@ -1849,7 +1858,7 @@ static int apply_syscall_filter(const ExecContext *c, const ExecParameters *p) {","         assert(c);","         assert(p);"," ","-        if (!context_has_syscall_filters(c))","+        if (!exec_context_has_syscall_filters(c))","                 return 0;"," ","         if (skip_seccomp_unavailable(\"SystemCallFilter=\"))","@@ -1925,7 +1934,7 @@ static int apply_address_families(const ExecContext *c, const ExecParameters *p)","         assert(c);","         assert(p);"," ","-        if (!context_has_address_families(c))","+        if (!exec_context_has_address_families(c))","                 return 0;"," ","         if (skip_seccomp_unavailable(\"RestrictAddressFamilies=\"))","@@ -6940,6 +6949,14 @@ int exec_invoke(","                 }"," #endif"," ","+                /* The io_uring filters have to be registered before the system call filter, because the","+                 * system call filter can deny io_uring_register(). */","+                r = apply_io_uring_address_families(context, params);","+                if (r < 0) {","+                        *exit_status = EXIT_ADDRESS_FAMILIES;","+                        return log_error_errno(r, \"Failed to restrict address families of io_uring sockets: %m\");","+                }","+"," #if HAVE_SECCOMP","                 /* This really should remain as close to the execve() as possible, to make sure our own code is affected","                  * by the filter as little as possible. */"],"additions":35,"deletions":18,"truncated":false},{"path":"src/core/execute-serialize.c","lines":["@@ -1121,6 +1121,10 @@ static int exec_parameters_serialize(const ExecParameters *p, const ExecContext","                         return r;","         }"," ","+        r = serialize_bool_elide(f, \"exec-parameters-io-uring-bpf-filter-supported\", p->io_uring_bpf_filter_supported);","+        if (r < 0)","+                return r;","+","         r = serialize_bool_elide(f, \"exec-parameters-selinux-context-net\", p->selinux_context_net);","         if (r < 0)","                 return r;","@@ -1336,6 +1340,12 @@ static int exec_parameters_deserialize(ExecParameters *p, FILE *f, FDSet *fds) {","                         if (r < 0)","                                 return r;","                         p->flags = flags;","+                } else if ((val = startswith(l, \"exec-parameters-io-uring-bpf-filter-supported=\"))) {","+                        r = parse_boolean(val);","+                        if (r < 0)","+                                return r;","+","+                        p->io_uring_bpf_filter_supported = r;","                 } else if ((val = startswith(l, \"exec-parameters-selinux-context-net=\"))) {","                         r = parse_boolean(val);","                         if (r < 0)"],"additions":10,"deletions":0,"truncated":false},{"path":"src/core/execute.c","lines":["@@ -35,6 +35,7 @@"," #include \"glob-util.h\""," #include \"hexdecoct.h\""," #include \"image-policy.h\"","+#include \"io-uring-filter.h\""," #include \"io-util.h\""," #include \"ioprio-util.h\""," #include \"log.h\"","@@ -462,6 +463,20 @@ static void log_command_line(Unit *unit, const char *msg, const char *executable"," "," static int exec_context_load_environment(const Unit *unit, const ExecContext *c, char ***ret);"," ","+bool exec_context_has_address_families(const ExecContext *c) {","+        assert(c);","+","+        return c->address_families_allow_list ||","+                !set_isempty(c->address_families);","+}","+","+bool exec_context_has_syscall_filters(const ExecContext *c) {","+        assert(c);","+","+        return c->syscall_allow_list ||","+                !hashmap_isempty(c->syscall_filter);","+}","+"," int exec_spawn(","                 Unit *unit,","                 ExecCommand *command,","@@ -489,6 +504,17 @@ int exec_spawn("," ","         LOG_CONTEXT_PUSH_UNIT(unit);"," ","+        /* CLONE_INTO_CGROUP applies TasksMax= before the executor can fork a probe. */","+        if (FLAGS_SET(params->flags, EXEC_APPLY_SANDBOXING) &&","+            !FLAGS_SET(command->flags, EXEC_COMMAND_FULLY_PRIVILEGED) &&","+            (exec_context_has_address_families(context) ||","+             context->restrict_suid_sgid || exec_context_has_syscall_filters(context))) {","+                r = io_uring_bpf_filter_supported();","+                if (r < 0)","+                        return log_unit_error_errno(unit, r, \"Failed to check whether io_uring BPF filters are supported: %m\");","+                params->io_uring_bpf_filter_supported = r;","+        }","+","         r = exec_context_load_environment(unit, context, &params->files_env);","         if (r < 0)","                 return log_unit_error_errno(unit, r, \"Failed to load environment files: %m\");"],"additions":26,"deletions":0,"truncated":false},{"path":"src/core/execute.h","lines":["@@ -474,6 +474,7 @@ typedef struct ExecParameters {"," ","         bool debug_invocation;","         bool selinux_context_net;","+        bool io_uring_bpf_filter_supported;"," } ExecParameters;"," "," #define EXEC_PARAMETERS_INIT(_flags)              \\","@@ -620,6 +621,8 @@ char** exec_context_get_syscall_archs(const ExecContext *c);"," char** exec_context_get_syscall_log(const ExecContext *c);"," char** exec_context_get_address_families(const ExecContext *c);"," char** exec_context_get_restrict_filesystems(const ExecContext *c);","+bool exec_context_has_address_families(const ExecContext *c);","+bool exec_context_has_syscall_filters(const ExecContext *c);"," bool exec_context_restrict_namespaces_set(const ExecContext *c);"," bool exec_context_restrict_filesystems_set(const ExecContext *c);"," bool exec_context_with_rootfs(const ExecContext *c);"],"additions":3,"deletions":0,"truncated":false},{"path":"test/units/TEST-07-PID1.io-uring.sh","lines":["@@ -0,0 +1,135 @@","+#!/usr/bin/env bash","+# SPDX-License-Identifier: LGPL-2.1-or-later","+set -eux","+set -o pipefail","+","+# NSS modules built with ASan can fail to load in the unsanitized Python process.","+if [[ -v ASAN_OPTIONS ]]; then","+    echo \"ASan NSS modules cannot be loaded reliably by python3, skipping\" >&2","+    exit 77","+fi","+","+if ! command -v python3 >/dev/null; then","+    echo \"python3 not available, skipping\" >&2","+    exit 77","+fi","+","+HELPER=\"$(mktemp /var/tmp/io-uring-XXXXXX.py)\"","+chmod 0644 \"$HELPER\"","+","+at_exit() {","+    set +e","+    rm -f \"$HELPER\"","+}","+","+trap at_exit EXIT","+","+# The helper submits a single io_uring request and prints the result of its completion, which is a negative","+# errno number on failure. If io_uring_setup() fails, the helper prints \"setup\" and the negative errno number.","+cat >\"$HELPER\" <<'EOF'","+import ctypes","+import mmap","+import os","+import socket","+import struct","+import sys","+","+libc = ctypes.CDLL(None, use_errno=True)","+libc.syscall.restype = ctypes.c_long","+","+NR_IO_URING_SETUP = 425","+NR_IO_URING_ENTER = 426","+NR_IO_URING_REGISTER = 427","+IORING_REGISTER_BPF_FILTER = 37","+IORING_ENTER_GETEVENTS = 1","+IORING_OFF_SQ_RING = 0","+IORING_OFF_CQ_RING = 0x8000000","+IORING_OFF_SQES = 0x10000000","+","+IORING_OP_NOP = 0","+IORING_OP_SOCKET = 45","+","+class Params(ctypes.Structure):","+    _fields_ = [","+        (\"sq_entries\", ctypes.c_uint32),","+        (\"cq_entries\", ctypes.c_uint32),","+        (\"flags\", ctypes.c_uint32),","+        (\"sq_thread_cpu\", ctypes.c_uint32),","+        (\"sq_thread_idle\", ctypes.c_uint32),","+        (\"features\", ctypes.c_uint32),","+        (\"wq_fd\", ctypes.c_uint32),","+        (\"resv\", ctypes.c_uint32 * 3),","+        (\"sq_off\", ctypes.c_uint32 * 10),","+        (\"cq_off\", ctypes.c_uint32 * 10),","+    ]","+","+def u32(m, offset):","+    return struct.unpack_from(\"=I\", m, offset)[0]","+","+def submit(opcode, fd=0, off=0, addr=0, length=0, op_flags=0):","+    params = Params()","+    ring = libc.syscall(NR_IO_URING_SETUP, 1, ctypes.byref(params))","+    if ring < 0:","+        print(f\"setup {-ctypes.get_errno()}\")","+        return","+","+    sq_off, cq_off = params.sq_off, params.cq_off","+    sq = mmap.mmap(ring, sq_off[6] + params.sq_entries * 4, offset=IORING_OFF_SQ_RING)","+    cq = mmap.mmap(ring, cq_off[5] + params.cq_entries * 16, offset=IORING_OFF_CQ_RING)","+    sqes = mmap.mmap(ring, params.sq_entries * 64, offset=IORING_OFF_SQES)","+","+    tail = u32(sq, sq_off[1])","+    index = tail & u32(sq, sq_off[2])","+    struct.pack_into(\"=BBHiQQIIQHHiQQ\", sqes, index * 64,","+                     opcode, 0, 0, fd, off, addr, length, op_flags, 0, 0, 0, 0, 0, 0)","+    struct.pack_into(\"=I\", sq, sq_off[6] + index * 4, index)","+    struct.pack_into(\"=I\", sq, sq_off[1], tail + 1)","+","+    if libc.syscall(NR_IO_URING_ENTER, ring, 1, 1, IORING_ENTER_GETEVENTS, None, 0) < 0:","+        sys.exit(f\"io_uring_enter() failed: {os.strerror(ctypes.get_errno())}\")","+","+    head = u32(cq, cq_off[0])","+    _, res, _ = struct.unpack_from(\"=QiI\", cq, cq_off[5] + (head & u32(cq, cq_off[2])) * 16)","+    print(res)","+","+command = sys.argv[1]","+if command == \"probe\":","+    # The kernel reads the filter only after it checked that it supports task filters.","+    r = libc.syscall(NR_IO_URING_REGISTER, -1, IORING_REGISTER_BPF_FILTER, None, 1)","+    print(\"supported\" if r < 0 and ctypes.get_errno() == 14 else \"unsupported\")","+elif command == \"nop\":","+    submit(IORING_OP_NOP)","+elif command == \"socket\":","+    family = {\"unix\": socket.AF_UNIX, \"inet\": socket.AF_INET, \"inet6\": socket.AF_INET6}[sys.argv[2]]","+    submit(IORING_OP_SOCKET, fd=family, off=socket.SOCK_DGRAM | socket.SOCK_CLOEXEC)","+else:","+    sys.exit(f\"Unknown command {command}\")","+EOF","+","+run() {","+    systemd-run --wait --pipe --quiet \"$@\"","+}","+","+# LimitNPROC= counts every process with the same UID, so the test needs a separate user.","+run -p DynamicUser=yes -p User=io-uring-limits -p LimitNPROC=1 -p RestrictAddressFamilies=AF_UNIX true","+run -p TasksMax=1 -p RestrictAddressFamilies=AF_UNIX true","+","+if [[ \"$(run python3 \"$HELPER\" probe)\" != \"supported\" ]]; then","+    echo \"kernel does not support io_uring BPF filters, skipping\" >&2","+    exit 77","+fi","+","+EACCES=-13","+","+[[ \"$(run python3 \"$HELPER\" nop)\" == 0 ]]","+(( $(run python3 \"$HELPER\" socket inet) >= 0 ))","+","+# RestrictAddressFamilies= applies to IORING_OP_SOCKET.","+[[ \"$(run -p RestrictAddressFamilies=AF_UNIX python3 \"$HELPER\" socket inet)\" == \"$EACCES\" ]]","+[[ \"$(run -p RestrictAddressFamilies=AF_UNIX python3 \"$HELPER\" socket inet6)\" == \"$EACCES\" ]]","+(( $(run -p RestrictAddressFamilies=AF_UNIX python3 \"$HELPER\" socket unix) >= 0 ))","+[[ \"$(run -p RestrictAddressFamilies=~AF_INET python3 \"$HELPER\" socket inet)\" == \"$EACCES\" ]]","+(( $(run -p RestrictAddressFamilies=~AF_INET python3 \"$HELPER\" socket inet6) >= 0 ))","+","+# Services that run as an unprivileged user get the filters as well.","+[[ \"$(run -p User=testuser -p RestrictAddressFamilies=AF_UNIX python3 \"$HELPER\" socket inet)\" == \"$EACCES\" ]]",""],"additions":135,"deletions":0,"truncated":false}],"additions":227,"deletions":27,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-04T16:06:57.941914+00:00"}