(), initialization.context() );","+\t\t\t\t// Factory bootstrap has already called descriptor initialize followed by annotation initialize.","+\t\t\t\tassertSame( compiledPattern( initialization.validator() ), cached );","+\t\t\t\tboolean matchedPatternValidator = false;","+\t\t\t\tfor ( PatternValidator validator : recorder.patterns ) {","+\t\t\t\t\tmatchedPatternValidator |= compiledPattern( validator ) == cached;","+\t\t\t\t}","+\t\t\t\tassertTrue( matchedPatternValidator, \"Pattern and URL must reuse the same compiled Pattern\" );","+","+\t\t\t\tHibernateConstraintValidator<URL, CharSequence> alternative = regexpValidator ? new URLValidator() : new RegexpURLValidator();","+\t\t\t\talternative.initialize( initialization.descriptor(), initialization.context() );","+\t\t\t\talternative.initialize( annotation );","+\t\t\t\tassertSame( compiledPattern( alternative ), cached, \"Both supplied URL validators must use the context cache\" );","+\t\t\t\tassertTrue( alternative.isValid( \"http://example.com/path\", null ) );","+","+\t\t\t\tif ( annotation.regexp().equals( SharedRegexURLs.REGEXP ) ) {","+\t\t\t\t\tif ( annotation.flags().length == 0 ) {","+\t\t\t\t\t\tshared = cached;","+\t\t\t\t\t}","+\t\t\t\t\telse {","+\t\t\t\t\t\totherFlags = cached;","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\telse {","+\t\t\t\t\totherRegexp = cached;","+\t\t\t\t}","+\t\t\t}","+\t\t\tassertTrue( shared != null && otherFlags != null && otherRegexp != null );","+\t\t\tassertNotSame( shared, otherRegexp, \"Cache keys must include the regular expression\" );","+\t\t\tassertNotSame( shared, otherFlags, \"Cache keys must include requested flags\" );","+\t\t\tassertEquals( shared.flags(), otherFlags.flags(), \"Embedded flags expand the compiled flags independently of the cache key\" );","+\t\t\treturn shared;","+\t\t}","+\t}","+","+\tprivate static java.util.regex.Pattern compiledPattern(Object validator) throws Exception {","+\t\tClass<?> type = validator instanceof PatternValidator ? PatternValida