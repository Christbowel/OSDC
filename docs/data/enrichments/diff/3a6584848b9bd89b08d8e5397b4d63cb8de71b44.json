.CompressionPool;","+","+/**","+ * <p>A pool of {@link ZstdCompressCtx} instances.</p>","+ * <p>A {@link ZstdCompressCtx} allocates its native workspace on its first compression,","+ * and keeps it across {@link ZstdCompressCtx#reset() resets}; pooling the contexts avoids","+ * allocating and freeing that workspace (several MiB at the default level) for each response.</p>","+ */","+public class ZstandardCompressCtxPool extends CompressionPool<ZstdCompressCtx>","+{","+    public static final int DEFAULT_CAPACITY = 32;","+","+    /**","+     * <p>Create a Pool of {@link ZstdCompressCtx} instances.</p>","+     * <p>If given a capacity equal to zero the contexts will not be pooled","+     * and will be created on acquire and closed on release.</p>","+     *","+     * @param capacity maximum number of contexts which can be contained in the pool","+     */","+    public ZstandardCompressCtxPool(int capacity)","+    {","+        super(capacity);","+    }","+","+    @Override","+    protected ZstdCompressCtx newPooled()","+    {","+        return new ZstdCompressCtx();","+    }","+","+    @Override","+    protected void end(ZstdCompressCtx compressCtx)","+    {","+        compressCtx.close();","+    }","+","+    @Override","+    protected void reset(ZstdCompressCtx compressCtx)","+    {","+        // Resets both the session and the parameters,","+        // but retains the native workspace.","+        compressCtx.reset();","+    }","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"jetty-core/jetty-compression/jetty-compression-zstandard/src/main/java/org/eclipse/jetty/compression/zstandard/internal/ZstandardEncoderSink.java","lines":["@@ -27,6 +27,7 @@"," import org.eclipse.jetty.io.RetainableByteBuffer;"," import org.eclipse.jetty.util.BufferUtil;"," import org.eclipse.jetty.util.Callback;","+import org.eclipse.jetty.util.compression.CompressionPool;"," import org.eclipse.jetty.util.thread.Invocable;"," import org.slf4j.Logger;"," import org.slf4j.LoggerFactory;","@@ -52,13 +53,15 @@ private enum State","     private final AtomicReference<State> state = new AtomicReference<>(State.CONTINUE);","     private final Cleaner.Cleanable cleanable;"," ","-    public ZstandardEncoderSink(ZstandardCompression compression, Content.Sink sink, ZstandardEncoderConfig config)","+    public ZstandardEncoderSink(ZstandardCompression compression, ZstandardCompressCtxPool compressCtxPool, Content.Sink sink, ZstandardEncoderConfig config)","     {","         super(sink);","         this.compression = compression;","         this.bufferSize = config.getBufferSize();","-        this.compressCtx = new ZstdCompressCtx();","-        this.cleanable = compression.getCleaner().register(this, compressCtx::close);","+        CompressionPool<ZstdCompressCtx>.Entry compressCtxEntry = compressCtxPool.acquire();","+        this.compressCtx = compressCtxEntry.get();","+        // Return the context to the pool also if this sink is never released.","+        this.cleanable = compression.getCleaner().register(this, compressCtxEntry::release);","         this.compressCtx.setLevel(config.getCompressionLevel());","         if (config.getStrategy() >= 0)","             this.compressCtx.setStrategy(config.getStrategy());","@@ -69,6 +72,8 @@ public ZstandardEncoderSink(ZstandardCompression compression, Content.Sink sink,","     @Override","     protected void release()","     {","+        // The context must not be used once returned to the pool.","+        state.set(State.FINISHED);","         cleanable.clean();","     }"," "],"additions":8,"deletions":3,"truncated":false},{"path":"jetty-core/jetty-compression/jetty-compression-zstandard/src/test/java/org/eclipse/jetty/compression/zstandard/ZstandardEncoderSinkTest.java","lines":["@@ -20,11 +20,14 @@"," import java.nio.file.Path;"," import java.util.Random;"," import java.util.concurrent.ExecutionException;","+import java.util.concurrent.atomic.AtomicBoolean;"," import java.util.stream.Stream;"," ","+import org.eclipse.jetty.compression.zstandard.internal.ZstandardCompressCtxPool;"," import org.eclipse.jetty.io.Content;"," import org.eclipse.jetty.toolchain.test.MavenPaths;"," import org.eclipse.jetty.util.Callback;","+import org.eclipse.jetty.util.Pool;"," import org.junit.jupiter.api.Test;"," import org.junit.jupiter.params.ParameterizedTest;"," import org.junit.jupiter.params.provider.Arguments;","@@ -33,6 +36,7 @@"," import static java.nio.charset.StandardCharsets.UTF_8;"," import static org.hamcrest.MatcherAssert.assertThat;"," import static org.hamcrest.Matchers.is;","+import static org.hamcrest.Matchers.nullValue;"," import static org.junit.jupiter.api.Assertions.assertArrayEquals;"," import static org.junit.jupiter.api.Assertions.assertEquals;"," import static org.junit.jupiter.api.Assertions.assertInstanceOf;","@@ -194,4 +198,141 @@ public void testLargeDirectBuffer(int dataSize, int bufferSize, int startOffset)","         byte[] decompressed = decompress(compressed);","         assertArrayEquals(originalData, decompressed);","     }","+","+    @Test","+    public void testCompressCtxIsPooled() throws Exception","+    {","+        startZstd();","+        Pool<?> compressCtxPool = zstd.getCompressCtxPool().getPool();","+","+        String text = \"Hello World! \".repeat(1000);","+        for (int i = 0; i < 10; i++)","+        {","+            // Alternate the configuration, to verify that the parameters","+            // of a pooled context do not leak into the next response.","+            boolean checksum = i % 2 == 0;","+            ZstandardEncoderConfig config = new ZstandardEncoderConfig();","+            config.setCompressionLevel(checksum ? 1 : 19);","+            config.setChecksum(checksum);","+","+            try (ByteArrayOutputStream baos = new ByteArrayOutputStream())","+            {","+                Content.Sink encoderSink = zstd.newEncoderSink(Content.Sink.from(baos), config);","+                Callback.Completable callback = new Callback.Completable();","+                encoderSink.write(true, ByteBuffer.wrap(text.getBytes(UTF_8)), callback);","+                callback.get();","+                byte[] compressed = baos.toByteArray();","+                assertThat(new String(decompress(compressed), UTF_8), is(text));","+                // The Frame_Header_Descriptor follows the 4 bytes of the magic number,","+                // and its bit 2 is the Content_Checksum_flag (RFC 8878, section 3.1.1.1.1).","+                boolean frameChecksum = (compressed[4] & 0x04) != 0;","+                assertThat(frameChecksum, is(checksum));","+            }","+","+            // The writes are synchronous, so the context has been returned to the pool, to be reused.","+            assertThat(compressCtxPool.getIdleCount(), is(1));","+            assertThat(compressCtxPool.size(), is(1));","+        }","+    }","+","+    @Test","+    public void testNewEncoderSinkWhenNotStarted() throws Exception","+    {","+        zstd = new ZstandardCompression();","+        zstd.setByteBufferPool(pool);","+        Content.Sink sink = Content.Sink.from(new ByteArrayOutputStream());","+        assertThrows(IllegalStateException.class, () -> zstd.newEncoderSink(sink));","+","+        zstd.start();","+        zstd.stop();","+        assertThrows(IllegalStateException.class, () -> zstd.newEncoderSink(sink));","+    }","+","+    @Test","+    public void testCompressCtxIsResetAfterFailedEncoding() throws Exception","+    {","+        startZstd();","+        Pool<?> compressCtxPool = zstd.getCompressCtxPool().getPool();","+","+        byte[] data = new byte[64 * 1024];","+        new Random(42).nextBytes(data);","+","+        // Start encoding a response, but fail it before its end.","+        try (ByteArrayOutputStream baos = new ByteArrayOutputStream())","+        {","+            Content.Sink sink = Content.Sink.from(baos);","+            AtomicBoolean fail = new AtomicBoolean();","+            Content.Sink failingSink = (last, byteBuffer, callback) ->","+            {","+                if (fail.get())","+                    callback.failed(new Exception(\"test\"));","+                else","+                    sink.write(last, byteBuffer, callback);","+            };","+            Content.Sink encoderSink = zstd.newEncoderSink(failingSink);","+            Callback.Completable callback1 = new Callback.Completable();","+            encoderSink.write(false, ByteBuffer.wrap(data), callback1);","+            callback1.get();","+","+            fail.set(true);","+            Callback.Completable callback2 = new Callback.Completable();","+            encoderSink.write(true, ByteBuffer.wrap(data), callback2);","+            assertThrows(ExecutionException.class, callback2::get);","+        }","+        assertThat(compressCtxPool.getIdleCount(), is(1));","+","+        // The next response reuses the same context, and must be a complete and valid frame.","+        try (ByteArrayOutputStream baos = new ByteArrayOutputStream())","+        {","+            Content.Sink encoderSink = zstd.newEncoderSink(Content.Sink.from(baos));","+            Callback.Completable callback = new Callback.Completable();","+            encoderSink.write(true, ByteBuffer.wrap(\"Hello World!\".getBytes(UTF_8)), callback);","+            callback.get();","+            assertThat(new String(decompress(baos.toByteArray()), UTF_8), is(\"Hello World!\"));","+        }","+        assertThat(compressCtxPool.getIdleCount(), is(1));","+        assertThat(compressCtxPool.size(), is(1));","+    }","+","+    @Test","+    public void testCompressCtxPoolCapacity() throws Exception","+    {","+        zstd = new ZstandardCompression();","+        zstd.setByteBufferPool(pool);","+        zstd.start();","+        assertThat(zstd.getCompressCtxPoolCapacity(), is(-1));","+        ZstandardCompressCtxPool defaultCompressCtxPool = zstd.getCompressCtxPool();","+        assertThat(defaultCompressCtxPool.getCapacity(), is(ZstandardCompressCtxPool.DEFAULT_CAPACITY));","+        zstd.stop();","+        // The pool belongs to this instance, so it is stopped with it.","+        assertThat(defaultCompressCtxPool.isStopped(), is(true));","+","+        zstd.setCompressCtxPoolCapacity(7);","+        zstd.start();","+","+        assertThat(zstd.getCompressCtxPool().getCapacity(), is(7));","+        assertThrows(IllegalStateException.class, () -> zstd.setCompressCtxPoolCapacity(8));","+        assertThat(zstd.getCompressCtxPoolCapacity(), is(7));","+    }","+","+    @Test","+    public void testCompressCtxPoolDisabled() throws Exception","+    {","+        zstd = new ZstandardCompression();","+        zstd.setByteBufferPool(pool);","+        zstd.setCompressCtxPoolCapacity(0);","+        zstd.start();","+","+        try (ByteArrayOutputStream baos = new ByteArrayOutputStream())","+        {","+            Content.Sink encoderSink = zstd.newEncoderSink(Content.Sink.from(baos));","+            Callback.Completable callback = new Callback.Completable();","+            encoderSink.write(true, ByteBuffer.wrap(\"Hello World!\".getBytes(UTF_8)), callback);","+            callback.get();","+            assertThat(new String(decompress(baos.toByteArray()), UTF_8), is(\"Hello World!\"));","+        }","+","+        // No pool, so the context has been closed rather than pooled.","+        assertThat(zstd.getCompressCtxPool().getPool(), nullValue());","+    }"," }",""],"additions":141,"deletions":0,"truncated":false}],"additions":274,"deletions":4,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-12T17:13:59.041763+00:00"}