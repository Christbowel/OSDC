{"id":"5b1a96f0fa54b54941904006744cb8200378e2f6","axis":"silent","repo":"ansible/ansible","sha":"5b1a96f0fa54b54941904006744cb8200378e2f6","parsed":{"files":[{"path":"changelogs/fragments/show-content-redact-chain.yml","lines":["@@ -0,0 +1,6 @@","+bugfixes:","+  - >-","+    errors - when any exception in an error's cause chain was raised with ``show_content=False``, the annotated source lines are now redacted","+    for every exception in the chain, not just the one that requested it. Previously the outer exceptions wrapping it, such as the task or template","+    error, still displayed the source lines and could reveal the content the inner error deemed sensitive. The origin (file, line, and column) is still","+    shown so the error can be located."],"additions":6,"deletions":0,"truncated":false},{"path":"lib/ansible/_internal/_errors/_error_factory.py","lines":["@@ -87,3 +87,17 @@ def _get_events(self, exception: BaseException) -> tuple[_messages.Event, ...] |","             return tuple(self._convert_exception(ex) for ex in exception.exceptions)"," ","         return None","+","+    def _get_redact_source_context(self, exception: BaseException) -> bool:","+        from ansible.errors import AnsibleError","+","+        if isinstance(exception, AnsibleError):","+            return not exception._show_content","+","+        return False","+","+    def _set_redact_source_context(self, exception: BaseException) -> None:","+        from ansible.errors import AnsibleError","+","+        if isinstance(exception, AnsibleError):","+            exception._show_content = False"],"additions":14,"deletions":0,"truncated":false},{"path":"lib/ansible/_internal/_errors/_error_utils.py","lines":["@@ -65,7 +65,7 @@ def from_value(cls, value: t.Any) -> SourceContext | None:","             origin = Origin.get_tag(value)"," ","         if RedactAnnotatedSourceContext.current(optional=True):","-            return cls.error('content redacted')","+            return cls.error('content redacted', origin)"," ","         if origin and origin.path:","             return cls.from_origin(origin)"],"additions":1,"deletions":1,"truncated":false},{"path":"lib/ansible/module_utils/_internal/_errors.py","lines":["@@ -39,13 +39,26 @@ def _convert_exception(self, exception: BaseException) -> _messages.Event:","         self._depth += 1"," ","         try:","+            chain = self._get_chain(exception)","+            events = self._get_events(exception)","+","+            redact_source_context = (","+                self._get_redact_source_context(exception)","+                or bool(chain and chain.event.redact_source_context)","+                or bool(events and any(evt.redact_source_context for evt in events))","+            )","+","+            if redact_source_context:","+                self._set_redact_source_context(exception)","+","             return _messages.Event(","                 msg=self._get_msg(exception),","                 formatted_traceback=self._get_formatted_traceback(exception),","                 formatted_source_context=self._get_formatted_source_context(exception),","                 help_text=self._get_help_text(exception),","-                chain=self._get_chain(exception),","-                events=self._get_events(exception),","+                chain=chain,","+                events=events,","+                redact_source_context=redact_source_context,","             )","         finally:","             self._depth -= 1","@@ -99,3 +112,16 @@ def _get_context(self, exception: BaseException) -> BaseException | None:","     def _get_events(self, exception: BaseException) -> tuple[_messages.Event, ...] | None:","         # deprecated: description='move BaseExceptionGroup support here from ControllerEventFactory' python_version='3.10'","         return None","+","+    def _get_redact_source_context(self, exception: BaseException) -> bool:","+        \"\"\"","+        Return True if the exception's source context should be redacted, otherwise False.","+        This will always be False for exception types that do not support source context.","+        \"\"\"","+        return False","+","+    def _set_redact_source_context(self, exception: BaseException) -> None:","+        \"\"\"","+        Mark the exception as needing to have its source context redacted.","+        This has no effect if the exception type does not support source context.","+        \"\"\""],"additions":28,"deletions":2,"truncated":false},{"path":"lib/ansible/module_utils/_internal/_messages.py","lines":["@@ -80,6 +80,7 @@ def __post_init__(self): ...  # required for deferred dataclass validation","     help_text: _t.Optional[str] = None","     chain: _t.Optional[EventChain] = None","     events: _t.Optional[_t.Tuple[Event, ...]] = None","+    redact_source_context: bool = False"," "," "," _dataclass_validation.inject_post_init_validation(EventChain, EventChain._validation_allow_subclasses)"],"additions":1,"deletions":0,"truncated":false},{"path":"lib/ansible/plugins/filter/core.py","lines":["@@ -57,7 +57,7 @@ def register_secret(","     if not isinstance(secret, str):","         msg = \"Secret must be a string\"","         if validation_action == 'error':","-            raise ValueError(msg)","+            raise AnsibleTemplatePluginError(msg, show_content=False)","         elif validation_action == 'warn':","             display.warning(msg)"," ","@@ -67,7 +67,7 @@ def register_secret(","     if len(trimmed_secret) < _SECRET_MINIMUM_LENGTH:","         msg = f\"Secret must be at least {_SECRET_MINIMUM_LENGTH} characters long after trimming whitespace\"","         if validation_action == 'error':","-            raise ValueError(msg)","+            raise AnsibleTemplatePluginError(msg, show_content=False)","         elif validation_action == 'warn':","             display.warning(msg)"," "],"additions":2,"deletions":2,"truncated":false},{"path":"lib/ansible/utils/display.py","lines":["@@ -841,10 +841,11 @@ def error_as_warning(","         event = _error_factory.ControllerEventFactory.from_exception(exception, _traceback.is_traceback_enabled(_traceback.TracebackEvent.WARNING))"," ","         if msg:","-            if source_context := _error_utils.SourceContext.from_value(obj):","-                formatted_source_context = str(source_context)","-            else:","-                formatted_source_context = None","+            with _error_utils.RedactAnnotatedSourceContext.when(event.redact_source_context):","+                if source_context := _error_utils.SourceContext.from_value(obj):","+                    formatted_source_context = str(source_context)","+                else:","+                    formatted_source_context = None"," ","             event = _messages.Event(","                 msg=msg,","@@ -856,6 +857,7 @@ def error_as_warning(","                     traceback_reason=_errors.TRACEBACK_REASON_EXCEPTION_DIRECT_WARNING,","                     event=event,","                 ),","+                redact_source_context=event.redact_source_context,","             )"," ","         warning = _messages.WarningSummary("],"additions":6,"deletions":4,"truncated":false},{"path":"test/integration/targets/error-redaction/aliases","lines":["@@ -0,0 +1,3 @@","+shippable/posix/group5","+context/controller","+gather_facts/no"],"additions":3,"deletions":0,"truncated":false},{"path":"test/integration/targets/error-redaction/filter_plugins/make_error.py","lines":["@@ -0,0 +1,42 @@","+from __future__ import annotations","+","+import os","+","+SHOW_CONTENT = not bool(int(os.environ[\"REDACTION_ENABLED\"]))","+","+","+from ansible.errors import AnsibleTemplatePluginError, AnsibleError","+","+","+def make_redacted_error(value: object) -> None:","+    raise AnsibleTemplatePluginError(\"redacted error\", obj=value, show_content=SHOW_CONTENT)","+","+","+def make_redacted_context_error(value: object) -> None:","+    try:","+        raise AnsibleTemplatePluginError(\"redacted context error\", obj=value, show_content=SHOW_CONTENT)","+    except AnsibleTemplatePluginError:","+        raise ValueError(\"have redacted context error\")","+","+","+def make_redacted_orig_exc_error(value: object) -> None:","+    try:","+        raise AnsibleTemplatePluginError(\"redacted context error\", obj=value, show_content=SHOW_CONTENT)","+    except AnsibleTemplatePluginError as ex:","+        orig_exc = ex","+","+    raise AnsibleError(\"have redacted orig_exc error\", orig_exc=orig_exc)  # pylint: disable=used-before-assignment","+","+","+def make_unredacted_error(value: object) -> None:","+    raise AnsibleTemplatePluginError(\"unredacted error\", obj=value, show_content=True)","+","+","+class FilterModule:","+    def filters(self):","+        return {","+            'make_redacted_error': make_redacted_error,","+            'make_unredacted_error': make_unredacted_error,","+            'make_redacted_context_error': make_redacted_context_error,","+            'make_redacted_orig_exc_error': make_redacted_orig_exc_error,","+        }"],"additions":42,"deletions":0,"truncated":false},{"path":"test/integration/targets/error-redaction/lookup_plugins/make_deprecated.py","lines":["@@ -0,0 +1,13 @@","+from __future__ import annotations","+","+from ansible.module_utils.datatag import deprecate_value","+from ansible.plugins.lookup import LookupBase","+","+","+class LookupModule(LookupBase):","+    def run(self, terms, variables=None, **kwargs):","+        return [deprecate_value(","+            value=value,","+            msg='Something deprecated.',","+            version='99.0.0',","+        ) for value in terms]"],"additions":13,"deletions":0,"truncated":false},{"path":"test/integration/targets/error-redaction/lookup_plugins/make_warning.py","lines":["@@ -0,0 +1,14 @@","+from __future__ import annotations","+","+from ansible.plugins.lookup import LookupBase","+from ansible.utils.display import Display","+","+display = Display()","+","+","+class LookupModule(LookupBase):","+    def run(self, terms, variables=None, **kwargs):","+        for value in terms:","+            display.warning(\"Some warning.\", obj=value)","+","+        return terms"],"additions":14,"deletions":0,"truncated":false},{"path":"test/integration/targets/error-redaction/runme.sh","lines":["@@ -0,0 +1,24 @@","+#!/usr/bin/env bash","+","+set -eux -o pipefail","+","+export ANSIBLE_ROLES_PATH=../","+export ANSIBLE_DEPRECATION_WARNINGS=true","+","+REDACTION_ENABLED=0 ansible-playbook tests.yml \"${@}\" 2>&1 | tee \"$OUTPUT_DIR/redaction-disabled.log\"","+REDACTION_ENABLED=1 ansible-playbook tests.yml \"${@}\" 2>&1 | tee \"$OUTPUT_DIR/redaction-enabled.log\"","+","+redacted_count=6","+unredacted_count=6","+","+for num in $(seq 1 $redacted_count); do","+    grep \"REDACT_ME_$num\" \"$OUTPUT_DIR/redaction-disabled.log\"","+    grep \"REDACT_ME_$num\" \"$OUTPUT_DIR/redaction-enabled.log\" && exit 1","+done","+","+for num in $(seq 1 $unredacted_count); do","+    grep \"NOT_REDACTED_$num\" \"$OUTPUT_DIR/redaction-disabled.log\"","+    grep \"NOT_REDACTED_$num\" \"$OUTPUT_DIR/redaction-enabled.log\"","+done","+","+echo PASS"],"additions":24,"deletions":0,"truncated":false},{"path":"test/integration/targets/error-redaction/tests.yml","lines":["@@ -0,0 +1,64 @@","+# Verify annotated source lines are redacted when an AnsibleError has show_content=False.","+# Redaction occurs when a sensitive operation raises an error (by setting show_content=False on the exception).","+# Errors unrelated to the sensitive operation or errors that block the sensitive operation are not redacted.","+# These tests cover various scenarios that will be redated.","+# They also cover scenarios which will not be redacted, although the list is not exhaustive.","+","+- hosts: localhost","+  gather_facts: no","+  ignore_errors: yes","+  tasks:","+    - name: redacted error in a module arg","+      ping:","+        data: \"{{ 'REDACT_ME_1' | make_redacted_error }}\"","+","+    - name: redacted error as __context__","+      ping:","+        data: \"{{ 'REDACT_ME_2' | make_redacted_context_error }}\"","+","+    - name: redacted error as orig_exc","+      ping:","+        data: \"{{ 'REDACT_ME_3' | make_redacted_orig_exc_error }}\"","+","+    - name: redacted error in a register projection","+      ping:","+      register:","+        something: \"'REDACT_ME_4' | make_redacted_error\"","+","+    - name: redacted error in non-existent module arg","+      ping:","+        invalid_arg: \"{{ 'REDACT_ME_5' | make_redacted_error }}\"","+","+    - name: redacted error as a warning","+      ping:","+      loop: [1]","+      loop_control:","+        label: \"{{ 'REDACT_ME_6' | make_redacted_error }}\"","+","+    - name: do not redact normal errors","+      ping:","+      register:","+        something: \"{{ 'NOT_REDACTED_1' | make_unredacted_error }}\"","+","+    - name: cannot redact template used where expression expected","+      ping:","+      register:","+        something: \"{{ 'NOT_REDACTED_2' | make_redacted_error }}\"","+","+    - name: cannot redact template syntax error","+      ping:","+      register:","+        something: \"{{ 'NOT_REDACTED_3 | make_redacted_error }}\"","+","+    - name: cannot redact by proximity","+      ping:","+        data: \"{{ 'NOT_REDACTED_4' | make_redacted_error }}\"","+    - ping: {\"data\": \"crash\"}","+","+    - name: cannot redact deprecation","+      ping:","+        data: \"{{ query('make_deprecated', 'NOT_REDACTED_5')[0] | make_redacted_error }}\"","+","+    - name: cannot redact warning","+      ping:","+        data: \"{{ query('make_warning', 'NOT_REDACTED_6')[0] | make_redacted_error }}\""],"additions":64,"deletions":0,"truncated":false},{"path":"test/integration/targets/secret_masking_filter/filter.yml","lines":["@@ -132,3 +132,10 @@","     - name: the second file value is now a registered secret too (proves lazy re-evaluation)","       debug:","         msg: \"MARKER lazy_second: {{ lazy_second_secret }}\"","+","+    # --- registration failure: the value was never registered so it cannot be masked, the error output must","+    # not show the source of the template containing it.","+    - name: register_secret failure does not display the source of the template","+      debug:","+        msg: \"{{ 'Zq1' | register_secret }}\"","+      ignore_errors: true"],"additions":7,"deletions":0,"truncated":false},{"path":"test/integration/targets/secret_masking_filter/filter_play_keyword.yml","lines":["@@ -0,0 +1,7 @@","+- name: Test register_secret failure outside of a task does not leak literal value","+  hosts: \"{{ 'Zq2' | register_secret }}\"","+  gather_facts: false","+  tasks:","+    - name: this task must never run","+      fail:","+        msg: the play should have failed before running any tasks"],"additions":7,"deletions":0,"truncated":false},{"path":"test/integration/targets/secret_masking_filter/runme.sh","lines":["@@ -55,4 +55,30 @@ for marker in \"${markers[@]}\"; do","     fi"," done"," ","+# A failed registration cannot mask the value, so the error output must not display the source of the template containing it.","+if ! grep -qF -- \"Secret must be at least 4 characters\" \"${LOG}\"; then","+    echo \"FAIL: expected register_secret failure message not found\" >&2","+    exit 1","+fi","+if grep -q -- \"Zq1\" \"${LOG}\"; then","+    echo \"FAIL: value of a failed register_secret template was displayed\" >&2","+    exit 1","+fi","+","+# The same check for a registration failure raised while templating a play keyword rather than by a task.","+PLAY_KEYWORD_LOG=\"${OUTPUT_DIR}/filter_play_keyword.log\"","+","+if ansible-playbook filter_play_keyword.yml -i ../../inventory \"$@\" 2>&1 | tee \"${PLAY_KEYWORD_LOG}\"; then","+    echo \"FAIL: play with a failed register_secret in a play keyword should have failed\" >&2","+    exit 1","+fi","+if ! grep -qF -- \"Secret must be at least 4 characters\" \"${PLAY_KEYWORD_LOG}\"; then","+    echo \"FAIL: expected register_secret failure message not found in play keyword output\" >&2","+    exit 1","+fi","+if grep -q -- \"Zq2\" \"${PLAY_KEYWORD_LOG}\"; then","+    echo \"FAIL: value of a failed register_secret template in a play keyword was displayed\" >&2","+    exit 1","+fi","+"," echo \"All secret masking filter scenarios passed.\""],"additions":26,"deletions":0,"truncated":false},{"path":"test/units/plugins/filter/test_core.py","lines":["@@ -11,7 +11,7 @@"," from ansible._internal._datatag._tags import Origin"," from ansible.module_utils.common.text.converters import to_native"," from ansible.plugins.filter.core import register_secret, to_bool, to_uuid","-from ansible.errors import AnsibleError","+from ansible.errors import AnsibleError, AnsibleTemplatePluginError"," from ansible.template import Templar, trust_as_template, is_trusted_as_template"," from ...test_utils.controller.display import emits_warnings"," ","@@ -111,10 +111,10 @@ def test_register_secret_valid(secret: str) -> None:"," ))"," def test_register_secret_invalid_error(secret: object, msg: str) -> None:","     with mock.patch(\"ansible.plugins.filter.core.secrets.register_secret\") as m:","-        with pytest.raises(ValueError, match=msg):","+        with pytest.raises(AnsibleTemplatePluginError, match=msg):","             register_secret(secret)  # type: ignore[arg-type]"," ","-        with pytest.raises(ValueError, match=msg):","+        with pytest.raises(AnsibleTemplatePluginError, match=msg):","             register_secret(secret, validation_action=\"error\")  # type: ignore[arg-type]"," ","     m.assert_not_called()",""],"additions":3,"deletions":3,"truncated":false}],"additions":261,"deletions":12,"truncated":false,"file_count":17},"error":null,"fetched_at":"2026-10-09T15:14:34.149703+00:00"}