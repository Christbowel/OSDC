6,8 @@ public class IgniteConfigStore implements ConfigStore {","     private static final Logger LOG = LoggerFactory.getLogger(IgniteConfigStore.class);","     private static final String DEFAULT_TABLE_NAME = \"tika_config_store\";","     private static final String DEFAULT_INSTANCE_NAME = \"TikaIgniteConfigStore\";","+    // '#' is outside ComponentIds.LEGAL_ID, so no component can collide with this row","+    static final String CHANGE_TOKEN_KEY = \"#change-token\";"," ","     private Ignite ignite;","     private KeyValueView<String, ExtensionConfigDTO> kvView;","@@ -120,6 +123,34 @@ public void put(String id, ExtensionConfig config) {","             LOG.error(\"Failed to put config with id: {}\", id, e);","             throw new RuntimeException(\"Failed to put config\", e);","         }","+        touchChangeToken();","+    }","+","+    /**","+     * A random value rewritten after every put and remove, so every process sharing the","+     * table sees each change; random rather than a counter, so writers need no CAS.","+     */","+    @Override","+    public Object changeToken() {","+        checkInitialized();","+        try {","+            ExtensionConfigDTO dto = kvView.get(null, CHANGE_TOKEN_KEY);","+            return dto != null ? dto.getJson() : \"\";","+        } catch (Exception e) {","+            LOG.error(\"Failed to read the change token\", e);","+            throw new RuntimeException(\"Failed to read the change token\", e);","+        }","+    }","+","+    // after the change itself: a reader that sees the new token must see the new config","+    private void touchChangeToken() {","+        try {","+            kvView.put(null, CHANGE_TOKEN_KEY,","+                    new ExtensionConfigDTO(CHANGE_TOKEN_KEY, UUID.randomUUID().toString()));","+        } catch (Exception e) {","+            LOG.error(\"Failed to write the change token\", e);","+            throw new RuntimeException(\"Failed to write the change token\", e);","+        }","     }"