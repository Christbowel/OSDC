{"id":"7d0a892930369a387c31c68f4390131be0741022","axis":"silent","repo":"aquasecurity/trivy","sha":"7d0a892930369a387c31c68f4390131be0741022","parsed":{"files":[{"path":"internal/cryptotest/asset.go","lines":["@@ -18,20 +18,22 @@ func WithMutate(mutate func(*types.CryptoAsset)) Option {"," // CertificateAsset returns a valid certificate asset."," func CertificateAsset(opts ...Option) types.CryptoAsset {"," \tasset := types.CryptoAsset{","-\t\tKind: types.CryptoKindCertificate,","-\t\tIdentity: types.CryptoIdentity{","-\t\t\tMethod: types.CryptoMethodSHA256,","-\t\t\tValue:  strings.Repeat(\"a\", 64),","+\t\tCryptoAssetInfo: types.CryptoAssetInfo{","+\t\t\tKind: types.CryptoKindCertificate,","+\t\t\tIdentity: types.CryptoIdentity{","+\t\t\t\tMethod: types.CryptoMethodSHA256,","+\t\t\t\tValue:  strings.Repeat(\"a\", 64),","+\t\t\t},","+\t\t\tName: \"example.test\",","+\t\t\tCertificate: &types.CryptoCertificate{","+\t\t\t\tSubject:      \"CN=example.test\",","+\t\t\t\tIssuer:       \"CN=Example Test CA\",","+\t\t\t\tSerialNumber: \"1\",","+\t\t\t\tFormat:       types.CryptoCertificateFormatX509,","+\t\t\t},"," \t\t},","-\t\tName:     \"example.test\","," \t\tFilePath: \"/etc/example.pem\",","-\t\tCertificate: &types.CryptoCertificate{","-\t\t\tSubject:      \"CN=example.test\",","-\t\t\tIssuer:       \"CN=Example Test CA\",","-\t\t\tSerialNumber: \"1\",","-\t\t\tFormat:       types.CryptoCertificateFormatX509,","-\t\t\tEncoding:     types.CryptoEncodingPEM,","-\t\t},","+\t\tEncoding: types.CryptoEncodingPEM,"," \t}"," \treturn applyOptions(asset, opts)"," }","@@ -39,18 +41,20 @@ func CertificateAsset(opts ...Option) types.CryptoAsset {"," // PublicKeyAsset returns a valid public key asset."," func PublicKeyAsset(opts ...Option) types.CryptoAsset {"," \tasset := types.CryptoAsset{","-\t\tKind:    types.CryptoKindKey,","-\t\tKeyType: types.CryptoKeyTypePublic,","-\t\tIdentity: types.CryptoIdentity{","-\t\t\tMethod: types.CryptoMethodSPKISHA256,","-\t\t\tValue:  strings.Repeat(\"b\", 64),","+\t\tCryptoAssetInfo: types.CryptoAssetInfo{","+\t\t\tKind:    types.CryptoKindKey,","+\t\t\tKeyType: types.CryptoKeyTypePublic,","+\t\t\tIdentity: types.CryptoIdentity{","+\t\t\t\tMethod: types.CryptoMethodSPKISHA256,","+\t\t\t\tValue:  strings.Repeat(\"b\", 64),","+\t\t\t},","+\t\t\tKey: &types.CryptoKey{","+\t\t\t\tSize: 2048,","+\t\t\t},"," \t\t},"," \t\tFilePath: \"/etc/example-public.pem\",","-\t\tKey: &types.CryptoKey{","-\t\t\tSize:     2048,","-\t\t\tFormat:   types.CryptoKeyFormatPKIX,","-\t\t\tEncoding: types.CryptoEncodingPEM,","-\t\t},","+\t\tFormat:   types.CryptoKeyFormatPKIX,","+\t\tEncoding: types.CryptoEncodingPEM,"," \t}"," \treturn applyOptions(asset, opts)"," }","@@ -60,7 +64,7 @@ func PrivateKeyAsset(opts ...Option) types.CryptoAsset {"," \tasset := PublicKeyAsset()"," \tasset.KeyType = types.CryptoKeyTypePrivate"," \tasset.FilePath = \"/etc/example-private.pem\"","-\tasset.Key.Format = types.CryptoKeyFormatPKCS8","+\tasset.Format = types.CryptoKeyFormatPKCS8"," \treturn applyOptions(asset, opts)"," }"," ","@@ -77,24 +81,27 @@ func EncryptedPrivateKeyAsset(opts ...Option) types.CryptoAsset {"," func RFC1423EncryptedPrivateKeyAsset(opts ...Option) types.CryptoAsset {"," \tasset := EncryptedPrivateKeyAsset()"," \tasset.Identity.Method = types.CryptoMethodEncryptedRFC1423SHA256","-\tasset.Key.Format = types.CryptoKeyFormatPKCS1","+\tasset.Format = types.CryptoKeyFormatPKCS1"," \treturn applyOptions(asset, opts)"," }"," "," // AlgorithmAsset returns a valid algorithm asset."," func AlgorithmAsset(opts ...Option) types.CryptoAsset {"," \tasset := types.CryptoAsset{","-\t\tKind: types.CryptoKindAlgorithm,","-\t\tIdentity: types.CryptoIdentity{","-\t\t\tMethod: types.CryptoMethodOID,","-\t\t\tValue:  \"1.2.840.113549.1.1.1\",","+\t\tCryptoAssetInfo: types.CryptoAssetInfo{","+\t\t\tKind: types.CryptoKindAlgorithm,","+\t\t\tIdentity: types.CryptoIdentity{","+\t\t\t\tMethod: types.CryptoMethodOID,","+\t\t\t\tValue:  \"1.2.840.113549.1.1.1\",","+\t\t\t},","+\t\t\tName: \"RSA\",","+\t\t\t// rsaEncryption identifies both signature and encryption keys, so the primitive","+\t\t\t// stays unknown and the family stays empty, as the algorithm catalog describes it.","+\t\t\tAlgorithm: &types.CryptoAlgorithm{","+\t\t\t\tPrimitive: types.CryptoPrimitiveUnknown,","+\t\t\t},"," \t\t},","-\t\tName:     \"RSA\","," \t\tFilePath: \"/etc/example-algorithm.pem\",","-\t\tAlgorithm: &types.CryptoAlgorithm{","-\t\t\tFamily:    \"RSA\",","-\t\t\tPrimitive: types.CryptoPrimitivePKE,","-\t\t},"," \t}"," \treturn applyOptions(asset, opts)"," }"],"additions":40,"deletions":33,"truncated":false},{"path":"pkg/crypto/algorithm.go","lines":["@@ -0,0 +1,40 @@","+package crypto","+","+import (","+\t\"strconv\"","+","+\tftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+)","+","+// DescribeAlgorithm describes the algorithm an OID identifies. The size and the curve","+// belong to the key the algorithm is used with and are zero for a signature algorithm.","+func DescribeAlgorithm(oid string, size int, curve string) ftypes.CryptoAssetInfo {","+\tfound := lookupAlgorithm(oid)","+","+\tname := found.name","+\tvar parameters string","+\tswitch {","+\tcase found.parameter == ftypes.CryptoParameterKeySize && size > 0:","+\t\tvalue := strconv.Itoa(size)","+\t\tname += \"-\" + value","+\t\tparameters = string(ftypes.CryptoParameterKeySize) + \"=\" + value","+\tcase found.parameter == ftypes.CryptoParameterCurve && curve != \"\":","+\t\tname += \"-\" + curve","+\t\tparameters = string(ftypes.CryptoParameterCurve) + \"=\" + curve","+\t}","+","+\treturn ftypes.CryptoAssetInfo{","+\t\tKind: ftypes.CryptoKindAlgorithm,","+\t\tIdentity: ftypes.CryptoIdentity{","+\t\t\tMethod:     ftypes.CryptoMethodOID,","+\t\t\tValue:      oid,","+\t\t\tParameters: parameters,","+\t\t},","+\t\tName: name,","+","+\t\tAlgorithm: &ftypes.CryptoAlgorithm{","+\t\t\tFamily:    found.family,","+\t\t\tPrimitive: found.primitive,","+\t\t},","+\t}","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"pkg/crypto/algorithm_test.go","lines":["@@ -0,0 +1,118 @@","+package crypto_test","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/aquasecurity/trivy/pkg/crypto\"","+\tftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+)","+","+func TestDescribeAlgorithm(t *testing.T) {","+\ttests := []struct {","+\t\tname  string","+\t\toid   string","+\t\tsize  int","+\t\tcurve string","+\t\twant  ftypes.CryptoAssetInfo","+\t}{","+\t\t{","+\t\t\t// A signature algorithm is described without key parameters, because the key","+\t\t\t// that produced the signature is not the one being described.","+\t\t\tname: \"signature algorithm\",","+\t\t\toid:  \"1.2.840.113549.1.1.11\",","+\t\t\twant: ftypes.CryptoAssetInfo{","+\t\t\t\tKind: ftypes.CryptoKindAlgorithm,","+\t\t\t\tIdentity: ftypes.CryptoIdentity{","+\t\t\t\t\tMethod: ftypes.CryptoMethodOID,","+\t\t\t\t\tValue:  \"1.2.840.113549.1.1.11\",","+\t\t\t\t},","+\t\t\t\tName: \"RSA-PKCS1-1.5-SHA-256\",","+\t\t\t\tAlgorithm: &ftypes.CryptoAlgorithm{","+\t\t\t\t\tFamily:    \"RSASSA-PKCS1\",","+\t\t\t\t\tPrimitive: ftypes.CryptoPrimitiveSignature,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\t// The catalog names the property that tells assets sharing an OID apart, and","+\t\t\t// the value of that property becomes part of the identity.","+\t\t\tname: \"key size parameter\",","+\t\t\toid:  \"1.2.840.113549.1.1.1\",","+\t\t\tsize: 2048,","+\t\t\twant: ftypes.CryptoAssetInfo{","+\t\t\t\tKind: ftypes.CryptoKindAlgorithm,","+\t\t\t\tIdentity: ftypes.CryptoIdentity{","+\t\t\t\t\tMethod:     ftypes.CryptoMethodOID,","+\t\t\t\t\tValue:      \"1.2.840.113549.1.1.1\",","+\t\t\t\t\tParameters: \"key-size=2048\",","+\t\t\t\t},","+\t\t\t\tName: \"RSA-2048\",","+\t\t\t\tAlgorithm: &ftypes.CryptoAlgorithm{","+\t\t\t\t\tPrimitive: ftypes.CryptoPrimitiveUnknown,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:  \"curve parameter\",","+\t\t\toid:   \"1.2.840.10045.2.1\",","+\t\t\tsize:  256,","+\t\t\tcurve: \"P-256\",","+\t\t\twant: ftypes.CryptoAssetInfo{","+\t\t\t\tKind: ftypes.CryptoKindAlgorithm,","+\t\t\t\tIdentity: ftypes.CryptoIdentity{","+\t\t\t\t\tMethod:     ftypes.CryptoMethodOID,","+\t\t\t\t\tValue:      \"1.2.840.10045.2.1\",","+\t\t\t\t\tParameters: \"curve=P-256\",","+\t\t\t\t},","+\t\t\t\tName: \"EC-P-256\",","+\t\t\t\tAlgorithm: &ftypes.CryptoAlgorithm{","+\t\t\t\t\tPrimitive: ftypes.CryptoPrimitiveUnknown,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\t// RSASSA-PSS is left out of the catalog because its variants share one OID.","+\t\t\tname: \"algorithm outside the catalog\",","+\t\t\toid:  \"1.2.840.113549.1.1.10\",","+\t\t\twant: ftypes.CryptoAssetInfo{","+\t\t\t\tKind: ftypes.CryptoKindAlgorithm,","+\t\t\t\tIdentity: ftypes.CryptoIdentity{","+\t\t\t\t\tMethod: ftypes.CryptoMethodOID,","+\t\t\t\t\tValue:  \"1.2.840.113549.1.1.10\",","+\t\t\t\t},","+\t\t\t\tName: \"1.2.840.113549.1.1.10\",","+\t\t\t\tAlgorithm: &ftypes.CryptoAlgorithm{","+\t\t\t\t\tPrimitive: ftypes.CryptoPrimitiveUnknown,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\t// A catalog entry that names a parameter is described without it when the key","+\t\t\t// does not state one, which is what a signature algorithm does.","+\t\t\tname: \"missing parameter value\",","+\t\t\toid:  \"1.2.840.10045.2.1\",","+\t\t\twant: ftypes.CryptoAssetInfo{","+\t\t\t\tKind: ftypes.CryptoKindAlgorithm,","+\t\t\t\tIdentity: ftypes.CryptoIdentity{","+\t\t\t\t\tMethod: ftypes.CryptoMethodOID,","+\t\t\t\t\tValue:  \"1.2.840.10045.2.1\",","+\t\t\t\t},","+\t\t\t\tName: \"EC\",","+\t\t\t\tAlgorithm: &ftypes.CryptoAlgorithm{","+\t\t\t\t\tPrimitive: ftypes.CryptoPrimitiveUnknown,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tgot := crypto.DescribeAlgorithm(tt.oid, tt.size, tt.curve)","+\t\t\tassert.Equal(t, tt.want, got)","+\t\t\trequire.NoError(t, got.Validate())","+\t\t})","+\t}","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"pkg/crypto/catalog.go","lines":["@@ -0,0 +1,145 @@","+package crypto","+","+import ftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+","+// algorithm is the hand-maintained knowledge about an OID: the name and family it","+// carries in the CycloneDX cryptography vocabulary, the primitive it provides, and the","+// key property that distinguishes assets sharing it.","+//","+// An OID whose purpose cannot be decided carries no family and an unknown primitive.","+// RFC 3279 section 2.3.1 states that rsaEncryption identifies both signature and","+// encryption keys, and id-ecPublicKey is shared by ECDSA and ECDH just as widely.","+// Naming a family for either would assert a purpose the certificate does not state.","+//","+// A name is a base name: an algorithm with a parameter is named together with the value","+// of that parameter, such as RSA-2048.","+type algorithm struct {","+\tname      string","+\tfamily    string","+\tprimitive ftypes.CryptoPrimitive","+\tparameter ftypes.CryptoAlgorithmParameter","+}","+","+// algorithms maps the OIDs that appear in the certificates and keys this package","+// describes. An OID is read out of the DER rather than taken from a crypto/x509","+// enumeration, so an algorithm the standard library does not recognize reaches this table","+// as well.","+//","+// A name follows the naming pattern the CycloneDX cryptography vocabulary defines for","+// the family: RSASSA-PKCS1 carries the pattern RSA-PKCS1-1.5[-{digestAlgorithm}][-{keyLength}],","+// which yields RSA-PKCS1-1.5-SHA-256 for sha256WithRSAEncryption. A signature name stops","+// at the digest: the key length in the pattern describes the key that produced the","+// signature, and that key belongs to the issuer, while a certificate carries the key of","+// its subject.","+//","+// An OID with no family has no pattern to follow, because the vocabulary defines one per","+// family. Its name is built by the same rule as every other: the base name carries the","+// value of the parameter that distinguishes the asset, which yields RSA-2048 and EC-P-256.","+//","+// RSA-PSS is absent on purpose: its variants share one OID and differ only in the","+// signature parameters, so identifying it needs parameter-aware handling.","+var algorithms = map[string]algorithm{","+\t// Certificate signature algorithms.","+\t\"1.2.840.113549.1.1.4\": {","+\t\tname:      \"RSA-PKCS1-1.5-MD5\",","+\t\tfamily:    \"RSASSA-PKCS1\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.113549.1.1.5\": {","+\t\tname:      \"RSA-PKCS1-1.5-SHA-1\",","+\t\tfamily:    \"RSASSA-PKCS1\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.113549.1.1.11\": {","+\t\tname:      \"RSA-PKCS1-1.5-SHA-256\",","+\t\tfamily:    \"RSASSA-PKCS1\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.113549.1.1.12\": {","+\t\tname:      \"RSA-PKCS1-1.5-SHA-384\",","+\t\tfamily:    \"RSASSA-PKCS1\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.113549.1.1.13\": {","+\t\tname:      \"RSA-PKCS1-1.5-SHA-512\",","+\t\tfamily:    \"RSASSA-PKCS1\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t// The ISO arc carries a second OID for SHA-1 with RSA, which makecert.exe has been","+\t// known to produce. The two OIDs name one algorithm but stay two assets, because an","+\t// algorithm is identified by the OID the certificate carries.","+\t\"1.3.14.3.2.29\": {","+\t\tname:      \"RSA-PKCS1-1.5-SHA-1\",","+\t\tfamily:    \"RSASSA-PKCS1\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.10040.4.3\": {","+\t\tname:      \"DSA-SHA-1\",","+\t\tfamily:    \"DSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"2.16.840.1.101.3.4.3.2\": {","+\t\tname:      \"DSA-SHA-256\",","+\t\tfamily:    \"DSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.10045.4.1\": {","+\t\tname:      \"ECDSA-SHA-1\",","+\t\tfamily:    \"ECDSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.10045.4.3.2\": {","+\t\tname:      \"ECDSA-SHA-256\",","+\t\tfamily:    \"ECDSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.10045.4.3.3\": {","+\t\tname:      \"ECDSA-SHA-384\",","+\t\tfamily:    \"ECDSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+\t\"1.2.840.10045.4.3.4\": {","+\t\tname:      \"ECDSA-SHA-512\",","+\t\tfamily:    \"ECDSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+","+\t// Subject public key algorithms.","+\t\"1.2.840.113549.1.1.1\": {","+\t\tname:      \"RSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveUnknown,","+\t\tparameter: ftypes.CryptoParameterKeySize,","+\t},","+\t\"1.2.840.10045.2.1\": {","+\t\tname:      \"EC\",","+\t\tprimitive: ftypes.CryptoPrimitiveUnknown,","+\t\tparameter: ftypes.CryptoParameterCurve,","+\t},","+\t\"1.2.840.10040.4.1\": {","+\t\tname:      \"DSA\",","+\t\tfamily:    \"DSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t\tparameter: ftypes.CryptoParameterKeySize,","+\t},","+","+\t// Ed25519 uses one OID as both the key and the signature algorithm, and the curve","+\t// fixes its parameters.","+\t\"1.3.101.112\": {","+\t\tname:      \"Ed25519\",","+\t\tfamily:    \"EdDSA\",","+\t\tprimitive: ftypes.CryptoPrimitiveSignature,","+\t},","+}","+","+// lookupAlgorithm reports what the catalog knows about an OID. An OID the table does not","+// list is named by the OID itself and its primitive is unknown, because every other","+// attribute comes from the table.","+func lookupAlgorithm(oid string) algorithm {","+\tif found, known := algorithms[oid]; known {","+\t\treturn found","+\t}","+\treturn algorithm{","+\t\tname:      oid,","+\t\tprimitive: ftypes.CryptoPrimitiveUnknown,","+\t}","+}"],"additions":145,"deletions":0,"truncated":false},{"path":"pkg/crypto/doc.go","lines":["@@ -0,0 +1,3 @@","+// Package crypto describes the keys and algorithms that every source format has in common.","+// Reading a container is left to the parser of that format.","+package crypto"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/crypto/key.go","lines":["@@ -0,0 +1,176 @@","+package crypto","+","+import (","+\tstdcrypto \"crypto\"","+\t\"crypto/dsa\"","+\t\"crypto/ecdsa\"","+\t\"crypto/ed25519\"","+\t\"crypto/rsa\"","+\t\"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"encoding/asn1\"","+\t\"errors\"","+\t\"fmt\"","+\t\"math/big\"","+","+\t\"golang.org/x/xerrors\"","+","+\tftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+)","+","+// ErrNoCanonicalForm reports a key that cannot be reduced to SubjectPublicKeyInfo, such as","+// the absent key of a certificate whose algorithm crypto/x509 does not recognize.","+var ErrNoCanonicalForm = errors.New(\"key has no canonical form\")","+","+// DescribeKey describes a key and the algorithm it belongs to. A private key is described","+// through its public projection, so it differs from a public key only in its key type.","+//","+// A key that cannot be encoded is reported with ErrNoCanonicalForm. Any other error means","+// the SubjectPublicKeyInfo produced here does not parse back, and the encoder is wrong.","+func DescribeKey(","+\tpub stdcrypto.PublicKey,","+\tkeyType ftypes.CryptoKeyType,","+) (key, keyAlgorithm ftypes.CryptoAssetInfo, err error) {","+\tidentity, algorithmOID, err := publicKeyInfo(pub)","+\tif err != nil {","+\t\treturn ftypes.CryptoAssetInfo{}, ftypes.CryptoAssetInfo{}, err","+\t}","+","+\tsize, curve := keyDetails(pub)","+\tkeyAlgorithm = DescribeAlgorithm(algorithmOID, size, curve)","+","+\tkey = ftypes.CryptoAssetInfo{","+\t\tKind:     ftypes.CryptoKindKey,","+\t\tKeyType:  keyType,","+\t\tIdentity: identity,","+\t\tName:     keyAlgorithm.Name + \" \" + string(keyType) + \" key\",","+","+\t\tKey: &ftypes.CryptoKey{","+\t\t\tSize:  size,","+\t\t\tCurve: curve,","+\t\t},","+\t\tRelationships: []ftypes.CryptoRelationship{{","+\t\t\tType:         ftypes.CryptoRelationshipUsedWith,","+\t\t\tRelatedAsset: keyAlgorithm.Descriptor(),","+\t\t}},","+\t}","+\treturn key, keyAlgorithm, nil","+}","+","+// DescribeEncryptedKey describes an encrypted private key container. Its algorithm, size","+// and curve live inside the encrypted payload and stay unset.","+func DescribeEncryptedKey(","+\tmethod ftypes.CryptoIdentityMethod,","+\tcanonical []byte,","+\tformat ftypes.CryptoKeyFormat,","+) ftypes.CryptoAssetInfo {","+\treturn ftypes.CryptoAssetInfo{","+\t\tKind:     ftypes.CryptoKindKey,","+\t\tKeyType:  ftypes.CryptoKeyTypePrivate,","+\t\tIdentity: ftypes.DigestIdentity(method, canonical),","+\t\t// The container states its format, and nothing else about the key is readable","+\t\t// without the passphrase.","+\t\tName: \"Encrypted \" + string(format) + \" private key\",","+","+\t\tKey: &ftypes.CryptoKey{","+\t\t\tEncrypted: true,","+\t\t},","+\t}","+}","+","+// keyDetails reports the size in bits and the curve of a public key.","+func keyDetails(pub stdcrypto.PublicKey) (int, string) {","+\tswitch pub := pub.(type) {","+\tcase *rsa.PublicKey:","+\t\treturn pub.N.BitLen(), \"\"","+\tcase *dsa.PublicKey:","+\t\treturn pub.P.BitLen(), \"\"","+\tcase *ecdsa.PublicKey:","+\t\treturn pub.Curve.Params().BitSize, pub.Curve.Params().Name","+\tcase ed25519.PublicKey:","+\t\t// An Ed25519 key is the raw point, so its length is the key size in bytes.","+\t\treturn len(pub) * 8, \"\"","+\t}","+\treturn 0, \"\"","+}","+","+// publicKeyInfo canonicalizes a key as PKIX SubjectPublicKeyInfo and reports the identity","+// it yields together with the OID of its algorithm.","+func publicKeyInfo(pub stdcrypto.PublicKey) (ftypes.CryptoIdentity, string, error) {","+\tder, err := MarshalPublicKey(pub)","+\tif err != nil {","+\t\treturn ftypes.CryptoIdentity{}, \"\", fmt.Errorf(\"%w: %w\", ErrNoCanonicalForm, err)","+\t}","+","+\toid, err := subjectPublicKeyOID(der)","+\tif err != nil {","+\t\treturn ftypes.CryptoIdentity{}, \"\", xerrors.Errorf(\"read the algorithm of the encoded key: %w\", err)","+\t}","+","+\treturn ftypes.DigestIdentity(ftypes.CryptoMethodSPKISHA256, der), oid, nil","+}","+","+// oidDSA identifies a DSA public key, defined by RFC 3279 section 2.3.2.","+// See https://datatracker.ietf.org/doc/html/rfc3279#section-2.3.2","+var oidDSA = asn1.ObjectIdentifier{1, 2, 840, 10040, 4, 1}","+","+// MarshalPublicKey encodes a public key as PKIX SubjectPublicKeyInfo, the canonical form a","+// key is identified by. A DSA key is encoded here, because crypto/x509 parses that form but","+// cannot produce it.","+func MarshalPublicKey(pub stdcrypto.PublicKey) ([]byte, error) {","+\tif key, ok := pub.(*dsa.PublicKey); ok {","+\t\treturn marshalDSAPublicKey(key)","+\t}","+\treturn x509.MarshalPKIXPublicKey(pub)","+}","+","+// marshalDSAPublicKey encodes a DSA public key the way RFC 3279 section 2.3.2 defines it:","+// the domain parameters travel in the algorithm identifier, and the public value is a","+// DER integer inside the bit string. crypto/x509 parses this form but cannot produce it.","+// See https://datatracker.ietf.org/doc/html/rfc3279#section-2.3.2","+func marshalDSAPublicKey(pub *dsa.PublicKey) ([]byte, error) {","+\tparameters, err := asn1.Marshal(struct {","+\t\tP, Q, G *big.Int","+\t}{pub.P, pub.Q, pub.G})","+\tif err != nil {","+\t\treturn nil, xerrors.Errorf(\"marshal DSA parameters: %w\", err)","+\t}","+","+\tvalue, err := asn1.Marshal(pub.Y)","+\tif err != nil {","+\t\treturn nil, xerrors.Errorf(\"marshal DSA public value: %w\", err)","+\t}","+","+\tder, err := asn1.Marshal(struct {","+\t\tAlgorithm        pkix.AlgorithmIdentifier","+\t\tSubjectPublicKey asn1.BitString","+\t}{","+\t\tAlgorithm: pkix.AlgorithmIdentifier{","+\t\t\tAlgorithm:  oidDSA,","+\t\t\tParameters: asn1.RawValue{FullBytes: parameters},","+\t\t},","+\t\tSubjectPublicKey: asn1.BitString{","+\t\t\tBytes:     value,","+\t\t\tBitLength: len(value) * 8,","+\t\t},","+\t})","+\tif err != nil {","+\t\treturn nil, xerrors.Errorf(\"marshal DSA subject public key info: %w\", err)","+\t}","+\treturn der, nil","+}","+","+// subjectPublicKeyOID reads the algorithm OID out of SubjectPublicKeyInfo DER. The OID is","+// read from the encoding rather than from PublicKeyAlgorithm, which is an enumeration that","+// does not carry it.","+func subjectPublicKeyOID(der []byte) (string, error) {","+\t// The key itself follows the algorithm and is left unread, because encoding/asn1","+\t// tolerates elements of a sequence that the target struct does not declare.","+\tvar info struct {","+\t\tAlgorithm pkix.AlgorithmIdentifier","+\t}","+\tif _, err := asn1.Unmarshal(der, &info); err != nil {","+\t\treturn \"\", xerrors.Errorf(\"unmarshal subject public key info: %w\", err)","+\t}","+\treturn info.Algorithm.Algorithm.String(), nil","+}"],"additions":176,"deletions":0,"truncated":false},{"path":"pkg/crypto/key_test.go","lines":["@@ -0,0 +1,357 @@","+package crypto_test","+","+import (","+\t\"crypto/dsa\"","+\t\"crypto/ecdsa\"","+\t\"crypto/ed25519\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"crypto/rsa\"","+\tstdx509 \"crypto/x509\"","+\t\"math/big\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/aquasecurity/trivy/pkg/crypto\"","+\tftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+)","+","+type keyFixtures struct {","+\trsaPublic     *rsa.PublicKey","+\tecdsaPublic   *ecdsa.PublicKey","+\ted25519Public ed25519.PublicKey","+\tdsaPublic     *dsa.PublicKey","+}","+","+func TestDescribeKey(t *testing.T) {","+\tfixtures := newKeyFixtures(t)","+","+\t// The algorithm of an RSA key cannot be told apart from a signature algorithm by its","+\t// OID alone, so it carries an unknown primitive and no family.","+\trsaAlgorithm := ftypes.CryptoAssetInfo{