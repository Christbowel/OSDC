{"id":"801f6792506e84529fea6a1ef21db2b889c5c485","axis":"silent","repo":"kestra-io/kestra","sha":"801f6792506e84529fea6a1ef21db2b889c5c485","parsed":{"files":[{"path":"webserver/src/main/java/io/kestra/webserver/filter/CsrfTokenFilter.java","lines":["@@ -26,9 +26,10 @@"," import static io.kestra.webserver.services.BasicAuthService.BASIC_AUTH_COOKIE_NAME;"," "," /**","- * Custom CSRF filter that only enforces token validation on cookie-authenticated requests.","- * SDK/API clients using the Authorization header bypass CSRF since they are not vulnerable","- * to cross-site request forgery (attackers cannot set custom headers cross-origin).","+ * Custom CSRF filter that enforces token validation on requests authenticated by an ambient credential:","+ * the auth cookies, or an {@code Authorization: Basic} header sent by a browser, which caches and replays it","+ * on cross-site requests. Non-browser clients (SDK, CLI, curl) send neither an {@code Origin} nor a","+ * {@code Sec-Fetch-Site} header and bypass CSRF; a browser-hosted client must send the CSRF token.","  */"," @Requires(property = \"micronaut.security.csrf.enabled\", value = StringUtils.TRUE, defaultValue = StringUtils.TRUE)"," @Requires(beans = CsrfTokenValidator.class)","@@ -56,7 +57,7 @@ public HttpResponse<?> csrfFilter(@NonNull HttpRequest<?> request) {","             return null;","         }"," ","-        if (!hasCookieAuth(request)) {","+        if (!hasAmbientCredential(request)) {","             return null;","         }"," ","@@ -67,7 +68,7 @@ public HttpResponse<?> csrfFilter(@NonNull HttpRequest<?> request) {","         String csrfToken = resolveCsrfToken(request);","         if (StringUtils.isEmpty(csrfToken)) {","             log.debug(","-                \"CSRF rejected for {} {}: cookie-authenticated request with no CSRF token (missing X-CSRF-TOKEN header/field)\",","+                \"CSRF rejected for {} {}: request with an ambient credential and no CSRF token (missing X-CSRF-TOKEN header/field)\",","                 request.getMethod(), request.getPath()","             );","             return HttpResponse.status(HttpStatus.FORBIDDEN);","@@ -85,9 +86,22 @@ public HttpResponse<?> csrfFilter(@NonNull HttpRequest<?> request) {"," ","     private static final String JWT_COOKIE_NAME = \"JWT\";"," ","-    private boolean hasCookieAuth(@NonNull HttpRequest<?> request) {","+    private boolean hasAmbientCredential(@NonNull HttpRequest<?> request) {","         return request.getCookies().findCookie(BASIC_AUTH_COOKIE_NAME).isPresent()","-            || request.getCookies().findCookie(JWT_COOKIE_NAME).isPresent();","+            || request.getCookies().findCookie(JWT_COOKIE_NAME).isPresent()","+            || (hasBasicAuthorizationHeader(request) && isBrowserRequest(request));","+    }","+","+    private boolean hasBasicAuthorizationHeader(@NonNull HttpRequest<?> request) {","+        String authorization = request.getHeaders().get(HttpHeaders.AUTHORIZATION);","+        return authorization != null && authorization.regionMatches(true, 0, \"Basic \", 0, \"Basic \".length());","+    }","+","+    // Browsers always send Origin on a cross-site POST and Sec-Fetch-Site on every request, unlike API clients.","+    private boolean isBrowserRequest(@NonNull HttpRequest<?> request) {","+        String secFetchSite = request.getHeaders().get(\"Sec-Fetch-Site\");","+        return request.getHeaders().get(HttpHeaders.ORIGIN) != null","+            || (secFetchSite != null && !\"none\".equalsIgnoreCase(secFetchSite));","     }"," ","     @Nullable"],"additions":21,"deletions":7,"truncated":false},{"path":"webserver/src/test/java/io/kestra/webserver/filter/CsrfTokenFilterTest.java","lines":["@@ -148,4 +148,55 @@ void shouldRejectPostWithCookieAndInvalidCsrfToken() {","         );","         assertThat(exception.getStatus().getCode()).isEqualTo(HttpStatus.FORBIDDEN.getCode());","     }","+","+    @Test","+    void shouldRejectPostWithBasicAuthHeaderFromBrowserWithoutCsrfToken() {","+        // Given - cross-site form: the browser replays its cached Basic credentials but no cookie","+        MutableHttpRequest<?> request = HttpRequest.POST(\"/api/v1/main/executions/webhook/unit_test/webhook_test\", \"\")","+            .basicAuth(basicAuthConfiguration.getUsername(), basicAuthConfiguration.getPassword())","+            .header(\"Sec-Fetch-Site\", \"cross-site\");","+","+        // When/Then","+        HttpClientResponseException exception = assertThrows(","+            HttpClientResponseException.class,","+            () -> client.toBlocking().exchange(request)","+        );","+        assertThat(exception.getStatus().getCode()).isEqualTo(HttpStatus.FORBIDDEN.getCode());","+    }","+","+    @Test","+    void shouldAcceptPostWithBasicAuthHeaderAndNoBrowserHeaders() {","+        // Given - SDK/API client path: Basic header, neither Origin nor Sec-Fetch-Site","+        MutableHttpRequest<?> request = HttpRequest.POST(\"/api/v1/main/executions/webhook/unit_test/webhook_test\", \"\")","+            .basicAuth(basicAuthConfiguration.getUsername(), basicAuthConfiguration.getPassword());","+","+        // When/Then - should not be rejected by CSRF filter","+        try {","+            var response = client.toBlocking().exchange(request);","+            assertThat(response.getStatus().getCode()).isNotEqualTo(HttpStatus.FORBIDDEN.getCode());","+        } catch (HttpClientResponseException e) {","+            assertThat(e.getStatus().getCode()).isNotEqualTo(HttpStatus.FORBIDDEN.getCode());","+        }","+    }","+","+    @Test","+    void shouldAcceptPostWithBasicAuthHeaderFromBrowserAndValidCsrfToken() {","+        // Given - same-origin UI path with a valid CSRF token","+        MutableHttpRequest<?> tokenRequest = HttpRequest.GET(\"/api/v1/configs\");","+        String csrfToken = csrfTokenGenerator.generateCsrfToken(tokenRequest);","+","+        MutableHttpRequest<?> request = HttpRequest.POST(\"/api/v1/main/executions/webhook/unit_test/webhook_test\", \"\")","+            .basicAuth(basicAuthConfiguration.getUsername(), basicAuthConfiguration.getPassword())","+            .header(\"Sec-Fetch-Site\", \"same-origin\")","+            .cookie(Cookie.of(csrfConfiguration.getCookieName(), csrfToken))","+            .header(\"X-CSRF-TOKEN\", csrfToken);","+","+        // When/Then - should not be rejected by CSRF filter","+        try {","+            var response = client.toBlocking().exchange(request);","+            assertThat(response.getStatus().getCode()).isNotEqualTo(HttpStatus.FORBIDDEN.getCode());","+        } catch (HttpClientResponseException e) {","+            assertThat(e.getStatus().getCode()).isNotEqualTo(HttpStatus.FORBIDDEN.getCode());","+        }","+    }"," }",""],"additions":51,"deletions":0,"truncated":false}],"additions":72,"deletions":7,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-17T18:45:43.011553+00:00"}