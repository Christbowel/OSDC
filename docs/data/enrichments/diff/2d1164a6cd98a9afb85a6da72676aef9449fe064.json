llvm-tpde.md","lines":["@@ -0,0 +1,12 @@","+# `llvm-tpde`","+","+The tracking issue for this feature is: None.","+","+---","+","+The `-Zllvm-tpde[=VALUE]` compiler flag controls whether TPDE-LLVM is used as the codegen backend for debug builds instead of LLVM. If not set, LLVM is used.","+","+Possible values are:","+","+- `try` (default): attempt to compile with TPDE-LLVM, but fall back to LLVM if unsupported IR is encountered","+- `only`: attempt to compile with TPDE-LLVM, and bail if unsupported IR is encountered"],"additions":12,"deletions":0,"truncated":false},{"path":"src/tools/compiletest/src/cli.rs","lines":["@@ -239,6 +239,8 @@ struct Args {","     /// Run tests that require offload.","     #[arg(long)]","     has_offload: bool,","+    #[arg(long)]","+    has_tpde: bool,","     /// Whether rustc was built with debug assertions.","     #[arg(long)]","     with_rustc_debug_assertions: bool,","@@ -455,6 +457,7 @@ pub(crate) fn parse_config(args: Vec<String>) -> Config {"," ","         has_enzyme: args.has_enzyme,","         has_offload: args.has_offload,","+        has_tpde: args.has_tpde,","         host: args.host,","         host_compile_lib_path: make_absolute(args.compile_lib_path),","         host_linker: args.host_linker,"],"additions":3,"deletions":0,"truncated":false},{"path":"src/tools/compiletest/src/common.rs","lines":["@@ -682,6 +682,9 @@ pub(crate) struct Config {","     /// Whether to run `offload` autodiff tests.","     pub(crate) has_offload: bool,"," ","+    /// Whether to run tests with the `tpde` LLVM backend","+    pub(crate) has_tpde: bool,","+","     /// The current Rust channel info.","     ///","     /// FIXME: treat this more carefully; \"stable\", \"beta\" and \"nightly\" are definitely valid, but"],"additions":3,"deletions":0,"truncated":false},{"path":"src/tools/compiletest/src/directives/directive_names.rs","lines":["@@ -208,6 +208,7 @@ pub(crate) const KNOWN_DIRECTIVE_NAMES: &[&str] = &[","     \"needs-target-has-atomic\",","     