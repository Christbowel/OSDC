{"id":"41d25db46f0d2b6b726ed37b6ccf0b92d49fd0f1","axis":"silent","repo":"linq2db/linq2db","sha":"41d25db46f0d2b6b726ed37b6ccf0b92d49fd0f1","parsed":{"files":[{"path":".github/workflows/build.yml","lines":["@@ -215,6 +215,25 @@ jobs:"," ","       - run: .build/publish/singlefile/linq2db.Tests.SingleFile.exe"," ","+  # Regression guard for #6042 / #6051: JIT-compiles every netfx-shipped assembly in an x86 process with","+  # FP exceptions unmasked, as C++Builder / Delphi hosts run them. Release, not Azure: it checks the","+  # binaries that ship and reads no test configuration.","+  fpu-jit-sweep:","+    name: x86 FPU-unmasked JIT sweep","+    runs-on: windows-2025","+    timeout-minutes: 30","+","+    steps:","+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+","+      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68 # v6.0.0","+        with:","+          dotnet-version: 10.x","+","+      - run: dotnet build Tests/Tests.FpuJit/Tests.FpuJit.csproj --configuration ${{ env.RELEASE_CONFIGURATION }} -p:RunAnalyzersDuringBuild=false -p:RunApiAnalyzersDuringBuild=false","+","+      - run: .build/bin/Tests.FpuJit/${{ env.RELEASE_CONFIGURATION }}/net462/linq2db.Tests.FpuJit.exe","+","   # Port of templates/test-cli.yml. No database, so it belongs here rather than in the provider matrix.","   cli-tests:","     name: CLI tests (${{ matrix.os }})"],"additions":19,"deletions":0,"truncated":false},{"path":"Source/LinqToDB/Internal/Common/FloatingPointHelper.cs","lines":["@@ -0,0 +1,28 @@","+using System;","+","+namespace LinqToDB.Internal.Common","+{","+\t// NaN/Infinity constants, and comparisons against them, make the x86 .NET Framework JIT fault when the host","+\t// unmasks FP exceptions (#6051), so the values are built and tested from their bit patterns.","+\t// Don't cache them in static readonly fields: the JIT folds those back into constants.","+\tinternal static class FloatingPointHelper","+\t{","+\t\tconst long NaNBits              = unchecked((long)0xFFF8000000000000); // == double.NaN","+\t\tconst long PositiveInfinityBits = 0x7FF0000000000000;","+\t\tconst long NegativeInfinityBits = unchecked((long)0xFFF0000000000000);","+","+\t\tpublic static double DoubleNaN              => BitConverter.Int64BitsToDouble(NaNBits);","+\t\tpublic static double DoublePositiveInfinity => BitConverter.Int64BitsToDouble(PositiveInfinityBits);","+\t\tpublic static double DoubleNegativeInfinity => BitConverter.Int64BitsToDouble(NegativeInfinityBits);","+","+\t\tpublic static float SingleNaN              => (float)DoubleNaN;","+\t\tpublic static float SinglePositiveInfinity => (float)DoublePositiveInfinity;","+\t\tpublic static float SingleNegativeInfinity => (float)DoubleNegativeInfinity;","+","+\t\tpublic static bool IsPositiveInfinity(double value) => BitConverter.DoubleToInt64Bits(value) == PositiveInfinityBits;","+\t\tpublic static bool IsNegativeInfinity(double value) => BitConverter.DoubleToInt64Bits(value) == NegativeInfinityBits;","+","+\t\tpublic static bool IsPositiveInfinity(float value) => IsPositiveInfinity((double)value);","+\t\tpublic static bool IsNegativeInfinity(float value) => IsNegativeInfinity((double)value);","+\t}","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"Source/LinqToDB/Internal/DataProvider/ClickHouse/ClickHouseMappingSchema.cs","lines":["@@ -951,18 +951,18 @@ static DateTimeOffset StringToDateTimeOffset(string raw)"," "," \t\t\tstatic float StringToFloat(string raw)"," \t\t\t{","-\t\t\t\tif (string.Equals(raw, \"-inf\", StringComparison.Ordinal)) return float.NegativeInfinity;","-\t\t\t\tif (string.Equals(raw, \"inf\", StringComparison.Ordinal)) return float.PositiveInfinity;","-\t\t\t\tif (string.Equals(raw, \"nan\", StringComparison.Ordinal)) return float.NaN;","+\t\t\t\tif (string.Equals(raw, \"-inf\", StringComparison.Ordinal)) return FloatingPointHelper.SingleNegativeInfinity;","+\t\t\t\tif (string.Equals(raw, \"inf\", StringComparison.Ordinal)) return FloatingPointHelper.SinglePositiveInfinity;","+\t\t\t\tif (string.Equals(raw, \"nan\", StringComparison.Ordinal)) return FloatingPointHelper.SingleNaN;"," "," \t\t\t\treturn float.Parse(raw, CultureInfo.InvariantCulture);"," \t\t\t}"," "," \t\t\tstatic double StringToDouble(string raw)"," \t\t\t{","-\t\t\t\tif (string.Equals(raw, \"-inf\", StringComparison.Ordinal)) return double.NegativeInfinity;","-\t\t\t\tif (string.Equals(raw, \"inf\", StringComparison.Ordinal)) return double.PositiveInfinity;","-\t\t\t\tif (string.Equals(raw, \"nan\", StringComparison.Ordinal)) return double.NaN;","+\t\t\t\tif (string.Equals(raw, \"-inf\", StringComparison.Ordinal)) return FloatingPointHelper.DoubleNegativeInfinity;","+\t\t\t\tif (string.Equals(raw, \"inf\", StringComparison.Ordinal)) return FloatingPointHelper.DoublePositiveInfinity;","+\t\t\t\tif (string.Equals(raw, \"nan\", StringComparison.Ordinal)) return FloatingPointHelper.DoubleNaN;"," "," \t\t\t\treturn double.Parse(raw, CultureInfo.InvariantCulture);"," \t\t\t}"],"additions":6,"deletions":6,"truncated":false},{"path":"Source/LinqToDB/Internal/DataProvider/DB2/DB2ProviderAdapter.cs","lines":["@@ -7,6 +7,7 @@"," "," using LinqToDB.Common;"," using LinqToDB.Extensions;","+using LinqToDB.Internal.Common;"," using LinqToDB.Internal.Expressions;"," using LinqToDB.Internal.Expressions.Types;"," using LinqToDB.Internal.Mapping;","@@ -195,10 +196,10 @@ void Register(Type toType, string method)"," \t\tstatic class DecimalFloatConverters"," \t\t{"," \t\t\t// \"NaN\"/\"Infinity\"/\"-Infinity\" parse natively; \"sNaN\" (signaling NaN) does not, so map it to NaN.","-\t\t\tpublic static double  ToDouble        (string s) => s is \"sNaN\" ? double.NaN : double.Parse(s, CultureInfo.InvariantCulture);","-\t\t\tpublic static float   ToSingle        (string s) => s is \"sNaN\" ? float .NaN : float .Parse(s, CultureInfo.InvariantCulture);","-\t\t\tpublic static double? ToDoubleNullable(string s) => s is \"sNaN\" ? double.NaN : double.Parse(s, CultureInfo.InvariantCulture);","-\t\t\tpublic static float?  ToSingleNullable(string s) => s is \"sNaN\" ? float .NaN : float .Parse(s, CultureInfo.InvariantCulture);","+\t\t\tpublic static double  ToDouble        (string s) => s is \"sNaN\" ? FloatingPointHelper.DoubleNaN : double.Parse(s, CultureInfo.InvariantCulture);","+\t\t\tpublic static float   ToSingle        (string s) => s is \"sNaN\" ? FloatingPointHelper.SingleNaN : float .Parse(s, CultureInfo.InvariantCulture);","+\t\t\tpublic static double? ToDoubleNullable(string s) => s is \"sNaN\" ? FloatingPointHelper.DoubleNaN : double.Parse(s, CultureInfo.InvariantCulture);","+\t\t\tpublic static float?  ToSingleNullable(string s) => s is \"sNaN\" ? FloatingPointHelper.SingleNaN : float .Parse(s, CultureInfo.InvariantCulture);"," "," \t\t\tpublic static decimal ToDecimal(string s) => IsSpecial(s) ? default : Parse(s);"," \t\t\tpublic static byte    ToByte   (string s) => IsSpecial(s) ? default : (byte)  Parse(s);"],"additions":5,"deletions":4,"truncated":false},{"path":"Source/LinqToDB/Internal/DataProvider/DuckDB/DuckDBMappingSchema.cs","lines":["@@ -5,6 +5,7 @@"," using System.Numerics;"," using System.Text;"," ","+using LinqToDB.Internal.Common;"," using LinqToDB.Internal.Mapping;"," using LinqToDB.Mapping;"," using LinqToDB.SqlQuery;","@@ -60,9 +61,9 @@ private static void BuildDouble(StringBuilder sb, double value)"," \t\t{"," \t\t\tif (double.IsNaN(value))"," \t\t\t\tsb.Append(\"'NaN'::DOUBLE\");","-\t\t\telse if (double.IsPositiveInfinity(value))","+\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(value))"," \t\t\t\tsb.Append(\"'Infinity'::DOUBLE\");","-\t\t\telse if (double.IsNegativeInfinity(value))","+\t\t\telse if (FloatingPointHelper.IsNegativeInfinity(value))"," \t\t\t\tsb.Append(\"'-Infinity'::DOUBLE\");"," \t\t\telse"," \t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, \"{0:G17}\", value);","@@ -72,9 +73,9 @@ private static void BuildFloat(StringBuilder sb, float value)"," \t\t{"," \t\t\tif (float.IsNaN(value))"," \t\t\t\tsb.Append(\"'NaN'::FLOAT\");","-\t\t\telse if (float.IsPositiveInfinity(value))","+\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(value))"," \t\t\t\tsb.Append(\"'Infinity'::FLOAT\");","-\t\t\telse if (float.IsNegativeInfinity(value))","+\t\t\telse if (FloatingPointHelper.IsNegativeInfinity(value))"," \t\t\t\tsb.Append(\"'-Infinity'::FLOAT\");"," \t\t\telse"," \t\t\t{","@@ -310,6 +311,8 @@ internal static bool IsPositiveInfinityTsNs(int year, byte month, byte day, byte"," \t\t\treturn nanosecond > 854775807;"," \t\t}"," ","-\t\tinternal static MappingSchema Instance { get; } = new DuckDBMappingSchema();","+\t\tstatic readonly Lazy<MappingSchema> _instance = new (() => new DuckDBMappingSchema());","+","+\t\tinternal static MappingSchema Instance => _instance.Value;"," \t}"," }"],"additions":8,"deletions":5,"truncated":false},{"path":"Source/LinqToDB/Internal/DataProvider/Firebird/FirebirdMappingSchema.cs","lines":["@@ -61,9 +61,9 @@ public sealed class FirebirdMappingSchema : LockedMappingSchema"," \t\t\t\tvar f = (float)v;"," \t\t\t\tif (float.IsNaN(f))"," \t\t\t\t\tsb.Append(\"CAST(LOG(1, 1) AS FLOAT)\");","-\t\t\t\telse if (float.IsNegativeInfinity(f))","+\t\t\t\telse if (FloatingPointHelper.IsNegativeInfinity(f))"," \t\t\t\t\tsb.Append(\"CAST(LOG(1, 0.5) AS FLOAT)\");","-\t\t\t\telse if (float.IsPositiveInfinity(f))","+\t\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(f))"," \t\t\t\t\tsb.Append(\"CAST(LOG(1, 2) AS FLOAT)\");"," \t\t\t\telse"," \t\t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, \"{0:G9}\", f);","@@ -74,9 +74,9 @@ public sealed class FirebirdMappingSchema : LockedMappingSchema"," \t\t\t\tvar d = (double)v;"," \t\t\t\tif (double.IsNaN(d))"," \t\t\t\t\tsb.Append(\"LOG(1, 1)\");","-\t\t\t\telse if (double.IsNegativeInfinity(d))","+\t\t\t\telse if (FloatingPointHelper.IsNegativeInfinity(d))"," \t\t\t\t\tsb.Append(\"LOG(1, 0.5)\");","-\t\t\t\telse if (double.IsPositiveInfinity(d))","+\t\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(d))"," \t\t\t\t\tsb.Append(\"LOG(1, 2)\");"," \t\t\t\telse"," \t\t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, \"{0:G17}\", d);"],"additions":4,"deletions":4,"truncated":false},{"path":"Source/LinqToDB/Internal/DataProvider/Oracle/OracleMappingSchema.cs","lines":["@@ -89,9 +89,9 @@ public sealed class OracleMappingSchema : LockedMappingSchema"," \t\t\t\tvar f = (float)v;"," \t\t\t\tif (float.IsNaN(f))"," \t\t\t\t\tsb.Append(\"BINARY_FLOAT_NAN\");","-\t\t\t\telse if (float.IsNegativeInfinity(f))","+\t\t\t\telse if (FloatingPointHelper.IsNegativeInfinity(f))"," \t\t\t\t\tsb.Append(\"-BINARY_FLOAT_INFINITY\");","-\t\t\t\telse if (float.IsPositiveInfinity(f))","+\t\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(f))"," \t\t\t\t\tsb.Append(\"BINARY_FLOAT_INFINITY\");"," \t\t\t\telse"," \t\t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, \"{0:G9}\", f);","@@ -101,9 +101,9 @@ public sealed class OracleMappingSchema : LockedMappingSchema"," \t\t\t\tvar d = (double)v;"," \t\t\t\tif (double.IsNaN(d))"," \t\t\t\t\tsb.Append(\"BINARY_DOUBLE_NAN\");","-\t\t\t\telse if (double.IsNegativeInfinity(d))","+\t\t\t\telse if (FloatingPointHelper.IsNegativeInfinity(d))"," \t\t\t\t\tsb.Append(\"-BINARY_DOUBLE_INFINITY\");","-\t\t\t\telse if (double.IsPositiveInfinity(d))","+\t\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(d))"," \t\t\t\t\tsb.Append(\"BINARY_DOUBLE_INFINITY\");"," \t\t\t\telse"," \t\t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, \"{0:G17}D\", d);"],"additions":4,"deletions":4,"truncated":false},{"path":"Source/LinqToDB/Internal/DataProvider/Ydb/YdbMappingSchema.cs","lines":["@@ -608,9 +608,9 @@ private static void BuildUInt64Literal(StringBuilder sb, ulong value)"," "," \t\tprivate static void BuildFloatLiteral(StringBuilder sb, float value)"," \t\t{","-\t\t\tif (float.IsNegativeInfinity(value))","+\t\t\tif (FloatingPointHelper.IsNegativeInfinity(value))"," \t\t\t\tsb.Append(\"Float('-inf')\");","-\t\t\telse if (float.IsPositiveInfinity(value))","+\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(value))"," \t\t\t\tsb.Append(\"Float('inf')\");"," \t\t\telse"," \t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, FLOAT_FORMAT, value);","@@ -618,9 +618,9 @@ private static void BuildFloatLiteral(StringBuilder sb, float value)"," "," \t\tprivate static void BuildDoubleLiteral(StringBuilder sb, double value)"," \t\t{","-\t\t\tif (double.IsNegativeInfinity(value))","+\t\t\tif (FloatingPointHelper.IsNegativeInfinity(value))"," \t\t\t\tsb.Append(\"Double('-inf')\");","-\t\t\telse if (double.IsPositiveInfinity(value))","+\t\t\telse if (FloatingPointHelper.IsPositiveInfinity(value))"," \t\t\t\tsb.Append(\"Double('inf')\");"," \t\t\telse"," \t\t\t\tsb.AppendFormat(CultureInfo.InvariantCulture, DOUBLE_FORMAT, value);"],"additions":4,"deletions":4,"truncated":false},{"path":"Tests/Linq/Mapping/SpecialFloatingPointValueTests.cs","lines":["@@ -0,0 +1,104 @@","+using System;","+using System.Text;","+","+using LinqToDB;","+using LinqToDB.DataProvider;","+using LinqToDB.DataProvider.ClickHouse;","+using LinqToDB.DataProvider.Firebird;","+using LinqToDB.DataProvider.Oracle;","+","+#if !NETFRAMEWORK","+using LinqToDB.DataProvider.DuckDB;","+using LinqToDB.DataProvider.Ydb;","+#endif","+","+using NUnit.Framework;","+","+using Shouldly;","+","+namespace Tests.Mapping","+{","+\t// NaN / ±Infinity through the provider literal builders and the ClickHouse MySql string conversions, which test and","+\t// build them from bit patterns (https://github.com/linq2db/linq2db/issues/6051). The JIT fault itself is guarded by","+\t// Tests/Tests.FpuJit; these pin the produced values.","+\t[TestFixture]","+\tpublic class SpecialFloatingPointValueTests : TestBase","+\t{","+\t\t// version-pinned factories: the unversioned ones auto-detect by opening a connection","+\t\tstatic IDataProvider GetProvider(string provider) => provider switch","+\t\t{","+\t\t\t\"Oracle\"   => OracleTools.GetDataProvider(OracleVersion.v12, OracleProvider.Managed),","+\t\t\t\"Firebird\" => FirebirdTools.GetDataProvider(FirebirdVersion.v5),","+#if !NETFRAMEWORK","+\t\t\t\"DuckDB\"   => DuckDBTools.GetDataProvider(),","+\t\t\t\"Ydb\"      => YdbTools.GetDataProvider(),","+#endif","+\t\t\t_          => throw new ArgumentOutOfRangeException(nameof(provider), provider, null),","+\t\t};","+","+\t\tstatic string Literal(IDataProvider provider, object value)","+\t\t{","+\t\t\tvar sb = new StringBuilder();","+","+\t\t\tprovider.MappingSchema.ValueToSqlConverter.Convert(sb, provider.MappingSchema, new DataOptions(), value);","+","+\t\t\treturn sb.ToString();","+\t\t}","+","+\t\t[TestCase(\"Oracle\",   \"BINARY_DOUBLE_NAN\", \"BINARY_DOUBLE_INFINITY\", \"-BINARY_DOUBLE_INFINITY\", \"1.5D\")]","+\t\t[TestCase(\"Firebird\", \"LOG(1, 1)\",         \"LOG(1, 2)\",              \"LOG(1, 0.5)\",             \"1.5\")]","+#if !NETFRAMEWORK","+\t\t[TestCase(\"DuckDB\",   \"'NaN'::DOUBLE\",     \"'Infinity'::DOUBLE\",     \"'-Infinity'::DOUBLE\",     \"1.5\")]","+\t\t[TestCase(\"Ydb\",      \"Double('NaN')\",     \"Double('inf')\",          \"Double('-inf')\",          \"Double('1.5')\")]","+#endif","+\t\tpublic void DoubleLiterals(string provider, string nan, string positiveInfinity, string negativeInfinity, string finite)","+\t\t{","+\t\t\tvar dataProvider = GetProvider(provider);","+","+\t\t\tLiteral(dataProvider, double.NaN).ShouldBe(nan);","+\t\t\tLiteral(dataProvider, double.PositiveInfinity).ShouldBe(positiveInfinity);","+\t\t\tLiteral(dataProvider, double.NegativeInfinity).ShouldBe(negativeInfinity);","+\t\t\tLiteral(dataProvider, 1.5d).ShouldBe(finite);","+\t\t}","+","+\t\t[TestCase(\"Oracle\",   \"BINARY_FLOAT_NAN\",         \"BINARY_FLOAT_INFINITY\",    \"-BINARY_FLOAT_INFINITY\",     \"1.5\")]","+\t\t[TestCase(\"Firebird\", \"CAST(LOG(1, 1) AS FLOAT)\", \"CAST(LOG(1, 2) AS FLOAT)\", \"CAST(LOG(1, 0.5) AS FLOAT)\", \"1.5\")]","+#if !NETFRAMEWORK","+\t\t[TestCase(\"DuckDB\",   \"'NaN'::FLOAT\",             \"'Infinity'::FLOAT\",        \"'-Infinity'::FLOAT\",         \"'1.5'::FLOAT\")]","+\t\t[TestCase(\"Ydb\",      \"Float('NaN')\",             \"Float('inf')\",             \"Float('-inf')\",              \"Float('1.5')\")]","+#endif","+\t\tpublic void FloatLiterals(string provider, string nan, string positiveInfinity, string negativeInfinity, string finite)","+\t\t{","+\t\t\tvar dataProvider = GetProvider(provider);","+","+\t\t\tLiteral(dataProvider, float.NaN).ShouldBe(nan);","+\t\t\tLiteral(dataProvider, float.PositiveInfinity).ShouldBe(positiveInfinity);","+\t\t\tLiteral(dataProvider, float.NegativeInfinity).ShouldBe(negativeInfinity);","+\t\t\tLiteral(dataProvider, 1.5f).ShouldBe(finite);","+\t\t}","+","+\t\t[Test(Description = \"https://github.com/linq2db/linq2db/issues/6051\")]","+\t\tpublic void ClickHouseMySqlStringToDouble()","+\t\t{","+\t\t\tvar mappingSchema = ClickHouseTools.GetDataProvider(ClickHouseProvider.MySqlConnector).MappingSchema;","+\t\t\tvar convert       = mappingSchema.GetConvertExpression<string, double>(checkNull: false, createDefault: false)!.Compile();","+","+\t\t\tBitConverter.DoubleToInt64Bits(convert(\"nan\")).ShouldBe(BitConverter.DoubleToInt64Bits(double.NaN));","+\t\t\tconvert(\"inf\").ShouldBe(double.PositiveInfinity);","+\t\t\tconvert(\"-inf\").ShouldBe(double.NegativeInfinity);","+\t\t\tconvert(\"1.5\").ShouldBe(1.5d);","+\t\t}","+","+\t\t[Test(Description = \"https://github.com/linq2db/linq2db/issues/6051\")]","+\t\tpublic void ClickHouseMySqlStringToFloat()","+\t\t{","+\t\t\tvar mappingSchema = ClickHouseTools.GetDataProvider(ClickHouseProvider.MySqlConnector).MappingSchema;","+\t\t\tvar convert       = mappingSchema.GetConvertExpression<string, float>(checkNull: false, createDefault: false)!.Compile();","+","+\t\t\tBitConverter.GetBytes(convert(\"nan\")).ShouldBe(BitConverter.GetBytes(float.NaN));","+\t\t\tconvert(\"inf\").ShouldBe(float.PositiveInfinity);","+\t\t\tconvert(\"-inf\").ShouldBe(float.NegativeInfinity);","+\t\t\tconvert(\"1.5\").ShouldBe(1.5f);","+\t\t}","+\t}","+}"],"additions":104,"deletions":0,"truncated":false},{"path":"Tests/Tests.FpuJit/Program.cs","lines":["@@ -0,0 +1,762 @@","+// Regression gate for #6042 / #6051: hosts that unmask x87/SSE floating-point exceptions (C++Builder, Delphi)","+// make the x86 .NET Framework JIT fault while compiling methods that use NaN/Infinity constants.","+// The exe JIT-compiles every method of every netfx-shipped linq2db assembly with those exceptions unmasked, generic","+// ones once with constraint-satisfying arguments. Not covered: the LINQPad driver, value-type instantiations other","+// than the one tried, generic definitions no substitute closes (reported), and expression trees compiled at run time.","+using System;","+using System.Collections.Generic;","+using System.Diagnostics;","+using System.Diagnostics.CodeAnalysis;","+using System.IO;","+using System.Linq;","+using System.Reflection;","+using System.Runtime.CompilerServices;","+using System.Runtime.ExceptionServices;","+using System.Runtime.InteropServices;","+using System.Security;","+","+namespace Tests.FpuJit","+{","+\tstatic class Program","+\t{","+\t\t// Keep in sync with the ProjectReferences in Tests.FpuJit.csproj.","+\t\tstatic readonly string[] ExpectedAssemblies =","+\t\t{","+\t\t\t\"linq2db\",","+\t\t\t\"linq2db.Compat\",","+\t\t\t\"linq2db.EntityFrameworkCore\",","+\t\t\t\"linq2db.Extensions\",","+\t\t\t\"linq2db.FSharp\",","+\t\t\t\"linq2db.Remote.Grpc\",","+\t\t\t\"linq2db.Remote.HttpClient.Client\",","+\t\t\t\"linq2db.Remote.SignalR.Client\",","+\t\t\t\"linq2db.Remote.SignalR.Server\",","+\t\t\t\"linq2db.Remote.Wcf\",","+\t\t\t\"linq2db.Scaffold\",","+\t\t\t\"linq2db.Tools\",","+\t\t};","+","+\t\t// Methods that may be skipped because a dependency does not load: (assembly, message fragment, reason).","+\t\t// A skip does not restart the child, so whatever its prepare compiles after a control-word reset stays","+\t\t// compiled masked and is later counted OK; an entry here accepts that as well.","+\t\tstatic readonly (string Assembly, string MessagePart, string Reason)[] AllowedDependencySkips = [];","+","+\t\t// Methods that may stay unverified because compiling them resets the FPU control word even in a fresh process:","+\t\t// (assembly, method display prefix, reason). A warm-up \"<Type>::.cctor()\" record does not restart the child, so","+\t\t// whatever that initializer compiles after its reset stays compiled masked and is later counted OK; an entry","+\t\t// matching it accepts that as well.","+\t\tstatic readonly (string Assembly, string MethodPrefix, string Reason)[] AllowedUnverified = [];","+","+\t\tconst string CanaryAssembly   = \"canary\";","+\t\tconst int    MaxRestarts      = 100;","+\t\tconst int    ChildTimeoutMs   = 10 * 60 * 1000;","+\t\tconst uint   FpuExceptionMask = 0x10 | 0x08 | 0x04; // _EM_INVALID | _EM_ZERODIVIDE | _EM_OVERFLOW","+","+\t\tconst int ExitOk          = 0;","+\t\tconst int ExitJitFaults   = 1;","+\t\tconst int ExitEnvironment = 2;","+\t\tconst int ExitHarness     = 3;","+\t\tconst int ExitRestart     = 4;","+","+\t\t[DllImport(\"msvcrt.dll\", CallingConvention = CallingConvention.Cdecl), DefaultDllImportSearchPaths(DllImportSearchPath.System32)]","+\t\tstatic extern uint _control87(uint newValue, uint mask);","+","+\t\t// msvcrt has no __control87_2","+\t\t[DllImport(\"ucrtbase.dll\", CallingConvention = CallingConvention.Cdecl), DefaultDllImportSearchPaths(DllImportSearchPath.System32)]","+\t\tstatic extern int __control87_2(uint newValue, uint mask, out uint x87, out uint sse);","+","+\t\t// set when a managed exception finds the SSE word masked: the exception resets only the x87 word, so a native","+\t\t// reset came first, and the re-arm on that exception hides it from the control-word checks","+\t\t[ThreadStatic]","+\t\tstatic bool _nativeReset;","+","+\t\t[DllImport(\"kernel32.dll\"), DefaultDllImportSearchPaths(DllImportSearchPath.System32)]","+\t\tstatic extern uint SetErrorMode(uint mode);","+","+\t\tstatic int Main(string[] args)","+\t\t{","+\t\t\t// SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX: a child killed by a JIT fault must not raise a WER dialog","+\t\t\tSetErrorMode(0x0001 | 0x0002);","+","+\t\t\tif (Environment.Is64BitProcess)","+\t\t\t{","+\t\t\t\tConsole.WriteLine(\"ERROR: must run as x86 (32-bit) process; the fault does not exist on x64\");","+\t\t\t\treturn ExitEnvironment;","+\t\t\t}","+","+\t\t\tif (args.Length >= 2 && args[0] == \"--child\")","+\t\t\t\treturn RunChild(args[1], args.Length >= 4 ? args[3] : null, args.Length >= 4 && args[2] == \"--resume-at\");","+","+\t\t\treturn RunParent();","+\t\t}","+","+\t\t// Positive controls: each must fault under the unmasked FPU, or the sweep proves nothing; the generic ones","+\t\t// prove the instantiation path.","+\t\t[MethodImpl(MethodImplOptions.NoInlining)]","+\t\tstatic double Canary() => double.NaN;","+","+\t\t[MethodImpl(MethodImplOptions.NoInlining)]","+\t\tstatic object GenericCanary<T>() => double.NaN;","+","+\t\tstatic class GenericCanaryType<T>","+\t\t{","+\t\t\t[MethodImpl(MethodImplOptions.NoInlining)]","+\t\t\tpublic static double Canary() => double.NaN;","+\t\t}","+","+\t\t#region Parent","+","+\t\tstatic int RunParent()","+\t\t{","+\t\t\tvar dir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, \"fpujit-run\");","+\t\t\tDirectory.CreateDirectory(dir);","+","+\t\t\tvar resultsPath = Path.Combine(dir, \"results.txt\");","+\t\t\tFile.Delete(resultsPath);","+","+\t\t\tstring? resumeId = null;","+\t\t\tvar     resumeAt = false;","+","+\t\t\tfor (var restart = 0; ; restart++)","+\t\t\t{","+\t\t\t\tif (restart > MaxRestarts)","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: more than {MaxRestarts} child restarts\");","+\t\t\t\t\treturn Stop(File.ReadAllLines(resultsPath), ExitHarness);","+\t\t\t\t}","+","+\t\t\t\tvar exitCode = SpawnChild(resultsPath, resumeId, resumeAt, out var timedOut);","+\t\t\t\tvar lines    = File.ReadAllLines(resultsPath);","+","+\t\t\t\tvar error = lines.FirstOrDefault(l => l.StartsWith(\"ERROR\\t\", StringComparison.Ordinal));","+\t\t\t\tif (error != null)","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: {error.Substring(6)}\");","+\t\t\t\t\treturn Stop(lines, exitCode == ExitHarness ? ExitHarness : ExitEnvironment);","+\t\t\t\t}","+","+\t\t\t\tif (lines.Contains(\"DONE\"))","+\t\t\t\t\treturn Report(lines);","+","+\t\t\t\tvar last = lines.LastOrDefault();","+\t\t\t\tif (last != null && last.StartsWith(\"RESTART\\t\", StringComparison.Ordinal))","+\t\t\t\t{","+\t\t\t\t\t// RESTART <id> at|after: \"at\" retries the method in a fresh process, its type initializers already run;","+\t\t\t\t\t// if it resets again it cannot be verified.","+\t\t\t\t\tvar restartParts = last.Split('\\t');","+\t\t\t\t\tvar id           = restartParts[1];","+","+\t\t\t\t\tif (restartParts[2] == \"after\")","+\t\t\t\t\t{","+\t\t\t\t\t\tresumeId = id;","+\t\t\t\t\t\tresumeAt = false;","+\t\t\t\t\t}","+\t\t\t\t\telse if (resumeAt && id == resumeId)","+\t\t\t\t\t{","+\t\t\t\t\t\tvar reset = lines[lines.Length - 2].Split('\\t');","+\t\t\t\t\t\tFile.AppendAllText(resultsPath, $\"UNVERIFIED\\t{reset[1]}\\t{reset[2]}\\t{id}\\n\");","+\t\t\t\t\t\tresumeAt = false;","+\t\t\t\t\t}","+\t\t\t\t\telse","+\t\t\t\t\t{","+\t\t\t\t\t\tresumeId = id;","+\t\t\t\t\t\tresumeAt = true;","+\t\t\t\t\t}","+","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+","+\t\t\t\tif (last == null || !last.StartsWith(\"PREP\\t\", StringComparison.Ordinal))","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: child exited with 0x{exitCode:X8} outside a method prepare\");","+\t\t\t\t\treturn Stop(lines, ExitHarness);","+\t\t\t\t}","+","+\t\t\t\t// PREP <asm> <id> <display>: the method being compiled when the child died","+\t\t\t\tvar parts = last.Split('\\t');","+\t\t\t\tFile.AppendAllText(resultsPath, $\"CRASH\\t{parts[1]}\\t{parts[2]}\\t{parts[3]}\\t{(timedOut ? \"timeout\" : $\"process exit 0x{exitCode:X8}\")}\\n\");","+","+\t\t\t\tresumeId = parts[2];","+\t\t\t\tresumeAt = false;","+\t\t\t}","+\t\t}","+","+\t\tstatic int SpawnChild(string resultsPath, string? resumeId, bool resumeAt, out bool timedOut)","+\t\t{","+\t\t\tvar arguments = $\"--child \\\"{resultsPath}\\\"\";","+\t\t\tif (resumeId != null)","+\t\t\t\targuments += $\" {(resumeAt ? \"--resume-at\" : \"--resume-after\")} {resumeId}\";","+","+\t\t\tvar psi = new ProcessStartInfo(typeof(Program).Assembly.Location, arguments)","+\t\t\t{","+\t\t\t\tUseShellExecute = false,","+\t\t\t\tCreateNoWindow  = true,","+\t\t\t};","+","+\t\t\tusing var process = Process.Start(psi)!;","+","+\t\t\ttimedOut = !process.WaitForExit(ChildTimeoutMs);","+\t\t\tif (timedOut)","+\t\t\t{","+\t\t\t\tprocess.Kill();","+\t\t\t\tprocess.WaitForExit();","+\t\t\t}","+","+\t\t\treturn process.ExitCode;","+\t\t}","+","+\t\tstatic int Report(string[] lines)","+\t\t{","+\t\t\tvar records = lines","+\t\t\t\t.Select(l => l.Split('\\t'))","+\t\t\t\t.ToList();","+","+\t\t\tvar faults = Faults(lines);","+","+\t\t\t// enumeration-time records are re-written by every restarted child","+\t\t\tList<string[]> Distinct(string kind) => lines","+\t\t\t\t.Where(l => l.StartsWith(kind + \"\\t\", StringComparison.Ordinal))","+\t\t\t\t.Distinct(StringComparer.Ordinal)","+\t\t\t\t.Select(l => l.Split('\\t'))","+\t\t\t\t.ToList();","+","+\t\t\tvar dependencySkips = Distinct(\"SKIPDEP\");","+\t\t\tvar unclosed        = Distinct(\"SKIPGEN\");","+\t\t\tvar canaries        = Distinct(\"CANARY\");","+","+\t\t\tvar unverifiedIds = new HashSet<string>(records.Where(r => r[0] == \"UNVERIFIED\").Select(r => r[3]), StringComparer.Ordinal);","+","+\t\t\tvar exitCode = ExitOk;","+","+\t\t\tConsole.WriteLine(\"FPU JIT sweep: x86, FP invalid/zero-divide/overflow exceptions unmasked\");","+\t\t\tConsole.WriteLine();","+","+\t\t\tforeach (var asm in ExpectedAssemblies)","+\t\t\t{","+\t\t\t\t// distinct methods: a method retried after a control-word reset writes OK twice; unverified ones do not count","+\t\t\t\tvar ok      = records.Where(r => r[0] == \"OK\" && r[1] == asm && !unverifiedIds.Contains(r[2])).Select(r => r[2]).Distinct(StringComparer.Ordinal).Count();","+\t\t\t\tvar failed  = faults.Count(r => r[1] == asm);","+\t\t\t\tvar skips   = dependencySkips.Where(r => r[1] == asm).ToList();","+\t\t\t\tvar allowed = skips.Count(r => IsAllowedSkip(asm, r[4]));","+\t\t\t\tvar generic = unclosed.Count(r => r[1] == asm);","+","+\t\t\t\tConsole.WriteLine($\"  {asm,-34} ok={ok,6} faults={failed,3} dependency-skips={skips.Count,4} (allowed {allowed}) generic-not-closable={generic,5}\");","+","+\t\t\t\tif (ok == 0)","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: no method of {asm} was compiled\");","+\t\t\t\t\texitCode = ExitEnvironment;","+\t\t\t\t}","+","+\t\t\t\tforeach (var skip in skips.Where(r => !IsAllowedSkip(asm, r[4])))","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: dependency-load skip in {asm}: {skip[3]} — {skip[4]}\");","+\t\t\t\t\texitCode = ExitEnvironment;","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tConsole.WriteLine();","+","+\t\t\tif (canaries.Count == 0)","+\t\t\t{","+\t\t\t\tConsole.WriteLine(\"ERROR: no canary was enumerated\");","+\t\t\t\texitCode = ExitHarness;","+\t\t\t}","+","+\t\t\tforeach (var canary in canaries)","+\t\t\t{","+\t\t\t\tvar fault = faults.FirstOrDefault(r => r[1] == CanaryAssembly && r[2] == canary[1]);","+\t\t\t\tif (fault == null)","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: canary did not fault: {canary[2]} — this environment or instantiation path does not reproduce the FPU JIT fault, so the sweep proves nothing\");","+\t\t\t\t\texitCode = ExitEnvironment;","+\t\t\t\t}","+\t\t\t\telse","+\t\t\t\t\tConsole.WriteLine($\"canary faulted as expected: {canary[2]} — {fault[4]}\");","+\t\t\t}","+","+\t\t\tvar resets = records.Where(r => r[0] == \"FPURESET\").ToList();","+\t\t\tif (resets.Count > 0)","+\t\t\t\tConsole.WriteLine($\"FPU control word was reset while preparing {resets.Count} method(s); first: {resets[0][1]} {resets[0][2]}\");","+","+\t\t\t// methods of a type whose initializer faulted reset on every retry; that fault already fails the sweep","+\t\t\tvar failedInitializers = faults","+\t\t\t\t.Where(r => r[2].StartsWith(r[1] + \":cctor:\", StringComparison.Ordinal))","+\t\t\t\t.Select(r => r[2].Substring(r[1].Length + \":cctor:\".Length))","+\t\t\t\t.ToList();","+","+\t\t\t// a warm-up record is re-written by every child that runs the initializer","+\t\t\tforeach (var unverified in Distinct(\"UNVERIFIED\"))","+\t\t\t{","+\t\t\t\tvar allowed = AllowedUnverified.FirstOrDefault(a => a.Assembly == unverified[1] && unverified[2].StartsWith(a.MethodPrefix, StringComparison.Ordinal));","+\t\t\t\tvar failed  = failedInitializers.FirstOrDefault(t => unverified[2].StartsWith(t + \"::\", StringComparison.Ordinal) || unverified[2].StartsWith(t + \"+\", StringComparison.Ordinal));","+","+\t\t\t\tif (allowed.Reason != null)","+\t\t\t\t\tConsole.WriteLine($\"unverified (allowed) {unverified[1]} {unverified[2]}\");","+\t\t\t\telse if (failed != null)","+\t\t\t\t\tConsole.WriteLine($\"unverified (initializer of {failed} faulted) {unverified[1]} {unverified[2]}\");","+\t\t\t\telse","+\t\t\t\t{","+\t\t\t\t\tConsole.WriteLine($\"ERROR: unverified {unverified[1]} {unverified[2]} — preparing it resets the FPU control word even in a fresh process\");","+\t\t\t\t\texitCode = ExitEnvironment;","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tvar real = faults.Where(r => r[1] != CanaryAssembly).ToList();","+","+\t\t\tforeach (var fault in real)","+\t\t\t\tPrintFault(fault);","+","+\t\t\tConsole.WriteLine();","+\t\t\tConsole.WriteLine($\"result: {real.Count} JIT fault(s)\");","+","+\t\t\tif (exitCode == ExitOk && real.Count > 0)","+\t\t\t\texitCode = ExitJitFaults;","+","+\t\t\treturn exitCode;","+\t\t}","+","+\t\t// A harness stop skips Report; without this a run cut off by the restart cap (one restart per fault on runners","+\t\t// where a fault kills the process) names none of the methods that faulted.","+\t\tstatic int Stop(string[] lines, int exitCode)","+\t\t{","+\t\t\tvar real = Faults(lines).Where(r => r[1] != CanaryAssembly).ToList();","+","+\t\t\tif (real.Count > 0)","+\t\t\t{","+\t\t\t\tConsole.WriteLine($\"{real.Count} JIT fault(s) recorded before the stop:\");","+","+\t\t\t\tforeach (var fault in real)","+\t\t\t\t\tPrintFault(fault);","+\t\t\t}","+","+\t\t\treturn exitCode;","+\t\t}","+","+\t\t// a type initializer failure is re-written by every child that runs it","+\t\tstatic List<string[]> Faults(string[] lines) => lines","+\t\t\t.Select(l => l.Split('\\t'))","+\t\t\t.Where(r => r[0] is \"FAIL\" or \"CRASH\")","+\t\t\t.GroupBy(r => r[2], StringComparer.Ordinal)","+\t\t\t.Select(g => g.First())","+\t\t\t.ToList();","+","+\t\tstatic void PrintFault(string[] fault) => Console.WriteLine($\"{fault[0]} {fault[1]} {fault[3]} — {fault[4]}\");","+","+\t\tstatic bool IsAllowedSkip(string asm, string message)","+\t\t{","+\t\t\treturn AllowedDependencySkips.Any(a => a.Assembly == asm && message.Contains(a.MessagePart));","+\t\t}","+","+\t\t#endregion","+","+\t\t#region Child","+","+\t\tsealed class Item(string asm, string id, string display, MethodBase method, Type type, RuntimeTypeHandle[]? instantiation)","+\t\t{","+\t\t\tpublic string               Asm           { get; } = asm;","+\t\t\tpublic string               Id            { get; } = id;"],"additions":358,"deletions":0,"truncated":false}],"additions":540,"deletions":27,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-19T15:01:11.260903+00:00"}