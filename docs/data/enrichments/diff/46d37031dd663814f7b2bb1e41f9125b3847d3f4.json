{"id":"46d37031dd663814f7b2bb1e41f9125b3847d3f4","axis":"silent","repo":"uber/deck.gl","sha":"46d37031dd663814f7b2bb1e41f9125b3847d3f4","parsed":{"files":[{"path":"docs/api-reference/core/shadow-map-effect.md","lines":["@@ -0,0 +1,25 @@","+# ShadowMapEffect","+","+`ShadowMapEffect` adds soft, cascaded directional shadows to a WebGPU scene using luma.gl's `ShadowMapRenderer`. Pair it with a `LightingEffect` to light the scene and pass the same direction to both effects.","+","+```ts","+import {Deck, DirectionalLight, LightingEffect, ShadowMapEffect} from '@deck.gl/core';","+","+const direction: [number, number, number] = [1, -0.5, -1];","+const deck = new Deck({","+  deviceProps: {type: 'webgpu'},","+  effects: [","+    new LightingEffect({sun: new DirectionalLight({direction})}),","+    new ShadowMapEffect({direction, quality: 'balanced'})","+  ],","+  layers","+});","+```","+","+## Options","+","+- `direction` is the direction the light travels in Deck common space.","+- `quality` is `'low'`, `'balanced'`, or `'cinematic'`. Higher quality increases the shadow-map resolution and sampling cost. The default is `'balanced'`.","+- `shadowColor` is a normalized RGBA tint. The default is `[0, 0, 0, 0.6]`.","+","+The effect renders shadows for one WebGPU viewport with a finite, positive camera depth range. Set `repeat: false` when using a map view with world wrapping. Set `shadowEnabled: false` on a layer that should receive shadows without casting them. Leave the experimental `DirectionalLight._shadow` option disabled when using this effect, since that option selects the shadow pass built into `LightingEffect`."],"additions":25,"deletions":0,"truncated":false},{"path":"docs/table-of-contents.json","lines":["@@ -255,7 +255,8 @@","         \"label\": \"Effects\",","         \"items\": [","           \"api-reference/core/lighting-effect\",","-          \"api-reference/core/post-process-effect\"","+          \"api-reference/core/post-process-effect\",","+          \"api-reference/core/shadow-map-effect\"","         ]","       },","       {"],"additions":2,"deletions":1,"truncated":false},{"path":"modules/core/src/effects/lighting/shadow-map-effect.ts","lines":["@@ -0,0 +1,254 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import type {RenderPipelineParameters} from '@luma.gl/core';","+import {","+  ShadowMapRenderer,","+  type ShadowCamera,","+  type ShadowRenderView,","+  type ShadowShaderProps","+} from '@luma.gl/engine/lighting';","+import {shadow} from '@luma.gl/shaders';","+import {Matrix4} from '@math.gl/core/matrix';","+import type {ShaderModule, ShaderPlugin} from '@luma.gl/shaders';","+import type {Effect, EffectContext, PreRenderOptions} from '../../lib/effect';","+import type Layer from '../../lib/layer';","+import LayersPass from '../../passes/layers-pass';","+import project from '../../shaderlib/project/project';","+import type Viewport from '../../viewports/viewport';","+","+const shadowMap = {","+  name: 'deckShadowMap',","+  source: /* wgsl */ `","+struct DeckShadowMapUniforms {","+  caster: i32,","+  matrix: mat4x4f,","+  viewMatrix: mat4x4f,","+  color: vec4f,","+  commonOrigin: vec3f,","+  unitsPerMeter: f32,","+};","+@group(0) @binding(auto) var<uniform> deckShadowMap: DeckShadowMapUniforms;","+`,","+  dependencies: [project, shadow],","+  uniformTypes: {","+    caster: 'i32',","+    matrix: 'mat4x4<f32>',","+    viewMatrix: 'mat4x4<f32>',","+    color: 'vec4<f32>',","+    commonOrigin: 'vec3<f32>',","+    unitsPerMeter: 'f32'","+  }","+} as const satisfies ShaderModule;","+","+const plugin: ShaderPlugin = {","+  name: 'deckShadowMap',","+  module: shadowMap,","+  interStageVariables: {","+    deckShadowMap_position: {type: 'vec4<f32>'},","+    deckShadowMap_normal: {type: 'vec3<f32>'}","+  },","+  injections: {","+    'wgsl:vs:DECKGL_FILTER_GL_POSITION': /* wgsl */ `","+if (geometry.position.w != 0.0 && deckShadowMap.unitsPerMeter > 0.0) {","+  let centeredPosition = geometry.position.xyz + (project.commonOrigin - deckShadowMap.commonOrigin);","+  deckShadowMap_position = vec4f(centeredPosition / deckShadowMap.unitsPerMeter, 1.0);","+  deckShadowMap_normal = geometry.normal;","+}","+if (deckShadowMap.caster != 0) {","+  // Vertices without a common-space position must not cast in camera clip space.","+  if (deckShadowMap_position.w > 0.0) {","+    *position = deckShadowMap.matrix * deckShadowMap_position;","+  } else {","+    *position = vec4f(0.0, 0.0, 2.0, 1.0);","+  }","+}","+`,","+    'wgsl:fs:DECKGL_FILTER_COLOR': /* wgsl */ `","+if (deckShadowMap.caster == 0 && deckShadowMap_position.w > 0.0 && shadow.directionalLightCount > 0) {","+  let position = deckShadowMap_position;","+  let viewDepth = -(deckShadowMap.viewMatrix * position).z;","+  let normal = select(vec3f(0.0, 0.0, 1.0), deckShadowMap_normal,","+    dot(deckShadowMap_normal, deckShadowMap_normal) > 0.0);","+  let visibility = shadow_getDirectionalFactor(position.xyz, normal, viewDepth);","+  (*color) = vec4f(mix((*color).rgb, deckShadowMap.color.rgb,","+    (1.0 - visibility) * deckShadowMap.color.a), (*color).a);","+}","+`","+  }","+};","+","+/** Settings for opt-in WebGPU directional shadow maps. */","+export type ShadowMapEffectProps = {","+  /** Direction the light travels, in Deck common space. */","+  direction: [number, number, number];","+  /** Cascaded shadow quality. Defaults to balanced. */","+  quality?: 'low' | 'balanced' | 'cinematic';","+  /** Shadow tint as normalized RGBA. */","+  shadowColor?: [number, number, number, number];","+};","+","+/** Renders cascaded directional shadows using luma.gl's ShadowMapRenderer on WebGPU. */","+export class ShadowMapEffect implements Effect {","+  readonly id = 'deck-shadow-map';","+  readonly useInPicking = true;","+  private renderer?: ShadowMapRenderer;","+  private fallbackRenderer?: ShadowMapRenderer;","+  private casterPass?: CascadeCasterPass;","+  private emptyShadowProps?: ShadowShaderProps;","+  private frame?: {shadow: ShadowShaderProps; camera: ShadowCamera; viewport: Viewport};","+","+  constructor(public props: ShadowMapEffectProps) {}","+","+  setup({device, deck}: EffectContext): void {","+    if (device.type !== 'webgpu') {","+      throw new Error('ShadowMapEffect requires WebGPU');","+    }","+    this.renderer = new ShadowMapRenderer(device, {","+      quality: this.props.quality,","+      spotLightCapacity: 0,","+      pointLightCapacity: 0,","+      spotMapSize: 1,","+      pointMapSize: 1","+    });","+    this.fallbackRenderer = new ShadowMapRenderer(device, {","+      directionalMapSize: 1,","+      directionalLightCapacity: 0,","+      spotLightCapacity: 0,","+      pointLightCapacity: 0,","+      spotMapSize: 1,","+      pointMapSize: 1","+    });","+    this.emptyShadowProps = this.fallbackRenderer.render({","+      camera: {viewMatrix: new Matrix4(), projectionMatrix: new Matrix4(), near: 0.1, far: 1},","+      drawShadowCasters: () => {}","+    });","+    this.casterPass = new CascadeCasterPass(device);","+    deck._addDefaultShaderPlugin(plugin);","+  }","+","+  setProps(props: ShadowMapEffectProps): void {","+    this.props = props;","+    this.frame = undefined;","+    this.renderer?.setProps({quality: props.quality});","+  }","+","+  preRender(options: PreRenderOptions): void {","+    const viewport = options.viewports[0];","+    if (options.isPicking || !this.renderer) return;","+    this.frame = undefined;","+    if (!viewport || options.viewports.length !== 1 || viewport.subViewports?.length) return;","+","+    const camera = getCamera(viewport);","+    if (!camera) return;","+    const [x, y, z] = this.props.direction;","+    const {device} = this.renderer;","+    const shadowProps = this.renderer.render({","+      camera,","+      directionalLights: [{direction: [-x, -y, -z]}],","+      // Layers update the same uniform buffers for every cascade.","+      prepareShadowCasters: () => device.submit(),","+      drawShadowCasters: view =>","+        this.casterPass!.draw(view, viewport, options, this.emptyShadowProps!)","+    });","+    device.submit();","+    this.frame = {shadow: shadowProps, camera, viewport};","+  }","+","+  /** Bind the shadow maps during screen draws and neutral textures for auxiliary passes. */","+  getShaderModuleProps(","+    _layer: Layer,","+    _otherShaderModuleProps: Record<string, unknown>,","+    pass = 'screen'","+  ) {","+    const frame = pass === 'screen' ? this.frame : undefined;","+    return {","+      shadow: frame?.shadow ?? this.emptyShadowProps,","+      deckShadowMap: {","+        caster: 0,","+        viewMatrix: frame?.camera.viewMatrix,","+        color: this.props.shadowColor ?? [0, 0, 0, 0.6],","+        ...getCommonSpace(frame?.viewport)","+      }","+    };","+  }","+","+  cleanup({deck}: EffectContext): void {","+    this.renderer?.destroy();","+    this.fallbackRenderer?.destroy();","+    this.renderer = this.fallbackRenderer = undefined;","+    this.casterPass = undefined;","+    this.emptyShadowProps = undefined;","+    this.frame = undefined;","+    deck._removeDefaultShaderPlugin(plugin);","+  }","+}","+","+class CascadeCasterPass extends LayersPass {","+  private rasterParameters: Readonly<RenderPipelineParameters> = {};","+","+  draw(","+    view: ShadowRenderView,","+    viewport: Viewport,","+    options: PreRenderOptions,","+    emptyShadow: ShadowShaderProps","+  ): void {","+    this.rasterParameters = view.rasterParameters;","+    this._drawIntoPass(view.renderPass, viewport, {","+      ...options,","+      pass: 'shadow',","+      target: view.framebuffer,","+      effects: undefined,","+      shaderModuleProps: {","+        // A depth attachment cannot be bound for sampling in the same pass.","+        shadow: emptyShadow,","+        deckShadowMap: {caster: 1, matrix: view.viewProjectionMatrix, ...getCommonSpace(viewport)}","+      }","+    });","+  }","+","+  shouldDrawLayer(layer: Layer): boolean {","+    return (","+      (layer.props as {shadowEnabled?: boolean}).shadowEnabled !== false &&","+      layer.props.operation.includes('draw')","+    );","+  }","+","+  protected getLayerParameters(layer: Layer): RenderPipelineParameters {","+    return {...layer.props.parameters, ...this.rasterParameters, blend: false, cullMode: 'none'};","+  }","+}","+","+function getCommonSpace(viewport?: Viewport) {","+  return {","+    commonOrigin: viewport?.center ?? [0, 0, 0],","+    unitsPerMeter: viewport?.getDistanceScales().unitsPerMeter[2] ?? 1","+  };","+}","+","+function getCamera(viewport: Viewport): ShadowCamera | null {","+  const {viewMatrix, projectionMatrix} = viewport;","+  const {unitsPerMeter, commonOrigin} = getCommonSpace(viewport);","+  const viewUnitsPerMeter =","+    unitsPerMeter * Math.hypot(viewMatrix[8], viewMatrix[9], viewMatrix[10]);","+  const depth = projectionMatrix[10];","+  const translation = projectionMatrix[14];","+  const perspective = projectionMatrix[11] !== 0;","+  const near =","+    (perspective ? translation / (depth - 1) : (translation + 1) / depth) / viewUnitsPerMeter;","+  const far =","+    (perspective ? translation / (depth + 1) : (translation - 1) / depth) / viewUnitsPerMeter;","+  // Luma fits cascades only for a positive, finite camera depth range.","+  if (!(near > 0 && far > near && Number.isFinite(far))) return null;","+  return {","+    viewMatrix: new Matrix4()","+      .scale(1 / viewUnitsPerMeter)","+      .multiplyRight(viewMatrix)","+      .translate(commonOrigin)","+      .scale(unitsPerMeter),","+    projectionMatrix: new Matrix4(projectionMatrix).scale(viewUnitsPerMeter),","+    near,","+    far","+  };","+}"],"additions":254,"deletions":0,"truncated":false},{"path":"modules/core/src/index.ts","lines":["@@ -20,6 +20,7 @@ export {DirectionalLight} from './effects/lighting/directional-light';"," export {PointLight} from './effects/lighting/point-light';"," export {default as _CameraLight} from './effects/lighting/camera-light';"," export {default as _SunLight} from './effects/lighting/sun-light';","+export {ShadowMapEffect, type ShadowMapEffectProps} from './effects/lighting/shadow-map-effect';"," export {default as PostProcessEffect} from './effects/post-process-effect';"," "," // Passes"],"additions":1,"deletions":0,"truncated":false},{"path":"modules/core/src/lib/effect.ts","lines":["@@ -31,8 +31,12 @@ export interface Effect {","   preRender(opts: PreRenderOptions): void;","   /** Called after layers are rendered to screen */","   postRender?(opts: PostRenderOptions): Framebuffer | null;","-  /** Module settings passed to models */","-  getShaderModuleProps?(layer: Layer, otherShaderModuleProps: Record<string, any>): any;","+  /** Module settings passed to models for the named render pass. */","+  getShaderModuleProps?(","+    layer: Layer,","+    otherShaderModuleProps: Record<string, any>,","+    pass?: string","+  ): any;"," ","   // / Lifecycle methods","   /** Called when this effect is added */"],"additions":6,"deletions":2,"truncated":false},{"path":"modules/core/src/passes/layers-pass.ts","lines":["@@ -212,6 +212,38 @@ export default class LayersPass extends Pass {","     }","   }"," ","+  /** Draws a viewport into a pass opened and managed by a caller. */","+  protected _drawIntoPass(","+    renderPass: RenderPass,","+    viewport: Viewport,","+    options: LayersPassRenderOptions","+  ): void {","+    const {","+      layers,","+      shaderModuleProps = {},","+      canvasContext = this.device.canvasContext!,","+      target","+    } = options;","+    this._activatedLayers.clear();","+    this._lastRenderIndex = -1;","+    options.onViewportActive?.(viewport);","+    const drawLayerParams = this._getDrawLayerParams(viewport, options);","+    this._drawLayersInViewport(","+      renderPass,","+      {","+        layers,","+        shaderModuleProps,","+        canvasContext,","+        target,","+        viewport,","+        pass: options.pass || 'unknown',","+        normalizedColors: options.normalizedColors","+      },","+      drawLayerParams,","+      target ? [0, 0, target.width, target.height] : undefined","+    );","+  }","+","   // When a viewport contains multiple subviewports (e.g. repeated web mercator map),","   // this is only done once for the parent viewport","   /* Resolve the parameters needed to draw each layer */","@@ -318,14 +350,17 @@ export default class LayersPass extends Pass {","       isPicking?: boolean;","       normalizedColors?: boolean;","     },","-    drawLayerParams: DrawLayerParameters[]","+    drawLayerParams: DrawLayerParameters[],","+    renderViewport?: [number, number, number, number]","   ): RenderStats {","-    const glViewport = getGLViewport(this.device, {","-      canvasContext,","-      shaderModuleProps: globalModuleParameters,","-      target,","-      viewport","-    });","+    const glViewport =","+      renderViewport ??","+      getGLViewport(this.device, {","+        canvasContext,","+        shaderModuleProps: globalModuleParameters,","+        target,","+        viewport","+      });"," ","     if (view) {","       const {clear, clearColor, clearDepth, clearStencil} = view.props;","@@ -529,7 +564,7 @@ export default class LayersPass extends Pass {","       for (const effect of effects) {","         mergeModuleParameters(","           shaderModuleProps,","-          effect.getShaderModuleProps?.(layer, shaderModuleProps)","+          effect.getShaderModuleProps?.(layer, shaderModuleProps, pass)","         );","       }","     }"],"additions":43,"deletions":8,"truncated":false},{"path":"modules/main/src/index.ts","lines":["@@ -61,6 +61,7 @@ export {","   FlyToInterpolator,","   LightingEffect,","   PostProcessEffect,","+  ShadowMapEffect,","   AmbientLight,","   PointLight,","   DirectionalLight,","@@ -202,7 +203,8 @@ export type {","   PickingInfo,","   GetPickingInfoParams,","   BinaryAttribute,","-  Effect","+  Effect,","+  ShadowMapEffectProps"," } from '@deck.gl/core';"," "," export type {"]