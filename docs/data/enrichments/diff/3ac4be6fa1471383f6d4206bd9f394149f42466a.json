":["@@ -0,0 +1,189 @@","+package httpx","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/projectdiscovery/httpx/common/authprovider/authx\"","+\t\"github.com/projectdiscovery/retryablehttp-go\"","+\turlutil \"github.com/projectdiscovery/utils/url\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// mockAuthProvider is a simple in-memory AuthProvider for tests","+type mockAuthProvider struct {","+\tstrategies map[string][]authx.AuthStrategy","+}","+","+func (m *mockAuthProvider) LookupAddr(addr string) []authx.AuthStrategy {","+\treturn m.strategies[addr]","+}","+","+func (m *mockAuthProvider) LookupURL(u *url.URL) []authx.AuthStrategy {","+\thost := u.Hostname()","+\tif s, ok := m.strategies[host]; ok {","+\t\treturn s","+\t}","+\treturn m.strategies[u.Host]","+}","+","+func (m *mockAuthProvider) LookupURLX(u *urlutil.URL) []authx.AuthStrategy {","+\thost := u.Host","+\tif s, ok := m.strategies[host]; ok {","+\t\treturn s","+\t}","+\treturn nil","+}","+","+func TestRedirect_CustomCookies_NotLeakedToOtherHost(t *testing.T) {","+\tvar targetCookieReceived string","+","+\t// Target server (different host)","+\ttargetServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\ttargetCookieReceived = r.Header.Get(\"Cookie\")","+\t\tw.WriteHeader(http.StatusOK)","+\t\t_, _ = w.Write([]byte(\"target ok\"))","+\t}))","+\tdefer targetServer.Close()","+","+\t// Initial server redirects to targetServer","+\tinitialServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\thttp.Redirect(w, r, targetServer.URL, http.StatusFound)","+\t}))","+\tdefer initialServer.Close()","+","+\toptions := DefaultOptions","+\toptions.FollowRedirects = true","+\toptions.Timeout = 5 * time.Second","+\toptions.CustomHeaders = map[string][]string{","+\t\t\"Cookie\": {\"session=secret123\"},","+\t}","+","+\tclient, err := New(&options)","+\trequire.NoError(t, err)","+","+\treq, err := retryablehttp.NewRequest(\"GET\", strings.Replace(initialServer.URL, \"127.0.0.1\", \"localhost\", 1), nil)","+\trequire.NoError(t, err)","+\tclient.SetCustomHeaders(req, client.CustomHeaders)","+","+\tresp, err := client.Do(req, UnsafeOptions{})","+\trequire.NoError(t, err)","+\trequire.NotNil(t, resp)","+","+\t// Verify the target server did NOT receive the custom cookie","+\trequire.Empty(t, targetCookieReceived, \"custom cookie should not be leaked on redirect to different host\")","+}","+","+func TestRedirect_CustomCookies_PreservedOnSameHost(t *testing.T) {","+\tvar targetCookieReceived string","+","+\tvar ts *httptest.Server","+\tts = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tif r.URL.Path == \"/redirect\" {","+\t\t\thttp.Redirect(w, r, ts.URL+\"/target\", http.StatusFound)","+\t\t\treturn","+\t\t}","+\t\ttargetCookieReceived = r.Header.Get(\"Cookie\")","+\t\tw.WriteHeader(http.StatusOK)","+\t\t_, _ = w.Write([]byte(\"ok\"))","+\t}))","+\tdefer ts.Close()","+","+\toptions := DefaultOptions","+\toptions.FollowRedirects = true","+\toptions.Timeout = 5 * time.Second","+\toptions.CustomHeaders = map[string][]string{","+\t\t\"Cookie\": {\"session=secret123\"},","+\t}","+","+\tclient, err := New(&options)","+\trequire.NoError(t, err)","+","+\treq, err := retryablehttp.NewRequest(\"GET\", ts.URL+\"/redirect\", nil)","+\trequire.NoError(t, err)","+\tclient.SetCustomHeaders(req, client.CustomHeaders)","+","+\tresp, err := client.Do(req, UnsafeOptions{})","+\trequire.NoError(t, err)","+\trequire.NotNil(t, resp)","+","+\t// Verify the same-host target DID receive the custom cookie","+\trequire.Contains(t, targetCookieReceived, \"session=secret123\", \"custom cookie should be preserved on same host redirect\")","+}","+","+func TestRedirect_AuthProvider_HeadersAppliedPerHostRules(t *testing.T) {","+\tvar targetAuthHeaderReceived string","+","+\ttargetServe