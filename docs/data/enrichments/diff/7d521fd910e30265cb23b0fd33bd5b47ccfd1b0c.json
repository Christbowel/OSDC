tp.log.Warn(\"unable to load preview assets, falling back to default assets\", \"folder\", cookie.Value, \"err\", err)","+\t\t}","+\t}","+","+\tassets, err := fswebassets.GetWebAssets(ctx, p.config, p.license)","+\treturn assets, \"\", err","+}","+"," func (p *IndexProvider) runIndexDataHooks(reqCtx *contextmodel.ReqContext, data *IndexViewData) {"," \t// Create a dummy struct to pass to the hooks, and then extract the data back out from it"," \tlegacyIndexViewData := dtos.IndexViewData{"],"additions":32,"deletions":4,"truncated":false},{"path":"pkg/services/frontend/index.html","lines":["@@ -222,6 +222,11 @@ <h1>JavaScript is required to run Grafana</h1>","         window.__grafanaOFREPRootUrlEnabled = true;","       [[end]]"," ","+      [[if .PreviewAssetsFolder]]","+        // Set when the assets on this page come from a PR preview build","+        window.__grafanaPreviewAssets = '[[.PreviewAssetsFolder]]';","+      [[end]]","+","       window.__grafanaLegacyAPIMode = [[.LegacyAPIMode]];","       window.__grafanaPublicDashboardAccessToken = [[.PublicDashboardAccessToken]];"," "],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/services/frontend/index_test.go","lines":["@@ -1,6 +1,7 @@"," package frontend"," "," import (","+\t\"net/http\""," \t\"net/http/httptest\""," \t\"os\""," \t\"path/filepath\"","@@ -104,4 +105,86 @@ func TestFrontendService_WebAssets(t *testing.T) {"," \t\tassert.Contains(t, body, \"src=\\\"public/build/runtime.js\\\" type=\\\"text/javascript\\\"\")"," \t\tassert.Contains(t, body, \"src=\\\"public/build/app.js\\\" type=\\\"text/javascript\\\"\")"," \t})","+","+\tt.Run(\"should serve preview assets when the preview cookie is set\", func(t *testing.T) {","+\t\tconst folder = \"pr_grafana_123456\"","+\t\tbucket := newPreviewBucketServer(t, folder)","+\t\tmux := setupPreviewTestMux(t, bucket.URL+\"/\")","+\t\tpreviewURL := bucket.URL + \"/\" + folder + \"/\"","+","+\t\treq := newPreviewRequest(\"/\")","+\t\treq.AddCookie(&http.Cookie{Name: previewAssetsCookieName, Value: folder})","+\t\trecorder := httptest.NewRecorder()","+\t\tmux.ServeHTTP(recorder, req)","+","+\t\tassert.Equal(t, 200, recorder.Code)","+\t\tbody := recorder.Body.String()","+","+\t\t// Asset URLs should point at the preview build","+\t\tassert.Contains(t, body, previewURL+\"public/build/runtime.preview.js\")","+\t\tassert.Contains(t, body, previewURL+\"public/build/app.preview.js\")","+\t\tassert.NotContains(t, body, \"src=\\\"public/build/runtime.js\\\"\")","+\t\tassert.NotContains(t, body, \"src=\\\"public/build/app.js\\\"\")","+","+\t\t// The page should flag that preview assets are active","+\t\tassert.Contains(t, body, \"window.__grafanaPreviewAssets = '\"+folder+\"'\")","+\t})","+","+\tt.Run(\"should fall back to default assets when the preview build cannot be loaded\", func(t *testing.T) {","+\t\tbucket := httptest.NewServer(http.NotFoundHandler())","+\t\tt.Cleanup(bucket.Close)","+\t\tmux := setupPreviewTestMux(t, bucket.URL+\"/\")","+","+\t\treq := newPreviewRequest(\"/\")","+\t\treq.AddCookie(&http.Cookie{Name: previewAssetsCookieName, Value: \"pr_grafana_does_not_exist\"})","+\t\trecorder := httptest.NewRecorder()","+\t\tmux.ServeHTTP(recorder, req)","+","+\t\tassert.Equal(t, 200, recorder.Code)","+\t\tbody := recorder.Body.String()","+\t\tassert.Contains(t, body, \"src=\\\"public/build/runtime.js\\\"\")","+\t\tassert.NotContains(t, body, \"window.__grafanaPreviewAssets\")","+\t})","+","+\tt.Run(\"should ignore the preview cookie for a namespace that has not opted in\", func(t *testing.T) {","+\t\tconst folder = \"pr_grafana_123456\"","+\t\tbucket := newPreviewBucketServer(t, folder)","+\t\tmux := setupPreviewTestMux(t, bucket.URL+\"/\")","+","+\t\treq := httptest.NewRequest(\"GET\", \"/\", nil)","+\t\treq.Header.Set(\"baggage\", \"namespace=stacks-other\")","+\t\treq.AddCookie(&http.Cookie{Name: previewAssetsCookieName, Value: folder})","+\t\trecorder := httptest.NewRecorder()","+\t\tmux.ServeHTTP(recorder, req)","+","+\t\tassert.Equal(t, 200, recorder.Code)","+\t\tbody := recorder.Body.String()","+\t\tassert.Contains(t, body, \"src=\\\"public/build/runtime.js\\\"\")","+\t\tassert.NotContains(t, body, \"window.__grafanaPreviewAssets\")","+\t})","+","+\tt.Run(\"should ignore the preview cookie when the feature is disabled\", func(t *testing.T) {","+\t\tpublicDir := setupTestWebAssets(t)","+\t\tcfg := &setting.Cfg{","+\t\t\tRaw:            ini.Empty(),","+\t\t\tHTTPPort:       \"3000\",","+\t\t\tStaticRootPath: publicDir,","+\t\t\tEnv:            setting.Dev,","+\t\t}","+\t\tservice := createTestService(t, cfg)","+","+\t\tmux := web.New()","+\t\tservice.addMiddlewares(mux)","+\t\tservice.registerRoutes(mux)","+","+\t\treq := httptest.NewRequest(\"GET\", \"/\", nil)","+\t\treq.AddCookie(&http.Cookie{Name: previewAssetsCookieName, Value: \"pr_grafana_123456\"})","+\t\trecorder := httptest.NewRecorder()","+\t\tmux.ServeHTTP(recorder, req)","+","+\t\tassert.Equal(t, 200, recorder.Code)","+\t\tbody := recorder.Body.String()","+\t\tassert.Contains(t, body, \"src=\\\"public/build/runtime.js\\\"\")","+\t\tassert.NotContains(t, body, \"window.__grafanaPreviewAssets\")","+\t})"," }"],"additions":83,"deletions":0,"truncated":false},{"path":"pkg/services/frontend/preview_assets.go","lines":["@@ -0,0 +1,200 @@","+package frontend","+","+import (","+\t\"crypto/rand\"","+\t\"crypto/subtle\"","+\t\"embed\"","+\t\"encoding/hex\"","+\t\"html/template\"","+\t\"net/http\"","+\t\"time\"","+","+\t\"k8s.io/apiserver/pkg/endpoints/request\"","+","+\t\"github.com/grafana/grafana/pkg/infra/log\"","+\t\"github.com/grafana/grafana/pkg/services/contexthandler\"","+\tfswebassets \"github.com/grafana/grafana/pkg/services/frontend/webassets\"","+\t\"github.com/grafana/grafana/pkg/setting\"","+)","+","+const (","+\tpreviewAssetsPath = \"/-/set-preview-assets\"","+","+\t// Stores only the folder name; asset URLs are always built server-side.","+\tpreviewAssetsCookieName = \"grafana_preview_assets\"","+\tpreviewCSRFCookieName   = \"grafana_preview_assets_csrf\"","+","+\tcsrfTokenLength     = 32","+\tcsrfCookieMaxAge    = 10 * time.Minute","+\tpreviewCookieMaxAge = 24 * time.Hour","+)","+","+var (","+\t//go:embed preview_assets_confirm.html","+\tpreviewAssetsTemplateFS embed.FS","+","+\t// Parsed with the default {{ }} delimiters; kept separate from the index","+\t// template set which uses [[ ]].","+\tpreviewAssetsConfirmTemplate = template.Must(template.ParseFS(previewAssetsTemplateFS, \"preview_assets_confirm.html\"))","+)","+","+type previewAssetsHandler struct {","+\tpreviewCfg   fswebassets.PreviewAssetsConfig","+\tcookieSecure bool","+}","+","+func newPreviewAssetsHandler(cfg *setting.Cfg, previewCfg fswebassets.PreviewAssetsConfig) *previewAssetsHandler {","+\treturn &previewAssetsHandler{","+\t\tpreviewCfg:   previewCfg,","+\t\tcookieSecure: cfg.CookieSecure,","+\t}","+}","+","+// handleGet serves the whole opt-in flow. The frontend service only receives","+// GETs, so the confirm step is a CSRF-token-guarded GET rather than a POST.","+func (h *previewAssetsHandler) handleGet(w http.ResponseWriter, r *http.Request) {","+\tctx := r.Context()","+\tlogger := contexthandler.FromContext(ctx).Logger","+","+\t// Stacks that haven't opted in see an unknown route.","+\tnamespace := request.NamespaceValue(ctx)","+\tif !h.previewCfg.Active(namespace) {","+\t\tlogger.Debug(\"preview assets requested by a namespace that has not opted in\", \"namespace\", namespace)","+\t\thttp.NotFound(w, r)","+\t\treturn","+\t}","+","+\tquery := r.URL.Query()","+","+\tif query.Get(\"clear\") != \"\" {","+\t\th.setCookie(w, previewAssetsCookieName, \"\", -1)","+\t\tlogger.Info(\"preview assets cookie cleared\")","+\t\thttp.Redirect(w, r, \"/\", http.StatusSeeOther)","+\t\treturn","+\t}","+","+\tfolder := query.Get(\"assets\")","+\tif folder == \"\" {","+\t\thttp.Error(w, \"missing 'assets' query parameter\", http.StatusBadRequest)","+\t\treturn","+\t}","+","+\tassetsURL, err := fswebassets.ResolvePreviewAssetsURL(h.previewCfg.BaseURL, folder)","+\tif err != nil {","+\t\tlogger.Warn(\"rejected preview assets folder\", \"folder\", folder, \"reason\", err)","+\t\thttp.Error(w, \"invalid 'assets' query parameter\", http.StatusBadRequest)","+\t\treturn","+\t}","+","+\tconfirmToken := query.Get(\"confirm\")","+\tif confirmToken == \"\" {","+\t\th.renderConfirmationPage(w, logger, folder, assetsURL)","+\t\treturn","+\t}","+","+\tcsrfCookie, err := r.Cookie(previewCSRFCookieName)","+\tif err != nil || csrfCookie.Value == \"\" {","+\t\thttp.Error(w, \"missing or expired confirmation token, go back and try again\", http.StatusForbidden)","+\t\treturn","+\t}","+\tif subtle.ConstantTimeCompare([]byte(csrfCookie.Value), []byte(confirmToken)) != 1 {","+\t\tlogger.Warn(\"preview assets confirmation token mismatch\", \"folder\", folder)","+\t\thttp.Error(w, \"invalid confirmation token, go back and try again\", http.StatusForbidden)","+\t\treturn","+\t}","+","+\t// Check the preview build actually exists before committing the browser to","+\t// it for 24 hours.","+\tif _, err := fswebassets.GetPreviewWebAssets(ctx, h.previewCfg, folder); err != nil {","+\t\tlogger.Warn(\"preview assets manifest could not be loaded\", \"folder\", folder, \"err\", err)","+\t\thttp.Error(w, \"preview assets could not be loaded - check the deploy exists and has finished uploading\", http.StatusBadGateway)","+\t\treturn","+\t}","+","+\th.clearCSRFCookie(w)","+\th.setCookie(w, previewAssetsCookieName, folder, int(previewCookieMaxAge.Seconds()))","+","+\tlogger.Info(\"preview assets cookie set\", \"folder\", folder, \"url\", assetsURL)","+","+\thttp.Redirect(w, r, \"/\", http.StatusSeeOther)","+}","+","+func (h *previewAssetsHandler) renderConfirmationPage(w http.ResponseWriter, logger log.Logger, folder, assetsURL string) {","+\tcsrfToken, err := generateCSRFToken()","+\tif err != nil {","+\t\tlogger.Error(\"failed to generate CSRF token\", \"err\", err)","+\t\thttp.Error(w, \"Internal Server Error\", http.StatusInternalServerError)","+\t\treturn","+\t}","+","+\t// Secure follows [security] cookie_secure, like all Grafana cookies (see pkg/middleware/cookies).","+\t// #nosec G124","+\t// nosemgrep: go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure","+\thttp.SetCookie(w, &http.Cookie{","+\t\tName:     previewCSRFCookieName,","+\t\tValue:    csrfToken,","+\t\tPath:     previewAssetsPath,","+\t\tMaxAge:   int(csrfCookieMaxAge.Seconds()),","+\t\tHttpOnly: true,","+\t\tSecure:   h.cookieSecure,","+\t\tSameSite: http.SameSiteStrictMode,","+\t})","+","+\tw.Header().Set(\"Content-Type\", \"text/html; charset=UTF-8\")","+\tw.Header().Set(\"Cache-Control\", \"no-store\")","+\t// The confirmation token travels in the query string; keep it out of Referer.","+\tw.Header().Set(\"Referrer-Policy\", \"no-referrer\")","+","+\terr = previewAssetsConfirmTemplate.Execute(w, struct {","+\t\tFolder    string","+\t\tAssetsURL string","+\t\tCSRFToken string","+\t\tDuration  string","+\t}{","+\t\tFolder:    folder,","+\t\tAssetsURL: assetsURL,","+\t\tCSRFToken: csrfToken,","+\t\tDuration:  \"24 hours\",","+\t})","+\tif err != nil {","+\t\tlogger.Error(\"failed to render preview assets confirmation page\", \"err\", err)","+\t}","+}","+","+func (h *previewAssetsHandler) clearCSRFCookie(w http.ResponseWriter) {","+\t// Secure follows [security] cookie_secure, like all Grafana cookies (see pkg/middleware/cookies).","+\t// #nosec G124","+\t// nosemgrep: go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure","+\thttp.SetCookie(w, &http.Cookie{","+\t\tName:     previewCSRFCookieName,","+\t\tValue:    \"\",","+\t\tPath:     previewAssetsPath,","+\t\tMaxAge:   -1,","+\t\tHttpOnly: true,","+\t\tSecure:   h.cookieSecure,","+\t\tSameSite: http.SameSiteStrictMode,","+\t})","+}","+","+func (h *previewAssetsHandler) setCookie(w http.ResponseWriter, name, value string, maxAge int) {","+\t// Secure follows [security] cookie_secure, like all Grafana cookies (see pkg/middleware/cookies).","+\t// #nosec G124","+\t// nosemgrep: go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure","+\thttp.SetCookie(w, &http.Cookie{","+\t\tName:     name,","+\t\tValue:    value,","+\t\tPath:     \"/\",","+\t\tMaxAge:   maxAge,","+\t\tHttpOnly: true,","+\t\tSecure:   h.cookieSecure,","+\t\tSameSite: http.SameSiteLaxMode,","+\t})","+}","+","+func generateCSRFToken() (string, error) {","+\tbytes := make([]byte, csrfTokenLength)","+\tif _, err := rand.Read(bytes); err != nil {","+\t\treturn \"\", err","+\t}","+\treturn hex.EncodeToString(bytes), nil","+}"],"additions":200,"deletions":0,"truncated":false},{"path":"pkg/services/frontend/preview_assets_confirm.html","lines":["@@ -0,0 +1,152 @@","+<!DOCTYPE html>","+<html lang=\"en\">","+  <head>","+    <meta charset=\"utf-8\" />","+    <meta name=\"viewport\" content=\"width=device-width\" />","+    <meta name=\"referrer\" content=\"no-referrer\" />","+    <title>Load preview assets</title>","+    <style>","+      :root {","+        --bg: #f4f5f5;","+        --surface: #ffffff;","+        --border: rgba(36, 41, 46, 0.12);","+        --text: rgb(36, 41, 46);","+        --text-secondary: rgba(36, 41, 46, 0.75);","+        --code-bg: rgba(36, 41, 46, 0.07);","+        --warning-bg: rgba(245, 95, 62, 0.08);","+        --warning-border: rgba(245, 95, 62, 0.5);","+        --primary: #f55f3e;","+        --primary-hover: #d94e30;","+        --secondary-bg: rgba(36, 41, 46, 0.08);","+        --secondary-hover: rgba(36, 41, 46, 0.15);","+      }","+","+      @media (prefers-color-scheme: dark) {","+        :root {","+          --bg: #111217;","+          --surface: #181b1f;","+          --border: rgba(204, 204, 220, 0.15);","+          --text: rgb(204, 204, 220);","+          --text-secondary: rgba(204, 204, 220, 0.65);","+          --code-bg: rgba(204, 204, 220, 0.07);","+          --warning-bg: rgba(245, 95, 62, 0.1);","+          --warning-border: rgba(245, 95, 62, 0.5);","+          --secondary-bg: rgba(204, 204, 220, 0.1);","+          --secondary-hover: rgba(204, 204, 220, 0.16);","+        }","+      }","+","+      body {","+        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial,","+          sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\";","+        display: flex;","+        justify-content: center;","+        align-items: center;","+        min-height: 100dvh;","+        margin: 0;","+        background: var(--bg);","+        color: var(--text);","+        line-height: 1.5;","+      }","+","+      main {","+        max-width: 600px;","+        margin: 1rem;","+        padding: 2rem;","+        border: 1px solid var(--border);","+        border-radius: 8px;","+        background: var(--surface);","+      }","+","+      h1 {","+        font-size: 1.25rem;","+        margin: 0 0 1rem;","+      }","+","+      p {","+        margin: 0 0 0.75rem;","+        color: var(--text-secondary);","+      }","+","+      .url {","+        word-break: break-all;","+        background: var(--code-bg);","+        padding: 0.5rem 0.75rem;","+        border-radius: 4px;","+        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;","+        font-size: 0.8125rem;","+        margin-bottom: 0.75rem;","+      }","+","+      .warning {","+        padding: 0.75rem;","+        background: var(--warning-bg);","+        border: 1px solid var(--warning-border);","+        border-radius: 4px;","+        font-size: 0.8125rem;","+      }","+","+      .actions {","+        margin-top: 1.5rem;","+        display: flex;","+        gap: 0.75rem;","+        align-items: center;","+      }","+","+      button,","+      .cancel {","+        display: inline-block;","+        padding: 0.5rem 1rem;","+        border-radius: 4px;","+        border: none;","+        cursor: pointer;","+        font-size: 0.875rem;","+        font-family: inherit;","+        text-decoration: none;","+        line-height: 1.5;","+      }","+","+      button {","+        background: var(--primary);","+        color: #fff;","+      }","+","+      button:hover {","+        background: var(--primary-hover);","+      }","+","+      .cancel {","+        background: var(--secondary-bg);","+        color: var(--text);","+      }","+","+      .cancel:hover {","+        background: var(--secondary-hover);","+      }","+    </style>","+  </head>","+  <body>","+    <main>","+      <h1>Load preview assets?</h1>","+      <p>","+        You are about to load the frontend assets from the preview build","+        <strong>{{.Folder}}</strong>:","+      </p>","+      <div class=\"url\">{{.AssetsURL}}</div>","+      <div class=\"warning\">","+        This replaces the Grafana frontend in this browser with unreviewed, unreleased code for","+        {{.Duration}}. Only continue if you trust the pull request these assets were built from.","+        You can undo this at any time by visiting","+        <code>/-/set-preview-assets?clear=1</code>.","+      </div>","+      <form method=\"GET\" action=\"/-/set-preview-assets\">","+        <input type=\"hidden\" name=\"assets\" value=\"{{.Folder}}\" />","+        <input type=\"hidden\" name=\"confirm\" value=\"{{.CSRFToken}}\" />","+        <div class=\"actions\">","+          <button type=\"submit\">Load preview assets</button>","+          <a class=\"cancel\" href=\"/\">Cancel</a>","+        </div>","+      </form>","+    </main>","+  </body>","+</html>"],"additions":152,"deletions":0,"truncated":false},{"path":"pkg/services/frontend/preview_assets_test.go","lines":["@@ -0,0 +1,288 @@","+package frontend","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"gopkg.in/ini.v1\"","+","+\tfswebassets \"github.com/grafana/grafana/pkg/services/frontend/webassets\"","+\t\"github.com/grafana/grafana/pkg/setting\"","+\t\"github.com/grafana/grafana/pkg/web\"","+)","+","+// previewTestNamespace is allowlisted in setupPreviewTestMux.","+const previewTestNamespace = \"stacks-123456\"","+","+// previewTestManifest is served by the mock bucket server in preview assets tests.","+const previewTestManifest = `{","+\t\"entrypoints\": {","+\t\t\"app\": {","+\t\t\t\"assets\": {","+\t\t\t\t\"js\": [\"public/build/runtime.preview.js\", \"public/build/app.preview.js\"],","+\t\t\t\t\"css\": [\"public/build/grafana.app.preview.css\"]","+\t\t\t}","+\t\t},","+\t\t\"dark\": { \"assets\": { \"css\": [\"public/build/grafana.dark.preview.css\"] } },","+\t\t\"light\": { \"assets\": { \"css\": [\"public/build/grafana.light.preview.css\"] } }","+\t}","+}`","+","+// newPreviewBucketServer returns a server that serves previewTestManifest for","+// the given folder, mimicking the GCS bucket layout the CI workflow uploads.","+func newPreviewBucketServer(t *testing.T, folder string) *httptest.Server {","+\tt.Helper()","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tif r.URL.Path == \"/\"+folder+\"/public/build/assets-manifest.json\" {","+\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")","+\t\t\t_, _ = w.Write([]byte(previewTestManifest))","+\t\t\treturn","+\t\t}","+\t\thttp.NotFound(w, r)","+\t}))","+\tt.Cleanup(server.Close)","+\treturn server","+}","+","+func setupPreviewTestMux(t *testing.T, previewBaseURL string) *web.Mux {","+\tt.Helper()","+\tfswebassets.ResetPreviewAssetsCache()","+","+\traw := ini.Empty()","+\traw.Section(\"frontend_service\").Key(\"preview_assets_base_url\").SetValue(previewBaseURL)","+\traw.Section(\"frontend_service\").Key(\"preview_assets_allowed_namespaces\").SetValue(previewTestNamespace)","+","+\tcfg := &setting.Cfg{","+\t\tRaw:            raw,","+\t\tHTTPPort:       \"3000\",","+\t\tStaticRootPath: setupTestWebAssets(t),","+\t\tEnv:            setting.Dev,","+\t}","+\tservice := createTestService(t, cfg)","+","+\tmux := web.New()","+\tservice.addMiddlewares(mux)","+\tservice.registerRoutes(mux)","+\treturn mux","+}","+","+// newPreviewRequest makes a request from a namespace that has opted in to","+// preview assets.","+func newPreviewRequest(target string) *http.Request {","+\treq := httptest.NewRequest(\"GET\", target, nil)","+\treq.Header.Set(\"baggage\", \"namespace=\"+previewTestNamespace)","+\treturn req","+}","+","+func getCookie(t *testing.T, resp *http.Response, name string) *http.Cookie {","+\tt.Helper()","+\tfor _, c := range resp.Cookies() {","+\t\tif c.Name == name {","+\t\t\treturn c","+\t\t}","+\t}","+\treturn nil","+}","+","+func TestPreviewAssets_RouteNotRegisteredWhenDisabled(t *testing.T) {","+\tpublicDir := setupTestWebAssets(t)","+\tcfg := &setting.Cfg{","+\t\tRaw:            ini.Empty(),","+\t\tHTTPPort:       \"3000\",","+\t\tStaticRootPath: publicDir,","+\t\tEnv:            setting.Dev,","+\t}","+\tservice := createTestService(t, cfg)","+","+\tmux := web.New()","+\tservice.addMiddlewares(mux)","+\tservice.registerRoutes(mux)","+","+\treq := newPreviewRequest(\"/-/set-preview-assets?assets=pr_grafana_123\")","+\trecorder := httptest.NewRecorder()","+\tmux.ServeHTTP(recorder, req)","+","+\t// The route should not exist, so the request falls through to the index","+\t// wildcard and renders the app.","+\tassert.Equal(t, 200, recorder.Code)","+\tassert.Contains(t, recorder.Body.String(), \"<div id=\\\"reactRoot\\\"></div>\")","+\tassert.NotContains(t, recorder.Body.String(), \"Load preview assets\")","+}","+","+func TestPreviewAssets_ConfirmationPage(t *testing.T) {","+\tmux := setupPreviewTestMux(t, \"https://storage.example.com/bucket/\")","+","+\tt.Run(\"should render confirmation page with resolved URL and CSRF cookie\", func(t *testing.T) {","+\t\treq := newPreviewRequest(\"/-/set-preview-assets?assets=pr_grafana_123456\")","+\t\trecorder := httptest.NewRecorder()","+\t\tmux.ServeHTTP(recorder, req)","+","+\t\tassert.Equal(t, 200, recorder.Code)","+\t\tbody := recorder.Body.String()","+\t\tassert.Contains(t, body, \"pr_grafana_123456\")","+\t\tassert.Contains(t, body, \"https://storage.example.com/bucket/pr_grafana_123456/\")","+\t\tassert.Contains(t, body, `name=\"confirm\"`)","+\t\tassert.Equal(t, \"no-referrer\", recorder.Header().Get(\"Referrer-Policy\"))","+\t\tassert.Contains(t, recorder.Header().Get(\"Cache-Control\"), \"no-store\")","+","+\t\tcsrfCookie := getCookie(t, recorder.Result(), previewCSRFCookieName)","+\t\trequire.NotNil(t, csrfCookie, \"CSRF cookie should be set\")","+\t\tassert.True(t, csrfCookie.HttpOnly)","+\t\tassert.Equal(t, previewAssetsPath, csrfCookie.Path)","+\t\tassert.Contains(t, body, csrfCookie.Value, \"page should embed the CSRF token\")","+\t})","+","+\tt.Run(\"should reject missing assets parameter\", func(t *testing.T) {","+\t\treq := newPreviewRequest(\"/-/set-preview-assets\")","+\t\trecorder := httptest.NewRecorder()","+\t\tmux.ServeHTTP(recorder, req)","+","+\t\tassert.Equal(t, 400, recorder.Code)","+\t})","+","+\tt.Run(\"should reject invalid folder names\", func(t *testing.T) {","+\t\tfor _, folder := range []string{\"../etc/passwd\", \"foo bar\", \"a?b=c\", \"<script>\", \"foo/bar\", \"foo.bar\"} {"],"additions":148,"deletions":0,"truncated":false}],"additions":654,"deletions":22,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-08-12T09:21:00.814217+00:00"}