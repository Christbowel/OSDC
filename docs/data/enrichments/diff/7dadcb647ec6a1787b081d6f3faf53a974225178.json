, which have no kernel.\"\"\"","+    # TODO: migrate to oracle base method.","+    if LinearKernelOracle.maybe_skip_for_requantization_source():","+        return FakeMxFp6LinearKernel()","+","     config = MxFp6LinearLayerConfig(","         weight_quant_key=weight_quant_key,","         activation_quant_key=activation_quant_key,","@@ -1227,6 +1266,10 @@ def init_wfp8_a16_linear_kernel(","     force_kernel: type[FP8ScaledMMLinearKernel] | None = None,","     module_name: str | None = None,"," ) -> FP8ScaledMMLinearKernel:","+    # TODO: migrate to oracle base method.","+    if LinearKernelOracle.maybe_skip_for_requantization_source():","+        return FakeFp8LinearKernel()","+","     config = FP8ScaledMMLinearLayerConfig(","         weight_quant_key=weight_quant_key,","         activation_quant_key=activation_quant_key,","@@ -1258,7 +1301,13 @@ def init_wfp8_a16_linear_kernel("," "," def init_nvfp4_linear_kernel(use_a16: bool = False) -> NvFp4LinearKernel:","     \"\"\"Select and instantiate the best NVFP4 linear kernel for the","-    current platform.\"\"\"","+    current platform.","+","+    Returns a placeholder for requantization sources, which have no kernel.\"\"\"","+    # TODO: migrate to oracle base method.","+    if LinearKernelOracle.maybe_skip_for_requantization_source():","+        return FakeNvFp4LinearKernel()","+","     config = NvFp4LinearLayerConfig()","     a16_kernels = (","         B12xNvFp4W4A16LinearKernel,"],"additions":53,"deletions":4,"truncated":false},{"path":"vllm/model_executor/kernels/linear/base.py","lines":["@@ -10,6 +10,30 @@"," from vllm.model_executor.layers.quantization.utils.quant_utils import QuantKey"," "," ","+# TODO: extend similarly to oracle/base.py on MOE side, to remove code duplication in","+# the different linear oracles (#65978)","+class LinearKernelOracle:","+    \"\"\"Shared behaviour of linear kernel selection (dispatch).","+","+    Linear kernels have no oracle abstraction yet; this only hosts the logic","+    shared by the `init_*_linear_kernel` selectors, to be extended as they are","+    migrated.","+    \"\"\"","+","+    @staticmethod","+    def maybe_skip_for_requantization_source() -> bool:","+        \"\"\"Whether to return a placeholder instead of selecting a compute kernel.","+","+        A checkpoint method created as an online requantization source only","+        dequantizes its weights, so it needs no linear kernel.","+        \"\"\"","+        from vllm.model_executor.layers.quantization.online.requantization import (","+            is_requantization_source,","+        )","+","+        return is_requantization_source()","+","+"," @dataclass"," class MMLinearLayerConfig: ..."," "],"additions":24,"deletions":0,"truncated":false},{"path":"vllm/model_executor/kernels/linear/requantization_source.py","lines":["@@ -0,0 +1,78 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Placeholder linear kernels for online requantization sources.","+","+A checkpoint quantization method used as an online requantization source only","+dequantizes its weights, so it needs no kernel. The `init_*_linear_kernel`","+selectors return one of these placeholders instead of dispatching, which keeps","+their return types unchanged. Using one for compute raises.","+\"\"\"","+","+from typing import Any","+","+import torch","+","+from vllm.model_executor.kernels.linear.mxfp4 import MxFp4LinearKernel","+from vllm.model_executor.kernels.linear.mxfp6 import MxFp6LinearKernel","+from vllm.model_executor.kernels.linear.mxfp8 import Mxfp8LinearKernel","+from vllm.model_executor.kernels.linear.nvfp4 import NvFp4LinearKernel","+from vllm.model_executor.kernels.linear.scaled_mm import (","+    FP8ScaledMMLinearKernel,","+    Int8ScaledMMLinearKernel,","+)","+from vllm.model_executor.layers.quantization.utils.quant_utils import QuantKey","+","+_NO_KERNEL = (","+    \"Requantization sources only dequantize weights: they have no linear kernel.\"","+)","+","+","+class _FakeLinearKernel:","+    \"\"\"Satisfies the abstract interface of every kernel family, never computes.\"\"\"","+","+    def __init__(self, *args: Any, **kwargs: Any) -> None:","+        pass","+","+    @classmethod","+    def is_supported(cls, *args: Any, **kwargs: Any) -> tuple[bool, str | None]:","+        return True, None","+","+    @classmethod","+    def can_implement(cls, *args: Any, **kwargs: Any) -> tuple[bool, str | None]:","+        return True, None","+","+    def input_quant_key(self) -> QuantKey | None:","+        return None","+","+    def process_weights_after_loading(self, *args: Any, **kwargs: Any) -> None:","+        raise RuntimeError(_NO_KERNEL)","+","+    def apply_weights(self, *args: Any, **kwargs: Any) -> torch.Tensor:","+        raise RuntimeError(_NO_KERNEL)","+","+    def apply_scaled_mm(self, *args: Any, **kwargs: Any) -> torch.Tensor:","+        raise RuntimeError(_NO_KERNEL)","+","+","+class FakeFp8LinearKernel(_FakeLinearKernel, FP8ScaledMMLinearKernel):","+    pass","+","+","+class FakeInt8LinearKernel(_FakeLinearKernel, Int8ScaledMMLinearKernel):","+    pass","+","+","+class FakeMxFp8LinearKernel(_FakeLinearKernel, Mxfp8LinearKernel):","+    pass","+","+","+class FakeMxFp4LinearKernel(_FakeLinearKernel, MxFp4LinearKernel):","+    pass","+","+","+class FakeMxFp6LinearKernel(_FakeLinearKernel, MxFp6LinearKernel):","+    pass","+","+","+class FakeNvFp4LinearKernel(_FakeLinearKernel, NvFp4LinearKernel):","+    pass"],"additions":78,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/oracle/base.py","lines":["@@ -34,6 +34,14 @@"," Rejection = tuple[type[mk.FusedMoEExperts], str | None]"," "," ","+class RequantizationSourceExperts(mk.FusedMoEExperts):","+    \"\"\"Experts class selected for online requantization sources.","+","+    Such a source only dequantizes its weights, so no kernel is ever built from","+    it: it is returned as a class and never instantiated.","+    \"