     pytest.param(\"nvfp4\", fmt, id=f\"nvfp4-construct-{fmt}\")","+            for fmt in (\"modelopt\", \"compressed_tensors\", \"quark\")","+        ],","+    ],","+)","+@pytest.mark.skip_global_cleanup","+def test_moe_oracles_skip_dispatch_for_requantization_source(","+    kind: str,","+    source_format: str | None,","+    monkeypatch,","+    source_construction,","+) -> None:","+    \"\"\"Selectors and source construction skip the checkpoint compute backend.\"\"\"","+    module = {\"wna16\": \"int_wna16\", \"deepseek_v4_mxfp4\": \"mxfp4\"}.get(kind, kind)","+    oracle_cls, backend_enum = {","+        \"fp8\": (\"Fp8MoEKernelOracle\", \"Fp8MoeBackend\"),","+        \"mxfp8\": (\"Mxfp8MoEKernelOracle\", \"Fp8MoeBackend\"),","+        \"mxfp4\": (\"Mxfp4MoEKernelOracle\", \"Mxfp4MoeBackend\"),","+        \"nvfp4\": (\"NvFp4MoEKernelOracle\", \"NvFp4MoeBackend\"),","+        \"int8\": (\"Int8MoEKernelOracle\", \"Int8MoeBackend\"),","+        \"int_wna16\": (\"WNA16MoEKernelOracle\", \"WNA16MoEBackend\"),","+        \"w4a8_int8\": (\"W4A8Int8MoEKernelOracle\", \"W4A8Int8MoeBackend\"),","+        \"unquantized\": (\"UnquantizedMoEKernelOracle\", \"UnquantizedMoeBackend\"),","+    }[module]","+    oracle_module = importlib.import_module(","+        f\"vllm.model_executor.layers.fused_moe.oracle.{module}\"","+    )","+    select = getattr(oracle_module, f\"select_{kind}_moe_backend\")","+    oracle = getattr(oracle_module, oracle_cls)","+    none_backend = getattr(oracle_module, backend_enum).NONE","+","+    assert oracle.placeholder_backend is none_backend","+    # Outside of a requantization source, selection is not skipped.","+    assert oracle.maybe_skip_for_requantization_source() is None","+","+    def fail(*args, **kwargs):","+        raise AssertionError(\"Checkpoint backend dispatch must be skipped.\")","+","+    monkeypatch.setattr(oracle, \"try_backend\", fail)","+    monkeypatch.setattr(oracle, \"return_or_raise\", fail)","+","+    if source_format is None:","+        # Dispatch must not read the config or any other argument.","+        with skip_checkpoint_backend_selection():","+            assert select(**_required_selector_args(select)) == (","+                none_backend,","+                RequantizationSourceExperts,","+            )","+        return","+","+    target_dispatch = source_construction(","+        \"vllm.model_executor.layers.quantization.online.mxfp4.select_mxfp4_moe_backend\",","+        (Mxfp4MoeBackend.EMULATION, RequantizationSourceExperts),","+    )","+    config: QuantizationConfig","+    expected_source_cls: type[","+        ModelOptNvFp4FusedMoE","+        | CompressedTensorsW4A4Nvfp4MoEMethod","+        | QuarkNvfp4MoEMethod","+    ]","+    if source_format == \"modelopt\":","+        config = ModelOptNvFp4Config(is_checkpoint_nvfp4_serialized=True)","+        expected_source_cls = ModelOptNvFp4FusedMoE","+    elif source_format == \"compressed_tensors\":","+        config = ModelOptMxFp8Config(","+            is_checkpoint_mxfp8_serialized=True,","+            kv_cache_quant_algo=None,","+            exclude_modules=[],","+            moe_quant_algo=\"NVFP4\",","+        )","+        expected_source_cls = CompressedTensorsW4A4Nvfp4MoEMethod","+    else:","+        weight = [","+            {","+                \"dtype\": \"fp4\",","+                \"qscheme\": \"per_group\",","+                \"group_size\": 16,","+                \"is_dynamic\": False,","+            },","+            {\"dtype\": \"fp8_e4m3\", \"qscheme\": \"per_tensor\", \"is_dynamic\": False},","+        ]","+        config = _fully_quantized_quark_config(","+            weight=weight, input_tensors=[{**weight[0], \"is_dynamic\": True}, weight[1]]","+        )","+        expected_source_cls = QuarkNvfp4MoEMethod","+    config.online_quantization_config = OnlineQuantizationConfig(","+        quant_config_args(moe=\"mxfp4\")","+    )","+","+    layer = _TestRoutedExperts()","+    layer.expert_map_manager = SimpleNamespace(num_fused_shared_experts=0)","+    target = resolve_quant_method(config, layer, \"model.layers.0.mlp.experts\")","+    assert isinstance(target, Mxfp4OnlineMoEMethod)","+    source = target.requantization_source","+    assert isinstance(source, expected_source_cls)","+    assert source.nvfp4_backend is none_backend","+    assert source.experts_cls is RequantizationSourceExperts","+    assert not is_requantization_source()","+    with torch.device(\"cpu\"):","+        target.create_weights(","+            layer,","+            num_experts=8,","+            hidden_size=256,","+            intermediate_size_per_partition=256,","+            params_dtype=torch.bfloat16,","+            global_num_experts=8,","+            weight_loader=Mock(),","+        )","+    assert target.requantization_source_parameters","+    assert all(not parameter.is_meta for parameter in layer.parameters())","+    target_dispatch.assert_called_once()","+    assert not is_requantization_source()","+","+","+@pytest.mark.parametrize(","+    \"kind,source_format\",","+    [","+        *[","+            pytest.param(kind, None, id=kind)","+            for kind in (\"mxfp8\", \"mxfp4\", \"mxfp6\", \"nvfp4\", \"fp8\", \"wfp8_a16\", \"int8\")","+        ],","+        *[","+            pytest.param(\"mxfp8\", fmt, id=f\"mxfp8-construct-{fmt}\")","+            for fmt in (\"modelopt\", \"quark\")","+        ],","+    ],","+)","+@pytest.mark.skip_global_cleanup","+def test_linear_dispatch_skipped_for_requantization_source(","+    kind: str,","+    source_format: str | None,","+    monkeypatch,","+    source_construction,","+) -> None:","+    \"\"\"Requantization sources get a placeholder linear kernel, without dispatch.\"\"\"","+","+    def fail(*args, **kwargs):","+        raise AssertionError(\"Kernel dispatch must be skipped.\")","+","+    for dispatch in (","+        \"_resolve_backend_kernels\",","+        \"_get_linear_backend\",","+        \"choose_scaled_mm_linear_kernel\",","+    ):","+