include \"xla/service/platform_util.h\""," #include \"xla/stream_executor/device_description.h\"","+#include \"xla/stream_executor/device_description.pb.h\""," #include \"xla/stream_executor/platform.h\""," #include \"xla/stream_executor/platform_manager.h\""," #include \"xla/stream_executor/stream_executor.h\"","@@ -64,6 +71,11 @@ absl::string_view kClockFields[] = {"," "," constexpr int64_t kClockToleranceKHz = 1000;"," ","+// The device memory size depends on the driver version, so the live device may","+// have slightly more memory than the spec (same tolerance as","+// embedded_target_config_test).","+constexpr int64_t kTotalGlobalMemToleranceBytes = 1024 * 1024 * 1024;","+"," // True if the running cuDNN runtime supports DEVICEPROP serialization"," // (added in 9.8). Older runtimes will fail set_device_id().build()."," bool CudnnSupportsDeviceProps() {","@@ -94,7 +106,9 @@ void StripIgnoredFields(Json::Value& v) {"," "," void ExpectClockFieldsClose(const Json::Value& live, const Json::Value& synth) {","   for (absl::string_view field : kClockFields) {","-    if (!live.isMember(field.data()) || !synth.isMember(field.data())) continue;","+    if (!live.isMember(field.data()) || !synth.isMember(field.data())) {","+      continue;","+    }","     int64_t live_val = live[field.data()].asInt64();","     int64_t synth_val = synth[field.data()].asInt64();","     EXPECT_LE(std::abs(live_val - synth_val), kClockToleranceKHz)","@@ -108,14 +122,57 @@ std::string Dump(const Json::Value& v) {","   return Json::writeString(builder, v);"," }"," ","+void ExpectPropsMatch(Json::Value live_json, Json::Value synth_json,","+                      const se::DeviceDescription& desc) {","+  VLOG(1) << \"live : \" << Dump(live_json);","+  VLOG(1) << \"synth: \" << Dump(synth_json);","+","+  constexpr char kOversizedSharedMemoryField[] =","+      \"oversizedSharedMemoryPerBlock\";","+  const int64_t live_oversized_shared_memory =","+      live_json.get(kOversizedSharedMemoryField, 0).asInt64();","+  const int64_t synth_oversized_shared_memory =","+      synth_json.get(kOversizedSharedMemoryField, 0).asInt64();","+  const auto* cc = desc.gpu_compute_capability().cuda_compute_capability();","+  const bool is_sm107 = cc && cc->major == 10 && cc->minor == 7;","+  EXPECT_EQ(synth_oversized_shared_memory,","+            is_sm107 ? desc.oversized_shared_memory_per_block() : 0);","+  // cuDNN may omit this property or report zero.","+  if (live_oversized_shared_memory != 0) {","+    EXPECT_EQ(synth_oversized_shared_memory, live_oversized_shared_memory);","+  }","+  live_json.removeMember(kOversizedSharedMemoryField);","+  synth_json.removeMember(kOversizedSharedMemoryField);","+","+  StripIgnoredFields(live_json);","+  StripIgnoredFields(synth_json);","+  ExpectClockFieldsClose(live_json, synth_json);","+  for (absl::string_view field : kClockFields) {","+    live_json.removeMember(field.data());","+    synth_json.removeMember(field.data());","+  }","+","+  constexpr char kTotalGlobalMemField[] = \"totalGlobalMem\";","+  const int64_t live_memory = live_json[kTotalGlobalMemField].asInt64();","+  const int64_t synth_memory = synth_json[kTotalGlobalMemField].asInt64();","+  // The spec must not promise more memory than the device actually has.","+  EXPECT_LE(synth_memory, live_memory);","+  EXPECT_LE(live_memory - synth_memory, kTotalGlobalMemToleranceBytes);","+  live_json.removeMember(kTotalGlobalMemField);","+  synth_json.removeMember(kTotalGlobalMemField);","+","+  EXPECT_EQ(live_json, synth_json);","+}","+"," TEST(CudnnDevicePropsTest, MatchesLiveDevice) {","   if (!CudnnSupportsDeviceProps()) {","     GTEST_SKIP() << \"cuDNN runtime < 9.8 does not support DeviceProperties \"","                     \"JSON serialization.\";","   }"," ","-  std::string name =","-      absl::AsciiStrToUpper(PlatformUtil::CanonicalPlatformName(\"gpu\").value());","+  ASSERT_OK_AND_ASSIGN(std::string platform_name,","+                       PlatformUtil::CanonicalPlatformName(\"gpu\"));","+  std::string name = absl::AsciiStrToUpper(platform_name);","   ASSERT_OK_AND_ASSIGN(se::Platform * platform,","                        se::PlatformManager::PlatformWithName(name));"," ","@@ -131,41 +188,7 @@ TEST(CudnnDevicePropsTest, MatchesLiveDevice) {","     ASSERT_FALSE(build_err.is_bad()) << build_err.get_message();"," ","     ASSERT_OK_AND_ASSIGN(auto synth, BuildDeviceProperties(desc));","-","-    Json::Value live_json = ParseProps(live);","-    Json::Value synth_json = ParseProps(synth);","-","-    VLOG(1) << \"live : \" << Dump(live_json);","-    VLOG(1) << \"synth: \" << Dump(synth_json);","-","-    constexpr char kOversizedSharedMemoryField[] =","-        \"oversizedSharedMemoryPerBlock\";","-    const int64_t live_oversized_shared_memory =","-        live_json.get(kOversizedSharedMemoryField, 0).asInt64();","-    const int64_t synth_oversized_shared_memory =","-        synth_json.get(kOversizedSharedMemoryField, 0).asInt64();","-    const auto* cc = desc.gpu_compute_capability().cuda_compute_capability();","-    const bool is_sm107 = cc && cc->major == 10 && cc->minor == 7;","-    EXPECT_EQ(synth_oversized_shared_memory,","-              is_sm107 ? desc.oversized_shared_memory_per_block() : 0);","-    // cuDNN may omit this property or report zero.","-    if (live_oversized_shared_memory != 0) {","-      EXPECT_EQ(synth_oversized_shared_memory, live_oversized_shared_memory);","-    }","-    live_json.removeMember(kOversizedSharedMemoryField);","-    synth_json.removeMember(kOversizedSharedMemoryField);","-","-    StripIgnoredFields(live_json);","-    StripIgnoredFields(synth_json);","-    ExpectClockFieldsClose(live_json, synth_json);","-    for (absl::string_view field : kClockFields) {","-      live_json.removeMember(field.data());","-      synth_json.removeMember(field.data());","-    }","-","-    EXPECT_EQ(live_json, synth_json) << \"live:\\n\"","-                                     << Dump(live_json) << \"\\nsynth:\\n\"","-                                     << Dump(synth_json);","+    ExpectPropsMatch(ParseProps(live), ParseProps(synth), desc);","     any_compared = true;","   }"," ","@@ -174,5 +197,58 @@ TEST(CudnnDevicePropsTest, MatchesLiveDevice) {","   }"," }"," ","+// Make sure the cudnn_frontend::DeviceProperties created from our checked in","+// target config still matches the one from the live device. This should catch","+// cases where CuDNN requires a new field to be serialized, which may not have","+// been mapped in our target config.","+TEST(CudnnDevicePropsTest, SpecMatchesLiveDevice) {","+  if (!CudnnSupportsDeviceProps()) {","+    GTEST_SKIP() << \"cuDNN runtime < 9.8 does not support DeviceProperties \"","+                    \"JSON serialization.\";","+  }","+","+  ASSERT_OK_AND_ASSIGN(std::string platform_name,","+                       PlatformUtil::CanonicalPlatformName(\"gpu\"));","+  std::string name = absl::AsciiStrToUpper(platform_name);","+  ASSERT_OK_AND_ASSIGN(se::Platform * platform,","+                       se::PlatformManager::PlatformWithName(name));","+  ASSERT_GT(platform->VisibleDeviceCount(), 0);","+  ASSERT_OK_AND_ASSIGN(se::StreamExecutor * executor,","+                       platform->ExecutorForDevice(0));","+  const se::DeviceDescription& live_desc = executor->GetDeviceDescription();","+","+  std::optional<se::GpuTargetConfigProto> spec;","+  // GpuModel values are contiguous from 0, and GetGpuTargetConfig returns","+  // NotFound past the last one.","+  for (int i = 0;; ++i) {","+    absl::StatusOr<se::GpuTargetConfigProto> proto =","+        GetGpuTargetConfig(static_cast<GpuModel>(i));","+    if (absl::IsNotFound(proto.status())) {","+      break;","+    }","+    ASSERT_OK(proto);","+    // Name alone doesn't distinguish MIG partitions from the full GPU.","+    if (proto->gpu_device_info().name() == live_desc.name() &&","+        proto->gpu_device_info().core_count() == live_desc.core_count()) {","+      spec = *std::move(proto);","+      break;","+    }","+  }","+  if (!spec.has_value()) {","+    GTEST_SKIP() << \"No spec for \" << live_desc.name();","+  }","+  SCOPED_TRACE(live_desc.name());","+","+  ASSERT_OK_AND_ASSIGN(GpuTargetConfig spec_config,","+                       GpuTargetConfig::FromProto(*spec));","+  auto live = std::make_shared<cudnn_frontend::DeviceProperties>();","+  auto build_err = live->set_device_id(0).build();","+  ASSERT_FALSE(build_err.is_bad()) << build_err.get_message();","+  ASSERT_OK_AND_ASSIGN(auto synth,","+                       BuildDeviceProperties(spec_config.device_description));","+  ExpectPropsMatch(ParseProps(live), ParseProps(synth),","+                   spec_config.device_description);","+}","+"," }  // namespace"," }  // namespace xla::gpu"],"additions":115,"deletions":39,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/target_config/specs/a100_pcie_80.txtpb","lines":["@@ -141,6 +141,7 @@ gpu_device_info {","   thread_dim_limit_x: 1024","   thread_dim_limit_y: 1024","   thread_dim_limit_z: 64","+  reserved_shared_memory_per_block: 1024"," }"," platform_name: \"CUDA\""," device_description_str: \"NVIDIA A100 80GB PCIe\""],"additions":1,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/target_config/specs/a100_sxm_40.txtpb","lines":["@@ -29,7 +29,7 @@ gpu_device_info {","   memory_bandwidth: 1555200000000","   l2_cache_size: 41943040","   clock_rate_ghz: 1.41","-  device_memory_size: 42331013120","+  device_memory_size: 42298834944","   shared_memory_per_block_optin: 166912","   cuda_compute_capability {","     major: 8","@@ -147,6 +147,9 @@ gpu_device_info {","   pcie_bandwidth: 34359738368","   ecc_enabled: true","   name: \"NVIDIA A100-SXM4-40GB\"","+  mem_clock_ghz: 1.215","+  reserved_shared_memory_per_block: 1024","+  max_blocks_per_multiprocessor: 32","   driver_version: \"13.0.0\"","   runtime_version: \"12.8.0\"","   compile_time_toolkit_version: \"12.8.0\""],"additions":4,"deletions":1,"truncated":false},{"path":"th