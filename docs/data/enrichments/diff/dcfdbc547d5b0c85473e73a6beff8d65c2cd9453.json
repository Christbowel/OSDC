   let created = self.users.add_or_login(username, password).await?;","+        if let Some(rewritten_to) = self.rewritten_to {","+            self.users.set_password(username, rewritten_to).await?;","+        }","+        Ok(created)","+    }","+","+    async fn list_users(&self) -> pnpr::Result<Vec<String>> {","+        self.users.list_users().await","+    }","+","+    async fn password_hash(&self, username: &str) -> pnpr::Result<Option<String>> {","+        self.users.password_hash(username).await","+    }","+","+    async fn create_user(&self, username: &str, password: &str) -> pnpr::Result<bool> {","+        self.users.create_user(username, password).await","+    }","+","+    async fn set_password(&self, username: &str, password: &str) -> pnpr::Result<bool> {","+        self.users.set_password(username, password).await","+    }","+","+    async fn delete_user(&self, username: &str) -> pnpr::Result<bool> {","+        self.users.delete_user(username).await","+    }","+}","+","+#[tokio::test]","+async fn a_login_racing_the_removal_of_a_reserved_account_keeps_no_account() {","+    let dir = TempDir::new().unwrap();","+    let users = Arc::new(RemovedDuringLogin { users: UserStore::in_memory(), rewritten_to: None });","+    users.users.create_user(\"admin_alice\", \"correct_alice_password\").await.unwrap();","+    let tokens = Arc::new(TokenStore::in_memory());","+    let auth = AuthState { users: Arc::clone(&users) as _, tokens: Arc::clone(&tokens) as _ };","+    let app = router_with_auth(test_config(dir.path()), auth);","+","+    let (status, text, _) = put_login(&app, \"admin_alice\", \"malicious_password\").await;","+    assert_eq!(status, StatusCode::FORBIDDEN);","+    assert_eq!(text, r#\"Username \"admin_alice\" is reserved\"#);","+    assert!(","+        users.users","+            .password_hash(\"admin_alice\")","+            .await","+            .unwrap()","+            .is_none(),","+    );","+    assert!(","+        tokens","+            .list_for_user(\"admin_alice\")","+            .await","+            .unwrap()","+            .is_empty(),","+    );","+}","+","+#[tokio::test]","+async fn cli_add_user_revokes_tokens_left_under_the_name() {","+    let dir = TempDir::new().unwrap();","+    let config = htpasswd_config(dir.path());","+    let left_behind = AuthState::load(&config.identity.auth, &config.identity.backend)","+        .await","+        .unwrap()","+        .tokens","+        .issue(\"admin_alice\")","+        .await","+        .unwrap();","+","+    let cmd = Command::AddUser {","+        username: \"admin_alice\".to_string(),","+        password: Some(\"bootstrap_pass\".to_string()),","+    };","+    pnpr::cli_commands::run_command(&config, cmd).await.unwrap();","+","+    let auth = AuthState::load(&config.identity.auth, &config.identity.backend)","+        .await","+        .unwrap();","+    assert_eq!(auth.tokens.lookup(&left_behind).await.unwrap(), None);","+}","+","+#[tokio::test]","+async fn a_login_racing_the_removal_of_a_reserved_account_keeps_an_admin_rewrite() {","+    let dir = TempDir::new().unwrap();","+    let users = Arc::new(RemovedDuringLogin {","+        users: UserStore::in_memory(),","+        rewritten_to: Some(\"admin_rewritten_password\"),","+    });","+    users.users.create_user(\"admin_alice\", \"correct_alice_password\").await.unwrap();","+    let auth =","+        AuthState { users: Arc::clone(&users) as _, tokens: Arc::new(TokenStore::in_memory()) };","+    let app = router_with_auth(test_config(dir.path()), auth);","+","+    let (status, _, _) = put_login(&app, \"admin_alice\", \"malicious_password\").await;","+    assert_eq!(status, StatusCode::FORBIDDEN);","+    let (outcome, _) =","+        users.users.add_or_login(\"admin_alice\", \"admin_rewritten_password\").await.unwrap();","+    assert_eq!(outcome, UpsertOutcome::LoggedIn);","+}"],"additions":146,"deletions":23,"truncated":false},{"path":"pnpr/docs/cli.md","lines":["@@ -10,6 +10,7 @@ pnpr verify [OPTIONS]"," pnpr export --out <dir> [OPTIONS]"," pnpr migrate-storage [OPTIONS]"," pnpr import-htpasswd --source <path> [OPTIONS]","+pnpr add-user <username> [--password <password>]"," pnpr [OPTIONS] oci-gc --registry <name>"," pnpr [OPTIONS] cache-gc [CACHE_OPTIONS]"," ```","@@ -137,6 +138,25 @@ pnpr import-htpasswd --source /path/to/old/htpasswd"," | `--dry-run` | Preview imported user counts without writing to target file. |"," | `--overwrite` | Overwrite conflicting credentials for existing users in destination file (skipped by default). |"," ","+### add-user","+","+Creates a user account, or changes the password of an existing one. Use it to","+create admin accounts, which cannot self-register. Creating an account revokes","+any tokens left under that username.","+","+The command needs `auth.htpasswd.file` or a database backend. With the","+htpasswd file, run it while pnpr is stopped. A running pnpr does not see the","+new account, and its next account change overwrites the file.","+","+```sh","+# Prompts for the password, or reads it from stdin","+pnpr add-user alice","+```","+","+| Flag | Description |","+| --- | --- |","+| `--password <password>` | The account's password. Read from the terminal or stdin when omitted. |","+"," ### oci-gc"," "," Added in: v0.1.0-alpha.11"],"additions":20,"deletions":0,"truncated":false},{"path":"pnpr/docs/configuration.md","lines":["@@ -590,9 +590,9 @@ may:"," - change the rules of every registry with","   [`rulesManagedBy: api`](#changing-rules-through-the-api)."," ","-The first admin account still has to exist. Let it self-register before you","-set `max_users` to `-1`, or create it in the htpasswd file or the shared","-database.","+Nobody can self-register an admin's username, or a username an","+[OIDC binding](oidc.md) maps to. Create the first admin account with","+[`pnpr add-user`](cli.md#add-user)."," "," ```yaml title=\"pnpr.yaml\""," auth:",""],"additions":3,"deletions":3,"truncated":false}],"additions":247,"deletions":72,"truncated":f