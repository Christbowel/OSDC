      n_rot_k = other->n_rot_k;","         n_rot_v = other->n_rot_v;","     } else {","-        const char * LLAMA_ATTN_ROT_DISABLE = getenv(\"LLAMA_ATTN_ROT_DISABLE\");","-        const bool attn_rot_disable = LLAMA_ATTN_ROT_DISABLE ? atoi(LLAMA_ATTN_ROT_DISABLE) : false;","+        // two knobs turn the same thing off: the environment variable, for the whole process, and","+        //   the model setting, for the contexts of one model - see llama_model_set_attn_rot","+        const char * env_rot_disable = getenv(\"LLAMA_ATTN_ROT_DISABLE\");","+","+        const bool attn_rot_disable = !model.attn_rot || (env_rot_disable != nullptr && atoi(env_rot_disable) != 0);","         if (attn_rot_disable) {","-            LLAMA_LOG_WARN(\"%s: attention rotation force disabled (LLAMA_ATTN_ROT_DISABLE)\\n\", __func__);","+            LLAMA_LOG_WARN(\"%s: attention rotation force disabled (%s)\\n\", __func__,","+                    model.attn_rot ? \"LLAMA_ATTN_ROT_DISABLE\" : \"llama_model_set_attn_rot\");","         }"," ","         bool attn_rot_k ="],"additions":7,"deletions":3,"truncated":false},{"path":"src/llama-memory.cpp","lines":["@@ -1,5 +1,11 @@"," #include \"llama-memory.h\""," ","+#include \"llama-ext.h\"","+#include \"llama-io.h\"","+","+#include <set>","+#include <vector>","+"," llama_memory_status llama_memory_status_combine(llama_memory_status s0, llama_memory_status s1) {","     bool has_update = false;"," ","@@ -57,3 +63,30 @@ bool llama_memory_status_is_fail(llama_memory_status status) {"," ","     return false;"," }","+","+// collects the buffers of the tensors that a state write visits, without keeping the data","+struct llama_memory_buffers_writer : public llama_io_write_i {","+    std::set<ggml_backend_buffer_t> buffers;","+    size_t size = 0;","+","+    void write(const void *, size_t n) override {","+        size += n;","+    }","+","+    void write_tensor(ggml_tensor * tensor, size_t, size_t n) override {","+        buffers.insert(tensor->buffer);","+        size += n;","+    }","+","+    size_t n_bytes() override {","+        return size;","+    }","+};","+","+std::vector<ggml_backend_buffer_t> llama_memory_get_buffers(const llama_memory_t mem) {","+    llama_memory_buffers_writer writer;","+","+    mem->state_write(writer);","+","+    return std::vector<ggml_backend_buffer_t>(writer.buffers.begin(), writer.buffers.end());","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"src/llama-model.cpp","lines":["@@ -3781,6 +3781,10 @@ ggml_backend_dev_t llama_model_get_device(const struct llama_model * model, int","     return model->devices[i].dev;"," }"," ","+void llama_model_set_attn_rot(struct llama_model * model, bool value) {","+    model->attn_rot = value;","+}","+"," //"," // llama_model_base"," //"],"additions":4,"deletions":0,"truncated":false},{"path":"src/llama-model.h","lines":["@@ -690,6 +690,9 @@ struct llama_model {"," ","     llama_hadamard hdmd;"," ","+    // see llama_model_set_attn_rot","+    bool attn_rot = true;","+","     // for classifier models","     std::vector<std::string> classifier_labels;"," "],"additions":3,"deletions":0,"truncated":false},{"path":"tests/.gitignore","lines":["@@ -2,6 +2,7 @@"," !*.*"," !snapshots/"," !fusion/","+!llama-context/"," *.o"," ggml-common.h"," **/*.swp"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/CMakeLists.txt","lines":["@@ -166,8 +166,17 @@ if (LLAMA_LLGUIDANCE)","     llama_build_and_test(test-grammar-llguidance.cpp ARGS ${PROJECT_SOURCE_DIR}/models/ggml-vocab-llama-bpe.gguf)"," endif ()"," ","-llama_build(test-recurrent-state-rollback.cpp)","-llama_build(test-save-load-state.cpp)","+# llama_context state tests: KV and recurrent state save, load, copy, rollback","+set(LLAMA_CONTEXT_TEST_SRC","+    test-llama-context.cpp","+    llama-context/cases-kv.cpp","+    llama-context/cases-rs.cpp","+    llama-context/test-case.cpp","+    llama-context/test-log.cpp","+    llama-context/test-runner.cpp","+    llama-context/test-util.cpp","+)","+llama_build(${LLAMA_CONTEXT_TEST_SRC})"," "," if (NOT WIN32 OR NOT BUILD_SHARED_LIBS)","     # these tests are disabled on Windows because they use internal functions not exported with LLAMA_API (when building with shared libraries)","@@ -213,6 +222,8 @@ if (NOT WIN32 OR NOT BUILD_SHARED_LIBS)"," ","     # llama_build_and_test(test-double-float.cpp) # SLOW"," ","+    # TODO: after `test-llama-archs` is refactored to not link internal symbols, we can move all related tests out of","+    #       this branch and run them on all platforms","     llama_build(test-llama-archs.cpp)"," ","     set(MODEL_DIR \"${CMAKE_CURRENT_BINARY_DIR}/test-models/\")","@@ -228,26 +239,18 @@ if (NOT WIN32 OR NOT BUILD_SHARED_LIBS)","         FIXTURES_SETUP generate-models","     )"," ","-    # Test recurrent-state rollback across all architectures, using the generated dummy models","+    # Test context state handling across all architectures, using the generated dummy models","     llama_test(","-        test-recurrent-state-rollback","+        test-llama-context","         LABEL main","         ARGS --models \"${MODEL_DIR}\"","     )","     # abort on graph reallocations that the initial reserve should have covered","-    set_tests_properties(test-recurrent-state-rollback PROPERTIES","+    set_tests_properties(test-llama-context PROPERTIES","         FIXTURES_REQUIRED generate-models","         ENVIRONMENT \"GGML_SCHED_DEBUG_REALLOC=1\"","     )"," ","-    # Test state save/load functionality across all architectures, using the generated dummy models","-    llama_test(","-        test-save-load-state","-        LABEL main","-        ARGS --models \"${MODEL_DIR}\"","-    )","-    set_tests_properties(test-save-load-state PROPERTIES FIXTURES_REQUIRED generate-models)","-","     llama_build(test-fusion.cpp)"," endif()"," ","@@ -288,6 +291,10 @@ add_test(NAME test-download-model COMMAND ${CMAKE_COMMAND}"," )"," set_tests_properties(test-download-model PROPERTIES FIXTURES_SETUP test-download-model)"," ","+# the context state cases against a real model, the sweep above uses the generated dummy ones","+llama_test(test-llama-context NAME test-llama-context-model LABEL \"model\" ARGS -m \"${MODEL_DEST}\")","+set_tests_properties(test-llama-context-model PROPERTIES FIXTURES_REQUIRED test-download-model)","+"," llama_build_and_test(test-thread-safety.cpp ARGS -m \"${MODEL_DEST}\" -ngl 99 -p \"The meaning of life is\" -n 128 -c 256 -ub 32 -np 4 -t 2)"," set_tests_properties(test-thread-safety PROPERTIES FIXTURES_REQUIRED test-download-model)"," ","@@ -313,12 +320,6 @@ llama_build_and_test(test-model-load-cancel.cpp LABEL \"model\")"," llama_build_and_test(test-autorelease.cpp       LABEL \"model\")"," llama_build_and_test(test-backend-sampler.cpp   LABEL \"model\")"," ","-# Test for state restore with fragmented KV cache","-# Requires a model, uses same args pattern as test-thread-safety","-# TODO: run on all dummy models","-llama_build_and_test(test-state-restore-fragmented.cpp LABEL \"model\" ARGS -m \"${MODEL_DEST}\")","-set_tests_properties(test-state-restore-fragmented PROPERTIES FIXTURES_REQUIRED test-download-model)","-"," if (APPLE)","     llama_build(test-rset-release.cpp)"," endif()"],"additions":20,"deletions":19,"truncated":false},{"path":"tests/llama-context/cases-kv.cpp","lines":["@@ -0,0 +1,694 @@","+// KV cache state cases","+//","+#include \"test-case.h\"","+","+#include \"test-log.h\"","+#include \"test-util.h\"","+","+#include \"common.h\"","+","+#include \"../../src/llama-ext.h\" // llama_model_set_attn_rot","+","+#include <algorithm>","+#include <cstdio>","+#include <cstring>","+#include <fstream>","+#include <functional>","+#include <iterator>","+#include <string>","+#include <utility>","+#include <vector>","+","+//","+// reference run","+//","+","+// - decode all but the last token, saving the state to disk","+// - decode the last token","+// - generate n_predict tokens","+// the logits it produces are the reference of every case with needs_baseline()","+struct case_baseline : ctx_test {","+    const char * name() const override { return \"baseline\"; }","+","+    const char * description() const override {","+        return \"reference generation over the whole prompt, saves the state before the last token\";","+    }","+","+    case_result run(model_run & mr) const override {","+        ctx_opts opts;","+        opts.n_seq_max = 2;","+","+        auto ctx  = mr.ctx(opts);","+        auto smpl = mr.sampler();","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        auto n_past = 0;","+        if (!common_prompt_batch_decode(ctx.get(), mr.tokens, (int) mr.tokens.size(), n_past, mr.params.n_batch, mr.params.out_file, true)) {","+            TLOG_ERR(\"%s: failed to decode the prompt\\n\", __func__);","+            return case_result::fail();","+        }","+","+        generation_result result;","+        if (!generate_tokens(ctx.get(), smpl.get(), n_past, mr.params.n_predict, 0, result)) {","+            return case_result::fail();","+        }","+        if (result.empty()) {","+            return case_result::fail();","+        }","+","+        mr.baseline      = std::move(result);","+        mr.have_baseline = true;","+","+        return case_result::pass();","+    }","+};","+","+//","+// sequences","+//","+","+// - decode the same prefix into two sequences","+// - remove sequence 0","+// - verify that sequence 1 remains unchanged","+struct case_seq_rm_isolated : ctx_test {","+    const char * name() const override { return \"seq_rm\"; }","+","+    const char * description() const override {","+        return \"removing one sequence leaves the state of the other sequences untouched\";","+    }","+","+    case_result run(model_run & mr) const override {","+        ctx_opts opts;","+        opts.n_ctx      = 256;","+        opts.n_seq_max  = 2;","+        opts.kv_unified = 1;","+","+        auto ctx = mr.ctx(opts);","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        const size_t n_tokens = std::min<size_t>(mr.tokens.size(), 128);","+        for (llama_seq_id seq_id = 0; seq_id < 2; ++seq_id) {","+            if (!decode_seq(ctx.get(), mr.tokens, 0, (llama_pos) n_tokens, seq_id, true)) {","+                TLOG_ERR(\"%s: failed to decode the prompt for sequence %d\\n\", __func__, seq_id);","+                return case_result::fail();","+            }","+        }","+","+        std::vector<uint8_t> before;","+        if (!get_seq_state(ctx.get(), 1, LLAMA_STATE_SEQ_FLAGS_NONE, before)) {","+            return case_result::fail();","+        }","+","+        if (!seq_rm(ctx.get(), 0)) {","+            return case_result::fail();","+        }","+","+        std::vector<uint8_t> after;","+        if (!get_seq_state(ctx.get(), 1, LLAMA_STATE_SEQ_FLAGS_NONE, after)) {","+            return case_result::fail();","+        }","+","+        CTX_REQUIRE(blobs_equal(before, after), \"removing seq 0 changed the state of seq 1\");","+","+        return case_result::pass();","+    }","+};","+","+// - load the state saved by the baseline case","+// - replay its last token","+// - generate again and compare against the baseline logits","+struct case_state_load : ctx_test {","+    const char * name() const override { return \"state_load\"; }","+","+    const char * description() const override {","+        return \"a saved session replays to the same logits as the run that saved it\";","+    }","+","+    bool needs_baseline() const override { return true; }","+","+    case_result run(model_run & mr) const override {","+        ctx_opts opts;","+        opts.n_seq_max = 2;","+","+        auto ctx  = mr.ctx(opts);","+        auto smpl = mr.sampler();","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        int n_past = 0;","+        if (!load_state_replay_last(ctx.get(), mr.params.out_file, mr.tokens, n_past)) {","+            return case_result::fail();","+        }","+","+        if (!generate_tokens_compare(ctx.get(), smpl.get(), n_past, mr.params.n_predict, 0, mr.baseline, NMSE_THRESHOLD)) {","+            return case_result::fail();","+        }","+","+        return case_result::pass();","+    }","+};","+","+// - load the state saved by the baseline case and replay its last token","+// - copy sequence 0 to sequence 1 over the given io path, clearing the cache in between","+// - continue on sequence 1 and compare against the baseline logits","+struct case_seq_cp : ctx_test {","+    explicit case_seq_cp(bool on_device_) : on_device(on_device_) {}","+","+    const char * name() const override { return on_device ? \"cp_d\" : \"cp_h\"; }","+","+    const char * description() const override {","+        return on_device ? \"copying a sequence over the device io path keeps its state\"","+                         : \"copying a sequence over the host io path keeps its state\";","+    }","+","+    bool needs_baseline() const override { return true; }","+","+    case_result run(model_run & mr) const override {","+        ctx_opts opts;","+        opts.n_seq_max = 2;","+","+        auto ctx  = mr.ctx(opts);","+        auto smpl = mr.sampler();","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        const uint32_t flags = on_device ? LLAMA_STATE_SEQ_FLAGS_ON_DEVICE : LLAMA_STATE_SEQ_FLAGS_NONE;","+        TLOG_INF(\"io path: %s\\n\", on_device ? \"device\" : \"host\");","+","+        int n_past = 0;","+        if (!load_state_replay_last(ctx.get(), mr.params.out_file, mr.tokens, n_past)) {","+            return case_result::fail();","+        }","+","+        {","+            std::vector<uint8_t> seq_store;","+            if (!get_seq_state(ctx.get(), 0, flags, seq_store)) {","+                return case_result::fail();","+            }","+            TLOG_TRC(\"%s: seq 0 copied, %zu bytes\\n\", __func__, seq_store.size());","+","+            llama_memory_clear(llama_get_memory(ctx.get()), true);","+            TLOG_TRC(\"%s: kv cache cleared\\n\", __func__);","+","+            if (!set_seq_state(ctx.get(), 1, flags, seq_store)) {","+                return case_result::fail();","+            }","+            TLOG_TRC(\"%s: seq 1 restored, %zu bytes\\n\", __func__, seq_store.size());","+        }","+","+        if (!generate_tokens_compare(ctx.get(), smpl.get(), n_past, mr.params.n_predict, 1, mr.baseline, NMSE_THRESHOLD)) {","+            return case_result::fail();","+        }","+","+        return case_result::pass();","+    }","+","+private:","+    bool on_device;","+};","+","+// - decode the same prefix on two sequences, interleaving seq 0 cells between the seq 1 cells","+// - save the seq 1 state, free the interleaved seq 0 cells, and restore via the given io path","+// - the restore destination is non-contiguous: scatter reads are batched per contiguous run","+// - save again on the host and compare the two blobs byte for byte","+struct case_seq_cp_scatter : ctx_test {","+    explicit case_seq_cp_scatter(bool on_device_) : on_device(on_device_) {}","+","+    const char * name() const override { return on_device ? \"cp_d_s\" : \"cp_h_s\"; }","+","+    const char * description() const override {","+        return \"saving and restoring a sequence with a fragmented (scattered) cell range\";","+    }","+","+    case_result run(model_run & mr) const override {","+        ctx_opts opts;","+        opts.n_ctx      = 256;","+        opts.n_seq_max  = 2;","+        opts.kv_unified = 1;","+","+        auto ctx = mr.ctx(opts);","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        const uint32_t flags = on_device ? LLAMA_STATE_SEQ_FLAGS_ON_DEVICE : LLAMA_STATE_SEQ_FLAGS_NONE;","+        TLOG_INF(\"io path: %s\\n\", on_device ? \"device\" : \"host\");","+","+        // seq 0 cells 0,1,4 interleave the seq 1 cells 2,3,5","+        if (!decode_one(ctx.get(), mr.tokens[0], 0, 0) ||","+            !decode_one(ctx.get(), mr.tokens[1], 1, 0) ||","+            !decode_one(ctx.get(), mr.tokens[0], 0, 1) ||","+            !decode_one(ctx.get(), mr.tokens[1], 1, 1) ||","+            !decode_one(ctx.get(), mr.tokens[2], 2, 0) ||","+            !decode_one(ctx.get(), mr.tokens[2], 2, 1)) {","+            TLOG_ERR(\"%s: failed to build the interleaved state\\n\", __func__);","+            return case_result::fail();","+        }","+","+        // host blob: contains the KV data, used for the byte-for-byte comparison","+        std::vector<uint8_t> state_before;","+        if (!get_seq_state(ctx.get(), 1, LLAMA_STATE_SEQ_FLAGS_NONE, state_before)) {","+            return case_result::fail();","+        }","+","+        // save via the io path under test","+        std::vector<uint8_t> state_save;","+        if (!get_seq_state(ctx.get(), 1, flags, state_save)) {","+            return case_result::fail();","+        }","+        TLOG_TRC(\"%s: seq 1 saved via %s, %zu bytes\\n\", __func__, on_device ? \"device\" : \"host\", state_save.size());","+","+        // free seq 0's cells so the ring is fragmented: the restore destination (seq 1's interleaved cells) stays non-contiguous","+        if (!seq_rm(ctx.get(), 0)) {","+            return case_result::fail();","+        }","+","+        // restore via the io path under test","+        if (!set_seq_state(ctx.get(), 1, flags, state_save)) {","+            return case_result::fail();","+        }","+        TLOG_TRC(\"%s: seq 1 restored via %s, %zu bytes\\n\", __func__, on_device ? \"device\" : \"host\", state_save.size());","+","+        std::vector<uint8_t> state_after;","+        if (!get_seq_state(ctx.get(), 1, LLAMA_STATE_SEQ_FLAGS_NONE, state_after)) {","+            return case_result::fail();","+        }","+","+        // the blob is serialized in sequence cell order, so identical bytes iff the restore wrote the same KV","+        CTX_REQUIRE(blobs_equal(state_before, state_after), \"the restored KV state is not byte-identical to the saved state\");","+","+        return case_result::pass();","+    }","+","+private:","+    bool on_device;","+};","+","+//","+// sessions","+//","+","+// - save a sequence, erase it, restore it, save it again","+// - the two blobs must be identical","+// compares blobs rather than generated text: a partially restored cell still decodes to plausible tokens","+struct case_state_roundtrip : ctx_test {","+    const char * name() const override { return \"rt\"; }","+","+    const char * description() const override {","+        return \"save, erase, restore, save again - the two blobs must be identical\";","+    }","+","+    case_result run(model_run & mr) const override {","+        auto ctx = mr.ctx();","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        common_batch batch = common_batch_get_one(ctx.get(), mr.tokens);","+        if (llama_process(ctx.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get())) {","+            TLOG_ERR(\"%s: failed to decode the prompt\\n\", __func__);","+            return case_result::fail();","+        }","+","+        std::vector<uint8_t> blob_a;","+        if (!get_seq_state(ctx.get(), 0, LLAMA_STATE_SEQ_FLAGS_NONE, blob_a)) {","+            return case_result::fail();","+        }","+","+        if (!seq_rm(ctx.get(), 0)) {","+            return case_result::fail();","+        }","+","+        if (!set_seq_state(ctx.get(), 0, LLAMA_STATE_SEQ_FLAGS_NONE, blob_a)) {","+            TLOG_ERR(\"%s: failed to restore seq 0\\n\", __func__);","+            return case_result::fail();","+        }","+","+        std::vector<uint8_t> blob_b;","+        if (!get_seq_state(ctx.get(), 0, LLAMA_STATE_SEQ_FLAGS_NONE, blob_b)) {","+            return case_result::fail();","+        }","+","+        CTX_REQUIRE(blobs_equal(blob_a, blob_b), \"the state changed across a save / erase / restore cycle\");","+","+        return case_result::pass();","+    }","+};","+","+// a failed restore must leave the sequence empty and must not change the logits of other sequences","+struct case_state_restore_failure : ctx_test {","+    const char * name() const override { return \"rf\"; }","+","+    const char * description() const override {","+        return \"restoring a corrupted state fails and leaves the other sequences untouched\";","+    }","+","+    case_result run(model_run & mr) const override {","+        ctx_opts opts;","+        opts.n_ctx      = 256;","+        opts.n_seq_max  = 4;","+        opts.kv_unified = 1;","+","+        // without flash attention, corrupted data left behind by the restore shows up as NaN logits on the other sequences","+        opts.fa = LLAMA_FLASH_ATTN_TYPE_DISABLED;","+","+        auto ctx = mr.ctx(opts);","+        if (!ctx) {","+            return case_result::fail();","+        }","+","+        llama_memory_t mem = llama_get_memory(ctx.get());","+        if (mem == nullptr) {","+            TLOG_INF(\"no memory to test\\n\");","+            return case_result::pass();","+        }","+","+        const auto decode = [&](const llama_tokens & inp, llama_seq_id seq_id, std::vector<float> * logits_out) {","+            if (!decode_tokens(ctx.get(), inp, seq_id)) {","+                TLOG_ERR(\"%s: failed to decode on sequence %d\\n\", __func__, seq_id);","+                return false;","+            }","+","+            if (logits_out && !get_current_logits(ctx.get(), *logits_out)) {","+                TLOG_ERR(\"%s: failed to get logits\\n\", __func__);","+                return false;","+            }","+","+            return true;","+        };","+","+        const llama_tokens tokens_save  (mr.tokens.begin(), mr.tokens.begin() + std::min<size_t>(24, mr.tokens.size()));","+        const llama_tokens tokens_verify(mr.tokens.end() - std::min<size_t>(8, mr.tokens.size()), mr.tokens.end());","+","+        // the cases share a working directory, so the state file is named after the model","+        const std::string path = \"state-restore-failure.\" + mr.name + \".tmp.bin\";","+","+        llama_memory_clear(mem, true);","+","+        std::vector<float> baseline;","+        if (!decode(tokens_verify, 1, &baseline)) {","+            return case_result::fail();","+        }","+","+        const std::vector<std::pair<const char *, std::function<bool()>>> sub_cases = {","+            { \"buffer\", [&]() {","+                std::vector<uint8_t> state(llama_state_seq_get_size(ctx.get(), 0));","+                GGML_ASSERT(llama_state_seq_get_data(ctx.get(), state.data(), state.size(), 0) == state.size());","+                llama_memory_seq_rm(mem, 0, -1, -1);","+","+                if (!corrupt_state(state)) {","+                    return false;","+                }","+","+                return llama_state_seq_set_data(ctx.get(), state.data(), state.size(), 0) == 0;","+            }},","+            { \"file\", [&]() {","+                GGML_ASSERT(llama_state_seq_save_file(ctx.get(), path.c_str(), 0, tokens_save.data(), tokens_save.size()) > 0);","+                llama_memory_seq_rm(mem, 0, -1, -1);","+","+                std::vector<uint8_t> data;","+                {","+                    std::ifstream f(path, std::ios::binary);","+                    data.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());","+                }","+","+                if (!corrupt_state(data)) {","+                    std::remove(path.c_str());","+                    return false;","+                }","+","+                {","+                    std::ofstream f(path, std::ios::binary);","+                    f.write((const char *) data.data(), data.size());","+                }","+","+                llama_tokens tokens_out(tokens_save.size());","+                size_t n_token_count = 0;","+                const size_t nread = llama_state_seq_load_file(ctx.get(), path.c_str(), 0, tokens_out.data(), tokens_out.size(), &n_token_count);","+                std::remove(path.c_str());","+","+                return nread == 0;","+            }},","+        };","+","+        for (const auto & [name, restore_failed] : sub_cases) {","+            llama_memory_clear(mem, true);","+","+            if (!decode(tokens_save, 0, nullptr)) {","+                return case_result::fail();","+            }"],"additions":445,"deletions":0,"truncated":false}],"additions":559,"deletions":32,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-10-13T15:29:22.520457+00:00"}