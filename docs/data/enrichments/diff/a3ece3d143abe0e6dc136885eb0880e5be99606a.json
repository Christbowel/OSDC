14 @@ bool HTTPRetryQuota::TryAcquire(int64_t cost, int64_t now_ms) {"," \treturn true;"," }"," ","+int64_t HTTPRetryQuota::AcquireUpTo(int64_t cost, int64_t now_ms) {","+\tlock_guard<mutex> guard(lock);","+\tTouch(now_ms);","+\tconst auto taken = MinValue<int64_t>(cost, capacity);","+\tcapacity -= taken;","+\treturn taken;","+}","+"," void HTTPRetryQuota::Release(int64_t amount, int64_t now_ms) {"," \tlock_guard<mutex> guard(lock);"," \tTouch(now_ms);","@@ -79,11 +87,13 @@ int64_t HTTPRetryQuota::IdleMs(int64_t now_ms) const {"," "," HTTPRetryBudget::HTTPRetryBudget(const HTTPParams &params, HTTPRetryOutcomeOwner owner_p)","     : retries(params.retries), retry_wait_ms(params.retry_wait_ms), retry_backoff(params.retry_backoff),","+      retry_quota_throttled(params.retry_quota_throttled), retry_throttled_wait_ms(params.retry_throttled_wait_ms),","       owner(owner_p) {"," #ifdef DUCKDB_NO_THREADS"," \t// Without threads there is no back-off sleep, so the schedule settings go unused."," \t(void)retry_wait_ms;"," \t(void)retry_backoff;","+\t(void)retry_throttled_wait_ms;"," #endif"," }"," ","@@ -337,7 +347,12 @@ bool HTTPRetryBudget::ConsumeAndWait(const HTTPRetryDecision &decision) {"," \t}"," \tconst auto cost = decision.type == HTTPRetryDecision::Type::TRANSIENT ? HTTPRetryQuota::TRANSIENT_RETRY_COST"," \t                                                                      : HTTPRetryQuota::RETRY_COST;","-\tif (quota && !quota->TryAcquire(cost)) {","+\tauto charged = cost;","+\tif (quota && throttled && !retry_quota_throttled) {","+\t\t// The server asked to slow down, not to stop: the retry is charged what the quota has left, and a success","+\t\t// refunds only that, but an empty quota does not refuse it.","+\t\tcharged = quota->AcquireUpTo(cost);","+\t} else if (quota && !quota->TryAcquire(cost)) {"," \t\tquota_exhausted = true;"," \t\tForgetLastRetry();"," \t\treturn false;","@@ -347,7 +362,7 @@ bool HTTPRetryBudget::ConsumeAndWait(const HTTPRetryDecision &decision) {"," \t\tearlier_throttled_retries.push_back(HTTPThrottledRetryCharge {std::move(last_retry_quota), last_retry_cost});"," \t}"," \tlast_retry_quota = quota;","-\tlast_retry_cost = cost;","+\tlast_retry_cost = charged;"," \tlast_retry_throttled = throttled;"," \toutcome_settled = false;"," \tretries_used++;","@@ -359,9 +374,11 @@ bool HTTPRetryBudget::ConsumeAndWait(const HTTPRetryDecision &decision) {"," \tif (throttled && !decision.retry_after.empty()) {"," \t\tTryParseRetryAfterMs(decision.retry_after, floor_ms);"," \t}","+\t// Throttled retries back off from at least http_retry_throttled_wait_ms.","+\tconst auto wait_ms = throttled ? MaxValue<uint64_t>(retry_wait_ms, retry_throttled_wait_ms) : retry_wait_ms;"," \tRandomEngine random;"," \tconst auto sleep_ms =","-\t    BackoffMs(retry_wait_ms, retry_backoff, retries_used, floor_ms, random.NextRandomInteger64(), throttled);","+\t    BackoffMs(wait_ms, retry_backoff, retries_used, floor_ms, random.NextRandomInteger64(), throttled);"," \tif (sleep_ms > 0) {"," \t\tstd::this_thread::sleep_for(std::chrono::milliseconds(sleep_ms));"," \t}"],"additions":20,"deletions":3,"truncated":false},{"path":"src/main/http/http_util.cpp","lines":["@@ -574,12 +574,19 @@ void HTTPParams::Initialize(optional_ptr<FileOpener> opener) {"," \t\t}"," \t\thttp_proxy_username = Settings::Get<HTTPProxyUsernameSetting>(*db);"," \t\thttp_proxy_password = Settings::Get<HTTPProxyPasswordSetting>(*db);","+\t\tretry_quota_throttled = Settings::Get<HTTPRetryQuotaThrottledSetting>(*db);","+\t\tretry_throttled_wait_ms = Settings::Get<HTTPRetryThrottledWaitMsSetting>(*db);"," \t}"," "," \tauto context = FileOpener::TryGetContext(opener);"," \tif (context && context->IsClient()) {"," \t\tlogger = context->GetLoggerPtr();"," \t}","+\tif (context) {","+\t\t// A session's own value wins over the database's","+\t\tretry_quota_throttled = Settings::Get<HTTPRetryQuotaThrottledSetting>(*context);","+\t\tretry_throttled_wait_ms = Settings::Get<HTTPRetryThrottledWaitMsSetting>(*context);","+\t}"," }"," "," unique_ptr<HTTPParams> HTTPUtil::InitializeParameters(DatabaseInstance &db, const string &url) {"],"additions":7,"deletions":0,"truncated":false},{"path":"test/api/test_reset.cpp","lines":["@@ -129,6 +129,7 @@ OptionValueSet GetValueForOption(const string &name, const LogicalType &type) {"," \t    {\"http_proxy\", {\"localhost:80\"}},"," \t    {\"http_proxy_username\", {\"john\"}},"," \t    {\"http_proxy_password\", {\"doe\"}},","+\t    {\"http_retry_quota_throttled\", {false}},"," \t    {\"allocator_flush_threshold\", {\"4.0 GiB\"}},"," \t    {\"allocator_bulk_deallocation_flush_threshold\", {\"4.0 GiB\"}},"," \t    {\"arrow_output_version\", {\"1.5\"}},"],"additions":1,"deletions":0,"truncated":false},{"path":"test/common/test_http_retry_budget.cpp","lines":["@@ -4,6 +4,10 @@"," #include \"duckdb/main/http/http_util.hpp\""," #include \"duckdb/common/exception/http_exception.hpp\""," #include \"duckdb/common/string_util.hpp\"","+#include \"duckdb.hpp\"","+#include \"test_helpers.hpp\"","+","+#include <chrono>"," "," using namespace duckdb;"," ","@@ -842,3 +846,126 @@ TEST_CASE(\"HTTPUtil hands out one retry quota per host and forgets the quietest\""," \t// The budget that still held the evicted quota keeps a valid object"," \tREQUIRE(first->Available() == HTTPRetryQuota::INITIAL_CAPACITY - HTTPRetryQuota::RETRY_COST);"," }","+","+TEST_CASE(\"An empty quota does not refuse throttled retries when http_retry_quota_throttled is off\", \"[http]\") {","+\tHTTPUtil http_util;","+\tHTTPParams params(http_util);","+\tparams.retries = 3;","+\tparams.retry_wait_ms = 0;","+\tparams.retry_quota_throttled = false;","+\tauto quota = make_shared_ptr<HTTPRetryQuota>();","+\t// Leave less than one retry's tokens","+\tREQUIRE(quota->TryAcquire(HTTPRetryQuota::INITIAL_CAPACITY - 3));","+\tHTTPRetryBudget budget(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tbudget.BindQuota(quota);","+\tidx_t attempts = 0;","+\tbudget.Run([&]() {","+\t\tattempts++;","+\t\treturn attempts <= 2 ? HTTPRetryDecision::Throttled() : HTTPRetryDecision::Finish();","+\t});","+\tREQUIRE(attempts == 3);","+\tREQUIRE(budget.ThrottledRetries() == 2);","+\tREQUIRE_FALSE(budget.QuotaExhausted());","+\t// The first retry took the three tokens that were left, the second none","+\tREQUIRE(quota->Available() == 0);","+\t// A success refunds what the retries took, not what they would have cost","+\tbudget.ReportSuccess();","+\tREQUIRE(quota->Available() == 3);","+","+\t// The retries stay bounded by http_retries and the throttle extras","+\tHTTPRetryBudget storm(params);","+\tstorm.BindQuota(quota);","+\tattempts = 0;","+\tstorm.Run([&]() {","+\t\tattempts++;","+\t\treturn HTTPRetryDecision::Throttled();","+\t});","+\tREQUIRE(attempts == 1 + params.retries + HTTPRetryBudget::THROTTLE_EXTRA_RETRIES);","+\tREQUIRE_FALSE(storm.QuotaExhausted());","+\tREQUIRE(quota->Available() == 0);","+","+\t// Server errors and transport failures are still refused by the empty quota","+\tHTTPRetryBudget server_error(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tserver_error.BindQuota(quota);","+\tattempts = 0;","+\tserver_error.Run([&]() {","+\t\tattempts++;","+\t\treturn HTTPRetryDecision::Retry();","+\t});","+\tREQUIRE(attempts == 1);","+\tREQUIRE(server_error.QuotaExhausted());","+\tHTTPRetryBudget transport_error(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\ttransport_error.BindQuota(quota);","+\tattempts = 0;","+\ttransport_error.Run([&]() {","+\t\tattempts++;","+\t\treturn HTTPRetryDecision::Transient();","+\t});","+\tREQUIRE(attempts == 1);","+\tREQUIRE(transport_error.QuotaExhausted());","+","+\t// By default the empty quota refuses a throttled retry as well","+\tparams.retry_quota_throttled = true;","+\tHTTPRetryBudget fail_fast(params, HTTPRetryOutcomeOwner::COORDINATOR);","+\tfail_fast.BindQuota(quota);","+\tattempts = 0;","+\tfail_fast.Run([&]() {","+\t\tattempts++;","+\t\treturn HTTPRetryDecision::Throttled();","+\t});","+\tREQUIRE(attempts == 1);","+\tREQUIRE(fail_fast.QuotaExhausted());","+}","+","+TEST_CASE(\"Throttled HTTP retries back off from http_retry_throttled_wait_ms\", \"[http]\") {","+\tHTTPUtil http_util;","+\tHTTPParams params(http_util);","+\tparams.retries = 1;","+\tparams.retry_wait_ms = 0;","+\tparams.retry_throttled_wait_ms = 200;","+\tHTTPRetryBudget budget(params);","+\tidx_t attempts = 0;","+\tconst auto start = std::chrono::steady_clock::now();","+\tbudget.Run([&]() {","+\t\tattempts++;","+\t\treturn attempts == 1 ? HTTPRetryDecision::Throttled() : HTTPRetryDecision::Finish();","+\t});","+\tconst auto elapsed = std::chrono::steady_clock::now() - start;","+\tREQUIRE(attempts == 2);","+#ifndef DUCKDB_NO_THREADS","+\t// The first throttled retry waits in the upper half of its 200 ms base, although http_retry_wait_ms asks for none","+\tREQUIRE(elapsed >= std::chrono::milliseconds(100));","+#else","+\t(void)elapsed;","+#endif","+}","+","+TEST_CASE(\"HTTP params take the throttled retry settings of the session\", \"[http]\") {","+\tDuckDB db(nullptr);","+\tauto params = [](Connection &con) {","+\t\t// A provider that replaces the built-in one (httpfs) reads secrets while it initializes the parameters, which","+\t\t// takes a transaction","+\t\tcon.BeginTransaction();","+\t\tauto result = HTTPUtil::Get(*con.context->db).InitializeParameters(*con.context, \"http://localhost/\");","+\t\tcon.Commit();","+\t\treturn result;","+\t};","+\tConnection con(db);","+\tauto defaults = params(con);","+\tREQUIRE(defaults->retry_quota_throttled);","+\tREQUIRE(defaults->retry_throttled_wait_ms == 0);","+\tREQUIRE_NO_FAIL(con.Query(\"SET http_retry_quota_throttled = false\"));","+\tREQUIRE_NO_FAIL(con.Query(\"SET http_retry_throttled_wait_ms = 1000\"));","+\tauto session = params(con);","+\tREQUIRE_FALSE(session->retry_quota_throttled);","+\tREQUIRE(session->retry_throttled_wait_ms == 1000);","+\t// A plain SET is the session's own: another connection keeps the defaults","+\tConnection other(db);","+\tauto other_params = params(other);","+\tREQUIRE(other_params->retry_quota_throttled);","+\tREQUIRE(other_params->retry_throttled_wait_ms == 0);","+\t// A global value reaches every session that has none of its own","+\tREQUIRE_NO_FAIL(other.Query(\"SET GLOBAL http_retry_quota_throttled = false\"));","+\tConnection third(db);","+\tREQUIRE_FALSE(params(third)->retry_quota_throttled);","+}",""],"additions":127,"deletions":0,"truncated":false}],"additions":211,"deletions":3,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-09T17:52:21.831792+00:00"}