method=crossCollection zkHost=\\\"%s\\\" solrUrl=\\\"%s\\\"\"","+                              + \" fromIndex=products from=product_id_i to=product_id_i}size_s:M\",","+                          quorumHosts,","+                          getSolrUrl()),","+                      true));","+      assertTrue(","+          \"Unexpected message: \" + both.getMessage(),","+          both.getMessage().contains(\"mutually exclusive\"));","+","+      // Mutual exclusion is checked before either allow-list.","+      Exception bothUnlistedZk =","+          expectThrows(","+              Exception.class,","+              () ->","+                  testCcJoinQuery(","+                      String.format(","+                          Locale.ROOT,","+                          \"{!join method=crossCollection\"","+                              + \" zkHost=\\\"other-zk.example.com:2181/solr\\\" solrUrl=\\\"%s\\\"\"","+                              + \" fromIndex=products from=product_id_i to=product_id_i}size_s:M\",","+                          getSolrUrl()),","+                      true));","+      assertTrue(","+          \"Unexpected message: \" + bothUnlistedZk.getMessage(),","+          bothUnlistedZk.getMessage().contains(\"mutually exclusive\"));","+","+      Exception bothUnlistedUrl =","+          expectThrows(","+              Exception.class,","+              () ->","+                  testCcJoinQuery(","+                      String.format(","+                          Locale.ROOT,","+                          \"{!join method=crossCollection zkHost=\\\"%s\\\"\"","+                              + \" solrUrl=\\\"http://other-solr.example.com:18080/solr\\\"\"","+                              + \" fromIndex=products from=product_id_i to=product_id_i}size_s:M\",","+                          quorumHosts),","+                      true));","+      assertTrue(","+          \"Unexpected message: \" + bothUnlistedUrl.getMessage(),","+          bothUnlistedUrl.getMessage().contains(\"mutually exclusive\"));","+","+    } finally {","+      int j = 0;","+      for (JettySolrRunner runner : cluster.getJettySolrRunners()) {","+        j++;","+        System.getProperties().remove(\"test.ccjoin.solr.url.\" + j);","+      }","+    }","+  }","+","+  @Test","+  public void testZkHostAndSolrUrlMutualExclusionAtParser() throws SyntaxError {","+    ModifiableSolrParams localParams = new ModifiableSolrParams();","+    localParams.set(QueryParsing.V, \"*:*\");","+    localParams.set(CrossCollectionJoinQParser.ZK_HOST, \"trusted-zk:2181/chroot\");","+    localParams.set(CrossCollectionJoinQParser.SOLR_URL, \"http://trusted-solr:8983/solr\");","+    localParams.set(CrossCollectionJoinQParser.FROM_INDEX, \"products\");","+    localParams.set(CrossCollectionJoinQParser.FROM, \"product_id_s\");","+    localParams.set(CrossCollectionJoinQParser.TO, \"product_id_s\");","+    localParams.set(CrossCollectionJoinQParser.ROUTED_BY_JOIN_KEY, \"false\");","+","+    ModifiableSolrParams requestParams = new ModifiableSolrParams();","+    try (SolrQueryRequest req = new SolrQueryRequestBase(null, requestParams) {}) {","+      CrossCollectionJoinQParser parser =","+          new CrossCollectionJoinQParser(","+              null, localParams, requestParams, req, \"product_id_s\", null);","+      SyntaxError e =","+          expectThrows(","+              SyntaxError.class,","+              \"Expected SyntaxError when both zkHost and solrUrl are specified\",","+              parser::parse);","+      assertTrue(","+          \"Unexpected message: \" + e.getMessage(),","+          e.getMessage().contains(\"mutually exclusive\")","+              && e.getMessage().contains(\"zkHost\")","+              && e.getMessage().contains(\"solrUrl\"));","+    }","+  }","+","   @Test","   public void testShardsPreferenceRequestParamPropagation() throws Exception {","     // shards.preference set as a request-level param (not in localParams) should be"],"additions":144,"deletions":1,"truncated":false},{"path":"solr/server/solr/solr.xml","lines":["@@ -33,6 +33,7 @@","   <str name=\"modules\">${solr.modules:}</str>","   <str name=\"allowPaths\">${solr.security.allow.paths:}</str>","   <str name=\"allowUrls\">${solr.security.allow.urls:}</str>","+  <str name=\"allowZkHosts\">${solr.security.allow.zk.hosts:}</str>","   <str name=\"hideStackTrace\">${solr.hideStackTrace:false}</str>","   <int name=\"indexSearcherExecutorThreads\">${solr.searchThreads:0}</int>"," "],"additions":1,"deletions":0,"truncated":false},{"path":"solr/solr-ref-guide/modules/configuration-guide/pages/configuring-solr-xml.adoc","lines":["@@ -37,6 +37,7 @@ The default `solr.xml` file is found in `$SOLR_TIP/server/solr/solr.xml` and loo","   <str name=\"modules\">${solr.modules:}</str>","   <str name=\"allowPaths\">${solr.security.allow.paths:}</str>","   <str name=\"allowUrls\">${solr.security.allow.urls:}</str>","+  <str name=\"allowZkHosts\">${solr.security.allow.zk.hosts:}</str>","   <str name=\"hideStackTrace\">${solr.hideStackTrace:false}</str>"," ","   <solrcloud>","@@ -273,6 +274,24 @@ In SolrCloud mode, the allow-list is automatically configured to include all liv"," The allow-list can also be configured with the `solr.security.allow.urls` system property in `solr.in.sh` / `solr.in.cmd`."," If you need to disable this feature for backwards compatibility, you can set the system property `solr.security.allow.urls.enabled=false`."," ","+[#allow-zk-hosts]","+`allowZkHosts`::","++","+[%autowidth,frame=none]","+|===","+|Optional |Default: none","+|===","++","+Comma-separated list of ZooKeeper connection strings of other SolrCloud clusters that may be passed as a `zkHost` (or ZooKeeper-based `solrConnection`) parameter to features that fetch data from another cluster, such as cross-collection join and streaming expressions.","+The local SolrCloud ZooKeeper ensemble is always allowed and need not be listed.","+Solr in standalone (non-SolrCloud) mode does not allow any `zkHost`.","++","+Matching is character-for-character against the full connection string -- e.g. `zk1:2181,zk2:2181,zk3:2181/solr` is a different value from `zk1:2181,zk2:2181,zk3:2181` or from the same hosts in a different order.","+The local ensemble's value includes any chroot suffix configured at startup: if Solr was started with `-DzkHost=zk1:2181/solr`, then `zkHost=\"zk1:2181/solr\"` is allowed but `zkHost=\"zk1:2181\"` is not unless listed.","+A value that is not allowed is rejected with an error mentioning `allowZkHosts`.","++","+The allow-list can also be configured with the `solr.security.allow.zk.hosts` system property in `solr.in.sh` / `solr.in.cmd`.","+"," `hideStackTrace`::"," +"," [%autowidth,frame=none]"],"additions":19,"deletions":0,"truncated":false},{"path":"solr/solr-ref-guide/modules/query-guide/pages/join-query-parser.adoc","lines":["@@ -288,6 +288,13 @@ This restriction is necessary to prevent an attacker from using Solr to explore","   </queryParser>"," ----"," ","+[NOTE]","+====","+The `zkHost` parameter is governed by a node-level allow-list in `solr.xml` (`<str name=\"allowZkHosts\">`), *not* by `solrconfig.xml`.","+The local SolrCloud ZooKeeper ensemble is always trusted -- only remote ensembles need to be listed.","+See <<Cross Collection Join Query Parameters>> below and the `solr.xml` reference for details.","+====","+"," === Cross Collection Join Query Parameters"," "," `fromIndex`::","@@ -309,6 +316,9 @@ The name of the external Solr collection to be queried to retrieve the set of jo"," The connection string to be used to connect to SolrCloud cluster via ZooKeeper or HTTP(s)."," `solrConnection`, `zkHost` and `solrUrl` are optional parameters, and at most one of them should be specified."," If neither `solrConnection`, `zkHost` nor `solrUrl` are specified, the local ZooKeeper cluster will be used.","++","+A ZooKeeper connection string is validated like `zkHost` below.","+An HTTP(s) connection string must be a live node of the local cluster or be listed in the `allowUrls` entry in `solr.xml`; otherwise the request is rejected."," "," `zkHost`::"," +","@@ -318,9 +328,14 @@ If neither `solrConnection`, `zkHost` nor `solrUrl` are specified, the local Zoo"," |==="," +"," The connection string to be used to connect to ZooKeeper.","-`zkHost` and `solrUrl` are both optional parameters, and at most one of them should be specified.","+`zkHost` and `solrUrl` are both optional parameters, and at most one of them may be specified; passing both is rejected."," If neither `zkHost` nor `solrUrl` are specified, the local ZooKeeper cluster will be used."," This parameter is deprecated. Use `solrConnection` instead.","++","+An explicit `zkHost` value must either match the local SolrCloud ensemble verbatim or be listed verbatim in the node-level `<str name=\"allowZkHosts\">` entry in `solr.xml`.","+The match is a character-for-character exact comparison of the full connection string -- e.g. `zk1:2181,zk2:2181,zk3:2181/solr` is a different value from `zk1:2181,zk2:2181,zk3:2181` or from the same hosts in a different order.","+The local value includes any chroot suffix configured at startup -- so for a node started with `-DzkHost=zk1:2181/solr`, `zkHost=\"zk1:2181/solr\"` is allowed while `zkHost=\"zk1:2181\"` is not.","+If the value does not match, the request is rejected with a `SyntaxError`."," "," `solrUrl`::"," +"],"additions":16,"deletions":1,"truncated":false},{"path":"solr/solr-ref-guide/modules/upgrade-notes/pages/major-changes-in-solr-10.adoc","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":392,"deletions":2,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-09-22T12:51:22.763398+00:00"}