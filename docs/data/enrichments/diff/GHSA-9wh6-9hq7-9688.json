.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// realBLSValidator returns the production BLS12-381 G2 key validator.","+func realBLSValidator() blsPublicKeyValidator {","+\treturn signing.NewKeyGenerator(mcl.NewSuiteBLS12())","+}","+","+// validBLSPublicKey generates a well-formed BLS12-381 G2 public key.","+func validBLSPublicKey(t *testing.T) []byte {","+\tt.Helper()","+","+\tkeyGen := signing.NewKeyGenerator(mcl.NewSuiteBLS12())","+\t_, pub := keyGen.GeneratePair()","+\tpkBytes, err := pub.ToByteArray()","+\trequire.NoError(t, err)","+\trequire.NotEmpty(t, pkBytes)","+","+\treturn pkBytes","+}","+","+func setFixAuditChangesV3(v *validatorsKApp, enabled bool) {","+\tv.forkController.(*mock.ForkControllerStub).FixAuditChangesV3Value = enabled","+}","+","+func newRegisterContract(owner, blsPubKey []byte) *transaction.CreateValidatorContract {","+\treturn &transaction.CreateValidatorContract{","+\t\tOwnerAddress: owner,","+\t\tConfig: &transaction.ValidatorConfig{","+\t\t\tRewardAddress:       owner,","+\t\t\tCommission:          1000,","+\t\t\tMaxDelegationAmount: 1000000,","+\t\t\tBLSPublicKey:        blsPubKey,","+\t\t},","+\t}","+}","+","+// TestNewValidatorKApp_DefaultsBLSKeyValidator proves that production (which does","+// not inject a validator) gets the real BLS12-381 G2 validator by default, so the","+// runtime registration path is actually protected.","+func TestNewValidatorKApp_DefaultsBLSKeyValidator(t *testing.T) {","+\targs := createMockArgs()","+\targs.BLSKeyValidator = nil","+","+\tv, err := NewValidatorKApp(args)","+\trequire.NoError(t, err)","+\trequire.NotNil(t, v.blsKeyValidator)","+","+\t// the default validator must reject an arbitrary (non-G2) key","+\trequire.Error(t, v.blsKeyValidator.CheckPublicKeyValid([]byte(\"not-a-bls-key\")))","+\t// and accept a well-formed one","+\trequire.NoError(t, v.blsKeyValidator.CheckPublicKeyValid(validBLSPublicKey(t)))","+}","+","+// TestRegister_BLSKeyValidation_GHSA_9wh6_9hq7_9688 covers the consensus-liveness","+// DoS fix: runtime validator registration must reject BLS keys that are not valid","+// G2 points once the FixAuditChangesV3 fork is active.","+func TestRegister_BLSKeyValidation_GHSA_9wh6_9hq7_9688(t *testing.T) {","+\tt.Parallel()","+","+\towner := makeAddress(\"owner\")","+","+\tt.Run(\"rejects arbitrary (non-96-byte) key post-fork\", func(t *testing.T) {","+\t\tv := setupValidatorsKApp(t)","+\t\tv.blsKeyValidator = realBLSValidator()","+\t\taddFunctionalCacher(t, v)","+\t\taddStorageCacher(v)","+\t\taddContext(v)","+\t\tsetFixAuditChangesV3(v, true)","+","+\t\tresultCode, err := v.Register(newRegisterContract(owner, []byte(\"blspubkey\")))","+","+\t\tassert.Equal(t, transaction.Transaction_ParameterInvalid, resultCode)","+\t\tassert.Equal(t, common.ErrInvalidBLSPublicKey, err)","+\t})","+","+\tt.Run(\"rejects correct-length but malformed key post-fork\", func(t *testing.T) {","+\t\tv := setupValidatorsKApp(t)","+\t\tv.blsKeyValidator = realBLSValidator()","+\t\taddFunctionalCacher(t, v)","+\t\taddStorageCacher(v)","+\t\taddContext(v)","+\t\tsetFixAuditChangesV3(v, true)","+","+\t\t// same length as a real key, but not a valid curve point","+\t\tmalformed := bytes.Repeat([]byte{0xFF}, len(validBLSPublicKey(t)))","+","+\t\tresultCode, err := v.Register(newRegisterContract(owner, malformed))","+","+\t\tassert.Equal(t, transaction.Transaction_ParameterInvalid, resultCode)","+\t\tassert.Equal(t, common.ErrInvalidBLSPublicKey, err)","+\t})","+","+\tt.Run(\"accepts valid key post-fork\", func(t *testing.T) {","+\t\tv := setupValidatorsKApp(t)","+\t\tv.blsKeyValidator = realBLSValidator()","+\t\taddFunctionalCacher(t, v)","+\t\taddStorageCacher(v)","+\t\taddContext(v)","+\t\tsetFixAuditChangesV3(v, true)","+","+\t\tresultCode, err := v.Register(newRegisterContract(owner, validBLSPublicKey(t)))","+","+\t\tassert.Equal(t, transaction.Transaction_Ok, resultCode)","+\t\tassert.NoError(t, err)","+\t})","+","+\tt.Run(\"accepts arbitrary key pre-fork (reprocessing determinism)\", func(t *testing.T) {","+\t\tv := setupValidatorsKApp(t)","+\t\tv.blsKeyValidator = realBLSValidator()","+\t\taddFunctionalCacher(t, v)","+\t\taddStorageCacher(v)","+\t\taddContext(v)","+\t\tsetFixAuditChangesV3(v, false)","+","+\t\tresultCode, err := v.Register(newRegisterContract(owner, []byte(\"blspubkey\")))","+","+\t\tassert.Equal(t, transaction.Transaction_Ok, resultCode)","+\t\tassert.NoError(t, err)","+\t})","+}","+","+// TestUpdateValidator_BLSKeyValidation covers the config-update path, which also","+// writes an unchecked BLS key before the fix.","+func TestUpdateValidator_BLSKeyValidation(t *testing.T) {","+\tt.Parallel()","+","+\towner := makeAddress(\"owner\")","+","+\tt.Run(\"rejects switching to an invalid key post-fork\", func(t *testing.T) {","+\t\tv := setupValidatorsKApp(t)","+\t\tv.blsKeyValidator = realBLSValidator()","+\t\taddFunctionalCacher(t, v)","+\t\taddStorageCacher(v)","+\t\taddContext(v)","+\t\tsetFixAuditChangesV3(v, true)","+","+\t\t// register with a valid key first","+\t\tresultCode, err := v.Register(newRegisterContract(owner, validBLSPublicKey(t)))","+\t\trequire.Equal(t, transaction.Transaction_Ok, resultCode)","+\t\trequire.NoError(t, err)","+","+\t\t// try to update to an invalid key","+\t\tupdate := &transaction.ValidatorConfigContract{","+\t\t\tConfig: &transaction.ValidatorConfig{","+\t\t\t\tBLSPublicKey: []byte(\"newblspubkey\"),","+\t\t\t},","+\t\t}","+","+\t\tresultCode, err = v.UpdateValidator(owner, update)","+","+\t\tassert.Equal(t, transaction.Transaction_InvalidPeerKey, resultCode)","+\t\tassert.Equal(t, common.ErrInvalidBLSPublicKey, err)","+\t})","+","+\tt.Run(\"accepts switching to a valid key post-fork\", func(t *testing.T) {","+\t\tv := setupValidatorsKApp(t)","+\t\tv.blsKeyValidator = realBLSValidator()","+\t\taddFunctionalCacher(t, v)","+\t\taddStorageCacher(v)","+\t\taddContext(v)","+\t\tsetFixAuditChangesV3(v, true)","+","+\t\tresultCode, err := v.Register(newRegisterContract(owner, validBLSPublicKey(t)))","+\t\trequire.Equal(t, transaction.Transaction_Ok, resultCode)","+\t\trequire.NoError(t, err)","+","+\t\tupdate := &transaction.ValidatorConfigContract{","+\t\t\tConfig: &transaction.ValidatorConfig{","+\t\t\t\tBLSPublicKey: validBLSPublicKey(t),","+\t\t\t},","+\t\t}","+","+\t\tresultCode, err = v.UpdateValidator(owner, update)","+","+\t\tassert.Equal(t, transaction.Transaction_Ok, resultCode)","+\t\tassert.NoError(t, err)","+\t})","+}"],"additions":191,"deletions":0,"truncated":false},{"path":"core/kapp/validators/validators_test.go","lines":["@@ -24,12 +24,19 @@ import ("," \t\"github.com/stretchr/testify/require\""," )"," ","+// permissiveBLSKeyValidator accepts any BLS public key. Used by the shared test","+// harness so tests unrelated to key validation can keep using placeholder keys.","+type permissiveBLSKeyValidator struct{}","+","+func (permissiveBLSKeyValidator) CheckPublicKeyValid(_ []byte) error { return nil }","+"," func createMockArgs() *ArgsNewValidatorKApp {"," \treturn &ArgsNewValidatorKApp{","-\t\tMarshalizer:    &mock.MarshalizerMock{},","-\t\tPubkeyConv:     mock.NewPubkeyConverterMock(32),","-\t\tForkController: mock.NewForkControllerStub(),","-\t\tRatingsData:    &mock.RatingsInfoMock{},","+\t\tMarshalizer:     &mock.MarshalizerMock{},","+\t\tPubkeyConv:      mock.NewPubkeyConverterMock(32),","+\t\tForkController:  mock.NewForkControllerStub(),","+\t\tRatingsData:     &mock.RatingsInfoMock{},","+\t\tBLSKeyValidator: permissiveBLSKeyValidator{},"," \t}"," }"," "],"additions":11,"deletions":4,"truncated":false},{"path":"core/process/transaction/baseProcess_test.go","lines":["@@ -13,11 +13,31 @@ import ("," \t\"github.com/klever-io/klever-go/crypto\""," \t\"github.com/klever-io/klever-go/crypto/signing\""," \t\"github.com/klever-io/klever-go/crypto/signing/ed25519\"","+\t\"github.com/klever-io/klever-go/crypto/signing/mcl\""," \t\"github.com/klever-io/klever-go/data/state\""," \tdt \"github.com