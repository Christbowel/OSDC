{"id":"bee8f6a2614a2c04f88db020d923f8ac3d8e2a5c","axis":"silent","repo":"bokeh/bokeh","sha":"bee8f6a2614a2c04f88db020d923f8ac3d8e2a5c","parsed":{"files":[{"path":"MANIFEST.in","lines":["@@ -24,14 +24,15 @@ prune src/bokeh/server/static"," # include bundles"," include src/bokeh/server/static/js/bokeh*.js"," include src/bokeh/server/static/js/bokeh*.min.js","+include src/bokeh/server/static/js/bokeh*.min.js.map"," "," # don't include ESM bundles yet"," exclude src/bokeh/server/static/js/bokeh*.esm.js"," exclude src/bokeh/server/static/js/bokeh*.esm.min.js","+exclude src/bokeh/server/static/js/bokeh*.esm.min.js.map"," "," # include extensions' compiler","-include src/bokeh/server/static/js/compiler.js","+include src/bokeh/server/static/js/compiler.mjs"," ","-# include bokeh's and typescript's type declarations","+# include bokeh's type declarations"," recursive-include src/bokeh/server/static/js/lib *.d.ts","-recursive-include src/bokeh/server/static/lib *.d.ts"],"additions":4,"deletions":3,"truncated":false},{"path":"bokehjs/make/esm_to_cjs.test.ts","lines":["@@ -0,0 +1,397 @@","+import assert from \"node:assert/strict\"","+import {createRequire} from \"node:module\"","+import {test} from \"node:test\"","+","+import {to_cjs} from \"#compiler/esm_to_cjs.js\"","+","+type Exports = {[key: string]: any}","+type Modules = {[spec: string]: string}","+","+const node_require = createRequire(import.meta.url)","+","+/**","+ * Converts and evaluates `modules` with a minimal CommonJS loader, like","+ * the one in bundles. Modules ending with `.cjs` are evaluated as is.","+ */","+function run(modules: Modules, entry: string = \"./main\"): Exports {","+  const cache = new Map<string, {exports: Exports}>()","+","+  function require(spec: string): Exports {","+    if (spec == \"tslib\") {","+      return node_require(\"tslib\") as Exports","+    }","+    const cached = cache.get(spec)","+    if (cached != null) {","+      return cached.exports","+    }","+    const source = modules[spec] as string | undefined","+    if (source == null) {","+      throw new Error(`unknown module '${spec}'`)","+    }","+    const mod = {exports: {} as Exports}","+    cache.set(spec, mod)","+    if (spec.endsWith(\".cjs\")) {","+      new Function(\"require\", \"module\", \"exports\", source)(require, mod, mod.exports)","+    } else {","+      const {code} = to_cjs(`${spec}.js`, source)","+      const __esModule = () => Object.defineProperty(mod.exports, \"__esModule\", {value: true})","+      const __esExport = (name: string, value: unknown) => Object.defineProperty(mod.exports, name, {enumerable: true, get: () => value})","+      new Function(\"require\", \"module\", \"exports\", \"__esModule\", \"__esExport\", `\"use strict\";\\n${code}`)(require, mod, mod.exports, __esModule, __esExport)","+    }","+    return mod.exports","+  }","+","+  return require(entry)","+}","+","+void test(\"to_cjs() supports named, default and namespace imports of ES modules\", () => {","+  const main = run({","+    \"./main\": `","+      import def, {a, b as c} from \"./lib\"","+      import * as ns from \"./lib\"","+      export const result = [def, a, c, ns.a, ns.default]","+    `,","+    \"./lib\": `","+      export const a = 1","+      export const b = 2","+      export default 3","+    `,","+  })","+  assert.deepEqual(main.result, [3, 1, 2, 1, 3])","+  assert.equal(main.__esModule, true)","+})","+","+void test(\"to_cjs() supports default and namespace imports of CommonJS modules\", () => {","+  const main = run({","+    \"./main\": `","+      import fn from \"./fn.cjs\"","+      import * as ns from \"./obj.cjs\"","+      import obj, {x} from \"./obj.cjs\"","+      export const result = [fn(), ns.x, ns.default.x, obj.x, x]","+    `,","+    \"./fn.cjs\": \"module.exports = () => 'fn'\",","+    \"./obj.cjs\": \"module.exports = {x: 'x'}\",","+  })","+  assert.deepEqual(main.result, [\"fn\", \"x\", \"x\", \"x\", \"x\"])","+})","+","+void test(\"to_cjs() evaluates imports in order and before the module's body\", () => {","+  const main = run({","+    \"./main\": `","+      import {log} from \"./log\"","+      log.push(\"main\")","+      import \"./a\"","+      import \"./b\"","+      export {log}","+    `,","+    \"./log\": \"export const log = []\",","+    \"./a\": `import {log} from \"./log\"; log.push(\"a\")`,","+    \"./b\": `import {log} from \"./log\"; log.push(\"b\")`,","+  })","+  assert.deepEqual(main.log, [\"a\", \"b\", \"main\"])","+})","+","+void test(\"to_cjs() supports all kinds of exports\", () => {","+  const main = run({","+    \"./main\": `","+      export const a = 1, {b, c: [d]} = {b: 2, c: [3]}","+      export function f() { return \"f\" }","+      export class C {}","+      const e = 5","+      export {e as renamed, e as \"with space\"}","+    `,","+  })","+  assert.equal(main.a, 1)","+  assert.equal(main.b, 2)","+  assert.equal(main.d, 3)","+  assert.equal(main.f(), \"f\")","+  assert.equal(main.C.name, \"C\")","+  assert.equal(main.renamed, 5)","+  assert.equal(main[\"with space\"], 5)","+})","+","+void test(\"to_cjs() supports all kinds of default exports\", () => {","+  const main = run({","+    \"./main\": `","+      import f from \"./function\"","+      import C from \"./class\"","+      import A from \"./anonymous\"","+      import x from \"./expression\"","+      import p from \"./parenthesized\"","+      import s from \"./sequence\"","+      import c from \"./comment\"","+      export const result = [f(), C.name, typeof A, x, p, s, c]","+    `,","+    \"./function\": \"export default function f() { return 'f' }\",","+    \"./class\": \"export default class C {}\",","+    \"./anonymous\": \"export default class {}\",","+    \"./expression\": \"export default 1 + 2\",","+    \"./parenthesized\": \"export default (1 + 2) * 3\",","+    \"./sequence\": \"export default (1, 2)\",","+    \"./comment\": \"export /* default */ default /* (1) */ (4)\",","+  })","+  assert.deepEqual(main.result, [\"f\", \"C\", \"function\", 3, 9, 2, 4])","+})","+","+void test(\"to_cjs() supports re-exports\", () => {","+  const main = run({","+    \"./main\": `","+      export {a as b, default as def} from \"./lib\"","+      export * from \"./star\"","+      export * as ns from \"./lib\"","+      export const shadowed = \"local\"","+    `,","+    \"./lib\": \"export const a = 1; export default 2\",","+    \"./star\": \"export const s = 3; export const shadowed = 'star'; export default 4\",","+  })","+  assert.equal(main.b, 1)","+  assert.equal(main.def, 2)","+  assert.equal(main.s, 3)","+  assert.equal(main.shadowed, \"local\", \"local exports take precedence over star exports\")","+  assert.equal(main.default, undefined, \"star exports don't include default\")","+  assert.equal(main.ns.a, 1)","+})","+","+void test(\"to_cjs() preserves live bindings of reassigned exports\", () => {","+  const main = run({","+    \"./main\": `","+      import {count, increment} from \"./counter\"","+      import * as counter from \"./counter\"","+      const before = count","+      increment()","+      export const result = [before, count, counter.count]","+    `,","+    \"./counter\": \"export let count = 0; export function increment() { count++ }\",","+  })","+  assert.deepEqual(main.result, [0, 1, 1])","+})","+","+void test(\"to_cjs() preserves live bindings of re-exports\", () => {","+  const modules = {","+    \"./main\": `","+      import {count as direct, increment} from \"./reexport\"","+      import {count as indirect} from \"./import_export\"","+      const before = [direct, indirect]","+      increment()","+      export const result = [...before, direct, indirect]","+    `,","+    \"./reexport\": `export {count, increment} from \"./counter\"`,","+    \"./import_export\": `import {count} from \"./counter\"; export {count}`,","+    \"./counter\": \"export let count = 0; export function increment() { count++ }\",","+  }","+  assert.deepEqual(run(modules).result, [0, 0, 1, 1])","+})","+","+void test(\"to_cjs() renames top-level declarations colliding with parameters of module wrappers\", () => {","+  const main = run({","+    \"./main\": `","+      import {value, fn} from \"./lib\"","+      export const result = [value, fn()]","+    `,","+    \"./lib\": `","+      const exports = 1","+      let module = {exports}","+      module = {...module, more: 2}","+      function require() { return \"require\" }","+      export {exports as value}","+      export function fn() { return [module, require()] }","+      const __esModule = 3, __esExport = 4","+      export const other = [__esModule, __esExport]","+    `,","+  })","+  assert.deepEqual(main.result, [1, [{exports: 1, more: 2}, \"require\"]])","+})","+","+void test(\"to_cjs() calls imported functions with undefined `this`\", () => {","+  const main = run({","+    \"./main\": `","+      import {this_of} from \"./lib\"","+      export const result = this_of()","+      export const tagged = this_of\\`\\`","+    `,","+    \"./lib\": \"export function this_of() { return this }\",","+  })","+  assert.equal(main.result, undefined)","+  assert.equal(main.tagged, undefined)","+})","+","+void test(\"to_cjs() guards calls at the start of statements against ASI\", () => {","+  const source = `","+    import {push, log} from \"./log\"","+    push(\"a\")","+    push(\"b\")","+    if (log.length == 0) push(\"never\")","+    for (const x of [\"c\"]) push(x)","+    export {log}","+  `","+  const main = run({","+    \"./main\": source,","+    \"./log\": \"export const log = []; export function push(x) { log.push(x) }\",","+  })","+  assert.deepEqual(main.log, [\"a\", \"b\", \"c\"])","+  const {code} = to_cjs(\"main.js\", source)","+  assert.match(code, /^\\s*;\\(0, log_\\d+\\.push\\)\\(\"a\"\\)$/m, \"statements in statement lists are guarded\")","+  assert.match(code, /if \\(log_\\d+\\.log\\.length == 0\\) \\(0, /, \"braceless bodies aren't guarded\")","+})","+","+void test(\"to_cjs() rewrites shorthand properties and respects shadowing\", () => {","+  const main = run({","+    \"./main\": `","+      import {a} from \"./lib\"","+      function shadowed(a) { return a }","+      export const result = [{a}, shadowed(2), (() => { const a = 3; return a })()]","+    `,","+    \"./lib\": \"export const a = 1\",","+  })","+  assert.deepEqual(main.result, [{a: 1}, 2, 3])","+})","+","+void test(\"to_cjs() preserves names of classes and functions\", () => {","+  // like core/kinds, where nested classes shadow top-level exports","+  const main = run({","+    \"./main\": `","+      export var Kinds","+      (function (Kinds) {","+        class Any {}","+        Kinds.Any = Any","+      })(Kinds || (Kinds = {}))","+      export const Any = new Kinds.Any()","+    `,","+  })","+  assert.equal(main.Any.constructor.name, \"Any\")","+})","+","+void test(\"to_cjs() converts dynamic imports\", async () => {","+  const main = run({","+    \"./main\": `export const promise = import(\"./lib\")`,","+    \"./lib\": \"export const a = 1\",","+  })","+  const ns = await main.promise","+  assert.equal(ns.a, 1)","+})","+","+void test(\"to_cjs() reports dependencies in the order of evaluation\", () => {","+  const {deps} = to_cjs(\"main.js\", `","+    import \"./a\"","+    export * from \"./b\"","+    import def from \"./c\"","+    export const lazy = () => import(\"./d\")","+  `)","+  assert.deepEqual(deps, [\"./a\", \"./b\", \"./c\", \"./d\", \"tslib\"])","+})","+","+void test(\"to_cjs() rejects unsupported syntax\", () => {","+  assert.throws(() => to_cjs(\"main.js\", \"export const url = import.meta.url\"), /import\\.meta/)","+  assert.throws(() => to_cjs(\"main.js\", \"export const p = import(name)\"), /dynamic import/)","+})","+","+void test(\"to_cjs() assigns exports early, so that modules tolerate cycles\", () => {","+  const {code} = to_cjs(\"main.js\", `","+    import {x} from \"./x\"","+    export const a = 1","+    export class C {}","+    export function f() {}","+    export {b as renamed} from \"./y\"","+    const late = 2","+    export {late}","+  `)","+  const index = (pattern: RegExp) => code.search(pattern)","+  assert.ok(index(/exports\\.f = f;/) < index(/require\\(\"\\.\\/x\"\\)/), \"functions before requires\")","+  assert.ok(index(/const a = 1;?\\nexports\\.a = a;/) != -1, \"variables right after their declarations\")","+  assert.ok(index(/class C \\{\\}\\nexports\\.C = C;/) != -1, \"classes right after their declarations\")","+  assert.ok(index(/require\\(\"\\.\\/y\"\\);\\nObject\\.defineProperty\\(exports, \"renamed\", \\{enumerable: true, get: \\(\\) => y_\\d+\\.b\\}\\);/) != -1, \"re-exports right after requires\")","+  assert.ok(index(/const late = 2;?\\nexports\\.late = late;/) != -1, \"`export {local}` after the declaration\")","+})","+","+void test(\"to_cjs() supports cycles with eager use of hoisted functions\", () => {","+  const main = run({","+    \"./main\": `import {a} from \"./a\"; export const result = a()`,","+    \"./a\": `","+      import {b} from \"./b\"","+      export function a() { return \\`a\\${b()}\\` }","+      export function a2() { return \"a2\" }","+    `,","+    // evaluated while ./a is being evaluated","+    \"./b\": `","+      import {a2} from \"./a\"","+      const eager = a2()","+      export function b() { return \\`b\\${eager}\\` }","+    `,","+  })","+  assert.equal(main.result, \"aba2\")","+})","+","+void test(\"to_cjs() supports cycles with eager use of anonymous default-exported functions\", () => {","+  const main = run({","+    \"./main\": `import a from \"./a\"; export const result = a()`,","+    \"./a\": `","+      import {b} from \"./b\"","+      export default function () { return \\`a\\${b}\\` }","+    `,","+    // evaluated while ./a is being evaluated","+    \"./b\": `","+      import a from \"./a\"","+      export const b = typeof a","+    `,","+  })","+  assert.equal(main.result, \"afunction\")","+})","+","+void test(\"to_cjs() hoists all kinds of anonymous default-exported functions\", () => {","+  for (const fn of [\"function () {}\", \"function() {}\", \"function*() {}\", \"async function () {}\", \"async /* c */ function /* c */ * /* c */ () {}\"]) {","+    const main = run({","+      \"./main\": \"import \\\"./f\\\"; import {seen} from \\\"./g\\\"; export const result = seen\",","+      \"./f\": `import \"./g\"; export default ${fn}`,","+      // evaluated while ./f is being evaluated","+      \"./g\": \"import f from \\\"./f\\\"; export const seen = typeof f\",","+    })","+    assert.equal(main.result, \"function\", fn)","+  }","+})","+","+void test(\"to_cjs() supports cycles with lazy use of variables and classes\", () => {","+  const main = run({","+    \"./main\": `import {make} from \"./a\"; export const result = make()`,","+    \"./a\": `","+      import {B} from \"./b\"","+      export const A_NAME = \"A\"","+      export function make() { return new B().name() }","+    `,","+    \"./b\": `","+      import {A_NAME} from \"./a\"","+      export class B { name() { return \\`B of \\${A_NAME}\\` } }","+    `,","+  })","+  assert.equal(main.result, \"B of A\")","+})","+","+void test(\"to_cjs() supports cycles through barrel modules\", () => {","+  const main = run({","+    \"./main\": `import {A} from \"./index\"; export const result = new A().b() instanceof Object`,","+    \"./index\": `","+      export {A} from \"./a\"","+      export {B} from \"./b\"","+    `,","+    \"./a\": `","+      import {B} from \"./index\"","+      export class A { b() { return new B() } }","+    `,","+    \"./b\": \"export class B {}\",","+  })","+  assert.equal(main.result, true)","+})","+","+void test(\"to_cjs() doesn't make uninitialized exports available in cycles\", () => {","+  // like in ESM, where this would be a ReferenceError (TDZ)","+  assert.throws(() => run({","+    \"./main\": `import \"./a\"`,","+    \"./a\": `","+      import \"./b\"","+      export class A {}","+    `,","+    \"./b\": `","+      import {A} from \"./a\"","+      export const a = new A()","+    `,","+  }), TypeError)","+})"],"additions":397,"deletions":0,"truncated":false},{"path":"bokehjs/make/graph.test.ts","lines":["@@ -0,0 +1,45 @@","+import assert from \"node:assert/strict\"","+import {test} from \"node:test\"","+","+import type {Graph} from \"#compiler/graph.js\"","+import {detect_cycles, strongly_connected_components} from \"#compiler/graph.js\"","+","+function graph(edges: {[node: string]: string[]}): Graph<string> {","+  return new Map(Object.entries(edges))","+}","+","+void test(\"strongly_connected_components() groups mutually reachable nodes\", () => {","+  const g = graph({a: [\"b\"], b: [\"c\", \"d\"], c: [\"a\"], d: [\"e\"], e: [\"d\"], f: []})","+  assert.deepEqual(strongly_connected_components(g), [[\"a\", \"b\", \"c\"], [\"d\", \"e\"], [\"f\"]])","+})","+","+void test(\"detect_cycles() returns nothing for acyclic graphs\", () => {","+  assert.deepEqual(detect_cycles(graph({a: [\"b\", \"c\"], b: [\"c\"], c: []})), [])","+})","+","+void test(\"detect_cycles() returns one shortest cycle per group of mutually dependent nodes\", () => {","+  // a -> b -> c -> a is a cycle, as is the shorter a -> c -> a","+  const g = graph({a: [\"b\", \"c\"], b: [\"c\"], c: [\"a\"], d: [\"e\"], e: [\"d\"], f: [\"a\"]})","+  assert.deepEqual(detect_cycles(g), [[\"a\", \"c\"], [\"d\", \"e\"]])","+})","+","+void test(\"detect_cycles() detects self-dependencies\", () => {","+  assert.deepEqual(detect_cycles(graph({a: [\"a\"], b: []})), [[\"a\"]])","+})","+","+void test(\"detect_cycles() returns cycles through nodes that match a filter\", () => {","+  // the shortest cycle through `a` (a -> b -> a) avoids `X`, but b -> X -> b doesn't","+  const g = graph({a: [\"b\"], b: [\"a\", \"X\"], X: [\"b\"], c: [\"d\"], d: [\"c\"], Y: [\"Y\"], Z: []})","+  assert.deepEqual(detect_cycles(g, (node) => node == node.toUpperCase()), [[\"X\", \"b\"], [\"Y\"]])","+})","+","+void test(\"detect_cycles() handles deep graphs\", () => {","+  const n = 100_000","+  const g: Graph<number> = new Map()","+  for (let i = 0; i < n; i++) {","+    g.set(i, [i + 1 == n ? 0 : i + 1])","+  }","+  const cycles = detect_cycles(g)","+  assert.equal(cycles.length, 1)","+  assert.equal(cycles[0].length, n)","+})"],"additions":45,"deletions":0,"truncated":false},{"path":"bokehjs/make/index.js","lines":["@@ -112,7 +112,7 @@ function compile() {","     return","   }"," ","-  const tsc = fileURLToPath(new URL(\"./bin/tsc\", import.meta.resolve(\"typescript7/package.json\")))","+  const tsc = fileURLToPath(new URL(\"./bin/tsc\", import.meta.resolve(\"typescript/package.json\")))","   const [resolved_executable, resolved_args] = [process.execPath, [tsc, \"--project\", \"./make/tsconfig.json\"]]","   const {status, error} = cp.spawnSync(resolved_executable, resolved_args, {stdio: \"inherit\"})","   if (error != null) {"],"additions":1,"deletions":1,"truncated":false},{"path":"bokehjs/make/linker.test.ts","lines":["@@ -0,0 +1,279 @@","+import assert from \"node:assert/strict\"","+import fs from \"node:fs\"","+import os from \"node:os\"","+import vm from \"node:vm\"","+import {join, dirname} from \"node:path\"","+import type {TestContext} from \"node:test\"","+import {test} from \"node:test\"","+","+import MagicString from \"magic-string\"","+import {TraceMap, originalPositionFor} from \"@jridgewell/trace-mapping\"","+","+import type {CycleDetection} from \"#compiler/linker.js\"","+import {Linker} from \"#compiler/linker.js\"","+import * as preludes from \"#compiler/prelude.js\"","+","+type Files = {[file: string]: string}","+","+type LinkOptions = {detect_cycles?: CycleDetection}","+","+/** Creates a temporary source tree with `lib/` and `node_modules/` and returns its directory. */","+function fixture(t: TestContext, files: Files): string {","+  const dir = fs.mkdtempSync(join(os.tmpdir(), \"bokehjs-test-linker-\"))","+  t.after(() => fs.rmSync(dir, {recursive: true, force: true}))","+  const all: Files = {","+    \"node_modules/tslib/package.json\": JSON.stringify({name: \"tslib\", type: \"module\", main: \"tslib.js\"}),","+    \"node_modules/tslib/tslib.js\": \"export function __importStar(mod) { return mod }\",","+    ...files,","+  }","+  for (const [file, source] of Object.entries(all)) {","+    const path = join(dir, file)","+    fs.mkdirSync(dirname(path), {recursive: true})","+    fs.writeFileSync(path, source, {encoding: \"utf-8\"})","+  }","+  return dir","+}","+","+/** Links `lib/index.js` and returns the reported status and cycles. */","+async function link(t: TestContext, files: Files, options: LinkOptions = {}): Promise<{status: boolean, output: string, linker: Linker}> {","+  const dir = fixture(t, files)","+  const linker = new Linker({","+    entries: [join(dir, \"lib\", \"index.js\")],","+    bases: [join(dir, \"lib\"), join(dir, \"node_modules\")],","+    ...options,","+  })","+  const log = t.mock.method(console, \"log\", () => {})","+  const {status} = await linker.link()","+  const output = log.mock.calls.map((call) => call.arguments.join(\" \")).join(\"\\n\")","+  log.mock.restore()","+  return {status, output, linker}","+}","+","+const esm_package = (name: string, source: string) => ({","+  [`node_modules/${name}/package.json`]: JSON.stringify({name, type: \"module\", main: \"index.js\"}),","+  [`node_modules/${name}/index.js`]: source,","+})","+","+const cjs_package = (name: string, files: Files) => ({","+  [`node_modules/${name}/package.json`]: JSON.stringify({name, main: \"index.js\"}),","+  ...Object.fromEntries(Object.entries(files).map(([file, source]) => [`node_modules/${name}/${file}`, source])),","+})","+","+void test(\"Linker succeeds without cycles\", async (t) => {","+  const {status, output} = await link(t, {","+    \"lib/index.js\": `import {a} from \"./a.js\"; export {a}`,","+    \"lib/a.js\": \"export const a = 1\",","+  })","+  assert.equal(status, true)","+  assert.equal(output, \"\")","+})","+","+void test(\"Linker reports cycles of internal modules\", async (t) => {","+  const {status, output} = await link(t, {","+    \"lib/index.js\": `import \"./a.js\"`,","+    \"lib/a.js\": `import {b} from \"./b.js\"; export const a = () => b`,","+    \"lib/b.js\": `import {a} from \"./a.js\"; export const b = () => a`,","+  })","+  assert.equal(status, false)","+  assert.match(output, /cycle detected:\\n├─ a\\n├─ b\\n└─ a/)","+})","+","+void test(\"Linker reports cycles of third-party ES modules\", async (t) => {","+  const {status, output} = await link(t, {","+    \"lib/index.js\": `import \"esm_a\"`,","+    ...esm_package(\"esm_a\", `import \"esm_b\"; export const a = 1`),","+    ...esm_package(\"esm_b\", `import \"esm_a\"; export const b = 1`),","+  })","+  assert.equal(status, false)","+  assert.match(output, /cycle detected:/)","+})","+","+void test(\"Linker reports cycles of mixed ES and CommonJS modules\", async (t) => {","+  const {status} = await link(t, {","+    \"lib/index.js\": `import \"esm_a\"`,","+    ...esm_package(\"esm_a\", `import \"cjs_b\"; export const a = 1`),","+    ...cjs_package(\"cjs_b\", {\"index.js\": `require(\"esm_a\"); exports.b = 1`}),","+  })","+  assert.equal(status, false)","+})","+","+void test(\"Linker reports cycles of ES modules within cycles of CommonJS modules\", async (t) => {","+  const {status, output} = await link(t, {","+    \"lib/index.js\": `import \"cjs_a\"`,","+    // the shortest cycle through `cjs_a` (`cjs_a -> cjs_a/b -> cjs_a`) has no ES modules","+    ...cjs_package(\"cjs_a\", {\"index.js\": `require(\"./b.js\"); exports.a = 1`, \"b.js\": `require(\"./index.js\"); require(\"esm_c\"); exports.b = 1`}),","+    ...esm_package(\"esm_c\", `import \"cjs_a/b.js\"; export const c = 1`),","+  })","+  assert.equal(status, false)","+  assert.match(output, /cycle detected:\\n├─ esm_c\\/index\\.js\\n├─ cjs_a\\/b\\.js\\n└─ esm_c\\/index\\.js/)","+})","+","+void test(\"Linker allows cycles of CommonJS modules\", async (t) => {","+  const {status, output} = await link(t, {","+    \"lib/index.js\": `import \"cjs_a\"`,","+    ...cjs_package(\"cjs_a\", {\"index.js\": `require(\"./b.js\"); exports.a = 1`, \"b.js\": `require(\"./index.js\"); exports.b = 1`}),","+  })","+  assert.equal(status, true)","+  assert.equal(output, \"\")","+})","+","+void test(\"Linker reports only cycles of internal modules when requested\", async (t) => {","+  const third_party = await link(t, {","+    \"lib/index.js\": `import \"esm_a\"`,","+    ...esm_package(\"esm_a\", `import \"esm_b\"; export const a = 1`),","+    ...esm_package(\"esm_b\", `import \"esm_a\"; export const b = 1`),","+  }, {detect_cycles: \"internal\"})","+  assert.equal(third_party.status, true)","+  assert.equal(third_party.output, \"\")","+","+  const internal = await link(t, {","+    \"lib/index.js\": `import \"./a.js\"`,","+    \"lib/a.js\": `import {b} from \"./b.js\"; export const a = () => b`,","+    \"lib/b.js\": `import {a} from \"./a.js\"; export const b = () => a`,","+  }, {detect_cycles: \"internal\"})","+  assert.equal(internal.status, false)","+  assert.match(internal.output, /cycle detected:\\n├─ a\\n├─ b\\n└─ a/)","+","+  // e.g. through a package that imports the extension's modules","+  const mixed = await link(t, {","+    \"lib/index.js\": `import \"./a.js\"`,","+    \"lib/a.js\": `import \"esm_b\"; export const a = 1`,","+    ...esm_package(\"esm_b\", `import \"esm_c\"; export const b = 1`),","+    ...esm_package(\"esm_c\", `import \"esm_b\"; import \"../../lib/a.js\"; export const c = 1`),","+  }, {detect_cycles: \"internal\"})","+  assert.equal(mixed.status, false)","+  assert.match(mixed.output, /cycle detected:\\n├─ a\\n├─ esm_b\\/index\\.js\\n├─ esm_c\\/index\\.js\\n└─ a/)","+})","+","+void test(\"Linker doesn't detect cycles when disabled\", async (t) => {","+  const {status} = await link(t, {","+    \"lib/index.js\": `import \"./a.js\"`,","+    \"lib/a.js\": `import \"./index.js\"`,","+  }, {detect_cycles: \"none\"})","+  assert.equal(status, true)","+})","+","+/** Links `lib/index.js`, evaluates the bundle and returns exports of the entry module. */","+async function evaluate(t: TestContext, files: Files): Promise<{[key: string]: unknown}> {","+  const {linker} = await link(t, {","+    \"node_modules/tslib/tslib.js\": \"export function __importDefault(mod) { return mod && mod.__esModule ? mod : {default: mod} }\",","+    ...files,","+  })","+  const {bundles: [bundle]} = await linker.link()","+  const prelude = {main: preludes.prelude(), plugin: preludes.plugin_prelude()}","+  const postlude = {main: preludes.postlude(), plugin: preludes.plugin_postlude()}","+  const {source} = bundle.assemble({prelude, postlude, minified: false})","+  const context: {Bokeh?: {[key: string]: unknown}} = {}","+  vm.runInNewContext(source, context)","+  return context.Bokeh!","+}","+","+void test(\"Linker doesn't convert CommonJS modules of packages with ES modules\", async (t) => {","+  const exports = await evaluate(t, {","+    \"lib/index.js\": `import {cjs} from \"esm\"; import {helper} from \"dual\"; export const result = [cjs, helper]`,","+    \"node_modules/esm/package.json\": JSON.stringify({name: \"esm\", type: \"module\", main: \"index.js\"}),","+    \"node_modules/esm/index.js\": `import cjs from \"./cjs.cjs\"; export {cjs}`,","+    \"node_modules/esm/cjs.cjs\": \"exports.a = 1\",","+    \"node_modules/dual/package.json\": JSON.stringify({name: \"dual\", main: \"cjs/index.js\", module: \"esm/index.js\"}),","+    \"node_modules/dual/esm/index.js\": `import helper from \"../helper.js\"; export {helper}`,","+    \"node_modules/dual/helper.js\": \"exports.b = 2\",","+  })","+  // CommonJS modules don't set `__esModule`, so their default import is `module.exports`","+  assert.equal(JSON.stringify(exports.result), JSON.stringify([{a: 1}, {b: 2}]))","+})","+","+void test(\"Linker preserves live bindings of re-exports in CommonJS modules\", async (t) => {","+  const exports = await evaluate(t, {","+    \"lib/index.js\": `import {count, increment} from \"counter\"; const before = count; increment(); export const result = [before, count]`,","+    // tsc's output","+    ...cjs_package(\"counter\", {","+      \"index.js\": `","+        \"use strict\";","+        Object.defineProperty(exports, \"__esModule\", { value: true });","+        exports.increment = exports.count = void 0;","+        var counter_1 = require(\"./counter\");","+        Object.defineProperty(exports, \"count\", { enumerable: true, get: function () { return counter_1.count; } });","+        Object.defineProperty(exports, \"increment\", { enumerable: true, get: function () { return counter_1.increment; } });","+      `,","+      \"counter.js\": \"exports.count = 0; exports.increment = function () { exports.count++ }\",","+    }),","+  })","+  assert.equal(JSON.stringify(exports.result), JSON.stringify([0, 1]))","+})","+","+void test(\"Linker maps bundles to original sources\", async (t) => {","+  // like tsc's output, i.e. `lib/index.js` with a map pointing to `src/index.ts`","+  const ts = \"// greeting\\nexport function greet(name: string): string {\\n  return 'hello ' + name\\n}\\n\"","+  const str = new MagicString(ts)","+  for (const match of ts.matchAll(/: string/g)) {","+    str.remove(match.index, match.index + match[0].length)","+  }","+  const map = str.generateMap({hires: true, source: \"../src/index.ts\", file: \"index.js\", includeContent: true})","+  const {linker} = await link(t, {","+    \"src/index.ts\": ts,","+    \"lib/index.js\": `${str.toString()}//# sourceMappingURL=index.js.map\\n`,","+    \"lib/index.js.map\": map.toString(),","+  })","+  const {bundles: [bundle]} = await linker.link()","+","+  // bundles share maps of modules between preludes, so assemble each kind twice","+  const kinds = {","+    plain: {","+      prelude: {main: preludes.prelude(), plugin: preludes.plugin_prelude()},","+      postlude: {main: preludes.postlude(), plugin: preludes.plugin_postlude()},","+    },","+    esm: {","+      prelude: {main: preludes.prelude_esm(false), plugin: preludes.plugin_prelude_esm(false)},","+      postlude: {main: preludes.postlude_esm(), plugin: preludes.plugin_postlude_esm()},","+    },","+  }","+  for (const kind of [\"plain\", \"esm\", \"plain\", \"esm\"] as const) {","+    for (const minified of [false, true]) {","+      const {source, sourcemap} = bundle.assemble({...kinds[kind], minified})","+      assert.ok(sourcemap != null)","+      const index = source.search(/[\"'`]hello /) // the minifier may use a template literal","+      const lines = source.slice(0, index).split(\"\\n\")","+      const position = originalPositionFor(new TraceMap(sourcemap), {line: lines.length, column: lines[lines.length - 1].length})","+      const message = `${minified ? \"minified\" : \"unminified\"} ${kind} bundle`","+      assert.match(position.source ?? \"\", /src\\/index\\.ts$/, message)","+      assert.deepEqual([position.line, position.column], [3, 9], message)","+    }","+  }","+})","+","+void test(\"Linker stores its cache only when it changed\", async (t) => {","+  const dir = fixture(t, {","+    \"lib/index.js\": `import {a} from \"./a.js\"; export {a}`,","+    \"lib/a.js\": \"export const a = 1\",","+  })","+  const cache = join(dir, \"cache.json\")","+  const build = async () => {","+    const linker = new Linker({entries: [join(dir, \"lib\", \"index.js\")], bases: [join(dir, \"lib\"), join(dir, \"node_modules\")], cache})","+    linker.load_cache()","+    await linker.link()","+    linker.store_cache()","+  }","+  const stored = () => fs.readFileSync(cache, \"utf-8\")","+","+  await build()","+  const initial = stored()","+  assert.match(initial, /export const a = 1/)","+","+  const marked = JSON.stringify({...JSON.parse(initial), marked: true})","+  fs.writeFileSync(cache, marked)","+  await build()","+  assert.equal(stored(), marked, \"nothing changed, so not stored\")","+","+  fs.writeFileSync(cache, JSON.stringify({version: 0}))","+  t.mock.method(console, \"warn\", () => {})","+  await build()","+  assert.equal(stored(), initial, \"incompatible cache, so stored\")","+","+  fs.writeFileSync(join(dir, \"lib\", \"a.js\"), \"export const a = 2\")","+  await build()","+  assert.match(stored(), /export const a = 2/, \"a module changed, so stored\")","+","+  fs.writeFileSync(join(dir, \"lib\", \"index.js\"), \"export const a = 3\")","+  await build()","+  assert.doesNotMatch(stored(), /a\\.js/, \"a module was removed, so stored\")","+})"],"additions":279,"deletions":0,"truncated":false},{"path":"bokehjs/make/package.json","lines":["@@ -16,6 +16,8 @@","     \"./src/compiler\"","   ],","   \"devDependencies\": {","+    \"@jridgewell/remapping\": \"^2.3.5\",","+    \"@jridgewell/trace-mapping\": \"^0.3.31\",","     \"@stylistic/eslint-plugin\": \"^5.8.0\",","     \"@types/node\": \"^22.7.4\",","     \"@types/yargs\": \"^17.0.32\",","@@ -25,20 +27,18 @@","     \"esbuild\": \"^0.27.2\",","     \"glob\": \"^13.0.6\",","     \"magic-string\": \"^0.30.21\","],"additions":2,"deletions":0,"truncated":false}],"additions":728,"deletions":4,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-11-20T17:58:47.363229+00:00"}