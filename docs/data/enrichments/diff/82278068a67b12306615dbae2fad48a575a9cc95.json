","+    fn algorithms() -> Vec<CompressionAlgo> {","+        vec![","+            #[cfg(feature = \"brotli\")]","+            CompressionAlgo::Brotli,","+            #[cfg(feature = \"gzip\")]","+            CompressionAlgo::Gzip,","+            #[cfg(feature = \"deflate\")]","+            CompressionAlgo::Deflate,","+            #[cfg(feature = \"zstd\")]","+            CompressionAlgo::Zstd,","+        ]","+    }","+","+    fn decode(algo: CompressionAlgo, compressed: &[u8]) -> Vec<u8> {","+        let mut decoded = Vec::new();","+        match algo {","+            #[cfg(feature = \"brotli\")]","+            CompressionAlgo::Brotli => {","+                brotli::Decompressor::new(compressed, 4096)","+                    .read_to_end(&mut decoded)","+                    .unwrap();","+            }","+            #[cfg(feature = \"gzip\")]","+            CompressionAlgo::Gzip => {","+                GzDecoder::new(compressed)","+                    .read_to_end(&mut decoded)","+                    .unwrap();","+            }","+            #[cfg(feature = \"deflate\")]","+            CompressionAlgo::Deflate => {","+                flate2::read::ZlibDecoder::new(compressed)","+                    .read_to_end(&mut decoded)","+                    .unwrap();","+            }","+            #[cfg(feature = \"zstd\")]","+            CompressionAlgo::Zstd => {","+                decoded = zstd::stream::decode_all(compressed).unwrap();","+            }","+        }","+        decoded","+    }","+","+    #[tokio::test]","+    async fn trailers_follow_a_complete_compressed_body() {","+        use salvo_core::http::HeaderMap;","+        use salvo_core::http::body::Frame;","+","+        for algo in algorithms() {","+            // Cover inline encoding, blocking encoding/finalization, and no data.","+            for length in [0, 5, 32 * 1024] {","+                let input = Bytes::from(vec![b'a'; length]);","+                let mut trailers = HeaderMap::new();","+                trailers.insert(\"x-checksum\", \"complete\".parse().unwrap());","+                let mut frames = Vec::new();","+                if length > 0 {","+                    frames.push(Ok(BytesFrame::data(input.clone())));","+                }","+                frames.push(Ok(BytesFrame(Frame::trailers(trailers.clone()))));","+                let body: BoxStream<'static, Result<BytesFrame, BoxedError>> =","+                    futures_util::stream::iter(frames).boxed();","+                let mut stream = EncodeStream::new(algo, CompressionLevel::Default, body);","+                let mut compressed = Vec::new();","+                let mut received_trailers = None;","+                while let Some(frame) = stream.next().await {","+                    match frame.unwrap().into_data() {","+                        Ok(chunk) => {","+                            assert!(received_trailers.is_none(), \"data followed trailers\");","+                            compressed.extend_from_slice(&chunk);","+                        }","+                        Err(frame) => {","+                            assert!(received_trailers.is_none(), \"duplicate trailers\");","+                            received_trailers = Some(frame.into_trailers().unwrap());","+                        }","+                    }","+                }","+                assert_eq!(decode(algo, &compressed), input);","+                assert_eq!(received_trailers, Some(trailers));","+                assert!(stream.next().await.is_none());","+            }","+        }","+    }","+","+    #[tokio::test]","+    async fn blocking_jobs_include_flush_and_finalization() {","+        for algo in algorithms() {","+            for (level, length) in [","+                (CompressionLevel::Default, 32 * 1024),","+                (CompressionLevel::Minsize, 8 * 1024),","+                (CompressionLevel::Precise(1), 8 * 1024),","+            ] {","+                let input = Bytes::from(vec![b'a'; length]);"