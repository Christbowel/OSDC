);","+            }","+        }","+","+        // Exercise both request orders: a range must neither poison the full entry","+        // nor receive an already cached full representation.","+        for range_first in [false, true] {","+            let cache = Cache::new(MokaStore::new(100), RequestIssuer::default());","+            let service = Service::new(Router::new().hoop(cache).get(range_page));","+            for range in [range_first, !range_first, range_first] {","+                let request = TestClient::get(\"http://example.test/\");","+                let request = if range {","+                    request.add_header(\"range\", \"bytes=0-1\", true)","+                } else {","+                    request","+                };","+                let mut res = request.send(&service).await;","+                assert_eq!(","+                    res.status_code,","+                    Some(if range {","+                        StatusCode::PARTIAL_CONTENT","+                    } else {","+                        StatusCode::OK","+                    })","+                );","+                assert_eq!(","+                    res.take_string().await.unwrap(),","+                    if range { \"ab\" } else { \"abcd\" }","+                );","+            }","+        }","+    }","+","+    #[test]","+    fn cached_response_rejects_partial_representations() {","+        for cache_private in [false, true] {","+            let mut res = Response::new();","+            res.render(\"ab\");","+            res.status_code(StatusCode::PARTIAL_CONTENT);","+            assert!(cached_response(&res, &HeaderMap::new(), cache_private).is_none());","+","+            // Also reject an incomplete representation with an incorrect 200 status.","+            res.status_code(StatusCode::OK);","+            res.add_header(\"content-range\", \"bytes 0-1/4\", true)","+                .unwrap();","+            assert!(cached_response(&res, &HeaderMap::new(), cache_private).is_none());","+        }","+    }","+","     #[test]","     fn cached_response_never_stores_vary() {","         // The store never folds the varied request headers into the key, so a"],"additions":126,"deletions":7,"truncated":false},{"path":"crates/compression/src/lib.rs","lines":["@@ -570,6 +570,57 @@ mod tests {"," ","     use super::*;"," ","+    #[cfg(feature = \"gzip\")]","+    #[tokio::test]","+    async fn compression_preserves_trailers_after_final_data() {","+        use std::io::Read;","+        use std::pin::Pin;","+","+        use salvo_core::http::HeaderMap;","+        use salvo_core::http::body::{Body, BytesFrame, Frame};","+","+        #[handler]","+        async fn with_trailers(res: &mut Response) {","+            res.add_header(\"content-type\", \"text/plain\", true).unwrap();","+            res.add_header(\"trailer\", \"x-checksum\", true).unwrap();","+            let mut trailers = HeaderMap::new();","+            trailers.insert(\"x-checksum\", \"complete\".parse().unwrap());","+            let frames = vec![","+                Ok::<_, std::io::Error>(BytesFrame::data(vec![b'a'; 32 * 1024])),","+                Ok(BytesFrame(Frame::trailers(trailers))),","+            ];","+            res.stream(futures_util::stream::iter(frames));","+        }","+","+        let router = Router::with_hoop(super::Compression::new().min_length(1)).get(with_trailers);","+        let mut response = TestClient::get(\"http://localhost/\")","+            .add_header(\"accept-encoding\", \"gzip\", true)","+            .send(router)","+            .await;","+        assert_eq!(response.headers()[\"content-encoding\"], \"gzip\");","+        assert_eq!(response.headers()[\"trailer\"], \"x-checksum\");","+        let mut body = response.take_body();","+        let mut compressed = Vec::new();","+        let mut trailers = None;","+        while let Some(frame) =","+            futures_util::future::poll_fn(|cx| Pin::new(&mut body).poll_frame(cx)).await","+        {","+      