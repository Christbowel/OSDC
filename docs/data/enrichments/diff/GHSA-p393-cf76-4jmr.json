s":2,"truncated":false},{"path":"internal/backup/extract.go","lines":["@@ -0,0 +1,382 @@","+package backup","+","+import (","+\t\"archive/zip\"","+\t\"fmt\"","+\t\"io\"","+\t\"os\"","+\t\"path\"","+\t\"path/filepath\"","+\t\"sort\"","+\t\"strings\"","+)","+","+const maxArchiveSymlinkTargetSize = 16 * 1024","+","+type zipEntryKind uint8","+","+const (","+\tzipEntryDirectory zipEntryKind = iota","+\tzipEntryRegular","+\tzipEntrySymlink","+)","+","+type zipExtractionPolicy struct {","+\tabsoluteSymlinkRewriteRoot string","+\tallowedAbsoluteLinkRoots   []string","+}","+","+type preparedZipEntry struct {","+\tfile       *zip.File","+\tname       string","+\tkind       zipEntryKind","+\tlinkTarget string","+}","+","+func extractZipArchive(zipPath, destDir string) error {","+\treturn extractZipArchiveWithPolicy(zipPath, destDir, zipExtractionPolicy{})","+}","+","+func extractNginxZipArchive(zipPath, destDir, configRoot, modulesRoot string) error {","+\tpolicy := zipExtractionPolicy{","+\t\tabsoluteSymlinkRewriteRoot: configRoot,","+\t}","+\tif strings.TrimSpace(modulesRoot) != \"\" {","+\t\tpolicy.allowedAbsoluteLinkRoots = []string{modulesRoot}","+\t}","+\treturn extractZipArchiveWithPolicy(zipPath, destDir, policy)","+}","+","+func extractZipArchiveWithPolicy(zipPath, destDir string, policy zipExtractionPolicy) error {","+\treader, err := zip.OpenReader(zipPath)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"open zip %q: %w\", zipPath, err)","+\t}","+\tdefer reader.Close()","+","+\tentries, err := prepareZipEntries(reader.File, policy)","+\tif err != nil {","+\t\treturn err","+\t}","+","+\tif err := ensureEmptyDirectory(destDir); err != nil {","+\t\treturn err","+\t}","+","+\troot, err := os.OpenRoot(destDir)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"open extraction root %q: %w\", destDir, err)","+\t}","+\tdefer root.Close()","+","+\tfor _, entry := range entries {","+\t\tif entry.kind != zipEntryDirectory {","+\t\t\tcontinue","+\t\t}","+\t\tif err := root.MkdirAll(filepath.FromSlash(entry.name), directoryMode(entry.file.Mode())); err != nil {","+\t\t\treturn fmt.Errorf(\"create archive directory %q: %w\", entry.name, err)","+\t\t}","+\t}","+","+\tfor _, entry := range entries {","+\t\tif entry.kind != zipEntryRegular {","+\t\t\tcontinue","+\t\t}","+\t\tif err := extractRegularZipEntry(root, entry); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\t// Symlinks are deliberately created last. No subsequent archive entry can","+\t// therefore redirect a file or directory write through a link.","+\tfor _, entry := range entries {","+\t\tif entry.kind != zipEntrySymlink {","+\t\t\tcontinue","+\t\t}","+\t\tname := filepath.FromSlash(entry.name)","+\t\tif parent := filepath.Dir(name); parent != \".\" {","+\t\t\tif err := root.MkdirAll(parent, 0o755); err != nil {","+\t\t\t\treturn fmt.Errorf(\"create parent for archive symlink %q: %w\", entry.name, err)","+\t\t\t}","+\t\t}","+\t\tif err := root.Symlink(entry.linkTarget, name); err != nil {","+\t\t\treturn fmt.Errorf(\"create archive symlink %q: %w\", entry.name, err)","+\t\t}","+\t}","+","+\treturn validateExtractedEntries(root, entries)","+}","+","+func prepareZipEntries(files []*zip.File, policy zipExtractionPolicy) ([]preparedZipEntry, error) {","+\tentries := make([]preparedZipEntry, 0, len(files))","+\tbyName := make(map[string]zipEntryKind, len(files))","+","+\tfor _, file := range files {","+\t\tname, err := normalizeArchiveEntryName(file.Name)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+","+\t\tkind, err := classifyZipEntry(file)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"archive entry %q: %w\", file.Name, err)","+\t\t}","+\t\tif _, exists := byName[name]; exists {","+\t\t\treturn nil, fmt.Errorf(\"duplicate archive entry %q\", name)","+\t\t}","+\t\tbyName[name] = kind","+","+\t\tentry := preparedZipEntry{file: file, name: name, kind: kind}","+\t\tif kind == zipEntrySymlink {","+\t\t\ttarget, err := readZipSymlinkTarget(file)","+\t\t\tif err != nil {","+\t\t\t\treturn nil, err","+\t\t\t}","+\t\t\tentry.linkTarget, err = normalizeArchiveSymlinkTarget(name, target, policy)","+\t\t\tif err != nil {","+\t\t\t\treturn nil, err","+\t\t\t}","+\t\t}","+\t\tentries = append(entries, entry)","+\t}","+","+\tfor name, kind := range byName {","+\t\tfor parent := path.Dir(name); parent != \".\"; parent = path.Dir(parent) {","+\t\t\tif parentKind, exists := byName[parent]; exists && parentKind != zipEntryDirectory {","+\t\t\t\treturn nil, fmt.Errorf(\"archive entry %q has non-directory ancestor %q\", name, parent)","+\t\t\t}","+\t\t}","+\t\tif kind == zipEntryDirectory {","+\t\t\tcontinue","+\t\t}","+\t\tprefix := name + \"/\"","+\t\tfor other := range byName {","+\t\t\tif strings.HasPrefix(other, prefix) {","+\t\t\t\treturn nil, fmt.Errorf(\"archive entry %q conflicts with child entry %q\", name, other)","+\t\t\t}","+\t\t}","+\t}","+","+\tsort.SliceStable(entries, func(i, j int) bool {","+\t\tleftDepth := strings.Count(entries[i].name, \"/\")","+\t\trightDepth := strings.Count(entries[j].name, \"/\")","+\t\tif leftDepth != rightDepth {","+\t\t\treturn leftDepth < rightDepth","+\t\t}","+\t\treturn entries[i].name < entries[j].name","+\t})","+\treturn entries, nil","+}","+","+func normalizeArchiveEntryName(raw string) (string, error) {","+\tif raw == \"\" || strings.ContainsRune(raw, '\\x00') {","+\t\treturn \"\", fmt.Errorf(\"invalid empty or NUL-containing archive path\")","+\t}","+\tif strings.Contains(raw, \"\\\\\") {","+\t\treturn \"\", fmt.Errorf(\"archive path %q contains a platform-dependent separator\", raw)","+\t}","+\tif path.IsAbs(raw) || strings.HasPrefix(raw, \"//\") || hasWindowsVolumePrefix(raw) {","+\t\treturn \"\", fmt.Errorf(\"archive path %q is absolute\", raw)","+\t}","+","+\tclean := path.Clean(strings.TrimSuffix(raw, \"/\"))","+\tif clean == \".\" || clean == \"..\" || strings.HasPrefix(clean, \"../\") {","+\t\treturn \"\", fmt.Errorf(\"archive path %q escapes the extraction root\", raw)","+\t}","+\treturn clean, nil","+}","+","+func classifyZipEntry(file *zip.File) (zipEntryKind, error) {","+\tmode := file.Mode()","+\tif mode&os.ModeSymlink != 0 {","+\t\tif strings.HasSuffix(file.Name, \"/\") {","+\t\t\treturn 0, fmt.Errorf(\"symlink is marked as a directory\")","+\t\t}","+\t\treturn zipEntrySymlink, nil","+\t}","+\tif file.FileInfo().IsDir() || strings.HasSuffix(file.Name, \"/\") {","+\t\treturn zipEntryDirectory, nil","+\t}","+\tif mode&os.ModeType != 0 && !mode.IsRegular() {","+\t\treturn 0, fmt.Errorf(\"unsupported special file mode %s\", mode.String())","+\t}","+\treturn zipEntryRegular, nil","+}","+","+func readZipSymlinkTarget(file *zip.File) (string, error) {","+\tif file.UncompressedSize64 > maxArchiveSymlinkTargetSize {","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q target is too large\", file.Name)","+\t}","+\tsource, err := file.Open()","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"open archive symlink %q: %w\", file.Name, err)","+\t}","+\tdefer source.Close()","+","+\ttarget, err := io.ReadAll(io.LimitReader(source, maxArchiveSymlinkTargetSize+1))","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"read archive symlink %q: %w\", file.Name, err)","+\t}","+\tif len(target) > maxArchiveSymlinkTargetSize {","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q target is too large\", file.Name)","+\t}","+\treturn string(target), nil","+}","+","+func normalizeArchiveSymlinkTarget(entryName, rawTarget string, policy zipExtractionPolicy) (string, error) {","+\tif rawTarget == \"\" || strings.ContainsRune(rawTarget, '\\x00') {","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q has an invalid target\", entryName)","+\t}","+\tif strings.Contains(rawTarget, \"\\\\\") || hasWindowsVolumePrefix(rawTarget) {","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q has a platform-dependent target %q\", entryName, rawTarget)","+\t}","+","+\tif filepath.IsAbs(rawTarget) || path.IsAbs(rawTarget) {","+\t\tcleanTarget := filepath.Clean(rawTarget)","+\t\tif policy.absoluteSymlinkRewriteRoot != \"\" && isPathWithin(cleanTarget, policy.absoluteSymlinkRewriteRoot) {","+\t\t\trelativeToRoot, err := filepath.Rel(filepath.Clean(policy.absoluteSymlinkRewriteRoot), cleanTarget)","+\t\t\tif err != nil {","+\t\t\t\treturn \"\", fmt.Errorf(\"resolve archive symlink %q target: %w\", entryName, err)","+\t\t\t}","+\t\t\treturn relativeArchiveSymlinkTarget(entryName, filepath.ToSlash(relativeToRoot))","+\t\t}","+\t\tfor _, allowedRoot := range policy.allowedAbsoluteLinkRoots {","+\t\t\tif allowedRoot != \"\" && isPathWithin(cleanTarget, allowedRoot) {","+\t\t\t\treturn cleanTarget, nil","+\t\t\t}","+\t\t}","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q points outside allowed roots: %q\", entryName, rawTarget)","+\t}","+","+\treturn normalizeRelativeArchiveSymlinkTarget(entryName, rawTarget)","+}","+","+func normalizeRelativeArchiveSymlinkTarget(entryName, rawTarget string) (string, error) {","+\tcleanTarget := path.Clean(rawTarget)","+\tresolved := path.Clean(path.Join(path.Dir(entryName), cleanTarget))","+\tif resolved == \".\" || resolved == \"..\" || strings.HasPrefix(resolved, \"../\") {","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q escapes the extraction root: %q\", entryName, rawTarget)","+\t}","+","+\treturn relativeArchiveSymlinkTarget(entryName, resolved)","+}","+","+func relativeArchiveSymlinkTarget(entryName, targetWithinRoot string) (string, error) {","+\trelativeTarget, err := filepath.Rel(","+\t\tfilepath.FromSlash(path.Dir(entryName)),","+\t\tfilepath.FromSlash(targetWithinRoot),","+\t)","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"normalize archive symlink %q target: %w\", entryName, err)","+\t}","+\tif relativeTarget == \".\" {","+\t\treturn \"\", fmt.Errorf(\"archive symlink %q creates a self-referential target\", entryName)","+\t}","+\treturn relativeTarget, nil","+}","+","+func hasWindowsVolumePrefix(value string) bool {","+\treturn len(value) >= 2 && ((value[0] >= 'A' && value[0] <= 'Z') || (value[0] >= 'a' && value[0] <= 'z')) && value[1] == ':'","+}","+","+func isPathWithin(candidate, root string) bool {","+\trelative, err := filepath.Rel(filepath.Clean(root), filepath.Clean(candidate))","+\tif err != nil {","+\t\treturn false","+\t}","+\treturn relative == \".\" || (relative != \"..\" && !strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) && !filepath.IsAbs(relative))","+}","+","+func ensureEmptyDirectory(directory string) error {","+\tif err := os.MkdirAll(directory, 0o755); err != nil {","+\t\treturn fmt.Errorf(\"create extraction directory %q: %w\", directory, err)","+\t}","+\tentries, err := os.ReadDir(directory)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"read extraction directory %q: %w\", directory, err)","+\t}","+\tif len(entries) != 0 {","+\t\treturn fmt.Errorf(\"extraction directory %q is not empty\", directory)","+\t}","+\treturn nil","+}","+","+func extractRegularZipEntry(root *os.Root, entry preparedZipEntry) error {","+\tname := filepath.FromSlash(entry.name)","+\tparent := filepath.Dir(name)","+\tif parent != \".\" {","+\t\tif err := root.MkdirAll(parent, 0o755); err != nil {","+\t\t\treturn fmt.Errorf(\"create parent for archive entry %q: %w\", entry.name, err)","+\t\t}","+\t}","+","+\tdestination, err := root.OpenFile(name, os.O_WRONLY|os.O_CREATE|os.O_EXCL, regularFileMode(entry.file.Mode()))","+\tif err != nil {","+\t\treturn fmt.Errorf(\"create archive entry %q: %w\", entry.name, err)","+\t}","+","+\tsource, err := entry.file.Open()","+\tif err != nil {","+\t\t_ = destination.Close()","+\t\treturn fmt.Errorf(\"open archive entry %q: %w\", entry.name, err)","+\t}","+","+\t_, copyErr := io.Copy(destination, source)","+\tcloseSourceErr := source.Close()","+\tcloseDestinationErr := destination.Close()","+\tif copyErr != nil {","+\t\treturn fmt.Errorf(\"copy archive entry %q: %w\", entry.name, copyErr)","+\t}","+\tif closeSourceErr != nil {","+\t\treturn fmt.Errorf(\"close archive entry %q: %w\", entry.name, closeSourceErr)","+\t}","+\tif closeDestinationErr != nil {","+\t\treturn fmt.Errorf(\"close extracted entry %q: %w\", entry.name, closeDestinationErr)","+\t}","+\treturn nil","+}","+","+func validateExtractedEntries(root *os.Root, entries []preparedZipEntry) error {","+\tfor _, entry := range entries {","+\t\tinfo, err := root.Lstat(filepath.FromSlash(entry.name))","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"validate extracted entry %q: %w\", entry.name, err)","+\t\t}","+\t\tswitch entry.kind {","+\t\tcase zipEntryDirectory:","+\t\t\tif !info.IsDir() {","+\t\t\t\treturn fmt.Errorf(\"extracted entry %q is not a directory\", entry.name)","+\t\t\t}","+\t\tcase zipEntryRegular:","+\t\t\tif !info.Mode().IsRegular() {","+\t\t\t\treturn fmt.Errorf(\"extracted entry %q is not a regular file\", entry.name)","+\t\t\t}","+\t\tcase zipEntrySymlink:","+\t\t\tif info.Mode()&os.ModeSymlink == 0 {","+\t\t\t\treturn fmt.Errorf(\"extracted entry %q is not a symlink\", entry.name)","+\t\t\t}","+\t\t\ttarget, err := root.Readlink(filepath.FromSlash(entry.name))","+\t\t\tif err != nil {","+\t\t\t\treturn fmt.Errorf(\"read extracted symlink %q: %w\", entry.name, err)","+\t\t\t}","+\t\t\tif target != entry.linkTarget {","+\t\t\t\treturn fmt.Errorf(\"extracted symlink %q target changed\", entry.name)","+\t\t\t}","+\t\t}","+\t}","+\treturn nil","+}","+","+func directoryMode(mode os.FileMode) os.FileMode {","+\tif permission := mode.Perm(); permission != 0 {","+\t\treturn permission","+\t}","+\treturn 0o755","+}","+","+func regularFileMode(mode os.FileMode) os.FileMode {","+\tif permission := mode.Perm(); permission != 0 {","+\t\treturn permission","+\t}","+\treturn 0o644","+}"],"additions":382,"deletions":0,"truncated":false},{"path":"internal/backup/extract_security_test.go","lines":["@@ -0,0 +1,158 @@","+package backup","+","+import (","+\t\"archive/zip\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+)","+","+type testZipEntry struct {","+\tname    string","+\tcontent string","+\