{"id":"GHSA-j8j4-rw65-56r6","axis":"advisories","repo":"telepresenceio/telepresence","sha":"04ec3464fe8878fdc96420cdc8036edefa0dc9ae","parsed":{"files":[{"path":"charts/telepresence-oss/templates/trafficManagerRbac/cluster-scope.yaml","lines":["@@ -63,6 +63,12 @@ rules:","     - get","     - list","     - watch","+- apiGroups:","+    - \"authentication.k8s.io\"","+  resources:","+    - tokenreviews","+  verbs:","+    - create"," ---"," apiVersion: rbac.authorization.k8s.io/v1"," kind: ClusterRoleBinding"],"additions":6,"deletions":0,"truncated":false},{"path":"charts/telepresence-oss/templates/trafficManagerRbac/namespace-scope.yaml","lines":["@@ -150,6 +150,12 @@ rules:","       - get","       - list","       - watch","+  - apiGroups:","+      - \"authentication.k8s.io\"","+    resources:","+      - tokenreviews","+    verbs:","+      - create"," "," ---"," apiVersion: rbac.authorization.k8s.io/v1"],"additions":6,"deletions":0,"truncated":false},{"path":"cmd/traffic/cmd/agent/client.go","lines":["@@ -5,6 +5,7 @@ import ("," \t\"fmt\""," \t\"log/slog\""," \t\"os\"","+\t\"path/filepath\""," \t\"strings\""," \t\"time\""," ","@@ -17,6 +18,7 @@ import ("," "," \t\"github.com/telepresenceio/clog\""," \trpc \"github.com/telepresenceio/telepresence/rpc/v2/manager\"","+\t\"github.com/telepresenceio/telepresence/v2/pkg/agentconfig\""," \t\"github.com/telepresenceio/telepresence/v2/pkg/dos\""," \t\"github.com/telepresenceio/telepresence/v2/pkg/grpc/watcher\""," \t\"github.com/telepresenceio/telepresence/v2/pkg/log\"","@@ -51,7 +53,16 @@ func TalkToManager(ctx context.Context, address string, info *rpc.AgentInfo, sta"," \tctx, cancel := context.WithCancel(ctx)"," \tdefer cancel()"," ","-\tconn, err := grpc.NewClient(address, grpc.WithTransportCredentials(insecure.NewCredentials()))","+\topts := []grpc.DialOption{grpc.WithTransportCredentials(insecure.NewCredentials())}","+\ttokenPath := filepath.Join(agentconfig.ManagerTokenMountPath, agentconfig.ManagerTokenFile)","+\tif _, err := os.Stat(tokenPath); err == nil {","+\t\tclog.Debug(ctx, \"attaching manager token to traffic-manager connection\")","+\t\topts = append(opts, grpc.WithPerRPCCredentials(newManagerTokenCredentials(tokenPath)))","+\t} else {","+\t\tclog.Debug(ctx, \"no manager token file present, connecting without a manager token\")","+\t}","+","+\tconn, err := grpc.NewClient(address, opts...)"," \tif err != nil {"," \t\treturn err"," \t}"],"additions":12,"deletions":1,"truncated":false},{"path":"cmd/traffic/cmd/agent/manager_token.go","lines":["@@ -0,0 +1,53 @@","+package agent","+","+import (","+\t\"context\"","+\t\"sync\"","+","+\t\"golang.org/x/oauth2\"","+\t\"google.golang.org/grpc/credentials\"","+\t\"k8s.io/client-go/transport\"","+","+\t\"github.com/telepresenceio/clog\"","+)","+","+// managerTokenCredentials is a credentials.PerRPCCredentials that attaches the","+// traffic-agent's projected manager-audience ServiceAccount token as a bearer","+// credential on every RPC to the traffic-manager. The token is read from the","+// file on demand through a caching source, so rotation of the projected volume","+// is picked up without reconnecting.","+type managerTokenCredentials struct {","+\tsource   oauth2.TokenSource","+\twarnOnce sync.Once","+}","+","+var _ credentials.PerRPCCredentials = (*managerTokenCredentials)(nil)","+","+// newManagerTokenCredentials returns credentials backed by the manager-audience","+// token file at path.","+func newManagerTokenCredentials(path string) *managerTokenCredentials {","+\treturn &managerTokenCredentials{source: transport.NewCachedFileTokenSource(path)}","+}","+","+// GetRequestMetadata returns the bearer authorization header for the current","+// token. A read failure is logged once and yields empty metadata rather than","+// an error, so a transient problem reading the rotating token file never","+// fails every agent RPC; the manager treats a missing token according to its","+// own enforcement mode. Token contents are never logged.","+func (c *managerTokenCredentials) GetRequestMetadata(ctx context.Context, _ ...string) (map[string]string, error) {","+\ttok, err := c.source.Token()","+\tif err != nil {","+\t\tc.warnOnce.Do(func() {","+\t\t\tclog.Warnf(ctx, \"unable to read manager token: %v\", err)","+\t\t})","+\t\treturn map[string]string{}, nil","+\t}","+\treturn map[string]string{\"authorization\": \"Bearer \" + tok.AccessToken}, nil","+}","+","+// RequireTransportSecurity is false: the connection to the traffic-manager is","+// plaintext h2c inside the cluster network, and the token itself is audience-","+// bound to the manager so it carries no value if intercepted outside it.","+func (c *managerTokenCredentials) RequireTransportSecurity() bool {","+\treturn false","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"cmd/traffic/cmd/agent/manager_token_test.go","lines":["@@ -0,0 +1,34 @@","+package agent","+","+import (","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/telepresenceio/clog/testutil\"","+)","+","+func Test_managerTokenCredentials_GetRequestMetadata(t *testing.T) {","+\tctx := testutil.NewContext(t, false)","+","+\tpath := filepath.Join(t.TempDir(), \"manager-token\")","+\trequire.NoError(t, os.WriteFile(path, []byte(\"the-token-content\\n\"), 0o600))","+","+\tcreds := newManagerTokenCredentials(path)","+\tmd, err := creds.GetRequestMetadata(ctx)","+\trequire.NoError(t, err)","+\trequire.Equal(t, map[string]string{\"authorization\": \"Bearer the-token-content\"}, md)","+\trequire.False(t, creds.RequireTransportSecurity())","+}","+","+func Test_managerTokenCredentials_GetRequestMetadata_readFailure(t *testing.T) {","+\tctx := testutil.NewContext(t, false)","+","+\tpath := filepath.Join(t.TempDir(), \"does-not-exist\")","+\tcreds := newManagerTokenCredentials(path)","+\tmd, err := creds.GetRequestMetadata(ctx)","+\trequire.NoError(t, err)","+\trequire.Empty(t, md)","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"cmd/traffic/cmd/manager/auth/authenticator.go","lines":["@@ -0,0 +1,112 @@","+package auth","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"time\"","+","+\tauthenticationv1 \"k8s.io/api/authentication/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apiserver/pkg/authentication/authenticator\"","+\t\"k8s.io/apiserver/pkg/authentication/token/cache\"","+\t\"k8s.io/apiserver/pkg/authentication/user\"","+\t\"k8s.io/client-go/kubernetes\"","+","+\t\"github.com/telepresenceio/telepresence/v2/pkg/agentconfig\"","+)","+","+// ErrInvalidToken is returned by Authenticate when the Kubernetes API server rejects the bearer token.","+var ErrInvalidToken = errors.New(\"invalid bearer token\")","+","+const (","+\tpodNameExtraKey = \"authentication.kubernetes.io/pod-name\"","+\tpodUIDExtraKey  = \"authentication.kubernetes.io/pod-uid\"","+","+\tsuccessCacheTTL = 2 * time.Minute","+\tfailureCacheTTL = 10 * time.Second","+)","+","+// Authenticator validates bearer tokens using cached Kubernetes TokenReviews.","+type Authenticator struct {","+\ttoken authenticator.Token","+}","+","+// NewAuthenticator creates an Authenticator that validates tokens with the TokenReview API of ci.","+func NewAuthenticator(ci kubernetes.Interface) *Authenticator {","+\treturn &Authenticator{","+\t\ttoken: cache.New(&tokenReviewer{client: ci}, true, successCacheTTL, failureCacheTTL),","+\t}","+}","+","+// Authenticate validates a bearer token and returns the caller's Principal.","+func (a *Authenticator) Authenticate(ctx context.Context, token string) (*Principal, error) {","+\tresp, ok, err := a.token.AuthenticateToken(authenticator.WithAudiences(ctx, authenticator.Audiences{agentconfig.ManagerTokenAudience}), token)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"token review: %w\", err)","+\t}","+\tif !ok {","+\t\t// The token may be a user/client token, valid against the API server's own","+\t\t// audience rather than the manager's. Retry without an audience constraint.","+\t\tresp, ok, err = a.token.AuthenticateToken(ctx, token)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"token review: %w\", err)","+\t\t}","+\t\tif !ok {","+\t\t\treturn nil, ErrInvalidToken","+\t\t}","+\t}","+\treturn principalFromInfo(resp.User), nil","+}","+","+func principalFromInfo(info user.Info) *Principal {","+\tp := &Principal{","+\t\tUsername: info.GetName(),","+\t\tUID:      info.GetUID(),","+\t\tGroups:   info.GetGroups(),","+\t}","+\textra := info.GetExtra()","+\tif v := extra[podNameExtraKey]; len(v) > 0 {","+\t\tp.PodName = v[0]","+\t}","+\tif v := extra[podUIDExtraKey]; len(v) > 0 {","+\t\tp.PodUID = v[0]","+\t}","+\treturn p","+}","+","+// tokenReviewer implements authenticator.Token by delegating to the Kubernetes TokenReview API.","+type tokenReviewer struct {","+\tclient kubernetes.Interface","+}","+","+func (t *tokenReviewer) AuthenticateToken(ctx context.Context, token string) (*authenticator.Response, bool, error) {","+\treview := &authenticationv1.TokenReview{","+\t\tSpec: authenticationv1.TokenReviewSpec{Token: token},","+\t}","+\tif auds, ok := authenticator.AudiencesFrom(ctx); ok {","+\t\treview.Spec.Audiences = auds","+\t}","+\tresult, err := t.client.AuthenticationV1().TokenReviews().Create(ctx, review, metav1.CreateOptions{})","+\tif err != nil {","+\t\treturn nil, false, err","+\t}","+\tstatus := result.Status","+\tif !status.Authenticated {","+\t\treturn nil, false, nil","+\t}","+\textra := make(map[string][]string, len(status.User.Extra))","+\tfor k, v := range status.User.Extra {","+\t\textra[k] = v","+\t}","+\tresp := &authenticator.Response{","+\t\tUser: &user.DefaultInfo{","+\t\t\tName:   status.User.Username,","+\t\t\tUID:    status.User.UID,","+\t\t\tGroups: status.User.Groups,","+\t\t\tExtra:  extra,","+\t\t},","+\t\tAudiences: status.Audiences,","+\t}","+\treturn resp, true, nil","+}"],"additions":112,"deletions":0,"truncated":false},{"path":"cmd/traffic/cmd/manager/auth/authenticator_test.go","lines":["@@ -0,0 +1,145 @@","+package auth_test","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"sync/atomic\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tauthnv1 \"k8s.io/api/authentication/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/client-go/kubernetes/fake\"","+\tk8stesting \"k8s.io/client-go/testing\"","+","+\t\"github.com/telepresenceio/telepresence/v2/cmd/traffic/cmd/manager/auth\"","+\t\"github.com/telepresenceio/telepresence/v2/pkg/agentconfig\"","+\t\"github.com/telepresenceio/telepresence/v2/pkg/k8sapi\"","+)","+","+func authenticatedStatus(name, uid string, groups ...string) *authnv1.TokenReviewStatus {","+\treturn &authnv1.TokenReviewStatus{","+\t\tAuthenticated: true,","+\t\tUser: authnv1.UserInfo{","+\t\t\tUsername: name,","+\t\t\tUID:      uid,","+\t\t\tGroups:   groups,","+\t\t},","+\t}","+}","+","+func TestAuthenticate_ValidBoundToken(t *testing.T) {","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, func(token string, audiences []string) *authnv1.TokenReviewStatus {","+\t\tif token != \"good-token\" {","+\t\t\treturn &authnv1.TokenReviewStatus{Authenticated: false}","+\t\t}","+\t\tstatus := authenticatedStatus(\"system:serviceaccount:demo:my-sa\", \"1234\", \"system:serviceaccounts\", \"system:serviceaccounts:demo\")","+\t\tstatus.User.Extra = map[string]authnv1.ExtraValue{","+\t\t\t\"authentication.kubernetes.io/pod-name\": {\"my-pod\"},","+\t\t\t\"authentication.kubernetes.io/pod-uid\":  {\"pod-uid-1\"},","+\t\t}","+\t\treturn status","+\t})","+","+\ta := auth.NewAuthenticator(ci)","+\tp, err := a.Authenticate(context.Background(), \"good-token\")","+\trequire.NoError(t, err)","+\trequire.NotNil(t, p)","+\tassert.Equal(t, \"system:serviceaccount:demo:my-sa\", p.Username)","+\tassert.Equal(t, \"1234\", p.UID)","+\tassert.Equal(t, []string{\"system:serviceaccounts\", \"system:serviceaccounts:demo\"}, p.Groups)","+\tassert.Equal(t, \"my-pod\", p.PodName)","+\tassert.Equal(t, \"pod-uid-1\", p.PodUID)","+}","+","+func TestAuthenticate_AudienceFallback(t *testing.T) {","+\tvar firstAudiences []string","+\tvar calls int","+","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, func(token string, audiences []string) *authnv1.TokenReviewStatus {","+\t\tif calls == 0 {","+\t\t\tfirstAudiences = audiences","+\t\t}","+\t\tcalls++","+\t\tswitch {","+\t\tcase token == \"manager-token\" && len(audiences) == 1 && audiences[0] == agentconfig.ManagerTokenAudience:","+\t\t\treturn authenticatedStatus(\"manager-sa\", \"u1\")","+\t\tcase token == \"user-token\" && len(audiences) == 0:","+\t\t\treturn authenticatedStatus(\"some-user\", \"u2\")","+\t\tdefault:","+\t\t\treturn &authnv1.TokenReviewStatus{Authenticated: false}","+\t\t}","+\t})","+","+\ta := auth.NewAuthenticator(ci)","+","+\tp, err := a.Authenticate(context.Background(), \"manager-token\")","+\trequire.NoError(t, err)","+\tassert.Equal(t, \"manager-sa\", p.Username)","+\tassert.Equal(t, []string{agentconfig.ManagerTokenAudience}, firstAudiences)","+","+\tp, err = a.Authenticate(context.Background(), \"user-token\")","+\trequire.NoError(t, err)","+\tassert.Equal(t, \"some-user\", p.Username)","+}","+","+func TestAuthenticate_InvalidToken(t *testing.T) {","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, nil)","+","+\ta := auth.NewAuthenticator(ci)","+\tp, err := a.Authenticate(context.Background(), \"bad-token\")","+\tassert.Nil(t, p)","+\tassert.ErrorIs(t, err, auth.ErrInvalidToken)","+}","+","+func TestAuthenticate_InfrastructureError(t *testing.T) {","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, nil)","+\tfailure := errors.New(\"connection refused\")","+\tci.PrependReactor(\"create\", \"tokenreviews\", func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\treturn true, nil, failure","+\t})","+","+\ta := auth.NewAuthenticator(ci)","+\tp, err := a.Authenticate(context.Background(), \"any-token\")","+\tassert.Nil(t, p)","+\tassert.False(t, errors.Is(err, auth.ErrInvalidToken))","+\trequire.Error(t, err)","+}","+","+func TestAuthenticate_Caching(t *testing.T) {","+\tvar calls atomic.Int32","+","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, func(token string, audiences []string) *authnv1.TokenReviewStatus {","+\t\tcalls.Add(1)","+\t\tif token == \"good\" && len(audiences) == 1 && audiences[0] == agentconfig.ManagerTokenAudience {","+\t\t\treturn authenticatedStatus(\"u\", \"1\")","+\t\t}","+\t\treturn &authnv1.TokenReviewStatus{Authenticated: false}","+\t})","+","+\ta := auth.NewAuthenticator(ci)","+","+\t_, err := a.Authenticate(context.Background(), \"good\")","+\trequire.NoError(t, err)","+\tafterFirst := calls.Load()","+\tassert.Equal(t, int32(1), afterFirst)","+","+\t_, err = a.Authenticate(context.Background(), \"good\")","+\trequire.NoError(t, err)","+\tassert.Equal(t, afterFirst, calls.Load())","+","+\t_, err = a.Authenticate(context.Background(), \"bad\")","+\tassert.ErrorIs(t, err, auth.ErrInvalidToken)","+\tafterBad := calls.Load()","+\tassert.Greater(t, afterBad, afterFirst)","+","+\t_, err = a.Authenticate(context.Background(), \"bad\")","+\tassert.ErrorIs(t, err, auth.ErrInvalidToken)","+\tassert.Equal(t, afterBad, calls.Load())","+}"],"additions":145,"deletions":0,"truncated":false},{"path":"cmd/traffic/cmd/manager/auth/interceptor.go","lines":["@@ -0,0 +1,107 @@","+package auth","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"strings\"","+","+\t\"google.golang.org/grpc\"","+\t\"google.golang.org/grpc/metadata\"","+","+\t\"github.com/telepresenceio/clog\"","+)","+","+const (","+\tversionMethod       = \"/telepresence.manager.Manager/Version\"","+\thealthMethodPrefix  = \"/grpc.health.v1.Health/\"","+\tauthorizationHeader = \"authorization\"","+\tbearerPrefix        = \"bearer \"","+\tbearerPrefixLen     = len(bearerPrefix)","+)","+","+// Interceptor authenticates bearer tokens on incoming gRPC calls. It is permissive: a missing or","+// rejected token lets the call proceed without a Principal.","+type Interceptor struct {","+\tauth *Authenticator","+}","+","+// NewInterceptor creates an Interceptor that authenticates calls using a.","+func NewInterceptor(a *Authenticator) *Interceptor {","+\treturn &Interceptor{auth: a}","+}","+","+// Unary returns a grpc.UnaryServerInterceptor that authenticates the call.","+func (i *Interceptor) Unary() grpc.UnaryServerInterceptor {","+\treturn func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {","+\t\tif skipAuth(info.FullMethod) {","+\t\t\treturn handler(ctx, req)","+\t\t}","+\t\treturn handler(i.authenticate(ctx, info.FullMethod), req)","+\t}","+}","+","+// Stream returns a grpc.StreamServerInterceptor that authenticates the call.","+func (i *Interceptor) Stream() grpc.StreamServerInterceptor {","+\treturn func(srv any, ss grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) error {","+\t\tif skipAuth(info.FullMethod) {","+\t\t\treturn handler(srv, ss)","+\t\t}","+\t\tctx := i.authenticate(ss.Context(), info.FullMethod)","+\t\treturn handler(srv, &authenticatedStream{ServerStream: ss, ctx: ctx})","+\t}","+}","+","+func skipAuth(method string) bool {","+\treturn method == versionMethod || strings.HasPrefix(method, healthMethodPrefix)","+}","+","+// authenticate reads the bearer token from ctx's incoming metadata and returns a context carrying","+// the resulting Principal. Failures are logged, never fatal to the call.","+func (i *Interceptor) authenticate(ctx context.Context, method string) context.Context {","+\ttoken, present := bearerTokenFrom(ctx)","+\tif token == \"\" {","+\t\tif present {","+\t\t\tclog.Debugf(ctx, \"ignoring malformed authorization metadata for %s\", method)","+\t\t} else {","+\t\t\tclog.Tracef(ctx, \"unauthenticated call to %s\", method)","+\t\t}","+\t\treturn ctx","+\t}","+\tp, err := i.auth.Authenticate(ctx, token)","+\tswitch {","+\tcase err == nil:","+\t\treturn WithPrincipal(ctx, p)","+\tcase errors.Is(err, ErrInvalidToken):","+\t\tclog.Warnf(ctx, \"call to %s presented an invalid bearer token\", method)","+\tdefault:","+\t\tclog.Errorf(ctx, \"token authentication unavailable for %s: %v\", method, err)","+\t}","+\treturn ctx","+}","+","+// bearerTokenFrom extracts the bearer token from the \"authorization\" metadata key. present is true","+// when the key was set, even if the value didn't parse as a bearer token.","+func bearerTokenFrom(ctx context.Context) (token string, present bool) {","+\tmd, ok := metadata.FromIncomingContext(ctx)","+\tif !ok {","+\t\treturn \"\", false","+\t}","+\tvs := md.Get(authorizationHeader)","+\tif len(vs) == 0 {","+\t\treturn \"\", false","+\t}","+\tv := vs[0]","+\tif len(v) < bearerPrefixLen || !strings.EqualFold(v[:bearerPrefixLen], bearerPrefix) {","+\t\treturn \"\", true","+\t}","+\treturn strings.TrimSpace(v[bearerPrefixLen:]), true","+}","+","+type authenticatedStream struct {","+\tgrpc.ServerStream","+\tctx context.Context","+}","+","+func (s *authenticatedStream) Context() context.Context {","+\treturn s.ctx","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"cmd/traffic/cmd/manager/auth/interceptor_test.go","lines":["@@ -0,0 +1,171 @@","+package auth_test","+","+import (","+\t\"bytes\"","+\t\"context\"","+\t\"errors\"","+\t\"log/slog\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"google.golang.org/grpc\"","+\t\"google.golang.org/grpc/metadata\"","+\tauthnv1 \"k8s.io/api/authentication/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/client-go/kubernetes/fake\"","+\tk8stesting \"k8s.io/client-go/testing\"","+","+\t\"github.com/telepresenceio/clog\"","+\t\"github.com/telepresenceio/clog/handler\"","+\t\"github.com/telepresenceio/telepresence/v2/cmd/traffic/cmd/manager/auth\"","+\t\"github.com/telepresenceio/telepresence/v2/pkg/k8sapi\"","+)","+","+func loggingContext(buf *bytes.Buffer) context.Context {","+\th := handler.NewText(handler.Output(buf), handler.EnabledLevel(clog.LevelTrace))","+\treturn clog.WithLogger(context.Background(), slog.New(h))","+}","+","+func newTestInterceptor(ci *fake.Clientset) *auth.Interceptor {","+\treturn auth.NewInterceptor(auth.NewAuthenticator(ci))","+}","+","+func TestInterceptor_Unary(t *testing.T) {","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, func(token string, audiences []string) *authnv1.TokenReviewStatus {","+\t\tif token == \"good\" {","+\t\t\treturn authenticatedStatus(\"u\", \"1\")","+\t\t}","+\t\treturn &authnv1.TokenReviewStatus{Authenticated: false}","+\t})","+","+\ti := newTestInterceptor(ci)","+\tunary := i.Unary()","+\tinfo := &grpc.UnaryServerInfo{FullMethod: \"/telepresence.manager.Manager/Connect\"}","+\thandler := func(ctx context.Context, _ any) (any, error) {","+\t\treturn auth.PrincipalFrom(ctx), nil","+\t}","+","+\tt.Run(\"token present\", func(t *testing.T) {","+\t\tctx := metadata.NewIncomingContext(context.Background(), metadata.Pairs(\"authorization\", \"Bearer good\"))","+\t\tresp, err := unary(ctx, nil, info, handler)","+\t\trequire.NoError(t, err)","+\t\tp, _ := resp.(*auth.Principal)","+\t\trequire.NotNil(t, p)","+\t\tassert.Equal(t, \"u\", p.Username)","+\t})","+","+\tt.Run(\"no metadata\", func(t *testing.T) {","+\t\tresp, err := unary(context.Background(), nil, info, handler)","+\t\trequire.NoError(t, err)","+\t\tassert.Nil(t, resp)","+\t})","+","+\tt.Run(\"invalid token\", func(t *testing.T) {","+\t\tctx := metadata.NewIncomingContext(context.Background(), metadata.Pairs(\"authorization\", \"Bearer bad\"))","+\t\tresp, err := unary(ctx, nil, info, handler)","+\t\trequire.NoError(t, err)","+\t\tassert.Nil(t, resp)","+\t})","+}","+","+func TestInterceptor_Unary_SkipsVersionAndHealth(t *testing.T) {","+\tci := fake.NewClientset()","+\tk8sapi.InstallFakeTokenReviews(ci, nil)","+","+\ti := n