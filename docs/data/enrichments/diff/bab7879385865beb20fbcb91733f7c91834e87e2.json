,"+        AtomicUsize,","+        Ordering,","+    };","+","+    static UNUSED_OVERRIDE_EVENTS: AtomicUsize = AtomicUsize::new(0);","+","+    struct RecordingReporter;","+    impl Reporter for RecordingReporter {","+        fn emit(event: &LogEvent) {","+            if matches!(event, LogEvent::UnusedOverride(_)) {","+                UNUSED_OVERRIDE_EVENTS.fetch_add(1, Ordering::SeqCst);","+            }","+        }","+    }","+","+    fresh_lockfile_only_with_overrides_reporting::<RecordingReporter>(","+        &[(\"@pnpm.e2e/foo\", \"^100.0.0\")],","+        &[(\"@pnpm.e2e/missing-pkg@^1.0.0\", \"1.0.0\")],","+        None,","+        |config| config.warn_unused_overrides = false,","+    )","+    .await;","+","+    assert_eq!(UNUSED_OVERRIDE_EVENTS.load(Ordering::SeqCst), 0);","+}"," // The `afterAllResolved` hook receives the resolved"," // lockfile object and its return value is what gets written, so an arbitrary"," // added key must survive to pnpm-lock.yaml."],"additions":91,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile.rs","lines":["@@ -68,6 +68,7 @@ use setup::{"," };"," "," mod materialization;","+mod override_warnings;"," use materialization::finish_resolved_install;"," "," mod errors;","@@ -750,32 +751,6 @@ fn report_peer_issues(","     }"," }"," ","-/// No-op unless the run both parsed overrides and built an overrider for","-/// them; only then are the collected declared ranges complete enough for a","-/// staleness verdict.","-async fn warn_stale_convergence_overrides_if_any<Reporter: pnpm_reporter::Reporter>(","-    npm_resolver: &dyn pnpm_resolving_resolver_base::Resolver,","-    parsed_overrides: Option<&[pnpm_config_parse_overrides::VersionOverride]>,","-    versions_overrider: Option<&crate::VersionsOverrider>,","-    lockfile_dir: &Path,","-    published_by: (","-        Option<jiff::Timestamp>,","-        Option<&pnpm_config::version_policy::PackageVersionPolicy>,","-    ),","-) {","-    l