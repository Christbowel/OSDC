g() {","+    let mut reporter = state(false);","+    let frame = render(&mut reporter, vec![resolution_done()]);","+    assert!(frame.is_empty(), \"expected no warning, got: {frame:?}\");","+}","+","+#[test]","+fn unused_override_selectors_are_sanitized_before_rendering() {","+    let mut reporter = state(false);","+    let frame = render(","+        &mut reporter,","+        vec![unused_override(\"inj\\u{202E}ect\\u{200B}ion\\u{2069}\\u{FEFF}\\x1b\"), resolution_done()],","+    );","+    assert_eq!(frame, \"[WARN] 1 override matched no dependency: injection\");","+}","+","+#[test]","+fn unused_overrides_render_at_the_warn_log_level() {","+    let mut reporter = state_with_options(ReporterOptions {","+        max_log_level: MaxLogLevel::Warn,","+        ..ReporterOptions::default()","+    });","+    let frame = render(&mut reporter, vec![unused_override(\"foo\"), resolution_done()]);","+    assert_eq!(frame, \"[WARN] 1 override matched no dependency: foo\");","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_package_from_registry/tests.rs","lines":["@@ -195,6 +195,7 @@ fn create_config(","         add_missing_peer_types: false,","         resolve_peers_from_workspace_root: false,","         block_exotic_subdeps: false,","+        warn_unused_overrides: true,","         verify_store_integrity: true,","         include_workspace_root: false,","         ignore_workspace_cycles: false,","@@ -266,6 +267,7 @@ fn create_config(","         supported_architectures: None,","         ignored_optional_dependencies: None,","         overrides: None,","+        hook_added_overrides: Default::default(),","         package_extensions: None,","         package_configs: None,","         cache_dir: cache_dir.to_path_buf(),"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/tests.rs","lines":["@@ -448,6 +448,21 @@ async fn fresh_lockfile_only_with_overrides(","     dependencies: &[(&str, &