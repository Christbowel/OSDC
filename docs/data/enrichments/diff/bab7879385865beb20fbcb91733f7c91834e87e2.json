pendency_issues(),","             // Debug-only / non-rendered channels in pnpm's default reporter.","             LogEvent::BrokenModules(_) => {}","@@ -435,7 +441,9 @@ impl ReporterState {","     /// pass: below `info`, [`Self::on_lifecycle`] buffers each script and","     /// prints only failed ones. Dedupe-check issues always pass too,","     /// upstream reports them as an error-level log","-    /// (`ERR_PNPM_DEDUPE_CHECK_ISSUES` in `reportError.ts`).","+    /// (`ERR_PNPM_DEDUPE_CHECK_ISSUES` in `reportError.ts`). The","+    /// `resolution_done` stage passes wherever warnings do, since it is what","+    /// flushes the buffered deprecation and unused-override warnings.","     fn level_permits(&self, event: &LogEvent) -> bool {","         match event {","             LogEvent::Lockfile(_)","@@ -448,7 +456,11 @@ impl ReporterState {","             | LogEvent::PendingSkills(_)","             | LogEvent::RequestRetry(_)","             | LogEvent::Deprecation(_)","+            | LogEvent::UnusedOverride(_)","             | LogEvent::PeerDependencyIssues(_) => self.options.max_log_level >= MaxLogLevel::Warn,","+            LogEvent::Stage(log) if log.stage == Stage::ResolutionDone => {","+                self.options.max_log_level >= MaxLogLevel::Warn","+            }","             LogEvent::LockfileVerification(log) => {","                 matches!(log.message, LockfileVerificationMessage::Failed { .. })","                     || self.options.max_log_level >= MaxLogLevel::Info"],"additions":13,"deletions":1,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state/notices.rs","lines":["@@ -21,6 +21,7 @@ use super::{","     SkippedOptionalDependencyLog,","     SkippedOptionalPackage,","     SkippedOptionalReason,","+    UnusedOverrideLog,","     UpdateCheckLog,","     cached_verdict,","     detect_install_source,","@@ -352,6 +353,37 @@ impl ReporterState {","         );","     }"," ","+    pub(super) fn on_unused_override(&mut self, log: &UnusedOverrideLog) {","+        self.notices.unused_overrides.push(log.selector.clone());","+    }","+","+    /// One grouped, sorted warning for every selector buffered since the","+    /// last `resolution_done`. Selectors come from `pnpm-workspace.yaml`, which","+    /// a contributor can edit, so they are sanitized before rendering.","+    pub(super) fn flush_unused_overrides(&mut self) {","+        if self.notices.unused_overrides.is_empty() {","+            return;","+        }","+        let mut selectors: Vec<String> = std::mem::take(&mut self.notices.unused_overrides)","+            .iter()","+            .map(String::as_str)","+            .map(pnpm_text_sanitize::sanitize_inline)","+            .map(std::borrow::Cow::into_owned)","+            .collect();","+        selectors.sort();","+        let head = if selectors.len() == 1 {","+            \"1 override matched no dependency\".to_string()","+        } else {","+            format!(\"{} overrides matched no dependency\", selectors.len())","+        };","+        self.notices.push_warning(","+            self.rendering.colors,","+            &mut self.display.frame,","+            self.options.append_only,","+            &format!(\"{head}: {}\", selectors.join(\", \")),","+        );","+    }","+","     /// Renders a `pnpm:hook` event as `hook: message`, matching pnpm's","     /// `reportHooks.ts` format. When the hook's `prefix` differs from","     /// `self.rendering.cwd` the message is zoomed out with the prefix."],"additions":32,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state/progress.rs","lines":["@@ -89,7 +89,7 @@ impl ReporterState {"," ","     pub(super) fn on_stage(&mut self, prefix: &str, stage: Stage) {","         match stage {","-            Stage::ResolutionDone => {}","+            Stage::ResolutionDone => self.flush_unused_overrides(),","             Stage::ImportingDone => {","                 if !self.downloads.progress.contains_key(prefix) {","                     re