{"id":"bab7879385865beb20fbcb91733f7c91834e87e2","axis":"silent","repo":"pnpm/pnpm","sha":"bab7879385865beb20fbcb91733f7c91834e87e2","parsed":{"files":[{"path":".changeset/warn-unused-overrides.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`pnpm install` now warns when an entry in `overrides` matches no dependency, in a single line such as `2 overrides matched no dependency: foo, parent>child`. Only the overrides declared in the workspace are checked. Overrides added by a config dependency or an `updateConfig` hook are not. Set `warnUnusedOverrides: false` to turn the warning off [#10315](https://github.com/pnpm/pnpm/issues/10315)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks/apply.rs","lines":["@@ -17,6 +17,7 @@ use super::{","     resolve_configured_state_dir,"," };"," use miette::WrapErr;","+use std::collections::HashSet;"," "," struct HookExecutionChanges {","     changed_extra_bin_paths: Option<Vec<PathBuf>>,","@@ -133,6 +134,7 @@ pub(super) fn apply_hook_delta(","         .into_diagnostic()","         .wrap_err(\"deserialize the updateConfig hook result\")?;","     record_explicit_setting_changes(config, &delta, &delta_settings);","+    record_hook_added_overrides(config, input, &delta);","     delta_settings.apply_to(config, base_dir);","     config.apply_cli_registries();","     apply_hook_execution_changes(config, execution_changes, script_shell_deleted);","@@ -352,6 +354,26 @@ fn record_explicit_setting_changes(","     }"," }"," ","+/// Selectors are compared and recorded trimmed, the form the overrides","+/// parser gives them.","+fn record_hook_added_overrides(config: &mut Config, input: &Value, delta: &Value) {","+    let Some(overrides) = delta.get(\"overrides\").and_then(Value::as_object) else {","+        return;","+    };","+    let declared: HashSet<&str> = input","+        .get(\"overrides\")","+        .and_then(Value::as_object)","+        .into_iter()","+        .flat_map(serde_json::Map::keys)","+        .map(|selector| selector.trim())","+        .collect();","+    let added = overrides","+        .keys()","+        .map(|selector| selector.trim())","+        .filter(|selector| !declared.contains(selector));","+    config.hook_added_overrides.extend(added.map(str::to_string));","+}","+"," /// A setting the hook set to null is unset, as it is on pnpm 11, and"," /// resolves to the default pnpm would have chosen. `apply_to` has no value"," /// to apply for it, so each is restored through"],"additions":22,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/tests.rs","lines":["@@ -324,6 +324,26 @@ async fn update_config_records_prefer_frozen_lockfile_as_explicit() {","     }"," }"," ","+#[tokio::test]","+async fn update_config_records_the_overrides_it_adds() {","+    let root = tempfile::tempdir().expect(\"workspace tempdir\");","+    fs::write(root.path().join(\"pnpm-workspace.yaml\"), \"overrides:\\n  declared: 1.0.0\\n\")","+        .expect(\"write workspace settings\");","+    fs::write(","+        root.path().join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.overrides = { ...config.overrides, declared: '2.0.0', ' added ': '1.0.0' }; return config } } }\",","+    )","+    .expect(\"write pnpmfile\");","+    let mut config = Config::default().current::<Host>(root.path()).expect(\"load configuration\");","+","+    run_update_config_hooks::<SilentReporter>(&mut config, root.path()).await","+        .expect(\"run updateConfig hook\");","+","+    assert_eq!(config.hook_added_overrides.iter().collect::<Vec<_>>(), [\"added\"]);","+    assert!(config.declares_override(\"declared\"));","+    assert!(!config.declares_override(\"added\"));","+}","+"," #[tokio::test]"," async fn update_config_lockfile_dir_reanchors_install_paths() {","     let root = tempfile::tempdir().expect(\"workspace tempdir\");"],"additions":20,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -232,6 +232,7 @@ mod unlink;"," mod unpublish;"," mod unresolved_env_var;"," mod unstar_tests;","+mod unused_overrides;"," mod update;"," mod update_changeset;"," mod update_github_actions;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/unused_overrides.rs","lines":["@@ -0,0 +1,129 @@","+//! The warning about `overrides` entries that matched no dependency.","+","+use crate::_utils::pacquet_in;","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::{","+    AddMockedRegistry,","+    CommandTempCwd,","+};","+use std::{","+    fs,","+    path::Path,","+};","+","+const PROD_DEP: &str = \"@pnpm.e2e/foo\";","+const DEV_DEP: &str = \"@pnpm.e2e/bar\";","+const MISSING: &str = \"@pnpm.e2e/missing-pkg\";","+","+/// Write a manifest with one production and one development dependency, and","+/// append `settings` to the `pnpm-workspace.yaml` the mocked registry wrote.","+fn write_fixture(workspace: &Path, settings: &str) {","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"unused-overrides-fixture\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { PROD_DEP: \"100.0.0\" },","+            \"devDependencies\": { DEV_DEP: \"100.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    append_workspace_yaml(workspace, settings);","+}","+","+fn append_workspace_yaml(workspace: &Path, settings: &str) {","+    let path = workspace.join(\"pnpm-workspace.yaml\");","+    let mut yaml = fs::read_to_string(&path).unwrap_or_default();","+    if !yaml.is_empty() && !yaml.ends_with('\\n') {","+        yaml.push('\\n');","+    }","+    yaml.push_str(settings);","+    fs::write(&path, yaml).expect(\"update pnpm-workspace.yaml\");","+}","+","+fn overrides_block() -> String {","+    format!(","+        \"overrides:\\n  \\\"{PROD_DEP}\\\": 100.0.0\\n  \\\"{DEV_DEP}\\\": 100.0.0\\n  \\\"{MISSING}\\\": 1.0.0\\n\",","+    )","+}","+","+#[test]","+fn install_reports_only_the_override_that_matched_no_dependency() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    write_fixture(&workspace, &overrides_block());","+","+    let output = pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let stdout = String::from_utf8_lossy(&output.get_output().stdout);","+    eprintln!(\"STDOUT:\\n{stdout}\\n\");","+","+    assert!(stdout.contains(&format!(\"1 override matched no dependency: {MISSING}\")));","+","+    drop((root, mock_instance));","+}","+","+/// A legacy deploy resolves only the deployed project's production","+/// dependencies, so it cannot tell whether an override matches anything else.","+#[test]","+fn legacy_deploy_reports_no_unused_override() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    write_fixture(&workspace, &overrides_block());","+    append_workspace_yaml(","+        &workspace,","+        \"lockfile: false\\npackages:\\n  - 'packages/*'\\ninjectWorkspacePackages: true\\n\",","+    );","+    let app = workspace.join(\"packages/app\");","+    fs::create_dir_all(&app).expect(\"create packages/app\");","+    fs::write(","+        app.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { PROD_DEP: \"100.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write packages/app/package.json\");","+","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let output = pacquet_in(&workspace)","+        .with_args([\"--filter\", \"app\", \"deploy\", \"--legacy\", \"--prod\", \"deploy\"])","+        .assert()","+        .success();","+    let stdout = String::from_utf8_lossy(&output.get_output().stdout);","+    eprintln!(\"STDOUT:\\n{stdout}\\n\");","+","+    assert!(","+        workspace","+            .join(\"deploy/node_modules\")","+            .join(PROD_DEP)","+            .exists(),","+        \"the deployed project's dependency must be installed\",","+    );","+    assert!(!stdout.contains(\"matched no dependency\"));","+","+    drop((root, mock_instance));","+}"],"additions":129,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/boot_config.rs","lines":["@@ -143,6 +143,16 @@ impl Config {","         config","     }"," ","+    /// Whether the workspace itself declares the `overrides` entry","+    /// `selector`, in `pnpm-workspace.yaml` or a local file it includes.","+    /// An entry a config dependency or an `updateConfig` hook adds is not","+    /// declared by the workspace.","+    #[must_use]","+    pub fn declares_override(&self, selector: &str) -> bool {","+        !self.is_owned_by_config_dependency(\"overrides\")","+            && !self.hook_added_overrides.contains(selector)","+    }","+","     fn is_owned_by_config_dependency(&self, setting: &str) -> bool {","         self.workspace_includes","             .as_ref()"],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/config_types.rs","lines":["@@ -119,6 +119,7 @@ const PNPM_TYPES: &[(&str, bool)] = &[","     (\"publish-wait-timeout\", true),","     (\"recursive-install\", false),","     (\"block-exotic-subdeps\", false),","+    (\"warn-unused-overrides\", false),","     (\"reporter\", false),","     (\"resolution-mode\", false),","     (\"resolve-peers-from-workspace-root\", false),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/config_types/routing.rs","lines":["@@ -60,6 +60,7 @@ pub(super) const PNPM_CONFIG_FILE_KEYS: &[&str] = &[","     \"progress\",","     \"publish-wait-timeout\",","     \"block-exotic-subdeps\",","+    \"warn-unused-overrides\",","     \"registry-supports-time-field\",","     \"reporter\",","     \"resolution-mode\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay/resolution.rs","lines":["@@ -59,6 +59,7 @@ impl WorkspaceSettings {","         json_field!(settings, reader, dedupe_injected_deps, \"DEDUPE_INJECTED_DEPS\");","         json_field!(settings, reader, ignore_compatibility_db, \"IGNORE_COMPATIBILITY_DB\");","         json_field!(settings, reader, block_exotic_subdeps, \"BLOCK_EXOTIC_SUBDEPS\");","+        json_field!(settings, reader, warn_unused_overrides, \"WARN_UNUSED_OVERRIDES\");","         json_field!(settings, reader, verify_store_integrity, \"VERIFY_STORE_INTEGRITY\");","         json_field!(","             settings,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -930,6 +930,11 @@ pub struct Config {","     #[default = true]","     pub block_exotic_subdeps: bool,"," ","+    /// Whether to warn when an entry in `overrides` matches no dependency","+    /// in the resolved tree. The `warnUnusedOverrides` setting; default `true`.","+    #[default = true]","+    pub warn_unused_overrides: bool,","+","     /// Whether to verify each CAFS file's on-disk integrity before reusing it","     /// for an install. When `true` (pnpm's default), the store-index cache","     /// lookup stats each referenced file and re-hashes any whose mtime has","@@ -1571,6 +1576,11 @@ pub struct Config {","     /// [`WorkspaceSettings::overrides`]: crate::workspace_yaml::WorkspaceSettings::overrides","     pub overrides: Option<IndexMap<String, String>>,"," ","+    /// The [`Self::overrides`] selectors that an `updateConfig` hook or a","+    /// config dependency's settings added. The workspace does not declare","+    /// them, so they are not reported when they match no dependency.","+    pub hook_added_overrides: BTreeSet<String>,","+","     /// `packageExtensions` from `pnpm-workspace.yaml`. Maps a","     /// `name[@range]` selector to a partial manifest fragment that","     /// gets merged into every matching package's manifest at"],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/tests/includes.rs","lines":["@@ -214,3 +214,29 @@ fn self_update_ignores_boot_config() {","         Config::new().current_for_self_update::<HostNoHome>(tmp.path()).expect(\"config loads\");","     assert_eq!(config.for_boot().minimum_release_age, Config::default().minimum_release_age);"," }","+","+#[test]","+fn the_workspace_declares_the_overrides_it_or_a_local_file_sets() {","+    let root = load(&[(\"pnpm-workspace.yaml\", \"overrides:\\n  foo: 1.0.0\\n\")]).expect(\"loads\");","+    assert!(root.declares_override(\"foo\"));","+    let included = load(&[","+        (\"pnpm-workspace.yaml\", \"include:\\n  ./overrides.yaml: [overrides]\\n\"),","+        (\"overrides.yaml\", \"overrides:\\n  foo: 1.0.0\\n\"),","+    ])","+    .expect(\"loads\");","+    assert!(included.declares_override(\"foo\"));","+}","+","+#[test]","+fn the_workspace_does_not_declare_the_overrides_of_a_config_dependency() {","+    let root = \"configDependencies:\\n  policy: 1.0.0\\ninclude:\\n  policy: [overrides]\\n\";","+    let config = load_with_policy(root, \"overrides:\\n  foo: 1.0.0\\n\", &[]);","+    assert_eq!(","+        config.overrides","+            .as_ref()","+            .and_then(|overrides| overrides.get(\"foo\"))","+            .map(String::as_str),","+        Some(\"1.0.0\"),","+    );","+    assert!(!config.declares_override(\"foo\"));","+}"],"additions":26,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml.rs","lines":["@@ -345,6 +345,7 @@ macro_rules! identically_named_settings {","