"+// `kNoFpContractAttr`.","+void TagWithNoFpContract(llvm::Function* root) {","+  std::vector<llvm::Function*> worklist = {root};","+  while (!worklist.empty()) {","+    llvm::Function* fn = worklist.back();","+    worklist.pop_back();","+    if (fn->isDeclaration() || fn->hasFnAttribute(llvm_ir::kNoFpContractAttr)) {","+      continue;","+    }","+    fn->addFnAttr(llvm_ir::kNoFpContractAttr);","+    for (llvm::BasicBlock& bb : *fn) {","+      for (llvm::Instruction& inst : bb) {","+        if (auto* call = llvm::dyn_cast<llvm::CallBase>(&inst)) {","+          llvm::Function* callee = call->getCalledFunction();","+          if (callee != nullptr && callee->hasLocalLinkage()) {","+            worklist.push_back(callee);","+          }","+        }","+      }","+    }","+  }","+}","+"," // Wraps `body`, whose host C ABI signature returns through sret and/or takes"," // arguments through pointers, in a function of the requested value signature."," llvm::Function* CreateDirectAdapter(llvm::Module* module, llvm::Function* body,","@@ -211,6 +238,7 @@ llvm::Function* GetCppGenFunction(llvm::Module* module, absl::string_view name,","   if (func->isDeclaration()) {","     return func;","   }","+  TagWithNoFpContract(func);","   if (func->getFunctionType() != type) {","     return CreateDirectAdapter(module, func, type);","   }","@@ -307,10 +335,13 @@ void CppGenIntrinsicLibrary::LinkIntoModule(llvm::Module& dst_module) const {","   std::vector<std::string> lib_functions;","   // The linker merges same-named symbols regardless of signature.","   std::vector<std::pair<llvm::Function*, std::string>> mismatched_decls;","-  for (const auto& func : *lib_module) {","+  for (llvm::Function& func : *lib_module) {","     if (func.isDeclaration()) {","       continue;","     }","+    // Tag before linking so colliding internal helpers renamed by the linker","+    // keep the attribute and pre-existing destination functions are untouched.","+    func.addFnAttr(llvm_ir::kNoFpContractAt