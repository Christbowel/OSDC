2(<4 x float> %a, <4 x float> %b, <4 x float> %neg_p)","+      %diff = fsub <4 x float> %n, %p","+      %out = fadd <4 x float> %diff, %err","+      ret <4 x float> %out","+    }","+  )\";","+  constexpr absl::string_view kKernel = R\"(","+    declare <4 x float> @xla.two_prod.v4f32(<4 x float>, <4 x float>, <4 x float>)","+","+    define <4 x float> @kernel(<4 x float> %a, <4 x float> %b, <4 x float> %c) {","+      %caller_mul = fmul <4 x float> %a, %b","+      %caller_add = fadd <4 x float> %caller_mul, %c","+      %res = call <4 x float> @xla.two_prod.v4f32(<4 x float> %caller_add, <4 x float> %c, <4 x float> %a)","+      ret <4 x float> %res","+    }","+  )\";","+","+  llvm::LLVMContext context;","+  std::unique_ptr<llvm::Module> module =","+      ParseEmbeddedBitcode(context, std::string(kKernel));","+  CppGenIntrinsicLibrary(std::string(kLib), \"lib\").LinkIntoModule(*module);","+  EXPECT_FALSE(llvm::verifyModule(*module, &llvm::errs()));","+","+  llvm::Function* linked = module->getFunction(\"xla.two_prod.v4f32\");","+  ASSERT_NE(linked, nullptr);","+  EXPECT_TRUE(linked->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+","+  xla::llvm_ir::SetAllowContractOnFpArithmetic(*module);","+  intrinsic::RunInlineAndOptPasses(*module);","+  EXPECT_FALSE(llvm::verifyModule(*module, &llvm::errs()));","+  EXPECT_EQ(module->getFunction(\"xla.two_prod.v4f32\"), nullptr);","+","+  llvm::Function* kernel = module->getFunction(\"kernel\");","+  ASSERT_NE(kernel, nullptr);","+  EXPECT_FALSE(kernel->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+","+  int caller_fp_ops = 0;","+  int cppgen_fp_ops = 0;","+  for (const llvm::BasicBlock& bb : *kernel) {","+    for (const llvm::Instruction& inst : bb) {","+      const unsigned opcode = inst.getOpcode();","+      if (opcode != llvm::Instruction::FAdd &&","+          opcode != llvm::Instruction::FSub &&","+          opcode != llvm::Instruction::FMul) {","+        continue;","+      }","+      if (inst.getName().starts_with(\"caller_\")) {","+        ++caller_fp_ops;","+        EXPECT_TRUE(inst.hasAllowContract())","+            << xla::llvm_ir::DumpToString(&inst);","+      } else {","+        ++cppgen_fp_ops;","+        EXPECT_FALSE(inst.hasAllowContract())","+            << xla::llvm_ir::DumpToString(&inst);","+      }","+    }","+  }","+  EXPECT_EQ(caller_fp_ops, 2) << xla::llvm_ir::DumpToString(kernel);","+  EXPECT_EQ(cppgen_fp_ops, 3) << xla::llvm_ir::DumpToString(kernel);","+}","+","+TEST(CppGenIntrinsicsTest,","+     AdaptedBodyAndCollidingInternalHelperKeepNoFpContract) {","+  constexpr absl::string_view kLib = R\"(","+    define internal <4 x float> @helper(<4 x float> %a, <4 x float> %b) noinline {","+      %lib_mul = fmul <4 x float> %a, %b","+      ret <4 x float> %lib_mul","+    }","+","+    define void @xla.adapted.v4f32(ptr sret(<4 x float>) align 16 %out, ptr %p) {","+      %x = load <4 x float>, ptr %p, align 16","+      %h = call <4 x float> @helper(<4 x float> %x, <4 x float> %x)","+      %lib_sub = fsub <4 x float> %x, %h","+      store <4 x float> %lib_sub, ptr %out, align 16","+      ret void","+    }","+  )\";","+  constexpr absl::string_view kKernel = R\"(","+    declare <4 x float> @xla.adapted.v4f32(<4 x float>)","+","+    define internal <4 x float> @helper(<4 x float> %a, <4 x float> %b) noinline {","+      %dst_add = fadd <4 x float> %a, %b","+      ret <4 x float> %dst_add","+    }","+","+    define <4 x float> @kernel(<4 x float> %a, <4 x float> %b) {","+      %caller_h = call <4 x float> @helper(<4 x float> %a, <4 x float> %b)","+      %res = call <4 x float> @xla.adapted.v4f32(<4 x float> %caller_h)","+      ret <4 x float> %res","+    }","+  )\";","+","+  llvm::LLVMContext context;","+  std::unique_ptr<llvm::Module> module =","+      ParseEmbeddedBitcode(context, std::string(kKernel));","+  CppGenIntrinsicLibrary(std::string(kLib), \"lib\").LinkIntoModule(*module);","+  EXPECT_FALSE(llvm::verifyModule(*module, &llvm::errs()));","+","+  llvm::Function* dst_helper = module->getFunction(\"helper\");","+  ASSERT_NE(dst_helper, nullptr);","+  EXPECT_FALSE(dst_helper->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+","+  llvm::Function* adapted_body = module->getFunction(\"xla.adapted.v4f32.body\");","+  ASSERT_NE(adapted_body, nullptr);","+  EXPECT_TRUE(adapted_body->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+","+  // Find the colliding internal helper renamed by the linker.","+  llvm::Function* lib_helper = nullptr;","+  for (llvm::Function& fn : *module) {","+    if (fn.getName().starts_with(\"helper.\")) {","+      lib_helper = &fn;","+      break;","+    }","+  }","+  ASSERT_NE(lib_helper, nullptr) << xla::llvm_ir::DumpToString(module.get());","+  EXPECT_TRUE(lib_helper->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+","+  xla::llvm_ir::SetAllowContractOnFpArithmetic(*module);","+  intrinsic::RunInlineAndOptPasses(*module);","+  EXPECT_FALSE(llvm::verifyModule(*module, &llvm::errs()));","+","+  for (const llvm::BasicBlock& bb : *dst_helper) {","+    for (const llvm::Instruction& inst : bb) {","+      if (inst.getOpcode() == llvm::Instruction::FAdd) {","+        EXPECT_TRUE(inst.hasAllowContract())","+            << xla::llvm_ir::DumpToString(&inst);","+      }","+    }","+  }","+  for (const llvm::BasicBlock& bb : *lib_helper) {","+    for (const llvm::Instruction& inst : bb) {","+      if (inst.getOpcode() == llvm::Instruction::FMul) {","+        EXPECT_FALSE(inst.hasAllowContract())","+            << xla::llvm_ir::DumpToString(&inst);","+      }","+    }","+  }","+  llvm::Function* kernel = module->getFunction(\"kernel\");","+  ASSERT_NE(kernel, nullptr);","+  int kernel_fsubs = 0;","+  for (const llvm::BasicBlock& bb : *kernel) {","+    for (const llvm::Instruction& inst : bb) {","+      if (inst.getOpcode() == llvm::Instruction::FSub) {","+        ++kernel_fsubs;","+        EXPECT_FALSE(inst.hasAllowContract())","+            << xla::llvm_ir::DumpToString(&inst);","+      }","+    }","+  }","+  EXPECT_EQ(kernel_fsubs, 1) << xla::llvm_ir::DumpToString(kernel);","+}","+","+TEST(CppGenIntrinsicsTest, GetCppGenFunctionTagsReachableInternalCallees) {","+  constexpr absl::string_view kBitcode = R\"(","+    define internal <4 x float> @helper(<4 x float> %a, <4 x float> %b, <4 x float> %c) noinline {","+      %p = fmul <4 x float> %a, %b","+      %s = fadd <4 x float> %p, %c","+      ret <4 x float> %s","+    }","+","+    define <4 x float> @xla.fn.v4f32(<4 x float> %a, <4 x float> %b, <4 x float> %c) {","+      %r = call <4 x float> @helper(<4 x float> %a, <4 x float> %b, <4 x float> %c)","+      ret <4 x float> %r","+    }","+  )\";","+","+  llvm::LLVMContext context;","+  std::unique_ptr<llvm::Module> module =","+      ParseEmbeddedBitcode(context, std::string(kBitcode));","+  llvm::Type* v4f32 = VecF32(context, 4);","+  llvm::FunctionType* fn_type =","+      llvm::FunctionType::get(v4f32, {v4f32, v4f32, v4f32}, /*isVarArg=*/false);","+","+  llvm::Function* fn = GetCppGenFunction(module.get(), \"xla.fn.v4f32\", fn_type);","+  ASSERT_NE(fn, nullptr);","+  EXPECT_TRUE(fn->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+","+  xla::llvm_ir::SetAllowContractOnFpArithmetic(*module);","+","+  llvm::Function* helper = module->getFunction(\"helper\");","+  ASSERT_NE(helper, nullptr);","+  EXPECT_TRUE(helper->hasFnAttribute(xla::llvm_ir::kNoFpContractAttr));","+  for (const llvm::BasicBlock& bb : *helper) {","+    for (const llvm::Instruction& inst : bb) {","+      if (inst.getOpcode() == llvm::Instruction::FMul ||","+          inst.getOpcode() == llvm::Instruction::FAdd) {","+        EXPECT_FALSE(inst.hasAllowContract())","+            << xla::llvm_ir::DumpToString(&inst);","+      }","+    }","+  }","+}","+"," }  // namespace"," }  // namespace xla::codegen"],"additions":207,"deletions":6,"truncated":false},{"path":"third_party/xla/xla/codegen/intrinsic/simple_jit_runner.cc","lines":["@@ -99,9 +99,9 @@ JitRunner::JitRunner(std::unique_ptr<llvm::Module> module,","         llvm::Twine(llvm::toString(jit_or_err.takeError())));","   }","   jit_ = std::move(jit_or_err.get());","-  // Match what production XLA:CPU codegen does as the last step of","-  // `IrCompiler::RunIrPasses`, so that accuracy tests measure the contracted","-  // (FMA-fused) code that actually ships rather than an unfused variant.","+  // Match what production XLA:CPU codegen does in `IrCompiler::RunIrPasses`, so","+  // that handwritten-IR accuracy tests measure contracted (FMA-fused) code","+  // while CppGen bitcode functions tagged with `kNoFpContractAttr` are skipped.","   llvm_ir::SetAllowContractOnFpArithmetic(*module);","   llvm::orc::ThreadSafeModule tsm(std::move(module), *tsc_);","   llvm::ExitOnError exit_on_err;"],"additions":3,"deletions":3,"truncated":false},{"path":"third_party/xla/xla/service/cpu/tests/cpu_vectorization_test.cc","lines":["@@ -460,7 +460,7 @@ TEST_F(Avx512JitVectorizationTest, Expm1F32) {","   }"," ","   std::string check_lines =","-      absl::StrFormat(\"CHECK: fmul contract <%d x float>\", num_elements);","+      absl::StrFormat(\"CHECK: fmul <%d x float>\", num_elements);"," ","   ASSERT_OK(CompileAndVerifyIr(llvm_compiler, compile_options,","                                std::move(hlo_module), check_lines,"],"additions":1,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/service/llvm_ir/llvm_util.cc","lines":["@@ -546,6 +546,9 @@ llvm::FastMathFlags GetCpuFastMathFlags(const HloModuleConfig& module_config) {"," "," void SetAllowContractOnFpArithmetic(llvm::Module& module) {","   for (llvm::Function& function : module) {","+    if (function.hasFnAttribute(kNoFpContractAttr)) {","+      continue;","+    }","     for (llvm::Instruction& instruction : llvm::instructions(function)) {","       const unsigned opcode = instruction.getOpcode();","       if (opcode == llvm::Instruction::FAdd ||"],"additions":3,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/service/llvm_ir/llvm_util.h","lines":["@@ -219,19 +219,33 @@ void SetToLastInsertPoint(llvm::BasicBlock* blk, llvm::IRBuilderBase* builder);"," // module config."," llvm::FastMathFlags GetCpuFastMathFlags(const HloModuleConfig& module_config);"," ","+// Function attribute marking bitcode functions (such as CppGen / YNNPACK","+// intrinsics) whose explicit FMA / non-FMA rounding boundaries must not be","+// altered by `SetAllowContractOnFpArithmetic`.","+inline constexpr absl::string_view kNoFpContractAttr = \"xla_no_fp_contract\";","+"," // Sets the `contract` fast-math flag on every floating-point add, subtract and","-// multiply in `module`.","+// multiply in `module`, skipping functions carrying `kNoFpContractAttr`."," //"," // Upstream LLVM is removing `TargetOptions::AllowFPOpFusion` as a global gate"," // on FMA formation, and XLA:CPU depends on that gate for all of its"," // contraction; the per-instruction flag is the replacement."," //","-// Callers must run this as the last IR mutation before machine-code emission,","-// because middle-end passes read `contract` and change what they do when it is","-// set: InstCombine folds `tan(x) * cos(x)` to `sin(x)` for a contractable fmul","-// (InstCombineMulDivRem.cpp:1116), and Reassociate keeps a contractable","-// fadd/fmul pair together as a leaf instead of linearizing it into the","-// surrounding expression tree (Reassociate.cpp:191).","+// Long term, XLA:CPU emitters and handwritten intrinsics should emit explicit","+// `@llvm.fma` (or opt into `contract` when emitting IR) so that","+// `SetAllowContractOnFpArithmetic` and `kNoFpContractAttr` can be removed; see","+// b/560320144.","+//","+// Callers must run this after the main optimization pipeline (because","+// middle-end passes read `contract` and change what they do when it is set:","+// InstCombine folds `tan(x) * cos(x)` to `sin(x)` for a contractable fmul at","+// InstCombineMulDivRem.cpp:1127, and Reassociate keeps a contractable","+// fadd/fmul pair together as a leaf instead of linearizing it at","+// Reassociate.cpp:191) and before inlining functions tagged with","+// `kNoFpContractAttr`. Post-inline cleanup passes (`InstCombine`, `EarlyCSE`)","+// in `RunInlineAndOptPasses` do see `contract` on caller instructions; this is","+// accepted because `EarlyCSE` intersects flags and inner tagged-callee","+// expressions carry no `contract` flag."," void SetAllowContractOnFpArithmetic(llvm::Module& module);"," "," // Moves every single-use `fmul contract` to immediately before its"],"additions":21,"deletions":7,"truncated":false},{"path":"third_party/xla/xla/service/llvm_ir/llvm_util_test.cc","lines":["@@ -76,6 +76,46 @@ TEST(CloneModuleToContextTest, ClonesIntoDestinationContext) {","   EXPECT_EQ(DumpToString(*f), DumpToString(*src->getFunction(\"f\")));"," }"," ","+TEST(SetAllowContractOnFpArithmeticTest, SkipsFunctionsWithNoFpContractAttr) {","+  llvm::LLVMContext context;","+  llvm::SMDiagnostic diagnostic;","+  std::unique_ptr<llvm::Module> module =","+      llvm::parseAssemblyString(R\"(","+    define float @contractable(float %a, float %b, float %c) {","+      %mul = fmul float %a, %b","+      %add = fadd float %mul, %c","+      %sub = fsub float %add, %a","+      %div = fdiv float %sub, %b","+      ret float %div","+    }","+    define float @uncontractable(float %a, float %b, float %c) {","+      %mul = fmul float %a, %b","+      %add = fadd float %mul, %c","+      %sub = fsub float %add, %a","+      ret float %sub","+    }","+  )\",","+                                diagnostic, context);","+  ASSERT_NE(module, nullptr) << diagnostic.getMessage().str();","+","+  llvm::Function* contractable = module->getFunction(\"contractable\");","+  llvm::Function* uncontractable = module->getFunction(\"uncontractable\");","+  ASSERT_NE(contractable, nullptr);","+  ASSERT_NE(uncontractable, nullptr);","+  uncontractable->addFnAttr(kNoFpContractAttr);","+","+  SetAllowContractOnFpArithmetic(*module);","+","+  EXPECT_TRUE(FindInstruction(*contractable, \"mul\")->hasAllowContract());","+  EXPECT_TRUE(FindInstruction(*contractable, \"add\")->hasAllowContract());","+  EXPECT_TRUE(FindInstruction(*contractable, \"sub\")->hasAllowContract());","+  EXPECT_FALSE(FindInstruction(*contractable, \"div\")->hasAllowContract());","+","+  EXPECT_FALSE(FindInstruction(*uncontractable, \"mul\")->hasAllowContract());","+  EXPECT_FALSE(FindInstruction(*uncontractable, \"add\")->hasAllowContract());","+  EXPECT_FALSE(FindInstruction(*uncontractable, \"sub\")->hasAllowContract());","+}","+"," struct SinkFMulTestCase {","   std::string test_name;","   std::string ir;",""],"additions":40,"deletions":0,"truncated":false}],"additions":396,"deletions":24,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-25T18:24:32.056197+00:00"}