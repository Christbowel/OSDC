llvm::Function& fn, bool expected_contract,","+                              int min_ops) {","+    int count = 0;","+    for (const llvm::Instruction& inst : llvm::instructions(fn)) {","+      const unsigned opcode = inst.getOpcode();","+      if (opcode == llvm::Instruction::FAdd ||","+          opcode == llvm::Instruction::FSub ||","+          opcode == llvm::Instruction::FMul) {","+        ++count;","+        EXPECT_EQ(inst.hasAllowContract(), expected_contract)","+            << fn.getName().str() << \": \" << llvm_ir::DumpToString(&inst);","+      }","+    }","+    EXPECT_GE(count, min_ops) << llvm_ir::DumpToString(&fn);","+  };","+","+  IrCompiler::CompilationHooks hooks;","+  hooks.post_optimization = [&](const llvm::Module& module) {","+    post_opt_called = true;","+    const llvm::Function* caller = module.getFunction(\"caller_fp\");","+    const llvm::Function* handwritten =","+        module.getFunction(\"handwritten_intrinsic\");","+    const llvm::Function* cppgen = module.getFunction(\"cppgen_intrinsic\");","+    ASSERT_NE(caller, nullptr);","+    ASSERT_NE(handwritten, nullptr);","+    ASSERT_NE(cppgen, nullptr);","+","+    check_fp_contract(*caller, /*expected_contract=*/true, /*min_ops=*/2);","+    check_fp_contract(*handwritten, /*expected_contract=*/true, /*min_ops=*/1);","+    check_fp_contract(*cppgen, /*expected_contract=*/false, /*min_ops=*/1);","+    EXPECT_FALSE(cppgen->hasFnAttribute(llvm_ir::kNoFpContractAttr));","+  };","+","+  llvm::LLVMContext context;","+  std::unique_ptr<IrCompiler> ir_compiler = IrCompiler::Create(","+      llvm::TargetOptions(),","+      IrCompiler::Options{/*opt_level=*/llvm::CodeGenOptLevel::Aggressive,","+                          /*optimize_for_size=*/false,","+                          TargetMachineOptions(GetDebugOptionsFromFlags())},","+      hooks);","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<llvm::Module> ir_module,","+                       ParseModule(context, kIr, \"cppgen_contract_module\"));","+  AS