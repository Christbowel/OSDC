&Path) -> miette::Result<Self> {","+        let catalogs = configured_catalogs(config)?;","+        let rewriter = configured_overrides_rewriter(config, &catalogs, prefix)?;","+        Ok(LinkedEdgesConfig { catalogs, rewriter })","+    }","+","+    pub(super) fn edges<'a>(&'a self, config: &'a Config) -> LinkedEdges<'a> {","+        LinkedEdges {","+            catalogs: workspace_catalogs(config, &self.catalogs),","+            rewriter: self.rewriter.as_ref(),","+        }","+    }","+}","+","+/// Keeps the edges whose specifier is `link:` once `overrides` and","+/// `catalog:` are applied, the way the project's install reads it.","+pub(super) struct LinkedEdges<'a> {","+    catalogs: Option<WorkspaceCatalogs<'a>>,","+    rewriter: Option<&'a VersionsOverrider>,","+}","+","+impl LinkedEdges<'_> {","+    /// The members of `deps`, the graph edges of the project at `parent_dir`,","+    /// that the project links to.","+    pub(super) fn retain<'graph>(","+        &self,","+        parent_dir: &Path,","+        pkg: GraphPkg<'_>,","+        deps: &'graph [PathBuf],","+    ) -> Vec<&'graph Path> {","+        if deps.is_empty() {","+            return Vec::new();","+        }","+        let linked = self.linked_dependency_dirs(parent_dir, pkg);","+        deps.iter()","+            .map(PathBuf::as_path)","+            .filter(|dep_dir| linked.contains(&lexical_normalize(dep_dir)))","+            .collect()","+    }","+","+    fn linked_dependency_dirs(","+        &self,","+        parent_dir: &Path,","+        pkg: GraphPkg<'_>,","+    ) -> rustc_hash::FxHashSet<PathBuf> {","+        let mut groups = pkg.dependency_groups(false);","+        if let Some(rewriter) = self.rewriter {","+            rewriter.rewrite_dependencies(&pkg, &mut groups);","+        }","+        let DependencyGroups { peer, dev, optional, prod } = groups;","+        [peer, dev.unwrap_or_default(), optional, prod]","+            .into_iter()","+            .flatten()","+            .filter_map(|(dep_name, spec)| {","+                let resolved = resolve_catalog_spec(parent_dir, &dep_name, &spec, self.catalogs);","+                let rel = resolved","+                    .as_deref()","+                    .unwrap_or(&spec)","+                    .strip_prefix(\"link:\")?;","+                Some(lexical_normalize(&parent_dir.join(rel.replace('\\\\', \"/\"))))","+            })","+            .collect()","+    }","+}","+","+fn resolve_catalog_spec(","+    consumer_dir: &Path,","+    dep_name: &str,","+    raw_spec: &str,","+    catalogs: Option<WorkspaceCatalogs<'_>>,","+) -> Option<String> {","+    let catalogs = catalogs?;","+    if !raw_spec.starts_with(\"catalog:\") {","+        return None;","+    }","+    let wanted =","+        WantedDependency { alias: dep_name.to_string(), bare_specifier: raw_spec.to_string() };","+    let anchor = CatalogAnchor::Reanchor {","+        workspace_dir: catalogs.workspace_dir,","+        consumer_dir: Some(consumer_dir),","+    };","+    match resolve_from_catalog(catalogs.catalogs, &wanted, anchor) {","+        CatalogResolutionResult::Found(found) => Some(found.resolution.specifier),","+        CatalogResolutionResult::Misconfiguration(_) | CatalogResolutionResult::Unused => None,","+    }","+}"],"additions":112,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/recursive/tests.rs","lines":["@@ -357,6 +357,89 @@ fn projects_to_verify_under_dedicated_lockfiles_with_injection_follows_only_link","     assert_eq!(verified, expected);"," }"," ","+#[test]","+fn projects_to_verify_under_dedicated_lockfiles_with_injection_follows_link_edges_from_overrides() {","+    let tmp = tempfile::tempdir().unwrap();","+    let write_project = |name: &str, json: &str| {","+        let dir = tmp.path().join(name);","+        fs::create_dir_all(&dir).unwrap();","+        let manifest_path = dir.join(\"package.json\");","+        fs::write(&manifest_path, json).unwrap();","+        Project {","+            root_dir: dir,","+            manifest: PackageManifest::from_path(manifest_path).unwrap(),","+            dependency_manifest: None,","+        }","+    };","+    let app = write_project(","+        \"app\",","+        r#\"{\"name\":\"app\",\"version\":\"1.0.0\",\"dependencies\":{\"injected\":\"workspace:*\",\"lib\":\"^1.0.0\"}}\"#,","+    );","+    let injected = write_project(\"injected\", r#\"{\"name\":\"injected\",\"version\":\"1.0.0\"}\"#);","+    let lib = write_project(\"lib\", r#\"{\"name\":\"lib\",\"version\":\"1.0.0\"}\"#);","+    let leaf =","+        |project| ProjectGraphNode { package: GraphPkg { project }, dependencies: Vec::new() };","+    let all: ProjectGraph<GraphPkg<'_>> = [","+        (","+            app.root_dir.clone(),","+            ProjectGraphNode {","+                package: GraphPkg { project: &app },","+                dependencies: vec![injected.root_dir.clone(), lib.root_dir.clone()],","+            },","+        ),","+        (injected.root_dir.clone(), leaf(&injected)),","+        (lib.root_dir.clone(), leaf(&lib)),","+    ]","+    .into_iter()","+    .collect();","+    let selected = std::iter::once((app.root_dir.clone(), all[&app.root_dir].clone())).collect();","+    let selection = RecursiveSelection {","+        selected,","+        all: Some(all),","+        prod_all: None,","+        prod_only_selected: HashSet::new(),","+    };","+    let config = Config {","+        verify_deps_before_run: VerifyDepsBeforeRun::Error,","+        shared_workspace_lockfile: false,","+        inject_workspace_packages: true,","+        workspace_dir: Some(tmp.path().to_path_buf()),","+        overrides: Some(std::iter::once((\"lib\".to_string(), \"link:./lib\".to_string())).collect()),","+        ..Config::default()","+    };","+","+    let mut verified =","+        projects_to_verify([app.root_dir.as_path()], &selection, &config, tmp.path()).unwrap();","+    verified.sort();","+    let mut expected = vec![app.root_dir, lib.root_dir];","+    expected.sort();","+    assert_eq!(verified, expected);","+}","+","+#[test]","+fn projects_to_verify_reports_an_invalid_override() {","+    let tmp = tempfile::tempdir().unwrap();","+    let selection = RecursiveSelection {","+        selected: ProjectGraph::default(),","+        all: Some(ProjectGraph::default()),","+        prod_all: None,","+        prod_only_selected: HashSet::new(),","+    };","+    let config = Config {","+        verify_deps_before_run: VerifyDepsBeforeRun::Error,","+        shared_workspace_lockfile: false,","+        inject_workspace_packages: true,","+        workspace_dir: Some(tmp.path().to_path_buf()),","+        overrides: Some(","+            std::iter::once((\"lib\".to_string(), \"catalog:missing\".to_string())).collect(),","+        ),","+        ..Config::default()","+    };","+","+    let error = projects_to_verify([tmp.path()], &selection, &config, tmp.path()).unwrap_err();","+    assert!(format!(\"{error:?}\").contains(\"parsing the overrides\"), \"{error:?}\");","+}","+"," #[test]"," fn select_recursive_projects_combines_filter_prod_with_regular_exclusion() {","     let tmp = tempfile::tempdir().unwrap();"],"additions":83,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -236,6 +236,7 @@ mod update_notifier;"," mod update_recursive;"," mod verify_deps_before_run;"," mod verify_deps_before_run_failed_install;","+mod verify_deps_before_run_overrides;"," mod verify_jsr;"," mod version;"," mod view;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/verify_deps_before_run_overrides.rs","lines":["@@ -0,0 +1,82 @@","+//! The `verify-deps-before-run` gate with `overrides` that point a","+//! dependency at a workspace project.","+","+use crate::_utils::pacquet_in;","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::{AddMockedRegistry, CommandTempCwd};","+use serde_json::json;","+use std::fs;","+","+/// Under dedicated lockfiles with `injectWorkspacePackages`, a dependency an","+/// override turns into `link:` is a symlink, as a declared `link:` is, so its","+/// target project must be installed.","+#[test]","+fn filtered_exec_holds_a_link_override_under_dedicated_lockfiles_with_injection() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    fs::write(","+        workspace.join(\"package.json\"),","+        json!({ \"name\": \"workspace-root\", \"version\": \"0.0.0\" }).to_string(),","+    )","+    .expect(\"write root package.json\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"sharedWorkspaceLockfile: false\\ninjectWorkspacePackages: true\\npackages:\\n  - packages/*\\noverrides:\\n  baz: link:./packages/baz\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    let projects =","+        [(\"foo\", json!({ \"baz\": \"^1.0.0\" })), (\"baz\", json!({ \"@pnpm.e2e/foo\": \"100.0.0\" }))];","+    for (name, dependencies) in projects {","+        let project = workspace.join(\"packages\").join(name);","+        fs::create_dir_all(&project).expect(\"create workspace project\");","+        let manifest = json!({ \"name\": name, \"version\": \"1.0.0\", \"dependencies\": dependencies });","+        fs::write(project.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+    }","+","+    pacquet_in(&workspace)","+        .with_args([\"--filter\", \"foo\", \"install\"])","+        .assert()","+        .success();","+    assert!(!workspace.join(\"packages/baz/node_modules\").exists());","+","+    let exec = |action: &str, script: &str| {","+        pacquet_in(&workspace)","+            .with_args([","+                &format!(\"--config.verify-deps-before-run={action}\"),","+                \"--filter\",","+                \"foo\",","+                \"exec\",","+                \"node\",","+                \"-e\",","+                script,","+            ])","+            .output()","+            .expect(\"spawn pacquet exec\")","+    };","+","+    let output = exec(\"error\", \"0\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(","+        !output.status.success() && stderr.contains(\"ERR_PNPM_VERIFY_DEPS_BEFORE_RUN\"),","+        \"a never-installed link: override target must fail the verify-deps check:\\n{stderr}\",","+    );","+","+    let output = exec(\"install\", r#\"process.stdout.write(\"linked-ok\")\"#);","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(","+        output.status.success(),","+        \"the filtered exec must install the link: override target:\\n{stderr}\",","+    );","+    assert_eq!(String::from_utf8_lossy(&output.stdout), \"linked-ok\");","+    assert!(","+        workspace.join(\"packages/baz/node_modules/@pnpm.e2e/foo\").exists(),","+        \"the gate must install the link: override target:\\n{stderr}\",","+    );","+","+    let output = exec(\"error\", \"0\");","+    assert!(output.status.success(), \"{}\", String::from_utf8_lossy(&output.stderr));","+","+    drop((root, mock_instance));","+}"],"additions":82,"deletions":0,"truncated":false},{"path":"pnpm11/exec/commands/package.json","lines":["@@ -66,6 +66,7 @@","     \"@pnpm/workspace.injected-deps-syncer\": \"workspace:*\",","     \"@pnpm/workspace.project-manifest-reader\": \"workspace:*\",","     \"@pnpm/workspace.projects-filter\": \"workspace:*\",","+    \"@pnpm/workspace.projects-graph\": \"workspace:*\",","     \"@pnpm/workspace.projects-reader\": \"workspace:*\",","     \"@pnpm/workspace.projects-sorter\": \"workspace:*\",","     \"@pnpm/workspace.task-scheduler\": \"workspace:*\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm11/exec/commands/src/selectProjectsToVerify.ts","lines":["@@ -1,20 +1,26 @@"," import path from 'node:path'"," "," import type { Config, ConfigContext 