rn { status: 'out_of_range' }","+","+  return {","+    status: 'ok',","+    startDate,","+    endDate,","+    interval: getWarehouseMetricsInterval(startDate, endDate),","+    isClamped: isStartTooEarly || isEndInFuture,","+  }","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/Observability/Warehouse/WarehouseMetricsReport.platform.test.tsx","lines":["@@ -1,6 +1,8 @@"," import { QueryClient } from '@tanstack/react-query'","-import { screen } from '@testing-library/react'","+import { screen, waitFor } from '@testing-library/react'","+import userEvent from '@testing-library/user-event'"," import type { platformComponents as components } from 'api-types'","+import dayjs from 'dayjs'"," import { HttpResponse } from 'msw'"," import { beforeEach, expect, test, vi } from 'vitest'"," ","@@ -67,15 +69,22 @@ const renderReport = (enabled = true) => {","   const queryClient = new QueryClient({","     defaultOptions: { queries: { retry: false, staleTime: Infinity } },","   })","+  queryClient.setQueryData(['warehouse-configcat-flag', 'default'], enabled ? ['free-org'] : [])","   queryClient.setQueryData(projectKeys.detail('default'), { organization_id: 1 })","-  queryClient.setQueryData(organizationKeys.list(), [{ id: 1, slug: 'warehouse-org' }])","-  queryClient.setQueryData(","-    ['warehouse-configcat-flag', 'default'],","-    enabled ? ['warehouse-org'] : []","-  )","-  return customRender(<WarehouseMetricsReport />, { queryClient })","+  queryClient.setQueryData(organizationKeys.list(), [","+    { id: 1, slug: 'free-org', plan: { id: 'free' } },","+  ])","+  queryClient.setQueryData(organizationKeys.entitlements('free-org'), {","+    entitlements: [","+      {","+        feature: { key: 'log.retention_days' },","+        type: 'numeric',","+        config: { enabled: true, unlimited: false, value: 1 },","+      },","+    ],","+  })","+  return customRender(<WarehouseMetricsReport />, { queryClient, nuqs: { hasMemory: true } 