{"id":"75cbfc55bb7e4c3dcf678f4dca8df0cfde10e7b3","axis":"silent","repo":"NativeScript/NativeScript","sha":"75cbfc55bb7e4c3dcf678f4dca8df0cfde10e7b3","parsed":{"files":[{"path":"apps/toolbox/src/main-page.xml","lines":["@@ -22,6 +22,8 @@","         <Button text=\"list-page-sticky\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","         <Button text=\"list-page-sticky-templates\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","         <Button text=\"multiple-scenes\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","+        <Button text=\"nested-tab-frame\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","+        <Button text=\"nested-tab-frame-4tabs\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","         <Button text=\"root-layout\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","         <Button text=\"scroll-view\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />","         <Button text=\"sliders\" tap=\"{{ viewDemo }}\" class=\"btn btn-primary btn-view-demo\" />"],"additions":2,"deletions":0,"truncated":false},{"path":"apps/toolbox/src/pages/nested-tab-frame-4tabs.ts","lines":["@@ -0,0 +1,6 @@","+import { EventData, Page } from '@nativescript/core';","+import { setupPage } from './nested-tab-frame-shared';","+","+export function navigatingTo(args: EventData) {","+\tsetupPage(<Page>args.object, { tabCount: 4 });","+}"],"additions":6,"deletions":0,"truncated":false},{"path":"apps/toolbox/src/pages/nested-tab-frame-4tabs.xml","lines":["@@ -0,0 +1,6 @@","+<Page xmlns=\"http://schemas.nativescript.org/tns.xsd\" navigatingTo=\"navigatingTo\" class=\"page\">","+    <Page.actionBar>","+        <ActionBar title=\"Nested Tab Frame (4 tabs)\" icon=\"\" class=\"action-bar\">","+        </ActionBar>","+    </Page.actionBar>","+</Page>"],"additions":6,"deletions":0,"truncated":false},{"path":"apps/toolbox/src/pages/nested-tab-frame-shared.ts","lines":["@@ -0,0 +1,168 @@","+import { Button, Frame, Label, Page, ScrollView, StackLayout, TabView, TabViewItem, Trace } from '@nativescript/core';","+","+/**","+ * Playground for a Frame hosted as a TabViewItem view (issue #11444): every tab frame mounts","+ * its first page in `loaded`, and the inner pages expose the navigation and frame-stack","+ * probes used to reproduce the reported stalls.","+ */","+export interface NestedTabFrameOptions {","+\ttabCount: number;","+\tandroidOffscreenTabLimit?: number;","+}","+","+const TITLES = ['Home', 'Demos', 'Third', 'Fourth'];","+","+export const registry = { tabView: null as TabView, frames: [] as Frame[] };","+","+export function log(msg: string) {","+\tconsole.log(`[NTF] ${msg}`);","+}","+","+export function describe(frame: Frame): string {","+\tconst f = frame as any;","+\treturn `isLoaded=${frame.isLoaded} current=${frame.currentPage ? frame.currentPage.id : null} backStack=${frame.backStack.length} executing=${!!f._executingContext} queue=${f._navigationQueue.length} inStack=${f._isInFrameStack}`;","+}","+","+export function makePage(frame: Frame, depth: number): Page {","+\tconst page = new Page();","+\tpage.id = `${frame.id}-page${depth}`;","+\tpage.actionBarHidden = true;","+\tconst stack = new StackLayout();","+\tstack.className = 'p-20';","+","+\tconst label = new Label();","+\tlabel.text = `${page.id}`;","+\tlabel.className = 'h2 text-center';","+\tstack.addChild(label);","+","+\tconst addButton = (text: string, cls: string, onTap: () => void) => {","+\t\tconst btn = new Button();","+\t\tbtn.text = text;","+\t\tbtn.className = cls;","+\t\tbtn.on('tap', onTap);","+\t\tstack.addChild(btn);","+\t};","+","+\taddButton(`Push page ${depth + 1}`, 'btn btn-primary', () => {","+\t\tlog(`push from ${page.id}: ${describe(frame)}`);","+\t\tframe.navigate({ create: () => makePage(frame, depth + 1) });","+\t\tlog(`after push: ${describe(frame)}`);","+\t});","+\taddButton(`Push page ${depth + 1} (animated=false)`, 'btn btn-primary', () => {","+\t\tlog(`push (no anim) from ${page.id}: ${describe(frame)}`);","+\t\tframe.navigate({ create: () => makePage(frame, depth + 1), animated: false });","+\t\tlog(`after push: ${describe(frame)}`);","+\t});","+\taddButton('Go back', 'btn btn-outline', () => {","+\t\tlog(`goBack from ${page.id}: canGoBack=${frame.canGoBack()} ${describe(frame)}`);","+\t\tframe.goBack();","+\t\tlog(`after goBack: ${describe(frame)}`);","+\t});","+\taddButton('Log status', 'btn btn-outline', () => {","+\t\tlog(`status ${frame.id}: ${describe(frame)} topmost=${Frame.topmost()?.id}`);","+\t});","+\taddButton('callLoaded() workaround', 'btn btn-outline', () => {","+\t\tframe.callLoaded();","+\t\tlog(`after callLoaded: ${describe(frame)}`);","+\t});","+\tregistry.frames.forEach((f, i) => {","+\t\taddButton(`Select tab ${TITLES[i]}`, 'btn btn-outline', () => {","+\t\t\tlog(`programmatic select tab ${i} (${TITLES[i]}) from ${page.id}; topmost=${Frame.topmost()?.id}`);","+\t\t\tregistry.tabView.selectedIndex = i;","+\t\t\tlog(`after select: ${TITLES[i]} ${describe(registry.frames[i])} topmost=${Frame.topmost()?.id}`);","+\t\t});","+\t});","+\taddButton('Frame.topmost().navigate()', 'btn btn-outline', () => {","+\t\tconst top = Frame.topmost() as Frame;","+\t\tlog(`topmost navigate: topmost=${top?.id} (this page's frame=${frame.id}) before ${describe(top)}`);","+\t\ttop.navigate({ create: () => makePage(top, (top.backStack.length || 0) + 2) });","+\t\tlog(`after topmost navigate: ${describe(top)}`);","+\t});","+\taddButton('Frame.topmost().goBack()', 'btn btn-outline', () => {","+\t\tconst top = Frame.topmost() as Frame;","+\t\tlog(`topmost goBack: topmost=${top?.id} canGoBack=${top?.canGoBack()} ${describe(top)}`);","+\t\ttop.goBack();","+\t\tlog(`after topmost goBack: ${describe(top)}`);","+\t});","+\taddButton('Reassign items (new array)', 'btn btn-outline', () => {","+\t\tconst tv = registry.tabView;","+\t\tlog(`reassign items: selectedIndex=${tv.selectedIndex} before ${describe(frame)}`);","+\t\ttv.items = [...tv.items];","+\t\tlog(`after reassign: selectedIndex=${tv.selectedIndex} ${describe(frame)} topmost=${Frame.topmost()?.id}`);","+\t});","+\taddButton('Log all frames', 'btn btn-outline', () => {","+\t\tregistry.frames.forEach((f) => log(`  ${f.id}: ${describe(f)}`));","+\t\tlog(","+\t\t\t`  topmost=${Frame.topmost()?.id} stack=[${(Frame as any)","+\t\t\t\t._stack()","+\t\t\t\t.map((f: Frame) => f.id)","+\t\t\t\t.join(', ')}]`,","+\t\t);","+\t});","+\taddButton('Select next tab + push there', 'btn btn-outline', () => {","+\t\tconst n = registry.frames.length;","+\t\tconst i = (registry.tabView.selectedIndex + 1) % n;","+\t\tconst target = registry.frames[i];","+\t\tlog(`select next tab ${i} + push: before ${describe(target)}`);","+\t\tregistry.tabView.selectedIndex = i;","+\t\tlog(`after select: ${describe(target)} topmost=${Frame.topmost()?.id}`);","+\t\ttarget.navigate({ create: () => makePage(target, (target.backStack.length || 0) + 2) });","+\t\tlog(`after push on ${target.id}: ${describe(target)}`);","+\t});","+\taddButton('Push + switch tab', 'btn btn-outline', () => {","+\t\tconst n = registry.frames.length;","+\t\tconst i = (registry.tabView.selectedIndex + 1) % n;","+\t\tlog(`push on ${frame.id} then switch to tab ${i}`);","+\t\tframe.navigate({ create: () => makePage(frame, depth + 1) });","+\t\tregistry.tabView.selectedIndex = i;","+\t\tlog(`after push+switch: ${describe(frame)} topmost=${Frame.topmost()?.id}`);","+\t});","+","+\tconst scroll = new ScrollView();","+\tscroll.content = stack;","+\tpage.content = scroll;","+\tpage.on('loaded', () => log(`${page.id} loaded; frame ${describe(frame)}`));","+\tpage.on('unloaded', () => log(`${page.id} unloaded; frame ${describe(frame)}`));","+\tpage.on('navigatedTo', () => log(`${page.id} navigatedTo; frame ${describe(frame)}`));","+\treturn page;","+}","+","+export function buildTabView(opts: NestedTabFrameOptions): TabView {","+\tTrace.enable();","+\tTrace.addCategories(Trace.categories.concat(Trace.categories.Navigation, Trace.categories.Transition, Trace.categories.NativeLifecycle));","+","+\tconst tabView = new TabView();","+\tif (opts.androidOffscreenTabLimit !== undefined) {","+\t\ttabView.androidOffscreenTabLimit = opts.androidOffscreenTabLimit;","+\t}","+\tregistry.tabView = tabView;","+\tregistry.frames = [];","+\tconst items: TabViewItem[] = [];","+\tfor (const title of TITLES.slice(0, opts.tabCount)) {","+\t\tconst item = new TabViewItem();","+\t\titem.title = title;","+\t\tconst frame = new Frame();","+\t\tframe.id = `frame-${title}`;","+\t\tframe.on('loaded', () => {","+\t\t\tlog(`${frame.id} loaded: ${describe(frame)}`);","+\t\t\tif (!frame.currentPage && !(frame as any)._executingContext && (frame as any)._navigationQueue.length === 0) {","+\t\t\t\tlog(`${frame.id} mounting initial page`);","+\t\t\t\tframe.navigate({ create: () => makePage(frame, 1) });","+\t\t\t}","+\t\t});","+\t\tframe.on('unloaded', () => log(`${frame.id} unloaded: ${describe(frame)}`));","+\t\titem.view = frame;","+\t\titems.push(item);","+\t\tregistry.frames.push(frame);","+\t}","+\ttabView.items = items;","+\ttabView.on('selectedIndexChanged', (a: any) => log(`tab selectedIndexChanged ${a.oldIndex} -> ${a.newIndex}`));","+\ttabView.on('loaded', () => log(`tabView loaded`));","+\ttabView.on('unloaded', () => log(`tabView unloaded`));","+\treturn tabView;","+}","+","+export function setupPage(page: Page, opts: NestedTabFrameOptions) {","+\tlog(`---- setup ${JSON.stringify(opts)} ----`);","+\tpage.content = buildTabView(opts);","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"apps/toolbox/src/pages/nested-tab-frame.ts","lines":["@@ -0,0 +1,6 @@","+import { EventData, Page } from '@nativescript/core';","+import { setupPage } from './nested-tab-frame-shared';","+","+export function navigatingTo(args: EventData) {","+\tsetupPage(<Page>args.object, { tabCount: 2 });","+}"],"additions":6,"deletions":0,"truncated":false},{"path":"ap