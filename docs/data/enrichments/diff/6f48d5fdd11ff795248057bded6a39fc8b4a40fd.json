{"id":"6f48d5fdd11ff795248057bded6a39fc8b4a40fd","axis":"silent","repo":"sveltejs/kit","sha":"6f48d5fdd11ff795248057bded6a39fc8b4a40fd","parsed":{"files":[{"path":".changeset/standardize-app-template-diagnostics.md","lines":["@@ -0,0 +1,5 @@","+---","+'@sveltejs/kit': patch","+---","+","+chore: standardize app template diagnostics"],"additions":5,"deletions":0,"truncated":false},{"path":".github/workflows/ci.yml","lines":["@@ -45,7 +45,7 @@ jobs:","           persist-credentials: false","       - uses: ./.github/actions/node-setup","       - run: pnpm run lint","-      - run: cd packages/kit && pnpm prepublishOnly && { [ \"`git status --porcelain=v1`\" == \"\" ] || (echo \"Generated types have changed — please run prepublishOnly locally and commit the changes after you have reviewed them\"; git diff; exit 1); }","+      - run: cd packages/kit && pnpm prepublishOnly && { [ \"`git status --porcelain=v1`\" == \"\" ] || (echo \"Generated types or messages have changed — please run prepublishOnly locally and commit the changes after you have reviewed them\"; git diff; exit 1); }","       - run: pnpm run check","   test:","     # unit tests for kit and every other package; `script` is a root package.json script"],"additions":1,"deletions":1,"truncated":false},{"path":"CONTRIBUTING.md","lines":["@@ -151,6 +151,10 @@ For changes to be reflected in package changelogs, run `pnpm changeset` and foll"," "," If your PR changes the generated types of SvelteKit, run `pnpm generate:types` inside `packages/kit` and commit the new output (don't format it — `packages/kit/types` is excluded from oxfmt). Review the changes carefully to ensure there are no unwanted changes. If you don't commit type changes, CI will fail."," ","+### Diagnostic messages","+","+Some SvelteKit error messages are written as Markdown in `packages/kit/messages/<context>-<severity>/*.md`. Each entry has a `## code` heading, a blockquoted message that can use `%name%` placeholders, and an explanation. `scripts/process-messages/index.js` turns each category into helpers in `packages/kit/src/messages/<context>-<severity>.js`, using the matching template in `scripts/process-messages/templates`. After you edit a message, run `pnpm generate:messages` inside `packages/kit` and commit the generated file. Never edit it by hand. `prepublishOnly` runs this step as well, so CI fails if the output is out of date.","+"," ## Releases"," "," The [Changesets GitHub action](https://github.com/changesets/action#with-publishing) will create and update a PR that applies changesets and publishes new versions of changed packages to npm."],"additions":4,"deletions":0,"truncated":false},{"path":"eslint.config.js","lines":["@@ -96,6 +96,7 @@ export default ["," \t\t\t'packages/kit/src/core/config/fixtures/multiple', // dir contains svelte config with multiple extensions tripping eslint"," \t\t\t'packages/kit/src/core/sync/create_manifest_data/test/samples/**/*',"," \t\t\t'packages/kit/src/core/sync/write_types/test/*/**/*',","+\t\t\t'packages/kit/scripts/process-messages/templates/**/*', // contains generator placeholders"," \t\t\t'packages/kit/types/index.d.ts', // generated file"," \t\t\t'packages/*/test/apps/**/*',"," \t\t\t'packages/*/test/**/build/**',"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/kit/messages/build-errors/config.md","lines":["@@ -0,0 +1,29 @@","+## app_template_missing","+","+> %file% does not exist","+","+SvelteKit renders every page using an app template, which lives at `src/app.html` by default. Create this file, or point [`files.appTemplate`](https://svelte.dev/docs/kit/configuration#files) at the template you want to use.","+","+A minimal template looks like this:","+","+```html","+<!doctype html>","+<html lang=\"en\">","+\t<head>","+\t\t<meta charset=\"utf-8\" />","+\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />","+\t\t%sveltekit.head%","+\t</head>","+\t<body>","+\t\t<div style=\"display: contents\">%sveltekit.body%</div>","+\t</body>","+</html>","+```","+","+## app_template_tag_missing","+","+> %file% is missing %tag%","+","+The app template must contain both `%sveltekit.head%` and `%sveltekit.body%`. SvelteKit replaces these placeholders with the page's `<head>` content (such as links, scripts and anything added with `<svelte:head>`) and with the rendered page markup.","+","+Put `%sveltekit.head%` inside the `<head>` element and `%sveltekit.body%` inside the `<body>` element. Using a wrapper such as `<div style=\"display: contents\">` for `%sveltekit.body%` stops browser extensions that inject elements into `<body>` from interfering with hydration."],"additions":29,"deletions":0,"truncated":false},{"path":"packages/kit/package.json","lines":["@@ -30,6 +30,7 @@"," \t\"devDependencies\": {"," \t\t\"@opentelemetry/api\": \"catalog:\","," \t\t\"@playwright/test\": \"catalog:\",","+\t\t\"@sveltejs/message-box\": \"^1.1.3\","," \t\t\"@sveltejs/vite-plugin-svelte\": \"catalog:\","," \t\t\"@types/connect\": \"catalog:\","," \t\t\"@typescript/native\": \"catalog:\",","@@ -90,7 +91,8 @@"," \t\t\"test:svelte-async:build\": \"pnpm -r --workspace-concurrency 1 --filter=\\\"./test/**\\\" test:svelte-async:build\","," \t\t\"test:unit\": \"vitest run -c vitest.kit.config.js\","," \t\t\"tsc-native\": \"node node_modules/@typescript/native/bin/tsc\",","-\t\t\"prepublishOnly\": \"pnpm generate:types\",","+\t\t\"prepublishOnly\": \"pnpm generate:messages && pnpm generate:types\",","+\t\t\"generate:messages\": \"node scripts/process-messages/index.js\","," \t\t\"generate:version\": \"node scripts/generate-version.js\","," \t\t\"generate:types\": \"node scripts/generate-dts.js\""," \t},"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/kit/scripts/process-messages/index.js","lines":["@@ -0,0 +1,48 @@","+/** @import { Message } from '@sveltejs/message-box' */","+import fs from 'node:fs';","+import { parse, render } from '@sveltejs/message-box';","+","+const messages_dir = new URL('../../messages/', import.meta.url);","+const templates_dir = new URL('./templates/', import.meta.url);","+const output_dir = new URL('../../src/messages/', import.meta.url);","+","+const banner = '/* This file is generated by scripts/process-messages/index.js. Do not edit! */';","+","+/** @type {Set<string>} */","+const seen = new Set();","+","+for (const category of fs.readdirSync(messages_dir).sort()) {","+\tif (category.startsWith('.')) continue;","+","+\t/** @type {Message[]} */","+\tconst messages = [];","+","+\tfor (const file of fs.readdirSync(new URL(`${category}/`, messages_dir)).sort()) {","+\t\tif (!file.endsWith('.md')) continue;","+","+\t\tconst markdown = fs","+\t\t\t.readFileSync(new URL(`${category}/${file}`, messages_dir), 'utf-8')","+\t\t\t.replace(/\\r\\n/g, '\\n');","+","+\t\tfor (const message of parse(markdown)) {","+\t\t\tif (seen.has(message.code)) {","+\t\t\t\tthrow new Error(`Duplicate message code ${category}/${message.code}`);","+\t\t\t}","+","+\t\t\tseen.add(message.code);","+\t\t\tmessages.push(message);","+\t\t}","+\t}","+","+\tmessages.sort((a, b) => (a.code < b.code ? -1 : a.code > b.code ? 1 : 0));","+","+\tconst template = fs","+\t\t.readFileSync(new URL(`${category}.js`, templates_dir), 'utf-8')","+\t\t.replace(/\\r\\n/g, '\\n')","+\t\t.trim();","+","+\tconst output = messages.map((message) => render(message, template)).join('\\n\\n');","+","+\tfs.mkdirSync(output_dir, { recursive: true });","+\tfs.writeFileSync(new URL(`${category}.js`, output_dir), `${banner}\\n\\n${output}\\n`);","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"packages/kit/scripts/process-messages/templates/build-errors.js","lines":["@@ -0,0 +1,12 @@","+/**","+ * DESCRIPTION","+ * @param {VALUES} values","+ * @returns {never}","+ */","+export function CODE(values) {","+\tconst error = new Error(","+\t\t`${'CODE'}\\n${MESSAGE(values)}\\nhttps://next.svelte.dev/e/@sveltejs/kit/${'CODE'}`","+\t);","+\terror.name = 'SvelteKit error';","+\tthrow error;","+}"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/kit/src/core/config/index.js","lines":["@@ -9,6 +9,7 @@ import { validate_options, kit_options, kit_experimental_options } from './optio"," import { resolve_entry } from '../../utils/filesystem.js';"," import { import_peer } from '../../utils/import.js';"," import { stackless } from '../../utils/error.js';","+import * as e from '../../messages/build-errors.js';"," "," /**","  * Splits the config passed to the `sveltekit` Vite plugin into the options that","@@ -77,7 +78,7 @@ export function load_template(cwd, config) {"," \tconst relative = path.relative(cwd, files.appTemplate);"," "," \tif (!fs.existsSync(files.appTemplate)) {","-\t\tthrow new Error(`${relative} does not exist`);","+\t\te.app_template_missing({ file: relative });"," \t}"," "," \tconst contents = fs.readFileSync(files.appTemplate, 'utf8');","@@ -85,7 +86,7 @@ export function load_template(cwd, config) {"," \tconst expected_tags = ['%sveltekit.head%', '%sveltekit.body%'];"," \texpected_tags.forEach((tag) => {"," \t\tif (contents.indexOf(tag) === -1) {","-\t\t\tthrow new Error(`${relative} is missing ${tag}`);","+\t\t\te.app_template_tag_missing({ file: relative, tag });"," \t\t}"," \t});"," "],"additions":3,"deletions":2,"truncated":false},{"path":"packages/kit/src/core/config/index.spec.js","lines":["@@ -1,7 +1,9 @@","+import fs from 'node:fs';","+import { tmpdir } from 'node:os';"," import { join } from 'node:path';"," import { stripVTControlCharacters } from 'node:util';"," import { assert, expect, test } from 'vitest';","-import { validate_config, split_config } from './index.js';","+import { validate_config, split_config, load_template } from './index.js';"," "," /**","  * mutates and remove keys from an object when check callback returns true","@@ -599,3 +601,80 @@ test('split_config only sets `experimental` when SvelteKit flags are present', ("," \texpect(svelte_config).toEqual({});"," \texpect(vite_plugin_svelte_config).toEqual({ experimental: { sendWarningsToBrowser: true } });"," });","+","+/**","+ * @param {(cwd: string) => void} fn","+ */","+function with_temp_dir(fn) {","+\tconst cwd = fs.mkdtempSync(join(tmpdir(), 'kit-load-template-'));","+\ttry {","+\t\tfn(cwd);","+\t} finally {","+\t\tfs.rmSync(cwd, { recursive: true, force: true });","+\t}","+}","+","+/**","+ * @param {string} cwd","+ */","+function template_config(cwd) {","+\treturn validate_config({ files: { appTemplate: join(cwd, 'src/app.html') } });","+}","+","+/**","+ * @param {() => void} fn","+ * @param {string} code","+ * @param {string} text","+ */","+function assert_diagnostic(fn, code, text) {","+\t/** @type {unknown} */","+\tlet thrown;","+\ttry {","+\t\tfn();","+\t} catch (error) {","+\t\tthrown = error;","+\t}","+","+\tassert.instanceOf(thrown, Error);","+\tconst error = /** @type {Error} */ (thrown);","+\tassert.equal(Object.getPrototypeOf(error), Error.prototype);","+\tassert.equal(error.name, 'SvelteKit error');","+\tassert.equal(error.message, `${code}\\n${text}\\nhttps://next.svelte.dev/e/@sveltejs/kit/${code}`);","+}","+","+const valid_template = '<html><head>%sveltekit.head%</head><body>%sveltekit.body%</body></html>';","+","+test('load_template errors if the app template does not exist', () => {","+\twith_temp_dir((cwd) => {","+\t\tassert_diagnostic(","+\t\t\t() => load_template(cwd, template_config(cwd)),","+\t\t\t'app_template_missing',","+\t\t\t`${join('src', 'app.html')} does not exist`","+\t\t);","+\t});","+});","+","+test.each(['%sveltekit.head%', '%sveltekit.body%'])(","+\t'load_template errors if the app template is missing %s',","+\t(tag) => {","+\t\twith_temp_dir((cwd) => {","+\t\t\tfs.mkdirSync(join(cwd, 'src'));","+\t\t\tfs.writeFileSync(join(cwd, 'src/app.html'), valid_template.replace(tag, ''));","+","+\t\t\tassert_diagnostic(","+\t\t\t\t() => load_template(cwd, template_config(cwd)),","+\t\t\t\t'app_template_tag_missing',","+\t\t\t\t`${join('src', 'app.html')} is missing ${tag}`","+\t\t\t);","+\t\t});","+\t}","+);","+","+test('load_template returns a valid app template unchanged', () => {","+\twith_temp_dir((cwd) => {","+\t\tfs.mkdirSync(join(cwd, 'src'));","+\t\tfs.writeFileSync(join(cwd, 'src/app.html'), valid_template);","+","+\t\tassert.equal(load_template(cwd, template_config(cwd)), valid_template);","+\t});","+});"],"additions":80,"deletions":1,"truncated":false},{"path":"packages/kit/src/messages/build-errors.js","lines":["@@ -0,0 +1,27 @@","+/* This file is generated by scripts/process-messages/index.js. Do not edit! */","+","+/**","+ * %file% does not exist","+ * @param {{ \"file\": string }} values","+ * @returns {never}","+ */","+export function app_template_missing(values) {","+\tconst error = new Error(","+\t\t`${'app_template_missing'}\\n${`${values.file} does not exist`}\\nhttps://next.svelte.dev/e/@sveltejs/kit/${'app_template_missing'}`","+\t);","+\terror.name = 'SvelteKit error';","+\tthrow error;","+}","+","+/**","+ * %file% is missing %tag%","+ * @param {{ \"file\": string; \"tag\": string }} values","+ * @returns {never}","+ */","+export function app_template_tag_missing(values) {","+\tconst error = new Error(","+\t\t`${'app_template_tag_missing'}\\n${`${values.file} is missing ${values.tag}`}\\nhttps://next.svelte.dev/e/@sveltejs/kit/${'app_template_tag_missing'}`","+\t);","+\terror.name = 'SvelteKit error';","+\tthrow error;","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"packages/kit/tsconfig.json","lines":["@@ -31,5 +31,9 @@"," \t\t\"types\": [\"node\"]"," \t},"," \t\"include\": [\"*.js\", \"scripts/**/*\", \"src/**/*\"],","-\t\"exclude\": [\"./**/write_types/test/**\", \"./src/runtime/app/service-worker\"]","+\t\"exclude\": [","+\t\t\"./**/write_types/test/**\",","+\t\t\"./src/runtime/app/service-worker\",","+\t\t\"./scripts/process-messages/templates\"","+\t]"," }"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -753,6 +753,9 @@ importers:","       '@playwright/test