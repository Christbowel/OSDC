{"id":"cb070c87eb12f3cf1f85873db38ff756a111460e","axis":"silent","repo":"systemd/systemd","sha":"cb070c87eb12f3cf1f85873db38ff756a111460e","parsed":{"files":[{"path":"man/systemd-storage-fs@.service.xml","lines":["@@ -71,7 +71,7 @@"," ","     <para>For directory volumes, the root of the file system passed to clients is placed in a subdirectory","     <filename>root/</filename> of the <filename><replaceable>NAME</replaceable>.volume</filename> directory. The former (and all inodes","-    below it) must be owned by the foreign UID range, the latter by the host's root.</para>","+    below it) must be owned by the foreign UID range, the latter by the host's root (or the user in user mode).</para>"," ","     <para>When acquiring a volume, symlinks are followed.</para>"," "],"additions":1,"deletions":1,"truncated":false},{"path":"src/basic/forward.h","lines":["@@ -114,6 +114,7 @@ typedef enum UnitDependency UnitDependency;"," typedef enum UnitNameMangle UnitNameMangle;"," typedef enum UnitType UnitType;"," typedef enum WaitFlags WaitFlags;","+typedef enum XOpenFlags XOpenFlags;"," "," typedef struct Fiber Fiber;"," typedef struct FiberOps FiberOps;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/shared/dissect-image.c","lines":["@@ -5758,7 +5758,7 @@ int mountfsd_mount_directory(","         return mountfsd_mount_directory_fd(vl, directory_fd, userns_fd, flags, ret_mount_fd);"," }"," ","-int mkdir_foreign_at(int parent_fd, const char *name, mode_t mode, int *ret_directory_fd) {","+int mkdir_foreign_at_full(int parent_fd, const char *name, mode_t mode, XOpenFlags xopen_flags, int *ret_directory_fd) {","         int r;"," ","         assert(parent_fd >= 0);","@@ -5825,7 +5825,7 @@ int mkdir_foreign_at(int parent_fd, const char *name, mode_t mode, int *ret_dire","                 if (r < 0)","                         report_errno_and_exit(errno_pipe_fds[1], r);"," ","-                _cleanup_close_ int fd = open_mkdir_at(parent_fd, t, O_CLOEXEC, mode);","+     