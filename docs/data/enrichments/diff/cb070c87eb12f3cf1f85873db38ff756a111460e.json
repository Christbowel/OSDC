 \"root\", O_CREAT|O_EXCL|O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW, xopen_flags, 0755);","-        if (root_fd < 0) {","-                r = root_fd;","-                goto fail;","-        }","+        _cleanup_close_ int root_fd = -EBADF;","+        if (arg_runtime_scope == RUNTIME_SCOPE_USER) {","+                r = mkdir_foreign_at_full(volume_fd, \"root\", 0755, xopen_flags, &root_fd);","+                if (r < 0)","+                        goto fail;","+        } else {","+                root_fd = xopenat_full(volume_fd, \"root\", O_CREAT|O_EXCL|O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW, xopen_flags, 0755);","+                if (root_fd < 0) {","+                        r = root_fd;","+                        goto fail;","+                }"," ","-        r = RET_NERRNO(fchown(root_fd, FOREIGN_UID_MIN, FOREIGN_UID_MIN));","-        if (r < 0)","-                goto fail;","+                r = RET_NERRNO(fchown(root_fd, FOREIGN_UID_MIN, FOREIGN_UID_MIN));","+                if (r < 0)","+                        goto fail;","+        }"," ","         r = rename_noreplace(storage_fd, tf, storage_fd, filename);","         if (r < 0)","@@ -333,11 +341,9 @@ static int create_volume_dir(","         return TAKE_FD(root_fd);"," "," fail:","-        if (root_fd >= 0) {","-                assert(volume_fd >= 0);","-                root_fd = safe_close(root_fd);","-                (void) unlinkat(volume_fd, \"root\", AT_REMOVEDIR);","-        }","+        /* mkdir_foreign_at_full() might have created \"root/\" even if we didn't get an fd back */","+        root_fd = safe_close(root_fd);","+        (void) unlinkat(volume_fd, \"root\", AT_REMOVEDIR);"," ","         if (volume_fd >= 0) {","                 volume_fd = safe_close(volume_fd);","@@ -657,6 +663,16 @@ static int vl_method_acquire(","                     !gid_is_foreign(st.st_gid))","                         return log_debug_errno(SYNTHETIC_ERRNO(EPERM), \"Storage directory not owned by foreign UID/GID range.\");"," ","+                if (arg_runtime_scope == RUNTIME_SCOPE_USER) {","+                        /* We cannot create a mount unprivileged, so just return the directory itself */","+                        r = fd_is_read_only_fs(real_fd);","+                        if (r < 0)","+                                return r;","+","+                        ro = r > 0 || p.read_only > 0;","+                        break;","+                }","+","                 /* Let's now generate a new mount for the directory tree, where propagation is disabled, and the","                  * flags are all set to good defaults */","                 _cleanup_close_ int mount_fd = open_tree_attr_with_fallback("],"additions":29,"deletions":13,"truncated":false},{"path":"test/units/TEST-87-AUX-UTILS-VM.storagectl.sh","lines":["@@ -33,6 +33,9 @@ at_exit() {","         rm -fr \"$WORK_DIR\"","     fi","     rm -fr /var/lib/storage/test-87-storage-*.volume","+    if [[ -n \"${USER_STORAGE_DIR:-}\" ]]; then","+        rm -fr \"$USER_STORAGE_DIR\"/test-87-storage-*.volume","+    fi"," }"," trap at_exit EXIT"," ","@@ -176,6 +179,55 @@ else","     rm -fr \"/var/lib/storage/$TESTVOL_DIR.volume\""," fi"," ","+# --- fs provider in user mode: directory volumes ---","+","+# The unprivileged provider creates directory volumes from a user namespace mapping the foreign UID range,","+# which it acquires from nsresourced. That needs nsresourced's user namespace interface, which isn't available","+# without BPF LSM support (e.g. if built with -Dbpf-framework=disabled).","+if [[ -f /usr/lib/systemd/system/systemd-nsresourced.socket ]]; then","+    systemctl start systemd-nsresourced.socket","+fi","+if [[ -S /run/systemd/userdb/io.systemd.NamespaceResource ]] &&","+   ! (SYSTEMD_LOG_TARGET=console varlinkctl call \\","+          /run/systemd/userdb/io.systemd.NamespaceResource \\","+          io.systemd.NamespaceResource.AllocateUserRange \\","+          '{\"name\":\"test-supported\",\"size\":65536,\"userNamespaceFileDescriptor\":0}' 2>&1 || true) |","+       grep \"io.systemd.NamespaceResource.UserNamespaceInterfaceNotSupported\" >/dev/null; then","+    systemctl --user -M testuser@ start systemd-storage-fs.socket","+","+    USER_STORAGE_DIR=\"$(getent passwd testuser | cut -d: -f6)/.local/state/storage\"","+    USER_TESTVOL_DIR=\"test-87-storage-user-dir-$RANDOM\"","+    user_acquire() {","+        # shellcheck disable=SC2016","+        systemd-run -M testuser@ --user --pipe --wait -- \\","+            bash -c 'varlinkctl call --exec \"$XDG_RUNTIME_DIR/systemd/io.systemd.StorageProvider/fs\" \\","+                         io.systemd.StorageProvider.Acquire \"$1\" -- \\","+                         bash -c \"cat; stat -L -c %u /proc/self/fd/3\"' bash \"$1\"","+    }","+","+    output=\"$(user_acquire \"{\\\"name\\\":\\\"$USER_TESTVOL_DIR\\\",\\\"createMode\\\":\\\"new\\\",\\\"template\\\":\\\"directory\\\"}\")\"","+    assert_in '\"type\":\"dir\"' \"$output\"","+    [[ \"$(tail -n 1 <<<\"$output\")\" == 2147352576 ]]","+    [[ \"$(stat -c %u \"$USER_STORAGE_DIR/$USER_TESTVOL_DIR.volume/root\")\" == 2147352576 ]]","+","+    output=\"$(user_acquire \"{\\\"name\\\":\\\"$USER_TESTVOL_DIR\\\",\\\"createMode\\\":\\\"open\\\",\\\"readOnly\\\":true}\")\"","+    assert_in '\"readOnly\":true' \"$output\"","+    [[ \"$(tail -n 1 <<<\"$output\")\" == 2147352576 ]]","+","+    (! user_acquire \"{\\\"name\\\":\\\"$USER_TESTVOL_DIR\\\",\\\"createMode\\\":\\\"new\\\",\\\"template\\\":\\\"directory\\\"}\")","+","+    rm -fr \"${USER_STORAGE_DIR:?}/$USER_TESTVOL_DIR.volume\"","+","+    # Without a template the default (subvolume) template is used, which falls back to a plain directory if","+    # the storage directory isn't on btrfs","+    output=\"$(user_acquire \"{\\\"name\\\":\\\"$USER_TESTVOL_DIR\\\",\\\"createMode\\\":\\\"new\\\"}\")\"","+    assert_in '\"type\":\"dir\"' \"$output\"","+    [[ \"$(tail -n 1 <<<\"$output\")\" == 2147352576 ]]","+    [[ \"$(stat -c %u \"$USER_STORAGE_DIR/$USER_TESTVOL_DIR.volume/root\")\" == 2147352576 ]]","+","+    rm -fr \"${USER_STORAGE_DIR:?}/$USER_TESTVOL_DIR.volume\"","+fi","+"," # --- mount.storage: block device via block provider ---"," "," truncate -s 32M \"$WORK_DIR/block.img\"",""],"additions":52,"deletions":0,"truncated":false}],"additions":90,"deletions":16,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-19T15:01:17.564870+00:00"}