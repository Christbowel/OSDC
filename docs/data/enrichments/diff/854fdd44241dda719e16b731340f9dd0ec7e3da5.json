 every link, which","- * would rewrite same-tab links on round-trip — nulling them lets both parse from the source.","+ * two never drift.","  */"," export const editorExtensions = ["," \tStarterKit.configure({"," \t\t// replaced by DropCursor, which draws a vertical indicator between same-row inline-block nodes"," \t\tdropcursor: false,","-\t\tlink: {","-\t\t\tdefaultProtocol: 'https',","-\t\t\topenOnClick: false,","-\t\t\tHTMLAttributes: { target: null, rel: null },","-\t\t},","+\t\t// standalone so buildLinkProtocolSchema can swap it for a per-field configured Link","+\t\tlink: false,"," \t}),","+\tBaseLink,"," \tDropCursor,"," \tCustomImage,"," \tMedia,","@@ -57,15 +55,19 @@ export const editorExtensions = [","  * The complete extension list for a field's editor: `editorExtensions` plus the field's additions,","  * with PreservedAttributes told about every other attribute so a `data-*` or `aria-*` name that","  * another attribute parses has one owner. Every site that builds a field editor must use this.","+ * An addition with a base extension's name replaces it in place.","  */"," export function fieldEditorExtensions(additions: AnyExtension[]): AnyExtension[] {","-\tconst others = [...editorExtensions.filter((extension) => extension !== PreservedAttributes), ...additions];","+\tconst byName = new Map(additions.map((extension) => [extension.name, extension]));","+\tconst base = editorExtensions.map((extension) => byName.get(extension.name) ?? extension);","+\tconst appended = additions.filter((extension) => !base.includes(extension));","+\tconst others = [...base.filter((extension) => extension !== PreservedAttributes), ...appended];"," "," \treturn [","-\t\t...editorExtensions.map((extension) =>","+\t\t...base.map((extension) =>"," \t\t\textension === PreservedAttributes ? PreservedAttributes.configure({ extensions: others }) : extension,"," \t\t),","-\t\t...additions,","+\t\t...appended,"," \t];"," }"," ","@@ -76,6 +78,8 @@ export interface FieldSchemaOptions {"," \textensions?: string[] | null;"," \t/** Field `extensionOptions` option: per-extension values, keyed by extension id. */"," \textensionOptions?: unknown;","+\t/** Field `linkProtocols` option: extra URL schemes links and image links may use. */","+\tlinkProtocols?: unknown;"," \tcomparisonMode?: boolean;"," }"," ","@@ -85,33 +89,38 @@ export interface FieldSchema {"," \t/** Tells this field's schema apart from others in the normalization verdict cache. */"," \tkey: string;"," \tformats: CustomFormat[];","+\tlinkProtocols: string[];"," \tbuttons: RichTextToolbarButton[];"," \tbubbleMenus: RichTextBubbleMenu[];"," }"," "," /**","  * The one place a field's schema additions are assembled: the richtext extensions the field opted","- * into, its custom formats, and the comparison-diff mark in comparison mode. The live editor, the","- * save-time round-trip check, the source-code drawer and the comparison view all build from this","- * result. A site that composed the list by hand could miss a contribution and report its markup as","+ * into, its custom formats, its link protocols, and the comparison-diff mark in comparison mode. The","+ * live editor, the save-time round-trip check, the source-code drawer and the comparison view all","+ * build from this result. A site that composed the list by hand could miss a contribution and report its markup as","  * dropped even though the editor renders it.","  */"," export function buildFieldSchema(options: FieldSchemaOptions = {}): FieldSchema {"," \tconst customFormats = buildCustomFormats(options.customFormats);"," \tconst contributed = enabledRichTexts(options.extensions, options.extensionOptions);","+\tconst links = buildLinkProtocolSchema(options.linkProtocols);"," "," \treturn {"," \t\textensions: ["," \t\t\t...contributed.flatMap((config) => config.extensions),"," \t\t\t...customFormats.extensions,","+\t\t\t...links.extensions,"," \t\t\t...(options.comparisonMode ? [ComparisonDiff] : []),"," \t\t],"," \t\tkey: ["," \t\t\toptions.comparisonMode ? 'comparison' : '',"," \t\t\tcustomFormats.key,","+\t\t\tlinks.key,"," \t\t\tcontributed.map((config) => config.key).join('\\u0000'),"," \t\t].join('\\u0000'),"," \t\tformats: customFormats.formats,","+\t\tlinkProtocols: links.protocols,"," \t\tbuttons: contributed.flatMap((config) =>"," \t\t\tconfig.buttons.map((button) => ({ ...button, key: contributedKey(config, button) })),"," \t\t),"],"additions":22,"deletions":13,"truncated":false},{"path":"app/src/interfaces/input-rich-text-html/extensions/link-protocols.test.ts","lines":["@@ -0,0 +1,103 @@","+import { type AnyExtension, Editor } from '@tiptap/vue-3';","+import { afterEach, describe, expect, test, vi } from 'vitest';","+import { roundTrip } from '../composables/normalization-diff';","+import { buildLinkProtocolSchema } from './link-protocols';","+import { fieldEditorExtensions } from '.';","+","+const TEXT_LINK = '<p><a href=\"myapp://some/route\">open</a></p>';","+// a block after the image keeps StarterKit's trailing-node paragraph out of the expected HTML","+const IMAGE_LINK = '<a href=\"myapp://some/route\"><img src=\"/assets/abc\"></a><p>y</p>';","+","+const editors: Editor[] = [];","+","+afterEach(() => {","+\twhile (editors.length) editors.pop()!.destroy();","+});","+","+// roundTrip destroys its editor before Tiptap's create tick, so only a mounted editor runs onCreate","+async function mounted(extensions: AnyExtension[]): Promise<Editor> {","+\tconst editor = new Editor({ extensions: fieldEditorExtensions(extensions) });","+\teditors.push(editor);","+\tawait new Promise((resolve) => setTimeout(resolve));","+\treturn editor;","+}","+","+describe('buildLinkProtocolSchema', () => {","+\ttest('drops a text link with a custom scheme that is not allowed', () => {","+\t\texpect(roundTrip(TEXT_LINK)).toBe('<p>open</p>');","+\t});","+","+\ttest('keeps a text link with an allowed custom scheme', () => {","+\t\tconst { extensions } = buildLinkProtocolSchema(['myapp']);","+\t\texpect(roundTrip(TEXT_LINK, extensions)).toBe(TEXT_LINK);","+\t});","+","+\ttest('keeps an image link with an allowed custom scheme', () => {","+\t\tconst { extensions } = buildLinkProtocolSchema(['myapp']);","+\t\texpect(roundTrip(IMAGE_LINK, extensions)).toBe(IMAGE_LINK);","+\t});","+","+\ttest('drops the link of an image with a custom scheme that is not allowed and keeps the image', () => {","+\t\texpect(roundTrip(IMAGE_LINK)).toBe('<img src=\"/assets/abc\"><p>y</p>');","+\t});","+","+\ttest('drops the link of an image with a script scheme even when other schemes are allowed', () => {","+\t\tconst { extensions } = buildLinkProtocolSchema(['myapp']);","+\t\tconst html = '<a href=\"javascript:alert(1)\"><img src=\"/assets/abc\"></a><p>y</p>';","+","+\t\texpect(roundTrip(html, extensions)).toBe('<img src=\"/assets/abc\"><p>y</p>');","+\t});","+","+\ttest('still keeps links with the default schemes', () => {","+\t\tconst { extensions } = buildLinkProtocolSchema(['myapp']);","+\t\tconst html = '<p><a href=\"https://directus.io\">a</a> <a href=\"mailto:a@b.c\">b</a></p>';","+\t\texpect(roundTrip(html, extensions)).toBe(html);","+\t});","+","+\ttest('accepts schemes entered with a trailing colon or slashes and in any case', () => {","+\t\tconst { extensions } = buildLinkProtocolSchema([' MyApp:// ', 'other:']);","+\t\tconst html = '<p><a href=\"myapp://x\">a</a> <a href=\"other:y\">b</a></p>';","+\t\texpect(roundTrip(html, extensions)).toBe(html);","+\t});","+","+\ttest('keys an empty or missing list as the base schema', () => {","+\t\tconst empty = { extensions: [], protocols: [], key: '' };","+\t\texpect(buildLinkProtocolSchema([])).toEqual(empty);","+\t\texpect(buildLinkProtocolSchema(null)).toEqual(empty);","+\t\texpect(buildLinkProtocolSchema(['', '  '])).toEqual(empty);","+\t});","+","+\ttest('keys two lists apart and the same list in any order alike', () => {","+\t\texpect(buildLinkProtocolSchema(['myapp']).key).not.toBe(buildLinkProtocolSchema(['other']).key);","+\t\texpect(buildLinkProtocolSchema(['a', 'b']).key).toBe(buildLinkProtocolSchema(['b', 'a']).key);","+\t});","+","+\ttest('mounts an editor with dotted and plus schemes and keeps their links', async () => {"],"additions":75,"deletions":0,"truncated":false}],"additions":421,"deletions":31,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-04T16:05:17.696278+00:00"}