{"id":"964c524eaf89b545a28c2bb81fdee7429d2cbdd2","axis":"silent","repo":"payloadcms/payload","sha":"964c524eaf89b545a28c2bb81fdee7429d2cbdd2","parsed":{"files":[{"path":"docs/database/indexes.mdx","lines":["@@ -64,6 +64,31 @@ export const MyCollection: CollectionConfig = {"," }"," ```"," ","+### Indexing documents only when fields exist","+","+With MongoDB, use `requireExists` to limit a compound index to documents where every listed field is present:","+","+```ts","+indexes: [","+  {","+    fields: ['tenant', 'slug'],","+    requireExists: ['slug'],","+    unique: true,","+  },","+]","+```","+","+This allows multiple documents in the same tenant to omit `slug`, while still rejecting duplicate combinations of `tenant` and a present `slug`. MongoDB implements the condition with a `partialFilterExpression` using `$exists: true` for each path.","+","+- Paths use the same dot notation as `fields`, such as `metadata.code`. A filter path can also refer to a field outside the index keys. Every path must identify a configured field.","+- Unique indexes with `requireExists` cannot use index keys nested inside arrays or blocks, because uniqueness validation does not support matching compound keys across their rows. Existence filter paths may still traverse arrays.","+- **An explicit `null` counts as present.** Documents with `slug: null` participate in the unique index. Only missing fields are excluded.","+- When an index key or existence filter is localized, Payload creates a separate partial index for each locale. A document can participate in one locale's index without supplying the field in every locale.","+- The option also works on non-unique compound indexes. Version indexes retain the filter and remain non-unique.","+- `requireExists` is **MongoDB only**. SQL adapters ignore it and retain their existing index and `NULL` behavior.","+","+For an existing collection, update its database indexes through your normal index-management or migration workflow. Adding the option to the config alone does not change an existing MongoDB index when automatic index management is disabled.","+"," ## Unique Fields"," "," Setting `unique: true` on a field creates a **collection-wide** database unique index on that field's path. This means no two documents in the collection can share the same value for that field."],"additions":25,"deletions":0,"truncated":false},{"path":"packages/db-mongodb/src/models/buildCompoundIndexes.spec.ts","lines":["@@ -0,0 +1,153 @@","+import type { CompoundIndex, Field, Payload } from 'payload'","+","+import { flattenAllFields } from 'payload'","+import { describe, expect, test } from 'vitest'","+","+import { sanitizeCompoundIndexes } from '../../../payload/src/collections/config/sanitizeCompoundIndexes.js'","+import { buildVersionCompoundIndexes } from '../../../payload/src/versions/buildVersionCompoundIndexes.js'","+import { buildSchema } from './buildSchema.js'","+","+const fields: Field[] = [","+  { name: 'tenant', type: 'text' },","+  { name: 'slug', type: 'text', localized: true },","+  { name: 'gate', type: 'text', localized: true },","+  { name: 'metadata', type: 'group', fields: [{ name: 'code', type: 'text' }] },","+]","+const flattenedFields = flattenAllFields({ fields })","+const payload = {","+  config: {","+    localization: {","+      defaultLocale: 'en',","+      locales: [{ code: 'en' }, { code: 'de' }],","+      localeCodes: ['en', 'de'],","+    },","+  },","+  db: {},","+} as unknown as Payload","+","+const buildIndexes = ({","+  disableUnique,","+  index,","+}: {","+  disableUnique?: boolean","+  index: CompoundIndex","+}) =>","+  buildSchema({","+    buildSchemaOptions: { disableUnique },","+    compoundIndexes: sanitizeCompoundIndexes({ fields: flattenedFields, indexes: [index] }),","+    configFields: fields,","+    flattenedFields,","+    payload,","+  }).indexes()","+","+describe('MongoDB compound existence filters', () => {","+  test('should build a partial index requiring every configured path', () => {","+    expect(","+      buildIndexes({","+        index: {","+          fields: ['tenant', 'metadata.code'],","+          requireExists: ['tenant', 'metadata.code'],","+          unique: true,","+        },","+      }),","+    ).toContainEqual([","+      { tenant: 1, 'metadata.code': 1 },","+      expect.objectContaining({","+        partialFilterExpression: { tenant: { $exists: true }, 'metadata.code': { $exists: true } },","+        unique: true,","+      }),","+    ])","+  })","+","+  test('should build a separate matching partial index for each locale', () => {","+    const indexes = buildIndexes({","+      index: {","+        fields: ['tenant', 'slug'],","+        requireExists: ['slug'],","+        unique: true,","+      },","+    })","+","+    for (const locale of ['en', 'de']) {","+      expect(indexes).toContainEqual([","+        { tenant: 1, [`slug.${locale}`]: 1 },","+        expect.objectContaining({","+          partialFilterExpression: { [`slug.${locale}`]: { $exists: true } },","+          unique: true,","+        }),","+      ])","+    }","+  })","+","+  test('should give filter-only localized indexes distinct names', () => {","+    const indexes = buildIndexes({","+      index: {","+        fields: ['tenant'],","+        requireExists: ['gate'],","+        unique: true,","+      },","+    })","+","+    for (const locale of ['en', 'de']) {","+      expect(indexes).toContainEqual([","+        { tenant: 1 },","+        expect.objectContaining({","+          name: `tenant_${locale}_require_exists`,","+          partialFilterExpression: { [`gate.${locale}`]: { $exists: true } },","+        }),","+      ])","+    }","+  })","+","+  test('should preserve the existing localized compound index without requireExists', () => {","+    expect(buildIndexes({ index: { fields: ['tenant', 'slug'], unique: true } })).toContainEqual([","+      { tenant: 1, 'slug.en': 1, 'slug.de': 1 },","+      expect.objectContaining({ unique: true }),","+    ])","+  })","+","+  test('should not add a filter for an empty requireExists list', () => {","+    const indexes = buildIndexes({ index: { fields: ['tenant'], requireExists: [], unique: true } })","+","+    expect(indexes[0]?.[1]).not.toHaveProperty('partialFilterExpression')","+  })","+","+  test('should respect disableUnique while retaining the filter', () => {","+    expect(","+      buildIndexes({","+        disableUnique: true,","+        index: {","+          fields: ['tenant'],","+          requireExists: ['tenant'],","+          unique: true,","+        },","+      }),","+    ).toContainEqual([","+      { tenant: 1 },","+      expect.objectContaining({","+        unique: false,","+        partialFilterExpression: { tenant: { $exists: true } },","+      }),","+    ])","+  })","+","+  test('should prefix existence filters on version indexes and disable uniqueness', () => {","+    const indexes = sanitizeCompoundIndexes({","+      fields: flattenedFields,","+      indexes: [","+        {","+          fields: ['tenant', 'slug'],","+          requireExists: ['slug'],","+          unique: true,","+        },","+      ],","+    })","+","+    expect(buildVersionCompoundIndexes({ indexes })[0]).toMatchObject({","+      requireExists: [","+        { localizedPath: 'version.slug.<locale>', path: 'version.slug', pathHasLocalized: true },","+      ],","+      unique: false,","+    })","+  })","+})"],"additions":153,"deletions":0,"truncated":false},{"path":"packages/db-mongodb/src/models/buildSchema.ts","lines":["@@ -213,21 +213,60 @@ export const buildSchema = (args: {"," ","   if (args.compoundIndexes) {","     for (const index of args.compoundIndexes) {","-      const indexDefinition: Record<string, 1> = {}","+      const requiredFields = index.requireExists ?? []","+      const hasLocalizedIndexField = index.fields.some(({ pathHasLocalized }) => pathHasLocalized)","+      const hasLocalizedRequiredField = requiredFields.some(","+        ({ pathHasLocalized }) => pathHasLocalized,","+      )","+      const localization = payload.config.localization","+      // Preserve existing compound index definitions unless a partial index was requested.","+      const locales =","+        requiredFields.length &&","+        localization &&","+        (hasLocalizedIndexField || hasLocalizedRequiredField)","+          ? localization.locales","+          : [undefined]","+","+      for (const locale of locales) {","+        const indexDefinition: Record<string, 1> = {}","+        const resolveIndexPath = ({","+          localizedPath,","+          path,","+          pathHasLocalized,","+        }: {","+          localizedPath: string","+          path: string","+          pathHasLocalized: boolean","+        }): string =>","+          pathHasLocalized && locale ? localizedPath.replaceAll('<locale>', locale.code) : path","+","+        for (const field of index.fields) {","+          if (!requiredFields.length && field.pathHasLocalized && localization) {","+            for (const indexLocale of localization.locales) {","+              indexDefinition[field.localizedPath.replaceAll('<locale>', indexLocale.code)] = 1","+            }","+          } else {","+            indexDefinition[resolveIndexPath(field)] = 1","+          }","+        }"," ","-      for (const field of index.fields) {","-        if (field.pathHasLocalized && payload.config.localization) {","-          for (const locale of payload.config.localization.locales) {","-            indexDefinition[field.localizedPath.replace('<locale>', locale.code)] = 1","+        const indexOptions: IndexOptions = {","+          unique: args.buildSchemaOptions.disableUnique ? false : index.unique,","+        }","+","+        if (requiredFields.length) {","+          indexOptions.partialFilterExpression = Object.fromEntries(","+            requiredFields.map((field) => [resolveIndexPath(field), { $exists: true }]),","+          )","+","+          // Filter-only localized fields otherwise produce identical automatic index names.","+          if (locale && !hasLocalizedIndexField) {","+            indexOptions.name = `${Object.keys(indexDefinition).join('_')}_${locale.code}_require_exists`","           }","-        } else {","-          indexDefinition[field.path] = 1","         }","-      }"," ","-      schema.index(indexDefinition, {","-        unique: args.buildSchemaOptions.disableUnique ? false : index.unique,","-      })","+        schema.index(indexDefinition, indexOptions)","+      }","     }","   }"," "],"additions":50,"deletions":11,"truncated":false},{"path":"packages/payload/src/collections/config/sanitizeCompoundIndexes.spec.ts","lines":["@@ -0,0 +1,93 @@","+import { describe, expect, test } from 'vitest'","+","+import { flattenAllFields } from '../../utilities/flattenAllFields.js'","+import { sanitizeCompoundIndexes } from './sanitizeCompoundIndexes.js'","+","+const fields = flattenAllFields({","+  fields: [","+    { name: 'tenant', type: 'text' },","+    { name: 'slug', type: 'text', localized: true },","+    {","+      name: 'metadata',","+      type: 'group',","+      localized: true,","+      fields: [{ name: 'code', type: 'text' }],","+    },","+    {","+      name: 'items',","+      type: 'array',","+      fields: [","+        { name: 'code', type: 'text' },","+        { name: 'gate', type: 'text' },","+        { name: 'details', type: 'group', fields: [{ name: 'code', type: 'text' }] },","+      ],","+    },","+    {","+      name: 'content',","+      type: 'blocks',","+      blocks: [{ slug: 'item', fields: [{ name: 'code', type: 'text' }] }],","+    },","+  ],","+})","+","+describe('compound index existence filters', () => {","+  test.each(['items.code', 'items.details.code', 'content.item.code'])(","+    'should reject a unique filtered index with an indexed path inside an array or block: %s',","+    (path) => {","+      expect(() =>","+        sanitizeCompoundIndexes({","+          fields,","+          indexes: [{ fields: ['tenant', path], requireExist