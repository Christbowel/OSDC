","+","+[dependencies]","+criterion = { workspace = true }","+","+# Doesn't build on many other OSes.","+[target.'cfg(target_os = \"linux\")'.dependencies]","+valgrind-requests = { workspace = true }"],"additions":20,"deletions":0,"truncated":false},{"path":"crates/bench-util/src/lib.rs","lines":["@@ -0,0 +1,135 @@","+//! Measuring benchmarks with Callgrind as well as the wall clock.","+//!","+//! Wasmtime's benchmarks time their routines with [`Timer`], or [`iter`] in","+//! place of Criterion's `Bencher::iter`. Run natively, that is the usual","+//! wall-clock timing and nothing else. Run under Valgrind, each timed region is","+//! also a Callgrind measurement: starting a timer turns on instrumentation and","+//! zeroes Callgrind's counts, and stopping it dumps them, labeled","+//! [`DUMP_LABEL`].","+//!","+//! To measure a bench this way, build it with `cargo bench --no-run`, which","+//! prints the path of its executable, and run that in Criterion's test mode,","+//! which runs each routine once, under Callgrind with instrumentation off at","+//! start:","+//!","+//! ```text","+//! valgrind --tool=callgrind --instr-atstart=no <bench executable> --bench --test","+//! ```","+//!","+//! Callgrind writes its dumps to files, which say nothing of which benchmark","+//! made them, so each dump is also announced on stdout with a [`MARKER`] line,","+//! numbered from 1 in the order of the dumps. Criterion's test mode prints","+//! `Testing <id>` on stdout before each benchmark, so the markers between one","+//! `Testing` line and the next are that benchmark's dumps.","+//!","+//! Whether to measure is decided by asking Valgrind whether it is running the","+//! process, so there is nothing to configure.","+","+use std::ffi::CStr;","+use std::sync::OnceLock;","+use std::sync::atomic::{AtomicU32, Ordering};","+use std::time::{Duration, Instant};","+","+#[cfg(target_os = \"linux\")]","+mod callgrind {","+    pub use valgrind_requests::callgrind::{dump_stats_at, start_instrumentation, zero_stats};","+","+    pub fn on_valgrind() -> bool {","+        // This constant was set at build time based on available valgrind","+        // headers. It needs to be checked first because if it's none then","+        // `running_on_valgrind` will panic."],"additions":40,"deletions":0,"truncated":false}],"additions":223,"deletions":76,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-25T18:26:05.625493+00:00"}