d records the duration to eagerly","-/// initializes the thread local resources. It then creates a store and","-/// instance, and records the duration it took to execute the first function","-/// call.","-fn eager_thread_instantiate(engine: Engine, module: Module) -> (Duration, Duration) {","-    thread::spawn(move || {","-        let init_start = Instant::now();","-        Engine::tls_eager_initialize();","-        let init_duration = init_start.elapsed();","+/// Which region of [`eager_thread_instantiate`] to time.","+#[derive(Clone, Copy)]","+enum Measure {","+    Init,","+    Call,","+}"," ","-        (init_duration, duration_of_call(&engine, &module))","+/// This benchmark spawns a new thread, and eagerly initializes the thread local","+/// resources. For [`Measure::Init`] it returns how long that took. For","+/// [`Measure::Call`] it then creates a store and instance, and returns how long","+/// the first function call took. A benchmark times only one region, so that","+/// under Callgrind it makes one measurement.","+fn eager_thread_instantiate(engine: Engine, module: Module, measure: Measure) -> Duration {","+    thread::spawn(move || match measure {","+        Measure::Init => {","+            let init = Timer::start();","+            Engine::tls_eager_initialize();","+            init.stop()","+        }","+        Measure::Call => {","+            Engine::tls_eager_initialize();","+            duration_of_call(&engine, &module)","+        }","     })","     .join()","     .expect(\"thread joins\")"],"additions":28,"deletions":21,"truncated":false},{"path":"benches/trap.rs","lines":["@@ -1,5 +1,6 @@"," use criterion::*;"," use wasmtime::*;","+use wasmtime_bench_util::Timer;"," "," criterion_main!(benches);"," criterion_group!(benches, bench_traps);","@@ -69,11 +70,11 @@ fn bench_multi_threaded_traps(c: &mut Criterion) {"," ","                     // Measure how long it takes to do `iters` worth of traps","                     // while there is a bunch of b