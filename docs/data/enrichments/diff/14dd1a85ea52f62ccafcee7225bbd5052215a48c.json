ue {","                     value: UserSettingValue::UInt64(0),","-                    desc: \"Experimental. Fuse scans keep columns in compact encoded forms (frame of reference for integers, Date, Timestamp and Decimal; dictionary, reusing the Parquet dictionary for String) in memory and in the column array cache. Intended for use with the deserialized column cache (config `cache.table_data_deserialized_data_bytes` or `cache.table_data_deserialized_memory_ratio`): without it, every scan encodes the columns again and may be slower.\",","+                    desc: \"Experimental. Fuse scans keep columns in compact encoded forms (frame of reference for integers, Date, Timestamp and Decimal; dictionary, reusing the Parquet dictionary for String) in memory and in the column array cache. Intended for use with the deserialized column cache; without it, only the Parquet dictionaries of String columns are kept, as building the other encodings for a single use costs more than it saves.\",","                     mode: SettingMode::Both,","                     scope: SettingScope::Both,","                     range: Some(SettingRange::Numeric(0..=1)),"],"additions":1,"deletions":1,"truncated":false},{"path":"src/query/storages/common/blocks/src/parquet_rs.rs","lines":["@@ -32,7 +32,15 @@ use crate::parquet_writer::BlockParquetWriter;"," use crate::parquet_writer::SerializedParquet;"," "," /// Disable dictionary encoding once the NDV-to-row ratio is greater than this threshold.","-const HIGH_CARDINALITY_RATIO_THRESHOLD: f64 = 0.1;","+///","+/// Columns such as URLs often have a third of a block distinct: their dictionary is still much","+/// smaller than the plain values, and readers can keep it (see `enable_encoded_columns`).","+const HIGH_CARDINALITY_RATIO_THRESHOLD: f64 = 0.5;","+","+/// Size limit of a dictionary page, beyond which the writer falls back to plain pages for the","+/// rest of the column chunk. The arrow-rs default (1 MiB) is reached by string columns of a","+