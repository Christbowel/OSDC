't matter, so try both orders.","+    for (const [local, foreign] of [","+        [small, large],","+        [large, small],","+    ]) {","+        const explain = local.explain().aggregate([","+            {","+                $lookup: {","+                    from: foreign.getName(),","+                    localField: \"k\",","+                    foreignField: \"k\",","+                    as: \"f\",","+                },","+            },","+            {$unwind: \"$f\"},","+        ]);","+        assert(joinOptUsed(explain), \"expected join optimization\", {explain});","+        const joins = getAllPlanStages(getWinningPlanFromExplain(explain)).filter(","+            (s) => s.ndvEstimates,","+        );","+        assert.eq(joins.length, 1, \"expected one join\", {explain});","+        const [est] = joins[0].ndvEstimates;","+        assert.eq(est.assumedPkSide, expectedPkSide.getFullName(), {est});","+        assert.eq(est.ndvSource, expectedSource, {est});","+    }","+}","+","+describe(\"two-sided join NDV estimation\", function () {","+    let conn;","+    let db;","+","+    before(function () {","+        conn = MongoRunner.runMongod({","+            setParameter: {","+                featureFlagPersistentStats: true,","+                internalQueryEnablePersistentNDVStats: true,","+                internalEnableJoinOptimization: true,","+                // Reports 'ndvEstimates' on join stages.","+                internalQueryExplainJoinCostComponents: true,","+            },","+        });","+        db = conn.getDB(\"test\");","+    });","+","+    after(function () {","+        MongoRunner.stopMongod(conn);","+    });","+","+    describe(\"larger side has more distinct values\", function () {","+        // The small collection holds a foreign key into the large one, so the larger NDV is the","+        // right one, but the large collection's NDV is never sampled.","+        const cases = [","+            {small: \"sampling\", large: \"sampling\", pkSide: \"small\", ndvSource: \"Sampling\"},","+            {small: \"sampling\", large: \"hll\", pkSide: \"large\", ndvSource: \"HyperLogLog\"},","+            {small: \"sampling\", large: \"unique\", pkSide: \"large\", ndvSource: \"Metadata\"},","+            {small: \"hll\", large: \"sampling\", pkSide: \"small\", ndvSource: \"HyperLogLog\"},","+            {small: \"hll\", large: \"hll\", pkSide: \"large\", ndvSource: \"HyperLogLog\"},","+            {small: \"hll\", large: \"unique\", pkSide: \"large\", ndvSource: \"Metadata\"},","+            {small: \"unique\", large: \"sampling\", pkSide: \"small\", ndvSource: \"Metadata\"},","+            {small: \"unique\", large: \"hll\", pkSide: \"large\", ndvSource: \"HyperLogLog\"},","+            {small: \"unique\", large: \"unique\", pkSide: \"large\", ndvSource: \"Metadata\"},","+        ];","+        for (const {small, large, pkSide, ndvSource} of cases) {","+            it(`small side ${small}, large side ${large}`, function () {","+                const colls = {","+                    small: makeColl(db, `small_${small}_${large}`, small, {numDocs: 4}),","+                    large: makeColl(db, `large_${small}_${large}`, large, {numDocs: 500}),","+                };","+                assertNdvEstimate(colls.small, colls.large, colls[pkSide], ndvSource);","+            });","+        }","+    });","+","+    describe(\"smaller side has more distinct values\", function () {","+        it(\"keeps the small side's sampled NDV\", function () {","+            const small = makeColl(db, \"small_fewer_sampling\", \"sampling\", {numDocs: 4});","+            const large = makeColl(db, \"large_fewer_sampling\", \"hll\", {numDocs: 500, ndv: 2});","+            assertNdvEstimate(small, large, small, \"Sampling\");","+        });","+","+        it(\"keeps the small side's unique index NDV\", function () {","+            const small = makeColl(db, \"small_fewer_unique\", \"unique\", {numDocs: 4});","+            const large = makeColl(db, \"large_fewer_unique\", \"hll\", {numDocs: 500, ndv: 2});","+            assertNdvEstimate(small, large, small, \"Metadata\");","+        });","+    });","+});"],"additions":120,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/query/joins/query_stats_join_optimization_metrics.js","lines":["@@ -312,7 +312,7 @@ assert.eq(orders.aggregate(pipeline).itcount(), 1000);"," }"," "," {","-    // Validate that we count the join edges whose NDV came from index uniqueness metadata. Run the","+    // Validate that we count the join key NDVs that came from index uniqueness metadata. Run the","     // same pipeline as above, but recreate one of the join key indexes as unique so that the optimizer can","     // derive NDV from that metadata.","     assert.commandWorked(","@@ -328,11 +328,11 @@ assert.eq(orders.aggregate(pipeline).itcount(), 1000);","     // histograms that cover only the run below.","     resetQueryStatsStore(conn, \"10MB\");"," ","-    // Update expected metrics to reflect this: only the 'orders.a = customers.a' edge has a unique","-    // index covering its join key.","+    // Update expected metrics to reflect this: only the 'orders.a = customers.a' edge has unique","+    // indexes covering its join key, one on each side.","     kPerQueryMetrics.numSuffixSourcesPushedToSbe = 0;","     kPerQueryMetrics.numResidualClassicSources = 0;","-    kPerEnumerationExpectedMetrics.numUniqueIndexesUsedForNDV = 1;","+    kPerEnumerationExpectedMetrics.numUniqueIndexesUsedForNDV = 2;"," ","     assert.eq(orders.aggregate(pipeline).itcount(), 1000);"," ","@@ -351,8 +351,8 @@ assert.eq(orders.aggregate(pipeline).itcount(), 1000);"," ","     // Validate that we count join edges served from persisted NDV statistics (analyze mode","     // \"ndv\"). The unique index from the previous block still covers the 'a' edge, so only the","-    // 'b' edge requests an NDV estimate; persist statistics for both of its sides so the","-    // request is served regardless of