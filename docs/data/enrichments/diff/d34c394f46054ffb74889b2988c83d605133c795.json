sistentNDVStatsEnabled()) {","         return boost::none;","     }"," ","@@ -1392,8 +1388,12 @@ CardinalityEstimate SamplingEstimatorImpl::estimateNDV(","     boost::optional<std::span<const OrderedIntervalList>> bounds) const {","     tassert(11158504, \"Sample must be generated before calling estimateNDV()\", _isSampleGenerated);"," ","-    if (auto persisted = tryEstimateNDVFromPersistentStats(fields, bounds)) {","-        return *persisted;","+    // Bounded NDV stays sample-only by design: a whole-domain sketch cannot answer how many","+    // distinct values fall within a range.","+    if (!bounds) {","+        if (auto persisted = tryEstimateNDVFromPersistentStats(fields)) {","+            return *persisted;","+        }","     }"," ","     // Only the sample-based path below reads the field out of the sample, so this precondition is"],"additions":8,"deletions":8,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/sampling/sampling_estimator_impl.h","lines":["@@ -218,6 +218,16 @@ class SamplingEstimatorImpl : public SamplingEstimator {","         boost::optional<std::span<const OrderedIntervalList>> bounds) const override;","     using SamplingEstimator::estimateNDV;"," ","+    /**","+     * Serves the NDV from persisted field statistics (built by analyze mode \"ndv\") when","+     * eligible: 'persistentNDVStatsEnabled()' and at most 'kNdvMaxFields' fields. The request's","+     * equality semantics select the persisted folding variant; composite requests folding","+     * several fields have none and are ineligible. Loaded documents are cached per sorted path","+     * set and results, including misses, are memoized per path set and variant.","+     */","+    boost::optional<CardinalityEstimate> tryEstimateNDVFromPersistentStats(","+        const std::vector<FieldPathAndEqSemantics>& fields) const override;","+","     /**","      * Estimates the number of distinct values of tuples of the given field names","      * a multikey index over the provided fields would contain, from the values","@@ -431,19 +441,6 @@ class SamplingEstimatorImpl : public SamplingEstimator {","     SamplingCEMethodEnum _samplingStyle;"," "," private:","-    /**","-     * Serves the NDV from persisted field statistics (built by analyze mode \"ndv\") when","-     * eligible: feature flag and knob enabled, at most kNdvMaxFields fields and no bounds.","-     * The request's equality semantics select the persisted folding variant; composite requests","-     * folding several fields have none and are ineligible. Returns boost::none when ineligible","-     * or when no usable statistics exist; the caller then falls back to the sample-based","-     * estimate. Loaded documents are cached per sorted path set and results, including misses,","-     * are memoized per path set and variant.","-     */","-    boost::optional<CardinalityEstimate> tryEstimateNDVFromPersistentStats(","-        const std::vector<FieldPathAndEqSemantics>& fields,","-        boost::optional<std::span<const OrderedIntervalList>> bounds) const;","-","     /**","      * Whether persisted NDV statistics may be served, i.e. featureFlagPersistentStats and the","      * internalQueryEnablePersistentNDVStats knob are both enabled. Computed once per instance."],"additions":10,"deletions":13,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/sampling/sampling_estimator_persistent_ndv_test.cpp","lines":["@@ -257,6 +257,19 @@ TEST_F(PersistentNDVTest, ServesPersistedNDV) {","     });"," }"," ","+TEST_F(PersistentNDVTest, TryEstimateServesPersistedStatsWithoutSampleFallback) {","+    persistNDV(kPersistedNDV);","+    withEstimator([&](SamplingEstimatorForTesting& estimator) {","+        const auto served = estimator.tryEstimateNDVFromPersistentStats({{.path = \"a\"}});","+        ASSERT_TRUE(served.has_value());","+        ASSERT_EQ(served->toDouble(), kPersistedNDV);","+","+        // Field \"b\" has no persisted statistic; unlike estimateNDV(), this must report a miss","+        // rather than fall back to the sample.","+        ASSERT_FALSE(estimator.tryEstimateNDVFromPersistentStats({{.path = \"b\"}}).has_value());","+    });","+}","+"," TEST_F(PersistentNDVTest, FallsBackWhenDisabled) {","     persistNDV(kPersistedNDV);"," "],"additions":13,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/optimizer/join/cardinality_estimator.cpp","lines":["@@ -26,6 +26,58 @@ using namespace cost_based_ranker;"," // query, since only estimates that are not served from the memo are charged to 'ceTimeMicros'."," MONGO_FAIL_POINT_DEFINE(sleepWhileEstimatingJoinCardinality);"," ","+namespace {","+// Returns the join key fields of 'edge' on the side of 'nodeId'. Note that we track $expr","+// predicates as their NDV computation is slightly different due to $expr equality semantics.","+std::vector<ce::FieldPathAndEqSemantics> joinKeyFields(const JoinReorderingContext& ctx,","+                                                       const JoinEdge& edge,","+                                                       NodeId nodeId) {","+    std::vector<ce::FieldPathAndEqSemantics> fields;","+    for (auto&& joinPred : edge.predicates) {","+        tassert(11352502,","+                \"join predicate selectivity estimation only supported for equality\",","+                joinPred.isEquality());","+        auto pathId = nodeId == edge.left ? joinPred.left : joinPred.right;","+        fields.push_back({.path = ctx.resolvedPaths[pathId].underlyingFieldPath,","+                          .isExprEq = joinPred.op == JoinPredicate::Operator::ExprEq});","+    }","+    return fields;","+}","+","+// Estimates the NDV of the join key of 'edge' on the side of 'nodeId'. Returns boost::none if that","+// requires sampling and 'allowSampling' is false.","+boost::optional<CardinalityEstimate> joinKeyNdv(","+    const JoinReorderingContext& ctx,","+    const SamplingEstimatorMap& samplingEstimators,","+    const JoinEdge& edge,","+    NodeId nodeId,","+    bool allowSampling,","+    OpDebug::JoinOptimizationMetrics::PlanEnumerationMetrics& metrics) {","+    auto& nss = ctx.joinGraph.getNode(nodeId).collectionName;","+    auto fields = joinKeyFields(ctx, edge, nodeId);","+    std::set<FieldPath> fieldNames;","+    for (auto&& field : fields) {","+        fieldNames.emplace(field.path);","+    }","+","+    auto& samplingEstimator = samplingEstimators.at(nss);","+","+    // We are able to optimize NDV estimation if we know that the join key fields represent unique","+    // data. In that case, the NDV is simply the collection cardinality.","+    if (ctx.uniqueFieldInfo.contains(nss) &&","+        fieldsAreUnique(fieldNames, ctx.uniqueFieldInfo.at(nss))) {","+        ++metrics.numUniqueIndexesUsedForNDV;","+        return CardinalityEstimate(samplingEstimator->getCollCard().cardinality(),","+                                   EstimationSource::Metadata);","+    }","+    if (allowSampling) {","+        // Will use persisted NDV stats if available and use the sample otherwise.","+        return samplingEstimator->estimateNDV(fields);","+    }","+    return samplingEstimator->tryEstimateNDVFromPersistentStats(fields);","+}","+}  // namespace","+"," JoinCardinalityEstimator::JoinCardinalityEstimator(const JoinReorderingContext& ctx,","                                                    EdgeSelectivities edgeSelectivities)","     : _ctx(ctx),","@@ -109,6 +161,12 @@ EdgeSelectivities JoinCardinalityEstimator::estimateEdgeSelectivities("," //"," // If we are in case (2), we again can estimate Card(P) via NDV(FK) on either side, since we assume"," // both sides reference the primary key. Again, we use the side with the smaller CE for simplicity.","+//","+// The smaller-CE assumption fails when the foreign table is smaller than the primary table it","+// references, in which case NDV(FK) < Card(P) and we overestimate the selectivity. By the principle","+// of inclusion NDV(FK) <= NDV(PK) = Card(P), so max(NDV(left), NDV(right)) estimat