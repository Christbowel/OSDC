{"id":"c9b824d9d3730259e0875a303023bfd9bde6f1d1","axis":"silent","repo":"pnpm/pnpm","sha":"c9b824d9d3730259e0875a303023bfd9bde6f1d1","parsed":{"files":[{"path":".changeset/prune-direct-deps-workspace-root.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/deps.status\": patch","+\"@pnpm/installing.deps-restorer\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`verifyDepsBeforeRun` no longer treats the workspace root as up to date after a filtered install with `pruneDirectDependencies: true` skipped it [pnpm/tasks#181](https://github.com/pnpm/tasks/issues/181)."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines/selection.rs","lines":["@@ -182,7 +182,7 @@ fn select_workspace_projects_with_cycles(","     let active_dir = manifest_path.parent().expect(\"manifest path always has a parent dir\");","     let active_manifest_is_standin =","         configuration::active_manifest_is_standin(active_dir, &projects)?;","-    let install_dirs = install_dirs(&resolved.selected_dirs, &projects, &workspace_root);","+    let install_dirs = install_dirs(&resolved.selected_dirs, &projects, &workspace_root, cfg);"," ","     Ok(Some(NarrowedWorkspace {","         selection: InstallFamilySelection {","@@ -249,17 +249,23 @@ fn selected_project_dirs(selection: &RecursiveSelection<'_>) -> Arc<HashSet<Path"," }"," "," /// The selected projects plus the workspace root project, when the","-/// workspace root is a project.","+/// workspace root is a project and the install does not prune direct","+/// dependencies on a filtered selection."," fn install_dirs(","     selected_dirs: &HashSet<PathBuf>,","     projects: &[pnpm_workspace::Project],","     workspace_root: &Path,","+    cfg: &Config,"," ) -> HashSet<PathBuf> {","-    let normalized_workspace_root = pnpm_fs::lexical_normalize(workspace_root);","     let mut install_dirs = selected_dirs.clone();","-    if let Some(workspace_root_project) = projects","-        .iter()","-        .f