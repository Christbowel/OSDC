   .success();","+","+    assert!(!workspace.join(\"node_modules/@pnpm.e2e/foo\").exists());","+    assert!(workspace.join(\"foo/node_modules/@pnpm.e2e/foo\").exists());","+","+    let read_state = || -> serde_json::Value {","+        serde_json::from_str(","+            &fs::read_to_string(workspace.join(\"node_modules/.pnpm-workspace-state-v1.json\"))","+                .expect(\"read workspace state\"),","+        )","+        .expect(\"parse workspace state\")","+    };","+    let state = read_state();","+    assert_eq!(state[\"filteredInstall\"], json!(true));","+    let manifests = state[\"validation\"][\"manifests\"]","+        .as_object()","+        .expect(\"validation.manifests must be an object\");","+    assert_eq!(manifests.keys().collect::<Vec<_>>(), vec![\"foo\"]);","+","+    let output = pacquet_in(&workspace)","+        .with_args([","+            \"--filter=foo\",","+            \"--workspace-root\",","+            \"--config.verify-deps-before-run=error\",","+            \"exec\",","+            \"node\",","+            \"-e\",","+            \"0\",","+        ])","+        .output()","+        .expect(\"spawn pacquet exec\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(","+        !output.status.success()","+            && stderr.contains(\"Workspace package root has dependencies but was not installed\"),","+        \"expected workspace root not installed error:\\n{stderr}\",","+    );","+    let manifests = read_state()[\"validation\"][\"manifests\"]","+        .as_object()","+        .expect(\"validation.manifests must be an object\")","+        .keys()","+        .cloned()","+        .collect::<Vec<_>>();","+    assert_eq!(manifests, vec![\"foo\"]);","+","+    pacquet_in(&workspace)","+        .with_args([","+            \"--filter=foo\",","+            \"--workspace-root\",","+            \"--config.verify-deps-before-run=install\",","+            \"exec\",","+            \"node\",","+            \"-e\",","+            \"0\",","+        ])","+        .assert()","+        .success();","+    assert!(workspace.join(\"node_modules/@pnpm.e2e/foo\").exists());","+    let state = read_state();","+    assert_eq!(state[\"filteredInstall\"], json!(false));","+    let mut manifests = state[\"validation\"][\"manifests\"]","+        .as_object()","+        .expect(\"validation.manifests must be an object\")","+        .keys()","+        .cloned()","+        .collect::<Vec<_>>();","+    manifests.sort();","+    assert_eq!(manifests, vec![\".\", \"foo\"]);","+","+    drop((root, mock_instance));","+}","+"," /// A filtered install leaves the workspace dependencies of the projects it"," /// selected without a modules directory too, but the install the gate spawns"," /// for a filtered command selects them, so the status check has to hold them"],"additions":100,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -259,6 +259,10 @@ pub struct Config {","     /// true to hoist them for you.","     pub shamefully_hoist: bool,"," ","+    /// Whether to prune direct dependencies that were removed from `package.json`,","+    /// and leave unselected workspace projects untouched during a filtered install.","+    pub prune_direct_dependencies: bool,","+","     /// The location where all packages are saved on disk. Share a","     /// writable store only between mutually trusted users, jobs, and","     /// processes."],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_package_from_registry/tests.rs","lines":["@@ -32,6 +32,7 @@ fn create_config("," ) -> Config {","     Config {","         node_linker_excluded: Vec::new(),","+        prune_direct_dependencies: false,","         tools: std::collections::BTreeMap::new(),","         indexes_by_ecosystem: std::collections::BTreeMap::new(),","         network_concurrency_by_registry: std::collections::BTreeMap::new(),"],"additions":1,"deletions":0,"truncated":false},{"path":