"+\tgot := EnvironWithoutSystemdServiceVars([]string{","+\t\t\"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\",","+\t\t\"NOTIFY_SOCKET=/run/systemd/notify\",","+\t\t\"HOME=/home/user\",","+\t\t\"WATCHDOG_PID=1234\",","+\t\t\"WATCHDOG_USEC=60000000\",","+\t\t\"LISTEN_FDS=2\",","+\t\t\"LISTEN_PID=1\",","+\t\t\"LISTEN_FDNAMES=tailscaled.socket\",","+\t\t\"INVOCATION_ID=57fad4dc31874d3882b8907c50d167a2\",","+\t\t\"JOURNAL_STREAM=9:1234567\",","+\t\t\"USER=ubuntu\",","+\t})","+\twant := []string{","+\t\t\"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\",","+\t\t\"HOME=/home/user\",","+\t\t\"USER=ubuntu\",","+\t}","+\tif !slices.Equal(got, want) {","+\t\tt.Errorf(\"got %q; want %q\", got, want)","+\t}","+","+\t// A nil env means the current environment.","+\tt.Setenv(\"NOTIFY_SOCKET\", \"/fake/systemd/notify\")","+\tgot = EnvironWithoutSystemdServiceVars(nil)","+\tfor _, kv := range got {","+\t\tif strings.HasPrefix(kv, \"NOTIFY_SOCKET=\") {","+\t\t\tt.Errorf(\"current-environment form leaked %q\", kv)","+\t\t}","+\t}","+\tfound := false","+\tfor _, kv := range os.Environ() {","+\t\tif kv == \"NOTIFY_SOCKET=/fake/systemd/notify\" {","+\t\t\tfound = true","+\t\t}","+\t}","+\tif !found {","+\t\tt.Errorf(\"test setup: NOTIFY_SOCKET not in os.Environ()\")","+\t}","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"ssh/tailssh/incubator.go","lines":["@@ -92,6 +92,10 @@ func tryExecInDir(ctx context.Context, dir string) error {"," \trun := func(path string) error {"," \t\tcmd := exec.CommandContext(ctx, path)"," \t\tcmd.Dir = dir","+\t\t// The probe runs in the daemon's environment. Strip the systemd","+\t\t// service-instance variables; see","+\t\t// hostinfo.EnvironWithoutSystemdServiceVars.","+\t\tcmd.Env = hostinfo.EnvironWithoutSystemdServiceVars(nil)"," \t\treturn cmd.Run()"," \t}"," "],"additions":4,"deletions":0,"truncated":false},{"path":"ssh/tailssh/monitor.go","lines":["@@ -197,11 +197,12 @@ func beMonitor(args []string) error {"," // Both raw socketpair ends are close-on-exec at creation, as is the"," // parent end's wrapUnixConn dup."," //","-// env is used exactly as given: a nil env gives the child an empty","-// environment, never the spawner's. Callers spawn the privileged","-// monitor with the daemon's environment and user-identity children with","-// none, so the daemon's environment never reaches a child running as","-// the connection's user.","+// env is used exactly as given. A nil env gives the child an empty","+// environment, never the spawner's. Callers give the privileged","+// monitor the daemon's environment without the systemd service","+// variables, and give user-identity children an empty environment.","+// The daemon's environment never reaches a child running as the","+// connection's user."," func spawnRPCChild(prefix, exe string, argv, env []string, attr *syscall.SysProcAttr) (*exec.Cmd, *net.UnixConn, error) {"," \tpair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM, 0)"," \tif err != nil {"],"additions":6,"deletions":5,"truncated":false},{"path":"ssh/tailssh/monitor_client.go","lines":["@@ -25,6 +25,8 @@ import ("," \t\"sync\""," \t\"syscall\""," \t\"time\"","+","+\t\"tailscale.com/hostinfo\""," )"," "," // monitorSpawnPrefix is the argv prefix following the executable path,","@@ -48,8 +50,13 @@ func spawnMonitor(exe string, uid, gid uint32, groups []uint32, localUser string"," \t\t\"--local-user=\"+localUser,"," \t\t\"--rpc-fd=3\","," \t)","-\t// The monitor is its own session leader.","-\tcmd, parentConn, err := spawnRPCChild(\"ssh-monitor\", exe, argv, os.Environ(), &syscall.SysProcAttr{Setsid: true})","+\t// The monitor is its own session leader. It is a tailscaled","+\t// re-exec, not a service instance. Give it the daemon's environment","+\t// without the systemd service variables, so neither the monitor","+\t// nor any helper it execs can notify the tailscaled unit. See","+\t// [hostinfo.EnvironWithoutSystemdServiceVars].","+\tcmd, parentConn, err := spawnRPCChild(\"ssh-monitor\", exe, argv,","+\t\thostinfo.EnvironWithoutSystemdServiceVars(nil), &syscall.SysProcAttr{Setsid: true})"," \tif err != nil {"," \t\treturn nil, err"," \t}"],"additions":9,"deletions":2,"truncated":false},{"path":"ssh/tailssh/monitor_env_test.go","lines":["@@ -0,0 +1,126 @@","+// Copyright (c) Tailscale Inc & contributors","+// SPDX-License-Identifier: BSD-3-Clause","+","+//go:build linux && !android","+","+package tailssh","+","+import (","+\t\"fmt\"","+\t\"net\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\tgliderssh \"github.com/tailscale/gliderssh\"","+\tgossh \"golang.org/x/crypto/ssh\"","+)","+","+// TestNotifySocketDoesNotReachChildren runs a real session through a","+// real monitor with NOTIFY_SOCKET set. The session child and the","+// monitor must not hold the variable. Nothing may send a notification","+// to the socket. The socket check is best effort, because it only","+// observes the daemon-side loginctl probes, which run on Debian-family","+// hosts. Hostinfo's TestLogindProbesDropSystemdServiceEnv pins the","+// probe's own environment.","+func TestNotifySocketDoesNotReachChildren(t *testing.T) {","+\tsockPath := filepath.Join(t.TempDir(), \"notify\")","+\tln, err := net.ListenUnixgram(\"unixgram\", &net.UnixAddr{Name: sockPath, Net: \"unixgram\"})","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tdefer ln.Close()","+\tnotifications := make(chan string, 16)","+\tgo func() {","+\t\tfor {","+\t\t\tb := make([]byte, 4096)","+\t\t\tn, rerr := ln.Read(b)","+\t\t\tif rerr != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\tselect {","+\t\t\tcase notifications <- string(b[:n]):","+\t\t\tdefault:","+\t\t\t}","+\t\t}","+\t}()","+","+\t// The daemon-side environment, as under a Type=notify systemd unit.","+\tt.Setenv(\"NOTIFY_SOCKET\", sockPath)","+","+\tconnCh := make(chan *conn, 1)","+\taddr := newMonitorSessionServer(t, func(c *conn, s gliderssh.Session) {","+\t\tselect {","+\t\tcase connCh <- c:","+\t\tdefault:","+\t\t}","+\t\tc.newSSHSession(s).run()","+\t})","+","+\tcl, err := gossh.Dial(\"tcp\", addr, &gossh.ClientConfig{","+\t\tHostKeyCallback: gossh.InsecureIgnoreHostKey(),","+\t\tTimeout:         15 * time.Second,","+\t})","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tdefer cl.Close()","+\ts, err := cl.NewSession()","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tvar out sessTestBuffer","+\ts.Stdout = &out","+\ts.Stderr = &out","+\tif err := s.Run(\"echo ENV-BEGIN; env; echo ENV-END\"); err != nil {","+\t\tt.Logf(\"session command: %v\", err)","+\t}","+","+\t// The session child must not see the notify socket in its","+\t// environment.","+\tenvOut := out.String()","+\tif !strings.Contains(envOut, \"ENV-BEGIN\") {","+\t\tt.Fatalf(\"no session output; got %q\", envOut)","+\t}","+\tif strings.Contains(envOut, \"NOTIFY_SOCKET=\") {","+\t\tt.Errorf(\"session child environment contains NOTIFY_SOCKET:\\n%s\", envOut)","+\t}","+","+\t// The monitor process must not hold the daemon's systemd","+\t// service-instance variables either.","+\tvar c *conn","+\tselect {","+\tcase c = <-connCh:","+\tcase <-time.After(10 * time.Second):","+\t\tt.Fatal(\"session never started\")","+\t}","+\tvar mc *monitorClient","+\tdeadline := time.Now().Add(10 * time.Second)","+\tfor mc == nil {","+\t\tmc = c.connMonitorIfAny()","+\t\tif mc == nil {","+\t\t\tif time.Now().After(deadline) {","+\t\t\t\tt.Fatal(\"connection monitor never spawned\")","+\t\t\t}","+\t\t\ttime.Sleep(50 * time.Millisecond)","+\t\t}","+\t}","+\tmonEnv, err := os.ReadFile(fmt.Sprintf(\"/proc/%d/environ\", mc.Pid()))","+\tif err != nil {","+\t\tt.Fatalf(\"reading monitor (pid %d) environment: %v\", mc.Pid(), err)","+\t}","+\tfor _, kv := range strings.Split(string(monEnv), \"\\x00\") {","+\t\tif strings.HasPrefix(kv, \"NOTIFY_SOCKET=\") {","+\t\t\tt.Errorf(\"ssh-monitor child environment contains %q\", kv)","+\t\t}","+\t}","+","+\t// No child may send notifications to the notify socket.","+\tselect {","+\tcase n := <-notifications:","+\t\tt.Errorf(\"notification sent by a child process: %q\", n)","+\tcase <-time.After(2 * time.Second):","+\t}","+}",""],"additions":126,"deletions":0,"truncated":false}],"additions":280,"deletions":9,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-29T15:20:01.302557+00:00"}