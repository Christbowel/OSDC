{"id":"GHSA-7wch-p9px-956x","axis":"advisories","repo":"digitalbazaar/forge","sha":"412345db583cd28a9d23636d0d93e9f751b935f3","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -45,6 +45,23 @@ Forge ChangeLog","     - Mike Read.","   - CVE ID: [CVE-TBD]()","   - GHSA ID: [GHSA-rhr8-3pm8-cq29](https://github.com/digitalbazaar/forge/security/advisories/GHSA-rhr8-3pm8-cq29)","+- **HIGH**: Regular expression denial of service in PEM decoding.","+  - An Inefficient Regular Expression Complexity (CWE-1333) vulnerability in","+    node-forge versions 1.4.0 and below enables remote, unauthenticated","+    attackers to block the event loop with small crafted inputs to","+    `pem.decode()` and the APIs that parse PEM, such as","+    `pki.certificateFromPem()` and `pki.privateKeyFromPem()`. The regular","+    expression that splits PEM messages takes polynomial time on input","+    without a matching END line; a 30 KB input took over 20 seconds. The","+    regular expressions that parse encapsulated headers took quadratic time","+    on long header lines.","+  - Reported by:","+    - Ahmed Mokhtari (@AhmedMokhtari), @mwlik, and @imenyoo2.","+    - @offset.","+    - @bibu123456.","+    - @Mucahic.","+  - CVE ID: [CVE-TBD]()","+  - GHSA ID: [GHSA-7wch-p9px-956x](https://github.com/digitalbazaar/forge/security/advisories/GHSA-7wch-p9px-956x)"," "," ### Fixed"," - [rsa] Require a canonical DER DigestInfo in RSASSA PKCS#1 v1.5 signature","@@ -61,6 +78,9 @@ Forge ChangeLog","     the inner BIT STRING value (after its leading unused bits octet) with","     `asn1.fromDer()`. Common structures such as SubjectPublicKeyInfo only use","     one level.","+- [pem] Find PEM messages and parse encapsulated headers in linear time.","+  Messages are matched as before, except that a BEGIN line's label is the","+  shortest one followed by `-----` (RFC 7468 labels can't contain `--`)."," "," ## 1.4.0 - 2026-03-24"," "],"additions":20,"deletions":0,"truncated":false},{"path":"lib/pem.js","lines":["@@ -96,12 +96,14 @@ pem.decode = function(str) {","   var rval = [];"," ","   // split string into PEM messages (be lenient w/EOF on BEGIN line)","-  var rMessage = /\\s*-----BEGIN ([A-Z0-9- ]+)-----\\r?\\n?([\\x21-\\x7e\\s]+?(?:\\r?\\n\\r?\\n))?([:A-Za-z0-9+\\/=\\s]+?)-----END \\1-----/g;","-  var rHeader = /([\\x21-\\x7e]+):\\s*([\\x21-\\x7e\\s^:]+)/;","+  var messages = _pemMessageScanner(str);","+  // the name must start at the beginning of a run of printable chars, which","+  // gives the same match as an unanchored search without quadratic retries","+  var rHeader = /(?:^|[^\\x21-\\x7e])([\\x21-\\x7e]+):\\s*([\\x21-\\x7e\\s^:]+)/;","   var rCRLF = /\\r?\\n/;","   var match;","   while(true) {","-    match = rMessage.exec(str);","+    match = messages.next();","     if(!match) {","       break;","     }","@@ -133,7 +135,7 @@ pem.decode = function(str) {","     var li = 0;","     while(match && li < lines.length) {","       // get line, trim any rhs whitespace","-      var line = lines[li].replace(/\\s+$/, '');","+      var line = rtrim(lines[li]);"," ","       // RFC2822 unfold any following folded lines","       for(var nl = li + 1; nl < lines.length; ++nl) {","@@ -235,3 +237,174 @@ function foldHeader(header) {"," function ltrim(str) {","   return str.replace(/^\\s+/, '');"," }","+","+// a loop, since /\\s+$/ is quadratic on whitespace followed by non-whitespace","+function rtrim(str) {","+  var end = str.length;","+  while(end > 0 && /\\s/.test(str.charAt(end - 1))) {","+    --end;","+  }","+  return str.substring(0, end);","+}","+","+/**","+ * Creates a scanner for the PEM messages in a string. It finds the same","+ * matches as this regular expression, except that only the shortest label","+ * followed by '-----' is tried (RFC 7468 labels can't contain '--'):","+ *","+ * /\\s*-----BEGIN ([A-Z0-9- ]+)-----\\r?\\n?([\\x21-\\x7e\\s]+?(?:\\r?\\n\\r?\\n))?","+ *   ([:A-Za-z0-9+\\/=\\s]+?)-----END \\1-----/g","+ *","+ * The regular expression takes polynomial time on input without a matching","+ * END line. The scanner indexes the END lines once instead, so each BEGIN","+ * line is matched without rescanning the input.","+ *","+ * @param str the string to scan.","+ *","+ * @return an object whose next() returns the next match as","+ *   [match, label, headers, body] (headers may be undefined), or null.","+ */","+function _pemMessageScanner(str) {","+  var rBody = /[:A-Za-z0-9+\\/=\\s]/;","+  var rNotBody = /[^:A-Za-z0-9+\\/=\\s]/g;","+  var rNotHeader = /[^\\x21-\\x7e\\s]/g;","+  var rLabel = /[A-Z0-9- ]/;","+","+  // index of the first char at or after i matched by a global regex","+  function indexOfRegex(regex, i) {","+    regex.lastIndex = i;","+    var match = regex.exec(str);","+    return match ? match.index : str.length;","+  }","+","+  // shortest label at i followed by '-----', or null","+  function labelAt(i) {","+    for(var j = i; j < str.length && rLabel.test(str.charAt(j)); ++j) {","+      if(j > i && str.substr(j, 5) === '-----') {","+        return str.substring(i, j);","+      }","+    }","+    return null;","+  }","+","+  // end of a blank line (\\r?\\n\\r?\\n) starting at i, or -1","+  function blankLineEnd(i) {","+    if(str.charAt(i) === '\\r') {","+      ++i;","+    }","+    if(str.charAt(i) !== '\\n') {","+      return -1;","+    }","+    if(str.charAt(++i) === '\\r') {","+      ++i;","+    }","+    return str.charAt(i) === '\\n' ? i + 1 : -1;","+  }","+","+  // first i in [start, end) where a blank line ends before end, or -1","+  function firstBlankLine(start, end) {","+    for(var i = start; i < end; ++i) {","+      var v = blankLineEnd(i);","+      if(v !== -1 && v < end) {","+        return i;","+      }","+    }","+    return -1;","+  }","+","+  // the headers group ends at a blank line inside the run of body chars","+  // before an END line; index END lines by label, with the first such","+  // blank line","+  var ends = {};","+  for(var end = str.indexOf('-----END '); end !== -1;","+    end = str.indexOf('-----END ', end + 1)) {","+    var endLabel = labelAt(end + 9);","+    var start = end;","+    while(start > 0 && rBody.test(str.charAt(start - 1))) {","+      --start;","+    }","+    var blank = firstBlankLine(start, end);","+    if(endLabel !== null && blank !== -1) {","+      var key = '$' + endLabel;","+      (ends[key] = ends[key] || []).push({end: end, blank: blank});","+    }","+  }","+","+  var pos = 0;","+  var headerEnd = -1;","+  return {","+    next: function() {","+      var begin;","+      while((begin = str.indexOf('-----BEGIN ', pos)) !== -1) {","+        pos = begin + 1;","+        var label = labelAt(begin + 11);","+        if(label === null) {","+          continue;","+        }","+        var q = begin + 16 + label.length;","+","+        // the body is the run of body chars that ends at a matching END line","+        var bodyEnd = indexOfRegex(rNotBody, q);","+        var bodyEndOk = str.substr(bodyEnd, 9) === '-----END ' &&","+          labelAt(bodyEnd + 9) === label;","+        // headers chars end here (q never decreases between BEGIN lines)","+        if(q > headerEnd) {","+          headerEnd = indexOfRegex(rNotHeader, q);","+        }","+        // first later matching END line with a blank line before it","+        var later = null;","+        var list = ends['$' + label];","+        if(list) {","+          var lo = 0;","+          var hi = list.length;","+          while(lo < hi) {","+            var mid = (lo + hi) >> 1;","+            if(list[mid].end > bodyEnd) {","+              hi = mid;","+            } else {","+              lo = mid + 1;","+            }","+          }","+          later = list[lo] || null;","+        }","+","+        // \\r?\\n? tries to consume as much as possible first","+        var starts = [];","+        if(str.charAt(q) === '\\r') {","+          if(str.charAt(q + 1) === '\\n') {","+            starts.push(q + 2);","+          }","+          starts.push(q + 1);","+        } else if(str.charAt(q) === '\\n') {","+          starts.push(q + 1);","+        }","+        starts.push(q);","+","+        for(var i = 0; i < starts.length; ++i) {","+          var t = starts[i];","+          // optional headers: up to the first blank line that a non-empty","+          // body and the END line follow","+          var blank = bodyEndOk ? firstBlankLine(t + 1, bodyEnd) : -1;","+          var end = bodyEnd;","+          if(blank === -1 && later) {","+            blank = later.blank;","+            end = later.end;","+          }","+          if(blank !== -1 && blank <= headerEnd) {","+            var v = blankLineEnd(blank);","+            pos = end + 14 + label.length;","+            return [str.substring(begin, pos), label,","+              str.substring(t, v), str.substring(v, end)];","+          }","+          // no headers","+          if(bodyEndOk && t < bodyEnd) {","+            pos = bodyEnd + 14 + label.length;","+            return [str.substring(begin, pos), label,","+              undefined, str.substring(t, bodyEnd)];","+          }","+        }","+      }","+      return null;","+    }","+  };","+}"],"additions":177,"deletions":4,"truncated":false},{"path":"tests/pocs/ghsa-7wch-p9px-956x.js","lines":["@@ -0,0 +1,27 @@","+#!/usr/bin/env node","+'use strict';","+","+// Security Advisory PoC","+//","+// https://github.com/digitalbazaar/forge/security/advisories/GHSA-7wch-p9px-956x","+//","+// Reported by Ahmed Mokhtari (@AhmedMokhtari), @mwlik, and @imenyoo2.","+//","+// pem.decode() used a regular expression that takes polynomial time on","+// input without a matching END line. Before the fix, this input blocked for","+// many seconds, growing roughly with the cube of its length. Inputs from the","+// duplicate reports are in the unit tests.","+","+const forge = require('../../lib/index');","+","+const pemString = ' -----BEGIN I-----G-----END B'.repeat(800) + '\\x00';","+","+console.time('ReDoS');","+try {","+  // const pemObjects = forge.pki.privateKeyFromPem(pemString);","+  const pemObjects = forge.pem.decode(pemString);","+  console.log(pemObjects);","+} catch(err) {","+  console.error('PEM decode error:', err.message);","+}","+console.timeEnd('ReDoS');"],"additions":27,"deletions":0,"truncated":false},{"path":"tests/unit/pem.js","lines":["@@ -155,5 +155,103 @@ var PEM = require('../../lib/pem');","         ASSERT.equal(csrs[i].type, 'CERTIFICATE REQUEST');","       }","     });","+","+    it('should decode lenient PEM forms', function() {","+      var tests = [{","+        pem: '-----BEGIN A-----\\nQUJD\\n-----END A-----\\n',","+        type: 'A',","+        body: 'ABC'","+      }, {","+        // no line break after the BEGIN line","+        pem: '-----BEGIN A-----QUJD-----END A-----',","+        type: 'A',","+        body: 'ABC'","+      }, {","+        pem: '-----BEGIN A-----\\n-----END A-----',","+        type: 'A',","+        body: ''","+      }, {","+        // mismatched END line, then a complete message","+        pem: 'text\\n-----BEGIN A-----\\nQUJD\\n-----END B-----\\n' +","+          '-----BEGIN B-----\\r\\nREVG\\r\\n-----END B-----\\r\\ntext',","+        type: 'B',","+        body: 'DEF'","+      }, {","+        pem: '-----BEGIN A-----\\r\\n' +","+          'Proc-Type: 4,ENCRYPTED\\r\\n' +","+          'DEK-Info: DES-CBC,F8143EDE5960C597\\r\\n' +","+          'X-Header:  a, b   \\r\\n' +","+          '\\r\\n' +","+          'QUJD\\r\\n' +","+          '-----END A-----\\r\\n',","+        type: 'A',","+        body: 'ABC',","+        procType: {version: '4', type: 'ENCRYPTED'},","+        dekInfo: {algorithm: 'DES-CBC', parameters: 'F8143EDE5960C597'},","+        headers: [{name: 'X-Header', values: ['a', 'b']}]","+      }];","+      tests.forEach(function(test) {","+        var msgs = PEM.decode(test.pem);","+        ASSERT.equal(msgs.length, 1);","+        ASSERT.equal(msgs[0].type, test.type);","+        ASSERT.equal(msgs[0].body, test.body);","+        ASSERT.deepEqual(msgs[0].procType, test.procType || null);","+        ASSERT.deepEqual(msgs[0].dekInfo, test.dekInfo || null);","+        ASSERT.deepEqual(msgs[0].headers, test.headers || []);","+      });","+    });","+","+    describe('GHSA-7wch-p9px-956x ReDoS checks', function() {","+      // see GHSA-7wch-p9px-956x and PoC in /tests/pocs/","+      // the previous regular expressions took minutes on each input below","+      function _repeat(str, count) {","+        return new Array(count + 1).join(str);","+      }","+","+      function _checkInvalid(pem) {","+        ASSERT.throws(function() {","+          PEM.decode(pem);","+        },","+        /^Error: Invalid PEM formatted message.$/);","+      }","+","+      it('should reject repeated unmatched BEGIN lines', function() {","+        _checkInvalid(_repeat(' -----BEGIN I-----G-----END B', 2000) + '\\x00');","+      });","+","+      it('should reject a BEGIN line followed by newlines', function() {","+        _checkInvalid('-----BEGIN A-----\\n' + _repeat('\\n', 256 * 1024));","+      });","+","+      it('should reject a BEGIN line followed by blank lines', function() {","+        _checkInvalid(","+          '-----BEGIN RSA-----\\n' + _repeat('\\n\\n', 128 * 1024) + 'ZZZZ');","+      });","+","+      it('should decode a long header line without a colon', function() {","+        var msgs = PEM.decode('-----BEGIN A-----\\n' +","+          _repeat('A', 512 * 1024) + '\\n\\nQUJD\\n-----END A-----\\n');","+        ASSERT.equal(msgs.length, 1);","+        ASSERT.equal(msgs[0].body, 'ABC');","+        ASSERT.equal(msgs[0].procType, null);","+      });","+","+      it('should decode a header line with trailing whitespace', function() {","+        var msgs = PEM.decode('-----BEGIN A-----\\n' +","+          'Proc-Type: 4,ENCRYPTED\\n' +","+          'DEK-Info: DES-CBC,F8143EDE5960C597\\n' +","+          'X-Header: ' + _repeat(' ', 512 * 1024) + 'x\\n' +","+          '\\nQUJD\\n-----END A-----\\n');","+        ASSERT.equal(msgs.length, 1);","+        ASSERT.equal(msgs[0].body, 'ABC');","+        ASSERT.deepEqual(msgs[0].headers, [{name: 'X-Header', values: ['x']}]);","+      });","+","+      it('should only use the shortest label followed by dashes', function() {","+        // RFC 7468 labels can't contain '--'; previously 'A-----B' was used","+        _checkInvalid(","+          '-----BEGIN A-----B-----\\nQUJD\\n-----END A-----B-----\\n');","+      });","+    });","   });"," })();",""],"additions":98,"deletions":0,"truncated":false}],"additions":322,"deletions":4,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-31T14:35:21.268311+00:00"}