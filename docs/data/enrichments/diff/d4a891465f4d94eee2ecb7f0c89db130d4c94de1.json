SingletonQuery(connection, \"CREATE TABLE roundtrip_keys(id INTEGER PRIMARY KEY, x INTEGER, p INTEGER)\");","-\tRunSingletonQuery(connection, \"INSERT INTO roundtrip_keys VALUES (0, 0, NULL), (1, 1, 3)\");","+\tRunSingletonQuery(connection, \"CREATE TABLE roundtrip_keys(id INTEGER PRIMARY KEY, x INTEGER, p INTEGER, \"","+\t                              \"items INTEGER[], amount DECIMAL(12,2))\");","+\tRunSingletonQuery(connection, \"INSERT INTO roundtrip_keys VALUES (0, 0, NULL, [0], 1.23), (1, 1, 3, [1], 4.56)\");"," \tconnection.BeginTransaction();"," "," \tconst pair<string, bool> cases[] = {{\"first(x ORDER BY p)\", true},     {\"last(x ORDER BY p)\", true},"," \t                                    {\"any_value(x ORDER BY p)\", true}, {\"arg_min(x, p)\", false},","-\t                                    {\"arg_min_null(x, p)\", false},     {\"arg_max_null(x, p)\", false}};","+\t                                    {\"arg_min_null(x, p)\", false},     {\"arg_max_null(x, p)\", false},","+\t                                    {\"first(items ORDER BY p)\", true}, {\"first(amount ORDER BY p)\", true}};"," \tfor (const auto &entry : cases) {"," \t\tCAPTURE(entry.first);"," \t\tauto plan = connection.ExtractPlan(\"SELECT \" + entry.first + \" FROM roundtrip_keys GROUP BY id\");"," \t\tauto aggregate = FindSingletonAggregate(*plan);"," \t\tREQUIRE(aggregate);","-\t\tREQUIRE(aggregate->Function().HasSingleValueIdentity() == entry.second);","+\t\tREQUIRE(aggregate->CanForwardSingletonInputDomain() == entry.second);","+\t\tCHECK_FALSE(aggregate->Function().HasSingleValueIdentity());"," \t\tfor (const auto &compatibility :"," \t\t     {StorageCompatibility::Latest(), StorageCompatibility::FromIndex(StorageVersion::V2_0_0)}) {","-\t\t\tconst bool preserves_identity = compatibility.Compare(StorageVersion::V2_1_0);","-\t\t\tCAPTURE(preserves_identity);","+\t\t\tCAPTURE(compatibility.duckdb_version);"," \t\t\tMemoryStream stream;"," \t\t\tSerializationOptions options;"," \t\t\top