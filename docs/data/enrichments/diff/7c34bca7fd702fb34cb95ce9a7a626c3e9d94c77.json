{"id":"7c34bca7fd702fb34cb95ce9a7a626c3e9d94c77","axis":"silent","repo":"matomo-org/matomo","sha":"7c34bca7fd702fb34cb95ce9a7a626c3e9d94c77","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -6,9 +6,13 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," "," ## Matomo 6.1.0"," ","+### New config.ini.php settings","+* `[log] log_format` (and `log_format_<writer>` per writer) lets the file, database, errorlog and syslog log writers write `json`, `loggly` or `logstash` instead of `text`.","+"," ### New APIs"," * The *Administration → Development → Component Library* page, available in development mode, documents the generic components, starting with the selector (`.mtm-selector`), and what each Matomo version changes in them."," * The `ExpandOnHover` Vue directive now takes the `expandedClass` option of `ExpandOnClick`, and both directives accept a list of classes for it.","+* The Monolog plugin's DI entry `log.formatter.classes` maps log format names to formatter classes and can be extended by plugins to add log formats."," "," ### Deprecations"," * The `disabled` class on a `.mtm-selector` is deprecated and will be removed in Matomo 7; use the `mtm-selector--disabled` modifier instead."],"additions":4,"deletions":0,"truncated":false},{"path":"config/global.ini.php","lines":["@@ -125,9 +125,21 @@"," ; this allows you to log more information to one backend vs another."," ; log_level_screen ="," ; log_level_file =","+; log_level_database ="," ; log_level_errorlog ="," ; log_level_syslog ="," ","+; format of the log entries written by the file, database, errorlog and syslog writers.","+; possible values are: text, json, loggly, logstash","+; the screen writer always uses text.","+log_format = text","+","+; you can also set specific log formats for different writers, by appending the writer name to log_format_, like so:","+; log_format_file =","+; log_format_database =","+; log_format_errorlog =","+; log_format_syslog =","+"," ; if configured to log in a file, log entries will be made to this file"," logger_file_path = tmp/logs/matomo.log"," "],"additions":12,"deletions":0,"truncated":false},{"path":"plugins/Monolog/Formatter/FormatterFactory.php","lines":["@@ -0,0 +1,74 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Monolog\\Formatter;","+","+use Monolog\\Formatter\\FormatterInterface;","+use Piwik\\Container\\Container;","+","+/**","+ * Creates the formatter configured for a log writer via `[log] log_format_<writer>` or `[log] log_format`.","+ */","+class FormatterFactory","+{","+    public const FORMAT_TEXT = 'text';","+","+    /**","+     * @param string $textFormatterEntry DI entry of the line formatter to use for the `text` format","+     */","+    public static function createForWriter(Container $container, string $writerName, string $textFormatterEntry): FormatterInterface","+    {","+        $format = self::getConfiguredFormat($container, $writerName);","+","+        if ($format === self::FORMAT_TEXT) {","+            return self::getFormatter($container, $textFormatterEntry, $format);","+        }","+","+        /** @var array<string, string> $classes */","+        $classes = $container->get('log.formatter.classes');","+","+        if (!isset($classes[$format])) {","+            throw new \\Exception(sprintf(","+                'Invalid log format \"%s\" configured for the \"%s\" log writer. Supported formats are: %s',","+                $format,","+                $writerName,","+                implode(', ', array_merge([self::FORMAT_TEXT], array_keys($classes)))","+            ));","+        }","+","+        return self::getFormatter($container, $classes[$format], $format);","+    }","+","+    private static function getFormatter(Container $container, string $entry, string $format): FormatterInterface","+    {","+        $formatter = $container->get($entry);","+","+        if (!$formatter instanceof FormatterInterface) {","+            throw new \\Exception(sprintf('The log format \"%s\" does not resolve to a %s.', $format, FormatterInterface::class));","+        }","+","+        return $formatter;","+    }","+","+    private static function getConfiguredFormat(Container $container, string $writerName): string","+    {","+        foreach (['ini.log.log_format_' . $writerName, 'ini.log.log_format'] as $entry) {","+            $value = $container->has($entry) ? $container->get($entry) : null;","+","+            // a value that is not a string, e.g. from `log_format[] =`, is reported as invalid format by its type","+            $format = is_string($value) ? strtolower(trim($value)) : ($value === null ? '' : get_debug_type($value));","+","+            if ($format !== '') {","+                return $format;","+            }","+        }","+","+        return self::FORMAT_TEXT;","+    }","+}"],"additions":74,"deletions":0,"truncated":false},{"path":"plugins/Monolog/Formatter/JsonFormatter.php","lines":["@@ -0,0 +1,20 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Monolog\\Formatter;","+","+use Monolog\\Formatter\\JsonFormatter as MonologJsonFormatter;","+","+/**","+ * Formats a log record as one JSON object per line.","+ */","+class JsonFormatter extends MonologJsonFormatter","+{","+    use RedactSensitiveValuesTrait;","+}"],"additions":20,"deletions":0,"truncated":false},{"path":"plugins/Monolog/Formatter/LogglyFormatter.php","lines":["@@ -0,0 +1,26 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Monolog\\Formatter;","+","+use Monolog\\Formatter\\LogglyFormatter as MonologLogglyFormatter;","+","+/**","+ * Formats a log record as one JSON object per line in the format expected by Loggly.","+ */","+class LogglyFormatter extends MonologLogglyFormatter","+{","+    use RedactSensitiveValuesTrait;","+","+    // Monolog disables the newline as the format is meant for its Loggly handler, but our writers are line based","+    public function __construct(int $batchMode = self::BATCH_MODE_NEWLINES, bool $appendNewline = true)","+    {","+        parent::__construct($batchMode, $appendNewline);","+    }","+}"],"additions":26,"deletions":0,"truncated":false},{"path":"plugins/Monolog/Formatter/LogstashFormatter.php","lines":["@@ -0,0 +1,25 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Monolog\\Formatter;","+","+use Monolog\\Formatter\\LogstashFormatter as MonologLogstashFormatter;","+","+/**","+ * Formats a log record as one JSON object per line in the format expected by Logstash.","+ */","+class LogstashFormatter extends MonologLogstashFormatter","+{","+    use RedactSensitiveValuesTrait;","+","+    public function __construct(?string $systemName = null, string $extraKey = 'extra', string $contextKey = 'context')","+    {","+        parent::__construct('Matomo', $systemName, $extraKey, $contextKey);","+    }","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"plugins/Monolog/Formatter/RedactSensitiveValuesTrait.php","lines":["@@ -0,0 +1,103 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Monolog\\Formatter;","+","+use Monolog\\LogRecord;","+use Piwik\\ExceptionHandler;","+use Piwik\\Plugins\\Monolog\\Processor\\TokenProcessor;","+","+/**","+ * Applies the redactions of the text log format to the context a structured formatter writes as well.","+ *","+ * The processors only redact the message: token_auth values are removed from it and an exception is","+ * folded into it with its sensitive values and the document root replaced. Structured formatters","+ * additionally write the raw context, so the same is applied to its strings, to the normalized","+ * exception (a Throwable or the fatal error array) and to the backtrace of a PHP error.","+ */","+trait RedactSensitiveValuesTrait","+{","+    protected function normalizeRecord(LogRecord $record): array","+    {","+        $normalized = parent::normalizeRecord($record);","+","+        array_walk_recursive($normalized, function (&$value) {","+            if (is_string($value)) {","+                $value = TokenProcessor::removeTokenAuth($value);","+            }","+        });","+","+        // an empty context is a stdClass in the json formatter","+        if (!is_array($normalized['context'] ?? null)) {","+            return $normalized;","+        }","+","+        // the fatal error array is not a Throwable, so normalizeException() does not redact it","+        if (is_array($record->context['exception'] ?? null) && is_array($normalized['context']['exception'] ?? null)) {","+            $normalized['context']['exception'] = self::redactException($normalized['context']['exception']);","+        }","+","+        if (is_array($normalized['context']['trace'] ?? null)) {","+            // besides the file, closure and anonymous class names can contain the path since PHP 8.4","+            array_walk_recursive($normalized['context']['trace'], function (&$value) {","+                if (is_string($value)) {","+                    $value = str_replace(PIWIK_DOCUMENT_ROOT, '', $value);","+                }","+            });","+        }","+","+        return $normalized;","+    }","+","+    protected function normalize(mixed $data, int $depth = 0): mixed","+    {","+        $normalized = parent::normalize($data, $depth);","+","+        // the json formatter leaves objects to json_encode, decode them so their strings are redacted as well","+        if (is_object($normalized)) {","+            /** @var array<array<mixed>|scalar|null>|scalar|null $normalized */","+            $normalized = json_decode($this->toJson($normalized, true), true);","+        }","+","+        return $normalized;","+    }","+","+    /**","+     * @return array<mixed>","+     */","+    protected function normalizeException(\\Throwable $e, int $depth = 0): array","+    {","+        // previous exceptions are normalized, and so redacted, through this method as well","+        return self::redactException(parent::normalizeException($e, $depth));","+    }","+","+    /**","+     * @param array<mixed> $exception","+     * @return array<mixed>","+     */","+    private static function redactException(array $exception): array","+    {","+        foreach (['message', 'file', 'backtrace'] as $key) {","+            if (isset($exception[$key]) && is_string($exception[$key])) {","+                $exception[$key] = ExceptionHandler::replaceSensitiveValues($exception[$key]);","+            }","+        }","+","+        if (isset($exception['trace']) && is_array($exception['trace'])) {","+            foreach ($exception['trace'] as &$frame) {","+                if (is_string($frame)) {","+                    $frame = ExceptionHandler::replaceSensitiveValues($frame);","+                }","+            }","+            unset($frame);","+        }","+","+        return $exception;","+    }","+}"],"additions":103,"deletions":0,"truncated":false},{"path":"plugins/Monolog/Processor/TokenProcessor.php","lines":["@@ -20,6 +20,11 @@ class TokenProcessor"," {","     public function __invoke(LogRecord $record): LogRecord","     {","-        return $record->with(message: preg_replace('/token_auth=[0-9a-h]+/', 'token_auth=removed', $record['message']));","+        return $record->with(message: self::removeTokenAuth($record->message));","+    }","+","+    public static function removeTokenAuth(string $value): string","+    {","+        return (string) preg_replace('/token_auth=[0-9a-h]+/', 'token_auth=removed', $value);","     }"," }"],"additions":6,"deletions":1,"truncated":false},{"path":"plugins/Monolog/config/config.php","lines":["@@ -3,6 +3,7 @@"," use Piwik\\Container\\Container;"," use Piwik\\Log\\Logger;"," use Piwik\\Log;","+use Piwik\\Plugins\\Monolog\\Formatter\\FormatterFactory;"," use Piwik\\Plugins\\Monolog\\Handler\\FileHandler;"," use Piwik\\Plugins\\Monolog\\Handler\\LogCaptureHandler;"," ","@@ -111,20 +112,20 @@"," ","     'Piwik\\Plugins\\Monolog\\Handler\\FileHandler' => Piwik\\DI::create()","         ->constructor(Piwik\\DI::get('log.file.filename'), Piwik\\DI::get('log.level.file'))","-        ->method('setFormatter', Piwik\\DI::get('log.lineMessageFormatter.file')),","+        ->method('setFormatter', Piwik\\DI::get('log.formatter.file')),"," ","     'Piwik\\Plugins\\Monolog\\Handler\\ErrorLogHandler' => Piwik\\DI::autowire()","         ->constructorParameter('level', Piwik\\DI::get('log.level.errorlog'))","-        ->method('setFormatter', Piwik\\DI::get('log.lineMessageFormatter.file')),","+        ->method('setFormatter', Piwik\\DI::get('log.formatter.errorlog')),"," ","     'Piwik\\Plugins\\Monolog\\Handler\\SyslogHandler' => Piwik\\DI::autowire()","         ->constructorParameter('ident', Piwik\\DI::get('log.syslog.ident'))","         ->constructorParameter('level', Piwik\\DI::get('log.level.syslog'))","-        ->method('setFormatter', Piwik\\DI::get('log.lineMessageFormatter.file')),","+        ->method('setFormatter', Piwik\\DI::get('log.formatter.syslog')),"," ","     'Piwik\\Plugins\\Monolog\\Handler\\DatabaseHandler' => Piwik\\DI::create()","         ->constructor(Piwik\\DI::get('log.level.database'))","-        ->method('setFormatter', Piwik\\DI::get('log.lineMessageFormatter')),","+        ->method('setFormatter', Piwik\\DI::get('log.formatter.database')),"," ","     'Piwik\\Plugins\\Monolog\\Handler\\WebNotificationHandler' => Piwik\\DI::create()","         ->constructor(Piwik\\DI::get('log.level.screen'))","@@ -191,6 +192,28 @@","         return $c->get('log.level');","     }),"," ","+    'log.formatter.classes' => array(","+        'json'     => 'Piwik\\Plugins\\Monolog\\Formatter\\JsonFormatter',","+        'loggly'   => 'Piwik\\Plugins\\Monolog\\Formatter\\LogglyFormatter',","+        'logstash' => 'Piwik\\Plugins\\Monolog\\Formatter\\LogstashFormatter',","+    ),","+","+    'log.formatter.file' => Piwik\\DI::factory(function (Container $c) {","+        return FormatterFactory::createForWriter($c, 'file', 'log.lineMessageFormatter.file');","+    }),","+","+    'log.formatter.errorlog' => Piwik\\DI::factory(function (Container $c) {","+        return FormatterFactory::createForWriter($c, 'errorlog', 'log.lineMessageFormatter.file');","+    }),","+","+    'log.formatter.syslog' => Piwik\\DI::factory(function (Container $c) {","+        return FormatterFactory::createForWriter($c, 'syslog', 'log.lineMessageFormatter.file');","+    }),","+","+    'log.formatter.database' => Piwik\\DI::factory(function (Container $c) {","+        return FormatterFactory::createForWriter($c, 'database', 'log.lineMessageFormatter');","+    }),","+","     'log.file.filename' => Piwik\\DI::factory(function (Container $c) {","         $logPath = $c->get('ini.log.logger_file_path');"," ","@@ -255,6 +278,7 @@","         }"," ","         $fileHandler = new FileHandler($logFile, Logger::INFO);","+        // always text: Piwik\\CronArchive\\Performance\\Logger parses the lines of this file","         $fileHandler->setFormatter($c->get('log.lineMessageFormatter.file'));","         return [$fileHandler];","     },"],"additions":28,"deletions":4,"truncated":false},{"path":"plugins/Monolog/tests/Integration/LogFormatTest.php","lines":["@@ -0,0 +1,395 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Monolog\\tests\\Integration;","+","+use Piwik\\Application\\Environment;","+use Piwik\\Common;","+use Piwik\\Config;","+use Piwik\\Container\\Container;","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Db;","+use Piwik\\Log;","+use Piwik\\Plugins\\Monolog\\Formatter\\JsonFormatter;","+use Piwik\\Plugins\\Monolog\\Formatter\\LineMessageFormatter;","+use Piwik\\Plugins\\Monolog\\Formatter\\LogglyFormatter;","+use Piwik\\Plugins\\Monolog\\Formatter\\LogstashFormatter;","+use Piwik\\Plugins\\Monolog\\Handler\\DatabaseHandler;","+use Piwik\\Plugins\\Monolog\\Handler\\ErrorLogHandler;","+use Piwik\\Plugins\\Monolog\\Handler\\FileHandler;","+use Piwik\\Plugins\\Monolog\\Handler\\SyslogHandler;","+use Piwik\\Plugins\\Monolog\\Handler\\WebNotificationHandler;","+use Piwik\\Tests\\Framework\\TestCase\\IntegrationTestCase;","+","+/**","+ * @group Core","+ * @group Log","+ */","+class LogFormatTest extends IntegrationTestCase","+{","+    public function setUp(): void","+    {","+        parent::setUp();","+","+        Log::unsetInstance();","+","+        @unlink(self::getLogFileLocation());","+        Log::$debugBacktraceForTests = \"dummy error message\\ndummy backtrace\";","+    }","+","+    public function tearDown(): void","+    {","+        Log::unsetInstance();","+","+        @unlink(self::getLogFileLocation());","+        Log::$debugBacktraceForTests = null;","+","+        parent::tearDown();","+    }","+","+    public function testJsonFileLoggingWritesOneJsonObjectPerLine()","+    {","+        $this->recreateLogSingleton('file', ['ini.log.log_format' => 'json']);","+","+        Log::warning('first %s', 'message');","+        Log::info('second message');","+","+        $records = $this->getLogFileRecords();","+","+        $this->assertCount(2, $records);","+        $this->assertSame('first message', $records[0]['message']);","+        $this->assertSame(['message'], $records[0]['context']);","+        $this->assertSame('WARNING', $records[0]['level_name']);","+        $this->assertSame('piwik', $records[0]['channel']);","+        $this->assertSame('Monolog', $records[0]['extra']['class']);","+        $this->assertNotEmpty($records[0]['extra']['request_id']);","+        $this->assertSame('second message', $records[1]['message']);","+        $this->assertSame('INFO', $records[1]['level_name']);","+    }","+","+    public function testJsonFileLoggingKeepsExceptionDetailsInContext()","+    {","+        $this->recreateLogSingleton('file', ['ini.log.log_format' => 'json']);","+","+        Log::error(new \\Exception('dummy error message'));","+","+        $records = $this->getLogFileRecords();","+","+        $this->assertCount(1, $records);","+        $this->assertStringContainsString(\"dummy error message\\ndummy backtrace\", $records[0]['message']);","+        $this->assertSame('Exception', $records[0]['context']['exception']['class']);","+        $this->assertSame('dummy error message', $records[0]['context']['exception']['message']);","+        $this->assertStringContainsString('LogFormatTest.php:', $records[0]['context']['exception']['file']);","+    }","+","+    public function testJsonFileLoggingRedactsSensitiveValues()","+    {","+        $this->recreateLogSingleton('file', ['ini.log.log_format' => 'json']);","+","+        Config::getInstance()->mail['password'] = 'smtp-secret-value';","+","+        Log::warning('url is %s', 'index.php?token_auth=9b1cefc915ff6180071fb7dcd13ec5a4');","+        Log::error(new \\Exception('exception mentions smtp-secret-value', 0, new \\Exception('caused by smtp-secret-value')));","+","+        $contents = file_get_contents(self::getLogFileLocation());","+        $this->assertStringNotContainsString('smtp-secret-value', $contents);","+        $this->assertStringNotContainsString('9b1cefc915ff6180071fb7dcd13ec5a4', $contents);","+","+        $records = $this->getLogFileRecords();","+        $this->assertSame('url is index.php?token_auth=removed', $records[0]['message']);","+        $this->assertSame(['index.php?token_auth=removed'], $records[0]['context']);","+        $this->assertSame('exception mentions smtppass', $records[1]['context']['exception']['message']);","+        $this->assertStringStartsWith('/plugins/Monolog/tests/Integration/LogFormatTest.php:', $records[1]['context']['exception']['file']);","+        $this->assertSame('caused by smtppass', $records[1]['context']['exception']['previous']['message']);","+    }","+","+    public function testJsonFileLoggingRedactsExceptionsUnderAnyContextKey()","+    {","+        $logger = $this->recreateLogSingleton('file', ['ini.log.log_format' => 'json']);","+","+        Config::getInstance()->mail['password'] = 'smtp-secret-value';","+","+        $logger->warning('Tracker encountered an exception: {ex}', [new \\Exception('mentions smtp-secret-value')]);","+","+        $contents = file_get_contents(self::getLogFileLocation());","+        $this->assertStringNotContainsString('smtp-secret-value', $contents);","+        $this->assertStringNotContainsString(PIWIK_DOCUMENT_ROOT, $contents);","+","+        $records = $this->getLogFileRecords();","+        $this->assertSame('mentions smtppass', $records[0]['context'][0]['message']);","+        $this->assertStringStartsWith('/plugins/Monolog/tests/Integration/LogFormatTest.php:', $records[0]['context'][0]['file']);","+    }","+","+    public function testJsonFileLoggingRedactsFatalErrorAndPhpErrorContext()","+    {","+        $logger = $this->recreateLogSingleton('file', ['ini.log.log_format' => 'json']);","+","+        Config::getInstance()->mail['password'] = 'smtp-secret-value';","+","+        $logger->error('Fatal error encountered: {exception}', [","+            'exception' => [","+                'type' => E_ERROR,","+                'message' => 'fatal mentions smtp-secret-value',","+                'file' => PIWIK_DOCUMENT_ROOT . '/core/Fatal.php',","+                'line' => 12,","+                'backtrace' => ' on ' . PIWIK_DOCUMENT_ROOT . \"/core/Fatal.php(12)\\n#0 smtp-secret-value\",","+            ],","+        ]);","+        $logger->warning('Notice: something', [","+            'trace' => [[","+                'file' => PIWIK_DOCUMENT_ROOT . '/core/Notice.php',","+                'line' => 34,","+                'function' => '{closure:' . PIWIK_DOCUMENT_ROOT . '/config/global.php:12}',","+            ]],","+        ]);","+","+        $contents = file_get_contents(self::getLogFileLocation());","+        $this->assertStringNotContainsString('smtp-secret-value', $contents);","+        $this->assertStringNotContainsString(PIWIK_DOCUMENT_ROOT, $contents);","+","+        $records = $this->getLogFileRecords();","+        $this->assertSame('fatal mentions smtppass', $records[0]['context']['exception']['message']);","+        $this->assertSame('/core/Fatal.php', $records[0]['context']['exception']['file']);","+        $this->assertSame(\" on /core/Fatal.php(12)\\n#0 smtppass\", $records[0]['context']['exception']['backtrace']);","+        $this->assertSame('/core/Notice.php', $records[1]['context']['trace'][0]['file']);","+        $this->assertSame('{closure:/config/global.php:12}', $records[1]['context']['trace'][0]['function']);","+    }","+","+    public function testJsonFileLoggingRedactsObjectsInContext()","+    {","+        $logger = $this->recreateLogSingleton('file', ['ini.log.log_format' => 'json']);","+","+        $url = 'index.php?token_auth=9b1cefc915ff6180071fb7dcd13ec5a4';","+        $serializable = new class ($url) implements \\JsonSerializable {","+            public function __construct(private string $url)","+            {","+            }","+","+            public function jsonSerialize(): array","+            {","+                return ['url' => $this->url];","+            }","+        };","+        $plain = new class ($url) {","+            public function __construct(public string $url)","+            {","+            }","+        };","+","+        $logger->warning('objects', ['serializable' => $serializable, 'plain' => $plain]);","+","+        $this->assertStringNotContainsString('9b1cefc915ff6180071fb7dcd13ec5a4', file_get_contents(self::getLogFileLocation()));","+","+        $records = $this->getLogFileRecords();","+        $this->assertSame(['url' => 'index.php?token_auth=removed'], $records[0]['context']['serializable']);","+        $this->assertSame(['url' => 'index.php?token_auth=removed'], $records[0]['context']['plain']);","+    }","+","+    public function testLogstashFileLoggingRedactsExceptionTrace()","+    {","+        $this->recreateLogSingleton('file', ['ini.log.log_format' => 'logstash']);","+","+        Config::getInstance()->mail['password'] = 'smtp-secret-value';","+","+        Log::error(new \\Exception('exception mentions smtp-secret-value'));","+","+        $contents = file_get_contents(self::getLogFileLocation());","+        $this->assertStringNotContainsString('smtp-secret-value', $contents);","+        $this->assertStringNotContainsString(PIWIK_DOCUMENT_ROOT, $contents);","+","+        $records = $this->getLogFileRecords();","+        $this->assertSame('exception mentions smtppass', $records[0]['context']['exception']['message']);","+        $this->assertNotEmpty($records[0]['context']['exception']['trace']);","+        foreach ($records[0]['context']['exception']['trace'] as $frame) {","+            $this->assertStringStartsNotWith(PIWIK_DOCUMENT_ROOT, $frame);","+        }","+    }","+","+    public function testArchiveProfilingLogAlwaysUsesTextFormat()","+    {","+        $container = $this->createContainer([","+            'ini.log.log_format' => 'json',","+            'ini.Debug.archive_profiling_log' => self::getLogFileLocation(),","+        ]);","+","+        $handlers = $container->get('archiving.performance.handlers');","+","+        $this->assertInstanceOf(Line