ultSizeLevelRatio uint64 = 8"," )","@@ -25,8 +25,12 @@ const ("," // Runs in the same level have a similar size, so merging them keeps write"," // amplification low."," //","-// Level 0 holds runs below base. Level n, for n >= 1, holds runs in","-// [base*ratio^(n-1), base*ratio^n). The top level has no upper size bound.","+// Level 1 holds runs below base. Level n, for n >= 2, holds runs in","+// [base*ratio^(n-2), base*ratio^(n-1)). The top level has no upper size bound.","+//","+// Levels start at 1, because level 0 means uncompacted in the file metadata of","+// an object. The strategy groups runs by size only, so it also puts fresh runs","+// below base in level 1."," //"," // A level is full when it holds at least k runs. Each merge task holds"," // exactly k runs from one level.","@@ -36,7 +40,7 @@ type SizeLeveledStrategy struct {"," \tk     int"," }"," ","-// NewSizeLeveledStrategy returns a strategy with the given level 0 bound,","+// NewSizeLeveledStrategy returns a strategy with the given level 1 bound,"," // ratio between levels, and number of runs per merge task k."," //"," // base must be greater than 0 and ratio must be at least 2. k must be at","@@ -55,9 +59,9 @@ func NewSizeLeveledStrategy(base, ratio uint64, k int) (*SizeLeveledStrategy, er"," \treturn &SizeLeveledStrategy{base: base, ratio: ratio, k: k}, nil"," }"," ","-// level returns the index of the level that holds a run of the given size.","+// level returns the level that holds a run of the given size."," func (s *SizeLeveledStrategy) level(size uint64) int {","-\tlevel := 0","+\tlevel := 1"," \tfor bound := s.base; size >= bound; level++ {"," \t\t// The next bound would overflow uint64, so no size can reach it."," \t\tif bound > math.MaxUint64/s.ratio {","@@ -69,27 +73,27 @@ func (s *SizeLeveledStrategy) level(size uint64) int {"," }"," "," // groupByLevels returns runs grouped by level based on each run's uncompressed size.","-// The result has one entry per level up to the highest level that holds a run,","-// and empty levels are nil. Runs keep their input order within each level.","+// The result holds level n at index n-1, up to the highest level that holds a","+// run, and empty levels are nil. Runs keep their input order within each level."," func (s *SizeLeveledStrategy) groupByLevels(runs []Run) [][]Run {"," \tvar levels [][]Run"," \tfor _, run := range runs {","-\t\tlevel := s.level(run.Size())","-\t\tif level >= len(levels) {","-\t\t\tlevels = append(levels, make([][]Run, level+1-len(levels))...)","+\t\ti := s.level(run.Size()) - 1","+\t\tif i >= len(levels) {","+\t\t\tlevels = append(levels, make([][]Run, i+1-len(levels))...)"," \t\t}","-\t\tlevels[level] = append(levels[level], run)","+\t\tlevels[i] = append(levels[i], run)"," \t}"," \treturn levels"," }"," ","-// RunsPerLevel returns the number of runs in each level, from level 0 up to","+// RunsPerLevel returns the number of runs in each level, from level 1 up to"," // the highest level that holds a run."," func (s *SizeLeveledStrategy) RunsPerLevel(runs []Run) []int {"," \tlevels := s.groupByLevels(runs)"," \tcounts := make([]int, len(levels))","-\tfor i, level := range levels {","-\t\tcounts[i] = len(level)","+\tfor i, levelRuns := range levels {","+\t\tcounts[i] = len(levelRuns)"," \t}"," \treturn counts"," }","@@ -100,8 +104,8 @@ func (s *SizeLeveledStrategy) RunsPerLevel(runs []Run) []int {"," // even if its runs overlap. Plan merges each group of k runs in a level into"," // one run, so each compaction reduces the number of runs and compaction stops."," func (s *SizeLeveledStrategy) NeedsCompaction(runs []Run) bool {","-\tfor _, level := range s.groupByLevels(runs) {","-\t\tif len(level) >= s.k {","+\tfor _, levelRuns := range s.groupByLevels(runs) {","+\t\tif len(levelRuns) >= s.k {"," \t\t\treturn true"," \t\t}"," \t}","@@ -118,11 +122,25 @@ func (s *SizeLeveledStrategy) NeedsCompaction(runs []Run) bool {"," // Plan returns the runs it does not merge in unmerged, so the caller can keep"," // them without rewriting their data. Every run lands in exactly one merge"," // task or in unmerged.","+//","+// The output level of a task is the level of the summed size of its input","+// runs, so it can be above the level of the inputs."," func (s *SizeLeveledStrategy) Plan(runs []Run, tenant string) (merges []*compactionv2pb.TaskSpec, unmerged []Run) {","-\tfor _, level := range s.groupByLevels(runs) {","-\t\tfull := len(level) - len(level)%s.k","-\t\tmerges = append(merges, Plan(level[:full], tenant, s.k)...)","-\t\tunmerged = append(unmerged, level[full:]...)","+\tfor _, levelRuns := range s.groupByLevels(runs) {","+\t\tfull := len(levelRuns) - len(levelRuns)%s.k","+\t\tfor start := 0; start < full; start += s.k {","+\t\t\tgroup := levelRuns[start : start+s.k]","+\t\t\tvar mergedSize uint64","+\t\t\tfor _, run := range group {","+\t\t\t\tmergedSize += run.Size()","+\t\t\t}","+\t\t\toutputLevel := uint32(s.level(mergedSize))","+\t\t\tfor _, task := range Plan(group, tenant, s.k) {","+\t\t\t\ttask.OutputLevel = outputLevel","+\t\t\t\tmerges = append(merges, task)","+\t\t\t}","+\t\t}","+\t\tunmerged = append(unmerged, levelRuns[full:]...)"," \t}"," \treturn merges, unmerged"," }"],"additions":42,"deletions":24,"truncated":false},{"path":"pkg/dataobj/compaction/v2/size_leveled_test.go","lines":["@@ -52,13 +52,13 @@ func TestSizeLeveledStrategyLevel(t *testing.T) {"," \t\tsize uint64"," \t\twant int"," \t}{","-\t\t{name: \"an empty run is in level 0\", size: 0, want: 0},","-\t\t{name: \"a run just below base is in level 0\", size: 16*gib - 1, want: 0},","-\t\t{name: \"a run equal to base is in level 1\", size: 16 * gib, want: 1},","-\t\t{name: \"a run just below base times ratio is in level 1\", size: 128*gib - 1, want: 1},","-\t\t{name: \"a run equal to base times ratio is in level 2\", size: 128 * gib, want: 2},","-\t\t{name: \"a run of 1PiB is in level 6\", size: 1 << 50, want: 6},","-\t\t{name: \"the largest possible run does not overflow and is 