);","+    for (int ckp = 0; ckp <= metadataCompactionDeltaCommits; ckp++) {","+      instants.add(mockWriteWithMetadata(ckp));","+    }","+    List<HoodieInstant> afterWrites = metadataTableMetaClient.reloadActiveTimeline().getInstants();","+    assertTrue(afterWrites.containsAll(before), \"nothing should have been archived\");","+    List<HoodieInstant> added = afterWrites.stream().filter(i -> !before.contains(i)).collect(Collectors.toList());","+    assertTrue(added.stream().allMatch(i -> i.getAction().equals(HoodieTimeline.DELTA_COMMIT_ACTION)),","+        \"unexpected metadata instants \" + added);","+    assertEquals(instants, added.stream().map(HoodieInstant::requestedTime).collect(Collectors.toList()));","+","+    // Restarting the coordinator does not run them either.","+    coordinator.close();","+    coordinator = startCoordinator(conf, 1);","+    assertEquals(afterWrites, metadataTableMetaClient.reloadActiveTimeline().getInstants());","+","+    // The same restart with the services enabled compacts, so the checks above cannot pass vacuously.","+    coordinator.close();","+    conf.setString(HoodieMetadataConfig.INLINE_TABLE_SERVICES_ENABLED.key(), \"true\");","+    coordinator = startCoordinator(conf, 1);","+    assertTrue(metadataTableMetaClient.reloadActiveTimeline().getInstants().stream()","+            .anyMatch(i -> i.getAction().equals(HoodieTimeline.COMMIT_ACTION) && !afterWrites.contains(i)),","+        \"a compaction was due and should have run\");","+  }","+","   @Test","   void testSyncMetadataTableWithLogCompaction() throws Exception {","     // reset",""],"additions":45,"deletions":0,"truncated":false}],"additions":193,"deletions":4,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-16T14:20:10.730778+00:00"}