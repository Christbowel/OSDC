path to compact the metadata table.","+ */","+public class TestSparkDeletePartitionTableServices extends HoodieClientTestBase {","+","+  private static final String PARTITION = HoodieTestDataGenerator.DEFAULT_FIRST_PARTITION_PATH;","+","+  @Test","+  public void leavesTheMetadataTableAloneWhenInlineMetadataServicesAreDisabled() {","+    List<HoodieInstant> before = metadataInstantsAfterAnInsert();","+","+    String deleteInstant = deletePartition(false);","+","+    // The delete's own deltacommit is the only change: no clean, compaction or archival.","+    List<HoodieInstant> added = metadataInstants().stream()","+        .filter(i -> !before.contains(i)).collect(Collectors.toList());","+    assertEquals(1, added.size(), \"unexpected metadata instants \" + added);","+    assertEquals(DELTA_COMMIT_ACTION, added.get(0).getAction());","+    assertEquals(deleteInstant, added.get(0).requestedTime());","+    assertTrue(metadataInstants().containsAll(before), \"nothing should have been archived\");","+  }","+","+  @Test","+  public void stillCompactsTheMetadataTableWhenOnlyTableServicesAreDisabled() {","+    List<HoodieInstant> before = metadataInstantsAfterAnInsert();","+","+    deletePartition(true);","+","+    // Also proves the setup makes compaction due, so the test above cannot pass vacuously.","+    assertTrue(metadataInstants().stream()","+            .anyMatch(i -> i.getAction().equals(COMMIT_ACTION) && !before.contains(i)),","+        \"a compaction was due and should have run\");","+  }","+","+  private List<HoodieInstant> metadataInstantsAfterAnInsert() {","+    try (SparkRDDWriteClient client = getHoodieWriteClient(config(true, true))) {","+      String instantTime = WriteClientTestUtils.createNewInstantTime();","+      WriteClientTestUtils.startCommitWithTime(client, instantTime);","+      List<HoodieRecord> records = dataGen.generateInsertsForPartition(instantTime, 10, PARTITION);","+      client.commit(instantTime, client.insert(jsc.parallelize(records, 1), instantTime));","+    }","+    return metadataInstants();","+  }","+","+  private String deletePartition(boolean inlineMetadataServices) {","+    try (SparkRDDWriteClient client = getHoodieWriteClient(config(false, inlineMetadataServices))) {","+      String instantTime = WriteClientTestUtils.createNewInstantTime();","+      WriteClientTestUtils.startCommitWithTime(client, instantTime, REPLACE_COMMIT_ACTION);","+      HoodieWriteResult result = client.deletePartitions(Collections.singletonList(PARTITION), instantTime);","+      client.commit(instantTime, result.getWriteStatuses(), Option.empty(), REPLACE_COMMIT_ACTION,","+          result.getPartitionToReplaceFileIds());","+      return instantTime;","+    }","+  }","+","+  private HoodieWriteConfig config(boolean tableServices, boolean inlineMetadataServices) {","+    return getConfigBuilder()","+        .withTableServicesEnabled(tableServices)","+        .withMetadataConfig(HoodieMetadataConfig.newBuilder()","+            .enable(true)","+            .withMaxNumDeltaCommitsBeforeCompaction(1)","+            .withInlineTableServicesEnabled(inlineMetadataServices)","+            .build())","+        .build();","+  }","+","+  private List<HoodieInstant> metadataInstants() {","+    return HoodieTestUtils.createMetaClient(storageConf, HoodieTableMetadata.getMetadataTableBasePath(basePath))","+        .getActiveTimeline().getInstants();","+  }","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"hudi-common/src/main/java/org/apache/hudi/common/config/HoodieMetadataConfig.java","lines":["@@ -100,6 +100,15 @@ public final class HoodieMetadataConfig extends HoodieConfig {","           + \"instead of executing them inline. This prevents the current writer from executing compaction/logcompaction \"","           + \"on the metadata table, allowing a separate async pipeline to handle them.\");"," ","+  public static final ConfigProperty<Boolean> INLINE_TABLE_SERVICES_ENABLED = ConfigProperty","+      .key(METADATA_PREFIX + \".inline.table.services.enabled\")","+      .defaultValue(true)","+      .markAdvanced()","+      .sinceVersion(\"1.3.0\")","+      .withDocumentation(\"If false, a data table writer does not run clean, compaction or archival on the metadata table \"","+          + \"inline. For jobs that must not maintain the metadata table, such as a partition delete, \"","+          + \"and that leave it to the regular writers or a table service platform.\");","+","   public static final Set<ActionType> SUPPORTED_TABLE_SERVICE_MANAGER_ACTIONS =","       EnumSet.of(ActionType.compaction, ActionType.logcompaction);"," ","@@ -746,6 +755,10 @@ public boolean isTableServiceManagerEnabled() {","     return getBoolean(TABLE_SERVICE_MANAGER_ENABLED);","   }"," ","+  public boolean isInlineTableServicesEnabled() {","+    return getBoolean(INLINE_TABLE_SERVICES_ENABLED);","+  }","+","   public String getTableServiceManagerActions() {","     return getString(TABLE_SERVICE_MANAGER_ACTIONS);","   }","@@ -1100,6 +1113,11 @@ public Builder withTableServiceManagerEnabled(boolean enabled) {","       return this;","     }"," ","+    public Builder withInlineTableServicesEnabled(boolean enabled) {","+      metadataConfig.setValue(INLINE_TABLE_SERVICES_ENABLED, String.valueOf(enabled));","+      return this;","+    }","+","     public Builder withTableServiceManagerActions(String actions) {","       if (!actions.isEmpty()) {","         validateTableServiceManagerActions(actions);"],"additions":18,"deletions":0,"truncated":false},{"path":"hudi-flink-datasource/hudi-flink/src/test/java/org/apache/hudi/sink/TestStreamWriteOperatorCoordinator.java","lines":["@@ -22,6 +22,7 @@"," import org.apache.hudi.client.WriteStatus;"," import org.apache.hudi.client.common.HoodieFlinkEngineContext;"," import org.apache.hudi.client.heartbeat.HoodieHeartbeatClient;","+import org.apache.hudi.common.config.HoodieMetadataConfig;"," import org.apache.hudi.common.fs.FSUtils;"," import org.apache.hudi.common.mode