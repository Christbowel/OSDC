 &fakeCreateAuthorizer{err: forbidden}","+\t\terr := NewAuthzValidator(authz).Validate(context.Background(), jobAttributes(job, admission.Create), nil)","+\t\trequire.True(t, apierrors.IsForbidden(err))","+\t\trequire.Equal(t, 1, authz.calls)","+\t})","+","+\tt.Run(\"create is allowed when the authorizer allows it\", func(t *testing.T) {","+\t\tauthz := &fakeCreateAuthorizer{}","+\t\terr := NewAuthzValidator(authz).Validate(context.Background(), jobAttributes(job, admission.Create), nil)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, 1, authz.calls)","+\t})","+","+\tt.Run(\"service identity is not re-authorized\", func(t *testing.T) {","+\t\tauthz := &fakeCreateAuthorizer{err: forbidden}","+\t\tctx, _, err := identity.WithProvisioningIdentity(context.Background(), \"default\")","+\t\trequire.NoError(t, err)","+\t\trequire.NoError(t, NewAuthzValidator(authz).Validate(ctx, jobAttributes(job, admission.Create), nil))","+\t\trequire.Zero(t, authz.calls)","+\t})","+","+\tt.Run(\"updates are not re-authorized when the spec is unchanged\", func(t *testing.T) {","+\t\tauthz := &fakeCreateAuthorizer{err: forbidden}","+\t\tlabelled := job.DeepCopy()","+\t\tlabelled.Labels = map[string]string{\"provisioning.grafana.app/claim\": \"driver\"}","+\t\trequire.NoError(t, NewAuthzValidator(authz).Validate(context.Background(), jobUpdateAttributes(labelled, job), nil))","+\t\trequire.Zero(t, authz.calls)","+\t})","+","+\tt.Run(\"spec change on update is rejected\", func(t *testing.T) {","+\t\tchanged := job.DeepCopy()","+\t\tchanged.Spec.Action = provisioning.JobActionDelete","+\t\terr := NewAuthzValidator(&fakeCreateAuthorizer{}).Validate(context.Background(), jobUpdateAttributes(changed, job), nil)","+\t\trequire.True(t, apierrors.IsForbidden(err))","+\t})","+","+\tt.Run(\"service identity may change the spec on update\", func(t *testing.T) {","+\t\tchanged := job.DeepCopy()","+\t\tchanged.Spec.Action = provisioning.JobActionDelete","+\t\tctx, _, err := identity.WithProvisio