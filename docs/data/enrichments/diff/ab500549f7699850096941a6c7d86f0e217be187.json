ery(\"INSERT INTO days VALUES (DATE '2024-01-01'), (DATE '2024-01-02')\"));","+\tresult = tester.Query(","+\t    \"SELECT day_value::VARCHAR FROM days WHERE date_trunc('day', day_value) = TIMESTAMP '2024-01-01 00:00:00'\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->row_count() == 1);","+\tREQUIRE(result->Fetch<string>(0, 0) == \"2024-01-01\");","+","+\t// the enum comparison rewrite replaces a comparison of VARCHAR casts with an enum -> enum cast","+\tconst char *left_values[] = {\"a\", \"b\"};","+\tconst char *right_values[] = {\"b\", \"a\", \"c\"};","+\tauto left_enum = duckdb_create_enum_type(left_values, 2);","+\tauto right_enum = duckdb_create_enum_type(right_values, 3);","+\tduckdb_logical_type_set_alias(left_enum, \"left_enum\");","+\tduckdb_logical_type_set_alias(right_enum, \"right_enum\");","+\tREQUIRE(duckdb_register_logical_type(tester.connection, left_enum, nullptr) == DuckDBSuccess);","+\tREQUIRE(duckdb_register_logical_type(tester.connection, right_enum, nullptr) == DuckDBSuccess);","+\tRegisterCast(tester.connection, left_enum, right_enum, CastToNull);","+\tduckdb_destroy_logical_type(&left_enum);","+\tduckdb_destroy_logical_type(&right_enum);","+","+\tREQUIRE_NO_FAIL(tester.Query(\"CREATE TABLE enums(l left_enum, r right_enum)\"));","+\tREQUIRE_NO_FAIL(tester.Query(\"INSERT INTO enums VALUES ('a', 'a'), ('b', 'b'), ('a', 'c')\"));","+\tresult = tester.Query(\"SELECT count(*) FROM enums WHERE l::VARCHAR = r::VARCHAR\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Fetch<int64_t>(0, 0) == 2);","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"test/optimizer/relation_statistics.cpp","lines":["@@ -1521,10 +1521,10 @@ TEST_CASE(\"Projected source equalities exclude correlated operands\", \"[optimizer"," \t\tauto binding = condition.GetLHS().Cast<BoundColumnRefExpression>().Binding();"," \t\tcondition.GetLHS().Cast<BoundColumnRefExpression>().DepthMutable() = 1;"," \t\tif (cast) {","-\t\t\tcondition.LeftReference() =","-\t\t\