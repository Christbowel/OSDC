{"id":"e0c980c904a54d37a2d63530163b09ab34e5fbc1","axis":"silent","repo":"apache/spark","sha":"e0c980c904a54d37a2d63530163b09ab34e5fbc1","parsed":{"files":[{"path":"python/docs/source/reference/pyspark.sql/core_classes.rst","lines":["@@ -49,6 +49,13 @@ Core Classes","     datasource.DataSourceRegistration","     datasource.InputPartition","     datasource.WriterCommitMessage","+    datasource.Distribution","+    datasource.UnspecifiedDistribution","+    datasource.ClusteredDistribution","+    datasource.OrderedDistribution","+    datasource.SortOrder","+    datasource.SortDirection","+    datasource.NullOrdering","     tvf.TableValuedFunction","     VariantVal","     table_arg.TableArg"],"additions":7,"deletions":0,"truncated":false},{"path":"python/docs/source/reference/pyspark.sql/datasource.rst","lines":["@@ -44,5 +44,10 @@ Python Data Source","     DataSourceStreamReader.reportLatestOffset","     DataSourceStreamReader.stop","     DataSourceWriter.abort","+    DataSourceWriter.advisoryPartitionSizeInBytes","     DataSourceWriter.commit","+    DataSourceWriter.distributionStrictlyRequired","+    DataSourceWriter.requiredDistribution","+    DataSourceWriter.requiredNumPartitions","+    DataSourceWriter.requiredOrdering","     DataSourceWriter.write"],"additions":5,"deletions":0,"truncated":false},{"path":"python/pyspark/errors/error-conditions.json","lines":["@@ -197,11 +197,21 @@","       \"Remote client cannot create a SparkContext. Create SparkSession instead.\"","     ]","   },","+  \"DATA_SOURCE_EMPTY_DISTRIBUTION\": {","+    \"message\": [","+      \"<type>.requiredDistribution() returned a <distribution> with an empty '<field>'. Provide at least one entry, or return UnspecifiedDistribution() to require no particular distribution.\"","+    ]","+  },","   \"DATA_SOURCE_EXTRANEOUS_FILTERS\": {","     \"message\": [","       \"<type>.pushFilters() returned filters that are not part of the input. Make sure that each returned filter is one of the input filters by reference. Input filters: <input>. Extraneous filters: <extraneous>.\"","     ]","   },","+  \"DATA_SOURCE_INVALID_COLUMN_PATH\": {","+    \"message\": [","+      \"<type> returned an invalid column reference: <column>. A column must be a non-empty tuple of strings, for example ('col1',) for `col1` or ('a', 'b') for `a.b`.\"","+    ]","+  },","   \"DATA_SOURCE_INVALID_RETURN_TYPE\": {","     \"message\": [","       \"Unsupported return type ('<type>') from Python data source '<name>'. Expected types: <supported_types>.\"","@@ -222,6 +232,11 @@","       \"Expected <expected>, but got <actual>.\"","     ]","   },","+  \"DATA_SOURCE_WRITE_REQUIREMENTS_DISABLED\": {","+    \"message\": [","+      \"<type> implements <method>() but write distribution and ordering is disabled because configuration '<conf>' is false. Set it to true to enable it.\"","+    ]","+  },","   \"DECORATOR_ARGUMENT_NOT_CALLABLE\": {","     \"message\": [","       \"The first positional argument passed to @<decorator_name> must be callable. Either add @<decorator_name> with no parameters to your function, or pass options to @<decorator_name> using keyword arguments (e.g. <example_usage>).\""],"additions":15,"deletions":0,"truncated":false},{"path":"python/pyspark/sql/datasource.py","lines":["@@ -18,6 +18,7 @@"," from collections import UserDict"," from collections.abc import MutableMapping"," from dataclasses import dataclass","+from enum import Enum"," from typing import (","     TYPE_CHECKING,","     Any,","@@ -53,6 +54,13 @@","     \"DataSourceRegistration\",","     \"InputPartition\",","     \"WriterCommitMessage\",","+    \"SortDirection\",","+    \"NullOrdering\",","+    \"SortOrder\",","+    \"Distribution\",","+    \"UnspecifiedDistribution\",","+    \"ClusteredDistribution\",","+    \"OrderedDistribution\",","     \"Filter\",","     \"EqualTo\",","     \"EqualNullSafe\",","@@ -1064,6 +1072,137 @@ def commit(self, end: dict) -> None:","         ..."," "," ","+class SortDirection(Enum):","+    \"\"\"","+    The direction of a sort order used for write-side required ordering.","+","+    .. versionadded:: 4.5.0","+    \"\"\"","+","+    ASCENDING = \"ascending\"","+    DESCENDING = \"descending\"","+","+","+class NullOrdering(Enum):","+    \"\"\"","+    Where null values are placed relative to non-null values in a sort order.","+","+    .. versionadded:: 4.5.0","+    \"\"\"","+","+    NULLS_FIRST = \"nulls_first\"","+    NULLS_LAST = \"nulls_last\"","+","+","+@dataclass(frozen=True)","+class SortOrder:","+    \"\"\"","+    A single sort expression used by :meth:`DataSourceWriter.requiredOrdering`.","+","+    .. versionadded:: 4.5.0","+","+    Parameters","+    ----------","+    column : tuple of str","+        The column to sort by, as a non-empty :class:`ColumnPath`.","+    direction : :class:`SortDirection`, optional","+        Sort direction, ascending by default.","+    nullOrdering : :class:`NullOrdering`, optional","+        Where nulls are placed. When not given, Spark uses the default for the","+        direction: nulls first for ascending, nulls last for descending.","+","+    Examples","+    --------","+    >>> from pyspark.sql.datasource import SortOrder, SortDirection","+    >>> SortOrder((\"year\",))","+    SortOrder(column=('year',), direction=<SortDirection.ASCENDING: 'ascending'>, nullOrdering=None)","+    >>> SortOrder((\"ts\",), SortDirection.DESCENDING)  # doctest: +ELLIPSIS","+    SortOrder(column=('ts',), direction=<SortDirection.DESCENDING: 'descending'>, ...)","+    \"\"\"","+","+    column: ColumnPath","+    direction: SortDirection = SortDirection.ASCENDING","+    nullOrdering: Optional[NullOrdering] = None","+","+","+@dataclass(frozen=True)","+class Distribution(ABC):","+    \"\"\"","+    The base class for distributions returned by","+    :meth:`DataSourceWriter.requiredDistribution`.","+","+    .. versionadded:: 4.5.0","+","+    See Also","+    --------","+    UnspecifiedDistribution","+    ClusteredDistribution","+    OrderedDistribution","+    \"\"\"","+","+","+@dataclass(frozen=True)","+class UnspecifiedDistribution(Distribution):","+    \"\"\"","+    A distribution that makes no promises about the co-location of data.","+","+    This is the default: Spark writes each input partition as it is.","+","+    .. versionadded:: 4.5.0","+    \"\"\"","+","+","+@dataclass(frozen=True)","+class ClusteredDistribution(Distribution):","+    \"\"\"","+    A distribution where rows sharing the same values for `clustering` are","+    co-located in the same partition.","+","+    Spark satisfies this with a hash repartition on the clustering columns.","+","+    .. versionadded:: 4.5.0","+","+    Parameters","+    ----------","+    clustering : tuple of :class:`ColumnPath`\\\\s","+        The columns to cluster by, each a non-empty :class:`ColumnPath`. Must not","+        be empty.","+","+    Examples","+    --------","+    >>> from pyspark.sql.datasource import ClusteredDistribution","+    >>> ClusteredDistribution(((\"year\",), (\"month\",)))","+    ClusteredDistribution(clustering=(('year',), ('month',)))","+    \"\"\"","+","+    clustering: Tuple[ColumnPath, ...]","+","+","+@dataclass(frozen=True)","+class OrderedDistribution(Distribution):","+    \"\"\"","+    A distribution where rows are ordered across partitions according to","+    `ordering`, though not necessarily within a partition.","+","+    Spark satisfies this with a range repartition on the ordering expressions.","+","+    .. versionadded:: 4.5.0","+","+    Parameters","+    ----------","+    ordering : tuple of :class:`SortOrder`\\\\s","+        The sort orders to range-partition by. Must not be empty.","+","+    Examples","+    --------","+    >>> from pyspark.sql.datasource import OrderedDistribution, SortOrder","+    >>> OrderedDistribution((SortOrder((\"year\",)),))  # doctest: +ELLIPSIS","+    OrderedDistribution(ordering=(SortOrder(column=('year',), ...),))","+    \"\"\"","+","+    ordering: Tuple[SortOrder, ...]","+","+"," class DataSourceWriter(ABC):","     \"\"\"","     A base class for data source writers. Data source writers are responsible for saving","@@ -1072,6 +1211,163 @@ class DataSourceWriter(ABC):","     .. versionadded:: 4.0.0","     \"\"\""," ","+    def requiredDistribution(self) -> Distribution:","+        \"\"\"","+        Returns the distribution required by this write.","+","+        Spark redistributes incoming records across partitions to satisfy the","+        required distribution before passing them to :meth:`DataSourceWriter.write`.","+        Use this when the sink needs related records grouped in the same task, for","+        example one output file per partition value.","+","+        This method is called once during query planning, and only when","+        `spark.sql.python.writeDistributionAndOrdering.enabled` is set to true;","+        while it is false, a batch write fails if the writer overrides this method.","+        It is not called for streaming writes. Spark calls it on a writer that","+        :meth:`DataSource.writer` creates during planning, separate from the writer","+        that writes the data, so avoid side effects in :meth:`DataSource.writer`.","+        By default it returns :class:`UnspecifiedDistribution`, meaning Spark writes","+        each input partition as it is.","+","+        .. versionadded:: 4.5.0","+","+        Returns","+        -------","+        :class:`Distribution`","+            The required distribution. Either :class:`UnspecifiedDistribution`,","+            :class:`ClusteredDistribution`, or :class:`OrderedDistribution`.","+","+        See Also","+        --------","+        DataSourceWriter.requiredOrdering","+        DataSourceWriter.requiredNumPartitions","+","+        Examples","+        --------","+        Cluster records by the columns the sink partitions its output by:","+","+        >>> from pyspark.sql.datasource import ClusteredDistribution","+        >>> def requiredDistribution(self):","+        ...     return ClusteredDistribution(clustering=((\"year\",), (\"month\",)))","+        \"\"\"","+        return UnspecifiedDistribution()","+","+    def distributionStrictlyRequired(self) -> bool:","+        \"\"\"","+        Returns whether the required distribution is strict or best-effort.","+","+        When true (the default), Spark strictly satisfies the distribution returned","+        by :meth:`DataSourceWriter.requiredDistribution`. When false, Spark may","+        rebalance partitions to speed up the query, which can split a single","+        distribution value across several tasks.","+","+        Return false only when the sink tolerates a value spanning multiple tasks","+        and would rather avoid skew.","+","+        Ignored when the required distribution is :class:`UnspecifiedDistribution`.","+","+        Like :meth:`DataSourceWriter.requiredDistribution`, this method is called only","+        while planning a batch write when","+        `spark.sql.python.writeDistributionAndOrdering.enabled` is true; while it is","+        false, a batch write fails if the writer overrides this method.","+","+        .. versionadded:: 4.5.0","+","+        Returns","+        -------","+        bool","+            True if the distribution is strictly required, False for best effort.","+        \"\"\"","+        return True","+","+    def requiredNumPartitions(self) -> int:","+        \"\"\"","+        Returns the number of partitions required by this write.","+","+        Any value less than 1 (the default) means no requirement. Must not be","+        combined with :meth:`DataSourceWriter.advisoryPartitionSizeInBytes`, and","+        requires a distribution other than :class:`UnspecifiedDistribution`;","+        the query fails at planning time otherwise.","+","+        Like :meth:`DataSourceWriter.requiredDistribution`, this method is called only","+        while planning a batch write when","+        `spark.sql.python.writeDistributionAndOrdering.enabled` is true; while it is","+        false, a batch write fails if the writer overrides this method.","+","+        .. versionadded:: 4.5.0","+","+        Returns","+        -------","+        int","+            The required number of partitions, or 0 for no requirement.","+        \"\"\"","+        return 0","+","+    def advisoryPartitionSizeInBytes(self) -> int:","+        \"\"\"","+        Returns the advisory partition size in bytes for this write.","+","+        This is a hint, not a guarantee, and is ignored when adaptive query","+        execution is disabled. Any value less than 1 (the default) means no","+        preference. Must not be combined with","+        :meth:`DataSourceWriter.requiredNumPartitions`, and requires a distribution","+        other than :class:`UnspecifiedDistribution`; the query fails at planning","+        time otherwise.","+","+        Be careful with large values: they reduce write parallelism.","+","+        Like :meth:`DataSourceWriter.requiredDistribution`, this method is called only","+        while planning a batch write when","+        `spark.sql.python.writeDistributionAndOrdering.enabled` is true; while it is","+        false, a batch write fails if the writer overrides this method.","+","+        .. versionadded:: 4.5.0","+","+        Returns","+        -------","+        int","+            The advisory partition size in bytes, or 0 for no preference.","+        \"\"\"","+        return 0","+","+    def requiredOrdering(self) -> Sequence[SortOrder]:","+        \"\"\"","+        Returns the ordering required by this write.","+","+        Spark sorts records within each partition to satisfy the required ordering","+        before passing them to :meth:`DataSourceWriter.write`. Use this when the","+        sink writes records sequentially and needs them grouped or sorted, for","+        example to avoid keeping one open file handle per key.","+","+        This method is called once during query planning, and only when","+        `spark.sql.python.writeDistributionAndOrdering.enabled` is set to true;","+        while it is false, a batch write fails if the writer overrides this method.","+        It is not called for streaming writes. Spark calls it on a writer that","+        :meth:`DataSource.writer` creates during planning, separate from the writer","+        that writes the data, so avoid side effects in :meth:`DataSource.writer`.","+        By default it returns an empty list, meaning no ordering is required.","+","+        .. versionadded:: 4.5.0","+","+        Returns","+        -------","+        list of :class:`SortOrder`\\\\s","+            The required ordering, or an empty list for no requirement.","+","+        See Also","+        --------","+        DataSourceWriter.requiredDistribution","+","+        Examples","+        --------","+        Sort each partition by the sink's partition columns:","+","+        >>> from pyspark.sql.datasource import SortOrder","+        >>> def requiredOrdering(self):","+        ...     return [SortOrder((\"year\",)), SortOrder((\"month\",))]","+        \"\"\"","+        return []","+","     @abstractmethod","     def write(self, iterator: Iterator[Row]) -> \"WriterCommitMessage\":","         \"\"\""],"additions":296,"deletions":0,"truncated":false},{"path":"python/pyspark/sql/tests/test_python_datasource.py","lines":["@@ -31,10 +31,13 @@"," from pyspark.memory_profiler_ext import has_memory_profiler"," from pyspark.sql.datasource import (","     CaseInsensitiveDict,","+    ClusteredDistribution,","     DataSource,","     DataSourceArrowWriter,","     DataSourceReader,","+    DataSourceStreamWriter,","     DataSourceWriter,","+    Distribution,","     EqualNullSafe,","     EqualTo,","     Filter,","@@ -47,9 +50,14 @@","     LessThan,","     LessThanOrEqual,","     Not,","+    NullOrdering,","+    OrderedDistribution,","+    SortDirection,","+    SortOrder,","     StringContains,","     StringEndsWith,","     StringStartsWith,","+    UnspecifiedDistribution,","     WriterCommitMessage,"," )"," from pyspark.sql.functions import spark_partition_id","@@ -1492,6 +1500,715 @@ def write(self, iterator):","             df2 = self.spark.read.format(\"json\").load(d)","             assertDataFrameEqual(df2, df)"," ","+    WRITE_DIST_CONF = \"spark.sql.python.writeDistributionAndOrdering.enabled\"","+","+    # AQE coalescing would merge the post-shuffle partitions of these tiny test inputs back","+    # into a single task, which hides how the required distribution split them up.","+    NO_COALESCE_CONF = \"spark.sql.adaptive.coalescePartitions.enabled\"","+","+    # Without coalescing, every one of the default 200 shuffle partitions would start a Python","+    # write task. Keys \"a\" and \"b\" still land in different partitions out of 4.","+    SHUFFLE_PARTITIONS_CONF = \"spark.sql.shuffle.partitions\"","+","+    def _write_conf(self, enabled=True):","+        return {","+            \"spark.sql.adaptive.enabled\": True,","+            self.WRITE_DIST_CONF: enabled,","+            self.NO_COALESCE_CONF: False,","+            self.SHUFFLE_PARTITIONS_CONF: 4,","+        }","+","+    def _register_write_requirements_source(","+        self,","+        name,","+        path,","+        distribution=None,","+        ordering=None,","+        strictly_required=None,","+        num_partitions=None,","+        advisory_size=None,","+    ):","+        \"\"\"Registers a data source whose writer records the rows each task received.","+","+        Each task writes the rows it was handed to its own JSON file under `path`, so a","+        test can read them back with `_read_tasks` and assert on how Spark distributed and","+        ordered the data. Files are used rather than an in-memory collection because the","+        writer runs in a separate Python worker process.","+        \"\"\"","+","+        class TestWriter(DataSourceWriter):","+            def write(self, iterator):","+                from pyspark import TaskContext","+","+                rows = [[row.key, row.value] for row in iterator]","+                output = os.path.join(path, f\"{TaskContext.get().partitionId()}.json\")","+                with open(output, \"w\") as f:","+                    json.dump(rows, f)","+                return WriterCommitMessage()","+","+            if distribution is not None:","+","+                def requiredDistribution(self):","+                    return distribution","+","+            if ordering is not None:","+","+                def requiredOrdering(self):","+                    return ordering","+","+            if strictly_required is not None:","+","+                def distributionStrictlyRequired(self):","+                    return strictly_required","+","+            if num_partitions is not None:","+","+                def requiredNumPartitions(self):","+                    return num_partitions","+","+            if advisory_size is not None:","+","+                def advisoryPartitionSizeInBytes(self):","+                    return advisory_size","+","+        class TestDataSource(DataSource):","+            @classmethod","+            def name(cls):","+                return name","+","+            def writer(self, schema, overwrite):","+                return TestWriter()","+","+        self.spark.dataSource.register(TestDataSource)","+","+    def _read_tasks(self, path):","+        \"\"\"Returns the rows each write task received, as a list of lists of [key, value].\"\"\"","+        tasks = []","+        for entry in sorted(os.listdir(path)):","+            with open(os.path.join(path, entry)) as f:","+                rows = json.load(f)","+            # Skip tasks that got no rows; they say nothing about distribution.","+            if rows:","+                tasks.append(rows)","+        return tasks","+","+    def _input_tasks(self, df):","+        \"\"\"Returns the rows in each non-empty partition of `df`, in `_read_tasks` form.\"\"\"","+        # spark_partition_id rather than df.rdd, which Spark Connect does not support.","+        tasks = {}","+        for r in df.select(\"key\", \"value\", spark_partition_id().alias(\"pid\")).collect():","+            tasks.setdefault(r.pid, []).append([r.key, r.value])","+        return [tasks[pid] for pid in sorted(tasks)]","+","+    def _write_df(self):","+        # Start from several partitions with interleaved keys, so that a required","+        # distribution has to move rows in order to co-locate them.","+        return self.spark.createDataFrame(","+            [(k, v) for v in range(3) for k in [\"a\", \"b\"]], \"key string, value int\"","+        ).repartition(4)","+","+    def test_write_no_requirements_keeps_input_layout(self):","+        with tempfile.TemporaryDirectory(prefix=\"write_req_default\") as d:","+            self._register_write_requirements_source(\"write_req_default\", d)","+            df = self._write_df()","+            with self.sql_conf(self._write_conf()):","+                df.write.format(\"write_req_default\").mode(\"append\").save()","+                expected = self._input_tasks(df)","+            # A writer that asks for nothing gets the input partitioning untouched.","+            self.assertEqual(self._read_tasks(d), expected)","+","+    def test_write_clustered_distribution(self):","+        with tempfile.TemporaryDirectory(prefix=\"write_req_clustered\") as d:","+            self._register_write_requirements_source(","+                \"write_req_clustered\", d, distribution=ClusteredDistribution(((\"key\",),))","+            )","+            with self.sql_conf(self._write_conf()):","+                self._write_df().write.format(\"write_req_clustered\").mode(\"append\").save()","+            tasks = self._read_tasks(d)","+            # Rows are clustered by `key`, so each task sees exactly one key.","+            for rows in tasks:","+                self.assertEqual(len({key for key, _ in rows}), 1)","+            # The two keys land in two different tasks, and no row is lost.","+            self.assertEqual(len(tasks), 2)","+            self.assertEqual(sum(len(rows) for rows in tasks), 6)","+","+    def test_write_required_ordering(self):","+        with tempfile.TemporaryDirectory(prefix=\"write_req_ordering\") as d:","+            self._register_write_requirements_source(","+                \"write_req_ordering\",","+                d,","+                distribution=ClusteredDistribution(((\"key\",),)),","+                ordering=[SortOrder((\"key\",)), SortOrder((\"value\",), SortDirection.DESCENDING)],","+            )","+            with self.sql_conf(self._write_conf()):","+                self._write_df().write.format(\"write_req_ordering\").mode(\"append\").save()","+            # Within each task rows arrive sorted by key asc, then value desc.","+            for rows in self._read_tasks(d):","+                self.assertEqual(rows, sorted(rows, key=lambda r: (r[0], -r[1])))","+","+    def test_write_null_ordering(self):","+        df = self.spark.createDataFrame(","+            [(\"a\", v) for v in [1, None, 2]], \"key string, value int\"","+        ).repartition(3)","+        cases = [","+            # Without an explicit null ordering, nulls go first for an ascending sort and last","+            # for a descending one.","+            (\"write_req_nulls_default_asc\", SortOrder((\"value\",)), [None, 1, 2]),","+            (","+                \"write_req_nulls_default\",","+                SortOrder((\"value\",), SortDirection.DESCENDING),","+                [2, 1, None],","+            ),","+            (","+                \"write_req_nulls_first\",","+                SortOrder((\"value\",), SortDirection.DESCENDING, NullOrdering.NULLS_FIRST),","+                [None, 2, 1],","+            ),","+            (","+                \"write_req_nulls_last\",","+                SortOrder((\"value\",), SortDirection.ASCENDING, NullOrdering.NULLS_LAST),","+                [1, 2, None],","+            ),","+        ]","+        for name, order, expected in cases:","+            with self.subTest(name=name), tempfile.TemporaryDirectory(prefix=name) as d:","+                self._register_write_requirements_source(","+                    name, d, distribution=ClusteredDistribution(((\"key\",),)), ordering=[order]","+                )","+                with self.sql_conf(self._write_conf()):","+                    df.write.format(name).mode(\"append\").save()","+                self.assertEqual([[v for _, v in rows] for rows in self._read_tasks(d)], [expected])","+","+    def test_write_nested_column_path(self):","+        with tempfile.TemporaryDirectory(prefix=\"write_req_nested\") as d:","+            self._register_write_requirements_source(","+                \"write_req_nested\", d, distribution=ClusteredDistribution(((\"s\", \"k\"),))","+            )","+            df = self._write_df().selectExpr(","+                \"key\", \"value\", \"named_struct('k', key, 'v', value) AS s\"","+            )","+            with self.sql_conf(self._write_conf()):","+                df.write.format(\"write_req_nested\").mode(\"append\").save()","+            # Clustering by the nested field `s.k`, which equals `key`, co-locates each key.","+            # Clustering by the whole struct `s` would not, as `s.v` varies within a key.","+            tasks = self._read_tasks(d)","+            for rows in tasks:","+                self.assertEqual(len({key for key, _ in rows}), 1)","+            self.assertEqual(len(tasks), 2)","+            self.assertEqual(sum(len(rows) for rows in tasks), 6)","+","+    def test_write_requirements_use_writer_inputs(self):","+        # The planning writer gets the write's schema, options and overwrite flag: it clusters","+        # by the column named in an option, and only when all three are what the write passed.","+        # The option is set and read with different casing, as option keys are case-insensitive.","+        for mode in [\"append\", \"overwrite\"]:","+            name = f\"write_req_inputs_{mode}\"","+            expected_overwrite = mode == \"overwrite\"","+            with self.subTest(mode=mode), tempfile.TemporaryDirectory(prefix=name) as d:","+","+                class InputsWriter(DataSourceWriter):","+                    def __init__(self, schema, options, overwrite):","+                        self.schema = schema","+                        self.options = options","+                        self.overwrite = overwrite","+","+                    def write(self, iterator):","+                        from pyspark import TaskContext","+","+                        rows = [[row.key, row.value] for row in iterator]","+                        output = os.path.join(d, f\"{TaskContext.get().partitionId()}.json\")","+                        with open(output, \"w\") as f:","+                            json.dump(rows, f)","+                        return WriterCommitMessage()","+","+                    def requiredDistribution(self):","+                        assert self.schema.fieldNames() == [\"key\", \"value\"], self.schema","+                        assert self.overwrite is expected_overwrite, self.overwrite","+                        return ClusteredDistribution(((self.options[\"cluster_by\"],),))","+","+                class InputsDataSource(DataSource):","+                    @classmethod","+                    def name(cls):","+                        return name","+","+                    def writer(self, schema, overwrite):","+                        return InputsWriter(schema, self.options, overwrite)","+","+                self.spark.dataSource.register(InputsDataSource)","+                with self.sql_conf(self._write_conf()):","+                    writer = self._write_df().write.format(name)","+                    writer.option(\"Cluster_By\", \"key\").mode(mode).save()","+                tasks = self._read_tasks(d)","+                for rows in tasks:","+                    self.assertEqual(len({key for key, _ in rows}), 1)","+                self.assertEqual(len(tasks), 2)","+                self.assertEqual(sum(len(rows) for rows in tasks), 6)","+","+    def test_write_requirements_planned_once(self):","+        # Spark reads each requirement separately, but asks the Python writer only once per write.","+        with tempfile.TemporaryDirectory(prefix=\"write_req_once\") as d:","+            calls = os.path.join(d, \"calls\")","+","+            def record(method):","+                with open(calls, \"a\") as f:","+                    f.write(method + \"\\n\")","+","+            class CountingWriter(DataSourceWriter):","+                def write(self, iterator):","+                    return WriterCommitMessage()","+","+                def requiredDistribution(self):","+                    record(\"requiredDistribution\")","+                    return ClusteredDistribution(((\"key\",),))","+","+                def distributionStrictlyRequired(self):","+                    record(\"distributionStrictlyRequired\")","+                    return True","+","+                def requiredNumPartitions(self):","+                    record(\"requiredNumPartitions\")","+                    return 0","+","+                def advisoryPartitionSizeInBytes(self):","+                    record(\"advisoryPartitionSizeInBytes\")","+                    return 0","+","+                def requiredOrdering(self):","+                    record(\"requiredOrdering\")","+                    return [SortOrder((\"value\",))]","+","+            class CountingDataSource(DataSource):","+                @classmethod","+                def name(cls):","+                    return \"write_req_once\"","+","+                def writer(self, schema, overwrite):","+                    return CountingWriter()","+","+            self.spark.dataSource.register(CountingDataSource)","+            with self.sql_conf(self._write_conf()):","+                self._write_df().write.format(\"write_req_o