tpolicy: `","+\t\t\t\tpath \"test/path\" {","+\t\t\t\t\tcapabilities = [\"update\"]","+\t\t\t\t\tdenied_parameters = {","+\t\t\t\t\t\t\"ceiling_policies\" = [\"super-admin\"]","+\t\t\t\t\t\t\"unregistered_user_policies\" = [\"super-admin\"]","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t`,","+\t\t\trequests: map[string]testReq{","+\t\t\t\t\"ceiling_policies_mixed_case_is_denied\": {","+\t\t\t\t\tparameters: `{\"ceiling_policies\": \"Super-Admin\"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t\t\"ceiling_policies_whitespace_is_denied\": {","+\t\t\t\t\tparameters: `{\"ceiling_policies\": \" super-admin \"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t\t\"unregistered_user_policies_mixed_case_is_denied\": {","+\t\t\t\t\tparameters: `{\"unregistered_user_policies\": \"Super-Admin\"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t\t\"unregistered_user_policies_whitespace_is_denied\": {","+\t\t\t\t\tparameters: `{\"unregistered_user_policies\": \"super-admin\\t\"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t// Non-policy parameters must keep their existing exact-match semantics;","+\t\t// canonicalization must not leak into unrelated parameters.","+\t\t\"non_policy_parameters_are_not_canonicalized\": {","+\t\t\tpolicy: `","+\t\t\t\tpath \"test/path\" {","+\t\t\t\t\tcapabilities = [\"update\"]","+\t\t\t\t\tdenied_parameters = {","+\t\t\t\t\t\t\"policy\" = [\"super-admin\"]","+\t\t\t\t\t\t\"name\" = [\"super-admin\"]","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t`,","+\t\t\trequests: map[string]testReq{","+\t\t\t\t\"policy_document_param_exact_match_is_denied\": {","+\t\t\t\t\tparameters: `{\"policy\": \"super-admin\"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t\t\"policy_document_param_whitespace_matches_under_slice_matching\": {","+\t\t\t\t\tparameters:           `{\"policy\": \" super-admin \"}`,","+\t\t\t\t\tallowed:              false,","+\t\t\t\t\tonlyNewSliceMatching: true,","+\t\t\t\t},","+\t\t\t\t\"policy_document_param_whitespace_allowed_under_legacy_matching\": {","+\t\t\t\t\tparameters:              `{\"policy\": \" super-admin \"}`,","+\t\t\t\t\tallowed:                 true,","+\t\t\t\t\tonlyLegacyExactMatching: true,","+\t\t\t\t},","+\t\t\t\t\"name_param_mixed_case_remains_allowed\": {","+\t\t\t\t\tparameters: `{\"name\": \"Super-Admin\"}`,","+\t\t\t\t\tallowed:    true,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t// allowed_parameters must remain fail-closed: canonicalization may only","+\t\t// make a value match an explicitly allowed entry, never bypass the list.","+\t\t\"policies_allowed_parameters_remain_fail_closed\": {","+\t\t\tpolicy: `","+\t\t\t\tpath \"test/path\" {","+\t\t\t\t\tcapabilities = [\"update\"]","+\t\t\t\t\tallowed_parameters = {","+\t\t\t\t\t\t\"policies\" = [\"read-only\"]","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t`,","+\t\t\trequests: map[string]testReq{","+\t\t\t\t\"allowed_value_with_whitespace_is_allowed\": {","+\t\t\t\t\tparameters: `{\"policies\": \" Read-Only \"}`,","+\t\t\t\t\tallowed:    true,","+\t\t\t\t},","+\t\t\t\t\"unlisted_policy_is_denied\": {","+\t\t\t\t\tparameters: `{\"policies\": \"super-admin\"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t\t\"unlisted_policy_with_whitespace_is_still_denied\": {","+\t\t\t\t\tparameters: `{\"policies\": \" Super-Admin \"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t\t\"unlisted_parameter_is_denied\": {","+\t\t\t\t\tparameters: `{\"some_other_param\": \"value\"}`,","+\t\t\t\t\tallowed:    false,","+\t\t\t\t},","+\t\t\t},","+\t\t},"," \t\t\"allow_and_deny_any_value\": {"," \t\t\tpolicy: `"," \t\t\t\tpath \"test/allow_all\" {"],"additions":252,"deletions":0,"truncated":false},{"path":"vault/external_tests/policy/acl_policy_canonicalization_test.go","lines":["@@ -0,0 +1,483 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package policy","+","+import (","+\t\"testing\"","+","+\t\"github.com/hashicorp/vault/api\"","+\t\"github.com/hashicorp/vault/helper/testhelpers/minimal\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// deniedSuperAdminPolicy is an ACL policy for a delegated administrator that","+// may manage principals but is explicitly forbidden from assigning the","+// high-privilege \"super-admin\" policy, via a value-specific denied_parameters","+// restriction on every policy-bearing parameter.","+const deniedSuperAdminPolicy = `","+path \"auth/token/create\" {","+\tcapabilities = [\"create\", \"update\"]","+\tdenied_parameters = {","+\t\t\"policies\" = [\"super-admin\"]","+\t}","+}","+","+path \"auth/token/roles/*\" {","+\tcapabilities = [\"create\", \"update\"]","+\tdenied_parameters = {","+\t\t\"allowed_policies\" = [\"super-admin\"]","+\t\t\"disallowed_policies\" = [\"super-admin\"]","+\t\t\"allowed_policies_glob\" = [\"super-admin\"]","+\t\t\"disallowed_policies_glob\" = [\"super-admin\"]","+\t}","+}","+","+path \"identity/entity\" {","+\tcapabilities = [\"create\", \"update\"]","+\tdenied_parameters = {","+\t\t\"policies\" = [\"super-admin\"]","+\t}","+}","+","+path \"identity/group\" {","+\tcapabilities = [\"create\", \"update\"]","+\tdenied_parameters = {","+\t\t\"policies\" = [\"super-admin\"]","+\t}","+}","+","+path \"auth/approle/role/*\" {","+\tcapabilities = [\"create\", \"update\"]","+\tdenied_parameters = {","+\t\t\"token_policies\" = [\"super-admin\"]","+\t}","+}","+","+path \"auth/userpass/users/*\" {","+\tcapabilities = [\"create\", \"update\"]","+\tdenied_parameters = {","+\t\t\"token_policies\" = [\"super-admin\"]","+\t}","+}","+`","+","+// superAdminPolicy stands in for an existing, higher-privilege non-root policy","+// that already exists in the namespace and that the delegated administrator","+// must not be able to assign.","+const superAdminPolicy = `","+path \"secret/*\" {","+\tcapabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\"]","+}","+`","+","+// policyNameVariants returns representations of the denied policy name","+// \"super-admin\" that are not byte-identical to the denied value but that all","+// canonicalize to it. Vault lowercases policy names and trims surrounding","+// whitespace before storing or enforcing them, so each of these resolves to the","+// denied policy and must be rejected by denied_parameters.","+func policyNameVariants() map[string]string {","+\treturn map[string]string{","+\t\t\"mixed_case\":           \"Super-Admin\",","+\t\t\"upper_case\":           \"SUPER-ADMIN\",","+\t\t\"leading_space\":        \" super-admin\",","+\t\t\"trailing_space\":       \"super-admin \",","+\t\t\"surrounding_spaces\":   \"  super-admin  \",","+\t\t\"tabs\":                 \"\\tsuper-admin\\t\",","+\t\t\"newlines\":             \"\\nsuper-admin\\n\",","+\t\t\"unicode_nbsp\":         \"\\u00a0super-admin\\u00a0\",","+\t\t\"whitespace_plus_case\": \" Super-Admin\\t\",","+\t\t\"exact_denied_value\":   \"super-admin\",","+\t}","+}","+","+// setupDelegatedAdmin creates a single-node cluster with a \"super-admin\" policy","+// and a delegated administrator token restricted by deniedSuperAdminPolicy. It","+// returns the root client and the delegated administrator token.","+func setupDelegatedAdmin(t *testing.T) (client *api.Client, delegatedAdminToken string) {","+\tt.Helper()","+","+\tcluster := minimal.NewTestSoloCluster(t, nil)","+\tclient = cluster.Cores[0].Client","+","+\trequire.NoError(t, client.Sys().PutPolicy(\"super-admin\", superAdminPolicy))","+\trequire.NoError(t, client.Sys().PutPolicy(\"delegated-admin\", deniedSuperAdminPolicy))","+","+\tsecret, err := client.Auth().Token().Create(&api.TokenCreateRequest{","+\t\tPolicies: []string{\"delegated-admin\"},","+\t})","+\trequire.NoError(t, err)","+\trequire.NotNil(t, secret)","+\trequire.NotNil(t, secret.Auth)","+","+\treturn client, secret.Auth.ClientToken","+}","+","+// TestACLPolicyCanonicalization_TokenCreate verifies that a delegated","+// administrator cannot bypass a value-specific denied_parameters restriction on","+// the \"policies\" parameter of token creation by submitting a non-canonical","+// representation of the denied policy name, such as a mixed-case or","+// whitespace-padded variant. Vault canonicalizes policy names before storing","+// them, so without canonicalization at the ACL layer such a request would be","+// permitted and would mint a token holding the denied policy.","+func TestACLPolicyCanonicalization_TokenCreate(t *testing.T) {","+\tt.Parallel()","+","+\tclient, delegatedAdminToken := setupDelegatedAdmin(t)","+\tclient.SetToken(delegatedAdminToken)","+","+\tfor name, variant := range policyNameVariants() {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tresp, err := client.Auth().Token().Create(&api.TokenCreateRequest{","+\t\t\t\tPolicies: []string{variant},","+\t\t\t})","+\t\t\trequire.Error(t, err, \"token creation with policy %q must be denied\", variant)","+\t\t\trequire.Contains(t, err.Error(), \"permission denied\")","+","+\t\t\tif resp != nil && resp.Auth != nil {","+\t\t\t\trequire.NotContains(t, resp.Auth.Policies, \"super-admin\",","+\t\t\t\t\t\"issued token must not carry the denied policy\")","+\t\t\t}","+\t\t})","+\t}","+}","+","+// TestACLPolicyCanonicalization_TokenRole verifies that the token-role policy","+// fields are protected by denied_parameters against non-canonical policy names.","+// These fields were not covered by the earlier partial remediation. They are","+// the strongest non-sudo escalation path because the policies configured on a","+// role determine the policies of tokens issued through it, and those may be","+// disjoint from the creating caller's own policies.","+func TestACLPolicyCanonicalization_TokenRole(t *testing.T) {","+\tt.Parallel()","+","+\tclient, delegatedAdminToken := setupDelegatedAdmin(t)","+\tclient.SetToken(delegatedAdminToken)","+","+\tfields := []string{","+\t\t\"allowed_policies\",","+\t\t\"disallowed_policies\",","+\t\t\"allowed_policies_glob\",","+\t\t\"disallowed_policies_glob\",","+\t}","+","+\tfor _, field := range fields {","+\t\tfor name, variant := range policyNameVariants() {","+\t\t\tt.Run(field+\"/\"+name, func(t *testing.T) {","+\t\t\t\t// Each subtest writes to a distinct role name so that subtests","+\t\t\t\t// share no state and can run independently.","+\t\t\t\trolePath := \"auth/token/roles/role-\" + field + \"-\" + name","+","+\t\t\t\t_, err := client.Logical().Write(rolePath, map[string]interface{}{","+\t\t\t\t\tfield: []string{variant},","+\t\t\t\t})","+\t\t\t\trequire.Error(t, err, \"writing %s=%q must be denied\", field, variant)","+\t\t\t\trequire.Contains(t, err.Error(), \"permission denied\")","+\t\t\t})","+\t\t}","+\t}","+}","+","+// TestACLPolicyCanonicalization_IdentityEntity verifies that identity entity","+// policy assignment honors denied_parameters for non-canonical policy names.","+// Identity policies are applied to any token whose entity matches, so this path","+// can escalate privileges without the parent-policy ceiling that constrains","+// direct token creation.","+func TestACLPolicyCanonicalization_IdentityEntity(t *testing.T) {","+\tt.Parallel()","+","+\tclient, delegatedAdminToken := setupDelegatedAdmin(t)","+\tclient.SetToken(delegatedAdminToken)","+","+\tfor name, variant := range policyNameVariants() {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\t_, err := client.Logical().Write(\"identity/entity\", map[string]interface{}{","+\t\t\t\t\"name\":     \"entity-\" + name,","+\t\t\t\t\"policies\": []string{variant},","+\t\t\t})","+\t\t\trequire.Error(t, err, \"entity policy %q must be denied\", variant)","+\t\t\trequire.Contains(t, err.Error(), \"permission denied\")","+\t\t})","+\t}","+}","+","+// TestACLPolicyCanonicalization_IdentityGroup verifies that identity group","+// policy assignment honors denied_parameters for non-canonical policy names.","+// Group policies apply to every member entity, making this a broad escalation","+// path if the ACL check can be evaded.","+func TestACLPolicyCanonicalization_IdentityGroup(t *testing.T) {","+\tt.Parallel()","+","+\tclient, delegatedAdminToken := setupDelegatedAdmin(t)","+\tclient.SetToken(delegatedAdminToken)","+","+\tfor name, variant := range policyNameVariants() {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\t_, err := client.Logical().Write(\"identity/group\", map[string]interface{}{"],"additions":216,"deletions":0,"truncated":false}],"additions":660,"deletions":32,"truncated":true,"file_count":5},"error":null,"fetched_at":"2026-10-03T13:27:54.492698+00:00"}