ue"," \t}"," ","-\tif valueInParameterList(v, list) {","+\tmatches := func(value interface{}) bool {","+\t\tif policyBearing {","+\t\t\tfor _, pattern := range list {","+\t\t\t\tif policyPattern, ok := pattern.(string); ok {","+\t\t\t\t\tif name, ok := value.(string); ok && policyDeniedPatternMatches(policyPattern, name) {","+\t\t\t\t\t\treturn true","+\t\t\t\t\t}","+\t\t\t\t} else if reflect.DeepEqual(pattern, value) {","+\t\t\t\t\treturn true","+\t\t\t\t}","+\t\t\t}","+\t\t\treturn false","+\t\t}","+\t\treturn valueInParameterList(value, list)","+\t}","+","+\tif matches(v) {"," \t\treturn true"," \t}"," ","@@ -1109,8 +1166,8 @@ func valueInDeniedParameterList(v interface{}, list []interface{}, useLegacyMatc"," "," \t// The new behaviour is that if any value in the slice is in the denied list, we deny."," \tif vSlice, ok := v.([]interface{}); ok {","-\t\tfor _, v := range vSlice {","-\t\t\tif valueInParameterList(v, list) {","+\t\tfor _, element := range vSlice {","+\t\t\tif matches(element) {"," \t\t\t\treturn true"," \t\t\t}"," \t\t}","@@ -1119,8 +1176,11 @@ func valueInDeniedParameterList(v interface{}, list []interface{}, useLegacyMatc"," \t\t// because failing to match a value because of it being in a comma-separated string is way more likely"," \t\t// and worse than accidentally matching a substring of a string value."," \t\tif vSlice, err := parseutil.ParseCommaStringSlice(vString); err == nil {","-\t\t\tfor _, v := range vSlice {","-\t\t\t\tif valueInParameterList(v, list) {","+\t\t\tfor _, element := range vSlice {","+\t\t\t\tif policyBearing {","+\t\t\t\t\telement = policyutil.CanonicalizePolicyName(element)","+\t\t\t\t}","+\t\t\t\tif matches(element) {"," \t\t\t\t\treturn true"," \t\t\t\t}"," \t\t\t}","@@ -1130,6 +1190,27 @@ func valueInDeniedParameterList(v interface{}, list []interface{}, useLegacyMatc"," \treturn false"," }"," ","+// policyDeniedPatternMatches supports interior wildcards in policy-name denials.","+// Allowlist patterns retain their ex