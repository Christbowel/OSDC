.config),","-    }","-}","-"," fn selected_prefetch_lockfile(","     link: &PnprLink<'_>,","     local: &LocalLockfileInstall<'_>,","@@ -392,21 +299,6 @@ fn selected_prefetch_lockfile(","     })"," }"," ","-fn state_resolution_verifiers(","-    state: &State,","-) -> miette::Result<Vec<std::sync::Arc<dyn pnpm_resolving_resolver_base::ResolutionVerifier>>> {","-    build_resolution_verifiers(","-        state.config,","-        std::sync::Arc::clone(&state.http_client),","-        None,","-        None,","-        None,","-        None,","-        None,","-    )","-    .map_err(miette::Report::new)","-}","-"," pub(super) fn pnpr_lockfile_dir<'a>(state: &'a State, link: &PnprLink<'a>) -> &'a std::path::Path {","     link.lockfile_path","         .and_then(|path| path.parent())","@@ -442,7 +334,7 @@ pub(super) async fn merge_and_save_pnpr_lockfile<Reporter: self::Reporter + 'sta","         record_pnpmfile(inputs.pnpmfile_hook.as_ref(), &mut lockfile).await?;","     }","     let merged_repair_verifiers =","-        verify_merged_repair::<Reporter>(state, link, session.partial_selection, &lockfile).await?;","+        verify_settled_pnpr_lockfile::<Reporter>(state, link, session, &lockfile).await?;"," ","     save_pnpr_lockfile(","         state,"],"additions":10,"deletions":118,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_resolution.rs","lines":["@@ -11,7 +11,7 @@ use super::{","     },","     pnpr_lockfile_dir, pnpr_request_inputs, report_merged_lockfile_conflicts,","     resolve_projects_for_pnpr, resolve_projects_options, selection_importer_ids,","-    wanted_lockfile_satisfies_workspace,","+    verify_pnpr_input_lockfile, wanted_lockfile_satisfies_workspace,"," };"," "," /// Resolve the active project or selected workspace projects through a","@@ -415,6 +415,7 @@ async fn resolve_and_link_pnpr<Reporter: self::Reporter + 'static>(","     if link.lockfile.frozen","         && let Some(previous_wanted) = session.previous_wanted","     {","+        verify_pnpr_input_lockfile(&link, previous_wanted)?;","         check_frozen_pnpmfile(state, inputs.pnpmfile_hook.as_ref(), previous_wanted).await?;","     }","     let prefetcher = streaming_prefetcher(state, lockfile_dir, &link, &session, &inputs).await;"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_verification.rs","lines":["@@ -0,0 +1,128 @@","+use super::{","+    InstallFrozenLockfileError, LocalLockfileInstall, Lockfile, LockfileVerificationOverride,","+    PnprClient, PnprClientError, PnprLink, PnprSession, Reporter, State, VerifiedOfflineLockfile,","+    VerifyLockfileOptions, VerifyLockfileResolutionsOptions, build_resolution_verifiers,","+    record_lockfile_verified, verify_lockfile_resolutions,","+};","+","+/// Offline structural and shape verification for an existing lockfile before","+/// delegating policy verification or resolution to the pnpr server. Runs even","+/// under `--trust-lockfile`, which opts out only of online supply-chain policy","+/// verifiers.","+pub(super) fn verify_pnpr_input_lockfile<'a>(","+    link: &PnprLink<'_>,","+    lockfile: &'a Lockfile,","+) -> miette::Result<VerifiedOfflineLockfile<'a>> {","+    let result = if link.lockfile.fix {","+        VerifiedOfflineLockfile::verify_for_repair(lockfile)","+    } else {","+        VerifiedOfflineLockfile::verify(lockfile)","+    };","+    result.map_err(miette::Report::new)","+}","+","+/// Verify the settled lockfile returned by the pnpr server (and merged locally","+/// when `--fix-lockfile` repaired a partial workspace selection) before writing","+/// it to disk, recording it in `lockfile-verified.jsonl`, or linking it.","+pub(super) async fn verify_settled_pnpr_lockfile<Reporter: self::Reporter + 'static>(","+    state: &State,","+    link: &PnprLink<'_>,","+    session: &PnprSession<'_>,","+    lockfile: &Lockfile,","+) -> miette::Result<Option<Vec<std::sync::Arc<dyn pnpm_resolving_resolver_base::ResolutionVerifier>>>>","+{","+    let verified = VerifiedOfflineLockfile::verify(lockfile).map_err(miette::Report::new)?;","+    if !(link.lockfile.fix && session.partial_selection) {","+        return Ok(None);","+    }","+    let verifiers =","+        if link.lockfile.trust { Vec::new() } else { state_resolution_verifiers(state)? };","+    if !verifiers.is_empty() && !verified.is_cached_by_content(&state.config.cache_dir, &verifiers)","+    {","+        verify_lockfile_resolutions::<Reporter>(","+            lockfile,","+            &verifiers,","+            &VerifyLockfileResolutionsOptions::default(),","+        )","+        .await","+        .map_err(miette::Report::new)?;","+    }","+    Ok(Some(verifiers))","+}","+","+/// The verification the frozen install runs concurrently with its fetch.","+/// `None` under `--trust-lockfile`, and when this exact lockfile was","+/// already verified against the same resolvers.","+pub(super) fn local_lockfile_verification<'a>(","+    state: &'a State,","+    pnpr_server: &str,","+    link: &PnprLink<'_>,","+    local: &LocalLockfileInstall<'a>,","+    verified_input: VerifiedOfflineLockfile<'a>,","+) -> miette::Result<Option<LockfileVerificationOverride<'a>>> {","+    if link.lockfile.trust {","+        return Ok(None);","+    }","+    let verifiers = state_resolution_verifiers(state)?;","+    if verified_input.is_cached(&state.config.cache_dir, local.lockfile_path, &verifiers) {","+        return Ok(None);","+    }","+    let verify_opts = local_verify_options(state, pnpr_server, link, local);","+    let verify_client = PnprClient::new(pnpr_server);","+    let cache_dir = state.config.cache_dir.clone();","+    let record_lockfile_path = local.lockfile_path.to_path_buf();","+    let lockfile = local.lockfile;","+    Ok(Some(Box::pin(async move {","+        match verify_client.verify_lockfile(verify_opts).await {","+            Ok(()) => {","+                record_lockfile_verified(","+                    Some(&cache_dir),","+                    &record_lockfile_path,","+                    lockfile,","+                    &verifiers,","+                );","+                Ok(())","+            }","+            Err(PnprClientError::Verification(verify_err)) => {","+                Err(InstallFrozenLockfileError::LockfileVerification(verify_err))","+            }","+            Err(err) => {","+                Err(InstallFrozenLockfileError::ExternalLockfileVerification(err.to_string()))","+            }","+        }","+    }) as LockfileVerificationOverride<'a>))","+}","+","+fn local_verify_options(","+    state: &State,","+    pnpr_server: &str,","+    link: &PnprLink<'_>,","+    local: &LocalLockfileInstall<'_>,","+) -> VerifyLockfileOptions {","+    VerifyLockfileOptions {","+        overrides: local.overrides.cloned(),","+        lockfile: local.lockfile.clone(),","+        trust_lockfile: link.lockfile.trust,","+        routing: pnpm_pnpr_client::RegistryRouting {","+            registry: local.resolve_registry.to_owned(),","+            registries: state.config.registry_declarations(),","+            authorization: state.config.auth_headers.for_url(pnpr_server),","+        },","+        verification: super::pnpr_request::verification_policy(state.config),","+    }","+}","+","+fn state_resolution_verifiers(","+    state: &State,","+) -> miette::Result<Vec<std::sync::Arc<dyn pnpm_resolving_resolver_base::ResolutionVerifier>>> {","+    build_resolution_verifiers(","+        state.config,","+        std::sync::Arc::clone(&state.http_client),","+        None,","+        None,","+        None,","+        None,","+        None,","+    )","+    .map_err(miette::Report::new)","+}"],"additions":128,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install.rs","lines":["@@ -745,6 +745,7 @@ mod resolution;"," mod pnpmfile;"," "," mod local_specs;","+mod lockfile_verification;"," "," fn pnpr_done_frame(request: &mockito::Request, mut frame: serde_json::Value) -> Vec<u8> {","     use serde_json::{Value, json};"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install/lockfile_verification.rs","lines":["@@ -0,0 +1,250 @@","+use std::{fs, io::Write as _};","+","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::{","+    bin::{AddMockedRegistry, CommandTempCwd},","+    fs::get_all_files,","+};","+","+use super::{configure_pnpr_auth, pacquet_at, pnpr_done_frame, start_pnpr};","+","+fn build_tarball_with_postinstall(name: &str, version: &str) -> (Vec<u8>, String) {","+    let manifest = serde_json::json!({","+        \"name\": name,","+        \"version\": version,","+        \"scripts\": {","+            \"postinstall\": r#\"node -e \"require('fs').writeFileSync(process.env.MARKER_FILE, 'ran-script')\"\"#,","+        },","+    })","+    .to_string();","+    let mut tar_builder = tar::Builder::new(Vec::new());","+    let mut header = tar::Header::new_gnu();","+    header.set_size(manifest.len() as u64);","+    header.set_mode(0o644);","+    header.set_cksum();","+    tar_builder","+        .append_data(&mut header, \"package/package.json\", manifest.as_bytes())","+        .expect(\"append package.json\");","+    let tar_bytes = tar_builder.into_inner().expect(\"finish tar\");","+    let mut gzip = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());","+    gzip.write_all(&tar_bytes).expect(\"compress tar\");","+    let tgz = gzip.finish().expect(\"finish gzip\");","+    let integrity = ssri::Integrity::from(&tgz).to_string();","+    (tgz, integrity)","+}","+","+fn shape_mismatched_lockfile_yaml(name: &str, version: &str, integrity: &str) -> String {","+    format!(","+        \"lockfileVersion: '9.0'","+importers:","+  .:","+    dependencies:","+      '{name}':","+        specifier: {version}","+        version: {version}","+packages:","+  '{name}@{version}':","+    resolution: {{integrity: {integrity}, tarball: 'file:alt.tgz'}}","+snapshots:","+  '{name}@{version}': {{}}","+\",","+    )","+}","+","+#[test]","+fn frozen_install_via_pnpr_rejects_shape_mismatch_without_running_builds_or_caching() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry {","+        npmrc_path,","+        cache_dir,","+        mock_instance,","+        ..","+    } = npmrc_info;","+","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+","+    let (alt_tgz, alt_integrity) = build_tarball_with_postinstall(\"@foo/no-deps\", \"1.0.0\");","+    fs::write(workspace.join(\"alt.tgz\"), alt_tgz).expect(\"write alt.tgz\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        r#\"{\"name\":\"app\",\"version\":\"1.0.0\",\"dependencies\":{\"@foo/no-deps\":\"1.0.0\"}}\"#,","+    )","+    .expect(\"write package.json\");","+    fs::write(","+        workspace.join(\"pnpm-lock.yaml\"),","+        shape_mismatched_lockfile_yaml(\"@foo/no-deps\", \"1.0.0\", &alt_integrity),","+    )","+    .expect(\"write tampered pnpm-lock.yaml\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        format!(","+            \"pnprServer: {pnpr_url}\\nminimumReleaseAge: 0\\nallowBuilds:\\n  '@foo/no-deps': true\\n\",","+        ),","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+","+    let pnpr_marker = root.path().join(\"marker-pnpr\");","+    let assert = pacquet","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_env(\"MARKER_FILE\", &pnpr_marker)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .failure();","+    let output = format!(","+        \"{}\\n{}\",","+        String::from_utf8_lossy(&assert.get_output().stdout),","+        String::from_utf8_lossy(&assert.get_output().stderr),","+    );","+    assert!(","+        output.contains(\"ERR_PNPM_RESOLUTION_SHAPE_MISMATCH\"),","+        \"expected ERR_PNPM_RESOLUTION_SHAPE_MISMATCH, got:\\n{output}\",","+    );","+    assert!(!pnpr_marker.exists(), \"postinstall script must never run\");","+    if cache_dir.exists() {","+        let cached_files = get_all_files(&cache_dir);","+        assert!(","+            !cached_files","+                .iter()","+                .any(|path| path.contains(\"lockfile-verified.jsonl\")),","+            \"must not write lockfile-verified.jsonl, found: {cached_files:?}\",","+        );","+    }","+","+    // `--trust-lockfile` opts out only of online supply-chain policies, never offline shape checks.","+    let trusted_assert = pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_env(\"MARKER_FILE\", &pnpr_marker)","+        .with_args([\"install\", \"--frozen-lockfile\", \"--trust-lockfile\"])","+        .assert()","+        .failure();","+    let trusted_output = format!(","+        \"{}\\n{}\",","+        String::from_utf8_lossy(&trusted_assert.get_output().stdout),","+        String::from_utf8_lossy(&trusted_assert.get_output().stderr),","+    );","+    assert!(","+        trusted_output.contains(\"ERR_PNPM_RESOLUTION_SHAPE_MISMATCH\"),","+        \"expected ERR_PNPM_RESOLUTION_SHAPE_MISMATCH under --trust-lockfile, got:\\n{trusted_output}\",","+    );","+    assert!(!pnpr_marker.exists(), \"postinstall script must never run under --trust-lockfile\");","+","+    // Subsequent local frozen install without pnprServer must also fail without running postinstall.","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"minimumReleaseAge: 0\\nallowBuilds:\\n  '@foo/no-deps': true\\n\",","+    )","+    .expect(\"write local pnpm-workspace.yaml\");","+    let local_marker = root.path().join(\"marker-local\");","+    let local_assert = pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_env(\"MARKER_FILE\", &local_marker)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .failure();","+    let local_output = format!(","+        \"{}\\n{}\",","+        String::from_utf8_lossy(&local_assert.get_output().stdout),","+        String::from_utf8_lossy(&local_assert.get_output().stderr),","+    );","+    assert!(","+        local_output.contains(\"ERR_PNPM_RESOLUTION_SHAPE_MISMATCH\"),","+        \"expected local ERR_PNPM_RESOLUTION_SHAPE_MISMATCH, got:\\n{local_output}\",","+    );","+    assert!(!local_marker.exists(), \"local postinstall script must never run\");","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn client_rejects_shape_mismatched_lockfile_from_permissive_pnpr_server() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { cache_dir, mock_instance, .. } = npmrc_info;","+","+    let (alt_tgz, alt_integrity) = build_tarball_with_postinstall(\"@foo/no-deps\", \"1.0.0\");","+    fs::write(workspace.join(\"alt.tgz\"), alt_tgz).expect(\"write alt.tgz\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        r#\"{\"name\":\"app\",\"version\":\"1.0.0\",\"dependencies\":{\"@foo/no-deps\":\"1.0.0\"}}\"#,","+    )","+    .expect(\"write package.json\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"minimumReleaseAge: 0\\nallowBuilds:\\n  '@foo/no-deps': true\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+","+    let mut malicious_server = mockito::Server::new();","+    let resolve_mock = malicious_server","+        .mock(\"POST\", \"/-/pnpr/v0/resolve\")","+        .with_status(200)","+        .with_header(\"content-type\", \"application/x-ndjson\")","+        .with_body_from_request(move |request| {","+            let lockfile: