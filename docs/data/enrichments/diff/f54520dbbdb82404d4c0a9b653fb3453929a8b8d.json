{"id":"f54520dbbdb82404d4c0a9b653fb3453929a8b8d","axis":"silent","repo":"envoyproxy/envoy","sha":"f54520dbbdb82404d4c0a9b653fb3453929a8b8d","parsed":{"files":[{"path":"changelogs/current/bug_fixes/composite__ecds-update-while-stream-paused.rst","lines":["@@ -0,0 +1,7 @@","+Fixed a use-after-free in the :ref:`composite <envoy_v3_api_msg_extensions.filters.http.composite.v3.Composite>`","+filter when it is configured through","+:ref:`config_discovery <envoy_v3_api_field_extensions.filters.network.http_connection_manager.v3.HttpFilter.config_discovery>`","+and an ECDS update replaces its configuration while a stream is paused in an earlier filter. The","+filter instances created from the previous configuration now share ownership of the filter stats,","+and the match tree and named filter chains they hold are released on the main thread, so that the","+delegated filter configurations are not destroyed on a worker thread."],"additions":7,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/composite/BUILD","lines":["@@ -50,6 +50,7 @@ envoy_cc_extension(","     srcs = [\"config.cc\"],","     hdrs = [\"config.h\"],","     deps = [","+        \"//envoy/event:dispatcher_interface\",","         \"//envoy/registry\",","         \"//envoy/server:filter_config_interface\",","         \"//source/extensions/filters/http/common:factory_base_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/composite/config.cc","lines":["@@ -1,6 +1,7 @@"," #include \"source/extensions/filters/http/composite/config.h\""," "," #include \"envoy/common/exception.h\"","+#include \"envoy/event/dispatcher.h\""," #include \"envoy/registry/registry.h\""," #include \"envoy/server/filter_config.h\""," ","@@ -12,6 +13,30 @@ namespace Extensions {"," namespace HttpFilters {"," namespace Composite {"," ","+namespace {","+","+// Returns a pointer that shares ownership of `ptr` and releases it on the main thread once the","+// last reference is dropped. The filter factory callback owns the match tree and the named filter","+// chains, but the filters it creates hold references to them too. When the callback is destroyed","+// first, e.g. by an ECDS update, the last reference is dropped by a filter on a worker thread,","+// whereas the delegated filter factories they own must be destroyed on the main thread.","+template <class T>","+std::shared_ptr<T> releaseOnMainThread(std::shared_ptr<T> ptr, Event::Dispatcher& main_dispatcher) {","+  if (ptr == nullptr) {","+    return nullptr;","+  }","+  T* raw = ptr.get();","+  return {raw, [owned = std::move(ptr), &main_dispatcher](T*) mutable {","+            if (main_dispatcher.isThreadSafe()) {","+              owned.reset();","+              return;","+            }","+            main_dispatcher.post([owned = std::move(owned)]() mutable { owned.reset(); });","+          }};","+}","+","+} // namespace","+"," class MatchTreeValidationVisitor","     : public Matcher::MatchTreeValidationVisitor<Envoy::Http::HttpMatchingData> {"," public:","@@ -89,7 +114,9 @@ absl::StatusOr<Http::FilterFactoryCb> CompositeFilterFactory::createFilterFactor","   // Compile named filter chains with FactoryContext access.","   auto named_chains_or_error = compileNamedFilterChains(proto_config, stats_prefix, context);","   RETURN_IF_NOT_OK(named_chains_or_error.status());","-  auto named_chains = std::move(named_chains_or_error.value());","+  Event::Dispatcher& main_dispatcher = context.serverFactoryContext().mainThreadDispatcher();","+  auto named_chains =","+      releaseOnMainThread(std::move(named_chains_or_error.value()), main_dispatcher);"," ","   Matcher::MatchTreeSharedPtr<Envoy::Http::HttpMatchingData> match_tree = nullptr;","   if (proto_config.has_matcher()) {","@@ -101,7 +128,7 @@ absl::StatusOr<Http::FilterFactoryCb> CompositeFilterFactory::createFilterFactor","         .server_factory_context_ = context.serverFactoryContext()};","     auto match_tree_or_error = createMatcherTree(proto_config.matcher(), action_context);","     RETURN_IF_NOT_OK(match_tree_or_error.status());","-    match_tree = std::move(match_tree_or_error.value());","+    match_tree = releaseOnMainThread(std::move(match_tree_or_error.value()), main_dispatcher);","   }"," ","   const auto& prefix = stats_prefix + \"composite.\";","@@ -109,7 +136,7 @@ absl::StatusOr<Http::FilterFactoryCb> CompositeFilterFactory::createFilterFactor","       FilterStats{ALL_COMPOSITE_FILTER_STATS(POOL_COUNTER_PREFIX(context.scope(), prefix))});"," ","   return [stats, named_chains, match_tree](Http::FilterChainFactoryCallbacks& callbacks) -> void {","-    auto filter = std::make_shared<Filter>(*stats, callbacks.dispatcher(), false /* is_upstream */,","+    auto filter = std::make_shared<Filter>(stats, callbacks.dispatcher(), false /* is_upstream */,","                                            match_tree, named_chains);","     callbacks.addStreamFilter(filter);","     callbacks.addAccessLogHandler(filter);","@@ -134,7 +161,8 @@ absl::StatusOr<Envoy::Http::FilterFactoryCb> CompositeFilterFactory::createFilte"," ","     auto match_tree_or_error = createMatcherTree(proto_config.matcher(), action_context);","     RETURN_IF_NOT_OK(match_tree_or_error.status());","-    match_tree = std::move(match_tree_or_error.value());","+    match_tree = releaseOnMainThread(std::move(match_tree_or_error.value()),","+                                     context.serverFactoryContext().mainThreadDispatcher());","   }"," ","   // This method is called for upstream filters.","@@ -144,7 +172,7 @@ absl::StatusOr<Envoy::Http::FilterFactoryCb> CompositeFilterFactory::createFilte","       FilterStats{ALL_COMPOSITE_FILTER_STATS(POOL_COUNTER_PREFIX(context.scope(), prefix))});"," ","   return [stats, match_tree](Http::FilterChainFactoryCallbacks& callbacks) -> void {","-    auto filter = std::make_shared<Filter>(*stats, callbacks.dispatcher(), true /* is_upstream */,","+    auto filter = std::make_shared<Filter>(stats, callbacks.dispatcher(), true /* is_upstream */,","                                            match_tree, nullptr);","     callbacks.addStreamFilter(filter);","     callbacks.addAccessLogHandler(filter);"],"additions":33,"deletions":5,"truncated":false},{"path":"source/extensions/filters/http/composite/filter.cc","lines":["@@ -165,7 +165,7 @@ void Filter::handleAction(const Matcher::Action& action) {","     }"," ","     if (!wrapper.filters_to_inject_.empty()) {","-      stats_.filter_delegation_success_.inc();","+      stats_->filter_delegation_success_.inc();","       delegated_filter_ =","           std::make_shared<DelegatedFilterChain>(std::move(wrapper.filters_to_inject_));","       updateFilterState(decoder_callbacks_, std::string(decoder_callbacks_->filterConfigName()),","@@ -184,7 +184,7 @@ void Filter::handleAction(const Matcher::Action& action) {","   composite_action.createFilters(wrapper);"," ","   if (!wrapper.errors_.empty()) {","-    stats_.filter_delegation_error_.inc();","+    stats_->filter_delegation_error_.inc();","     ENVOY_LOG(debug, \"failed to create delegated filter {}\",","               accumulateToString<absl::Status>(","                   wrapper.errors_, [](const auto& status) { return status.ToString(); }));","@@ -196,7 +196,7 @@ void Filter::handleAction(const Matcher::Action& action) {","   // Handle filter chain mode.","   if (is_filter_chain) {","     if (!wrapper.filters_to_inject_.empty()) {","-      stats_.filter_delegation_success_.inc();","+      stats_->filter_delegation_success_.inc();","       delegated_filter_ =","           std::make_shared<DelegatedFilterChain>(std::move(wrapper.filters_to_inject_));","       updateFilterState(decoder_callbacks_, std::string(decoder_callbacks_->filterConfigName()),","@@ -211,7 +211,7 @@ void Filter::handleAction(const Matcher::Action& action) {"," ","   // Handle single filter mode.","   if (wrapper.filter_to_inject_.has_value()) {","-    stats_.filter_delegation_success_.inc();","+    stats_->filter_delegation_success_.inc();"," ","     auto createDelegatedFilterFn = Overloaded{","         [this, action_name](Http::StreamDecoderFilterSharedPtr filter) {"],"additions":4,"deletions":4,"truncated":false},{"path":"source/extensions/filters/http/composite/filter.h","lines":["@@ -46,6 +46,7 @@ struct FactoryCallbacksWrapper;"," struct FilterStats {","   ALL_COMPOSITE_FILTER_STATS(GENERATE_COUNTER_STRUCT)"," };","+using FilterStatsSharedPtr = std::shared_ptr<FilterStats>;"," "," class MatchedActionInfo : public StreamInfo::FilterState::Object {"," public:","@@ -108,10 +109,10 @@ class Filter : public Http::StreamFilter,","                public AccessLog::Instance,","                Logger::Loggable<Logger::Id::filter> {"," public:","-  Filter(FilterStats& stats, Event::Dispatcher& dispatcher, bool is_upstream,","+  Filter(FilterStatsSharedPtr stats, Event::Dispatcher& dispatcher, bool is_upstream,","          Matcher::MatchTreeSharedPtr<Envoy::Http::HttpMatchingData> match_tree = nullptr,","          NamedFilterChainFactoryMapSharedPtr named_filter_chains = nullptr)","-      : dispatcher_(dispatcher), stats_(stats), is_upstream_(is_upstream),","+      : dispatcher_(dispatcher), stats_(std::move(stats)), is_upstream_(is_upstream),","         match_tree_(std::move(match_tree)), named_filter_chains_(std::move(named_filter_chains)) {}"," ","   // Http::StreamDecoderFilter","@@ -218,7 +219,8 @@ class Filter : public Http::StreamFilter,","   Http::StreamFilterSharedPtr delegated_filter_;","   Http::StreamEncoderFilterCallbacks* encoder_callbacks_{};","   Http::StreamDecoderFilterCallbacks* decoder_callbacks_{};","-  FilterStats& stats_;","+  // Shared with the filter factory callback, which an ECDS update may destroy before this filter.","+  const FilterStatsSharedPtr stats_;","   // Filter in the upstream filter chain.","   bool is_upstream_{false};","   Matcher::MatchTreeSharedPtr<Envoy::Http::HttpMatchingData> match_tree_;"],"additions":5,"deletions":3,"truncated":false},{"path":"test/extensions/filters/http/composite/BUILD","lines":["@@ -17,6 +17,7 @@ envoy_extension_cc_test(","     extension_names = [\"envoy.filters.http.composite\"],","     rbe_pool = \"linux_x64_small\",","     deps = [","+        \"//source/common/common:cleanup_lib\",","         \"//source/common/http:header_map_lib\",","         \"//source/common/http/matching:data_impl_lib\",","         \"//source/common/matcher:matcher_lib\",","@@ -56,7 +57,9 @@ envoy_extension_cc_test(","         \"//test/integration/filters:server_factory_context_filter_lib\",","         \"//test/integration/filters:set_response_code_filter_config_proto_cc_proto\",","         \"//test/integration/filters:set_response_code_filter_lib\",","+        \"//test/integration/filters:stop_in_headers_continue_in_data_filter_lib\",","         \"//test/proto:helloworld_proto_cc_proto\",","+        \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/common/matching/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/filters/http/composite/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/filters/network/http_connection_manager/v3:pkg_cc_proto\","],"additions":3,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/composite/composite_filter_integration_test.cc","lines":["@@ -1,6 +1,8 @@"," #include <optional>"," #include <string>","+#include <tuple>"," ","+#include \"envoy/config/core/v3/extension.pb.h\""," #include \"envoy/extensions/common/matching/v3/extension_matcher.pb.validate.h\""," #include \"envoy/extensions/filters/http/composite/v3/composite.pb.h\""," #include \"envoy/extensions/filters/network/http_connection_manager/v3/http_connection_manager.pb.h\"","@@ -1337,5 +1339,180 @@ TEST_P(NamedFilterChainIntegrationTest, TestMultipleNamedFilterChains) {","   }"," }"," ","+// Delivers the composite filter itself through ECDS, behind a filter that pauses decoding until the","+// request body arrives. This allows replacing the composite filter configuration while a stream","+// that was created from the previous configuration is paused before the composite filter runs.","+class CompositeFilterEcdsIntegrationTest","+    : public testing::TestWithParam<Network::Address::IpVersion>,","+      public HttpIntegrationTest {","+public:","+  CompositeFilterEcdsIntegrationTest() : HttpIntegrationTest(Http::CodecType::HTTP1, GetParam()) {}","+","+  void TearDown() override { cleanUpXdsConnection(); }","+","+  void createUpstreams() override {","+    HttpIntegrationTest::createUpstreams();","+    // The ECDS upstream.","+    addFakeUpstream(Http::CodecType::HTTP2);","+  }","+","+  void initialize() override {","+    // The initial configuration delegates to a filter that is itself discovered dynamically, whose","+    // configuration provider must be destroyed on the main thread.","+    TestEnvironment::writeStringToFileForTest(\"set_response_code.yaml\", R\"EOF(","+resources:","+  - \"@type\": type.googleapis.com/envoy.config.core.v3.TypedExtensionConfig","+    name: set-response-code","+    typed_config:","+      \"@type\": type.googleapis.com/test.integration.filters.SetResponseCodeFilterConfig","+      code: 403)EOF\",","+                                              false);","+    const auto initial_config = compositeConfig(TestEnvironment::substitute(R\"EOF(","+                    dynamic_config:","+                      name: set-response-code","+                      config_discovery:","+                        config_source:","+                          path_config_source:","+                            path: \"{{ test_tmpdir }}/set_response_code.yaml\"","+                        type_urls:","+                        - type.googleapis.com/test.integration.filters.SetResponseCodeFilterConfig","+)EOF\"));","+","+    config_helper_.addConfigModifier([](envoy::config::bootstrap::v3::Bootstrap& bootstrap) {","+      auto* ecds_cluster = bootstrap.mutable_static_resources()->add_clusters();","+      ecds_cluster->MergeFrom(bootstrap.static_resources().clusters()[0]);","+      ecds_cluster->set_name(\"ecds_cluster\");","+      ecds_cluster->mutable_load_assignment()->set_cluster_name(\"ecds_cluster\");","+      ConfigHelper::setHttp2(*ecds_cluster);","+    });","+    config_helper_.addConfigModifier([initial_config](ConfigHelper::HttpConnectionManager& hcm) {","+      auto* filter = hcm.add_http_filters();","+      filter->set_name(\"composite\");","+      auto* discovery = filter->mutable_config_discovery();","+      discovery->add_type_urls(","+          \"type.googleapis.com/envoy.extensions.filters.http.composite.v3.Composite\");","+      // Serve the initial configuration as the default configuration, so that the listener","+      // does not have to wait for ECDS.","+      std::ignore = discovery->mutable_default_config()->PackFrom(initial_config);","+      discovery->set_apply_default_config_without_warming(true);","+      auto* config_source = discovery->mutable_config_source();","+      config_source->set_resource_api_version(envoy::config::core::v3::ApiVersion::V3);","+      auto* api_config_source = config_source->mutable_api_config_source();","+      api_config_source->set_api_type(envoy::config::core::v3::ApiConfigSource::GRPC);","+      api_config_source->set_transport_api_version(envoy::config::core::v3::ApiVersion::V3);","+      api_config_source->add_grpc_services()->mutable_envoy_grpc()->set_cluster_name(","+          \"ecds_cluster\");","+      // Keep the router last.","+      const int size = hcm.http_filters_size();","+      hcm.mutable_http_filters()->SwapElements(size - 2, size - 1);","+    });","+    // This is applied right away, ahead of the config modifiers, so it lands before the composite","+    // filter.","+    config_helper_.prependFilter(R\"EOF(","+      name: stop-in-headers-continue-in-body-filter","+      typed_config:","+        \"@type\": type.googleapis.com/test.integration.filters.StopInHeadersContinueInBodyFilterConfig","+    )EOF\");","+    HttpIntegrationTest::initialize();","+","+    AssertionResult result =","+        fake_upstreams_[1]->waitForHttpConnection(*dispatcher_, xds_connection_);","+    RELEASE_ASSERT(result, result.message());","+    result = xds_connection_->waitForNewStream(*dispatcher_, xds_stream_);","+    RELEASE_ASSERT(result, result.message());","+    xds_stream_->startGrpcStream();","+  }","+","+  // Returns a composite filter configuration that runs the given action for requests carrying the","+  // match header.","+  static envoy::extensions::filters::http::composite::v3::Composite","+  compositeConfig(const std::string& action_yaml) {","+    envoy::extensions::filters::http::composite::v3::Composite config;","+    TestUtility::loadFromYaml(R\"EOF(","+      matcher:","+        matcher_tree:","+          input:","+            name: request-headers","+            typed_config:","+              \"@type\": type.googleapis.com/envoy.type.matcher.v3.HttpRequestHeaderMatchInput","+              header_name: match-header","+          exact_match_map:","+            map:","+              match:","+                action:","+                  name: composite-action","+                  typed_config:","+                    \"@type\": type.googleapis.com/envoy.extensions.filters.http.composite.v3.ExecuteFilterAction","+)EOF\" + action_yaml,","+                              config);","+    return config;","+  }","+","+  void sendCompositeConfig(const envoy::extensions::filters::http::composite::v3::Composite& config,","+                           const std::string& version) {","+    envoy::config::core::v3::TypedExtensionConfig typed_config;","+    typed_config.set_name(\"composite\");","+    std::ignore = typed_config.mutable_typed_config()->PackFrom(config);","+    sendDiscoveryResponse<envoy::config::core::v3::TypedExtensionConfig>(","+        \"type.googleapis.com/envoy.config.core.v3.TypedExtensionConfig\", {typed_config},","+        {typed_config}, {}, version);","+  }","+","+  const Http::TestRequestHeaderMapImpl match_request_headers_ = {{\":method\", \"POST\"},","+                                                                 {\":path\", \"/somepath\"},","+                                                                 {\":scheme\", \"http\"},","+                                                                 {\"match-header\", \"match\"},","+                                                                 {\":authority\", \"blah\"}};","+};","+","+INSTANTIATE_TEST_SUITE_P(IpVersions, CompositeFilterEcdsIntegrationTest,","+                         testing::ValuesIn(TestEnvironment::getIpVersionsForTest()),","+                         TestUtility::ipTestParamsToString);","+","+// Verifies that a stream that is paused before the composite filter runs keeps using the","+// composite filter configuration it was created with when an ECDS update replaces that","+// configuration in the meantime, and that the replaced configuration is released safely once the","+// stream completes.","+TEST_P(CompositeFilterEcdsIntegrationTest, UpdateWhileStreamIsPausedBeforeCompositeFilter) {","+  initialize();","+  codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+","+  // The composite filter is created from the initial configuration together with the rest of the","+  // filter chain, but the stream is paused before the composite filter runs.","+  auto encoder_decoder = codec_client_->startRequest(match_request_headers_);","+  auto response = std::move(encoder_decoder.second);","+  test_server_->waitForGauge(\"http.config_test.downstream_rq_active\", testing::Eq(1));","+","+  // Replace the composite filter configuration. The update is complete once the workers and the","+  // main thread have all dropped their reference to the initial configuration.","+  sendCompositeConfig(compositeConfig(R\"EOF(","+                    typed_config:","+                      name: set-response-code","+                      typed_config:","+                        \"@type\": type.googleapis.com/test.integration.filters.SetResponseCodeFilterConfig","+                        code: 401","+)EOF\"),","+                      \"1\");","+  test_server_->waitForCounter(\"extension_config_discovery.http_filter.composite.config_reload\",","+                               testing::Eq(1));","+","+  // Resume the paused stream. It still delegates according to the initial configuration.","+  codec_client_->sendData(encoder_decoder.first, 10, true);","+  ASSERT_TRUE(response->waitForEndStream());","+  EXPECT_THAT(response->headers(), Http::HttpStatusIs(\"403\"));","+  test_server_->waitForCounter(\"http.config_test.composite.filter_delegation_success\",","+                               testing::Eq(1));","+","+  // New streams use the updated configuration. The local reply may be sent before the end of the","+  // request has been read, in which case the connection is closed, so use a new one.","+  codec_client_->close();","+  codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+  response = codec_client_->makeRequestWithBody(match_request_headers_, 10);","+  ASSERT_TRUE(response->waitForEndStream());","+  EXPECT_THAT(response->headers(), Http::HttpStatusIs(\"401\"));","+  test_server_->waitForCounter(\"http.config_test.composite.filter_delegation_success\",","+                               testing::Eq(2));","+}","+"," } // namespace"," } // namespace Envoy"],"additions":177,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/composite/filter_test.cc","lines":["@@ -4,6 +4,7 @@"," #include \"envoy/registry/registry.h\""," #include \"envoy/server/filter_config.h\""," ","+#include \"source/common/common/cleanup.h\""," #include \"source/common/http/matching/data_impl.h\""," #include \"source/common/matcher/matcher.h\""," #include \"source/extensions/filters/http/common/factory_base.h\"","@@ -103,7 +104,8 @@ class CompositeFilterTest : public ::testing::Test {","   testing::NiceMock<Http::MockStreamEncoderFilterCallbacks> encoder_callbacks_;","   Stats::MockCounter error_counter_;","   Stats::MockCounter success_counter_;","-  FilterStats stats_{error_counter_, success_counter_};","+  FilterStatsSharedPtr stats_{","+      std::make_shared<FilterStats>(FilterStats{error_counter_, success_counter_})};","   Filter filter_;"," ","   Http::TestRequestHeaderMapImpl default_request_headers_{","@@ -1761,7 +1763,7 @@ TEST(ConfigTest, CompileNamedFilterChainsFailsOnFactoryError) {"," TEST(FilterCallbacksWrapperTest, SingleModeRejectsMultipleFiltersAndExposesDispatcher) {","   Stats::MockCounter error_counter;","   Stats::MockCounter success_counter;","-  FilterStats stats{error_counter, success_counter};","+  auto stats = std::make_shared<FilterStats>(FilterStats{error_counter, success_counter});","   testing::NiceMock<Event::MockDispatcher> dispatcher;","   testing::NiceMock<Http::MockStreamDecoderFilterCallbacks> decoder_callbacks;","   testing::NiceMock<Http::MockStreamEncoderFilterCallbacks> encoder_callbacks;","@@ -1792,7 +1794,7 @@ TEST(FilterCallbacksWrapperTest, SingleModeRejectsMultipleFiltersAndExposesDispa"," TEST(FilterCallbacksWrapperTest, ChainModeAcceptsMultipleFilters) {","   Stats::MockCounter error_counter;","   Stats::MockCounter success_counter;","-  FilterStats stats{error_counter, success_counter};","+  auto stats = std::make_shared<FilterStats>(FilterStats{error_counter, success_counter});","   testing::NiceMock<Event::MockDispatcher> dispatcher;","   testing::NiceMock<Http::MockStreamDecoderFilterCallbacks> decoder_callbacks;","   testing::NiceMock<Http::MockStreamEncoderFilterCallbacks> encoder_callbacks;","@@ -2222,6 +2224,180 @@ TEST(CompositePerRouteConfigTest, ReleasedOnMainThreadIsDestroyedInPlace) {","   config.reset();"," }"," ","+// A filter factory used to observe how a composite filter configuration uses, and releases, the","+// delegated filter factories it owns. Every callback it creates adds `filter_count` (default 1)","+// pass-through filters, and `live_callbacks_` counts the callbacks that are still alive.","+class TrackingFilterFactory : public Server::Configuration::NamedHttpFilterConfigFactory {","+public:","+  std::string name() const override { return \"envoy.filters.http.test.tracking\"; }","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<Protobuf::Struct>();","+  }","+  bool isUnifiedFilter() override { return true; }","+  absl::StatusOr<Http::FilterFactoryCb>","+  createHttpFilterFactoryFromProto(const Protobuf::Message& config,","+                                   Server::Configuration::ServerFactoryContext&,","+                                   Server::Configuration::ExtraFactoryContext&) override {","+    const auto& fields = dynamic_cast<const Protobuf::Struct&>(config).fields();","+    const auto it = fields.find(\"filter_count\");","+    const int filter_count = it == fields.end() ? 1 : static_cast<int>(it->second.number_value());","+    ++live_callbacks_;","+    auto cleanup = std::make_shared<Cleanup>([this]() { --live_callbacks_; });","+    return [cleanup, filter_count](Http::FilterChainFactoryCallbacks& callbacks) {","+      for (int i = 0; i < filter_count; ++i) {","+        callbacks.addStreamFilter(std::make_shared<Http::PassThroughFilter>());","+      }","+    };","+  }","+","+  int live_callbacks_{};","+};","+","+// When the composite filter is delivered through ECDS, its factory callback is owned by the","+// dynamic filter config provider only. The filter manager creates the composite filter together","+// with the rest of the stream's filter chain, but the composite filter evaluates its match tree","+// only once decodeHeaders() runs. An ECDS update can destroy the factory callback in between, for","+// instance while an earlier filter has paused the stream, so the filter must not depend on state","+// that the callback owns.","+class CompositeFilterFactoryLifetimeTest : public ::testing::Test {","+public:","+  CompositeFilterFactoryLifetimeTest() {","+    ON_CALL(filter_chain_callbacks_, dispatcher())","+        .WillByDefault(testing::ReturnRef(worker_dispatcher_));","+  }","+","+  // Creates a composite filter factory callback whose inline matcher always delegates to","+  // `filter_count` tracking filters, and which also has a named filter chain of a tracking filter.","+  Http::FilterFactoryCb createFactoryCallback(int filter_count) {","+    const std::string yaml = fmt::format(R\"EOF(","+      named_filter_chains:","+        tracking-chain:","+          typed_config:","+          - name: envoy.filters.http.test.tracking","+            typed_config:","+              \"@type\": type.googleapis.com/google.protobuf.Struct","+      matcher:","+        on_no_match:","+          action:","+            name: composite-action","+            typed_config:","+              \"@type\": type.googleapis.com/envoy.extensions.filters.http.composite.v3.ExecuteFilterAction","+              typed_config:","+                name: envoy.filters.http.test.tracking","+                typed_config:","+                  \"@type\": type.googleapis.com/google.protobuf.Struct","+                  value:","+                    filter_count: {}","+    )EOF\",","+                                         filter_count);","+    envoy::extensions::filters::http::composite::v3::Composite config;","+    TestUtility::loadFromYaml(yaml, config);","+","+    CompositeFilterFactory factory;","+    auto callback_or_error = factory.createFilterFactoryFromProto(config, \"\", factory_context_);","+    EXPECT_TRUE(callback_or_error.ok());","+    return std::move(callback_or_error.value());","+  }","+","+  // Runs the factory callback the way the filter manager does when it creates the filter chain of","+  // a new stream.","+  Http::StreamFilterSharedPtr createFilter(const Http::FilterFactoryCb& callback) {","+    Http::StreamFilterSharedPtr filter;","+    EXPECT_CALL(filter_chain_callbacks_, addStreamFilter(_)).WillOnce(testing::SaveArg<0>(&filter));","+    EXPECT_CALL(filter_chain_callbacks_, addAccessLogHandler(_));","+    callback(filter_chain_callbacks_);","+    filter->setDecoderFilterCallbacks(decoder_callbacks_);","+    filter->setEncoderFilterCallbacks(encoder_callbacks_);","+    return filter;","+  }","+","+  uint64_t counterValue(const std::string& name) {","+    return factory_context_.store_.counter(name).value();","+  }","+","+  TrackingFilterFactory tracking_factory_;","+  Registry::InjectFactory<Server::Configuration::NamedHttpFilterConfigFactory> registration_{","+      tracking_factory_};","+  testing::NiceMock<Server::Configuration::MockFactoryContext> factory_context_;","+  Event::MockDispatcher& main_dispatcher_{factory_context_.server_factory_context_.dispatcher_};","+  testing::NiceMock<Event::MockDispatcher> worker_dispatcher_;","+  testing::NiceMock<Http::MockFilterChainFactoryCallbacks> filter_chain_callbacks_;","+  testing::NiceMock<Http::MockStreamDecoderFilterCallbacks> decoder_callbacks_;","+  testing::NiceMock<Http::MockStreamEncoderFilterCallbacks> encoder_callbacks_;","+  Http::TestRequestHeaderMapImpl request_headers_{","+      {\":method\", \"GET\"}, {\":path\", \"/\"}, {\":scheme\", \"http\"}, {\":authority\", \"host\"}};","+};","+","+// A filter whose factory callback has been destroyed still matches, delegates and records the","+// delegation in its stats.","+TEST_F(CompositeFilterFactoryLifetimeTest, DelegationSucceedsAfterFactoryCallbackIsDestroyed) {","+  Http::FilterFactoryCb callback = createFactoryCallback(1);","+  Http::StreamFilterSharedPtr filter = createFilter(callback);","+  callback = nullptr;","+","+  EXPECT_EQ(Http::FilterHeadersStatus::Continue, filter->decodeHeaders(request_headers_, true));","+  EXPECT_EQ(1, counterValue(\"composite.filter_delegation_success\"));","+  EXPECT_EQ(0, counterValue(\"composite.filter_delegation_error\"));","+  filter->onDestroy();","+}","+","+// A filter whose factory callback has been destroyed still records a failed delegation in its","+// stats.","+TEST_F(CompositeFilterFactoryLifetimeTest, DelegationFailsAfterFactoryCallbackIsDestroyed) {","+  // Delegating to more than one filter is an error unless the action is a filter chain.","+  Http::FilterFactoryCb callback = createFactoryCallback(2);","+  Http::StreamFilterSharedPtr filter = createFilter(callback);","+  callback = nullptr;","+","+  EXPECT_EQ(Http::FilterHeadersStatus::Continue, filter->decodeHeaders(request_headers_, true));","+  EXPECT_EQ(0, counterValue(\"composite.filter_delegation_success\"));","+  EXPECT_EQ(1, counterValue(\"composite.filter_delegation_error\"));","+  filter->onDestroy();","+}","+","+// A filter that outlives its factory callback and is then released on a worker thread hands the","+// match tree and the named filter chains to the main dispatcher, because the delegated filter","+// factories they own are not safe to destroy on a worker thread.","+TEST_F(CompositeFilterFactoryLifetimeTest, FilterReleasedOffMainThreadIsPostedToMainDispatcher) {","+  Http::FilterFactoryCb callback = createFactoryCallback(1);","+  Http::StreamFilterSharedPtr filter = createFilter(callback);","+  callback = nullptr;","+  // The match tree action and the named filter chain each own a tracking factory callback.","+  EXPECT_EQ(2, tracking_factory_.live_callbacks_);","+","+  ON_CALL(main_dispatcher_, isThreadSafe()).WillByDefault(testing::Return(false));"],"additions":147,"deletions":3,"truncated":false}],"additions":377,"deletions":15,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-04T16:05:54.902602+00:00"}