+        Self {","+            names,","+            accept_any: false,","+        }","+    }","+","+    /// Also accept any other name, served by the base model","+    /// (`VLLM_SKIP_MODEL_NAME_VALIDATION`).","+    pub fn with_accept_any(mut self, accept_any: bool) -> Self {","+        self.accept_any = accept_any;","+        self","+    }","+","+    /// Extend the names with more selectable names, such as loaded LoRA","+    /// adapters.","+    pub fn with_names(mut self, names: impl IntoIterator<Item = String>) -> Self {","+        self.names.extend(names);","+        self","+    }","+","+    /// The name reported as `model` in responses that select no LoRA adapter.","+    pub fn primary(&self) -> &str {","+        &self.names[0]","+    }","+","+    /// All selectable names, primary first.","+    pub fn names(&self) -> &[String] {","+        &self.names","+    }","+","+    /// Whether a request may name `model`. Like Python, an absent or empty","+    /// name selects the primary model.","+    pub fn accepts(&self, model: Option<&str>) -> bool {","+        match model {","+            None | Some(\"\") => true,","+            Some(model) => self.accept_any || self.names.iter().any(|name| name == model),","+        }","+    }","+","+    /// Reject a model name this server does not serve with a 404.","+    pub fn check(&self, model: Option<&str>) -> Result<(), ApiError> {","+        match model {","+            Some(model) if !self.accepts(Some(model)) => {","+                Err(ApiError::model_not_found(model.to_string()))","+            }","+            _ => Ok(()),","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use super::ServedModelNames;","+","+    fn served(accept_any: bool) -> ServedModelNames {","+        ServedModelNames::new(vec![\"base\".to_string(), \"alias\".to_string()])","+            .with_accept_any(accept_any)","+    }","+","+    #[test]","+    fn strict_names_accept_only_served_names() {","+        let served = served(false);","+        for model in [None, Some(\"\"), Some(\"base\"), Some(\"alias\")] {","+            assert!(served.check(model).is_ok(), \"{model:?}\");","+        }","+        assert!(served.check(Some(\"other\")).is_err());","+    }","+","+    #[test]","+    fn skip_validation_accepts_any_name() {","+        let served = served(true);","+        assert!(served.check(Some(\"other\")).is_ok());","+        assert_eq!(served.primary(), \"base\");","+    }","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"rust/src/server/src/render.rs","lines":["@@ -15,6 +15,7 @@ use vllm_chat::{"," use vllm_text::TextRequestProcessor;"," use vllm_text::backend::hf::{HfOverrides, ModelSource};"," ","+use crate::model_names::ServedModelNames;"," use crate::{","     HttpListenerMode, ReasoningEffort, TlsConfig,","     listener::{Listener, MaybeTlsListener},","@@ -32,6 +33,8 @@ pub struct RenderConfig {","     pub hf_config: Option<ModelSource>,","     pub hf_overrides: HfOverrides,","     pub served_model_name: Vec<String>,","+    /// Accept any requested model name (`VLLM_SKIP_MODEL_NAME_VALIDATION`).","+    pub skip_model_name_validation: bool,","     pub host: String,","     pub port: u16,","     pub tool_call_parser: ParserSelection,","@@ -66,7 +69,7 @@ impl RenderConfig {"," "," pub(crate) struct RenderState {","     pub(crate) model: String,","-    pub(crate) served_model_names: Vec<String>,","+    pub(crate) served_model_names: ServedModelNames,","     /// Unlike `text.max_model_len()` this stays `None` when unset,","     /// so model cards advertise `null` instead of the `u32::MAX`.","     pub(crate) max_model_len: Option<u32>,","@@ -94,8 +97,11 @@ async fn build_state(config: &RenderConfig) -> Result<Arc<RenderState>> {","     )","     .await","     .context(\"failed to load renderer/tokenizer backends\")?;","-    let served_model_names =","-        crate::effective_served_model_names(&config.model, &config.served_model_name);","+    let served_model_names = ServedMode