{"id":"a8481846c5cdad054947188ca55458e12950fec7","axis":"silent","repo":"pnpm/pnpm","sha":"a8481846c5cdad054947188ca55458e12950fec7","parsed":{"files":[{"path":".changeset/override-no-matching-version.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/installing.deps-resolver\": minor","+\"@pnpm/installing.deps-installer\": patch","+\"@pnpm/cli.default-reporter\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+When an overrides entry requests a version that does not exist on the registry, `pnpm install` now names that override entry in the error. If the entry's selector has a version range, such as `foo@^1`, the error also shows the latest published version in that range."],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -4069,6 +4069,7 @@ snapshots:"," \t\t\t\t\"@pnpm/catalogs.resolver\": \"workspace:*\","," \t\t\t\t\"@pnpm/catalogs.types\": \"workspace:*\","," \t\t\t\t\"@pnpm/config.normalize-registries\": \"workspace:*\",","+\t\t\t\t\"@pnpm/config.parse-overrides\": \"workspace:*\","," \t\t\t\t\"@pnpm/config.pick-registry-for-package\": \"workspace:*\","," \t\t\t\t\"@pnpm/config.version-policy\": \"workspace:*\","," \t\t\t\t\"@pnpm/constants\": \"workspace:*\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install/diagnostics.rs","lines":["@@ -203,3 +203,52 @@ fn ndjson_reports_early_directory_errors() {","             .contains(\"missing-directory\"),","     );"," }","+","+#[test]","+fn an_override_to_a_missing_version_is_reported_on_the_override() {","+    for reporter in [\"--reporter=append-only\", \"--reporter=ndjson\"] {","+        let fixture = CommandTempCwd::init().add_mocked_registry();","+        fs::write(","+            fixture.workspace.join(\"package.json\"),","+            serde_json::json!({","+                \"dependencies\": { \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\" }","+            })","+            .to_string(),","+        )","+        .expect(\"write package.json\");","+        let workspace_yaml = fixture.workspace.join(\"pnpm-workspace.yaml\");","+        let mut yaml = fs::read_to_string(&workspace_yaml).unwrap_or_default();","+        yaml.push_str(","+            \"\\noverrides:\\n  \\\"@pnpm.e2e/dep-of-pkg-with-1-dep@^100.0.0\\\": \\\"999.0.0\\\"\\n\",","+        );","+        fs::write(&workspace_yaml, yaml).expect(\"write pnpm-workspace.yaml\");","+        let output = fixture.pacquet","+            .with_args([\"install\", \"--lockfile-only\", reporter])","+            .assert()","+            .failure();","+        let stderr = String::from_utf8_lossy(&output.get_output().stderr);","+        eprintln!(\"stderr={stderr}\");","+        let message = r#\"Override \"@pnpm.e2e/dep-of-pkg-with-1-dep@^100.0.0\": \"999.0.0\" targets a version of @pnpm.e2e/dep-of-pkg-with-1-dep that does not exist on the registry.\"#;","+        if reporter == \"--reporter=ndjson\" {","+            let records = ndjson_records(output.get_output());","+            let error = records","+                .iter()","+                .find(|record| record[\"level\"] == \"error\")","+                .expect(\"fatal error\");","+            assert_eq!(error[\"code\"], \"ERR_PNPM_NO_MATCHING_VERSION\");","+            assert!(","+                error[\"message\"]","+                    .as_str()","+                    .is_some_and(|text| text.ends_with(message)),","+            );","+            assert!(error[\"pkgsStack\"].as_array().is_none_or(Vec::is_empty));","+        } else {","+            let flattened = flatten_report(&stderr);","+            assert!(flattened.contains(&flatten_report(message)));","+            assert!(flattened.contains(&flatten_report(","+                r#\"The latest release of @pnpm.e2e/dep-of-pkg-with-1-dep matching \"^100.0.0\" is \"100.1.0\".\"#,","+            )));","+            assert!(!flattened.contains(\"Thiserrorhappenedwhileinstallingthedependenciesof\"));","+        }","+    }","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"pnpm/crates/env-installer/src/tests.rs","lines":["@@ -271,6 +271,7 @@ impl Resolver for FixtureResolver {","                         dep: format!(\"{alias}@{specifier}\"),","                         registry: \"https://registry.example/\".to_string(),","                         published_versions: String::new(),","+                        versions: Vec::new(),","                     }","                     .into());","                 }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/dependencies_graph_to_lockfile/tests/peer_proptest.rs","lines":["@@ -105,6 +105,7 @@ fn workspace_opts(settings: Settings, reuse: Reuse<'_>) -> WorkspaceResolveOptio","             ..pnpm_resolving_deps_resolver::WorkspaceLockfileReuse::default()","         },","         version: pnpm_resolving_deps_resolver::WorkspaceVersionResolution::default(),","+        parsed_overrides: None,","     }"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/manifest_transforms.rs","lines":["@@ -36,6 +36,9 @@ use std::{collections::BTreeMap, path::Path, sync::Arc};"," /// injection, the overrides, or the removal."," pub(super) struct ManifestTransforms {","     pub parsed_overrides: Option<Vec<pnpm_config_parse_overrides::VersionOverride>>,","+    /// `parsed_overrides` in the form the resolver attributes missing","+    /// versions with.","+    pub override_entries: Option<Arc<[pnpm_resolving_deps_resolver::OverrideEntry]>>,","     pub resolved_overrides: Option<IndexMap<String, String>>,","     pub package_extensions_checksum: Option<String>,","     pub versions_overrider: Option<Arc<VersionsOverrider>>,","@@ -74,6 +77,7 @@ pub(super) fn build_manifest_transforms(","     let effective_importer_manifests = transforms.apply_to_all(importer_manifests);","     Ok(ManifestTransforms {","         resolved_overrides: parsed_overrides.as_deref().m