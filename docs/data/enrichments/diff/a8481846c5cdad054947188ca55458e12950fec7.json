}","     }"],"additions":11,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_with_fresh_lockfile/resolve.rs","lines":["@@ -20,11 +20,7 @@ use pnpm_resolving_deps_resolver::{","     DependencyOverrider, PeerDependentsDedupe, ResolveImporterError, ResolveImporterOptions,"," };"," use pnpm_resolving_resolver_base::{PreferredVersions, ResolveOptions, Resolver};","-use std::{","-    collections::{BTreeMap, HashMap},","-    path::Path,","-    sync::Arc,","-};","+use std::{collections::BTreeMap, path::Path, sync::Arc};"," "," /// The [`ResolveOptions`] fields that are the same for every importer and"," /// for the fast-override pre-pass. Only the consuming project's directory","@@ -149,11 +145,8 @@ pub(super) struct WorkspaceWalk {","     /// [`WorkspaceResolveOptions::share_workspace_resolutions`](pnpm_resolving_deps_resolver::WorkspaceResolveOptions::share_workspace_resolutions).","     pub share_workspace_resolutions: bool,","     pub time_based: bool,","-    pub registries: HashMap<String, String>,","-    pub registries_by_prefix: HashMap<String, String>,","-    pub declared_prefixes: pnpm_lockfile::DeclaredRegistryPrefixes,","-    /// See [`pnpm_lockfile::RegistryContext::locked_registries`].","-    pub locked_registries: Option<HashMap<String, String>>,","+    pub registry_context: pnpm_lockfile::RegistryContext,","+    pub parsed_overrides: Option<Arc<[pnpm_resolving_deps_resolver::OverrideEntry]>>,"," }"," "," /// What every importer's resolve reads, and the walk reads alongside.","@@ -244,13 +237,7 @@ impl WorkspaceWalk {","     ) -> pnpm_resolving_deps_resolver::WorkspaceResolveOptions {","         let config = shared.config;","         pnpm_resolving_deps_resolver::WorkspaceResolveOptions {","-            registry_context: pnpm_lockfile::RegistryContext {","-                registries: self.registries,","-                registries_by_prefix: self.registries_by_prefix,","-                declared_prefixes: self.declared_prefixes,","-                registry_options_by_url: config.registry_options_by_url.clone(),","-                locked_registries: self.locked_registries,","-            },","+            registry_context: self.registry_context,","             share_workspace_resolutions: self.share_workspace_resolutions,","             allowed_deprecated_versions: config.allowed_deprecated_versions.clone(),","             peers: pnpm_resolving_deps_resolver::WorkspacePeerResolutionOptions {","@@ -281,6 +268,7 @@ impl WorkspaceWalk {","                 pick_lowest_direct: shared.versions.pick_lowest,","                 time_based: self.time_based,","             },","+            parsed_overrides: self.parsed_overrides,","         }","     }"," }"],"additions":5,"deletions":17,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/lib.rs","lines":["@@ -80,10 +80,10 @@ pub use pnpm_package_name::is_valid_dependency_alias;"," pub use resolve_dependency_tree::{","     ChildCatalogs, DependencyResolutionError, DependencySpec, Deprecation, DeprecationLogFn,","     FinalizedChild, FinalizedPackage, FinalizedPackageFn, LockedRuntimeReuse, ManifestHook,","-    ResolutionCancel, ResolveDependencyTreeError, ResolveDependencyTreeOptions,","-    SkippedOptionalDependency, SkippedOptionalDependencyParent, SkippedOptionalLogFn, TreeCtx,","-    UpdateDepth, UpdateReuseScope, UpdateTargets, VersionLine, WorkspaceTreeCtx,","-    declared_specifiers, dependency_is_injected, dependency_meta_is_injected,","+    OverrideEntry, OverrideNoMatchingVersionError, ResolutionCancel, ResolveDependencyTreeError,","+    ResolveDependencyTreeOptions, SkippedOptionalDependency, SkippedOptionalDependencyParent,","+    SkippedOptionalLogFn, TreeCtx, UpdateDepth, UpdateReuseScope, UpdateTargets, VersionLine,","+    WorkspaceTreeCtx, declared_specifiers, dependency_is_injected, dependency_meta_is_injected,","     directory_package_dir, extend_tree, local_directory_child_specs, manifest_child_specs,","     real_package_name_of, resolve_dependency_tree,"," };"],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree.rs","lines":["@@ -1,6 +1,7 @@"," pub use catalogs::{ChildCatalogs, local_directory_child_specs};"," pub use failure::{DependencyResolutionError, ResolutionCancel, ResolveDependencyTreeError};"," pub use manifest::{declared_specifiers, manifest_child_specs};","+pub use override_reframe::{OverrideEntry, OverrideNoMatchingVersionError};"," "," pub use update_scope::{","     LockedRuntimeReuse, UpdateDepth, UpdateReuseScope, UpdateTargets, VersionLine,","@@ -51,6 +52,7 @@ mod finalized;"," mod importer;"," mod locked_resolution;"," mod manifest;","+mod override_reframe;"," mod reuse;"," mod tree_ctx;"," mod walk;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/failure.rs","lines":["@@ -10,7 +10,7 @@ use pnpm_resolving_resolver_base::{"," };"," use std::{fmt, sync::Arc};"," ","-use super::SkippedOptionalDependencyParent;","+use super::{OverrideNoMatchingVersionError, SkippedOptionalDependencyParent};"," "," /// Cooperative cancellation probe polled during synchronous and multi-pass"," /// dependency resolution stages.","@@ -107,6 +107,11 @@ pub enum ResolveDependencyTreeError {","     #[diagnostic(transparent)]","     NoMatchingVersion(#[error(source)] NoMatchingVersionError),"," ","+    /// `ERR_PNPM_NO_MATCHING_VERSION` attributed to the override that forced","+    /// the missing specifier. Boxed to stay under `clippy::result_large_err`.","+    #[diagnostic(transparent)]","+    OverrideNoMatchingVersion(#[error(source)] Box<OverrideNoMatchingVersionError>),","+","     /// The registry answered the metadata request with a non-2xx status,","     /// raised with the matching `ERR_PNPM_FETCH_<status>` code.","     #[diagnostic(transparent)]"],"additions":6,"deletions":1,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/override_reframe.rs","lines":["@@ -0,0 +1,122 @@","+use miette::Diagnostic;","+use pnpm_network::redact_and_sanitize;","+use pnpm_resolving_resolver_base::{NoMatchingVersionError, WantedDependency};","+use pnpm_semver_include_prerelease::{is_valid_semver_range, parse_strict_semver_range};","+","+use super::ResolveDependencyTreeError;","+","+/// An `overrides` entry, reduced to what attributing a missing version to it","+/// needs.","+#[derive(Debug, Clone)]","+pub struct OverrideEntry {","+    /// The entry's key as the user wrote it, e.g. `foo@^1`.","+    pub selector: String,","+    /// The package the entry targets.","+    pub name: String,","+    /// The version range of the target in the selector, if it has one.","+    pub selector_range: Option<String>,","+    /// The specifier the entry forces onto the target.","+    pub new_bare_specifier: String,","+}","+","+/// `ERR_PNPM_NO_MATCHING_VERSION` for a specifier that an override forced","+/// onto a dependency. It names the override entry to fix instead of the","+/// package that happened to depend on the target.","+#[derive(Debug)]","+pub struct OverrideNoMatchingVersionError {","+    pub name: String,","+    pub selector: String,","+    pub new_bare_specifier: String,","+    pub selector_range: Option<String>,","+    /// The highest published version satisfying `selector_range`.","+    pub latest_matching: Option<String>,","+}","+","+impl std::fmt::Display for OverrideNoMatchingVersionError {","+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {","+        write!(","+            f,","+            r#\"Override \"{}\": \"{}\" targets a version of {} that does not exist on the registry.\"#,","+            redact_and_sanitize(&self.selector),","+            redact_and_sanitize(&self.new_bare_specifier),","+            redact_and_sanitize(&self.name),","+        )","+    }","+}","+","+impl std::error::Error for OverrideNoMatchingVersionError {}","+","+impl Diagnostic for OverrideNoMatchingVersionError {","+    fn code<'a>(&'a self) -> Option<Box<dyn std::fmt::Display + 'a>> {","+        Some(Box::new(\"ERR_PNPM_NO_MATCHING_VERSION\"))","+    }","+","+    fn help<'a>(&'a self) -> Option<Box<dyn std::fmt::Display + 'a>> {","+        let range = self.selector_range.as_deref()?;","+        let latest = self.latest_matching.as_deref()?;","+        Some(Box::new(format!(","+            r#\"The latest release of {} matching \"{}\" is \"{latest}\".\"#,","+            redact_and_sanitize(&self.name),","+            redact_and_sanitize(range),","+        )))","+    }","+}","+","+/// Attribute a [`ResolveDependencyTreeError::NoMatchingVersion`] to the","+/// override whose `new_bare_specifier` the failing request carries. Every","+/// other error, and a failure no override explains, is returned unchanged.","+pub(super) fn attribute_to_override(","+    err: ResolveDependencyTreeError,","+    wanted: &WantedDependency,","+    overrides: Option<&[OverrideEntry]>,","+) -> ResolveDependencyTreeError {","+    let reframed = match (&err, overrides) {","+        (ResolveDependencyTreeError::NoMatchingVersion(no_matching_version), Some(overrides)) => {","+            overriding_error(wanted, no_matching_version, overrides)","+        }","+        _ => None,","+    };","+    match reframed {","+        Some(reframed) => ResolveDependencyTreeError::OverrideNoMatchingVersion(Box::new(reframed)),","+        None => err,","+    }","+}","+","+fn overriding_error(","+    wanted: &WantedDependency,","+    no_matching_version: &NoMatchingVersionError,","+    overrides: &[OverrideEntry],","+) -> Option<OverrideNoMatchingVersionError> {","+    let alias = wanted.alias.as_deref()?;","+    let bare_specifier = wanted.bare_specifier.as_deref()?;","+    let matched = overrides","+        .iter()","+        .find(|entry| entry.name == alias && entry.new_bare_specifier == bare_specifier)?;","+    let selector_range = matched.selector_range.clone();","+    // The registry metadata belongs to the package the forced specifier","+    // names, so it describes the target only for a plain range, not for an","+    // alias such as `npm:other@1`. A convergence selector (`pkg@`) carries an","+    // empty range, which is not a range to report on.","+    let latest_matching = selector_range","+        .as_deref()","+        .filter(|range| !range.is_empty())","+        .filter(|_| is_valid_semver_range(&matched.new_bare_specifier))","+        .and_then(|range| max_satisfying(&no_matching_version.versions, range));","+    Some(OverrideNoMatchingVersionError {","+        name: alias.to_string(),","+        selector: matched.selector.clone(),","+        new_bare_specifier: matched.new_bare_specifier.clone(),","+        selector_range,","+        latest_matching,","+    })","+}","+","+pub(super) fn max_satisfying(versions: &[String], range: &str) -> Option<String> {","+    let range = parse_strict_semver_range(range)?;","+    versions","+        .iter()","+        .filter_map(|raw| Some((node_semver::Version::parse(raw).ok()?, raw)))","+        .filter(|(version, _)| version.satisfies(&range))","+        .max_by(|(left, _), (right, _)| left.cmp(right))","+        .map(|(_, raw)| raw.clone())","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/tests.rs","lines":["@@ -5,7 +5,10 @@ use pnpm_resolving_resolver_base::{","     ResolveResult, Resolver, WantedDependency,"," };"," ","-use super::{ResolveDependencyTreeOptions, resolve_dependency_tree};","+use super::{","+    ResolveDependencyTreeError, ResolveDependencyTreeOptions, override_reframe,","+    resolve_dependency_tree,","+};"," "," struct NestedWorkspaceLinkResolver {","     target_dir: std::path::PathBuf,","@@ -109,3 +112,129 @@ async fn canonical_snapshot_link_id_is_relative_to_lockfile_root() {","     assert!(tree.packages.contains_key(\"link:packages/shared\"));","     assert!(!tree.packages.contains_key(\"link:../../../packages/shared\"));"," }","+","+fn acme_no_match_error(bare_specifier: &str, versions: &[&str]) -> ResolveDependencyTreeError {","+    ResolveDependencyTreeError::NoMatchingVersion(","+        pnpm_resolving_resolver_base::NoMatchingVersionError {","+            dep: format!(\"acme@{bare_specifier}\"),","+            registry: \"https://example.com/\".to_string(),","+            published_versions: String::new(),","+            versions: versions","+                .iter()","+                .map(|v| (*v).to_string())","+                .collect(),","+        },","+    )","+}","+","+fn override_entry(","+    selector: &str,","+    selector_range: Option<&str>,","+    new_bare_specifier: &str,","+) -> crate::OverrideEntry {","+    crate::OverrideEntry {","+        selector: selector.to_string(),","+        name: \"acme\".to_string(),","+        selector_range: selector_range.map(str::to_string),","+        new_bare_specifier: new_bare_specifier.to_string(),","+    }","+}","+","+fn wanted_acme(bare_specifier: &str) -> WantedDependency {","+    WantedDependency {","+        alias: Some(\"acme\".to_string()),","+        bare_specifier: Some(bare_specifier.to_string()),","+        ..WantedDependency::default()","+    }","+}","+","+#[test]","+fn override_reframe_names_the_override_and_latest_matching_version() {","+    let overrides = [override_entry(\"acme@^1\", Some(\"^1\"), \"^1.5.0\")];","+","+    let reframed = override_reframe::attribute_to_override(","+        acme_no_match_error(\"^1.5.0\", &[\"1.0.0\", \"1.1.0\"]),","+        &wanted_acme(\"^1.5.0\"),","+        Some(&overrides),","+    );","+","+    assert!(matches!(reframed, ResolveDependencyTreeError::OverrideNoMatchingVersion(_)));","+    assert_eq!(","+        reframed.to_string(),","+        r#\"Override \"acme@^1\": \"^1.5.0\" targets a version of acme that does not exist on the registry.\"#,","+    );","+    assert_eq!(","+        miette::Diagnostic::code(&reframed).map(|c| c.to_string()),","+        Some(\"ERR_PNPM_NO_MATCHING_VERSION\".to_string()),","+    );","+    assert_eq!(","+        miette::Diagnostic::help(&reframed).map(|h| h.to_string()),","+        Some(r#\"The latest release of acme matching \"^1\" is \"1.1.0\".\"#.to_string()),","+    );","+}","+","+#[test]","+fn override_reframe_omits_help_when_selector_has_no_range() {","+    let overrides = [override_entry(\"acme\", None, \"2.0.0\")];","+","+    let reframed = override_reframe::attribute_to_override(","+        acme_no_match_error(\"2.0.0\", &[\"1.0.0\", \"1.1.0\"]),","+        &wanted_acme(\"2.0.0\"),","+        Some(&overrides),","+    );","+","+    assert_eq!(","+        reframed.to_string(),","+        r#\"Override \"acme\": \"2.0.0\" targets a version of acme that does not exist on the registry.\"#,","+    );","+    assert!(miette::Diagnostic::help(&reframed).is_none());","+}","+","+#[test]","+fn override_reframe_keeps_the_error_when_no_override_matches() {","+    let overrides = [override_entry(\"acme@^1\", Some(\"^1\"), \"^3.0.0\")];","+","+    let err = override_reframe::attribute_to_override(","+        acme_no_match_error(\"^1.5.0\", &[\"1.0.0\", \"1.1.0\"]),","+        &wanted_acme(\"^1.5.0\"),","+        Some(&overrides),","+    );","+","+    assert!(matches!(err, ResolveDependencyTreeError::NoMatchingVersion(_)));","+}","+","+#[test]","+fn max_satisfying_picks_the_highest_version_in_range() {","+    let versions = [\"1.0.0\".to_string(), \"1.1.0\".to_string(), \"2.0.0\".to_string()];","+    assert_eq!(override_reframe::max_satisfying(&versions, \"^1\"), Some(\"1.1.0\".to_string()));","+    assert_eq!(override_reframe::max_satisfying(&versions, \"^2\"), Some(\"2.0.0\".to_string()));","+    assert_eq!(override_reframe::max_satisfying(&versions, \"^3\"), None);","+}","+","+#[test]","+fn override_reframe_omits_help_when_the_override_aliases_another_package() {","+    let overrides = [override_entry(\"acme@^1\", Some(\"^1\"), \"npm:other@9.0.0\")];","+","+    let reframed = ov