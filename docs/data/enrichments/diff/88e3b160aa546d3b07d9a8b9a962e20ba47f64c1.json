{"id":"88e3b160aa546d3b07d9a8b9a962e20ba47f64c1","axis":"silent","repo":"pnpm/pnpm","sha":"88e3b160aa546d3b07d9a8b9a962e20ba47f64c1","parsed":{"files":[{"path":".changeset/libsql-startup-connect-retry.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now gives up on a TCP connection attempt to the libsql auth database after 10 seconds. At startup it retries an attempt that timed out until the startup deadline, so a dropped connection attempt no longer stops the server."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend.rs","lines":["@@ -86,10 +86,13 @@ impl LibsqlAuth {","     /// the background (every `syncIntervalSecs`), so reads hit the local","     /// file. libsql probes the primary for its newer sync protocol, the","     /// only one Turso Cloud serves, and falls back to the replication","-    /// protocol of a self-hosted `sqld`. The initial sync is awaited","-    /// under [`DEFAULT_STARTUP_TIMEOUT`] on either protocol. Opening a","-    /// connection over the newer one blocks in place, so the caller must","-    /// run on tokio's multi-thread runtime. Without `replicaPath`, every","+    /// protocol of a self-hosted `sqld`. Opening a connection over the","+    /// newer one blocks in place, so the caller must run on tokio's","+    /// multi-thread runtime.","+    ///","+    /// The whole startup, the initial sync included, runs under one","+    /// [`DEFAULT_STARTUP_TIMEOUT`], within which a dial that times out is","+    /// retried. Without `replicaPath`, every","     /// read is a remote query against the primary — always fresh, but a","     /// network round-trip on the auth hot path.","     pub async fn connect(settings: &LibsqlSettings, max_users: MaxUsers) -> Result<Self> {","@@ -104,17 +107,25 @@ impl LibsqlAuth {","             });","         }","         let connector = LibsqlConnector::for_url(&settings.url, settings.auth_token.is_some())?;","+        let _startup_dials = connector.retry_timed_out_dials();","+        with_auth_timeout(","+            DEFAULT_STARTUP_TIMEOUT,","+            Box::pin(Self::open(settings, max_users, connector)),","+        )","+        .await","+    }","+","+    async fn open(","+        settings: &LibsqlSettings,","+        max_users: MaxUsers,","+        connector: LibsqlConnector,","+    ) -> Result<Self> {","         let db = if let Some(path) = &settings.replica_path {","             Self::open_replica(path, settings, connector).await?","         } else {","             let auth_token = settings.auth_token.clone().unwrap_or_default();","-            with_auth_timeout(","-                DEFAULT_STARTUP_TIMEOUT,","-                Box::pin(","-                    Builder::new_remote(settings.url.clone(), auth_token)","-                        .connector(connector)","-                        .build(),","-                ),","+            Box::pin(","+                Builder::new_remote(settings.url.clone(), auth_token).connector(connector).build(),","             )","             .await?","         };","@@ -147,12 +158,12 @@ impl LibsqlAuth {","         if interval > 0 {","             builder = builder.sync_interval(Duration::from_secs(interval));","         }","-        let db = with_auth_timeout(DEFAULT_STARTUP_TIMEOUT, Box::pin(builder.build())).await?;","+        let db = Box::pin(builder.build()).await?;","         if interval == 0 {","             // libsql bootstraps the replica during the build only alongside a","-            // sync interval; otherwise it would do so inside `Database::connect`,","-            // outside the startup deadline.","-            with_auth_timeout(DEFAULT_STARTUP_TIMEOUT, Box::pin(db.sync())).await?;","+            // sync interval; otherwise it would do so inside the blocking","+            // `Database::connect`, which the startup deadline cannot cancel.","+            Box::pin(db.sync()).await?;","         }","         Ok(db)","     }"],"additions":26,"deletions":15,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/connector.rs","lines":["@@ -13,18 +13,32 @@ use pnpm_network::is_url_secure_for_credentials;"," use rustls::{ClientConfig, pki_types::ServerName};"," use rustls_platform_verifier::BuilderVerifierExt;"," use std::{","+    error::Error as StdError,","     future::Future,","     io,","     pin::Pin,","-    sync::Arc,","+    sync::{","+        Arc,","+        atomic::{AtomicBool, Ordering},","+    },","     task::{Context, Poll},","+    time::Duration,"," };"," use tokio::{","     io::{AsyncRead, AsyncWrite, ReadBuf},","     net::TcpStream,"," };"," use tokio_rustls::{TlsConnector, client::TlsStream};","-use tower_0_4::Service;","+use tower_0_4::{Service, ServiceExt};","+","+/// How long one TCP dial may take. Without it a dropped SYN waits out the","+/// kernel's retransmissions, about two minutes on Linux.","+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);","+","+/// The wait before the first retry of a timed-out dial, doubled per retry.","+const FIRST_DIAL_RETRY_DELAY: Duration = Duration::from_millis(250);","+","+const MAX_DIAL_RETRY_DELAY: Duration = Duration::from_secs(5);"," "," /// Dials `https://` URLs over TLS and `http://` URLs in plain text."," #[derive(Clone)]","@@ -35,6 +49,17 @@ pub(super) struct LibsqlConnector {","     /// Whether requests carry an auth token, which then must not cross a","     /// cleartext link to a host other than loopback.","     carries_token: bool,","+    /// Set while a [`DialRetryGuard`] is alive, shared by every clone.","+    retries_timed_out_dials: Arc<AtomicBool>,","+}","+","+/// Keeps its [`LibsqlConnector`] retrying timed-out dials until dropped.","+pub(super) struct DialRetryGuard(Arc<AtomicBool>);","+","+impl Drop for DialRetryGuard {","+    fn drop(&mut self) {","+        self.0.store(false, Ordering::Relaxed);","+    }"," }"," "," impl LibsqlConnector {","@@ -65,7 +90,16 @@ impl LibsqlConnector {","         let mut tcp = HttpConnector::new();","         tcp.enforce_http(false);","         tcp.set_nodelay(true);","-        Self { tcp, tls, carries_token: false }","+        tcp.set_connect_timeout(Some(CONNECT_TIMEOUT));","+        Self { tcp, tls, carries_token: false, retries_timed_out_dials: Arc::default() }","+    }","+","+    /// Retry every dial that times out, with backoff, until the guard drops.","+    /// A timed-out dial sent nothing, so the retry is safe for any request.","+    /// The caller bounds the wait with its own deadline.","+    pub(super) fn retry_timed_out_dials(&self) -> DialRetryGuard {","+        self.retries_timed_out_dials.store(true, Ordering::Relaxed);","+        DialRetryGuard(Arc::clone(&self.retries_timed_out_dials))","     }"," ","     /// Why `uri` must not be dialed, if it must not.","@@ -110,9 +144,10 @@ impl Service<Uri> for LibsqlConnector {","             return Box::pin(async move { Err(reason.into()) });","         }","         let tls = self.tls.clone();","-        let tcp = self.tcp.call(uri.clone());","+        let tcp = self.tcp.clone();","+        let retries_timed_out_dials = Arc::clone(&self.retries_timed_out_dials);","         Box::pin(async move {","-            let stream = tcp.await?;","+            let stream = dial(tcp, &uri, &retries_timed_out_dials).await?;","             let Some(tls) = tls else {","                 return Ok(MaybeTlsStream::Plain(stream));","             };","@@ -126,6 +161,46 @@ impl Service<Uri> for LibsqlConnector {","     }"," }"," ","+/// Dial `uri` with `dialer`, retrying a timed-out dial while","+/// `retries_timed_out_dials` is set.","+async fn dial<Dialer>(","+    dialer: Dialer,","+    uri: &Uri,","+    retries_timed_out_dials: &AtomicBool,","+) -> Result<Dialer::Response, BoxError>","+where","+    Dialer: Service<Uri> + Clone,","+    Dialer::Error: Into<BoxError>,","+{","+    let mut delay = FIRST_DIAL_RETRY_DELAY;","+    loop {","+        let error: BoxError = match dialer.clone().oneshot(uri.clone()).await {","+            Ok(stream) => return Ok(stream),","+            Err(error) => error.into(),","+        };","+        if !retries_timed_out_dials.load(Ordering::Relaxed) || !is_timeout(&*error) {","+            return Err(error);","+        }","+        tracing::warn!(host = uri.host(), %error, ?delay, \"auth database dial timed out, retrying\");","+        tokio::time::sleep(delay).await;","+        delay = (delay * 2).min(MAX_DIAL_RETRY_DELAY);","+    }","+}","+","+fn is_timeout(error: &(dyn StdError + 'static)) -> bool {","+    let mut cause = Some(error);","+    while let Some(error) = cause {","+        if error","+            .downcast_ref::<io::Error>()","+            .is_some_and(|error| error.kind() == io::ErrorKind::TimedOut)","+        {","+            return true;","+        }","+        cause = error.source();","+    }","+    false","+}","+"," pub(super) enum MaybeTlsStream {","     Plain(TcpStream),","     Tls(Box<TlsStream<TcpStream>>),"],"additions":80,"deletions":5,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/connector/tests.rs","lines":["@@ -1,4 +1,4 @@","-use super::LibsqlConnector;","+use super::{LibsqlConnector, dial};"," use crate::libsql_backend::{LibsqlAuth, RegistryError};"," use http_0_2::Uri;"," use libsql::Builder;","@@ -13,11 +13,12 @@ use std::{","     net::{TcpListener, TcpStream},","     sync::{","         Arc,","+        atomic::{AtomicUsize, Ordering},","         mpsc::{self, Receiver},","     },","     time::Duration,"," };","-use tower_0_4::ServiceExt;","+use tower_0_4::{ServiceExt, service_fn};"," "," /// The Hrana pipeline response to libsql's request for one statement:"," /// a batch with an empty step result, the autocommit state, and the close.","@@ -157,6 +158,47 @@ async fn reports_an_unreachable_database_as_an_error() {","     assert!(LibsqlAuth::connect(&settings(url), MaxUsers::Unlimited).await.is_err());"," }"," ","+/// Dial through a stub that fails with `kind` `failures` times, then","+/// connects, and return the result with the number of attempts.","+async fn dial_failing(","+    connector: &LibsqlConnector,","+    kind: std::io::ErrorKind,","+    failures: usize,","+) -> (bool, usize) {","+    let attempts = Arc::new(AtomicUsize::new(0));","+    let dialer = service_fn(|_: Uri| {","+        let attempt = attempts.fetch_add(1, Ordering::Relaxed);","+        async move { if attempt < failures { Err(std::io::Error::from(kind)) } else { Ok(()) } }","+    });","+    let uri = \"http://127.0.0.1:8080\".parse().unwrap();","+    let result = dial(dialer, &uri, &connector.retries_timed_out_dials).await;","+    (result.is_ok(), attempts.load(Ordering::Relaxed))","+}","+","+#[tokio::test]","+async fn retries_a_timed_out_dial_while_the_guard_is_alive() {","+    let connector = LibsqlConnector::for_url(\"http://127.0.0.1:8080\", false).unwrap();","+    let _guard = connector.retry_timed_out_dials();","+    let outcome = dial_failing(&connector, std::io::ErrorKind::TimedOut, 2).await;","+    assert_eq!(outcome, (true, 3));","+}","+","+#[tokio::test]","+async fn fails_a_timed_out_dial_once_the_guard_drops() {","+    let connector = LibsqlConnector::for_url(\"http://127.0.0.1:8080\", false).unwrap();","+    drop(connector.retry_timed_out_dials());","+    let outcome = dial_failing(&connector, std::io::ErrorKind::TimedOut, 1).await;","+    assert_eq!(outcome, (false, 1));","+}","+","+#[tokio::test]","+async fn fails_a_refused_dial_without_retrying() {","+    let connector = LibsqlConnector::for_url(\"http://127.0.0.1:8080\", false).unwrap();","+    let _guard = connector.retry_timed_out_dials();","+    let outcome = dial_failing(&connector, std::io::ErrorKind::ConnectionRefused, 1).await;","+    assert_eq!(outcome, (false, 1));","+}","+"," // Only these platforms load the trust store from SSL_CERT_FILE and SSL_CERT_DIR."," #[cfg(all(unix, not(target_vendor = \"apple\")))]"," #[tokio::test]",""],"additions":44,"deletions":2,"truncated":false}],"additions":155,"deletions":22,"truncated"