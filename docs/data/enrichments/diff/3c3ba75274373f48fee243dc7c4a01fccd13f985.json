"-\t\t\tinput:       \"tenant/rc/1:source=\\xb5\",","-\t\t\texpectedErr: tenant.ValidMetadata(\":source=\\xb5\"),","-\t\t},","-\t}","-","-\tfor name, tc := range tests {","-\t\tt.Run(name, func(t *testing.T) {","-\t\t\ttenantID, metadata, err := ParseTenantIDWithMetadata(tc.input)","-\t\t\tif tc.expectedErr != nil {","-\t\t\t\trequire.EqualError(t, err, tc.expectedErr.Error())","-\t\t\t\treturn","-\t\t\t}","-\t\t\trequire.NoError(t, err)","-\t\t\tassert.Equal(t, tc.expectedTenantID, tenantID)","-\t\t\tassert.Equal(t, tenant.NewMetadata(tc.expectedMetadata), metadata)","-\t\t})","+func TestMaxTenantMetadataLength(t *testing.T) {","+\tassert.Equal(t, 59, MaxTenantMetadataLength(1))","+\tassert.Equal(t, 59, MaxTenantMetadataLength(10))","+\tassert.Equal(t, 58, MaxTenantMetadataLength(11))","+\tassert.Equal(t, 57, MaxTenantMetadataLength(MaxReadCompartments))","+","+\tfor _, numReadCompartments := range []int{1, 10, 11, MaxReadCompartments} {","+\t\tmaxLength := MaxTenantMetadataLength(numReadCompartments)","+\t\tlastCompartmentID := numReadCompartments - 1","+","+\t\t// Metadata of the maximum length gives a valid tenant ID for the last read compartment.","+\t\tmetadata := tenant.NewMetadata(\":a=\" + strings.Repeat(\"x\", maxLength-len(\":a=\")))","+\t\t_, _, err := tenant.ParseWithMetadata(TenantIDWithReadCompartment(\"user\", metadata, lastCompartmentID))","+\t\trequire.NoError(t, err)","+","+\t\t// One more byte of metadata gives an invalid tenant ID.","+\t\tmetadata = tenant.NewMetadata(\":a=\" + strings.Repeat(\"x\", maxLength+1-len(\":a=\")))","+\t\t_, _, err = tenant.ParseWithMetadata(TenantIDWithReadCompartment(\"user\", metadata, lastCompartmentID))","+\t\trequire.EqualError(t, err, \"metadata too long: 65\")"," \t}"," }"],"additions":24,"deletions":106,"truncated":false},{"path":"pkg/distributor/compartments.go","lines":["@@ -119,7 +119,7 @@ func groupSeriesHashesByReadCompartment(router *compartments.TopicRouter, userID"," \t\tif count > 0 {"," \t\t\tend :=