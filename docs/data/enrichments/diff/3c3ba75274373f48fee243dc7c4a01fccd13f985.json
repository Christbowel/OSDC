{"id":"3c3ba75274373f48fee243dc7c4a01fccd13f985","axis":"silent","repo":"grafana/mimir","sha":"3c3ba75274373f48fee243dc7c4a01fccd13f985","parsed":{"files":[{"path":"docs/sources/mimir/manage/mimir-runbooks/_index.md","lines":["@@ -3036,6 +3036,20 @@ How to **fix** it:"," When you configure `-ingester.error-sample-rate` to a value of `N` that is greater than `0`, only every `Nth` error is logged."," {{< /admonition >}}"," ","+### err-mimir-tenant-metadata-too-long","+","+This error can only be returned when both the experimental compartments (`-compartments.enabled=true`) and the usage-tracker (`-usage-tracker.enabled=true`) are enabled. It occurs when the distributor rejects a write request because the tenant metadata in the tenant ID is too long.","+","+How it **works**:","+","+- Tenant metadata is the list of `:key=value` pairs after the tenant ID, for example `tenant-1:source=example`. It can be at most 64 bytes long.","+- When compartments are enabled, the distributor adds the read compartment ID of each series to the tenant metadata, as `:rc=<id>`, to track the active series of each read compartment in the usage-tracker.","+- To leave room for the read compartment ID, the distributor rejects write requests whose tenant metadata is longer than 64 bytes minus the length of the longest `:rc=<id>` pair, which depends on `-compartments.read.num-compartments`. The 4xx status code is used to ensure the client will not retry a request which will consistently fail.","+","+How to **fix** it:","+","+- Configure the client writing to Mimir to send shorter tenant metadata. Clients pass the tenant metadata in the `X-Scope-OrgID` header, using the format `tenantID:key1=value1:key2=value2`. Shorten or remove some of the `key=value` pairs in the sent headers.","+"," ### err-mimir-max-series-per-user"," "," This error occurs when the number of in-memory series for a given tenant exceeds the configured limit."],"additions":14,"deletions":0,"truncated":false},{"path":"pkg/compartments/tenant_id.go","lines":["@@ -4,68 +4,22 @@ package compartments"," "," import ("," \t\"strconv\"","-\t\"strings\""," "," \t\"github.com/grafana/dskit/tenant\""," )"," ","-// readCompartmentTenantIDInfix is inserted into tenant IDs as \"/rc/<id>\" before any metadata.","-const readCompartmentTenantIDInfix = \"/rc/\"","+// readCompartmentMetadataKey is the tenant metadata key that holds the read compartment ID.","+const readCompartmentMetadataKey = \"rc\""," ","-// TenantIDWithReadCompartment returns tenantID with the \"/rc/<compartmentID>\" suffix. tenantID must","-// not contain tenant metadata. Use tenant.Metadata.WithTenant to add the metadata after the suffix.","-func TenantIDWithReadCompartment(tenantID string, compartmentID int) string {","-\treturn tenantID + readCompartmentTenantIDInfix + strconv.Itoa(compartmentID)","+// TenantIDWithReadCompartment returns tenantID with metadata and the \"rc=<compartmentID>\" metadata","+// key-value pair. It replaces an \"rc\" key that is already in metadata.","+func TenantIDWithReadCompartment(tenantID string, metadata tenant.Metadata, compartmentID int) string {","+\treturn metadata.With(readCompartmentMetadataKey, strconv.Itoa(compartmentID)).WithTenant(tenantID)"," }"," ","-// BaseTenantID returns tenantIDWithMetadata without the tenant metadata and without a well-formed","-// \"/rc/<compartmentID>\" suffix. It does not allocate.","-func BaseTenantID(tenantIDWithMetadata string) string {","-\tif baseTenantID, _, ok := splitReadCompartmentTenantID(tenantIDWithMetadata); ok {","-\t\treturn baseTenantID","-\t}","-\treturn tenant.TrimMetadata(tenantIDWithMetadata)","-}","-","-// ParseTenantIDWithMetadata parses tenantIDWithMetadata like tenant.ParseWithMetadata. It also accepts","-// a well-formed \"/rc/<compartmentID>\" suffix before the metadata, and the returned tenantID keeps that","-// suffix. It does not allocate when the input is valid.","-func ParseTenantIDWithMetadata(tenantIDWithMetadata string) (tenantID string, metadata tenant.Metadata, err error) {","-\tbaseTenantID, metadataSource, ok := splitReadCompartmentTenantID(tenantIDWithMetadata)","-\tif !ok {","-\t\treturn tenant.ParseWithMetadata(tenantIDWithMetadata)","-\t}","-\tif err := tenant.ValidTenantID(baseTenantID); err != nil {","-\t\treturn \"\", tenant.Metadata{}, err","-\t}","-\tif metadata, err = tenant.ParseMetadata(metadataSource); err != nil {","-\t\treturn \"\", tenant.Metadata{}, err","-\t}","-\treturn tenantIDWithMetadata[:len(tenantIDWithMetadata)-len(metadataSource)], metadata, nil","-}","-","-// splitReadCompartmentTenantID splits tenantIDWithMetadata into the tenant ID without a","-// well-formed \"/rc/<compartmentID>\" suffix and the metadata (including the leading ':').","-// ok is false when no well-formed suffix is present. The returned strings are slices of the","-// input and do not allocate.","-func splitReadCompartmentTenantID(tenantIDWithMetadata string) (tenantID, metadata string, ok bool) {","-\t// Most tenant IDs have no read compartment suffix. IndexByte finds those IDs faster than LastIndex.","-\tif strings.IndexByte(tenantIDWithMetadata, '/') < 0 {","-\t\treturn \"\", \"\", false","-\t}","-","-\ttenantWithCompartment, metadata := tenantIDWithMetadata, \"\"","-\tif idx := strings.IndexByte(tenantIDWithMetadata, ':'); idx != -1 {","-\t\ttenantWithCompartment, metadata = tenantIDWithMetadata[:idx], tenantIDWithMetadata[idx:]","-\t}","-","-\trcIdx := strings.LastIndex(tenantWithCompartment, readCompartmentTenantIDInfix)","-\tif rcIdx < 0 {","-\t\treturn \"\", \"\", false","-\t}","-","-\tif _, err := strconv.Atoi(tenantWithCompartment[rcIdx+len(readCompartmentTenantIDInfix):]); err != nil {","-\t\treturn \"\", \"\", false","-\t}","-\treturn tenantWithCompartment[:rcIdx], metadata, true","+// MaxTenantMetadataLength returns the maximum length of the metadata passed to","+// TenantIDWithReadCompartment, so that the metadata of the result doesn't exceed","+// tenant.MaxMetadataLength for any of numReadCompartments read compartments.","+func MaxTenantMetadataLength(numReadCompartments int) int {","+\treturn tenant.MaxMetadataLength - len(\":\"+readCompartmentMetadataKey+\"=\") - len(strconv.Itoa(numReadCompartments-1))"," }"],"additions":11,"deletions":57,"truncated":false},{"path":"pkg/compartments/tenant_id_test.go","lines":["@@ -3,6 +3,7 @@"," package compartments"," "," import (","+\t\"strings\""," \t\"testing\""," "," \t\"github.com/grafana/dskit/tenant\"","@@ -11,113 +12,30 @@ import ("," )"," "," func TestTenantIDWithReadCompartment(t *testing.T) {","-\tassert.Equal(t, \"123/rc/2\", TenantIDWithReadCompartment(\"123\", 2))","-\tassert.Equal(t, \"user/rc/0\", TenantIDWithReadCompartment(\"user\", 0))","+\tassert.Equal(t, \"123:rc=2\", TenantIDWithReadCompartment(\"123\", tenant.Metadata{}, 2))","+\tassert.Equal(t, \"user:rc=0\", TenantIDWithReadCompartment(\"user\", tenant.Metadata{}, 0))","+\tassert.Equal(t, \"user:a=b:rc=1:source=x\", TenantIDWithReadCompartment(\"user\", tenant.NewMetadata(\":a=b:source=x\"), 1))","+\tassert.Equal(t, \"user:rc=1\", TenantIDWithReadCompartment(\"user\", tenant.NewMetadata(\":rc=7\"), 1), \"existing rc key must be replaced\")"," }"," ","-func TestBaseTenantID(t *testing.T) {","-\ttests := map[string]struct {","-\t\tinput    string","-\t\texpected string","-\t}{","-\t\t\"read compartment without metadata\": {","-\t\t\tinput:    \"tenant/rc/1\",","-\t\t\texpected: \"tenant\",","-\t\t},","-\t\t\"read compartment with metadata\": {","-\t\t\tinput:    \"tenant/rc/1:source=x\",","-\t\t\texpected: \"tenant\",","-\t\t},","-\t\t\"compartment zero\": {","-\t\t\tinput:    \"user/rc/0\",","-\t\t\texpected: \"user\",","-\t\t},","-\t\t\"no read compartment\": {","-\t\t\tinput:    \"tenant\",","-\t\t\texpected: \"tenant\",","-\t\t},","-\t\t\"metadata only\": {","-\t\t\tinput:    \"tenant:source=x\",","-\t\t\texpected: \"tenant\",","-\t\t},","-\t\t\"malformed non-digit compartment\": {","-\t\t\tinput:    \"tenant/rc/x\",","-\t\t\t