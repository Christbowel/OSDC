k lock(BlockedSPKIsForTestingMutex());","-  for (const auto& blocked : BlockedSPKIsForTesting()) {","-    if (digest == blocked) return true;","-  }","-  return false;","-}","-"," enum class SpkiCheck { kAllowed, kBlocked, kError };"," "," // Hashes the DER-encoded SubjectPublicKeyInfo of `cert` and looks it up in","@@ -1474,7 +1461,6 @@ SpkiCheck CheckSPKI(X509* cert) {","   for (const auto& blocked : kBlockedSPKIs) {","     if (digest == blocked) return SpkiCheck::kBlocked;","   }","-  if (IsBlockedSPKIForTesting(digest)) return SpkiCheck::kBlocked;","   return SpkiCheck::kAllowed;"," }"," ","@@ -1594,26 +1580,6 @@ void InstallCertVerifyCallback(SSL_CTX* ctx) {","   SSL_CTX_set_cert_verify_callback(ctx, CertVerifyCallback, nullptr);"," }"," ","-void SecureContext::AddBlockedSPKIForTesting(","-    const FunctionCallbackInfo<Value>& args) {","-  Environment* env = Environment::GetCurrent(args);","-  THROW_AND_RETURN_IF_NOT_BUFFER(env, args[0], \"SPKI hash\");","-  ArrayBufferOrViewContents<uint8_t> hash(args[0]);","-  if (hash.size() != kSpkiHashLength) {","-    return THROW_ERR_OUT_OF_RANGE(env, \"SPKI hash must be 32 bytes\");","-  }","-  SpkiHash entry;","-  memcpy(entry.data(), hash.data(), entry.size());","-  Mutex::ScopedLock lock(BlockedSPKIsForTestingMutex());","-  BlockedSPKIsForTesting().push_back(entry);","-}","-","-void SecureContext::ClearBlockedSPKIsForTesting(","-    const FunctionCallbackInfo<Value>& args) {","-  Mutex::ScopedLock lock(BlockedSPKIsForTestingMutex());","-  BlockedSPKIsForTesting().clear();","-}","-"," void SecureContext::Initialize(Environment* env, Local<Object> target) {","   Local<Context> context = env->context();","   SetConstructorFunction(context,","@@ -1641,12 +1607,6 @@ void SecureContext::Initialize(Environment* env, Local<Object> target) {","                         target,","                         \"getCertificateCompressionAlgorithms\",","                         GetCertificateCompressionAlgorithms);","-  SetMethod(","-