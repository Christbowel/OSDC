","-const { internalBinding } = require('internal/test/binding');","-","-const {","-  addBlockedSPKIForTesting,","-  clearBlockedSPKIsForTesting,","-} = internalBinding('crypto');","-","-function spkiSha256(pem) {","-  const spki = new X509Certificate(pem).publicKey.export({","-    type: 'spki',","-    format: 'der',","-  });","-  return createHash('sha256').update(spki).digest();","-}"," "," const rootCert = fixtures.readKey('ca1-cert.pem');","-const intermediateCert = fixtures.readKey('ca3-cert.pem');","-const leafKey = fixtures.readKey('agent6-key.pem');","-const leafChain = fixtures.readKey('agent6-cert.pem');","-const unaffectedKey = fixtures.readKey('agent1-key.pem');","-const unaffectedCert = fixtures.readKey('agent1-cert.pem');","-// ca2 is unrelated to the agent6 chain; appended to the server's certificate","-// it is sent to the peer but never becomes part of the verified chain.","-const unrelatedCert = fixtures.readKey('ca2-cert.pem');","-","-const intermediateSpkiHash = spkiSha256(intermediateCert);","-const leafSpkiHash = spkiSha256(leafChain);","-const unrelatedSpkiHash = spkiSha256(unrelatedCert);","+const blockedCaCert = fixtures.readKey('blocked-ca-cert.pem');","+const blockedCaLeafKey = fixtures.readKey('blocked-ca-leaf-key.pem');","+const blockedCaLeafChain = fixtures.readKey('blocked-ca-leaf-cert.pem');","+const blockedKey = fixtures.readKey('blocked-ca-key.pem');","+const blockedKeyLeafCert = fixtures.readKey('blocked-key-leaf-cert.pem');","+const unaffectedKey = fixtures.readKey('agent6-key.pem');","+const unaffectedChain = fixtures.readKey('agent6-cert.pem');","+const serverKey = fixtures.readKey('agent1-key.pem');","+const serverCert = fixtures.readKey('agent1-cert.pem');"," "," describe('SPKI blocklist on the server certificate', function() {","   let server;","   let client;","-  let opts;"," ","-  beforeEach(async function() {","-    server = tls.createServer({","-      key: leafKey,","-      cert: leafChain,","-    }, (socket) => socket.resume());","+  function listen(serverOpts) {","+    server = tls.createServer(serverOpts, (socket) => socket.resume());","     server.listen(0);","-    await once(server, 'listening');","+    return once(server, 'listening');","+  }"," ","-    opts = {","+  function connect(clientOpts) {","+    client = tls.connect({","       port: server.address().port,","       ca: rootCert,","       checkServerIdentity() {},","-    };","-  });","+      ...clientOpts,","+    });","+    return client;","+  }"," ","-  afterEach(async function() {","-    clearBlockedSPKIsForTesting();","+  afterEach(function() {","     client?.destroy();","     server?.close();","   });"," ","-  it('accepts the chain when nothing is blocked', async function() {","-    client = tls.connect(opts);","+  it('accepts a chain that contains no blocked key', async function() {","+    await listen({ key: unaffectedKey, cert: unaffectedChain });","+    connect();","     await once(client, 'secureConnect');","     assert.strictEqual(client.authorized, true);","   });"," ","   it('rejects a chain through a blocked intermediate', async function() {","-    addBlockedSPKIForTesting(intermediateSpkiHash);","+    await listen({ key: blockedCaLeafKey, cert: blockedCaLeafChain });","     await assert.rejects(async () => {","-      client = tls.connect(opts);","+      connect();","       await once(client, 'secureConnect');","     }, { code: 'CERT_REVOKED' });","   });"," ","   it('rejects a chain whose leaf key is blocked', async function() {","-    addBlockedSPKIForTesting(leafSpkiHash);","+    await listen({ key: blockedKey, cert: blockedKeyLeafCert });","     await assert.rejects(async () => {","-      client = tls.connect(opts);","+      connect();","       await once(client, 'secureConnect');","     }, { code: 'CERT_REVOKED' });"],"additions":33,"deletions":51,"truncated":false}],"additions":386,"deletions":114,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-10-30T15:55:30.512065+00:00"}