istributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Authentication\\Event;","+","+use TYPO3\\CMS\\Core\\Database\\Query\\Expression\\CompositeExpression;","+use TYPO3\\CMS\\Core\\Database\\Query\\Expression\\ExpressionBuilder;","+","+/**","+ * Listeners can change the constraint selecting the pages a backend user holds","+ * the given page permissions for, e.g. to apply access control lists. The","+ * constraint is used by queries such as the page tree and the record list.","+ *","+ * Build further constraints with the expression builder of the event and refer","+ * to the pages table by its alias:","+ *","+ *   $expr = $event->getExpressionBuilder();","+ *   $event->addConstraint($expr->neq($event->getTableAlias() . '.doktype', 254));","+ *","+ * Constraints added with addConstraint() restrict the pages further. To grant","+ * pages in addition, combine the current constraint with setConstraint():","+ *","+ *   $event->setConstraint($expr->or($event->getConstraint(), $expr->eq(...)));","+ *","+ * Decisions on a single page are taken by ModifyPagePermissionsEvent. A listener","+ * of this event must decide in the same way, so that listings and checks of","+ * single pages agree. While a listener is registered, the webmount check selects","+ * the pages up to the webmount with the constraint instead of evaluating their","+ * permissions in PHP.","+ *","+ * The event is not dispatched for admins, who are not restricted.","+ */","+final class ModifyPagePermissionConstraintEvent","+{","+    /**","+     * @param list<int> $groupIds","+     */","+    public function __construct(","+        private CompositeExpression $constraint,","+        private readonly ExpressionBuilder $expressionBuilder,","+        private readonly int $permissions,","+        private readonly string $tableAlias,","+        private readonly int $userId,","+        private readonly array $groupIds,","+        private readonly int $workspaceId,","+    ) {}","+","+    public function getConstraint(): CompositeExpression","+    {","+        return $this->constraint;","+    }","+","+    public function setConstraint(CompositeExpression $constraint): void","+    {","+        $this->constraint = $constraint;","+    }","+","+    /**","+     * Restricts the selected pages further: each constraint must hold in addition.","+     */","+    public function addConstraint(CompositeExpression|string ...$constraints): void","+    {","+        $this->constraint = $this->expressionBuilder->and($this->constraint, ...$constraints);","+    }","+","+    /**","+     * The expression builder of the connection of the pages table, to build","+     * constraints with quoted identifiers and values.","+     */","+    public function getExpressionBuilder(): ExpressionBuilder","+    {","+        return $this->expressionBuilder;","+    }","+","+    /**","+     * The bitmask of the permissions the pages are selected for, see TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission.","+     */","+    public function getPermissions(): int","+    {","+        return $this->permissions;","+    }","+","+    /**","+     * The alias of the pages table the constraint refers to.","+     */","+    public function getTableAlias(): string","+    {","+        return $this->tableAlias;","+    }","+","+    public function getUserId(): int","+    {","+        return $this->userId;","+    }","+","+    /**","+     * @return list<int>","+     */","+    public function getGroupIds(): array","+    {","+        return $this->groupIds;","+    }","+","+    /**","+     * The workspace of the user, 0 for live and before the workspace of the user","+     * is initialized during the login.","+     */","+    public function getWorkspaceId(): int","+    {","+        return $this->workspaceId;","+    }","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Authentication/Event/ModifyPagePermissionsEvent.php","lines":["@@ -0,0 +1,95 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Authentication\\Event;","+","+/**","+ * Listeners can grant or revoke the permissions a backend user has on a page,","+ * e.g. to apply access control lists. The permissions are calculated from the","+ * owner, group and everybody settings of the page, after the page has been","+ * found within a webmount of the user.","+ *","+ * Listings select pages with a constraint, which listeners of","+ * ModifyPagePermissionConstraintEvent change in the same way.","+ *","+ * The event is not dispatched for admins, who hold all permissions, and not for","+ * pages outside the webmounts of the user.","+ *","+ * The page record holds the fields the caller loaded, e.g. the page tree passes","+ * a subset of the fields. Load a missing field by the uid of the page.","+ *","+ * The permission checks of the DataHandler do not dispatch the event yet, only","+ * the check of the subpages when a page is deleted recursively does: a listener","+ * revoking a permission hides the action in the backend, but does not keep the","+ * DataHandler from executing it.","+ */","+final class ModifyPagePermissionsEvent","+{","+    /**","+     * @param array<string, mixed> $pageRecord","+     * @param list<int> $groupIds","+     */","+    public function __construct(","+        private readonly array $pageRecord,","+        private int $permissions,","+        private readonly int $userId,","+        private readonly array $groupIds,","+        private readonly int $workspaceId,","+    ) {}","+","+    /**","+     * @return array<string, mixed>","+     */","+    public function getPageRecord(): array","+    {","+        return $this->pageRecord;","+    }","+","+    /**","+     * The bitmask of the permissions, see TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission.","+     */","+    public function getPermissions(): int","+    {","+        return $this->permissions;","+    }","+","+    public function setPermissions(int $permissions): void","+    {","+        $this->permissions = $permissions;","+    }","+","+    public function getUserId(): int","+    {","+        return $this->userId;","+    }","+","+    /**","+     * @return list<int>","+     */","+    public function getGroupIds(): array","+    {","+        return $this->groupIds;","+    }","+","+    /**","+     * The workspace of the user, 0 for live.","+     */","+    public function getWorkspaceId(): int","+    {","+        return $this->workspaceId;","+    }","+}"],"additions":95,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Security/Authorization/BackendMountContext.php","lines":["@@ -0,0 +1,73 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Security\\Authorization;","+","+use Symfony\\Component\\Security\\Core\\Authentication\\Token\\TokenInterface;","+use TYPO3\\CMS\\Core\\Authentication\\BackendUserAuthentication;","+","+/**","+ * The mounts of a backend user in a request: the workspace and the","+ * webmounts. Neither belongs to the principal, as the webmounts depend on","+ * the workspace and can be changed during a request, e.g. by the mount","+ * points of the element browser.","+ *","+ * The backend stores the mounts as attribute of the PrincipalToken, so that","+ * voters decide on the mounts the request started with.","+ *","+ * @internal not part of TYPO3 Core API yet, still experimental as part of the","+ *           authentication modernization groundwork","+ */","+final readonly class BackendMountContext","+{","+    public const string TOKEN_ATTRIBUTE = 'typo3.backend_mounts';","+","+    /**","+     * @param int $workspaceId the workspace of the user, 0 for live","+     * @param list<int> $webmounts uids of the pages mounted for the user, may include 0","+     */","+    public function __construct(","+        public int $workspaceId,","+        public array $webmounts,","+    ) {}","+","+    /**","+     * The mounts stored on the token, or those of the backend user object the","+     * principal of the token was built from, no mounts otherwise.","+     */","+    public static function fromToken(TokenInterface $token, LegacyBackendUserRegistry $legacyUserRegistry): self","+    {","+        $mounts = $token->hasAttribute(self::TOKEN_ATTRIBUTE) ? $token->getAttribute(self::TOKEN_ATTRIBUTE) : null;","+        if ($mounts instanceof self) {","+            return $mounts;","+        }","+        $user = $token->getUser();","+        $backendUser = $user instanceof PrincipalUser ? $legacyUserRegistry->getUser($user->principal) : null;","+        return $backendUser !== null ? self::fromBackendUser($backendUser) : new self(0, []);","+    }","+","+    /**","+     * Before the workspace of the user is initialized, the user works in live.","+     */","+    public static function fromBackendUser(BackendUserAuthentication $backendUser): self","+    {","+        return new self(","+            max(0, $backendUser->workspace),","+            array_values(array_map(intval(...), $backendUser->getWebmounts())),","+        );","+    }","+}"],"additions":73,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Security/Authorization/Page/PageAccessContext.php","lines":["@@ -0,0 +1,83 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Security\\Authorization\\Page;","+","+use TYPO3\\CMS\\Core\\Authentication\\BackendUserAuthentication;","+use TYPO3\\CMS\\Core\\Authentication\\Principal;","+use TYPO3\\CMS\\Core\\Security\\Authorization\\BackendMountContext;","+use TYPO3\\CMS\\Core\\Security\\Authorization\\PrincipalUser;","+use TYPO3\\CMS\\Core\\Security\\Authorization\\SecurityRole;","+","+/**","+ * Everything page permissions are decided on: the user and its groups, whether","+ * the user is an admin, and the mounts of the request.","+ *","+ * @internal not part of TYPO3 Core API yet, still experimental as part of the","+ *           authentication modernization groundwork","+ */","+final readonly class PageAccessContext","+{","+    /**","+     * @param list<int> $groupIds","+     * @param BackendUserAuthentication|null $legacyBackendUser the user object the deprecated hooks","+     *                                                          getPagePermsClause and calcPerms are","+     *                                                          called with, to be removed in v16","+     */","+    public function __construct(","+        public int $userId,","+        public array $groupIds,","+        public bool $isAdmin,","+        public BackendMountContext $mounts,","+        public ?BackendUserAut