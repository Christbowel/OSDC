 Unicode boundaries\", () => {","+  function check(value) {","+    if (`${-0}${value}` === `é${value}`) require(\"fail\");","+    if (`${value}é` === `${value}${-0}`) require(\"fail\");","+  }","+  check(\"x\");","+","+  // Compatible prefixes alone cannot decide equality.","+  const matches = (a, b) => `é${a}` === `é0${b}` ? true : false;","+  expect(matches(\"0x\", \"x\")).toBe(true);","+  expect(matches(\"x\", \"x\")).toBe(false);","+});","+","+it(\"should use JavaScript number strings in dynamic request suffixes\", () => {","+  const withNumber = name => require(\"./modules/\" + name + -0 + \".js\");","+  const withStringAndNumber = name => require(\"./modules/\" + name + \"m\" + -0 + \".js\");","+  expect(withNumber(\"item\")).toBe(\"item0\");","+  expect(withStringAndNumber(\"ite\")).toBe(\"item0\");","+});"],"additions":48,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/parsing/number-to-string/modules/item0.js","lines":["@@ -0,0 +1 @@","+module.exports = \"item0\";"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/parsing/number-to-string/rspack.config.ts","lines":["@@ -0,0 +1,5 @@","+import { defineConfig } from '@rspack/cli';","+","+export default defineConfig({","+  optimization: { inlineExports: true },","+});"],"additions":5,"deletions":0,"truncated":false},{"path":"tests/rspack-test/watchCases/cache/inline-exports-signed-zero/0/index.js","lines":["@@ -0,0 +1,8 @@","+import { zero } from \"./value\";","+","+it(\"should update an inlined zero when only its sign changes\", () => {","+  expect(Object.is(zero, -0)).toBe(WATCH_STEP === \"1\");","+  const source = require(\"fs\").readFileSync(__filename, \"utf-8\");","+  const literal = WATCH_STEP === \"1\" ? \"-0\" : \"0\";","+  expect(source).toContain(`(/* inlined export .zero */${literal})`);","+});"],"additions":8,"deletions":0,"truncated":false},{"path":"tests/rspack-test/watchCases/cache/inline-exports-signed-zero/0/value.js","lines":["@@ -0