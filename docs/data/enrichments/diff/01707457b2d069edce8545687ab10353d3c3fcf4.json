ace of its token. The command line","+// namespace only applies to an explicit --serviceaccount, and must not replace it.","+func TestAuthCompleteKeepsKubeConfigServiceAccountNamespace(t *testing.T) {","+\tkubeconfig := writeServiceAccountKubeConfig(t)","+","+\tt.Run(\"grant-privileges\", func(t *testing.T) {","+\t\topt := &GrantPrivilegesOptions{KubeConfig: kubeconfig}","+\t\topt.Complete(nil, nil)","+\t\trequire.Equal(t, \"builder\", opt.Identity.ServiceAccount)","+\t\trequire.Equal(t, \"prod\", opt.Identity.ServiceAccountNamespace)","+\t})","+","+\tt.Run(\"list-privileges\", func(t *testing.T) {","+\t\t// list-privileges also reads the clusters from the command's flags.","+\t\tcmd := &cobra.Command{}","+\t\tcmd.Flags().StringSlice(\"cluster\", nil, \"\")","+\t\topt := &ListPrivilegesOptions{KubeConfig: kubeconfig}","+\t\topt.Complete(nil, cmd)","+\t\trequire.Equal(t, \"builder\", opt.Identity.ServiceAccount)","+\t\trequire.Equal(t, \"prod\", opt.Identity.ServiceAccountNamespace)","+\t})","+}",""],"additions":70,"deletions":0,"truncated":false}],"additions":141,"deletions":3,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-09T15:14:59.390520+00:00"}