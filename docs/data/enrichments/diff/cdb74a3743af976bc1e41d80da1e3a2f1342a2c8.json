{"id":"cdb74a3743af976bc1e41d80da1e3a2f1342a2c8","axis":"silent","repo":"pnpm/pnpm","sha":"cdb74a3743af976bc1e41d80da1e3a2f1342a2c8","parsed":{"files":[{"path":".changeset/accept-tls-settings-cli-flags.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm-workspace.yaml` parse errors now report `ERR_PNPM_INVALID_SETTING`. `pnpm` accepts `--strict-ssl` and `--local-address <ip>` on the command line."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests/tls_settings.rs","lines":["@@ -63,3 +63,28 @@ fn dotted_tls_settings_override_the_workspace_yaml() {","     assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","     assert_eq!(config.package_manager_bootstrap.tls.local_address, Some([127, 0, 0, 2].into()));"," }","+","+#[test]","+fn bare_tls_flags_override_the_workspace_yaml() {","+    let project = tempfile::tempdir().expect(\"project tempdir\");","+    std::fs::write(","+        project.path().join(\"pnpm-workspace.yaml\"),","+        \"strictSsl: false\\nlocalAddress: 127.0.0.3\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    let (overrides, remaining) = ConfigOverrides::extract(argv([","+        \"pacquet\",","+        \"--strict-ssl\",","+        \"--local-address\",","+        \"127.0.0.2\",","+        \"install\",","+    ]));","+    assert_eq!(remaining, argv([\"pacquet\", \"install\"]));","+","+    let config = Config { cli: overrides.cli_layer(None), ..Config::default() }","+        .current::<NoEnv>(project.path())","+        .expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(true));","+    assert_eq!(config.tls.local_address, Some([127, 0, 0, 2].into()));","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tokens.rs","lines":["@@ -154,7 +154,7 @@ pub(super) enum SettingArity {"," /// setting the invoked command declares as its own option is left for"," /// clap; a setting