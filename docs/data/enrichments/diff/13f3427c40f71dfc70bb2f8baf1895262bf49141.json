of exactly","+         * max_size bytes from larger input. */","+        uint64_t remaining = max_size == UINT64_MAX ? UINT64_MAX : max_size + 1;","+","         /* If we have reason to believe the data is bounded in size, then let's use memfds as backing","          * fd. Note that we use the reported regular file size only as a hint, given that there are plenty","          * special files in /proc/ and /sys/ which report a zero file size but can be read from. */","@@ -50,9 +58,14 @@ int copy_data_fd(int fd) {","                 if (copy_fd < 0)","                         return copy_fd;"," ","-                r = copy_bytes(fd, copy_fd, DATA_FD_MEMORY_LIMIT, /* copy_flags= */ 0);","+                n = MIN(DATA_FD_MEMORY_LIMIT, remaining);","+                r = copy_bytes(fd, copy_fd, n, /* copy_flags= */ 0);","                 if (r < 0)","                         return r;","+                if (r > 0 && n == remaining)","+                        return -EFBIG;","+                if (remaining != UINT64_MAX)","+                        remaining -= n;"," ","                 off_t f = lseek(copy_fd, 0, SEEK_SET);","                 if (f < 0)","@@ -87,11 +100,16 @@ int copy_data_fd(int fd) {","                         assert(r == 0);","                 }"," ","-                r = copy_bytes(fd, tmp_fd, DATA_FD_TMP_LIMIT - DATA_FD_MEMORY_LIMIT, /* copy_flags= */ 0);","+                n = MIN(DATA_FD_TMP_LIMIT - DATA_FD_MEMORY_LIMIT, remaining);","+                r = copy_bytes(fd, tmp_fd, n, /* copy_flags= */ 0);","                 if (r < 0)","                         return r;","                 if (r == 0)","                         goto finish;  /* Yay, it fit in */","+                if (n == remaining)","+                        return -EFBIG;","+                if (remaining != UINT64_MAX)","+                        remaining -= n;"," ","                 /* It didn't fit in. Let's not forget to use what we already used */","                 off_t f = lseek(tmp_fd, 0, SEEK_SET);","@@ -123,11 +141,11 @@ int copy_data_fd(int fd) {","         }"," ","         /* Copy in the rest */","-        r = copy_bytes(fd, tmp_fd, UINT64_MAX, /* copy_flags= */ 0);","+        r = copy_bytes(fd, tmp_fd, remaining, /* copy_flags= */ 0);","         if (r < 0)","                 return r;","-","-        assert(r == 0);","+        if (r > 0)","+                return -EFBIG;"," "," finish:","         /* Now convert the O_RDWR file descriptor into an O_RDONLY one (and as side effect seek to the beginning of the","@@ -136,6 +154,44 @@ int copy_data_fd(int fd) {","         return fd_reopen(tmp_fd, O_RDONLY|O_CLOEXEC);"," }"," ","+int seekable_data_fd(int fd, uint64_t max_size) {","+        struct stat st;","+","+        assert(fd >= 0);","+","+        if (fstat(fd, &st) < 0)","+                return -errno;","+","+        if (S_ISDIR(st.st_mode))","+                return -EISDIR;","+","+        /* Files in /proc/ and /sys/ report a size of zero even though they contain data. Callers use the","+         * size from fstat() to know how much to read. So we copy regular files with a size of zero. */","+        if (S_ISREG(st.st_mode) && st.st_size > 0) {","+                if ((uint64_t) st.st_size > max_size)","+                        return -EFBIG;","+","+                return RET_NERRNO(fcntl(fd, F_DUPFD_CLOEXEC, 3));","+        }","+","+        /* pread() fails on pipes and sockets, so we copy their contents. We refuse devices. Reading","+         * /dev/zero or /dev/full never reaches EOF, so we would copy max_size bytes before we fail. */","+        if (!S_ISREG(st.st_mode) && !S_ISFIFO(st.st_mode) && !S_ISSOCK(st.st_mode))","+                return -EBADFD;","+","+        return copy_data_fd_full(fd, max_size);","+}","+","+int open_seekable_data_fd(int dir_fd, const char *path, uint64_t max_size) {","+        _cleanup_close_ int fd = -EBADF;","+","+        fd = xopenat(dir_fd, path, O_RDONLY|O_CLOEXEC|O_NOCTTY);","+        if (fd < 0)","+                return fd;","+","+        return seekable_data_fd(fd, max_size);","+}","+"," int memfd_clone_fd(int fd, const char *name, int mode) {","         _cleanup_close_ int mfd = -EBADF;","         struct stat st;"],"additions":63,"deletions":7,"truncated":false},{"path":"src/shared/data-fd-util.h","lines":["@@ -3,5 +3,10 @@"," "," #include \"forward.h\""," ","-int copy_data_fd(int fd);","+int copy_data_fd_full(int fd, uint64_t max_size);","+static inline int copy_data_fd(int fd) {","+        return copy_data_fd_full(fd, UINT64_MAX);","+}","+int seekable_data_fd(int fd, uint64_t max_size);","+int open_seekable_data_fd(int dir_fd, const char *path, uint64_t max_size);"," int memfd_clone_fd(int fd, const char *name, int mode);"],"additions":6,"deletions":1,"truncated":false},{"path":"src/shared/pe-binary.h","lines":["@@ -133,6 +133,10 @@ typedef struct _packed_ _IMAGE_SECTION_HEADER {"," #define IMAGE_SCN_CNT_INITIALIZED_DATA     UINT32_C(0x00000040)"," #define IMAGE_SCN_MEM_READ                 UINT32_C(0x40000000)"," ","+/* SizeOfImage in the optional header is a 32-bit field, so a PE image and each of its sections are at most","+ * 4 GiB in size. */","+#define PE_IMAGE_SIZE_MAX UINT32_MAX","+"," bool pe_header_is_64bit(const PeHeader *h);"," "," #define PE_HEADER_OPTIONAL_FIELD(h, field)                           \\"],"additions":4,"deletions":0,"truncated":false},{"path":"src/test/test-data-fd-util.c","lines":["@@ -2,14 +2,21 @@"," "," #include <fcntl.h>"," #include <sys/socket.h>","+#include <sys/stat.h>"," #include <unistd.h>"," ","+#include \"alloc-util.h\""," #include \"data-fd-util.h\""," #include \"fd-util.h\"","+#include \"fileio.h\"","+#include \"io-util.h\""," #include \"memfd-util.h\""," #include \"pidref.h\""," #include \"process-util.h\"","+#include \"rm-rf.h\"","+#include \"stat-util.h\""," #include \"tests.h\"","+#include \"tmpfile-util.h\""," "," static void assert_equal_fd(int fd1, int fd2) {","         for (;;) {","@@ -97,4 +104,122 @@ TEST(copy_data_fd) {","         assert_se(read(fd2, &j, sizeof(j)) == 0);"," }"," ","+static int pipe_with_data(const uint8_t *data, size_t size, PidRef *ret_pidref) {","+        _cleanup_close_pair_ int pfd[2] = EBADF_PAIR;","+        int r;","+","+        assert(data);","+        assert(ret_pidref);","+","+        ASSERT_OK_ERRNO(pipe2(pfd, O_CLOEXEC));","+","+        r = ASSERT_OK(pidref_safe_fork(\"(sd-pipe)\", FORK_RESET_SIGNALS|FORK_DEATHSIG_SIGTERM|FORK_LOG, ret_pidref));","+        if (r == 0) {","+                pfd[0] = safe_close(pfd[0]);","+","+                /* The parent closes the read end when the data exceeds max_size. The kernel then kills","+                 * the child with SIGPIPE on its next write(). */","+                if (loop_write(pfd[1], data, size) < 0)","+                        _exit(EXIT_FAILURE);","+","+                _exit(EXIT_SUCCESS);","+        }","+","+        return TAKE_FD(pfd[0]);","+}","+","+static void test_copy_data_fd_full_one(size_t size) {","+        _cleanup_free_ uint8_t *data = NULL, *buf = NULL;","+","+        log_debug(\"/* %s(%zu) */\", __func__, size);","+","+        data = ASSERT_NOT_NULL(new(uint8_t, size));","+        for (size_t i = 0; i < size; i++)","+                data[i] = i % 251;","+","+        /* We read one byte more than we expect, so that we notice a copy that is too long. */","+        buf = ASSERT_NOT_NULL(new(uint8_t, size + 1));","+","+        FOREACH_ELEMENT(max_size, ((const uint64_t[]) { size, size - 1, UINT64_MAX })) {","+                _cleanup_(pidref_done_sigkill_wait) PidRef pidref = PIDREF_NULL;","+                _cleanup_close_ int fd = -EBADF, copy_fd = -EBADF;","+","+                fd = pipe_with_data(data, size, &pidref);","+","+                if (*max_size < size) {","+                        ASSERT_ERROR(copy_data_fd_full(fd, *max_size), EFBIG);","+                        continue;","+                }","+","+                copy_fd = ASSERT_OK(copy_data_fd_full(fd, *max_size));","+","+                ASSERT_EQ(loop_read(copy_fd, buf, size + 1, /* do_poll= */ false), (ssize_t) size);","+                ASSERT_EQ(memcmp(buf, data, size), 0);","+        }","+}","+","+TEST(copy_data_fd_full) {","+        /* copy_data_fd_full() copies 5 bytes into a memfd, 100 KiB into a file in /tmp/, and 1.5 MiB into","+         * a file in /var/tmp/. */","+        test_copy_data_fd_full_one(5);","+        test_copy_data_fd_full_one(100 * 1024);","+        test_copy_data_fd_full_one(1536 * 1024);","+}","+","+static void assert_fd_contents(int fd, const char *contents) {","+        struct stat st;","+        char buf[64];","+","+        ASSERT_OK_ERRNO(fstat(fd, &st));","+        ASSERT_TRUE(S_ISREG(st.st_mode));","+        ASSERT_EQ((size_t) st.st_size, strlen(contents));","+        ASSERT_EQ(pread(fd, buf, sizeof(buf), 0), (ssize_t) strlen(contents));","+        ASSERT_EQ(memcmp(buf, contents, strlen(contents)), 0);","+}","+","+TEST(open_seekable_data_fd) {","+        _cleanup_(rm_rf_physical_and_freep) char *t = NULL;","+        _cleanup_close_ int dir_fd = -EBADF, fd = -EBADF;","+        struct stat st1, st2;","+","+        dir_fd = ASSERT_OK(mkdtemp_open(NULL, O_PATH, &t));","+        ASSERT_OK(write_string_file_at(dir_fd, \"file\", \"hallo\", WRITE_STRING_FILE_CREATE|WRITE_STRING_FILE_AVOID_NEWLINE));","+","+        fd = ASSERT_OK(open_seekable_data_fd(dir_fd, \"file\", /* max_size= */ 5));","+        ASSERT_OK_ERRNO(fstatat(dir_fd, \"file\", &st1, 0));","+        ASSERT_OK_ERRNO(fstat(fd, &st2));","+        ASSERT_TRUE(stat_inode_same(&st1, &st2));","+        fd = safe_close(fd);","+","+        ASSERT_ERROR(open_seekable_data_fd(dir_fd, \"file\", /* max_size= */ 4), EFBIG);","+","+        /* Files in /proc/ report a size of zero, so open_seekable_data_fd() copies their contents. */","+        fd = ASSERT_OK(open_seekable_data_fd(AT_FDCWD, \"/proc/self/comm\", UINT64_MAX));","+        ASSERT_OK_ERRNO(fstat(fd, &st2));","+        ASSERT_GT(st2.st_size, 0);","+        fd = safe_close(fd);","+","+        /* The shell passes <(...) as a /proc/self/fd/ path to a pipe. */","+        FOREACH_ELEMENT(max_size, ((const uint64_t[]) { 5, 4 })) {","+                _cleanup_close_pair_ int pfd[2] = EBADF_PAIR;","+","+                ASSERT_OK_ERRNO(pipe2(pfd, O_CLOEXEC));","+                ASSERT_EQ(write(pfd[1], \"hallo\", 5), 5);","+                pfd[1] = safe_close(pfd[1]);","+","+                if (*max_size < 5) {","+                        ASSERT_ERROR(open_seekable_data_fd(AT_FDCWD, FORMAT_PROC_FD_PATH(pfd[0]), *max_size), EFBIG);","+                        continue;","+                }","+","+                fd = ASSERT_OK(open_seekable_data_fd(AT_FDCWD, FORMAT_PROC_FD_PATH(pfd[0]), *max_size));","+                assert_fd_contents(fd, \"hallo\");","+                fd = safe_close(fd);","+        }","+","+        ASSERT_ERROR(open_seekable_data_fd(AT_FDCWD, t, UINT64_MAX), EISDIR);","+        ASSERT_ERROR(open_seekable_data_fd(AT_FDCWD, \"/dev/null\", UINT64_MAX), EBADFD);","+        ASSERT_ERROR(open_seekable_data_fd(dir_fd, \"missing\", UINT64_MAX), ENOENT);","+}","+"," DEFINE_TEST_MAIN(LOG_DEBUG);",""],"additions":125,"deletions":0,"truncated":false}],"additions":198,"deletions":8,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-21T13:29:44.970038+00:00"}