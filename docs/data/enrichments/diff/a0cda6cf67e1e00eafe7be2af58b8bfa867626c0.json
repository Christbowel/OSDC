d the source check. Resolving a","+\t// different ancestor must not bypass access to the existing resource.","+\tif parsed.Existing != nil && sourceFolder == destinationFolder {","+\t\tif sourceFolder != ancestor {","+\t\t\tif err := a.access.Check(ctx, req, sourceFolder); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t}","+\treturn a.access.Check(ctx, req, ancestor)","+}","+"," // getFolderID resolves the folder ID for the given path, always reading"," // from the configured branch (ref=\"\"). See the Authorizer doc comment"],"additions":82,"deletions":2,"truncated":false}],"additions":269,"deletions":33,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-08T16:19:34.356395+00:00"}