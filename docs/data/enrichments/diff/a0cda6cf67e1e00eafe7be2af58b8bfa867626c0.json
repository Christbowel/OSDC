l, err error)","+}","+"," // ProvisioningAuthorizer implements Authorizer for provisioning operations."," type ProvisioningAuthorizer struct {"," \trepo                  *provisioning.Repository"," \treader                repository.Reader"," \taccess                auth.AccessChecker"," \tclients               ResourceClients","+\tfolders               FolderAncestorFinder"," \tfolderMetadataEnabled bool"," }"," "," // NewAuthorizer creates a new ProvisioningAuthorizer. The clients provide the set of","-// supported resources to authorize against.","-func NewAuthorizer(repo *provisioning.Repository, reader repository.Reader, access auth.AccessChecker, clients ResourceClients, folderMetadataEnabled bool) Authorizer {","+// supported resources to authorize against. The ancestor finder is required for","+// previews that resolve configured folders.","+func NewAuthorizer(repo *provisioning.Repository, reader repository.Reader, access auth.AccessChecker, clients ResourceClients, folders FolderAncestorFinder, folderMetadataEnabled bool) Authorizer {"," \treturn &ProvisioningAuthorizer{"," \t\trepo:                  repo,"," \t\treader:                reader,"," \t\taccess:                access,"," \t\tclients:               clients,","+\t\tfolders:               folders,"," \t\tfolderMetadataEnabled: folderMetadataEnabled,"," \t}"," }","@@ -223,6 +242,67 @@ func (a *ProvisioningAuthorizer) AuthorizeResource(ctx context.Context, parsed *"," \t}, metaFolder)"," }"," ","+// requiresAncestorAuthorization limits ancestor lookup to preview reads of","+// folder-scoped resources with a folder annotation and a supported source file.","+// A file at the repository root is eligible when it belongs to the wrapper folder.","+func (a *ProvisioningAuthorizer) requiresAncestorAuthorization(parsed *ParsedResource) bool {","+\tif !parsed.IsPreviewRead(a.repo.Branch()) || !parsed.FolderScoped || parsed.Info.Path == \"\" || parsed.Meta.GetFolder() == \"\" {","+\t\treturn false","+\t}","+\