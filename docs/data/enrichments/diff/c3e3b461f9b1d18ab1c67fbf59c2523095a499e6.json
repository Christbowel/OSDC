er/ast-buffer.js","lines":["@@ -0,0 +1,61 @@","+const assert = require('node:assert');","+const { readFile } = require('node:fs/promises');","+const path = require('node:path');","+","+describe('ast buffer', () => {","+\tit('keeps strings and number values while swapping all other fields when byte order swapping is requested', async () => {","+\t\tconst { default: initWasm, parse } = await import('../../wasm/bindings_wasm.js');","+\t\tawait initWasm({","+\t\t\tmodule_or_path: await readFile(path.join(__dirname, '../../wasm/bindings_wasm_bg.wasm'))","+\t\t});","+\t\tconst code = [","+\t\t\t'const number = -1.5, big = 2 ** 53, small = 1e-310, bigint = 123n;',","+\t\t\t'const string = \"héllo, wörld\", template = `${string} ✓`;',","+\t\t\t'const regexp = /[a-z]+/giu;',","+\t\t\t'export default /* @__PURE__ */ Object.freeze({ number, string, regexp });'","+\t\t].join('\\n');","+\t\tconst nativeBuffer = Buffer.from(parse(code, false, false, false));","+\t\tconst swappedBuffer = Buffer.from(parse(code, false, false, true));","+","+\t\tassert.strictEqual(swappedBuffer.length, nativeBuffer.length);","+\t\tfor (let position = 0; position < nativeBuffer.length; position += 4) {","+\t\t\tconst nativeWord = nativeBuffer.subarray(position, position + 4);","+\t\t\tconst swappedWord = swappedBuffer.subarray(position, position + 4);","+\t\t\tconst isSwapped = swappedWord.every((byte, index) => byte === nativeWord[3 - index]);","+\t\t\tconst isKept = swappedWord.every((byte, index) => byte === nativeWord[index]);","+\t\t\tassert(isSwapped || isKept, `the word at position ${position} is neither swapped nor kept`);","+\t\t}","+\t\t// the type of the root node is the first 32-bit field","+\t\tassertIsSwappedWord(swappedBuffer, nativeBuffer, 0);","+\t\tfor (const string of ['héllo, wörld', ' ✓', '[a-z]+']) {","+\t\t\tconst stringBytes = Buffer.from(string, 'utf8');","+\t\t\tconst position = nativeBuffer.indexOf(stringBytes);","+\t\t\tassert.notStrictEqual(position, -1, `\"${string}\" no