*testing.T) {"],"additions":64,"deletions":0,"truncated":false},{"path":"go/examples/custom-client/main.go","lines":["@@ -21,13 +21,15 @@ func main() {"," \t\t\tlog.Fatal(\"CUSTOM_MODAL_OAUTH_CLIENT_ID environment variable not set\")"," \t\t}"," \t\tclientSecret := os.Getenv(\"CUSTOM_MODAL_OAUTH_CLIENT_SECRET\")","-\t\tif clientSecret == \"\" {","-\t\t\tlog.Fatal(\"CUSTOM_MODAL_OAUTH_CLIENT_SECRET environment variable not set\")","+\t\tjwtKey := os.Getenv(\"CUSTOM_MODAL_OAUTH_JWT_KEY\")","+\t\tif clientSecret == \"\" && jwtKey == \"\" {","+\t\t\tlog.Fatal(\"set CUSTOM_MODAL_OAUTH_CLIENT_SECRET or CUSTOM_MODAL_OAUTH_JWT_KEY\")"," \t\t}"," \t\tparams.OAuthCredentials = &modal.OAuthCredentialsParams{"," \t\t\tRefreshToken: refreshToken,"," \t\t\tClientID:     clientID,"," \t\t\tClientSecret: clientSecret,","+\t\t\tJWTKey:       jwtKey,"," \t\t}"," \t} else {"," \t\tparams.TokenID = os.Getenv(\"CUSTOM_MODAL_ID\")"],"additions":4,"deletions":2,"truncated":false},{"path":"go/oauth.go","lines":["@@ -0,0 +1,58 @@","+package modal","+","+// Private-key JWT (RFC 7523) assertions for OAuth client authentication.","+","+import (","+\t\"crypto/rsa\"","+\t\"crypto/sha256\"","+\t\"encoding/base64\"","+\t\"fmt\"","+\t\"math/big\"","+\t\"strings\"","+\t\"time\"","+","+\t\"github.com/golang-jwt/jwt/v5\"","+\t\"github.com/google/uuid\"","+)","+","+const (","+\toauthClientAssertionAudience        = \"modal-server\"","+\toauthClientAssertionLifetimeSeconds = 5 * 60","+\tminRSAKeySize                       = 2048","+)","+","+func parseOAuthJWTKey(privateKeyPEM string) (*rsa.PrivateKey, error) {","+\tprivateKey, err := jwt.ParseRSAPrivateKeyFromPEM([]byte(strings.ReplaceAll(privateKeyPEM, \"\\\\n\", \"\\n\")))","+\tif err != nil {","+\t\treturn nil, InvalidError{Exception: \"oauth_jwt_key must be an unencrypted RSA private key encoded as PEM.\"}","+\t}","+\tif privateKey.N.BitLen() < minRSAKeySize {","+\t\treturn nil, InvalidError{Exception: \"oauth_jwt_key must be at least 2048 bits.\"}","+\t}","+\treturn privateKey, nil","+}","+","+func rsaJWKThumbprint(pub *rsa.PublicKey) string {","+\te := base64.RawURLEncoding.EncodeToString(big.NewInt(int64(pub.E)).Bytes())","+\tn := base64.RawURLEncoding.EncodeToString(pub.N.Bytes())","+\tsum := sha256.Sum256([]byte(fmt.Sprintf(`{\"e\":%q,\"kty\":\"RSA\",\"n\":%q}`, e, n)))","+\treturn base64.RawURLEncoding.EncodeToString(sum[:])","+}","+","+func mintOAuthClientAssertion(clientID string, key *rsa.PrivateKey) (string, error) {","+\tnow := time.Now()","+\ttoken := jwt.NewWithClaims(jwt.SigningMethodRS256, jwt.MapClaims{","+\t\t\"iss\": clientID,","+\t\t\"sub\": clientID,","+\t\t\"aud\": oauthClientAssertionAudience,","+\t\t\"iat\": now.Unix(),","+\t\t\"exp\": now.Add(oauthClientAssertionLifetimeSeconds * time.Second).Unix(),","+\t\t\"jti\": uuid.NewString(),","+\t})","+\ttoken.Header[\"kid\"] = rsaJWKThumbprint(&key.PublicKey)","+\tassertion, err := token.SignedString(key)","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"sign OAuth client assertion: %w\", err)","+\t}","+\treturn assertion, nil","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"go/oauth_test.go","lines":["@@ -0,0 +1,160 @@","+package modal","+","+import (","+\t\"context\"","+\t\"crypto/rand\"","+\t\"crypto/rsa\"","+\t\"crypto/x509\"","+\t\"encoding/base64\"","+\t\"encoding/pem\"","+\t\"math/big\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/golang-jwt/jwt/v5\"","+\t\"github.com/onsi/gomega\"","+\t\"google.golang.org/grpc/metadata\"","+)","+","+func rsaPrivateKeyPEM(t *testing.T, bits int) (string, *rsa.PrivateKey) {","+\tt.Helper()","+\tkey, err := rsa.GenerateKey(rand.Reader, bits)","+\tif err != nil {","+\t\tt.Fatalf(\"GenerateKey: %v\", err)","+\t}","+\tder, err := x509.MarshalPKCS8PrivateKey(key)","+\tif err != nil {","+\t\tt.Fatalf(\"MarshalPKCS8PrivateKey: %v\", err)","+\t}","+\treturn string(pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: der})), key","+}","+","+func TestParseOAuthJWTKey(t *testing.T) {","+\tt.Parallel()","+\tg := gomega.NewWithT(t)","+\tpemPKCS8, want := rsaPrivateKeyPEM(t, 2048)","+","+\tgot, err := parseOAuthJWTKey(pemPKCS8)","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\tg.Expect(got.Equal(want)).To(gomega.BeTrue())","+","+\tgot, err = parseOAuthJWTKey(strings.ReplaceAll(pemPKCS8, \"\\n\", \"\\\\n\"))","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\tg.Expect(got.N.Cmp(want.N)).To(gomega.Equal(0))","+}","+","+func TestParseOAuthJWTKeyRejectsInvalid(t *testing.T) {","+\tt.Parallel()","+","+\tshortPEM, _ := rsaPrivateKeyPEM(t, 1024)","+\tpub, err := rsa.GenerateKey(rand.Reader, 2048)","+\tif err != nil {","+\t\tt.Fatalf(\"GenerateKey: %v\", err)","+\t}","+\tpubDER, err := x509.MarshalPKIXPublicKey(&pub.PublicKey)","+\tif err != nil {","+\t\tt.Fatalf(\"MarshalPKIXPublicKey: %v\", err)","+\t}","+\tpublicPEM := string(pem.EncodeToMemory(&pem.Block{Type: \"PUBLIC KEY\", Bytes: pubDER}))","+","+\tcases := []struct {","+\t\tname    string","+\t\tpem     string","+\t\tmessage string","+\t}{","+\t\t{name: \"garbage\", pem: \"not a private key\", message: \"unencrypted RSA private key encoded as PEM\"},","+\t\t{name: \"too small\", pem: shortPEM, message: \"at least 2048 bits\"},","+\t\t{name: \"public key\", pem: publicPEM, message: \"unencrypted RSA private key encoded as PEM\"},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\tg := gomega.NewWithT(t)","+\t\t\t_, err := parseOAuthJWTKey(tc.pem)","+\t\t\tg.Expect(err).Should(gomega.MatchError(gomega.ContainSubstring(tc.message)))","+\t\t})","+\t}","+}","+","+func TestMintOAuthClientAssertion(t *testing.T) {","+\tt.Parallel()","+\tg := gomega.NewWithT(t)","+","+\t_, key := rsaPrivateKeyPEM(t, 2048)","+\tkid := rsaJWKThumbprint(&key.PublicKey)","+","+\tfirst, err := mintOAuthClientAssertion(\"oc-client-id\", key)","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\tsecond, err := mintOAuthClientAssertion(\"oc-client-id\", key)","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\tg.Expect(first).NotTo(gomega.Equal(second))","+","+\ttoken, err := jwt.Parse(first, func(token *jwt.Token) (any, error) {","+\t\treturn &key.PublicKey, nil","+\t}, jwt.WithValidMethods([]string{jwt.SigningMethodRS256.Alg()}), jwt.WithAudience(oauthClientAssertionAudience))","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\tg.Expect(token.Header[\"kid\"]).To(gomega.Equal(kid))","+\tg.Expect(token.Header[\"alg\"]).To(gomega.Equal(\"RS256\"))","+","+\tclaims, ok := token.Claims.(jwt.MapClaims)","+\tg.Expect(ok).To(gomega.BeTrue())","+\tg.Expect(claims[\"iss\"]).To(gomega.Equal(\"oc-client-id\"))","+\tg.Expect(claims[\"sub\"]).To(gomega.Equal(\"oc-client-id\"))","+}","+","+func TestRSAJWKThumbprintMatchesRFC7638(t *testing.T) {","+\tt.Parallel()","+\tg := gomega.NewWithT(t)","+","+\t// RFC 7638 §3.1 example JWK (n/e only; alg and kid are excluded from the thumbprint).","+\tn, err := base64.RawURLEncoding.DecodeString(\"0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw\")","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\te, err := base64.RawURLEncoding.DecodeString(\"AQAB\")","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+","+\tpub := &rsa.PublicKey{","+\t\tN: new(big.Int).SetBytes(n),","+\t\tE: int(new(big.Int).SetBytes(e).Int64()),","+\t}","+\tg.Expect(rsaJWKThumbprint(pub)).To(gomega.Equal(\"NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs\"))","+}","+","+func TestInjectRequiredHeadersWithOAuthJWTKey(t *testing.T) {","+\tt.Parallel()","+\tg := gomega.NewWithT(t)","+","+\tpemBytes, key := rsaPrivateKeyPEM(t, 2048)","+","+\tc := &Client{","+\t\tprofile: Profile{","+\t\t\tOAuthRefreshToken: \"refresh-token\",","+\t\t\tOAuthClientID:     \"oc-client-id\",","+\t\t\tOAuthJWTKey:       pemBytes,","+\t\t},","+\t\tsdkVersion:  \"test-version\",","+\t\toauthJWTKey: key,","+\t}","+\tctx, err := injectRequiredHeaders(context.Background(), c)","+\tg.Expect(err).ShouldNot(gomega.HaveOccurred())","+\tmd, ok := metadata.FromOutgoingContext(ctx)","+\tg.Expect(ok).To(gomega.BeTrue())","+\tg.Expect(md.Get(\"x-modal-refresh-token\")).To(gomega.Equal([]string{\"refresh-token\"}))","+\tg.Expect(md.Get(\"x-modal-oauth-client-id\")).To(gomega.Equal([]string{\"oc-client-id\"}))","+\tg.Expect(md.Get(\"x-modal-oauth-client-assertion\")).NotTo(gomega.BeEmpty())","+\tg.Expect(md.Get(\"x-modal-oauth-client-secret\")).To(gomega.BeEmpty())","+}","+","+func TestNewClientWithOptionsRejectsInvalidOAuthJWTKey(t *testing.T) {","+\tt.Parallel()","+\tg := gomega.NewWithT(t)","+","+\t_, err := NewClientWithOptions(&ClientParams{","+\t\tOAuthCredentials: &OAuthCredentialsParams{","+\t\t\tRefreshToken: \"refresh-token\",","+\t\t\tClientID:     \"oc-client-id\",","+\t\t\tJWTKey:       \"not a private key\",","+\t\t},","+\t})","+\tg.Expect(err).Should(gomega.MatchError(gomega.ContainSubstring(\"unencrypted RSA private key encoded as PEM\")))","+}",""],"additions":160,"deletions":0,"truncated":false}],"additions":383,"deletions":32,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-09-11T13:01:56.410500+00:00"}