{"id":"c84f3c57ff3fae85f2755a31660bba0b07c06bc3","axis":"silent","repo":"opensearch-project/OpenSearch","sha":"c84f3c57ff3fae85f2755a31660bba0b07c06bc3","parsed":{"files":[{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/AbstractRemoteStoreMockRepositoryIntegTestCase.java","lines":["@@ -29,6 +29,7 @@"," "," import static org.opensearch.indices.IndicesService.CLUSTER_REPLICATION_TYPE_SETTING;"," import static org.opensearch.node.remotestore.RemoteStoreNodeAttribute.REMOTE_STORE_CLUSTER_STATE_REPOSITORY_NAME_ATTRIBUTE_KEY;","+import static org.opensearch.node.remotestore.RemoteStoreNodeAttribute.REMOTE_STORE_MODE_KEY;"," import static org.opensearch.node.remotestore.RemoteStoreNodeAttribute.REMOTE_STORE_REPOSITORY_SETTINGS_ATTRIBUTE_KEY_PREFIX;"," import static org.opensearch.node.remotestore.RemoteStoreNodeAttribute.REMOTE_STORE_REPOSITORY_TYPE_ATTRIBUTE_KEY_FORMAT;"," import static org.opensearch.node.remotestore.RemoteStoreNodeAttribute.REMOTE_STORE_SEGMENT_REPOSITORY_NAME_ATTRIBUTE_KEY;","@@ -56,6 +57,12 @@ protected Settings remoteStoreIndexSettings(int numberOfReplicas) {","             .build();","     }"," ","+    /**","+     * Whether the nodes run in {@code segments_only} mode, which configures a segment repository and deliberately no","+     * translog repository. Set before {@link #setup} so that the node attributes are built for it.","+     */","+    protected boolean segmentsOnly = false;","+","     public Settings buildRemoteStoreNodeAttributes(Path repoLocation, double ioFailureRate, String skipExceptionBlobList, long maxFailure) {","         String segmentRepoTypeAttributeKey = String.format(","             Locale.getDefault(),","@@ -88,7 +95,7 @@ public Settings buildRemoteStoreNodeAttributes(Path repoLocation, double ioFailu","             REPOSITORY_NAME","         );"," ","-        return Settings.builder()","+        Settings.Builder attributes = Settings.builder()","             .put(\"node.attr.\" + REMOTE_STORE_SEGMENT_REPOSITORY_NAME_ATTRIBUTE_KEY, REPOSITORY_NAME)","             .put(segmentRepoTypeAttributeKey, \"mock\")","             .put(segmentRepoSettingsAttributeKeyPrefix + \"location\", repoLocation)","@@ -96,8 +103,13 @@ public Settings buildRemoteStoreNodeAttributes(Path repoLocation, double ioFailu","             .put(segmentRepoSettingsAttributeKeyPrefix + \"skip_exception_on_verification_file\", true)","             .put(segmentRepoSettingsAttributeKeyPrefix + \"skip_exception_on_list_blobs\", true)","             .put(segmentRepoSettingsAttributeKeyPrefix + \"skip_exception_on_blobs\", skipExceptionBlobList)","-            .put(segmentRepoSettingsAttributeKeyPrefix + \"max_failure_number\", maxFailure)","-            .put(\"node.attr.\" + REMOTE_STORE_TRANSLOG_REPOSITORY_NAME_ATTRIBUTE_KEY, TRANSLOG_REPOSITORY_NAME)","+            .put(segmentRepoSettingsAttributeKeyPrefix + \"max_failure_number\", maxFailure);","+","+        if (segmentsOnly) {","+            return attributes.put(\"node.attr.\" + REMOTE_STORE_MODE_KEY, \"segments_only\").build();","+        }","+","+        return attributes.put(\"node.attr.\" + REMOTE_STORE_TRANSLOG_REPOSITORY_NAME_ATTRIBUTE_KEY, TRANSLOG_REPOSITORY_NAME)","             .put(translogRepoTypeAttributeKey, \"mock\")","             .put(translogRepoSettingsAttributeKeyPrefix + \"location\", repoLocation)","             .put(\"node.attr.\" + REMOTE_STORE_CLUSTER_STATE_REPOSITORY_NAME_ATTRIBUTE_KEY, REPOSITORY_NAME)","@@ -109,6 +121,9 @@ public Settings buildRemoteStoreNodeAttributes(Path repoLocation, double ioFailu","     protected void cleanupRepo() {","         logger.info(\"--> Cleanup the repository={}\", REPOSITORY_NAME);","         clusterAdmin().prepareCleanupRepository(REPOSITORY_NAME).execute().actionGet();","+        if (segmentsOnly) {","+            return;","+        }","         logger.info(\"--> Cleanup the repository={}\", TRANSLOG_REPOSITORY_NAME);","         clusterAdmin().prepareCleanupRepository(TRANSLOG_REPOSITORY_NAME).execute().actionGet();","     }"],"additions":18,"deletions":3,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/RemoteStoreBackpressureAndResiliencyIT.java","lines":["@@ -54,6 +54,17 @@ public void testWritesRejectedDueToBytesLagBreach() throws Exception {","         validateBackpressure(ByteSizeUnit.BYTES.toIntBytes(2), 30, ByteSizeUnit.KB.toIntBytes(1), \"bytes_lag\");","     }"," ","+    /**","+     * Segment upload backpressure measures the lag between a local refresh and the remote one, so it depends on the","+     * segments being remote backed and never on the translog. A {@code segments_only} node uploads segments like any","+     * other remote node, so the same breach has to reject writes there too, and the stats behind it have to be","+     * tracked for a shard whose translog stays local.","+     */","+    public void testWritesRejectedDueToConsecutiveFailureBreachInSegmentsOnlyMode() throws Exception {","+        segmentsOnly = true;","+        validateBackpressure(ByteSizeUnit.KB.toIntBytes(1), 10, ByteSizeUnit.KB.toIntBytes(1), \"failure_streak_count\");","+    }","+","     public void testWritesRejectedDueToTimeLagBreach() throws Exception {","         // Initially indexing happens with doc size of 1KB, then all remote store interactions start failing. Now, the","         // indexing happens with doc size of 1 byte leading to time lag limit getting exceeded and leading to rejections."],"additions":11,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/RemoteStoreRefreshListenerIT.java","lines":["@@ -32,6 +32,19 @@"," public class RemoteStoreRefreshListenerIT extends AbstractRemoteStoreMockRepositoryIntegTestCase {"," ","     public void testRemoteRefreshRetryOnFailure() throws Exception {","+        verifyRefreshRetriesUntilTheRepositoryCatchesUp();","+    }","+","+    /**","+     * Uploading segments is the only thing a {@code segments_only} node does remotely, so a failing upload has to be","+     * retried there as it is anywhere else, with no remote translog holding the operations in the meantime.","+     */","+    public void testRemoteRefreshRetryOnFailureInSegmentsOnlyMode() throws Exception {","+        segmentsOnly = true;","+        verifyRefreshRetriesUntilTheRepositoryCatchesUp();","+    }","+","+    private void verifyRefreshRetriesUntilTheRepositoryCatchesUp() throws Exception {","         Path location = randomRepoPath().toAbsolutePath();","         setup(location, randomDoubleBetween(0.1, 0.15, true), \"metadata\", 10L);","         client().admin()"],"additions":13,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/SegmentsOnlyBaseIntegTestCase.java","lines":["@@ -0,0 +1,120 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.remotestore;","+","+import org.opensearch.cluster.metadata.IndexMetadata;","+import org.opensearch.common.settings.Settings;","+import org.opensearch.index.shard.IndexShard;","+import org.opensearch.indices.IndicesService;","+import org.opensearch.indices.replication.common.ReplicationType;","+import org.opensearch.plugins.Plugin;","+import org.opensearch.test.InternalSettingsPlugin;","+import org.opensearch.test.OpenSearchIntegTestCase;","+import org.opensearch.test.transport.MockTransportService;","+","+import java.nio.file.Path;","+import java.util.Collection;","+import java.util.List;","+import java.util.stream.Collectors;","+import java.util.stream.Stream;","+","+import static org.opensearch.remotestore.RemoteStoreBaseIntegTestCase.segmentsOnlyNodeAttributes;","+import static org.opensearch.test.hamcrest.OpenSearchAssertions.assertAcked;","+","+/**","+ * Base class for tests of a cluster running with {@code node.attr.remote_store.mode: segments_only}, where segments","+ * are uploaded to a remote store but the translog stays on local disk and is replicated node-to-node.","+ */","+@OpenSearchIntegTestCase.ClusterScope(scope = OpenSearchIntegTestCase.Scope.TEST, numDataNodes = 0)","+public abstract class SegmentsOnlyBaseIntegTestCase extends OpenSearchIntegTestCase {","+","+    protected static final String SEGMENT_REPOSITORY_NAME = \"test-segment-repo\";","+","+    protected Path segmentRepoPath;","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins() {","+        return Stream.concat(super.nodePlugins().stream(), Stream.of(MockTransportService.TestPlugin.class, InternalSettingsPlugin.class))","+            .collect(Collectors.toList());","+    }","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal) {","+        Settings.Builder settings = Settings.builder().put(super.nodeSettings(nodeOrdinal));","+        if (startInSegmentsOnlyMode()) {","+            settings.put(segmentsOnlyAttributes());","+        }","+        return settings.build();","+    }","+","+    /**","+     * Whether nodes start carrying the segments_only attributes. Override to start the cluster in another mode and","+     * move it into segments_only partway through, which is what a migration looks like.","+     */","+    protected boolean startInSegmentsOnlyMode() {","+        return true;","+    }","+","+    /** A segment repository and deliberately no translog repository, which is what puts a node in segments_only mode. */","+    protected Settings segmentsOnlyAttributes() {","+        if (segmentRepoPath == null) {","+            segmentRepoPath = randomRepoPath().toAbsolutePath();","+        }","+        return segmentsOnlyNodeAttributes(SEGMENT_REPOSITORY_NAME, segmentRepoPath);","+    }","+","+    protected void createSegmentsOnlyIndex(String index, int numReplicas) {","+        createSegmentsOnlyIndex(index, numReplicas, 0, Settings.EMPTY);","+    }","+","+    protected void createSegmentsOnlyIndex(String index, int numReplicas, Settings extra) {","+        createSegmentsOnlyIndex(index, numReplicas, 0, extra);","+    }","+","+    protected void createSegmentsOnlyIndex(String index, int numReplicas, int numSearchReplicas, Settings extra) {","+        assertAcked(","+            prepareCreate(index).setSettings(","+                Settings.builder()","+                    .put(IndexMetadata.SETTING_NUMBER_OF_SHARDS, 1)","+                    .put(IndexMetadata.SETTING_NUMBER_OF_REPLICAS, numReplicas)","+                    .put(IndexMetadata.SETTING_NUMBER_OF_SEARCH_REPLICAS, numSearchReplicas)","+                    .put(IndexMetadata.SETTING_REPLICATION_TYPE, ReplicationType.SEGMENT)","+                    .put(extra)","+            )","+        );","+        ensureGreen(index);","+    }","+","+    /** Starts a cluster manager and {@code dataNodes} data nodes, and returns the data node names. */","+    protected List<String> startCluster(int dataNodes) {","+        internalCluster().startClusterManagerOnlyNode();","+        List<String> nodes = internalCluster().startDataOnlyNodes(dataNodes);","+        ensureStableCluster(dataNodes + 1);","+        return nodes;","+    }","+","+    /** The shard 0 copy of {@code index} held by {@code node}. */","+    protected IndexShard shardOn(String node, String index) {","+        return internalCluster().getInstance(IndicesService.class, node).indexService(resolveIndex(index)).getShard(0);","+    }","+","+    /** Asserts the premise every test in this package depends on: remote segments, local translog. */","+    protected static void assertSegmentsOnly(IndexShard shard) {","+        assertTrue(\"segments must be remote backed\", shard.indexSettings().isRemoteStoreEnabled());","+        assertFalse(\"the translog must stay local\", shard.indexSettings().isTranslogDurableInRemoteStore());","+    }","+","+    /** Indexes {@code count} documents with ids {@code from} onwards, and returns the next free id. */","+    protected int indexDocs(String index, int from, int count) {","+        for (int i = from; i < from + count; i++) {","+            client().prepareIndex(index).setId(Integer.toString(i)).setSource(\"field\", \"value\" + i).get();","+        }","+        return from + count;","+    }","+}"],"additions":120,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/SegmentsOnlyGarbageCollectionIT.java","lines":["@@ -0,0 +1,88 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.remotestore;","+","+import org.opensearch.common.blobstore.BlobPath;","+import org.opensearch.common.settings.Settings;","+import org.opensearch.indices.RemoteStoreSettings;","+","+import java.io.IOException;","+import java.nio.file.Files;","+import java.nio.file.Path;","+import java.util.List;","+import java.util.stream.Collectors;","+import java.util.stream.Stream;","+","+import static org.opensearch.index.remote.RemoteStoreEnums.DataCategory.SEGMENTS;","+import static org.opensearch.index.remote.RemoteStoreEnums.DataType.METADATA;","+import static org.hamcrest.Matchers.greaterThan;","+import static org.hamcrest.Matchers.lessThanOrEqualTo;","+","+/**","+ * Collecting stale segment metadata is the one half of remote store garbage collection a {@code segments_only} shard","+ * still does, since its segments are remote and only its translog is not. The collector hangs off the refresh","+ * listener, which is created from {@code isRemoteSegmentStoreNode()}; had it been gated on one of the predicates","+ * this mode fails, the metadata would accumulate for the life of the index with nothing to bound it.","+ */","+public class SegmentsOnlyGarbageCollectionIT extends SegmentsOnlyBaseIntegTestCase {","+","+    private static final String INDEX_NAME = \"segments-only-gc-idx\";","+    private static final int METADATA_FILES_TO_KEEP = 1;","+    private static final int INITIAL_COMMITS = 5;","+","+    private int nextDocId = 0;","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal) {","+        return Settings.builder()","+            .put(super.nodeSettings(nodeOrdinal))","+            .put(RemoteStoreSettings.CLUSTER_REMOTE_INDEX_SEGMENT_METADATA_RETENTION_MAX_COUNT_SETTING.getKey(), METADATA_FILES_TO_KEEP)","+            .build();","+    }","+","+    public void testStaleSegmentMetadataIsCollected() throws Exception {","+        startCluster(1);","+        createSegmentsOnlyIndex(INDEX_NAME, 0);","+        indexAndCommit(INITIAL_COMMITS);","+","+        Path metadataPath = segmentMetadataPath();","+        assertThat(","+            \"the commits must have produced metadata to collect\",","+            listMetadataFiles(metadataPath).size(),","+            greaterThan(METADATA_FILES_TO_KEEP)","+        );","+","+        // Collection runs after a commit, so the count is driven back down by committing rather than by waiting.","+        assertBusy(() -> {","+            indexAndCommit(1);","+            assertThat(listMetadataFiles(metadataPath).size(), lessThanOrEqualTo(METADATA_FILES_TO_KEEP + 1));","+        });","+    }","+","+    /** Only a commit carrying new documents produces a metadata file, so each iteration indexes before it flushes. */","+    private void indexAndCommit(int commits) {","+        for (int i = 0; i < commits; i++) {","+            nextDocId = indexDocs(INDEX_NAME, nextDocId, 5);","+            flush(INDEX_NAME);","+        }","+    }","+","+    private Path segmentMetadataPath() {","+        String prefix = RemoteStoreSettings.CLUSTER_REMOTE_STORE_SEGMENTS_PATH_PREFIX.get(getNodeSettings());","+        return segmentRepoPath.resolve(","+            getShardLevelBlobPath(client(), INDEX_NAME, BlobPath.cleanPath(), \"0\", SEGMENTS, METADATA, prefix).buildAsString()","+        );","+    }","+","+    private static List<String> listMetadataFiles(Path path) throws IOException {","+        try (Stream<Path> files = Files.list(path)) {","+            return files.map(file -> file.getFileName().toString()).collect(Collectors.toList());","+        }","+    }","+}"],"additions":88,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/SegmentsOnlyMetadataIT.java","lines":["@@ -0,0 +1,65 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.remotestore;","+","+import org.opensearch.action.admin.cluster.remotestore.metadata.RemoteStoreMetadataResponse;","+import org.opensearch.action.admin.cluster.remotestore.metadata.RemoteStoreShardMetadata;","+","+import java.util.Arrays;","+import java.util.List;","+import java.util.Map;","+","+/**","+ * The remote store metadata API has to answer for a shard with remote segments and no remote translog, a combination","+ * the API was written before and only ever saw as a misconfiguration.","+ */","+public class SegmentsOnlyMetadataIT extends SegmentsOnlyBaseIntegTestCase {","+","+    private static final String INDEX_NAME = \"segments-only-metadata-idx\";","+","+    /**","+     * The translog section has to come back empty rather than failing the shard. An unset repository setting reads","+     * back as the empty string, so a shard is only reported on at all if the API tells that apart from a repository","+     * that is set, and the segment metadata is lost along with it if it does not.","+     */","+    public void testMetadataIsReportedWithoutATranslogRepository() throws Exception {","+        startCluster(1);","+        createSegmentsOnlyIndex(INDEX_NAME, 0);","+        indexDocs(INDEX_NAME, 0, 20);","+        refresh(INDEX_NAME);","+","+        RemoteStoreMetadataResponse response = client().admin().cluster().prepareRemoteStoreMetadata(INDEX_NAME, null).get();","+        assertEquals(\"no shard may fail: \" + Arrays.toString(response.getShardFailures()), 0, response.getFailedShards());","+        assertEquals(1, response.getSuccessfulShards());","+","+        List<RemoteStoreShardMetadata> shards = response.groupByIndexAndShards().get(INDEX_NAME).get(0);","+        assertFalse(shards.isEmpty());","+        for (RemoteStoreShardMetadata metadata : shards) {","+            Map<String, Map<String, Object>> segmentFiles = metadata.getSegmentMetadataFiles();","+            assertNotNull(segmentFiles);","+            assertFalse(\"the segments are remote backed, so they must be described\", segmentFiles.isEmpty());","+            assertNotNull(metadata.getLatestSegmentMetadataFileName());","+","+            assertEquals(\"a local translog uploads no metadata\", Map.of(), metadata.getTranslogMetadataFiles());","+            assertNull(metadata.getLatestTranslogMetadataFileName());","+        }","+    }","+","+    /** A shard with nothing uploaded yet still has to be described rather than failed. */","+    public void testMetadataReportedBeforeFirstRefresh() throws Exception {","+        startCluster(1);","+        createSegmentsOnlyIndex(INDEX_NAME, 0);","+","+        RemoteStoreMetadataResponse response = client().admin().cluster().prepareRemoteStoreMetadata(INDEX_NAME, null).get();","+        assertEquals(\"no shard may fail: \" + Arrays.toString(response.getShardFailures()), 0, response.getFailedShards());","+        for (RemoteStoreShardMetadata metadata : response.groupByIndexAndShards().get(INDEX_NAME).get(0)) {","+            assertEquals(Map.of(), metadata.getTranslogMetadataFiles());","+        }","+    }","+}"],"additions":65,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/SegmentsOnlyPressureIT.java","lines":["@@ -0,0 +1,154 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.remotestore;","+","+import org.opensearch.action.admin.indices.replication.SegmentReplicationStatsResponse;","+import org.opensearch.action.support.replication.TransportReplicationAction;","+import org.opensearch.cluster.ClusterState;","+import org.opensearch.cluster.routing.IndexShardRoutingTable;","+import org.opensearch.common.settings.Settings;","+import org.opensearch.common.unit.TimeValue;","+import org.opensearch.core.concurrency.OpenSearchRejectedExecutionException;","+import org.opensearch.index.SegmentReplicationShardStats;","+import org.opensearch.index.shard.IndexShard;","+import org.opensearch.indices.replication.checkpoint.PublishCheckpointAction;","+import org.opensearch.test.transport.MockTransportService;","+import org.opensearch.transport.RemoteTransportException;","+import org.opensearch.transport.TransportService;","+","+import java.util.Set;","+import java.util.concurrent.TimeUnit;","+","+import static org.opensearch.index.SegmentReplicationPressureService.MAX_INDEXING_CHECKPOINTS;","+import static org.opensearch.index.SegmentReplicationPressureService.MAX_REPLICATION_TIME_BACKPRESSURE_SETTING;","+import static org.opensearch.index.SegmentReplicationPressureService.SEGMENT_REPLICATION_INDEXING_PRESSURE_ENABLED;","+import static org.hamcrest.Matchers.greaterThan;","+","+/**","+ * Segment replication backpressure for {@code segments_only} indices. A replica that stops applying checkpoints has","+ * to make the primary reject writes here exactly as it does in any other segment replication cluster, because the lag","+ * is measured between the primary and the replica's visible checkpoint and does not depend on where the translog lives.","+ * <p>","+ * This deliberately does not extend {@link org.opensearch.index.SegmentReplicationPressureIT}. That suite induces lag","+ * by parking the replica's sending thread inside a transport interceptor, and the thread it parks is a refresh thread","+ * holding a node wide lock. A {@code segments_only} replica keeps its translog locally, so unlike a fully remote backed","+ * replica it still has to serve replicated refreshes on that same pool, and parking there deadlocks the refresh the","+ * test itself is waiting on. Refusing the checkpoint at the replica's request handler starves the replica just as","+ * effectively without holding any thread.","+ */","+public class SegmentsOnlyPressureIT extends SegmentsOnlyBaseIntegTestCase {","+","+    private static final String INDEX_NAME = \"segments-only-pressure-idx\";","+    private static final int MAX_CHECKPOINTS_BEHIND = 2;","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal) {","+        return Settings.builder()","+            .put(super.nodeSettings(nodeOrdinal))","+            .put(SEGMENT_REPLICATION_INDEXING_PRESSURE_ENABLED.getKey(), true)","+            .put(MAX_REPLICATION_TIME_BACKPRESSURE_SETTING.getKey(), TimeValue.timeValueSeconds(1))","+            .put(MAX_INDEXING_CHECKPOINTS.getKey(), MAX_CHECKPOINTS_BEHIND)","+            .build();","+    }","+","+    /**","+     * A replica that falls past both the checkpoint and the time limit has to be counted as stale, which is what makes","+     * the primary refuse writes and then accept them again once the replica is caught up.","+     */","+    public void testWritesRejectedWhileReplicaIsBehind() throws Exception {","+        startClusterAndIndex();","+        IndexShard primary = shardOn(nodeHolding(true), INDEX_NAME);","+        MockTransportService replicaTransport = transportOn(nodeHolding(false));","+","+        // Refuse the checkpoint rather than delaying it, so the replica is starved for as long as the rule is","+        // installed while every thread on both nodes stays free.","+        replicaTransport.addRequestHandlingBehavior(","+            PublishCheckpointAction.ACTION_NAME + TransportReplicationAction.REPLICA_ACTION_SUFFIX,","+            (handler, request, channel, task) -> {","+                throw new RemoteTransportException(\"checkpoint withheld from the replica\", new OpenSearchRejectedExecutionException());","+            }","+        );","+","+        int docs = 0;","+        for (int i = 0; i <= MAX_CHECKPOINTS_BEHIND; i++) {","+            docs = indexDocs(INDEX_NAME, docs, 5);","+            refresh(INDEX_NAME);","+        }","+        assertBusy(() -> assertThat(checkpointsBehind(primary), greaterThan((long) MAX_CHECKPOINTS_BEHIND)), 30, TimeUnit.SECONDS);","+","+        // The time limit is only breached once the lag timer has been running longer than it, so a write is retried","+        // until it is refused rather than asserted on once.","+        assertBusy(","+            () -> expectThrows(","+                OpenSearchRejectedExecutionException.class,","+                () -> client().prepareIndex(INDEX_NAME).setId(\"rejected\").setSource(\"field\", \"value\").get()","+            ),","+            30,","+            TimeUnit.SECONDS","+        );","+","+        SegmentReplicationStatsResponse stats = client().admin()","+            .indices()","+            .prepareSegmentReplicationStats(INDEX_NAME)","+            .setDetailed(true)","+            .execute()","+            .actionGet();","+        assertThat(","+            \"the refusal must be attributed to the shard\",","+            stats.getReplicationStats().get(INDEX_NAME).get(0).getRejectedRequestCount(),","+            greaterThan(0L)","+        );","+","+        replicaTransport.clearAllRules();","+        refresh(INDEX_NAME);","+        assertBusy(","+            () -> assertEquals(\"the replica must catch up once checkpoints flow again\", 0, checkpointsBehind(primary)),","+            60,","+            TimeUnit.SECONDS","+        );","+        client().prepareIndex(INDEX_NAME).setId(\"accepted\").setSource(\"field\", \"value\").get();","+    }","+","+    /** A replica that keeps up must never be treated as stale, so that the refusal above cannot be vacuous. */","+    public void testWritesAreAcceptedWhileTheReplicaKeepsUp() throws Exception {","+        startClusterAndIndex();","+        IndexShard primary = shardOn(nodeHolding(true), INDEX_NAME);","+","+        int docs = 0;","+        for (int i = 0; i <= MAX_CHECKPOINTS_BEHIND * 2; i++) {","+            docs = indexDocs(INDEX_NAME, docs, 5);","+            refresh(INDEX_NAME);","+        }","+        assertBusy(() -> assertEquals(0, checkpointsBehind(primary)));","+        client().prepareIndex(INDEX_NAME).setId(\"accepted\").setSource(\"field\", \"value\").get();","+    }","+","+    private void startClusterAndIndex() {","+        startCluster(2);","+        // Refreshes are driven by the test so that the number of checkpoints the replica is behind is known.","+        createSegmentsOnlyIndex(INDEX_NAME, 1, Settings.builder().put(\"index.refresh_interval\", -1).build());","+    }","+","+    /** The name of the node holding the primary copy of shard 0, or the replica copy when {@code primary} is false. */","+    private String nodeHolding(boolean primary) {","+        ClusterState state = client().admin().cluster().prepareState().get().getState();","+        IndexShardRoutingTable shard = state.routingTable().index(INDEX_NAME).shard(0);","+        return state.nodes().get((primary ? shard.primaryShard() : shard.replicaShards().get(0)).currentNodeId()).getName();","+    }","+","+    private MockTransportService transportOn(String node) {","+        return (MockTransportService) internalCluster().getInstance(TransportService.class, node);","+    }","+","+    private long checkpointsBehind(IndexShard primary) {","+        Set<SegmentReplicationShardStats> stats = primary.getReplicationStatsForTrackedReplicas();","+        assertEquals(\"the sole replica must be tracked\", 1, stats.size());","+        return stats.iterator().next().getCheckpointsBehindCount();","+    }","+}"],"additions":154,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/SegmentsOnlyPrimaryRelocationIT.java","lines":["@@ -0,0 +1,68 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.remotestore;","+","+import org.opensearch.cluster.metadata.IndexMetadata;","+import org.opensearch.common.settings.Settings;","+import org.opensearch.indices.recovery.IndexPrimaryRelocationIT;","+import org.opensearch.indices.replication.common.ReplicationType;","+import org.opensearch.plugins.Plugin;","+import org.opensearch.test.InternalSettingsPlugin;","+import org.opensearch.test.OpenSearchIntegTestCase;","+","+import java.nio.file.Path;","+import java.util.Collection;","+import java.util.List;","+","+import static org.opensearch.remotestore.RemoteStoreBaseIntegTestCase.segmentsOnlyNodeAttributes;","+","+/**","+ * Handing a primary over while writes keep arriving is where a local translog and remote segments part company: the","+ * operations the source acknowledged after its last upload exist only in its translog, so they have to be shipped","+ * rather than left to the remote store. The inherited test relocates fifteen times under a writer thread.","+ */","+@OpenSearchIntegTestCase.ClusterScope(scope = OpenSearchIntegTestCase.Scope.TEST, numDataNodes = 0)","+public class SegmentsOnlyPrimaryRelocationIT extends IndexPrimaryRelocationIT {","+","+    private static final String REPOSITORY_NAME = \"test-segment-repo\";","+","+    private Path absolutePath;","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins() {","+        return List.of(InternalSettingsPlugin.class);","+    }","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal) {","+        if (absolutePath == null) {","+            absolutePath = randomRepoPath().toAbsolutePath();","+        }","+        return Settings.builder()","+            .put(super.nodeSettings(nodeOrdinal))","+            .put(segmentsOnlyNodeAttributes(REPOSITORY_NAME, absolutePath))","+            .build();","+    }","+","+    @Override","+    public Settings indexSettings() {","+        return Settings.builder()","+            .put(super.indexSettings())","+            .put(IndexMetadata.SETTING_REPLICATION_TYPE, ReplicationType.SEGMENT)","+            .put(IndexMetadata.SETTING_NUMBER_OF_REPLICAS, 0)","+            .put(IndexMetadata.SETTING_NUMBER_OF_SHARDS, 1)","+            .build();","+    }","+","+    @Override","+    public void testPrimaryRelocationWhileIndexing() throws Exception {","+        internalCluster().startClusterManagerOnlyNode();","+        super.testPrimaryRelocationWhileIndexing();","+    }","+}"],"additions":68,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/opensearch/remotestore/SegmentsOnlyRecoveryIT.java","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":537,"deletions":3,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-23T14:16:05.176223+00:00"}