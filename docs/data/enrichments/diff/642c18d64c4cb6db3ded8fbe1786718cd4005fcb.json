{"id":"642c18d64c4cb6db3ded8fbe1786718cd4005fcb","axis":"silent","repo":"vllm-project/vllm","sha":"642c18d64c4cb6db3ded8fbe1786718cd4005fcb","parsed":{"files":[{"path":"vllm/models/kimi_k3/nvidia/model.py","lines":["@@ -4,7 +4,7 @@"," "," import math"," from collections.abc import Hashable, Iterable","-from typing import Any, cast","+from typing import TYPE_CHECKING, Any, cast"," "," import torch"," from torch import nn","@@ -121,6 +121,12 @@","     KimiK3MultiModalProcessor,","     KimiK3ProcessingInfo,"," )","+from .specialized_decode.runtime import specialized_decode_config","+","+if TYPE_CHECKING:","+    from vllm.v1.worker.gpu.model_states.interface import ModelState","+","+    from .specialized_decode.runtime.decode import SpecializedDecode"," "," logger = init_logger(__name__)"," ","@@ -1421,8 +1427,34 @@ def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\"):","         self.logits_processor = LogitsProcessor(","             self.config.vocab_size, scale=logit_scale","         )","+        # decode_backend=latency_specialized: a specialized decode executor over","+        # self.model, built by the model state once the weights are loaded.","+        self.specialized_decode_config = specialized_decode_config(vllm_config)","+        self.specialized_decode: SpecializedDecode | None = None","+        # The final norm is applied in compute_logits unless the specialized decode","+        # applies it in forward.","+        self.needs_norm_in_logits = True","+","+    def build_specialized_decode(self) -> None:","+        from .specialized_decode.runtime.decode import SpecializedDecode","+","+        self.specialized_decode = SpecializedDecode(","+            self.model, self.specialized_decode_config","+        )","+        # From here on forward() returns normalized hidden states on every step: the","+        # specialized decode's last AttnRes applies the norm, and forward() applies it","+        # to each step that falls back to the stock forward (prefills, larger batches,","+        # PIECEWISE steps).","+        self.needs_norm_in_logits = False","+","+    def get_model_state_cls(self) -> \"type[ModelState]\":","+        from .model_state import KimiK3ModelState","+","+        return KimiK3ModelState"," ","     def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:","+        if self.specialized_decode is not None:","+            return self.specialized_decode.embed_input_ids(input_ids)","         return self.model.embed_input_ids(input_ids)"," ","     def make_empty_intermediate_tensors(","@@ -1441,9 +1473,18 @@ def forward(  # type: ignore[override]","         inputs_embeds: torch.Tensor | None = None,","         **kwargs,","     ) -> torch.Tensor | IntermediateTensors | tuple[torch.Tensor, list[torch.Tensor]]:","-        return self.model(","+        decode = self.specialized_decode","+        if decode is not None:","+            step = decode.plan(positions, intermediate_tensors)","+            if step is not None:","+                return decode.run(step, input_ids, inputs_embeds)","+        hidden_states = self.model(","             input_ids, positions, intermediate_tensors, inputs_embeds, **kwargs","         )","+        if not self.needs_norm_in_logits:","+            assert decode is not None","+            hidden_states = decode.normalize(hidden_states)","+        return hidden_states"," ","     @classmethod","     def get_mamba_state_dtype_from_config(","@@ -1502,7 +1543,8 @@ def compute_logits(","     ) -> torch.Tensor | None:","         # The model's final norm is applied here (not at the end of forward) so","         # that the pre-norm hidden states can be fed to the MTP draft model.","-        hidden_states = self.model.norm(hidden_states, None)","+        if self.needs_norm_in_logits:","+            hidden_states = self.model.norm(hidden_states, None)","         return self.logits_processor(self.lm_head, hidden_states)"," ","     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:","@@ -1926,6 +1968,9 @@ def forward(  # type: ignore[override]","     def compute_logits(self, hidden_states: torch.Tensor, **kwargs) -> torch.Tensor:","         return self.language_model.compute_logits(hidden_states)"," ","+    def get_model_state_cls(self) -> \"type[ModelState]\":","+        return self.language_model.get_model_state_cls()","+","     def copy_inputs_before_cuda_graphs(self, input_buffers, **kwargs):","         return self.language_model.mamba_cache.copy_inputs_before_cuda_graphs(","             input_buffers, **kwargs"],"additions":48,"deletions":3,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/model_state.py","lines":["@@ -0,0 +1,26 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Kimi K3's model runner state: the hybrid (KDA + MLA) state, plus the lifecycle of","+the specialized decode when ``decode_backend=latency_specialized`` selects it.\"\"\"","+","+from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridModelState","+","+","+class KimiK3ModelState(MambaHybridModelState):","+    \"\"\"Builds the specialized decode once the weights are loaded and the aux layers","+    set, and prepares it for every bound KV cache (the profiling cache, then the","+    real one).\"\"\"","+","+    def __init__(self, vllm_config, model, encoder_cache, device):","+        super().__init__(vllm_config, model, encoder_cache, device)","+        if hasattr(model, \"get_language_model\"):","+            model = model.get_language_model()","+        self.language_model = model","+        if model.specialized_decode_config is not None:","+            model.build_specialized_decode()","+","+    def initialize_kv_cache(self, kv_cache_config, block_tables):","+        super().initialize_kv_cache(kv_cache_config, block_tables)","+        decode = self.language_model.specialized_decode","+        if decode is not None:","+            decode.prepare_kv()"],"additions":26,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/attn_res/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/attn_res/kernel.py","lines":["@@ -0,0 +1,276 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Seven-CTA cluster AttnRes: one cluster per token, 1024 hidden columns per CTA.","+","+The delta is a tensor (read after the PDL wait) or ``slots`` Lamport mailbox slots","+summed in slot order, rounded to BF16 and re-armed. The final boundary rounds the","+mixture to BF16 before its RMSNorm. Prefix and saved blocks must be complete at launch.","+\"\"\"","+","+import cutlass","+import cutlass.cute as cute","+from cutlass import Float32, Int32, Uint32, Uint64","+","+from ..common.mailbox import poll, rearm","+from ..common.primitives import (","+    alloc,","+    at,","+    bf16,","+    bf16x2,","+    dot,","+    fma,","+    group_barrier,","+    launch,","+    load_words,","+    push_float,","+    scatter_reduce,","+    store_words,","+    wait,","+    zeros,","+)","+","+","+@cute.jit","+def round_pair(t, row: cutlass.Constexpr, j: cutlass.Constexpr):","+    word = bf16x2(t[row, 2 * j], t[row, 2 * j + 1])","+    t[row, 2 * j], t[row, 2 * j + 1] = bf16(word, 0), bf16(word, 1)","+","+","+@cute.jit","+def unpack(words, out, row: cutlass.Constexpr):","+    for i in cutlass.range_constexpr(8):","+        out[row, i] = bf16(words[i // 2], i % 2)","+","+","+def block_ptr(blocks, token, block, col):","+    \"\"\"``&blocks[token, block, col]`` from the tensor's strides.\"\"\"","+    return blocks.iterator + token * blocks.stride[0] + block * blocks.stride[1] + col","+","+","+@cute.jit","+def rstd(sum_sq, eps):","+    \"\"\"Reciprocal RMS of a 7168-wide row from its sum of squares.\"\"\"","+    return cute.math.rsqrt(fma(sum_sq, Float32(1 / 7168), eps), fastmath=True)","+","+","+@cute.jit","+def dot8(a, ar: cutlass.Constexpr, b, br: cutlass.Constexpr):","+    return dot((a[ar, i] for i in range(8)), (b[br, i] for i in range(8)), Float32(0))","+","+","+@cute.jit","+def arm_exchanges(bars, counts):","+    \"\"\"Thread 0 arms barrier ``r`` for ``counts[r]`` FP32 pushes from each of 7 CTAs.\"\"\"","+    if cute.arch.thread_idx()[0] == 0:","+        for r, count in enumerate(counts):","+            if cutlass.const_expr(count > 0):","+                cute.arch.mbarrier_init(bars.iterator + r, 1)","+                cute.arch.mbarrier_arrive_and_expect_tx(bars.iterator + r, 28 * count)","+        cute.arch.mbarrier_init_fence()","+","+","+class ClusterAttnRes:","+    def __init__(self, nb, *, slots=1, has_delta=True, write=-1, final=False):","+        self.nb, self.slots, self.has_delta = nb, slots, has_delta","+        self.write, self.final = write, final","+        self.npre = 2 * nb","+        self.npost = (2 if final else 4) if nb else 1","+        self.kpre = 1 << max(self.npre - 1, 0).bit_length()","+        self.kpost = 1 << max(self.npost - 1, 0).bit_length()","+","+    @cute.jit","+    def __call__(self, *args):","+        launch(self.kernel, args, (7, args[1].shape[0], 1), 128, 7)","+","+    @cute.jit","+    def exchange(","+        self, values, count: cutlass.Constexpr, kpad: cutlass.Constexpr, bufs, r, ids","+    ):","+        \"\"\"Cluster-sum ``count`` per-thread partials into round ``r``'s total row.\"\"\"","+        wb, peer_buf, total, bars = bufs","+        peer_buf, total, bar = peer_buf[r, None], total[r, None], bars.iterator + r","+        rank, _, tid = ids","+        lane, warp = tid % 32, tid // 32","+        reduced, index = scatter_reduce(values, lane, kpad)","+        if (lane & (32 // kpad - 1)) == 0 and index < count:","+            wb[warp * 16 + index] = reduced","+        group_barrier(0)","+        if tid < count:","+            value = (wb[tid] + wb[16 + tid]) + (wb[32 + tid] + wb[48 + tid])","+            for peer in cutlass.range_constexpr(7):","+                push_float(peer_buf.iterator + rank * 16 + tid, value, bar, Int32(peer))","+        wait(bar)","+        if tid < count:","+            sums = [Float32(0), Float32(0)]","+            for peer in cutlass.range_constexpr(7):","+                sums[peer % 2] += peer_buf[peer * 16 + tid]","+            total[tid] = sums[0] + sums[1]","+        group_barrier(0)","+","+    @cute.kernel","+    def kernel(self, args):","+        delta, prefix, blocks, norm, query, out_norm, output, eps, out_eps = args[0:9]","+        rank, token, _ = cute.arch.block_idx()","+        tid, _, _ = cute.arch.thread_idx()","+        bufs = self.setup(cutlass.utils.SmemAllocator())","+        cute.arch.cluster_arrive_relaxed()","+        cute.arch.griddepcontrol_launch_dependents()","+        state = self.state()","+        rows, ids = (prefix, blocks, norm, query, out_norm), (rank, token, tid)","+        self.pre(state, bufs, rows, eps, ids)","+        self.post(state, bufs, delta, rows, output, eps, out_eps, ids, args[9:])","+        cute.arch.griddepcontrol_wait()","+","+    def state(self):","+        \"\"\"Carried from pre() to post(); the rest reloads so a GEMM can run between.\"\"\"","+        return cute.make_rmem_tensor((1, 8), Float32), cute.make_rmem_tensor(2, Float32)","+","+    @cute.jit","+    def setup(self, smem):","+        warp_buf = alloc(smem, Float32, 64)","+        peer_buf = alloc(smem, Float32, (3, 112))","+        total = alloc(smem, Float32, (3, 16))","+        bars = alloc(smem, Uint64, 3, 8)","+        arm_exchanges(bars, (self.npre, self.npost, int(self.final)))","+        return warp_buf, peer_buf, total, bars","+","+    @cute.jit","+    def pre(self, state, bufs, rows, eps: Float32, ids):","+        \"\"\"Inputs complete at launch, then the saved-block statistics exchange.\"\"\"","+        prefix, blocks, norm, query, out_norm = rows","+        rank, token, tid = ids","+        warp_buf, peer_buf, total, bars = bufs","+        mixture, scal = state","+        # Rows: saved blocks, combined weight, gamma, old prefix, new prefix.","+        v = cute.make_rmem_tensor((self.nb + 4, 8), Float32)","+        col = (rank * 128 + tid) * 8","+        W = self.nb","+        for source in cutlass.range_constexpr(self.nb):","+            words = load_words(","+                block_ptr(blocks, token, source, col), count=4, mutable=True","+            )","+            unpack(words, v, source)","+        self.weights(v, norm, query, col)","+        cute.arch.cluster_wait()","+        maximum, exp_sum = Float32(0), Float32(0)","+        mixture.fill(0)","+        if cutlass.const_expr(self.nb > 0):","+            values = zeros(self.kpre, Float32)","+            for source in cutlass.range_constexpr(self.nb):","+                values[source] = dot8(v, source, v, source)","+                values[self.nb + source] = dot8(v, source, v, W)","+            self.exchange(values, self.npre, self.kpre, bufs, 0, ids)","+            logits = cute.make_rmem_tensor(self.nb, Float32)","+            for b in cutlass.range_constexpr(self.nb):","+                logits[b] = total[0, self.nb + b] * rstd(total[0, b], eps)","+            maximum = logits[0]","+            for source in cutlass.range_constexpr(1, self.nb):","+                maximum = cute.arch.fmax(maximum, logits[source])","+            for source in cutlass.range_constexpr(self.nb):","+                e = cute.math.exp(logits[source] - maximum, fastmath=True)","+                exp_sum += e","+                for i in cutlass.range_constexpr(8):","+                    mixture[0, i] = fma(e, v[source, i], mixture[0, i])","+        scal[0], scal[1] = maximum, exp_sum","+","+    @cute.jit","+    def weights(self, v, norm, query, col):","+        if cutlass.const_expr(self.nb > 0):","+            nw = load_words(norm.iterator + col, count=4)","+            qw = load_words(query.iterator + col, count=4)","+            for i in cutlass.range_constexpr(8):","+                v[self.nb, i] = bf16(nw[i // 2], i % 2) * bf16(qw[i // 2], i % 2)","+","+    @cute.jit","+    def post(","+        self, state, bufs, delta, rows, output, eps: Float32, out_eps: Float32, ids, aux","+    ):","+        \"\"\"Add the delta, update prefix (and its ``aux`` copy) and saved block, write","+        the normalized output.\"\"\"","+        prefix, blocks, norm, query, out_norm = rows","+        rank, token, tid = ids","+        warp_buf, peer_buf, total, bars = bufs","+        mixture, scal = state","+        maximum, exp_sum = scal[0], scal[1]","+        v = cute.make_rmem_tensor((self.nb + 4, 8), Float32)","+        col = (rank * 128 + tid) * 8","+        W, G, OLD, NEW = self.nb, self.nb + 1, self.nb + 2, self.nb + 3","+        self.weights(v, norm, query, col)","+        unpack(load_words(out_norm.iterator + col, count=4), v, G)","+        if cutlass.const_expr(self.has_delta):","+            unpack(load_words(at(prefix, token, col), count=4, mutable=True), v, OLD)","+        cur = cute.make_rmem_tensor((1, 8), Float32)","+        if cutlass.const_expr(self.slots == 0):","+            cute.arch.griddepcontrol_wait()","+            unpack(load_words(at(delta, token, col), count=4, mutable=True), cur, 0)","+        else:","+            cur.fill(0)","+            base = delta.iterator + token * 7168 + col","+            got = poll(base, delta.shape[1] * 7168, self.slots)","+            for slot in cutlass.range_constexpr(self.slots):","+                rearm(base + slot * delta.shape[1] * 7168)","+                part = cute.make_rmem_tensor((1, 8), Float32)","+                unpack(tuple(got[slot, k] for k in range(4)), part, 0)","+                for i in cutlass.range_constexpr(8):","+                    cur[0, i] = cur[0, i] + part[0, i]","+            if cutlass.const_expr(self.slots > 1):","+                for j in cutlass.range_constexpr(4):  # all-reduce output boundary","+                    round_pair(cur, 0, j)","+        words = cute.make_rmem_tensor(4, Uint32)","+        for j in cutlass.range_constexpr(4):","+            lo, hi = cur[0, 2 * j], cur[0, 2 * j + 1]","+            if cutlass.const_expr(self.has_delta):","+                lo, hi = v[OLD, 2 * j] + lo, v[OLD, 2 * j + 1] + hi","+            words[j] = bf16x2(lo, hi)","+        unpack(words, v, NEW)","+        values = zeros(self.kpost, Float32)","+        values[0] = dot8(v, NEW, v, NEW)","+        if cutlass.const_expr(self.nb > 0):","+            values[1] = dot8(v, NEW, v, W)","+            if cutlass.const_expr(not self.final):","+                values[2] = dot8(mixture, 0, v, NEW)","+                values[3] = dot8(mixture, 0, mixture, 0)","+        self.exchange(values, self.npost, self.kpost, bufs, 1, ids)","+        row = (words[0], words[1], words[2], words[3])","+        store_words(at(prefix, token, col), row)","+        for stream_out in aux:","+            store_words(at(stream_out, token, col), row)","+        if cutlass.const_expr(self.write >= 0):","+            store_words(block_ptr(blocks, token, self.write, col), row)","+        result = cute.make_rmem_tensor((1, 8), Float32)","+        if cutlass.const_expr(self.nb == 0):","+            scale = rstd(total[1, 0], out_eps)","+            for i in cutlass.range_constexpr(8):","+                result[0, i] = v[NEW, i] * scale * v[G, i]","+        else:","+            ss, dot = total[1, 0], total[1, 1]","+            logit = dot * rstd(ss, eps)","+            top = cute.arch.fmax(maximum, logit)","+            alpha = cute.math.exp(maximum - top, fastmath=True)","+            ep = cute.math.exp(logit - top, fastmath=True)","+            denominator = fma(alpha, exp_sum, ep)","+            if cutlass.const_expr(self.final):","+                inverse = Float32(1) / denominator","+                for j in cutlass.range_constexpr(4):","+                    for i in (2 * j, 2 * j + 1):","+                        result[0, i] = fma(","+                            alpha * inverse, mixture[0, i], ep * inverse * v[NEW, i]","+                        )","+                    round_pair(result, 0, j)","+                fin = cute.make_rmem_tensor(1, Float32)","+                fin[0] = dot8(result, 0, result, 0)","+                self.exchange(fin, 1, 1, bufs, 2, ids)","+                scale = rstd(total[2, 0], out_eps)","+                for i in cutlass.range_constexpr(8):","+                    result[0, i] = result[0, i] * scale * v[G, i]","+            else:","+                a2, t3 = alpha * alpha, total[1, 3]","+                ae2 = Float32(2) * alpha * ep","+                quad = fma(a2, t3, fma(ae2, total[1, 2], ep * ep * ss))","+                scale = rstd(quad, out_eps * denominator * denominator)","+                ca, cp = alpha * scale, ep * scale","+                for i in cutlass.range_constexpr(8):","+                    result[0, i] = fma(ca, mixture[0, i], cp * v[NEW, i]) * v[G, i]","+        for j in cutlass.range_constexpr(4):","+            words[j] = bf16x2(result[0, 2 * j], result[0, 2 * j + 1])","+        store_words(at(output, token, col), tuple(words[j] for j in range(4)))"],"additions":276,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/attn_res/prepared.py","lines":["@@ -0,0 +1,88 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Prepared seven-CTA AttnRes consumers for ordinary or Lamport mailbox input.\"\"\"","+","+from functools import cache","+from typing import Any","+","+import cutlass","+import cutlass.cute as cute","+from cutlass.cute.runtime import make_fake_stream","+","+from ..common.host import (","+    architecture,","+    dynamic_fake,","+    dynamic_view,","+    fake,","+    stream,","+    to_cute,","+)","+from .kernel import ClusterAttnRes","+","+","+@cache","+def compile_consumer(nb, delta, write, final, slots, cap, arch, aux=False):","+    row, weight, eps = dynamic_fake(2), fake((7168,), (1,)), cutlass.Float32(1e-6)","+    source = fake((slots, cap, 7168), (cap * 7168, 7168, 1)) if slots else row","+    kernel = ClusterAttnRes(nb, slots=slots, has_delta=delta, write=write, final=final)","+    args = (source, row, dynamic_fake(3), weight, weight, weight, row, eps, eps)","+    args += (row,) * aux  # the updated prefix row, also stored to an aux stream","+    return cute.compile(kernel, *args, make_fake_stream(), options=f\"--gpu-arch={arch}\")","+","+","+class PreparedAttnRes:","+    \"\"\"Ordinary-input code plus the Lamport variant of its bound mailbox ring.\"\"\"","+","+    def __init__(self, weights, key, eps):","+        self.device = weights[0].device","+        self.views = tuple(to_cute(w.reshape(-1)) for w in weights)","+        self.key, self.eps = key, tuple(map(cutlass.Float32, eps))","+        self.code = self._compile(0, 0)","+        self.ring: Any = None","+        self.aux: Any = None","+","+    def _compile(self, slots, cap, aux=False):","+        arch = architecture(self.device)","+        return compile_consumer(*self.key, slots, cap, arch, aux)","+","+    @classmethod","+    def for_target(cls, target, *, final=False, has_delta=True):","+        if final:","+            norm, query = target.output_attn_res_norm, target.output_attn_res_proj","+            output, nb, write = target.norm, target.num_attn_res_blocks, -1","+        else:","+            norm = target.self_attention_res_norm","+            query, output = target.self_attention_res_proj, target.input_layernorm","+            nb = target.prev_valid_blocks","+            write = target.block_write_idx if target.is_block_write_layer else -1","+        weights = (norm.weight, query.weight, output.weight)","+        eps = (norm.variance_epsilon, output.variance_epsilon)","+        return cls(weights, (nb, has_delta, write, final), eps)","+","+    def bind_ring(self, mailbox):","+        \"\"\"Lamport input: sum the [slots, capacity, 7168] mailbox rows, then re-arm.\"\"\"","+        shape = tuple(mailbox.shape[:2])","+        self.ring = self._compile(*shape), to_cute(mailbox), shape","+","+    def bind_aux(self):","+        \"\"\"Variants that also store the updated prefix rows (a stock aux stream).\"\"\"","+        ring = None","+        if self.ring is not None:","+            slots, cap = self.ring[2]","+            ring = self._compile(slots, cap, True)","+        self.aux = self._compile(0, 0, True), ring","+","+    def run_ring(self, prefix, blocks, out, aux=None):","+        code = self.ring[0] if aux is None else self.aux[1]","+        return self._launch(code, self.ring[1], prefix, blocks, out, aux)","+","+    def run(self, delta, prefix, blocks, out, aux=None):","+        code = self.code if aux is None else self.aux[0]","+        return self._launch(code, dynamic_view(delta), prefix, blocks, out, aux)","+","+    def _launch(self, code, source, prefix, blocks, out, aux=None):","+        rows = (prefix, blocks, out) + (() if aux is None else (aux,))","+        prefix, blocks, view, *aux = map(dynamic_view, rows)","+        args = *self.views, view, *self.eps, *aux","+        code(source, prefix, blocks, *args, stream(self.device))","+        return out"],"additions":88,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/common/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/common/embedding.py","lines":["@@ -0,0 +1,79 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Local CuTe vocabulary gather plus the ordinary framework TP all-reduce.\"\"\"","+","+from functools import cache","+","+import cutlass as c","+import cutlass.cute as cute","+import torch","+from cutlass.cute.runtime import make_fake_stream","+","+from vllm.distributed import get_tp_group","+","+from .host import architecture, fake","+from .primitives import launch","+","+","+class EmbeddingGather:","+    @cute.jit","+    def __call__(self, *args):","+        launch(self.kernel, args, (7, args[0].shape[0], 1), 128, pdl=False)","+","+    @cute.kernel","+    def kernel(self, args):","+        ids, weight, out, start, vocab = args[0:5]","+        lane, _, _ = cute.arch.thread_idx()","+        tile, token, _ = cute.arch.block_idx()","+        token_id = c.Int64(ids[token])","+        row, column = token_id - start, tile * 1024 + lane * 8","+        values = cute.make_rmem_tensor((8,), c.BFloat16)","+        values.fill(c.BFloat16(0))","+        if (token_id >= 0) & (token_id < vocab) & (row >= 0) & (row < weight.shape[0]):","+            source = weight.iterator + row * 7168 + column","+            cute.autovec_copy(cute.make_tensor(source, cute.make_layout((8,))), values)","+        destination = out.iterator + token * 7168 + column","+        cute.autovec_copy(values, cute.make_tensor(destination, cute.make_layout((8,))))","+","+","+@cache","+def compile_gather(dtype, shard, arch):","+    batch = cute.sym_int32()","+    args: tuple = (fake((batch,), None, dtype, dtype.itemsize), fake((shard, 7168)))","+    args += (fake((batch, 7168)), c.Int64(0), c.Int64(0))","+    stream = make_fake_stream(use_tvm_ffi_env_stream=True)","+    options = f\"--gpu-arch={arch} --enable-tvm-ffi\"","+    return cute.compile(EmbeddingGather(), *args, stream, options=options)","+","+","+class PreparedEmbedding:","+    def __init__(self, embedding, tp, rank):","+        weight = embedding.weight","+        # The gather moves 7 x 1024 BF16 columns of contiguous rows.","+        if weight.dim() != 2 or weight.shape[1] != 7168 or not weight.is_contiguous():","+            raise ValueError(","+                f\"embedding shard must be a contiguous [V, 7168] tensor, got \"","+                f\"{tuple(weight.shape)}\"","+            )","+        if weight.dtype != torch.bfloat16:","+            raise ValueError(f\"embedding shard must be BF16, got {weight.dtype}\")","+        self.group, self.weight = get_tp_group(), weight.detach()","+        self.start, self.vocab = rank * weight.shape[0], embedding.org_vocab_size","+        with torch.accelerator.device_index(weight.device.index):","+            arch, ids = architecture(weight.device), (torch.int32, torch.int64)","+            self.kernels = {t: compile_gather(t, weight.shape[0], arch) for t in ids}","+","+    def run(self, ids, out):","+        if ids.dim() != 1 or ids.dtype not in self.kernels:","+            raise ValueError(","+                f\"token ids must be 1-D int32/int64, got {ids.dtype} {tuple(ids.shape)}\"","+            )","+        if out.shape != (ids.shape[0], 7168) or not out.is_contiguous():","+            raise ValueError(","+                f\"embedding output must be contiguous [{ids.shape[0]}, 7168]\"","+            )","+        self.kernels[ids.dtype](ids, self.weight, out, self.start, self.vocab)","+        reduced = self.group.all_reduce(out)","+        if reduced is not out:","+            out.copy_(reduced)","+        return out"],"additions":79,"deletions":0,"truncated":false},{"path":"vllm/models/kimi_k3/nvidia/specialized_decode/cutedsl/common/host.py","lines":["@@ -0,0 +1,126 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Host-side helpers for the prepared CuTe providers.\"\"\"","+","+import ctypes","+import math","+","+import cuda.bindings.driver as cuda","+import cutlass","+import cutlass.cute as cute","+import torch","+from cutlass.cute.runtime import make_fake_tensor","+","+from vllm.models.kimi_k3.nvidia.ops.cute_dsl.latent_moe_tail.primitives import to_cute","+","+_NAMES = (\"BFloat16\", \"Float32\", \"Uint8\", \"Uint32\", \"Int32\", \"Int64\")","+_DTYPES = {getattr(torch, name.lower()): getattr(cutlass, name) for name in _NAMES}","+","+","+def layout(tensor):","+    return tuple(tensor.shape), tuple(tensor.stride()), tensor.dtype","+","+","+def stream(device):","+    return cuda.CUstream(torch.cuda.current_stream(device).cuda_stream)","+","+","+def architecture(device):","+    major, minor = torch.cuda.get_device_capability(device)","+    return f\"sm_{major}{minor}a\"","+","+","+def fake(shape, stride=None, dtype=torch.bfloat16, align=16):","+    \"\"\"Row-major unless ``stride`` is given.\"\"\"","+    stride = stride or tuple(math.prod(shape[i + 1 :]) for i in range(len(shape)))","+    dtype = _DTYPES.get(dtype, dtype)","+    return make_fake_tensor(dtype, shape, stride, assumed_align=align)","+","+","+def dynamic_fake(rank, dtype=torch.bfloat16):","+    shape = tuple(cute.sym_int() for _ in range(rank))","+    return fake(shape, (*(cute.sym_int(64) for _ in range(rank - 1)), 1), dtype)","+","+","+def dynamic_view(tensor, align=16):","+    return to_cute(tensor, align).mark_layout_dynamic(leading_dim=tensor.ndim - 1)","+","+","+def tensor_maps(specs, device):","+    \"\"\"TMA descriptors (128 B each) in one device tensor.","+    Each spec: (pointer, dtype, dims, strides, box, swizzle, l2 promotion).","+","+    The bytes are uploaded with a copy on the current stream: the new tensor may","+    reuse a block freed by a kernel still pending on that stream (e.g. a warmup","+    launch's output), which a copy outside the stream would race with.\"\"\"","+    encoded = bytearray()","+    with torch.accelerator.device_index(torch.device(device).index):","+        for pointer, dtype, dims, strides, box, swizzle, l2 in specs:","+            u64 = ([cuda.cuuint64_t(v) for v in values] for values in (dims, strides))","+            u32 = ([cuda.cuuint32_t(v) for v in box], [cuda.cuuint32_t(1)] * len(dims))","+            interleave = cuda.CUtensorMapInterleave.CU_TENSOR_MAP_INTERLEAVE_NONE","+            fill = cuda.CUtensorMapFloatOOBfill.CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE","+            status, tensor_map = cuda.cuTensorMapEncodeTiled(","+                dtype, len(dims), pointer, *u64, *u32, interleave, swizzle, l2, fill","+            )","+            if status != cuda.CUresult.CUDA_SUCCESS:","+                raise RuntimeError(f\"cuTensorMapEncodeTiled failed: {status}\")","+            encoded += (ctypes.c_ubyte * 128).from_address(tensor_map.getPtr())","+    return torch.frombuffer(encoded, dtype=torch.uint8).to(device)","+","+","+def _checked(result, operation=\"CUDA driver call\"):","+    \"\"\"The values of a cuda-python driver result, raising on a failed status.\"\"\"","+    status, *values = result","+    if status != cuda.CUresult.CUDA_SUCCESS:","+        raise RuntimeError(f\"{operation} failed: {status}\")"],"additions":76,"deletions":0,"truncated":false}],"additions":601,"deletions":3,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-16T14:19:28.637745+00:00"}