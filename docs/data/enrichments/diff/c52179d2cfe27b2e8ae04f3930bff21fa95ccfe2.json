tions/LGAI-EXAONE/exaone-35) and [EXAONE Deep](https://huggingface.co/collections/LGAI-EXAONE/exaone-deep) language models developed by [LG AI Research](https://huggingface.co/LGAI-EXAONE). Their architecture is the same as [Llama](./llama), with different parameter and config names.","+","+The auto classes load them with the Llama implementation ([`LlamaModel`] and [`LlamaForCausalLM`]), so only [`ExaoneConfig`] is specific to EXAONE. The released checkpoints are renamed to the Llama names when loading and back when saving.","+","+The example below demonstrates how to generate text with the [`AutoModelForCausalLM`] class.","+","+```python","+from transformers import AutoModelForCausalLM, AutoTokenizer","+","+","+tokenizer = AutoTokenizer.from_pretrained(\"LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct\")","+model = AutoModelForCausalLM.from_pretrained(\"LGAI-EXAONE/EXAONE-3.5-2.4B-Instruct\", device_map=\"auto\")","+","+messages = [{\"role\": \"user\", \"content\": \"Explain the Pythagorean theorem in one sentence.\"}]","+inputs = tokenizer.apply_chat_template(messages, add_generation_prompt=True, return_tensors=\"pt\", return_dict=True)","+output = model.generate(**inputs.to(model.device), max_new_tokens=64)","+print(tokenizer.decode(output[0][inputs[\"input_ids\"].shape[1] :], skip_special_tokens=True))","+```","+","+## ExaoneConfig","+","+[[autodoc]] ExaoneConfig"],"additions":47,"deletions":0,"truncated":false},{"path":"src/transformers/conversion_mapping.py","lines":["@@ -1280,6 +1280,18 @@ def _build_checkpoint_conversion_mapping():","                 operations=[Concatenate(dim=0)],","             ),","         ],","+        \"exaone\": [","+            WeightRenaming(r\"^transformer\\.wte\\.\", \"model.embed_tokens.\"),","+            WeightRenaming(r\"^transformer\\.h\\.\", \"model.layers.\"),","+            WeightRenaming(r\"^transformer\\.ln_f\\.\", \"model.norm.\"),","+            WeightRenaming(r\"\\.attn\\.attention\\.\", \".self_attn.\"),","+            WeightRenaming(r\"\\.self_attn\\.out_proj\\.\", \".self_attn.o_proj.\"),","+            WeightRenaming(r\"\\.ln_1\\.\", \".input_layernorm.\"),","+            WeightRenaming(r\"\\.ln_2\\.\", \".post_attention_layernorm.\"),","+            WeightRenaming(r\"\\.mlp\\.c_fc_0\\.\", \".mlp.gate_proj.\"),","+            WeightRenaming(r\"\\.mlp\\.c_fc_1\\.\", \".mlp.up_proj.\"),","+            WeightRenaming(r\"\\.mlp\\.c_proj\\.\", \".mlp.down_proj.\"),","+        ],","         \"lara_mini\": [","             WeightRenaming(source_patterns=r\"linear_attn\\.out_norm\\.\", target_patterns=\"linear_attn.norm.\"),","             # The checkpoints fuse the gated delta net input projections into one `in_proj`, rows `[q|k|v|z|b|a]`"],"additions":12,"deletions":0,"truncated":false},{"path":"src/transformers/models/__init__.py","lines":["@@ -155,6 +155,7 @@","     from .esmfold2 import *","     from .eurobert import *","     from .evolla import *","+    from .exaone import *","     from .exaone4 import *","     from .exaone4_5 import *","     from .exaone_moe import *"],"additions":1,"deletions":0,"truncated":false},{"path":"src/transformers/models/auto/auto_mappings.py","lines":["@@ -205,6 +205,7 @@","         (\"esmfold2\", \"EsmFold2Config\"),","         (\"eurobert\", \"EuroBertConfig\"),","         (\"evolla\", \"EvollaConfig\"),","+        (\"exaone\", \"ExaoneConfig\"),","         (\"exaone4\", \"Exaone4Config\"),","         (\"exaone4_5\", \"Exaone4_5_Config\"),","         (\"exaone4_5_vision\", \"Exaone4_5_VisionConfig\"),"],"additions":1,"deletions":0,"truncated":false},{"path":"src/transformers/models/auto/modeling_auto.py","lines":["@@ -172,6 +172,7 @@ class _BaseModelWithGenerate(PreTrainedModel, GenerationMixin):","         (\"esmc\", \"EsmcModel\"),","         (\"eurobert\", \"EuroBertModel\"),","         (\"evolla\", \"EvollaModel\"),","+        (\"exaone\", \"LlamaModel\"),","         (\"exaone4\", \"Exaone4Model\"),","         (\"exaone4_5\", \"Exaone4_5_Model\"),"," 