ationVar(&c.FlushCheckInterval, \"logline-index-builder.flush-check-interval\", DefaultFlushCheckInterval,","+\tf.DurationVar(&c.FlushCheckInterval, prefix+\".flush-check-interval\", DefaultFlushCheckInterval,"," \t\t\"Interval for periodic flush checks independent of the poll loop\")","-\tf.IntVar(&c.PostingsBufferPairs, \"logline-index-builder.postings-buffer-pairs\", DefaultPostingsBufferPairs,","+\tf.IntVar(&c.PostingsBufferPairs, prefix+\".postings-buffer-pairs\", DefaultPostingsBufferPairs,"," \t\t\"Capacity of the in-memory postings buffer in (ngram, docID) pairs. Resident memory is ~24 bytes per pair, allocated up front (~460 MiB at the default), and a builder swap briefly holds two buffers — budget GOMEMLIMIT accordingly. Minimum 65536.\")","-\tf.Float64Var(&c.PostingsSpillWatermark, \"logline-index-builder.postings-spill-watermark\", DefaultPostingsSpillWatermark,","+\tf.Float64Var(&c.PostingsSpillWatermark, prefix+\".postings-spill-watermark\", DefaultPostingsSpillWatermark,"," \t\t\"Fraction of the postings buffer the sorted, deduped head must reach before a run is spilled to scratch disk. Higher packs runs denser (fewer, larger runs feed the merge). Must be > 0 and <= 0.95.\")"," ","-\tf.IntVar(&c.ExtractThreads, \"logline-index-builder.extract-threads\", DefaultExtractThreads,","+\tf.IntVar(&c.ExtractThreads, prefix+\".extract-threads\", DefaultExtractThreads,"," \t\t\"Number of parallel n-gram extract goroutines (1-4). Incident/catchup mode only: values above 1 multiply the resident sort-buffer floor \"+"," \t\t\t\"(~480 MiB per goroutine at the default postings_buffer_pairs) and CPU demand for higher ingest throughput. Default 1 is the serial production path.\")","-\tf.IntVar(&c.MergeThreads, \"logline-index-builder.merge-threads\", DefaultMergeThreads,","+\tf.IntVar(&c.MergeThreads, prefix+\".merge-threads\", DefaultMergeThreads,"," \t\t\"Maximum number of shards merged concurrently during flush (default 1 = serial). \"+"," \t\t\t\"Must be between 1 and the shard count (unsharded indexes have one shard). \"+"," \t\t\t\"Each concurrent shard holds its own rank maps and a 1 MiB read buffer per run, so memory and file descriptors scale with this value.\")","-\tc.Kafka.RegisterFlagsWithPrefix(\"logline-index-builder.kafka\", f)","-\tf.StringVar(&c.ScratchDir, \"logline-index-builder.scratch-dir\", \"./data/partial-indexes\",","+\tc.Kafka.RegisterFlagsWithPrefix(prefix+\".kafka\", f)","+\tf.StringVar(&c.ScratchDir, prefix+\".scratch-dir\", \"./data/partial-indexes\","," \t\t\"Directory where intermediate .lidx files are written\")","-\tf.Uint64Var(&c.FlushOnMaxBytes, \"logline-index-builder.flush-on-max-bytes\", DefaultFlushOnMaxBytes,","+\tf.Uint64Var(&c.FlushOnMaxBytes, prefix+\".flush-on-max-bytes\", DefaultFlushOnMaxBytes,"," \t\t\"Full-flush trigger based on cumulative bytes of run files spilled to scratch disk by the active builder. \"+"," \t\t\t\"Peak scratch usage reaches 2-3x this value during a flush (retiring builder's runs + its merged .lidx output + the fresh builder's runs), \"+"," \t\t\t\"so size the scratch volume with that headroom.\")"," ","-\tf.DurationVar(&c.WaitRingPopulatedTimeout, \"logline-index-builder.wait-ring-populated-timeout\", 60*time.Second,","+\tf.DurationVar(&c.WaitRingPopulatedTimeout, prefix+\".wait-ring-populated-timeout\", 60*time.Second,"," \t\t\"Maximum time to wait at startup for the partition ring to be populated. \"+"," \t\t\t\"Service startup fails if the ring is still empty after this — there is no silent fallback.\")"," }","@@ -377,8 +349,11 @@ func (c *Config) Validate() error {"," \t\t\tMaxExtractThreads, c.ExtractThreads)"," \t}"," ","-\tif c.Index.NgramLength == 0 {","-\t\tc.Index.NgramLength = DefaultNgramLength","+\t// The shared index section applies the format defaults and checks the","+\t// format constraints. The builder then adds the limits of its own","+\t// implementation on top.","+\tif err := c.Index.Validate(); err != nil {","+\t\treturn err"," \t}"," ",