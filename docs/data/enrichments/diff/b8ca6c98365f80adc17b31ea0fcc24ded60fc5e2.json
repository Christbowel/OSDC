additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *    http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+package org.apache.spark.sql.catalyst.analysis","+","+import org.apache.spark.sql.catalyst.plans.logical.LogicalPlan","+import org.apache.spark.sql.connector.catalog.CatalogV2Implicits._","+import org.apache.spark.sql.errors.QueryCompilationErrors","+","+/**","+ * Validates resolved DDL targets, e.g. a view found for `ALTER TABLE t` is rejected.","+ * Valid targets are returned unchanged.","+ */","+private[sql] object DdlTargetValidation {","+","+  /** Fails unless the object found for an [[UnresolvedTable]] is a table. */","+  def validateTable(unresolvedTable: UnresolvedTable, target: LogicalPlan): LogicalPlan =","+    unresolvedTable match {","+      case u @ UnresolvedTable(identifier, cmd, suggestAlternative) =>","+        target match {","+          case v: ResolvedPersistentView =>","+            val nameParts = v.catalog.name() +: v.identifier.asMultipartIdentifier","+            throw QueryCompilationErrors.expectTableNotViewError(","+              nameParts, cmd, suggestAlternative, u)","+          case _: ResolvedTempView =>","+            throw QueryCompilationErrors.expectTableNotViewError(","+              identifier, cmd, suggestAlternative, u)","+          case table => table","+        }","+    }","+","+  /** Fails when the command requires a permanent object but its target is a temporary view. */","+  def validateTableOrView(","+      unresolvedTableOrView: UnresolvedTableOrView,","+      target: LogicalPlan): LogicalPlan = unresolvedTableOrView match {","+    case u @ UnresolvedTableOrView(identifier, cmd, allowTempView, _) =>","+      target match {","+        case _: ResolvedTempView if !allowTempView =>","+          throw QueryCompilationErrors.expectPermanentViewNotTempViewError(","+            identifier, cmd, u)","+        case other => other","+      }","+  }","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/analysis/FunctionResolution.scala","lines":["@@ -59,6 +59,7 @@ import org.apache.spark.sql.connector.catalog.functions.UnboundFunction"," import org.apache.spark.sql.errors.{DataTypeErrorsBase, QueryCompilationErrors}"," import org.apache.spark.sql.internal.connector.V1Function"," import org.apache.spark.sql.types._","+import org.apache.spark.util.ArrayImplicits._"," "," class FunctionResolution(","     override val catalogManager: CatalogManager,","@@ -374,6 +375,28 @@ class FunctionResolution(","     lambdas.nonEmpty && others.forall(_.resolved)","   }"," ","+  /**","+   * Resolves function metadata for commands such as `DESCRIBE FUNCTION`, using the caller's","+   * catalog extractor when supplied.","+   */","+  private[sql] def resolveFunctionName(","+      unresolvedFunctionName: UnresolvedFunctionName,","+      lookupCatalog: LookupCatalog = this): LogicalPlan = {","+    val nameParts = unresolvedFunctionName.multipartIdentifier","+    lookupBuiltinOrTempFunction(nameParts, None)","+      .orElse(lookupBuiltinOrTempTableFunction(nameParts)).map { info =>","+      ResolvedNonPersistentFunc(nameParts.head, V1Function.metadataOnly(info))","+    }.getOrElse {","+      val lookupCatalog.CatalogAndIdentifier(catalog, ident) =","+        relationResolution.expandIdentifier(nameParts)","+      val fullName = catalog.name +: ident.namespace :+ ident.name","+      CatalogV2Util.loadFunction(catalog, ident).map { func =>","+        ResolvedPersistentFunc(catalog.asFunctionCatalog, ident, func)","+      }.getOrElse(unresolvedFunctionName.copy(","+        possibleQualifiedName = Some(fullName.toImmutableArraySeq)))","+    }","+  }","+","   def lookupBuiltinOrTempFunction(","       nameParts: Seq[String],","       unresolvedFunc: Option[UnresolvedFunction]): Option[ExpressionInfo] = {"],"additions":23,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/analysis/KeepLegacyOutputs.scala","lines":["@@ -36,9 +36,7 @@ object KeepLegacyOutputs extends Rule[LogicalPlan] {","         case s: ShowTables =>","           keepLegacyShowTablesOutput(s)","         case d: DescribeNamespace =>","-          assert(d.output.length == 2)","-          d.copy(output = Seq(d.output.head.withName(\"database_description_item\"),","-            d.output.last.withName(\"database_description_value\")))","+          keepLegacyDescribeNamespaceOutput(d)","         case s: ShowTableProperties if s.propertyKey.isDefined =>","            s.copy(output = Seq(s.output.last))","       }","@@ -62,4 +60,13 @@ object KeepLegacyOutputs extends Rule[LogicalPlan] {","   def withLegacyShowTablesDatabaseColumn(output: Seq[Attribute]): Seq[Attribute] = {","     output.head.withName(\"database\") +: output.tail","   }","+","+  /** Renames namespace output to its legacy names; the caller applies the legacy-schema gate. */","+  def keepLegacyDescribeNamespaceOutput(","+      describeNamespace: DescribeNamespace): DescribeNamespace = {","+    assert(describeNamespace.output.length == 2)","+    describeNamespace.copy(output = Seq(","+      describeNamespace.output.head.withName(\"database_description_item\"),","+      describeNamespace.output.last.withName(\"database_description_value\")))","+  }"," }"],"additions":10,"deletions":3,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/analysis/NotFoundErrorSearchPath.scala","lines":["@@ -0,0 +1,86 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *    http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+package org.apache.spark.sql.catalyst.analysis","+","+import org.apache.spark.sql.connector.catalog.CatalogManager","+import org.apache.spark.sql.errors.QueryErrorsBase","+","+/**","+ * Search paths for unresolved-object errors, e.g. `DESCRIBE TABLE missing` lists the query's","+ * resolution scopes. The caller supplies its catalog path and error formatter.","+ */","+private[sql] object NotFoundErrorSearchPath {","+","+  /** Selects the search path by the target's query-like or DDL search-path mode. */","+  def forUnresolvedTableOrView(","+      catalogManager: CatalogManager,","+      unresolvedTableOrView: UnresolvedTableOrView,","+      catalogPath: Seq[String],","+      errors: QueryErrorsBase): Seq[String] = {","+    unresolvedTableOrView.tableNotFoundSearchPathMode match {","+      case UnresolvedTableOrViewSearchPathMode.QueryLike =>","+        forUnresolvedRelation(","+          catalogManager = catalogManager,","+          multipartIdentifier = unresolvedTableOrView.multipartIdentifier,","+          catalogPath = catalogPath,","+          errors = errors)","+      case UnresolvedTableOrViewSearchPathMode.Ddl =>","+        ddl(catalogPath, errors)","+    }","+  }","+","+  /**","+   * Search path for a query relation. `system.session.name` searches only temporary views, so","+   * `catalogPath` is evaluated only for other identifiers.","+   */","+  def forUnresolvedRelation(","+      catalogManager: CatalogManager,","+      multipartIdentifier: Seq[String],","+      catalogPath: => Seq[String],","+      errors: QueryErrorsBase): Seq[String] = {","+    if (CatalogManager.isFullyQualifiedSystemSessionViewName(multipartIdentifier)) {","+      tempViewOnly(errors)","+    } else {","+      full(catalogManager = catalogManager, catalogPath = catalogPath, errors = errors)","+    }","+  }","+","+  /** The temporary-view scope and the supplied catalog/namespace scope, without SQL PATH. */","+  def ddl(catalogPath: Seq[String], errors: QueryErrorsBase): Seq[String] = {","+    val sessionPath = Seq(","+      CatalogManager.SYSTEM_CATALOG_NAME,","+      CatalogManager.SESSION_NAMESPACE)","+    Seq(errors.toSQLId(sessionPath), errors.toSQLId(catalogPath))","+  }","+","+  /** The configured SQL resolution scopes, formatted with the caller's error formatter. */","+  def full(","+      catalogManager: CatalogManager,","+      catalogPath: Seq[String],","+      errors: QueryErrorsBase): Seq[String] = {","+    val catalog = catalogPath.head","+    val ns = catalogPath.tail.toSeq","+    catalogManager.sqlResolutionPathEntries(catalog, ns).map(errors.toSQLId)","+  }","+","+  private def tempViewOnly(errors: QueryErrorsBase): Seq[String] = {","+    Seq(errors.toSQLId(Seq(","+      CatalogManager.SYSTEM_CATALOG_NAME,","+      CatalogManager.SESSION_NAMESPACE)))","+  }","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/analysis/ResolveCatalogs.scala","lines":["@@ -145,9 +145,10 @@ class ResolveCatalogs(val catalogManager: CatalogManager)","       catalogIdentifierResolut