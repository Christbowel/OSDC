fers","+          # from HEAD) against the reference commit's packages - only product","+          # code differs. PRs resolve the merge-base; A/B dispatches pass the","+          # explicit ab_from commit via --at (fails loudly, no fallback).","           SANITY_STUDIO_BENCH_API_HOST: https://localhost:4312","           SANITY_STUDIO_BENCH_PROJECT_ID: benchref","           BASE_REF: ${{ github.base_ref }}","-        run: pnpm bench prepare-reference --base-ref \"$BASE_REF\"","+          AB_FROM: ${{ inputs.ab_from }}","+        run: |","+          if [ -n \"$AB_FROM\" ]; then","+            pnpm bench prepare-reference --at \"$AB_FROM\"","+          else","+            pnpm bench prepare-reference --base-ref \"$BASE_REF\"","+          fi"," ","       - uses: actions/upload-artifact@v7","         if: steps.reference.outputs.comparison == 'ab'","@@ -210,12 +257,17 @@ jobs:","     # nothing. The `!cancelled()` status function is required so the job still","     # runs when build-reference is *skipped* (a plain custom if: would itself","     # skip on a skipped need); guard on build succeeding.","+    # The ab_to clause requires build-reference success: on the PR path a","+    # broken reference falls back to absolute mode (comparison=skipped, job","+    # green), but `prepare-reference --at` fails the job instead — benching","+    # on regardless would produce a comparison-less run wearing an A/B label","     if: >-","       !cancelled() && needs.build.result == 'success' &&","+      (inputs.ab_to == '' || needs.build-reference.result == 'success') &&","       ((github.event_name == 'pull_request' &&","         needs.build.outputs.has_code_changes == 'true') ||","        (github.event_name == 'schedule' && github.event.schedule == '0 5 * * *') ||","-       (github.event_name == 'workflow_dispatch' && inputs.run_suite))","+       (github.event_name == 'workflow_dispatch' && (inputs.run_suite || inputs.ab_to != '')))","     runs-on: ubuntu-8core","     # Headroom for a/