93,34 +101,58 @@ jobs:","       # (a green run that backfilled nothing), and self_test would compare","       # the historical build against HEAD's reference config, reporting","       # product diffs as harness drift","-      - name: Validate backfill inputs","-        if: github.event_name == 'workflow_dispatch' && inputs.backfill_sha != ''","+      - name: Validate dispatch inputs","+        if: >-","+          github.event_name == 'workflow_dispatch' &&","+          (inputs.backfill_sha != '' || inputs.ab_from != '' || inputs.ab_to != '')","         env:","           RUN_SUITE: ${{ inputs.run_suite }}","           SELF_TEST: ${{ inputs.self_test }}","+          BACKFILL_SHA: ${{ inputs.backfill_sha }}","+          AB_FROM: ${{ inputs.ab_from }}","+          AB_TO: ${{ inputs.ab_to }}","         run: |","-          if [ \"$RUN_SUITE\" != \"true\" ]; then","-            echo \"::error::backfill_sha requires run_suite\"","+          # Explicit grouping: && and || share precedence in sh and associate","+          # left, so the ungrouped form silently passes when only ab_from is set","+          if { [ -n \"$AB_FROM\" ] && [ -z \"$AB_TO\" ]; } || { [ -z \"$AB_FROM\" ] && [ -n \"$AB_TO\" ]; }; then","+            echo \"::error::ab_from and ab_to must be set together\"","+            exit 1","+          fi","+          if [ -n \"$AB_TO\" ] && [ -n \"$BACKFILL_SHA\" ]; then","+            echo \"::error::ab_from/ab_to cannot be combined with backfill_sha\"","             exit 1","           fi","-          if [ \"$SELF_TEST\" = \"true\" ]; then","-            echo \"::error::backfill_sha cannot be combined with self_test\"","+          if [ -n \"$AB_TO\" ] && [ \"$SELF_TEST\" = \"true\" ]; then","+            echo \"::error::ab_from/ab_to cannot be combined with self_test\"","             exit 1","           fi","+          if [ -n \"$BACKFILL_SHA\" ]; then","+            if [ \"$RUN_SUITE\" != \"true\" ]; then","+              echo \"::error::backfill_sha requires run_suite\"","+              exit 1","+            fi","+            if [ \"$SELF_TEST\" = \"true\" ]; then","+              echo \"::error::backfill_sha cannot be combined with self_test\"","+              exit 1","+            fi","+          fi"," ","-      # Backfill: build the experiment dist from the requested historical","-      # commit's packages (HEAD's harness overlaid) instead of HEAD's — used","-      # to repair holes in the daily time series after harness outages. The","-      # downstream jobs run unchanged and store the result under that sha","+      # Backfill / A/B: build the experiment dist from the requested","+      # historical commit's packages (HEAD's harness overlaid) instead of","+      # HEAD's — backfill repairs holes in the daily time series, ab_to is","+      # the experiment side of an A/B dispatch. The downstream jobs run","+      # unchanged and, for backfill, store the result under that sha","       # (BENCH_GIT_SHA below).","       - name: Build packages and experiment studio","         id: build","         if: steps.changes.outputs.has_changes == 'true' || github.event_name != 'pull_request'","         env:","           BACKFILL_SHA: ${{ inputs.backfill_sha }}","+          AB_TO: ${{ inputs.ab_to }}","         run: |","-          if [ -n \"$BACKFILL_SHA\" ]; then","-            pnpm bench prepare-backfill --sha \"$BACKFILL_SHA\"","+          HISTORICAL_SHA=\"${BACKFILL_SHA:-$AB_TO}\"","+          if [ -n \"$HISTORICAL_SHA\" ]; then","+            pnpm bench prepare-backfill --sha \"$HISTORICAL_SHA\"","           else","             pnpm build:bench","           fi","@@ -133,10 +165,13 @@ jobs:","           retention-days: 7"," ","   build-reference:","+    # PR path (label-gated, merge-base reference) or A/B dispatch (explicit","+    # reference commit via ab_from)","     if: >-","-      github.event_name == 'pull_request' &&","-      contains(github.event.pull_request.labels.*.name, 'trigger:perf-bench') &&","-      (github.event.