{"id":"7c985ef025350d08aa4ce35c3619edfbe48d15c3","axis":"silent","repo":"mongodb/mongo","sha":"7c985ef025350d08aa4ce35c3619edfbe48d15c3","parsed":{"files":[{"path":"buildscripts/idl/idl/binder.py","lines":["@@ -1916,6 +1916,75 @@ def is_incremental_feature_rollout_flag(feature_flag):","     return phase is not None and phase != ast.FeatureFlagRolloutPhase.NOT_FOR_INCREMENTAL_ROLLOUT"," "," ","+def _validate_reply_structs_not_strict(ctxt, parsed_spec):","+    # type: (errors.ParserContext, syntax.IDLSpec) -> None","+    \"\"\"Validate that no struct reachable from a reply position is strict. See SERVER-130246.\"\"\"","+    symbols = parsed_spec.symbols","+","+    # The bind pass has already resolved (and reported) any unresolvable field types; resolution","+    # failures here are silently skipped so this validation cannot add duplicate errors.","+    silent_ctxt = errors.ParserContext(\"unknown\", errors.ParserErrorCollection())","+    visited = set()  # type: Set[str]","+","+    def visit_resolved_type(resolved, reply_root_name):","+        # type: (Union[syntax.Enum, syntax.Struct, syntax.Type], str) -> None","+        \"\"\"Visit a resolved type, recursing into nested struct types.\"\"\"","+        if isinstance(resolved, syntax.ArrayType):","+            # Arrays of structs parse each element with the struct's own parser.","+            visit_resolved_type(resolved.element_type, reply_root_name)","+        elif isinstance(resolved, syntax.VariantType):","+            # A variant alternative may be a struct or an array of structs; the latter","+            # resolves into variant_types as an ArrayType wrapping the struct.","+            for alternative in resolved.variant_struct_types:","+                visit_resolved_type(alternative, reply_root_name)","+            for alternative in resolved.variant_types:","+                visit_resolved_type(alternative, reply_root_name)","+        elif isinstance(resolved, syntax.Struct):","+            visit_struct(resolved, reply_root_name)","+","+    def visit_struct(struct, reply_root_name):","+        # type: (syntax.Struct, str) -> None","+        \"\"\"Visit a struct reachable from a reply position, and recurse into its fields.\"\"\"","+        if struct.name in visited:","+            return","+        visited.add(struct.name)","+","+        if struct.strict:","+            ctxt.add_strict_reply_not_allowed(struct, struct.name, reply_root_name)","+","+        for field in struct.fields or []:","+            # Ignored fields are not deserialized, so their types are unreachable from the reply.","+            if field.ignore:","+                continue","+            resolved = symbols.resolve_field_type(silent_ctxt, struct, field.name, field.type)","+            if resolved is not None:","+                visit_resolved_type(resolved, reply_root_name)","+","+        for chained_struct in struct.chained_structs or []:","+            resolved = symbols.resolve_type_from_name(","+                silent_ctxt, chained_struct, chained_struct.name, chained_struct.name","+            )","+            if isinstance(resolved, syntax.Struct):","+                visit_struct(resolved, reply_root_name)","+","+    # Imported definitions are validated when their own file is compiled; only seed from this","+    # file's commands and structs. The traversal itself still follows imported structs since a","+    # reply defined here really does embed them.","+    for command in symbols.commands:","+        if not command.imported and command.reply_type:","+            resolved = symbols.resolve_type_from_name(","+                silent_ctxt, command, command.name, command.reply_type","+            )","+            if isinstance(resolved, syntax.Struct):","+                visit_struct(resolved, command.name)","+","+    for struct in symbols.structs:","+        if not struct.imported and (","+            struct.is_command_reply or struct.is_generic_cmd_list == \"reply\"","+        ):","+            visit_struct(struct, struct.name)","+","+"," def bind(parsed_spec):","     # type: (syntax.IDLSpec) -> ast.IDLBoundSpec","     \"\"\"Read an idl.syntax, create an idl.ast tree, and validate the final IDL Specification.\"\"\"","@@ -1941,6 +2010,12 @@ def bind(parsed_spec):","         if not struct.imported:","             bound_spec.structs.append(_bind_struct(ctxt, parsed_spec, struct))"," ","+    # Reply-struct validation runs after all commands and structs are bound because a struct's","+    # reachability from a reply position can span struct declaration order (a struct declared","+    # earlier may be reachable only through one declared later), and the error must point at the","+    # offending strict struct rather than the reply root.","+    _validate_reply_structs_not_strict(ctxt, parsed_spec)","+","     for feature_flag in parsed_spec.feature_flags:","         bound_spec.server_parameters.append(_bind_feature_flags(ctxt, feature_flag))"," "],"additions":75,"deletions":0,"truncated":false},{"path":"buildscripts/idl/idl/errors.py","lines":["@@ -117,6 +117,7 @@"," ERROR_ID_FEATURE_FLAG_ENABLED_ON_TRANSITIONAL_FCV_MISSING_SAFETY_EXPLANATION = \"ID110\""," ERROR_ID_SERIALIZE_ON_OUTGOING_REQUESTS_ON_NON_IFR_FLAG = \"ID111\""," ERROR_ID_SERIALIZE_ON_OUTGOING_REQUESTS_MISSING_VERSION = \"ID112\"","+ERROR_ID_STRICT_REPLY_NOT_ALLOWED = \"ID113\""," "," "," class IDLError(Exception):","@@ -1324,6 +1325,18 @@ def add_bad_visibility(self, node: yaml.nodes.Node, mod_visibility: str):","             f\"Bad visibility value '{mod_visibility}', only public, public_for_technical_reasons, private, file_private, unfortunately_open, needs_replacement, and use_replacement(...) are accepted\",","         )"," ","+    def add_strict_reply_not_allowed(self, location, struct_name, reply_root_name):","+        # type: (common.SourceLocation, str, str) -> None","+        \"\"\"Add an error about a reply struct that is strict.\"\"\"","+        self._add_error(","+            location,","+            ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+            \"Struct '%s' is reachable from reply '%s' and must set 'strict: false'. Older \"","+            \"binaries must ignore unknown fields in replies from newer binaries instead of \"","+            \"failing with IDLUnknownField; this cannot be gated behind FCV since FCV only \"","+            \"tracks major.minor versions, not patch versions.\" % (struct_name, reply_root_name),","+        )","+"," "," def _assert_unique_error_messages():","     # type: () -> None"],"additions":13,"deletions":0,"truncated":false},{"path":"buildscripts/idl/idl_check_compatibility.py","lines":["@@ -1824,6 +1824,9 @@ def check_compatibility(","                     if not old_cmd.strict and new_cmd.strict:","                         ctxt.add_command_strict_true_error(new_cmd.command_name, new_idl_file_path)"," ","+                    old_reply = old_idl_file.spec.symbols.get_struct(old_cmd.reply_type)","+                    new_reply = new_idl_file.spec.symbols.get_struct(new_cmd.reply_type)","+","                     # Check compatibility of command's parameters.","                     check_command_params_or_type_struct_fields(","                         ctxt,","@@ -1847,8 +1850,6 @@ def check_compatibility(","                         new_idl_file_path,","                     )"," ","-                    old_reply = old_idl_file.spec.symbols.get_struct(old_cmd.reply_type)","-                    new_reply = new_idl_file.spec.symbols.get_struct(new_cmd.reply_type)","                     check_reply_fields(","                         ctxt,","                         old_reply,"],"additions":3,"deletions":2,"truncated":false},{"path":"buildscripts/idl/tests/test_binder.py","lines":["@@ -737,6 +737,262 @@ def test_struct_negative(self):","             \"\"\")","         )"," ","+    def test_strict_reply_struct_negative(self):","+        # type: () -> None","+        \"\"\"Negative tests for reply structs with strict: true (SERVER-130246).\"\"\"","+","+        test_preamble = self.common_types + indent_text(","+            1,","+            textwrap.dedent(\"\"\"","+            int:","+                description: foo","+                cpp_type: std::int32_t","+                bson_serialization_type: int","+                deserializer: mongo::BSONElement::_numberInt","+                is_view: false","+        \"\"\"),","+        )","+","+        # A struct with is_command_reply: true may not set strict: true.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: true","+                    fields:","+                        foo: string","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A struct with is_command_reply: true may not rely on the default strictness either.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    fields:","+                        foo: string","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A struct used as a command reply_type may not be strict.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                reply:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+            commands:","+                foo:","+                    description: foo","+                    command_name: foo","+                    namespace: ignored","+                    api_version: \"\"","+                    reply_type: reply","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A generic reply field list may not be strict.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                generic_reply:","+                    description: foo","+                    is_generic_cmd_list: reply","+                    strict: true","+                    fields:","+                        foo: string","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # Non-reply structs may still be strict.","+        self.assert_bind(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                foo:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+            \"\"\")","+        )","+","+        # Reply structs with strict: false bind fine.","+        self.assert_bind(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        foo: string","+            commands:","+                foo:","+                    description: foo","+                    command_name: foo","+                    namespace: ignored","+                    api_version: \"\"","+                    reply_type: reply","+            \"\"\")","+        )","+","+        # A strict struct nested inside a reply struct (via a struct-typed field) is rejected.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                nested:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        nested_field:","+                            type: nested","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A strict struct nested inside a reply struct via an array of structs is rejected.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                nested:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        nested_field:","+                            type: array<nested>","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A strict struct nested inside a reply struct via a variant of structs is rejected.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                nested:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        nested_field:","+                            type:","+                                variant:","+                                - nested","+                                - string","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A strict struct nested inside a reply via a variant of arrays of structs is rejected.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                nested:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        nested_field:","+                            type:","+                                variant:","+                                - array<nested>","+                                - string","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A strict struct nested two levels deep is still rejected.","+        self.assert_bind_fail(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                inner:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+                middle:","+                    description: foo","+                    strict: false","+                    fields:","+                        inner_field:","+                            type: inner","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        middle_field:","+                            type: middle","+            \"\"\"),","+            idl.errors.ERROR_ID_STRICT_REPLY_NOT_ALLOWED,","+        )","+","+        # A strict struct is not rejected when it is only reachable from a non-reply struct.","+        self.assert_bind(","+            test_preamble","+            + textwrap.dedent(\"\"\"","+            structs:","+                nested:","+                    description: foo","+                    strict: true","+                    fields:","+                        foo: string","+                request:","+                    description: foo","+                    fields:","+                        nested_field:","+                            type: nested","+                reply:","+                    description: foo","+                    is_command_reply: true","+                    strict: false","+                    fields:","+                        foo: string","+            \"\"\")","+        )","+","     def test_variant_positive(self):","         # type: () -> None","         \"\"\"Positive variant test cases.\"\"\"","@@ -1840,6 +2096,7 @@ def test_command_positive(self):","         structs:","             reply:","                 description: foo","+                strict: false","                 fields:","                     foo: string","         \"\"\")","@@ -3094,6 +3351,7 @@ def test_access_check(self):","         structs:","             reply:","                 description: foo","+                strict: false","                 fields:","                     foo: string","         \"\"\")","@@ -3207,6 +3465,7 @@ def test_access_check_negative(self):","         structs:","             reply:","                 description: foo","+                strict: false","                 fields:","                     foo: string","         \"\"\")"],"additions":259,"deletions":0,"truncated":false},{"path":"buildscripts/idl/tests/test_generator.py","lines":["@@ -907,6 +907,7 @@ def test_is_reply_type(self) -> None:","                 ReplyStruct:","                     description: Test struct that is a command reply.","                     is_command_reply: true","+                    strict: false","                     fields:","                         reply_field: int","             \"\"\"","@@ -1458,6 +1459,7 @@ def test_command_with_reply_type(self) -> None:","                 ReplyStruct:","                     description: Test struct that is a reply type.","                     is_command_reply: true","+                    strict: false","             commands:","                 CommandWithReplyType:","                     description: A command with its reply type specified by an IDL struct.","@@ -1481,6 +1483,7 @@ def test_stable_api_commands(self) -> None:","             structs:","                 EmptyStruct:","                     description: Empty struct.","+                    strict: false","             commands:","                 APIv1Command:","                     description: A Stable API command."],"additions":3,"deletions":0,"truncated":false},{"path":"docs/idl.md","lines":["@@ -627,6 +627,13 @@ The generated C++ parsers for structs are strict by default. This means that the"," fields that do not know about. Use `strict: false` to change this behavior. Mark persisted structs"," with `strict: false` for future backwards compatibility needs."," ","+Structs used as command replies (including every struct reachable from a reply struct through","+struct-valued fields, arrays of structs, variants, and chained structs) must set `strict: false`.","+Replies are parsed by potentially older binaries, and a strict reply parser makes an older binary","+fail with `IDLUnknownField` when a newer binary adds a reply field. This cannot be gated behind a","+feature flag or FCV since FCV only tracks major.minor versions, not patch versions. The IDL compiler","+rejects a strict reply struct at compile time.","+"," A struct consists of one or more fields. All fields are required by default. The generated parser"," errors if field is missing from the BSON document. On serialization, if a field has not been set,"," the serializer calls `invariant`.","@@ -754,7 +761,9 @@ multi level chained structs."," - `fields` - sequence - see [fields attributes reference below](#struct-fields-attribute-reference)"," - `strict` - bool - defaults to true, a strict parser errors if a unknown field is encountered by","   the generated parser. Persisted structs should set this to `false` to allow them to encounter","-  documents from future versions of MongoDB without throwing an error.","+  documents from future versions of MongoDB without throwing an error. Reply structs (and any struct","+  reachable from one) must set this to `false`; the compiler errors otherwise. See","+  [Structs](#structs) above."," - `chained_structs` - mapping - a list of structs to include this struct. IDL adds the chained","   structs as member variables in the generated C++ class. IDL also adds a getter for each chained","   struct.","@@ -769,7 +778,8 @@ multi level chained structs.","   expected to thrown a C++ exception (i.e. `uassert`) if validation fails."," - `is_command_reply` - bool - if true, marks the struct as a command reply. A struct marked a","   `is_command_reply` generates a parser that ignores known generic or common fields across all","-  replies when parsing replies (i.e. `ok`, `errmsg`, etc)","+  replies when parsing replies (i.e. `ok`, `errmsg`, etc). A struct marked `is_command_reply` must","+  set `strict: false`; see [Structs](#structs) above."," - `is_generic_cmd_list` - string - choice [`arg`, `reply`], if set, generates functions","   `bool hasField(StringData)` and `bool shouldForwardToShards(StringData)` for each field in the","   struct. If set to `arg`, the struct will automatically be chained to every `command`."],"additions":12,"deletions":2,"truncated":false},{"path":"src/mongo/crypto/fle_stats.idl","lines":["@@ -11,6 +11,7 @@ structs:","     ECOCStats:","         mod_visibility: public","         description: \"Stats a