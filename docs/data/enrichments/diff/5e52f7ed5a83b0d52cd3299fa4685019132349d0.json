+            isCappedCollection || !cappedViolationIsTolerated);","     const auto index = static_cast<int>(type);"," ","     std::lock_guard lk(_mutex);","-    const auto lastLog = _lastLogTimes[index];","+    auto& lastLogTimes = cappedViolationIsTolerated ? _lastCappedLogTimes : _lastLogTimes;","+    const auto lastLog = lastLogTimes[index];","     const auto now = Date_t::now();"," ","     if (now < lastLog + OplogConstraintViolationLogger::kPeriodicLogTimeout) {","@@ -53,21 +62,51 @@ void OplogConstraintViolationLogger::logViolationIfReady(OplogConstraintViolatio","         return;","     }"," ","-    if (!status) {","+    if (cappedViolationIsTolerated) {","+        // Capped collections may have diverged between nodes before FCV 5.0, and oplog application","+        // tolerates this violation, so it is expected and harmless. Log it separately from other","+        // constraint violations.","+        if (!status) {","+            LOGV2(10836100,","+                  \"Replication constraint violation on a capped collection during steady state \"","+                  \"replication. This is expected if capped collection contents diverged between \"","+                  \"nodes and is harmless\",","+                  \"msg\"_attr = toString(type),","+                  \"isCappedCollection\"_attr = isCappedCollection,","+                  \"obj\"_attr = obj);","+        } else {","+            LOGV2(10836101,","+                  \"Replication constraint violation on a capped collection during steady state \"","+                  \"replication. This is expected if capped collection contents diverged between \"","+                  \"nodes and is harmless\",","+                  \"msg\"_attr = toString(type),","+                  \"isCappedCollection\"_attr = isCappedCollection,","+                  \"obj\"_attr = obj,","+                  \"status\"_attr = *status);","+        }","+    } else if (!status) {","         LOGV2_WARNING(7149000,","                   