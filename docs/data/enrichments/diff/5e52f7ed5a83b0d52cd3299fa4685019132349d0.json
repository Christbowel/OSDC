  NUM_VIOLATION_TYPES,"," };"," ","@@ -52,6 +55,13 @@ std::string_view toString(OplogConstraintViolationEnum type);","  *","  * To avoid flooding the logs if continuous oplog constraint violations occur, we will only log","  * once every 10 minutes per each oplog constraint violation type.","+ *","+ * Before FCV 5.0 each node deleted excess capped documents independently, so capped collection","+ * contents may have diverged between nodes, and later oplog entries on those collections can","+ * harmlessly violate constraints. Violations that oplog application tolerates for this reason","+ * ('cappedViolationIsTolerated') are logged separately from other violations, with their own log","+ * id and rate limit, so that they cannot suppress the logging of real ones. Violations on capped","+ * collections that oplog application does not tolerate are logged like any other violation.","  */"," class OplogConstraintViolationLogger {"," public:","@@ -60,13 +70,21 @@ class OplogConstraintViolationLogger {"," ","     void logViolationIfReady(OplogConstraintViolationEnum type,","                              const BSONObj& obj,","-                             boost::optional<Status> status);","+                             boost::optional<Status> status,","+                             bool isCappedCollection = false,","+                             bool cappedViolationIsTolerated = false);","+","+    // Clears the last log times so that every violation type can be logged again immediately.","+    // Only for use in tests.","+    void resetForTest();"," "," private:","     mutable std::mutex _mutex;"," ","     std::vector<Date_t> _lastLogTimes = std::vector<Date_t>(","         static_cast<int>(OplogConstraintViolationEnum::NUM_VIOLATION_TYPES));  // (M)","+    std::vector<Date_t> _lastCappedLogTimes = std::vector<Date_t>(","+        static_cast<int>(OplogConstraintViolationEnum::NUM_VIOLATION_TYPES));  // (M)"," };"," "," }  // namespace repl"],"additions":19,"deletions":1,"truncated":false},{"path":"src/mongo/db/repl/oplog_constraint_violation_logger_test.cpp","lines":["@@ -0,0 +1,113 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/repl/oplog_constraint_violation_logger.h\"","+","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/unittest/log_capture.h\"","+#include \"mongo/unittest/unittest.h\"","+","+namespace mongo {","+namespace repl {","+namespace {","+","+constexpr int kViolationLogId = 7149000;","+constexpr int kCappedViolationLogId = 10836100;","+","+int countLogsWithId(const unittest::LogCaptureGuard& logs, int id) {","+    return logs.countBSONContainingSubset(BSON(\"id\" << id));","+}","+","+TEST(OplogConstraintViolationLoggerTest, NonCappedViolationUsesWarningLogId) {","+    OplogConstraintViolationLogger logger;","+    unittest::LogCaptureGuard logs;","+","+    logger.logViolationIfReady(OplogConstraintViolationEnum::kDeleteWasEmpty,","+                               BSON(\"op\" << \"d\"),","+                               /*status=*/boost::none,","+                               /*isCappedCollection=*/false);","+","+    ASSERT_EQ(1, countLogsWithId(logs, kViolationLogId));","+    ASSERT_EQ(0, countLogsWithId(logs, kCappedViolationLogId));","+    ASSERT_EQ(1,","+              logs.countBSONContainingSubset(","+                  BSON(\"id\" << kViolationLogId << \"attr\" << BSON(\"isCappedCollection\" << false))));","+}","+","+TEST(OplogConstraintViolationLoggerTest, CappedViolationUsesSeparateLogId) {","+    OplogConstraintViolationLogger logger;"],"additions":38,"deletions":0,"truncated":false}],"additions":298,"deletions":21,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-10T17:08:21.637365+00:00"}