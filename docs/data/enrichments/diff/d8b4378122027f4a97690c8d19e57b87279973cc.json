{"id":"d8b4378122027f4a97690c8d19e57b87279973cc","axis":"silent","repo":"comet-ml/comet-llm","sha":"d8b4378122027f4a97690c8d19e57b87279973cc","parsed":{"files":[{"path":"apps/opik-backend/config.yml","lines":["@@ -2816,7 +2816,8 @@ topics:","     #  Description: Fewest k-means groups a discovery run makes (never more than its unique texts)","     minGroups: ${TOPICS_ALGORITHM_MIN_GROUPS:-30}","     #  Default: 50","-    #  Description: Most k-means groups a discovery run makes; the author prompt lists every group. At least minGroups","+    #  Description: Most k-means groups a discovery run makes; the author prompt lists every group. At least minGroups.","+    #  The author answer names a topic per group: see authorTokensPerTopic and authorTokensPerGroup","     maxGroups: ${TOPICS_ALGORITHM_MAX_GROUPS:-50}","     #  Default: 30","     #  Description: Unique texts per group: k = unique texts / textsPerGroup, within minGroups and maxGroups","@@ -2899,6 +2900,15 @@ topics:","     #  topics/tasks/verify.yaml. That max_tokens + this x nightlyMaxGroups must be at most 4096, the inference","     #  service's limit: checked at startup","     nightlyVerifyTokensPerPair: ${TOPICS_ALGORITHM_NIGHTLY_VERIFY_TOKENS_PER_PAIR:-25}","+    #  Default: 60","+    #  Description: Upper estimate of the author answer's tokens per topic (its name and definition).","+    #  maxTopics x this + maxGroups x authorTokensPerGroup must be at most the max_tokens of","+    #  topics/tasks/author.yaml (2500): checked at startup, as a cut-off answer cannot be read","+    authorTokensPerTopic: ${TOPICS_ALGORITHM_AUTHOR_TOKENS_PER_TOPIC:-60}","+    #  Default: 20","+    #  Description: Upper estimate of the author answer's tokens per group (its cluster id and topic name). See","+    #  authorTokensPerTopic","+    authorTokensPerGroup: ${TOPICS_ALGORITHM_AUTHOR_TOKENS_PER_GROUP:-20}","     #  Default: 4","     #  Description: Nightly: member texts a live topic shows in the naming prompt","     nightlyTopicExamples: ${TOPICS_ALGORITHM_NIGHTLY_TOPIC_EXAMPLES:-4}"],"additions":11,"deletions":1,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/topics/AuthorAnswer.java","lines":["@@ -5,6 +5,7 @@"," import lombok.Builder;"," import lombok.NonNull;"," ","+import java.util.HashMap;"," import java.util.LinkedHashMap;"," import java.util.List;"," import java.util.Map;","@@ -17,13 +18,18 @@"," "," /**","  * The LLM's author answer: {@code {topics: [{name, definition}], assignment: [{cluster, topic}]}}, both keys required,","- * {@code topic} the topic's index or -1 for Other. Read as topics with cluster lists: each assignment's cluster goes to","- * its topic's list, the first mention of a cluster wins. A cluster assigned -1 or an index off the list claims nothing:","- * the applier sends every unclaimed group to Other. Unknown keys are ignored; anything else off the schema, text","- * included, is {@code llm_bad_answer}.","+ * {@code topic} the topic's name or \"-1\" for Other. A name, not an index: the model miscounted indexes and moved the","+ * last topics' names one cluster over. Read as topics with cluster lists: each assignment's cluster goes to the first","+ * topic of that name, compared as written, then by {@link AuthorApplier#nameKey}; the first mention of a cluster wins.","+ * A cluster assigned \"-1\" or a name off the list claims nothing: the applier sends every unclaimed group to Other.","+ * {@code unmatched} counts the clusters given a name off the list. Unknown keys are ignored; anything else off the","+ * schema, text included, is {@code llm_bad_answer}.","  */"," @Builder(toBuilder = true)","-public record AuthorAnswer(@NonNull List<AuthorTopic> topics) {","+public record AuthorAnswer(@NonNull List<AuthorTopic> topics, int unmatched) {","+","+    /** The {@code topic} of a cluster that has no topic. */","+    static final String OTHER = \"-1\";"," ","     /**","      * The {@code output} of a generate call with the author task's schema ({@code topics/tasks/author.yaml}):","@@ -40,12 +46,32 @@ public static AuthorAnswer parse(JsonNode node) {","             throw bad(\"the answer needs the arrays 'topics' and 'assignment'\", null);","         }","         var named = topicsNode.valueStream().map(AuthorAnswer::named).toList();","-        Map<Integer, Integer> firstMention = assignmentNode.valueStream().map(AuthorAnswer::assignment)","+        var byName = new HashMap<String, Integer>();","+        var byKey = new HashMap<String, Integer>();","+        for (int t = 0; t < named.size(); t++) {","+            byName.putIfAbsent(named.get(t).name(), t);","+            byKey.putIfAbsent(AuthorApplier.nameKey(named.get(t).name()), t);","+        }","+        Map<Integer, String> firstMention = assignmentNode.valueStream().map(AuthorAnswer::assignment)","                 .collect(toMap(Assignment::cluster, Assignment::topic, (first, later) -> first, LinkedHashMap::new));","-        Map<Integer, List<Integer>> claimed = firstMention.entrySet().stream()","-                .filter(entry -> entry.getValue() >= 0 && entry.getValue() < named.size())","+        var topicOf = new LinkedHashMap<Integer, Integer>();","+        int unmatched = 0;","+        for (var entry : firstMention.entrySet()) {","+            // Before the name lookup, so a topic named \"-1\" cannot take the clusters sent to Other.","+            if (OTHER.equals(entry.getValue().strip())) {","+                continue;","+            }","+            var topic = byName.getOrDefault(entry.getValue(), byKey.get(AuthorApplier.nameKey(entry.getValue())));","+            if (topic != null) {","+                topicOf.put(entry.getKey(), topic);","+            } else {","+                unmatched++;","+            }","+        }","+        Map<Integer, List<Integer>> claimed = topicOf.entrySet().stream()","                 .collect(groupingBy(Map.Entry::getValue, mapping(Map.Entry::getKey, toUnmodifiableList())));","         return AuthorAnswer.builder()","+                .unmatched(unmatched)","                 .topics(IntStream.range(0, named.size())","                         .mapToObj(t -> AuthorTopic.builder()","                                 .name(named.get(t).name())","@@ -59,7 +85,7 @@ public static AuthorAnswer parse(JsonNode node) {","     private record Named(String name, String definition) {","     }"," ","-    private record Assignment(int cluster, int topic) {","+    private record Assignment(int cluster, String topic) {","     }"," ","     private static Named named(JsonNode topic) {","@@ -75,10 +101,10 @@ private static Assignment assignment(JsonNode entry) {","         var cluster = entry.get(\"cluster\");","         var topic = entry.get(\"topic\");","         if (!entry.isObject() || cluster == null || !cluster.isIntegralNumber() || !cluster.canConvertToInt()","-                || topic == null || !topic.isIntegralNumber() || !topic.canConvertToInt()) {","-            throw bad(\"every assignment needs an integer 'cluster' and an integer 'topic'\", null);","+                || topic == null || !topic.isTextual()) {","+            throw bad(\"every assignment needs an integer 'cluster' and a string 'topic'\", null);","         }","-        return new Assignment(cluster.intValue(), topic.intValue());","+        return new Assignment(cluster.intValue(), topic.asText());","     }"," ","     private static TopicsRunException bad(String message, Throwable cause) {"],"additions":38,"deletions":12,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/topics/KMeansTopicAlgorithm.java","lines":["@@ -60,6 +60,15 @@ public KMeansTopicAlgorithm(@NonNull @Config(\"topics\") TopicsConfig topics, @Non","                         + \"topics.algorithm.nightlyVerifyTokensPerPair x nightlyMaxGroups) is above the limit, \"","                         + \"limit '%s', max_tokens '%s'\",","                 BatchGenerateItem.MAX_MAX_TOKENS, verifyMaxTokens);","+        // The author answer lists every topic and names a topic for every group: a cut-off answer cannot be read, so","+        // every discovery run would end llm_bad_answer.","+        int authorAnswerTokens = config.getMaxTopics() * config.getAuthorTokensPerTopic()","+                + config.getMaxGroups() * config.getAuthorTokensPerGroup();","+        Preconditions.checkState(authorAnswerTokens <= tasks.author().effectiveMaxTokens(),","+                \"the author answer's estimate (topics.algorithm.maxTopics x authorTokensPerTopic + maxGroups x \"","+                        + \"authorTokensPerGroup) is above the max_tokens of topics/tasks/author.yaml, max_tokens '%s', \"","+                        + \"estimate '%s'\",","+                tasks.author().effectiveMaxTokens(), authorAnswerTokens);","     }"," ","     @Override","@@ -176,6 +185,7 @@ public DiscoveredTopics finish(@NonNull AuthorAnswer answer) {","             var assigner = assigner(topicPrototypes, owners, otherPrototypes);","             var finishStats = JsonUtils.createObjectNode();","             finishStats.put(\"other_groups\", applied.other().size());","+            finishStats.put(\"author_unmatched\", answer.unmatched());","             finishStats.put(\"gated_other\", assigner.gatedOther());","             // A gated known-Other prototype is not returned: the assigner leaves it out as long as the topic prototype","             // near it is saved, so it would assign no trace."],"additions":10,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/topics/TopicsRunReconciler.java","lines":["@@ -12,6 +12,7 @@"," import reactor.core.publisher.Mono;"," import ru.vyarus.dropwizard.guice.module.yaml.bind.Config;"," ","+import java.time.Duration;"," import java.time.Instant;"," import java.time.LocalDate;"," import java.util.Collection;","@@ -61,7 +62,13 @@ private Mono<Boolean> settle(InFlightRun run, Set<String> enabled, LocalDate nig","                     : republishIfStale(run, night, now);","             case RUNNING -> {","                 if (run.heartbeatAt() == null || run.heartbeatAt().isBefore(stale)) {","-                    yield store.abandon(run, stale).map(abandoned -> !abandoned);","+                    yield store.abandon(run, stale)","+                            .doOnNext(abandoned -> {","+                                if (abandoned) {","+                                    logAbandoned(run, now);","+                                }","+                            })","+                            .map(abandoned -> !abandoned);","                 }","                 var cancel = reason.or(() -> run.deadlineAt() != null && run.deadlineAt().isBefore(now)","                         ? Optional.of(CancelReason.DEADLINE)","@@ -83,6 +90,14 @@ private Mono<Boolean> settle(InFlightRun run, Set<String> enabled, LocalDate nig","         };","     }"," ","+    private void logAbandoned(InFlightRun run, Instant now) {","+        log.warn(\"Topics run '{}' abandoned, workspace '{}', project '{}', mode '{}', silent for '{}' (last heartbeat \"","+                + \"'{}', topics.runs.abandonGrace '{}')\", run.runId(), run.workspaceId(), run.projectId(),","+                run.runMode().getValue(),","+                run.heartbeatAt() == null ? \"unknown\" : Duration.between(run.heartbeatAt(), now),","+                run.heartbeatAt(), config.getRuns().getAbandonGrace());","+    }","+","     private static Optional<CancelReason> leftReason(InFlightRun run, Set<String> enabled) {","         if (run.projectDeleted()) {","             return Optional.of(CancelReason.PROJECT_DELETED);"],"additions":16,"deletions":1,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/topics/TopicsRunSubscriber.java","lines":["@@ -8,6 +8,7 @@"," import jakarta.inject.Inject;"," import lombok.NonNull;"," import lombok.extern.slf4j.Slf4j;","+import org.apache.commons.lang3.exception.ExceptionUtils;"," import or