e.fail(message.runId(), workspace, message.projectId(), RunError.INTERNAL)","+                .doOnNext(marked -> log.warn(\"Topics run '{}' failed, project '{}', mode '{}', code '{}', marked '{}', \"","+                        + \"errors '{}'\", message.runId(), message.projectId(), message.mode().getValue(),","+                        RunError.INTERNAL.getValue(), marked,","+                        ExceptionUtils.getThrowableList(error).stream().map(TopicsErrors::formatError).toList()))","                 .then();","     }"," "],"additions":19,"deletions":1,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/TopicsConfig.java","lines":["@@ -155,6 +155,12 @@ public static class AlgorithmConfig {","         @JsonProperty","         @Min(1) @Max(10_000) private int nightlyVerifyTokensPerPair;"," ","+        @JsonProperty","+        @Min(1) @Max(1_000) private int authorTokensPerTopic;","+","+        @JsonProperty","+        @Min(1) @Max(1_000) private int authorTokensPerGroup;","+","         @JsonProperty","         @Min(1) @Max(100) private int nightlyTopicExamples;"," "],"additions":6,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/inference/ItemResponse.java","lines":["@@ -5,10 +5,12 @@"," import com.fasterxml.jackson.databind.DeserializationContext;"," import com.fasterxml.jackson.databind.JsonNode;"," import com.fasterxml.jackson.databind.deser.std.StdDeserializer;","+import com.google.common.hash.Hashing;"," import lombok.Builder;"," import lombok.NonNull;"," "," import java.io.IOException;","+import java.nio.charset.StandardCharsets;"," import java.util.Map;"," "," /** A successful item's response: decide or generate, told apart by the shape of {@code result}. */","@@ -44,6 +46,14 @@ record DecideResult(@NonNull Map<String, Answer> answers) {","     @Builder(toBuilder = true)","     @JsonIgnoreProperties(ignoreUnknown = true)","     record GenerateResult(JsonNode output) {","+","+        /** The output's size and SHA-256, never its text: it is the model's answer, made from users' traces. */","+        @Override","+        public String toString() {","+            var text = output == null ? \"null\" : output.toString();","+            return \"GenerateResult[output chars '%d', sha256 '%s']\".formatted(text.length(),","+                    Hashing.sha256().hashString(text, StandardCharsets.UTF_8));","+        }","     }"," ","     /**"],"additions":10,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/resources/topics/tasks/author.yaml","lines":["@@ -4,7 +4,7 @@"," # ai-labels task format requires it, so leave it as it is."," name: author"," endpoint: generate","-version: 2","+version: 3"," applies_from: 2026-11-19T00:00:00Z"," prompt:","   user: |","@@ -16,7 +16,7 @@ prompt:","     1. Define at most {{max_topics}} topics. For each topic give","        - \"name\": 2-5 words, Title Case, naming the kind of request. Never \"Other\", \"General\", \"Miscellaneous\", \"Various\", \"Mixed\" or a name built on such a word: name what the request is for, not how vague it is.","        - \"definition\": one sentence, at most 25 words, saying which requests belong to it; precise enough that a reader can decide for a new request.","-    2. Assign every cluster: list each cluster id exactly once, in the order shown, with the number of its topic (0 for the first topic, 1 for the second, and so on), or -1 when it is not a real kind of request (retries, greetings, empty input, health checks, test pings) or a mix with no dominant kind. -1 is not a topic.","+    2. Assign every cluster: list each cluster id exactly once, in the order shown, with the exact \"name\" of its topic, or \"-1\" when it is not a real kind of request (retries, greetings, empty input, health checks, test pings) or a mix with no dominant kind. \"-1\" is not a topic."," ","     Rules:","     - Group by what the request is meant to get done, not by wording or by the product/person named in the request.","@@ -31,7 +31,7 @@ prompt:","     {{clusters}}"," ","     Output JSON only, no prose:","-    {\"topics\": [{\"name\": \"...\", \"definition\": \"...\"}], \"assignment\": [{\"cluster\": id, \"topic\": number or -1}]}","+    {\"topics\": [{\"name\": \"...\", \"definition\": \"...\"}], \"assignment\": [{\"cluster\": id, \"topic\": \"exact topic name or -1\"}]}"," schema:","   type: object","   properties:","@@ -49,7 +49,7 @@ schema:","         type: object","         properties:","           cluster: {type: integer}","-          topic: {type: integer}","+          topic: {type: string}","         required: [cluster, topic]","   required: [topics, assignment]"," max_tokens: 2500"],"additions":4,"deletions":4,"truncated":false},{"path":"apps/opik-backend/src/test/java/com/comet/opik/domain/topics/TopicsAlgorithmRulesTest.java","lines":["@@ -92,7 +92,7 @@ void strip() {","         @DisplayName(\"catch-all names: the author's rule drops a name only when it is a catch-all as a whole\")","         void catchAllName(String name, boolean expected) {","             var groups = List.of(GroupSummary.builder().group(0).size(1).build());","-            var answer = new AuthorAnswer(List.of(new AuthorTopic(name, \"d\", List.of(0))));","+            var answer = authorAnswer(List.of(new AuthorTopic(name, \"d\", List.of(0))));"," ","             var applied = AuthorApplier.apply(answer, groups, 10);"," ","@@ -114,27 +114,43 @@ void object() throws IOException {","         }"," ","         @Test","-        @DisplayName(\"each cluster goes to the topic of its first mention; -1 and an index off the list end in Other\")","+        @DisplayName(\"each cluster goes to the topic of its name at its first mention; \\\"-1\\\" and a name off the list end \"","+                + \"in Other, and only the name off the list counts as unmatched\")","         void perCluster() throws IOException {","-            var answer = AuthorAnswer.parse(InferenceJs