lf.subTest(consumed=consumed):","+                metrics.reset()","+                clock_ns = 0","+                pulls = 0","+","+                def data():","+                    nonlocal clock_ns, pulls","+                    for _ in range(2):","+                        pulls += 1","+                        clock_ns += 17_000_000","+                        yield batch","+","+                def udf(dfs):","+                    nonlocal clock_ns","+                    clock_ns += 7_000_000","+                    for _ in range(consumed):","+                        yield next(dfs)","+","+                handler = self._handler(","+                    udf,","+                    self._return_type,","+                    RunnerConf({\"spark.sql.execution.pythonUDF.detailedTiming.enabled\": \"true\"}),","+                )","+                input_iter = data()","+                result = handler.run(0, input_iter)","+                with patch(","+                    \"pyspark.eval_handlers._pandas.time.perf_counter_ns\", new=lambda: clock_ns","+                ):","+                    try:","+                        self.assertEqual(pulls, 0)","+                        if consumed:","+                            self.assertEqual(next(result).num_rows, 2)","+                            clock_ns += 1_000_000_000","+                            result.close()","+                        else:","+                            self.assertEqual(list(result), [])","+                    finally:","+                        result.close()"],"additions":141,"deletions":1,"truncated":false}],"additions":346,"deletions":91,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-20T17:59:24.550601+00:00"}