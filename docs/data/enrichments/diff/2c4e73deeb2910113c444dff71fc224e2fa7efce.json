tall @sveltejs/adapter-auto in svelte.dev to get the types","-// @filename: ambient.d.ts","-declare module '@sveltejs/adapter-auto' {","-\tconst plugin: () => import('@sveltejs/kit').Adapter;","-\texport default plugin;","-}","-","-// @filename: index.js","-// ---cut---","-/// file: vite.config.js","-import adapter from '@sveltejs/adapter-auto';","-import { sveltekit } from '@sveltejs/kit/vite';","-import { defineConfig } from 'vite';","-","-export default defineConfig({","-\tplugins: [","-\t\tsveltekit({","-\t\t\tcompilerOptions: {","-\t\t\t\texperimental: {","-\t\t\t\t\tasync: true","-\t\t\t\t}","-\t\t\t},","-\t\t\tadapter: adapter(),","-\t\t\texperimental: {","-\t\t\t\tremoteFunctions: true","-\t\t\t}","-\t\t})","-\t]","-});","-```","-","-As well as SvelteKit, the plugin options are used by other tooling that integrates with Svelte such as editor extensions.","-","-Any options that don't belong to SvelteKit are passed through to [`vite-plugin-svelte`](https://github.com/sveltejs/vite-plugin-svelte/blob/main/docs/config.md), so you can set options like `inspector` here too. The `experimental` namespace is shared — SvelteKit reads its own flags and forwards the rest.","-","-> [!LEGACY]","-> Prior to SvelteKit 3, config lived in a `svelte.config.js` file, which is no longer supported. The ability to configure SvelteKit via `vite.config.js` was added in version 2.62.","-","-## KitConfig","-","-An extension of [`vite-plugin-svelte`'s options](https://github.com/sveltejs/vite-plugin-svelte/blob/main/docs/config.md#config-file).","-","-> EXPANDED_TYPES: Configuration#KitConfig"],"additions":0,"deletions":48,"truncated":false},{"path":"packages/adapter-cloudflare/index.js","lines":["@@ -18,24 +18,21 @@ export default function (options = {}) {"," \treturn {"," \t\tname,"," \t\tasync adapt(builder) {","-\t\t\tif (","-\t\t\t\texistsSync('_routes.json') ||","-\t\t\t\texistsSync(`${builder.config.kit.files.assets}/_routes.json`)","-\t\t\t) {","+\t\t\tif (existsSync('_routes.j