{"id":"890ab68b5b834ad41a1b25806ee1a63ba63f63e8","axis":"silent","repo":"microsoft/vscode","sha":"890ab68b5b834ad41a1b25806ee1a63ba63f63e8","parsed":{"files":[{"path":"extensions/esbuild-common.mts","lines":["@@ -128,7 +128,7 @@ async function watchWithParcel("," \t\t\t\trebuild();"," \t\t\t}"," \t\t}, {","-\t\t\tignore: [...ignore],","+\t\t\tignore: [...ignore, path.resolve(watchRoot, 'node_modules'), path.resolve(watchRoot, '.git')],"," \t\t});"," \t};"," \tawait Promise.all(["],"additions":1,"deletions":1,"truncated":false},{"path":"extensions/markdown-language-features/CONTRIBUTING.md","lines":["@@ -36,7 +36,22 @@ Build outputs are written to `out/` (desktop), `dist/` (web), and `notebook-out/"," "," 3. **Point the extension at your local package**"," ","-   **A. Use a `file:` dependency for a durable local setup**","+   **A. Override the webview build without changing installed dependencies**","+","+   Set `VSCODE_MARKDOWN_EDITOR_PATH` to the built local package directory in the shell running extension build/watch and manifest-generation commands:","+","+   ```powershell","+   $env:VSCODE_MARKDOWN_EDITOR_PATH = 'D:\\src\\vscode-packages\\vscode-team-tools\\packages\\markdown-editor'","+   npm run watch-markdown-editor","+   ```","+","+   This overrides esbuild resolution for the package and all its exported subpaths, including CSS. Command contribution generation uses the same package selection. The watcher follows the selected package directory, including built output and source assets, but excludes its `node_modules` and `.git` directories. The build prints the selected real directory as `Markdown editor package override: ...`; `node_modules` still contains the installed dependency. No symlink, dependency-manifest edit, or lockfile edit is needed. Relative paths resolve against the build process's working directory. Invalid overrides fail explicitly instead of falling back to the installed package. Unset the variable to use the installed dependency (`Remove-Item Env:VSCODE_MARKDOWN_EDITOR_PATH` in PowerShell).","+","+   This is a build-time override: standalone TypeScript checks and other tools still resolve types from the installed dependency. Use a dependency link instead if those tools must also consume unpublished local type changes. Generated command contributions may still update tracked manifests when the package's commands change.","+","+   Run the override regression tests with `node --test ./scripts/markdownEditorPackage.test.mts` from this extension directory.","+","+   **B. Use a `file:` dependency for a durable local setup**"," ","    Set the dependency in `extensions/markdown-language-features/package.json` to:"," ","@@ -46,7 +61,7 @@ Build outputs are written to `out/` (desktop), `dist/` (web), and `notebook-out/"," ","    Then run `npm install` in `extensions/markdown-language-features`. This updates `package.json` and `package-lock.json`, creates a local link, and survives later `npm install` runs. This is development-only; restore the dependency to a published version before submitting changes that should consume a release."," ","-   **B. Use `npm link` for a temporary setup**","+   **C. Use `npm link` for a temporary setup**"," ","    In `vscode-packages/vscode-team-tools/packages/markdown-editor`, run:"," "],"additions":17,"deletions":2,"truncated":false},{"path":"extensions/markdown-language-features/esbuild.markdownEditor.mts","lines":["@@ -6,7 +6,12 @@ import { stat } from 'node:fs/promises';"," import path from 'path';"," import { fileURLToPath } from 'url';"," import { run } from '../esbuild-webview-common.mts';","+import { markdownEditorOverridePlugin, resolveMarkdownEditorPackage } from './scripts/markdownEditorPackage.mts';"," ","+const editorPackage = await resolveMarkdownEditorPackage();","+if (editorPackage.directory) {","+\tconsole.log(`Markdown editor package override: ${editorPackage.directory}`);","+}"," const srcDir = path.join(import.meta.dirname, 'markdown-editor-src');"," const outDir = path.join(import.meta.dirname, 'markdown-editor-out');"," const updatePackageJsonModuleUrl = new URL('./scripts/updateMarkdownEditorPackageJson.mts', import.meta.url);","@@ -29,16 +34,17 @@ run({"," \tsrcDir,"," \toutdir: outDir,"," \tadditionalWatchPaths: [","-\t\tpath.dirname(fileURLToPath(import.meta.resolve('@vscode/markdown-editor/commands'))),","+\t\teditorPackage.directory ?? path.dirname(fileURLToPath(editorPackage.commandsUrl)),"," \t\tpath.dirname(fileURLToPath(import.meta.resolve('@vscode/web-editors'))),"," \t\tpath.dirname(fileURLToPath(import.meta.resolve('@vscode/hubrpc'))),"," \t\tupdatePackageJsonModulePath,","+\t\tfileURLToPath(new URL('./scripts/markdownEditorPackage.mts', import.meta.url)),"," \t\ttaskProgressBuildModulePath,"," \t\tmermaidBuildModulePath,"," \t],"," \tbeforeBuild: updateMarkdownEditorPackageJsonFile,"," \tadditionalOptions: {","-\t\tplugins: [{","+\t\tplugins: [...(editorPackage.directory ? [markdownEditorOverridePlugin(editorPackage.directory)] : []), {"," \t\t\tname: 'mermaid-html',"," \t\t\tsetup(build) {"," \t\t\t\tbuild.onLoad({ filter: /mermaid\\.html$/ }, async ({ path: htmlPath }) => {"],"additions":8,"deletions":2,"truncated":false},{"path":"extensions/markdown-language-features/scripts/markdownEditorPackage.mts","lines":["@@ -0,0 +1,58 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { readFile, realpath } from 'node:fs/promises';","+import { join, resolve } from 'node:path';","+import { pathToFileURL } from 'node:url';","+import esbuild from 'esbuild';","+","+export async function resolveMarkdownEditorPackage(): Promise<{ readonly directory?: string; readonly commandsUrl: string }> {","+\tconst override = process.env.VSCODE_MARKDOWN_EDITOR_PATH;","+\tif (override === undefined) {","+\t\treturn { commandsUrl: import.meta.resolve('@vscode/markdown-editor/commands') };","+\t}","+\tif (!override.trim()) {","+\t\tthrow new Error('VSCODE_MARKDOWN_EDITOR_PATH must be a nonempty package directory.');","+\t}","+\tconst directory = await realpath(resolve(override));","+\tconst manifest: unknown = JSON.parse(await readFile(join(directory, 'package.json'), 'utf8'));","+\tif (!manifest || typeof manifest !== 'object' || !('name' in manifest) || manifest.name !== '@vscode/markdown-editor') {","+\t\tthrow new Error(`Not a Markdown editor package: ${directory}`);","+\t}","+\tif (!('exports' in manifest) || !manifest.exports || typeof manifest.exports !== 'object' || Array.isArray(manifest.exports)) {","+\t\tthrow new Error(`Markdown editor package must declare exports for package self-reference: ${directory}`);","+\t}","+\tlet commands: esbuild.ResolveResult | undefined;","+\tawait esbuild.build({","+\t\tstdin: { contents: '' }, write: false, logLevel: 'silent',","+\t\tplugins: [{","+\t\t\tname: 'resolve-markdown-editor-commands',","+\t\t\tsetup(build) {","+\t\t\t\tbuild.onStart(async () => {","+\t\t\t\t\tcommands = await build.resolve('@vscode/markdown-editor/commands', { resolveDir: directory, kind: 'import-statement' });","+\t\t\t\t\treturn { errors: commands.errors, warnings: commands.warnings };","+\t\t\t\t});","+\t\t\t},","+\t\t}],","+\t});","+\tif (!commands?.path) {","+\t\tthrow new Error(`Cannot resolve the Markdown editor commands export from ${directory}. Build the package first.`);","+\t}","+\treturn { directory, commandsUrl: pathToFileURL(commands.path).href };","+}","+","+export function markdownEditorOverridePlugin(directory: string): esbuild.Plugin {","+\treturn {","+\t\tname: 'markdown-editor-package-override',","+\t\tsetup(build) {","+\t\t\tbuild.onResolve({ filter: /^@vscode\\/markdown-editor(?:\\/|$)/ }, args => {","+\t\t\t\tif (args.resolveDir === directory) {","+\t\t\t\t\treturn;","+\t\t\t\t}","+\t\t\t\treturn build.resolve(args.path, { resolveDir: directory, kind: args.kind });","+\t\t\t});","+\t\t},","+\t};","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"extensions/markdown-language-features/scripts/markdownEditorPackage.test.mts","lines":["@@ -0,0 +1,177 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import assert from 'node:assert/strict';","+import { execFile, spawn } from 'node:child_process';","+import { once } from 'node:events';","+import { copyFile, lstat, mkdir, mkdtemp, readFile, realpath, rm, writeFile } from 'node:fs/promises';","+import { join, relative } from 'node:path';","+import { test } from 'node:test';","+import { setTimeout as delay } from 'node:timers/promises';","+import { fileURLToPath, pathToFileURL } from 'node:url';","+import { promisify } from 'node:util';","+import esbuild from 'esbuild';","+import { markdownEditorOverridePlugin, resolveMarkdownEditorPackage } from './markdownEditorPackage.mts';","+","+test('Markdown editor package selection without dependency links', async t => {","+\tconst root = await mkdtemp(join(import.meta.dirname, 'markdown-package-override-'));","+\tconst previous = process.env.VSCODE_MARKDOWN_EDITOR_PATH;","+\ttry {","+\t\tawait t.test('uses the installed commands export by default', async () => {","+\t\t\tdelete process.env.VSCODE_MARKDOWN_EDITOR_PATH;","+\t\t\tassert.deepEqual(await resolveMarkdownEditorPackage(), {","+\t\t\t\tcommandsUrl: import.meta.resolve('@vscode/markdown-editor/commands'),","+\t\t\t});","+","+\t\t});","+","+\t\tconst generatorDirectory = join(root, 'generator');","+\t\tconst generatorScripts = join(generatorDirectory, 'scripts');","+\t\tawait mkdir(generatorScripts, { recursive: true });","+\t\tfor (const script of ['updateMarkdownEditorPackageJson.mts', 'markdownEditorPackage.mts']) {","+\t\t\tawait copyFile(join(import.meta.dirname, script), join(generatorScripts, script));","+\t\t}","+\t\tawait writeFile(join(generatorDirectory, 'package.json'), JSON.stringify({ contributes: {} }));","+\t\tawait writeFile(join(generatorDirectory, 'package.nls.json'), '{}');","+\t\tfor (const name of ['first', 'second']) {","+\t\t\tawait t.test(`selects ${name} for JavaScript, subpaths, CSS, and generated commands`, async () => {","+\t\t\t\tconst directory = join(root, `${name} package`);","+\t\t\t\tawait mkdir(join(directory, 'lib'), { recursive: true });","+\t\t\t\tawait mkdir(join(directory, 'styles'));","+\t\t\t\tawait writeFile(join(directory, 'package.json'), JSON.stringify({","+\t\t\t\t\tname: '@vscode/markdown-editor', type: 'module',","+\t\t\t\t\texports: {","+\t\t\t\t\t\t'.': { import: './lib/index.js' },","+\t\t\t\t\t\t'./commands': { import: './lib/actions.js' },","+\t\t\t\t\t\t'./value': './lib/value.js',","+\t\t\t\t\t\t'./theme.css': './styles/theme.css',","+\t\t\t\t\t\t'./base.css': './styles/base.css',","+\t\t\t\t\t},","+\t\t\t\t}));","+\t\t\t\tawait writeFile(join(directory, 'lib', 'index.js'), `export { source } from '@vscode/markdown-editor/value';`);","+\t\t\t\tawait writeFile(join(directory, 'lib', 'value.js'), `export const source = '${name}';`);","+\t\t\t\tawait writeFile(join(directory, 'lib', 'actions.js'), `export const commands = [{ id: 'markdown.editor.${name}', title: '${name}', keybindings: [], action: { kind: 'cursor', command: 'left', extend: false } }];`);","+\t\t\t\tawait writeFile(join(directory, 'styles', 'theme.css'), `@import '@vscode/markdown-editor/base.css'; body { --selected-package: ${name}; }`);","+\t\t\t\tawait writeFile(join(directory, 'styles', 'base.css'), `body { --base-package: ${name}; }`);","+\t\t\t\tprocess.env.VSCODE_MARKDOWN_EDITOR_PATH = relative(process.cwd(), directory);","+\t\t\t\tconst selected = await resolveMarkdownEditorPackage();","+\t\t\t\tassert.deepEqual(selected, {","+\t\t\t\t\tdirectory: await realpath(directory),","+\t\t\t\t\tcommandsUrl: pathToFileURL(join(await realpath(directory), 'lib', 'actions.js')).href,","+\t\t\t\t});","+\t\t\t\tassert.equal((await lstat(directory)).isSymbolicLink(), false);","+\t\t\t\tassert.equal(fileURLToPath(selected.commandsUrl), join(selected.directory!, 'lib', 'actions.js'));","+\t\t\t\tconst build = await esbuild.build({","+\t\t\t\t\tstdin: { contents: `export { source } from '@vscode/markdown-editor'; import '@vscode/markdown-editor/theme.css';`, resolveDir: root },","+\t\t\t\t\toutfile: join(root, 'bundle.js'), bundle: true, write: false, format: 'esm',","+\t\t\t\t\tplugins: [markdownEditorOverridePlugin(selected.directory!)],","+\t\t\t\t});","+\t\t\t\tconst js = build.outputFiles.find(file => file.path.endsWith('.js'))!.text;","+\t\t\t\tconst css = build.outputFiles.find(file => file.path.endsWith('.css'))!.text;","+\t\t\t\tassert.equal((await import(`data:text/javascript;base64,${Buffer.from(js).toString('base64')}`)).source, name);","+\t\t\t\tassert.match(css, new RegExp(`--selected-package: ${name}`));","+\t\t\t\tassert.match(css, new RegExp(`--base-package: ${name}`));","+\t\t\t\tawait assert.rejects(esbuild.build({","+\t\t\t\t\tstdin: { contents: `import '@vscode/markdown-editor/not-exported';`, resolveDir: root },","+\t\t\t\t\tbundle: true, write: false, logLevel: 'silent',","+\t\t\t\t\tplugins: [markdownEditorOverridePlugin(selected.directory!)],","+\t\t\t\t}), /Could not resolve/);","+","+\t\t\t\tawait promisify(execFile)(process.execPath, [join(generatorScripts, 'updateMarkdownEditorPackageJson.mts'), '--write'], { timeout: 30_000 });","+\t\t\t\tconst manifest = JSON.parse(await readFile(join(generatorDirectory, 'package.json'), 'utf8'));","+\t\t\t\tconst titles = JSON.parse(await readFile(join(generatorDirectory, 'package.nls.json'), 'utf8'));","+\t\t\t\tassert.deepEqual({","+\t\t\t\t\tcommands: manifest.contributes.commands.map((command: { command: string }) => command.command),","+\t\t\t\t\ttitle: titles[`markdown.editor.${name}.title`].message,","+\t\t\t\t}, {","+\t\t\t\t\tcommands: [`markdown.editor.${name}`],","+\t\t\t\t\ttitle: name,","+\t\t\t\t});","+\t\t\t});","+\t\t}","+","+\t\tawait t.test('rejects invalid explicit selections instead of using the installed package', async () => {","+\t\t\tfor (const value of ['', '   ']) {","+\t\t\t\tprocess.env.VSCODE_MARKDOWN_EDITOR_PATH = value;","+\t\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /nonempty/);","+\t\t\t}","+\t\t\tprocess.env.VSCODE_MARKDOWN_EDITOR_PATH = join(root, 'missing');","+\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /ENOENT/);","+\t\t\tprocess.env.VSCODE_MARKDOWN_EDITOR_PATH = join(root, 'generator', 'package.json');","+\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /ENOTDIR|ENOENT/);","+\t\t\tprocess.env.VSCODE_MARKDOWN_EDITOR_PATH = root;","+\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /ENOENT/);","+\t\t\tawait writeFile(join(root, 'package.json'), '{');","+\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), SyntaxError);","+\t\t\tawait writeFile(join(root, 'package.json'), JSON.stringify({ name: 'other-package' }));","+\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /Not a Markdown editor package/);","+\t\t\tfor (const exports of [undefined, null, [], './index.js']) {","+\t\t\t\tawait writeFile(join(root, 'package.json'), JSON.stringify({ name: '@vscode/markdown-editor', exports }));","+\t\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /must declare exports/);","+\t\t\t}","+\t\t\tfor (const exports of [{ '.': './index.js' }, { './commands': './missing.js' }, { './commands': '../outside.js' }]) {","+\t\t\t\tawait writeFile(join(root, 'package.json'), JSON.stringify({ name: '@vscode/markdown-editor', exports }));","+\t\t\t\tawait assert.rejects(resolveMarkdownEditorPackage(), /Could not resolve/);","+\t\t\t}","+\t\t});","+\t} finally {","+\t\tif (previous === undefined) {","+\t\t\tdelete process.env.VSCODE_MARKDOWN_EDITOR_PATH;","+\t\t} else {","+\t\t\tprocess.env.VSCODE_MARKDOWN_EDITOR_PATH = previous;","+\t\t}","+\t\tawait rm(root, { recursive: true, force: true });","+\t}","+});","+","+test('package watching includes exported assets but excludes nested dependencies and Git metadata', async () => {","+\tconst root = await mkdtemp(join(import.meta.dirname, 'markdown-package-watch-'));","+\tconst srcDir = join(root, 'src');","+\tconst directory = join(root, 'node_modules', 'editor');","+\tawait mkdir(srcDir);","+\tawait mkdir(join(directory, 'node_modules', 'dependency'), { recursive: true });","+\tawait mkdir(join(directory, '.git'));","+\tawait mkdir(join(directory, 'styles'));","+\tconst entry = join(srcDir, 'entry.js');","+\tawait writeFile(entry, 'export const value = 1;');","+\tconst runner = new URL('../../esbuild-common.mts', import.meta.url).href;","+\tconst child = spawn(process.execPath, ['--input-type=module', '-e',","+\t\t`import { runBuild } from ${JSON.stringify(runner)};","+\t\tawait runBuild(${JSON.stringify({ srcDir, outdir: join(root, 'out'), entryPoints: [entry], additionalWatchPaths: [directory] })},","+\t\t\t{}, ['--watch'], () => console.log('BUILT'));`,","+\t], { stdio: ['ignore', 'pipe', 'pipe'] });","+\tconst exited = once(child, 'exit');","+\tlet stdout = '';","+\tlet stderr = '';","+\tchild.stdout.on('data', data => { stdout += data; });","+\tchild.stderr.on('data', data => { stderr += data; });","+\tconst builds = () => stdout.split('BUILT').length - 1;","+\tasync function waitForBuild(count: number) {","+\t\tconst deadline = Date.now() + 15_000;","+\t\twhile (builds() < count) {","+\t\t\tassert.equal(child.exitCode, null, stderr);","+\t\t\tassert.ok(Date.now() < deadline, stdout + stderr);","+\t\t\tawait delay(50);","+\t\t}","+\t}","+\ttry {","+\t\tawait waitForBuild(1);","+\t\tawait writeFile(join(directory, 'node_modules', 'dependency', 'index.js'), 'dependency changed');","+\t\tawait writeFile(join(directory, '.git', 'index'), 'metadata changed');","+\t\tawait delay(600);","+\t\tassert.equal(builds(), 1);","+\t\tawait writeFile(join(directory, 'styles', 'theme.css'), 'body { color: red; }');","+\t\tawait waitForBuild(2);","+\t\tawait writeFile(join(directory, 'commands.js'), 'export const commands = [];');","+\t\tawait waitForBuild(3);","+\t\tassert.equal(builds(), 3);","+\t} finally {","+\t\tif (child.exitCode === null && child.signalCode === null) {","+\t\t\tchild.kill();","+\t\t}","+\t\tawait exited;","+\t\tawait rm(root, { recursive: true, force: true });","+\t}","+});"],"additions":177,"deletions":0,"truncated":false},{"path":"extensions/markdown-language-features/scripts/updateMarkdownEditorPackageJson.mts","lines":["@@ -6,6 +6,7 @@"," import { readFile, stat, writeFile } from 'node:fs/promises';"," import { fileURLToPath } from 'node:url';"," import * as path from 'node:path';","+import { resolveMarkdownEditorPackage } from './markdownEditorPackage.mts';"," import type {"," \tEditorCommandDefinition,"," \tEditorCommandKeybinding,","@@ -330,7 +331,7 @@ export function debounceAsync<T>(callback: () => Promise<T>, delay: number): ()"," }"," "," async function loadCommandDefinitions(): Promise<readonly EditorCommandDefinition[]> {","-\tconst commandsUrl = import.meta.resolve('@vscode/markdown-editor/commands');","+\tconst { commandsUrl } = await resolveMarkdownEditorPackage();"," \tconst commandsPath = fileURLToPath(commandsUrl);"," \tconst version = (await stat(commandsPath)).mtimeMs;"," \tconst module = await import(`${commandsUrl}?version=${version}`) as {",""],"additions":2,"deletions":1,"truncated":false}],"additions":263,"deletions":6,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-23T14:14:32.284761+00:00"}