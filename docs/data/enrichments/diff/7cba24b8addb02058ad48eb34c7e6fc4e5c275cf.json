    - \".github/workflows/check-sbom.yml\"","+      - \"sbom.json\"","+      - \"src/libmongoc\"","+      - \"src/libmongocrypt\"","+","+jobs:","+  check-sbom:","+    name: \"Check SBOM component versions\"","+    runs-on: \"ubuntu-24.04\"","+","+    steps:","+      - name: \"Checkout\"","+        uses: \"actions/checkout@v7\"","+        with:","+          # The purls are derived from version files inside the submodules","+          submodules: true","+","+      # silkbomb percent-encodes the version segment, so a git-describe version such as","+      # 1.10.1-20260825+git048fa8ef67 is stored as ...%2Bgit048fa8ef67. Decode before comparing.","+      - name: \"Check SBOM purls against bundled dependency versions\"","+        run: |","+          ./scripts/generate-purls.sh | sort > expected-purls.txt","+          jq -r '.components[].purl' sbom.json |","+            python3 -c 'import sys, urllib.parse; sys.stdout.writelines(urllib.parse.unquote(line) for line in sys.stdin)' |","+            sort > actual-purls.txt","+          if ! diff --unified expected-purls.txt actual-purls.txt; then","+            echo \"::error::sbom.json is out of date; run ./scripts/update-sbom.sh\"","+            exit 1","+          fi"],"additions":46,"deletions":0,"truncated":false},{"path":".github/workflows/tests.yml","lines":["@@ -187,7 +187,7 @@ jobs:","       # Note: omit the patch version so apt prefix-matches any 1.x.y patch release","       LIBMONGOCRYPT_VERSION: \"1.20\"","       # Note: include the patch version when referring to a libmongoc release tarball","-      LIBMONGOC_VERSION: \"2.4.0\"","+      LIBMONGOC_VERSION: \"2.5.0\"","       SERVER_VERSION: \"8.0\""," ","     steps:"],"additions":1,"deletions":1,"truncated":false},{"path":"config.m4","lines":["@@ -243,9 +243,9 @@ if test \"$PHP_MONGODB\" != \"no\"; then","   PHP_MONGODB_MONGOCRYPT_VERSION_STRING=\"None\""," ","   if test \"$PHP_MONGODB_SYSTEM_LIBS\" != \"no\"; then","-    PHP_MONGODB_MIN_LIBBSON_VERSION=\"2.4.0\""