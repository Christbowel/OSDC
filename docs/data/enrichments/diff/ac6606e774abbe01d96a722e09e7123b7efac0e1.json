.helix.HelixManager;","+import org.apache.pinot.common.config.DefaultClusterConfigChangeHandler;","+import org.apache.pinot.common.evaluator.GroovyFunctionEvaluator;","+import org.apache.pinot.spi.config.provider.PinotClusterConfigChangeListener;","+import org.apache.pinot.spi.utils.CommonConstants.Groovy;","+","+","+/// Applies the cluster ingestion Groovy policy in server and minion processes.","+///","+/// Missing, removed, and invalid values disable new ingestion compilation; only `false` enables it. Query Groovy","+/// and previously compiled scripts retain their own behavior. Thread-safe: updates publish through a volatile flag.","+public class IngestionGroovyConfigListener implements PinotClusterConfigChangeListener {","+  @Override","+  public void onChange(Set<String> changedConfigs, Map<String, String> clusterConfigs) {","+    applyClusterConfig(clusterConfigs);","+  }","+","+  /// Applies a raw cluster snapshot before a server or minion starts ingestion or query processing.","+  public static void applyClusterConfig(Map<String, String> clusterConfigs) {","+    GroovyFunctionEvaluator.setIngestionGroovyDisabled(","+        Groovy.isIngestionGroovyDisabled(clusterConfigs.get(Groovy.INGESTION_GROOVY_DISABLED)));","+  }","+","+  /// Subscribes a runtime role to cluster updates. On failure, disables ingestion compilation, disconnects the","+  /// participant, and releases initialized role resources before failing startup with the original cause.","+  public static void subscribeToClusterConfig(HelixManager helixManager, DefaultClusterConfigChangeHandler handler,","+      Runnable... failureCleanup) {","+    handler.subscribe(helixManager, () -> applyClusterConfig(Map.of()), failureCleanup);","+  }","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"pinot-common/src/test/java/org/apache/pinot/common/utils/config/IngestionGroovyConfigListenerTest.java","lines":["@@ -0,0 +1,215 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.pinot.common.utils.config;","+","+import java.util.Map;","+import java.util.concurrent.ExecutorService;","+import org.apache.helix.HelixManager;","+import org.apache.helix.NotificationContext;","+import org.apache.helix.model.ClusterConfig;","+import org.apache.helix.zookeeper.datamodel.ZNRecord;","+import org.apache.helix.zookeeper.datamodel.serializer.ZNRecordSerializer;","+import org.apache.helix.zookeeper.impl.client.ZkClient;","+import org.apache.pinot.common.config.DefaultClusterConfigChangeHandler;","+import org.apache.pinot.common.evaluator.GroovyFunctionEvaluator;","+import org.apache.pinot.common.utils.ServiceStartableUtils;","+import org.apache.pinot.common.utils.ZkStarter;","+import org.apache.pinot.spi.env.PinotConfiguration;","+import org.apache.pinot.spi.services.ServiceRole;","+import org.apache.pinot.spi.utils.CommonConstants.Groovy;","+import org.testng.annotations.AfterMethod;","+import org.testng.annotations.Test;","+","+import static org.mockito.Mockito.doAnswer;","+import static org.mockito.Mockito.doThrow;","+import static org.mockito.Mockito.mock;","+import static org.mockito.Mockito.never;","+import static org.mockito.Mockito.verify;","+import static org.mockito.Mockito.verifyNoInteractions;","+import static org.testng.Assert.assertEquals;","+import static org.testng.Assert.assertSame;","+import static org.testng.Assert.expectThrows;","+","+","+/// Verifies startup and live cluster snapshots against the actual Groovy compiler gate.","+/// Not thread-safe because the compiler switch is process-wide.","+@Test(singleThreaded = true)","+public class IngestionGroovyConfigListenerTest {","+  private static final String KEY = Groovy.INGESTION_GROOVY_DISABLED;","+  private static final String EXPRESSION = \"Groovy({value + 1}, value)\";","+","+  @AfterMethod(alwaysRun = true)","+  public void restoreCompilation() {","+    GroovyFunctionEvaluator.setIngestionGroovyDisabled(false);","+  }","+","+  @Test","+  public void testLiveUpdatesAndRemoval() {","+    DefaultClusterConfigChangeHandler handler = new DefaultClusterConfigChangeHandler();","+    handler.registerClusterConfigChangeListener(new IngestionGroovyConfigListener());","+    expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+    assertEquals(GroovyFunctionEvaluator.forQuery(EXPRESSION).evaluate(new Object[]{1}), 2);","+","+    ClusterConfig config = new ClusterConfig(\"test\");","+    config.getRecord().setSimpleField(Groovy.DISABLE_INGESTION_GROOVY, \"true\");","+    config.getRecord().setSimpleField(KEY, \" false \");","+    handler.onClusterConfigChange(config, null);","+    assertEquals(new GroovyFunctionEvaluator(EXPRESSION).evaluate(new Object[]{1}), 2);","+","+    config.getRecord().setSimpleField(Groovy.DISABLE_INGESTION_GROOVY, \"false\");","+    config.getRecord().setSimpleField(KEY, \"true\");","+    handler.onClusterConfigChange(config, null);","+    expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+","+    config.getRecord().setSimpleField(KEY, \"false\");","+    handler.onClusterConfigChange(config, null);","+    config.getRecord().getSimpleFields().remove(KEY);","+    handler.onClusterConfigChange(config, null);","+    expectThrows(IllegalStateException.class, () -> GroovyFunctionEvaluator.parseGroovyScript(EXPRESSION));","+  }","+","+  @Test","+  public void testFirstEmptySnapshotAndInvalidValueDisableCompilation() {","+    DefaultClusterConfigChangeHandler handler = new DefaultClusterConfigChangeHandler();","+    handler.registerClusterConfigChangeListener(new IngestionGroovyConfigListener());","+    // The startup read enabled compilation, but the key was deleted before the first Helix callback.","+    IngestionGroovyConfigListener.applyClusterConfig(Map.of(KEY, \"false\"));","+    handler.onClusterConfigChange(new ClusterConfig(\"test\"), null);","+    expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+","+    IngestionGroovyConfigListener.applyClusterConfig(Map.of(KEY, \"false\"));","+    IngestionGroovyConfigListener.applyClusterConfig(Map.of(KEY, \"invalid\", Groovy.DISABLE_INGESTION_GROOVY, \"false\"));","+    expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+  }","+","+  @Test","+  public void testSubscriptionFailureDisablesCompilationAndCleansUpRuntimeRoles()","+      throws Exception {","+    for (boolean server : new boolean[]{false, true}) {","+      HelixManager manager = mock(HelixManager.class);","+      DefaultClusterConfigChangeHandler handler = new DefaultClusterConfigChangeHandler();","+      Exception registrationFailure = new Exception(\"Subscription failed\");","+      doThrow(registrationFailure).when(manager).addClusterfigChangeListener(handler);","+      ExecutorService executor = mock(ExecutorService.class);","+      RuntimeException cleanupFailure = new RuntimeException(\"Executor cleanup failed\");","+      doThrow(cleanupFailure).when(executor).shutdownNow();","+      Runnable serverCleanup = mock(Runnable.class);","+      Runnable[] cleanup = server","+          ? new Runnable[]{executor::shutdownNow, serverCleanup}","+          : new Runnable[]{executor::shutdownNow};","+      GroovyFunctionEvaluator.setIngestionGroovyDisabled(false);","+","+      IllegalStateException failure = expectThrows(IllegalStateException.class,","+          () -> IngestionGroovyConfigListener.subscribeToClusterConfig(manager, handler, cleanup));","+      assertSame(failure.getCause(), registrationFailure);","+      assertEquals(registrationFailure.getSuppressed().length, 1);","+      assertSame(registrationFailure.getSuppressed()[0], cleanupFailure);","+      expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+      verify(manager).disconnect();","+      verify(executor).shutdownNow();","+      if (server) {","+        verify(serverCleanup).run();","+      } else {","+        verifyNoInteractions(serverCleanup);","+      }","+    }","+  }","+","+  @Test","+  public void testSuccessfulSubscriptionAppliesInitialPolicy()","+      throws Exception {","+    HelixManager manager = mock(HelixManager.class);","+    DefaultClusterConfigChangeHandler handler = new DefaultClusterConfigChangeHandler();","+    handler.registerClusterConfigChangeListener(new IngestionGroovyConfigListener());","+    // An empty initial snapshot must replace an enabled startup snapshot.","+    IngestionGroovyConfigListener.applyClusterConfig(Map.of(KEY, \"false\"));","+    NotificationContext context = new NotificationContext(manager);","+    context.setType(NotificationContext.Type.INIT);","+    doAnswer(invocation -> {","+      handler.onClusterConfigChange(new ClusterConfig(\"test\"), context);","+      return null;","+    }).when(manager).addClusterfigChangeListener(handler);","+    Runnable cleanup = mock(Runnable.class);","+","+    IngestionGroovyConfigListener.subscribeToClusterConfig(manager, handler, cleanup);","+","+    expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+    verify(manager, never()).disconnect();","+    verifyNoInteractions(cleanup);","+  }","+","+  @Test","+  public void testSubscriptionWithoutInitialCallbackFailsClosed() {","+    HelixManager manager = mock(HelixManager.class);","+    DefaultClusterConfigChangeHandler handler = new DefaultClusterConfigChangeHandler();","+    handler.registerClusterConfigChangeListener(new IngestionGroovyConfigListener());","+    IngestionGroovyConfigListener.applyClusterConfig(Map.of(KEY, \"false\"));","+    ClusterConfig enabled = new ClusterConfig(\"test\");","+    enabled.getRecord().setSimpleField(KEY, \"false\");","+    NotificationContext context = new NotificationContext(manager);","+    context.setType(NotificationContext.Type.FINALIZE);","+    doAnswer(invocation -> {","+      handler.onClusterConfigChange(enabled, context);","+      return null;","+    }).when(manager).disconnect();","+    Runnable cleanup = mock(Runnable.class);","+","+    IllegalStateException failure = expectThrows(IllegalStateException.class,","+        () -> IngestionGroovyConfigListener.subscribeToClusterConfig(manager, handler, cleanup));","+","+    assertEquals(failure.getCause().getMessage(), \"Helix did not deliver the initial cluster config\");","+    expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+    verify(manager).disconnect();","+    verify(cleanup).run();","+  }","+","+  @Test","+  public void testStartupUsesRawClusterConfigOnlyForRuntimeRoles() {","+    ZkStarter.ZookeeperInstance zk = ZkStarter.startLocalZkServer();","+    ZkClient client = new ZkClient.Builder().setZkServer(zk.getZkUrl())","+        .setZkSerializer(new ZNRecordSerializer()).build();","+    try {","+      String cluster = \"groovy-policy-test\";","+      String path = \"/\" + cluster + \"/CONFIGS/CLUSTER/\" + cluster;","+      client.createPersistent(path, true);","+      ZNRecord record = new ZNRecord(cluster);","+      record.setSimpleField(KEY, \"false\");","+      client.writeData(path, record);","+      PinotConfiguration instance = new PinotConfiguration(Map.of(KEY, \"true\"));","+      ServiceStartableUtils.applyClusterConfig(instance, zk.getZkUrl(), cluster, ServiceRole.SERVER);","+      assertEquals(new GroovyFunctionEvaluator(EXPRESSION).evaluate(new Object[]{1}), 2);","+","+      record.getSimpleFields().remove(KEY);","+      record.setSimpleField(Groovy.DISABLE_INGESTION_GROOVY, \"false\");","+      client.writeData(path, record);","+      instance.setProperty(KEY, \"false\");","+      ServiceStartableUtils.applyClusterConfig(instance, zk.getZkUrl(), cluster, ServiceRole.MINION);","+      expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+","+      GroovyFunctionEvaluator.setIngestionGroovyDisabled(false);","+      ServiceStartableUtils.applyClusterConfig(instance, zk.getZkUrl(), cluster, ServiceRole.CONTROLLER);","+      assertEquals(new GroovyFunctionEvaluator(EXPRESSION).evaluate(new Object[]{1}), 2);","+      ServiceStartableUtils.applyClusterConfig(instance, zk.getZkUrl(), \"missing-cluster\", ServiceRole.SERVER);","+      expectThrows(IllegalStateException.class, () -> new GroovyFunctionEvaluator(EXPRESSION));","+    } finally {","+      client.close();","+      ZkStarter.stopLocalZkServer(zk);","+    }","+  }","+}"],"additions":215,"deletions":0,"truncated":false},{"path":"pinot-controller/src/main/java/org/apache/pinot/controller/BaseControllerStarter.java","lines":["@@ -249,8 +249,7 @@ public void init(PinotConfiguration pinotConfiguration)","     _config = new ControllerConf(pinotConfiguration.toMap());","     _clusterConfigChangeHandler = new DefaultClusterConfigChangeHandler();","     _clusterConfigChangeHandler.registerClusterConfigChangeListener((changedConfigs, clusterConfigs) -> {","-      boolean disabled =","-          CommonConstants.Groovy.isIngestionGroovyDisabled(clusterConfigs.get(ControllerConf.DISABLE_GROOVY));","+      boolean disabled = CommonConstants.Groovy.isControllerIngestionGroovyDisabled(clusterConfigs)