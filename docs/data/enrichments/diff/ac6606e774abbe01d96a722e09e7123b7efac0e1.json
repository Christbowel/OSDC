ng disconnect, from overwriting fail-closed cleanup.","+        _subscriptionFailed = true;","+      }","+      runCleanup(beforeDisconnect, e);","+      runCleanup(manager::disconnect, e);","+      for (Runnable cleanup : failureCleanup) {","+        runCleanup(cleanup, e);","+      }","+      throw new IllegalStateException(\"Failed to subscribe to cluster config\", e);","+    }","+  }","+","+  private static void runCleanup(Runnable cleanup, Exception cause) {","+    try {","+      cleanup.run();","+    } catch (RuntimeException e) {","+      ExceptionUtils.suppress(e, cause);","+    }","+  }","+","   @Override","   public synchronized void onClusterConfigChange(ClusterConfig clusterConfig, NotificationContext context) {","+    if (_subscriptionFailed) {","+      return;","+    }","     Map<String, String> clusterConfigs = copyWithoutNullValues(clusterConfig.getRecord().getSimpleFields());","     Set<String> changedConfigs = getChangedProperties(_clusterConfigs, clusterConfigs);","     LOGGER.info(\"Cluster configs changed: {}\", changedConfigs);","@@ -50,6 +87,9 @@ public synchronized void onClusterConfigChange(ClusterConfig clusterConfig, Noti","     for (PinotClusterConfigChangeListener listener : _listeners) {","       listener.onChange(changedConfigs, clusterConfigs);","     }","+    if (context != null && context.getType() == NotificationContext.Type.INIT) {","+      _initialSnapshotApplied = true;","+    }","   }"," ","   @Override"],"additions":40,"deletions":0,"truncated":false},{"path":"pinot-common/src/main/java/org/apache/pinot/common/utils/ServiceStartableUtils.java","lines":["@@ -26,6 +26,7 @@"," import org.apache.helix.zookeeper.datamodel.ZNRecord;"," import org.apache.helix.zookeeper.datamodel.serializer.ZNRecordSerializer;"," import org.apache.helix.zookeeper.impl.client.ZkClient;","+import org.apache.pinot.common.utils.config.IngestionGroovyConfigListener;"," import org.apache.pinot.common.utils.request.RequestUtils;"," import org.apache.pinot.c