 without a truncate pipe,","+\t// or return empty string if the template is exhausted or malformed.","+\tfor {","+\t\tstart := strings.Index(tpl, \"{{\")","+\t\tif start == -1 {","+\t\t\treturn \"\"","+\t\t}","+\t\trest := tpl[start+2:]","+\t\tend := strings.Index(rest, \"}}\")","+\t\tif end == -1 {","+\t\t\treturn \"\"","+\t\t}","+\t\taction := strings.TrimSpace(rest[:end])","+\t\ttpl = rest[end+2:]","+","+\t\tif strings.HasPrefix(action, \"/*\") {","+\t\t\tcontinue","+\t\t}","+\t\tif !strings.Contains(action, \".DisplayName\") {","+\t\t\tcontinue","+\t\t}","+\t\tif !reTruncatePipe.MatchString(action) {","+\t\t\treturn displayNameTruncateWarning","+\t\t}","+\t}","+}","+"," // DatabaseConfig is used by the Factory function to configure a Database"," // object."," type DatabaseConfig struct {"],"additions":57,"deletions":0,"truncated":false},{"path":"builtin/logical/database/path_config_connection_ce.go","lines":["@@ -226,6 +226,12 @@ func (b *databaseBackend) connectionWriteHandler() framework.OperationFunc {"," \t\t\t}"," \t\t}"," ","+\t\t// Warn if a custom username_template references untrusted DisplayName","+\t\t// without bounding its length via truncate.","+\t\tif w := displayNameTemplateWarning(config.ConnectionDetails); w != \"\" {","+\t\t\tresp.AddWarning(w)","+\t\t}","+"," \t\t// If using a legacy DB plugin and set the `password_policy` field, send a warning to the user indicating"," \t\t// the `password_policy` will not be used"," \t\tif dbw.isV4() && config.PasswordPolicy != \"\" {","@@ -367,6 +373,11 @@ func (b *databaseBackend) connectionReadHandler() framework.OperationFunc {"," \t\tdelete(config.ConnectionDetails, \"service_account_json\")"," "," \t\tresp := &logical.Response{}","+","+\t\t// Warn if a username_template references untrusted DisplayName without bounding its length via truncate.","+\t\tif w := displayNameTemplateWarning(config.ConnectionDetails); w != \"\" {","+\t\t\tresp.AddWarning(w)","+\t\t}"," \t\tif dbi, err := b.GetConnectionSkipV