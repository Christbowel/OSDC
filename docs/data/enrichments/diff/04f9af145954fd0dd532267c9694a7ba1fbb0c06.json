g","+\t}{","+\t\t\"empty\": {","+\t\t\tinput: \"\",","+\t\t\twant:  \"\",","+\t\t},","+\t\t\"plain alphanumeric is unchanged\": {","+\t\t\tinput: \"alice42\",","+\t\t\twant:  \"alice42\",","+\t\t},","+\t\t\"hyphen and underscore are preserved\": {","+\t\t\tinput: \"alice-bob_carol\",","+\t\t\twant:  \"alice-bob_carol\",","+\t\t},","+\t\t\"spaces become hyphens\": {","+\t\t\tinput: \"alice bob\",","+\t\t\twant:  \"alice-bob\",","+\t\t},","+\t\t\"single quote becomes hyphen\": {","+\t\t\tinput: \"o'brien\",","+\t\t\twant:  \"o-brien\",","+\t\t},","+\t\t\"semicolon and quotes are neutralized\": {","+\t\t\tinput: `a';DROP`,","+\t\t\twant:  \"a--DROP\",","+\t\t},","+\t\t\"plpgsql injection payload is fully neutralized\": {","+\t\t\tinput: `x'; DO $$ BEGIN END $$;--`,","+\t\t\twant:  \"x---DO----BEGIN-END------\",","+\t\t},","+\t\t\"newline and tab become hyphens\": {","+\t\t\tinput: \"a\\nb\\tc\",","+\t\t\twant:  \"a-b-c\",","+\t\t},","+\t\t\"non-ascii is replaced\": {","+\t\t\tinput: \"naïve\",","+\t\t\twant:  \"na-ve\",","+\t\t},","+","+\t\t\"mysql @@version becomes --version\": {","+\t\t\tinput: \"@@version\",","+\t\t\twant:  \"--version\",","+\t\t},","+","+\t\t\"mysql backtick identifier\": {","+\t\t\tinput: \"`users`\",","+\t\t\twant:  \"-users-\",","+\t\t},","+","+\t\t\"mysql comment injection\": {","+\t\t\tinput: \"admin`-- \",","+\t\t\twant:  \"admin----\",","+\t\t},","+","+\t\t\"mssql xp_cmdshell is unchanged\": {","+\t\t\tinput: \"xp_cmdshell\",","+\t\t\twant:  \"xp_cmdshell\",","+\t\t},","+","+\t\t\"mssql square bracket delimiters\": {","+\t\t\tinput: \"[dbo].[users]\",","+\t\t\twant:  \"-dbo---users-\",","+\t\t},","+","+\t\t\"mssql variable @@SERVERNAME\": {","+\t\t\tinput: \"@@SERVERNAME\",","+\t\t\twant:  \"--SERVERNAME\",","+\t\t},","+","+\t\t\"300-char null bytes all become hyphens\": {","+\t\t\tinput: string(make([]byte, 300)), // 300 null bytes — all outside allowlist","+\t\t\twant: func() string {","+\t\t\t\tb := make([]byte, 300)","+\t\t\t\tfor i := r