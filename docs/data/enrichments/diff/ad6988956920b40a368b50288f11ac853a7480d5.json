{"id":"ad6988956920b40a368b50288f11ac853a7480d5","axis":"silent","repo":"supabase/supabase","sha":"ad6988956920b40a368b50288f11ac853a7480d5","parsed":{"files":[{"path":"apps/studio/components/interfaces/Auth/AuthProvidersForm/AuthProvidersForm.types.ts","lines":["@@ -14,7 +14,7 @@ export interface Provider {","   properties: {","     [x: string]: {","       title: string","-      type: 'boolean' | 'string' | 'select' | 'number'","+      type: 'boolean' | 'string' | 'select' | 'number' | 'comma-separated-list'","       enum: Enum[]","       show: {","         key: string"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/studio/components/interfaces/Auth/AuthProvidersForm/CommaSeparatedListInput.test.tsx","lines":["@@ -0,0 +1,67 @@","+import { render, screen } from '@testing-library/react'","+import userEvent from '@testing-library/user-event'","+import { useState } from 'react'","+import { describe, expect, test } from 'vitest'","+","+import { CommaSeparatedListInput } from './CommaSeparatedListInput'","+","+const CLIENT_IDS = 'web-1.com,android-2.com,chrome-3.com'","+","+const Harness = ({ readOnly }: { readOnly?: boolean }) => {","+  const [value, setValue] = useState(CLIENT_IDS)","+  return (","+    <CommaSeparatedListInput","+      aria-label=\"Client IDs\"","+      value={value}","+      readOnly={readOnly}","+      onChange={(event) => setValue(event.target.value)}","+    />","+  )","+}","+","+describe('CommaSeparatedListInput', () => {","+  test('shows one item per line, read-only, when not focused', () => {","+    render(<Harness />)","+","+    const textbox = screen.getByRole('textbox', { name: 'Client IDs' })","+    expect(textbox).toHaveValue('web-1.com\\nandroid-2.com\\nchrome-3.com')","+    expect(textbox).toHaveAttribute('readonly')","+  })","+","+  test('shows the original comma-separated string, editable, when focused', async () => {","+    const user = userEvent.setup()","+    render(<Harness />)","+","+    const textbox = screen.getByRole('textbox', { name: 'Client IDs' })","+    await user.click(textbox)","+","+    expect(textbox).toHaveValue(CLIENT_IDS)","+    expect(textbox).not.toHaveAttribute('readonly')","+  })","+","+  test('keeps the edited value comma-separated and goes back to lines on blur', async () => {","+    const user = userEvent.setup()","+    render(<Harness />)","+","+    const textbox = screen.getByRole('textbox', { name: 'Client IDs' })","+    await user.click(textbox)","+    await user.clear(textbox)","+    await user.paste('a.com,b.com')","+    expect(textbox).toHaveValue('a.com,b.com')","+","+    await user.tab()","+    expect(textbox).toHaveValue('a.com\\nb.com')","+    expect(textbox).toHaveAttribute('readonly')","+  })","+","+  test('never becomes editable when the field is read-only', async () => {","+    const user = userEvent.setup()","+    render(<Harness readOnly />)","+","+    const textbox = screen.getByRole('textbox', { name: 'Client IDs' })","+    await user.click(textbox)","+","+    expect(textbox).toHaveValue('web-1.com\\nandroid-2.com\\nchrome-3.com')","+    expect(textbox).toHaveAttribute('readonly')","+  })","+})"],"additions":67,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/Auth/AuthProvidersForm/CommaSeparatedListInput.tsx","lines":["@@ -0,0 +1,39 @@","+import { useState, type ComponentProps } from 'react'","+import { cn, Textarea } from 'ui'","+","+type CommaSeparatedListInputProps = Omit<ComponentProps<typeof Textarea>, 'value'> & {","+  value: string","+}","+","+// Shows one item per line while the field is read-only, and the original","+// comma-separated string while it is being edited. The value is never rewritten.","+export const CommaSeparatedListInput = ({","+  value,","+  readOnly,","+  className,","+  onFocus,","+  onBlur,","+  ...props","+}: CommaSeparatedListInputProps) => {","+  const [isFocused, setIsFocused] = useState(false)","+  const isEditing = isFocused && !readOnly","+  const items = value.split(',')","+","+  return (","+    <Textarea","+      {...props}","+      value={isEditing ? value : items.join('\\n')}","+      readOnly={!isEditing}","+      rows={Math.max(items.length, 4)}","+      className={cn('resize-none', className)}","+      onFocus={(event) => {","+        setIsFocused(true)","+        onFocus?.(event)","+      }}","+      onBlur={(event) => {","+        setIsFocused(false)","+        onBlur?.(event)","+      }}","+    />","+  )","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/Auth/AuthProvidersForm/FormField.tsx","lines":["@@ -30,6 +30,7 @@ import { Input as DataInput } from 'ui-patterns/DataInputs/Input'"," import { FormItemLayout } from 'ui-patterns/form/FormItemLayout/FormItemLayout'"," "," import type { Enum } from './AuthProvidersForm.types'","+import { CommaSeparatedListInput } from './CommaSeparatedListInput'"," import { Markdown } from '@/components/interfaces/Markdown'"," import { BASE_PATH } from '@/lib/constants'"," ","@@ -183,6 +184,39 @@ const FormField = ({","         </>","       )"," ","+    case 'comma-separated-list':","+      return (","+        <>","+          <SheetSection>","+            <UIFormField","+              control={control}","+              name={name}","+              disabled={disabled}","+              render={({ field }) => (","+                <FormItemLayout","+                  layout=\"horizontal\"","+                  label={properties.title}","+                  description={","+                    description ? (","+                      <Markdown content={description} className=\"text-foreground-lighter\" />","+                    ) : null","+                  }","+                >","+                  <FormControl className=\"col-span-6\">","+                    <CommaSeparatedListInput","+                      {...field}","+                      value={field.value ?? ''}","+                      readOnly={readOnly}","+                    />","+           