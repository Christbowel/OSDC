+ * A model as this plugin builds its filtered query: its table, the custom query and search steps","+ * the custom query and search plugins add, and the has-posts constraint a model such as Author","+ * declares.","+ */","+interface FilterableModel extends FilterTarget {","+  readonly tableName: string;","+  shouldHavePosts?: HasPostsConfig | null;","+  query(): Knex.QueryBuilder;","+  query(callback: (qb: Knex.QueryBuilder) => void): this;","+  applyCustomQuery(options: Readonly<FilterOptions>): void;","+  applySearchQuery(options: Readonly<FilterOptions>): void;","+}","+","+/** The filter plugin's apply: the filter in `options` and the model's default and enforced filters. */","+type ApplyFilters = (this: FilterableModel, options: Readonly<FilterOptions>) => void;","+","+/** A model class as this plugin uses it: the hook it adds, and `forge`, which makes a new model. */","+interface FilterableModelClass {","+  forge(): FilterableModel;","+  rewriteFilteredQuery(query: Knex.QueryBuilder, options: Readonly<FilterOptions>): void;","+}","+","+/** The base model class every Ghost model extends, as far as this plugin uses it. */","+interface BaseModel {","+  readonly prototype: { readonly applyDefaultAndCustomFilters: ApplyFilters };","+  extend(prototypeProperties: object, classProperties: object): BaseModel;","+}","+","+/** The Bookshelf instance as far as this plugin uses it: the base model it extends. */","+interface FilterPluginBookshelf {","+  Model: BaseModel;","+}","+","+export default function filteredCollectionPlugin(Bookshelf: FilterPluginBookshelf): void {","+  // The filter plugin's apply, which builds a model's query from plain options. It stays in this","+  // closure, where only a resolved filter's methods call it, with the options resolving returned.","+  const applyFilters = Bookshelf.Model.prototype.applyDefaultAndCustomFilters;","+","+  /**","+   * A new model of `Model`'s kind with its custom query, the filter, its default and enforced","+   * filters and the search applied to its query, then the model's own rewrite of that query.","+   * @param Model - the model class the filter was resolved for","+   * @param options - the resolved options","+   */","+  function filteredCollection(","+    Model: FilterableModelClass,","+    options: Readonly<FilterOptions>,","+  ): FilterableModel {","+    const collection = Model.forge();","+","+    // Apply model-specific query behavior","+    collection.applyCustomQuery(options);","+","+    // Add Filter behavior","+    applyFilters.call(collection, options);","+","+    // Apply model-specific search behavior","+    collection.applySearchQuery(options);","+","+    // Authors are hidden unless they have posts. Apply that constraint before","+    // fetchPage clones its count query so pagination cannot reveal hidden staff.","+    // Keep this author-specific: tags have separate, established count semantics.","+    if (collection.shouldHavePosts?.joinTable === 'posts_authors') {","+      collection.query(hasPosts.addHasPostsWhere(collection.tableName, collection.shouldHavePosts));","+      collection.shouldHavePosts = null;","+    }","+","+    Model.rewriteFilteredQuery(collection.query(), options);","+","+    return collection;","+  }","+","+  Bookshelf.Model = Bookshelf.Model.extend(","+    {","+      /**","+       * The filter plugin's apply took plain options, which skip the work a model's resolveFilter","+       * does, so it throws. A filter is applied through the value resolveFilter returns.","+       */","+      applyDefaultAndCustomFilters() {","+        throw new errors.IncorrectUsageError({","+          message: 'A model applies only a filter its resolveFilter returned.',","+          help: 'Await Model.resolveFilter(options), then call query(), collection() or applyTo(model) on the filter it returns.',","+        });","+      },","+    },","+    {","+      /**","+       * Rewrites, in place, the query a resolved filter built for this model, before the query","+       * runs. It's called with the knex query builder and the resolved options, and a rewrite","+       * must select the same rows. None by default.","+       */","+      rewriteFilteredQuery() {},","+","+      /**","+       * Resolves the filter in `options` and returns the resolved filter, whose query(),","+       * collection() and applyTo() build this model's filtered queries. The filter plugin applies","+       * it, with the model's default and enforced filters.","+       */","+      async resolveFilter(","+        this: FilterableModelClass,","+        options: FilterOptions,","+      ): Promise<ResolvedFilter<FilterableModel>> {","+        return new ResolvedFilter(","+          { ...options },","+          {","+            collection: (resolved) => filteredCollection(this, resolved),","+            apply: (target, resolved) => applyFilters.call(target, resolved),","+          },","+        );","+      },","+    },","+  );","+}"],"additions":124,"deletions":0,"truncated":false},{"path":"ghost/core/server/models/base/plugins/resolved-filter.ts","lines":["@@ -0,0 +1,87 @@","+import type { Knex } from 'knex';","+","+// A model's filter is resolved before it builds a query, because resolving can be asynchronous,","+// such as reading records the filter names, and building a model's query is not.","+// The model's resolveFilter returns a ResolvedFilter, whose methods are the only way to apply a","+// filter to the model's queries. A caller that forgets to await resolveFilter holds a promise,","+// which has none of the methods, so the mistake fails at the first call instead of building a","+// query without the filter.","+","+/** Rewrites a parsed filter, as NQL's `mongoTransformer` option takes it. */","+export type FilterTransformer = (filter: unknown) => unknown;","+","+/** The query options a filter is resolved from. Models read other options besides these. */","+export interface FilterOptions {","+  filter?: string;","+  /** The caller's rewrite of the parsed filter, such as the Admin API's check for restricted fields. */","+  mongoTransformer?: FilterTransformer;","+  transacting?: Knex.Transaction;","+  /** Locks the rows the query selects, when it runs in a transaction. */","+  forUpdate?: boolean;","+  [option: string]: unknown;","+}","+","+/** A model of the kind a filter was resolved for, as far as the filter uses it: its query. */","+export interface FilterTarget {","+  query(): Knex.QueryBuilder;","+}","+","+/**","+ * How the base model plugins build a model's queries from the options resolving returns, with","+ * the resolved filter applied.","+ */","+export interface FilterQueries<Target extends FilterTarget> {","+  /**","+   * A new model whose query has the model's custom query, the filter, the model's default and","+   * enforced filters and the search applied.","+   */","+  collection(options: Readonly<FilterOptions>): Target;","+  /** Applies the filter and the model's default and enforced filters to `target`'s query. */","+  apply(target: Target, options: Readonly<FilterOptions>): void;","+}","+","+/** A model's query options with their filter resolved, and the methods that build its queries. */","+export class ResolvedFilter<Target extends FilterTarget> {","+  /** A copy of the options the filter was resolved from. */","+  readonly #options: Readonly<FilterOptions>;","+  readonly #queries: FilterQueries<Target>;","+","+  constructor(options: Readonly<FilterOptions>, queries: FilterQueries<Target>) {","+    this.#options = options;","+    this.#queries = queries;","+  }","+","+  /**","+   * A new model of the kind the filter was resolved for, whose query has the filter applied, for","+   * fetchPage and fetchAll. Its query doesn't join the options' transaction: fetchPage and","+   * fetchAll take the transaction in their own options.","+   */","+  collection(): Target {","+    return this.#queries.collection(this.#options);","+  }","+","+  /**","+   * The query of collection(), for a caller that adds its own select. It runs in the options'","+   * transaction when they have one, and then locks the rows it selects when they ask for","+   * `forUpdate`.","+   */","+  query(): Knex.QueryBuilder {","+    const query = this.collection().query();","+    const { transacting, forUpdate } = this.#options;","+    if (transacting) {","+      query.transacting(transacting);","+      if (forUpdate) {","+        query.forUpdate();","+      }","+    }","+    return query;","+  }","+","+  /**","+   * Applies the filter to `target`, a model of the kind the filter was resolved for that already","+   * has the attributes it is fetched by, such as its id.","+   */","+  applyTo(target: Target): void {","+    this.#queries.apply(target, this.#options);","+  }","+}"],"additions":87,"deletions":0,"truncated":false},{"path":"ghost/core/server/models/member.js","lines":["@@ -211,20 +211,6 @@ const Member = ghostBookshelf.Model.extend(","       ];","     },"," ","-    // Every members query routes its filter through this one method: list, CSV export, bulk","-    // edit and delete, counts and email sends all reach it via findPage or","-    // getFilteredCollectionQuery. Chaining the metafield filter transformer here covers them","-    // all without any call site wiring it.","-    applyDefaultAndCustomFilters(options) {","-      if (options.filter && options.filter.includes(`${METAFIELDS_RELATION.tableNameAs}.`)) {","-        const transformer = createMetafieldsFilterTransformer();","-        options.mongoTransformer = options.mongoTransformer","-          ? chainTransformers(options.mongoTransformer, transformer)","-          : transformer;","-      }","-      return ghostBookshelf.Model.prototype.applyDefaultAndCustomFilters.call(this, options);","-    },","-","     filterRelations() {","       return {","         metafields: METAFIELDS_RELATION,","@@ -686,6 +672,22 @@ const Member = ghostBookshelf.Model.extend(","       return options;","     },"," ","+    /**","+     * Every members qu