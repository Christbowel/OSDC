yrightText := \"NOASSERTION\"","+\tif copyright != \"\" {","+\t\tcopyrightBytes, err := os.ReadFile(copyright)","+\t\tif err != nil {","+\t\t\tlog.Fatalln(err)","+\t\t}","+\t\tcopyrightText = string(copyrightBytes)","+\t}","+","+\tsupplier := parseSupplier(supplierName)","+","+\tif purl == \"\" {","+\t\tpurl = fmt.Sprintf(\"pkg:generic/%s@%s\", packageName, version)","+\t\tif url != \"\" {","+\t\t\tpurl += fmt.Sprintf(\"?download_url=%s\", url)","+\t\t}","+\t}","+","+\tvar summary string","+\tif description != \"\" {","+\t\tsummary = strings.Split(description, \"\\n\")[0]","+\t}","+","+\tpkg := &v2_3.Package{","+\t\tPackageSPDXIdentifier:   common.ElementID(pkgId(id)),","+\t\tPackageName:             packageName,","+\t\tPackageDescription:      description,","+\t\tPackageSummary:          summary,","+\t\tPackageVersion:          version,","+\t\tPackageHomePage:         homepage,","+\t\tPackageDownloadLocation: url,","+\t\tPackageSupplier:         supplier,","+\t\tPackageCopyrightText:    copyrightText,","+\t\tPackageChecksums: []common.Checksum{","+\t\t\t{","+\t\t\t\tAlgorithm: common.SHA256,","+\t\t\t\tValue:     sha256,","+\t\t\t},","+\t\t},","+\t\tPackageExternalReferences: []*v2_3.PackageExternalReference{","+\t\t\t{","+\t\t\t\tCategory: \"PACKAGE-MANAGER\",","+\t\t\t\tLocator:  purl,","+\t\t\t\tRefType:  common.TypePackageManagerPURL,","+\t\t\t},","+\t\t},","+\t}","+\tgen := &v2_3.Package{","+\t\tPackageSPDXIdentifier:   common.ElementID(pkgId(generates)),","+\t\tPackageName:             generates,","+\t\tPackageDescription:      fmt.Sprintf(\"Generated from %s@%s\", pkg.PackageName, pkg.PackageVersion),","+\t\tPackageDownloadLocation: \"NOASSERTION\",","+\t\tPackageCopyrightText:    \"NOASSERTION\",","+\t}","+\tdoc := &v2_3.Document{","+\t\tSPDXIdentifier: gen.PackageSPDXIdentifier,","+\t\tPackages: []*v2_3.Package{","+\t\t\tpkg,","+\t\t\tgen,","+\t\t},","+\t\tRelationships: []*v2_3.Relationship{","+\t\t\t{","+\t\t\t\tRefA:         common.DocElementID{ElementR