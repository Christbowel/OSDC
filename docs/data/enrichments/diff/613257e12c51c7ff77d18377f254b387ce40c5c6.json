iewWithStreamingResponse\",","+]"],"additions":59,"deletions":0,"truncated":false},{"path":"src/anthropic/resources/beta/compliance/review/cases.py","lines":["@@ -0,0 +1,669 @@","+from __future__ import annotations","+","+from typing import List, Union, Iterable","+from datetime import datetime","+","+import httpx2","+","+from ....._types import Body, Omit, Query, Headers, NotGiven, omit, not_given","+from ....._utils import is_given, path_template, strip_not_given","+from ....._compat import cached_property","+from ....._resource import SyncAPIResource, AsyncAPIResource","+from ....._response import (","+    to_raw_response_wrapper,","+    to_streamed_response_wrapper,","+    async_to_raw_response_wrapper,","+    async_to_streamed_response_wrapper,","+)","+from .....pagination import SyncPageCursor, AsyncPageCursor","+from ....._base_client import AsyncPaginator, make_request_options","+from .....types.beta.compliance import BetaComplianceReviewOrder","+from .....types.anthropic_beta_param import AnthropicBetaParam","+from .....types.beta.compliance.review import (","+    BetaComplianceReviewCaseOrderBy,","+    BetaComplianceReviewDetermination,","+    BetaComplianceReviewCaseStatusFilter,","+)","+from .....types.beta.compliance.beta_compliance_review_order import BetaComplianceReviewOrder","+from .....types.beta.compliance.review.beta_compliance_review_case import BetaComplianceReviewCase","+from .....types.beta.compliance.review.beta_compliance_review_case_order_by import BetaComplianceReviewCaseOrderBy","+from .....types.beta.compliance.review.beta_compliance_review_determination import BetaComplianceReviewDetermination","+from .....types.beta.compliance.review.beta_compliance_review_verdict_param import BetaComplianceReviewVerdictParam","+from .....types.beta.compliance.review.beta_compliance_review_case_status_filter import (","+    BetaComplianceReviewCaseStatusFilter,","+)","+from .....types.beta.compliance.review.beta_compliance_review_violated_policy_category import (","+    BetaComplianceReviewViolatedPolicyCategory,","+)","+","+__all__ = [\"Cases\", \"AsyncCases\"]","+","+","+class Cases(SyncAPIResource):","+    @cached_property","+    def with_raw_response(self) -> CasesWithRawResponse:","+        \"\"\"","+        This property can be used as a prefix for any HTTP method call to return","+        the raw response object instead of the parsed content.","+","+        For more information, see https://platform.claude.com/docs/en/api/sdks/python","+        \"\"\"","+        return CasesWithRawResponse(self)","+","+    @cached_property","+    def with_streaming_response(self) -> CasesWithStreamingResponse:","+        \"\"\"","+        An alternative to `.with_raw_response` that doesn't eagerly read the response body.","+","+        For more information, see https://platform.claude.com/docs/en/api/sdks/python","+        \"\"\"","+        return CasesWithStreamingResponse(self)","+","+    def retrieve(","+        self,","+        case_id: str,","+        *,","+        betas: List[AnthropicBetaParam] | Omit = omit,","+        # Use the following arguments if you need to pass additional parameters to the API that aren't available via kwargs.","+        # The extra values given here take precedence over values defined on the client or passed to this method.","+        extra_headers: Headers | None = None,","+        extra_query: Query | None = None,","+        extra_body: Body | None = None,","+        timeout: float | httpx2.Timeout | None | NotGiven = not_given,","+    ) -> BetaComplianceReviewCase:","+        \"\"\"","+        Read one review case.","+","+        A case that the API key can't reach, or that Anthropic hasn't sent, returns the","+        same 404 as a case that doesn't exist.","+","+        An Admin API key with the `read:compliance_review_cases` scope can call this","+        endpoint.","+","+        Args:","+          case_id: The ID of the case (`rvc_...`).","+","+          betas: Optional header to specify the beta version(s) you want to use.","+","+          extra_headers: Send extra headers","+","+          extra_query: Add additional query parameters to the request","+","+          extra_body: Add additional JSON properties to the request","+","+          timeout: Override the client-level default timeout for this request, in seconds","+        \"\"\"","+        if not case_id:","+            raise ValueError(f\"Expected a non-empty value for `case_id` but received {case_id!r}\")","+        extra_headers = {","+            **strip_not_given({\"anthropic-beta\": \",\".join(str(e) for e in betas) if is_given(betas) else not_given}),","+            **(extra_headers or {}),","+        }","+        return self._get(","+            path_template(\"/v1/compliance/review/cases/{case_id}\", case_id=case_id),","+            options=make_request_options(","+                extra_headers=extra_headers,","+                extra_query=extra_query,","+                extra_body=extra_body,","+                timeout=timeout,","+                qualifiers={\"beta\": \"true\"},","+                span_name=\"anthropic.compliance.review.cases.retrieve\",","+                span_route=\"/v1/compliance/review/cases/{case_id}\",","+                span_attributes={\"anthropic.compliance.review.case.id\": case_id},","+            ),","+            cast_to=BetaComplianceReviewCase,","+        )","+","+    def list(","+        self,","+        *,","+        created_at_gt: Union[str, datetime] | Omit = omit,","+        created_at_gte: Union[str, datetime] | Omit = omit,","+        created_at_lt: Union[str, datetime] | Omit = omit,","+        created_at_lte: Union[str, datetime] | Omit = omit,","+        limit: int | Omit = omit,","+        order: BetaComplianceReviewOrder | Omit = omit,","+        order_by: BetaComplianceReviewCaseOrderBy | Omit = omit,","+        page: str | Omit = omit,","+        status: BetaComplianceReviewCaseStatusFilter | Omit = omit,","+        updated_at_gt: Union[str, datetime] | Omit = omit,","+        updated_at_gte: Union[str, datetime] | Omit = omit,","+        updated_at_lt: Union[str, datetime] | Omit = omit,","+        updated_at_lte: Union[str, datetime] | Omit = omit,","+        user_profile_id: str | Omit = omit,","+        betas: List[AnthropicBetaParam] | Omit = omit,","+        # Use the following arguments if you need to pass additional parameters to the API that aren't available via kwargs.","+        # The extra values given here take precedence over values defined on the client or passed to this method.","+        extra_headers: Headers | None = None,","+        extra_query: Query | None = None,","+        extra_body: Body | None = None,","+        timeout: float | httpx2.Timeout | None | NotGiven = not_given,","+    ) -> SyncPageCursor[BetaComplianceReviewCase]:","+        \"\"\"","+        List the review cases of every organization that the API key can reach, newest","+        first by default. Both open and closed cases are returned unless `status` is","+        set.","+","+        To sync, store the largest `updated_at` you have read, and send it as the","+        at-or-after filter on `updated_at`, sorted by `updated_at` ascending. That finds","+        new cases, newly closed cases, and cases with a new notice. Read every page,","+        match results by `id`, and store the new largest value after the last page.","+","+        A request with the `anthropic-user-profile-id` header and no `user_profile_id`","+        parameter returns a 400 error.","+","+        An Admin API key with the `read:compliance_review_cases` scope can call this","+        endpoint.","+","+        Args:","+          created_at_gt: Return only cases whose `created_at` is after this time.","+","+          created_at_gte: Return only cases whose `created_at` is at or after this time.","+","+          created_at_lt: Return only cases whose `created_at` is before this time.","+","+          created_at_lte: Return only cases 