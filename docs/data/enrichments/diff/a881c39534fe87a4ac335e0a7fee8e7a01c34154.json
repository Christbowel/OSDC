{"id":"a881c39534fe87a4ac335e0a7fee8e7a01c34154","axis":"silent","repo":"elsa-workflows/elsa-core","sha":"a881c39534fe87a4ac335e0a7fee8e7a01c34154","parsed":{"files":[{"path":"core/src/modules/Elsa.Workflows.Core/Contexts/WorkflowExecutionContext.Cancel.cs","lines":["@@ -19,6 +19,17 @@ public void Cancel()","         _cancellationTokenSources.Clear();","     }","     ","+    /// <summary>","+    /// Whether the exception is this execution being cancelled through <see cref=\"Cancel\"/>, as opposed to an operation that","+    /// was cancelled for another reason (e.g. a timeout), an <see cref=\"OperationCanceledException\"/> thrown without a","+    /// cancelled token, or the caller's <see cref=\"CancellationToken\"/> being cancelled (e.g. an aborted HTTP request),","+    /// which still ends the workflow as cancelled with an incident.","+    /// </summary>","+    internal bool IsExecutionCancellation(Exception exception) =>","+        exception is OperationCanceledException { CancellationToken.IsCancellationRequested: true }","+        && ExecutionCancellationToken.IsCancellationRequested","+        && !CancellationToken.IsCancellationRequested;","+","     private void CancelWorkflow()","     {","         Bookmarks.Clear();"],"additions":11,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Contexts/WorkflowExecutionContext.cs","lines":["@@ -82,6 +82,7 @@ private WorkflowExecutionContext(","         OriginalBookmarks = originalBookmarks.ToList();","         WorkflowGraph = workflowGraph;","         var linkedCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);","+        ExecutionCancellationToken = linkedCancellationTokenSource.Token;","         _cancellationTokenSources.Add(linkedCancellationTokenSource);","         _cancellationRegistrations.Add(linkedCancellationTokenSource.Token.Register(CancelWorkflow));","     }","@@ -380,6 +381,12 @@ public async Task SetWorkflowGraphAsync(WorkflowGraph workflowGraph)","     /// </summary>","     public CancellationToken CancellationToken { get; }"," ","+    /// <summary>","+    /// The token that activity execution observes. It is cancelled by <see cref=\"Cancel\"/> and by <see cref=\"CancellationToken\"/>,","+    /// so a cancellation reaches running activities. Commits and notifications use <see cref=\"CancellationToken\"/> instead.","+    /// </summary>","+    internal CancellationToken ExecutionCancellationToken { get; }","+","     /// <summary>","     /// A list of <see cref=\"ActivityCompletionCallbackEntry\"/> callbacks that are invoked when the associated child activity completes.","     /// </summary>","@@ -585,7 +592,7 @@ public async Task<ActivityExecutionContext> CreateActivityExecutionContextAsync(","         var parentContext = options?.Owner;","         var now = SystemClock.UtcNow;","         var id = IdentityGenerator.GenerateId();","-        var activityExecutionContext = new ActivityExecutionContext(id, this, parentContext, activity, activityDescriptor, now, tag, SystemClock, CancellationToken);","+        var activityExecutionContext = new ActivityExecutionContext(id, this, parentContext, activity, activityDescriptor, now, tag, SystemClock, ExecutionCancellationToken);","         var variablesToDeclare = options?.Variables ?? [];","         var variableContainer = new[]","         {"],"additions":8,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Middleware/Activities/DefaultActivityInvokerMiddleware.cs","lines":["@@ -92,7 +92,7 @@ public async ValueTask InvokeAsync(ActivityExecutionContext context)","         if (activityDidComplete)","         {","             var mediator = context.GetRequiredService<INotificationSender>();","-            await mediator.SendAsync(new Notifications.ActivityCompleted(context), context.CancellationToken);","+            await mediator.SendAsync(new Notifications.ActivityCompleted(context), workflowExecutionContext.CancellationToken);","         }"," ","         // The activity has run, so it must not look interrupted in the commit below; otherwise recovery would run it again."],"additions":1,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Middleware/Activities/ExceptionHandlingMiddleware.cs","lines":["@@ -35,7 +35,8 @@ public async ValueTask InvokeAsync(ActivityExecutionContext context)","         }","         // A background run works on a throwaway copy of the workflow, so its exceptions escape to the background invoker,","         // which carries them back to the workflow. The fault is handled when the workflow resumes.","-        catch (Exception e) when (!context.GetIsBackgroundExecution())","+        // An activity that stops because its execution was cancelled has not faulted, so the cancellation goes through.","+        catch (Exception e) when (!context.GetIsBackgroundExecution() && !context.WorkflowExecutionContext.IsExecutionCancellation(e))","         {","             logger.LogWarning(e, \"An exception was caught from a downstream middleware component\");","             context.Fault(e);"],"additions":2,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Middleware/Workflows/DefaultActivitySchedulerMiddleware.cs","lines":["@@ -34,7 +34,7 @@ public override async ValueTask InvokeAsync(WorkflowExecutionContext context)","         while (scheduler.HasAny)","         {","             // Do not start a workflow if cancellation has been requested.","-            if (context.CancellationToken.IsCancellationRequested)","+            if (context.ExecutionCancellationToken.IsCancellationRequested)","                 break;"," ","             var currentWorkItem = scheduler.Take();"],"additions":1,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Middleware/Workflows/EngineExceptionHandlingMiddleware.cs","lines":["@@ -29,7 +29,8 @@ public async ValueTask InvokeAsync(WorkflowExecutionContext context)","         {","             await next(context);","         }","-        catch (Exception e)","+        // A cancelled execution has not faulted: let the cancellation through, so the runner doesn't commit the cut-off run.","+        catch (Exception e) when (!context.IsExecutionCancellation(e))","         {","             logger.LogWarning(e, \"An exception was caught from a downstream middleware component\");","             var exceptionState = ExceptionState.FromException(e);"],"additions":2,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Features/WorkflowRuntimeFeature.cs","lines":["@@ -309,6 +309,10 @@ public override void Apply()","             .AddSingleton(sp => new Lazy<IEnumerable<IIngressSource>>(sp.GetServices<IIngressSource>))","             // Drain orchestrator + hosted service (US1). See FR-029 / R5 — heartbeat must outlive drain.","             .AddSingleton<IDrainOrchestrator, Elsa.Workflows.Runtime.Services.DrainOrchestrator>()","+            // Registered after the mediator's hosted services, so on host stop (reverse order) the drain runs before the","+            // background command sender cancels its stopping token. Background runs observe that token; if it were","+            // cancelled first, the cancel would count as a caller cancel and end Finished/Cancelled instead of","+            // Running/Interrupted. Pinned by CooperativeDrainCancellationTests.HostStopDrainsBeforeTheCommandSenderStops.","             .AddHostedService<Elsa.Workflows.Runtime.HostedServices.DrainOrchestratorHostedService>()","             // Domain service that backs all runtime-admin transports (US2). Encapsulates the audit-on-effective-","             // transition rule (SC-007) so transports stay thin. Scoped because INotificationSender is scoped."],"additions":4,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Models/ExecutionCycleHandle.cs","lines":["@@ -35,7 +35,8 @@ public sealed class ExecutionCycleHandle : IDisposable","     /// Creates a new handle. The owning <see cref=\"IExecutionCycleRegistry\"/> supplies <paramref name=\"onDisposed\"/>","     /// so it can decrement its active count. The optional <paramref name=\"cancelCallback\"/> is invoked by","     /// <see cref=\"Cancel\"/> to propagate cancellation into the workflow execution itself (e.g.,","-    /// <c>WorkflowExecutionContext.Cancel()</c>) so that the running cycle stops scheduling new activities. Without it,","+    /// <c>WorkflowExecutionContext.Cancel()</c>) so that the running cycle stops scheduling new activities, and a running","+    /// activity observes the cancellation through <c>ActivityExecutionContext.CancellationToken</c>. Without it,","     /// <see cref=\"Cancel\"/> only signals the cycle's own <see cref=\"CancellationToken\"/>, which is consumed by the","     /// execution-cycle registry but does NOT propagate to the workflow runner's pipeline (the runner reads from","     /// <c>WorkflowExecutionContext.CancellationToken</c>, which is captured at context construction and is not part","@@ -135,9 +136,11 @@ public bool TryCancel()","         if (Interlocked.CompareExchange(ref _lifecycleState, CancellingState, ActiveState) != ActiveState)","             return false;"," ","-        // Propagate to the workflow execution first (this typically marks the workflow as Cancelled and clears its","-        // schedule, so the runner stops scheduling new activities). The orchestrator's subsequent Interrupted","-        // persistence then overrides the Cancelled sub-status — see Disposed-await sequencing in DrainOrchestrator.","+        // Propagate to the workflow execution first (this marks the workflow as Cancelled, so the runner stops scheduling","+        // new activities, and cancels the token running activities observe). When the running activity honours that","+        // token, the runner stops without committing, so the row keeps its last commit and the orchestrator's subsequent","+        // Interrupted persistence makes it recoverable — see Disposed-await sequencing in DrainOrchestrator. An activity","+        // that ignores the token may still finish and commit Cancelled.","         try { _cancelCallback?.Invoke(); }","         catch (Exception ex) when (!ex.IsFatal()) { /* Cancellation is best-effort; non-fatal failures here must not break the drain. */ }"," "],"additions":7,"deletions":4,"truncated":false},{"path":"core/test/integration/Elsa.Alterations.IntegrationTests/CancelAlterationTests.cs","lines":["@@ -0,0 +1,50 @@","+using Elsa.Alterations.AlterationTypes;","+using Elsa.Alterations.Core.Contracts;","+using Elsa.Alterations.Extensions;","+using Elsa.Common.Models;","+using Elsa.Extensions;","+using Elsa.Testing.Shared;","+using Elsa.Workflows;","+using Elsa.Workflows.Models;","+using Elsa.Workflows.Runtime;","+using Elsa.Workflows.Runtime.Activities;","+using Microsoft.Extensions.DependencyInjection;","+using Xunit.Abstractions;","+","+namespace Elsa.Alterations.IntegrationTests;","+","+public sealed class CancelAlterationTests(ITestOutputHelper output) : IAsyncLifetime","+{","+    private readonly IServiceProvider _services = new TestApplicationBuilder(output)","+        .ConfigureElsa(elsa => elsa.UseAlterations())","+        .AddWorkflow<CancelAlterationWorkflow>()","+        .Build();","+","+    public Task InitializeAsync() => _services.PopulateRegistriesAsync();","+    public async Task DisposeAsync() => await ((IAsyncDisposable)_services).DisposeAsync();","+","+    [Fact(DisplayName = \"The Cancel alteration persists a suspended instance as Finished/Cancelled\")]","+    public async Task CancelAlterationPersistsFinishedCancelled()","+    {","+        // Arrange","+        var client = await _services.GetRequiredService<IWorkflowRuntime>().CreateClientAsync();","+        var suspended = await client.CreateAndRunInstanceAsync(new()","+        {","+            WorkflowDefinitionHandle = WorkflowDefinitionHandle.ByDefinitionId(nameof(CancelAlterationWorkflow), VersionOptions.Published)","+        });","+        Assert.Equal(WorkflowSubStatus.Suspended, suspended.SubStatus);","+","+        // Act","+        var results = await _services.GetRequiredService<IAlterationRunner>().RunAsync([client.WorkflowInstanceId], [new Cancel()]);","+","+        // Assert","+        Assert.True(Assert.Single(results).IsSuccessful);","+        var state = await client.ExportStateAsync();","+        Assert.Equal((WorkflowStatus.Finished, WorkflowSubStatus.Cancelled), (state.Status, state.SubStatus));","+    }","+","+    public class CancelAlterationWorkflow : WorkflowBase","+    {","+        protected override void Build(IWorkflowBuilder builder) => builder.Root = new Event(\"cancel-alteration-go\");","+    }","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"core/test/integration/Elsa.Workflows.IntegrationTests/Core/RerunInterruptedActivityTests.cs","lines":["@@ -94,29 +94,6 @@ public async Task FlowchartWaitsForReRunActivity()","         Assert.Equal((WorkflowStatus.Finished, WorkflowSubStatus.Finished), (state.Status, state.SubStatus));","     }"," ","-    [Fact(DisplayName = \"Running a started instance that has nothing scheduled does not start it again from the root\")]","-    public async Task StartedInstanceWithNothingScheduledDoesNotRestart()","-    {","-        // Arrange","-        var start = new Step();","-        var docs = new Step { BookmarkName = \"Docs\" };","-        var workflow = new Workflow { Root = new Flowchart { Start = start, Activities = { start, docs }, Connections = { new Connection(start, docs) } } };","-        var services = BuildServices(commitStrategy: null, new SnapshotAtCommit(_ => false));","-        var runner = services.GetRequiredService<IWorkflowRunner>();","-        var serializer = services.GetRequiredService<IWorkflowStateSerializer>();","-        var suspended = (await runner.RunAsync(workflow)).WorkflowState;","-        var savedState = serializer.Deserialize(serializer.Serialize(suspended));","-        start.Runs = 0;","-","-        // Act","-        var state = (await runner.RunAsync(workflow, savedState)).WorkflowState;","-","-        // Assert","-        Assert.Equal(0, start.Runs);","-        Assert.Equal((WorkflowStatus.Running, WorkflowSubStatus.Suspended), (state.Status, state.SubStatus));","-        Assert.Single(state.Bookmarks, x => x.Name == \"Docs\");","-    }","-","     [Fact(DisplayName = \"Running a started instance with no scheduled work, no bookmark and no interrupted activity does nothing: it doesn't start again from the root and stays Running/Suspended\")]","     public async Task StartedInstanceWithNothingToRunDoesNothing()","     {"],"additions":0,"deletions":23,"truncated":false},{"path":"core/test/integration/Elsa.Workflows.IntegrationTests/GracefulShutdown/CooperativeDrainCancellationTests.cs","lines":["@@ -0,0 +1,278 @@","+using Elsa.Common.Models;","+using Elsa.Extensions;","+using Elsa.Mediator.HostedServices;","+using Elsa.Testing.Shared;","+using Elsa.Workflows.Activities;","+using Elsa.Workflows.Management;","+using Elsa.Workflows.Management.Entities;","+using Elsa.Workflows.Management.Filters;","+using Elsa.Workflows.Models;","+using Elsa.Workflows.Runtime;","+using Elsa.Workflows.Runtime.Activities;","+using Elsa.Workflows.Runtime.Messages;","+using Elsa.Workflows.Runtime.Requests;","+using Microsoft.Extensions.DependencyInjection;","+using Microsoft.Extensions.Hosting;","+using Microsoft.Extensions.Logging;","+using Xunit.Abstractions;","+","+namespace Elsa.Workflows.IntegrationTests.GracefulShutdown;","+","+/// <summary>","+/// A drain's force-cancel reaches a running activity through <see cref=\"ActivityExecutionContext.CancellationToken\"/> (#8489).","+/// </summary>","+public class CooperativeDrainCancellationTests(ITestOutputHelper testOutputHelper) : IAsyncDisposable","+{","+    private readonly CooperativeWaitGate _gate = new();","+    private readonly TokenIgnoringWaitGate _ignoringGate = new();","+    private IServiceProvider _services = null!;","+    private BackgroundCommandSenderHostedService? _commandSender;","+","+    [Fact(DisplayName = \"A drain force-cancel stops an activity that honours its token, leaves the instance Running/Interrupted, and recovery re-runs the activity once\")]","+    public async Task DrainStopsTokenHonouringActivityAndRecoveryReRunsIt()","+    {","+        // Arrange","+        await StartAsync();","+        var client = await _services.GetRequiredService<IWorkflowRuntime>().CreateClientAsync();","+        Assert.False((await client.CreateInstanceAsync(new() { WorkflowDefinitionHandle = Handle<CooperativeWaitWorkflow>() })).CannotStart);","+        var run = Task.Run(() => client.RunInstanceAsync(RunWorkflowInstanceRequest.Empty));","+        await _gate.Started.Task.WaitAsync(TimeSpan.FromSeconds(5));","+","+        // Act","+        var outcome = await _services.GetRequiredService<IDrainOrchestrator>().DrainAsync(DrainTrigger.HostStopSignal);","+","+        // Assert: the activity stopped while the drain waited for the cycle to settle, so the runner committed nothing after its checkpoint.","+        Assert.True(_gate.Stopped.Task.IsCompleted);","+        Assert.Equal(DrainResult.DeadlineExceeded, outcome.OverallResult);","+        Assert.Contains(client.WorkflowInstanceId, outcome.ForceCancelledInstanceIds);","+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run.WaitAsync(TimeSpan.FromSeconds(5)));","+        var interrupted = await FindAsync(client.WorkflowInstanceId);","+        Assert.Equal((WorkflowStatus.Running, WorkflowSubStatus.Interrupted), (interrupted!.Status, interrupted.SubStatus));","+","+        Assert.Equal(1, await ScanAsync());","+        await WaitForStatusAsync(client.WorkflowInstanceId, WorkflowStatus.Finished, WorkflowSubStatus.Finished);","+        Assert.Equal(2, _gate.Executions);","+    }","+","+    [Fact(DisplayName = \"A drain force-cancel cannot stop an activity that ignores its token: the instance ends Finished/Cancelled and is not recovered\")]","+    public async Task DrainOfTokenIgnoringActivityEndsCancelledWithoutRecovery()","+    {","+        // Arrange","+        await StartAsync();","+        var client = await _services.GetRequiredService<IWorkflowRuntime>().CreateClientAsync();","+        Assert.False((await client.CreateInstanceAsync(new() { WorkflowDefinitionHandle = Handle<TokenIgnoringWaitWorkflow>() })).CannotStart);","+        var run = Task.Run(() => client.RunInstanceAsync(RunWorkflowInstanceRequest.Empty));","+        await _ignoringGate.Started.Task.WaitAsync(TimeSpan.FromSeconds(5));","+","+        // Act","+        var outcome = await _services.GetRequiredService<IDrainOrchestrator>().DrainAsync(DrainTrigger.HostStopSignal);","+        _ignoringGate.Continue.TrySetResult();","+        await run.WaitAsync(TimeSpan.FromSeconds(5));","+","+        // Assert: best effort only. The activity finished after the cancel, so the runner committed Cancelled.","+        Assert.Contains(client.WorkflowInstanceId, outcome.ForceCancelledInstanceIds);","+        var cancelled = await FindAsync(client.WorkflowInstanceId);","+        Assert.Equal((WorkflowStatus.Finished, WorkflowSubStatus.Cancelled), (cancelled!.Status, cancelled.SubStatus));","+        Assert.Equal(0, await ScanAsync());","+        Assert.Equal(1, _ignoringGate.Executions);","+    }","+","+    [Fact(DisplayName = \"On host stop, the drain stops before the background command sender, so a drained background run ends Running/Interrupted\")]","+    public async Task HostStopDrainsBeforeTheCommandSenderStops()","+    {","+        // Arrange: a real host, with the workflow dispatched to the background command sender, whose runs observe its stopping token.","+        using var host = Host.CreateDefaultBuilder()","+            .ConfigureLogging(logging => logging.AddProvider(new XunitLoggerProvider(testOutputHelper)))","+            .ConfigureServices(services => services","+                .AddSingleton(_gate)","+                .AddElsa(elsa => elsa","+                    .AddActivitiesFrom<CooperativeWait>()","+                    .AddWorkflow<CooperativeWaitWorkflow>()","+                    .UseWorkflowManagement()","+                    .UseWorkflowRuntime(runtime => runtime.ConfigureGracefulShutdown(options =>","+                    {","+                        options.DrainDeadline = TimeSpan.FromMilliseconds(50);","+                        options.IngressPauseTimeout = TimeSpan.FromMilliseconds(50);","+                    }))))","+            .Build();","+        await host.StartAsync();","+        await host.Services.PopulateRegistriesAsync();","+        var client = await host.Services.GetRequiredService<IWorkflowRuntime>().CreateClientAsync();","+        Assert.False((await client.CreateInstanceAsync(new() { WorkflowDefinitionHandle = Handle<CooperativeWaitWorkflow>() })).CannotStart);","+        (await host.Services.GetRequiredService<IWorkflowDispatcher>().DispatchAsync(new DispatchWorkflowInstanceRequest(client.WorkflowInstanceId), options: null)).ThrowIfFailed();","+        await _gate.Started.Task.WaitAsync(TimeSpan.FromSeconds(5));","+","+        // Act","+        await host.StopAsync();","+","+        // Assert: if the command sender stopped first, its stopping token would cancel the run as a caller-token cancel,","+        // and the instance would end Finished/Cancelled with an incident instead.","+        Assert.True(_gate.Stopped.Task.IsCompleted);","+        using var scope = host.Services.CreateScope();","+        var instance = await scope.ServiceProvider.GetRequiredService<IWorkflowInstanceStore>().FindAsync(new WorkflowInstanceFilter { Id = client.WorkflowInstanceId });","+        Assert.Equal((WorkflowStatus.Running, WorkflowSubStatus.Interrupted), (instance!.Status, instance.SubStatus));","+        Assert.Empty(instance.WorkflowState.Incidents);","+    }","+","+    [Fact(DisplayName = \"Cancelling the caller's token during an activity that honours it still persists Finished/Cancelled with an incident\")]","+    public async Task CallerTokenCancelPersistsFinishedCancelledWithIncident()","+    {","+        // Arrange","+        await StartAsync();","+        var client = await _services.GetRequiredService<IWorkflowRuntime>().CreateClientAsync();","+        Assert.False((await client.CreateInstanceAsync(new() { WorkflowDefinitionHandle = Handle<CooperativeWaitWorkflow>() })).CannotStart);","+        using var callerCancellation = new CancellationTokenSource();","+        var run = Task.Run(() => client.RunInstanceAsync(RunWorkflowInstanceRequest.Empty, callerCancellation.Token));","+        await _gate.Started.Task.WaitAsync(TimeSpan.FromSeconds(5));","+","+        // Act","+        await callerCancellation.CancelAsync();","+        await _gate.Stopped.Task.WaitAsync(TimeSpan.FromSeconds(5));","+        await run.WaitAsync(TimeSpan.FromSeconds(5));","+","+        // Assert","+        var cancelled = await FindAsync(client.WorkflowInstanceId);","+        Assert.Equal((WorkflowStatus.Finished, WorkflowSubStatus.Cancelled), (cancelled!.Status, cancelled.SubStatus));","+        Assert.NotEmpty(cancelled.WorkflowState.Incidents);","+    }","+","+    [Fact(DisplayName = \"A user cancel still persists Finished/Cancelled\")]","+    public async Task UserCancelPersistsFinishedCancelled()","+    {","+        // Arrange","+        await StartAsync();","+        var client = await _services.GetRequiredService<IWorkflowRuntime>().CreateClientAsync();","+        var suspended = await client.CreateAndRunInstanceAsync(new() { WorkflowDefinitionHandle = Handle<SuspendedWorkflow>() });","+        Assert.Equal(WorkflowSubStatus.Suspended, suspended.SubStatus);","+","+        // Act","+        await client.CancelAsync();","+","+        // Assert","+        var cancelled = await FindAsync(client.WorkflowInstanceId);","+        Assert.Equal((WorkflowStatus.Finished, WorkflowSubStatus.Cancelled), (cancelled!.Status, cancelled.SubStatus));","+    }","+","+    public async ValueTask DisposeAsync()","+    {","+        if (_commandSender is not null)","+            await _commandSender.StopAsync(CancellationToken.None);","+    }","+","+    private async Task StartAsync()","+    {","+        _services = new TestApplicationBuilder(testOutputHelper)","+            .AddActivitiesFrom<CooperativeWait>()","+            .AddWorkflow<CooperativeWaitWorkflow>()","+            .AddWorkflow<TokenIgnoringWaitWorkflow>()","+            .AddWorkflow<SuspendedWorkflow>()","+            .ConfigureServices(services => services.AddSingleton(_gate).AddSingleton(_ignoringGate))","+            .ConfigureElsa(elsa => elsa.UseWorkflowRuntime(runtime => runtime.ConfigureGracefulShutdown(options =>","+            {","+                options.DrainDeadline = TimeSpan.FromMilliseconds(50);","+                options.IngressPauseTimeout = TimeSpan.FromMilliseconds(50);","+            })))","+            .Build();","+        await _services.PopulateRegistriesAsync();","+    }","+","+    private async Task<int> ScanAsync()","+    {","+        _commandSender = _services.GetServices<IHostedService>().OfType<BackgroundCommandSenderHostedService>().Single();","+        await _commandSender.StartAsync(CancellationToken.None);","+        using var scope = _services.CreateScope();","+        return await scope.ServiceProvider.GetRequiredService<IInterruptedRecoveryScanner>().ScanAndRequeueAsync(CancellationToken.None);","+    }","+","+    private async Task<WorkflowInstance?> FindAsync(string instanceId)","+    {","+        using var scope = _services.CreateScope();","+        return await scope.ServiceProvider.GetRequiredService<IWorkflowInstanceStore>().FindAsync(new WorkflowInstanceFilter { Id = instanceId });","+    }","+","+    private async Task WaitForStatusAsync(string instanceId, WorkflowStatus status, WorkflowSubStatus subStatus)","+    {","+        var deadline = DateTime.UtcNow + TimeSpan.FromSeconds(10);","+","+        while (await FindAsync(instanceId) is var instance && (instance?.Status, instance?.SubStatus) != (status, subStatus))","+        {","+            Assert.True(DateTime.UtcNow < deadline, $\"Instance {instanceId} is {instance?.Status}/{instance?.SubStatus}, not {status}/{subStatus}.\");","+            await Task.Delay(20);","+        }","+    }","+","+    private static WorkflowDefinitionHandle Handle<TWorkflow>() => WorkflowDefinitionHandle.ByDefinitionId(typeof(TWorkflow).Name, VersionOptions.Published);","+","+    public class SuspendedWorkflow : WorkflowBase","+    {","+        protected override void Build(IWorkflowBuilder builder) => builder.Root = new Event(\"cooperative-cancel-go\");","+    }","+}","+","+/// <summary>Counts the executions of <see cref=\"CooperativeWait\"/> and reports when its first execution starts and stops.</summary>","+public sealed class CooperativeWaitGate","+{","+    public int Executions;","+    public TaskCompletionSource Started { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);","+    public TaskCompletionSource Stopped { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);","+}","+","+/// <summary>","+/// On its first execution, commits a checkpoint (so the instance is saved with this activity executing) and then waits","+/// until its cancellation token is cancelled. Any later execution completes at once.","+/// </summary>","+public class CooperativeWait : CodeActivity","+{","+    protected override async ValueTask ExecuteAsync(ActivityExecutionContext context)","+    {","+        var gate = context.GetRequiredService<CooperativeWaitGate>();","+        if (Interlocked.Increment(ref gate.Executions) > 1)","+            return;","+","+        await context.WorkflowExecutionContext.CommitAsync();","+        gate.Started.TrySetResult();","+        try","+        {","+            await Task.Delay(Timeout.Infinite, context.CancellationToken);","+        }","+        finally","+        {","+            gate.Stopped.TrySetResult();","+        }","+    }","+}","+","+public class CooperativeWaitWorkflow : WorkflowBase","+{","+    protected override void Build(IWorkflowBuilder builder) => builder.Root = new CooperativeWait();","+}","+","+/// <summary>Counts the executions of <see cref=\"TokenIgnoringWait\"/> and lets the test release its first execution.</summary>","+public sealed class TokenIgnoringWaitGate","+{","+    public int Executions;","+    public TaskCompletionSource Started { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);","+    public TaskCompletionSource Continue { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);","+}","+","+/// <summary>","+/// Like <see cref=\"CooperativeWait\"/>, but ignores its cancellation token: it waits until the test releases it.","+/// </summary>","+public class TokenIgnoringWait : CodeActivity","+{","+    protected override async ValueTask ExecuteAsync(ActivityExecutionContext context)","+    {","+        var gate = context.GetRequiredService<TokenIgnoringWaitGate>();","+        if (Interlocked.Increment(ref gate.Executions) > 1)","+            return;","+","+        await context.WorkflowExecutionContext.CommitAsync();","+        gate.Started.TrySetResult();","+        await gate.Continue.Task;","+    }","+}","+","+public class TokenIgnoringWaitWorkflow : WorkflowBase","+{","+    protected override void Build(IWorkflowBuilder builder) => builder.Root = new TokenIgnoringWait();","+}"],"additions":278,"deletions":0,"truncated":false},{"path":"core/test/integration/Elsa.Workflows.IntegrationTests/GracefulShutdown/DrainRecoveryEndToEndTests.cs","lines":["@@ -19,15 +19,16 @@ namespace Elsa.Workflows.IntegrationTests.GracefulShutdown;"," /// End-to-end drain recovery using the production <see cref=\"IWorkflowRestarter\"/> (not a recording fake)."," /// A recoverable instance runs a first step, then blocks on a gated activity (still Running). Drain marks"," /// that live row Interrupted. After the real restarter resumes it, the remaining work completes and the","-/// first step is not re-run. A separate drain-cancelled instance stays Finished/Cancelled across scans.","+/// first step is not re-run. A separate instance whose activity honours its cancellation token is stopped by the","+/// drain's force-cancel, also left Running/Interrupted, and recovered (#8489)."," /// </summary>"," public class DrainRecoveryEndToEndTests"," {","     private readonly IServiceProvider _services;","-    private readonly IWorkflowRunner _workflowRunner;","     private readonly IWorkflowRuntime _workflowRuntime;","     private readonly IDrainOrchestrator _orchestrator;","     private readonly CapturingTextWriter _capturingTextWriter = new();"],"additions":2,"deletions":2,"truncated":false}],"additions":366,"deletions":34,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-26T18:56:44.420783+00:00"}