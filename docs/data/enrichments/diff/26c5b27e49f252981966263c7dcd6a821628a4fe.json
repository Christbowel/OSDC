{"id":"26c5b27e49f252981966263c7dcd6a821628a4fe","axis":"silent","repo":"open-telemetry/opentelemetry-go","sha":"26c5b27e49f252981966263c7dcd6a821628a4fe","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -24,6 +24,7 @@ This project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.htm"," - Ensure `grpc.DialOption` values passed via `WithDialOption` take precedence over conflicting internally-computed defaults in `go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc`. (#8836)"," - Treat overflowing `OTEL_METRIC_EXPORT_INTERVAL` and `OTEL_METRIC_EXPORT_TIMEOUT` values as invalid in `go.opentelemetry.io/otel/sdk/metric`. (#8800)"," - Prevent a panic in `NewFixedSizeReservoir` and `FixedSizeReservoirProvider` when given a negative size in `go.opentelemetry.io/otel/sdk/metric/exemplar`; negative sizes are now clamped to zero, consistent with a size of zero. (#8832)","+- Ensure metric helpers in `go.opentelemetry.io/otel/semconv/v1.32.0`, `go.opentelemetry.io/otel/semconv/v1.33.0`, and `go.opentelemetry.io/otel/semconv/v1.34.0` record measurements only once when no attributes are provided. (#8849)"," - Treat empty `OTEL_TRACES_SAMPLER` and `OTEL_TRACES_SAMPLER_ARG` values as unset in `go.opentelemetry.io/otel/sdk/trace`. (#8873)"," - Normalize global `OTEL_EXPORTER_OTLP_ENDPOINT` path joining in `go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp` so trailing-slash base URLs do not produce double-slash log export paths. (#8864)"," - Prevent a deadlock when formatting an error passed to `RecordError` calls back into the span in `go.opentelemetry.io/otel/sdk/trace`. (#8815)"],"additions":1,"deletions":0,"truncated":false},{"path":"internal/tools/semconvkit/main_test.go","lines":["@@ -5,6 +5,9 @@ package main"," "," import ("," \t\"bytes\"","+\t\"go/ast\"","+\t\"go/parser\"","+\t\"go/token\""," \t\"os\""," \t\"path/filepath\""," \t\"strings\"","@@ -94,6 +97,85 @@ func TestNoInvalidObservableHistogramTypes(t *testing.T) {"," \t}"," }"," ","+// TestGeneratedMetricHelpersReturnAfterEmptyAttrs checks every retained helper","+// affected by the missing return in semconv v1.32.0 through v1.34.0.","+func TestGeneratedMetricHelpersReturnAfterEmptyAttrs(t *testing.T) {","+\tt.Parallel()","+","+\tpackages := map[string][]string{","+\t\t\"containerconv\": {\"Uptime\"},","+\t\t\"goconv\":        {\"ScheduleDuration\"},","+\t\t\"k8sconv\":       {\"NodeCPUUsage\", \"NodeMemoryUsage\", \"NodeUptime\", \"PodCPUUsage\", \"PodMemoryUsage\", \"PodUptime\"},","+\t\t\"processconv\":   {\"Uptime\"},","+\t\t\"rpcconv\":       {\"ClientDuration\", \"ClientRequestSize\", \"ClientRequestsPerRPC\", \"ClientResponseSize\", \"ClientResponsesPerRPC\", \"ServerDuration\", \"ServerRequestSize\", \"ServerRequestsPerRPC\", \"ServerResponseSize\", \"ServerResponsesPerRPC\"},","+\t\t\"systemconv\":    {\"Uptime\"},","+\t}","+\tversions := []string{\"v1.32.0\", \"v1.33.0\", \"v1.34.0\"}","+\tfset := token.NewFileSet()","+","+\tfor _, version := range versions {","+\t\tfor pkg, functions := range packages {","+\t\t\tpath := filepath.Join(\"..\", \"..\", \"..\", \"semconv\", version, pkg, \"metric.go\")","+\t\t\tfile, err := parser.ParseFile(fset, path, nil, 0)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"ParseFile(%q) error = %v\", path, err)","+\t\t\t}","+","+\t\t\tfor _, function := range functions {","+\t\t\t\tmatches := 0","+\t\t\t\tast.Inspect(file, func(node ast.Node) bool {","+\t\t\t\t\tfn, ok := node.(*ast.FuncDecl)","+\t\t\t\t\tif !ok || fn.Recv == nil || fn.Name.Name != \"Record\" {","+\t\t\t\t\t\treturn true","+\t\t\t\t\t}","+\t\t\t\t\tif len(fn.Recv.List) != 1 || len(fn.Recv.List[0].Names) != 1 || fn.Recv.List[0].Names[0].Name != \"m\" {","+\t\t\t\t\t\treturn true","+\t\t\t\t\t}","+\t\t\t\t\treceiver, ok := fn.Recv.List[0].Type.(*ast.Ident)","+\t\t\t\t\tif !ok || receiver.Name != function {","+\t\t\t\t\t\treturn true","+\t\t\t\t\t}","+","+\t\t\t\t\tfastPaths := 0","+\t\t\t\t\tast.Inspect(fn.Body, func(node ast.Node) bool {","+\t\t\t\t\t\tifStmt, ok := node.(*ast.IfStmt)","+\t\t\t\t\t\tif !ok {","+\t\t\t\t\t\t\treturn true","+\t\t\t\t\t\t}","+\t\t\t\t\t\tcondition, ok := ifStmt.Cond.(*ast.BinaryExpr)","+\t\t\t\t\t\tif !ok || condition.Op != token.EQL {","+\t\t\t\t\t\t\treturn true","+\t\t\t\t\t\t}","+\t\t\t\t\t\tcall, ok := condition.X.(*ast.CallExpr)","+\t\t\t\t\t\tzero, zeroOK := condition.Y.(*ast.BasicLit)","+\t\t\t\t\t\tif !ok || !zeroOK || zero.Kind != token.INT || zero.Value != \"0\" || len(call.Args) != 1 {","+\t\t\t\t\t\t\treturn true","+\t\t\t\t\t\t}","+\t\t\t\t\t\tfn, fnOK := call.Fun.(*ast.Ident)","+\t\t\t\t\t\targ, argOK := call.Args[0].(*ast.Ident)","+\t\t\t\t\t\tif !fnOK || !argOK || fn.Name != \"len\" || arg.Name != \"attrs\" {","+\t\t\t\t\t\t\treturn true","+\t\t\t\t\t\t}","+\t\t\t\t\t\tif len(ifStmt.Body.List) > 0 {","+\t\t\t\t\t\t\tif _, ok := ifStmt.Body.List[len(ifStmt.Body.List)-1].(*ast.ReturnStmt); ok {","+\t\t\t\t\t\t\t\tfastPaths++","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t\treturn true","+\t\t\t\t\t})","+\t\t\t\t\tif fastPaths == 1 {","+\t\t\t\t\t\tmatches++","+\t\t\t\t\t}","+\t\t\t\t\treturn false","+\t\t\t\t})","+\t\t\t\tif matches != 1 {","+\t\t\t\t\tt.Errorf(\"%s: %s.Record empty-attrs fast paths = %d, want 1\", path, function, matches)","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}","+"," func writeGoFile(t *testing.T, dir, _, src string) {"," \tt.Helper()"," "],"additions":82,"deletions":0,"truncated":false},{"path":"semconv/v1.32.0/containerconv/metric.go","lines":["@@ -543,6 +543,7 @@ func (Uptime) Description() string {"," func (m Uptime) Record(ctx context.Context, val float64, attrs ...attribute.KeyValue) {"," \tif len(attrs) == 0 {"," \t\tm.Float64Gauge.Record(ctx, val)","+\t\treturn"," \t}"," "," \to := recOptPool.Get().(*[]metric.RecordOption)"],"additions":1,"deletions":0,"truncated":false},{"path":"semconv/v1.32.0/goconv/metric.go","lines":["@@ -498,6 +498,7 @@ func (ScheduleDuration) Description() string {"," func (m ScheduleDuration) Re