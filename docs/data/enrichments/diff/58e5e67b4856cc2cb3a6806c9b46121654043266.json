{"id":"58e5e67b4856cc2cb3a6806c9b46121654043266","axis":"silent","repo":"TYPO3/typo3","sha":"58e5e67b4856cc2cb3a6806c9b46121654043266","parsed":{"files":[{"path":"typo3/sysext/core/Documentation/Changelog/14.3.x/Important-89325-IntegrityCheckReportsShadowedRedirects.rst","lines":["@@ -0,0 +1,42 @@","+..  include:: /Includes.rst.txt","+","+..  _important-89325-1792047896:","+","+==============================================================","+Important: #89325 - Integrity check reports shadowed redirects","+==============================================================","+","+See :issue:`89325`","+","+Description","+===========","+","+The redirects module allows multiple redirects with the same source host and","+source path. Only one of them is ever used, all others are never matched, which","+was not visible to editors.","+","+The command :bash:`redirects:checkintegrity` now additionally marks such","+redirects with the new integrity status :php:`shadowed`, available as","+:php:`\\TYPO3\\CMS\\Redirects\\Utility\\RedirectConflict::SHADOWED`. They are","+highlighted in the redirects module and can be filtered by that status.","+","+A redirect is considered shadowed when another enabled redirect is matched","+first for every request the redirect itself would match, at any time it would","+be active. This takes into account:","+","+*   the source host, where an empty source host equals :php:`*`,","+*   the source path, ignoring a trailing slash,","+*   the options \"Is regular expression\" and \"Respect GET parameters\", where","+    regular expressions are only compared literally,","+*   the start and end time of both redirects.","+","+Disabled redirects are never reported, and redirects that only overlap for a","+part of their active time are not reported either. A redirect for a specific","+host is not considered shadowed by one for any host :php:`*`, since the","+specific host is matched first.","+","+Running the command after an update may therefore mark existing redirects as","+conflicting. Remove or adjust them to resolve the conflict, the status is reset","+on the next run of the command.","+","+..  index:: Backend, CLI, ext:redirects"],"additions":42,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Classes/Command/CheckIntegrityCommand.php","lines":["@@ -108,6 +108,21 @@ protected function execute(InputInterface $input, OutputInterface $output): int","             $this->integrityService->setIntegrityStatus($conflict['redirect']);","         }"," ","+        foreach ($this->integrityService->findShadowedRedirects() as $conflict) {","+            $conflictingRedirects[] = [","+                $conflict['redirect']['uid'],","+                $conflict['redirect']['source_host'],","+                $conflict['redirect']['source_path'],","+                $conflict['redirect']['target'],","+                LocalizationUtility::translate(","+                    self::LANGUAGE_FILE_PATH . $integrityStatusLabel . $conflict['redirect']['integrity_status']","+                ),","+            ];","+            $list[] = $conflict;","+            $conflictingUids[] = $conflict['redirect']['uid'];","+            $this->integrityService->setIntegrityStatus($conflict['redirect']);","+        }","+","         foreach ($this->integrityService->checkRedirectIntegrity() as $conflict) {","             if ($conflict['redirect']['integrity_status'] !== RedirectConflict::NO_CONFLICT) {","                 // Report only redirects with conflict status checked as conflicting redirects."],"additions":15,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Classes/Service/IntegrityService.php","lines":["@@ -21,6 +21,7 @@"," use TYPO3\\CMS\\Core\\Database\\Connection;"," use TYPO3\\CMS\\Core\\Database\\ConnectionPool;"," use TYPO3\\CMS\\Core\\Database\\Query\\Restriction\\DeletedRestriction;","+use TYPO3\\CMS\\Core\\Database\\Query\\Restriction\\HiddenRestriction;"," use TYPO3\\CMS\\Core\\Http\\Uri;"," use TYPO3\\CMS\\Core\\Schema\\Capability\\TcaSchemaCapability;"," use TYPO3\\CMS\\Core\\Schema\\TcaSchemaFactory;","@@ -74,6 +75,54 @@ public function findConflictingRedirects(?string $siteIdentifier = null): \\Gener","         }","     }"," ","+    /**","+     * Resolves all redirects which can never match, because another redirect with the same source","+     * is matched first whenever the redirect itself would be active.","+     */","+    public function findShadowedRedirects(): \\Generator","+    {","+        $queryBuilder = $this->connectionPool->getQueryBuilderForTable('sys_redirect');","+        $queryBuilder->getRestrictions()->removeAll()","+            ->add(GeneralUtility::makeInstance(HiddenRestriction::class))","+            ->add(GeneralUtility::makeInstance(DeletedRestriction::class));","+        $rows = $queryBuilder","+            ->select('uid', 'source_host', 'source_path', 'is_regexp', 'respect_query_parameters', 'starttime', 'endtime', 'target')","+            ->from('sys_redirect')","+            ->orderBy('uid', 'asc')","+            ->executeQuery()","+            ->fetchAllAssociative();","+","+        $groups = [];","+        foreach ($rows as $row) {","+            [$matchKey, $priority] = $this->getMatchKeyAndPriority($row);","+            $groups[$matchKey][$priority][] = $row;","+        }","+","+        foreach ($groups as $groupedByPriority) {","+            ksort($groupedByPriority);","+            $redirectsInMatchingOrder = array_merge(...$groupedByPriority);","+            foreach ($redirectsInMatchingOrder as $index => $redirect) {","+                for ($previousIndex = 0; $previousIndex < $index; $previousIndex++) {","+                    $previousRedirect = $redirectsInMatchingOrder[$previousIndex];","+                    if ($this->isActiveWhenever($previousRedirect, $redirect)) {","+                        yield [","+                            'uri' => $redirect['target'],","+                            'redirect' => [","+                                'integrity_status' => RedirectConflict::SHADOWED,","+                                'source_host' => $redirect['source_host'],","+                                'source_path' => $redirect['source_path'],","+                                'target' => $redirect['target'],","+                                'uid' => (int)$redirect['uid'],","+                                'shadowed_by' => (int)$previousRedirect['uid'],","+                            ],","+                        ];","+                        break;","+                    }","+                }","+            }","+        }","+    }","+","     /**","      * Checks all redirects  by dispatching a PSR-14 event for each record,","      * allowing listeners to validate targets and flag broken redirects.","@@ -152,6 +201,46 @@ public function resetIntegrityStatus(array $conflictingUids, array $statusesToKe","         }","     }"," ","+    /**","+     * Redirects with the same match key compete for the same requests in {@see RedirectService::matchRedirect()},","+     * where redirects with a lower priority are checked first, followed by the lower uid.","+     *","+     * @return array{0: string, 1: int}","+     */","+    private function getMatchKeyAndPriority(array $redirect): array","+    {","+        $sourceHost = $redirect['source_host'] === '' ? '*' : $redirect['source_host'];","+        $sourcePath = (string)$redirect['source_path'];","+        $respectQueryParameters = (bool)$redirect['respect_query_parameters'];","+        if ($redirect['is_regexp']) {","+            return [$sourceHost . '|regexp|' . (int)$respectQueryParameters . '|' . $sourcePath, 0];","+        }","+        if (!$respectQueryParameters) {","+            return [$sourceHost . '|flat|' . rtrim($sourcePath, '/') . '/', 0];","+        }","+        if (!str_contains($sourcePath, '?')) {","+            return [$sourceHost . '|query|' . $sourcePath, 0];","+        }","+        // A source path with a slash before the query is only checked if none without the slash exists.","+        [$path, $query] = explode('?', $sourcePath, 2);","+        $trimmedPath = rtrim($path, '/');","+        return [$sourceHost . '|query|' . $trimmedPath . '?' . $query, $trimmedPath === $path ? 0 : 1];","+    }","+","+    /**","+     * Whether $redirect is active whenever $otherRedirect is active, considering starttime and endtime.","+     */","+    private function isActiveWhenever(array $redirect, array $otherRedirect): bool","+    {","+        if ((int)$redirect['starttime'] > (int)$otherRedirect['starttime']) {","+            return false;","+        }","+        if ((int)$redirect['endtime'] === 0) {","+            return true;","+        }","+        return (int)$otherRedirect['endtime'] !== 0 && (int)$redirect['endtime'] >= (int)$otherRedirect['endtime'];","+    }","+","     private function getMatchingRedirectByUri(Uri $uri): ?array","     {","         $port = $uri->getPort();"],"additions":89,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Classes/Utility/RedirectConflict.php","lines":["@@ -25,4 +25,5 @@ class RedirectConflict","     public const NO_CONFLICT = 'no_conflict';","     public const SELF_REFERENCE = 'self_reference';","     public const INVALID_TARGET = 'invalid_target';","+    public const SHADOWED = 'shadowed';"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Configuration/TCA/sys_redirect.php","lines":["@@ -326,6 +326,10 @@","                         'label' => 'LLL:EXT:redirects/Resources/Private/Language/locallang_db.xlf:sys_redirect.integrity_status.self_reference',","                         'value' => RedirectConflict::SELF_REFERENCE,","                     ],","+                    [","+                        'label' => 'LLL:EXT:redirects/Resources/Private/Language/locallang_db.xlf:sys_redirect.integrity_status.shadowed',","+                        'value' => RedirectConflict::SHADOWED,","+                    ],","                 ],","                 'readOnly' => true,","             ],"],"additions":4,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Resources/Private/Language/locallang_db.xlf","lines":["@@ -129,6 +129,9 @@","       <trans-unit id=\"sys_redirect.integrity_status.invalid_target\">","         <source>Invalid target</source>","       </trans-unit>","+      <trans-unit id=\"sys_redirect.integrity_status.shadowed\">","+        <source>Shadowed by another redirect</source>","+      </trans-unit>","       <trans-unit id=\"sys_redirect.uid\">","         <source>UID</source>","       </trans-unit>"],"additions":3,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Tests/Functional/Command/CheckIntegrityCommandTest.php","lines":["@@ -19,8 +19,10 @@"," "," use PHPUnit\\Framework\\Attributes\\Test;"," use Symfony\\Component\\Console\\Tester\\CommandTester;","+use TYPO3\\CMS\\Core\\Database\\ConnectionPool;"," use TYPO3\\CMS\\Core\\Tests\\Functional\\SiteHandling\\SiteBasedTestTrait;"," use TYPO3\\CMS\\Redirects\\Command\\CheckIntegrityCommand;","+use TYPO3\\CMS\\Redirects\\Utility\\RedirectConflict;"," use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;"," "," final class CheckIntegrityCommandTest extends FunctionalTestCase","@@ -62,6 +64,27 @@ public function integrityStatusOfResolvedConflictsIsReset(): void","         $this->assertCSVDataSet(__DIR__ . '/Fixtures/StaleIntegrityStatusResult.csv');","     }"," ","+    #[Test]","+    public function shadowedRedirectsAreMarked(): void","+    {","+        $this->writeSiteConfiguration('simple-page', $this->buildSiteConfiguration(1, 'https://example.com'));","+        $this->importCSVDataSet(__DIR__ . '/../Service/Fixtures/IntegrityServiceTest_shadowedRedirects.csv');","+","+        $tester = new CommandTester($this->get(CheckIntegrityCommand::class));","+        $tester->execute([]);","+","+        $queryBuilder = $this->get(ConnectionPool::class)->getQueryBuilderForTable('sys_redirect');","+        $queryBuilder->getRestrictions()->removeAll();","+        $shadowedUids = $queryBuilder","+            ->select('uid')","+            ->from('sys_redirect')","+            ->where($queryBuilder->expr()->eq('integrity_status', $queryBuilder->createNamedParameter(RedirectConflict::SHADOWED)))","+            ->orderBy('uid')","+            ->executeQuery()","+            ->fetchFirstColumn();","+        self::assertSame([2, 4, 10, 18, 24, 25, 28, 34, 35], array_map(intval(...), $shadowedUids));","+    }","+","     #[Test]","     public function selfReferenceStatusIsKeptWhenCheckIsLimitedToSite(): void","     {"],"additions":23,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Tests/Functional/Service/Fixtures/IntegrityServiceTest_shadowedRedirects.csv","lines":["@@ -0,0 +1,41 @@","+\"sys_redirect\",,,,,,,,,,,","+,\"uid\",\"pid\",\"deleted\",\"disabled\",\"starttime\",\"endtime\",\"source_host\",\"source_path\",\"is_regexp\",\"respect_query_parameters\",\"target\",\"redirect_type\"","+,1,0,0,0,0,0,\"example.com\",\"/duplicate\",0,0,\"/target-1\",\"default\"","+,2,0,0,0,0,0,\"example.com\",\"/duplicate\",0,0,\"/target-2\",\"default\"","+,3,0,0,0,0,0,\"example.com\",\"/trailing-slash/\",0,0,\"/target-3\",\"default\"","+,4,0,0,0,0,0,\"example.com\",\"/trailing-slash\",0,0,\"/target-4\",\"default\"","+,5,0,0,0,0,0,\"example.com\",\"/other-host\",0,0,\"/target-5\",\"default\"","+,6,0,0,0,0,0,\"another.example.com\",\"/other-host\",0,0,\"/target-6\",\"default\"","+,7,0,0,0,0,0,\"*\",\"/any-host\",0,0,\"/target-7\",\"default\"","+,8,0,0,0,0,0,\"example.com\",\"/any-host\",0,0,\"/target-8\",\"default\"","+,9,0,0,0,0,0,\"\",\"/empty-host\",0,0,\"/target-9\",\"default\"","+,10,0,0,0,0,0,\"*\",\"/empty-host\",0,0,\"/target-10\",\"default\"","+,11,0,0,1,0,0,\"example.com\",\"/disabled-first\",0,0,\"/target-11\",\"default\"","+,12,0,0,0,0,0,\"example.com\",\"/disabled-first\",0,0,\"/target-12\",\"default\"","+,13,0,0,0,0,0,\"example.com\",\"/disable