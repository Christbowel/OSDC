e an attribute call, excluding keys already supplied before the cursor.","+- For clients that advertise LSP snippet support, attribute-name completions include only required positional arguments and required named arguments as empty editable tab stops. Optional arguments remain available through named-key completion instead of being inserted automatically.","+- For clients without snippet support, attribute-name completions use plain-text edits with no snippet placeholders.","+","+The provider preserves existing sigils, typed prefixes, completed attribute argument lists, and text after the cursor. It does not complete attribute values, recurse into record/list values, or offer nested function-call argument suggestions; those value-level completions are outside this package's current completion surface."],"additions":13,"deletions":0,"truncated":false},{"path":"packages/1-framework/3-tooling/language-server/src/completion-context.ts","lines":["@@ -1,4 +1,5 @@"," import {","+  AttributeArgAst,","   AttributeArgListAst,","   any,","   type BracedBlock,","@@ -66,6 +67,71 @@ export interface GenericBlockValueCompletionContext {","   readonly replacementStartOffset: number;"," }"," ","+export interface FieldAttributeNameCompletionContext {","+  readonly kind: 'fieldAttributeName';","+  readonly offset: number;","+  readonly replacementStartOffset: number;","+  readonly attribute: FieldAttributeAst;","+  readonly field: FieldDeclarationAst;","+  readonly model: ModelDeclarationAst;","+}","+","+export interface ModelAttributeNameCompletionContext {","+  readonly kind: 'modelAttributeName';","+  readonly offset: number;","+  readonly replacementStartOffset: number;","+  readonly attribute: ModelAttributeAst;","+  readonly model: ModelDeclarationAst;","+}","+","+export interface BlockAttributeNameCompletionContext {","+  readonly kind: 'blockAttributeName';","+  readonly offset: number;","+  readonly replacementStartOffset: number;","+  readonly attribute: ModelAttributeAst;"