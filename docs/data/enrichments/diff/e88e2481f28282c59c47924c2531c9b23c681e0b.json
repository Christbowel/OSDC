ED;","+  }","+  return {","+    kind: 'fieldAttributeNamedKey',","+    offset: input.offset,","+    replacementStartOffset: input.replacementStartOffset,","+    attributeName,","+    attribute,","+    field,","+    model,","+  };","+}","+","+function classifyGenericBlockAttribute(","+  input: AttributeClassifierInput,","+): PslCompletionContext | undefined {","+  const attribute = activeModelAttribute(input);","+  const block = attribute?.syntax.findAncestor(GenericBlockDeclarationAst.cast);","+  if (attribute === undefined || block === undefined) {","+    return undefined;","+  }","+  const blockKeyword = block.keyword()?.text;","+  if (blockKeyword === undefined || blockKeyword.length === 0) {","+    return UNSUPPORTED;","+  }","+  if (isAttributeNamePosition(attribute, input.offset)) {","+    return {","+      kind: 'blockAttributeName',","+      offset: input.offset,","+      replacementStartOffset: input.replacementStartOffset,","+      attribute,","+      block,","+      blockKeyword,","+    };","+  }","+  const attributeName = attributeNamedKeyName(attribute, input.offset);","+  if (attributeName === undefined) {","+    return UNSUPPORTED;","+  }","+  return {","+    kind: 'blockAttributeNamedKey',","+    offset: input.offset,","+    replacementStartOffset: input.replacementStartOffset,","+    attributeName,","+    attribute,","+    block,","+    blockKeyword,","+  };","+}","+","+function classifyModelAttribute(input: AttributeClassifierInput): PslCompletionContext | undefined {","+  const attribute = activeModelAttribute(input);","+  if (attribute === undefined) {","+    return undefined;","+  }","+  const model = attribute.syntax.findAncestor(ModelDeclarationAst.cast);","+  if (model === undefined) {","+    return undefined;","+  }","+  if (isAttributeNamePosition(attribute, input.offset)) {","+    return {","+      kind: 'modelAttributeName',","+      offset: input.offset,","+      replacementStartOffset: input.replacementStartOffset,","+      attribute,","+      model,","+    };","+  }","+  const attributeName = attributeNamedKeyName(attribute, input.offset);","+  if (attributeName === undefined) {","+    return UNSUPPORTED;","+  }","+  return {","+    kind: 'modelAttributeNamedKey',","+    offset: input.offset,","+    replacementStartOffset: input.replacementStartOffset,","+    attributeName,","+    attribute,","+    model,","+  };","+}","+","+function activeModelAttribute(input: AttributeClassifierInput): ModelAttributeAst | undefined {","+  const attribute = input.node?.findAncestor(ModelAttributeAst.cast);","+  if (attribute === undefined || attribute.syntax.isOutside(input.offset)) {","+    return undefined;","+  }","+  return attribute;","+}","+","+function isAttributeNamePosition(","+  attribute: FieldAttributeAst | ModelAttributeAst,","+  offset: number,","+): boolean {","+  const argList = attribute.argList();","+  return !argList?.syntax.isInside(offset);","+}","+","+function attributeNamedKeyName(","+  attribute: FieldAttributeAst | ModelAttributeAst,","+  offset: number,","+): string | undefined {","+  const argList = attribute.argList();","+  if (argList === undefined || argList.syntax.isOutside(offset)) {","+    return undefined;","+  }","+  const rparen = argList.rparen();","+  if (rparen !== undefined && offset >= rparen.endOffset) {","+    return undefined;","+  }","+  for (const arg of argList.args()) {","+    const colon = arg.colon();","+    if (","+      colon !== undefined &&","+      offset > colon.offset &&","+      offset >= arg.syntax.offset &&","+      offset <= arg.syntax.endOffset","+    ) {","+      return undefined;","+    }","+  }","+  const token = attribute.syntax.tokenAtOffset(offset).leftBiased();","+  if (token?.kind === 'Colon') {","+    return undefined;","+  }","+  const node = token?.parent;","+  const activeArg = node?.findAncestor(AttributeArgAst.cast);","+  if (activeArg === undefined && node?.kind !== 'AttributeArgList') {","+    return undefined;","+  }","+  if (activeArg !== undefined) {","+    const colon = activeArg.colon();","+    if (colon !== undefined && offset > colon.offset) {","+      return undefined;","+    }","+    const value = activeArg.value();","+    if (","+      colon === undefined &&","+      value !== undefined &&","+      value.syntax.kind !== 'Identifier' &&","+      value.syntax.isInside(offset)","+    ) {","+      return undefined;","+    }","+  }","+  const attributeName = attribute.name()?.identifier()?.name();","+  if (attributeName === undefined) {","+    return undefined;","+  }","+  return attributeName;","+}","+"," function classifyGenericBlockParameter(input: {","   readonly offset: number;","   readonly at: TokenAtOffset;"],"additions":261,"deletions":0,"truncated":false},{"path":"packages/1-framework/3-tooling/language-server/src/completion-provider.ts","lines":["@@ -2,10 +2,35 @@ import {","   type AuthoringPslBlockDescriptorNamespace,","   isAuthoringPslBlockDescriptor,"," } from '@internal/framework-components/authoring';","-import { findBlockDescriptor, type NamespaceSymbol, type SymbolTable } from '@internal/psl-parser';","-import type { GenericBlockDeclarationAst, SourceFile } from '@internal/psl-parser/syntax';","+import type {","+  AssembledAuthoringContributions,","+  ControlMutationDefaults,","+} from '@internal/framework-components/control';","+import {","+  type AttributeSpec,","+  assembleAttributeSpecs,","+  type BlockAttributeSpecFactory,","+  type FieldSymbol,","+  findBlockDescriptor,","+  type ModelSymbol,","+  type NamespaceSymbol,","+  type Param,","+  type PositionalParam,","+  type SymbolTable,","+} from '@internal/psl-parser';","+import type {","+  FieldAttributeAst,","+  FieldDeclarationAst,","+  GenericBlockDeclarationAst,","+  ModelAttributeAst,","+  ModelDeclarationAst,","+  SourceFile,","+} from '@internal/psl-parser/syntax';","+import { blindCast } from '@internal/utils/casts';"," import { type CompletionItem, CompletionItemKind, InsertTextFormat } from 'vscode-languag