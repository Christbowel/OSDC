oursUpper\" },","+            new(\"2.5Hr\", 90_000_000_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_HoursTitle\" },","+            new(\"2.5hR\", 90_000_000_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_HoursMixed\" },","+            new(\" \\t+1.25 mS\\r\\n\", 12_500L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_Whitespace\" },","+            new(\"-0.00015MS\", -1L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_NegativeSubTickTruncation\" },","+            new(\"2.5\", 25_000_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_DefaultSeconds\" },","+            new(\"+1.25\", 12_500_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_PositiveDefault\" },","+            new(\"-1.25\", -12_500_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_NegativeDefault\" },","+            new(\"0.00000015\", 1L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_FractionalDefaultTickTruncation\" },","+            new(\"0hr\", 0L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_Zero\" },","+            new(\"1e2s\", 1_000_000_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_InvariantExponent\" },","+            new(\"1,234.5s\", 12_345_000_000L) { TestDisplayName = \"ParseTimeSpan_ExactTicks_InvariantGrouping\" },","+        ];","+","+        [Theory, MemberData(nameof(TimeSpanCases)), TestCategory(\"Functional\"), TestCategory(\"Config\")]","+        public void ParseTimeSpan_ExactTicks(string input, long expectedTicks)","+        {","+            var result = ConfigUtilities.ParseTimeSpan(input, \"Invalid duration\");","+","+            Assert.Equal(expectedTicks, result.Ticks);","+        }","+","+        [Fact, TestCategory(\"Functional\"), TestCategory(\"Config\")]","+        public void ParseTimeSpan_UsesInvariantCultureUnderFrenchCurrentCulture()","+        {","+            // CurrentCulture is local to this execution context, not a process-wide default.","+            var previousCulture = CultureInfo.CurrentCulture;","+            try","+            {","+                CultureInfo.CurrentCulture = CultureInfo.GetCultureInfo(\"fr-FR\");","+","+                var result = ConfigUtilities.ParseTimeSpan(\"1,234.5S\", \"Invalid duration\");","+","+                Assert.Equal(12_345_000_000L, result.Ticks);","+            }","+            finally","+            {","+                CultureInfo.CurrentCulture = previousCulture;","+            }","+        }","+","+        public static IEnumerable<TheoryDataRow<string>> InvalidTimeSpanCases =>","+        [","+            new(\" 1day \") { TestDisplayName = \"ParseTimeSpan_InvalidInput_UnsupportedUnit\" },","+            new(\"not-a-numbermS\") { TestDisplayName = \"ParseTimeSpan_InvalidInput_MalformedNumber\" },","+            new(\"1\\u017F\") { TestDisplayName = \"ParseTimeSpan_InvalidInput_UnicodeSecondSuffix\" },","+            new(\"1m\\u017F\") { TestDisplayName = \"ParseTimeSpan_InvalidInput_UnicodeMillisecondSuffix\" },","+        ];","+","+        [Theory, MemberData(nameof(InvalidTimeSpanCases)), TestCategory(\"Functional\"), TestCategory(\"Config\")]","+        public void ParseTimeSpan_InvalidInput_PreservesCustomError(string input)","+        {","+            var exception = Assert.Throws<FormatException>(() => ConfigUtilities.ParseTimeSpan(input, \"Custom duration error\"));","+","+            Assert.Equal(\"Custom duration error. Tried to parse \" + input, exception.Message);","+        }","+","         /// <summary>","         /// Tests that Azure Storage connection strings have their account keys properly redacted.","         /// This prevents sensitive authentication information from being exposed in logs.","@@ -113,6 +182,29 @@ public void CollectionAttributes_ValidProperties_PreserveIdleDeactivationValues(","                 keepAliveProperties[WellKnownGrainTypeProperties.IdleDeactivationPeriod]);","         }"," ","+        [Fact, TestCategory(\"Functional\"), TestCategory(\"Config\")]","+        public void DurationAttributes_ExposeParsedTimeSpanValuesAndPreserveCollectionMetadata()","+        {","+            var response = new ResponseTimeoutAttribute(\"00:00:42\");","+            var collection = new CollectionAgeLimitAttribute(\"00:01:15\");","+            var properties = new Dictionary<string, string>();","+","+            collection.Populate(null!, null!, default, properties);","+","+            Assert.Equal(TimeSpan.FromSeconds(42), response.Timeout);","+            Assert.Equal(TimeSpan.FromSeconds(75), collection.AgeLimit);","+            Assert.Equal(\"00:01:15\", properties[WellKnownGrainTypeProperties.IdleDeactivationPeriod]);","+        }","+","+        [Theory, TestCategory(\"Functional\"), TestCategory(\"Config\")]","+        [InlineData(\"\")]","+        [InlineData(\"not-a-duration\")]","+        public void DurationAttributes_InvalidDuration_PropagatesFormatException(string duration)","+        {","+            Assert.Throws<FormatException>(() => new ResponseTimeoutAttribute(duration));","+            Assert.Throws<FormatException>(() => new CollectionAgeLimitAttribute(duration));","+        }","+","         [Fact, TestCategory(\"Functional\"), TestCategory(\"Config\")]","         public void ClusterOptionsValidator_NullOptions_ThrowsWithExactParameterName()","         {"],"additions":92,"deletions":0,"truncated":false},{"path":"test/Orleans.Core.Tests/Manifest/AttributeGrainPropertiesProviderTests.cs","lines":["@@ -0,0 +1,122 @@","+using Microsoft.Extensions.DependencyInjection;","+using Orleans.Concurrency;","+using Orleans.GrainDirectory;","+using Orleans.Metadata;","+using Orleans.Placement;","+using Orleans.Runtime;","+using Xunit;","+","+namespace UnitTests.Manifest;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestCategory(\"BVT\"), TestCategory(\"Manifest\")]","+public sealed class AttributeGrainPropertiesProviderTests","+{","+    [Theory]","+    [InlineData(false)]","+    [InlineData(true)]","+    public void NullGrainClassPreservesExistingProperties(bool bindings)","+    {","+        using var services = new ServiceCollection().BuildServiceProvider();","+        var provider = CreateProvider(services, bindings);","+        var properties = new Dictionary<string, string> { [\"existing\"] = \"value\" };","+","+        var exception = Assert.Throws<ArgumentNullException>(() => provider.Populate(null!, default, properties));","+","+        Assert.Equal(\"grainClass\", exception.ParamName);","+        Assert.Equal(\"value\", Assert.Single(properties).Value);","+    }","+","+    [Theory]","+    [InlineData(false)]","+    [InlineData(true)]","+    public void NullPropertyCollectionIsRejectedForUnannotatedClass(bool bindings)","+    {","+        using var services = new ServiceCollection().BuildServiceProvider();","+        var provider = CreateProvider(services, bindings);","+","+        var exception = Assert.Throws<ArgumentNullException>(() => provider.Populate(typeof(object), default, null!));","+","+        Assert.Equal(\"properties\", exception.ParamName);","+    }","+","+    [Fact]","+    public void PropertyAttributesReceiveServicesAndOriginalDerivedClass()","+    {","+        using var services = new ServiceCollection().AddSingleton(\"service-marker\").BuildServiceProvider();","+        var properties = new Dictionary<string, string> { [\"existing\"] = \"value\" };","+        var grainType = GrainType.Create(\"test.grain\");","+","+        new AttributeGrainPropertiesProvider(services).Populate(typeof(DerivedGrain), grainType, properties);","+","+        Assert.Equal(4, properties.Count);","+        Assert.Equal(\"value\", properties[\"existing\"]);","+        Assert.Equal(\"service-marker\", properties[\"service\"]);","+        Assert.Equal(nameof(DerivedGrain), properties[\"class\"]);","+        Assert.Equal(\"test.grain\", properties[\"grain\"]);","+    }","+","+    [Fact]","+    public void BuiltInAttributesComposeMetadataAfterProviderAdmission()","+    {","+        using var services = new ServiceCollection().BuildServiceProvider();","+        var properties = new Dictionary<string, string> { [\"existing\"] = \"value\" };","+","+        new AttributeGrainPropertiesProvider(services).Populate(typeof(BuiltInPropertyGrain), GrainType.Create(\"test.grain\"), properties);","+","+        Assert.Equal(5, properties.Count);","+        Assert.Equal(\"value\", properties[\"existing\"]);","+        Assert.Equal(\"true\", properties[WellKnownGrainTypeProperties.Reentrant]);","+        Assert.Equal(\"CanInterleave\", properties[WellKnownGrainTypeProperties.MayInterleavePredicate]);","+        Assert.Equal(\"named-directory\", properties[WellKnownGrainTypeProperties.GrainDirectory]);","+        Assert.Equal(\"1\", properties[WellKnownGrainTypeProperties.Immovable]);","+    }","+","+    [Fact]","+    public void BindingAttributesPreserveGroupingAndDefaultMapperSentinel()","+    {","+        using var services = new ServiceCollection().AddSingleton(\"service-marker\").BuildServiceProvider();","+        var properties = new Dictionary<string, string> { [\"existing\"] = \"value\" };","+","+        new AttributeGrainBindingsProvider(services).Populate(typeof(DerivedGrain), GrainType.Create(\"test.grain\"), properties);","+","+        Assert.Equal(5, properties.Count);","+        Assert.Equal(\"value\", properties[\"existing\"]);","+        Assert.Equal(\"service-marker\", properties[\"binding.attr-1.type\"]);","+        Assert.Null(properties[\"binding.attr-1.mapper\"]);","+        Assert.Equal(nameof(DerivedGrain), properties[\"binding.attr-2.type\"]);","+        Assert.Equal(\"test.grain\", properties[\"binding.attr-2.grain\"]);","+    }","+","+    private static IGrainPropertiesProvider CreateProvider(IServiceProvider services, bool bindings)","+        => bindings ? new AttributeGrainBindingsProvider(services) : new AttributeGrainPropertiesProvider(services);","+","+    [TestProperties, TestBindings]","+    private class BaseGrain { }","+    private sealed class DerivedGrain : BaseGrain { }","+","+    [Reentrant, MayInterleave(\"CanInterleave\"), GrainDirectory(\"named-directory\"), Immovable(ImmovableKind.Repartitioner)]","+    private sealed class BuiltInPropertyGrain { }","+","+    [AttributeUsage(AttributeTargets.Class, Inherited = true)]","+    private sealed class TestPropertiesAttribute : Attribute, IGrainPropertiesProviderAttribute","+    {","+        public void Populate(IServiceProvider services, Type grainClass, GrainType grainType, Dictionary<string, string> properties)","+        {","+            properties[\"service\"] = services.GetRequiredService<string>();","+            properties[\"class\"] = grainClass.Name;","+            properties[\"grain\"] = grainType.ToString();","+        }","+    }","+","+    [AttributeUsage(AttributeTargets.Class, Inherited = true)]","+    private sealed class TestBindingsAttribute : Attribute, IGrainBindingsProviderAttribute","+    {","+        public IEnumerable<Dictionary<string, string?>> GetBindings(IServiceProvider services, Type grainClass, GrainType grainType)","+        {","+            yield return new() { [\"type\"] = services.GetRequiredService<string>(), [\"mapper\"] = null };","+            yield return new() { [\"type\"] = grainClass.Name, [\"grain\"] = grainType.ToString() };","+        }","+    }","+}",""],"additions":122,"deletions":0,"truncated":false}],"additions":250,"deletions":5,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-14T15:14:26.477497+00:00"}