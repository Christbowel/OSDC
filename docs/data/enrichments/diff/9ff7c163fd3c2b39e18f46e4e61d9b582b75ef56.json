      clearers.forEach(clear -> clear.accept(builder));","+        return builder.build();","+    }","+","+    public void rejectOpikManagedKeys(@Nullable Map<String, Object> customParameters) {","+        rejectOpikManagedKeys(OPIK_MANAGED_KEYS, customParameters);","+    }","+","+    public void rejectOpikManagedKeys(@NonNull List<String> opikManagedKeys,","+            @Nullable Map<String, Object> customParameters) {","+        if (MapUtils.isEmpty(customParameters)) {","+            return;","+        }","+        opikManagedKeys.stream()","+                .filter(customParameters::containsKey)","+                .findFirst()","+                .ifPresent(key -> {","+                    throw new BadRequestException(","+                            \"custom_parameters.%s is set by Opik from the request and cannot be replaced\"","+                                    .formatted(key));","+                });","+    }","+","+    public @Nullable Map<String, Object> moveTokenLimitTo(@NonNull String limitKey,","+            @Nullable Map<String, Object> customParameters) {","+        var otherKey = MAX_TOKENS.equals(limitKey) ? MAX_COMPLETION_TOKENS : MAX_TOKENS;","+        if (MapUtils.isEmpty(customParameters) || !customParameters.containsKey(otherKey)) {","+            return customParameters;","+        }","+        var moved = new LinkedHashMap<>(customParameters);","+        var otherValue = moved.remove(otherKey);","+        moved.putIfAbsent(limitKey, otherValue);","+        return moved;","+    }","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/llm/customllm/CustomLlmProvider.java","lines":["@@ -2,6 +2,7 @@"," "," import com.comet.opik.api.LlmProvider;"," import com.comet.opik.domain.llm.LlmProviderService;","+import com.comet.opik.infrastructure.llm.CustomParametersOverrides;"," import com.comet.opik.infrastructure.llm.LlmProviderLangChainMapper;"," import com.comet.opik.infrastruct