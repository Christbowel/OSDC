{","+  const ref = useRef<HTMLDivElement>(null)","+  const [height, setHeight] = useState(0)","+","+  useEffect(() => {","+    const element = ref.current","+    if (!element) return","+    const observer = new ResizeObserver(([entry]) => {","+      setHeight(entry.contentRect.height)","+    })","+    observer.observe(element)","+    return () => observer.disconnect()","+  }, [])","+","+  const roomy = height >= (compact ? MIN_HEIGHT_COMPACT : MIN_HEIGHT)","+","+  return (","+    <div","+      ref={ref}","+      className=\"pointer-events-none relative -mx-3 -mb-4 min-h-0 flex-1 basis-0 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_30%)]\"","+      aria-hidden","+    >","+      {roomy && (compact ? <CompactScene /> : <FullScene />)}","+    </div>","+  )","+}"],"additions":339,"deletions":0,"truncated":false},{"path":"apps/console/src/hooks/use-halloween.ts","lines":["@@ -0,0 +1,18 @@","+import { useEffect, useState } from 'react'","+import { useVisitorCountryCode } from '@/hooks/use-visitor-country'","+import { isHalloween } from '@/lib/halloween'","+","+/**","+ * True during Halloween week for visitors in a celebrating country.","+ * Always false on SSR and the hydrating paint, since the date is the visitor's local one.","+ */","+export function useHalloween(): boolean {","+  const countryCode = useVisitorCountryCode()","+  const [now, setNow] = useState<Date | null>(null)","+","+  useEffect(() => {","+    setNow(new Date())","+  }, [])","+","+  return now !== null && isHalloween(now, countryCode)","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"apps/console/src/lib/halloween.ts","lines":["@@ -0,0 +1,47 @@","+import { normalizeVisitorCountryCode } from '@/lib/visitor-country-shared'","+","+/** ISO 3166-1 alpha-2 countries where Halloween is widely celebrated. */","+export const HALLOWEEN_COUNTRIES: ReadonlySet<string> = new Set([","+  'US',","+  'CA',","+  'MX',","+  'PR',","+  'IE',","+  'GB',","+  'IM',","+  'JE',","+  'GG',","+  'AU',","+  'NZ',","+  'DE',","+  'NL',","+  'BE',","+  'JP',","+  'KR',","+  'PH',","+])","+","+const OCTOBER = 9","+const HALLOWEEN_DAY = 31","+","+/** Days the decorations show, ending on Halloween itself (local calendar). */","+export const HALLOWEEN_SEASON_DAYS = 7","+","+export function isHalloweenSeason(date: Date): boolean {","+  if (date.getMonth() !== OCTOBER) return false","+  return date.getDate() > HALLOWEEN_DAY - HALLOWEEN_SEASON_DAYS","+}","+","+export function isHalloweenCountry(","+  countryCode: string | null | undefined,","+): boolean {","+  const normalized = normalizeVisitorCountryCode(countryCode)","+  return normalized !== null && HALLOWEEN_COUNTRIES.has(normalized)","+}","+","+export function isHalloween(","+  date: Date,","+  countryCode: string | null | undefined,","+): boolean {","+  return isHalloweenSeason(date) && isHalloweenCountry(countryCode)","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"apps/console/src/lib/i18n/dictionaries/he/shared-ui.ts","lines":["@@ -1405,4 +1405,7 @@ export const heSharedUiDictionary: Record<string, string> = {","   'Repository not available': 'ה-repo לא זמין',","   'This Git installation can no longer reach the repository. It may have been deleted, removed from the installation, or moved to another installation. Connect the repository again to keep deploying.':","     'התקנת ה-Git הזו כבר לא מגיעה ל-repo. ייתכן שהוא נמחק, הוסר מההתקנה או הועבר להתקנה אחרת. חברו את ה-repo מחדש כדי להמשיך לפרוס.',","+  // Halloween caution tape","+  Caution: 'זהירות',","+  'Spooky zone': 'אזור מפחיד',"," }"],"additions":3,"deletions":0,"truncated":false},{"path":"apps/console/src/lib/i18n/dictionaries/ja/shared-ui.ts","lines":["@@ -1367,4 +1367,7 @@ export const jaSharedUiDictionary: Record<string, string> = {","   'Repository not available': 'リポジトリを利用できません',","   'This Git installation can no longer reach the repository. It may have been deleted, removed from the installation, or moved to another installation. Connect the repository again to keep deploying.':","     'この Git インストールからリポジトリにアクセスできなくなりました。削除された、インストールから外された、または別のインストールに移された可能性があります。デプロイを続けるには、リポジトリを接続し直してください。',","+  // Halloween caution tape","+  Caution: '注意',","+  'Spooky zone': '恐怖ゾーン',"," }"],"additions":3,"deletions":0,"truncated":false},{"path":"apps/console/src/styles.css","lines":["@@ -1098,6 +1098,215 @@ html:not([lang='en']):not([lang='he']) {","   }"," }"," ","+/* Halloween: header cobwebs, sidebar graveyard scene, and terminal caution tape */","+@keyframes halloween-twinkle {","+  0%,","+  100% {","+    opacity: 1;","+  }","+  50% {","+    opacity: 0.35;","+  }","+}","+","+@keyframes halloween-flicker {","+  0%,","+  100% {","+    opacity: 1;","+  }","+  12% {","+    opacity: 0.7;","+  }","+  24% {","+    opacity: 0.95;","+  }","+  38% {","+    opacity: 0.65;","+  }","+  55% {","+    opacity: 1;","+  }","+  70% {","+    opacity: 0.8;","+  }","+}","+","+@keyframes halloween-flap {","+  0%,","+  100% {","+    transform: scaleY(1);","+  }","+  50% {","+    transform: scaleY(0.4);","+  }","+}","+","+@keyframes halloween-fly {","+  0% {","+    transform: translate(0, 0);","+  }","+  15% {","+    transform: translate(-70px, -12px);","+  }","+  30% {","+    transform: translate(-140px, 6px);","+  }","+  45% {","+    transform: translate(-210px, -8px);","+  }","+  60%,","+  100% {","+    transform: translate(-290px, 0);","+  }","+}","+","+@keyframes halloween-orbit {","+  0%,","+  100% {","+    transform: translate(34px, 0);","+  }","+  12.5% {","+    transform: translate(24px, -10px);","+  }","+  25% {","+    transform: translate(0, -14px);","+  }","+  37.5% {","+    transform: translate(-24px, -10px);","+  }","+  50% {","+    transform: translate(-34px, 0);","+  }","+  62.5% {","+    transform: translate(-24px, 10px);","+  }","+  75% {","+    transform: translate(0, 14px);","+  }","+  87.5% {","+    transform: translate(24px, 10px);","+  }","+}","+","+@keyframes halloween-float {","+  from {","+    transform: translateY(0) rotate(-3deg);","+    opacity: 0.95;","+  }","+  to {","+    transform: translateY(-8px) rotate(3deg);","+    opacity: 0.6;","+  }","+}","+","+@keyframes halloween-thread {","+  from {","+    transform: scaleY(1);","+  }","+  to {","+    transform: scaleY(1.4);","+  }","+}","+","+@keyframes halloween-spider {","+  from {","+    transform: translateY(0);","+  }","+  to {","+    transform: translateY(10px);","+  }","+}","+","+@keyframes halloween-drift {","+  from {","+    transform: translateX(-14px);","+  }","+  to {","+    transform: translateX(14px);","+  }","+}","+","+@keyframes halloween-scene-in {","+  from {","+    opacity: 0;","+    transform: translateY(12px);","+  }","+  to {","+    opacity: 1;","+    transform: translateY(0);","+  }","+}","+","+@keyframes halloween-marquee {","+  from {","+    transform: translateX(0);","+  }","+  to {","+    transform: translateX(-50%);","+  }","+}","+","+.halloween-marquee {","+  animation: halloween-marquee 40s linear infinite;","+}","+","+.halloween-scene-in {","+  animation: halloween-scene-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both;","+}","+","+.halloween-scene-twinkle {","+  animation: halloween-twinkle 3s ease-in-out infinite;","+}","+","+.halloween-scene-flicker {","+  animation: halloween-flicker 2.4s linear infinite;","+}","+","+.halloween-scene-flap {","+  animation: halloween-flap 0.32s ease-in-out infinite;","+  transform-box: fill-box;","+  transform-origin: center;","+}","+","+.halloween-scene-fly {","+  animation: halloween-fly 16s linear infinite;","+}","+","+.halloween-scene-fly-late {","+  animation-delay: -7s;","+  animation-duration: 21s;","+}","+","+.halloween-scene-orbit {","+  animation: halloween-orbit 7s linear infinite;","+}","+","+.halloween-scene-ghost {","+  animation: halloween-float 3.6s ease-in-out infinite alternate;","+  transform-box: fill-box;","+  transform-origin: center;","+}","+","+.halloween-scene-thread {","+  animation: halloween-thread 5s ease-in-out infinite alternate;","+  transform-box: fill-box;","+  transform-origin: center top;","+}","+","+.halloween-scene-spider {","+  animation: halloween-spider 5s ease-in-out infinite alternate;","+}","+","+.halloween-scene-fog {","+  animation: halloween-drift 10s ease-in-out infinite alternate;","+}","+","+@media (prefers-reduced-motion: reduce) {","+  [class*='halloween-'] {","+    animation: none !important;","+  }","+}","+"," .upgrade-button-wrapper {","   position: relative;","   padding: 1px;"],"additions":209,"deletions":0,"truncated":false},{"path":"apps/console/tests/unit/halloween.test.ts","lines":["@@ -0,0 +1,42 @@","+import { describe, expect, test } from 'bun:test'","+import {","+  isHalloween,","+  isHalloweenCountry,","+  isHalloweenSeason,","+} from '@/lib/halloween'","+","+describe('isHalloweenSeason', () => {","+  test.each([","+    ['2026-10-25T00:00:00', true],","+    ['2026-10-31T23:59:00', true],","+    ['2026-10-24T23:59:00', false],","+    ['2026-11-01T00:00:00', false],","+    ['2026-03-31T12:00:00', false],","+  ])('%s → %p', (iso, expected) => {","+    expect(isHalloweenSeason(new Date(iso))).toBe(expected)","+  })","+})","+","+describe('isHalloweenCountry', () => {","+  test('matches celebrating countries case-insensitively', () => {","+    expect(isHalloweenCountry('US')).toBe(true)","+    expect(isHalloweenCountry('ie')).toBe(true)","+  })","+","+  test('rejects other, unknown, and missing countries', () => {","+    expect(isHalloweenCountry('IL')).toBe(false)","+    expect(isHalloweenCountry('XX')).toBe(false)","+    expect(isHalloweenCountry(null)).toBe(false)","+  })","+})","+","+describe('isHalloween', () => {","+  test('requires both the season and a celebrating country', () => {","+    const halloween = new Date('2026-10-31T12:00:00')","+    const spring = new Date('2026-04-01T12:00:00')","+","+    expect(isHalloween(halloween, 'GB')).toBe(true)","+    expect(isHalloween(halloween, 'IN')).toBe(false)","+    expect(isHalloween(spring, 'GB')).toBe(false)","+  })","+})",""],"additions":42,"deletions":0,"truncated":false}],"additions":853,"deletions":6,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-10-31T14:36:03.063906+00:00"}