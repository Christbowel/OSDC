{"id":"c4b144daed5832d140c0146dd95ed59d96a606f8","axis":"silent","repo":"WordPress/wordpress-develop","sha":"c4b144daed5832d140c0146dd95ed59d96a606f8","parsed":{"files":[{"path":".github/workflows/phpstan-static-analysis.yml","lines":["@@ -21,6 +21,9 @@ on:","       - 'tests/phpstan/base.neon'","       - 'tests/phpstan/baselines/**'","       - 'tests/phpstan/baselines-strict/**'","+      # These files configure the tests of the PHPStan extensions, and hold their fixtures.","+      - 'tests/phpstan/phpunit.xml.dist'","+      - 'tests/phpstan/Tests/**'","       # Confirm any changes to relevant workflow files.","       - '.github/workflows/phpstan-static-analysis.yml'","       - '.github/workflows/reusable-phpstan-static-analysis-v2.yml'"],"additions":3,"deletions":0,"truncated":false},{"path":".github/workflows/reusable-phpstan-static-analysis-v2.yml","lines":["@@ -38,6 +38,7 @@ jobs:","   # - Runs PHPStan static analysis.","   # - Reports the results as annotations.","   # - Uploads the results as an artifact (pull requests only).","+  # - Runs the tests of the WordPress-specific PHPStan extensions (default analysis only).","   # - Checks for errors that cannot be reported as warnings, such as out-of-date baselines.","   # - Saves the PHPStan result cache.","   # - Ensures version-controlled files are not modified or deleted.","@@ -277,6 +278,20 @@ jobs:","           name: ${{ matrix.artifact }}","           path: ${{ runner.temp }}/phpstan-results/"," ","+      # The extensions in `tests/phpstan` are tested against fixtures rather than against","+      # core, so a defect in one is reported here as a failing test rather than as a","+      # change in what the analysis above reports.","+      #","+      # This runs after the results are reported and uploaded, so that a failing test","+      # does not also keep the pull request from being annotated and commented on. It","+      # runs even when the analysis failed, since the two are independent, but not when","+      # the analysis was skipped: that means a step setting up the job, such as installing","+      # the Composer dependencies, failed, and the tests could only fail along with it.","+      # Both analyses load the same extensions, so the tests run in only one of them.","+      - name: Run the tests of the PHPStan extensions","+        if: ${{ !cancelled() && steps.phpstan.outcome != 'skipped' && matrix.analysis == 'default' && hashFiles('tests/phpstan/phpunit.xml.dist') != '' }}","+        run: composer run phpstan:test","+","       # Some errors cannot be ignored, so they cannot be reported as warnings either. Most often","       # this is an ignored error that no longer occurs, or occurs a different number of times,","       # which is reported under an `ignore.*` identifier. That is not something to fix in the"],"additions":15,"deletions":0,"truncated":false},{"path":"composer.json","lines":["@@ -80,6 +80,7 @@"," \t\t\"phpstan:strict\": [ \"Composer\\\\Config::disableProcessTimeout\", \"@php ./vendor/bin/phpstan analyse --configuration=phpstan-strict.neon.dist --memory-limit=2G\" ],"," \t\t\"phpstan:baselines\": [ \"Composer\\\\Config::disableProcessTimeout\", \"@php ./tests/phpstan/generate-baselines.php\" ],"," \t\t\"phpstan:fix\": [ \"Composer\\\\Config::disableProcessTimeout\", \"@php ./tests/phpstan/analyse.php --memory-limit=2G --fix\" ],","+\t\t\"phpstan:test\": \"@php ./vendor/phpunit/phpunit/phpunit -c tests/phpstan/phpunit.xml.dist\","," \t\t\"compat\": \"@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcompat.xml.dist --report=summary,source\","," \t\t\"format\": \"@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf --report=summary,source\","," \t\t\"lint\": \"@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --report=summary,source\","],"additions":1,"deletions":0,"truncated":false},{"path":"package.json","lines":["@@ -155,6 +155,7 @@"," \t\t\"typecheck:php\": \"node ./tools/local-env/scripts/docker.js run --rm php composer phpstan --\","," \t\t\"typecheck:php:baselines\": \"node ./tools/local-env/scripts/docker.js run --rm php composer phpstan:baselines --\","," \t\t\"typecheck:php:fix\": \"node ./tools/local-env/scripts/docker.js run --rm php composer phpstan:fix --\",","+\t\t\"typecheck:php:test\": \"node ./tools/local-env/scripts/docker.js run --rm php composer phpstan:test --\","," \t\t\"gutenberg:copy\": \"node tools/gutenberg/copy.js\","," \t\t\"gutenberg:verify\": \"node tools/gutenberg/utils.js\","," \t\t\"gutenberg:download\": \"node tools/gutenberg/download.js && npm run build:gutenberg\""],"additions":1,"deletions":0,"truncated":false},{"path":"tests/phpstan/README.md","lines":["@@ -209,6 +209,26 @@ These identifiers are specific to WordPress, and can be ignored or baselined lik"," | `wordpress.hookDocReferenceHookMissing` | The referenced file exists, but documents no hook of that name. Either the reference is stale, or the canonical docblock has moved. |"," | `wordpress.hookParamCountMismatch` | The call passes a different number of arguments than the docblock documents `@param` tags for. Passing fewer risks an `ArgumentCountError` in a callback registered for the documented count; passing more silently drops the extra argument and leaves the documentation misleading. |"," ","+### Testing the extensions","+","+The extensions have tests of their own under [`Tests/`](Tests), built on PHPStan's test harness. The two rules are run over fixture files and the errors they report are compared with the ones expected. The visitors and the return type extension are checked through the types PHPStan infers for the `assertType()` calls in their fixtures. Reference comments resolve against a small WordPress tree of fixtures in [`Tests/data/wordpress`](Tests/data/wordpress) rather than against `src`, so a broken reference can be tested without one existing in core.","+","+The harness parses every file the way an analyzed file is parsed, so one test, `ReflectionParserTest`, runs a real analysis with `base.neon` instead. It checks that a function declared in a file that is only scanned is reflected with the shape its hash notation describes, which depends on the redefinition of `currentPhpVersionSimpleParser` there.","+","+Run them with:","+","+```bash","+npm run typecheck:php:test","+```","+","+or, outside the Docker environment:","+","+```bash","+composer phpstan:test","+```","+","+They also run in CI, after the analysis of the whole codebase, so that a failing test does not keep its results from being reported.","+"," ## Ignoring and baselining errors"," "," As we adopt PHPStan iteratively, you may be faced with false positives due to legacy code, or code that is not worth changing at this time."],"additions":20,"deletions":0,"truncated":false},{"path":"tests/phpstan/Tests/ApplyFiltersDynamicFunctionReturnTypeExtensionTest.php","lines":["@@ -0,0 +1,49 @@","+<?php","+/**","+ * Tests for ApplyFiltersDynamicFunctionReturnTypeExtension.","+ *","+ * @package WordPress","+ */","+","+declare(strict_types=1);","+","+namespace WordPress\\PHPStan\\Tests;","+","+use PHPStan\\Testing\\TypeInferenceTestCase;","+","+/**","+ * Checks the type PHPStan infers for a filtered value against the `assertType()`","+ * calls in the fixtures.","+ */","+final class ApplyFiltersDynamicFunctionReturnTypeExtensionTest extends TypeInferenceTestCase {","+","+\t/**","+\t * Gathers the assertions from the fixtures.","+\t *","+\t * @return iterable<string, mixed[]>","+\t */","+\tpublic function data_file_asserts(): iterable {","+\t\tyield from self::gatherAssertTypes( __DIR__ . '/data/apply-filters.php' );","+\t\tyield from self::gatherAssertTypes( __DIR__ . '/data/ApplyFiltersTestClass.php' );","+\t}","+","+\t/**","+\t * @dataProvider data_file_asserts","+\t *","+\t * @param string $assert_type Kind of assertion.","+\t * @param string $file        Fixture file.","+\t * @param mixed  ...$args     Assertion arguments.","+\t */","+\tpublic function test_file_asserts( string $assert_type, string $file, ...$args ): void {","+\t\t$this->assertFileAsserts( $assert_type, $file, ...$args );","+\t}","+","+\t/**","+\t * Returns the configuration registering the extension and the visitors it relies on.","+\t *","+\t * @return list<string>","+\t */","+\tpublic static function getAdditionalConfigFiles(): array {","+\t\treturn array( __DIR__ . '/tests.neon' );","+\t}","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"tests/phpstan/Tests/GlobalDocBlockVisitorTest.php","lines":["@@ -0,0 +1,49 @@","+<?php","+/**","+ * Tests for GlobalDocBlockVisitor.","+ *","+ * @package WordPress","+ */","+","+declare(strict_types=1);","+","+namespace WordPress\\PHPStan\\Tests;","+","+use PHPStan\\Testing\\TypeInferenceTestCase;","+","+/**","+ * Checks the type PHPStan infers for an imported global against the `assertType()`","+ * calls in the fixtures.","+ */","+final class GlobalDocBlockVisitorTest extends TypeInferenceTestCase {","+","+\t/**","+\t * Gathers the assertions from the fixtures.","+\t *","+\t * @return iterable<string, mixed[]>","+\t */","+\tpublic function data_file_asserts(): iterable {","+\t\tyield from self::gatherAssertTypes( __DIR__ . '/data/global-docblock.php' );","+\t\tyield from self::gatherAssertTypes( __DIR__ . '/data/GlobalDocBlockTestClass.php' );","+\t}","+","+\t/**","+\t * @dataProvider data_file_asserts","+\t *","+\t * @param string $assert_type Kind of assertion.","+\t * @param string $file        Fixture file.","+\t * @param mixed  ...$args     Assertion arguments.","+\t */","+\tpublic function test_file_asserts( string $assert_type, string $file, ...$args ): void {","+\t\t$this->assertFileAsserts( $assert_type, $file, ...$args );","+\t}","+","+\t/**","+\t * Returns the configuration registering the visitor.","+\t *","+\t * @return list<string>","+\t */","+\tpublic static function getAdditionalConfigFiles(): array {","+\t\treturn array( __DIR__ . '/tests.neon' );","+\t}","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"tests/phpstan/Tests/HashNotationTypeTest.php","lines":["@@ -0,0 +1,47 @@","+<?php","+/**","+ * Tests the types PHPStan infers once HashNotationVisitor has translated a hash.","+ *","+ * @package WordPress","+ */","+","+declare(strict_types=1);","+","+namespace WordPress\\PHPStan\\Tests;","+","+use PHPStan\\Testing\\TypeInferenceTestCase;","+","+/**","+ * Checks the `assertType()` calls in the hash notation fixture.","+ */","+final class HashNotationTypeTest extends TypeInferenceTestCase {","+","+\t/**","+\t * Gathers the assertions from the fixture.","+\t *","+\t * @return iterable<string, mixed[]>","+\t */","+\tpublic function data_file_asserts(): iterable {","+\t\tyield from self::gatherAssertTypes( __DIR__ . '/data/hash-notation.php' );","+\t}","+","+\t/**","+\t * @dataProvider data_file_asserts","+\t *","+\t * @param string $assert_type Kind of assertion.","+\t * @param string $file        Fixture file.","+\t * @param mixed  ...$args     Assertion arguments.","+\t */","+\tpublic function test_file_asserts( string $assert_type, string $file, ...$args ): void {","+\t\t$this->assertFileAsserts( $assert_type, $file, ...$args );","+\t}","+","+\t/**","+\t * Returns the configuration registering the visitor.","+\t *","+\t * @return list<string>","+\t */","+\tpublic static function getAdditionalConfigFiles(): array {","+\t\treturn array( __DIR__ . '/tests.neon' );","+\t}","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"tests/phpstan/Tests/HashNotationVisitorTest.php","lines":["@@ -0,0 +1,558 @@","+<?php","+/**","+ * Tests for HashNotationVisitor.","+ *","+ * @package WordPress","+ */","+","+declare(strict_types=1);","+","+namespace WordPress\\PHPStan\\Tests;","+","+use PhpParser\\Node;","+use PhpParser\\NodeTraverser;","+use PhpParser\\NodeVisitorAbstract;","+use PhpParser\\ParserFactory;","+use PHPUnit\\Framework\\TestCase;","+use WordPress\\PHPStan\\HashNotationVisitor;","+","+/**","+ * Checks the `@phpstan-*` tags the visitor derives from a docblock.","+ *","+ * The visitor rewrites docblocks in the syntax tree, so each case parses a snippet,","+ * runs the visitor over it and compares the lines the docblock gained. The types","+ * PHPStan then infers from those lines are covered by HashNotationTypeTest.","+ */","+final class HashNotationVisitorTest extends TestCase {","+","+\t/**","+\t * @dataProvider data_derived_tags","+\t *","+\t * @param string       $code     PHP source.","+\t * @param list<string> $expected Tag lines the docblocks are expected to gain.","+\t */","+\tpublic function test_derived_tags( string $code, array $expected ): void {","+\t\t$this->assertSame( $expected, self::derived_tags( $code ) );","+\t}","+","+\t/**","+\t * @return array<string, array{string, list<string>}>","+\t */","+\tpublic function data_derived_tags(): array {","+\t\treturn array(","+\t\t\t'param hash is open with optional keys'       => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param array $args {","+\t\t\t\t\t *     Arguments.","+\t\t\t\t\t *","+\t\t\t\t\t *     @type string $post_type   Post type. Default \\'post\\'.","+\t\t\t\t\t *     @type int    $post_author Post author ID.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array{post_type?: string, post_author?: int, ...} $args' ),","+\t\t\t),","+\t\t\t'param key marked required is required'       => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param array $args {","+\t\t\t\t\t *     Arguments.","+\t\t\t\t\t *","+\t\t\t\t\t *     @type string $hostname Required. Server hostname.","+\t\t\t\t\t *     @type int    $port     Port.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array{hostname: string, port?: int, ...} $args' ),","+\t\t\t),","+\t\t\t'return hash is sealed with required keys'    => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return array {","+\t\t\t\t\t *     @type string $name  Name.","+\t\t\t\t\t *     @type int    $count Count. Default 0.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return array{name: string, count: int}' ),","+\t\t\t),","+\t\t\t'numbered keys are required in a param hash'  => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param array $size {","+\t\t\t\t\t *     @type int $0 Width.","+\t\t\t\t\t *     @type int $1 Height.","+\t\t\t\t\t * }","+\t\t\t\t\t',","+\t\t\t\t\t'( $size )'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array{0: int, 1: int, ...} $size' ),","+\t\t\t),","+\t\t\t'Optional. marks a return key optional'       => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return array {","+\t\t\t\t\t *     @type string $name  Name.","+\t\t\t\t\t *     @type int    $count Optional. Count.","+\t\t\t\t\t *     @type string $slash Optional self closing slash, which is prose.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return array{name: string, count?: int, slash: string}' ),","+\t\t\t),","+\t\t\t'Optional. marks a numbered param key optional' => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param array $size {","+\t\t\t\t\t *     @type int $0 Width.","+\t\t\t\t\t *     @type int $1 Optional. Height.","+\t\t\t\t\t * }","+\t\t\t\t\t',","+\t\t\t\t\t'( $size )'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array{0: int, 1?: int, ...} $size' ),","+\t\t\t),","+\t\t\t'a lone variadic entry describes the values'  => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param array $callbacks {","+\t\t\t\t\t *     @type callable ...$0 Callbacks.","+\t\t\t\t\t * }","+\t\t\t\t\t',","+\t\t\t\t\t'( $callbacks )'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array<array-key, callable> $callbacks' ),","+\t\t\t),","+\t\t\t'a variadic entry beside named keys opens a return hash' => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return array {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t *     @type mixed  ...$1 The rest.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return array{name: string, ...}' ),","+\t\t\t),","+\t\t\t'nested hashes nest'                          => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param array $args {","+\t\t\t\t\t *     @type array $labels {","+\t\t\t\t\t *         @type string $name     Name.","+\t\t\t\t\t *         @type string $singular Singular name.","+\t\t\t\t\t *     }","+\t\t\t\t\t *     @type bool $public Whether public.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array{labels?: array{name?: string, singular?: string, ...}, public?: bool, ...} $args' ),","+\t\t\t),","+\t\t\t'a nested hash in a return is sealed too'     => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return array {","+\t\t\t\t\t *     @type array $labels {","+\t\t\t\t\t *         @type string $name Name.","+\t\t\t\t\t *     }","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return array{labels: array{name: string}}' ),","+\t\t\t),","+\t\t\t'keys that are not identifiers are quoted'    => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return array {","+\t\t\t\t\t *     @type string $mime-type MIME type.","+\t\t\t\t\t *     @type string $ext       Extension.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( \"@phpstan-return array{'mime-type': string, ext: string}\" ),","+\t\t\t),","+\t\t\t'Array is array'                              => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param Array $args {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param array{name?: string, ...} $args' ),","+\t\t\t),","+\t\t\t'the bare member of a union takes the shape'  => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param string|array $args {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t * @return array|WP_Error {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray(","+\t\t\t\t\t'@phpstan-param string|array{name?: string, ...} $args',","+\t\t\t\t\t'@phpstan-return array{name: string}|WP_Error',","+\t\t\t\t),","+\t\t\t),","+\t\t\t'a class takes the shape through an intersection' => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return stdClass {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return stdClass&object{name: string}' ),","+\t\t\t),","+\t\t\t'an intersection inside a union is parenthesized' => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return stdClass|false {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return (stdClass&object{name: string})|false' ),","+\t\t\t),","+\t\t\t'a bare object return is a shape'             => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return object {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-return object{name: string}' ),","+\t\t\t),","+\t\t\t'a bare object param would have to stay open, so is skipped' => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param object $args {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray(),","+\t\t\t),","+\t\t\t'a class param stays open through the class'  => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @param stdClass $args {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarray( '@phpstan-param stdClass&object{name?: string} $args' ),","+\t\t\t),","+\t\t\t'two bare members leave the target a guess'   => array(","+\t\t\t\tself::fn(","+\t\t\t\t\t'","+\t\t\t\t\t * @return array|object {","+\t\t\t\t\t *     @type string $name Name.","+\t\t\t\t\t * }","+\t\t\t\t\t'","+\t\t\t\t),","+\t\t\t\tarra