{"id":"1d9833be57dd5fd22db1d031ef2dbdb75a8a523f","axis":"silent","repo":"panva/jose","sha":"1d9833be57dd5fd22db1d031ef2dbdb75a8a523f","parsed":{"files":[{"path":".github/workflows/build.yml","lines":["@@ -24,7 +24,7 @@ jobs:","           cache: 'npm'","       - run: npm clean-install","       - id: cache-key","-        run: echo \"value=dist-${{ hashFiles('src/**/*.ts', 'tsconfig/*.json', '.github/workflows/*.yml', 'package-lock.json') }}\" >> $GITHUB_OUTPUT","+        run: echo \"value=dist-${{ hashFiles('src/**/*.ts', 'tsconfig.json', 'tsconfig/*.json', 'package.json', 'jsr.json', 'tools/*.cjs', 'tools/*.js', '.github/workflows/*.yml', 'package-lock.json') }}\" >> $GITHUB_OUTPUT","       - name: Cache dist","         uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0","         id: dist"],"additions":1,"deletions":1,"truncated":false},{"path":".github/workflows/release.yml","lines":["@@ -32,7 +32,7 @@ jobs:","         id: dist","         with:","           path: dist","-          key: dist-${{ hashFiles('src/**/*.ts', 'tsconfig/*.json', '.github/workflows/*.yml', 'package-lock.json') }}","+          key: dist-${{ hashFiles('src/**/*.ts', 'tsconfig.json', 'tsconfig/*.json', 'package.json', 'jsr.json', 'tools/*.cjs', 'tools/*.js', '.github/workflows/*.yml', 'package-lock.json') }}","           fail-on-cache-miss: true","       - name: Prepare distribution","         run: node tools/publish.cjs"],"additions":1,"deletions":1,"truncated":false},{"path":".github/workflows/test.yml","lines":["@@ -15,6 +15,39 @@ jobs:","   build:","     uses: ./.github/workflows/build.yml"," ","+  types:","+    runs-on: ubuntu-latest","+    steps:","+      - name: Checkout","+        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0","+      - name: Setup node","+        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0","+        with:","+          node-version: lts/*","+          cache: 'npm'","+      - run: npm clean-in