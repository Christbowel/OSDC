   \"build:types\": \"npm run build -- -p ./tsconfig/types.json && cd src && find . -name '*.d.ts' -maxdepth 2 -type f -exec rsync -R \\\"{}\\\" ../dist/types  \\\\;\",","+    \"build:types\": \"npm run build -- -p ./tsconfig/types.json && cd src && find . -name '*.d.ts' -type f -exec rsync -R \\\"{}\\\" ../dist/types  \\\\;\",","     \"build:jsr\": \"npx --yes jsr publish --dry-run --allow-dirty\",","     \"clear\": \"rm -Rf dist\",","     \"sedcleanup\": \"find . -name '*.bak' -type f -print0 | xargs -0 rm -f\",","@@ -222,13 +220,18 @@","     \"docs:generate\": \"typedoc\",","     \"types:find\": \"find dist/types -name '*.d.ts' -type f -print0\",","     \"test\": \"bash -c 'source .node_flags.sh && ava'\",","-    \"format\": \"prettier --log-level silent --write ./test ./tap ./src ./tools ./cookbook ./tsconfig\",","+    \"format\": \"prettier --log-level silent --write ./test ./tap ./test-d ./src ./tools ./cookbook ./tsconfig\",","     \"tap:browsers\": \"./tap/.browsers.sh\",","     \"tap:bun\": \"./tap/.bun.sh\",","     \"tap:deno\": \"./tap/.deno.sh\",","     \"tap:electron\": \"./tap/.electron.sh\",","     \"tap:node\": \"bash -c './tap/.node.sh'\",","-    \"tap:workerd\": \"./tap/.workerd.sh\"","+    \"tap:workerd\": \"./tap/.workerd.sh\",","+    \"typecheck:tap\": \"tsc -p tap\",","+    \"typecheck:types\": \"tsc -p test-d\",","+    \"typecheck:dist\": \"./tools/typecheck-dist.sh\",","+    \"check:subpaths\": \"node tools/check-subpaths.js\",","+    \"check:packaging\": \"npx --yes publint --strict && node tools/attw-check.js\"","   },","   \"devDependencies\": {","     \"@playwright/test\": \"^1.61.1\","],"additions":9,"deletions":6,"truncated":false},{"path":"tap/cookbook.ts","lines":["@@ -202,7 +202,7 @@ export default (","             keyManagementParameters.epk = (await keys.importJWK(","               vector.encrypting_key.epk,","               vector.input.alg,","-            )) as jose.KeyLike","+            )) as jose.CryptoKey","           }"," ",