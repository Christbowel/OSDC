settingsDBPath = \"/var/lib/homer/homer_settings.duckdb\"","+\t}","+\treturn filepath.Join(filepath.Dir(settingsDBPath), homerJWTSecretFileName)","+}","+","+// ResolveCoordinatorJWTSecret returns the effective JWT signing secret.","+// Configured non-empty coordinator.jwt.secret wins. When empty, loads","+// .homer_jwt_secret beside settings_db_path; if missing, generates a random","+// secret, persists it (0600), and returns autoGenerated=true.","+func ResolveCoordinatorJWTSecret(configuredSecret, settingsDBPath string) (secret string, autoGenerated bool, secretFile string, err error) {","+\tif s := strings.TrimSpace(configuredSecret); s != \"\" {","+\t\treturn s, false, \"\", nil","+\t}","+\tsecretFile = JWTSecretFilePath(settingsDBPath)","+\tdata, readErr := os.ReadFile(secretFile)","+\tif readErr == nil {","+\t\tif s := strings.TrimSpace(string(data)); s != \"\" {","+\t\t\treturn s, false, secretFile, nil","+\t\t}","+\t} else if !os.IsNotExist(readErr) {","+\t\treturn \"\", false, secretFile, fmt.Errorf(\"read jwt secret file %s: %w\", secretFile, readErr)","+\t}","+","+\tb := make([]byte, 32)","+\tif _, err := rand.Read(b); err != nil {","+\t\treturn \"\", false, secretFile, fmt.Errorf(\"generate jwt secret: %w\", err)","+\t}","+\tsecret = base64.RawURLEncoding.EncodeToString(b)","+\tif err := os.MkdirAll(filepath.Dir(secretFile), 0o750); err != nil {","+\t\treturn \"\", false, secretFile, fmt.Errorf(\"create jwt secret directory: %w\", err)","+\t}","+\tif err := os.WriteFile(secretFile, []byte(secret+\"\\n\"), 0o600); err != nil {","+\t\treturn \"\", false, secretFile, fmt.Errorf(\"write jwt secret file %s: %w\", secretFile, err)","+\t}","+\treturn secret, true, secretFile, nil","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"src/coordinator/services/jwt_secret_test.go","lines":["@@ -0,0 +1,58 @@","+// Copyright (C) 2025 Homer Server Contributors","+//","+// SPDX-License-Identifier: AGPL-3.0-or-later","+","+package services","+","+import (","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+)","+","+func TestResolveCoordinatorJWTSecret_ConfiguredWins(t *testing.T) {","+\tsecret, auto, path, err := ResolveCoordinatorJWTSecret(\"configured-secret\", t.TempDir())","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif secret != \"configured-secret\" || auto || path != \"\" {","+\t\tt.Fatalf(\"got secret=%q auto=%v path=%q\", secret, auto, path)","+\t}","+}","+","+func TestResolveCoordinatorJWTSecret_PersistAndReload(t *testing.T) {","+\tdir := t.TempDir()","+\tsettings := filepath.Join(dir, \"settings.duckdb\")","+","+\tsecret1, auto1, file1, err := ResolveCoordinatorJWTSecret(\"\", settings)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif !auto1 || secret1 == \"\" || file1 != filepath.Join(dir, homerJWTSecretFileName) {","+\t\tt.Fatalf(\"first: secret=%q auto=%v file=%q\", secret1, auto1, file1)","+\t}","+","+\tsecret2, auto2, file2, err := ResolveCoordinatorJWTSecret(\"\", settings)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif auto2 || secret2 != secret1 || file2 != file1 {","+\t\tt.Fatalf(\"reload: secret=%q auto=%v file=%q\", secret2, auto2, file2)","+\t}","+}","+","+func TestResolveCoordinatorJWTSecret_LoadExistingFile(t *testing.T) {","+\tdir := t.TempDir()","+\tsettings := filepath.Join(dir, \"settings.duckdb\")","+\tsecretFile := filepath.Join(dir, homerJWTSecretFileName)","+\tif err := os.WriteFile(secretFile, []byte(\"from-file\\n\"), 0o600); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tsecret, auto, _, err := ResolveCoordinatorJWTSecret(\"\", settings)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif auto || secret != \"from-file\" {","+\t\tt.Fatalf(\"got secret=%q auto=%v\", secret, auto)","+\t}","+}",""],"additions":58,"deletions":0,"truncated":false}],"additions":153,"deletions":13,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-08T16:15:28.357516+00:00"}