LLATE nocase;","+----","+Only VARCHAR columns can have collations!","+","+statement error","+ALTER TABLE t ALTER COLUMN s COLLATE nocase;","+----","+Parser Error","+","+statement error","+ALTER TABLE t ALTER COLUMN s TYPE COLLATE nocase USING s;","+----","+Parser Error: Specify the VARCHAR type to set a collation","+","+statement error","+ALTER TABLE t ALTER COLUMN s TYPE VARCHAR COLLATE nonexistent_collation;","+----","+<REGEX>:.*Catalog Error.*nonexistent_collation.*","+","+# the collation is stored in the table definition","+query I","+SELECT sql LIKE '%s VARCHAR COLLATE nocase%' FROM duckdb_tables() WHERE table_name = 't'","+----","+true","+","+# ADD COLUMN with a collation","+statement ok","+ALTER TABLE t ADD COLUMN c VARCHAR COLLATE nocase;","+","+statement ok","+UPDATE t SET c = s;","+","+query I","+SELECT id FROM t WHERE c = 'HELLO' ORDER BY id","+----","+x1","+x2","+","+query I","+SELECT sql LIKE '%c VARCHAR COLLATE nocase%' FROM duckdb_tables() WHERE table_name = 't'","+----","+true","+","+statement error","+ALTER TABLE t ADD COLUMN d INTEGER COLLATE nocase;","+----","+Parser Error: Only VARCHAR columns can have collations!","+","+statement error","+ALTER TABLE t ADD COLUMN d VARCHAR COLLATE nonexistent_collation;","+----","+Catalog Error: Collation with name nonexistent_collation does not exist!"],"additions":88,"deletions":0,"truncated":false},{"path":"test/sql/collate/test_unsupported_collations.test","lines":["@@ -14,6 +14,12 @@ CREATE TABLE collate_test(s INTEGER COLLATE blabla)"," ----"," Parser Error: Only VARCHAR columns can have collations!"," ","+# a collation requires an explicit VARCHAR type","+statement error","+CREATE TABLE collate_test(s COLLATE nocase)","+----","+Parser Error: Column s must have a type or be defined as a GENERATED column.","+"," # we can combine multiple of the same collation"," statement ok"," CREATE TABLE collate_test(s VARCHAR COLLATE NOACCENT.NOACCENT)",""],"additions":6,"deletions":0,"truncated":false}],"additions":154