rce, &provisioning.ResourceList{}, true)","+\t\trequire.NoError(t, err)","+","+\t\trequire.ElementsMatch(t, []string{\"folder/one & two.json\", \"folder/three%four.json\"}, unsupportedPaths(changes))","+\t\tvar supported []string","+\t\tfor _, c := range changes {","+\t\t\tif c.Warning == nil && c.Path == \"folder/valid.json\" {","+\t\t\t\tsupported = append(supported, c.Path)","+\t\t\t}","+\t\t}","+\t\trequire.Equal(t, []string{\"folder/valid.json\"}, supported)","+\t})","+","+\tt.Run(\"a traversal path is unsupported, not hidden\", func(t *testing.T) {","+\t\tsource := []repository.FileTreeEntry{","+\t\t\t{Path: \"folder/../evil.json\", Hash: \"xyz\", Blob: true},","+\t\t\t{Path: \"../.secret.json\", Hash: \"xyz\", Blob: true},","+\t\t}","+\t\tchanges, err := Changes(ctx, source, &provisioning.ResourceList{}, true)","+\t\trequire.NoError(t, err)","+\t\trequire.ElementsMatch(t, []string{\"folder/../evil.json\", \"../.secret.json\"}, unsupportedPaths(changes))","+\t})","+","+\tt.Run(\"files that are not resources are not reported\", func(t *testing.T) {","+\t\tsource := []repository.FileTreeEntry{","+\t\t\t{Path: \"folder/README.md\", Hash: \"a\", Blob: true},","+\t\t\t{Path: \"folder/.keep\", Hash: \"b\", Blob: true},","+\t\t\t{Path: \"folder/.hidden & broken.json\", Hash: \"c\", Blob: true},","+\t\t\t{Path: \"folder/screenshot & notes.png\", Hash: \"d\", Blob: true},","+\t\t}","+\t\ttarget := &provisioning.ResourceList{Items: []provisioning.ResourceListItem{folder}}","+","+\t\tchanges, err := Changes(ctx, source, target, true)","+\t\trequire.NoError(t, err)","+","+\t\trequire.Empty(t, unsupportedPaths(changes))","+\t\trequire.Empty(t, changes, \"the folder is kept and nothing else is a resource\")","+\t})","+","+\tt.Run(\"the folder holding an unsafe path is kept\", func(t *testing.T) {","+\t\tsource := []repository.FileTreeEntry{{Path: \"folder/Backend & UI.json\", Hash: \"h1\", Blob: true}}","+\t\ttarget := &provisioning.ResourceList{Items: []provisioning.Resour