, plist payloads, fixture blobs","+  \"[A-Za-z0-9+/]{32,}={0,2}\",","+]","+","+[default.extend-words]","+# HashiCorp Vault secret fetcher (hashi_vault, HashiVault)","+hashi = \"hashi\"","+# Win32 NetAPI32 struct fields, e.g. USER_INFO_3.usri3_parms, PARM_ERROR","+parm = \"parm\"","+parms = \"parms\"","+# Win32 constants that Microsoft itself truncated or spells this way, e.g.","+# ERROR_REQ_NOT_ACCEP, ERROR_FILENAME_EXCED_RANGE, RPC_S_CALL_FAILED_DNE,","+# FILE_DEVICE_INPORT_PORT","+accep = \"accep\"","+exced = \"exced\"","+dne = \"dne\"","+inport = \"inport\"","+# win32-taskscheduler's TASK_NINETH constant","+nineth = \"nineth\"","+# Open3.popen3's wait_thr","+thr = \"thr\"","+# /^[PN]/ against `passwd -S` output, and Pathname locals named relative_pn","+pn = \"pn\"","+# Disable-NetAdapterLso: LSO is Large Send Offload","+lso = \"lso\"","+# GPG --with-colons output fields: fingerprint and trust records","+fpr = \"fpr\"","+tru = \"tru\"","+# DES-EDE3-CBC cipher name","+ede = \"ede\"","+# The repl_type_completor gem used by chef-shell","+completor = \"completor\"","+# \"Chef::VERSIONs\" splits into VERSIO + Ns","+versio = \"versio\"","+# Test Kitchen Engine","+tke = \"tke\"","+# Real words that typos wants to singularize, and internal parameter names","+configurables = \"configurables\"","+datas = \"datas\"","+arry = \"arry\"","+# Deliberate: `alias :halp :help` in chef-shell, and a colloquial \"deletin'\"","+halp = \"halp\"","+deletin = \"deletin\""],"additions":68,"deletions":0,"truncated":false},{"path":"chef-config/lib/chef-config/config.rb","lines":["@@ -394,7 +394,7 @@ def self.derive_path_from_chef_repo_path(child_path)","       end","     end"," ","-    # Returns true only if the path exists and is readable and writeable for the user.","+    # Returns true only if the path exists and is readable and writable for the user.","     #","     # @param path [String]","     def self.path_accessible?(path)"],"additions":1,"deletions":1,"truncated":false},{"path":"che