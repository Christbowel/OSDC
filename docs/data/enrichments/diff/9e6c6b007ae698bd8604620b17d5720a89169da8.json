 positions = [idx_to_pos[idx] for idx in requested_indices]","+                # Charge the repeated frames before they are allocated.","+                charge_frame_copies(len(positions) - len(frames), _frame_nbytes(frames))","                 if isinstance(frames, np.ndarray):","                     frames = frames[positions]","                 else:","@@ -1169,6 +1179,7 @@ def load_bytes(","         # Ensure even frame count — matches HF's sample_frames even-padding","         # and _preprocess temporal_patch_size divisibility check.","         if frames.shape[0] & 1:","+            charge_frame_copies(1, _frame_nbytes(frames))","             frames = np.concatenate([frames, frames[-1:]], axis=0)","         return frames, metadata"," ","@@ -1543,6 +1554,7 @@ def load_bytes(","             **kwargs,","         )","         if len(frames) % 2:","+            charge_frame_copies(1, _frame_nbytes(frames))","             last = frames[-1:]","             if isinstance(frames, torch.Tensor):","                 frames = torch.cat([frames, last])"],"additions":12,"deletions":0,"truncated":false},{"path":"vllm/multimodal/video_decoders/__init__.py","lines":["@@ -7,8 +7,12 @@"," from .base import (","     PYNVVIDEOCODEC_DEFAULT_HW_DECODERS,","     PYNVVIDEOCODEC_VIDEO_BACKEND,","+    SampledFramesCharge,","     VideoSourceMetadata,","     VideoTargetMetadata,","+    charge_frame_copies,","+    charge_sampled_frames,","+    charging_sampled_frames,","     check_frame_pixel_limit,"," )"," ","@@ -113,9 +117,13 @@ def decode_video("," __all__ = [","     \"PYNVVIDEOCODEC_DEFAULT_HW_DECODERS\",","     \"PYNVVIDEOCODEC_VIDEO_BACKEND\",","+    \"SampledFramesCharge\",","     \"VideoDecoderBackend\",","     \"VideoSourceMetadata\",","     \"VideoTargetMetadata\",","+    \"charge_frame_copies\",","+    \"charge_sampled_frames\",","+    \"charging_sampled_frames\",","     \"check_frame_pixel_limit\",","     \"decode_video\",","     \"incompatible_backend_options\","],"additions":8,"deletions":0,"truncated":false},{"path":"vllm/multimodal/video_decoders/base.py","lines":["@@ -1,6 +1,9 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+from collections.abc import Callable, Iterator","+from contextlib import contextmanager","+from contextvars import ContextVar"," from typing import Literal, NamedTuple"," "," from vllm import envs","@@ -35,3 +38,59 @@ def check_frame_pixel_limit(width: int, height: int) -> None:","             f\"{max_pixels} pixels. Set VLLM_MAX_IMAGE_PIXELS to \"","             f\"increase this limit.\"","         )","+","+","+class SampledFramesCharge:","+    \"\"\"Charges the decoded size of sampled video frames to a request budget.","+","+    `VideoMediaIO` installs one with `charging_sampled_frames` while a loader","+    runs. Decoders call `charge_sampled_frames` once they know the frame","+    size and the sampled indices, so an oversized sample is rejected before","+    any frame is decoded.","+    \"\"\"","+","+    def __init__(self, charge: Callable[[int], None]) -> None:","+        self._charge = charge","+        self.charged_bytes = 0","+","+    def __call__(self, num_bytes: int) -> None:","+        self._charge(num_bytes)","+        self.charged_bytes += num_bytes","+","+","+_sampled_frames_charge: ContextVar[SampledFramesCharge | None] = ContextVar(","+    \"_sampled_frames_charge\", default=None","+)","+","+","+@contextmanager","+def charging_sampled_frames(charge: SampledFramesCharge | None) -> Iterator[None]:","+    \"\"\"Route `charge_sampled_frames` calls made in this context to `charge`.\"\"\"","+    token = _sampled_frames_charge.set(charge)","+    try:","+        yield","+    finally:","+        _sampled_frames_charge.reset(token)","+","+","+def charge_sampled_frames(num_frames: int, width: int, height: int) -> None:","+    \"\"\"Charge `num_frames` RGB frames of `width` x `height` before decoding.","+","+    Raises `ValueError` when the frames would exceed the per-request","+    decoded-media budget (`VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES`).","+    \"\"\"","+    charge = _sampled_frames_charge.get()","+    if charge is not None:","+        charge(max(0, num_frames) * max(0, width) * max(0, height) * 3)","+","+","+def charge_frame_copies(num_copies: int, frame_bytes: int) -> None:","+    \"\"\"Charge `num_copies` copies of a decoded frame of `frame_bytes` bytes.","+","+    Loaders that repeat decoded frames call this before allocating the","+    copies, so the copies count toward the per-request decoded-media budget","+    before they exist.","+    \"\"\"","+    charge = _sampled_frames_charge.get()","+    if charge is not None:","+        charge(max(0, num_copies) * max(0, frame_bytes))"],"additions":59,"deletions":0,"truncated":false},{"path":"vllm/multimodal/video_decoders/deepstream.py","lines":["@@ -8,7 +8,12 @@"," "," from vllm.logger import init_logger"," ","-from .base import VideoSourceMetadata, VideoTargetMetadata, check_frame_pixel_limit","+from .base import (","+    VideoSourceMetadata,","+    VideoTargetMetadata,","+    charge_sampled_frames,","+    check_frame_pixel_limit,","+)"," "," logger = init_logger(__name__)"," ","@@ -32,6 +37,7 @@ def decode_deepstream(","     frame_idx = loader_cls.compute_frames_index_to_sample(","         source=source, target=target, **sampling_kwargs","     )","+    charge_sampled_frames(len(frame_idx), _width, _height)","     frames, valid = DeepStreamVideoBackendMixin.decode_indices(","         data,","         frame_idx,"],"additions":7,"deletions":1,"truncated":false},{"path":"vllm/multimodal/video_decoders/opencv.py","lines":["@@ -12,6 +12,7 @@"," from .base import (","     VideoSourceMetadata,","     VideoTargetMetadata,","+    charge_sampled_frames,","     check_frame_pixel_limit,"," )"," ","@@ -34,16 +35,17 @@ def decode_opencv(","     frame_recovery: bool = False,"," ) -> tuple[npt.NDArray, VideoSourceMetadata, list[int], list[int]]:","     cap = 