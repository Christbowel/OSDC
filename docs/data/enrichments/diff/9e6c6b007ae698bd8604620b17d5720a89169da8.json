{"id":"9e6c6b007ae698bd8604620b17d5720a89169da8","axis":"silent","repo":"vllm-project/vllm","sha":"9e6c6b007ae698bd8604620b17d5720a89169da8","parsed":{"files":[{"path":"docs/usage/security.md","lines":["@@ -96,7 +96,7 @@ denial of service:"," | `VLLM_MAX_MEDIA_DOWNLOAD_SIZE_MB` | `256` | Maximum size in MB for a single remote media response. Oversized responses are rejected while streaming before the full body is materialized in memory. |"," | `VLLM_MAX_MEDIA_REQUEST_DOWNLOAD_SIZE_MB` | `256` | Maximum total HTTP media bytes downloaded for one request, including concurrent downloads and retried attempts. Enforced while streaming. |"," | `VLLM_MAX_IMAGE_PIXELS` | `178956970` (~179M pixels) | Maximum decoded image size in pixels. Images exceeding this are rejected before raster memory is allocated. Default matches PIL's built-in 2x decompression-bomb threshold (~680 MB for RGB). |","-| `VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES` | `715827880` (~683 MiB) | Maximum aggregate decoded image, video-frame, and audio bytes in one request. Images are charged at four bytes per pixel before decoding; audio is limited before decoding; video files are charged after frame extraction. |","+| `VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES` | `715827880` (~683 MiB) | Maximum aggregate decoded image, video-frame, and audio bytes in one request. Images are charged at four bytes per pixel before decoding; audio is limited before decoding; video frames are charged at three bytes per pixel after frame sampling and before decoding. |"," | `VLLM_MAX_AUDIO_CLIP_FILESIZE_MB` | `25` | Maximum compressed filesize in MB for a single audio file. Enforced on all audio inputs (multimodal chat URLs, speech-to-text uploads, data: URLs, and local file paths) before decoding begins. |"," | `VLLM_MAX_AUDIO_DECODE_DURATION_S` | `600` | Maximum decoded audio duration in seconds. Prevents compressed audio from expanding into gigabytes of float32 PCM. |"," | `VLLM_MAX_AUDIO_DECODE_BYTES` | `268435456` (256 MiB) | Maximum float32 PCM bytes that audio decoding may allocate. Guards against sample-rate forgery where an inflated header sample rate bypasses the duration guard while the actual frame count causes a multi-GiB allocation. |"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/multimodal/media/test_video.py","lines":["@@ -2,6 +2,7 @@"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," import io"," import sys","+import tracemalloc"," from pathlib import Path"," from types import SimpleNamespace"," ","@@ -62,6 +63,108 @@ def test_video_request_budget_counts_torch_frames(monkeypatch: pytest.MonkeyPatc","         video_io.load_bytes(b\"video\")"," "," ","+def _write_opencv_test_video(tmp_path: Path, side: int, num_frames: int) -> bytes:","+    image_path = f\"{tmp_path}/budget_frame.png\"","+    Image.new(\"RGB\", (side, side), color=(0, 0, 0)).save(image_path)","+    video_path = f\"{tmp_path}/budget_video.mp4\"","+    create_video_from_image(image_path, video_path, num_frames=num_frames)","+    return Path(video_path).read_bytes()","+","+","+@pytest.mark.skip_global_cleanup","+def test_video_request_budget_rejects_before_decoding(","+    tmp_path, monkeypatch: pytest.MonkeyPatch","+):","+    \"\"\"An oversized sample is rejected before its frames are allocated.\"\"\"","+    data = _write_opencv_test_video(tmp_path, side=512, num_frames=8)","+    frame_bytes = 512 * 512 * 3","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 4 * frame_bytes)","+    budget = MediaDecodedBudget()","+    video_io = VideoMediaIO(ImageMediaIO(decoded_budget=budget), num_frames=-1)","+","+    tracemalloc.start()","+    try:","+        with pytest.raises(ValueError, match=\"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\"):","+            video_io.load_bytes(data)","+        _, peak = tracemalloc.get_traced_memory()","+    finally:","+        tracemalloc.stop()","+","+    assert peak < 2 * frame_bytes","+    assert budget.used == 0","+","+","+@pytest.mark.skip_global_cleanup","+def test_video_request_budget_charges_decoded_frames_once(","+    tmp_path, monkeypatch: pytest.MonkeyPatch","+):","+    data = _write_opencv_test_video(tmp_path, side=32, num_frames=8)","+    frame_bytes = 32 * 32 * 3","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 4 * frame_bytes)","+    budget = MediaDecodedBudget()","+    video_io = VideoMediaIO(ImageMediaIO(decoded_budget=budget), num_frames=4)","+","+    frames, _ = video_io.load_bytes(data).media","+","+    assert frames.shape == (4, 32, 32, 3)","+    assert budget.used == frames.nbytes","+","+","+@pytest.mark.skip_global_cleanup","+def test_video_request_budget_rejects_repeated_frames_before_copying(","+    tmp_path, monkeypatch: pytest.MonkeyPatch","+):","+    \"\"\"EmbeddingGemma2 repeats decoded frames to fill the requested indices.","+","+    A 1 fps clip of two frames sampled at 60 fps decodes two frames and","+    repeats them 32 times. The copies are charged before they are allocated.","+    \"\"\"","+    data = _write_opencv_test_video(tmp_path, side=512, num_frames=2)","+    frame_bytes = 512 * 512 * 3","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 4 * frame_bytes)","+    budget = MediaDecodedBudget()","+    video_io = VideoMediaIO(","+        ImageMediaIO(decoded_budget=budget),","+        video_backend=\"embedding_gemma2\",","+        fps=60,","+        max_frames=32,","+    )","+","+    tracemalloc.start()","+    try:","+        with pytest.raises(ValueError, match=\"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\"):","+            video_io.load_bytes(data)","+        _, peak = tracemalloc.get_traced_memory()","+    finally:","+        tracemalloc.stop()","+","+    # Decoding the two frames needs a few frames of buffers. The copies would","+    # need 32 frames.","+    assert peak < 8 * frame_bytes","+","+","+@pytest.mark.skip_global_cleanup","+def test_video_request_budget_charges_repeated_frames_once(","+    tmp_path, monkeypatch: pytest.MonkeyPatch","+):","+    data = _write_opencv_test_video(tmp_path, side=32, num_frames=2)","+    frame_bytes = 32 * 32 * 3","+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_REQUEST_DECODE_BYTES\", 32 * frame_bytes)","+    budget = MediaDecodedBudget()","+    video_io = VideoMediaIO(","+        ImageMediaIO(decoded_budget=budget),","+        video_backend=\"embedding_gemma2\",","+        fps=60,","+        max_frames=32,","+    )","+","+    frames, metadata = video_io.load_bytes(data).media","+","+    assert frames.shape == (32, 32, 32, 3)","+    assert set(metadata[\"frames_indices\"]) == {0, 1}","+    assert budget.used == frames.nbytes","+","+"," def test_video_media_io_kwargs(monkeypatch: pytest.MonkeyPatch):","     with monkeypatch.context() as m:","         m.setenv(\"VLLM_VIDEO_LOADER_BACKEND\", \"assert_10_frames_1_fps\")"],"additions":103,"deletions":0,"truncated":false},{"path":"vllm/multimodal/media/video.py","lines":["@@ -21,7 +21,11 @@"," )"," "," from ..video import VIDEO_LOADER_REGISTRY, DecodedFrames","-from ..video_decoders import incompatible_backend_options","+from ..video_decoders import (","+    SampledFramesCharge,","+    charging_sampled_frames,","+    incompatible_backend_options,","+)"," from .base import MediaIO, MediaWithBytes"," from .image import MAGIC_NUMPY_PREFIX, ImageMediaIO"," ","@@ -122,19 +126,25 @@ def __init__(","     def load_bytes(","         self, data: bytes","     ) -> MediaWithBytes[tuple[DecodedFrames, dict[str, Any]]]:","-        video = self.video_loader.load_bytes(","-            data, num_frames=self.num_frames, **self.kwargs","-        )","-        frames = video[0] if isinstance(video, tuple) else video","         budget = getattr(self.image_io, \"decoded_budget\", None)","+        # Decoders charge the sampled frames before decoding them, so an","+        # oversized sample is rejected before its frames are allocated.","+        frames_charge = None if budget is None else SampledFramesCharge(budget.charge)","+  