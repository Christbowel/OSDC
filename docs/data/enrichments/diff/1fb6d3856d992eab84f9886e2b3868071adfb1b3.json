lines":["@@ -1,9 +1,8 @@"," #!/usr/bin/env bash"," "," # Warms Node's on-disk V8 compile cache by booting Ghost once, so the modules don't","-# have to be compiled again on every boot. Run at image build time: Ghost's own","-# Dockerfile does it, and images built on top should re-run it after adding code","-# (custom adapters, patches) so those modules land in the cache too.","+# have to be compiled again on every boot. Image builds can run this after adding","+# code (custom adapters, patches) so those modules land in the cache too."," #"," # Cache entries are keyed by absolute module path, Node version and arch, so the"," # warming build must use the same app directory and base image as the runtime."],"additions":2,"deletions":3,"truncated":false},{"path":"ghost/core/server/services/email-service/README.md","lines":["@@ -287,18 +287,21 @@ measure Mailgun acceptance or delivery, including uncertain POST outcomes."," "," ## Benchmarking preparation"," ","-From `ghost`, run the synthetic MySQL benchmark. Credentials default to","-`root` / `root`, matching `testing-mysql`; override them with","-`database__connection__user` and `database__connection__password` for a different","-local database (an explicitly empty password is preserved):","+From the repository root, run the synthetic MySQL benchmark against the","+configured development MySQL server:"," "," ```sh","-NODE_OPTIONS=--conditions=source node --expose-gc scripts/benchmark-recipient-preparation.js 500000 2","+pnpm gx benchmark recipient-preparation 500000 2"," ```"," ","+gx supplies the source loader, `--expose-gc` and the checkout's development","+environment. Override `database__connection__host`, `database__connection__port`,","+`database__connection__user` or `database__connection__password` to use a different","+local server (an explicitly empty password is preserved).","+"," The arguments are member count and preparation concurrency. The harness creates","-and drops its own database on `127.0.0.1:3306`, uses Ghost's schema and preparation","-service with a pool of five, and never submits email. Members are split evenly","+and drops its own database, uses Ghost's schema and preparation service with a","+pool of five, and never submits email. Members are split evenly"," between free and paid segments to exercise the combined audience selection."," It measures the full audience, discard and rebuild after a complete pending attempt, and a label"," audience containing every fifth member. JSON output includes database settings,"],"additions":10,"deletions":7,"truncated":false},{"path":"package.json","lines":["@@ -20,10 +20,10 @@","     \"dev:analytics:local\": \"DEV_COMPOSE_FILES='-f compose.dev.analytics.yaml' ANALYTICS_PROXY_TARGET=${ANALYTICS_PROXY_TARGET:-127.0.0.1:3000} nx run ghost-monorepo:dev:host\",","     \"dev:storage\": \"DEV_COMPOSE_FILES='-f compose.dev.storage.yaml' nx run ghost-monorepo:dev:host\",","     \"dev:stripe\": \"./docker/stripe/with-stripe.sh nx run ghost-monorepo:dev:host\",","-    \"dev:up\": \"node tools/scripts/dev-up.ts\",","-    \"dev:down\": \"node tools/scripts/dev-down.ts\",","-    \"dev:status\": \"node tools/scripts/dev-status.ts\",","-    \"dev:gc\": \"node tools/scripts/dev-gc.ts\",","+    \"dev:up\": \"node tools/gx/dev-up.ts\",","+    \"dev:down\": \"node tools/gx/dev-down.ts\",","+    \"dev:status\": \"node tools/gx/dev-status.ts\",","+    \"dev:gc\": \"node tools/gx/dev-gc.ts\",","     \"fix\": \"pnpm store prune && node tools/scripts/clean.ts && pnpm install\",","     \"create-package\": \"pnpm gx generate package\",","     \"knex-migrator\": \"cd ghost && pnpm exec node ../tools/scripts/with-ghost-dev-env.ts env NODE_OPTIONS='--conditions=source --import=tsx' knex-migrator\","],"additions":4,"deletions":4,"truncated":false},{"path":"tools/gx/README.md","lines":["@@ -14,6 +14,21 @@ helpers in `tools/scripts/lib/`. `pnpm create-package` remains a forwarding alia"," Run `pnpm install` after generating a package; custom destinations must be covered"," by the workspace globs."," ","+## Development stacks","+","+Run `pnpm gx dev up`, `pnpm gx dev down`, `pnpm gx dev status` and","+`pnpm gx dev gc` to manage development stacks. Existing arguments still apply,","+including `up dev:analytics`, `down --all`, `down --orphans`, `status --json`","+and `gc --yes`. See [development setup](../../docs/contributing/development-setup.md#worktrees)","+for behavior and options.","+","+`pnpm dev:up`, `pnpm dev:down`, `pnpm dev:status` and `pnpm dev:gc` remain direct","+shortcuts to the same command files. The private session-end hook and shutdown","+path use Node built-ins only. Run `node tools/gx/dev-down.ts` directly when","+workspace dependencies are missing or stale; shutdown from the status view also","+uses direct Node execution and supports checkouts with the older script paths.","+Shared environment and infrastructure setup remain in `tools/scripts`.","+"," ## Golden email preview"," "," Run `pnpm gx generate golden-email <segment> <output-path>` against a running Ghost dev"],"additions":15,"deletions":0,"truncated":false},{"path":"tools/gx/cli.ts","lines":["@@ -58,6 +58,29 @@ cli.command({","   },"," });"," ","+cli.command({","+  flags: 'dev',","+  desc: 'Start, stop, inspect and clean up development stacks.',","+  setup(group: CommandGroup) {","+    for (const command of [","+      { flags: 'up', desc: 'Start this checkout in the background.' },","+      { flags: 'down', desc: 'Stop development stacks and orphaned processes.' },","+      { flags: 'status', desc: 'Inspect development stacks.' },","+      { flags: 'gc', desc: 'Inspect or remove unused development resources.' },","+    ]) {","+      group.command({","+        flags: command.flags,","+        desc: command.desc,","+        async run() {","+          commandRun = true;","+          process.argv = [...process.argv.slice(0, 2), ...args.slice(2)];","+          await import(`./dev-${command.flags}.ts`);","+        },","+      });","+    }"