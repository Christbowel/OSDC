rocess.stdout.write(JSON.stringify({args: process.argv.slice(2), input: readFileSync(0, 'utf8'), cwd: process.cwd()}));","+       process.exitCode = 7;`,","+    );","+    const shortcut = scripts[`dev:${command}`]!;","+    assert.match(shortcut, /^node /);","+    for (const invocation of [","+      ['tools/gx/cli.ts', 'dev', command],","+      [shortcut.slice('node '.length)],","+    ]) {","+      const result = spawnSync(process.execPath, [...invocation, ...args], {","+        cwd: root,","+        input: 'terminal input',","+        encoding: 'utf8',","+      });","+      assert.equal(result.status, 7, result.stderr);","+      assert.deepEqual(JSON.parse(result.stdout), {","+        args,","+        input: 'terminal input',","+        cwd: await realpath(root),","+      });","+    }","+  }","+});"],"additions":49,"deletions":0,"truncated":false},{"path":"tools/gx/tsconfig.json","lines":["@@ -6,5 +6,5 @@","     \"lib\": [\"es2023\"],","     \"erasableSyntaxOnly\": true","   },","-  \"include\": [\"*.ts\", \"test/**/*.ts\"]","+  \"include\": [\"*.ts\", \"lib/**/*.ts\", \"test/**/*.ts\"]"," }"],"additions":1,"deletions":1,"truncated":false},{"path":"tools/scripts/README.md","lines":["@@ -6,6 +6,8 @@ package: `pnpm nx run-many -t lint test` covers it, and Nx's affected graph runs"," those targets whenever anything here changes."," "," New automation belongs here by default, whether it runs locally, in CI, or both.","+Contributor commands belong in [gx](../gx/README.md), including development-stack","+management. Shared environment and infrastructure helpers stay here."," The old `.github/scripts` split tracked nothing real — `release-apps` is run by"," devs via `pnpm ship`, while `release.ts` is run by a workflow."," ",""],"additions":2,"deletions":0,"truncated":false}],"additions":191,"deletions":28,"truncated":false,"file_count":28},"error":null,"fetched_at":"2026-10-16T14:19:15.609586+00:00"}