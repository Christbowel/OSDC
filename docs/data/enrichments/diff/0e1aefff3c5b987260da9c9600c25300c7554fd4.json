{"id":"0e1aefff3c5b987260da9c9600c25300c7554fd4","axis":"silent","repo":"mongodb/mongo","sha":"0e1aefff3c5b987260da9c9600c25300c7554fd4","parsed":{"files":[{"path":"jstests/noPassthrough/validate/validate_parallel_slicing_pbt.js","lines":["@@ -0,0 +1,208 @@","+/**","+ * A property-based test that stresses the slicing of parallel collection validation. Collections","+ * of varying size, density and RecordId format (regular and time-series) are validated with","+ * varying slice options, and the outcome must match that of a validation that does not slice at","+ * all and must not report any out-of-order records.","+ *","+ * @tags: [","+ *   requires_persistence,","+ *   requires_wiredtiger,","+ * ]","+ */","+","+import {describe, it} from \"jstests/libs/mochalite.js\";","+import {kPbtInterruptAfterTimeLimitMs} from \"jstests/libs/property_test_helpers/property_testing_utils.js\";","+import {fc} from \"jstests/third_party/fast_check/fc-4.6.0.js\";","+","+const kNumRuns = 100;","+const kSeed = 42;","+","+const kDefaultTargetRecordsPerSlice = 50000;","+const kDefaultMaxSlices = 256;","+","+let conn;","+let db;","+let coll;","+","+function setSlicing(targetRecordsPerSlice, maxSlices) {","+    assert.commandWorked(","+        conn.adminCommand({","+            setParameter: 1,","+            validateParallelTargetRecordsPerSlice: targetRecordsPerSlice,","+            validateParallelMaxRecordStoreSlices: maxSlices,","+        }),","+    );","+}","+","+function validateWith(options, targetRecordsPerSlice, maxSlices) {","+    setSlicing(targetRecordsPerSlice, maxSlices);","+    return assert.commandWorked(coll.validate(options));","+}","+","+// The validation output that must not depend on how the record store was sliced. The slice count","+// is how a sliced validation is told apart, so it is left out. It is also absent when the","+// validation degrades to a single slice.","+function outcome(res) {","+    const {nParallelSlices, ...rest} = res;","+    return rest;","+}","+","+// The number of records validation traverses, which for a time-series collection is its buckets.","+function countRecords(timeseries) {","+    if (!timeseries) {","+        return coll.countDocuments({});","+    }","+    const [stats] = coll.aggregate([{$collStats: {storageStats: {}}}]).toArray();","+    return stats.storageStats.timeseries.bucketCount;","+}","+","+function createAndPopulate({timeseries, numDocs, deleteEvery, holes, numMetas}) {","+    coll.drop();","+    // A time-series collection's buckets are clustered on an ObjectId, so its RecordIds are not","+    // integers and slicing it takes the random cursor path rather than the arithmetic one.","+    const options = timeseries ? {timeseries: {timeField: \"t\", metaField: \"m\"}} : {};","+    assert.commandWorked(db.createCollection(coll.getName(), options));","+","+    // Each distinct meta value gets buckets of its own, so this sets how many records there are.","+    // The _id of a regular document is its position, which makes ranges of them easy to delete.","+    const docOf = (i) =>","+        timeseries","+            ? {t: new Date(1700000000000 + i * 1000), m: i % numMetas, a: i % 7}","+            : {_id: i, a: i % 7, padding: \"x\".repeat(i % 50)};","+    const bulk = coll.initializeUnorderedBulkOp();","+    for (let i = 0; i < numDocs; ++i) {","+        bulk.insert(docOf(i));","+    }","+    assert.commandWorked(bulk.execute());","+","+    // Integer RecordIds are allocated consecutively whatever the _id is, and never reused, so the","+    // only way to widely space the records is to delete runs of them. The gaps put slice","+    // boundaries where no record exists. A time-series collection can only be deleted from by its","+    // meta field.","+    const key = timeseries ? \"m\" : \"_id\";","+    const keyCount = timeseries ? numMetas : numDocs;","+    for (const {start, length} of holes) {","+        const lo = Math.floor(start * keyCount);","+        const hi = Math.min(keyCount, lo + Math.ceil(length * keyCount));","+        assert.commandWorked(coll.deleteMany({[key]: {$gte: lo, $lt: hi}}));","+    }","+    // Scattered deletes leave small gaps throughout. Zero keeps every remaining record.","+    if (deleteEvery > 0) {","+        assert.commandWorked(coll.deleteMany({[key]: {$mod: [deleteEvery, 0]}}));","+    }","+}","+","+const workloadArb = fc.record({","+    timeseries: fc.boolean(),","+    numDocs: fc.integer({min: 300, max: 25_000}),","+    deleteEvery: fc.oneof(fc.constant(0), fc.integer({min: 2, max: 9})),","+    // Runs of consecutive records to delete, as fractions of the collection, which leave wide gaps","+    // in the RecordIds.","+    holes: fc.array(","+        fc.record({","+            start: fc.double({min: 0, max: 1, noNaN: true, maxExcluded: true}),","+            length: fc.double({min: 0, max: 0.7, noNaN: true}),","+        }),","+        {maxLength: 4},","+    ),","+    // Distinct meta values of a time-series collection, which is how many buckets it has.","+    numMetas: fc.integer({min: 1, max: 5000}),","+});","+","+const slicingArb = fc.record({","+    // Zero disables slicing; small values produce many slices.","+    targetRecordsPerSlice: fc.integer({min: 0, max: 50_000}),","+    maxSlices: fc.integer({min: 1, max: 1000}),","+    validateOptions: fc.constantFrom(","+        {full: true},","+        {full: true, checkBSONConformance: true},","+        {full: false},","+    ),","+});","+","+conn = MongoRunner.runMongod({","+    setParameter: {featureFlagParallelCollectionValidation: true},","+});","+db = conn.getDB(\"validate_parallel_slicing_pbt\");","+coll = db.coll;","+","+describe(\"Record Store Slicing PBT\", () => {","+    it(\"validates all records regardless of slicing options\", () => {","+        let numSlicedRuns = 0;","+        try {","+            fc.assert(","+                fc","+                    .property(workloadArb, slicingArb, (workload, slicing) => {","+                        createAndPopulate(workload);","+                        const expectedCount = countRecords(workload.timeseries);","+","+                        const unsliced = validateWith(slicing.validateOptions, 0, 1);","+                        const sliced = validateWith(","+                            slicing.validateOptions,","+                            slicing.targetRecordsPerSlice,","+                            slicing.maxSlices,","+                        );","+","+                        assert(","+                            !(\"nParallelSlices\" in unsliced),","+                            \"unsliced validation reported slices\",","+                            {","+                                unsliced,","+                            },","+                        );","+                        if (\"nParallelSlices\" in sliced) {","+                            ++numSlicedRuns;","+                            assert.gte(","+                                sliced.nParallelSlices,","+                                2,","+                                \"a single slice is not reported\",","+                                {","+                                    sliced,","+                                },","+                            );","+                            assert.lte(","+                                sliced.nParallelSlices,","+                                slicing.maxSlices,","+                                \"too many slices\",","+                                {","+                                    sliced,","+                                    slicing,","+                                },","+                            );","+                        }","+","+                        if (!sliced.valid || sliced.nrecords !== expectedCount) {","+                            jsTest.log.error(\"Sliced validation disagrees with the collection\", {","+                                workload,","+                                slicing,","+                                expectedCount,","+                                sliced,","+                            });","+                            return false;","+                        }","+                        if (bsonWoCompare(outcome(unsliced), outcome(sliced)) !== 0) {","+                            jsTest.log.error(\"Sliced validation differs from unsliced validation\", {","+                                workload,","+                                slicing,","+                                unsliced: outcome(unsliced),","+                                sliced: outcome(sliced),","+                            });","+                            return false;","+                        }","+                        return true;","+                    })","+                    .beforeEach(() => setSlicing(kDefaultTargetRecordsPerSlice, kDefaultMaxSlices))","+                    .afterEach(() => coll.drop()),","+                {","+                    numRuns: kNumRuns,","+                    seed: kSeed,","+                    interruptAfterTimeLimit: kPbtInterruptAfterTimeLimitMs,","+                },","+            );","+            jsTest.log.info(\"Runs validated with slicing\", {numSlicedRuns, kNumRuns});","+        } finally {","+            setSlicing(kDefaultTargetRecordsPerSlice, kDefaultMaxSlices);","+            MongoRunner.stopMongod(conn);","+        }","+    });","+});"],"additions":208,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor.cpp","lines":["@@ -1097,6 +1097,10 @@ auto ValidateAdaptor::traverseRecordStoreImpl(OperationContext* opCtx,","                 }","             }"," ","+            if (results.firstRecordId.isNull()) {","+                results.firstRecordId = record->id;","+            }","+            results.lastRecordId = record->id;","             prevRecordId = record->id;"," ","             if (results.validateResults.getNumRecords().value() %"],"additions":4,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor.h","lines":["@@ -154,6 +154,9 @@ class ValidateAdaptor {","     struct TraverseRecordStoreResults {","         Status status = Status::OK();","         int64_t dataSizeTotal{0};","+        // The first and last records the traversal read, null if it read none.","+        RecordId firstRecordId;","+        RecordId lastRecordId;","         ValidateResults validateResults;","         KeyStringIndexConsistency keyStringIndexConsistency;","         // Storage statistics accrued by a slice traversing on its own operation context."],"additions":3,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor_parallel.cpp","lines":["@@ -32,6 +32,12 @@ namespace mongo {"," namespace {"," "," MONGO_FAIL_POINT_DEFINE(hangBeforeRecordStoreSliceTraversal);","+","+","+static constexpr char kSliceBoundaryOutOfOrderDocumentError[] =","+    \"Detected out-of-order documents across record store slices. For more info, see logs with log \"","+    \"id 13344700.\";","+"," /**","  * The snapshot settings a slice worker has to adopt from the thread that started the validation.","  *","@@ -143,6 +149,27 @@ ValidateAdaptorParallel::ValidateAdaptorParallel(","     boost::optional<int64_t> targetRecordsPerSlice)","     : ValidateAdaptor(opCtx, validateState), _targetRecordsPerSlice(targetRecordsPerSlice) {}"," ","+void ValidateAdaptorParallel::checkSliceIntervalsDoNotIntersect(","+    std::span<const TraverseRecordStoreResults> slices, ValidateResults& validateResults) {","+    // The slices are in pivot order, so each one's records must all follow the previous one's.","+    boost::optional<const TraverseRecordStoreResults&> prev = boost::none;","+    for (const auto& slice : slices) {","+        if (!slice.firstRecordId.isNull()) {","+            if (prev.has_value() && slice.firstRecordId <= prev->lastRecordId) {","+                LOGV2_ERROR_OPTIONS(13344700,","+                                    {logv2::LogTruncation::Disabled},","+                                    \"Document corruption details - Detected out-of-order document \"","+                                    \"across record store slices\",","+                                    logAttrs(getValidateState().nss()),","+                                    \"firstSliceLastRecordId\"_attr = prev->lastRecordId,","+                                    \"nextSliceFirstRecordId\"_attr = slice.firstRecordId);","+                validateResults.addError(kSliceBoundaryOutOfOrderDocumentError);","+            }","+            prev = slice;","+        }","+    }","+}","+"," void ValidateAdaptorParallel::traverseRecordStore(OperationContext* opCtx,","                                                   ValidateResults& validateResults,","                                                   ValidationVersion validationVersion) {","@@ -288,6 +315,7 @@ void ValidateAdaptorParallel::traverseRecordStore(OperationContext* opCtx,"," ","     // Combine the per-slice results before surfacing any slice's failure, so that a partial","     // failure still reports everything the other slices accumulated.","+    checkSliceIntervalsDoNotIntersect(implResults, validateResults);","     for (const auto& ir : implResults) {","         validateResults.merge(ir.validateResults);","         getKeyBasedIndexConsistency().merge(ir.keyStringIndexConsistency);"],"additions":28,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor_parallel.h","lines":["@@ -10,6 +10,7 @@"," #include \"mongo/util/cancellation.h\""," "," #include <memory>","+#include <span>"," "," namespace mongo {"," ","@@ -79,6 +80,14 @@ class ValidateAdaptorParallel : public ValidateAdaptor {","                                                             CancellationToken cancellation) const;"," "," private:","+    /**","+     * Reports an error if a slice's first RecordId does not follow the last RecordId of the","+     * previous non-empty slice. 'slices' must be in pivot order, as the slices cover consecutive","+     * disjoint ranges of the record store.","+     */","+    void checkSliceIntervalsDoNotIntersect(std::span<const TraverseRecordStoreResults> slices,","+                                           ValidateResults& validateResults);","+","     boost::optional<int64_t> _targetRecordsPerSlice;"," };"," "],"additions":9,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor_test.cpp","lines":["@@ -6,7 +6,10 @@"," #include \"mongo/base/data_view.h\""," #include \"mongo/bson/bsonobj.h\""," #include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/db/shard_role/shard_catalog/catalog_raii.h\""," #include \"mongo/db/shard_role/shard_catalog/catalog_test_fixture.h\"","+#include \"mongo/db/shard_role/transaction_resources.h\"","+#include \"mongo/db/storage/write_unit_of_work.h\""," #include \"mongo/db/validate/key_string_index_consistency.h\""," #include \"mongo/db/validate/validate_adaptor_factory.h\""," #include \"mongo/db/validate/validate_adaptor_parallel.h\"","@@ -16,7 +19,10 @@"," #include \"mongo/db/validate/validate_state.h\""," #include \"mongo/unittest/unittest.h\""," ","+#include <algorithm>"," #include <cstdint>","+#include <map>","+#include <memory>"," #include <string_view>"," #include <vector>"," ","@@ -26,6 +32,94 @@ namespace mongo::collection_validation {"," using namespace std::literals::string_view_literals;"," namespace {"," ","+/**","+ * A cursor that replays scripted RecordIds regardless of what the record store holds, so that a","+ * record store that returns records out of order can be simulated. seek() replays the sequence","+ * scripted for the RecordId it is given, and next() continues through it until it runs out.","+ */","+class ScriptedValidateCursor final : public ValidateCursor {","+public:","+    using Script = std::map<int64_t, std::vector<int64_t>>;","+","+    explicit ScriptedValidateCursor(const Script& script) : _script(script) {}","+","+    boost::optional<Record> seek(const RecordId& recordId) override {","+        const auto it = _script.find(recordId.getLong());","+        uassert(","+            ErrorCodes::InternalError, \"No sequence scripted for the seek\", it != _script.end());","+        _sequence = &it->second;","+        _position = 0;","+        return current();","+    }","+    boost::optional<Record> next() override {","+        ++_position;","+        return current();","+    }","+    void yield() override {}","+","+private:","+    boost::optional<Record> current() {","+        if (_position >= _sequence->size()) {","+            return boost::none;","+        }","+        const auto id = (*_sequence)[_position];","+        _doc = BSON(\"_id\" << id);","+        return Record{RecordId(id), RecordData(_doc.objdata(), _doc.objsize())};","+    }","+","+    const Script& _script;","+    const std::vector<int64_t>* _sequence{nullptr};","+    size_t _position{0};","+    BSONObj _doc;","+};","+","+class ScriptedSerialAdaptor final : public ValidateAdaptor {","+public:","+    ScriptedSerialAdaptor(OperationContext* opCtx,","+                          ValidateState& state,","+                          const ScriptedValidateCursor::Script& script)","+        : ValidateAdaptor(opCtx, state), _script(script) {}","+","+    void traverseRecordStore(OperationContext* opCtx,","+                             ValidateResults& validateResults,","+                             ValidationVersion validationVersion) final {","+        const auto progressGuard = preTraverseRecordStoreImpl(opCtx);","+        auto impl = traverseRecordStoreImpl(","+            opCtx,","+            validateResults,","+            getKeyBasedIndexConsistency(),","+            {.beginRecordId = getValidateState().getFirstRecordId(),","+             .cursorFactory = [this](OperationContext*) -> std::unique_ptr<ValidateCursor> {","+                 return std::make_unique<ScriptedValidateCursor>(_script);","+             }},","+            getProgress(),","+            validationVersion);","+        validateResults = std::move(impl.validateResults);","+    }","+","+private:","+    const ScriptedValidateCursor::Script& _script;","+};","+","+class ScriptedParallelAdaptor final : public ValidateAdaptorParallel {","+public:","+    ScriptedParallelAdaptor(OperationContext* opCtx,","+                            ValidateState& state,","+                            int64_t targetRecordsPerSlice,","+                            const ScriptedValidateCursor::Script& script)","+        : ValidateAdaptorParallel(opCtx, state, targetRecordsPerSlice), _script(script) {}","+","+protected:","+    std::unique_ptr<ValidateCursor> makeSliceCursor(OperationContext*,","+                                                    const RecordStore&,","+                                                    CancellationToken) const override {","+        return std::make_unique<ScriptedValidateCursor>(_script);","+    }","+","+private:","+    const ScriptedValidateCursor::Script& _script;","+};","+"," const auto kNss = NamespaceString::createNamespaceString_forTest(\"validateAdaptorDB.coll\"sv);"," "," enum class AdaptorKind { kSerial, kParallel };","@@ -84,8 +178,78 @@ class ValidateAdaptorTest : public CatalogTestFixture,","             opCtx, record, result.results, keyStringIndexConsistency, indexEntries);","         return result;","     }","+","+    // Seeds the collection with records 1..numRecords, so that a parallel traversal slices it.","+    void insertRecords(int64_t numRecords) {","+        auto opCtx = operationContext();","+        const AutoGetCollection coll(opCtx, kNss, MODE_IX);","+        WriteUnitOfWork wuow(opCtx);","+        for (int64_t id = 1; id <= numRecords; ++id) {","+            const auto doc = BSON(\"_id\" << id);","+            ASSERT_OK(","+                coll->getRecordStore()->insertRecord(opCtx,","+                                                     *shard_role_details::getRecoveryUnit(opCtx),","+                                                     RecordId(id),","+                                                     doc.objdata(),","+                                                     doc.objsize(),","+                                                     Timestamp()));","+        }","+        wuow.commit();","+    }","+","+    // Runs the adaptor's record store traversal over a record store that is scripted to return","+    // 'serialOrder' to a whole-record-store scan, and 'sliceOrders' (keyed by the RecordId each","+    // slice begins at) to a parallel one. Both describe the same records in the same order.","+    ValidateResults traverseScripted(const std::vector<int64_t>& serialOrder,","+                                     const ScriptedValidateCursor::Script& sliceOrders) {","+        auto opCtx = operationContext();","+        const bool parallel = GetParam() == AdaptorKind::kParallel;","+        ValidateState state(","+            opCtx,","+            kNss,","+            ValidationOptions(ValidateMode::kForeground,","+                              RepairMode::kNone,","+                              /*logDiagnostics=*/false,","+                              currentValidationVersion,","+                              /*verifyConfigurationOverride=*/boost::none,","+                              /*readTimestamp=*/boost::none,","+                              /*hashPrefixes=*/boost::none,","+                              /*revealHashedIds=*/boost::none,","+                              parallel ? boost::optional<int64_t>(kSliceSize) : boost::none));","+        ASSERT_OK(state.initializeCollection(opCtx));","+        state.initializeCursors(opCtx);","+","+        ValidateResults results;","+        results.setNamespaceString(state.nss());","+        results.setUUID(state.uuid());","+        results.setRepairMode(state.getRepairMode());","+        results.setReadTimestamp(state.getReadTimestamp());","+","+        const ScriptedValidateCursor::Script serialScript{{serialOrder.front(), serialOrder}};","+        if (parallel) {","+            ScriptedParallelAdaptor(opCtx, state, kSliceSize, sliceOrders)","+                .traverseRecordStore(opCtx, results, currentValidationVersion);","+        } else {","+            ScriptedSerialAdaptor(opCtx, state, serialScript)","+                .traverseRecordStore(opCtx, results, currentValidationVersion);","+        }","+        return results;","+    }","+","+    // Twenty records at ten per slice make two slices, whose pivots are the first record and the","+    // one nine ids on from it.","+    static constexpr int64_t kNumRecords{20};","+    static constexpr int64_t kSliceSize{10};","+    static constexpr int64_t kSecondSliceBegin{10};"," };"," ","+[[nodiscard]] bool reportsOutOfOrderRecords(const ValidateResults& results) {","+    return std::any_of(","+        results.getErrors().begin(), results.getErrors().end(), [](const auto& error) {","+            return error.find(\"out-of-order\") != std::string::npos;","+        });","+}","+"," std::vector<char> toBuffer(const BSONObj& obj) {","     const char* begin = obj.objdata();","     return {begin, begin + obj.objsize()};","@@ -177,6 +341,61 @@ TEST_P(ValidateAdaptorTest, InvalidUTF8InCollatedPartialIndexFieldDoesNotThrow)","     EXPECT_FALSE(result.record.compliantDocument);"," }"," ","+std::vector<int64_t> range(int64_t first, int64_t last) {","+    std::vector<int64_t> ids;","+    for (auto id = first; id <= last; ++id) {","+        ids.push_back(id);","+    }","+    return ids;","+}","+","+std::vector<int64_t> concat(std::vector<int64_t> a, std::span<const int64_t> b) {","+    a.insert(a.end(), b.begin(), b.end());","+    return a;","+}","+","+TEST_P(ValidateAdaptorTest, InOrderRecordsAreNotReportedOutOfOrder) {","+    createCollection({}, {});","+    insertRecords(kNumRecords);","+    const auto results = traverseScripted(","+        range(1, kNumRecords),","+        {{1, range(1, kSecondSliceBegin - 1)}, {kSecondSliceBegin, range(kSecondSliceBegin, 20)}});","+    EXPECT_FALSE(reportsOutOfOrderRecords(results));","+}","+","+TEST_P(ValidateAdaptorTest, OutOfOrderRecordsWithinASliceAreReported) {","+    createCollection({}, {});","+    insertRecords(kNumRecords);","+    const auto results = traverseScripted(concat(range(1, 5), concat({3}, range(6, kNumRecords))),","+                                          {{1, concat(range(1, 5), std::vector<int64_t>{3})},","+                                           {kSecondSliceBegin, range(kSecondSliceBegin, 20)}});","+    EXPECT_TRUE(reportsOutOfOrderRecords(results));","+}","+","+// The record store hands back a record the first slice already read as the first record of the","+// second one, so that the records are out of order only when the slices are read one after the","+// other. Neither slice sees the out-of-order pair on its own.","+TEST_P(ValidateAdaptorTest, OutOfOrderRecordsAcrossSliceBoundaryAreReported) {","+    createCollection({}, {});","+    insertRecords(kNumRecords);","+    const auto results = traverseScripted(","+        concat(range(1, kSecondSliceBegin - 1), concat({8}, range(kSecondSliceBegin, 20))),","+        {{1, range(1, kSecondSliceBegin - 1)},","+         {kSecondSliceBegin, concat({8}, range(kSecondSliceBegin, 20))}});","+    EXPECT_TRUE(reportsOutOfOrderRecords(results));","+}","+","+// Every slice's records are in order and the slices' ranges do not intersect, but the second slice","+// reads records that come after the third slice's.","+TEST_P(ValidateAdaptorTest, ReversedDisjointSlicesAreReported) {","+    createCollection({}, {});","+    insertRecords(30);","+    const auto results =","+        traverseScripted(concat(range(1, 9), concat(range(14, 18), range(12, 13))),","+                         {{1, range(1, 9)}, {10, range(14, 18)}, {19, range(12, 13)}});","+    EXPECT_TRUE(reportsOutOfOrderRecords(results));","+}","+"," INSTANTIATE_TEST_SUITE_P(,","                          ValidateAdaptorTest,","                          testing::Values(AdaptorKind::kSerial, AdaptorKind::kParallel),",""],"additions":219,"deletions":0,"truncated":false}],"additions":471,"deletions":0,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-10T17:08:19.864649+00:00"}