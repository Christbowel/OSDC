Foundation', () => {","+\t/** Runs `fn` and returns the arguments SecRandomCopyBytes received. */","+\tfunction captureSecRandom(fn: () => void) {","+\t\tconst spy = vi.spyOn(globalThis as any, 'SecRandomCopyBytes');","+","+\t\ttry {","+\t\t\tfn();","+\t\t\texpect(spy).toHaveBeenCalledTimes(1);","+","+\t\t\treturn spy.mock.calls[0] as any[];","+\t\t} finally {","+\t\t\tspy.mockRestore();","+\t\t}","+\t}","+","+\t// The view itself goes to Security: the runtime resolves it to V8's backing store at the","+\t// view's byte offset, so the fill lands in the caller's array with nothing in between.","+\tit('hands a byte view straight to SecRandomCopyBytes and the bytes land in it', () => {"," \t\tconst bytes = new Uint8Array(16);","-\t\tconst data = captureNativeCall((globalThis as any).NSCCrypto, () => crypto.getRandomValues(bytes));","+\t\tconst [rnd, count, target] = captureSecRandom(() => crypto.getRandomValues(bytes));"," ","-\t\texpect(data.selector).toBe('dataWithBytesNoCopyLengthFreeWhenDone');","-\t\texpect(data.args[0]).toBe(bytes);","-\t\texpect(data.args[1]).toBe(16);","-\t\texpect(data.args[2]).toBe(false);","+\t\texpect(rnd).toBe((globalThis as any).kSecRandomDefault);","+\t\texpect(count).toBe(16);","+\t\texpect(target).toBe(bytes);","+\t\texpect(Array.from(bytes)).toEqual(new Array(16).fill(0xab));"," \t});"," ","-\tit('wraps only the view window of an offset byte view', () => {","-\t\tconst view = new Uint8Array(new ArrayBuffer(32), 4, 10);","-\t\tconst data = captureNativeCall((globalThis as any).NSCCrypto, () => crypto.getRandomValues(view));","-","-\t\texpect(data.selector).toBe('dataWithBytesNoCopyLengthFreeWhenDone');","-\t\texpect(data.args[0]).toBe(view);","-\t\texpect(data.args[1]).toBe(10);","-\t\texpect(data.args[2]).toBe(false);","+\tit('fills only the window of an offset byte view', () => {","+\t\tconst buffer = new ArrayBuffer(32);","+\t\tconst view = new Uint8Array(buffer, 4, 10);","+\t\tconst [, count, target] = captureSecRandom(() => crypto.getRandomValues(view));","+","+\t\texpect(count).toBe(10);","+\t\texpect(target).toBe(view);","+\t\tconst all = new Uint8Array(buffer);","+\t\texpect(Array.from(all.subarray(0, 4))).toEqual([0, 0, 0, 0]);","+\t\texpect(Array.from(all.subarray(4, 14))).toEqual(new Array(10).fill(0xab));","+\t\texpect(Array.from(all.subarray(14))).toEqual(new Array(18).fill(0));"," \t});"," ","-\tit('wraps only the view window of a non-byte typed array', () => {","+\tit('reinterprets a non-byte typed array over its window only', () => {"," \t\tconst buffer = new ArrayBuffer(32);","-\t\tconst data = captureNativeCall((globalThis as any).NSCCrypto, () => crypto.getRandomValues(new Uint32Array(buffer, 8, 2)));","-\t\tconst wrapped = data.args[0] as Uint8Array;","-","-\t\texpect(data.selector).toBe('dataWithBytesNoCopyLengthFreeWhenDone');","-\t\texpect(wrapped.buffer).toBe(buffer);","-\t\texpect(wrapped.byteOffset).toBe(8);","-\t\texpect(wrapped.byteLength).toBe(8);","-\t\texpect(data.args[1]).toBe(8);","-\t\texpect(data.args[2]).toBe(false);","+\t\tconst words = new Uint32Array(buffer, 8, 2);","+\t\tconst [, count, target] = captureSecRandom(() => crypto.getRandomValues(words));","+","+\t\texpect(count).toBe(8);","+\t\texpect(target).toBeInstanceOf(Uint8Array);","+\t\texpect(target.buffer).toBe(buffer);","+\t\texpect(target.byteOffset).toBe(8);","+\t\texpect(target.byteLength).toBe(8);","+\t\texpect(Array.from(words)).toEqual([0xabababab, 0xabababab]);","+\t});","+","+\tit('throws when Security reports a failure', () => {","+\t\tconst spy = vi.spyOn(globalThis as any, 'SecRandomCopyBytes').mockReturnValue(-50);","+","+\t\ttry {","+\t\t\texpect(() => crypto.getRandomValues(new Uint8Array(8))).toThrow(/SecRandomCopyBytes failed \\(-50\\)/);","+\t\t} finally {","+\t\t\tspy.mockRestore();","+\t\t}","+\t});","+","+\t// NSMutableData copies bytes it does not own and frees ones it does, so no NSData wrapper","+\t// can ever alias V8's memory: the shim must not route through the framework at all.","+\tit('never wraps the bytes in NSData or calls the framework', () => {","+\t\tconst crypto_ = vi.spyOn((globalThis as any).NSCCrypto, 'getRandomValues');","+\t\tconst mutable = vi.spyOn((globalThis as any).NSMutableData, 'dataWithBytesNoCopyLengthFreeWhenDone');","+","+\t\ttry {","+\t\t\tcrypto.getRandomValues(new Uint8Array(8));","+\t\t\texpect(crypto_).not.toHaveBeenCalled();","+\t\t\texpect(mutable).not.toHaveBeenCalled();","+\t\t} finally {","+\t\t\tcrypto_.mockRestore();","+\t\t\tmutable.mockRestore();","+\t\t}"," \t});"," });"," "],"additions":69,"deletions":26,"truncated":false},{"path":"packages/core/wgc/crypto/index.ts","lines":["@@ -26,11 +26,14 @@ export class Crypto {"," \t\t\t(<any>org).nativescript.winter_tc.Crypto.getRandomValues(bytes);"," \t\t}"," \t\tif (__IOS__) {","-\t\t\t// The pointer is V8-owned: freeWhenDone must stay NO, or Foundation and V8's","-\t\t\t// ArrayBufferSweeper both free the same allocation.","-\t\t\tconst data = NSMutableData.dataWithBytesNoCopyLengthFreeWhenDone(bytes as never, bytes.byteLength, false);","-","-\t\t\tNSCCrypto.getRandomValues(data);","+\t\t\t// The view goes to Security directly: the runtime hands over V8's backing store at","+\t\t\t// the view's byte offset, so the bytes land in the caller's array. No NSData may","+\t\t\t// sit in between — NSMutableData copies bytes it does not own, so a no-copy wrapper","+\t\t\t// fills a private copy, and one that owns them frees V8's allocation.","+\t\t\tconst status = SecRandomCopyBytes(kSecRandomDefault, bytes.byteLength, bytes);","+\t\t\tif (status !== errSecSuccess) {","+\t\t\t\tthrow new Error(`getRandomValues: SecRandomCopyBytes failed (${status})`);","+\t\t\t}"," \t\t}"," "," \t\treturn typedArray;",""],"additions":8,"deletions":5,"truncated":false}],"additions":86,"deletions":31,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-09-04T12:53:03.060502+00:00"}