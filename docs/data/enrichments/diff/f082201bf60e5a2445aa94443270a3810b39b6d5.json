e(&alice_id).await.unwrap();","+    TokenBackend::check_readiness(&backend).await.unwrap();","+","+    primary.restart();","+    let ready = TokenBackend::check_readiness(&backend).await;","+    primary.restart();","+    let owner = backend.lookup(&token).await;","+    primary.restart();","+    let login = backend.add_or_login(\"alice\", \"secret123\").await;","+    let rejections = primary.stale_stream_rejections();","+    server.abort();","+    ready.unwrap();","+    assert_eq!(owner.unwrap().as_deref(), Some(alice_id.as_str()));","+    assert_eq!(login.unwrap().0, UpsertOutcome::LoggedIn);","+    assert!(rejections > 0, \"the pooled connections held streams\");","+}","+"," /// Poll `replica` for `token` until it is visible or the wait runs out."," async fn wait_for_token(replica: &LibsqlAuth, token: &str) -> Option<String> {","     let deadline = tokio::time::Instant::now() + Duration::from_secs(15);"],"additions":35,"deletions":2,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/tokens.rs","lines":["@@ -69,6 +69,7 @@ impl TokenBackend for LibsqlAuth {"," ","     async fn lookup(&self, raw: &str) -> Result<Option<String>> {","         let token_hash = sha256_hex(raw.as_bytes());","+        let token_hash = token_hash.as_str();","         let now = unix_seconds();","         self.pool.read(|conn| async move {","             let rows = conn","@@ -85,13 +86,15 @@ impl TokenBackend for LibsqlAuth {"," ","     async fn lookup_record(&self, raw: &str) -> Result<Option<TokenRecord>> {","         let token_hash = sha256_hex(raw.as_bytes());","+        let token_hash = token_hash.as_str();","         let query = format!(","             \"SELECT {OWNED_TOKEN_COLUMNS}, u.username FROM tokens t JOIN users u ON u.id = t.user_id AND u.bcrypt_hash <> '!'","              WHERE t.token_hash = ?1\",","         );","+        let query = query.as_str();","         let now = unix_seconds();","         self.pool.read(|conn| async move {","-            let rows = conn.que