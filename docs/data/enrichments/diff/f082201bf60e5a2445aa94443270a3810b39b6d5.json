{"id":"f082201bf60e5a2445aa94443270a3810b39b6d5","axis":"silent","repo":"pnpm/pnpm","sha":"f082201bf60e5a2445aa94443270a3810b39b6d5","parsed":{"files":[{"path":".changeset/pnpr-libsql-stale-streams.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now answers the first request after its remote libSQL database sat idle for a few seconds or restarted. Such a request used to fail with HTTP 500, and `/-/ping` and `/-/ready` with 503, on a `STREAM_EXPIRED` or \"invalid baton\" error from `sqld` or Turso."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend.rs","lines":["@@ -125,10 +125,11 @@ impl LibsqlAuth {","         max_connections: u32,","         is_replica: bool,","     ) -> Result<Self> {","+        let pool = ConnectionPool::new(db, max_connections as usize, DEFAULT_AUTH_TIMEOUT, || {","+            RegistryError::AuthDatabaseTimeout","+        });","         let auth = Self {","-            pool: ConnectionPool::new(db, max_connections as usize, DEFAULT_AUTH_TIMEOUT, || {","-                RegistryError::AuthDatabaseTimeout","-            }),","+            pool: if is_replica { pool.replica() } else { pool },","             secret: fresh_secret(),","             counter: AtomicU64::new(0),","             max_users,","@@ -467,6 +468,7 @@ impl LibsqlAuth {","             verify_returning_user(username, password, stored.clone(), DEFAULT_BCRYPT_COST).await?;","         if is_sha_hash(&stored) {","             let new_hash = hash_bcrypt(password.to_string(), DEFAULT_BCRYPT_COST).await?;","+            let (new_hash, stored) = (new_hash.as_str(), stored.as_str());","             self.pool.write(|conn| async move {","                 conn.execute(","                     \"UPDATE users SET bcrypt_hash = ?1 WHERE id = ?2 AND bcrypt_hash = ?3\","],"additions":5,"deletions":3,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/accounts.rs","lines":["@@ -21,6 +21,7 @@ impl LibsqlAuth {","