pl LibsqlAuth {","                     cidr_json,","                     record.name.as_deref(),","                     record.expires_at.map(token_timestamp_to_sql),","-                    scopes_json.as_deref(),","+                    scopes_json,","                     record.kind.as_deref(),","                 ],","             )"],"additions":11,"deletions":4,"truncated":false},{"path":"pnpr/crates/libsql/src/lib.rs","lines":["@@ -165,6 +165,19 @@ pub fn is_transaction_conflict(error: &LibsqlError) -> bool {","     }"," }"," ","+/// Whether the server rejected a request because it no longer holds the","+/// connection's stream: the stream expired, or the server restarted and","+/// does not know its baton. The server ran nothing of that request, and the","+/// connection cannot send another. libsql does not expose Hrana's error type,","+/// so the response is read from the message.","+pub(crate) fn is_stale_stream(error: &RegistryError) -> bool {","+    let RegistryError::Libsql(LibsqlError::Hrana(error)) = error else {","+        return false;","+    };","+    let message = error.to_string();","+    message.contains(\"STREAM_EXPIRED\") || message.contains(\"Received an invalid baton\")","+}","+"," /// Whether `error` is a violated uniqueness constraint."," #[must_use]"," pub fn is_unique_violation(error: &LibsqlError) -> bool {"],"additions":13,"deletions":0,"truncated":false},{"path":"pnpr/crates/libsql/src/pool.rs","lines":["@@ -1,12 +1,12 @@"," //! The connections a libSQL database's operations run on."," ","-use crate::with_deadline;","+use crate::{is_stale_stream, with_deadline};"," use libsql::{Connection, Database, Error as LibsqlError, Row};"," use pnpr_error::{RegistryError, Result};"," use std::{","     future::Future,","     sync::{Arc, Mutex},","-    time::Duration,","+    time::{Duration, Instant},"," };"," use tokio::{","     runtime::Handle,","@@ -29,6 +29,13 @@ pub async fn first_row<Output>(","     Ok(first)"," }"," ","+/// How long a connection may sit in the pool before the pool closes it","+/// instead of handing it out. `sqld`, which Turso runs, expires a stream 10","+/// seconds after it last answered on it, and rejects the stream's next request.","+/// Opening a remote connection costs no round trip: its first request opens","+/// a new stream.","+const IDLE_EXPIRY: Duration = Duration::from_secs(5);","+"," /// Connections to one database, each running one operation at a time."," ///"," /// A remote connection is a stream on the server, and each response hands the","@@ -39,7 +46,14 @@ pub async fn first_row<Output>("," /// still inside a transaction would pull the next operation into it. A"," /// connection therefore returns to the pool only after its operation succeeded"," /// outside a transaction; any other is closed, and a later checkout opens a","-/// fresh one.","+/// fresh one. A connection idle for `IDLE_EXPIRY` is closed as well.","+///","+/// A stream can still be gone when its connection is checked out, such as","+/// after the server restarted. The server rejects the stream's request","+/// without running it, and discards the stream with any transaction it held.","+/// [`Self::read`] and [`Self::write`] then run the operation once more on a","+/// new connection, and every idle connection is closed, since they share the","+/// server's fate."," ///"," /// Reads and writes are bounded differently, because cancelling a write after"," /// it reached the database leaves its outcome unknown. [`Self::read`] runs under the deadline end to end.","@@ -49,7 +63,9 @@ pub async fn first_row<Output>("," /// blocking thread pool, where the deadline can still give up on it."," pub struct ConnectionPool {","     db: Arc<Database>,","-    idle: Arc<Mutex<Vec<Connection>>>,","+    idle: Arc<Mutex<Vec<Idle>>>,","+    /// `None` for an embedded replica; see [`Self::replica`].","+    idle_expiry: Option<Duration>,","     slots: Arc<Semaphore>,","     /// Connection opens in flight. An open the deadline gave up on keeps its","     /// permit until it returns, so a stalled database cannot pile up blocked","@@ -74,6 +90,7 @@ impl ConnectionPool {","         Self {","             db: Arc::new(db),","             idle: Arc::new(Mutex::new(Vec::new())),","+            idle_expiry: Some(IDLE_EXPIRY),","             slots: Arc::new(Semaphore::new(max_connections)),","             opens: Arc::new(Semaphore::new(max_connections)),","             timeout,","@@ -81,35 +98,55 @@ impl ConnectionPool {","         }","     }"," ","-    /// Run the read `operation` on a pooled connection. Past the deadline,","+    /// Run the read `operation` on a pooled connection, and once more on a","+    /// new one if the server rejected the stream as stale. Past the deadline,","     /// waiting for a connection included, it fails with the pool's timeout","     /// error.","     ///","     /// `operation` must not use the pool itself: with every connection held","     /// by an operation waiting for another, the pool deadlocks.","-    pub async fn read<Loaded, Operation, Pending>(&self, operation: Operation) -> Result<Loaded>","+    pub async fn read<Loaded, Operation, Pending>(&self, mut operation: Operation) -> Result<Loaded>","     where","-        Operation: FnOnce(Connection) -> Pending,","+        Operation: FnMut(Connection) -> Pending,","         Pending: Future<Output = Result<Loaded>>,","     {","         with_deadline::<_, RegistryError>(self.timeout, self.timed_out, async {","-            let checkout = self.take().await?;","-            checkout.run(operation).await","+            match self.take().await?.run(&mut operation).await {","+                Err(error) if is_stale_stream(&error) => {","+                    self.open().await?.run(&mut operation).await","+                }","+                result => result,","+            }","         })","         .await","     }"," ","-    /// Run the write `operation` on a pooled connection. It fails with the","+    /// Run the write `operation` on a pooled connection, and once more on a","+    /// new one if the server rejected the stream as stale. It fails with the","     /// pool's timeout error if no connection frees up within the deadline,","     /// and otherwise runs to completion.","     ///","-    /// `operation` must not use the pool itself; see [`Self::read`].","-    pub async fn write<Loaded, Operation, Pending>(&self, operation: Operation) -> Result<Loaded>","+    /// `operation` must send one statement, or run its statements in one","+    /// transaction: a rejected stream takes its transaction with it, but a","+    /// statement that committed on its own before the rejection would run","+    /// twice. It must not use the pool itself; see [`Self::read`].","+    pub async fn write<Loaded, Operation, Pending>(","+        &self,","+        mut operation: Operation,","+    ) -> Result<Loaded>","     where","-        Operation: FnOnce(Connection) -> Pending,","+        Operation: FnMut(Connection) -> Pending,","         Pending: Future<Output = Result<Loaded>>,","     {","-        self.checkout().await?.run(operation).await","+        match self.checkout().await?.run(&mut operation).await {","+            Err(error) if is_stale_stream(&error) => {","+                with_deadline::<_, RegistryError>(self.timeout, self.timed_out, self.open())","+                    .await?","+                    .run(&mut operation)","+                    .await","+            }","+            result => result,","+        }","     }"," ","     /// A connection to run statements on outside an async operation, such as","@@ -122,17 +159,44 @@ impl ConnectionPool {"," ","     /// A slot and a connection to run one operation on.","     async fn take(&self) -> Result<Checkout> {","-        let slot = Arc::clone(&self.slots)","-            .acquire_owned()","-            .await","-            .expect(\"the pool never closes its semaphore\");","-        let pooled = self.idle","-            .lock()","-            .expect(\"idle connections lock\")","-            .pop();","-        if let Some(conn) = pooled {","-            return Ok(Checkout { idle: Arc::clone(&self.idle), _slot: slot, conn });","+        let slot = self.acquire_slot().await;","+        match self.pop_idle() {","+            Some(conn) => Ok(self.checkout_of(slot, conn)),","+            None => self.connect_in(slot).await,","+        }","+    }","+","+    /// A slot and a new connection, closing every idle one.","+    async fn open(&self) -> Result<Checkout> {","+        let slot = self.acquire_slot().await;","+        let idle = std::mem::take(&mut *self.idle.lock().expect(\"idle connections lock\"));","+        drop(idle);","+        self.connect_in(slot).await","+    }","+","+    async fn acquire_slot(&self) -> OwnedSemaphorePermit {","+        Arc::clone(&self.slots).acquire_owned().await.expect(\"the pool never closes its semaphore\")","+    }","+","+    /// The connection idle the shortest, unless it idled past the expiry:","+    /// then it and every connection idle longer are closed.","+    fn pop_idle(&self) -> Option<Connection> {","+        let mut idle = self.idle.lock().expect(\"idle connections lock\");","+        let newest = idle.pop()?;","+        if self.idle_expiry.is_none_or(|expiry| newest.since.elapsed() < expiry) {","+            return Some(newest.conn);","         }","+        let expired = std::mem::take(&mut *idle);","+        drop(idle);","+        drop((newest, expired));","+        None","+    }","+","+    fn checkout_of(&self, slot: OwnedSemaphorePermit, conn: Connection) -> Checkout {","+        Checkout { idle: Arc::clone(&self.idle), _slot: slot, conn }","+    }","+","+    async fn connect_in(&self, slot: OwnedSemaphorePermit) -> Result<Checkout> {","         let open = Arc::clone(&self.opens)","             .acquire_owned()","             .await","@@ -144,7 +208,23 @@ impl ConnectionPool {","         })","         .await","         .expect(\"opening a libsql connection panicked\")?;","-        Ok(Checkout { idle: Arc::clone(&self.idle), _slot: slot, conn })","+        Ok(self.checkout_of(slot, conn))","+    }","+","+    /// Keep idle connections however long they idle. An embedded replica's","+    /// connection reads a local file and holds no stream that could expire,","+    /// and opening one can wait for a background sync.","+    #[must_use]","+    pub fn replica(mut self) -> Self {","+        self.idle_expiry = None;","+        self","+    }","+","+    /// Close connections idle for `expiry` rather than [`IDLE_EXPIRY`].","+    #[cfg(test)]","+    pub(crate) fn with_idle_expiry(mut self, expiry: Duration) -> Self {","+        self.idle_expiry = Some(expiry);","+        self","     }"," ","     /// How many connection opens are still running.","@@ -172,10 +252,15 @@ impl ConnectionPool {","     }"," }"," ","+struct Idle {","+    conn: Connection,","+    since: Instant,","+}","+"," /// A connection checked out of a [`ConnectionPool`], holding one of its"," /// slots until it is released or dropped."," pub struct Checkout {","-    idle: Arc<Mutex<Vec<Connection>>>,","+    idle: Arc<Mutex<Vec<Idle>>>,","     /// Declared before the slot, so a dropped checkout closes its connection","     /// before the slot lets another operation open one.","     conn: Connection,","@@ -195,7 +280,7 @@ impl Checkout {","             self.idle","                 .lock()","                 .expect(\"idle connections lock\")","-                .push(self.conn);","+                .push(Idle { conn: self.conn, since: Instant::now() });","         }","     }"," ","@@ -213,9 +298,9 @@ impl Checkout {","         });","     }"," ","-    async fn run<Loaded, Operation, Pending>(self, operation: Operation) -> Result<Loaded>","+    async fn run<Loaded, Operation, Pending>(self, operation: &mut Operation) -> Result<Loaded>","     where","-        Operation: FnOnce(Connection) -> Pending,","+        Operation: FnMut(Connection) -> Pending,","         Pending: Future<Output = Result<Loaded>>,","     {","         let result = operation(self.conn.clone()).await;"],"additions":114,"deletions":29,"truncated":false},{"path":"pnpr/crates/libsql/src/pool/tests.rs","lines":["@@ -1,7 +1,7 @@"," use crate::{","-    LibsqlConnector,","+    LibsqlConnector, first_row,","     pool::ConnectionPool,","-    testing::{SYNC_STALL, serve_primary},","+    testing::{Primary, SYNC_STALL, serve_primary},"," };"," use axum::{Json, Router, extract::State, http::StatusCode, routing::post};"," use libsql::{Builder, Database};","@@ -10,7 +10,10 @@ use serde_json::{Value, json};"," use std::{","     collections::HashSet,","     fmt::Write as _,","-    sync::{Arc, Mutex, atomic::Ordering},","+    sync::{","+        Arc, Mutex,","+        atomic::{AtomicUsize, Ordering},","+    },","     time::Duration,"," };"," ","@@ -221,3 +224,162 @@ async fn a_stalled_replica_sync_does_not_hold_operations_past_their_deadline() {","     assert!(elapsed < SYNC_STALL / 2, \"{elapsed:?}\");","     assert_eq!(in_flight, max_connections, \"opens still blocked once every read timed out\");"," }","+","+/// A pooled connection idle past its expiry is closed rather than handed out,","+/// so the server never sees a request on a stream it expired.","+#[tokio::test]","+async fn a_connection_idle_past_its_expiry_is_not_handed_out() {","+    let directory = tempfile::tempdir().unwrap();","+    let (primary, db, server) = remote_primary(directory.path()).await;","+    primary.expire_streams_after(Duration::from_millis(400));","+    let pool = ConnectionPool::new(db, 1, Duration::from_secs(30), timed_out)","+        .with_idle_expiry(Duration::from_millis(200));","+    pool.read(|conn| async move { Ok(conn.query(\"SELECT 1\", ()).await?) }).await","+        .unwrap();","+","+    tokio::time::sleep(Duration::from_millis(500)).await;","+    let after = pool.read(|conn| async move { Ok(conn.query(\"SELECT 1\", ()).await?) }).await;","+    let rejections = primary.stale_stream_rejections();","+    server.abort();","+    after.unwrap();","+    assert_eq!(rejections, 0);","+}","+","+/// A server can expire a stream sooner than the pool expects. The read on it","+/// runs again on a new connection.","+#[tokio::test]","+async fn a_read_on_a_stream_the_server_expired_runs_again() {","+    let directory = tempfile::tempdir().unwrap();","+    let (primary, db, server) = remote_primary(directory.path()).await;","+    primary.expire_streams_after(Duration::from_millis(100));","+    let pool = ConnectionPool::new(db, 1, Duration::from_secs(30), timed_out);","+    pool.read(|conn| async move { Ok(conn.query(\"SELECT 1\", ()).await?) }).await","+        .unwrap();","+","+    tokio::time::sleep(Duration::from_millis(200)).await;","+    let after = pool.read(|conn| async move { Ok(conn.query(\"SELECT 1\", ()).await?) }).await;","+    let rejections = primary.stale_stream_rejections();","+    server.abort();","+    after.unwrap();","+    assert_eq!(rejections, 1);","+}","+","+/// After the server forgets its streams, as a restart does, a write or a read","+/// on a pooled connection runs again on a new one. The write is applied once,","+/// and its rejection closes the other idle connection too. A connection keeps","+/// its stream open after a query, and closes it after a statement that","+/// commits on its own.","+#[tokio::test]","+async fn operations_on_streams_the_server_forgot_run_again_on_new_connections() {","+    let directory = tempfile::tempdir().unwrap();","+    let (primary, db, server) = remote_primary(directory.path()).await;","+    primary.conn","+        .execute(\"CREATE TABLE items (id INTEGER)\", ())","+        .await","+        .unwrap();","+    let pool = ConnectionPool::new(db, 2, Duration::from_secs(30), timed_out);","+    let (first, second) = (count_items(&pool), count_items(&pool));","+    let (first, second) = tokio::join!(first, second);","+    first.unwrap();","+    second.unwrap();","+","+    primary.restart();","+    let written =","+        pool.write(","+            |conn| async move { Ok(conn.execute(\"INSERT INTO items VALUES (1)\", ()).await?) },","+        )","+        .await;","+    let rejected_by_write = primary.stale_stream_rejections();","+    let (first_count, second_count) = (count_items(&pool), count_items(&pool));","+    let (first_count, second_count) = tokio::join!(first_count, second_count);","+    let rejected_by_concurrent_reads = primary.stale_stream_rejections() - rejected_by_write;","+    primary.restart();","+    let count_after_restart = count_items(&pool).await;","+    let rejected_by_read = primary.stale_stream_rejections() - rejected_by_write;","+    server.abort();","+    written.unwrap();","+    for counted in [first_count, second_count, count_after_restart] {","+        assert_eq!(counted.unwrap(), Some(1));","+    }","+    assert_eq!((rejected_by_write, rejected_by_concurrent_reads, rejected_by_read), (1, 0, 1));","+}","+","+/// A server that restarts while a write's transaction is open discards the","+/// transaction, so the write runs again from its start and applies once.","+#[tokio::test]","+async fn a_transaction_the_server_dropped_runs_again_and_applies_once() {","+    let directory = tempfile::tempdir().unwrap();","+    let (primary, db, server) = remote_primary(directory.path()).await;","+    primary.conn","+        .execute(\"CREATE TABLE items (id INTEGER)\", ())","+        .await","+        .unwrap();","+    let pool = ConnectionPool::new(db, 1, Duration::from_secs(30), timed_out);","+    let runs = AtomicUsize::new(0);","+    let written = pool.write(|conn| {","+        let restart = runs.fetch_add(1, Ordering::SeqCst) == 0;","+        let primary = Arc::clone(&primary);","+        async move {","+            let tx = conn.transaction().await?;","+            tx.execute(\"INSERT INTO items VALUES (1)\", ()).await?;","+            if restart {","+                primary.restart();","+            }","+            tx.commit().await?;","+            Ok(())","+        }","+    })","+    .await;","+    let counted = count_items(&pool).await;","+    server.abort();","+    written.unwrap();","+    assert_eq!(runs.load(Ordering::SeqCst), 2);","+    assert_eq!(counted.unwrap(), Some(1));","+}","+","+/// A replica's pool keeps a connection however long it idled: the second","+/// read sees the temporary table only its connection holds.","+#[tokio::test]","+async fn a_replica_pool_keeps_idle_connections() {","+    let directory = tempfile::tempdir().unwrap();","+    let db = Builder::new_local(directory.path().join(\"local.db\")).build().await.unwrap();","+    let pool = ConnectionPool::new(db, 1, Duration::from_secs(30), timed_out)","+        .with_idle_expiry(Duration::from_millis(10))","+        .replica();","+    pool.write(","+        |conn| async move { Ok(conn.execute(\"CREATE TEMP TABLE held (id INTEGER)\", ()).await?) },","+    )","+    .await","+    .unwrap();","+","+    tokio::time::sleep(Duration::from_millis(50)).await;","+    pool.read(|conn| async move { Ok(conn.query(\"SELECT * FROM held\", ()).await?) })","+        .await","+        .unwrap();","+}","+","+async fn count_items(pool: &ConnectionPool) -> pnpr_error::Result<Option<i64>> {","+    pool.read(|conn| async move {","+        let rows = conn.query(\"SELECT count(*) FROM items\", ()).await?;","+        first_row(rows, read_count).await","+    })","+    .await","+}","+","+fn read_count(row: &libsql::Row) -> pnpr_error::Result<i64> {","+    Ok(row.get::<i64>(0)?)","+}","+","+/// The mock primary at `directory`, and a remote database on it.","+async fn remote_primary(","+    directory: &std::path::Path,","+) -> (Arc<Primary>, Database, tokio::task::JoinHandle<()>) {","+    let (primary, address, server) = serve_primary(directory.join(\"primary.db\")).await;","+    let url = format!(\"http://{address}\");","+    let db = Builder::new_remote(url.clone(), String::new())","+        .connector(LibsqlConnector::for_url(&url, false).unwrap())","+        .build()","+        .await","+        .unwrap();","+    (primary, db, server)","+}"],"additions":165,"deletions":3,"truncated":false},{"path":"pnpr/crates/libsql/src/testing.rs","lines":["@@ -15,6 +15,7 @@ use axum::{","     Json, Router,","     extract::{Path, State},","     http::StatusCode,","+    response::{IntoResponse, Response},","     routing::{get, post},"," };"," use libsql::{Builder, Connection, Database};","@@ -27,7 +28,7 @@ use std::{","         Arc,","         atomic::{AtomicBool, AtomicUsize, Ordering},","     },","-    time::Duration,","+    time::{Duration, Instant},"," };"," "," /// The layout of a `SQLite` WAL file, whose frames the sync protocol serves.","@@ -61,23 +62,89 @@ pub struct Primary {"," /// hold transactions of their own, as on a real primary."," struct Streams {","     db: Database,","-    open: std::sync::Mutex<HashMap<String, Connection>>,","+    open: std::sync::Mutex<HashMap<String, OpenStream>>,","     batons: AtomicUsize,","+    /// How long a stream may idle before it expires. `None` keeps it open.","+    expiry: std::sync::Mutex<Option<Duration>>,","+    /// See [`Primary::stale_stream_rejections`].","+    rejected: AtomicUsize,","+}","+","+/// What a Hrana request carries.","+#[derive(Clone, Copy)]","+enum Request {","+    Statements,","+    /// Only a close, which libsql sends for every connection it drops. A","+    /// refused one is not counted in [`Primary::stale_stream_rejections`].","+    Close,","+}","+","+struct OpenStream {","+    conn: Connection,","+    since: Instant,","+}","+","+/// How `sqld` refuses a request on a stream it no longer holds. It runs","+/// nothing of the request.","+enum StaleStream {","+    Expired,","+    Unknown,","+}","+","+impl IntoResponse for StaleStream {","+    fn into_response(self) -> Response {","+        match self {","+            Self::Expired => (","+                StatusCode::BAD_REQUEST,","+                Json(json!({","+                    \"message\": \"The stream has expired due to inactivity\",","+                    \"code\": \"STREAM_EXPIRED\",","+                })),","+            )","+                .into_response(),","+            Self::Unknown => (StatusCode::BAD_REQUEST, \"Received an invalid baton\").into_response(),","+        }","+    }"," }"," "," impl Streams {","+    /// No open streams on `db`, which never expire.","+    fn new(db: Database) -> Self {","+        Self {","+            db,","+            open: std::sync::Mutex::new(HashMap::new()),","+            batons: AtomicUsize::new(0),","+            expiry: std::sync::Mutex::new(None),","+            rejected: AtomicUsize::new(0),","+        }","+    }","+","     /// The connection of the stream `baton` names, or of a new stream.","-    async fn take(&self, baton: Option<&str>) -> Connection {","-        let open = baton.and_then(|baton| self.open.lock().unwrap().remove(baton));","-        if let Some(conn) = open {","-            return conn;","+    async fn take(&self, baton: Option<&str>, request: Request) -> Result<Connection, StaleStream> {","+        if let Some(baton) = baton {","+            let stream = self.open.lock().unwrap().remove(baton);","+            let expiry = *self.expiry.lock().unwrap();","+            let stale = match stream {","+                Some(stream) if expiry.is_none_or(|expiry| stream.since.elapsed() < expiry) => {","+                    return Ok(stream.conn);","+                }","+                Some(_) => StaleStream::Expired,","+                None => StaleStream::Unknown,","+            };","+            match request {","+                Request::Statements => {","+                    self.rejected.fetch_add(1, Ordering::SeqCst);","+                }"],"additions":70,"deletions":6,"truncated":false}],"additions":419,"deletions":47,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-11T15:38:44.034791+00:00"}