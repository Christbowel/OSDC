108 @@ public async Task PatternGroupAndUser()","         }","     }"," ","+    // Regression test:","+    // There was a bug where internal state removed the group from the connection on mismatched casing.","+    // Meaning we wouldn't remove the connection from the internal group collection and unsubscribe from the Redis channel when the group was empty.","+    [Fact]","+    public async Task GroupCasingIsRespected()","+    {","+        var server = new TestRedisServer();","+","+        using (var client = new TestClient())","+        {","+            var manager = CreateLifetimeManager(server);","+","+            var connection = HubConnectionContextUtils.Create(client.Connection);","+            await manager.OnConnectedAsync(connection).DefaultTimeout();","+","+            await manager.AddToGroupAsync(connection.ConnectionId, \"customgroup\").DefaultTimeout();","+","+            await manager.RemoveFromGroupAsync(connection.ConnectionId, \"CUSTOMGROUP\").DefaultTimeout();","+","+            var subscriptions = Assert.Single(server.GetSubscriptions(),","+            // Using 'Contains' so we don't have to worry about the format of the channel prefix","+            channel => channel.Key.ToString().Contains(\"customgroup\"));","+","+            Assert.Single(subscriptions.Value);","+","+            await manager.OnDisconnectedAsync(connection).DefaultTimeout();","+        }","+","+        var subscription = Assert.Single(server.GetSubscriptions(),","+            // Using 'Contains' so we don't have to worry about the format of the channel prefix","+            channel => channel.Key.ToString().Contains(\"customgroup\"));","+","+        // Our TestSubscriber doesn't remove the subscription when the last subscriber leaves, but it does remove the callbacks which we can check","+        Assert.Empty(subscription.Value);","+    }","+","+    [Fact]","+    public async Task OnDisconnectedAsyncRemovesRemainingGroupsWhenOneUnsubscribeFails()","+    {","+        var server = new TestRedisServer();","+","+        using (var client = new TestClient())","+        {","+            var manager = CreateLifetimeManager(server);","+","+            var connection = HubConnectionContextUtils.Create(client.Connection);","+            await manager.OnConnectedAsync(connection).DefaultTimeout();","+","+            await manager.AddToGroupAsync(connection.ConnectionId, \"group1\").DefaultTimeout();","+            await manager.AddToGroupAsync(connection.ConnectionId, \"group2\").DefaultTimeout();","+","+            server.UnsubscribeExceptionFactory = channel =>","+                channel.ToString().Contains(\"group1\") ? new InvalidOperationException(\"Unsubscribe failed.\") : null;","+","+            var exception = await Assert.ThrowsAsync<InvalidOperationException>(","+                () => manager.OnDisconnectedAsync(connection)).DefaultTimeout();","+            Assert.Equal(\"Unsubscribe failed.\", exception.Message);","+        }","+","+        var subscription = Assert.Single(server.GetSubscriptions(),","+            channel => channel.Key.ToString().Contains(\"group2\"));","+        Assert.Empty(subscription.Value);","+    }","+","+    [Fact]","+    public async Task FailedGroupSubscribeRollsBackGroupAndSubscriptionState()","+    {","+        var server = new TestRedisServer();","+","+        using (var client1 = new TestClient())","+        using (var client2 = new TestClient())","+        {","+            var manager = CreateLifetimeManager(server);","+","+            var connection1 = HubConnectionContextUtils.Create(client1.Connection);","+            var connection2 = HubConnectionContextUtils.Create(client2.Connection);","+            await manager.OnConnectedAsync(connection1).DefaultTimeout();","+            await manager.OnConnectedAsync(connection2).DefaultTimeout();","+","+            server.SubscribeExceptionFactory = channel =>","+                channel.ToString().Contains(\"retry-group\") ? new InvalidOperationException(\"Subscribe failed.\") : null;","+","+            var exception = await Assert.ThrowsAsync<InvalidOperationException>(","+                () => manager.AddToGroupAsync(connection1.ConnectionId, \"retry-group\")).DefaultTimeout();","+            Assert.Equal(\"Subscribe failed.\", exception.Message);","+","+            server.SubscribeExceptionFactory = null;","+            await manager.AddToGroupAsync(connection2.ConnectionId, \"retry-group\").DefaultTimeout();","+            await manager.AddToGroupAsync(connection1.ConnectionId, \"retry-group\").DefaultTimeout();","+","+            var subscription = Assert.Single(server.GetSubscriptions(),","+                channel => channel.Key.ToString().Contains(\"retry-group\"));","+            Assert.Single(subscription.Value);","+","+            await manager.OnDisconnectedAsync(connection2).DefaultTimeout();","+            Assert.Single(subscription.Value);","+","+            await manager.OnDisconnectedAsync(connection1).DefaultTimeout();","+            Assert.Empty(subscription.Value);","+        }","+    }","+","     public override TestRedisServer CreateBackplane()","     {","         return new TestRedisServer();"],"additions":102,"deletions":0,"truncated":false},{"path":"src/SignalR/server/StackExchangeRedis/test/TestConnectionMultiplexer.cs","lines":["@@ -239,6 +239,14 @@ public class TestRedisServer","     private readonly ConcurrentDictionary<RedisChannel, List<(int, Action<RedisChannel, RedisValue>)>> _subscriptions =","         new ConcurrentDictionary<RedisChannel, List<(int, Action<RedisChannel, RedisValue>)>>();"," ","+    public Func<RedisChannel, Exception> SubscribeExceptionFactory { get; set; }","+    public Func<RedisChannel, Exception> UnsubscribeExceptionFactory { get; set; }","+","+    public Dictionary<RedisChannel, List<(int, Action<RedisChannel, RedisValue>)>> GetSubscriptions()","+    {","+        return _subscriptions.ToDictionary();","+    }","+","     public long Publish(RedisChannel channel, 