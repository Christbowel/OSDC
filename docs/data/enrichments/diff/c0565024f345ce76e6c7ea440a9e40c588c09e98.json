when:","+        CompletableFuture<Boolean> sent = session.sendAllAsync(Flux.never().doOnCancel { cancelled.complete(true) }, MediaType.TEXT_PLAIN_TYPE)","+        sent.cancel(true)","+","+        then:","+        cancelled.get(10, TimeUnit.SECONDS)","+    }","+","+    void 'closing the channel completes the future with false and cancels the publisher'() {","+        given:","+        NettyWebSocketSession session = session(client)","+        CompletableFuture<Boolean> cancelled = new CompletableFuture<>()","+","+        when:","+        CompletableFuture<Boolean> sent = session.sendAllAsync(Flux.never().doOnCancel { cancelled.complete(true) }, MediaType.TEXT_PLAIN_TYPE)","+        client.close().sync()","+","+        then:","+        sent.get(10, TimeUnit.SECONDS) == false","+        cancelled.get(10, TimeUnit.SECONDS)","+    }","+","+    private static NettyWebSocketSession session(Channel channel) {","+        return new NettyWebSocketSession('id', channel, HttpRequest.GET('/'), null, null, '13', false) {","+        }","+    }","+","+    @io.netty.channel.ChannelHandler.Sharable","+    static class FlushCounter extends ChannelOutboundHandlerAdapter {","+        final AtomicInteger count = new AtomicInteger()","+","+        @Override","+        void flush(ChannelHandlerContext ctx) throws Exception {","+            count.incrementAndGet()","+            super.flush(ctx)","+        }","+    }","+}"],"additions":161,"deletions":0,"truncated":false},{"path":"http-server-netty/src/main/java/io/micronaut/http/server/netty/websocket/NettyServerWebSocketHandler.java","lines":["@@ -15,6 +15,7 @@","  */"," package io.micronaut.http.server.netty.websocket;"," ","+import io.micronaut.buffer.netty.NettyByteBufferFactory;"," import io.micronaut.context.event.ApplicationEventPublisher;"," import io.micronaut.core.annotation.Internal;"," import io.micronaut.core.async.publisher.Publishers;","@@ -23,7 +24,10 @@"," import io.micronaut.core.bind.ExecutableBinder;"," import io.micro