{"id":"ef1dffcd1c8b2540814d9c94ba4931c0382d0894","axis":"silent","repo":"jaegertracing/jaeger","sha":"ef1dffcd1c8b2540814d9c94ba4931c0382d0894","parsed":{"files":[{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/apiv3/grpc_handler.go","lines":["@@ -110,6 +110,12 @@ func traceQueryParams(query *api_v3.TraceQueryParameters) (querysvc.TraceQueryPa"," \t\t}"," \t\tqueryParams.Filter = filter"," \t}","+\tif pagination := query.GetPagination(); pagination != nil {","+\t\tqueryParams.Pagination = &tracestore.Pagination{","+\t\t\tPageSize:  int(pagination.GetPageSize()),","+\t\t\tPageToken: pagination.GetPageToken(),","+\t\t}","+\t}"," \treturn queryParams, nil"," }"," "],"additions":6,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/internal/apiv3/grpc_handler_test.go","lines":["@@ -315,6 +315,41 @@ func TestTraceQueryParamsSearchDepth(t *testing.T) {"," \t}"," }"," ","+// TestTraceQueryParamsPagination pins that an api_v3.Pagination on the wire reaches","+// querysvc.TraceQueryParams unchanged, and that an absent one leaves the zero value, which","+// prepareSearchQuery reads as \"not a paginated request\" (RFC 0014 §4).","+func TestTraceQueryParamsPagination(t *testing.T) {","+\tbaseQuery := func() *api_v3.TraceQueryParameters {","+\t\treturn &api_v3.TraceQueryParameters{","+\t\t\tStartTimeMin: time.Now().Add(-2 * time.Hour),","+\t\t\tStartTimeMax: time.Now(),","+\t\t}","+\t}","+\tt.Run(\"absent pagination\", func(t *testing.T) {","+\t\tparams, err := traceQueryParams(baseQuery())","+\t\trequire.NoError(t, err)","+\t\tassert.Nil(t, params.Pagination)","+\t})","+\tt.Run(\"pagination present\", func(t *testing.T) {","+\t\tquery := baseQuery()","+\t\tquery.Pagination = &api_v3.Pagination{PageSize: 25, PageToken: \"opaque-cursor\"}","+\t\tparams, err := traceQueryParams(query)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, &tracestore.Pagination{PageSize: 25, PageToken: \"opaque-cursor\"}, params.Pagination)","+\t\tassert.Zero(t, params.SearchDepth,","+\t\t\t\"search_depth must not be defaulted when Pagination is present, or every paginated \"+","+\t\t\t\t\"request would trip the query service's mutual-exclusivity check\")","+\t})","+\tt.Run(\"present but empty pagination keeps its presence\", func(t *testing.T) {","+\t\tquery := baseQuery()","+\t\tquery.Pagination = &api_v3.Pagination{}","+\t\tparams, err := traceQueryParams(query)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, &tracestore.Pagination{}, params.Pagination,","+\t\t\t\"the query service refuses this for its missing page size, so it must not read as absent\")","+\t})","+}","+"," func TestFindTracesDefaultsSearchDepth(t *testing.T) {"," \t// A FindTraces request without search_depth (proto3 default 0) reaches the storage"," \t// backend with the default the query service applies. Some backends (e.g. the in-memory"],"additions":35,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/filter.go","lines":["@@ -36,6 +36,37 @@ var StructuredFiltersGate = featuregate.GlobalRegistry().MustRegister("," // ignored, because dropping a predicate would answer with every trace in the time range."," var ErrFilterDisabled = errors.New(\"the structured query filter is disabled\")"," ","+// queryToReaderShape returns the query in the shape the reader declared it can serve, immediately","+// before dispatch.","+//","+// A reader that cannot paginate has no field to read PageSize from, so PageSize is folded into","+// SearchDepth and Pagination is cleared, which keeps the search bounded. A PageToken is never","+// folded: a reader that cannot paginate cannot have minted it, so the query is refused","+// (RFC 0014 §6.2) rather than restarted as a new search.","+//","+// A reader that declares filter support gets the filter itself, once every level and operator","+// it uses is one the reader listed. A reader that declares none gets the filter rewritten into","+// the legacy predicate fields (ToLegacyShape), or a refusal where they cannot carry it.","+func queryToReaderShape(","+\tquery tracestore.TraceQueryParams,","+\tcaps tracestore.SearchCapabilities,","+) (tracestore.TraceQueryParams, error) {","+\tif query.Pagination != nil && !caps.Paginated {","+\t\tif query.Pagination.PageToken != \"\" {","+\t\t\treturn tracestore.TraceQueryParams{}, tracestore.ErrPaginationUnsupported","+\t\t}","+\t\tquery.SearchDepth = query.Pagination.PageSize","+\t\tquery.Pagination = nil","+\t}","+\tif query.Filter == nil {","+\t\treturn query, nil","+\t}","+\tif caps.Filter.IsEmpty() {","+\t\treturn query.ToLegacyShape()","+\t}","+\treturn query, caps.Filter.EnsureSupported(query.Filter)","+}","+"," // IsBadRequest reports whether err means the caller must change the query, either"," // because its shape is wrong or because this deployment's storage cannot serve it."," // Either way it is the caller's problem, so the API layers answer InvalidArgument /","@@ -46,5 +77,9 @@ func IsBadRequest(err error) bool {"," \t\terrors.Is(err, ErrSpanSearchUnsupported) ||"," \t\terrors.Is(err, ErrFilterDisabled) ||"," \t\terrors.Is(err, tracestore.ErrFilterUnsupported) ||","-\t\terrors.Is(err, tracestore.ErrFilterInvalid)","+\t\terrors.Is(err, tracestore.ErrFilterInvalid) ||","+\t\terrors.Is(err, ErrPaginationDisabled) ||","+\t\terrors.Is(err, tracestore.ErrPaginationUnsupported) ||","+\t\terrors.Is(err, tracestore.ErrPaginationInvalid) ||","+\t\terrors.Is(err, tracestore.ErrPaginationUnsupportedByFindTraces)"," }"],"additions":36,"deletions":1,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/filter_test.go","lines":["@@ -71,7 +71,7 @@ func TestPrepareFilteredQuery_PassesFilterToADeclaringReader(t *testing.T) {"," \t\t\t\t&expression.StringValue{Value: \"exception\"})))"," \tquery := filterQuery(filter)"," ","-\tgot, err := query.ForCapabilities(caps)","+\tgot, err := queryToReaderShape(query.TraceQueryParams, caps)"," \trequire.NoError(t, err)"," \tassert.Equal(t, query.TraceQueryParams, got)"," }","@@ -169,7 +169,7 @@ func TestPrepareFilteredQuery_RefusesWhatAReaderDidNotDeclare(t *testing.T) {"," \tfor _, test := range tests {"," \t\tt.Run(test.name, func(t *testing.T) {"," \t\t\tcaps := tracestore.SearchCapabilities{Filter: &test.caps}","-\t\t\t_, err := filterQuery(test.filter).ForCapabilities(caps)","+\t\t\t_, err := queryToReaderShape(filterQuery(test.filter).TraceQueryParams, caps)"," \t\t\trequire.ErrorIs(t, err, tracestore.ErrFilterUnsupported)"," \t\t\tassert.Contains(t, err.Error(), test.expectedErr)"," \t\t})","@@ -339,6 +339,10 @@ func TestIsBadRequest(t *testing.T) {"," \tassert.True(t, IsBadRequest(tracestore.ErrFilterInvalid))"," \tassert.True(t, IsBadRequest(ErrFilterDisabled))"," \tassert.True(t, IsBadRequest(fmt.Errorf(\"%w: nested\", tracestore.ErrFilterUnsupported)))","+\tassert.True(t, IsBadRequest(ErrPaginationDisabled))","+\tassert.True(t, IsBadRequest(tracestore.ErrPaginationUnsupported))","+\tassert.True(t, IsBadRequest(tracestore.ErrPaginationInvalid))","+\tassert.True(t, IsBadRequest(tracestore.ErrPaginationUnsupportedByFindTraces))"," \tassert.False(t, IsBadRequest(errors.New(\"storage is down\")))"," \tassert.False(t, IsBadRequest(nil))"," }","@@ -355,7 +359,7 @@ func TestPrepareFilteredQuery_EmptyDeclarationIsNoDeclaration(t *testing.T) {"," \t\t\"empty declaration\": {Filter: &tracestore.FilterCapabilities{}},"," \t} {"," \t\tt.Run(name, func(t *testing.T) {","-\t\t\tgot, err := filterQuery(filter).ForCapabilities(caps)","+\t\t\tgot, err := queryToReaderShape(filterQuery(filter).TraceQueryParams, caps)"," \t\t\trequire.NoError(t, err)"," \t\t\tassert.Nil(t, got.Filter, \"the filter is rewritten, not sent down\")"," \t\t\tvalue, ok := got.Attributes.Get(\"http.method\")","@@ -364,3 +368,95 @@ func TestPrepareFilteredQuery_EmptyDeclarationIsNoDeclaration(t *testing.T) {"," \t\t})"," \t}"," }","+","+func serviceIs(name string) *expression.Call {","+\treturn &expression.Call{Op: expression.OpEq, Args: []expression.Expression{","+\t\t&expression.FieldRef{Name: expression.ResourceFieldService, Level: expression.LevelResource},","+\t\t&expression.StringValue{Value: name},","+\t}}","+}","+","+// TestQueryToReaderShape covers the two conversions toward what a reader declared: a filter is handed","+// over or rewritten into the legacy fields, and a page size is handed over or folded into the","+// search depth, with a page token refused where the reader cannot have minted it.","+func TestQueryToReaderShape(t *testing.T) {","+\tfilterCapable := tracestore.SearchCapabilities{Filter: &tracestore.FilterCapabilities{","+\t\tLevels:    []expression.Level{expression.LevelResource},","+\t\tOperators: []expression.Operator{expression.OpEq},","+\t}}","+","+\tt.Run(\"a paginating reader gets pagination as sent\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Pagination: &tracestore.Pagination{PageSize: 50, PageToken: \"cursor\"}}","+\t\tprepared, err := queryToReaderShape(query, tracestore.SearchCapabilities{Paginated: true})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, query, prepared)","+\t})","+","+\tt.Run(\"a non-paginating reader gets page size folded into search depth\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Pagination: &tracestore.Pagination{PageSize: 50}}","+\t\tprepared, err := queryToReaderShape(query, tracestore.SearchCapabilities{})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, tracestore.TraceQueryParams{SearchDepth: 50}, prepared)","+\t})","+","+\tt.Run(\"a page token against a non-paginating reader is refused\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Pagination: &tracestore.Pagination{PageSize: 50, PageToken: \"cursor\"}}","+\t\t_, err := queryToReaderShape(query, tracestore.SearchCapabilities{})","+\t\trequire.ErrorIs(t, err, tracestore.ErrPaginationUnsupported)","+\t})","+","+\tt.Run(\"no filter is left alone\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{ServiceName: \"cart\"}","+\t\tprepared, err := queryToReaderShape(query, tracestore.SearchCapabilities{})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, query, prepared)","+\t})","+","+\tt.Run(\"a reader that evaluates filters is given the filter\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Filter: serviceIs(\"cart\")}","+\t\tprepared, err := queryToReaderShape(query, filterCapable)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, query, prepared)","+\t})","+","+\tt.Run(\"a reader that evaluates none is given the legacy fields\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Filter: serviceIs(\"cart\")}","+\t\tprepared, err := queryToReaderShape(query, tracestore.SearchCapabilities{})","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, \"cart\", prepared.ServiceName)","+\t\tassert.Nil(t, prepared.Filter)","+\t})","+","+\tt.Run(\"a filter the legacy fields cannot carry is refused\", func(t *testing.T) {","+\t\tdisjunction := &expression.Call{Op: expression.OpOr, Args: []expression.Expression{","+\t\t\tserviceIs(\"cart\"), serviceIs(\"checkout\"),","+\t\t}}","+\t\t_, err := queryToReaderShape(tracestore.TraceQueryParams{Filter: disjunction}, tracestore.SearchCapabilities{})","+\t\trequire.ErrorIs(t, err, tracestore.ErrFilterUnsupported)","+\t})","+","+\tt.Run(\"a predicate the reader did not declare is refused\", func(t *testing.T) {","+\t\tspanLevel := &expression.Call{Op: expression.OpEq, Args: []expression.Expression{","+\t\t\t&expression.AttributeRef{Key: \"http.route\", Level: expression.LevelSpan},","+\t\t\t&expression.AnyValue{Value: \"/cart\"},","+\t\t}}","+\t\t_, err := queryToReaderShape(tracestore.TraceQueryParams{Filter: spanLevel}, filterCapable)","+\t\trequire.ErrorIs(t, err, tracestore.ErrFilterUnsupported)","+\t\trequire.ErrorContains(t, err, `it does not index the \"span\" level`)","+\t})","+","+\tt.Run(\"pagination and filter both apply, pagination first\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Filter: serviceIs(\"cart\"), Pagination: &tracestore.Pagination{PageSize: 50}}","+\t\tprepared, err := queryToReaderShape(query, filterCapable)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, serviceIs(\"cart\"), prepared.Filter, \"a paginated query still gets its filter evaluated\")","+\t\tassert.Equal(t, 50, prepared.SearchDepth, \"a reader that declared no Paginated support still gets a bound\")","+\t\tassert.Nil(t, prepared.Pagination)","+\t})","+","+\tt.Run(\"a page token against a non-paginating reader is refused before the filter is touched\", func(t *testing.T) {","+\t\tquery := tracestore.TraceQueryParams{Filter: serviceIs(\"cart\"), Pagination: &tracestore.Pagination{PageSize: 50, PageToken: \"cursor\"}}","+\t\t_, err := queryToReaderShape(query, filterCapable)","+\t\trequire.ErrorIs(t, err, tracestore.ErrPaginationUnsupported)","+\t})","+}"],"additions":99,"deletions":3,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/interceptor_test.go","lines":["@@ -632,24 +632,6 @@ func TestFindTraces_LeavesALegacyQueryAloneWhenNothingChangedIt(t *testing.T) {"," \t\trequire.NoError(t, err)"," \t\trequire.NotNil(t, next.gotQuery.Filter, \"a filter the caller sent stays a filter\")"," \t})","-","-\tt.Run(\"an interceptor's rewrite keeps the result bound\", func(t *testing.T) {","-\t\tenableStructuredFilters(t)","-\t\tnext := &fakeReader{batch: tracesWith(\"k\", \"v\")}","-\t\tnext.capabilities = filterCapableBackend()","-\t\tqs := interceptedService(next, fakeInterceptor{onQuery: narrowTo(serviceFilter(\"gated\"))})","-","-\t\t_, err := collectTraces(qs.FindTraces(t.Context(), searchQuery(tracestore.TraceQueryParams{","-\t\t\tFilter:      serviceFilter(\"original\"),","-\t\t\tSearchDepth: 7,","-\t\t\tPagination:  tracestore.Pagination{PageSize: 3, PageToken: \"next\"},","-\t\t})))","-\t\trequire.NoError(t, err)","-\t\tassert.Equal(t, serviceFilter(\"gated\"), next.gotQuery.Filter)","-\t\tassert.Equal(t, 7, next.gotQuery.SearchDepth, \"the interceptor never saw the search depth\")","-\t\tassert.Equal(t, tracestore.Pagination{PageSize: 3, PageToken: \"next\"}, next.gotQuery.Pagination,","-\t\t\t\"the interceptor never saw the pagination\")","-\t})"," }"," "," // TestFindTraces_RefusesAFilterALaterInterceptorDrops pins that the nil rule holds across the"],"additions":0,"deletions":18,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/pagination.go","lines":["@@ -0,0 +1,26 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package querysvc","+","+import (","+\t\"errors\"","+","+\t\"go.opentelemetry.io/collector/featuregate\"","+)","+","+// PaginationGate admits the RFC 0014 Pagination field on a trace search. No Reader returns a","+// continuation token yet, so enabling it does not make results resumable end to end.","+var PaginationGate = featuregate.GlobalRegistry().MustRegister(","+\t\"jaeger.query.pagination\",","+\tfeaturegate.StageAlpha,","+\tfeaturegate.WithRegisterFromVersion(\"v2.21.0\"),","+\tfeaturegate.WithRegisterDescription(","+\t\t\"Accepts the RFC 0014 Pagination field on a trace search. No storage backend returns a \"+","+\t\t\t\"continuation token yet, so enabling it does not make results resumable end to end.\",","+\t),","+\tfeaturegate.WithRegisterReferenceURL(\"https://github.com/jaegertracing/jaeger/blob/main/docs/rfc/0014-search-result-pagination.md\"),","+)","+","+// ErrPaginationDisabled is returned for a query carrying Pagination while PaginationGate is off.","+var ErrPaginationDisabled = errors.New(\"pagination is disabled\")"],"additions":26,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/pagination_test.go","lines":["@@ -0,0 +1,278 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package querysvc","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/collector/featuregate\"","+","+\texpression \"github.com/jaegertracing/jaeger-idl/query/expression/v1\"","+\t\"github.com/jaegertracing/jaeger/internal/jiter\"","+\t\"github.com/jaegertracing/jaeger/internal/storage/v2/api/tracestore\"","+)","+","+func enablePagination(t *testing.T) {","+\tsetPagination(t, true)","+}","+","+func setPagination(t *testing.T, enabled bool) {","+\toriginal := PaginationGate.IsEnabled()","+\trequire.NoError(t, featuregate.GlobalRegistry().Set(PaginationGate.ID(), enabled))","+\tt.Cleanup(func() {","+\t\trequire.NoError(t, featuregate.GlobalRegistry().Set(PaginationGate.ID(), original))","+\t})","+}","+","+func TestPaginationGate_IsAlpha(t *testing.T) {","+\tassert.Equal(t, featuregate.StageAlpha, PaginationGate.Stage(),","+\t\t\"Alpha is what keeps pagination off unless a deployment asks for it\")","+}","+","+// TestFindTraces_RejectsPagination pins that FindTraces refuses any query carrying Pagination","+// outright, before prepareSearchQuery — which FindTraceSummaries shares and which does admit","+// Pagination — ever sees it. FindTraces streams whole traces with no field to carry a","+// continuation token (RFC 0014 §4).","+func TestFindTraces_RejectsPagination(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{batch: tracesWith(\"k\", \"v\")}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tServiceName: \"svc\",","+\t\tPagination:  &tracestore.Pagination{PageSize: 10},","+\t})","+","+\t_, err := collectTraces(qs.FindTraces(context.Background(), query))","+\trequire.ErrorIs(t, err, tracestore.ErrPaginationUnsupportedByFindTraces)","+\tassert.True(t, IsBadRequest(err), \"the API layers answer 400\")","+\tassert.False(t, next.findCalled, \"storage must not be queried\")","+}","+","+// TestPrepareSearchQuery_PaginationDisabled pins what a deployment that has not opted in does","+// with a query carrying Pagination: it is refused before the reader is asked anything, the same","+// posture TestPrepareSearchQuery_FilterDisabled pins for the filter gate. Driven through","+// FindTraceSummaries, since FindTraces refuses Pagination unconditionally regardless of the","+// gate (TestFindTraces_RejectsPagination).","+func TestPrepareSearchQuery_PaginationDisabled(t *testing.T) {","+\tsetPagination(t, false)","+","+\tnext := &fakeReader{}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tServiceName: \"svc\",","+\t\tPagination:  &tracestore.Pagination{PageSize: 10},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.ErrorIs(t, err, ErrPaginationDisabled)","+\t\trequire.ErrorContains(t, err, \"jaeger.query.pagination\")","+\t\tassert.True(t, IsBadRequest(err), \"the API layers answer 400\")","+\t}","+\tassert.False(t, next.summaryCalled, \"storage must not be queried\")","+}","+","+// TestPrepareSearchQuery_PaginationMutuallyExclusiveWithSearchDepth pins RFC 0014 §4:","+// page_size replaces search_depth rather than falling back to it, so a query that sets both has","+// not said how many results it wants, and is refused rather than letting one silently win.","+func TestPrepareSearchQuery_PaginationMutuallyExclusiveWithSearchDepth(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tServiceName: \"svc\",","+\t\tSearchDepth: 20,","+\t\tPagination:  &tracestore.Pagination{PageSize: 5},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.ErrorIs(t, err, tracestore.ErrPaginationInvalid)","+\t\trequire.ErrorContains(t, err, \"search depth\")","+\t\tassert.True(t, IsBadRequest(err), \"the API layers answer 400\")","+\t}","+\tassert.False(t, next.summaryCalled, \"storage must not be queried\")","+}","+","+// TestPrepareSearchQuery_PageSizeRequiredWhenPaginationPresent pins the other half of RFC 0014","+// §4: a Pagination that leaves page_size at zero does not describe a page, so it is refused","+// rather than silently drawing a bound from anywhere else.","+func TestPrepareSearchQuery_PageSizeRequiredWhenPaginationPresent(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tServiceName: \"svc\",","+\t\tPagination:  &tracestore.Pagination{PageToken: \"opaque-cursor\"},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.ErrorIs(t, err, tracestore.ErrPaginationInvalid)","+\t\trequire.ErrorContains(t, err, \"page size is required\")","+\t\tassert.True(t, IsBadRequest(err), \"the API layers answer 400\")","+\t}","+\tassert.False(t, next.summaryCalled, \"storage must not be queried\")","+}","+","+// TestPrepareSearchQuery_EmptyPaginationIsRefused pins the presence the pointer keeps: a","+// pagination message that was sent with neither field is a malformed request, not an absent one.","+func TestPrepareSearchQuery_EmptyPaginationIsRefused(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tServiceName: \"svc\",","+\t\tPagination:  &tracestore.Pagination{},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.ErrorIs(t, err, tracestore.ErrPaginationInvalid)","+\t\trequire.ErrorContains(t, err, \"page size is required\")","+\t}","+\tassert.False(t, next.summaryCalled, \"storage must not be queried\")","+}","+","+// TestPrepareSearchQuery_PageSizeClampedToMax pins that a page size above tracestore.MaxPageSize","+// is clamped down rather than refused, the treatment RFC 0014 §4 (and AIP-158) prescribes. The","+// clamp is the query service's, so every API gets it without deciding it on the wire.","+func TestPrepareSearchQuery_PageSizeClampedToMax(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{summaries: []tracestore.TraceSummary{{RootServiceName: \"svc\"}}}","+\tnext.capabilities = &tracestore.SearchCapabilities{WithoutServiceName: true, Paginated: true}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tPagination: &tracestore.Pagination{PageSize: tracestore.MaxPageSize + 1000},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.NoError(t, err)","+\t}","+\tassert.True(t, next.summaryCalled)","+\tassert.Equal(t, tracestore.MaxPageSize, next.gotSummaryQuery.Pagination.PageSize)","+}","+","+// TestPrepareSearchQuery_PageSizeFoldedIntoSearchDepthWhenUnsupported checks that a page-size-only","+// request against a reader that cannot paginate still reaches it bounded: PageSize is folded into","+// SearchDepth and Pagination is cleared.","+func TestPrepareSearchQuery_PageSizeFoldedIntoSearchDepthWhenUnsupported(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{summaries: []tracestore.TraceSummary{{RootServiceName: \"svc\"}}}","+\tnext.capabilities = &tracestore.SearchCapabilities{WithoutServiceName: true, Paginated: false}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tPagination: &tracestore.Pagination{PageSize: 15},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.NoError(t, err)","+\t}","+\tassert.True(t, next.summaryCalled)","+\tassert.Nil(t, next.gotSummaryQuery.Pagination, \"cleared once folded\")","+\tassert.Equal(t, 15, next.gotSummaryQuery.SearchDepth)","+}","+","+// TestPrepareSearchQuery_PageSizeOnlyKeepsPaginationWhenSupported covers the other side: a","+// reader that declares Paginated keeps Pagination as sent, since it has its own field to read","+// PageSize from.","+func TestPrepareSearchQuery_PageSizeOnlyKeepsPaginationWhenSupported(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{summaries: []tracestore.TraceSummary{{RootServiceName: \"svc\"}}}","+\tnext.capabilities = &tracestore.SearchCapabilities{WithoutServiceName: true, Paginated: true}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tPagination: &tracestore.Pagination{PageSize: 15},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.NoError(t, err)","+\t}","+\tassert.True(t, next.summaryCalled)","+\tassert.Equal(t, &tracestore.Pagination{PageSize: 15}, next.gotSummaryQuery.Pagination)","+\tassert.Zero(t, next.gotSummaryQuery.SearchDepth)","+}","+","+// TestPrepareSearchQuery_PageTokenRejectedWhenUnsupported pins RFC 0014 §6.2: a reader whose","+// SearchCapabilities.Paginated is false cannot have minted a token, so a query carrying one is","+// refused rather than treated as a new search.","+func TestPrepareSearchQuery_PageTokenRejectedWhenUnsupported(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{}","+\tnext.capabilities = &tracestore.SearchCapabilities{WithoutServiceName: true, Paginated: false}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tPagination: &tracestore.Pagination{PageSize: 20, PageToken: \"opaque-cursor\"},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.ErrorIs(t, err, tracestore.ErrPaginationUnsupported)","+\t\tassert.True(t, IsBadRequest(err), \"the API layers answer 400\")","+\t}","+\tassert.False(t, next.summaryCalled, \"storage must not be queried\")","+}","+","+// TestPrepareSearchQuery_PageTokenAcceptedWhenSupported covers the other side of the same","+// check: a reader that declares Paginated keeps the token, and the ServiceName check that","+// follows reuses the same capability fetch rather than asking the reader again.","+func TestPrepareSearchQuery_PageTokenAcceptedWhenSupported(t *testing.T) {","+\tenablePagination(t)","+\tnext := &fakeReader{summaries: []tracestore.TraceSummary{{RootServiceName: \"svc\"}}}","+\tnext.capabilities = &tracestore.SearchCapabilities{WithoutServiceName: true, Paginated: true}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tPagination: &tracestore.Pagination{PageSize: 20, PageToken: \"opaque-cursor\"},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.NoError(t, err)","+\t}","+\tassert.True(t, next.summaryCalled)","+\tassert.Equal(t, \"opaque-cursor\", next.gotSummaryQuery.Pagination.PageToken)","+\tassert.Equal(t, 20, next.gotSummaryQuery.Pagination.PageSize)","+}","+","+// TestPagination_SurvivesInterceptorFilterRewrite checks that Pagination is carried through when","+// onQuery rebuilds the query around an interceptor's rewritten filter. The interceptor contract","+// does not expose Pagination, so it has to come from the pre-interceptor query.","+func TestPagination_SurvivesInterceptorFilterRewrite(t *testing.T) {","+\tenablePagination(t)","+\tenableStructuredFilters(t)","+\tfilter := tag(expression.OpEq, \"a\", \"1\")","+\tnext := &fakeReader{summaries: []tracestore.TraceSummary{{RootServiceName: \"svc\"}}}","+\tnext.capabilities = &tracestore.SearchCapabilities{","+\t\tWithoutServiceName: true,","+\t\tPaginated:          true,","+\t\tFilter: &tracestore.FilterCapabilities{","+\t\t\tLevels:    []expression.Level{expression.LevelSpan},","+\t\t\tOperators: []expression.Operator{expression.OpEq},","+\t\t},","+\t}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{","+\t\tFilter:     filter,","+\t\tPagination: &tracestore.Pagination{PageSize: 10, PageToken: \"opaque-cursor\"},","+\t})","+","+\tfor _, err := range qs.FindTraceSummaries(context.Background(), query) {","+\t\trequire.NoError(t, err)","+\t}","+\tassert.True(t, next.summaryCalled)","+\tassert.Equal(t, &tracestore.Pagination{PageSize: 10, PageToken: \"opaque-cursor\"}, next.gotSummaryQuery.Pagination,","+\t\t\"Pagination must not be dropped by the interceptor round trip\")","+}","+","+// TestPrepareSearchQuery_PaginationZeroValueSkipsGate pins that a query with no Pagination at","+// all takes the same path it always did: the gate is never consulted, so a deployment that has","+// not enabled it sees exactly today's behavior for an unpaginated search (RFC 0014 G5). Driven","+// through FindTraces, which is the RPC a zero Pagination must still work on.","+func TestPrepareSearchQuery_PaginationZeroValueSkipsGate(t *testing.T) {","+\tsetPagination(t, false)","+\tnext := &fakeReader{batch: tracesWith(\"k\", \"v\")}","+\tqs := interceptedService(next, fakeInterceptor{})","+\tquery := searchQuery(tracestore.TraceQueryParams{ServiceName: \"svc\"})","+","+\t_, err := jiter.FlattenWithErrors(qs.FindTraces(context.Background(), query))","+\trequire.NoError(t, err)","+\tassert.True(t, next.findCalled)","+}"],"additions":278,"deletions":0,"truncated":false},{"path":"cmd/jaeger/internal/extension/jaegerquery/querysvc/service.go","lines":["@@ -209,6 +209,11 @@ func (qs QueryService) FindTraces("," \tquery TraceQueryParams,"," ) iter.Seq2[[]ptrace.Traces, error] {"," \treturn func(yield func([]ptrace.Traces, error) bool) {","+\t\t// The FindTraces response has no field for a continuation token (RFC 0014 §4).","+\t\tif query.Pagination != nil {","+\t\t\tyield(nil, tracestore.ErrPaginationUnsupportedByFindTraces)","+\t\t\treturn","+\t\t}"," \t\tctx, query, err := qs.prepareSearchQuery(ctx, query)"," \t\tif err != nil {"," \t\t\tyield(nil, err)","@@ -252,6 +257,23 @@ func (qs QueryService) prepareSearchQuery("," \tif err := query.normalizeEnvelope(); err != nil {"," \t\treturn ctx, query, err"," \t}","+\tif query.Pagination != nil {","+\t\tif !PaginationGate.IsEnabled() {","+\t\t\treturn ctx, query, fmt.Errorf(\"%w: enable the %q feature gate to use it\",","+\t\t\t\tErrPaginationDisabled, PaginationGate.ID())","+\t\t}","+\t\t// A page size replaces the search depth rather than falling back to it (RFC 0014 §4).","+\t\tif query.SearchDepth != 0 {","+\t\t\treturn ctx, query, fmt.Errorf(\"%w: it cannot be combined with search depth\",","+\t\t\t\ttracestore.ErrPaginationInvalid)","+\t\t}","+\t\tif query.Pagination.PageSize <= 0 {","+\t\t\treturn ctx, query, fmt.Errorf(\"%w: page size is required whenever pagination is present\",","+\t\t\t\ttracestore.ErrPaginationInvalid)","+\t\t}","+\t\t// An oversized page is clamped rather than refused (RFC 0014 §4, AIP-158).","+\t\tquery.Pagination.PageSize = min(query.Pagination.PageSize, tracestore.MaxPageSize)","+\t}"," \tif query.Filter != nil {"," \t\t// None of these refusals depends on the backend, so they come before the capability call"," \t\t// rather than after it.","@@ -277,13 +299,13 @@ func (qs QueryService) prepareSearchQuery("," \t\t\treturn ctx, query, err"," \t\t}"," \t}","-\tif query.Filter == nil {","+\tif query.Filter == nil && query.Pagination == nil {"," \t\treturn ctx, query, qs.checkServiceName(ctx, query)"," \t}"," \tcaps := qs.readerSearchCapabilitiesOrDefault(ctx)"," \t// The filter is settled before the service name is checked, because a filter can name the"," \t// service itself and rewriting it is what moves that into ServiceName.","-\tprepared, err := query.ForCapabilities(caps)","+\tprepared, err := queryToReaderShape(query.TraceQueryParams, caps)"," \tif err != nil {"," \t\treturn ctx, query, err"," \t}","@@ -313,7 +335,7 @@ func (q *TraceQueryParams) normalizeEnvelope() error {"," \tif q.SearchDepth < 0 || q.SearchDepth > tracestore.MaxSearchDepth {"," \t\treturn fmt.Errorf(\"%w: