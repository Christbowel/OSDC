, \"x-key\")                  // delete builtin","+//\th[\"x-key\"] = append(h[\"x-key\"], \"v) // read-modify-write","+package headercheck","+","+import (","+\t\"go/ast\"","+\t\"go/constant\"","+\t\"go/token\"","+\t\"go/types\"","+\t\"net/http\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"golang.org/x/tools/go/packages\"","+)","+","+// headerType is the type whose map operations must use canonical keys.","+const headerType = \"net/http.Header\"","+","+// nolintDirective marks a deliberate non-canonical key on its line, such as","+// the RFC 6455 spellings written for case-sensitive upstreams.","+const nolintDirective = \"//nolint:canonicalheader\"","+","+// TODO: delete this package once golangci-lint ships https://github.com/lasiar/canonicalheader/pull/90;","+// the linter honors the same //nolint:canonicalheader directives.","+func TestHeaderKeysAreCanonical(t *testing.T) {","+\tcfg := &packages.Config{","+\t\tMode: packages.NeedName | packages.NeedSyntax | packages.NeedTypes |","+\t\t\tpackages.NeedTypesInfo | packages.NeedDeps | packages.NeedImports,","+\t\tDir:   \"../..\",","+\t\tTests: false,","+\t}","+","+\tpkgs, err := packages.Load(cfg, \"./...\")","+\tif err != nil {","+\t\tt.Fatalf(\"loading packages: %v\", err)","+\t}","+\tif packages.PrintErrors(pkgs) > 0 {","+\t\tt.Fatal(\"packages failed to load; see errors above\")","+\t}","+","+\tvar checked int","+\tfor _, pkg := range pkgs {","+\t\tfor _, file := range pkg.Syntax {","+\t\t\tchecked += checkFile(t, pkg, file)","+\t\t}","+\t}","+","+\t// Guard against the walk silently covering nothing, e.g. if package","+\t// loading is reconfigured and stops yielding type information.","+\tif checked == 0 {","+\t\tt.Fatal(\"no http.Header map operations found; the check is not running\")","+\t}","+\tt.Logf(\"checked %d direct http.Header map operations\", checked)","+}","+","+// checkFile reports the number of direct http.Header map operations examined.","+func checkFile(t *testing.T, pkg *packages.Package, file *ast.File) int {","+\tvar checked int","+","+\texempt := make(map[int]bool)","+\tfor _, group := range file.Comments {","+\t\tfor _, c := range group.List {","+\t\t\tif strings.HasPrefix(c.Text, nolintDirective) {","+\t\t\t\texempt[pkg.Fset.Position(c.Slash).Line] = true","+\t\t\t}","+\t\t}","+\t}","+","+\treport := func(pos token.Pos, key, form string) {","+\t\tcanonical := http.CanonicalHeaderKey(key)","+\t\tif key == canonical || exempt[pkg.Fset.Position(pos).Line] {","+\t\t\treturn","+\t\t}","+\t\tt.Errorf(\"%s: %s uses non-canonical key %q; want %q\",","+\t\t\tpkg.Fset.Position(pos), form, key, canonical)","+\t}","+","+\t// keyOf returns the constant string value of an index or argument","+\t// expression, so both literals and named constants are covered.","+\tkeyOf := func(expr ast.Expr) (string, bool) {","+\t\ttv, ok := pkg.TypesInfo.Types[expr]","+\t\tif !ok || tv.Value == nil || tv.Value.Kind() != constant.String {","+\t\t\treturn \"\", false","+\t\t}","+\t\treturn constant.StringVal(tv.Value), true","+\t}","+","+\tisHeader := func(expr ast.Expr) bool {","+\t\ttv, ok := pkg.TypesInfo.Types[expr]","+\t\tif !ok || tv.Type == nil {","+\t\t\treturn false","+\t\t}","+\t\tnamed, ok := types.Unalias(tv.Type).(*types.Named)","+\t\tif !ok {","+\t\t\treturn false","+\t\t}","+\t\tobj := named.Obj()","+\t\treturn obj != nil && obj.Pkg() != nil &&","+\t\t\tobj.Pkg().Path()+\".\"+obj.Name() == headerType","+\t}","+","+\tast.Inspect(file, func(n ast.Node) bool {","+\t\tswitch node := n.(type) {","+\t\t// h[\"Key\"], including the assignment form h[\"Key\"] = ...","+\t\t// that SA1008 skips.","+\t\tcase *ast.IndexExpr:","+\t\t\tif !isHeader(node.X) {","+\t\t\t\treturn true","+\t\t\t}","+\t\t\tkey, ok := keyOf(node.Index)","+\t\t\tif !ok {","+\t\t\t\treturn true","+\t\t\t}","+\t\t\tchecked++","+\t\t\treport(node.Index.Pos(), key, \"http.Header index\")","+","+\t\t// http.Header{\"Key\": ...}, which stores the key verbatim.","+\t\tcase *ast.CompositeLit:","+\t\t\tif !isHeader(node) {","+\t\t\t\treturn true","+\t\t\t}","+\t\t\tfor _, elt := range node.Elts {","+\t\t\t\tkv, ok := elt.(*ast.KeyValueExpr)","+\t\t\t\tif !ok {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tkey, ok := keyOf(kv.Key)","+\t\t\t\tif !ok {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tchecked++","+\t\t\t\treport(kv.Key.Pos(), key, \"http.Header literal\")","+\t\t\t}","+","+\t\t// delete(h, \"Key\"), which no enabled linter inspects.","+\t\tcase *ast.CallExpr:","+\t\t\tif ident, ok := node.Fun.(*ast.Ident); ok && ident.Name == \"delete\" && len(node.Args) == 2 {","+\t\t\t\tif _, ok := pkg.TypesInfo.Uses[ident].(*types.Builtin); ok && isHeader(node.Args[0]) {","+\t\t\t\t\tif key, ok := keyOf(node.Args[1]); ok {","+\t\t\t\t\t\tchecked++","+\t\t\t\t\t\treport(node.Args[1].Pos(), key, \"delete on http.Header\")","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\treturn true","+\t})","+","+\treturn checked","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"modules/caddyhttp/encode/encode.go","lines":["@@ -23,6 +23,7 @@ import ("," \t\"cmp\""," \t\"fmt\""," \t\"io\"","+\t\"iter\""," \t\"math\""," \t\"net/http\""," \t\"slices\"","@@ -30,6 +31,8 @@ import ("," \t\"strings\""," \t\"sync\""," ","+\t\"golang.org/x/net/http/httpguts\"","+"," \t\"github.com/caddyserver/caddy/v2\""," \t\"github.com/caddyserver/caddy/v2/modules/caddyhttp\""," )","@@ -157,12 +160,17 @@ func (enc *Encode) Validate() error {"," \treturn nil"," }"," ","-func isEncodeAllowed(h http.Header) bool {","-\treturn !strings.Contains(h.Get(\"Cache-Control\"), \"no-transform\")","+func hasNonEmptyValue(h http.Header, key string) bool {","+\tfor _, v := range h[key] {","+\t\tif v != \"\" {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false"," }"," "," func (enc *Encode) ServeHTTP(w http.ResponseWriter, r *http.Request, next caddyhttp.Handler) error {","-\tif isEncodeAllowed(r.Header) {","+\tif !httpguts.HeaderValuesContainsToken(r.Header[\"Cache-Control\"], \"no-transform\") {"," \t\tfor _