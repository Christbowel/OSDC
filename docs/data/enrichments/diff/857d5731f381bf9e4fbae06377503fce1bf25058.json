dr[\"Cache-Control\"], \"no-transform\") &&"," \t\trw.config.Match(rw) {"," \t\trw.w = rw.config.writerPools[rw.encodingName].Get().(Encoder)"," \t\trw.w.Reset(rw.ResponseWriter)","-\t\thdr.Del(\"Content-Length\") // https://github.com/golang/go/issues/14975","-\t\thdr.Set(\"Content-Encoding\", rw.encodingName)","+\t\tdelete(hdr, \"Content-Length\") // https://github.com/golang/go/issues/14975","+\t\thdr[\"Content-Encoding\"] = []string{rw.encodingName}"," \t\tif !hasVaryValue(hdr, \"Accept-Encoding\") {","-\t\t\thdr.Add(\"Vary\", \"Accept-Encoding\")","+\t\t\thdr[\"Vary\"] = append(hdr[\"Vary\"], \"Accept-Encoding\")"," \t\t}","-\t\thdr.Del(\"Accept-Ranges\") // we don't know ranges for dynamically-encoded content","+\t\tdelete(hdr, \"Accept-Ranges\") // we don't know ranges for dynamically-encoded content"," "," \t\t// strong ETags need to be distinct depending on the encoding (\"selected representation\")"," \t\t// see RFC 9110 section 8.8.3.3:","@@ -544,15 +553,24 @@ func (rw *responseWriter) init() {"," \t\t// (We have to strip the value we append from If-None-Match headers before"," \t\t// sending subsequent requests back upstream, however, since upstream handlers"," \t\t// don't know about our appending to their Etag since they've already done their work)","-\t\tif etag := hdr.Get(\"Etag\"); etag != \"\" && !strings.HasPrefix(etag, \"W/\") {","-\t\t\tetag = fmt.Sprintf(`%s-%s\"`, strings.TrimSuffix(etag, `\"`), rw.encodingName)","-\t\t\thdr.Set(\"Etag\", etag)","+\t\tif etag := firstValue(hdr[\"Etag\"]); etag != \"\" && !strings.HasPrefix(etag, \"W/\") {","+\t\t\tetag = strings.TrimSuffix(etag, `\"`) + \"-\" + rw.encodingName + `\"`","+\t\t\thdr[\"Etag\"] = []string{etag}"," \t\t}"," \t}"," }"," ","+// firstValue is http.Header.Get without key normalization, for callers that","+// index the header with a canonical key.","+func firstValue(values []string) string {","+\tif len(values) > 0 {","+\t\treturn values[0]","+\t}","+\treturn \"\"","+}","+"," func hasVar