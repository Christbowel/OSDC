es.push(origin + i*8 + 31 - Math.clz32(word & -word))","+      word &= word - 1","+    }","+  }","+  if (values.length != count) {","+    throw new Error(\"selection bitmap cardinality mismatch\")","+  }","+  return values","+}","+","+function decode(rep: IndicesRep | MultiIndicesRep, deserializer: Deserializer): number[] | Map<number, number[]> {","+  const data = new Uint8Array(deserializer.decode(rep.data) as ArrayBuffer)","+  if (rep.type == \"selection_indices_v1\") {","+    return unpack(rep, data)","+  }","+  const rows: unknown = rep.rows","+  if (!Array.isArray(rows)) {","+    throw new Error(\"invalid selection rows\")","+  }","+  const result = new Map<number, number[]>()","+  let previous = -1","+  let end = 0","+  for (const row of rows) {","+    if (!Array.isArray(row) || row.length != 2 || row[1] == null || typeof row[1] != \"object\") {","+      throw new Error(\"invalid selection row\")","+    }","+    const [key, meta] = row","+    integer(key, \"multiline key\")","+    const offset = integer(meta.offset, \"offset\", data.length)","+    const length = integer(meta.length, \"length\", data.length)","+    if (key <= previous || offset != Math.ceil(end/4)*4 || offset + length > data.length) {","+      throw new Error(\"invalid selection row bounds or order\")","+    }","+    for (let i = end; i < offset; i++) {","+      if (data[i] != 0) {","+        throw new Error(\"invalid selection row padding\")","+      }","+    }","+    result.set(key, unpack(meta, data.subarray(offset, offset + length)))","+    previous = key","+    end = offset + length","+  }","+  if (end != data.length) {","+    throw new Error(\"unreferenced selection data\")","+  }","+  return result","+}","+","+Deserializer.register(\"selection_indices_v1\", decode)","+Deserializer.register(\"selection_map_v1\", decode)","+","+/** Wrap only selection index properties when writing a snapshot or capturing a change event. */","+export function selection_wire_value(attr: string, value: unkno