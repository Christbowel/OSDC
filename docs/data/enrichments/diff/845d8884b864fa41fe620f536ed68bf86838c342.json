n): number[] {","+  if (!isArrayable(values)) {","+    throw new Error(\"selection indices must be an integer sequence\")","+  }","+  const count = values.length","+  const origin = values[0]","+  const last = values[count - 1]","+  if (count > 0 && typeof origin == \"number\" && Number.isInteger(origin) && origin >= 0 && last === origin + count - 1 && last <= MAX_INDEX) {","+    let dense = true","+    for (let i = 1; i < count - 1; i++) {","+      if (values[i] !== origin + i) {","+        dense = false","+        break","+      }","+    }","+    if (dense) {","+      return Array.isArray(values) ? values : Array.from(values) as number[]","+    }","+  }","+  let increasing = true","+  let previous = -1","+  for (let i = 0; i < values.length; i++) {","+    const value = values[i]","+    if (typeof value != \"number\" || !Number.isInteger(value) || value < 0 || value > MAX_INDEX) {","+      throw new Error(\"selection indices must be nonnegative int32 integers\")","+    }","+    if (value <= previous) {","+      increasing = false","+    }","+    previous = value","+  }","+  if (increasing && Array.isArray(values)) {","+    return values","+  }","+  const result = Array.from(values) as number[]","+  if (!increasing) {","+    result.sort((a, b) => a - b)","+    let n = 0","+    for (const value of result) {","+      if (n == 0 || value != result[n - 1]) {","+        result[n++] = value","+      }","+    }","+    result.length = n","+  }","+  return result","+}","+","+function normalize_multiline(indices: OpaqueMultiIndices): Map<number, number[]> {","+  indices = multiline_kind.coerce(indices) as OpaqueMultiIndices","+  if (!(indices instanceof Map)) {","+    throw new Error(\"multiline indices must be a map\")","+  }","+  return new Map([...indices].sort(([a], [b]) => a - b).map(([key, values]) => {","+    integer(key, \"multiline key\")","+    return [key, normalize_indices(values)]","+  }))","+}","+","+// Wire-only wrappers leave public arrays and maps with ordina