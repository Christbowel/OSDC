{"id":"491b003976b01613e4d80fe632ed7c4250d3fd15","axis":"silent","repo":"pnpm/pnpm","sha":"491b003976b01613e4d80fe632ed7c4250d3fd15","parsed":{"files":[{"path":".changeset/workspace-manifest-file-mode.md","lines":["@@ -0,0 +1,15 @@","+---","+\"pacquet\": patch","+---","+","+Files that pnpm creates in a project now get the permissions the umask gives any new file, such as `0644`. Before, several of them were readable only by the user who ran pnpm, which broke Docker images that run as a different user [#17435](https://github.com/orgs/pnpm/discussions/17435).","+","+The fix applies to:","+","+- `pnpm-workspace.yaml`","+- the files written by `pnpm deploy`","+- patch files from `pnpm patch-commit`","+- the lockfile restored by `pnpm dedupe --check`","+- the Cargo and Python files that pnpm writes","+","+When pnpm edits an existing file, the file keeps its permissions."],"additions":15,"deletions":0,"truncated":false},{"path":"clippy.toml","lines":["@@ -1,3 +1,9 @@"," # `print_stderr` and `print_stdout` guard the shipped binary against a closed stderr or stdout."," # Tests may print freely."," allow-print-in-tests = true","+","+# A temp file placed next to its target is usually persisted over it, and these create it 0600.","+disallowed-methods = [","+    { path = \"tempfile::NamedTempFile::new_in\", reason = \"use pnpm_fs::umask_named_tempfile_in or pnpm_fs::private_named_tempfile_in to choose the file's mode\" },","+    { path = \"tempfile::Builder::tempfile_in\", reason = \"use pnpm_fs::umask_named_tempfile_in or pnpm_fs::private_named_tempfile_in to choose the file's mode\" },","+]"],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps.rs","lines":["@@ -290,8 +290,9 @@ fn write_sources_config(root_dir: &Path, index_url: &str, git_sources: &[GitSour","     let directory = ensure_workspace_directory(root_dir, &SOURCES_CONFIG_DIRECTORY)?;","     let path = directory.path.join(SOURCES_CONFIG);","     let config = sources_config(index_url, git_sources);","-    if read_existing_file(&directory, SOURCES_CONFIG)?.0 != config {","-        write_workspace_file(&directory, SOURCES_CONFIG, config.as_bytes(), None)","+    let (existing, mode) = read_existing_file(&directory, SOURCES_CONFIG)?;","+    if existing != config {","+        write_workspace_file(&directory, SOURCES_CONFIG, config.as_bytes(), mode)","             .into_diagnostic()","             .wrap_err_with(|| format!(\"write {}\", path.display()))?;","     }"],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps/sparse_registry.rs","lines":["@@ -207,7 +207,8 @@ pub(super) async fn fetch_sparse_index_file(","             .into_diagnostic()","             .wrap_err_with(|| format!(\"create Cargo sparse-index cache at {}\", parent.display()))?;","     }","-    pnpm_fs::write_atomic(&cache_path, contents.as_bytes())","+    // The cached URLs can carry credentials in their userinfo.","+    pnpm_fs::write_atomic_private_if_new(&cache_path, contents.as_bytes())","         .into_diagnostic()","         .wrap_err_with(|| format!(\"cache sparse index entry for {name}\"))?;","     Ok(contents)","@@ -261,7 +262,8 @@ async fn download_registry_config(","             .into_diagnostic()","             .wrap_err_with(|| format!(\"create Cargo registry cache at {}\", parent.display()))?;","     }","-    pnpm_fs::write_atomic(cache_path, &response.body)","+    // The cached URLs can carry credentials in their userinfo.","+    pnpm_fs::write_atomic_private_if_new(cache_path, &response.body)","         .into_diagnostic()","         .wrap_err_with(|| format!(\"cache Cargo registry config at {}\", cache_path.display()))?;","     Ok(response.body)"],"additions":4,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps/workspace_directory.rs","lines":["@@ -195,7 +195,7 @@ pub(super) fn write_workspace_file(","     use std::os::{fd::AsRawFd as _, unix::ffi::OsStrExt as _, unix::fs::PermissionsExt as _};"," ","     let 