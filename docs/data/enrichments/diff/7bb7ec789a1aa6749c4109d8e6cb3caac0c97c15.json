{"id":"7bb7ec789a1aa6749c4109d8e6cb3caac0c97c15","axis":"silent","repo":"open-telemetry/opentelemetry-go","sha":"7bb7ec789a1aa6749c4109d8e6cb3caac0c97c15","parsed":{"files":[{"path":"internal/tools/semconvkit/main.go","lines":["@@ -208,6 +208,7 @@ type Migration struct {"," \tPrevVer  string"," \tRemovals []string"," \tRenames  []Rename","+\tNotes    string"," }"," "," // Remove is a semantic convention declaration that has been renamed.","@@ -226,11 +227,17 @@ func newMigration(cur, prev string) (*Migration, error) {"," \t\treturn nil, fmt.Errorf(\"error parsing previous version %q: %w\", prev, err)"," \t}"," ","+\tnotes, err := os.ReadFile(filepath.Join(cur, \"MIGRATION_NOTES.md.inc\"))","+\tif err != nil && !errors.Is(err, os.ErrNotExist) {","+\t\treturn nil, fmt.Errorf(\"error reading migration notes: %w\", err)","+\t}","+"," \tm := Migration{"," \t\tCurVer:   filepath.Base(cur),"," \t\tPrevVer:  filepath.Base(prev),"," \t\tRemovals: inAnotB(pDecl, cDecl),"," \t\tRenames:  renames(pDecl, cDecl),","+\t\tNotes:    string(notes),"," \t}"," "," \tsort.Strings(m.Removals)"],"additions":7,"deletions":0,"truncated":false},{"path":"internal/tools/semconvkit/main_test.go","lines":["@@ -56,6 +56,36 @@ func errorType(err error) {}"," \t}"," }"," ","+func TestMigrationPreservesNotes(t *testing.T) {","+\tt.Parallel()","+\troot := t.TempDir()","+\tprev := filepath.Join(root, \"v1.43.0\")","+\tcur := filepath.Join(root, \"v1.44.0\")","+\twriteGoFile(t, prev, \"semconv\", \"package semconv\\n\")","+\twriteGoFile(t, cur, \"semconv\", \"package semconv\\n\")","+\tconst notes = \"## Metric API changes\\n\\nUse deltas with Add.\\n\"","+\tpath := filepath.Join(cur, \"MIGRATION_NOTES.md.inc\")","+\tif err := os.WriteFile(path, []byte(notes), 0o600); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tfor range 2 {","+\t\tm, err := newMigration(cur, prev)","+\t\tif err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t\tif err := render(\"templates/MIGRATION.md.tmpl\", cur, m); err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t\tdata, err := os.ReadFile(filepath.Join(cur, \"MIGRATION.md\"))","+\t\tif err != nil {","+\t\t\tt.Fatal(err)","+\t\t}","+\t\tif strings.Count(string(data), notes) != 1 {","+\t\t\tt.Fatalf(\"migration does not preserve notes exactly once:\\n%s\", data)","+\t\t}","+\t}","+}","+"," // TestNoInvalidObservableHistogramTypes asserts that the semconv code"," // generator never emits types containing \"HistogramObservable\" or"," // \"ObservableObservable\", which would indicate the histogram-exclusion"],"additions":30,"deletions":0,"truncated":false},{"path":"internal/tools/semconvkit/templates/MIGRATION.md.tmpl","lines":["@@ -2,8 +2,11 @@"," {{ if .PrevVer -}} "," # Migration from {{ .PrevVer }} to {{ .CurVer }}"," ","-{{ if or .Removals .Renames }}","+{{ if or .Removals .Renames .Notes -}}"," The `go.opentelemetry.io/otel/semconv/{{ .CurVer }}` package should be a drop-in replacement for `go.opentelemetry.io/otel/semconv/{{ .PrevVer }}` with the following exceptions.","+{{ if .Notes }}","+{{ .Notes -}}","+{{ end -}}"," {{ if .Renames }}"," ## Renames"," "],"additions":4,"deletions":1,"truncated":false},{"path":"semconv/README.md","lines":["@@ -1,3 +1,10 @@"," # Semconv"," "," [![PkgGoDev](https://pkg.go.dev/badge/go.opentelemetry.io/otel/semconv)](https://pkg.go.dev/go.opentelemetry.io/otel/semconv)","+","+## Generation","+","+Run `make semconv-generate TAG=vX.Y.Z` from the repository root to generate a versioned package.","+The generator derives root-package migration information from the previous version.","+For additional migration guidance, such as metric instrument or telemetry name changes, add a `MIGRATION_NOTES.md.inc` fragment in the versioned directory.","+The generator includes that fragment in `MIGRATION.md` on each run."],"additions":7,"deletions":0,"truncated":false},{"path":"semconv/templates/registry/go/instrument.j2","lines":["@@ -6,6 +6,13 @@"," {%- if metric.unit is in divisible -%}"," {%- set ns.value=\"Float64\" -%}","