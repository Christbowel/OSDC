"+{%- endif %}","+{%- set boundaries = metric.metric_name | map_text(\"custom_bucket_boundaries\", \"nil\") %}","+{%- for variant in variants %}","+\t\t{\"{{ pkg }}/{{ variant }}\", constructorTest({{ pkg }}.New{{ variant }}, \"{{ metric.metric_name }}\", {{ i.desc(metric) | tojson }}, \"{{ metric.unit }}\", {{ \"true\" if metric.instrument == \"histogram\" else \"false\" }}, {{ boundaries }})},","+{%- endfor %}","+{%- endfor %}","+{%- endfor %}","+\t}","+\tfor _, test := range tests {","+\t\tt.Run(test.name, test.run)","+\t}","+}","+","+func constructorTest[O, I any](","+\tnewInstrument func(metric.Meter, ...O) (I, error),","+\tname, description, unit string,","+\thistogram bool,","+\tadvice []float64,","+) func(*testing.T) {","+\treturn func(t *testing.T) {","+\t\tt.Parallel()","+\t\tfor _, callerOptions := range []bool{false, true} {","+\t\t\tlabel := \"defaults\"","+\t\t\tif callerOptions {","+\t\t\t\tlabel = \"caller_options\"","+\t\t\t}","+\t\t\tt.Run(label, func(t *testing.T) {","+\t\t\t\tm := &constructorMeter{Meter: noop.NewMeterProvider().Meter(\"test\")}","+\t\t\t\tvar options, storage, before []O","+\t\t\t\twantBoundaries := advice","+\t\t\t\tif callerOptions {","+\t\t\t\t\t// Keep sentinels beyond len(options) to detect writes into spare capacity.","+\t\t\t\t\tstorage = make([]O, 16)","+\t\t\t\t\tfor j := range storage {","+\t\t\t\t\t\tstorage[j] = any(metric.WithUnit(\"sentinel\")).(O)","+\t\t\t\t\t}","+\t\t\t\t\toptions = storage[:2]","+\t\t\t\t\toptions[0] = any(metric.WithDescription(\"caller description\")).(O)","+\t\t\t\t\toptions[1] = any(metric.WithUnit(\"caller unit\")).(O)","+\t\t\t\t\tif histogram {","+\t\t\t\t\t\twantBoundaries = []float64{1, 2, 3}","+\t\t\t\t\t\toptions = append(options, any(metric.WithExplicitBucketBoundaries(wantBoundaries...)).(O))","+\t\t\t\t\t}","+\t\t\t\t\tbefore = slices.Clone(storage)","+\t\t\t\t}","+\t\t\t\tif _, err := newInstrument(m, options...); err != nil {","+\t\t\t\t\tt.Fatal(err)","+\t\t\t\t}","+\t\t\t\tif !reflect.DeepEqual(storage, before) {","+\t\t\t\t\tt.Error(\"constructor changed caller option storage\")","+\t\t\t\t}","+\t\t\t\tif m.config == nil {","+\t\t\t\t\tt.Fatal(\"constructor did not create an instrument\")","+\t\t\t\t}","+\t\t\t\tif m.name != name {","+\t\t\t\t\tt.Errorf(\"name = %q, want %q\", m.name, name)","+\t\t\t\t}","+\t\t\t\tif got := m.config.Description(); got != description {","+\t\t\t\t\tt.Errorf(\"description = %q, want %q\", got, description)","+\t\t\t\t}","+\t\t\t\tif got := m.config.Unit(); got != unit {","+\t\t\t\t\tt.Errorf(\"unit = %q, want %q\", got, unit)","+\t\t\t\t}","+\t\t\t\tif histogram {","+\t\t\t\t\tconfig, ok := m.config.(interface{ ExplicitBucketBoundaries() []float64 })","+\t\t\t\t\tif !ok {","+\t\t\t\t\t\tt.Fatal(\"constructor did not create a histogram\")","+\t\t\t\t\t}","+\t\t\t\t\tif got := config.ExplicitBucketBoundaries(); !slices.Equal(got, wantBoundaries) {","+\t\t\t\t\t\tt.Errorf(\"bucket boundaries = %v, want %v\", got, wantBoundaries)","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}","+","+type constructorMeter struct {","+\tmetric.Meter","+\tname   string","+\tconfig interface {","+\t\tDescription() string","+\t\tUnit() string","+\t}","+}","+{%- for value in [\"Int64\", \"Float64\"] %}","+{%- for kind in [\"Counter\", \"UpDownCounter\", \"Histogram\", \"Gauge\", \"ObservableCounter\", \"ObservableUpDownCounter\", \"ObservableGauge\"] %}","+{%- set inst = value ~ kind %}","+","+func (m *constructorMeter) {{ inst }}(name string, options ...metric.{{ inst }}Option) (metric.{{ inst }}, error) {","+\tm.name = name","+\tm.config = metric.New{{ inst }}Config(options...)","+\treturn m.Meter.{{ inst }}(name, options...)","+}","+{%- endfor %}","+{%- endfor %}{{ \"\\n\" }}"],"additions":131,"deletions":0,"truncated":false},{"path":"semconv/templates/registry/go/weaver.yaml","lines":["@@ -9,6 +9,19 @@ params:","     - \"v8js\"","   excluded_attributes: [\"messaging.client_id\"]"," templates:","+  - pattern: instrument_test.go.j2","+    filter: .","+    application_mode: single","+    file_name: instrument_test.go","+  - pattern: metric_test.go.j2","+    filter: >","+      semconv_metrics({","+        \"exclude_deprecated\": true,","+        \"exclude_root_namespace\": $excluded_namespaces,","+      })","+      | semconv_group_metrics_by_root_namespace","+    application_mode: single","+    file_name: metric_test.go","   - pattern: attribute_group.go.j2","     filter: >","       semconv_grouped_attributes({"],"additions":13,"deletions":0,"truncated":false},{"path":"semconv/v1.44.0/MIGRATION.md","lines":["@@ -1,15 +1,56 @@"," <!-- Generated. DO NOT MODIFY. -->"," # Migration from v1.43.0 to v1.44.0"," ","-The `go.opentelemetry.io/otel/semconv/v1.44.0` package should be a drop-in replacement for `go.opentelemetry.io/otel/semconv/v1.43.0`, with the following exceptions.","+The `go.opentelemetry.io/otel/semconv/v1.44.0` package should be a drop-in replacement for `go.opentelemetry.io/otel/semconv/v1.43.0` with the following exceptions."," "," ## Metric API changes"," ","-Some metric instruments in this release have changed names or types to match the updated semantic conventions. These changes may require updates to applications using the affected APIs.","+The following changes affect metric subpackages as well as their constructor options and embedded instrument types."," ","-- `containerconv.MemoryPagingFaults` and `containerconv.MemoryPagingFaultsObservable` have been renamed to `containerconv.PagingFaults` and `containerconv.PagingFaultsObservable`, respectively.","-- `k8sconv.NodeMemoryPagingFaults` and `k8sconv.NodeMemoryPagingFaultsObservable` have been renamed to `k8sconv.NodePagingFaults` and `k8sconv.NodePagingFaultsObservable`, respectively.","-- `k8sconv.PodMemoryPagingFaults` and `k8sconv.PodMemoryPagingFaultsObservable` have been renamed to `k8sconv.PodPagingFaults` and `k8sconv.PodPagingFaultsObservable`, respectively.","-- `containerconv.MemoryUsage` and `containerconv.MemoryUsageObservable` changed from `Int64Counter` and `Int64ObservableCounter` to `Int64UpDownCounter` and `Int64ObservableUpDownCounter`, respectively. Update code that supplies instrument-specific options or depends on the underlying instrument types.","-- `k8sconv.NodeMemoryUsage`, `k8sconv.NodeMemoryUsageObservable`, `k8sconv.PodMemoryUsage`, and `k8sconv.PodMemoryUsageObservable` changed from gauge instruments to up-down-counter instruments. Update the instrument-specific option types and replace `Record` with `Add` and `RecordSet` with `AddSet` where applicable.","-- `hwconv.Errors.AttrNetworkIODirection` and `hwconv.ErrorsObservable.AttrNetworkIODirection` were removed. Review callers of these helpers and use the appropriate remaining semantic-convention attributes where applicable.","+### Paging fault renames","+","+The synchronous and observable helpers have been renamed:","+","+| Subpackage | Previous helpers | New helpers |","+| --- | --- | --- |","+| `containerconv` | `MemoryPagingFaults`, `MemoryPagingFaultsObservable` | `PagingFaults`, `PagingFaultsObservable` |","+| `k8sconv` | `NodeMemoryPagingFaults`, `NodeMemoryPagingFaultsObservable` | `NodePagingFaults`, `NodePagingFaultsObservable` |","+| `k8sconv` | `PodMemoryPagingFaults`, `PodMemoryPagingFaultsObservable` | `PodPagingFaults`, `PodPagingFaultsObservable` |","+","+Update calls to their `New...` constructors as well. The emitted metric names also change:","+","+| Previous metric name | New metric name |","+| --- | --- |","+| `container.memory.paging.faults` | `container.paging.faults` |","+| `k8s.node.memory.paging.faults` | `k8s.node.paging.faults` |","+| `k8s.pod.memory.paging.faults` | `k8s.pod.paging.faults` |","+","+Update dashboards, queries, recording rules, and alerts that select the previous names.","+","+### Memory instrument changes","+","+- `containerconv.MemoryUsage` and `MemoryUsageObservable` change from `Int64Counter` and `Int64ObservableCounter` to `Int64UpDownCounter` and `Int64ObservableUpDownCounter`. Update instrument-specific options and code that uses the embedded instruments. Synchronous measurements remain deltas; observable measurements remain absolute values, which can now decrease.","+- `k8sconv.NodeMemoryUsage` and `PodMemoryUsage` change from `Int64Gauge` to `Int64UpDownCounter`. Replace `Record` with `Add` and `RecordSet` with `AddSet`, and update instrument-specific options. **Convert absolute readings to deltas for each attribute set.** For readings of 100 and then 120, add 100 and then 20; adding 100 and 120 reports 220. Alternatively, use the observable helpers to report absolute readings without keeping delta state.","+- `k8sconv.NodeMemoryUsageObservable` and `PodMemoryUsageObservable` change from `Int64ObservableGauge` to `Int64ObservableUpDownCounter`. Update instrument-specific options and embedded instrument references. Continue to observe absolute values; do not convert observable measurements to deltas.","+","+### Floating point measurements","+","+The helpers below now use the corresponding `Float64` instruments instead of `Int64` instruments so they can represent fractional values required by the semantic conventions.","+This also applies to their `Observable` variants, where provided.","+Update constructor option types, embedded instrument references, and measurement arguments from `int64` to `float64`.","+For example, `containerconv.CPUUsage.Record` now accepts a value such as `0.25` CPUs, and `azureconv.CosmosDBClientOperationRequestCharge.Record` accepts a charge such as `46.18` request units.","+","+| Subpackage | Helpers |","+| --- | --- |","+| `azureconv` | `CosmosDBClientOperationRequestCharge` |","+| `containerconv` | `CPUUsage` |","+| `hwconv` | `BatteryCharge`, `BatteryChargeLimit`, `Energy`, `FanSpeedRatio`, `GpuMemoryUtilization`, `GpuUtilization`, `HostAmbientTemperature`, `HostHeatingMargin`, `HostPower`, `LogicalDiskUtilization`, `NetworkBandwidthUtilization`, `PhysicalDiskEnduranceUtilization`, `Power`, `PowerSupplyUsage`, `PowerSupplyUtilization`, `Temperature`, `TemperatureLimit`, `Voltage`, `VoltageLimit`, `VoltageNominal` |","+| `k8sconv` | `ContainerCPULimitCurrent`, `ContainerCPULimitDesired`, `ContainerCPULimitUtilization`, `ContainerCPURequestCurrent`, `ContainerCPURequestDesired`, `ContainerCPURequestUtilization`, `NodeCPUAllocatable`, `NodeCPUUsage`, `NodeSystemContainerCPUUsage`, `PodCPUUsage`, `ResourceQuotaCPULimitHard`, `ResourceQuotaCPULimitUsed`, `ResourceQuotaCPURequestHard`, `ResourceQuotaCPURequestUsed` |","+| `openshiftconv` | `ClusterquotaCPULimitHard`, `ClusterquotaCPULimitUsed`, `ClusterquotaCPURequestHard`, `ClusterquotaCPURequestUsed` |","+| `processconv` | `CPUUtilization` |","+| `systemconv` | `CPUUtilization`, `FilesystemUtilization`, `MemoryLinuxHugepagesUtilization`, `PagingUtilization` |","+","+### Removed attribute helpers","+","+`hwconv.Errors.AttrNetworkIODirection` and `hwconv.ErrorsObservable.AttrNetworkIODirection` were removed.","+Review callers and use the remaining semantic-convention attributes appropriate to each instrument."],"additions":49,"deletions":8,"truncated":false},{"path":"semconv/v1.44.0/MIGRATION_NOTES.md.inc","lines":["@@ -0,0 +1,51 @@","+## Metric API changes","+","+The following changes affect metric subpackages as well as their constructor options and embedded instrument types.","+","+### Paging fault renames","+","+The synchronous and observable helpers have been renamed:","+","+| Subpackage | Previous helpers | New helpers |","+| --- | --- | --- |","+| `containerconv` | `MemoryPagingFaults`, `MemoryPagingFaultsObservable` | `PagingFaults`, `PagingFaultsObservable` |","+| `k8sconv` | `NodeMemoryPagingFaults`, `NodeMemoryPagingFaultsObservable` | `NodePagingFaults`, `NodePagingFaultsObservable` |","+| `k8sconv` | `PodMemoryPagingFaults`, `PodMemoryPagingFaultsObservable` | `PodPagingFaults`, `PodPagingFaultsObservable` |","+","+Update calls to their `New...` constructors as well. The emitted metric names also change:","+","+| Previous metric name | New metric name |","+| --- | --- |","+| `container.memory.paging.faults` | `container.paging.faults` |","+| `k8s.node.memory.paging.faults` | `k8s.node.paging.faults` |","+| `k8s.pod.memory.paging.faults` | `k8s.pod.paging.faults` |","+","+Update dashboards, queries, recording rules, and alerts that select the previous names.","+","+### Memory instrument changes","+","+- `containerconv.MemoryUsage` and `MemoryUsageObservable` change from `Int64Counter` and `Int64ObservableCounter` to `Int64UpDownCounter` and `Int64ObservableUpDownCounter`. Update instrument-specific options and code that uses the embedded instruments. Synchronous measurements remain deltas; observable measurements remain absolute values, which can now decrease.","+- `k8sconv.NodeMemoryUsage` and `PodMemoryUsage` change from `Int64Gauge` to `Int64UpDownCounter`. Replace `Record` with `Add` and `RecordSet` with `AddSet`, and update instrument-specific options. **Convert absolute readings to deltas for each attribute set.** For readings of 100 and then 120, add 100 and then 20; adding 100 and 120 reports 220. Alternatively, use the observable helpers to report absolute readings without keeping delta state.","+- `k8sconv.NodeMemoryUsageObservable` and `PodMemoryUsageObservable` change from `Int64ObservableGauge` to `Int64ObservableUpDownCounter`. Update instrument-specific options and embedded instrument references. Continue to observe absolute values; do not convert observable measurements to deltas.","+","+### Floating point measurements","+","+The helpers below now use the corresponding `Float64` instruments instead of `Int64` instruments so they can represent fractional values required by the semantic conventions.","+This also applies to their `Observable` variants, where provided.","+Update constructor option types, embedded instrument references, and measurement arguments from `int64` to `float64`.","+For example, `containerconv.CPUUsage.Record` now accepts a value such as `0.25` CPUs, and `azureconv.CosmosDBClientOperationRequestCharge.Record` accepts a charge such as `46.18` request units.","+","+| Subpackage | Helpers |","+| --- | --- |","+| `azureconv` | `CosmosDBClientOperationRequestCharge` |","+| `containerconv` | `CPUUsage` |","+| `hwconv` | `BatteryCharge`, `BatteryChargeLimit`, `Energy`, `FanSpeedRatio`, `GpuMemoryUtilization`, `GpuUtilization`, `HostAmbientTemperature`, `HostHeatingMargin`, `HostPower`, `LogicalDiskUtilization`, `NetworkBandwidthUtilization`, `PhysicalDiskEnduranceUtilization`, `Power`, `PowerSupplyUsage`, `PowerSupplyUtilization`, `Temperature`, `TemperatureLimit`, `Voltage`, `VoltageLimit`, `VoltageNominal` |","+| `k8sconv` | `ContainerCPULimitCurrent`, `ContainerCPULimitDesired`, `ContainerCPULimitUtilization`, `ContainerCPURequestCurrent`, `ContainerCPURequestDesired`, `ContainerCPURequestUtilization`, `NodeCPUAllocatable`, `NodeCPUUsage`, `NodeSystemContainerCPUUsage`, `PodCPUUsage`, `ResourceQuotaCPULimitHard`, `ResourceQuotaCPULimitUsed`, `ResourceQuotaCPURequestHard`, `ResourceQuotaCPURequestUsed` |","+| `openshiftconv` | `ClusterquotaCPULimitHard`, `ClusterquotaCPULimitUsed`, `ClusterquotaCPURequestHard`, `ClusterquotaCPURequestUsed` |","+| `processconv` | `CPUUtilization` |","+| `systemconv` | `CPUUtilization`, `FilesystemUtilization`, `MemoryLinuxHugepagesUtilization`, `PagingUtilization` |","+","+### Removed attribute helpers","+","+`hwconv.Errors.AttrNetworkIODirection` and `hwconv.ErrorsObservable.AttrNetworkIODirection` were removed.","+Review callers and use the remaining semantic-convention attributes appropriate to each instrument."],"additions":51,"deletions":0,"truncated":false},{"path":"semconv/v1.44.0/azureconv/metric.go","lines":["@@ -73,7 +73,7 @@ func NewCosmosDBClientActiveInstanceCount("," \tif len(opt) == 0 {"," \t\topt = newCosmosDBClientActiveInstanceCountOpts"," \t} else {","-\t\topt = append(opt, newCosmosDBClientActiveInstanceCountOpts...)"