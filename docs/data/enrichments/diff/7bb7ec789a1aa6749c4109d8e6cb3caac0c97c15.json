at64Histogram\"},","+  {\"name\": \"empty_annotations\", \"metric\": {\"metric_name\": \"test.empty\", \"instrument\": \"updowncounter\", \"unit\": \"s\", \"annotations\": {}}, \"want\": \"Float64UpDownCounter\"},","+  {\"name\": \"empty_code_generation\", \"metric\": {\"metric_name\": \"test.empty_codegen\", \"instrument\": \"gauge\", \"unit\": \"1\", \"annotations\": {\"code_generation\": {}}}, \"want\": \"Int64Gauge\"},","+  {\"name\": \"float_override\", \"metric\": {\"metric_name\": \"system.cpu.time\", \"instrument\": \"gauge\", \"unit\": \"By\", \"annotations\": {\"code_generation\": {\"metric_value_type\": \"int\"}}}, \"want\": \"Float64ObservableCounter\"},","+  {\"name\": \"int_override\", \"metric\": {\"metric_name\": \"go.memory.used\", \"instrument\": \"gauge\", \"unit\": \"s\", \"annotations\": {\"code_generation\": {\"metric_value_type\": \"double\"}}}, \"want\": \"Int64ObservableUpDownCounter\"},","+] %}","+\t\t{\"{{ test.name }}\", \"{{ i.instrument(test.metric) }}\", \"{{ test.want }}\"},","+{%- endfor %}","+\t}","+\tfor _, test := range tests {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\tif test.got != test.want {","+\t\t\t\tt.Errorf(\"instrument = %q, want %q\", test.got, test.want)","+\t\t\t}","+\t\t})","+\t}","+}{{ \"\\n\" }}"],"additions":38,"deletions":0,"truncated":false},{"path":"semconv/templates/registry/go/metric.go.j2","lines":["@@ -70,11 +70,11 @@ type {{ v.name }} struct {"," }"," "," var new{{ v.name }}Opts = []metric.{{ v.inst }}Option{","-\tmetric.WithDescription(\"{{ i.desc(metric) }}\"),","-\tmetric.WithUnit(\"{{metric.unit}}\"),"," {%- if metric.instrument == \"histogram\" and metric_bucket_boundaries != \"\" %}"," \tmetric.WithExplicitBucketBoundaries({{ metric_bucket_boundaries }}...),"," {%- endif %}","+\tmetric.WithDescription(\"{{ i.desc(metric) }}\"),","+\tmetric.WithUnit(\"{{metric.unit}}\"),"," }"," "," {{ [\"New\" ~ v.name ~ \" returns a new \" ~ v.name ~ \" instrument.\"] | comment }}","