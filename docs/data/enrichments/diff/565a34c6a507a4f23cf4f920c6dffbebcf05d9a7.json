"+            query = query.Where(x => !x.IsExecuting && x.SubStatus != WorkflowSubStatus.Executing);","+","+        var updated = await query.ExecuteUpdateAsync(","+            setters => setters","+                .SetProperty(x => x.SubStatus, next)","+                .SetProperty(x => x.UpdatedAt, stampedAt),","+            cancellationToken);","+","+        return updated > 0;","+    }","+","     /// <inheritdoc />","     [RequiresUnreferencedCode(\"Calls Elsa.Workflows.Contracts.IWorkflowStateSerializer.SerializeAsync(WorkflowState, CancellationToken)\")]","     public async ValueTask SaveAsync(WorkflowInstance instance, CancellationToken cancellationToken = default)"],"additions":34,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Contexts/WorkflowExecutionContext.cs","lines":["@@ -705,6 +705,7 @@ private WorkflowStatus GetMainStatus(WorkflowSubStatus subStatus) =>","             WorkflowSubStatus.Faulted => WorkflowStatus.Finished,","             WorkflowSubStatus.Finished => WorkflowStatus.Finished,","             WorkflowSubStatus.Suspended => WorkflowStatus.Running,","+            WorkflowSubStatus.Cancelling => WorkflowStatus.Running,","             _ => throw new ArgumentOutOfRangeException(nameof(subStatus), subStatus, null)","         };"," "],"additions":1,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Enums/WorkflowSubStatus.cs","lines":["@@ -43,4 +43,11 @@ public enum WorkflowSubStatus","     /// sub-status with a stale liveness timestamp.","     /// </summary>","     Interrupted,","+","+    /// <summary>","+    /// A cancellation request has been accepted and the instance is waiting for the cancellation pipeline to finish.","+    /// The main status stays <see cref=\"WorkflowStatus.Running\"/> until the pipeline commits <see cref=\"Cancelled\"/>","+    /// or the mark is restored to the previous sub-status.","+    /// </summary>","+    Cancelling,"," }","\\ No newline at end of file"],"additions":7,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Core/Extensions/WorkflowSubStatusExtensions.cs","lines":["@@ -0,0 +1,40 @@","+namespace Elsa.Workflows;","+","+/// <summary>","+/// Shared checks for the cancellation interim sub-status.","+/// </summary>","+public static class WorkflowSubStatusExtensions","+{","+    /// <summary>","+    /// The sub-status Phase A will leave for <see cref=\"WorkflowSubStatus.Cancelling\"/>.","+    /// Pending stays on the pending run path and Interrupted stays on the interrupted-workflow scan,","+    /// so a lost dispatch cannot take either of them out of recovery.","+    /// </summary>","+    public static bool IsCancellableSubStatus(this WorkflowSubStatus subStatus) =>","+        subStatus == WorkflowSubStatus.Suspended;","+","+    /// <summary>","+    /// A transition into <see cref=\"WorkflowSubStatus.Cancelling\"/> starts from <see cref=\"IsCancellableSubStatus\"/>.","+    /// A transition out of <see cref=\"WorkflowSubStatus.Cancelling\"/> returns to that same sub-status.","+    /// Any other pair is not a cancellation transition.","+    /// </summary>","+    public static bool IsPermittedSubStatusTransition(this WorkflowSubStatus expected, WorkflowSubStatus next)","+    {","+        if (next == WorkflowSubStatus.Cancelling)","+            return expected.IsCancellableSubStatus();","+","+        if (expected == WorkflowSubStatus.Cancelling)","+            return next.IsCancellableSubStatus();","+","+        return true;","+    }","+","+    /// <summary>","+    /// Drops sub-millisecond ticks so stamps survive providers that round timestamps to microseconds.","+    /// </summary>","+    public static DateTimeOffset TruncateToMilliseconds(this DateTimeOffset value)","+    {","+        var ticks = value.Ticks - (value.Ticks % TimeSpan.TicksPerMillisecond);","+        return new DateTimeOffset(ticks, value.Offset);","+    }","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Management/Contracts/IWorkflowInstanceStore.cs","lines":["@@ -199,4 +199,33 @@ public interface IWorkflowInstanceStore","     /// Implementations must not overwrite a concurrent naturally completed commit.","     /// </returns>","     ValueTask<bool> TryMarkInterruptedAsync(string workflowInstanceId, CancellationToken cancellationToken = default, bool allowFinishedCancelled = false);","+","+    /// <summary>","+    /// Sets <see cref=\"WorkflowInstance.SubStatus\"/> to <paramref name=\"next\"/> and","+    /// <see cref=\"WorkflowInstance.UpdatedAt\"/> to <paramref name=\"stampedAt\"/> when the stored instance is still","+    /// <see cref=\"WorkflowStatus.Running\"/> and still <paramref name=\"expected\"/>.","+    /// </summary>","+    /// <remarks>","+    /// When <paramref name=\"expectedUpdatedAt\"/> has a value, <see cref=\"WorkflowInstance.UpdatedAt\"/> must equal it.","+    /// A transition to <see cref=\"WorkflowSubStatus.Cancelling\"/> also requires the row not to be executing and","+    /// <paramref name=\"expected\"/> to be <see cref=\"WorkflowSubStatus.Suspended\"/>.","+    /// A transition out of <see cref=\"WorkflowSubStatus.Cancelling\"/> may only return to <see cref=\"WorkflowSubStatus.Suspended\"/>.","+    /// Only those two columns are written. <see cref=\"WorkflowInstance.WorkflowState\"/>, bookmarks and execution progress stay as they are.","+    /// The default returns <c>false</c> so a provider that cannot do this conditional write fails closed.","+    /// Callers must not fall back to <see cref=\"SaveAsync\"/>, <see cref=\"SaveManyAsync\"/> or <see cref=\"UpdateAsync\"/>.","+    /// </remarks>","+    /// <param name=\"workflowInstanceId\">The workflow instance to update.</param>","+    /// <param name=\"expected\">The sub-status the row must still have.</param>","+    /// <param name=\"expectedUpdatedAt\">The <see cref=\"WorkflowInstance.UpdatedAt\"/> the row must still have, or <c>null</c> to skip that compare.</param>","+    /// <param name=\"next\">The sub-status to write.</param>","+    /// <param name=\"stampedAt\">The stamp written to <see cref=\"WorkflowInstance.UpdatedAt\"/>.</param>","+    /// <param name=\"cancellationToken\">The cancellation token.</param>","+    /// <returns><c>true</c> when the row was updated; otherwise <c>false</c> and the row is unchanged.</returns>","+    ValueTask<bool> TryTransitionSubStatusAsync(","+        string workflowInstanceId,","+        WorkflowSubStatus expected,","+        DateTimeOffset? expectedUpdatedAt,","+        WorkflowSubStatus next,","+        DateTimeOffset stampedAt,","+        CancellationToken cancellationToken = default) => ValueTask.FromResult(false);"," }","\\ No newline at end of file"],"additions":29,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Management/Stores/MemoryWorkflowInstanceStore.cs","lines":["@@ -212,6 +212,35 @@ public ValueTask<bool> TryMarkInterruptedAsync(string workflowInstanceId, Cancel","         }","     }"," ","+    /// <inheritdoc />","+    public ValueTask<bool> TryTransitionSubStatusAsync(","+        string workflowInstanceId,","+        WorkflowSubStatus expected,","+        DateTimeOffset? expectedUpdatedAt,","+        WorkflowSubStatus next,","+        DateTimeOffset stampedAt,","+        CancellationToken cancellationToken = default)","+    {","+        if (!expected.IsPermittedSubStatusTransition(next))","+            return ValueTask.FromResult(false);","+","+        // Same lock as Save/Update so a runner's commit cannot land between the predicate and the column writes.","+        lock (_sync)","+        {","+            var instance = _store.Find(x => x.Id == workflowInstanceId && TenantVisibility.IsVisible(x.TenantId, CurrentTenantId));","+            if (instance is null","+                || instance.Status != WorkflowStatus.Running","+                || instance.SubStatus != expected","+                || (expectedUpdatedAt is { } expectedStamp && instance.UpdatedAt != expectedStamp)","+                || (next == WorkflowSubStatus.Cancelling && (instance.IsExecuting || instance.SubStatus == WorkflowSubStatus.Executing)))","+                return ValueTask.FromResult(false);","+","+            instance.SubStatus = next;","+            instance.UpdatedAt = stampedAt;","+            return ValueTask.FromResult(true);","+        }","+    }","+","     private static string GetId(WorkflowInstance workflowInstance) => workflowInstance.Id;"," ","     private static WorkflowInstance Clone(WorkflowInstance instance) =>"],"additions":29,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Handlers/CancelWorkflowsCommandHandler.cs","lines":["@@ -1,7 +1,10 @@","+using Elsa.Common;"," using Elsa.Mediator.Contracts;"," using Elsa.Mediator.Models;","+using Elsa.Workflows.Management;"," using Elsa.Workflows.Runtime.Commands;"," using JetBrains.Annotations;","+using Microsoft.Extensions.Logging;"," "," namespace Elsa.Workflows.Runtime.Handlers;"," ","@@ -9,15 +12,62 @@ namespace Elsa.Workflows.Runtime.Handlers;"," /// Handles the <see cref=\"CancelWorkflowsCommand\"/>."," /// </summary>"," [UsedImplicitly]","-public class CancelWorkflowsCommandHandler(IWorkflowRuntime workflowRuntime) : ICommandHandler<CancelWorkflowsCommand>","+public class CancelWorkflowsCommandHandler(","+    IWorkflowRuntime workflowRuntime,","+    IWorkflowInstanceStore workflowInstanceStore,","+    ISystemClock systemClock,","+    ILogger<CancelWorkflowsCommandHandler> logger) : ICommandHandler<CancelWorkflowsCommand>"," {","     /// <inheritdoc />","     public async Task<Unit> HandleAsync(CancelWorkflowsCommand command, CancellationToken cancellationToken)","     {","-        var workflowInstanceId = command.Request.WorkflowInstanceId;","-        var workflowClient = await workflowRuntime.CreateClientAsync(workflowInstanceId, cancellationToken);","-        await workflowClient.CancelAsync(cancellationToken);","-        ","-        return Unit.Instance;","+        try","+        {","+            var workflowInstanceId = command.Request.WorkflowInstanceId;","+            var workflowClient = await workflowRuntime.CreateClientAsync(workflowInstanceId, cancellationToken);","+            await workflowClient.CancelAsync(cancellationToken);","+            return Unit.Instance;","+        }","+        catch (Exception exception)","+        {","+            // BackgroundCommandProcessor logs this exception and does not retry the command.","+            // That makes the failure terminal for the in-process dispatcher. Restore first, then rethrow","+            // so the processor still records it. The compare-and-swap leaves a committed Cancelled row alone.","+            await RestoreIfMarkedAsync(command, exception);","+            throw;","+        }","     }","-}","\\ No newline at end of file","+","+    private async Task RestoreIfMarkedAsync(CancelWorkflowsCommand command, Exception failure)","+    {","+        var request = command.Request;","+        if (request.PreviousSubStatus is not { } previousSubStatus || request.CancellingAt is not { } cancellingAt)","+            return;","+","+        try","+        {","+            var restored = await workflowInstanceStore.TryTransitionSubStatusAsync(","+                request.WorkflowInstanceId,","+                WorkflowSubStatus.Cancelling,","+                cancellingAt,","+                previousSubStatus,","+                systemClock.UtcNow.TruncateToMilliseconds(),","+                CancellationToken.None);","+","+            if (!restored)","+            {","+                logger.LogDebug(","+                    failure,","+                    \"Background cancellation of workflow instance {WorkflowInstanceId} failed, and the Cancelling mark was no longer current.\",","+                    request.WorkflowInstanceId);","+            }","+        }","+        catch (Exception restoreFailure)","+        {","+            logger.LogError(","+                restoreFailure,","+                \"Failed to restore workflow instance {WorkflowInstanceId} after background cancellation failed.\",","+                request.WorkflowInstanceId);","+        }","+    }","+}"],"additions":57,"deletions":7,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Requests/DispatchCancelWorkflowRequest.cs","lines":["@@ -1,3 +1,5 @@","+using Elsa.Workflows;","+"," namespace Elsa.Workflows.Runtime.Requests;"," "," /// <summary>","@@ -9,4 +11,16 @@ public class DispatchCancelWorkflowRequest","     /// The ID of the workflow instance to cancel.","     /// </summary>","     public string WorkflowInstanceId { get; set; } = default!;","+","+    /// <summary>","+    /// The sub-status to restore if this cancellation fails after <see cref=\"WorkflowSubStatus.Cancelling\"/> was persisted.","+    /// Null when no interim mark was written.","+    /// </summary>","+    public WorkflowSubStatus? PreviousSubStatus { get; set; }","+","+    /// <summary>","+    /// The <c>UpdatedAt</c> value written with the Cancelling mark.","+    /// Restore matches this stamp so a newer commit is left alone.","+    /// </summary>","+    public DateTimeOffset? CancellingAt { get; set; }"," }","\\ No newline at end of file"],"additions":14,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Services/WorkflowCancellationService.cs","lines":["@@ -1,8 +1,11 @@","+using Elsa.Common;"," using Elsa.Common.Models;","+using Elsa.Workflows;"," using Elsa.Workflows.Management;"," using Elsa.Workflows.Management.Entities;"," using Elsa.Workflows.Management.Filters;"," using Elsa.Workflows.Runtime.Requests;","+using Microsoft.Extensions.Logging;"," "," namespace Elsa.Workflows.Runtime;"," ","@@ -10,7 +13,10 @@ namespace Elsa.Workflows.Runtime;"," public class WorkflowCancellationService(","     IWorkflowDefinitionService workflowDefinitionService,","     IWorkflowInstanceStore workflowInstanceStore,","-    IWorkflowCancellationDispatcher dispatcher)","+    IWorkflowCancellationDispatcher dispatcher,","+    ISystemClock systemClock,","+    ILogger<WorkflowCancellationService> logger,","+    IWorkflowExecutionGuard? workflowExecutionGuard = null)","     : IWorkflowCancellationService"," {","     /// <inheritdoc />","@@ -67,11 +73,15 @@ public async Task<int> CancelWorkflowByDefinitionAsync(string definitionId, Vers"," ","     private async Task<int> CancelWorkflows(IList<WorkflowInstance> workflowInstances, CancellationToken cancellationToken)","     {","-        var tasks = workflowInstances.Where(i => i.Status != WorkflowStatus.Finished)","-            .Select(i => dispatcher.DispatchAsync(new DispatchCancelWorkflowRequest","-            {","-                WorkflowInstanceId = i.Id","-            }, cancellationToken)).ToList();","+        var tasks = new List<Task>();","+","+        foreach (var instance in workflowInstances)","+        {","+            if (instance.Status == WorkflowStatus.Finished)","+                continue;","+","+            tasks.Add(CancelInstanceAsync(instance, cancellationToken));","+        }"," ","         var instanceIds = workflowInstances.Select(i => i.Id).ToList();","         await CancelChildWorkflowInstances(instanceIds, cancellationToken);","@@ -80,6 +90,169 @@ private async Task<int> CancelWorkflows(IList<WorkflowInstance> workflowInstance","         return tasks.Count;","     }"," ","+    /// <summary>","+    /// Marks a non-executing, unowned suspended instance as Cancelling, then dispatches.","+    /// Pending and Interrupted stay unmarked so the pending run path and the interrupted-workflow scan still own them.","+    /// A crash after this mark and before enqueue can leave a suspended instance in Cancelling.","+    /// The mark is best effort: a store failure still dispatches, without the interim sub-status.","+    /// </summary>","+    private async Task CancelInstanceAsync(WorkflowInstance instance, CancellationToken cancellationToken)","+    {","+        if (!await CanPersistCancellingAsync(instance, cancellationToken))","+        {","+            await DispatchCancellationAsync(instance, cancellationToken);","+            return;","+        }","+","+        var previousSubStatus = instance.SubStatus;","+        var cancellingAt = systemClock.UtcNow.TruncateToMilliseconds();","+        bool marked;","+        try","+        {","+            marked = await workflowInstanceStore.TryTransitionSubStatusAsync(","+                instance.Id,","+                previousSubStatus,","+                null,","+                WorkflowSubStatus.Cancelling,","+                cancellingAt,","+                cancellationToken);","+        }","+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)","+        {","+            throw;","+        }","+        catch (Exception exception)","+        {","+            // A timeout, pool exhaustion, or version conflict must not drop the cancel. Dispatch unmarked.","+            logger.LogWarning(","+                exception,","+                \"Workflow instance {WorkflowInstanceId} could not be marked {CancellingSubStatus}. Dispatching cancellation without an interim sub-status.\",","+                instance.Id,","+                WorkflowSubStatus.Cancelling);","+            await DispatchCancellationAsync(instance, cancellationToken);","+            return;","+        }","+","+        if (!marked)","+        {","+            // The conditional update declined or lost a race. Never replace that with a full-instance save.","+            logger.LogDebug(","+                \"Workflow instance {WorkflowInstanceId} was not marked {CancellingSubStatus}. Dispatching cancellation without an interim sub-status.\",","+                instance.Id,","+                WorkflowSubStatus.Cancelling);","+            await DispatchCancellationAsync(instance, cancellationToken);","+            return;","+        }","+","+        try","+        {","+            await DispatchMarkedCancellationAsync(instance, previousSubStatus, cancellingAt, cancellationToken);","+        }","+        catch (Exception exception)","+        {","+            await RestoreAfterDispatchFailureAsync(instance.Id, previousSubStatus, cancellingAt, exception);","+            throw;","+        }","+    }","+","+    /// <summary>","+    /// Executing instances keep their sub-status. Admission ownership is the guard's <c>DemandUnownedAsync</c>;","+    /// when that guard is not registered there is no durable owner to check. An unclear answer fails closed and skips the mark.","+    /// </summary>","+    private async ValueTask<bool> CanPersistCancellingAsync(WorkflowInstance instance, CancellationToken cancellationToken)","+    {","+        if (instance.Status != WorkflowStatus.Running","+            || instance.IsExecuting","+            || !instance.SubStatus.IsCancellableSubStatus())","+        {","+            logger.LogDebug(","+                \"Workflow instance {WorkflowInstanceId} is executing or not a running cancellable sub-status. Leaving {SubStatus} unchanged.\",","+                instance.Id,","+                instance.SubStatus);","+            return false;","+        }","+","+        if (workflowExecutionGuard is null)","+            return true;","+","+        try","+        {","+            await workflowExecutionGuard.DemandUnownedAsync(instance.Id, cancellationToken);","+            return true;","+        }","+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)","+        {","+            throw;","+        }","+        catch (Exception exception)","+        {","+            logger.LogDebug(","+                exception,","+                \"Workflow instance {WorkflowInstanceId} is owned, or ownership could not be established. Leaving {SubStatus} unchanged.\",","+                instance.Id,","+                instance.SubStatus);","+            return false;","+        }","+    }","+","+    private async Task<bool> DispatchCancellationAsync(WorkflowInstance instance, CancellationToken cancellationToken)","+    {","+        await dispatcher.DispatchAsync(new DispatchCancelWorkflowRequest","+        {","+            WorkflowInstanceId = instance.Id","+        }, cancellationToken);","+","+        return true;","+    }","+","+    private async Task DispatchMarkedCancellationAsync(","+        WorkflowInstance instance,","+        WorkflowSubStatus previousSubStatus,","+        DateTimeOffset cancellingAt,","+        CancellationToken cancellationToken)","+    {","+        await dispatcher.DispatchAsync(new DispatchCancelWorkflowRequest","+        {","+            WorkflowInstanceId = instance.Id,","+            PreviousSubStatus = previousSubStatus,","+            CancellingAt = cancellingAt","+        }, cancellationToken);","+    }","+","+    private async Task RestoreAfterDispatchFailureAsync(","+        string workflowInstanceId,","+        WorkflowSubStatus previousSubStatus,","+        DateTimeOffset cancellingAt,","+        Exception dispatchFailure)","+    {","+        try","+        {","+            // The caller's token may already be cancelled. The rollback still has to run.","+            var restored = await workflowInstanceStore.TryTransitionSubStatusAsync(","+                workflowInstanceId,","+                WorkflowSubStatus.Cancelling,","+                cancellingAt,","+                previousSubStatus,","+                systemClock.UtcNow.TruncateToMilliseconds(),","+                CancellationToken.None);","+","+            if (!restored)","+            {","+                logger.LogDebug(","+                    dispatchFailure,","+                    \"Cancellation dispatch failed for workflow instance {WorkflowInstanceId}, and the Cancelling mark was no longer current.\",","+                    workflowInstanceId);","+            }","+        }","+        catch (Exception restoreFailure)","+        {","+            logger.LogError(","+                restoreFailure,","+                \"Failed to restore workflow instance {WorkflowInstanceId} after cancellation dispatch failed.\",","+                workflowInstanceId);","+        }","+    }","+","     private async Task CancelChildWorkflowInstances(IEnumerable<string> workflowInstanceIds, CancellationToken cancellationToken)","     {","         var tasks = new List<Task<int>>();","@@ -101,4 +274,4 @@ private async Task CancelChildWorkflowInstances(IEnumerable<string> workflowInst"," ","         await Task.WhenAll(tasks);","     }","-}","\\ No newline at end of file","+}"],"additions":180,"deletions":7,"truncated":false},{"path":"core/test/integration/Elsa.Workflows.IntegrationTests/Scenarios/BulkDispatchWorkflowsCancellation/FailingOncePagedReadWorkflowInstanceStore.cs","lines":["@@ -1,4 +1,5 @@"," using Elsa.Common.Models;","+using Elsa.Workflows;"," using Elsa.Workflows.Management;"," using Elsa.Workflows.Management.Entities;"," using Elsa.Workflows.Management.Filters;","@@ -101,4 +102,13 @@ public Task UpdateUpdatedTimestampAsync(string workflowInstanceId, DateTimeOffse"," ","     public ValueTask<bool> TryMarkInterruptedAsync(string workflowInstanceId, CancellationToken cancellationToken = default, bool allowFinishedCancelled = false) =>","         inner.TryMarkInterruptedAsync(workflowInstanceId, cancellationToken, allowFinishedCancelled);","+","+    public ValueTask<bool> TryTransitionSubStatusAsync(","+        string workflowInstanceId,","+        WorkflowSubStatus expected,","+        DateTimeOffset? expectedUpdatedAt,","+        WorkflowSubStatus next,","+        DateTimeOffset stampedAt,","+        CancellationToken cancellationToken = default) =>","+        inner.TryTransitionSubStatusAsync(workflowInstanceId, expected, expectedUpdatedAt, next, stampedAt, cancellationToken);"," }"],"additions":10,"deletions":0,"truncated":false},{"path":"core/test/integration/Elsa.Workflows.Persistence.ConformanceTests/EFCoreWorkflowInstanceSubStatusTransitionTests.cs","lines":["@@ -0,0 +1,189 @@","+using Elsa.Workflows;","+using Elsa.Workflows.Management.Entities;","+using Elsa.Workflows.Management.Filters;","+using Elsa.Workflows.State;","+","+namespace Elsa.Workflows.Persistence.ConformanceTests;","+","+/// <summary>","+/// SQLite coverage for <see cref=\"Elsa.Persistence.EFCore.Modules.Management.EFCoreWorkflowInstanceStore.TryTransitionSubStatusAsync\"/>.","+/// The compare-and-swap is a filtered <c>ExecuteUpdate</c>, including the <c>UpdatedAt</c> equality that a timestamp converter can break.","+/// </summary>","+[Collection(WorkflowStoreSqliteConformanceCollection.Name)]","+public sealed class EFCoreWorkflowInstanceSubStatusTransitionTests","+{","+    private static readonly DateTimeOffset OriginalUpdatedAt = new(2026, 10, 1, 0, 0, 0, TimeSpan.Zero);","+    private static readonly DateTimeOffset CancellingAt = new(2026, 10, 26, 12, 0, 0, 123, TimeSpan.Zero);","+    private static readonly DateTimeOffset RestoredAt = new(2026, 10, 26, 12, 5, 0, 456, TimeSpan.Zero);","+","+    [Fact]","+    public async Task TryTransitionSubStatusAsync_MarksSuspendedAndWritesOnlySubStatusAndUpdatedAt()","+    {","+        await using var scenario = await WorkflowStoreScenario.CreateSqliteAsync();","+        await scenario.Instances.SaveAsync(Suspended(\"wf-1\"));","+","+        var marked = await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Suspended,","+            null,","+            WorkflowSubStatus.Cancelling,","+            CancellingAt);","+","+        Assert.True(marked);","+        var stored = await FindAsync(scenario, \"wf-1\");","+        Assert.Equal(WorkflowStatus.Running, stored.Status);","+        Assert.Equal(WorkflowSubStatus.Cancelling, stored.SubStatus);","+        Assert.Equal(CancellingAt, stored.UpdatedAt);","+        Assert.False(stored.IsExecuting);","+        Assert.Equal(\"def-1\", stored.DefinitionId);","+    }","+","+    [Fact]","+    public async Task TryTransitionSubStatusAsync_SecondMarkLeavesTheFirstStamp()","+    {","+        await using var scenario = await WorkflowStoreScenario.CreateSqliteAsync();","+        await scenario.Instances.SaveAsync(Suspended(\"wf-1\"));","+        Assert.True(await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Suspended,","+            null,","+            WorkflowSubStatus.Cancelling,","+            CancellingAt));","+","+        var markedAgain = await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Suspended,","+            null,","+            WorkflowSubStatus.Cancelling,","+            RestoredAt);","+","+        Assert.False(markedAgain);","+        var stored = await FindAsync(scenario, \"wf-1\");","+        Assert.Equal(WorkflowSubStatus.Cancelling, stored.SubStatus);","+        Assert.Equal(CancellingAt, stored.UpdatedAt);","+    }","+","+    [Fact]","+    public async Task TryTransitionSubStatusAsync_WrongStampDoesNotRestore()","+    {","+        await using var scenario = await WorkflowStoreScenario.CreateSqliteAsync();","+        await scenario.Instances.SaveAsync(Suspended(\"wf-1\"));","+        Assert.True(await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Suspended,","+            null,","+            WorkflowSubStatus.Cancelling,","+            CancellingAt));","+","+        var restored = await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Cancelling,","+            CancellingAt.AddMilliseconds(1),","+            WorkflowSubStatus.Suspended,","+            RestoredAt);","+","+        Assert.False(restored);","+        var stored = await FindAsync(scenario, \"wf-1\");","+        Assert.Equal(WorkflowStatus.Running, stored.Status);","+        Assert.Equal(WorkflowSubStatus.Cancelling, stored.SubStatus);","+        Assert.Equal(CancellingAt, stored.UpdatedAt);","+    }","+","+    [Fact]","+    public async Task TryTransitionSubStatusAsync_RightStampRestoresPreviousSubStatus()","+    {","+        await using var scenario = await WorkflowStoreScenario.CreateSqliteAsync();","+        await scenario.Instances.SaveAsync(Suspended(\"wf-1\"));","+        Assert.True(await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Suspended,","+            null,","+            WorkflowSubStatus.Cancelling,","+            CancellingAt));","+","+        var restored = await scenario.Instances.TryTransitionSubStatusAsync(","+            \"wf-1\",","+            WorkflowSubStatus.Cancelling,","+            CancellingAt,","+            WorkflowSubStatus.Suspended,","+            RestoredAt);","+","+        Assert.True(restored);","+        var stored = await FindAsync(scenario, \"wf-1\");","+        Assert.Equal(WorkflowStatus.Running, stored.Status);","+        Assert.Equal(WorkflowSubStatus.Suspended, stored.SubStatus);","+        Assert.Equal(RestoredAt, stored.UpdatedAt);"],"additions":115,"deletions":0,"truncated":false}],"additions":521,"deletions":14,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-10-30T15:57:04.844140+00:00"}