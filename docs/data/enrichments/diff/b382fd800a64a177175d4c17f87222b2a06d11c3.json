cated":false},{"path":"tests/features/schema-introspection/unusual-identifiers.pglite.test.ts","lines":["@@ -0,0 +1,34 @@","+import { MikroORM } from '@mikro-orm/pglite';","+import { EntityGenerator } from '@mikro-orm/entity-generator';","+","+let orm: MikroORM;","+","+beforeAll(async () => {","+  orm = await MikroORM.init({","+    dbName: 'memory://',","+    discovery: { warnWhenNoEntities: false },","+    extensions: [EntityGenerator],","+  });","+  await orm.schema.execute('create table \"quo\"\"te\" (\"id\" serial primary key, \"name\" text)');","+  await orm.schema.execute(`comment on table \"quo\"\"te\" is 'quoted table'`);","+  await orm.schema.execute(","+    `create function \"multiline_params\"(\"first\\nline\" int, \"sep arated\" text default E'a\\\\nb') returns int language sql as 'select 1'`,","+  );","+});","+","+afterAll(() => orm.close(true));","+","+test('listing tables handles double quotes in table names', async () => {","+  const tables = await orm.em.getConnection().execute(orm.em.getPlatform().getSchemaHelper()!.getListTablesSQL());","+  expect(tables).toEqual([expect.objectContaining({ table_name: 'quo\"te', table_comment: 'quoted table' })]);","+});","+","+test('schema introspection and entity generation handle line breaks in routine parameters', async () => {","+  const sql = await orm.schema.getUpdateSchemaSQL({ wrap: false });","+  expect(sql).toContain('drop table if exists \"quo\"\"te\"');","+","+  const dump = await orm.entityGenerator.generate();","+  const source = dump.join('\\n');","+  expect(source).toContain(`tableName: 'quo\"te'`);","+  expect(source).toContain('first\\\\nline');","+});"],"additions":34,"deletions":0,"truncated":false},{"path":"tests/features/schema-introspection/unusual-identifiers.sqlite.test.ts","lines":["@@ -0,0 +1,53 @@","+import { MikroORM, UnderscoreNamingStrategy } from '@mikro-orm/sqlite';","+import { EntityGenerator } from '@mikro-orm/entity-generator';","+","+let orm: MikroORM;","+","+beforeAll(async () => {","+  orm = await MikroORM.init({","+    dbName: ':memory:',","+    discovery: { warnWhenNoEntities: false },","+    extensions: [EntityGenerator],","+  });","+  await orm.schema.execute('create table \"it\\'s\" (\"id\" integer primary key, \"name\" text)');","+  await orm.schema.execute('create index \"it\\'s index\" on \"it\\'s\" (\"name\")');","+  await orm.schema.execute('create table \"back`tick\" (\"id\" integer primary key, \"name\" text)');","+  await orm.schema.execute('create index \"back`tick index\" on \"back`tick\" (\"name\")');","+  await orm.schema.execute(","+    'create table \"parent\" (\"a(b\" integer primary key, \"c[d\" text, \"e+f\" text not null default \\'x\\')',","+  );","+  await orm.schema.execute(","+    'create table \"child\" (\"id\" integer primary key, \"owner_a(b\" integer, constraint \"child_owner_fk\" foreign key (\"owner_a(b\") references \"parent\" (\"a(b\"))',","+  );","+  await orm.schema.execute('create table \"tag\" (\"id\" integer primary key)');","+  await orm.schema.execute('create table \"po(st\" (\"id\" integer primary key)');","+  await orm.schema.execute(","+    'create table \"po(st_tags\" (\"post_id\" integer not null, \"tag_id\" integer not null, primary key (\"post_id\", \"tag_id\"), ' +","+      'constraint \"fk1\" foreign key (\"post_id\") references \"po(st\" (\"id\"), constraint \"fk2\" foreign key (\"tag_id\") references \"tag\" (\"id\"))',","+  );","+});","+","+afterAll(() => orm.close(true));","+","+test('schema introspection handles quotes in table and index names', async () => {","+  const sql = await orm.schema.getUpdateSchemaSQL({ wrap: false });","+  expect(sql).toContain(\"drop table if exists `it's`\");","+  expect(sql).toContain('drop table if exists `back``tick`');","+});","+","+test('entity generator handles regexp special characters in table and column names', async () => {","+  const dump = await orm.entityGenerator.generate();","+  const source = dump.join('\\n');","+  expect(source).toContain(\"'a(b': p.integer().primary()\");","+  expect(source).toContain(\"'c[d': p.text().nullable()\");","+  expect(source).toContain(\"'e+f': string & Opt = 'x';\");","+  expect(source).toContain('owner: () => p.manyToOne(Parent)');","+  expect(source).toContain(\"tags: () => p.manyToMany(Tag).joinColumn('post_id').inverseJoinColumn('tag_id')\");","+});","+","+test('many to many property name strips the owner table prefix literally', () => {","+  const ns = new UnderscoreNamingStrategy();","+  expect(ns.manyToManyPropertyName('Post', 'Tag', 'po(st_tags', 'po(st')).toBe('tags');","+  expect(ns.manyToManyPropertyName('Post', 'Tag', 'po.st_tags', 'po.st')).toBe('tags');","+  expect(ns.manyToManyPropertyName('Post', 'Tag', 'poXst_tags', 'po.st')).toBe('poXstTags');","+});",""],"additions":53,"deletions":0,"truncated":false}],"additions":125,"deletions":13,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-20T17:57:36.438691+00:00"}