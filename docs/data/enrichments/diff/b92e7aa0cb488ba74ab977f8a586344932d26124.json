ique_ptr<se::DeviceAddressAllocator> allocator_;","   NVPTXCompiler compiler_;"," };"," ","+// Returns whether the fusion named `name` was assigned to the block-level","+// emitter.","+absl::StatusOr<bool> IsAssignedToBlockLevelEmitter(const HloModule& module,","+                                                   absl::string_view name) {","+  const HloInstruction* fusion =","+      module.entry_computation()->GetInstructionWithName(name);","+  if (fusion == nullptr) {","+    return absl::NotFoundError(name);","+  }","+  ABSL_ASSIGN_OR_RETURN(GpuBackendConfig gpu_config,","+                   fusion->backend_config<GpuBackendConfig>());","+  return gpu_config.fusion_backend_config().kind() == kTritonFusionKind &&","+         gpu_config.fusion_backend_config().has_block_level_fusion_config();","+}","+"," using AutotunerPassTest = ConfigAssignerPassTest;"," "," const char kCublasCustomCallHlo[] = R\"(","@@ -541,6 +585,63 @@ TEST_F(ConfigAssignerPassTest, AutotuneLevel0UsesDefaultConfig) {","             80000);"," }"," ","+// The slow loop transpose matches a pattern of GetDefaultBackend, the f32","+// reduction doesn't.","+constexpr absl::string_view kPolicyFusionsHlo = R\"(","+HloModule m","+","+transpose {","+  p0 = f32[256,128,64]{2,1,0} parameter(0)","+  ROOT transpose = f32[64,128,256]{2,1,0} transpose(p0), dimensions={2,1,0}","+}","+","+add {","+  p0 = f32[] parameter(0)","+  p1 = f32[] parameter(1)","+  ROOT add = f32[] add(p0, p1)","+}","+","+fused_reduce {","+  p0 = f32[128,256]{1,0} parameter(0)","+  c0 = f32[] constant(0)","+  ROOT reduce = f32[128]{0} reduce(p0, c0), dimensions={1}, to_apply=add","+}","+","+ENTRY main {","+  p0 = f32[256,128,64]{2,1,0} parameter(0)","+  p1 = f32[128,256]{1,0} parameter(1)","+  transpose_fusion = f32[64,128,256]{2,1,0} fusion(p0), kind=kLoop,","+    calls=transpose","+  reduce_fusion = f32[128]{0} fusion(p1), kind=kInput, calls=fused_reduce","+  ROOT tuple = (f32[64,128,256]{2,1,0}, f32[128]{0}) tuple(transpose_fusion,","+    reduce_fusion)","+})\";","+","+TEST_F(ConfigAssignerPassTest,","+       AutotuneLevel0PicksBlockLevelEmitterForPolicyFusions) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kPolicyFusionsHlo));","+  module->mutable_config().mutable_debug_options().set_xla_gpu_autotune_level(","+      0);","+  ASSERT_OK(RunWithEmitterBackends(module.get(), stream_executor_));","+  EXPECT_THAT(IsAssignedToBlockLevelEmitter(*module, \"transpose_fusion\"),","+              absl_testing::IsOkAndHolds(true));","+  EXPECT_THAT(IsAssignedToBlockLevelEmitter(*module, \"reduce_fusion\"),","+              absl_testing::IsOkAndHolds(false));","+}","+","+TEST_F(ConfigAssignerPassTest,","+       DevicelessPicksBlockLevelEmitterForPolicyFusions) {","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kPolicyFusionsHlo));","+  ASSERT_OK(RunWithEmitterBackends(module.get(),","+                                   /*stream_executor=*/nullptr));","+  EXPECT_THAT(IsAssignedToBlockLevelEmitter(*module, \"transpose_fusion\"),","+              absl_testing::IsOkAndHolds(true));","+  EXPECT_THAT(IsAssignedToBlockLevelEmitter(*module, \"reduce_fusion\"),","+              absl_testing::IsOkAndHolds(false));","+}","+"," TEST_F(ConfigAssignerPassTest, CublasGemmInNonDefaultStreamIsAutotuned) {","   const char kCublasCustomNonDefaultStreamCallHlo[] = R\"\"\"("," HloModule module, entry_computation_layout={(f32[100,100]{1,0}, f32[100,100]{1,0})->f32[100,100]{1,0}}","@@ -789,9 +890,15 @@ TEST_F(AutotunerFlagsTest, GetEnabledBackendsRespectsDeterminism) {","                        get_enabled_backends());","   for (const auto& backend : backends) {","     EXPECT_NE(backend->backend(), autotuner::Backend::TRITON);","-    EXPECT_NE(backend->backend(), autotuner::Backend::NATIVE_EMITTER);","-    EXPECT_NE(backend->backend(), autotuner::Backend::BLOCK_LEVEL_EMITTER);","   }","+  // The emitter backends stay enabled to assign configs to the fusions that","+  // GetDefaultBackend matches. This doesn't affect determinism: without online","+  // autotuning, configs don't depend on measurements.","+  EXPECT_THAT(GetEnabledBackendTypes(","+                  debug_options,","+                  target_config.device_description.gpu_compute_capability()),","+              IsSupersetOf({autotuner::Backend::NATIVE_EMITTER,","+                            autotuner::Backend::BLOCK_LEVEL_EMITTER}));"," ","   debug_options.set_xla_gpu_experimental_deterministic_ops_triton(","       DebugOptions::DETERMINISTIC_OPS_TRITON_MODE_UNCHECKED);","@@ -801,8 +908,6 @@ TEST_F(AutotunerFlagsTest, GetEnabledBackendsRespectsDeterminism) {","     if (backend->backend() == autotuner::Backend::TRITON) {","       has_triton = true;","     }","-    EXPECT_NE(backend->backend(), autotuner::Backend::NATIVE_EMITTER);","-    EXPECT_NE(backend->backend(), autotuner::Backend::BLOCK_LEVEL_EMITTER);","   }","   EXPECT_TRUE(has_triton);"," }",""],"additions":109,"deletions":4,"truncated":false}],"additions":194,"deletions":21,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-11T15:39:18.852938+00:00"}