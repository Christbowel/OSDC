{"id":"2c0001ce269cbf05e0868bb88429ab85780610f3","axis":"silent","repo":"foundry-rs/foundry","sha":"2c0001ce269cbf05e0868bb88429ab85780610f3","parsed":{"files":[{"path":"crates/forge/tests/cli/script.rs","lines":["@@ -1403,6 +1403,96 @@ Warning: Some transactions were discarded by the RPC node. Use `--resume` to ret","     }"," }"," ","+// A mined revert is recorded outside `receipts`, and resume warns about it, never resubmits it, and","+// continues with the operations after it.","+#[forgetest_init]","+async fn resume_skips_recorded_revert(prj: _, cmd: _) {","+    let gate = address!(\"0x000000000000000000000000000000000000bEEF\");","+    let script = prj.add_script(","+        \"RevertedResume.s.sol\",","+        r#\"","+import \"forge-std/Script.sol\";","+","+contract RevertedResume is Script {","+    function run() external {","+        vm.startBroadcast();","+        (bool success,) = address(0x000000000000000000000000000000000000bEEF).call(\"\");","+        require(success);","+        payable(address(0xdEaD)).transfer(1);","+        payable(address(0xdEaD)).transfer(1);","+        vm.stopBroadcast();","+    }","+}","+\"#,","+    );","+    let path = prj.root().join(\"broadcast/RevertedResume.s.sol/31337/run-latest.json\");","+    let (api, handle) = spawn(NodeConfig::test()).await;","+    // Runtime that reverts once storage slot 0 is set.","+    api.anvil_set_code(gate, bytes!(\"60005415600b57600080fd5b00\")).await.unwrap();","+    api.anvil_set_auto_mine(false).await.unwrap();","+    let rpc = handle.http_endpoint();","+    let sender = handle.dev_accounts().next().unwrap();","+    let args = [","+        \"--tc\",","+        \"RevertedResume\",","+        \"--rpc-url\",","+        &rpc,","+        \"--private-key\",","+        \"0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80\",","+        \"--slow\",","+    ];","+","+    // The gate call passes simulation, then reverts on chain before later calls are sent.","+    cmd.forge_fuse().arg(\"script\").arg(&script).args(args).arg(\"--broadcast\");","+    let mut child = KillOnDrop::spawn(cmd.cmd());","+    let reverted = tokio::time::timeout(Duration::from_secs(30), async {","+        loop {","+            if let Ok(sequence) = foundry_common::fs::read_json_file::<Value>(&path)","+                && let Some(hash) = sequence[\"pending\"].get(0)","+            {","+                break hash.as_str().unwrap().to_string();","+            }","+            tokio::time::sleep(Duration::from_millis(10)).await;","+        }","+    })","+    .await","+    .expect(\"the gate call was not checkpointed\");","+    api.anvil_set_storage_at(gate, U256::ZERO, B256::with_last_byte(1)).await.unwrap();","+    api.mine_one().await.unwrap();","+    api.anvil_set_auto_mine(true).await.unwrap();","+    tokio::time::timeout(Duration::from_secs(30), async {","+        while child.is_running() {","+            tokio::time::sleep(Duration::from_millis(10)).await;","+        }","+    })","+    .await","+    .expect(\"forge did not finish\");","+    let output = child.kill_and_wait();","+    assert!(!output.status.success());","+    assert_eq!(","+        String::from_utf8(output.stderr).unwrap(),","+        format!(\"Error: Transaction Failure: {reverted}\\n\")","+    );","+    let sequence: Value = foundry_common::fs::read_json_file(&path).unwrap();","+    assert_eq!(sequence[\"reverted\"], serde_json::json!([reverted]));","+    assert!(sequence[\"receipts\"].as_array().unwrap().is_empty());","+","+    // Every resume skips the revert; the first submits the remaining calls, the second nothing.","+    let provider = handle.http_provider();","+    for _ in 0..2 {","+        cmd.forge_fuse().arg(\"script\").arg(&script).args(args).arg(\"--resume\");","+        cmd.assert_success().stderr_eq(format!(","+            \"Warning: Transaction {reverted} on chain 31337 reverted; resume will not resubmit it.\\nWarning: ONCHAIN EXECUTION COMPLETE WITH REVERTED TRANSACTIONS:\\nchain 31337: {