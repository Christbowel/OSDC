lish */","+} WT_DISAGG_SCHEMA_OPS_STATS;","+","+/* Initializer for WT_DISAGG_SCHEMA_OPS_STATS. */","+#define WT_DISAGG_SCHEMA_OPS_STATS_INIT \\","+    {.awaiting_checkpoint_oldest = UINT64_MAX, .awaiting_publish_oldest = UINT64_MAX}","+","+/*","+ * __disagg_schema_op_uses_epochs --","+ *     Return whether a queued operation is a create or drop that uses schema epochs.","+ */","+static WT_INLINE bool","+__disagg_schema_op_uses_epochs(const WT_DISAGG_METADATA_OP *entry)","+{","+    return ((entry->metadata_op == WT_SHARED_METADATA_CREATE ||","+              entry->metadata_op == WT_SHARED_METADATA_REMOVE) &&","+      !entry->before_stable_epoch);","+}","+","+/*","+ * __disagg_schema_ops_stats_add --","+ *     Count a queued create or drop that uses schema epochs as awaiting publish or a checkpoint.","+ */","+static WT_INLINE void","+__disagg_schema_ops_stats_add(","+  WT_DISAGG_SCHEMA_OPS_STATS *schema_stats, const WT_DISAGG_METADATA_OP *entry)","+{","+    if (!__disagg_schema_op_uses_epochs(entry))","+        return;","+","+    if (entry->schema_epoch == WT_SCHEMA_EPOCH_UNPUBLISHED) {","+        schema_stats->awaiting_publish_oldest =","+          WT_MIN(schema_stats->awaiting_publish_oldest, entry->queued_time);","+        ++schema_stats->awaiting_publish_count;","+    } else {","+        schema_stats->awaiting_checkpoint_oldest =","+          WT_MIN(schema_stats->awaiting_checkpoint_oldest, entry->published_time);","+        ++schema_stats->awaiting_checkpoint_count;","+    }","+}","+","+/*","+ * __disagg_schema_ops_stats_store --","+ *     Store the schema operation counts for the statistics reader.","+ */","+static void","+__disagg_schema_ops_stats_store(","+  WT_SESSION_IMPL *session, const WT_DISAGG_SCHEMA_OPS_STATS *schema_stats)","+{","+    WT_DISAGGREGATED_STORAGE *disagg = &S2C(session)->disaggregated_storage;","+","+    WT_ASSERT_SPINLOCK_OWNED(session, &disagg->shared_metadata_queue_lock);","+","+    /* An empty state stores a zero time, as before anything was queued. */","+    __wt_atomic_store_uint64_relaxed(","+      &disagg->schema_awaiting_publish, schema_stats->awaiting_publish_count);","+    __wt_atomic_store_uint64_relaxed(&disagg->schema_awaiting_publish_oldest,","+      schema_stats->awaiting_publish_count == 0 ? 0 : schema_stats->awaiting_publish_oldest);","+    __wt_atomic_store_uint64_relaxed(","+      &disagg->schema_awaiting_checkpoint, schema_stats->awaiting_checkpoint_count);","+    __wt_atomic_store_uint64_relaxed(&disagg->schema_awaiting_checkpoint_oldest,","+      schema_stats->awaiting_checkpoint_count == 0 ? 0 : schema_stats->awaiting_checkpoint_oldest);","+}","+","+/*","+ * __disagg_schema_ops_stats_load --","+ *     Load the stored schema operation counts.","+ */","+static void","+__disagg_schema_ops_stats_load(WT_SESSION_IMPL *session, WT_DISAGG_SCHEMA_OPS_STATS *schema_stats)","+{","+    WT_DISAGGREGATED_STORAGE *disagg = &S2C(session)->disaggregated_storage;","+","+    schema_stats->awaiting_publish_count =","+      __wt_atomic_load_uint64_relaxed(&disagg->schema_awaiting_publish);","+    schema_stats->awaiting_publish_oldest = schema_stats->awaiting_publish_count == 0 ?","+      UINT64_MAX :","+      __wt_atomic_load_uint64_relaxed(&disagg->schema_awaiting_publish_oldest);","+    schema_stats->awaiting_checkpoint_count =","+      __wt_atomic_load_uint64_relaxed(&disagg->schema_awaiting_checkpoint);","+    schema_stats->awaiting_checkpoint_oldest = schema_stats->awaiting_checkpoint_count == 0 ?","+      UINT64_MAX :","+      __wt_atomic_load_uint64_relaxed(&disagg->schema_awaiting_checkpoint_oldest);","+}","+","+/*","+ * __disagg_schema_ops_stats_recount --","+ *     Recount the queued creates and drops for statistics. The caller holds the queue lock.","+ */","+static void","+__disagg_schema_ops_stats_recount(WT_SESSION_IMPL *session)","+{","+    WT_DISAGG_METADATA_OP *entry;","+    WT_DISAGGREGATED_STORAGE *disagg = &S2C(session)->disaggregated_storage;","+    WT_DISAGG_SCHEMA_OPS_STATS schema_stats = WT_DISAGG_SCHEMA_OPS_STATS_INIT;","+","+    WT_ASSERT_SPINLOCK_OWNED(session, &disagg->shared_metadata_queue_lock);","+","+    TAILQ_FOREACH (entry, &disagg->shared_metadata_qh, q)","+        __disagg_schema_ops_stats_add(&schema_stats, entry);","+    __disagg_schema_ops_stats_store(session, &schema_stats);","+}","+","+/*","+ * __wti_disagg_schema_ops_stats --","+ *     Set the shared metadata queue schema operation statistics.","+ */","+void","+__wti_disagg_schema_ops_stats(WT_SESSION_IMPL *session)","+{","+    WT_DISAGG_SCHEMA_OPS_STATS schema_stats;","+    const uint64_t now = __wt_clock(session);","+","+    __disagg_schema_ops_stats_load(session, &schema_stats);","+","+    WT_STAT_CONN_SET(session, disagg_schema_awaiting_publish, schema_stats.awaiting_publish_count);","+    WT_STAT_CONN_SET(session, disagg_schema_awaiting_publish_oldest,","+      schema_stats.awaiting_publish_count == 0 ?","+        0 :","+        WT_CLOCKDIFF_SEC(now, schema_stats.awaiting_publish_oldest));","+    WT_STAT_CONN_SET(","+      session, disagg_schema_awaiting_checkpoint, schema_stats.awaiting_checkpoint_count);","+    WT_STAT_CONN_SET(session, disagg_schema_awaiting_checkpoint_oldest,","+      schema_stats.awaiting_checkpoint_count == 0 ?","+        0 :","+        WT_CLOCKDIFF_SEC(now, schema_stats.awaiting_checkpoint_oldest));","+}","+"," /*","  * __wti_disagg_shared_metadata_op_to_string --","  *     Convert a metadata operation to string representation.","@@ -510,6 +646,7 @@ __wt_disagg_enqueue_metadata_operation(WT_SESSION_IMPL *session, const char *sta","     WT_CURSOR *cursor;","     WT_DECL_RET;","     WT_DISAGG_METADATA_OP *entry;","+    WT_DISAGG_SCHEMA_OPS_STATS schema_stats;"],"additions":137,"deletions":0,"truncated":false}],"additions":229,"deletions":38,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-10T17:08:17.808384+00:00"}