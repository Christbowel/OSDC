+struct ControlBlock {","+\texplicit ControlBlock(void (*destroy_p)(ControlBlock *)) noexcept : destroy(destroy_p) {","+\t}","+","+\tvoid AddReference() noexcept {","+\t\tauto previous = references.fetch_add(1, std::memory_order_relaxed);","+\t\t// Leave ample headroom for concurrent increments before terminating.","+\t\tif (previous == 0 || previous >= (std::numeric_limits<uint64_t>::max)() / 2) {","+\t\t\tstd::terminate();","+\t\t}","+\t}","+","+\tvoid Release() noexcept {","+\t\t// Acquiring an owner requires an existing strong owner. With no weak owners,","+\t\t// a sole owner cannot race with an increment and needs no atomic decrement.","+\t\tif (references.load(std::memory_order_acquire) == 1) {","+\t\t\t// buffer_from_this must also reject acquisition during destruction.","+\t\t\treferences.store(0, std::memory_order_relaxed);","+\t\t\tdestroy(this);","+\t\t\treturn;","+\t\t}","+\t\tif (references.fetch_sub(1, std::memory_order_release) == 1) {","+\t\t\t// Synchronize with the release sequence before destroying the payload.","+\t\t\t(void)references.load(std::memory_order_acquire);","+\t\t\tdestroy(this);","+\t\t}","+\t}","+","+\tstd::atomic<uint64_t> references {1};","+\tvoid (*destroy)(ControlBlock *);","+};","+","+template <class T>","+struct Allocation : ControlBlock {","+\ttemplate <class... ARGS>","+\texplicit Allocation(ARGS &&...args) : ControlBlock(Destroy), value(std::forward<ARGS>(args)...) {","+\t}","+","+\tstatic void Destroy(ControlBlock *block) {","+\t\tdelete static_cast<Allocation *>(block);","+\t}","+","+\tT value;","+};","+","+} // namespace buffer_ptr_detail","+","+//! Strong-only, atomic shared ownership for buffers. Independent handles can be","+//! used concurrently; modifying the same handle requires external synchronization.","+//! Create owners with make_buffer. Aliases retain an owner but may point elsewhere.","+template <class T>","+class buffer_ptr { // NOLINT: mimic std casing","+public:","+\tusing element_type = T;","+#if define