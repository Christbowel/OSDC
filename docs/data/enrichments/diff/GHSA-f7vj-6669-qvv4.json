cs: false})","+","+\tpipelineServer := createPipelineServerV1(resourceManager, http.DefaultClient)","+\t_, err := pipelineServer.CreatePipelineV1(","+\t\tcontext.Background(), &api.CreatePipelineRequest{","+\t\t\tPipeline: &api.Pipeline{","+\t\t\t\tUrl:  &api.Url{PipelineUrl: \"file:///etc/passwd\"},","+\t\t\t\tName: \"test-file-blocked\",","+\t\t\t},","+\t\t},","+\t)","+\tassert.NotNil(t, err)","+\tassert.Contains(t, err.Error(), \"Pipeline URL validation failed\")","+}","+","+type errorRoundTripper struct {","+\terr error","+}","+","+func (rt errorRoundTripper) RoundTrip(*http.Request) (*http.Response, error) {","+\treturn nil, rt.err","+}","+","+func TestCreatePipelineV1_URLValidation_MapsTransportValidationErrorToInvalidInput(t *testing.T) {","+\tviper.Set(common.PipelineURLValidationEnabled, \"false\")","+","+\tclientManager := resource.NewFakeClientManagerOrFatal(util.NewFakeTimeForEpoch())","+\tresourceManager := resource.NewResourceManager(clientManager, &resource.ResourceManagerOptions{CollectMetrics: false})","+","+\tpipelineServer := createPipelineServerV1(resourceManager, &http.Client{","+\t\tTransport: errorRoundTripper{err: util.NewInvalidInputError(\"connection to blocked IP range denied\")},","+\t})","+\t_, err := pipelineServer.CreatePipelineV1(","+\t\tcontext.Background(), &api.CreatePipelineRequest{","+\t\t\tPipeline: &api.Pipeline{","+\t\t\t\tUrl:  &api.Url{PipelineUrl: \"https://storage.googleapis.com/bucket/file.yaml\"},","+\t\t\t\tName: \"test-transport-validation-error\",","+\t\t\t},","+\t\t},","+\t)","+\tassert.NotNil(t, err)","+\tassert.Equal(t, codes.InvalidArgument, err.(*util.UserError).ExternalStatusCode())","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"backend/src/apiserver/validation/pipeline_url.go","lines":["@@ -0,0 +1,255 @@","+// Copyright 2025 The Kubeflow Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+// https://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package validation","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"net\"","+\t\"net/http\"","+\t\"net/url\"","+\t\"regexp\"","+\t\"strings\"","+\t\"sync\"","+\t\"time\"","+","+\t\"github.com/golang/glog\"","+\t\"github.com/kubeflow/pipelines/backend/src/apiserver/common\"","+\t\"github.com/kubeflow/pipelines/backend/src/common/util\"","+)","+","+// Default allowed domains for pipeline URLs","+var defaultAllowedDomains = []string{","+\t\"storage.googleapis.com\",","+\t\"s3.amazonaws.com\",","+\t\"github.com\",","+\t\"raw.githubusercontent.com\",","+}","+","+// Blocked CIDRs - private/loopback/link-local/metadata","+var blockedCIDRs = []string{","+\t// Loopback","+\t\"127.0.0.0/8\",","+\t\"::1/128\",","+","+\t// Private","+\t\"10.0.0.0/8\",","+\t\"172.16.0.0/12\",","+\t\"192.168.0.0/16\",","+\t\"fc00::/7\",","+","+\t// Link-local","+\t\"169.254.0.0/16\",","+\t\"fe80::/10\",","+","+\t// Metadata","+\t\"169.254.169.254/32\",","+\t\"fd00:ec2::254/128\",","+","+\t// Invalid","+\t\"0.0.0.0/8\",","+\t\"::/128\",","+}","+","+var defaultPorts = map[string]string{","+\t\"https\": \"443\",","+\t\"http\":  \"80\",","+}","+","+var (","+\tblockedNets    []*net.IPNet","+\tallowedDomains []*regexp.Regexp","+\turlConfigInit  sync.Once","+)","+","+// initURLConfig initializes blocked networks and allowed domains","+func initURLConfig() {","+\turlConfigInit.Do(func() {","+\t\t// Parse CIDR strings into IPNet objects","+\t\tfor _, cidr := range blockedCIDRs {","+\t\t\tif _, ipNet, err := net.ParseCIDR(cidr); err == nil {","+\t\t\t\tblockedNets = append(blockedNets, ipNet)","+\t\t\t} else {","+\t\t\t\tglog.Warningf(\"Failed to parse blocked CIDR %q: %v\", cidr, err)","+\t\t\t}","+\t\t}","+","+\t\t// Build allowed domains: defaults + user-configured","+\t\tallDomains := append([]string{}, defaultAllowedDomains...)","+\t\tuserDomains := common.GetStringConfigWithDefault(common.PipelineURLAllowedDomains, \"\")","+\t\tif userDomains != \"\" {","+\t\t\tfor _, d := range strings.Split(userDomains, \",\") {","+\t\t\t\tif d = strings.TrimSpace(d); d != \"\" {","+\t\t\t\t\tallDomains = append(allDomains, d)","+\t\t\t\t}","+\t\t\t}","+\t\t}","+","+\t\t// Compile domain patterns into regex","+\t\tfor _, domain := range allDomains {","+\t\t\tpattern := \"^\" + strings.ReplaceAll(regexp.QuoteMeta(domain), \"\\\\*\", \".*\") + \"$\"","+\t\t\tif re, err := regexp.Compile(pattern); err == nil {","+\t\t\t\tallowedDomains = append(allowedDomains, re)","+\t\t\t} else {","+\t\t\t\tglog.Warningf(\"Failed to compile domain pattern %q: %v\", pattern, err)","+\t\t\t}","+\t\t}","+\t})","+}","+","+// ValidatePipelineURL validates a pipeline URL is safe to fetch","+// Can be disabled via PIPELINE_URL_VALIDATION_ENABLED=false (for testing purposes only)","+func ValidatePipelineURL(urlStr string) error {","+\t// Allow disabling validation","+\tif !common.GetBoolConfigWithDefault(common.PipelineURLValidationEnabled, true) {","+\t\treturn nil","+\t}","+","+\tinitURLConfig()","+","+\tparsed, err := url.ParseRequestURI(urlStr)","+\tif err != nil {","+\t\treturn util.NewInvalidInputError(\"invalid URL: %v\", err)","+\t}","+","+\t// Validate scheme","+\tallowHTTP := common.GetBoolConfigWithDefault(common.PipelineURLAllowHTTP, false)","+\tif parsed.Scheme != \"https\" && (parsed.Scheme != \"http\" || !allowHTTP) {","+\t\treturn util.NewInvalidInputError(\"URL scheme %q not allowed, use https\", parsed.Scheme)","+\t}","+","+\t// Validate port","+\tport := parsed.Port()","+\tif port != \"\" && port != defaultPorts[parsed.Scheme] {","+\t\treturn util.NewInvalidInputError(","+\t\t\t\"%s requires port %s, got %q\",","+\t\t\tstrings.ToUpper(parsed.Scheme),","+\t\t\tdefaultPorts[parsed.Scheme],","+\t\t\tport,","+\t\t)","+\t}","+","+\t// Validate domain against allowlist","+\thost := strings.ToLower(strings.TrimSuffix(parsed.Hostname(), \".\"))","+\tif !isDomainAllowed(host) {","+\t\treturn util.NewInvalidInputError(\"URL domain %q not in allowlist\", host)","+\t}","+","+\t// Resolve DNS and validate IPs are not in blocked ranges","+\tif err := validateResolvedIPs(host); err != nil {","+\t\treturn err","+\t}","+","+\treturn nil","+}","+","+func isDomainAllowed(host string) bool {","+\tfor _, re := range allowedDomains {","+\t\tif re.MatchString(host) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+const dnsLookupTimeout = 5 * time.Second","+","+func validateResolvedIPs(host string) error {","+\tctx, cancel := context.WithTimeout(context.Background(), dnsLookupTimeout)","+\tdefer cancel()","+","+\taddrs, err := net.DefaultResolver.LookupIPAddr(ctx, host)","+\tif err != nil {","+\t\treturn util.NewInvalidInputError(\"DNS resolution failed for %q: %v\", host, err)","+\t}","+","+\tfor _, addr := range addrs {","+\t\tif isBlockedIP(addr.IP) {","+\t\t\treturn util.NewInvalidInputError(\"URL resolves to blocked IP range: %v\", addr.IP)","+\t\t}","+\t}","+\treturn nil","+}","+","+func isBlockedIP(ip net.IP) bool {","+\tfor _, ipNet := range blockedNets {","+\t\tif ipNet.Contains(ip) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// SafePipelineHTTPClient creates an HTTP client with timeout, redirect validation,","+// and a custom dialer that enforces IP validation at connection time to prevent","+// DNS rebinding (TOCTOU) attacks.","+const minimumHTTPTimeout = 1","+","+func SafePipelineHTTPClient() *http.Client {","+\ttimeoutSeconds := common.GetIntConfigWithDefault(common.PipelineURLTimeout, 30)","+\tif timeoutSeconds < minimumHTTPTimeout {","+\t\ttimeoutSeconds = 30","+\t}","+\ttimeout := time.Duration(timeoutSeconds) * time.Second","+","+\ttransport := http.DefaultTransport.(*http.Transport).Clone()","+\ttransport.Proxy = nil","+\ttransport.DialContext = safeDialContext","+","+\treturn &http.Client{","+\t\tTimeout:   timeout,","+\t\tTransport: transport,","+\t\tCheckRedirect: func(req *http.Request, via []*http.Request) error {","+\t\t\tif len(via) >= 10 {","+\t\t\t\treturn util.NewInvalidInputError(\"too many redirects\")","+\t\t\t}","+\t\t\treturn ValidatePipelineURL(req.URL.String())","+\t\t},","+\t}","+}","+","+// safeDialContext resolves the host, validates all IPs against blocked ranges,","+// and connects only to a validated IP. This closes the DNS TOCTOU gap where","+// a host could resolve to a safe IP during validation but a blocked IP at","+// connection time (DNS rebinding).","+func safeDialContext(ctx context.Context, network, addr string) (net.Conn, error) {","+\thost, port, err := net.SplitHostPort(addr)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"invalid address %q: %v\", addr, err)","+\t}","+","+\tinitURLConfig()","+","+\taddrs, err := net.DefaultResolver.LookupIPAddr(ctx, host)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"DNS resolution failed for %q: %v\", host, err)","+\t}","+","+\tfor _, a := range addrs {","+\t\tif isBlockedIP(a.IP) {","+\t\t\treturn nil, util.NewInvalidInputError(\"connection to blocked IP range denied\")","+\t\t}","+\t}","+","+\t// Connect using the resolved IPs directly","+\tvar dialer net.Dialer","+\tfor _, a := range addrs {","+\t\tconn, err := dialer.DialContext(ctx, network, net.JoinHostPort(a.IP.String(), port))","+\t\tif err == nil {","+\t\t\treturn conn, nil","+\t\t}","+\t}","+\treturn nil, fmt.Errorf(\"failed to connect to any resolved address for %q\", host)","+}"],"additions":255,"deletions":0,"truncated":false},{"path":"backend/src/apiserver/validation/pipeline_url_test.go","lines":["@@ -0,0 +1,343 @@","+// Copyright 2025 The Kubeflow Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+// https://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package validation","+","+import (","+\t\"context\"","+\t\"net\"","+\t\"net/http\"","+\t\"net/url\"","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/spf13/viper\"","+\t\"github.com/stretchr/testify/assert\"","+)","+","+// resetURLConfig resets the sync.Once to allow re-initialization with new config","+func resetURLConfig() {","+\turlConfigInit = sync.Once{}","+\tblockedNets = nil","+\tallowedDomains = nil","+}","+","+func TestValidatePipelineURL_AllowedDomains(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\t// Default allowed domains should pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://storage.googleapis.com/bucket/file.yaml\"))","+\tassert.NoError(t, ValidatePipelineURL(\"https://github.com/kubeflow/pipelines/raw/main/test.yaml\"))","+\tassert.NoError(t, ValidatePipelineURL(\"https://s3.amazonaws.com/bucket/file.yaml\"))","+","+\t// Disallowed domain should fail","+\terr := ValidatePipelineURL(\"https://evil.com/malicious.yaml\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"not in allowlist\")","+}","+","+func TestValidatePipelineURL_BlockedDomain(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\t// localhost should fail (not in allowlist)","+\terr := ValidatePipelineURL(\"https://localhost/file.yaml\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"not in allowlist\")","+}","+","+func TestValidatePipelineURL_SchemeRestriction(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\t// HTTP blocked by default","+\terr := ValidatePipelineURL(\"http://storage.googleapis.com/bucket/file.yaml\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"scheme\")","+","+\t// HTTPS allowed","+\tassert.NoError(t, ValidatePipelineURL(\"https://storage.googleapis.com/bucket/file.yaml\"))","+}","+","+func TestValidatePipelineURL_HTTPAllowedWhenConfigured(t *testing.T) {","+\tviper.Reset()","+\tviper.Set(\"PIPELINE_URL_ALLOW_HTTP\", \"true\")","+\tresetURLConfig()","+","+\t// HTTP allowed when configured","+\tassert.NoError(t, ValidatePipelineURL(\"http://storage.googleapis.com/bucket/file.yaml\"))","+}","+","+func TestValidatePipelineURL_PortRestriction(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\t// Default port (no port specified) should pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://storage.googleapis.com/bucket/file.yaml\"))","+","+\t// Explicit standard port should pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://storage.googleapis.com:443/bucket/file.yaml\"))","+","+\t// Non-standard port should fail","+\terr := ValidatePipelineURL(\"https://storage.googleapis.com:8080/bucket/file.yaml\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"port\")","+}","+","+func TestValidatePipelineURL_PortMustMatchScheme(t *testing.T) {","+\tviper.Reset()","+\tviper.Set(\"PIPELINE_URL_ALLOW_HTTP\", \"true\")","+\tresetURLConfig()","+","+\t// HTTPS on port 80 should fail","+\terr := ValidatePipelineURL(\"https://storage.googleapis.com:80/bucket/file.yaml\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"HTTPS requires port 443\")","+","+\t// HTTP on port 443 should fail","+\terr = ValidatePipelineURL(\"http://storage.googleapis.com:443/bucket/file.yaml\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"HTTP requires port 80\")","+}","+","+func TestValidatePipelineURL_UserConfiguredDomains(t *testing.T) {","+\tviper.Reset()","+\tviper.Set(\"PIPELINE_URL_ALLOWED_DOMAINS\", \"example.com\")","+\tresetURLConfig()","+","+\t// User-configured domain should pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://example.com/test.yaml\"))","+","+\t// Default domains should still pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://storage.googleapis.com/bucket/file.yaml\"))","+}","+","+func TestValidatePipelineURL_InvalidURL(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\terr := ValidatePipelineURL(\"not-a-valid-url\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"invalid URL\")","+}","+","+func TestValidatePipelineURL_FileSchemeBlocked(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\terr := ValidatePipelineURL(\"file:///etc/passwd\")","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"scheme\")","+}","+","+func TestIsBlockedIP(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+\tinitURLConfig()","+","+\ttests := []struct {","+\t\tip      string","+\t\tblocked bool","+\t\tdesc    string","+\t}{","+\t\t// Loopback","+\t\t{\"127.0.0.1\", true, \"IPv4 loopback\"},","+\t\t{\"127.255.255.255\", true, \"IPv4 loopback range end\"},","+\t\t{\"::1\", true, \"IPv6 loopback\"},","+","+\t\t// Private IPv4","+\t\t{\"10.0.0.1\", true, \"Private Class A\"},","+\t\t{\"10.255.255.255\", true, \"Private Class A end\"},","+\t\t{\"172.16.0.1\", true, \"Private Class B start\"},","+\t\t{\"172.31.255.255\", true, \"Private Class B end\"},","+\t\t{\"192.168.1.1\", true, \"Private Class C\"},","+\t\t{\"192.168.255.255\", true, \"Private Class C end\"},","+","+\t\t// Link-local / metadata","+\t\t{\"169.254.0.1\", true, \"Link-local\"},","+\t\t{\"169.254.169.254\", true, \"Cloud metadata endpoint\"},","+","+\t\t// Public IPs (should NOT be blocked)","+\t\t{\"8.8.8.8\", false, \"Google DNS\"},","+\t\t{\"1.1.1.1\", false, \"Cloudflare DNS\"},","+\t\t{\"142.250.80.46\", false, \"Google public\"},","+\t\t{\"151.101.1.140\", false, \"GitHub\"},","+\t}","+","+\tfor _, tt := range tests {","+\t\tip := net.ParseIP(tt.ip)","+\t\tassert.NotNil(t, ip, \"Failed to parse IP: %s\", tt.ip)","+\t\tassert.Equal(t, tt.blocked, isBlockedIP(ip), \"%s: IP %s should be blocked=%v\", tt.desc, tt.ip, tt.blocked)","+\t}","+}","+","+func TestIsBlockedIP_IPv6Metadata(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+\tinitURLConfig()","+","+\tip := net.ParseIP(\"fd00:ec2::254\")","+\tassert.NotNil(t, ip)","+\tassert.True(t, isBlockedIP(ip), \"AWS EC2 IPv6 metadata endpoint should be blocked\")","+}","+","+func TestValidatePipelineURL_HostnameNormalization(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\t// Trailing dot (FQDN) should be normalized and pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://storage.googleapis.com./bucket/file.yaml\"))","+","+\t// Mixed case should be normalized and pass","+\tassert.NoError(t, ValidatePipelineURL(\"https://Storage.GoogleAPIs.COM/bucket/file.yaml\"))","+}","+","+func TestSafePipelineHTTPClient_RedirectValidation(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\tclient := SafePipelineHTTPClient()","+","+\t// Simulate a redirect to a disallowed domain","+\tredirectRequest := &http.Request{","+\t\tURL: &url.URL{","+\t\t\tScheme: \"https\",","+\t\t\tHost:   \"evil.com\",","+\t\t\tPath:   \"/malicious.yaml\",","+\t\t},","+\t}","+\tvia := []*http.Request{{}} // one prior redirect","+\terr := client.CheckRedirect(redirectRequest, via)","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"not in allowlist\")","+","+\t// Simulate a redirect to an allowed domain","+\tallowedRequest := &http.Request{","+\t\tURL: &url.URL{","+\t\t\tScheme: \"https\",","+\t\t\tHost:   \"storage.googleapis.com\",","+\t\t\tPath:   \"/bucket/redirected.yaml\",","+\t\t},","+\t}","+\terr = client.CheckRedirect(allowedRequest, via)","+\tassert.NoError(t, err)","+}","+","+func TestSafePipelineHTTPClient_TooManyRedirects(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\tclient := SafePipelineHTTPClient()","+","+\tredirectRequest := &http.Request{","+\t\tURL: &url.URL{","+\t\t\tScheme: \"https\",","+\t\t\tHost:   \"storage.googleapis.com\",","+\t\t\tPath:   \"/file.yaml\",","+\t\t},","+\t}","+\t// 10 prior redirects should trigger \"too many redirects\"","+\tvia := make([]*http.Request, 10)","+\terr := client.CheckRedirect(redirectRequest, via)","+\tassert.Error(t, err)","+\tassert.Contains(t, err.Error(), \"too many redirects\")","+}","+","+func TestSafePipelineHTTPClient_ZeroTimeoutDefaultsTo30(t *testing.T) {","+\tviper.Reset()","+\tviper.Set(\"PIPELINE_URL_TIMEOUT\", \"0\")","+\tresetURLConfig()","+","+\tclient := SafePipelineHTTPClient()","+\tassert.Equal(t, 30*time.Second, client.Timeout, \"Zero timeout should default to 30 seconds\")","+}","+","+func TestSafePipelineHTTPClient_HasTimeout(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\tclient := SafePipelineHTTPClient()","+\tassert.NotNil(t, client)","+\tassert.True(t, client.Timeout > 0, \"Client should have a timeout configured\")","+}","+","+func TestSafePipelineHTTPClient_CustomTimeout(t *testing.T) {","+\tviper.Reset()","+\tviper.Set(\"PIPELINE_URL_TIMEOUT\", \"60\")","+\tresetURLConfig()","+","+\tclient := SafePipelineHTTPClient()","+\tassert.NotNil(t, client)","+\t// 60 seconds = 60,000,000,000 nanoseconds","+\tassert.Equal(t, int64(60_000_000_000), int64(client.Timeout))","+}","+","+func TestSafePipelineHTTPClient_HasCustomTransport(t *testing.T) {","+\tviper.Reset()","+\tresetURLConfig()","+","+\tclient := SafePipelineHTTPClient()","+\tassert.NotNil(t, client.Transport, \"Client should have a custom transport to prevent DNS rebinding\")","+\t_, ok := client.Transport.(*http.Transport)","+\tassert.True(t, ok, \"Transport should be *http.Transport with custom DialContext\")","+}","+","+func TestSafeDialContext_BlocksPrivateIPs(t *testing.T) {","+\tviper.Reset()","+\tre