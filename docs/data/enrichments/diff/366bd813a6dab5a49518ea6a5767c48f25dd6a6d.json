Config, getSectionById],","   );"," ","   return { isOllieAvailable, askOllie };"],"additions":12,"deletions":4,"truncated":false},{"path":"apps/opik-frontend/src/types/assistant-sidebar.test.ts","lines":["@@ -10,6 +10,6 @@ import { BRIDGE_PROTOCOL_VERSION } from \"./assistant-sidebar\";"," // together, then update the expectation below."," describe(\"bridge protocol\", () => {","   it(\"is pinned to the version both sides must agree on\", () => {","-    expect(BRIDGE_PROTOCOL_VERSION).toBe(5);","+    expect(BRIDGE_PROTOCOL_VERSION).toBe(6);","   });"," });"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/opik-frontend/src/types/assistant-sidebar.ts","lines":["@@ -40,6 +40,10 @@ export interface ConversationStartOptions {","   origin?: ConversationOrigin;","   // Id of the click, so BI matches it to the session it opens.","   entryId?: string;","+  // The section the Add widget dialog was opened from, so Ollie adds the widget there.","+  section?: string;","+  // Its id, which Ollie prefers to the title: titles can repeat or be renamed.","+  sectionId?: string;","   // What the chat should produce for the host; Ollie reads `context` into hidden context and answers with `artifact:proposed`.","   artifact?: ArtifactRequest;"," }","@@ -77,6 +81,8 @@ export interface ChartEditRequest {","   rows?: Record<string, unknown>[] | null;","   // Id of the click, so BI matches it to the session it opens.","   entryId?: string;","+  // \"Duplicate\": the chat refines a copy, which is added as a new widget and never replaces this one.","+  duplicate?: boolean;"," }"," "," export interface BridgeDashboard {","@@ -152,12 +158,14 @@ export interface ExplainButtonProps {","  * 5 = `artifact` on `conversation:start`, `artifact:proposed` (shell → host)","  * carrying something Ollie made for the host, `artifact:result` (host → shell)","  * saying whether it was applied, and the `artifacts` capability.","+ * 6 = widget mode: `section` and `sectionId` on `conversation:start` and","+ * `duplicate` on `chart:edit`.","  *","  * ⚠️ MUST move in lockstep with `ollie-console/src/bridge.ts`; the console's","  * VER-4 assertions guard the event-shape contract. Bump here AND there together","  * whenever a bridge event is added/removed/reshaped.","  */","-export const BRIDGE_PROTOCOL_VERSION = 5;","+export const BRIDGE_PROTOCOL_VERSION = 6;"," "," /** Host → Sidebar events */"," export interface HostEventMap {","@@ -221,6 +229,9 @@ export interface AssistantSidebarBridge {","   editChart?(request: ChartEditRequest): void;","   // Whether the console announced the `charts` capability; an older console never handles `chart:edit`.","   canEditChart?(): boolean;","+  // Whether the console handles `chart:edit`'s `duplicate` (bridge v6). An older one opens a plain edit, whose card","+  // would save over the widget the user meant to copy.","+  canDuplicateChart?(): boolean;","   // Whether the console announced the `artifacts` capability; an older console never sends `artifact:proposed`.","   canProposeArtifacts?(): boolean;","   // Calls back when the console announces its capabilities, so hosts that read them can update."],"additions":12,"deletions":1,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/dashboards/widgets/OllieChartWidget/OllieChartActionsMenu.tsx","lines":["@@ -25,6 +25,8 @@ type OllieChartActionsMenuProps = {","   widgetTitle: string;","   // Edit in Ollie; without it (Ollie off, or a console without chart editing) the item opens the widget editor.","   onEditInOllie?: () => void;","+  // \"Duplicate in Ollie\": a copy refined in chat, added as a new widget. Offered beside the plain duplicate.","+  onDuplicateInOllie?: () => void;","   // Absent until the widget's query can run.","   onRefresh?: () => void;","   onOpenChange?: (open: boolean) => void;","@@ -37,6 +39,7 @@ const OllieChartActionsMenu: React.FunctionComponent<","   widgetId,","   widgetTitle,","   onEditInOllie,","+  onDuplicateInOllie,","   onRefresh,","   onOpenChange,"," }) => {","@@ -72,8 +75,10 @@ const OllieChartActionsMenu: React.FunctionComponent<","   );"," ","   // Read on every render, so opening the menu sees whether the console has announced chart editing yet.","-  const editInOllie = window.opikBridge?.canEditChart?.()","-    ? onEditInOllie","+  const canEditChart = window.opikBridge?.canEditChart?.();","+  const editInOllie = canEditChart ? onEditInOllie : undefined;","+  const duplicateInOllie = window.opikBridge?.canDuplicateChart?.()","+    ? onDuplicateInOllie","     : undefined;"," ","   const run = (action: () => void) => (e: React.MouseEvent) => {","@@ -94,7 +99,7 @@ const OllieChartActionsMenu: React.FunctionComponent<","             <MoreHorizontal className=\"size-4\" />","           </Button>","         </DropdownMenuTrigger>","-        <DropdownMenuContent align=\"end\" className=\"w-44\">","+        <DropdownMenuContent align=\"end\" className=\"w-52\">","           <DropdownMenuItem","             onClick={run(() =>","               editInOllie","@@ -117,6 +122,12 @@ const OllieChartActionsMenu: React.FunctionComponent<","             <Copy className=\"mr-2 size-4\" />","             Duplicate","           </DropdownMenuItem>","+          {duplicateInOllie && (","+            <DropdownMenuItem onClick={run(duplicateInOllie)}>","+              <Copy className=\"mr-2 size-4\" />","+              Duplicate in Ollie","+            </DropdownMenuItem>","+          )}","           <DropdownMenuSeparator />","           <DropdownMenuItem","             variant=\"destructive\""],"additions":14,"deletions":3,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/dashboards/widgets/OllieChartWidget/OllieChartWidget.comparison.test.tsx","lines":["@@ -0,0 +1,108 @@","+import React from \"react\";","+import { act, render } from \"@testing-library/react\";","+import { describe, expect, it, vi } from \"vitest\";","+import { useDashboardStore } from \"@/store/DashboardStore\";","+import useDashboardWidgetQuery from \"@/api/dashboards/useDashboardWidgetQuery\";","+import { DashboardWidget as DashboardWidgetType } from \"@/types/dashboard\";","+import OllieChartWidget from \"./OllieChartWidget\";","+","+type Row = Record<string, unknown>;","+// What OllieKpi rendered with, and the value's fetch time at that render.","+const renders: { previousRows?: Row[] | null; fetchedAt: number }[] = [];","+let fetchedAt = 0;","+","+vi.mock(\"./OllieKpi\", async (importOriginal) => ({","+  ...(await importOriginal<object>()),","+  default: ({ previousRows }: { previousRows?: Row[] | null }) => {","+    renders.push({ previousRows, fetchedAt });","+    return null;","+  },","+}));","+vi.mock(\"@/api/dashboards/useDashboardWidgetQuery\");","+vi.mock(\"@/contexts/feature-toggles-provider\", () => ({","+  useIsFeatureEnabled: () => false,","+}));","+vi.mock(\"@/icons/ollie-owl.svg?react\", () => ({ default: () => null }));","+vi.mock(\"@/shared/Dashboard/DashboardWidget/DashboardWidget\", () => {","+  const Pass = ({ children }: { children?: React.ReactNode }) => (","+    <>{children}</>","+  );","+  return {","+    default: Object.assign(Pass, {","+      PreviewHeader: () => null,","+      Header: () => null,","+      DragHandle: () => null,","+      Content: Pass,","+      EmptyState: () => null,","+    }),","+  };","+});","+","+const MINUTE = 60_000;","+const HOUR = 60 * MINUTE;","+","+describe(\"OllieChartWidget KPI comparison after a refetch\", () => {","+  it(\"never pairs the refetched value with the window built for the previous fetch\", () => {","+    const widget = {","+      id: \"w-1\",","+      type: \"ollie_chart\",","+      title: \"Total cost\",","+      config: {","+        spec: {","+          kpi: {","+            value: \"value\",","+            format: \"cost_total\",","+            aggregate: \"sum\",","+            window_days: 30,","+          },","+        },","+        query: { id: \"q-1\" },","+      },","+    } as unknown as DashboardWidgetType;","+    useDashboardStore.setState({","+      sections: [{ id: \"s1\", title: \"Section\", widgets: [widget], layout: [] }],","+      previewWidget: widget,","+      runtimeConfig: { dashboardId: \"dash-1\" } as never,","+    });","+    // The comparison query ends where the dashboard's range starts; its rows record the fetch time it was built for.","+    vi.mocked(useDashboardWidgetQuery).mockImplementation(","+      (params) =>","+        ({","+          data: params.intervalEnd","+            ? [","+                {","+                  value: 1,","+                  builtFor:","+                    2 * new Date(params.intervalEnd).getTime() -","+                    new Date(params.intervalStart!).getTime(),","+                },","+              ]","+            : [{ value: 5 }],","+          isPending: false,","+          isFetching: false,","+          error: null,","+          refetch: vi.fn(),","+          dataUpdatedAt: params.intervalEnd ? 0 : fetchedAt,","+        }) as never,","+    );","+","+    fetchedAt = Date.now();","+    render(<OllieChartWidget preview />);","+    // A refetch three hours later; the widget is memoised, so the new result reaches it through a re-render the","+    // store triggers, as a query update would.","+    fetchedAt += 3 * HOUR;","+    act(() =>","+      useDashboardStore.setState({","+        previewWidget: { ...widget, title: \"Total cost, refreshed\" },","+      }),","+    );","+","+    const compared = renders.filter((r) => r.previousRows);","+    expect(compared.length).toBeGreaterThan(0);","+    for (const r of compared) {","+      expect(r.previousRows![0].builtFor).toBe(","+        Math.floor(r.fetchedAt / MINUTE) * MINUTE,","+      );","+    }","+  });","+});"],"additions":108,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/dashboards/widgets/OllieChartWidget/OllieChartWidget.test.tsx","lines":["@@ -1,5 +1,5 @@"," import React from \"react\";","-import { act, render, screen } from \"@testing-library/react\";","+import { act, cleanup, render, screen } from \"@testing-library/react\";"," import { beforeEach, describe, expect, it, vi } from \"vitest\";"," import { useDashboardStore } from \"@/store/DashboardStore\";"," import useDashboardWidgetQuery from \"@/api/dashboards/useDashboardWidgetQuery\";","@@ -7,6 +7,8 @@ import { DashboardWidget as DashboardWidgetType } from \"@/types/dashboard\";"," import { OpikEvent, trackEvent } from \"@/lib/analytics/tracking\";"," import OllieChartWidget from \"./OllieChartWidget\";"," ","+const MINUTE = 60_000;","+"," vi.mock(\"@/api/dashboards/useDashboardWidgetQuery\");"," vi.mock(\"@/lib/analytics/tracking\", async (importOriginal) => ({","   ...(await importOriginal<object>()),","@@ -35,6 +37,8 @@ vi.mock(\"@/shared/Dashboard/DashboardWidget/DashboardWidget\", () => {"," });"," "," const queryMock = vi.mocked(useDashboardWidgetQuery);","+// Each render runs the value's query, then the KPI comparison's.","+const valueCall = () => queryMock.mock.calls.at(-2)!;"," "," const ollieWidget = (id: string): DashboardWidgetType =>","   ({","@@ -75,7 +79,7 @@ describe(\"OllieChartWidget preview\", () => {","     setStore(ollieWidget(\"w-1\"));","     render(<OllieChartWidget preview />);"," ","-    const [params, options] = queryMock.mock.calls.at(-1)!;","+    const [params, options] = valueCall();","     expect(params.widgetId).toBe(\"w-1\");","     expect(options?.enabled).toBe(true);","     expect(screen.getByText(\"1 rows\")).toBeTruthy();","@@ -85,7 +89,7 @@ describe(\"OllieChartWidget preview\", () => {","     setStore(ollieWidget(\"preview\"));","     render(<OllieChartWidget preview />);"," ","-    expect(queryMock.mock.calls.at(-1)![1]?.enabled).toBe(false);","+    expect(valueCall()[1]?.enabled).toBe(false);","     expect(screen.getByText(\"No data\")).toBeTruthy();","   });"," });","@@ -187,6 +191,195 @@ describe(\"OllieChartWidget saved widget\", () => {","   ])(\"retries a 404 only when %s\", (_, savedWidgetIds, retryNotFound) => {","     renderSaved(savedWidgetIds);"," ","-    expect(queryMock.mock.calls.at(-1)![1]?.retryNotFound).toBe(retryNotFound);","+    expect(valueCall()[1]?.retryNotFound).toBe(retryNotFound);","+  });","+});","+","+describe(\"OllieChartWidget KPI comparison\", () => {","+  // When the value was fetched: an open-ended range, and so its comparison window, runs to it.","+  const fetchedAt = Date.now();","+","+  beforeEach(() => {","+    queryMock.mockReset();","+    queryMock.mockReturnValue({","+      data: [{ value: 5 }],","+      isPending: false,","+      isFetching: false,","+      error: null,","+      refetch: vi.fn(),","+      dataUpdatedAt: fetchedAt,","+    } as never);","+  });","+","+  it(\"compares a preset range, which has no end, with the window just before it\", () => {","+    const kpiWidget = {","+      ...ollieWidget(\"w-1\"),","+      config: {","+        spec: {","+          kpi: {","+            value: \"value\",","+            format: \"cost_total\",","+            aggregate: \"sum\",","+            window_days: 30,","+          },","+        },","+        query: { id: \"q-1\" },","+      },","+    } as unknown as DashboardWidgetType;","+    setStore(kpiWidget);","+    render(<OllieChartWidget preview />);","+","+    const [current, currentOptions] = valueCall();","+    const [previous, previousOptions] = queryMock.mock.calls.at(-1)!;","+    // The comparison waits out an unsaved widget's 404 like the value does.","+    expect(previousOptions?.retryNotFound).toBe(currentOptions?.retryNotFound);","+    // The dashboard's default range is a preset: it runs to now.","+    expect(current.intervalEnd).toBeUndefined();","+    expect(previousOptions?.enabled).toBe(true);","+    expect(previous.intervalEnd).toBe(current.intervalStart);","+    // As long as the current window, which runs from its start to the minute the value was fetched.","+    const previousLength =","+      new Date(previous.intervalEnd!).getTime() -","+