e between 1 and the burst (10)\");","+        assertThat(validate(g(\"store\"), \"redis\", g(\"lease-size\"), \"0\"))","+                .containsExactly(\"Rate limit rule 'api' lease-size must be between 1 and the burst (10)\");","+        assertThat(validate(g(\"store\"), \"redis\", g(\"lease-size\"), \"4\", g(\"burst\"), \"3\"))","+                .containsExactly(\"Rate limit rule 'api' lease-size must be between 1 and the burst (3)\");","+    }","+","+    @Test","+    void maxOverdraftMustFitBurst() {","+        assertThat(validate(g(\"store\"), \"redis\", g(\"lease-size\"), \"2\", g(\"max-overdraft\"), \"11\"))","+                .containsExactly(\"Rate limit rule 'api' max-overdraft must be between 0 and the burst (10)\");","+        assertThat(validate(g(\"store\"), \"redis\", g(\"lease-size\"), \"2\", g(\"max-overdraft\"), \"-1\"))","+                .containsExactly(\"Rate limit rule 'api' max-overdraft must be between 0 and the burst (10)\");","+    }","+","+    @Test","+    void largeLeaseSizeWarns() {","+        assertThat(validate(g(\"store\"), \"redis\", g(\"permits\"), \"100\", g(\"lease-size\"), \"6\")).isEmpty();","+        assertThat(warnings(g(\"store\"), \"redis\", g(\"permits\"), \"100\", g(\"lease-size\"), \"6\")).containsExactly(","+                \"Rate limit rule 'api' lease-size × replicas may strand a large share of permits (lease-size <= permits / 20 is recommended)\");","+        assertThat(warnings(g(\"store\"), \"redis\", g(\"permits\"), \"100\", g(\"lease-size\"), \"5\")).isEmpty();","+    }","+","     @Test","     void storeSettings() {","         assertThat(validate(P + \"store-timeout\", \"0s\")).containsExactly("],"additions":51,"deletions":2,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/LeaseModeTest.java","lines":["@@ -0,0 +1,71 @@","+package io.quarkus.http.ratelimit;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.net.URL;","+","+import jakarta.inject.Inject;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.http.ratelimit.store.SwitchableTestStore;","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.vertx.core.Vertx;","+import io.vertx.core.buffer.Buffer;","+import io.vertx.ext.web.client.HttpResponse;","+","+/**","+ * Strict lease mode over the switchable store: 8 permits per minute, lease-size 4. The chunks are sized by demand and","+ * the store's tail, the ninth request is refused with the store's wait, and the refusal is cached.","+ */","+public class LeaseModeTest {","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = SwitchableStoreApp.leaseRule(SwitchableStoreApp.create(\"local\"));","+","+    @Inject","+    Vertx vertx;","+","+    @TestHTTPResource","+    URL url;","+","+    TestClient http;","+","+    @BeforeEach","+    void createClient() {","+        http = new TestClient(vertx, url);","+    }","+","+    @AfterEach","+    void closeClient() {","+        http.close();","+    }","+","+    @BeforeEach","+    void reset() {","+        SwitchableTestStore.reset();","+    }","+","+    @Test","+    void chunksAreSizedByDemandAndTail() {","+        for (int i = 1; i <= 8; i++) {","+            assertThat(http.get(\"/x\").statusCode()).as(\"request %d\", i)","+                    .isEqualTo(200);","+        }","+        // 1; then min(2, 7 / 2) = 2 serving 2-3; min(4, 5 / 2) = 2 serving 4-5; then 1, 1, 1","+        assertThat(SwitchableTestStore.costs).containsExactly(1L, 2L, 2L, 1L, 1L, 1L);","+","+        HttpResponse<Buffer> ninth = http.get(\"/x\");","+        assertThat(ninth.statusCode()).isEqualTo(429);","+        assertThat(SwitchableTestStore.costs).containsExactly(1L, 2L, 2L, 1L, 1L, 1L, 1L);","+        assertThat(Integer.parseInt(ninth.getHeader(\"Retry-After\"))).isBetween(1, 8);","+","+        // the refusal is cached for the store's wait: no new store call","+        assertThat(http.get(\"/x\").statusCode()).isEqualTo(429);","+        assertThat(SwitchableTestStore.calls).hasValue(7);","+    }","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/LeaseWithLocalStoreFailsStartupTest.java","lines":["@@ -0,0 +1,34 @@","+package io.quarkus.http.ratelimit;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.runtime.configuration.ConfigurationException;","+import io.quarkus.test.QuarkusExtensionTest;","+","+/**","+ * Lease mode needs a shared store; the validator's other lease bounds (lease-size, max-overdraft) are","+ * covered by its unit tests.","+ */","+public class LeaseWithLocalStoreFailsStartupTest {","+","+    private static final String PREFIX = \"quarkus.http.rate-limit.rules.api.\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest()","+            .overrideConfigKey(PREFIX + \"paths\", \"/*\")","+            .overrideConfigKey(PREFIX + \"phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"request-key\", \"ip\")","+            .overrideRuntimeConfigKey(PREFIX + \"permits\", \"10\")","+            .overrideRuntimeConfigKey(PREFIX + \"window\", \"1m\")","+            .overrideRuntimeConfigKey(PREFIX + \"lease-size\", \"2\")","+            .assertException(t -> assertThat(t).isInstanceOf(ConfigurationException.class)","+                    .hasMessageContaining(\"Rate limit rule 'api' lease-size requires a non-local store\"));","+","+    @Test","+    void startupFails() {","+        // the extension asserts the startup failure","+    }","+}"],"additions":34,"deletions":0,"trun