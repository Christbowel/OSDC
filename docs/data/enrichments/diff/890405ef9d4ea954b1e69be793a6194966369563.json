{"id":"890405ef9d4ea954b1e69be793a6194966369563","axis":"silent","repo":"quarkusio/quarkus","sha":"890405ef9d4ea954b1e69be793a6194966369563","parsed":{"files":[{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/CustomRefusalWriterTest.java","lines":["@@ -0,0 +1,139 @@","+package io.quarkus.http.ratelimit;","+","+import static io.restassured.RestAssured.given;","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.time.Duration;","+import java.util.List;","+import java.util.Optional;","+import java.util.UUID;","+import java.util.concurrent.CopyOnWriteArrayList;","+","+import jakarta.enterprise.event.Observes;","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.http.ratelimit.RateLimitRejectionInfo.Reason;","+import io.quarkus.test.QuarkusExtensionTest;","+import io.smallrye.common.annotation.Identifier;","+import io.smallrye.mutiny.Uni;","+import io.vertx.core.http.HttpMethod;","+import io.vertx.ext.web.RoutingContext;","+","+public class CustomRefusalWriterTest {","+    private static final String ROOT = \"quarkus.http.rate-limit.\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest app = rule(rule(rule(rule(rule(new QuarkusExtensionTest(), \"quota\"), \"key\"), \"limit\"),","+            \"store\"), \"lease\")","+            .withApplicationRoot(jar -> jar.addClasses(TestHttp.class, TestHttp.Resource.class, Limits.class, Keys.class,","+                    BrokenStore.class, Writer.class, Events.class))","+            .overrideConfigKey(ROOT + \"rules.key.request-key\", \"custom:broken\")","+            .overrideConfigKey(ROOT + \"rules.store.store\", \"broken\")","+            .overrideConfigKey(ROOT + \"rules.lease.store\", \"broken\")","+            .overrideRuntimeConfigKey(ROOT + \"rules.lease.lease-size\", \"1\")","+            .overrideRuntimeConfigKey(ROOT + \"store-failure-mode\", \"closed\");","+","+    private static QuarkusExtensionTest rule(QuarkusExtensionTest test, String name) {","+        return test.overrideConfigKey(ROOT + \"rules.\" + name + \".paths\", \"/\" + name + \"/*\")","+                .overrideConfigKey(ROOT + \"rules.\" + name + \".phase\", \"pre-authentication\")","+                .overrideConfigKey(ROOT + \"rules.\" + name + \".request-key\", \"header:X-Client\")","+                .overrideConfigKey(ROOT + \"rules.\" + name + \".limit-resolver\", \"plans\");","+    }","+","+    @Inject","+    Events events;","+","+    @Test","+    void writerAndEventsReceiveEveryRefusalWithTheAvailableContext() {","+        events.refusals.clear();","+        for (String rule : List.of(\"quota\", \"key\", \"limit\", \"store\", \"lease\")) {","+            String client = UUID.randomUUID().toString();","+            if (rule.equals(\"quota\")) {","+                given().header(\"X-Client\", client).get(\"/quota/x\").then().statusCode(200);","+            }","+            Reason reason = switch (rule) {","+                case \"quota\" -> Reason.LIMIT_EXCEEDED;","+                case \"key\" -> Reason.KEY_RESOLUTION_FAILED;","+                case \"limit\" -> Reason.LIMIT_RESOLUTION_FAILED;","+                default -> Reason.STORE_UNAVAILABLE;","+            };","+            int status = rule.equals(\"quota\") ? 429 : 503;","+            var response = given().header(\"X-Client\", client).get(\"/\" + rule + \"/x\");","+            assertThat(response.statusCode()).as(rule).isEqualTo(status);","+            assertThat(response.body().asString()).isEqualTo(\"custom refusal\");","+            assertThat(response.contentType()).startsWith(\"text/plain\");","+            assertThat(response.header(\"X-Reason\")).isEqualTo(reason.name());","+            assertThat(Long.parseLong(response.header(\"Retry-After\"))).isPositive();","+            assertThat(events.refusals).filteredOn(info -> info.rule().equals(rule)).singleElement().satisfies(info -> {","+                assertThat(info.reason()).isEqualTo(reason);","+                assertThat(info.statusCode()).isEqualTo(status);","+                assertThat(info.retryAfterSeconds()).isEqualTo(Long.parseLong(response.header(\"Retry-After\")));","+                assertThat(info.key().isPresent()).isEqualTo(!rule.equals(\"key\"));","+                if (rule.equals(\"key\") || rule.equals(\"limit\")) {","+                    assertThat(info.limit()).isEmpty();","+                } else {","+                    assertThat(info.limit()).contains(RateLimit.of(1, Duration.ofHours(1)));","+                }","+            });","+        }","+    }","+","+    @Test","+    void headStillUsesTheCustomWriterWithoutABody() {","+        var response = given().head(\"/key/x\");","+        assertThat(response.statusCode()).isEqualTo(503);","+        assertThat(response.header(\"X-Reason\")).isEqualTo(Reason.KEY_RESOLUTION_FAILED.name());","+        assertThat(response.body().asString()).isEmpty();","+    }","+","+    @Singleton","+    public static class Events {","+        final List<RateLimitRejectionInfo> refusals = new CopyOnWriteArrayList<>();","+","+        void observe(@Observes RateLimitRejectionInfo info) {","+            refusals.add(info);","+        }","+    }","+","+    @Singleton","+    public static class Writer implements RateLimitRejectionWriter {","+        @Override","+        public void write(RoutingContext context, RateLimitRejectionInfo info) {","+            context.response().setStatusCode(info.statusCode()).putHeader(\"Content-Type\", \"text/plain\")","+                    .putHeader(\"X-Reason\", info.reason().name());","+            context.response().end(context.request().method() == HttpMethod.HEAD ? \"\" : \"custom refusal\");","+        }","+    }","+","+    @Singleton","+    @Identifier(\"plans\")","+    public static class Limits implements RateLimitResolver {","+        @Override","+        public Uni<RateLimit> resolve(RateLimitContext context) {","+            return context.rule().equals(\"limit\") ? Uni.createFrom().failure(new IllegalStateException(\"lookup failed\"))","+                    : Uni.createFrom().item(RateLimit.of(1, Duration.ofHours(1)));","+        }","+    }","+","+    @Singleton","+    @Identifier(\"broken\")","+    public static class Keys implements RateLimitKeyResolver {","+        @Override","+        public Uni<Optional<String>> resolve(RateLimitContext context) {","+            return Uni.createFrom().failure(new IllegalStateException(\"missing tenant\"));","+        }","+    }","+","+    @Singleton","+    @Identifier(\"broken\")","+    public static class BrokenStore implements RateLimitStore {","+        @Override","+        public Uni<RateLimitDecision> tryConsume(String key, long cost, RateLimitPolicy policy) {","+            return Uni.createFrom().failure(new IllegalStateException(\"store down\"));","+        }","+    }","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/GlobalDefaultsTest.java","lines":["@@ -49,10 +49,10 @@ public class GlobalDefaultsTest {","                     .anySatisfy(m -> assertThat(m).isEqualTo(","                             \"Rate limit rule 'api': paths=[/api/*] methods=[] phase=pre-authentication\"","                                     + \" request-key=header:X-Client limit=RateLimit[permits=50, window=PT1M, burst=50] limit-resolver=- store=switchable\"","-                                    + \" max-keys=500\"))","+                                    + \" lease-size=- max-keys=500\"))","                     .anySatisfy(m -> assertThat(m).isEqualTo(","                             \"Rate limit rule 'admin': paths=[/admin/*] methods=[] phase=post-authentication request-key=ip\"","-                                    + \" limit=RateLimit[permits=10, window=PT1M, burst=10] limit-resolver=- store=local max-keys=20\")));","+                                    + \" limit=RateLimit[permits=10, window=PT1M, burst=10] limit-resolver=- store=local lease-size=- max-keys=20\")));"," ","     private static String format(LogRecord r) {","         return r.getParameters() == null ? r.getMessage() : String.format(r.getMessage(), r.getParameters());"],"additions":2,"deletions":2,"truncated":false},{"path":"extensions/http-rate-limit/deployment/src/test/java/io/quarkus/http/ratelimit/HttpRateLimitConfigValidatorTest.java","lines":["@@ -22,7 +22,7 @@"," /**","  * Runs the startup validator against configurations built with SmallRye Config, inside a Quarkus application so that the","  * runtime module needs no bytecode library to implement the {@code @ConfigMapping} in unit tests. The startup wiring of","- * the validator is covered by {@link RuleWithoutLimitFailsStartupTest}.","+ * the validator is covered by {@link LeaseWithLocalStoreFailsStartupTest}.","  */"," public class HttpRateLimitConfigValidatorTest {"," ","@@ -67,6 +67,10 @@ private static RateLimitRuleConfig rule(String... overrides) {","                 config.getConfigMapping(HttpRateLimitRuntimeConfig.class));","     }"," ","+    private static List<String> warnings(String... overrides) {","+        return HttpRateLimitConfigValidator.warnings(List.of(rule(overrides)));","+    }","+","     private static String g(String key) {","         return P + \"rules.api.\" + key;","     }","@@ -93,6 +97,8 @@ void globalDefaultsApplyUnlessTheRuleSetsItsOwn() {","         RateLimitRuleConfig defaults = rule();","         assertThat(defaults.store()).isEqualTo(\"local\");","         assertThat(defaults.maxKeys()).isEqualTo(100_000);","+        assertThat(defaults.leaseSize()).isEmpty();","+        assertThat(defaults.maxOverdraft()).isZero();"," ","         RateLimitRuleConfig global = rule(g(\"phase\"), null, g(\"request-key\"), null, P + \"phase\", \"post-authentication\",","                 P + \"request-key\",