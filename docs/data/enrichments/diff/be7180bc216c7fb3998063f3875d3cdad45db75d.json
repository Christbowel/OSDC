{"id":"be7180bc216c7fb3998063f3875d3cdad45db75d","axis":"silent","repo":"facebook/react-native","sha":"be7180bc216c7fb3998063f3875d3cdad45db75d","parsed":{"files":[{"path":"packages/react-native/src/private/testing/fantom/specs/NativeFantom.js","lines":["@@ -78,6 +78,7 @@ interface Spec extends TurboModule {","     viewportWidth: number,","     viewportHeight: number,","     devicePixelRatio: number,","+    fontScale: number,","     viewportOffsetX?: number,","     viewportOffsetY?: number,","   ) => RootTag;"],"additions":1,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/__docs__/README.md","lines":["@@ -92,6 +92,13 @@ describe('My feature', () => {"," });"," ```"," ","+Creating a root sets global `Dimensions` for both `window` and `screen` from its","+`viewportWidth`, `viewportHeight`, `devicePixelRatio`, and optional `fontScale`","+(default `1`). `useWindowDimensions()` and `PixelRatio` report the new root's","+values. If another root is still alive with different display metrics, Fantom","+applies the new values and emits a warning. Call `root.destroy()` when a root is","+no longer needed.","+"," For a full API reference, please see the [inline documentation](../src/index.js)"," defined for the methods in the `@react-native/fantom` [module](../src/index.js)."," "],"additions":7,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/src/__tests__/Fantom-itest.js","lines":["@@ -320,6 +320,8 @@ describe('Fantom', () => {","           viewportOffsetY: 102,","         },","       );","+      rootWithDefaults.destroy();","+      rootWithCustomWidthAndHeight.destroy();","     });"," ","     it('throws when trying to render a root outside of a task', () => {"],"additions":2,"deletions":0,"truncated":false},{"path":"private/react-native-fantom/src/__tests__/FantomDimensions-itest.js","lines":["@@ -0,0 +1,201 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ * @flow strict-local","+ * @format","+ */","+","+/* global console: writable */","+","+import '@react-native/fantom/src/setUpDefaultReactNativeEnvironment';","+","+import type {Root, RootConfig} from '@react-native/fantom';","+","+import * as Fantom from '@react-native/fantom';","+import * as React from 'react';","+import {Dimensions, PixelRatio, View, useWindowDimensions} from 'react-native';","+","+let roots: Array<Root>;","+let originalConsole: typeof console;","+let warn: JestMockFn<Array<unknown>, void>;","+","+beforeEach(() => {","+  roots = [];","+  originalConsole = console;","+  warn = jest.fn();","+  console = Object.create(originalConsole, {warn: {value: warn}});","+});","+","+afterEach(() => {","+  for (const root of roots) {","+    Fantom.runTask(() => root.render(<></>));","+    root.destroy();","+  }","+  console = originalConsole;","+});","+","+function createRoot(config?: RootConfig): Root {","+  const root = Fantom.createRoot(config);","+  roots.push(root);","+  return root;","+}","+","+component WindowMetrics() {","+  const {width, height, scale, fontScale} = useWindowDimensions();","+  return <View testID={`${width}x${height}@${scale}:${fontScale}`} />;","+}","+","+it('uses root defaults before any root is created', () => {","+  for (const dimension of ['window', 'screen']) {","+    const metrics = Dimensions.get(dimension);","+    expect(metrics.width).toBe(390);","+    expect(metrics.height).toBe(844);","+    expect(metrics.scale).toBe(3);","+    expect(metrics.fontScale).toBe(1);","+  }","+  expect(PixelRatio.get()).toBe(3);","+  expect(PixelRatio.getFontScale()).toBe(1);","+});","+","+it('sets default window and screen metrics', () => {","+  createRoot();","+  for (const dimension of ['window', 'screen']) {","+    const metrics = Dimensions.get(dimension);","+    expect(metrics.width).toBe(390);","+    expect(metrics.height).toBe(844);","+    expect(metrics.scale).toBe(3);","+    expect(metrics.fontScale).toBe(1);","+  }","+});","+","+it('sets custom viewport, pixel ratio, and font scale', () => {","+  createRoot({","+    viewportWidth: 640,","+    viewportHeight: 480,","+    devicePixelRatio: 2,","+    fontScale: 1.5,","+  });","+  for (const dimension of ['window', 'screen']) {","+    const metrics = Dimensions.get(dimension);","+    expect(metrics.width).toBe(640);","+    expect(metrics.height).toBe(480);","+    expect(metrics.scale).toBe(2);","+    expect(metrics.fontScale).toBe(1.5);","+  }","+  expect(PixelRatio.get()).toBe(2);","+  expect(PixelRatio.getFontScale()).toBe(1.5);","+});","+","+it('does not warn for matching metrics, including different viewport offsets', () => {","+  createRoot();","+  createRoot({viewportOffsetX: 20, viewportOffsetY: 90});","+  expect(warn).not.toHaveBeenCalled();","+});","+","+const conflictingConfigs: Array<[string, RootConfig]> = [","+  ['width', {viewportWidth: 402}],","+  ['height', {viewportHeight: 874}],","+  ['pixel ratio', {devicePixelRatio: 2}],","+  ['font scale', {fontScale: 1.5}],","+];","+","+for (const [name, config] of conflictingConfigs) {","+  it(`warns and applies new metrics when an active root has a different ${name}`, () => {","+    createRoot();","+    createRoot(config);","+    expect(warn).toHaveBeenCalledTimes(1);","+    expect(warn.mock.calls[0][0]).toContain('another active root');","+    const metrics = Dimensions.get('window');","+    expect(metrics.width).toBe(config.viewportWidth ?? 390);","+    expect(metrics.height).toBe(config.viewportHeight ?? 844);","+    expect(metrics.scale).toBe(config.devicePixelRatio ?? 3);","+    expect(metrics.fontScale).toBe(config.fontScale ?? 1);","+  });","+}","+","+it('checks all active roots, including one that differs from the latest root', () => {","+  createRoot();","+  createRoot({viewportWidth: 640});","+  createRoot({viewportWidth: 640});","+  expect(warn).toHaveBeenCalledTimes(2);","+  expect(Dimensions.get('window').width).toBe(640);","+});","+","+it('does not warn for a destroyed root', () => {","+  const first = createRoot();","+  first.destroy();","+  roots.shift();","+  createRoot({viewportWidth: 640});","+  expect(warn).not.toHaveBeenCalled();","+});","+","+it('restores the latest surviving root and then defaults when all roots are destroyed', () => {","+  const first = createRoot();","+  const second = createRoot({","+    viewportWidth: 640,","+    viewportHeight: 480,","+    devicePixelRatio: 2,","+    fontScale: 1.5,","+  });","+  const third = createRoot({viewportWidth: 900});","+  third.destroy();","+  roots.pop();","+  for (const dimension of ['window', 'screen']) {","+    const metrics = Dimensions.get(dimension);","+    expect(metrics.width).toBe(640);","+    expect(metrics.height).toBe(480);","+    expect(metrics.scale).toBe(2);","+    expect(metrics.fontScale).toBe(1.5);","+  }","+  first.destroy();","+  roots.shift();","+  for (const dimension of ['window', 'screen']) {","+    const metrics = Dimensions.get(dimension);","+    expect(metrics.width).toBe(640);","+    expect(metrics.height).toBe(480);","+    expect(metrics.scale).toBe(2);","+    expect(metrics.fontScale).toBe(1.5);","+  }","+  second.destroy();","+  roots.pop();","+  for (const dimension of ['window', 'screen']) {","+    const metrics = Dimensions.get(dimension);","+    expect(metrics.width).toBe(390);","+    expect(metrics.height).toBe(844);","+    expect(metrics.scale).toBe(3);","+    expect(metrics.fontScale).toBe(1);","+  }","+  expect(PixelRatio.get()).toBe(3);","+  expect(PixelRatio.getFontScale()).toBe(1);","+});","+","+it('notifies mounted components when another root changes the metrics', () => {","+  const first = createRoot();","+  Fantom.runTask(() => first.render(<WindowMetrics />));","+  expect(first.getRenderedOutput({props: ['testID']}).toJSX()).toEqual(","+    <rn-view testID=\"390x844@3:1\" />,","+  );","+  const second = createRoot({","+    viewportWidth: 640,","+    vi