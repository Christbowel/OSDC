{"id":"cba2a290b8bc81475b1dabccf24ea46ad539b451","axis":"silent","repo":"pnpm/pnpm","sha":"cba2a290b8bc81475b1dabccf24ea46ad539b451","parsed":{"files":[{"path":".changeset/node-linker-settings.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`nodeLinker` accepts object settings for isolated and hoisted installs. Linker-specific hoisting options can be configured alongside the selected linker."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks.rs","lines":["@@ -549,4 +549,5 @@ fn adopt_hook_catalogs(config: &mut Config, current: &Value) -> Result<()> {"," "," mod apply;"," mod catalogs;","+mod node_linker_aliases;"," mod package_settings;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks/apply.rs","lines":["@@ -88,6 +88,7 @@ fn filter_hook_delta(config: &Config, mut delta: Value) -> Value {","             !config.cli_settings.contains(key)","                 && !config.cli_settings.contains(&pnpm_config::naming_cases::to_camel_case(key))","         });","+        super::node_linker_aliases::drop_cli_linker_aliases(config, delta);","     }","     delta"," }","@@ -139,6 +140,7 @@ pub(super) fn apply_hook_delta(","     config.apply_cli_registries();","     apply_hook_execution_changes(config, execution_changes, script_shell_deleted);","     restore_defaults_of_nulled_settings(config, &delta, base_dir);","+    super::node_linker_aliases::reapply_linker_options(config, &delta);","     let node_path_refresh = lockfile_dir_paths_before_hook.map(|paths_before_hook| {","         apply_lockfile_dir_change(config, paths_before_hook)","     });","@@ -349,6 +351,9 @@ fn record_explicit_setting_changes(","         .map(|(key, _)| key)","     {","         if is_known_setting_key(key) {","+            if key == \"nodeLinker\" {","+                config.forget_node_linker_aliases();","+            }","             config.explicit_settings.remove(key);","         }","     }"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks/node_linker_aliases.rs","lines":["@@ -0,0 +1,108 @@","+//! A `nodeLinker` object option and its flat alias name one setting, so a","+//! command-line choice made in either spelling is protected from an","+//! `updateConfig` hook that uses the other.","+","+use pnpm_config::{","+    Config,","+    NodeLinkerSetting,","+};","+use serde_json::{","+    Map,","+    Value,","+};","+","+const HOIST_LISTS: [&str; 2] = [\"private\", \"public\"];","+","+/// Drop the hook's changes to settings the command line set in the other","+/// spelling.","+pub(super) fn drop_cli_linker_aliases(config: &Config, delta: &mut Map<String, Value>) {","+    if let Some(Value::Object(linker)) = delta.get_mut(\"nodeLinker\") {","+        drop_cli_set_options(config, linker);","+    }","+    if !config.cli_settings.contains(\"nodeLinker\") {","+        return;","+    }","+    let Some(cli_linker) = config.explicit_settings.get(\"nodeLinker\") else { return };","+    for option in options_set(cli_linker) {","+        for key in flat_aliases(option) {","+            delta.remove(*key);","+        }","+    }","+}","+","+/// Reapply the hook's `nodeLinker` object, whose options win over a flat","+/// alias the same hook set to null and that was reset to its default.","+pub(super) fn reapply_linker_options(config: &mut Config, delta: &Value) {","+    let Some(linker) = delta.get(\"nodeLinker\").filter(|linker| linker.is_object()) else {","+        return;","+    };","+    if let Ok(setting) = serde_json::from_value::<NodeLinkerSetting>(linker.clone()) {","+        setting.apply_to(config);","+    }","+}","+","+fn drop_cli_set_options(config: &Config, linker: &mut Map<String, Value>) {","+    let set_on_cli = |option: &str| {","+        flat_aliases(option)","+            .iter()","+            .any(|key| config.cli_settings.contains(*key))","+    };","+    // `hoist: true` and `hoist: false` set both lists at once, so split","+    // them to keep the list the command line left alone.","+    if let Some(&Value::Bool(enabled)) = linker.get(\"hoist\")","+        && HOIST_LISTS.into_iter().any(set_on_cli)","+    {","+        linker.insert(\"hoist\".to_string(), hoist_lists(enabled));","+    }","+    if let Some(Value::Object(hoist)) = linker.get_mut(\"hoist\") {","+        hoist.retain(|option, _| !set_on_cli(option));","+    }","+    if set_on_cli(\"hoistingLimits\") {","+        linker.remove(\"hoistingLimits\");","+    }","+}","+","+fn hoist_lists(enabled: bool) -> Value {","+    let (private, public) = if enabled {","+        let defaults = Config::default();","+        (defaults.hoist_pattern, defaults.public_hoist_pattern)","+    } else {","+        (Some(Vec::new()), Some(Vec::new()))","+    };","+    serde_json::json!({\"private\": private, \"public\": public})","+}","+","+/// The options a `nodeLinker` value sets.","+fn options_set(linker: &Value) -> Vec<&'static str> {","+    let mut options = Vec::new();","+    match linker.get(\"hoist\") {","+        Some(Value::Bool(_)) => options.extend(HOIST_LISTS),","+        Some(Value::Object(hoist)) => options.extend(","+            HOIST_LISTS","+                .into_iter()","+                .filter(|list| hoist.get(*list).is_some_and(is_set)),","+        ),","+        _ => {}","+    }","+    if linker.get(\"hoistingLimits\").is_some_and(is_set) {","+        options.push(\"hoistingLimits\");","+    }","+    options","+}","+","+fn is_set(value: &Value) -> bool {","+    !value.is_null()","+}","+","+/// The flat settings that a `nodeLinker` option aliases.","+fn flat_aliases(option: &str) -> &'static [&'static str] {","+    match option {","+        \"private\" => &[\"hoist\", \"hoistPattern\"],","+        \"public\" => &[\"publicHoistPattern\", \"shamefullyHoist\"],","+        \"hoistingLimits\" => &[\"hoistingLimits\"],","+        _ => &[],","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":108,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks/node_linker_aliases/tests.rs","lines":["@@ -0,0 +1,71 @@","+use super::{","+    drop_cli_linker_aliases,","+    reapply_linker_options,","+};","+use pnpm_config::Config;","+use pretty_assertions::assert_eq;","+use serde_json::{","+    Map,","+    Value,","+    json,","+};","+","+fn delta(value: Value) -> Map<String, Value> {","+    let Value::Object(map) = value else { panic!(\"delta must be an object\") };","+    map","+}","+","+#[test]","+fn a_cli_flat_setting_protects_the_matching_linker_option() {","+    let config =","+        Config { cli_settings: [\"publicHoistPattern\".to_string()].into(), ..Config::default() };","+    let mut changes = delta(json!({","+        \"nodeLinker\": {\"type\": \"isolated\", \"hoist\": {\"public\": [\"hook\"], \"private\": [\"hook\"]}},","+    }));","+    drop_cli_linker_aliases(&config, &mut changes);","+    assert_eq!(","+        Value::Object(changes),","+        json!({\"nodeLinker\": {\"type\": \"isolated\", \"hoist\": {\"private\": [\"hook\"]}}}),","+    );","+}","+","+#[test]","+fn a_boolean_hoist_keeps_the_list_the_cli_left_alone() {","+    let config =","+        Config { cli_settings: [\"publicHoistPattern\".to_string()].into(), ..Config::default() };","+    let mut changes = delta(json!({\"nodeLinker\": {\"type\": \"isolated\", \"hoist\": false}}));","+    drop_cli_linker_aliases(&config, &mut changes);","+    assert_eq!(","+        Value::Object(changes),","+        json!({\"nodeLinker\": {\"type\": \"isolated\", \"hoist\": {\"private\": []}}}),","+    );","+}","+","+#[test]","+fn a_cli_linker_object_protects_the_flat_aliases_it_sets() {","+    let config = Config {","+        cli_settings: [\"nodeLinker\".to_string()].into(),","+        explicit_settings: Map::from_iter([(","+            \"nodeLinker\".to_string(),","+            json!({\"type\": \"isolated\", \"hoist\": {\"public\": [\"cli\"]}}),","+        )]),","+        ..Config::default()","+    };","+    let mut changes = delta(json!({","+        \"publicHoistPattern\": [\"hook\"],","+        \"shamefullyHoist\": true,","+        \"hoistPattern\": [\"hook\"],","+    }));","+    drop_cli_linker_aliases(&config, &mut changes);","+    assert_eq!(Value::Object(changes), json!({\"hoistPattern\": [\"hook\"]}));","+}","+","+#[test]","+fn linker_options_win_over_a_flat_alias_the_same_hook_nulled() {","+    let mut config = Config { hoist_pattern: Some(vec![\"*\".to_string()]), ..Config::default() };","+    reapply_linker_options(","+        &mut config,","+        &json!({\"hoistPattern\": null, \"nodeLinker\": {\"type\": \"isolated\", \"hoist\": {\"private\": [\"selected\"]}}}),","+    );","+    assert_eq!(config.hoist_pattern, Some(vec![\"selected\".to_string()]));","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/apply.rs","lines":["@@ -354,6 +354,10 @@ impl ConfigOverrides {","         if let Some(value) = &self.node_linker {","             value.clone().apply_to(config);","             config.explicit_settings.insert(\"nodeLinker\".to_string(), setting_value(value));","+            // The linker's hoist patterns land after the hoist overrides","+            // ran these derivations.","+            config.apply_shamefully_hoist_derivation();","+            config.apply_virtual_store_only_derivation();","             // A CLI-selected hoisted linker turns the default on just","             // like a yaml-selected one, pnpm merges CLI options before","             // its `nodeLinker` switch, so the derivation must see this"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests.rs","lines":["@@ -654,6 +654,24 @@ fn a_repeated_list_setting_accumulates_its_values() {","     assert_eq!(config.public_hoist_pattern, Some(vec![\"types\".to_string()]));"," }"," ","+#[test]","+fn a_cli_linker_object_keeps_virtual_store_only_patterns_empty() {","+    let (overrides, _) = ConfigOverrides::extract(argv([","+        \"pacquet\",","+        \"install\",","+        \"--virtual-store-only\",","+        r#\"--config.node-linker={\"type\":\"isolated\",\"hoist\":{\"public\":[\"eslint\"],\"private\":[\"*\"]}}\"#,","+    ]));","+    let mut config = Config::default();","+    overrides.apply(&mut config, Path::new(\"/workspace\"));","+    assert_eq!(config.hoist_pattern, Some(vec![]));","+    assert_eq!(config.public_hoist_pattern, Some(vec![]));","+    config.virtual_store_only = false;","+    config.restore_hoist_patterns_after_virtual_store_only();","+    assert_eq!(config.hoist_pattern, Some(vec![\"*\".to_string()]));","+    assert_eq!(config.public_hoist_pattern, Some(vec![\"eslint\".to_string()]));","+}","+"," /// `pnpm clean --lockfile` removes lockfiles; it does not turn the"," /// `lockfile` setting on."," #[test]"],"additions":18,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/layout.rs","lines":["@@ -486,13 +486,21 @@ impl Config {","     ///","     /// This runs after all config sources have been merged because an explicit","     /// `shamefullyHoist` value takes precedence over `publicHoistPattern`","-    /// regardless of which source supplied either setting.","+    /// regardless of which source supplied either setting. While","+    /// `virtualStoreOnly` keeps the active pattern empty, it applies to the","+    /// pattern that mode restores.","     pub fn apply_shamefully_hoist_derivation(&mut self) {","-        match self.explicit_settings.get(\"shamefullyHoist\").and_then(serde_json::Value::as_bool) {","-            Some(true) => self.public_hoist_pattern = Some(vec![\"*\".to_string()]),","-            Some(false) => self.public_hoist_pattern = None,","-            None => {}","-        }","+        let Some(shamefully_hoist) =","+            self.explicit_settings.get(\"shamefullyHoist\").and_then(serde_json::Value::as_bool)","+        else {","+            return;","+        };","+        let public_hoist_pattern =","+            match self.hoist_patterns_before_virtual_store_only.as_mut() {","+                Some(saved) => &mut saved.public_hoist_pattern,","+                None => &mut self.public_hoist_pattern,","+            };","+        *public_hoist_pattern = shamefully_hoist.then(|| vec![\"*\".to_string()]);","     }"," ","     /// Turn [`prefer_symlinked_executables`] on when the hoisted"],"additions":14,"deletions":6,"truncated":false},{"path":"pnpm/crates/config/src/lib.rs","lines":["@@ -73,6 +73,8 @@ pub use global_packages::GLOBAL_PACKAGES_UNSUPPORTED_KEYS;"," pub use loading::ConfigLoadFailure;"," pub use macos_backup::MacosBackupConfig;"," pub use node_linker::{","+    HoistSetting,","+    NodeLinkerHoistPatterns,","     NodeLinkerOptions,","     NodeLinkerSetting,"," };","@@ -393,6 +395,9 @@ fn collect_explicit_settings(","     if let Some(section) = settings.node_package_map {","         mirror_node_package_map(target, section);","     }","+    if let Some(node_linker) = &settings.node_linker {","+        node_linker.mirror_flat_aliases(target);","+    }","     // `audit.level` supersedes the deprecated `auditLevel` spelling; mirror it","     // there so `config get audit-level` answers the way pnpm does.","     if let Some(level) = settings.audit.as_ref().and_then(|audit| audit.level) {"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/node_linker.rs","lines":["@@ -1,28 +1,115 @@"," use crate::{","     Config,","+    HoistingLimits,","     NodeLinker,"," };"," use serde::{","     Deserialize,","     Serialize,","+    de::{","+        MapAccess,","+        Visitor,","+        value::MapAccessDeserializer,","+    },"," };","+use std::fmt;"," ","-#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]","+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]"," #[serde(untagged)]"," pub enum NodeLinkerSetting {","     Type(NodeLinker),","     Options(NodeLinkerOptions),"," }"," ","+impl<'de> Deserialize<'de> for NodeLinkerSetting {","+    fn deserialize<Deserializer>(deserializer: Deserializer) -> Result<Self, Deserializer::Error>","+    where","+        Deserializer: serde::Deserializer<'de>,","+    {","+        deserializer.deserialize_any(NodeLinkerSettingVisitor)","+    }","+}","+","+struct NodeLinkerSettingVisitor;","+","+impl<'de> Visitor<'de> for NodeLinkerSettingVisitor {","+    type Value = NodeLinkerSetting;","+","+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {","+        formatter.write_str(\"a linker name or an object with linker options\")","+    }","+","+    fn visit_str<Error>(self, value: &str) -> Result<Self::Value, Error>","+    where","+        Error: serde::de::Error,","+    {","+        let linker = match value {","+            \"isolated\" => NodeLinker::Isolated,","+            \"hoisted\" => NodeLinker::Hoisted,","+            \"pnp\" => NodeLinker::Pnp,","+            \"loaded\" => NodeLinker::Loaded,","+            _ => {","+                return Err(Error::unknown_variant(","+                    value,","+                    &[\"isolated\", \"hoisted\", \"pnp\", \"loaded\"],","+                ));","+            }","+        };","+        Ok(NodeLinkerSetting::Type(linker))","+    }","+","+    fn visit_string<Error>(self, value: String) -> Result<Self::Value, Error>","+    where","+        Error: serde::de::Error,","+    {","+        self.visit_str(&value)","+    }","+","+    fn visit_map<Map>(self, map: Map) -> Result<Self::Value, Map::Error>","+    where","+        Map: MapAccess<'de>,","+    {","+        NodeLinkerOptions::deserialize(MapAccessDeserializer::new(map))","+            .map(NodeLinkerSetting::Options)","+    }","+}","+"," #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]"," #[serde(tag = \"type\", rename_all = \"kebab-case\", deny_unknown_fields)]"," pub enum NodeLinkerOptions {","+    Isolated {","+        #[serde(default)]","+        hoist: Option<HoistSetting>,","+    },","+    Hoisted {","+        #[serde(default)]","+        #[serde(rename = \"hoistingLimits\")]","+        hoisting_limits: Option<HoistingLimits>,","+    },","+    Pnp {","+        #[serde(default, skip_serializing_if = \"Option::is_none\")]","+        _marker: Option<()>,","+    },","     Loaded {","         #[serde(default)]","         excluded: Vec<String>,","     },"," }"," ","+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]","+#[serde(untagged)]","+pub enum HoistSetting {","+    Enabled(bool),","+    Patterns(NodeLinkerHoistPatterns),","+}","+","+#[derive(Debug, Default, Clone, PartialEq, Eq, Serialize, Deserialize)]","+#[serde(rename_all = \"camelCase\", deny_unknown_fields)]","+pub struct NodeLinkerHoistPatterns {","+    pub public: Option<Vec<String>>,","+    pub private: Option<Vec<String>>,","+}","+"," impl From<NodeLinker> for NodeLinkerSetting {","     fn from(linker: NodeLinker) -> Self {","         Self::Type(linker)","@@ -30,26 +117,178 @@ impl From<NodeLinker> for NodeLinkerSetting {"," }"," "," impl NodeLinkerSetting {","-    /// Replace the selected linker and its exclusions together.","+    /// Apply the selected linker and its options.","     pub fn apply_to(self, config: &mut Config) {","-        let (linker, excluded) = match self {","-            Self::Type(linker) => (linker, Vec::new()),","-            Self::Options(NodeLinkerOptions::Loaded { excluded }) => (NodeLinker::Loaded, excluded),","-        };","-        config.node_linker = linker;","-        config.node_linker_excluded = excluded;","+        match self {","+            Self::Type(linker) => select_linker(config, linker),","+            Self::Options(NodeLinkerOptions::Isolated { hoist }) => {","+                select_linker(config, NodeLinker::Isolated);","+                apply_isolated_hoist(config, hoist);","+            }","+            Self::Options(NodeLinkerOptions::Hoisted { hoisting_limits }) => {","+                select_linker(config, NodeLinker::Hoisted);","+                apply_hoisting_limits(config, hoisting_limits);","+            }","+            Self::Options(NodeLinkerOptions::Pnp { .. }) => select_linker(config, NodeLinker::Pnp),","+            Self::Options(NodeLinkerOptions::Loaded { excluded }) => {","+                select_linker(config, NodeLinker::Loaded);","+                config.node_linker_excluded = excluded;","+            }","+        }","     }"," ","+    /// The object form for the isolated and hoisted linkers only when a","+    /// source used it, so existing `updateConfig` hooks still see a string.","     pub(crate) fn from_resolved(config: &Config) -> Self {","-        if config.node_linker == NodeLinker::Loaded {","-            Self::Options(NodeLinkerOptions::Loaded {","+        let configured_as_object =","+            config.explicit_settings.get(\"nodeLinker\").is_some_and(serde_json::Value::is_object);","+        match config.node_linker {","+            NodeLinker::Isolated | NodeLinker::Hoisted if !configured_as_object => {","+                Self::Type(config.node_linker)","+            }","+            NodeLinker::Isolated => {","+                Self::Options(NodeLinkerOptions::Isolated { hoist: Some(resolved_hoist(config)) })","+            }","+            NodeLinker::Hoisted => Self::Options(NodeLinkerOptions::Hoisted {","+                hoisting_limits: Some(config.hoisting_limits),","+            }),","+            NodeLinker::Loaded => Self::Options(NodeLinkerOptions::Loaded {","                 excluded: config.node_linker_excluded.clone(),","-            })","-        } else {","-            Self::Type(config.node_linker)","+            }),","+            NodeLinker::Pnp => Self::Type(NodeLinker::Pnp),","         }","     }"," }"," ","+impl NodeLinkerSetting {","+    /// Mirror the linker options into the flat settings they alias, the","+    /// way the settings resolve them, so code that reads a flat setting","+    /// sees the object form too.","+    pub(crate) fn mirror_flat_aliases(","+        &self,","+        target: &mut serde_json::Map<String, serde_json::Value>,","+    ) {","+        match self {","+            Self::Options(NodeLinkerOptions::Isolated { hoist: Some(hoist) }) => {","+                mirror_hoist(hoist, target);","+            }","+            Self::Options(NodeLinkerOptions::Hoisted { hoisting_limits: Some(limits) }) => {","+                if let Ok(limits) = serde_json::to_value(limits) {","+                    target.insert(\"hoistingLimits\".to_string(), limits);","+                }","+            }","+            _ => {}","+        }","+    }","+}","+","+impl Config {","+    /// Drop the flat settings that mirror the recorded `nodeLinker` object","+    /// before that object is unset. A flat setting a source set to a","+    /// different value stays.","+    pub fn forget_node_linker_aliases(&mut self) {","+        let Some(linker) = self.explicit_settings.get(\"nodeLinker\").cloned() else { return };","+        let Ok(linker) = serde_json::from_value::<NodeLinkerSetting>(linker) else { return };","+        let mut mirrored = serde_json::Map::new();","+        linker.mirror_flat_aliases(&mut mirrored);","+        for (key, value) in mirrored {","+            if self.explicit_settings.get(&key) == Some(&value) {","+                self.explicit_settings.remove(&key);","+            }","+        }","+    }","+}","+","+fn mirror_hoist(hoist: &HoistSetting, target: &mut serde_json::Map<String, serde_json::Value>) {","+    let (private, public) = match hoist {","+        HoistSetting::Enabled(false) => (Some(Vec::new()), Some(Vec::new())),","+        HoistSetting::Enabled(true) => {","+            (Some(crate::default_hoist_pattern()), Some(crate::default_public_hoist_pattern()))","+        }","+        HoistSetting::Patterns(patterns) => (patterns.private.clone(), patterns.public.clone()),","+    };","+    if matches!(hoist, HoistSetting::Enabled(false)) {","+        target.insert(\"hoist\".to_string(), false.into());","+    } else if private","+        .as_ref()","+        .is_some_and(|private| !private.is_empty())","+    {","+        target.insert(\"hoist\".to_string(), true.into());","+    }","+    if let Some(private) = private {","+        target.insert(\"hoistPattern\".to_string(), private.into());","+    }","+    if let Some(public) = public {","+        target.insert(\"publicHoistPattern\".to_string(), public.into());","+    }","+}","+","+fn select_linker(config: &mut Config, linker: NodeLinker) {","+    config.node_linker = linker;","+    config.node_linker_excluded.clear();","+}","+","+/// The patterns that `virtualStoreOnly` restores when it ends, and","+/// `hoist: false` only when public hoisting is off too, so a round trip","+/// keeps public-only hoisting.","+fn resolved_hoist(config: &Config) -> HoistSetting {","+    let (private, public) = match &config.hoist_patterns_before_virtual_store_only {","+        Some(saved) => (&saved.hoist_pattern, &saved.public_hoist_pattern),","+        None => (&config.hoist_pattern, &config.public_hoist_pattern),","+    };","+    let hoists_publicly = public","+        .as_ref()","+        .is_some_and(|patterns| !patterns.is_empty());","+    if !config.hoist && !hoists_publicly {","+        return HoistSetting::Enabled(false);","+    }","+    HoistSetting::Patterns(NodeLinkerHoistPatterns {","+        public: public.clone(),","+        private: if config.hoist { private.clone() } else { Some(Vec::new()) },","+    })","+}","+","+/// While `virtualStoreOnly` keeps the active patterns empty, the patterns","+/// go to the snapshot it restores when it ends.","+fn apply_isolated_hoist(config: &mut Config, hoist: Option<HoistSetting>) {","+    let Some(hoist) = hoist else { return };","+    let (private, public) =","+        match config.hoist_patterns_before_virtual_store_only.as_mut() {","+            Some(saved) => (&mut saved.hoist_pattern, &mut saved.public_hoist_pattern),","+            None => (&mut config.hoist_pattern, &mut config.public_hoist_pattern),","+        };","+    match hoist {","+        HoistSetting::Enabled(false) => {","+            config.hoist = false;","+            *private = None;","+            *public = None;","+        }","+        HoistSetting::Enabled(true) => {","+            config.hoist = true;","+            *private = Some(crate::default_hoist_pattern());","+            *public = Some(crate::default_public_hoist_pattern());","+        }","+        HoistSetting::Patterns(patterns) => {","+            if let Some(patterns) = patterns.private {","+                // An empty list hoists nothing without turning `hoist` off,","+                // so a higher-priority `hoistPattern` still applies.","+                if !patterns.is_empty() {","+                    config.hoist = true;","+                }","+                *private = Some(patterns);","+            }","+            if let Some(patterns) = patterns.public {","+                *public = Some(patterns);","+            }","+        }","+    }","+}","+","+fn apply_hoisting_limits(config: &mut Config, hoisting_limits: Option<HoistingLimits>) {","+    if let Some(hoisting_limits) = hoisting_limits {","+        config.hoisting_limits = hoisting_limits;","+    }","+}","+"," #[cfg(test)]"," mod tests;"],"additions":252,"deletions":13,"truncated":false},{"path":"pnpm/crates/config/src/node_linker/tests.rs","lines":["@@ -1,5 +1,6 @@"," use crate::{","     Config,","+    HoistingLimits,","     NodeLinker,","     TrustedSettings,","     WorkspaceSettings,","@@ -41,6 +42,7 @@ fn scalar_linkers_and_loaded_object_without_exclusions_are_supported() {","         (json!(\"isolated\"), NodeLinker::Isolated),","         (json!(\"hoisted\"), NodeLinker::Hoisted),","         (json!(\"pnp\"), NodeLinker::Pnp),","+        (json!({\"type\": \"pnp\"}), NodeLinker::Pnp),","         (json!(\"loaded\"), NodeLinker::Loaded),","         (json!({\"type\": \"loaded\"}), NodeLinker::Loaded),","     ] {","@@ -57,17 +59,190 @@ fn scalar_linkers_and_loaded_object_without_exclusions_are_supported() {"," fn node_linker_objects_reject_invalid_and_not_yet_supported_options() {","     for value in [","         json!({\"excluded\": [\"vitest\"]}),","+        json!([\"hoisted\"]),","         json!({\"type\": \"unknown\"}),","         json!({\"type\": \"loaded\", \"exclude\": [\"vitest\"]}),","         json!({\"type\": \"loaded\", \"excluded\": \"vitest\"}),","         json!({\"type\": \"loaded\", \"excluded\": [false]}),","         json!({\"type\": \"loaded\", \"hoist\": false}),","-        json!({\"type\": \"isolated\", \"hoist\": {\"public\": []}}),","+        json!({\"type\": \"loaded\", \"hoist\": {\"public\": []}}),","+        json!({\"type\": \"hoisted\", \"hoistingLimits\": \"invalid\"}),","+        json!({\"type\": \"hoisted\", \"hoist\": false}),","+        json!({\"type\": \"isolated\", \"hoistingLimits\": \"workspaces\"}),","+        json!({\"type\": \"pnp\", \"hoist\": false}),","+        json!({\"type\": \"isolated\", \"hoist\": {\"public\": [false]}}),","     ] {","         assert!(serde_json::from_value::<WorkspaceSettings>(json!({\"nodeLinker\": value})).is_err());","     }"," }"," ","+#[test]","+fn node_linker_rejects_sequence_syntax() {","+    assert!(serde_saphyr::from_str::<WorkspaceSettings>(\"nodeLinker: [hoisted]\\n\").is_err());","+}","+","+#[test]","+fn isolated_object_applies_private_and_public_hoist_patterns() {","+    let settings: WorkspaceSettings = serde_saphyr::from_str(","+        \"nodeLinker:\\n  type: isolated\\n  hoist:\\n    public: []\\n    private: ['*']\\n\",","+    )","+    .unwrap();","+    let mut config = Config::default();","+    settings.apply_to(&mut config, Path::new(\".\"));","+    assert_eq!(config.node_linker, NodeLinker::Isolated);","+    assert_eq!(config.public_hoist_pattern, Some(vec![]));","+    assert_eq!(config.hoist_pattern, Some(vec![\"*\".to_string()]));","+}","+","+#[test]","+fn hoisted_object_applies_hoisting_limits() {","+    let settings: WorkspaceSettings =","+        serde_saphyr::from_str(\"nodeLinker:\\n  type: hoisted\\n  hoistingLimits: workspaces\\n\")","+            .unwrap();","+    let mut config = Config::default();","+    settings.apply_to(&mut config, Path::new(\".\"));","+    assert_eq!(config.node_linker, NodeLinker::Hoisted);","+    assert_eq!(config.hoisting_limits, HoistingLimits::Workspaces);","+}","+","+#[test]","+fn linker_options_round_trip_through_resolved_settings() {","+    for settings_yaml in [","+        \"nodeLinker:\\n  type: isolated\\n  hoist:\\n    public: ['eslint']\\n    private: []\\n\",","+        \"nodeLinker:\\n  type: hoisted\\n  hoistingLimits: dependencies\\n\",","+    ] {","+        let settings: WorkspaceSettings = serde_saphyr::from_str(settings_yaml).unwrap();","+        let mut config = Config::default();","+        settings.apply_to(&mut config, Path::new(\".\"));","+        let reported = serde_json::to_value(WorkspaceSettings::from_resolved(&config)).unwrap();","+        let mut restored = Config::default();","+        serde_json::from_value::<WorkspaceSettings>(reported)","+            .unwrap()","+            .apply_to(&mut restored, Path::new(\".\"));","+        assert_eq!(restored.node_linker, config.node_linker);","+        assert_eq!(restored.hoist_pattern, config.hoist_pattern);","+        assert_eq!(restored.public_hoist_pattern, config.public_hoist_pattern);","+        assert_eq!(restored.hoisting_limits, config.hoisting_limits);","+    }","+}","+","+#[test]","+fn public_only_hoisting_survives_a_resolved_settings_round_trip() {","+    let settings: WorkspaceSettings =","+        serde_saphyr::from_str(\"hoist: false\\npublicHoistPattern: ['eslint']\\n\").unwrap();","+    let mut config = Config::default();","+    settings.apply_to(&mut config, Path::new(\".\"));","+    let reported = serde_json::to_value(WorkspaceSettings::from_resolved(&config)).unwrap();","+    let mut restored = Config::default();","+    serde_json::from_value::<WorkspaceSettings>(reported)","+        .unwrap()","+        .apply_to(&mut restored, Path::new(\".\"));","+    assert_eq!(restored.public_hoist_pattern, Some(vec![\"eslint\".to_string()]));","+    assert!(restored.hoist_pattern.unwrap_or_default().is_empty());","+}","+","+#[test]","+fn linker_options_under_virtual_store_only_go_to_the_restored_patterns() {","+    let mut config = Config { virtual_store_only: true, ..Config::default() };","+    config.apply_virtual_store_only_derivation();","+    serde_saphyr::from_str::<WorkspaceSettings>(","+        \"nodeLinker:\\n  type: isolated\\n  hoist:\\n    public: ['eslint']\\n\",","+    )","+    .unwrap()","+    .apply_to(&mut config, Path::new(\".\"));","+    assert_eq!(config.public_hoist_pattern, Some(vec![]));","+    config.virtual_store_only = false;","+    config.restore_hoist_patterns_after_virtual_store_only();","+    assert_eq!(config.public_hoist_pattern, Some(vec![\"eslint\".to_string()]));","+}","+","+#[test]","+fn resetting_node_linker_drops_its_patterns_from_the_virtual_store_only_snapshot() {","+    let defaults = Config::default();","+    let mut config = Config { virtual_store_only: true, ..Config::default() };","+    serde_saphyr::from_str::<WorkspaceSettings>(","+        \"nodeLinker:\\n  type: isolated\\n  hoist:\\n    public: ['eslint']\\n\",","+    )","+    .unwrap()","+    .apply_to(&mut config, Path::new(\".\"));","+    config.apply_virtual_store_only_derivation();","+    config.explicit_settings.remove(\"nodeLinker\");","+    WorkspaceSettings::reset_setting_to_default::<crate::Host>(","+        &mut config,","+        &defaults,","+        \"nodeLinker\",","+        Path::new(\".\"),","+    );","+    config.virtual_store_only = false;","+    config.restore_hoist_patterns_after_virtual_store_only();","+    assert_eq!(config.public_hoist_pattern, defaults.public_hoist_pattern);","+}","+","+#[test]","+fn object_options_win_over_flat_aliases_from_the_same_source() {","+    let settings: WorkspaceSettings = serde