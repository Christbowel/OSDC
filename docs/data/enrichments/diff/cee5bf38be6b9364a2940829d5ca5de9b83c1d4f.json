{"id":"cee5bf38be6b9364a2940829d5ca5de9b83c1d4f","axis":"silent","repo":"mlflow/mlflow","sha":"cee5bf38be6b9364a2940829d5ca5de9b83c1d4f","parsed":{"files":[{"path":"mlflow/environment_variables.py","lines":["@@ -950,10 +950,18 @@ def get(self):","     \"MLFLOW_GENAI_EVAL_PREDICT_RATE_LIMIT\", str, \"auto\""," )"," ","-#: Maximum scorer calls per second during mlflow.genai.evaluate. A token-bucket","-#: rate limiter throttles individual scorer invocations across all worker threads.","-#: Accepted values: a positive number (fixed rate) or ``0`` to disable.","+#: Shared scorer budget per second during mlflow.genai.evaluate. A token-bucket","+#: rate limiter throttles scorer invocations across all worker threads.","+#: Accepted values: ``auto`` (adaptive rate starting at 10 rps), a positive number","+#: (fixed rate), or ``0`` to disable. The token bucket allows a one-second burst."," #: When unset, the scorer rate is auto-derived as predict_rate x num_scorers.","+#:","+#: [Databricks users only] With databricks-agents SDK installed, RetrievalRelevance","+#: consumes this budget per judge HTTP attempt including chunk retries, instead of","+#: once per scorer invocation. Set","+#: ``ENABLE_RETRIEVAL_JUDGE_PER_REQUEST_RATE_LIMITING=false`` to disable per-request limiting.","+#: Older SDKs retain per-scorer invocation limits.","+#: Other scorers always rate limit by per-scorer invocation."," MLFLOW_GENAI_EVAL_SCORER_RATE_LIMIT = _EnvironmentVariable(","     \"MLFLOW_GENAI_EVAL_SCORER_RATE_LIMIT\", str, None"," )"],"additions":11,"deletions":3,"truncated":false},{"path":"mlflow/genai/evaluation/harness.py","lines":["@@ -63,6 +63,7 @@ def _warmup_databricks_sdk() -> None:","     RPSRateLimiter,","     call_with_retry,","     eval_retry_context,","+    scorer_rate_limit_context,"," )"," from mlflow.genai.evaluation.session_utils import (","     classify_scorers,","@@ -676,6 +677,9 @@ def run(","     Rate limiting is controlled via environment variables:","     - MLFLOW_GENAI_E