{"id":"a1476c2f1f661b5b762a445a1a6ea27fc643c035","axis":"silent","repo":"matomo-org/matomo","sha":"a1476c2f1f661b5b762a445a1a6ea27fc643c035","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -101,6 +101,14 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," "," ### HTTP Tracking API"," * New optional tracker request parameter `pv_time` (integer, seconds). A tracker that measures time-on-page itself can send it on a follow-up hit carrying the pageview's `pv_id`, and `Piwik\\Plugins\\Actions\\Tracker\\PageViewTimeWriter` records it as the hit's measurement instead of the server-side calculation. It can only ever raise `time_spent`, so a smaller value survives only on pageviews the server never re-measures (the last page of a visit, single-page visits, abandoned tabs). Values are capped at the time elapsed since the pageview and at `Tracker.visit_standard_length`; zero, negative and missing values fall back to the server-side calculation.","+* The HTTP status codes of the tracking endpoint now tell client errors apart from server errors, so a client can decide whether retrying a request makes sense:","+  * A single tracking request that fails because of a server error now answers `500` instead of `400`. A failed request also keeps its `400` or `500` when it was sent with `send_image=0`, and its response body is only the tracking image (or empty with `send_image=0`), no longer followed by the \"This resource is part of Matomo\" text. A request that was already recorded when the error occurred keeps its previous response, so that clients don't send it again.","+  * A `Piwik\\NoAccessException` with the code `401` or `403` thrown while tracking now answers with that code instead of `400`.","+  * A bulk tracking request answers `401` instead of `500` when `[Tracker] bulk_requests_require_authentication` is enabled and no `token_auth` is given, and `403` instead of `500` when the `token_auth` lacks the required access.","+  * In a bulk tracking request, a request sent with `ca=1` that no activated plugin handles is now counted as invalid, instead of failing the whole bulk request with `500`.","+  * A bulk tracking request whose body is not valid JSON, or whose `requests` is missing or not an array, is rejected with `400` instead of being answered with a success response that tracked nothing.","+  * The tracking endpoint answers `503` instead of `200` while Matomo is not installed yet.","+  * An array passed for a numeric tracking parameter, such as `revenue[]=1`, now falls back to the parameter's default like any other wrongly typed value, instead of failing the request with `500`."," "," ### Internal Changes"," * `./console vue:build` no longer emits the unminified `plugins/<Plugin>/vue/dist/<Plugin>.umd.js` bundle. Only the minified `<Plugin>.umd.min.js` was ever loaded by Matomo, and development mode uses the `<Plugin>.development.umd.js` produced by `./console vue:build --watch`. Plugin authors can delete the committed `vue/dist/<Plugin>.umd.js` file from their repository and add `/vue/dist/*.umd.js` to their `.gitignore`. Nothing else needs to change; the file is simply no longer regenerated."],"additions":8,"deletions":0,"truncated":false},{"path":"core/Application/Kernel/EnvironmentValidator.php","lines":["@@ -51,8 +51,8 @@ public function validate()","         $startInstaller = true;"," ","         if (SettingsServer::isTrackerApiRequest()) {","-            // if Piwik is not installed yet, the piwik.php should do nothing and not return an error","-            throw new NotYetInstalledException(\"As Matomo is not installed yet, the Tracking API cannot proceed and will exit without error.\");","+            // nothing can be tracked before installation, piwik.php answers with 503 so clients can retry later","+            throw new NotYetInstalledException(\"As Matomo is not installed yet, the Tracking API cannot proceed.\");","         }"," ","         if (Common::isPhpCliMode()) {"],"additions":2,"deletions":2,"truncated":false},{"path":"core/Common.php","lines":["@@ -551,7 +551,7 @@ public static function getRequestVar($varName, $varDefault = null, $varType = nu","                     $ok = true;","                 }","             } elseif ($varType === 'float') {","-                $valueToCompare = Common::forceDotAsSeparatorForDecimalPoint($value);","+                $valueToCompare = is_array($value) ? '' : Common::forceDotAsSeparatorForDecimalPoint($value);"," ","                 // Simplified regex for float without support for underscore notation","                 // will match:  1.234, 1.2e3, 7E-10"],"additions":1,"deletions":1,"truncated":false},{"path":"core/Tracker/Action.php","lines":["@@ -12,6 +12,7 @@"," use Exception;"," use Piwik\\Common;"," use Piwik\\Container\\StaticContainer;","+use Piwik\\Exception\\InvalidRequestParameterException;"," use Piwik\\Plugin\\Dimension\\ActionDimension;"," use Piwik\\Plugin\\Manager;"," use Piwik\\Log\\LoggerInterface;","@@ -110,7 +111,7 @@ public static function factory(Request $request)","         }"," ","         if (self::isCustomActionRequest($request)) {","-            throw new Exception('Request was meant for a plugin which is no longer activated. Request needs to be ignored.');","+            throw new InvalidRequestParameterException('Request was meant for a plugin which is no longer activated. Request needs to be ignored.');","         }"," ","         return new ActionPageview($request);"],"additions":2,"deletions":1,"truncated":false},{"path":"core/Tracker/Handler.php","lines":["@@ -12,6 +12,7 @@"," use Piwik\\Container\\StaticContainer;"," use Piwik\\Exception\\InvalidRequestParameterException;"," use Piwik\\Exception\\UnexpectedWebsiteFoundException;","+use Piwik\\NoAccessException;"," use Piwik\\Tracker;"," use Exception;"," use Piwik\\Log\\LoggerInterface;","@@ -88,7 +89,10 @@ public function setScheduledTasksRunner(ScheduledTasksRunner $runner)","     public function onException(Tracker $tracker, RequestSet $requestSet, Exception $e)","     {","         $statusCode = 500;","-        if ($e instanceof UnexpectedWebsiteFoundException) {","+        // checked first, as NoAccessException is also an InvalidRequestParameterException","+        if ($e instanceof NoAccessException && in_array($e->getCode(), [401, 403], true)) {","+            $statusCode = $e->getCode();","+        } elseif ($e instanceof UnexpectedWebsiteFoundException) {","             $statusCode = 400;","         } elseif ($e instanceof InvalidRequestParameterException) {","             $statusCode = 400;"],"additions":5,"deletions":1,"truncated":false},{"path":"core/Tracker/Response.php","lines":["@@ -24,6 +24,8 @@ class Response"," ","     private $content;"," ","+    private bool $keepExceptionResponse = false;","+","     public function init(Tracker $tracker)","     {","         ob_start(); // we use ob_start only because of Common::printDebug, we should actually not really use ob_start","@@ -53,6 +55,8 @@ public function getOutput()","      */","     public function outputException(Tracker $tracker, Exception $e, $statusCode)","     {","+        // not once the request was recorded, as matomo.js resends a request answered with an error","+        $this->keepExceptionResponse = !$tracker->hasLoggedRequests();","         Common::sendResponseCode($statusCode);","         $this->logExceptionToErrorLog($e);"," ","@@ -65,7 +69,9 @@ public function outputException(Tracker $tracker, Exception $e, $statusCode)"," ","     public function outputResponse(Tracker $tracker)","     {","-        if (!$tracker->shouldRecordStatistics()) {","+        if ($this->keepExceptionResponse) {","+            Common::printDebug(\"Exception was output => keep its response code\");","+        } elseif (!$tracker->shouldRecordStatistics()) {","             Common::sendResponseCode(503);","             $this->outputApiResponse($tracker);","             Common::printDebug(\"Logging disabled, display tra