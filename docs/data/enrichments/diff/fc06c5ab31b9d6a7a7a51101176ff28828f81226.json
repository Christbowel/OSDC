{"id":"fc06c5ab31b9d6a7a7a51101176ff28828f81226","axis":"silent","repo":"ckeditor/ckeditor5","sha":"fc06c5ab31b9d6a7a7a51101176ff28828f81226","parsed":{"files":[{"path":".changelog/20260916115712_cc_11640_mention_list_styling.md","lines":["@@ -0,0 +1,9 @@","+---","+type: Minor breaking change","+scope:","+  - ckeditor5-mention","+---","+","+The mention suggestion list now matches the toolbar dropdown lists (for example, the headings dropdown): its items are rendered as list item buttons, and the item selected while navigating the list with the keyboard is indicated with a focus-style ring instead of the \"on\" background.","+","+If you customized the mention list appearance, note two CSS hook changes: the selected item is no longer marked with the `ck-on` class (it now uses the `ck-mentions__item_focused` class on the list item), and every item, including custom-rendered ones, now carries the `ck-list-item-button` class."],"additions":9,"deletions":0,"truncated":false},{"path":".changelog/20260916134044_cc_11640_image_balloon_position.md","lines":["@@ -0,0 +1,7 @@","+---","+type: Fix","+scope:","+  - ckeditor5-image","+---","+","+The image balloons (the text alternative form and the custom resize input) are now anchored to the nearest edge of the image instead of its center when centering the balloon would not fit. Previously, a balloon on a left- or right-aligned image could drift toward the middle of the editing area; it now stays next to the image."],"additions":7,"deletions":0,"truncated":false},{"path":"packages/ckeditor5-find-and-replace/theme/findandreplaceform.css","lines":["@@ -7,7 +7,7 @@"," :root,"," :host {"," \t--ck-find-and-replace-form-width: var(--ck-width-dialog);","-\t--ck-find-and-replace-form-replace-field-padding-top: var(--ck-spacing-padding);","+\t--ck-find-and-replace-form-replace-field-padding-top: var(--ck-spacing-padding-comfortable);"," \t/* Defaults to the shared actions padding; the inputs area can be tuned independently. */"," \t--ck-find-and-replace-form-inputs-padding: var(--ck-spacing-padding-spacious) var(--ck-spacing-padding-comfortable) var(--ck-spacing-padding-compact) var(--ck-spacing-padding-comfortable);"," \t/* No top padding — the inputs' bottom padding already provides the gap between the two sections. */"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/ckeditor5-fullscreen/src/handlers/abstracteditorhandler.ts","lines":["@@ -792,7 +792,7 @@ export class FullscreenAbstractEditorHandler {"," "," \t\tbutton.set( {"," \t\t\tlabel: t( 'Toggle sidebar' ),","-\t\t\tclass: 'ck-fullscreen__left-sidebar-toggle-button',","+\t\t\tclass: 'ck-fullscreen__left-sidebar-toggle-button ck-button_surface',"," \t\t\ttooltip: t( 'Hide left sidebar' ),"," \t\t\ttooltipPosition: 'se',"," \t\t\ticon: IconPreviousArrow"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/ckeditor5-fullscreen/theme/fullscreen.css","lines":["@@ -33,7 +33,7 @@ body.ck-fullscreen,"," \t--ck-z-default: calc(var(--ck-z-fullscreen) + 1); /* legacy */"," \t--ck-z-base: calc(var(--ck-z-fullscreen) + 1);"," \t--ck-z-panel: calc(var(--ck-z-default) + 999); /* legacy */","-\t--ck-z-overlay: calc(var(--ck-z-default) + 999);","+\t--ck-z-overlay: calc(var(--ck-z-base) + 999);"," \t--ck-z-dialog: 100000; /* legacy */"," \t--ck-z-modal: 100000;"," ","@@ -191,9 +191,12 @@ Fullscreen layout:"," \t\t--ck-size-control-min-height: 0px;"," "," \t\talign-self: flex-start;","+","+\t\t/* Keep the round toggle at its content size. Because min-height is 0 above, the sticky flex","+\t\t   column would otherwise shrink it vertically into an ellipse. */","+\t\tflex-shrink: 0;"," \t\tmargin-top: var(--ck-fullscreen-editor-top-margin);"," \t\tmargin-bottom: var(--ck-spacing-large, var(--ck-spacing-lg));","-\t\topacity: 0.5;"," \t\tborder-radius: 100%;"," \t}"," "],"additions":5,"deletions":2,"truncated":false},{"path":"packages/ckeditor5-image/src/image/ui/utils.ts","lines":["@@ -50,12 +50,19 @@ export function getBalloonPositionData( editor: Editor ): Partial<DomOptimalPosi"," \t\t\timageUtils.getClosestSelectedImageWidget( editingView.document.selection )!"," \t\t) as HTMLElement,"," \t\tpositions: [","+\t\t\t// Prefer centering the balloon on the image (unchanged for centered or inline images)."," \t\t\tdefaultPositions.northArrowSouth,","-\t\t\tdefaultPositions.northArrowSouthWest,","-\t\t\tdefaultPositions.northArrowSouthEast,","+\t\t\t// When centering would overflow the editable (e.g. a left- or right-aligned image that","+\t\t\t// leaves little room on one side), hug the image's near edge instead of drifting toward","+\t\t\t// the editable center: its left edge for left-aligned images, its right edge for","+\t\t\t// right-aligned ones. `getOptimalPosition` picks the first candidate that fully fits, so","+\t\t\t// it self-selects the correct side based on where the image sits.","+\t\t\tdefaultPositions.northWestArrowSouthWest,","+\t\t\tdefaultPositions.northEastArrowSouthEast,","+\t\t\t// The same set, below the image."," \t\t\tdefaultPositions.southArrowNorth,","-\t\t\tdefaultPositions.southArrowNorthWest,","-\t\t\tdefaultPositions.southArrowNorthEast,","+\t\t\tdefaultPositions.southWestArrowNorthWest,","+\t\t\tdefaultPositions.southEastArrowNorthEast,"," \t\t\tdefaultPositions.viewportStickyNorth"," \t\t]"," \t};"],"additions":11,"deletions":4,"truncated":false},{"path":"packages/ckeditor5-image/tests/image/ui/utils.js","lines":["@@ -17,11 +17,11 @@ describe( 'Utils', () => {"," \tconst defaultPositions = BalloonPanelView.defaultPositions;"," \tconst positions = ["," \t\tdefaultPositions.northArrowSouth,","-\t\tdefaultPositions.northArrowSouthWest,","-\t\tdefaultPositions.northArrowSouthEast,","+\t\tdefaultPositions.northWestArrowSouthWest,","+\t\tdefaultPositions.northEastArrowSouthEast,"," \t\tdefaultPositions.southArrowNorth,","-\t\tdefaultPositions.southArrowNorthWest,","-\t\tdefaultPositions.southArrowNorthEast,","+\t\tdefaultPositions.southWestArrowNorthWest,","+\t\tdefau