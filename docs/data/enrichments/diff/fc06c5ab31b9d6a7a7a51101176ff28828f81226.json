k: 0;"," \t}","+","+\t/*","+\t * The editable keeps DOM focus while the list is navigated, so the selected item is indicated","+\t * with a focus-style ring instead of the \"on\" background. The hover background still applies on","+\t * :hover only, matching the toolbar dropdown lists (e.g. headings).","+\t */","+\t& > .ck-list__item.ck-mentions__item_focused > .ck-button {","+\t\tborder-color: var(--ck-button-focus-border-color);","+\t\tbox-shadow: var(--ck-interactive-focus-shadow), 0 0;","+\t}"," }"," "," div.ck.ck-balloon-panel.ck-mention-balloon {"],"additions":10,"deletions":0,"truncated":false},{"path":"packages/ckeditor5-source-editing/theme/sourceediting.css","lines":["@@ -7,6 +7,7 @@"," :host {"," \t/* Backward compatibility: falls back to the legacy --ck-rounded-corners-radius if overridden. */"," \t--ck-source-editing-area-border-radius: var(--ck-radius-md);","+\t--ck-source-editing-area-font-size: var(--ck-font-size-md);"," }"," "," .ck-source-editing-area {","@@ -20,7 +21,8 @@"," \tmargin: 0;"," \tborder: 1px solid transparent;"," \tline-height: var(--ck-line-height-base);","-\tfont-size: var(--ck-font-size-normal, var(--ck-font-size-base));","+\t/* Kept on the shared textarea/::after rule so the auto-grow mirror matches the textarea's metrics. */","+\tfont-size: var(--ck-source-editing-area-font-size);"," \tfont-family: monospace;"," \twhite-space: pre-wrap;"," }"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/ckeditor5-table/theme/tablecellproperties.css","lines":["@@ -39,11 +39,6 @@"," \t\t\t\t\tflex-grow: 1;"," \t\t\t\t}"," ","-\t\t\t\t&:first-of-type,","-\t\t\t\t&:last-of-type {","-\t\t\t\t\tborder-radius: var(--ck-border-radius-control);","-\t\t\t\t}","-"," \t\t\t\t& .ck-button {"," \t\t\t\t\tflex-grow: 1;"," \t\t\t\t}"],"additions":0,"deletions":5,"truncated":false},{"path":"packages/ckeditor5-table/theme/tableproperties.css","lines":["@@ -20,7 +20,6 @@"," "," \t\t\t& .ck.ck-toolbar {"," \t\t\t\tbackground: none;","-\t\t\t\tborder-radius: var(--ck-border-radius-control);"," "," \t\t\t\t/* Compensate for missing input label that would push the margin (toolbar has no inputs). */"," \t\t\t\tmargin-top: var(--ck-spacing-standard);"],"additions":0,"deletions":1,"truncated":false},{"path":"packages/ckeditor5-ui/manual/buttons.manual.html","lines":["@@ -0,0 +1,70 @@","+<!doctype html>","+<head>","+\t<meta charset=\"utf-8\" />","+\t<meta","+\t\thttp-equiv=\"Content-Security-Policy\"","+\t\tcontent=\"","+\t\tdefault-src 'none';","+\t\tconnect-src 'self';","+\t\tscript-src 'self' 'unsafe-inline' 'unsafe-eval';","+\t\timg-src * data:;","+\t\tstyle-src 'self' 'unsafe-inline';","+\t\tfont-src 'self' data:;","+\t\tframe-src *\"","+\t/>","+","+\t<title>UI - buttons</title>","+\t<script type=\"module\" src=\"./buttons.ts\"></script>","+</head>","+","+<ck-manual-header>","+\t<p>","+\t\tEvery <code>ckeditor5-ui</code> button variant &times; content (just label, label &amp; icon,","+\t\tjust icon) &times; state (default, hover, disabled, active/on, active hover), using only UI","+\t\tclasses &mdash; no feature-specific ones.","+\t</p>","+\t<p>","+\t\tThe <strong>Hover</strong> and <strong>Active hover</strong> columns are simulated with a","+\t\t<code>ck-force-hover</code> class (the manual harness has no pointer).","+\t\t<strong>Focus</strong> is a live-only state &mdash; <strong>Tab</strong> to a button to check it","+\t\t(e.g. the <code>Surface</code> row / <code>ck-button_surface</code> also lifts to the","+\t\tsurface color on focus).","+\t</p>","+\t<p>The checkerboard cell background makes transparent vs. filled button backgrounds easy to spot.</p>","+</ck-manual-header>","+","+<h1>UI Buttons</h1>","+","+<table","+\tid=\"buttons\"","+\tclass=\"table button-grid ck-rounded-corners\"","+\tstyle=\"border: 1px solid #ccc; border-collapse: collapse\"","+></table>","+","+<style>","+\ttable.table.button-grid th,","+\ttable.table.button-grid td {","+\t\tborder: 1px solid #ccc;","+\t\tpadding: 0.7em 1em;","+\t\tvertical-align: middle;","+\t}","+","+\ttable.table.button-grid td {","+\t\tbackground-image:","+\t\t\tlinear-gradient(45deg, #efefef 26%, transparent 26%),","+\t\t\tlinear-gradient(135deg, #efefef 26%, transparent 26%),","+\t\t\tlinear-gradient(45deg, transparent 75%, #efefef 75%),","+\t\t\tlinear-gradient(135deg, transparent 75%, #efefef 75%);","+\t\tbackground-size: 20px 20px;","+\t\tbackground-position:","+\t\t\t0 0,","+\t\t\t10px 0,","+\t\t\t10px -10px,","+\t\t\t0px 10px;","+\t}","+","+\ttable.table.button-grid th {","+\t\tfont-weight: bold;","+\t\tbackground-color: #eee;","+\t}","+</style>"],"additions":70,"deletions":0,"truncated":false},{"path":"packages/ckeditor5-ui/manual/buttons.ts","lines":["@@ -0,0 +1,187 @@","+/**","+ * @license Copyright (c) 2003-2026, CKSource Holding sp. z o.o. All rights reserved.","+ * For licensing, see LICENSE.md or https://ckeditor.com/legal/ckeditor-licensing-options","+ */","+","+import { IconCheck } from '@ckeditor/ckeditor5-icons';","+import { ButtonView } from '@ckeditor/ckeditor5-ui';","+import { Locale } from '@ckeditor/ckeditor5-utils';","+","+import '../theme/index-editor.css';","+","+interface ContentVariant {","+\tlabel: string;","+\tshowIcon: boolean;","+\twithText: boolean;","+}","+","+interface ButtonState {","+\tlabel: string;","+\tisEnabled: boolean;","+\tisOn: boolean;","+\tisHovered: boolean;","+}","+","+interface ButtonVariant {","+\tlabel: string;","+\tclassName: string;","+","+\t// Save/Cancel are one-shot action buttons that never toggle on, so the active (.ck-on) columns","+\t// do not apply. Defaults to true.","+\tsupportsOnState?: boolean;","+}","+","+const contentVariants: Array<ContentVariant> = [","+\t{ label: 'Just label', showIcon: false, withText: true },","+\t{ label: 'Label & icon', showIcon: true, withText: true },","+\t{ label: 'Just icon', showIcon: true, withText: false }","+];","+","+const states: Array<ButtonState> = [","+\t{ label: 'Default', isEnabled: true, isOn: false, isHovered: false },","+\t{ label: 'Hover', isEnabled: true, isOn: false, isHovered: true },","+\t{ label: 'Disabled', isEnabled: false, isOn: false, isHovered: false },","+\t{ label: 'Active', isEnabled: true, isOn: true, isHovered: false },","+\t{ label: 'Active hover', isEnabled: true, isOn: true, isHovered: true }","+];","+","+const buttonVariants: Array<ButtonVariant> = [","+\t{ label: 'Action', className: 'ck-button-action' },","+\t{ label: 'Action small', className: 'ck-button-action ck-button_small' },","+\t{ label: 'Save', className: 'ck-button-save', supportsOnState: false },","+\t{ label: 'Save + surface', className: 'ck-button-save ck-button_surface', supportsOnState: false },","+\t{ label: 'Cancel', className: 'ck-button-cancel', supportsOnState: false },","+\t{ label: 'Cancel + surface', className: 'ck-button-cancel ck-button_surface', supportsOnState: false },","+\t{ label: 'Surface', className: 'ck-button_surface' },","+\t{ label: 'Outline', className: 'ck-button_outline' },","+\t{ label: 'Outline small', className: 'ck-button_outline ck-button_small' },","+\t{ label: 'Small', className: 'ck-button_small' },","+\t{ label: 'Standard', className: 'ck-button_standard' }","+];","+","+const locale = new Locale();","+","+// The manual harness has no real pointer, so fake :hover with a .ck-force-hover class that mirrors","+// the button's live hover background. The background resolves per variant and on-state through the","+// same --ck-button-hover-background token, so this one rule covers every \"Hover\"/\"Active hover\" cell.","+const forceHoverStyle = document.createElement( 'style' );","+","+forceHoverStyle.textContent =","+\t'.ck.ck-button.ck-force-hover:not(.ck-disabled){background:var(--ck-button-hover-background)}';","+","+document.head.appendChild( forceHoverStyle );","+","+renderTable( document.querySelector( '#buttons' )! );","+","+function renderTable( table: Element ): void {","+\tconst thead = document.createElement( 'thead' );","+\tconst tbody = document.createElement( 'tbody' );","+","+\ttable.appendChild( thead );","+\ttable.appendChild( tbody );","+","+\tconst contentRow = document.createElement( 'tr' );","+\tconst stateRow = document.createElement( 'tr' );","+","+\tthead.appendChild( contentRow );","+\tthead.appendChild( stateRow );","+","+\tcontentRow.appendChild( createHeaderCell( ' ' ) );","+\tstateRow.appendChild( createHeaderCell( ' ' ) );","+","+\tfor ( const content of contentVariants ) {","+\t\tconst contentHeader = createHeaderCell( content.label );","+","+\t\tcontentHeader.colSpan = states.length;","+\t\tcontentRow.appendChild( contentHeader );","+","+\t\tfor ( const state of states ) {","+\t\t\tstateRow.appendChild( createHeaderCell( state.label ) );","+\t\t}","+\t}","+","+\tfor ( const variant of buttonVariants ) {","+\t\tconst row = document.createElement( 'tr' );","+","+\t\ttbody.appendChild( row );","+\t\trow.appendChild( createVariantHeaderCell( variant ) );","+","+\t\tfor ( const content of contentVariants ) {","+\t\t\tfor ( const state of states ) {","+\t\t\t\t// Skip the active (.ck-on) columns for variants that never toggle on - render an empty cell.","+\t\t\t\tif ( state.isOn && variant.supportsOnState === false ) {","+\t\t\t\t\trow.appendChild( document.createElement( 'td' ) );","+","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+","+\t\t\t\trow.appendChild( createButtonCell( locale, variant.className, content, state ) );","+\t\t\t}","+\t\t}","+\t}","+}","+","+function createButtonCell(","+\tlocale: Locale,","+\tclassName: string,","+\tcontent: ContentVariant,","+\tstate: ButtonState","+): HTMLTableCellElement {","+\tconst buttonView = new ButtonView( locale );","+\tconst classes: Array<string> = [];","+","+\tif ( className ) {","+\t\tclasses.push( className );","+\t}","+","+\tif ( state.isHovered ) {","+\t\tclasses.push( 'ck-force-hover' );","+\t}","+","+\tbuttonView.set( {","+\t\tlabel: 'Button',","+\t\twithText: content.withText,","+\t\tclass: classes.join( ' ' ) || undefined,","+\t\tisEnabled: st