t( 'isHighlighted', false );","+","+\t\tthis.extendTemplate( {","+\t\t\tattributes: {","+\t\t\t\tclass: [","+\t\t\t\t\tbind.if( 'isHighlighted', 'ck-mentions__item_focused' )","+\t\t\t\t]","+\t\t\t}","+\t\t} );","+\t}"," ","-\t\tchild.isOn = true;","+\tpublic highlight(): void {","+\t\tthis.isHighlighted = true;"," \t}"," "," \tpublic removeHighlight(): void {","-\t\tconst child = this.children.first as MentionDomWrapperView;","-","-\t\tchild.isOn = false;","+\t\tthis.isHighlighted = false;"," \t}"," }"],"additions":31,"deletions":8,"truncated":false},{"path":"packages/ckeditor5-mention/tests/mentionui.js","lines":["@@ -10,7 +10,7 @@ import { Plugin } from '@ckeditor/ckeditor5-core';"," import { Paragraph } from '@ckeditor/ckeditor5-paragraph';"," import { keyCodes, global, EventInfo, env } from '@ckeditor/ckeditor5-utils';"," import { _setModelData, ViewDocumentDomEventData } from '@ckeditor/ckeditor5-engine';","-import { ContextualBalloon } from '@ckeditor/ckeditor5-ui';","+import { ContextualBalloon, ListItemButtonView } from '@ckeditor/ckeditor5-ui';"," "," import { CodeBlock } from '@ckeditor/ckeditor5-code-block';"," ","@@ -1086,7 +1086,25 @@ describe( 'MentionUI', () => {"," \t\t\t\t\t} );"," \t\t\t} );"," ","-\t\t\tit( 'should focus the first item in panel', () => {","+\t\t\tit( 'should highlight the first item in panel', () => {","+\t\t\t\t_setModelData( model, '<paragraph>foo []</paragraph>' );","+","+\t\t\t\tmodel.change( writer => {","+\t\t\t\t\twriter.insertText( '@', doc.selection.getFirstPosition() );","+\t\t\t\t} );","+","+\t\t\t\treturn waitForDebounce()","+\t\t\t\t\t.then( () => {","+\t\t\t\t\t\tconst item = mentionsView.items.get( 0 );","+","+\t\t\t\t\t\t// The selected item is indicated with a focus-style ring, not the \"on\" state.","+\t\t\t\t\t\texpect( item.isHighlighted ).toBe( true );","+\t\t\t\t\t\texpect( item.element.classList.contains( 'ck-mentions__item_focused' ) ).toBe( true );","+\t\t\t\t\t\texpect( item.children.get( 0 ).isOn ).toBe