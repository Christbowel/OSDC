le;","+  }","+","+  // The capacity of a pipe is fixed on Linux.","+  it(\"waits for room after the last byte\", async () => {","+    using dir = tempDir(\"bun-write-pipe\", {});","+    using fifo = openFifo(String(dir));","+    const room = fill(fifo.writer);","+    drain(fifo.reader);","+    const write = Bun.write(knownPipe(fifo.writer), data.slice(0, room));","+    await untilWatched(fifo.writer);","+    expect(Bun.peek.status(write)).toBe(\"pending\");","+    expect(drain(fifo.reader)).toBe(room);","+    expect(await write).toBe(room);","+  });","+","+  it(\"waits when the file finds out after the call that it is a pipe\", async () => {","+    using dir = tempDir(\"bun-write-pipe\", {});","+    mkfifo(join(String(dir), \"hold-1\"));","+    mkfifo(join(String(dir), \"hold-2\"));","+    const script = `","+      import fs from \"node:fs\";","+      import { drain, fill, openFifo, untilWatched } from ${JSON.stringify(join(import.meta.dir, \"fifo-helpers.ts\"))};","+","+      // readFile() has a thread of the pool from its open(), which ends the ENXIO, until the writer is closed.","+      async function holdThread(path) {","+        fs.promises.readFile(path);","+        for (;;) {","+          try {","+            return fs.openSync(path, fs.constants.O_WRONLY | fs.constants.O_NONBLOCK);","+          } catch (error) {","+            if (error.code !== \"ENXIO\") throw error;","+            await Bun.sleep(1);","+          }","+        }","+      }","+","+      using fifo = openFifo(\".\");","+      fill(fifo.writer);","+      const held = [await holdThread(\"hold-1\"), await holdThread(\"hold-2\")];","+      const file = Bun.file(fifo.writer);","+      const write = Bun.write(file, new Blob([\"a\"]));","+      file.size;","+      held.forEach(fd => fs.closeSync(fd));","+      await untilWatched(fifo.writer);","+      drain(fifo.reader);","+      console.log(await write);","+    `;","+    expect(await bunRun([\"--cwd\", String(dir), \"-e\", script], { UV_THREADPOOL_SIZE: \"2\" })).toSpawn(\"1\");","+  });","+});"],"additions":77,"deletions":0,"truncated":false},{"path":"test/js/bun/io/fail-nth-read.c","lines":["@@ -0,0 +1,166 @@","+// Usage: fail-nth-read <path> <n> <errno> -- <cmd> [args...]","+// Makes the <n>th read() syscall whose fd refers to <path> return -<errno>.","+#define _GNU_SOURCE","+#include <errno.h>","+#include <signal.h>","+#include <stdio.h>","+#include <stdlib.h>","+#include <string.h>","+#include <sys/ptrace.h>","+#include <sys/stat.h>","+#include <sys/types.h>","+#include <sys/user.h>","+#include <sys/wait.h>","+#include <unistd.h>","+","+#if defined(__aarch64__)","+  #include <linux/elf.h>","+  #include <sys/uio.h>","+#endif","+","+#if defined(__x86_64__)","+  #define SYS_READ_NR 0","+  typedef struct user_regs_struct regs_t;","+  static long reg_nr(regs_t *r) { return (long)r->orig_rax; }","+  static long reg_arg0(regs_t *r) { return (long)r->rdi; }","+  static void reg_set_ret(regs_t *r, long v) { r->rax = (unsigned long long)v; }","+  static int get_regs(pid_t t, regs_t *r) { return ptrace(PTRACE_GETREGS, t, 0, r); }","+  static int set_regs(pid_t t, regs_t *r) { return ptrace(PTRACE_SETREGS, t, 0, r); }","+#elif defined(__aarch64__)","+  #define SYS_READ_NR 63","+  typedef struct user_regs_struct regs_t;","+  static long reg_nr(regs_t *r) { return (long)r->regs[8]; }","+  static long reg_arg0(regs_t *r) { return (long)r->regs[0]; }","+  static void reg_set_ret(regs_t *r, long v) { r->regs[0] = (unsigned long long)v; }","+  static int get_regs(pid_t t, regs_t *r) {","+    struct iovec io = { r, sizeof(*r) };","+    return ptrace(PTRACE_GETREGSET, t, (void *)NT_PRSTATUS, &io);","+  }","+  static int set_regs(pid_t t, regs_t *r) {","+    struct iovec io = { r, sizeof(*r) };","+    return ptrace(PTRACE_SETREGSET, t, (void *)NT_PRSTATUS, &io);","+  }","+#else","+  #error unsupported arch","+#endif","+","+/* Per-tid syscall enter/exit toggle + pending-poison flag. */","+#define MAX_TIDS 256","+static pid_t tid_tab[MAX_TIDS];","+static unsigned char in_call[MAX_TIDS];","+static unsigned char poison[MAX_TIDS];","+static int slot(pid_t t) {","+  int i, free_i = -1;","+  for (i = 0; i < MAX_TIDS; i++) {","+    if (tid_tab[i] == t) return i;","+    if (tid_tab[i] == 0 && free_i < 0) free_i = i;","+  }","+  if (free_i >= 0) { tid_tab[free_i] = t; return free_i; }","+  return 0;","+}","+static void drop(pid_t t) {","+  int i;","+  for (i = 0; i < MAX_TIDS; i++) if (tid_tab[i] == t) {","+    tid_tab[i] = 0; in_call[i] = 0; poison[i] = 0;","+  }","+}","+","+int main(int argc, char **argv) {","+  if (argc < 6 || strcmp(argv[4], \"--\") != 0) {","+    fprintf(stderr, \"usage: %s <path> <n> <errno> -- <cmd> [args...]\\n\", argv[0]);","+    return 2;","+  }","+  const char *target_path = argv[1];","+  long fail_n = strtol(argv[2], NULL, 10);","+  long fail_errno = strtol(argv[3], NULL, 10);","+  char **cmd = &argv[5];","+","+  struct stat ts;","+  if (stat(target_path, &ts) != 0) { perror(\"stat target\"); return 2; }","+","+  pid_t child = fork();","+  if (child < 0) { perror(\"fork\"); return 2; }","+  if (child == 0) {","+    if (ptrace(PTRACE_TRACEME, 0, 0, 0) != 0) { perror(\"TRACEME\"); _exit(126); }","+    raise(SIGSTOP);","+    execvp(cmd[0], cmd);","+    perror(\"execvp\");","+    _exit(127);","+  }","+","+  int st;","+  if (waitpid(child, &st, 0) < 0) { perror(\"waitpid initial\"); return 2; }","+  long opts = PTRACE_O_TRACESYSGOOD | PTRACE_O_TRACECLONE | PTRACE_O_TRACEFORK |","+              PTRACE_O_TRACEVFORK | PTRACE_O_TRACEEXEC | PTRACE_O_EXITKILL;","+  if (ptrace(PTRACE_SETOPTIONS, child, 0, opts) != 0) { perror(\"SETOPTIONS\"); return 2; }","+  if (ptrace(PTRACE_SYSCALL, child, 0, 0) != 0) { perror(\"SYSCALL initial\"); return 2; }","+","+  long match_count = 0;","+  int exit_code = -1;","+","+  for (;;) {","+    pid_t t = waitpid(-1, &st, __WALL);","+    if (t < 0) {","+      if (errno == ECHILD) break;","+      if (errno == EINTR) continue;","+      perror(\"waitpid\"); return 2;","+    }","+    if (WIFEXITED(st) || WIFSIGNALED(st)) {","+      if (t == child) {","+        exit_code = WIFEXITED(st) ? WEXITSTATUS(st) : 128 + WTERMSIG(st);","+      }","+      drop(t);","+      continue;","+    }","+    if (!WIFSTOPPED(st)) continue;","+","+    int sig = WSTOPSIG(st);","+    unsigned ev = (unsigned)(st >> 16);","+    if (ev == PTRACE_EVENT_CLONE || ev == PTRACE_EVENT_FORK || ev == PTRACE_EVENT_VFORK) {","+      ptrace(PTRACE_SYSCALL, t, 0, 0);","+      continue;","+    }","+    if (ev == PTRACE_EVENT_EXEC) {","+      /* execve's syscall-exit-stop follows; keep the toggle consistent. */","+      in_call[slot(t)] = 1;","+      poison[slot(t)] = 0;","+      ptrace(PTRACE_SYSCALL, t, 0, 0);","+      continue;","+    }","+    if (sig == (SIGTRAP | 0x80)) {","+      int s = slot(t);","+      in_call[s] ^= 1;","+      regs_t r;","+      if (get_regs(t, &r) != 0) { ptrace(PTRACE_SYSCALL, t, 0, 0); continue; }","+","+      if (in_call[s]) { /* syscall entry */","+        if (reg_nr(&r) == SYS_READ_NR) {","+          long fd = reg_arg0(&r);","+          char linkpath[64];","+          struct stat fs;","+          snprintf(linkpath, sizeof linkpath, \"/proc/%d/fd/%ld\", (int)t, fd);","+          if (stat(linkpath, &fs) == 0 &&","+              fs.st_dev == ts.st_dev && fs.st_ino == ts.st_ino) {","+            match_count++;","+            if (match_count == fail_n) poison[s] = 1;","+          }","+        }","+      } else { /* syscall exit */","+        if (poison[s]) {","+          poison[s] = 0;","+          reg_set_ret(&r, -fail_errno);","+          set_regs(t, &r);","+        }","+      }","+      ptrace(PTRACE_SYSCALL, t, 0, 0);","+      continue;","+    }","+    /* Plain SIGTRAP / SIGSTOP are ptrace artifacts; forward real signals so","+       ASAN's SIGSEGV/SIGABRT handler runs. */","+    if (sig == SIGTRAP || sig == SIGSTOP) sig = 0;","+    ptrace(PTRACE_SYSCALL, t, 0, (void *)(long)sig);","+  }","+","+  fprintf(stderr, \"[fail-nth-read] matched read() calls on target: %ld\\n\", match_count);","+  return exit_code < 0 ? 1 : exit_code;","+}"],"additions":166,"deletions":0,"truncated":false},{"path":"test/js/bun/io/fifo-helpers.ts","lines":["@@ -0,0 +1,58 @@","+import { mkfifo } from \"mkfifo\";","+import fs from \"node:fs\";","+import { join } from \"node:path\";","+","+const { O_NONBLOCK, O_RDONLY, O_WRONLY } = fs.constants;","+","+/** Makes a FIFO in `dir` and opens both ends, non-blocking. */","+export function openFifo(dir: string) {","+  const path = join(dir, \"fifo\");","+  mkfifo(path);","+  const reader = fs.openSync(path, O_RDONLY | O_NONBLOCK);","+  const writer = fs.openSync(path, O_WRONLY | O_NONBLOCK);","+  const open = new Set([reader, writer]);","+  const close = (fd: number) => void (open.delete(fd) && fs.closeSync(fd));","+  return { path, reader, writer, close, [Symbol.dispose]: () => [...open].forEach(close) };","+}","+","+function untilEAGAIN(step: () => number) {","+  let total = 0;","+  try {","+    for (let n; (n = step());) total += n;","+  } catch (e: any) {","+    if (e.code !== \"EAGAIN\") throw e;","+  }","+  return total;","+}","+","+/** Writes until the pipe is full. Returns how much that was. */","+export function fill(writer: number) {","+  const page = Buffer.alloc(4096, \"x\");","+  return untilEAGAIN(() => fs.writeSync(writer, page));","+}","+","+/** Reads until the pipe is empty. Returns how much that was. */","+export function drain(reader: number) {","+  const buffer = Buffer.alloc(65536);","+  return untilEAGAIN(() => fs.readSync(reader, buffer));","+}","+","+/** Linux: resolves when this process has asked epoll to tell it when `fd` is readable or writable. */","+export async function untilWatched(fd: number) {","+  const inode = fs.fstatSync(fd).ino;","+  const deadline = Date.now() + 30_000;","+  while (Date.now() < deadline) {","+    for (const name of fs.readdirSync(\"/proc/self/fdinfo\")) {","+      let info = \"\";","+      try {","+        info = fs.readFileSync(\"/proc/self/fdinfo/\" + name, \"utf8\");","+      } catch {}","+      for (const [, events, ino] of info.matchAll(/^tfd:.* events:\\s*([0-9a-f]+) .* ino:([0-9a-f]+)/gm)) {"],"additions":50,"deletions":0,"truncated":false}],"additions":351,"deletions":230,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-21T16:31:48.189642+00:00"}