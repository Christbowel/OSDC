{"id":"74ba0470702bb31f70604059183b75104d31378d","axis":"silent","repo":"nats-io/nats-server","sha":"74ba0470702bb31f70604059183b75104d31378d","parsed":{"files":[{"path":"server/archive/archive.go","lines":["@@ -0,0 +1,356 @@","+// Copyright 2026 The NATS Authors","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+// http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package archive","+","+import (","+\t\"bufio\"","+\t\"encoding/binary\"","+\t\"errors\"","+\t\"io\"","+)","+","+const MagicBytes = \"NATSARC1\"","+","+// maxNameLen bounds the entry name length accepted when reading an archive,","+// avoiding an unbounded allocation on corrupt or malicious input. The name is","+// the only variable-length field read directly from the stream.","+const maxNameLen = 1 << 20","+","+var (","+\tErrClosed            = errors.New(\"archive: closed\")","+\tErrInvalidArchive    = errors.New(\"archive: invalid archive stream\")","+\tErrIncompleteEntry   = errors.New(\"archive: entry not fully written\")","+\tErrNoActiveEntry     = errors.New(\"archive: no active entry\")","+\tErrWriteTooLong      = errors.New(\"archive: write exceeds declared entry size\")","+\tErrNilHeader         = errors.New(\"archive: nil header\")","+\tErrNegativeEntrySize = errors.New(\"archive: negative entry size\")","+)","+","+// Header describes one archive entry.","+//","+// On the wire each entry is the encoded header fields followed by the payload.","+// HeaderSize and PayloadSize describe how that payload is split (e.g. message","+// headers vs. body); the payload length is their sum and is not stored","+// separately. Sequence is always encoded, with 0 meaning \"unset\".","+type Header struct {","+\tName        string","+\tHeaderSize  int64","+\tPayloadSize int64","+\tTimestamp   int64","+\tSequence    uint64","+}","+","+func (h *Header) clone() *Header {","+\tif h == nil {","+\t\treturn nil","+\t}","+\tc := *h","+\treturn &c","+}","+","+// Writer writes a stream of archive entries.","+type Writer struct {","+\tw          io.Writer","+\twroteMagic bool","+\theader     *Header","+\tremaining  int64","+\tclosed     bool","+}","+","+// NewWriter returns a new stream writer.","+func NewWriter(w io.Writer) *Writer {","+\treturn &Writer{w: w}","+}","+","+// WriteHeader starts a new archive entry.","+func (a *Writer) WriteHeader(hdr *Header) error {","+\tif a.closed {","+\t\treturn ErrClosed","+\t}","+\tif hdr == nil {","+\t\treturn ErrNilHeader","+\t}","+\tif hdr.HeaderSize < 0 || hdr.PayloadSize < 0 {","+\t\treturn ErrNegativeEntrySize","+\t}","+\tif a.header != nil && a.remaining > 0 {","+\t\treturn ErrIncompleteEntry","+\t}","+\ttotalPayloadSize := hdr.HeaderSize + hdr.PayloadSize","+\tif totalPayloadSize < 0 {","+\t\treturn ErrNegativeEntrySize","+\t}","+\tif !a.wroteMagic {","+\t\tif _, err := io.WriteString(a.w, MagicBytes); err != nil {","+\t\t\treturn err","+\t\t}","+\t\ta.wroteMagic = true","+\t}","+\tif err := a.writeUvarint(uint64(len(hdr.Name))); err != nil {","+\t\treturn err","+\t}","+\tif err := a.writeVarint(hdr.Timestamp); err != nil {","+\t\treturn err","+\t}","+\tif err := a.writeUvarint(hdr.Sequence); err != nil {","+\t\treturn err","+\t}","+\tif err := a.writeUvarint(uint64(hdr.HeaderSize)); err != nil {","+\t\treturn err","+\t}","+\tif err := a.writeUvarint(uint64(hdr.PayloadSize)); err != nil {","+\t\treturn err","+\t}","+\tif _, err := io.WriteString(a.w, hdr.Name); err != nil {","+\t\treturn err","+\t}","+\ta.header = hdr.clone()","+\ta.remaining = totalPayloadSize","+\tif a.remaining == 0 {","+\t\ta.header = nil","+\t}","+\treturn nil","+}","+","+// Write writes payload bytes for the current entry.","+func (a *Writer) Write(p []byte) (int, error) {","+\tif a.closed {","+\t\treturn 0, ErrClosed","+\t}","+\tif len(p) == 0 {","+\t\treturn 0, nil","+\t}","+\tif a.header == nil {","+\t\treturn 0, ErrNoActiveEntry","+\t}","+\twanted := len(p)","+\tif int64(wanted) > a.remaining {","+\t\twanted = int(a.remaining)","+\t}","+\tn, err := a.w.Write(p[:wanted])","+\ta.remaining -= int64(n)","+\tif err != nil {","+\t\treturn n, err","+\t}","+\tif n < wanted {","+\t\treturn n, io.ErrShortWrite","+\t}","+\tif len(p) > wanted {","+\t\tif a.remaining == 0 {","+\t\t\ta.header = nil","+\t\t}","+\t\treturn n, ErrWriteTooLong","+\t}","+\tif a.remaining == 0 {","+\t\ta.header = nil","+\t}","+\treturn n, nil","+}","+","+// Close finalizes the stream writer.","+func (a *Writer) Close() error {","+\tif a.closed {","+\t\treturn nil","+\t}","+\ta.closed = true","+\tif a.header != nil && a.remaining > 0 {","+\t\treturn ErrIncompleteEntry","+\t}","+\treturn nil","+}","+","+// Flush flushes the underlying writer if it supports flushing.","+func (a *Writer) Flush() error {","+\tif a.closed {","+\t\treturn ErrClosed","+\t}","+\tif f, ok := a.w.(interface{ Flush() error }); ok {","+\t\treturn f.Flush()","+\t}","+\tif f, ok := a.w.(interface{ Flush() }); ok {","+\t\tf.Flush()","+\t}","+\treturn nil","+}","+","+// Reader reads a stream of archive entries.","+type Reader struct {","+\tr         *bufio.Reader","+\theader    *Header","+\tremaining int64","+\tseenMagic bool","+\terr       error","+}","+","+// NewReader returns a new stream reader.","+func NewReader(r io.Reader) *Reader {","+\treturn &Reader{r: bufio.NewReader(r)}","+}","+","+func (u *Reader) discardCurrent() error {","+\tif u.remaining == 0 {","+\t\tu.header = nil","+\t\treturn nil","+\t}","+\t_, err := io.CopyN(io.Discard, u.r, u.remaining)","+\tu.remaining = 0","+\tu.header = nil","+\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {","+\t\treturn ErrInvalidArchive","+\t}","+\treturn err","+}","+","+// Next advances to the next entry and returns its header.","+func (u *Reader) Next() (*Header, error) {","+\tif u.err != nil {","+\t\treturn nil, u.err","+\t}","+\tif err := u.discardCurrent(); err != nil {","+\t\tu.err = err","+\t\treturn nil, err","+\t}","+\tif !u.seenMagic {","+\t\tmagic := make([]byte, len(MagicBytes))","+\t\tif _, err := io.ReadFull(u.r, magic); err != nil {","+\t\t\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {","+\t\t\t\tu.err = io.EOF","+\t\t\t\treturn nil, io.EOF","+\t\t\t}","+\t\t\tu.err = err","+\t\t\treturn nil, err","+\t\t}","+\t\tif string(magic) != MagicBytes {","+\t\t\tu.err = ErrInvalidArchive","+\t\t\treturn nil, ErrInvalidArchive","+\t\t}","+\t\tu.seenMagic = true","+\t}","+\t// A clean io.EOF on the first field is the normal end of the stream.","+\tnameLen, err := u.readUvarint()","+\tif err != nil {","+\t\tu.err = err","+\t\treturn nil, err","+\t}","+\ttimestamp, err := u.readVarint()","+\tif err != nil {","+\t\tu.err = noEOF(err)","+\t\treturn nil, u.err","+\t}","+\tsequence, err := u.readUvarint()","+\tif err != nil {","+\t\tu.err = noEOF(err)","+\t\treturn nil, u.err","+\t}","+\theaderSize, err := u.readUvarint()","+\tif err != nil {","+\t\tu.err = noEOF(err)","+\t\treturn nil, u.err","+\t}","+\tpayloadSize, err := u.readUvarint()","+\tif err != nil {","+\t\tu.err = noEOF(err)","+\t\treturn nil, u.err","+\t}","+\t// HeaderSize/PayloadSize are stored as int64: a value above MaxInt64","+\t// converts to a negative int64, and an overflowing sum lands negative too,","+\t// so the sign checks below cover both cases.","+\thdrSize, plSize := int64(headerSize), int64(payloadSize)","+\ttotal := hdrSize + plSize","+\tif nameLen > maxNameLen || hdrSize < 0 || plSize < 0 || total < 0 {","+\t\tu.err = ErrInvalidArchive","+\t\treturn nil, ErrInvalidArchive","+\t}","+\tname := make([]byte, nameLen)","+\tif _, err := io.ReadFull(u.r, name); err != nil {","+\t\tu.err = ErrInvalidArchive","+\t\treturn nil, ErrInvalidArchive","+\t}","+\tu.header = &Header{","+\t\tName:        string(name),","+\t\tTimestamp:   timestamp,","+\t\tSequence:    sequence,","+\t\tHeaderSize:  hdrSize,","+\t\tPayloadSize: plSize,","+\t}","+\tu.remaining = total","+\treturn u.header.clone(), nil","+}","+","+// Read reads bytes from the current entry payload.","+func (u *Reader) Read(p []byte) (int, error) {","+\tif u.err != nil {","+\t\treturn 0, u.err","+\t}","+\tif len(p) == 0 {","+\t\treturn 0, nil","+\t}","+\tif u.header == nil || u.remaining == 0 {","+\t\treturn 0, io.EOF","+\t}","+","+\tif int64(len(p)) > u.remaining {","+\t\tp = p[:int(u.remaining)]","+\t}","+\tn, err := io.ReadFull(u.r, p)","+\tu.remaining -= int64(n)","+\tif err != nil {","+\t\tu.err = ErrInvalidArchive","+\t\treturn n, ErrInvalidArchive","+\t}","+\tif u.remaining == 0 {","+\t\tu.header = nil","+\t}","+\treturn n, nil","+}","+","+// noEOF converts a clean io.EOF into ErrInvalidArchive. It is used for header","+// fields after the first: reaching EOF there means the entry was truncated","+// rather than that the stream ended cleanly on an entry boundary.","+func noEOF(err error) error {","+\tif err != nil && errors.Is(err, io.EOF) {","+\t\treturn ErrInvalidArchive","+\t}","+\treturn err","+}","+","+func (a *Writer) writeVarint(v int64) error {","+\tvar tmp [binary.MaxVarintLen64]byte","+\tn := binary.PutVarint(tmp[:], v)","+\t_, err := a.w.Write(tmp[:n])","+\treturn err","+}","+","+func (a *Writer) writeUvarint(v uint64) error {","+\tvar tmp [binary.MaxVarintLen64]byte","+\tn := binary.PutUvarint(tmp[:], v)","+\t_, err := a.w.Write(tmp[:n])","+\treturn err","+}","+","+func (u *Reader) readVarint() (int64, error) {","+\tv, err := binary.ReadVarint(u.r)","+\tif err != nil && !errors.Is(err, io.EOF) {","+\t\treturn v, ErrInvalidArchive","+\t}","+\treturn v, err","+}","+","+func (u *Reader) readUvarint() (uint64, error) {","+\tv, err := binary.ReadUvarint(u.r)","+\tif err != nil && !errors.Is(err, io.EOF) {","+\t\treturn v, ErrInvalidArchive","+\t}","+\treturn v, err","+}"],"additions":356,"deletions":0,"truncated":false},{"path":"server/archive/archive_test.go","lines":["@@ -0,0 +1,244 @@","+// Copyright 2026 The NATS Authors","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+// http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package archive","+","+import (","+\t\"bytes\"","+\t\"errors\"","+\t\"io\"","+\t\"testing\"","+)","+","+func TestRoundTrip(t *testing.T) {","+\tvar buf bytes.Buffer","+","+\tw := NewWriter(&buf)","+","+\twant := []struct {","+\t\thdr  Header","+\t\tdata string","+\t}{","+\t\t{","+\t\t\thdr: Header{","+\t\t\t\tName:        \"alpha.txt\",","+\t\t\t\tTimestamp:   100,","+\t\t\t\tHeaderSize:  4,","+\t\t\t\tPayloadSize: 7,","+\t\t\t},","+\t\t\tdata: \"hello alpha\",","+\t\t},","+\t\t{","+\t\t\thdr: Header{","+\t\t\t\tName:        \"nested/beta.txt\",","+\t\t\t\tTimestamp:   100,","+\t\t\t\tSequence:    42,","+\t\t\t\tHeaderSize:  3,","+\t\t\t\tPayloadSize: 9,","+\t\t\t},","+\t\t\tdata: \"beta payload\",","+\t\t},","+\t}","+","+\tfor i := range want {","+\t\tif err := w.WriteHeader(&want[i].hdr); err != nil {","+\t\t\tt.Fatalf(\"write header %d: %v\", i, err)","+\t\t}","+\t\tif _, err := io.WriteString(w, want[i].data); err != nil {","+\t\t\tt.Fatalf(\"write payload %d: %v\", i, err)","+\t\t}","+\t}","+\tif err := w.Close(); err != nil {","+\t\tt.Fatalf(\"close writer: %v\", err)","+\t}","+","+\tr := NewReader(bytes.NewReader(buf.Bytes()))","+","+\tfor i := range want {","+\t\thdr, err := r.Next()","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"next %d: %v\", i, err)","+\t\t}","+\t\tif hdr.Name != want[i].hdr.Name {","+\t\t\tt.Fatalf(\"header %d name mismatch: got %q want %q\", i, hdr.Name, want[i].hdr.Name)","+\t\t}","+\t\tif hdr.Timestamp != want[i].hdr.Timestamp {","+\t\t\tt.Fatalf(\"header %d timestamp mismatch: got %d want %d\", i, hdr.Timestamp, want[i].hdr.Timestamp)","+\t\t}","+\t\tif hdr.Sequence != want[i].hdr.Sequence {","+\t\t\tt.Fatalf(\"header %d sequence mismatch: got %d want %d\", i, hdr.Sequence, want[i].hdr.Sequence)","+\t\t}","+\t\tif hdr.HeaderSize != want[i].hdr.HeaderSize {","+\t\t\tt.Fatalf(\"header %d header size mismatch: got %d want %d\", i, hdr.HeaderSize, want[i].hdr.HeaderSize)","+\t\t}","+\t\tif hdr.PayloadSize != want[i].hdr.PayloadSize {","+\t\t\tt.Fatalf(\"header %d payload size mismatch: got %d want %d\", i, hdr.PayloadSize, want[i].hdr.PayloadSize)","+\t\t}","+\t\tgot, err := io.ReadAll(r)","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"read payload %d: %v\", i, err)","+\t\t}","+\t\tif string(got) != want[i].data {","+\t\t\tt.Fatalf(\"payload %d mismatch: got %q want %q\", i, got, want[i].data)","+\t\t}","+\t}","+","+\tif _, err := r.Next(); !errors.Is(err, io.EOF) {","+\t\tt.Fatalf(\"expected EOF, got %v\", err)","+\t}","+}","+","+func TestNextSkipsUnreadPayload(t *testing.T) {","+\tvar buf bytes.Buffer","+","+\tw := NewWriter(&buf)","+\tfirst := Header{Name: \"first\", HeaderSize: 0, PayloadSize: int64(len(\"abcdef\"))}","+\tif err := w.WriteHeader(&first); err != nil {","+\t\tt.Fatalf(\"write first header: %v\", err)","+\t}","+\tif _, err := io.WriteString(w, \"abcdef\"); err != nil {","+\t\tt.Fatalf(\"write first payload: %v\", err)","+\t}","+","+\tsecond := Header{Name: \"second\", HeaderSize: 0, PayloadSize: int64(len(\"second-body\"))}","+\tif err := w.WriteHeader(&second); err != nil {","+\t\tt.Fatalf(\"write second header: %v\", err)","+\t}","+\tif _, err := io.WriteString(w, \"second-body\"); err != nil {","+\t\tt.Fatalf(\"write second payload: %v\", err)","+\t}","+","+\tr := NewReader(bytes.NewReader(buf.Bytes()))","+","+\thdr, err := r.Next()","+\tif err != nil {","+\t\tt.Fatalf(\"next first: %v\", err)","+\t}","+\tif hdr.Name != \"first\" {","+\t\tt.Fatalf(\"unexpected first header name %q\", hdr.Name)","+\t}","+","+\tbuf1 := make([]byte, 3)","+\tif _, err := io.ReadFull(r, buf1); err != nil {","+\t\tt.Fatalf(\"read partial first payload: %v\", err)","+\t}","+\tif string(buf1) != \"abc\" {","+\t\tt.Fatalf(\"unexpected partial payload %q\", buf1)","+\t}","+","+\thdr, err = r.Next()","+\tif err != nil {","+\t\tt.Fatalf(\"next second: %v\", err)","+\t}","+\tif hdr.Name != \"second\" {","+\t\tt.Fatalf(\"unexpected second header name %q\", hdr.Name)","+\t}","+","+\tgot, err := io.ReadAll(r)","+\tif err != nil {","+\t\tt.Fatalf(\"read second payload: %v\", err)","+\t}","+\tif string(got) != \"second-body\" {","+\t\tt.Fatalf(\"unexpected second payload %q\", got)","+\t}","+}","+","+// validArchive returns a well-formed archive holding a single entry whose","+// payload is the 6-byte string \"abcdef\" split as HeaderSize=2, PayloadSize=4.","+func validArchive(t *testing.T) []byte {","+\tt.Helper()","+\tvar buf bytes.Buffer","+\tw := NewWriter(&buf)","+\thdr := Header{Name: \"first\", Timestamp: 7, Sequence: 3, HeaderSize: 2, PayloadSize: 4}","+\tif err := w.WriteHeader(&hdr); err != nil {","+\t\tt.Fatalf(\"write header: %v\", err)","+\t}","+\tif _, err := io.WriteString(w, \"abcdef\"); err != nil {","+\t\tt.Fatalf(\"write payload: %v\", err)","+\t}","+\tif err := w.Close(); err != nil {","+\t\tt.Fatalf(\"close: %v\", err)","+\t}","+\treturn buf.Bytes()","+}","+","+func TestEmptyArchiveReturnsEOF(t *testing.T) {","+\tr := NewReader(bytes.NewReader(nil))","+\tif _, err := r.Next(); !errors.Is(err, io.EOF) {","+\t\tt.Fatalf(\"expected io.EOF on empty archive, got %v\", err)","+\t}","+}","+","+func TestInvalidMagicIsRejected(t *testing.T) {","+\tr := NewReader(bytes.NewReader([]byte(\"not-a-valid-archive-stream\")))","+\tif _, err := r.Next(); !errors.Is(err, ErrInvalidArchive) {","+\t\tt.Fatalf(\"expected ErrInvalidArchive, got %v\", err)","+\t}","+}","+","+// A clean EOF on the first header field means end-of-stream, but an EOF","+// partway through the header means the entry was truncated.","+func TestTruncatedHeaderIsInvalid(t *testing.T) {","+\tfull := validArchive(t)","+\t// Keep the magic plus the single name-length byte, dropping the rest.","+\tr := NewReader(bytes.NewReader(full[:len(MagicBytes)+1]))","+\tif _, err := r.Next(); !errors.Is(err, ErrInvalidArchive) {","+\t\tt.Fatalf(\"expected ErrInvalidArchive, got %v\", err)","+\t}","+}","+","+func TestTruncatedPayloadIsInvalid(t *testing.T) {","+\tfull := validArchive(t)","+\t// Drop the last 3 payload bytes; the header still decodes cleanly.","+\tr := NewReader(bytes.NewReader(full[:len(full)-3]))","+\thdr, err := r.Next()","+\tif err != nil {","+\t\tt.Fatalf(\"next: %v\", err)","+\t}","+\tif hdr.HeaderSize+hdr.PayloadSize != 6 {","+\t\tt.Fatalf(\"unexpected payload size %d\", hdr.HeaderSize+hdr.PayloadSize)","+\t}","+\tif _, err := io.ReadAll(r); !errors.Is(err, ErrInvalidArchive) {","+\t\tt.Fatalf(\"expected ErrInvalidArchive reading payload, got %v\", err)","+\t}","+}","+","+// The header round-trips when its fields are read directly from the stream,","+// including a large Sequence (uvarint) and a negative Timestamp (varint).","+func TestHeaderFieldEncoding(t *testing.T) {","+\tvar buf bytes.Buffer","+\tw := NewWriter(&buf)","+\twant := Header{Name: \"nested/x.dat\", Timestamp: -123, Sequence: 1 << 60, HeaderSize: 0, PayloadSize: 0}","+\tif err := w.WriteHeader(&want); err != nil {","+\t\tt.Fatalf(\"write header: %v\", err)","+\t}","+\tif err := w.Close(); err != nil {","+\t\tt.Fatalf(\"close: %v\", err)","+\t}","+","+\tr := NewReader(bytes.NewReader(buf.Bytes()))","