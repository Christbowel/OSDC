iling (client gone, or not JSON) cancels ctx and ends the loop.","+\tanswers := make(chan dto.InteractiveAuthAnswer)","+\tgo func() {","+\t\tdefer cancel()","+\t\tfor {","+\t\t\tvar answer dto.InteractiveAuthAnswer","+\t\t\tif err := wsjson.Read(ctx, conn, &answer); err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\tselect {","+\t\t\tcase answers <- answer:","+\t\t\tcase <-ctx.Done():","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t}()","+","+\tvar current *ssh.SSHInteractiveAuth","+\tidleSent := false","+\tfor {","+\t\tnext, changed, err := h.svc.Next(ctx)","+\t\tif err != nil {","+\t\t\treturn","+\t\t}","+\t\tif next != current || (next == nil && !idleSent) {","+\t\t\tcurrent = next","+\t\t\tmsg := dto.InteractiveAuthMessage{Type: \"idle\"}","+\t\t\tif current != nil {","+\t\t\t\tchallenge := dto.ToInteractiveAuthResponse(current)","+\t\t\t\tmsg = dto.InteractiveAuthMessage{Type: \"challenge\", Auth: &challenge}","+\t\t\t}","+\t\t\tif err := wsjson.Write(ctx, conn, msg); err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\tidleSent = current == nil","+\t\t}","+","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\treturn","+\t\tcase <-changed:","+\t\t\t// An auth was added, or one was answered elsewhere or abandoned: look again.","+\t\tcase answer := <-answers:","+\t\t\tswitch {","+\t\t\tcase current == nil:","+\t\t\t\terr = httpx.BadRequest(\"No pending interactive auth to answer\")","+\t\t\tcase answer.AuthID != \"\" && answer.AuthID != current.AuthId:","+\t\t\t\terr = httpx.Conflict(\"Interactive auth %s is not the current challenge\", answer.AuthID)","+\t\t\tdefault:","+\t\t\t\terr = h.svc.Answer(current, &answer)","+\t\t\t}","+\t\t\tif err == nil {","+\t\t\t\t// Answered auths are skipped by Next, so the loop moves on. A 409 below","+\t\t\t\t// (answered elsewhere) moves on the same way.","+\t\t\t\terr = wsjson.Write(ctx, conn, dto.InteractiveAuthMessage{Type: \"accepted\", AuthID: current.AuthId})","+\t\t\t} else {","+\t\t\t\terr = writeSocketError(ctx, conn, err)","+\t\t\t}","+\t\t\tif err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t}","+}","+"," // answer serves one auth over a websocket: it sends the challenge, then reads"," // answers until one is accepted."," //"],"additions":85,"deletions":0,"truncated":false},{"path":"api/credentials/controller/interactive_auth_test.go","lines":["@@ -45,9 +45,14 @@ import ("," // pendingAuth registers an auth owned by owner and starts a handshake waiting on"," // it, returning the channel the handshake's answers arrive on."," func pendingAuth(t *testing.T, sshCtx *ssh.GlobalSSHContext, owner string, prompts []ssh.Prompt) (*ssh.SSHInteractiveAuth, <-chan []string) {","+\tt.Helper()","+\treturn pendingAuthWithID(t, sshCtx, \"auth-1\", owner, prompts)","+}","+","+func pendingAuthWithID(t *testing.T, sshCtx *ssh.GlobalSSHContext, authID, owner string, prompts []ssh.Prompt) (*ssh.SSHInteractiveAuth, <-chan []string) {"," \tt.Helper()"," \tdial := ssh.NewSSHDialConfig(\"login.example.org\", 22, \"alice\", credmodel.SSHCredential{ID: \"cred-1\"}, owner)","-\tpending := ssh.NewSSHInteractiveAuth(\"auth-1\", dial)","+\tpending := ssh.NewSSHInteractiveAuth(authID, dial)"," \tsshCtx.InteractiveAuthStore.AddAuth(pending)"," "," \tanswers := make(chan []string, 1)","@@ -241,3 +246,96 @@ func TestInteractiveAuthRestAnswersChallenge(t *testing.T) {"," \t\tt.Fatal(\"handshake was never released\")"," \t}"," }","+","+// subscribeURL turns newServer's socket URL into the subscribe socket's URL.","+func subscribeURL(wsURL string) string {","+\treturn strings.TrimSuffix(wsURL, \"/auth-1/ws\") + \"/ws\"","+}","+","+func readMessage(t *testing.T, conn *websocket.Conn) dto.InteractiveAuthMessage {","+\tt.Helper()","+\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)","+\tdefer cancel()","+\tvar msg dto.InteractiveAuthMessage","+\tif err := wsjson.Read(ctx, conn, &msg); err != nil {","+\t\tt.Fatalf(\"reading message: %v\", err)","+\t}","+\treturn msg","+}","+","+func wantMessage(t *testing.T, conn *websocket.Conn, typ, authID string) {","+\tt.Helper()","+\tmsg := readMessage(t, conn)","+\tgot := msg.AuthID","+\tif msg.Auth != nil {","+\t\tgot = msg.Auth.AuthID","+\t}","+\tif msg.Type != typ || got != authID {","+\t\tt.Fatalf(\"want %s %q, got %+v\", typ, authID, msg)","+\t}","+}","+","+func TestSubscribeSocketServesAuthsInTurn(t *testing.T) {","+\tsshCtx := ssh.NewGlobalSSHContext()","+\tprompt := []ssh.Prompt{{Text: \"OTP: \"}}","+\t_, firstAnswers := pendingAuthWithID(t, sshCtx, \"first\", \"cilogon:alice\", prompt)","+\ttime.Sleep(2 * time.Millisecond) // distinct CreatedAt, so the order is fixed","+\t_, secondAnswers := pendingAuthWithID(t, sshCtx, \"second\", \"cilogon:alice\", prompt)","+\tother, _ := pendingAuthWithID(t, sshCtx, \"mallorys\", \"cilogon:mallory\", prompt)","+\tt.Cleanup(func() { _ = other.SetResponse(nil, context.Canceled) })","+","+\tconn, _, err := dial(t, subscribeURL(newServer(t, sshCtx)), \"cilogon:alice\")","+\tif err != nil {","+\t\tt.Fatalf(\"dial: %v\", err)","+\t}","+\tdefer conn.CloseNow()","+\tctx := context.Background()","+","+\t// Only the oldest is shown until it is answered.","+\twantMessage(t, conn, \"challenge\", \"first\")","+","+\t// An answer aimed at an auth that is not the current challenge is refused.","+\tif err := wsjson.Write(ctx, conn, dto.InteractiveAuthAnswer{AuthID: \"second\", Responses: []string{\"1\"}}); err != nil {","+\t\tt.Fatal(err)","+\t}","+\twantMessage(t, conn, \"error\", \"\")","+","+\tif err := wsjson.Write(ctx, conn, dto.InteractiveAuthAnswer{AuthID: \"first\", Responses: []string{\"111\"}}); err != nil {","+\t\tt.Fatal(err)","+\t}","+\twantMessage(t, conn, \"accepted\", \"first\")","+\tif got := <-firstAnswers; !slices.Equal(got, []string{\"111\"}) {","+\t\tt.Fatalf(\"first handshake got %q\", got)","+\t}","+","+\twantMessage(t, conn, \"challenge\", \"second\")","+\tif err := wsjson.Write(ctx, conn, dto.InteractiveAuthAnswer{Responses: []string{\"222\"}}); err != nil {","+\t\tt.Fatal(err)","+\t}","+\twantMessage(t, conn, \"accepted\", \"second\")","+\tif got := <-secondAnswers; !slices.Equal(got, []string{\"222\"}) {","+\t\tt.Fatalf(\"second handshake got %q\", got)","+\t}","+","+\t// Nothing left: the socket says so, and wakes when the next auth arrives.","+\twantMessage(t, conn, \"idle\", \"\")","+\tthird, _ := pendingAuthWithID(t, sshCtx, \"third\", \"cilogon:alice\", prompt)","+\twantMessage(t, conn, \"challenge\", \"third\")","+","+\t// Answered elsewhere and removed: the socket moves on without being asked.","+\tif err := third.SetResponse([]string{\"333\"}, nil); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tsshCtx.InteractiveAuthStore.RemoveAuth(\"cilogon:alice\", \"third\")","+\twantMessage(t, conn, \"idle\", \"\")","+}","+","+func TestSubscribeSocketNeedsCaller(t *testing.T) {","+\t_, resp, err := dial(t, subscribeURL(newServer(t, ssh.NewGlobalSSHContext())), \"\")","+\tif err == nil {","+\t\tt.Fatal(\"dial succeeded without a caller\")","+\t}","+\tif resp == nil || resp.StatusCode != http.StatusUnauthorized {","+\t\tt.Fatalf(\"want 401, got %v\", resp)","+\t}","+}"],"additions":99,"deletions":1,"truncated":false},{"path":"api/credentials/dto/interactive_auth.go","lines":["@@ -70,15 +70,22 @@ func ToInteractiveAuthResponse(s *ssh.SSHInteractiveAuth) InteractiveAuthRespons"," //   - \"challenge\": the first message, carrying the auth and its prompts"," //   - \"accepted\":  the answer was handed to the SSH handshake; the socket then closes"," //   - \"error\":     Message says what was wrong; a bad answer can be resent","+//   - \"idle\":      (subscribe socket only) nothing is waiting for an answer","+//","+// On the subscribe socket \"accepted\" carries AuthID and the socket stays open."," type InteractiveAuthMessage struct {"," \tType    string                   `json:\"type\"`"," \tAuth    *InteractiveAuthResponse `json:\"auth,omitempty\"`","+\tAuthID  string                   `json:\"authId,omitempty\"`"," \tMessage string