uthStore: newSSHInteractiveAuthStore(),","+\t\tConnectionPool:       newSSHConnectionPool(),","+\t}","+}","+","+type SSHInteractiveAuthStore struct {","+\t// List of interactive SSH auths keyed by user ID, then by auth ID","+\tAuths map[string]map[string]*SSHInteractiveAuth","+\tlock  sync.Mutex","+\t// User ID mapping to subscriber channels","+\tSubscriberQueue map[string]chan struct{}","+}","+","+func newSSHInteractiveAuthStore() *SSHInteractiveAuthStore {","+\treturn &SSHInteractiveAuthStore{","+\t\tAuths:           make(map[string]map[string]*SSHInteractiveAuth),","+\t\tSubscriberQueue: make(map[string]chan struct{}),","+\t}","+}","+","+func (store *SSHInteractiveAuthStore) GetAuth(userId, authId string) (*SSHInteractiveAuth, bool) {","+\tstore.lock.Lock()","+\tdefer store.lock.Unlock()","+","+\tuserAuths, ok := store.Auths[userId]","+\tif !ok {","+\t\treturn nil, false","+\t}","+\tauth, ok := userAuths[authId]","+\treturn auth, ok","+}","+","+func (store *SSHInteractiveAuthStore) AddAuth(auth *SSHInteractiveAuth) {","+\tstore.lock.Lock()","+\tdefer store.lock.Unlock()","+","+\tuserAuths, ok := store.Auths[auth.dialConfig.userId]","+\tif !ok {","+\t\tuserAuths = make(map[string]*SSHInteractiveAuth)","+\t\tstore.Auths[auth.dialConfig.userId] = userAuths","+\t}","+\tuserAuths[auth.AuthId] = auth","+\tstore.resetSubscriberQueue(auth.dialConfig.userId)","+}","+","+func (store *SSHInteractiveAuthStore) RemoveAuth(userId, authId string) {","+\tstore.lock.Lock()","+\tdefer store.lock.Unlock()","+","+\tuserAuths, ok := store.Auths[userId]","+\tif !ok {","+\t\treturn","+\t}","+","+\tif auth, ok := userAuths[authId]; ok {","+\t\tif !auth.Answered() {","+\t\t\t_ = auth.SetResponse(nil, errAuthWithdrawn) // Mark as answered (true) to unblock subscribers waiting for this auth","+\t\t}","+\t\tdelete(userAuths, authId)","+\t}","+","+\tif len(userAuths) == 0 {","+\t\tdelete(store.Auths, userId)","+\t}","+\tstore.resetSubscriberQueue(userId)","+}","+","+// NOTE: This does not have its own locking; it assumes the caller has locked the store.","+func (store *SSHInteractiveAuthStore) resetSubscriberQueue(userId string) {","+\tif ch, ok := store.SubscriberQueue[userId]; ok {","+\t\tclose(ch)","+\t\tdelete(store.SubscriberQueue, userId)","+\t}","+\tstore.SubscriberQueue[userId] = make(chan struct{})","+}","+","+func (store *SSHInteractiveAuthStore) ListAuthsForUser(userId string) []*SSHInteractiveAuth {","+\tstore.lock.Lock()","+\tdefer store.lock.Unlock()","+","+\tuserAuths, ok := store.Auths[userId]","+\tif !ok {","+\t\treturn nil","+\t}","+\tauths := make([]*SSHInteractiveAuth, 0, len(userAuths))","+\tfor _, auth := range userAuths {","+\t\tauths = append(auths, auth)","+\t}","+\treturn auths","+}","+","+// errAuthWithdrawn is what an auth removed before it was answered resolves with.","+var errAuthWithdrawn = errors.New(\"interactive auth withdrawn\")","+","+// This is for retrieving the earliest created interactive auth for a user.","+// It only returns auths that have not been answered yet, or nil if there are none.","+// The returned channel closes the next time the user's auths are added or removed.","+// Both are taken under one lock, so a change right after the call is never missed.","+func (store *SSHInteractiveAuthStore) NextAuthForUser(userId string) (*SSHInteractiveAuth, <-chan struct{}) {","+\tstore.lock.Lock()","+\tdefer store.lock.Unlock()","+","+\tch, ok := store.SubscriberQueue[userId]","+\tif !ok {","+\t\tch = make(chan struct{})","+\t\tstore.SubscriberQueue[userId] = ch","+\t}","+","+\tearliest := (*SSHInteractiveAuth)(nil)","+\tfor _, auth := range store.Auths[userId] {","+\t\tif (earliest == nil || auth.CreatedAt.Before(earliest.CreatedAt)) && auth.Answered() == false {","+\t\t\tearliest = auth","+\t\t}","+\t}","+\treturn earliest, ch","+}",""],"additions":130,"deletions":0,"truncated":false}],"additions":361,"deletions":116,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-02T17:25:17.084485+00:00"}