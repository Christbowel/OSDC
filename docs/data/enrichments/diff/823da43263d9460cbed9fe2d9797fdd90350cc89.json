 None","+        middleman.channel.close()","+","+        outcome = {}","+","+        run_operation = {","+            \"put\": lambda: ray.put(42),","+            \"get\": lambda: ray.get(ref),","+            \"pending_future\": lambda: pending.result(timeout=20),","+            \"cluster_resources\": ray.cluster_resources,","+        }[operation]","+","+        def get_after_rejection():","+            try:","+                run_operation()","+            except Exception as e:","+                outcome[\"error\"] = e","+","+        get_thread = threading.Thread(target=get_after_rejection, daemon=True)","+        get_thread.start()","+        # The default reconnect grace period is 30s; a rejection must not wait it out.","+        get_thread.join(timeout=20)","+        assert (","+            not get_thread.is_alive()","+        ), f\"{operation} hung after the token was rejected\"","+        assert isinstance(outcome.get(\"error\"), AuthenticationError), outcome","+","+","+class _UnavailableError(grpc.RpcError):","+    def code(self):","+        return grpc.StatusCode.UNAVAILABLE","+","+    def details(self):","+        return \"Server unreachable\"","+","+","+class _UnreachableStub:","+    def __getattr__(self, method):","+        def unavailable(*args, **kwargs):","+            raise _UnavailableError()","+","+        return unavailable","+","+","+def test_rejection_stops_other_retry_loops(call_ray_start_shared):","+    from ray.exceptions import AuthenticationError","+","+    with start_middleman_server() as middleman:","+        ref = ray.put(42)","+        assert ray.get(ref) == 42","+        middleman.task_servicer.stub = _RejectingStub()","+        with pytest.raises(AuthenticationError):","+            ray.cluster_resources()","+","+        # The data channel stays healthy, so only the recorded rejection can","+        # end the retry loop of a call that then finds the server unreachable.","+        middleman.task_servicer.stub = _UnreachableStub()","+        outcome = {}","+","+        def get_ref():","+            try:","+                ray.get(ref)","+            except Exception as e:","+                outcome[\"error\"] = e","+","+        get_thread = threading.Thread(target=get_ref, daemon=True)","+        get_thread.start()","+        get_thread.join(timeout=20)","+        assert not get_thread.is_alive(), \"ray.get kept retrying after a rejection\"","+        assert isinstance(outcome.get(\"error\"), AuthenticationError), outcome","+","+"," if __name__ == \"__main__\":","     sys.exit(pytest.main([\"-sv\", __file__]))"],"additions":113,"deletions":0,"truncated":false},{"path":"python/ray/tests/test_exceptions.py","lines":["@@ -5,6 +5,9 @@"," "," import pytest"," ","+from ray._private.authentication.authentication_constants import (","+    TOKEN_AUTH_ENABLED_BUT_NO_TOKEN_FOUND_ERROR_MESSAGE,","+)"," from ray.exceptions import AuthenticationError, RayError"," "," ","@@ -28,6 +31,22 @@ def test_basic_creation(self):","         # Doc URL included","         assert self.auth_doc_url in error_str"," ","+    @pytest.mark.parametrize(","+        \"message\",","+        [","+            \"Token is missing\",","+            \"Token is invalid.\",","+            TOKEN_AUTH_ENABLED_BUT_NO_TOKEN_FOUND_ERROR_MESSAGE,","+        ],","+        ids=[\"no_period\", \"trailing_period\", \"no_token_message\"],","+    )","+    def test_punctuation(self, message):","+        error_str = str(AuthenticationError(message))","+","+        # A period right after the URL ends up inside terminal links.","+        assert self.auth_doc_url + \".\" not in error_str","+        assert \"..\" not in error_str","+","     def test_is_ray_error_subclass(self):","         \"\"\"Test that AuthenticationError is a RayError subclass.\"\"\"","         error = AuthenticationError(\"Test\")"],"additions":19,"deletions":0,"truncated":false},{"path":"python/ray/tests/test_runtime_env_agent_auth.py","lines":["@@ -8,16 +8,21 @@"," "," import ray"," fro