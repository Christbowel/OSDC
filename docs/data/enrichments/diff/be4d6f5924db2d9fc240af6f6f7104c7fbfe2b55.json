{"id":"be4d6f5924db2d9fc240af6f6f7104c7fbfe2b55","axis":"silent","repo":"pnpm/pnpm","sha":"be4d6f5924db2d9fc240af6f6f7104c7fbfe2b55","parsed":{"files":[{"path":".changeset/git-dependency-build-in-every-slot.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm now builds a git-hosted dependency in every new location it links the dependency into, such as a new global virtual store slot or a fresh `node_modules`. When the side-effects cache holds the build output, pnpm restores it from there. Before, only the install that fetched the dependency built it. This also fixes dependencies that are already in the store [#17224](https://github.com/pnpm/pnpm/issues/17224)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/git_hosted_install/builds.rs","lines":["@@ -165,7 +165,7 @@ fn type_git_dependency_reuses_side_effects_on_warm_install() {","     let repo = GitRepoFixture::init(root.path(), \"git-side-effects\");","     let lifecycle_log = root.path().join(\"git-side-effects-builds.log\");","     let script = format!(","-        r\"require('fs').appendFileSync({}, 'built\\n')\",","+        r\"const fs = require('fs'); fs.appendFileSync({}, 'built\\n'); fs.writeFileSync('built.txt', '')\",","         serde_json::to_string(&lifecycle_log).expect(\"serialize lifecycle log path\"),","     );","     repo.write_file(","@@ -200,6 +200,10 @@ fn type_git_dependency_reuses_side_effects_on_warm_install() {","         builds_after_cold_install,","         \"the warm install must materialize cached side effects without rerunning postinstall\",","     );","+    assert!(","+        workspace.join(\"node_modules/git-side-effects/built.txt\").exists(),","+        \"the warm install did not restore the cached build output\",","+    );"," ","     drop((root, npmrc_info));"," }"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global_virtual_store/builds.rs","lines":["@@ -7,6 +7,7 @@ use super::{"," };"," use assert_cmd::assert::OutputAssertExt;"," use pnpm_fs::DirLock;","+use pnpm_testing_utils::git_repo::GitRepoFixture;"," use std::{","     process::{Child, Stdio},","     thread,","@@ -922,6 +923,57 @@ fn gvs_dependency_build_scripts_see_the_workspace_root_and_hoisted_bins() {","     drop((root, mock_instance));"," }"," ","+/// A git dependency's build runs in every global-virtual-store slot of its","+/// commit, not only in the first one. The override moves its dependency, so","+/// the second install links the same commit into a new slot, which reads the","+/// store-index row the first install wrote","+/// ([pnpm/pnpm#17224](https://github.com/pnpm/pnpm/issues/17224)).","+#[test]","+fn gvs_builds_each_slot_of_a_git_dependency() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { store_dir, mock_instance, .. } = npmrc_info;","+","+    let repo = GitRepoFixture::init(root.path(), \"native-addon\");","+    repo.write_file(","+        \"package.json\",","+        &serde_json::json!({","+            \"name\": \"native-addon\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"@pnpm.e2e/dep-of-pkg-with-1-dep\": \"^100.0.0\" },","+            \"scripts\": { \"install\": r#\"node -e \"require('fs').writeFileSync('built', '')\"\"# },","+        })","+        .to_string(),","+    );","+    let spec = repo.git_url_at(&repo.commit(\"init\"));","+    write_manifest(&workspace, &serde_json::json!({ \"native-addon\": spec }));","+    let allow_builds = allow_builds_yaml(&[(&format!(\"native-addon@{spec}\"), true)]);","+","+    for dependency_version in [\"100.0.0\", \"100.1.0\"] {","+        set_gvs_workspace_yaml(","+            &workspace,","+            &format!(","+                \"{allow_builds}overrides:\\n  '@pnpm.e2e/dep-of-pkg-with-1-dep': {dependency_version}\\n\",","+            ),","+        );","+        pacquet(&workspace)","+            .with_arg(\"install\")","+            .assert()","+            .success();","+    }","+","+    let version_dir = pkg_version_dir(&store_dir, \"native-addon\", \"1.0.0\");","+    let slots = hash_dirs(&version_dir);","+    assert_eq!(slots.len(), 2, \"each dependency version must give the git dependency its own slot\");","+    for slot in slots {","+        let pkg = pkg_in_slot(&version_dir.join(&slot), \"native-addon\");","+        assert!(pkg.join(\"built\").exists(), \"the slot {slot} was not built\");","+        assert!(!pkg.join(\".pnpm-needs-build\").exists(), \"the slot {slot} is still marked unbuilt\");","+    }","+","+    drop((root, mock_instance));","+}","+"," /// Kills and reaps a spawned install when a failed assertion unwinds past it,"," /// so it cannot keep writing into the store while later tests run."," struct ReapOnDrop(Child);"],"additions":52,"deletions":0,"truncated":false},{"path":"pnpm/crates/git-fetcher/src/fetcher.rs","lines":["@@ -32,7 +32,10 @@ use crate::{"," "," use pnpm_fs_packlist::packlist;"," use pnpm_network::{redact_and_sanitize, redact_and_sanitize_multiline};","-use pnpm_package_manifest::{safe_read_package_json_from_dir, safe_read_project_manifest_from_dir};","+use pnpm_package_manifest::{","+    requires_build_from_cas_paths, safe_read_package_json_from_dir,","+    safe_read_project_manifest_from_dir,","+};"," use pnpm_reporter::Reporter;"," use pnpm_store_dir::{CafsFileInfo, PackageFilesIndex, StoreIndexWriter};"," use serde_json::Value;","@@ -133,6 +136,7 @@ impl GitFetcher<'_> {","             self.store.index_writer,","             &files_index_file,","             files_index,","+            &cas_paths,","             prepared.should_be_built,","         );"," ","@@ -191,19 +195,24 @@ pub(crate) fn packlist_of(pkg_dir: &Path) -> Result<Vec<String>, GitFetcherError"," "," /// Queue a `PackageFilesIndex` row so a future install's warm prefetch"," /// finds the snapshot in `index.db` and skips the fetch and prepare re-run.","+///","+/// `requiresBuild` is read off the stored files, as for any other package,","+/// since every virtual-store slot they are imported into runs that build.","+/// `requires_prepare` is whether the package needs `prepare`."," pub(crate) fn queue_files_index(","     writer: Option<&Arc<StoreIndexWriter>>,","     files_index_file: &str,","     files: HashMap<String, CafsFileInfo>,","-    should_be_built: bool,","+    cas_paths: &HashMap<String, PathBuf>,","+    requires_prepare: bool,"," ) {","     if let Some(writer) = writer {","         writer.queue(","             files_index_file.to_string(),","             PackageFilesIndex {","                 manifest: None,","-                requires_build: Some(should_be_built),","-                requires_prepare: Some(should_be_built),","+                requires_build: Some(requires_build_from_cas_paths(cas_paths)),","+                requires_prepare: Some(requires_prepare),","                 algo: \"sha512\".to_string(),","                 files,","                 side_effects: None,"],"additions":13,"deletions":4,"truncated":false},{"path":"pnpm/crates/git-fetcher/src/tarball_fetcher.rs","lines":["@@ -112,6 +112,7 @@ impl GitHostedTarballFetcher<'_> {","                     self.store.index_writer,","                     &key,","                     synthesize_files_index(&self.cas_paths)?,","+                    &self.cas_paths,","                     prepared.should_be_built,","                 );","             }","@@ -141,6 +142,7 @@ impl GitHostedTarballFetcher<'_> {","             self.store.index_writer,","             &files_index_file,","             files_index,","+            &cas_paths,","             prepared.should_be_built,","         );"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/git-fetcher/src/tarball_fetcher/tests.rs","lines":["@@ -383,7 +383,7 @@ async fn writes_index_row_when_writer_provided() {","     );"," ","     let key = \"x@1.0.0\\tbuilt\";","-    let received = GitHostedTarballFetcher {","+    let _received = GitHostedTarballFetcher {","         scripts: crate::PrepareScriptOptions {","             ignore: false,","             unsafe_perm: true,","@@ -422,7 +422,7 @@ async fn writes_index_row_when_writer_provided() {","         .unwrap()","         .expect(\"row must exist at the git-hosted key\");","     assert_eq!(row.algo, \"sha512\");","-    assert_eq!(row.requires_build, Some(received.built));","+    assert_eq!(row.requires_build, Some(false));","     let keys: Vec<&str> = row.files","         .keys()","         .map(String::as_str)","@@ -514,9 +514,9 @@ async fn fast_path_returns_input_cas_paths_when_no_build_needed() {"," "," /// When the fast path triggers and a writer is provided, the"," /// synthesized row must be queued at the final key with the same","-/// shape the slow path would have produced — same digests, same","-/// `requires_build: false`, same file set. A warm prefetch reading","-/// the row from `index.db` can't tell which path produced it.","+/// shape the slow path would have produced — same digests, same file","+/// set. A warm prefetch reading the row from `index.db` can't tell","+/// which path produced it."," #[tokio::test(flavor = \"multi_thread\")]"," async fn fast_path_queues_synthesized_index_row() {","     let store_root = tempdir().unwrap();","@@ -571,7 +571,7 @@ async fn fast_path_queues_synthesized_index_row() {","         .get(key)","         .unwrap()","         .expect(\"fast path must still queue a row at the final key\");","-    assert_eq!(row.requires_build, Some(false), \"fast path implies no build needed\");","+    assert_eq!(row.requires_build, Some(false), \"the package has no install scripts\");","     assert_eq!(row.algo, \"sha512\");","     let row_keys: Vec<&str> = row.files","         .keys()","@@ -871,3 +871,63 @@ async fn tarball_path_to_missing_subdir_is_rejected() {","         other => panic!(\"expected Prepare::InvalidPath, got {other:?}\"),","     }"," }","+","+/// A row's `requiresBuild` says whether the stored files ask for a build in","+/// the slot they are imported into, whether or not the fetch ran `prepare`.","+/// A warm install reads it to decide whether a new slot of the same package","+/// is built ([pnpm/pnpm#17224](https://github.com/pnpm/pnpm/issues/17224)).","+/// The extra file, which `files` leaves out, sends the second case down the","+/// slow path.","+#[tokio::test(flavor = \"multi_thread\")]","+async fn row_requires_build_for_install_scripts_without_prepare() {","+    let manifest: &[u8] =","+        br#\"{\"name\":\"x\",\"version\":\"1.0.0\",\"files\":[\"index.js\"],\"scripts\":{\"install\":\"node -e 0\"}}\"#;","+    for extra_files in [&[][..], &[(\"test.js\", &b\"test\"[..], false)][..]] {","+        let store_root = tempdir().unwrap();","+        let store_dir = StoreDir::from(store_root.path().to_path_buf());","+        let (writer, writer_task) = StoreIndexWriter::spawn(&store_dir);","+        let mut files = vec![(\"package.json\", manifest, false), (\"index.js\", &b\"x\"[..], false)];","+        files.extend_from_slice(extra_files);","+        let cas_paths = write_to_cas(&store_dir, &files);","+","+        let key = \"x@1.0.0\\tbuilt\";","+        let received = GitHostedTarballFetcher {","+            scripts: crate::PrepareScriptOptions {","+                ignore: false,","+                unsafe_perm: true,","+                user_agent: None,","+                prepend_node_path: ScriptsPrependNodePath::Never,","+                shell: None,","+                node_execpath: None,","+                npm_execpath: None,","+                running_pnpm: crate::RunningPnpm::default(),","+            },","+            store: crate::GitStoreContext {","+                dir: &store_dir,","+                index_writer: Some(&Arc::clone(&writer)),","+                files_index_file: key,","+            },","+            cas_paths,","+            path: None,","+            allow_build: allow_all_builds(),","+","+            package_id: \"x@1.0.0\",","+            requester: \"/test\",","+        }","+        .run::<SilentReporter>()","+        .await","+        .unwrap();","+        drop(writer);","+        writer_task.await.unwrap().unwrap();","+","+        assert!(!received.built, \"no `prepare` script, so the fetch builds nothing\");","+        assert!(!received.cas_paths.contains_key(\"test.js\"));","+        let row = StoreIndex::open_in(&store_dir)","+            .unwrap()","+            .get(key)","+            .unwrap()","+            .expect(\"the fetch queues a row\");","+        assert_eq!(row.requires_build, Some(true), \"extra files: {extra_files:?}\");","+        assert_eq!(row.requires_prepare, Some(false), \"extra files: {extra_files:?}\");","+    }","+}"],"additions":66,"deletions":6,"truncated":false},{"path":"pnpm/crates/tarball/src/prefetch.rs","lines":["@@ -363,11 +363,19 @@ where","     triggers.requires_build()"," }"," ","+/// A git-hosted row (one that records `requiresPrepare`) with no bundled","+/// manifest derives `requiresBuild` from its files and ignores the stored","+/// value, which existing stores may hold wrong","+/// ([pnpm/pnpm#17224](https://github.com/pnpm/pnpm/issues/17224))."," fn resolve_row_requires_build(","     stored: Option<bool>,","+    stored_requires_prepare: Option<bool>,","     manifest: Option<&serde_json::Value>,","     cas_paths: &HashMap<String, PathBuf>,"," ) -> bool {","+    if stored_requires_prepare.is_some() && manifest.is_none() {","+        return requires_build_from_cas_paths(cas_paths);","+    }","     match stored {","         Some(true) if stored_requires_build_needs_manifest_check(manifest, cas_paths.keys()) => {","             requires_build_from_cas_paths(cas_paths)","@@ -401,6 +409,7 @@ fn collect_prefetch_result(decoded: Vec<DecodedPrefetchRow>) -> PrefetchResult {","         }","         let calculated_requires_build = resolve_row_requires_build(","             stored_req