>","+```","+","+The callback receives an empty array when all checked targets are met. Ramp warnings identify the affected ramp and step. Contrast warnings identify the semantic foreground/background token pair and include the required and achieved contrast values. React may invoke the callback more than once in development under Strict Mode.","+"," The `cursor` prop accepts an object with the following optional properties:"," "," -   `control`: The cursor style for interactive controls that are not links (e.g. buttons, checkboxes, and toggles). Accepts `'default'` or `'pointer'` (default: `'pointer'`)."],"additions":18,"deletions":0,"truncated":false},{"path":"packages/theme/src/color-ramps/lib/constants.ts","lines":["@@ -56,17 +56,12 @@ export const CONTRAST_COMBINATIONS: {"," \t\ttarget: 4.5,"," \t},"," \t{","-\t\tbgs: [ 'bgFill1' ],","+\t\tbgs: [ 'bgFill1', 'bgFill2' ],"," \t\tfgs: [ 'fgFill' ],"," \t\ttarget: 4.5,"," \t},"," \t{","-\t\tbgs: [ 'bgFillInverted1' ],","-\t\tfgs: [ 'fgFillInverted' ],","-\t\ttarget: 4.5,","-\t},","-\t{","-\t\tbgs: [ 'bgFillInverted1' ],","+\t\tbgs: [ 'bgFillInverted1', 'bgFillInverted2' ],"," \t\tfgs: [ 'fgFillInverted' ],"," \t\ttarget: 4.5,"," \t},"],"additions":2,"deletions":7,"truncated":false},{"path":"packages/theme/src/color-ramps/lib/index.ts","lines":["@@ -55,7 +55,7 @@ function calculateRamp( {"," \t};"," } ) {"," \tconst rampResults = {} as Record< keyof Ramp, string >;","-\tlet warnings: string[] | undefined;","+\tlet warnings: ( keyof Ramp )[] | undefined;"," \tlet maxDeficit = -Infinity;"," \tlet maxDeficitDirection: RampDirection = 'lighter';"," \tlet maxDeficitStep;","@@ -255,6 +255,7 @@ export function buildRamp("," \t} );"," "," \tlet bestRamp = rampResults;","+\tlet bestWarnings = warnings;"," "," \tif ( maxDeficit > CONTRAST_EPSILON && rescaleToFitContrastTargets ) {"," \t\tconst iterSteps = stepsForStep( maxDeficitStep!, config );","@@ -299,14 +300,16 @@ export function buildRamp("," \t\t);"," "," \t\t// Calcula