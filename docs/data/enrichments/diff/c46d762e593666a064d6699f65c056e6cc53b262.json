's mappings merged in","+const declared = {","+  ...oauthProvider({ loginPage: '/', consentPage: '/' }).schema,","+  ...jwt().schema,","+} as Record<string, { fields: Record<string, DeclaredField> }>;","+","+const mappings: Record<string, Mapping> = { ...ghostOAuthProviderSchema, ...ghostJwtSchema };","+","+describe('ghost-models', function () {","+  it('maps every model the provider and jwt plugins declare', function () {","+    assert.deepEqual(Object.keys(mappings).toSorted(), Object.keys(declared).toSorted());","+  });","+","+  for (const [model, { fields }] of Object.entries(declared)) {","+    describe(model, function () {","+      const mapping = mappings[model];","+      const table = mapping && tables[mapping.modelName];","+      const columnOf = (field: string) => mapping?.fields[field] ?? field;","+","+      it('has a table in schema.ts', function () {","+        assert.ok(table, `${mapping?.modelName} is in schema.ts`);","+      });","+","+      it('maps every declared field onto a column', function () {","+        const missing = Object.keys(fields)","+          .filter((field) => !table || !(columnOf(field) in table))","+          .map((field) => `${field} -> ${columnOf(field)}`);","+        assert.deepEqual(missing, []);","+      });","+","+      it('maps no field the plugin does not declare', function () {","+        const extra = Object.keys(mapping?.fields ?? {}).filter((field) => !(field in fields));","+        assert.deepEqual(extra, []);","+      });","+","+      it('makes a column NOT NULL exactly where the plugin requires its field', function () {","+        const mismatched = Object.entries(fields).flatMap(([field, { required }]) => {","+          const column = table?.[columnOf(field)];","+          if (!column) {","+            return [];","+          }","+          const isRequired = required !== false;","+          const isNullable = column.nullable === true;","+          // A NOT NULL column for an optional field holds only with a default to fill it","+          if (isRequired ? isNullable : !isNullable && !('defaultTo' in column)) {","+            return [`${field} (${isRequired ? 'required' : 'optional'}) -> ${columnOf(field)}`];","+          }","+          return [];","+        });","+        assert.deepEqual(mismatched, []);","+      });","+    });","+  }","+});"],"additions":69,"deletions":0,"truncated":false},{"path":"ghost/test/utils/db-utils.js","lines":["@@ -13,6 +13,7 @@ const knexMigrator = new KnexMigrator({ knexMigratorFilePath: path.join(__dirnam"," const config = require('../../core/shared/config');"," const db = require('../../core/server/data/db');"," const schema = require('../../core/server/data/schema').tables;","+const schemaCommands = require('../../core/server/data/schema').commands;"," const schemaTables = Object.keys(schema);"," "," // Other Test Utilities","@@ -126,19 +127,22 @@ const restoreTemplateRows = async () => {"," const truncateAll = async () => {","   debug('Database teardown');"," ","-  const tables = getResetTables();","-","   await db.knex.transaction(async (trx) => {","     try {","+      // A table can be missing, e.g. an in-development table dropped by a migration that","+      // replaces a table it references, so only the existing ones are emptied","+      const existingTables = await schemaCommands.getTables(trx);","+      const tables = getResetTables().filter((table) => existingTables.includes(table));","+","       await db.knex.raw('SET FOREIGN_KEY_CHECKS=0;').transacting(trx);","       for (const table of tables) {","         await db.knex.raw('DELETE FROM ' + table + ';').transacting(trx);","       }","       await db.knex.raw('SET FOREIGN_KEY_CHECKS=1;').transacting(trx);","     } catch (err) {","-      // CASE: table does not exist || DB does not exist","-      // If the table or DB are not present, we can safely ignore","-      if (err.errno === 1146 || err.errno === 1049) {","+      // CASE: DB does not exist","+      // If the DB is not present, we can safely ignore","+      if (err.errno === 1049) {","         return Promise.resolve();","       }"," "],"additions":9,"deletions":5,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -167,6 +167,9 @@ catalogs:","     '@better-auth/core':","       specifier: 1.7.25","       version: 1.7.25","+    '@better-auth/oauth-provider':","+      specifier: 1.7.25","+      version: 1.7.25","     '@better-auth/test-utils':","       specifier: 1.7.25","       version: 1.7.25","@@ -2202,6 +2205,9 @@ importers:","       '@better-auth/core':","         specifier: 'catalog:'","         version: 1.7.25(@better-auth/utils@0.5.1)(@better-fetch/fetch@1.3.3)(@opentelemetry/api@1.9.1)(better-call@1.4.5(zod@4.6.7(patch_hash=011cbd2c390354e6d9b4a7c1d83ee357aec0ab419beb9a74d91587ce9b33c6a6)))(jose@6.2.17)(kysely@0.29.8)(nanostores@1.5.5)","+      '@better-auth/oauth-provider':","+        specifier: 'catalog:'","+        version: 1.7.25(@better-auth/core@1.7.25(@better-auth/utils@0.5.1)(@better-fetch/fetch@1.3.3)(@opentelemetry/api@1.9.1)(better-call@1.4.5(zod@4.6.7(patch_hash=011cbd2c390354e6d9b4a7c1d83ee357aec0ab419beb9a74d91587ce9b33c6a6)))(jose@6.2.17)(kysely@0.29.8)(nanostores@1.5.5))(@better-auth/utils@0.5.1)(@better-fetch/fetch@1.3.3)(better-auth@1.7.25(@opentelemetry/api@1.9.1))(better-call@1.4.5(zod@4.6.7(patch_hash=011cbd2c390354e6d9b4a7c1d83ee357aec0ab419beb9a74d91587ce9b33c6a6)))","       '@breejs/later':","         specifier: 'catalog:'","         version: 4.2.0","@@ -5072,6 +5078,15 @@ packages:","       mongodb:","         optional: true"," ","+  '@better-auth/oauth-provider@1.7.25':","+    resolution: {integrity: sha512-P0KkIkcXBcoMYZTJzKdzmOo2c+AN1ZjIA5C0x/F5E8TBQR4q5STMlfvp1YwfYx8R8e6H9ve7CCOjYwoJX0urVQ==}","+    peerDependencies:","+      '@better-auth/core': ^1.7.25","+      '@better-auth/utils': ^0.4.2 || ^0.5.0","+      '@better-fetch/fetch': 1.3.3","+      better-auth: ^1.7.25","+      better-call: ~1.4.5","+","   '@better-auth/prisma-adapter@1.7.25':","   