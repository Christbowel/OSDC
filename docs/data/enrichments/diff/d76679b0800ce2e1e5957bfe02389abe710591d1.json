 'HTTP/');","+        }));","+    }","+","     private function getTrackerWithCountedRequests()","     {","         $tracker = new Tracker();"],"additions":59,"deletions":0,"truncated":false},{"path":"tests/PHPUnit/System/TrackerResponseTest.php","lines":["@@ -230,6 +230,10 @@ public function testResponseShouldReturnPiwikMessageWithHttp503InCaseOfMaintenan","         $url = $url . \"&forceEnableTrackerMaintenanceMode=1\";","         $response = $this->sendHttpRequest($url);","         $this->assertEquals(503, $response['status']);","+","+        $response = $this->sendHttpRequest($url . '&send_image=0');","+        $this->assertEquals(503, $response['status']);","+        $this->assertSame('', $response['data']);","     }"," ","     protected function sendHttpRequest($url)"],"additions":4,"deletions":0,"truncated":false},{"path":"tests/PHPUnit/Unit/Tracker/ResponseTest.php","lines":["@@ -215,6 +215,22 @@ public function testOutputResponseShouldOutputApiResponseIfTrackerIsDisabled()","         $this->response->outputResponse($tracker);"," ","         Fixture::checkResponse($this->response->getOutput());","+        $this->assertSame(['HTTP/1.1 503 Service Unavailable'], $this->getSentStatusLines());","+    }","+","+    public function testOutputResponseShouldKeep503IfTrackerIsDisabledAndNoImageIsRequested()","+    {","+        $tracker = $this->getTracker();","+        $tracker->setCountOfLoggedRequests(0);","+        $tracker->disableShouldRecordStatistics();","+        $this->response->init($tracker);","+","+        $_GET['send_image'] = '0';","+        $this->response->outputResponse($tracker);","+        unset($_GET['send_image']);","+","+        $this->assertEquals('', $this->response->getOutput());","+        $this->assertSame(['HTTP/1.1 503 Service Unavailable'], $this->getSentStatusLines());","     }"," ","     public function testOutputResponseShouldOuputCustomImageIfCustomBase64ImageSet()",""],"additions":16,"deletions":0,"truncated":false}],"additions":123,