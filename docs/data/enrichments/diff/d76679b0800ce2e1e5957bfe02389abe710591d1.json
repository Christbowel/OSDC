houldSendResponse = true;"," ","+    private bool $isExceptionOutput = false;","+","     /**","      * Echos an error message & other information, then exits.","      *","@@ -34,6 +36,7 @@ class Response extends Tracker\\Response","      */","     public function outputException(Tracker $tracker, Exception $e, $statusCode)","     {","+        $this->isExceptionOutput = true;","         Common::sendResponseCode($statusCode);"," ","         $this->logExceptionToErrorLog($e);","@@ -45,6 +48,21 @@ public function outputException(Tracker $tracker, Exception $e, $statusCode)"," ","     public function outputResponse(Tracker $tracker)","     {","+        if ($this->isExceptionOutput) {","+            return;","+        }","+","+        // also when tracker debug output was printed, like for a single request","+        if (!$tracker->shouldRecordStatistics()) {","+            Common::sendResponseCode(503);","+","+            if ($this->shouldSendResponse() && !$this->hasAlreadyPrintedOutput()) {","+                echo json_encode(['status' => 'error', 'tracked' => 0, 'invalid' => 0]);","+            }","+","+            return;","+        }","+","         if ($this->hasAlreadyPrintedOutput()) {","             return;","         }"],"additions":18,"deletions":0,"truncated":false},{"path":"plugins/BulkTracking/tests/System/TrackerTest.php","lines":["@@ -113,6 +113,23 @@ public function testResponseShouldSend401Or403ResponseCodeIfAuthenticationIsRequ","         }","     }"," ","+    public function testResponseShouldSend503ResponseCodeIfTrackingIsDisabled()","+    {","+        $testingEnvironment = new TestingEnvironmentVariables();","+        $testingEnvironment->overrideConfig('Tracker', 'record_statistics', 0);","+        $testingEnvironment->save();","+","+        try {","+            $response = $this->sendBulkRequest('{\"requests\":[\"?idsite=1&rec=1&url=http%3A%2F%2Fexample.org%2F\"]}');","+        } finally {","+            $testingEnvironment->removeOverriddenConfig('Tracker', 'record_statistics');","+            $testingEnvironment->save();","+        }","+","+        $this->assertEquals(503, $response['status']);","+        $this->assertEquals('{\"status\":\"error\",\"tracked\":0,\"invalid\":0}', $response['data']);","+    }","+","     private function sendBulkRequest(string $body): array","     {","         return Http::sendHttpRequestBy("],"additions":17,"deletions":0,"truncated":false},{"path":"plugins/BulkTracking/tests/Unit/ResponseTest.php","lines":["@@ -9,6 +9,7 @@"," "," namespace Piwik\\Plugins\\BulkTracking\\tests\\Unit;"," ","+use Piwik\\Common;"," use Piwik\\Plugins\\BulkTracking\\Tracker\\Response;"," use Piwik\\Tests\\Framework\\Mock\\Tracker;"," use Piwik\\Tests\\Framework\\TestCase\\UnitTestCase;","@@ -30,6 +31,7 @@ public function setUp(): void","     {","         parent::setUp();"," ","+        Common::$headersSentInTests = [];","         $mock = self::getMockBuilder(Response::class)->onlyMethods(['logExceptionToErrorLog']);","         $this->response = $mock->getMock();","         $this->response->init(new Tracker());","@@ -66,6 +68,53 @@ public function testOutputResponseShouldOutputBulkResponse()","         $this->assertEquals('{\"status\":\"success\",\"tracked\":5,\"invalid\":0}', $content);","     }"," ","+    public function testOutputResponseShouldAnswer503IfTrackerIsDisabled()","+    {","+        $tracker = new Tracker();","+        $tracker->disableShouldRecordStatistics();","+","+        $this->response->outputResponse($tracker);","+","+        $this->assertEquals('{\"status\":\"error\",\"tracked\":0,\"invalid\":0}', $this->response->getOutput());","+        $this->assertSame(['HTTP/1.1 503 Service Unavailable'], $this->getSentStatusLines());","+    }","+","+    public function testOutputResponseShouldAnswer503WithoutBodyIfTrackerIsDisabledAndNoResponseIsRequested()","+    {","+        $tracker = new Tracker();","+        $tracker->disableShouldRecordStatistics();","+        $this->response->setSho