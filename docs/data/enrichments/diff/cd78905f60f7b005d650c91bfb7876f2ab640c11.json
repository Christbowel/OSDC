et_output()","+        .stdout","+        .clone();","+    let result = json_test_result(&output, \"invariant_noRevertedLogs()\");","+    assert_eq!(result[\"status\"], \"Success\", \"{result}\");","+    assert_eq!(result[\"symbolic\"][\"status\"], \"pass\", \"{result}\");","+}","+"," #[forgetest_init]"," fn symbolic_invariant_does_not_inherit_prank_into_nested_call(prj: _, cmd: _) {","     skip_unless_z3!(\"symbolic_invariant_does_not_inherit_prank_into_nested_call\");"],"additions":56,"deletions":0,"truncated":false},{"path":"testdata/default/cheats/RecordLogs.t.sol","lines":["@@ -47,6 +47,71 @@ contract Emitterv2 {","     }"," }"," ","+contract RevertingEmitter is Test {","+    event Emitted(uint256 value);","+","+    uint256 stored;","+","+    function emitValue(uint256 value) external {","+        emit Emitted(value);","+    }","+","+    function emitAndRevert(uint256 value) external {","+        emit Emitted(value);","+        revert(\"reverted\");","+    }","+","+    function emitAndHalt(uint256 value) external {","+        emit Emitted(value);","+        assembly {","+            invalid()","+        }","+    }","+","+    function emitAroundCaughtRevert(uint256 value) external {","+        emit Emitted(value);","+        try this.emitAndRevert(value + 1) {} catch {}","+        emit Emitted(value + 2);","+    }","+","+    function drainEmitAndRevert(uint256 value) external {","+        vm.getRecordedLogs();","+        emit Emitted(value);","+        revert(\"reverted\");","+    }","+","+    function drainInChildEmitAndRevert(uint256 value) external {","+        this.drain();","+        emit Emitted(value);","+        revert(\"reverted\");","+    }","+","+    function drain() external {","+        vm.getRecordedLogsJson();","+    }","+","+    function storeEmitAndRevert(uint256 value) external {","+        emit Emitted(value);","+        stored = value;","+        revert(\"reverted\");","+    }","+","+    function resetEmitAndRevert(uint256 value) external {",