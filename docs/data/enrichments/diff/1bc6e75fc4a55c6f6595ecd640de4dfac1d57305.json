{"id":"1bc6e75fc4a55c6f6595ecd640de4dfac1d57305","axis":"silent","repo":"matomo-org/matomo","sha":"1bc6e75fc4a55c6f6595ecd640de4dfac1d57305","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -10,6 +10,8 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," * `[log] log_format` (and `log_format_<writer>` per writer) lets the file, database, errorlog and syslog log writers write `json`, `loggly` or `logstash` instead of `text`."," "," ### New APIs","+* Controller actions can ask the user to confirm with their second factor, e.g. a two-factor authentication code, by calling `Piwik\\Plugins\\Login\\SecondFactorVerifier::requireSecondFactorConfirmed()`. Each confirmation can be used once, for that action only.","+* Plugins that provide a second factor answer the new events `Login.userRequiresSecondFactorConfirmation` and `Login.verifySecondFactor`."," * The *Administration → Development → Component Library* page, available in development mode, documents the generic components, starting with the selector (`.mtm-selector`), and what each Matomo version changes in them."," * The `ExpandOnHover` Vue directive now takes the `expandedClass` option of `ExpandOnClick`, and both directives accept a list of classes for it."," * The Monolog plugin's DI entry `log.formatter.classes` maps log format names to formatter classes and can be extended by plugins to add log formats."],"additions":2,"deletions":0,"truncated":false},{"path":"plugins/Login/Controller.php","lines":["@@ -291,6 +291,56 @@ public function confirmPassword()","         ]);","     }"," ","+    /**","+     * Asks the user to confirm a sensitive action with their second factor, see {@link SecondFactorVerifier}.","+     */","+    public function confirmSecondFactor(): string","+    {","+        Piwik::checkUserIsNotAnonymous();","+        Piwik::checkUserHasSomeViewAccess();","+","+        $secondFactorVerifier = StaticContainer::get(SecondFactorVerifier::class);","+        $requestId = Request::fromRequest()->getStringParameter(SecondFactorVerifier::REQUEST_ID_PARAMETER, '');","+","+        if (!$secondFactorVerifier->hasConfirmationBeenRequested($requestId)) {","+            // completed or expired, nothing left to confirm","+            Url::redirectToUrl('index.php');","+        }","+","+        if (!Url::isValidHost()) {","+            throw new BadRequestException(\"Cannot confirm second factor with untrusted hostname!\");","+        }","+","+        $nonceKey = 'confirmSecondFactor';","+        $messageNoAccess = '';","+        $request = Request::fromPost();","+","+        if ($request->getParameters() !== []) {","+            $nonce = $request->getStringParameter('nonce', '');","+            $code = trim($request->getStringParameter('code', ''));","+            $errorMessage = Nonce::verifyNonceWithErrorMessage($nonceKey, $nonce);","+            if ($errorMessage !== '') {","+                $messageNoAccess = $errorMessage;","+            } else {","+                $redirectUrl = $code === '' ? null : $secondFactorVerifier->confirmSecondFactor($requestId, $code);","+                if ($redirectUrl !== null) {","+                    Url::redirectToUrl($redirectUrl);","+                }","+","+                $messageNoAccess = Piwik::translate('Login_WrongSecondFactorCode');","+            }","+        }","+","+        return $this->renderTemplate('@Login/confirmSecondFactor', [","+            'nonce'             => Nonce::getNonce($nonceKey),","+            'requestId'         => $requestId,","+            'AccessErrorString' => $messageNoAccess,","+            // the page can be served by another plugin's action, see SecondFactorVerifier","+            'confirmModule'     => Piwik::getModule() ?: $this->pluginName,","+            'whatsNewChanges'   => $this->getWhatsNewChanges(),","+        ]);","+    }","+","     /**","      * Form-less login","      * @see how to use it on https://matomo.org/faq/how-to/faq_30"],"additions":50,"deletions":0,"truncated":false},{"path":"plugins/Login/SecondFactorVerifier.php","lines":["@@ -0,0 +1,422 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Plugins\\Login;","+","+use Piwik\\Container\\StaticContainer;","+use Piwik\\Date;","+use Piwik\\Exception\\NoPrivilegesException;","+use Piwik\\IP;","+use Piwik\\Piwik;","+use Piwik\\Plugin\\Manager as PluginManager;","+use Piwik\\Plugins\\Login\\Security\\BruteForceDetection;","+use Piwik\\Request;","+use Piwik\\Session\\SessionNamespace;","+use Piwik\\Url;","+","+/**","+ * Requires the current user to confirm a sensitive action with their second factor, e.g. a two-factor","+ * authentication code.","+ *","+ * Unlike a password confirmation done through {@link PasswordVerifier}, a second-factor confirmation is not","+ * valid for a period of time: each confirmation is used up by the first request using it, is only valid for the","+ * action it was requested for, and only reaches the browser that entered the code. Users without a second factor","+ * are not asked for one.","+ *","+ * Plugins providing a second factor answer the `Login.userRequiresSecondFactorConfirmation` and","+ * `Login.verifySecondFactor` events. Failed codes count towards the brute force detection.","+ *","+ * Usage in a controller action, typically after a password confirmation:","+ *","+ *     $params = ['module' => 'MyPlugin', 'action' => 'mySensitiveAction'];","+ *     if (!$secondFactorVerifier->requireSecondFactorConfirmed($params)) {","+ *         return;","+ *     }","+ *     // perform the sensitive action","+ *","+ * @api","+ */","+class SecondFactorVerifier","+{","+    /**","+     * Query parameter identifying a pending request on the confirmation page.","+     */","+    public const REQUEST_ID_PARAMETER = 'secondFactorRequest';","+","+    /**","+     * Query parameter carrying a confirmation back to the action.","+     */","+    public const CONFIRMATION_TOKEN_PARAMETER = 'secondFactorToken';","+","+    /**","+     * Minutes the user has to confirm a request.","+     */","+    public const REQUEST_VALID_FOR_MINUTES = 30;","+","+    /**","+     * Minutes a confirmation stays usable; it only needs to cover the redirect back to the action.","+     */","+    public const CONFIRMATION_VALID_FOR_MINUTES = 5;","+","+    private const MAX_ENTRIES = 10;","+    private const REQUESTS = 'secondFactorRequests';","+    private const CONFIRMATIONS = 'secondFactorConfirmations';","+","+    private ?Date $now = null;","+","+    private bool $enableRedirect = true;","+","+    /**","+     * @ignore tests only","+     */","+    public function setDisableRedirect(): void","+    {","+        $this->enableRedirect = false;","+    }","+","+    /**","+     * @ignore tests only","+     */","+    public function setNow(Date $now): void","+    {","+        $this->now = $now;","+    }","+","+    /**","+     * Returns whether the given user has a second factor that has to be confirmed.","+     */","+    public function isSecondFactorRequired(string $login): bool","+    {","+        $requiresSecondFactor = false;","+","+        /**","+         * Triggered to check if a user has to confirm sensitive actions with a second factor.","+         *","+         * Plugins providing a second factor, such as two-factor authentication, set `$requiresSecondFactor`","+         * to `true` for users who have it configured. They also need to verify the codes in","+         * `Login.verifySecondFactor`.","+         *","+         * **Example**","+         *","+         *     public function userRequiresSecondFactorConfirmation(bool &$requiresSecondFactor, string $login): void","+         *     {","+         *         if ($this->hasDeviceConfigured($login)) {","+         *             $requiresSecondFactor = true;","+         *         }","+         *     }","+         *","+         * @param bool &$requiresSecondFactor Whether a second factor confirmation is required","+         * @param string $login Login of the user","+         */","+        Piwik::postEvent('Login.userRequiresSecondFactorConfirmation', [&$requiresSecondFactor, $login]);","+","+        /** @var mixed $requiresSecondFactor set by reference in the event; any truthy value requires it */","+        return (bool) $requiresSecondFactor;","+    }","+","+    /**","+     * Returns `true` if the current request carries a confirmation of the user's second factor for the given","+     * action, or if the user has no second factor. The confirmation is used up by this call, so the action has","+     * to perform the sensitive operation right away.","+     *","+     * Otherwise, the user is redirected to the confirmation page, which redirects back to the action once","+     * confirmed. Returns `false` if redirects are disabled.","+     *","+     * @param array<string, string|int> $redirectParams The query parameters of the action, including `module`","+     *                                                  and `action`. Values are URL encoded when redirecting.","+     */","+    public function requireSecondFactorConfirmed(array $redirectParams): bool","+    {","+        $login = Piwik::getCurrentUserLogin();","+","+        if (!$this->isSecondFactorRequired($login)) {","+            return true;","+        }","+","+        $token = Request::fromRequest()->getStringParameter(self::CONFIRMATION_TOKEN_PARAMETER, '');","+        if ($token !== '' && $this->consumeConfirmation($token, $login, $redirectParams)) {","+            return true;","+        }","+","+        $requestId = $this->requestConfirmation($redirectParams);","+","+        if ($this->enableRedirect) {","+            Piwik::redirectToModule($this->getConfirmationModule($redirectParams), 'confirmSecondFactor', [","+                self::REQUEST_ID_PARAMETER => $requestId,","+            ]);","+        }","+","+        return false;","+    }","+","+    /**","+     * Records that the current user needs to confirm the given action and returns the id of that request,","+     * which the confirmation page needs. Prefer {@link requireSecondFactorConfirmed()}.","+     *","+     * @param array<string, string|int> $redirectParams","+     */","+    public function requestConfirmation(array $redirectParams): string","+    {","+        $requestId = $this->generateRandomId();","+","+        $requests = $this->getEntries(self::REQUESTS, self::REQUEST_VALID_FOR_MINUTES);","+        $requests[$requestId] = [","+            'login' => Piwik::getCurrentUserLogin(),","+            'params' => $redirectParams,","+            'time' => $this->getNow()->getTimestamp(),","+        ];","+        $this->setEntries(self::REQUESTS, $requests, self::REQUEST_VALID_FOR_MINUTES);","+","+        return $requestId;","+    }","+","+    /**","+     * Returns whether the given confirmation request is pending for the current user.","+     */","+    public function hasConfirmationBeenRequested(string $requestId): bool","+    {","+        return $this->getPendingRequest($requestId) !== null;","+    }","+","+    /**","+     * Verifies the given code for the current user and the given confirmation request. If it is valid, returns","+     * the URL of the action to redirect to. That URL carries a one-time token which lets the action proceed once.","+     * Returns `null` if the code is not valid or the request is not pending.","+     *","+     * Failed attempts count towards the brute force detection.","+     */","+    public function confirmSecondFactor(","+        string $requestId,","+        #[\\SensitiveParameter]","+        string $code","+    ): ?string {","+        $request = $this->getPendingRequest($requestId);","+","+        if ($request === null || !$this->verifyCode($request['login'], $code)) {","+            return null;","+        }","+","+        $requests = $this->getEntries(self::REQUESTS, self::REQUEST_VALID_FOR_MINUTES);","+        unset($requests[$requestId]);","+        $this->setEntries(self::REQUESTS, $requests, self::REQUEST_VALID_FOR_MINUTES);","+","+        $params = $request['params'];","+        $params[self::CONFIRMATION_TOKEN_PARAMETER] = $this->storeConfirmation($request['login'], $params);","+        $params = array_map(static fn ($value): string => rawurlencode((string) $value), $params);","+","+        return 'index.php' . Url::getCurrentQueryStringWithParametersModified($params);","+    }","+","+    private function verifyCode(","+        string $login,","+        #[\\SensitiveParameter]","+        string $code","+    ): bool {","+        // not through the Login plugin's events, which are not posted while it is deactivated","+        $bruteForce = StaticContainer::get(BruteForceDetection::class);","+        $isBruteForceDetectionEnabled = $bruteForce->isEnabled();","+        $ip = IP::getIpFromHeader();","+","+        if ($isBruteForceDetectionEnabled && !$bruteForce->isAllowedToLogin($ip)) {","+            throw new NoPrivilegesException(Piwik::translate('Login_LoginNotAllowedBecauseBlocked'), 403);","+        }","+","+        if ($isBruteForceDetectionEnabled && $bruteForce->isUserLoginBlocked($login)) {","+            throw new NoPrivilegesException(Piwik::translate('Login_LoginNotAllowedBecauseUserLoginBlocked'), 403);","+        }","+","+        $isValid = false;","+","+        /**","+         * Triggered to verify a code the user entered to confirm a sensitive action with their second factor.","+         *","+         * Plugins that require a second factor in `Login.userRequiresSecondFactorConfirmation` set `$isValid`","+         * to `true` if the code is valid for the user. A code should only be accepted once.","+         *","+         * **Example**","+         *","+         *     public function verifySecondFactor(bool &$isValid, string $login, string $code): void","+         *     {","+         *         if (!$isValid && $this->hasDeviceConfigured($login)) {","+         *             $isValid = $this->isValidCodeNotUsedBefore($login, $code);","+         *         }","+         *     }","+         *","+         * @param bool &$isValid Whether the code is valid","+         * @param string $login Login of the user","+         * @param string $code The code entered by the user","+         */","+        Piwik::postEvent('Login.verifySecondFactor', [&$isValid, $login, $code]);","+","+        /** @var mixed $isValid set by reference in the event; only true accepts the code */","+        $isAccepted = $isValid === true;","+","+        if (!$isAccepted && $isBruteForceDetectionEnabled) {","+            $bruteForce->addFailedAttempt($ip, $login);","+        }","+","+        return $isAccepted;","+    }","+","+    /**","+     * @param array<string, string|int> $params","+     */","+    private function storeConfirmation(string $login, array $params): string","+    {","+        $token = $this->generateRandomId();","+","+        $confirmations = $this->getEntries(self::CONFIRMATIONS, self::CONFIRMATION_VALID_FOR_MINUTES);","+        $confirmations[$token] = [","+            'login' => $login,","+            'module' => (string) ($params['module'] ?? ''),","+            'action' => (string) ($params['action'] ?? ''),","+            'time' => $this->getNow()->getTimestamp(),","+        ];","+        $this->setEntries(self::CONFIRMATIONS, $confirmations, self::CONFIRMATION_VALID_FOR_MINUTES);","+","+        return $token;","+    }","+","+    /**","+     * @param array<string, string|int> $redirectParams","+     */","+    private function consumeConfirmation(string $token, string $login, array $redirectParams): bool","+    {","+        $confirmations = $this->getEntries(self::CONFIRMATIONS, self::CONFIRMATION_VALID_FOR_MINUTES);","+        $confirmation = $confirmations[$token] ?? null;","+","+        if (","+            $confirmation === null","+            || ($confirmation['login'] ?? null) !== $login","+            || ($confirmation['module'] ?? null) !== (string) ($redirectParams['module'] ?? '')","+            || ($confirmation['action'] ?? null) !== (string) ($redirectParams['action'] ?? '')","+        ) {","+            return false;","+        }","+","+        unset($confirmations[$token]);","+        $this->setEntries(self::CONFIRMATIONS, $confirmations, self::CONFIRMATION_VALID_FOR_MINUTES);","+","+        return true;","+    }","+","+    /**","+     * @return array{login: string, params: array<string, string|int>}|null","+     */","+    private function getPendingRequest(string $requestId): ?array","+    {","+        $request = $this->getEntries(self::REQUESTS, self::REQUEST_VALID_FOR_MINUTES)[$requestId] ?? null;","+        $login = $request['login'] ?? null;","+        $params = $request['params'] ?? null;","+","+        if (!is_string($login) || $login !== Piwik::getCurrentUserLogin() || !is_array($params)) {","+            return null;","+        }","+","+        /** @var array<string, string|int> $params only written by requestConfirmation() */","+        return ['login' => $login, 'params' => $params];","+    }","+","+    /**","+     * Returns the module showing the confirmation page: the login plugin in use if its controller provides it, as","+     * controllers extending the Login controller do, otherwise Login. If Login is not activated either, the plugin","+     * of the action can show the page itself, as TwoFactorAuth does.","+     *","+     * @param array<string, string|int> $redirectParams","+     */","+    private function getConfirmationModule(array $redirectParams): string","+    {","+        $loginPlugin = (string) Piwik::getLoginPluginName();","+        if ($this->isPluginActivated($loginPlugin) && $this->providesConfirmationPage($loginPlugin)) {","+            return $loginPlugin;","+        }","+","+        if ($this->isPluginActivated('Login')) {","+            return 'Login';","+        }","+","+        $actionPlugin = (string) ($redirectParams['module'] ?? '');","+        if ($this->providesConfirmationPage($actionPlugin)) {","+            return $actionPlugin;","+        }","+","+        return 'Login';","+    }","+","+    private function providesConfirmationPage(string $plugin): bool","+    {","+        if (!preg_match('/^[A-Za-z0-9]+$/', $plugin)) {","+            return false;","+        }","+","+        $controllerClass = 'Piwik\\\\Plugins\\\\' . $plugin . '\\\\Controller';","+","+        return class_exists($controllerClass) && method_exists($controllerClass, 'confirmSecondFactor');","+    }","+","+    /**","+     * @ignore tests only","+     */","+    protected function isPluginActivated(string $plugin): bool","+    {","+        return PluginManager::getInstance()->isPluginActivated($plugin);","+    }","+","+    /**","+     * Returns the unexpired entries stored under the given session key.","+     *","+     * @return array<array<mixed>>","+     */","+    private function getEntries(string $key, int $validForMinutes): array","+    {","+        $entries = $this->getSession()->$key;","+","+        if (!is_array($entries)) {","+            return [];","+        }","+","+        $oldestValidTime = $this->getNow()->getTimestamp() - $validForMinutes * 60;","+","+        return array_filter(","+            $entries,","+            static fn (mixed $entry): bool => is_array($entry)","+                && is_int($entry['time'] ?? null)","+                && $entry['time'] >= $oldestValidTime","+        );","+    }","+","+    /**","+     * Stores the newest entries under the given session key, which expires with them.","+     *","+     * @param array<array<mixed>> $entries","+     */","+    private function setEntries(string $key, array $entries, int $validForMinutes): void","+    {","+        $session = $this->getSession();","+        $session->$key = array_slice($entries, -self::MAX_ENTRIES, null, true);","+        $session->setExpirationSeconds($validForMinutes * 60, $key);","+    }","+","+    private function generateRandomId(): string","+    {","+        return bin2hex(random_bytes(16));","+    }","+","+    private function getNow(): Date","+    {","+        return $this->now ?? Date::now();","+    }","+","+    private function getSession(): SessionNamespace","+    {","+        return new SessionNamespace('LoginSecondFactor');","+    }","+}"],"additions":422,"deletions":0,"truncated":false},{"path":"plugins/Login/lang/en.json","lines":["@@ -16,6 +16,8 @@","         \"ConfirmPasswordResetIntro\": \"Please type your new password to confirm you really requested having your password changed.\",","         \"ConfirmPasswordResetWrongPassword\": \"The entered password does not match your newly made one. Reset your password again if you don't remember it. Don't do anything to keep your password if you didn't request changing it.\",","         \"ConfirmPasswordToContinue\": \"Confirm your password to continue\",","+        \"ConfirmSecondFactorIntro\": \"Enter a code from your two-factor authentication, for example from your authenticator app, to confirm this action.\",","+        \"ConfirmSecondFactorToContinue\": \"Confirm with two-factor authentication to continue\",","         \"ConfirmationLinkPossiblySent\": \"If the provided details are associated with an account, you will receive an email to confirm the password reset.\",","         \"ContactAdmin\": \"Possible reason: your host may have disabled the mail() function. <br \\/>Please contact your Matomo administrator.\",","         \"CreatePasswordDescription\": \"Make sure you remember this password and keep it in a safe place.\",","@@ -83,6 +85,7 @@","         \"PleaseNote\": \"Please note\",","         \"PluginDescription\": \"Provides username and password login as well as password reset functionality. The login method can be changed by using another login plugin such as LoginLdap available on the marketplace.\",","         \"RememberMe\": \"Remember Me\",","+        \"SecondFactorCode\": \"Authentication code\",","         \"SecurityTip\": \"Security Tip\",","         \"SettingBruteForceBlacklistIp\": \"Always block these IPs from logging in\",","         \"SettingBruteForceEnable\": \"Enable Brute-force Detection\",","@@ -105,6 +108,7 @@","         \"TokenAuthenticationFailed\": \"Unable to authenticate with the provided token. It is either invalid or expired.\",","         \"TokenAuthenticationFailedInsecure\": \"Unable to authenticate with the provided token. It is either invalid, expired or is required to be sent as a POST parameter or in the HTTP Authorization header. If the token was created with the 'Only allow secure requests' option, it must be sent as a POST parameter or in the HTTP Authorization header.\",","         \"UnblockAllIPs\": \"Unblock all blocked IPs\",","-        \"WrongPasswordEntered\": \"Please enter your password.\"","+        \"WrongPasswordEntered\": \"Please enter your password.\",","+        \"WrongSecondFactorCode\": \"The authentication code is not correct. Please try again.\"","     }"," }"],"additions":5,"deletions":1,"truncated":false},{"path":"plugins/Login/templates/confirmSecondFactor.twig","lines":["@@ -0,0 +1,47 @@","+{% extends '@Login/loginLayout.twig' %}","+","+{% set title %}{{ 'Login_ConfirmSecondFactorToContinue'|translate }}{% endset %}","+","+{% block loginContent %}","+    <div class=\"contentForm loginForm confirmSecondFactorForm\">","+        {% embed 'contentBlock.twig' with {'title': ('Login_ConfirmSecondFactorToContinue'|translate)} %}","+        {% block content %}","+            <p>{{ 'Login_ConfirmSecondFactorIntro'|translate }}</p>","+","+            <div class=\"message_container\">","+                {% if AccessErrorString %}","+                    <div vue-entry=\"CoreHome.Notification\"","+                         noclear=\"true\"","+                         context=\"error\">","+                        <strong>{{ 'General_Error'|translate }}</strong>: {{ AccessErrorString|raw }}<br/>","+                    </div>","+                {% endif %}","+            </div>","+            <br>","+","+            <form id=\"confirm_second_factor_form\"","+                  action=\"{{ linkTo({'module': confirmModule, 'action': 'confirmSecondFactor', 'secondFactorRequest': requestId})|e('html_attr') }}\" method=\"post\">","+                <div class=\"row\">","+                    <div class=\"col s12 input-field\">","+                        <input type=\"hidden\" name=\"nonce\" id=\"second_factor_form_nonce\" value=\"{{ nonce|e('html_attr') }}\"/>","+                        <input type=\"text\" placeholder=\"\" name=\"code\" id=\"second_factor_form_code\" class=\"input\" value=\"\"","+                               autocomplete=\"one-time-code\" autocorrect=\"off\" autocapitalize=\"none\" spellcheck=\"false\"","+                               tabindex=\"20\" autofocus required />","+                        <label for=\"second_factor_form_code\"><i class=\"icon-locked icon\"></i> {{ 'Login_SecondFactorCode'|translate }}</label>","+                    </div>","+                </div>","+","+                <div class=\"row actions\">","+                    <div class=\"col s12\">","+                        <input class=\"submit btn\" id=\"second_factor_form_submit\" type=\"submit\" value=\"{{ 'General_Confirm'|translate }}\"","+                               tabindex=\"100\"/>","+                    </div>","+                </div>","+","+            </form>","+","+        {% endblock %}","+        {% endembed %}","+    </div>","+","+{% endblock %}"],"additions":47,"deletions":0,"truncated":false},{"path":"plugins/Login/tests/Integration/ControllerTest.php","lines":["@@ -22,11 +22,13 @@"," use Piwik\\Plugins\\Login\\Controller;"," use Piwik\\Plugins\\Login\\PasswordResetter;"," use Piwik\\Plugins\\Login\\PasswordVerifier;","+use Piwik\\Plugins\\Login\\SecondFactorVerifier;"," use Piwik\\Plugins\\Login\\Security\\BruteForceDetection;"," use Piwik\\