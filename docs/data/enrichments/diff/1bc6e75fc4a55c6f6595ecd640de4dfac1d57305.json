ndFactor();","+","+        $this->assertStringContainsString('Login_WrongSecondFactorCode', $html);","+        $this->assertTrue(StaticContainer::get(SecondFactorVerifier::class)->hasConfirmationBeenRequested($requestId));","+    }","+","+    public function testConfirmSecondFactorRedirectsBackToTheActionForAValidCode()","+    {","+        $this->requestSecondFactorConfirmation();","+","+        $_POST['nonce'] = Nonce::getNonce('confirmSecondFactor');","+        $_POST['code'] = 'valid-code';","+","+        $this->expectExceptionMessageMatches(","+            '/would redirect you to this URL: index\\.php\\?.*module=UsersManager&action=userSecurity&secondFactorToken=[0-9a-f]{32}/'","+        );","+","+        $this->controller->confirmSecondFactor();","+    }","+","+    private function requestSecondFactorConfirmation(): string","+    {","+        $verifier = new SecondFactorVerifier();","+        $requestId = $verifier->requestConfirmation(['module' => 'UsersManager', 'action' => 'userSecurity']);","+        $_GET[SecondFactorVerifier::REQUEST_ID_PARAMETER] = $requestId;","+","+        return $requestId;","+    }","+","+    public function provideContainerConfig()","+    {","+        return [","+            // every user has a second factor, as e.g. TwoFactorAuth provides it","+            'observers.global' => DI::add([","+                ['Login.userRequiresSecondFactorConfirmation', DI::value(function (&$required) {","+                    $required = true;","+                })],","+                ['Login.verifySecondFactor', DI::value(function (&$isValid, $login, $code) {","+                    $isValid = $code === 'valid-code';","+                })],","+            ]),","+        ];","+    }","+","     public function testDeclineInvitationWithoutTokenIsABadRequestWithoutRecordingAFailedAttempt()","     {","         $this->assertInvitationFailure(function () {"],"additions":76,"deletions":0,"truncated":false},{"path":"plugins/Login/tests/Integration/SecondFac