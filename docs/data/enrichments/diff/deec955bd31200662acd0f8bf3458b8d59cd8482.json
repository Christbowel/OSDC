g.T) {","+\tt.Run(\"names the backup file after the current UTC time\", func(t *testing.T) {","+\t\tconst now, expectedFileName = 1794557785826, \"k0s_backup_2026-11-13T08_16_25_826Z.tar.gz\"","+\t\tconfigPath := filepath.Join(t.TempDir(), \"k0s.yaml\")","+\t\trequire.NoError(t, os.WriteFile(configPath, nil, 0644))","+\t\tvars := &config.CfgVars{DataDir: t.TempDir(), StartupConfigPath: configPath}","+\t\tnodeSpec := &v1beta1.ClusterSpec{Storage: &v1beta1.StorageSpec{","+\t\t\tType: v1beta1.KineStorageType,","+\t\t\tKine: &v1beta1.KineConfig{DataSource: \"made-up://\"},","+\t\t}}","+\t\tsaveDir := t.TempDir()","+","+\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\ttime.Sleep(time.Until(time.UnixMilli(now)))","+\t\t\t// Use a local time zone that's off UTC, so that UTC normalization can be tested.","+\t\t\tlocal := time.Local","+\t\t\tt.Cleanup(func() { time.Local = local })","+\t\t\ttime.Local = time.FixedZone(t.Name(), 1337)","+","+\t\t\tunderTest, err := backup.NewBackupManager()","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NoError(t, underTest.RunBackup(t.Context(), nodeSpec, vars, saveDir, nil))","+\t\t})","+","+\t\tentries, err := os.ReadDir(saveDir)","+\t\trequire.NoError(t, err)","+\t\trequire.Len(t, entries, 1)","+\t\tassert.Equal(t, expectedFileName, entries[0].Name())","+\t})","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"internal/backup/sqlitedb_unix.go","lines":["@@ -6,6 +6,7 @@"," package backup"," "," import (","+\t\"context\""," \t\"database/sql\""," \t\"fmt\""," \t\"net/url\"","@@ -36,8 +37,8 @@ func openDB(path string) (*sqliteDB, error) {"," \treturn &sqliteDB{DB: db}, nil"," }"," ","-func (db *sqliteDB) Backup(path string) error {","-\t_, err := db.Exec(\"VACUUM INTO ?\", path)","+func (db *sqliteDB) Backup(ctx context.Context, path string) error {","+\t_, err := db.ExecContext(ctx, \"VACUUM INTO ?\", path)"," \treturn err"," }"," ","@@ -57,7 +58,7 @@ func (s *sqliteStep) Name() string {"," \treturn \"sqlite db path \" + s.d