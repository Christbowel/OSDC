some-file\")","+\t\trequire.NoError(t, os.WriteFile(path, []byte(\"some data\"), 0644))","+\t\tfiles := []string{path}","+","+\t\tvar reference bytes.Buffer","+\t\trequire.NoError(t, createArchive(t.Context(), &reference, files, baseDir))","+","+\t\t// Simulate an error at every possible write position.","+\t\tfor capacity := range reference.Len() {","+\t\t\tremaining := capacity","+\t\t\tarchive := internalio.WriterFunc(func(p []byte) (int, error) {","+\t\t\t\tl := len(p)","+\t\t\t\tif l > remaining {","+\t\t\t\t\twritten := remaining","+\t\t\t\t\tremaining = 0","+\t\t\t\t\treturn written, assert.AnError","+\t\t\t\t}","+","+\t\t\t\tremaining -= l","+\t\t\t\treturn l, nil","+\t\t\t})","+","+\t\t\terr := createArchive(t.Context(), archive, files, baseDir)","+\t\t\trequire.ErrorIsf(t, err, assert.AnError,","+\t\t\t\t\"Expected the injected error after %d of %d bytes had been written\",","+\t\t\t\tcapacity, reference.Len(),","+\t\t\t)","+\t\t}","+\t})","+","+\tt.Run(\"stops when the context is done\", func(t *testing.T) {","+\t\tbaseDir := t.TempDir()","+\t\tpath := filepath.Join(baseDir, \"some-file\")","+\t\trequire.NoError(t, os.WriteFile(path, []byte(\"some data\"), 0644))","+","+\t\tcause := errors.New(\"canceled by test\")","+\t\tctx, cancel := context.WithCancelCause(t.Context())","+\t\tcancel(cause)","+","+\t\terr := createArchive(ctx, io.Discard, []string{path}, baseDir)","+","+\t\trequire.ErrorIs(t, err, cause, \"Expected the archive creation to be interrupted\")","+\t\tassert.Equal(t, 1, strings.Count(err.Error(), cause.Error()), \"Expected the cause to be reported exactly once in %q\", err)","+\t})","+}",""],"additions":71,"deletions":0,"truncated":false}],"additions":189,"deletions":66,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-20T17:59:16.151880+00:00"}