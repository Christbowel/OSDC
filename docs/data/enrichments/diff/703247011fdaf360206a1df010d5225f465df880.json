>create_many( 3 );","+","+\t\tadd_filter(","+\t\t\t'post_limits',","+\t\t\tstatic function (): string {","+\t\t\t\treturn 'LIMIT 0, 2';","+\t\t\t}","+\t\t);","+","+\t\t$q = new WP_Query(","+\t\t\tarray(","+\t\t\t\t'post_type'      => 'post',","+\t\t\t\t'posts_per_page' => -1,","+\t\t\t)","+\t\t);","+","+\t\t$this->assertIsString( $q->request );","+\t\t$this->assertStringContainsString( 'SQL_CALC_FOUND_ROWS', $q->request, 'Expected the filtered LIMIT to trigger the found-rows query.' );","+\t\t$this->assertSame( 3, $q->found_posts, 'Expected found_posts to reflect all matching rows.' );","+\t\t$this->assertSame( 0, $q->max_num_pages, 'Expected max_num_pages to be clamped to zero.' );","+\t}"," }",""],"additions":58,"deletions":0,"truncated":false}],"additions":62,"deletions":34,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-06T17:01:50.111944+00:00"}