             \"AliasNode\": \"\","],"additions":1,"deletions":0,"truncated":false},{"path":"agent/structs/service_ai.go","lines":["@@ -0,0 +1,439 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package structs","+","+import (","+\t\"github.com/hashicorp/consul/api\"","+\t\"github.com/hashicorp/consul/lib\"","+)","+","+// ServiceAIRole is the discriminator for the inline `ai` block on a service","+// definition. Exactly one role-specific sub-block is populated based on its","+// value. See the CAMP design summary for the full schema.","+type ServiceAIRole string","+","+const (","+\t// ServiceAIRoleInferenceModel registers the service as a mesh-discoverable","+\t// inference target (internal or, via a terminating gateway, managed).","+\tServiceAIRoleInferenceModel ServiceAIRole = \"inference-model\"","+","+\t// ServiceAIRoleMCPServer registers the service as an MCP (Model Context","+\t// Protocol) tooling target.","+\tServiceAIRoleMCPServer ServiceAIRole = \"mcp-server\"","+","+\t// ServiceAIRoleAgent registers the service as an AI agent workload.","+\tServiceAIRoleAgent ServiceAIRole = \"ai-agent\"","+)","+","+// Supported enum values for role-specific fields.","+const (","+\taiProtocolOpenAI      = \"openai\"","+\taiProtocolAnthropic   = \"anthropic\"","+\taiProtocolPassthrough = \"passthrough\"","+","+\taiTransportStreamableHTTP = \"streamable-http\"","+\taiTransportSSE            = \"sse\"","+\taiTransportStdio          = \"stdio\"","+)","+","+// ServiceAI is the inline `ai` block added to the standard Consul service","+// definition. It carries a Role discriminator and exactly one role-specific","+// sub-block. Registering the service and its AI semantics together lets the","+// connect-injector attach the correct specialized sidecar in one pass.","+type ServiceAI struct {","+\t// Role determines which role-specific sub-block is valid.","+\tRole ServiceAIRole `json:\",omitempty\"`","+","+\t// Exactly one of the following is set, matching Role.","+\tInferenceModel *AIInferenceModel `json:\",omitempty\" bexpr:\"-\"`","+\tMCPServer      *AIMCPServer      `json:\",omitempty\" bexpr:\"-\"`","+\tAgent          *AIAgent          `json:\",omitempty\" bexpr:\"-\"`","+}","+","+// AIInferenceModel is the role-specific config for ServiceAIRoleInferenceModel.","+type AIInferenceModel struct {","+\t// Protocol is the API dialect the model speaks: openai | anthropic |","+\t// passthrough.","+\tProtocol string `json:\",omitempty\"`","+","+\t// Path is the OpenAI-compatible base path (e.g. \"/v1\").","+\tPath string `json:\",omitempty\"`","+","+\t// Defaults are optional request-shaping defaults.","+\tDefaults *AIModelDefaults `json:\",omitempty\"`","+}","+","+// AIModelDefaults carries optional request defaults for an inference model.","+type AIModelDefaults struct {","+\tMaxTokens   int     `json:\",omitempty\"`","+\tTemperature float64 `json:\",omitempty\"`","+}","+","+// AIMCPServer is the role-specific config for ServiceAIRoleMCPServer.","+type AIMCPServer struct {","+\t// Transport is the MCP transport: streamable-http | sse | stdio.","+\tTransport string `json:\",omitempty\"`","+","+\t// Path is the MCP endpoint path (e.g. \"/mcp\").","+\tPath string `json:\",omitempty\"`","+","+\t// ProtocolVersion is the MCP spec version this server implements.","+\tProtocolVersion string `json:\",omitempty\"`","+}","+","+// AIAgent is the role-specific config for ServiceAIRoleAgent.","+type AIAgent struct {","+\t// Inference describes the specialization(s) the agent requires when","+\t// calling the inference gateway.","+\tInference *AIAgentInference `json:\",omitempty\"`","+","+\t// MCP describes the agent's MCP egress: the dedicated outbound listener","+\t// port and any human-in-the-loop (HITL) approval configuration.","+\tMCP *AIAgentMCP `json:\",omitempty\"`","+","+\t// RateLimits are per-agent tool-call limits.","+\tRateLimits *AIAgentRateLimits `json:\",omitempty\"`","+","+\t// Interceptor configures the co-located governance interceptor the sidecar","+\t// reaches over loopback for request/response middleware.","+\tInterceptor *AIAgentInterceptor `json:\",omitempty\"`","+}","+","+// AIAgentInference describes the inference specialization for an agent.","+type AIAgentInference struct {","+\t// Specialization is sent as the x-inference-specialization request header.","+\tSpecialization []string `json:\",omitempty\"`","+","+\t// Vendor, when set, is sent as the x-inference-vendor request header.","+\tVendor string `json:\",omitempty\"`","+}","+","+// AIAgentMCP is the MCP egress configuration for an agent.","+type AIAgentMCP struct {","+\t// Port overrides the dedicated MCP outbound listener port the agent dials","+\t// for tool calls (loopback /mcp). Defaults to 15101 when unset.","+\tPort int `json:\",omitempty\"`","+","+\t// HITL is the optional human-in-the-loop approval configuration.","+\tHITL *AIAgentMCPHITL `json:\",omitempty\"`","+}","+","+// AIAgentMCPHITL is the human-in-the-loop approval configuration for MCP tool","+// calls. The agent runs a plain-HTTP server on the loopback Port; the","+// interceptor pushes approval requests for critical tools and blocks until it","+// receives a verdict.","+type AIAgentMCPHITL struct {","+\t// Port is the loopback port the agent's HITL HTTP server listens on.","+\t// Defaults to 16101 when unset.","+\tPort int `json:\",omitempty\"`","+","+\t// ApprovalTimeout is how long the interceptor waits for the agent's verdict","+\t// before failing closed (rejecting the tool call).","+\tApprovalTimeout string `json:\",omitempty\"`","+}","+","+// AIAgentRateLimits are per-agent tool-call rate limits.","+type AIAgentRateLimits struct {","+\tToolCallsPerMinute int `json:\",omitempty\"`","+\tToolCallsPerHour   int `json:\",omitempty\"`","+}","+","+// AIAgentInterceptor configures the co-located governance interceptor the","+// sidecar reaches over plaintext loopback.","+type AIAgentInterceptor struct {","+\t// Port is the loopback port the interceptor listens on. Defaults to 21101","+\t// when unset.","+\tPort int `json:\",omitempty\"`","+}","+","+// Clone returns a deep copy of the AI block. It is nil-safe. A deep copy is","+// required because ServiceAI is carried on ServiceNode, which is held in the","+// shared Raft state store; PartialClone must hand out a fully independent copy","+// so that mutating one entry cannot corrupt another.","+func (a *ServiceAI) Clone() *ServiceAI {","+\tif a == nil {","+\t\treturn nil","+\t}","+","+\tout := &ServiceAI{Role: a.Role}","+","+\tif a.InferenceModel != nil {","+\t\tim := *a.InferenceModel","+\t\tif a.InferenceModel.Defaults != nil {","+\t\t\td := *a.InferenceModel.Defaults","+\t\t\tim.Defaults = &d","+\t\t}","+\t\tout.InferenceModel = &im","+\t}","+","+\tif a.MCPServer != nil {","+\t\tms := *a.MCPServer","+\t\tout.MCPServer = &ms","+\t}","+","+\tif a.Agent != nil {","+\t\tagent := &AIAgent{}","+\t\tif a.Agent.Inference != nil {","+\t\t\tinf := &AIAgentInference{Vendor: a.Agent.Inference.Vendor}","+\t\t\tif a.Agent.Inference.Specialization != nil {","+\t\t\t\tinf.Specialization = make([]string, len(a.Agent.Inference.Specialization))","+\t\t\t\tcopy(inf.Specialization, a.Agent.Inference.Specialization)","+\t\t\t}","+\t\t\tagent.Inference = inf","+\t\t}","+\t\tif a.Agent.MCP != nil {","+\t\t\tmcp := &AIAgentMCP{Port: a.Agent.MCP.Port}","+\t\t\tif a.Agent.MCP.HITL != nil {","+\t\t\t\thitl := &AIAgentMCPHITL{","+\t\t\t\t\tPort:            a.Agent.MCP.HITL.Port,","+\t\t\t\t\tApprovalTimeout: a.Agent.MCP.HITL.ApprovalTimeout,","+\t\t\t\t}","+\t\t\t\tmcp.HITL = hitl","+\t\t\t}","+\t\t\tagent.MCP = mcp","+\t\t}","+\t\tif a.Agent.RateLimits != nil {","+\t\t\trl := *a.Agent.RateLimits","+\t\t\tagent.RateLimits = &rl","+\t\t}","+\t\tif a.Agent.Interceptor != nil {","+\t\t\tic := *a.Agent.Interceptor","+\t\t\tagent.Interceptor = &ic","+\t\t}","+\t\tout.Agent = agent","+\t}","+","+\treturn out","+}","+","+// UnmarshalJSON adds snake_case aliases for the multi-word child keys of the","+// `ai` block so that config-file (snake_case) and API (CamelCase) bodies parse","+// identically. CamelCase values take precedence when both are present.","+func (t *ServiceAI) UnmarshalJSON(data []byte) error {","+\ttype Alias ServiceAI","+\taux := &struct {","+\t\tInferenceModelSnake *AIInferenceModel `json:\"inference_model\"`","+\t\tMCPServerSnake      *AIMCPServer      `json:\"mcp_server\"`","+\t\t*Alias","+\t}{","+\t\tAlias: (*Alias)(t),","+\t}","+\tif err := lib.UnmarshalJSON(data, aux); err != nil {","+\t\treturn err","+\t}","+\tif t.InferenceModel == nil {","+\t\tt.InferenceModel = aux.InferenceModelSnake","+\t}","+\tif t.MCPServer == nil {","+\t\tt.MCPServer = aux.MCPServerSnake","+\t}","+\treturn nil","+}","+","+// UnmarshalJSON adds a snake_case alias for protocol_version.","+func (t *AIMCPServer) UnmarshalJSON(data []byte) error {","+\ttype Alias AIMCPServer","+\taux := &struct {","+\t\tProtocolVersionSnake string `json:\"protocol_version\"`","+\t\t*Alias","+\t}{","+\t\tAlias: (*Alias)(t),","+\t}","+\tif err := lib.UnmarshalJSON(data, aux); err != nil {","+\t\treturn err","+\t}","+\tif t.ProtocolVersion == \"\" {","+\t\tt.ProtocolVersion = aux.ProtocolVersionSnake","+\t}","+\treturn nil","+}","+","+// UnmarshalJSON adds a snake_case alias for max_tokens.","+func (t *AIModelDefaults) UnmarshalJSON(data []byte) error {","+\ttype Alias AIModelDefaults","+\taux := &struct {","+\t\tMaxTokensSnake int `json:\"max_tokens\"`","+\t\t*Alias","+\t}{","+\t\tAlias: (*Alias)(t),","+\t}","+\tif err := lib.UnmarshalJSON(data, aux); err != nil {","+\t\treturn err","+\t}","+\tif t.MaxTokens == 0 {","+\t\tt.MaxTokens = aux.MaxTokensSnake","+\t}","+\treturn nil","+}","+","+// UnmarshalJSON adds a snake_case alias for rate_limits.","+func (t *AIAgent) UnmarshalJSON(data []byte) error {","+\ttype Alias AIAgent","+\taux := &struct {","+\t\tRateLimitsSnake *AIAgentRateLimits `json:\"rate_limits\"`","+\t\t*Alias","+\t}{","+\t\tAlias: (*Alias)(t),","+\t}","+\tif err := lib.UnmarshalJSON(data, aux); err != nil {","+\t\treturn err","+\t}","+\tif t.RateLimits == nil {","+\t\tt.RateLimits = aux.RateLimitsSnake","+\t}","+\treturn nil","+}","+","+// UnmarshalJSON adds a snake_case alias for approval_timeout.","+func (t *AIAgentMCPHITL) UnmarshalJSON(data []byte) error {","+\ttype Alias AIAgentMCPHITL","+\taux := &struct {","+\t\tApprovalTimeoutSnake string `json:\"approval_timeout\"`","+\t\t*Alias","+\t}{","+\t\tAlias: (*Alias)(t),","+\t}","+\tif err := lib.UnmarshalJSON(data, aux); err != nil {","+\t\treturn err","+\t}","+\tif t.ApprovalTimeout == \"\" {","+\t\tt.ApprovalTimeout = aux.ApprovalTimeoutSnake","+\t}","+\treturn nil","+}","+","+// UnmarshalJSON adds snake_case aliases for tool_calls_per_minute and","+// tool_calls_per_hour.","+func (t *AIAgentRateLimits) UnmarshalJSON(data []byte) error {","+\ttype Alias AIAgentRateLimits","+\taux := &struct {","+\t\tToolCallsPerMinuteSnake int `json:\"tool_calls_per_minute\"`","+\t\tToolCallsPerHourSnake   int `json:\"tool_calls_per_hour\"`","+\t\t*Alias","+\t}{","+\t\tAlias: (*Alias)(t),","+\t}","+\tif err := lib.UnmarshalJSON(data, aux); err != nil {","+\t\treturn err","+\t}","+\tif t.ToolCallsPerMinute == 0 {","+\t\tt.ToolCallsPerMinute = aux.ToolCallsPerMinuteSnake","+\t}","+\tif t.ToolCallsPerHour == 0 {","+\t\tt.ToolCallsPerHour = aux.ToolCallsPerHourSnake","+\t}","+\treturn nil","+}","+","+// ToAPI converts a structs.ServiceAI into its public api.AgentServiceAI twin.","+// It is nil-safe (a nil receiver returns nil) and performs a deep copy so the","+// returned value never aliases the source slices/pointers. Only secret","+// references (provider/path/field) are copied; no resolved secret value exists","+// on either side to leak.","+func (a *ServiceAI) ToAPI() *api.AgentServiceAI {","+\tif a == nil {","+\t\treturn nil","+\t}","+\treturn &api.AgentServiceAI{","+\t\tRole:           string(a.Role),","+\t\tInferenceModel: a.InferenceModel.toAPI(),","+\t\tMCPServer: