\t},","+\t}","+","+\tfor name, orig := range originals {","+\t\tt.Run(\"deepequal \"+name, func(t *testing.T) {","+\t\t\tclone := orig.Clone()","+\t\t\trequire.True(t, reflect.DeepEqual(orig, clone), \"clone must be deep-equal to original\")","+\t\t\trequire.NotSame(t, orig, clone)","+\t\t})","+\t}","+","+\tt.Run(\"agent slices are independent\", func(t *testing.T) {","+\t\torig := originals[\"ai-agent\"]","+\t\tclone := orig.Clone()","+","+\t\tclone.Agent.Inference.Specialization[0] = \"MUTATED\"","+\t\tclone.Agent.MCP.HITL.Port = 99999","+","+\t\trequire.Equal(t, \"code-review\", orig.Agent.Inference.Specialization[0])","+\t\trequire.Equal(t, 16101, orig.Agent.MCP.HITL.Port)","+\t})","+","+}","+","+// TestStructs_ServiceAI_UnmarshalJSON proves the snake_case config/JSON keys and","+// the CamelCase API keys parse into the identical struct for every aliased","+// multi-word key.","+func TestStructs_ServiceAI_UnmarshalJSON(t *testing.T) {","+\tt.Run(\"inference_model + nested aliases\", func(t *testing.T) {","+\t\tsnake := []byte(`{","+\t\t\t\"role\": \"inference-model\",","+\t\t\t\"inference_model\": {","+\t\t\t\t\"protocol\": \"openai\",","+\t\t\t\t\"path\": \"/v1\",","+\t\t\t\t\"defaults\": { \"max_tokens\": 2048, \"temperature\": 0.7 }","+\t\t\t}","+\t\t}`)","+\t\tcamel := []byte(`{","+\t\t\t\"Role\": \"inference-model\",","+\t\t\t\"InferenceModel\": {","+\t\t\t\t\"Protocol\": \"openai\",","+\t\t\t\t\"Path\": \"/v1\",","+\t\t\t\t\"Defaults\": { \"MaxTokens\": 2048, \"Temperature\": 0.7}","+\t\t\t}","+\t\t}`)","+","+\t\tvar fromSnake, fromCamel ServiceAI","+\t\trequire.NoError(t, json.Unmarshal(snake, &fromSnake))","+\t\trequire.NoError(t, json.Unmarshal(camel, &fromCamel))","+","+\t\trequire.Equal(t, fromCamel, fromSnake)","+\t\t// Assert the snake_case aliases actually mapped (not silently dropped).","+\t\trequire.NotNil(t, fromSnake.InferenceModel)","+\t\trequire.Equal(t, 2048, fromSnake.InferenceModel.Defaults.MaxTokens)","+\t})","+","+\tt.Run(\"mcp_server + 