iceAIRoleMCPServer,","+\t\t\t\tMCPServer: &AIMCPServer{","+\t\t\t\t\tTransport:       aiTransportStreamableHTTP,","+\t\t\t\t\tProtocolVersion: \"2025-03-26\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"ai-agent role\",","+\t\t\tai: &ServiceAI{","+\t\t\t\tRole:  ServiceAIRoleAgent,","+\t\t\t\tAgent: &AIAgent{},","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tsd := &ServiceDefinition{","+\t\t\t\tName: \"ai-svc\",","+\t\t\t\tPort: 8080,","+\t\t\t\tAI:   tc.ai,","+\t\t\t}","+\t\t\terr := sd.Validate()","+\t\t\trequire.Error(t, err, \"expected CE to reject a service with an AI block\")","+\t\t\trequire.True(t, strings.Contains(err.Error(), \"ai is ent only feature\"),","+\t\t\t\t\"expected CE restriction message, got: %s\", err.Error())","+\t\t})","+\t}","+}"],"additions":343,"deletions":0,"truncated":false},{"path":"agent/structs/service_definition.go","lines":["@@ -42,6 +42,12 @@ type ServiceDefinition struct {"," \tacl.EnterpriseMeta `hcl:\",squash\" mapstructure:\",squash\"`"," "," \tConnect *ServiceConnect","+","+\t// AI is the inline AI role block (CAMP). It registers the service's AI","+\t// semantics (inference-model, mcp-server, or ai-agent) alongside the","+\t// normal service definition. Optional; nil when the service is not an AI","+\t// workload.","+\tAI *ServiceAI `json:\",omitempty\"`"," }"," "," func (t *ServiceDefinition) UnmarshalJSON(data []byte) (err error) {","@@ -83,6 +89,7 @@ func (s *ServiceDefinition) NodeService() *NodeService {"," \t\tEnableTagOverride: s.EnableTagOverride,"," \t\tEnterpriseMeta:    s.EnterpriseMeta,"," \t\tLocality:          s.Locality,","+\t\tAI:                s.AI,"," \t}"," \tns.Normalize()"," "],"additions":7,"deletions":0,"truncated":false},{"path":"agent/structs/structs.deepcopy.go","lines":["@@ -1043,6 +1043,50 @@ func (o *NodeService) DeepCopy() *NodeService {"," \t\tretV := o.Connect.DeepCopy()"," \t\tcp.Connect = *retV"," \t}","+