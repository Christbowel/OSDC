INSTANCE_OPENFEATURE_PROVIDER_URL\":  \"https://myorg.com/\",","+\t\t\t\"GF_INSTANCE_OPENFEATURE_PROVIDER_TYPE\": \"static\",","+\t\t\t\"GF_INSTANCE_OPENFEATURE_CACHE_TTL\":     \"60\",","+\t\t\t\"GF_INSTANCE_OPENFEATURE_CONTEXT\":       `{\"grafana_version\":\"12.3.0\",\"namespace\":\"default\"}`,","+\t\t})","+\t})","+","+\tt.Run(\"Unknown provider type advertises nothing\", func(t *testing.T) {","+\t\tcfg := setting.NewCfg()","+\t\tcfg.AppURL = \"https://myorg.com/\"","+\t\tcfg.OpenFeature = setting.OpenFeatureSettings{","+\t\t\tProviderType: \"some-future-provider\",","+\t\t\tCacheTTL:     time.Minute,","+\t\t}","+","+\t\tpCfg, err := ProvidePluginInstanceConfig(cfg, setting.ProvideProvider(cfg), featuremgmt.WithFeatures())","+\t\trequire.NoError(t, err)","+","+\t\tp := NewRequestConfigProvider(pCfg, &fakeSSOSettingsProvider{})","+\t\tm := p.PluginRequestConfig(context.Background(), \"\", nil)","+\t\trequire.NotContains(t, m, \"GF_INSTANCE_OPENFEATURE_PROVIDER_URL\")","+\t\trequire.NotContains(t, m, \"GF_INSTANCE_OPENFEATURE_PROVIDER_TYPE\")","+\t\trequire.NotContains(t, m, \"GF_INSTANCE_OPENFEATURE_CACHE_TTL\")","+\t})","+","+\tt.Run(\"Remote provider URL is passed through\", func(t *testing.T) {","+\t\tu, err := url.Parse(\"http://features.example.com:1031\")","+\t\trequire.NoError(t, err)","+","+\t\tcfg := setting.NewCfg()","+\t\tcfg.AppURL = \"https://myorg.com/\"","+\t\tcfg.OpenFeature = setting.OpenFeatureSettings{","+\t\t\tProviderType: setting.OFREPProviderType,","+\t\t\tURL:          u,","+\t\t\tCacheTTL:     30 * time.Second,","+\t\t}","+","+\t\tpCfg, err := ProvidePluginInstanceConfig(cfg, setting.ProvideProvider(cfg), featuremgmt.WithFeatures())","+\t\trequire.NoError(t, err)","+","+\t\tp := NewRequestConfigProvider(pCfg, &fakeSSOSettingsProvider{})","+\t\tm := p.PluginRequestConfig(context.Background(), \"\", nil)","+\t\trequire.Subset(t, m, map[string]string{","+\t\t\t\"GF_INSTANCE_OPENFEATURE_PROVIDER_URL\":  \"http://features.example.com:1031\",","+\t\t\t\"GF_INSTANCE_OPENFEATURE_PROVIDER_TYPE\": \"ofrep\",","+\t\t\t\"GF_INSTANCE_OPENFEATURE_CACHE_TTL\":     \"30\",","+\t\t})","+\t\trequire.NotContains(t, m, \"GF_INSTANCE_OPENFEATURE_CONTEXT\")","+\t})","+}",""],"additions":82,"deletions":0,"truncated":false}],"additions":182,"deletions":0,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-01T15:00:10.067679+00:00"}