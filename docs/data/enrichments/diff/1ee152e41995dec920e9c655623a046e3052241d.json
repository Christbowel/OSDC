+\t\treturn cfg.GrafanaAppURL","+\tdefault:","+\t\treturn \"\"","+\t}","+}","+","+// openFeatureCacheTTLSeconds returns the advisory evaluation cache TTL as an","+// integer number of seconds, so plugins in any language can parse it. On the","+// wire 0 means \"no caching advice\", so negative TTLs are clamped to 0 and","+// sub-second TTLs are rounded up to 1 rather than silently becoming 0.","+func (cfg *PluginInstanceCfg) openFeatureCacheTTLSeconds() string {","+\tttl := cfg.OpenFeature.CacheTTL","+\tif ttl <= 0 {","+\t\treturn \"0\"","+\t}","+\tsecs := int64(ttl / time.Second)","+\tif secs == 0 {","+\t\tsecs = 1","+\t}","+\treturn strconv.FormatInt(secs, 10)","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"pkg/services/pluginsintegration/pluginconfig/request.go","lines":["@@ -2,6 +2,7 @@ package pluginconfig"," "," import ("," \t\"context\"","+\t\"encoding/json\""," \t\"slices\""," \t\"sort\""," \t\"strconv\"","@@ -61,6 +62,21 @@ func (s *RequestConfigProvider) PluginRequestConfig(ctx context.Context, pluginI"," \t\tm[featuretoggles.EnabledFeatures] = strings.Join(features, \",\")"," \t}"," ","+\tif providerURL := s.cfg.openFeatureProviderURL(); s.cfg.OpenFeature.ProviderType != \"\" && providerURL != \"\" {","+\t\tm[openFeatureProviderURLKey] = providerURL","+\t\tm[openFeatureProviderTypeKey] = string(s.cfg.OpenFeature.ProviderType)","+\t\tm[openFeatureCacheTTLKey] = s.cfg.openFeatureCacheTTLSeconds()","+","+\t\tif len(s.cfg.OpenFeature.ContextAttrs) > 0 {","+\t\t\tattrs, err := json.Marshal(s.cfg.OpenFeature.ContextAttrs)","+\t\t\tif err != nil {","+\t\t\t\ts.logger.Error(\"Failed to marshal OpenFeature context attributes\", \"error\", err)","+\t\t\t} else {","+\t\t\t\tm[openFeatureContextKey] = string(attrs)","+\t\t\t}","+\t\t}","+\t}","+"," \tif slices.Contains[[]string, string](s.cfg.AWSForwardSettingsPlugins, pluginID) {"," \t\tif !s.cfg.AWSAssumeRoleEnabled {"," \t\t\tm[awsds.AssumeRoleEnabledEnvVarKeyName] = \"false\""],"additions":16,"del