 from.","+const (","+\t// ListerSearch reads the unified-storage managed-object index.","+\tListerSearch = \"search\"","+\t// ListerAPIs lists each configured kind through the API group that serves it.","+\tListerAPIs = \"apis\"","+)","+","+// NewResourceListerForMode returns the lister named by [provisioning] resource_lister. The store","+// is only consulted in search mode and may be nil in apis mode.","+func NewResourceListerForMode(mode string, store ResourceStore, clients ClientFactory, configured []SupportedResource) (ResourceLister, error) {","+\tswitch mode {","+\tcase \"\", ListerSearch:","+\t\treturn NewResourceLister(store, clients, configured), nil","+\tcase ListerAPIs:","+\t\treturn unimplementedLister{mode: ListerAPIs}, nil","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"invalid [provisioning] resource_lister %q: expected %q or %q\", mode, ListerSearch, ListerAPIs)","+\t}","+}","+","+// NeedsResourceStore reports whether a lister mode reads unified storage directly. An unrecognised","+// mode needs nothing: it has to fail validation rather than a store lookup.","+func NeedsResourceStore(mode string) bool { return mode == \"\" || mode == ListerSearch }","+","+// unimplementedLister stands in for a selectable mode whose reader has not landed yet, keeping the","+// selector and its store predicate reviewable on their own. It fails every call rather than","+// reporting a repository that manages nothing.","+type unimplementedLister struct{ mode string }","+","+func (l unimplementedLister) List(context.Context, string, string) (*provisioning.ResourceList, error) {","+\treturn nil, fmt.Errorf(\"[provisioning] resource_lister %q has no reader yet\", l.mode)","+}","+","+func (l unimplementedLister) Stats(context.Context, string, string) (*provisioning.ResourceStats, error) {","+\treturn nil, fmt.Errorf(\"[provisioning] resource_lister %q has no reader yet\", l.mode)","+}","+"," type ResourceListerFromSearch struct {"," \tstore ResourceStore"," \t// clients lists