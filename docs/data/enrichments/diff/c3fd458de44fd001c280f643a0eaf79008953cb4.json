pe,","                     $specialization_location,","+                    $function_call_node,","+                    $input_taints,","+                    $removed_taints,","+                    $added_taints,","+                    $arg_removed_taints[$arg_index] ?? 0,","                 );","+            }","+        }","+    }"," ","-                $graph->addNode($function_param_sink);","-","-                $graph->addPath(","-                    $function_param_sink,","-                    $function_call_node,","+    /**","+     * Like taintUsingFlows(), for a call whose arguments go into the nodes of the parameters taking them, those","+     * of $given_params (see TaintedCall): each `@psalm-flow` from one of them is a path from its node.","+     *","+     * @param list<int> $given_params the offsets of the parameters given an argument","+     * @param int $input_taints the taints of user input (see Codebase::getInputTaints())","+     * @psalm-capabilities read-props|write-this-props|write-props|write-refs","+     */","+    public static function taintUsingParamFlows(","+        FunctionLikeStorage $function_storage,","+        TaintFlowGraph $graph,","+        string $function_id,","+        array $given_params,","+        ?CodeLocation $specialization_location,","+        DataFlowNode $function_call_node,","+        int $input_taints,","+        int $removed_taints,","+    ): void {","+        foreach ($function_storage->return_source_params as $i => $path_type) {","+            if (in_array($i, $given_params, true)) {","+                self::addReturnFlow(","+                    $function_storage,","+                    $graph,","+                    $function_id,","+                    $i,","+                    $i,","                     $path_type,","-                    $added_taints | $function_storage->added_taints,","-                    // what the native return type cannot hold, since PHP enforces it","-                    $path_removed_taint