"], None),","+            ([], [], None),","+            (\"os\", None, TypeError),","+            ([123], None, TypeError),","+            ([\"\"], None, ValueError),","+            ([\"123invalid\"], None, ValueError),","+            ([\"bad..module\"], None, ValueError),","+            ([\"import\"], None, ValueError),","+            ([\"foo.class\"], None, ValueError),","+        ],","+    )","+    def test_preload_modules_validation(","+        self, preload_modules, expected_result, expected_error","+    ):","+        if expected_error is None:","+            env = RuntimeEnv(preload_modules=preload_modules)","+            assert env.preload_modules() == expected_result","+        else:","+            with pytest.raises(expected_error):","+                RuntimeEnv(preload_modules=preload_modules)","+","+"," def test_validate_no_local_paths_raises_exceptions_on_type_mismatch():","     with pytest.raises(TypeError):","         _validate_no_local_paths(1)"],"additions":27,"deletions":0,"truncated":false},{"path":"python/ray/tests/unit/test_utils.py","lines":["@@ -0,0 +1,55 @@","+import os","+import sys","+from unittest.mock import MagicMock, patch","+","+import pytest","+","+import ray","+from ray._private.utils import set_num_threads_env_vars_if_unset","+","+","+@pytest.mark.parametrize(","+    \"num_threads_env_vars,preset_omp,expected_ret,expected_torch_threads\",","+    [","+        (None, None, [\"OMP_NUM_THREADS\"], 4),","+        (\"OMP_NUM_THREADS,RAYON_NUM_THREADS\", \"2\", [\"RAYON_NUM_THREADS\"], None),","+    ],","+)","+def test_set_num_threads_env_vars_if_unset_updates_thread_pool_modules(","+    monkeypatch,","+    num_threads_env_vars,","+    preset_omp,","+    expected_ret,","+    expected_torch_threads,","+):","+    \"\"\"Test that set_num_threads_env_vars_if_unset calls .set_num_threads() on loaded","+    THREAD_POOL_MODULES only when OMP_NUM_THREADS is set by Ray.","+    \"\"\"","+    if num_threads_env_vars is None:","+        monkeypatch.delenv(\"RAY_NUM_THREADS_ENV_VARS\", raising=False)","+    else:","+        monkeypatch.setenv(\"RAY_NUM_THREADS_ENV_VARS\", num_threads_env_vars)","+    if preset_omp is None:","+        monkeypatch.delenv(\"OMP_NUM_THREADS\", raising=False)","+    else:","+        monkeypatch.setenv(\"OMP_NUM_THREADS\", preset_omp)","+    monkeypatch.delenv(\"RAYON_NUM_THREADS\", raising=False)","+","+    mock_ctx = MagicMock()","+    mock_ctx.worker.mode = ray._private.worker.WORKER_MODE","+    mock_ctx.get_assigned_resources.return_value = {\"CPU\": 4}","+    mock_torch = MagicMock()","+    with patch(\"ray.get_runtime_context\", return_value=mock_ctx), patch.dict(","+        sys.modules, {\"torch\": mock_torch}","+    ):","+        assert set_num_threads_env_vars_if_unset() == expected_ret","+        if expected_torch_threads is not None:","+            assert os.environ[\"OMP_NUM_THREADS\"] == str(expected_torch_threads)","+            mock_torch.set_num_threads.assert_called_once_with(expected_torch_threads)","+        else:","+            assert os.environ[\"OMP_NUM_THREADS\"] == preset_omp","+            mock_torch.set_num_threads.assert_not_called()","+","+","+if __name__ == \"__main__\":","+    sys.exit(pytest.main([\"-sv\", __file__]))"],"additions":55,"deletions":0,"truncated":false},{"path":"src/ray/common/ray_config.cc","lines":["@@ -33,6 +33,11 @@ void RayConfig::initialize(const std::string &config_list) {","   name##_ = ReadEnv<type>(\"RAY_\" #name, #type, default_value);"," "," #include \"ray/common/ray_config_def.h\"","+// Re-read internal flags (e.g., RAY_JOB_ID) when initialize() is called","+// post-fork in a worker process after RayConfig was already constructed.","+#define RAY_INTERNAL_FLAG RAY_CONFIG","+#include \"ray/common/ray_internal_flag_def.h\"","+#undef RAY_INTERNAL_FLAG"," #undef RAY_CONFIG"," ","   if (config_list.empty()) {"],"additions":5,"deletions":0,"truncated":false},{"path":"src/ray/common/ray_config_def.h","lines":["@@ -1300,3 +1300,11 @@ RAY_CONFIG(uint64_t, gcs_resource_broadcast_max_batch_delay_ms, 0)"," // Whether to enable/disable multiple gRPC connections to improve object transfer"," // throughput."," RAY_CONFIG(bool, experimental_object_manager_enable_multiple_connections, true)","+","+/// If true, Python workers are forked from a warm fork server process","+/// instead of starting a new Python interpreter from scratch.","+RAY_CONFIG(bool, enable_worker_fork_server, false)","+","+/// Timeout in milliseconds for a fork server socket request before falling back to","+/// starting a fresh worker process.","+RAY_CONFIG(int64_t, worker_fork_server_timeout_ms, 500)"],"additions":8,"deletions":0,"truncated":false},{"path":"src/ray/common/ray_internal_flag_def.h","lines":["@@ -17,10 +17,11 @@"," // RAY_{VARIABLE NAME}."," //"," // The format is used to avoid code duplication.","-// It can be included multiple times in ray_config.h, and each inclusion","-// could use a different definition of the RAY_INTERNAL_FLAG macro.","+// It can be included multiple times in ray_config.h and ray_config.cc, and each","+// inclusion could use a different definition of the RAY_INTERNAL_FLAG macro."," // Macro definition format: RAY_INTERNAL_FLAG(type, name, default_value).","-// NOTE: This file should NOT be included in any file other than ray_config.h.","+// NOTE: This file should NOT be included in any file other than ray_config.h","+// and ray_config.cc."," "," // WARNING: if you update this file, please also update RAY_INTERNAL_FLAGS in"," // ray_constants.py."],"additions":4,"deletions":3,"truncated":false},{"path":"src/ray/common/tests/BUILD.bazel","lines":["@@ -18,6 +18,7 @@ ray_cc_test(","     deps = [","         \"//src/ray/common:grpc_util\",","         \"//src/ray/common:ray_config\",","+        \"//src/ray/util:env\",","     ],"," )"," ","@@ -40,6 +41,7 @@ ray_cc_test(","     deps = [","         \"//src/ray/common:id\",","         \"//src/ray/protobuf:common_cc_proto\",","+        \"@com_google_absl//absl/random\",","     ],"," )"," "],"additions":2,"deletions":0,"truncated":false},{"path":"src/ray/common/tests/id_test.cc","lines":["@@ -15,10 +15,17 @@"," #include \"ray/common/id.h\""," "," #include <gtest/gtest.h>","+#ifndef _WIN32","+#include <sys/wait.h>","+#include <unistd.h>","+#endif"," ","+#include <string>","+#include <thread>"," #include <utility>"," "," #include \"absl/container/flat_hash_set.h\"","+#include \"absl/random/random.h\""," "," namespace ray {"," ","@@ -124,6 +131,74 @@ TEST(ObjectIDTest, TestObjectID) {","   }"," }"," ","+#ifndef _WIN32","+TEST(ObjectIDTest, TestFromRandomForkSafety) {","+  // Initialize both Abseil's process-global RandenPool and FillRandom's thread-local","+  // PRNG before fork(), so any reliance on cloned RandenPool state across sibling","+  // forked processes or newly spawned child threads will collide.","+  (void)absl::BitGen{};","+  const ObjectID pre_fork_id = ObjectID::FromRandom();","+  ASSERT_FALSE(pre_fork_id.IsNil());","+","+  constexpr int kNumChildren = 4;","+  int pipefds[kNumChildren][2];","+  pid_t child_pids[kNumChildren];","+","+  for (int i = 0; i < kNumChildren; ++i) {","+    ASSERT_EQ(pipe(pipefds[i]), 0);","+    pid_t pid = fork();","+    ASSERT_GE(pid, 0);","+    if (pid == 0) {","+      for (int j = 0; j <= i; ++j) {","+        close(pipefds[j][0]);","+      }","+      const std::string main_binary = ObjectID::FromRandom().Binary();","+      std::string thread_binary;","+      std::thread child_thread(","+          [&thread_binary]() { thread_binary = ObjectID::FromRandom().Binary(); });","+      child_thread.join();","+","+      const std::string payload = main_binary + thread_binary;","+      ssize_t written = write(pipefds[i][1], payload.data(), payload.size());","+      close(pipefds[i][1]);","+      _exit(written == static_cast<ssize_t>(payload.size()) ? 0 : 1);","+    }","+    close(pipefds[i][1]);","+    child_pids[i] = pid;","+  }","+","+  const ObjectID parent_id = ObjectID::FromRandom();","+  absl::flat_hash_set<ObjectID> seen_ids = {pre_fork_id, parent_id};","+  ASSERT_EQ(seen_ids.size(), 2u);","+","+  for (int i = 0; i < kNumChildren; ++i) {","+    std::string buf(2 * ObjectID::Size(), '\\0');","+    size_t total_read = 0;","+    while (total_read < buf.size()) {","+      ssize_t n = read(pipefds[i][0], buf.data() + total_read, buf.size() - total_read);","+      if (n <= 0) {","+        break;","+      }","+      total_read += static_cast<size_t>(n);","+    }","+    close(pipefds[i][0]);","+","+    int status = 0;","+    ASSERT_EQ(waitpid(child_pids[i], &status, 0), child_pids[i]);","+    ASSERT_TRUE(WIFEXITED(status));","+    ASSERT_EQ(WEXITSTATUS(status), 0);","+    ASSERT_EQ(total_read, buf.size());","+","+    const ObjectID child_main_id = ObjectID::FromBinary(buf.substr(0, ObjectID::Size()));","+    const ObjectID child_thread_id =","+        ObjectID::FromBinary(buf.substr(ObjectID::Size(), ObjectID::Size()));","+    ASSERT_TRUE(seen_ids.insert(child_main_id).second);","+    ASSERT_TRUE(seen_ids.insert(child_thread_id).second);","+  }","+  ASSERT_EQ(seen_ids.size(), static_cast<size_t>(2 + 2 * kNumChildren));","+}","+#endif","+"," TEST(NilTest, TestIsNil) {","   ASSERT_TRUE(TaskID().IsNil());","   ASSERT_TRUE(TaskID::Nil().IsNil());"],"additions":75,"deletions":0,"truncated":false},{"path":"src/ray/common/tests/ray_config_test.cc","lines":["@@ -19,6 +19,7 @@"," "," #include \"gtest/gtest.h\""," #include \"ray/common/grpc_util.h\"","+#include \"ray/util/env.h\""," "," namespace ray {"," class RayConfigTest : public ::testing::Test {};","@@ -31,4 +32,18 @@ TEST_F(RayConfigTest, ConvertValueTrimsVectorElements) {","   ASSERT_EQ(output, expected_output);"," }"," ","+TEST_F(RayConfigTest, InitializeRereadsJobIdFromEnv) {","+  SetEnv(\"RAY_JOB_ID\", \"01000000\");","+  RayConfig::instance().initialize(\"\");","+  EXPECT_EQ(RayConfig::instance().JOB_ID(), \"01000000\");","+","+  SetEnv(\"RAY_JOB_ID\", \"02000000\");","+  RayConfig::instance().initializ