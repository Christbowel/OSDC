ARNING) << \"getpgid(\" << pid","-                     << \") failed at registration: \" << strerror(errno);","+  if (RayConfig::instance().process_group_cleanup_enabled()) {","+    // Save the worker's actual PGID at registration for safe cleanup later.","+    // Only save if the worker is its own process group leader (pgid == pid), so cleanup","+    // never signals the raylet's, fork server's, or runtime_env_agent's process group.","+    pid_t pgid = -1;","+    errno = 0;","+    pgid = getpgid(pid);","+    if (pgid != -1) {","+      if (pgid == pid) {","+        worker->SetSavedProcessGroupId(pgid);","+      } else {","+        RAY_LOG(WARNING) << \"Worker \" << pid << \" pgid (\" << pgid","+                         << \") != pid; skipping SetSavedProcessGroupId to avoid \"","+                         << \"signaling parent process group.\";","+      }","+    } else {","+      RAY_LOG(WARNING) << \"getpgid(\" << pid","+                       << \") failed at registration: \" << strerror(errno);","+    }","   }"," #endif"," "],"additions":19,"deletions":11,"truncated":false},{"path":"src/ray/util/random.h","lines":["@@ -14,17 +14,63 @@"," "," #pragma once"," ","+#include <cstdint>","+#include <iterator>"," #include <limits>","+#include <random>","+#ifndef _WIN32","+#include <fcntl.h>","+#include <unistd.h>","+#endif"," "," #include \"absl/random/random.h\""," ","-/// A helper function to fill random bytes into the `data`.","-/// Warning: this is not fork-safe, we need to re-seed after that.","+namespace ray::internal {","+","+/**","+ * @brief Create an `absl::BitGen` seeded from OS entropy instead of Abseil's global","+ * `RandenPool`, which `fork()` copies into child processes.","+ */","+inline absl::BitGen CreateForkSafeBitGen() {","+#ifdef _WIN32","+  std::random_device rd;","+  std::seed_seq seq{rd(), rd(), rd(), rd(), rd(), rd(), rd(), rd()};","+#else","+  uint32_t seed[8] = {};","+  const int fd = open(\"/dev/urandom\", O_RDONLY | O_CLOEXEC);","+  RAY_CHECK(fd >= 0) << \"Failed to open /dev/urandom\";","+  const ssize_t bytes_read = read(fd, seed, sizeof(seed));","+  close(fd);","+  RAY_CHECK(bytes_read == static_cast<ssize_t>(sizeof(seed)))","+      << \"Failed to read seed from /dev/urandom\";","+  std::seed_seq seq(std::begin(seed), std::end(seed));","+#endif","+  return absl::BitGen(seq);","+}","+","+}  // namespace ray::internal","+","+/**","+ * @brief A helper function to fill random bytes into `data`.","+ *","+ * Seeds from OS entropy rather than Abseil's `RandenPool` and automatically reseeds","+ * the thread-local PRNG if the PID changes across `fork()`.","+ *","+ * @param[out] data Pointer to the byte container to fill with random bytes.","+ */"," template <typename T>"," void FillRandom(T *data) {","   RAY_CHECK(data != nullptr);"," ","-  thread_local absl::BitGen generator;","+  thread_local absl::BitGen generator = ::ray::internal::CreateForkSafeBitGen();","+#ifndef _WIN32","+  thread_local pid_t generator_pid = getpid();","+  const pid_t current_pid = getpid();","+  if (generator_pid != current_pid) {","+    generator = ::ray::internal::CreateForkSafeBitGen();","+    generator_pid = current_pid;","+  }","+#endif","   for (size_t i = 0; i < data->size(); i++) {","     (*data)[i] = static_cast<uint8_t>(","         absl::Uniform(generator, 0, std::numeric_limits<uint8_t>::max()));",""],"additions":49,"deletions":3,"truncated":false}],"additions":354,"deletions":23,"truncated":false,"file_count":19},"error":null,"fetched_at":"2026-11-11T15:39:26.026808+00:00"}