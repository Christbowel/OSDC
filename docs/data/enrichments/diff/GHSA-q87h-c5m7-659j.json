{"id":"GHSA-q87h-c5m7-659j","axis":"advisories","repo":"weblyzard/inscriptis","sha":"dc122894cd671a0227f8fdad60464acddaf40fc8","parsed":{"files":[{"path":"src/inscriptis/model/tag/table_tag.py","lines":["@@ -1,6 +1,7 @@"," \"\"\"Handle the <table>, <tr> and <td> tags.\"\"\""," "," from inscriptis.annotation import Annotation","+from inscriptis.html_properties import Display"," from inscriptis.model.canvas import Canvas"," from inscriptis.model.html_document_state import HtmlDocumentState"," from inscriptis.model.table import Table, TableCell","@@ -63,3 +64,8 @@ def table_end_handler(state: HtmlDocumentState) -> None:"," ","     # transfer in-table annotations","     state.tags[-2].canvas.annotations.extend(table.get_annotations(start_idx, state.tags[-2].canvas.left_margin))","+","+    # write_verbatim_text() opened a block whose prefix is read above for the","+    # annotation offsets; drop it now so sibling tables do not accumulate padding","+    if state.tags[-2].display == Display.block:","+        state.tags[-2].canvas.current_block.prefix.remove_last_prefix()"],"additions":6,"deletions":0,"truncated":false},{"path":"tests/test_sibling_table_indentation.py","lines":["@@ -0,0 +1,31 @@","+#!/usr/bin/env python","+","+\"\"\"","+Ensure that sibling tables do not accumulate indentation of their parent.","+\"\"\"","+","+from inscriptis import get_text","+","+","+def test_sibling_tables_keep_indentation():","+    html = \"<ul>\" + \"<table><tr><td>a</td></tr></table>\" * 4 + \"</ul>\"","+    lines = [line for line in get_text(html).split(\"\\n\") if line.strip()]","+    assert len(lines) == 4","+    assert len({len(line) for line in lines}) == 1","+","+","+def test_sibling_tables_output_is_linear():","+    html = \"<div>\" + \"<table></table>\" * 2000 + \"</div>\"","+    assert len(get_text(html)) < 20 * 2000","+","+","+def test_table_annotation_offsets_are_not_shifted_by_padding():","+    \"\"\"A table inside a padded block must keep annotation offsets aligned.\"\"\"","+    from inscriptis import get_annotated_text","+    from inscriptis.model.config import ParserConfig","+","+    html = '<div style=\"padding-left:4em\"><table><tr><td><b>A</b></td></tr></table></div>'","+    result = get_annotated_text(html, ParserConfig(annotation_rules={\"b\": [\"b\"]}))","+    assert result[\"label\"]","+    for start, end, _ in result[\"label\"]:","+        assert result[\"text\"][start:end] == \"A\"",""],"additions":31,"deletions":0,"truncated":false}],"additions":37,"deletions":0,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-21T16:31:10.710595+00:00"}