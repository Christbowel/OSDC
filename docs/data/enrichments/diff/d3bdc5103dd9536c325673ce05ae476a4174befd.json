ent(experimentName());","-    await screenshot(page, '06-experiments-page');","+    await screenshot(page, '06-experiments-page', tableMasks(page));","   });"," });",""],"additions":7,"deletions":7,"truncated":false}],"additions":302,"deletions":29,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-07-24T10:17:24.387318+00:00"}