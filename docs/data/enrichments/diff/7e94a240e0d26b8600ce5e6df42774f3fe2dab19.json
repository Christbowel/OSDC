{"id":"7e94a240e0d26b8600ce5e6df42774f3fe2dab19","axis":"silent","repo":"pnpm/pnpm","sha":"7e94a240e0d26b8600ce5e6df42774f3fe2dab19","parsed":{"files":[{"path":".changeset/pnpr-oci-chunk-hint.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+Added `oci.chunkMaxBytes` to advertise an upload chunk size to OCI clients that support `OCI-Chunk-Max-Length`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -293,6 +293,8 @@ pub enum TarballFormat {"," pub struct OciConfig {","     pub bearer_auth: bool,","     pub max_blob_bytes: u64,","+    /// Optional upload chunk size hint in bytes; omitted by default.","+    pub chunk_max_bytes: Option<std::num::NonZeroU64>,","     pub max_manifest_bytes: usize,"," }"," ","@@ -301,6 +303,7 @@ impl Default for OciConfig {","         Self {","             bearer_auth: false,","             max_blob_bytes: 10 * 1024 * 1024 * 1024,","+            chunk_max_bytes: None,","             max_manifest_bytes: 4 * 1024 * 1024,","         }","     }"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/tests/behavior.rs","lines":["@@ -653,23 +653,27 @@ fn rejects_package_keys_that_normalize_to_the_same_name() {"," #[test]"," fn oci_limits_are_positive_and_preserve_defaults() {","     let config = Config::from_yaml_str(","-        \"oci: {maxBlobBytes: 123, maxManifestBytes: 456, bearerAuth: true}\",","+        \"oci: {maxBlobBytes: 123, maxManifestBytes: 456, chunkMaxBytes: 100, bearerAuth: true}\",","         Path::new(\"/config\"),","         listen(),","         None,","     )","     .unwrap();","     assert_eq!(config.http.oci.max_blob_bytes, 123);","+    assert_eq!(config.http.oci.chunk_max_bytes.unwrap().get(), 100);","     assert_eq!(config.http.oci.max_manifest_bytes, 456);","     assert!(config.http.oci.bearer_auth);","     let config = Config::from_yaml_str(\"{}\", Path::new(\"/config\"), listen(), None).unwrap();","     assert_eq!(config.http.oci.max_blob_bytes, 10 * 1024 * 1024 * 1024);","     assert_eq!(config.http.oci.max_manifest_bytes, 4 * 1024 * 1024);","     assert!(!config.http.oci.bearer_auth);","+    assert!(config.http.oci.chunk_max_bytes.is_none());","     for yaml in [","         \"oci: {maxBlobBytes: 0}\",","         \"oci: {maxManifestBytes: 0}\",","         \"oci: {maxBlobBytes: -1}\",","+        \"oci: {chunkMaxBytes: 0}\",","+        \"oci: {chunkMaxBytes: -1}\",","         \"oci: {maxManifestByte: 1}\",","     ] {","         assert!("],"additions":5,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/oci/upload_session.rs","lines":["@@ -225,7 +225,15 @@ impl Request {","         upload: &BlobUpload,","     ) -> Response {","         match upload.offset().await {","-            Ok(offset) => accepted(&self.base, key.as_str(), upload.id(), offset),","+            Ok(offset) => {","+                let mut response = accepted(&self.base, key.as_str(), upload.id(), offset);","+                if let Some(limit) = self.state.inner.config.http.oci.chunk_max_bytes {","+                    response","+                        .headers_mut()","+                        .insert(\"oci-chunk-max-length\", super::HeaderValue::from(limit.get()));","+                }","+                response","+            }","             Err(err) => registry_error(err),","         }","     }"],"additions":9,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/tests/oci_registry.rs","lines":["@@ -14,6 +14,9 @@ mod discovery;"," #[path = \"oci_registry/manifests.rs\"]"," mod manifests;"," ","+#[path = \"oci_registry/upload_hint.rs\"]","+mod upload_hint;","+"," #[path = \"oci_registry/uploads.rs\"]"," mod uploads;"," "],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/oci_registry/upload_hint.rs","lines":["@@ -0,0 +1,91 @@","+use super::{","+    AuthState, Body, Request, ServiceExt, StatusCode, TempDir, basic, body_bytes, digest_of, get,","+    header, oci_config, router_with_auth, token,","+};","+","+use axum::response::Response;","+use std::num::NonZeroU64;","+","+#[tokio::test]","+async fn chunk_hint_is_optional_and_does_not_limit_the_whole_blob() {","+    let missing_mount = format!(\"?mount={}&from=acme/missing\", digest_of(b\"missing\"));","+    for (limit, suffix) in [","+        (None, \"\"),","+        (None, missing_mount.as_str()),","+        (NonZeroU64::new(5), \"\"),","+        (NonZeroU64::new(5), missing_mount.as_str()),","+    ] {","+        let tmp = TempDir::new().unwrap();","+        let mut config = oci_config(tmp.path().to_path_buf(), \"$all\");","+        config.http.oci.chunk_max_bytes = limit;","+        let app = router_with_auth(config, AuthState::in_memory());","+        let auth = basic(&token(&app).await);","+        let response = app","+            .clone()","+            .oneshot(","+                Request::post(format!(\"/v2/acme/app/blobs/uploads/{suffix}\"))","+                    .header(header::AUTHORIZATION, &auth)","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::ACCEPTED);","+        assert_chunk_hint(&response, limit);","+        let location = response.headers()[header::LOCATION]","+            .to_str()","+            .unwrap()","+            .to_owned();","+        for chunk in [\"hello\", \"world\"] {","+            let response = app","+                .clone()","+                .oneshot(","+                    Request::patch(&location)","+                        .header(header::AUTHORIZATION, &auth)","+                        .body(Body::from(chunk))","+                        .unwrap(),","+                )","+                .await","+                .unwrap();","+            assert_eq!(response.status(), StatusCode::ACCEPTED);","+            assert_chunk_hint(&response, limit);","+        }","+        let response = app","+            .clone()","+            .oneshot(","+                Request::get(&location)","+                    .header(header::AUTHORIZATION, &auth)","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.headers()[header::RANGE], \"0-9\");","+        assert_chunk_hint(&response, limit);","+        let digest = digest_of(b\"helloworld\");","+        let response = app","+            .clone()","+            .oneshot(","+                Request::put(format!(\"{location}?digest={digest}\"))","+                    .header(header::AUTHORIZATION, &auth)","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::CREATED);","+        assert!(!response.headers().contains_key(\"oci-chunk-max-length\"));","+        let response = get(&app, &format!(\"/v2/acme/app/blobs/{digest}\")).await;","+        assert_eq!(body_bytes(response.into_body()).await, b\"helloworld\".as_slice());","+    }","+}","+","+fn assert_chunk_hint(response: &Response, limit: Option<NonZeroU64>) {","+    assert_eq!(","+        response","+            .headers()","+            .get(\"oci-chunk-max-length\")","+            .map(|value| value.to_str().unwrap()),","+        limit.map(|_| \"5\"),","+    );","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"pnpr/docs/cloudflare.md","lines":["@@ -327,7 +327,26 @@ A [cache-policy example](https://github.com/pnpm/pnpm/tree/main/pnpr/examples/cl"," provides these checks for a custom Worker."," "," **Publishes go through the Worker**, so your plan's request body limit caps","-the size of a package you can publish.","+the size of a package you can publish. It also caps each OCI blob upload","+request. A layer larger than that limit fails with HTTP `413` when the client","+sends it in one `PATCH` or `PUT`, even if it fits `oci.maxBlobBytes`.","+","+For clients that honor the proposed `OCI-Chunk-Max-Length` header, configure","+[the upload hint](configuration.md#oci) below your plan's request body limit:","+","+```yaml title=\"pnpr.yaml\"","+oci:","+  chunkMaxBytes: 50000000","+```","+","+This hint cannot force a client to split requests. Docker and Podman uploads","+may still send a whole layer in one request. For those clients, host pnpr","+outside Cloudflare Containers behind your own","+[TLS reverse proxy](tls-and-reverse-proxy.md), with a request body limit that","+accommodates the largest layer. The Container in this guide is","+[only reachable through its Worker](https://developers.cloudflare.com/containers/concepts/architecture/).","+Adding a custom domain to that Worker does not bypass its limit. Raising","+`oci.maxBlobBytes` alone cannot raise Cloudflare's limit."," "," **Container logs are in the dashboard**, under the Worker's logs."," `wrangler tail` shows only the Worker's own events."],"additions":20,"deletions":1,"truncated":false},{"path":"pnpr/docs/configuration.md","lines":["@@ -510,6 +510,12 @@ oci:"," The values shown are the defaults. Both limits must be greater than zero. See"," [Container images](container-images.md#authentication) for `bearerAuth`."," ","+`chunkMaxBytes` optionally advertises a positive chunk size in bytes through","+`OCI-Chunk-Max-Length` on upload start and progress responses. It is a hint,","+not an enforced request limit, and does not change `maxBlobBytes`, which caps","+the whole blob. The header is an [OCI proposal](https://github.com/opencontainers/distribution-spec/issues/485)","+and requires client support. See [Cloudflare](cloudflare.md) for proxy limits.","+"," ## `cors`"," "," The exact browser origins allowed to call pnpr across origins. Cross-origin",""],"additions":6,"deletions":0,"truncated":false}],"additions":142,"deletions":3,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-07T15:03:38.809979+00:00"}