netes-quickstart) in our project documentation. Pinot also provides Kubernetes integrations with the interactive query engine, [Trino](https://docs.pinot.apache.org/integrations/trino), and the data visualization tool, [Apache Superset](helm/superset.yaml)."," "],"additions":13,"deletions":0,"truncated":false},{"path":"pinot-segment-local/src/main/java/org/apache/pinot/segment/local/realtime/impl/invertedindex/MultiColumnRealtimeLuceneTextIndex.java","lines":["@@ -32,6 +32,7 @@"," import org.apache.lucene.analysis.Analyzer;"," import org.apache.lucene.document.Document;"," import org.apache.lucene.index.IndexWriter;","+import org.apache.lucene.index.StoredFields;"," import org.apache.lucene.queryparser.classic.QueryParserBase;"," import org.apache.lucene.search.IndexSearcher;"," import org.apache.lucene.search.Query;","@@ -379,9 +380,10 @@ private MutableRoaringBitmap getPinotDocIds(IndexSearcher indexSearcher, Mutable","     IntIterator luceneDocIDIterator = luceneDocIds.getIntIterator();","     MutableRoaringBitmap actualDocIDs = new MutableRoaringBitmap();","     try {","+      StoredFields storedFields = indexSearcher.storedFields();","       while (luceneDocIDIterator.hasNext()) {","         int luceneDocId = luceneDocIDIterator.next();","-        Document document = indexSearcher.doc(luceneDocId);","+        Document document = storedFields.document(luceneDocId);","         int pinotDocId = Integer.parseInt(document.get(LuceneTextIndexCreator.PINOT_DOC_ID_STORED_FIELD_NAME));","         actualDocIDs.add(pinotDocId);","       }"],"additions":3,"deletions":1,"truncated":false},{"path":"pinot-segment-local/src/main/java/org/apache/pinot/segment/local/realtime/impl/invertedindex/RealtimeLuceneTextIndex.java","lines":["@@ -30,6 +30,7 @@"," import org.apache.lucene.analysis.Analyzer;"," import org.apache.lucene.document.Document;"," import org.apache.lucene.index.IndexWriter;","+import org.apache.lucene.index.StoredFields;"," import org.apache.lucene.queryparser.cla