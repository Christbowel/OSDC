\");","     }"," ","+    #[test]","+    fn test_transaction_keeps_temporary_write_labels_local() {","+        let tenant = Tenant::new_literal(\"tenant\");","+        let txn_mgr = TxnManager::init();","+        let mut txn = txn_mgr.lock();","+        txn.begin();","+        txn.update_multi_table_meta(&tenant, UpdateMultiTableMetaReq {","+            update_temp_tables: vec![UpdateTempTableReq {","+                table_id: TEMP_TBL_ID_BEGIN,","+                desc: \"'db'.'temp'\".to_string(),","+                new_table_meta: Default::default(),","+                copied_files: Default::default(),","+            }],","+            deduplicated_labels: vec![\"local\".to_string()],","+            ..Default::default()","+        })","+        .unwrap();","+        assert!(txn.contains_deduplicated_label(\"local\"));","+        let req = txn.req();","+        assert_eq!(req.update_temp_tables.len(), 1);","+        assert!(req.deduplicated_labels.is_empty());","+","+        txn.update_multi_table_meta(&tenant, UpdateMultiTableMetaReq {","+            update_stream_metas: vec![UpdateStreamMetaReq {","+                stream_id: 7,","+                seq: MatchSeq::Exact(1),","+                options: Default::default(),","+            }],","+            deduplicated_labels: vec![\"stream\".to_string()],","+            ..Default::default()","+        })","+        .unwrap();","+        assert!(txn.contains_deduplicated_label(\"local\"));","+        assert!(txn.contains_deduplicated_label(\"stream\"));","+        assert_eq!(txn.req().deduplicated_labels, [\"stream\"]);","+","+        txn.clear();","+        assert!(!txn.contains_deduplicated_label(\"local\"));","+        assert!(!txn.contains_deduplicated_label(\"stream\"));","+    }","+","     #[test]","     fn test_transaction_preserves_first_lvt_fence() {","         let tenant = Tenant::new_literal(\"tenant\");",""],"additions":59,"deletions":5,"truncated":false}],"additions":285,"deletions":8,"truncated":false,"f