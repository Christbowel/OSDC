al_settings() {","     assert_eq!(expect, format!(\"{}\", result.unwrap_err()));"," }"," ","+#[test]","+fn test_deduplicate_label_is_session_scoped() {","+    let key = \"deduplicate_label\";","+    assert!(DefaultSettings::check_setting_scope(key, SettingScope::Global).is_err());","+","+    let settings = Settings::create(Tenant::new_literal(\"test\"));","+    settings","+        .set_setting(key.to_string(), \"daily_import\".to_string())","+        .unwrap();","+    assert_eq!(","+        unsafe { settings.get_deduplicate_label().unwrap() }.as_deref(),","+        Some(\"daily_import\")","+    );","+}","+"," #[tokio::test(flavor = \"multi_thread\", worker_threads = 1)]"," async fn test_set_data_retention_time_in_days() {","     // Init."],"additions":17,"deletions":0,"truncated":false},{"path":"src/query/storages/common/session/src/transaction.rs","lines":["@@ -101,7 +101,8 @@ pub struct TxnBuffer {","     lvt_check: HashMap<u64, TableLvtCheck>,","     copied_files: HashMap<u64, Vec<UpsertTableCopiedFileReq>>,","     update_stream_meta: HashMap<u64, UpdateStreamMetaReq>,","-    deduplicated_labels: HashSet<String>,","+    local_deduplication_labels: HashSet<String>,","+    persistent_deduplication_labels: HashSet<String>,","     stream_tables: HashMap<u64, StreamSnapshot>,","     need_purge_files: Vec<(StageInfo, Vec<String>)>,","     // These must be discarded with the buffer on rollback or failure as well.","@@ -162,6 +163,14 @@ impl TxnBuffer {","     ) -> Result<()> {","         self.bind_tenant(tenant)?;"," ","+        // Classify labels before merging this statement with unrelated durable updates.","+        let labels = if req.has_persistent_updates() {","+            &mut self.persistent_deduplication_labels","+        } else {","+            &mut self.local_deduplication_labels","+        };","+        labels.extend(req.deduplicated_labels);","+","         for (req, table_info) in req.update_table_metas {","             let table_id = req.table_id;","     