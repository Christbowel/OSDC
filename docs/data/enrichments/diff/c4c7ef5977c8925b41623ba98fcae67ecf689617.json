     util.create_table().await?;","+        let stream = util.get_table().await?;","+        let mut options = stream.meta.options.clone();","+        options.insert(\"offset\".to_string(), \"42\".to_string());","+        mt.update_multi_table_meta(&tenant, UpdateMultiTableMetaReq {","+            update_stream_metas: vec![UpdateStreamMetaReq {","+                stream_id: stream.ident.table_id,","+                seq: MatchSeq::Exact(stream.ident.seq),","+                options: options.clone(),","+            }],","+            deduplicated_labels: vec![label.to_string()],","+            ..Default::default()","+        })","+        .await?","+        .unwrap();","+        assert_eq!(util.get_table().await?.meta.options, options);","+        assert!(mt.get_kv(&key).await?.is_some());","+","+        Ok(())","+    }","+","     async fn table_update_meta<MT: kvapi::KVApi<Error = MetaError> + DatabaseApi + TableApi>(","         &self,","         mt: &MT,"],"additions":60,"deletions":0,"truncated":false},{"path":"src/query/service/src/catalogs/default/session_catalog.rs","lines":["@@ -583,7 +583,7 @@ impl Catalog for SessionCatalog {","         match state {","             TxnState::AutoCommit => {","                 let update_temp_tables = std::mem::take(&mut req.update_temp_tables);","-                let reply = if req.is_empty() {","+                let reply = if !req.has_persistent_updates() {","                     Ok(Default::default())","                 } else {","                     self.inner"],"additions":1,"deletions":1,"truncated":false},{"path":"src/query/service/tests/it/sessions/session.rs","lines":["@@ -13,12 +13,18 @@"," // limitations under the License."," "," use databend_common_catalog::session_type::SessionType;","+use databend_common_meta_app::schema::TableDeduplicationLabelIdent;"," use databend_common_meta_app::tenant::Tenant;","+use databend_common_users::UserApiProvider;"," use databend_common_version::BUILD_INFO;","+use databend_meta_c