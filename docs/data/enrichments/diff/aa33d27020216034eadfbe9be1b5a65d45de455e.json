g-config') },","+      ]) {","+        const child = childProcess({","+          command: [process.execPath, '-e', `","+            const { chromium } = require(${JSON.stringify(require.resolve('playwright-core'))});","+            (async () => {","+              const browser = await chromium.connectOverCDP('chrome');","+              console.log('contexts: ' + browser.contexts().length);","+              await browser.close();","+            })().catch(error => {","+              console.error(error);","+              process.exitCode = 1;","+            });","+          `],","+          env,","+        });","+        await child.cleanExit();","+        expect(child.stdout).toContain('contexts: 1');","+      }","+    }","   } finally {","     await browserServer.close();","   }",""],"additions":33,"deletions":4,"truncated":false}],"additions":84,"deletions":22,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-04T16:04:51.918887+00:00"}