 result;"," }"," "," //===--------------------------------------------------------------------===//"],"additions":22,"deletions":2,"truncated":false},{"path":"src/function/table/range.cpp","lines":["@@ -294,7 +294,7 @@ unique_ptr<NodeStatistics> RangeDateTimeCardinality(ClientContext &context, cons"," \t\treturn nullptr;"," \t}"," \tauto &bind_data = bind_data_p->Cast<RangeDateTimeBindData>();","-\treturn make_uniq<NodeStatistics>(bind_data.cardinality, bind_data.cardinality);","+\treturn make_uniq<NodeStatistics>(bind_data.cardinality);"," }"," "," //! Progress of a timestamp range used as a source (i.e. with a single input row)"],"additions":1,"deletions":1,"truncated":false},{"path":"src/include/duckdb/common/multi_file/multi_file_function.hpp","lines":["@@ -1292,7 +1292,7 @@ class MultiFileFunction : public TableFunction {"," \tstatic unique_ptr<NodeStatistics> MultiFileCardinality(ClientContext &context, const FunctionData *bind_data) {"," \t\tauto &data = bind_data->Cast<MultiFileBindData>();"," \t\tif (IsEmptyResult(data)) {","-\t\t\treturn make_uniq<NodeStatistics>(idx_t(0));","+\t\t\treturn make_uniq<NodeStatistics>(idx_t(0), idx_t(0));"," \t\t}"," \t\tauto file_list_cardinality_estimate = data.file_list->GetCardinality(context);"," \t\tif (file_list_cardinality_estimate) {"],"additions":1,"deletions":1,"truncated":false},{"path":"test/optimizer/CMakeLists.txt","lines":["@@ -17,6 +17,7 @@ add_library_unity(","   relation_statistics.cpp","   remove_unused_columns.cpp","   runtime_filter_schedule.cpp","+  source_cardinality_bounds.cpp","   unchecked_cast.cpp","   union_alls.cpp)"," "],"additions":1,"deletions":0,"truncated":false},{"path":"test/optimizer/parquet_cardinality_bounds.test","lines":["@@ -0,0 +1,96 @@","+# name: test/optimizer/parquet_cardinality_bounds.test","+# description: Parquet row bounds describe the retained row groups of the complete source","+# group: [optimizer]","+","+require parquet","+","+statement ok","+SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};","+","+statement ok","+COPY (SELECT i FROM range(5) t(i)) TO '{TEST_DIR}/source_row_bounds.parquet' (FORMAT PARQUET);","+","+# Integer ranges still provide an exact bound.","+query II","+EXPLAIN SELECT * FROM range(5) LIMIT 6","+----","+physical_plan\t<!REGEX>:.*LIMIT.*","+","+# A single file's bound proves this limit redundant, independently of the estimate.","+foreach estimate 1 1000","+","+query II","+EXPLAIN SELECT i FROM read_parquet('{TEST_DIR}/source_row_bounds.parquet', explicit_cardinality={estimate}) LIMIT 6","+----","+physical_plan\t<!REGEX>:.*LIMIT.*","+","+query I","+SELECT i FROM read_parquet('{TEST_DIR}/source_row_bounds.parquet', explicit_cardinality={estimate}) LIMIT 6","+----","+0","+1","+2","+3","+4","+","+# The footer advertises one row, but its row groups actually contain five.","+query II","+EXPLAIN SELECT i FROM read_parquet('{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', explicit_cardinality={estimate}) LIMIT 2","+----","+physical_plan\t<REGEX>:.*LIMIT.*","+","+query I","+SELECT i FROM read_parquet('{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', explicit_cardinality={estimate}) LIMIT 2","+----","+0","+1","+","+query II","+EXPLAIN SELECT i FROM read_parquet('{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', explicit_cardinality={estimate}) LIMIT 6","+----","+physical_plan\t<!REGEX>:.*LIMIT.*","+","+query I","+SELECT i FROM read_parquet('{DATA_DIR}/parquet-testing/footer_row_count_mismatch.parquet', explicit_cardinality={estimate}) LIMIT 6","+----","+0","+1","+2","+3","+4","+","+endloop","+","+# The first file's bound must not become a bound for the complete list.","+query II","+EXPLAIN SELECT i FROM read_parquet(['{TEST_DIR}/source_row_bounds.parquet', '{TEST_DIR}/source_row_bounds.parquet']) LIMIT 6","+----","+physical_plan\t<REGEX>:.*LIMIT.*","+","+query I","+SELECT count(*) FROM (SELECT i FROM read_parquet(['{TEST_DIR}/source_row_bounds.parquet', '{TEST_DIR}/source_row_bounds.parquet']) LIMIT 6)","+----","+6","+","+# Union-by-name scans do not expose this single-file bound.","+query II","+EXPLAIN SELECT i FROM read_parquet('{TEST_DIR}/source_row_bounds.parquet', union_by_name=true) LIMIT 6","+----","+physical_plan\t<REGEX>:.*LIMIT.*","+","+query I","+SELECT sum(i) FROM read_parquet('{TEST_DIR}/source_row_bounds.parquet', union_by_name=true)","+----","+10","+","+statement ok","+COPY (SELECT 1::BIGINT i WHERE false) TO '{TEST_DIR}/empty_source_row_bounds.parquet' (FORMAT PARQUET);","+","+query II","+EXPLAIN SELECT i FROM read_parquet('{TEST_DIR}/empty_source_row_bounds.parquet') LIMIT 1","+----","+physical_plan\t<!REGEX>:.*LIMIT.*","+","+query I","+SELECT i FROM read_parquet('{TEST_DIR}/empty_source_row_bounds.parquet') LIMIT 1","+----"],"additions":96,"deletions":0,"truncated":false},{"path":"test/optimizer/source_cardinality_bounds.cpp","lines":["@@ -0,0 +1,53 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+","+#include \"duckdb/common/multi_file/multi_file_states.hpp\"","+#include \"duckdb/main/extension_helper.hpp\"","+#include \"duckdb/parser/parser.hpp\"","+#include \"duckdb/planner/operator/logical_get.hpp\"","+#include \"duckdb/planner/planner.hpp\"","+#include \"duckdb/storage/statistics/node_statistics.hpp\"","+","+using namespace duckdb;","+","+namespace {","+","+LogicalGet &BoundSource(LogicalOperator &op) {","+\tif (op.type == LogicalOperatorType::LOGICAL_GET) {","+\t\treturn op.Cast<LogicalGet>();","+\t}","+\tREQUIRE(op.children.size() == 1);","+\treturn BoundSource(*op.children[0]);","+}","+","+} // namespace","+","+TEST_CASE(\"Parquet row bounds survive consuming the initial reader\", \"[optimizer][source_cardinality_bounds]\") {","+\tDuckDB db;","+\tif (ExtensionHelper::LoadExtension(db, \"parquet\") != ExtensionLoadResult::LOADED_EXTENSION) {","+\t\tSKIP_TEST(\"require parquet\");","+\t}","+\tConnection con(db);","+\tauto path = TestCreatePath(\"source_row_bounds.parquet\");","+\tREQUIRE_NO_FAIL(con.Query(\"COPY (SELECT i FROM range(5) t(i)) TO '\" + path + \"' (FORMAT PARQUET)\"));","+\tcon.BeginTransaction();","+\tPlanner planner(*con.context);","+\tParser parser(*con.context);","+\tparser.ParseQuery(\"SELECT * FROM read_parquet('\" + path + \"')\");","+\tplanner.CreatePlan(std::move(parser.statements[0]));","+\tauto &get = BoundSource(*planner.plan);","+\tauto &bind_data = get.bind_data->Cast<MultiFileBindData>();","+\tREQUIRE(bind_data.initial_reader);","+\tbind_data.initial_reader.reset();","+\tauto stats = get.function.cardinality(*con.context, get.bind_data.get());","+\tREQUIRE(stats);","+\tREQUIRE(stats->has_max_cardinality);","+\tREQUIRE(stats->max_cardinality == 5);","+","+\t// An execution copy has no retained row groups from which to prove a bound.","+\tauto execution_copy = get.bind_data->Copy();","+\tauto copied_stats = get.function.cardinality(*con.context, execution_copy.get());","+\tREQUIRE(copied_stats);","+\tREQUIRE_FALSE(copied_stats->has_max_cardinality);","+\tcon.Rollback();","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"test/optimizer/temporal_cardinality_bounds.test","lines":["@@ -0,0 +1,27 @@","+# name: test/optimizer/temporal_cardinality_bounds.test","+# description: Approximate timestamp range counts cannot prove a LIMIT redundant","+# group: [optimizer]","+","+statement ok","+SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};","+","+# Both ranges estimate zero rows but produce one.","+query I","+SELECT count(*) FROM range(TIMESTAMP '2024-01-01', TIMESTAMP '2024-01-01 12:00:00', INTERVAL '1 day')","+----","+1","+","+query II","+EXPLAIN SELECT * FROM range(TIMESTAMP '2024-01-01', TIMESTAMP '2024-01-01 12:00:00', INTERVAL '1 day') LIMIT 1","+----","+physical_plan\t<REGEX>:.*LIMIT.*","+","+query I","+SELECT count(*) FROM range(TIMESTAMP '2024-02-01', TIMESTAMP '2024-03-01', INTERVAL '1 month')","+----","+1","+","+query II","+EXPLAIN SELECT * FROM range(TIMESTAMP '2024-02-01', TIMESTAMP '2024-03-01', INTERVAL '1 month') LIMIT 1","+----","+physical_plan\t<REGEX>:.*LIMIT.*"],"additions":27,"deletions":0,"truncated":false},{"path":"test/optimizer/temporal_cardinality_bounds_icu.test","lines":["@@ -0,0 +1,32 @@","+# name: test/optimizer/temporal_cardinality_bounds_icu.test","+# description: Approximate ICU range counts cannot prove a LIMIT redundant","+# group: [optimizer]","+","+require icu","+","+statement ok","+SET TimeZone = 'UTC';","+","+statement ok","+SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};","+","+# The inclusive endpoint produces a row even though the estimated count is zero.","+query I","+SELECT count(*) FROM generate_series(TIMESTAMPTZ '2024-01-01 00:00:00+00', TIMESTAMPTZ '2024-01-01 00:00:00+00', INTERVAL '1 day')","+----","+1","+","+query II","+EXPLAIN SELECT * FROM generate_series(TIMESTAMPTZ '2024-01-01 00:00:00+00', TIMESTAMPTZ '2024-01-01 00:00:00+00', INTERVAL '1 day') LIMIT 1","+----","+physical_plan\t<REGEX>:.*LIMIT.*","+","+query I","+SELECT count(*) FROM range(TIMESTAMPTZ '2024-02-01 00:00:00+00', TIMESTAMPTZ '2024-03-01 00:00:00+00', INTERVAL '1 month')","+----","+1","+","+query II","+EXPLAIN SELECT * FROM range(TIMESTAMPTZ '2024-02-01 00:00:00+00', TIMESTAMPTZ '2024-03-01 00:00:00+00', INTERVAL '1 month') LIMIT 1","+----","+physical_plan\t<REGEX>:.*LIMIT.*",""],"additions":32,"deletions":0,"truncated":false}],"additions":249,"deletions":6,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-03T16:49:42.308958+00:00"}