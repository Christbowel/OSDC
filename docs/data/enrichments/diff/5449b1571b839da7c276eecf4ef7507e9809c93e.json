{"id":"5449b1571b839da7c276eecf4ef7507e9809c93e","axis":"silent","repo":"vimeo/psalm","sha":"5449b1571b839da7c276eecf4ef7507e9809c93e","parsed":{"files":[{"path":"docs/running_psalm/issues/MissingExtensionRequirement.md","lines":["@@ -57,5 +57,16 @@ final class Client extends SoapClient {}                    // MissingExtensionR"," An extension is declared when `composer.json` requires it (`require-dev` too) or suggests it, when an installed"," package provides or replaces it (the polyfills, such as `symfony/polyfill-mbstring`), and when"," [`<enableExtensions>`](../configuration.md#enableextensions) lists it. Without a `composer.json`, the issue isn't","-reported. The core extensions (`Core`, `standard`, `date`, `pcre`, `SPL`, `Reflection`, `hash`, `json` from PHP 8.0","-and `random` from PHP 8.2) need no declaration.","+reported.","+","+The extensions PHP is always built with need no declaration: `Core`, `standard`, `date`, `pcre`, `SPL`, `Reflection`,","+`hash` from PHP 7.4, `json` from PHP 8.0, `random` from PHP 8.2, `uri` and `Zend OPcache` from PHP 8.5. Psalm checks","+the lowest PHP version the `php` requirement of `composer.json` allows:","+","+```php","+<?php // composer.json requires \"php\": \"^7.3\"","+","+function digest(string $s): string {","+    return hash('sha256', $s);                              // MissingExtensionRequirement: PHP 7.3 can be built without it","+}","+```"],"additions":13,"deletions":2,"truncated":false},{"path":"src/Psalm/Config.php","lines":["@@ -629,6 +629,12 @@ final class Config","      */","     public ?array $declared_extensions = null;"," ","+    /**","+     * The lowest PHP version the `php` requirement of composer.json allows, as an id (`70300`), or null when it doesn't","+     * constrain it. An extension only needs no declaration if every PHP version from this one on builds it in.","+     */","+    public ?int $lowest_composer_php_version_id = null;","+","     /**","      * A list of php extensions supported by Psalm.","      * Where key - extension name (without ext- prefix), value - whether to load extension’s stub.","@@ -1298,6 +1304,12 @@ private static function fromXmlAndPaths("," ","         if ($composer_json !== null) {","             $config->declared_extensions = self::getDeclaredExtensions($composer_json, $config->base_dir);","+","+            $lowest_php_version = $config->getPHPVersionFromComposerJson();","+            if ($lowest_php_version !== null) {","+                [$major, $minor] = explode('.', $lowest_php_version);","+                $config->lowest_composer_php_version_id = (int) $major * 10_000 + (int) $minor * 100;","+            }","         }"," ","         if (isset($config_xml->enableExtensions) && isset($config_xml->enableExtensions->extension)) {"],"additions":12,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/ExtensionRequirementAnalyzer.php","lines":["@@ -22,7 +22,8 @@"," final class ExtensionRequirementAnalyzer"," {","     /**","-     * The extensions PHP can't be built without, from the PHP version (as an id) they are part of the core","+     * The extensions PHP can't be built without (php-src has no configure option to disable them), from the PHP","+     * version (as an id) they are always built in","      */","     private const CORE_EXTENSIONS = [","         'core' => 0,","@@ -34,6 +35,8 @@ final class ExtensionRequirementAnalyzer","         'hash' => 7_04_00,","         'json' => 8_00_00,","         'random' => 8_02_00,","+        'uri' => 8_05_00,","+        'zend opcache' => 8_05_00,","     ];"," ","     /**","@@ -84,8 +87,12 @@ private static function getUndeclaredExtension(","             return null;","         }"," ","+        // the code also runs on the older PHP versions composer.json allows, which may have been built without it","         $core_since = self::CORE_EXTENSIONS[$extension] ?? null;","-        if ($core_since !== null && $core_since <= $codebase->analysis_php_version_id) {","+        if ($core_