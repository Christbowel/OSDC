;","+","+        assert_decode_error::<NaiveDate>(&mut conn, \"SELECT DATE 'infinity'\").await?;","+        assert_decode_error::<NaiveDate>(&mut conn, \"SELECT DATE '-infinity'\").await?;","+        assert_decode_error::<NaiveDate>(&mut conn, \"SELECT DATE '5874897-12-31'\").await?;","+","+        assert_decode_error::<NaiveDateTime>(&mut conn, \"SELECT TIMESTAMP 'infinity'\").await?;","+        assert_decode_error::<NaiveDateTime>(&mut conn, \"SELECT TIMESTAMP '-infinity'\").await?;","+        assert_decode_error::<NaiveDateTime>(&mut conn, \"SELECT TIMESTAMP '294276-12-31 23:59:59'\")","+            .await?;","+","+        assert_decode_error::<DateTime<Utc>>(&mut conn, \"SELECT TIMESTAMPTZ 'infinity'\").await?;","+        assert_decode_error::<DateTime<FixedOffset>>(&mut conn, \"SELECT TIMESTAMPTZ '-infinity'\")","+            .await?;","+","+        assert_decode_error::<NaiveTime>(&mut conn, \"SELECT TIME '24:00:00'\").await?;","+        assert_decode_error::<PgTimeTz>(&mut conn, \"SELECT TIMETZ '24:00:00+00'\").await?;","+","+        assert_decode_error::<Vec<NaiveDateTime>>(","+            &mut conn,","+            \"SELECT array['2019-01-02 05:10:20', 'infinity']::timestamp[]\",","+        )","+        .await?;","+        assert_decode_error::<PgRange<DateTime<Utc>>>(","+            &mut conn,","+            \"SELECT tstzrange('-infinity', 'infinity')\",","+        )","+        .await?;","+","+        Ok(())","+    }"," }"," "," #[cfg(feature = \"time\")]","@@ -407,6 +471,42 @@ mod time_tests {","         \"TIMETZ '05:10:20.115100-05'\" == PgTimeTz { time: time!(5:10:20.115100), offset: UtcOffset::from_whole_seconds(-(60 * 60 * 5)).unwrap() },","         \"TIMETZ '05:10:20+02'\" == PgTimeTz { time: time!(5:10:20), offset: UtcOffset::from_whole_seconds(60 * 60 * 2 ).unwrap() }","     ));","+","+    #[sqlx_macros::test]","+    async fn time_out_of_range() -> anyhow::Result<()> {","+        let mut conn = new::<Postgres>().await?;","+","+        assert_decode_