st_runtime() {","             \"version\": \"1.0.0\",","             \"engines\": { \"node\": node_version },","             \"devEngines\": {","-                \"runtime\": { \"name\": \"node\", \"version\": \">=1.0.0\" },","+                \"runtime\": { \"name\": \"node\", \"version\": \"1.0.0\" },","             },","         })","         .to_string(),","@@ -177,6 +177,48 @@ fn no_runtime_checks_the_active_node_instead_of_the_manifest_runtime() {","     drop(root);"," }"," ","+/// `dedupe` and `prune` check the root engine against the Node.js that runs","+/// once they skip the runtime, as `install --no-runtime` does.","+#[test]","+fn skipped_runtime_maintenance_commands_check_the_active_node() {","+    let cases: [(&str, &[&str]); 3] = [","+        (\"runtime: false\\n\", &[\"dedupe\"]),","+        (\"runtime: false\\n\", &[\"prune\"]),","+        (\"\", &[\"dedupe\", \"--no-runtime\"]),","+    ];","+    for (yaml, args) in cases {","+        let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+        let manifest = |engines: serde_json::Value| {","+            serde_json::json!({","+                \"name\": \"compatible-root\",","+                \"version\": \"1.0.0\",","+                \"engines\": engines,","+                \"devEngines\": { \"runtime\": { \"name\": \"node\", \"version\": \"1.0.0\" } },","+            })","+            .to_string()","+        };","+        fs::write(workspace.join(\"package.json\"), manifest(serde_json::json!({})))","+            .expect(\"write initial package.json\");","+        let node_version = node_version_at(&workspace);","+        fs::write(","+            workspace.join(\"package.json\"),","+            manifest(serde_json::json!({ \"node\": node_version })),","+        )","+        .expect(\"write package.json\");","+        fs::write(workspace.join(\"pnpm-workspace.yaml\"), format!(\"engineStrict: true\\n{yaml}\"))","+            .expect(\"write workspace settings\");","+","+        pacquet","+            .with_env(\"PNPM_CONFIG_GLOBAL_SHIMS\", r#\"{\"node\":false}\"#)","+            .with_env(\"PNPM_SHIM_BYPASS\", \"1\")","+            .with_args(args)","+            .assert()","+            .success();","+","+        drop(root);","+    }","+}","+"," fn node_version_at(dir: &Path) -> String {","     let node_output = Command::new(\"node\")","         .without_ambient_pnpm_config()"],"additions":44,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_runtimes/no_runtime.rs","lines":["@@ -57,6 +57,155 @@ fn hoisted_no_runtime_installs_can_be_repeated_and_restore_the_runtime() {","     assert_installed(&workspace, std::slice::from_ref(&fixture));"," }"," ","+#[test]","+fn runtime_false_setting_skips_the_runtime() {","+    for (yaml, args) in [(\"runtime: false\\n\", &[][..]), (\"\", &[\"--config.runtime=false\"][..])] {","+        let root = tempfile::tempdir().unwrap();","+        let workspace = prepare_workspace(&root, yaml);","+        let mut server = mockito::Server::new();","+        let fixture = runtime_fixture(&mut server, \"node\", \"24.0.0\", host_platform(), host_arch());","+        write_devengines_manifest(&workspace, fixture.version, Some(\"download\"));","+        write_runtime_lockfile_for_group(","+            &workspace,","+            std::slice::from_ref(&fixture),","+            \"devDependencies\",","+        );","+","+        command(&workspace)","+            .with_args([\"install\", \"--frozen-lockfile\"])","+            .with_args(args)","+            .assert()","+            .success();","+        assert!(!workspace.join(\"node_modules/node\").exists(), \"{yaml:?} {args:?}\");","+        assert!(!fixture.archive_mock.matched(), \"{yaml:?} {args:?}\");","+    }","+}","+","+#[test]","+fn command_line_runtime_setting_overrides_the_workspace_yaml() {","+    let root = tempfile::tempdir().unwrap();","+    let workspace = prepare_workspace(&root, \"runtime: false\\n\");","+    let mut server = mockito::Server::new();","+    let fixture = runtime_fixture(&mut server, \"node\", \"24.0.0\", host_platform(), host_arch());","+    write_devengines_manifest(&workspace, fixture.version, Some(\"download\"));","+    write_runtime_lockfile_for_group(&workspace, std::slice::from_ref(&fixture), \"devDependencies\");","+","+    command(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\", \"--config.runtime=true\"])","+        .assert()","+        .success();","+    assert_installed(&workspace, std::slice::from_ref(&fixture));","+}","+","+/// An `updateConfig` hook reads `runtime` only when a source set it, as on","+/// pnpm 11, where `--no-runtime` is the `runtime: false` setting.","+#[test]","+fn update_config_sees_runtime_only_when_set() {","+    let dump_config = \"const fs = require('fs');\\nconst path = require('path');\\nmodule.exports = { hooks: { updateConfig (config) {\\n  fs.writeFileSync(path.join(__dirname, 'seen.json'), JSON.stringify(config));\\n  return config;\\n} } }\";","+    for (yaml, args, expected) in [","+        (\"\", &[][..], None),","+        (\"runtime: false\\n\", &[][..], Some(false)),","+        (\"\", &[\"--no-runtime\"][..], Some(false)),","+        (\"\", &[\"--config.runtime=true\"][..], Some(true)),","+    ] {","+        let root = tempfile::tempdir().unwrap();","+        let workspace = prepare_workspace(&root, yaml);","+        let mut server = mockito::Server::new();","+        let fixture = runtime_fixture(&mut server, \"node\", \"24.0.0\", host_platform(), host_arch());","+        write_devengines_manifest(&workspace, fixture.version, Some(\"download\"));","+        write_runtime_lockfile_for_group(","+            &workspace,","+            std::slice::from_ref(&fixture),","+            \"devDependencies\",","+        );","+        fs::write(workspace.join(\".pnpmfile.cjs\"), dump_config).unwrap();","+","+        command(&workspace)","+            .with_arg(\"install\")","+            .with_args(args)","+            .assert()","+            .success();","+        let seen: Value =","+            serde_json::from_slice(&fs::read(workspace.join(\"seen.json\")).unwrap()).unwrap();","+        assert_eq!(seen.get(\"runtime\").and_then(Value::as_bool), expected, \"{yaml:?} {args:?}\");","+        assert_eq!(seen.get(\"runtime\").is_some(), expected.is_some(), \"{yaml:?} {args:?}\");","+    }","+}","+","+#[test]","+fn dedupe_and_prune_follow_the_runtime_setting() {","+    let cases: [(&str, &[&str]); 3] = [","+        (\"runtime: false\\n\", &[\"dedupe\"]),","+        (\"runtime: false\\n\", &[\"prune\"]),","+        (\"\", &[\"dedupe\", \"--no-runtime\"]),","+    ];","+    for (yaml, args) in cases {","+        let root = tempfile::tempdir().unwrap();","+        let mut server = mockito::Server::new();","+        let (workspace, fixture) = locked_runtime_project(&root, &mut server, yaml);","+","+        command(&workspace)","+            .with_args(args)","+            .assert()","+            .success();","+        assert!(!workspace.join(\"node_modules/node\").exists(), \"{args:?}\");","+        assert!(!fixture.archive_mock.matched(), \"{args:?}\");","+    }","+}","+","+#[test]","+fn update_config_hook_cannot_undo_no_runtime() {","+    for command_name in [\"install\", \"dedupe\"] {","+        let root = tempfile::tempdir().unwrap();","+        let mut server = mockito::Server::new();","+        let (workspace, fixture) = locked_runtime_project(&root, &mut server, \"\");","+        fs::write(","+            workspace.join(\".pnpmfile.cjs\"),","+            \"module.exports = { hooks: { updateConfig (config) { config.runtime = true; return config } } }\",","+        )","+        .unwrap();","+","+        command(&workspace)","+            .with_args([command_name, \"--no-runtime\"])","+            .assert()","+            .success();","+        assert!(!workspace.join(\"node_modules/node\").exists(), \"{command_name}\");","+        assert!(!fixture.archive_mock.matched(), \"{command_name}\");","+    }","+}","+","+#[test]","+fn update_config_hook_can_skip_the_runtime() {","+    let root = tempfile::tempdir().unwrap();","+    let mut server = mockito::Server::new();","+    let (workspace, fixture) = locked_runtime_project(&root, &mut server, \"\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        \"module.exports = { hooks: { updateConfig (config) { config.runtime = false; return config } } }\",","+    )","+    .unwrap();","+","+    command(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(!workspace.join(\"node_modules/node\").exists());","+    assert!(!fixture.archive_mock.matched());","+}","+","+/// A workspace whose `devEngines.runtime` is locked to a mocked Node.js 24.0.0.","+fn locked_runtime_project(","+    root: &tempfile::TempDir,","+    server: &mut mockito::Server,","+    extra_yaml: &str,","+) -> (std::path::PathBuf, RuntimeFixture) {","+    let workspace = prepare_workspace(root, extra_yaml);","+    let fixture = runtime_fixture(server, \"node\", \"24.0.0\", host_platform(), host_arch());","+    write_devengines_manifest(&workspace, fixture.version, Some(\"download\"));","+    write_runtime_lockfile_for_group(&workspace, std::slice::from_ref(&fixture), \"devDependencies\");","+    (workspace, fixture)","+}","+"," #[test]"," fn fresh_install_with_no_runtime_resolves_but_does_not_fetch_the_runtime() {","     let root = tempfile::tempdir().unwrap();"],"additions":149,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay.rs","lines":["@@ -318,6 +318,7 @@ impl WorkspaceSettings {","         json_field!(settings, reader, engine_strict, \"ENGINE_STRICT\");","         json_field!(settings, reader, force_ignores_platform, \"FORCE_IGNORES_PLATFORM\");","         string_field!(settings, reader, node_version, \"NODE_VERSION\");","+        json_field!(settings, reader, runtime, \"RUNTIME\");","         enum_field!(settings, reader, runtime_on_fail, \"RUNTIME_ON_FAIL\", RuntimeOnFail);","         json_field!(settings, reader, node_download_mirrors, \"NODE_DOWNLOAD_MIRRORS\");","         enum_field!("],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -508,8 +508,8 @@ pub struct Config {","     /// `deno@runtime:`, `bun@runtime:`) are skipped at install","     /// time — their archives aren't fetched, their slots aren't","     /// materialized, and their bins aren't linked. The rest of","-    /// the install proceeds normally. The `skipRuntimes` option,","-    /// exposed via the `--no-runtime` CLI flag.","+    /// the install proceeds normally. Set by `runtime: false` and the","+    /// `--no-runtime` CLI flag.","     ///","     /// Defaults to `false`. CI scenarios that","     /// pre-provision the runtime (or want to install one runtime"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/tests/workspace_settings_materialization_env_vars_override.rs","lines":["@@ -444,6 +444,59 @@ pub fn runtime_on_fail_from_workspace_yaml() {","     assert_eq!(config.runtime_on_fail, Some(crate::RuntimeOnFail::Download));"," }"," ","+#[test]","+pub fn runtime_false_from_workspace_yaml_skips_runtimes() {","+    let tmp = tempdir().unwrap();","+    let config = Config::new().current::<HostNoHome>(tmp.path()).expect(\"loads\");","+    assert!(!config.skip_runtimes);","+    fs::write(tmp.path().join(\"pnpm-workspace.yaml\"), \"runtime: false\\n\")","+        .expect(\"write to pnpm-workspace.yaml\");","+    let config = Config::new().current::<HostNoHome>(tmp.path()).expect(\"yaml is valid\");","+    assert!(config.skip_runtimes);","+}","+","+#[test]","+pub fn runtime_env_var_overrides_workspace_yaml() {","+    let tmp = tempdir().unwrap();","+    fs::write(tmp.path().join(\"pnpm-workspace.yaml\"), \"runtime: false\\n\")","+        .expect(\"write to pnpm-workspace.yaml\");","+","+    struct HostWithRuntimeEnv;","+    impl EnvVar for 