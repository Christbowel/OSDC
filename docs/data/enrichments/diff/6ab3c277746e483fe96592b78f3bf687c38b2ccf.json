{"id":"6ab3c277746e483fe96592b78f3bf687c38b2ccf","axis":"silent","repo":"pnpm/pnpm","sha":"6ab3c277746e483fe96592b78f3bf687c38b2ccf","parsed":{"files":[{"path":".changeset/runtime-false-setting.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+The `runtime` setting is now read. Setting `runtime: false` in `pnpm-workspace.yaml`, `pnpm_config_runtime=false`, or `--config.runtime=false` stops `pnpm install`, `pnpm add`, `pnpm dedupe`, and the other installing commands from installing the runtimes in `devEngines.runtime` and `engines.runtime`. `pnpm dedupe` now also accepts `--no-runtime`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dedupe.rs","lines":["@@ -48,6 +48,10 @@ pub struct DedupeArgs {","     /// `node_modules`.","     #[clap(long = \"lockfile-only\")]","     pub lockfile_only: bool,","+    /// Don't install runtime dependencies (`node`, `deno`, `bun`). Their","+    /// archives aren't fetched and their bins aren't linked.","+    #[clap(long = \"no-runtime\")]","+    pub no_runtime: bool,","     #[clap(flatten)]","     pub scripts: crate::cli_args::install_options::ScriptExecutionArgs,","     #[clap(flatten)]","@@ -83,7 +87,6 @@ impl DedupeArgs {","             base_install.lockfile_policy.prefer_frozen = Some(false);","             base_install.lockfile_policy.excludes =","                 if self.check { PolicyExcludes::Skip } else { PolicyExcludes::Persist };","-            base_install.execution.skip_runtimes = false;","             base_install.execution.lockfile_only = self.lockfile_only || self.check;","             base_install.resolution.update_seed_policy =","                 pnpm_package_manager::UpdateSeedPolicy::KeepAllResolveAll;"],"additions":4,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines.rs","lines":["@@ -99,14 +99,12 @@ pub(crate) enum InstallFamilyPlan {"," "," #[derive(Clone, Copy)]"," enum RuntimePolicy {","-    Always,","     Config(bool),"," }"," "," impl RuntimePolicy {","     fn use_manifest(self, config: &Config) -> bool {","         match self {","-            Self::Always => true,","             Self::Config(no_runtime) => !(config.skip_runtimes || no_runtime),","         }","     }","@@ -119,6 +117,9 @@ async fn prepare_root_config<Reporter>("," where","     Reporter: self::Reporter,"," {","+    if matches!(runtime_policy, RuntimePolicy::Config(true)) {","+        configuration::record_no_runtime_flag(config);","+    }","     if !config_deps::may_update_config(config, config_root) {","         check_root_project_engine(manifest_path, config, runtime_policy.use_manifest(config))?;","     }"],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines/configuration.rs","lines":["@@ -165,3 +165,11 @@ pub(super) fn active_manifest_is_standin(","             .iter()","             .any(|project| pnpm_fs::lexical_normalize(&project.root_dir) == normalized_active_dir))"," }","+","+/// Record `--no-runtime` as the `runtime: false` setting the command line","+/// set, so `updateConfig` hooks read it and cannot override it.","+pub(super) fn record_no_runtime_flag(config: &mut Config) {","+    config.skip_runtimes = true;","+    config.explicit_settings.insert(\"runtime\".to_string(), false.into());","+    config.cli_settings.insert(\"runtime\".to_string());","+}"],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipelines/maintenance.rs","lines":["@@ -30,7 +30,11 @@ impl DedupePipeline {","             self.args.check.then(|| dedupe::LockfileGuard::new(existing.clone(), &lockfile_path));"," ","         let root_config = (&*self.manifest_path, &mut *self.cfg, &*self.config_root);","-        prepare_root_config::<Reporter>(root_config, (false, RuntimePolicy::Always)).await?;","+        prepare_root_config::<Reporter>(","+            root_config,","+            (false, RuntimePolicy::Config(self.args.no_runtime)),","+        )","+      