 != nil {","+\t\t\tallowlist.ips = append(allowlist.ips, ip)","+\t\t\tcontinue","+\t\t}","+","+\t\thost, err := hostFromAllowlistEntry(entry)","+\t\tif err != nil {","+\t\t\treturn Allowlist{}, err","+\t\t}","+\t\tif ip := net.ParseIP(host); ip != nil {","+\t\t\tallowlist.ips = append(allowlist.ips, ip)","+\t\t\tcontinue","+\t\t}","+\t\tallowlist.hosts[host] = struct{}{}","+\t}","+\treturn allowlist, nil","+}","+","+func (a Allowlist) AllowsHost(host string) bool {","+\thost, err := normalizeHost(host, host)","+\tif err != nil {","+\t\treturn false","+\t}","+\t_, ok := a.hosts[host]","+\treturn ok","+}","+","+func (a Allowlist) AllowsIP(ip net.IP) bool {","+\tfor _, allowedIP := range a.ips {","+\t\tif allowedIP.Equal(ip) {","+\t\t\treturn true","+\t\t}","+\t}","+\tfor _, ipNet := range a.cidrs {","+\t\tif ipNet.Contains(ip) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func hostFromAllowlistEntry(entry string) (string, error) {","+\tif strings.Contains(entry, \"://\") {","+\t\tparsed, err := url.Parse(entry)","+\t\tif err != nil {","+\t\t\treturn \"\", fmt.Errorf(\"parse private endpoint allowlist entry %q: %w\", entry, err)","+\t\t}","+\t\treturn normalizeHost(parsed.Hostname(), entry)","+\t}","+","+\thost, _, err := net.SplitHostPort(entry)","+\tif err == nil {","+\t\treturn normalizeHost(host, entry)","+\t}","+","+\treturn normalizeHost(strings.Trim(entry, \"[]\"), entry)","+}","+","+func normalizeHost(host, source string) (string, error) {","+\thost = strings.ToLower(strings.TrimSpace(host))","+\thost = strings.TrimSuffix(host, \".\")","+\tif host == \"\" {","+\t\treturn \"\", fmt.Errorf(\"private endpoint allowlist entry %q has an empty host\", source)","+\t}","+\treturn host, nil","+}"],"additions":93,"deletions":0,"truncated":false},{"path":"apps/provisioning/pkg/repository/url_allowlist_test.go","lines":["@@ -0,0 +1,100 @@","+package repository","+","+import (","+\t\"net\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestNewAllowlist(t *testing.T) {","+\ttests := []struct {","+\t\tname          string","+\t\tentries       []string","+\t\tallowedHosts  []string","+\t\tblockedHosts  []string","+\t\tallowedIPs    []string","+\t\tblockedIPs    []string","+\t\twantErr       bool","+\t\twantErrString string","+\t}{","+\t\t{","+\t\t\tname:         \"allows hostnames case insensitively\",","+\t\t\tentries:      []string{\" Internal.Example.Com. \"},","+\t\t\tallowedHosts: []string{\"internal.example.com\", \"INTERNAL.EXAMPLE.COM.\"},","+\t\t\tblockedHosts: []string{\"other.example.com\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"allows host from host and port\",","+\t\t\tentries:      []string{\"internal.example.com:8443\"},","+\t\t\tallowedHosts: []string{\"internal.example.com\"},","+\t\t\tblockedHosts: []string{\"other.example.com\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"allows host from URL\",","+\t\t\tentries:      []string{\"https://internal.example.com/grafana/grafana.git\"},","+\t\t\tallowedHosts: []string{\"internal.example.com\"},","+\t\t\tblockedHosts: []string{\"other.example.com\"},","+\t\t},","+\t\t{","+\t\t\tname:       \"allows exact IP\",","+\t\t\tentries:    []string{\"10.0.0.10\"},","+\t\t\tallowedIPs: []string{\"10.0.0.10\"},","+\t\t\tblockedIPs: []string{\"10.0.0.11\"},","+\t\t},","+\t\t{","+\t\t\tname:       \"allows bracketed IP\",","+\t\t\tentries:    []string{\"[::1]\"},","+\t\t\tallowedIPs: []string{\"::1\"},","+\t\t\tblockedIPs: []string{\"::2\"},","+\t\t},","+\t\t{","+\t\t\tname:       \"allows IP from host and port\",","+\t\t\tentries:    []string{\"10.0.0.10:8443\"},","+\t\t\tallowedIPs: []string{\"10.0.0.10\"},","+\t\t\tblockedIPs: []string{\"10.0.0.11\"},","+\t\t},","+\t\t{","+\t\t\tname:       \"allows CIDR match\",","+\t\t\tentries:    []string{\"10.0.0.0/24\"},","+\t\t\tallowedIPs: []string{\"10.0.0.10\"},","+\t\t\tblockedIPs: []string{\"10.0.1.10\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"ignores empty entries\",","