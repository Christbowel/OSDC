AndMul(alpha=alpha, limit=limit)","+    if activation == MoEActivation.SWIGLUOAI_UNINTERLEAVE:","+        return SiluAndMulWithClamp(limit, alpha, beta, compile_native=False)","+    if limit is not None:","+        return SiluAndMulWithClamp(limit, compile_native=False)","+    return SiluAndMul()","+","+","+def _torch_moe_reference(","+    a: torch.Tensor,","+    w1: torch.Tensor,","+    w2: torch.Tensor,","+    score: torch.Tensor,","+    topk: int,","+    act_fn,","+) -> torch.Tensor:","+    m = a.shape[0]","+    weights, ids = torch.topk(torch.softmax(score, dim=-1, dtype=torch.float32), topk)","+    x = a.view(m, 1, -1).repeat(1, topk, 1).reshape(m * topk, -1)","+    flat_ids = ids.reshape(-1)","+    out = torch.zeros(m * topk, w2.shape[1], dtype=a.dtype, device=a.device)","+    for expert in range(w1.shape[0]):","+        mask = flat_ids == expert","+        if mask.any():","+            acc = act_fn(x[mask] @ w1[expert].transpose(0, 1)).to(a.dtype)","+            out[mask] = acc @ w2[expert].transpose(0, 1)","+    return (","+        (out.view(m, topk, -1).float() * weights.view(m, topk, 1))","+        .sum(dim=1)","+        .to(a.dtype)","+    )","+"," "," def _quantize_nvfp4_linear(","     weight: torch.Tensor,","@@ -85,14 +160,19 @@ def _dequantize_nvfp4_linear("," "," "," @pytest.mark.parametrize(\"m,n,k,e,topk\", [(16, 128, 512, 4, 2)])","+@pytest.mark.parametrize(\"activation,alpha,beta,limit\", _ACT_CASES)"," @pytest.mark.parametrize(\"dtype\", [torch.bfloat16])"," @torch.inference_mode()","-def test_flashinfer_cutedsl_fp4_moe_relu2_no_mul(","+def test_flashinfer_cutedsl_fp4_moe(","     m: int,","     n: int,","     k: int,","     e: int,","     topk: int,","+    activation: MoEActivation,","+    alpha: float | None,","+    beta: float | None,","+    limit: float | None,","     dtype: torch.dtype,","     workspace_init,"," ):","@@ -102,7 +182,8 @@ def test_flashinfer_cutedsl_fp4_moe_relu2_no_mul(","     ):","         hidden_states = torch.randn((m, k), 