= Assert.Throws<InvalidOperationException>(() => infrastructure.Build())!;","+        Assert.That(exception.Message, Does.Contain(\"missing required property Parent\"));","+    }","+","+    [Test]","+    public void ParentCanBeReassignedAfterClearing()","+    {","+        FederatedIdentityCredential resource = new(\"credential\")","+        {","+            Parent = new UserAssignedIdentity(\"previous\")","+        };","+        resource.Parent = null;","+        UserAssignedIdentity identity = new(\"identity\");","+        resource.Parent = identity;","+","+        Assert.That(resource.Parent, Is.SameAs(identity));","+        IBicepValue parent = resource.ProvisionableProperties[nameof(FederatedIdentityCredential.Parent)];","+        Assert.That(parent.Kind, Is.EqualTo(BicepValueKind.Expression));","+        Assert.That(parent.Compile().ToString(), Is.EqualTo(\"identity\"));","+    }","+","+    [Test]","+    public void OrdinaryPropertyStillEmitsExplicitNull()","+    {","+        ManagementLock resource = new(\"resource\");","+        resource.Notes = (string)null!;","+","+        IBicepValue notes = resource.ProvisionableProperties[nameof(ManagementLock.Notes)];","+        Assert.That(notes.Kind, Is.Not.EqualTo(BicepValueKind.Unset));","+        Assert.That(notes.Compile().ToString(), Is.EqualTo(\"null\"));","+    }","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"sdk/provisioning/Azure.Provisioning/tests/SampleTests.cs","lines":["@@ -2,6 +2,7 @@"," // Licensed under the MIT License."," "," using System.Threading.Tasks;","+using Azure.Core;"," using Azure.Provisioning.AppContainers;"," using Azure.Provisioning.Authorization;"," using Azure.Provisioning.ContainerRegistry;","@@ -307,6 +308,194 @@ public async Task SimpleContainerApp()","             \"\"\");","     }"," ","+    [Test]","+    public async Task ManagementLockResourceScope()","+    {","+        await using Trycep test = new Trycep()","+            .Define(","+                ctx =>","+  