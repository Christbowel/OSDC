{"id":"52a65d7b19e9e3ad86bf1e3b6954e4e11eeec7da","axis":"silent","repo":"vllm-project/vllm","sha":"52a65d7b19e9e3ad86bf1e3b6954e4e11eeec7da","parsed":{"files":[{"path":"docs/models/supported_models.md","lines":["@@ -606,6 +606,7 @@ These models primarily accept the [`LLM.generate`](./generative_models.md#llmgen"," | `Moondream3ForCausalLM` | Moondream3 | T + I | `moondream/moondream3-preview` | | ✅︎ |"," | `MuseGlimmerForCausalLM`, `MuseGlimmerForConditionalGeneration` | Muse Glimmer | T + I<sup>+</sup> + V<sup>+</sup> | `meta-models/Muse-Glimmer-30B` | ✅︎ | ✅︎ |"," | `NemotronH_Nano_Omni_Reasoning_V3`, `NemotronH_Nano_VL_V2` | Nemotron Nano 3 Omni, Nemotron Nano V2 VL | T + I<sup>E+</sup> + V<sup>+</sup> + A<sup>*</sup> | `nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16` | ✅︎ | |","+| `RadioMBartPrefixForCausalLM` | Nemotron Parse 3.5 | T + I | `nvidia/Nemotron-3.5-Parse` | | |"," | `NVLM_D_Model` | NVLM-D 1.0 | T + I<sup>+</sup> | `nvidia/NVLM-D-72B`, etc. | | ✅︎ |"," | `OpenCUAForConditionalGeneration` | OpenCUA-7B | T + I<sup>E+</sup> | `xlangai/OpenCUA-7B` | ✅︎ | ✅︎ |"," | `OpenPanguVLForConditionalGeneration` | openpangu-VL | T + I<sup>E+</sup> + V<sup>E+</sup> | `FreedomIntelligence/openPangu-VL-7B` | ✅︎ | ✅︎ |"],"additions":1,"deletions":0,"truncated":false},{"path":"examples/generate/multimodal/vision_language_offline.py","lines":["@@ -29,7 +29,7 @@ class ModelRequestData(NamedTuple):","     prompts: list[str]","     stop_token_ids: list[int] | None = None","     lora_requests: list[LoRARequest] | None = None","-    sampling_params: list[SamplingParams] | None = None","+    sampling_params: SamplingParams | list[SamplingParams] | None = None"," "," "," # NOTE: The default `max_num_seqs` and `max_model_len` may result in OOM on","@@ -1392,6 +1392,38 @@ def run_molmo2(questions: list[str], modality: str) -> ModelRequestData:","     )"," "," ","+def run_nemotron_parse_35(questions: list[str], modality: str) -> ModelRequestData:","+    assert modality == \"image\"","+","+    engine_args = EngineArgs(","+        model=\"nvidia/Nemotron-3.5-Parse\",","+        dtype=\"bfloat16\",","+        max_model_len=16384,","+        max_num_seqs=1,","+        limit_mm_per_prompt={\"image\": 1},","+        trust_remote_code=True,","+    )","+","+    # Direct LLM.generate needs one <pad> per image; the Parse processor expands","+    # it into image tokens. The chat renderer inserts it, so omit it from chat text.","+    prompt = (","+        \"<pad></s><s><predict_bbox><predict_classes>\"","+        \"<output_markdown><predict_text_in_pic>\"","+    )","+    sampling_params = SamplingParams(","+        temperature=0,","+        top_k=1,","+        repetition_penalty=1.1,","+        max_tokens=8744,","+        skip_special_tokens=False,","+    )","+    return ModelRequestData(","+        engine_args=engine_args,","+        prompts=[prompt for _ in questions],","+        sampling_params=sampling_params,","+    )","+","+"," # Nemontron_VL"," def run_nemotron_vl(questions: list[str], modality: str) -> ModelRequestData:","     model_name = \"nvidia/Llama-3.1-Nemotron-Nano-VL-8B-V1\"","@@ -2219,6 +2251,7 @@ def run_step_vl(questions: list[str], modality: str) -> ModelRequestData:","     \"mistral3\": run_mistral3,","     \"molmo\": run_molmo,","     \"molmo2\": run_molmo2,","+    \"nemotron_parse_35\": run_nemotron_parse_35,","     \"nemotron_vl\": run_nemotron_vl,","     \"NVLM_D\": run_nvlm_d,","     \"openpangu_vl\": run_openpangu_vl,"],"additions":34,"deletions":1,"truncated":false},{"path":"tests/models/multimodal/generation/test_nemotron_parse.py","lines":["@@ -13,7 +13,6 @@"," "," from ....conftest import HfRunner, PromptImageInput, VllmRunner"," ","-IMAGE = ImageAsset(\"paper-11\").pil_image_ext(ext=\"png\").convert(\"RGB\")"," PROMPT = (","     \"</s><s><predict_bbox><predict_classes><output_markdown><predict_no_text_in_pic>\""," )","@@ -63,6 +62,8 @@ def run_test(","     with vllm_runner(","         model,","         dtype=dtype,","+        max_model_len=1024,","+        enable_chunked_prefill=False,","         max_num_seqs=64,","         limit_mm_per_prompt={\"image\": 1},","         trust_remote_code=True,","@@ -119,11 +120,12 @@ def run_test("," def test_models(","     hf_runner, vllm_runner, model: str, dtype: str, num_logprobs: int"," ) -> None:","+    image = ImageAsset(\"paper-11\").pil_image_ext(ext=\"png\").convert(\"RGB\")","     run_test(","         hf_runner,","         vllm_runner,","         inputs=[","-            ([PROMPT] * 10, [IMAGE] * 10),","+            ([PROMPT] * 10, [image] * 10),","         ],","         model=model,","         dtype=dtype,"],"additions":4,"deletions":2,"truncated":false},{"path":"tests/models/multimodal/generation/test_nemotron_parse_35.py","lines":["@@ -0,0 +1,102 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"HF generation parity for Nemotron Parse 3.5.\"\"\"","+","+import pytest","+from transformers import AutoModel","+","+from tests.models.registry import HF_EXAMPLE_MODELS","+from tests.models.utils import check_logprobs_close","+from vllm.assets.image import ImageAsset","+from vllm.logprobs import Logprob, SampleLogprobs","+","+from ....conftest import HfRunner, PromptImageInput, VllmRunner","+from .test_nemotron_parse import mask_bbox_tokens","+","+MODEL = \"nvidia/Nemotron-3.5-Parse\"","+PROMPT = (","+    \"</s><s><predict_bbox><predict_classes><output_markdown><predict_no_text_in_pic>\"","+)","+","+","+def generate_hf_logprobs_from_logits(","+    hf_model: HfRunner,","+    prompts: list[str],","+    images: PromptImageInput,","+    max_tokens: int,","+    num_logprobs: int,","+) -> list[tuple[list[int], str, SampleLogprobs]]:","+    \"\"\"Parse 3.5 exposes generation logits but not decoder hidden states.\"\"\"","+    inputs = hf_model.get_inputs(","+        prompts,","+        images=images,","+        tokenization_kwargs={\"add_special_tokens\": False},","+    )","+    outputs = []","+    for model_inputs in inputs:","+        generated = hf_model.model.generate(","+            **hf_model.wrap_device(model_inputs),","+            do_sample=False,","+            max_new_tokens=max_tokens,","+            output_logits=True,","+            return_dict_in_generate=True,","+        )","+        logprobs: SampleLogprobs = []","+        for logits in generated.logits:","+            values, indices = logits[0].float().log_softmax(dim=-1).topk(num_logprobs)","+            logprobs.append(","+                {","+                    int(token_id): Logprob(float(value))","+                    for token_id, value in zip(indices.tolist(), values.tolist())","+                }","+            )","+        token_ids = generated.sequences[0, -len(logprobs) :].tolist()","+        outputs.append((token_ids, hf_model.tokenizer.decode(token_ids), logprobs))","+    return outputs","+","+","+@pytest.mark.parametrize(\"dtype\", [\"bfloat16\"])","+@pytest.mark.parametrize(\"num_logprobs\", [5])","+def test_model(","+    hf_runner: type[HfRunner],","+    vllm_runner: type[VllmRunner],","+    dtype: str,","+    num_logprobs: int,","+) -> None:","+    model_info = HF_EXAMPLE_MODELS.get_hf_info(\"RadioMBartPrefixForCausalLM\")","+    model_info.check_available_online(on_fail=\"skip\")","+","+    image = ImageAsset(\"paper-11\").pil_image_ext(ext=\"png\").convert(\"RGB\")","+    prompts = [PROMPT] * 10","+    images = [image] * 10","+    max_tokens = 100","+","+    with vllm_runner(","+        MODEL,","+        dtype=dtype,","+        max_model_len=16384,","+        enable_chunked_prefill=True,","+        max_num_seqs=64,","+        limit_mm_per_prompt={\"image\": 1},","+        trust_remote_code=True,","+    ) as vllm_model:","+        # The native causal-prefix processor expands this image placeholder.","+        vllm_outputs = vllm_model.generate_greedy_logprobs(","+            [f\"<pad>{prompt}\" for prompt in prompts],","+            max_tokens,","+            num_logprobs=num_logprobs,","+            images=images,","+        )","+        tokenizer = vllm_model.llm.get_tokenizer()","+","+    with hf_runner(MODEL, dtype=dtype, auto_cls=AutoModel) as hf_model:","+        hf_outputs = generate_hf_logprobs_from_logits(","+            hf_model, prompts, images, max_tokens, num_logprobs","+        )","+","+    check_logprobs_close(","+        outputs_0_lst=[mask_bbox_tokens(output, tokenizer) for output in hf_outputs],","+        outputs_1_lst=[mask_bbox_tokens(output, tokenizer) for output in vllm_outputs],","+        name_0=\"hf\",","+        name_1=\"vllm\",","+    )"],"additions":102,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/generation/test_nemotron_parse_35_mtp.py","lines":["@@ -0,0 +1,137 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Contracts for the Parse 3.5 one-step auxiliary proposer.\"\"\"","+","+import weakref","+from pathlib import Path","+","+import pytest","+import torch","+from safetensors import safe_open","+from safetensors.torch import save_file","+from torch import nn","+from transformers import PreTrainedConfig","+","+from vllm.config.load import LoadConfig","+from vllm.config.speculative import SpeculativeConfig","+from vllm.model_executor.model_loader.default_loader import DefaultModelLoader","+from vllm.model_executor.models.nemotron_parse3_5 import MBartDecoderNoPos","+from vllm.model_executor.models.nemotron_parse3_5_mtp import (","+    ParseAuxMTPModel,","+    _ParseAuxMTPInner,","+)","+","+","+def test_parse_mtp_config_routes_only_causal_prefix_architecture() -> None:","+    config = PreTrainedConfig(","+        architectures=[\"RadioMBartPrefixForCausalLM\"],","+        decoder=PreTrainedConfig(causal_vision_prefix=True, vocab_size=8, d_model=4),","+    )","+","+    draft = SpeculativeConfig.hf_config_override(config)","+","+    assert draft.architectures == [\"ParseAuxMTPModel\"]","+    assert draft.model_type == \"mtp\"","+    assert draft.n_predict == draft.num_nextn_predict_layers == 1","+","+","+def test_parse_mtp_loads_auxiliary_weights_from_model_file(tmp_path: Path) -> None:","+    draft = ParseAuxMTPModel.__new__(ParseAuxMTPModel)","+    nn.Module.__init__(draft)","+    draft.model = _ParseAuxMTPInner(vocab_size=4, hidden_size=3)","+","+    weights = {","+        \"decoder.extra_heads.0.weight\": torch.arange(9).reshape(3, 3).float(),","+        \"decoder.extra_heads.0.bias\": torch.arange(3).float(),","+        \"decoder.extra_proj.0.weight\": torch.arange(9).reshape(3, 3).float(),","+        \"decoder.extra_proj.0.bias\": torch.arange(3).float(),","+        \"decoder.embed_tokens.weight\": torch.arange(12).reshape(4, 3).float(),","+        \"decoder.layers.0.fc1.weight\": torch.ones(3, 3),","+        \"encoder.conv1.weight\": torch.ones(3, 3, 1),","+    }","+    model_file = tmp_path / \"model.safetensors\"","+    save_file(weights, model_file)","+","+    with safe_open(model_file, framework=\"pt\", device=\"cpu\") as source:","+        tensor_names = source.keys()","+        loaded = draft.load_weights(","+            (name, source.get_tensor(name)) for name in tensor_names","+        )","+","+    assert loaded == {","+        \"model.embed_tokens.weight\",","+        \"model.extra_head.weight\",","+        \"model.extra_head.bias\",","+        \"model.extra_proj.weight\",","+        \"model.extra_proj.bias\",","+    }","+    for destination, source in (","+        (\"embed_tokens.weight\", \"decoder.embed_tokens.weight\"),","+        (\"extra_head.weight\", \"decoder.extra_heads.0.weight\"),","+        (\"extra_head.bias\", \"decoder.extra_heads.0.bias\"),","+        (\"extra_proj.weight\", \"decoder.extra_proj.0.weight\"),","+        (\"extra_proj.bias\", \"decoder.extra_proj.0.bias\"),","+    ):","+        assert torch.equal(draft.model.get_parameter(destination), weights[source])","+","+","+@pytest.mark.parametrize(","+    (\"missing_source\", \"missing_destination\"),","+    [","+        (\"decoder.extra_heads.0.weight\", \"model.extra_head.weight\"),","+        (\"decoder.embed_tokens.weight\", \"model.embed_tokens.weight\"),","+    ],","+)","+def test_parse_mtp_default_loader_detects_missing_weights(","+    missing_source: str, missing_destination: str","+) -> None:","+    draft = ParseAuxMTPModel.__new__(ParseAuxMTPModel)","+    nn.Module.__init__(draft)","+    draft.model = _ParseAuxMTPInner(vocab_size=4, hidden_size=3)","+    weights = {","+        \"decoder.embed_tokens.weight\": torch.zeros(4, 3),","+        \"decoder.extra_heads.0.weight\": torch.zeros(3, 3),","+        \"decoder.extra_heads.0.bias\": torch.zeros(3),","+        \"decoder.extra_proj.0.weight\": torch.zeros(3, 3),","+        \"decoder.extra_proj.0.bias\": torch.zeros(3),","+    }","+    del weights[missing_source]","+    loaded = draft.load_weights(weights.items())","+","+    loader = DefaultModelLoader(LoadConfig())","+    with pytest.raises(ValueError, match=\"not initialized from checkpoint\") as exc:","+        loader.track_weights_loading(draft, loaded)","+    assert missing_destination in str(exc.value)","+","+","+def test_parse_decoder_exposes_head_without_registering_duplicate_module() -> None:","+    decoder = MBartDecoderNoPos.__new__(MBartDecoderNoPos)","+    nn.Module.__init__(decoder)","+    decoder.embed_tokens = nn.Embedding(4, 3)","+    head = nn.Linear(3, 4)","+    decoder._lm_head_ref = weakref.ref(head)","+","+    assert decoder.model is decoder","+    assert decoder.lm_head is head","+    assert \"lm_head\" not in dict(decoder.named_modules())","+","+","+def test_parse_mtp_uses_replaced_scaled_embedding_in_auxiliary_prediction() -> None:","+    class ScaledEmbedding(nn.Embedding):","+        def forward(self, input_ids: torch.Tensor) -> torch.Tensor:","+            return super().forward(input_ids) * 2","+","+    model = _ParseAuxMTPInner(vocab_size=4, hidden_size=3)","+    shared_embedding = ScaledEmbedding(4, 3)","+    model.embed_tokens = shared_embedding","+    with torch.no_grad():","+        shared_embedding.weight.fill_(1)","+        model.extra_proj.weight.copy_(3 * torch.eye(3))","+        model.extra_proj.bias.fill_(1)","+        model.extra_head.weight.copy_(5 * torch.eye(3))","+        model.extra_head.bias.fill_(7)","+","+    actual = model(torch.tensor([1]), torch.tensor([[1.0, 2.0, 3.0]]))","+","+    # The trained formula is head(hidden + proj(scaled_embedding(token))).","+    torch.testing.assert_close(actual, torch.tensor([[47.0, 52.0, 57.0]]))"],"additions":137,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_nemotron_parse_35.py","lines":["@@ -0,0 +1,101 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Processing tests for Nemotron Parse 3.5.\"\"\"","+","+from types import SimpleNamespace","+","+import numpy as np","+import pytest","+import torch","+from PIL import Image","+from transformers import BatchFeature","+","+from vllm.model_executor.models.nemotron_parse3_5 import (","+    NemotronParseProcessingInfo,","+    RadioMBartPrefixMultiModalProcessor,","+)","+from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.processing import BaseProcessingInfo","+","+from ...utils import build_model_context","+","+","+def _noise_image(width: int, height: int) -> Image.Image:","+    rng = np.random.default_rng(0)","+    return Image.fromarray(rng.integers(0, 256, (height, width, 3), dtype=np.uint8))","+","+","+@pytest.mark.usefixtures(\"default_vllm_config\")","+@pytest.mark.parametrize(\"mm_device_do_normalize\", [None, True])","+def test_causal_prefix_preserves_host_normalized_packed_images(","+    mm_device_do_normalize: bool | None,","+):","+    \"\"\"Packed Parse 3.5 inputs must not inherit legacy device normalization.\"\"\"","+    ctx = build_model_context(","+        \"nvidia/Nemotron-3.5-Parse\",","+        limit_mm_per_prompt={\"image\": 1},","+        model_config_kwargs={\"mm_device_do_normalize\": mm_device_do_normalize},","+    )","+    assert not ctx.model_config.multimodal_config.mm_device_do_normalize","+    processor = MULTIMODAL_REGISTRY.create_processor(ctx.model_config)","+    image = _noise_image(310, 470)","+    expected = processor.info.get_hf_processor().image_processor(","+        [image], return_tensors=\"pt\"","+    )","+    mm_items = processor.info.parse_mm_data({\"image\": [image]})","+    actual = processor([1], mm_items=mm_items)[\"mm_kwargs\"].get_data()","+","+    assert actual[\"pixel_values\"].is_floating_point()","+    assert actual[\"pixel_values\"].shape[-1] == 3 * 16**2","+    for name in (\"pixel_values\", \"image_sizes\", \"content_sizes\"):","+        torch.testing.assert_close(","+            actual[name], expected[name].to(actual[name].dtype), rtol=0, atol=0","+        )","+","+","+@pytest.mark.parametrize(","+    (\"setting\", \"value\"),","+    [","+        (\"navit_packing\", False),","+        (\"navit_coordinate_frame\", \"canvas\"),","+        (\"navit_padding_mode\", \"center\"),","+        (\"do_normalize\", False),","+    ],","+)","+def test_causal_prefix_rejects_incompatible_processor_settings(","+    monkeypatch: pytest.MonkeyPatch, setting: str, value: object","+) -> None:","+    image_processor = SimpleNamespace(","+        navit_packing=True,","+        navit_coordinate_frame=\"content_normalized\",","+        navit_padding_mode=\"top_left_white\",","+        do_normalize=True,","+    )","+    setattr(image_processor, setting, value)","+    monkeypatch.setattr(","+        BaseProcessingInfo,","+        \"get_hf_processor\",","+        lambda self, **kwargs: SimpleNamespace(image_processor=image_processor),","+    )","+    info = NemotronParseProcessingInfo.__new__(NemotronParseProcessingInfo)","+    monkeypatch.setattr(","+        info,","+        \"get_hf_config\",","+        lambda: SimpleNamespace(navit_packing=True),","+    )","+","+    with pytest.raises(ValueError, match=f\"requires {setting}=\"):","+        info.get_hf_processor()","+","+","+def test_causal_prefix_fields_config_handles_empty_cached_hf_inputs() -> None:","+    processor = RadioMBartPrefixMultiModalProcessor.__new__(","+        RadioMBartPrefixMultiModalProcessor","+    )","+    processor.info = SimpleNamespace(","+        get_hf_config=lambda: SimpleNamespace(encoder=SimpleNamespace(patch_size=16))","+    )","+","+    fields = processor._get_mm_fields_config(BatchFeature(), {})","+","+    assert fields[\"pixel_values\"].field.slices == []"],"additions":101,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -1369,6 +1369,10 @@ def check_available_online(","         max_model_len=4096,","         hf_overrides={\"architectures\": [\"Qwen3ASRForcedAlignerForTokenClassification\"]},","     ),","+    \"RadioMBartPrefixForCausalLM\": _HfExamplesInfo(","+        \"nvidia/Nemotron-3.5-Parse\",","+        trust_remote_code=True,","+    ),","     \"RForConditionalGeneration\": _HfExamplesInfo(\"YannQi/R-4B\", trust_remote_code=True),","     \"SkyworkR1VChatModel\": _HfExamplesInfo(","         \"Skywork/Skywork-R1V-38B\",","@@ -1809,6 +1813,12 @@ def check_available_online(","         trust_remote_code=True,","         is_available_online=False,","     ),","+    \"ParseAuxMTPModel\": _HfExamplesInfo(","+        \"nvidia/Nemotron-3.5-Parse\",","+        speculative_model=\"nvidia/Nemotron-3.5-Parse\",","+        speculative_method=\"mtp\",","+        trust_remote_code=True,","+    ),","     \"Qwen3NextMTP\": _HfExamplesInfo(\"Qwen/Qwen3-Next-80B-A3B-Instruct\"),","     \"Qwen3_5MTP\": _HfExamplesInfo(","         \"Qwen/Qwen3.5-0.8B\","],"additions":10,"deletions":0,"truncated":false},{"path":"vllm/config/speculative.py","lines":["@@ -677,6 +677,18 @@ def compute_hash(self) -> str:","     @staticmethod","     def hf_config_override(hf_config: PreTrainedConfig) -> PreTrainedConfig:","         initial_