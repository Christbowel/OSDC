lows clients to confirm their identity with Vault as an identity provider</strong>.","+  </:description>","+  <:features>","+    <Wizard::IntroContent::Feature @icon=\"service\">","+      Using Vault as an OIDC provider allows external applications to receive verifiable identity authentication.","+      Applications then use this information to make their own access decisions.","+    </Wizard::IntroContent::Feature>","+    <Wizard::IntroContent::Feature @icon=\"database\">","+      Vault as an OIDC provider is","+      <strong>cluster-wide within a Vault instance</strong>, not namespace-limited by default.","+    </Wizard::IntroContent::Feature>","+    <Wizard::IntroContent::Feature @icon=\"org\">","+      A cluster first","+      <strong>must define OIDC scopes to configure OIDC provider</strong>. Scopes should be minimal and client-specific, and","+      must be defined in the CLI/API.","+    </Wizard::IntroContent::Feature>","+  </:features>","+</Wizard::IntroContent>","\\ No newline at end of file"],"additions":31,"deletions":0,"truncated":false},{"path":"ui/app/components/wizard/oidc-provider/oidc-provider-wizard.hbs","lines":["@@ -0,0 +1,35 @@","+{{!","+  Copyright IBM Corp. 2016, 2026","+  SPDX-License-Identifier: BUSL-1.1","+}}","+","+<Wizard @wizardId={{this.wizardId}} @isModal={{@isIntroModal}} @title=\"OIDC Provider\" @onDismiss={{this.onDismiss}}>","+  <:intro>","+    <Wizard::OidcProvider::Intro />","+  </:intro>","+  <:introActions>","+    <Hds::ButtonSet>","+      <Hds::Button","+        @icon=\"plus\"","+        @text=\"Configure OIDC Provider\"","+        @route=\"vault.cluster.access.oidc.clients.create\"","+        {{on \"click\" (fn this.trackClickEvent \"Configure OIDC Provider\")}}","+        data-test-button=\"Configure OIDC Provider\"","+      />","+      <Hds::Button","+        @color=\"secondary\"","+        @text={{if @isIntroModal \"Close\" \"Skip\"}}","+        {{on \"click\" this.onDismiss}}","+        data-test-button={{if @isIntroModa