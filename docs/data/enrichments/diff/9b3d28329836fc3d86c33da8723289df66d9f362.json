       PyArray_Descr *descr = castdata->main.descriptors[1];","+        if (PyArray_ClearBuffer(descr, castdata->to_buffer,","+                descr->elsize, block_size, 1) < 0) {","+            PyErr_WriteUnraisable(NULL);","+        }","+    }","+    PyErr_SetRaisedException(exc);","+    NPY_DISABLE_C_API;","+    return -1;"," }"," "," "],"additions":30,"deletions":5,"truncated":false},{"path":"numpy/_core/tests/test_multiarray.py","lines":["@@ -19,7 +19,7 @@"," import textwrap"," import warnings"," import weakref","-from contextlib import ExitStack, contextmanager","+from contextlib import contextmanager"," "," # Need to test an object that does not fully implement math interface"," from datetime import datetime, timedelta","@@ -64,6 +64,7 @@","     longdouble_fpe_mark,","     requires_deep_recursion,","     requires_memory,","+    trace_memory_growth,"," )"," "," ","@@ -1083,18 +1084,10 @@ def test_malloc_fails(self):"," ","     @pytest.mark.thread_unsafe(reason=\"tracemalloc is not thread-safe\")","     def test_tracemalloc(self):","-        tracemalloc = pytest.importorskip(\"tracemalloc\")","-        with ExitStack() as ctx:","-            if not tracemalloc.is_tracing():","-                tracemalloc.start()","-                ctx.callback(tracemalloc.stop)","-            pre_snapshot = tracemalloc.take_snapshot()","+        with trace_memory_growth() as growth:","             arr = np.zeros(1000000, dtype=\"uint8\")","-            post_snapshot = tracemalloc.take_snapshot()","-            diff = post_snapshot.compare_to(pre_snapshot, \"filename\")","-        allocated_bytes = sum(d.size_diff for d in diff)","         # Allow for some non-data allocations","-        assert_allclose(allocated_bytes, arr.nbytes, 1000)","+        assert_allclose(growth(), arr.nbytes, atol=1000)"," ","     def test_zeros(self):","         types = np.typecodes['AllInteger'] + np.typecodes['AllFloat']"],"additions":4,"deletions":11,"truncated":false},{"path":"numpy/_core/tests/test_stringdtype.py","lines":["@@ -15,7 +15,10 @@"," from numpy.dtypes import StringDType"," from numpy.exceptions import ComplexWarning"," from numpy.testing import IS_PYPY, assert_array_equal","-from numpy.testing._private.utils import run_with_memory_limit","+from numpy.testing._private.utils import (","+    assert_memory_growth_below,","+    run_with_memory_limit,","+)"," "," "," def random_unicode_string_list():","@@ -983,6 +986,39 @@ def test_invalid_numeric_casts_error(dtype, invalid):","         arr.astype(dtype)"," "," ","+@pytest.mark.thread_unsafe(reason=\"tracemalloc is not thread-safe\")","+def test_failed_cast_to_unaligned_releases_buffer():","+    # the unaligned destination makes the cast copy the strings into a","+    # temporary buffer that it has to free. The bad reading also runs the","+    # cleanup for a failed cast.","+    def fill():","+        readings = np.array([f\"{i / 7:.20f}\" for i in range(300)], dtype=\"T\")","+        readings[-1] = \"sensor offline\"","+        table = np.zeros(300, dtype=[(\"valid\", \"?\"), (\"reading\", \"f8\")])","+        assert not table[\"reading\"].flags.aligned","+        with pytest.raises(ValueError):","+            table[\"reading\"] = readings","+","+    assert_memory_growth_below(fill, limit=1024)","+","+","+@pytest.mark.thread_unsafe(reason=\"tracemalloc is not thread-safe\")","+def test_ufunc_fixed_width_out_releases_buffer():","+    # the ufunc computes its StringDType results into a temporary buffer and","+    # then casts them to the output array. The strings in the buffer leak","+    # unless that cast frees them.","+    def add():","+        n = 2 * np.getbufsize()","+        first = np.array([f\"first name {i}\" for i in range(n)], dtype=\"T\")","+        last = np.array([f\"a longer last name, number {i}\" for i in range(n)],","+                        dtype=\"T\")","+        full = np.empty(n, dtype=\"U60\")","+        np.strings.add(first, last, out=full)","+        assert full[-1] == first[-1] + last[-1]","+","+    assert_memory_growth_below(add, limit=1024)","+","+"," def test_insert_scalar(dtype, string_list):","     \"\"\"Test that inserting a scalar works.\"\"\"","     arr = np.array(string_list, dtype=dtype)"],"additions":37,"deletions":1,"truncated":false},{"path":"numpy/testing/_private/utils.py","lines":["@@ -3032,3 +3032,51 @@ def _run_with_memory_limit(func_location, make_args_location, limit):","         raise SystemExit(","             \"Memory-limit checks failed (see child diagnostics above):\\n\"","             + \"\\n\".join(f\"  {failure}\" for failure in failed))","+","+","+@contextlib.contextmanager","+def trace_memory_growth():","+    \"\"\"Context manager that measures memory growth with `tracemalloc`.","+","+    Yields a function that returns the number of bytes that were allocated","+    since entering the block and are still allocated.  After the block","+    exits it returns the growth at exit.  `tracemalloc` is not thread-safe,","+    so tests that use this need the ``thread_unsafe`` marker.","+    \"\"\"","+    import pytest","+","+    # not available on PyPy","+    tracemalloc = pytest.importorskip(\"tracemalloc\")","+    started = not tracemalloc.is_tracing()","+    if started:","+        tracemalloc.start()","+    before = tracemalloc.get_traced_memory()[0]","+    final = None","+","+    def growth():","+        if final is not None:","+            return final","+        return tracemalloc.get_traced_memory()[0] - before","+","+    try:","+        yield growth","+    finally:","+        final = growth()","+        if started:","+            tracemalloc.stop()","+","+","+def assert_memory_growth_below(func, limit, repeat=10):","+    \"\"\"Fail if more than ``limit`` bytes are still allocated after calling","+    ``func()`` ``repeat`` times.","+","+    ``func`` is called once before the measurement starts.  This uses","+    `tracemalloc` and is not thread-safe.","+    \"\"\"","+    func()","+    with trace_memory_growth() as growth:","+        for _ in range(repeat):","+            func()","+    assert growth() < limit, (","+        f\"memory grew by {growth()} bytes after {repeat} calls, \"","+        f\"limit is {limit}\")"],"additions":48,"deletions":0,"truncated":false},{"path":"numpy/testing/_private/utils.pyi","lines":["@@ -539,6 +539,10 @@ def run_with_memory_limit(","     limit: int,"," ) -> None: ..."," ","+#","+def trace_memory_growth() -> _GeneratorContextManager[Callable[[], int]]: ...","+def assert_memory_growth_below(func: Callable[[], Unused], limit: int, repeat: int = 10) -> None: ...","+"," #"," def runstring(astr: _StrLike | types.CodeType, dict: dict[str, Any] | None) -> Any: ..."," def rundocs(filename: StrPath | None = None, raise_on_error: bool = True) -> None: ...",""],"additions":4,"deletions":0,"truncated":false}],"additions":234,"deletions":23,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-19T17:58:58.452601+00:00"}