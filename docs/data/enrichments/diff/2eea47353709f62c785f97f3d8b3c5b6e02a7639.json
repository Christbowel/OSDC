sRecordedFn =","+        std::function<Status(OperationContext*, const MultikeyPaths&)>;","+","     /**","      * By default, attempts to generate keys for each skipped record and insert into the index.","      * Returns OK if all records were either indexed or no longer exist.","@@ -67,6 +75,7 @@ class SkippedRecordTracker {","         OperationContext* opCtx,","         const CollectionPtr& collection,","         const IndexCatalogEntry* indexCatalogEntry,","+        const OnMultikeyPathsRecordedFn& onMultikeyPathsRecorded,","         RetrySkippedRecordMode mode = RetrySkippedRecordMode::kKeyGenerationAndInsertion);"," ","     boost::optional<MultikeyPaths> getMultikeyPaths() const {",""],"additions":9,"deletions":0,"truncated":false}],"additions":171,"deletions":26,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-09-29T14:23:35.693464+00:00"}