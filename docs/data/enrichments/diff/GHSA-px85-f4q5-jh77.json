age, res: ServerResponse): boolean => {","+    const mediaType = req.headers['content-type']?.split(';')[0].trim().toLowerCase();","+    if (mediaType === 'application/json') {","+      return false;","+    }","+","+    res.writeHead(415, { 'Content-Type': 'text/plain' });","+    res.end('Unsupported Media Type: Content-Type must be application/json');","+    return true;","+  };","+","   const { refs, compositionAuth, sources, multiSource } = await resolveCompositionSources(options);"," ","   // Composition (multi-source) is the only remaining consumer of the manifest-provider plumbing:","@@ -102,7 +156,9 @@ export const experimental_devServer: PresetPropertyFn<","   };"," ","   app!.post(endpoint, (req, res) => {","+    if (rejectDisallowedOrigin(req, res)) return;","     if (requireAuth(req, res)) return;","+    if (rejectNonJsonBody(req, res)) return;"," ","     return mcpServerHandler({","       req,","@@ -135,6 +191,7 @@ export const experimental_devServer: PresetPropertyFn<","   const isTestEnabled = testSupported && (addonOptions.toolsets?.test ?? true);"," ","   app!.get(endpoint, (req, res) => {","+    if (rejectDisallowedOrigin(req, res)) return;","     if (!req.headers['accept']?.includes('text/html')) {","       if (requireAuth(req, res)) return;"," "],"additions":57,"deletions":0,"truncated":false},{"path":"code/addons/vitest/src/vitest-plugin/index.ts","lines":["@@ -171,6 +171,24 @@ const createComponentTestTransformPlugin = (presets: Presets, configDir: string)","   };"," };"," ","+interface ApiPermissions {","+  allowWrite?: boolean;","+  allowExec?: boolean;","+}","+","+const toApiPermissions = (api: unknown): ApiPermissions =>","+  api && typeof api === 'object' ? (api as ApiPermissions) : {};","+","+// Users on Vitest 4 may have set the permissions on `browser.api`, which Vitest 5 no longer types.","+const getUserApiPermissions = (testConfig: ViteUserConfig['test']): ApiPermissions => {","+  const api = toApiPermissions(testConfig?.api);","+  con