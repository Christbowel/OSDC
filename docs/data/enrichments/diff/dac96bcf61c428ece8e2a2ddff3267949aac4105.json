{"id":"dac96bcf61c428ece8e2a2ddff3267949aac4105","axis":"silent","repo":"apache/airflow","sha":"dac96bcf61c428ece8e2a2ddff3267949aac4105","parsed":{"files":[{"path":"airflow-core/docs/administration-and-deployment/listeners.rst","lines":["@@ -121,6 +121,19 @@ Dag Import Error Events"," "," Dag import error events occur when Dag processor finds an import error in the Dag code and updates the metadata database table."," ","+``filename`` is the absolute path of the file on the Dag processor. When the Dag processor publishes its","+results through the Execution API, these events fire on the API server, which does not have the processor's","+bundles, so ``filename`` is the path relative to the bundle root instead. Both hooks also receive","+``bundle_name`` and ``relative_fileloc`` to identify the source consistently in either mode. Existing","+listeners that accept only ``filename`` and ``stacktrace`` continue to work; new listeners can accept","+the bundle identity arguments without relying on the form of ``filename``.","+","+``bundle_name`` and ``relative_fileloc`` were added in Airflow 3.5.0. Earlier versions raise","+``PluginValidationError`` while loading a listener whose hook accepts them, and then load no plugin","+listeners at all. Giving them default values does not help: pluggy never passes an argument that has","+a default, so the listener would never receive them. A listener that must also load on earlier versions","+should accept only ``filename`` and ``stacktrace``.","+"," "," |experimental|"," "],"additions":13,"deletions":0,"truncated":false},{"path":"airflow-core/docs/migrations-ref.rst","lines":["@@ -39,7 +39,9 @@ Here's the list of all the Database Migrations that are executed via when you ru"," +-------------------------+------------------+-------------------+--------------------------------------------------------------+"," | Revision ID             | Revises ID       | Airflow Version   | Description                                                  |"," +=========================+==================+===================+==============================================================+","-| ``a8b48633fa60`` (head) | ``16d7301f124b`` | ``3.5.0``         | Add idempotency_key to hitl_detail.                          |","+| ``687eb253de24`` (head) | ``a8b48633fa60`` | ``3.5.0``         | Add Dag processor publication receipts and source revisions. |","++-------------------------+------------------+-------------------+--------------------------------------------------------------+","+| ``a8b48633fa60``        | ``16d7301f124b`` | ``3.5.0``         | Add idempotency_key to hitl_detail.                          |"," +-------------------------+------------------+-------------------+--------------------------------------------------------------+"," | ``16d7301f124b``        | ``5fbfa42a2d01`` | ``3.5.0``         | Add index on callback trigger ID.                            |"," +-------------------------+------------------+-------------------+--------------------------------------------------------------+"],"additions":3,"deletions":1,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/datamodels/dag_parsing.py","lines":["@@ -0,0 +1,171 @@","+# Licensed to the Apache Software Foundation (ASF) under one","+# or more contributor license agreements.  See the NOTICE file","+# distributed with this work for additional information","+# regarding copyright ownership.  The ASF licenses this file","+# to you under the Apache License, Version 2.0 (the","+# \"License\"); you may not use this file except in compliance","+# with the License.  You may obtain a copy of the License at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+","+from __future__ import annotations","+","+from datetime import datetime","+from typing import Annotated, Any","+from uuid import UUID","+","+from pydantic import Field, model_validator","+","+from airflow.api_fastapi.core_api.base import StrictBaseModel","+from airflow.api_fastapi.execution_api.datamodels.job import FILELOC_MAX_LENGTH, DagParseTokenBody","+from airflow.models.dag import TAG_MAX_LEN","+from airflow.models.dagwarning import DagWarningTypeValue","+from airflow.models.errors import IMPORT_ERROR_FILENAME_MAX_LENGTH","+from airflow.utils.helpers import validate_key","+","+MAX_PUBLICATION_BYTES = 16 * 1024 * 1024","+\"\"\"Largest request body the Dag parsing endpoints read, measured as the bytes sent.\"\"\"","+","+","+class ParseWarning(StrictBaseModel):","+    \"\"\"A warning attached to a Dag returned by this import.\"\"\"","+","+    dag_id: str = Field(min_length=1, max_length=250)","+    warning_type: DagWarningTypeValue","+    message: str","+","+","+class ParseSourceCode(StrictBaseModel):","+    \"\"\"Source captured by the importer; null explicitly means unavailable.\"\"\"","+","+    source_code: str | None","+    language: str = Field(min_length=1, max_length=64)","+","+","+class DagParseResultBody(DagParseTokenBody):","+    \"\"\"One completed file or container import, including an empty result.\"\"\"","+","+    dispatch_sequence: int = Field(ge=1, le=2**53 - 1)","+    bundle_revision: UUID | None = None","+    bundle_version: str | None = Field(default=None, max_length=200)","+    version_data: dict[str, Any] | None = None","+    parse_duration: float = Field(ge=0, allow_inf_nan=False)","+    serialized_dags: list[dict[str, Any]]","+    import_errors: dict[str, str] = Field(default_factory=dict)","+    warnings: list[ParseWarning] = Field(default_factory=list)","+    parsed_definitions: list[str] = Field(default_factory=list)","+    result_unavailable: bool = Field(","+        default=False,","+        description=(","+            \"The processor has no result for the file: its parse did not finish, or the API server \"","+            \"refused the result. The import error says why, and the file's Dags go stale only once \"","+            \"they outlast stale_dag_threshold.\"","+        ),","+    )","+    source_codes: list[ParseSourceCode] = Field(","+        description=\"Source text and language pairs, deduplicated by the processor.\"","+    )","+    dag_source_indexes: dict[str, Annotated[int, Field(strict=True, ge=0)]] = Field(","+        description=\"Index in source_codes for each serialized Dag, including unavailable source.\"","+    )","+","+    @model_validator(mode=\"after\")","+    def validate_file_scope(self) -> DagParseResultBody:","+        paths = [*self.parsed_definitions, *self.import_errors]","+        dag_ids: set[str] = set()","+        for document in self.serialized_dags:","+            dag = document.get(\"dag\")","+            if not isinstance(dag, dict) or not isinstance(dag.get(\"dag_id\"), str):","+                raise ValueError(\"A serialized Dag must contain a dag_id\")","+            # The processor runs Dag code that can bypass the SDK's checks; these columns are bounded.","+            validate_key(dag[\"dag_id\"])","+            tags = dag.get(\"tags\") or []","+            if not isinstance(tags, list) or any(","+                not isinstance(tag, str) or len(tag) > TAG_MAX_LEN for tag in tags","+            ):","+                raise ValueError(f\"Dag tags must be strings of at most {TAG_MAX_LEN} characters\")","+            if dag[\"dag_id\"] in dag_ids:","+                raise ValueError(\"Duplicate Dag id in publication\")","+            dag_ids.add(dag[\"dag_id\"])","+            relative_fileloc = dag.get(\"relative_fileloc\")","+            if not isinstance(relative_fileloc, str):","+                raise ValueError(\"Every definition must have a bundle-relative location\")","+            paths.append(relative_fileloc)","+            fileloc = dag.get(\"fileloc\")","+            if not isinstance(fileloc, str) or len(fileloc) > FILELOC_MAX_LENGTH:","+                raise ValueError(","+                    f\"A serialized Dag must contain a fileloc of at most {FILELOC_MAX_LENGTH} characters\"","+                )","+        for path in paths:","+            if len(path) > FILELOC_MAX_LENGTH:","+                raise ValueError(f\"Definition location exceeds {FILELOC_MAX_LENGTH} characters\")","+            self.validate_relative_fileloc(path)","+            if path != self.relative_fileloc and not path.startswith(self.relative_fileloc + \"/\"):","+                raise ValueError(\"Definition or diagnostic is outside the published file or container\")","+        if any(len(path) > IMPORT_ERROR_FILENAME_MAX_LENGTH for path in self.import_errors):","+            raise ValueError(f\"Import-error location exceeds {IMPORT_ERROR_FILENAME_MAX_LENGTH} characters\")","+        if self.result_unavailable and (","+            self.serialized_dags or self.relative_fileloc not in self.import_errors","+        ):","+            raise ValueError(","+                \"A publication without a result must have no Dags and an import error for its file\"","+            )","+        if set(self.dag_source_indexes) != dag_ids:","+            raise ValueError(\"Supply a source index for every serialized Dag\")","+        if set(self.dag_source_indexes.values()) != set(range(len(self.source_codes))):","+            raise ValueError(\"Source indexes must refer to every supplied source and no others\")","+        if any(warning.dag_id not in dag_ids for warning in self.warnings):","+            raise ValueError(\"Warnings must refer to Dags in this publication\")","+        return self","+","+","+class DagParseResultResponse(StrictBaseModel):","+    \"\"\"Receipt returned unchanged when the latest accepted publication is replayed.\"\"\"","+","+    attempt_id: UUID","+    accepted_at: datetime","+","+","+class DagBundleStateResponse(StrictBaseModel):","+    \"\"\"Server-owned metadata for an authorized bundle.\"\"\"","+","+    name: str","+    version: str | None","+    last_refreshed: datetime | None","+    revision: UUID | None","+    team_name: str | None","+","+","+class DagBundleInventoryBody(StrictBaseModel):","+    \"\"\"A discovery snapshot with explicit failures, conditional on the previously observed revision.\"\"\"","+","+    attempt_id: UUID","+    dispatch_sequence: int = Field(ge=1, le=2**53 - 1)","+    expected_revision: UUID | None","+    version: str | None = Field(default=None, max_length=200)","+    files: list[str] = Field(max_length=100000)","+    failed_sources: list[str] = Field(default_factory=list, max_length=100000)","+","+    @model_validator(mode=\"after\")","+    def validate_files(self) -> DagBundleInventoryBody:","+        for paths in (self.files, self.failed_sources):","+            for path in paths:","+                if len(path) > FILELOC_MAX_LENGTH:","+                    raise ValueError(f\"Definition location exceeds {FILELOC_MAX_LENGTH} characters\")","+                DagParseTokenBody.validate_relative_fileloc(path)","+            if len(set(paths)) != len(paths):","+                raise ValueError(\"Inventory contains duplicate definitions\")","+        return self","+","+","+class DagBundleInventoryResponse(DagParseResultResponse):","+    \"\"\"The source revision to attach to imports dispatched from this inventory.\"\"\"","+","+    revision: UUID"],"additions":171,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/datamodels/job.py","lines":["@@ -25,6 +25,8 @@"," from airflow.api_fastapi.core_api.base import StrictBaseModel"," from airflow.jobs.job import JobState"," ","+FILELOC_MAX_LENGTH = 2000","+"," "," class TerminalJobState(str, Enum):","     \"\"\"States a Job can finish in.\"\"\"","@@ -77,7 +79,7 @@ class DagParseTokenBody(StrictBaseModel):"," ","     attempt_id: UUID","     bundle_name: str = Field(min_length=1, max_length=250)","-    relative_fileloc: str = Field(min_length=1, max_length=2000)","+    relative_fileloc: str = Field(min_length=1, max_length=FILELOC_MAX_LENGTH)"," ","     @field_validator(\"relative_fileloc\")","     @classmethod"],"additions":3,"deletions":1,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/routes/__init__.py","lines":["@@ -26,6 +26,7 @@","     callbacks,","     connection_tests,","     connections,","+    dag_parsing,","     dag_runs,","     dags,","     health,","@@ -66,6 +67,7 @@"," authenticated_router.include_router(xcoms.router, prefix=\"/xcoms\", tags=[\"XComs\"])"," authenticated_router.include_router(hitl.router, prefix=\"/hitlDetails\", tags=[\"Human in the Loop\"])"," authenticated_router.include_router(jobs.router, tags=[\"Jobs\"])","+authenticated_router.include_router(dag_parsing.router, prefix=\"/jobs\", tags=[\"Dag Parsing\"])"," authenticated_router.include_router(task_state_store.router, prefix=\"/store/ti\", tags=[\"Task State Store\"])"," authenticated_router.include_router(","     asset_state_store.router, prefix=\"/store/asset\", tags=[\"Asset State Store\"]"],"additions":2,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/routes/dag_parsing.py","lines":["@@ -0,0 +1,433 @@","+# Licensed to the Apache Software Foundation (ASF) under one","+# or more contributor license agreements.  See the NOTICE file","+# distributed with this work for additional information","+# regarding copyright ownership.  The ASF licenses this file","+# to you under the Apache License, Version 2.0 (the","+# \"License\"); you may not use this file except in compliance","+# with the License.  You may obtain a copy of the License at","+#","+#   http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing,","+# software distributed under the License is distributed on an","+# \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+# KIND, either express or implied.  See the License for the","+# specific language governing permissions and limitations","+# under the License.","+","+from __future__ import annotations","+","+import hashlib","+import json","+from datetime import timedelta","+from typing import TYPE_CHECKING, Any","+","+from cadwyn import VersionedAPIRouter","+from fastapi import HTTPException, Request, Security, status","+from sqlalchemy import delete, or_, select","+from sqlalchemy.orm import selectinload","+from starlette.requests import ClientDisconnect","+from uuid6 import uuid7","+","+from airflow._shared.timezones import timezone","+from airflow.api_fastapi.common.db.common import SessionDep","+from airflow.api_fastapi.core_api.openapi.exceptions import create_openapi_http_exception_doc","+from airflow.api_fastapi.execution_api.datamodels.dag_parsing import (","+    MAX_PUBLICATION_BYTES,","+    DagBundleInventoryBody,","+    DagBundleInventoryResponse,","+    DagBundleStateResponse,","+    DagParseResultBody,","+    DagParseResultResponse,","+)","+from airflow.api_fastapi.execution_api.datamodels.token import DagProcessorToken","+from airflow.api_fastapi.execution_api.security import (","+    CurrentDagProcessorToken,","+    ExecutionAPIRoute,","+    require_auth,","+)","+from airflow.configuration import conf","+from airflow.dag_processing.collection import (","+    DagBundleOwnershipError,","+    DagPublicationValidationError,","+    _reject_other_teams_plugin_classes,","+    is_source_discovery_failed,","+    reject_unpublishable_dags,","+    update_dag_parsing_results_in_db,","+    validate_dag_bundle_ownership,","+)","+from airflow.jobs.job import Job","+from airflow.models.asset import remove_references_to_deleted_dags","+from airflow.models.dag import DagModel","+from airflow.models.dag_processor_publication_receipt import DagProcessorPublicationReceipt","+from airflow.models.dagbundle import DagBundleModel","+from airflow.models.dagwarning import DagWarning","+from airflow.models.errors import ParseImportError","+from airflow.sdk.importers.base import DagSourceCode  # noqa: SDK001","+from airflow.serialization.serialized_objects import LazyDeserializedDAG","+","+if TYPE_CHECKING:","+    from collections.abc import Callable, Coroutine","+","+    from pydantic import BaseModel","+    from sqlalchemy.orm import Session","+    from starlette.responses import Response","+    from starlette.types import Message","+","+","+class DagParsingRoute(ExecutionAPIRoute):","+    \"\"\"Refuse request bodies over the publication limit before they are read into memory.\"\"\"","+","+    def get_route_handler(self) -> Callable[[Request], Coroutine[Any, Any, Response]]:","+        handler = super().get_route_handler()","+","+        async def handle_bounded_request(request: Request) -> Response:","+            too_large = HTTPException(","+                status.HTTP_413_CONTENT_TOO_LARGE,","+                detail=f\"Request body exceeds {MAX_PUBLICATION_BYTES // (1024 * 1024)} MiB\",","+            )","+            declared = request.headers.get(\"content-length\", \"\")","+            if declared.isdigit() and int(declared) > MAX_PUBLICATION_BYTES:","+                raise too_large","+            body = bytearray()","+            try:","+                async for chunk in request.stream():","+                    body += chunk","+                    if len(body) > MAX_PUBLICATION_BYTES:","+                        raise too_large","+            except ClientDisconnect as error:","+                # FastAPI reports a body it could not read as a bad request rather than a server error.","+                raise HTTPException(","+                    status.HTTP_400_BAD_REQUEST, detail=\"The client disconnected while sending the body\"","+                ) from error","+            replayed = False","+","+            async def receive() -> Message:","+                nonlocal replayed","+                if replayed:","+                    return await request.receive()","+                replayed = True","+                return {\"type\": \"http.request\", \"body\": bytes(body), \"more_body\": False}","+","+            return await handler(Request(request.scope, receive))","+","+        return handle_bounded_request","+","+","+router = VersionedAPIRouter(route_class=DagParsingRoute)","+","+","+def _compute_payload_hash(body: BaseModel) -> str:","+    \"\"\"Hash a request body independently of key order; a non-JSON float raises ValueError.\"\"\"","+    payload = json.dumps(body.model_dump(mode=\"json\"), sort_keys=True, allow_nan=False)","+    return hashlib.sha256(payload.encode()).hexdigest()","+","+","+def _validate_job(","+    job_id: int, token: DagProcessorToken, *, session: Session, for_update: bool = True","+) -> None:","+    if job_id != token.claims.job_id:","+        raise HTTPException(status.HTTP_404_NOT_FOUND, detail={\"reason\": \"not_found\"})","+    query = select(Job).where(Job.id == job_id)","+    # Publications lock the Job to serialize receipt creation and fence completion or replacement.","+    job = session.scalar(query.with_for_update() if for_update else query)","+    if job is None or job.session_id != token.id or job.end_date is not None:","+        raise HTTPException(status.HTTP_403_FORBIDDEN, detail={\"reason\": \"job_closed\"})","+","+","+@router.post(","+    \"/{job_id}/parse-results\",","+    responses=create_openapi_http_exception_doc(","+        [","+            (status.HTTP_403_FORBIDDEN, \"The bundle is not granted, or the Job has ended\"),","+            status.HTTP_404_NOT_FOUND,","+            status.HTTP_409_CONFLICT,","+            status.HTTP_413_CONTENT_TOO_LARGE,","+            status.HTTP_422_UNPROCESSABLE_CONTENT,","+        ]","+    ),","+    dependencies=[Security(require_auth, scopes=[\"token:dag_processor\"])],","+)","+def publish_parse_result(","+    job_id: int,","+    body: DagParseResultBody,","+    *,","+    session: SessionDep,","+    token: DagProcessorToken = CurrentDagProcessorToken,","+) -> DagParseResultResponse:","+    \"\"\"Atomically publish a file's results and a receipt, without reading the processor's filesystem.\"\"\"","+    if body.bundle_name not in token.claims.dag_bundles:","+        raise HTTPException(status.HTTP_403_FORBIDDEN, detail={\"reason\": \"bundle_not_granted\"})","+    try:","+        payload_hash = _compute_payload_hash(body)","+    except ValueError:","+        raise HTTPException(status.HTTP_422_UNPROCESSABLE_CONTENT, detail=\"Invalid JSON value\")","+    source_key = hashlib.sha256(","+        json.dumps([\"parse\", body.bundle_name, body.relative_fileloc]).encode()","+    ).hexdigest()","+    dags = [LazyDeserializedDAG(data=document) for document in body.serialized_dags]","+    dag_ids = [dag.dag_id for dag in dags]","+    import_errors = {(body.bundle_name, path): error for path, error in body.import_errors.items()}","+    # Deserializing every Dag is the slow part of a publication and needs none of the locks below.","+    dags = reject_unpublishable_dags(body.bundle_name, dags, import_errors, session=session)","+","+    _validate_job(job_id, token, session=session)","+    receipt = session.get(DagProcessorPublicationReceipt, (job_id, source_key))","+    if receipt is not None:","+        if receipt.attempt_id == body.attempt_id:","+            if receipt.payload_hash != payload_hash:","+                raise HTTPException(status.HTTP_409_CONFLICT, detail={\"reason\": \"publication_conflict\"})","+            return DagParseResultResponse(attempt_id=receipt.attempt_id, accepted_at=receipt.accepted_at)","+        if body.dispatch_sequence <= receipt.dispatch_sequence:","+            raise HTTPException(status.HTTP_409_CONFLICT, detail={\"reason\": \"publication_superseded\"})","+","+    bundle = session.scalar(","+        select(DagBundleModel).where(DagBundleModel.name == body.bundle_name).with_for_update(key_share=True)","+    )","+    if bundle is None or not bundle.active:","+        raise HTTPException(status.HTTP_409_CONFLICT, detail={\"reason\": \"bundle_inactive\"})","+    if body.bundle_revision != bundle.parse_revision or (","+        bundle.parse_revision is not None and body.bundle_version != bundle.version","+    ):","+        raise HTTPException(status.HTTP_409_CONFLICT, detail={\"reason\": \"source_changed\"})","+    # The check before the locks may have read a team that a reassignment has since replaced. On MySQL","+    # the bundle lock waits for that reassignment to commit, so the team read here is current.","+    dags = _reject_other_teams_plugin_classes(body.bundle_name, dags, import_errors, session=session)","+    accepted_ids = {dag.dag_id for dag in dags}","+    existing = session.scalars(","+        select(DagModel)","+        .where(DagModel.dag_id.in_(dag_ids))","+        .order_by(DagModel.dag_id)","+        .with_for_update(key_share=True)","+    ).all()","+    try:","+        validate_dag_bundle_ownership(existing, body.bundle_name, session=session)","+    except DagBundleOwnershipError as error:","+        raise HTTPException(","+            status.HTTP_409_CONFLICT, detail={\"reason\": \"dag_owned_by_another_bundle\"}","+        ) from error","+","+    # Dags missing from an accepted result, or dropped from it as invalid, go stale in the same","+    # transaction: a dropped Dag that moved within a container would otherwise keep its old row live.","+    # DB mode waits stale_dag_threshold because its manager compares file and Dag parse times written","+    # separately; a publication has no such gap. A failed container cannot list its members, so they","+    # get the threshold as a grace period. _update_import_errors marks Dags stale immediately when an","+    # error names their definition, except when the processor has no result: like a DB-mode timeout,","+    # that leaves the file's Dags to the threshold, which also covers Dags another processor published.","+    cutoff = timezone.utcnow() - timedelta(seconds=conf.getint(\"dag_processor\", \"stale_dag_threshold\"))","+    source_filter = or_(","+        DagModel.relative_fileloc == body.relative_fileloc,","+        DagModel.relative_fileloc.startswith(body.relative_fileloc + \"/\", autoescape=True),","+    )","+    missing = session.scalars(","+        select(DagModel)","+        .where(DagModel.bundle_name == body.bundle_name, source_filter, DagModel.dag_id.not_in(accepted_ids))","+        .order_by(DagModel.dag_id)","+        .with_for_update(key_share=True)","+    )","+    for stored_dag in missing:","+        failed = body.relative_fileloc in body.import_errors","+        if not failed or (stored_dag.last_parsed_time is not None and stored_dag.last_parsed_time < cutoff):","+            stored_dag.is_stale = True","+","+    files_parsed = {(body.bundle_name, path) for path in [body.relative_fileloc, *body.parsed_definitions]}","+    files_parsed.update(import_errors)","+    source_codes = {","+        dag_id: body.source_codes[source_index] for dag_id, source_index in body.dag_source_indexes.items()","+    }","+    try:","+        update_dag_parsing_results_in_db(","+            bundle_name=body.bundle_name,","+            bundle_version=body.bundle_version,","+            version_data=body.version_data,","+            dags=dags,","+            import_errors=import_errors,","+            parse_duration=body.parse_duration,","+            # dag_warning has a foreign key to dag, and a dropped Dag may have no row.","+            warnings={","+                DagWarning(**warning.model_dump())","+                for warning in body.warnings","+                if warning.dag_id in accepted_ids","+            },","+            files_parsed=files_parsed,","+            dag_source_codes={","+                dag_id: DagSourceCode(","+                    source_code=source.source_code","+                    if source.source_code is not None","+                    else \"Source unavailable\",","+                    language=source.language,","+                )","+                for dag_id, source in source_codes.items()","+            },","+            atomic=True,","+            enforce_bundle_ownership=True,","+            resolve_bundle_paths=False,","+            dags_checked=True,","+            mark_errored_dags_stale=not body.result_unavailable,","+            session=session,","+        )","+    except DagPublicationValidationError as error:","+        raise HTTPException(","+            status.HTTP_422_UNPROCESSABLE_CONTENT,","+            detail={\"reason\": \"invalid_dag\", \"message\": str(error)},","+        ) from error","+    except DagBundleOwnershipError as error:","+        raise HTTPException(","+            status.HTTP_409_CONFLICT, detail={\"reason\": \"dag_owned_by_another_bundle\"}","+        ) from error","+    if receipt is None:","+        receipt = DagProcessorPublicationReceipt(job_id=job_id, source_key=source_key)","+        session.add(receipt)","+    receipt.attempt_id = body.attempt_id","+    receipt.dispatch_sequence = body.dispatch_sequence","+    receipt.payload_hash = payload_hash","+    receipt.accepted_at = timezone.utcnow()","+    receipt.bundle_revision = body.bundle_revision","+    session.flush()","+    return DagParseResultResponse(attempt_id=receipt.attempt_id, accepted_at=receipt.accepted_at)","+","+","+@router.get(","+    \"/{job_id}/bundles\",","+    responses=create_openapi_http_exception_doc(","+        [(status.HTTP_403_FORBIDDEN, \"The Job has ended or was replaced\"), status.HTTP_404_NOT_FOUND]","+    ),","+    dependencies=[Security(require_auth, scopes=[\"token:dag_processor\"])],","+)","+def get_bundles(","+    job_id: int, *, session: SessionDep, token: DagProcessorToken = CurrentDagProcessorToken","+) -> list[DagBundleStateResponse]:","+    \"\"\"Read the provisioned catalog without constructing providers on the API server.\"\"\"","+    _validate_job(job