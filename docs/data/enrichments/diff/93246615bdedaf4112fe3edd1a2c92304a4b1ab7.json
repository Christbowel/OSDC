yout, so","+// SetLayout returns an error if the builder already has another layout.","+func (b *Builder) SetLayout(layout streams.Layout) error {","+\tif b.layout != nil && !b.layout.Equal(layout) {","+\t\treturn fmt.Errorf(\"index already has stream layout %v, got %v\", *b.layout, layout)","+\t}","+\tb.layout = &layout","+\tb.sortSchema = strings.Join(layout.SchemaLabels(), \",\")","+\treturn nil","+}","+","+func (b *Builder) getStatsBuilder() (*stats.Builder, error) {"," \tif b.stats == nil {","-\t\tb.stats = stats.NewBuilder(b.metrics.stats, stats.ColumnarSectionEncoder(int(b.cfg.TargetPageSize), b.cfg.MaxPageRows))","+\t\tif b.layout == nil {","+\t\t\treturn nil, errors.New(\"appending a stat before the stream layout is set\")","+\t\t}","+\t\tb.stats = stats.NewBuilder(b.metrics.stats, stats.ColumnarSectionEncoder(int(b.cfg.TargetPageSize), b.cfg.MaxPageRows), *b.layout)"," \t\tb.stats.SetTenant(b.tenant)"," \t}","-\treturn b.stats","+\treturn b.stats, nil"," }"," "," func (b *Builder) getPostingsBuilder() *postings.Builder {","@@ -99,18 +125,23 @@ func (b *Builder) getPostingsBuilder() *postings.Builder {"," \treturn b.postings"," }"," ","-// AppendStat records a per-sort-key aggregate for a data object section.","+// AppendStat records a per-sort-key aggregate for a data object section. The","+// stat uses the schema labels of the layout that [Builder.SetLayout] set, and","+// AppendStat returns an error if no layout is set."," func (b *Builder) AppendStat(objectPath string, sectionIdx int64,","-\tshardBucket uint32, sortSchema string, labels map[string]string, minTs, maxTs time.Time, rows int, uncompressedSize int64) error {","+\tshardBucket uint32, labels map[string]string, minTs, maxTs time.Time, rows int, uncompressedSize int64) error {"," \tb.metrics.appendsTotal.Inc()"," ","-\tstatsBuilder := b.getStatsBuilder()","+\tstatsBuilder, err := b.getStatsBuilder()","+\tif err != nil {","+\t\treturn err","+\t}"," "," \tstatsBuilder.Append(stats.Stat{"," \t\tObj