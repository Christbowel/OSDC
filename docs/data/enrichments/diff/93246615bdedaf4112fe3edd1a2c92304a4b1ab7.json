 TenantLayout returns an error that wraps","+// [ErrMixedLayouts] if the sections disagree, and one that wraps","+// [ErrInvalidLayout] if the layout cannot be read.","+func TenantLayout(ctx context.Context, obj *dataobj.Object, tenant string) (layout streams.Layout, ok bool, err error) {","+\tlayout, recorded, unrecorded, err := recordedTenantLayout(ctx, obj, tenant)","+\tif err != nil {","+\t\treturn streams.Layout{}, false, err","+\t}","+\tswitch {","+\tcase recorded > 0 && unrecorded > 0:","+\t\treturn streams.Layout{}, false, fmt.Errorf(\"%w: %d stats sections record a layout and %d do not\", ErrMixedLayouts, recorded, unrecorded)","+\tcase recorded > 0:","+\t\treturn layout, true, nil","+\tcase unrecorded > 0:","+\t\tlayout, err := legacyTenantLayout(ctx, obj, tenant)","+\t\tif err != nil {","+\t\t\treturn streams.Layout{}, false, err","+\t\t}","+\t\treturn layout, true, nil","+\tdefault:","+\t\treturn streams.Layout{}, false, nil","+\t}","+}","+","+// recordedTenantLayout returns the layout that the stats sections of tenant","+// record, with the count of sections that record one and that do not. It","+// returns an error that wraps [ErrMixedLayouts] if two sections record","+// different layouts.","+func recordedTenantLayout(ctx context.Context, obj *dataobj.Object, tenant string) (layout streams.Layout, recorded, unrecorded int, err error) {","+\tfor _, section := range obj.Sections().Filter(stats.CheckSection) {","+\t\tif section.Tenant != tenant {","+\t\t\tcontinue","+\t\t}","+\t\topened, err := stats.Open(ctx, section)","+\t\tif err != nil {","+\t\t\treturn streams.Layout{}, 0, 0, fmt.Errorf(\"opening stats section: %w\", err)","+\t\t}","+\t\tgot, recordsLayout, err := opened.Layout()","+\t\tif err != nil {","+\t\t\treturn streams.Layout{}, 0, 0, fmt.Errorf(\"%w: reading stats layout: %w\", ErrInvalidLayout, err)","+\t\t}","+\t\tif !recordsLayout {","+\t\t\tunrecorded++","+\t\t\tcontinue","+\t\t}","+\t\tif recorded > 0 && !got.Equal(layout) {","+\t\t\treturn streams.Layout{}, 0, 0, fmt.Errorf(\"%w: stats sections record %v and %v\", ErrMixedLayouts, layout, got)","+\t\t}","+\t\tlayout = got","+\t\trecorded++","+\t}","+\treturn layout, recorded, unrecorded, nil","+}","+","+// legacyTenantLayout derives the layout of an index whose stats sections","+// record none. Writers of such indexes recorded the sort schema on every stats","+// row. They always used the default shard layout, because no other shard","+// factor was valid.","+func legacyTenantLayout(ctx context.Context, obj *dataobj.Object, tenant string) (streams.Layout, error) {","+\tsortSchema, err := legacySortSchema(ctx, obj, tenant)","+\tif err != nil {","+\t\treturn streams.Layout{}, err","+\t}","+\tvar schemaLabels []string","+\tif sortSchema != \"\" {","+\t\tschemaLabels = strings.Split(sortSchema, \",\")","+\t}","+\treturn streams.NewLayout(streams.DefaultShardLayout(), schemaLabels), nil","+}","+","+func legacySortSchema(ctx context.Context, obj *dataobj.Object, tenant string) (string, error) {","+\tvar (","+\t\tsortSchema string","+\t\tfound      bool","+\t)","+\tfor _, section := range obj.Sections().Filter(stats.CheckSection) {","+\t\tif section.Tenant != tenant {","+\t\t\tcontinue","+\t\t}","+\t\topened, err := stats.Open(ctx, section)","+\t\tif err != nil {","+\t\t\treturn \"\", fmt.Errorf(\"opening stats section: %w\", err)","+\t\t}","+\t\terr = func() (err error) {","+\t\t\treader := stats.NewRowReader(ctx, opened)","+\t\t\tdefer util.CloseAndHandleError(reader, &err)","+\t\t\tfor reader.Next() {","+\t\t\t\trow := reader.At()","+\t\t\t\tif found && row.SortSchema != sortSchema {","+\t\t\t\t\treturn fmt.Errorf(\"%w: stats rows have sort schemas %q and %q\", ErrMixedLayouts, sortSchema, row.SortSchema)","+\t\t\t\t}","+\t\t\t\tsortSchema, found = row.SortSchema, true","+\t\t\t}","+\t\t\treturn reader.Err()","+\t\t}()","+\t\tif err != nil {","+\t\t\treturn \"\", err","+\t\t}","+\t}","+\tif !found {","+\t\treturn \"\", fmt.Errorf(\"%w: legacy index has no stats rows for tenant %s\", ErrInvalidLayout, tenant)","+\t}","+\treturn sortSchema, nil","+}"],"additions":136,"deletions":0,"truncated":false},{"path":"pkg/dataobj/index/indexobj/layout_test.go","lines":["@@ -0,0 +1,121 @@","+package indexobj","+","+import (","+\t\"bytes\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/loki/v3/pkg/dataobj\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/stats\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/streams\"","+)","+","+func TestTenantLayout(t *testing.T) {","+\tappLayout := streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:app\"})","+\tclusterLayout := streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:cluster\"})","+","+\t// buildStats builds an object with one stats section of tenant per layout.","+\tbuildStats := func(t *testing.T, tenant string, layouts ...streams.Layout) *dataobj.Object {","+\t\tt.Helper()","+\t\tbuilder := dataobj.NewBuilder(nil)","+\t\tfor i, layout := range layouts {","+\t\t\tstatsBuilder := stats.NewBuilder(nil, stats.ColumnarSectionEncoder(2048, 1000), layout)","+\t\t\tstatsBuilder.SetTenant(tenant)","+\t\t\tstatsBuilder.Append(stats.Stat{ObjectPath: \"logs/obj\", SectionIndex: int64(i), SortSchema: strings.Join(layout.SchemaLabels(), \",\")})","+\t\t\trequire.NoError(t, builder.Append(statsBuilder))","+\t\t}","+\t\tobj, closer, err := builder.Flush()","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(func() { require.NoError(t, closer.Close()) })","+\t\treturn obj","+\t}","+","+\tt.Run(\"returns the layout that every stats section records\", func(t *testing.T) {","+\t\tgot, ok, err := TenantLayout(t.Context(), buildStats(t, \"acme\", appLayout, appLayout), \"acme\")","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, ok)","+\t\trequire.Equal(t, appLayout, got)","+\t})","+","+\tt.Run(\"reports no layout when the index has no stats section for the tenant\", func(t *testing.T) {","+\t\t_, ok, err := TenantLayout(t.Context(), buildStats(t, \"other\", appLayout), \"acme\")","+\t\trequire.NoError(t, err)","+\t\trequire.False(t, ok)","+\t})","+","+\tt.Run(\"returns a mixed layouts error when stats sections record different layouts\", func(t *testing.T) {","+\t\t_, _, err := TenantLayout(t.Context(), buildStats(t, \"acme\", appLayout, clusterLayout), \"acme\")","+\t\trequire.ErrorIs(t, err, ErrMixedLayouts)","+\t})","+","+\tt.Run(\"returns an invalid layout error for a legacy index without stats rows\", func(t *testing.T) {","+\t\t_, err := legacyTenantLayout(t.Context(), buildStats(t, \"other\", appLayout), \"acme\")","+\t\trequire.ErrorIs(t, err, ErrInvalidLayout)","+\t})","+","+\tt.Run(\"derives the layout of a legacy index from its stats rows and the default shard layout\", func(t *testing.T) {","+\t\tdata, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"testdata\", \"legacy\", \"legacy-index.dataobj\"))","+\t\trequire.NoError(t, err)","+\t\tobj, err := dataobj.FromReaderAt(bytes.NewReader(data), int64(len(data)))","+\t\trequire.NoError(t, err)","+","+\t\tgot, ok, err := TenantLayout(t.Context(), obj, \"acme\")","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, ok)","+\t\trequire.Equal(t, streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:service_name\"}), got)","+\t})","+}","+","+func TestBuilder_SetLayout(t *testing.T) {","+\tappLayout := streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:app\"})","+\tts := time.Unix(10, 0).UTC()","+\tnewBuilder := func(t *testing.T) *Builder {","+\t\tt.Helper()","+\t\tb, err := NewBuilder(testTenant, testBuilderConfig, nil, NewBuilderMetrics(nil))","+\t\trequire.NoError(t, err)","+\t\treturn b","+\t}","+","+\tt.Run(\"records the layout in every stats section\", func(t *testing.T) {","+\t\tb := newBuilder(t)","+\t\trequire.NoError(t, b.SetLayout(appLayout))","+\t\trequire.NoError(t, b.AppendStat(\"logs/obj\", 0, 0, map[string]string{\"app\": \"a\"}, ts, ts, 1, 10))","+","+\t\tobj, closer, err := b.Flush()","+\t\trequire.NoError(t, err)","+\t\tt.Cleanup(func() { require.NoError(t, closer.Close()) })","+","+\t\tgot, ok, err := TenantLayout(t.Context(), obj, testTenant)","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, ok)","+\t\trequire.Equal(t, appLayout, got)","+\t})","+","+\tt.Run(\"accepts the same layout again\", func(t *testing.T) {","+\t\tb := newBuilder(t)","+\t\trequire.NoError(t, b.SetLayout(appLayout))","+\t\trequire.NoError(t, b.SetLayout(streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:app\"})))","+\t})","+","+\tt.Run(\"returns an error for another layout\", func(t *testing.T) {","+\t\tb := newBuilder(t)","+\t\trequire.NoError(t, b.SetLayout(appLayout))","+\t\trequire.ErrorContains(t, b.SetLayout(streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:cluster\"})), \"already has stream layout\")","+\t})","+","+\tt.Run(\"returns an error for a stat appended before the layout is set\", func(t *testing.T) {","+\t\trequire.ErrorContains(t, newBuilder(t).AppendStat(\"logs/obj\", 0, 0, nil, ts, ts, 1, 10), \"before the stream layout is set\")","+\t})","+","+\tt.Run(\"accepts another layout after Reset\", func(t *testing.T) {","+\t\tb := newBuilder(t)","+\t\trequire.NoError(t, b.SetLayout(appLayout))","+\t\tb.Reset()","+\t\trequire.NoError(t, b.SetLayout(streams.NewLayout(streams.DefaultShardLayout(), []string{\"label:cluster\"})))","+\t})","+}"],"additions":121,"deletions":0,"truncated":false},{"path":"pkg/dataobj/index/indexobj/merge_builder.go","lines":["@@ -12,6 +12,7 @@ import ("," \t\"github.com/grafana/loki/v3/pkg/dataobj/logsobj\""," \t\"github.com/grafana/loki/v3/pkg/dataobj/sections/postings\""," \t\"github.com/grafana/loki/v3/pkg/dataobj/sections/stats\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/streams\""," \t\"github.com/grafana/loki/v3/pkg/scratch\""," )"," ","@@ -20,18 +21,25 @@ import ("," // MergeBuilder accepts already-aggreg