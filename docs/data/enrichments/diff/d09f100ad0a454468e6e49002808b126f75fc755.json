{"id":"d09f100ad0a454468e6e49002808b126f75fc755","axis":"silent","repo":"grafana/grafana","sha":"d09f100ad0a454468e6e49002808b126f75fc755","parsed":{"files":[{"path":".github/CODEOWNERS","lines":["@@ -1207,6 +1207,9 @@ scripts/verify-pkg-stig.sh @grafana/grafana-backend-services-squad"," "," /scripts/codeowners-manifest/ @grafana/dataviz-squad"," /scripts/test-coverage-by-codeowner.js @grafana/dataviz-squad","+/scripts/meticulous-coverage-by-codeowner.mjs @grafana/dataviz-squad","+/scripts/meticulous-coverage-report.mjs @grafana/dataviz-squad","+/scripts/meticulous-coverage.test.mjs @grafana/dataviz-squad"," /jest.config.codeowner.js @grafana/dataviz-squad"," "," /scripts/**/generate-transformations* @grafana/datapro"],"additions":3,"deletions":0,"truncated":false},{"path":"jest.config.codeowner.js","lines":["@@ -3,6 +3,7 @@ const open = require('open').default;"," const path = require('path');"," "," const baseConfig = require('./jest.config.js');","+const { isCoverageSourceFile } = require('./scripts/codeowners-manifest/coverage-files.js');"," const { buildCodeownerDirectoryPath } = require('./scripts/codeowners-manifest/utils.js');"," "," const CODEOWNERS_MANIFEST_FILENAMES_BY_TEAM_PATH = 'codeowners-manifest/filenames-by-team.json';","@@ -33,31 +34,7 @@ if (teamFiles.length === 0) {","   process.exit(1);"," }"," ","-const sourceFiles = teamFiles.filter((file) => {","-  const ext = path.extname(file);","-  return (","-    ['.ts', '.tsx', '.js', '.jsx'].includes(ext) &&","-    // exclude all tests and mocks","-    !path.matchesGlob(file, '**/test/**/*') &&","-    !file.includes('.test.') &&","-    !file.includes('.spec.') &&","-    !path.matchesGlob(file, '**/__mocks__/**/*') &&","-    // and storybook stories","-    !file.includes('.story.') &&","-    // and generated files","-    !file.includes('.gen.ts') &&","-    // and type definitions","-    !file.includes('.d.ts') &&","-    !file.endsWith('/types.ts') &&","-    // and anything in graveyard","-    !path.matchesGlob(file, '**/graveyard/**/*') &&","-    // and scripts directory","-    !file.startsWith('scripts/') &&","-    // and jest config files","-    !path.matchesGlob(file, '**/jest.config*.js') &&","-    !file.endsWith('/module.tsx')","-  );","-});","+const sourceFiles = teamFiles.filter(isCoverageSourceFile);"," "," const testFiles = teamFiles.filter((file) => {","   const ext = path.extname(file);"],"additions":2,"deletions":25,"truncated":false},{"path":"package.json","lines":["@@ -36,6 +36,7 @@","     \"test:by-codeowner:list\": \"pnpm --silent run codeowners-manifest && node scripts/codeowners-manifest/list-tests.mts\",","     \"test:coverage\": \"jest --coverage\",","     \"test:coverage:by-codeowner\": \"pnpm run codeowners-manifest && node scripts/test-coverage-by-codeowner.js\",","+    \"test:coverage:meticulous:by-codeowner\": \"node scripts/meticulous-coverage-by-codeowner.mjs\",","     \"test:coverage:changes\": \"jest --coverage --changedSince=origin/main\",","     \"test:storybook\": \"pnpm --filter @grafana/ui --fail-if-no-match run storybook:test\",","     \"test:accessibility-report\": \"./scripts/generate-a11y-report.sh\",","@@ -199,6 +200,7 @@","     \"fishery\": \"^2.2.2\",","     \"github-codeowners\": \"^0.2.1\",","     \"i18next-cli\": \"^1.48.0\",","+    \"ignore\": \"7.0.12\",","     \"ini\": \"^5.0.0\",","     \"jest\": \"29.7.0\",","     \"jest-canvas-mock\": \"2.5.2\",","@@ -214,6 +216,7 @@","     \"knip\": \"^6.14.2\",","     \"madge\": \"^8.0.0\",","     \"memfs\": \"^3.5.3\",","+    \"monocart-coverage-reports\": \"2.12.6\",","     \"msw\": \"2.10.4\",","     \"mutationobserver-shim\": \"0.3.7\",","     \"nx\": \"24.0.2\","],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -1007,6 +1007,9 @@ importers:","       i18next-cli:","         specifier: ^1.48.0","         version: 1.58.0(@swc/helpers@0.5.17)(@types/node@26.6.5)(@typescript/typescript6@6.0.2)(i18next@26.4.2(@typescript/typescript6@6.0.2))(react-dom@19.2.8(react@19.2.8))","+      ignore:","+        specifier: 7.0.12","+        version: 7.0.12","       ini:","         specifier: ^5.0.0","         version: 5.0.0","@@ -1052,6 +1055,9 @@ importers:","       memfs:","         specifier: ^3.5.3","         version: 3.5.3","+      monocart-coverage-reports:","+        specifier: 2.12.6","+        version: 2.12.6","       msw:","         specifier: 2.10.4","         version: 2.10.4(@types/node@26.6.5)(@typescript/typescript6@6.0.2)"],"additions":6,"deletions":0,"truncated":false},{"path":"scripts/codeowners-manifest/README.md","lines":["@@ -60,4 +60,89 @@ By default these scripts will write the following files to the `/codeowners-mani"," "," ## Excluded paths"," ","-For a list of excluded paths and filenames, see `jest.config.codeowner.js`.","+Exclusions are defined in `coverage.ignore` using gitignore syntax, relative to the","+repository root. `coverage-files.js` applies these rules to JavaScript and TypeScript","+source files. Matching is case-sensitive.","+","+## Meticulous coverage by team","+","+This report joins Meticulous JavaScript line coverage with the current checkout's","+CODEOWNERS manifest. It does not run tests or require a local Grafana instance.","+","+Install the Meticulous CLI yourself (it is not a repository dependency):","+","+```bash","+npm install --global @alwaysmeticulous/cli@latest","+```","+","+Create a project API token at","+[Grafana's Meticulous API tokens page](https://app.meticulous.ai/settings/grafana/projects/grafana/api-tokens).","+Set `METICULOUS_API_TOKEN` in your machine's shell configuration, for example in","+`~/.zshrc` or `~/.bashrc`, then restart your shell:","+","+```bash","+export METICULOUS_API_TOKEN='<your Grafana project API token>'","+```","+","+Keep the real token out of the repository. The script passes it through the CLI's","+inherited environment; you do not need to provide it with each invocation.","+Missing CLI or token produces setup instructions and a nonzero exit status.","+Run the installation command again if the CLI reports unsupported options.","+","+```bash","+# All Grafana teams, using the project's latest successful coverage","+pnpm test:coverage:meticulous:by-codeowner","+","+# One team's total and browsable Monocart report (opens automatically)","+pnpm test:coverage:meticulous:by-codeowner '@grafana/dataviz-squad'","+","+# Save a team report without opening the browser","+pnpm test:coverage:meticulous:by-codeowner '@grafana/dataviz-squad' --no-open","+","+# A specific test run (can also be combined with a team)","+pnpm test:coverage:meticulous:by-codeowner --test-run-id '<run ID>'","+","+# Help requires neither CLI installation nor authentication","+pnpm test:coverage:meticulous:by-codeowner --help","+```","+","+The command refreshes the cached manifest automatically. It resolves coverage to","+one run and fetches every page, including files with zero executed lines. Output","+shows the run ID and commit when available. Unavailable coverage fails instead","+of producing partial totals.","+","+Coverage is the sum of executed lines divided by the sum of executable lines,","+not an average of file percentages. Shared files count fully for every owning","+`@grafana/` team; the overall total counts each file once. Files without a Grafana","+team, including paths absent from the local manifest, appear in a separate row.","+","+Jest and Meticulous share the source-file filter in `coverage-files.js` and the","+exclusion patterns in `coverage.ignore`. Tests,","+mocks, stories, generated files, declarations, graveyard code, scripts, Jest","+configs, panel module entrypoints, and all `e2e-playwright/` files (including","+helpers and test plugins) are excluded from both reports. Exclusions apply","+before calculating team or overall totals and before generating HTML.","+","+Only eligible files returned by Meticulous enter the denominator. Files missing from its","+inventory are unknown, not zero-covered. Teams without returned files show","+`No coverage data`; files with zero executable lines show `N/A`. The report warns","+when Meticulous reports source files it could not parse. Coverage may describe a","+different commit from the checkout used for ownership attribution, so these","+percentages should not be compared directly with Jest coverage percentages.","+","+Individual team reports are saved under","+`coverage/meticulous/by-team/teams/team-grafana-<team>/html/index.html`. The terminal","+prints the team total and report URL; the HTML provides a searchable file list","+and source-line highlighting. Reports open automatically except when `CI=true`","+or `--no-open` is supplied. Teams without coverage data do not generate a report.","+","+The report uses executable and executed line ranges from Meticulous. Only the","+Lines metric is shown: the Istanbul adapter represents each executable line as","+a synthetic statement, with binary covered/uncovered hits. It does not measure","+statement, function, branch, or execution-count coverage.","+","+Source text is loaded from the run's `commitSha` using Git, never from modified","+working-tree files. If the commit or source file is unavailable locally, fetch","+the run's commit and retry. The script does not fetch Git history automatically.","+Ownership still comes from the current checkout. The run and source commit are","+shown in the HTML report."],"additions":86,"deletions":1,"truncated":false},{"path":"scripts/codeowners-manifest/coverage-files.js","lines":["@@ -0,0 +1,12 @@","+const ignore = require('ignore');","+const { readFileSync } = require('node:fs');","+const path = require('node:path');","+","+const exclusions = ignore({ ignorecase: false }).add(readFileSync(path.join(__dirname, 'coverage.ignore'), 'utf8'));","+","+function isCoverageSourceFile(file) {","+  file = file.replace(/\\\\/g, '/').replace(/^\\.\\//, '');","+  return ['.ts', '.tsx', '.js', '.jsx'].includes(path.extname(file)) && !exclusions.ignores(file);","+}","+","+module.exports = { isCoverageSourceFile };"],"additions":12,"deletions":0,"truncated":false},{"path":"scripts/codeowners-manifest/coverage.ignore","lines":["@@ -0,0 +1,22 @@","+# Patterns use gitignore syntax, relative to the repository root.","+","+# Tests and mocks","+test/","+*.test.*","+*.spec.*","+__mocks__/","+","+# Stories, generated files, and types","+*.story.*","+*.gen.ts*","+*.d.ts*","+types.ts","+","+# Excluded directories","+graveyard/","+/scripts/","+/e2e-playwright/","+","+# Configuration and panel entrypoints","+jest.config*.js","+module.tsx"],"additions":22,"deletions":0,"truncated":false},{"path":"scripts/meticulous-coverage-by-codeowner.mjs","lines":["@@ -0,0 +1,333 @@","+#!/usr/bin/env node","+","+import { execFile } from 'node:child_process';","+import { readFile } from 'node:fs/promises';","+import path from 'node:path';","+import { fileURLToPath, pathToFileURL } from 'node:url';","+import { promisify } from 'node:util';","+","+import constants from './codeowners-manifest/constants.js';","+import coverageFiles from './codeowners-manifest/coverage-files.js';","+","+const { CODEOWNERS_BY_FILENAME_JSON_PATH } = constants;","+","+const execFileAsync = promisify(execFile);","+const SCRIPT_DIR = fileURLToPath(new URL('.', import.meta.url));","+const ROOT = path.resolve(SCRIPT_DIR, '..');","+const INSTALL = 'npm install --global @alwaysmeticulous/cli@latest';","+const TOKEN_HELP =","+  'Create a Grafana API token at https://app.meticulous.ai/settings/grafana/projects/grafana/api-tokens\\n' +","+  'Set METICULOUS_API_TOKEN in your local shell configuration, then restart your shell. Do not store it in the repository.';","+const PAGE_SIZE = 1000;","+","+function redact(message, token) {","+  return token ? message.split(token).join('[REDACTED]') : message;","+}","+","+async function runCli(args, env = process.env, platform = process.platform, execute = execFileAsync) {","+  const windows = platform === 'win32';","+  // Windows npm shims require a shell; reject shell syntax in externally supplied run IDs.","+  if (windows && args.some((arg) => !/^[a-zA-Z0-9_./=:-]+$/.test(arg))) {","+    throw new Error(","+      'Invalid Meticulous CLI argument. Use only letters, numbers, underscores, dots, slashes, colons, equals signs, and hyphens.'","+    );","+  }","+  try {","+    const { stdout } = await execute('meticulous', args, {","+      shell: windows,","+      cwd: ROOT,","+      env,","+      maxBuffer: 16 * 1024 * 1024,","+      timeout: 12 * 60 * 1000,","+    });","+    return stdout;","+  } catch (error) {","+    if (error.code === 'ENOENT') {","+      throw new Error(`Meticulous CLI was not found on PATH. Install it yourself:\\n${INSTALL}`);","+    }","+    const detail = redact(String(error.stderr || error.message), env.METICULOUS_API_TOKEN);","+    throw new Error(`Meticulous CLI failed: ${detail}\\nTo update the CLI: ${INSTALL}\\n${TOKEN_HELP}`);","+  }","+}","+","+function normalizePath(filename) {","+  const normalized = path.posix.normalize(filename.replace(/\\\\/g, '/'));","+  if (!normalized || normalized === '.' || normalized.startsWith('../') || path.posix.isAbsolute(normalized)) {","+    throw new Error('Expected a repository-relative coverage path.');","+  }","+  return normalized;","+}","+","+function parseCoveragePage(output, includeRanges = false) {","+  if (output.trim() === '') {","+    return { files: [], skippedRows: 0, rowCount: 0 };","+  }","+  const [header, ...lines] = output.replace(/[\\r\\n]+$/, '').split(/\\r?\\n/);","+  const columns = header.split('\\t');","+  const required = ['repoFilePath', 'executedLines', 'executableLines'];","+  if (includeRanges) {","+    required.push('executedRanges', 'executableRanges');","+  }","+  if (required.some((column) => columns.filter((value) => value === column).length !== 1)) {","+    throw new Error(`Invalid Meticulous coverage columns. Update the CLI: ${INSTALL}`);","+  }","+  let skippedRows = 0;","+  const files = lines.flatMap((line) => {","+    try {","+      const cells = line.split('\\t');","+      const value = (column) => cells[columns.indexOf(column)];","+      const executedLines = Number(value('executedLines'));","+      const executableLines = Number(value('executableLines'));","+      if (","+        cells.length !== columns.length ||","+        !value('repoFilePath') ||","+        !/^\\d+$/.test(value('executedLines')) ||","+        !/^\\d+$/.test(value('executableLines')) ||","+        !Number.isSafeInteger(executedLines) ||","+        !Number.isSafeInteger(executableLines) ||","+        executedLines > executableLines","+      ) {","+        throw new Error('Invalid Meticulous coverage row; no totals were generated.');","+      }","+      return {","+        path: normalizePath(value('repoFilePath')),","+        executedLines,","+        executableLines,","+        ...(includeRanges","+          ? {","+              executedRanges: parseLineRanges(value('executedRanges')),","+              executableRanges: parseLineRanges(value('executableRanges')),","+            }","+          : {}),","+      };","+    } catch {","+      skippedRows++;","+      return [];","+    }","+  });","+  return { files, skippedRows, rowCount: lines.length };","+}","+","+function parseLineRanges(value) {","+  if (value === '') {","+    return [];","+  }","+  return value.split(';').map((range) => {","+    if (!/^\\d+(?:-\\d+)?$/.test(range)) {","+      throw new Error('Invalid Meticulous line range.');","+    }","+    const [start, end = start] = range.split('-').map(Number);","+    if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start < 1 || end < start) {","+      throw new Error('Invalid Meticulous line range.');","+    }","+    return [start, end];","+  });","+}","+","+async function fetchCoverage(testRunId, cli = runCli, includeRanges = false) {","+  const selector = testRunId ? [`--testRunId=${testRunId}`] : ['--latestForProject'];","+  const base = ['agent', 'js-coverage', '--project=grafana/grafana'];","+  const rawSummary = await cli([...base, ...selector, '--summary', '--json']);","+  let source;","+  try {","+    source = JSON.parse(rawSummary);","+  } catch {","+    throw new Error(`Invalid Meticulous coverage summary. Update the CLI: ${INSTALL}`);","+  }","+  if (source?.status === 'processing') {","+    throw new Error('Meticulous coverage is still processing. Try again when the run has finished.');","+  }","+  if (source == null) {","+    throw new Error('No successful test run with coverage was found for grafana/grafana.');","+  }","+  if (typeof source.testRunId !== 'string' || !source.testRunId || (testRunId && source.testRunId !== testRunId)) {","+    throw new Error('Invalid Meticulous coverage run ID; no totals were generated.');","+  }","+","+  const files = [];","+  let skippedRows = 0;","+  const seen = new Set();","+  // Pin all pages to the resolved run, even if the project's latest run changes during the fetch.","+  for (let offset = 0; ; offset += PAGE_SIZE) {","+    const page = parseCoveragePage(","+      await cli([","+        ...base,","+        `--testRunId=${source.testRunId}`,","+        '--includeAllFiles',","+        '--includeLineCounts',","+        ...(includeRanges ? ['--includeExecutedRanges', '--includeExecutableRanges'] : []),","+        '--orderBy=repoFilePath',","+        '--order=asc',","+        `--limit=${PAGE_SIZE}`,","+        `--offset=${offset}`,","+      ]),","+      includeRanges","+    );","+    if (page.rowCount > PAGE_SIZE || page.files.some((file) => seen.has(file.path))) {","+      throw new Error('Inconsistent Meticulous pagination; no totals were generated.');","+    }","+    for (const file of page.files) {","+      if (seen.has(file.path)) {","+        throw new Error('Duplicate Meticulous coverage path; no totals were generated.');","+      }","+      seen.add(file.path);","+      files.push(file);","+    }","+    skippedRows += page.skippedRows;","+    if (page.rowCount < PAGE_SIZE) {","+      return { source, skippedRows, files: files.filter((file) => coverageFiles.isCoverageSourceFile(file.path)) };","+    }","+  }","+}","+","+function attributeCoverage(files, manifest) {","+  const ownersByPath = new Map();","+  const teams = new Map();","+  for (const [filename, owners] of Object.entries(manifest)) {","+    const teamOwners = [...new Set(owners.filter((owner) => owner.startsWith('@grafana/')))];","+    ownersByPath.set(normalizePath(filename), teamOwners);","+    for (const team of teamOwners) {","+      if (!teams.has(team)) {","+        teams.set(team, []);","+      }","+    }","+  }","+  const unowned = [];","+  for (const file of files) {","+    const owners = ownersByPath.get(file.path) || [];","+    if (owners.length === 0) {","+      unowned.push(file);","+    }","+    for (const team of owners) {","+      teams.get(team).push(file);","+    }","+  }","+  return { teams, unowned };","+}","+","+function totals(files) {","+  const executedLines = files.reduce((sum, file) => sum + file.executedLines, 0);","+  const executableLines = files.reduce((sum, file) => sum + file.executableLines, 0);","+  return [","+    String(files.length),","+    String(executedLines),","+    String(executableLines),","+    files.length === 0","+      ? 'No coverage data'","+      : executableLines === 0","+        ? 'N/A'","+        : `${((100 * executedLines) / executableLines).toFixed(2)}%`,","+  ];","+}","+","+function renderTable(rows) {","+  const widths = rows[0].map((_, index) => Math.max(...rows.map((row) => row[index].length)));","+  return rows","+    .map((row) =>","+      row","+        .map((cell, index) => cell.padEnd(widths[index]))","+        .join('  ')","+        .trimEnd()","+    )","+    .join('\\n');","+}","+","+function renderReport({ source, files, skippedRows = 0 }, manifest, team) {","+  const { teams, unowned } = attributeCoverage(files, manifest);","+  if (team && !teams.has(team)) {","+    throw new Error(`Codeowner \"${team}\" was not found among Grafana teams.`);","+  }","+  const header = ['Team', 'Files', 'Covered lines', 'Executable lines', 'Coverage'];","+  const rows = team","+    ? [header, [team, ...totals(teams.get(team))]]","+    : [","+        header,","+        ...[...teams.keys()].sort().map((name) => [name, ...totals(teams.get(name))]),","+        ['No Grafana team / unmatched', ...totals(unowned)],","+        ['Overall (unique files)', ...totals(files)],","+      ];","+  const sections = [","+    `Meticulous coverage: grafana/grafana, run ${source.testRunId}${source.commitSha ? `, commit ${source.commitSha}` : ''}`,","+    'Ownership: current checkout. Shared files count for each owner; team totals can overlap.',","+    'Jest codeowner source exclusions applied. Only eligible files returned by Meticulous are counted.',","+    'Missing files are unknown, not zero-covered.',","+  ];","+  if (source.filesFailedToParse > 0) {","+    sections.push(","+      `Warning: Meticulous could not parse ${source.filesFailedToParse} files; coverage may be incomplete.`","+    );","+  }","+  if (skippedRows > 0) {","+    sections.push(`Warning: Skipped ${skippedRows} invalid coverage rows across this run; coverage may be incomplete.`);","+  }","+  sections.push(renderTable(rows));","+  return sections.join('\\n\\n');","+}","+","+async function main(args = process.argv.slice(2)) {","+  const { default: yargs } = await import('yargs/yargs');","+  const argv = yargs(args)","+    .scriptName('pnpm test:coverage:meticulous:by-codeowner')","+    .usage('$0 [team] [--test-run-id <id>]')","+    .option('test-run-id', {","+      type: 'string',","+      description: 'Use a specific test run instead of latest project coverage',","+    })","+    .option('open', {","+      type: 'boolean',","+      default: process.env.CI !== 'true',","+      description: 'Open team HTML report in the browser (use --no-open to disable)',","+    })","+    .check((args) => {","+      if (args._.length > 1 || args['test-run-id'] === '') {","+        throw new Error('Provide at most one team and a nonempty --test-run-id.');","+      }","+      return true;","+    })","+    .strictOptions()","+    .help()","+    .version(false)","+    .parse();","+","+  await runReport(argv._[0], argv['test-run-id'], argv.open);","+}","+","+async function runReport(team, testRunId, shouldOpen = process.env.CI !== 'true') {","+  await runCli(['--version']);","+  if (!process.env.METICULOUS_API_TOKEN?.trim()) {","+    throw new Error(`METICULOUS_API_TOKEN is required.\\n${TOKEN_HELP}`);","+  }","+  await execFileAsync(process.execPath, [path.join(SCRIPT_DIR, 'codeowners-manifest/index.js')], {","+    cwd: ROOT,","+  });","+  const manifest = JSON.parse(await readFile(path.join(ROOT, CODEOWNERS_BY_FILENAME_JSON_PATH), 'utf8'));","+  if (team && !attributeCoverage([], manifest).teams.has(team)) {","+    throw new Error(`Codeowner \"${team}\" was not found among Grafana teams.`);","+  }","+  console.error('Fetching Meticulous coverage for grafana/grafana...');","+  const coverage = await fetchCoverage(testRunId, runCli, Boolean(team));","+  let reportURL;","+  if (team) {","+    const { writeTeamReport } = await import('./meticulous-coverage-report.mjs');","+    const files = attributeCoverage(coverage.files, manifest).teams.get(team);","+    const report = await writeTeamReport({ ...coverage, files }, team, { repoRoot: ROOT, shouldOpen });","+    reportURL = report.reportURL;","+    coverage.files = report.files;","+    for (const file of report.skippedFiles) {","+      console.warn(`Warning: Excluded ${file.path} from terminal and HTML totals: ${file.reason}`);","+    }","+  }","+  console.log(renderReport(coverage, manifest, team));","+  if (reportURL) {","+    console.log(`Coverage report saved to ${reportURL}`);","+  }","+}","+","+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {","+  main().catch((error) => {","+    console.error(redact(error.message, process.env.METICULOUS_API_TOKEN));","+    process.exitCode = 1;","+  });","+}","+","+export { runCli, parseCoveragePage, fetchCoverage, attributeCoverage, renderReport, runReport };"],"additions":333,"deletions":0,"truncated":false},{"path":"scripts/meticulous-coverage-report.mjs","lines":["@@ -0,0 +1,148 @@","+import { CoverageReport } from 'monocart-coverage-reports';","+import { execFile } from 'node:child_process';","+import { mkdir, readFile, readdir, writeFile } from 'node:fs/promises';","+import path from 'node:path';","+import { pathToFileURL } from 'node:url';","+import { promisify } from 'node:util';","+import open from 'open';","+","+import codeowners from './codeowners-manifest/utils.js';","+","+const execFileAsync = promisify(execFile);","+const LINE_NOTE =","+  'Line coverage only. Each executable line is represented as a synthetic statement. Hits are binary (covered/uncovered), not execution counts. Branch and function coverage are unavailable. Ownership comes from the current checkout. Jest codeowner source exclusions are applied.';","+","+function escapeHtml(value) {","+  return String(value).replace(","+    /[&<>\"']/g,","+    (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[character]","+  );","+}","+","+function expandRanges(ranges, lineCount) {","+  const lines = new Set();","+  for (const [start, end] of ranges) {","+    if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start < 1 || end < start || end > lineCount) {","+      throw new Error('Coverage ranges do not match the source at the reported commit.');","+    }","+    for (let line = start; line <= end; line++) {","+      lines.add(line);","+    }","+  }","+  return lines;","+}","+","+function toIstanbul(file, sourceText) {","+  const sourceLines = sourceText.split(/\\r?\\n/);","+  const executable = expandRanges(file.executableRanges, sourceLines.length);","+  const executed = expandRanges(file.executedRanges, sourceLines.length);","+  if (","+    executable.size !== file.executableLines ||","+    executed.size !== file.executedLines ||","+    [...executed].some((line) => !executable.has(line))","+  ) {","+    throw new Error(`Coverage ranges and line counts disagree for ${file.path}.`);","+  }","+  const statementMap = {};","+  const s = {};","+  // Istanbul derives line coverage from statements; these represent lines, not parsed JS statements.","+  for (const line of executable) {","+    statementMap[line] = { start: { line, column: 0 }, end: { line, column: sourceLines[line - 1].length } };","+    s[line] = executed.has(line) ? 1 : 0;","+  }","+  return { path: file.path, statementMap, s, fnMap: {}, f: {}, branchMap: {}, b: {} };","+}","+","+async function annotateHtml(directory, banner) {","+  for (const entry of await readdir(directory, { withFileTypes: true })) {","+    const filename = path.join(directory, entry.name);","+    if (entry.isDirectory()) {","+      await annotateHtml(filename, banner);","+    } else if (entry.name.endsWith('.html')) {","+      const html = await readFile(filename, 'utf8');","+      // html-spa limits overview metrics, but its source pages use the standard four-metric header.","+      const linesOnly = html.replace(","+        /<div class='fl pad1y space-right2'>\\s*<span class=\"strong\">[^<]*<\\/span>\\s*<span class=\"quiet\">(?:Statements|Branches|Functions)<\\/span>\\s*<span class='fraction'>[^<]*<\\/span>\\s*<\\/div>/g,","+        ''","+      );","+      await writeFile(","+        filename,","+        linesOnly.replace(/<body[^>]*>/, (body) => `${body}${banner}`)","+      );","+    }","+  }","+}","+","+async function writeTeamReport({ source, files, skippedRows = 0 }, team, { repoRoot, outputDir, shouldOpen = false }) {","+  if (files.length === 0) {","+    return { reportURL: null, files: [], skippedFiles: [] };","+  }","+  const commit = source.commitSha;","+  if (typeof commit !== 'string' || !/^[a-f\\d]{40,64}$/i.test(commit)) {","+    throw new Error('Meticulous did not provide a full source commit SHA; cannot generate source coverage.');","+  }","+  const sources = new Map();","+  const coverageMap = {};","+  const skippedFiles = [];","+  const validFiles = [];","+  for (const file of files) {","+    let stdout;","+    try {","+      ({ stdout } = await execFileAsync('git', ['show', `${commit}:${file.path}`], {","+        cwd: repoRoot,","+        encoding: 'utf8',","+        maxBuffer: 16 * 1024 * 1024,","+      }));","+    } catch {","+      throw new Error(","+        `Cannot read ${file.path} at ${commit}. Fetch the coverage run's commit into this repository and retry.`","+      );","+    }","+    const filename = path.resolve(repoRoot, file.path);","+    try {","+      coverageMap[filename] = { ...toIstanbul(file, stdout), path: filename };","+      sources.set(filename, stdout);","+      validFiles.push(file);","+    } catch (error) {","+      skippedFiles.push({ path: file.path, reason: error.message });","+    }","+  }","+  const directory =","+    outputDir ?? path.join(repoRoot, 'coverage/meticulous/by-team', codeowners.buildCodeownerDirectoryPath(team));","+  const banner = `<aside style=\"padding:16px;background:#eef4ff;color:#172554;font:14px sans-serif\"><strong>${escapeHtml(team)} — Meticulous line coverage</strong><p>Run ${escapeHtml(source.testRunId)} · Source commit ${escapeHtml(commit)}</p><p>${LINE_NOTE}</p>${source.filesFailedToParse ? `<p>Warning: Meticulous could not parse ${escapeHtml(source.filesFailedToParse)} files across this run.</p>` : ''}${skippedRows ? `<p>Warning: Skipped ${escapeHtml(skippedRows)} invalid coverage rows across this run.</p>` : ''}${skippedFiles.length ? `<p>Warning: Skipped ${skippedFiles.length} files with invalid coverage ranges; report totals exclude these files.</p><ul>${skippedFiles.map((file) => `<li>${escapeHtml(file.path)}: ${escapeHtml(file.reason)}</li>`).join('')}</ul>` : ''}</aside>`;","+  const report = new CoverageReport({","+    name: `Meticulous line coverage - ${team}`,","+    outputDir: directory,","+    reports: [['html-spa', { subdir: 'html', metricsToShow: ['lines'] }]],","+    // Supply source directly: Monocart otherwise reads disk before calling sourceFinder.","+    fileSources: Object.fromEntries([...sources].map(([filename, source]) => [filename, source || '\\n'])),","+    logging: 'off',","+  });","+  report.cleanCache();","+  if (Object.keys(coverageMap).length > 0) {","+    await report.add(coverageMap);","+    report.clean();","+    await report.generate();","+  } else {","+    await mkdir(directory, { recursive: true });","+    report.clean();","+    await mkdir(path.join(directory, 'html'), { recursive: true });","+    await writeFile(","+      path.join(directory, 'html/index.html'),","+      '<!doctype html><html><head><title>Meticulous line coverage</title></head><body><p>No valid source coverage remains for this team.</p></body></html>'","+    );","+  }","+","+  await annotateHtml(path.join(directory, 'html'), banner);","+  const reportURL = pathToFileURL(path.join(directory, 'html/index.html')).href;","+  if (shouldOpen) {","+    try {","+      await open(reportURL);","+    } catch {","+      console.warn(`Could not open the browser. Open the report manually: ${reportURL}`);","+    }","+  }","+  return { reportURL, files: validFiles, skippedFiles };","+}","+","+export { toIstanbul, writeTeamReport };"],"additions":148,"deletions":0,"truncated":false},{"path":"scripts/meticulous-coverage.test.mjs","lines":["@@ -0,0 +1,143 @@","+import assert from 'node:assert/strict';","+import { execFileSync } from 'node:child_process';","+import { mkdtemp, readFile, rm } from 'node:fs/promises';","+import os from 'node:os';","+import path from 'node:path';","+import test from 'node:test';","+import { fileURLToPath } from 'node:url';","+","+import { fetchCoverage, parseCoveragePage, renderReport, runCli } from './meticulous-coverage-by-codeowner.mjs';"],"additions":9,"deletions":0,"truncated":false}],"additions":624,"delet