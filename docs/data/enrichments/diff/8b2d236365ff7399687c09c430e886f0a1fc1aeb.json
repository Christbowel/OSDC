context, const BoundFunctionEx"," \treturn ExpressionExecutor::TryEvaluateScalar(context, clone, result);"," }"," ","+// Equal bounds need not imply identical inputs for certain types, so we skip this optimization for them.","+bool CanInferConstantFromNumericBounds(PhysicalType type) {","+\treturn type != PhysicalType::FLOAT && type != PhysicalType::DOUBLE && type != PhysicalType::INTERVAL;","+}","+} // namespace","+","+unique_ptr<BaseStatistics> StatisticsPropagator::PropagateConstantInputs(ClientContext &context,","+                                                                         const BoundFunctionExpression &func,","+                                                                         const vector<BaseStatistics> &child_stats) {","+\tif (func.Function().GetStability() != FunctionStability::CONSISTENT || func.GetChildren().empty()) {","+\t\treturn nullptr;","+\t}","+\tvector<Value> values;","+\tvalues.reserve(func.GetChildren().size());","+\tfor (idx_t idx = 0; idx < func.GetChildren().size(); ++idx) {","+\t\tauto &child = *func.GetChildren()[idx];","+\t\tauto &stats = child_stats[idx];","+\t\tValue value;","+\t\tif (child.IsFoldable()) {","+\t\t\tif (!ExpressionExecutor::TryEvaluateScalar(context, child, value)) {","+\t\t\t\treturn nullptr;","+\t\t\t}","+\t\t} else if (!stats.CanHaveNoNull()) {","+\t\t\t// Evaluate NULL arguments too.","+\t\t\tvalue = Value(child.GetReturnType());","+\t\t} else if (stats.CanHaveNull()) {","+\t\t\treturn nullptr;","+\t\t} else if (stats.GetStatsType() == StatisticsType::NUMERIC_STATS && NumericStats::HasMinMax(stats)) {","+\t\t\tif (!CanInferConstantFromNumericBounds(stats.GetType().InternalType()) ||","+\t\t\t    NumericStats::Min(stats) != NumericStats::Max(stats)) {","+\t\t\t\treturn nullptr;","+\t\t\t}","+\t\t\tvalue = NumericStats::Min(stats);","+\t\t} else if ((stats.GetType().id() == LogicalTypeId::VARCHAR || stats.GetType().id() == LogicalTypeId::BLOB) &&","+\t\t           StringStats::HasMinMax(stats) && StringStats::GetMinType(stats) == StringStatsType::EXACT_STATS &&","+\t\t           StringStats::GetMaxType(stats) == StringStatsType::EXACT_STATS &&","+\t\t           StringStats::Min(stats) == StringStats::Max(stats)) {","+\t\t\tvalue = Value::BLOB_RAW(StringStats::Min(stats)).WithType(stats.GetType());","+\t\t} else {","+\t\t\treturn nullptr;","+\t\t}","+\t\tvalues.emplace_back(std::move(value));","+\t}","+\tValue result;","+\tif (!TryEvaluateAtConstants(context, func, values, result)) {","+\t\treturn nullptr;","+\t}","+\treturn BaseStatistics::FromConstant(result).ToUnique();","+}","+"," //! Evaluate `func` at the lo/hi corner of each child's value range to derive output min/max."," //! Decreasing args are swapped so f(lo_args) and f(hi_args) bracket the output range."," unique_ptr<BaseStatistics> StatisticsPropagator::PropagateMonotoneBounds(ClientContext &context,","@@ -144,6 +196,10 @@ unique_ptr<BaseStatistics> StatisticsPropagator::PropagateExpression(BoundFuncti"," \t\t\tstats.push_back(stat->Copy());"," \t\t}"," \t}","+\tauto constant_stats = PropagateConstantInputs(context, func, stats);","+\tif (constant_stats) {","+\t\treturn constant_stats;","+\t}"," \tif (func.Function().HasStatisticsCallback()) {"," \t\tFunctionStatisticsInput input(func, func.BindInfo().get(), stats, &expr_ptr);"," \t\treturn func.Function().GetStatisticsCallback()(context, input);"],"additions":58,"deletions":2,"truncated":false},{"path":"src/planner/filter/expression_filter.cpp","lines":["@@ -273,6 +273,11 @@ static optional_ptr<const BaseStatistics> TryGetExpressionStats(optional_ptr<Cli"," \t\t\t\tchild_stats.push_back(child_stat->Copy());"," \t\t\t}"," ","+\t\t\tauto constant_stats = StatisticsPropagator::PropagateConstantInputs(*context_p, func, child_stats);","+\t\t\tif (constant_stats) {","+\t\t\t\towned_stats.push_back(std::move(constant_stats));","+\t\t\t\treturn owned_stats.back().get();","+\t\t\t}"," \t\t\t// Use copy to avoid expression rewritten"," \t\t\tauto expr_copy = func.Copy();"," \t\t\tauto &func_copy = expr_copy->Cast<BoundFunctionExpression>();","@@ -284,7 +289,7 @@ static optional_ptr<const BaseStatistics> TryGetExpressionStats(optional_ptr<Cli"," \t\t// No custom callback: fall back to the declared monotonicity (ArgProperties) and derive output"," \t\t// bounds by evaluating the function at the corners of each argument's range. This lets a"," \t\t// f(col) OP const filter prune row groups via the zonemap of the base column.","-\t\tif (func.Function().HasArgProperties()) {","+\t\tif (func.Function().GetStability() == FunctionStability::CONSISTENT) {"," \t\t\tvector<BaseStatistics> child_stats;"," \t\t\tchild_stats.reserve(func.GetChildren().size());"," \t\t\tfor (auto &child_expr : func.GetChildren()) {","@@ -292,7 +297,10 @@ static optional_ptr<const BaseStatistics> TryGetExpressionStats(optional_ptr<Cli"," \t\t\t\tchild_stats.push_back(child_stat ? child_stat->Copy()"," \t\t\t\t                                 : BaseStatistics::CreateUnknown(child_expr->GetReturnType()));"," \t\t\t}","-\t\t\tauto derived = StatisticsPropagator::PropagateMonotoneBounds(*context_p, func, child_stats);","+\t\t\tauto derived = StatisticsPropagator::PropagateConstantInputs(*context_p, func, child_stats);","+\t\t\tif (!derived) {","+\t\t\t\tderived = StatisticsPropagator::PropagateMonotoneBounds(*context_p, func, child_stats);","+\t\t\t}"," \t\t\tif (derived) {"," \t\t\t\towned_stats.push_back(std::move(derived));"," \t\t\t\treturn owned_stats.back().get();","@@ -574,7 +582,7 @@ static FilterPropagateResult CheckFunctionStatistics(optional_ptr<ClientContext>"," \t\treturn CheckComparisonStatistics(context_p, func_expr, input_stats);"," \t}"," \tif (!func_expr.Function().HasFilterPruneCallback()) {","-\t\tif (func_expr.GetReturnType().id() != LogicalTypeId::BOOLEAN || !func_expr.Function().HasStatisticsCallback()) {","+\t\tif (func_expr.GetReturnType().id() != LogicalTypeId::BOOLEAN) {"," \t\t\treturn FilterPropagateResult::NO_PRUNING_POSSIBLE;"," \t\t}"," \t\tvector<unique_ptr<BaseStatistics>> owned_stats;"],"additions":11,"deletions":3,"truncated":false},{"path":"test/sql/optimizer/constant_function_zonemap_pruning.test","lines":["@@ -0,0 +1,108 @@","+# name: test/sql/optimizer/constant_function_zonemap_pruning.test","+# description: Constant function inputs propagate statistics for row group pruning","+# group: [optimizer]","+","+statement ok","+ATTACH '{TEST_DIR}/constant_function_pruning.duckdb' AS const_db (ROW_GROUP_SIZE 2048);","+","+# RG 1: only 17; RG 2: only 42; RG 3: 17 and NULL; RG 4: values 0 through 63.","+statement ok","+CREATE TABLE const_db.constant_inputs AS","+SELECT CASE WHEN i < 2048 THEN 17 WHEN i < 4096 THEN 42","+            WHEN i < 6144 THEN CASE WHEN i % 2 = 0 THEN 17 END ELSE i % 64 END AS x","+FROM range(8192) t(i);","+","+# No callback: constants produce stats; nullable and varying inputs fail both propagation paths.","+foreach predicate x%100=42 hash(x)=hash(42::BIGINT)","+","+query I","+SELECT count(*) FROM const_db.constant_inputs WHERE {predicate};","+----","+2080","+","+query II","+EXPLAIN ANALYZE SELECT x FROM const_db.constant_inputs WHERE {predicate};","+----","+analyzed_plan\t<REGEX>:.*Row Groups Scanned: 3 / 4.*","+","+endloop","+","+# hash(NULL) is a non-NULL value: min = max = 17 does not describe the NULL rows.","+query I","+SELECT count(*) FROM const_db.constant_inputs WHERE hash(x) = hash(NULL::BIGINT);","+----","+1024","+","+# Equal floating-point bounds do not distinguish signed zeros, but atan2 does.","+statement ok","+CREATE TABLE signed_zeros AS SELECT x FROM (VALUES ('0'::DOUBLE), ('-0'::DOUBLE)) t(x);","+","+query II","+SELECT count(*) FILTER (WHERE atan2(x, -1) < 0), count(*) FILTER (WHERE atan2(x, -1) > 0) FROM signed_zeros;","+----","+1\t1","+","+# RG 1: all NULL; RG 2: alpha; RG 3: beta; RG 4: two strings sharing a truncated 12-byte prefix.","+statement ok","+CREATE TABLE const_db.constant_strings AS","+SELECT CASE WHEN i < 2048 THEN NULL WHEN i < 4096 THEN 'alpha'","+            WHEN i < 6144 THEN 'beta' ELSE 'abcdefghijkl' || (i % 2)::VARCHAR END AS s","+FROM range(8192) t(i);","+","+# regexp_matches exercises direct BOOLEAN pruning without a statistics callback, including unknown stats in RG 4.","+foreach predicate hash(s)=hash('beta') reverse(s)='ateb' hash(s)=hash(NULL::VARCHAR) regexp_matches(s,'(t|z)')","+","+query I","+SELECT count(*) FROM const_db.constant_strings WHERE {predicate};","+----","+2048","+","+query II","+EXPLAIN ANALYZE SELECT s FROM const_db.constant_strings WHERE {predicate};","+----","+analyzed_plan\t<REGEX>:.*Row Groups Scanned: 2 / 4.*","+","+endloop","+","+# With a callback: RGs 1-3 use constant evaluation; RG 4 falls back to string-length statistics.","+query I","+SELECT count(*) FROM const_db.constant_strings WHERE length_grapheme(s) = 4;","+----","+2048","+","+query II","+EXPLAIN ANALYZE SELECT s FROM const_db.constant_strings WHERE length_grapheme(s) = 4;","+----","+analyzed_plan\t<REGEX>:.*Row Groups Scanned: 1 / 4.*","+","+# CONSISTENT_WITHIN_QUERY fails the CONSISTENT guard: no statistics are derived, so every RG is scanned.","+query I","+SELECT count(*) FROM const_db.constant_strings WHERE in_search_path('const_db', s);","+----","+0","+","+query II","+EXPLAIN ANALYZE SELECT s FROM const_db.constant_strings WHERE in_search_path('const_db', s);","+----","+analyzed_plan\t<REGEX>:.*Row Groups Scanned: 4 / 4.*","+","+# Identical inexact bounds must not be treated as a constant input.","+query I","+SELECT count(*) FROM const_db.constant_strings WHERE reverse(s) = '0lkjihgfedcba';","+----","+1024","+","+query II","+EXPLAIN ANALYZE SELECT s FROM const_db.constant_strings WHERE reverse(s) = '0lkjihgfedcba';","+----","+analyzed_plan\t<REGEX>:.*Row Groups Scanned: 1 / 4.*","+","+# Equal intervals can have different month/day components.","+statement ok","+CREATE TABLE equal_intervals AS SELECT x FROM (VALUES (INTERVAL '1 month'), (INTERVAL '30 days')) t(x);","+","+query II","+SELECT count(*) FILTER (WHERE x::VARCHAR = '1 month'),","+       count(*) FILTER (WHERE x::VARCHAR = '30 days') FROM equal_intervals;","+----","+1\t1",""],"additions":108,"deletions":0,"truncated":false}],"additions":181,"deletions":5,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-09-11T13:02:49.064025+00:00"}