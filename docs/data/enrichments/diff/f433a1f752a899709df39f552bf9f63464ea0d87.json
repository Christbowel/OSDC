ted = ({","+      type,","+      pipes: paramPipes,","+    }: ParamProperties) => {","+      if (isString(type)) {","+        return false;","+      }","+      const validationPipes = pipes","+        .concat(paramPipes ?? [])","+        .filter(","+          (pipe): pipe is ValidationPipe => pipe instanceof ValidationPipe,","+        );","+      // `expectedType` is protected: read it the way `transform()` does","+      return (","+        validationPipes.length > 0 &&","+        !validationPipes.some(pipe => pipe['expectedType'])","+      );","+    };","+    if (!paramsProperties.some(isLeftUnvalidated)) {","+      return;","+    }","+    handlersWithoutParamtypes.add(handler);","+    new Logger(ContextUtils.name).warn(","+      MISSING_HANDLER_METADATA_MESSAGE(getClassRef(instance).name, methodName),","+    );","+  }","+","   public getCustomFactory(","     factory: (...args: unknown[]) => void,","     data: unknown,"],"additions":63,"deletions":0,"truncated":false},{"path":"packages/core/helpers/external-context-creator.ts","lines":["@@ -160,6 +160,13 @@ export class ExternalContextCreator {","     const paramsOptions = paramsMetadata","       ? this.contextUtils.mergeParamsMetatypes(paramsMetadata, paramtypes)","       : [];","+    this.contextUtils.warnOnMissingParamtypes(","+      instance,","+      methodName,","+      paramtypes,","+      pipes,","+      paramsOptions,","+    );"," ","     const fnCanActivate = options.guards","       ? this.createGuardsFn(guards, instance, callback, contextType)"],"additions":7,"deletions":0,"truncated":false},{"path":"packages/core/router/router-execution-context.ts","lines":["@@ -154,6 +154,13 @@ export class RouterExecutionContext {","       contextId,","       inquirerId,","     );","+    this.contextUtils.warnOnMissingParamtypes(","+      instance,","+      methodName,","+      paramtypes,","+      pipes,","+      paramsOptions.filter(({ type }) => this.isPipeable(type)),","+    );","     const guards = this.guardsCon