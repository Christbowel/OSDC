pose();","+  });","+","+  it('returns a caller-supplied GPU output tensor', async function () {","+    const ownerSession = await createWebGpuSession(this);","+    const receivingSession = await createWebGpuSession(this, false);","+    const input = new Tensor('float32', [1, 2, 3, 4, 5], [1, 5]);","+    const supplied = (await ownerSession.run({ input })).output;","+","+    const result = await receivingSession.run({ input }, { output: supplied });","+    assert.strictEqual(result.output, supplied);","+","+    await receivingSession.release();","+    await ownerSession.release();","+    supplied.dispose();","+  });","+","+  it('retains GPU input ownership for aliasing outputs', async function () {","+    if (typeof global.gc !== 'function') {","+      this.skip();","+    }","+","+    const producer = await createWebGpuSession(this);","+    const consumer = await createWebGpuSession(this);","+    const input = new Tensor('float32', [1, 2, 3, 4, 5], [1, 5]);","+    let source: Tensor | undefined = (await producer.run({ input })).output;","+    const aliased = (await consumer.run({ input: source })).output;","+    // eslint-disable-next-line no-underscore-dangle","+    assert.strictEqual(binding.__testGpuBuffersAlias(aliased, source), true);","+","+    await producer.release();","+    source = undefined;","+    global.gc!();","+    await new Promise<void>((resolve) => setImmediate(resolve));","+    global.gc!();","+","+    aliased.dispose();","+    await consumer.release();","+  });","+","+  it('retains aliased GPU allocations after explicitly disposing the source', async function () {","+    const producer = await createWebGpuSession(this);","+    const consumer = await createWebGpuSession(this);","+    const input = new Tensor('float32', [1, 2, 3, 4, 5], [1, 5]);","+    const source = (await producer.run({ input })).output;","+    const aliased = (await consumer.run({ input: source })).output;","+    // eslint-disable-next-line no-underscore-dangle","+    assert.strictEqual(binding.__testGpuBuffersAlias(aliased, source), true);","+","+    await producer.release();","+    source.dispose();","+","+    const consumed = (await consumer.run({ input: aliased })).output;","+    consumed.dispose();","+    aliased.dispose();","+    await consumer.release();","+  });","+","+  it('finalizes abandoned GPU outputs', async function () {","+    if (typeof global.gc !== 'function') {","+      this.skip();","+    }","+","+    const webGpuSession = await createWebGpuSession(this);","+    const input = new Tensor('float32', [1, 2, 3, 4, 5], [1, 5]);","+    let output: Tensor | undefined = (await webGpuSession.run({ input })).output;","+    assert.strictEqual(output.location, 'gpu-buffer');","+    await webGpuSession.release();","+    output = undefined;","+    global.gc!();","+    await new Promise<void>((resolve) => setImmediate(resolve));","+    global.gc!();","+  });"," });",""],"additions":102,"deletions":0,"truncated":false}],"additions":273,"deletions":21,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-03T16:49:44.870841+00:00"}