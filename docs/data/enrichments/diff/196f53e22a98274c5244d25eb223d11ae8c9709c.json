{"id":"196f53e22a98274c5244d25eb223d11ae8c9709c","axis":"silent","repo":"aws/aws-sdk-net","sha":"196f53e22a98274c5244d25eb223d11ae8c9709c","parsed":{"files":[{"path":"changelogs/SDK.CHANGELOG.2026.md","lines":["@@ -1,3 +1,19 @@","+### 4.0.303.0 (2026-08-03 18:35 UTC)","+* DirectConnect (4.0.101.0)","+\t* Added route visibility support for AWS Direct Connect, allowing customers to call ListVirtualInterfaceRoutes to view the BGP routes including AS path and BGP communities advertised over their virtual interfaces.","+* EKSAuth (4.0.101.0)","+\t* Added eksNodeName, instanceId, and zone optional parameters to the AssumeRoleForPodIdentity API.","+* MediaConvert (4.0.102.0)","+\t* Updates Kantar server URL validation to accept Fifty5Blue domain. Adds support for output to S3 Glacier Instant Retrieval.","+* NetworkFirewall (4.0.104.0)","+\t* This launch allows customers to use Network Firewall as an explicit Proxy and protect their workloads against threat of data exfiltration.","+* ObservabilityAdmin (4.0.103.0)","+\t* Launch CMK support for Telemetry Enablement Organization and Account Rules.","+* TimestreamInfluxDB (4.0.102.0)","+\t* This release adds support for customer-managed backup restore, and encryption of new DbInstances and DbClusters using customer-managed KMS keys.","+* WAFV2 (4.0.101.1)","+\t* Updated descriptions for number of PreParseTextTransformations allowed per rule statement","+"," ### 4.0.302.0 (2026-07-31 18:13 UTC)"," * BedrockRuntime (4.0.101.0)"," \t* Added support for mid-conversation tool changes in the Amazon Bedrock Converse and ConverseStream APIs"],"additions":16,"deletions":0,"truncated":false},{"path":"changelogs/SDK.CHANGELOG.ALL.md","lines":["@@ -1,3 +1,19 @@","+### 4.0.303.0 (2026-08-03 18:35 UTC)","+* DirectConnect (4.0.101.0)","+\t* Added route visibility support for AWS Direct Connect, allowing customers to call ListVirtualInterfaceRoutes to view the BGP routes including AS path and BGP communities advertised over their virtual interfaces.","+* EKSAuth (4.0.101.0)","+\t* Added eksNodeName, instanceId, and zone optional parameters to the AssumeRoleForPodIdentity API.","+* MediaConvert (4.0.102.0)","+\t* Updates Kantar server URL validation to accept Fifty5Blue domain. Adds support for output to S3 Glacier Instant Retrieval.","+* NetworkFirewall (4.0.104.0)","+\t* This launch allows customers to use Network Firewall as an explicit Proxy and protect their workloads against threat of data exfiltration.","+* ObservabilityAdmin (4.0.103.0)","+\t* Launch CMK support for Telemetry Enablement Organization and Account Rules.","+* TimestreamInfluxDB (4.0.102.0)","+\t* This release adds support for customer-managed backup restore, and encryption of new DbInstances and DbClusters using customer-managed KMS keys.","+* WAFV2 (4.0.101.1)","+\t* Updated descriptions for number of PreParseTextTransformations allowed per rule statement","+"," ### 4.0.302.0 (2026-07-31 18:13 UTC)"," * BedrockRuntime (4.0.101.0)"," \t* Added support for mid-conversation tool changes in the Amazon Bedrock Converse and ConverseStream APIs"],"additions":16,"deletions":0,"truncated":false},{"path":"generator/ServiceModels/_sdk-versions.json","lines":["@@ -1,7 +1,7 @@"," "," {","     \"NewServiceVersion\" : \"4.0.100.0\",","-    \"ProductVersion\"    : \"4.0.302.0\",","+    \"ProductVersion\"    : \"4.0.303.0\",","     \"CoreVersion\"       : \"4.0.100.9\",","     \"OverrideCoreVersion\" : \"4.0\",","     \"DefaultToPreview\"    : false,","@@ -138,7 +138,7 @@","             \"InPreview\"               : false","         },","         \"DirectConnect\"     : {","-            \"Version\" : \"4.0.100.7\",","+            \"Version\" : \"4.0.101.0\",","             \"AssemblyVersionOverride\" : \"4.0\",","             \"Dependencies\"            : {","                 \"Core\" : \"4.0.100.9\"","@@ -860,7 +860,7 @@","             \"InPreview\"               : false","         },","         \"MediaConvert\"                    : {","-         