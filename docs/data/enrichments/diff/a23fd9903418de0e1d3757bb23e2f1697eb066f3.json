c/routes.rs","lines":["@@ -26,12 +26,12 @@ mod world_size;"," "," use std::sync::Arc;"," ","-use axum::extract::DefaultBodyLimit;","-use axum::extract::MatchedPath;","-use axum::http::{Method, StatusCode};","+use axum::extract::{DefaultBodyLimit, MatchedPath, Request};","+use axum::http::{Method, StatusCode, Uri};"," use axum::middleware::{from_fn, from_fn_with_state};"," use axum::routing::{get, post};"," use axum::{Json, Router};","+use tower::ServiceExt as _;"," use tower_http::trace::TraceLayer;"," use tracing::{info, warn};"," ","@@ -300,6 +300,37 @@ fn build_router_with_options(","     router"," }"," ","+/// Also serve every route of `router` under `root_path`, like FastAPI's","+/// `root_path`: with `/llm`, both `/llm/v1/models` and `/v1/models` reach","+/// `/v1/models`.","+///","+/// The prefix is stripped before routing, so every layer sees the bare path.","+/// Like Starlette's `get_route_path`, it only matches up to a path segment","+/// boundary: `/llmx/v1/models` keeps its path.","+pub(crate) fn with_root_path(router: Router, root_path: String) -> Router {","+    Router::new().fallback_service(","+        router.map_request(move |request: Request| strip_root_path(request, &root_path)),","+    )","+}","+","+fn strip_root_path(mut request: Request, root_path: &str) -> Request {","+    let uri = request.uri();","+    let path = match uri.path().strip_prefix(root_path) {","+        Some(\"\") => \"/\",","+        Some(path) if path.starts_with('/') => path,","+        _ => return request,","+    };","+    let path_and_query = match uri.query() {","+        Some(query) => format!(\"{path}?{query}\"),","+        None => path.to_owned(),","+    };","+    let mut parts = uri.clone().into_parts();","+    parts.path_and_query =","+        Some(path_and_query.parse().expect(\"a suffix of a valid path is a valid path\"));","+    *request.uri_mut() = Uri::from_parts(parts).expect(\"only the path changed\");","+    request","+}","+"," #[cfg(test)]"," mod tests;"," "],"additions":34,"deletions":3,"truncated":false},{"path":"rust/src/server/src/routes/tests.rs","lines":["@@ -61,6 +61,7 @@ use zeromq::{DealerSocket, PushSocket, ZmqMessage};"," use super::{","     build_router, build_router_with_dev_mode, build_router_with_dev_mode_and_lora,","     build_router_with_scale_out_endpoints, render::build_router as build_render_router,","+    strip_root_path, with_root_path,"," };"," use crate::config::{","     ApiServerOptions, CorsConfig, DEFAULT_REQUEST_BODY_LIMIT_BYTES, LoraModulePath,","@@ -2113,6 +2114,65 @@ async fn api_key_auth_rejects_missing_token_on_guarded_route() {","     assert_eq!(json, json!({ \"error\": \"Unauthorized\" }));"," }"," ","+/// The root path is stripped up to a path segment boundary, like Starlette's","+/// `get_route_path`, keeping the query.","+#[test]","+fn strip_root_path_keeps_query_and_segment_boundary() {","+    let rewritten = [","+        \"/llm/v1/models?limit=1\",","+        \"/llm/v1/models\",","+        \"/llm\",","+        \"/llmx/v1/models\",","+        \"/v1/models\",","+    ]","+    .map(|uri| {","+        let request = Request::builder().uri(uri).body(Body::empty()).expect(\"build request\");","+        strip_root_path(request, \"/llm\").uri().to_string()","+    });","+    expect_test::expect![[r#\"","+        [","+            \"/v1/models?limit=1\",","+            \"/v1/models\",","+            \"/\",","+            \"/llmx/v1/models\",","+            \"/v1/models\",","+        ]","+    \"#]]","+    .assert_debug_eq(&rewritten);","+}","+","+/// Like FastAPI's `root_path`, routes are served both under the prefix and at","+/// their bare paths, and API-key auth guards the prefixed paths too. The","+/// prefix only matches up to a path segment boundary.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+#[serial]","+async fn root_path_serves_routes_under_prefix_and_at_bare_paths() {","+    let (app, _engine_task) = test_app_with_api_keys(vec![\"secret\".to_string()]).await;","+    let mut app = with_root_path(app, \"/llm\".to_string());","+","+    for (uri, authorization, expected) in [","+        (\"/v1/models\", Some(\"Bearer secret\"), StatusCode::OK),","+        (\"/llm/v1/models\", Some(\"Bearer secret\"), StatusCode::OK),","+        (\"/llm/v1/models\", None, StatusCode::UNAUTHORIZED),","+        (","+            \"/llmx/v1/models\",","+            Some(\"Bearer secret\"),","+            StatusCode::NOT_FOUND,","+        ),","+        (\"/llm\", Some(\"Bearer secret\"), StatusCode::NOT_FOUND),","+    ] {","+        let mut request = Request::builder().uri(uri);","+        if let Some(authorization) = authorization {","+            request = request.header(\"authorization\", authorization);","+        }","+        let response = app","+            .call(request.body(Body::empty()).expect(\"build request\"))","+            .await","+            .expect(\"call app\");","+        assert_eq!(response.status(), expected, \"{uri} {authorization:?}\");","+    }","+}","+"," #[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]"," #[serial]"," async fn api_key_auth_rejects_wrong_token_on_guarded_route() {",""],"additions":60,"deletions":0,"truncated":false}],"additions":156,"deletions":17,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-30T15:55:51.482261+00:00"}