example,","+ * `FILL (status CONSTANT upper('unknown'))` gives","+ * `GapFillColumn('status, Constant('upper('unknown')))`.","+ *","+ * It is an [[Expression]] whose children are the column and the CONSTANT value, like","+ * [[Assignment]], so that plan walkers such as `QueryPlan.expressions` and","+ * `transformExpressions` reach both. A tuple or a plain case class would hide them from the","+ * analyzer.","+ */","+case class GapFillColumn(column: Expression, method: GapFillMethod)","+  extends Expression with Unevaluable {","+  override def children: Seq[Expression] = method match {","+    case GapFillMethod.Constant(value) => Seq(column, value)","+    case _ => Seq(column)","+  }","+  override def nullable: Boolean = false","+  override def dataType: DataType = throw new UnresolvedException(\"dataType\")","+  override protected def withNewChildrenInternal(","+      newChildren: IndexedSeq[Expression]): GapFillColumn = method match {","+    case GapFillMethod.Constant(_) =>","+      copy(column = newChildren.head, method = GapFillMethod.Constant(newChildren(1)))","+    case _ => copy(column = newChildren.head)","+  }","+}","+","+/**","+ * An output column that GAP FILL adds when it is asked for with BIN_START or IS_GENERATED.","+ * `alias` is the name given with AS. `None` requests the default name, `bin_start` or","+ * `is_generated`.","+ */","+case class GapFillOutputColumn(alias: Option[String])","+","+/**","+ * Unresolved counterpart of the GAP FILL relation operator, produced by the parser.","+ * `binStart` and `isGenerated` are set only when the BIN_START or IS_GENERATED column is","+ * requested.","+ */","+case class UnresolvedGapFill(","+    partitionColumns: Seq[Expression],","+    timeColumn: Expression,","+    binWidthExpr: Expression,","+    originExpr: Option[Expression],","+    rangeStartExpr: Option[Expression],","+    rangeEndExpr: Option[Expression],","+    fillColumns: Seq[GapFillColumn],","+    maxGapExpr: Option[Expression],","+    binStart: Option[GapFillOutputColumn],","+    isGenerated: Option[GapFillOutputColumn],","+    child: LogicalPlan) extends UnresolvedUnaryNode {","+  require(rangeStartExpr.isDefined == rangeEndExpr.isDefined,","+    \"The GAP FILL range has both bounds, or neither.\")","+","+  final override val nodePatterns: Seq[TreePattern] = Seq(UNRESOLVED_GAP_FILL)","+","+  override protected def withNewChildInternal(newChild: LogicalPlan): UnresolvedGapFill =","+    copy(child = newChild)","+}","+"," /**","  * A logical plan node for creating a logical limit, which is split into two separate logical nodes:","  * a [[LocalLimit]], which is a partition local limit, followed by a [[GlobalLimit]]."],"additions":74,"deletions":1,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/rules/RuleIdCollection.scala","lines":["@@ -103,6 +103,7 @@ object RuleIdCollection {","       \"org.apache.spark.sql.catalyst.analysis.ResolveCursors\" ::","       \"org.apache.spark.sql.catalyst.analysis.ResolveFetchCursor\" ::","       \"org.apache.spark.sql.catalyst.analysis.ResolveBinBy\" ::","+      \"org.apache.spark.sql.catalyst.analysis.ResolveGapFill\" ::","       \"org.apache.spark.sql.catalyst.analysis.ResolveAsOfJoin\" ::","       \"org.apache.spark.sql.catalyst.analysis.ResolveSetVariable\" ::","       \"org.apache.spark.sql.catalyst.analysis.ResolveTableConstraints\" ::"],"additions":1,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/trees/TreePatterns.scala","lines":["@@ -218,6 +218,7 @@ object TreePattern extends Enumeration  {","   val UNRESOLVED_BIN_BY: Value = Value","   val UNRESOLVED_DEDUPLICATE: Value = Value","   val UNRESOLVED_EVENT_TIME_WATERMARK: Value = Value","+  val UNRESOLVED_GAP_FILL: Value = Value","   val UNRESOLVED_HAVING: Value = Value","   val UNRESOLVED_HINT: Value = Value","   val UNRESOLVED_INSERT: Value = Value"],"additions":1,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/errors/QueryCompilationErrors.scala","lines":["@@ -353,6 +353,12 @@ private[sql] object QueryCompilationErrors extends QueryErrorsBase with Compilat","       messageParameters = Map.empty)","   }"," ","+  def gapFillNotSupportedError(): Throwable = {","+    new AnalysisException(","+      errorClass = \"UNSUPPORTED_FEATURE.GAP_FILL\",","+      messageParameters = Map.empty)","+  }","+","   def restrictedModeFeatureError(feature: String): Throwable = {","     new AnalysisException(","       errorClass = \"UNSUPPORTED_FEATURE.SQL_RESTRICTED_MODE\","],"additions":6,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/main/scala/org/apache/spark/sql/internal/SQLConf.scala","lines":["@@ -6642,6 +6642,18 @@ object SQLConf {","       .booleanConf","       .createWithDefault(false)"," ","+  val GAP_FILL_ENABLED =","+    buildConf(\"spark.sql.gapFillRelationOperator.enabled\")","+      .doc(\"Gate for the GAP FILL relation operator, which is under development. GAP FILL \" +","+        \"queries are rejected whatever the value. When true, the rejection waits until the \" +","+        \"input relation resolves, so errors that leave it unresolved, such as a missing \" +","+        \"table, are reported first.\")","+      .internal()","+      .version(\"4.4.0\")","+      .withBindingPolicy(ConfigBindingPolicy.SESSION)","+      .booleanConf","+      .createWithDefault(false)","+","   object StoreAssignmentPolicy extends Enumeration {","     val ANSI, LEGACY, STRICT = Value","   }"],"additions":12,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/test/scala/org/apache/spark/sql/catalyst/analysis/ResolveGapFillSuite.scala","lines":["@@ -0,0 +1,80 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *    http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+package org.apache.spark.sql.catalyst.analysis","+","+import org.apache.spark.sql.AnalysisException","+import org.apache.spark.sql.catalyst.dsl.expressions._","+import org.apache.spark.sql.catalyst.expressions.Literal","+import org.apache.spark.sql.catalyst.plans.logical.{LocalRelation, LogicalPlan, UnresolvedGapFill}","+import org.apache.spark.sql.internal.SQLConf","+import org.apache.spark.sql.types.DayTimeIntervalType","+","+class ResolveGapFillSuite extends AnalysisTest {","+","+  private def unresolved(child: LogicalPlan): UnresolvedGapFill =","+    UnresolvedGapFill(","+      partitionColumns = Nil,","+      timeColumn = $\"ts\",","+      binWidthExpr = Literal(5L * 60L * 1000000L, DayTimeIntervalType()),","+      originExpr = None,","+      rangeStartExpr = None,","+      rangeEndExpr = None,","+      fillColumns = Nil,","+      maxGapExpr = None,","+      binStart = None,","+      isGenerated = None,","+      child = child)","+","+  private val resolvedInput = LocalRelation($\"ts\".timestampNTZ)","+  private val missingTable = UnresolvedRelation(Seq(\"missing\"))","+","+  private def expectNotSupported(plan: LogicalPlan): Unit =","+    checkError(","+      exception = intercept[AnalysisException](ResolveGapFill.apply(plan)),","+      condition = \"UNSUPPORTED_FEATURE.GAP_FILL\",","+      sqlState = \"0A000\",","+      parameters = Map.empty[String, String])","+","+  test(\"GAP FILL is rejected as not yet supported once its child is resolved\") {","+    withSQLConf(SQLConf.GAP_FILL_ENABLED.key -> \"true\") {","+      val waiting = unresolved(missingTable)","+      // A missing table must still win, so the node is left alone until its child resolves.","+      assert(ResolveGapFill.apply(waiting) == waiting)","+      expectNotSupported(unresolved(resolvedInput))","+    }","+  }","+","+  test(\"GAP FILL is rejected at once when the operator is disabled\") {","+    // The gate does not wait for the child, so a missing table also gets this error.","+    withSQLConf(SQLConf.GAP_FILL_ENABLED.key -> \"false\") {","+      expectNotSupported(unresolved(missingTable))","+      expectNotSupported(unresolved(resolvedInput))","+    }","+  }","+","+  test(\"GAP FILL errors through the full analyzer\") {","+    withSQLConf(SQLConf.GAP_FILL_ENABLED.key -> \"true\") {","+      assertAnalysisErrorCondition(","+        unresolved(missingTable), \"TABLE_OR_VIEW_NOT_FOUND\", Map(\"relationName\" -> \"`missing`\"))","+    }","+    withSQLConf(SQLConf.GAP_FILL_ENABLED.key -> \"false\") {","+      assertAnalysisErrorCondition(","+        unresolved(missingTable), \"UNSUPPORTED_FEATURE.GAP_FILL\", Map.empty)","+    }","+  }","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"sql/catalyst/src/test/scala/org/apache/spark/sql/catalyst/parser/PlanParserSuite.scala","lines":["@@ -19,6 +19,9 @@ package org.apache.spark.sql.catalyst.parser"," "," import scala.annotation.nowarn"," ","+import org.antlr.v4.runtime.{CharStreams, CommonTokenStream}","+import org.antlr.v4.runtime.atn.PredictionMode","+"," import org.apache.spark.SparkThrowable"," import org.apache.spark.sql.AnalysisException"," import org.apache.spark.sql.catalyst.{FunctionIdentifier, TableIdentifier}","@@ -3560,6 +3563,404 @@ class PlanParserSuite extends AnalysisTest {","         |)\"\"\".stripMargin)).size == 1)","   }"," ","+  test(\"GAP FILL: clause parses into the expected UnresolvedGapFill\") {","+    // Minimal clause without PARTITION BY, optional clauses or a table alias.","+    val minimal = singleGapFill(parsePlan(","+      \"\"\"SELECT * FROM metrics GAP FILL (","+        |  ORDER BY ts","+        |  BIN WIDTH INTERVAL '5' MINUTE","+        |)\"\"\".stripMargin))","+    assert(minimal.partitionColumns.isEmpty)","+    assert(minimal.timeColumn == UnresolvedAttribute(Seq(\"ts\")))","+    assert(minimal.binWidthExpr == parseExpression(\"INTERVAL '5' MINUTE\"))","+    assert(minimal.originExpr.isEmpty)","+    assert(minimal.rangeStartExpr.isEmpty && minimal.rangeEndExpr.isEmpty)","+    assert(minimal.fillColumns.isEmpty)","+    assert(minimal.maxGapExpr.isEmpty)","+    assert(minimal.binStart.isEmpty && minimal.isGenerated.isEmpty)","+","+    // Qualified columns and several PARTITION BY columns.","+    val partitioned = singleGapFill(parsePlan(","+      \"\"\"SELECT * FROM t1 GAP FILL (","+        |  PARTITION BY t1.region, t1.device_id","+        |  ORDER BY t1.ts","+        |  BIN WIDTH INTERVAL '5' MINUTE","+        |)\"\"\".stripMargin))","+    assert(partitioned.partitionColumns == Seq(","+      UnresolvedAttribute(Seq(\"t1\", \"region\")),","+      UnresolvedAttribute(Seq(\"t1\", \"device_id\"))))","+    assert(partitioned.timeColumn == UnresolvedAttribute(Seq(\"t1\", \"ts\")))","+  }","+","+  test(\"GAP FILL: every clause and fill method parses, with optional clauses in any order\") {"],"additions":33,"deletions":0,"truncated":false}],"additions":401,"deletions":3,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-17T18:45:48.708046+00:00"}