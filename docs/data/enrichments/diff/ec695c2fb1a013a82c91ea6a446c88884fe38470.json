n, there is no parent compositor, so we're forced into the \"own compositor\" code path, which seems to be non-optimal and pretty ruthless in terms of the release of resources. Electron has no real concept of multiple tabs per window, so it should be okay to disable this ruthless recycling altogether in Electron."," "," diff --git a/content/browser/renderer_host/render_widget_host_view_mac.mm b/content/browser/renderer_host/render_widget_host_view_mac.mm","-index 3fa6f9ba6a9945c22ba659b750a06111c104e479..e8afc0be5af69a5069efe992e40715f3e915706c 100644","+index 716b5d4f51ba7eb28116055df9b6f59aed9c0937..578881071d4824482738ed06e1d3a1a0341c3c7a 100644"," --- a/content/browser/renderer_host/render_widget_host_view_mac.mm"," +++ b/content/browser/renderer_host/render_widget_host_view_mac.mm","-@@ -632,7 +632,11 @@ void SendVisibleTimeRequestToDelegatedFrameHost(","+@@ -635,7 +635,11 @@ void SendVisibleTimeRequestToDelegatedFrameHost(","    }","  ","    host()->WasHidden();"],"additions":2,"deletions":2,"truncated":false},{"path":"patches/chromium/disable_hidden.patch","lines":["@@ -15,7 +15,7 @@ makes it defer main frames until the view is eventually shown. Key the"," decision off the host's visibility, as RenderWidgetHostViewMac does."," "," diff --git a/content/browser/renderer_host/render_widget_host_impl.cc b/content/browser/renderer_host/render_widget_host_impl.cc","-index 9da1a883ab70171621d0de59cbf123c2fa9210e1..e9ff23158cd8db2f8231731f4cb30201f7b0707b 100644","+index b65be82b0100c2bd3a7fe7e670509a96548d94d9..e64462462df8e61a18a384873c415f2b8ab7ce4a 100644"," --- a/content/browser/renderer_host/render_widget_host_impl.cc"," +++ b/content/browser/renderer_host/render_widget_host_impl.cc"," @@ -889,6 +889,10 @@ void RenderWidgetHostImpl::WasHidden() {","@@ -30,10 +30,10 @@ index 9da1a883ab70171621d0de59cbf123c2fa9210e1..e9ff23158cd8db2f8231731f4cb30201","    // Prompts should remain open and functional across tab switches.","    if (!delegate_ || !delegate_->IsWaiti