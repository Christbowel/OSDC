nction isRenewRequired(string $domain, ?string $domainType): bool","+    {","+        return true;","+    }","+","+    public function deleteCertificate(string $domain, ?string $domainType = null): void","+    {","+    }","+}",""],"additions":47,"deletions":0,"truncated":false}],"additions":66,"deletions":2,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-19T17:58:39.650668+00:00"}