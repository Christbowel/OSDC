\"Deserialize shredded VARIANT vectors with a mismatched unshredded layout\", \"[serialization]\") {","+\tauto write_shredded = [&](const LogicalType &child0_type, const LogicalType &child1_type) {","+\t\treturn [=](Serializer &s) {","+\t\t\tauto shredded_type = LogicalType::STRUCT({{\"unshredded\", child0_type}, {\"shredded\", child1_type}});","+\t\t\ts.WriteProperty(90, \"vector_type\", VectorType::SHREDDED_VECTOR);","+\t\t\ts.WriteProperty(91, \"shredded_type\", shredded_type);","+\t\t\t// matches the declared child count, so this doesn't trip the (unrelated) child-count check","+\t\t\ts.WriteObject(92, \"shredded_data\", [&](Serializer &obj) {","+\t\t\t\tWriteFlatHeader(obj);","+\t\t\t\tobj.WriteList(103, \"children\", 2, [&](Serializer::List &list, idx_t i) {","+\t\t\t\t\tlist.WriteObject([&](Serializer &child_obj) {","+\t\t\t\t\t\tWriteFlatHeader(child_obj);","+\t\t\t\t\t\tint32_t value = 42;","+\t\t\t\t\t\tchild_obj.WriteProperty(102, \"data\", const_data_ptr_cast(&value), sizeof(int32_t));","+\t\t\t\t\t});","+\t\t\t\t});","+\t\t\t});","+\t\t};","+\t};","+\t// a shredded_type whose first child isn't the canonical VARIANT struct layout is rejected","+\tREQUIRE_THROWS_AS(","+\t    DeserializeVector(LogicalType::VARIANT(), 1, write_shredded(LogicalType::INTEGER, LogicalType::INTEGER)),","+\t    SerializationException);","+}","+"," TEST_CASE(\"Deserialize STRUCT vectors with too many children\", \"[serialization]\") {"," \tauto type = LogicalType::STRUCT({{\"a\", LogicalType::INTEGER}});"," \tauto write_struct = [&](idx_t child_count) {"],"additions":25,"deletions":0,"truncated":false},{"path":"test/sql/copy/csv/sniff_csv_skip_overflow.test","lines":["@@ -0,0 +1,22 @@","+# name: test/sql/copy/csv/sniff_csv_skip_overflow.test","+# description: sniff_csv reports a skip value beyond the UINTEGER range instead of raising an InternalException that invalidates the database","+# group: [csv]","+","+statement ok","+COPY (SELECT * FROM (VALUES ('Vendor','Test',NULL,NULL),('Start','06/02/2024',NULL,NULL),('A','B','C','D'),('1','2','3','4'),('5','6','7','8'))) TO '{TEST_DIR}/skip_overflow.csv' (FORMAT csv, DELIMITER E'\\t', HEADER false);","+","+# a skip value beyond the UINTEGER range is reported as-is in the UBIGINT SkipRows column","+query I","+SELECT SkipRows FROM sniff_csv('{TEST_DIR}/skip_overflow.csv', skip=9223372036854775807);","+----","+9223372036854775807","+","+# the database is still usable afterwards","+query I","+SELECT 42;","+----","+42","+","+# an in-range skip still sniffs normally","+statement ok","+FROM sniff_csv('{TEST_DIR}/skip_overflow.csv', skip=2);"],"additions":22,"deletions":0,"truncated":false},{"path":"test/sql/copy/parquet/crafted_rowgroup_huge_columns.test","lines":["@@ -0,0 +1,15 @@","+# name: test/sql/copy/parquet/crafted_rowgroup_huge_columns.test","+# description: A row group column list longer than the file is rejected without a huge allocation","+# group: [parquet]","+","+require parquet","+","+statement error","+SELECT * FROM parquet_metadata('{DATA_DIR}/parquet-testing/broken/crafted_rowgroup_huge_columns.parquet');","+----","+<REGEX>:.*(Invalid|Corrupt|limit|exceeds).*","+","+statement error","+SELECT * FROM '{DATA_DIR}/parquet-testing/broken/crafted_rowgroup_huge_columns.parquet';","+----","+<REGEX>:.*(Invalid|Corrupt|limit|exceeds).*"],"additions":15,"deletions":0,"truncated":false},{"path":"test/sql/function/list/lambdas/reduce_try_empty.test","lines":["@@ -0,0 +1,42 @@","+# name: test/sql/function/list/lambdas/reduce_try_empty.test","+# description: TRY suppresses the error of list_reduce on an empty list","+# group: [lambdas]","+","+query I","+SELECT TRY(list_reduce([]::INTEGER[], lambda x, y: x + y));","+----","+NULL","+","+query I","+SELECT TRY(list_reduce([10, 20], lambda x, y: x // 0));","+----","+NULL","+","+statement ok","+CREATE TABLE t AS SELECT i, range(0, (i % 3)) AS lst FROM range(5) t(i);","+","+query II","+SELECT i, TRY(list_reduce(lst, lambda x, y: x + y)) FROM t ORDER BY i;","+----","+0\tNULL","+1\t0","+2\t1","+3\tNULL","+4\t0","+","+# the error is raised without TRY","+statement error","+SELECT list_reduce([]::INTEGER[], lambda x, y: x + y);","+----","+Parameter Not Allowed Error: Cannot perform list_reduce on an empty input list","+","+statement error","+SELECT i, list_reduce(lst, lambda x, y: x + y) FROM t ORDER BY i;","+----","+Parameter Not Allowed Error: Cannot perform list_reduce on an empty input list","+","+# an initial value avoids the error","+query I","+SELECT list_reduce([]::INTEGER[], lambda x, y: x + y, 99);","+----","+99"],"additions":42,"deletions":0,"truncated":false},{"path":"third_party/thrift/thrift/protocol/TCompactProtocol.h","lines":["@@ -163,6 +163,10 @@ class TCompactProtocolT : public TVirtualProtocol<TCompactProtocolT<Transport_>","   inline int8_t getCompactType(const TType ttype);"," "," public:","+  // Tighten the container size limit after construction, e.g. once the caller has learned a smaller","+  // byte budget (such as a sub-message length) than was known when the protocol was created.","+  void setContainerSizeLimit(int32_t container_limit) { container_limit_ = container_limit; }","+","   uint32_t readMessageBegin(std::string& name, TMessageType& messageType, int32_t& seqid);"," ","   uint32_t readStructBegin(std::string& name);",""],"additions":4,"deletions":0,"truncated":false}],"additions":176,"deletions":5,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-10-22T13:47:38.957493+00:00"}