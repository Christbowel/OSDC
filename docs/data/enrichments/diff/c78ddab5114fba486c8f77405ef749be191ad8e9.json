{"id":"c78ddab5114fba486c8f77405ef749be191ad8e9","axis":"silent","repo":"comet-ml/comet-llm","sha":"c78ddab5114fba486c8f77405ef749be191ad8e9","parsed":{"files":[{"path":"apps/opik-backend/config.yml","lines":["@@ -1869,6 +1869,13 @@ attachmentsConfig:","   # Default: 256000 (256KB)","   stripMinSize: ${ATTACHMENTS_STRIP_MIN_SIZE:-256000}"," ","+# Per-organization features the platform switches on (guardrails today), asked for on demand by the endpoints that","+# need them, and only when authentication is enabled.","+workspaceFeatures:","+  # Default: 5s","+  # Description: How long one workspace's answer for a feature is cached in Redis; a feature switched on or off in the platform is seen within it. 0s asks the platform on every call","+  cacheTtl: ${WORKSPACE_FEATURES_CACHE_TTL:-5s}","+"," # Python evaluator configuration"," pythonEvaluator:","   # Default: http://localhost:8000"],"additions":7,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/OpikApplication.java","lines":["@@ -9,6 +9,7 @@"," import com.comet.opik.infrastructure.EncryptionUtils;"," import com.comet.opik.infrastructure.FilterUtils;"," import com.comet.opik.infrastructure.OpikConfiguration;","+import com.comet.opik.infrastructure.WorkspaceFeaturesModule;"," import com.comet.opik.infrastructure.auth.AuthModule;"," import com.comet.opik.infrastructure.aws.AwsModule;"," import com.comet.opik.infrastructure.bi.OpikGuiceyLifecycleEventListener;","@@ -114,7 +115,7 @@ public void initialize(Bootstrap<OpikConfiguration> bootstrap) {","                         new ConfigurationModule(), new CacheModule(), new JobModule(), new AnthropicModule(),","                         new GeminiModule(), new OpenAIModule(), new OpenRouterModule(), new LlmModule(),","                         new AwsModule(), new UsageLimitModule(), new VertexAIModule(), new CustomLlmModule(),","-                        new OllamaModule(), new FreeModelModule(), new ToolsModule())","+                        new OllamaModule(), new FreeModelModule(), new ToolsModule(), new WorkspaceFeaturesModule())","                 .installers(JobGuiceyInstaller.class)","                 .listen(new OpikGuiceyLifecycleEventListener(), new EventListenerRegistrar())","                 .enableAutoConfig()"],"additions":2,"deletions":1,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/LocalWorkspaceFeaturesService.java","lines":["@@ -0,0 +1,18 @@","+package com.comet.opik.domain;","+","+import com.comet.opik.infrastructure.auth.RequestContext;","+import jakarta.ws.rs.core.HttpHeaders;","+import lombok.NonNull;","+","+/**","+ * With authentication disabled there is no platform and no organization to switch a feature on, so every feature","+ * is on and the deployment's own service toggles alone decide.","+ */","+public class LocalWorkspaceFeaturesService implements WorkspaceFeaturesService {","+","+    @Override","+    public boolean isEnabled(@NonNull RequestContext caller, @NonNull HttpHeaders request,","+            @NonNull WorkspaceFeature feature) {","+        return true;","+    }","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/RemoteWorkspaceFeaturesService.java","lines":["@@ -0,0 +1,217 @@","+package com.comet.opik.domain;","+","+import com.comet.opik.infrastructure.AuthenticationConfig;","+import com.comet.opik.infrastructure.RetriableHttpClient;","+import com.comet.opik.infrastructure.auth.RequestContext;","+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;","+import jakarta.ws.rs.ServiceUnavailableException;","+import jakarta.ws.rs.client.Entity;","+import jakarta.ws.rs.client.Invocation;","+import jakarta.ws.rs.core.HttpHeaders;","+import jakarta.ws.rs.core.MediaType;","+import jakarta.ws.rs.core.Response;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import lombok.extern.slf4j.Slf4j;","+import org.apache.commons.lang3.StringUtils;","+import org.redisson.api.RedissonReactiveClient;","+import org.redisson.client.codec.StringCodec;","+import reactor.util.retry.Retry;","+","+import java.net.URI;","+import java.time.Duration;","+import java.util.List;","+import java.util.Map;","+import java.util.Optional;","+import java.util.concurrent.atomic.AtomicLong;","+import java.util.function.Consumer;","+","+/**","+ * Asks the platform's workspace features API on the caller's behalf, with the credential the request carries, and","+ * caches each answer per workspace. Enablement belongs to the workspace's organization, not to the caller, and the","+ * caller's access to the workspace is already settled by the time an endpoint asks.","+ * <p>","+ * The call goes to the same platform as authentication, on a request's path, so it takes the auth hop's timeout and","+ * retries. When the platform still can't answer, the check fails with 503 and nothing is cached: an outage withholds a","+ * feature without claiming the organization lacks it, and the next request asks again. A credential the platform","+ * refuses reads as not enabled for that request only, since the refusal is about the caller, not the workspace.","+ * The cache is best effort: when it cannot answer, or holds a value this service did not write, the platform is asked.","+ */","+@Slf4j","+@RequiredArgsConstructor","+public class RemoteWorkspaceFeaturesService implements WorkspaceFeaturesService {","+","+    record WorkspaceFeaturesRequest(String workspaceName, List<String> features) {","+    }","+","+    @JsonIgnoreProperties(ignoreUnknown = true)","+    record WorkspaceFeaturesResponse(Map<String, Boolean> features) {","+    }","+","+    private static final String CACHE_KEY_FORMAT = \"workspaceFeature-%s-%s\";","+    /** During a Redis incident every check would fail the same way, so only one warning per interval is logged. */","+    private static final Duration CACHE_WARNING_INTERVAL = Duration.ofMinutes(1);","+","+    private final @NonNull RetriableHttpClient client;","+    private final @NonNull AuthenticationConfig.UrlConfig reactServiceUrl;","+    private final @NonNull RedissonReactiveClient redissonClient;","+    private final @NonNull Duration cacheTtl;","+    /** Per attempt; zero leaves the shared client's timeout, as for authentication. */","+    private final @NonNull Duration requestTimeout;","+    private final @NonNull Retry retryPolicy;","+    private final AtomicLong lastCacheWarningNanos = new AtomicLong(","+            System.nanoTime() - CACHE_WARNING_INTERVAL.toNanos());","+","+    /** What the cache holds for a key: an answer, nothing yet, or no answer because Redis failed. */","+    private enum CacheRead {","+        ENABLED,","+        DISABLED,","+        MISS,","+        UNAVAILABLE","+    }","+","+    /** What the platform said: an answer about the workspace, or a refusal of the caller's credential. */","+    private enum PlatformAnswer {","+        ENABLED,","+        NOT_ENABLED,","+        REFUSED","+    }","+","+    /** The platform path to ask and how to put the caller's credential on the request. */","+    private record CredentialedPath(String path, Consumer<Invocation.Builder> credential) {","+    }","+","+    @Override","+    public boolean isEnabled(@NonNull RequestContext caller, @NonNull HttpHeaders request,","+            @NonNull WorkspaceFeature feature) {","+        var credentialedPath = credentialFor(request);","+        if (credentialedPath.isEmpty() || StringUtils.isAnyBlank(caller.getWorkspaceId(), caller.getWorkspaceName())) {","+            return false;","+        }","+","+        var cacheKey = CACHE_KEY_FORMAT.formatted(caller.getWorkspaceId(), feature.getValue());","+        var cached = readCache(cacheKey, caller.getWorkspaceId(), feature);","+        if (cached == CacheRead.ENABLED || cached == CacheRead.DISABLED) {","+            return cached == CacheRead.ENABLED;","+        }","+","+        PlatformAnswer answer;","+        try {","+            answer = lookUp(caller.getWorkspaceName(), credentialedPath.get(), feature);","+        } catch (RuntimeException lookupFailed) {","+            log.warn(\"Could not resolve a workspace feature, answering 503, feature '{}', workspaceId '{}'\",","+                    feature.getValue(), caller.getWorkspaceId(), lookupFailed);","+            throw new ServiceUnavailableException(","+                    \"Could not verify that '%s' is enabled for this workspace, retry later\".formatted(","+                            feature.getValue()));","+        }","+        if (answer == PlatformAnswer.REFUSED) {","+            log.debug(\"The platform refused the caller's credential, feature '{}', workspaceId '{}'\",","+                    feature.getValue(), caller.getWorkspaceId());","+            return false;","+        }","+","+        boolean enabled = answer == PlatformAnswer.ENABLED;","+        // A cache that just failed to answer would fail the write too: skip it, rather than log it twice.","+        if (cached == CacheRead.MISS) {","+            writeCache(cacheKey, enabled, caller.getWorkspaceId(), feature);","+        }","+        return enabled;","+    }","+","+    /** Anything but the two values this service writes is treated as a miss, so the platform is asked again. */","+    private CacheRead readCache(String cacheKey, String workspaceId, WorkspaceFeature feature) {","+        if (cacheTtl.isZero()) {","+            return CacheRead.UNAVAILABLE;","+        }","+        String value;","+        try {","+            value = redissonClient.<String>getBucket(cacheKey, StringCodec.INSTANCE).get().block();","+        } catch (RuntimeException cacheFailed) {","+            logCacheFailure(\"read\", workspaceId, feature, cacheFailed);","+            return CacheRead.UNAVAILABLE;","+        }","+        if (Boolean.TRUE.toString().equals(value)) {","+            return CacheRead.ENABLED;","+        }","+        if (Boolean.FALSE.toString().equals(value)) {","+            return CacheRead.DISABLED;","+        }","+        return CacheRead.MISS;","+    }","+","+    private void writeCache(String cacheKey, boolean enabled, String workspaceId, WorkspaceFeature feature) {","+        try {","+            redissonClient.<String>getBucket(cacheKey, StringCodec.INSTANCE)","+                    .set(Boolean.toString(enabled), cacheTtl)","+                    .block();","+        } catch (RuntimeException cacheFailed) {","+            logCacheFailure(\"write\", workspaceId, feature, cacheFailed);","+        }","+    }","+","+    private void logCacheFailure(String operation, String workspaceId, WorkspaceFeature feature,","+            RuntimeException cacheFailed) {","+        long now = System.nanoTime();","+        long last = lastCacheWarningNanos.get();","+        if (now - last >= CACHE_WARNING_INTERVAL.toNanos() && lastCacheWarningNanos.compareAndSet(last, now)) {","+            log.warn(\"Workspace feature cache failed, the platform answers instead and further cache failures in the \"","+                    + \"next minute log at debug, operation '{}', feature '{}', workspaceId '{}'\",","+                    operation, feature.getValue(), workspaceId, cacheFailed);","+        } else {","+            log.debug(\"Workspace feature cache failed, operation '{}', feature '{}', workspaceId '{}'\",","+                    operation, feature.getValue(), workspaceId, cacheFailed);","+        }","+    }","+","+    private PlatformAnswer lookUp(String workspaceName, CredentialedPath credentialedPath, WorkspaceFeature feature) {","+        return client.executePostWithRetry(RetriableHttpClient.Request.<PlatformAnswer>builder()","+                .requestFunction(jersey -> jersey.target(URI.create(reactServiceUrl.url()))","+                        .path(\"opik\")","+                        .path(credentialedPath.path()))","+                .requestCustomizer(builder -> credentialedPath.credential().accept(","+                        builder.accept(MediaType.APPLICATION_JSON)))","+                .body(Entity.json(new WorkspaceFeaturesRequest(workspaceName, List.of(feature.getValue()))))","+                .retryPolicy(retryPolicy)","+                .readTimeout(requestTimeout.isZero() ? null : requestTimeout)","+                .responseFunction(response -> answer(response, feature))","+                .build())","+                .block();","+    }","+","+    private static PlatformAnswer answer(Response response, WorkspaceFeature feature) {","+        // Only these are about the caller's credential. Any other 4xx (a rate limit, a platform without this endpoint","+        // yet, contract drift) means the platform couldn't tell, so it fails below as an outage does.","+        if (response.getStatus() == Response.Status.UNAUTHORIZED.getStatusCode()","+                || response.getStatus() == Response.Status.FORBIDDEN.getStatusCode()) {","+            return PlatformAnswer.REFUSED;","+        }","+        if (response.getStatusInfo().getFamily() != Response.Status.Family.SUCCESSFUL) {","+            throw new IllegalStateException(","+                    \"the platform answered the workspace features call with status '%d'\"","+                            .formatted(response.getStatus()));","+        }","+        var features = response.readEntity(WorkspaceFeaturesResponse.class).features();","+        return features != null && Boolean.TRUE.equals(features.get(feature.getValue()))","+                ? PlatformAnswer.ENABLED","+                : PlatformAnswer.NOT_ENABLED;","+    }","+","+    /**","+     * Picks the credential the way the platform authenticated the request: the session cookie when there is one,","+     * otherwise the API key. Any other credential is refused by the platform, so the feature reads as not enabled.","+     */","+    private Optional<CredentialedPath> credentialFor(HttpHeaders request) {","+        var session = request.getCookies().get(RequestContext.SESSION_COOKIE);","+        if (session != null) {","+            return Optional.of(new CredentialedPath(\"workspace-features-session\",","+                    builder -> builder.cookie(RequestContext.SESSION_COOKIE, session.getValue())));","+        }","+        var apiKey = request.getHeaderString(HttpHeaders.AUTHORIZATION);","+        if (StringUtils.isBlank(apiKey)) {","+            return Optional.empty();","+        }","+        return Optional.of(new CredentialedPath(\"workspace-features\",","+                builder -> builder.header(HttpHeaders.AUTHORIZATION, apiKey)));","+    }","+}"],"additions":217,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/WorkspaceFeature.java","lines":["@@ -0,0 +1,14 @@","+package com.comet.opik.domain;","+","+import lombok.Getter;","+import lombok.RequiredArgsConstructor;","+","+/** An Opik feature the platform switches on per organization, under the name the platform knows it by. */","+@Getter","+@RequiredArgsConstructor","+public enum WorkspaceFeature {","+","+    GUARDRAILS(\"guardrails\");","+","+    private final String value;","+}"],"additions":14,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/domain/WorkspaceFeaturesService.java","lines":["@@ -0,0 +1,18 @@","+package com.comet.opik.domain;","+","+import com.comet.opik.infrastructure.auth.RequestContext;","+import jakarta.ws.rs.core.HttpHeaders;","+import lombok.NonNull;","+","+/**","+ * Whether a per-organization feature is on for the caller's workspace. Asked by the endpoints that need a feature,","+ * after authentication and apart from it, so a feature costs nothing on the path every request takes.","+ */","+public interface WorkspaceFeaturesService {","+","+    /**","+     * @throws jakarta.ws.rs.ServiceUnavailableException when the platform can't tell, so a request fails with 503","+     *                                                   instead of reading an outage as \"not enabled\"","+     */","+    boolean isEnabled(@NonNull RequestContext caller, @NonNull HttpHeaders request, @NonNull WorkspaceFeature feature);","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/OpikConfiguration.java","lines":["@@ -221,6 +221,9 @@ public class OpikConfiguration extends JobConfiguration {","     @Valid @NotNull @JsonProperty","     private AiLabelsConfig aiLabels = new AiLabelsConfig();"," ","+    @Valid @NotNull @JsonProperty","+    private WorkspaceFeaturesConfig workspaceFeatures = new WorkspaceFeaturesConfig();","+","     @Valid @NotNull @JsonProperty","     private AdminServerConfig adminServer;"," "],"additions":3,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/WorkspaceFeaturesConfig.java","lines":["@@ -0,0 +1,22 @@","+package com.comet.opik.infrastructure;","+","+import com.fasterxml.jackson.annotation.JsonProperty;","+import io.dropwizard.util.Duration;","+import io.dropwizard.validation.MinDuration;","+import jakarta.validation.constraints.NotNull;","+import lombok.Data;","+","+import java.util.concurrent.TimeUnit;","+","+/** Per-organization features the platform switches on, asked for on demand by the endpoints that need them. */","+@Data","+public class WorkspaceFeaturesConfig {","+","+    /**","+     * How long one workspace's answer for a feature is cached. A feature switched on or off in the platform is seen","+     * within it. Zero asks the platform on every call.","+     */","+    @NotNull @JsonProperty","+    @MinDuration(value = 0, unit = TimeUnit.SECONDS)","+    private Duration cacheTtl = Duration.seconds(5);","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/WorkspaceFeaturesModule.java","lines":["@@ -0,0 +1,50 @@","+package com.comet.opik.infrastructure;","+","+import com.comet.opik.domain.LocalWorkspaceFeaturesService;","+import com.comet.opik.domain.RemoteWorkspaceFeaturesService;","+import com.comet.opik.domain.WorkspaceFeaturesService;","+import com.comet.opik.utils.RetryUtils;","+import com.google.common.base.Preconditions;","+import com.google.inject.Provides;","+import jakarta.inject.Singleton;","+import lombok.NonNull;","+import org.apache.commons.lang3.StringUtils;","+import org.redisson.api.RedissonReactiveClient;","+import ru.vyarus.dropwizard.guice.module.support.DropwizardAwareModule;","+import ru.vyarus.dropwizard.guice.module.yaml.bind.Config;","+","+import java.util.Objects;","+","+/**","+ * Picks where per-organization features come from. With authentication off there is no platform, so every feature","+ * is on and the deployment's service toggles decide; with it on, the platform's workspace features API answers.","+ */","+public class WorkspaceFeaturesModule extends DropwizardAwareModule<OpikConfiguration> {","+","+    @Provides","+    @Singleton","+    public WorkspaceFeaturesService workspaceFeaturesService(","+            @Config(\"authentication\") AuthenticationConfig authentication,","+            @Config(\"workspaceFeatures\") WorkspaceFeaturesConfig config,","+            @NonNull RetriableHttpClient retriableHttpClient,","+            @NonNull RedissonReactiveClient redissonClient) {","+","+        if (!authentication.isEnabled()) {","+            return new LocalWorkspaceFeaturesService();","+        }","+","+        Objects.requireNonNull(authentication.getReactService(),","+                \"The property authentication.reactService.url is required when authentication is enabled\");","+","+        Preconditions.checkArgument(StringUtils.isNotBlank(authentication.getReactService().url()),","+                \"The property authentication.reactService.url must not be blank when authentication is enabled\");","+","+        // The same platform as authentication, on a request's path: the auth hop's timeout and retries apply.","+        return new RemoteWorkspaceFeaturesService(retriableHttpClient, authentication.getReactService(),","+                redissonClient, config.getCacheTtl().toJavaDuration(),","+                authentication.getRequestTimeout().toJavaDuration(),","+                RetryUtils.handleHttpErrors(authentication.getRequestMaxRetries(),","+                        authentication.getRequestRetryMinBackoff().toJavaDuration(),","+                        authentication.getRequestRetryMaxBackoff().toJavaDuration()));","+    }","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/test/java/com/comet/opik/domain/RemoteWorkspaceFeaturesServiceTest.java","lines":["@@ -0,0 +1,279 @@","+package com.comet.opik.domain;","+","+import com.comet.opik.api.resources.utils.TestHttpClientUtils;","+import com.comet.opik.api.resources.utils.WireMockUtils;","+import com.comet.opik.infrastructure.AuthenticationConfig;","+import com.comet.opik.infrastructure.RetriableHttpClient;","+import com.comet.opik.infrastructure.auth.RequestContext;","+import com.comet.opik.utils.RetryUtils;","+import jakarta.ws.rs.ServiceUnavailableException;","+import jakarta.ws.rs.core.Cookie;","+import jakarta.ws.rs.core.HttpHeaders;","+import org.junit.jupiter.api.AfterAll;","+import org.junit.jupiter.api.BeforeAll;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.TestInstance;","+import org.junit.jupiter.params.ParameterizedTest;","+import org.junit.jupiter.params.provider.ValueSource;","+import org.mockito.Mockito;","+import org.redisson.api.RBucketReactive;","+import org.redisson.api.RedissonReactiveClient;","+import org.redisson.client.RedisException;","+import org.redisson.client.codec.Codec;","+import org.redisson.client.codec.StringCodec;","+import reactor.core.publisher.Mono;","+","+import java.time.Duration;","+import java.time.Instant;","+import java.util.Map;","+","+import static com.github.tomakehurst.wiremock.client.WireMock.aResponse;","+import static com.github.tomakehurst.wiremock.client.WireMock.containing;","+import static com.github.tomakehurst.wiremock.client.WireMock.equalTo;","+import static com.github.tomakehurst.wiremock.client.WireMock.matchingJsonPath;","+import static com.github.tomakehurst.wiremock.client.WireMock.okJson;","+import static com.github.tomakehurst.wiremock.client.WireMock.post;","+import static com.github.tomakehurst.wiremock.client.WireMock.postRequestedFor;","+import static com.github.tomakehurst.wiremock.client.WireMock.urlPathEqualTo;","+import static com.github.tomakehurst.wiremock.client.WireMock.urlPathMatching;","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.assertj.core.api.Assertions.assertThatThrownBy;","+import static org.mockito.ArgumentMatchers.any;","+import static org.mockito.ArgumentMatchers.anyString;","+import static org.mockito.Mockito.never;","+import static org.mockito.Mockito.verify;","+import static org.mockito.Mockito.when;","+","+@TestInstance(TestInstance.Lifecycle.PER_CLASS)","+class RemoteWorkspaceFeaturesServiceTest {","+","+    private static final String WORKSPACE_NAME = \"team-a\";","+    private static final String ENABLED = \"{\\\"workspaceName\\\":\\\"team-a\\\",\\\"features\\\":{\\\"guardrails\\\":true}}\";","+    // Small versions of the auth hop's 3 s timeout and single retry.","+    private static final Duration REQUEST_TIMEOUT = Duration.ofMillis(300);","+    private static final int MAX_RETRIES = 1;","+","+    private WireMockUtils.WireMockRuntime wireMock;","+    private AuthenticationConfig.UrlConfig platformUrl;","+    private RemoteWorkspaceFeaturesService service;","+","+    @BeforeAll","+    void setUpAll() {","+        wireMock = WireMockUtils.startWireMock();","+        platformUrl = new AuthenticationConfig.UrlConfig(wireMock.runtimeInfo().getHttpBaseUrl());","+        // No cache: every call reaches the platform, so each credential path is observable.","+        service = service(Mockito.mock(RedissonReactiveClient.class), Duration.ZERO);","+    }","+","+    @AfterAll","+    void tearDownAll() {","+        wireMock.server().stop();","+    }","+","+    @BeforeEach","+    void setUp() {","+        wireMock.server().resetAll();","+    }","+","+    @Test","+    void apiKeyCallerIsAskedForWithItsKey() {","+        wireMock.server().stubFor(post(urlPathEqualTo(\"/opik/workspace-features\"))","+                .withHeader(HttpHeaders.AUTHORIZATION, equalTo(\"key-1\"))","+                .withRequestBody(matchingJsonPath(\"$.workspaceName\", equalTo(WORKSPACE_NAME)))","+                .withRequestBody(matchingJsonPath(\"$.features[0]\", equalTo(\"guardrails\")))","+                .willReturn(okJson(ENABLED)));","+","+        assertThat(service.isEnabled(caller(), request(\"key-1\", null), WorkspaceFeature.GUARDRAILS)).isTrue();","+    }","+","+    @Test","+    void sessionCallerIsAskedForWithItsCookie() {","+        wireMock.server().stubFor(post(urlPathEqualTo(\"/opik/workspace-features-session\"))","+                .withHeader(HttpHeaders.COOKIE, containing(RequestContext.SESSION_COOKIE + \"=session-1\"))","+                .willReturn(okJson(ENABLED)));","+","+        assertThat(service.isEnabled(caller(), request(null, \"session-1\"), WorkspaceFeature.GUARDRAILS)).isTrue();","+    }","+","+    @Test","+    void sessionCookieIsPreferredOverAnApiKeyAsAuthenticationPrefersIt() {","+        wireMock.server().stubFor(post(urlPathEqualTo(\"/opik/workspace-features-session\"))","+                .withHeader(HttpHeaders.COOKIE, containing(RequestContext.SESSION_COOKIE + \"=session-1\"))","+                .willReturn(okJson(ENABLED)));","+","+        assertThat(service.isEnabled(caller(), request(\"key-1\", \"session-1\"), WorkspaceFeature.GUARDRAILS))","+                .isTrue();","+        wireMock.server().verify(0, postRequestedFor(urlPathEqualTo(\"/opik/workspace-features\")));","+    }","+","+    @Test","+    void unknownFeatureReadsAsNotEnabled() {","+        wireMock.server().