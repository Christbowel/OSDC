ther table, and the","+            %% name may have passed to another connection since.","+            ConnStats = rabbit_mgmt_db:get_connection(","+                          rabbit_mgmt_util:id(connection, ReqData)),","+            case is_list(ConnStats) andalso","+                 proplists:get_value(pid, ConnStats) =:= proplists:get_value(pid, Conn) of","+                true  -> reply(ConnStats, ReqData, Context);","+                false -> rabbit_mgmt_util:not_found(<<\"Not Found\">>, ReqData, Context)","+            end","     end."," ","-to_json(ReqData, Context) ->","-    ConnStats =","-        case rabbit_mgmt_util:disable_stats(ReqData) of","-            false ->","-                conn_stats(ReqData);","-            true ->","-                rabbit_mgmt_db:get_connection(rabbit_mgmt_util:id(connection, ReqData))","-        end,","+reply(ConnStats, ReqData, Context) ->","     ConnStatsWithoutPids = rabbit_mgmt_format:strip_pids(ConnStats),","-    ReplyData = maps:from_list(ConnStatsWithoutPids),","-    rabbit_mgmt_util:reply(ReplyData, ReqData, Context).","-","-delete_resource(ReqData, Context) ->","-    case conn(ReqData) of","-        not_found -> ok;","-        Conn      ->","-            case proplists:get_value(pid, Conn) of","-                undefined -> ok;","-                Pid when is_pid(Pid) ->","-                    force_close_connection(ReqData, Conn, Pid)","-            end","+    rabbit_mgmt_util:reply(maps:from_list(ConnStatsWithoutPids), ReqData, Context).","+","+delete_resource(ReqData, Context = #context{impl = Conn}) ->","+    case proplists:get_value(pid, Conn) of","+        undefined -> ok;","+        Pid when is_pid(Pid) ->","+            force_close_connection(ReqData, Conn, Pid)","     end,","     {true, ReqData, Context}."," "],"additions":25,"deletions":24,"truncated":false},{"path":"deps/rabbitmq_management/src/rabbit_mgmt_wm_connection_channels.erl","lines":["@@ -23,14 +23,11 @@ variances(Req, Context) ->"," content_types