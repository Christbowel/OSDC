{"id":"a91460ab2f6e3944cd2f8d99c8e2514cfd28eb28","axis":"silent","repo":"apache/struts","sha":"a91460ab2f6e3944cd2f8d99c8e2514cfd28eb28","parsed":{"files":[{"path":"core/src/main/resources/org/apache/struts2/static/inputtransferselect.js","lines":["@@ -133,3 +133,46 @@ function swapOptions(objTargetElement, first, second) {","     opt[first] = temp2;","     opt[second] = temp;"," }","+","+/*","+ * Buttons rendered by the inputtransferselect tag carry their action and target select id in data-* attributes","+ * instead of inline onclick handlers, so the tag works under a Content-Security-Policy without 'unsafe-inline':","+ *   data-struts-inputtransferselect=\"add|remove|removeAll|moveUp|moveDown\", data-struts-target, optional","+ *   data-struts-header-key","+ * The listener is registered once per page, in the capture phase, so it is not stopped by an ancestor's","+ * stopPropagation().","+ */","+(function () {","+    if (window.strutsInputTransferSelectListener) {","+        return;","+    }","+    window.strutsInputTransferSelectListener = true;","+","+    document.addEventListener('click', function (event) {","+        var button = event.target;","+        if (!button || !button.getAttribute) {","+            return;","+        }","+        var action = button.getAttribute('data-struts-inputtransferselect');","+        if (!action) {","+            return;","+        }","+        var targetId = button.getAttribute('data-struts-target');","+        var target = document.getElementById(targetId);","+        if (!target) {","+            return;","+        }","+        var headerKey = button.getAttribute('data-struts-header-key') || '';","+        if (action === 'add') {","+            addOption(document.getElementById(targetId + '_input'), target);","+        } else if (action === 'remove') {","+            removeOptions(target);","+        } else if (action === 'removeAll') {","+            removeAllOptions(target);","+        } else if (action === 'moveUp') {","+            moveOptionUp(target, 'key', headerKey);","+        } else if (action === 'moveDown') {","+            moveOptionDown(target, 'key', headerKey);","+        }","+    }, true);","+})();"],"additions":43,"deletions":0,"truncated":false},{"path":"core/src/main/resources/org/apache/struts2/static/optiontransferselect.js","lines":["@@ -189,3 +189,96 @@ function swapOptions(objTargetElement, first, second) {","     opt[first] = temp2;","     opt[second] = temp;"," }","+","+/*","+ * Buttons rendered by the optiontransferselect and updownselect tags carry their action, target select ids and header","+ * keys in data-* attributes instead of inline onclick handlers, so the tags work under a Content-Security-Policy","+ * without 'unsafe-inline':","+ *   data-struts-updownselect=\"moveUp|moveDown|selectAll\", data-struts-target, optional data-struts-header-key","+ *   data-struts-optiontransferselect=\"leftUp|leftDown|rightUp|rightDown|addToLeft|addToRight|addAllToLeft|","+ *     addAllToRight|selectAll\", data-struts-left, data-struts-right, optional data-struts-header-key and","+ *     data-struts-double-header-key","+ * The listener is registered once per page, in the capture phase, so the framework action still runs before a","+ * developer-supplied onclick attribute on the same button and is not stopped by an ancestor's stopPropagation().","+ */","+(function () {","+    if (window.strutsOptionTransferSelectListener) {","+        return;","+    }","+    window.strutsOptionTransferSelectListener = true;","+","+    function headerKey(button, name) {","+        return button.hasAttribute(name) ? button.getAttribute(name) : undefined;","+    }","+","+    function selectAll(target, key) {","+        if (key === undefined) {","+            selectAllOptions(target);","+        } else {","+            selectAllOptionsExceptSome(target, 'key', key);","+        }","+    }","+","+    function transfer(move, source, target, key) {","+        if (key === undefined) {","+            move(source, target, false, '');","+        } else {","+            move(source, target, false, key, '');","+        }","+    }","+","+    function updownselect(button, action) {","+        var target = document.getElementById(button.getAttribute('data-struts-target'));","+        var key = headerKey(button, 'data-struts-header-key');","+        if (action === 'moveUp') {","+            moveOptionUp(target, 'key', key === undefined ? '' : key);","+        } else if (action === 'moveDown') {","+            moveOptionDown(target, 'key', key === undefined ? '' : key);","+        } else if (action === 'selectAll') {","+            selectAll(target, key);","+        }","+    }","+","+    function optiontransferselect(button, action) {","+        var left = document.getElementById(button.getAttribute('data-struts-left'));","+        var right = document.getElementById(button.getAttribute('data-struts-right'));","+        var leftKey = headerKey(button, 'data-struts-header-key');","+        var rightKey = headerKey(button, 'data-struts-double-header-key');","+        if (action === 'leftDown') {","+            moveOptionDown(left, 'key', leftKey === undefined ? '' : leftKey);","+        } else if (action === 'leftUp') {","+            moveOptionUp(left, 'key', leftKey === undefined ? '' : leftKey);","+        } else if (action === 'rightDown') {","+            moveOptionDown(right, 'key', rightKey === undefined ? '' : rightKey);","+        } else if (action === 'rightUp') {","+            moveOptionUp(right, 'key', rightKey === undefined ? '' : rightKey);","+        } else if (action === 'addToLeft') {","+            transfer(moveSelectedOptions, right, left, rightKey);","+        } else if (action === 'addToRight') {","+            transfer(moveSelectedOptions, left, right, leftKey);","+        } else if (action === 'addAllToLeft') {","+            transfer(moveAllOptions, right, left, rightKey);","+        } else if (action === 'addAllToRight') {","+            transfer(moveAllOptions, left, right, leftKey);","+        } else if (action === 'selectAll') {","+            selectAll(left, leftKey);","+            selectAll(right, rightKey);","+        }","+    }","+","+    document.addEventListener('click', function (event) {","+        var button = event.target;","+        if (!button || !button.getAttribute) {","+            return;","+        }","+        var action = button.getAttribute('data-struts-updownselect');","+        if (action) {","+            updownselect(button, action);","+            return;","+        }","+        action = button.getAttribute('data-struts-optiontransferselect');","+        if (action) {","+            optiontransferselect(button, action);","+        }","+    }, true);","+})();"],"additions":93,"deletions":0,"truncated":false},{"path":"core/src/main/resources/template/html5/combobox.ftl","lines":["@@ -37,7 +37,7 @@ function autoPopulate_${attributes.escapedId}(targetElement) {"," "," <#include \"/${attributes.templateDir}/${attributes.expandTheme}/controlheader.ftl\" />"," <#if attributes.list??>","-<select onChange=\"autoPopulate_${attributes.escapedId}(this);\"<#rt/>","+<select data-struts-combobox=\"${attributes.escapedId}\"<#rt/>","  <#include \"/${attributes.templateDir}/${attributes.expandTheme}/css.ftl\" /><#rt/>"," <#if attributes.disabled!false>","  disabled=\"disabled\"<#rt/>","@@ -97,5 +97,18 @@ function autoPopulate_${attributes.escapedId}(targetElement) {"," >${tmpListValue}</option><#rt/>"," </@s.iterator>"," </select><#rt/>","+<@s.script>","+\t(function () {","+\t\tvar selects = document.querySelectorAll('select[data-struts-combobox=\"${attributes.escapedId}\"]');","+\t\tfor (var i = 0; i < selects.length; i++) {","+\t\t\tif (!selects[i].strutsComboboxBound) {","+\t\t\t\tselects[i].strutsComboboxBound = true;","+\t\t\t\tselects[i].addEventListener('change', function () {","+\t\t\t\t\tautoPopulate_${attributes.escapedId}(this);","+\t\t\t\t});","+\t\t\t}","+\t\t}","+\t})();","+</