@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Validator\\Mapping\\Factory;","+","+use Symfony\\Component\\Validator\\Mapping\\MetadataInterface;","+","+/**","+ * Keeps the metadata returned by the decorated factory in memory for all the instances created with the same key.","+ *","+ * @author Nicolas Grekas <p@tchwork.com>","+ *","+ * @internal","+ */","+final class SharedMetadataFactory implements MetadataFactoryInterface","+{","+    /**","+     * @var array<string, array<string, MetadataInterface>>","+     */","+    private static array $loaded = [];","+","+    public function __construct(","+        private readonly MetadataFactoryInterface $decorated,","+        private readonly string $key,","+    ) {","+    }","+","+    public function getMetadataFor(mixed $value): MetadataInterface","+    {","+        if (\\is_object($value)) {","+            $class = $value::class;","+        } elseif (\\is_string($value)) {","+            $class = ltrim($value, '\\\\');","+        } else {","+            return $this->decorated->getMetadataFor($value);","+        }","+","+        return self::$loaded[$this->key][$class] ??= $this->decorated->getMetadataFor($value);","+    }","+","+    public function hasMetadataFor(mixed $value): bool","+    {","+        return $this->decorated->hasMetadataFor($value);","+    }","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Validator/Tests/Mapping/Factory/SharedMetadataFactoryTest.php","lines":["@@ -0,0 +1,77 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Validator\\Tests\\Mapping\\Factory;","+","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\Validator\\Mapping\\ClassMetadata;","+use Symfony\\Component\\Validator\\Mapping\\Factory\\MetadataFactoryInterface;","+use Symfony\\Component\\Validator\\Mapping\\Factory\\SharedMetadataFactory;","+use Symfony\\Component\\Validator\\Tests\\Fixtures\\NestedAttribute\\Entity;","+","+class SharedMetadataFactoryTest extends TestCase","+{","+    public function testInstancesCreatedWithTheSameKeyShareTheMetadataTheyLoad()","+    {","+        $metadata = new ClassMetadata(Entity::class);","+","+        $decorated = $this->createMock(MetadataFactoryInterface::class);","+        $decorated","+            ->expects($this->once())","+            ->method('getMetadataFor')","+            ->with(Entity::class)","+            ->willReturn($metadata);","+","+        $this->assertSame($metadata, (new SharedMetadataFactory($decorated, __METHOD__))->getMetadataFor(Entity::class));","+        $this->assertSame($metadata, (new SharedMetadataFactory($decorated, __METHOD__))->getMetadataFor(new Entity()));","+        $this->assertSame($metadata, (new SharedMetadataFactory($decorated, __METHOD__))->getMetadataFor('\\\\'.Entity::class));","+    }","+","+    public function testInstancesCreatedWithDifferentKeysDoNotShare()","+    {","+        $decorated = $this->createMock(MetadataFactoryInterface::class);","+        $decorated","+            ->expects($this->exactly(2))","+            ->method('getMetadataFor')","+            ->willReturnCallback(static fn () => new ClassMetadata(Entity::class));","+","+        $metadata = (new SharedMetadataFactory($decorated, __METHOD__.'1'))->getMetadataFor(Entity::class);","+","+        $this->assertNotSame($metadata, (new SharedMetadataFactory($decorated, __METHOD__.'2'))->getMetadataFor(Entity::class));","+    }","+","+    public function testValuesThatAreNotClassesPassThrough()","+    {","+        $decorated = $this->createMock(MetadataFactoryInterface::class);","+        $decorated","+            ->expects($this->exactly(2))","+            ->method('getMetadataFor')","+            ->with(123)","+            ->willReturnCallback(static fn () => new ClassMetadata(Entity::class));","+","+        $metadata = (new SharedMetadataFactory($decorated, __METHOD__))->getMetadataFor(123);","+","+        $this->assertNotSame($metadata, (new SharedMetadataFactory($decorated, __METHOD__))->getMetadataFor(123));","+    }","+","+    public function testHasMetadataForIsDelegated()","+    {","+        $decorated = $this->createMock(MetadataFactoryInterface::class);","+        $decorated","+            ->expects($this->exactly(2))","+            ->method('hasMetadataFor')","+            ->with(Entity::class)","+            ->willReturn(true);","+","+        $this->assertTrue((new SharedMetadataFactory($decorated, __METHOD__))->hasMetadataFor(Entity::class));","+        $this->assertTrue((new SharedMetadataFactory($decorated, __METHOD__))->hasMetadataFor(Entity::class));","+    }","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Validator/Tests/ValidationBundleTest.php","lines":["@@ -22,6 +22,7 @@"," use Symfony\\Component\\DependencyInjection\\Compiler\\RemoveMissingDependenciesPass as ContainerRemoveMissingDependenciesPass;"," use Symfony\\Component\\DependencyInjection\\ContainerBuilder;"," use Symfony\\Component\\DependencyInjection\\Extension\\Extension;","+use Symfony\\Component\\DependencyInjection\\Parameter;"," use Symfony\\Component\\DependencyInjection\\ParameterBag\\EnvPlaceholderParameterBag;"," use Symfony\\Component\\DependencyInjection\\Reference;"," use Symfony\\Component\\PropertyInfo\\PropertyInfoExtractor;","@@ -67,7 +68,9 @@ public function testValidatorBuilderCalls()","         $this->assertSame(['loadValidatorMetadata'], $calls[5][1]);","         $this->assertSame('setMappingCache', $calls[6][0]);","     