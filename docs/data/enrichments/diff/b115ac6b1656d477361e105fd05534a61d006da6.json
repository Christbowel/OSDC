"+","+        if (self::listOpenFiles((int) getmypid()) === null) {","+            self::markTestSkipped('Neither /proc nor lsof is available to see the files the writer has open');","+        }","+","+        $deadline = microtime(true) + 10.0;","+        while (!in_array($real_path, self::listOpenFiles($pid) ?? [], true)) {","+            $this->assertTrue(proc_get_status($process)['running'], 'the writer exited before opening the header');","+            $this->assertLessThan($deadline, microtime(true), 'the writer never opened the header');","+            usleep(2_000);","+        }","+    }","+","+    /**","+     * @return list<string>|null the paths a process has open, null if this system cannot tell","+     */","+    private static function listOpenFiles(int $pid): ?array","+    {","+        $paths = [];","+","+        if (is_dir('/proc/self/fd')) {","+            // a process that has exited has no directory to list","+            $entries = @scandir(\"/proc/$pid/fd\");","+            foreach ($entries === false ? [] : $entries as $entry) {","+                $target = @readlink(\"/proc/$pid/fd/$entry\");","+                if ($target !== false) {","+                    $paths[] = $target;","+                }","+            }","+","+            return $paths;","+        }","+","+        $pipes = [];","+        $lsof = proc_open(","+            ['lsof', '-p', (string) $pid, '-Fn'],","+            [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['file', '/dev/null', 'w']],","+            $pipes,","+        );","+        if ($lsof === false) {","+            return null;","+        }","+","+        $output = stream_get_contents($pipes[1]);","+        fclose($pipes[1]);","+        $exit_code = proc_close($lsof);","+","+        // lsof exits with 1 when it finds nothing, as for a process that has exited","+        if ($output === false || ($exit_code !== 0 && $exit_code !== 1)) {","+            return null;","+        }","+","+        // -Fn prints o