,"+#include \"duckdb/planner/expression/bound_columnref_expression.hpp\"","+#include \"duckdb/planner/expression/bound_function_expression.hpp\"","+#include \"duckdb/planner/expression/expression_barrier.hpp\"","+#include \"duckdb/planner/expression_iterator.hpp\"","+#include \"duckdb/planner/logical_operator_visitor.hpp\"","+#include \"duckdb/planner/operator/logical_aggregate.hpp\"","+#include \"duckdb/planner/operator/logical_comparison_join.hpp\"","+#include \"duckdb/planner/operator/logical_cteref.hpp\"","+#include \"duckdb/planner/operator/logical_distinct.hpp\"","+#include \"duckdb/planner/operator/logical_projection.hpp\"","+","+namespace duckdb {","+","+CTEJoinFilterCollector::CTEJoinFilterCollector(const unordered_map<TableIndex, TableIndex> &targets)","+    : join_targets(targets) {","+}","+","+vector<CTEJoinFilter> CTEJoinFilterCollector::Collect(LogicalOperator &op,","+                                                      const unordered_map<TableIndex, TableIndex> &targets) {","+\tCTEJoinFilterCollector collector(targets);","+\tcollector.VisitOperator(op);","+\treturn std::move(collector.join_filters);","+}","+","+static bool CanPassCTEJoinFilter(LogicalOperator &op) {","+\tbool safe = true;","+\tLogicalOperatorVisitor::EnumerateExpressions(op, [&](unique_ptr<Expression> *expr) {","+\t\tsafe &= !(*expr)->IsVolatile() && !(*expr)->CanThrow() && !ExpressionBarrier::Contains(**expr);","+\t\tExpressionIterator::VisitExpression<BoundFunctionExpression>(","+\t\t    **expr, [&](const BoundFunctionExpression &func) { safe &= !func.Function().RequiresOrderedExecution(); });","+\t});","+\treturn safe;","+}","+","+static bool ContainsCTEJoinKeys(LogicalOperator &op, const vector<ColumnBinding> &keys) {","+\tauto bindings = op.GetColumnBindings();","+\tfor (auto &key : keys) {","+\t\tif (std::find(bindings.begin(), bindings.end(), key) == bindings.end()) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+","+static bool MapCTEJoinProjection(LogicalProjection &projection, vector<ColumnBinding> &keys) {","+\tfor (auto &key : keys) {","+\t\tif (key.table_index != projection.table_index) {","+\t\t\treturn false;","+\t\t}","+\t\tauto &expr = projection.GetExpression(key);","+\t\tif (expr.GetExpressionClass() != ExpressionClass::BOUND_COLUMN_REF) {","+\t\t\treturn false;","+\t\t}","+\t\tkey = expr.Cast<BoundColumnRefExpression>().Binding();","+\t}","+\treturn true;","+}","+","+static optional_ptr<LogicalCTERef> FindCTEJoinSource(LogicalOperator &op, vector<ColumnBinding> &keys) {","+\tif (!ContainsCTEJoinKeys(op, keys)) {","+\t\treturn nullptr;","+\t}","+\tswitch (op.type) {","+\tcase LogicalOperatorType::LOGICAL_CTE_REF: {","+\t\tauto &ref = op.Cast<LogicalCTERef>();","+\t\treturn ref.is_recurring ? nullptr : &ref;","+\t}","+\tcase LogicalOperatorType::LOGICAL_PROJECTION:","+\t\tif (!MapCTEJoinProjection(op.Cast<LogicalProjection>(), keys)) {","+\t\t\treturn nullptr;","+\t\t}","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_FILTER:","+\t\tbreak;","+\tdefault:","+\t\treturn nullptr;","+\t}","+\treturn FindCTEJoinSource(*op.children[0], keys);","+}","+","+void CTEJoinFilterCollector::VisitOperator(LogicalOperator &op) {","+\tfor (auto &child : op.children) {","+\t\tVisitOperator(*child);","+\t}","+\tif (op.type != LogicalOperatorType::LOGICAL_COMPARISON_JOIN ||","+\t    op.Cast<LogicalComparisonJoin>().join_type != JoinType::INNER || !CanPassCTEJoinFilter(op)) {","+\t\treturn;","+\t}","+\tauto &join = op.Cast<LogicalComparisonJoin>();","+\tvector<ColumnBinding> left_keys, right_keys;","+\tvector<ExpressionType> comparisons;","+\tfor (auto &condition : join.conditions) {","+\t\tif (!condition.IsComparison() ||","+\t\t    (condition.GetComparisonType() != ExpressionType::COMPARE_EQUAL &&","+\t\t     condition.GetComparisonType() != ExpressionType::COMPARE_NOT_DISTINCT_FROM) ||","+\t\t    condition.GetLHS().GetExpressionClass() != ExpressionClass::BOUND_COLUMN_REF ||","+\t\t    condition.GetRHS().GetExpressionClass() != ExpressionClass::BOUND_COLUMN_REF) {","+\t\t\tcontinue;","+\t\t}","+\t\tleft_keys.push_back(condition.GetLHS().Cast<BoundColumnRefExpression>().Binding());","+\t\tright_keys.push_back(condition.GetRHS().Cast<BoundColumnRefExpression>().Binding());","+\t\tcomparisons.push_back(condition.GetComparisonType());","+\t}","+\tif (comparisons.empty()) {","+\t\treturn;","+\t}","+\tfor (idx_t side = 0; side < 2; side++) {","+\t\tauto source_keys = side == 0 ? left_keys : right_keys;","+\t\tauto source = FindCTEJoinSource(*op.children[side], source_keys);","+\t\tif (source) {","+\t\t\tPushFilter(*op.children[1 - side], *source, source_keys, side == 0 ? right_keys : left_keys, comparisons);","+\t\t}","+\t}","+}","+","+void CTEJoinFilterCollector::PushFilter(LogicalOperator &op, const LogicalCTERef &source,","+                                        const vector<ColumnBinding> &source_keys, vector<ColumnBinding> target_keys,","+                                        const vector<ExpressionType> &comparisons) {","+\tif (!ContainsCTEJoinKeys(op, target_keys) || !CanPassCTEJoinFilter(op)) {","+\t\treturn;","+\t}","+\tswitch (op.type) {","+\tcase LogicalOperatorType::LOGICAL_CTE_REF:","+\t\tAddFilter(source, op.Cast<LogicalCTERef>(), source_keys, target_keys, comparisons);","+\t\treturn;","+\tcase LogicalOperatorType::LOGICAL_MATERIALIZED_CTE:","+\t\tPushFilter(*op.children[1], source, source_keys, std::move(target_keys), comparisons);","+\t\treturn;","+\tcase LogicalOperatorType::LOGICAL_PROJECTION:","+\t\tif (!MapCTEJoinProjection(op.Cast<LogicalProjection>(), target_keys)) {","+\t\t\treturn;","+\t\t}","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_FILTER:","+\tcase LogicalOperatorType::LOGICAL_ORDER_BY:","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_DISTINCT:","+\t\tif (op.Cast<LogicalDistinct>().distinct_type != DistinctType::DISTINCT) {","+\t\t\treturn;","+\t\t}","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY: {","+\t\tauto &aggregate = op.Cast<LogicalAggregate>();","+\t\tfor (auto &key : target_keys) {","+\t\t\tif (key.table_index != aggregate.group_index) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tfor (auto &grouping_set : aggregate.grouping_sets) {","+\t\t\t\tif (!grouping_set.count(key.column_index)) {","+\t\t\t\t\treturn;","+\t\t\t\t}","+\t\t\t}","+\t\t\tauto &group = aggregate.GetGroupExpression(key.column_index);","+\t\t\tif (group.GetExpressionClass() != ExpressionClass::BOUND_COLUMN_REF) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tkey = group.Cast<BoundColumnRefExpression>().Binding();","+\t\t}","+\t\tbreak;","+\t}","+\tcase LogicalOperatorType::LOGICAL_UNION: {","+\t\tauto bindings = op.GetColumnBindings();","+\t\tfor (auto &child : op.children) {","+\t\t\tauto child_bindings = child->GetColumnBindings();","+\t\t\tauto child_keys = target_keys;","+\t\t\tfor (auto &key : child_keys) {","+\t\t\t\tauto position = std::find(bindings.begin(), bindings.end(), key) - bindings.begin();","+\t\t\t\tkey = child_bindings[position];","+\t\t\t}","+\t\t\tPushFilter(*child, source, source_keys, std::move(child_keys), comparisons);","+\t\t}","+\t\treturn;","+\t}","+\tcase LogicalOperatorType::LOGICAL_COMPARISON_JOIN: {","+\t\tauto &join = op.Cast<LogicalComparisonJoin>();","+\t\tif (join.join_type != JoinType::INNER && join.join_type != JoinType::LEFT && join.join_type != JoinType::SEMI &&","+\t\t    join.join_type != JoinType::ANTI && join.join_type != JoinType::MARK) {","+\t\t\treturn;","+\t\t}","+\t\tif (ContainsCTEJoinKeys(*op.children[0], target_keys)) {","+\t\t\tPushFilter(*op.children[0], source, source_keys, target_keys, comparisons);","+\t\t}","+\t\tif (join.join_type == JoinType::INNER && ContainsCTEJoinKeys(*op.children[1], target_keys)) {","+\t\t\tPushFilter(*op.children[1], source, source_keys, std::move(target_keys), comparisons);","+\t\t}","+\t\treturn;","+\t}","+\tdefault:","+\t\treturn;","+\t}","+\tPushFilter(*op.children[0], source, source_keys, std::move(target_keys), comparisons);","+}","+","+void CTEJoinFilterCollector::AddFilter(const LogicalCTERef &source, const LogicalCTERef &target,","+                                       const vector<ColumnBinding> &source_keys,","+                                       const vector<ColumnBinding> &target_keys,","+                                       const vector<ExpressionType> &comparisons) {","+\tD_ASSERT(!comparisons.empty() && source_keys.size() == comparisons.size() &&","+\t         target_keys.size() == comparisons.size());","+\tauto target_entry = join_targets.find(target.cte_index);","+\tif (source.is_recurring || target.is_recurring || source.cte_index == target.cte_index ||","+\t    target_entry == join_targets.end() || target_entry->second != target.table_index) {","+\t\treturn;","+\t}","+\tCTEJoinFilter filter;","+\tfilter.source = source.cte_index;","+\tfilter.target = target.cte_index;","+\tfilter.target_scan = target.table_index;","+\tfilter.comparisons = comparisons;","+\tfor (idx_t i = 0; i < comparisons.size(); i++) {","+\t\tD_ASSERT(source_keys[i].table_index == source.table_index);","+\t\tD_ASSERT(target_keys[i].table_index == target.table_index);","+\t\tfilter.source_columns.push_back(source_keys[i].column_index);","+\t\tfilter.target_columns.push_back(target_keys[i].column_index);","+\t}","+\tfor (auto &existing : join_filters) {","+\t\tif (existing.source == filter.source && existing.target == filter.target &&","+\t\t    existing.target_scan == filter.target_scan && existing.source_columns == filter.source_columns &&","+\t\t    existing.target_columns == filter.target_columns && existing.comparisons == filter.comparisons) {","+\t\t\treturn;","+\t\t}","+\t}","+\tjoin_filters.push_back(std::move(filter));","+}","+","+} // namespace duckdb"],"additions":227,"deletions":0,"truncated":false},{"path":"src/optimizer/cte_join_filter_pusher.cpp","lines":["@@ -0,0 +1,178 @@","+#include \"duckdb/optimizer/cte_join_filter_pusher.hpp\"","+#include \"duckdb/optimizer/cte_join_filter_collector.