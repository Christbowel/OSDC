is.isLimited()) {","+      return prepare();","+    }","+    return this.deps.transaction(async (transaction) => {","+      const counterValue = await this.getAndLockInviteEmailCounter(transaction);","+      const options = { transacting: transaction };","+      if (this.deps.limitService.isLimited('inviteEmails')) {","+        await this.reserveEmail(transaction, counterValue);","+      }","+      // Replacing a pending invitation does not occupy another seat, even after an import.","+      if (this.deps.limitService.isLimited('allStaff')) {","+        const existingInvite = await transaction('invites')","+          .where('email', email.trim())","+          .forUpdate()","+          .first('id');","+        if (!existingInvite) {","+          await this.deps.limitService.errorIfWouldGoOverLimit('allStaff', options);","+        }","+      }","+      return prepare(transaction);","+    });","+  }","+","+  private async getAndLockInviteEmailCounter(","+    transaction: Knex.Transaction,","+  ): Promise<string | null> {","+    const setting = await this.deps.Settings.findOne(","+      { key: INVITE_EMAIL_COUNTER_KEY },","+      { transacting: transaction, forUpdate: true },","+    );","+    if (!setting) {","+      throw new errors.InternalServerError({","+        message: 'Cannot lock the staff invitation email counter.',","+      });","+    }","+    return setting.get('value') as string | null;","+  }","+","+  private async reserveEmail(","+    transaction: Knex.Transaction,","+    counterValue: string | null,","+  ): Promise<void> {","+    const periodStart = this.deps.getPeriodStart();","+    await this.deps.limitService.errorIfWouldGoOverLimit('inviteEmails', {","+      transacting: transaction,","+    });","+    await this.incrementEmailCounter(transaction, counterValue, periodStart);","+  }","+","+  private async incrementEmailCounter(","+    transaction: Knex.Transaction,","+    counterValue: string | null,","+    periodStart: string | null,","+  ): Promise<vo