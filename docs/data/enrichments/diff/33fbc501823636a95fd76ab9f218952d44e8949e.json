{"id":"33fbc501823636a95fd76ab9f218952d44e8949e","axis":"silent","repo":"nrwl/nx","sha":"33fbc501823636a95fd76ab9f218952d44e8949e","parsed":{"files":[{"path":"astro-docs/src/content/docs/technologies/test-tools/cypress/introduction.mdoc","lines":["@@ -250,6 +250,56 @@ The `@nx/cypress:configuration` generator is not a project generator. It won't g"," To set up a separate project, you can generate a separate project with a project generator like `@nx/js:library` first and then run the `@nx/cypress:configuration` generator."," {% /aside %}"," ","+### Choosing the web server per environment","+","+Most application generators pass two servers to the Cypress configuration: the dev server for local","+runs and a production build for CI.","+When the two differ, the generated config reads the `CI` environment variable and picks between them.","+","+```ts","+// apps/<your-app-name>-e2e/cypress.config.ts","+import { defineConfig } from 'cypress';","+import { nxE2EPreset } from '@nx/cypress/plugins/cypress-preset';","+","+export default defineConfig({","+  e2e: {","+    ...nxE2EPreset(import.meta.url, {","+      cypressDir: 'src',","+      bundler: 'vite',","+      webServerCommands: {","+        default: process.env['CI']","+          ? 'npx nx run <your-app-name>:preview'","+          : 'npx nx run <your-app-name>:dev',","+        production: 'npx nx run <your-app-name>:preview',","+      },","+      ciWebServerCommand: 'npx nx run <your-app-name>:preview',","+      ciBaseUrl: 'http://localhost:4300',","+    }),","+    baseUrl: process.env['CI']","+      ? 'http://localhost:4300'","+      : 'http://localhost:4200',","+  },","+});","+```","+","+`nx e2e` runs against the dev server locally, which avoids a rebuild on every change, and against a","+production build in CI.","+The `e2e-ci` tasks always run against `ciWebServerCommand`.","+","+These applications run against the dev server in CI as well:","+","+- React applications that use React Router (`--useReactRouter`)","+- Expo applications","+","+Web applications generated with `--bundler=none` have no dev server, so they run against","+`serve-static` locally as well.","+","+The inferred `e2e` task includes the `CI` environment variable in its inputs, so local and CI runs","+don't share cached results.","+An `inputs` list you set for this task in `targetDefaults` or in a project configuration replaces","+the inferred inputs unless it contains `\"...\"`.","+Add `{ \"env\": \"CI\" }` to that list, or add `\"...\"` to keep the inferred inputs.","+"," ### Testing applications"," "," Run `nx e2e frontend-e2e` to execute e2e tests with Cypress."],"additions":50,"deletions":0,"truncated":false},{"path":"e2e/cypress/src/cypress.test.ts","lines":["@@ -4,9 +4,11 @@ import {","   cleanupProject,","   createFile,","   killPort,","+  killPorts,","   newProject,","   readFile,","   readJson,","+  reservePort,","   runCLI,","   runCommand,","   tmpProjPath,","@@ -98,6 +100,46 @@ describe('Cypress E2E Test runner', () => {","     TEN_MINS_MS","   );"," ","+  it(","+    'should run e2e tests against the local web server when CI is not set',","+    async () => {","+      if (!(await shouldRunCypressTests())) {","+        return;","+      }","+      const app = uniq('app');","+      const e2eProject = `${app}-e2e`;","+      const port = await reservePort();","+      runCLI(","+        `generate @nx/react:app apps/${app} --e2eTestRunner=cypress --linter=eslint --unitTestRunner=none --port=${port} --no-interactive`","+      );","+      const [, ciServerTarget, localServerTarget] =","+        readFile(`apps/${e2eProject}/cypress.config.ts`).match(","+          new RegExp(","+            `process\\\\.env\\\\['CI'\\\\]\\\\s*\\\\?\\\\s*'[^']* nx run ${app}:([\\\\w-]+)[^']*'\\\\s*:\\\\s*'[^']* nx run ${app}:([\\\\w-]+)[^']*'`","+          )","+        ) ?? [];","+      expect(localServerTarget).toBeDefined();","+","+      try {","+        // runCLI sets CI, and an undefined value drops it from the child env.","+        // Without CI and a TTY, an out-of-sync workspace fails the run.","+        const result = runCLI(`e2e ${e2eProject} --skip-sync`, {","+          env: { CI: undefined },","+        });","+        expect(result).toContain(","+          `Successfully ran target e2e for project ${e2eProject}`","+        );","+        expect(result).toMatch(","+          new RegExp(`nx run ${app}:${localServerTarget}(?![\\\\w-])`)","+        );","+        expect(result).not.toContain(`nx run ${app}:${ciServerTarget}`);","+      } finally {","+        await killPorts(port);","+      }","+    },","+    TEN_MINS_MS","+  );","+","   it(","     'should execute e2e tests using Cypress',","     async () => {"],"additions":42,"deletions":0,"truncated":false},{"path":"packages/cypress/src/generators/base-setup/base-setup.ts","lines":["@@ -32,8 +32,12 @@ export interface CypressBaseSetupSchema {","    * which merges in its own `component` block afterwards).","    */","   e2ePreset?: {","-    /** Pre-formatted (indented) JSON of NxCypressE2EPresetOptions. */","+    /**","+     * NxCypressE2EPresetOptions rendered by `renderE2EPresetOptions`: indented","+     * JSON, except for values the config picks at runtime from `CI`.","+     */","     presetOptions: string;","+    /** A JS expression rendered by `renderE2EPresetOptions`, not a bare URL. */","     baseUrl?: string;","   };"," }"],"additions":5,"deletions":1,"truncated":false},{"path":"packages/cypress/src/generators/base-setup/files/config-js-cjs/cypress.config.js__ext__","lines":["@@ -7,6 +7,6 @@ const { defineConfig } = require('cypress');"," module.exports = defineConfig({<% if (e2ePreset) { %>","   e2e: {","     ...nxE2EPreset(__filename, <%- presetOptions %>),<% if (baseUrl) { %>","-    baseUrl: '<%- baseUrl %>',<% } %>","+    baseUrl: <%- baseUrl %>,<% } %>","   },"," <% } %>});"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/cypress/src/generators/base-setup/files/config-js-esm/cypress.config.js__ext__","lines