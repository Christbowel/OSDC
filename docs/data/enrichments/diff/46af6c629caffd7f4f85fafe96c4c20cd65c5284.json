ariant_ll: PhantomData<fn(&'ll ()) -> &'ll ()>,","+}","+","+/// Corresponds to `LLVMModuleRef`.","+#[derive(Clone, Copy)]","+#[repr(transparent)]","+pub(crate) struct Module<'ll> {","+    llmod_raw: ptr::NonNull<ModuleRaw>,","+    _invariant_ll: PhantomData<fn(&'ll ()) -> &'ll ()>,","+}","+","+impl<'ll> Module<'ll> {","+    pub(crate) fn llmod_raw(&self) -> ptr::NonNull<ModuleRaw> {","+        self.llmod_raw","+    }","+}","+","+unsafe extern \"C\" {","+    /// Pointee of the raw pointer that is wrapped by a lifetime-branded [`Context`].","+    pub(crate) type ContextRaw;","+    /// Pointee of the raw pointer that is wrapped by a lifetime-branded [`Module`].","+    pub(crate) type ModuleRaw;","+}","+","+/// Converts an unbranded pointer-to-context to a lifetime-branded [`Context`].","+///","+/// # Safety","+/// - The pointer must be a valid LLVM context.","+/// - If the context is passed to safe code, its caller-requested lifetime must be distinct","+///   from that of any other context, and must not outlive the underlying context.","+pub(crate) unsafe fn wrap_llcx<'ll>(llcx_raw: ptr::NonNull<ContextRaw>) -> Context<'ll> {","+    Context { llcx_raw, _invariant_ll: PhantomData }","+}","+","+/// Converts an unbranded pointer-to-module to a lifetime-branded [`Module`].","+///","+/// # Safety","+/// - The pointer must be a valid LLVM module within the specified context.","+/// - The module must not be disposed during the lifetime of its context.","+pub(crate) unsafe fn wrap_llmod<'ll>(","+    _llcx: Context<'ll>, // The context constrains `'ll` but isn't actually used.","+    llmod_raw: ptr::NonNull<ModuleRaw>,","+) -> Module<'ll> {","+    Module { llmod_raw, _invariant_ll: PhantomData }"],"additions":54,"deletions":0,"truncated":false}],"additions":197,"deletions":132,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-01T15:16:34.638407+00:00"}