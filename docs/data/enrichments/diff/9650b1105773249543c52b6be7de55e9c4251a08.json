{"id":"9650b1105773249543c52b6be7de55e9c4251a08","axis":"silent","repo":"pnpm/pnpm","sha":"9650b1105773249543c52b6be7de55e9c4251a08","parsed":{"files":[{"path":".changeset/install-summary-latest-hint.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+The install summary shows \"(X is available)\" again after a direct dependency whose `latest` version on the registry is newer than the one installed. The note appears when the install resolved that dependency against registry metadata."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hoisted_node_linker/summary.rs","lines":["@@ -168,7 +168,7 @@ fn hoisted_install_does_not_report_an_optional_dependency_it_skipped() {","     let output = install_output(pacquet_at(&workspace));","     assert_eq!(","         summary_of(&output, \"dependencies:\").as_deref(),","-        Some(\"dependencies:\\n+ @pnpm.e2e/foo 100.0.0\"),","+        Some(\"dependencies:\\n+ @pnpm.e2e/foo 100.0.0 (100.1.0 is available)\"),","     );","     assert_eq!(summary_of(&output, \"optionalDependencies:\"), None);"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_summary_latest.rs","lines":["@@ -0,0 +1,103 @@","+//! The \"(X is available)\" note the install summary puts after a direct","+//! dependency whose registry `latest` is newer than what was installed.","+","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::{","+    AddMockedRegistry,","+    CommandTempCwd,","+};","+use std::{","+    fs,","+    path::Path,","+    process::Command,","+};","+","+const FOO: &str = \"@pnpm.e2e/foo\";","+","+fn pacquet_at(workspace: &Path) -> Command {","+    Command::cargo_bin(\"pnpm\").expect(\"find the pnpm binary\").with_current_dir(workspace)","+}","+","+fn write_manifest(workspace: &Path, range: &str) {","+    let manifest = serde_json::json!({ \"dependencies\": { FOO: range } });","+    fs::write(workspace.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+}","+","+/// The summary line that adds [`FOO`].","+fn added_line(command: Command, args: &[&str]) -> String {","+    let assert = command","+        .with_args(args)","+        .assert()","+        .success();","+    let stdout = String::from_utf8_lossy(&assert.get_output().stdout).into_owned();","+    stdout","+        .lines()","+        .find(|line| line.starts_with(&format!(\"+ {FOO} \")))","+        .unwrap_or_else(|| panic!(\"no summary line adds {FOO}:\\n{stdout}\"))","+        .to_owned()","+}","+","+#[test]","+fn install_names_a_newer_latest_of_a_direct_dependency() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_manifest(&workspace, \"100.0.0\");","+","+    assert_eq!(","+        added_line(pacquet, &[\"install\"]),","+        format!(\"+ {FOO} 100.0.0 (100.1.0 is available)\"),","+    );","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn install_of_the_latest_version_prints_no_note() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_manifest(&workspace, \"^100.0.0\");","+","+    assert_eq!(added_line(pacquet, &[\"install\"]), format!(\"+ {FOO} 100.1.0\"));","+","+    drop((root, mock_instance));","+}","+","+/// A frozen install reads no registry metadata, so it has no `latest` to","+/// name, as with pnpm v11's headless install.","+#[test]","+fn frozen_install_prints_no_note() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_manifest(&workspace, \"100.0.0\");","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    fs::remove_dir_all(workspace.join(\"node_modules\")).expect(\"remove node_modules\");","+","+    assert_eq!(","+        added_line(pacquet_at(&workspace), &[\"install\", \"--frozen-lockfile\"]),","+        format!(\"+ {FOO} 100.0.0\"),","+    );","+","+    drop((root, mock_instance));","+}"],"additions":103,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -100,6 +100,7 @@ mod install_root_engine;"," mod install_runtimes;"," mod install_stale_importers;"," mod install_state;","+mod install_summary_latest;"," mod install_test;"," mod interrupt;"," mod interrupt_windows;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/hoisted/workspace_links.rs","lines":["@@ -42,6 +42,8 @@ pub(super) fn link_hoisted_workspace_dependencies<Reporter: self::Reporter>(","             importers: inputs.projects.importers,","             packages: lockfile.packages.as_ref(),","             skipped,","+            // `link:` siblings never carry a registry `latest`.","+            latest_versions: None,","         },","         policy: crate::DirectLinkPolicy {","             public_hoist_targets: None,"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/materialization.rs","lines":["@@ -116,6 +116,8 @@ impl<'a> InstallFrozenLockfile<'a> {","                     requires_build_by_snapshot: Some(&phase.fetched.requires_build_by_snapshot),","                     cas_paths_by_pkg_id: phase.cas_paths_by_pkg_id,","                     cas_paths_by_snapshot: phase.fetched.cas_paths_by_snapshot.clone(),","+                    // A frozen install reads no registry metadata.","+                    latest_versions: None