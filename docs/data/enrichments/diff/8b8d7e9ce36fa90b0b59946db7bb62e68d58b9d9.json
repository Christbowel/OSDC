  build_repo2 do","+        build_gem \"mygem\", \"1.0\"","+        build_gem \"mygem\", \"1.0\" do |s|","+          s.platform = Gem::Platform.new(\"x86_64-linux\")","+          s.write \"lib/mygem.rb\", \"MYGEM = '1.0 not_content_addressed'\"","+        end","+      end","+","+      build_gem \"mygem\", \"1.0\", content_addressable: true, path: gem_repo2(\"gems\") do |s|","+        s.platform = Gem::Platform.new(\"x86_64-linux\")","+        s.required_ruby_version = \"~> #{current_abi}.0\"","+        s.write \"lib/mygem.rb\", \"MYGEM = '1.0 content_addressed'\"","+      end","+","+      build_gem \"mygem\", \"1.0\", content_addressable: true, path: gem_repo2(\"gems\") do |s|","+        s.platform = Gem::Platform.new(\"x86_64-linux\")","+        s.required_ruby_version = \"~> #{mismatched_abi}.0\"","+        s.write \"lib/mygem.rb\", \"MYGEM = '1.0 mismatched'\"","+      end","+","+      gemfile <<~G","+        source \"https://gem.repo2\"","+","+        gem \"mygem\"","+      G","+    end","+","+    def content_address_for(abi)","+      file = Dir[gem_repo2(\"gems\", \"mygem-1.0-*.gem\").to_s].find do |path|","+        Gem::Package.new(path).spec.required_ruby_version.to_s == \"~> #{abi}.0\"","+      end","+      File.basename(file, \".gem\").rpartition(\"-\").last","+    end","+","+    def rows_for(*abis)","+      abis.map {|abi| \"  mygem (1.0-x86_64-linux) #{content_address_for(abi)}\" }.sort","+    end","+","+    def content_address_rows","+      lockfile.scan(/^  mygem \\(1\\.0-x86_64-linux\\) [0-9a-f]+/)","+    end","+","+    def lockfile_with_content_addresses(*content_addresses)","+      lockfile <<~L","+        GEM","+          remote: https://gem.repo2/","+          specs:","+            mygem (1.0-x86_64-linux)","+","+        PLATFORMS","+          x86_64-linux","+","+        DEPENDENCIES","+          mygem","+","+        CONTENT ADDRESSES","+        #{content_addresses.map {|address| \"  mygem (1.0-x86_64-linux) #{address}\" }.join(\"\\n\")}","+","+   