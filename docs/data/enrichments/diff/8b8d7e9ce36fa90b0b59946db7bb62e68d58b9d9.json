6=abcdef1234f1315d7e7b7e8295184577cc4e969bad6156ac069d02d63f58d82e","+                  from the lockfile CHECKSUMS at #{lockfile_path}:13:39","+                mygem (1.0-x86_64-linux) #{bad_checksum}","+                  from the lockfile CHECKSUMS at #{lockfile_path}:14:39","+            MESSAGE","+          end","+        end","+      end","+    end","+","+    context \"with an ill-formed checksum on a content address row\" do","+      let(:lockfile_contents) do","+        <<~L","+          GEM","+            remote: https://rubygems.org/","+            specs:","+              mygem (1.0-x86_64-linux)","+","+          PLATFORMS","+            x86_64-linux","+","+          DEPENDENCIES","+            mygem","+","+          CONTENT ADDRESSES","+            mygem (1.0-x86_64-linux) abcdef1234 sha256=garbage","+","+          BUNDLED WITH","+             4.1.0","+        L","+      end","+","+      it \"raises a LockfileError pointing at the line\" do","+        expect { subject }.to raise_error(Bundler::LockfileError, /error occurred while evaluating #{Regexp.escape(lockfile_path)}:\\d+:\\d+/)","+      end","+    end","+","+    context \"when a platform row lists several content addresses\" do","+      let(:lockfile_contents) do","+        <<~L","+          GEM","+            remote: https://rubygems.org/","+            specs:","+              mygem (1.0-x86_64-linux)","+","+          PLATFORMS","+            x86_64-linux","+","+          DEPENDENCIES","+            mygem","+","+          CONTENT ADDRESSES","+            mygem (1.0-x86_64-linux) abcdef1234","+            mygem (1.0-x86_64-linux) 0123456789","+            othergem (2.0-x86_64-linux) 9876543210","+","+          BUNDLED WITH","+             4.1.0","+        L","+      end","+","+      it \"keeps every content address on the single platform row\" do","+        specs = subject.specs.select {|s| s.name == \"mygem\" }","+","+        expect(specs.size).to eq(1)","+        expect(specs.first.content_addresse