Store.new) }","+  let(:x86_64_linux) { Gem::Platform.new(\"x86_64-linux\") }","+","+  def lazy_spec(platform = x86_64_linux, content_addresses: [])","+    Bundler::LazySpecification.new(\"mygem\", Gem::Version.new(\"1.0\"), platform, source, content_addresses: content_addresses)","+  end","+","+  def write_section(writer, specs, **definition_stubs)","+    definition = instance_double(Bundler::Definition, resolve: specs, **definition_stubs)","+    generator = described_class.new(definition)","+    generator.send(writer)","+    generator.out","+  end","+","   describe \"#add_content_addresses\" do","-    let(:source) { instance_double(Bundler::Source::Rubygems) }","+    def content_addresses_section(specs, locked_checksums: false)","+      write_section(:add_content_addresses, specs, locked_checksums: locked_checksums)","+    end","+","+    # Parses a generated row back the way `bundle install` will on the next run.","+    def parse_row(row)","+      parser = Bundler::LockfileParser.new(<<~L)","+        GEM","+          remote: https://rubygems.org/","+          specs:","+            mygem (1.0-x86_64-linux)","+","+        PLATFORMS","+          x86_64-linux","+","+        DEPENDENCIES","+          mygem","+","+        CONTENT ADDRESSES","+        #{row}","+","+        BUNDLED WITH","+           #{Bundler::VERSION}","+      L","+      [parser.specs.first, parser.sources.first.checksum_store]","+    end","+","+    it \"writes a row per content address, sorted by address like any lockfile section, that the parser reads back\" do","+      spec = lazy_spec(content_addresses: [\"ffffffff\", \"00000000\", \"abcdef12\"])","+","+      output = content_addresses_section([spec])"," ","-    def lazy_spec(platform, content_address: nil)","-      Bundler::LazySpecification.new(\"mygem\", Gem::Version.new(\"1.0\"), platform, source, content_address: content_address)","+      expect(output).to eq(<<~L)","+","+        CONTENT ADDRESSES","+          mygem (1.0-x86_64-linux) 00000000","+          mygem (1.0-x86_64-linux) abcdef12","+          mygem (1.0-x86_64-linux) ffffffff","+      L","+","+      parsed, = parse_row(output[/^  mygem .*abcdef12$/])","+      expect(parsed.content_addresses).to eq([\"abcdef12\"])","     end"," ","-    def generated_output(specs)","-      definition = instance_double(Bundler::Definition, resolve: specs, locked_checksums: false)","-      generator = described_class.new(definition)","-      generator.send(:add_content_addresses)","-      generator.out","+    it \"writes each content-addressed gem's checksum under its own full name, leaving rows without one bare\" do","+      checksum = Bundler::Checksum.new(\"sha256\", \"aa\" * 32, Bundler::Checksum::Source.new(:lock, \"Gemfile.lock:1:1\"))","+      source.checksum_store.register(Gem::NameTuple.new(\"mygem\", Gem::Version.new(\"1.0\"), x86_64_linux, content_address: \"abcdef12\"), checksum)","+      spec = lazy_spec(content_addresses: [\"abcdef12\", \"01234567\"])","+","+      output = content_addresses_section([spec], locked_checksums: true)","+","+      expect(output).to include(\"  mygem (1.0-x86_64-linux) 01234567\\n\")","+      expect(output).to include(\"  mygem (1.0-x86_64-linux) abcdef12 sha256=#{\"aa\" * 32}\\n\")","+","+      parsed, store = parse_row(output[/^  mygem .*sha256=.*$/])","+      expect(parsed.content_addresses).to eq([\"abcdef12\"])","+      expect(store.checksums_to_lock(\"mygem-1.0-abcdef12\")).to eq(\"sha256=#{\"aa\" * 32}\")","     end"," ","-    it \"writes a row the lockfile parser can read back\" do","-      spec = lazy_spec(Gem::Platform.new(\"x86_64-linux\"), content_address: \"abcdef12\")","-      output = generated_output([spec])","+    it \"does not write checksums unless they are locked\" do","+      checksum = Bundler::Checksum.new(\"sha256\", \"aa\" * 32, Bundler::Checksum::Source.new(:lock, \"Gemfile.lock:1:1\"))","+      source.checksum_store.register(Gem::NameTuple.new(\"mygem\", Gem::Version.new(\"1.0\"), x86_64_linux, content_address: \"abcdef12\"), checksum)","+","+      output = content_addresses_section([lazy_spec(content_addresses: [\"abcdef12\"])], locked_checksums: false)"," ","-      expect(output).to include(\"CONTENT ADDRESSES\\n  mygem (1.0-x86_64-linux) abcdef12\\n\")","-      expect(\"  mygem (1.0-x86_64-linux) abcdef12\").to match(Bundler::LockfileParser::NAME_VERSION_CONTENT_ADDRESS)","+      expect(output).to include(\"  mygem (1.0-x86_64-linux) abcdef12\\n\")","+      expect(output).not_to include(\"sha256\")","     end"," ","     it \"does not write a row for a spec with an address on the ruby platform\" do","-      spec = lazy_spec(Gem::Platform::RUBY, content_address: \"abcdef12\")","-","-      expect(generated_output([spec])).to be_empty","-      expect(\"  mygem (1.0) abcdef12\").not_to match(Bundler::LockfileParser::NAME_VERSION_CONTENT_ADDRESS)","+      expect(content_addresses_section([lazy_spec(Gem::Platform::RUBY, content_addresses: [\"abcdef12\"])])).to be_empty","     end"," ","     it \"does not write a row for a spec without an address\" do","-      spec = lazy_spec(Gem::Platform.new(\"x86_64-linux\"))","-","-      expect(generated_output([spec])).to be_empty","+      expect(content_addresses_section([lazy_spec])).to be_empty","     end","   end"," end"],"additions":81,"deletions":20,"truncated":false},{"path":"spec/bundler/lockfile_parser_spec.rb","lines":["@@ -175,24 +175,107 @@","             mygem (1.0-x86_64-linux) sha256=814828c34f1315d7e7b7e8295184577cc4e969bad6156ac069d02d63f58d82e8"," ","           BUNDLED WITH","-             1.12.0.rc.2","+             4.1.0","         L","       end"," ","-      it \"parses the platform and content address\" do","+      it \"parses the platform and content address, keeping the platform full name\" do","         spec = subject.specs.find {|s| s.name == \"mygem\" }"," ","         expect(spec.platform).to eq(Gem::Platform.new(\"x86_64-linux\"))","-        expect(spec.content_address).to eq(\"abcdef1234\")","-   