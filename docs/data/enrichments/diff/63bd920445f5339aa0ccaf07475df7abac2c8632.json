{"id":"63bd920445f5339aa0ccaf07475df7abac2c8632","axis":"silent","repo":"openssl/openssl","sha":"63bd920445f5339aa0ccaf07475df7abac2c8632","parsed":{"files":[{"path":"ssl/d1_lib.c","lines":["@@ -3385,7 +3385,17 @@ int ossl_dtls_conn_poll_events(SSL *s, uint64_t events, int do_tick,","         SSL_handle_events(s);"," ","     if ((events & SSL_POLL_EVENT_R) != 0) {","-        if (SSL_has_pending(s) || SSL_pending(s) > 0) {","+        /*","+         * Application data buffered during a handshake cannot be read until","+         * the handshake finishes. Until then, reporting it would make","+         * SSL_poll() return immediately while SSL_read() keeps failing with","+         * SSL_ERROR_WANT_READ, so wait for the datagrams that complete the","+         * handshake instead.","+         */","+        if (RECORD_LAYER_processed_read_pending(&sc->rlayer)","+            || RECORD_LAYER_read_pending(&sc->rlayer)","+            || (SSL_is_init_finished(s)","+                && DTLS_RECORD_LAYER_buffered_app_data_pending(&sc->rlayer))) {","             result |= SSL_POLL_EVENT_R;","         } else if (sc->d1->rx != NULL) {","             /* Listener-based connection: check URXE queue */"],"additions":11,"deletions":1,"truncated":false},{"path":"ssl/record/rec_layer_d1.c","lines":["@@ -72,6 +72,25 @@ void DTLS_RECORD_LAYER_clear(RECORD_LAYER *rl)","     d->buffered_app_data = buffered_app_data;"," }"," ","+/*","+ * Checks for application data set aside while a handshake was in progress.","+ * dtls1_read_bytes() only returns it once the handshake has finished.","+ */","+int DTLS_RECORD_LAYER_buffered_app_data_pending(const RECORD_LAYER *rl)","+{","+    TLS_RECORD *rdata;","+    pitem *item, *iter;","+","+    iter = pqueue_iterator(rl->d->buffered_app_data);","+    while ((item = pqueue_next(&iter)) != NULL) {","+        rdata = item->data;","+        if (rdata->length > 0)","+            return 1;","+    }","+","+    return 0;","+}","+"," static int dtls_buffer_record(SSL_C