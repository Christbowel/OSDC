{"id":"c9092ec492bbb5e51f550e72776034a19686aa14","axis":"silent","repo":"redis/go-redis","sha":"c9092ec492bbb5e51f550e72776034a19686aa14","parsed":{"files":[{"path":"RELEASE-NOTES.md","lines":["@@ -2,6 +2,7 @@"," "," ## Unreleased"," ","+- **Username without a password:** a `Username` with an empty `Password` again sends no `AUTH`, as before [#4161](https://github.com/redis/go-redis/pull/4161). Redis Enterprise and Redis Cloud databases with unauthenticated access can reject an empty password, so #4161 could break configs that set a username (e.g. `default`) without a password. Redis OSS accepts it. To authenticate an ACL user created with `nopass`, set `AuthEmptyPassword: true` (or `auth_empty_password=true` in the URL); for sentinel connections use `SentinelAuthEmptyPassword` (`sentinel_auth_empty_password=true`). The rule also applies to credentials from `CredentialsProvider`, `CredentialsProviderContext` and `StreamingCredentialsProvider` used when a connection is set up; re-authentication on a credentials refresh is unchanged. The client-side cache keeps a separate namespace for a username that sends no `AUTH`."," - **URL configuration validation:** `ParseURL`, `ParseClusterURL`, and `ParseFailoverURL` now reject negative `dialer_retry_timeout`, `read_buffer_size`, and `write_buffer_size` values. Cluster and failover URLs that previously accepted negative retry timeouts now return an error; replace those values with `0` for no delay, or omit the parameter for the default 100 ms delay. An explicit `dialer_retry_timeout=0` now disables the retry delay ([#4144](https://github.com/redis/go-redis/pull/4144))."," - Cluster routing shares command metadata with client-side caching for key","   extraction and read-only status. Existing default routing and cluster-wide"],"additions":1,"deletions":0,"truncated":false},{"path":"acl_commands_test.go","lines":["@@ -115,16 +115,25 @@ var _ = Describe(\"ACL user commands\", Label(\"NonRedisEnterprise\"), func() {"," \t\tExpect(add).To(Equal(\"OK\"))"," "," \t\tfor _, protocol := range []int{3, 2} {","-\t\t\topt := redisOptions()","-\t\t\topt.Username = TestUserName","-\t\t\topt.Password = \"\"","-\t\t\topt.Protocol = protocol","-\t\t\tuserClient := redis.NewClient(opt)","-","-\t\t\twhoami, err := userClient.ACLWhoAmI(ctx).Result()","-\t\t\tExpect(userClient.Close()).NotTo(HaveOccurred())","-\t\t\tExpect(err).NotTo(HaveOccurred())","-\t\t\tExpect(whoami).To(Equal(TestUserName), \"protocol %d\", protocol)","+\t\t\tfor _, authEmptyPassword := range []bool{false, true} {","+\t\t\t\topt := redisOptions()","+\t\t\t\topt.Username = TestUserName","+\t\t\t\topt.Password = \"\"","+\t\t\t\topt.Protocol = protocol","+\t\t\t\topt.AuthEmptyPassword = authEmptyPassword","+\t\t\t\tuserClient := redis.NewClient(opt)","+","+\t\t\t\twhoami, err := userClient.ACLWhoAmI(ctx).Result()","+\t\t\t\tExpect(userClient.Close()).NotTo(HaveOccurred())","+\t\t\t\tExpect(err).NotTo(HaveOccurred())","+\t\t\t\t// By default a username without a password sends no AUTH.","+\t\t\t\twant := \"default\"","+\t\t\t\tif authEmptyPassword {","+\t\t\t\t\twant = TestUserName","+\t\t\t\t}","+\t\t\t\tExpect(whoami).To(Equal(want),","+\t\t\t\t\t\"protocol %d, AuthEmptyPassword %t\", protocol, authEmptyPassword)","+\t\t\t}"," \t\t}"," \t})"," "],"additions":19,"deletions":10,"truncated":false},{"path":"auth_empty_password_test.go","lines":["@@ -0,0 +1,240 @@","+package redis","+","+import (","+\t\"context\"","+\t\"reflect\"","+\t\"testing\"","+)","+","+func TestHelloAuthArgs(t *testing.T) {","+\ttests := []struct {","+\t\tname               string","+\t\tusername, password string","+\t\tauthEmptyPassword  bool","+\t\twant               []interface{}","+\t}{","+\t\t{\"no credentials\", \"\", \"\", false, []interface{}{\"hello\", 3}},","+\t\t{\"no credentials opt-in\", \"\", \"\", true, []interface{}{\"hello\", 3}},","+\t\t{\"password only\", \"\", \"pw\", false, []interface{}{\"hello\", 3, \"auth\", \"default\", \"pw\"}},","+\t\t{\"username and password\", \"u\", \"pw\", false, []interface{}{\"hello\", 3, \"auth\", \"u\", \"pw\"}},","+\t\t{\"username empty password\", \"u\", \"\", false, []interface{}{\"hello\", 3}},","+\t\t{\"username empty password opt-in\", \"u\", \"\", true, []interface{}{\"hello\", 3, \"auth\", \"u\", \"\"}},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tvar got []interface{}","+\t\t\tc := statefulCmdable(func(_ context.Context, cmd Cmder) error {","+\t\t\t\tgot = cmd.Args()","+\t\t\t\treturn nil","+\t\t\t})","+\t\t\topt := &Options{AuthEmptyPassword: tt.authEmptyPassword}","+\t\t\tc.hello(context.Background(), 3, tt.username, tt.password, \"\", opt.sendAuth(tt.username, tt.password))","+\t\t\tif !reflect.DeepEqual(got, tt.want) {","+\t\t\t\tt.Fatalf(\"args = %v, want %v\", got, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}","+","+// TestHelloPublicAuthOnlyWithPassword pins the public Hello behaviour: a","+// username without a password sends no AUTH.","+func TestHelloPublicAuthOnlyWithPassword(t *testing.T) {","+\tvar got []interface{}","+\tc := statefulCmdable(func(_ context.Context, cmd Cmder) error {","+\t\tgot = cmd.Args()","+\t\treturn nil","+\t})","+\tc.Hello(context.Background(), 3, \"u\", \"\", \"name\")","+\twant := []interface{}{\"hello\", 3, \"setname\", \"name\"}","+\tif !reflect.DeepEqual(got, want) {","+\t\tt.Fatalf(\"args = %v, want %v\", got, want)","+\t}","+}","+","+func TestAuthEmptyPasswordURL(t *testing.T) {","+\tconst q = \"?auth_empty_password=true\"","+","+\to, err := ParseURL(\"redis://u@localhost:6379\" + q)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif !o.AuthEmptyPassword {","+\t\tt.Fatal(\"ParseURL: AuthEmptyPassword not set\")","+\t}","+","+\tco, err := ParseClusterURL(\"redis://u@localhost:6379\" + q)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif !co.AuthEmptyPassword {","+\t\tt.Fatal(\"ParseClusterURL: AuthEmptyPassword not set\")","+\t}","+","+\tfo, err := ParseFailoverURL(\"redis://localhost:26379?master_name=m&auth_empty_password=true\")","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif !fo.AuthEmptyPassword {","+\t\tt.Fatal(\"ParseFailoverURL: AuthEmptyPassword not set\")","+\t}","+","+\to, err = ParseURL(\"redis://u@localhost:6379\")","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif o.AuthEmptyPassword {","+\t\tt.Fatal(\"ParseURL: AuthEmptyPassword set by default\")","+\t}","+","+\tif _, err := ParseURL(\"redis://localhost:6379?auth_empty_password=maybe\"); err == nil {","+\t\tt.Fatal(\"ParseURL: invalid bool accepted\")","+\t}","+}","+","+func TestAuthEmptyPasswordPlumbing(t *testing.T) {","+\tuo := &UniversalOptions{Addrs: []string{\"a:1\"}, MasterName: \"m\", AuthEmptyPassword: true}","+\tif !uo.Simple().AuthEmptyPassword {","+\t\tt.Error(\"UniversalOptions.Simple\")","+\t}","+\tif !uo.Cluster().AuthEmptyPassword {","+\t\tt.Error(\"UniversalOptions.Cluster\")","+\t}","+\tif !uo.Failover().AuthEmptyPassword {","+\t\tt.Error(\"UniversalOptions.Failover\")","+\t}","+","+\tco := &ClusterOptions{AuthEmptyPassword: true}","+\tco.init()","+\tif !co.clientOptions().AuthEmptyPassword {","+\t\tt.Error(\"ClusterOptions.clientOptions\")","+\t}","+","+\tfo := &FailoverOptions{MasterName: \"m\", AuthEmptyPassword: true}","+\tif !fo.clientOptions().AuthEmptyPassword {","+\t\tt.Error(\"FailoverOptions.clientOptions\")","+\t}","+\tif !fo.clusterOptions().AuthEmptyPassword {","+\t\tt.Error(\"FailoverOptions.clusterOptions\")","+\t}","+\t// Sentinel and data-node credentials are independent, and so are their","+\t// opt-ins.","+\tif fo.sentinelOptions(\"a:1\").AuthEmptyPassword {","+\t\tt.Error(\"FailoverOptions.AuthEmptyPassword reached the sentinel connections\")","+\t}","+\tso := &FailoverOptions{MasterName: \"m\", SentinelAuthEmptyPassword: true}","+\tif !so.sentinelOptions(\"a:1\").AuthEmptyPassword {","+\t\tt.Error(\"FailoverOptions.SentinelAuthEmptyPassword not on sentinelOptions\")","+\t}","+\tif so.clientOptions().AuthEmptyPassword || so.clusterOptions().AuthEmptyPassword {","+\t\tt.Error(\"FailoverOptions.SentinelAuthEmptyPassword reached the data-node connections\")","+\t}","+\tus := &UniversalOptions{Addrs: []string{\"a:1\"}, MasterName: \"m\", SentinelAuthEmptyPassword: true}","+\tif f := us.Failover(); !f.SentinelAuthEmptyPassword || f.AuthEmptyPassword {","+\t\tt.Error(\"UniversalOptions.Failover: SentinelAuthEmptyPassword not kept apart\")","+\t}","+","+\tpf, err := ParseFailoverURL(\"redis://sentinel:26379?master_name=m&sentinel_auth_empty_password=true\")","+\tif err != nil {","+\t\tt.Fatalf(\"ParseFailoverURL: %v\", err)","+\t}","+\tif !pf.SentinelAuthEmptyPassword || pf.AuthEmptyPassword {","+\t\tt.Errorf(\"ParseFailoverURL: SentinelAuthEmptyPassword=%v AuthEmptyPassword=%v\", pf.SentinelAuthEmptyPassword, pf.AuthEmptyPassword)","+\t}","+","+\tro := &RingOptions{AuthEmptyPassword: true}","+\tif !ro.clientOptions().AuthEmptyPassword {","+\t\tt.Error(\"RingOptions.clientOptions\")","+\t}","+}","+","+// TestAuthEmptyPasswordCSCNamespace checks that clients sharing a Cache do not","+// share entries across ACL identities: a Username sends AUTH (its own","+// namespace), or sends none and runs as the default user or a TLS-certificate","+// user (a separate namespace per Username, never the default one).","+func TestAuthEmptyPasswordCSCNamespace(t *testing.T) {","+\ttests := []struct {","+\t\tname string","+\t\topt  Options","+\t\twant string","+\t}{","+\t\t{\"no credentials\", Options{}, cscNamespacePrefix(0, \"\")},","+\t\t{\"username empty password\", Options{Username: \"u\"}, cscNamespacePrefix(0, \"noauth u\")},","+\t\t{\"other username empty password\", Options{Username: \"v\"}, cscNamespacePrefix(0, \"noauth v\")},","+\t\t{\"username empty password opt-in\", Options{Username: \"u\", AuthEmptyPassword: true}, cscNamespacePrefix(0, \"u\")},","+\t\t{\"username and password\", Options{Username: \"u\", Password: \"pw\"}, cscNamespacePrefix(0, \"u\")},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\topt := tt.opt","+\t\t\topt.Addr = \"127.0.0.1:1\"","+\t\t\topt.Protocol = 3","+\t\t\topt.ClientSideCacheConfig = &ClientSideCacheConfig{}","+\t\t\tc := NewClient(&opt)","+\t\t\tdefer c.Close()","+\t\t\tif c.csc == nil {","+\t\t\t\tt.Fatal(\"client-side cache not attached\")","+\t\t\t}","+\t\t\tif c.cscKeyPrefix != tt.want {","+\t\t\t\tt.Fatalf(\"cscKeyPrefix = %q, want %q\", c.cscKeyPrefix, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}","+","+// TestAuthEmptyPasswordConnect checks the connection identity for a nopass","+// ACL user given as Username with an empty Password.","+func TestAuthEmptyPasswordConnect(t *testing.T) {","+\tctx := context.Background()","+\taddr := internalTestRedisAddr()","+\tif err := probeRedis(addr); err != nil {","+\t\tt.Skipf(\"no redis: %v\", err)","+\t}","+\tadmin := NewClient(&Options{Addr: addr})","+\t// t.Cleanup, not defer: cleanups run LIFO after the test returns, so the","+\t// ACL user deletion registered below runs while admin is still open.","+\tt.Cleanup(func() { _ = admin.Close() })","+\tif err := admin.Ping(ctx).Err(); err != nil {","+\t\tt.Skipf(\"no redis: %v\", err)","+\t}","+\tif whoami, err := admin.ACLWhoAmI(ctx).Result(); err != nil || whoami != \"default\" {","+\t\tt.Skipf(\"default user unavailable: %q %v\", whoami, err)","+\t}","+\tconst user = \"aep_user\"","+\tif err := admin.ACLSetUser(ctx, user, \"reset\", \"on\", \"nopass\", \"~*\", \"+@all\").Err(); err != nil {","+\t\tt.Skipf(\"ACL SETUSER unsupported: %v\", err)","+\t}","+\tt.Cleanup(func() {","+\t\t// Other ACL specs expect only the default user.","+\t\tif err := admin.ACLDelUser(context.Background(), user).Err(); err != nil {","+\t\t\tt.Errorf(\"ACL DELUSER %s: %v\", user, err)","+\t\t}","+\t})","+","+\tcredsProvider := func() (string, string) { return user, \"\" }","+","+\tfor _, protocol := range []int{3, 2} {","+\t\tfor _, tc := range []struct {","+\t\t\tname      string","+\t\t\topt       Options","+\t\t\twantWhoAm string","+\t\t}{","+\t\t\t{\"username default\", Options{Username: user}, \"default\"},","+\t\t\t{\"username opt-in\", Options{Username: user, AuthEmptyPassword: true}, user},","+\t\t\t{\"provider default\", Options{CredentialsProvider: credsProvider}, \"default\"},","+\t\t\t{\"provider opt-in\", Options{CredentialsProvider: credsProvider, AuthEmptyPassword: true}, user},","+\t\t} {","+\t\t\topt := tc.opt","+\t\t\topt.Addr = addr","+\t\t\topt.Protocol = protocol","+\t\t\tc := NewClient(&opt)","+\t\t\twhoami, err := c.ACLWhoAmI(ctx).Result()","+\t\t\t_ = c.Close()","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"protocol %d %s: %v\", protocol, tc.name, err)","+\t\t\t}","+\t\t\tif whoami != tc.wantWhoAm {","+\t\t\t\tt.Fatalf(\"protocol %d %s: whoami = %q, want %q\", protocol, tc.name, whoami, tc.wantWhoAm)","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":240,"deletions":0,"truncated":false},{"path":"commands.go","lines":["@@ -358,12 +358,20 @@ func (info LibraryInfo) Validate() error {"," }"," "," // Hello sets the resp protocol used.","+// It sends AUTH only when password is not empty."," func (c statefulCmdable) Hello(ctx context.Context,"," \tver int, username, password, clientName string,","+) *MapStringInterfaceCmd {","+\treturn c.hello(ctx, ver, username, password, clientName, password != \"\")","+}","+","+// hello sends HELLO with AUTH when auth is true.","+func (c statefulCmdable) hello(ctx context.Context,","+\tver int, username, password, clientName string, auth bool,"," ) *MapStringInterfaceCmd {"," \targs := make([]interface{}, 0, 7)"," \targs = append(args, \"hello\", ver)","-\tif username != \"\" || password != \"\" {","+\tif auth {"," \t\tif username == \"\" {"," \t\t\tusername = \"default\""," \t\t}"],"additions":9,"deletions":1,"truncated":false},{"path":"csc_integration.go","lines":["@@ -687,7 +687,16 @@ func (c *baseClient) attachCSC(ctx context.Context, cache Cache) {"," \t\t\t\"redis: client-side caching is disabled with credential providers\")"," \t\treturn"," \t}","-\tc.cscKeyPrefix = cscNamespacePrefix(c.opt.DB, c.opt.Username)","+\t// Namespace by ACL identity. A Username that sends no AUTH (empty","+\t// Password, AuthEmptyPassword unset) runs as the default user, or as a","+\t// TLS-certificate user, so it gets its own namespace per Username: apart","+\t// from the AUTH-ed user and from other certificates. ACL usernames cannot","+\t// contain spaces, so \"noauth <name>\" never matches a real user.","+\tusername := c.opt.Username","+\tif username != \"\" && !c.opt.sendAuth(c.opt.Username, c.opt.Password) {","+\t\tusername = \"noauth \" + username","+\t}","+\tc.cscKeyPrefix = cscNamespacePrefix(c.opt.DB, username)"," \tswitch c.opt.ClientSideCacheStrategy {"," \tcase CSCStrategySharedTracking:"," \t\tc.attachSharedTrackingCSC(ctx, cache)"],"additions":10,"deletions":1,"truncated":false},{"path":"options.go","lines":["@@ -87,8 +87,8 @@ type Options struct {"," \t// Username is used to authenticate the current connection"," \t// with one of the connections defined in the ACL list when connecting"," \t// to a Redis 6.0 instance, or greater, that is using the Redis ACL system.","-\t// A Username with an empty Password authenticates as that user with an","-\t// empty password, which the server accepts for users created with nopass.","+\t// A Username without a Password sends no AUTH unless AuthEmptyPassword","+\t// is set."," \tUsername string"," "," \t// Password is an optional password. Must match the password specified in the","@@ -97,6 +97,18 @@ type Options struct {"," \t// that is using the Redis ACL system."," \tPassword string"," ","+\t// AuthEmptyPassword, when true, makes a Username with an empty Password","+\t// authenticate as that user with an empty password (AUTH user \"\"), as","+\t// needed for ACL users created with nopass. The rule also applies to","+\t// credentials from CredentialsProvider, CredentialsProviderContext and","+\t// StreamingCredentialsProvider used when a connection is set up.","+\t// Re-authentication on a credentials refresh is not affected.","+\t//","+\t// By default a Username without a Password sends no AUTH: some servers","+\t// (Redis Enterprise, Redis Cloud databases with unauthenticated access)","+\t// reject an empty password. Redis OSS accepts it.","+\tAuthEmptyPassword bool","+"," \t// CredentialsProvider allows the username and password to be updated"," \t// before reconnecting. It should return the current username and password."," \tCredentialsProvider func() (username string, password string)","@@ -493,7 +505,7 @@ type Options struct {"," \t// CredentialsProviderContext, or StreamingCredentialsProvider is set:"," \t// provider-backed credentials can change the ACL identity after the cache"," \t// namespace is selected. Fixed Username/Password values are supported and","-\t// included in the cache namespace.","+\t// the ACL user they authenticate as is included in the cache namespace."," \t//"," \t// Invalidation freshness: a server invalidation is applied when the client"," \t// next reads from the connection that carries it — at arrival on a","@@ -1180,6 +1192,7 @@ func setupConnParams(u *url.URL, o *Options) (*Options, error) {"," "," \to.Protocol = q.int(\"protocol\")"," \to.ClientName = q.string(\"client_name\")","+\to.AuthEmptyPassword = q.bool(\"auth_empty_password\")"," \to.MaxRetries = q.int(\"max_retries\")"," \to.MinRetryBackoff = q.duration(\"min_retry_backoff\")"," \to.MaxRetryBackoff = q.duration(\"max_retry_backoff\")"],"additions":16,"deletions":3,"truncated":false},{"path":"osscluster.go","lines":["@@ -131,6 +131,9 @@ type ClusterOptions struct {"," \tCredentialsProviderContext   func(ctx context.Context) (username string, password string, err error)"," \tStreamingCredentialsProvider auth.StreamingCredentialsProvider"," ","+\t// AuthEmptyPassword: see Options.AuthEmptyPassword.","+\tAuthEmptyPassword bool","+"," \t// MaxRetries is the maximum number of retries before giving up."," \t// For Cluster