{"id":"GHSA-48p8-g2fx-3wwm","axis":"advisories","repo":"argoproj/argo-workflows","sha":"277e9cef0ad16d7eaaab253573d0695951a65dbd","parsed":{"files":[{"path":"workflow/util/merge.go","lines":["@@ -53,6 +53,12 @@ func ValidateUserOverrides(userSpec *wfv1.WorkflowSpec) error {"," \t\t\tviolations = append(violations, fieldName)"," \t\t}"," \t}","+\t// ArtifactGC is allow-listed so that its benign fields (Strategy,","+\t// ForceFinalizerRemoval) may be set, but its nested ServiceAccountName,","+\t// PodSpecPatch and PodMetadata reach the artifact-GC Pod and would otherwise","+\t// re-open the privilege escalation that the top-level ServiceAccountName /","+\t// PodSpecPatch / PodMetadata blocks are meant to close, so reject them here.","+\tviolations = append(violations, artifactGCOverrideViolations(userSpec.ArtifactGC)...)"," \tif len(violations) > 0 {"," \t\tsort.Strings(violations)"," \t\treturn fmt.Errorf(\"fields %v are not permitted when using workflowTemplateRef with templateReferencing restriction\", violations)","@@ -76,9 +82,50 @@ func SanitizeUserWorkflowSpec(userSpec *wfv1.WorkflowSpec) *wfv1.WorkflowSpec {"," \t\t\tdst.Field(i).Set(src.Field(i))"," \t\t}"," \t}","+\t// ArtifactGC is allow-listed wholesale above, which copies the pointer and","+\t// so would carry through the user's ServiceAccountName/PodSpecPatch/PodMetadata.","+\t// Strip those security-sensitive fields (on a copy, so the caller's spec is","+\t// left untouched) while preserving the benign ones.","+\tsanitized.ArtifactGC = sanitizeArtifactGC(sanitized.ArtifactGC)"," \treturn sanitized"," }"," ","+// artifactGCOverrideViolations reports the security-sensitive fields set within a","+// user-supplied workflow-level ArtifactGC. These reach the artifact-GC Pod and","+// must not be user-controllable when a hardened WorkflowTemplate is referenced","+// under Strict/Secure mode.","+func artifactGCOverrideViolations(agc *wfv1.WorkflowLevelArtifactGC) []string {","+\tif agc == nil {","+\t\treturn nil","+\t}","+\tvar violations []string","+\tif agc.PodSpecPatch != \"\" {","+\t\tviolations = append(violations, \"ArtifactGC.PodSpecPatch\")","+\t}","+\tif agc.ServiceAccountName != \"\" {","+\t\tviolations = append(violations, \"ArtifactGC.ServiceAccountName\")","+\t}","+\tif agc.PodMetadata != nil {","+\t\tviolations = append(violations, \"ArtifactGC.PodMetadata\")","+\t}","+\treturn violations","+}","+","+// sanitizeArtifactGC returns a deep copy of the workflow-level ArtifactGC with the","+// security-sensitive override fields removed, leaving the benign fields (Strategy,","+// ForceFinalizerRemoval) intact. A copy is returned so the caller's original spec","+// is never mutated.","+func sanitizeArtifactGC(agc *wfv1.WorkflowLevelArtifactGC) *wfv1.WorkflowLevelArtifactGC {","+\tif agc == nil {","+\t\treturn nil","+\t}","+\tclean := agc.DeepCopy()","+\tclean.PodSpecPatch = \"\"","+\tclean.ServiceAccountName = \"\"","+\tclean.PodMetadata = nil","+\treturn clean","+}","+"," // MergeTo will merge one workflow (the \"patch\" workflow) into another (the \"target\" workflow."," // If the target workflow defines a field, this take precedence over the patch."," func MergeTo(patch, target *wfv1.Workflow) error {"],"additions":47,"deletions":0,"truncated":false},{"path":"workflow/util/merge_test.go","lines":["@@ -710,6 +710,92 @@ func TestSanitizeUserWorkflowSpec_Nil(t *testing.T) {"," \tassert.Nil(t, SanitizeUserWorkflowSpec(nil))"," }"," ","+// TestValidateUserOverrides_ArtifactGCNestedFields guards against the","+// GHSA-3775-99mw-8rp4 (CVE-2026-42296) bug class: ArtifactGC is allow-listed,","+// but its nested ServiceAccountName/PodSpecPatch/PodMetadata reach the","+// artifact-GC Pod and so must be rejected under Strict/Secure mode.","+func TestValidateUserOverrides_ArtifactGCNestedFields(t *testing.T) {","+\tt.Run(\"benign ArtifactGC fields are allowed\", func(t *testing.T) {","+\t\tspec := &wfv1.WorkflowSpec{","+\t\t\tWorkflowTemplateRef: &wfv1.WorkflowTemplateRef{Name: \"my-template\"},","+\t\t\tArtifactGC: &wfv1.WorkflowLevelArtifactGC{","+\t\t\t\tArtifactGC:            wfv1.ArtifactGC{Strategy: wfv1.ArtifactGCOnWorkflowCompletion},","+\t\t\t\tForceFinalizerRemoval: true,","+\t\t\t},","+\t\t}","+\t\tassert.NoError(t, ValidateUserOverrides(spec))","+\t})","+","+\ttests := []struct {","+\t\tname  string","+\t\tagc   *wfv1.WorkflowLevelArtifactGC","+\t\tfield string","+\t}{","+\t\t{","+\t\t\tname:  \"ServiceAccountName\",","+\t\t\tagc:   &wfv1.WorkflowLevelArtifactGC{ArtifactGC: wfv1.ArtifactGC{ServiceAccountName: \"privileged\"}},","+\t\t\tfield: \"ArtifactGC.ServiceAccountName\",","+\t\t},","+\t\t{","+\t\t\tname:  \"PodSpecPatch\",","+\t\t\tagc:   &wfv1.WorkflowLevelArtifactGC{PodSpecPatch: `{\"containers\":[{\"name\":\"main\",\"image\":\"attacker/x\"}]}`},","+\t\t\tfield: \"ArtifactGC.PodSpecPatch\",","+\t\t},","+\t\t{","+\t\t\tname:  \"PodMetadata\",","+\t\t\tagc:   &wfv1.WorkflowLevelArtifactGC{ArtifactGC: wfv1.ArtifactGC{PodMetadata: &wfv1.Metadata{Labels: map[string]string{\"a\": \"b\"}}}},","+\t\t\tfield: \"ArtifactGC.PodMetadata\",","+\t\t},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tspec := &wfv1.WorkflowSpec{","+\t\t\t\tWorkflowTemplateRef: &wfv1.WorkflowTemplateRef{Name: \"my-template\"},","+\t\t\t\tArtifactGC:          tt.agc,","+\t\t\t}","+\t\t\terr := ValidateUserOverrides(spec)","+\t\t\trequire.Error(t, err)","+\t\t\tassert.Contains(t, err.Error(), tt.field)","+\t\t\tassert.Contains(t, err.Error(), \"not permitted\")","+\t\t})","+\t}","+}","+","+// TestSanitizeUserWorkflowSpec_ArtifactGC verifies defense-in-depth: the","+// security-sensitive nested ArtifactGC fields are stripped while benign ones are","+// kept, and the caller's original spec is not mutated.","+func TestSanitizeUserWorkflowSpec_ArtifactGC(t *testing.T) {","+\tspec := &wfv1.WorkflowSpec{","+\t\tWorkflowTemplateRef: &wfv1.WorkflowTemplateRef{Name: \"my-template\"},","+\t\tArtifactGC: &wfv1.WorkflowLevelArtifactGC{","+\t\t\tArtifactGC: wfv1.ArtifactGC{","+\t\t\t\tStrategy:           wfv1.ArtifactGCOnWorkflowCompletion,","+\t\t\t\tServiceAccountName: \"privileged\",","+\t\t\t\tPodMetadata:        &wfv1.Metadata{Labels: map[string]string{\"a\": \"b\"}},","+\t\t\t},","+\t\t\tForceFinalizerRemoval: true,","+\t\t\tPodSpecPatch:          `{\"containers\":[]}`,","+\t\t},","+\t}","+","+\tsanitized := SanitizeUserWorkflowSpec(spec)","+","+\t// Benign fields are preserved.","+\trequire.NotNil(t, sanitized.ArtifactGC)","+\tassert.Equal(t, wfv1.ArtifactGCOnWorkflowCompletion, sanitized.ArtifactGC.Strategy)","+\tassert.True(t, sanitized.ArtifactGC.ForceFinalizerRemoval)","+","+\t// Security-sensitive fields are stripped.","+\tassert.Empty(t, sanitized.ArtifactGC.ServiceAccountName)","+\tassert.Empty(t, sanitized.ArtifactGC.PodSpecPatch)","+\tassert.Nil(t, sanitized.ArtifactGC.PodMetadata)","+","+\t// The original spec must not be mutated.","+\tassert.Equal(t, \"privileged\", spec.ArtifactGC.ServiceAccountName)","+\tassert.JSONEq(t, `{\"containers\":[]}`, spec.ArtifactGC.PodSpecPatch)","+\tassert.NotNil(t, spec.ArtifactGC.PodMetadata)","+}","+"," // TestAllWorkflowSpecFieldsAccountedFor is a compile-time safety net."," // It ensures that every field in WorkflowSpec appears in either the"," // allowed or blocked list, so new fields force a conscious decision.",""],"additions":86,"deletions":0,"truncated":false}],"additions":133,"deletions":0,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-08-14T09:03:57.904366+00:00"}