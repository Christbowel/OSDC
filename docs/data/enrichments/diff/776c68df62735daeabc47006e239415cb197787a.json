{"id":"776c68df62735daeabc47006e239415cb197787a","axis":"silent","repo":"uber/deck.gl","sha":"776c68df62735daeabc47006e239415cb197787a","parsed":{"files":[{"path":"docs/api-reference/aggregation-layers/aggregator.md","lines":["@@ -59,9 +59,18 @@ Arguments:"," - `attributes` ([Attribute](../core/attribute.md)[]) - the input data."," - `operations` (string[]) - How to aggregate the values inside a bin, defined per channel."," - `binOptions` (object) - arbitrary settings that affect bin sorting.","+- `onNeedsRedraw` (() => void, optional; default: undefined) - requests another draw, for example to retry a metadata copy."," - `onUpdate` (Function) - callback when a channel has been recalculated. Receives the following arguments:","     + `channel` (number) - the channel that just updated"," ","+#### `setShaderContext(context)` (optional) {#setshadercontext}","+","+Default: undefined. Receives the layer's shader configuration after initialization and","+when extensions change. `context.shaders` contains plugins, modules, defines and the","+shader assembler. `context.getAttributeBindings()` returns current GPU attributes and","+buffer layouts. These bindings are borrowed. Release compiled shader resources when","+the context changes and in `destroy()`.","+"," #### `setNeedsUpdate` {#setneedsupdate}"," "," Flags a channel to need update. This could be a result of change in the input data or bin options.","@@ -159,6 +168,15 @@ aggregator.destroy();"," "," An implementation of `Aggregator` should expose the following members:"," ","+#### `supportsExtensions` (boolean, optional) {#supportsextensions}","+","+Default: undefined. Set to `false` to reject layer shader extensions when adopted.","+","+#### `requiresProjectedPositions` (boolean, optional) {#requiresprojectedpositions}","+","+Default: `false`. Set to `true` to require borrowed position vectors to already use","+the view coordinate system. Accessor inputs can use the layer's CPU preprojection.","+"," #### `binCount` (number) {#bincount}"," "," The number of bins in the aggregated result.","@@ -224,3 +242,85 @@ on the CPU, so you can compare CPU and GPU aggregation on the same buffers. It c"," columns back first, and the layer reports `isLoaded: false` until aggregation finishes."," Columns need `COPY_SRC` usage. See the [constructor docs](./cpu-aggregator.md#readbackaggregator)"," for accepted formats. Strided and interleaved columns work.","+","+For Cartesian GridLayer inputs, compare the native WebGPU aggregator with the CPU adapter.","+Both branches use the same WebGPU device; WebGL does not accept these borrowed columns:","+","+```typescript","+import {GridLayer, ReadbackAggregator} from '@deck.gl/aggregation-layers';","+import {Deck, OrthographicView} from '@deck.gl/core';","+import {luma} from '@luma.gl/core';","+import {webgpuAdapter} from '@luma.gl/webgpu';","+","+const device = await luma.createDevice({adapters: [webgpuAdapter], type: 'webgpu'});","+// Create positionVector and weight vectors on this same device.","+","+const createCPUAggregator = () => new ReadbackAggregator({","+  dimensions: 2,","+  weightAttributes: ['colorWeights', 'elevationWeights'],","+  getBin: {","+    sources: ['positions'],","+    getValue: ({positions}, index, {cellSizeCommon, cellOriginCommon}) => [","+      Math.floor((positions[0] - cellOriginCommon[0]) / cellSizeCommon[0]),","+      Math.floor((positions[1] - cellOriginCommon[1]) / cellSizeCommon[1])","+    ]","+  },","+  getValue: [","+    {sources: ['colorWeights'], getValue: ({colorWeights}) => colorWeights},","+    {sources: ['elevationWeights'], getValue: ({elevationWeights}) => elevationWeights}","+  ]","+});","+","+// Keep the adapter while CPU mode is active; replace it on each switch back to CPU.","+let cpuAggregator = null;","+function render(useCPU) {","+  if (useCPU && !cpuAggregator) cpuAggregator = createCPUAggregator();","+  if (!useCPU) cpuAggregator = null;","+  return new GridLayer({","+    coordinateSystem: 'cartesian',","+    gpuAggregation: true,","+    positions: positionVector,","+    weights: [colorWeightVector, elevationWeightVector],","+    dataBounds,","+    cellSize: 10,","+    colorDomain: [0, 100],","+    elevationDomain: [0, 100],","+    aggregator: useCPU ? cpuAggregator : undefined","+  });","+}","+const deck = new Deck({device, views: new OrthographicView(), layers: [render(false)]});","+// Switch modes with deck.setProps({layers: [render(useCPU)]}).","+```","+","+Limitations:","+","+- `getBin` receives untransformed positions. Project other coordinate systems in `getBin`.","+- Layer extensions do not apply. Picking returns bins, not original JavaScript objects.","+- The layer destroys removed adapters. Create a new one for each switch to CPU.","+- After writing to a buffer in place, call the adapter's `setNeedsUpdate()`.","+- CPU timings include readback. Compare end-to-end frame times.","+","+","+### _GraphScreenGridAggregator {#graphscreengridaggregator}","+","+`_GraphScreenGridAggregator` is an experimental alternative for applications that want","+to customize or extend ScreenGrid aggregation using GPU graphs. For ordinary","+`ScreenGridLayer` usage, keep the default `gpuAggregation: true` backend; this","+alternative does not add rendering features.","+","+```typescript","+import {ScreenGridLayer, _GraphScreenGridAggregator} from '@deck.gl/aggregation-layers';","+","+new ScreenGridLayer({","+  data,","+  getPosition: d => d.position,","+  aggregator: new _GraphScreenGridAggregator(),","+  colorDomain: [0, 100]","+});","+```","+","+It requires a WebGPU device and supports COUNT, SUM, MIN, MAX and MEAN.","+Picking and automatic domains update asynchronously. Extensions require accessor","+inputs; borrowed position vectors must already use the view coordinate system.","+The layer initializes and destroys the aggregator. Create a new instance after","+removing or replacing it. Its experimental API may change."],"additions":100,"deletions":0,"truncated":false},{"path":"docs/whats-new.md","lines":["@@ -4,6 +4,11 @@ This page contains highlights of each deck.gl release. Also check our [vis.gl bl"," "," ## Unreleased"," ","+### Optional graph aggregation","+","+The experimental [`_GraphScreenGridAggregator`](./api-reference/aggregation-layers/aggregator.md#graphscreengridaggregator)","+lets applications customize ScreenGrid aggregation using GPU graphs.","+"," ### Normalized color inputs"," "," Deck's [`normalizedColors`](./api-reference/core/deck.md#normalizedcolors) option enables"],"additions":5,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregation-layer.ts","lines":["@@ -69,6 +69,9 @@ export default abstract class AggregationLayer<","       return;","     }","     const {positions, weights, aggregator, extensions} = this.props;","+    if (aggregator?.requiresProjectedPositions && this.state.preproject) {","+      throw new Error('GPU aggregation positions must use the custom view coordinate system');","+    }","     if ((!aggregator && this.state.aggregatorType !== 'webgpu') || extensions.length || !weights) {","       throw new Error('GPU columns require a compatible aggregator, weights, and no extensions');","     }","@@ -323,6 +326,9 @@ export default abstract class AggregationLayer<","   // Extend Layer.updateState to update the Aggregator instance","   // returns true if aggregator is changed","   updateState(params: UpdateParameters<this>): boolean {","+    if (this.props.aggregator?.supportsExtensions === false && this.props.extensions.length) {","+      throw new Error('The supplied aggregator does not support shader extensions');","+    }","     super.updateState(params);","     if (this.props.weights && !this.props.positions) {","       throw new Error('GPU aggregation weights require positions');","@@ -350,8 +356,21 @@ export default abstract class AggregationLayer<","         // Extension changes refresh the supplied instance without destroying it.","         aggregator.setNeedsUpdate();","       }","+      aggregator.setShaderContext?.({","+        shaders: this.getAggregationShaders(),","+        getAttributeBindings: () => {","+          const manager = this.getCurrentLayer()!.getAttributeManager()!;","+          return {","+            attributes: manager.getGPUVectors(),","+            bufferLayouts: manager","+              .getBufferLayouts()","+              .map(layout => ({...layout, stepMode: 'instance' as const}))","+          };","+        }","+      });","       aggregator.setProps({","         onError: error => this.getCurrentLayer()?.raiseError(error, 'aggregation'),","+        onNeedsRedraw: () => this.getCurrentLayer()?.setNeedsRedraw(),","         attributes: this.getAttributeManager()?.attributes,","         positions: this.props.positions,","         weights: this.props.weights"],"additions":19,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregator/aggregator.ts","lines":["@@ -3,8 +3,20 @@"," // Copyright (c) vis.gl contributors"," "," import type {Attribute, BinaryAttribute} from '@deck.gl/core';","-import type {Device} from '@luma.gl/core';","-import type {GPUVector} from '@luma.gl/graph/gpu-data';","+import type {BufferLayout, Device} from '@luma.gl/core';","+import type {GPUConstant, GPUVector} from '@luma.gl/graph/gpu-data';","+import type {ModelProps} from '@luma.gl/engine';","+","+/** Layer-owned shader hooks and current attribute bindings for an aggregator. */","+export type AggregationShaderContext = {","+  /** Input shader plugins and their module dependencies. */","+  shaders: Pick<ModelProps, 'plugins' | 'shaderAssembler' | 'modules' | 'defines'>;","+  /** Resolve bindings from the current layer after attribute updates. */","+  getAttributeBindings: () => {","+    attributes: Record<string, GPUVector | GPUConstant>;","+    bufferLayouts: BufferLayout[];","+  };","+};"," "," /** Borrowed aggregation output; vectors use single-chunk float32 scalar/XY storage. */"," export type AggregationResult = BinaryAttribute | GPUVector;","@@ -34,6 +46,8 @@ export type AggregationProps = {","   binOptions: Record<string, number | number[]>;","   /** Report an asynchronous backend failure to the owning layer. */","   onError?: (error: Error) => void;","+  /** Request another draw, for example after a transient asynchronous failure. */","+  onNeedsRedraw?: () => void;","   /** Callback after a channel is updated */","   onUpdate?: (event: {channel: number}) => void;"," };","@@ -71,10 +85,16 @@ export type AggregatedBin = {","  *","  */"," export interface Aggregator {","+  /** Set to false to reject layer shader extensions. Unspecified preserves existing behavior. */","+  readonly supportsExtensions?: boolean;","+  /** Set to true if borrowed position vectors must already use the view coordinate system. */","+  readonly requiresProjectedPositions?: boolean;","   /** Whether output and requested asynchronous metadata are ready. */","   readonly isLoaded?: boolean;","   /** Called once when the layer adopts this instance, before setProps. */","   initialize?(device: Device): void;","+  /** Called after initialization and when layer extensions change. Bindings remain layer-owned. */","+  setShaderContext?(context: AggregationShaderContext): void;"," ","   /** Update aggregation props */","   setProps(props: Partial<AggregationProps>): void;"],"additions":22,"deletions":2,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregator/deck-graph/README.md","lines":["@@ -0,0 +1,14 @@","+# Deck aggregation graph operations","+","+`DeckAggregationInputsOperation` evaluates layer input shader hooks as an ordinary","+GPUGraph render node. It reads dense per-point bin keys and borrowed layer attributes,","+and writes packed float32 contributions plus a uint32 selection mask. Assignment","+clears the selection mask on every invocation, so discarded fragments stay excluded.","+","+The lowering declares buffer accesses and a graph-owned one-pixel color attachment.","+Shader models belong to the compiled node; attributes belong to the layer. Uniform","+and attribute changes are supplied through `AggregationShaderContext`. Changing","+buffer identities or layouts rebuilds the graph's resource declarations.","+","+This operation stays in deck because it uses deck geometry and extension hooks.","+Grouped aggregation uses luma.gl’s `GPUGraphGroupAggregation` and its built-in compiler lowering."],"additions":14,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregator/deck-graph/deck-aggregation-inputs-operation.ts","lines":["@@ -0,0 +1,167 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import {_GPUVectorModel as GPUVectorModel} from '@deck.gl/core';","+import {Buffer, Texture} from '@luma.gl/core';","+import {GPUVector, getGPUVectorData} from '@luma.gl/graph/gpu-data';","+import type {","+  GPUOperation,","+  GPUOperationContract,","+  GPUOperationLowering","+} from '@luma.gl/graph/gpu-graph';","+import type {AggregationShaderContext} from '../aggregator';","+import {aggregationUniforms} from '../webgpu-aggregator/aggregation-uniforms';","+","+/** Per-encoding layer inputs; logical ports stay stable while uniforms and attributes change. */","+export type DeckAggregationInputs = ReturnType<AggregationShaderContext['getAttributeBindings']> & {","+  context: AggregationShaderContext;","+  shaderModuleProps: Record<string, any>;","+  settings: Record<string, any>;","+};","+","+/** Signals an incomplete model without publishing partially encoded aggregation results. */","+export class AggregationInputsNotReady extends Error {}","+","+const source = /* wgsl */ `","+@group(0) @binding(auto) var<storage, read> keys: array<u32>;","+@group(0) @binding(auto) var<storage, read_write> contributions: array<f32>;","+@group(0) @binding(auto) var<storage, read_write> selection: array<u32>;","+struct Attributes {","+  @builtin(vertex_index) vertexIndex: u32,","+  @builtin(instance_index) instanceIndex: u32,","+  @location(0) positions: vec3f,","+  @location(1) positions64Low: vec3f,","+  @location(2) counts: f32,","+};","+struct Varyings {","+  @builtin(position) position: vec4f,","+  @location(0) @interpolate(flat) row: u32,","+  @location(1) weights: vec4f,","+};","+@vertex fn vertexMain(attributes: Attributes) -> Varyings {","+  var varyings: Varyings;","+  geometry.worldPosition = attributes.positions;","+  geometry.position = vec4f(project_position_vec3_f64(attributes.positions, attributes.positions64Low), 1.0);","+  geometry.uv = vec2f(0.0);","+  var clip = project_common_position_to_clipspace(geometry.position);","+  DECKGL_FILTER_GL_POSITION(&clip, geometry);","+  let corners = array<vec2f, 6>(vec2f(-1.0,-1.0), vec2f(1.0,-1.0), vec2f(-1.0,1.0), vec2f(-1.0,1.0), vec2f(1.0,-1.0), vec2f(1.0,1.0));","+  varyings.position = vec4f(corners[attributes.vertexIndex], 0.0, 1.0);","+  varyings.row = attributes.instanceIndex;","+  varyings.weights = vec4f(attributes.counts, 1.0, 1.0, 1.0);","+  return varyings;","+}","+@fragment fn fragmentMain(varyings: Varyings) -> @location(0) vec4f {","+  if (keys[varyings.row] >= aggregation.counts.y) { return vec4f(0.0); }","+  fragmentGeometry.uv = vec2f(0.0);","+  var color = varyings.weights;","+  DECKGL_FILTER_COLOR(&color, fragmentGeometry);","+  contributions[varyings.row] = color.x;","+  selection[varyings.row] = 1u;","+  return vec4f(0.0);","+}`;","+","+/** Deck input hooks producing the mask and weights consumed by generic grouped reductions. */","+export class DeckAggregationInputsOperation implements GPUOperation {","+  /** Semantic operation discriminator. */","+  readonly type = 'deck-aggregation-inputs';","+  /** Stable identifier for the input shader operation. */","+  readonly id = 'deck-aggregation-inputs';","+  /** Capture borrowed layer shaders and input bindings. */","+  constructor(readonly inputs: DeckAggregationInputs) {}","+  /** Describe group-key reads and filtered contribution writes. */","+  get contract(): GPUOperationContract {","+    return {","+      values: [","+        {value: 'keys', access: 'read'},","+        {value: 'contributions', access: 'write'},","+        {value: 'selection', access: 'write'}","+      ]","+    };","+  }","+}","+","+/** Concrete borrowed attribute buffers whose identities determine graph resource declarations. */","+export function getAggregationAttributeBuffers(","+  attributes: DeckAggregationInputs['attributes']","+): Buffer[] {","+  const buffers = new Set<Buffer>();","+  for (const vector of Object.values(attributes)) {","+    if (vector instanceof GPUVector) {","+      const {buffer} = getGPUVectorData(vector);","+      if (buffer instanceof Buffer) buffers.add(buffer);","+    }","+  }","+  return [...buffers];","+}","+","+/** Lower deck hooks to an ordinary graph render node with explicit buffer dependencies. */","+export const deckAggregationInputsLowering: GPUOperationLowering = {","+  type: 'deck-aggregation-inputs',","+  lower(operation, context) {","+    const {inputs, id} = operation as DeckAggregationInputsOperation;","+    const keys = context.resolveVector<'uint32'>('keys').data[0];","+    const contributions = context.resolveVector<'float32'>('contributions').data[0];","+    const selection = context.resolveVector<'uint32'>('selection').data[0];","+    const attributes = getAggregationAttributeBuffers(inputs.attributes).map((buffer, index) => ({","+      buffer: context.graph.importBuffer(","+        {id: `${id}-attribute-${index}`, byteLength: buffer.byteLength, usage: buffer.usage},","+        buffer","+      ),","+      usage: buffer.usage & Buffer.VERTEX ? ('vertex' as const) : ('storage-read' as const)","+    }));","+    const target = context.graph.createTransientTexture({","+      id: `${id}-target`,","+      format: 'rgba8unorm',","+      width: 1,","+      height: 1,","+      usage: Texture.RENDER_ATTACHMENT","+    });","+    context.graph.addRenderPass({","+      id,","+      attachments: {colorAttachments: [context.graph.createTextureView(target)]},","+      resources: [","+        {buffer: keys, usage: 'storage-read'},","+        {buffer: contributions, usage: 'storage-write'},","+        {buffer: selection, usage: 'storage-write'},","+        ...attributes","+      ],","+      compile({device}) {","+        const model = new GPUVectorModel(device, {","+          ...inputs.context.shaders,","+          id,","+          source,","+          modules: [...(inputs.context.shaders.modules || []), aggregationUniforms],","+          vertexCount: 6,","+          isInstanced: true,","+          topology: 'triangle-list',","+          colorAttachmentFormats: ['rgba8unorm'],","+          parameters: {depthWriteEnabled: false}","+        });","+        return {","+          getRenderPassProps({commandEncoder, getBuffer}) {","+            model.setGPUAttributes(inputs.attributes, inputs.bufferLayouts);","+            model.setInstanceCount(inputs.settings.counts[0]);","+            model.setBindings({","+              keys: getBuffer(keys),","+              contributions: getBuffer(contributions),","+              selection: getBuffer(selection)","+            });","+            model.shaderInputs.setProps({","+              ...inputs.shaderModuleProps,","+              aggregation: inputs.settings","+            });","+            model.predraw(commandEncoder);","+            return {clearColor: [0, 0, 0, 0]};","+          },","+          encode({renderPass}) {","+            if (!model.draw(renderPass))","+              throw new AggregationInputsNotReady('Aggregation shader inputs are not ready');","+          },","+          destroy: () => model.destroy()","+        };","+      }","+    });","+  }","+};"],"additions":167,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregator/index.ts","lines":["@@ -10,7 +10,8 @@ export type {","   Aggregator,","   AggregatedBin,","   AggregationOperation,","-  AggregationProps","+  AggregationProps,","+  AggregationShaderContext"," } from './aggregator';"," export type {CPUAggregatorProps} from './cpu-aggregator/cpu-aggregator';"," export type {WebGLAggregatorProps} from './gpu-aggregator/webgl-aggregator';"],"additions":2,"deletions":1,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregator/webgpu-aggregator/aggregation-uniforms.ts","lines":["@@ -0,0 +1,30 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+export const aggregationUniforms = {","+  name: 'aggregation',","+  source: `struct AggregationUniforms {","+    counts: vec4u,","+    operations: vec4u,","+    binRange: vec4i,","+    positionLayout: vec4u,","+    lowLayout: vec4u,","+    weightLayout0: vec4u,","+    weightLayout1: vec4u,","+    weightLayout2: vec4u,","+    dispatchWidth: u32,","+  };","+  @group(0) @binding(auto) var<uniform> aggregation: AggregationUniforms;`,","+  uniformTypes: {","+    counts: 'vec4<u32>',","+    operations: 'vec4<u32>',","+    binRange: 'vec4<i32>',","+    positionLayout: 'vec4<u32>',","+    lowLayout: 'vec4<u32>',","+    weightLayout0: 'vec4<u32>',","+    weightLayout1: 'vec4<u32>',","+    weightLayout2: 'vec4<u32>',","+    dispatchWidth: 'u32'","+  }","+} as const;"],"additions":30,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/common/aggregator/webgpu-aggregator/webgpu-aggregator.ts","lines":["@@ -4,6 +4,8 @@"," "," import {project32, _GPUVectorModel as GPUVectorModel, _deepEqual as deepEqual} from '@deck.gl/core';"," import {Buffer, type Device, type Texture, type Framebuffer} from '@luma.gl/core';","+import {aggregationUniforms} from './aggregation-uniforms';","+import {snapshotUniformProps} from '../../utils/prop-utils';"," import {getFilterSource} from './filter.wgsl';"," import {Computation, type ModelProps} from '@luma.gl/engine';"," import type {ShaderModule} from '@luma.gl/shaders';","@@ -22,48 +24,6 @@ export type WebGPUAggregatorOptions = {","   binOptions: ShaderModule;"," };"," ","-const aggregationUniforms = {","-  name: 'aggregation',","-  source: `struct AggregationUniforms {","-    counts: vec4u,","-    operations: vec4u,","-    binRange: vec4i,","-    positionLayout: vec4u,","-    lowLayout: vec4u,","-    weightLayout0: vec4u,","-    weightLayout1: vec4u,","-    weightLayout2: vec4u,","-    dispatchWidth: u32,","-  };","-  @group(0) @binding(auto) var<uniform> aggregation: AggregationUniforms;`,","-  uniformTypes: {","-    counts: 'vec4<u32>',","-    operations: 'vec4<u32>',","-    binRange: 'vec4<i32>',","-    positionLayout: 'vec4<u32>',","-    lowLayout: 'vec4<u32>',","-    weightLayout0: 'vec4<u32>',","-    weightLayout1: 'vec4<u32>',","-    weightLayout2: 'vec4<u32>',","-    dispatchWidth: 'u32'","-  }","-} as const;","-","-// Keep plain uniform values by value, but retain resource identity and revision.","-function snapshotUniformProps(value: any, depth = 4): any {","-  if (!value || typeof value !== 'object' || depth === 0) return value;","-  if (Array.isArray(value) || ArrayBuffer.isView(value))","-    return Array.from(value as ArrayLike<unknown>);","-  if (Object.getPrototypeOf(value) !== Object.prototype) {","-    return typeof value.updateTimestamp === 'number'","-      ? {resource: value, revision: value.updateTimestamp}","-      : value;","-  }","-  return Object.fromEntries(","-    Object.entries(value).map(([key, entry]) => [key, snapshotUniformProps(entry, depth - 1)])","-  );","-}","-"," /** Shared dense-bin compute reduction. Layer adapters supply only bin assignment. @internal */"," export class WebGPUAggregator implements Aggregator {","   /** Check declared binary storage before selecting a backend from stale attributes. */"],"additions":2,"deletions":42,"truncated":false},{"path":"modules/aggregation-layers/src/common/utils/prop-utils.ts","lines":["@@ -11,3 +11,18 @@ export function filterProps(props, filterKeys) {","   }","   return filteredProps;"," }","+","+// Keep plain uniform values by value, but retain resource identity and revision.","+export function snapshotUniformProps(value: any, depth = 4): any {","+  if (!value || typeof value !== 'object' || depth === 0) return value;","+  if (Array.isArray(value) || ArrayBuffer.isView(value))","+    return Array.from(value as ArrayLike<unknown>);","+  if (Object.getPrototypeOf(value) !== Object.prototype) {","+    return typeof value.updateTimestamp === 'number'","+      ? {resource: value, revision: value.updateTimestamp}","+      : value;","+  }","+  return Object.fromEntries(","+    Object.entries(value).map(([key, entry]) => [key, snapshotUniformProps(entry, depth - 1)])","+  );","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/index.ts","lines":["@@ -26,7 +26,10 @@ export type {","   Aggregator,","   AggregationOperation,","   AggregationProps,","+  AggregationShaderContext,","   WebGLAggregatorProps,","   CPUAggregatorProps,","   ReadbackAggregatorProps"," } from './common/aggregator/index';","+","+export {GraphScreenGridAggregator as _GraphScreenGridAggregator} from './screen-grid-layer/graph-screen-grid-aggregator';"],"additions":3,"deletions":0,"truncated":false},{"path":"modules/aggregation-layers/src/screen-grid-layer/graph-screen-grid-aggregator.ts","lines":["@@ -0,0 +1,386 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import {snapshotUniformProps} from '../common/utils/prop-utils';","+import {AggregationInputsNotReady} from '../common/aggregator/deck-graph/deck-aggregation-inputs-operation';","+import {project32, _deepEqual as deepEqual} from '@deck.gl/core';","+import {Buffer, type Device} from '@luma.gl/core';","+import {Computation} from '@luma.gl/engine';","+import {GPUVector} from '@luma.gl/graph/gpu-data';","+import type {","+  Aggregator,","+  AggregationProps,","+  AggregationShaderContext","+} from '../common/aggregator/aggregator';","+import {AggregationColumnPreparation} from '../common/aggregator/webgpu-aggregator/column-preparation';","+import {ScreenGridGraph} from './screen-grid-graph';","+import {aggregationUniforms} from '../common/aggregator/webgpu-aggregator/aggregation-uniforms';","+import {finalizeSource} from '../common/aggregator/webgpu-aggregator/reduce.wgsl';","+import {binOptionsUniforms} from './bin-options-uniforms';","+","+const screenGridBinning = `fn getBin(position: vec3f, low: vec3f) -> BinAssignment {","+  let clip = project_position_to_clipspace(position, low, vec3f(0.0));","+  let viewport = project.viewportSize / project.devicePixelRatio;","+  let pixel = vec2f(clip.x / clip.w + 1.0, 1.0 - clip.y / clip.w) * 0.5 * viewport;","+  let valid = clip.w > 0.0 && all(pixel >= vec2f(0.0)) && all(pixel < viewport);","+  return BinAssignment(vec2i(floor(pixel / binOptions.cellSizePixels)), valid);","+}`;","+","+/** Opt-in ScreenGridLayer aggregation using GPU graph operations.","+ * Pass an instance as the layer's `aggregator` prop. The layer initializes and destroys","+ * it; input vectors remain borrowed. Input shader hooks run as deck graph operations.","+ */","+export class GraphScreenGridAggregator implements Aggregator {","+  /** Input shader extensions are evaluated before grouped reduction. */","+  readonly supportsExtensions = true;","+  /** Borrowed positions cannot be converted on the CPU by this graph implementation. */","+  readonly requiresProjectedPositions = true;","+  /** Number of dense screen cells in the current grid. */","+  binCount = 0;","+  /** Whether requested output metadata is ready. */","+  get isLoaded(): boolean {","+    return !this.dirty && (!this.props.readback || this.snapshot !== null);","+  }","+  /** Current aggregation inputs and callbacks. */","+  private props: AggregationProps = {pointCount: 0, attributes: {}, operations: [], binOptions: {}};","+  /** Borrowed extension shader configuration from the layer. */","+  private shaderContext