n cold_revision_mock_command(","+    revision: &str,","+    binary: &Path,","+    bench_dir: &Path,","+    mock_port: u16,","+    public_url: &str,","+    origin_url: &str,","+) -> Command {","+    let cold_storage = bench_dir.join(\"cold-mock-storage\");","+    let config_path = bench_dir.join(\"cold-mock-config.yaml\");","+    fs::write(&config_path, cold_mock_config_yaml(&cold_storage, origin_url))","+        .expect(\"write cold mock config\");","+    eprintln!(","+        \"Serving {revision}'s tarballs from a COLD mock built from pnpr@{revision} on 127.0.0.1:{mock_port} (origin {origin_url})...\",","+    );","+    let mut command = Command::new(binary);","+    command","+        .arg(\"--config\")","+        .arg(&config_path)","+        .arg(\"--storage\")","+        .arg(&cold_storage)","+        .arg(\"--listen\")","+        .arg(format!(\"127.0.0.1:{mock_port}\"))","+        .arg(\"--public-url\")","+        .arg(public_url)","+        .arg(\"--packument-ttl-secs\")","+        .arg(\"31536000\");","+    command","+}"," /// The cold mock config, serialized rather than string-formatted so the"," /// `storage` path and `origin` URL are escaped and the structure can't drift."," #[derive(Serialize)]"],"additions":36,"deletions":1,"truncated":false},{"path":"pnpm/tasks/integrated-benchmark/src/work_env/servers.rs","lines":["@@ -1,6 +1,6 @@"," use super::{","     BenchId, PNPR_SERVER_REGISTRY_ENV, PNPR_TARBALL_REWRITE_FROM_ENV, PnprServer, PnprServerPaths,","-    RevisionMockRegistry, WorkEnv, append_pnpr_auth_to_npmrc, cold_mock_config_yaml,","+    RevisionMockRegistry, WorkEnv, append_pnpr_auth_to_npmrc, cold_revision_mock_command,","     distinct_public_route_registries, mint_pnpr_token, seed_pnpr_auth, serves_npm_under_base_path,","     wait_for_pnpr_ready, write_pnpr_benchmark_config,"," };","@@ -72,20 +72,8 @@ impl WorkEnv {","             .expect(\"create revision mock stderr log\");"," ","         let cold = self.options.selection.scenario.is_some_and(BenchmarkScenario::cold_pnpr_cache);","-        let mut command = if cold {","-            self.cold_revision_mock_command(","-                revision,","-                &binary,","-                &bench_dir,","-                mock_port,","-                &registry.origin,","-            )","-        } else {","-            eprintln!(","-                \"Serving {revision}'s tarballs from a mock built from pnpr@{revision} on 127.0.0.1:{mock_port}...\",","-            );","-            pnpm_registry_mock::pnpr_command_with_binary(&binary, mock_port, Some(&registry.origin))","-        };","+        let (mut command, origin) =","+            self.revision_mock_command(revision, &binary, &bench_dir, mock_port, &registry.origin);","         self.apply_serve_timing(&mut command);","         let process = command","             .stdin(Stdio::null())","@@ -94,43 +82,84 @@ impl WorkEnv {","             .spawn()","             .expect(if cold { \"spawn cold revision mock\" } else { \"spawn revision mock\" });"," ","-        let mut server = PnprServer { process, latency_proxy: None };","+        let mut server = PnprServer { process, latency_proxy: None, origin };","         wait_for_pnpr_ready(mock_port);","         self.follow_revision_npm_base_path(revision, &registry.origin, mock_port);","         server.latency_proxy =","             Some(self.front_revision_mock(revision, registry.listener, mock_port));","         server","     }","-    /// Use isolated storage, wiped between iterations, with the warm mock as origin.","-    fn cold_revision_mock_command(","+    fn revision_mock_command(","         &self,","         revision: &str,","         binary: &Path,","         bench_dir: &Path,","         mock_port: u16,","         public_url: &str,","-    ) -> Command {","-        let cold_storage = bench_dir.join(\"cold-mock-storage\");","-        let config_path = bench_dir.join(\"cold-mock-config.yaml\");","-        fs::write(&config_path, cold_mock_config_yaml(&cold_stora