+860,12 @@ fn lock_unserved_version_of_dep(workspace: &Path) {","             .expect(\"parse pnpm-lock.yaml\");","     for section in [\"packages\", \"snapshots\"] {","         let entries = lockfile[section].as_object_mut().expect(\"the lockfile has the section\");","-        let entry = entries.remove(&locked_key).expect(\"the section has the locked entry\");","+        let mut entry = entries.remove(&locked_key).expect(\"the section has the locked entry\");","+        if let Some(resolution) =","+            entry.get_mut(\"resolution\").and_then(serde_json::Value::as_object_mut)","+        {","+            resolution.remove(\"tarball\");","+        }","         entries.insert(unserved_key.clone(), entry);","     }","     for snapshot in lockfile[\"snapshots\"]"],"additions":6,"deletions":1,"truncated":false},{"path":"pnpm/crates/env-installer/src/tests/release_age.rs","lines":["@@ -65,7 +65,8 @@ async fn resolves_a_pinned_config_dep_newer_than_the_release_age_cutoff() {","     dbg!(resolution);","     assert!(matches!(","         resolution,","-        LockfileResolution::Registry(registry) if registry.integrity.to_string() == integrity,","+        LockfileResolution::Tarball(tarball)","+            if tarball.integrity.as_ref().map(ToString::to_string).as_deref() == Some(integrity.as_str()),","     ));","     assert!(","         root.path()"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/tests/modules_dir_disabled.rs","lines":["@@ -32,6 +32,13 @@ fn project(registry: &TestRegistry) -> Project {","     config.install_state_dir = modules_dir.join(\".pacquet\");","     config.modules_dir = modules_dir;","     config.registry = registry.url().to_string();","+    config.registry_options_by_url.insert(","+        registry.url().to_string(),","+        pnpm_lockfile::RegistryOptions {","+            server_type: Some(pnpm_lockfile::RegistryServerType::Pnpr),","+            ..Default::default()","+        },","+    );"