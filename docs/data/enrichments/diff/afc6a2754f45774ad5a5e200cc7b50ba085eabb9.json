econcileSource Action = \"ReconcileSource\"","+","+\t// ActionVerifySource validates the authenticity of the acquired source,","+\t// using PGP or SSH for GitRepository and Cosign or Notation for","+\t// OCIRepository and HelmChart. It runs as part of ReconcileSource.","+\tActionVerifySource Action = \"VerifySource\"","+","+\t// ActionReconcileArtifact archives the acquired content into an immutable","+\t// Artifact, persists it under the per-object storage lock and publishes","+\t// the artifact URL and revision.","+\tActionReconcileArtifact Action = \"ReconcileArtifact\"","+","+\t// ActionGarbageCollect prunes stale artifacts from storage, honoring the","+\t// configured retention TTL and record count.","+\tActionGarbageCollect Action = \"GarbageCollect\"","+","+\t// ActionFinalize garbage collects the object's artifacts and removes the","+\t// finalizer when the source is deleted.","+\tActionFinalize Action = \"Finalize\"","+)"],"additions":62,"deletions":0,"truncated":false},{"path":"api/v1/condition_types.go","lines":["@@ -75,6 +75,10 @@ const ("," \t// check failed."," \tVerificationError string = \"VerificationError\""," ","+\t// ArtifactVerificationFailedReason signals that the integrity verification","+\t// of an Artifact in storage failed.","+\tArtifactVerificationFailedReason string = \"ArtifactVerificationFailed\"","+"," \t// DirCreationFailedReason signals a failure caused by a directory creation"," \t// operation."," \tDirCreationFailedReason string = \"DirectoryCreationFailed\"","@@ -102,6 +106,18 @@ const ("," \t// with the Source."," \tArtifactUpToDateReason string = \"ArtifactUpToDate\""," ","+\t// NewArtifactReason signals that a new Artifact has been stored for the","+\t// Source.","+\tNewArtifactReason string = \"NewArtifact\"","+","+\t// NoSourceArtifactReason signals that the referenced Source does not yet","+\t// have an Artifact available.","+\tNoSourceArtifactReason string = \"NoSourceArtifact\"","+","+\t// GarbageCollectionSucceededReason 