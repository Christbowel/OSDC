se::headers::HEADER_CLIENT_CAPABILITIES;","+use databend_common_base::headers::HEADER_SESSION;","+use databend_common_base::headers::HEADER_TENANT;","+use databend_query::test_kits::ConfigBuilder;","+use databend_query::test_kits::TestFixture;","+use http::HeaderMap;","+use http::HeaderValue;","+use http::Method;","+use http::StatusCode;","+use poem::Route;","+use serde_json::json;","+","+use super::http_query_handlers::TestQueryResponse;","+use super::http_query_handlers::create_endpoint;","+use super::query_token::admin_sql;","+use super::query_token::basic_headers;","+use super::query_token::client_session_header;","+use super::query_token::request;","+use super::query_token::start;","+use super::query_token::start_query;","+","+async fn get(ep: &Route, uri: &str, headers: HeaderMap) -> StatusCode {","+    request(ep, Method::GET, uri, headers, json!(null))","+        .await","+        .status()","+}","+","+async fn submit(ep: &Route, headers: HeaderMap) -> StatusCode {","+    let body = json!({\"sql\": \"SELECT 1\", \"pagination\": {\"wait_time_secs\": 5}});","+    request(ep, Method::POST, \"/v1/query\", headers, body)","+        .await","+        .status()","+}","+","+async fn create_admin_user(","+    ep: &Route,","+    user: &str,","+    password: &str,","+    extra: &str,","+) -> anyhow::Result<()> {","+    admin_sql(","+        ep,","+        &format!(\"CREATE USER {user} IDENTIFIED BY '{password}' {extra}\"),","+    )","+    .await?;","+    admin_sql(ep, &format!(\"GRANT ROLE account_admin TO {user}\")).await","+}","+","+#[tokio::test(flavor = \"current_thread\")]","+async fn test_credential_binding_survives_password_change() -> anyhow::Result<()> {","+    let _fixture = TestFixture::setup().await?;","+    let ep = create_endpoint()?;","+    create_admin_user(&ep, \"binding_user\", \"before\", \"\").await?;","+    let old = basic_headers(\"binding_user\", \"before\");","+    let new = basic_headers(\"binding_user\", \"after\");","+    let result = start(&ep, with_ip(old.clone(), \"192.0.2.1\")).await?;","+    let state_uri = format!(\"/v1/query/{}\", result.id);","+    admin_sql(&ep, \"ALTER USER binding_user IDENTIFIED BY 'after'\").await?;","+","+    // Without a network policy the binding is independent of the client IP.","+    assert_eq!(","+        get(&ep, &state_uri, with_ip(old.clone(), \"192.0.2.2\")).await,","+        StatusCode::OK","+    );","+    assert_eq!(","+        get(&ep, result.next_uri.as_ref().unwrap(), old.clone()).await,","+        StatusCode::OK","+    );","+    assert_eq!(submit(&ep, old.clone()).await, StatusCode::UNAUTHORIZED);","+","+    // A different credential falls back to ordinary authentication.","+    assert_eq!(get(&ep, &state_uri, new.clone()).await, StatusCode::OK);","+    let wrong = basic_headers(\"binding_user\", \"wrong\");","+    assert_eq!(get(&ep, &state_uri, wrong).await, StatusCode::UNAUTHORIZED);","+    assert_eq!(submit(&ep, new).await, StatusCode::OK);","+","+    // Like query tokens, the binding does not depend on the user still existing.","+    admin_sql(&ep, \"DROP USER binding_user\").await?;","+    assert_eq!(get(&ep, &state_uri, old.clone()).await, StatusCode::OK);","+    let final_response = request(","+        &ep,","+        Method::POST,","+        result.final_uri.as_ref().unwrap(),","+        old,","+        json!(null),","+    )","+    .await;","+    assert_eq!(final_response.status(), StatusCode::OK);","+    Ok(())","+}","+","+#[tokio::test(flavor = \"current_thread\")]","+async fn test_credential_binding_is_per_query() -> anyhow::Result<()> {","+    let _fixture = TestFixture::setup().await?;","+    let ep = create_endpoint()?;","+    create_admin_user(&ep, \"binding_a\", \"before\", \"\").await?;","+    create_admin_user(&ep, \"binding_b\", \"secret\", \"\").await?;","+    let a = basic_headers(\"binding_a\", \"before\");","+    let b = basic_headers(\"binding_b\", \"secret\");","+    let query_a = start(&ep, a.clone()).await?;","+    let query_b = start(&ep, b.clone()).await?;","+    admin_sql(&ep, \"ALTER USER binding_a IDENTIFIED BY 'after'\").await?;","+","+    // A's stale credential is bound to A's query, not to B's.","+    let uri_b = format!(\"/v1/query/{}\", query_b.id);","+    assert_eq!(get(&ep, &uri_b, a.clone()).await, StatusCode::UNAUTHORIZED);","+    // B's valid credential still cannot access A's query.","+    let uri_a = format!(\"/v1/query/{}\", query_a.id);","+    assert_eq!(get(&ep, &uri_a, b).await, StatusCode::UNAUTHORIZED);","+    assert_eq!(get(&ep, &uri_a, a).await, StatusCode::OK);","+    Ok(())","+}","+","+#[tokio::test(flavor = \"current_thread\")]","+async fn test_credential_binding_includes_requested_tenant() -> anyhow::Result<()> {","+    let mut config = ConfigBuilder::create().build();","+    config.query.common.management_mode = true;","+    let _fixture = TestFixture::setup_with_config(&config).await?;","+    let ep = create_endpoint()?;","+    let mut headers = basic_headers(\"root\", \"\");","+    headers.insert(HEADER_TENANT, HeaderValue::from_static(\"binding-tenant\"));","+    let result: TestQueryResponse = start_query(&ep, headers.clone(), 60, \"SHOW SETTINGS\").await?;","+    let uri = format!(\"/v1/query/{}\", result.id);","+    assert_eq!(get(&ep, &uri, headers.clone()).await, StatusCode::OK);","+","+    headers.insert(HEADER_TENANT, HeaderValue::from_static(\"another-tenant\"));","+    assert_eq!(get(&ep, &uri, headers).await, StatusCode::UNAUTHORIZED);","+    Ok(())","+}","+","+#[tokio::test(flavor = \"current_thread\")]","+async fn test_credential_binding_avoids_password_lockout() -> anyhow::Result<()> {","+    let _fixture = TestFixture::setup().await?;","+    let ep = create_endpoint()?;","+    admin_sql(","+        &ep,","+        \"CREATE PASSWORD POLICY binding_policy PASSWORD_MAX_RETRIES = 1 PASSWORD_LOCKOUT_TIME_MINS = 10\",","+    )","+    .await?;","+    create_admin_user(","+        &ep,","+        \"binding_policy_user\",","+        \"Before12345\",","+        \"WITH SET PASSWORD POLICY = 'binding_policy'\",","+    )","+    .await?;","+    let old = basic_headers(\"binding_policy_user\", \"Before12345\");","+    let result = start(&ep, old.clone()).await?;","+    admin_sql(","+        &ep,","+        \"ALTER USER binding_policy_user IDENTIFIED BY 'After123456'\",","+    )","+    .await?;","+","+    // Bound polls are not login attempts, so they cannot count as failures.","+    let uri = format!(\"/v1/query/{}\", result.id);","+    for _ in 0..3 {","+        assert_eq!(get(&ep, &uri, old.clone()).await, StatusCode::OK);","+    }","+    let new = basic_headers(\"binding_policy_user\", \"After123456\");","+    assert_eq!(submit(&ep, new).await, StatusCode::OK);","+    Ok(())","+}","+","+fn with_session(mut headers: HeaderMap, session_id: Option<&str>) -> HeaderMap {","+    headers.insert(","+        HEADER_CLIENT_CAPABILITIES,","+        HeaderValue::from_static(\"session_header\"),","+    );","+    if let Some(id) = session_id {","+        headers.insert(HEADER_SESSION, client_session_header(id));","+    }","+    headers","+}","+","+fn bearer(token: &str) -> HeaderMap {","+    let mut headers = HeaderMap::new();","+    headers.insert(","+        http::header::AUTHORIZATION,","+        HeaderValue::from_str(&format!(\"Bearer {token}\")).unwrap(),","+    );","+    headers","+}","+","+#[tokio::test(flavor = \"current_thread\")]","+async fn test_credential_binding_stays_in_client_session() -> anyhow::Result<()> {","+    let _fixture = TestFixture::setup().await?;","+    let ep = create_endpoint()?;","+    create_admin_user(&ep, \"binding_session_user\", \"before\", \"\").await?;","+    let old = basic_headers(\"binding_session_user\", \"before\");","+    let new = basic_headers(\"binding_session_user\", \"after\");"],"additions":206,"deletions":0,"truncated":false}],"additions":535,"deletions":5,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-27T19:04:23.711359+00:00"}