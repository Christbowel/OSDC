{"id":"848c7323c82c502717527b864858c7235b276da9","axis":"silent","repo":"TryGhost/Ghost","sha":"848c7323c82c502717527b864858c7235b276da9","parsed":{"files":[{"path":"ghost/core/server/adapters/upgrade/HttpUpgradeAdapter.ts","lines":["@@ -0,0 +1,241 @@","+import path from 'node:path';","+import errors from '@tryghost/errors';","+import { Agent, request as send } from 'undici';","+import { z } from 'zod';","+import {","+  UpgradeAdapterError,","+  UpgradeBase,","+  upgradeDiagnosticsSchema,","+  upgradeErrorCodeSchema,","+  upgradeJobIdSchema,","+  upgradeJobResultSchema,","+  upgradeJobSchema,","+  upgradeStatusSchema,","+  type CreateUpgradeRequest,","+  type UpgradeDiagnostic,","+  type UpgradeJob,","+  type UpgradeJobResult,","+  type UpgradeStatus,","+} from '@tryghost/adapter-base-upgrade';","+","+// Implements ghost-docker's docs/upgrade-supervisor.md, protocol 1.","+export const PROTOCOL = 1;","+","+// Protocol bodies are a few KiB; anything far larger is not a protocol answer.","+const MAX_RESPONSE_BYTES = 1024 * 1024;","+","+// Protocol answers are immediate; anything slower is a stuck or missing host.","+const DEFAULT_TIMEOUT_MS = 5000;","+","+const configSchema = z.object({","+  /** The Unix socket the host serves the API on, such as ghost-docker's supervisor. */","+  socketPath: z","+    .string({ error: 'HttpUpgradeAdapter requires socketPath.' })","+    .refine(path.isAbsolute, { error: 'HttpUpgradeAdapter socketPath must be absolute.' }),","+});","+","+export const handshakeSchema = z.object({ protocol: z.literal(PROTOCOL) });","+","+export const errorBodySchema = z.object({","+  error: z.object({ code: z.string(), diagnostics: upgradeDiagnosticsSchema.optional() }),","+});","+","+interface Response {","+  status: number;","+  body: unknown;","+}","+","+/** The host could not be reached; an error the API reports as unavailable, not a bug. */","+class Unreachable extends Error {","+  constructor({ message }: { message: string }) {","+    super(message);","+  }","+}","+","+const unreachableCodes = new Set([","+  'ENOENT',","+  'ECONNREFUSED',","+  'ECONNRESET',","+  'EPIPE',","+  'UND_ERR_SOCKET',","+  'UND_ERR_CLOSED',","+  'UND_ERR_CONNECT_TIMEOUT',","+  'UND_ERR_HEADERS_TIMEOUT',","+  'UND_ERR_BODY_TIMEOUT',","+  'UND_ERR_ABORTED',","+]);","+","+function errorCode(value: unknown): string | undefined {","+  return typeof value === 'object' &&","+    value !== null &&","+    'code' in value &&","+    typeof value.code === 'string'","+    ? value.code","+    : undefined;","+}","+","+function isUnreachable(error: unknown): boolean {","+  // AbortSignal.timeout rejects with a DOMException named TimeoutError.","+  if (error instanceof Error && error.name === 'TimeoutError') {","+    return true;","+  }","+  const cause = error instanceof Error ? error.cause : undefined;","+  return (","+    unreachableCodes.has(errorCode(error) ?? '') || unreachableCodes.has(errorCode(cause) ?? '')","+  );","+}","+","+function diagnostic(code: string, message: string): UpgradeDiagnostic {","+  return { source: 'ghost', code, severity: 'error', message };","+}","+","+/** Talks to a host's upgrade API (HTTP protocol 1) over a Unix socket. */","+export default class HttpUpgradeAdapter extends UpgradeBase {","+  readonly #timeoutMs: number;","+  readonly #dispatcher: Agent;","+","+  /** Called by the adapter manager at boot, so a misconfigured host fails early. */","+  static validate(config: unknown): void {","+    const result = configSchema.safeParse(config);","+    if (!result.success) {","+      throw new errors.IncorrectUsageError({","+        message: [...new Set(result.error.issues.map((issue) => issue.message))].join('; '),","+      });","+    }","+  }","+","+  constructor(config: unknown) {","+    super();","+    HttpUpgradeAdapter.validate(config);","+    const { socketPath } = configSchema.parse(config);","+    // A test-only seam, read outside the schema so it is not configuration.","+    this.#timeoutMs = (config as { timeoutMs?: number }).timeoutMs ?? DEFAULT_TIMEOUT_MS;","+    // Creating the agent opens no connection, so Ghost boots whether or not the host is up.","+    this.#dispatcher = new Agent({","+      maxResponseSize: MAX_RESPONSE_BYTES,","+      connect: { socketPath, timeout: this.#timeoutMs },","+    });","+  }","+","+  async getStatus(): Promise<UpgradeStatus> {","+    let handshake: Response;","+    let status: Response;","+    try {","+      handshake = await this.#request('GET', '/v1');","+      status = handshake.status === 200 ? await this.#request('GET', '/v1/status') : handshake;","+    } catch (error) {","+      if (!(error instanceof Unreachable)) {","+        throw error;","+      }","+      handshake = status = { status: 503, body: undefined };","+    }","+    if (handshake.status >= 500 || status.status >= 500) {","+      return {","+        supported: true,","+        availability: 'unavailable',","+        diagnostics: [diagnostic('host-unreachable', 'Ghost could not reach the update service.')],","+      };","+    }","+","+    const protocol = handshakeSchema.safeParse(handshake.body);","+    const parsed = upgradeStatusSchema.safeParse(status.body);","+    if (!protocol.success || status.status !== 200 || !parsed.success) {","+      return {","+        supported: true,","+        availability: 'incompatible',","+        diagnostics: [","+          diagnostic(","+            'protocol-mismatch',","+            'The update service uses a protocol this version of Ghost does not support.',","+          ),","+        ],","+      };","+    }","+    return parsed.data;","+  }","+","+  async createRequest(request: CreateUpgradeRequest): Promise<UpgradeJob> {","+    const response = await this.#call('POST', '/v1/requests', request);","+    if (response.status === 200 || response.status === 202) {","+      return upgradeJobSchema.parse(response.body);","+    }","+    const rejection = errorBodySchema.safeParse(response.body);","+    const code = upgradeErrorCodeSchema.safeParse(rejection.data?.error.code);","+    if (code.success) {","+      throw new UpgradeAdapterError({","+        code: code.data,","+        diagnostics: rejection.data?.error.diagnostics,","+      });","+    }","+    // A host or proxy can fail without a protocol error body, e.g. while restarting.","+    if (response.status >= 500) {","+      throw new UpgradeAdapterError({ code: 'unavailable' });","+    }","+    throw new errors.IncorrectUsageError({","+      message: `The update service answered ${response.status} to a request.`,","+    });","+  }","+","+  async getJob(id: string): Promise<UpgradeJobResult> {","+    if (!upgradeJobIdSchema.safeParse(id).success) {","+      return { id, state: 'unknown' };","+    }","+    const response = await this.#call('GET', `/v1/jobs/${id}`);","+    if (response.status >= 500) {","+      throw new UpgradeAdapterError({ code: 'unavailable' });","+    }","+    if (response.status !== 200) {","+      throw new errors.IncorrectUsageError({","+        message: `The update service answered ${response.status} to a job lookup.`,","+      });","+    }","+    return upgradeJobResultSchema.parse(response.body);","+  }","+","+  /** Like #request, but an unreachable host is the adapter's `unavailable` rejection. */","+  async #call(method: string, route: string, body?: object): Promise<Response> {","+    try {","+      return await this.#request(method, route, body);","+    } catch (error) {","+      if (error instanceof Unreachable) {","+        throw new UpgradeAdapterError({ code: 'unavailable' });","+      }","+      throw error;","+    }","+  }","+","+  async #request(method: string, route: string, body?: object): Promise<Response> {","+    // The host name is unused; the agent connects to socketPath.","+    const target = new URL(route, 'http://localhost');","+","+    try {","+      const response = await send(target, {","+        method,","+        dispatcher: this.#dispatcher,","+        // A kept-alive connection is dead after the host restarts; connect per call.","+        reset: true,","+        // A deadline for the whole exchange, not just between chunks.","+        signal: AbortSignal.timeout(this.#timeoutMs),","+        headers: {","+          accept: 'application/json',","+          ...(body && { 'content-type': 'application/json' }),","+        },","+        body: body && JSON.stringify(body),","+      });","+      // Read errors reach isUnreachable below; only a malformed body becomes undefined.","+      const text = await response.body.text();","+      let parsed: unknown;","+      try {","+        parsed = text ? JSON.parse(text) : undefined;","+      } catch {","+        parsed = undefined;","+      }","+      return { status: response.statusCode, body: parsed };","+    } catch (error) {","+      if (isUnreachable(error)) {","+        throw new Unreachable({ message: error instanceof Error ? error.message : String(error) });","+      }","+      throw error;","+    }","+  }","+}"],"additions":241,"deletions":0,"truncated":false},{"path":"ghost/core/server/adapters/upgrade/NoopUpgradeAdapter.ts","lines":["@@ -0,0 +1,22 @@","+import {","+  UpgradeBase,","+  UpgradeAdapterError,","+  type UpgradeJob,","+  type UpgradeJobResult,","+  type UpgradeStatus,","+} from '@tryghost/adapter-base-upgrade';","+","+/** The default: Ghost never upgrades itself, so updates stay unavailable until a host adapter is configured. */","+export default class NoopUpgradeAdapter extends UpgradeBase {","+  async getStatus(): Promise<UpgradeStatus> {","+    return { supported: false, reason: 'not-configured' };","+  }","+","+  async createRequest(): Promise<UpgradeJob> {","+    throw new UpgradeAdapterError({ code: 'unsupported' });","+  }","+","+  async getJob(id: string): Promise<UpgradeJobResult> {","+    return { id, state: 'unknown' };","+  }","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"ghost/core/server/adapters/upgrade/README.md","lines":["@@ -0,0 +1,38 @@","+# Upgrade adapters","+","+Ghost's built-in implementations of the","+[`@tryghost/adapter-base-upgrade`](../../../../../packages/adapters/upgrade-base/README.md)","+contract.","+","+- `NoopUpgradeAdapter` is the default. It reports updates as not configured.","+- `HttpUpgradeAdapter` talks to a host's upgrade API over a Unix socket, such","+  as ghost-docker's upgrade supervisor.","+","+## HttpUpgradeAdapter","+","+Implements protocol `1` of ghost-docker's","+[upgrade supervisor protocol](https://github.com/TryGhost/ghost-docker/blob/next-docker/docs/upgrade-supervisor.md),","+which is the source of truth for the API. ghost-docker sets:","+","+```","+adapters__upgrade__active=HttpUpgradeAdapter","+adapters__upgrade__HttpUpgradeAdapter__socketPath=/run/ghost-upgrade/supervisor.sock","+```","+","+The socket's directory permissions are the authentication. Ghost refuses to","+boot when the adapter is active without an absolute `socketPath`.","+Construction makes no requests, so Ghost boots whether or not the host is up.","+","+| Request             | Answer                                                                      |","+| ------------------- | --------------------------------------------------------------------------- |","+| `GET /v1`           | `{protocol: 1}`; a 5xx is `unavailable`, any other answer is `incompatible` |","+| `GET /v1/status`    | The base status body                                                        |","+| `POST /v1/requests` | `202` with the new job, `200` with the original job for a replay            |","+| `GET /v1/jobs/:id`  | The job, or `{id, state: 'unknown' \\| 'expired'}`                           |","+","+Rejections are `{error: {code, diagnostics?}}` with the base error codes. A","+missing socket, a refused connection, a 5xx or no complete answer within five","+seconds is reported as `unavailable`.","+Responses over 1 MiB are refused. Job IDs come from the host; a replay with","+the same idempotency key (already a per-user sha256) returns the original job.","+ghost-docker uses the key itself as the job ID."],"additions":38,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/adapter-manager/base-classes.ts","lines":["@@ -5,6 +5,7 @@ import { CacheBase } from '@tryghost/adapter-base-cache';"," import { RedirectsStoreBase } from '@tryghost/adapter-base-redirects';"," import { RouteSettingsStoreBase } from '@tryghost/adapter-base-route-settings';"," import { JobsBackendBase } from '@tryghost/adapter-base-jobs';","+import { UpgradeBase } from '@tryghost/adapter-base-upgrade';"," "," import type { BaseClassMap } from './adapter-manager';"," ","@@ -20,6 +21,7 @@ export const baseClasses = {","   redirects: RedirectsStoreBase,","   'route-settings': RouteSettingsStoreBase,","   jobs: JobsBackendBase,","+  upgrade: UpgradeBase,"," } satisfies BaseClassMap;"," "," /**","@@ -40,4 +42,5 @@ export const baseClassPackages = {","   redirects: '@tryghost/adapter-base-redirects',","   'route-settings': '@tryghost/adapter-base-route-settings',","   jobs: '@tryghost/adapter-base-jobs',","+  upgrade: '@tryghost/adapter-base-upgrade',"," } satisfies Record<keyof typeof baseClasses, string>;"],"additions":3,"deletions":0,"truncated":false},{"path":"ghost/core/shared/config/defaults.json","lines":["@@ -61,6 +61,9 @@","       \"FileStore\": {},","       \"S3RouteSettingsStore\": {}","     },","+    \"upgrade\": {","+      \"active\": \"NoopUpgradeAdapter\"","+    },","     \"jobs\": {","       \"active\": \"InMemoryJobsBackend\",","       \"InMemoryJobsBackend\": {"],"additions":3,"deletions":0,"truncated":false},{"path":"ghost/package.json","lines":["@@ -89,6 +89,7 @@","     \"@tryghost/adapter-base-route-settings\": \"workspace:*\",","     \"@tryghost/adapter-base-scheduling\": \"workspace:*\",","     \"@tryghost/adapter-base-sso\": \"workspace:*\",","+    \"@tryghost/adapter-base-upgrade\": \"workspace:*\",","     \"@tryghost/admin-api-schema\": \"workspace:*\",","     \"@tryghost/api-framework\": \"workspace:*\",","     \"@tryghost/app-contracts\": \"workspace:*\",","@@ -230,6 +231,7 @@","     \"tldts\": \"catalog:\",","     \"type-fest\": \"catalog:\",","     \"ua-parser-js\": \"1.0.41\",","+    \"undici\": \"catalog:\",","     \"unidecode\": \"catalog:\",","     \"zod\": \"catalog:\"","   },"],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/adapters/upgrade/http-upgrade-adapter.test.ts","lines":["@@ -0,0 +1,318 @@","+import assert from 'node:assert/strict';","+import fs from 'node:fs';","+import http from 'node:http';","+import os from 'node:os';","+import path from 'node:path';","+import {","+  createUpgradeRequestSchema,","+  upgradeErrorCodeSchema,","+  upgradeJobResultSchema,","+  upgradeJobSchema,","+  upgradeStatusSchema,","+} from '@tryghost/adapter-base-upgrade';","+import HttpUpgradeAdapter, {","+  PROTOCOL,","+  errorBodySchema,","+  handshakeSchema,","+} from '../../../../../core/server/adapters/upgrade/HttpUpgradeAdapter';","+","+const FIXTURES = path.join(__dirname, '../../../../utils/fixtures/upgrade-supervisor');","+","+// Each fixture's filename prefix names the body it is.","+const accepts: Record<string, (body: unknown) => boolean> = {","+  request: (body) => createUpgradeRequestSchema.safeParse(body).success,","+  status: (body) => upgradeStatusSchema.safeParse(body).success,","+  job: (body) => upgradeJobSchema.safeParse(body).success,","+  lookup: (body) => upgradeJobResultSchema.safeParse(body).success,","+  handshake: (body) => handshakeSchema.safeParse(body).success,","+  error: (body) => {","+    const parsed = errorBodySchema.safeParse(body);","+    return parsed.success && upgradeErrorCodeSchema.safeParse(parsed.data.error.code).success;","+  },","+};","+","+const key = 'a'.repeat(64);","+const request = { component: 'ghost', toVersion: '6.71.0', idempotencyKey: key };","+const job = {","+  id: key,","+  state: 'pending',","+  component: 'ghost',","+  toVersion: '6.71.0',","+  createdAt: '2026-10-14T12:00:00.000Z',","+  updatedAt: '2026-10-14T12:00:00.000Z',","+};","+const status = {","+  supported: true,","+  availability: 'ready',","+  backupRequired: true,","+  currentVersion: '6.70.0',","+  oneClick: [{ component: 'ghost', fromVersion: '6.70.0', toVersion: '6.71.0' }],","+  manual: [],","+};","+","+type Handler = (req: {","+  method?: string;","+  url?: string;","+  headers: http.IncomingHttpHeaders;","+  body: unknown;","+}) => { status: number; body?: unknown } | ((res: http.ServerResponse) => void) | null;","+","+describe('HttpUpgradeAdapter', function () {","+  let dir: string;","+  let socketPath: string;","+  let server: http.Server;","+  let handler: Handler;","+  let requests: Array<Parameters<Handler>[0]>;","+","+  // The supervisor's side of the protocol, answering from the current test's handler.","+  beforeEach(async function () {","+    dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ghost-upgrade-http-'));","+    socketPath = path.join(dir, 'supervisor.sock');","+    requests = [];","+    handler = (req) => {","+      if (req.url === '/v1') {","+        return { status: 200, body: { protocol: PROTOCOL } };","+      }","+      if (req.url === '/v1/status') {","+        return { status: 200, body: status };","+      }","+      return { status: 404, body: { error: { code: 'not-found' } } };","+    };","+    server = http.createServer((req, res) => {","+      const chunks: Buffer[] = [];","+      req.on('data', (chunk: Buffer) => chunks.push(chunk));","+      req.on('end', () => {","+        const text = Buffer.concat(chunks).toString('utf8');","+        const captured = {","+          method: req.method,","+          url: req.url,","+          headers: req.headers,","+          body: text ? JSON.parse(text) : undefined,","+        };","+        requests.push(captured);","+        const answer = handler(captured);","+        if (!answer) {","+          return; // Never answer, to exercise the client timeout.","+        }","+        if (typeof answer === 'function') {","+          answer(res);","+          return;","+        }","+        res.writeHead(answer.status, { 'content-type': 'application/json' });","+        res.end(answer.body === undefined ? '' : JSON.stringify(answer.body));","+      });","+    });","+    await new Promise<void>((resolve) => {","+      server.listen(socketPath, resolve);","+    });","+  });","+","+  afterEach(async function () {","+    server.closeAllConnections();","+    await new Promise((resolve) => {","+      server.close(resolve);","+    });","+    fs.rmSync(dir, { recursive: true, force: true });","+  });","+","+  describe('protocol fixtures', function () {","+    for (const kind of ['valid', 'invalid']) {","+      for (const file of fs.readdirSync(path.join(FIXTURES, kind))) {","+        it(`${kind === 'valid' ? 'accepts' : 'refuses'} ${file}`, function () {","+          const accept = accepts[file.split('-')[0].replace('.json', '')];","+          const body = JSON.parse(fs.readFileSync(path.join(FIXTURES, kind, file), 'utf8'));","+","+          assert.ok(accept, `No schema for ${file}`);","+          assert.equal(accept(body), kind === 'valid');","+        });","+      }","+    }","+  });","+","+  describe('validate', function () {","+    it('requires an absolute socketPath', function () {","+      for (const config of [{}, { socketPath: '' }, { socketPath: 'relative.sock' }]) {","+        assert.throws(() => HttpUpgradeAdapter.validate(config), {","+          errorType: 'IncorrectUsageError',","+        });","+        assert.throws(() => new HttpUpgradeAdapter(config), { errorType: 'IncorrectUsageError' });","+      }","+      assert.doesNotThrow(() => HttpUpgradeAdapter.validate({ socketPath }));","+    });","+  });","+","+  describe('getStatus', function () {","+    it('checks the protocol, then returns the host status', async function () {","+      const adapter = new HttpUpgradeAdapter({ socketPath });","+","+      const result = await adapter.getStatus();","+","+      assert.equal(result.supported && result.availability, 'ready');","+      assert.deepEqual(","+        requests.map((req) => req.url),","+        ['/v1', '/v1/status'],","+      );","+    });","+","+    it('reports a missing socket, a 5xx or a timeout as unavailable', async function () {","+      const missing = new HttpUpgradeAdapter({ socketPath: path.join(dir, 'nope.sock') });","+      const unavailable = async (adapter: HttpUpgradeAdapter) => {","+        const result = await adapter.getStatus();","+        assert.equal(result.supported && result.availability, 'unavailable');","+      };","+","+      await unavailable(missing);","+","+      handler = () => ({ status: 503, body: { error: { code: 'unavailable' } } });","+      await unavailable(new HttpUpgradeAdapter({ socketPath }));","+","+      handler = () => null;","+      await unavailable(new HttpUpgradeAdapter({ socketPath, timeoutMs: 50 }));","+    });","+","+    it('reports a connection dropped mid-body as unavailable', async function () {","+      handler = () => (res) => {","+        res.writeHead(200, { 'content-type': 'application/json', 'content-length': '100' });","+        res.write('{\"protocol\":');","+        res.socket?.destroy();","+      };","+","+      const result = await new HttpUpgradeAdapter({ socketPath }).getStatus();","+","+      assert.equal(result.supported && result.availability, 'unavailable');","+    });","+","+    it('gives up on a body still trickling in at the deadline', async function () {","+      handler = () => (res) => {","+        res.writeHead(200, { 'content-type': 'application/json' });","+        const timer = setInterval(() => res.write(' '), 10);","+        res.on('close', () => clearInterval(timer));","+      };","+","+      const result = await new HttpUpgradeAdapter({ socketPath, timeoutMs: 100 }).getStatus();","+","+      assert.equal(result.supported && result.availability, 'unavailable');","+    });","+","+    it('refuses a response larger than any protocol body', async function () {","+      handler = () => ({ status: 200, body: { padding: 'x'.repeat(1024 * 1024) } });","+","+      await assert.rejects(new HttpUpgradeAdapter({ socketPath }).getStatus());","+    });","+","+    it('passes through a host that does not support updates', async function () {","+      handler = (req) =>","+        req.url === '/v1'","+          ? { status: 200, body: { protocol: PROTOCOL } }","+          : { status: 200, body: { supported: false, reason: 'not-supported' } };","+","+      assert.deepEqual(await new HttpUpgradeAdapter({ socketPath }).getStatus(), {","+        supported: false,","+        reason: 'not-supported',","+      });","+    });","+","+    it('reports a missing or different protocol as incompatible', async function () {","+      const adapter = new HttpUpgradeAdapter({ socketPath });","+      const incompatible = async () => {","+        const result = await adapter.getStatus();","+        assert.equal(result.supported && result.availability, 'incompatible');","+      };","+","+      handler = () => ({ status: 404 });","+      await incompatible();","+","+      handler = (req) =>","+        req.url === '/v1'","+          ? { status: 200, body: { protocol: PROTOCOL + 1 } }","+          : { status: 200, body: status };","+      await incompatible();","+    });","+  });","+","+  describe('createRequest', function () {","+    it('posts the request and returns the accepted job', async function () {","+      handler = () => ({ status: 202, body: job });","+      const adapter = new HttpUpgradeAdapter({ socketPath });","+","+      assert.deepEqual(await adapter.createRequest(request), job);","+      assert.equal(requests[0].method, 'POST');","+      assert.equal(requests[0].url, '/v1/requests');","+      assert.deepEqual(requests[0].body, request);","+    });","+","+    it('returns the original job for a replay', async function () {","+      handler = () => ({ status: 200, body: { ...job, state: 'pulling' } });","+","+      const result = await new HttpUpgradeAdapter({ socketPath }).createRequest(request);","+","+      assert.equal(result.state, 'pulling');","+    });","+","+    it('maps host rejections and their diagnostics', async function () {","+      const diagnostics = [","+        { source: 'ghost-docker', code: 'busy', severity: 'info', message: 'A job is running.' },","+      ];","+      const adapter = new HttpUpgradeAdapter({ socketPath });","+","+      for (const [statusCode, code] of [","+        [409, 'busy'],","+        [409, 'idempotency-conflict'],","+        [422, 'target-unapproved'],","+        [410, 'request-expired'],","+        [503, 'unavailable'],","+      ] as const) {","+        handler = () => ({ status: statusCode, body: { error: { code, diagnostics } } });","+        await assert.rejects(adapter.createRequest(request), { code, diagnostics });","+      }","+    });","+","+    it('rejects a 5xx without a protocol error body as unavailable', async function () {","+      handler = () => ({ status: 502 });","+","+      await assert.rejects(new HttpUpgradeAdapter({ socketPath }).createRequest(request), {","+        code: 'unavailable',","+      });","+    });","+","+    it('rejects as unavailable when the host cannot be reached', async function () {","+      const adapter = new HttpUpgradeAdapter({ socketPath: path.join(dir, 'nope.sock') });","+","+      await assert.rejects(adapter.createRequest(request), { code: 'unavailable' });","+    });","+","+    it('treats a malformed-request answer as a failure, not a rejection', async function () {","+      handler = () => ({ status: 400, body: { error: { code: 'malformed' } } });","+","+      await assert.rejects(new HttpUpgradeAdapter({ socketPath }).createRequest(request), {","+        errorType: 'IncorrectUsageError',","+      });","+    });","+  });","+","+  describe('getJob', function () {","+    it('returns jobs and unknown or expired lookups', async function () {","+      const adapter = new HttpUpgradeAdapter({ socketPath });","+","+      handler = () => ({ status: 200, body: { ...job, state: 'done' } });","+      assert.equal((await adapter.getJob(key)).state, 'done');","+      assert.equal(requests[0].url, `/v1/jobs/${key}`);","+","+      handler = () => ({ status: 200, body: { id: key, state: 'expired' } });","+      assert.deepEqual(await adapter.getJob(key), { id: key, state: 'expired' });","+    });","+","+    it('never sends a malformed ID to the host', async function () {","+      const adapter = new HttpUpgradeAdapter({ socketPath });","+","+      assert.deepEqual(await adapter.getJob('../status'), { id: '../status', state: 'unknown' });","+      assert.equal(requests.length, 0);","+    });","+","+    it('rejects as unavailable while the host is down', async function () {","+      const adapter = new HttpUpgradeAdapter({ socketPath: path.join(dir, 'nope.sock') });","+","+      await assert.rejects(adapter.getJob(key), { code: 'unavailable' });","+    });","+  });","+});"],"additions":318,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/services/adapter-manager/upgrade-wiring.test.ts","lines":["@@ -0,0 +1,22 @@","+import assert from 'node:assert/strict';","+","+// Required, not imported: the loader resolves adapters with `require`, which reads the","+// package build, so an ESM import of the source would fail the `instanceof` check.","+const { UpgradeBase } = require('@tryghost/adapter-base-upgrade');","+const adapterManager = require('../../../../../core/server/services/adapter-manager').default;","+","+describe('adapter-manager upgrade wiring', function () {","+  afterEach(function () {","+    adapterManager.clearCache();","+  });","+","+  it('returns the NoopUpgradeAdapter by default', async function () {","+    const adapter = adapterManager.getAdapter('upgrade');","+","+    assert.ok(adapter instanceof UpgradeBase);","+    assert.equal(adapter.constructor.name, 'NoopUpgradeAdapter');","+    assert.deepEqual(await adapter.getStatus(), { supported: fals