\t\"net\"","+","+\t\"github.com/google/uuid\"","+","+\t\"github.com/free5gc/openapi/models\"","+)","+","+const (","+\tminHeartBeatTimer = 1","+\tmaxHeartBeatTimer = 3600","+\tmaxTCPPort        = 65535","+)","+","+func validateNfProfileJSON(raw []byte, nfProfile *models.NrfNfManagementNfProfile) error {","+\tvar fields map[string]json.RawMessage","+\tif err := json.Unmarshal(raw, &fields); err != nil {","+\t\treturn fmt.Errorf(\"invalid NF profile JSON: %w\", err)","+\t}","+\tif fields == nil {","+\t\treturn fmt.Errorf(\"NF profile must be a JSON object\")","+\t}","+","+\tif rawHeartBeatTimer, ok := fields[\"heartBeatTimer\"]; ok {","+\t\tvar heartBeatTimer int32","+\t\tif err := json.Unmarshal(rawHeartBeatTimer, &heartBeatTimer); err != nil {","+\t\t\treturn fmt.Errorf(\"heartBeatTimer must be an integer\")","+\t\t}","+\t\tif !validHeartBeatTimer(heartBeatTimer) {","+\t\t\treturn fmt.Errorf(\"heartBeatTimer must be between %d and %d\", minHeartBeatTimer, maxHeartBeatTimer)","+\t\t}","+\t}","+","+\treturn validateNfProfile(nfProfile)","+}","+","+func validateNfProfile(nfProfile *models.NrfNfManagementNfProfile) error {","+\tif nfProfile == nil {","+\t\treturn fmt.Errorf(\"NF profile is required\")","+\t}","+\tif err := validateNfInstanceID(nfProfile.NfInstanceId); err != nil {","+\t\treturn err","+\t}","+\tif !validNfType(nfProfile.NfType) {","+\t\treturn fmt.Errorf(\"invalid nfType: %s\", nfProfile.NfType)","+\t}","+\tif !validNfStatus(nfProfile.NfStatus) {","+\t\treturn fmt.Errorf(\"invalid nfStatus: %s\", nfProfile.NfStatus)","+\t}","+\tif nfProfile.HeartBeatTimer != 0 && !validHeartBeatTimer(nfProfile.HeartBeatTimer) {","+\t\treturn fmt.Errorf(\"heartBeatTimer must be between %d and %d\", minHeartBeatTimer, maxHeartBeatTimer)","+\t}","+","+\tfor index, address := range nfProfile.Ipv4Addresses {","+\t\tif !validIPv4(address) {","+\t\t\treturn fmt.Errorf(\"invalid ipv4Addresses[%d]: %s\", index, address)","+\t\t}","+\t}","+\tfor index, address := range nfProfile.Ipv6Addresses {","+\t\tif !validIPv6(address) {","+\t\t\treturn fmt.Errorf(\"invalid ipv6Addresses[%d]: %s\", index, address)","+\t\t}","+\t}","+","+\tfor serviceIndex, service := range nfProfile.NfServices {","+\t\tif service.Scheme != \"\" && !validURIScheme(service.Scheme) {","+\t\t\treturn fmt.Errorf(\"invalid nfServices[%d].scheme: %s\", serviceIndex, service.Scheme)","+\t\t}","+\t\tif service.NfServiceStatus != \"\" && !validNfServiceStatus(service.NfServiceStatus) {","+\t\t\treturn fmt.Errorf(\"invalid nfServices[%d].nfServiceStatus: %s\", serviceIndex, service.NfServiceStatus)","+\t\t}","+\t\tfor endpointIndex, endpoint := range service.IpEndPoints {","+\t\t\tif err := validateIPEndPoint(endpoint); err != nil {","+\t\t\t\treturn fmt.Errorf(\"invalid nfServices[%d].ipEndPoints[%d]: %w\", serviceIndex, endpointIndex, err)","+\t\t\t}","+\t\t}","+\t}","+","+\treturn nil","+}","+","+func validateNfInstanceID(nfInstanceID string) error {","+\tparsed, err := uuid.Parse(nfInstanceID)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"nfInstanceId must be a UUID v4\")","+\t}","+\tif parsed.Version() != 4 {","+\t\treturn fmt.Errorf(\"nfInstanceId must be a UUID v4\")","+\t}","+\treturn nil","+}","+","+func validateIPEndPoint(endpoint models.IpEndPoint) error {","+\tif endpoint.Transport != \"\" && endpoint.Transport != models.NrfNfManagementTransportProtocol_TCP {","+\t\treturn fmt.Errorf(\"transport must be TCP\")","+\t}","+\tif endpoint.Port != 0 && (endpoint.Port < 1 || endpoint.Port > maxTCPPort) {","+\t\treturn fmt.Errorf(\"port must be between 1 and %d\", maxTCPPort)","+\t}","+","+\tif endpoint.Ipv4Address != \"\" {","+\t\tip := net.ParseIP(endpoint.Ipv4Address)","+\t\tif ip == nil || ip.To4() == nil {","+\t\t\treturn fmt.Errorf(\"invalid ipv4Address: %s\", endpoint.Ipv4Address)","+\t\t}","+\t}","+\tif endpoint.Ipv6Address != \"\" {","+\t\tip := net.ParseIP(endpoint.Ipv6Address)","+\t\tif ip == nil || ip.To4() != nil {","+\t\t\treturn fmt.Errorf(\"invalid ipv6Address: %s\", endpoint.Ipv6Address)","+\t\t}","+\t}","+","+\treturn nil","+}","+","+func validHeartBeatTimer(heartBeatTimer int32) bool {","+\treturn heartBeatTimer >= minHeartBeatTimer && heartBeatTimer <= maxHeartBeatTimer","+}","+","+func validIPv4(address string) bool {","+\tip := net.ParseIP(address)","+\treturn ip != nil && ip.To4() != nil","+}","+","+func validIPv6(address string) bool {","+\tip := net.ParseIP(address)","+\treturn ip != nil && ip.To4() == nil","+}","+","+func validNfStatus(status models.NrfNfManagementNfStatus) bool {","+\tswitch status {","+\tcase models.NrfNfManagementNfStatus_REGISTERED,","+\t\tmodels.NrfNfManagementNfStatus_SUSPENDED,","+\t\tmodels.NrfNfManagementNfStatus_UNDISCOVERABLE:","+\t\treturn true","+\tdefault:","+\t\treturn false","+\t}","+}","+","+func validNfServiceStatus(status models.NfServiceStatus) bool {","+\tswitch status {","+\tcase models.NfServiceStatus_REGISTERED,","+\t\tmodels.NfServiceStatus_SUSPENDED,","+\t\tmodels.NfServiceStatus_UNDISCOVERABLE:","+\t\treturn true","+\tdefault:","+\t\treturn false","+\t}","+}","+","+func validURIScheme(scheme models.UriScheme) bool {","+\tswitch scheme {","+\tcase models.UriScheme_HTTP, models.UriScheme_HTTPS:","+\t\treturn true","+\tdefault:","+\t\treturn false","+\t}","+}","+","+func validNfType(nfType models.NrfNfManagementNfType) bool {","+\tswitch nfType {","+\tcase models.NrfNfManagementNfType_NRF,","+\t\tmodels.NrfNfManagementNfType_UDM,","+\t\tmodels.NrfNfManagementNfType_AMF,","+\t\tmodels.NrfNfManagementNfType_SMF,","+\t\tmodels.NrfNfManagementNfType_AUSF,","+\t\tmodels.NrfNfManagementNfType_NEF,","+\t\tmodels.NrfNfManagementNfType_PCF,","+\t\tmodels.NrfNfManagementNfType_SMSF,","+\t\tmodels.NrfNfManagementNfType_NSSF,","+\t\tmodels.NrfNfManagementNfType_UDR,","+\t\tmodels.NrfNfManagementNfType_LMF,","+\t\tmodels.NrfNfManagementNfType_GMLC,","+\t\tmodels.NrfNfManagementNfType__5_G_EIR,","+\t\tmodels.NrfNfManagementNfType_SEPP,","+\t\tmodels.NrfNfManagementNfType_UPF,","+\t\tmodels.NrfNfManagementNfType_N3_IWF,","+\t\tmodels.NrfNfManagementNfType_AF,","+\t\tmodels.NrfNfManagementNfType_UDSF,","+\t\tmodels.NrfNfManagementNfType_BSF,","+\t\tmodels.NrfNfManagementNfType_CHF,","+\t\tmodels.NrfNfManagementNfType_NWDAF,","+\t\tmodels.NrfNfManagementNfType_PCSCF,","+\t\tmodels.NrfNfManagementNfType_CBCF,","+\t\tmodels.NrfNfManagementNfType_HSS,","+\t\tmodels.NrfNfManagementNfType_UCMF,","+\t\tmodels.NrfNfManagementNfType_SOR_AF,","+\t\tmodels.NrfNfManagementNfType_SPAF,","+\t\tmodels.NrfNfManagementNfType_MME,","+\t\tmodels.NrfNfManagementNfType_SCSAS,","+\t\tmodels.NrfNfManagementNfType_SCEF,","+\t\tmodels.NrfNfManagementNfType_SCP,","+\t\tmodels.NrfNfManagementNfType_NSSAAF,","+\t\tmodels.NrfNfManagementNfType_ICSCF,","+\t\tmodels.NrfNfManagementNfType_SCSCF,","+\t\tmodels.NrfNfManagementNfType_DRA,","+\t\tmodels.NrfNfManagementNfType_IMS_AS,","+\t\tmodels.NrfNfManagementNfType_AANF,","+\t\tmodels.NrfNfManagementNfType__5_G_DDNMF,","+\t\tmodels.NrfNfManagementNfType_NSACF,","+\t\tmodels.NrfNfManagementNfType_MFAF,","+\t\tmodels.NrfNfManagementNfType_EASDF,","+\t\tmodels.NrfNfManagementNfType_DCCF,","+\t\tmodels.NrfNfManagementNfType_MB_SMF,","+\t\tmodels.NrfNfManagementNfType_TSCTSF,","+\t\tmodels.NrfNfManagementNfType_ADRF,","+\t\tmodels.NrfNfManagementNfType_GBA_BSF,","+\t\tmodels.NrfNfManagementNfType_CEF,","+\t\tmodels.NrfNfManagementNfType_MB_UPF,","+\t\tmodels.NrfNfManagementNfType_NSWOF,","+\t\tmodels.NrfNfManagementNfType_PKMF,","+\t\tmodels.NrfNfManagementNfType_MNPF,","+\t\tmodels.NrfNfManagementNfType_SMS_GMSC,","+\t\tmodels.NrfNfManagementNfType_SMS_IWMSC,","+\t\tmodels.NrfNfManagementNfType_MBSF,","+\t\tmodels.NrfNfManagementNfType_MBSTF,","+\t\tmodels.NrfNfManagementNfType_PANF:","+\t\treturn true","+\tdefault:","+\t\treturn false","+\t}","+}"],"additions":228,"deletions":0,"truncated":false},{"path":"internal/sbi/processor/nf_profile_validation_test.go","lines":["@@ -0,0 +1,114 @@","+package processor","+","+import (","+\t\"enc