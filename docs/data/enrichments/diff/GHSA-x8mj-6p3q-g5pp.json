ected non-v4 nfInstanceId to be rejected\")","+\t}","+}","+","+func TestValidateNfProfileRejectsInvalidNFStatus(t *testing.T) {","+\tprofile := validTestNfProfile()","+\tprofile.NfStatus = models.NrfNfManagementNfStatus(\"INVALID_STATUS\")","+","+\tif err := validateTestProfile(t, profile); err == nil {","+\t\tt.Fatal(\"expected invalid nfStatus to be rejected\")","+\t}","+}","+","+func TestValidateNfProfileRejectsInvalidNFType(t *testing.T) {","+\tprofile := validTestNfProfile()","+\tprofile.NfType = models.NrfNfManagementNfType(\"INVALID_TYPE\")","+","+\tif err := validateTestProfile(t, profile); err == nil {","+\t\tt.Fatal(\"expected invalid nfType to be rejected\")","+\t}","+}","+","+func TestValidateNfProfileRejectsExplicitZeroHeartbeat(t *testing.T) {","+\tprofile := validTestNfProfile()","+\traw := []byte(`{","+\t\t\"nfInstanceId\":\"11111111-1111-4111-8111-111111111111\",","+\t\t\"nfType\":\"AMF\",","+\t\t\"nfStatus\":\"REGISTERED\",","+\t\t\"heartBeatTimer\":0","+\t}`)","+","+\tif err := validateNfProfileJSON(raw, &profile); err == nil {","+\t\tt.Fatal(\"expected explicit zero heartBeatTimer to be rejected\")","+\t}","+}","+","+func TestValidateNfProfileRejectsInvalidEndpointIP(t *testing.T) {","+\tprofile := validTestNfProfile()","+\tprofile.NfServices[0].IpEndPoints[0].Ipv4Address = \"999.0.0.1\"","+","+\tif err := validateTestProfile(t, profile); err == nil {","+\t\tt.Fatal(\"expected invalid endpoint IPv4 address to be rejected\")","+\t}","+}","+","+func TestValidateNfProfileRejectsInvalidEndpointPort(t *testing.T) {","+\tprofile := validTestNfProfile()","+\tprofile.NfServices[0].IpEndPoints[0].Port = 70000","+","+\tif err := validateTestProfile(t, profile); err == nil {","+\t\tt.Fatal(\"expected invalid endpoint port to be rejected\")","+\t}","+}",""],"additions":114,"deletions":0,"truncated":false}],"additions":433,"deletions":4,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-08-28T19:53:55.727684+00:00"}