nect(Services::HOST, $port);","+            $adapter = $multiplexed ? new Multiplexing(Services::HOST, $port) : new RedisAdapter($redis);","+            $cache = new Cache($adapter);","+            $key = 'versioned:'.\\bin2hex(\\random_bytes(8));","+            try {","+                $lease = $cache->getLease($key);","+                $cache->purge($key);","+                $redis->del($key); // Physical eviction, including generations/tombstones.","+                $this->assertFalse($cache->saveWithLease($key, 'stale', '', $lease));","+                $fresh = $cache->getLease($key);","+                $this->assertNotSame($lease, $fresh);","+                $this->assertSame('fresh', $cache->saveWithLease($key, 'fresh', '', $fresh));","+                $this->assertSame('fresh', $cache->load($key, 60));","+","+                $snapshot = $cache->loadVersioned($key);","+                $this->assertTrue($cache->compareAndSwap($key, 'next', $snapshot['version']));","+                $this->assertFalse($cache->compareAndSwap($key, 'lost update', $snapshot['version']));","+                $this->assertSame('next', $cache->load($key, 60));","+                $snapshot = $cache->loadVersioned($key);","+                $cache->save($key, 'ordinary write');","+                $this->assertFalse($cache->compareAndSwap($key, 'stale snapshot', $snapshot['version']));","+                $this->assertSame('ordinary write', $cache->load($key, 60));","+                $this->assertSame([$key], $cache->list($key), 'Internal version fields are not cache values');","+            } catch (Throwable $caught) {","+                $error = $caught;","+            } finally {","+                if ($adapter instanceof Multiplexing) {","+                    $adapter->disconnect();","+                }","+                $redis->del($key);","+                $redis->close();","+            }","+        });","+        if ($error instanceof \\Throwable) {","+            throw $error;","+        }","+    }","+}",""],"additions":71,"deletions":0,"truncated":false}],"additions":326,"deletions":12,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-31T14:36:04.334660+00:00"}