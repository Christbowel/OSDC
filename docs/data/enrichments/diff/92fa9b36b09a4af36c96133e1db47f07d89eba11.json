{"id":"92fa9b36b09a4af36c96133e1db47f07d89eba11","axis":"silent","repo":"apache/airflow","sha":"92fa9b36b09a4af36c96133e1db47f07d89eba11","parsed":{"files":[{"path":"providers/common/ai/docs/observability.rst","lines":["@@ -122,7 +122,8 @@ How it works","   ``deserialize_value``: the model name badge would show the reference string (e.g. an","   ``s3://...`` path) instead of the model, and ``usage`` would come back as that same","   string rather than an object -- the tab treats a non-object ``usage`` as absent and","-  hides the stat boxes instead of rendering ``undefined`` in each one.","+  hides the stat boxes instead of rendering ``undefined`` in each one. The skills XCom","+  comes back as that string too, so the skills section is hidden."," * **Content is off by default.** Only token counts, model id, latency, tool","   names, and finish reason are recorded. Prompt and completion text is never","   emitted unless you opt in (see below)."],"additions":2,"deletions":1,"truncated":false},{"path":"providers/common/ai/docs/toolsets/skills.rst","lines":["@@ -140,10 +140,21 @@ from an earlier one can be traced to a change in the skill between two commits."," "," The :ref:`AI Model tab <howto/observability:model-tab>` shows this list, loaded skills"," first, with a link to the skill's folder at that commit for a repository on GitHub or","-GitLab. The counts cover the whole conversation, so calls made before a tool-approval","-pause, a human-review regeneration or a durable retry still count. Several skills toolsets","-on one agent, each wrapped with ``prefixed()`` to keep their tool names apart, share the","-same list. Nothing is published when the task sets ``do_xcom_push=False``.","+GitLab, and says so when the sources held no skills. Calls made before a tool-approval","+pause or a human-review regeneration still count, and so do calls a durable retry replays.","+Only calls the tool answered count: a denied, retried, failed or interrupted call does not,","+while a script that exits with an error still does, since ``run_skill_script`` returns its","+output. A ``message_history`` seeded from another task does not add that task's calls, and","+calls that a history processor or compaction removes from the transcript are not counted.","+``calls`` totals ``calls_by_run``, which keeps the calls of each agent run that made any","+under its pydantic-ai run id.","+A run resumed from a tool-approval pause and a human-review regeneration each clone the","+repository again, so the source shows the commit the latest run cloned. A toolset built by","+a function, which the agent wraps in pydantic-ai's ``DynamicToolset``, is built and cloned","+again on every model step unless you pass ``DynamicToolset(fn, per_run_step=False)``.","+Several skills toolsets on one agent, each wrapped with ``prefixed()`` to keep their tool","+names apart, share the same list. Nothing is published when the task sets","+``do_xcom_push=False``."," "," Parameters"," ----------"],"additions":15,"deletions":4,"truncated":false},{"path":"providers/common/ai/src/airflow/providers/common/ai/plugins/www/src/components/ModelPanel.tsx","lines":["@@ -143,7 +143,7 @@ export const ModelPanel: FC<ModelPanelProps> = ({ dagId, runId, taskId, mapIndex","         </SimpleGrid>","       )}"," ","-      {skills && skills.length > 0 && <SkillsSection skills={skills} />}","+      {skills && <SkillsSection skills={skills} />}","     </Box>","   );"," };"],"additions":1,"deletions":1,"truncated":false},{"path":"providers/common/ai/src/airflow/providers/common/ai/plugins/www/src/components/SkillsSection.tsx","lines":["@@ -48,10 +48,17 @@ export const SkillsSection: FC<{ skills: SkillInfo[] }> = ({ skills }) => {","     <Box data-testid=\"skills-section\" maxW=\"960px\" mt={6}>","       <HStack gap={2} mb={3}>","         <Heading size=\"sm\">Skills</Heading>","+        {skills.length > 0 && (","+          <Text color=\"fg.muted\" fontSize=\"sm\">","+            {loadedCount} of {skills.length} loaded","+          </Text>","+        )}","+      </HStack>","+      {skills.length === 0 && (","         <Text color=\"fg.muted\" fontSize=\"sm\">","-          {loadedCount} of {skills.length} loaded","+          No skills found in the toolset's sources.","         </Text>","-      </HStack>","+      )}","       <Stack gap={2}>","         {ordered.map((skill) => {","           const loaded = isLoaded(skill.calls);","@@ -73,6 +80,8 @@ export const SkillsSection: FC<{ skills: SkillInfo[] }> = ({ skills }) => {","                 portalled","               >","                 <Badge","+                  aria-label={`About the ${skill.name} skill`}","+                  as=\"button\"","                   borderRadius=\"full\"","                   colorPalette={loaded ? \"brand\" : \"gray\"}","                   flexShrink={0}"],"additions":11,"deletions":2,"truncated":false},{"path":"providers/common/ai/src/airflow/providers/common/ai/plugins/www/src/skill-source.ts","lines":["@@ -19,8 +19,37 @@"," "," import type { SkillSource } from \"src/types/model\";"," ","-/** An HTTPS or SSH Git remote, split into its host and repository path. */","-const GIT_REMOTE = /^(?:https:\\/\\/|ssh:\\/\\/git@|git@)([^/:]+)[/:](.+?)(?:\\.git)?\\/?$/;","+/** The scp-like `git@host:path` SSH remote, which `new URL()` cannot parse. */","+const SCP_REMOTE = /^git@([^/:]+):(.+)$/;","+","+/** Split an HTTPS or SSH Git remote into the host its web UI is served on and the repository path. */","+function parseGitRemote(repoUrl: string): { host: string; repo: string } | undefined {","+  let host: string;","+  let path: string;","+  const scp = SCP_REMOTE.exec(repoUrl);","+  if (scp) {","+    [, host = \"\", path = \"\"] = scp;","+  } else {","+    let url: URL;","+    try {","+      url = new URL(repoUrl);","+    } catch {","+      return undefined;","+    }","+    if (url.protocol === \"https:\") {","+      // Keeps a port, as in https://gitlab.corp.com:8443/team/skills.","+      host = url.host;","+    } else if (url.protocol === \"ssh:\") {","+      // An SSH port is not the web UI's.","+      host = url.hostname;","+    } else {","+      return undefined;","+    }","+    path = url.pathname.slice(1);","+  }","+  const repo = path.replace(/\\/$/, \"\").replace(/\\.git$/, \"\");","+  return host && repo ? { host, repo } : undefined;","+}"," "," /**","  * How a skill's source reads in the tab: the repository or local path, the path inside the","@@ -35,12 +64,12 @@ export function describeSkillSource(source: SkillSource): {"," } {","   if (source.repo_url === undefined) return { location: source.path };","   const commit = source.commit ?? undefined;","-  const match = GIT_REMOTE.exec(source.repo_url);","-  const location = match ? `${match[1]}/${match[2]}` : source.repo_url;","+  const remote = parseGitRemote(source.repo_url);","+  const location = remote ? `${remote.host}/${remote.repo}` : source.repo_url;","   const path = source.path === \".\" ? undefined : source.path;","-  if (!match || commit === undefined) return { location, path, commit: commit?.slice(0, 7) };","-  const [, host, repo] = match;","-  const treeSegment = host!.includes(\"gitlab\") ? \"-/tree\" : host!.includes(\"github\") ? \"tree\" : undefined;","+  if (!remote || commit === undefined) return { location, path, commit: commit?.slice(0, 7) };","+  const { host, repo } = remote;","+  const treeSegment = host.includes(\"gitlab\") ? \"-/tree\" : host.includes(\"github\") ? \"tree\" : undefined;","   const href =","     treeSegment === undefined","       ? undefined"],"additions":36,"deletions":7,"truncated":false},{"path":"providers/common/ai/src/airflow/providers/common/ai/plugins/www/tests/model.test.mjs","lines":["@@ -159,3 +159,39 @@ test(\"the skills section lists every available skill with its source, loaded one","   const link = document.querySelector('a[href=\"https://github.com/org/skills/tree/0123456789abcdef/skills/sql-review\"]');","   assert.ok(link);"," });","+","+for (const [label, skills, shown] of [","+  [\"a toolset whose sources held no skills says so\", [], true],","+  [\"a task without a skills toolset shows no skills section\", null, false],","+]) {","+  test(label, async (t) => {","+    mock.method(globalThis, \"fetch\", async (input) => {","+      const key = new URL(input, \"http://localhost\").pathname.split(\"/\").at(-1);","+      if (key === \"__AIRFLOW__COMMON_AI_SKILLS__\" && skills === null) return new Response(\"{}\", { status: 404 });","+      const value = key === \"__AIRFLOW__COMMON_AI_SKILLS__\" ? skills : key === \"usage\" ? { requests: 1 } : \"model\";","+      return new Response(JSON.stringify({ value }), { status: 200 });","+    });","+    const plugin = mountPlugin(t);","+","+    await plugin.render(taskProps);","+","+    assert.equal(document.querySelector('[data-testid=\"skills-section\"]') !== null, shown);","+    assert.equal(/No skills found in the toolset's sources\\./.test(plugin.text()), shown);","+    assert.doesNotMatch(plugin.text(), /0 of 0 loaded/);","+  });","+}","+","+test(\"a skill badge is a button, so its details are reachable from the keyboard\", async (t) => {","+  const skills = [{ name: \"sql-review\", description: \"Reviews SQL.\", source: { path: \"/skills/sql-review\" }, calls: {} }];","+  mock.method(globalThis, \"fetch\", async (input) => {","+    const key = new URL(input, \"http://localhost\").pathname.split(\"/\").at(-1);","+    const value = key === \"__AIRFLOW__COMMON_AI_SKILLS__\" ? skills : key === \"usage\" ? { requests: 1 } : \"model\";","+    return new Response(JSON.stringify({ value }), { status: 200 });","+  });","+  const plugin = mountPlugin(t);","+","+  await plugin.render(taskProps);","+","+  const badge = document.querySelector('button[aria-label=\"About the sql-review skill\"]');","+  assert.equal(badge?.textContent, \"sql-review\");","+});"],"additions":36,"deletions":0,"truncated":false},{"path":"providers/common/ai/src/airflow/providers/common/ai/plugins/w