/recovery', [","+            'origin' => 'http://localhost',","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], [","+            'email' => $email,","+            'url' => 'http://localhost/recovery',","+        ]);","+        $this->assertEquals(201, $response['headers']['status-code']);","+","+        $mail = $this->getLastEmailByAddress($email, function ($mail) use ($previous) {","+            $secret = $this->extractQueryParamsFromEmailLink((string) $mail['html'])['secret'] ?? '';","+            $this->assertNotEmpty($secret);","+            $this->assertNotContains($secret, $previous);","+        });","+","+        return $this->extractQueryParamsFromEmailLink((string) $mail['html'])['secret'];","+    }","+","+    /**","+     * Request a recovery code for the address and return it. Codes in `$previous`","+     * were sent earlier, so their emails are skipped.","+     *","+     * @param array<string> $previous","+     */","+    private function requestRecoveryCode(string $email, array $previous = []): string","+    {","+        $response = $this->client->call(Client::METHOD_POST, '/account/recovery/otp', [","+            'origin' => 'http://localhost',","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], [","+            'email' => $email,","+        ]);","+        $this->assertEquals(201, $response['headers']['status-code']);","+","+        $mail = $this->getLastEmailByAddress($email, function ($mail) use ($previous) {","+            $this->assertArrayHasKey('otp-token', $mail['headers'] ?? []);","+            $code = $this->extractEmailCode((string) $mail['text']);","+            $this->assertNotEmpty($code);","+            $this->assertNotContains($code, $previous);","+        });","+","+        return $this->extractEmailCode((string) $mail['text']);","+    }","+","+    /**","+     * Assert that neither the recovery link secret nor the recovery code resets the password.","+     */","+    private function assertRecoveryRejected(string $userId, string $secret, string $code): void","+    {","+        $headers = [","+            'origin' => 'http://localhost',","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ];","+","+        $link = $this->client->call(Client::METHOD_PUT, '/account/recovery', $headers, [","+            'userId' => $userId,","+            'secret' => $secret,","+            'password' => 'recovered-password',","+        ]);","+        $this->assertEquals(401, $link['headers']['status-code']);","+        $this->assertEquals('user_invalid_token', $link['body']['type']);","+","+        $otp = $this->client->call(Client::METHOD_PUT, '/account/recovery/otp', $headers, [","+            'userId' => $userId,","+            'secret' => $code,","+            'password' => 'recovered-password',","+        ]);","+        $this->assertEquals(401, $otp['headers']['status-code']);","+        $this->assertEquals('user_invalid_token', $otp['body']['type']);","+    }","+","+    public function testUpdateAccountPasswordClearsRecovery(): void","+    {","+        $data = $this->createFreshAccountWithSession();","+        $secret = $this->requestRecoveryLink($data['email']);","+        $code = $this->requestRecoveryCode($data['email']);","+","+        $response = $this->client->call(Client::METHOD_PATCH, '/account/password', [","+            'origin' => 'http://localhost',","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'cookie' => 'a_session_' . $this->getProject()['$id'] . '=' . $data['session'],","+        ], [","+            'password' => 'new-password',","+            'oldPassword' => $data['password'],","+        ]);","+        $this->assertEquals(200, $response['headers']['status-code']);","+","