{"id":"a2d9eb5478ef64683b6047b59ee32ce0fa0d7fc3","axis":"silent","repo":"pnpm/pnpm","sha":"a2d9eb5478ef64683b6047b59ee32ce0fa0d7fc3","parsed":{"files":[{"path":".changeset/add-range-fallback.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add <pkg>` without a version now saves the range that the other workspace projects declare for the package, or the one a matching override sets. A `catalog:` reference still comes first, and the `tag` setting is used only when none of these exists [pnpm/tasks#191](https://github.com/pnpm/tasks/issues/191)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/add/execution.rs","lines":["@@ -146,6 +146,7 @@ where","         lockfile,","         resolved_packages,","         dedicated: _,","+        discovered_workspace: _,","     } = &mut state;","     let lockfile = command_lockfile(lockfile, &lockfile_path)?;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/fetch.rs","lines":["@@ -35,6 +35,7 @@ impl FetchArgs {","             lockfile,","             resolved_packages,","             dedicated: _,","+            discovered_workspace: _,","         } = &state;"," ","         let has_both = self.prod == self.dev;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_remove/tests.rs","lines":["@@ -143,6 +143,7 @@ async fn run_rejects_configured_patches_dir_outside_project() {","         lockfile: pnpm_lockfile::LazyLockfile::disabled(),","         resolved_packages: pnpm_package_manager::ResolvedPackages::new(),","         dedicated: None,","+        discovered_workspace: None,","     };"," ","     let err = PatchRemoveArgs { patches: vec![\"pkg@1.0.0\".to_string()] }","@@ -180,6 +181,7 @@ async fn run_keeps_patch_file_still_used_by_remaining_entries() {","         lockfile: pnpm_lockfile::LazyLockfile::disabled(),","         resolved_packages: pnpm_package_manager::ResolvedPackages::new(),"