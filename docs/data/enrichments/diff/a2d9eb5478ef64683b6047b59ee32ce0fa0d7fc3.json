an"," /// admit newer ones, and withhold the pin the importer holds at another","@@ -207,6 +244,8 @@ pub(super) struct AddSeed {","     pub(super) seed_policies: BTreeMap<String, ImporterUpdateSeedPolicy>,","     pub(super) preferred_versions_override: PreferredVersions,","     pub(super) catalogs_override: Option<Catalogs>,","+    /// `None` for a selected add, whose selection carries the projects.","+    pub(super) workspace: Option<crate::DiscoveredWorkspace>,"," }"," /// `dependency_groups` names the manifest group the new"," /// package is saved into ([`prepare_manifest`](crate::add::manifest::prepare_manifest)), not an","@@ -261,6 +300,7 @@ pub(super) fn add_install<'i>(","     install.context.lockfile_path = add.lockfile.path;","     install.projects.supported_architectures = owned.supported_architectures;","     install.projects.catalogs_override = seed.catalogs_override;","+    install.projects.discovered_workspace = seed.workspace;","     install"," }"," /// Update targets that no selector scoped to a version line: a `catalog:`"],"additions":41,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/manifest.rs","lines":["@@ -1,9 +1,9 @@"," use super::{","     AddError, AddOptions, AddOwned, AddResolution, AddResolveInputs, resolve_added_dependency,","-    workspace_packages_for_add,","+    workspace_projects_for_add,"," };"," use crate::{","-    CatalogDecision, DIRECT_GROUPS,","+    CatalogDecision, DIRECT_GROUPS, DiscoveredWorkspace,","     catalog_cleanup::{write_workspace_catalogs, write_workspace_catalogs_selected},","     emit_initial_package_manifest,"," };","@@ -38,13 +38,13 @@ pub(super) async fn prepare_single_add<Reporter: self::Reporter>(","     add: AddOptions<'_>,","     owned: &AddOwned,","     manifest: &mut PackageManifest,","-) -> Result<(AddCatalogCtx, PreparedManifest), AddError> {","+) -> Result<SingleAddPreparation, AddError> {","     let resolution = AddResolution::new();","     let catalog_ctx = read_catalog_ctx(manifest, add.config)?;","-    let workspace_packages = (add.config.link_workspace_packages.enabled_at_depth(0)","-        || add.config.save_workspace_protocol != SaveWorkspaceProtocol::Rolling)","-        .then(|| workspace_packages_for_add(add.config))","-        .flatten();","+    let mut workspace_projects =","+        walk_workspace_for_add(add, owned, &catalog_ctx.catalogs, manifest);","+    let workspace_packages =","+        crate::install::build_workspace_packages_map(workspace_projects.as_deref());","     let git_source_cache = Arc::new(pnpm_git_fetcher::GitSourceCache::default());","     let prepared = prepare_manifest::<Reporter>(","         manifest,","@@ -73,8 +73,31 @@ pub(super) async fn prepare_single_add<Reporter: self::Reporter>(","         manifest,","     )","     .map_err(AddError::WriteWorkspaceManifest)?;","-    Ok((catalog_ctx, prepared))","+    if let Some(projects) = &mut workspace_projects {","+        crate::install::replace_project_manifest(projects, manifest);","+    }","+    let workspace = workspace_projects.map(DiscoveredWorkspace::new);","+    Ok(SingleAddPreparation { catalog_ctx, prepared, workspace })"," }","+/// The workspace projects, walked only when resolving the selectors reads them.","+fn walk_workspace_for_add(","+    add: AddOptions<'_>,","+    owned: &AddOwned,","+    catalogs: &Catalogs,","+    manifest: &PackageManifest,","+) -> Option<Vec<pnpm_workspace::Project>> {","+    (add.config.link_workspace_packages.enabled_at_depth(0)","+        || add.config.save_workspace_protocol != SaveWorkspaceProtocol::Rolling","+        || super::range_fallback::needs_workspace_range_fallback(","+            add,","+            owned.save_catalog_name.as_deref(),","+            catalogs,","+            manifest,","+        ))","+    .then(|| workspace_projects_for_add(add.config, manifest))","+    .flatten()","+}","+"," pub(super) fn catalog_version_requests(","     package_selectors: &[String],","     manifest: &PackageManifest,","@@ -137,6 +160,13 @@ pub(super) fn catalog_version_request(","     }","     Some((alias, wanted))"," }","+pub(super) struct SingleAddPreparation {","+    pub(super) catalog_ctx: AddCatalogCtx,","+    pub(super) prepared: PreparedManifest,","+    /// The workspace projects the add walked, with the manifest it","+    /// rewrote, for the install to read instead of walking them again.","+    pub(super) workspace: Option<DiscoveredWorkspace>,","+}"," pub(super) struct AddCatalogCtx {","     pub(super) catalogs: Catalogs,","     pub(super) workspace_dir: PathBuf,"],"additions":38,"deletions":8,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/protocol_selector.rs","lines":["@@ -0,0 +1,112 @@","+use super::{","+    AddError, AddResolveInputs,","+    registry::resolve_explicit_registry_spec,","+    specifier::{PickedPackage, SaveSpecifier, split_name_spec},","+};","+use pnpm_package_manifest::PackageManifest;","+use pnpm_package_name::is_valid_dependency_alias;","+use pnpm_resolving_jsr_specifier_parser::{JsrSpec, parse_jsr_specifier};","+use pnpm_workspace_spec::WorkspaceSpec;","+","+/// A `pacquet add` argument that spells its package name *inside* a","+/// dependency protocol, so the manifest key cannot be read off the front of","+/// the argument: `pacquet add jsr:@scope/pkg` keys on `@scope/pkg`, not on","+/// `jsr:`.","+///","+/// `catalog:` has no variant. The text after it names a catalog, not a","+/// package, so `catalog:foo` carries no name to key an entry by.","+pub(super) enum ProtocolSelector {","+    /// `npm:<name>[@<spec>]`. Nothing here is aliased — the install name is","+    /// the real package name — so the entry is saved as the plain","+    /// `<name>[@<spec>]` request would be.","+    Npm { name: String, spec: Option<String> },","+    /// `jsr:@<scope>/<name>[@<selector>]`.","+    Jsr(JsrSpec),","+    /// The alias form `workspace:<name>@<range>`. A version-only","+    /// (`workspace:^1.2.3`) or path (`workspace:./pkg`, `workspace:C:\\pkg`)","+    /// specifier names no package, and [`WorkspaceSpec`] already tells the","+    /// three apart.","+    Workspace { name: String },","+}","+impl ProtocolSelector {","+    /// Returns `Ok(None)` for an argument that carries no name-bearing","+    /// protocol, so the caller falls through to the alias-less resolvers","+    /// and then to [`split_name_spec`].","+    pub(super) fn parse(selector: &str) -> Result<Option<Self>, AddError> {","+        if let Some(rest) = selector.strip_prefix(\"npm:\") {","+            let (name, spec) = split_name_spec(rest);","+            let name = protocol_package_name(name, selector)?;","+            return Ok(Some(Self::Npm { name, spec: spec.map(str::to_string) }));","+        }","+        if let Some(spec) =","+            parse_jsr_specifier(selector, None).map_err(AddError::ParseJsrSpecifier)?","+        {","+            return Ok(Some(Self::Jsr(spec)));","+        }","+        let Some(alias) = WorkspaceSpec::parse(selector).and_then(|spec| spec.alias) else {","+            return Ok(None);","+        };","+        let name = protocol_package_name(&alias, selector)?;","+        Ok(Some(Self::Workspace { name }))","+    }","+","+    pub(super) fn package_name(&self) -> &str {","+        match self {","+            Self::Npm { name, .. } | Self::Workspace { name } => name,","+            Self::Jsr(spec) => &spec.jsr_pkg_name,","+        }","+    }","+","+    /// The specifier half to reconcile against the manifest and the","+    /// catalogs. `jsr:` and `workspace:` keep the whole argument, since what","+    /// is saved for them is rendered back under the protocol; an `npm:`","+    /// request keeps only the registry range it wraps.","+    pub(super) fn explicit_spec<'a>(&'a self, selector: &'a str) -> Option<&'a str> {","+        match self {","+            Self::Npm { spec, .. } => spec.as_deref(),","+            Self::Jsr(_) | Self::Workspace { .. } => Some(selector),","+        }","+    }","+}","+pub(super) fn protocol_package_name(name: &str, selector: &str) -> Result<String, AddError> {","+    if !is_valid_dependency_alias(name) {","+        return Err(AddError::InvalidPackageName {","+            specifier: selector.to_string(),","+            name: name.to_string(),","+        });","+    }","+    Ok(name.to_string())","+}","+/// The `jsr:` specifier to save for `spec`, with the version the install","+/// will lock pinned into it: `pacquet add jsr:@scope/pkg` records","+/// `jsr:^1.2.3` and `jsr:@scope/pkg@0.1` records `jsr:~0.1.0`.","+///","+/// JSR ships every package on npm under the `@jsr` scope, so the version is","+/// picked through the same registry path a plain `@jsr/<scope>__<name>` add","+/// takes. `None` when that pick finds no version — the caller then keeps the","+/// argument verbatim, as it does for any other unresolvable specifier.","+pub(super) async fn resolve_jsr_save_specifier(","+    spec: &JsrSpec,","+    manifest: &PackageManifest,","+    inputs: &AddResolveInputs<'_, '_>,","+) -> Result<Option<SaveSpecifier>, AddError> {","+    let inputs =","+        AddResolveInputs { add: super::AddOptions { save_types: false, ..inputs.add }, ..*inputs };","+    let version_selector =","+        spec.version_selector.as_deref().unwrap_or_else(|| inputs.add.config.default_tag());","+    let range = resolve_explicit_registry_spec(","+        &spec.npm_pkg_name,","+        version_selector,","+        // The range operator is read off the selector the user typed, the","+        // way pnpm reads it for an alias-less request: there is no alias to","+        // find a manifest entry by.","+        None,","+        manifest,","+        &inputs,","+    )","+    .await?;","+    Ok(range.map(|picked| SaveSpecifier {","+        specifier: format!(\"jsr:{}\", picked.range),","+        picked: Some(PickedPackage { name: spec.npm_pkg_name.clone(), version: picked.version }),","+    }))","+}"],"additions":112,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/range_fallback.rs","lines":["@@ -0,0 +1,173 @@","+use super::{","+    AddError, AddOptions, AddResolveInputs,","+    protocol_selector::ProtocolSelector,","+    registry::{package_registry, parse_explicit_registry_spec},","+    specifier::listing_catalog_name,","+};","+use pnpm_catalogs_types::Catalogs;","+use pnpm_package_manifest::{DependencyGroup, PackageManifest};","+use pnpm_resolving_resolver_base::WorkspacePackages;","+use serde_json::Value;","+use std::path::Path;","+","+/// Whether some selector names no version for a dependency that neither the","+/// manifest nor the catalog `pnpm add` saves to declares, so the range","+/// fallback needs the workspace packages.","+pub(super) fn needs_workspace_range_fallback(","+    add: AddOptions<'_>,","+    save_catalog_name: Option<&str>,","+    catalogs: &Catalogs,","+    manifest: &PackageManifest,","+) -> bool {","+    add.package_names","+        .iter()","+        .filter_map(|selector| VersionlessSelector::parse(selector))","+        .any(|selector| match selector {","+            VersionlessSelector::Registry(name) => {","+                super::specifier::declared_specifier(manifest, &name).is_none()","+                    && listing_catalog_name(&name, catalogs, save_catalog_name).is_none()","+            }","+            VersionlessSelector::NpmAlias(alias) => {","+                super::specifier::declared_specifier(manifest, &alias).is_none()","+            }","+        })","+}","+","+/// A selector that names no version, by the manifest key it is saved under.","+#[derive(Debug, PartialEq)]","+enum VersionlessSelector {","+    /// `foo` or `npm:foo`.","+    Registry(String),","+    /// `alias@npm:foo`, keyed by `alias`. A catalog never supplies its range.","+    NpmAlias(String),","+}","+","+impl VersionlessSelector {","+    fn parse(selector: &str) -> Option<Self> {","+        let parsed = pnpm_resolving_parse_wanted_dependency::parse_wanted_dependency(selector);","+        let Some(specifier) = parsed.bare_specifier.filter(|specifier| !specifier.is_empty())","+        else {","+            return parsed.alias.map(Self::Registry);","+        };","+        match ProtocolSelector::parse(&specifier).ok().flatten()? {","+            ProtocolSelector::Npm { name, spec } if spec.as_deref().is_none_or(str::is_empty) => {","+                Some(parsed.alias.map_or(Self::Registry(name), Self::NpmAlias))","+            }","+            _ => None,","+        }","+    }","+}","+","+/// The range to save for a registry selector that names no version: the","+/// workspace range, else the range a matching override sets.","+pub(super) fn add_range_fallback(","+    package_name: &str,","+    manifest: &PackageManifest,","+    inputs: &AddResolveInputs<'_, '_>,","+) -> Result<Option<String>, AddError> {","+    if let Some(specifier) = workspace_range_fallback(package_name, inputs) {","+        return Ok(Some(specifier));","+    }","+    override_specifier(package_name, manifest, inputs)","+}","+","+/// The range every workspace project that declares `package_name` agrees","+/// on, when it is a registry range.","+pub(super) fn workspace_range_fallback(","+    package_name: &str,","+    inputs: &AddResolveInputs<'_, '_>,","+) -> Option<String> {","+    let registry = package_registry(inputs.add.config, package_name);","+    workspace_declared_specifier(package_name, inputs.workspace_packages)","+        .filter(|specifier| {","+            parse_explicit_registry_spec(package_name, specifier, &registry).is_some()","+        })","+}","+","+/// The specifier the overrides rewrite an unconstrained `package_name` to.","+fn override_specifier(","+    package_name: &str,","+    manifest: &PackageManifest,","+    inputs: &AddResolveInputs<'_, '_>,","+) -> Result<Option<String>, AddError> {","+    let Some(overrides) = inputs.add.config.overrides","+        .as_ref()","+        .filter(|map| !map.is_empty())","+    else {","+        return Ok(None);","+    };","+    let parsed =","+        pnpm_config_parse_overrides::parse_overrides_iter(overrides.iter(), inputs.catalogs)","+            .map_err(|error| AddError::Install(crate::InstallError::InvalidOverrides(error)))?;","+    let project_dir = manifest","+        .path()","+        .parent()","+        .expect(\"manifest path always has a parent dir\");","+    let lockfile_root = crate::install::lockfile_root_dir(inputs.add.config, project_dir)","+        .map_err(AddError::FindWorkspaceDir)?;","+    let overrider = crate::overrides::VersionsOverrider::new(&parsed, &lockfile_root);","+    Ok(overridden_specifier(package_name, project_dir, &overrider, inputs, manifest))","+}","+","+/// The specifier `overrider` rewrites an unconstrained `package_name` to,","+/// with relative paths re-based onto `project_dir`.","+fn overridden_specifier(","+    package_name: &str,","+    project_dir: &Path,","+    overrider: &crate::overrides::VersionsOverrider,","+    inputs: &AddResolveInputs<'_, '_>,","+    manifest: &PackageManifest,","+) -> Option<String> {","+    let group = inputs.owned.dependency_groups","+        .as_ref()","+        .and_then(|groups| groups.first())","+        .copied()","+        .unwrap_or(DependencyGroup::Prod);","+    let group_name: &str = group.into();","+    const DECLARED: &str = \"*\";","+    let mut candidate = manifest.value().clone();","+    candidate[group_name][package_name] = Value::String(DECLARED.to_string());","+    overrider.apply_to_value(&mut candidate, Some(project_dir));","+    candidate","+        .get(group_name)","+        .and_then(|dependencies| dependencies.get(package_name))","+        .and_then(Value::as_str)","+        .filter(|specifier| *specifier != DECLARED)","+        .map(ToString::to_string)","+}","+","+/// The one specifier every workspace project that declares `package_name`","+/// agrees on. `None` when the projects disagree or one of them uses a","+/// protocol.","+fn workspace_declared_specifier(","+    package_name: &str,","+    workspace_packages: Option<&WorkspacePackages>,","+) -> Option<String> {","+    let mut agreed: Option<&str> = None;","+    for package in workspace_packages?.values().flat_map(|packages| packages.values()) {","+        let Some(specifier) = project_specifier(&package.manifest, package_name) else {","+            continue;","+        };","+        if specifier.contains(':') || agreed.is_some_and(|agreed| agreed != specifier) {","+            return None;","+        }","+        agreed = Some(specifier);","+    }","+    agreed.map(ToString::to_string)","+}","+","+/// The specifier a project's own dependencies declare for `package_name`,","+/// read in the precedence a dependency declared in several groups resolves by.","+fn project_specifier<'a>(manifest: &'a Value, package_name: &str) -> Option<&'a str> {","+    [DependencyGroup::Optional, DependencyGroup::Prod, DependencyGroup::Dev]","+        .into_iter()","+        .find_map(|group| {","+            manifest","+                .get::<&str>(group.into())?","+                .get(package_name)?","+                .as_str()","+        })","+}","+","+#[cfg(test)]","+mod tests;"],"additions":173,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/range_fallback/tests.rs","lines":["@@ -0,0 +1,84 @@","+use super::{VersionlessSelector, workspace_declared_specifier};","+use pnpm_package_manifest::DependencyGroup;","+use pnpm_resolving_resolver_base::{WorkspacePackage, WorkspacePackages};","+use serde_json::{Value, json};","+use std::path::PathBuf;","+","+fn workspace_with_dependencies(projects: &[(DependencyGroup, &str, &str)]) -> WorkspacePackages {","+    projects","+        .iter()","+        .enumerate()","+        .map(|(index, (group, name, specifier))| {"],"additions":11,"deletions":0,"truncated":false}],"additions":492,"deletions":64,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-03T16:47:46.937292+00:00"}