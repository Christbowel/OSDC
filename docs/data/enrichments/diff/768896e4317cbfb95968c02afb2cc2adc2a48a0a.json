{"id":"768896e4317cbfb95968c02afb2cc2adc2a48a0a","axis":"silent","repo":"pnpm/pnpm","sha":"768896e4317cbfb95968c02afb2cc2adc2a48a0a","parsed":{"files":[{"path":".changeset/setup-powershell-on-posix.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/os.env.path-extender-posix\": patch","+\"@pnpm/os.env.path-extender\": patch","+\"@pnpm/engine.pm.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm setup` and the install script now support PowerShell as the login shell on Linux and macOS. They add `PNPM_HOME` to `PATH` in `profile.ps1` under `$XDG_CONFIG_HOME/powershell` or `~/.config/powershell` [#18026](https://github.com/pnpm/pnpm/issues/18026)."],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup.rs","lines":["@@ -14,7 +14,7 @@ use clap::Args;"," use miette::{Context, IntoDiagnostic};"," use path_extender::{","     AddDirToEnvPathOpts, AddingPosition, ConfigFileChangeType, ConfigReport, PathExtenderError,","-    PathExtenderReport, sh_quote,","+    PathExtenderReport, pwsh_quote, sh_quote,"," };"," use pnpm_config::{Host, PNPM_VERSION, default_pnpm_home_dir, ensure_windows_home_dir_env};"," use pnpm_fs::write_atomic;","@@ -209,15 +209,10 @@ fn posix_env_lines(pnpm_home_dir: &Path) -> String {"," }"," "," fn powershell_env_lines(pnpm_home_dir: &Path) -> String {","-    let mut quoted_home = String::new();","-    for character in pnpm_home_dir.to_string_lossy().chars() {","-        quoted_home.push(character);","-        // PowerShell also treats typographic apostrophes as string delimiters.","-        if matches!(character, '\\'' | '\\u{2018}'..='\\u{201b}') {","-            quoted_home.push(character);","-        }","-    }","-    format!(\"$env:PNPM_HOME = '{quoted_home}'\\n$env:Path = \\\"$env:PNPM_HOME\\\\bin;$env:Path\\\"\")","+    format!(","+        \"$env:PNPM_HOME = {}\\n$env:Path = \\\"$env:PNPM_HOME\\\\bin;$env:Path\\\"\",","+        pwsh_quote(&pnpm_home_dir.to_string_lossy()),","+    )"," }"," "," /// Install the CLI as a global package using `pnpm add -g file:<dir>`,","@@ -503,8 +498,9 @@ fn render_setup_output(report: &PathExtenderReport) -> String {","     output.push(format!(\"The following configuration changes were made:\\n{}\", report.new_settings));","     match &report.config_file {","         None => output.push(\"Setup complete. Open a new terminal to start using pnpm.\".to_string()),","-        Some(config_file) if config_file.change_type != ConfigFileChangeType::Skipped => output","-            .push(format!(\"To start using pnpm, run:\\nsource {}\\n\", config_file.path.display())),","+        Some(config_file) if config_file.change_type != ConfigFileChangeType::Skipped => {","+            output.push(format!(\"To start using pnpm, run:\\n{}\\n\", config_file.reload_command()));","+        }","         Some(_) => {}","     }","     output.join(\"\\n\\n\")"],"additions":8,"deletions":12,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender.rs","lines":["@@ -5,7 +5,7 @@"," //! current shell's rc file is edited. The Windows changes are rendered into"," //! the same `old_settings` / `new_settings` shape the POSIX path reports."," ","-pub(super) use posix::{detect_current_shell, render_shell_settings, sh_quote};","+pub(super) use posix::{detect_current_shell, pwsh_quote, render_shell_settings, sh_quote};"," "," mod posix;"," mod windows;","@@ -42,6 +42,19 @@ pub(super) struct ConfigReport {","     pub change_type: ConfigFileChangeType,"," }"," ","+impl ConfigReport {","+    /// The command that loads the config file into the running shell.","+    pub fn reload_command(&self) -> String {","+        if self.path","+            .extension()","+            .is_some_and(|extension| extension == \"ps1\")","+        {","+            return format!(\". {}\", pwsh_quote(&self.path.to_string_lossy()));","+        }","+        format!(\"source {}\", self.path.display())","+    }","+}","+"," /// The before/after of a path-extension run."," #[derive(Debug, Clone, PartialEq, Eq)]"," pub(super) struct PathExtenderReport {","@@ -79,7 +92,7 @@ pub(crate) enum PathExtenderError {","     #[diagnostic(","         code(ERR_PNPM_UNKNOWN_SHELL),","         help(","-            \"Set the SHELL environment variable to your active shell.\\nSupported shell languages are bash, zsh, fish, ksh, dash, sh, and nushell.\"","+            \"Set the SHELL environment variable to your active shell.\\nSupported shell languages are bash, zsh, fish, ksh, dash, sh, nushell, and PowerShell.\"","         )","     )]","     UnknownShell,","@@ -87,7 +100,9 @@ pub(crate) enum PathExtenderError {","     #[display(r#\"Can't setup configuration for \"{shell}\" shell\"#)]","     #[diagnostic(","         code(ERR_PNPM_UNSUPPORTED_SHELL),","-        help(\"Supported shell languages are bash, zsh, fish, ksh, dash, sh, and nushell.\")","+        help(","+            \"Supported shell languages are bash, zsh, fish, ksh, dash, sh, nushell, and PowerShell.\"","+        )","     )]","     UnsupportedShell {","         shell: String,"],"additions":18,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/posix.rs","lines":["@@ -5,6 +5,8 @@"," //! shell is rendered, and a `# <section>` ... `# <section> end` block is"," //! created in / appended to / replaced in the rc file."," ","+pub(in crate::cli_args::setup) use pwsh::pwsh_quote;","+"," use super::{","     AddDirToEnvPathOpts, AddingPosition, ConfigFileChangeType, ConfigReport, PathExtenderError,","     PathExtenderReport,","@@ -40,6 +42,7 @@ pub(in crate::cli_args::setup) fn render_shell_settings(","         \"bash\" | \"zsh\" | \"ksh\" | \"dash\" | \"sh\" => Some(render_posix_settings(&dir, opts)),","         \"fish\" => Some(render_fish_settings(&dir, opts)),","         \"nu\" => Some(render_nu_settings(&dir, opts)),","+        \"pwsh\" => Some(pwsh::render_pwsh_settings(&dir, opts)),","         _ => None,","     }"," }","@@ -75,6 +78,11 @@ fn update_shell(","         }","         Some(\"fish\") => setup_fish_shell(pnpm_home_dir, opts),","         Some(\"nu\") => setup_nu_shell(pnpm_home_dir, opts),","+        Some(\"pwsh\") => {","+            let profile =","+                pwsh::profile_path(std::env::var_os(\"XDG_CONFIG_HOME\"), pnpm_config::home_dir())?;","+            pwsh::setup_pwsh_shell(profile, pnpm_home_dir, opts)","+        }","         Some(other) => Err(PathExtenderError::UnsupportedShell { shell: other.to_string() }),","         None => Err(PathExtenderError::UnknownShell),","     }","@@ -456,5 +464,7 @@ fn zdotdir_or_home() -> Result<PathBuf, PathExtenderError> {","     }"," }"," ","+mod pwsh;","+"," #[cfg(test)]"," mod tests;"],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/posix/pwsh.rs","lines":["@@ -0,0 +1,77 @@","+//! PowerShell on a non-Windows platform: the profile it loads and the block","+//! `setup` writes to it.","+","+use super::{","+    AddDirToEnvPathOpts, AddingPosition, ConfigReport, PathExtenderError, PathExtenderReport,","+    update_shell_config, wrap_section,","+};","+use std::{","+    ffi::OsString,","+    path::{Path, PathBuf},","+};","+","+/// Write the block to `config_file`, the path [`profile_path`] resolves.","+pub(super) fn setup_pwsh_shell(","+    config_file: PathBuf,","+    dir: &Path,","+    opts: &AddDirToEnvPathOpts,","+) -> Result<PathExtenderReport, PathExtenderError> {","+    let new_settings = render_pwsh_settings(&dir.to_string_lossy(), opts);","+    let content = wrap_section(opts.config_section_name, &new_settings);","+    let (change_type, old_settings) = update_shell_config(&config_file, &content, &[], opts)?;","+    Ok(PathExtenderReport {","+        config_file: Some(ConfigReport { path: config_file, change_type }),","+        old_settings,","+        new_settings,","+    })","+}","+","+/// The block for PowerShell on a non-Windows platform, where `PATH` is","+/// `:`-separated. `-cne` compares case-sensitively, as the file system does.","+pub(super) fn render_pwsh_settings(dir: &str, opts: &AddDirToEnvPathOpts) -> String {","+    let (prefix, entry) = match opts.proxy_var_name {","+        Some(proxy) => {","+            let path_ref = match opts.proxy_var_sub_dir {","+                Some(sub_dir) => format!(r#\"\"$env:{proxy}/{sub_dir}\"\"#),","+                None => format!(\"$env:{proxy}\"),","+            };","+            (format!(\"$env:{proxy} = {}\\n\", pwsh_quote(dir)), path_ref)","+        }","+        None => (String::new(), pwsh_quote(dir)),","+    };","+    let (index, path_value) = match opts.position {","+        AddingPosition::Start => (\"0\", format!(\"{entry} + ':' + $env:PATH\")),","+        AddingPosition::End => (\"-1\", format!(\"$env:PATH + ':' + {entry}\")),","+    };","+    format!(","+        \"{prefix}if (($env:PATH -split ':')[{index}] -cne {entry}) {{\\n  $env:PATH = {path_value}\\n}}\",","+    )","+}","+","+/// Wrap `value` in PowerShell single quotes, doubling every quote character,","+/// so PowerShell treats it as a literal with no expansion. PowerShell also","+/// treats typographic apostrophes as string delimiters.","+pub(in crate::cli_args::setup) fn pwsh_quote(value: &str) -> String {","+    let mut quoted = String::from('\\'');","+    for character in value.chars() {","+        quoted.push(character);","+        if matches!(character, '\\'' | '\\u{2018}'..='\\u{201b}') {","+            quoted.push(character);","+        }","+    }","+    quoted.push('\\'');","+    quoted","+}","+","+/// The profile pwsh loads for every host: `profile.ps1` under","+/// `$XDG_CONFIG_HOME/powershell`, else under `~/.config/powershell`.","+pub(super) fn profile_path(","+    xdg_config_home: Option<OsString>,","+    home_dir: Option<PathBuf>,","+) -> Result<PathBuf, PathExtenderError> {","+    let config_home = match xdg_config_home.filter(|dir| !dir.is_empty()) {","+        Some(dir) => PathBuf::from(dir),","+        None => home_dir.ok_or(PathExtenderError::NoHomeDir)?.join(\".config\"),","+    };","+    Ok(config_home.join(\"powershell/profile.ps1\"))","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/path_extender/posix/tests.rs","lines":["@@ -6,12 +6,16 @@"," "," use super::{","     AddDirToEnvPathOpts, AddingPosition, ConfigFileChangeType, PathExtenderError, PathGuard,","-    add_dir_to_posix_env_path, find_section, fish_quote, render_fish_section, render_fish_settings,","-    render_nu_settings, render_posix_section, render_posix_settings, replace_section, sh_quote,","-    update_shell_config, v11_quote, wrap_section,","+    add_dir_to_posix_env_path, find_section, fish_quote,","+    pwsh::{profile_path, render_pwsh_settings, setup_pwsh_shell},","+    render_fish_section, render_fish_settings, render_nu_settings, render_posix_section,","+    render_posix_settings, replace_section, sh_quote, update_shell_config, v11_quote, wrap_section,"," };"," use pretty_assertions::assert_eq;","-use std::{fs, path::Path};","+use std::{","+    fs,","+    path::{Path, PathBuf},","+};"," "," const HOME: &str = \"/home/user/.pnpm\";"," ","@@ -204,6 +208,79 @@ fn nu_settings_appending_to_the_end_of_path() {","     );"," }"," ","+#[test]","+fn pwsh_settings_with_proxy_var_sub_dir() {","+    let mut opts = opts(false);","+    opts.proxy_var_sub_dir = Some(\"bin\");","+    let settings = render_pwsh_settings(HOME, &opts);","+    assert_eq!(","+        settings,","+        r#\"$env:PNPM_HOME = '/home/user/.pnpm'","+if (($env:PATH -split ':')[0] -cne \"$env:PNPM_HOME/bin\") {","+  $env:PATH = \"$env:PNPM_HOME/bin\" + ':' + $env:PATH","+}\"#,","+    );","+}","+","+#[test]","+fn pwsh_settings_appending_to_the_end_of_path() {","+    let mut opts = opts(false);","+    opts.proxy_var_name = None;","+    opts.position = AddingPosition::End;","+    let settings = render_pwsh_settings(\"/home/o'neil/$(Write-Error injected)\", &opts);","+    assert_eq!(","+        settings,","+        r\"if (($env:PATH -split ':')[-1] -cne '/home/o''neil/$(Write-Error injected)') {","+  $env:PATH = $env:PATH + ':' + '/home/o''neil/$(Write-Error injected)'","+}\",","+    );","+}","+","+#[test]","+fn pwsh_profile_is_under_xdg_config_home_when_set() {","+    let profile = profile_path(Some(\"/xdg\".into()), Some(PathBuf::from(\"/home/user\")));","+    assert_eq!(profile.unwrap(), Path::new(\"/xdg/powershell/profile.ps1\"));","+}","+","+#[test]","+fn pwsh_profile_is_under_dot_config_when_xdg_config_home_is_unset_or_empty() {","+    for xdg_config_home in [None, Some(\"\".into())] {","+        let profile = profile_path(xdg_config_home, Some(PathBuf::from(\"/home/user\")));","+        assert_eq!(profile.unwrap(), Path::new(\"/home/user/.config/powershell/profile.ps1\"));","+    }","+}","+","+#[test]","+fn pwsh_profile_needs_a_home_dir_without_xdg_config_home() {","+    let err = profile_path(None, None).expect_err(\"no home dir to put the profile under\");","+    assert!(matches!(err, PathExtenderError::NoHomeDir));","+}","+","+#[test]","+fn setup_pwsh_shell_creates_the_profile_and_then_skips_it() {","+    let dir = tempfile::tempdir().expect(\"create temp dir\");","+    let profile = dir","+        .path()","+        .join(\"powershell\")","+        .join(\"profile.ps1\");","+    let mut opts = opts(false);","+    opts.proxy_var_sub_dir = Some(\"bin\");","+","+    let report = setup_pwsh_shell(profile.clone(), Path::new(HOME), &opts).expect(\"setup pwsh\");","+    assert_eq!(","+        report.config_file.map(|config| config.change_type),","+        Some(ConfigFileChangeType::Created),","+    );","+    let written = fs::read_to_string(&profile).expect(\"read profile\");","+    assert_eq!(written, format!(\"{}\\n\", wrap_section(\"pnpm\", &render_pwsh_settings(HOME, &opts))));","+","+    let report = setup_pwsh_shell(profile, Path::new(HOME), &opts).expect(\"setup pwsh again\");","+    assert_eq!(","+        report.config_file.map(|config| config.change_type),","+        Some(ConfigFileChangeType::Skipped),","+    );","+}","+"," #[test]"," fn proxy_value_is_single_quote_escaped_against_injection() {","     // A command-substitution payload and an embedded single quote must end"],"additions":81,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/setup/tests.rs","lines":["@@ -50,6 +50,22 @@ fn created_config_reports_the_source_hint() {","     );"," }"," ","+#[test]","+fn created_powershell_profile_reports_the_dot_source_hint() {","+    let report = PathExtenderReport {","+        config_file: Some(ConfigReport {","+            path: PathBuf::from(\"/home/o'neil/.config/powershell/profile.ps1\"),","+            change_type: ConfigFileChangeType::Created,","+        }),","+        old_settings: String::new(),","+        new_settings: \"$env:PNPM_HOME = ...\".to_string(),","+    };","+    assert_eq!(","+        render_setup_output(&report),","+        \"Created /home/o'neil/.config/powershell/profile.ps1\\n\\nThe following configuration changes were made:\\n$env:PNPM_HOME = ...\\n\\nTo start using pnpm, run:\\n. '/home/o''neil/.config/powershell/profile.ps1'\\n\",","+    );","+}","+"," #[test]"," fn windows_report_omits_the_source_hint() {","     let report = PathExtenderReport {","@@ -114,6 +130,12 @@ fn no_modify_path_prints_nushell_syntax_for_nu() {","     assert!(settings.starts_with(\"$env.PNPM_HOME = \"), \"{settings}\");"," }"," ","+#[test]","+fn no_modify_path_prints_powershell_syntax_for_pwsh() {","+    let settings = unmodified_path_settings(&ManualSetupShell::Posix(Some(\"pwsh\".to_string())));","+    assert!(settings.starts_with(\"$env:PNPM_HOME = '/root/.pnpm'\\n\"), \"{settings}\");","+}","+"," #[test]"," fn no_modify_path_prints_export_lines_for_an_unknown_shell() {","     for shell in [None, Some(\"tcsh\".to_string())] {"],"additions":22,"deletions":0,"truncated":false},{"path":"pnpm/docs/uninstall.md","lines":["@@ -20,7 +20,7 @@ If you used the standalone script to install pnpm, then you should be able to un"," rm -rf \"$PNPM_HOME\""," ```"," ","-You might also want to clean the `PNPM_HOME` env variable in your shell configuration file (`$HOME/.bashrc`, `$HOME/.zshrc` or `$HOME/.config/fish/config.fish`).","+You might also want to clean the `PNPM_HOME` env variable in your shell configuration file (`$HOME/.bashrc`, `$HOME/.zshrc`, `$HOME/.config/fish/config.fish`, or `$HOME/.config/powershell/profile.ps1`)."," "," If you used npm to install pnpm, then you should use npm to uninstall pnpm:"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/npm/get-pnpm/README.md","lines":["@@ -46,7 +46,8 @@ and the command that removes it.","   `%LOCALAPPDATA%\\pnpm` on Windows."," - **Your shell configuration** — on Linux and macOS, `pnpm setup` adds a block like","   this to the rc file of your shell (`~/.bashrc`, `~/.zshrc`,","-  `~/.config/fish/config.fish`, or `~/.config/nushell/env.nu`), and says which file","+  `~/.config/fish/config.fish`, `~/.config/nushell/env.nu`, or","+  `~/.config/powershell/profile.ps1`), and says which file","   it changed:"," ","   ```sh"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm11/docs/uninstall.md","lines":["@@ -20,7 +20,7 @@ If you used the standalone script to install pnpm, then you should be able to un"," rm -rf \"$PNPM_HOME\""," ```"," ","-You might also want to clean the `PNPM_HOME` env variable in your shell configuration file (`$HOME/.bashrc`, `$HOME/.zshrc` or `$HOME/.config/fish/config.fish`).","+You might also want to clean the `PNPM_HOME` env variable in your shell configuration file (`$HOME/.bashrc`, `$HOME/.zshrc`, `$HOME/.config/fish/config.fish`, or `$HOME/.config/powershell/profile.ps1`)."," "," If you used npm to install pnpm, then you should use npm to uninstall pnpm:"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm11/engine/pm/commands/src/setup/setup.ts","lines":["@@ -9,6 +9,7 @@ import {","   addDirToEnvPath,","   type ConfigReport,","   type PathExtenderReport,","+  quotePowerShell,"," } from '@pnpm/os.env.path-extender'"," import PATH from 'path-name'"," import { renderHelp } from 'render-help'","@@ -327,13 +328,11 @@ async function addPnpmHomeToEnvPath (opts: { force?: boolean, pnpmHomeDir: strin"," }"," "," function renderWindowsManualSetupOutput (reason: string, pnpmHomeDir: string): string {","-  // PowerShell also treats typographic apostrophes as string delimiters.","-  const quotedHome = pnpmHomeDir.replace(/['\\u2018-\\u201b]/g, quote => quote + quote)","   return `${reason}"," "," pnpm is installed, but its environment could not be saved in the registry."," To start using pnpm in this PowerShell session, run:","-$env:PNPM_HOME = '${quotedHome}'","+$env:PNPM_HOME = ${quotePowerShell(pnpmHomeDir)}"," $env:Path = \"$env:PNPM_HOME\\\\bin;$env:Path\""," "," Add these lines to your PowerShell profile to use pnpm in future sessions.`","@@ -366,12 +365,19 @@ ${report.newSettings}`)","     output.push('Setup complete. Open a new terminal to start using pnpm.')","   } else if (report.configFile.changeType !== 'skipped') {","     output.push(`To start using pnpm, run:","-source ${report.configFile.path}","+${renderReloadCommand(report.configFile.path)}"," `)","   }","   return output.join('\\n\\n')"," }"," ","+function renderReloadCommand (configFile: string): string {","+  if (configFile.endsWith('.ps1')) {","+    return `. ${quotePowerShell(configFile)}`","+  }","+  return `source ${configFile}`","+}","+"," function reportConfigChange (configReport: ConfigReport): string {","   switch (configReport.changeType) {","     case 'created': return `Created ${configReport.path}`"],"additions":10,"deletions":4,"truncated":false},{"path":"pnpm11/engine/pm/commands/test/setup/setup.test.ts","lines":["@@ -5,7 +5,9 @@ import { afterEach, beforeEach, expect, jest, test } from '@jest/globals'"," import { PnpmError } from '@pnpm/error'"," import type { PathExtenderReport } from '@pnpm/os.env.path-extender'"," ","+const actualPa