 AddDirToPosixEnvPathOpts"," ): Promise<PathExtenderPosixReport> {","-  const supportedShellsMsg = 'Supported shell languages are bash, zsh, fish, ksh, dash, sh, and nushell.'","+  const supportedShellsMsg = 'Supported shell languages are bash, zsh, fish, ksh, dash, sh, nushell, and PowerShell.'","   switch (currentShell) {","     case 'bash':","     case 'zsh':","@@ -88,6 +88,9 @@ async function updateShell (","     case 'nu': {","       return setupNuShell(pnpmHomeDir, opts)","     }","+    case 'pwsh': {","+      return setupPwshShell(pnpmHomeDir, opts)","+    }","     case null:","     case '': {","       throw new PnpmError('UNKNOWN_SHELL', 'Could not infer shell type.', {","@@ -221,6 +224,46 @@ $env.PATH = ($env.PATH | split row (char esep) | ${addingCommand} ${pathRef} )`","   }"," }"," ","+async function setupPwshShell (dir: string, opts: AddDirToPosixEnvPathOpts): Promise<PathExtenderPosixReport> {","+  const configFile = path.join(process.env.XDG_CONFIG_HOME || path.join(os.homedir(), '.config'), 'powershell/profile.ps1')","+  const newSettings = renderPwshSettings(dir, opts)","+  const content = wrapSettings(opts.configSectionName, newSettings)","+  const { changeType, oldSettings } = await updateShellConfig(configFile, content, opts)","+  return {","+    configFile: {","+      path: configFile,","+      changeType,","+    },","+    oldSettings,","+    newSettings,","+  }","+}","+","+/**","+ * The block for PowerShell on a non-Windows platform, where `PATH` is","+ * `:`-separated. `-cne` compares case-sensitively, as the file system does.","+ */","+function renderPwshSettings (dir: string, opts: AddDirToPosixEnvPathOpts): string {","+  const entry = opts.proxyVarName","+    ? (opts.proxyVarSubDir ? `\"$env:${opts.proxyVarName}/${opts.proxyVarSubDir}\"` : `$env:${opts.proxyVarName}`)","+    : quotePowerShell(dir)","+  const start = (opts.position ?? 'start') === 'start'","+  const pathValue = start ? `${entry} + ':' + $env:PATH` : `$env:PATH + ':' + ${entr