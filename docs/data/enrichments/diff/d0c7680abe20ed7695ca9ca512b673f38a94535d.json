ted for a server. For now servers are always configured by address,","+         * which leaves DNS-over-TLS as the only encrypted transport. It ranks higher than classic DNS, hence","+         * is preferred when both are permitted. */","+","+        switch (mode) {","+","+        case DNS_ENCRYPTION_NO:","+                *ret = INDEX_TO_MASK(DnsTransportPolicy, DNS_TRANSPORT_DNS);","+                break;","+","+        case DNS_ENCRYPTION_OPPORTUNISTIC:","+                *ret = INDEXES_TO_MASK(DnsTransportPolicy, DNS_TRANSPORT_DOT, DNS_TRANSPORT_DNS);","+                break;","+","+        case DNS_ENCRYPTION_REQUIRED:","+                *ret = INDEX_TO_MASK(DnsTransportPolicy, DNS_TRANSPORT_DOT);","+                break;","+","+        case _DNS_ENCRYPTION_MODE_MAX:","+        case _DNS_ENCRYPTION_MODE_INVALID:","+                assert_not_reached();","+        }","+}","+","+bool dns_transport_policy_contains(DnsTransportPolicy p, DnsTransportKind kind) {","+        if (kind < 0 || kind >= _DNS_TRANSPORT_KIND_MAX)","+                return false;","+","+        return BIT_SET(p, kind);","+}","+","+DnsTransportKind dns_transport_policy_best(DnsTransportPolicy p) {","+        DnsTransportKind best = _DNS_TRANSPORT_KIND_INVALID;","+","+        /* Returns the most preferred transport the policy permits, i.e. the highest ranking one, if any */","+","+        BIT_FOREACH(k, p) {","+                if (k >= _DNS_TRANSPORT_KIND_MAX)","+                        break;","+","+                best = k;","+        }","+","+        return best;","+}","+","+DnsTransportKind dns_transport_policy_next(DnsTransportPolicy p, DnsTransportKind kind) {","+        /* Returns the transport to fall back to after 'kind', if any, i.e. the next lower ranking one the","+         * policy permits */","+","+        if (!dns_transport_policy_contains(p, kind))","+                return _DNS_TRANSPORT_KIND_INVALID;","+","+        return dns_transport_policy_best(p & (INDEX_TO_MASK(DnsTransportPolicy, kind) - 1));","+}","+"," int dns_server_feature_level_compare(DnsServerFeatureLevel a, DnsServerFeatureLevel b) {","         int r;"," "],"additions":83,"deletions":0,"truncated":false},{"path":"src/resolve/resolved-dns-transport.h","lines":["@@ -3,6 +3,7 @@"," "," #include <netinet/in.h>"," ","+#include \"resolve-util.h\""," #include \"resolved-forward.h\""," "," /* The wire transports used to talk to unicast DNS servers. The enum order is significant: when comparing","@@ -16,6 +17,30 @@ typedef enum DnsTransportKind {"," "," DECLARE_STRING_TABLE_LOOKUP(dns_transport_kind, DnsTransportKind);"," ","+/* Whether traffic to a server has to be encrypted. Derived from the DNSOverTLS= setting. */","+typedef enum DnsEncryptionMode {","+        DNS_ENCRYPTION_NO,             /* Classic DNS only */","+        DNS_ENCRYPTION_OPPORTUNISTIC,  /* Encrypted if that works, classic DNS otherwise */","+        DNS_ENCRYPTION_REQUIRED,       /* Encrypted, or not at all */","+        _DNS_ENCRYPTION_MODE_MAX,","+        _DNS_ENCRYPTION_MODE_INVALID = -EINVAL,","+} DnsEncryptionMode;","+","+DECLARE_STRING_TABLE_LOOKUP(dns_encryption_mode, DnsEncryptionMode);","+","+DnsEncryptionMode dns_encryption_mode_from_dns_over_tls_mode(DnsOverTlsMode m) _const_;","+","+/* The transports that may be used to talk to a server, as a mask of bits indexed by DnsTransportKind. Of the","+ * permitted transports the highest ranking one is preferred, and falls back to the next lower ranking one. */","+typedef uint64_t DnsTransportPolicy;","+","+assert_cc(_DNS_TRANSPORT_KIND_MAX <= sizeof(DnsTransportPolicy) * 8);","+","+void dns_transport_policy_init(DnsEncryptionMode mode, DnsTransportPolicy *ret);","+bool dns_transport_policy_contains(DnsTransportPolicy p, DnsTransportKind kind) _const_;","+DnsTransportKind dns_transport_policy_best(DnsTransportPolicy p) _const_;","+DnsTransportKind dns_transport_policy_next(DnsTransportPolicy p, DnsTransportKind kind) _const_;","+"," /* What the server unde