 its own workspace, and a `requirements.txt` there usually lists tooling","-/// installed by other means.","+/// installed by other means. So is a directory [`Discovery::unmanaged`]","+/// names, whose file is left unread."," async fn read_adjacent_requirements(","     path: &Path,","     mut manifest: Manifest,","-    allowed_root: &Path,","+    adjacent: Adjacent<'_>,"," ) -> Result<Manifest> {","-    if manifest.project.is_none() && manifest.tool.uv.workspace.is_none() {","-        let requirements_path = path.with_file_name(\"requirements.txt\");","-        if tokio::fs::try_exists(&requirements_path).await.into_diagnostic()? {","-            let allowed_root = allowed_root.to_path_buf();","-            let requirements = tokio::task::spawn_blocking(move || {","-                requirements::read(&requirements_path, &allowed_root)","-            })","-            .await","-            .into_diagnostic()","-            .wrap_err(\"join Python requirements parsing\")??;","-            manifest.set_requirements_file(requirements);","-        }","+    if manifest.project.is_some() || manifest.tool.uv.workspace.is_some() {","+        return Ok(manifest);","+    }","+    let requirements_path = path.with_file_name(\"requirements.txt\");","+    if !tokio::fs::try_exists(&requirements_path).await.into_diagnostic()? {","+        return Ok(manifest);","+    }","+    let allowed_root = adjacent.allowed_root.to_path_buf();","+    let own_environment = adjacent.own_environment.cloned();","+    let requirements = tokio::task::spawn_blocking(move || {","+        read_managed_requirements(own_environment.as_ref(), &requirements_path, &allowed_root)","+    })","+    .await","+    .into_diagnostic()","+    .wrap_err(\"join Python requirements parsing\")??;","+    match requirements {","+        Some(requirements) => manifest.set_requirements_file(requirements),","+        None => manifest.has_unmanaged_requirements = true,","     }","     Ok(manifest)"," }"," ","+/// The requirements `path` lists, or `None` when the directory installs","+/// into a `.venv` of its own that is unmanaged.","+fn read_managed_requirements(","+    own_environment: Option<&EnvironmentStore>,","+    path: &Path,","+    allowed_root: &Path,","+) -> Result<Option<Vec<String>>> {","+    let root = path.parent().expect(\"requirements file has a parent\");","+    if let Some(environments) = own_environment","+        && matches!(environments.link(root)?, EnvironmentLink::Unmanaged)","+    {","+        return Ok(None);","+    }","+    requirements::read(path, allowed_root).map(Some)","+}","+"," #[cfg(test)]"," mod tests;"],"additions":93,"deletions":34,"truncated":false},{"path":"pnpm/crates/python-installer/src/discovery/tests.rs","lines":["@@ -236,3 +236,55 @@ async fn reports_invalid_utf8_in_a_declared_member() {"," ","     assert!(error.to_string().contains(\"decode \"), \"{error:?}\");"," }","+","+#[tokio::test]","+async fn an_unmanaged_environment_skips_only_a_project_that_installs_into_it() {","+    let root = tempfile::tempdir().unwrap();","+    let workspace = root.path().join(\"workspace\");","+    fs::create_dir(&workspace).unwrap();","+    fs::write(","+        workspace.join(\"pyproject.toml\"),","+        \"[tool.uv.workspace]\\nmembers = ['shared/*']\\n\\n[tool.pnpm.python]\\nshared-environment = true\\n\",","+    )","+    .unwrap();","+    let member = workspace.join(\"shared/tools\");","+    let standalone = root.path().join(\"standalone\");","+    for project in [&member, &standalone] {","+        fs::create_dir_all(project.join(\".venv\")).unwrap();","+        fs::write(project.join(\"requirements.txt\"), \"ruff==0.14.13\\n\").unwrap();","+    }","+    let manifests = vec![","+        workspace.join(\"pyproject.toml\"),","+        member.join(\"requirements.txt\"),","+        standalone.join(\"requirements.txt\"),","+    ];","+","+    let discovery = discover(&Config::default(), root.path(), &manifests).await.unwrap();","+","+    assert_eq!(discovery.project_roots().collect::<Vec<_>>(), [member]);","+    assert_eq!(discovery.unmanaged, [standalone]);","+}","+","+#[tokio::test]","+async fn a_nested_workspace_that_shares_nothing_keeps_its_members_out_of_the_outer_environment() {","+    let root = tempfile::tempdir().unwrap();","+    fs::write(","+        root.path().join(\"pyproject.toml\"),","+        \"[tool.uv.workspace]\\nmembers = ['nested/*']\\n\\n[tool.pnpm.python]\\nshared-environment = true\\n\",","+    )","+    .unwrap();","+    let nested = root.path().join(\"nested\");","+    let tools = nested.join(\"tools\");","+    fs::create_dir_all(tools.join(\".venv\")).unwrap();","+    fs::write(nested.join(\"pyproject.toml\"), \"[tool.uv.workspace]\\nmembers = ['tools']\\n\").unwrap();","+    fs::write(tools.join(\"requirements.txt\"), \"--index-url https://example.com/simple\\n\").unwrap();","+    let manifests = vec![","+        root.path().join(\"pyproject.toml\"),","+        nested.join(\"pyproject.toml\"),","+        tools.join(\"requirements.txt\"),","+    ];","+","+    let discovery = discover(&Config::default(), root.path(), &manifests).await.unwrap();","+","+    assert_eq!(discovery.unmanaged, [tools]);","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"pnpm/crates/python-installer/src/environment.rs","lines":["@@ -1,4 +1,4 @@","-pub(super) use store::{EnvironmentStore, Generation, publish_link};","+pub(super) use store::{EnvironmentLink, EnvironmentStore, Generation, publish_link};"," "," use super::{","     Arc, Environments, Index, Inputs, InstallOptions, Interpreter, IntoDiagnostic, Lockfile,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/python-installer/src/environment/store.rs","lines":["@@ -22,6 +22,19 @@ pub(crate) struct EnvironmentStore {","     frozen: bool,"," }"," ","+/// What a project's `.venv` is to pnpm.","+pub(crate) enum EnvironmentLink {","+    /// There is no `.venv`, or it links to an environment that no longer","+    /// exists.","+    Absent,","+    /// A link to this generation of pnpm's. A link into the store from","+    /// another project's directory is still pnpm's: a project that has","+    /// moved keeps its environment.","+    Managed(PathBuf),","+    /// A directory, or a link to anything but a generation of pnpm's.","+    Unmanaged,","+}","+"," impl EnvironmentStore {","     pub(crate) fn new(config: &pnpm_config::Config) -> Self {","         Self { root: config.store_dir.root().join(\"python-envs\"), frozen: config.frozen_store }","@@ -66,34 +79,35 @@ impl EnvironmentStore {","     }"," ","     /// The generation the project's `.venv` currently links to, or `None`","-    /// when it has no environment, or links to one that no longer exists.","-    ///","-    /// pnpm replaces only a link it made, so a `.venv` that is a directory,","-    /// or a link to anything but a generation of pnpm's, is refused. A link","-    /// into this store from another project's directory is still pnpm's: a","-    /// project that has moved keeps its environment.","+    /// when it has no environment. pnpm replaces only a link it made, so","+    /// an [`EnvironmentLink::Unmanaged`] one is refused.","     pub(crate) fn validate_link(&self, root: &Path) -> Result<Option<PathBuf>> {","+        match self.link(root)? {","+            EnvironmentLink::Absent => Ok(None),","+            EnvironmentLink::Managed(generation) => Ok(Some(generation)),","+            EnvironmentLink::Unmanaged => {","+                let link = root.join(\".venv\");","+                bail!(\"pnpm will not replace an unmanaged Python environment: {}\", link.display());","+            }","+        }","+    }","+","+    pub(crate) fn link(&self, root: &Path) -> Result<EnvironmentLink> {","         let link = root.join(\".venv\");","         match fs::symlink_metadata(&link) {","-            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),","+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(EnvironmentLink::Absent),","             Err(error) => Err(error).into_diagnostic(),","             Ok(_) => {","                 if !pnpm_fs::is_symlink_or_junction(&link).into_diagnostic()? {","-                    bail!(","-                        \"pnpm will not replace an unmanaged Python environment: {}\",","-                        link.display(),","-                    );","+                    return Ok(EnvironmentLink::Unmanaged);","                 }","                 let Some(target) = link_target(root, &link)? else {","-                    return Ok(None);","+                    return Ok(EnvironmentLink::Absent);","                 };","                 if !self.holds(&target)? && !holds_beside_project(root, &target)? {","-                    bail!(","-                        \"pnpm will not replace an unmanaged Python environment: {}\",","-                        link.display(),","-                    );","+                    return Ok(EnvironmentLink::Unmanaged);","                 }","-                Ok(Some(target))","+                Ok(EnvironmentLink::Managed(target))","             }","         }","     }"],"additions":31,"deletions":17,"truncated":false},{"path":"pnpm/crates/python-installer/src/lib.rs","lines":["@@ -94,12 +94,26 @@ pub fn plan<Reporter: self::Reporter + 'static>(","         .iter()","         .map(|membership| membership.root.join(\"pylock.toml\"))","         .collect();","+    report_unmanaged_requirements::<Reporter>(&discovery.unmanaged);","     pnpm_install_coordinator::InstallTask::new(","         metadata,","         prepare::<Reporter>(context, discovery, false, selection, selected),","     )"," }"," ","+fn report_unmanaged_requirements<Reporter: self::Reporter + 'static>(unmanaged: &[PathBuf]) {","+    for root in unmanaged {","+        let environment = root.join(\".venv\");","+        let message = format!(","+            \"Skipping the Python requirements in {}: pnpm did not create {}. Remove that \\","+             directory to let pnpm install them.\",","+            root.display(),","+            environment.display(),","+        );","+        Reporter::emit(&LogEvent::Global(GlobalLog { level: LogLevel::Warn, message }));","+    }","+}","+"," /// Say which of the platforms this install prepares for pnpm cannot"," /// resolve Python for."," ///"],"additions":14,"deletions":0,"truncated":false},{"path":"pnpm/crates/python-installer/src/manifest.rs","lines":["@@ -40,6 +40,10 @@ pub(super) struct Manifest {","     pub(super) metadata_wheel: Option<std::sync::Arc<super::build::FallbackWheel>>,","     #[serde(skip)]","     pub(super) metadata_output: Option<std::sync::Arc<tempfile::TempDir>>,","+    /// Whether the `requirements.txt` beside the manifest was left unread","+    /// because the directory's `.venv` is unmanaged.","+    #[serde(skip)]","+    pub(super) has_unmanaged_requirements: bool,","     #[serde(default, rename = \"dependency-groups\")]","     groups: BTreeMap<String, Vec<toml::Value>>,","     #[serde(default, rename = \"build-system\")]"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm/crates/python-installer/src/workspace/members.rs","lines":["@@ -187,12 +187,28 @@ fn member_projects<'a>("," #[derive(Default)]"," pub(crate) struct DeclaredWorkspaces {","     declarations: BTreeMap<PathBuf, Patterns>,","+    /// The declaring roots whose members share an environment.","+    sharing: BTreeSet<PathBuf>,"," }"," "," impl DeclaredWorkspaces {","     pub(crate) fn add(&mut self, root: &Path, manifest: &Manifest) {","         let Some(declaration) = manifest.tool.uv.workspace.as_ref() else { return };","         self.declarations.insert(root.to_path_buf(), Patterns::of(declaration));","+        if manifest.shares_environment() {","+            self.sharing.insert(root.to_path_buf());","+        }","+    }","+","+    /// Whether `candidate` installs into the environment of the nearest","+    /// workspace declared at or above it, not into one of its own.","+    pub(crate) fn shares_environment(&self, candidate: &Path) -> bool {","+        candidate","+            .ancestors()","+            .find_map(|root| Some((root, self.declarations.get(root)?)))","+            .is_some_and(|(root, patterns)| {","+                self.sharing.contains(root) && patterns.contain(root, candidate)","+            })","     }"," ","     /// Whether the nearest workspace declaration contains `candidate`."],"additions":16,"deletions":0,"truncated":false},{"path":"pnpm/docs/python.md","lines":["@@ -55,7 +55,7 @@ Python requirement, marker, and lockfile semantics are kept separate from npm's"," "," Added in: v12.5.0"," ","-pnpm installs the project's own package editable when it declares `[build-system]`, making its imports and `[project.scripts]` commands available immediately. Source edits take effect without reinstalling. `[tool.uv].package` overrides whether the project is packaged. Dynamic metadata is read from the declared build backend. A project with only `requirements.txt` can also receive an environment and `pylock.toml`.","+pnpm installs the project's own package editable when it declares `[build-system]`, making its imports and `[project.scripts]` commands available immediately. Source edits take effect without reinstalling. `[tool.uv].package` overrides whether the project is packaged. Dynamic metadata is read from the declared build backend. A project with only `requirements.txt` can also receive an environment and `pylock.toml`. If its directory already has a `.venv` that pnpm did not create, `pnpm install` leaves that project alone and prints a warning. Remove the `.venv` to let pnpm install the requirements."," "," Declare workspace and local dependencies in `pyproject.toml`:"," ",""],"additions":1,"deletions":1,"truncated":false}],"additions":260,"deletions":53,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-18T16:50:07.549849+00:00"}