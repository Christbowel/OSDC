{"id":"9443c81621313c4226acca566621bb519e9c273a","axis":"silent","repo":"pnpm/pnpm","sha":"9443c81621313c4226acca566621bb519e9c273a","parsed":{"files":[{"path":".changeset/requirements-only-unmanaged-venv.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` now skips a Python project that has only a `requirements.txt` when its directory has a `.venv` that pnpm did not create, and prints a warning. The install failed for the whole workspace before."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/python/metadata.rs","lines":["@@ -570,3 +570,46 @@ fn a_virtual_workspace_root_leaves_its_requirements_and_environment_alone() {","     assert_eq!(fs::read_to_string(root.path().join(\".venv/owned-by-user\")).unwrap(), \"preserve\");","     assert!(!root.path().join(\"pylock.toml\").exists());"," }","+","+#[test]","+fn a_requirements_only_project_with_an_unmanaged_environment_is_skipped() {","+    for manifest in [None, Some(\"[tool.ruff]\\nline-length = 100\\n\")] {","+        let root = tempfile::tempdir().unwrap();","+        project(root.path(), \"https://unused.invalid\", &[]);","+        match manifest {","+            Some(contents) => fs::write(root.path().join(\"pyproject.toml\"), contents).unwrap(),","+            None => fs::remove_file(root.path().join(\"pyproject.toml\")).unwrap(),","+        }","+        // An option pnpm does not read: the file is the user's, so it is","+        // never parsed.","+        fs::write(","+            root.path().join(\"requirements.txt\"),","+            \"--index-url https://example.com/simple\\nruff==0.14.13\\n\",","+        )","+        .unwrap();","+        fs::create_dir(root.path().join(\".venv\")).unwrap();","+        fs::write(root.path().join(\".venv/owned-by-user\"), \"preserve\").unwrap();","+        for arguments in","+            [&[\"install\", \"--offline\"][..], &[\"install\", \"--offline\", \"--frozen-lockfile\"]]","+        {","+            let output = super::pacquet_in(root.path())","+                .args(arguments)","+                .assert()","+                .success()","+                .get_output()","+                .clone();","+            let reported = format!(","+                \"{}{}\",","+                String::from_utf8_lossy(&output.stdout),","+                String::from_utf8_lossy(&output.stderr),","+            );","+            eprintln!(\"{reported}\");","+            assert!(reported.contains(\"Skipping the Python requirements in\"));","+        }","+        assert_eq!(","+            fs::read_to_string(root.path().join(\".venv/owned-by-user\")).unwrap(),","+            \"preserve\",","+        );","+        assert!(!root.path().join(\"pylock.toml\").exists());","+    }","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"pnpm/crates/python-installer/src/discovery.rs","lines":["@@ -2,6 +2,7 @@"," //! the workspace selection and the install itself see the same manifests."," "," use super::{","+    environment::{EnvironmentLink, EnvironmentStore},","     manifest::{Manifest, RequirementScope},","     requirements,","     workspace::{Workspace, members::DeclaredWorkspaces},","@@ -43,6 +44,10 @@ const DEFAULT_IGNORED_DIRECTORY_BASENAMES: &[&str] = &["," pub struct Discovery {","     pub(super) roots: Vec<(PathBuf, Arc<Manifest>)>,","     pub(super) workspace: Workspace,","+    /// The requirements-only directories whose `.venv` is unmanaged.","+    /// Such a `requirements.txt` often lists tooling its user installs by","+    /// other means, so the directory is not a project.","+    pub(super) unmanaged: Vec<PathBuf>,"," }"," "," /// A discovered project as the workspace filter sees it: the directory","@@ -69,13 +74,18 @@ pub async fn discover(","     workspace_root: &Path,","     manifests: &[PathBuf],"," ) -> Result<Discovery> {","-    let roots = read_project_manifests(manifests, workspace_root, config.workspace_dir.as_deref())","-        .await?","+    let reading = Reading {","+        workspace_root,","+        allowed_root: config.workspace_dir.as_deref(),","+        environments: EnvironmentStore::new(config),","+    };","+    let (roots, unmanaged) = read_project_manifests(manifests, reading).await?;","+    let roots = roots","         .into_iter()","         .map(|(root, manifest)| (root, Arc::new(manifest)))","         .collect::<Vec<_>>();","     let workspace = Workspace::new(&roots)?;","-    Ok(Discovery { roots, workspace })","+    Ok(Discovery { roots, workspace, unmanaged })"," }"," "," impl Discovery {","@@ -112,13 +122,16 @@ impl Discovery {","         config: &pnpm_config::Config,","         edited: &BTreeSet<PathBuf>,","     ) -> Result<Self> {","+        let environments = EnvironmentStore::new(config);","         for root in edited {","             let path = root.join(\"pyproject.toml\");","             let contents = tokio::fs::read_to_string(&path).await","                 .into_diagnostic()","                 .wrap_err_with(|| format!(\"read {}\", path.display()))?;","             let allowed_root = config.workspace_dir.as_deref().unwrap_or(root);","-            let manifest = Arc::new(read_manifest(&path, &contents, allowed_root).await?);","+            let own_environment = (self.workspace.lock_root(root) == root).then_some(&environments);","+            let adjacent = Adjacent { allowed_root, own_environment };","+            let manifest = Arc::new(read_manifest(&path, &contents, adjacent).await?);","             match self.roots","                 .iter_mut()","                 .find(|(discovered, _)| discovered == root)","@@ -162,47 +175,60 @@ impl Discovery {","     }"," }"," ","-/// The Python manifests admitted by the nearest `[tool.uv.workspace]`.","+struct Reading<'a> {","+    workspace_root: &'a Path,","+    allowed_root: Option<&'a Path>,","+    environments: EnvironmentStore,","+}","+","+/// The Python manifests admitted by the nearest `[tool.uv.workspace]`, and","+/// the directories [