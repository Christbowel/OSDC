umnAsync(client, info, \"db_schema_name\"));","+","+\t\tinfo = await client.GetDbSchemasAsync(catalog: \"missing\", cancellationToken: token);","+\t\tAssert.Empty(await ReadStringColumnAsync(client, info, \"db_schema_name\"));","+\t}","+","+\t[Fact]","+\tpublic async Task GetTables() {","+\t\tusing var channel = GrpcChannel.ForAddress(HostingAddress);","+\t\tvar client = new FlightSqlClient(new FlightClient(channel));","+\t\tvar token = TestContext.Current.CancellationToken;","+","+\t\tvar info = Assert.Single(await client.GetTablesAsync(cancellationToken: token));","+\t\tAssert.Null(info.Schema.GetFieldByName(\"table_schema\"));","+\t\tvar rows = await ReadTablesAsync(client, info);","+\t\tAssert.Contains((\"kdb\", \"records\", \"TABLE\"), rows);","+","+\t\tinfo = Assert.Single(await client.GetTablesAsync(dbSchemaFilterPattern: \"kdb\", tableFilterPattern: \"rec%\", cancellationToken: token));","+\t\tAssert.Equal([(\"kdb\", \"records\", \"TABLE\")], await ReadTablesAsync(client, info));","+","+\t\tinfo = Assert.Single(await client.GetTablesAsync(tableFilterPattern: \"missing%\", cancellationToken: token));","+\t\tAssert.Empty(await ReadTablesAsync(client, info));","+","+\t\tinfo = Assert.Single(await client.GetTablesAsync(tableTypes: [\"VIEW\"], cancellationToken: token));","+\t\tAssert.Empty(await ReadTablesAsync(client, info));","+\t}","+","+\t[Fact]","+\tpublic async Task GetTablesWithSchema() {","+\t\tusing var channel = GrpcChannel.ForAddress(HostingAddress);","+\t\tvar client = new FlightSqlClient(new FlightClient(channel));","+\t\tvar token = TestContext.Current.CancellationToken;","+","+\t\tvar info = Assert.Single(await client.GetTablesAsync(","+\t\t\tdbSchemaFilterPattern: \"kdb\",","+\t\t\ttableFilterPattern: \"records\",","+\t\t\tincludeSchema: true,","+\t\t\tcancellationToken: token));","+\t\tAssert.NotNull(info.Schema.GetFieldByName(\"table_schema\"));","+","+\t\tvar schemas = new List<Schema>();","+\t\tawait foreach (var batch in client.DoGetAsync(Assert.Single(info.Endpoints).Ticket, cancellationToken: token)) {","+\t\t\tusing (batch) {","+\t\t\t\tvar column = (BinaryArray)batch.Column(\"table_schema\");","+\t\t\t\tfor (var i = 0; i < column.Length; i++) {","+\t\t\t\t\tschemas.Add(SchemaExtensions.DeserializeSchema(column.GetBytes(i).ToArray()));","+\t\t\t\t}","+\t\t\t}","+\t\t}","+","+\t\tvar schema = Assert.Single(schemas);","+\t\tAssert.NotNull(schema.GetFieldByName(\"log_position\"));","+\t}","+","+\t[Fact]","+\tpublic async Task GetTableTypes() {","+\t\tusing var channel = GrpcChannel.ForAddress(HostingAddress);","+\t\tvar client = new FlightSqlClient(new FlightClient(channel));","+","+\t\tvar info = await client.GetTableTypesAsync(cancellationToken: TestContext.Current.CancellationToken);","+\t\tAssert.Equal([\"TABLE\"], await ReadStringColumnAsync(client, info, \"table_type\"));","+\t}","+","+\tprivate static async Task<List<string?>> ReadStringColumnAsync(FlightSqlClient client, FlightInfo info, string columnName) {","+\t\tvar values = new List<string?>();","+\t\tawait foreach (var batch in client.DoGetAsync(Assert.Single(info.Endpoints).Ticket, cancellationToken: TestContext.Current.CancellationToken)) {","+\t\t\tusing (batch) {","+\t\t\t\tvar column = (StringArray)batch.Column(columnName);","+\t\t\t\tfor (var i = 0; i < column.Length; i++) {","+\t\t\t\t\tvalues.Add(column.GetString(i));","+\t\t\t\t}","+\t\t\t}","+\t\t}","+","+\t\treturn values;","+\t}","+","+\tprivate static async Task<List<(string?, string?, string?)>> ReadTablesAsync(FlightSqlClient client, FlightInfo info) {","+\t\tvar rows = new List<(string?, string?, string?)>();","+\t\tawait foreach (var batch in client.DoGetAsync(Assert.Single(info.Endpoints).Ticket, cancellationToken: TestContext.Current.CancellationToken)) {","+\t\t\tusing (batch) {","+\t\t\t\tvar catalogs = (StringArray)batch.Column(\"catalog_name\");","+\t\t\t\tvar schemas = (StringArray)batch.Column(\"db_schema_name\");","+\t\t\t\tvar tables = (StringArray)batch.Column(\"table_name\");","+\t\t\t\tvar types = (StringArray)batch.Column(\"table_type\");","+\t\t\t\tfor (var i = 0; i < batch.Length; i++) {","+\t\t\t\t\tAssert.True(catalogs.IsNull(i));","+\t\t\t\t\trows.Add((schemas.GetString(i), tables.GetString(i), types.GetString(i)));","+\t\t\t\t}","+\t\t\t}","+\t\t}","+","+\t\treturn rows;","+\t}","+"," \tprivate string HostingAddress {"," \t\tget {"," \t\t\tvar urls = Fixture"],"additions":111,"deletions":0,"truncated":false},{"path":"src/KurrentDB.SecondaryIndexing.Tests/IntegrationTests/ReadTests.cs","lines":["@@ -1,6 +1,7 @@"," // Copyright (c) Kurrent, Inc and/or licensed to Kurrent, Inc under one or more agreements."," // Kurrent, Inc licenses this file to you under the Kurrent License v1 (see LICENSE.md)."," ","+using System.Text;"," using KurrentDB.Core.ClientPublisher;"," using KurrentDB.Core.Data;"," using KurrentDB.Core.Services;","@@ -28,11 +29,13 @@ public async Task ReadsAllEventsFromDefaultIndex(bool forwards) {"," \t\tawait ValidateRead(SystemStreams.DefaultSecondaryIndex, Fixture.AppendedBatches.ToDefaultIndexResolvedEvents(), forwards);"," \t}"," ","-\t[Fact]","-\tpublic async Task ReadFromDefaultIndexUsingQueryEngine() {","+\t[Theory]","+\t[InlineData(\"SELECT metadata FROM kdb.records\")]","+\t[InlineData(\"SHOW TABLES\")]","+\tpublic async Task ReadFromDefaultIndexUsingQueryEngine(string query) {"," \t\tvar engine = Fixture.NodeServices.GetRequiredService<IQueryEngine>();"," \t\tusing var preparedSql = engine.PrepareQuery(","-\t\t\t\"SELECT metadata FROM kdb.records\"u8,","+\t\t\tEncoding.UTF8.GetBytes(query),"," \t\t\tnew() { UseDigitalSignature = true });"," "," \t\tvar consumer = new RowCountReader();"],"additions":6,"deletions":3,"truncated":false},{"path":"src/KurrentDB.SecondaryIndexing.Tests/Storage/QueryTablesFunctionTests.cs","lines":["@@ -0,0 +1,43 @@","+// Copyright (c) Kurrent, Inc and/or licensed to Kurrent, Inc under one or more agreements.","+// Kurrent, Inc licenses this file to you under the Kurrent License v1 (see LICENSE.md).","+","+using DuckDB.NET.Data;","+using KurrentDB.SecondaryIndexing.Query;","+using KurrentDB.SecondaryIndexing.Storage;","+","+namespace KurrentDB.SecondaryIndexing.Tests.Storage;","+","+public sealed class QueryTablesFunctionTests {","+\t[Theory]","+\t[InlineData(0)]","+\t[InlineData(1)]","+\t[InlineData(2)]","+\t[InlineData(5000)] // spans multiple data chunks","+\tpublic void ReturnsAllTablesSorted(int userTablesCount) {","+\t\tvar tables = Enumerable.Range(0, userTablesCount)","+\t\t\t.Select(static i => new TableInfo(\"usr\", $\"index-{i}\"))","+\t\t\t.Append(new(\"kdb\", \"records\"))","+\t\t\t.ToArray();","+","+\t\tusing var connection = new DuckDBConnection(\"Data Source=:memory:\");","+\t\tconnection.Open();","+\t\tnew QueryTablesFunction(new StubSchemaProvider(tables)).Register(connection);","+","+\t\tusing var command = connection.CreateCommand();","+\t\tcommand.CommandText = $\"SELECT * FROM {QueryTablesFunction.Name}()\";","+\t\tusing var reader = command.ExecuteReader();","+","+\t\tvar actual = new List<string>();","+\t\twhile (reader.Read())","+\t\t\tactual.Add(reader.GetString(0));","+","+\t\tvar expected = tables.Select(static t => t.FullName).Order(StringComparer.Ordinal);","+\t\tAssert.Equal(expected, actual);","+\t}","+","+\tprivate sealed class StubSchemaProvider(IReadOnlyList<TableInfo> tables) : IDatabaseSchemaProvider {","+\t\tIEnumerable<TableInfo> IDatabaseSchemaProvider.Tables => tables;","+","+\t\tApache.Arrow.Schema IDatabaseSchemaProvider.GetTableSchema(TableInfo table) => throw new NotSupportedException();","+\t}","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"src/KurrentDB.SecondaryIndexing/FlightSql/ConnectionState.PreparedStmt.cs","lines":["@@ -136,7 +136,7 @@ private PreparedStatement CreatePreparedStatement(ReadOnlySpan<char> query,"," \t\ttry {"," \t\t\tvar preparedQuery = engine"," \t\t\t\t.PrepareQuery(buffer.Span, new() { UseDigitalSignature = false });","-\t\t\treturn new(preparedQuery, engine.GetArrowSchema(preparedQuery.Span, out parameters));","+\t\t\treturn new(preparedQuery, engine.GetQuerySchema(preparedQuery.Span, out parameters));"," \t\t} finally {"," \t\t\tbuffer.Dispose();"," \t\t}"],"additions":1,"deletions":1,"truncated":false},{"path":"src/KurrentDB.SecondaryIndexing/FlightSql/FlightSqlServer.Metadata.cs","lines":["@@ -0,0 +1,151 @@","+// Copyright (c) Kurrent, Inc and/or licensed to Kurrent, Inc under one or more agreements.","+// Kurrent, Inc licenses this file to you under the Kurrent License v1 (see LICENSE.md).","+","+using Apache.Arrow;","+using Apache.Arrow.Flight;","+using Apache.Arrow.Flight.Server;","+using Apache.Arrow.Flight.Sql;","+using Arrow.Flight.Protocol.Sql;","+using Google.Protobuf;","+using KurrentDB.SecondaryIndexing.Indexes.User.Management;","+using KurrentDB.SecondaryIndexing.Query;","+using FlightSqlServerHelpers = Apache.Arrow.Flight.Sql.FlightSqlServer;","+","+namespace KurrentDB.SecondaryIndexing.FlightSql;","+","+// Catalog metadata commands: https://arrow.apache.org/docs/format/FlightSql.html","+partial class FlightSqlServer {","+\t// Every table is backed by a DuckDB view, but for the client it is just a read-only table","+\tprivate const string TableType = \"TABLE\";","+","+\t// The ticket is the command itself, so DoGet can re-apply its filters","+\tprivate FlightInfo GetMetadataInfo(IMessage command, Schema schema, FlightDescriptor descriptor)","+\t\t=> new(schema, descriptor, [new FlightEndpoint(new FlightTicket(PackToAny(command)), [])]);","+","+\tprivate Task WriteDbSchemasAsync(CommandGetDbSchemas command, FlightServerRecordBatchStreamWriter writer) {","+\t\tIEnumerable<string> schemas = MatchesCatalog(command.Catalog)","+\t\t\t? engine.Tables","+\t\t\t\t.Select(static table => table.Schema)","+\t\t\t\t.Distinct()","+\t\t\t\t.Where(schema => MatchesPattern(command.DbSchemaFilterPattern, schema))","+\t\t\t\t.Order(StringComparer.Ordinal)","+\t\t\t: [];","+","+\t\tvar catalogNames = new StringArray.Builder();","+\t\tvar schemaNames = new StringArray.Builder();","+\t\tforeach (var schema in schemas) {","+\t\t\tcatalogNames.AppendNull();","+\t\t\tschemaNames.Append(schema);","+\t\t}","+","+\t\treturn WriteBatchAsync(writer, FlightSqlServerHelpers.DbSchemaFlightSchema, schemaNames.Length, catalogNames.Build(),","+\t\t\tschemaNames.Build());","+\t}","+","+\tprivate Task WriteTablesAsync(CommandGetTables command, FlightServerRecordBatchStreamWriter writer) {","+\t\tIEnumerable<TableInfo> tables = MatchesCatalog(command.Catalog)","+\t\t                                && (command.TableTypes is [] || command.TableTypes.Contains(TableType))","+\t\t\t? engine.Tables","+\t\t\t\t.Where(table => MatchesPattern(command.DbSchemaFilterPattern, table.Schema)","+\t\t\t\t                && MatchesPattern(command.TableNameFilterPattern, table.Name))","+\t\t\t\t.OrderBy(static table => table.Schema, StringComparer.Ordinal)","+\t\t\t\t.ThenBy(static table => table.Name, StringComparer.Ordinal)","+\t\t\t: [];","+","+\t\tvar catalogNames = new StringArray.Builder();","+\t\tvar schemaNames = new StringArray.Builder();","+\t\tvar tableNames = new StringArray.Builder();","+\t\tvar tableTypes = new StringArray.Builder();","+\t\tvar tableSchemas = command.IncludeSchema ? new BinaryArray.Builder() : null;","+\t\tforeach (var table in tables) {","+\t\t\t// Resolve the schema before appending anything, so a skipped table leaves no partial row","+\t\t\tif (tableSchemas is not null) {","+\t\t\t\tSchema tableSchema;","+\t\t\t\ttry {","+\t\t\t\t\ttableSchema = engine.GetTableSchema(table);","+\t\t\t\t} catch (UserIndexNotFoundException) {","+\t\t\t\t\t// the user index was deleted after the table list was taken","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+","+\t\t\t\ttableSchemas.Append(SchemaExtensions.SerializeSchema(tableSchema).AsSpan());","+\t\t\t}","+","+\t\t\tcatalogNames.AppendNull();","+\t\t\tschemaNames.Append(table.Schema);","+\t\t\ttableNames.Append(table.Name);","+\t\t\ttableTypes.Append(TableType);","+\t\t}","+","+\t\tvar schema = FlightSqlServerHelpers.GetTableSchema(command.IncludeSchema);","+\t\tvar length = tableNames.Length;","+\t\treturn tableSchemas is null","+\t\t\t? WriteBatchAsync(writer, schema, length, catalogNames.Build(), schemaNames.Build(), tableNames.Build(), tableTypes.Build())","+\t\t\t: WriteBatchAsync(writer, schema, length,","+\t\t\t\tcatalogNames.Build(), schemaNames.Build(), tableNames.Build(), tableTypes.Build(), tableSchemas.Build());","+\t}","+","+\tprivate static Task WriteTableTypesAsync(FlightServerRecordBatchStreamWriter writer)","+\t\t=> WriteBatchAsync(writer, FlightSqlServerHelpers.TableTypesSchema, 1, new StringArray.Builder().Append(TableType).Build());","+","+\tprivate static async Task WriteBatchAsync(FlightServerRecordBatchStreamWriter writer, Schema schema, int length, params IArrowArray[] columns) {","+\t\tawait writer.SetupStream(schema);","+\t\tusing var batch = new RecordBatch(schema, columns, length);","+\t\tawait writer.WriteAsync(batch);","+\t}","+","+\t// Tables have no catalog: an empty string filters for tables without one, the same as no filter","+\tprivate static bool MatchesCatalog(ReadOnlySpan<char> catalog)","+\t\t=> catalog.IsEmpty;","+","+\t// An empty pattern is the same as no pattern: some clients (e.g. FlightSqlClient.GetTablesAsync) send","+\t// string.Empty instead of leaving the field unset, and no schema or table name is empty anyway","+\tprivate static bool MatchesPattern(ReadOnlySpan<char> pattern, ReadOnlySpan<char> value)","+\t\t=> pattern.IsEmpty || IsLikeMatch(value, pattern);","+","+\t// SQL LIKE semantics used by the Flight SQL filter patterns: '%' matches any substring,","+\t// '_' matches any single character, '\\' escapes the next character (JDBC search string escape)","+\tprivate static bool IsLikeMatch(ReadOnlySpan<char> input, ReadOnlySpan<char> pattern) {","+\t\tint inputIndex = 0, patternIndex = 0;","+","+\t\t// the position right after the last '%' and the i