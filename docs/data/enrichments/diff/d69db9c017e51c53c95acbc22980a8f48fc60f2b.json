{"id":"d69db9c017e51c53c95acbc22980a8f48fc60f2b","axis":"silent","repo":"keystonejs/keystone","sha":"d69db9c017e51c53c95acbc22980a8f48fc60f2b","parsed":{"files":[{"path":".changeset/empty-months-fetch.md","lines":["@@ -0,0 +1,7 @@","+---","+'@keystone-6/core': major","+---","+","+Replaces Node.js HTTP `context.req` and `context.res` on `KeystoneContext` with WHATWG `Headers`, and replaces `context.withRequest(req, res)` with `context.withHeaders(req, res?)`. `context.req` now only carries request headers: the client IP address, method, URL and body of the request are no longer available on the context. If hooks or access control need any of these, add them as request headers in your own middleware in `server.extendExpressApp` before Keystone's GraphQL handler.","+","+Headers set on `context.res` are copied to the response by Keystone's built-in server when the GraphQL response is sent. Custom integrations using `context.withHeaders` must copy the `res` headers to their own response, using `res.getSetCookie()` to preserve separate `Set-Cookie` values."],"additions":7,"deletions":0,"truncated":false},{"path":"docs/content/docs/config/config.md","lines":["@@ -346,8 +346,22 @@ export default config<TypeInfo>({","   server: {","     extendExpressApp: (app, commonContext) => {","       app.get('/api/users', async (req, res) => {","-        const context = await commonContext.withRequest(req, res)","+        const requestHeaders = new Headers()","+        for (const [name, value] of Object.entries(req.headers)) {","+          if (value === undefined) continue","+          for (const entry of Array.isArray(value) ? value : [value]) {","+            requestHeaders.append(name, entry)","+          }","+        }","+        const responseHeaders = new Headers()","+        const context = await commonContext.withHeaders(requestHeaders, responseHeaders)","         const { users } = await context.graphql.run({ query: Users })","+        for (const [name, value] of responseHeaders) {","+          if (name !== 'set-cookie') res.setHeader(name, value)","+        }","+        for (const cookie of responseHeaders.getSetCookie()) {","+          res.appendHeader('set-cookie', cookie)","+        }","         res.json(users)","       })","     },"],"additions":15,"deletions":1,"truncated":false},{"path":"docs/content/docs/config/session.md","lines":["@@ -97,7 +97,7 @@ If you configure your Keystone session with session management then the [`Keysto"," "," - `session`: An object representing the session data. The value will depend on the value passed into `context.sessionStrategy.start()`."," - `sessionStrategy`: an object that, when using `statelessSessions` or `storedSessions` from `@keystone-6/core/session` includes the following functions:","-  - `get({context})`: a function that returns a `session` object based on `context` - this needs to be a `context` with a valid `req` (using `context.withRequest`). This function is called by Keystone to get the value of `context.session`","+  - `get({context})`: a function that returns a `session` object based on `context` - this needs to be a `context` with a valid `req` (using `context.withHeaders`). This function is called by Keystone to get the value of `context.session`","   - `start({context, data})`: a function that, given a valid `context.res` starts a new session containing what is passed into `data`.","   - `end({context})`: a function that, given a valid `context.res` ends a session."," "],"additions":1,"deletions":1,"truncated":false},{"path":"docs/content/docs/context/overview.md","lines":["@@ -20,7 +20,7 @@ const context = {","   // Database API","   db,"," ","-  // HTTP request object","+  // HTTP headers","   req,","   res,"," ","@@ -38,7 +38,7 @@ const context = {","   // New context creators","   sudo,","   internal,","-  withRequest,","+  withHeaders,","   withSession,"," ","   // Transactions","@@ -49,10 +49,11 @@ const context = {"," }"," ```"," ","-### HTTP request object","+### HTTP headers"," ","-`req`: The [IncomingMessage](https://nodejs.org/api/http.html#class-httpincomingmessage) object from the HTTP request.","-`res`: The [ServerResponse](https://nodejs.org/api/http.html#class-httpserverresponse) object for the HTTP request.","+`req`: A WHATWG [`Headers`](https://developer.mozilla.org/en-US/docs/Web/API/Headers) object containing the incoming request headers.","+","+`res`: A WHATWG `Headers` object for outgoing response headers. It can be undefined for read-only contexts."," "," ### Query API"," ","@@ -106,7 +107,7 @@ See the [session API](../config/session#session-context) for more details."," "," `session`: The current session data object."," ","-`sessionStrategy`: an object containing functions(`get`, `start` and `end`) that manipulate a session. See the [session API](../config/session#session-context) for more details.","+`sessionStrategy`: an object containing functions (`get`, `start` and `end`) that manipulate a session. See the [session API](../config/session#session-context) for more details."," "," ### New context creators"," ","@@ -116,7 +117,9 @@ Keystone applies access control using the current context and its session. The f"," "," `internal()`: A function which returns a new `Context` object that bypasses `graphql.omit` on lists and fields, allowing you to query and mutate data that is otherwise omitted from the GraphQL API."," ","-`withRequest(req, res)`: A function which returns a new `Context` object with the `.session` determined by your `sessionStrategy.get` function.","+`withHeaders(req, res?)`: Creates a context from WHATWG `Headers` and loads its session using `sessionStrategy.get`. Request headers are cloned; response headers are shared with the returned context and its derived contexts. Omitting `res` creates a read-only context for response headers, so session cookies cannot be set.","+","+Keystone's built-in server copies outgoing headers to the HTTP response automatically. In custom integrations, supply a mutable `Headers` object as `res` and copy its contents to response headers before sending the response. Preserve separate `Set-Cookie` values with `res.getSetCookie()` rather than combining them into one header."," "," `withSession(newSession)`: A function which returns a new `Context` object with the `.session` object replaced by the `newSession` argument."," "],"additions":10,"deletions":7,"truncated":false},{"path":"examples/actions/schema.ts","lines":["@@ -60,7 +60,7 @@ export const lists = {","     actions: {","       vote: action({","         access: ({ context }) => {","-          const ua = context.req?.headers['user-agent'] ?? ''","+          const ua = context.req?.get('user-agent') ?? ''","           // only allow voting from Chrome browsers","           return ua.includes('Chrome')","         },"],"additions":1,"deletions":1,"truncated":false},{"path":"examples/custom-session-jwt/keystone.ts","lines":["@@ -40,7 +40,7 @@ const jwtSessionStrategy = {","   async get({ context }: { context: Context }): Promise<Session | undefined> {","     if (!context.req) return"," ","-    const { cookie = '' } = context.req.headers","+    const cookie = context.req.get('cookie') ?? ''","     const [cookieName, jwt] = cookie.split('=')","     if (cookieName !== 'user') return"," "],"additions":1,"deletions":1,"truncated":false},{"path":"examples/custom-session-next-auth/package.json","lines":["@@ -13,6 +13,7 @@","     \"@keystone-6/core\": \"workspace:^\",","     \"@prisma/adapter-better-sqlite3\": \"catalog:\",","     \"@prisma/client\": \"catalog:\",","+    \"cookie\": \"^1.0.0\",","     \"next\": \"catalog:\",","     \"next-auth\": \"^4.24.11\",","     \"react\": \"catalog:\","],"additions":1,"deletions":0,"truncated":false},{"path":"examples/custom-session-next-auth/session.ts","lines":["@@ -1,5 +1,5 @@","-import { getServerSession } from 'next-auth/next'","-import type { DefaultJWT } from 'next-auth/jwt'","+import { getToken, type DefaultJWT } from 'next-auth/jwt'","+import 