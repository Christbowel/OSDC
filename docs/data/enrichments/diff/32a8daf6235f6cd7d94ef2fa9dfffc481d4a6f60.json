es vectorize it.","+","+#![crate_type = \"lib\"]","+","+// CHECK-LABEL: @scale_add(","+// O2: fmul <4 x float>","+// O2: fadd <4 x float>","+// O2: store <4 x float>","+// S-NOT: <4 x float>","+// Z-NOT: <4 x float>","+#[no_mangle]","+pub fn scale_add(a: &[f32], b: &[f32], c: &mut [f32]) {","+    for i in 0..64 {","+        c[i] = a[i] * b[i] + 3.0;","+    }","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"tests/codegen-llvm/merge-functions.rs","lines":["@@ -1,5 +1,6 @@","-//@ revisions: O Os","+//@ revisions: O Os Oz"," //@[Os] compile-flags: -Copt-level=s","+//@[Oz] compile-flags: -Copt-level=z"," //@[O] compile-flags: -Copt-level=3"," #![crate_type = \"lib\"]"," "],"additions":2,"deletions":1,"truncated":false},{"path":"tests/codegen-llvm/opt-size-attr-shim.rs","lines":["@@ -0,0 +1,30 @@","+//@ revisions: O2 S Z","+//@[O2] compile-flags: -Copt-level=2","+//@[S] compile-flags: -Copt-level=s","+//@[Z] compile-flags: -Copt-level=z","+//@ ignore-wasi wasi codegens the main symbol differently","+","+// The C entry shim has no item behind it, so it does not go through the per-item attribute path.","+// It still has to carry the size attributes, or `main` is the one definition in a size build that","+// LLVM optimizes for speed.","+","+#![crate_type = \"bin\"]","+","+// CHECK-LABEL: define {{.*}} @main(","+// CHECK-SAME: [[MAIN_ATTRS:#[0-9]+]]","+","+// O2: attributes [[MAIN_ATTRS]] =","+// O2-NOT: optsize","+// O2-NOT: minsize","+","+// S: attributes [[MAIN_ATTRS]] =","+// S-NOT: minsize","+// S-SAME: optsize","+","+// Z: attributes [[MAIN_ATTRS]] =","+// Z-SAME: minsize","+// Z-SAME: optsize","+","+fn main() {","+    std::hint::black_box(0);","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"tests/codegen-llvm/opt-size-attr.rs","lines":["@@ -0,0 +1,29 @@","+//@ revisions: O2 S Z","+//@[O2] compile-flags: -Copt-level=2","+//@[S] compile-flags: -Copt-level=s","+//@[Z] compile-flags: -Copt-level=z","+","+// `s` gives `optsize` while `z` gives both `minsize` and `optsize`. This is the only coverage of","+// the `-Copt-level` path; `optimize-attr-1.rs` reaches these via `#[optimize(size)]`.","+","+#![crate_type = \"lib\"]","+","+// CHECK-LABEL: @f(","+// CHECK-SAME: [[F_ATTRS:#[0-9]+]]","+","+// O2: attributes [[F_ATTRS]] =","+// O2-NOT: optsize","+// O2-NOT: minsize","+","+// S: attributes [[F_ATTRS]] =","+// S-NOT: minsize","+// S-SAME: optsize","+","+// Z: attributes [[F_ATTRS]] =","+// Z-SAME: minsize","+// Z-SAME: optsize","+","+#[no_mangle]","+pub fn f(x: u32) -> u32 {","+    x + 1","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/codegen-llvm/unroll-in-opt-sz.rs","lines":["@@ -0,0 +1,31 @@","+//@ revisions: O2 S Z","+//@[O2] compile-flags: -Copt-level=2","+//@[S] compile-flags: -Copt-level=s","+//@[Z] compile-flags: -Copt-level=z","+","+// `-Copt-level=s`/`z` pass `PTO.LoopUnrolling = false`, so LLVM's unroller runs `OnlyWhenForced`.","+// The O2 side is asserted too, so disabling unrolling everywhere cannot pass. Calls are counted","+// because this knob emits no `llvm.loop.unroll.*` metadata.","+","+#![crate_type = \"lib\"]","+","+unsafe extern \"C\" {","+    fn side_effect(i: u32);","+}","+","+// O2-LABEL: @four_iters(","+// O2-COUNT-4: tail call void @side_effect","+// S-LABEL: @four_iters(","+// S: phi i32","+// S: tail call void @side_effect","+// S-NOT: tail call void @side_effect","+// Z-LABEL: @four_iters(","+// Z: phi i32","+// Z: tail call void @side_effect","+// Z-NOT: tail call void @side_effect","+#[no_mangle]","+pub fn four_iters() {","+    for i in 0..4u32 {","+        unsafe { side_effect(i) }","+    }","+}",""],"additions":31,"deletions":0,"truncated":false}],"additions":193,"deletions":61,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-08T15:21:43.022340+00:00"}