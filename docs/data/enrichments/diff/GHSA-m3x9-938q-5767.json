cted|","+          assert_equal(expected, Loofah::HTML5::Scrub.scrub_css(input))","+        end","+      end","+","+      it \"does not decode escaped comments\" do","+        assert_equal(","+          \"cursor:url\\\\2f\\\\2a\\\\2a\\\\2f\\\\28 http://example.com/x.png\\\\29,auto;\",","+          Loofah::HTML5::Scrub.scrub_css(\"cursor:url\\\\2f\\\\2a\\\\2a\\\\2f\\\\28 http://example.com/x.png\\\\29,auto\"),","+        )","+        assert_equal(","+          \"cursor:var\\\\2f\\\\2a\\\\2a\\\\2f\\\\28 --x\\\\29;\",","+          Loofah::HTML5::Scrub.scrub_css(\"cursor:var\\\\2f\\\\2a\\\\2a\\\\2f\\\\28 --x\\\\29\"),","+        )","+      end","+","+      it \"does not decode escapes into unterminated blocks or strings\" do","+        assert_equal(\"cursor:\\\\28\\\\22;\", Loofah::HTML5::Scrub.scrub_css(\"cursor:\\\\28\\\\22\"))","+        assert_equal(\"cursor:\\\\22;\", Loofah::HTML5::Scrub.scrub_css(\"cursor:\\\\22\"))","+      end","+","+      it \"removes properties whose surviving tokens join into a comment\" do","+        assert_empty(Loofah::HTML5::Scrub.scrub_css(\"cursor:url/(a)*/(http://example.com/x.png),auto\"))","+      end","+    end","+","     describe \"whitespace\" do","       it \"converts all whitespace to a single space except initial and final whitespace\" do","         assert_equal(\"font:12px Arial;\", Loofah::HTML5::Scrub.scrub_css(\"font: \\n\\t 12px \\n\\t Arial \\n\\t ;\"))",""],"additions":53,"deletions":0,"truncated":false}],"additions":81,"deletions":5,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-13T17:02:42.259334+00:00"}