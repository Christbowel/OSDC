{"id":"6c06f2bb50d14a73784cbb96b2980ecea6968159","axis":"silent","repo":"envoyproxy/envoy","sha":"6c06f2bb50d14a73784cbb96b2980ecea6968159","parsed":{"files":[{"path":"changelogs/current/new_features/dynamic_modules__bootstrap_snapshot_endpoints.rst","lines":["@@ -0,0 +1,3 @@","+Added the ``endpoint`` provider for bootstrap configuration snapshots to collect endpoint assignments","+for active clusters. The Rust SDK exposes it as ``ConfigSnapshotProvider::Endpoints``. See","+:ref:`configuration snapshots <config_bootstrap_extensions_dynamic_modules_config_snapshots>`."],"additions":3,"deletions":0,"truncated":false},{"path":"docs/root/configuration/other_features/bootstrap_extensions/dynamic_modules.rst","lines":["@@ -367,8 +367,13 @@ Provider keys include ``bootstrap``, ``clusters``, ``listeners``,"," ``routes``, ``route_scopes``, ``secrets`` and the registered ``ecds_filter_*`` providers. Missing keys"," are omitted, duplicates are collected once, and an empty selection collects nothing. Providers"," appear in key order, as in :ref:`/config_dump <operations_admin_interface_config_dump>`.","-Endpoint dumps are not included. An optional full-match RE2 regular expression filters resource names","-for providers that support it. A missing or empty expression disables filtering.","+Selecting ``endpoint`` includes endpoint assignments for active clusters, as with","+``/config_dump?include_eds``. An optional full-match RE2 regular expression filters resource names","+for providers that support it. A missing or empty expression disables filtering. For endpoints,","+the filter matches the EDS service name, or the cluster name if no service name is set.","+","+Cluster lifecycle hooks do not fire when only a cluster's hosts or their health change, so a","+snapshot shows endpoint changes only when the module collects again."," "," Collection and sensitive-field redaction run synchronously on the main thread after server"," initialization and before shutdown begins. Their cost grows with the selected resources. Combine"],"additions":7,"deletions":2,"truncated":false},{"path":"source/common/upstream/BUILD","lines":["@@ -9,6 +9,21 @@ licenses([\"notice\"])  # Apache 2"," "," envoy_package()"," ","+envoy_cc_library(","+    name = \"endpoint_config_dump_lib\",","+    srcs = [\"endpoint_config_dump.cc\"],","+    hdrs = [\"endpoint_config_dump.h\"],","+    deps = [","+        \"//envoy/common:matchers_interface\",","+        \"//envoy/upstream:cluster_manager_interface\",","+        \"//source/common/network:utility_lib\",","+        \"//source/common/protobuf\",","+        \"@envoy_api//envoy/admin/v3:pkg_cc_proto\",","+        \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","+        \"@envoy_api//envoy/config/endpoint/v3:pkg_cc_proto\",","+    ],","+)","+"," envoy_cc_library(","     name = \"cds_api_helper_lib\",","     srcs = [\"cds_api_helper.cc\"],"],"additions":15,"deletions":0,"truncated":false},{"path":"source/common/upstream/endpoint_config_dump.cc","lines":["@@ -0,0 +1,123 @@","+#include \"source/common/upstream/endpoint_config_dump.h\"","+","+#include \"envoy/admin/v3/config_dump.pb.h\"","+#include \"envoy/config/core/v3/health_check.pb.h\"","+#include \"envoy/config/endpoint/v3/endpoint.pb.h\"","+","+#include \"source/common/network/utility.h\"","+","+namespace Envoy {","+namespace Upstream {","+namespace {","+","+void addLbEndpoint(const Upstream::HostSharedPtr& host,","+                   envoy::config::endpoint::v3::LocalityLbEndpoints& locality_lb_endpoint) {","+  auto& lb_endpoint = *locality_lb_endpoint.mutable_lb_endpoints()->Add();","+  if (host->metadata() != nullptr) {","+    lb_endpoint.mutable_metadata()->MergeFrom(*host->metadata());","+  }","+  lb_endpoint.mutable_load_balancing_weight()->set_value(host->weight());","+","+  switch (host->coarseHealth()) {","+  case Upstream::Host::Health::Healthy:","+    lb_endpoint.set_health_status(envoy::config::core::v3::HealthStatus::HEALTHY);","+    break;","+  case Upstream::Host::Health::Unhealthy:","+    lb_endpoint.set_health_status(envoy::config::core::v3::HealthStatus::UNHEALTHY);","+    break;","+  case Upstream::Host::Health::Degraded:","+    lb_endpoint.set_health_status(envoy::config::core::v3::HealthStatus::DEGRADED);","+    break;","+  default:","+    lb_endpoint.set_health_status(envoy::config::core::v3::HealthStatus::UNKNOWN);","+  }","+","+  auto& endpoint = *lb_endpoint.mutable_endpoint();","+  endpoint.set_hostname(host->hostname());","+  Network::Utility::addressToProtobufAddress(*host->address(), *endpoint.mutable_address());","+  if (const auto address_list = host->addressListOrNull();","+      address_list != nullptr && address_list->size() > 1) {","+    // the first address is already encoded in endpoint.address","+    for (auto it = std::next(address_list->begin()); it != address_list->end(); ++it) {","+      auto& new_address = *endpoint.mutable_additional_addresses()->Add();","+      Network::Utility::addressToProtobufAddress(**it, *new_address.mutable_address());","+    }","+  }","+  auto& health_check_config = *endpoint.mutable_health_check_config();","+  health_check_config.set_hostname(host->hostnameForHealthChecks());","+  if (host->healthCheckAddress()->asString() != host->address()->asString()) {","+    health_check_config.set_port_value(host->healthCheckAddress()->ip()->port());","+  }","+}","+","+} // namespace","+","+ProtobufTypes::MessagePtr dumpEndpointConfigs(const Upstream::ClusterManager& cluster_manager,","+                                              const Matchers::StringMatcher& name_matcher) {","+  auto endpoint_config_dump = std::make_unique<envoy::admin::v3::EndpointsConfigDump>();","+  // TODO(mattklein123): Add ability to see warming clusters in admin output.","+  cluster_manager.forEachActiveCluster([&](const Upstream::Cluster& cluster) {","+    Upstream::ClusterInfoConstSharedPtr cluster_info = cluster.info();","+    const auto& cluster_name = cluster_info->edsServiceName().empty()","+                                   ? cluster_info->name()","+                                   : cluster_info->edsServiceName();","+    if (!name_matcher.match(cluster_name)) {","+      return;","+    }","+    envoy::config::endpoint::v3::ClusterLoadAssignment cluster_load_assignment;","+    cluster_load_assignment.set_cluster_name(cluster_name);","+    auto& policy = *cluster_load_assignment.mutable_policy();","+","+    float value = cluster.dropOverload().value() * 1000000;","+    if (value > 0) {","+      auto* drop_overload = policy.add_drop_overloads();","+      drop_overload->set_category(cluster.dropCategory());","+      auto* percent = drop_overload->mutable_drop_percentage();","+      percent->set_denominator(envoy::type::v3::FractionalPercent::MILLION);","+      percent->set_numerator(uint32_t(value));","+    }","+","+    for (auto& host_set : cluster.prioritySet().hostSetsPerPriority()) {","+      policy.mutable_overprovisioning_factor()->set_value(host_set->overprovisioningFactor());","+","+      if (!host_set->hostsPerLocality().get().empty()) {","+        for (int index = 0; index < static_cast<int>(host_set->hostsPerLocality().get().size());","+             index++) {","+          const auto& locality_host_set = host_set->hostsPerLocality().get()[index];","+","+          if (!locality_host_set.empty()) {","+            auto& locality_lb_endpoint = *cluster_load_assignment.mutable_endpoints()->Add();","+            locality_lb_endpoint.mutable_locality()->MergeFrom(locality_host_set[0]->locality());","+            locality_lb_endpoint.set_priority(locality_host_set[0]->priority());","+            if (host_set->localityWeights() != nullptr && !host_set->localityWeights()->empty()) {","+              locality_lb_endpoint.mutable_load_balancing_weight()->set_value(","+                  (*host_set->localityWeights())[index]);","+            }","+","+            for (auto& host : locality_host_set) {","+              addLbEndpoint(host, locality_lb_endpoint);","+            }","+          }","+        }","+      } else {","+        for (auto& host : host_set->hosts()) {","+          auto& locality_lb_endpoint = *cluster_load_assignment.mutable_endpoints()->Add();","+          locality_lb_endpoint.mutable_locality()->MergeFrom(host->locality());","+          locality_lb_endpoint.set_priority(host->priority());","+          addLbEndpoint(host, locality_lb_endpoint);","+        }","+      }","+    }","+    if (cluster_info->addedViaApi()) {","+      auto& dynamic_endpoint = *endpoint_config_dump->mutable_dynamic_endpoint_configs()->Add();","+      std::ignore = dynamic_endpoint.mutable_endpoint_config()->PackFrom(cluster_load_assignment);","+    } else {","+      auto& static_endpoint = *endpoint_config_dump->mutable_static_endpoint_configs()->Add();","+      std::ignore = static_endpoint.mutable_endpoint_config()->PackFrom(cluster_load_assignment);","+    }","+  });","+  return endpoint_config_dump;","+}","+","+} // namespace Upstream","+} // namespace Envoy"],"additions":123,"deletions":0,"truncated":false},{"path":"source/common/upstream/endpoint_config_dump.h","lines":["@@ -0,0 +1,18 @@","+#pragma once","+","+#include \"envoy/common/matchers.h\"","+#include \"envoy/upstream/cluster_manager.h\"","+","+#include \"source/common/protobuf/protobuf.h\"","+","+namespace Envoy {","+namespace Upstream {","+","+/**","+ * Collects endpoint assignments for active clusters. Must run on the main thread.","+ */","+ProtobufTypes::MessagePtr dumpEndpointConfigs(const ClusterManager& cluster_manager,","+                                              const Matchers::StringMatcher& name_matcher);","+","+} // namespace Upstream","+} // namespace Envoy"],"additions":18,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/BUILD","lines":["@@ -16,7 +16,9 @@ envoy_cc_library(","     deps = [","         \"//envoy/common:exception_lib\",","         \"//envoy/server:config_tracker_interface\",","+        \"//envoy/upstream:cluster_manager_interface\",","         \"//source/common/protobuf:utility_lib\",","+        \"//source/common/upstream:endpoint_config_dump_lib\",","         \"@abseil-cpp//absl/algorithm:container\",","         \"@abseil-cpp//absl/status:statusor\",","         \"@abseil-cpp//absl/strings\","],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/config_snapshot.cc","lines":["@@ -3,6 +3,7 @@"," #include \"envoy/admin/v3/config_dump.pb.h\""," "," #include \"source/common/protobuf/utility.h\"","+#include \"source/common/upstream/endpoint_config_dump.h\""," "," #include \"absl/algorithm/container.h\""," #include \"absl/strings/str_cat.h\"","@@ -12,10 +13,9 @@ namespace Extensions {"," namespace Bootstrap {"," namespace DynamicModules {"," ","-absl::StatusOr<std::unique_ptr<ConfigSnapshot>>","-ConfigSnapshot::collect(const Server::ConfigTracker& tracker,","-                        absl::Span<const absl::string_view> providers,","-                        const Matchers::StringMatcher& name_matcher) {","+absl::StatusOr<std::unique_ptr<ConfigSnapshot>> ConfigSnapshot::collect(","+    const Server::ConfigTracker& tracker, const Upstream::ClusterManager& cluster_manager,","+    absl::Span<const absl::string_view> providers, const Matchers::StringMatcher& name_matcher) {","   auto snapshot = std::make_unique<ConfigSnapshot>();","   TRY_ASSERT_MAIN_THREAD {","     std::vector<std::string> selected;","@@ -25,15 +25,27 @@ ConfigSnapshot::collect(const Server::ConfigTracker& tracker,","         selected.push_back(name);","       }","     }","+    const bool include_endpoints = absl::c_linear_search(providers, \"endpoint\") &&","+                                   !callbacks.contains(\"endpoint\") &&","+                                   cluster_manager.hasActiveClusters();","+    if (include_endpoints) {","+      selected.emplace_back(\"endpoint\");","+      absl::c_sort(selected);","+    }","     for (const auto& name : selected) {","-      // an earlier provider may have unregistered or replaced this callback","-      const auto it = callbacks.find(name);","-      if (it == callbacks.end()) {","-        continue;","+      ProtobufTypes::MessagePtr message;","+      if (include_endpoints && name == \"endpoint\") {","+        message = Upstream::dumpEndpointConfigs(cluster_manager, name_matcher);","+      } else {","+        // an earlier provider may have unregistered or replaced this callback","+        const auto it = callbacks.find(name);","+        if (it == callbacks.end()) {","+          continue;","+        }","+        // keep the current callback alive if it unregisters itself","+        const auto callback = it->second;","+        message = callback(name_matcher);","       }","-      // keep the current callback alive if it unregisters itself","-      const auto callback = it->second;","-      auto message = callback(name_matcher);","       if (message == nullptr) {","         return absl::InternalError(absl::StrCat(\"config provider returned no message: \", name));","       }"],"additions":23,"deletions":11,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/config_snapshot.h","lines":["@@ -5,6 +5,7 @@"," #include <vector>"," "," #include \"envoy/server/config_tracker.h\"","+#include \"envoy/upstream/cluster_manager.h\""," "," #include \"absl/status/statusor.h\""," #include \"absl/strings/string_view.h\"","@@ -24,7 +25,8 @@ class ConfigSnapshot {","    * Collects and redacts the selected providers. Must run on the server's main thread.","    */","   static absl::StatusOr<std::unique_ptr<ConfigSnapshot>>","-  collect(const Server::ConfigTracker& tracker, absl::Span<const absl::string_view> providers,","+  collect(const Server::ConfigTracker& tracker, const Upstream::ClusterManager& cluster_manager,","+          absl::Span<const absl::string_view> providers,","           const Matchers::StringMatcher& name_matcher);"," ","   /**"],"additions":3,"deletio