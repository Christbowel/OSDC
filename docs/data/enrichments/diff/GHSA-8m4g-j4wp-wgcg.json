{"id":"GHSA-8m4g-j4wp-wgcg","axis":"advisories","repo":"authlib/authlib","sha":"4ff30db442c70e29486e1982cb0ad37c037f5f4b","parsed":{"files":[{"path":"authlib/jose/rfc7518/oct_key.py","lines":["@@ -65,6 +65,10 @@ def validate_raw_key(cls, key):"," ","     @staticmethod","     def _check_key(raw_key):","+        # Per RFC 7518 §3.2, an HMAC key must be at least as long as the hash output.","+        if not raw_key:","+            raise ValueError(\"oct key material must not be empty\")","+","         # PEM parsers accept leading text, including comments and whitespace.","         if any(marker in raw_key for marker in POSSIBLE_UNSAFE_KEYS):","             raise ValueError(\"This key may not be safe to import\")"],"additions":4,"deletions":0,"truncated":false},{"path":"changelog.d/20261014_112511_eloi_advisory_fix_1.rst","lines":["@@ -0,0 +1,7 @@","+Security","+~~~~~~~~","+","+- ``authlib.jose`` rejects empty HMAC keys with a ``ValueError``. An empty key","+  used to let anyone forge HS256, HS384 and HS512 signatures. The minimum","+  ``joserfc`` version is now 1.6.8, which has the same check.","+  `GHSA-8m4g-j4wp-wgcg <https://github.com/authlib/authlib/security/advisories/GHSA-8m4g-j4wp-wgcg>`_"],"additions":7,"deletions":0,"truncated":false},{"path":"pyproject.toml","lines":["@@ -8,7 +8,7 @@ description = \"The ultimate Python library in building OAuth and OpenID Connect"," authors = [{name = \"Hsiaoming Yang\", email=\"me@lepture.com\"}]"," dependencies = [","     \"cryptography>=45.0.1\",","-    \"joserfc>=1.6.1\",","+    \"joserfc>=1.6.8\","," ]"," license = {text = \"BSD-3-Clause\"}"," requires-python = \">=3.10\""],"additions":1,"deletions":1,"truncated":false},{"path":"tests/jose/test_jwt.py","lines":["@@ -51,6 +51,33 @@ def test_reject_pem_key_as_hmac_secret(prefix, key_format):","         jwt.decode(forged, key)"," "," ","+@pytest.mark.parametrize(\"alg\", [\"HS256\", \"HS384\", \"HS512\"])","+@pytest.mark.parametrize(","+    \"key\",","+    [","+        b\"\",","+        \"\",","+        {\"kty\": \"oct\", \"k\": \"\"},","+        OctKey.import_key({\"kty\": \"oct\", \"k\": \"\"}),","+        lambda header, payload: \"\",","+    ],","+    ids=[\"bytes\", \"str\", \"jwk\", \"key\", \"callable\"],","+)","+def test_reject_empty_hmac_key(alg, key):","+    hash_alg = getattr(hashlib, f\"sha{alg[2:]}\")","+    signing_input = (","+        json_b64encode({\"alg\": alg}) + b\".\" + json_b64encode({\"sub\": \"attacker\"})","+    )","+    signature = hmac.new(b\"\", signing_input, hash_alg).digest()","+    forged = signing_input + b\".\" + urlsafe_b64encode(signature)","+","+    with pytest.raises(ValueError, match=\"must not be empty\"):","+        jwt.decode(forged, key)","+","+    with pytest.raises(ValueError, match=\"must not be empty\"):","+        jwt.encode({\"alg\": alg}, {\"sub\": \"alice\"}, key)","+","+"," def test_encode_sensitive_data():","     # check=False won't raise error","     jwt.encode({\"alg\": \"HS256\"}, {\"password\": \"\"}, \"k\", check=False)",""],"additions":27,"deletions":0,"truncated":false}],"additions":39,"deletions":1,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-28T14:41:51.885488+00:00"}