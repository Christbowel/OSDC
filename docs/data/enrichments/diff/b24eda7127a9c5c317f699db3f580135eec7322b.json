,"+    ]","+","+"," def test_preemptions_and_corrupted_render(manager, caplog_vllm, monkeypatch):","     caplog_vllm.set_level(logging.DEBUG, logger=LOGGER_NAME)","     monkeypatch.setattr("],"additions":26,"deletions":1,"truncated":false},{"path":"tests/v1/metrics/test_stats.py","lines":["@@ -103,7 +103,7 @@ def test_scheduler_iteration_details_serialization():","     outputs = EngineCoreOutputs(","         scheduler_stats=SchedulerStats(","             kv_cache_usage=0.5,","-            iteration_details=iteration_details,","+            iteration_records=[iteration_details],","         )","     )"," ","@@ -112,7 +112,7 @@ def test_scheduler_iteration_details_serialization():"," ","     assert decoded.scheduler_stats is not None","     assert decoded.scheduler_stats.kv_cache_usage == 0.5","-    assert decoded.scheduler_stats.iteration_details == iteration_details","+    assert decoded.scheduler_stats.iteration_records == [iteration_details]"," "," "," def test_prefix_cache_stats_hits_by_source_accumulate():"],"additions":2,"deletions":2,"truncated":false},{"path":"tests/v1/worker/test_gpu_worker.py","lines":["@@ -610,6 +610,7 @@ def run_model(scheduler_output, intermediate_tensors):","         ),","         model_runner=SimpleNamespace(execute_model=run_model, is_pooling_model=False),","         annotate_profile=lambda scheduler_output: nullcontext(),","+        iteration_timer=None,","         _pp_send_work=[previous_tensor_send],","         _pp_transport=None,","     )"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_iteration_timing.py","lines":["@@ -0,0 +1,293 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+from types import SimpleNamespace","+from unittest.mock import Mock","+","+import pytest","+","+import vllm.config.vllm as vllm_config_module","+import vllm.v1.worker.iteration_timing as iteration_timing","+from vllm.config import VllmConfig","+from vllm.v1.core.sched.output import IterationDetails","+from vllm.v1.executor.multiproc_executor import MultiprocExecutor","+from vllm.v1.metrics import loggers","+from vllm.v1.metrics.stats import SchedulerStats","+from vllm.v1.outputs import AsyncModelRunnerOutput, ModelRunnerOutput","+from vllm.v1.worker.iteration_timing import (","+    IterationTimer,","+    finish_iteration_timing,","+    make_iteration_timer,","+    start_iteration_timing,","+    time_dummy_batch,","+)","+","+pytestmark = pytest.mark.cpu_test","+","+","+class FakeGpu:","+    \"\"\"A CUDA stream whose progress the test controls.\"\"\"","+","+    def __init__(self):","+        self.now_ms = 0.0","+        self.events: list[FakeEvent] = []","+","+    def run(self, ms: float = 1.0):","+        \"\"\"Complete everything recorded so far, one event every `ms`.\"\"\"","+        for event in self.events:","+            self.now_ms += ms","+            event.completed_ms = self.now_ms","+        self.events.clear()","+","+","+class FakeEvent:","+    gpu: FakeGpu","+","+    def __init__(self, enable_timing=False):","+        self.completed_ms = None","+","+    def record(self):","+        self.gpu.events.append(self)","+","+    def query(self):","+        return self.completed_ms is not None","+","+    def elapsed_time(self, end):","+        if self.completed_ms is None or end.completed_ms is None:","+            raise RuntimeError(\"Both events must be completed\")","+        return end.completed_ms - self.completed_ms","+","+","+class FakeAsyncOutput(AsyncModelRunnerOutput):","+    def get_output(self):","+        return ModelRunnerOutput(req_ids=[])","+","+    def get_kv_connector_output(self):","+        return \"kv output\"","+","+","+class FakeWorker:","+    def __init__(self):","+        self.iteration_timer = IterationTimer()","+        self.fail_next_step = False","+","+    @start_iteration_timing","+    def execute_model(self, scheduler_output):","+        return None","+","+    @finish_iteration_timing","+    def sample_tokens(self):","+        if self.fail_next_step:","+            self.fail_next_step = False","+            return None  # as when execute_model failed","+        return FakeAsyncOutput()","+","+    @time_dummy_batch","+    def execute_dummy_batch(self):","+        pass","+","+    def step(self, num_tokens=1, timed=True):","+        \"\"\"Run one iteration and return the records its output carries.\"\"\"","+        details = IterationDetails(num_decode_tokens=num_tokens) if timed else None","+        self.execute_model(SimpleNamespace(iteration_details=details))","+        output = self.sample_tokens()","+        return output and output.get_output().iteration_records","+","+    def completed(self):","+        \"\"\"Let the GPU catch up and return the records the next reply carries.\"\"\"","+        FakeEvent.gpu.run()","+        return self.iteration_timer.take_ready()","+","+","+@pytest.fixture","+def gpu(monkeypatch):","+    gpu = FakeEvent.gpu = FakeGpu()","+    monkeypatch.setattr(iteration_timing, \"torch\", SimpleNamespace(Event=FakeEvent))","+    return gpu","+","+","+def test_record_rides_a_later_output_once_its_gpu_work_completes(gpu):","+    worker = FakeWorker()","+","+    # The step's own end event follows its output, so it is still pending.","+    assert worker.step(num_tokens=3) == []","+    assert worker.step(num_tokens=5) == []","+    gpu.run(ms=4.0)","+","+    first, second = worker.step()","+    assert (first.iteration_index, first.num_generation_tokens) == (0, 3)","+    assert (second.iteration_index, second.num_generation_tokens) == (1, 5)","+    assert first.elapsed_ms == 4.0 and not first.is_dummy","+","+","+def test_dummy_batches_are_timed_and_return_earlier_records(gpu):","+    worker = FakeWorker()","+","+    assert worker.step(num_tokens=3) == []","+    assert worker.execute_dummy_batch() == []","+    gpu.run()","+    step, dummy = worker.execute_dummy_batch()","+    assert (step.iteration_index, step.num_generation_tokens) == (0, 3)","+    assert (dummy.iteration_index, dummy.is_dummy) == (1, True)","+    assert worker.execute_dummy_batch() == []  # the previous one is still pending","+","+","+def test_only_iterations_that_finish_with_a_snapshot_are_timed(gpu):","+    worker = FakeWorker()","+","+    worker.fail_next_step = True","+    assert worker.step() is None  # execute_model failed","+    assert worker.step(timed=False) == []  # no scheduling snapshot","+    # A step that schedules no tokens has no sample_tokens call.","+    worker.execute_model(SimpleNamespace(iteration_details=IterationDetails()))","+    assert worker.completed() == []","+","+    # None of these stops later iterations from being timed.","+    worker.step(num_tokens=2)","+    assert [record.num_generation_tokens for record in worker.completed()] == [2]","+","+","+def test_failed_timing_read_drops_the_record_not_the_step(gpu, monkeypatch):","+    worker = FakeWorker()","+    worker.step()","+    gpu.run()","+","+    def broken_read(self, end):","+        raise RuntimeError(\"CUDA error\")","+","+    with monkeypatch.context() as patch:","+        patch.setattr(FakeEvent, \"elapsed_time\", broken_read)","+        assert worker.step() == []","+","+    # Later records are unaffected.","+    assert [record.iteration_index for record in worker.completed()] == [1]","+","+","+def test_failed_event_recording_drops_the_record_not_the_step(gpu, monkeypatch):","+    def broken_event_call(self):","+        raise RuntimeError(\"CUDA error\")","+","+    worker = FakeWorker()","+    warning = Mock()","+    monkeypatch.setattr(iteration_timing.logger, \"warning_once\", warning)","+    scheduler_output = SimpleNamespace(iteration_details=IterationDetails())","+","+    with monkeypatch.context() as patch:","+        patch.setattr(FakeEvent, \"record\", broken_event_call)","+        worker.execute_model(scheduler_output)  # no start event","+    assert isinstance(worker.sample_tokens(), FakeAsyncOutput)","+","+    worker.execute_model(scheduler_output)","+    with monkeypatch.context() as patch:","+        patch.setattr(FakeEvent, \"record\", broken_event_call)","+        assert isinstance(worker.sample_tokens(), FakeAsyncOutput)  # no end event","+        assert worker.execute_dummy_batch() == []  # neither event","+    assert worker.completed() == []","+","+    # Later iterations are timed again; the three dropped ones keep their index.","+    assert warning.called","+    worker.step(num_tokens=2)","+    (record,) = worker.completed()","+    assert (record.iteration_index, record.num_generation_tokens) == (3, 2)","+","+","+def test_untimed_worker_is_untouched():","+    worker = FakeWorker()","+    worker.iteration_timer = None","+","+    assert isinstance(worker.sample_tokens(), FakeAsyncOutput)","+    assert worker.execute_dummy_batch() is None","+","+","+def test_output_carrying_records_keeps_its_kv_connector_output(gpu):","+    worker = FakeWorker()","+    worker.step()","+    gpu.run()","+    worker.execute_model(SimpleNamespace(iteration_details=IterationDetails()))","+","+    assert worker.sample_tokens().get_kv_connector_output() == \"kv output\"","+","+","+def test_only_the_output_rank_times_iterations():","+    parallel_config = SimpleNamespace(","+        world_size=8, tensor_parallel_size=2, prefill_context_parallel_size=1","+    )","+    config = SimpleNamespace(gpu_iteration_timing=True, parallel_config=parallel_config)","+    executor = SimpleNamespace(world_size=8, parallel_config=parallel_config)","+    output_rank = MultiprocExecutor._get_output_rank(executor)","+","+    timed = [rank for rank in range(8) if make_iteration_timer(config, rank)]","+    assert timed == [output_rank]","+","+    config.gpu_iteration_timing = False","+    assert make_iteration_timer(config, output_rank) is None","+","+","+@pytest.mark.parametrize(","+    (\"change\", \"expected\"),","+    [","+        ({}, True),","+        ({\"flag\": False}, False),","+        ({\"device_type\": \"cpu\"}, False),","+        ({\"runner_type\": \"pooling\"}, False),","+        ({\"is_mm_encoder_only\": True}, False),","+        ({\"backend\": \"uni\"}, True),","+        ({\"backend\": \"ray\"}, False),","+        ({\"api_servers\": 2}, False),  # the frontend then logs no iteration details","+        # The in-process engine does not publish the records of dummy batches.","+        ({\"multiprocessing\": False}, False),","+    ],","+)","+def test_gpu_iteration_timing_conditions(change, expected, monkeypatch):","+    case = {","+        \"flag\": True,","+        \"device_type\": \"cuda\",","+        \"runner_type\": \"generate\",","+        \"is_mm_encoder_only\": False,","+        \"backend\": \"mp\",","+        \"api_servers\": 1,","+        \"multiprocessing\": True,","+    } | change","+    # Not through the environment: an engine created earlier in this process","+    # may have cached it.","+    monkeypatch.setattr(","+        vllm_config_module,","+        \"envs\",","+        SimpleNamespace(VLLM_ENABLE_V1_MULTIPROCESSING=case[\"multiprocessing\"]),","+    )","+    config = SimpleNamespace(","+        observability_config=SimpleNamespace(","+            enable_logging_iteration_details=case[\"flag\"]","+        ),","+        device_config=SimpleNamespace(device_type=case[\"device_type\"]),","+        model_config=SimpleNamespace(runner_type=case[\"runner_type\"]),","+        is_mm_encoder_only=case[\"is_mm_encoder_only\"],","+        parallel_config=SimpleNamespace(","+            distributed_executor_backend=case[\"backend\"],","+            _api_process_count=case[\"api_servers\"],","+        ),","+    )","+","+    assert VllmConfig.gpu_iteration_timing.fget(config) is expected  # type: ignore[attr-defined]  # property","+","+","+def test_logger_logs_every_iteration_record(gpu, monkeypatch):","+    worker = FakeWorker()","+    worker.step(num_tokens=3)","+    worker.step(num_tokens=5)","+    stats = SchedulerStats(iteration_records=worker.completed())","+    info = Mock()","+    monkeypatch.setattr(loggers.logger, \"info\", info)","+    stat_logger = SimpleNamespace(","+        kv_cache_device=\"GPU\", _log_prefix_for_engine=lambda engine_idx: \"\"","+    )","+    stat_logger._log_iteration = lambda *args: loggers.LoggingStatLogger._log_iteration(","+        stat_logger, *args","+    )","+","+    loggers.LoggingStatLogger._log_iteration_details(stat_logger, stats, 0)","+","+    assert [call.args[2:7] for call in info.call_args_list] == [","+        (0, 0, 0, 0, 3),","+        (1, 0, 0, 0, 5),","+    ]"],"additions":293,"deletions":0,"truncated":false},{"path":"vllm/config/observability.py","lines":["@@ -102,7 +102,8 @@ def show_hidden_metrics(self) -> bool:","     \"\"\"Enable detailed logging of iteration details.","     If set, vllm EngineCore will log iteration details","     This includes number of context/generation requests and tokens","-    and the elapsed cpu time for the iteration.\"\"\"","+    and, where the output worker measures it with CUDA events, the","+    elapsed GPU time for the iteration.\"\"\""," ","     jit_monitor_mode: Literal[\"warn\", \"error\"] = \"warn\"","     \"\"\"How to handle post-warmup JIT compilation events.\"\"\""],"additions":2,"deletions":1,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -611,6 +611,30 @@ def is_mm_encoder_only(self) -> bool:","         )","         return bool(mm_config and mm_config.mm_encoder_only)"," ","+    @property","+    def gpu_iteration_timing(self) -> bool:","+        \"\"\"Whether the output worker times logged iterations with CUDA events.","+        Otherwise they are logged without an elapsed time.\"\"\"","+        # TODO: Drop this gate. Untimed iterations could be handled without the","+        # config knowing which frontend, executor and engine process are in use.","+        parallel_config = self.parallel_config","+        # With more API servers the frontend does not log iteration details.","+        frontend_logs = (","+           