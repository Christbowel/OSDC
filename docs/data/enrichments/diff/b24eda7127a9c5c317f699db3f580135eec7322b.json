@ def test_attach_iteration_details_falls_back_to_client_zero_without_outputs():"," ","     assert set(outputs) == {0}","     assert outputs[0].scheduler_stats is not None","-    assert outputs[0].scheduler_stats.iteration_details == iteration_details","+    assert outputs[0].scheduler_stats.iteration_records == [iteration_details]","+","+","+def test_untimed_iteration_details_defer_to_gpu_timing():","+    engine = make_fake_engine(gpu_iteration_timing=True)","+","+    assert EngineCore._untimed_iteration_details(engine, None) is None","+","+","+def test_dummy_batch_publishes_the_gpu_timings_it_returns():","+    record = make_iteration_details()","+    engine = SimpleNamespace(","+        model_executor=SimpleNamespace(execute_dummy_batch=lambda: [record]),","+        scheduler=SimpleNamespace(make_stats=SchedulerStats),","+        output_queue=queue.Queue(),","+    )","+","+    EngineCoreProc.execute_dummy_batch(engine)","+","+    client_index, outputs = engine.output_queue.get_nowait()","+    assert client_index == 0","+    assert outputs.scheduler_stats.iteration_records == [record]","+","+","+@pytest.mark.parametrize(","+    (\"records\", \"stats\"),","+    [","+        ([], SchedulerStats()),  # nothing has completed","+        (None, SchedulerStats()),  # the worker does not time iterations","+        ([make_iteration_details()], None),  # stats are disabled","+    ],","+)","+def test_dummy_batch_publishes_nothing_without_gpu_timings_or_stats(records, stats):","+    engine = SimpleNamespace(","+        model_executor=SimpleNamespace(execute_dummy_batch=lambda: records),","+        scheduler=SimpleNamespace(make_stats=lambda: stats),","+        output_queue=queue.Queue(),","+    )","+","+    EngineCoreProc.execute_dummy_batch(engine)","+","+    assert engine.output_queue.empty()"],"additions":82,"deletions":23,"truncated":false},{"path":"tests/v1/executor/test_multiproc_executor.py","lines":["@@ -73,7 +73,7 @@ def fail():","     \"method,result\",","     [","  