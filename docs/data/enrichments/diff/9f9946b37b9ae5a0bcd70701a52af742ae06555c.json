nfig = instance.getConfig().findMapConfig(mapName);","+        if (config.getMapStoreConfig().isEnabled() || config.getDataPersistenceConfig().isEnabled()) {","+            return false;","+        }","+        return config.getTotalBackupCount() == 0 || !hasOtherDataMembers(instance);","+    }","+","+    /**","+     * Whether the entries of a replicated map are kept only in the memory of this JVM: a replicated map has a copy on","+     * every data member, so only a member alone in its cluster loses them. A client or a lite member keeps none.","+     */","+    public static boolean isReplicatedInMemory(HazelcastInstance instance) {","+        return isDataMember(instance) && !hasOtherDataMembers(instance);","+    }","+","+    private static boolean isDataMember(HazelcastInstance instance) {","+        // the local endpoint of a client is not a member","+        return instance != null && instance.getLifecycleService().isRunning()","+                && instance.getLocalEndpoint() instanceof Member member && !member.isLiteMember();","+    }","+","+    private static boolean hasOtherDataMembers(HazelcastInstance instance) {","+        for (Member member : instance.getCluster().getMembers()) {","+            if (!member.localMember() && !member.isLiteMember()) {","+                return true;","+            }","+        }","+        return false;","+    }"," }"],"additions":42,"deletions":0,"truncated":false},{"path":"components/camel-hazelcast/src/main/java/org/apache/camel/processor/aggregate/hazelcast/HazelcastAggregationRepository.java","lines":["@@ -32,7 +32,9 @@"," import org.apache.camel.Exchange;"," import org.apache.camel.RuntimeCamelException;"," import org.apache.camel.component.hazelcast.HazelcastSerializationFilterHelper;","+import org.apache.camel.component.hazelcast.HazelcastUtil;"," import org.apache.camel.spi.Configurer;","+import org.apache.camel.spi.InMemoryStrategy;"," import org.apache.camel.spi.Metadata;"," import org.apache.camel.spi.OptimisticL