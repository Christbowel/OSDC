alse","+","+jobs:","+  release:","+    name: Release","+    runs-on: ubuntu-latest","+    if: github.repository == 'actix/actix-web'","+    permissions:","+      contents: write","+      id-token: write","+","+    steps:","+      - name: Checkout","+        uses: actions/checkout@v7.0.1","+        with:","+          fetch-depth: 0","+          persist-credentials: false","+","+      - name: Install Rust","+        uses: actions-rust-lang/setup-rust-toolchain@v2.0.1","+","+      - name: release-plz","+        uses: release-plz/action@v0.5.140","+        id: release-plz","+        with:","+          command: release","+        env:","+          GITHUB_TOKEN: ${{ github.token }}","+","+      - name: Install Nix","+        if: steps.release-plz.outputs.releases_created == 'true'","+        uses: nixbuild/nix-quick-install-action@v35","+","+      - name: Enter Nix devshell","+        if: steps.release-plz.outputs.releases_created == 'true'","+        uses: nicknovitski/nix-develop@v1.2.1","+        with:","+          arguments: .#ci-release","+","+      - name: Update release notes","+        if: steps.release-plz.outputs.releases_created == 'true'","+        env:","+          GH_TOKEN: ${{ github.token }}","+          RELEASE_PLZ_RELEASES_JSON: ${{ steps.release-plz.outputs.releases }}","+        run: |","+          # The shared release tool reads CHANGELOG.md.","+          for changelog in */CHANGES.md; do","+            ln -s CHANGES.md \"${changelog%CHANGES.md}CHANGELOG.md\"","+          done","+","+          x52-update-release-notes --then-undraft"],"additions":61,"deletions":0,"truncated":false},{"path":".release-plz.toml","lines":["@@ -0,0 +1,8 @@","+[workspace]","+changelog_update = false","+dependencies_update = false","+publish_all_features = true","+release_always = true","+git_release_draft = true","+git_release_name = \"{{ package }}: v{{ version }}\"","+git_tag_name = \"{{ package }}-v{{ version }}\""],"additions":8,"deletions":0,"truncated":false},{"path":"actix-http/CHANGES.md","lines":["@@ -2,6 +2,8 @@"," "," ## Unreleased"," ","+- Apply the request head timeout to pipelined HTTP/1.1 partial requests on keep-alive connections.","+"," ## 3.21.1"," "," - Reject bare LF as trailer terminator after chunked encodings. [GHSA-9w4r-xc43-v236](https://github.com/actix/actix-web/security/advisories/GHSA-9w4r-xc43-v236)"],"additions":2,"deletions":0,"truncated":false},{"path":"actix-http/src/builder.rs","lines":["@@ -101,7 +101,7 @@ where","         self","     }"," ","-    /// Set client request timeout (for first request).","+    /// Set the timeout for reading a client request head.","     ///","     /// Defines a timeout for reading client request header. If the client does not transmit the","     /// request head within this duration, the connection is terminated with a `408 Request Timeout`"],"additions":1,"deletions":1,"truncated":false},{"path":"actix-http/src/config.rs","lines":["@@ -92,7 +92,7 @@ impl ServiceConfigBuilder {","         self","     }"," ","-    /// Sets the timeout for the client to finish sending the head of its first request","+    /// Sets the timeout for the client to finish sending a request head.","     pub fn client_request_timeout(mut self, timeout: Duration) -> Self {","         self.inner.client_request_timeout = timeout;","         self","@@ -274,8 +274,8 @@ impl ServiceConfig {","         }","     }"," ","-    /// Creates a time object representing the deadline for the client to finish sending the head of","-    /// its first request.","+    /// Creates a time object representing the deadline for the client to finish sending a request","+    /// head.","     ///","     /// Returns `None` if this `ServiceConfig was` constructed with `client_request_timeout: 0`.","     pub fn client_request_deadline(&self) -> Option<Instant> {"],"additions":3,"deletions":3,"truncated":false},{"path":"actix-http/src/h1/dispatcher.rs","lines":["@@ -1051,7 +1051,7 @@ where"," ","                     match msg {","                         Message::Item(mut req) => {","-                            // head timer only applies to first request on connection","+                            // Stop the head timer before reading the request payload.","                             this.head_timer.clear(line!());"," ","                             req.head_mut().peer_addr = *this.peer_addr;","@@ -1125,9 +1125,23 @@ where","                     }","                 }"," ","-                // decode is partial and buffer is not full yet","-                // break and wait for more read","-                Ok(None) => break,","+                // Decode is partial.","+                Ok(None) => {","+                    if this.payload.is_none()","+                        && this.codec.keep_alive()","+                        && !this.read_buf.is_empty()","+                        && !matches!(this.head_timer, TimerState::Active { .. })","+                    {","+                        // Subsequent requests on this connection get client deadlines too.","+                        if let Some(deadline) = this.config.client_request_deadline() {","+                            this.head_timer","+                                .set_and_init(cx, sleep_until(deadline.into()), line!());","+                        }","+                    }","+","+                    // Needs more bytes read for full head.","+                    break;","+                }"," ","                 Err(ParseError::Io(err)) => {","                     trace!(\"I/O error: {}\", &err);","@@ -1187,7 +1201,7 @@ where"," ","         if let TimerState::Active { timer } = this.head_timer {","             if timer.as_mut().poll(cx).is_ready() {","-                // timeout on first request (slow request) return 408","+                // Return 408 when a request head takes too long."," ","                 trace!(\"timed out on slow request; replying with 408 and closing connection\");"," ","@@ -1517,7 +1531,10 @@ where","                             PollResponse::DoNothing => {","                                 // KEEP_ALIVE is set in send_response_inner if client allows it","                                 // FINISHED is set after writing last chunk of response","-                                if inner.flags.contains(Flags::KEEP_ALIVE | Flags::FINISHED) {","+                                // A partial head uses its own deadline instead of the idle timeout.","+                                if inner.flags.contains(Flags::KEEP_ALIVE | Flags::FINISHED)","+                                    && !matches!(inner.head_timer, TimerState::Active { .. })","+                                {","                                     if let Some(timer) = inner.config.keep_alive_deadline() {","                                         inner.as_mut().project().ka_timer.set_and_init(","                                             cx,"],"additions":23,"deletions":6,"truncated":false},{"path":"actix-http/tests/test_server.rs","lines":["@@ -3,6 +3,7 @@ use std::{","     future::ready,","     io::{Read, Write},","     net,","+    pin::pin,","     sync::{Arc, Mutex},","     thread,","     time::{Duration, Instant},","@@ -23,7 +24,10 @@ use derive_more::{Display, Error};"," use futures_util::{stream::once, FutureExt as _, StreamExt as _};"," use rand::RngExt as _;"," use regex::Regex;","-use tokio::io::{AsyncReadExt as _, AsyncWriteExt as _};","+use tokio::{","+    io::{AsyncReadExt as _, AsyncWriteExt as _},","+    time::interval,","+};"," use tokio_util::future::FutureExt as _;"," "," #[tokio::test(flavor = \"local\")]","@@ -491,6 +495,270 @@ async fn http1_keepalive_close() {","     srv.stop().await;"," }"," ","+/// Reads the socket until EOF and returns everything received. Panics if EOF does not arrive","+/// within `timeout`.","+fn read_to_end_with_deadline(mut stream: net::TcpStream, timeout: Duration) -> String {","+    let (tx, rx) = std::sync::mpsc::channel();","+","+    thread::spawn(move || {","+        let mut buf = Vec::new();","+        let mut chunk = [0u8; 256];","+","+        loop {","+            match stream.read(&mut chunk) {","+                Ok(0) | Err(_) => break,","+                Ok(n) => buf.extend_from_slice(&chunk[..n]),","+            }","+        }","+","+        let _ = tx.send(String::from_utf8_lossy(&buf).into_owned());","+    });","+","+    match rx.recv_timeout(timeout) {","+        Ok(response) => response,","+        Err(_) => panic!(\"Connection should close within {timeout:?}\"),","+    }","+}","+","+/// Sends `probe` as the start of a second request on an idle keep-alive connection and checks","+/// that the connection is eventually closed.","+async fn keepalive_partial_second_request_probe(probe: &'static [u8]) {","+    let mut srv = test_server(|| {","+        HttpService::build()","+            .keep_alive(Duration::from_secs(1))","+            .client_request_timeout(Duration::from_secs(1))","+            .h1(|_| ready(Ok::<_, Infallible>(Response::ok())))","+            .tcp()","+    })","+    .await;","+","+    let mut stream = net::TcpStream::connect(srv.addr()).unwrap();","+","+    let _ = stream.write_all(b\"GET /test HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\");","+    let mut data = vec![0; 256];","+    let _ = stream.read(&mut data);","+    assert_eq!(&data[..17], b\"HTTP/1.1 200 OK\\r\\n\");","+","+    let _ = stream.write_all(probe);","+","+    let response = read_to_end_with_deadline(stream, Duration::from_secs(5));","+","+    assert!(","+        response.is_empty() || response.contains(\"408\"),","+        \"Connection should close or time out; got: {response:?}\"","+    );","+","+    srv.stop().await;","+}","+","+#[tokio::test(flavor = \"local\")]","+async fn http1_keepalive_partial_second_request_timeout() {","+    keepalive_partial_second_request_probe(b\"G\").await;","+}","+","+#[tokio::test(flavor = \"local\")]","+async fn http1_keepalive_crlf_probe_timeout() {","+    keepalive_partial_second_request_probe(b\"\\r\\n\").await;","+}","+","+#[tokio::test(flavor = \"local\")]","+async fn http1_keepalive_pipelined_then_partial_timeout() {","+    let mut srv = test_server(|| {","+        HttpService::build()","+            .keep_alive(Duration::from_secs(30))","+            .client_request_timeout(Duration::from_secs(1))","+            .h1(|_| ready(Ok::<_, Infallible>(Response::ok())))","+            .tcp()","+    })","+    .await;","+","+    let mut stream = net::TcpStream::connect(srv.addr()).unwrap();","+","+    let _ = stream.write_all(b\"GET /test HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\");","+    let mut data = vec![0; 256];","+    let _ = stream.read(&mut data);","+","+    // pipelined second request followed by one byte of a third request, then silence","+    let _ = stream.write_all(b\"GET /test HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\nG\");","+","+    let response = read_to_end_with_deadline(stream, Duration::from_secs(5));","+","+    assert!(","+        response.contains(\"408\"),","+        \"Connection should time out; got: {response:?}\"","+    );","+","+    srv.stop().await;","+}","+","+#[tokio::test(flavor = \"local\")]","+async fn http1_request_head_timeout_is_not_renewed_by_incoming_bytes() {","+    let mut srv = test_server(|| {","+        HttpService::build()","+            .keep_alive(Duration::from_secs(30))","+            .client_request_timeout(Duration::from_secs(1))","+            .h1(|_| ready(Ok::<_, Infallible>(Response::ok())))","+            .tcp()","+    })","+    .await;","+","+    for follow_up in [false, true] {","+        let mut stream = TcpStream::connect(srv.addr()).await.unwrap();","+","+        if follow_up {","+            stream","+                .write_all(b\"GET / HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\")","+                .await","+                .unwrap();","+","+            assert!(read_http1_response_head(&mut stream)","+                .await","+                .contains(\"200 OK\"));","+        }","+","+        stream.write_all(b\"G\").await.unwrap();","+","+        let (mut reader, mut writer) = stream.split();","+        let mut response = String::new();","+","+        async {","+            let mut read = pin!(reader.read_to_string(&mut response));","+","+            let mut interval = interval(Duration::from_millis(150));","+","+            loop {","+                tokio::select! {","+                    result = &mut read => {","+                        result.unwrap();","+                        break;","+                    }","+","+                    _ = interval.tick() => {","+                        let _ = writer.write_all(b\"E\").await;","+                    }","+                }","+            }","+        }","+        .timeout(Duration::from_secs(2))","+        .await","+        .expect(\"Request head deadline should not be renewed by incoming bytes\");","+","+        assert!(response.starts_with(\"HTTP/1.1 408 Request Timeout\"));","+    }","+","+    srv.stop().await;","+}","+","+/// Reads a complete response head from a service with an empty response body.","+async fn read_http1_response_head(stream: &mut TcpStream) -> String {","+    async {","+        let mut response = Vec::new();","+        let mut chunk = [0; 256];","+","+        while !response.ends_with(b\"\\r\\n\\r\\n\") {","+            let len = stream.read(&mut chunk).await.unwrap();","+            assert_ne!(","+                len, 0,","+                \"Connection should remain open until the response head is complete\"","+            );","+","+            response.extend_from_slice(&chunk[..len]);","+        }","+","+        String::from_utf8(response).unwrap()","+    }","+    .timeout(Duration::from_secs(5))","+    .await","+    .expect(\"Response head should arrive within 5 seconds\")","+}","+","+#[tokio::test(flavor = \"local\")]","+async fn http1_request_head_timeout_does_not_limit_uploads() {","+    let mut srv = test_server(|| {","+        HttpService::build()","+            .keep_alive(Duration::from_secs(30))","+            .client_request_timeout(Duration::from_secs(1))","+            .h1(|mut req: Request| async move {","+                let mut payload = req.take_payload();","+","+                while let Some(chunk) = payload.next().await {","+                    chunk.unwrap();","+                }","+","+                Ok::<_, Infallible>(Response::ok())","+            })","+            .tcp()","+    })","+    .await;","+","+    for follow_up in [false, true] {","+        let mut stream = TcpStream::connect(srv.addr()).await.unwrap();","+","+        if follow_up {","+            stream","+                .write_all(b\"GET / HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\")","+                .await","+                .unwrap();","+","+            assert!(read_http1_response_head(&mut stream)","+                .await","+                .contains(\"200 OK\"));","+        }","+","+        stream","+            .write_all(b\"POST / HTTP/1.1\\r\\nHost: localhost\\r\\nContent-Length: 4\\r\\n\\r\\nd\")","+            .await","+            .unwrap();","+","+        sleep(Duration::from_millis(1300)).await;","+","+        stream.write_all(b\"ata\").await.unwrap();","+","+        assert!(read_http1_response_head(&mut stream)","+            .await","+            .contains(\"200 OK\"));","+    }","+","+    srv.stop().await;","+}","+","+#[tokio::test(flavor = \"local\")]","+async fn http1_keepalive_pipelined_partial_head_uses_request_timeout() {","+    let mut srv = test_server(|| {","+        HttpService::build()","+            .keep_alive(Duration::from_millis(200))","+            .client_request_timeout(Duration::from_secs(1))","+            .h1(|_| ready(Ok::<_, Infallible>(Response::ok())))","+            .tcp()","+    })","+    .await;","+","+    let mut stream = TcpStream::connect(srv.addr()).await.unwrap();","+    stream","+        // note the trailing \"G\"","+        .write_all(b\"GET / HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\nG\")","+        .await","+        .unwrap();","+","+    assert!(read_http1_response_head(&mut stream)","+        .await","+        .contains(\"200 OK\"));","+","+    sleep(Duration::from_millis(600)).await;","+","+    stream","+        // note that the \"G\" of GET was pipelined earlier","+        .write_all(b\"ET / HTTP/1.1\\r\\nHost: localhost\\r\\n\\r\\n\")","+        .await","+        .unwrap();","+","+    assert!(read_http1_response_head(&mut stream)","+        .await","+        .contains(\"200 OK\"));","+","+    srv.stop().await;","+}","+"," #[tokio::test(flavor = \"local\")]"," async fn http10_keepalive_default_close() {","     let mut srv = test_server(|| {"],"additions":269,"deletions":1,"truncated":false},{"path":"actix-web/src/server.rs","lines":["@@ -230,7 +230,7 @@ where","         self","     }"," ","-    /// Sets server client timeout for first request.","+    /// Sets the timeout for reading a client request head.","     ///","     /// Defines a timeout for reading client request head. If a client does not transmit the entire","     /// set headers within this time, the request is terminated with a 408 (Request Timeout) error."],"additions":1,"deletions":1,"truncated":false},{"path":"flake.lock","lines":["@@ -0,0 +1,82 @@","+{","+  \"nodes\": {","+    \"flake-parts\": {","+      \"inputs\": {","+        \"nixpkgs-lib\": \"nixpkgs-lib\"","+      },","+      \"locked\": {","+        \"lastModified\": 1715865404,","+        \"narHash\": \"sha256-/GJvTdTpuDjNn84j82cU6bXztE0MSkdnTWClUCRub78=\",","+        \"owner\": \"hercules-ci\",","+        \"repo\": \"flake-parts\",","+        \"rev\": \"8dc45382d5206bd292f9c2768b8058a8fd8311d9\",","+        \"type\": \"github\"","+      },","+      \"original\": {","+        \"owner\": \"hercules-ci\",","+        \"repo\": \"flake-parts\",","+        \"type\": \"github\"","+      }","+    },","+    \"nixpkgs\": {","+      \"locked\": {","+        \"lastModified\": 1791662279,","+        \"narHash\": \"sha256-xI8L+UwJLIg