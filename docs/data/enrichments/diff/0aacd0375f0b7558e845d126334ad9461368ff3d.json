PipelineOptions {","+\tif opt == nil {","+\t\treturn &PipelineOptions{options: make(map[string]any), experiments: make(map[string]string)}","+\t}","+\traw := opt.AsMap()","+\tflat := make(map[string]any)","+","+\t// 1. Extract nested options if present (Dataflow runner uses this structure)","+\tif optsVal, ok := raw[\"options\"]; ok {","+\t\tif optsMap, ok := optsVal.(map[string]any); ok {","+\t\t\tfor k, v := range optsMap {","+\t\t\t\tflat[k] = v","+\t\t\t}","+\t\t}","+\t}","+","+\t// 2. Extract standard URN keys (Portable runners use this structure)","+\tfor k, v := range raw {","+\t\tif k == \"options\" || k == \"display_data\" {","+\t\t\tcontinue","+\t\t}","+\t\tif strings.HasPrefix(k, \"beam:option:\") && strings.HasSuffix(k, \":v1\") {","+\t\t\tname := strings.TrimPrefix(k, \"beam:option:\")","+\t\t\tname = strings.TrimSuffix(name, \":v1\")","+\t\t\tflat[name] = v","+\t\t}","+\t}","+","+\t// 3. Promote specified SDK namespace options (Highest precedence, may overwrite earlier entries).","+\t// Beam Go SDK uses this structure.","+\tif sdkNamespace != \"\" {","+\t\tsdkURN := fmt.Sprintf(\"beam:option:%s:v1\", sdkNamespace)","+\t\tif sdkVal, ok := raw[sdkURN]; ok {","+\t\t\tif urnMap, ok := sdkVal.(map[string]any); ok {","+\t\t\t\tif nestedOpts, ok := urnMap[\"options\"].(map[string]any); ok {","+\t\t\t\t\tfor nk, nv := range nestedOpts {","+\t\t\t\t\t\tflat[nk] = nv","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+","+\tpo := &PipelineOptions{","+\t\toptions:     flat,","+\t\texperiments: make(map[string]string),","+\t}","+\tif exps, err := po.GetStringSlice(\"experiments\"); err == nil {","+\t\tpo.experiments = parseExperiments(exps)","+\t}","+\treturn po","+}","+","+func parseExperiments(slice []string) map[string]string {","+\tres := make(map[string]string)","+\tfor _, item := range slice {","+\t\tif strings.Contains(item, \"=\") {","+\t\t\tparts := strings.SplitN(item, \"=\", 2)","+\t\t\tres[parts[0]] = parts[1]","+\t\t} else {","+\t\t\tres[item] = \"\"","+\t\t}","+\t}","+\treturn res","+}","+","+// HasOption returns true if the option is defined and not nil.","+func (po *PipelineOptions) HasOption(name string) bool {","+\tval, ok := po.options[name]","+\treturn ok && val != nil","+}","+","+// GetString returns the value of an option as a string.","+// As a convenience and to maintain compatibility with Go SDK's flags serialization style,","+// if the option is stored as a string slice/array, GetString will conjoin the elements","+// into a single comma-separated string (e.g. [\"opt1\", \"opt2\"] -> \"opt1,opt2\").","+func (po *PipelineOptions) GetString(name string) (string, error) {","+\tval, ok := po.options[name]","+\tif !ok || val == nil {","+\t\treturn \"\", fmt.Errorf(\"option %q not defined\", name)","+\t}","+\tif str, ok := val.(string); ok {","+\t\treturn str, nil","+\t}","+\tif slice, ok := val.([]any); ok {","+\t\tvar parts []string","+\t\tfor _, item := range slice {","+\t\t\tif str, ok := item.(string); ok {","+\t\t\t\tparts = append(parts, str)","+\t\t\t} else {","+\t\t\t\treturn \"\", fmt.Errorf(\"option %q: expected string slice element, got type %T\", name, item)","+\t\t\t}","+\t\t}","+\t\treturn strings.Join(parts, \",\"), nil","+\t}","+\treturn \"\", fmt.Errorf(\"option %q: expected string, got type %T\", name, val)","+}","+","+// GetStringSlice returns the value of an option as a string slice.","+// As a convenience and to maintain compatibility with Go SDK's flags serialization style,","+// if the option is stored as a single comma-separated string (such as experiments","+// or dataflow_service_options), GetStringSlice will parse it by splitting the string","+// by comma (e.g. \"opt1,opt2\" -> [\"opt1\", \"opt2\"]).","+func (po *PipelineOptions) GetStringSlice(name string) ([]string, error) {","+\tval, ok := po.options[name]","+\tif !ok || val == nil {","+\t\treturn nil, fmt.Errorf(\"option %q not defined\", name)","+\t}","+\tif slice, ok := val.([]any); ok {","+\t\tvar res []string","+\t\tfor _, item := range slice {","+\t\t\tif str, ok := item.(string); ok {","+\t\t\t\tres = append(res, str)","+\t\t\t} else {","+\t\t\t\treturn nil, fmt.Errorf(\"option %q: expected string slice element, got type %T\", name, item)","+\t\t\t}","+\t\t}","+\t\treturn res, nil","+\t}","+\tif str, ok := val.(string); ok {","+\t\t// Go SDK models multi-value list flags (like experiments or dataflow_service_options)","+\t\t// as comma-separated string values.","+\t\tif str == \"\" {","+\t\t\treturn nil, nil","+\t\t}","+\t\treturn strings.Split(str, \",\"), nil","+\t}","+\treturn nil, fmt.Errorf(\"option %q: expected string slice, got type %T\", name, val)","+}","+","+// GetInt returns the value of an option as an integer.","+func (po *PipelineOptions) GetInt(name string) (int, error) {","+\tval, ok := po.options[name]","+\tif !ok || val == nil {","+\t\treturn 0, fmt.Errorf(\"option %q not defined\", name)","+\t}","+\tswitch v := val.(type) {","+\tcase float64:","+\t\treturn int(v), nil","+\tcase string:","+\t\tres, err := strconv.Atoi(v)","+\t\tif err == nil {","+\t\t\treturn res, nil","+\t\t}","+\t\treturn 0, fmt.Errorf(\"option %q: failed to parse %q as int: %w\", name, v, err)","+\tdefault:","+\t\treturn 0, fmt.Errorf(\"option %q: expected int (represented as number or string), got type %T\", name, val)","+\t}","+}","+","+// GetBool returns the value of an option as a boolean.","+func (po *PipelineOptions) GetBool(name string) (bool, error) {","+\tval, ok := po.options[name]","+\tif !ok || val == nil {","+\t\treturn false, fmt.Errorf(\"option %q not defined\", name)","+\t}","+\tswitch v := val.(type) {","+\tcase bool:","+\t\treturn v, nil","+\tcase string:","+\t\tres, err := strconv.ParseBool(v)","+\t\tif err != nil {","+\t\t\treturn false, fmt.Errorf(\"option %q: failed to parse %q as bool: %w\", name, v, err)","+\t\t}","+\t\treturn res, nil","+\tcase float64:","+\t\treturn v != 0, nil","+\tdefault:","+\t\treturn false, fmt.Errorf(\"option %q: expected bool, got type %T\", name, val)","+\t}","+}","+","+// GetFloat64 returns the value of an option as a float64.","+func (po *PipelineOptions) GetFloat64(name string) (float64, error) {","+\tval, ok := po.options[name]","+\tif !ok || val == nil {","+\t\treturn 0, fmt.Errorf(\"option %q not defined\", name)","+\t}","+\tswitch v := val.(type) {","+\tcase float64:","+\t\treturn v, nil","+\tcase string:","+\t\tres, err := strconv.ParseFloat(v, 64)","+\t\tif err == nil {","+\t\t\treturn res, nil","+\t\t}","+\t\treturn 0, fmt.Errorf(\"option %q: failed to parse %q as float64: %w\", name, v, err)","+\tdefault:","+\t\treturn 0, fmt.Errorf(\"option %q: expected float64 (represented as number or string), got type %T\", name, val)","+\t}","+}","+","+// LookupExperiment returns the value of an experiment option if present.","+// - If the experiment is present but has no value (e.g., --experiments=foo), it returns \"\", true.","+// - If the experiment is present as a key-value pair (e.g., --experiments=foo=bar), it returns \"bar\", true.","+// - If the experiment is not present, it returns \"\", false.","+func (po *PipelineOptions) LookupExperiment(key string) (string, bool) {","+\tval, ok := po.experiments[key]","+\treturn val, ok","+}","+","+// HasExperiment returns true if the specified experiment is present in the options (either as a flag or key-value pair).","+func (po *PipelineOptions) HasExperiment(name string) bool {","+\t_, ok := po.LookupExperiment(name)","+\treturn ok","+}"],"additions":218,"deletions":0,"truncated":false},{"path":"sdks/go/container/tools/pipeline_options_test.go","lines":["@@ -16,10 +16,28 @@"," package tools"," "," import (","+\t\"encoding/json\""," \t\"os\""," \t\"testing\"","+","+\tstructpb \"google.golang.org/protobuf/types/known/structpb\""," )"," ","+func parseProtoForTest(t *testing.T, options string) *structpb.Struct {","+\tif options == \"\" {","+\t\toptions = \"{}\"","+\t}","+\tvar raw map[string]interface{}","+\tif err := json.Unmarshal([]byte(options), &r