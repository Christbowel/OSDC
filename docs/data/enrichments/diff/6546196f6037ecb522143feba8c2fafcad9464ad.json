nd the caller reads meta-service instead. They take `&self` and are not futures: readers","+/// share a `Cache` without a lock, and a read answers whether or not the task's tokio coop","+/// budget is spent.","+///","+/// What they return lags a change by the watch delay, a change made by this process included:","+/// use them where a briefly stale value is acceptable, never to read the seq of a","+/// compare-and-swap. They hide a key whose TTL has passed, as meta-service does: meta-service","+/// removes the key, and tells the watch, only when it applies a later write.","+///","+/// A directory is used as given, and its keys are those under `{dir}/`: `a` is the directory","+/// `a`, and `a/` the empty-named directory inside it, whose keys are `a//...`."," pub struct Cache {","+    /// The watched directory.","+    dir: String,","     pub(crate) inner: sub_cache::Cache<MetaCacheTypes>,"," }"," ","@@ -36,48 +55,75 @@ impl Deref for Cache {","     }"," }"," ","-impl DerefMut for Cache {","-    fn deref_mut(&mut self) -> &mut Self::Target {","-        &mut self.inner","-    }","-}","-"," impl Cache {","-    /// Read only if the cache can answer immediately. Initial sync and reconnect","-    /// hold the inner lock; callers must fall back instead of waiting for it.","-    pub fn try_get_ready(&mut self, key: &str) -> Option<SeqV> {","+    /// The value of `key` if the copy can answer at once, see [`Cache`].","+    ///","+    /// `None` if the copy cannot answer, lacks `key`, or holds it past its TTL. The caller reads","+    /// meta-service for every `None`: a key the copy lacks may be one the watch has not delivered","+    /// yet.","+    pub fn try_get_ready(&self, key: &str) -> Option<SeqV> {","+        let now_ms = now_ms();","         self.inner","-            .try_get(key)","-            .now_or_never()","-            .and_then(Result::ok)","-            .flatten()","+            .try_access_now(|data| {","+                data.data","+                    .get(key)","+                    .filter(|value| !value.is_expired(now_ms))","+                    .cloned()","+            })?","+            .ok()?","     }"," ","-    /// Create a new cache with the given prefix and meta client.","+    /// The keys and values under the directory `{dir}/` if the copy can answer at once, see","+    /// [`Cache`].","+    ///","+    /// `None` if the copy cannot answer, or `dir` is neither the watched directory nor under it.","+    pub fn try_list_dir_ready(&self, dir: &str) -> Option<Vec<(String, SeqV)>> {","+        let covered = dir","+            .strip_prefix(self.dir.as_str())","+            .is_some_and(|rest| rest.is_empty() || rest.starts_with('/'));","+        if !covered {","+            return None;","+        }","+        let now_ms = now_ms();","+        let mut items = self.inner.try_list_dir_now(dir)?.ok()?;","+        items.retain(|(_, value)| !value.is_expired(now_ms));","+        Some(items)","+    }","+","+    /// Create a new cache of the directory `dir`, watched through `meta_client`.","     ///","     /// The cache will start watching for changes immediately.","     ///","     /// # Parameters","     ///","     /// * `meta_client` - The meta client to interact with the remote data store.","-    /// * `prefix` - The prefix for the cache, used to identify the cache instance.","+    /// * `dir` - The cache holds the keys under `{dir}/`, see [`Cache`]. It also identifies the","+    ///   cache instance.","     /// * `name` - The name of the cache, used for debugging and logging purposes.","     pub async fn new(","         meta_client: Arc<ClientHandle<DatabendRuntime>>,","-        prefix: impl ToString,","+        dir: impl ToString,","         name: impl ToString,","     ) -> Self {","+        let dir = dir.to_string();","         let name = name.to_string();","         let inner = sub_cache::Cache::new(","             meta_client_source::MetaClientSource {","                 client: meta_client,","                 name: name.clone(),","             },","-            prefix,","+            &dir,","             name,","         )","         .await;"," ","-        Cache { inner }","+        Cache { dir, inner }","     }"," }","+","+/// The time in ms since the Unix epoch, as meta-service compares it with the TTL of a key.","+fn now_ms() -> u64 {","+    SystemTime::now()","+        .duration_since(UNIX_EPOCH)","+        .map_or(0, |d| d.as_millis() as u64)","+}"],"additions":66,"deletions":20,"truncated":false},{"path":"src/meta/plugins/cache/src/lib.rs","lines":["@@ -31,7 +31,7 @@"," //! use databend_meta_client::MetaClient;"," //!"," //! let meta_client = MetaClient::new(\"127.0.0.1:9191\");","-//! let cache = Cache::new(\"my_prefix\", meta_client).await?;","+//! let cache = Cache::new(meta_client, \"my_dir\", \"my cache\").await;"," //!"," //! // Get a value"," //! let value = cache.try_get(\"key\").await?;","@@ -43,17 +43,18 @@"," //! # Cache Key Structure"," //!"," //! ```text","-//! <prefix>/foo","-//! <prefix>/..","-//! <prefix>/..","+//! <dir>/foo","+//! <dir>/..","+//! <dir>/.."," //! ```"," //!","-//! - `<prefix>` is a user-defined string to identify a cache instance.","+//! - `<dir>` is the watched directory, used as given: the cache holds the keys under `<dir>/`.","+//!   It also identifies a cache instance."," //!"," //! # Initialization Process"," //!"," //! When a [`Cache`] is created, it:","-//! 1. Creates a new instance with the specified prefix","+//! 1. Creates a new instance of the specified directory"," //! 2. Spawns a background task to watch for changes"," //! 3. Establishes a watch stream with initial flush"," //! 4. Fetches and processes initial data"],"additions":7,"deletions":6,"truncated":false},{"path":"src/meta/plugins/cache/src/meta_client_source.rs","lines":["@@ -14,16 +14,24 @@"," "," //! This mod provide cache with meta-client as data source"," ","+use std::future::Future;"," use std::sync::Arc;","+use std::time::Duration;"," "," use databend_meta_client::ClientHandle;"," use databend_meta_client::types::MetaClientError;"," use databend_meta_client::types::SeqV;","+use databend_meta_client::types::protobuf::Empty;"," use databend_meta_client::types::protobuf::WatchRequest;"," use databend_meta_client::types::protobuf::WatchResponse;"," use databend_meta_runtime::DatabendRuntime;","+use futures::Stream;"," use futures::StreamExt;","+use futures::future;","+use futures::future::Either;","+use futures::stream;"," use log::debug;","+use log::info;"," use log::warn;"," use sub_cache::Source;"," use sub_cache::errors::ConnectionClosed;","@@ -34,6 +42,26 @@ use sub_cache::event_stream::Event;"," use sub_cache::event_stream::EventStream;"," use tonic::Status;"," ","+/// How often the meta node serving a watch is asked whether it still leads, see","+/// [`MetaClientSource`].","+const LEADER_CHECK_INTERVAL: Duration = Duration::from_secs(5);","+","+/// How many meta nodes one `subscribe` asks whether they lead, following the leader each names.","+const LEADER_LOOKUPS: usize = 3;","+","+/// The source of a [`Cache`](crate::Cache): a watch served by the meta-service leader.","+///","+/// A follower that installs a snapshot sends no events for the changes the snapshot contains, and","+/// keeps its watch streams open (databend-meta#193). A leader never installs a snapshot, so the","+/// watch is opened only on the leader. The node serving it is asked every","+/// [`LEADER_CHECK_INTERVAL`] whether it still leads the term it led when the watch was opened. If","+/// it does not, or does not answer, the stream ends with an error, and the cache rebuilds from a","+/// new watch on the current leader. The changes in a snapshot that a node installs right after it","+/// steps down can still be missing from the copy for up to one check interval.","+///","+/// A leader cut off from the other meta nodes still leads in its own view: its watch stays open,","+/// without changes, until the cut heals. If the client cannot connect to the leader, e.g. its","+/// endpoints lack the leader's gRPC address, the cache does not become ready."," pub struct MetaClientSource {","     pub(crate) client: Arc<ClientHandle<DatabendRuntime>>,"," ","@@ -51,47 +79,95 @@ impl Source<SeqV> for MetaClientSource {","         let watch =","             WatchRequest::new(left.to_string(), Some(right.to_string())).with_initial_flush(true);"," ","-        let res = self.client.watch_with_initialization(watch).await;","-","-        let client_err = match res {","-            Ok(strm) => {","-                debug!(\"{}: watch stream established\", self.name);","-","-                let strm = strm.map({","-                    let name = self.name.clone();","-                    move |x| watch_result_to_cache_event(x, &name)","-                });","+        self.watch_on_leader(watch).await.map_err(|err| {","+            warn!(","+                \"{}: error when establishing watch stream: {}\",","+                self.name, err","+            );","+            err.context(\"MetaClientSource::subscribe\")","+                .context(&self.name)","+        })","+    }","+}"," ","-                let strm = Box::pin(strm);","+impl MetaClientSource {","+    /// Open `watch` on the leader. The stream ends with an error once its node no longer leads,","+    /// see [`MetaClientSource`].","+    async fn watch_on_leader(","+        &self,","+        watch: WatchRequest,","+    ) -> Result<EventStream<SeqV>, SubscribeError> {","+        // The meta client does not export the type of an established client, so its values here","+        // are only inferred, never named.","+        let mut lookups = 0;","+        let (mut leader, term) = loop {","+            let mut client = self","+                .client","+                .make_established_client()","+                .await","+                .map_err(subscribe_error)?;","+            let status = client.get_cluster_status(Empty {}).await;","+            let status = status.map_err(status_error)?.into_inner();","+            if status.is_leader {","+                break (client, status.current_term);","+            }"," ","-                return Ok(strm);","+            let not_leader = format!(","+                \"{} is {}, not the leader; leader: {}\",","+                client.target_endpoint(),","+                status.state,","+                status.leader.as_deref().unwrap_or(\"unknown\")","+            );","+            lookups += 1;","+            if lookups == LEADER_LOOKUPS {","+                let err = ConnectionClosed::new_str(not_leader).context(\"find the leader to watch\");","+                return Err(SubscribeError::Connection(err));","             }","+            info!(\"{}: {}; switch to the leader\", self.name, not_leader);"," ","-            Err(client_err) => client_err,","+            // A follower forwards a read to the leader, and its reply names the leader: the","+            // client connects to the leader from then on.","+            if let Err(err) = self.client.get_kv(&watch.key).await {","+                warn!(\"{}: a read to find the leader failed: {}\", self.name, err);","+            }","         };"," ","-        warn!(","-            \"{}: error when establishing watch stream: {}\",","-            self.name, client_err","+        let target = leader.target_endpoint().to_string();","+        let strm = leader.watch(watch).await.map_err(status_error)?;","+        debug!(","+            \"{}: watch stream established on {}, the leader of term {}\",","+            self.name, target, term","         );"," ","-        let err = match client_err {","-            MetaClientError::HandshakeError(hs_err) => {","-                let unsupported = Unsupported::new(hs_err);","-                SubscribeError::Unsupported(unsupported)","-            }","+        let name = self.name.clone();","+        let events = strm","+            .into_inner()","+            .map(move |x| watch_result_to_cache_event(x, &name));","+","+        let stop = async move {","+            loop {","+                tokio::time::sleep(LEADER_CHECK_INTERVAL).await;"," ","-            MetaClientError::NetworkError(net_err) => {","-                let conn_err = ConnectionClosed::new_str(net_err.to_string());","-                SubscribeError::Connection(conn_err)","+                let ask = leader.get_cluster_status(Empty {});","+                let status = match tokio::time::timeout(LEADER_CHECK_INTERVAL, ask).await {","+                    Ok(Ok(resp)) => resp.into_inner(),","+                    Ok(Err(err)) => return format!(\"cannot ask {target} whether it leads: {err}\"),","+                    Err(_) => {","+                        return format!(","+                            \"{target} did not answer whether it leads in {LEADER_CHECK_INTERVAL:?}\"","+                        );","+                    }","+                };","+                if !status.is_leader || status.current_term != term {","+                    return format!(","+                        \"{target} no longer leads term {term}: it is {} in term {}\",","+                        status.state, status.current_term","+                    );","+                }","             }","         };"," ","-        let err = err","-            .context(\"MetaClientSource::subscribe\")","-            .context(&self.name);","-","-        Err(err)","+        Ok(until_stopped(events, stop))","     }"," }"," ","@@ -125,3 +201,85 @@ fn watch_result_to_cache_event("," ","     Ok(event)"," }","+","+fn subscribe_error(client_err: MetaClientError) -> SubscribeError {","+    match client_err {","+        MetaClientError::HandshakeError(hs_err) => {","+            SubscribeError::Unsupported(Unsupported::new(hs_err))","+        }","+        MetaClientError::NetworkError(net_err) => {","+            SubscribeError::Connection(ConnectionClosed::new_str(net_err.to_string()))","+        }","+    }","+}","+","+/// Like [`subscribe_error`], for the error status of a call on an established client.","+fn status_error(status: Status) -> SubscribeError {","+    subscribe_error(MetaClientError::from(status))","+}","+","+/// The items of `events` until it ends, or until `stop` resolves: then an error with the reason","+/// `stop` gives, and the end.","+fn until_stopped(","+    events: impl Stream<Item = Result<Event<SeqV>, ConnectionClosed>> + Send + 'static,","+    stop: impl Future<Output = String> + Send + 'static,","+) -> EventStream<SeqV> {","+    let state = Some((events.boxed(), Box::pin(stop)));","+    stream::unfold(state, |state| async move {","+        let (mut events, mut stop) = state?;","+        // `stop` first, so that a stream with an event always ready does not starve the check.","+        let next = match future::select(stop.as_mut(), events.next()).await {","+            Either::Left((reason, _)) => Err(reason),","+            Either::Right((item, _)) => Ok(item),","+        };","+        match next {","+            Ok(Some(item)) => Some((item, Some((events, stop)))),","+            Ok(None) => None,","+            Err(reason) => Some((Err(ConnectionClosed::new_str(reason)), None)),","+        }","+    })","+    .boxed()","+}","+","+#[cfg(test)]","+mod tests {","+    use std::task::Poll;","+","+    use futures::executor::block_on;","+","+    use super::*;","+","+    fn complete() -> Result<Event<SeqV>, ConnectionClosed> {","+        Ok(Event::InitializationComplete)","+    }","+","+    #[test]","+    fn test_until_stopped_ends_with_the_events() {","+        let events = stream::iter([complete(), complete()]);","+        let got = block_on(until_stopped(events, future::pending()).collect::<Vec<_>>());","+        assert_eq!(got.len(), 2);","+        assert!(got.iter().all(Result::is_ok));","+    }","+","+    /// Once `stop` resolves, an error with its reason ends the stream, though more events are","+    /// ready.","+    #[test]","+    fn test_until_stopped_ends_with_an_error_when_stopped() {","+        let events = stream::iter([complete(), complete(), complete()]);","+        let mut polled = false;","+        let stop = future::poll_fn(move |cx| {","+            if polled {","+                return Poll::Ready(\"stopped\".to_string());","+            }","+            polled = true;","+            cx.waker().wake_by_ref();","+            Poll::Pending","+        });","+","+        let got = block_on(until_stopped(events, stop).collect::<Vec<_>>());","+        assert_eq!(got.len(), 2);","+        assert!(got[0].is_ok());","+        let err = got[1].as_ref().unwrap_err();","+        assert!(err.to_string().contains(\"stopped\"), \"{err}\");","+    }","+}"],"additions":187,"deletions":29,"truncated":false},{"path":"src/meta/plugins/cache/tests/it/grpc_cache.rs","lines":["@@ -72,7 +72,7 @@ async fn test_cache_basic() -> anyhow::Result<()> {"," ","     cli.upsert_kv(UpsertKV::update(\"pq/d\", b\"d\")).await?;"," ","-    let mut c = Cache::new(client(), \"pp\", \"test\").await;","+    let c = Cache::new(client(), \"pp\", \"test\").await;"," ","     // Check initial state"," ","@@ -138,7 +138,7 @@ async fn test_cache_when_leader_down() -> anyhow::Result<()> {","     cli.upsert_kv(UpsertKV::update(\"pp/a\", b\"a\")).await?;","     cli.upsert_kv(UpsertKV::update(\"pp/c\", b\"c\")).await?;"," ","-    let mut c = Cache::new(client(), \"pp\", \"test\").await;","+    let c = Cache::new(client(), \"pp\", \"test\").await;"," ","     cli.upsert_kv(UpsertKV::update(\"pp/after_cache_create\", b\"x\"))","         .await?;","@@ -184,7 +184,7 @@ async fn test_ready_cache_read_during_reconnect() -> anyhow::Result<()> {","         .upsert_kv(UpsertKV::update(\"ready/a\", b\"old\"))","         .await?;","     let watch_client = make_grpc_client::<DatabendRuntime>(vec![addresses[0].clone()])?;","-    let mut cache = Cache::new(watch_client, \"ready\", \"reconnect-ready\").await;","+    let cache = Cache::new(watch_client, \"ready\", \"reconnect-ready\").await;","     assert!(cache.try_get(\"ready/a\").await?.is_some());"," ","     let mut stopped = tcs.remove(0);"],"additions":3,"deletions":3,"truncated":false},{"path":"src/meta/plugins/cache/tests/it/leader.rs","lines":["@@ -0,0 +1,136 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+//! The watch of a `Cache` is served by the meta-service leader, and follows the leadership.","+","+use std::sync::Arc;","+use std::time::Duration;","+","+use databend_meta_client::ClientHandle;","+use databend_meta_client::DEFAULT_GRPC_MESSAGE_SIZE;","+use databend_meta_client::MetaGrpcClient;","+use databend_meta_client::types::UpsertKV;","+use databend_meta_plugin_cache::Cache;","+use databend_meta_runtime::DatabendRuntime;","+use databend_meta_test_harness::MetaSrvTestContext;","+use databend_meta_test_harness::meta_service_test_harness;","+use databend_meta_test_harness::start_metasrv_cluster;","+use test_harness::test;","+use tokio::time::sleep;","+","+type TestContext = MetaSrvTestContext<DatabendRuntime>;","+","+fn new_client(addresses: Vec<String>) -> anyhow::Result<Arc<ClientHandle<DatabendRuntime>>> {","+    let client = MetaGrpcClient::<DatabendRuntime>::try_create(","+        addresses,","+        \"root\",","+        \"xxx\",","+        Some(Duration::from_secs(2)),","+        Some(Duration::from_secs(10)),","+        None,","+        DEFAULT_GRPC_MESSAGE_SIZE,","+    )?;","+    Ok(client)","+}","+","+/// The number of watch streams each meta node serves.","+async fn watchers(tcs: &[TestContext]) -> anyhow::Result<Vec<usize>> {","+    let mut counts = Vec::with_capacity(tcs.len());","+    for tc in tcs {","+        let meta_node = tc.grpc_srv.as_ref().unwrap().get_meta_node().await;","+        let count = meta_node","+            .dispatcher_handle","+            .request_blocking(|d| d.watch_senders().len())","+            .await?;","+        counts.push(count);","+    }","+    Ok(counts)","+}","+","+/// Wait until the meta node `serving` serves one watch stream, and the others serve none.","+async fn wait_for_watch_on(tcs: &[TestContext], serving: usize) -> anyhow::Result<()> {","+    let mut want = vec![0; tcs.len()];","+    want[serving] = 1;","+    for _ in 0..200 {","+        if watchers(tcs).await? == want {","+            return Ok(());","+        }","+        sleep(Duration::from_millis(100)).await;","+    }","+    let got = watchers(tcs).await?;","+    anyhow::bail!(\"the meta nodes serve {got:?} watch streams, not {want:?}\")","+}","+","+/// Move the leadership from `from` to `to`, and wait until `to` leads.","+async fn transfer_leader(","+    tcs: &[TestContext],","+    addresses: &[String],","+    from: usize,","+    to: usize,","+) -> anyhow::Result<()> {","+    let meta_node = tcs[from].grpc_srv.as_ref().unwrap().get_meta_node().await;","+    meta_node.raft.trigger().transfer_leader(to as u64).await?;","+","+    let to_client = new_client(vec![addresses[to].clone()])?;","+    for _ in 0..100 {","+        if to_client.get_cluster_status().await?.is_leader {","+            return Ok(());","+        }","+        sleep(Duration::from_millis(100)).await;","+    }","+    anyhow::bail!(\"meta node {to} did not become the leader\")","+}","+","+/// A cache opens its watch on the leader, though its client asks a follower first, and moves the","+/// watch to the new leader once the leadership moves.","+#[test(harness = meta_service_test_harness::<DatabendRuntime, _, _>)]","+#[fastrace::trace]","+async fn test_cache_watches_the_leader() -> anyhow::Result<()> {","+    let tcs = start_metasrv_cluster::<DatabendRuntime>(&[0, 1, 2]).await?;","+    let addresses = tcs","+        .iter()","+        .map(|tc| tc.config.grpc.api_address().unwrap())","+        .collect::<Vec<_>>();","+","+    // A new client first connects to the smallest address: make sure that one does not lead.","+    let first = (0..addresses.len()).min_by_key(|&i| &addresses[i]).unwrap();","+    let mut leader = 0;","+    if first == leader {","+        transfer_leader(&tcs, &addresses, leader, 1).await?;","+        leader = 1;","+    }","+","+    let writer = new_client(addresses.clone())?;","+    writer.upsert_kv(UpsertKV::update(\"pp/a\", b\"a\")).await?;","+","+    let cache = Cache::new(new_client(addresses.clone())?, \"pp\", \"test-leader\").await;","+    // Waits for the initialization.","+    let got = cache.try_get(\"pp/a\").await?;","+    assert_eq!(got.map(|v| v.data), Some(b\"a\".to_vec()));","+    wait_for_watch_on(&tcs, leader).await?;","+","+    let next = (leader + 1) % tcs.len();","+    transfer_leader(&tcs, &addresses, leader, next).await?;","+    wait_for_watch_on(&tcs, next).await?;","+","+    writer.upsert_kv(UpsertKV::update(\"pp/a\", b\"a2\")).await?;","+    for _ in 0..100 {","+        let got = cache.try_get_ready(\"pp/a\").map(|v| v.data);","+        if got.as_deref() == Some(b\"a2\".as_slice()) {","+            return Ok(());","+        }","+        sleep(Duration::from_millis(50)).await;","+    }","+    anyhow::bail!(\"the cache did not see the change made after the leadership moved\")","+}"],"additions":136,"deletions":0,"truncated":false},{"path":"src/meta/plugins/cache/tests/it/main.rs","lines":["@@ -13,3 +13,5 @@"," // limitations under the License."," "," mod grpc_cache;","+mod leader;","+mod ready_reads;"],"additions":2,"deletions":0,"truncated":false},{"path":"src/meta/plugins/cache/tests/it/ready_reads.rs","lines":["@@ -0,0 +1,186 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+//! `Cache::try_get_ready` and `Cache::try_list_dir_ready`: which reads a ready copy answers, and","+//! which it leaves to meta-service.","+","+use std::time::Duration;","+","+use databend_meta_client::DEFAULT_GRPC_MESSAGE_SIZE;","+use databend_meta_client::MetaGrpcClient;","+use databend_meta_client::types::SeqV;","+use databend_meta_client::types::UpsertKV;","+use databend_meta_plugin_cache::Cache;","+use databend_meta_runtime::DatabendRuntime;","+use databend_meta_test_harness::meta_service_test_harness;","+use databend_meta_test_harness::start_metasrv_cluster;","+use futures::FutureExt;","+use test_harness::test;","+use tokio::net::TcpListener;","+use tokio::time::sleep;","+","+/// Wait until the copy answers `key`, with the value `want`.","+async fn wait_for(cache: &Cache, key: &str, want: &[u8]) -> anyhow::Result<()> {","+    for _ in 0..100 {","+        if data(cache.try_get_ready(key)).as_deref() == Some(want) {","+            return Ok(());","+        }","+        sleep(Duration::from_millis(50)).await;","+    }","+    anyhow::bail!(\"the copy did not answer {key} = {want:?}\")","+}","+","+fn data(value: Option<SeqV>) -> Option<Vec<u8>> {","+    value.map(|v| v.data)","+}","+","+fn listed(items: Option<Vec<(String, SeqV)>>) -> Option<Vec<(String, Vec<u8>)>> {","+    items.map(|items| items.into_iter().map(|(k, v)| (k, v.data)).collect())"],"additions":49,"deletions":0,"truncated":false}],"additions":469,"deletions":64,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-18T16:52:03.495975+00:00"}