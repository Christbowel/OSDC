{"id":"149c04b2cf39e7014e2200da54add4c96a134e8b","axis":"silent","repo":"pnpm/pnpm","sha":"149c04b2cf39e7014e2200da54add4c96a134e8b","parsed":{"files":[{"path":".changeset/pnpr-audit-actor-ids.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+pnpr audit records now carry `actor_id`, the account ID of whoever performed the action, which stays the same when the account is renamed. Sign-ins, failed logins, workload credential use, token creation and revocation, and publishes are now audited as `auth.sign_in`, `auth.login_failed`, `auth.workload_use`, `token.create`, `token.revoke`, and `package.publish`. Version and publication note events now name the actor by account name, and every event about another account names it with both `user` and `user_id`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/archive_gc.rs","lines":["@@ -140,7 +140,7 @@ impl Collection<'_> {","         let ids = unmapped.keys().cloned().collect();","         let removed = self.storage.reclaim_blobs_with(ids, |blob| {","             let size = unmapped.get(&blob.id).map_or(0, |row| row.size);","-            tracing::info!(target: \"pnpr::audit\", action = \"gc.remove_archive\", actor = \"-\", key = %blob.key(), size, \"removed archive\");","+            crate::audit!(crate::audit::Actor::NONE, \"gc.remove_archive\", key = %blob.key(), size, \"removed archive\");","         })","         .await?;","         Ok(report_of(&removed, |blob| unmapped.get(&blob.id).map_or(0, |row| row.size)))"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/archive_gc/images.rs","lines":["@@ -61,7 +61,7 @@ impl Collection<'_> {","             scan.unreachable,","             |blob| {","                 let size = rows.get(&blob.id).map_or(0, |row| row.size);","-                tracing::info!(target: \"pnpr::audit\", action = \"gc.remove_archive\", actor = \"-\", key = %blob.key(), size, repository = %name, \"removed archive\");","+                crate::audit!(crate::audit::Actor::NONE, \"gc.remove_archive\", key = %blob.key(), size, repository = %name, \"removed archive\");","             },","         );","         // A repository that moved on since it was read is left for a later"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/audit.rs","lines":["@@ -0,0 +1,43 @@","+//! Records under the `pnpr::audit` tracing target. Their actions and fields","+//! are an operator-facing contract, listed in `pnpr/docs/configuration.md`.","+","+/// Who performed an audited action. `id` stays the same when the account is","+/// renamed, so it is what attributes an action. `name` is the account's","+/// name at the time of the action.","+#[derive(Debug, Clone, Copy)]","+pub(crate) struct Actor<'a> {","+    pub(crate) id: &'a str,","+    pub(crate) name: &'a str,","+}","+","+impl<'a> Actor<'a> {","+    /// No account: an unauthenticated caller, or pnpr itself.","+    pub(crate) const NONE: Actor<'static> = Actor { id: \"-\", name: \"-\" };","+","+    /// The SCIM client, which authenticates with the SCIM token.","+    pub(crate) const SCIM: Actor<'static> = Actor { id: \"-\", name: \"scim\" };","+","+    pub(crate) fn of(identity: &'a pnpr_policy::Identity) -> Self {","+        match (identity.user_id(), identity.username()) {","+            (Some(id), Some(name)) => Actor { id, name },","+            _ => Actor::NONE,","+        }","+    }","+}","+","+/// Emit an audit record of `action` by `actor`, an [`Actor`], with the","+/// action's own fields and message, as `tracing::info!` takes them.","+#[doc(hidden)]","+#[macro_export]","+macro_rules! audit {","+    ($actor:expr, $action:expr, $($fields:tt)+) => {{","+        let actor: $crate::audit::Actor<'_> = $actor;","+        ::tracing::info!(","+            target: \"pnpr::audit\",","+            action = $action,","+            actor = actor.name,","+            actor_id = actor.id,","+            $($fields)+","+        )","+    }};","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/lib.rs","lines":["@@ -48,6 +48,7 @@ pub use server::{","     try_router, try_router_with_auth,"," };"," ","+mod audit;"," mod config_validation;"," mod resolver;"," mod server;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/authentication.rs","lines":["@@ -1,4 +1,4 @@","-pub(super) use accounts::require_active_account;","+pub(super) use accounts::active_account_name;"," pub(super) use credentials::token_credentials;"," pub(super) use package_access::{","     AuthorizationDecision, Ownership, allows_with_ownership, authorize,","@@ -10,7 +10,7 @@ mod accounts;"," mod credentials;"," mod package_access;"," ","-use accounts::{account_identity, active_account_name};","+use accounts::account_identity;"," "," use std::net::IpAddr;"," ","@@ -341,7 +341,16 @@ async fn resolve_caller(","                 })?;","             super::oidc::check_workload_request(&workload, method, path)?;","             let scope = WorkloadScope::new(&state.inner.config, &workload);","-            return Ok((account_identity(state, &workload.identity.user_id).await?, Some(scope)));","+            let identity = account_identity(state, &workload.identity.user_id).await?;","+            let actor = crate::audit::Actor::of(&identity);","+            crate::audit!(","+                actor,","+                \"auth.workload_use\",","+                subject = %workload.identity.subject,","+                registry = %workload.registry,","+                \"workload credentials used\",","+            );","+            return Ok((identity, Some(scope)));","         }","         if let Some(record) = state.inner.identity.auth.tokens.lookup_record(&raw_token).await? {","             check_token_restrictions(&record, method, path, client_ip)?;"],"additions":12,"deletions":3,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/authentication/accounts.rs","lines":["@@ -1,13 +1,