{"id":"f1e6e43a45209ba8ace49e0738a912c59153e3ff","axis":"silent","repo":"pnpm/pnpm","sha":"f1e6e43a45209ba8ace49e0738a912c59153e3ff","parsed":{"files":[{"path":".changeset/relative-workspace-peer-path.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` now resolves auto-installed relative `workspace:` peers from the directory of the package that declares them [pnpm/pnpm#17676](https://github.com/pnpm/pnpm/issues/17676)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/inject_workspace_packages.rs","lines":["@@ -11,6 +11,7 @@"," "," mod catalogs;"," mod hardlink_refresh;","+mod relative_peers;"," "," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/inject_workspace_packages/relative_peers.rs","lines":["@@ -0,0 +1,182 @@","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::CommandTempCwd;","+use serde_json::json;","+use std::{fs, process::Command};","+","+#[test]","+fn relative_workspace_peer_is_auto_installed_from_its_declaring_directory() {","+    struct Case {","+        also_dependency: bool,","+        explicit_provider: bool,","+        peer_specifier: &'static str,","+    }","+    for Case {","+        also_dependency,","+        explicit_provider,","+        peer_specifier,","+    } in [","+        Case {","+            also_dependency: false,","+            explicit_provider: false,","+            peer_specifier: \"workspace:../provider\",","+        },","+        Case {","+            also_dependency: true,","+            explicit_provider: false,","+            peer_specifier: \"workspace:../provider\",","+        },","+        Case {","+            also_dependency: true,","+            explicit_provider: true,","+            peer_specifier: \"workspace:../provider\",","+        },","+        Case {","+            also_dependency: true,","+            explicit_provider: false,","+            peer_specifier: r\"workspace:..\\provider\",","+        },","+    ] {","+        let CommandTempCwd { mut pacquet, root, workspace, .. } = CommandTempCwd::init();","+        let mut library = json!({","+            \"name\": \"library\", \"version\": \"1.0.0\",","+            \"peerDependencies\": { \"provider\": peer_specifier },","+        });","+        if also_dependency {","+            library[\"dependencies\"] = json!({ \"provider\": \"workspace:../provider\" });","+        }","+        let mut consumer_manifest = json!({","+            \"name\": \"consumer\", \"version\": \"1.0.0\", \"dependencies\": {","+                \"library\": \"workspace:../packages/library\",","+            },","+        });","+        if explicit_provider {","+            consumer_manifest[\"dependencies\"][\"provider\"] = json!(\"workspace:../packages/provider\");","+        }","+        for (dir, manifest, source) in [","+            (\"examples\", consumer_manifest, \"module.exports = require('library');\"),","+            (\"packages/library\", library, \"module.exports = require('provider');\"),","+            (","+                \"packages/provider\",","+                json!({ \"name\": \"provider\", \"version\": \"1.0.0\" }),","+                \"module.exports = 'local-provider';\",","+            ),","+        ] {","+            let project = workspace.join(dir);","+            fs::create_dir_all(&project).unwrap();","+            fs::write(project.join(\"package.json\"), manifest.to_string()).unwrap();","+            fs::write(project.join(\"index.js\"), source).unwrap();","+            fs::write(","+            project.join(\"pnpm-workspace.yaml\"),","+            \"packages: []\\nsharedWorkspaceLockfile: false\\ninjectWorkspacePackages: true\\nignoreScripts: true\\n\",","+        )","+        .unwrap();","+        }","+        let consumer = workspace.join(\"examples\");","+        pacquet","+            .current_dir(&consumer)","+            .args([\"install\", \"--offline\", \"--ignore-scripts\", \"--store-dir\"])","+            .arg(root.path().join(\"store\"));","+        pacquet","+            .args([","+                \"--lockfile-only\",","+                \"--no-frozen-lockfile\",","+                \"--config.preferFrozenLockfile=false\",","+            ])","+            .assert()","+            .success();","+        let lockfile_path = consumer.join(\"pnpm-lock.yaml\");","+        let lockfile = fs::read_to_string(&lockfile_path).unwrap();","+        assert!(lockfile.contains(peer_specifier), \"{lockfile}\");","+        super::pnpm_in(&consumer)","+            .with_args([","+                \"install\",","+                \"--offline\",","+                \"--ignore-scripts\",","+                \"--frozen-lockfile\",","+                \"--store-dir\",","+            ])","+            .with_arg(root.path().join(\"store\"))","+            .assert()","+            .success();","+        Command::new(\"node\")","+            .with_current_dir(&consumer)","+            .with_args([\"-p\", \"require('library')\"])","+            .assert()","+            .success()","+            .stdout(\"local-provider\\n\");","+        assert_eq!(fs::read_to_string(lockfile_path).unwrap(), lockfile);","+    }","+}","+","+#[test]","+fn relative_workspace_peer_uses_each_importers_directory_when_discovery_is_cached() {","+    for shared_lockfile in [true, false] {","+        let CommandTempCwd { mut pacquet, root, workspace, .. } = CommandTempCwd::init();","+        fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        format!(","+            \"packages:\\n  - 'packages/*'\\n  - 'apps/*'\\n  - 'apps/nested/*'\\nsharedWorkspaceLockfile: {shared_lockfile}\\ninjectWorkspacePackages: true\\ndedupeInjectedDeps: false\\nresolvePeersFromWorkspaceRoot: false\\nignoreScripts: true\\n\",","+        ),","+    )","+    .unwrap();","+        for (dir, manifest, source) in [","+            (","+                \"packages/provider\",","+                json!({ \"name\": \"provider\", \"version\": \"1.0.0\" }),","+                \"module.exports = 'local-provider';\",","+            ),","+            (","+                \"packages/library\",","+                json!({ \"name\": \"library\", \"version\": \"1.0.0\", \"peerDependencies\": {","+                \"provider\": \"workspace:../provider\",","+            } }),","+                \"module.exports = require('provider');\",","+            ),","+            (","+                \"packages/bridge\",","+                json!({ \"name\": \"bridge\", \"version\": \"1.0.0\", \"dependencies\": {","+                \"library\": \"workspace:../library\",","+            } }),","+                \"module.exports = require('library');\",","+            ),","+            (","+                \"apps/first\",","+                json!({ \"name\": \"first\", \"version\": \"1.0.0\", \"dependencies\": {","+                \"bridge\": \"workspace:*\", \"library\": \"workspace:*\",","+            } }),","+                \"module.exports = require('bridge');\",","+            ),","+            (","+                \"apps/nested/second\",","+                json!({ \"name\": \"second\", \"version\": \"1.0.0\", \"dependencies\": {","+                \"bridge\": \"workspace:*\", \"library\": \"workspace:*\",","+            } }),","+                \"module.exports = require('bridge');\",","+            ),","+        ] {","+            let project = workspace.join(dir);","+            fs::create_dir_all(&project).unwrap();","+            fs::write(project.join(\"package.json\"), manifest.to_string()).unwrap();","+            fs::write(project.join(\"index.js\"), source).unwrap();","+        }","+        pacquet","+            .args([\"install\", \"--offline\", \"--store-dir\"])","+            .arg(root.path().join(\"store\"));","+        pacquet.assert().success();","+        pacquet","+            .with_arg(\"--frozen-lockfile\")","+            .assert()","+            .success();","+        for consumer in [\"apps/first\", \"apps/nested/second\"] {","+            for dependency in [\"bridge\", \"library\"] {","+                Command::new(\"node\")","+                    .with_current_dir(workspace.join(consumer))","+                    .with_args([\"-p\", &format!(\"require('{dependency}')\")])","+                    .assert()","+                    .success()","+                    .stdout(\"local-provider\\n\");","+            }","+        }","+    }","+}"],"additions":182,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree.rs","lines":["@@ -7,6 +7,7 @@ pub use update_scope::{UpdateDepth, UpdateReuseScope, UpdateTargets, VersionLine"," pub use reuse::real_package_name_of;"," "," pub use tree_ctx::TreeCtx;","+pub(crate) use tree_ctx::declaring_manifest_dir;"," "," pub use workspace_ctx::WorkspaceTreeCtx;"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/tree_ctx.rs","lines":["@@ -63,8 +63,8 @@ pub(super) fn project_relative_cache_scope("," /// (the local resolver). Nothing asks for a linked node's directory:"," /// a linked project resolves its own dependencies as a separate"," /// importer, so the walk never descends into one.","-pub(super) fn declaring_manifest_dir(","-    ctx: &TreeCtx,","+pub(crate) fn declaring_manifest_dir(","+    lockfile_dir: &Path,","     result: &pnpm_resolving_resolver_base::ResolveResult,"," ) -> Option<Arc<Path>> {","     let pnpm_lockfile::LockfileResolution::Directory(resolution) = &result.resolution else {","@@ -77,7 +77,7 @@ pub(super) fn declaring_manifest_dir(","     let absolute = if directory.is_absolute() {","         pnpm_fs::lexical_normalize(directory)","     } else {","-        pnpm_fs::lexical_normalize(&ctx.importer.lockfile_dir.join(directory))","+        pnpm_fs::lexical_normalize(&lockfile_dir