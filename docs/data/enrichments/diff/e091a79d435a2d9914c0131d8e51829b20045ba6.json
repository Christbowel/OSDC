""," #include \"duckdb/optimizer/remove_unused_columns.hpp\""," #include \"duckdb/optimizer/row_group_pruner.hpp\""," #include \"duckdb/optimizer/rule/distinct_aggregate_optimizer.hpp\"","@@ -378,6 +379,11 @@ void Optimizer::RunBuiltInOptimizers() {"," \t\tplan = join_elimination.Optimize(std::move(plan));"," \t});"," ","+\tRunOptimizer(OptimizerType::REDUNDANT_ORDER_KEYS, [&]() {","+\t\tRemoveRedundantOrderKeys remove_redundant_order_keys;","+\t\tremove_redundant_order_keys.Optimize(*plan);","+\t});","+"," \t// rewrites UNNESTs in DelimJoins by moving them to the projection"," \tRunOptimizer(OptimizerType::UNNEST_REWRITER, [&]() {"," \t\tUnnestRewriter unnest_rewriter;"],"additions":6,"deletions":0,"truncated":false},{"path":"src/optimizer/remove_redundant_order_keys.cpp","lines":["@@ -0,0 +1,232 @@","+#include \"duckdb/optimizer/remove_redundant_order_keys.hpp\"","+","+#include \"duckdb/catalog/catalog_entry/table_catalog_entry.hpp\"","+#include \"duckdb/common/algorithm.hpp\"","+#include \"duckdb/parser/constraints/not_null_constraint.hpp\"","+#include \"duckdb/parser/constraints/unique_constraint.hpp\"","+#include \"duckdb/planner/column_binding_map.hpp\"","+#include \"duckdb/planner/expression/bound_columnref_expression.hpp\"","+#include \"duckdb/planner/operator/logical_aggregate.hpp\"","+#include \"duckdb/planner/operator/logical_distinct.hpp\"","+#include \"duckdb/planner/operator/logical_get.hpp\"","+#include \"duckdb/planner/operator/logical_order.hpp\"","+#include \"duckdb/planner/operator/logical_projection.hpp\"","+","+namespace duckdb {","+","+namespace {","+","+class ApplyFunctionalDependencies : public LogicalOperatorVisitor {","+public:","+\tApplyFunctionalDependencies() {","+\t}","+","+\tvoid VisitOperator(LogicalOperator &op) override;","+","+private:","+\tvoid VisitLogicalGet(LogicalGet &get);","+\tvoid VisitLogicalAggregate(LogicalAggregate &aggr);","+\tvoid VisitLogicalDistinct(LogicalDistinct &distinct);","+\tvoid VisitLogicalProjection(LogicalProjection &projection);","+\tvoid VisitLogicalOrder(LogicalOrder &order);","+","+\tvector<column_binding_set_t> result;","+};","+","+void ApplyFunctionalDependencies::VisitLogicalGet(LogicalGet &get) {","+\tVisitOperatorChildren(get);","+","+\tauto table = get.GetTable();","+\tif (!table || !table->IsDuckTable() || !get.projected_input.empty() || get.GetColumnIds().empty()) {","+\t\treturn;","+\t}","+\tunordered_map<idx_t, ColumnBinding> column_bindings;","+\tfor (auto &binding : get.GetColumnBindings()) {","+\t\tauto &column_index = get.GetColumnIndex(binding);","+\t\tif (!column_index.HasPrimaryIndex() || column_index.HasChildren() || column_index.IsVirtualColumn()) {","+\t\t\tcontinue;","+\t\t}","+\t\tcolumn_bindings.emplace(column_index.GetPrimaryIndex(), binding);","+\t}","+\tauto &columns = table->GetColumns();","+\tauto &constraints = table->GetConstraints();","+\tunordered_set<idx_t> not_null_columns;","+\tfor (auto &constraint : constraints) {","+\t\tif (constraint->type == ConstraintType::NOT_NULL) {","+\t\t\tnot_null_columns.insert(constraint->Cast<NotNullConstraint>().index.index);","+\t\t}","+\t}","+\tfor (auto &constraint : constraints) {","+\t\tif (constraint->type != ConstraintType::UNIQUE) {","+\t\t\tcontinue;","+\t\t}","+\t\tauto &unique = constraint->Cast<UniqueConstraint>();","+\t\tauto &names = unique.GetColumnNames();","+\t\tif (!unique.HasIndex() && !std::all_of(names.begin(), names.end(),","+\t\t                                       [&](const Identifier &name) { return columns.ColumnExists(name); })) {","+\t\t\tcontinue;","+\t\t}","+\t\tcolumn_binding_set_t key;","+\t\tbool usable = true;","+\t\tfor (auto &column : unique.GetLogicalIndexes(columns)) {","+\t\t\tauto entry = column_bindings.find(column.index);","+\t\t\tif (entry == column_bindings.end() ||","+\t\t\t    (!unique.IsPrimaryKey() && not_null_columns.find(column.index) == not_null_columns.end())) {","+\t\t\t\tusable = false;","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\tkey.insert(entry->second);","+\t\t}","+\t\tif (usable && !key.empty()) {","+\t\t\tresult.push_back(std::move(key));","+\t\t}","+\t}","+}","+","+void ApplyFunctionalDependencies::VisitLogicalAggregate(LogicalAggregate &aggr) {","+\tVisitOperatorChildren(aggr);","+","+\t//\tTODO: use child FDs to simplify groupings.","+\tresult.clear();","+","+\tif (aggr.groups.empty() || aggr.grouping_sets.size() > 1 || !aggr.grouping_functions.empty()) {","+\t\treturn;","+\t}","+\tcolumn_binding_set_t key;","+\tif (aggr.grouping_sets.empty()) {","+\t\tfor (auto group_idx : ProjectionIndex::GetIndexes(aggr.groups.size())) {","+\t\t\tkey.insert(ColumnBinding(aggr.group_index, group_idx));","+\t\t}","+\t} else {","+\t\tfor (auto group_idx : aggr.grouping_sets[0]) {","+\t\t\tif (group_idx.GetIndex() >= aggr.groups.size()) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tkey.insert(ColumnBinding(aggr.group_index, group_idx));","+\t\t}","+\t}","+\tif (!key.empty()) {","+\t\tresult.push_back(std::move(key));","+\t}","+}","+","+void ApplyFunctionalDependencies::VisitLogicalDistinct(LogicalDistinct &distinct) {","+\tVisitOperatorChildren(distinct);","+","+\t//\tTODO: use child FDs to simplify groupings.","+\tresult.clear();","+","+\tcolumn_binding_set_t key;","+\tbool all_columns = true;","+\tfor (auto &target : distinct.distinct_targets) {","+\t\tif (target->GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {","+\t\t\tall_columns = false;","+\t\t\tbreak;","+\t\t}","+\t\tkey.insert(target->Cast<BoundColumnRefExpression>().Binding());","+\t}","+\tif (all_columns && !key.empty()) {","+\t\tresult.push_back(std::move(key));","+\t}","+}","+","+void ApplyFunctionalDependencies::VisitLogicalProjection(LogicalProjection &projection) {","+\tVisitOperatorChildren(projection);","+","+\tvector<column_binding_set_t> child_sets;","+\tchild_sets.swap(result);","+\tif (child_sets.empty()) {","+\t\treturn;","+\t}","+\tcolumn_binding_map_t<ColumnBinding> forwarded;","+\tfor (auto expr_idx : ProjectionIndex::GetIndexes(projection.expressions.size())) {","+\t\tauto &expr = *projection.expressions[expr_idx];","+\t\tif (expr.GetExpressionType() == ExpressionType::BOUND_COLUMN_REF) {","+\t\t\tforwarded.emplace(expr.Cast<BoundColumnRefExpression>().Binding(),","+\t\t\t                  ColumnBinding(projection.table_index, expr_idx));","+\t\t}","+\t}","+\tfor (auto &child_set : child_sets) {","+\t\tcolumn_binding_set_t key;","+\t\tbool complete = true;","+\t\tfor (auto &binding : child_set) {","+\t\t\tauto entry = forwarded.find(binding);","+\t\t\tif (entry == forwarded.end()) {","+\t\t\t\tcomplete = false;","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\tkey.insert(entry->second);","+\t\t}","+\t\tif (complete) {","+\t\t\tresult.push_back(std::move(key));","+\t\t}","+\t}","+}","+","+void ApplyFunctionalDependencies::VisitLogicalOrder(LogicalOrder &order) {","+\tVisitOperatorChildren(order);","+","+\tif (order.orders.size() < 2 || result.empty()) {","+\t\treturn;","+\t}","+\tcolumn_binding_set_t prefix;","+\tfor (idx_t i = 0; i + 1 < order.orders.size(); i++) {","+\t\tauto &expr = *order.orders[i].expression;","+\t\tif (expr.GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {","+\t\t\tcontinue;","+\t\t}","+\t\tprefix.insert(expr.Cast<BoundColumnRefExpression>().Binding());","+\t\tfor (auto &unique_set : result) {","+\t\t\tbool covered = true;","+\t\t\tfor (auto &binding : unique_set) {","+\t\t\t\tif (prefix.find(binding) == prefix.end()) {","+\t\t\t\t\tcovered = false;","+\t\t\t\t\tbreak;","+\t\t\t\t}","+\t\t\t}","+\t\t\tif (!covered) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\torder.orders.erase(order.orders.begin() + NumericCast<int64_t>(i + 1), order.orders.end());","+\t\t\treturn;","+\t\t}","+\t}","+}","+","+void ApplyFunctionalDependencies::VisitOperator(LogicalOperator &op) {","+\tswitch (op.type) {","+\tcase LogicalOperatorType::LOGICAL_ORDER_BY:","+\t\tVisitLogicalOrder(op.Cast<LogicalOrder>());","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_FILTER:","+\tcase LogicalOperatorType::LOGICAL_LIMIT:","+\t\tVisitOperatorChildren(op);","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_PROJECTION:","+\t\tVisitLogicalProjection(op.Cast<LogicalProjection>());","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_GET:","+\t\tVisitLogicalGet(op.Cast<LogicalGet>());","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY:","+\t\tVisitLogicalAggregate(op.Cast<LogicalAggregate>());","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_DISTINCT:","+\t\tVisitLogicalDistinct(op.Cast<LogicalDistinct>());","+\t\tbreak;","+\tdefault:","+\t\tVisitOperatorChildren(op);","+\t\t//\tClear the keys because we don't know if the operator preserves them.","+\t\tresult.clear();","+\t\tbreak;","+\t}","+}","+","+} // namespace","+","+void RemoveRedundantOrderKeys::Optimize(LogicalOperator &op) {","+\tApplyFunctionalDependencies visitor;","+\tvisitor.VisitOperator(op);","+}","+","+} // namespace duckdb"],"additions":232,"deletions":0,"truncated":false},{"path":"test/configs/disable_optimizer.json","lines":["@@ -65,7 +65,8 @@","         \"test/sql/types/geo/geometry_vertex_extract.test\",","         \"test/sql/copy/parquet/parquet_glob_cache.test\",","         \"test/optimizer/joins/fkpk_composite_key_ce.test\",","-        \"test/sql/cast/signed_cast_repro.test\"","+        \"test/sql/cast/signed_cast_repro.test\",","+        \"test/optimizer/remove_redundant_order_keys_side_effects.test\"","       ]","     },","     {"],"additions":2,"deletions":1,"truncated":false},{"path":"test/configs/variant_order_verification.json","lines":["@@ -46,7 +46,14 @@","       \"paths\": [","         \"test/sql/topn/test_top_n_nulls_row_group_pruner_extensive.test\",","         \"test/sql/topn/top_n_pruning.test\",","-        \"test/sql/topn/topn_nulls_first.test\"","+        \"test/sql/topn/topn_nulls_first.test\",","+        \"test/optimizer/remove_redundant_order_keys.test\"","+      ]","+    },","+    {","+      \"reason\": \"Casting the ORDER BY expressions to VARIANT keeps them out of the redundant ORDER BY key optimizer's reach, so the trailing key this test expects to be erased is evaluated and raises.\",","+      \"paths\": [","+        \"test/optimizer/remove_redundant_order_keys_side_effects.test\"","       ]","     }","   ]"],"additions":8,"deletions":1,"truncated":false},{"path":"test/optimizer/remove_redundant_order_keys.test","lines":["@@ -0,0 +1,161 @@","+# name: test/optimizer/remove_redundant_order_keys.test","+# description: ORDER BY keys that follow a unique prefix are removed (issue #24000)","+# group: [optimizer]","+","+statement ok","+CREATE TABLE t(id INTEGER PRIMARY KEY, payload VARCHAR, grp INTEGER);","+","+statement ok","+INSERT INTO t VALUES (3, 'c', 1), (1, 'a', 2), (2, NULL, 1), (5, 'a', NULL), (4, 'b', 2);","+","+# a primary key prefix erases the keys behind it, through the filter and the limit around it","+query II","+EXPLAIN SELECT id FROM t WHERE id + grp > 0 ORDER BY id, payload LIMIT 2;","+----","+physical_plan\t<REGEX>:.*Order By: id ASC +│.*","+","+# the freed column is pruned by the later passes, so the pass has to run before them","+query II","+EXPLAIN SELECT id FROM t ORDER BY id, payload;","+----","+physical_plan\t<!REGEX>:.*payload.*","+","+query I","+SELECT id FROM t ORDER BY id DESC, payload LIMIT 2 OFFSET 1;","+----","+4","+3","+","+query II","+SELECT id, payload FROM t ORDER BY id DESC NULLS FIRST, payload ASC NULLS LAST, grp DESC;","+----","+5\ta","+4\tb","+3\tc","+2\tNULL","+1\ta","+","+# keys before the unique prefix stay","+query II","+EXPLAIN SELECT id FROM t ORDER BY payload, id, grp;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*id ASC +│.*","+","+query II","+SELECT payload, id FROM t ORDER BY payload NULLS FIRST, id DESC, grp;","+----","+NULL\t2","+a\t5","+a\t1","+b\t4","+c\t3","+","+# an expression over the unique column is not the unique column","+query II","+EXPLAIN SELECT CAST(id AS BOOLEAN) AS b, payload FROM t ORDER BY b, payload;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+# a join duplicates the unique column","+query II","+EXPLAIN SELECT t.id FROM t JOIN t AS t2 ON t.grp = t2.grp ORDER BY t.id, t2.payload;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+# UNIQUE only counts when it cannot hold NULLs, and only uncollated","+statement ok","+CREATE TABLE u(ukey INTEGER UNIQUE, skey VARCHAR UNIQUE NOT NULL, tiebreak INTEGER);","+","+statement ok","+INSERT INTO u VALUES (NULL, 'A', 2), (NULL, 'a', 1), (1, 'b', 3);","+","+query II","+EXPLAIN SELECT ukey FROM u ORDER BY ukey, tiebreak;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+query II","+EXPLAIN SELECT skey FROM u ORDER BY skey, tiebreak;","+----","+physical_plan\t<REGEX>:.*Order By: skey ASC +│.*","+","+query II","+EXPLAIN SELECT skey FROM u ORDER BY skey COLLATE NOCASE, tiebreak;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+# every column of a composite key has to be in the prefix","+statement ok","+CREATE TABLE c(k1 INTEGER, k2 INTEGER, tiebreak INTEGER, PRIMARY KEY (k1, k2));","+","+statement ok","+INSERT INTO c VALUES (1, 2, 1), (1, 1, 2), (2, 1, 3);","+","+query II","+EXPLAIN SELECT k1 FROM c ORDER BY k1, tiebreak;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+query II","+EXPLAIN SELECT k1 FROM c ORDER BY k2, k1, tiebreak;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, k1 ASC +│.*","+","+# a GROUP BY makes its groups unique","+query II","+EXPLAIN SELECT grp FROM t GROUP BY grp ORDER BY grp, count(*);","+----","+physical_plan\t<REGEX>:.*Order By: grp ASC +│.*","+","+# and the freed aggregate is eliminated too","+query II","+EXPLAIN SELECT grp FROM t GROUP BY grp ORDER BY grp, count(*);","+----","+physical_plan\t<!REGEX>:.*count_star.*","+","+# one grouping set is a GROUP BY, more than one is not","+statement ok","+SET disabled_optimizers = 'grouping_sets';","+","+query II","+EXPLAIN SELECT grp FROM t GROUP BY GROUPING SETS ((grp)) ORDER BY grp, count(*);","+----","+physical_plan\t<REGEX>:.*Order By: grp ASC +│.*","+","+query II","+EXPLAIN SELECT grp FROM t GROUP BY GROUPING SETS ((grp), ()) ORDER BY grp, count(*);","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+statement ok","+RESET disabled_optimizers;","+","+# DISTINCT ON makes its targets unique, unless a target is not a plain column","+query II","+EXPLAIN SELECT DISTINCT ON (grp) grp, id FROM t ORDER BY grp, id;","+----","+physical_plan\t<REGEX>:.*Order By: grp ASC +│.*","+","+query II","+SELECT DISTINCT ON (grp) grp, id FROM t ORDER BY grp NULLS FIRST, id DESC;","+----","+NULL\t5","+1\t3","+2\t4","+","+query II","+EXPLAIN SELECT DISTINCT ON (grp, payload COLLATE NOCASE) grp, payload, id FROM t ORDER BY grp, id;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+# disabled optimizer","+statement ok","+SET disabled_optimizers = 'redundant_order_keys';","+","+query II","+EXPLAIN SELECT id FROM t ORDER BY id, payload;","+----","+physical_plan\t<REGEX>:.*Order By: [^\\n]*, [^\\n]*│.*","+","+statement ok","+RESET disabled_optimizers;"],"additions":161,"deletions":0,"truncated":false},{"path":"test/optimizer/remove_redundant_order_keys_side_effects.test","lines":["@@ -0,0 +1,67 @@","+# name: test/optimizer/remove_redundant_order_keys_side_effects.test","+# description: dropped ORDER BY keys take their errors and side effects with them (issue #24000)","+# group: [optimizer]","+","+statement ok","+CREATE TABLE t(id INTEGER PRIMARY KEY, payload VARCHAR, grp INTEGER);","+","+statement ok","+INSERT INTO t VALUES (3, 'c', 1), (1, 'a', 2), (2, NULL, 1), (5, 'a', NULL), (4, 'b', 2);","+","+statement ok","+CREATE SEQUENCE seq_elide START 1;","+","+# a dropped key never raises, and never runs its side effect","+query I","+SELECT count(*) FROM (SELECT id FROM t ORDER BY id, CAST(payload AS INTEGER)) q;","+----","+5","+","+query I","+SELECT count(*) FROM (SELECT id FROM t ORDER BY id, nextval('seq_elide')) q;","+----","+5","+","+query I","+SELECT last_value IS NULL FROM duckdb_sequences() WHERE sequence_name = 'seq_elide';","+----","+true","+","+# a key before the unique prefix is still evaluated","+statement ok","+CREATE SEQUENCE seq_keep START 1;","+","+query I","+SELECT count(*) FROM (SELECT id FROM t ORDER BY nextval('seq_keep'), id) q;","+----","+5","+","+query I","+SELECT last_value FROM duckdb_sequences() WHERE sequence_name = 'seq_keep';","+----","+5","+","+# without the optimizer that key does raise","+statement ok","+SET disabled_optimizers = 'redundant_order_keys';","+","+statement error","+SELECT count(*) FROM (SELECT id FROM t ORDER BY id, CAST(payload AS INTEGER)) q;","+----","+Conversion Error","+","+statement ok","+CREATE SEQUENCE seq_evaluated START 1;","+","+query I","+SELECT count(*) FROM (SELECT id FROM t ORDER BY id, nextval('seq_evaluated')) q;","+----","+5","+","+query I","+SELECT last_value FROM duckdb_sequences() WHERE sequence_name = 'seq_evaluated';","+----","+5","+","+statement ok","+RESET disabled_optimizers;",""],"additions":67,"deletions":0,"truncated":false}],"additions":504,"deletions":6,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-09-30T15:48:09.940328+00:00"}