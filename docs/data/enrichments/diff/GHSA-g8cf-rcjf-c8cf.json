{"id":"GHSA-g8cf-rcjf-c8cf","axis":"advisories","repo":"getkin/kin-openapi","sha":"9245cef66c840e27a08409a8a5cd0ee930c5bcff","parsed":{"files":[{"path":"openapi3/schema.go","lines":["@@ -1949,6 +1949,15 @@ func (schema *Schema) VisitJSON(value any, opts ...SchemaValidationOption) error"," }"," "," func (schema *Schema) visitJSON(settings *schemaValidationSettings, value any) (err error) {","+\tif settings.visitedSchemas == nil {","+\t\tsettings.visitedSchemas = make(map[*Schema]struct{})","+\t}","+\tif _, visited := settings.visitedSchemas[schema]; visited {","+\t\treturn nil","+\t}","+\tsettings.visitedSchemas[schema] = struct{}{}","+\tdefer delete(settings.visitedSchemas, schema)","+"," \tswitch value := value.(type) {"," \tcase nil:"," \t\t// Don't use VisitJSONNull, as we still want to reach 'visitXOFOperations', since"],"additions":9,"deletions":0,"truncated":false},{"path":"openapi3/schema_validation_settings.go","lines":["@@ -34,6 +34,10 @@ type schemaValidationSettings struct {"," \tstringFormats  map[string]StringFormatValidator"," \tnumberFormats  map[string]NumberFormatValidator"," \tintegerFormats map[string]IntegerFormatValidator","+","+\t// visitedSchemas provides pointer-identity cycle detection for runtime","+\t// validation, matching the stack-based detection in Schema.validate().","+\tvisitedSchemas map[*Schema]struct{}"," }"," "," // FailFast returns schema validation errors quicker."],"additions":4,"deletions":0,"truncated":false},{"path":"openapi3filter/circular_recursion_test.go","lines":["@@ -0,0 +1,77 @@","+package openapi3filter_test","+","+import (","+\t\"context\"","+\t\"net/http\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/getkin/kin-openapi/openapi3\"","+\t\"github.com/getkin/kin-openapi/openapi3filter\"","+\t\"github.com/getkin/kin-openapi/routers/gorillamux\"","+)","+","+// These tests cover a fatal stack overflow triggered by a schema whose","+// allOf/anyOf/oneOf chain refers back to itself. Both the spec loader and","+// Schema.validate() accept such schemas, but the runtime visitor","+// (Schema.visitJSON -> visitXOFOperations) and the request-decoding","+// recursion (openapi3filter.decodeValue) lacked cycle detection and","+// recursed until the goroutine stack was exhausted, aborting the process","+// with an unrecoverable runtime error. Both paths must now terminate","+// with a clean error instead.","+","+func TestCircularAllOf_VisitJSONNoCrash(t *testing.T) {","+\trecursive := &openapi3.Schema{","+\t\tType: &openapi3.Types{\"object\"},","+\t\tProperties: openapi3.Schemas{","+\t\t\t\"name\": {Value: &openapi3.Schema{Type: &openapi3.Types{\"string\"}}},","+\t\t},","+\t}","+\trecursive.AllOf = openapi3.SchemaRefs{{Value: recursive}}","+","+\trequire.NoError(t, recursive.Validate(context.Background()))","+\t_ = recursive.VisitJSON(map[string]any{\"name\": \"test\"})","+}","+","+const circularAllOfSpec = `","+openapi: 3.0.0","+info: {title: t, version: '1.0'}","+paths:","+  /q:","+    get:","+      parameters:","+        - name: data","+          in: query","+          schema: {$ref: '#/components/schemas/Recursive'}","+      responses: {\"200\": {description: OK}}","+components:","+  schemas:","+    Recursive:","+      type: object","+      allOf:","+        - $ref: '#/components/schemas/Recursive'","+      properties:","+        name: {type: string}","+`","+","+func TestCircularAllOf_DecodeValueNoCrash(t *testing.T) {","+\tloader := openapi3.NewLoader()","+\tdoc, err := loader.LoadFromData([]byte(circularAllOfSpec))","+\trequire.NoError(t, err)","+\trequire.NoError(t, doc.Validate(loader.Context))","+\trouter, err := gorillamux.NewRouter(doc)","+\trequire.NoError(t, err)","+","+\treq, err := http.NewRequest(http.MethodGet, \"/q?data=x\", strings.NewReader(\"\"))","+\trequire.NoError(t, err)","+\troute, pathParams, err := router.FindRoute(req)","+\trequire.NoError(t, err)","+","+\terr = openapi3filter.ValidateRequest(context.Background(), &openapi3filter.RequestValidationInput{","+\t\tRequest: req, PathParams: pathParams, Route: route,","+\t\tOptions: &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc},","+\t})","+\trequire.Error(t, err, \"must return a clean error, not crash\")","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"openapi3filter/req_resp_decoder.go","lines":["@@ -267,19 +267,29 @@ func decodeStyledParameter(param *openapi3.Parameter, input *RequestValidationIn"," \treturn decodeValue(dec, param.Name, sm, param.Schema, param.Required)"," }"," ","+var errCircularSchema = errors.New(\"circular schema reference detected while decoding\")","+"," func decodeValue(dec valueDecoder, param string, sm *openapi3.SerializationMethod, schema *openapi3.SchemaRef, required bool) (any, bool, error) {","+\treturn decodeValueGuarded(dec, param, sm, schema, required, nil)","+}","+","+func decodeValueGuarded(dec valueDecoder, param string, sm *openapi3.SerializationMethod, schema *openapi3.SchemaRef, required bool, seen []*openapi3.Schema) (any, bool, error) {"," \tvar found bool"," "," \tif schema == nil {"," \t\treturn nil, false, nil"," \t}","+\tif slices.Contains(seen, schema.Value) {","+\t\treturn nil, false, errCircularSchema","+\t}","+\tseen = append(seen, schema.Value)"," "," \tif len(schema.Value.AllOf) > 0 {"," \t\tvar value any"," \t\tvar err error"," \t\tfor _, sr := range schema.Value.AllOf {"," \t\t\tvar f bool","-\t\t\tvalue, f, err = decodeValue(dec, param, sm, sr, required)","+\t\t\tvalue, f, err = decodeValueGuarded(dec, param, sm, sr, required, seen)"," \t\t\tfound = found || f"," \t\t\tif value == nil || err != nil {"," \t\t\t\tbreak","@@ -290,7 +300,7 @@ func decodeValue(dec valueDecoder, param string, sm *openapi3.SerializationMetho"," "," \tif len(schema.Value.AnyOf) > 0 {"," \t\tfor _, sr := range schema.Value.AnyOf {","-\t\t\tvalue, f, _ := decodeValue(dec, param, sm, sr, required)","+\t\t\tvalue, f, _ := decodeValueGuarded(dec, param, sm, sr, required, seen)"," \t\t\tfound = found || f"," \t\t\tif value != nil {"," \t\t\t\treturn value, found, nil","@@ -306,7 +316,7 @@ func decodeValue(dec valueDecoder, param string, sm *openapi3.SerializationMetho"," \t\tisMatched := 0"," \t\tvar value any"," \t\tfor _, sr := range schema.Value.OneOf {","-\t\t\tv, f, _ := decodeValue(dec, param, sm, sr, required)","+\t\t\tv, f, _ := decodeValueGuarded(dec, param, sm, sr, required, seen)"," \t\t\tfound = found || f"," \t\t\tif v != nil {"," \t\t\t\tvalue = v",""],"additions":13,"deletions":3,"truncated":false}],"additions":103,"deletions":3,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-16T14:18:33.328992+00:00"}