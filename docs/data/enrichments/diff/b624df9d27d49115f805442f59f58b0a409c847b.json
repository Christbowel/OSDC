and/StaticHunt.php',","         'OCA\\\\Testing\\\\Controller\\\\ConfigController' => __DIR__ . '/..' . '/../lib/Controller/ConfigController.php',","         'OCA\\\\Testing\\\\Controller\\\\LockingController' => __DIR__ . '/..' . '/../lib/Controller/LockingController.php',"],"additions":1,"deletions":0,"truncated":false},{"path":"apps/testing/lib/Command/SetUnencryptedSize.php","lines":["@@ -0,0 +1,51 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+namespace OCA\\Testing\\Command;","+","+use OCP\\Files\\IRootFolder;","+use Symfony\\Component\\Console\\Command\\Command;","+use Symfony\\Component\\Console\\Input\\InputArgument;","+use Symfony\\Component\\Console\\Input\\InputInterface;","+use Symfony\\Component\\Console\\Output\\OutputInterface;","+","+/**","+ * Overwrite the unencrypted size stored in the file cache, e.g. to simulate","+ * file cache entries written by older versions.","+ */","+class SetUnencryptedSize extends Command {","+\tpublic function __construct(","+\t\tprivate IRootFolder $rootFolder,","+\t) {","+\t\tparent::__construct();","+\t}","+","+\t#[\\Override]","+\tprotected function configure(): void {","+\t\t$this","+\t\t\t->setName('testing:set-unencrypted-size')","+\t\t\t->setDescription('Overwrite the unencrypted size of a file in the file cache')","+\t\t\t->addArgument('user', InputArgument::REQUIRED, 'Owner of the file')","+\t\t\t->addArgument('path', InputArgument::REQUIRED, 'Path of the file relative to the home of the user')","+\t\t\t->addArgument('size', InputArgument::REQUIRED, 'Unencrypted size to store');","+\t}","+","+\t#[\\Override]","+\tprotected function execute(InputInterface $input, OutputInterface $output): int {","+\t\t$node = $this->rootFolder","+\t\t\t->getUserFolder($input->getArgument('user'))","+\t\t\t->get($input->getArgument('path'));","+","+\t\t$node->getStorage()->getCache()->update($node->getId(), [","+\t\t\t'unencrypted_size' => (int)$input->getArgument('size'),","+\t\t]);","+","+\t\treturn self::SUCCESS;","+\t}","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"build/integration/encryption_features/encryption.feature","lines":["@@ -52,6 +52,25 @@ Feature: encryption","     Then the HTTP status code should be \"200\"","     And Downloaded content should be \"the second content\""," ","+  # Files written by older versions use the base64 encoding and may have no","+  # unencrypted size in the file cache, so it has to be recalculated from the","+  # blocks of the file.","+  Scenario: Download a base64 encoded file with an unknown unencrypted size","+    Given invoking occ with \"config:system:set encryption.use_legacy_base64_encoding --value true --type boolean\"","+    And the command was successful","+    And user \"user0\" exists","+    And As an \"user0\"","+    And User \"user0\" adds a file of 20000 bytes to \"/legacy.bin\"","+    And invoking occ with \"config:system:delete encryption.use_legacy_base64_encoding\"","+    And the command was successful","+    And invoking occ with \"app:enable testing\"","+    And the command was successful","+    And invoking occ with \"testing:set-unencrypted-size user0 /legacy.bin 0\"","+    And the command was successful","+    When Downloading file \"/legacy.bin\"","+    Then the HTTP status code should be \"200\"","+    And File \"/legacy.bin\" should have prop \"d:getcontentlength\" equal to \"20000\"","+","   # With \"part_file_in_storage\" disabled the part file is written to the user","   # home while the target lives on another storage, so the upload has to read the","   # part file back to move it over. A part file never has a file cache entry, so"],"additions":19,"deletions":0,"truncated":false},{"path":"lib/private/Files/Storage/Wrapper/Encryption.php","lines":["@@ -476,6 +476,8 @@ protected function fixUnencryptedSize(string $path, int $size, int $unencryptedS"," \t\t\treturn 0;"," \t\t}"," ","+\t\t// the block size depends on the encoding the module reads from the header","+\t\t$encryptionModule->begin($this->getFullPath($path), $this->uid, 'r', $header, []);"," \t\t$signed = isset($header['signed']) && $header['signed'] === 'true';"," \t\t$unencryptedBlockSize = $encryptionModule->getUnencryptedBlockSize($signed);"," ","@@ -508,7 +510,6 @@ protected function fixUnencryptedSize(string $path, int $size, int $unencryptedS"," \t\tfclose($stream);"," "," \t\t// we have to decrypt the last chunk to get it actual size","-\t\t$encryptionModule->begin($this->getFullPath($path), $this->uid, 'r', $header, []);"," \t\t$decryptedLastChunk = $encryptionModule->decrypt($lastChunkContentEncrypted, $lastChunkNr . 'end');"," \t\t$decryptedLastChunk .= $encryptionModule->end($this->getFullPath($path), $lastChunkNr . 'end');"," "],"additions":2,"deletions":1,"truncated":false},{"path":"tests/lib/Files/Storage/Wrapper/EncryptionTest.php","lines":["@@ -608,6 +608,68 @@ public static function dataTestVerifyUnencryptedSize(): array {"," \t\t];"," \t}"," ","+\t/**","+\t * The unencrypted block size depends on the encoding stored in the file header,","+\t * which the encryption module only knows once begin() has read the header.","+\t */","+\tpublic function testFixUnencryptedSizeUsesBlockSizeOfFileEncoding(): void {","+\t\t$begun = false;","+\t\t$module = $this->createMock(IEncryptionModule::class);","+\t\t$module->method('begin')->willReturnCallback(function () use (&$begun) {","+\t\t\t$begun = true;","+\t\t\treturn [];","+\t\t});","+\t\t$module->method('getUnencryptedBlockSize')->willReturnCallback(function (bool $signed) use (&$begun) {","+\t\t\treturn $begun ? 6072 : 8096;","+\t\t});","+\t\t$module->method('decrypt')->willReturn(str_repeat('a', 42));","+\t\t$module->method('end')->willReturn('');","+","+\t\t$header = ['cipher' => 'AES-256-CTR', 'signed' => 'true', 'oc_encryption_module' => 'UNIT_TEST_MODULE'];","+\t\t$content = str_pad(Util::HEADER_START, $this->headerSize, '-') . str_repeat('x', 2 * 8192 + 100);","+\t\t$stream = fopen('php://memory', 'r+');","+\t\tfwrite($stream, $content);","+\t\trewind($stream);","+\t\t$cache = $this->createMock(ICache::class);","+\t\t$cache->method('get')->with('legacy.txt')->willReturn(['fileid' => 42]);","+\t\t$sourceStorage = $this->createMock(\\OC\\Files\\Storage\\Storage::class);","+\t\t$sourceStorage->method('fopen')->with('legacy.txt', 'r')->willReturn($stream);","+\t\t$sourceStorage->method('getCache')->willReturn($cache);","+","+\t\t$expected = 2 * 6072 + 42;","+\t\t$cache->expects($this->once())->method('update')->with(42, ['unencrypted_size' => $expected]);","+","+\t\t$instance = $this->getMockBuilder(Encryption::class)","+\t\t\t->setConstructorArgs(","+\t\t\t\t[","+\t\t\t\t\t[","+\t\t\t\t\t\t'storage' => $sourceStorage,","+\t\t\t\t\t\t'root' => 'foo',","+\t\t\t\t\t\t'mountPoint' => '/',","+\t\t\t\t\t\t'mount' => $this->mount","+\t\t\t\t\t],","+\t\t\t\t\t$this->encryptionManager,","+\t\t\t\t\t$this->util,","+\t\t\t\t\t$this->logger,","+\t\t\t\t\t$this->file,","+\t\t\t\t\tnull,","+\t\t\t\t\t$this->keyStore,","+\t\t\t\t\t$this->mountManager,","+\t\t\t\t\t$this->arrayCache,","+\t\t\t\t]","+\t\t\t)","+\t\t\t->onlyMethods(['getHeader', 'getHeaderSize', 'getEncryptionModule'])","+\t\t\t->getMock();","+\t\t$instance->method('getHeader')->willReturn($header);","+\t\t$instance->method('getHeaderSize')->willReturn($this->headerSize);","+\t\t$instance->method('getEncryptionModule')->willReturn($module);","+","+\t\t$this->assertEquals(","+\t\t\t$expected,","+\t\t\t$this->invokePrivate($instance, 'fixUnencryptedSize', ['legacy.txt', strlen($content), 0])","+\t\t);","+\t}","+"," \t/**"," \t *"," \t * @param string $source",""],"additions":62,"deletions":0,"truncated":false}],"additions":137,"deletions":1,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-13T15:28:56.638520+00:00"}