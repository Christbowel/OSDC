{"id":"53b8994d96ad5081f9884d5537a52f951015d6fe","axis":"silent","repo":"pytorch/pytorch","sha":"53b8994d96ad5081f9884d5537a52f951015d6fe","parsed":{"files":[{"path":"docs/source/user_guide/torch_compiler/torch.compiler_aot_inductor.md","lines":["@@ -190,6 +190,57 @@ Result from the second inference:"," [ CUDAFloatType{2,1} ]"," ```"," ","+## Running as CUDA graphs","+","+A CUDA model compiled with `aot_inductor.cudagraphs=True` can run as CUDA graphs","+that the runtime captures lazily, while serving calls, and replays, which cuts","+the host overhead of launching kernels. The compile fails if the model can't be","+captured, e.g. because it runs ops on the CPU, syncs with the host, uses side","+streams or control flow (`torch.cond`, `while_loop`), mutates its inputs, or","+has data-dependent shapes. Models that use random numbers are","+rejected too, for now (attention without dropout is fine), and so is ROCm,","+where a capture can't yet run safely next to other GPU work in the process","+([ROCm/rocm-systems#12677](https://github.com/ROCm/rocm-systems/issues/12677)).","+","+```python","+package_path = torch._inductor.aoti_compile_and_package(","+    torch.export.export(model, example_inputs),","+    inductor_configs={\"aot_inductor.cudagraphs\": True},","+)","+compiled = torch._inductor.aoti_load_package(package_path)","+out = compiled.run_with_lazy_cuda_graphs(*example_inputs)","+```","+","+In C++, `AOTIModelPackageLoader::run_with_lazy_cuda_graphs` takes the same","+arguments as `run`. Calling the model as usual still runs it eagerly, and","+doesn't count as a warm-up.","+","+- On each model instance (see `num_runners`), a new input layout (shapes and","+  strides) runs eagerly on its first call, is captured on its next call and","+  replayed after that. Only a thread that has already finished an eager call of","+  that layout on that instance captures it, since some libraries set up per","+  thread; any thread replays.","+- Each model instance keeps up to `AOTI_RUNTIME_CUDA_GRAPH_MAX_GRAPHS` graphs","+  (an environment variable read when the model is loaded, default 8; a bad","+  value makes every `run_with_lazy_cuda_graphs` call fail) in its own memory","+  pool; past that, new layouts run eagerly.","+- Replayed outputs are copies: they don't alias the inputs, and views among","+  outputs come back as separate tensors. Eager calls return the model's own","+  outputs.","+- As with `torch.cuda.graph`, a failed capture raises the error; existing","+  graphs keep replaying, and the layout is captured again on its next call.","+  Compiling with `aot_inductor.cudagraphs=True` rejects models that can't be","+  captured.","+- Capturing needs PyTorch's native CUDA caching allocator: under","+  `PYTORCH_ALLOC_CONF=backend:cudaMallocAsync`, every capture fails, so","+  `run_with_lazy_cuda_graphs` raises after each layout's first call; call the","+  model as usual instead.","+- Once a graph is captured, the model's active constants can't change, so","+  `load_constants` fails; in C++, the inactive buffer can still be updated, but","+  not swapped in. Load the model again to use new weights.","+- Calls can't run inside an outer CUDA graph capture, or on a model loaded with","+  `run_single_threaded=True`.","+"," ## Troubleshooting"," "," Below are some useful tools for debugging AOT Inductor."],"additions":51,"deletions":0,"truncated":false},{"path":"test/cpp/aoti_inference/test.cpp","lines":["@@ -314,8 +314,8 @@ void test_aoti_constants_update(","   // works when running AotInductorTest.RuntimeUpdateConstantsCuda individually.","   try {","     runner->update_constant_buffer_from_cpu(missing_map, false, true);","-  } catch (const std::runtime_error& e) {","-    EXPECT_THAT(e.what(), ::testing::HasSubstr(\"API call failed at\"));","+  } catch (const std::exception& e) {","+    EXPECT_THAT(e.what(), ::testing::HasSubstr(\"Cannot find constants\"));","   }"," ","   // Update random weight to buffer #1."],"additions":2,"deletions":2,"truncated":false},{"path":"test/inductor/test_aot_inductor.py","lines":["@@ -7,9 +7,11 @@"," import os"," import pathlib"," import re","+import shutil"," import subprocess"," import sys"," import tempfile","+import threading"," import unittest"," import uuid"," import zipfile","@@ -459,6 +461,17 @@ def forward(self, x):","     return model, example_inputs, package_path"," "," ","+def run_profiled(fn):","+    \"\"\"Runs fn under the profiler; returns its result and whether it launched","+    a CUDA graph.\"\"\"","+    activities = [torch.profiler.ProfilerActivity.CUDA]","+    with torch.profiler.profile(activities=activities) as prof:","+        result = fn()","+    launch_names = (\"cudaGraphLaunch\", \"hipGraphLaunch\")","+    launched = any(n in e.name for e in prof.events() for n in launch_names)","+    return result, launched","+","+"," class AOTInductorTestsTemplate:","     @common_utils.decorateIf(","         skip_if_device(","@@ -11581,8 +11594,9 @@ def forward(self, x):"," ","         x = torch.randn(4, 4, device=self.device)","         q = torch.randn(1, 2, 16, 64, device=self.device)","+        mlp = torch.nn.Sequential(torch.nn.Linear(4, 8), torch.nn.ReLU())","         for model, inputs in (","-            (torch.nn.Sequential(torch.nn.Linear(4, 8), torch.nn.ReLU()), (x,)),","+            (mlp.to(self.device), (x,)),","             (CpuConstant(), (x,)),","             (NestedRegion(), (x,)),","             (UnusedInput(), (x, torch.randn(3, device=self.device))),","@@ -11592,12 +11606,22 @@ def forward(self, x):","             (Attention(), (q,)),","             *([(Attention(), (q.bfloat16(),))] if SM80OrLater else []),","         ):","-            # The C API PR later in the stack captures and replays each of","-            # these through run_with_lazy_cuda_graphs.","             with self.subTest(type(model).__name__):","-                self.check_model(","-                    model, inputs, options={\"aot_inductor.cudagraphs\": True}","+                options = {\"aot_inductor.cudagraphs\": True}","+                self.check_model(model, inputs, options=dict(options))","+                so_path = AOTIRunnerUtil.legacy_compile(model, inputs, options=options)","+                runner = torch._C._aoti.AOTIModelContainerRunnerCuda(","+                    so_path, 1, self.device","                 )","+                launches = []","+                for _ in range(3):","+                    (out,), launched = run_profiled(","+                        lambda: runner.run_with_lazy_cuda_graphs(list(inputs))","+                    )","+                    self.assertEqual(out, model(*inputs))","+                    launches.append(launched)","+                # Warm-up, capture, replay.","+                self.assertEqual(launches, [False, True, True])"," ","     @runOnRocm","     def test_aot_cudagraphs_rejects_rocm(self):","@@ -11849,6 +11873,263 @@ def forward(self, x):","                 inductor_configs={\"aot_inductor.cudagraphs\": True},","             )"," ","+    @xfailIfROCm","+    def test_aot_cudagraphs_run_captures_and_replays(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Sequential(torch.nn.Linear(16, 32), torch.nn.ReLU())","+        model = model.to(self.device)","+        batch = torch.export.Dim(\"batch\", min=1, max=64)","+        so_path = AOTIRunnerUtil.legacy_compile(","+            model,","+            (torch.randn(4, 16, device=self.device),),","+            options={\"aot_inductor.cudagraphs\": True},","+            dynamic_shapes=({0: batch},),","+        )","+","+        def launches_graph(runner, batch_size):","+            x = torch.randn(batch_size, 16, device=self.device)","+            (out,), launched = run_profiled(","+                lambda: runner.run_with_lazy_cuda_graphs([x])","+            )","+            self.assertEqual(out, model(x))","+            return launched","+","+        def new_runner(env):","+            # The container reads the variable when it is created.","+            with patch.dict(os.environ, env):","+                return torch._C._aoti.AOTIModelContainerRunnerCuda(","+                    so_path, 1, self.device","+                )","+","+        runner = new_runner({\"AOTI_RUNTIME_CUDA_GRAPH_MAX_GRAPHS\": \"1\"})","+        # A new shape warms up, is captured on its next call, then replays.","+        self.assertEqual(","+            [launches_graph(runner, 4) for _ in range(3)], [False, True, True]","+        )","+        # With the limit reached, another shape runs eagerly.","+        self.assertEqual([launches_graph(runner, 8) for _ in range(2)], [False, False])","+        self.assertTrue(launches_graph(runner, 4))","+        runner = new_runner({\"AOTI_RUNTIME_CUDA_GRAPH_MAX_GRAPHS\": \"3\"})","+        for batch_size in (4, 8, 16):","+            launches = [launches_graph(runner, batch_size) for _ in range(3)]","+            self.assertEqual(launches, [False, True, True])","+        self.assertEqual([launches_graph(runner, 32) for _ in range(2)], [False, False])","+        runner = new_runner({\"AOTI_RUNTIME_CUDA_GRAPH_MAX_GRAPHS\": \"0\"})","+        self.assertEqual([launches_graph(runner, 4) for _ in range(3)], [False] * 3)","+        runner = new_runner({\"AOTI_RUNTIME_CUDA_GRAPH_MAX_GRAPHS\": \"3x\"})","+        with self.assertRaisesRegex(RuntimeError, \"must be a non-negative integer\"):","+            runner.run_with_lazy_cuda_graphs([torch.randn(4, 16, device=self.device)])","+","+    @xfailIfROCm","+    def test_aot_cudagraphs_run_rejects_constant_updates(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Sequential(torch.nn.Linear(16, 32), torch.nn.ReLU())","+        model = model.to(self.device)","+        x = torch.randn(4, 16, device=self.device)","+        # mmap'd weights, so that the blob reload reaches the container's check","+        # instead of failing on the blob size first.","+        options = {","+            \"aot_inductor.cudagraphs\": True,","+            \"aot_inductor.force_mmap_weights\": True,","+        }","+        so_path = AOTIRunnerUtil.legacy_compile(model, (x,), options=options)","+        runner = torch._C._aoti.AOTIModelContainerRunnerCuda(so_path, 1, self.device)","+        names = runner.get_constant_names_to_original_fqns()","+","+        def new_weights():","+            state = model.state_dict()","+            weights = {n: torch.randn_like(state[f]) for n, f in names.items()}","+            model.load_state_dict({names[n]: w for n, w in weights.items()})","+            return weights","+","+        # A warm-up call captures nothing, so the constants can still change.","+        runner.run_with_lazy_cuda_graphs([x])","+        runner.update_constant_buffer(new_weights(), False, False)","+        (out,) = runner.run_with_lazy_cuda_graphs([x])","+        self.assertEqual(out, model(x))","+        # Now a graph exists.","+        msg = \"captured CUDA graphs\"","+        with self.assertRaisesRegex(RuntimeError, msg):","+            runner.update_constant_buffer(new_weights(), False, False)","+        with tempfile.NamedTemporaryFile() as blob:","+            blob.write(bytes(1 << 20))","+            blob.flush()","+            with self.assertRaisesRegex(RuntimeError, msg):","+                runner.update_constant_buffer_from_blob(blob.name)","+        with self.assertRaisesRegex(RuntimeError, msg):","+            runner.run_const_fold(False)","+        # The inactive buffer can still be updated, but not swapped in.","+        weights = new_weights()","+        runner.update_constant_buffer(weights, True, False)","+        with self.assertRaisesRegex(RuntimeError, msg):","+            runner.swap_constant_buffer()","+","+    @xfailIfROCm","+    def test_aot_cudagraphs_run_on_several_instances(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Sequential(torch.nn.Linear(16, 32), torch.nn.ReLU())","+        model = model.to(self.device)","+        so_path = AOTIRunnerUtil.legacy_compile(","+            model,","+            (torch.randn(4, 16, device=self.device),),","+            options={\"aot_inductor.cudagraphs\": True},","+        )","+        runner = torch._C._aoti.AOTIModelContainerRunnerCuda(so_path, 2, self.device)","+        # The binding holds the GIL, so calls take turns: this checks that each","+        # instance keeps its own graphs across threads, not overlapping calls,","+        # which CudaGraphManagerTest.RunsConcurrently covers.","+        errors = []","+        barrier = threading.Barrier(4)","+","+        def work():","+            try:","+                stream = torch.cuda.Stream()","+                with torch.cuda.stream(stream):","+                    # Creates the thread's library handles for the eager","+                    # reference below before any instance captures.","+                    model(torch.randn(4, 16, device=self.device))","+                    barrier.wait(timeout=60)","+                    for _ in range(20):","+                        x = torch.randn(4, 16, device=self.device)","+                        (out,) = runner.run_with_lazy_cuda_graphs([x])","+                        self.assertEqual(out, model(x))","+            except Exception as e:","+                errors.append(e)","+","+        def run_threads():","+            threads = [threading.Thread(target=work) for _ in range(4)]","+            for t in threads:","+                t.start()","+            for t in threads:","+                t.join()","+","+        _, launched = run_profiled(run_threads)","+        if errors:","+            raise errors[0]","+        self.assertTrue(launched)","+","+    @xfailIfROCm","+    def test_aot_cudagraphs_run_from_package(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Sequential(torch.nn.Linear(16, 32), torch.nn.ReLU())","+        model = model.to(self.device)","+        x = torch.randn(4, 16, device=self.device)","+        package_path = torch._inductor.aoti_compile_and_package(","+            torch.export.export(model, (x,)),","+            inductor_configs={\"aot_inductor.cudagraphs\": True},","+        )","+        compiled = torch._inductor.aoti_load_package(package_path)","+        launches = []","+        for _ in range(3):","+            out, launched = run_profiled(lambda: compiled.run_with_lazy_cuda_graphs(x))","+            self.assertEqual(out, model(x))","+            launches.append(launched)","+        self.assertEqual(launches, [False, True, True])","+","+    @xfailIfROCm","+    @unittest.skipIf(","+        IS_FBCODE, \"Subprocess spawning doesn't work in fbcode Buck environment\"","+    )","+    def test_aot_cudagraphs_run_fails_with_cuda_malloc_async(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Linear(16, 32).to(self.device)","+        x = torch.randn(4, 16, device=self.device)","+        package_path = torch._inductor.aoti_compile_and_package(","+            torch.export.export(model, (x,)),","+            inductor_configs={\"aot_inductor.cudagraphs\": True},","+        )","+        # The allocator backend is fixed when CUDA initializes.","+        code = f\"\"\"","+import torch","+compiled = torch._inductor.aoti_load_package({package_path!r})","+x = torch.randn(4, 16, device=\"cuda\")","+# A warm-up call, then a capture.","+torch.testing.assert_close(compiled.run_with_lazy_cuda_graphs(x), compiled(x))","+print(\"warmed up\", flush=True)","+compiled.run_with_lazy_cuda_graphs(x)","+\"\"\"","+        env = {**os.environ, \"PYTORCH_CUDA_ALLOC_CONF\": \"backend:cudaMallocAsync\"}","+        proc = subprocess.run(","+            [sys.executable, \"-c\", code], env=env, capture_output=True, text=True","+        )","+        self.assertNotEqual(proc.returncode, 0)","+        self.assertIn(\"warmed up\", proc.stdout)","+        self.assertIn(\"CUDA graph capture isn't supported\", proc.stderr)","+","+    @xfailIfROCm","+    def test_aot_cudagraphs_run_rejects_unsupported_callers(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Linear(16, 32).to(self.device)","+        x = torch.randn(4, 16, device=self.device)","+        options = {\"aot_inductor.cudagraphs\": True}","+        so_path = AOTIRunnerUtil.legacy_compile(model, (x,), options=options)","+        runner = torch._C._aoti.AOTIModelContainerRunnerCuda(","+            so_path, 1, self.device, \"\", True","+        )","+        with self.assertRaisesRegex(RuntimeError, \"run_single_threaded\"):","+            runner.run_with_lazy_cuda_graphs([x])","+        runner = torch._C._aoti.AOTIModelContainerRunnerCuda(so_path, 1, self.device)","+        runner.run_with_lazy_cuda_graphs([x])","+        with torch.cuda.graph(torch.cuda.CUDAGraph()):","+            with self.assertRaisesRegex(RuntimeError, \"inside a CUDA graph capture\"):","+                runner.run_with_lazy_cuda_graphs([x])","+        # The container still works.","+        self.assertEqual(runner.run_with_lazy_cuda_graphs([x])[0], model(x))","+","+    @unittest.skipIf(not IS_LINUX or shutil.which(\"nm\") is None, \"needs nm\")","+    def test_aot_cudagraphs_flag_gates_shim_symbols(self):","+        if self.device != \"cuda\" or TEST_WITH_ROCM:","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Linear(16, 32).to(self.device)","+        x = torch.randn(4, 16, device=self.device)","+        # Models compiled without the flag must still load on a libtorch that","+        # lacks the CUDA graph shim functions.","+        symbols = [","+            \"aoti_torch_create_cuda_graph\",","+            \"aoti_torch_delete_cuda_graph\",","+            \"aoti_torch_create_cuda_mem_pool\",","+            \"aoti_torch_delete_cuda_mem_pool\",","+            \"aoti_torch_cuda_graph_capture_begin\",","+            \"aoti_torch_cuda_graph_capture_end\",","+            \"aoti_torch_cuda_graph_replay\",","+            \"aoti_torch__foreach_copy_\",","+        ]","+        for flag in (False, True):","+            so_path = AOTIRunnerUtil.legacy_compile(","+                model, (x,), options={\"aot_inductor.cudagraphs\": flag}","+            )","+            undefined = subprocess.check_output([\"nm\", \"-uD\", so_path], text=True)","+            for symbol in symbols:","+                self.assertEqual(symbol in undefined, flag, symbol)","+","+    def test_aot_cudagraphs_run_requires_cuda_model(self):","+        if self.device != \"cpu\":","+            raise unittest.SkipTest(\"requires CPU\")","+        model = torch.nn.Linear(4, 4)","+        x = torch.randn(2, 4)","+        package_path = torch._inductor.aoti_compile_and_package(","+            torch.export.export(model, (x,))","+        )","+        compiled = torch._inductor.aoti_load_package(package_path)","+        with self.assertRaisesRegex(RuntimeError, \"requires a CUDA model\"):","+            compiled.run_with_lazy_cuda_graphs(x)","+","+    def test_aot_cudagraphs_run_requires_flag(self):","+        if self.device != \"cuda\":","+            raise unittest.SkipTest(\"requires CUDA\")","+        model = torch.nn.Linear(4, 4).to(self.device)","+        x = torch.randn(2, 4, device=self.device)","+        so_path = AOTIRunnerUtil.legacy_compile(model, (x,))","+        runner = torch._C._aoti.AOTIModelContainerRunnerCuda(so_path, 1, self.device)","+        with self.assertRaisesRegex(RuntimeError, \"aot_inductor.cudagraphs=True\"):","+            runner.run_with_lazy_cuda_graphs([x])","+","     def test_custom_op_in_subgraph(self):","         with torch.library._scoped_library(\"mylib\", \"FRAGMENT\") as lib:","             t