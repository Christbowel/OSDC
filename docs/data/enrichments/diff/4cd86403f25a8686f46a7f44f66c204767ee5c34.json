  \"type\": \"array\",","+      \"items\": {","+        \"$ref\": \"#/$defs/SbomCrate\"","+      }","+    },","+    \"rustc\": {","+      \"$ref\": \"#/$defs/SbomRustc\"","+    },","+    \"target\": {","+      \"type\": \"string\"","+    }","+  },","+  \"required\": [","+    \"version\",","+    \"root\",","+    \"crates\",","+    \"rustc\",","+    \"target\"","+  ],","+  \"$defs\": {","+    \"SbomFormatVersion\": {","+      \"description\": \"Typed version of a SBOM format version number.\",","+      \"type\": \"integer\",","+      \"format\": \"uint32\",","+      \"minimum\": 0","+    },","+    \"SbomIndex\": {","+      \"description\": \"Zero-based index into `crates` array of the crate described by this SBOM.\",","+      \"type\": \"integer\",","+      \"format\": \"uint\",","+      \"minimum\": 0","+    },","+    \"SbomCrate\": {","+      \"type\": \"object\",","+      \"properties\": {","+        \"id\": {","+          \"$ref\": \"#/$defs/PackageIdSpec\"","+        },","+        \"features\": {","+          \"type\": \"array\",","+          \"items\": {","+            \"type\": \"string\"","+          }","+        },","+        \"dependencies\": {","+          \"type\": \"array\",","+          \"items\": {","+            \"$ref\": \"#/$defs/SbomDependency\"","+          }","+        },","+        \"kind\": {","+          \"type\": \"array\",","+          \"items\": {","+            \"type\": \"string\"","+          }","+        }","+      },","+      \"required\": [","+        \"id\",","+        \"features\",","+        \"dependencies\",","+        \"kind\"","+      ]","+    },","+    \"PackageIdSpec\": {","+      \"type\": \"string\"","+    },","+    \"SbomDependency\": {","+      \"type\": \"object\",","+      \"properties\": {","+        \"index\": {","+          \"$ref\": \"#/$defs/SbomIndex\"","+        },","+        \"kind\": {","+          \"$ref\": \"#/$defs/SbomDependencyType\"","+        }","+      },","+      \"required\": [","+        \"index\",","+        \"kind\"","+      ]","+    },","+    \"SbomDependencyType\": {","+      \"oneOf\": [","+        {","+          \"description\": \"A dependency linked to the artifact produced by this unit.\",","+          \"type\": \"string\",","+          \"const\": \"normal\"","+        },","+        {","+          \"description\": \"A dependency needed to run the build for this unit (e.g. a build script or proc-macro).\\nThe dependency is not linked to the artifact produced by this unit.\",","+          \"type\": \"string\",","+          \"const\": \"build\"","+        }","+      ]","+    },","+    \"SbomRustc\": {","+      \"type\": \"object\",","+      \"properties\": {","+        \"version\": {","+          \"type\": \"string\"","+        },","+        \"wrapper\": {","+          \"type\": [","+            \"string\",","+            \"null\"","+          ]","+        },","+        \"workspace_wrapper\": {","+          \"type\": [","+            \"string\",","+            \"null\"","+          ]","+        },","+        \"commit_hash\": {","+          \"type\": [","+            \"string\",","+            \"null\"","+          ]","+        },","+        \"host\": {","+          \"type\": \"string\"","+        },","+        \"verbose_version\": {","+          \"type\": \"string\"","+        }","+      },","+      \"required\": [","+        \"version\",","+        \"host\",","+        \"verbose_version\"","+      ]","+    }","+  }","+}","\\ No newline at end of file"],"additions":148,"deletions":0,"truncated":false},{"path":"crates/cargo-util-schemas/src/core/crate_type.rs","lines":["@@ -0,0 +1,74 @@","+use std::fmt;","+","+/// Types of the output artifact that the compiler emits.","+/// Usually distributable or linkable either statically or dynamically.","+///","+/// See <https://doc.rust-lang.org/nightly/reference/linkage.html>.","+#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]","+pub enum CrateType {","+    Bin,","+    Lib,","+    Rlib,","+    Dylib,","+    Cdylib,","+    Staticlib,","+    ProcMacro,","+    Other(String),","+}","+","+impl CrateType {","+    pub fn as_str(&self) -> &str {","+        match self {","+            CrateType::Bin => \"bin\",","+            CrateType::Lib => \"lib\",","+            CrateType::Rlib => \"rlib\",","+            CrateType::Dylib => \"dylib\",","+            CrateType::Cdylib => \"cdylib\",","+            CrateType::Staticlib => \"staticlib\",","+            CrateType::ProcMacro => \"proc-macro\",","+            CrateType::Other(s) => s,","+        }","+    }","+}","+","+impl fmt::Display for CrateType {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        self.as_str().fmt(f)","+    }","+}","+","+impl<'a> From<&'a String> for CrateType {","+    fn from(s: &'a String) -> Self {","+        match s.as_str() {","+            \"bin\" => CrateType::Bin,","+            \"lib\" => CrateType::Lib,","+            \"rlib\" => CrateType::Rlib,","+            \"dylib\" => CrateType::Dylib,","+            \"cdylib\" => CrateType::Cdylib,","+            \"staticlib\" => CrateType::Staticlib,","+            \"proc-macro\" => CrateType::ProcMacro,","+            _ => CrateType::Other(s.clone()),","+        }","+    }","+}","+","+impl From<String> for CrateType {","+    fn from(s: String) -> Self {","+        CrateType::from(&s)","+    }","+}","+","+impl fmt::Debug for CrateType {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        self.as_str().fmt(f)","+    }","+}","+","+impl serde::Serialize for CrateType {","+    fn serialize<S>(&self, s: S) -> Result<S::Ok, S::Error>","+    where","+        S: serde::ser::Serializer,","+    {","+        s.serialize_str(self.as_str())","+    }","+}"],"additions":74,"deletions":0,"truncated":false},{"path":"crates/cargo-util-schemas/src/core/mod.rs","lines":["@@ -1,7 +1,9 @@","+mod crate_type;"," mod package_id_spec;"," mod partial_version;"," mod source_kind;"," ","+pub use crate_type::CrateType;"," pub use package_