ackageIdSpec, features: Vec<String>, kind: SbomTargetKind) -> Self {","+        Self {","+            id: package_id,","+            features,","+            dependencies: Vec::new(),","+            kind,","+        }","+    }","+}","+","+#[derive(Serialize, Deserialize, Clone)]","+#[serde(rename_all = \"snake_case\")]","+#[cfg_attr(feature = \"unstable-schema\", derive(schemars::JsonSchema))]","+pub struct SbomRustc {","+    pub version: String,","+    pub wrapper: Option<PathBuf>,","+    pub workspace_wrapper: Option<PathBuf>,","+    pub commit_hash: Option<String>,","+    pub host: String,","+    pub verbose_version: String,","+}","+","+#[derive(Serialize, Deserialize)]","+#[serde(rename_all = \"snake_case\")]","+#[cfg_attr(","+    feature = \"unstable-schema\",","+    derive(schemars::JsonSchema),","+    schemars(title = \"Cargo SBOM precursor\")","+)]","+/// This is the schema used to generate `*.cargo-sbom.json` files with -Zsbom enabled.","+pub struct Sbom {","+    pub version: SbomFormatVersion,","+    pub root: SbomIndex,","+    pub crates: Vec<SbomCrate>,","+    pub rustc: SbomRustc,","+    pub target: String,","+}","+","+#[cfg(feature = \"unstable-schema\")]","+#[test]","+fn matches_schema() {","+    let schema = schemars::schema_for!(Sbom);","+    let dump = serde_json::to_string_pretty(&schema).unwrap();","+    snapbox::assert_data_eq!(dump, snapbox::file!(\"../cargo-sbom.schema.json\").raw());","+}"],"additions":141,"deletions":0,"truncated":false},{"path":"src/compiler/artifact.rs","lines":["@@ -1,8 +1,10 @@"," //! Generate artifact information from unit dependencies for configuring the compiler environment."," ","+use cargo_util_schemas::core::CrateType;","+"," use crate::CargoResult;"," use crate::compiler::unit_graph::UnitDep;","-use crate::compiler::{BuildRunner, CrateType, FileFlavor, Unit};","+use crate::compiler::{BuildRunner, FileFlavor, Unit};"," use crate::util::data_structures::{HashMap, HashSet};"," use crate::workspace::dependency::Artifa