o/ui-components'),","+  showToast: jest.fn(),","+}));","+","+const mockShowToast = showToast as jest.Mock;","+","+type Result =","+  | {__typename: 'Sensor'}","+  | {__typename: 'UnauthorizedError'; message: string}","+  | {__typename: 'SensorNotFoundError'; message: string}","+  | {__typename: 'PythonError'; message: string; stack: string[]};","+","+const check = (result: Result | undefined) =>","+  showMutationErrorToast(result, 'Sensor', 'Could not save.');","+","+describe('showMutationErrorToast', () => {","+  beforeEach(() => {","+    mockShowToast.mockClear();","+  });","+","+  it('ignores the success type', () => {","+    expect(check({__typename: 'Sensor'})).toBe(false);","+    expect(mockShowToast).not.toHaveBeenCalled();","+  });","+","+  it('treats missing data as a failure', () => {","+    expect(check(undefined)).toBe(true);","+    expect(mockShowToast).toHaveBeenCalledWith(","+      expect.objectContaining({intent: 'danger', message: 'Could not save.'}),","+    );","+  });","+","+  it('shows a permission message for the default UnauthorizedError', () => {","+    expect(check({__typename: 'UnauthorizedError', message: 'Authorization failed'})).toBe(true);","+    expect(mockShowToast).toHaveBeenCalledWith(","+      expect.objectContaining({message: `Could not save. ${UNAUTHORIZED_MUTATION_MESSAGE}`}),","+    );","+  });","+","+  it('shows custom UnauthorizedError messages from the server', () => {","+    check({__typename: 'UnauthorizedError', message: 'Only available on an Enterprise plan'});","+    expect(mockShowToast).toHaveBeenCalledWith(","+      expect.objectContaining({message: 'Could not save. Only available on an Enterprise plan'}),","+    );","+  });","+","+  it('includes the message of other error types', () => {","+    expect(check({__typename: 'SensorNotFoundError', message: 'Sensor foo not found'})).toBe(true);","+    expect(mockShowToast).toHaveBeenCalledWith(","+      expect.objectContaining({message: 'Could not save. Sensor foo not found'}),","+    );","+  });","+","+  it('offers the stack trace for PythonError', () => {","+    expect(check({__typename: 'PythonError', message: 'boom', stack: ['line 1']})).toBe(true);","+    expect(mockShowToast).toHaveBeenCalledWith(","+      expect.objectContaining({","+        message: 'Could not save.',","+        action: expect.objectContaining({type: 'button', text: 'View error'}),","+      }),","+    );","+  });","+});"],"additions":68,"deletions":0,"truncated":false},{"path":"js_modules/ui-core/src/app/showMutationErrorToast.tsx","lines":["@@ -0,0 +1,57 @@","+import {showToast} from '@dagster-io/ui-components';","+","+import {showCustomAlert} from './CustomAlertProvider';","+import {GenericError, PythonErrorInfo} from './PythonErrorInfo';","+","+type MutationResult = {__typename: string} & Partial<GenericError>;","+","+export const UNAUTHORIZED_MUTATION_MESSAGE = 'You do not have permission to do this.';","+","+// The backend's default UnauthorizedError message; custom messages are shown as-is.","+const DEFAULT_UNAUTHORIZED_MESSAGE = 'Authorization failed';","+","+/**","+ * Shows an error toast unless the mutation result is `successTypename`. Missing data counts as a","+ * failure. Returns true if an error was shown, so callers can bail out of follow-up work.","+ */","+export const showMutationErrorToast = <T extends MutationResult>(","+  result: T | null | undefined,","+  successTypename: T['__typename'],","+  failureMessage: string,","+): boolean => {","+  if (result?.__typename === successTypename) {","+    return false;","+  }","+","+  if (result?.__typename === 'PythonError') {","+    const error: GenericError = {","+      message: result.message ?? '',","+      stack: result.stack,","+      errorChain: result.errorChain,","+    };","+    showToast({","+      intent: 'danger',","+      icon: 'error',","+      message: failureMessage,","+      action: {","+        type: 'button',","+        text: 'View error',","+        onClick: () =>","+          showCustomAlert({title: failureMessage, body: <PythonErrorInfo error={error} />}),","+      },","+    });","+    return true;","+  }","+","+  const detail =","+    result?.__typename === 'UnauthorizedError' &&","+    (!result.message || result.message === DEFAULT_UNAUTHORIZED_MESSAGE)","+      ? UNAUTHORIZED_MUTATION_MESSAGE","+      : result?.message;","+  showToast({","+    intent: 'danger',","+    icon: 'error',","+    message: detail ? `${failureMessage} ${detail}` : failureMessage,","+  });","+  return true;","+};"],"additions":57,"deletions":0,"truncated":false},{"path":"js_modules/ui-core/src/asset-data/types/AssetAutomationDataProvider.types.ts","lines":["@@ -59,6 +59,7 @@ export type AssetAutomationQuery = {","           __typename: 'Sensor';","           id: string;","           name: string;","+          hasCursorUpdatePermissions: boolean;","           sensorType: Types.SensorType;","           sensorState: {","             __typename: 'InstigationState';","@@ -111,6 +112,7 @@ export type AssetAutomationFragment = {","         __typename: 'Sensor';","         id: string;","         name: string;","+        hasCursorUpdatePermissions: boolean;","         sensorType: Types.SensorType;","         sensorState: {","           __typename: 'InstigationState';","@@ -153,6 +155,7 @@ export type AssetInstigatorFragment_Sensor = {","   __typename: 'Sensor';","   id: string;","   name: string;","+  hasCursorUpdatePermissions: boolean;","   sensorType: Types.SensorType;","   sensorState: {","     __typename: 'InstigationState';","@@ -172,4 +175,4 @@ export type AssetInstigatorFragment =","   | AssetInstigatorFragment_Schedule","   | AssetInstigatorFragment_Sensor;"," ","-export const AssetAutomationQueryVersion = 'ba290842b1e65f256ea3b1e95285e050da5a8ee50ecf34b6228299e7dd605425';","+export const AssetAutomationQueryVersion = '619e116f0e9a85be3569b48658509b3808d117b8aa7ec7d6602ee0fa6b15aa3d';"],"additions":4,"deletions":1,"truncated":false},{"path":"js_modules/ui-core/src