tor/logical_dummy_scan.hpp\"","+#include \"duckdb/planner/operator/logical_expression_get.hpp\"","+#include \"duckdb/planner/operator/logical_filter.hpp\"","+#include \"duckdb/planner/operator/logical_get.hpp\"","+#include \"duckdb/planner/operator/logical_materialized_cte.hpp\"","+#include \"duckdb/planner/operator/logical_projection.hpp\"","+#include \"duckdb/parser/expression_map.hpp\"","+","+#include <cmath>","+#include <limits>","+","+namespace duckdb {","+","+DuplicateEliminatedDomainOptimizer::DuplicateEliminatedDomainOptimizer(Optimizer &optimizer_p)","+    : optimizer(optimizer_p) {","+}","+","+static bool HasImplicitBitstringAggregate(const LogicalOperator &op) {","+\tbool found = false;","+\tLogicalOperatorVisitor::EnumerateExpressions(op, [&](const unique_ptr<Expression> *expression) {","+\t\tExpressionIterator::VisitExpression<BoundAggregateExpression>(**expression, [&](const auto &aggregate) {","+\t\t\tfound |= aggregate.Function().GetName() == \"bitstring_agg\" && aggregate.Function().HasStatisticsCallback();","+\t\t});","+\t\tExpressionIterator::VisitExpression<BoundWindowExpression>(**expression, [&](const auto &window) {","+\t\t\tauto &function = window.AggregateFunction();","+\t\t\tfound |= function && function->GetName() == \"bitstring_agg\" && function->HasStatisticsCallback();","+\t\t});","+\t});","+\tif (found) {","+\t\treturn true;","+\t}","+\tfor (auto &child : op.children) {","+\t\tif (HasImplicitBitstringAggregate(*child)) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+","+void DuplicateEliminatedDomainOptimizer::Optimize(unique_ptr<LogicalOperator> &op) {","+\t// Implicit bitstring bounds depend on statistics, including those propagated through CTE references.","+\tif (!HasImplicitBitstringAggregate(*op)) {","+\t\tVisitOperator(op);","+\t\top->ResolveOperatorTypes();","+\t}","+}","+","+static bool IsWorkReference(const Expression &expression) {","+\tswitch (expression.GetExpressionClass()) {","+\tcase ExpressionClass::BOUND_COLUMN_REF:","+\t\treturn expression.Cast<BoundColumnRefExpression>().Depth() == 0;","+\tcase ExpressionClass::BOUND_CONSTANT:","+\tcase ExpressionClass::BOUND_PARAMETER:","+\t\treturn true;","+\tdefault:","+\t\treturn false;","+\t}","+}","+","+static optional_idx ReferenceIndex(const Expression &expression, LogicalOperator &input) {","+\tif (expression.GetExpressionClass() != ExpressionClass::BOUND_COLUMN_REF ||","+\t    expression.Cast<BoundColumnRefExpression>().Depth() != 0) {","+\t\treturn {};","+\t}","+\treturn AggregateRewriteHelper::GetDirectReferenceIndex(expression, input);","+}","+","+static optional_idx ReferenceIndex(const Expression &expression, LogicalOperator &input, const LogicalType &type) {","+\tif (!expression.GetReturnType().EqualsIncludingCollation(type)) {","+\t\treturn {};","+\t}","+\treturn ReferenceIndex(expression, input);","+}","+","+//! One full grouping set preserves the directly referenced key and its comparison semantics.","+static optional_idx GroupKeyIndex(LogicalAggregate &aggregate, idx_t key) {","+\tif (aggregate.grouping_sets.size() != 1 || aggregate.grouping_sets[0].size() != aggregate.groups.size() ||","+\t    key >= aggregate.groups.size() || !aggregate.grouping_functions.empty()) {","+\t\treturn {};","+\t}","+\treturn ReferenceIndex(*aggregate.groups[key], *aggregate.children[0]);","+}","+","+static optional_idx GroupKeyIndex(LogicalAggregate &aggregate, idx_t key, const LogicalType &type) {","+\tauto index = GroupKeyIndex(aggregate, key);","+\tif (!index.IsValid() || !aggregate.groups[key]->GetReturnType().EqualsIncludingCollation(type)) {","+\t\treturn {};","+\t}","+\treturn index;","+}","+","+static optional_ptr<LogicalAggregate> FindAggregate(LogicalOperator &op, idx_t key) {","+\tif (op.type == LogicalOperatorType::LOGICAL_PROJECTION) {","+\t\tfor (auto &expression : op.expressions) {","+\t\t\tif (!IsWorkReference(*expression)) {","+\t\t\t\treturn nullptr;","+\t\t\t}","+\t\t}","+\t\tauto index = ReferenceIndex(*op.expressions[key], *op.children[0]);","+\t\treturn index.IsValid() ? FindAggregate(*op.children[0], index.GetIndex()) : nullptr;","+\t}","+\tif (op.type != LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY || key != 0) {","+\t\treturn nullptr;","+\t}","+\tauto &aggregate = op.Cast<LogicalAggregate>();","+\tif (aggregate.preserve_input_order || aggregate.groups.size() != 1 || aggregate.grouping_sets.size() != 1 ||","+\t    aggregate.grouping_sets[0].size() != 1 || !aggregate.grouping_sets[0].count(ProjectionIndex(0)) ||","+\t    !aggregate.grouping_functions.empty() ||","+\t    !ReferenceIndex(*aggregate.groups[0], *aggregate.children[0]).IsValid()) {","+\t\treturn nullptr;","+\t}","+\tfor (auto &expression : aggregate.expressions) {","+\t\tbool supported = true;","+\t\tExpressionIterator::EnumerateChildren(*expression,","+\t\t                                      [&](const Expression &child) { supported &= IsWorkReference(child); });","+\t\tif (!supported) {","+\t\t\treturn nullptr;","+\t\t}","+\t}","+\treturn LogicalSubtreeIsRepeatable(aggregate) ? &aggregate : nullptr;","+}","+","+//! An upper bound from the actual closed input, not a cardinality estimate.","+static optional_idx FixedRowCount(LogicalOperator &op) {","+\tswitch (op.type) {","+\tcase LogicalOperatorType::LOGICAL_DUMMY_SCAN:","+\t\treturn 1;","+\tcase LogicalOperatorType::LOGICAL_EMPTY_RESULT:","+\t\treturn 0;","+\tcase LogicalOperatorType::LOGICAL_CHUNK_GET: {","+\t\tauto &get = op.Cast<LogicalColumnDataGet>();","+\t\treturn get.collection ? optional_idx(get.collection->Count()) : optional_idx();","+\t}","+\tcase LogicalOperatorType::LOGICAL_EXPRESSION_GET:","+\t\tif (op.children.size() == 1 && op.children[0]->type == LogicalOperatorType::LOGICAL_DUMMY_SCAN) {","+\t\t\treturn op.Cast<LogicalExpressionGet>().expressions.size();","+\t\t}","+\t\treturn {};","+\tcase LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY: {","+\t\tauto &aggregate = op.Cast<LogicalAggregate>();","+\t\t// Empty grouping sets can produce a row from empty input.","+\t\tif (aggregate.grouping_sets.size() != 1 || aggregate.grouping_sets[0].empty()) {","+\t\t\treturn {};","+\t\t}","+\t\treturn FixedRowCount(*op.children[0]);","+\t}","+\tcase LogicalOperatorType::LOGICAL_PROJECTION:","+\tcase LogicalOperatorType::LOGICAL_FILTER:","+\t\treturn FixedRowCount(*op.children[0]);","+\tdefault:","+\t\treturn {};","+\t}","+}","+","+static bool AppendFixedKey(vector<vector<unique_ptr<Expression>>> &rows, const Expression &expression,","+                           const LogicalType &type) {","+\tif ((expression.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT &&","+\t     expression.GetExpressionClass() != ExpressionClass::BOUND_PARAMETER) ||","+\t    !expression.GetReturnType().EqualsIncludingCollation(type)) {","+\t\treturn false;","+\t}","+\tvector<unique_ptr<Expression>> row;","+\trow.push_back(expression.Copy());","+\trows.push_back(std::move(row));","+\treturn true;","+}","+","+//! Copy keys already represented by expressions, leaving columnar inputs on the runtime path.","+//! The caller's payload and its evaluation remain in place.","+static bool CopyFixedKeys(LogicalOperator &op, idx_t key, const LogicalType &type,","+                          vector<vector<unique_ptr<Expression>>> &rows) {","+\tswitch (op.type) {","+\tcase LogicalOperatorType::LOGICAL_PROJECTION: {","+\t\tauto &expression = *op.expressions[key];","+\t\tauto index = ReferenceIndex(expression, *op.children[0]);","+\t\tif (index.IsValid()) {","+\t\t\treturn CopyFixedKeys(*op.children[0], index.GetIndex(), type, rows);","+\t\t}","+\t\tauto count = FixedRowCount(*op.children[0]);","+\t\treturn count.IsValid() && (count.GetIndex() == 0 || AppendFixedKey(rows, expression, type));","+\t}","+\tcase LogicalOperatorType::LOGICAL_FILTER: {","+\t\tauto binding = op.GetColumnBindings()[key];","+\t\tBoundColumnRefExpression reference(type, binding);","+\t\tauto index = ReferenceIndex(reference, *op.children[0]);","+\t\treturn index.IsValid() && CopyFixedKeys(*op.children[0], index.GetIndex(), type, rows);","+\t}","+\tcase LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY: {","+\t\tauto index = GroupKeyIndex(op.Cast<LogicalAggregate>(), key, type);","+\t\treturn index.IsValid() && CopyFixedKeys(*op.children[0], index.GetIndex(), type, rows);","+\t}","+\tcase LogicalOperatorType::LOGICAL_EXPRESSION_GET: {","+\t\tif (!FixedRowCount(op).IsValid()) {","+\t\t\treturn false;","+\t\t}","+\t\tfor (auto &row : op.Cast<LogicalExpressionGet>().expressions) {","+\t\t\tif (!AppendFixedKey(rows, *row[key], type)) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+\tcase LogicalOperatorType::LOGICAL_EMPTY_RESULT:","+\t\treturn true;","+\tdefault:","+\t\treturn false;","+\t}","+}","+","+//! The old restriction must be proven to contain every demanded key.","+static bool CopyExactFixedKeys(LogicalOperator &op, idx_t key, const LogicalType &type,","+                               vector<vector<unique_ptr<Expression>>> &rows) {","+\tswitch (op.type) {","+\tcase LogicalOperatorType::LOGICAL_PROJECTION: {","+\t\tauto &expression = *op.expressions[key];","+\t\tauto index = ReferenceIndex(expression, *op.children[0], type);","+\t\tif (index.IsValid()) {","+\t\t\treturn CopyExactFixedKeys(*op.children[0], index.GetIndex(), type, rows);","+\t\t}","+\t\treturn op.children[0]->type == LogicalOperatorType::LOGICAL_DUMMY_SCAN &&","+\t\t       AppendFixedKey(rows, expression, type);","+\t}","+\tcase LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY: {","+\t\tauto index = GroupKeyIndex(op.Cast<LogicalAggregate>(), key, type);","+\t\treturn index.IsValid() && CopyExactFixedKeys(*op.children[0], index.GetIndex(), type, rows);","+\t}","+\tcase LogicalOperatorType::LOGICAL_COMPARISON_JOIN:","+\tcase LogicalOperatorType::LOGICAL_ANY_JOIN: {","+\t\tauto &join = op.Cast<LogicalJoin>();","+\t\tif (join.join_type != JoinType::LEFT) {","+\t\t\treturn false;","+\t\t}","+\t\tBoundColumnRefExpression reference(type, op.GetColumnBindings()[key]);","+\t\tauto index = ReferenceIndex(reference, *op.children[0]);","+\t\treturn index.IsValid() && CopyExactFixedKeys(*op.children[0], index.GetIndex(), type, rows);","+\t}","+\tcase LogicalOperatorType::LOGICAL_EXPRESSION_GET:","+\tcase LogicalOperatorType::LOGICAL_EMPTY_RESULT:","+\t\treturn CopyFixedKeys(op, key, type, rows);","+\tdefault:","+\t\treturn false;","+\t}","+}","+","+enum class RestrictionAction { KEEP, REPLACE, REMOVE };","+","+static unique_ptr<LogicalAggregate> CreateKeyDomain(Optimizer &optimizer, unique_ptr<LogicalOperator> input,","+                                                    unique_ptr<Expression> key) {","+\tauto domain = make_uniq<LogicalAggregate>(optimizer.binder.GenerateTableIndex(),","+\t                                          optimizer.binder.GenerateTableIndex(), vector<unique_ptr<Expression>>());","+\tdomain->groups.push_back(std::move(key));","+\tdomain->grouping_sets.push_back({ProjectionIndex(0)});","+\tdomain->children.push_back(std::move(input));","+\treturn domain;","+}","+","+static unique_ptr<Expression> DomainKey(const LogicalAggregate &domain) {","+\treturn make_uniq<BoundColumnRefExpression>(domain.groups[0]->GetReturnType(),","+\t                                           ColumnBinding(domain.group_index, ProjectionIndex(0)));","+}","+","+//! A matched input restriction and the projections between it and its aggregate.","+//! Borrows the plan for one decision. Apply may destroy the matched join.","+class DomainRestriction {","+public:","+\tDomainRestriction(LogicalAggregate &aggregate_p, ExpressionType consumer_comparison_p)","+\t    : aggregate(aggregate_p), consumer_comparison(consumer_comparison_p) {","+\t\tjoin = Find(*aggregate.children[0], *aggregate.groups[0]);","+\t}","+","+public:","+\toptional_ptr<LogicalComparisonJoin> GetJoin() const {","+\t\treturn join;","+\t}","+","+\tbool HasSimpleProjections() const;","+\tbool CanRemove() const;","+\tbool FiltersNullKeys() const {","+\t\treturn join->conditions[0].GetComparisonType() == ExpressionType::COMPARE_EQUAL &&","+\t\t       consumer_comparison == ExpressionType::COMPARE_NOT_DISTINCT_FROM;","+\t}","+\tvoid Apply(unique_ptr<LogicalAggregate> &domain, RestrictionAction action);","+","+private:","+\toptional_ptr<LogicalComparisonJoin> Find(LogicalOperator &input, const Expression &key);","+","+private:","+\tLogicalAggregate &aggregate;","+\tExpressionType consumer_comparison;","+\toptional_ptr<LogicalComparisonJoin> join;","+\tvector<reference<LogicalProjection>> projections;","+};","+","+optional_ptr<LogicalComparisonJoin> DomainRestriction::Find(LogicalOperator &input, const Expression &key) {","+\tif (input.type == LogicalOperatorType::LOGICAL_PROJECTION) {","+\t\tauto index = ReferenceIndex(key, input);","+\t\tif (!index.IsValid()) {","+\t\t\treturn nullptr;","+\t\t}","+\t\tprojections.push_back(input.Cast<LogicalProjection>());","+\t\treturn Find(*input.children[0], *input.expressions[index.GetIndex()]);","+\t}","+\tif (input.type != LogicalOperatorType::LOGICAL_COMPARISON_JOIN) {","+\t\treturn nullptr;","+\t}","+\tauto &join = input.Cast<LogicalComparisonJoin>();","+\tif (join.join_type != JoinType::SEMI || join.conditions.size() != 1 || !join.expressions.empty() ||","+\t    !join.duplicate_eliminated_columns.empty() || join.filter_pushdown || !join.conditions[0].IsComparison()) {","+\t\treturn nullptr;","+\t}","+\tauto &condition = join.conditions[0];","+\tif ((condition.GetComparisonType() != ExpressionType::COMPARE_EQUAL &&","+\t     condition.GetComparisonType() != ExpressionType::COMPARE_NOT_DISTINCT_FROM) ||","+\t    !key.Equals(condition.GetLHS()) || !ReferenceIndex(key, *join.children[0]).IsValid() ||","+\t    !ReferenceIndex(condition.GetRHS(), *join.children[1]).IsValid()) {","+\t\treturn nullptr;","+\t}","+\treturn join;","+}","+","+bool DomainRestriction::HasSimpleProjections() const {","+\tfor (auto &projection : projections) {","+\t\tfor (auto &expression : proj