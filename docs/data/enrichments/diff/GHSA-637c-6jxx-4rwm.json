cy {","+\t\treturn token, nil","+\t}","+\tif err := validateK8sSATokenAudiences(token, allowed); err != nil {","+\t\treturn nil, err","+\t}","+\treturn token, nil","+}","+","+// validateAddress checks the Vault destination before accessing credentials.","+func (vh *HashicorpVaultHandler) validateAddress(logger logr.Logger) error {","+\tpolicy := globalConfig.OutboundEndpointPolicy","+\tswitch policy {","+\tcase \"\", outboundPolicyOff:","+\t\treturn nil","+\tcase outboundPolicyWarn, outboundPolicyEnforce:","+\tdefault:","+\t\treturn fmt.Errorf(\"unsupported %s.hashiCorpVault.mode %q\", OutboundFilterEnvVar, policy)","+\t}","+\tallowed := globalConfig.AllowedOutboundEndpoints","+\tfor _, endpoint := range allowed {","+\t\tif vaultAddressesEqual(endpoint, vh.vault.Address) {","+\t\t\treturn nil","+\t\t}","+\t}","+\tif policy == outboundPolicyWarn {","+\t\tlogger.Info(\"Warning: Vault endpoint is outside the allowlist; credentials may be sent to an untrusted destination. Configure KEDA_OUTBOUND_FILTER.hashiCorpVault with mode enforce and trusted allowedEndpoints\", \"vaultOrigin\", vh.origin())","+\t\treturn nil","+\t}","+\tif len(allowed) == 0 {","+\t\treturn errors.New(\"no outbound endpoint allowlist is configured in enforce mode (KEDA_OUTBOUND_FILTER.hashiCorpVault.allowedEndpoints)\")","+\t}","+\treturn fmt.Errorf(\"vault endpoint %q is not in the configured allowlist (KEDA_OUTBOUND_FILTER.hashiCorpVault.allowedEndpoints)\", vh.origin())","+}","+","+func (vh *HashicorpVaultHandler) origin() string {","+\taddress, err := url.Parse(vh.vault.Address)","+\tif err != nil {","+\t\treturn \"<invalid endpoint>\"","+\t}","+\treturn (&url.URL{Scheme: address.Scheme, Host: address.Host}).String()","+}","+","+// vaultAddressesEqual compares two Vault addresses by scheme+host+port, ignoring path and trailing","+// slashes, to avoid trivial allowlist bypasses via string prefixing.","+func vaultAddressesEqual(a, b string) bool {","+\tua, erra := url.Parse(strings.TrimSpace(a))","+\tub, errb := url.Parse(strings.TrimSpace(b))","+\tif erra != nil || errb != nil {","+\t\treturn false","+\t}","+\tif ua.User != nil || ub.User != nil || ua.Hostname() == \"\" || ub.Hostname() == \"\" {","+\t\treturn false","+\t}","+\tif ua.Scheme != \"http\" && ua.Scheme != \"https\" || ub.Scheme != \"http\" && ub.Scheme != \"https\" {","+\t\treturn false","+\t}","+\treturn strings.EqualFold(ua.Scheme, ub.Scheme) && strings.EqualFold(ua.Host, ub.Host)","+}","+"," // renewToken takes charge of renewing the vault token"," func (vh *HashicorpVaultHandler) renewToken(logger logr.Logger) {"," \tsecret, err := vh.client.Auth().Token().RenewSelf(0)"],"additions":108,"deletions":24,"truncated":false},{"path":"pkg/scaling/resolver/hashicorpvault_handler_test.go","lines":["@@ -17,6 +17,7 @@ limitations under the License."," package resolver"," "," import (","+\t\"context\""," \t\"encoding/base64\""," \t\"encoding/json\""," \t\"fmt\"","@@ -26,10 +27,14 @@ import ("," \t\"testing\""," \t\"time\""," ","+\t\"github.com/golang-jwt/jwt/v5\""," \tvaultapi \"github.com/hashicorp/vault/api\""," \t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"go.uber.org/atomic\""," \t\"go.uber.org/mock/gomock\""," \tauthv1 \"k8s.io/api/authentication/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," \tlogf \"sigs.k8s.io/controller-runtime/pkg/log\""," "," \tkedav1alpha1 \"github.com/kedacore/keda/v2/apis/keda/v1alpha1\"","@@ -208,6 +213,10 @@ func mockVault(t *testing.T, useRootToken bool) *httptest.Server {"," func TestHashicorpVaultHandler_getSecretValue_specify_secret_type(t *testing.T) {"," \tserver := mockVault(t, false)"," \tdefer server.Close()","+","+\tprevCfg := globalConfig","+\tSetConfig(&Config{AllowedOutboundEndpoints: []string{server.URL}})","+\tdefer SetConfig(&prevCfg)"," \tctrl := gomock.NewController(t)"," \tmockCoreV1Interface := mock_serviceaccounts.NewMockCoreV1Interface(ctrl)"," \tmockSecretLister := mock_secretlister.New