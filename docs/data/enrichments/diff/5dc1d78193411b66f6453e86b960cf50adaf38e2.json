ithOutline(view, ownsOutlineClip)","+    if (useOutlineClip && !ownsOutlineClip) {","+      view.setTag(R.id.padding_box_outline_clip, true)","+      view.clipToOutline = true","+    } else if (!useOutlineClip) {","+      clearPaddingBoxOutlineClip(view)","+    }","+    return useOutlineClip","+  }","+","+  /**","+   * Android 9 and 10 clip with a non-anti-aliased Canvas.clipPath. Earlier versions are left alone:","+   * their OpenGL renderer replaces, rather than intersects, an inherited round-rect outline clip,","+   * so nested rounded clips would escape their parent.","+   */","+  private fun usesOutlineForRoundedClip(): Boolean =","+      Build.VERSION.SDK_INT in Build.VERSION_CODES.P..Build.VERSION_CODES.Q","+","+  private fun canClipPaddingBoxWithOutline(view: View, ownsOutlineClip: Boolean): Boolean {","+    if (","+        !usesOutlineForRoundedClip() ||","+            !(ownsOutlineClip || !view.clipToOutline) ||","+            view.outlineProvider !== ViewOutlineProvider.BACKGROUND ||","+            view.getTag(R.id.filter) != null","+    ) {","+      return false","+    }","+","+    val composite = getCompositeBackgroundDrawable(view) ?: return false","+    // The outline clip also clips the view's own background, so a feedback ripple drawn there","+    // (bounded or borderless in place) would be cut where the canvas clip never cut it.","+    return composite.outerShadows.isEmpty() &&","+        composite.feedbackUnderlay == null &&","+        (composite.outline?.outlineWidth ?: 0f) == 0f &&","+        composite.getUniformBorderRadiusWithoutBorder() != null","+  }","+","+  private fun clearPaddingBoxOutlineClip(view: View) {","+    if (view.getTag(R.id.padding_box_outline_clip) == true) {","+      view.setTag(R.id.padding_box_outline_clip, null)","+      view.clipToOutline = false","+    }","+  }","+","   /**","    * Populates [outRect] with the padding box rect of the view.","    *","@@ -544,10 +628,11 @@ public object BackgroundStyleApplicator {","    