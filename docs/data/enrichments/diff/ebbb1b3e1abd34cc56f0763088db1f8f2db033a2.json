{"id":"ebbb1b3e1abd34cc56f0763088db1f8f2db033a2","axis":"silent","repo":"pnpm/pnpm","sha":"ebbb1b3e1abd34cc56f0763088db1f8f2db033a2","parsed":{"files":[{"path":".changeset/sync-injected-deps-dedicated-lockfiles.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/workspace.injected-deps-syncer\": patch","+\"@pnpm/exec.commands\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+With `sharedWorkspaceLockfile: false`, a script listed in `syncInjectedDepsAfterScripts` now updates the injected copies of the package it ran in. Before, those copies kept the files from the last install."],"additions":8,"deletions":0,"truncated":false},{"path":".changeset/sync-injected-deps-publish-directory.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/workspace.injected-deps-syncer\": patch","+\"@pnpm/exec.commands\": patch","+\"pnpm\": patch","+---","+","+A script listed in `syncInjectedDepsAfterScripts` now updates the injected copies of a package that publishes from `publishConfig.directory`. Before, those copies kept the files from the last install."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pipeline/execution.rs","lines":["@@ -6,7 +6,7 @@ use super::{","     make_node_require_option, package_map_path_for_execution, pnp_path_for_execution, run_stages,","     sync_injected_deps,"," };","-use crate::cli_args::reporter::script_output_colors;","+use crate::cli_args::{reporter::script_output_colors, run::project_modules_dirs};"," "," #[derive(Clone, Copy)]"," pub(super) struct RunTaskOptions<'a, 'graph> {","@@ -367,6 +367,7 @@ fn sync_injected_deps_if_configured(","         return Ok(());","     }","     let manifest = graph[node.project.as_path()].package.project.manifest.value();","+    let project_modules_dirs = project_modules_dirs(config)?;","     sync_injected_deps(&SyncInjectedDeps {","         pkg_name: manifest.get(\"name\").and_then(Value::as_str),","         pkg_root_dir: &node.project,","@@ -374,6 +375,7 @@ fn sync_injected_deps_if_configured(","         workspace_modules_dir: &config.modules_dir,","         include_only_package_files: !config.deploy_all_files,","         manifest_before_scripts: Some(manifest),","+        project_modules_dirs: &project_modules_dirs,","         bin_links: BinLinkSettings {","             modules_dir_name: config.modules_dir_name(),","             extend_node_path: config.extend_node_path,"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/run.rs","lines":["@@ -1,6 +1,7 @@"," pub(crate) use environment::script_environment;"," pub(crate) use execution::exec_scripts_prepend_node_path;"," pub(super) use execution::{RunContext, get_run_script_commands, run_stages};","+pub(crate) use injected_sync::project_modules_dirs;"," pub(super) use listing::ScriptSelector;"," "," use super::{"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/run/injected_sync.rs","lines":["@@ -2,10 +2,12 @@"," //! copies while it runs, then hardlink-sync them after it succeeds."," "," use super::{RunContext, Value};","+use pnpm_config::Config;"," use pnpm_injected_deps_syncer::{","-    BinLinkSettings, InjectedEditWatch, SyncInjectedDeps, injected_edit_sources,","+    BinLinkSettings, InjectedEditWatch, ProjectModulesDir, SyncInjectedDeps, injected_edit_sources,","     sync_injected_deps, watch_injected_edits,"," };","+use pnpm_workspace::{FindWorkspaceProjectsOpts, find_workspace_projects};"," "," pub(super) fn start_injected_edit_watch(","     ctx: &RunContext<'_>,","@@ -14,24 +16,61 @@ pub(super) fn start_injected_edit_watch(","     if !syncs_injected_deps_after(ctx, name) {","         return None;","     }","-    let sources = injected_edit_sources(&injected_sync_opts(ctx));","+    // The sync after the script reports a failure to list the projects, so","+    // it does not stop the script from starting.","+    let project_modules_dirs = project_modules_dirs(ctx.config).unwrap_or_default();","+    let sources = injected_edit_sources(&injected_sync_opts(ctx, &project_modules_dirs));","     (!sources.is_empty()).then(|| watch_injected_edits(sources))"," }"," "," pub(super) fn sync_injected_deps_after(ctx: &RunContext<'_>, name: &str) -> miette::Result<()> {","     if syncs_injected_deps_after(ctx, name) {","-        sync_injected_deps(&injected_sync_opts(ctx))?;","+        let project_modules_dirs = project_modules_dirs(ctx.config)?;","+        sync_injected_deps(&injected_sync_opts(ctx, &project_modules_dirs))?;","     }","     Ok(())"," }"," ","+/// See [`SyncInjectedDeps::project_modules_dirs`]. Each project's modules","+/// directory is the one its install uses.","+pub(crate) fn project_modules_dirs(config: &Config) -> miette::Result<Vec<ProjectModulesDir>> {","+    let Some(workspace_dir) = config.workspace_dir.as_deref() else { return Ok(Vec::new()) };","+    if config.shared_workspace_lockfile {","+        return Ok(Vec::new());","+    }","+    let projects = find_workspace_projects(","+        workspace_dir,","+        &FindWorkspaceProjectsOpts {","+            patterns: config.workspace_package_patterns.clone(),","+            ignored_directories: config.managed_directories(),","+        },","+    )","+    .map_err(miette::Report::new)?;","+    Ok(projects","+        .into_iter()","+        .map(|project| {","+            let name = project.manifest","+                .value()","+                .get(\"name\")","+                .and_then(Value::as_str);","+            ProjectModulesDir {","+                modules_dir: config.project_modules_dir(&project.root_dir, name),","+                project_dir: project.root_dir,","+            }","+        })","+        .collect())","+}","+"," fn syncs_injected_deps_after(ctx: &RunContext<'_>, name: &str) -> bool {","     ctx.config.sync_injected_deps_after_scripts","         .iter()","         .any(|script| script == name)"," }"," ","-fn injected_sync_opts<'a>(ctx: &'a RunContext<'_>) -> SyncInjectedDeps<'a> {","+fn injected_sync_opts<'a>(","+    ctx: &'a RunContext<'_>,","+    project_modules_dirs: &'a [ProjectModulesDir],","+) -> SyncInjectedDeps<'a> {","     SyncInjectedDeps {","         pkg_name: ctx.manifest","             .value()","@@ -43,6 +82,7 @@ fn injected_sync_opts<'a>(ctx: &'a RunContext<'_>) -> SyncInjectedDeps<'a> {","         include_only_package_files: !ctx.config.deploy_all_files,","         // Read before the script ran, so a bin it drops can still be named.","         manifest_before_scripts: Some(ctx.manifest.value()),","+        project_modules_dirs,","         bin_links: BinLinkSettings {","             modules_dir_name: ctx.config.modules_dir_name(),","             extend_node_path: ctx.config.extend_node_path,"],"additions":44,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/injected_copy_equivalence.rs","lines":["@@ -0,0 +1,270 @@","+//! Every writer of an injected copy leaves the files the install selects:","+//! the package's packlist, or every file under `deployAllFiles`","+//! (pnpm/tasks#145).","+//!","+//! The writers, in the order a scenario runs them:","+//!","+//! 1. the install, which also refreshes the copy after the package's","+//!    `prepare` script;","+//! 2. the sync after a script listed in `syncInjectedDepsAfterScripts`;","+//! 3. the same sync after a source edit;","+//! 4. a frozen install into a clean tree.","+","+use crate::_utils::{WorkspaceFixture, assert_success, copy_sources, walk_files};","+","+use std::{","+    collections::BTreeMap,","+    fs,","+    path::{Path, PathBuf},","+};","+","+use serde_json::{Value, json};","+","+#[derive(Debug, Clone, Copy)]","+struct Layout {","+    shared_lockfile: bool,","+    hoisted: bool,","+    deploy_all_files: bool,","+}","+","+/// `writer.cjs` writes `dist/<name>.js`, which `files` lists, and","+/// `<name>.log`, which it leaves out.","+const WRITER: &str = \"const fs = require('fs')\\n\\","+const name = process.argv[2]\\n\\","+fs.mkdirSync(__dirname + '/dist', { recursive: true })\\n\\","+fs.writeFileSync(__dirname + '/dist/' + name + '.js', fs.readFileSync(__dirname + '/index.js'))\\n\\","+fs.writeFileSync(__dirname + '/' + name + '.log', name)\\n\";","+","+struct Scenario {","+    fixture: WorkspaceFixture,","+    layout: Layout,","+}","+","+impl Scenario {","+    /// `app` injects `lib`. `lib` lists `dist` and `index.js` in `files`,","+    /// and also holds a README that every packlist includes, a source file","+    /// and a secret that `files` leaves out.","+    fn new(layout: Layout) -> Self {","+        let fixture = WorkspaceFixture::new();","+        fixture.append_workspace_yaml(&format!(","+            \"sharedWorkspaceLockfile: {}\\nnodeLinker: {}\\ndeployAllFiles: {}\\n\\","+             dedupeInjectedDeps: false\\nsyncInjectedDepsAfterScripts:\\n  - build\\n\",","+            layout.shared_lockfile,","+            if layout.hoisted { \"hoisted\" } else { \"isolated\" },","+            layout.deploy_all_files,","+        ));","+        let scenario = Self { fixture, layout };","+        scenario.write_manifest(\"root\", \"\", json!({}));","+        scenario.write_manifest(","+            \"app\",","+            \"packages/app\",","+            json!({","+                \"dependencies\": { \"lib\": \"workspace:*\" },","+                \"dependenciesMeta\": { \"lib\": { \"injected\": true } },","+            }),","+        );","+        scenario.write_manifest(","+            \"lib\",","+            \"packages/lib\",","+            json!({","+                \"files\": [\"dist\", \"index.js\"],","+                \"scripts\": {","+                    \"prepare\": \"node writer.cjs prepared\",","+                    \"build\": \"node writer.cjs built\",","+                },","+            }),","+        );","+        let lib = scenario.lib();","+        for (file, contents) in [","+            (\"writer.cjs\", WRITER),","+            (\"index.js\", \"module.exports = 1\\n\"),","+            (\"README.md\", \"# lib\\n\"),","+            (\"secret.txt\", \"secret\\n\"),","+            (\"src/source.ts\", \"export default 1\\n\"),","+        ] {","+            let path = lib.join(file);","+            fs::create_dir_all(path.parent().expect(\"a parent\")).expect(\"create a directory\");","+            fs::write(path, contents).expect(\"write a lib file\");","+        }","+        scenario","+    }","+","+    fn workspace(&self) -> &Path {","+        &self.fixture.workspace","+    }","+","+    fn lib(&self) -> PathBuf {","+        self.workspace().join(\"packages/lib\")","+    }","+","+    fn write_manifest(&self, name: &str, dir: &str, fields: Value) {","+        let dir = self.workspace().join(dir);","+        fs::create_dir_all(&dir).expect(\"create the project dir\");","+        let mut manifest = json!({ \"name\": name, \"version\": \"1.0.0\", \"private\": true });","+        let Value::Object(fields) = fields else { panic!(\"the fields must be an object\") };","+        manifest","+            .as_object_mut()","+            .expect(\"a manifest object\")","+            .extend(fields);","+        fs::write(dir.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+    }","+","+    fn run(&self, cwd: &Path, args: &[&str]) {","+        assert_success(&self.fixture.command_at(cwd, args));","+    }","+","+    /// The files the install selects from `lib` in `workspace`, by path,","+    /// with their contents.","+    fn expected_files(&self, workspace: &Path) -> BTreeMap<String, Vec<u8>> {","+        let lib = workspace.join(\"packages/lib\");","+        let paths: Vec<String> = if self.layout.deploy_all_files {","+            files_under(&lib).into_keys().collect()","+        } else {","+            self.packlist(&lib)","+        };","+        paths","+            .into_iter()","+            .map(|path| {","+                let contents = fs::read(lib.join(&path)).expect(\"read a packed file\");","+                (path, contents)","+            })","+            .collect()","+    }","+","+    /// `pnpm pack --dry-run` of a copy of `lib`, so no script touches it.","+    fn packlist(&self, lib: &Path) -> Vec<String> {","+        let copy = self.workspace().with_file_name(\"packlist-source\");","+        let _ = fs::remove_dir_all(&copy);","+        copy_sources(lib, &copy);","+        let output = self.fixture.command_at(","+            &copy,","+            [\"pack\", \"--dry-run\", \"--json\", \"--ignore-scripts\", \"--reporter=silent\"],","+        );","+        assert_success(&output);","+        let packed: Value = serde_json::from_slice(&output.stdout).expect(\"parse pack --json\");","+        packed[\"files\"]","+            .as_array()","+            .expect(\"a files list\")","+            .iter()","+            .map(|file| {","+                file[\"path\"]","+                    .as_str()","+                    .expect(\"a path\")","+                    .to_string()","+            })","+            .collect()","+    }","+","+    /// The injected copy that `app` in `workspace` resolves `lib` to.","+    fn injected_copy(&self, workspace: &Path) -> PathBuf {","+        let app = workspace.join(\"packages/app\");","+        let found = app","+            .ancestors()","+            .map(|dir| dir.join(\"node_modules/lib\"))","+            .find(|candidate| candidate.join(\"package.json\").is_file())","+            .unwrap_or_else(|| panic!(\"{:?}: app does not resolve lib\", self.layout));","+        let copy = fs::canonicalize(found).expect(\"canonicalize the copy\");","+        let source = fs::canonicalize(workspace.join(\"packages/lib\")).expect(\"canonicalize lib\");","+        assert_ne!(copy, source, \"{:?}: lib is linked, not injected\", self.layout);","+        copy","+    }","+","+    #[track_caller]","+    fn assert_copy(&self, workspace: &Path, writer: &str) {","+        let actual = files_under(&self.injected_copy(workspace));","+        let expected = self.expected_files(workspace);","+        assert_eq!(","+            actual.keys().collect::<Vec<_>>(),","+            expected.keys().collect::<Vec<_>>(),","+            \"{:?}, after {writer}: the injected copy holds other files than the install selects\",","+            self.layout,","+        );","+        let differing: Vec<(&String, String, String)> = actual","+            .iter()","+            .filter(|(path, contents)| expected.get(*path) != Some(*contents))","+            .map(|(path, contents)| {","+                (","+                    path,","+                    String::from_utf8_lossy(contents).into_owned(),","+                    String::from_utf8_lossy(&expected[path]).into_owned(),","+                )","+            })","+            .collect();","+        assert!(","+            differing.is_empty(),","+            \"{:?}, after {writer}: files of the injected copy differ from the source \\","+             (path, copy, source): {differing:#?}\",","+            self.layout,","+        );","+    }","+}","+","+/// Every file under `dir` outside `node_modules`, by its `/`-separated path.","+fn files_under(dir: &Path) -> BTreeMap<String, Vec<u8>> {","+    walk_files(dir)","+        .into_iter()","+        .filter_map(|path| {","+            let relative = path.strip_prefix(dir).expect(\"under the directory\");","+            if relative","+                .components()","+                .any(|part| part.as_os_str() == \"node_modules\")","+            {","+                return None;","+            }","+            let contents = fs::read(&path).expect(\"read a file\");","+            Some((relative.to_string_lossy().replace('\\\\', \"/\"), contents))","+        })","+        .collect()","+}","+","+fn check(layout: Layout) {","+    let scenario = Scenario::new(layout);","+    let workspace = scenario.workspace().to_path_buf();","+    let lib = scenario.lib();","+","+    scenario.run(&workspace, &[\"install\"]);","+    assert!(lib.join(\"dist/prepared.js\").is_file(), \"the install ran lib's prepare\");","+    scenario.assert_copy(&workspace, \"the install\");","+","+    scenario.run(&lib, &[\"run\", \"build\"]);","+    scenario.assert_copy(&workspace, \"a listed script\");","+","+    fs::write(lib.join(\"index.js\"), \"module.exports = 2\\n\").expect(\"edit index.js\");","+    scenario.run(&lib, &[\"run\", \"build\"]);","+    scenario.assert_copy(&workspace, \"a listed script after an edit\");","+","+    let clean = workspace.with_file_name(\"clean\");","+    copy_sources(&workspace, &clean);","+    scenario.run(&clean, &[\"install\", \"--frozen-lockfile\"]);","+    scenario.assert_copy(&clean, \"a frozen install into a clean tree\");","+}","+","+macro_rules! matrix {","+    ($($name:ident: $layout:expr,)*) => {","+        $(","+            #[test]","+            fn $name() {","+                check($layout);","+            }","+        )*","+    };","+}","+","+matrix! {","+    shared_isolated: Layout { shared_lockfile: true, hoisted: false, deploy_all_files: false },","+    shared_hoisted: Layout { shared_lockfile: true, hoisted: true, deploy_all_files: false },","+    dedicated_isolated: Layout { shared_lockfile: false, hoisted: false, deploy_all_files: false },","+    dedicated_hoisted: Layout { shared_lockfile: false, hoisted: true, deploy_all_files: false },","+    shared_isolated_all_files: Layout { shared_lockfile: true, hoisted: false, deploy_all_files: true },","+    shared_hoisted_all_files: Layout { shared_lockfile: true, hoisted: true, deploy_all_files: true },","+    dedicated_isolated_all_files: Layout {","+        shared_lockfile: false,","+        hoisted: false,","+        deploy_all_files: true,","+    },","+    dedicated_hoisted_all_files: Layout {","+        shared_lockfile: false,","+        hoisted: true,","+        deploy_all_files: true,","+    },","+}"],"additions":270,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -80,6 +80,7 @@ mod import;"," mod import_yarn_patches;"," mod init;"," mod inject_workspace_packages;","+mod injected_copy_equivalence;"," mod injected_deps_with_dedicated_lockfiles;"," mod injected_freshness_matrix;"," mod install;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/sync_injected_deps_after_scripts.rs","lines":["@@ -476,3 +476,73 @@ fn a_listed_script_removes_the_link_of_a_bin_it_dropped() {"," ","     drop((mock_instance, root));"," }","+","+#[test]","+fn a_listed_script_syncs_the_copies_of_a_package_that_publishes_from_a_directory() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    // A `**` pattern would make the built `lib/dist` a workspace project too.","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - app\\n  - lib\\ndedupeInjectedDeps: false\\nsyncInjectedDepsAfterScripts:\\n  - build\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    for (dir, manifest) in [","+        (","+            \"app\",","+            serde_json::json!({","+                \"name\": \"app\",","+                \"version\": \"1.0.0\",","+                \"dependencies\": { \"lib\": \"workspace:*\" },","+                \"dependenciesMeta\": { \"lib\": { \"injected\": true } },","+            }),","+        ),","+        (","+            \"lib\",","+            serde_json::json!({","+                \"name\": \"lib\",","+                \"version\": \"1.0.0\",","+                \"publishConfig\": { \"directory\": \"dist\" },","+                \"scripts\": { \"prepare\": \"node build.cjs\", \"build\": \"node build.cjs\" },","+            }),","+        ),","+    ] {","+        fs::create_dir_all(workspace.join(dir)).expect(\"create a project\");","+        fs::write(workspace.join(dir).join(\"package.json\"), manifest.to_string())","+            .expect(\"write a manifest\");","+    }","+    // Replaces dist, so the new files share no inode with the injected copy.","+    fs::write(","+        workspace.join(\"lib/build.cjs\"),","+        \"const fs = require('fs')\\n\\","+         fs.rmSync(__dirname + '/dist', { recursive: true, force: true })\\n\\","+         fs.mkdirSync(__dirname + '/dist')\\n\\","+         fs.writeFileSync(__dirname + '/dist/package.json', JSON.stringify({ name: 'lib', version: '1.0.0' }))\\n\\","+         fs.writeFileSync(__dirname + '/dist/index.js', fs.readFileSync(__dirname + '/src.js'))\\n\",","+    )","+    .expect(\"write the build script\");","+    fs::write(workspace.join(\"lib/src.js\"), \"v1\").expect(\"write the source\");","+","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let copy = fs::canonicalize(workspace.join(\"app/node_modules/lib\")).expect(\"find the copy\");","+    assert_eq!(fs::read_to_string(copy.join(\"index.js\")).expect(\"read the copy\"), \"v1\");","+","+    fs::write(workspace.join(\"lib/src.js\"), \"v2\").expect(\"edit the source\");","+    pacquet_in(&workspace.join(\"lib\"))","+        .with_args([\"run\", \"build\"])","+        .assert()","+        .success();","+    assert_eq!(fs::read_to_string(copy.join(\"index.js\")).expect(\"read the copy\"), \"v2\");","+","+    drop((root, mock_instance));","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"pnpm/crates/injected-deps-syncer/src/bin_links.rs","lines":["@@ -10,15 +10,14 @@ use std::{","     sync::Arc,"," };"," ","-use crate::{BinLinkSettings, SyncInjectedDepsError};","+use crate::{BinLinkSettings, SyncInjectedDepsError, injection_records::InjectedCopy};"," "," /// Package and workspace locations for updating binary links."," pub(crate) struct SyncBinLinks<'a> {","     pub(crate) pkg_root_dir: &'a Path,","-    pub(crate) resolved_targets: &'a [PathBuf],","+    pub(crate) copies: &'a [InjectedCopy],","     pub(crate) workspace_dir: &'a Path,","     pub(crate) previous_bin_names: &'a [String],","-    pub(crate) hoisted_bin_dir: Option<&'a Path>,","     pub(crate) settings: &'a BinLinkSettings<'a>,"," }"," ","@@ -58,27 +57,27 @@ pub(crate) fn sync_bin_links(opts: &SyncBinLinks<'_>) -> Result<(), SyncInjected","     let manifest = Arc::new(manifest);","     let link_options = workspace_link_options(opts);"," ","-    for target_dir in opts.resolved_targets {","-        sync_target_bins(target_dir, &manifest, opts, &stale_bin_names, &link_options)?;","+    for copy in opts.copies {","+        sync_target_bins(copy, &manifest, &stale_bin_names, &link_options)?;","     }"," ","     relink_project_bins(opts, has_bins, &stale_bin_names)"," }"," "," fn sync_target_bins(","-    target_dir: &Path,","+    copy: &InjectedCopy,","     manifest: &Arc<serde_json::Value>,","-    opts: &SyncBinLinks<'_>,","     stale_bin_names: &[&String],","     link_options: &LinkBinsOptions,"," ) -> Result<(), SyncInjectedDepsError> {","+    let target_dir = copy.dir.as_path();","     let Some(parent_modules_dir) = target_dir.parent() else {","         return Ok(());","     };","     remove_stale_bins(RemoveStaleBins {","         target_dir,","         parent_modules_dir,","-        hoisted_bin_dir: opts.hoisted_bin_dir,","+        hoisted_bin_dir: copy.hoisted_bin_dir.as_deref(),","         stale_bin_names,","     })?;"," "],"additions":7,"deletions":8,"truncated":false},{"path":"pnpm/crates/injected-deps-syncer/src/injection_records.rs","lines":["@@ -0,0 +1,110 @@","+//! The `.modules.yaml` files that list the injected copies of a package.","+","+use std::path::{Path, PathBuf};","+","+use crate::{SyncInjectedDeps, SyncInjectedDepsError, hoisted_bin_path, read_workspace_modules};","+","+/// A project with its own lockfile, and the modules directory that holds","+/// its `.modules.yaml`.","+pub struct ProjectModulesDir {","+    pub project_dir: PathBuf,","+    pub modules_dir: PathBuf,","+}","+","+/// A `.modules.yaml` and the directory its injected-copy paths are","+/// relative to: the workspace root, or a project with its own lockfile.","+pub(crate) struct InjectionRecord {","+    pub(crate) lockfile_dir: PathBuf,","+    pub(crate) modules: Option<pnpm_modules_yaml::Modules>,","+}","+","+/// An injected copy, and the `.bin` its install hoists the virtual","+/// store's bins into.","+pub(crate) struct InjectedCopy {","+    pub(crate) dir: PathBuf,","+    pub(crate) hoisted_bin_dir: Option<PathBuf>,","+}","+","+/// The modules manifests that list injected copies: the workspace root's,","+/// and each of [`SyncInjectedDeps::project_modules_dirs`].","+pub(crate) fn injection_records(","+    opts: &SyncInjectedDeps<'_>,","+    workspace_dir: &Path,","+) -> Result<Vec<InjectionRecord>, SyncInjectedDepsError> {","+    let mut records = vec![InjectionRecord {","+        lockfile_dir: workspace_dir.to_path_buf(),","+        modules: read_workspace_modules(opts.workspace_modules_dir)?,","+    }];","+    let workspace_root = pnpm_fs::lexical_normalize(workspace_dir);","+    for project in opts.project_modules_dirs {","+        if pnpm_fs::lexical_normalize(&project.project_dir) == workspace_root {","+            continue;","+        }","+        records.push(InjectionRecord {","+            lockfile_dir: project.project_dir.clone(),","+            modules: read_workspace_modules(&project.modules_dir)?,","+        });","+    }","+    Ok(records)","+}","+","+/// The resolved directories that hold injected copies of `content_source_dir`,","+/// or `None` if there are none to sync.","+fn resolved_injected_targets(","+    opts: &SyncInjectedDeps<'_>,","+    lockfile_dir: &Path,","+    source_dir: &Path,","+    modules: Option<&pnpm_modules_yaml::Modules>,","+) -> Option<Vec<PathBuf>> {","+    let Some(injected_deps) = modules.and_then(|modules| modules.injected_deps.as_ref()) else {","+        tracing::debug!(","+            target: \"pacquet::sync_injected_deps\",","+            \"Skipping sync of injected dependencies because none were detected\",","+        );","+        return None;","+    };","+","+    let Some(target_dirs) = injected_deps","+        .get(&injected_dep_key(lockfile_dir, source_dir))","+        .filter(|dirs| !dirs.is_empty())","+    else {","+        tracing::debug!(","+            target: \"pacquet::sync_injected_deps\",","+            pkg_root_dir = ?opts.pkg_root_dir,","+            \"There are no injected dependencies from this package\",","+        );","+        return None;","+    };","+","+    Some(","+        target_dirs","+            .iter()","+            .map(|target_dir| lockfile_dir.join(target_dir))","+            .collect(),","+    )","+}","+","+/// The key `.modules.yaml` files an injected dependency under: the","+/// package's path relative to the manifest's lockfile directory, with","+/// forward slashes on every host.","+fn injected_dep_key(lockfile_dir: &Path, pkg_root_dir: &Path) -> String {","+    pnpm_fs::relative_path(lockfile_dir, pkg_root_dir).to_string_lossy().replace('\\\\', \"/\")","+}","+","+/// Every copy of `source` that `records` list.","+pub(crate) fn copies_of_source(","+    opts: &SyncInjectedDeps<'_>,","+    records: &[InjectionRecord],","+    source: &Path,","+) -> Vec<InjectedCopy> {","+    records","+        .iter()","+        .flat_map(|record| {","+            let hoisted_bin_dir = hoisted_bin_path(&record.lockfile_dir, record.modules.as_ref());","+            resolved_injected_targets(opts, &record.lockfile_dir, source, record.modules.as_ref())","+                .unwrap_or_default()","+                .into_iter()","+                .map(move |dir| InjectedCopy { dir, hoisted_bin_dir: hoisted_bin_dir.clone() })","+        })","+        .collect()","+}"],"additions":110,"deletions":0,"truncated":false},{"path":"pnpm/crates/injected-deps-syncer/src/lib.rs","lines":["@@ -13,15 +13,18 @@ pub use dir_patcher::{","     Change, DirDiff, DirPatcher, FileId, InodeMap, PatchError, Value