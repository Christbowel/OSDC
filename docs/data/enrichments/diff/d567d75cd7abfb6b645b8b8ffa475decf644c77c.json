d","+}","+","+const pathsOfSync = (input: Uint8Array | ArrayBuffer) => {","+  const found: string[] = []","+  for (const entry of entriesSync(input)) {","+    found.push(`${entry.path}=${entry.text()}`)","+  }","+  return found","+}","+","+const expect = ['a.txt=alpha', 'b.txt=beta']","+","+describe('the type checks', () => {","+  test('isUint8Array', () => {","+    assert.equal(isUint8Array(new Uint8Array(1)), true)","+    assert.equal(isUint8Array(Buffer.from('a')), true)","+    assert.equal(isUint8Array(otherBytes(tar)), true)","+    assert.equal(isUint8Array(new Uint16Array(1)), false)","+    assert.equal(isUint8Array(new DataView(new ArrayBuffer(1))), false)","+    assert.equal(isUint8Array(new ArrayBuffer(1)), false)","+    assert.equal(isUint8Array([1]), false)","+    assert.equal(isUint8Array(undefined), false)","+  })","+","+  test('isArrayBuffer', () => {","+    assert.equal(isArrayBuffer(new ArrayBuffer(1)), true)","+    assert.equal(isArrayBuffer(otherBuffer(tar)), true)","+    assert.equal(isArrayBuffer(new Uint8Array(1)), false)","+    assert.equal(isArrayBuffer(undefined), false)","+  })","+","+  test('isBlob and isReadableStream', () => {","+    const blob = new Blob(['a'])","+    assert.equal(isBlob(blob), true)","+    assert.equal(isBlob(new File(['a'], 'a')), true)","+    assert.equal(isBlob(blob.stream()), false)","+    assert.equal(isBlob(new Uint8Array(1)), false)","+    assert.equal(isBlob(undefined), false)","+    assert.equal(isReadableStream(blob.stream()), true)","+    assert.equal(isReadableStream(blob), false)","+    assert.equal(isReadableStream([new Uint8Array(1)]), false)","+    assert.equal(isReadableStream(undefined), false)","+  })","+})","+","+describe('a Uint8Array of a different realm', () => {","+  test('the block of a Header', () => {","+    const header = new Header(otherBytes(tar))","+    assert.match(header, { path: 'a.txt', size: 5, cksumValid: true })","+  })","+","+  test('the input of entries and of entriesSync', async () => {","+    assert.deepEqual(await pathsOf(otherBytes(tar)), expect)","+    assert.deepEqual(pathsOfSync(otherBytes(tar)), expect)","+  })","+","+  test('the input of list and of listSync', async () => {","+    const found: string[] = []","+    const onEntry = (entry: { path: string }) => found.push(entry.path)","+    await list({ input: otherBytes(tar), onEntry })","+    listSync({ input: otherBytes(tar), onEntry })","+    assert.deepEqual(found, ['a.txt', 'b.txt', 'a.txt', 'b.txt'])","+  })","+","+  test('the body of a WriteEntry, in Pack and in PackSync', async () => {","+    const body = otherBytes(new TextEncoder().encode('alpha'))","+    const entry = new WriteEntry({ path: 'a.txt' }, body)","+    assert.equal(entry.size, 5)","+    assert.equal(entry.body, body)","+    const expect = [{ entry: { path: 'a.txt', size: 5 }, body: 'alpha' }]","+    assert.match(read(await collect(new Pack().add(entry).end())), expect)","+    assert.match(read(await collect(new PackSync().add(entry))), expect)","+  })","+})","+","+describe('an ArrayBuffer of a different realm', () => {","+  test('the input of entries and of entriesSync', async () => {","+    assert.deepEqual(await pathsOf(otherBuffer(tar)), expect)","+    assert.deepEqual(pathsOfSync(otherBuffer(tar)), expect)","+  })","+})","+","+test('a Date of a different realm, in a PAX header', async () => {","+  const mtime = vm.runInNewContext('new Date(1500)') as Date","+  assert(!(mtime instanceof Date))","+  // A long path needs a PAX header, and that header has the time.","+  const path = 'a'.repeat(200)","+  const entry = new WriteEntry({ path, mtime }, 'alpha')","+  const data = await collect(new Pack().add(entry).end())","+  assert.match(read(data), [","+    { entry: { path, mtime: new Date(1500) }, body: 'alpha' },","+  ])","+})","+","+// The constructors of this realm are not the ones that made the","+// objects, as when a different window made them.","+describe('a Blob and a ReadableStream of a different realm', () => {","+  class Other {}","+","+  test('a Blob is the input of entries', async () => {","+    const blob = new Blob([tar])","+    stub(globalThis, 'Blob', Other as unknown as typeof Blob)","+    assert(!(blob instanceof Blob))","+    assert.deepEqual(await pathsOf(blob as unknown as Uint8Array), expect)","+  })","+","+  test('a ReadableStream is the input of entries', async () => {","+    const stream = new Blob([tar]).stream()","+    stub(","+      globalThis,","+      'ReadableStream',","+      Other as unknown as typeof ReadableStream,","+    )","+    assert(!(stream instanceof ReadableStream))","+    const found: string[] = []","+    for await (const entry of entries(stream)) {","+      found.push(","+        `${entry.path}=${new TextDecoder().decode(await entry.bytes())}`,","+      )","+    }","+    assert.deepEqual(found, expect)","+  })","+","+  test('a Blob is the body of a WriteEntry', async () => {","+    const blob = new Blob(['alpha'])","+    stub(globalThis, 'Blob', Other as unknown as typeof Blob)","+    const entry = new WriteEntry({ path: 'a.txt' }, blob)","+    assert.equal(entry.size, 5)","+    const data = await collect(new Pack().add(entry).end())","+    assert.match(read(data), [{ entry: { path: 'a.txt' }, body: 'alpha' }])","+  })","+","+  test('a ReadableStream is the body of a WriteEntry', async () => {","+    const stream = new Blob(['alpha']).stream()","+    stub(","+      globalThis,","+      'ReadableStream',","+      Other as unknown as typeof ReadableStream,","+    )","+    const entry = new WriteEntry({ path: 'a.txt', size: 5 }, stream)","+    const data = await collect(new Pack().add(entry).end())","+    assert.match(read(data), [{ entry: { path: 'a.txt' }, body: 'alpha' }])","+  })","+})",""],"additions":187,"deletions":0,"truncated":false}],"additions":238,"deletions":20,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-28T17:09:41.966385+00:00"}