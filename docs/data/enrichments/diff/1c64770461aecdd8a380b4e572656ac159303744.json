   /// The prefix as a big-endian integer, so that integer order is the byte order of the prefix.","+    #[inline(always)]","+    fn prefix_order_key(&self) -> u32 {","+        u32::from_be_bytes(self.prefix.to_le_bytes())","+    }","+","+    /// The inlined bytes after the prefix as a big-endian integer, so that integer order is their","+    /// byte order. Only meaningful for an inlined view.","+    #[inline(always)]","+    fn inline_suffix_order_key(&self) -> u64 {","+        let [b0, b1, b2, b3] = self.buffer_idx.to_le_bytes();","+        let [b4, b5, b6, b7] = self.offset.to_le_bytes();","+        u64::from_be_bytes([b0, b1, b2, b3, b4, b5, b6, b7])","+    }","+}","+","+/// Whether the values of two views are equal.","+///","+/// The length and prefix are compared as one `u64`, then the inlined bytes as another, so the","+/// data buffers are only read for long values that share both length and prefix. This relies on","+/// the zero padding of inlined views that the Arrow format requires.","+#[inline(always)]","+pub(crate) fn views_eq<'a, 'b>(","+    lhs: &View,","+    rhs: &View,","+    lhs_bytes: impl FnOnce() -> &'a [u8],","+    rhs_bytes: impl FnOnce() -> &'b [u8],","+) -> bool {","+    if lhs.length_and_prefix() != rhs.length_and_prefix() {","+        return false;","+    }","+    if lhs.is_inline() {","+        // Same length, so both are inlined.","+        return lhs.suffix() == rhs.suffix();","+    }","+    // Long values of the same length: the first 4 bytes are the equal prefixes.","+    lhs_bytes()[View::PREFIX_LEN..] == rhs_bytes()[View::PREFIX_LEN..]","+}","+","+/// Compares the values of two views, deciding from the prefixes alone when they differ.","+#[inline(always)]","+pub(crate) fn views_cmp<'a, 'b>(","+    lhs: &View,","+    rhs: &View,","+    lhs_bytes: impl FnOnce() -> &'a [u8],","+    rhs_bytes: impl FnOnce() -> &'b [u8],","+) -> Ordering {","+    // Prefixes are zero padded, so a prefix that differs differs at a byte both values have, or