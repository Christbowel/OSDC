{"id":"035ab809248f7765d327f54f869fa2a3026eca80","axis":"silent","repo":"tensorflow/tensorflow","sha":"035ab809248f7765d327f54f869fa2a3026eca80","parsed":{"files":[{"path":"tensorflow/compiler/mlir/lite/BUILD","lines":["@@ -1132,6 +1132,20 @@ cc_library(","     ],"," )"," ","+cc_library(","+    name = \"resource_constant_fold_utils\",","+    hdrs = [","+        \"transforms/resource_constant_fold_utils.h\",","+    ],","+    deps = [","+        \"@com_google_absl//absl/container:flat_hash_map\",","+        \"@com_google_absl//absl/strings\",","+        \"@llvm-project//llvm:Support\",","+        \"@llvm-project//mlir:IR\",","+        \"@llvm-project//mlir:Support\",","+    ],","+)","+"," cc_library(","     name = \"large_constant_fold\",","     srcs = [","@@ -1144,6 +1158,7 @@ cc_library(","         \":attribute_utils\",","         \":large_constant_fold_pass_options\",","         \":pass\",","+        \":resource_constant_fold_utils\",","         \":tensorflow_lite_ops\",","         \":utils\",","         \"//tensorflow/compiler/mlir/lite/quantization/common/quantization_lib\",","@@ -1587,6 +1602,7 @@ cc_library(","         \":elements_attr_roundtrip_pass\",","         \":op_quant_spec_getters_inc\",","         \":optimize_broadcast_like_pass_options\",","+        \":resource_constant_fold_utils\",","         \":shape_and_size_utils\",","         \":stateful_ops_utils\",","         \":tensorflow_lite\",","@@ -1625,6 +1641,7 @@ cc_library(","         \"@llvm-project//mlir:IR\",","         \"@llvm-project//mlir:Pass\",","         \"@llvm-project//mlir:QuantOps\",","+        \"@llvm-project//mlir:Rewrite\",","         \"@llvm-project//mlir:Support\",","         \"@llvm-project//mlir:TransformUtils\",","         \"@stablehlo//:stablehlo_ops\","],"additions":17,"deletions":0,"truncated":false},{"path":"tensorflow/compiler/mlir/lite/python/stablehlo_tfl_pipeline.cc","lines":["@@ -152,8 +152,7 @@ void AddPipelinePasses(mlir::OpPassManager& pass_manager,","   // func.call boundaries that cause func.call result type mismatches when","   // quantized types are introduced.","   pass_manager.addPass(mlir::createInlinerPass());","-  pass_manager.addNestedPass<mlir::func::FuncOp>(","-      mlir::TFL::CreateFoldStablehloConstantTransformsPass());","+  pass_manager.addPass(mlir::TFL::CreateFoldStablehloConstantTransformsPass());","   pass_manager.addPass(mlir::TFL::CreateLowerQuantAnnotationsPass());","   pass_manager.addPass(mlir::createSymbolDCEPass());"," "],"additions":1,"deletions":2,"truncated":false},{"path":"tensorflow/compiler/mlir/lite/tests/fold-stablehlo-constant-transforms.mlir","lines":["@@ -0,0 +1,212 @@","+// Copyright 2026 The TensorFlow Authors. All Rights Reserved.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+// ==============================================================================","+// RUN: litert-opt %s --tfl-fold-stablehlo-constant-transforms | FileCheck %s","+","+// CHECK-LABEL: func.func @transpose_dense_i8","+func.func @transpose_dense_i8() -> tensor<3x2xi8> {","+  // CHECK: %[[CST:.+]] = stablehlo.constant dense<{{\\[\\[}}1, 4], [2, 5], [3, 6]]> : tensor<3x2xi8>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: return %[[CST]]","+  %0 = stablehlo.constant dense<[[1, 2, 3], [4, 5, 6]]> : tensor<2x3xi8>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi8>) -> tensor<3x2xi8>","+  return %1 : tensor<3x2xi8>","+}","+","+// CHECK-LABEL: func.func @transpose_dense_i4","+func.func @transpose_dense_i4() -> tensor<3x2xi4> {","+  // CHECK: %[[CST:.+]] = stablehlo.constant dense<{{\\[\\[}}1, 4], [2, -5], [3, -6]]> : tensor<3x2xi4>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: return %[[CST]]","+  %0 = stablehlo.constant dense<[[1, 2, 3], [4, -5, -6]]> : tensor<2x3xi4>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi4>) -> tensor<3x2xi4>","+  return %1 : tensor<3x2xi4>","+}","+","+// CHECK-LABEL: func.func @transpose_dense_i2_rank3","+func.func @transpose_dense_i2_rank3() -> tensor<3x2x2xi2> {","+  // CHECK: %[[CST:.+]] = stablehlo.constant dense<{{\\[\\[\\[}}0, 1], [-2, -1]], {{\\[\\[}}-2, -1], [0, 1]], {{\\[\\[}}0, 1], [-2, -1]]]> : tensor<3x2x2xi2>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: return %[[CST]]","+  %0 = stablehlo.constant dense<[[[0, 1], [-2, -1], [0, 1]], [[-2, -1], [0, 1], [-2, -1]]]> : tensor<2x3x2xi2>","+  %1 = stablehlo.transpose %0, dims = [1, 0, 2] : (tensor<2x3x2xi2>) -> tensor<3x2x2xi2>","+  return %1 : tensor<3x2x2xi2>","+}","+","+// i1 is bit packed in DenseElementsAttr and is not folded.","+// CHECK-LABEL: func.func @transpose_dense_i1_not_folded","+func.func @transpose_dense_i1_not_folded() -> tensor<3x2xi1> {","+  // CHECK: stablehlo.transpose","+  %0 = stablehlo.constant dense<[[true, false, true], [false, true, false]]> : tensor<2x3xi1>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi1>) -> tensor<3x2xi1>","+  return %1 : tensor<3x2xi1>","+}","+","+// A resource whose only user is the transpose is transposed in place and","+// keeps its key. Packed i4, two elements per byte with the first element in","+// the low nibble: [[1, 2, 3], [4, 5, 6]] -> [[1, 4], [2, 5], [3, 6]].","+// CHECK-LABEL: func.func @transpose_resource_packed_i4","+func.func @transpose_resource_packed_i4() -> tensor<3x2xi4> {","+  // CHECK: %[[CST:.+]] = stablehlo.constant dense_resource<packed_i4> : tensor<3x2xi4>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: return %[[CST]]","+  %0 = stablehlo.constant dense_resource<packed_i4> : tensor<2x3xi4>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi4>) -> tensor<3x2xi4>","+  return %1 : tensor<3x2xi4>","+}","+","+// Unpacked i4 blob, one element per byte.","+// CHECK-LABEL: func.func @transpose_resource_unpacked_i4","+func.func @transpose_resource_unpacked_i4() -> tensor<3x2xi4> {","+  // CHECK: stablehlo.constant dense_resource<unpacked_i4> : tensor<3x2xi4>","+  // CHECK-NOT: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<unpacked_i4> : tensor<2x3xi4>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi4>) -> tensor<3x2xi4>","+  return %1 : tensor<3x2xi4>","+}","+","+// Packed i2 blob whose element count is not a multiple of four:","+// [[0, 1, 2], [3, 0, 1], [2, 3, 0]] -> [[0, 3, 2], [1, 0, 3], [2, 1, 0]].","+// CHECK-LABEL: func.func @transpose_resource_packed_i2","+func.func @transpose_resource_packed_i2() -> tensor<3x3xi2> {","+  // CHECK: stablehlo.constant dense_resource<packed_i2> : tensor<3x3xi2>","+  // CHECK-NOT: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<packed_i2> : tensor<3x3xi2>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<3x3xi2>) -> tensor<3x3xi2>","+  return %1 : tensor<3x3xi2>","+}","+","+// A sub-byte blob of an unexpected size is left alone.","+// CHECK-LABEL: func.func @transpose_resource_bad_size_i4_not_folded","+func.func @transpose_resource_bad_size_i4_not_folded() -> tensor<3x2xi4> {","+  // CHECK: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<bad_size_i4> : tensor<2x3xi4>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi4>) -> tensor<3x2xi4>","+  return %1 : tensor<3x2xi4>","+}","+","+// Rank 3 i8: 1..12 -> 1, 2, 7, 8, 3, 4, 9, 10, 5, 6, 11, 12.","+// CHECK-LABEL: func.func @transpose_resource_i8_rank3","+func.func @transpose_resource_i8_rank3() -> tensor<3x2x2xi8> {","+  // CHECK: stablehlo.constant dense_resource<i8_1_to_12> : tensor<3x2x2xi8>","+  // CHECK-NOT: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<i8_1_to_12> : tensor<2x3x2xi8>","+  %1 = stablehlo.transpose %0, dims = [1, 0, 2] : (tensor<2x3x2xi8>) -> tensor<3x2x2xi8>","+  return %1 : tensor<3x2x2xi8>","+}","+","+// The pattern of a head-major einsum weight: transpose, then reshape. Both","+// fold into the original blob without copies.","+// CHECK-LABEL: func.func @transpose_then_reshape_resource","+func.func @transpose_then_reshape_resource() -> tensor<3x4xi4> {","+  // CHECK: %[[CST:.+]] = stablehlo.constant dense_resource<packed_i4_1_to_12> : tensor<3x4xi4>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK-NOT: stablehlo.reshape","+  // CHECK: return %[[CST]]","+  %0 = stablehlo.constant dense_resource<packed_i4_1_to_12> : tensor<2x3x2xi4>","+  %1 = stablehlo.transpose %0, dims = [1, 0, 2] : (tensor<2x3x2xi4>) -> tensor<3x2x2xi4>","+  %2 = stablehlo.reshape %1 : (tensor<3x2x2xi4>) -> tensor<3x4xi4>","+  return %2 : tensor<3x4xi4>","+}","+","+// A reshape before the transpose reuses the blob too, and the transpose then","+// folds in place.","+// CHECK-LABEL: func.func @reshape_then_transpose_resource","+func.func @reshape_then_transpose_resource() -> tensor<3x2xi8> {","+  // CHECK: %[[CST:.+]] = stablehlo.constant dense_resource<i8_six> : tensor<3x2xi8>","+  // CHECK-NOT: stablehlo.reshape","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: return %[[CST]]","+  %0 = stablehlo.constant dense_resource<i8_six> : tensor<6xi8>","+  %1 = stablehlo.reshape %0 : (tensor<6xi8>) -> tensor<2x3xi8>","+  %2 = stablehlo.transpose %1, dims = [1, 0] : (tensor<2x3xi8>) -> tensor<3x2xi8>","+  return %2 : tensor<3x2xi8>","+}","+","+// A blob shared by constants in two functions, transposed the same way in","+// both, is transposed once in place.","+// CHECK-LABEL: func.func @shared_same_perm_0","+func.func @shared_same_perm_0() -> tensor<3x2xi8> {","+  // CHECK: stablehlo.constant dense_resource<i8_shared_same> : tensor<3x2xi8>","+  // CHECK-NOT: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<i8_shared_same> : tensor<2x3xi8>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi8>) -> tensor<3x2xi8>","+  return %1 : tensor<3x2xi8>","+}","+// CHECK-LABEL: func.func @shared_same_perm_1","+func.func @shared_same_perm_1() -> tensor<3x2xi8> {","+  // CHECK: stablehlo.constant dense_resource<i8_shared_same> : tensor<3x2xi8>","+  // CHECK-NOT: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<i8_shared_same> : tensor<2x3xi8>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi8>) -> tensor<3x2xi8>","+  return %1 : tensor<3x2xi8>","+}","+","+// A blob transposed in two different ways gets one copy per result, and the","+// source blob is released.","+// CHECK-LABEL: func.func @shared_different_perms","+func.func @shared_different_perms() -> (tensor<3x2x2xi8>, tensor<2x2x3xi8>) {","+  // CHECK-DAG: stablehlo.constant dense_resource<[[$KEY_P102:i8_shared_diff_transpose_1_0_2[_0-9]*]]> : tensor<3x2x2xi8>","+  // CHECK-DAG: stablehlo.constant dense_resource<[[$KEY_P021:i8_shared_diff_transpose_0_2_1[_0-9]*]]> : tensor<2x2x3xi8>","+  // CHECK-NOT: stablehlo.transpose","+  %0 = stablehlo.constant dense_resource<i8_shared_diff> : tensor<2x3x2xi8>","+  %1 = stablehlo.transpose %0, dims = [1, 0, 2] : (tensor<2x3x2xi8>) -> tensor<3x2x2xi8>","+  %2 = stablehlo.transpose %0, dims = [0, 2, 1] : (tensor<2x3x2xi8>) -> tensor<2x2x3xi8>","+  return %1, %2 : tensor<3x2x2xi8>, tensor<2x2x3xi8>","+}","+","+// A blob with a user other than the transpose keeps its data, and the","+// transpose gets a copy.","+// CHECK-LABEL: func.func @shared_with_other_user","+func.func @shared_with_other_user() -> (tensor<2x3xi8>, tensor<3x2xi8>) {","+  // CHECK-DAG: %[[ORIG:.+]] = stablehlo.constant dense_resource<i8_other_user> : tensor<2x3xi8>","+  // CHECK-DAG: %[[COPY:.+]] = stablehlo.constant dense_resource<[[$KEY_OTHER:i8_other_user_transpose_1_0[_0-9]*]]> : tensor<3x2xi8>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: return %[[ORIG]], %[[COPY]]","+  %0 = stablehlo.constant dense_resource<i8_other_user> : tensor<2x3xi8>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi8>) -> tensor<3x2xi8>","+  return %0, %1 : tensor<2x3xi8>, tensor<3x2xi8>","+}","+","+// CHECK-LABEL: dialect_resources","+// CHECK-DAG: packed_i4: \"0x04000000415263\"","+// CHECK-DAG: unpacked_i4: \"0x04000000010402050306\"","+// CHECK-DAG: packed_i2: \"0x040000006C6C00\"","+// CHECK-DAG: bad_size_i4: \"0x0400000021436500\"","+// CHECK-DAG: i8_1_to_12: \"0x04000000010207080304090A05060B0C\"","+// CHECK-DAG: packed_i4_1_to_12: \"0x04000000218743A965CB\"","+// CHECK-DAG: i8_six: \"0x04000000010402050306\"","+// CHECK-DAG: i8_shared_same: \"0x04000000010402050306\"","+// CHECK-DAG: [[$KEY_P102]]: \"0x40000000010207080304090A05060B0C\"","+// CHECK-DAG: [[$KEY_P021]]: \"0x4000000001030502040607090B080A0C\"","+// CHECK-DAG: i8_other_user: \"0x04000000010203040506\"","+// CHECK-DAG: [[$KEY_OTHER]]: \"0x40000000010402050306\"","+// CHECK-NOT: i8_shared_diff:","+","+{-#","+  dialect_resources: {","+    builtin: {","+      packed_i4: \"0x04000000214365\",","+      unpacked_i4: \"0x04000000010203040506\",","+      packed_i2: \"0x04000000E4E400\",","+      bad_size_i4: \"0x0400000021436500\",","+      i8_1_to_12: \"0x040000000102030405060708090A0B0C\",","+      packed_i4_1_to_12: \"0x0400000021436587A9CB\",","+      i8_six: \"0x04000000010203040506\",","+      i8_shared_same: \"0x04000000010203040506\",","+      i8_shared_diff: \"0x040000000102030405060708090A0B0C\",","+      i8_other_user: \"0x04000000010203040506\"","+    }","+  }","+#-}"],"additions":212,"deletions":0,"truncated":false},{"path":"tensorflow/compiler/mlir/lite/tests/lower-quant-annotations-unfolded-weight.mlir","lines":["@@ -0,0 +1,54 @@","+// Copyright 2026 The TensorFlow Authors. All Rights Reserved.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+// ==============================================================================","+// RUN: litert-opt %s --tfl-fold-stablehlo-constant-transforms --tfl-lower-quant-annotations | FileCheck %s","+// RUN: litert-opt %s --tfl-lower-quant-annotations -verify-diagnostics","+","+// A pre-quantized i4 weight that is transposed before it is dequantized. Once","+// the transpose is folded into the constant, the dequantize lowers to a","+// quantized constant. Without the fold, the pass reports the unfolded op","+// instead of producing a transpose with mismatched element types.","+// CHECK-LABEL: func.func @dequantize_transposed_i4_weight","+func.func @dequantize_transposed_i4_weight() -> tensor<3x2xf32> {","+  // CHECK: %[[QCST:.+]] = \"tfl.pseudo_qconst\"() <{qtype = tensor<3x2x!quant.uniform<i4:f32:1, {1.000000e+00,2.000000e+00}>>, value = dense_resource<packed_i4> : tensor<3x2xi4>}>","+  // CHECK-NOT: stablehlo.transpose","+  // CHECK: %[[DQ:.+]] = \"tfl.dequantize\"(%[[QCST]])","+  // CHECK: return %[[DQ]]","+  %0 = stablehlo.constant dense_resource<packed_i4> : tensor<2x3xi4>","+  %1 = stablehlo.transpose %0, dims = [1, 0] : (tensor<2x3xi4>) -> tensor<3x2xi4>","+  // expected-error @+1 {{the input of quant.dequantize must be a constant, but it is produced by 'stablehlo.transpose' with operand type 'tensor<2x3xi4>', which was not folded into a constant}}","+  %2 = stablehlo.custom_call @quant.dequantize(%1) {dtype = \"i4\", narrow_range = false, quantization_dimension = 1 : i32, scale = dense<[1.0, 2.0]> : tensor<2xf32>} : (tensor<3x2xi4>) -> tensor<3x2xf32>","+  return %2 : tensor<3x2xf32>","+}","+","+// A shape op over a non-constant quantized value is still retyped.","+// CHECK-LABEL: func.func @dequantize_reshaped_activation","+func.func @dequantize_reshaped_activation(%arg0: tensor<2x2xf32>) -> tensor<4xf32> {","+  // CHECK: %[[Q:.+]] = \"tfl.quantize\"(%arg0)","+  // CHECK: %[[R:.+]] = stablehlo.reshape %[[Q]] : (tensor<2x2x!quant.uniform<i8:f32, 5.000000e-01>>) -> tensor<4x!quant.uniform<i8:f32, 5.000000e-01>>","+  // CHECK: %[[DQ:.+]] = \"tfl.dequantize\"(%[[R]])","+  // CHECK: return %[[DQ]]","+  %0 = stablehlo.custom_call @quant.quantize(%arg0) {dtype = \"i8\", narrow_range = false, scale = dense<0.5> : tensor<1xf32>} : (tensor<2x2xf32>) -> tensor<2x2xi8>","+  %1 = stablehlo.reshape %0 : (tensor<2x2xi8>) -> tensor<4xi8>","+  %2 = stablehlo.custom_call @quant.dequantize(%1) {dtype = \"i8\", narrow_range = false, scale = dense<0.5> : tensor<1xf32>} : (tensor<4xi8>) -> tensor<4xf32>","+  return %2 : tensor<4xf32>","+}","+","+{-#","+  dialect_resources: {","+    builtin: {","+      packed_i4: \"0x04000000214365\"","+    }","+  }","+#-}"],"additions":54,"deletions":0,"truncated":false},{"path":"tensorflow/compiler/mlir/lite/transforms/fold_stablehlo_constant_transforms_pass.cc","lines":["@@ -13,35 +13,37 @@ See the License for the specific language governing permissions and"," limitations under the License."," ==============================================================================*/"," ","-#include <atomic>","+#include <cstddef>"," #include <cstdint>","-#include <cstring>"," #include <memory>"," #include <string>"," #include <utility>"," ","+#include \"absl/strings/str_cat.h\""," #include \"llvm/ADT/ArrayRef.h\""," #include \"llvm/ADT/SmallVector.h\"","-#include \"llvm/Support/FormatVariadic.h\"","-#include \"mlir/Dialect/Arith/IR/Arith.h\"  // from @llvm-project","-#include \"mlir/Dialect/Func/IR/FuncOps.h\"  // from @llvm-proje