","+import java.util.Collection;","+import java.util.List;","+import java.util.Set;","+","+import org.hibernate.validator.constraints.Hexadecimal;","+","+public class ModelWithHexadecimalConstraints {","+","+\t@Hexadecimal","+\tpublic String string;","+","+\t@Hexadecimal","+\tpublic StringBuilder stringBuilder;","+","+\t@Hexadecimal","+\tpublic Integer integer;","+","+\t@Hexadecimal","+\tpublic Collection<String> collection;","+","+\t@Hexadecimal","+\tpublic List<String> list;","+","+\t@Hexadecimal","+\tpublic Set<String> set;","+","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"documentation/src/main/asciidoc/reference/_ch02.adoc","lines":["@@ -722,6 +722,10 @@ The default is `ANY`, which means both IPv4 and IPv6 addresses are considered va"," \tSupported data types::: `CharSequence`"," \tHibernate metadata impact::: None"," ","+`@Hexadecimal(letterCase=, strictness=, allowEmpty=, prefix=)`:: Validates that the annotated character sequence contains only hexadecimal characters (`0-9`, `a-f`, `A-F`). `null` is always valid. `letterCase` accepts `LOWER_CASE` (only `0-9a-f`), `UPPER_CASE` (only `0-9A-F`) or `INSENSITIVE` (default, any mix of cases). `strictness` accepts `STRICT` (default, ASCII characters only) or `LENIENT` (additionally accepts the fullwidth forms `０-９`, `ａ-ｆ`, `Ａ-Ｆ`). An empty character sequence is invalid by default; set `allowEmpty` to allow it. `prefix` is a leading marker that must be present when non-empty; the well-known prefixes `0x` and `#` are matched exactly, while any other value is treated as a regular expression anchored to the start of the value. The `letterCase` and `strictness` attributes only apply to the characters following the prefix.","+\tSupported data types::: `CharSequence`","+\tHibernate metadata impact::: None","+"," `@LuhnCheck(startIndex= , endIndex=, checkDigitIndex=, ignoreNonDigitCharacters=)`:: Checks that the digits within the annotated character sequence pass the Luhn checksum algorithm (see also http://en.wikipedia.org/wiki/Luhn_algorithm[Luhn algorithm]). `startIndex` and `endIndex` allow to only run the algorithm on the specified sub-string. `checkDigitIndex` allows to use an arbitrary digit within the character sequence as the check digit. If not specified it is assumed that the check digit is part of the specified range. Last but not least, `ignoreNonDigitCharacters` allows to ignore non digit characters."," \tSupported data types::: `CharSequence`"," \tHibernate metadata impact::: None"],"additions":4,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/cfg/defs/HexadecimalDef.java","lines":["@@ -0,0 +1,45 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+","+package org.hibernate.validator.cfg.defs;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.cfg.ConstraintDef;","+import org.hibernate.validator.constraints.Hexadecimal;","+import org.hibernate.validator.constraints.Hexadecimal.HexStrictness;","+import org.hibernate.validator.constraints.Hexadecimal.LetterCase;","+","+/**","+ * Constraint definition for {@link Hexadecimal}.","+ *","+ * @since 9.2","+ */","+@Incubating","+public class HexadecimalDef extends ConstraintDef<HexadecimalDef, Hexadecimal> {","+","+\tpublic HexadecimalDef() {","+\t\tsuper( Hexadecimal.class );","+\t}","+","+\tpublic HexadecimalDef letterCase(LetterCase letterCase) {","+\t\taddParameter( \"letterCase\", letterCase );","+\t\treturn this;","+\t}","+","+\tpublic HexadecimalDef strictness(HexStrictness strictness) {","+\t\taddParameter( \"strictness\", strictness );","+\t\treturn this;","+\t}","+","+\tpublic HexadecimalDef allowEmpty(boolean allowEmpty) {","+\t\taddParameter( \"allowEmpty\", allowEmpty );","+\t\treturn this;","+\t}","+","+\tpublic HexadecimalDef prefix(String prefix) {","+\t\taddParameter( \"prefix\", prefix );","+\t\treturn this;","+\t}","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/constraints/Hexadecimal.java","lines":["@@ -0,0 +1,165 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.constraints;","+","+import static java.lang.annotation.ElementType.ANNOTATION_TYPE;","+import static java.lang.annotation.ElementType.CONSTRUCTOR;","+import static java.lang.annotation.ElementType.FIELD;","+import static java.lang.annotation.ElementType.METHOD;","+import static java.lang.annotation.ElementType.PARAMETER;","+import static java.lang.annotation.ElementType.TYPE_USE;","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+import java.lang.annotation.Documented;","+import java.lang.annotation.Repeatable;","+import java.lang.annotation.Retention;","+import java.lang.annotation.Target;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.constraints.Hexadecimal.List;","+","+/**","+ * Checks that the annotated character sequence contains only hexadecimal characters","+ * ({@code 0-9}, {@code a-f}, {@code A-F}).","+ * <p>","+ * The supported type is {@code CharSequence}. {@code null} is considered valid.","+ * <p>","+ * Validation characteristics:","+ * <ul>","+ * <li>Letter case ({@code letterCase}): {@code LOWER_CASE} accepts only {@code 0-9a-f}, {@code UPPER_CASE} only","+ * {@code 0-9A-F}, and {@code INSENSITIVE} (default) accepts any mix of cases.</li>","+ * <li>Strictness ({@code strictness}): {@code STRICT} (default) accepts only the ASCII hex characters;","+ * {@code LENIENT} additionally accepts the fullwidth forms ({@code ０-９}, {@code ａ-ｆ}, {@code Ａ-Ｆ}).</li>","+ * <li>Empty strings: invalid by default, allowed if {@code allowEmpty} is {@code true}.</li>","+ * <li>Prefix ({@code prefix}): an optional leading marker that must be present when set. Well-known prefixes","+ * (see {@link HexPrefixes}) are matched exactly and case-sensitively; any other value is treated as a regular","+ * expression which is anchored to the start of the value. The {@code letterCase} and {@code strictness}","+ * attributes apply only to the characters following the prefix.</li>","+ * </ul>","+ *","+ * @since 9.2","+ */","+@Documented","+@Constraint(validatedBy = { })","+@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+@Retention(RUNTIME)","+@Repeatable(List.class)","+@Incubating","+public @interface Hexadecimal {","+","+\tString message() default \"{org.hibernate.validator.constraints.Hexadecimal.message}\";","+","+\tClass<?>[] groups() default { };","+","+\tClass<? extends Payload>[] payload() default { };","+","+\t/**","+\t * @return the required letter case for the hexadecimal letters.","+\t * Per default, any letter case is accepted.","+\t *","+\t * @see LetterCase","+\t */","+\tLetterCase letterCase() default LetterCase.INSENSITIVE;","+","+\t/**","+\t * @return the accepted character set.","+\t * Per default, only the ASCII hexadecimal characters are accepted.","+\t *","+\t * @see HexStrictness","+\t */","+\tHexStrictness strictness() default HexStrictness.STRICT;","+","+\t/**","+\t * @return whether an empty character sequence (i.e. one containing no hexadecimal characters) is valid.","+\t * Per default, empty character sequences are not valid.","+\t */","+\tboolean allowEmpty() default false;","+","+\t/**","+\t * A leading marker which, when non-empty, must be present at the start of the value.","+\t * <p>","+\t * Well-known prefixes (see {@link HexPrefixes}) are matched exactly and case-sensitively.","+\t * Any other non-empty value is interpreted as a regular expression and is anchored to the","+\t * start of the value; it must not itself start with a {@code ^} character.","+\t * <p>","+\t * The {@code letterCase} and {@code strictness} attributes only apply to the characters","+\t * following the prefix.","+\t *","+\t * @return the prefix to require (empty string means no prefix).","+\t */","+\tString prefix() default \"\";","+","+\t/**","+\t * Required letter case for the hexadecimal letters.","+\t */","+\tenum LetterCase {","+","+\t\t/**","+\t\t * Only lower case is valid","+\t\t */","+\t\tLOWER_CASE,","+","+\t\t/**","+\t\t * Only upper case is valid","+\t\t */","+\t\tUPPER_CASE,","+","+\t\t/**","+\t\t * Every letter case is valid","+\t\t */","+\t\tINSENSITIVE","+\t}","+","+\t/**","+\t * The accepted hexadecimal character set.","+\t */","+\tenum HexStrictness {","+","+\t\t/**","+\t\t * Only the ASCII hexadecimal characters ({@code 0-9}, {@code a-f}, {@code A-F}) are valid.","+\t\t */","+\t\tSTRICT,","+","+\t\t/**","+\t\t * In addition to the ASCII hexadecimal characters, the fullwidth forms","+\t\t * ({@code ０-９}, {@code ａ-ｆ}, {@code Ａ-Ｆ}) are valid as well.","+\t\t */","+\t\tLENIENT","+\t}","+","+\t/**","+\t * Well-known prefixes used with hexadecimal values in various contexts/languages.","+\t */","+\tinterface HexPrefixes {","+","+\t\t/**","+\t\t * No prefix.","+\t\t */","+\t\tString NONE = \"\";","+","+\t\t/**","+\t\t * C/Java/Python-style hexadecimal literal prefix.","+\t\t */","+\t\tString HEX_LITERAL = \"0x\";","+","+\t\t/**","+\t\t * CSS hexadecimal color prefix.","+\t\t */","+\t\tString CSS_COLOR = \"#\";","+\t}","+","+\t/**","+\t * Defines several {@code @Hexadecimal} annotations on the same element.","+\t */","+\t@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+\t@Retention(RUNTIME)","+\t@Documented","+\tpublic @interface List {","+\t\tHexadecimal[] value();","+\t}","+}"],"additions":165,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/constraintvalidators/hv/HexadecimalValidator.java","lines":["@@ -0,0 +1,158 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.internal.constraintvalidators.hv;","+","+import java.lang.invoke.MethodHandles;","+import java.util.regex.Matcher;","+import java.util.regex.Pattern;","+import java.util.regex.PatternSyntaxException;","+","+import jakarta.validation.ConstraintValidator;","+import jakarta.validation.ConstraintValidatorContext;","+","+import org.hibernate.validator.constraints.Hexadecimal;","+import org.hibernate.validator.constraints.Hexadecimal.HexPrefixes;","+import org.hibernate.validator.constraints.Hexadecimal.HexStrictness;","+import org.hibernate.validator.constraints.Hexadecimal.LetterCase;","+import org.hibernate.validator.internal.util.logging.Log;","+import org.hibernate.validator.internal.util.logging.LoggerFactory;","+","+/**","+ * Checks that a given character sequence (e.g. string) contains only hexadecimal characters.","+ *","+ * @since 9.2","+ */","+public class HexadecimalValidator implements ConstraintValidator<Hexadecimal, CharSequence> {","+","+\tprivate static final Log LOG = LoggerFactory.make( MethodHandles.lookup() );","+","+\tprivate LetterCase letterCase;","+","+\tprivate HexStrictness strictness;","+","+\tprivate boolean allowEmpty;","+","+\t/**","+\t * The literal prefix when the configured {@code prefix} is one of the well-known constants","+\t * (matched exactly and case-sensitively).","+\t */","+\tprivate String literalPrefix;","+","+\t/**","+\t * The anchored prefix pattern when the configured {@code prefix} is a regular expression.","+\t */","+\tprivate Pattern prefixPattern;","+","+\t@Override","+\tpublic void initialize(Hexadecimal constraintAnnotation) {","+\t\tletterCase = constraintAnnotation.letterCase();","+\t\tstrictness = constraintAnnotation.strictness();","+\t\tallowEmpty = constraintAnnotation.allowEmpty();","+","+\t\tString prefix = constraintAnnotation.prefix();","+\t\tif ( prefix.isEmpty() ) {","+\t\t\tliteralPrefix = null;","+\t\t\tprefixPattern = null;","+\t\t}","+\t\telse if ( HexPrefixes.HEX_LITERAL.equals( prefix ) || HexPrefixes.CSS_COLOR.equals( prefix ) ) {","+\t\t\tliteralPrefix = prefix;","+\t\t\tprefixPattern = null;","+\t\t}","+\t\telse {","+\t\t\tliteralPrefix = null;","+\t\t\tprefixPattern = compilePrefixPattern( prefix );","+\t\t}","+\t}","+","+\tprivate static Pattern compilePrefixPattern(String prefix) {","+\t\tif ( prefix.charAt( 0 ) == '^' ) {","+\t\t\tthrow LOG.getPrefixCannotStartWithException( '^' );","+\t\t}","+\t\tif ( prefix.charAt( prefix.length() - 1 ) == '$' ) {","+\t\t\tthrow LOG.getPrefixCannotEndWithException( '$' );","+\t\t}","+\t\ttry {","+\t\t\treturn Pattern.compile( \"^\" + prefix );","+\t\t}","+\t\tcatch (PatternSyntaxException e) {","+\t\t\tthrow LOG.getInvalidRegularExpressionException( e );","+\t\t}","+\t}","+","+\t@Override","+\tpublic boolean isValid(CharSequence value, ConstraintValidatorContext context) {","+\t\tif ( value == null ) {","+\t\t\treturn true;","+\t\t}","+","+\t\tint start = 0;","+\t\tif ( literalPrefix != null ) {","+\t\t\tif ( !startsWith( value, literalPrefix ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tstart = literalPrefix.length();","+\t\t}","+\t\telse if ( prefixPattern != null ) {","+\t\t\tMatcher matcher = prefixPattern.matcher( value );","+\t\t\tif ( !matcher.lookingAt() ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tstart = matcher.end();","+\t\t}","+","+\t\tint length = value.length();","+\t\tif ( length == start ) {","+\t\t\t// The value is exactly the prefix, i.e. no hexadecimal characters are present.","+\t\t\treturn allowEmpty;","+\t\t}","+","+\t\tfor ( int i = start; i < length; i++ ) {","+\t\t\tchar c = value.charAt( i );","+\t\t\tif ( !isHexDigit( c, strictness ) || !hasCorrectLetterCase( c, letterCase ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+","+\tprivate static boolean startsWith(CharSequence value, String prefix) {","+\t\tif ( value.length() < prefix.length() ) {","+\t\t\treturn false;","+\t\t}","+\t\tfor ( int i = 0; i < prefix.length(); i++ ) {","+\t\t\tif ( value.charAt( i ) != prefix.charAt( i ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t}","+\t\treturn true;","+\t}","+","+\tprivate static boolean isHexDigit(char c, HexStrictness strictness) {","+\t\t// The ASCII hex characters are always accepted.","+\t\tif ( ( c >= '0' && c <= '9' ) || ( c >= 'a' && c <= 'f' ) || ( c >= 'A' && c <= 'F' ) ) {","+\t\t\treturn true;","+\t\t}","+\t\tif ( strictness == HexStrictness.LENIENT ) {","+\t\t\t// The fullwidth forms of the hex characters.","+\t\t\treturn ( c >= '０' && c <= '９' )","+\t\t\t\t\t|| ( c >= 'ａ' && c <= 'ｆ' )","+\t\t\t\t\t|| ( c >= 'Ａ' && c <= 'Ｆ' );","+\t\t}","+\t\treturn false;","+\t}","+","+\tprivate static boolean hasCorrectLetterCase(char c, LetterCase letterCase) {","+\t\tif ( letterCase == LetterCase.INSENSITIVE ) {","+\t\t\treturn true;","+\t\t}","+\t\t// Digits carry no case and are always accepted; only the hex letters are subject to the case rule.","+\t\tboolean isLowerCase = ( c >= 'a' && c <= 'f' ) || ( c >= 'ａ' && c <= 'ｆ' );","+\t\tboolean isUpperCase = ( c >= 'A' && c <= 'F' ) || ( c >= 'Ａ' && c <= 'Ｆ' );","+\t\tif ( letterCase == LetterCase.LOWER_CASE ) {","+\t\t\treturn !isUpperCase;","+\t\t}","+\t\treturn !isLowerCase;","+\t}","+}"],"additions":158,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/BuiltinConstraint.java","lines":["@@ -56,6 +56,7 @@ enum BuiltinConstraint {"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_CURRENCY( \"org.hibernate.validator.constraints.Currency\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_DATE_TIME_FORMAT( \"org.hibernate.validator.constraints.DateTimeFormat\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_ENDS_WITH( \"org.hibernate.validator.constraints.EndsWith\" ),","+\tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_HEXADEIMAL( \"org.hibernate.validator.constraints.Hexadecimal\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_IBAN( \"org.hibernate.validator.constraints.IBAN\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_IP_ADDRESS( \"org.hibernate.validator.constraints