ked tail, d = 120 runs the AVX2 one-accumulator loop, and d = 568","+// runs the 64-wide loop, three remainder blocks and an 8-lane tail.","+TEST(ScalarQuantizer, Float16AccumulatorLoopParity) {","+    struct RestoreFlag {","+        bool original = faiss::SIMDConfig::sq_avx512_4_accumulators;","+        ~RestoreFlag() {","+            faiss::SIMDConfig::sq_avx512_4_accumulators = original;","+        }","+    } restore_flag;","+    faiss::SIMDConfig::sq_avx512_4_accumulators = true;","+    for (faiss::SIMDLevel level :","+         {faiss::SIMDLevel::AVX512, faiss::SIMDLevel::AVX2}) {","+        if (!faiss::SIMDConfig::is_simd_level_available(level)) {","+            continue;","+        }","+        for (auto qtype :","+             {faiss::ScalarQuantizer::QT_fp16,","+              faiss::ScalarQuantizer::QT_bf16}) {","+            for (auto metric :","+                 {faiss::METRIC_L2, faiss::METRIC_INNER_PRODUCT}) {","+                for (size_t d : {111, 120, 568}) {","+                    SCOPED_TRACE(","+                            testing::Message()","+                            << \"level=\" << static_cast<int>(level)","+                            << \" qtype=\" << static_cast<int>(qtype)","+                            << \" metric=\" << metric << \" d=\" << d);","+                    check_sq_distance_path_parity(level, qtype, metric, d);","+                }","+            }","+        }","+    }","+}","+"," // d == 0 early returns in the RVV DCTemplate loops must give exactly 0"," // without reading the query or the codes."," TEST(ScalarQuantizer, RVVZeroDimDistancePathParity) {",""],"additions":36,"deletions":0,"truncated":false}],"additions":310,"deletions":24,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-02T17:25:02.347991+00:00"}