FirebaseApp } from '@firebase/app';","+import { FirebaseApp, _setTrustedScriptSrc } from '@firebase/app';"," import { getStateReference } from './state';"," import { Deferred } from '@firebase/util';"," import { getRecaptcha, ensureActivated } from './util';","@@ -166,7 +166,7 @@ function renderInvisibleWidget("," "," function loadReCAPTCHAV3Script(onload: () => void): void {","   const script = document.createElement('script');","-  script.src = RECAPTCHA_URL;","+  _setTrustedScriptSrc(script, RECAPTCHA_URL);","   script.onload = onload;","   document.head.appendChild(script);"," }","@@ -174,7 +174,7 @@ function loadReCAPTCHAV3Script(onload: () => void): void {"," function loadReCAPTCHAEnterpriseScript(onload: () => void): void {","   const script = document.createElement('script');","   // This param is required when we plan to render a widget explicitly.","-  script.src = RECAPTCHA_ENTERPRISE_URL + '?render=explicit';","+  _setTrustedScriptSrc(script, RECAPTCHA_ENTERPRISE_URL + '?render=explicit');","   script.onload = onload;","   document.head.appendChild(script);"," }"],"additions":3,"deletions":3,"truncated":false},{"path":"packages/app/src/index.ts","lines":["@@ -27,5 +27,6 @@ import { registerCoreComponents } from './registerCoreComponents';"," export * from './api';"," export * from './internal';"," export * from './public-types';","+export { _setTrustedScriptSrc } from './trustedTypes';"," "," registerCoreComponents('__RUNTIME_ENV__');"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/app/src/trustedTypes.browser.test.ts","lines":["@@ -0,0 +1,202 @@","+/**","+ * @license","+ * Copyright 2026 Google LLC","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+import {","+  _TRUSTED_TYPES_POLICY_NAME,","+  _createTrustedScriptURL,","+  _resetTrustedTypesPolicyForTesting,","+  _setTrustedScriptSrc","+} from './trustedTypes';","+import { logger } from './logger';","+","+const GAPI_URL = 'https://apis.google.com/js/api.js';","+","+describe('Trusted Types', () => {","+  beforeEach(() => {","+    _resetTrustedTypesPolicyForTesting();","+  });","+","+  afterEach(() => {","+    vi.restoreAllMocks();","+    vi.unstubAllGlobals();","+    _resetTrustedTypesPolicyForTesting();","+  });","+","+  describe('_createTrustedScriptURL', () => {","+    it('allows the known script URLs, with or without a query string', () => {","+      for (const url of [","+        'https://www.googletagmanager.com/gtag/js?l=dataLayer&id=G-123',","+        GAPI_URL,","+        `${GAPI_URL}?onload=cb`,","+        'https://www.google.com/recaptcha/api.js?render=explicit&hl=en',","+        'https://www.google.com/recaptcha/enterprise.js?render=siteKey'","+      ]) {","+        expect(_createTrustedScriptURL(url)).toBe(url);","+      }","+    });","+","+    it('rejects other URLs', () => {","+      for (const url of [","+        'https://evil.example/script.js',","+        `${GAPI_URL}.evil.example`,","+        `${GAPI_URL}x`,","+        `${GAPI_URL}/../evil.js`,","+        'http://apis.google.com/js/api.js',","+        'https://apis.google.com/js/other.js'","+      ]) {","+        expect(() => _createTrustedScriptURL(url)).toThrow(","+          'Refusing to load untrusted script URL'","+        );","+      }","+    });","+  });","+","+  describe('_setTrustedScriptSrc', () => {","+    it('sets the script src', () => {","+      const script = document.createElement('script');","+      _setTrustedScriptSrc(script, `${GAPI_URL}?onload=cb`);","+      expect(script.src).toBe(`${GAPI_URL}?onload=cb`);","+    });","+","+    it('does not use setAttribute', () => {","+      const script = document.createElement('script');","+      vi.spyOn(script, 'setAttribute');","+      _setTrustedScriptSrc(script, GAPI_URL);","+      expect(script.setAttribute).not.toHaveBeenCalled();","+    });","+","+    it('passes the URL through the Firebase policy, created only once', () => {","+      const createScriptURL = vi.fn((url: string) => ({","+        toString: () => url","+      }));","+      const createPolicy = vi.fn().mockReturnValue({ createScriptURL });","+      vi.stubGlobal('trustedTypes', { createPolicy });","+","+      const script = document.createElement('script');","+      _setTrustedScriptSrc(script, `${GAPI_URL}?onload=cb`);","+      _setTrustedScriptSrc(document.createElement('script'), GAPI_URL);","+","+      expect(createPolicy).toHaveBeenCalledTimes(1);","+      expect(createPolicy).toHaveBeenCalledWith(_TRUSTED_TYPES_POLICY_NAME, {","+        createScriptURL: _createTrustedScriptURL","+      });","+      expect(createScriptURL).toHaveBeenCalledWith(`${GAPI_URL}?onload=cb`);","+      expect(script.src).toBe(`${GAPI_URL}?onload=cb`);","+    });","+","+    it('throws if the policy rejects the URL', () => {","+      vi.stubGlobal('trustedTypes', {","+        createPolicy: (","+          _name: string,","+          options: { createScriptURL: (url: string) => string }","+        ) => options","+      });","+      const script = document.createElement('script');","+      expect(() =>","+        _setTrustedScriptSrc(script, 'https://evil.example/script.js')","+      ).toThrow('Refusing to load untrusted script URL');","+      expect(script.src).toBe('');","+    });","+","+    it('throws for untrusted URLs when Trusted Types are unavailable', () => {","+      vi.stubGlobal('trustedTypes', undefined);","+      const script = document.createElement('script');","+      expect(() =>","+        _setTrustedScriptSrc(script, 'https://evil.example/script.js')","+      ).toThrow('Refusing to load untrusted script URL');","+      expect(script.src).toBe('');","+    });","+","+    it('throws for untrusted URLs without logging when the policy cannot be created', () => {","+      vi.stubGlobal('trustedTypes', {","+        createPolicy: () => {","+          throw new TypeError('Policy not allowed by CSP');","+        }","+      });","+      const loggerError = vi","+        .spyOn(logger, 'error')","+        .mockImplementation(() => {});","+      // Load an allowed script first so that the policy creation fails and the","+      // blocked state is set before the untrusted URL is tried.","+      _setTrustedScriptSrc(document.createElement('script'), GAPI_URL);","+      const script = document.createElement('script');","+      expect(() =>","+        _setTrustedScriptSrc(script, 'https://evil.example/script.js')","+      ).toThrow('Refusing to load untrusted script URL');","+      expect(script.src).toBe('');","+      expect(loggerError).not.toHaveBeenCalled();","+    });","+","+    it('falls back to a plain string if the policy cannot be created', () => {","+      vi.stubGlobal('trustedTypes', {","+        createPolicy: () => {","+          throw new TypeError('Policy not allowed by CSP');","+        }","+      });","+      const script = document.createElement('script');","+      _setTrustedScriptSrc(script, GAPI_URL);","+      expect(script.src).toBe(GAPI_URL);","+    });","+","+    it('logs the policy name to allow if Trusted Types block the script', () => {","+      vi.stubGlobal('trustedTypes', {","+        createPolicy: () => {","+          throw new TypeError('Policy not allowed by CSP');","+        }","+      });","+      const script = document.createElement('script');","+      const blockedError = new TypeError(","+        'This document requires TrustedScriptURL'","+      );","+      Object.defineProperty(script, 'src', {","+        set: () => {","+          throw blockedError;","+        }","+      });","+      const loggerError = vi","+        .spyOn(logger, 'error')","+        .mockImplementation(() => {});","+","+      expect(() => _setTrustedScriptSrc(script, GAPI_URL)).toThrow(","+        blockedError","+      );","+      expect(loggerError).toHaveBeenCalledWith(","+        expect.stringContaining(","+          `add \"${_TRUSTED_TYPES_POLICY_NAME}\" to the trusted-types directive`","+        )","+      );","+    });","+","+    it('does not log if setting src fails for another reason', () => {","+      vi.stubGlobal('trustedTypes', undefined);","+      const script = document.createElement('script');","+      Object.defineProperty(script, 'src', {","+        set: () => {","+          throw new TypeError('Some other failure');","+        }","+      });","+      const loggerError = vi","+        .spyOn(logger, 'error')","+        .mockImplementation(() => {});","+","+      expect(() => _setTrustedScriptSrc(script, GAPI_URL)).toThrow(","+        'Some other failure'","+      );","+      expect(loggerError).not.toHaveBeenCalled();","+    });","+  });","+});"],"additions":202,"deletions":0,"truncated":false},{"path":"packages/app/src/trustedTypes.ts","lines":["@@ -0,0 +1,161 @@","+/**","+ * @license","+ * Copyright 2026 Google LLC","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+import { logger } from './logger';","+","+/**","+ * Name of the Trusted Types policy that Firebase SDKs use to load external","+ * scripts. Apps that restrict policy names with the `trusted-types` CSP","+ * directive must allow this name.","+ *","+ * @internal","+ */","+export const _TRUSTED_TYPES_POLICY_NAME = 'firebase-js-sdk-policy';","+","+/**","+ * External scripts that Firebase SDKs are allowed to load. A script URL is","+ * allowed if it is one of these URLs, optionally followed by a query string.","+ *","+ * - Analytics: Google tag (gtag.js)","+ * - Auth: Google API loader (gapi), reCAPTCHA v2 and reCAPTCHA Enterprise","+ * - App Check: reCAPTCHA v3 and reCAPTCHA Enterprise","+ */","+const ALLOWED_SCRIPT_URLS = [","+  'https://www.googletagmanager.com/gtag/js',","+  'https://apis.google.com/js/api.js',","+  'https://www.google.com/recaptcha/api.js',","+  'https://www.google.com/recaptcha/enterprise.js'","+];","+","+type ScriptURLPolicy = Pick<TrustedTypePolicy, 'createScriptURL'>;","+","+// `undefined` means the policy has not been created yet. `null` means Trusted","+// Types are unavailable or the policy could not be created.","+let trustedTypesPolicy: ScriptURLPolicy | null | undefined;","+","+// True if the browser supports Trusted Types but the policy could not be","+// created, usually because the page's CSP does not allow the policy name.","+let trustedTypesPolicyBlocked = false;","+","+/**","+ * Returns `url` if it is one of the allowed external scripts, and throws","+ * otherwise. Used as the `createScriptURL` implementation of the Trusted Types","+ * policy.","+ *","+ * @internal","+ */","+export function _createTrustedScriptURL(url: string): string {","+  const allowed = ALLOWED_SCRIPT_URLS.some(","+    allowedUrl =>","+      url.startsWith(allowedUrl) &&","+      // Only allow a query string after the allowed URL, so that e.g.","+      // \"https://apis.google.com/js/api.js.evil.com\" is rejected.","+      (url.length === allowedUrl.length ||","+        url.charAt(allowedUrl.length) === '?')","+  );","+  if (!allowed) {","+    throw new TypeError(","+      `Firebase: Refusing to load untrusted script URL: ${url}`","+    );","+  }","+  return url;","+}","+","+/**","+ * Lazily creates the Trusted Types policy. The policy is only created the first","+ * time a script is loaded, so that pages that load more than one copy of","+ * `@firebase/app` (for example the compat and modular CDN builds) only run","+ * into a policy name collision if more than one copy loads a script.","+ */","+function getTrustedTypesPolicy(): ScriptURLPolicy | null {","+  if (trustedTypesPolicy === undefined) {","+    trustedTypesPolicy = null;","+    const trustedTypes =","+      typeof window !== 'undefined' ? window.trustedTypes : undefined;","+    if (trustedTypes?.createPolicy) {","+      try {","+        trustedTypesPolicy = trustedTypes.createPolicy(","+          _TRUSTED_TYPES_POLICY_NAME,","+          { createScriptURL: _createTrustedScriptURL }","+        );","+      } catch {","+        // The page's CSP does not allow this policy name, or a policy with","+        // this name already exists. Fall back to assigning a plain string,","+        // which still works unless the page also requires Trusted Types for","+        // scripts. If it does, _setTrustedScriptSrc logs an error explaining","+        // how to allow the policy.","+        trustedTypesPolicyBlocked = true;","+      }","+    }","+  }","+  return trustedTypesPolicy;","+}","+","+/**","+ * Sets the `src` of a script element through the Firebase Trusted Types policy","+ * when Trusted Types are supported, so that Firebase SDKs can load external","+ * scripts on pages that enforce Trusted Types.","+ *","+ * Throws if `url` is not an allowed Firebase script URL, or if the browser","+ * rejects the assignment.","+ *","+ * @param script - The script element to update.","+ * @param url - The script URL. Must be an allowed Firebase script URL.","+ *","+ * @internal","+ */","+export function _setTrustedScriptSrc(","+  script: HTMLScriptEle