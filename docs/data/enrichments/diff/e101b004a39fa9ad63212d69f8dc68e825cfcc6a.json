{"id":"e101b004a39fa9ad63212d69f8dc68e825cfcc6a","axis":"silent","repo":"firebase/firebase-js-sdk","sha":"e101b004a39fa9ad63212d69f8dc68e825cfcc6a","parsed":{"files":[{"path":".changeset/trusted-types-shared-policy.md","lines":["@@ -0,0 +1,8 @@","+---","+'@firebase/app': patch","+'@firebase/auth': patch","+'@firebase/analytics': patch","+'@firebase/app-check': patch","+---","+","+Load external scripts through a single shared Trusted Types policy named `firebase-js-sdk-policy`, so that Auth (gapi and reCAPTCHA scripts), Analytics (gtag), and App Check (reCAPTCHA scripts) work on pages that enforce Trusted Types with `require-trusted-types-for 'script'`. If the page's CSP restricts policy names with the `trusted-types` directive, it must allow `firebase-js-sdk-policy`; if it doesn't, an error explaining this is logged when a script fails to load."],"additions":8,"deletions":0,"truncated":false},{"path":"common/api-review/app.api.md","lines":["@@ -145,5 +145,7 @@ export const _serverApps: Map<string, FirebaseServerApp>;"," // @public"," export function setLogLevel(logLevel: LogLevelString): void;"," ","+// @internal","+export function _setTrustedScriptSrc(script: HTMLScriptElement, url: string): void;"," "," ```"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/analytics/src/errors.ts","lines":["@@ -28,8 +28,7 @@ export const enum AnalyticsError {","   CONFIG_FETCH_FAILED = 'config-fetch-failed',","   NO_API_KEY = 'no-api-key',","   NO_APP_ID = 'no-app-id',","-  NO_CLIENT_ID = 'no-client-id',","-  INVALID_GTAG_RESOURCE = 'invalid-gtag-resource'","+  NO_CLIENT_ID = 'no-client-id'"," }"," "," const ERRORS: ErrorMap<AnalyticsError> = {","@@ -67,9 +66,7 @@ const ERRORS: ErrorMap<AnalyticsError> = {","   [AnalyticsError.NO_APP_ID]:","     'The \"appId\" field is empty in the local Firebase config. Firebase Analytics requires this field to' +","     'contain a valid app ID.',","-  [AnalyticsError.NO_CLIENT_ID]: 'The \"client_id\" field is empty.',","-  [Anal