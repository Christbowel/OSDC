iver/v2/mongo/options\"","-)","-","-// trackingCredentialsProvider wraps an options.AWSCredentialsProvider and counts calls.","-type trackingCredentialsProvider struct {","-\tinner  options.AWSCredentialsProvider","-\tcalled int","-}","-","-func (p *trackingCredentialsProvider) Retrieve(ctx context.Context) (awsauth.AWSCredentials, error) {","-\tp.called++","-\treturn p.inner.Retrieve(ctx)","-}","-","-// TestAWSDefaultCustomCredentialProviderAuthenticates is prose test 1:","-// \"Custom Credential Provider Authenticates\" from the MongoDB AWS auth spec.","-// https://github.com/mongodb/specifications/blob/master/source/auth/tests/mongodb-aws.md","-//","-// Uses the AWS SDK default credential chain so all 6 scenarios (Regular, EC2, ECS,","-// AssumeRole, WebIdentity, Lambda) are covered in environments where the SDK can","-// resolve credentials automatically without needing inline credentials in the URI.","-func TestAWSDefaultCustomCredentialProviderAuthenticates(t *testing.T) {","-\tif test := os.Getenv(\"AWS_TEST\"); test == \"assume-role\" || test == \"regular\" {","-\t\tt.Skipf(\"Skipping test for %s\", test)","-\t}","-","-\trawURI := os.Getenv(\"MONGODB_URI\")","-\tif rawURI == \"\" {","-\t\tt.Skip(\"MONGODB_URI not set\")","-\t}","-","-\tcfg, err := config.LoadDefaultConfig(context.Background())","-\tif err != nil {","-\t\tt.Fatalf(\"failed to load AWS config: %v\", err)","-\t}","-","-\ttracking := &trackingCredentialsProvider{","-\t\tinner: awsauth.NewCredentialsProvider(cfg.Credentials),","-\t}","-","-\t// SetAuth overrides any inline credentials that ApplyURI may have extracted","-\t// from the URI; the AWS SDK default chain provides credentials instead.","-\tclient, err := mongo.Connect(","-\t\toptions.Client().","-\t\t\tApplyURI(rawURI).","-\t\t\tSetAuth(options.Credential{","-\t\t\t\tAuthMechanism:          \"MONGODB-AWS\",","-\t\t\t\tAWSCredentialsProvider: tracking,","-\t\t\t}),","-\t)","-\tif err != nil {","-\t\tt.Fatalf(\"failed to connect: %v\", err)","-\t}","-\tdefer func() {","-\t\tif err := client.Disconnect(context.Background()); err != nil {","-\t\t\tt.Errorf(\"Disconnect: %v\", err)","-\t\t}","-\t}()","-","-\terr = client.Database(\"aws\").Collection(\"test\").","-\t\tFindOne(context.Background(), bson.D{{Key: \"x\", Value: 1}}).Err()","-\tif err != nil && !errors.Is(err, mongo.ErrNoDocuments) {","-\t\tt.Fatalf(\"unexpected FindOne error: %v\", err)","-\t}","-","-\tif tracking.called == 0 {","-\t\tt.Fatal(\"expected custom credential provider to be called at least once\")","-\t}","-}"],"additions":0,"deletions":87,"truncated":false},{"path":"ext/awsauth/test/go.mod","lines":["@@ -1,38 +0,0 @@","-module go.mongodb.org/mongo-driver/ext/awsauth/test","-","-go 1.25.0","-","-replace (","-\tgo.mongodb.org/mongo-driver/ext/awsauth => ..","-\tgo.mongodb.org/mongo-driver/v2 => ../../..","-)","-","-require (","-\tgithub.com/aws/aws-sdk-go-v2/config v1.32.30","-\tgo.mongodb.org/mongo-driver/ext/awsauth v0.0.0","-\tgo.mongodb.org/mongo-driver/v2 v2.0.0-beta2","-)","-","-require (","-\tgithub.com/aws/aws-sdk-go-v2 v1.42.1 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/credentials v1.19.29 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/feature/ec2/imds v1.18.30 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/internal/configsources v1.4.30 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/internal/endpoints/v2 v2.7.30 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/internal/v4a v1.4.31 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/service/internal/accept-encoding v1.13.13 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/service/internal/presigned-url v1.13.30 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/service/signin v1.4.1 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/service/sso v1.32.1 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/service/ssooidc v1.37.1 // indirect","-\tgithub.com/aws/aws-sdk-go-v2/service/sts v1.44.1 // indirect","-\tgithub.com/aws/smithy-go v1.27.3 // indirect","-\tgithub.com/klauspost/compress v1.17.6 // i