{"id":"fb80161a75e78f09e82a86c10924dbad9f6acdd3","axis":"silent","repo":"salvo-rs/salvo","sha":"fb80161a75e78f09e82a86c10924dbad9f6acdd3","parsed":{"files":[{"path":".github/fixtures/macro_paths.rs","lines":["@@ -0,0 +1,128 @@","+// Deliberately avoid the prelude and Writer imports: generated code must resolve","+// its own dependencies, including traits used on extractor errors.","+#[derive(serde::Deserialize, api::ToSchema)]","+struct Payload {","+    value: String,","+}","+","+#[derive(serde::Deserialize, framework::macros::Extractible)]","+#[salvo(extract(default_source(from = \"query\")))]","+struct Extracted {","+    value: String,","+}","+","+#[derive(serde::Deserialize, api::ToParameters)]","+struct Parameters {","+    r#type: String,","+}","+","+#[api::endpoint]","+async fn parameters(params: Parameters) -> String {","+    params.r#type","+}","+","+#[derive(api::ToResponse)]","+struct Reply(String);","+","+#[derive(api::ToResponses)]","+enum Replies {","+    #[salvo(response(status_code = 200))]","+    Ok(String),","+}","+","+#[framework::handler]","+async fn plain(value: api::extract::QueryParam<String>) -> String {","+    value.into_inner()","+}","+","+#[api::endpoint(request_body(content = Payload, description = \"payload\"))]","+async fn described(value: api::extract::QueryParam<String>) -> String {","+    value.into_inner()","+}","+","+#[api::endpoint(request_body = Payload)]","+async fn short() {}","+","+#[api::endpoint(request_body(content = Payload, description = \"merged\"))]","+async fn merged(_body: api::extract::JsonBody<Payload>) {}","+","+#[api::endpoint(request_body(description = \"inferred payload\"))]","+async fn inferred(_body: api::extract::JsonBody<Payload>) {}","+","+#[derive(Clone)]","+struct Service;","+","+#[renamed_craft::craft]","+impl Service {","+    #[craft(endpoint(request_body = Payload))]","+    fn endpoint(&self) -> &'static str {","+        \"ok\"","+    }","+","+    #[craft(endpoint)]","+    fn static_endpoint() {}","+","+    #[craft(handler)]","+    fn handler(&self) {}","+}","+","+#[tokio::main(flavor = \"current_thread\")]","+async fn main() {","+    use framework::test::ResponseExt;","+    let _ = <Extracted as framework::Extractible>::metadata();","+    let router = framework::Router::new()","+        .push(framework::Router::with_path(\"plain\").get(plain))","+        .push(framework::Router::with_path(\"described\").post(described))","+        .push(framework::Router::with_path(\"short\").post(short))","+        .push(framework::Router::with_path(\"merged\").post(merged))","+        .push(framework::Router::with_path(\"inferred\").post(inferred))","+        .push(framework::Router::with_path(\"craft\").post(Service.endpoint()))","+        .push(framework::Router::with_path(\"static\").get(Service::static_endpoint()))","+        .push(framework::Router::with_path(\"handler\").get(Service.handler()));","+    let router = router.push(framework::Router::with_path(\"parameters\").get(parameters));","+    let document =","+        serde_json::to_value(api::OpenApi::new(\"paths\", \"1\").merge_router(&router)).unwrap();","+    for path in [\"/described\", \"/short\", \"/merged\", \"/inferred\", \"/craft\"] {","+        assert!(","+            document[\"paths\"][path][\"post\"][\"requestBody\"][\"content\"][\"application/json\"][\"schema\"]","+                [\"$ref\"]","+                .is_string()","+        );","+    }","+    assert_eq!(","+        document[\"paths\"][\"/merged\"][\"post\"][\"requestBody\"][\"description\"],","+        \"merged\"","+    );","+    assert_eq!(","+        document[\"paths\"][\"/inferred\"][\"post\"][\"requestBody\"][\"description\"],","+        \"inferred payload\"","+    );","+    assert!(document[\"paths\"][\"/static\"][\"get\"].is_object());","+    assert_eq!(","+        document[\"paths\"][\"/parameters\"][\"get\"][\"parameters\"][0][\"name\"],","+        \"type\"","+    );","+    let service = framework::Service::new(router);","+    let response = framework::test::TestClient::get(\"http://localhost/plain\")","+        .send(&service)","+        .await;","+    assert_eq!(","+        response.status_code,","+        Some(framework::http::StatusCode::BAD_REQUEST)","+    );","+    let response = framework::test::TestClient::post(\"http://localhost/described\")","+        .send(&service)","+        .await;","+    assert_eq!(","+        response.status_code,","+        Some(framework::http::StatusCode::BAD_REQUEST)","+    );","+    let mut response = framework::test::TestClient::get(\"http://localhost/plain?value=hello\")","+        .send(&service)","+        .await;","+    assert_eq!(response.take_string().await.unwrap(), \"hello\");","+    let mut response = framework::test::TestClient::get(\"http://localhost/parameters?type=hello\")","+        .send(&service)","+        .await;","+    assert_eq!(response.take_string().await.unwrap(), \"hello\");","+}"],"additions":128,"deletions":0,"truncated":false},{"path":".github/scripts/check_macro_paths.py","lines":["@@ -0,0 +1,64 @@","+\"\"\"Run macro consumers with facade/split dependencies and renamed dependency keys.\"\"\"","+import argparse","+import json","+from pathlib import Path","+import subprocess","+","+","+def main():","+    parser = argparse.ArgumentParser(description=__doc__)","+    parser.add_argument(\"--offline\", action=\"store_true\")","+    parser.add_argument(\"--case\", choices=[\"facade\", \"renamed-facade\", \"split\", \"renamed-split\", \"raw-identifier\"])","+    args = parser.parse_args()","+    root = Path(__file__).resolve().parents[2]","+    metadata = json.loads(subprocess.check_output([\"cargo\", \"metadata\", \"--no-deps\", \"--format-version\", \"1\"], cwd=root, text=True))","+    target = Path(metadata[\"target_directory\"]).resolve()","+    fixture = (target / \"macro-path-contract\").resolve()","+    assert fixture.is_relative_to(target)","+    (fixture / \"src\").mkdir(parents=True, exist_ok=True)","+    source = (root / \".github/fixtures/macro_paths.rs\").read_text(encoding=\"utf-8\")","+    failures = []","+    for case in [\"facade\", \"renamed-facade\", \"split\", \"renamed-split\", \"raw-identifier\"]:","+        if args.case and args.case != case:","+            continue","+        facade = case in (\"facade\", \"renamed-facade\", \"raw-identifier\")","+        framework = \"framework\" if case.startswith(\"renamed\") else (\"salvo\" if facade else \"salvo_core\")","+        api = \"api\" if case.startswith(\"renamed\") else \"salvo_oapi\"","+        package = \"salvo\" if facade else \"salvo_core\"","+        path = root / \"crates\" / (\"salvo\" if facade else \"core\")","+        manifest = '[package]\\nname = \"macro-path-contract\"\\nversion = \"0.0.0\"\\nedition = \"2024\"\\npublish = false\\n[workspace]\\n[dependencies]\\n'","+        manifest += f'{framework} = {{ package = \"{package}\", path = {json.dumps(str(path))}, default-features = false, features = {json.dumps([\"oapi\", \"test\"] if facade else [\"test\"])} }}\\n'","+        if not facade:","+            manifest += f'{api} = {{ package = \"salvo-oapi\", path = {json.dumps(str(root / \"crates/oapi\"))} }}\\n'","+        manifest += f'renamed_craft = {{ package = \"salvo-craft\", path = {json.dumps(str(root / \"crates/craft\"))} }}\\n'","+        manifest += 'serde = { version = \"1\", features = [\"derive\"] }\\nserde_json = \"1\"\\n'","+        manifest += 'tokio = { version = \"1\", features = [\"macros\", \"rt\"] }\\n'","+        imports = f'use {framework} as framework;\\n' if framework != \"framework\" else \"\"","+        imports += f'use {framework}::oapi as api;\\n' if facade else (f'use {api} as api;\\n' if api != \"api\" else \"\")","+        code = source","+        if case == \"raw-identifier\":","+            code = '''#[api::endpoint]","+async fn r#match(r#type: api::extract::QueryParam<String>) -> String { r#type.into_inner() }","+fn main() {","+    let router = framework::Router::with_path(\"raw\").get(r#match);","+    let document = serde_json::to_value(api::OpenApi::new(\"raw\", \"1\").merge_router(&router)).unwrap();","+    assert_eq!(document[\"paths\"][\"/raw\"][\"get\"][\"parameters\"][0][\"name\"], \"type\");","+}","+'''","+        (fixture / \"Cargo.toml\").write_text(manifest, encoding=\"utf-8\")","+        (fixture / \"src/main.rs\").write_text(imports + code, encoding=\"utf-8\")","+        command = [\"cargo\", \"run\", \"--quiet\", \"--manifest-path\", str(fixture / \"Cargo.toml\")]","+        if args.offline:","+            command.append(\"--offline\")","+        result = subprocess.run(command, cwd=root, text=True, capture_output=True)","+        (fixture / f\"{case}.log\").write_text(result.stderr, encoding=\"utf-8\")","+        print(f'{case}: {\"FAIL\" if result.returncode else \"PASS\"}', flush=True)","+        if result.returncode:","+            failures.append(case)","+    if failures:","+        raise SystemExit(f\"Failed: {', '.join(failures)}; evidence: {fixture}\")","+    print(f\"Macro dependency path contracts passed; evidence: {fixture}\")","+","+","+if __name__ == \"__main__\":","+    main()"],"additions":64,"deletions":0,"truncated":false},{"path":".github/workflows/macro-contracts.yml","lines":["@@ -3,10 +3,10 @@ permissions:","   contents: read"," on:","   pull_request:","-    paths: ['**/*.rs', '**/Cargo.toml', '.github/fixtures/**', '.github/schemas/**', '.github/scripts/check_macro_contracts.py', '.github/workflows/macro-contracts.yml']","+    paths: ['**/*.rs', '**/Cargo.toml', '.github/fixtures/**', '.github/schemas/**', '.github/scripts/check_macro_contracts.py', '.github/scripts/check_macro_paths.py', '.github/workflows/macro-contracts.yml']","   push:","     branches: [main]","-    paths: ['**/*.rs', '**/Cargo.toml', '.github/fixtures/**', '.github/schemas/**', '.github/scripts/check_macro_contracts.py', '.github/workflows/macro-contracts.yml']","+    paths: ['**/*.rs', '**/Cargo.toml', '.github/fixtures/**', '.github/sch