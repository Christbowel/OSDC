) {","+  act(() => {","+    reportBlocked('text-sample', {","+      dashboardUid,","+      panelId: 1,","+      panelTitle: 'Text sample',","+      origins: [{ origin: twimg, urls: [{ url: `${twimg}/media/a.jpg`, count: 5 }] }],","+    });","+    reportBlocked('mixed', {","+      dashboardUid,","+      panelId: 2,","+      panelTitle: 'Mixed image sources',","+      origins: [","+        {","+          origin: dicebear,","+          urls: [","+            { url: `${dicebear}/svg?seed=j.smith`, count: 1 },","+            { url: `${dicebear}/svg?seed=j.johnson`, count: 1 },","+            { url: `${dicebear}/svg?seed=w.zhang`, count: 1 },","+          ],","+        },","+      ],","+    });","+  });","+}","+","+async function openReview() {","+  await userEvent.click(screen.getByRole('button', { name: 'Review' }));","+  return screen.getByRole('dialog');","+}","+","+beforeEach(() => {","+  dashboardUid = `dash-${uidCounter++}`;","+});","+","+afterEach(() => {","+  clearBlocked('text-sample');","+  clearBlocked('mixed');","+  clearBlocked('late');","+  window.localStorage.clear();","+  window.sessionStorage.clear();","+  jest.restoreAllMocks();","+});","+","+it('summarises blocked sources and resources across panels', () => {","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  expect(screen.getByText('8 resources from 2 sources are blocked')).toBeVisible();","+});","+","+it('renders nothing for a dashboard without blocked sources', () => {","+  reportMockupPanels();","+  render(<SandboxConsentBanner dashboardUid=\"another-dashboard\" />);","+  expect(screen.queryByRole('button', { name: 'Review' })).not.toBeInTheDocument();","+});","+","+it('lists each host with its panels and every blocked URL', async () => {","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  const dialog = await openReview();","+  const [twimgRow, dicebearRow] = within(dialog).getAllByRole('listitem');","+","+  expect(within(twimgRow).getByText('pbs.twimg.com')).toBeVisible();","+  expect(within(twimgRow).getByText('Text sample')).toBeVisible();","+  expect(within(twimgRow).getByText('5 resources from 1 URL')).toBeVisible();","+  expect(within(twimgRow).getByText('×5')).toBeVisible();","+","+  expect(within(dicebearRow).getByText('Mixed image sources')).toBeVisible();","+  expect(within(dicebearRow).getByText('3 resources')).toBeVisible();","+  expect(within(dicebearRow).queryByText(/^×/)).not.toBeInTheDocument();","+  for (const seed of ['j.smith', 'j.johnson', 'w.zhang']) {","+    expect(within(dicebearRow).getByText(`${dicebear}/svg?seed=${seed}`)).toBeVisible();","+  }","+});","+","+it(\"doesn't let a source be allowed when some of its URLs couldn't be listed\", async () => {","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  act(() => {","+    reportBlocked('text-sample', {","+      dashboardUid,","+      panelTitle: 'Leaky',","+      origins: [{ origin: twimg, urls: [{ url: `${twimg}/collect?d=abc`, count: 1 }], truncated: true }],","+    });","+  });","+  expect(screen.getByText('4+ resources from 2 sources are blocked')).toBeVisible();","+  const dialog = await openReview();","+  expect(within(dialog).getByText('1+ resource')).toBeVisible();","+  expect(within(dialog).getByText(\"Too many resources to review. This source can't be allowed.\")).toBeVisible();","+  expect(within(dialog).getByRole('checkbox', { name: 'pbs.twimg.com' })).toBeDisabled();","+","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'Select all' }));","+  expect(within(dialog).getByRole('checkbox', { name: 'api.dicebear.com' })).toBeChecked();","+  expect(within(dialog).getByRole('checkbox', { name: 'pbs.twimg.com' })).not.toBeChecked();","+  expect(within(dialog).getByRole('checkbox', { name: 'Select all' })).toBeChecked();","+});","+","+it('enables the actions once a source is selected and shows a partial \"Select all\"', async () => {","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  const dialog = await openReview();","+  const allow = within(dialog).getByRole('button', { name: /^Allow/ });","+  expect(allow).toBeDisabled();","+","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'api.dicebear.com' }));","+  expect(allow).toBeEnabled();","+  expect(within(dialog).getByRole('checkbox', { name: 'Select all' })).toHaveProperty('indeterminate', true);","+","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'Select all' }));","+  expect(within(dialog).getByRole('checkbox', { name: 'pbs.twimg.com' })).toBeChecked();","+  expect(within(dialog).getByRole('checkbox', { name: 'Select all' })).toHaveProperty('indeterminate', false);","+});","+","+it('\"Allow\" unblocks the selected sources in the panels listed only and recounts the banner', async () => {","+  const emit = jest.spyOn(appEvents, 'emit');","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  const dialog = await openReview();","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'api.dicebear.com' }));","+  await userEvent.click(within(dialog).getByRole('button', { name: /^Allow/ }));","+","+  expect(getAllowedOrigins(dashboardUid, 2)).toEqual([dicebear]);","+  expect(getAllowedOrigins(dashboardUid, 1)).toEqual([]);","+  expect(getAllowedOrigins('another-dashboard', 2)).toEqual([]);","+  expect(emit).toHaveBeenCalledWith(AppEvents.alertSuccess, ['1 source is now allowed in the panels listed']);","+  expect(screen.getByText('5 resources from 1 source are blocked')).toBeVisible();","+  expect(screen.queryByRole('dialog')).not.toBeInTheDocument();","+});","+","+it('only allows the panels that were listed when the review opened', async () => {","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  const dialog = await openReview();","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'api.dicebear.com' }));","+  act(() => {","+    reportBlocked('late', {","+      dashboardUid,","+      panelId: 3,","+      panelTitle: 'Reported while open',","+      origins: [{ origin: dicebear, urls: [{ url: `${dicebear}/svg?seed=leak`, count: 1 }] }],","+    });","+  });","+  expect(within(dialog).queryByText('Reported while open')).not.toBeInTheDocument();","+  await userEvent.click(within(dialog).getByRole('button', { name: /^Allow/ }));","+","+  expect(getAllowedOrigins(dashboardUid, 2)).toEqual([dicebear]);","+  expect(getAllowedOrigins(dashboardUid, 3)).toEqual([]);","+});","+","+it('keeps the review and its selection while a panel reloads and reports again', async () => {","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  const dialog = await openReview();","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'api.dicebear.com' }));","+  act(() => {","+    clearBlocked('text-sample');","+    clearBlocked('mixed');","+  });","+  expect(screen.getByRole('dialog')).toBe(dialog);","+  reportMockupPanels();","+  expect(within(dialog).getByRole('checkbox', { name: 'api.dicebear.com' })).toBeChecked();","+});","+","+it('\"Always allow\" unblocks the selected sources on every dashboard and hides the banner when none are left', async () => {","+  const emit = jest.spyOn(appEvents, 'emit');","+  render(<SandboxConsentBanner dashboardUid={dashboardUid} />);","+  reportMockupPanels();","+  const dialog = await openReview();","+  await userEvent.click(within(dialog).getByRole('checkbox', { name: 'Select all' }));","+  await userEvent.click(within(dialog).getByRole('button', { name: /^Always allow/ }));","+","+  expect(getAllowedOrigins('another-dashboard')).toEqual([dicebear, twimg]);","+  expect(emit).toHaveBeenCalledWith(AppEvents.alertSuccess, ['2 sources are now allowed for 30 days']);","+  expect(screen.queryByRole('button', { name: 'Review' })).not.toBeInTheDocument();","+});"],"additions":190,"deletions":0,"truncated":false},{"path":"public/app/features/dashboard-scene/scene/sandbox-consent/SandboxConsentBanner.tsx","lines":["@@ -0,0 +1,80 @@","+import { css, cx } from '@emotion/css';","+import { useState } from 'react';","+","+import { type GrafanaTheme2 } from '@grafana/data';","+import { t } from '@grafana/i18n';","+import { Alert, Button, useStyles2 } from '@grafana/ui';","+","+import { resourcesLabel, SandboxConsentModal } from './SandboxConsentModal';","+import { type BlockedOriginSummary, useBlockedSummary } from './sandboxConsent';","+","+interface Props {","+  dashboardUid?: string;","+  /** Limits the banner to one panel, as in the panel editor. */","+  panelId?: number;","+  className?: string;","+}","+","+export function SandboxConsentBanner({ dashboardUid, panelId, className }: Props) {","+  const styles = useStyles2(getStyles);","+  const sources = useBlockedSummary(dashboardUid, panelId);","+  // Kept as opened, so a panel reporting while the modal is open can't join a source the viewer already checked.","+  const [reviewing, setReviewing] = useState<BlockedOriginSummary[]>();","+","+  // A reloading frame clears its report before sending a new one, which mustn't close an open review.","+  if (sources.length === 0 && !reviewing) {","+    return null;","+  }","+","+  const resources = sources.reduce((sum, source) => sum + source.count, 0);","+  const title = t('dashboard-scene.sandbox-consent.banner-title', '', {","+    count: resources,","+    defaultValue_one: '{{resources}} from {{sources}} is blocked',","+    defaultValue_other: '{{resources}} from {{sources}} are blocked',","+    resources: resourcesLabel(","+      resources,","+      sources.some((source) => source.truncated)","+    ),","+    sources: t('dashboard-scene.sandbox-consent.sources', '', {","+      count: sources.length,","+      defaultValue_one: '{{count}} source',","+      defaultValue_other: '{{count}} sources',","+    }),","+  });","+","+  return (","+    <>","+      {sources.length > 0 && (","+        <Alert","+          severity=\"warning\"","+          title={title}","+          className={cx(styles.banner, className)}","+          topSpacing={0}","+          bottomSpacing={0}","+          action={","+            <Button variant=\"secondary\" fill=\"outline\" size=\"sm\" onClick={() => setReviewing(sources)}>","+              {t('dashboard-scene.sandbox-consent.review', 'Review')}","+            </Button>","+          }","+        >","+          {t('dashboard-scene.sandbox-consent.banner-description', 'To load them, review and allow their sources')}","+        </Alert>","+      )}","+      {reviewing && (","+        <SandboxConsentModal","+          dashboardUid={dashboardUid}","+          sources={reviewing}","+          onDismiss={() => setReviewing(undefined)}","+        />","+      )}","+    </>","+  );","+}","+","+const getStyles = (theme: GrafanaTheme2) => ({","+  // Alert grows by default, which would stretch it inside the page's flex column.","+  banner: css({","+    flexGrow: 0,","+    margin: theme.spacing(1, 2, 0),","+  }),","+});"],"additions":80,"deletions":0,"truncated":false},{"path":"public/app/features/dashboard-scene/scene/sandbox-consent/SandboxConsentModal.tsx","lines":["@@ -0,0 +1,229 @@","+import { css } from '@emotion/css';","+import { useState } from 'react';","+","+import { AppEvents, type GrafanaTheme2 } from '@grafana/data';","+import { t } from '@grafana/i18n';","+import { Button, Checkbox, Icon, Modal, ScrollContainer, Stack, Tag, Text, Tooltip, useStyles2 } from '@grafana/ui';","+import { appEvents } from 'app/core/app_events';","+","+import { ALWAYS_ALLOW_DAYS, allowOrigins, type BlockedOriginSummary, type ConsentScope } from './sandboxConsent';","+","+// In theme spacing units, about six URLs. A long list scrolls so it can't push the other sources out of view.","+const URL_LIST_HEIGHT = 18;","+","+interface Props {","+  dashboardUid?: string;","+  sources: BlockedOriginSummary[];","+  onDismiss: () => void;","+}","+","+export function SandboxConsentModal({ dashboardUid, sources, onDismiss }: Props) {","+  const styles = useStyles2(getStyles);","+  const [checked, setChecked] = useState<Set<string>>(() => new Set());","+  // A source with URLs left out can't be reviewed, so it can't be allowed.","+  const allowable = sources.filter((source) => !source.truncated);","+  const selected = allowable.filter((source) => checked.has(source.origin));","+  const allSelected = allowable.length > 0 && selected.length === allowable.length;","+","+  const toggle = (origin: string) =>","+    setChecked((current) => {","+      const next = new Set(current);","+      if (!next.delete(origin)) {","+        next.add(origin);","+      }","+      return next;","+    });","+","+  const allow = (scope: ConsentScope) => {","+    allowOrigins(selected, scope, dashboardUid);","+    const count = selected.length;","+    appEvents.emit(AppEvents.alertSuccess, [","+      scope === 'always'","+        ? t('dashboard-scene.sandbox-consent.allowed-always', '', {","+            count,","+            days: ALWAYS_ALLOW_DAYS,","+            defaultValue_one: '{{count}} source is now allowed for {{days}} days',","+            defaultValue_other: '{{count}} sources are now allowed for {{days}} days',","+          })","+        : t('dashboard-scene.sandbox-consent.allowed-panels', '', {","+            count,","+            defaultValue_one: '{{count}} source is now allowed in the panels listed',","+            defaultValue_other: '{{count}} sources are now allowed in the panels listed',","+          }),","+    ]);","+    onDismiss();","+  };","+","+  return (","+    <Modal title={t('dashboard-scene.sandbox-consent.modal-title', 'Blocked resources')} isOpen onDismiss={onDismiss}>","+      <div className={styles.selectAll}>","+        <Checkbox","+          label={t('dashboard-scene.sandbox-consent.select-all', 'Select all')}","+          value={allSelected}","+          indeterminate={selected.length > 0 && !allSelected}","+          disabled={allowable.length === 0}","+          onChange={() => setChecked(allSelected ? new Set() : new Set(allowable.map((source) => source.origin)))}","+        />","+      </div>","+      <ul className={styles.list}>","+        {sources.map((source) => (","+          <li key={source.origin} className={styles.row}>","+            <Checkbox","+              aria-label={source.host}","+              value={!source.truncated && checked.has(source.origin)}","+              disabled={source.truncated}","+              onChange={() => toggle(source.origin)}","+            />","+            <Stack gap={1} alignItems=\"center\" wrap=\"wrap\">","+              <Text weight=\"medium\">{source.host}</Text>","+              {source.panels","+                .filter((panel) => panel !== '')","+                .map((panel) => (","+                  <Tag key={panel} name={panel} />","+                ))}","+            </Stack>","+            <div className={styles.details}>","+              <Text variant=\"bodySmall\" color=\"secondary\">","+                {sourceSummary(source)}","+              </Text>","+              {source.urls.length > 0 && (","+                // Show every URL in full. A hidden or cut-off URL could be the one leaking data.","+                <ScrollContainer"],"additions":91,"deletions":0,"truncated":false}],"additions":514,"deletions":15,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-16T14:19:49.046745+00:00"}