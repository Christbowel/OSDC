example, the callee of a call starts at the same","+//! offset, and the comments are emitted before it anyway).","+//!","+//! Known limitation: the nodes that lose their spans also lose their source","+//! map entries. These nodes are code that the compiler generated, or nodes that","+//! start at the same position as the expression, so the expression gives the","+//! same mapping.","+","+use rustc_hash::FxHashSet;","+use swc_common::{BytePos, Span, DUMMY_SP};","+use swc_ecma_ast as swc;","+use swc_ecma_ast::Program;","+use swc_ecma_visit::{Visit, VisitMut, VisitMutWith, VisitWith};","+","+/// Make sure that comments at the start of a compiled expression are emitted","+/// on the expression. See the module documentation.","+pub fn preserve_comment_anchors(program: &mut Program) {","+    let mut collector = AnchorCollector::default();","+    program.visit_with(&mut collector);","+    if collector.anchors.is_empty() {","+        return;","+    }","+","+    program.visit_mut_with(&mut AnchorProtector {","+        pending: collector.anchors,","+    });","+}","+","+/// Collect the start offsets of expressions that can carry a leading comment","+/// that must stay on the expression.","+#[derive(Default)]","+struct AnchorCollector {","+    anchors: FxHashSet<BytePos>,","+}","+","+impl AnchorCollector {","+    fn add(&mut self, span: Span) {","+        if !span.is_dummy() {","+            self.anchors.insert(span.lo);","+        }","+    }","+}","+","+impl Visit for AnchorCollector {","+    fn visit_jsx_element(&mut self, node: &swc::JSXElement) {","+        self.add(node.span);","+        node.visit_children_with(self);","+    }","+","+    fn visit_jsx_fragment(&mut self, node: &swc::JSXFragment) {","+        self.add(node.span);","+        node.visit_children_with(self);","+    }","+","+    fn visit_call_expr(&mut self, node: &swc::CallExpr) {","+        self.add(node.span);","+        node.visit_children_with(self);","+    }","+","+    fn visit_new_expr(&mut self, node: &swc::NewExpr) {","+        self.add(node.span);","+        node.visit_children_with(self);","+    }","+}","+","+/// Remove the spans of nodes that start at a pending anchor before the anchor","+/// expression is reached.","+///","+/// The visitor visits nodes in source order, which is the order in which the","+/// code generator emits them.","+struct AnchorProtector {","+    /// Start offsets of anchor expressions that were not visited yet.","+    pending: FxHashSet<BytePos>,","+}","+","+impl AnchorProtector {","+    /// Mark the anchor at `span.lo` as reached, so that the anchor and the","+    /// nodes after it keep their spans.","+    fn reach(&mut self, span: Span) {","+        self.pending.remove(&span.lo);","+    }","+}","+","+impl VisitMut for AnchorProtector {","+    fn visit_mut_span(&mut self, span: &mut Span) {","+        if !span.is_dummy() && self.pending.contains(&span.lo) {","+            *span = DUMMY_SP;","+        }","+    }","+","+    fn visit_mut_jsx_element(&mut self, node: &mut swc::JSXElement) {","+        self.reach(node.span);","+        node.visit_mut_children_with(self);","+    }","+","+    fn visit_mut_jsx_fragment(&mut self, node: &mut swc::JSXFragment) {","+        self.reach(node.span);","+        node.visit_mut_children_with(self);","+    }","+","+    fn visit_mut_call_expr(&mut self, node: &mut swc::CallExpr) {","+        self.reach(node.span);","+        node.visit_mut_children_with(self);","+    }","+","+    fn visit_mut_new_expr(&mut self, node: &mut swc::NewExpr) {","+        self.reach(node.span);","+        node.visit_mut_children_with(self);","+    }","+}"],"additions":138,"deletions":0,"truncated":false},{"path":"crates/swc_ecma_react_compiler/src/lib.rs","lines":["@@ -4,6 +4,7 @@"," // LICENSE file in the root directory of this source tree."," "," mod apply_renames;","+mod comment_anchors;"," mod convert_ast;"," mod convert_ast_reverse;"," mod convert_scope;","@@ -18,6 +19,7 @@ mod stack;"," mod tests;"," "," use apply_rena