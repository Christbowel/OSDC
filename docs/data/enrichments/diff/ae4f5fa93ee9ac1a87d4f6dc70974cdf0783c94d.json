n the user passed them.","+ *","+ * @internal","+ */","+export interface KvDurability {","+  durabilityLevel: DurabilityLevel","+  persistTo?: number","+  replicateTo?: number","+}","+","+/**","+ * @internal","+ */","+export interface KvGetRequest extends KvReadRequest {","+  project?: string[]","+  withExpiry: boolean","+}","+","+/**","+ * @internal","+ */","+export interface KvReplicaReadRequest extends KvReadRequest {","+  readPreference?: ReadPreference","+}","+","+/**","+ * A document value, already encoded by the transcoder, and the expiry","+ * already parsed to the server's form.","+ *","+ * @internal","+ */","+export interface KvInsertRequest extends KvRequest, KvDurability {","+  value: Buffer","+  flags: number","+  expiry: number","+}","+","+/**","+ * @internal","+ */","+export interface KvUpsertRequest extends KvInsertRequest {","+  preserveExpiry: boolean","+}","+","+/**","+ * @internal","+ */","+export interface KvReplaceRequest extends KvUpsertRequest {","+  cas?: CasInput","+}","+","+/**","+ * @internal","+ */","+export interface KvRemoveRequest extends KvRequest, KvDurability {","+  cas?: CasInput","+}","+","+/**","+ * @internal","+ */","+export interface KvGetAndTouchRequest extends KvReadRequest {","+  expiry: number","+}","+","+/**","+ * @internal","+ */","+export interface KvTouchRequest extends KvRequest {","+  expiry: number","+}","+","+/**","+ * @internal","+ */","+export interface KvGetAndLockRequest extends KvReadRequest {","+  lockTime: number","+}","+","+/**","+ * @internal","+ */","+export interface KvUnlockRequest extends KvRequest {","+  cas: CasInput","+}","+","+/**","+ * @internal","+ */","+export interface KvLookupInRequest extends KvRequest {","+  specs: LookupInSpec[]","+  accessDeleted: boolean","+}","+","+/**","+ * @internal","+ */","+export interface KvLookupInReplicaRequest extends KvRequest {","+  specs: LookupInSpec[]","+  readPreference?: ReadPreference","+}","+","+/**","+ * A mutate-in spec with its value, already encoded