"+ *","+ * @internal","+ */","+export interface SearchBackend {","+  search(","+    indexName: string,","+    request: SearchQuery | SearchRequest,","+    options: SearchQueryOptions,","+    scope?: KeyspaceScope,","+    obs?: ObservableRequestHandler | null","+  ): StreamableRowPromise<SearchResult, SearchRow, SearchMetaData>","+}","+","+/**","+ * @internal","+ */","+export interface BucketManagementBackend {","+  createBucket(","+    settings: ICreateBucketSettings,","+    req: BackendRequest","+  ): Promise<void>","+  updateBucket(","+    settings: Partial<IBucketSettings> & Pick<IBucketSettings, 'name'>,","+    req: BackendRequest","+  ): Promise<void>","+  dropBucket(bucketName: string, req: BackendRequest): Promise<void>","+  getBucket(bucketName: string, req: BackendRequest): Promise<BucketSettings>","+  getAllBuckets(req: BackendRequest): Promise<BucketSettings[]>","+  flushBucket(bucketName: string, req: BackendRequest): Promise<void>","+}","+","+/**","+ * @internal","+ */","+export interface CollectionManagementBackend {","+  getAllScopes(bucketName: string, req: BackendRequest): Promise<ScopeSpec[]>","+  createScope(","+    bucketName: string,","+    scopeName: string,","+    req: BackendRequest","+  ): Promise<void>","+  dropScope(","+    bucketName: string,","+    scopeName: string,","+    req: BackendRequest","+  ): Promise<void>","+  createCollection(","+    bucketName: string,","+    scopeName: string,","+    collectionName: string,","+    settings: CreateCollectionSettings,","+    req: BackendRequest","+  ): Promise<void>","+  updateCollection(","+    bucketName: string,","+    scopeName: string,","+    collectionName: string,","+    settings: UpdateCollectionSettings,","+    req: BackendRequest","+  ): Promise<void>","+  dropCollection(","+    bucketName: string,","+    scopeName: string,","+    collectionName: string,","+    req: BackendRequest","+  ): Promise<void>","+}","+","+/**","+ * The keyspace a query index belongs to: a bucket, or a collection within","+ * one.","+ *","+ * @internal","+ */","+export interface QueryIndexKeyspace {","+  bucketName: string","+  scopeName?: string","+  collectionName?: string","+}","+","+/**","+ * @internal","+ */","+export interface QueryIndexCreateSettings {","+  ignoreIfExists: boolean","+  numReplicas?: number","+  deferred?: boolean","+}","+","+/**","+ * Query index management. `watchIndexes` is given the watch's own timeout,","+ * which bounds every request it makes.","+ *","+ * @internal","+ */","+export interface QueryIndexManagementBackend {","+  createIndex(","+    keyspace: QueryIndexKeyspace,","+    indexName: string,","+    keys: string[],","+    settings: QueryIndexCreateSettings,","+    req: BackendRequest","+  ): Promise<void>","+  createPrimaryIndex(","+    keyspace: QueryIndexKeyspace,","+    indexName: string | undefined,","+    settings: QueryIndexCreateSettings,","+    req: BackendRequest","+  ): Promise<void>","+  dropIndex(","+    keyspace: QueryIndexKeyspace,","+    indexName: string,","+    ignoreIfNotExists: boolean,","+    req: BackendRequest","+  ): Promise<void>","+  dropPrimaryIndex(","+    keyspace: QueryIndexKeyspace,","+    indexName: string | undefined,","+    ignoreIfNotExists: boolean,","+    req: BackendRequest","+  ): Promise<void>","+  getAllIndexes(","+    keyspace: QueryIndexKeyspace,","+    req: BackendRequest","+  ): Promise<QueryIndex[]>","+  buildDeferredIndexes(","+    keyspace: QueryIndexKeyspace,","+    req: BackendRequest","+  ): Promise<string[]>","+  watchIndexes(","+    keyspace: QueryIndexKeyspace,","+    indexNames: string[],","+    watchPrimary: boolean,","+    timeout: number,","+    req: BackendRequest","+  ): Promise<void>","+}","+","+/**","+ * A search index management request, bound to a scope for the scope level","+ * manager and to the cluster otherwise.","+ *","+ * @internal","+ */","+export interface SearchIndexRequest extends BackendRequest {","+  scope?: KeyspaceScope","+}","+","+/**","+ * @internal","+ */