 : undefined","+    )","+  }","+  return loadedBinding as CppBinding","+}","+","+// Importing the SDK does not load the addon; using a member of this object","+// does. So a couchbase2 connection, which never uses one, runs without it.","+// A member defined or replaced here lands on the addon, as it would on the","+// module object itself.","+const binding: CppBinding = new Proxy({} as CppBinding, {","+  get(_target, member) {","+    return Reflect.get(loadBinding(String(member)), member)","+  },","+  has(_target, member) {","+    return Reflect.has(loadBinding(String(member)), member)","+  },","+  set(_target, member, value) {","+    return Reflect.set(loadBinding(String(member)), member, value)","+  },","+  getOwnPropertyDescriptor(_target, member) {","+    const descriptor = Reflect.getOwnPropertyDescriptor(","+      loadBinding(String(member)),","+      member","+    )","+    // The target is empty, so a member can only be reported as configurable.","+    return descriptor && { ...descriptor, configurable: true }","+  },","+  defineProperty(_target, member, descriptor) {","+    return Reflect.defineProperty(","+      loadBinding(String(member)),","+      member,","+      descriptor","+    )","+  },","+  deleteProperty(_target, member) {","+    return Reflect.deleteProperty(loadBinding(String(member)), member)","+  },","+})"," export default binding"],"additions":67,"deletions":8,"truncated":false},{"path":"lib/bindingutilities.ts","lines":["@@ -3,7 +3,7 @@ import {","   AnalyticsEncryptionLevel,","   CouchbaseAnalyticsEncryptionSettings,"," } from './analyticsindexmanager'","-import { SubdocStatus } from './sdutils'","+import { LookupInOp, MutateInOp, SubdocStatus } from './sdutils'"," import binding, {","   CppAnalyticsResponseAnalyticsStatus,","   CppAnalyticsScanConsistency,","@@ -12,6 +12,7 @@ import binding, {","   CppDiagPingState,","   CppDurabilityLevel,","   CppError,","+  CppImplSubdocCommand,","   CppKeyValueStatusCode,","   CppManagementAnalyticsCou