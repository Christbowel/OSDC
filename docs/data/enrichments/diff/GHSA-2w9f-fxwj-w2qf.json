{"id":"GHSA-2w9f-fxwj-w2qf","axis":"advisories","repo":"rails/rails","sha":"4ca090665976e6fbc471c38689b399f84b43cdc7","parsed":{"files":[{"path":"activesupport/CHANGELOG.md","lines":["@@ -1,3 +1,15 @@","+*   `ActiveSupport::MessagePack` no longer deserializes an unsafe","+    `ActiveSupport::SafeBuffer` as `html_safe`.","+","+    A `SafeBuffer` that was no longer `html_safe?`, for example after an","+    in-place `gsub!`, was deserialized as an `html_safe` `SafeBuffer`. It is now","+    serialized with an unsafe marker and deserialized as a `String`. Earlier","+    versions of Rails cannot read an unsafe buffer serialized this way.","+","+    [GHSA-2w9f-fxwj-w2qf]","+","+    *Jean Boussier*","+"," *   `ActiveSupport::Inflector#safe_constantize` matches the constant name in a","     `LoadError` message as a literal string instead of building a `Regexp`","     from it."],"additions":12,"deletions":0,"truncated":false},{"path":"activesupport/lib/active_support/message_pack/extensions.rb","lines":["@@ -249,11 +249,19 @@ def read_hash_with_indifferent_access(unpacker)","       end"," ","       def write_safe_buffer(buffer, packer)","+        unless buffer.html_safe?","+          packer.write(false)","+        end","         packer.write(buffer.to_str)","       end"," ","       def read_safe_buffer(unpacker)","-        ActiveSupport::SafeBuffer.new(unpacker.read)","+        string_or_safe = unpacker.read","+        if string_or_safe","+          ActiveSupport::SafeBuffer.new(string_or_safe)","+        else","+          unpacker.read","+        end","       end"," ","       def raise_unserializable(object, *)"],"additions":9,"deletions":1,"truncated":false},{"path":"activesupport/test/message_pack/shared_serializer_tests.rb","lines":["@@ -157,6 +157,24 @@ module MessagePackSharedSerializerTests","       assert_equal \"prefix Mäßig\", \"prefix \" + deserialized","     end"," ","+    test \"roundtrips ActiveSupport::SafeBuffer preserving html_safe?\" do","+      deserialized = load(dump([\"other\", \"Mäßig\".html_safe, \"other\"]))[1]","+","+      assert_instance_of ActiveSupport::SafeBuffer, deserialized","+      assert_predicate deserialized, :html_safe?","+      assert_equal Encoding::UTF_8, deserialized.encoding","+      assert_equal \"prefix Mäßig\", \"prefix \" + deserialized","+","+      str = \"Mäßig\".html_safe","+      str.sub!(/Z/, \"Z\") # Mark unsafe","+      deserialized = load(dump([\"other\", str, \"other\"]))[1]","+","+      assert_instance_of String, deserialized","+      assert_not_predicate deserialized, :html_safe?","+      assert_equal Encoding::UTF_8, deserialized.encoding","+      assert_equal \"prefix Mäßig\", \"prefix \" + deserialized","+    end","+","     test \"works with ENV['RAILS_MAX_THREADS']\" do","       original_env = ENV.to_h","       ENV[\"RAILS_MAX_THREADS\"] = \"1\"",""],"additions":18,"deletions":0,"truncated":false}],"additions":39,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-11T15:37:42.157397+00:00"}