{"id":"734ec7c98e5371cef6182f8dd44737dc64f15943","axis":"silent","repo":"rails/rails","sha":"734ec7c98e5371cef6182f8dd44737dc64f15943","parsed":{"files":[{"path":"activerecord/CHANGELOG.md","lines":["@@ -1,3 +1,18 @@","+*   Add `change_check_constraint` to change a check constraint between `ENFORCED`","+    and `NOT ENFORCED` on PostgreSQL 19+.","+","+    ```ruby","+    change_check_constraint :products, name: \"price_check\", enforced: false","+    # => ALTER TABLE \"products\" ALTER CONSTRAINT \"price_check\" NOT ENFORCED","+","+    change_check_constraint :products, name: \"price_check\", enforced: true","+    # => ALTER TABLE \"products\" ALTER CONSTRAINT \"price_check\" ENFORCED","+    ```","+","+    Changing a constraint to `ENFORCED` checks all existing rows.","+","+    *Yasuo Honda*","+"," *   Add `enforced:` option to `add_check_constraint` for PostgreSQL 18+."," ","     When `enforced: false` is passed, the constraint is created as `NOT ENFORCED`,"],"additions":15,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/abstract/schema_statements.rb","lines":["@@ -1470,6 +1470,13 @@ def remove_check_constraint(table_name, expression = nil, if_exists: false, **op","         execute_alter_table(at)","       end"," ","+      # Changes an existing check constraint on a table. Currently only the PostgreSQL","+      # adapter (version 19+) implements this; see","+      # PostgreSQL::SchemaStatements#change_check_constraint for details.","+      def change_check_constraint(table_name, **options)","+        raise NotImplementedError, \"change_check_constraint is not implemented\"","+      end","+","       # Checks to see if a check constraint exists on a table for a given check constraint definition.","       #","       #   check_constraint_exists?(:products, name: \"price_check\")"],"additions":7,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/abstract_adapter.rb","lines":["@@ -130,6 +130,7 @@ def ractor_connection_profile # :nodoc:","       def ractor_connection_capabilities # :nodoc:","         {","           supports_advisory_locks?: supports_advisory_locks?,","+          supports_altering_enforced_check_constraints?: supports_altering_enforced_check_constraints?,","           supports_bulk_alter?: supports_bulk_alter?,","           supports_check_constraints?: supports_check_constraints?,","           supports_comments?: supports_comments?,","@@ -617,6 +618,12 @@ def supports_enforced_check_constraints?","         false","       end"," ","+      # Does this adapter support changing an existing check constraint between","+      # ENFORCED and NOT ENFORCED?","+      def supports_altering_enforced_check_constraints?","+        false","+      end","+","       # Does this adapter support creating check constraints?","       def supports_check_constraints?","         false"],"additions":7,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql/schema_statements.rb","lines":["@@ -1008,6 +1008,46 @@ def change_foreign_key(from_table, to_table = nil, **options)","           execute \"ALTER TABLE #{quote_table_name(from_table)} ALTER CONSTRAINT #{quote_column_name(fk_name)} #{enforced ? 'ENFORCED' : 'NOT ENFORCED'}\"","         end"," ","+        # Changes an existing check constraint on a table.","+        #","+        # The `enforced` option toggles whether PostgreSQL checks the constraint when rows","+        # are inserted or updated. Requires PostgreSQL 19+.","+        #","+        # Changing a constraint to `ENFORCED` checks all existing rows, and the constraint","+        # becomes validated. Changing it to `NOT ENFORCED` makes it not validated.","+        #","+        # Like `validate_check_constraint`, this is a runtime helper rather than a migration","+        # command: it is not registered as reversible, so use it from application code","+        # or explicit `up`/`down` methods. Accepted options are `:enforced` plus","+        # identifying keys (`:name`, `:expression`).","+        #","+        # Changes the check constraint named `price_check` on the `products` table to NOT ENFORCED.","+        #","+        # ```","+        # change_check_constraint :products, name: \"price_check\", enforced: false","+        # ```","+        #","+        # Changes it back to ENFORCED.","+        #","+        # ```","+        # change_check_constraint :products, name: \"price_check\", enforced: true","+        # ```","+        #","+        def change_check_constraint(table_name, **options)","+          unless supports_altering_enforced_check_constraints?","+            raise ArgumentError, \"change_check_constraint requires PostgreSQL 19+ (got #{database_version})\"","+          end","+","+          unless options.key?(:enforced)","+            raise ArgumentError, \"change_check_constraint requires at least one option (e.g. enforced:)\"","+          end","+","+          enforced = options[:enforced]","+          chk_name = check_constraint_for!(table_name, **options.slice(:name, :expression)).name","+","+          execute \"ALTER TABLE #{quote_table_name(table_name)} ALTER CONSTRAINT #{quote_column_name(chk_name)} #{enforced ? 'ENFORCED' : 'NOT ENFORCED'}\"","+        end","+","         # Validates the given check constraint.","         #","         # ```"],"additions":40,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql_adapter.rb","lines":["@@ -300,6 +300,10 @@ def supports_enforced_check_constraints?","         database_version >= 18_00_00","       end"," ","+      def supports_altering_enforced_check_constraints?","+        database_version >= 19_00_00","+      end","+","       def supports_views?","         true","       end"],"additions":4,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/ractor_connection_handler/postgresql_proxy_adapter.rb","lines":["@@ -15,6 +15,10 @@ def supports_advisory_locks?","           pure_remote_dispatch(:supports_advisory_locks?)","         end"," ","+        def supports_altering_enforced_check_constraints?","+          pure_remote_dispatch(:supports_altering_enforced_check_constraints?)","+        end","+","         def supports_bulk_alter?","           pure_remote_dispatch(:supports_bulk_alter?)","         end","@@ -228,6 +232,10 @@ def build_create_index_definition(...)","           remote_dispatch(:build_create_index_definition, ...)","         end"," ","+        def change_check_constraint(...)","+          remote_dispatch(:change_check_constraint, ...)","+        end","+","         def change_column(...)","           remote_dispatch(:change_column, ...)","         end"],"additions":8,"deletions":0,"truncated":false},{"path":"activerecord/test/cases/migration/check_constraint_test.rb","lines":["@@ -341,7 +341,83 @@ def test_schema_dumping_with_enforced_false","           end","         end"," ","+        if ActiveRecord::Base.lease_connection.supports_altering_enforced_check_constraints?","+          def test_change_check_constraint_enforced_to_not_enforced","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\"","+","+            assert_queries_match(/ALTER CONSTRAINT \"quantity_check\" NOT ENFORCED\\z/) do","+              @connection.change_check_constraint :trades, name: \"quantity_check\", enforced: false","+            end","+","+            cc = @connection.check_constraints(\"trades\").first","+            assert_not_predicate cc, :enforced?","+            assert_not_predicate cc, :validate?","+          end","+","+          def test_change_check_constraint_not_enforced_to_enforced","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+","+            assert_queries_match(/ALTER CONSTRAINT \"quantity_check\" ENFORCED\\z/) do","+              @connection.change_check_constraint :trades, name: \"quantity_check\", enforced: true","+            end","+","+            cc = @connection.check_constraints(\"trades\").first","+            assert_predicate cc, :enforced?","+            assert_predicate cc, :validate?","+          end","+","+          def test_change_check_constraint_to_enforced_checks_existing_rows","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+            @connection.execute(\"INSERT INTO trades (quantity) VALUES (-1)\")","+","+            assert_raises(ActiveRecord::CheckViolation) do","+              @connection.transaction(requires_new: true) do","+                @connection.change_check_constraint :trades, name: \"quantity_check\", enforced: true","+              end","+            end","+","+            assert_not_predicate @connection.check_constraints(\"trades\").first, :enforced?","+          end","+","+          def test_change_check_constraint_by_expression","+            @connection.add_check_constraint :trades, \"quantity > 0\"","+","+            @connection.change_check_constraint :trades, expression: \"quantity > 0\", enforced: false","+","+            assert_not_predicate @connection.check_constraints(\"trades\").first, :enforced?","+          end","+","+          def test_change_check_constraint_raises_without_enforced","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\"","+","+            error = assert_raises(ArgumentError) do","+              @connection.change_check_constraint :trades, name: \"quantity_check\"","+            end","+            assert_match(/enforced/, error.message)","+          end","+","+          def test_remove_check_constraint_after_change_check_constraint","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+            @connection.change_check_constraint :trades, name: \"quantity_check\", enforced: true","+","+            @connection.remove_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+","+            assert_empty @connection.check_constraints(\"trades\")","+          end","+        end","+","         if current_adapter?(:PostgreSQLAdapter)","+          def test_change_check_constraint_raises_when_unsupported","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\"","+","+            @connection.stub(:supports_altering_enforced_check_constraints?, false) do","+              error = assert_raises(ArgumentError) do","+                @connection.change_check_constraint :trades, name: \"quantity_check\", enforced: false","+              end","+              assert_match(/change_check_constraint requires PostgreSQL 19\\+/, error.message)","+            end","+          end","+","           def test_not_enforced_check_constraint_raises_when_unsupported","             @connection.stub(:supports_enforced_check_constraints?, false) do","               error = assert_raises(ArgumentError) do",""],"additions":76,"deletions":0,"truncated":false}],"additions":157,"deletions":0,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-26T18:56:45.761496+00:00"}