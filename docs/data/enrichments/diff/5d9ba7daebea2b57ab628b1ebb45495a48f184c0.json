{"id":"5d9ba7daebea2b57ab628b1ebb45495a48f184c0","axis":"silent","repo":"pnpm/pnpm","sha":"5d9ba7daebea2b57ab628b1ebb45495a48f184c0","parsed":{"files":[{"path":".changeset/deprecations-in-install-summary.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+Deprecation warnings moved into the install summary and only name the packages the install added. A deprecated dependency added by the install is marked `deprecated` on its summary line, with the version that is not deprecated when there is one. Deprecated subdependencies the install added are listed right after the summary. Deprecated packages that were already installed are reported as one count, such as `3 deprecated packages are still installed`."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/workspace-install-summary.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+In a workspace, the install summary now lists the direct dependency changes of every project, not only of the project pnpm runs in. Each change is listed once, followed by the projects that made it, unless only the current project did. A project's first install lists only deprecated or outdated dependencies and the ones the command added [#6481](https://github.com/pnpm/pnpm/issues/6481)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -539,6 +539,11 @@ impl CliCommand {","         }","     }"," ","+    /// See [`pnpm_default_reporter::set_edits_manifests`].","+    pub(crate) fn edits_manifests(&self) -> bool {","+        matches!(self, CliCommand::Add(_) | CliCommand::Remove(_) | CliCommand::Update(_))","+    }","+","     pub(crate) fn default_reporter_summary_scope(&self) -> SummaryScope {","         match self {","             CliCommand::Access(_) => SummaryScope::CurrentPrefix,"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch.rs","lines":["@@ -118,6 +118,7 @@ impl CliArgs {","     /// reporter only uses it to shorten the paths it prints.","     pub fn configure_reporter(&self) {","         pnpm_default_reporter::set_is_global(super::pre_command::is_global(&self.command));","+        pnpm_default_reporter::set_edits_manifests(self.command.edits_manifests());","         if let Some(color) = self.output.presentation.color.or_else(|| {","             self.output.presentation.no_color.then_some(ColorMode::Never)","         }) {","@@ -296,7 +297,7 @@ impl CliArgs {","         if setup.is_install_family && !builtin_replaced_by_script {","             emit_execution_time(reporter_emit(selected_reporter()), setup.started_at);","         }","-        crate::flush_pending_approvals();","+        crate::flush_held_notices();"," ","         Ok(())","     }"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global.rs","lines":["@@ -450,7 +450,11 @@ fn emit_global_update_result<Reporter: self::Reporter>(global_pkg_dir: &Path, up","         }));","     }","     let prefix = global_pkg_dir.to_string_lossy().into_owned();","-    Reporter::emit(&LogEvent::Summary(SummaryLog { level: LogLevel::Debug, prefix }));","+    Reporter::emit(&LogEvent::Summary(SummaryLog {","+        level: LogLevel::Debug,","+        prefix,","+        new_projects: None,","+    }));"," }"," "," /// Surface a non-fatal problem on the `pnpm:global` channel, matching"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/fast_path.rs","lines":["@@ -85,6 +85,7 @@ fn report_up_to_date_install(","     emit(&pnpm_reporter::LogEvent::Summary(pnpm_reporter::SummaryLog {","         level: pnpm_reporter::LogLevel::Debug,","         prefix,","+        new_projects: None,","     }));"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/reporter/tests.rs","lines":["@@ -21,7 +21,11 @@ use pnpm_reporter::{"," };"," "," fn summary() -> LogEvent {","-    LogEvent::Summary(SummaryLog { level: LogLevel::Debug, prefix: \"/project\".to_string() })","+    LogEvent::Summary(SummaryLog {","+        level: LogLevel::Debug,","+        prefix: \"/project\".to_string(),","+        new_projects: None,","+    })"," }"," "," fn stats() -> LogEvent {"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/lib.rs","lines":["@@ -151,20 +151,23 @@ fn initialize_wasm_paths() -> std::io::Result<()> {","         })"," }"," ","-/// Print the approval notice that append-only output holds back until the","-/// command ends. Commands outside the install family, such as","-/// `approve-builds`, emit no `Done in ...` footer to print it with.","-pub(crate) fn flush_pending_approvals() {","+/// Print what the default reporter holds back until the command ends: the","+/// approval notice of append-only output, and deprecation warnings no install","+/// summary carried. Commands outside the install family, such as","+/// `approve-builds`, emit no `Done in ...` footer to print them with, and a","+/// failing command none at all.","+pub(crate) fn flush_held_notices() {","     if matches!(","         cli_args::reporter::selected_reporter(),","         cli_args::reporter::ReporterType::Default | cli_args::reporter::ReporterType::AppendOnly,","     ) {","         pnpm_default_reporter::DefaultReporter::flush_pending_approvals();","+        pnpm_default_reporter::DefaultReporter::flush_pending_deprecations();","     }"," }"," "," fn report_fatal_error(error: &miette::Report) {","-    flush_pending_approvals();","+    flush_held_notices();","     for cause in error.chain() {","         if let Some(pnpm_package_manager::InstallError::PeerDependencyIssues { rendered }) =","             cause.downcast_ref::<pnpm_package_manager::InstallError>()"],"additions":8,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install.rs","lines":["@@ -426,8 +426,8 @@ fn install_reports_a_deprecation_without_the_notice_and_keeps_the_metadata_on_re","         .success();","     let stdout = String::from_utf8_lossy(&assertion.get_output().stdout).into_owned();","     assert!(","-        stdout.contains(\"deprecated @pnpm.e2e/deprecated@1.0.0\"),","-        \"the install should name the deprecated dependency:\\n{stdout}\",","+        stdout.contains(\"+ @pnpm.e2e/deprecated 1.0.0 deprecated\"),","+        \"the install summary should mark the deprecated dependency:\\n{stdout}\",","     );","     assert!(","         !stdout.contains(\"This package is deprecated.\"),","@@ -452,10 +452,16 @@ fn install_reports_a_deprecation_without_the_notice_and_keeps_the_metadata_on_re","     )","     .expect(\"extend package.json\");"," ","-    new_pacquet_command(&workspace)","+    let assertion = new_pacquet_command(&workspace)","         .with_arg(\"install\")","         .assert()","         .success();","+    let stdout = String::from_utf8_lossy(&assertion.get_output().stdout).into_owned();","+    assert!(","+        stdout.contains(\"1 deprecated package is still installed\")","+            && !stdout.contains(\"deprecated: @pnpm.e2e/deprecated\"),","+        \"an installed deprecated dependency should only be counted:\\n{stdout}\",","+    );","     let second = fs::read_to_string(&lockfile_path).expect(\"re-read pnpm-lock.yaml\");","     assert!(","         second.contains(\"deprecated: This package is deprecated.\"),","@@ -465,6 +471,49 @@ fn install_reports_a_deprecation_without_the_notice_and_keeps_the_metadata_on_re","     drop((root, mock_instance));"," }"," ","+/// Peer resolution runs after the dependency walk and installs missing","+/// peers, so a deprecation it reports is still collected.","+#[test]","+fn install_reports_a_deprecated_auto_installed_peer() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let local = workspace.join(\"local\");","+    fs::create_dir_all(&local).expect(\"create the local package\");","+    fs::write(","+        local.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"local\",","+            \"version\": \"1.0.0\",","+            \"peerDependencies\": { \"@pnpm.e2e/deprecated\": \"1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write the local package.json\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { \"local\": \"file:./local\" } }).to_string(),","+    )","+    .expect(\"write package.json\");","+","+    let assertion = pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let stdout = String::from_utf8_lossy(&assertion.get_output().stdout).into_owned();","+    assert!(","+        stdout.contains(\"[WARN] deprecated: @pnpm.e2e/deprecated@1.0.0\"),","+        \"the auto-installed peer's deprecation should be reported:\\n{stdout}\",","+    );","+","+    drop((root, mock_instance));","+}","+"," /// `catalog:` on a direct dep should be dereferenced through"," /// `pnpm-workspace.yaml`'s `catalog` section before the npm resolver"," /// sees it. The fetched virtual-store entry is the catalog's resolved"],"additions":52,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -247,6 +247,7 @@ mod with;"," mod workspace_bins;"," mod workspace_cycles;"," mod workspace_install;","+mod workspace_install_summary;"," mod workspace_path_overrides;"," mod workspace_peer_pins;"," mod workspace_settings_check;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/workspace_install_summary.rs","lines":["@@ -0,0 +1,121 @@","+//! The packages-diff summary of an install in a workspace of several","+//! projects: changes merged across projects, attributed to the projects","+//! that made them, and a project's first install kept out of the list.","+","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::{","+    AddMockedRegistry,","+    CommandTempCwd,","+};","+use pretty_assertions::assert_eq;","+use std::{","+    fs,","+    path::Path,","+    process::Command,","+};","+","+fn pacquet_at(dir: &Path) -> Command {","+    Command::cargo_bin(\"pnpm\").expect(\"find the pnpm binary\").with_current_dir(dir)","+}","+","+fn write_project(dir: &Path, name: &str, dependencies: &serde_json::Value) {","+    fs::create_dir_all(dir).expect(\"create the project directory\");","+    let manifest = serde_json::json!({ \"name\": name, \"dependencies\": dependencies });","+    fs::write(dir.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+}","+","+/// A workspace of the root and `projects`, each without dependencies.","+fn workspace_of(projects: &[&str]) -> CommandTempCwd<AddMockedRegistry> {","+    let fixture = CommandTempCwd::init().add_mocked_registry();","+    let workspace_yaml_path = fixture.workspace.join(\"pnpm-workspace.yaml\");","+    let mut workspace_yaml =","+        fs::read_to_string(&workspace_yaml_path).expect(\"read pnpm-workspace.yaml\");","+    if !workspace_yaml.ends_with('\\n') {","+        workspace_yaml.push('\\n');","+    }","+    workspace_yaml.push_str(\"packages:\\n  - 'packages/*'\\n\");","+    fs::write(&workspace_yaml_path, workspace_yaml).expect(\"write pnpm-workspace.yaml\");","+    write_project(&fixture.workspace, \"root\", &serde_json::json!({}));","+    for project in projects {","+        write_project(","+            &fixture.workspace.join(\"packages\").join(project),","+            project,","+            &serde_json::json!({}),","+        );","+    }","+    fixture","+}","+","+/// The summary's lines, from the first dependency-type header to the end","+/// of the last change.","+fn install_summary(dir: &Path) -> String {","+    let assert = pacquet_at(dir)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let stdout = String::from_utf8_lossy(&assert.get_output().stdout).into_owned();","+    eprintln!(\"STDOUT:\\n{stdout}\");","+    let is_summary_line = |line: &&str| {","+        line.ends_with(\"ependencies:\") || line.starts_with(\"+ \") || line.starts_with(\"- \")","+    };","+    stdout","+        .lines()","+        .filter(is_summary_line)","+        .collect::<Vec<_>>()","+        .join(\"\\n\")","+}","+","+// Every version below is its package's latest, so no line carries an","+// \"is available\" note and no first-install line is listed for being","+// outdated.","+","+#[test]","+fn first_workspace_install_lists_only_deprecated_dependencies() {","+    let fixture = workspace_of(&[\"a\", \"b\"]);","+    let workspace = &fixture.workspace;","+    let foo = serde_json::json!({ \"@pnpm.e2e/foo\": \"100.1.0\" });","+    write_project(workspace, \"root\", &foo);","+    write_project(","+        &workspace.join(\"packages/a\"),","+        \"a\",","+        &serde_json::json!({ \"@pnpm.e2e/deprecated\": \"1.0.0\", \"@pnpm.e2e/bar\": \"100.1.0\" }),","+    );","+    write_project(&workspace.join(\"packages/b\"), \"b\", &foo);","+","+    assert_eq!(","+        install_summary(workspace),","+        \"dependencies:\\n+ @pnpm.e2e/deprecated 1.0.0 deprecated  packages/a\",","+    );","+","+    drop(fixture);","+}","+","+#[test]","+fn workspace_install_attributes_changes_to_projects() {","+    let fixture = workspace_of(&[\"a\", \"b\", \"c\"]);","+    let workspace = &fixture.workspace;","+    let foo = serde_json::json!({ \"@pnpm.e2e/foo\": \"100.1.0\" });","+    let bar = serde_json::json!({ \"@pnpm.e2e/bar\": \"100.1.0\" });","+    let foo_and_bar = serde_json::json!({ \"@pnpm.e2e/foo\": \"100.1.0\", \"@pnpm.e2e/bar\": \"100.1.0\" });","+    write_project(workspace, \"root\", &foo);","+    for project in [\"a\", \"b\", \"c\"] {","+        write_project(&workspace.join(\"packages\").join(project), project, &foo);","+    }","+    assert_eq!(install_summary(workspace), \"\");","+","+    write_project(workspace, \"root\", &bar);","+    for project in [\"a\", \"b\"] {","+        write_project(&workspace.join(\"packages\").join(project), project, &foo_and_bar);","+    }","+    write_project(&workspace.join(\"packages/new\"), \"new\", &bar);","+","+    assert_eq!(","+        install_summary(workspace),","+        \"dependencies:\\n\\","+         + @pnpm.e2e/bar 100.1.0  ., packages/a, packages/b\\n\\","+         - @pnpm.e2e/foo 100.1.0\",","+    );","+","+    drop(fixture);","+}"],"additions":121,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/src/lib.rs","lines":["@@ -73,6 +73,7 @@ static STREAM_LIFECYCLE_OUTPUT: OnceLock<bool> = OnceLock::new();"," static AGGREGATE_OUTPUT: OnceLock<bool> = OnceLock::new();"," static HIDE_LIFECYCLE_PREFIX: OnceLock<bool> = OnceLock::new();"," static IS_GLOBAL: OnceLock<bool> = OnceLock::new();","+static EDITS_MANIFESTS: OnceLock<bool> = OnceLock::new();"," static IS_RECURSIVE: OnceLock<bool> = OnceLock::new();"," static MAX_LOG_LEVEL: OnceLock<MaxLogLevel> = OnceLock::new();"," ","@@ -103,6 +104,12 @@ pub fn set_is_global(is_global: bool) {","     let _ = IS_GLOBAL.set(is_global);"," }"," ","+/// Whether the command edits the manifests of the projects it installs, as","+/// `add`, `remove` and `update` do. Call before the first event.","+pub fn set_edits_manifests(edits_manifests: bool) {","+    let _ = EDITS_MANIFESTS.set(edits_manifests);","+}","+"," /// Set the project root the reporter renders paths relative to. Call once"," /// before the first event; ignored if already set."," pub fn set_cwd(cwd: impl Into<String>) {","@@ -263,6 +270,14 @@ impl DefaultReporter {","         let output = sink.state.flush_pending_approvals();","         sink.write(output, false);","     }","+","+    /// Print the deprecation warnings no install summary or `Done in ...`","+    /// footer carried.","+    pub fn flush_pending_deprecations() {","+        let mut sink = SINK.lock().unwrap_or_else(std::sync::PoisonError::into_inner);","+        let output = sink.state.flush_pending_deprecations();","+        sink.write(output, false);","+    }"," }"," "," static SINK: LazyLock<Mutex<Sink>> = LazyLock::new(|| Mutex::new(Sink::new()));","@@ -538,6 +553,7 @@ fn reporter_options(append_only: bool) -> state::ReporterOptions {","                 .unwrap_or(SummaryScope::CurrentPrefix),","             reports_scope: REPORTS_SCOPE.get().is_some_and(|value| *value),","             is_global: IS_GLOBAL.get().is_some_and(|value| *value),","+            edits_manifests: EDITS_MANIFESTS.get().is_some_and(|value| *value),","             recursive: IS_RECURSIVE.get().is_some_and(|value| *value),","         },","         ..state::ReporterOptions::default()"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state.rs","lines":["@@ -18,6 +18,7 @@ use std::{","         BTreeMap,","         BTreeSet,","         HashMap,","+        HashSet,","     },","     path::{","         Component,","@@ -56,6 +57,7 @@ use pnpm_reporter::{","     SkippedOptionalReason,","     Stage,","     StatsMessage,","+    SummaryLog,","     UpdateCheckLog,"," };"," use serde_json::Value;","@@ -134,6 +136,9 @@ struct PackageDiff {"," struct ManifestDiff {","     initial: Option<Value>,","     updated: Option<Value>,","+    /// Whether the edit from `initial` to `updated` is already folded into","+    /// the summary's changes.","+    applied: bool,"," }"," "," /// The five dependency buckets, in summary render order.","@@ -230,9 +235,20 @@ struct InstallProgress {","     stats_slot: BlockSlot,"," }"," ","+/// [`PackageDiff`]s keyed by [`diff_key`], then by sign and name.","+type DiffBuckets = HashMap<&'static str, HashMap<String, PackageDiff>>;","+"," struct SummaryState {","-    diff: HashMap<&'static str, HashMap<String, PackageDiff>>,","+    /// The changes of the current project, or of every project under","+    /// [`SummaryScope::AllPrefixes`].","+    diff: DiffBuckets,","+    /// The changes of the other projects, keyed by normalized prefix. Only","+    /// a workspace summary renders them.","+    other_projects: HashMap<String, DiffBuckets>,","+    /// Keyed by normalized prefix.","     manifest_diffs: HashMap<String, ManifestDiff>,","+    /// Set by a `pnpm:summary` that covers a workspace of several projects.","+    workspace: Option<WorkspaceSummary>,","     slot: BlockSlot,","     seen: bool,","     rendered: bool,","@@ -253,7 +269,12 @@ struct LifecycleState {"," struct NoticeState {","     warnings: usize,","     collapsed_slot: BlockSlot,","-    deprecated_subdeps: Vec<DeprecationLog>,","+    /// Every `pnpm:deprecation` not printed yet. pnpm reports each","+    /// deprecated package once, for whichever project reached it first.","+    deprecations: Vec<DeprecationLog>,","+    /// The index in `deprecations` of the first notice of each package, by","+    /// name and then version.","+    deprecation_index: HashMap<String, HashMap<String, usize>>,","     deprecated_slot: BlockSlot,","     reported_peer_issues: bool,","     approvals: PendingApprovals,","@@ -376,7 +397,7 @@ impl ReporterState {","             LogEvent::Stats(log) => self.on_stats(&log.message),","             LogEvent::Root(log) => self.on_root(&log.message),","             LogEvent::PackageManifest(log) => self.on_manifest(&log.message),","-            LogEvent::Summary(log) => self.on_summary(&log.prefix),","+            LogEvent::Summary(log) => self.on_summary(log),","             LogEvent::Lifecycle(log) => self.on_lifecycle(&log.message),","             LogEvent::IgnoredScripts(log) => self.on_ignored_scripts(log),","             LogEvent::PendingSkills(log) => self.on_pending_skills(log),","@@ -478,6 +499,11 @@ mod progress;"," "," mod summary;"," ","+mod deprecations;","+","+mod workspace_summary;","+use workspace_summary::WorkspaceSummary;","+"," mod manifest_diff;"," use manifest_diff::{","     added_diff,","@@ -535,14 +561,20 @@ impl Frame {","     }"," }"," ","+fn empty_diff_buckets() -> DiffBuckets {","+    SUMMARY_ORDER","+        .into_iter()","+        .map(|kind| (diff_key(kind), HashMap::new()))","+        .collect()","+}","+"," impl Default for SummaryState {","     fn default() -> Self {","         Self {","-            diff: SUMMARY_ORDER","-                .into_iter()","-                .map(|kind| (diff_key(kind), HashMap::new()))","-                .collect(),","+            diff: empty_diff_buckets(),","+            other_projects: HashMap::new(),","             manifest_diffs: HashMap::new(),","+            workspace: None,","             slot: BlockSlot::default(),","             seen: false,","             rendered: false,"],"additions":39,"deletions":7,"truncated":false},{"path":"pnpm/crates/default-reporter/src/state/deprecations.rs","lines":["@@ -0,0 +1,193 @@","+//! Deprecation warnings. They are held until the install summary renders:","+//! a summary line of a deprecated package carries the warning, and the","+//! deprecated packages no line names follow the summary's sections, named","+//! when this install added them and counted when it did not. What no summary","+//! carries is printed when the command ends.","+","+use super::{","+    BTreeMap,","+    BTreeSet,","+    BlockPlacement,","+    DeprecationLog,","+    HashSet,","+    Output,","+    PackageDiff,","+    ReporterState,","+    normalized_prefix,","+};","+","+impl ReporterState {","+    pub(super) fn on_deprecation(&mut self, log: &DeprecationLog) {","+        self.notices.deprecation_index","+            .entry(log.pkg_name.clone())","+            .or_default()","+            .entry(log.pkg_version.clone())","+            .or_insert(self.notices.deprecations.len());","+        self.notices.deprecations.push(log.clone());","+    }","+","+    /// The index of the held warning for the package a summary line names.","+    pub(super) fn deprecation_of(&self, diff: &PackageDiff) -> Option<usize> {","+        let version = diff.version.as_deref()?;","+        let name = diff.real_name.as_deref().unwrap_or(&diff.name);","+        self.notices.deprecation_index","+            .get(name)?","+            .get(version)","+            .copied()","+    }","+","+    /// The `name@version` of the deprecated package a summary line names.","+    pub(super) fn deprecated_label_of(&self, diff: &PackageDiff) -> Option<String> {","+        self.deprecation_of(diff)","+            .map(|index| pkg_label(&self.notices.deprecations[index]))","+    }","+","+    /// What a summary line of a deprecated package ends with.","+    pub(super) fn deprecation_marker(&self, diff: &PackageDiff) -> String {","+        self.deprecation_of(diff)","+            .map(|index| {","+                format!(","+                    \" {}{}\",","+                    self.rendering.colors.red(\"deprecated\"),","+                    alternative_hint(&self.notices.deprecations[index]),","+                )","+            })","+            .unwrap_or_default()","+    }","+","+    /// The warnings for the held deprecations of packages that no summary","+    /// line in `shown` (by `name@version`) carries. Packages this install","+    /// added get one line per direct dependency, then one listing the","+    /// subdependencies. Packages the previous install already had are only","+    /// counted.","+    pub(super) fn deprecation_warnings(&self, shown: &HashSet<String>) -> Vec<String> {","+        let mut direct: BTreeMap<String, (&DeprecationLog, Vec<String>)> = BTreeMap::new();","+        let mut subdependencies: BTreeSet<String> = BTreeSet::new();","+        let mut still_installed: BTreeSet<String> = BTreeSet::new();","+        for log in &self.notices.deprecations {","+            let label = pkg_label(log);","+            if shown.contains(&label) {","+                continue;","+            }","+            if log.already_installed {","+                still_installed.insert(label);","+            } else if log.depth != 0 {","+                subdependencies.insert(label);","+            } else {","+                direct","+                    .entry(label)","+                    .or_insert_with(|| (log, Vec::new()))","+                    .1","+                    .push(normalized_prefix(&self.rendering.cwd, &log.prefix));","+            }","+        }","+        let mut warnings: Vec<String> = direct","+            .into_iter()","+            .map(|(label, (log, projects))| self.direct_deprecation_warning(&label, log, &projects))","+            .collect();","+        if !subdependencies.is_empty() {","+            warnings.push(self.subdependencies_warning(&subdependencies));","+        }","+        if !still_installed.is_empty() {","+            warnings.push(self.still_installed_warning(still_installed.len()));","+        }","+        warnings","+    }","+","+    fn direct_deprecation_warning(","+        &self,","+        label: &str,","+        log: &DeprecationLog,","+        projects: &[String],","+    ) -> String {","+        let projects = self","+            .project_names(","+                projects","+                    .iter()","+                    .map(String::as_str)","+                    .collect(),","+            )","+            .map(|names| format!(\" ({names})\"))","+            .unwrap_or_default();","+        format!(","+            \"{} {} {label}{projects}{}\",","+            self.rendering.colors.warn_label(),","+            self.rendering.colors.red(\"deprecated:\"),","+            alternative_hint(log),","+        )","+    }","+","+    fn subdependencies_warning(&self, labels: &BTreeSet<String>) -> String {","+        let found = format!(\"{} deprecated subdependencies found:\", labels.len());","+        let labels: Vec<&str> = labels","+            .iter()","+            .map(String::as_str)","+            .collect();","+        format!(","+            \"{} {} {}\",","+            self.rend