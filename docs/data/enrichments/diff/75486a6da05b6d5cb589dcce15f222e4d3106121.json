---------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import type { CopilotSession, CurrentToolMetadata, SessionEvent, SessionEventPayload, SessionHooks } from '@github/copilot-sdk';","+import { raceCancellationError, raceTimeout } from '../../../../base/common/async.js';","+import { CancellationToken, CancellationTokenSource } from '../../../../base/common/cancellation.js';","+import { CancellationError, isCancellationError } from '../../../../base/common/errors.js';","+import { Disposable, DisposableStore } from '../../../../base/common/lifecycle.js';","+import { ILogService } from '../../../log/common/log.js';","+import { ITelemetryService } from '../../../telemetry/common/telemetry.js';","+import { CopilotCliConfigKey, copilotCliConfigSchema, CopilotSearchSubagentGrepNudgeSettingId } from '../../common/copilotCliConfig.js';","+import { IAgentConfigurationService } from '../agentConfigurationService.js';","+import { AgentHostSettingExperimentTrigger } from '../agentHostSettingExperimentTrigger.js';","+import { isSyntheticUserMessage } from './copilotFusionEventIdentity.js';","+import { CopilotToolName } from './copilotToolDisplay.js';","+","+type PreToolUseHookInput = Parameters<NonNullable<SessionHooks['onPreToolUse']>>[0];","+type PreToolUseHookOutput = Awaited<ReturnType<NonNullable<SessionHooks['onPreToolUse']>>>;","+","+const LOOKUP_BUDGET_MS = 500;","+","+/** Defers at most one root grep per user message, without granting tool permission. */","+export class CopilotGrepSearchNudge extends Disposable {","+\tprivate _messageId: string | undefined;","+\tprivate readonly _userMessageIds = new Set<string>();","+\tprivate _historyGeneration = 0;","+\tprivate _evaluatedMessageId: string | undefined;","+\tprivate readonly _experimentTrigger: AgentHostSettingExperimentTrigger;","+","+\tconstructor(","+\t\tprivate _historyKnown: boolean,","+\t\t@IAgentConfigurationService private readonly _configurationService: IAgentConfigurationService,","+\t\t@ITelemetryService telemetryService: ITelemetryService,","+\t\t@ILogService private readonly _logService: ILogService,","+\t) {","+\t\tsuper();","+\t\tthis._experimentTrigger = this._register(new AgentHostSettingExperimentTrigger(CopilotSearchSubagentGrepNudgeSettingId, this._configurationService, telemetryService));","+\t}","+","+\trecordUserMessage(event: SessionEventPayload<'user.message'>): void {","+\t\tif (this._userMessageIds.size >= 3 || event.agentId || isSyntheticUserMessage(event) || this._userMessageIds.has(event.id)) {","+\t\t\treturn;","+\t\t}","+\t\tthis._userMessageIds.add(event.id);","+\t\tthis._messageId = event.id;","+\t}","+","+\t/** Reuses normal history restoration in both experiment arms, without adding an eligibility RPC. */","+\tasync trackHistory(read: Promise<readonly SessionEvent[]>): Promise<readonly SessionEvent[]> {","+\t\tconst generation = this._historyGeneration;","+\t\tconst events = await read;","+\t\tif (generation === this._historyGeneration) {","+\t\t\tconst liveMessageId = this._messageId;","+\t\t\tfor (const event of events) {","+\t\t\t\tif (this._userMessageIds.size >= 3) {","+\t\t\t\t\tbreak;","+\t\t\t\t}","+\t\t\t\tif (event.type === 'user.message') {","+\t\t\t\t\tthis.recordUserMessage(event);","+\t\t\t\t}","+\t\t\t}","+\t\t\tthis._messageId = liveMessageId ?? this._messageId;","+\t\t\tthis._historyKnown = true;","+\t\t}","+\t\treturn events;","+\t}","+","+\tresetHistory(): void {","+\t\tthis._historyGeneration++;","+\t\tthis._messageId = undefined;","+\t\tthis._userMessageIds.clear();","+\t\tthis._historyKnown = false;","+\t\tthis._evaluatedMessageId = undefined;","+\t}","+","+\tasync evaluate(input: PreToolUseHookInput, session: CopilotSession, token: CancellationToken): Promise<PreToolUseHookOutput> {","+\t\tif (input.agentId || input.sessionId !== session.sessionId","+\t\t\t|| (input.toolName !== CopilotToolName.Grep && input.toolName !== CopilotToolName.Rg)) {","+\t\t\treturn undefined;","+\t\t}","+","+\t\tif (!this._historyKnown || !this._messageId || this._userMessageIds.size >= 3","+\t\t\t|| this._configurationService.getRootValue(copilotCliConfigSchema, CopilotCliConfigKey.SearchSubagent) !== true) {","+\t\t\treturn undefined;","+\t\t}","+","+\t\t// These local eligibility checks are identical in control and treatment.","+\t\tthis._experimentTrigger.report();","+\t\tif (this._configurationService.getRootValue(copilotCliConfigSchema, CopilotCliConfigKey.SearchSubagentGrepNudge) !== true) {","+\t\t\treturn undefined;","+\t\t}","+\t\tconst messageId = this._messageId;","+\t\tif (this._evaluatedMessageId === messageId) {","+\t\t\treturn undefined;","+\t\t}","+","+\t\t// Reserve before awaiting so parallel calls share the one-lookup-per-message budget.","+\t\tthis._evaluatedMessageId = messageId;","+\t\tconst historyGeneration = this._historyGeneration;","+\t\tconst deadline = Date.now() + LOOKUP_BUDGET_MS;","+\t\tlet search: CurrentToolMetadata | undefined;","+\t\ttry {","+\t\t\tconst { tools } = await this._readWithinBudget(() => session.rpc.tools.getCurrentMetadata(), token, deadline);","+\t\t\tsearch = tools?.find(tool => tool.name === CopilotToolName.SearchCodeSubagent);","+\t\t} catch (error) {","+\t\t\tif (isCancellationError(error) || token.isCancellationRequested) {","+\t\t\t\tthrow new CancellationError();","+\t\t\t}","+\t\t\tthis._logService.warn('[CopilotGrepSearchNudge] Could not determine nudge eligibility; continuing through normal tool checks.', error);","+\t\t\treturn undefined;","+\t\t}","+\t\tif (token.isCancellationRequested) {","+\t\t\tthrow new CancellationError();","+\t\t}","+\t\tif (historyGeneration !== this._historyGeneration || messageId !== this._messageId || this._userMessageIds.size >= 3) {","+\t\t\treturn undefined;","+\t\t}","+","+\t\tif (!search) {","+\t\t\treturn undefined;","+\t\t}","+","+\t\tif (this._configurationService.getRootValue(copilotCliConfigSchema, CopilotCliConfigKey.SearchSubagentGrepNudge) !== true","+\t\t\t|| this._configurationService.getRootValue(copilotCliConfigSchema, CopilotCliConfigKey.SearchSubagent) !== true) {","+\t\t\treturn undefined;","+\t\t}","+","+\t\tconst message = [","+\t\t\t`This ${input.toolName} search has NOT run. Are you sure grep is the best next step? Consider ${search.name} for code exploration instead.`,","+\t\t\t`Call ${search.name} as a normal tool call using the definition below, not as JSON in assistant text.`,","+\t\t\t`If grep is still preferable, call ${input.toolName} again. Further grep calls for this user message proceed through normal permissions without another nudge. Do not ask the user to confirm.`,","+\t\t\tJSON.stringify({ name: search.name, description: search.description, input_schema: search.input_schema }),","+\t\t].join('\\n\\n');","+\t\treturn { permissionDecision: 'deny', permissionDecisionReason: message, additionalContext: message };","+\t}","+","+\tprivate async _readWithinBudget<T extends object>(read: () => Promise<T>, token: CancellationToken, deadline: number): Promise<T> {","+\t\tif (token.isCancellationRequested) {","+\t\t\tthrow new CancellationError();","+\t\t}","+\t\tconst remaining = deadline - Date.now();","+\t\tif (remaining <= 0) {","+\t\t\tthrow new Error('Grep nudge eligibility lookup timed out.');","+\t\t}","+\t\tconst store = new DisposableStore();","+\t\tconst cts = store.add(new CancellationTokenSource(token));","+\t\ttry {","+\t\t\tconst result = await raceTimeout(raceCancellationError(read(), cts.token), remaining);","+\t\t\tif (!result) {","+\t\t\t\tthrow new Error('Grep nudge eligibility lookup timed out.');","+\t\t\t}","+\t\t\treturn result;","+\t\t} finally {","+\t\t\tcts.cancel();","+\t\t\tstore.dispose();","+\t\t}","+\t}","+}"],"additions":160,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/copilotAgentSession.test.ts","lines":["@@ -127,7 +127,7 @@ import { buildCopilotSystemNotification, getCopilotSubagentDisplayNames } from '"," import { IAgentConfigurationService } from '../../node/agentConfigurationService.js';"," import { SessionConfigKey } from '../../common/sessionConfigKeys.js';"," import { AgentHostAssistedApprovalInstructionsConfigKey, AgentHostAutoApprovePolicyRestrictedConfigKey, AgentHostAutoReplyAnswer, AgentHostAutoReplyEnabledConfigKey, AgentHostComputerUseEnabledConfigKey, AgentHostDisableRepoInfoTelemetryConfigKey, AgentHostExtensionPermissionApprovalsConfigKey, AgentHostGlobalAutoApproveEnabledConfigKey, AgentHostMcpConnectorsEnabledConfigKey, AgentHostMcpSkillsEnabledConfigKey, AgentHostMcpSamplingAllowedServersConfigKey, AgentHostMcpSkillsServerApprovalsConfigKey, AgentHostMcpToolRoutingEnabledConfigKey } from '../../common/agentHostSchema.js';","-import { AgentHostCopilotExecutionSubagentEnabledSettingId, AgentHostCopilotExecutionSubagentModelSettingId, AgentHostCopilotProgressUpdatesPromptSettingId, CopilotCliConfigKey, CopilotCliVSCodeAssignmentContextKey } from '../../common/copilotCliConfig.js';","+import { AgentHostCopilotExecutionSubagentEnabledSettingId, AgentHostCopilotExecutionSubagentModelSettingId, AgentHostCopilotProgressUpdatesPromptSettingId, CopilotCliConfigKey, CopilotCliVSCodeAssignmentContextKey, CopilotSearchSubagentGrepNudgeSettingId } from '../../common/copilotCliConfig.js';"," import { setAdvertisedAutoModeTiers } from '../../common/autoModeTiers.js';"," import { TestExperimentTriggerTelemetryService } from '../../../telemetry/test/common/experimentTriggerTestUtils.js';"," import { SEMANTIC_SEARCH_TOOL_NAME } from '../../common/semanticSearchConstants.js';","@@ -355,6 +355,8 @@ class MockCopilotSession {"," \tcommandInvokeResult: Awaited<ReturnType<CopilotSession['rpc']['commands']['invoke']>> = { kind: 'text', text: '' };"," \tcommandInvokeError