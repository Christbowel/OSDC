HeadersFrame(postHeaders(), false).stream(stream1))","+        EmbeddedTestUtil.advance(server, client)","+        def data1 = randomData(10)","+        client.writeOutbound(new DefaultHttp2DataFrame(data1.retainedSlice(), false).stream(stream1))","+        EmbeddedTestUtil.advance(server, client)","+        // without the validation of the client's headers","+        def trailers = new DefaultHttp2Headers(false)","+        trailers.set(name, value)","+        client.writeOutbound(new DefaultHttp2HeadersFrame(trailers, true).stream(stream1))","+        EmbeddedTestUtil.advance(server, client)","+","+        then: \"the trailers do not complete the body, and only this stream is reset\"","+        collector.err != null","+        client.readInbound() instanceof Http2SettingsFrame","+        client.readInbound() instanceof Http2SettingsAckFrame","+        Http2ResetFrame rst = client.readInbound()","+        rst.stream() == stream1","+        rst.errorCode() == Http2Error.PROTOCOL_ERROR.code()","+        server.isOpen()","+","+        cleanup:","+        collector.received.release()","+        data1.release()","+        client.checkException()","+        server.checkException()","+        client.finishAndReleaseAll()","+        server.finishAndReleaseAll()","+        EmbeddedTestUtil.advance(client, server)","+","+        where:","+        name                | value","+        \"x-checksum\"        | \"abc\\r\\ninjected: yes\"","+        \"content-length\"    | \"10\"","+        \"transfer-encoding\" | \"chunked\"","+    }","+","     def \"graceful goaway does not cancel in-flight streams\"() {","         given:","         def collector = new BodyCollector()"],"additions":53,"deletions":0,"truncated":false},{"path":"http-server-netty/src/test/groovy/io/micronaut/http/server/netty/handler/PipeliningServerHandlerSpec.groovy","lines":["@@ -2553,4 +2553,65 @@ class PipeliningServerHandlerSpec extends Specification {","             }","         }","     }","+","+    def 'a streamed response with invalid trailers fails and closes the connection: #name'(String name, String value) {","+        given:","+        def resp = new DefaultHttpResponse(HttpVersion.HTTP_1_1, HttpResponseStatus.OK)","+        resp.headers().add(HttpHeaderNames.TRANSFER_ENCODING, HttpHeaderValues.CHUNKED)","+        def failed = []","+        def written = 0","+        def ch = new EmbeddedChannel(new PipeliningServerHandler(new RequestHandler() {","+            @Override","+            void accept(ChannelHandlerContext ctx, HttpRequest request, CloseableByteBody body, OutboundAccess outboundAccess) {","+                body.close()","+                def factory = new NettyByteBodyFactory(ctx.channel())","+                // netty headers filled without validation","+                def trailers = new DefaultHttpHeaders(false)","+                trailers.add(name, value)","+                outboundAccess.write(resp, factory.withTrailers(factory.adaptNetty(Flux.just(Unpooled.copiedBuffer(\"foo\", StandardCharsets.UTF_8))), trailers))","+            }","+","+            @Override","+            void handleUnboundError(Throwable cause) {","+                cause.printStackTrace()","+            }","+","+            @Override","+            void responseWritten(Object attachment) {","+                written++","+            }","+","+            @Override","+            void responseFailed(Object attachment, Throwable cause) {","+                failed << cause","+            }","+        }))","+","+        when:","+        ch.writeInbound(new DefaultFullHttpRequest(HttpVersion.HTTP_1_1, HttpMethod.GET, \"/\"))","+        ch.runPendingTasks()","+","+        then:","+        failed.size() == 1","+        failed[0] instanceof IllegalArgumentException","+        written == 1","+        !ch.isOpen()","+        // the response is cut instead of ending with the invalid trailers","+        def out = []","+        Object msg","+        while ((msg = ch.readOutbound()) != null) {","+            out << msg","+        }","+        !out.any { it instanceof LastHttpContent }","+","+        cleanup:","+        out.each { io.netty.util.ReferenceCountUtil.release(it) }","+        ch.finishAndReleaseAll()","+","+        where:","+        name                | value","+        \"x-checksum\"        | \"abc\\r\\ninjected: yes\"","+        \"content-length\"    | \"3\"","+        \"transfer-encoding\" | \"chunked\"","+    }"," }"],"additions":61,"deletions":0,"truncated":false},{"path":"src/main/docs/guide/appendix/breaks.adoc","lines":["@@ -1,6 +1,10 @@"," "," This section documents breaking changes between Micronaut versions"," ","+=== Trailers are validated (5.3)","+","+The trailers of a body, which the Netty client sends after a request body and the Netty server after a response body, were previously copied into the message without validation, so a value with a line break was written as is. They are now validated: a name or value with a forbidden character, such as a CR or LF in a value, and the headers that frame a message, `Content-Length`, `Transfer-Encoding` and `Trailer`, are rejected, and the exchange fails instead of sending them. The denylist is this framing set, the same one Netty applies; it does not enforce the wider list of fields that RFC 9110 §6.5.1 says must not be sent in trailers, such as `Host`, `Authorization`, `Content-Type` or `Set-Cookie`. In the trailers of a received HTTP/2 request, the Netty server treats invalid trailers, including these framing headers, as a stream error: the stream is reset with `PROTOCOL_ERROR` and the request body fails instead of completing. This differs from HTTP/1, where Netty drops the framing headers from received trailers and fails the request only for a forbidden character.","+"," === Closing the HTTP client fails the requests that wait for a connection (5.3)"," "," When a Netty HTTP client is closed, a request that waits for a pooled connection, for example because the pool has reached `max-concurrent-http1-connections`, now completes with an api:http.client.exceptions.UnprocessedRequestException[] of reason `POOL_ACQUIRE`. Previously such a request stayed pending, and the pool opened new connections for it as the closed connections went away: with an event loop group shared with another client, the request and those connections waited forever. The closed client opens no more connections, and a connection that was still being established when the client closed is closed once it is established.",""],"additions":4,"deletions":0,"truncated":false}],"additions":209,"deletions":20,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-21T16:32:36.426933+00:00"}