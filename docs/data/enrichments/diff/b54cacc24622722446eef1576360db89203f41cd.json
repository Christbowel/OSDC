 HttpResponse response) {","-            HttpHeaders trailers = NettyByteBodyFactory.trailersToSend(body);","+            HttpHeaders trailers;","+            try {","+                trailers = NettyByteBodyFactory.trailersToSend(body);","+            } catch (RuntimeException e) {","+                // e.g. trailers that are not valid: the caller resets the stream","+                last.release();","+                throw e;","+            }","             if (trailers == null) {","                 writeData(last, true, endPromise(response));","                 return;"],"additions":8,"deletions":1,"truncated":false},{"path":"http-server-netty/src/main/java/io/micronaut/http/server/netty/handler/PipeliningServerHandler.java","lines":["@@ -2584,11 +2584,13 @@ public void write(ByteBuf data, boolean last) {","                 return;","             }","             LastHttpContent content;","-            if (data.isReadable()) {","+            try {","                 content = lastContent(data);","-            } else {","+            } catch (IllegalArgumentException e) {","+                // trailers that are not valid: the response cannot end properly","                 data.release();","-                content = lastContent(null);","+                fail(e);","+                return;","             }","             detach();","             try {","@@ -2646,15 +2648,18 @@ public void responseWritten() {","          * The HTTP/1 encoder only sends trailers in chunked mode: a body with trailers has no","          * expected length, or its known length is ignored, so its response is chunked.","          *","-         * @param content The final bytes, or {@code null} for none","+         * @param content The final bytes, possibly empty. Released or taken over, unless the","+         *                trailers are not valid","          * @return The last content","+         * @throws IllegalArgumentException if the trailers are not valid","          */","-        p