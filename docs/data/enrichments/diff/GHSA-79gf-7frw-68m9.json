ce","+metadata:","+  name: tenant-ns"],"additions":4,"deletions":0,"truncated":false},{"path":"test/conformance/chainsaw/namespaced-generating-policies/data/cross-namespace-denied/policy.yaml","lines":["@@ -0,0 +1,34 @@","+# A NamespacedGeneratingPolicy in tenant-ns that attempts to generate a","+# ConfigMap into the \"default\" namespace (a namespace other than its own). The","+# generator lib enforces the namespace boundary at evaluation time, so the","+# cross-namespace ConfigMap must never be created.","+apiVersion: policies.kyverno.io/v1beta1","+kind: NamespacedGeneratingPolicy","+metadata:","+  name: cross-ns-escalate","+  namespace: tenant-ns","+spec:","+  matchConstraints:","+    resourceRules:","+    - apiGroups:   [\"\"]","+      apiVersions: [\"v1\"]","+      operations:  [\"CREATE\", \"UPDATE\"]","+      resources:   [\"namespaces\"]","+  variables:","+    - name: configmap","+      expression: >-","+        [","+          {","+            \"kind\": dyn(\"ConfigMap\"),","+            \"apiVersion\": dyn(\"v1\"),","+            \"metadata\": dyn({","+              \"name\": \"should-not-exist\",","+              \"namespace\": \"default\",","+            }),","+            \"data\": dyn({","+              \"managed-by\": \"kyverno\"","+            })","+          }","+        ]","+  generate:","+    - expression: generator.apply(\"default\", variables.configmap)"],"additions":34,"deletions":0,"truncated":false},{"path":"test/conformance/chainsaw/namespaced-generating-policies/data/cross-namespace-denied/trigger-namespace.yaml","lines":["@@ -0,0 +1,4 @@","+apiVersion: v1","+kind: Namespace","+metadata:","+  name: cross-ns-trigger",""],"additions":4,"deletions":0,"truncated":false}],"additions":215,"deletions":4,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-08-27T18:53:19.277852+00:00"}