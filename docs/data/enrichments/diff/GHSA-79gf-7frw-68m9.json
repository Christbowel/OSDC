hinery/pkg/api/meta\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+)","+","+func generateTestRESTMapper() meta.RESTMapper {","+\tgvs := []schema.GroupVersion{","+\t\t{Group: \"\", Version: \"v1\"},","+\t\t{Group: \"rbac.authorization.k8s.io\", Version: \"v1\"},","+\t\t{Group: \"networking.k8s.io\", Version: \"v1\"},","+\t}","+\tm := meta.NewDefaultRESTMapper(gvs)","+\tm.Add(schema.GroupVersionKind{Group: \"\", Version: \"v1\", Kind: \"ConfigMap\"}, meta.RESTScopeNamespace)","+\tm.Add(schema.GroupVersionKind{Group: \"rbac.authorization.k8s.io\", Version: \"v1\", Kind: \"ClusterRoleBinding\"}, meta.RESTScopeRoot)","+\tm.Add(schema.GroupVersionKind{Group: \"networking.k8s.io\", Version: \"v1\", Kind: \"IngressClass\"}, meta.RESTScopeRoot)","+\treturn m","+}","+","+func clusterRoleBinding() map[string]any {","+\treturn map[string]any{","+\t\t\"apiVersion\": \"rbac.authorization.k8s.io/v1\",","+\t\t\"kind\":       \"ClusterRoleBinding\",","+\t\t\"metadata\":   map[string]any{\"name\": \"escalate\"},","+\t}","+}","+","+// A namespaced policy passes its own namespace as the apply() argument, which","+// satisfies the namespace-boundary check, but a cluster-scoped resource still","+// escapes that namespace. It must be rejected.","+func TestGenerateResources_NamespacedPolicyRejectsClusterScoped(t *testing.T) {","+\tcp := &contextProvider{","+\t\tcliEvaluation: true,","+\t\trestMapper:    generateTestRESTMapper(),","+\t}","+","+\terr := cp.GenerateResources(\"tenant-ns\", []map[string]any{clusterRoleBinding()})","+\tassert.Error(t, err, \"namespaced policy must not generate a cluster-scoped resource\")","+\tassert.Contains(t, err.Error(), \"cross-scope generation denied\")","+\tassert.Empty(t, cp.GetGeneratedResources())","+}","+","+// A namespaced resource generated into the policy namespace is still allowed.","+func TestGenerateResources_NamespacedPolicyAllowsNamespaced(t *testing.T) {","+\tcp := &contextProvider{","+\t\tcliEvaluation: true,","+\t\trestMapper:    generateTestRESTMapper(),","+\t}","+","+\tcm := map[string]any{","+\t\t\"apiVersion\": \"v1\",","+\t\t\"kind\":       \"ConfigMap\",","+\t\t\"metadata\":   map[string]any{\"name\": \"data\", \"namespace\": \"tenant-ns\"},","+\t}","+\terr := cp.GenerateResources(\"tenant-ns\", []map[string]any{cm})","+\tassert.NoError(t, err)","+\tassert.Len(t, cp.GetGeneratedResources(), 1)","+\tassert.Equal(t, \"tenant-ns\", cp.GetGeneratedResources()[0].GetNamespace())","+}","+","+// A cluster-scoped policy uses an empty namespace argument and may still","+// generate cluster-scoped resources.","+func TestGenerateResources_ClusterPolicyAllowsClusterScoped(t *testing.T) {","+\tcp := &contextProvider{","+\t\tcliEvaluation: true,","+\t\trestMapper:    generateTestRESTMapper(),","+\t}","+","+\terr := cp.GenerateResources(\"\", []map[string]any{clusterRoleBinding()})","+\tassert.NoError(t, err)","+\tassert.Len(t, cp.GetGeneratedResources(), 1)","+\tassert.Empty(t, cp.GetGeneratedResources()[0].GetNamespace())","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"pkg/cel/policies/gpol/compiler/compiler.go","lines":["@@ -78,6 +78,7 @@ func (c *compilerImpl) createBaseGpolEnv(libsctx libs.Context, namespace string)"," \t\tcel.Variable(compiler.ExceptionsKey, types.NewObjectType(\"libs.Exception\")),"," \t\tgenerator.Lib("," \t\t\tgenerator.Context{ContextInterface: libsctx},","+\t\t\tnamespace,"," \t\t\tgenerator.Latest(),"," \t\t),"," \t\tglobalcontext.Lib("],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/cel/policies/gpol/engine/engine_test.go","lines":["@@ -13,6 +13,7 @@ import ("," \tadmissionregistrationv1 \"k8s.io/api/admissionregistration/v1\""," \tv1 \"k8s.io/api/authentication/v1\""," \tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," \t\"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured\""," \t\"k8s.io/apimachinery/pkg/runtime/schema\""," )","@@ -205,6 +206,42 @@ func TestHandle(t *testing.T) {"," \t\tassert.NotNil(t, resp)"," \t})"," ","+\tt.Run(\"NamespacedGeneratingPolicy with cross-namespace generator.apply compiles (enforcement is at runtime)\", func(t *testing.T) {","+\t\tngpol := &v1beta1.NamespacedGeneratingPolicy{","+\t\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\t\tName:      \"cross-ns-escalate\",","+\t\t\t\tNamespace: \"tenant-ns\",","+\t\t\t},","+\t\t\tSpec: v1beta1.GeneratingPolicySpec{","+\t\t\t\tMatchConstraints: &admissionregistrationv1.MatchResources{","+\t\t\t\t\tResourceRules: []admissionregistrationv1.NamedRuleWithOperations{","+\t\t\t\t\t\t{","+\t\t\t\t\t\t\tRuleWithOperations: admissionregistrationv1.RuleWithOperations{","+\t\t\t\t\t\t\t\tOperations: []admissionregistrationv1.OperationType{admissionregistrationv1.OperationAll},","+\t\t\t\t\t\t\t\tRule: admissionregistrationv1.Rule{","+\t\t\t\t\t\t\t\t\tAPIGroups:   []string{\"\"},","+\t\t\t\t\t\t\t\t\tAPIVersions: []string{\"v1\"},","+\t\t\t\t\t\t\t\t\tResources:   []string{\"configmaps\"},","+\t\t\t\t\t\t\t\t},","+\t\t\t\t\t\t\t},","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t\tGeneration: []v1beta1.Generation{","+\t\t\t\t\t{","+\t\t\t\t\t\tExpression: `generator.apply(\"kube-system\", [{\"apiVersion\": dyn(\"v1\"), \"kind\": dyn(\"ConfigMap\")}])`,","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t\tcomp := compiler.NewCompiler()","+\t\t// The namespace boundary is enforced at evaluation time by the generator","+\t\t// lib's namespacedImpl, so compilation of a namespaced policy that targets","+\t\t// another namespace must still succeed.","+\t\t_, errList := comp.Compile(ngpol, nil)","+\t\tassert.Nil(t, errList)","+\t})","+"," \tt.Run(\"should evaluate compiled policy with variable expressions and policy exceptions\", func(t *testing.T) {"," \t\tobj.SetNamespace(\"default\")"," \t\tgpol := &v1beta1.GeneratingPolicy{"],"additions":37,"deletions":0,"truncated":false},{"path":"pkg/cel/policies/mpol/compiler/compiler.go","lines":["@@ -158,6 +158,7 @@ func (c *compilerImpl) newExtendedEnv(libCtx lib