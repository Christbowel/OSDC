_tag,","+                Fido2EnrollFlags fido2_flags,","+                char **pins,","+                const struct iovec *unsealed,","+                struct iovec *ret_secret) {","+","+#if HAVE_LIBFIDO2","+        _cleanup_(iovec_done_erase) struct iovec fido2_salt = {};","+        _cleanup_(erase_and_freep) void *secret = NULL;","+        size_t secret_size;","+        int r;","+","+        assert(fido2_cid);","+        assert(unsealed);","+        assert(ret_secret);","+","+        /* For TPM2+FIDO2 tokens the unsealed secret is not the passphrase. Instead, the passphrase is the","+         * FIDO2 token's hmac-secret for a salt derived from the unsealed secret, see","+         * tpm2_fido2_derive_salt(). */","+","+        /* Only hand the salt to a FIDO2 token after making sure that the public key we are going to verify","+         * the token with belongs to this enrollment. */","+        r = tpm2_fido2_verify_public_key_tag(unsealed, fido2_public_key_algorithm, fido2_public_key, fido2_public_key_tag);","+        if (r == -EBADMSG) {","+                log_error_errno(r, \"The FIDO2 public key in the TPM2+FIDO2 token does not match the sealed secret, \"","+                                \"the LUKS2 header was tampered with or is corrupted.\");","+                return -EPERM;","+        }","+        if (r < 0)","+                return log_error_errno(r, \"Failed to verify FIDO2 public key: %m\");","+","+        r = tpm2_fido2_derive_salt(unsealed, &fido2_salt);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to derive FIDO2 salt: %m\");","+","+        r = fido2_use_hmac_hash(","+                        fido2_device,","+                        fido2_rp ?: \"io.systemd.cryptsetup\",","+                        fido2_salt.iov_base, fido2_salt.iov_len,","+                        fido2_cid->iov_base, fido2_cid->iov_len,","+                        fido2_public_key,","+                        fido2_public_key_algorithm,","+                        pins,","+                        fido2_flags,","+                        &secret,","+                        &secret_size);","+        if (r == -ENOLCK) /* libcryptsetup returns -ENOANO also on wrong PIN */","+                return -ENOANO;","+        if (IN_SET(r, -EAGAIN, -EBADSLT))","+                /* None of the plugged-in FIDO2 tokens holds the credential (-EAGAIN), or the configured one","+                 * does not (-EBADSLT): treat it like a missing token, see acquire_luks2_key(). */","+                return -ENOMEDIUM;","+        if (r == -ENOSTR)","+                /* The user didn't touch the token in time. The token module turns -ENOSTR into \"no matching","+                 * TPM2 token data\" and moves on to the next token, hence remap it. */","+                return -ETIMEDOUT;","+        if (r == -EKEYREJECTED) {","+                /* A device claimed to have the credential but couldn't prove it. The salt was not handed","+                 * out. Let libcryptsetup move on to the next token. */","+                log_error_errno(r, \"No FIDO2 token proved possession of the enrolled credential, refusing to unlock with this token.\");","+                return -EPERM;","+        }","+        if (r < 0)","+                return r;","+","+        *ret_secret = IOVEC_MAKE(TAKE_PTR(secret), secret_size);","+        return 0;","+#else","+        return log_debug_errno(SYNTHETIC_ERRNO(EPERM), \"FIDO2 support not available, skipping TPM2+FIDO2 token.\");","+#endif","+}","+"," int acquire_luks2_key(","                 const char *device,","                 uint32_t hash_pcr_mask,","@@ -35,13 +114,22 @@ int acquire_luks2_key(","                 const struct iovec *pcrlock_nv,","                 TPM2Flags flags,","                 const Argon2IdParameters *argon2id_params,","+                const char *fido2_device,","+                const struct iovec *fido2_cid,","+                const char *fido2_rp,","+                const struct iovec