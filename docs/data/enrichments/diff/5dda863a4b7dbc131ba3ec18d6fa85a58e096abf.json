/","+/// The output dispatcher shows it each output as it arrives from the engine,","+/// before the output reaches the request's stream, so it does not depend on","+/// how fast the stream is read. It runs under the request registry's lock and","+/// must not block. It is dropped when the request leaves the client: on","+/// finish, on abort (including a dropped stream), when sending the request","+/// fails, or when the client closes.","+pub trait RequestObserver: Send + std::fmt::Debug {","+    /// Observe one output of the request.","+    fn observe_output(&mut self, output: &EngineCoreOutput);","+}","+"," #[derive(Debug)]"," struct TrackedRequest {","     sender: OutputSender,","     engine_id: EngineId,","     lora: Option<LoraRequestState>,","     admission_stats_generation: Option<u64>,","+    observer: Option<Box<dyn RequestObserver>>,"," }"," "," /// Frontend-side view of one LoRA request's scheduling phase.","@@ -192,12 +206,20 @@ impl RequestRegistry {","                 engine_id: engine_id.clone(),","                 lora,","                 admission_stats_generation,","+                observer: None,","             },","         );"," ","         Ok((engine_id, rx))","     }"," ","+    /// Attach an observer to a request just registered. It sees the request's","+    /// outputs and is dropped when the request leaves the registry.","+    pub fn observe(&mut self, request_id: &str, observer: Box<dyn RequestObserver>) {","+        let tracked = (self.requests.get_mut(request_id)).expect(\"the request was just registered\");","+        tracked.observer = Some(observer);","+    }","+","     fn choose_engine_for_request(&mut self, data_parallel_rank: Option<u32>) -> Result<EngineId> {","         if let Some(rank) = data_parallel_rank {","             let engine_id = u16::try_from(rank).ok().map(EngineId::from_engine_index);","@@ -249,6 +271,11 @@ impl RequestRegistry {","         output: EngineCoreStreamOutput,","     ) -> Option<EngineCoreStreamOutput> {