 2, 3], [2, 2])","+      let reads = 0","+      Object.defineProperty(values, \"2\", {get: () => {","+        reads++","+        return 2","+      }})","+      const source = ColumnDataSource.create({data: {values}})","+      const row = source.get_row(1)","+      const replacement = [10, 20]","+      row.values = replacement","+      expect(row.values).to.be.identical(replacement)","+      expect(reads).to.be.equal(0)","+      delete row.values","+      expect(Object.keys(row)).to.be.equal([])","+      expect(reads).to.be.equal(0)","+","+      const read_row = source.get_row(1)","+      const value = read_row.values as number[]","+      value[0] = 99","+      expect(read_row.values).to.be.equal([99, 3])","+      expect(source.get_row(1).values).to.be.equal([2, 3])","+      read_row.values = replacement","+      expect(read_row.values).to.be.identical(replacement)","+    })","+","+    it(\"should read logical rows from shaped columns\", () => {","+      const numeric = new Float64NDArray([0, 1, 2, 3, 4, 5, 6, 7], [2, 2, 2])","+      const objects = new ObjectNDArray([\"a\", \"b\", \"c\", \"d\"], [2, 2])","+      const source = ColumnDataSource.create({data: {numeric, objects, label: [\"first\", \"second\"]}})","+      expect(source.get_row(1)).to.be.equal({numeric: [[4, 5], [6, 7]], objects: [\"c\", \"d\"], label: \"second\"})","+      expect(source.get_row(2)).to.be.equal({numeric: undefined, objects: undefined, label: undefined})","+      expect(source.get_column(\"numeric\")).to.be.identical(numeric)","+      expect(Array.from(numeric)).to.be.equal([0, 1, 2, 3, 4, 5, 6, 7])","+    })","+","+    it(\"should use the image's outer row without indexing its pixels\", () => {","+      const image = new Float64NDArray([0, 1, 2, 3], [2, 2])","+      const source = ColumnDataSource.create({data: {image: [image], label: [\"image\"]}})","+      const row = source.get_row({index: 0, i: 0, j: 1, flat_index: 2})"],"additions":74,"deletions":1,"truncated":false}],"additions":38