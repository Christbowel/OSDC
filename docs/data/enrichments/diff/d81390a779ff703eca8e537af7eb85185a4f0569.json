le fit-width\" data-col=\"5\" data-type=\"num\" role=\"button\" title=\"Sort by length\">","+                                <th class=\"sortable fit-width\" data-col=\"6\" data-type=\"num\" role=\"button\" title=\"Sort by length\">","                                     <span class=\"text-nowrap\">Length <i class=\"bi bi-arrow-down-up sort-indicator\"></i>","                                         <i class=\"bi bi-info-circle\" data-bs-toggle=\"tooltip\" data-bs-placement=\"top\"","                                            title=\"Number of groups; the identical length of the index, keys and data arrays.\"></i>","                                     </span>","                                 </th>","-                                <th class=\"sortable fit-width\" data-col=\"6\" data-type=\"num\" role=\"button\" title=\"Sort by rehashes\">","+                                <th class=\"sortable fit-width\" data-col=\"7\" data-type=\"num\" role=\"button\" title=\"Sort by rehashes\">","                                     <span class=\"text-nowrap\">Rehashes <i class=\"bi bi-arrow-down-up sort-indicator\"></i>","                                         <i class=\"bi bi-info-circle\" data-bs-toggle=\"tooltip\" data-bs-placement=\"top\"","                                            title=\"Number of rehashes since this shard was created.\"></i>","@@ -103,6 +109,7 @@","                                     <td class=\"align-middle font-monospace small fit-width\">{{ .Shard }}</td>","                                     <td class=\"align-middle font-monospace small fit-width\">{{ .Resident }}</td>","                                     <td class=\"align-middle font-monospace small fit-width\">{{ .Dead }}</td>","+                                    <td class=\"align-middle font-monospace small fit-width\">{{ .Spilled }}</td>","                                     <td class=\"align-middle font-monospace small fit-width\">{{ .Limit }}</td>","                                     <td class=\"align-middle font-monospace small fit-width\">{{ .Length }}</td>","                                     <td class=\"align-middle font-monospace small fit-width\">{{ .Rehashes }}</td>"],"additions":11,"deletions":4,"truncated":false},{"path":"pkg/usagetracker/partition_handler.go","lines":["@@ -27,6 +27,7 @@ import ("," \t\"go.uber.org/atomic\""," "," \t\"github.com/grafana/mimir/pkg/storage/ingest\"","+\t\"github.com/grafana/mimir/pkg/usagetracker/tenantshard\""," \t\"github.com/grafana/mimir/pkg/usagetracker/usagetrackerpb\""," \t\"github.com/grafana/mimir/pkg/util\""," )","@@ -120,6 +121,7 @@ func newPartitionHandler("," \tsnapshotsKafkaWriter *kgo.Client,"," \tsnapshotsBucket objstore.InstrumentedBucket,"," \tlim limiter,","+\tnewShard tenantshard.Factory,"," \tlogger log.Logger,"," \tregisterer prometheus.Registerer,"," ) (*partitionHandler, error) {","@@ -208,7 +210,7 @@ func newPartitionHandler("," \t}"," "," \teventsPublisher := chanEventsPublisher{events: p.pendingCreatedSeriesMarshaledEvents, logger: logger}","-\tp.store = newTrackerStore(cfg.IdleTimeout, cfg.UserCloseToLimitPercentageThreshold, logger, lim, eventsPublisher, cfg.EnableVerboseSeriesCreationDeletionPrometheusMetrics, cfg.MinTimeBetweenShardsCleanup)","+\tp.store = newTrackerStore(cfg.IdleTimeout, cfg.UserCloseToLimitPercentageThreshold, logger, lim, eventsPublisher, cfg.EnableVerboseSeriesCreationDeletionPrometheusMetrics, cfg.MinTimeBetweenShardsCleanup, newShard)"," \tp.Service = services.NewBasicService(p.start, p.run, p.stop)"," \treturn p, nil"," }"],"additions":3,"deletions":1,"truncated":false},{"path":"pkg/usagetracker/partition_handler_test.go","lines":["@@ -669,7 +669,7 @@ func (h *partitionHandlerTestHelper) newHandlerForPartitionID(t *testing.T, part"," \trequire.NoError(t, err)"," \tstartServiceAndStopOnCleanup(t, instanceRing)"," ","-\tp, err := newPartitionHandler(partitionID, cfg, h.pkv, h.eventsKafkaWriter, h.snapshotsKafkaWriter, h.snapshotsBucket, h.limiter, logger, reg)","+\tp, err := newPartitionHandler(partitionID, cfg, h.pkv, h.eventsKafkaWriter, h.snapshotsKafkaWriter, h.snapshotsBucket, h.limiter, newTestShardFactory(), logger, reg)"," \trequire.NoError(t, err)"," \treturn p"," }"],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/usagetracker/tenantshard/tenantshard.go","lines":["@@ -0,0 +1,122 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+// Package tenantshard holds the map implementations that store the series of one tenant shard,","+// together with the interface the usage-tracker store uses to talk to them.","+//","+// There are two implementations, selected at runtime by the usage-tracker configuration:","+// v1 keeps tombstones for the series that idle-series cleanup removes, while v2 keeps one","+// spillmark per group instead, so cleanup never writes to the keys array.","+package tenantshard","+","+import (","+\t\"fmt\"","+\t\"iter\"","+\t\"sync\"","+","+\t\"go.uber.org/atomic\"","+","+\t\"github.com/grafana/mimir/pkg/usagetracker/clock\"","+\tv1 \"github.com/grafana/mimir/pkg/usagetracker/tenantshard/v1\"","+\tv2 \"github.com/grafana/mimir/pkg/usagetracker/tenantshard/v2\"","+)","+","+const (","+\t// NumShards is the number of shards used by the tracker store per tenant.","+\t// Implementations size themselves relative to it, so their copies must hold the same value.","+\tNumShards = 16","+","+\t// DefaultImplVersion is the implementation used unless it is configured otherwise.","+\tDefaultImplVersion = 1","+)","+","+// Map stores the last time each series of one tenant shard was seen.","+// Implementations are not safe for concurrent use: callers hold the Map's lock around every call.","+type Map interface {","+\tsync.Locker","+","+\t// Put inserts key and value into the map.","+\t// series is incremented if it's not nil and it's below limit, unless track is false.","+\t// If track is false, then the value is only updated if it's greater than the current value.","+\tPut(key uint64, value clock.Minutes, series, limit *atomic.Uint64, track bool) (created, rejected bool)","+","+\t// Load inserts key and value without checking whether key already exists.","+\t// No limits are checked, and the series count should be incremented by the caller.","+\tLoad(key uint64, value clock.Minutes)","+","+\t// Count returns the number of series in the map.","+\tCount() int","+","+\t// Cleanup removes the series that were last seen at or before watermark, and returns how many","+\t// were removed. limit is the tenant-wide series limit, and may be nil.","+\tCleanup(watermark clock.Minutes, limit *atomic.Uint64) int","+","+\t// EnsureCapacity makes sure that the map can store n elements without growing.","+\tEnsureCapacity(n uint32)","+","+\t// Items returns the number of series in the map and an iterator over them.","+\tItems() (length int, iterator iter.Seq2[uint64, clock.Minutes])","+","+\t// Stats returns a snapshot of the map's internal counters.","+\tStats() Stats","+}","+","+// Stats is a point-in-time snapshot of a Map's internal counters, used for debugging.","+// Counters that don't apply to the implementation in use are zero.","+type Stats struct {","+\t// Resident is the number of elements held in the map, including the dead ones in v1.","+\tResident uint32 `json:\"resident\"`","+\t// Dead is the number of dead elements (tombstones). Only v1 creates those.","+\tDead uint32 `json:\"dead\"`","+\t// Spilled is the number of groups that spilled to the next one(s). Only v2 counts those.","+\tSpilled uint32 `json:\"spilled\"`","+\t// Limit is the resident count that triggers a rehash when reached.","+\tLimit uint32 `json:\"limit\"`","+\t// Length is the number of groups, i.e. the (identical) length of the index, keys and data arrays.","+\tLength int `json:\"length\"`","+\t// Rehashes is the number of rehashes since the Map was created.","+\tRehashes uint32 `json:\"rehashes\"`","+}","+","+// Factory creates a Map with capacity for size elements.","+type Factory func(size uint32) Map","+","+// NewFactory returns a Factory that builds maps of the given implementation version.","+func NewFactory(version int) (Factory, error) {","+\tswitch version {","+\tcase 1:","+\t\treturn func(size uint32) Map { return v1Map{v1.New(size)} }, nil","+\tcase 2:","+\t\treturn func(size uint32) Map { return v2Map{v2.New(size)} }, nil","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"unsupported tenant shard map implementation version %d, supported versions are 1 and 2\", version)","+\t}","+}","+","+// v1Map adapts v1.Map to the Map interface, and v2Map does the same for v2.Map.","+// Only Stats needs adapting: the implementations don't import this package, so they can't return","+// its Stats type. Every other method is promoted from the embedded map.","+type v1Map struct{ *v1.Map }","+","+func (m v1Map) Stats() Stats {","+\ts := m.Map.Stats()","+\treturn Stats{","+\t\tResident: s.Resident,","+\t\tDead:     s.Dead,","+\t\tLimit:    s.Limit,","+\t\tLength:   s.Length,","+\t\tRehashes: s.Rehashes,","+\t}","+}","+","+type v2Map struct{ *v2.Map }","+","+func (m v2Map) Stats() Stats {","+\ts := m.Map.Stats()","+\treturn Stats{","+\t\tResident: s.Resident,","+\t\tSpilled:  s.Spilled,","+\t\tLimit:    s.Limit,","+\t\tLength:   s.Length,","+\t\tRehashes: s.Rehashes,","+\t}","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pkg/usagetracker/tenantshard/tenantshard_test.go","lines":["@@ -0,0 +1,324 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+package tenantshard","+","+import (","+\t\"fmt\"","+\t\"math/rand\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\t\"go.uber.org/atomic\"","+","+\t\"github.com/grafana/mimir/pkg/usagetracker/clock\"","+\tv1 \"github.com/grafana/mimir/pkg/usagetracker/tenantshard/v1\"","+\tv2 \"github.com/grafana/mimir/pkg/usagetracker/tenantshard/v2\"","+)","+","+// forEachImplementation runs test against every Map implementation. Tests here cover the behaviour","+// that all implementations share, so they only use the Map interface: anything that depends on how","+// an implementation stores its elements, counts its rehashes or sizes itself belongs in its own","+// package.","+func forEachImplementation(t *testing.T, test func(t *testing.T, newMap Factory)) {","+\tt.Helper()","+\tfor _, version := range []int{1, 2} {","+\t\tt.Run(fmt.Sprintf(\"v%d\", version), func(t *testing.T) {","+\t\t\tnewMap, err := NewFactory(version)","+\t\t\trequire.NoError(t, err)","+\t\t\ttest(t, newMap)","+\t\t})","+\t}","+}","+","+// itemsMap collects Items() into a map.","+func itemsMap(t *testing.T, m Map) map[uint64]clock.Minutes {","+\tt.Helper()","+\tgot := map[uint64]clock.Minutes{}","+\t_, items := m.Items()","+\tfor key, value := range items {","+\t\tgot[key] = value","+\t}","+\treturn got","+}","+","+func TestNumShards(t *testing.T) {","+\t// Implementations divide the tenant-wide limit by their own copy of the constant, so all of","+\t// them have to agree on its value.","+\trequire.Equal(t, NumShards, v1.NumShards)","+\trequire.Equal(t, NumShards, v2.NumShards)","+}","+","+func TestNewFactory(t *testing.T) {","+\tt.Run(\"default version\", func(t *testing.T) {","+\t\tnewMap, err := NewFactory(DefaultImplVersion)","+\t\trequire.NoError(t, err)","+\t\trequire.NotNil(t, newMap(8))","+\t})","+","+\tt.Run(\"unsupported version\", func(t *testing.T) {","+\t\tnewMap, err := NewFactory(3)","+\t\trequire.EqualError(t, err, \"unsupported tenant shard map implementation version 3, supported versions are 1 and 2\")","+\t\trequire.Nil(t, newMap)","+\t})","+}","+","+func TestMap(t *testing.T) {","+\tforEachImplementation(t, func(t *testing.T, newMap Factory) {","+\t\tseries := atomic.NewUint64(0)","+\t\tconst events = 5","+\t\tconst seriesPerEvent = 5","+\t\tlimit := atomic.NewUint64(uint64(events * seriesPerEvent))","+","+\t\t// Start small, let rehashing happen.","+\t\tm := newMap(seriesPerEvent)","+","+\t\tstoredValues := map[uint64]clock.Minutes{}","+\t\tfor i := 1; i <= events; i++ {","+\t\t\trefs := make([]uint64, seriesPerEvent)","+\t\t\tfor j := range refs {","+\t\t\t\trefs[j] = uint64(i*100 + j)","+\t\t\t\tstoredValues[refs[j]] = clock.Minutes(i)","+\t\t\t\tcreated, rejected := m.Put(refs[j], clock.Minutes(i), series, limit, false)","+\t\t\t\trequire.True(t, created)","+\t\t\t\trequire.False(t, rejected)","+\t\t\t}","+\t\t}","+","+\t\trequire.Equal(t, events*seriesPerEvent, m.Count())","+\t\trequire.Equal(t, uint64(events*seriesPerEvent), series.Load())","+","+\t\t{","+\t\t\t// No more series will fit.","+\t\t\tcreated, rejected := m.Put(uint64(65535), 1, series, limit, true)","+\t\t\trequire.False(t, created)","+\t\t\trequire.True(t, rejected)","+\t\t}","+","+\t\t{","+\t\t\tgotValues := map[uint64]clock.Minutes{}","+\t\t\tlength, items := m.Items()","+\t\t\trequire.Equal(t, len(storedValues), length)","+\t\t\tfor key, value := range items {","+\t\t\t\tgotValues[key] = value","+\t\t\t}","+\t\t\trequire.Equal(t, storedValues, gotValues)","+\t\t}","+","+\t\t{","+\t\t\t// Cleanup first wave of series","+\t\t\tremoved := m.Cleanup(clock.Minutes(1), nil)","+\t\t\tseries.Add(-uint64(removed))","+\t\t\texpectedSeries := (events - 1) * seriesPerEvent","+","+\t\t\trequire.Equal(t, expectedSeries, int(series.Load()))","+\t\t\trequire.Equal(t, expectedSeries, m.Count())","+\t\t}","+\t})","+}","+","+func TestMapValues(t *testing.T) {","+\tforEachImplementation(t, func(t *testing.T, newMap Factory) {","+\t\tconst count = 10e3","+\t\tstored := map[uint64]clock.Minutes{}","+\t\tm := newMap(100)","+\t\ttotal := atomic.NewUint64(0)","+\t\tfor i := 0; i < count; i++ {","+\t\t\tkey := rand.Uint64()","+\t\t\tval := clock.Minutes(i)","+\t\t\tif val >= 0xfe {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tstored[key] = val","+\t\t\tm.Put(key, val, total, nil, false)","+\t\t}","+\t\trequire.Equal(t, len(stored), m.Count())","+\t\trequire.Equal(t, len(stored), int(total.Load()))","+","+\t\trequire.Equal(t, stored, itemsMap(t, m))","+\t})","+}","+","+func TestMapCleanup(t *testing.T) {","+\tforEachImplementation(t, func(t *testing.T, newMap Factory) {","+\t\tt.Run(\"empty map\", func(t *testing.T) {","+\t\t\tm := newMap(8)","+\t\t\trequire.Equal(t, 0, m.Cleanup(100, nil))","+\t\t\trequire.Equal(t, 0, m.Count())","+\t\t\trequire.Zero(t, m.Stats().Resident)","+\t\t})","+","+\t\tt.Run(\"no entries expired\", func(t *testing.T) {","+\t\t\tm := newMap(8)","+\t\t\tm.Load(1, 50)","+\t\t\tm.Load(2, 60)","+\t\t\tm.Load(3, 70)","+","+\t\t\trequire.Equal(t, 0, m.Cleanup(10, nil)) // watermark=10 is before all entries","+\t\t\trequire.Equal(t, 3, m.Count())","+\t\t\trequire.Equal(t, uint32(3), m.Stats().Resident)","+\t\t})","+","+\t\tt.Run(\"all entries expired\", func(t *testing.T) {","+\t\t\tm := newMap(8)","+\t\t\tm.Load(1, 10)","+\t\t\tm.Load(2, 20)","+\t\t\tm.Load(3, 30)","+","+\t\t\trequire.Equal(t, 3, m.Cleanup(30, nil)) // watermark=30 expires all","+\t\t\trequire.Equal(t, 0, m.Count())","+\t\t\trequire.Empty(t, itemsMap(t, m))","+\t\t})","+","+\t\tt.Run(\"some entries expired some not\", func(t *testing.T) {","+\t\t\tm := newMap(16)","+\t\t\tm.Load(100, 10)","+\t\t\tm.Load(200, 20)","+\t\t\tm.Load(300, 30)","+\t\t\tm.Load(400, 40)","+\t\t\tm.Load(500, 50)","+","+\t\t\trequire.Equal(t, 3, m.Cleanup(30, nil)) // expire entries with value <= 30","+\t\t\trequire.Equal(t, 2, m.Count())","+","+\t\t\t// Survivors should be findable.","+\t\t\tgot := itemsMap(t, m)","+\t\t\trequire.Equal(t, map[uint64]clock.Minutes{400: 40, 500: 50}, got)","+\t\t})","+","+\t\tt.Run(\"survivors findable via put update path\", func(t *testing.T) {","+\t\t\tm := newMap(16)","+\t\t\tm.Load(100, 10) // will expire","+\t\t\tm.Load(200, 50) // will survive","+\t\t\tm.Load(300, 50) // will survive","+\t\t\tm.Load(400, 10) // will expire","+","+\t\t\trequire.Equal(t, 2, m.Cleanup(20, nil))","+\t\t\trequire.Equal(t, 2, m.Count())","+","+\t\t\t// Update survivors via Put, which should find them instead of creating new ones.","+\t\t\tcreated, _ := m.Put(200, 60, nil, nil, false)","+\t\t\trequire.False(t, created, \"should update existing entry, not create new\")","+\t\t\tcreated, _ = m.Put(300, 60, nil, nil, false)","+\t\t\trequire.False(t, created, \"should update existing entry, not create new\")","+","+\t\t\trequire.Equal(t, 2, m.Count())","+\t\t})","+","+\t\tt.Run(\"count and items consistent after cleanup\", func(t *testing.T) {","+\t\t\tm := newMap(32)","+\t\t\texpected := map[uint64]clock.Minutes{}","+\t\t\tfor i := uint64(0); i < 20; i++ {","+\t\t\t\tval := clock.Minutes(10)","+\t\t\t\tif i%2 == 0 {","+\t\t\t\t\tval = 50 // survivors","+\t\t\t\t\texpected[i] = val","+\t\t\t\t}","+\t\t\t\tm.Load(i, val)","+\t\t\t}","+","+\t\t\trequire.Equal(t, 10, m.Cleanup(20, nil)) // expire val<=20","+\t\t\trequire.Equal(t, len(expected), m.Count())","+\t\t\trequire.Equal(t, expected, itemsMap(t, m))","+\t\t})","+","+\t\tt.Run(\"repeated cleanup at the same watermark is a no-op\", func(t *testing.T) {","+\t\t\t// Removals leave a mark behind that keeps probing going. A scan that mistakes one for a","+\t\t\t// live entry removes it again on every pass, and the counters drift.","+\t\t\tm := newMap(16)","+\t\t\tsurvivors := map[uint64]clock.Minutes{}","+\t\t\t// Sequential keys all probe from the same group, so groups fill up completely and the","+\t\t\t// removals below have to leave their marks in them.","+\t\t\tfor i := uint64(0); i < 16; i++ {","+\t\t\t\tval := clock.Minutes(50)","+\t\t\t\tif i%2 == 0 {","+\t\t\t\t\tval = 10 // expires below","+\t\t\t\t} else {","+\t\t\t\t\tsurvivors[i] = val","+\t\t\t\t}","+\t\t\t\tm.Load(i, val)","+\t\t\t}","+\t\t\trequire.Equal(t, 8, m.Cleanup(10, nil))","+","+\t\t\tfor range 3 {","+\t\t\t\trequire.Zero(t, m.Cleanup(10, nil))","+\t\t\t\trequire.Equal(t, len(survivors), m.Count())","+\t\t\t\trequire.Equal(t, survivors, itemsMap(t, m))","+\t\t\t}","+\t\t})","+","+\t\tt.Run(\"sequential cleanups with interleaved puts\", func(t *testing.T) {","+\t\t\tm := newMap(32)","+","+\t\t\t// Round 1: insert keys with value 10.","+\t\t\tfor i := uint64(0); i < 10; i++ {","+\t\t\t\tm.Load(i, 10)","+\t\t\t}","+\t\t\trequire.Equal(t, 10, m.Cleanup(10, nil)) // expire all","+\t\t\trequire.Equal(t, 0, m.Count())","+","+\t\t\t// Round 2: insert new keys with value 20.","+\t\t\tfor i := uint64(100); i < 110; i++ {","+\t\t\t\tm.Load(i, 20)","+\t\t\t}","+\t\t\trequire.Equal(t, 10, m.Count())","+","+\t\t\t// Round 3: expire half, add more.","+\t\t\tfor i := uint64(110); i < 120; i++ {","+\t\t\t\tm.Load(i, 30)","+\t\t\t}","+\t\t\trequire.Equal(t, 10, m.Cleanup(20, nil)) // expire value<=20","+\t\t\trequire.Equal(t, 10, m.Count())","+","+\t\t\t// All remaining should be keys 110-119.","+\t\t\tgot := itemsMap(t, m)","+\t\t\tfor i := uint64(110); i < 120; i++ {","+\t\t\t\trequire.Contains(t, got, i)","+\t\t\t\trequire.Equal(t, clock.Minutes(30), got[i])","+\t\t\t}","+\t\t})","+","+\t\tt.Run(\"large scale correctness\", func(t *testing.T) {","+\t\t\t// Insert many elements with mixed timestamps, cleanup, verify survivors.","+\t\t\tconst n = 10000","+\t\t\tm := newMap(uint32(n))","+\t\t\texpected := map[uint64]clock.Minutes{}","+\t\t\tfor i := uint64(0); i < n; i++ {","+\t\t\t\tval := clock.Minutes(i % 100)","+\t\t\t\tif val >= 0xfe {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tm.Load(i, val)","+\t\t\t\tif val > 50 {","+\t\t\t\t\texpected[i] = val","+\t\t\t\t}","+\t\t\t}","+","+\t\t\trequire.Equal(t, n-len(expected), m.Cleanup(50, nil)) // expire val <= 50","+\t\t\trequire.Equal(t, len(expected), m.Count())","+\t\t\trequire.Equal(t, expected, itemsMap(t, m))","+\t\t})","+","+\t\tt.Run(\"put after cleanup finds correct entries\", func(t *testing.T) {","+\t\t\t// Regression test: after cleanup, Put must still find existing keys and not create","+\t\t\t// duplicates.","+\t\t\tm := newMap(32)","+\t\t\tseries := atomic.NewUint64(0)","+\t\t\tfor i := uint64(0); i < 20; i++ {","+\t\t\t\tm.Put(i, clock.Minutes(i%50+1), series, nil, false)","+\t\t\t}","+\t\t\trequire.Equal(t, uint64(20), series.Load())","+","+\t\t\tm.Cleanup(10, nil) // expire val <= 10","+","+\t\t\t// Try to Put all 20 keys again. Expired ones should be created, survivors updated.","+\t\t\tfor i := uint64(0); i < 20; i++ {","+\t\t\t\tcreated, _ := m.Put(i, 40, series, nil, false)","+\t\t\t\tif i%50+1 <= 10 {","+\t\t\t\t\trequire.True(t, created, \"key %d was expired, should be created\", i)","+\t\t\t\t} else {","+\t\t\t\t\trequire.False(t, created, \"key %d survived cleanup, should be updated\", i)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t})","+}"],"additions":324,"deletions":0,"truncated":false},{"path":"pkg/usagetracker/tenantshard/v1/map.go","lines":["rename from pkg/usagetracker/tenantshard/map.go","rename to pkg/usagetracker/tenantshard/v1/map.go","@@ -3,7 +3,7 @@"," // Provenance-includes-license: Apache-2.0"," // Provenance-includes-copyright: Dolthub, Inc."," ","-package tenantshard","+package v1"," "," import ("," \t\"iter\""],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/usagetracker/tenantshard/v1/map_nonsimd.go","lines":["rename from pkg/usagetracker/tenantshard/map_nonsimd.go","rename to pkg/usagetracker/tenantshard/v1/map_nonsimd.go","@@ -3,7 +3,7 @@"," // Provenance-includes-license: Apache-2.0"," // Provenance-includes-copyright: Dolthub, Inc."," ","-package tenantshard","+package v1"," "," import ("," \t\"math/bits\""],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/usagetracker/tenantshard/v1/map_nonsimd_test.go","lines":["rename from pkg/usagetracker/tenantshard/map_nonsimd_test.go","rename to pkg/usagetracker/tenantshard/v1/map_nonsimd_test.go","@@ -1,6 +1,6 @@"," // SPDX-License-Identifier: AGPL-3.0-only"," ","-package tenantshard","+package v1"," "," import ("," \t\"testing\""],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/usagetracker/tenantshard/v1/map_test.go","lines":["rename from pkg/usagetracker/tenantshard/map_test.go","rename to pkg/usagetracker/tenantshard/v1/map_test.go","@@ -1,6 +1,6 @@"," // SPDX-License