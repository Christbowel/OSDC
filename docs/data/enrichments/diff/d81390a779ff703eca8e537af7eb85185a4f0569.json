{"id":"d81390a779ff703eca8e537af7eb85185a4f0569","axis":"silent","repo":"grafana/mimir","sha":"d81390a779ff703eca8e537af7eb85185a4f0569","parsed":{"files":[{"path":"pkg/usagetracker/debug_http_test.go","lines":["@@ -21,7 +21,7 @@ func TestTrackerStore_ShardStats(t *testing.T) {"," \tlimits := limiterMock{\"user-a\": 100, \"user-b\": 100}"," \tnow := time.Date(2020, 1, 1, 1, 2, 3, 0, time.UTC)"," ","-\tstore := newTrackerStore(idleTimeout, 85, log.NewNopLogger(), limits, noopEvents{}, false, 0)","+\tstore := newTrackerStore(idleTimeout, 85, log.NewNopLogger(), limits, noopEvents{}, false, 0, newTestShardFactory())"," "," \t_, err := store.trackSeries(context.Background(), \"user-b\", []uint64{1, 2, 3, 4, 5}, now)"," \trequire.NoError(t, err)","@@ -71,7 +71,7 @@ func TestUsageTrackerPartitionTemplates(t *testing.T) {"," \t\tInstanceID: \"usage-tracker-zone-a-0\","," \t\tPartition:  7,"," \t\tShards: []ShardStats{","-\t\t\t{Tenant: \"user-a\", Shard: 0, Stats: tenantshard.Stats{Resident: 12, Dead: 1, Limit: 32, Length: 8, Rehashes: 2}},","+\t\t\t{Tenant: \"user-a\", Shard: 0, Stats: tenantshard.Stats{Resident: 12, Spilled: 1, Limit: 32, Length: 8, Rehashes: 2}},"," \t\t},"," \t}))"," \tout := buf.String()","@@ -97,7 +97,7 @@ func TestUsageTrackerPartitionTemplates(t *testing.T) {"," \t\tPartition:  7,"," \t\tTenant:     \"user-a\","," \t\tShards: []ShardStats{","-\t\t\t{Tenant: \"user-a\", Shard: 0, Stats: tenantshard.Stats{Resident: 12, Dead: 1, Limit: 32, Length: 8, Rehashes: 2}},","+\t\t\t{Tenant: \"user-a\", Shard: 0, Stats: tenantshard.Stats{Resident: 12, Spilled: 1, Limit: 32, Length: 8, Rehashes: 2}},"," \t\t},"," \t}))"," \tout = buf.String()"],"additions":3,"deletions":3,"truncated":false},{"path":"pkg/usagetracker/partition.gohtml","lines":["@@ -69,22 +69,28 @@","                                 <th class=\"sortable fit-width\" data-col=\"3\" data-type=\"num\" role=\"button\" title=\"Sort by dead\">","                                     <span class=\"text-no