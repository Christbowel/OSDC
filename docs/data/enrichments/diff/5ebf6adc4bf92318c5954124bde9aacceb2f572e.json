{"id":"5ebf6adc4bf92318c5954124bde9aacceb2f572e","axis":"silent","repo":"nodejs/node","sha":"5ebf6adc4bf92318c5954124bde9aacceb2f572e","parsed":{"files":[{"path":"src/crypto/crypto_tls.cc","lines":["@@ -113,6 +113,7 @@ SSL_SESSION* GetSessionCallback(","     int* copy) {","   TLSWrap* w = static_cast<TLSWrap*>(SSL_get_app_data(s));","   *copy = 0;","+  if (w->is_resumption_disabled()) return nullptr;","   return w->ReleaseSession();"," }"," ","@@ -1604,7 +1605,15 @@ bool TLSWrap::PinServerName(std::string_view servername) {"," }"," "," bool TLSWrap::BindSessionsToServerName(std::string_view servername) {","-  if (sc_->session_id_context().empty()) return true;","+  // If we have no session id context and we need to verify peers, we reject","+  // all resumption since we can't do so securely.","+  if (sc_->session_id_context().empty()) {","+    if (SSL_get_verify_mode(ssl_.get()) & SSL_VERIFY_PEER) {","+      SSL_set_options(ssl_.get(), SSL_OP_NO_TICKET);","+      flags_.resumption_disabled = true;","+    }","+    return true;","+  }"," ","   // Server names can't contain NULs, so a NUL keeps the parts apart.","   std::string input = sc_->session_id_context();"],"additions":10,"deletions":1,"truncated":false},{"path":"src/crypto/crypto_tls.h","lines":["@@ -95,6 +95,9 @@ class TLSWrap : public AsyncWrap,","     flags_.awaiting_new_session = on;","   }","   inline void enable_session_callbacks() { flags_.session_callbacks = true; }","+  inline bool is_resumption_disabled() const {","+    return flags_.resumption_disabled;","+  }","   bool BindSessionsToServerName(std::string_view servername);","   bool PinServerName(std::string_view servername);","   inline bool is_server() const { return kind_ == Kind::kServer; }","@@ -339,6 +342,7 @@ class TLSWrap : public AsyncWrap,","   struct Flags {","     bool session_callbacks : 1;","     bool awaiting_new_session : 1;","+    bool resumption_disabled : 1;","     // 'onclienthello' has been emitted for this connection.","     bool hello_emitted : 1;","     // JS has answered it by calling clientHelloDone()."],"additions":4,"deletions":0,"truncated":false},{"path":"test/parallel/test-tls-resume-no-session-id-context.js","lines":["@@ -0,0 +1,80 @@","+'use strict';","+","+// A server with no session id context of its own - possible when creating a","+// TLSSocket directly - can't tell which application a session belongs to. One","+// that verifies client certificates mustn't resume any, or a session from an","+// application sharing its secure context (and so its ticket keys) would skip","+// the client's certificate check. It gets a full handshake instead.","+","+const common = require('../common');","+","+if (!common.hasCrypto)","+  common.skip('missing crypto');","+","+const assert = require('node:assert');","+const net = require('node:net');","+const tls = require('node:tls');","+const fixtures = require('../common/fixtures');","+","+const secureContext = tls.createSecureContext({","+  key: fixtures.readKey('agent2-key.pem'),","+  cert: fixtures.readKey('agent2-cert.pem'),","+});","+","+// Whether the server resumed each connection it accepted, in order.","+const reused = [];","+","+async function listen(requestCert) {","+  const server = net.createServer((socket) => {","+    const tlsSocket = new tls.TLSSocket(socket, {","+      isServer: true,","+      secureContext,","+      requestCert,","+    });","+    tlsSocket.on('secure', () => {","+      reused.push(tlsSocket.isSessionReused());","+      tlsSocket.end();","+    });","+  });","+  await new Promise((resolve) => server.listen(0, resolve));","+  return server;","+}","+","+// Resolves with the first session issued, once the connection closes. This is","+// the raw session from the TLS library: on BoringSSL the 'session' event's","+// TLS 1.3 session can't be resumed.","+function connect(server, options) {","+  return new Promise((resolve) => {","+    let session;","+    const socket = tls.connect({","+      port: server.address().port,","+      rejectUnauthorized: false,","+      ...options,","+    });","+    const { onnewsession } = socket._handle;","+    socket._handle.onnewsession = function(id, raw) {","+      session ??= raw;","+      return onnewsession.call(this, id, raw);","+    };","+    socket.on('session', () => {});","+    socket.on('close', () => resolve(session));","+    socket.resume();","+  });","+}","+","+(async () => {","+  const open = await listen(false);","+  const verifying = await listen(true);","+","+  for (const maxVersion of ['TLSv1.2', 'TLSv1.3']) {","+    reused.length = 0;","+    const session = await connect(open, { maxVersion });","+    assert.ok(session);","+    await connect(open, { maxVersion, session });","+    await connect(verifying, { maxVersion, session });","+    assert.deepStrictEqual(reused, [false, true, false], maxVersion);","+  }","+","+  open.close();","+  verifying.close();","+})().then(common.mustCall());",""],"additions":80,"deletions":0,"truncated":false}],"additions":94,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-12T17:12:33.200725+00:00"}