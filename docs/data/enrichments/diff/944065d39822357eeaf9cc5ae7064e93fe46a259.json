{"id":"944065d39822357eeaf9cc5ae7064e93fe46a259","axis":"silent","repo":"falcosecurity/falco","sha":"944065d39822357eeaf9cc5ae7064e93fe46a259","parsed":{"files":[{"path":".github/workflows/reusable_build_packages.yaml","lines":["@@ -35,9 +35,19 @@ permissions:","   contents: read"," "," jobs:","+  test-package-scripts:","+    runs-on: ubuntu-latest","+    steps:","+      - name: Checkout","+        uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608 # v4.1.0","+","+      - name: Test DEB and RPM package scripts","+        run: python3 scripts/packaging/test_package_scripts.py","+","   build-modern-bpf-skeleton:","     # See https://github.com/actions/runner/issues/409#issuecomment-1158849936","     runs-on: ${{ (inputs.arch == 'aarch64' && 'ubuntu-22.04-arm') || 'ubuntu-latest' }}","+    needs: [test-package-scripts]","     container: fedora:41","     steps:","       # Always install deps before invoking checkout action, to properly perform a full clone."],"additions":10,"deletions":0,"truncated":false},{"path":"cmake/cpack/CMakeCPackOptions.cmake","lines":["@@ -1,6 +1,6 @@"," # SPDX-License-Identifier: Apache-2.0"," #","-# Copyright (C) 2023 The Falco Authors.","+# Copyright (C) 2026 The Falco Authors."," #"," # Licensed under the Apache License, Version 2.0 (the \"License\"); you may not use this file except"," # in compliance with the License. You may obtain a copy of the License at","@@ -49,3 +49,8 @@ endif()"," if(CPACK_GENERATOR MATCHES \"TGZ\")"," \tset(CPACK_SET_DESTDIR \"ON\")"," endif()","+","+# Older CPack versions silently ignore the required post-transaction hook.","+if(CPACK_GENERATOR MATCHES \"RPM\" AND CMAKE_VERSION VERSION_LESS 3.18)","+\tmessage(FATAL_ERROR \"Building RPM packages requires CMake 3.18 or newer for %posttrans\")","+endif()"],"additions":6,"deletions":1,"truncated":false},{"path":"cmake/modules/CPackConfig.cmake","lines":["@@ -1,6 +1,6 @@"," # SPDX-License-Identifier: Apache-2.0"," #","-# Copyright (C) 2023 The Falco Authors.","+# Copyright (C) 2026 The Falco Authors."," #"," # Licensed under the Apache License, Version 2.0 (the \"License\"); you may not use this file except"," # in compliance with the License. You may obtain a copy of the License at","@@ -74,7 +74,7 @@ endif()"," set(CPACK_DEBIAN_PACKAGE_HOMEPAGE \"https://www.falco.org\")"," set(CPACK_DEBIAN_PACKAGE_SUGGESTS \"dkms (>= 2.1.0.0)\")"," set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA","-\t\"${CMAKE_BINARY_DIR}/scripts/debian/postinst;${CMAKE_BINARY_DIR}/scripts/debian/prerm;${CMAKE_BINARY_DIR}/scripts/debian/postrm;${PROJECT_SOURCE_DIR}/cmake/cpack/debian/conffiles\"","+\t\"${CMAKE_BINARY_DIR}/scripts/debian/preinst;${CMAKE_BINARY_DIR}/scripts/debian/postinst;${CMAKE_BINARY_DIR}/scripts/debian/prerm;${CMAKE_BINARY_DIR}/scripts/debian/postrm;${PROJECT_SOURCE_DIR}/cmake/cpack/debian/conffiles\""," )"," "," set(CPACK_RPM_PACKAGE_LICENSE \"Apache v2.0\")","@@ -82,6 +82,8 @@ set(CPACK_RPM_PACKAGE_ARCHITECTURE, \"amd64\")"," set(CPACK_RPM_PACKAGE_URL \"https://www.falco.org\")"," set(CPACK_RPM_PACKAGE_REQUIRES \"systemd\")"," set(CPACK_RPM_PACKAGE_SUGGESTS \"dkms, kernel-devel\")","+set(CPACK_RPM_PRE_INSTALL_SCRIPT_FILE \"${CMAKE_BINARY_DIR}/scripts/rpm/preinstall\")","+set(CPACK_RPM_POST_TRANS_SCRIPT_FILE \"${CMAKE_BINARY_DIR}/scripts/rpm/posttrans\")"," set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE \"${CMAKE_BINARY_DIR}/scripts/rpm/postinstall\")"," set(CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE \"${CMAKE_BINARY_DIR}/scripts/rpm/preuninstall\")"," set(CPACK_RPM_POST_UNINSTALL_SCRIPT_FILE \"${CMAKE_BINARY_DIR}/scripts/rpm/postuninstall\")"],"additions":4,"deletions":2,"truncated":false},{"path":"scripts/CMakeLists.txt","lines":["@@ -1,6 +1,6 @@"," # SPDX-License-Identifier: Apache-2.0"," #","-# Copyright (C) 2023 The Falco Authors.","+# Copyright (C) 2026 The Falco Authors."," #"," # Licensed under the Apache License, Version 2.0 (the \"License\"); you may not use this file except"," # in compliance with the License. You may obtain a copy of the License at","@@ -37,15 +37,16 @@ if(CMAKE_SYSTEM_NAME MATCHES \"Linux\")"," \t\t\"${PROJECT_BINARY_DIR}/scripts/systemd\" COPYONLY"," \t)"," ","-\t# Debian","-\tconfigure_file(debian/postinst.in debian/postinst COPYONLY)","-\tconfigure_file(debian/postrm.in debian/postrm COPYONLY)","-\tconfigure_file(debian/prerm.in debian/prerm COPYONLY)","+\t# Expand shared package helpers before embedding them in each scriptlet.","+\tconfigure_file(packaging/functions.sh.in packaging/functions.sh @ONLY)","+\tfile(READ \"${CMAKE_CURRENT_BINARY_DIR}/packaging/functions.sh\" FALCO_PACKAGE_FUNCTIONS)"," ","-\t# Rpm","-\tconfigure_file(rpm/postinstall.in rpm/postinstall COPYONLY)","-\tconfigure_file(rpm/postuninstall.in rpm/postuninstall COPYONLY)","-\tconfigure_file(rpm/preuninstall.in rpm/preuninstall COPYONLY)","+\tforeach(script preinst postinst prerm postrm)","+\t\tconfigure_file(debian/${script}.in debian/${script} @ONLY)","+\tendforeach()","+\tforeach(script preinstall postinstall posttrans preuninstall postuninstall)","+\t\tconfigure_file(rpm/${script}.in rpm/${script} @ONLY)","+\tendforeach()"," endif()"," "," # Install Falcoctl config file"],"additions":10,"deletions":9,"truncated":false},{"path":"scripts/debian/postinst.in","lines":["@@ -1,7 +1,7 @@"," #!/bin/sh"," # SPDX-License-Identifier: Apache-2.0"," #","-# Copyright (C) 2023 The Falco Authors.","+# Copyright (C) 2026 The Falco Authors."," #"," #"," # Licensed under the Apache License, Version 2.0 (the \"License\");","@@ -17,6 +17,10 @@"," # limitations under the License."," #"," ","+set -e","+","+@FALCO_PACKAGE_FUNCTIONS@","+"," # By default, we use the automatic selection for drivers"," chosen_driver=\"auto\""," chosen_unit=","@@ -33,8 +37,8 @@ systemctl --system disable 'falco-modern-bpf.service' || true"," systemctl --system disable 'falco-custom.service' || true"," systemctl --system disable 'falcoctl-artifact-follow.service' || true"," ","-# unmask falcoctl if it was masked","-systemctl --system unmask falcoctl-artifact-follow.service || true","+# Only undo masks created by this package.","+package_unmask_follower || true"," "," if [ \"$1\" = \"configure\" ]; then"," \t# \"auto\" case is not managed here since it is already the default, so no CHOICE=2","@@ -56,7 +60,7 @@ if [ \"$1\" = \"configure\" ]; then","                     2 \"Automatic selection\" \\","                     3 \"Kmod\" \\","                     4 \"Modern eBPF\" \\","-                    2>&1 >/dev/tty)","+                    2>&1 >/dev/tty) || CHOICE=","         fi","         # \"auto\" case is not managed here since it is already the default, so no CHOICE=2","         case $CHOICE in","@@ -71,14 +75,15 @@ if [ \"$1\" = \"configure\" ]; then","                 ;;","         esac","         if [ -n \"$chosen_driver\" ]; then","+            package_driver_version","             echo \"[POST-INSTALL] Configure falcoctl '$chosen_driver' driver type:\"","             if [ \"$chosen_driver\" = \"auto\" ];  then","                 # Configure falcoctl to enable all drivers","-                falcoctl driver config --type \"modern_ebpf\" --type \"kmod\"","+                falcoctl driver config --version \"$driver_version\" --type \"modern_ebpf\" --type \"kmod\"","                 # Load the actually automatic chosen driver","                 chosen_driver=$(falcoctl driver printenv | grep DRIVER= | cut -d'\"' -f2)","             else","-                falcoctl driver config --type \"$chosen_driver\"","+                falcoctl driver config --version \"$driver_version\" --type \"$chosen_driver\"","             fi","             CHOICE=","             case $FALCOCTL_ENABLED in","@@ -90,16 +95,16 @@ if [ \"$1\" = \"configure\" ]; then","                 CHOICE=$(dialog --clear --title \"Falcoctl\" --menu \"Do you want to follow automatic ruleset updates?\" 10 40 2 \\","                         1 \"Yes\" \\","                         2 \"No\" \\","-                        2>&1 >/dev/tty)","+                        2>&1 >/dev/tty) || CHOICE=","             fi  ","             case $CHOICE in","                 2)","                     # we don't want falcoctl enabled, we mask it","-                    systemctl --system mask falcoctl-artifact-follow.service || true","+                    package_mask_follower","                 ;;","             esac","         fi    ","-        clear","+        clear || true"," fi"," "," set -e","@@ -112,7 +117,7 @@ case \"$chosen_driver\" in","     \"kmod\")","       # Only compile for kmod, in this way we use dkms","       echo \"[POST-INSTALL] Call 'falcoctl driver install for kmod:\"","-      falcoctl driver install --download=false","+      package_install_kmod","       chosen_unit=\"kmod\"","       ;;","     \"modern_ebpf\")","@@ -129,3 +134,5 @@ if [ \"$1\" = \"configure\" ] || [ \"$1\" = \"abort-upgrade\" ] || [ \"$1\" = \"abort-decon","             systemctl --system start \"falco-$chosen_unit.service\" || true","         fi"," fi","+","+package_clear_transaction"],"additions":17,"deletions":10,"truncated":false},{"path":"scripts/debian/postrm.in","lines":["@@ -1,7 +1,7 @@"," #!/bin/sh"," # SPDX-License-Identifier: Apache-2.0"," #","-# Copyright (C) 2023 The Falco Authors.","+# Copyright (C) 2026 The Falco Authors."," #"," #"," # Licensed under the Apache License, Version 2.0 (the \"License\");","@@ -16,19 +16,13 @@"," # See the License for the specific language governing permissions and"," # limitations under the License."," #","-","-# Based off what debhelper dh_systemd_enable/13.3.4 would have added","-# ref: https://www.debian.org/doc/manuals/debmake-doc/ch05.en.html#debhelper","-"," set -e"," ","-if [ -d /run/systemd/system ] && [ \"$1\" = remove ]; then","-        echo \"[POST-REMOVE] Disable all Falco services:\"","-        systemctl --system disable 'falco-kmod.service' || true","-        systemctl --system disable 'falco-modern-bpf.service' || true","-        systemctl --system disable 'falco-custom.service' || true","-        systemctl --system disable 'falcoctl-artifact-follow.service' || true","+@FALCO_PACKAGE_FUNCTIONS@"," ","-        echo \"[POST-REMOVE] Trigger deamon-reload:\"","+case \"$1\" in","+    remove|purge)","+        package_remove_state","         systemctl --system daemon-reload || true","-fi","+        ;;","+esac"],"additions":7,"deletions":13,"truncated":false},{"path":"scripts/debian/preinst.in","lines":["@@ -0,0 +1,27 @@","+#!/bin/sh","+# SPDX-License-Identifier: Apache-2.0","+#","+# Copyright (C) 2026 The Falco Authors.","+#","+#","+# Licensed under the Apache License, Version 2.0 (the \"License\");","+# you may not use this file except in compliance with the License.","+# You may obtain a copy of the License at","+#","+#     http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing, software","+# distributed under the License is distributed on an \"AS IS\" BASIS,","+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+# See the License for the specific language governing permissions and","+# limitations under the License.","+#","+set -e","+","+@FALCO_PACKAGE_FUNCTIONS@","+","+case \"$1\" in","+    install|upgrade)","+        package_save_previous_driver","+        ;;","+esac"],"additions":27,"deletions":0,"truncated":false},{"path":"scripts/debian/prerm.in","lines":["@@ -1,7 +1,7 @@"," #!/bin/sh"," # SPDX-License-Identifier: Apache-2.0"," #","-# Copyright (C) 2023 The Falco Authors.","+# Copyright (C) 2026 The Falco Authors."," #"," #"," # Licensed under the Apache License, Version 2.0 (the \"License\");","@@ -34,3 +34,8 @@ case \"$1\" in","       falcoctl driver cleanup","     ;;"," esac","+","+# Disable while the unit definitions (including Alias=falco.service) exist.","+if [ \"$1\" = remove ]; then","+    systemctl --system disable falco-kmod.service falco-modern-bpf.service falco-custom.service falcoctl-artifact-follow.service || true","+fi"],"additions":6,"deletions":1,"truncated":false},{"path":"scripts/packaging/README.md","lines":["@@ -0,0 +1,28 @@","+# Package lifecycle tests","+","+Run the [script tests](test_package_scripts.py) with `python3 scripts/packaging/test_package_scripts.py`.","+They execute the maintainer scripts with isolated files and command shims. Real","+DEB/RPM transactions are also needed to validate package-manager ordering,","+systemd aliases, DKMS, and startup after reboot.","+","+The [shared helpers](functions.sh.in) are embedded at CMake configure time, so","+removal scripts remain usable after the package files have been deleted.","+RPM installation and startup run in `posttrans`, after outgoing packages have","+finished their cleanup. Generating RPMs requires CMake 3.18 or newer.","+","+On upgrade, a driver version matching the outgoing binary's default follows","+the incoming package's default. Other pins are retained. A deliberate pin equal","+to the outgoing default is indistinguishable from the package-generated value:","+set `FALCOCTL_DRIVER_VERSION` explicitly during the transaction to retain it.","+`FALCO_DRIVER_CHOICE=none` skips driver configuration and installation. Custom","+pins still need compatible drivers and sources when selecting `kmod`.","+","+The kmod package path verifies that `modprobe` can find the selected version.","+With older bundled falcoctl releases, it repairs a missing installation through","+DKMS. A failed repair stops the script before service startup and retains its","+transaction state. This fallback uses the system's default DKMS compiler selection.","+","+Only follower masks recorded as package-created are removed. Administrator","+masks and older masks without ownership records are retained. Debian disables","+units before removing their definitions and repairs known dangling Falco aliases","+on removal or purge."],"additions":28,"deletions":0,"truncated":false},{"path":"scripts/packaging/functions.sh.in","lines":["@@ -0,0 +1,110 @@","+# SPDX-License-Identifier: Apache-2.0","+#","+# Copyright (C) 2026 The Falco Authors.","+#","+#","+# Licensed under the Apache License, Version 2.0 (the \"License\");","+# you may not use this file except in compliance with the License.","+# You may obtain a copy of the License at","+#","+#     http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing, software","+# distributed under the License is distributed on an \"AS IS\" BASIS,","+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+# See the License for the specific language governing permissions and","+# limitations under the License.","+#","+# Shared at configure time: removal hooks must work after the payload is gone.","+package_state=/var/lib/falco/package","+follower_mask=/etc/systemd/system/falcoctl-artifact-follow.service","+","+package_save_previous_driver() {","+    mkdir -p \"$package_state\"","+    rm -f \"$package_state/previous-default\" \"$package_state/previous-version\" \"$package_state/pending-driver\"","+    # Configuration may enable JSON output, or refer to unavailable plugins.","+    previous_default=$(falco -c /dev/null -o json_output=false --version 2>/dev/null | sed -n 's/^[[:space:]]*Default driver:[[:space:]]*//p')","+    printf '%s\\n' \"$previous_default\" > \"$package_state/previous-default\"","+    # printenv creates a missing config, so do not call it on a fresh install.","+    if [ -f /etc/falcoctl/falcoctl.yaml ]; then","+        previous_env=$(falcoctl driver printenv 2>/dev/null) || previous_env=","+        printf '%s\\n' \"$previous_env\" | sed -n 's/^DRIVER_VERSION=\"\\([^\"]*\\)\"$/\\1/p' > \"$package_state/previous-version\"","+    fi","+}","+","+package_driver_version() {","+    driver_env=$(falcoctl driver printenv)","+    driver_version=$(printf '%s\\n' \"$driver_env\" | sed -n 's/^DRIVER_VERSION=\"\\([^\"]*\\)\"$/\\1/p')","+    # RPM replaces the old configuration before %post; retain its driver pin.","+    if [ \"${package_format:-}\" = rpm ] && [ -s \"$package_state/previous-version\" ]; then","+        driver_version=$(cat \"$package_state/previous-version\")","+    fi","+    previous_default=","+    if [ -f \"$package_state/previous-default\" ]; then","+        previous_default=$(cat \"$package_state/previous-default\")","+    fi","+    if [ -n \"${FALCOCTL_DRIVER_VERSION:-}\" ]; then","+        driver_version=$FALCOCTL_DRIVER_VERSION","+    elif [ -z \"$driver_version\" ] || { [ -n \"$previous_default\" ] && [ \"$driver_version\" = \"$previous_default\" ]; }; then","+        echo \"[POST-INSTALL] Update package driver version to @DRIVER_VERSION@:\"","+        driver_version='@DRIVER_VERSION@'","+    fi","+}","+","+package_install_kmod() {","+    # The package unit uses modprobe, so an artifact in ~/.falco is insufficient.","+    echo \"[POST-INSTALL] Install kmod '$driver_version' for $(uname -r):\"","+    falcoctl driver install --version \"$driver_version\" --download=false","+    # Older falcoctl releases can return success from the artifact cache after","+    # removing DKMS. Repair that case until the bundled falcoctl is updated.","+    if [ \"$(modinfo -k \"$(uname -r)\" -F version falco 2>/dev/null)\" != \"$driver_version\" ]; then","+        dkms install -m falco -v \"$driver_version\" -k \"$(uname -r)\"","+    fi","+    if [ \"$(modinfo -k \"$(uname -r)\" -F version falco 2>/dev/null)\" != \"$driver_version\" ]; then","+        echo \"[POST-INSTALL] The installed falco module does not match '$driver_version'.\" >&2","+        return 1","+    fi","+}","+","+package_unmask_follower() {","+    if [ -f \"$package_state/follower-mask\" ]; then","+        if [ \"$(readlink \"$follower_mask\")\" = /dev/null ]; then","+            systemctl --system unmask falcoctl-artifact-follow.service || return 1","+        fi","+        rm -f \"$package_state/follower-mask\"","+    fi","+}","+","+package_mask_follower() {","+    # An existing administrator mask has no package ownership marker.","+    if [ \"$(readlink \"$follower_mask\")\" != /dev/null ]; then","+        if systemctl --system mask falcoctl-artifact-follow.service; then","+            if [ \"$(readlink \"$follower_mask\")\" = /dev/null ]; then","+                mkdir -p \"$package_state\"","+                touch \"$package_state/follower-mask\"","+            fi","+        fi","+    fi","+}","+","+package_clear_transaction() {","+    rm -f \"$package_state/previous-default\" \"$package_state/previous-version\" \"$package_state/pending-driver\"","+    rmdir \"$package_state\" 2>/dev/null || true","+    rmdir /var/lib/falco 2>/dev/null || true","+}","+","+package_remove_state() {","+    package_unmask_follower || true","+    # Repair aliases left by older Debian postrm scripts. Do not remove custom","+    # aliases, administrator masks, or links to units that still exist.","+    if [ -L /etc/systemd/system/falco.service ] && [ ! -e /etc/systemd/system/falco.service ]; then","+        case \"$(readlink /etc/systemd/system/falco.service)\" in","+            /lib/systemd/system/falco-kmod.service|/usr/lib/systemd/system/falco-kmod.service|\\","+            /lib/systemd/system/falco-modern-bpf.service|/usr/lib/systemd/system/falco-modern-bpf.service|\\","+            /lib/systemd/system/falco-custom.service|/usr/lib/systemd/system/falco-custom.service)","+                rm -f /etc/systemd/system/falco.service","+                ;;","+        esac","+    fi","+    package_clear_transaction","+}"],"additions":110,"deletions":0,"truncated":false},{"path":"scripts/packaging/test_package_scripts.py","lines":["@@ -0,0 +1,441 @@","+#!/usr/bin/env python3","+# SPDX-License-Identifier: Apache-2.0","+# Copyright (C) 2026 The Falco Authors.","+\"\"\"Execute package script templates without root, systemd, DKMS, or a network.","+","+Only configure-time substitutions, filesystem prefixes, and RPM systemd macros","+are replaced. Stateful command shims model external programs; the package's shell","+control flow and file operations run unchanged. Real RPM macro expansion and","+kernel-module loading also need package integration tests.","+\"\"\"","+","+import json","+import os","+from pathlib import Path","+import re","+import subprocess","+import sys","+import tempfile","+import unittest","+","+","+SCRIPTS = Path(__file__).resolve().parents[1]","+OLD = \"10.2.0+driver\"","+NEW = \"11.0.0-rc1+driver\"","+PIN = \"11.0.1+driver\"","+KERNEL = \"6.8.0-test\"","+","+# Each shim persists observable external state across separate scriptlets.","+SHIM = r'''","+import json","+import os","+from pathlib import Path","+import sys","+","+root = Path(os.environ[\"PACKAGE_TEST_ROOT\"])","+state_file = root / \"state.json\"","+state = json.loads(state_file.read_text())","+command = Path(sys.argv[0]).name","+args = sys.argv[1:]","+state[\"calls\"].append([command, *args])","+code = 0","+","+def option(name):","+    return args[args.index(name) + 1]","+","+def unlink(path):","+    if path.is_symlink() or path.exists():","+        path.unlink()","+","+def systemctl(action, units):","+    global code","+    alias = root / \"etc/systemd/system/falco.service\"","+    mask = root / \"etc/systemd/system/falcoctl-artifact-follow.service\"","+    if action == \"mask\":","+        if not mask.is_symlink():","+            mask.symlink_to(\"/dev/null\")","+    elif action == \"unmask\":","+        unlink(mask)","+    for unit in units:","+        if action == \"stop\":","+            state[\"active\"][unit] = False","+        elif action == \"disable\":","+            # Removing the unit first prevents resolving its Alias= metadata.","+            if (root / \"usr/lib/systemd/system\" / unit).exists():","+                state[\"enabled\"][unit] = False","+                if alias.is_symlink() and alias.readlink().name == unit:","+                    unlink(alias)","+        elif action == \"enable\":","+            state[\"enabled\"][unit] = True","+            unlink(alias)","+            alias.symlink_to(root / \"usr/lib/systemd/system\" / unit)","+        elif action == \"start\":","+            ready = unit != \"falco-kmod.service\" or bool(state[\"module\"])","+            state[\"active\"][unit] = ready","+            code = 0 if ready else 1","+","+if command == \"falco\":","+    if state[\"json_config\"] and (\"-c\" not in args or option(\"-c\") != \"/dev/null\"","+                                 or \"-o\" not in args or option(\"-o\") != \"json_output=false\"):","+        print(\"Configured Falco requires a configuration-independent version probe\", file=sys.stderr)","+        code = 1","+    else:","+        print(\"Default driver: \" + state[\"default\"])","+elif command == \"falcoctl\":","+    config_file = root / \"etc/falcoctl/falcoctl.yaml\"","+    config = json.loads(config_file.read_text()) if config_file.exists() else {}","+    if args[:2] == [\"driver\", \"printenv\"]:","+        if not config_file.exists():","+            config_file.write_text(json.dumps(config))","+        version = os.environ.get(\"FALCOCTL_DRIVER_VERSION\", config.get(\"version\", \"\"))","+        print('DRIVER_VERSION=\"' + version + '\"')","+        print('DRIVER=\"' + config.get(\"type\", \"kmod\") + '\"')","+    elif args[:2] == [\"driver\", \"config\"]:","+        config[\"version\"] = option(\"--version\")","+        types = [args[i + 1] for i, arg in enumerate(args) if arg == \"--type\"]","+        config[\"type\"] = state[\"automatic_type\"] if len(types) > 1 else types[0]","+        config_file.write_text(json.dumps(config))","+    elif args[:2] == [\"driver\", \"install\"]:","+        state[\"installs\"] += 1","+        # The old cache path reports success after removing its DKMS module.","+        state[\"module\"] = \"\" if state[\"cache_hit\"] else option(\"--version\")","+    elif args[:2] == [\"driver\", \"cleanup\"]:","+        state[\"cleanups\"] += 1","+        state[\"module\"] = \"\"","+    else:","+        raise RuntimeError(args)","+elif command == \"dkms\":","+    state[\"dkms_installs\"] += 1","+    code = 7 if state[\"dkms_failure\"] else 0","+    if code == 0:","+        state[\"module\"] = \"wrong-version\" if state[\"dkms_wrong_version\"] else option(\"-v\")","+elif command == \"modinfo\":","+    print(state[\"module\"])","+    code = 0 if state[\"module\"] else 1","+elif command == \"uname\":","+    print(\"6.8.0-test\")","+elif command == \"systemctl\":","+    args = [arg for arg in args if arg != \"--system\"]","+    systemctl(args[0], args[1:])","+elif command == \"rpm-systemd-preun\":","+    # Model the final-removal guard in %systemd_preun, not an RPM installation.","+    if args[0] == \"0\":","+        systemctl(\"disable\", args[1:])","+elif command == \"rpm-systemd-post\":","+    pass  # Presetting is separate from the scripts' explicit enable/start.","+elif command != \"clear\":","+    raise RuntimeError(command)","+state_file.write_text(json.dumps(state))","+sys.exit(code)","+'''","+","+","+class PackageHost:","+    def __init__(self, case, package_format, version=OLD):","+        self.case = case","+        self.format = package_format","+        temporary = tempfile.TemporaryDirectory(prefix=\"falco-package-test-\")","+        case.addCleanup(temporary.cleanup)","+        self.root = Path(temporary.name)","+        self.state_file = self.root / \"state.json\"","+        self.config_file = self.root / \"etc/falcoctl/falcoctl.yaml\"","+        self.package_state = self.root / \"var/lib/falco/package\"","+        self.mask = self.root / \"etc/systemd/system/falcoctl-artifact-follow.service\"","+        self.alias = self.root / \"etc/systemd/system/falco.service\"","+        for directory in (\"bin\", \"etc/falcoctl\", \"etc/systemd/system\", \"usr/lib/systemd/system\"):","+            (self.root / directory).mkdir(parents=True)","+        for unit in (\"kmod\", \"modern-bpf\", \"custom\"):","+            (self.root / f\"usr/lib/systemd/system/falco-{unit}.service\").touch()","+        (self.root / \"usr/lib/systemd/system/falcoctl-artifact-follow.service\").touch()","+        self.set_config(version)","+        self.write_state({","+            \"default\": OLD, \"module\": OLD, \"cache_hit\": True, \"json_config\": False,","+            \"automatic_type\": \"kmod\", \"dkms_failure\": False,","+            \"dkms_wrong_version\": False, \"installs\": 0, \"cleanups\": 0,","+            \"dkms_installs\": 0, \"calls\": [], \"enabled\": {},","+            \"active\": {\"falco-kmod.service\": True},","+        })","+        for command in (\"falco\", \"falcoctl\", \"dkms\", \"modinfo\", \"uname\", \"systemctl\",","+                        \"clear\", \"rpm-systemd-preun\", \"rpm-systemd-post\"):","+            path = self.root / \"bin\" / command","+            path.write_text(f\"#!{sys.executable}\\n\" + SHIM)","+            path.chmod(0o755)","+        self.env = {key: value for key, value in os.environ.items()","+                    if not key.startswith(\"FALCO\")}","+        self.env.update({","+            \"PATH\": str(self.root / \"bin\") + os.pathsep + os.defpath,","+            \"PACKAGE_TEST_ROOT\": str(self.root),","+            \"FALCO_FRONTEND\": \"noninteractive\", \"FALCO_DRIVER_CHOICE\": \"kmod\",","+            \"FALCOCTL_ENABLED\": \"yes\",","+        })","+","+    def state(self):","+        return json.loads(self.state_file.read_text())","+","+    def write_state(self, value):","+        self.state_file.write_text(json.dumps(value))","+","+    def update(self, **values):","+        self.write_state(dict(self.state(), **values))","+","+    def set_config(self, version):","+        self.config_file.write_text(json.dumps({","+            \"version\": version, \"type\": \"kmod\", \"artifact_customization\": \"preserve me\",","+        }))","+","+    def config(self):","+        return json.loads(self.config_file.read_text())","+","+    def run(self, script, *args, success=True):","+        functions = (SCRIPTS / \"packaging/functions.sh.in\").read_text()","+        functions = functions.replace(\"@DRIVER_VERSION@\", NEW)","+        content = (SCRIPTS / self.format / f\"{script}.in\").read_text()","+        content = content.replace(\"@FALCO_PACKAGE_FUNCTIONS@\", functions)","+        content = content.replace(\"@DRIVER_VERSION@\", NEW)","+        # One substitution pass avoids rewriting prefixes introduced by itself.","+        content = re.sub(","+            r\"/(?:usr/lib/systemd/system|lib/systemd/system|etc/systemd/system|etc/falcoctl|var/lib/falco)\",","+            lambda match: str(self.root) + match[0], content,","+        )","+        content = re.sub(r\"^%systemd_preun\\b\", 'rpm-systemd-preun \"$1\"', content, flags=re.M)","+        content = re.sub(r\"^\\s*%systemd_post\\b\", '\\nrpm-systemd-post \"$1\"', content, flags=re.M)","+        self.case.assertNotRegex(content, r\"@[A-Z_]+@\", \"unrendered CMake variable\")","+        path = self.root / script","+        path.write_text(content)","+        result = subprocess.run([\"/bin/sh\", str(path), *args], env=self.env,","+                                text=True, capture_output=True)","+        if success:","+            self.case.assertEqual(result.returncode, 0, result.stdout + result.stderr)","+        else:","+            self.case.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)","+        return result","+","+    def preinstall(self):","+        if self.format == \"debian\":","+            self.run(\"preinst\", \"upgrade\", \"0.44.1\")","+        else:","+            self.run(\"preinstall\", \"2\")","+","+    def postinstall(self, **kwargs):","+        script, argument = (\"postinst\", \"configure\") if self.format == \"debian\" else (\"postinstall\", \"2\")","+        return self.run(script, argument, **kwargs)","+","+    def finish(self, **kwargs):","+        if self.format == \"rpm\":","+            return self.run(\"posttrans\", \"2\", **kwargs)","+","+    def assert_running(self, version):","+        self.case.assertEqual(self.config()[\"version\"], version)","+        self.case.assertEqual(self.config()[\"artifact_customization\"], \"preserve me\")","+        self.case.assertEqual(self.state()[\"module\"], version)","+        self.case.assertTrue(self.state()[\"active\"][\"falco-kmod.service\"])","+        self.case.assertTrue(self.state()[\"enabled\"][\"falco-kmod.service\"])","+        self.case.assertEqual(list(self.package_state.glob(\"previous-*\")), [])","+        self.case.assertFalse((self.package_state / \"pending-driver\").exists())","+","+","+class PackageScriptTests(unittest.TestCase):","+    def test_upgrade_migrates_outgoing_default(self):","+        for package_format in (\"debian\", \"rpm\"):","+            with self.subTest(package_format=package_format):","+                host = PackageHost(self, package_format)","+                host.preinstall()","+                if package_format == \"rpm\":","+                    host.set_config(NEW)  # RPM has replaced the payload at %post.","+                host.postinstall()","+                host.finish()","+                host.assert_running(NEW)","+","+    def test_preserves_custom_pin_including_replaced_rpm_config(self):","+        for package_format in (\"debian\", \"rpm\"):","+            with self.subTest(package_format=package_format):","+                host = PackageHost(self, package_format, version=PIN)","+                host.preinstall()","+                if package_format == \"rpm\":","+                    host.set_config(NEW)","+                host.postinstall()","+                host.finish()","+                host.assert_running(PIN)","+","+    def test_explicit_environment_pin_overrides_default_migration(self):","+        for package_format in (\"debian\", \"rpm\"):","+            with self.subTest(package_format=package_format):","+                host = PackageHost(self, package_format)","+                host.preinstall()","+                host.env[\"FALCOCTL_DRIVER_VERSI