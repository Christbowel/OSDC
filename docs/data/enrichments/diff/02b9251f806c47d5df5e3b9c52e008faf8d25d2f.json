tatus)","+\tassert.Empty(t, user)","+","+\tstatus, user = send(alice, \"\")","+\tassert.Equal(t, http.StatusOK, status)","+\tassert.Equal(t, \"alice\", user)","+}"],"additions":87,"deletions":0,"truncated":false},{"path":"pkg/proxy/fast/connpool.go","lines":["@@ -517,7 +517,7 @@ type connPoolsKeyType string"," var connPoolsKey connPoolsKeyType = \"connPools\""," "," // AddConnPoolsOnContext adds an empty holder in the frontend connection context to store the dedicated connection","-// pools isolating connection-bound NTLM/Negotiate authentications, mirroring service.AddTransportOnContext for the","+// pools isolating connection-bound NTLM/Negotiate authentications, mirroring kerberos.AddTransportOnContext for the"," // FastProxy connection pools."," func AddConnPoolsOnContext(ctx context.Context) context.Context {"," \treturn context.WithValue(ctx, connPoolsKey, &stickyConnPools{})"],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/server/server_entrypoint_tcp.go","lines":["@@ -33,7 +33,7 @@ import ("," \t\"github.com/traefik/traefik/v3/pkg/proxy/fast\""," \t\"github.com/traefik/traefik/v3/pkg/safe\""," \ttcprouter \"github.com/traefik/traefik/v3/pkg/server/router/tcp\"","-\t\"github.com/traefik/traefik/v3/pkg/server/service\"","+\t\"github.com/traefik/traefik/v3/pkg/server/service/kerberos\""," \t\"github.com/traefik/traefik/v3/pkg/tcp\""," \t\"github.com/traefik/traefik/v3/pkg/types\""," )","@@ -733,7 +733,7 @@ func newHTTPServer(ctx context.Context, ln net.Listener, configuration *static.E"," \tvar connContext multipleConnContext"," \tconnContext.AddConnContextFunc(func(ctx context.Context, c net.Conn) context.Context {"," \t\t// This adds an empty struct in order to store a RoundTripper in the ConnContext in case of Kerberos or NTLM.","-\t\tctx = service.AddTransportOnContext(ctx)","+\t\tctx = kerberos.AddTransportOnContext(ctx)"," \t\t// Same as above for the FastProxy connection pools, storing a dedicated pool in case of Kerberos or NTLM."," \t\tctx = fast.AddConnPoolsOnContext(ctx)"," "],"additions":2,"deletions":2,"truncated":false},{"path":"pkg/server/server_entrypoint_tcp_http3.go","lines":["@@ -17,7 +17,7 @@ import ("," \ttcpmuxer \"github.com/traefik/traefik/v3/pkg/muxer/tcp\""," \t\"github.com/traefik/traefik/v3/pkg/proxy/fast\""," \ttcprouter \"github.com/traefik/traefik/v3/pkg/server/router/tcp\"","-\t\"github.com/traefik/traefik/v3/pkg/server/service\"","+\t\"github.com/traefik/traefik/v3/pkg/server/service/kerberos\""," \t\"github.com/traefik/traefik/v3/pkg/tcp\""," )"," ","@@ -82,7 +82,7 @@ func newHTTP3Server(ctx context.Context, name string, config *static.EntryPoint,"," \t\t},"," \t\tConnContext: func(ctx context.Context, c *quic.Conn) context.Context {"," \t\t\t// This adds an empty struct in order to store a RoundTripper in the ConnContext in case of Kerberos or NTLM.","-\t\t\tctx = service.AddTransportOnContext(ctx)","+\t\t\tctx = kerberos.AddTransportOnContext(ctx)"," \t\t\t// Same as above for the FastProxy connection pools, storing a dedicated pool in case of Kerberos or NTLM."," \t\t\tctx = fast.AddConnPoolsOnContext(ctx)"," "],"additions":2,"deletions":2,"truncated":false},{"path":"pkg/server/service/kerberos/roundtripper.go","lines":["@@ -0,0 +1,107 @@","+package kerberos","+","+import (","+\t\"context\"","+\t\"net/http\"","+\t\"slices\"","+\t\"strings\"","+\t\"sync\"","+)","+","+// stickyRoundTrippers is keyed by owner, as there is one roundTripper per ServersTransport and a dedicated","+// round tripper carries the whole transport configuration (TLS client configuration, timeouts, connection pool) of","+// the ServersTransport that created it, hence cannot be shared with another one.","+// The map is lazily allocated, as most client connections never reach a Kerberos or NTLM backend.","+type stickyRoundTrippers struct {","+\tmu            sync.Mutex","+\troundTrippers map[*roundTripper]http.RoundTripper","+}","+","+func (s *stickyRoundTrippers) get(owner *roundTripper) http.RoundTripper {","+\ts.mu.Lock()","+\tdefer s.mu.Unlock()","+","+\treturn s.roundTrippers[owner]","+}","+","+// stick returns the dedicated round tripper for the given owner, creating and storing it on the first call","+// and returning the existing one afterwards. It keeps the round tripper already stored, as concurrent requests","+// on the same client connection (HTTP/2 streams) can race on the same owner, and replacing an in-use round","+// tripper would orphan the backend connections it holds.","+func (s *stickyRoundTrippers) stick(owner *roundTripper) http.RoundTripper {","+\ts.mu.Lock()","+\tdefer s.mu.Unlock()","+","+\tif rt, ok := s.roundTrippers[owner]; ok {","+\t\treturn rt","+\t}","+","+\trt := owner.new()","+","+\tif s.roundTrippers == nil {","+\t\ts.roundTrippers = make(map[*roundTripper]http.RoundTripper)","+\t}","+\ts.roundTrippers[owner] = rt","+","+\treturn rt","+}","+","+type transportKeyType string","+","+var transportKey transportKeyType = \"transport\"","+","+// AddTransportOnContext returns a context holding the round trippers dedicated to a client connection.","+func AddTransportOnContext(ctx context.Context) context.Context {","+\treturn context.WithValue(ctx, transportKey, &stickyRoundTrippers{})","+}","+","+type roundTripper struct {","+\tnew      func() http.RoundTripper","+\toriginal http.RoundTripper","+}","+","+// NewRoundTripper creates a round tripper sharing original between client connections,","+// and calling newRoundTripper to create the round tripper dedicated to a client connection.","+func NewRoundTripper(original http.RoundTripper, newRoundTripper func() http.RoundTripper) http.RoundTripper {","+\treturn &roundTripper{","+\t\tnew:      newRoundTripper,","+\t\toriginal: original,","+\t}","+}","+","+func (k *roundTripper) RoundTrip(request *http.Request) (*http.Response, error) {","+\tconnRoundTrippers, ok := request.Context().Value(transportKey).(*stickyRoundTrippers)","+\tif !ok {","+\t\t// This should never happen, as the context is set in the entrypoint handler,","+\t\t// but we fall back to the original round tripper to avoid panics.","+\t\treturn k.original.RoundTrip(request)","+\t}","+","+\t// Once a dedicated round tripper has been stuck for this owner, every subsequent request on the same","+\t// client connection reuses it, whether it is a concurrent request (HTTP/2 streams) or a later","+\t// credential-less request relying on the connection-bound NTLM/Kerberos authentication.","+\tif rt := connRoundTrippers.get(k); rt != nil {","+\t\treturn rt.RoundTrip(request)","+\t}","+","+\t// NTLM and Kerberos (Negotiate) are connection-bound authentication schemes: the request carrying","+\t// the credential authenticates the backend connection it is dispatched on, and the backend","+\t// keeps that connection bound to the authenticated identity for reuse.","+\t// Such a request must never be dispatched through the shared original round tripper, otherwise the","+\t// now authenticated connection would stay in the globally shared pool where an unrelated frontend","+\t// connection could later be handed the same socket and inherit the identity.","+\tif containsNTLMorNegotiate(request.Header.Values(\"Authorization\")) {","+\t\treturn connRoundTrippers.stick(k).RoundTrip(request)","+\t}","+","+\treturn k.original.RoundTrip(request)","+}","+","+func containsNTLMorNegotiate(h []string) bool {","+\treturn slices.ContainsFunc(h, func(s string) bool {","+\t\t// RFC 9110 section 11.1 defines the auth-scheme as case-insensitive,","+\t\t// hence a credential or challenge is matched on its scheme token whatever its case.","+\t\tscheme, _, _ := strings.Cut(s, \" \")","+\t\treturn strings.EqualFold(scheme, \"NTLM\") || strings.EqualFold(scheme, \"Negotiate\")","+\t})","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"pkg/server/service/kerberos/roundtripper_test.go","lines":["@@ -0,0 +1,163 @@","+package kerberos","+","+import (","+\t\"net/http\"","+\t\"sync\"","+\t\"sync/atomic\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+type roundTripperFn func(req *http.Request) (*http.Response, error)","+","+func (r roundTripperFn) RoundTrip(request *http.Request) (*http.Response, error) {","+\treturn r(request)","+}","+","+func TestRoundTripper(t *testing.T) {","+\ttestCases := []struct {","+\t\tdesc                   string","+\t\tauthorizations         []string","+\t\texpectedStatusCode     []int","+\t\texpectedDedicatedCount int","+\t\texpectedOriginalCount  int","+\t}{","+\t\t{","+\t\t\tdesc:                  \"without Authorization header\",","+\t\t\tauthorizations:        []string{\"\", \"\", \"\"},","+\t\t\texpectedStatusCode:    []int{http.StatusUnauthorized, http.StatusUnauthorized, http.StatusUnauthorized},","+\t\t\texpectedOriginalCount: 3,","+\t\t},","+\t\t{","+\t\t\tdesc:                   \"with a preauthenticated Negotiate (Kerberos) credential on the first request\",","+\t\t\tauthorizations:         []string{\"Negotiate dj1jdA==\", \"\", \"\"},","+\t\t\texpectedStatusCode:     []int{http.StatusOK, http.StatusOK, http.StatusOK},","+\t\t\texpectedDedicatedCount: 3,","+\t\t},","+\t\t{","+\t\t\tdesc:                   \"with a preauthenticated NTLM credential on the first request\",","+\t\t\tauthorizations:         []string{\"NTLM TlRMTVNTUAAB\", \"\", \"\"},","+\t\t\texpectedStatusCode:     []int{http.StatusOK, http.StatusOK, http.StatusOK},","+\t\t\texpectedDedicatedCount: 3,","+\t\t},","+\t\t{","+\t\t\tdesc:                   \"with a challenge-first Negotiate flow\",","+\t\t\tauthorizations:         []string{\"\", \"Negotiate dj1jdA==\", \"\"},","+\t\t\texpectedStatusCode:     []int{http.StatusUnauthorized, http.StatusOK, http.StatusOK},","+\t\t\texpectedOriginalCount:  1,","+\t\t\texpectedDedicatedCount: 2,","+\t\t},","+\t\t{","+\t\t\tdesc:                   \"with a lowercase negotiate scheme\",","+\t\t\tauthorizations:         []string{\"negotiate dj1jdA==\", \"\", \"\"},",