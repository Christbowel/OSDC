{"id":"75b5fe997addb4eece1519928944d2eef43e6220","axis":"silent","repo":"duckdb/duckdb","sha":"75b5fe997addb4eece1519928944d2eef43e6220","parsed":{"files":[{"path":".github/config/extensions/legacy_parser.cmake","lines":["@@ -1,5 +1,6 @@"," duckdb_extension_load(legacy_parser","     LOAD_TESTS","+    APPLY_PATCHES","     GIT_URL https://github.com/duckdb/duckdb-legacy-parser","     GIT_TAG 0912e6734679d7df918da4af387bade6ff429d01","     INCLUDE_DIR src/include"],"additions":1,"deletions":0,"truncated":false},{"path":".github/patches/extensions/legacy_parser/0001-remove-legacy-parser-test.patch","lines":["@@ -0,0 +1,147 @@","+--- a/test/sql/legacy/legacy_parser.test","+@@ -1,144 +0,0 @@","+-# name: test/sql/legacy/legacy_parser.test","+-# description: The 1.5 Postgres-derived parser, registered as a parser override","+-# group: [legacy]","+-","+-require legacy_parser","+-","+-# loading alone changes nothing: the built-in parser handles every query until the opt-in is set","+-query I","+-SELECT current_setting('enable_legacy_parser')","+-----","+-false","+-","+-query I","+-SELECT lower(current_setting('allow_parser_override_extension'))","+-----","+-default","+-","+-query I","+-1 + 1","+-----","+-2","+-","+-# the opt-in: the legacy grammar is the parser, and the core setting moves from default to strict","+-statement ok","+-SET enable_legacy_parser = true","+-","+-query I","+-SELECT current_setting('allow_parser_override_extension')","+-----","+-strict","+-","+-query I","+-SELECT 42","+-----","+-42","+-","+-# column naming follows the 1.5 parser","+-query I","+-SELECT [1, 2, 3][2]","+-----","+-2","+-","+-query II","+-WITH c AS (SELECT range AS i, range % 2 AS j FROM range(6)) SELECT j, sum(i) FROM c GROUP BY j ORDER BY j","+-----","+-0\t6","+-1\t9","+-","+-statement ok","+-CREATE TABLE t(i INTEGER, j INTEGER)","+-","+-statement ok","+-ALTER TABLE t ADD COLUMN k INTEGER DEFAULT 5","+-","+-query III","+-INSERT INTO t VALUES (1, 2, 3) RETURNING *","+-----","+-1\t2\t3","+-","+-statement ok","+-PREPARE p AS SELECT count(*) FROM t WHERE i = $1","+-","+-query I","+-EXECUTE p(1)","+-----","+-1","+-","+-# the legacy parser's own error wording","+-statement error","+-SELEC 1","+-----","+-syntax error at or near \"SELEC\"","+-","+-# PEG-only syntax is rejected outright in strict mode","+-statement error","+-1 + 1","+-----","+-syntax error at or near \"1\"","+-","+-# switching the opt-in off means the built-in parser again, without touching the parser options","+-statement ok","+-SET enable_legacy_parser = false","+-","+-query I","+-SELECT current_setting('allow_parser_override_extension')","+-----","+-strict","+-","+-query I","+-1 + 1","+-----","+-2","+-","+-statement ok","+-SET enable_legacy_parser = true","+-","+-statement error","+-1 + 1","+-----","+-syntax error at or near \"1\"","+-","+-# fallback mode hands what the legacy grammar rejects to the PEG parser","+-statement ok","+-SET allow_parser_override_extension='fallback'","+-","+-query I","+-1 + 1","+-----","+-2","+-","+-statement error","+-SELEC 1","+-----","+-syntax error at or near \"1\"","+-","+-# default disables the override entirely","+-statement ok","+-SET allow_parser_override_extension='default'","+-","+-query I","+-1 + 1","+-----","+-2","+-","+-# enabling again moves the core setting off default once more","+-statement ok","+-SET enable_legacy_parser = true","+-","+-statement error","+-1 + 1","+-----","+-syntax error at or near \"1\"","+-","+-# an override mode that was chosen explicitly is kept","+-statement ok","+-SET allow_parser_override_extension='fallback'","+-","+-statement ok","+-SET enable_legacy_parser = true","+-","+-query I","+-SELECT current_setting('allow_parser_override_extension')","+-----","+-fallback"],"additions":146,"deletions":0,"truncated":false},{"path":"scripts/parser/grammar_types.yml","lines":["@@ -86,7 +86,6 @@ SQLStatement:","     - ExplainableStatements","     - ExplainSelectStatement","     - ExportStatement","-    - ExpressionStatement","  