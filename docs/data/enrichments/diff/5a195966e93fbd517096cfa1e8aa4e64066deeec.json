{"id":"5a195966e93fbd517096cfa1e8aa4e64066deeec","axis":"silent","repo":"expo/expo","sha":"5a195966e93fbd517096cfa1e8aa4e64066deeec","parsed":{"files":[{"path":".changeset/dev-launcher-device-login.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-dev-launcher': minor","+---","+","+Sign in to the launcher on a simulator or an emulator from the `__expo_device_code`, `__expo_device_match`, and `__expo_device_client` launch URL params."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/android/src/debug/java/expo/modules/devlauncher/DevLauncherController.kt","lines":["@@ -41,6 +41,7 @@ import expo.modules.devlauncher.logs.DevLauncherRemoteLogManager"," import expo.modules.devlauncher.react.activitydelegates.DevLauncherReactActivityNOPDelegate"," import expo.modules.devlauncher.react.activitydelegates.DevLauncherReactActivityRedirectDelegate"," import expo.modules.devlauncher.services.DependencyInjection","+import expo.modules.devlauncher.services.signInFromLaunchUrl"," import expo.modules.devmenu.launch.ExpoLauncherUrl"," import expo.modules.devmenu.launch.applyDevMenuLaunchParams"," import expo.modules.kotlin.weak","@@ -307,6 +308,7 @@ class DevLauncherController private constructor("," ","         // The dev menu params apply to every launcher command, with or without a `__expo_url`.","         DependencyInjection.devMenuPreferences?.let { launch.applyDevMenuLaunchParams(it) }","+        coroutineScope.launch { signInFromLaunchUrl(uri) }"," ","         if (launch.targetUrl == null) {","           if (!launch.isLegacyHost && launch.remainderHasDestination) {"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/android/src/debug/java/expo/modules/devlauncher/services/DeviceLogin.kt","lines":["@@ -0,0 +1,103 @@","+package expo.modules.devlauncher.services","+","+import android.net.Uri","+import android.util.Log","+import expo.modules.core.utilities.EmulatorUtilities","+import expo.modules.devlauncher.compose.Session","+import expo.modules.devlauncher.helpers.await","+import okhttp3.MediaType.Companion.toMediaType","+import okhttp3.Request","+import okhttp3.RequestBody.Companion.toRequestBody","+import org.json.JSONObject","+","+private const val TAG = \"DevLauncherDeviceLogin\"","+","+/** Set by a sign out and cleared by a sign in: a launch URL does not undo a sign out. */","+internal const val SIGNED_OUT_KEY = \"signed_out\"","+","+/** The `__expo_device_*` params of a launch URL. */","+data class DeviceLoginRequest(","+  val deviceCode: String,","+  val matchValue: String,","+  val clientId: String","+) {","+  companion object {","+    fun parse(uri: Uri): DeviceLoginRequest? {","+      if (!uri.isHierarchical) {","+        return null","+      }","+      fun query(name: String) = uri.getQueryParameter(name)?.takeIf { it.isNotEmpty() }","+","+      return DeviceLoginRequest(","+        deviceCode = query(\"__expo_device_code\") ?: return null,","+        matchValue = query(\"__expo_device_match\") ?: return null,","+        clientId = query(\"__expo_device_client\") ?: return null","+      )","+    }","+  }","+","+  /** The server sends two digits. Another two-digit value is a failed match, not a malformed request. */","+  val wrongMatchValue: String","+    get() = if (matchValue == \"00\") {","+      \"01\"","+    } else {","+      \"00\"","+    }","+}","+","+/**","+ * Signs the launcher in from a launch URL. The tool that opens the URL (Expo CLI, Expo Orbit)","+ * creates an OAuth device code and approves it with its own session; the launcher exchanges the","+ * code for a session of its own. A failure only writes a log line: the launch continues signed out.","+ */","+suspend fun signInFromLaunchUrl(uri: Uri) {","+  val sessionService = DependencyInjection.sessionService ?: return","+  val sessionStore = sessionService.sessionStore","+  // Emulator only: on a device, a link from another app could sign the launcher in to the","+  // sender's account. An emulator has the same risk, because the check does not look at the","+  // sender. That is the accepted risk: a launch URL can already open any project. The check reads","+  // `Build` properties, so a device with a custom ROM can pass it. This file is only in debug builds.","+  if (!EmulatorUtilities.isRunningOnEmulator()) {","+    return","+  }","+  val request = DeviceLoginRequest.parse(uri) ?: return","+  val redeems = Session.loadFromPreferences(sessionStore) == null &&","+    !sessionStore.getBoolean(SIGNED_OUT_KEY, false)","+","+  runCatching {","+    val payload = JSONObject()","+      .put(\"grant_type\", \"urn:ietf:params:oauth:grant-type:device_code\")","+      .put(\"client_id\", request.clientId)","+      .put(\"device_code\", request.deviceCode)","+      // The running app gets this URL too. When the launcher does not redeem the code, a wrong","+      // match value makes the server reject the code from then on.","+      .put(","+        \"match_value\",","+        if (redeems) {","+          request.matchValue","+        } else {","+          request.wrongMatchValue","+        }","+      )","+      .toString()","+    val response = Request","+      .Builder()","+      .url(\"https://api.expo.dev/v2/auth/token\")","+      .post(payload.toRequestBody(\"application/json\".toMediaType()))","+      .build()","+      .await(DependencyInjection.httpClientService.httpClient)","+    val data = response.use { JSONObject(it.body?.string().orEmpty()) }.getJSONObject(\"data\")","+    if (!redeems) {","+      return","+    }","+    if (!data.has(\"session_secret\")) {","+      // Only the server error code: never log the device code or the session secret.","+      Log.w(TAG, \"Could not sign in from the launch URL: ${data.optString(\"error\")}\")","+      return","+    }","+    sessionService.setSession(Session(data.getString(\"session_secret\")))","+  }.onFailure {","+    // Only the class: the message of a JSON error can contain the response body.","+    Log.w(TAG, \"Could not sign in from the launch URL: ${it.javaClass.simpleName}\")","+  }","+}"],"additions":103,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/android/src/debug/java/expo/modules/devlauncher/services/SessionService.kt","lines":["@@ -46,6 +46,13 @@ class SessionService("," ","       val me = graphQLService.fetchMe()","       val data = me.data","+      // The server answers a rejected session with a null `meUserActor` and no errors. Remove the","+      // session without the signed-out flag, so a launch URL can sign in again.","+      if (!me.hasErrors() && data?.meUserActor == null && _session.compareAndSet(newSession, null)) {","+        null.saveToPreferences(sessionStore)","+        httpClientService.setSession(null)","+        return@onEach","+      }","       if (me.hasErrors() || data == null) {","         // TODO(@lukmccall): Handle errors properly","         _user.update { UserState.LoggedOut }","@@ -67,6 +74,8 @@ class SessionService("," ","   fun setSession(newSession: Session?) {","     newSession.saveToPreferences(sessionStore)","+    // A null session is always an explicit sign out.","+    sessionStore.edit(commit = true) { putBoolean(SIGNED_OUT_KEY, newSession == null) }","     httpClientService.setSession(newSession?.sessionSecret)","     _session.update { newSession }","   }"],"additions":9,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/android/src/testDebug/java/expo/modules/devlauncher/services/DeviceLoginTest.kt","lines":["@@ -0,0 +1,33 @@","+package expo.modules.devlauncher.services","+","+import android.net.Uri","+import com.google.common.truth.Truth","+import org.junit.Test","+import org.junit.runner.RunWith","+import org.robolectric.RobolectricTestRunner","+","+@RunWith(RobolectricTestRunner::class)","+internal class DeviceLoginTest {","+  // The parameter names are spelled out: these are the literals Expo CLI and Expo Orbit send.","+  @Test","+  fun `reads the device code, match value and client ID next to a project URL`() {","+    val uri = Uri.parse(\"exp+app://?__expo_url=http%3A%2F%2Flocalhost%3A8081&__expo_device_code=abc&__expo_device_match=42&__expo_device_client=expo-go\")","+","+    Truth.assertThat(DeviceLoginRequest.parse(uri))","+      .isEqualTo(DeviceLoginRequest(deviceCode = \"abc\", matchValue = \"42\", clientId = \"expo-go\"))","+  }","+","+  @Test","+  fun `rejects a URL with a missing or empty param`() {","+    listOf(","+      \"exp+app://?__expo_url=http%3A%2F%2Flocalhost%3A8081\",","+      \"exp+app://?__expo_device_match=42&__expo_device_client=expo-go\",","+      \"exp+app://?__expo_device_code=abc&__expo_device_client=expo-go\",","+      \"exp+app://?__expo_device_code=abc&__expo_device_match=42\",","+      \"exp+app://?__expo_device_code=&__expo_device_match=42&__expo_device_client=expo-go\",","+      \"mailto:someone@example.com\"","+    ).forEach {","+      Truth.assertThat(DeviceLoginRequest.parse(Uri.parse(it))).isNull()","+    }","+  }","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/ios/EXDevLauncherController.m","lines":["@@ -325,6 +325,7 @@ - (BOOL)onDeepLink:(NSURL *)url options:(NSDictionary *)options","   // The dev menu params apply to every launcher command, with or without a `__expo_url`.","   [[DevMenuManager shared] applyLaunchParamsFromURL:url];","   [EXDevLauncherURLHelper applyDevMenuPreferencesIfNeeded:url];","+  [EXDevLauncherDeviceLogin handle:url];"," ","   if (![EXDevLauncherURLHelper hasUrlQueryParam:url]) {","     NSURL *externalDeepLink = [EXDevLauncherURLHelper externalDeepLinkFromLauncherURL:url];"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/ios/EXDevLauncherDeviceLogin.swift","lines":["@@ -0,0 +1,98 @@","+// Copyright 2015-present 650 Industries. All rights reserved.","+","+import Foundation","+","+/** The `__expo_device_*` params of a launch URL. */","+internal struct DeviceLoginRequest: Equatable {","+  let deviceCode: String","+  let matchValue: String","+  let clientId: String","+","+  internal static func parse(_ url: URL) -> DeviceLoginRequest? {","+    let queryItems = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems ?? []","+    func query(_ name: String) -> String? {","+      guard let value = queryItems.first(where: { $0.name == name })?.value, !value.isEmpty else {","+        return nil","+      }","+      return value","+    }","+","+    guard let deviceCode = query(\"__expo_device_code\"),","+          let matchValue = query(\"__expo_device_match\"),","+          let clientId = query(\"__expo_device_client\") else {","+      return nil","+    }","+    return DeviceLoginRequest(deviceCode: deviceCode, matchValue: matchValue, clientId: clientId)","+  }","+","+  /// The server sends two digits. Another two-digit value is a failed match, not a malformed request.","+  var wrongMatchValue: String {","+    return matchValue == \"00\" ? \"01\" : \"00\"","+  }","+}","+","+/**","+ * Signs the launcher in from a launch URL. The tool that opens the URL (Expo CLI, Expo Orbit)","+ * creates an OAuth device code and approves it with its own session; the launcher exchanges the","+ * code for a session of its own. A failure only writes a log line: the launch continues signed out.","+ */","+@objc(EXDevLauncherDeviceLogin)","+public class EXDevLauncherDeviceLogin: NSObject {","+  static let didSignInNotification = Notification.Name(\"EXDevLauncherDeviceLoginDidSignIn\")","+  /// Set by the sign out button and removed by a manual sign in: a launch URL does not undo a sign out.","+  static let signedOutKey = \"expo-device-login-signed-out\"","+","+  @objc public static func handle(_ url: URL) {","+    // Simulator only: on a device, a link from another app could sign the launcher in to the","+    // sender's account. A simulator has the same risk, because the check does not look at the","+    // sender. That is the accepted risk: a launch URL can already open any project.","+    #if targetEnvironment(simulator)","+    guard let request = DeviceLoginRequest.parse(url) else {","+      return","+    }","+    let defaults = UserDefaults.standard","+    let redeems = defaults.string(forKey: APIClient.sessionKey) == nil && !defaults.bool(forKey: signedOutKey)","+","+    Task {","+      do {","+        // The app's linking listeners get this URL too. When the launcher does not redeem the code,","+        // a wrong match value makes the server reject the code from then on.","+        let data = try await exchange(request, matchValue: redeems ? request.matchValue : request.wrongMatchValue)","+        guard redeems else {","+          return","+        }","+        guard let sessionSecret = data[\"session_secret\"] as? String else {","+          // Only the server error code: never log the device code or the session secret.","+          NSLog(\"DevLauncher could not sign in from the launch URL: %@\", data[\"error\"] as? String ?? \"no session in the response\")","+          return","+        }","+        defaults.set(sessionSecret, forKey: APIClient.sessionKey)","+        NotificationCenter.default.post(name: didSignInNotification, object: nil)","+      } catch {","+        NSLog(\"DevLauncher could not sign in from the launch URL: %@\", error.localizedDescription)","+      }","+    }","+    #endif","+  }","+","+  /** Returns the `data` object of the token response. */","+  private static func exchange(_ request: DeviceLoginRequest, matchValue: String) async throws -> [String: Any] {","+    guard let url = URL(string: \"\\(APIClient.shared.apiOrigin)/v2/auth/token\") else {","+      return [:]","+    }","+    var urlRequest = URLRequest(url: url)","+    urlRequest.httpMethod = \"POST\"","+    urlRequest.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")","+    urlRequest.httpBody = try JSONSerialization.data(withJSONObject: [","+      \"grant_type\": \"urn:ietf:params:oauth:grant-type:device_code\",","+      \"client_id\": request.clientId,","+      \"device_code\": request.deviceCode,","+      \"match_value\": matchValue","+    ])","+    urlRequest.timeoutInterval = 10","+","+    let (data, _) = try await URLSession.shared.data(for: urlRequest)","+    let json = try JSONSerialization.jsonObject(with: data) as? [String: Any]","+    return json?[\"data\"] as? [String: Any] ?? [:]","+  }","+}"],"additions":98,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/ios/SwiftUI/DevLauncherViewModel.swift","lines":["@@ -7,7 +7,6 @@ import Network"," import EXDevMenu"," "," private let selectedAccountKey = \"expo-selected-account-id\"","-private let sessionKey = \"expo-session-secret\""," "," private let DEV_LAUNCHER_DEFAULT_SCHEME = \"expo-dev-launcher\""," private let BONJOUR_TYPE = \"_expo._tcp\"","@@ -138,6 +137,16 @@ class DevLauncherViewModel: ObservableObject {","     loadData()","     checkAuthenticationStatus()","     checkForStoredCrashes()","+","+    NotificationCenter.default.addObserver(","+      forName: EXDevLauncherDeviceLogin.didSignInNotification,","+      object: nil,","+      queue: .main","+    ) { [weak self] _ in","+      Task { @MainActor [weak self] in","+        self?.checkAuthenticationStatus()","+      }","+    }","   }"," ","   private func updateDevServers(_ servers: [DevServer]) {","@@ -612,7 +621,7 @@ class DevLauncherViewModel: ObservableObject {","   }"," ","   private func checkAuthenticationStatus() {","-    let sessionSecret = UserDefaults.standard.string(forKey: sessionKey)","+    let sessionSecret = UserDefaults.standard.string(forKey: APIClient.sessionKey)"," ","     if let sessionSecret {","       APIClient.shared.setSession(sessionSecret)","@@ -625,7 +634,7 @@ class DevLauncherViewModel: ObservableObject {","   }"," ","   private func clearInvalidSession() {","-    UserDefaults.standard.removeObject(forKey: sessionKey)","+    UserDefaults.standard.removeObject(forKey: APIClient.sessionKey)","     APIClient.shared.setSession(nil)","     isAuthenticated = false","     user = nil","@@ -695,7 +704,8 @@ class DevLauncherViewModel: ObservableObject {","   }"," ","   func signOut() {","-    UserDefaults.standard.removeObject(forKey: sessionKey)","+    UserDefaults.standard.removeObject(forKey: APIClient.sessionKey)","+    UserDefaults.standard.set(true, forKey: EXDevLauncherDeviceLogin.signedOutKey)","     UserDefaults.standard.removeObject(forKey: selectedAccountKey)","     APIClient.shared.setSession(nil)","     clearRecentlyOpenedApps()","@@ -742,7 +752,8 @@ class DevLauncherViewModel: ObservableObject {","           return","         }"," ","-        UserDefaults.standard.set(sessionSecret, forKey: sessionKey)","+        UserDefaults.standard.set(sessionSecret, forKey: APIClient.sessionKey)","+        UserDefaults.standard.removeObject(forKey: EXDevLauncherDeviceLogin.signedOutKey)","         APIClient.shared.setSession(sessionSecret)","         continuation.resume(returning: true)","       }"],"additions":16,"deletions":5,"truncated":false},{"path":"packages/expo-dev-launcher/ios/SwiftUI/GraphQL/APIClient.swift","lines":["@@ -4,6 +4,8 @@ import Foundation"," "," class APIClient {","   static let shared = APIClient()","+  /// The `UserDefaults` key of the stored session secret.","+  static let sessionKey = \"expo-session-secret\""," ","   private var useStaging: Bool {","     return false","@@ -26,6 +28,12 @@ class APIClient {","       : \"https://exp.host/--/graphql\"","   }"," ","+  var apiOrigin: String {","+    return useStaging","+      ? \"https://staging-api.expo.dev\"","+      : \"https://api.expo.dev\"","+  }","+","   var websiteOrigin: String {","     return useStaging","       ? \"https://staging.expo.dev\""],"additions":8,"deletions":0,"truncated":false},{"path":"packages/expo-dev-launcher/ios/Tests/EXDevLauncherDeviceLoginTests.swift","lines":["@@ -0,0 +1,30 @@","+// Copyright 2015-present 650 Industries. All rights reserved.","+","+import Testing","+","+@testable import EXDevLauncher","+","+@Suite(\"EXDevLauncherDeviceLogin\")","+struct EXDevLauncherDeviceLoginTests {","+  // The parameter names are spelled out: these are the literals Expo CLI and Expo Orbit send.","+  @Test(\"reads the device code, match value and client ID next to a project URL\")","+  func validRequest() {","+    let url = URL(string: \"exp+app://?__expo_url=http%3A%2F%2Flocalhost%3A8081&__expo_device_code=abc&__expo_device_match=42&__expo_device_client=expo-go\")!","+","+    #expect(DeviceLoginRequest.parse(url) == DeviceLoginRequest(deviceCode: \"abc\", matchValue: \"42\", clientId: \"expo-go\"))","+  }","+","+  @Test(","+    \"rejects a URL with a missing or empty param\",","+    arguments: [","+      \"exp+app://?__expo_url=http%3A%2F%2Flocalhost%3A8081\",","+      \"exp+app://?__expo_device_match=42&__expo_device_client=expo-go\",","+      \"exp+app://?__expo_device_code=abc&__expo_device_client=expo-go\",","+      \"exp+app://?__expo_device_code=abc&__expo_device_match=42\",","+      \"exp+app://?__expo_device_code=&__expo_device_match=42&__expo_device_client=expo-go\"","+    ]","+  )","+  func incompleteRequest(_ url: String) {","+    #expect(DeviceLoginRequest.parse(URL(string: url)!) == nil)","+  }","+}",""],"additions":30,"deletions":0,"truncated":false}],"additions":305,"deletions":5,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-25T18:23:53.367904+00:00"}