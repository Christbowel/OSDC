ponse.status == expected_status","+    if expected_status == 401:","+        _assert_token_auth_error(response.text)","+","+","+_HTTP_CLIENT_CALLS = {","+    \"jobs\": \"from ray.job_submission import JobSubmissionClient\\n\"","+    \"JobSubmissionClient('{dashboard_url}').list_jobs()\\n\",","+    \"state\": \"from ray.util.state import list_nodes\\n\"","+    \"list_nodes(address='{dashboard_url}')\\n\",","+    \"serve\": \"from ray.dashboard.modules.serve.sdk import ServeSubmissionClient\\n\"","+    \"ServeSubmissionClient('{dashboard_url}')\\n\",","+}","+","+","+@pytest.mark.skipif(","+    client_test_enabled(),","+    reason=\"Uses subprocess ray start, not compatible with client mode\",","+)","+def test_dashboard_on_auth_disabled_cluster(disabled_head_with_token_file):","+    \"\"\"A dashboard with RAY_AUTH_MODE=disabled rejects requests that carry an auth","+    header, so the jobs, state and Serve clients with a token file work only if they","+    set RAY_AUTH_MODE=disabled too.\"\"\"","+    import requests","+","+    from ray._private.authentication.authentication_constants import (","+        AUTHENTICATION_TOKEN_COOKIE_NAME,","+    )","+","+    env, _, _, dashboard_url = disabled_head_with_token_file","+    wait_for_condition(","+        lambda: requests.get(f\"{dashboard_url}/api/version\", timeout=5).ok,","+        timeout=30,","+    )","+    token = \"c\" * 64","+    for path, headers, cookies, expect_mismatch in [","+        (\"/api/version\", {\"Authorization\": f\"Bearer {token}\"}, None, True),","+        (\"/api/version\", {\"Authorization\": f\"bearer {token}\"}, None, True),","+        (\"/api/version\", {\"X-Ray-Authorization\": f\"Bearer {token}\"}, None, True),","+        (\"/api/authentication_mode\", {\"Authorization\": f\"Bearer {token}\"}, None, True),","+        (\"/api/version\", None, {AUTHENTICATION_TOKEN_COOKIE_NAME: token}, False),","+        (\"/api/version\", {\"Authorization\": \"Basic dXNlcjpwYXNz\"}, None, True),","+        (\"/api/version\", {\"X-Ray-Authorization\": \"\"}, None, False),","+    ]:","+        response = requests.get(","+            f\"{dashboard_url}{path}\", headers=headers, cookies=cookies, timeout=5","+        )","+        if expect_mismatch:","+            assert response.status_code == 401, (path, headers, response.text)","+            _assert_token_auth_error(response.text)","+        else:","+            assert response.status_code == 200, (path, headers, cookies, response.text)","+    for client_name, client_call in _HTTP_CLIENT_CALLS.items():","+        for client_auth_mode in [\"disabled\", \"token\"]:","+            result = subprocess.run(","+                [","+                    sys.executable,","+                    \"-c\",","+                    client_call.format(dashboard_url=dashboard_url)","+                    + \"print('client ok')\\n\",","+                ],","+                env={**env, \"RAY_AUTH_MODE\": client_auth_mode},","+                capture_output=True,","+                text=True,","+                timeout=60,","+            )","+            output = f\"{client_name}, RAY_AUTH_MODE={client_auth_mode}:\\n\" + (","+                result.stdout + result.stderr","+            )","+","+            if client_auth_mode == \"disabled\":","+                assert result.returncode == 0, output","+                assert \"client ok\" in output","+            else:","+                assert result.returncode != 0, output","+                assert \"AuthenticationError\" in output, output","+                _assert_token_auth_error(output)","+","+","+@pytest.mark.skipif(","+    client_test_enabled(),","+    reason=\"Uses subprocess ray start, not compatible with client mode\",","+)","+@pytest.mark.parametrize(","+    \"entry_point\",","+    [\"ray start\", \"ray start --system-config\", \"ray.init\", \"Cluster\", \"gcs_server\"],","+)","+def test_k8s_token_auth_with_auth_disabled_is_config_error(entry_point, tmp_path):"],"additions":154,"deletio