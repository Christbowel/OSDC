 license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\JsonSchema\\DependencyInjection;","+","+use Symfony\\Component\\DependencyInjection\\Compiler\\CompilerPassInterface;","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+","+/**","+ * Gives the default context of the serializer to the native class schema resolver, so that dates and UIDs are described as the serializer writes them.","+ *","+ * @internal","+ */","+final class SerializerDefaultContextPass implements CompilerPassInterface","+{","+    public function process(ContainerBuilder $container): void","+    {","+        if (!$container->hasDefinition('json_schema.class_schema_resolver.native') || !$container->hasParameter('serializer.default_context')) {","+            return;","+        }","+","+        $container->getDefinition('json_schema.class_schema_resolver.native')->replaceArgument(0, $container->getParameter('serializer.default_context'));","+    }","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/JsonSchema/JsonSchemaBundle.php","lines":["@@ -0,0 +1,62 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\JsonSchema;","+","+use Symfony\\Component\\DependencyInjection\\Compiler\\PassConfig;","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+use Symfony\\Component\\DependencyInjection\\Kernel\\AbstractBundle;","+use Symfony\\Component\\DependencyInjection\\Kernel\\RequiredBundle;","+use Symfony\\Component\\DependencyInjection\\Kernel\\ServicesBundle;","+use Symfony\\Component\\DependencyInjection\\Loader\\Configurator\\ContainerConfigurator;","+use Symfony\\Component\\JsonSchema\\ClassSchemaResolver\\ClassSchemaResolverInterface;","+use Symfony\\Component\\JsonSchema\\DefinitionProcessor\\DefinitionProcessorInterface;","+use Symfony\\Component\\JsonSchema\\DependencyInjection\\SerializerDefaultContextPass;","+use Symfony\\Component\\JsonSchema\\PropertySchemaEnricher\\PropertySchemaEnricherInterface;","+use Symfony\\Component\\JsonSchema\\PropertySchemaProvider\\PropertySchemaProviderInterface;","+use Symfony\\Component\\PropertyInfo\\PropertyInfoBundle;","+use Symfony\\Component\\TypeInfo\\TypeInfoBundle;","+","+/**","+ * Provides the JSON Schema generator.","+ *","+ * @experimental","+ */","+#[RequiredBundle(ServicesBundle::class)]","+#[RequiredBundle(PropertyInfoBundle::class, ignoreOnInvalid: true)]","+#[RequiredBundle(TypeInfoBundle::class, ignoreOnInvalid: true)]","+class JsonSchemaBundle extends AbstractBundle","+{","+    public function getPath(): string","+    {","+        return $this->path ??= __DIR__;","+    }","+","+    public function build(ContainerBuilder $container): void","+    {","+        // before SerializerPass, which removes the \"serializer.default_context\" parameter","+        $container->addCompilerPass(new SerializerDefaultContextPass(), PassConfig::TYPE_BEFORE_OPTIMIZATION, 1);","+    }","+","+    public function loadExtension(array $config, ContainerConfigurator $configurator, ContainerBuilder $container): void","+    {","+        $configurator->import('Resources/config/json_schema.php');","+","+        $container->registerForAutoconfiguration(ClassSchemaResolverInterface::class)","+            ->addTag('json_schema.class_schema_resolver');","+        $container->registerForAutoconfiguration(PropertySchemaProviderInterface::class)","+            ->addTag('json_schema.property_schema_provider');","+        $container->registerForAutoconfiguration(PropertySchemaEnricherInterface::class)","+            ->addTag('json_schema.property_schema_enricher');","+        $container->registerForAutoconfiguration(DefinitionProcessorInterface::class)","+            ->addTag('json_schema.definition_processor');","+    }","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/JsonSchema/Resources/config/json_schema.php","lines":["@@ -0,0 +1,58 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\DependencyInjection\\Loader\\Configurator;","+","+use Symfony\\Component\\JsonSchema\\ClassSchemaResolver\\NativeClassSchemaResolver;","+use Symfony\\Component\\JsonSchema\\DefinitionPolicy\\ShortNameDefinitionPolicy;","+use Symfony\\Component\\JsonSchema\\PropertySchemaEnricher\\AttributePropertySchemaEnricher;","+use Symfony\\Component\\JsonSchema\\PropertySchemaEnricher\\ValidatorPropertySchemaEnricher;","+use Symfony\\Component\\JsonSchema\\SchemaGenerator;","+use Symfony\\Component\\JsonSchema\\SchemaGeneratorInterface;","+","+return static function (ContainerConfigurator $container) {","+    $container->services()","+        ->set('json_schema.generator', SchemaGenerator::class)","+            ->args([","+                service('property_info'),","+                service('json_schema.definition_policy'),","+                tagged_iterator('json_schema.class_schema_resolver'),","+                tagged_iterator('json_schema.property_schema_provider'),","+                tagged_iterator('json_schema.property_schema_enricher'),","+                tagged_iterator('json_schema.definition_processor'),","+                service('serializer.name_converter.metadata_aware')->ignoreOnInvalid(),","+                service('serializer.mapping.class_metadata_factory')->ignoreOnInvalid(),","+                service('serializer.mapping.class_discriminator_resolver')->ignoreOnInvalid(),","+                service('type_info.resolver')->ignoreOnInvalid(),","+            ])","+        ->alias(SchemaGeneratorInterface::class, 'json_schema.generator')","+","+        ->set('json_schema.definition_policy', ShortNameDefinitionPolicy::class)","+","+        // runs last, so that the resolvers of the app can describe dates, UIDs and enums their own way","+        ->set('json_schema.class_schema_resolver.native', NativeClassSchemaResolver::class)","+            ->args([","+                [],","+                service('serializer.mapping.class_metadata_factory')->ignoreOnInvalid(),","+            ])","+            ->tag('json_schema.class_schema_resolver', ['priority' => -1000])","+","+        // runs first, so that the enrichers of the app see the keywords of the constraints","+        ->set('json_schema.property_schema_enricher.validator', ValidatorPropertySchemaEnricher::class)","+            ->args([service('validator.mapping.class_metadata_factory')])","+            ->tag('json_schema.property_schema_enricher', ['priority' => 100])","+            ->tag('container.remove_if_missing', ['service' => 'validator.mapping.class_metadata_factory'])","+","+        // runs last, so that the keywords of #[JsonSchemaConstraint] win","+        ->set('json_schema.property_schema_enricher.attribute', AttributePropertySchemaEnricher::class)","+            ->tag('json_schema.property_schema_enricher', ['priority' => -100])","+    ;","+};"],"additions":58,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/JsonSchema/Tests/Fixtures/JsonSchemaBundleTestAppBundle.php","lines":["@@ -0,0 +1,32 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\JsonSchema\\Tests\\Fixtures;","+","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+use Symfony\\Component\\DependencyInjection\\Kernel\\AbstractBundle;","+use Symfony\\Component\\DependencyInjection\\Loader\\Configurator\\ContainerConfigurator;","+","+class JsonSchemaBundleTestAppBundle extends AbstractBundle","+{","+    /**","+     * @param \\Closure(ContainerBuilder): void $registerServices","+     */","+    public function __construct(","+        private readonly \\Closure $registerServices,","+    ) {","+    }","+","+    public function loadExtension(array $config, ContainerConfigurator $configurator, ContainerBuilder $container): void","+    {","+        ($this->registerServices)($container);","+    }","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/JsonSchema/Tests/Fixtures/JsonSchemaBundleTestKernel.php","lines":["@@ -0,0 +1,66 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\JsonSchema\\Tests\\Fixtures;","+","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+use Symfony\\Component\\DependencyInjection\\Kernel\\AbstractKernel;","+use Symfony\\Component\\DependencyInjection\\Kernel\\BundleInterface;","+use Symfony\\Component\\DependencyInjection\\Kernel\\KernelTrait;","+use Symfony\\Component\\DependencyInjection\\Loader\\Configurator\\ContainerConfigurator;","+use Symfony\\Component\\JsonSchema\\JsonSchemaBundle;","+","+class JsonSchemaBundleTestKernel extends AbstractKernel","+{","+    use KernelTrait;","+","+    /**","+     * @param list<BundleInterface>               $extraBundles","+     * @param array<string, array<string, mixed>> $extensionConfigs","+     */","+    public function __construct(","+        string $environment,","+        private string $dir,","+        private array $extraBundles,","+        private array $extensionConfigs,","+        private ?\\Closure $buildContainer,","+    ) {","+        parent::__construct($environment, true);","+    }","+","+    public function getProjectDir(): string","+    {","+        return $this->dir;","+    }","+","+    public function registerBundles(): iterable","+    {","+        yield new JsonSchemaBundle();","+        yield from $this->extraBundles;","+    }","+","+    protected function build(ContainerBuilder $container): void","+    {","+        $container->setAlias('test.json_schema.generator', 'json_schema.generator')","+            ->setPublic(true);","+","+        if (null !== $this->buildContainer) {","+            ($this->buildContainer)($container);","+        }","+    }","+","+    private function configureContainer(ContainerConfigurator $container): void","+    {","+        foreach ($this->extensionConfigs as $name => $config) {","+            $container->extension($name, $config);","+        }","+    }","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/JsonSchema/Tests/JsonSchemaBundleTest.php","lines":["@@ -0,0 +1,196 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\JsonSchema\\Tests;","+","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\DependencyInjection\\Argument\\TaggedIteratorArgument;","+use Symfony\\Component\\DependencyInjection\\ContainerBuilder;","+use Symfony\\Component\\DependencyInjection\\Kernel\\AbstractKernel;","+use Symfony\\Component\\DependencyInjection\\Kernel\\BundleInterface;","+use Symfony\\Component\\Filesystem\\Filesystem;","+use Symfony\\Component\\JsonSchema\\Attribute\\JsonSchemaConstraint;","+use Symfony\\Component\\JsonSchema\\Configuration;","+use Symfony\\Component\\JsonSchema\\JsonSchemaBundle;","+use Symfony\\Component\\JsonSchema\\PropertySchemaEnricher\\PropertySchema;","+use Symfony\\Component\\JsonSchema\\PropertySchemaEnricher\\PropertySchemaEnricherInterface;","+use Symfony\\Component\\JsonSchema\\SchemaDocument;","+use Symfony\\Component\\JsonSchema\\SchemaGeneratorInterface;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\Author;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\BookWithAuthors;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\Drawing;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\FixedPropertySchemaProvider;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\IdentifierDefinitionProcessor;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\IriReferenceClassSchemaResolver;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\JsonSchemaBundleTestAppBundle;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\JsonSchemaBundleTestKernel;","+use Symfony\\Component\\JsonSchema\\Tests\\Fixtures\\MarkingPropertySchemaEnricher;","+use Symfony\\Component\\PropertyInfo\\PropertyInfoBundle;","+use Symfony\\Component\\Serializer\\Attribute\\SerializedName;","+use Symfony\\Component\\Serializer\\SerializerBundle;","+use Symfony\\Component\\TypeInfo\\Type;","+use Symfony\\Component\\Validator\\Constraints as Assert;","+use Symfony\\Component\\Validator\\ValidationBundle;","+","+class JsonSchemaBundleTest extends TestCase","+{","+    private string $varDir;","+","+    protected function setUp(): void","+    {","+        $this->varDir = sys_get_temp_dir().'/sf_json_schema_bundle_test';","+","+        if (!class_exists(AbstractKernel::class) || !class_exists(PropertyInfoBundle::class)) {","+            $this->markTestSkipped('The bundle needs symfony/dependency-injection and symfony/property-info 8.2 or higher.');","+        }","+    }","+","+    protected function tearDown(): void","+    {","+        (new Filesystem())->remove($this->varDir);","+    }","+","+    public function testGeneratorIsWiredToTheTaggedExtensions()","+    {","+        $container = new ContainerBuilder();","+        $bundle = new JsonSchemaBundle();","+        $bundle->build($container);","+        $bundle->getContainerExtension()->load([[]], $container);","+","+        $this->assertSame('json_schema.generator', (string) $container->getAlias(SchemaGeneratorInterface::class));","+","+        $definition = $container->getDefinition('json_schema.generator');","+","+        foreach ([2 => 'json_schema.class_schema_resolver', 3 => 'json_schema.property_schema_provider', 4 => 'json_schema.property_schema_enricher', 5 => 'json_schema.definition_processor'] as $index => $tag) {","+            $this->assertInstanceOf(TaggedIteratorArgument::class, $definition->getArgument($index));","+            $this->assertSame($tag, $definition->getArgument($index)->getTag());","+        }","+    }","+","+    public function testGeneratorDescribesClasses()","+    {","+        $generator = $this->bootKernel('describe')->getContainer()->get('test.json_schema.generator');","+","+        $this->assertSame(['type' => 'object', 'properties' => ['name' => ['type' => 'string']]], $generator->generate(Type::object(Author::class))->getDefinitions()['Author']);","+    }","+","+    public function testExtensionsAreAutoconfigured()","+    {","+        $generator = $this->bootKernel('autoconfigure', build: static function (ContainerBuilder $container) {","+            $container->register('app.iri_resolver', IriReferenceClassSchemaResolver::class)->setArguments([Author::class])->setAutoconfigured(true);","+            $container->register('app.isbn_provider', FixedPropertySchemaProvider::class)->setArguments([BookWithAuthors::class, 'title', ['type' => 'string', 'format' => 'isbn']])->setAutoconfigured(true);","+            $container->register('app.marking_enricher', MarkingPropertySchemaEnricher::class)->setAutoconfigured(true);","+            $container->register('app.identifier_processor', IdentifierDefinitionProcessor::class)->setAutoconfigured(true);","+        })->getContainer()->get('test.json_schema.generator');","+","+        $properties = $generator->generate(Type::object(BookWithAuthors::class))->getDefinitions()['BookWithAuthors']['properties'];","+","+        $this->assertSame(['type' => 'string', 'format' => 'isbn', 'x-enriched' => true], $properties['title']);","+        $this->assertSame(['type' => 'string', 'format' => 'iri-reference', 'x-enriched' => true], $properties['author']);","+        $this->assertSame(['type' => 'string'], $properties['@id']);","+    }","+","+    public function testBuiltInExtensionsRunAroundTheOnesOfOtherBundles()","+    {","+        $generator = $this->bootKernel('order', [new JsonSchemaBundleTestAppBundle(static function (ContainerBuilder $container) {","+            $container->register('app.date_resolver', IriReferenceClassSchemaResolver::class)->setArguments([\\DateTimeImmutable::class])->setAutoconfigured(true);","+            $container->register('app.describing_enricher', JsonSchemaBundleTestDescribingEnricher::class)->setAutoconfigured(true);","+        })])->getContainer()->get('test.json_schema.generator');","+","+        $properties = $generator->generate(Type::object(JsonSchemaBundleTestEvent::class))->getDefinitions()['JsonSchemaBundleTestEvent']['properties'];","+","+        $this->assertSame(['type' => 'string', 'format' => 'iri-reference', 'description' => 'From the app.'], $properties['startsAt']);","+        $this->assertSame(['type' => 'string', 'description' => 'From the attribute.'], $properties['title']);","+    }","+","+    public function testValidatorConstraintsAreIgnoredWithoutTheValidator()","+    {","+        $generator = $this->bootKernel('no_validator')->getContainer()->get('test.json_schema.generator');","+","+        $this->assertSame(['type' => 'string'], $generator->generate(Type::object(JsonSchemaBundleTestCoupon::class))->getDefinitions()['JsonSchemaBundleTestCoupon']['properties']['code']);","+    }","+","+    public function testValidatorConstraintsAreDescribed()","+    {","+        if (!class_exists(ValidationBundle::class)) {","+            $this->markTestSkipped('The validator bundle needs symfony/validator 8.2 or higher.');","+        }","+","+        $generator = $this->bootKernel('validator', [new ValidationBundle()], build: static function (ContainerBuilder $container) {","+            // the validator bundle expects parameters that FrameworkBundle defines","+            $container->setParameter('kernel.charset', 'UTF-8');","+            $container->setParameter('kernel.enabled_locales', []);","+            $container->register('app.max_length_enricher', JsonSchemaBundleTestMaxLengthEnricher::class)->setAutoconfigured(true);","+        })->getContainer()->get('test.json_schema.generator');","+","+        $this->assertSame(['type' => 'string', 'maxLength' => 10, 'description' => 'At most 10 characters.'], $generator->generate(Type::object(JsonSchemaBundleTestCoupon::class))->getDefinitions()['JsonSchemaBundleTestCoupon']['properties']['code']);","+    }","+","+    public function testSerializerMappingAndDefaultContextAreFollowed()","+    {","+        if (!class_exists(SerializerBundle::class)) {","+            $this->markTestSkipped('The serializer bundle needs symfony/serializer 8.2 or higher.');","+        }","+","+        $generator = $this->bootKernel('serializer', [new SerializerBundle()], ['serializer' => ['default_context' => ['datetime_format' => 'Y-m-d']]])->getContainer()->get('test.json_schema.generator');","+","+        $this->assertSame(['published_on' => ['type' => 'string', 'format' => 'date']], $generator->generate(Type::object(JsonSchemaBundleTestArticle::class))->getDefinitions()['JsonSchemaBundleTestArticle']['properties']);","+        $this->assertArrayHasKey('anyOf', $generator->generate(Type::object(Drawing::class))->getDefinitions()['Drawing']['properties']['main']);","+    }","+","+    /**","+     * @param list<BundleInterface>               $bundles","+  