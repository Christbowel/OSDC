.unwrap();","+    let auth = AuthState::in_memory();","+    let publisher = issue_token(&auth, \"publisher\").await;","+    let admin = issue_token(&auth, \"administrator\").await;","+    let mut config = pypi_config(tmp.path().to_path_buf(), \"http://upstream.invalid/\");","+    config.identity.admins.insert(\"administrator\".to_string());","+    let app = router_with_auth(config, auth);","+    let filename = \"demo_pkg-1.0.0-py3-none-any.whl\";","+    let content = common::python_wheel(\"demo-pkg\", \"1.0.0\");","+    assert_eq!(","+        app.clone()","+            .oneshot(upload_request(","+                Some(&publisher),","+                wheel_upload(\"demo-pkg\", \"1.0.0\", filename, &content)","+            ))","+            .await","+            .unwrap()","+            .status(),","+        StatusCode::OK,","+    );","+    let file = format!(\"/pypi/files/demo-pkg/{filename}\");","+    let yank = format!(\"{file}/yank\");","+    assert_eq!(","+        app.clone()","+            .oneshot(management_request(\"PUT\", &yank, None, \"{}\"))","+            .await","+            .unwrap()","+            .status(),","+        StatusCode::UNAUTHORIZED,","+    );","+    assert_eq!(","+        app.clone()","+            .oneshot(management_request(","+                \"PUT\",","+                &yank,","+                Some(&publisher),","+                r#\"{\"reason\":\"Broken release\"}\"#","+            ))","+            .await","+            .unwrap()","+            .status(),","+        StatusCode::OK,","+    );","+    let response = app","+        .clone()","+        .oneshot(get(\"/pypi/simple/demo-pkg/\", Some(JSON)))","+        .await","+        .unwrap();","+    let page: Value = serde_json::from_slice(&body_bytes(response.into_body()).await).unwrap();","+    assert_eq!(page[\"files\"][0][\"yanked\"], \"Broken release\");","+    let response = app","+        .clone()","+        .oneshot(get(\"/pypi/simple/demo-pkg/\", None))","+        .await","+   