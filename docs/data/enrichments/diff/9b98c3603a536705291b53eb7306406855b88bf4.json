{"id":"9b98c3603a536705291b53eb7306406855b88bf4","axis":"silent","repo":"pnpm/pnpm","sha":"9b98c3603a536705291b53eb7306406855b88bf4","parsed":{"files":[{"path":".changeset/list-aliased-file-deps.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm list` no longer adds an `npm:` prefix to aliased local `file:` directory dependencies, and `pnpm list --json` preserves `<name>@file:<path>` in their `version` field."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/list-parseable-scoped-link-paths.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.inspection.list\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm list --parseable --long` now keeps `<name>@` on `link:` and `file:` dependencies whose path or peer suffix contains `@`, such as `link:../@scope/pkg`. Aliased scoped `file:` dependencies whose path contains `@` also keep `<name>@` in `pnpm list`."],"additions":7,"deletions":0,"truncated":false},{"path":".changeset/why-merge-local-file-deps.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.inspection.tree-builder\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm why` no longer merges distinct local `file:` directory dependencies that share the same package name across projects with dedicated lockfiles (`sharedWorkspaceLockfile: false`)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/list/render.rs","lines":["@@ -228,14 +228,14 @@ fn print_label(","     if node.search.matched { bold_styled(&label) } else { label }"," }"," ","-/// `name@version`, or — for an npm: protocol alias —","-/// `alias@npm:name@version`, unless the version already carries an `@`","-/// (`file:`, `link:`, ...).","+/// `name@version`, or `alias@npm:name@version` for an aliased package","+/// unless `version` is already prefixed with `<pkg>@` (such as aliased `file:`","+/// directory references)."," fn node_name_label(color: ColorFn, node: &DependencyNode) -> String {","     if node.alias == node.package.name {","         return name_at_version(&node.package.name, &node.package.version, color);","     }","-    if node.package.version.contains('@') {","+    if has_pkg_name_prefix(&node.package.version) {","         return format!(\"{}{}\", color(&node.alias), gray(&format!(\"@{}\", node.package.version)));","     }","     format!(","@@ -245,6 +245,32 @@ fn node_name_label(color: ColorFn, node: &DependencyNode) -> String {","     )"," }"," ","+/// Whether `version` already starts with `<pkg-name>@` (unscoped `pkg@...` or","+/// scoped `@scope/pkg@...`), rather than a bare semver or `<scheme>:...`","+/// specifier whose path or peer suffix merely contains `@`.","+pub(super) fn has_pkg_name_prefix(version: &str) -> bool {","+    if let Some(rest) = version.strip_prefix('@') {","+        let Some((scoped_name, after_at)) = rest.split_once('@') else {","+            return false;","+        };","+        let Some((scope, pkg)) = scoped_name.split_once('/') else {","+            return false;","+        };","+        return !after_at.is_empty() && is_pkg_name_segment(scope) && is_pkg_name_segment(pkg);","+    }","+    let Some((pkg, after_at)) = version.split_once('@') else {","+        return false;","+    };","+    !after_at.is_empty() && is_pkg_name_segment(pkg)","+}","+","+fn is_pkg_name_segment(segment: &str) -> bool {","+    !segment.is_empty()","+        && !segment","+            .chars()","+            .any(|ch| matches!(ch, ':' | '/' | '\\\\' | '(' | ')' | ' ' | '\\t'))","+}","+"," fn find_multi_peer_packages(projects: &[ProjectHierarchy]) -> HashMap<String, usize> {","     let mut variants = PeerVariants::default();","     fn walk(variants: &mut PeerVariants, nodes: &[DependencyNode]) {"],"additions":30,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/list/render/structured.rs","lines":["@@ -1,6 +1,6 @@"," use super::{","-    DependencyNode, HashSet, LongPkgInfo, Map, Path, ProjectHierarchy, Value, jso