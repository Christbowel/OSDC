]","+fn render_parseable_long_keeps_package_name_when_version_contains_at_in_path_or_peers() {","+    let projects = vec![project(","+        \"my-app\",","+        \"1.0.0\",","+        \"/workspace/packages/app\",","+        DependenciesHierarchy {","+            dependencies: vec![","+                dep(","+                    \"@example/lib\",","+                    \"@example/lib\",","+                    \"link:../@example/lib\",","+                    \"/workspace/packages/@example/lib\",","+                ),","+                dep(","+                    \"@example/local\",","+                    \"@example/local\",","+                    \"file:@scoped-dir/local\",","+                    \"/workspace/@scoped-dir/local\",","+                ),","+                dep(","+                    \"my-local-pkg\",","+                    \"my-local-pkg\",","+                    \"file:local-pkg(peer-pkg@1.0.0)\",","+                    \"/workspace/local-pkg\",","+                ),","+                dep(","+                    \"ws-alias\",","+                    \"ws-alias\",","+                    \"link:../@example/other\",","+                    \"/workspace/packages/@example/other\",","+                ),","+                dep(","+                    \"scoped-alias\",","+                    \"@example/local-aliased\",","+                    \"@example/local-aliased@file:@scoped-dir/local-aliased\",","+                    \"/workspace/@scoped-dir/local-aliased\",","+                ),","+                dep(","+                    \"missing-pkg\",","+                    \"missing-pkg\",","+                    \"missing-pkg@1.0.0\",","+                    \"/workspace/node_modules/missing-pkg\",","+                ),","+                dep(","+                    \"missing-alias\",","+                    \"missing-alias\",","+                    \"canonical@1.0.0\",","+                    \"/workspace/node_modules/missing-alias\",","+                ),","+  