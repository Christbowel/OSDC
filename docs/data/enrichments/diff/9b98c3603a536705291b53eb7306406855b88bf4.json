 = lockfile.packages","         .as_ref()","-        .and_then(|packages| packages.get(&dep_path.without_peer()))","-        .and_then(|metadata| metadata.version.clone())","-        .unwrap_or_else(|| dep_path.suffix.version().to_string());","+        .and_then(|packages| packages.get(&dep_path.without_peer()));","+    let version = crate::resolved_pkg_version(metadata, dep_path).unwrap_or_default();","     (dep_path.name.to_string(), version)"," }"," ","+/// Disambiguating merge key for a package whose display `version` is empty.","+/// Directory `file:` resolutions key lexically on the target directory without","+/// touching the filesystem so the same directory referenced from multiple","+/// per-project lockfiles merges while distinct directories stay separate.","+pub(super) fn package_merge_id(","+    lockfile_dir: &Path,","+    lockfile: &Lockfile,","+    dep_path: &PkgNameVerPeer,","+    version: &str,","+) -> Option<String> {","+    if !version.is_empty() {","+        return None;","+    }","+    let without_peer = dep_path.without_peer();","+    let resolution = lockfile.packages","+        .as_ref()","+        .and_then(|packages| packages.get(&without_peer))","+        .map(|metadata| &metadata.resolution);","+    if let Some(LockfileResolution::Directory(dir_res)) = resolution {","+        if dir_res.directory.starts_with(r\"\\\\\") || dir_res.directory.starts_with(\"//\") {","+            return Some(format!(\"dir:{}\", normalize_unc_directory(&dir_res.directory)));","+        }","+        let normalized = lexical_normalize(&lockfile_dir.join(&dir_res.directory));","+        return Some(format!(\"dir:{}\", normalized.to_string_lossy()));","+    }","+    Some(format!(\"dep:{without_peer}\"))","+}","+","+fn normalize_unc_directory(directory: &str) -> String {","+    let mut parts = directory","+        .trim_start_matches(['/', '\\\\'])","+        .split(['/', '\\\\'])","+        .filter(|part| !part.is_empty());","+    let mut normalized = Vec::new();","+    for _ in 0..2 {","+        if let Some(part) = parts.next() {","+            normalized.push(part);","+        }","+    }","+    let root_len = normalized.len();","+    for segment in parts {","+        match segment {","+            \".\" => {}","+            \"..\" => {","+                if normalized.len() > root_len {","+                    normalized.pop();","+                }","+            }","+            other => normalized.push(other),","+        }","+    }","+    format!(\"//{}\", normalized.join(\"/\"))","+}","+"," /// `semver.compare` when both versions parse as semver, lexicographic"," /// otherwise — the tree ordering the TypeScript CLI uses."," #[must_use]","@@ -134,6 +193,12 @@ pub fn sort_trees(trees: &mut [DependentsTree]) {","                     .unwrap_or(\"\")","                     .cmp(b.peers_suffix_hash.as_deref().unwrap_or(\"\"))","             })","+            .then_with(|| {","+                a.merge_id","+                    .as_deref()","+                    .unwrap_or(\"\")","+                    .cmp(b.merge_id.as_deref().unwrap_or(\"\"))","+            })","     });"," }"," ","@@ -174,6 +239,7 @@ fn same_tree_key(left: &DependentsTree, right: &DependentsTree) -> bool {","     left.name == right.name","         && left.version == right.version","         && left.peers_suffix_hash == right.peers_suffix_hash","+        && left.merge_id == right.merge_id"," }"," "," fn merge_into_tree(target: &mut DependentsTree, source: DependentsTree) {","@@ -201,6 +267,12 @@ fn merge_dependent_nodes(target: &mut Vec<DependentNode>, source: Vec<DependentN","                     .unwrap_or(\"\")","                     .cmp(b.peers_suffix_hash.as_deref().unwrap_or(\"\"))","             })","+            .then_with(|| {","+                a.merge_id","+                    .as_deref()","+                    .unwrap_or(\"\")","+                    .cmp(b.merge_id.as_deref().unwrap_or(\"\"))","+            })","             .then_with(|| {","    