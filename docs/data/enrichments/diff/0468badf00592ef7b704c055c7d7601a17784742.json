t\t}","+\t\t\t\t\t\t_, err := sess.Exec(\"UPDATE permission SET scope = ? WHERE scope = ?\", \"dashboards:uid:team-refreshed\", \"dashboards:uid:team\")","+\t\t\t\t\t\treturn err","+\t\t\t\t\t}))","+\t\t\t\t\t_, err := load(enabledCtx, accesscontrol.Options{ReloadCache: true})","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\trefreshed, err := load(disabledCtx, accesscontrol.Options{})","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\trequire.ElementsMatch(t, []accesscontrol.Permission{","+\t\t\t\t\t\tSharedWithMeFolderPermission,","+\t\t\t\t\t\t{Action: \"dashboards:read\", Scope: \"dashboards:uid:individual\"},","+\t\t\t\t\t\t{Action: \"dashboards:read\", Scope: \"dashboards:uid:refreshed\"},","+\t\t\t\t\t\t{Action: \"dashboards:read\", Scope: \"dashboards:uid:team-refreshed\"},","+\t\t\t\t\t}, rawPermissions(refreshed))","+","+\t\t\t\t\trequire.NoError(t, s.sql.WithDbSession(t.Context(), func(sess *db.Session) error {","+\t\t\t\t\t\t_, err := sess.Exec(\"DELETE FROM permission WHERE scope = ?\", \"dashboards:uid:refreshed\")","+\t\t\t\t\t\treturn err","+\t\t\t\t\t}))","+\t\t\t\t\t// Clear through the other reader to verify that shared invalidation still works.","+\t\t\t\t\tif route == \"local\" {","+\t\t\t\t\t\tloader.ClearUserPermissionCache(requester)","+\t\t\t\t\t} else {","+\t\t\t\t\t\ts.ClearUserPermissionCache(requester)","+\t\t\t\t\t}","+\t\t\t\t\tfor _, ctx := range []context.Context{enabledCtx, disabledCtx} {","+\t\t\t\t\t\tgot, err := load(ctx, accesscontrol.Options{})","+\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\trequire.NotContains(t, rawPermissions(got), accesscontrol.Permission{Action: \"dashboards:read\", Scope: \"dashboards:uid:refreshed\"})","+\t\t\t\t\t}","+\t\t\t\t})","+\t\t\t}","+\t\t}","+\t}","+}","+","+type changingManagedPermissionProvider struct {","+\topenfeature.NoopProvider","+\tcalls atomic.Int64","+}","+","+func (p *changingManagedPermissionProvider) BooleanEvaluation(_ context.Context, flag string, fallback bool, _ openfeature.FlattenedContext) openfeature.BoolResolutionDetail {","+\tif flag != featuremgmt.FlagExcludeRedundantManagedPermissions {","+\t\treturn openfeature.BoolResolutionDetail{Value: fallback}","+\t}","+","+\t// A second evaluation in the same load would disagree with its cache key.","+\tconst firstEvaluation = 1","+\treturn openfeature.BoolResolutionDetail{Value: p.calls.Add(1) == firstEvaluation}","+}","+","+func TestManagedPermissionFilteringCapturedPerLoad(t *testing.T) {","+\tprovider := &changingManagedPermissionProvider{}","+\trequire.NoError(t, openfeature.SetProviderAndWait(provider))","+\tt.Cleanup(func() { require.NoError(t, openfeature.SetProviderAndWait(openfeature.NoopProvider{})) })","+","+\tconst orgID int64 = 1","+\tconst userID int64 = 7","+\trequester := &user.SignedInUser{UserID: userID, OrgID: orgID, OrgRole: org.RoleNone}","+\tcache := localcache.New(0, 0)","+\tcache.Set(accesscontrol.GetBasicRolePermissionCacheKey(string(org.RoleNone), orgID), []accesscontrol.Permission{}, accesscontrol.PermissionCacheTTL)","+\tcfg := setting.NewCfg()","+\tcfg.RBAC.PermissionCache = true","+\tstore := actest.NewMockStore(t)","+\ts := &Service{","+\t\topenFeatureClient: openfeature.NewDefaultClient(),","+\t\tcache:             cache,","+\t\tcfg:               cfg,","+\t\tstore:             store,","+\t\tactionResolver:    resourcepermissions.NewActionSetService(),","+\t}","+","+\tfor _, filtered := range []bool{true, false} {","+\t\tstore.On(\"GetUserPermissions\", mock.Anything, accesscontrol.GetUserPermissionsQuery{","+\t\t\tOrgID:                              orgID,","+\t\t\tUserID:                             userID,","+\t\t\tRolePrefixes:                       OSSRolesPrefixes,","+\t\t\tExcludeRedundantManagedPermissions: filtered,","+\t\t}).Return([]accesscontrol.Permission{}, nil).Once()","+","+\t\tgot, err := s.GetRBACUserPermissions(t.Context(), requester, accesscontrol.Options{})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, []accesscontrol.Permission{SharedWithMeFolderPermission}, got)","+\t}","+","+\tconst expectedEvaluations int64 = 2","+\trequire.Equal(t, expectedEvaluations, provider.calls.Load())","+}","+","+type blockingManagedPermissionStore struct {","+\taccesscontrol.Store","+\trelease <-chan struct{}","+}","+","+func (s blockingManagedPermissionStore) GetUserPermissions(_ context.Context, q accesscontrol.GetUserPermissionsQuery) ([]accesscontrol.Permission, error) {","+\tif q.ExcludeRedundantManagedPermissions {","+\t\treturn nil, nil","+\t}","+\t<-s.release","+\treturn []accesscontrol.Permission{{Action: \"dashboards:read\", Scope: \"dashboards:uid:individual\"}}, nil","+}","+","+func TestManagedPermissionFilteringConcurrentAssemblies(t *testing.T) {","+\trequire.NoError(t, openfeature.SetProviderAndWait(managedPermissionFeatureProvider{}))","+\tt.Cleanup(func() { require.NoError(t, openfeature.SetProviderAndWait(openfeature.NoopProvider{})) })","+\tsynctest.Test(t, func(t *testing.T) {","+\t\tcache := localcache.New(0, 0)","+\t\tcfg := setting.NewCfg()","+\t\tcfg.RBAC.PermissionCache = true","+\t\trelease := make(chan struct{})","+\t\ts := &Service{openFeatureClient: openfeature.NewDefaultClient(), cache: cache, cfg: cfg, store: blockingManagedPermissionStore{release: release}, actionResolver: resourcepermissions.NewActionSetService()}","+\t\trequester := &user.SignedInUser{UserID: 7, OrgID: 1, OrgRole: org.RoleNone}","+\t\tcache.Set(accesscontrol.GetBasicRolePermissionCacheKey(string(org.RoleNone), requester.OrgID), []accesscontrol.Permission{}, accesscontrol.PermissionCacheTTL)","+\t\tfiltered := []accesscontrol.Permission{SharedWithMeFolderPermission}","+\t\tunfiltered := append([]accesscontrol.Permission{{Action: \"dashboards:read\", Scope: \"dashboards:uid:individual\"}}, filtered...)","+\t\ttype result struct {","+\t\t\tpermissions []accesscontrol.Permission","+\t\t\terr         error","+\t\t}","+\t\toff, on := make(chan result, 1), make(chan result, 1)","+\t\tload := func(target string, results chan<- result) {","+\t\t\tctx := openfeature.WithTransactionContext(t.Context(), openfeature.NewEvaluationContext(target, nil))","+\t\t\tpermissions, err := s.GetRBACUserPermissions(ctx, requester, accesscontrol.Options{})","+\t\t\tresults <- result{permissions, err}","+\t\t}","+\t\tgo load(\"disabled\", off)","+\t\tsynctest.Wait()","+\t\tgo load(\"enabled\", on)","+\t\tsynctest.Wait()","+\t\tselect {","+\t\tcase got := <-on:","+\t\t\tassert.NoError(t, got.err)","+\t\t\tassert.Equal(t, filtered, got.permissions)","+\t\tdefault:","+\t\t\tt.Error(\"filtered request joined an unfiltered assembly\")","+\t\t}","+\t\tclose(release)","+\t\tsynctest.Wait()","+\t\tgot := <-off","+\t\trequire.NoError(t, got.err)","+\t\trequire.Equal(t, unfiltered, got.permissions)","+\t})","+}"],"additions":243,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/acimpl/managed_permission_filtering.go","lines":["@@ -0,0 +1,35 @@","+package acimpl","+","+import (","+\t\"context\"","+","+\t\"github.com/open-feature/go-sdk/openfeature\"","+","+\t\"github.com/grafana/grafana/pkg/services/featuremgmt\"","+)","+","+type managedPermissionFilteringKey struct{}","+","+// Capture once so cache keys and SQL queries use the same filtering decision","+// throughout a permission load, even if the provider changes in the meantime.","+func (s *Service) withManagedPermissionFiltering(ctx context.Context) context.Context {","+\tif _, ok := ctx.Value(managedPermissionFilteringKey{}).(bool); ok {","+\t\treturn ctx","+\t}","+","+\treturn context.WithValue(ctx, managedPermissionFilteringKey{}, s.excludeRedundantManagedPermissions(ctx))","+}","+","+func (s *Service) excludeRedundantManagedPermissions(ctx context.Context) bool {","+\tif enabled, ok := ctx.Value(managedPermissionFilteringKey{}).(bool); ok {","+\t\treturn enabled","+\t}","+","+\tconst defaultExcludeRedundantManagedPermissions = false","+\treturn s.openFeatureClient.Boolean(","+\t\tctx,","+\t\tfeaturemgmt.FlagExcludeRedundantMana