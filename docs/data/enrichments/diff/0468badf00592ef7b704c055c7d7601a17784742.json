rmissions)","+\t\t\t\t\ts.actionResolver.(resourcepermissions.ActionSetService).StoreActionSet(\"dashboards:view\", []string{\"dashboards:read\"})","+\t\t\t\t\tconst userID = 7","+\t\t\t\t\tconst teamID = 11","+\t\t\t\t\trequester := &user.SignedInUser{UserID: userID, UserUID: \"seven\", OrgID: accesscontrol.GlobalOrgID, OrgRole: org.RoleNone}","+\t\t\t\t\trequester.TeamIDs = []int64{teamID} //nolint:staticcheck // Legacy permission caches use numeric team memberships.","+\t\t\t\t\tfor _, grant := range []struct{ action, scope string }{","+\t\t\t\t\t\t{\"dashboards:read\", \"dashboards:uid:individual\"},","+\t\t\t\t\t\t{\"dashboards:view\", \"dashboards:uid:action-set\"},","+\t\t\t\t\t} {","+\t\t\t\t\t\taddContractUserGrant(t, s.sql, fmt.Sprintf(\"managed:%s\", grant.action), requester.OrgID, userID,","+\t\t\t\t\t\t\taccesscontrol.Permission{Action: grant.action, Scope: grant.scope, Kind: \"dashboards\"})","+\t\t\t\t\t}","+\t\t\t\t\taddContractUserGrant(t, s.sql, \"managed:team\", requester.OrgID, userID+1,","+\t\t\t\t\t\taccesscontrol.Permission{Action: \"dashboards:read\", Scope: \"dashboards:uid:team\", Kind: \"dashboards\"})","+\t\t\t\t\trequire.NoError(t, s.sql.WithDbSession(t.Context(), func(sess *db.Session) error {","+\t\t\t\t\t\tvar role accesscontrol.Role","+\t\t\t\t\t\tfound, err := sess.Where(\"name = ?\", \"managed:team\").Get(&role)","+\t\t\t\t\t\tif err != nil {","+\t\t\t\t\t\t\treturn err","+\t\t\t\t\t\t}","+\t\t\t\t\t\tif !found {","+\t\t\t\t\t\t\treturn fmt.Errorf(\"managed team role was not created\")","+\t\t\t\t\t\t}","+\t\t\t\t\t\t_, err = sess.Insert(&accesscontrol.TeamRole{OrgID: requester.OrgID, TeamID: teamID, RoleID: role.ID, Created: time.Now()})","+\t\t\t\t\t\treturn err","+\t\t\t\t\t}))","+\t\t\t\t\tloader := newContractLoader(s, s.cache)","+\t\t\t\t\tembedded := legacypermissions.NewEmbeddedClient(loader, s.cfg)","+","+\t\t\t\t\tload := func(ctx context.Context, options accesscontrol.Options) ([]accesscontrol.Permission, error) {","+\t\