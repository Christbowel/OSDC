{"id":"a0e452b925b77bf44acea0a27239596ddcc09bf8","axis":"silent","repo":"vercel/next.js","sha":"a0e452b925b77bf44acea0a27239596ddcc09bf8","parsed":{"files":[{"path":"turbopack/crates/turbo-tasks-backend/benches/mod.rs","lines":["@@ -7,12 +7,13 @@ pub(crate) mod cell_fan_out;"," pub(crate) mod gc;"," pub(crate) mod overhead;"," pub(crate) mod scope_stress;","+pub(crate) mod state_fan_out;"," pub(crate) mod stress;"," "," criterion_group!(","     name = turbo_tasks_backend_stress;","     config = Criterion::default();","     targets = stress::fibonacci, scope_stress::scope_stress, overhead::overhead, gc::gc,","-        cell_fan_out::cell_fan_out","+        cell_fan_out::cell_fan_out, state_fan_out::state_fan_out"," );"," criterion_main!(turbo_tasks_backend_stress);"],"additions":2,"deletions":1,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/benches/state_fan_out.rs","lines":["@@ -0,0 +1,169 @@","+//! Benchmarks invalidating many tasks from outside: one `State` is read directly by `width`","+//! dependent tasks, so `State::set` invalidates all of them through their invalidators","+//! (`Invalidator` → `TurboTasksApi` → `Backend`).","+//!","+//! The graph is built once per configuration. Each iteration sets the state and reads the root","+//! strongly consistently; the timing covers invalidation, scheduling and re-execution of all","+//! dependents. In the `evicted` variant all tasks are snapshotted and evicted before each","+//! iteration (not timed), so the invalidation also has to restore the dependents from disk.","+//!","+//! ```bash","+//! cargo bench -p turbo-tasks-backend --bench mod -- state_fan_out","+//! ```","+","+use std::{","+    sync::Arc,","+    time::{Duration, Instant},","+};","+","+use anyhow::Result;","+use criterion::{BenchmarkId, Criterion, Throughput};","+use turbo_tasks::{OperationVc, ResolvedVc, State, TryJoinIterExt, TurboTasks, Vc};","+use turbo_tasks_backend::{","+    BackendOptions, BackingStorageOptions, EvictionMode, GitVersionInfo, StorageMode,","+    TurboTasksBackend,","+};","+","+#[turbo_tasks::value(transparent)]","+struct Input(State<u32>);","+","+#[turbo_tasks::function(operation, root)]","+fn create_input() -> Vc<Input> {","+    Input(State::new(0)).cell()","+}","+","+/// Reads the state directly, so it is one of the state's invalidators.","+#[turbo_tasks::function]","+async fn dependent(input: ResolvedVc<Input>, index: u32) -> Result<Vc<u32>> {","+    Ok(Vc::cell(input.await?.get().wrapping_add(index)))","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn fan_out_root(input: ResolvedVc<Input>, width: u32) -> Result<Vc<u32>> {","+    let values = (0..width)","+        .map(|index| dependent(*input, index))","+        .try_join()","+        .await?;","+    Ok(Vc::cell(","+        values","+            .iter()","+            .fold(0u32, |sum, value| sum.wrapping_add(**value)),","+    ))","+}","+","+/// The sum `fan_out_root` computes when the state is `value`.","+fn expected_sum(value: u32, width: u32) -> u32 {","+    (0..width).fold(0u32, |sum, index| {","+        sum.wrapping_add(value.wrapping_add(index))","+    })","+}","+","+fn create_tt() -> (Arc<TurboTasks<TurboTasksBackend>>, tempfile::TempDir) {","+    let parent = std::path::PathBuf::from(format!(\"{}/.cache\", env!(\"CARGO_TARGET_TMPDIR\")));","+    std::fs::create_dir_all(&parent).unwrap();","+    let dir = tempfile::Builder::new()","+        .prefix(\"state-fan-out-bench-\")","+        .tempdir_in(&parent)","+        .unwrap();","+    let tt = TurboTasks::new(TurboTasksBackend::new(","+        BackendOptions {","+            // Snapshots are only taken explicitly (`snapshot_and_evict_for_testing`).","+            storage_mode: Some(StorageMode::ReadWriteOnShutdown),","+            eviction_mode: EvictionMode::Full,","+            ..Default::default()","+        },","+        turbo_tasks_backend::turbo_backing_storage(","+            dir.path(),","+            &GitVersionInfo {","+                describe: \"bench-unversioned\",","+                dirty: false,","+            },","+            BackingStorageOptions {","+                is_ci: false,","+                is_short_session: true,","+                skip_compaction: true,","+            },","+        )","+        .unwrap()","+        .0,","+    ));","+    (tt, dir)","+}","+","+async fn set_and_read(input_op: OperationVc<Input>, width: u32, value: u32) -> Result<Duration> {","+    let input = input_op.resolve().strongly_consistent().await?;","+    let state = input_op.read_strongly_consistent().await?;","+    let start = Instant::now();","+    state.set(value);","+    let sum = *fan_out_root(input, width)","+        .read_strongly_consistent()","+        .await?;","+    let elapsed = start.elapsed();","+    assert_eq!(sum, expected_sum(value, width));","+    Ok(elapsed)","+}","+","+pub fn state_fan_out(c: &mut Criterion) {","+    let mut group = c.benchmark_group(\"turbo_tasks_backend_state_fan_out\");","+    group.sample_size(20);","+    group.measurement_time(Duration::from_secs(10));","+","+    for evict in [false, true] {","+        let variant = if evict { \"evicted\" } else { \"resident\" };","+        for width in [1u32, 1_000, 10_000] {","+            group.throughput(Throughput::Elements(width as u64));","+            group.bench_with_input(BenchmarkId::new(variant, width), &width, |b, &width| {","+                let rt = tokio::runtime::Builder::new_multi_thread()","+                    .enable_all()","+                    .build()","+                    .unwrap();","+                // `TurboTasks::new` needs the runtime context.","+                let (tt, _dir) = rt.block_on(async { create_tt() });","+                // Build the graph once (not timed).","+                let input_op = rt","+                    .block_on(tt.run_once(async move {","+                        let input_op = create_input();","+                        let input = input_op.resolve().strongly_consistent().await?;","+                        let sum = *fan_out_root(input, width)","+                            .read_strongly_consistent()","+                            .await?;","+                        assert_eq!(sum, expected_sum(0, width));","+                        Ok(input_op)","+                    }))","+                    .unwrap();","+","+                let mut next_value = 1u32;","+                b.iter_custom(|iters| {","+                    let mut total = Duration::ZERO;","+                    for _ in 0..iters {","+                        if evict {","+                            let _guard = rt.enter();","+                            let counts = tt","+                                .backend()","+                                .snapshot_and_evict_for_testing(&tt)","+                                .eviction_counts;","+                            // Every dependent must have been evicted, so the invalidation has to","+                            // restore it.","+                            let evicted = counts.full + counts.data_and_meta + counts.data_only;","+                            assert!(","+                                evicted >= width as usize,","+                                \"expected at least {width} evicted tasks, got {counts:?}\"","+                            );","+                        }","+                        let value = next_value;","+                        next_value = next_value.wrapping_add(1);","+                        total += rt","+                            .block_on(tt.run_once(async move {","+                                set_and_read(input_op, width, value).await","+                            }))","+                            .unwrap();","+                    }","+                    total","+                });","+                rt.block_on(async { tt.stop_and_wait().await });","+            });","+        }","+    }","+","+    group.finish();","+}"],"additions":169,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/src/backend/mod.rs","lines":["@@ -29,7 +29,7 @@ pub use gc::{GcPassResult, GcStats, TtlCounter};"," use hashbrown::hash_table::Entry;"," use parking_lot::{Mutex, RwLock};"," use rustc_hash::{FxHashMap, FxHashSet, FxHasher};","-use smallvec::{SmallVec, smallvec};","+use smallvec::SmallVec;"," use tokio::time::{Duration, Instant};"," use tracing::{Span, field::display, trace_span};"," use turbo_bincode::TurboBincodeBuffer;","@@ -47,6 +47,7 @@ use turbo_tasks::{","     event::{Event, EventDescription, EventListener},","     macro_helpers::NativeFunction,","     message_queue::{DiagnosticEvent, Severity, TimingEvent, TraceEvent},","+    parallel,","     registry::get_value_type,","     scope_bounded::scope_bounded,","     task_statistics::TaskStatisticsApi,","@@ -390,6 +391,17 @@ impl TurboTasksBackend {","         ExecuteContext::new(self, turbo_tasks)","     }"," ","+    /// Like [`TurboTasksBackend::execute_context`], but with an explicit current task priority","+    /// instead of the one from the task-local task state. For work that runs on another thread","+    /// than the calling task.","+    fn execute_context_with_priority<'a>(","+        &'a self,","+        turbo_tasks: &'a TurboTasks<TurboTasksBackend>,","+        current_task_priority: TaskPriority,","+    ) -> ExecuteContext<'a> {","+        ExecuteContext::new(self, turbo_tasks).with_current_task_priority(current_task_priority)","+    }","+","     /// Like [`TurboTasksBackend::execute_context`], but refuses to hand out a context once","     /// shutdown has begun, and blocks shutdown for as long as the returned context is alive.","     ///","@@ -465,6 +477,24 @@ impl TurboTasksBackend {","         self.storage.resident_task_count_for_testing()","     }"," ","+    /// The parent priority a dirty task was made dirty with, or `None` if it doesn't exist or is","+    /// not dirty. Test-only hook for verifying invalidation priorities.","+    #[doc(hidden)]","+    pub fn dirty_parent_priority_for_testing(","+        &self,","+        task: TaskId,","+        turbo_tasks: &TurboTasks<TurboTasksBackend>,","+    ) -> Option<TaskPriority> {","+        let mut ctx = self.execute_context(turbo_tasks);","+        let task = ctx.try_task(task, TaskDataCategory::All)?;","+        match task.get_dirty() {","+            Some(Dirtyness::Dirty {","+                parent_priority, ..","+            }) => Some(*parent_priority),","+            _ => None,","+        }","+    }","+","     /// The persistent `parent_count` of a resident task (0 if absent or not resident). Test-only","     /// hook for verifying incremental refcount maintenance.","     #[doc(hidden)]","@@ -1846,7 +1876,7 @@ impl TurboTasksBackend {","             panic!(\"Dependency tracking is disabled so invalidation is not allowed\");","         }","         invalidate(","-            smallvec![task_id],","+            [task_id],","             #[cfg(feature = \"task_dirty_cause\")]","             TaskDirtyCause::Invalidator,","             self.execute_context(turbo_tasks),","@@ -1857,12 +1887,25 @@ impl TurboTasksBackend {","         if !self.should_track_dependencies() {","             panic!(\"Dependency tracking is disabled so invalidation is not allowed\");","         }","-        invalidate(","-            tasks.iter().copied().collect(),","-            #[cfg(feature = \"task_dirty_cause\")]","-            TaskDirtyCause::Unknown,","-            self.execute_context(turbo_tasks),","+        // `invalidate` checks each chunk for duplicates, but a duplicate split across two chunks","+        // would only be seen here.","+        debug_assert!(","+            tasks.len() <= 1 || tasks.iter().collect::<FxHashSet<_>>().len() == tasks.len(),","+            \"invalidate_tasks() must not be called with duplicate task ids: {tasks:?}\"","         );","+        // Large batches are invalidated in parallel chunks. The chunks may run on other threads,","+        // which don't have the calling task's state, so its priority (the parent priority of the","+        // dirty tasks) is read once here and passed to every chunk.","+        let current_task_priority = turbo_tasks.get_current_task_priority();","+        parallel::for_each_chunk(tasks, |chunk| {","+            invalidate(","+                chunk.iter().copied(),","+                // Called by `TurboTasksApi::invalidate_many*`, i.e. batched `Invalidator`s.","+                #[cfg(feature = \"task_dirty_cause\")]","+                TaskDirtyCause::Invalidator,","+                self.execute_context_with_priority(turbo_tasks, current_task_priority),","+            );","+        });","     }"," ","     fn invalidate_tasks_set(","@@ -1874,7 +1917,7 @@ impl TurboTasksBackend {","             panic!(\"Dependency tracking is disabled so invalidation is not allowed\");","         }","         invalidate(","-            tasks.iter().copied().collect(),","+            tasks.iter().copied(),","             #[cfg(feature = \"task_dirty_cause\")]","             TaskDirtyCause::Unknown,","             self.execute_context(turbo_tasks),"],"additions":51,"deletions":8,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/src/backend/operation/invalidate.rs","lines":["@@ -19,19 +19,26 @@ use crate::{"," /// Invalidates `task_ids`. Callers must not pass duplicate ids (the bulk task access expects"," /// unique ids, and deduplicating here would cost every invalidation)."," pub fn invalidate(","-    task_ids: SmallVec<[TaskId; 4]>,","+    task_ids: impl IntoIterator<Item = TaskId>,","     #[cfg(feature = \"task_dirty_cause\")] cause: TaskDirtyCause,","     mut ctx: ExecuteContext<'_>,"," ) {","-    debug_assert!(","-        task_ids.len() <= 1","-            || task_ids.iter().collect::<rustc_hash::FxHashSet<_>>().len() == task_ids.len(),","-        \"invalidate() must not be called with duplicate task ids: {task_ids:?}\"","-    );","+    // Debug builds collect the ids to check they are unique. Release builds stream them.","+    #[cfg(debug_assertions)]","+    let task_ids = {","+        let task_ids: Vec<TaskId> = task_ids.into_iter().collect();","+        debug_assert!(","+            task_ids.len() <= 1","+                || task_ids.iter().collect::<rustc_hash::FxHashSet<_>>().len() == task_ids.len(),","+            \"invalidate() must not be called with duplicate task ids: {task_ids:?}\"","+        );","+        task_ids","+    };","+    let task_ids = task_ids.into_iter();","     let mut queue = AggregationUpdateQueue::new();","     // The tasks to schedule are collected and handed to the scheduler as one batch, which takes","     // the scheduler's queue lock once instead of once per task.","-    let mut to_schedule: SmallVec<[_; 4]> = SmallVec::with_capacity(task_ids.len());","+    let mut to_schedule: SmallVec<[_; 4]> = SmallVec::with_capacity(task_ids.size_hint().0);","     // Tasks that no longer exist are skipped, there is nothing to invalidate. Tasks that are not","     // resident are restored from persistent storage in batches.","     ctx.for_each_try_task_all(task_ids, \"invalidate\", |mut task, ctx| {"],"additions":14,"deletions":7,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/src/backend/operation/mod.rs","lines":["@@ -111,6 +111,10 @@ pub struct ExecuteContext<'e> {","     /// teardown in `stop()` waits for this context to be dropped.","     _shutdown_guard: Option<RwLockReadGuard<'e, bool>>,","     task_lock_counter: TaskLockCounter,","+    /// Overrides the current task priority, which is otherwise read from the task-local task","+    /// state. Set for work that runs off the calling task's thread (see","+    /// [`ExecuteContext::with_current_task_priority`]).","+    current_task_priority: Option<TaskPriority>,"," }"," "," impl<'e> ExecuteContext<'e> {","@@ -125,9 +129,18 @@ impl<'e> ExecuteContext<'e> {","             _operation_guard: backend.start_operation(),","             _shutdown_guard: None,","             task_lock_counter: TaskLockCounter::new(),","+            current_task_priority: None,","         }","     }"," ","+    /// Makes [`ExecuteContext::get_current_task_priority`] return `priority` instead of reading","+    /// it from the task-local task state. Used when the work runs on another thread than the","+    /// calling task, where that task-local is not available.","+    pub(super) fn with_current_task_priority(mut self, priority: TaskPriority) -> Self {","+        self.current_task_priority = Some(priority);","+        self","+    }","+","     /// Like [`ExecuteContext::new`], but owns the shutdown read guard that","     /// [`TurboTasksBackend::try_execute_context`] acquired, keeping `stop()` out until this","     /// context is dropped.","@@ -143,6 +156,7 @@ impl<'e> ExecuteContext<'e> {","             _operation_guard: backend.start_operation(),","             _shutdown_guard: Some(shutdown_guard),","             task_lock_counter: TaskLockCounter::new(),","+            current_task_priority: None,","         }","     }"," ","@@ -165,6 +179,7 @@ impl<'e> ExecuteContext<'e> {","             _operation_guard: None,","             _shutdown_guard: None,","             task_lock_counter: TaskLockCounter::new(),","+            current_task_priority: None,","         }","     }"," ","@@ -940,6 +955,7 @@ impl<'e> ExecuteContext<'e> {","         ChildExecuteContext {","             backend: self.backend,","             turbo_tasks: self.turbo_tasks,","+            current_task_priority: self.current_task_priority,","         }","     }"," ","@@ -1153,7 +1169,8 @@ impl<'e> ExecuteContext<'e> {","     }"," ","     pub fn get_current_task_priority(&self) -> TaskPriority {","-        self.turbo_tasks.get_current_task_priority()","+        self.current_task_priority","+            .unwrap_or_else(|| self.turbo_tasks.get_current_task_priority())","     }"," ","     /// Record `task` as a GC candidate **if it is in fact collectible**.","@@ -1228,6 +1245,7 @@ impl<'e> ExecuteContext<'e> {"," pub struct ChildExecuteContext<'e> {","     backend: &'e TurboTasksBackend,","     turbo_tasks: &'e TurboTasks<TurboTasksBackend>,","+    current_task_priority: Option<TaskPriority>,"," }"," "," impl<'e> ChildExecuteContext<'e> {","@@ -1241,6 +1259,7 @@ impl<'e> ChildExecuteContext<'e> {","             // already waits for, so it needs no shutdown guard of its own.","             _shutdown_guard: None,","             task_lock_counter: TaskLockCounter::new(),","+            current_task_priority: self.current_task_priority,","         }","     }"," }"],"additions":20,"deletions":1,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/tests/invalidate_all.rs","lines":["@@ -0,0 +1,393 @@","+#![feature(arbitrary_self_types)]","+#![allow(clippy::needless_return)] // tokio macro-generated code doesn't respect this","+","+mod util;","+","+use std::{","+    sync::{Arc, Mutex},","+    time::Duration,","+};","+","+use anyhow::Result;","+use rustc_hash::FxHashMap;","+use turbo_tasks::{","+    InvalidationReason, InvalidationReasonKind, Invalidator, ResolvedVc, State, TaskId,","+    TaskPriority, TryJoinIterExt, TurboTasks, Vc, util::StaticOrArc,","+};","+use turbo_tasks_backend::TurboTasksBackend;","+","+use crate::util::create_tt;","+","+/// The invalidators and execution counts of the `dependent` tasks of one test, keyed by","+/// `(test, index)`.","+static INVALIDATORS: Mutex<Option<FxHashMap<(u32, u32), Invalidator>>> = Mutex::new(None);","+static EXECUTIONS: Mutex<Option<FxHashMap<(u32, u32), u32>>> = Mutex::new(None);","+","+#[turbo_tasks::function]","+fn dependent(test: u32, index: u32) -> Vc<u32> {","+    let invalidator = turbo_tasks::get_invalidator().unwrap();","+    INVALIDATORS","+        .lock()","+        .unwrap()","+        .get_or_insert_default()","+        .insert((test, index), invalidator);","+    let mut executions = EXECUTIONS.lock().unwrap();","+    let count = executions","+        .get_or_insert_default()","+        .entry((test, index))","+        .or_default();","+    *count += 1;","+    Vc::cell(*count)","+}","+","+/// Sums the execution counts of `width` dependents.","+#[turbo_tasks::function(operation, root)]","+async fn root(test: u32, width: u32) -> Result<Vc<u32>> {","+    let counts = (0..width)","+        .map(|index| dependent(test, index))","+        .try_join()","+        .await?;","+    Ok(Vc::cell(counts.iter().map(|count| **count).sum()))","+}","+","+fn invalidators(test: u32, indices: impl IntoIterator<Item = u32>) -> Vec<Invalidator> {","+    let invalidators = INVALIDATORS.lock().unwrap();","+    let invalidators = invalidators.as_ref().unwrap();","+    indices","+        .into_iter()","+        .map(|index| invalidators[&(test, index)])","+        .collect()","+}","+","+fn executions(test: u32, index: u32) -> u32 {","+    EXECUTIONS.lock().unwrap().as_ref().unwrap()[&(test, index)]","+}","+","+#[derive(Clone, PartialEq, Eq, Hash)]","+struct TestReason(&'static str);","+","+impl InvalidationReason for TestReason {","+    fn kind(&self) -> Option<StaticOrArc<dyn InvalidationReasonKind>> {","+        None","+    }","+}","+","+impl std::fmt::Display for TestReason {","+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {","+        write!(f, \"test reason {}\", self.0)","+    }","+}","+","+/// A set large enough to be split into parallel chunks re-executes every task once.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+async fn invalidate_all_large_set_reexecutes_all() {","+    const TEST: u32 = 0;","+    const WIDTH: u32 = 2_000;","+    let (tt, _persistence_dir) = create_tt(\"invalidate_all_large_set_reexecutes_all\");","+    let tt2 = tt.clone();","+    let result = turbo_tasks::run_once(tt.clone(), async move {","+        assert_eq!(*root(TEST, WIDTH).read_strongly_consistent().await?, WIDTH);","+","+        Invalidator::invalidate_all(invalidators(TEST, 0..WIDTH), &*tt2);","+","+        assert_eq!(","+            *root(TEST, WIDTH).read_strongly_consistent().await?,","+            2 * WIDTH","+        );","+        for index in 0..WIDTH {","+            assert_eq!(executions(TEST, index), 2, \"dependent {index}\");","+        }","+        anyhow::Ok(())","+    })","+    .await;","+    tt.stop_and_wait().await;","+    result.unwrap();","+}","+","+/// Reads the root inside a `run_once`. The update info is only recorded once all foreground jobs","+/// (including the `run_once` itself) are done, so it must be awaited outside of it.","+async fn read_root(tt: &Arc<TurboTasks<TurboTasksBackend>>, test: u32, width: u32) -> u32 {","+    turbo_tasks::run_once(tt.clone(), async move {","+        Ok(*root(test, width).read_strongly_consistent().await?)","+    })","+    .await","+    .unwrap()","+}","+","+/// The reasons of a batch end up in the aggregated update info.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+async fn invalidate_all_with_reasons_records_reasons() {","+    const TEST: u32 = 1;","+    const WIDTH: u32 = 4;","+    let (tt, _persistence_dir) = create_tt(\"invalidate_all_with_reasons_records_reasons\");","+    assert_eq!(read_root(&tt, TEST, WIDTH).await, WIDTH);","+    // Consume the update info of the initial execution.","+    tt.get_or_wait_aggregated_update_info(Duration::ZERO).await;","+","+    Invalidator::invalidate_all_with_reason(invalidators(TEST, 0..2), &*tt, TestReason(\"one\"));","+    Invalidator::invalidate_all_with_reasons(","+        invalidators(TEST, 2..WIDTH),","+        &*tt,","+        [TestReason(\"two\"), TestReason(\"three\")],","+    );","+    assert_eq!(read_root(&tt, TEST, WIDTH).await, 2 * WIDTH);","+","+    let reasons = tt","+        .get_or_wait_aggregated_update_info(Duration::ZERO)","+        .await","+        .reasons","+        .to_string();","+    for reason in [\"one\", \"two\", \"three\"] {","+        assert!(","+            reasons.contains(&format!(\"test reason {reason}\")),","+            \"missing reason {reason:?} in {reasons:?}\"","+        );","+    }","+    tt.stop_and_wait().await;","+}","+","+/// Empty batches invalidate nothing and record no reasons.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+async fn invalidate_all_empty_is_noop() {","+    const TEST: u32 = 2;","+    const WIDTH: u32 = 2;","+    let (tt, _persistence_dir) = create_tt(\"invalidate_all_empty_is_noop\");","+    assert_eq!(read_root(&tt, TEST, WIDTH).await, WIDTH);","+    tt.get_or_wait_aggregated_update_info(Duration::ZERO).await;","+","+    Invalidator::invalidate_all([], &*tt);","+    Invalidator::invalidate_all_with_reason([], &*tt, TestReason(\"ignored\"));","+    Invalidator::invalidate_all_with_reasons([], &*tt, [TestReason(\"ignored\")]);","+    // A real invalidation, so that there is an update to report.","+    Invalidator::invalidate_all(invalidators(TEST, [0]), &*tt);","+    assert_eq!(read_root(&tt, TEST, WIDTH).await, WIDTH + 1);","+","+    let reasons = tt","+        .get_or_wait_aggregated_update_info(Duration::ZERO)","+        .await","+        .reasons","+        .to_string();","+    assert!(","+        !reasons.contains(\"ignored\"),","+        \"unexpected reasons {reasons:?}\"","+    );","+    assert_eq!(executions(TEST, 0), 2);","+    assert_eq!(executions(TEST, 1), 1);","+    tt.stop_and_wait().await;","+}","+","+/// The same invalidator passed several times in one batch invalidates its task once.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+async fn invalidate_all_deduplicates() {","+    const TEST: u32 = 3;","+    const WIDTH: u32 = 3;","+    let (tt, _persistence_dir) = create_tt(\"invalidate_all_deduplicates\");","+    let tt2 = tt.clone();","+    let result = turbo_tasks::run_once(tt.clone(), async move {","+        assert_eq!(*root(TEST, WIDTH).read_strongly_consistent().await?, WIDTH);","+","+        Invalidator::invalidate_all(invalidators(TEST, [0, 1, 0, 0, 1]), &*tt2);","+        assert_eq!(","+            *root(TEST, WIDTH).read_strongly_consistent().await?,","+            WIDTH + 2","+        );","+        assert_eq!(executions(TEST, 0), 2);","+        assert_eq!(executions(TEST, 1), 2);","+        assert_eq!(executions(TEST, 2), 1);","+        anyhow::Ok(())","+    })","+    .await;","+    tt.stop_and_wait().await;","+    result.unwrap();","+}","+","+#[turbo_tasks::value(transparent)]","+struct Input(State<u32>);","+","+#[turbo_tasks::function(operation, root)]","+fn create_input() -> Vc<Input> {","+    Input(State::new(0)).cell()","+}","+","+#[turbo_tasks::function]","+async fn state_dependent(input: ResolvedVc<Input>, index: u32) -> Result<Vc<u32>> {","+    Ok(Vc::cell(*input.await?.get() + index))","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn state_root(input: ResolvedVc<Input>, width: u32) -> Result<Vc<u32>> {","+    let values = (0..width)","+        .map(|index| state_dependent(*input, index))","+        .try_join()","+        .await?;","+    Ok(Vc::cell(values.iter().map(|value| **value).sum()))","+}","+","+/// `State::set` from inside a task with enough dependents to be invalidated in parallel chunks.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+async fn state_set_invalidates_large_fan_out() {","+    const WIDTH: u32 = 2_000;","+    let expected = |value: u32| (0..WIDTH).map(|index| value + index).sum::<u32>();","+    let (tt, _persistence_dir) = create_tt(\"state_set_invalidates_large_fan_out\");","+    let result = turbo_tasks::run_once(tt.clone(), async move {","+        let input_op = create_input();","+        let input = input_op.resolve().strongly_consistent().await?;","+        assert_eq!(","+            *state_root(input, WIDTH).read_strongly_consistent().await?,","+            expected(0)","+        );","+        input_op.read_strongly_consistent().await?.set(3);","+        assert_eq!(","+            *state_root(input, WIDTH).read_strongly_consistent().await?,","+            expected(3)","+        );","+        anyhow::Ok(())","+    })","+    .await;","+    tt.stop_and_wait().await;","+    result.unwrap();","+}","+","+/// Parallel work inside `with_turbo_tasks` (which borrows the turbo-tasks instance) doesn't try to","+/// re-enter the turbo-tasks scope on the calling thread, and every job sees the instance.","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+async fn parallel_inside_with_turbo_tasks() {","+    let (tt, _persistence_dir) = create_tt(\"parallel_inside_with_turbo_tasks\");","+    let result = turbo_tasks::run_once(tt.clone(), async move {","+        let items = (0..10_000u32).collect::<Vec<_>>();","+        let seen = std::sync::atomic::AtomicUsize::new(0);","+        turbo_tasks::with_turbo_tasks(|outer| {","+            turbo_tasks::parallel::for_each(&items, |_| {","+                let inner = turbo_tasks::turbo_tasks();","+                assert!(std::ptr::addr_eq(Arc::as_ptr(outer), Arc::as_ptr(&inner)));","+                seen.fetch_add(1, std::sync::atomic::Ordering::Relaxed);","+            });","+        });","+        assert_eq!(seen.into_inner(), items.len());","+        anyhow::Ok(())","+    })","+    .await;","+    tt.stop_and_wait().await;","+    result.unwrap();","+}","+","+static PRIORITY_INVALIDATORS: Mutex<Option<FxHashMap<u32, Invalidator>>> = Mutex::new(None);","+static PRIORITY_EXECUTIONS: Mutex<Option<FxHashMap<u32, u32>>> = Mutex::new(None);","+/// Re-executions of `priority_dependent` wait for a permit, so that they stay dirty until the test","+/// has checked their dirty priority.","+static PRIORITY_REEXECUTE: tokio::sync::Semaphore = tokio::sync::Semaphore::const_new(0);","+const PRIORITY_WIDTH: u32 = 2_000;","+","+#[turbo_tasks::function]","+async fn priority_dependent(index: u32) -> Result<Vc<u32>> {","+    let invalidator = turbo_tasks::get_invalidator().unwrap();","+    PRIORITY_INVALIDATORS","+        .lock()","+        .unwrap()","+        .get_or_insert_default()","+        .insert(index, invalidator);","+    let count = {","+        let mut executions = PRIORITY_EXECUTIONS.lock().unwrap();","+        let count = executions.get_or_insert_default().entry(index).or_default();","+        *count += 1;","+        *count","+    };","+    if count > 1 {","+        PRIORITY_REEXECUTE.acquire().await?.forget();","+    }","+    Ok(Vc::cell(count))","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn priority_root() -> Result<Vc<u32>> {","+    let counts = (0..PRIORITY_WIDTH)","+        .map(priority_dependent)","+        .try_join()","+        .await?;","+    Ok(Vc::cell(counts.iter().map(|count| **count).sum()))","+}","+","+static INVALIDATOR_TASK_EXECUTIONS: Mutex<u32> = Mutex::new(0);","+static INVALIDATOR_TASK_INVALIDATOR: Mutex<Option<Invalidator>> = Mutex::new(None);","+","+/// When re-executed (i.e. with an invalidation priority), invalidates the `priority_dependent`s","+/// (except the last one) as one batch, and the last one on its own.","+#[turbo_tasks::function(operation, root)]","+fn invalidator_task() -> Vc<u32> {","+    *INVALIDATOR_TASK_INVALIDATOR.lock().unwrap() = Some(turbo_tasks::get_invalidator().unwrap());","+    let mut executions = INVALIDATOR_TASK_EXECUTIONS.lock().unwrap();","+    *executions += 1;","+    if *executions > 1 {","+        let tt = turbo_tasks::turbo_tasks();","+        let invalidators = PRIORITY_INVALIDATORS.lock().unwrap();","+        let invalidators = invalidators.as_ref().unwrap();","+        Invalidator::invalidate_all(","+            (0..PRIORITY_WIDTH - 1).map(|index| invalidators[&index]),","+            &*tt,","+        );","+        invalidators[&(PRIORITY_WIDTH - 1)].invalidate(&*tt);"],"additions":328,"deletions":0,"truncated":false}],"additions":584,"deletions":17,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-10-22T13:44:24.215366+00:00"}