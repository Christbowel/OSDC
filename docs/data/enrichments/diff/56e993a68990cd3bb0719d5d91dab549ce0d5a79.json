{"id":"56e993a68990cd3bb0719d5d91dab549ce0d5a79","axis":"silent","repo":"vllm-project/vllm","sha":"56e993a68990cd3bb0719d5d91dab549ce0d5a79","parsed":{"files":[{"path":"tests/v1/kv_connector/unit/test_remote_prefill_lifecycle.py","lines":["@@ -36,6 +36,178 @@ def _kv_fetch_stages(scheduler) -> tuple[int, ...]:","     return tuple(scheduler._kv_fetch_counts[s] for s in KV_FETCH_STAGES)"," "," ","+def _remote_scheduler(max_num_seqs: int, max_num_inflight_kv_loads: int):","+    vllm_config = create_vllm_config(max_num_seqs=max_num_seqs)","+    vllm_config.scheduler_config.max_num_inflight_kv_loads = max_num_inflight_kv_loads","+    return create_scheduler(vllm_config), vllm_config.cache_config.block_size","+","+","+def test_inflight_kv_loads_start_while_batch_full():","+    \"\"\"With --max-num-inflight-kv-loads, loads start while the running batch is","+    full, up to the cap, and a finished load counts until its request runs.\"\"\"","+    scheduler, block_size = _remote_scheduler(","+        max_num_seqs=1, max_num_inflight_kv_loads=2","+    )","+    local = create_request(block_size=block_size, num_tokens=block_size)","+    scheduler.add_request(local)","+    scheduler_output = scheduler.schedule()","+    assert scheduler.running == [local]","+","+    remote = [","+        create_request(","+            block_size=block_size, num_tokens=block_size * 3, do_remote_prefill=True","+        )","+        for _ in range(4)","+    ]","+    for request in remote:","+        scheduler.add_request(request)","+","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler_output = scheduler.schedule()","+    assert scheduler.running == [local]","+    assert [r.status for r in remote] == [RequestStatus.WAITING_FOR_REMOTE_KVS] * 2 + [","+        RequestStatus.WAITING","+    ] * 2","+    assert list(scheduler.async_kv_waiting) == remote[2:]","+","+    # A finished load holds its blocks until its request runs.","+    scheduler.update_from_output(","+        scheduler_output,","+        create_model_runner_output([local], finished_recving={remote[0].request_id}),","+    )","+    scheduler_output = scheduler.schedule()","+    assert _kv_fetch_stages(scheduler)[1:] == (1, 1)","+    assert remote[2].status == RequestStatus.WAITING","+","+    # The freed slot goes to the finished load, which lets the next one start.","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler.finish_requests(local.request_id, RequestStatus.FINISHED_ABORTED)","+    scheduler.schedule()","+    assert scheduler.running == [remote[0]]","+    assert remote[2].status == RequestStatus.WAITING_FOR_REMOTE_KVS","+    assert list(scheduler.async_kv_waiting) == remote[3:]","+","+","+def test_early_kv_load_does_not_overtake_finished_load():","+    \"\"\"A load started while the batch is full queues behind older loads, so","+    a finished load gets the next free slot.\"\"\"","+    scheduler, block_size = _remote_scheduler(","+        max_num_seqs=1, max_num_inflight_kv_loads=2","+    )","+    local = create_request(block_size=block_size, num_tokens=block_size)","+    scheduler.add_request(local)","+    scheduler_output = scheduler.schedule()","+    older, newer = (","+        create_request(","+            block_size=block_size, num_tokens=block_size * 3, do_remote_prefill=True","+        )","+        for _ in range(2)","+    )","+    scheduler.add_request(older)","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler_output = scheduler.schedule()","+    assert older.status == RequestStatus.WAITING_FOR_REMOTE_KVS","+","+    scheduler.add_request(newer)","+    for finished in (older, newer):","+        scheduler.update_from_output(","+            scheduler_output,","+            create_model_runner_output([local], finished_recving={finished.request_id}),","+        )","+        scheduler_output = scheduler.schedule()","+    assert _kv_fetch_stages(scheduler)[1:] == (0, 2)","+","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler.finish_requests(local.request_id, RequestStatus.FINISHED_ABORTED)","+    scheduler.schedule()","+    assert scheduler.running == [older]","+","+","+def test_aborted_kv_load_counts_until_transfer_done():","+    \"\"\"An aborted load keeps its place under the cap while its transfer still","+    writes its blocks, so cancelling loading requests can't exceed the cap.\"\"\"","+    scheduler, block_size = _remote_scheduler(","+        max_num_seqs=1, max_num_inflight_kv_loads=1","+    )","+    local = create_request(block_size=block_size, num_tokens=block_size)","+    scheduler.add_request(local)","+    scheduler_output = scheduler.schedule()","+    aborted, waiting = (","+        create_request(","+            block_size=block_size, num_tokens=block_size * 3, do_remote_prefill=True","+        )","+        for _ in range(2)","+    )","+    scheduler.add_request(aborted)","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler_output = scheduler.schedule()","+    assert aborted.status == RequestStatus.WAITING_FOR_REMOTE_KVS","+","+    scheduler.finish_requests(aborted.request_id, RequestStatus.FINISHED_ABORTED)","+    scheduler.add_request(waiting)","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler_output = scheduler.schedule()","+    assert waiting.status == RequestStatus.WAITING","+","+    scheduler.update_from_output(","+        scheduler_output,","+        create_model_runner_output([local], finished_recving={aborted.request_id}),","+    )","+    scheduler.schedule()","+    assert aborted.request_id not in scheduler.requests","+    assert waiting.status == RequestStatus.WAITING_FOR_REMOTE_KVS","+","+","+def test_inflight_kv_load_cap_does_not_block_local_requests():","+    \"\"\"Async-load requests past the cap don't hold back local ones.\"\"\"","+    scheduler, block_size = _remote_scheduler(","+        max_num_seqs=2, max_num_inflight_kv_loads=1","+    )","+    remote = [","+        create_request(","+            block_size=block_size, num_tokens=block_size * 3, do_remote_prefill=True","+        )","+        for _ in range(2)","+    ]","+    local = create_request(block_size=block_size, num_tokens=block_size)","+    for request in (*remote, local):","+        scheduler.add_request(request)","+","+    scheduler.schedule()","+    assert remote[0].status == RequestStatus.WAITING_FOR_REMOTE_KVS","+    assert remote[1].status == RequestStatus.WAITING","+    assert scheduler.running == [local]","+","+","+def test_inflight_kv_loads_follow_connector_may_load_async(monkeypatch):","+    \"\"\"Only requests the connector's may_load_async flags start early loads.\"\"\"","+    scheduler, block_size = _remote_scheduler(","+        max_num_seqs=1, max_num_inflight_kv_loads=2","+    )","+    early, late = (","+        create_request(","+            block_size=block_size, num_tokens=block_size * 3, do_remote_prefill=True","+        )","+        for _ in range(2)","+    )","+    monkeypatch.setattr(","+        scheduler.connector, \"may_load_async\", lambda request: request is early","+    )","+    local = create_request(block_size=block_size, num_tokens=block_size)","+    scheduler.add_request(local)","+    scheduler_output = scheduler.schedule()","+    for request in (early, late):","+        scheduler.add_request(request)","+    assert list(scheduler.async_kv_waiting) == [early]","+    assert list(scheduler.waiting) == [late]","+","+    scheduler.update_from_output(scheduler_output, create_model_runner_output([local]))","+    scheduler.schedule()","+    assert scheduler.running == [local]","+    assert early.status == RequestStatus.WAITING_FOR_REMOTE_KVS","+    assert late.status == RequestStatus.WAITING","+","+"," def test_basic_lifecycle():","     \"\"\"Test lifecycle of a remote prefill.\"\"\"","     vllm_config = create_vllm_config()"],"additions":172,"deletions":0,"truncated":false},{"path":"tests/v1/kv_connector/unit/utils.py","lines":["@@ -76,6 +76,7 @@ def assert_scheduler_empty(scheduler: Scheduler):","     assert len(scheduler.requests) == 0","     assert len(scheduler.waiting) == 0","     assert len(scheduler.kv_holding_waiting) == 0","+    assert len(scheduler.async_kv_waiting) == 0","     assert not scheduler.deferred_waiting","     assert len(scheduler.running) == 0","     assert len(scheduler.finished_req_ids) == 0","@@ -83,6 +84,7 @@ def assert_scheduler_empty(scheduler: Scheduler):","     assert len(scheduler._inflight_prefills) == 0","     assert not scheduler._kv_fetch_stages","     assert not any(scheduler._kv_fetch_counts.values())","+    assert not scheduler._aborted_kv_loads"," ","     # EncoderCacheManager.","     assert len(scheduler.encoder_cache_manager.freed) == 0"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/v1/kv_offload/tiering/p2p/test_manager.py","lines":["@@ -1192,6 +1192,7 @@ def test_B2_idle_manager_does_not_keep_engine_busy(self):","             scheduler.running = []","             scheduler.waiting = []","             scheduler.kv_holding_waiting = []","+            scheduler.async_kv_waiting = []","             scheduler.num_waiting_for_streaming_input = 0","             scheduler.finished_req_ids = set()","             scheduler.requests = {}","@@ -1249,6 +1250,7 @@ def test_B2_no_poll_thread_keeps_engine_busy(self):","             scheduler.running = []","             scheduler.waiting = []","             scheduler.kv_holding_waiting = []","+            scheduler.async_kv_waiting = []","             scheduler.num_waiting_for_streaming_input = 0","             scheduler.finished_req_ids = set()","             scheduler.requests = {}"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/config/scheduler.py","lines":["@@ -76,6 +76,18 @@ class SchedulerConfig:","     be ``<= max_num_seqs``. ``None`` (default) keeps current behavior.","     \"\"\""," ","+    max_num_inflight_kv_loads: int | None = Field(default=None, ge=1)","+    \"\"\"Maximum number of requests holding KV blocks for an async KV connector","+    load (e.g. a P/D NIXL pull) before they run: loads in progress, or finished","+    and waiting for a running slot.","+","+    Setting it also lets requests the connector may load asynchronously","+    (``KVConnectorBase_V1.may_load_async``, by default P/D remote-prefill","+    requests) start their loads while the running batch is full, so they are","+    ready when a slot frees. ``None`` (default) keeps current behavior: no cap,","+    and loads start only when a running slot is free.","+    \"\"\"","+","     long_prefill_token_threshold: int = Field(default=0, ge=0)","     \"\"\"For chunked prefill, a request is considered long if the prompt is","     longer than this number of tokens. 0 disables the cap (default)."],"additions":12,"deletions":0,"truncated":false},{"path":"vllm/distributed/kv_transfer/kv_connector/v1/base.py","lines":["@@ -625,6 +625,18 @@ def on_new_request(self, request: \"Request\") -> None:","         \"\"\"","         return"," ","+    def may_load_async(self, request: \"Request\") -> bool:","+        \"\"\"Whether ``get_num_new_matched_tokens`` may return","+        ``load_kv_async=True`` for this request. With --max-num-inflight-kv-loads,","+        such requests can start loading while the running batch is full.","+","+        Called whenever the request enters the waiting queues, so must be cheap.","+        A false positive holds back other async loads until a slot is free.","+        Defaults to the P/D ``do_remote_prefill`` flag.","+        \"\"\"","+        params = request.kv_transfer_params","+        return bool(params and params.get(\"do_remote_prefill\"))","+","     def update_connector_output(self, connector_output: KVConnectorOutput):","         \"\"\"Update KVConnector state from worker-side connectors output."," "],"additions":12,"deletions":0,"truncated":false},{"path":"vllm/distributed/kv_transfer/kv_connector/v1/multi_connector.py","lines":["@@ -515,6 +515,9 @@ def on_new_request(self, request: \"Request\") -> None:","         for c in self._connectors:","             c.on_new_request(request)"," ","+    def may_load_async(self, request: \"Request\") -> bool:","+        return any(c.may_load_async(request) for c in self._connectors)","+","     def build_connector_meta(","         self, scheduler_output: SchedulerOutput","     ) -> MultiKVConnectorMetadata:"],"additions":3,"deletions":0,"truncated":false},{"path":"vllm/engine/arg_utils.py","lines":["@@ -621,6 +621,7 @@ class EngineArgs:","     )","     max_num_seqs: int | None = None","     max_num_active_seqs: int | None = SchedulerConfig.max_num_active_seqs","+    max_num_inflight_kv_loads: int | None = SchedulerConfig.max_num_inflight_kv_loads","     max_num_queued_reqs: int | None = None","     max_num_queued_tokens: int | None = None","     max_logprobs: int = ModelConfig.max_logprobs","@@ -1770,6 +1771,10 @@ def add_cli_args(parser: FlexibleArgumentParser) -> FlexibleArgumentParser:","             \"--max-num-active-seqs\",","             **scheduler_kwargs[\"max_num_active_seqs\"],","         )","+        scheduler_group.add_argument(","+            \"--max-num-inflight-kv-loads\",","+            **scheduler_kwargs[\"max_num_inflight_kv_loads\"],","+        )","         scheduler_group.add_argument(","             \"--max-num-queued-reqs\", **scheduler_kwargs[\"max_num_queued_reqs\"]","         )","@@ -2672,6 +2677,7 @@ def create_engine_config(","             max_num_scheduled_tokens=self.max_num_scheduled_tokens,","             max_num_seqs=self.max_num_seqs,","             max_num_active_seqs=self.max_num_active_seqs,","+            max_num_inflight_kv_loads=self.max_num_inflight_kv_loads,","             max_num_queued_reqs=self.max_num_queued_reqs,","             max_num_queued_tokens=self.max_num_