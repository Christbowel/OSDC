{"id":"02ed6dc75a0bcf4a0d9ff2824f223e0fb7031420","axis":"silent","repo":"vllm-project/vllm","sha":"02ed6dc75a0bcf4a0d9ff2824f223e0fb7031420","parsed":{"files":[{"path":"docs/serving/online_serving/openai_compatible_server.md","lines":["@@ -123,8 +123,11 @@ The `X-Request-Id` HTTP request header can be enabled with"," "," The Completions, Chat Completions, and Responses APIs also support the"," `X-Vllm-Priority` request header. Its value must be an integer and overrides","-the `priority` value in the JSON request body. Non-zero priorities require the","-server to use priority scheduling.","+the `priority` value in the JSON request body. The header and the body","+`priority` share the range `[-2**31, 2**31 - 1]`, and a body `priority` outside","+it is rejected. The Python frontend also rejects a header value outside it; the","+Rust frontend ignores such a header value and uses the body `priority`.","+Non-zero priorities require the server to use priority scheduling."," "," ```python"," completion = client.chat.completions.create("],"additions":5,"deletions":2,"truncated":false},{"path":"docs/serving/online_serving/token_in_token_out.md","lines":["@@ -47,6 +47,10 @@ The top level adds `request_id`, `usage`, `prompt_token_ids` and `prompt_logprob"," "," Send the header `X-data-parallel-rank: <int>` to pin a request to one data-parallel (DP) engine rank; there is no body field. Without the header, or with a non-integer value, the request is load balanced. A rank outside `[0, data_parallel_size)` is rejected."," ","+## Request priority (`X-Vllm-Priority`)","+","+Send the header `X-Vllm-Priority: <int>` to set the request's priority. It overrides the body `priority`; a non-integer value is ignored. A header value or body `priority` outside `[-2**31, 2**31 - 1]` is rejected. Non-zero priorities require the server to use priority scheduling (`--scheduling-policy priority`). The Rust frontend does not read the header on this endpoint and uses only the body `priority`.","+"," ## Output modes"," "," The request field `output_mode` selects how much of the postprocessing the server does for the caller."],"additions":4,"deletions":0,"truncated":false},{"path":"tests/entrypoints/scale_out/token_in_token_out/test_serving_tokens.py","lines":["@@ -1,6 +1,7 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+import asyncio"," import io"," import json"," ","@@ -9,6 +10,7 @@"," import pybase64 as base64"," import pytest"," import pytest_asyncio","+from prometheus_client.parser import text_string_to_metric_families"," from transformers import AutoTokenizer"," "," import vllm.envs as envs","@@ -925,6 +927,96 @@ async def test_abort_requests_is_served_without_tokens_only(client):","     assert resp.status_code == 404"," "," ","+async def _wait_for_gauge(client, name: str, value: float) -> None:","+    while True:","+        resp = await client.get(\"/metrics\")","+        resp.raise_for_status()","+        total = sum(","+            sample.value","+            for family in text_string_to_metric_families(resp.text)","+            for sample in family.samples","+            if sample.name == name","+        )","+        if total == value:","+            return","+        await asyncio.sleep(0.05)","+","+","+@pytest.mark.asyncio","+@pytest.mark.skipif(","+    envs.VLLM_USE_RUST_FRONTEND,","+    reason=\"the Rust frontend does not read X-Vllm-Priority on this endpoint\",","+)","+@pytest.mark.parametrize(","+    \"server\",","+    [[\"--scheduling-policy\", \"priority\", \"--max-num-seqs\", \"1\"]],","+    indirect=True,","+)","+async def test_generate_priority_header_overrides_body(client):","+    \"\"\"`X-Vllm-Priority` overrides the body priority, as on the coupled APIs.\"\"\"","+    finished = []","+","+    async def generate(name, max_tokens, priority=0, headers=None):","+        payload = {","+            \"model\": MODEL_NAME,","+            \"token_ids\": [1, 2, 3],","+            \"sampling_params\": {","+                \"max_tokens\": max_tokens,","+                \"ignore_eos\": True,","+                \"temperature\": 0,","+            },","+            \"priority\": priority,","+        }","+        resp = await client.post(GEN_ENDPOINT, json=payload, headers=headers)","+        resp.raise_for_status()","+        finished.append(name)","+","+    # One sequence runs at a time, so the two short requests wait behind the","+    # long one and leave the queue in priority order.","+    long = asyncio.create_task(generate(\"long\", 900))","+    await asyncio.wait_for(","+        _wait_for_gauge(client, \"vllm:num_requests_running\", 1), timeout=60","+    )","+    queued = [","+        asyncio.create_task(generate(\"body\", 5)),","+        asyncio.create_task(","+            generate(\"header\", 5, priority=1, headers={\"X-Vllm-Priority\": \"-1\"})","+        ),","+    ]","+    await asyncio.wait_for(","+        _wait_for_gauge(client, \"vllm:num_requests_waiting\", 2), timeout=60","+    )","+    await asyncio.gather(long, *queued)","+","+    assert finished == [\"long\", \"header\", \"body\"]","+","+","+@pytest.mark.asyncio","+@pytest.mark.skipif(","+    envs.VLLM_USE_RUST_FRONTEND,","+    reason=\"the Rust frontend does not read X-Vllm-Priority on this endpoint\",","+)","+@pytest.mark.parametrize(","+    \"server\",","+    [[\"--scheduling-policy\", \"priority\", \"--max-num-seqs\", \"1\"]],","+    indirect=True,","+)","+async def test_generate_priority_is_bounded_to_int32(client):","+    \"\"\"A priority outside int32 is rejected with a 400, in the header or the body.\"\"\"","+    payload = {","+        \"model\": MODEL_NAME,","+        \"token_ids\": [1, 2, 3],","+        \"sampling_params\": {\"max_tokens\": 1},","+    }","+    for priority, expected in ((2**31 - 1, 200), (2**31, 400)):","+        resp = await client.post(","+            GEN_ENDPOINT, json=payload, headers={\"X-Vllm-Priority\": str(priority)}","+        )","+        assert resp.status_code == expected, f\"header {priority}: {resp.text}\"","+        resp = await client.post(GEN_ENDPOINT, json={**payload, \"priority\": priority})","+        assert resp.status_code == expected, f\"body {priority}: {resp.text}\"","+","+"," @pytest.mark.asyncio"," @pytest.mark.skipif(","     envs.VLLM_USE_RUST_FRONTEND,"],"additions":92,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/generate/base/protocol.py","lines":["@@ -35,6 +35,11 @@"," "," MMPayload: TypeAlias = Literal[\"tensors\", \"none\"]"," ","+# Range of a request priority, in the body or the `X-Vllm-Priority` header:","+# int32, the type of `priority` in the Rust frontend.","+PRIORITY_MIN = -(2**31)","+PRIORITY_MAX = 2**31 - 1","+"," _CACHE_SALT_FORBIDDEN_CHARS = frozenset(\"@/\\\\\\x00\")"," _MAX_CACHE_SALT_LENGTH = 128"," "],"additions":5,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/generate/base/serving.py","lines":["@@ -10,6 +10,8 @@"," from vllm import RequestOutput"," from vllm.engine.protocol import EngineClient"," from vllm.entrypoints.generate.base.protocol import (","+    PRIORITY_MAX,","+    PRIORITY_MIN,","     PerRequestMetrics,","     SpeculativeDecodingMetrics,"," )","@@ -18,10 +20,11 @@"," from vllm.entrypoints.openai.completion.protocol import CompletionRequest"," from vllm.entrypoints.openai.models.serving import OpenAIServingModels"," from vllm.entrypoints.openai.responses.protocol import ResponsesRequest","+from vllm.entrypoints.scale_out.token_in_token_out.protocol import GenerateRequest"," from vllm.entrypoints.serve.engine.protocol import ErrorResponse"," from vllm.entrypoints.serve.engine.serving import BaseServing"," from vllm.entrypoints.serve.utils.request_logger import RequestLogger","-from vllm.exceptions import GenerationError","+from vllm.exceptions import GenerationError, VLLMValidationError"," from vllm.logger import init_logger"," from vllm.logprobs import Logprob, PromptLogprobs"," from vllm.tokenizers import TokenizerLike","@