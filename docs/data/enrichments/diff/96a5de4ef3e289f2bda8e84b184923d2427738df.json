{"id":"96a5de4ef3e289f2bda8e84b184923d2427738df","axis":"silent","repo":"pnpm/pnpm","sha":"96a5de4ef3e289f2bda8e84b184923d2427738df","parsed":{"files":[{"path":".changeset/pnpr-oci-replay-invalidation.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Deleting an OCI manifest by digest now invalidates the saved batch publish outcomes that include it. Deleting an OCI tag leaves batch replay intact. A deleted OCI manifest can be published again."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/atomic.rs","lines":["@@ -6,7 +6,8 @@"," //! The request's outcome commits with it. A retry of the same request by the"," //! same principal gets that outcome back instead of a conflict, whether or not"," //! the client sent an idempotency key: without one, the digest of the whole","-//! request is the key. Unpublishing an npm version invalidates its outcome.","+//! request is the key. Unpublishing an npm version or deleting an OCI manifest","+//! by digest invalidates its outcome."," //! A retry is authorized against current permissions"," //! like any publish before its outcome is looked up."," "],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/tests/oci_registry/manifests.rs","lines":["@@ -504,6 +504,145 @@ async fn batch_publishes_an_oci_manifest_and_rolls_back_on_invalid_siblings() {","     assert_eq!(get(&app, \"/v2/acme/app/manifests/release\").await.status(), StatusCode::OK);"," }"," ","+#[tokio::test]","+async fn batch_publish_replay_tracks_oci_manifest_deletion_and_republish() {","+    use base64::{Engine as _, engine::general_purpose::STANDARD};","+    let tmp = TempDir::new().unwrap();","+    let app = app_allowing_deletes(&tmp);","+    let auth = basic(&token(&app).await);","+    push_blob(&app, &auth, \"acme/app\", b\"config\").await;","+    push_blob(&app, &auth, \"acme/app\", b\"kept-config\").await;","+    let manifest = image_manifest(\"config\", &[]);","+    let digest = digest_of(&manifest);","+    let kept_manifest = image_manifest(\"kept-config\", &[]);","+    let entry = json!({","+        \"ecosystem\": \"oci\",","+        \"name\": \"acme/app\",","+        \"reference\": \"1.0\",","+        \"manifest\": STANDARD.encode(&manifest),","+    });","+    let kept_entry = json!({","+        \"ecosystem\": \"oci\",","+        \"name\": \"acme/app\",","+        \"reference\": \"kept\",","+        \"manifest\": STANDARD.encode(&kept_manifest),","+    });","+    let named = json!({ \"name\": \"oci-release-1\", \"packages\": [entry.clone()] });","+    let kept = json!({ \"name\": \"oci-release-kept\", \"packages\": [kept_entry] });","+    let publish = |body: &Value, key: &str| {","+        let app = app.clone();","+        let auth = auth.clone();","+        let payload = body.to_string();","+        let key = key.to_string();","+        async move {","+            let response = app","+                .oneshot(","+                    Request::put(\"/-/pnpr/v0/publish\")","+                        .header(header::AUTHORIZATION, &auth)","+                        .header(header::CONTENT_TYPE, \"application/json\")","+                        .header(\"Idempotency-Key\", &key)","+                        .body(Body::from(payload))","+                        .unwrap(),","+                )","+                .await","+                .unwrap();","+            let status = response.status();","+            let bytes = body_bytes(response.into_body()).await;","+            let body = serde_json::from_slice(&bytes)","+                .unwrap_or_else(|_| Value::String(String::from_utf8_lossy(&bytes).into_owned()));","+            (status, body)","+        }","+    };","+","+    let (status, first) = publish(&named, \"k1\").await;","+    assert_eq!((status, &first[\"publication\"]), (StatusCode::CREATED, &json!(1)));","+    let (status, kept_first) = publish(&kept, \"k-kept\").await;","+    assert_eq!((status, &kept_first[\"publication\"]), (StatusCode::CREATED, &json!(2)));","+","+    // Deleting only the tag keeps the manifest, so an identical retry still","+    // replays the recorded outcome without recreating the deleted tag.","+    let delete_tag = app","+        .clone()","+        .oneshot(","+            Request::delete(\"/v2/acme/app/manifests/1.0\")","+                .header(header::AUTHORIZATION, &auth)","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(delete_tag.status(), StatusCode::ACCEPTED);","+    let (status, replayed) = publish(&named, \"k1\").await;","+    assert_eq!((status, &replayed[\"publication\"]), (StatusCode::CREATED, &json!(1)));","+    assert_eq!(get(&app, \"/v2/acme/app/manifests/1.0\").await.status(), StatusCode::NOT_FOUND);","+    assert_eq!(","+        get(&app, &format!(\"/v2/acme/app/manifests/{digest}\")).await.status(),","+        StatusCode::OK,","+    );","+","+    // Deleting the manifest by digest invalidates only its recorded outcome:","+    // an identical retry of the named batch is evaluated again, fails on the","+    // taken publication name, and leaves the manifest deleted, while another","+    // manifest in the same repository still replays its outcome.","+    let delete_manifest = app","+        .clone()","+        .oneshot(","+            Request::delete(format!(\"/v2/acme/app/manifests/{digest}\"))","+                .header(header::AUTHORIZATION, &auth)","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(delete_manifest.status(), StatusCode::ACCEPTED);","+    let (status, conflict) = publish(&named, \"k1\").await;","+    assert_eq!(status, StatusCode::CONFLICT, \"{conflict}\");","+    assert_eq!(","+        get(&app, &format!(\"/v2/acme/app/manifests/{digest}\")).await.status(),","+        StatusCode::NOT_FOUND,","+    );","+    let (status, kept_replayed) = publish(&kept, \"k-kept\").await;","+    assert_eq!((status, &kept_replayed[\"publication\"]), (StatusCode::CREATED, &json!(2)));","+","+    // A later valid republish of the deleted manifest succeeds, records a new","+    // replayable outcome, and is invalidated again if the manifest is deleted","+    // by digest a second time.","+    let unnamed = json!({ \"packages\": [entry] });","+    let (status, republished) = publish(&unnamed, \"k2\").await;","+    assert_eq!(status, StatusCode::CREATED, \"{republished}\");","+    let second_publication = republished[\"publication\"].as_u64().unwrap();","+    assert!(second_publication > 1);","+    assert_eq!(get(&app, \"/v2/acme/app/manifests/1.0\").await.status(), StatusCode::OK);","+    assert_eq!(","+        get(&app, &format!(\"/v2/acme/app/manifests/{digest}\")).await.status(),","+        StatusCode::OK,","+    );","+    let (status, replayed_second) = publish(&unnamed, \"k2\").await;","+    assert_eq!(","+        (status, replayed_second[\"publication\"].as_u64()),","+        (StatusCode::CREATED, Some(second_publication)),","+    );","+","+    let delete_again = app","+        .clone()","+        .oneshot(","+            Request::delete(format!(\"/v2/acme/app/manifests/{digest}\"))","+                .header(header::AUTHORIZATION, &auth)","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(delete_again.status(), StatusCode::ACCEPTED);","+    let (status, republished_again) = publish(&unnamed, \"k2\").await;","+    assert_eq!(status, StatusCode::CREATED, \"{republished_again}\");","+    assert!(republished_again[\"publication\"].as_u64().unwrap() > second_publication);","+    assert_eq!(","+        get(&app, &format!(\"/v2/acme/app/manifests/{digest}\")).await.status(),","+        StatusCode::OK,","+    );","+}","+"," #[tokio::test]"," async fn cold_manifest_head_forwards_headers_without_getting_or_caching_a_body() {","     for cache in [tr