{"id":"c2cc003c5b644095cabcd5212d2967546ce344f8","axis":"silent","repo":"vllm-project/vllm","sha":"c2cc003c5b644095cabcd5212d2967546ce344f8","parsed":{"files":[{"path":"docs/features/disagg_encoder.md","lines":["@@ -95,7 +95,38 @@ see [Cross-encoder output reuse](cross_encoder_cache.md)."," "," Please refer to the directories `tests/v1/ec_connector`"," ","-## 4  Development","+## 4  Encoder cache events","+","+Encoder cache (EC) events mirror [KV cache events](kv_offloading_usage.md) so a","+router or cache-aware orchestrator can tell which instances already hold the","+encoder output for a given multimodal input. Events are keyed by the multimodal","+hash (`mm_hash`) and use the same ZMQ publisher and replay buffer as KV events.","+","+Enable them on the scheduler with `--ec-events-config`:","+","+```bash","+vllm serve <model> \\","+  --ec-events-config '{\"enable_ec_cache_events\": true, \"publisher\": \"zmq\", \"topic\": \"ec-events\"}'","+```","+","+The default endpoint is `tcp://*:6558`. Like KV events, the port is shifted up","+by the data-parallel rank; the block starts 1000 ports above the 5557/5558 KV","+events block, so both streams can be enabled at once on hosts with up to 1000","+DP ranks without an explicit `endpoint`.","+","+The event types are `ECStored(mm_hashes, medium)`, `ECRemoved(mm_hashes,","+medium)` and `AllECCleared()`, delivered in an `ECEventBatch`. The GPUs of the","+scheduler's own encoder cache report `medium=\"GPU\"`; a connector that offloads","+encoder outputs adds its own events through `ECConnectorBase.take_events()`.","+Local GPU cache events are published even when no EC connector is configured.","+","+Events are off by default and use the `null` publisher when disabled. Subscribe","+the same way as for KV events, decoding `ECEventBatch` from","+`vllm.distributed.ec_transfer.ec_events`; see","+[kv_events_subscriber.py](../../examples/features/kv_events/kv_events_subscriber.py)","+for the ZMQ client loop.","+","+## 5  Development"," "," Disaggregated encoding is implemented by running two parts:"," "],"additions":32,"deletions":1,"truncated":false},{"path":"tests/distributed/test_events.py","lines":["@@ -9,6 +9,7 @@"," from vllm.distributed.kv_events import (","     EventBatch,","     EventPublisherFactory,","+    KVEventBatch,","     NullEventPublisher,","     ZmqEventPublisher,"," )","@@ -376,6 +377,144 @@ def test_event_publisher_factory(random_port):","     publisher.shutdown()"," "," ","+def test_ec_event_publisher_factory(random_port):","+    \"\"\"EC events use the same publisher plumbing as KV events.\"\"\"","+    from vllm.config.ec_events import ECEventsConfig","+","+    # Disabled by default, even when a publisher is requested.","+    config = ECEventsConfig(publisher=\"zmq\")","+    publisher = EventPublisherFactory.create(config, DP_RANK)","+    assert isinstance(publisher, NullEventPublisher)","+    publisher.shutdown()","+","+    # A default config also resolves to the null publisher.","+    publisher = EventPublisherFactory.create(ECEventsConfig(), DP_RANK)","+    assert isinstance(publisher, NullEventPublisher)","+    publisher.shutdown()","+","+    config = ECEventsConfig(","+        enable_ec_cache_events=True,","+        endpoint=f\"tcp://*:{random_port}\",","+        replay_endpoint=f\"tcp://*:{random_port + 100}\",","+    )","+    publisher = EventPublisherFactory.create(config, DP_RANK + 1)","+    assert isinstance(publisher, ZmqEventPublisher)","+    resolved_config = publisher.get_publisher_config()","+    assert isinstance(resolved_config, ECEventsConfig)","+    assert resolved_config.endpoint == f\"tcp://*:{random_port + 1}\"","+    assert resolved_config.replay_endpoint == f\"tcp://*:{random_port + 101}\"","+    assert config.endpoint == f\"tcp://*:{random_port}\"","+    publisher.shutdown()","+","+","+def test_ec_event_batch_roundtrip():","+    \"\"\"EC events survive msgpack encode/decode like KV events do.\"\"\"","+    from vllm.distributed.ec_transfer.ec_events import (","+        AllECCleared,","+        ECEventBatch,","+        ECRemoved,","+        ECStored,","+    )","+","+    events = [","+        ECStored(mm_hashes=[\"mm-a\", \"mm-b\"], medium=\"GPU\"),","+        ECRemoved(mm_hashes=[\"mm-c\"], medium=\"CPU\"),","+        AllECCleared(),","+    ]","+    batch = ECEventBatch(ts=123.0, events=events)","+","+    decoded = msgspec.msgpack.decode(msgspec.msgpack.encode(batch), type=ECEventBatch)","+","+    assert decoded.ts == 123.0","+    assert decoded.events == events","+","+","+def test_default_endpoints_do_not_collide_across_dp_ranks():","+    \"\"\"KV ranks shift 5557/5558 up by rank; EC must stay outside that block.\"\"\"","+    from vllm.config.ec_events import ECEventsConfig","+    from vllm.config.kv_events import KVEventsConfig","+    from vllm.distributed.kv_events import ZmqEventPublisher","+","+    kv_config = KVEventsConfig(","+        enable_kv_cache_events=True, replay_endpoint=\"tcp://*:5558\"","+    )","+    ec_config = ECEventsConfig(enable_ec_cache_events=True)","+","+    assert kv_config.publisher == ec_config.publisher == \"zmq\"","+","+    def bound_ports(config, ranks):","+        ports = set()","+        for rank in ranks:","+            for endpoint in (config.endpoint, config.replay_endpoint):","+                offset = ZmqEventPublisher.offset_endpoint_port(endpoint, rank)","+                if offset is not None:","+                    ports.add(int(offset.rsplit(\":\", 1)[1]))","+        return ports","+","+    kv_ports = bound_ports(kv_config, range(1000))","+    ec_ports = bound_ports(ec_config, range(1000))","+    assert kv_ports.isdisjoint(ec_ports)","+","+","+def test_kv_and_ec_event_streams_run_together_across_dp_ranks(random_port):","+    \"\"\"Every DP rank of both streams binds its own port and decodes its own","+    batch type, with no cross-talk between the two streams.\"\"\"","+    from vllm.config.ec_events import ECEventsConfig","+    from vllm.config.kv_events import KVEventsConfig","+    from vllm.distributed.ec_transfer.ec_events import AllECCleared, ECEventBatch","+","+    from .conftest import MockSubscriber","+","+    ranks = list(range(3))","+    # Mirror the defaults: EC sits one 1000-port block above KV.","+    kv_config = KVEventsConfig(","+        enable_kv_cache_events=True,","+        endpoint=f\"tcp://*:{random_port}\",","+        replay_endpoint=None,","+        topic=\"kv\",","+    )","+    ec_config = ECEventsConfig(","+        enable_ec_cache_events=True,","+        endpoint=f\"tcp://*:{random_port + 1000}\",","+        replay_endpoint=None,","+        topic=\"ec\",","+    )","+    kv_pubs = [EventPublisherFactory.create(kv_config, rank) for rank in ranks]","+    ec_pubs = [EventPublisherFactory.create(ec_config, rank) for rank in ranks]","+    kv_sub = MockSubscriber(","+        [f\"tcp://127.0.0.1:{random_port + rank}\" for rank in ranks], None, \"kv\"","+    )","+    ec_sub = MockSubscriber(","+        [f\"tcp://127.0.0.1:{random_port + 1000 + rank}\" for rank in ranks],","+        None,","+        \"ec\",","+        decode_type=ECEventBatch,","+    )","+    try:","+        time.sleep(0.1)","+        kv_ranks: set[int] = set()","+        ec_ranks: set[int] = set()","+        deadline = time.time() + 10","+        while (","+            kv_ranks != set(ranks) or ec_ranks != set(ranks)","+        ) and time.time() < deadline:","+            for rank, kv_pub, ec_pub in zip(ranks, kv_pubs, ec_pubs):","+                kv_pub.publish(KVEventBatch(ts=float(rank), events=[]))","+                ec_pub.publish(ECEventBatch(ts=float(rank), events=[AllECCleared()]))","+            while (result := kv_sub.receive_one(timeout=100)) is not None:","+                kv_ranks.add(result[1].data_parallel_rank)","+            while (result := ec_sub.receive_one(timeout=100)) is not None:","+                ec_ranks.add(result[1].data_parallel_rank)","+","+        assert kv_ranks == set(ranks)","+        assert ec_ranks == set(ranks)","+    finally:","+        for pub in kv_pubs + ec_pubs:","+            pub.shutdown()","+        kv_sub.close()","+        ec_sub.close()","+","+"," @pytest.mark.parametrize(","     (\"endpoint\", \"expected\"),","     [(\"tcp://*:5557\", \"tcp://*:5558\"), (\"tcp://*:0\", \"tcp://*:0\")],"],"additions":139,"deletions":0,"truncated":false},{"path":"tests/v1/core/test_encoder_cache_manager.py","lines":["@@ -1,8 +1,16 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+from types import SimpleNamespace","+"," import pytest"," import torch"," ","+from vllm.config import ECEventsConfig","+from vllm.distributed.ec_transfer.ec_events import (","+    AllECCleared,","+    ECRemoved,","+    ECStored,","+)"," from vllm.multimodal.inputs import MultiModalFeatureSpec, PlaceholderRange"," from vllm.v1.core.encoder_cache_manager import (","     EncoderCacheManager,","@@ -567,3 +575,72 @@ def test_capacity_decides_whether_reuse_survives_another_request():","     tight.allocate(req_b, 0)","     tight.free_encoder_input(req_b, 0)","     assert not tight.check_and_update_cache(req_a_again, 0)","+","+","+def test_events_disabled_by_default():","+    manager = EncoderCacheManager(cache_size=10)","+    req = MockRequest(\"req1\", [\"img1\"], [4])","+","+    assert manager.can_allocate(req, 0, int(1e9), 0)","+    manager.allocate(req, 0)","+","+    assert manager.take_events() == []","+","+","+def test_events_report_gpu_store_and_eviction():","+    manager = EncoderCacheManager(cache_size=4, enable_events=True)","+    req = MockRequest(\"req1\", [\"img1\"], [4])","+","+    assert manager.can_allocate(req, 0, int(1e9), 0)","+    manager.allocate(req, 0)","+","+    assert manager.take_events() == [ECStored(mm_hashes=[\"img1\"], medium=\"GPU\")]","+    assert manager.take_events() == []","+","+    # Drop the only reference so the entry becomes reclaimable.","+    manager.free_encoder_input(req, 0)","+    assert not manager.cached[\"img1\"]","+","+    # No free slot is left, so allocating evicts \"img1\" first.","+    req2 = MockRequest(\"req2\", [\"img2\"], [4])","+    assert manager.can_allocate(req2, 0, int(1e9), 0)","+    manager.allocate(req2, 0)","+","+    assert manager.take_events() == [","+        ECRemoved(mm_hashes=[\"img1\"], medium=\"GPU\"),","+        ECStored(mm_hashes=[\"img2\"], medium=\"GPU\"),","+    ]","+","+","+def test_events_report_full_clear():","+    manager = EncoderCacheManager(cache_size=10, enable_events=True)","+    req = MockRequest(\"req1\", [\"img1\"], [4])","+","+    assert manager.can_allocate(req, 0, int(1e9), 0)","+    manager.allocate(req, 0)","+","+    manager.reset()","+","+    assert manager.take_events() == [AllECCleared()]","+","+","+class LegacyCacheManager(EncoderCacheManager):","+    \"\"\"A custom manager whose constructor only accepts `cache_size`.\"\"\"","+","+    def __init__(self, cache_size: int):","+        super().__init__(cache_size=cache_size)","+","+","+@pytest.mark.parametrize(\"enable_events\", [True, False])","+def test_create_manager_keeps_custom_constructor_compatible(enable_events):","+    vllm_config = SimpleNamespace(","+        ec_events_config=ECEventsConfig(enable_ec_cache_events=enable_events)","+    )","+","+    manager = LegacyCacheManager.create_manager(cache_size=4, vllm_config=vllm_config)","+    req = MockRequest(\"req1\", [\"img1\"], [4])","+    assert manager.can_allocate(req, 0, int(1e9), 0)","+    manager.allocate(req, 0)","+","+    expected = [ECStored(mm_hashes=[\"img1\"], medium=\"GPU\")] if enable_events else []","+    assert manager.take_events() == expected"],"additions":77,"deletions":0,"truncated":false},{"path":"tests/v1/core/test_scheduler.py","lines":["@@ -33,6 +33,7 @@"," )"," from vllm.distributed.ec_transfer.ec_connector.metrics import ECConnectorStats"," from vllm.distributed.ec_transfer.ec_connector.utils import PlaceholderMetadataResolver","+from vllm.distributed.ec_transfer.ec_events import AllECCleared, ECRemoved, ECStored"," from vllm.distributed.kv_transfer.kv_connector.v1.example_connector import (","     ExampleConnectorMetadata,"," )","@@ -7292,6 +7293,7 @@ def is_empty(self) -> bool:","         )","         scheduler.ec_connector = Mock()","         scheduler.ec_connector.take_unavailable_requests.return_value = set()","+        scheduler.ec_connector.take_events.return_value = ()","         scheduler.ec_connector.get_ec_connector_stats.return_value = (","             scheduler_stats if worker_stats is None else None","         )","@@ -7829,6 +7831,7 @@ def test_unavailable_encoder_input_fails_the_request_as_retryable():","     scheduler.ec_connector.take_unavailable_requests.return_value = {request.request_id}","     # `request_finished` reports (delay_free, params) for the request teardown.","     scheduler.ec_connector.request_finished.return_value = (False, None)","+    scheduler.ec_connector.take_events.return_value = ()"," ","     scheduler_output = scheduler.schedule()","     outputs = scheduler.update_from_output(","@@ -9671,3 +9674,103 @@ def test_cpu_encoder_input_updates_preserve_shm_handles():","     )","     assert scheduler.schedule().encoder_input_updates == {request.request_id: {1: None}}","     assert request.mm_features[0].data is handle","+","+","+def test_reset_encoder_cache_publishes_clear_event_while_idle():","+    \"\"\"An idle engine must publish `AllECCleared` on reset.","+","+    `update_from_output` is the only place that normally drains EC events, and","+    it never runs while the engine is idle, so the reset has to flush its own.","+    \"\"\"","+    scheduler = create_scheduler()","+    scheduler.encoder_cache_manager = EncoderCacheManager(","+        cache_size=100, enable_events=True","+    )","+    publisher = Mock()","+    scheduler.ec_event_publisher = publisher","+","+    scheduler.reset_encoder_cache()","+","+    publisher.publish.assert_called_once()","+    batch = publisher.publish.call_args.args[0]","+    assert batch.events == [AllECCleared()]","+","+","+def test_ec_store_events_published_with_the_step_that_creates_them():","+    \"\"\"A step's `ECStored` must not be advertised with an earlier step's output.","+","+    Async scheduling runs `schedule()` for the next step before the current","+    step's output arrives, so publishing whatever the cache manager queued would","+    advertise embeddings that are not cached yet.","+    \"\"\"","+    scheduler = create_scheduler(","+        model=\"llava-hf/llava-1.5-7b-hf\",","+        max_num_batched_tokens=1024,","+        max_model_len=2048,","+        encoder_cache_size=2048,","+    )","+    scheduler.encoder_cache_manager.enable_events = True","+    publisher = Mock()","+    scheduler.ec_event_publisher = publisher","+","+    request = create_requests(","+        1,","+        num_tokens=2000,","+        req_ids=[\"request\"],","+        mm_hashes_list=[[\"img_a\", \"img_b\"]],","+        mm_positions=[[PlaceholderRange(0, 576), PlaceholderRange(1200, 576)]],","+    )[0]","+    scheduler.add_request(request)","+","+    first_output = scheduler.schedule()","+    assert first_output.scheduled_encoder_inputs == {\"request\": [0]}","+    # Schedule the next chunk before the first one has produced its output.","+    second_output = scheduler.schedule()","+    assert second_output.scheduled_encoder_inputs == {\"request\": [1]}","+","+    _model_output(scheduler, first_output, [[]])","+    published = [call.args[0].events for call in publisher.publish.call_args_list]","+    assert published == [[ECStored(mm_hashes=[\"img_a\"], medium=\"GPU\")]]","+","+    _model_output(scheduler, second_output, [[]])","+    published = [call.args[0].events for call in publisher.publish.call_args_list]","+    assert published == [","+        [ECStored(mm_hashes=[\"img_a\"], medium=\"GPU\")],","+        [ECStored(mm_hashes=[\"img_b\"], medium=\"GPU\")],","+    ]","+","+","+def test_ec_eviction_published_when_no_tokens_are_scheduled():","+    \"\"\"A rejected request can evict a cached item without running a forward pass.\"\"\"","+    scheduler = create_scheduler(","+        model=\"llava-hf/llava-1.5-7b-hf\",","+        max_num_batched_tokens=1024,","+        max_model_len=1024,","+        encoder_cache_size=576,","+        use_ec_connector=True,","+        ec_role=\"ec_consumer\",","+    )","+    manager = scheduler.encoder_cache_manager","+    cached, missing = create_requests(","+        2,","+        num_tokens=manager.cache_size,","+        mm_hashes_list=[[\"cached\"], [\"missing\"]],","+        mm_positions=[[PlaceholderRange(0, manager.cache_size)]] * 2,","+    )","+    assert manager.can_allocate(cached, 0, manager.cache_size, 0)","+    manager.allocate(cached, 0)","+    manager.free(cached)","+    manager.enable_events = True","+    publisher = Mock()","+    scheduler.ec_event_publisher = publisher","+","+    missing.mm_features[0].data = None","+    scheduler.add_request(missing)","+    output = scheduler.schedule()","+    assert output.total_num_scheduled_tokens == 0","+    assert output.free_encoder_mm_hashes == [\"cached\"]","+","+    scheduler.update_from_output(output, make_empty_encoder_model_runner_output(output))","+    assert [call.args[0].events for call in publisher.publish.call_args_list] == [","+        [ECRemoved(mm_hashes=[\"cached\"], medium=\"GPU\")]","+    ]"],"additions":103,"deletions":0,"truncated":false},{"path":"vllm/config/__init__.py","lines":["@@ -12,12 +12,13 @@"," )"," from vllm.config.device import DeviceConfig"," from vllm.config.diffusion import DiffusionConfig","+from vllm.config.ec_events import ECEventsConfig"," from vllm.config.ec_manager_config import EncoderCacheManagerConfig"," from vllm.config.ec_transfer import ECTransferConfig"," from vllm.config.engram import EngramConfig"," from vllm.config.fault_tolerance import FaultToleranceConfig"," from vllm.config.kernel import KernelConfig","-from vllm.config.kv_events import KVEventsConfig","+from vllm.config.kv_events import KVEventsConfig, PublisherConfig"," from vllm.config.kv_transfer import KVTransferConfig"," from vllm.config.load import LoadConfig"," from vllm.config.logging import LoggingConfig","@@ -85,6 +86,8 @@","     \"DeviceConfig\",","     # From vllm.config.diffusion","     \"DiffusionConfig\",","+    # From vllm.config.ec_events","+    \"ECEventsConfig\",","     # From vllm.config.ec_manager_config","     \"EncoderCacheManagerConfig\",","     # From vllm.config.ec_transfer","@@ -95,6 +98,7 @@","     \"KernelConfig\",","     # From vllm.config.kv_events","     \"KVEventsConfig\",","+    \"PublisherConfig\",","     # From vllm.config.kv_transfer","     \"KVTransferConfig\",","     # From vllm.config.load"],"additions":5,"deletions":1,"truncated":false},{"path":"vllm/config/ec_events.py","lines":["@@ -0,0 +1,29 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+","+from vllm.config.kv_events import PublisherConfig","+from vllm.config.utils import config","+","+","+@config","+class ECEventsConfig(PublisherConfig):","+    \"\"\"Configuration for encoder cache (EC) event publishing.\"\"\"","+","+    enable_ec_cache_events: bool = False","+    \"\"\"If True, enable encoder cache events for tracking which multimodal","+    inputs are cached and where. Events can be published externally by zmq","+    using the event publisher config.","+    \"\"\"","+","+    endpoint: str = \"tcp://*:6558\"","+    \"\"\"The zmq endpoint for EC events.","+","+    Ports are offset by the data parallel rank like KV events. The block starts","+    1000 ports above the 5557/5558 KV events block, so the two stay disjoint for","+    up to 1000 DP ranks on one host, replay included.","+    \"\"\"","+","+    @property","+    def enable_events(self) -> bool:","+        return self.enable_ec_cache_events"],"additions":29,"deletions":0,"truncated":false},{"path":"vllm/config/kv_events.py","lines":["@@ -8,24 +8,23 @@"," "," "," @config","-class KVEventsConfig:","-    \"\"\"Configuration for KV event publishing.\"\"\"","+class PublisherConfig:","+    \"\"\"Transport settings shared by all cache event publishers."," ","-    enable_kv_cache_events: bool = False","-    \"\"\"If True, enable KV cache events for tracking block storage and removal.","-    Events can be published externally by zmq using the event publisher config.","+    Subclasses add the switch that gates the events they publish and override","+    `enable_events`, which resolves `publisher` to \"null\" when they are off.","     \"\"\""," ","     publisher: Literal[\"null\", \"zmq\"] = None  # type: ignore[assignment]","-    \"\"\"The publisher to use for publishing kv events. Can be \"null\", \"zmq\".","+    \"\"\"The publisher to use for publishing cache events. Can be \"null\", \"zmq\".","     \"\"\""," ","     endpoint: str = \"tcp://*:5557\"","-    \"\"\"The zmq endpoint to use for publishing kv events.","+    \"\"\"The zmq endpoint to use for publishing cache events.","     \"\"\""," ","     replay_endpoint: str | None = None","-    \"\"\"The zmq endpoint to use for replaying kv events.","+    \"\"\"The zmq endpoint to use for replaying cache events.","     \"\"\""," ","     buffer_steps: int = 10_000","@@ -49,6 +48,31 @@ class KVEventsConfig:","     this topic to receive events.","     \"\"\""," ","+    @property","+    def enable_events(self) -> bool:","+        \"\"\"Whether the events gated by this config are enabled.\"\"\"","+        return True","+","     def __post_init__(self):","         if self.publisher is None:","-            self.publisher = \"zmq\" if self.enable_kv_cache_events else \"null\"","+            self.publisher = \"zmq\" if self.enable_events else \"null\"","+","+","+@config","+class _KVEventsToggle:","+    \"\"\"The original first positional argument of `KVEventsConfig`.\"\"\"","+","+    enable_kv_cache_events: bool = False","+    \"\"\"If True, enable KV cache events for tracking bloc