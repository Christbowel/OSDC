{"id":"GHSA-3w93-6hmw-whh4","axis":"advisories","repo":"rails/rails","sha":"8d93f6a872e9550a91bf0e4fce50083a235ef3b1","parsed":{"files":[{"path":"activestorage/CHANGELOG.md","lines":["@@ -1,3 +1,13 @@","+*   Sign GCS direct uploads with V2 when `cache_control` is set.","+","+    V4 signatures did not bind the Content-Type or Content-MD5 headers, so the uploader could","+    choose the stored Content-Type. Direct-upload URLs with `cache_control` are no longer limited","+    to 7 days, and the client sends `Cache-Control` unsigned.","+","+    [GHSA-3w93-6hmw-whh4]","+","+    *Mike Dalessio*","+"," *   Stop an uploaded filename choosing the extension of the tempfile Active","     Storage hands to an external tool."," "],"additions":10,"deletions":0,"truncated":false},{"path":"activestorage/lib/active_storage/service/gcs_service.rb","lines":["@@ -91,25 +91,14 @@ def exist?(key)"," ","     def url_for_direct_upload(key, expires_in:, checksum:, custom_metadata: {}, **)","       instrument :url, key: key do |payload|","-        headers = {}","-        version = :v2","-","-        if @config[:cache_control].present?","-          headers[\"Cache-Control\"] = @config[:cache_control]","-          # v2 signing doesn't support non `x-goog-` headers. Only switch to v4 signing","-          # if necessary for back-compat; v4 limits the expiration of the URL to 7 days","-          # whereas v2 has no limit","-          version = :v4","-        end","-","-        headers.merge!(custom_metadata_headers(custom_metadata))","-","+        # V2 signatures bind the Content-Type (empty) and Content-MD5 headers. GCS leaves headers","+        # other than x-goog-* out of V2 signatures, so the client sends Cache-Control unsigned.","         args = {","           content_md5: checksum,","           expires: expires_in,","-          headers: headers,","+          headers: custom_metadata_headers(custom_metadata),","           method: \"PUT\",","-          version: version,","+          version: :v2,","         }"," ","         if @config[:iam]"],"additions":4,"deletions":15,"truncated":false},{"path":"activestorage/test/service/gcs_service_test.rb","lines":["@@ -87,6 +87,32 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase","       service.delete(key)","     end"," ","+    test \"direct upload with cache control rejects a Content-Type the URL does not sign\" do","+      config_with_cache_control = { gcs: SERVICE_CONFIGURATIONS[:gcs].merge({ cache_control: \"public, max-age=1800\" }) }","+      service = ActiveStorage::Service.configure(:gcs, config_with_cache_control)","+","+      key      = SecureRandom.base58(24)","+      data     = \"<html></html>\"","+      checksum = Digest::MD5.base64digest(data)","+      url      = service.url_for_direct_upload(key, expires_in: 5.minutes, content_type: \"image/png\", content_length: data.size, checksum: checksum)","+","+      uri = URI.parse url","+      request = Net::HTTP::Put.new uri.request_uri","+      request.body = data","+      service.headers_for_direct_upload(key, checksum: checksum, filename: ActiveStorage::Filename.new(\"test.png\"), content_type: \"image/png\").each do |k, v|","+        request.add_field k, v","+      end","+      request.add_field \"Content-Type\", \"text/html\"","+      response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) do |http|","+        http.request request","+      end","+","+      assert_equal \"403\", response.code","+      assert_not service.exist?(key)","+    ensure","+      service.delete(key)","+    end","+","     test \"upload with content_type and content_disposition\" do","       key      = SecureRandom.base58(24)","       data     = \"Something else entirely!\"","@@ -234,3 +260,51 @@ class ActiveStorage::Service::GCSServiceTest < ActiveSupport::TestCase"," else","   puts \"Skipping GCS Service tests because no GCS configuration was supplied\""," end","+","+class ActiveStorage::Service::GCSServiceDirectUploadSignatureTest < ActiveSupport::TestCase","+  setup do","+    @signing_key = OpenSSL::PKey::RSA.new(2048)","+    @service = ActiveStorage::Service.configure(:gcs, gcs: {","+      service: \"GCS\",","+      bucket: \"bucket\",","+      cache_control: \"public, max-age=1800\",","+      project_id: \"project\",","+      credentials: {","+        type: \"service_account\",","+        project_id: \"project\",","+        client_email: \"uploader@project.iam.gserviceaccount.com\",","+        private_key: @signing_key.to_pem","+      }","+    })","+    @checksum = OpenSSL::Digest::MD5.base64digest(\"Some text\")","+  end","+","+  test \"direct upload with cache control authorizes only an empty Content-Type\" do","+    url = @service.url_for_direct_upload(\"key\", expires_in: 5.minutes, content_type: \"text/plain\", content_length: 9, checksum: @checksum)","+","+    assert authorizes?(url, content_type: \"\", checksum: @checksum)","+    assert_not authorizes?(url, content_type: \"text/html\", checksum: @checksum)","+  end","+","+  test \"direct upload with cache control authorizes only the declared checksum\" do","+    url = @service.url_for_direct_upload(\"key\", expires_in: 5.minutes, content_type: \"text/plain\", content_length: 9, checksum: @checksum)","+","+    assert authorizes?(url, content_type: \"\", checksum: @checksum)","+    assert_not authorizes?(url, content_type: \"\", checksum: OpenSSL::Digest::MD5.base64digest(\"Other text\"))","+  end","+","+  test \"direct upload headers with cache control include Cache-Control\" do","+    headers = @service.headers_for_direct_upload(\"key\", checksum: @checksum, filename: ActiveStorage::Filename.new(\"test.txt\"), content_type: \"text/plain\")","+","+    assert_equal \"public, max-age=1800\", headers[\"Cache-Control\"]","+  end","+","+  private","+    # Rebuilds the string that GCS verifies a V2 signed PUT URL against.","+    def authorizes?(url, content_type:, checksum:)","+      query = Rack::Utils.parse_query(URI(url).query)","+      string_to_sign = [\"PUT\", checksum, content_type, query[\"Expires\"], \"/bucket/key\"].join(\"\\n\")","+","+      @signing_key.public_key.verify(OpenSSL::Digest::SHA256.new, Base64.strict_decode64(query[\"Signature\"].to_s), string_to_sign)","+    end","+end",""],"additions":74,"deletions":0,"truncated":false}],"additions":88,"deletions":15,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-13T17:02:41.828091+00:00"}