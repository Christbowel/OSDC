l {","+\t\t\tc.AutoAuth.Method.Config[\"tpm_cert_device\"] = tpmCert.TPM.DevicePath","+\t\t}","+\t\t// Since most auto_auth methods allow configuring the role, we'll tolerate","+\t\t// it here so long as it matches the value in tpm_cert.  We can't check this","+\t\t// in validation because it would already have been overwritten.","+\t\texistingRoleName, ok := c.AutoAuth.Method.Config[\"role_name\"].(string)","+\t\tif ok && existingRoleName != tpmCert.RoleName {","+\t\t\treturn fmt.Errorf(\"role_name in autoauth config stanza (%q) conflicts with role_name in tpm_cert %q: %q\",","+\t\t\t\tc.AutoAuth.Method.Config[\"role_name\"], tpmCert.Name, tpmCert.RoleName)","+\t\t}","+\t\tc.AutoAuth.Method.Config[\"role_name\"] = tpmCert.RoleName","+\t}","+","+\treturn nil","+}","+","+func (c *Config) getAutoAuthTPMCertReference() (*TPMCert, error) {","+\tif c.AutoAuth == nil || c.AutoAuth.Method == nil {","+\t\treturn nil, logical.ErrNotFound","+\t}","+","+\tmethod := c.AutoAuth.Method","+\tif method.Type != \"tpm\" {","+\t\treturn nil, logical.ErrNotFound","+\t}","+","+\t// Check if tpm_cert is specified in the config","+\ttpmCertName, hasTpmCert := method.Config[\"tpm_cert\"].(string)","+\tif !hasTpmCert {","+\t\treturn nil, fmt.Errorf(\"missing tpm_cert config\")","+\t}","+","+\t// Find the referenced tpm_cert block","+\tvar tpmCert *TPMCert","+\tfor _, tc := range c.TPMCerts {","+\t\tif tc.Name == tpmCertName {","+\t\t\ttpmCert = tc","+\t\t\tbreak","+\t\t}","+\t}","+","+\tif tpmCert == nil {","+\t\treturn nil, fmt.Errorf(\"auto_auth.method.config references tpm_cert %q but no such tpm_cert block exists\", tpmCertName)","+\t}","+","+\treturn tpmCert, nil","+}","+","+func (c *Config) validateTPMCertConfig(logger hclog.Logger) error {","+\tinheritedNamespace := \"\"","+\tif c.Vault != nil {","+\t\tinheritedNamespace = c.Vault.Namespace","+\t}","+\treturn ValidateTPMCert(c.TPMCerts, inheritedNamespace, logger)","+}","+","+func ValidateTPMCert(entries []*TPMCert, inheritedNamespace string, _ hclog.Logger) error {","+\tseenDestinationPaths := make(map[string]int)","+\tseenNames := make(map[string]seenBlockName)","+","+\tfor idx, entry := range entries {","+\t\tif entry == nil {","+\t\t\treturn fmt.Errorf(\"tpm_cert[%d]: configuration is empty\", idx)","+\t\t}","+","+\t\tblockName := fmt.Sprintf(tpmCertBlockFmt, idx)","+\t\tif entry.Name != \"\" {","+\t\t\tif prev, exists := seenNames[entry.Name]; exists {","+\t\t\t\tif prev.line > 0 && entry.LineNumber > 0 {","+\t\t\t\t\treturn fmt.Errorf(\"%s (line %d) name %q duplicates tpm_cert[%d] (line %d)\", blockName, entry.LineNumber, entry.Name, prev.idx, prev.line)","+\t\t\t\t}","+\t\t\t\treturn fmt.Errorf(\"%s name %q duplicates tpm_cert[%d]\", blockName, entry.Name, prev.idx)","+\t\t\t}","+\t\t\tseenNames[entry.Name] = seenBlockName{idx: idx, line: entry.LineNumber}","+\t\t}","+","+\t\tns := namespace.Canonicalize(entry.Namespace)","+\t\tif ns == \"\" {","+\t\t\tns = namespace.Canonicalize(inheritedNamespace)","+\t\t}","+\t\tentry.Namespace = ns","+","+\t\tif strings.TrimSpace(entry.MountPath) == \"\" {","+\t\t\treturn fmt.Errorf(\"%s.mount_path must be specified\", blockName)","+\t\t}","+","+\t\tif err := validateTPMCertRenew(blockName, entry); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif err := validateTPMCertDestination(blockName, idx, seenDestinationPaths, entry); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\treturn nil","+}","+","+func validateTPMCertRenew(blockName string, entry *TPMCert) error {","+\tif entry.Renew == nil {","+\t\tentry.Renew = &TPMCertRenew{}","+\t}","+","+\tif entry.Renew.PercentRenewBeforeExpiry == nil {","+\t\tdefaultPercent := defaultTPMCertPercentRenewBeforeExpiry","+\t\tentry.Renew.PercentRenewBeforeExpiry = &defaultPercent","+\t} else if *entry.Renew.PercentRenewBeforeExpiry <= 0 || *entry.Renew.PercentRenewBeforeExpiry >= 100 {","+\t\treturn fmt.Errorf(\"%s.renew.percent_renew_before_expiry must be between 1 and 99\", blockName)","+\t}","+","+\treturn nil","+}","+","+func validateTPMCertDestination(blockName string, idx int, seenDestinationPaths map[string]int, entry *TPMCert) error {","+\tif entry.Destination == nil {","+\t\treturn fmt.Errorf(\"%s.destination block must be specified\", blockName)","+\t}","+","+\tpath := strings.TrimSpace(entry.Destination.Path)","+\tif path == \"\" {","+\t\treturn fmt.Errorf(\"%s.destination.path must be specified\", blockName)","+\t}","+","+\tinfo, err := os.Stat(path)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"%s.destination.path must be an existing directory: %w\", blockName, err)","+\t}","+\tif !info.IsDir() {","+\t\treturn fmt.Errorf(\"%s.destination.path must be an existing directory\", blockName)","+\t}","+","+\tnormalizedPath := normalizeDestinationPath(path)","+\tif prevIdx, exists := seenDestinationPaths[normalizedPath]; exists {","+\t\treturn fmt.Errorf(\"%s.destination.path duplicates tpm_cert[%d].destination.path\", blockName, prevIdx)","+\t}","+\tseenDestinationPaths[normalizedPath] = idx","+","+\tif strings.TrimSpace(entry.Destination.Umask) == \"\" {","+\t\tentry.Destination.Umask = defaultTPMCertUmask","+\t} else {","+\t\tif _, err := strconv.ParseUint(entry.Destination.Umask, umaskBaseOctal, umaskBitSize); err != nil {","+\t\t\treturn fmt.Errorf(\"%s.destination.umask invalid value %q: %w\", blockName, entry.Destination.Umask, err)","+\t\t}","+\t}","+","+\treturn nil","+}","+","+func ParseTPMCert(list *ast.ObjectList) ([]*TPMCert, error) {","+\ttpmCertList := list.Filter(tpmCertBlockName)","+\tif len(tpmCertList.Items) == 0 {","+\t\treturn []*TPMCert{}, nil","+\t}","+","+\tentries := make([]*TPMCert, 0, len(tpmCertList.Items))","+\tfor _, item := range tpmCertList.Items {","+\t\tvar entry TPMCert","+\t\tif err := hcl.DecodeObject(&entry, item.Val); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tif len(item.Keys) != 1 {","+\t\t\treturn nil, fmt.Errorf(\"tpm_cert: expected exactly one label, got %d\", len(item.Keys))","+\t\t}","+\t\tentry.Name = strings.Trim(item.Keys[0].Token.Text, `\"`)","+\t\tentry.LineNumber = item.Pos().Line","+\t\tentries = append(entries, &entry)","+\t}","+","+\treturn entries, nil","+}","+","+func parseTPMCert(result *Config, list *ast.ObjectList) error {","+\tentries, err := ParseTPMCert(list)","+\tif err != nil {","+\t\treturn err","+\t}","+\tif len(entries) == 0 {","+\t\treturn nil","+\t}","+","+\tresult.TPMCerts = entries","+\treturn nil","+}"],"additions":234,"deletions":0,"truncated":false},{"path":"command/client/agent/tpmattest/manager.go","lines":["@@ -0,0 +1,251 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package tpmattest","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"math\"","+\tmathrand \"math/rand\"","+\t\"os\"","+\t\"strconv\"","+\t\"sync\"","+\t\"sync/atomic\"","+\t\"time\"","+","+\t\"github.com/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/vault/sdk/helper/backoff\"","+\tsdktpm \"github.com/hashicorp/vault/sdk/helper/tpm\"","+)","+","+// AttestFunc performs TPM attestation and returns the result. The function is","+// responsible for all Vault client interaction and TPM configuration; Manager","+// treats it as an opaque operation.","+type AttestFunc func(ctx context.Context) (*sdktpm.AttestationResult, error)","+","+// ValidateFunc validates a loaded AttestationResult against the local TPM","+// hardware (e.g. verifying that the persisted key blobs are still usable).","+// A nil ValidateFunc skips hardware validation.","+type ValidateFunc func(*sdktpm.AttestationResult) error","+","+type Manager struct {","+\tattest       AttestFunc","+\tvalidate     ValidateFunc","+\tdestPath     string","+\tumask        os.FileMode","+\trenewPercent int","+\tlogger       hclog.Logger","+","+\tmu           sync.RWMutex","+\ttimer        *time.Timer","+\tretryBackoff *backoff.Backoff","+","+\tstopCh  chan struct{}","+\tstarted bool","+\tstopped atomic.Bool","+}","+","+// NewManager creates a Manager that periodically calls attest to obtain and","+// renew TPM certificate material. validate may be nil to skip hardware","+// validation when loading persisted material.","+func NewManager(attest AttestFunc, validate ValidateFunc, destPath string, umask os.FileMode, renewPercent int, logger hclog.Logger) (*Manager, error) {","+\tif attest == nil {","+\t\treturn nil, fmt.Errorf(\"attest func cannot be nil\")","+\t}","+","+\treturn &Manager{","+\t\tattest:       attest,","+\t\tvalidate:     validate,","+\t\tdestPath:     destPath,","+\t\tumask:        umask,","+\t\trenewPercent: renewPercent,","+\t\tlogger:       logger,","+\t\tstopCh:       make(chan struct{}),","+\t\tretryBackoff: backoff.NewBackoff(math.MaxInt, 1*time.Minute, 1*time.Hour),","+\t}, nil","+}","+","+func (m *Manager) Start(ctx context.Context) {","+\tm.mu.Lock()","+\tif m.started {","+\t\tm.mu.Unlock()","+\t\treturn","+\t}","+\tm.started = true","+\tm.mu.Unlock()","+","+\tm.logger.Info(\"starting TPM attestation manager\")","+\tdefer m.logger.Info(\"TPM attestation manager stopped\")","+","+\treused, err := m.loadPersistedMaterial()","+\tif err != nil {","+\t\tm.logger.Warn(\"failed to load persisted TPM certificate material, will reissue\", \"error\", err)","+\t}","+","+\tif !reused {","+\t\tif err != nil {","+\t\t\tm.logger.Info(\"starting initial acquisition after load failure\")","+\t\t} else {","+\t\t\tm.logger.Info(\"no reusable persisted TPM certificate material found, starting initial acquisition\")","+\t\t}","+\t\tif err := m.acquireMaterial(ctx); err != nil {","+\t\t\tm.logger.Error(\"failed to acquire initial TPM certificate material\", \"error\", err)","+\t\t\tm.scheduleRetryAfter()","+\t\t}","+\t} else {","+\t\tm.logger.Info(\"loaded persisted TPM certificate material\")","+\t}","+","+\tfor {","+\t\tm.mu.RLock()","+\t\ttimerC := m.timerC()","+\t\tm.mu.RUnlock()","+","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\treturn","+\t\tcase <-m.stopCh:","+\t\t\treturn","+\t\tcase <-timerC:","+\t\t\tm.logger.Info(\"renewal timer triggered\")","+\t\t\tif err := m.acquireMaterial(ctx); err != nil {","+\t\t\t\tm.logger.Error(\"TPM certificate renewal failed\", \"error\", err)","+\t\t\t\tm.scheduleRetryAfter()","+\t\t\t}","+\t\t}","+\t}","+}","+","+func (m *Manager) Stop() {","+\tif !m.stopped.CompareAndSwap(false, true) {","+\t\treturn","+\t}","+","+\tm.mu.Lock()","+\tif m.timer != nil {","+\t\tm.timer.Stop()","+\t\tm.timer = nil","+\t}","+\tm.mu.Unlock()","+","+\tclose(m.stopCh)","+}","+","+func (m *Manager) acquireMaterial(ctx context.Context) error {","+\tm.logger.Info(\"acquiring TPM certificate material\")","+","+\tresult, err := m.attest(ctx)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"failed to attest with TPM: %w\", err)","+\t}","+","+\tif err := result.SaveToDirectory(m.destPath, m.umask); err != nil {","+\t\treturn fmt.Errorf(\"failed to save TPM material: %w\", err)","+\t}","+","+\tm.scheduleRenewal(result)","+","+\treturn nil","+}","+","+func (m *Manager) loadPersistedMaterial() (bool, error) {","+\tresult, err := sdktpm.LoadFromDirectory(m.destPath)","+\tif err != nil {","+\t\tif os.IsNotExist(err) {","+\t\t\treturn false, nil","+\t\t}","+\t\treturn false, fmt.Errorf(\"failed to load persisted material: %w\", err)","+\t}","+","+\tif time.Now().After(result.NotAfter) {","+\t\treturn false, fmt.Errorf(\"persisted certificate has expired at %s\", result.NotAfter)","+\t}","+","+\tif m.validate != nil {","+\t\tif err := m.validate(result); err != nil {","+\t\t\treturn false, fmt.Errorf(\"persisted material failed validation: %w\", err)","+\t\t}","+\t}","+","+\tm.scheduleRenewal(result)","+\treturn true, nil","+}","+","+// parseUmask parses a umask string (e.g., \"077\") into an os.FileMode.","+func parseUmask(umaskStr string) (os.FileMode, error) {","+\tif umaskStr == \"\" {","+\t\treturn 0, nil","+\t}","+","+\tumaskVal, err := strconv.ParseUint(umaskStr, 8, 32)","+\tif err != nil {","+\t\treturn 0, fmt.Errorf(\"invalid umask value %q: %w\", umaskStr, err)","+\t}","+","+\treturn os.FileMode(umaskVal), nil","+}","+","+// timerC returns the channel of the current renewal timer, or a nil channel","+// (which blocks forever) when no timer is set. Must be called with m.mu held","+// for reading.","+func (m *Manager) timerC() <-chan time.Time {","+\tif m.timer == nil {","+\t\treturn nil","+\t}","+\treturn m.timer.C","+}","+","+// resetTimer arms the renewal timer to fire after duration. If a timer already","+// exists its channel is reused (via Reset) so that any goroutine already","+// selecting on that channel will wake up. Must be called with m.mu held for","+// writing.","+func (m *Manager) resetTimer(duration time.Duration) {","+\tif m.timer != nil {","+\t\t// Stop and drain before Reset per the time.Timer docs.","+\t\tif !m.timer.Stop() {","+\t\t\tselect {","+\t\t\tcase <-m.timer.C:","+\t\t\tdefault:","+\t\t\t}","+\t\t}","+\t\tm.timer.Reset(duration)","+\t\treturn","+\t}","+\tm.timer = time.NewTimer(duration)","+}","+","+func (m *Manager) scheduleRenewal(result *sdktpm.AttestationResult) {","+\tlifetime := result.NotAfter.Sub(result.NotBefore)","+\trenewalThreshold := time.Duration(float64(lifetime) * float64(m.renewPercent) / 100.0)","+\trenewalTime := result.NotAfter.Add(-renewalThreshold)","+","+\tduration := time.Until(renewalTime)","+\tif duration < 0 {","+\t\tduration = time.Second","+\t} else {","+\t\tjitterRange := float64(duration) * 0.1","+\t\tjitter := time.Duration(mathrand.Float64()*jitterRange*2 - jitterRange)","+\t\tduration += jitter","+\t\tif duration < 0 {","+\t\t\tduration = time.Second","+\t\t}","+\t}","+","+\tm.mu.Lock()","+\tm.retryBackoff.Reset()","+\tm.resetTimer(duration)","+\tm.mu.Unlock()","+","+\tm.logger.Info(\"scheduled TPM certificate renewal\", \"renewal_time\", renewalTime, \"duration\", duration)","+}","+","+func (m *Manager) scheduleRetryAfter() {","+\tm.mu.Lock()","+\t// Discard error; can only be ErrMaxRetry and we use math.MaxInt retries.","+\tduration, _ := m.retryBackoff.Next()","+\tm.resetTimer(duration)","+\tm.mu.Unlock()","+","+\tm.logger.Warn(\"scheduled TPM certificate retry after failure\", \"duration\", duration)","+}"],"additions":251,"deletions":0,"truncated":false},{"path":"command/client/agent/tpmattest/server.go","lines":["@@ -0,0 +1,171 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package tpmattest","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"sync\"","+","+\t\"github.com/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/vault/api\"","+\t\"github.com/hashicorp/vault/command/client/agent/config\"","+\tsdktpm \"github.com/hashicorp/vault/sdk/helper/tpm\"","+\t\"go.uber.org/atomic\"","+)","+","+type ServerConfig struct {","+\tLogger      hclog.Logger","+\tAgentConfig *config.Config","+}","+","+type RunnableClient interface {","+\tRun(ctx context.Context, client *api.Client) error","+\tStop()","+}","+","+const (","+\tdefaultMaxRetries = 5","+)","+","+type Server struct {","+\tconfig *ServerConfig","+\tlogger hclog.Logger","+","+\tmanagers       []*Manager","+\tmanagersByName map[string]*Manager","+","+\tmu sync.RWMutex","+","+\tdoneCh  chan struct{}","+\tstopped *atomic.Bool","+}","+","+func NewServer(cfg *ServerConfig) (RunnableClient, error) {","+\tif cfg == nil {","+\t\treturn nil, fmt.Errorf(\"server config cannot be nil\")","+\t}","+","+\tserver := &Server{","+\t\tconfig:         cfg,","+\t\tlogger:         cfg.Logger,","+\t\tdoneCh:         make(chan struct{}),","+\t\tstopped:        atomic.NewBool(false),","+\t\tmanagers:       make([]*Manager, 0, len(cfg.AgentConfig.TPMCerts)),","+\t\tmanagersByName: make(map[string]*Manager),","+\t}","+","+\treturn server, nil","+}","+","+func (s *Server) Run(ctx context.Context, client *api.Client) error {","+\ts.logger.Info(\"starting tpm attestation server\")","+\tdefer s.logger.Info(\"tpm attestation server stopped\")","+","+\tif len(s.config.AgentConfig.TPMCerts) == 0 {","+\t\ts.logger.Info(\"no tpm_cert blocks configured, tpm attestation server idle\")","+