es(gv schema.GroupVersion) ([]builder.AP"," \treturn handlers, nil"," }"," ","+// keysRoutes builds the generic list-keys endpoints for the kinds this version","+// serves, at both scopes.","+//","+// Delegated to keysroutes for the same reason as searchRoutes: which kinds get","+// the endpoint is not a decision this builder should be making on its own, so the","+// config toggle and the namespaced-kind rule are applied in one place and a","+// plugin-served manifest agrees with the same manifest served as a custom","+// resource definition.","+func (b *AppPluginAPIBuilder) keysRoutes(gv schema.GroupVersion) *builder.APIRoutes {","+\tif b.store == nil {","+\t\treturn nil","+\t}","+","+\t// keysroutes matches manifests to served versions by the manifest's own","+\t// group, which is not always the group the plugin is served under. See","+\t// apiGroupForPlugin.","+\tmanifest := *b.manifest","+\tmanifest.Group = b.group","+","+\tbuilt := keysroutes.BuildForServedGroupVersions(","+\t\t[]*app.ManifestData{&manifest},","+\t\tmap[schema.GroupVersion]bool{gv: true},","+\t\tb.opts.KeysAPIEnabled,","+\t\tb.tracer,","+\t\tb.store,","+\t)","+","+\t// One manifest and one served version in, so at most one entry matches.","+\tfor _, gvRoutes := range built {","+\t\tif gvRoutes.GroupVersion == gv {","+\t\t\treturn gvRoutes.Routes","+\t\t}","+\t}","+\treturn nil","+}","+"," // routeHandler forwards a manifest route to the plugin's v3 route service."," // resource is empty for version routes; for a kind subresource route it is the"," // kind's plural, and the parent object's name comes from the path."],"additions":42,"deletions":0,"truncated":false},{"path":"pkg/router/plugin.go","lines":["@@ -22,6 +22,7 @@ import ("," \t\"github.com/grafana/grafana/pkg/plugins/definition\""," \t\"github.com/grafana/grafana/pkg/plugins/manager/sources\""," \t\"github.com/grafana/grafana/pkg/registry/apis/appplugin\"","+\tkeysapi \"github.com/grafana/grafana/pkg/registry/apis/keys\""," \tsearchapi \"github.com/grafana/grafana/pkg/registry/apis/search\""," \tsecret \"github.com/grafana/grafana/pkg/registry/apis/secret/contracts\""," \t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","@@ -259,6 +260,7 @@ func (b *PluginBackend) Load(ctx context.Context) (http.Handler, error) {"," \t\tContextProvider: b.deps.ContextProvider,"," \t\tDecrypter:       b.deps.Decrypter,"," \t\tSearch:          b.deps.Unified,","+\t\tStore:           b.deps.Unified,"," \t\tRunner: appplugin.AppPluginRunnerOptions{"," \t\t\tRegisterProxy:            openfeature.NewDefaultClient().Boolean(ctx, featuremgmt.FlagApppluginsHandleProxyRequests, false, openfeature.TransactionContext(ctx)),"," \t\t\tAccessControl:            b.deps.AccessControl,","@@ -267,6 +269,7 @@ func (b *PluginBackend) Load(ctx context.Context) (http.Handler, error) {"," \t\t\tPluginsAppsSkipVerifyTLS: cfg.PluginsAppsSkipVerifyTLS,"," \t\t\tSearchAPIEnabled:         apiserverSection.Key(searchapi.ConfigKey).MustBool(true),"," \t\t\tTrashAPIEnabled:          apiserverSection.Key(searchapi.ConfigKeyTrash).MustBool(true),","+\t\t\tKeysAPIEnabled:           apiserverSection.Key(keysapi.ConfigKey).MustBool(false),"," \t\t},"," \t\tTracer:          b.deps.Tracer,"," \t\tFeatures:        b.deps.Features,"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/services/apiserver/builder/common.go","lines":["@@ -180,6 +180,27 @@ func getGroup(builder APIGroupBuilder) (string, error) {"," \treturn \"\", fmt.Errorf(\"unable to get group: builder does not implement APIGroupVersionProvider or APIGroupVersionsProvider\")"," }"," ","+// ServedGroupVersions reports which group versions this process actually serves.","+// Builders and app installers are the two ways a kind reaches the apiserver, and","+// a manifest describes kinds a given deployment may not serve at all.","+func ServedGroupVersions(","+\tbuilders []APIGroupBuilder,","+\tinstallers []appsdkapiserver.AppInstaller,","+) map[schema.GroupVersion]bool {","+\tserved := map[schema.GroupVersion]bool{}","+\tfor _, b := range builders {","+\t\tfor _, gv := range GetGroupVersions(b) {","+\t\t\tserved[gv] = true","+\t\t}","+\t}","+\tfor _, i := range installers {","+\t\tfor _, gv := range i.GroupVersions() {","+\t\t\tserved[gv] = true","+\t\t}","+\t}","+\treturn served","+}","+"," func GetGroupVersions(builder APIGroupBuilder) []schema.GroupVersion {"," \tif v, ok := builder.(APIGroupVersionProvider); ok {"," \t\treturn []schema.GroupVersion{v.GetGroupVersion()}"],"additions":21,"deletions":0,"truncated":false},{"path":"pkg/services/apiserver/keysroutes/keysroutes.go","lines":["@@ -0,0 +1,131 @@","+// Package keysroutes mounts the list-keys API on the kinds that support it.","+// Endpoint: POST /apis/{group}/{version}/{resource}/list-keys.","+package keysroutes","+","+import (","+\t\"github.com/grafana/grafana-app-sdk/app\"","+\tappsdkapiserver \"github.com/grafana/grafana-app-sdk/k8s/apiserver\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+","+\t\"github.com/grafana/grafana/pkg/infra/tracing\"","+\tkeysapi \"github.com/grafana/grafana/pkg/registry/apis/keys\"","+\t\"github.com/grafana/grafana/pkg/services/apiserver/builder\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+// supportedKindScope is the only kind scope list-keys is mounted for. A","+// cluster-scoped kind has no namespaces to list across, and it does register","+// {resource}/{name}, which the endpoint path would collide with.","+const supportedKindScope = \"Namespaced\"","+","+// Build returns the keys routes to mount, or nil when the endpoint is off or there","+// is no client to serve it with. builders and installers are the two ways a kind","+// reaches the apiserver; a route is mounted only on a group version one serves.","+func Build(","+\tenabled bool,","+\ttracer tracing.Tracer,","+\tstore resourcepb.ResourceStoreClient,","+\tbuilders []builder.APIGroupBuilder,","+\tinstallers []appsdkapiserver.AppInstaller,","+) []builder.GroupVersionRoutes {","+\treturn BuildFromManifests(resource.AppManifests(), enabled, tracer, store, builders, installers)","+}","+","+// BuildFromManifests is Build with the kind declarations supplied by the caller,","+// for a host that learns about apps after it starts.","+func BuildFromManifests(","+\tmanifests []*app.ManifestData,","+\tenabled bool,","+\ttracer tracing.Tracer,","+\tstore resourcepb.ResourceStoreClient,","+\tbuilders []builder.APIGroupBuilder,","+\tinstallers []appsdkapiserver.AppInstaller,","+) []builder.GroupVersionRoutes {","+\treturn BuildForServedGroupVersions(","+\t\tmanifests, builder.ServedGroupVersions(builders, installers), enabled, tracer, store)","+}","+","+// BuildForServedGroupVersions is BuildFromManifests for a host that knows which","+// group versions it serves without builders or installers to ask, such as an app","+// plugin mounting its own manifest.","+func BuildForServedGroupVersions(","+\tmanifests []*app.ManifestData,","+\tserved map[schema.GroupVersion]bool,","+\tenabled bool,","+\ttracer tracing.Tracer,","+\tstore resourcepb.ResourceStoreClient,","+) []builder.GroupVersionRoutes {","+\t// Callers own the toggle: they read it from their own config, and the plugin","+\t// spec builder sets it unconditionally to describe the route.","+\tif !enabled || store == nil {","+\t\treturn nil","+\t}","+","+\thandler := keysapi.NewHandler(store, tracer)","+\tscopes := map[schema.GroupVersion]*routeScopes{}","+","+\tfor _, m := range manifests {","+\t\tif m == nil {","+\t\t\tcontinue","+\t\t}","+\t\tfor _, version := range m.Versions {","+\t\t\tif !version.Served {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tgv := schema.GroupVersion{Group: m.Group, Version: version.Name}","+\t\t\tif !served[gv] {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tfor _, kind := range version.Kinds {","+\t\t\t\tif kind.Scope != supportedKindScope {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tresourceName := resource.ManifestResourceName(kind)","+\t\t\t\tif scopes[gv] == nil {","+\t\t\t\t\tscopes[gv] = &routeScopes{}","+\t\t\t\t}","+\t\t\t\tscopes[gv].cluster = append(scopes[gv].cluster,","+\t\t\t\t\thandler.ListKeysRoute(gv.Group, gv.Version, resourceName, kind.Kind))","+\t\t\t\tscopes[gv].namespaced = append(scopes[gv].namespaced,","+\t\t\t\t\thandler.ListKeysInNamespaceRoute(gv.Group, gv.Version, resourceName, kind.Kind))","+\t\t\t}","+\t\t}","+\t}","+","+\treturn toGroupVersionRoutes(scopes)","+}","+","+// The scopes share a path and differ only in where they mount.","+type routeScopes struct {","+\tcluster    []keysapi.Route","+\tnamespaced []keysapi.Route","+}","+","+func toGroupVersionRoutes(scopes map[schema.GroupVersion]*routeScopes) []builder.GroupVersionRoutes {","+\tout := make([]builder.GroupVersionRoutes, 0, len(scopes))","+\tfor gv, s := range scopes {","+\t\tout = append(out, builder.GroupVersionRoutes{","+\t\t\tGroupVersion: gv,","+\t\t\t// Namespace prefixes .../namespaces/{namespace}/.","+\t\t\tRoutes: &builder.APIRoutes{","+\t\t\t\tRoot:      toHandlers(s.cluster),","+\t\t\t\tNamespace: toHandlers(s.namespaced),","+\t\t\t},","+\t\t})","+\t}","+\treturn out","+}","+","+func toHandlers(routes []keysapi.Route) []builder.APIRouteHandler {","+\thandlers := make([]builder.APIRouteHandler, 0, len(routes))","+\tfor _, r := range routes {","+\t\thandlers = append(handlers, builder.APIRouteHandler{","+\t\t\tPath:    r.Path,","+\t\t\tSpec:    r.Spec,","+\t\t\tHandler: r.Handler,","+\t\t\tSchemas: r.Schemas,","+\t\t})","+\t}","+\treturn handlers","+}"],"additions":131,"deletions":0,"truncated":false},{"path":"pkg/services/apiserver/keysroutes/keysroutes_test.go","lines":["@@ -0,0 +1,166 @@","+package keysroutes","+","+import (","+\t\"testing\"","+","+\t\"github.com/grafana/grafana-app-sdk/app\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\tgenericapiserver \"k8s.io/apiserver/pkg/server\"","+\t\"k8s.io/kube-openapi/pkg/common\"","+","+\t\"github.com/grafana/grafana/pkg/services/apiserver/builder\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+// Build only hands the client to the handler; nothing here calls it.","+type fakeStore struct{ resourcepb.ResourceStoreClient }","+","+type fakeBuilder struct {","+\tgvs []schema.GroupVersion","+}","+","+func (b *fakeBuilder) GetGroupVersions() []schema.GroupVersion { return b.gvs }","+func (b *fakeBuilder) InstallSchema(*runtime.Scheme) error     { return nil }","+func (b *fakeBuilder) UpdateAPIGroupInfo(*genericapiserver.APIGroupInfo, builder.APIGroupOptions) error {","+\treturn nil","+}","+func (b *fakeBuilder) GetOpenAPIDefinitions() common.GetOpenAPIDefinitions { return nil }","+func (b *fakeBuilder) AllowedV0Alpha1Resources() []string                  { return nil }","+","+// Root mounts, flattened so assertions read as the endpoints do.","+func paths(routes []builder.GroupVersionRoutes) map[string][]string {","+\treturn pathsAt(routes, func(r *builder.APIRoutes) []builder.APIRouteHandler { return r.Root })","+}","+","+// Namespace mounts, which the host prefixes with .../namespaces/{namespace}/.","+func namespacedPaths(routes []builder.GroupVersionRoutes) map[string][]string {","+\treturn pathsAt(routes, func(r *builder.APIRoutes) []builder.APIRouteHandler { return r.Namespace })","+}","+","+func pathsAt(routes []builder.GroupVersionRoutes, pick func(*builder.APIRoutes) []builder.APIRouteHandler) map[string][]string {","+\tout := map[string][]string{}","+\tfor _, r := range routes {","+\t\tif r.Routes == nil {","+\t\t\tcontinue","+\t\t}","+\t\tfor _, h := range pick(r.Routes) {","+\t\t\tout[r.GroupVersion.String()] = append(out[r.GroupVersion.String()], h.Path)","+\t\t}","+\t}","+\treturn out","+}","+","+func TestBuild_NothingMountedWhenOffOrUnusable(t *testing.T) {","+\tb := []builder.APIGroupBuilder{&fakeBuilder{gvs: []schema.GroupVersion{","+\t\t{Group: \"dashboard.grafana.app\", Version: \"v1\"},","+\t}}}","+","+\tassert.Nil(t, Build(false, nil, fakeStore{}, b, nil), \"disabled\")","+\t// A server with no resource store has nothing to list keys from.","+\tassert.Nil(t, Build(true, nil, nil, b, nil), \"no client\")","+}","+","+// Which kinds get the route, against the compiled-in manifests.","+func TestBuild_MountsServedNamespacedKinds(t *testing.T) {","+\tb := &fakeBuilder{gvs: []schema.GroupVersion{","+\t\t{Group: \"dashboard.grafana.app\", Version: \"v1\"},","+\t\t{Group: \"folder.grafana.app\", Version: \"v1\"},","+\t}}","+\tgot := paths(Build(true, nil, fakeStore{}, []builder.APIGroupBuilder{b}, nil))","+","+\tassert.Contains(t, got[\"dashboard.grafana.app/v1\"], \"dashboards/list-keys\")","+\tassert.Contains(t, got[\"folder.grafana.app/v1\"], \"folders/list-keys\")","+\t// A manifest describes kinds this process may not serve.","+\tassert.NotContains(t, got, \"playlist.grafana.app/v0alpha1\")","+}","+","+// One manifest shape per rule that decides whether a kind is mounted.","+func TestBuild_MountingRules(t *testing.T) {","+\tgv := schema.GroupVersion{Group: \"example.grafana.app\", Version: \"v1\"}","+\tbuilders := []builder.APIGroupBuilder{&fakeBuilder{gvs: []schema.GroupVersion{gv}}}","+","+\tmanifest := func(served bool, kinds ...app.ManifestVersionKind) []*app.ManifestData {","+\t\treturn []*app.ManifestData{{","+\t\t\tGroup: gv.Group,","+\t\t\tVersions: []app.ManifestVersion{{","+\t\t\t\tName:   gv.Version,","+\t\t\t\tServed: served,","+\t\t\t\tKinds:  kinds,","+\t\t\t}},","+\t\t}}","+\t}","+\twidget := app.ManifestVersionKind{Kind: \"Widget\", Plural: \"widgets\", Scope: supportedKindScope}","+","+\tfor name, tc := range map[string]struct {","+\t\tmanifests []*app.ManifestData","+\t\twant      []string","+\t}{","+\t\t// Unlike search, there is no per-kind enrolment gate: no SearchFields here.","+\t\t\"namespaced kind is mounted\": {","+\t\t\tmanifests: manifest(true, widget),","+\t\t\