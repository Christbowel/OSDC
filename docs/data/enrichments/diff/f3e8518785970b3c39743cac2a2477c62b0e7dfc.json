{"id":"f3e8518785970b3c39743cac2a2477c62b0e7dfc","axis":"silent","repo":"apache/solr","sha":"f3e8518785970b3c39743cac2a2477c62b0e7dfc","parsed":{"files":[{"path":"changelog/unreleased/SOLR-18639-permission-stable-ids.yml","lines":["@@ -0,0 +1,8 @@","+title: Give each Rule-Based Authorization permission a stable id that can be used in place of its index","+type: changed","+authors:","+  - name: Amrit Sarkar","+    nick: sarkaramrit1993","+links:","+  - name: SOLR-18639","+    url: https://issues.apache.org/jira/browse/SOLR-18639"],"additions":8,"deletions":0,"truncated":false},{"path":"solr/core/src/java/org/apache/solr/security/AutorizationEditOperation.java","lines":["@@ -21,13 +21,20 @@"," import static org.apache.solr.handler.admin.SecurityConfHandler.getListValue;"," import static org.apache.solr.handler.admin.SecurityConfHandler.getMapValue;"," ","+import java.nio.charset.StandardCharsets;"," import java.util.ArrayList;","+import java.util.HashSet;"," import java.util.LinkedHashMap;"," import java.util.List;"," import java.util.Map;","+import java.util.Set;","+import java.util.TreeMap;","+import java.util.UUID;"," import java.util.concurrent.atomic.AtomicInteger;","+import java.util.function.Predicate;"," import java.util.stream.Collectors;"," import org.apache.solr.common.util.CommandOperation;","+import org.apache.solr.common.util.Utils;"," "," // TODO is this a typo - should be Authorization?"," enum AutorizationEditOperation {","@@ -66,6 +73,11 @@ public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation","         op.addError(\"Cannot use 'index' and 'before together \");","         return null;","       }","+      Object clientId = dataMap.remove(ID);","+      if (clientId != null && index == null) {","+        op.addError(\"'id' is assigned by Solr\");","+        return null;","+      }"," ","       for (String key : dataMap.keySet()) {","         if (!Permission.knownKeys.contains(key)) op.addError(\"Unknown key, \" + key);","@@ -91,7 +103,12 @@ public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation","           permissionsCopy.add(perm);","         } else if (thisIdx.equals(index)) {","           // overwriting an existing one","+          if (clientId != null && !clientId.equals(perm.get(ID))) {","+            op.addError(ID_INDEX_MISMATCH);","+            return null;","+          }","           indexSatisfied = true;","+          dataMap.put(ID, perm.get(ID));","           permissionsCopy.add(dataMap);","         } else {","           permissionsCopy.add(perm);","@@ -111,6 +128,7 @@ public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation","       if (!permissionsCopy.contains(dataMap)) {","         permissionsCopy.add(dataMap);","       }","+      dataMap.putIfAbsent(ID, UUID.randomUUID().toString());"," ","       setIndex(permissionsCopy);"," ","@@ -121,41 +139,54 @@ public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation","   UPDATE_PERMISSION(\"update-permission\") {","     @Override","     public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation op) {","-      Integer index = op.getInt(INDEX);","+      Integer index = op.getInt(INDEX, null);","+      String id = op.getStr(ID, null);","       if (op.hasError()) return null;","+      if (index == null && id == null) {","+        op.addError(\"Use 'index' or 'id'\");","+        return null;","+      }"," ","       List<Map<String, Object>> permissions =","           AutorizationEditOperation.ensureIndexOnPermissions(latestConf);","       for (Map<String, Object> permission : permissions) {","-        if (index.equals(getIndex(permission))) {","+        if (id == null ? index.equals(getIndex(permission)) : id.equals(permission.get(ID))) {","+          if (index != null && !index.equals(getIndex(permission))) {","+            op.addError(ID_INDEX_MISMATCH);","+            return null;","+          }","           LinkedHashMap<String, Object> copy = new LinkedHashMap<>(permission);","           copy.putAll(op.getDataMap());","+          copy.remove(ID);","           op.setCommandData(copy);","           latestConf.put(PERMISSIONS, permissions);","           return SET_PERMISSION.edit(latestConf, op);","         }","       }","-      op.addError(\"No such permission \" + name);","+      op.addError(id == null ? \"No such permission \" + name : \"No such permission id: \" + id);","       return null;","     }","   },","   DELETE_PERMISSION(\"delete-permission\") {","     @Override","     public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation op) {","-      Integer id = op.getInt(\"\");","+      boolean byId = op.getCommandData() instanceof Map;","+      Object key = byId ? op.getStr(ID) : op.getInt(\"\");","       if (op.hasError()) return null;"," ","       // find the permission to delete using the \"index\"","       List<Map<String, Object>> p = AutorizationEditOperation.ensureIndexOnPermissions(latestConf);","-      if (p.stream().anyMatch(map -> id.equals(getIndex(map)))) {","+      Predicate<Map<String, Object>> match =","+          byId ? map -> key.equals(map.get(ID)) : map -> key.equals(getIndex(map));","+      if (p.stream().anyMatch(match)) {","         // filter out the deleted index, then re-order the remaining indexes","         List<Map<String, Object>> c =","-            p.stream().filter(map -> !id.equals(getIndex(map))).collect(Collectors.toList());","+            p.stream().filter(match.negate()).collect(Collectors.toList());","         setIndex(c);","         latestConf.put(PERMISSIONS, c);","         return latestConf;","       } else {","-        op.addError(\"No such index: \" + id);","+        op.addError(byId ? \"No such permission id: \" + key : \"No such index: \" + key);","         return null;","       }","     }","@@ -163,7 +194,9 @@ public Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation"," ","   private static final String PERMISSIONS = \"permissions\";","   private static final String INDEX = \"index\";","+  private static final String ID = \"id\";","   private static final String BEFORE = \"before\";","+  private static final String ID_INDEX_MISMATCH = \"'id' and 'index' name different permissions\";"," ","   public final String name;"," ","@@ -191,14 +224,33 @@ private static List<Map<String, Object>> ensureIndexOnPermissions(","       Map<String, Object> latestConf) {","     List<Map<String, Object>> permissions =","         (List<Map<String, Object>>) getListValue(latestConf, PERMISSIONS);","-    // see if any permissions have \"index\" set ...","-    if (permissions.stream().noneMatch(map -> map.containsKey(INDEX))) {","-      // \"index\" not set on the list of permissions, add it now ...","+    Set<Integer> indexes = new HashSet<>();","+    if (!permissions.stream()","+        .allMatch(map -> map.get(INDEX) instanceof Number && indexes.add(getIndex(map)))) {","       setIndex(permissions);","     }","+    ensureIds(permissions);","     return permissions;","   }"," ","+  // Derived from position and content, not random, so a read that backfills without persisting","+  // returns the same ids on every node and every call.","+  private static void ensureIds(List<Map<String, Object>> permissions) {","+    Set<Object> seen = new HashSet<>();","+    for (int i = 0; i < permissions.size(); i++) {","+      Map<String, Object> perm = permissions.get(i);","+      Object id = perm.get(ID);","+      if (id instanceof String && seen.add(id)) continue;","+      Map<String, Object> content = new TreeMap<>(perm);","+      content.remove(ID);","+      content.remove(INDEX);","+      String seed = i + \":\" + Utils.toJSONString(content);","+      String newId = UUID.nameUUIDFromBytes(seed.getBytes(StandardCharsets.UTF_8)).toString();","+      perm.put(ID, newId);","+      seen.add(newId);","+    }","+  }","+","   public abstract Map<String, Object> edit(Map<String, Object> latestConf, CommandOperation op);"," ","   public String getOperationName() {"],"additions":62,"deletions":10,"truncated":false},{"path":"solr/core/src/test/org/apache/solr/security/BaseTestRuleBasedAuthorizationPlugin.java","lines":["@@ -22,6 +22,7 @@"," import java.io.IOException;"," import java.io.StringReader;"," import java.security.Principal;","+import java.util.ArrayList;"," import java.util.Arrays;"," import java.util.Collection;"," import java.util.Collections;","@@ -809,8 +810,130 @@ public void testEditRules() throws IOException {","     assertEquals(0, permList.size());","   }"," ","+  public void testDeleteByIdTwiceRemovesOnlyThatPermission() throws IOException {","+    Perms perms = new Perms();","+    perms.runCmd(\"{set-permission : {name: all, role: admin}}\", true);","+    perms.runCmd(\"{set-permission : {name: read, role: dev}}\", true);","+    perms.runCmd(\"{set-permission : {name: update, role: dev}}\", true);","+    Object readId = perms.getVal(\"permissions[1]/id\");","+    assertNotNull(readId);","+","+    perms.runCmd(\"{delete-permission : {id : '\" + readId + \"'}}\", true);","+    perms.runCmd(\"{delete-permission : {id : '\" + readId + \"'}}\", false);","+    assertEquals(","+        List.of(\"No such permission id: \" + readId), perms.parsedCommands.get(0).getErrors());","+    assertEquals(List.of(\"all\", \"update\"), perms.names());","+  }","+","+  public void testIdsSurviveRenumbering() throws IOException {","+    Perms perms = new Perms();","+    perms.runCmd(\"{set-permission : {name: read, role: a}}\", true);","+    perms.runCmd(\"{set-permission : {name: update, role: a}}\", true);","+    perms.runCmd(\"{set-permission : {name: config-edit, role: a}}\", true);","+    Object updateId = perms.getVal(\"permissions[1]/id\");","+    Object configId = perms.getVal(\"permissions[2]/id\");","+","+    perms.runCmd(\"{delete-permission : 1}\", true);","+    perms.runCmd(\"{set-permission : {name: schema-edit, role: a, before: 1}}\", true);","+    assertEquals(List.of(\"schema-edit\", \"update\", \"config-edit\"), perms.names());","+    Object schemaId = perms.getVal(\"permissions[0]/id\");","+    assertNotNull(schemaId);","+    assertNotEquals(updateId, schemaId);","+    assertNotEquals(configId, schemaId);","+","+    perms.runCmd(\"{update-permission : {id: '\" + configId + \"', role: c}}\", true);","+    perms.runCmd(\"{set-permission : {name: update, role: d, index: 2}}\", true);","+    assertEquals(updateId, perms.getVal(\"permissions[1]/id\"));","+    assertEquals(\"d\", perms.getVal(\"permissions[1]/role\"));","+    assertEquals(configId, perms.getVal(\"permissions[2]/id\"));","+    assertEquals(\"c\", perms.getVal(\"permissions[2]/role\"));","+    assertEquals(3, perms.getVal(\"permissions[2]/index\"));","+","+    perms.runCmd(\"{update-permission : {id: '\" + configId + \"', index: 2, role: e}}\", false);","+    perms.runCmd(\"{update-permission : {id: nope, role: e}}\", false);","+    assertEquals(List.of(\"No such permission id: nope\"), perms.parsedCommands.get(0).getErrors());","+  }","+","+  public void testBackfilledIdsAreDeterministicAndUnique() throws IOException {","+    List<List<Object>> runs = new ArrayList<>();","+    for (int run = 0; run < 2; run++) {","+      Perms perms = new Perms();","+      List<Map<String, Object>> stored = new ArrayList<>();","+      stored.add(new HashMap<>(Map.of(\"name\", \"read\", \"role\", \"a\")));","+      stored.add(new HashMap<>(Map.of(\"name\", \"update\", \"role\", \"a\", \"id\", \"dup\")));","+      stored.add(new HashMap<>(Map.of(\"name\", \"read\", \"role\", \"a\", \"id\", \"dup\")));","+      perms.conf.put(\"permissions\", stored);","+      perms.runCmd(\"{update-permission : {index: 2, role: a}}\", true);","+      runs.add(perms.permissions().stream().map(p -> p.get(\"id\")).toList());","+    }","+    assertEquals(runs.get(0), runs.get(1));","+    assertEquals(\"dup\", runs.get(0).get(1));","+    assertEquals(3, Set.copyOf(runs.get(0)).size());","+  }","+","+  public void testUpdateByIdWithPartialIndexes() throws IOException {","+    Perms perms = new Perms();","+    List<Map<String, Object>> stored = new ArrayList<>();","+    stored.add(new HashMap<>(Map.of(\"name\", \"read\", \"role\", \"a\", \"index\", 1)));","+    stored.add(new HashMap<>(Map.of(\"name\", \"update\", \"role\", \"a\", \"id\", \"u1\")));","+    stored.add(new HashMap<>(Map.of(\"name\", \"config-edit\", \"role\", \"a\")));","+    perms.conf.put(\"permissions\", stored);","+","+    perms.runCmd(\"{update-permission : {id: u1, role: b}}\", true);","+    assertEquals(List.of(\"read\", \"update\", \"config-edit\"), perms.names());","+    assertEquals(\"a\", perms.getVal(\"permissions[0]/role\"));","+    assertEquals(\"b\", perms.getVal(\"permissions[1]/role\"));","+    assertEquals(\"a\", perms.getVal(\"permissions[2]/role\"));","+  }","+","+  public void testZeroBasedIndexesStillWork() throws IOException {","+    Perms perms = new Perms();","+    List<Map<String, Object>> stored = new ArrayList<>();","+    stored.add(new HashMap<>(Map.of(\"name\", \"read\", \"role\", \"a\", \"index\", 0)));","+    stored.add(new HashMap<>(Map.of(\"name\", \"update\", \"role\", \"a\", \"index\", 1)));","+    perms.conf.put(\"permissions\", stored);","+    perms.runCmd(\"{delete-permission : 0}\", true);","+    assertEquals(List.of(\"update\"), perms.names());","+  }","+","+  public void testReadModifyWriteKeepsId() throws IOException {","+    Perms perms = new Perms();","+    perms.runCmd(\"{set-permission : {name: read, role: a}}\", true);","+    perms.runCmd(\"{set-permission : {name: update, role: a}}\", true);","+    Object readId = perms.getVal(\"permissions[0]/id\");","+","+    Map<String, Object> read = new HashMap<>(perms.permissions().get(0));","+    read.put(\"role\", \"b\");","+    perms.runCmd(Utils.toJSONString(Map.of(\"update-permission\", read)), true);","+    read.put(\"role\", \"c\");","+    perms.runCmd(Utils.toJSONString(Map.of(\"set-permission\", read)), true);","+    assertEquals(readId, perms.getVal(\"permissions[0]/id\"));","+    assertEquals(\"c\", perms.getVal(\"permissions[0]/role\"));","+","+    read.put(\"index\", 2);","+    perms.runCmd(Utils.toJSONString(Map.of(\"set-permission\", read)), false);","+    read.remove(\"index\");","+    perms.runCmd(Utils.toJSONString(Map.of(\"set-permission\", read)), false);","+  }","+","+  public void testClientCannotSetId() throws IOException {","+    Perms perms = new Perms();","+    perms.runCmd(\"{set-permission : {name: read, role: a, id: mine}}\", false);","+    assertEquals(List.of(\"'id' is assigned by Solr\"), perms.parsedCommands.get(0).getErrors());","+  }","+","   static class Perms {","     Map<String, Object> conf = new HashMap<>();","+","+    @SuppressWarnings(\"unchecked\")","+    List<Map<String, Object>> permissions() {","+      return (List<Map<String, Object>>) getVal(\"permissions\");","+    }","+","+    List<Object> names() {","+      return permissions().stream().map(p -> p.get(\"name\")).toList();","+    }","+","     ConfigEditablePlugin plugin = new RuleBasedAuthorizationPlugin();","     List<CommandOperation> parsedCommands;"," "],"additions":123,"deletions":0,"truncated":false},{"path":"solr/solr-ref-guide/modules/deployment-guide/pages/rule-based-authorization-plugin.adoc","lines":["@@ -530,8 +530,13 @@ curl --user solr:SolrRocks -H 'Content-type:application/json' -d '{"," "," === Update or Delete Permissions"," ","-Permissions can be accessed using their index in the list.","-Use the `/admin/authorization` API to see the existing permissions and their indices.","+Permissions can be accessed using their `id` or their index in the list.","+Use the `/admin/authorization` API to see the existing permissions, their ids and their indices.","+","+Solr assigns each permission an `id` the first time permissions are edited, and keeps it until the permission is deleted.","+A permission read from the API can be sent back as is: an `id` is accepted when it matches the permission at the given `index`.","+Moving a permission in the Admin UI deletes and re-creates it, so it gets a new id.","+The index is the permission's current position, so it changes when a permission before it is added or deleted."," "," The following example updates the `'role'` attribute of permission at index `3`:"," ","@@ -548,6 +553,13 @@ curl --user solr:SolrRocks -H 'Content-type:application/json' -d '{","   \"delete-permission\": 3"," }' http://localhost:8983/solr/admin/authorization"," ","+To address a permission by id, send `id` instead of `index`. `delete-permission` takes `{\"id\": \"...\"}` the same way; its object form accepts only `id`, so delete by index with the bare number shown above:","+","+[source,bash]","+curl --user solr:SolrRocks -H 'Content-type:application/json' -d '{","+  \"update-permission\": {\"id\": \"0b1c...\", \"role\": [\"admin\", \"dev\"]}","+}' http://localhost:8983/solr/admin/authorization","+"," "," === Map Roles to Users"," "],"additions":14,"deletions":2,"truncated":false},{"path":"solr/solr-ref-guide/modules/upgrade-notes/pages/major-changes-in-solr-10.adoc","lines":["@@ -91,6 +91,12 @@ A request with no other parameters returns every collection."," "," The v1 `CLUSTERSTATUS` command is unchanged, and `includeAll` still defaults to true."," ","+=== Permissions have a stable `id`","+","+Editing permissions of the Rule-Based Authorization Plugin now stores an `id` on each permission in `security.json`.","+Finish a rolling upgrade before editing permissions.","+Nodes running an older version reject commands that name an `id` and any `update-permission` on a permission that has one, and drop the `id` of any permission they replace.","+"," == Solr 10.1"," "," === Misc"],"additions":6,"deletions":0,"truncated":false},{"path":"solr/solrj/src/java/org/apache/solr/client/solrj/request/beans/UpdateRuleBasedAuthPermissionPayload.java","lines":["@@ -32,8 +32,9 @@ public class UpdateRuleBasedAuthPermissionPayload implements ReflectMapWriter {"," ","   @JsonProperty public List<String> path;"," ","-  @JsonProperty(required = true)","-  public Integer index;","+  @JsonProperty public Integer index;","+","+  @JsonProperty public String id;"," ","   @JsonProperty public Integer before;"," ",""],"additions":3,"deletions":2,"truncated":false}],"additions":216,"deletions":14,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-28T17:10:12.895795+00:00"}