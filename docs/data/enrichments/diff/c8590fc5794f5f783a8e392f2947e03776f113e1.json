{","+            continue;","+        };","+        if !is_claimed(name, provided, windows)","+            && !is_symlink_or_junction(bins_dir)","+            && is_pnpm_bin_entry(&path)","+        {","+            remove_if_exists(&path).map_err(|error| LinkBinsError::RemoveStaleBin { path, error })?;","+        }","+    }","+    Ok(())","+}","+","+fn is_symlink_or_junction(path: &Path) -> bool {","+    std::fs::symlink_metadata(path).is_ok_and(|meta| meta.file_type().is_symlink())","+        || pnpm_fs::read_symlink_dir(path).is_ok()","+}","+","+fn is_pnpm_bin_entry(path: &Path) -> bool {","+    let Ok(meta) = std::fs::symlink_metadata(path) else {","+        return false;","+    };","+    if meta.file_type().is_symlink() {","+        return true;","+    }","+    if !meta.file_type().is_file() {","+        return false;","+    }","+    if cfg!(windows)","+        && path","+            .file_name()","+            .and_then(|name| name.to_str())","+            .is_some_and(|name| name.eq_ignore_ascii_case(\"node.exe\"))","+    {","+        return true;","+    }","+    let mut head = [0u8; 128];","+    let Ok(read) = crate::read_head_filled::<crate::Host>(path, &mut head) else {","+        return false;","+    };","+    let prefix = head[..read]","+        .strip_prefix(b\"\\xEF\\xBB\\xBF\")","+        .unwrap_or(&head[..read]);","+    prefix.starts_with(b\"#!/bin/sh\\n# Resolve $0 through symlinks\")","+        || prefix.starts_with(b\"#!/bin/sh\\nbasedir=\")","+        || prefix.starts_with(b\"@SETLOCAL\\r\\n\")","+        || prefix.starts_with(b\"@IF EXIST\")","+        || prefix.starts_with(b\"#!/usr/bin/env pwsh\\n$basedir=\")","+}","+"," pub(super) fn removable_names(","     name: &str,","     provided: &HashSet<String>,","@@ -22,20 +107,22 @@ pub(super) fn removable_names(","     if windows {","         names.extend([\"cmd\", \"ps1\", \"exe\"].map(|extension| format!(\"{name}.{extension}\")));","     }","-    names.retain(|name| {","-        let name = normalize(name, windows);","-        !(provided.contains(&name)","-            || windows","-                && [\".cmd\", \".ps1\", \".exe\"]","-                    .iter()","-                    .any(|suffix| {","-                        name.strip_suffix(suffix)","-                            .is_some_and(|base| provided.contains(base))","-                    }))","-    });","+    names.retain(|name| !is_claimed(name, provided, windows));","     names"," }"," ","+pub(super) fn is_claimed(name: &str, provided: &HashSet<String>, windows: bool) -> bool {","+    let name = normalize(name, windows);","+    provided.contains(&name)","+        || windows","+            && [\".cmd\", \".ps1\", \".exe\"]","+                .iter()","+                .any(|suffix| {","+                    name.strip_suffix(suffix)","+                        .is_some_and(|base| provided.contains(base))","+                })","+}","+"," pub(super) fn normalize(name: &str, windows: bool) -> String {","     if windows { name.to_lowercase() } else { name.to_owned() }"," }"],"additions":99,"deletions":12,"truncated":false},{"path":"pnpm/crates/cmd-shim/src/link_bins/refresh/tests.rs","lines":["@@ -219,3 +219,41 @@ fn newly_created_manifest_adds_a_provider_then_deletion_restores_prior_winners()","     assert!(fs::read_to_string(bins.join(\"tool\")).unwrap().contains(\"rival\"));","     assert!(!bins.join(\"fresh\").exists());"," }","+","+#[test]","+fn prune_stale_bins_removes_unclaimed_shims_and_keeps_claimed_commands() {","+    let temp = tempfile::tempdir().unwrap();","+    let modules = temp.path().join(\"node_modules\");","+    let bins = modules.join(\".bin\");","+    super::prune_stale_bins(&bins, &HashSet::new()).unwrap();","+    package(&modules, \"keep\", \"keep\");","+    package(&modules, \"stale\", \"stale\");","+    let options = LinkBinsOptions { force: true, ..LinkBinsOptions::default() };","+    link_bins::<Host>(&modules, &bins, &options).unwrap();","+    fs::write(bins.join(\"user-script\"), \"#!/usr/bin/env bash\\necho user\\n\").unwrap();","+    fs::create_dir(bins.join(\"user-dir\")).unwrap();","+    super::prune_stale_bins(&bins, &HashSet::from([\"keep\".to_owned()])).unwrap();","+    assert!(bins.join(\"keep\").exists());","+    assert!(!bins.join(\"stale\").exists());","+    assert!(bins.join(\"user-script\").exists());","+    assert!(bins.join(\"user-dir\").exists());","+    if cfg!(windows) {","+        assert!(bins.join(\"keep.cmd\").exists());","+        assert!(!bins.join(\"stale.cmd\").exists());","+    }","+}","+","+#[test]","+fn prune_stale_bins_does_not_traverse_symlinked_bins_dir() {","+    let temp = tempfile::tempdir().unwrap();","+    let outside = temp.path().join(\"outside\");","+    let modules = temp.path().join(\"node_modules\");","+    fs::create_dir_all(&outside).unwrap();","+    fs::create_dir_all(&modules).unwrap();","+    let target_shim = outside.join(\"stale\");","+    fs::write(&target_shim, \"#!/bin/sh\\n# Resolve $0 through symlinks\\n\").unwrap();","+    let bins = modules.join(\".bin\");","+    pnpm_fs::symlink_dir(&outside, &bins).unwrap();","+    super::prune_stale_bins(&bins, &HashSet::new()).unwrap();","+    assert!(target_shim.exists());","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"pnpm/crates/cmd-shim/src/link_bins/source.rs","lines":["@@ -0,0 +1,132 @@","+use super::{","+    BTreeMap, Command, FsWalkFiles, PackageBin, PathBuf, Value, commands_from_precalculated_bins,","+    get_bins_from_package_manifest,","+};","+use std::sync::Arc;","+","+/// One package known to be installed at `location`, with its parsed","+/// `package.json`. The per-package input to [`super::link_bins_of_packages`].","+///","+/// The manifest is shared via `Arc` rather than owned by value: the","+/// lockfile-driven bin-link path looks up the same parsed manifest","+/// from a process-wide map, so packing it into a [`PackageBinSource`]","+/// is a refcount bump (cheap) rather than a deep clone of the JSON","+/// tree (which would have been the bulk of the per-slot CPU work,","+/// since the per-install clone count is `slots × children` =","+/// thousands of times).","+#[derive(Debug, Clone)]","+pub struct PackageBinSource {","+    pub location: PathBuf,","+    pub manifest: Arc<Value>,","+    /// Where this candidate came from. When a hoisted (transitive)","+    /// dep and a direct dep both declare the same bin name, the","+    /// direct dep must win so a project never gets its own tooling","+    /// silently shadowed by a transitive's bin. Defaults to","+    /// [`BinOrigin::Direct`] —","+    /// constructions via [`PackageBinSource::new`] don't have to","+    /// supply the field.","+    pub origin: BinOrigin,","+    /// The package directory with every symlink resolved — the","+    /// virtual-store slot dir a symlinked [`location`] points at.","+    /// Callers that already know it (the lockfile-driven passes","+    /// derive it from the snapshot key and the store layout) set it so","+    /// the shim `NODE_PATH` derives lexically; when `None` the linker","+    /// falls back to one `canonicalize` per package.","+    ///","+    /// [`location`]: Self::location","+    pub resolved_location: Option<PathBuf>,","+    /// Whether the package's lifecycle scripts have yet to run in this","+    /// install. Such a package's bin is not linked while its target is","+    /// missing, because the scripts may create it and run with this","+    /// `.bin` on `PATH`. The linking pass after the build links it.","+    pub build_pending: bool,","+    /// Precalculated bin targets and shebang runtimes from `dist.pnpr.bins` or","+    /// archive extraction. Used when `build_pending` is `false` to skip on-disk","+    /// `directories.bin` directory walks, missing-target head reads, and","+    /// shebang reads.","+    pub precalculated_bins: Option<Arc<BTreeMap<String, PackageBin>>>,","+}","+","+impl PackageBinSource {","+    /// Construct a [`PackageBinSource`] tagged as","+    /// [`BinOrigin::Direct`]. Use this for direct-dependency","+    /// candidates and for any call site that doesn't need to","+    /// distinguish direct from hoisted (per-slot bin linking,","+    /// most tests).","+    #[must_use]","+    pub fn new(location: PathBuf, manifest: Arc<Value>) -> Self {","+        Self {","+            location,","+            manifest,","+            origin: BinOrigin::Direct,","+            resolved_location: None,","+            build_pending: false,","+            precalculated_bins: None,","+        }","+    }","+","+    /// Tag this source with the given [`BinOrigin`].","+    #[must_use]","+    pub fn with_origin(mut self, origin: BinOrigin) -> Self {","+        self.origin = origin;","+        self","+    }","+","+    /// Record the symlink-resolved package directory. See","+    /// [`Self::resolved_location`].","+    #[must_use]","+    pub fn with_resolved_location(mut self, resolved_location: PathBuf) -> Self {","+        self.resolved_location = Some(resolved_location);","+        self","+    }","+","+    /// Mark the package's lifecycle scripts as not yet run. See","+    /// [`Self::build_pending`].","+    #[must_use]","+    pub fn with_build_pending(mut self, build_pending: bool) -> Self {","+        self.build_pending = build_pending;","+        self","+    }","+","+    /// Attach precalculated bin metadata (`dist.pnpr.bins` or archive-extracted","+    /// bins).","+    #[must_use]","+    pub fn with_precalculated_bins(","+        mut self,","+        precalculated_bins: Option<Arc<BTreeMap<String, PackageBin>>>,","+    ) -> Self {","+        self.precalculated_bins = precalculated_bins;","+        self","+    }","+","+    pub(crate) fn resolve_commands<Sys: FsWalkFiles>(&self) -> Vec<Command> {","+        if !self.build_pending","+            && let Some(bins) = &self.precalculated_bins","+            && let Some(commands) = commands_from_precalculated_bins(bins, &self.location)","+        {","+            return commands;","+        }","+        get_bins_from_package_manifest::<Sys>(&self.manifest, &self.location)","+    }","+}","+","+/// Origin of a [`PackageBinSource`] determining precedence during conflict resolution:","+/// direct dependencies take precedence over publicly hoisted packages, which take precedence","+/// over auto-installed peers.","+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]","+pub enum BinOrigin {","+    /// The candidate is a direct dependency of the importer","+    /// installing it. Direct deps come from the per-importer","+    /// `dependencies` / `devDependencies` / `optionalDependencies`","+    /// maps in the lockfile / manifest.","+    #[default]","+    Direct,","+    /// The candidate is a transitive dependency that the hoister","+    /// lifted to a top-level (or per-`node_modules`) slot. Bins","+    /// from these candidates are dropped when a same-named","+    /// [`Self::Direct`] candidate is also present.","+    Hoisted,","+    /// An auto-installed peer exposed to a project; its bin must not","+    /// replace a directly installed or publicly hoisted command.","+    Peer,","+}"],"additions":132,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/build_phase.rs","lines":["@@ -113,10 +113,7 @@ pub struct BuildPhaseInputs<'a> {","     pub policy: crate::BuildPhasePolicy<'a>,","     pub extra_env: &'a HashMap<String, String>,","     pub skipped: &'a SkippedSnapshots,","-    /// Nested `.bin` directories the hoisted linker held bins back in. See","-    /// [`crate::link_hoisted_modules()`].","-    pub held_back_bins_dirs: &'a [crate::HeldBackBinsDir],","-    pub hoisted_bin_sources: Option<&'a crate::HoistedBinSources>,","+    pub pending_bins: Option<&'a crate::linking::PendingBinLinks>,"," }"," "," /// Run dependency lifecycle scripts, report ignored builds, and","@@ -186,24 +183,11 @@ fn finish_bin_links(","         return Ok(());","     }","     finish_dependency_bin_links(inputs, build_output, bin_st