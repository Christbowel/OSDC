( new CUBRIDDialect(), Policy.PLAIN ),","+\t\t\t\tprofile( new MaxDBDialect(), Policy.PLAIN ),","+\t\t\t\tprofile( new MimerSQLDialect(), Policy.PLAIN ),","+\t\t\t\tprofile( new SingleStoreDialect( v( 8 ), null, true ), Policy.PLAIN ),","+\t\t\t\tprofile( new SingleStoreDialect( v( 8 ), null, false ), Policy.RETAIN ),","+\t\t\t\tprofile( new CacheDialect(), Policy.RETAIN ),","+\t\t\t\tprofile( new IngresDialect(), Policy.RETAIN ),","+\t\t\t\tprofile( new InterSystemsIRISDialect(), Policy.RETAIN ),","+\t\t\t\tprofile( new RDMSOS2200Dialect(), Policy.RETAIN ),","+\t\t\t\tprofile( new SQLiteDialect(), Policy.RETAIN )","+\t\t);","+\t}","+","+\tprivate static Arguments profile(org.hibernate.dialect.Dialect dialect, Policy policy) {","+\t\treturn Arguments.of( dialect.getClass().getSimpleName() + \" \" + dialect.getVersion(), dialect.getLockingSupport(), policy );","+\t}","+","+\t@ParameterizedTest(name = \"{0}: {2}\")","+\t@MethodSource(\"profiles\")","+\tvoid classifiesEveryEligibleModePair(String name, LockingSupport support, Policy policy) {","+\t\tfor ( var held : LockMode.values() ) {","+\t\t\tif ( held.isPessimistic() ) {","+\t\t\t\tfor ( var requested : LockMode.values() ) {","+\t\t\t\t\tif ( requested != LockMode.WRITE && !requested.greaterThan( held ) ) {","+\t\t\t\t\t\tfinal boolean expected = policy == Policy.PLAIN","+\t\t\t\t\t\t\t\t|| policy == Policy.OWN_WRITE && held == LockMode.PESSIMISTIC_FORCE_INCREMENT;","+\t\t\t\t\t\tassertThat( support.canUsePlainReadForRefresh( held, requested ) )","+\t\t\t\t\t\t\t\t.as( \"%s: %s -> %s\", name, held, requested ).isEqualTo( expected );","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+","+\tenum Policy { PLAIN, OWN_WRITE, RETAIN }","+","+\tprivate static DatabaseVersion v(int major, int minor, int micro) {","+\t\treturn DatabaseVersion.make( major, minor, micro );","+\t}","+","+\tprivate static DatabaseVersion v(int major, int minor) { return v( major, minor, 0 ); }","+\tprivate static DatabaseVersion v(int m