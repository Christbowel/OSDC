ons, source ) );"," \t\t\t\t// But prepare to reset the entry lock mode to the previous"," \t\t\t\t// lock mode after the refresh completes, except in the case"," \t\t\t\t// where the two lock modes belong to the same level, in which","@@ -280,6 +281,18 @@ private static void evictEntity("," \t\treturn result;"," \t}"," ","+\tprivate static LockMode refreshLockMode(LockMode currentMode, LockOptions requested, EventSource source) {","+\t\tif ( currentMode.isPessimistic()","+\t\t\t\t&& (requested.getLockScope() != jakarta.persistence.PessimisticLockScope.NORMAL","+\t\t\t\t\t\t|| !source.getJdbcServices().getDialect().getLockingSupport()","+\t\t\t\t\t\t\t\t.canUsePlainReadForRefresh( currentMode, requested.getLockMode() )) ) {","+\t\t\t// Force increment and legacy upgrade modes describe actions already","+\t\t\t// performed. A refresh only needs their non-incrementing protection.","+\t\t\treturn currentMode == LockMode.PESSIMISTIC_READ ? LockMode.PESSIMISTIC_READ : LockMode.PESSIMISTIC_WRITE;","+\t\t}","+\t\treturn LockMode.READ;","+\t}","+"," \tprivate static boolean isReadOnly("," \t\t\t@Nullable EntityEntry entry,"," \t\t\t@Nonnull EntityPersister persister,"],"additions":17,"deletions":4,"truncated":false},{"path":"hibernate-core/src/test/java/org/hibernate/orm/test/dialect/unit/locking/RefreshLockingPolicyTest.java","lines":["@@ -0,0 +1,97 @@","+package org.hibernate.orm.test.dialect.unit.locking;","+","+import java.util.stream.Stream;","+","+import org.hibernate.LockMode;","+import org.hibernate.dialect.DatabaseVersion;","+import org.hibernate.dialect.lock.spi.LockingSupport;","+","+import org.junit.jupiter.params.ParameterizedTest;","+import org.junit.jupiter.params.provider.Arguments;","+import org.junit.jupiter.params.provider.MethodSource;","+","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.hibernate.dialect.lock.spi.StandardLockingSupports.*;","+import static org.mockito.Mockito.CALLS_REAL_METHODS;","+import static org.mock