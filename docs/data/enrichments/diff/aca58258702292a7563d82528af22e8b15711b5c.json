;"," ","+\t@Override","+\tpublic boolean canUsePlainReadForRefresh(LockMode currentLockMode, LockMode requestedLockMode) {","+\t\t// Retain the plain reload once the row is protected by this transaction.","+\t\treturn true;","+\t}","+"," \t@Override"," \tpublic org.hibernate.dialect.lock.spi.TransactionConcurrencyResolver getTransactionConcurrencyResolver() {"," \t\treturn TimesTenTransactionConcurrencyResolver.INSTANCE;"],"additions":7,"deletions":0,"truncated":false},{"path":"hibernate-core/src/main/java/org/hibernate/dialect/lock/spi/LockingSupport.java","lines":["@@ -40,6 +40,27 @@"," @Incubating(since = \"7.1\", group = \"dialect-locking\")"," @SPI({ USE, IMPLEMENT, SUPPLY })"," public interface LockingSupport {","+\t/// Whether an equal or weaker refresh request may reload using the non-locking","+\t/// [LockMode#READ] after the entity has already acquired `currentLockMode`.","+\t/// Retaining the row lock alone does not establish that an ordinary reload","+\t/// uses the same read view as the preceding locking read.","+\t///","+\t/// Hibernate invokes this predicate only for a pessimistic current mode, an","+\t/// equal or weaker requested mode, and normal lock scope. The request's mode","+\t/// is passed unchanged: `refresh(entity)` uses [LockMode#READ], whereas an","+\t/// explicit no-lock request uses [LockMode#NONE]. Both arguments are non-null.","+\t/// A `true` result must preserve read visibility and conflict semantics under","+\t/// the configurations supported by this profile. Hibernate separately handles","+\t/// the entry's final mode, version actions, wider scope and other lock options.","+\t///","+\t/// The default retains a non-incrementing pessimistic reload.","+\t///","+\t/// @since 8.0","+\t@SPI({ USE, IMPLEMENT })","+\tdefault boolean canUsePlainReadForRefresh(LockMode currentLockMode, LockMode requestedLockMode) {","+\t\treturn false;","+\t}","+"," \t/// Resolves environment-specific concurrency facts without retaining or"," \t/// modifying