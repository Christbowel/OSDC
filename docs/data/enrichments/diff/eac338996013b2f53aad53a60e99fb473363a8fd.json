y {","+            task.validateScripts();","+            fail(\"GradleException was expected\");","+        } catch (GradleException e) {","+            for (int line : List.of(1, 2, 3, 4, 5, 6, 7, 10)) {","+                assertTrue(e.getMessage(), e.getMessage().contains(\"[eager-test-seed] x-pack/plugin/foo/qa/s3/build.gradle:\" + line));","+            }","+        }","+    }","+","+    /**","+     * A long property chain with no read must fail to match quickly; whitespace that two parts of the pattern could both","+     * match made this take exponential time.","+     */","+    @Test(timeout = 10_000)","+    public void testEagerTestSeedRuleDoesNotBacktrackOnLongChains() throws Exception {","+        Project project = createProject();","+        List<String> lines = new ArrayList<>();","+        lines.add(\"def x = buildParams.random\");","+        for (int i = 0; i < 30; i++) {","+            lines.add(\"        .p\" + i);","+        }","+        lines.add(\"println x\");","+        File scriptFile = writeFile(project, \"x-pack/plugin/foo/build.gradle\", lines);","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        task.validateScripts();","+","+        assertOutputMarkerWritten(task);","+    }","+","+    @Test","+    public void testAllowsLazyTestSeedUse() throws Exception {","+        Project project = createProject();","+        File scriptFile = writeFile(","+            project,","+            \"x-pack/plugin/foo/qa/s3/build.gradle\",","+            List.of(","+                \"nonInputProperties.systemProperty 'base', buildParams.testSeedProvider.map { seed -> 'base_' + seed }\",","+                \"nonInputProperties.systemProperty 'flag', buildParams.random.map{r -> r.nextBoolean()}\",","+                \"nonInputProperties.systemProperty 'path', buildParams.testSeedProvider.map { s -> basePath.get() + s }\",","+                \"nonInputProperties.systemProperty 'n', buildParams.random.map { r -> r.nextInt(10) }.map { n -> names.getOrElse(n, 'x') }\",","+                \"def bucket = providers.environmentVariable('BUCKET').get()\"","+            )","+        );","+        ValidateBuildGradleScriptsTask task = createTask(project, scriptFile);","+","+        task.validateScripts();","+","+        assertOutputMarkerWritten(task);","+    }","+","     @Test","     public void testCountedIgnoreSuppressesExactlyTheBaselinedNumberOfViolations() throws Exception {","         Project project = createProject();"],"additions":74,"deletions":0,"truncated":false},{"path":"build-tools/src/main/java/org/elasticsearch/gradle/test/SystemPropertyCommandLineArgumentProvider.java","lines":["@@ -8,6 +8,7 @@","  */"," package org.elasticsearch.gradle.test;"," ","+import org.gradle.api.provider.Provider;"," import org.gradle.api.tasks.Input;"," import org.gradle.process.CommandLineArgumentProvider;"," ","@@ -31,15 +32,25 @@ public void systemProperty(String key, Object value) {","     public Iterable<String> asArguments() {","         return systemProperties.entrySet()","             .stream()","-            .map(","-                entry -> \"-D\"","-                    + entry.getKey()","-                    + \"=\"","-                    + (entry.getValue() instanceof Supplier ? ((Supplier) entry.getValue()).get() : entry.getValue())","-            )","+            .map(entry -> \"-D\" + entry.getKey() + \"=\" + resolve(entry.getValue()))","             .collect(Collectors.toList());","     }"," ","+    /**","+     * Resolves lazy values when the test JVM is launched. Providers are checked explicitly: Gradle's own providers also","+     * implement {@link Supplier}, but only through an internal interface, so relying on that would break silently and","+     * pass the provider's description instead of its value.","+     */","+    private static Object resolve(Object value) {","+        if (value instanceof Provider<?> provider) {","+            return provider.get();","+        }","+        if (value instanceof Supplier<?> supplier) {","+            return supplier.get();","+        }","+        return value;","+    }","+","     // Track system property keys as an input so our build cache key will change if we add properties but values are still ignored","     @Input","     public Iterable<String> getPropertyNames() {"],"additions":17,"deletions":6,"truncated":false},{"path":"build-tools/src/test/groovy/org/elasticsearch/gradle/test/SystemPropertyCommandLineArgumentProviderSpec.groovy","lines":["@@ -0,0 +1,61 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the \"Elastic License","+ * 2.0\", the \"GNU Affero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+","+package org.elasticsearch.gradle.test","+","+import org.gradle.api.provider.Provider","+import org.gradle.testfixtures.ProjectBuilder","+","+import spock.lang.Specification","+","+import java.util.function.Supplier","+","+class SystemPropertyCommandLineArgumentProviderSpec extends Specification {","+","+    def \"resolves Gradle providers to their values\"() {","+        given:","+        def project = ProjectBuilder.builder().build()","+        def seed = project.provider { \"DEADBEEF\" }","+        def properties = new SystemPropertyCommandLineArgumentProvider()","+","+        when:","+        properties.systemProperty(\"tests.seed\", seed)","+        properties.systemProperty(\"test.base\", seed.map { s -> \"base_\" + s })","+","+        then:","+        properties.asArguments() == [\"-Dtests.seed=DEADBEEF\", \"-Dtest.base=base_DEADBEEF\"]","+    }","+","+    def \"resolves a provider that is not also a Supplier\"() {","+        given:","+        // Gradle's own providers happen to implement Supplier through an internal interface. This one does not, so it","+        // checks that providers are resolved through the public Provider API rather than by that accident.","+        Provider<String> provider = [get: { \"DEADBEEF\" }] as Provider<String>","+        def properties = new SystemPropertyCommandLineArgumentProvider()","+","+        when:","+        properties.systemProperty(\"tests.seed\", provider)","+","+        then:","+        (provider instanceof Supplier) == false","+        properties.asArguments() == [\"-Dtests.seed=DEADBEEF\"]","+    }","+","+    def \"resolves suppliers and passes plain values through\"() {","+        given:","+        def properties = new SystemPropertyCommandLineArgumentProvider()","+","+        when:","+        properties.systemProperty(\"supplied\", { -> \"from-supplier\" } as Supplier<String>)","+        properties.systemProperty(\"plain\", 42)","+","+        then:","+        properties.asArguments() == [\"-Dsupplied=from-supplier\", \"-Dplain=42\"]","+    }","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"modules/repository-gcs/build.gradle","lines":["@@ -281,7 +281,7 @@ def gcsThirdPartyTest = tasks.register(\"gcsThirdPartyUnitTest\", Test) {","   include '**/GoogleCloudStorageThirdPartyTests.class'","   systemProperty 'test.google.bucket', gcsBucket","   systemProperty 'test.google.fixture', Boolean.toString(useFixture)","-  nonInputProperties.systemProperty 'test.google.base', gcsBasePath + \"_third_party_tests_\" + buildParams.testSeed","+  nonInputProperties.systemProperty 'test.google.base', buildParams.testSeedProvider.map { seed -> gcsBasePath + \"_third_party_tests_\" + seed }","   if (useFixture == false) {","     nonInputProperties.systemProperty 'test.google.account', \"${-> encodedCredentials.call()}\"","   }"],"additions":1,"deletions":1,"truncated":false},{"path":"modules/repository-s3/qa/third-party/build.gradle","lines":["@@ -44