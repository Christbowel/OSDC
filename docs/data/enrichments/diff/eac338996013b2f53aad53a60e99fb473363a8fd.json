{"id":"eac338996013b2f53aad53a60e99fb473363a8fd","axis":"silent","repo":"elastic/elasticsearch","sha":"eac338996013b2f53aad53a60e99fb473363a8fd","parsed":{"files":[{"path":"build-tools-internal/src/main/java/org/elasticsearch/gradle/internal/ElasticsearchTestBasePlugin.java","lines":["@@ -173,7 +173,7 @@ public void execute(Task t) {","             if (System.getProperty(\"ignore.tests.seed\") != null || getBuildFeatures().getConfigurationCache().getActive().get()) {","                 nonInputProperties.systemProperty(\"tests.seed\", buildParams.get().getTestSeedProvider());","             } else {","-                test.systemProperty(\"tests.seed\", buildParams.get().getTestSeed());","+                test.systemProperty(\"tests.seed\", buildParams.get().getTestSeedProvider().get());","             }"," ","             // don't track these as inputs since they contain absolute paths and break cache relocatability"],"additions":1,"deletions":1,"truncated":false},{"path":"build-tools-internal/src/main/java/org/elasticsearch/gradle/internal/checks/ValidateBuildGradleScriptsTask.java","lines":["@@ -129,6 +129,7 @@ private List<ScriptRule> buildRules() {","         addDistributionBundledJdkRules(rules);","         addDistributionClosureAssignmentRules(rules);","         addDistributionExtClosureRules(rules);","+        addEagerTestSeedRules(rules);","         return rules;","     }"," ","@@ -215,6 +216,37 @@ private void addDistributionExtClosureRules(List<ScriptRule> rules) {","         );","     }"," ","+    /**","+     * Adds a guardrail against reading the test seed at configuration time. The seed is a configuration cache input when","+     * it is read while configuring, so a script that reads it ({@code get()}, {@code getOrNull()}, {@code getOrElse(...)}","+     * or {@code orNull}), or reads {@code buildParams.random}, which is derived from it, makes every build with a new seed","+     * miss the configuration cache. The rule follows the call chain from the provider, so a read inside a lazy closure such","+     * as {@code map { ... }} is not flagged. The chain may continue on later lines, but each argument list or closure in it","+     * must sit on one line, and the rule does not follow the provider through a variable.","+     */","+    private void addEagerTestSeedRules(List<ScriptRule> rules) {","+        rules.add(","+            new ScriptRule(","+                \"eager-test-seed\",","+                \"Build scripts must not read the test seed at configuration time\",","+                path -> true,","+                Pattern.compile(","+                    // the provider, then a chain of calls (arguments and closures on one line each, closures may hold ${...}),","+                    // then a read. The whitespace before an argument list or closure sits inside the optional group: if two","+                    // parts of the pattern could match the same whitespace, a failed match would backtrack exponentially.","+                    \"\\\\bbuildParams\\\\s*\\\\.\\\\s*(?:testSeedProvider\\\\b|getTestSeedProvider\\\\s*\\\\(\\\\s*\\\\)|random\\\\b|getRandom\\\\s*\\\\(\\\\s*\\\\))\"","+                        + \"(?:\\\\s*\\\\.\\\\s*\\\\w+(?:\\\\s*\\\\([^()\\\\n]*\\\\)|\\\\s*\\\\{(?:[^{}\\\\n]|\\\\$\\\\{[^{}\\\\n]*\\\\})*\\\\})?)*?\"","+                        + \"\\\\s*\\\\.\\\\s*(?:get\\\\s*\\\\(\\\\s*\\\\)|getOrNull\\\\s*\\\\(\\\\s*\\\\)|getOrElse\\\\s*\\\\(|orNull\\\\b)\"","+                ),","+                \"Calling get() on buildParams.testSeedProvider or buildParams.random reads the test seed while the build is \"","+                    + \"configured. The seed then becomes a configuration cache input and changes with every build, so the \"","+                    + \"configuration cache can never be reused.\",","+                \"Keep the value lazy: map the provider (buildParams.testSeedProvider.map { seed -> ... }) and pass it to \"","+                    + \"nonInputProperties.systemProperty, which