+\t\t}","+\t\treturn $method->invoke( $this->registry, $icon_content );","+\t}","+"," \t/**"," \t * Provides valid namespaced icon names, including names that contain,"," \t * start or end with digits, as well as underscores and hyphens.","@@ -400,101 +414,53 @@ public function test_register_icon_sanitizes_content() {"," \t}"," "," \t/**","-\t * Provides the supported icon content sources.","-\t *","-\t * @return array<string, array{0: bool}>","-\t */","-\tpublic function data_icon_content_sources(): array {","-\t\treturn array(","-\t\t\t'inline content' => array( false ),","-\t\t\t'file path'      => array( true ),","-\t\t);","-\t}","-","-\t/**","-\t * Should preserve stroke attributes when sanitizing registered icons.","+\t * Should sanitize icon content, allowing the supported SVG elements and attributes."," \t *","-\t * @dataProvider data_icon_content_sources","+\t * @dataProvider data_sanitize_icon_content"," \t *","-\t * @param bool $use_file_path Whether to register the icon from a file path.","+\t * @param non-falsy-string $input    The icon content to sanitize.","+\t * @param non-falsy-string $expected The expected sanitized output."," \t */","-\tpublic function test_stroke_attributes_survive_sanitization( bool $use_file_path ) {","-\t\t$content  = '<svg fill=\"currentColor\" style=\"fill: none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M0 0\" vector-effect=\"non-scaling-stroke\"/><polygon points=\"0,0 1,1\" stroke=\"currentColor\" vector-effect=\"non-scaling-stroke\"/></svg>';","-\t\t$name     = 'test-collection/stroke-icon';","-\t\t$settings = array(","-\t\t\t'label' => 'Stroke Icon',","-\t\t);","-","-\t\tif ( $use_file_path ) {","-\t\t\t$settings['file_path'] = $this->create_temp_icon_file( $content );","-\t\t} else {","-\t\t\t$settings['content'] = $content;","-\t\t}","-","-\t\t$this->assertTrue( $this->register( $name, $settings ) );","-","-\t\t$icon = $this->registry->get_registered_icon( $name );","-\t\t$this->assertStringContainsString