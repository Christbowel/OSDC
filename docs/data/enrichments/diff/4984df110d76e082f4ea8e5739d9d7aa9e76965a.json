 {","+    jelly.grown.clear();","+    for (const index of [hovered, focused]) {","+      if (index !== undefined) {","+        jelly.grown.add(index);","+      }","+    }","+  };","+","+  /** Grows the bubble the pointer's now over, if it's another. */","+  const hover = (target: EventTarget | null) => {","+    const over = bubbleOf(target);","+    if (over === hovered) {","+      return;","+    }","+    hovered = over;","+    regrow();","+    schedule();","+  };","+","+  const onMove = (event: PointerEvent) => {","+    const at = toCloud(event);","+    const t = event.timeStamp;","+    const seconds = lastMove === undefined ? 0 : (t - lastMove.t) / 1000;","+    const vx = lastMove && seconds > 0 ? (at.x - lastMove.x) / seconds : 0;","+    const vy = lastMove && seconds > 0 ? (at.y - lastMove.y) / seconds : 0;","+    lastMove = { t, ...at };","+    lastClient = { x: event.clientX, y: event.clientY };","+    jelly.pointer = { ...at, vx, vy };","+    hover(event.target);","+    if (hovered !== entered) {","+      entered = hovered;","+      if (hovered !== undefined) {","+        jelly.poke(hovered, vx, vy);","+      }","+    }","+    schedule();","+  };","+","+  // A bubble can move under a pointer that holds still, which fires this but no move.","+  const onOver = (event: PointerEvent) => {","+    hover(event.target);","+  };","+","+  const onLeave = () => {","+    jelly.pointer = undefined;","+    lastMove = undefined;","+    lastClient = undefined;","+    hovered = undefined;","+    entered = undefined;","+    rect = undefined;","+    regrow();","+    schedule();","+  };","+","+  const onDown = (event: PointerEvent) => {","+    const at = toCloud(event);","+    const over = bubbleOf(event.target);","+    jelly.ripple(at.x, at.y, 160, over);","+    if (over !== undefined) {","+      jelly.poke(over, 900, 0);","+    }","+    schedule();","+  };","+","+  const onFocus = (event: FocusEvent) => {","+    focused = bubbleOf(event.target);","+    if (focused !== undefined