{"id":"6a57167d95285122b7cc02c267ac6afdea672707","axis":"silent","repo":"duckdb/duckdb","sha":"6a57167d95285122b7cc02c267ac6afdea672707","parsed":{"files":[{"path":"extension/icu/CMakeLists.txt","lines":["@@ -7,6 +7,8 @@ project(ICUExtension)"," set_extension_version_sources(icu icu_extension.cpp)"," "," include_directories(include)","+include_directories(collation/include)","+include_directories(${CMAKE_SOURCE_DIR}/third_party/zstd/include)"," option(WITH_INTERNAL_ICU \"Use vendored copy of icu\" TRUE)"," if(WITH_INTERNAL_ICU)","   include_directories(third_party/icu/common)","@@ -17,6 +19,10 @@ endif()"," "," set(ICU_EXTENSION_FILES","     ${ICU_LIBRARY_FILES}","+    collation/collation_collator.cpp","+    collation/collation_loader.cpp","+    collation/collation_normalizer.cpp","+    collation/generated/collation_data.cpp","     icu_extension.cpp","     icu-current.cpp","     icu-dateadd.cpp","@@ -33,6 +39,7 @@ set(ICU_EXTENSION_FILES"," "," build_static_extension(icu ${ICU_EXTENSION_FILES})"," link_threads(icu_extension \"\")","+target_link_libraries(icu_extension duckdb_zstd)"," if(NOT WITH_INTERNAL_ICU)","   find_package(","     ICU","@@ -43,6 +50,7 @@ endif()"," disable_target_warnings(icu_extension)"," set(PARAMETERS \"-no-warnings\")"," build_loadable_extension(icu ${PARAMETERS} ${ICU_EXTENSION_FILES})","+target_link_libraries(icu_loadable_extension duckdb_zstd)"," if(NOT WITH_INTERNAL_ICU)","   target_link_libraries(icu_loadable_extension ICU::i18n ICU::uc ICU::data)"," endif()"],"additions":8,"deletions":0,"truncated":false},{"path":"extension/icu/collation/collation_collator.cpp","lines":["@@ -0,0 +1,1232 @@","+#include \"collation_collator.hpp\"","+","+#include \"collation_data.hpp\"","+#include \"collation_normalizer.hpp\"","+#include \"duckdb/common/string_util.hpp\"","+","+namespace duckdb {","+namespace collation {","+","+//===--------------------------------------------------------------------===//","+// Weight constants","+//===--------------------------------------------------------------------===//","+// A collation element holds a 32-bit primary weight and 16-bit secondary and","+// tertiary weights, every weight is a left-aligned sequence of bytes.","+","+static constexpr uint8_t LEVEL_SEPARATOR_BYTE = 0x01;","+static constexpr uint8_t MERGE_SEPARATOR_BYTE = 0x02;","+static constexpr uint32_t MERGE_SEPARATOR_PRIMARY = 0x02000000;","+static constexpr uint8_t PRIMARY_COMPRESSION_LOW_BYTE = 0x03;","+static constexpr uint8_t PRIMARY_COMPRESSION_HIGH_BYTE = 0xFF;","+","+static constexpr uint32_t COMMON_WEIGHT = 0x0500;","+//! The primary weight of the sentinel element that terminates the levels","+static constexpr uint32_t NO_CE_PRIMARY = 1;","+static constexpr uint32_t NO_CE_WEIGHT = 0x0100;","+static constexpr collation_element_t NO_CE = (static_cast<collation_element_t>(NO_CE_PRIMARY) << 32) |","+                                             (static_cast<collation_element_t>(NO_CE_WEIGHT) << 16) | NO_CE_WEIGHT;","+","+static constexpr uint32_t CASE_MASK = 0xC000;","+static constexpr uint32_t ONLY_TERTIARY_MASK = 0x3F3F;","+static constexpr uint32_t CASE_AND_TERTIARY_MASK = CASE_MASK | ONLY_TERTIARY_MASK;","+","+// runs of common weights are compressed into a single byte per level","+static constexpr uint32_t SEC_COMMON_LOW = 0x05;","+static constexpr uint32_t SEC_COMMON_MIDDLE = SEC_COMMON_LOW + 0x20;","+static constexpr uint32_t SEC_COMMON_HIGH = SEC_COMMON_LOW + 0x40;","+static constexpr int32_t SEC_COMMON_MAX_COUNT = 0x21;","+","+static constexpr uint32_t CASE_LOWER_FIRST_COMMON_LOW = 1;","+static constexpr uint32_t CASE_LOWER_FIRST_COMMON_MIDDLE = 7;","+static constexpr uint32_t CASE_LOWER_FIRST_COMMON_HIGH = 13;","+static constexpr int32_t CASE_LOWER_FIRST_COMMON_MAX_COUNT = 7;","+","+static constexpr uint32_t CASE_UPPER_FIRST_COMMON_LOW = 3;","+static constexpr int32_t CASE_UPPER_FIRST_COMMON_MAX_COUNT = 13;","+","+static constexpr uint32_t TER_ONLY_COMMON_LOW = 0x05;","+static constexpr uint32_t TER_ONLY_COMMON_MIDDLE = TER_ONLY_COMMON_LOW + 0x60;","+static constexpr uint32_t TER_ONLY_COMMON_HIGH = TER_ONLY_COMMON_LOW + 0xC0;","+static constexpr int32_t TER_ONLY_COMMON_MAX_COUNT = 0x61;","+","+static constexpr uint32_t TER_LOWER_FIRST_COMMON_LOW = 0x05;","+static constexpr uint32_t TER_LOWER_FIRST_COMMON_MIDDLE = TER_LOWER_FIRST_COMMON_LOW + 0x20;","+static constexpr uint32_t TER_LOWER_FIRST_COMMON_HIGH = TER_LOWER_FIRST_COMMON_LOW + 0x40;","+static constexpr int32_t TER_LOWER_FIRST_COMMON_MAX_COUNT = 0x21;","+","+static constexpr uint32_t TER_UPPER_FIRST_COMMON_LOW = 0x05 + 0x80;","+static constexpr uint32_t TER_UPPER_FIRST_COMMON_MIDDLE = TER_UPPER_FIRST_COMMON_LOW + 0x20;","+static constexpr uint32_t TER_UPPER_FIRST_COMMON_HIGH = TER_UPPER_FIRST_COMMON_LOW + 0x40;","+static constexpr int32_t TER_UPPER_FIRST_COMMON_MAX_COUNT = 0x21;","+","+static constexpr uint32_t QUAT_COMMON_LOW = 0x1C;","+static constexpr uint32_t QUAT_COMMON_MIDDLE = QUAT_COMMON_LOW + 0x70;","+static constexpr uint32_t QUAT_COMMON_HIGH = QUAT_COMMON_LOW + 0xE0;","+static constexpr int32_t QUAT_COMMON_MAX_COUNT = 0x71;","+static constexpr uint32_t QUAT_SHIFTED_LIMIT_BYTE = QUAT_COMMON_LOW - 1;","+","+//! Han characters are ordered by radical/stroke, their primary weights are assigned","+//! sequentially from the Han primary range","+static constexpr uint32_t HAN_FIRST_LEAD_BYTE = 0xFA;","+static constexpr uint32_t HAN_THIRD_BYTE_COUNT = 127;","+static constexpr uint32_t HAN_PER_LEAD_BYTE = HAN_THIRD_BYTE_COUNT * 254;","+//! Code points without a mapping get a primary weight computed from the code point","+static constexpr uint32_t UNASSIGNED_IMPLICIT_LEAD_BYTE = 0xFE;","+","+//===--------------------------------------------------------------------===//","+// Collation element lookup","+//===--------------------------------------------------------------------===//","+","+static collation_element_t MakeElement(uint32_t primary, uint32_t secondary, uint32_t tertiary) {","+\treturn (static_cast<collation_element_t>(primary) << 32) | (static_cast<collation_element_t>(secondary) << 16) |","+\t       tertiary;","+}","+","+//! Returns the position of a Han character in radical/stroke order, or false if it is not a Han character","+static bool GetHanIndex(const CollationRoot &root, uint32_t codepoint, uint32_t &result) {","+\t// only the ranges of the block the code point is in have to be searched","+\tuint32_t lower = root.han_block_lower[codepoint >> HAN_BLOCK_SHIFT];","+\tuint32_t upper = root.han_block_upper[codepoint >> HAN_BLOCK_SHIFT];","+\twhile (lower < upper) {","+\t\tauto middle = (lower + upper) / 2;","+\t\tauto start = root.han_range_start[middle];","+\t\tif (codepoint < start) {","+\t\t\tupper = middle;","+\t\t} else if (codepoint >= start + root.han_range_length[middle]) {","+\t\t\tlower = middle + 1;","+\t\t} else {","+\t\t\tresult = root.han_range_index[middle] + (codepoint - start);","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+","+//! The collation element of a code point that has no mapping in the table","+static collation_element_t ImplicitElement(const CollationRoot &root, uint32_t codepoint) {","+\tuint32_t index;","+\tuint32_t primary;","+\tif (GetHanIndex(root, codepoint, index)) {","+\t\tauto lead = HAN_FIRST_LEAD_BYTE + index / HAN_PER_LEAD_BYTE;","+\t\tauto rest = index % HAN_PER_LEAD_BYTE;","+\t\tprimary = (lead << 24) | ((0x02 + rest / HAN_THIRD_BYTE_COUNT) << 16) |","+\t\t          ((0x02 + 2 * (rest % HAN_THIRD_BYTE_COUNT)) << 8);","+\t} else {","+\t\tauto value = codepoint + 1;","+\t\tprimary = 2 + (value % 18) * 14;","+\t\tvalue /= 18;","+\t\tprimary |= (2 + (value % 254)) << 8;","+\t\tvalue /= 254;","+\t\tprimary |= (4 + (value % 251)) << 16;","+\t\tprimary |= UNASSIGNED_IMPLICIT_LEAD_BYTE << 24;","+\t}","+\treturn MakeElement(primary, COMMON_WEIGHT, COMMON_WEIGHT);","+}","+","+static uint32_t LookupValue(const CollationTable &table, uint32_t codepoint) {","+\tauto block = table.trie_stage1[codepoint >> COLLATION_TRIE_SHIFT];","+\treturn table.trie_stage2[block + (codepoint & COLLATION_TRIE_MASK)];","+}","+","+//===--------------------------------------------------------------------===//","+// Collation element generation","+//===--------------------------------------------------------------------===//","+","+void TailoredBlocks::Build(const uint32_t *codepoints, uint32_t count) {","+\tbounds.resize(BOUND_COUNT + 1);","+\tuint32_t position = 0;","+\tfor (uint32_t block = 0; block <= BOUND_COUNT; block++) {","+\t\twhile (position < count && codepoints[position] < (block << BOUND_SHIFT)) {","+\t\t\tposition++;","+\t\t}","+\t\tbounds[block] = position;","+\t}","+\tfor (uint32_t i = 0; i < count; i++) {","+\t\tauto block = codepoints[i] >> BITMAP_SHIFT;","+\t\tbitmap[block / 64] |= 1ULL << (block % 64);","+\t}","+}","+","+//! Looks up the trie value of a code point in the part of a tailoring that can hold it,","+//! returns false when the locale does not tailor it","+static bool LookupTailoringValue(const CollationTailoring &tailoring, uint32_t codepoint, uint32_t lower,","+                                 uint32_t upper, uint32_t &result) {","+\twhile (lower < upper) {","+\t\tauto middle = (lower + upper) / 2;","+\t\tauto value = tailoring.codepoints[middle];","+\t\tif (codepoint < value) {","+\t\t\tupper = middle;","+\t\t} else if (codepoint > value) {","+\t\t\tlower = middle + 1;","+\t\t} else {","+\t\t\tresult = tailoring.values[middle];","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+","+class ElementGenerator {","+public:","+\tElementGenerator(const CollationTailoring *tailoring_p, const TailoredBlocks &tailored_p, vector<uint32_t> &text_p,","+\t                 const uint64_t *fast_elements_p, const uint64_t *fast_expansions_p, uint32_t fast_limit_p)","+\t    : root(GetCollationRoot()), table(&root.table), tailoring(tailoring_p), tailored(tailored_p), text(text_p),","+\t      fast_elements(fast_elements_p), fast_expansions(fast_expansions_p), fast_limit(fast_limit_p) {","+\t}","+","+\tvoid Generate(vector<collation_element_t> &result);","+","+private:","+\t//! Appends the elements at [offset, offset + count) of the table","+\tvoid AppendElements(uint32_t offset, uint32_t count, vector<collation_element_t> &result);","+\t//! Matches the contexts of an entry at the current position, returns true if one matched","+\tbool MatchContext(const CollationEntry &entry, idx_t position, uint32_t &ce_offset, uint32_t &ce_count,","+\t                  idx_t &consumed, vector<idx_t> &skipped);","+\tbool MatchContraction(const CollationContext &context, idx_t position, idx_t &consumed, vector<idx_t> &skipped);","+\tbool MatchPrefix(const CollationContext &context, idx_t position);","+","+private:","+\tconst CollationRoot &root;","+\t//! the table the code point that is being processed comes from","+\tconst CollationTable *table;","+\tconst CollationTailoring *tailoring;","+\tconst TailoredBlocks &tailored;","+\tvector<uint32_t> &text;","+\t//! the positions a discontiguous contraction matched, reused across the characters","+\tvector<idx_t> skipped_buffer;","+","+\t//! the elements of the characters that do not depend on their neighbours","+\tconst uint64_t *fast_elements;","+\tconst uint64_t *fast_expansions;","+\tuint32_t fast_limit;","+};","+","+void ElementGenerator::AppendElements(uint32_t offset, uint32_t count, vector<collation_element_t> &result) {","+\tfor (uint32_t i = 0; i < count; i++) {","+\t\tauto element = table->ces[offset + i];","+\t\tif (element != 0) {","+\t\t\t// completely ignorable elements are not emitted","+\t\t\tresult.push_back(element);","+\t\t}","+\t}","+}","+","+bool ElementGenerator::MatchPrefix(const CollationContext &context, idx_t position) {","+\tif (position < context.chars_length) {","+\t\treturn false;","+\t}","+\t// the context is stored in reverse order, closest character first","+\tfor (uint32_t i = 0; i < context.chars_length; i++) {","+\t\tif (text[position - 1 - i] != table->context_chars[context.chars_offset + i]) {","+\t\t\treturn false;","+\t\t}","+\t}","+\treturn true;","+}","+","+bool ElementGenerator::MatchContraction(const CollationContext &context, idx_t position, idx_t &consumed,","+                                        vector<idx_t> &skipped) {","+\tauto chars = table->context_chars + context.chars_offset;","+\tif (position + 1 >= text.size()) {","+\t\treturn false;","+\t}","+\t// the contraction only matches when the next character continues it, or is a mark that","+\t// the contraction can reach across","+\tauto next = text[position + 1];","+\tif (next != chars[0] && Normalizer::CombiningClass(next) == 0) {","+\t\treturn false;","+\t}","+\t// a contraction can skip over combining marks that do not block the character it","+\t// continues with, which is the case when their combining class is lower","+\tidx_t pos = position + 1;","+\tuint32_t matched = 0;","+\tbool discontiguous = false;","+\tskipped.clear();","+\twhile (matched < context.chars_length && pos < text.size()) {","+\t\tauto combining_class = Normalizer::CombiningClass(text[pos]);","+\t\tif (text[pos] == chars[matched]) {","+\t\t\tif (discontiguous && combining_class == 0) {","+\t\t\t\t// only combining marks can be moved out of order","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tif (discontiguous) {","+\t\t\t\tskipped.push_back(pos);","+\t\t\t}","+\t\t\tmatched++;","+\t\t\tpos++;","+\t\t\tcontinue;","+\t\t}","+\t\tif (combining_class == 0 || combining_class >= Normalizer::CombiningClass(chars[matched])) {","+\t\t\t// the character blocks the rest of the contraction","+\t\t\treturn false;","+\t\t}","+\t\tdiscontiguous = true;","+\t\tpos++;","+\t}","+\tif (matched < context.chars_length) {","+\t\treturn false;","+\t}","+\t// everything up to the first skipped character is consumed directly","+\tconsumed = skipped.empty() ? context.chars_length + 1 : 1;","+\treturn true;","+}","+","+bool ElementGenerator::MatchContext(const CollationEntry &entry, idx_t position, uint32_t &ce_offset,","+                                    uint32_t &ce_count, idx_t &consumed, vector<idx_t> &skipped) {","+\tfor (uint32_t i = 0; i < entry.context_count; i++) {","+\t\tauto &context = table->contexts[entry.context_offset + i];","+\t\tif (context.type == COLLATION_CONTEXT_PREFIX) {","+\t\t\tif (!MatchPrefix(context, position)) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tconsumed = 1;","+\t\t\tskipped.clear();","+\t\t} else {","+\t\t\tif (!MatchContraction(context, position, consumed, skipped_buffer)) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tskipped = skipped_buffer;","+\t\t}","+\t\tce_offset = context.ce_offset;","+\t\tce_count = context.ce_count;","+\t\treturn true;","+\t}","+\treturn false;","+}","+","+void ElementGenerator::Generate(vector<collation_element_t> &result) {","+\tvector<idx_t> skipped;","+\tidx_t position = 0;","+\twhile (position < text.size()) {","+\t\tauto codepoint = text[position];","+\t\tif (codepoint < fast_limit) {","+\t\t\tauto element = fast_elements[codepoint];","+\t\t\tif (element != 0) {","+\t\t\t\t// the character maps to its elements no matter what surrounds it","+\t\t\t\tresult.push_back(element);","+\t\t\t\tauto expansion = fast_expansions[codepoint];","+\t\t\t\tif (expansion != 0) {","+\t\t\t\t\tresult.push_back(expansion);","+\t\t\t\t}","+\t\t\t\tposition++;","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t}","+\t\tuint32_t value;","+\t\tuint32_t lower;","+\t\tuint32_t upper;","+\t\tif (tailored.Contains(codepoint) && (tailored.GetRange(codepoint, lower, upper), true) &&","+\t\t    LookupTailoringValue(*tailoring, codepoint, lower, upper, value)) {","+\t\t\ttable = &tailoring->table;","+\t\t} else {","+\t\t\ttable = &root.table;","+\t\t\tvalue = LookupValue(root.table, codepoint);","+\t\t}","+\t\tauto tag = value >> COLLATION_TAG_SHIFT;","+\t\tauto index = value & COLLATION_INDEX_MASK;","+\t\tidx_t consumed = 1;","+\t\tif (tag == COLLATION_TAG_CONTEXTS) {","+\t\t\tauto &entry = table->entries[index];","+\t\t\tuint32_t ce_offset;","+\t\t\tuint32_t ce_count;","+\t\t\tif (MatchContext(entry, position, ce_offset, ce_count, consumed, skipped)) {","+\t\t\t\tAppendElements(ce_offset, ce_count, result);","+\t\t\t\t// characters that were skipped by a discontiguous contraction are removed","+\t\t\t\t// from the text, the remaining characters keep their relative order","+\t\t\t\tfor (idx_t i = skipped.size(); i > 0; i--) {","+\t\t\t\t\ttext.erase(text.begin() + static_cast<int64_t>(skipped[i - 1]));","+\t\t\t\t}","+\t\t\t} else if (entry.ce_count > 0) {","+\t\t\t\tAppendElements(entry.ce_offset, entry.ce_count, result);","+\t\t\t} else {","+\t\t\t\tresult.push_back(ImplicitElement(root, codepoint));","+\t\t\t}","+\t\t} else if (tag == COLLATION_TAG_SINGLE) {","+\t\t\tauto element = table->ces[index];","+\t\t\tif (element != 0) {","+\t\t\t\tresult.push_back(element);","+\t\t\t}","+\t\t} else if (tag == COLLATION_TAG_EXPANSION) {","+\t\t\tauto &expansion = table->expansions[index];","+\t\t\tAppendElements(expansion.ce_offset, expansion.ce_count, result);","+\t\t} else {","+\t\t\tresult.push_back(ImplicitElement(root, codepoint));","+\t\t}","+\t\tposition += consumed;","+\t}","+\tresult.push_back(NO_CE);","+}","+","+//===--------------------------------------------------------------------===//","+// Sort key generation","+//===--------------------------------------------------------------------===//","+","+//! A single level of the sort key, the levels are concatenated once all elements are processed","+class SortKeyLevel {","+public:","+\texplicit SortKeyLevel(vector<uint8_t> &bytes_p) : bytes(bytes_p) {","+\t\tbytes.clear();","+\t}","+\tvoid AppendByte(uint32_t byte) {","+\t\tbytes.push_back(static_cast<uint8_t>(byte));","+\t}","+\t//! Appends a 16-bit weight, dropping the trailing zero byte","+\tvoid AppendWeight16(uint32_t weight) {","+\t\tbytes.push_back(static_cast<uint8_t>(weight >> 8));","+\t\tif ((weight & 0xFF) != 0) {","+\t\t\tbytes.push_back(static_cast<uint8_t>(weight));","+\t\t}","+\t}","+\t//! Appends a 16-bit weight in reverse byte order, used by the backwards secondary level","+\tvoid AppendReverseWeight16(uint32_t weight) {","+\t\tif ((weight & 0xFF) != 0) {","+\t\t\tbytes.push_back(static_cast<uint8_t>(weight));","+\t\t}","+\t\tbytes.push_back(static_cast<uint8_t>(weight >> 8));","+\t}","+\t//! Appends a 32-bit weight, dropping the trailing zero bytes","+\tvoid AppendWeight32(uint32_t weight) {","+\t\tfor (int32_t shift = 24; shift >= 0; shift -= 8) {","+\t\t\tauto byte = static_cast<uint8_t>(weight >> shift);","+\t\t\tif (byte == 0) {","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\tbytes.push_back(byte);","+\t\t}","+\t}","+\tbool IsEmpty() const {","+\t\treturn bytes.empty();","+\t}","+\tidx_t Size() const {","+\t\treturn bytes.size();","+\t}","+\tuint8_t &operator[](idx_t index) {","+\t\treturn bytes[index];","+\t}","+\t//! Appends everything but the trailing level terminator to the sort key","+\t//! Appends everything but the last byte, which is the terminator of the level","+\tvoid AppendTo(vector<uint8_t> &result) const {","+\t\tif (bytes.empty()) {","+\t\t\treturn;","+\t\t}","+\t\tresult.insert(result.end(), bytes.begin(), bytes.end() - 1);","+\t}","+","+private:","+\tvector<uint8_t> &bytes;","+};","+","+//! The levels that are written for a given strength","+static uint32_t GetLevelMask(const CollationSettings &settings) {","+\tuint32_t levels;","+\tswitch (settings.strength) {","+\tcase CollationStrength::PRIMARY:","+\t\tlevels = 0x02;","+\t\tbreak;","+\tcase CollationStrength::SECONDARY:","+\t\tlevels = 0x06;","+\t\tbreak;","+\tcase CollationStrength::TERTIARY:","+\t\tlevels = 0x16;","+\t\tbreak;","+\tdefault:","+\t\tlevels = 0x36;","+\t\tbreak;","+\t}","+\tif (settings.case_level) {","+\t\tlevels |= 0x08;","+\t}","+\treturn levels;","+}","+","+static constexpr uint32_t PRIMARY_LEVEL_FLAG = 0x02;","+static constexpr uint32_t SECONDARY_LEVEL_FLAG = 0x04;","+static constexpr uint32_t CASE_LEVEL_FLAG = 0x08;","+static constexpr uint32_t TERTIARY_LEVEL_FLAG = 0x10;","+static constexpr uint32_t QUATERNARY_LEVEL_FLAG = 0x20;","+","+static void WriteSortKey(const vector<collation_element_t> &elements, const CollationSettings &settings,","+                         const uint8_t *reorder_table, CollationBuffer &buffer) {","+\tauto compressible_lead_byte = GetCollationRoot().compressible_lead_byte;","+\tauto &result = buffer.key;","+\tauto levels = GetLevelMask(settings);","+\tauto upper_first = settings.case_first == CaseFirst::UPPER_FIRST;","+\t// the case bits are only kept in the tertiary weight when caseFirst is set without a case level","+\tauto tertiary_mask = (settings.case_first != CaseFirst::DEFAULT && !settings.case_level) ? CASE_AND_TERTIARY_MASK","+\t                                                                                         : ONLY_TERTIARY_MASK;","+\t// +1 so that primary ignorables test out early","+\tconst auto alternate_shifted = settings.alternate_shifted;","+\tconst auto backward_secondary = settings.backward_secondary;","+\tconst auto primary_strength = settings.strength == CollationStrength::PRIMARY;","+\tuint32_t variable_top = alternate_shifted ? variable_top_primary + 1 : 0;","+","+\tSortKeyLevel secondaries(buffer.levels[0]);","+\tSortKeyLevel cases(buffer.levels[1]);","+\tSortKeyLevel tertiaries(buffer.levels[2]);","+\tSortKeyLevel quaternaries(buffer.levels[3]);","+","+\tuint32_t previous_primary = 0; // 0 means no primary compression is in progress","+\tint32_t common_cases = 0;","+\tint32_t common_secondaries = 0;","+\tint32_t common_tertiaries = 0;","+\tint32_t common_quaternaries = 0;","+\tuint32_t previous_secondary = 0;","+\tidx_t secondary_segment_start = 0;","+","+\tidx_t position = 0;","+\twhile (position < elements.size()) {","+\t\tauto element = elements[position++];","+\t\tauto primary = static_cast<uint32_t>(element >> 32);","+\t\tif (primary < variable_top && primary > MERGE_SEPARATOR_PRIMARY) {","+\t\t\t// a variable element, shift it to the quaternary level and i