moveAll();","+        $queryBuilder","+            ->update('sys_redirect')","+            ->set('integrity_status', RedirectConflict::NO_CONFLICT)","+            ->where(","+                $queryBuilder->expr()->in('source_host', $queryBuilder->createNamedParameter($sourceHosts, Connection::PARAM_STR_ARRAY)),","+                $queryBuilder->expr()->eq('integrity_status', $queryBuilder->createNamedParameter(RedirectConflict::SHADOWED))","+            );","+        if ($shadowedUids !== []) {","+            $queryBuilder->andWhere(","+                $queryBuilder->expr()->notIn('uid', $queryBuilder->createNamedParameter($shadowedUids, Connection::PARAM_INT_ARRAY))","+            );","+        }","+        $queryBuilder->executeStatement();","+","+        return $shadowedRedirects;","+    }","+","     /**","      * Resets the integrity status of all redirects which are not listed in $conflictingUids,","      * except those with a status listed in $statusesToKeep."],"additions":45,"deletions":5,"truncated":false},{"path":"typo3/sysext/redirects/Resources/Private/Language/locallang_module_redirect.xlf","lines":["@@ -78,6 +78,12 @@","       <trans-unit id=\"filter.resetButton\">","         <source>Reset</source>","       </trans-unit>","+      <trans-unit id=\"shadowed_redirect.title\">","+        <source>Shadowed redirect</source>","+      </trans-unit>","+      <trans-unit id=\"shadowed_redirect.message\">","+        <source>Redirect #%1$d is shadowed by redirect #%2$d with the same source and will never be used.</source>","+      </trans-unit>","       <trans-unit id=\"record_disabled\">","         <source>Disabled</source>","       </trans-unit>"],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Tests/Functional/Hooks/DataHandlerShadowedRedirectHookTest.php","lines":["@@ -0,0 +1,151 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistri