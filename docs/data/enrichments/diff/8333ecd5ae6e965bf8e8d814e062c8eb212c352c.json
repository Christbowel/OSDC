,"+        foreach (array_keys($dataHandler->datamap['sys_redirect'] ?? []) as $id) {","+            $uid = MathUtility::canBeInterpretedAsInteger($id) ? (int)$id : (int)($dataHandler->substNEWwithIDs[$id] ?? 0);","+            if ($uid > 0) {","+                $uids[] = $uid;","+            }","+        }","+        $this->updateShadowedRedirects($uids, $dataHandler);","+    }","+","+    public function processCmdmap_afterFinish(DataHandler $dataHandler): void","+    {","+        $this->updateShadowedRedirects(array_map(intval(...), array_keys($dataHandler->cmdmap['sys_redirect'] ?? [])), $dataHandler);","+    }","+","+    /**","+     * @param int[] $uids","+     */","+    private function updateShadowedRedirects(array $uids, DataHandler $dataHandler): void","+    {","+        if ($uids === []) {","+            return;","+        }","+        $sourceHosts = $this->getSourceHosts($uids);","+        foreach ($uids as $uid) {","+            $previousSourceHost = $dataHandler->getHistoryRecords()['sys_redirect:' . $uid]['oldRecord']['source_host'] ?? null;","+            if ($previousSourceHost !== null) {","+                $sourceHosts[] = (string)$previousSourceHost;","+            }","+        }","+        // An empty source host is treated like \"*\" when matching redirects.","+        if (array_intersect($sourceHosts, ['', '*']) !== []) {","+            $sourceHosts = array_merge($sourceHosts, ['', '*']);","+        }","+","+        $shadowedRedirects = $this->integrityService->updateShadowedIntegrityStatus(array_values(array_unique($sourceHosts)));","+        $languageService = $GLOBALS['LANG'] ?? null;","+        if (!$languageService instanceof LanguageService) {","+            return;","+        }","+        $reportedUids = [];","+        foreach ($shadowedRedirects as $shadowedRedirect) {","+            $uid = $shadowedRedirect['redirect']['uid'];","+            $shadowedBy = $shadowedRedirect['redirect']['shadowed_by'];","+            if (isset($reportedUids[$uid]) || (!in_array($uid, $uids, true) && !in_array($shadowedBy, $uids, true))) {","+                continue;","+            }","+            $reportedUids[$uid] = true;","+            $this->flashMessageService->getMessageQueueByIdentifier()->enqueue(new FlashMessage(","+                sprintf($languageService->sL('redirects.module_redirect:shadowed_redirect.message'), $uid, $shadowedBy),","+                $languageService->sL('redirects.module_redirect:shadowed_redirect.title'),","+                ContextualFeedbackSeverity::WARNING,","+                true","+            ));","+        }","+    }","+","+    /**","+     * @param int[] $uids","+     * @return string[]","+     */","+    private function getSourceHosts(array $uids): array","+    {","+        $queryBuilder = $this->connectionPool->getQueryBuilderForTable('sys_redirect');","+        $queryBuilder->getRestrictions()->removeAll();","+        return array_map(strval(...), $queryBuilder","+            ->select('source_host')","+            ->from('sys_redirect')","+            ->where(","+                $queryBuilder->expr()->in('uid', $queryBuilder->createNamedParameter($uids, Connection::PARAM_INT_ARRAY))","+            )","+            ->executeQuery()","+            ->fetchFirstColumn());","+    }","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"typo3/sysext/redirects/Classes/Service/IntegrityService.php","lines":["@@ -78,19 +78,25 @@ public function findConflictingRedirects(?string $siteIdentifier = null): \\Gener","     /**","      * Resolves all redirects which can never match, because another redirect with the same source","      * is matched first whenever the redirect itself would be active.","+     *","+     * @param string[] $sourceHosts Limits the check to these source hosts, all are checked if empty","      */","-    public function findShadowedRedirects(): \\Generator","+    public function findShadowedRedirects(array $sourceHosts = []): \\Generator","     {","       