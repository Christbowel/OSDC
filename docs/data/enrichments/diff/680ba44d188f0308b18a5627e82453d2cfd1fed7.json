alse},{"path":"internal/headerlist/headerlist.go","lines":["@@ -0,0 +1,232 @@","+// Package headerlist walks the comma-separated list values that RFC 9110","+// Section 5.6.1 defines, and joins the field lines that Section 5.3 says are","+// equivalent to one.","+//","+// Seven scanners used to spell this out separately: three in the core","+// (helpers.go, ctx.go, res.go) and four in middleware (adaptor, proxy, compress,","+// cache). They agreed on splitting at commas and trimming OWS, and disagreed on","+// everything after that, so the divergences are named here rather than left to","+// be rediscovered per call site:","+//","+//   - Case. [Contains] compares exactly, [ContainsFold] under ASCII case","+//     folding. Both exist because the callers genuinely differ: a Vary field","+//     name is echoed back to the client as it was written, while a token like","+//     \"close\" or \"gzip\" is matched however it arrives.","+//   - Quoting. [All] treats every comma as a separator, which is what a list of","+//     bare tokens wants. [AllQuoted] keeps commas that sit inside a quoted","+//     string, which is what a list of entity tags or media-type parameters","+//     needs, since those may contain one.","+//","+// Empty elements are skipped throughout: \"a,,b\" yields \"a\" and \"b\". A list is","+// permitted to carry them (RFC 9110 Section 5.6.1 allows the empty element for","+// legacy reasons) and no caller here has ever wanted one.","+package headerlist","+","+import (","+\t\"iter\"","+","+\t\"github.com/gofiber/utils/v2\"","+)","+","+// All yields each non-empty element of a comma-separated list value, with","+// leading and trailing OWS removed.","+//","+// Every comma separates. Use [AllQuoted] for a list whose elements may contain","+// a quoted comma.","+func All(list string) iter.Seq[string] {","+\treturn func(yield func(string) bool) {","+\t\tstart := 0","+\t\tfor i := range len(list) {","+\t\t\tif list[i] != ',' {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif element := utils.TrimSpace(list[start:i]); element != \"\" {","+\t\t\t\tif !yield(element) {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t}","+\t\t\tstart = i + 1","+\t\t}","+\t\tif element := utils.TrimSpace(list[start:]); element != \"\" {","+\t\t\tyield(element)","+\t\t}","+\t}","+}","+","+// AllQuoted is [All] for lists whose elements may contain a comma inside a","+// quoted string, such as If-None-Match, where the opaque-tag `\"v1,v2\"` is one","+// entity tag and not two elements (RFC 9110 Section 8.8.3).","+//","+// Only '\"' and ',' can affect where an element ends, so the walk jumps between","+// them instead of visiting every byte. A quoted string left open by a malformed","+// value swallows the rest of the list, which keeps a truncated field from","+// splitting into elements the sender did not write.","+func AllQuoted(list string) iter.Seq[string] {","+\treturn func(yield func(string) bool) {","+\t\tstart, pos := 0, 0","+\t\tinQuotes := false","+\t\tfor {","+\t\t\ti := utils.IndexAny2(list[pos:], '\"', ',')","+\t\t\tif i == -1 {","+\t\t\t\tbreak","+\t\t\t}","+\t\t\ti += pos","+\t\t\tpos = i + 1","+","+\t\t\tif list[i] == '\"' {","+\t\t\t\tinQuotes = !inQuotes","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif inQuotes {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif element := utils.TrimSpace(list[start:i]); element != \"\" {","+\t\t\t\tif !yield(element) {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t}","+\t\t\tstart = i + 1","+\t\t}","+\t\tif element := utils.TrimSpace(list[start:]); element != \"\" {","+\t\t\tyield(element)","+\t\t}","+\t}","+}","+","+// AllLines yields the elements of every field line in order, so that a header","+// sent as one line and the same header sent as several read alike (RFC 9110","+// Section 5.3).","+//","+// The lines are read as-is; the caller keeps whatever storage they alias.","+func AllLines(lines [][]byte) iter.Seq[string] {","+\treturn func(yield func(string) bool) {","+\t\tfor _, line := range lines {","+\t\t\tfor element := range All(utils.UnsafeString(line)) {","+\t\t\t\tif !yield(element) {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}","+","+// Contains reports whether list has an element equal to value, compared byte","+// for byte. An empty value is never present.","+//","+// value is matched against the elements [All] yields, so it is expected to be","+// one element and to carry no OWS of its own: \" gzip \" is not an element of","+// \" gzip \", though \"gzip\" is.","+//","+// Use [ContainsFold] to match a token whose case the sender chose.","+func Contains(list, value string) bool {","+\tif value == \"\" {","+\t\treturn false","+\t}","+","+\tfor element := range All(list) {","+\t\tif element == value {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// ContainsFold reports whether list has an element equal to value under ASCII","+// case folding. An empty value is never present.","+func ContainsFold(list, value string) bool {","+\tif value == \"\" {","+\t\treturn false","+\t}","+","+\tfor element := range All(list) {","+\t\tif utils.EqualFold(element, value) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+// Append appends the elements of list to dst and returns it, reusing dst's","+// storage. It returns nil for an empty list, leaving dst untouched.","+//","+// This is the allocation-free counterpart to [All], for the callers that need","+// the elements to outlive the walk. It is written as a loop rather than over","+// [All] because it sits on the per-request Accept-Encoding path.","+func Append(dst []string, list string) []string {","+\tif list == \"\" {","+\t\treturn nil","+\t}","+","+\tdst = dst[:0]","+\tstart := 0","+\tfor i := range len(list) {","+\t\tif list[i] != ',' {","+\t\t\tcontinue","+\t\t}","+\t\tif element := utils.TrimSpace(list[start:i]); element != \"\" {","+\t\t\tdst = append(dst, element)","+\t\t}","+\t\tstart = i + 1","+\t}","+\tif element := utils.TrimSpace(list[start:]); element != \"\" {","+\t\tdst = append(dst, element)","+\t}","+","+\treturn dst","+}","+","+// Join renders the field lines of one header as the single combined value that","+// RFC 9110 Section 5.3 says they are equivalent to, separated by a bare comma.","+//","+// A lone line is returned as it stands, so the result aliases the caller's","+// storage and must not be retained past it. Only the multi-line case allocates,","+// and that case is rare.","+func Join(lines [][]byte) []byte {","+\tswitch len(lines) {","+\tcase 0:","+\t\treturn nil","+\tcase 1:","+\t\treturn lines[0]","+\t}","+","+\tn := len(lines) - 1","+\tfor _, line := range lines {","+\t\tn += len(line)","+\t}","+","+\tjoined := make([]byte, 0, n)","+\tfor i, line := range lines {","+\t\tif i > 0 {","+\t\t\tjoined = append(joined, ',')","+\t\t}","+\t\tjoined = append(joined, line...)","+\t}","+\treturn joined","+}","+","+// AppendUnique adds each value that list does not already carry, separated by","+// \", \", and returns the result. It returns \"\" when nothing was added, so a","+// caller can tell \"unchanged\" from \"changed\" without comparing the strings.","+//","+// Presence is decided by [Contains], byte for byte: a value already listed in","+// another case is added again rather than silently dropped, since the field","+// this serves is echoed to the client as written.","+func AppendUnique(list string, values []string) string {","+\toriginal := list","+\tfor _, value := range values {","+\t\tif value == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\tswitch {","+\t\tcase list == \"\":","+\t\t\tlist = value","+\t\tcase !Contains(list, value):","+\t\t\tlist += \", \" + value","+\t\t}","+\t}","+","+\tif list == original {","+\t\treturn \"\"","+\t}","+\treturn list","+}"],"additions":232,"deletions":0,"truncated":false},{"path":"internal/headerlist/headerlist_test.go","lines":["@@ -0,0 +1,305 @@","+package headerlist","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func Test_Append(t *testing.T) {","+\tt.Parallel()","+\ttestCases := []struct {","+\t\tdescription  string","+\t\theaderValue  string","+\t\texpectedList []string","+\t}{","+\t\t{","+\t\t\tdescription:  \"normal case\",","+\t\t\theaderValue:  \"gzip, deflate,br\",","+\t\t\texpectedList: []string{\"gzip\", \"deflate\", \"br\"},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"no matter the value\",","+\t\t\theaderValue:  \"   gzip,deflate, br, zip\",","+\t\t\texpectedList: []string{\"gzip\", \"deflate\", \"br\", \"zip\"},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"comma with trailing spaces around values\",","+\t\t\theaderValue:  \"gzip , br\",","+\t\t\texpectedList: []string{\"gzip\", \"br\"},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"comma with tabbed whitespace\",","+\t\t\theaderValue:  \"gzip\\t,br\",","+\t\t\texpectedList: []string{\"gzip\", \"br\"},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"headerValue is empty\",","+\t\t\theaderValue:  \"\",","+\t\t\texpectedList: nil,","+\t\t},","+\t\t{","+\t\t\t// RFC 9110 §5.6.1.2: empty list elements are parsed and ignored.","+\t\t\tdescription:  \"has a comma without element\",","+\t\t\theaderValue:  \"gzip,\",","+\t\t\texpectedList: []string{\"gzip\"},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"has a space between words\",","+\t\t\theaderValue:  \"  foo bar, hello  world\",","+\t\t\texpectedList: []string{\"foo bar\", \"hello  world\"},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"single comma\",","+\t\t\theaderValue:  \",\",","+\t\t\texpectedList: []string{},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"multiple comma\",","+\t\t\theaderValue:  \",,\",","+\t\t\texpectedList: []string{},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"comma with space\",","+\t\t\theaderValue:  \",  ,\",","+\t\t\texpectedList: []string{},","+\t\t},","+\t\t{","+\t\t\tdescription:  \"empty element between values\",","+\t\t\theaderValue:  \"gzip, , br\",","+\t\t\texpectedList: []string{\"gzip\", \"br\"},","+\t\t},","+\t}","+","+\tfor _, tc := range testCases {","+\t\tt.Run(tc.description, func(t *testing.T) {","+\t\t\ttc := tc // create a new 'tc' variable for the goroutine","+\t\t\tt.Parallel()","+\t\t\tdst := make([]string, 10)","+\t\t\tresult := Append(dst, tc.headerValue)","+\t\t\trequire.Equal(t, tc.expectedList, result)","+\t\t})","+\t}","+}","+","+func Benchmark_Append(b *testing.B) {","+\tdestination := make([]string, 5)","+\tresult := destination","+\tconst input = `deflate, gzip,br,brotli,zstd`","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\tresult = Append(destination, input)","+\t}","+\trequire.Equal(b, []string{\"deflate\", \"gzip\", \"br\", \"brotli\", \"zstd\"}, result)","+}","+","+func Test_Contains(t *testing.T) {","+\tt.Parallel()","+\ttestCases := []struct {","+\t\theader   string","+\t\tvalue    string","+\t\texpected bool","+\t}{","+\t\t// Exact match","+\t\t{header: \"gzip\", value: \"gzip\", expected: true},","+\t\t{header: \"gzip\", value: \"deflate\", expected: false},","+\t\t// Prefix match (value at start with comma)","+\t\t{header: \"gzip, deflate\", value: \"gzip\", expected: true},","+\t\t{header: \"gzip,deflate\", value: \"gzip\", expected: true},","+\t\t// Suffix match (value at end)","+\t\t{header: \"deflate, gzip\", value: \"gzip\", expected: true},","+\t\t{header: \"deflate,gzip\", value: \"gzip\", expected: true}, // No space - OWS is optional per RFC 9110","+\t\t{header: \"br, gzip\", value: \"gzip\", expected: true},","+\t\t// Middle match (value in middle)","+\t\t{header: \"deflate, gzip, br\", value: \"gzip\", expected: true},","+\t\t{header: \"deflate,gzip,br\", value: \"gzip\", expected: true}, // No spaces - OWS is optional per RFC 9110","+\t\t// No match - similar but not equal","+\t\t{header: \"gzip2\", value: \"gzip\", expected: false},","+\t\t{header: \"2gzip\", value: \"gzip\", expected: false},","+\t\t{header: \"gzip2, deflate\", value: \"gzip\", expected: false},","+\t\t// Whitespace handling (OWS per RFC 9110)","+\t\t{header: \"  gzip  ,  deflate  \", value: \"gzip\", expected: true},","+\t\t{header: \"deflate,  gzip  \", value: \"gzip\", expected: true},","+\t\t// Empty cases","+\t\t{header: \"\", value: \"gzip\", expected: false},","+\t\t{header: \"gzip\", value: \"\", expected: false},","+\t\t{header: \"\", value: \"\", expected: false}, // Both empty - should return false","+\t}","+","+\tfor _, tc := range testCases {","+\t\tresult := Contains(tc.header, tc.value)","+\t\trequire.Equal(t, tc.expected, result,","+\t\t\t\"Contains(%q, %q) = %v, want %v\",","+\t\t\ttc.header, tc.value, result, tc.expected)","+\t}","+}","+","+// go test -v -run=^$ -bench=Benchmark_Contains -benchmem -count=4","+func Benchmark_Contains(b *testing.B) {","+\tvar ok bool","+\tb.ReportAllocs()","+\tfor b.Loop() {","+\t\t_ = Contains(\"gzip\", \"gzip\")","+\t\t_ = Contains(\"gzip, deflate, br\", \"deflate\")","+\t\t_ = Contains(\"deflate, gzip\", \"gzip\")","+\t\tok = Contains(\"deflate, gzip, br\", \"gzip\")","+\t}","+\trequire.True(b, ok)","+}","+","+func Test_Join(t *testing.T) {","+\tt.Parallel()","+\trequire.Nil(t, Join(nil))","+\trequire.Equal(t, []byte(\"a\"), Join([][]byte{[]byte(\"a\")}))","+\trequire.Equal(t, []byte(\"a,b\"), Join([][]byte{[]byte(\"a\"), []byte(\"b\")}))","+}","+","+func collect(seq func(func(string) bool)) []string {","+\tvar got []string","+\tfor v := range seq {","+\t\tgot = append(got, v)","+\t}","+\treturn got","+}","+","+func Test_All(t *testing.T) {","+\tt.Parallel()","+\ttests := []struct {","+\t\tname string","+\t\tlist string","+\t\twant []string","+\t}{","+\t\t{\"empty\", \"\", nil},","+\t\t{\"single\", \"gzip\", []string{\"gzip\"}},","+\t\t{\"trims OWS\", \"  gzip ,\\tbr\\t\", []string{\"gzip\", \"br\"}},","+\t\t{\"skips empty elements\", \"gzip, , br\", []string{\"gzip\", \"br\"}},","+\t\t{\"only separators\", \",  ,\", nil},","+\t\t{\"quotes are not special\", `\"a,b\"`, []string{`\"a`, `b\"`}},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\trequire.Equal(t, tc.want, collect(All(tc.list)))","+\t\t})","+\t}","+}","+","+func Test_AllQuoted(t *testing.T) {","+\tt.Parallel()","+\ttests := []struct {","+\t\tname string","+\t\tlist string","+\t\twant []string","+\t}{","+\t\t{\"empty\", \"\", nil},","+\t\t{\"comma inside quotes is kept\", `\"v1,v2\"`, []string{`\"v1,v2\"`}},","+\t\t{\"separates outside quotes\", `\"a\", \"b\"`, []string{`\"a\"`, `\"b\"`}},","+\t\t{\"weak tags\", `W/\"a\", W/\"b,c\"`, []string{`W/\"a\"`, `W/\"b,c\"`}},","+\t\t{\"unterminated quote swallows rest\", `\"a, b`, []string{`\"a, b`}},","+\t\t{\"skips empty elements\", `\"a\", , \"b\"`, []string{`\"a\"`, `\"b\"`}},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\trequire.Equal(t, tc.want, collect(AllQuoted(tc.list)))","+\t\t})","+\t}","+}","+","+func Test_AllLines(t *testing.T) {","+\tt.Parallel()","+\trequire.Nil(t, collect(AllLines(nil)))","+\trequire.Equal(t,","+\t\t[]string{\"gzip\", \"br\", \"zstd\"},","+\t\tcollect(AllLines([][]byte{[]byte(\"gzip, br\"), []byte(\" zstd \")})),","+\t)","+\t// A header split across lines reads the same as one line (RFC 9110 5.3).","+\trequire.Equal(t,","+\t\tcollect(All(\"gzip,br\")),","+\t\tcollect(AllLines([][]byte{[]byte(\"gzip\"), []byte(\"br\")})),","+\t)","+}","+","+func Test_All_EarlyExit(t *testing.T) {","+\tt.Parallel()","+\t// Each iterator must stop when the caller breaks, not run to completion.","+\tfor _, seq := range []func(func(string) bool){","+\t\tAll(\"a,b,c\"),","+\t\tAllQuoted(`\"a\",\"b\",\"c\"`),","+\t\tAllLines([][]byte{[]byte(\"a\"), []byte(\"b,c\")}),","+\t} {","+\t\tn := 0","+\t\tfor range seq {","+\t\t\tn++","+\t\t\tbreak","+\t\t}","+\t\trequire.Equal(t, 1, n)","+\t}","+}","+","+func Test_ContainsFold(t *testing.T) {","+\tt.Parallel()","+\trequire.True(t, ContainsFold(\"gzip, BR\", \"br\"))","+\trequire.True(t, ContainsFold(\"GZIP\", \"gzip\"))","+\trequire.True(t, ContainsFold(\" close \", \"CLOSE\"))","+\trequire.False(t, ContainsFold(\"gzip2\", \"gzip\"))","+\trequire.False(t, ContainsFold(\"gzip\", \"\"))","+\trequire.False(t, ContainsFold(\"\", \"gzip\"))","+}","+","+func Test_Contains_MatchesElementsNotRawList(t *testing.T) {","+\tt.Parallel()","+\t// Contains compares against what All yields, so OWS around the element is","+\t// not part of it. A value carrying its own OWS is not an element, and that","+\t// holds whether or not it happens to span the whole list.","+\trequire.True(t, Contains(\" gzip \", \"gzip\"))","+\trequire.False(t, Contains(\" gzip \", \" gzip \"))","+\trequire.False(t, Contains(\"br, gzip\", \" gzip \"))","+\trequire.Equal(t, []string{\"gzip\"}, collect(All(\" gzip \")))","+}","+","+func Test_Contains_IsCaseSensitive(t *testing.T) {","+\tt.Parallel()","+\t// The documented split from ContainsFold: Contains compares byte for byte.","+\trequire.False(t, Contains(\"Accept-Encoding\", \"accept-encoding\"))","+\trequire.True(t, ContainsFold(\"Accept-Encoding\", \"accept-encoding\"))","+}","+","+func Test_AppendUnique(t *testing.T) {","+\tt.Parallel()","+\ttests := []struct {","+\t\tname   string","+\t\tlist   string","+\t\twant   string","+\t\tvalues []string","+\t}{","+\t\t{\"into empty\", \"\", \"Accept\", []string{\"Accept\"}},","+\t\t{\"appends new\", \"Accept\", \"Accept, Origin\", []string{\"Origin\"}},","+\t\t{\"skips present\", \"Accept, Origin\", \"\", []string{\"Accept\"}},","+\t\t{\"skips empty values\", \"Accept\", \"\", []string{\"\"}},","+\t\t{\"nothing to add\", \"Accept\", \"\", nil},","+\t\t{\"partial add\", \"Accept\", \"Accept, Origin\", []string{\"Accept\", \"Origin\"}},","+\t\t{\"case counts as different\", \"Accept\", \"Accept, accept\", []string{\"accept\"}},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\trequire.Equal(t, tc.want, AppendUnique(tc.list, tc.values))","+\t\t})","+\t}","+}","+","+func Test_Join_AliasesSingleLine(t *testing.T) {","+\tt.Parallel()","+\tline := []byte(\"gzip\")","+\trequire.Equal(t, &line[0], &Join([][]byte{line})[0], \"a lone line must be returned as it stands\")","+}","+","+func Test_Append_ReusesStorage(t *testing.T) {","+\tt.Parallel()","+\tdst := make([]string, 0, 4)","+\tgot := Append(dst, \"a, b\")","+\trequire.Equal(t, []string{\"a\", \"b\"}, got)","+\trequire.Equal(t, &dst[:1][0], &got[0], \"Append must reuse dst's storage\")","+\trequire.Nil(t, Append(dst, \"\"), \"an empty list yields nil\")","+}"],"additions":305,"deletions":0,"truncated":false},{"path":"middleware/adaptor/adaptor.go","lines":["@@ -16,6 +16,7 @@ import ("," \t\"unsafe\""," "," \t\"github.com/gofiber/fiber/v3\"","+\t\"github.com/gofiber/fiber/v3/internal/headerlist\""," \t\"github.com/gofiber/utils/v2\""," \t\"github.com/valyala/fasthttp\""," \t\"github.com/valyala/fasthttp/fasthttpadaptor\"","@@ -355,17 +356,6 @@ type headerPair struct {"," \tvalue string"," }"," ","-// hasCloseToken reports whether a Connection field value lists \"close\" among its","-// tokens, which RFC 9110 Section 7.6.1 matches case-insensitively.","-func hasCloseToken(value string) bool {","-\tfor token := range strings.SplitSeq(value, \",\") {","-\t\tif utils.EqualFold(utils.TrimSpace(token), \"close\") {","-\t\t\treturn true","-\t\t}","-\t}","-\treturn false","-}","-"," // snapshotHeaders copies the non-framing headers of the converted request into"," // owned strings. fasthttpadaptor builds r.Header with b2s, so its keys and values"," // alias buffers the fiber header owns — writing back in place corrupted them.","@@ -465,7 +455,9 @@ func HTTPMiddleware(mw func(http.Handler) http.Handler) fiber.Handler {"," \t\t\tif len(connection) > 0 {"," \t\t\t\tjoined := strings.Join(connection, \", \")"," \t\t\t\tfhdr.Set(fiber.HeaderConnection, joined)","-\t\t\t\tif hasCloseToken(joined) {","+\t\t\t\t// RFC 9110 Section 7.6.1 matches connection options","+\t\t\t\t// case-insensitively.","+\t\t\t\tif headerlist.ContainsFold(joined, \"close\") {"," \t\t\t\t