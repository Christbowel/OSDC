"," ","+    // Check implementation limits before anything else so that they are","+    // enforced regardless of whether this operator is reachable.","+    if let Operator::BrTable { targets } = op {","+        if targets.len() > MAX_BR_TABLE_TARGETS {","+            return Err(wasm_unsupported!(","+                \"`br_table` has {} targets, which exceeds the implementation limit of {}\",","+                targets.len(),","+                MAX_BR_TABLE_TARGETS","+            ));","+        }","+    }","+","     if !environ.is_reachable() {","         translate_unreachable_operator(&op, builder, environ)?;","         return Ok(());"],"additions":13,"deletions":1,"truncated":false},{"path":"tests/all/br_table.rs","lines":["@@ -0,0 +1,80 @@","+//! Tests for `br_table` lowering, especially with very large jump tables.","+","+use wasmtime::*;","+use wasmtime_test_macros::wasmtime_test;","+","+/// Generate a module with a single exported function `f` that executes a","+/// `br_table` with `n` non-default targets. Every non-default target branches","+/// to a block that returns 5; the default target returns 0.","+fn br_table_module(n: usize) -> String {","+    let mut wat = String::with_capacity(n * 2 + 256);","+    wat.push_str(","+        r#\"","+(module","+  (func (export \"f\") (param i32) (result i32) (local $r i32)","+    (block $exit","+      (block $t","+        (br_table","+\"#,","+    );","+    for _ in 0..n {","+        wat.push_str(\"0 \");","+    }","+    wat.push_str(","+        r#\"","+          1 (local.get 0)))","+      (local.set $r (i32.const 5)))","+    (local.get $r)))","+\"#,","+    );","+    wat","+}","+","+fn run_br_table_test(engine: &Engine, n: usize) -> Result<()> {","+    let module = Module::new(engine, br_table_module(n))?;","+    let mut store = Store::new(engine, ());","+    let instance = Instance::new(&mut store, &module, &[])?;","+    let f = instance.get_typed_func::<u32, u32>(&mut store, \"f\")?;","+","+    let n = u32::try_from(n).unwrap();","+    for (index, expected) in [","+        (0, 5),","+        (5, 5),","+        (n - 1, 5),","+        (n, 0),","+        (n + 1, 0),","+        (n + 37_600, 0),","+        (u32::MAX / 2, 0),","+        (u32::MAX - 1, 0),","+        (u32::MAX, 0),","+    ] {","+        assert_eq!(","+            f.call(&mut store, index)?,","+            expected,","+            \"br_table with {n} targets, index {index}\"","+        );","+    }","+    Ok(())","+}","+","+/// Check `br_table`s of various sizes up to and just beyond our","+/// implementation limit of 65520 targets: those within the limit must compile","+/// and behave correctly, and those beyond it must be rejected with an error.","+#[wasmtime_test]","+#[cfg_attr(miri, ignore)]","+fn br_table_sizes(config: &mut Config) -> Result<()> {","+    let engine = Engine::new(config)?;","+    for (size, should_succeed) in [(16, true), (65_520, true), (65_521, false)] {","+        if should_succeed {","+            run_br_table_test(&engine, size)?;","+        } else {","+            let err = Module::new(&engine, br_table_module(size)).unwrap_err();","+            let err = format!(\"{err:?}\");","+            assert!(","+                err.contains(\"exceeds the implementation limit of 65520\"),","+                \"unexpected error for br_table with {size} targets: {err}\"","+            );","+        }","+    }","+    Ok(())","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"tests/all/main.rs","lines":["@@ -5,6 +5,7 @@ use wasmtime::Result;"," mod arrays;"," mod async_functions;"," mod async_table_capacity;","+mod br_table;"," mod call_hook;"," mod cli_tests;"," mod compile_time_builtins;"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/disas/winch/aarch64/br_table/large.wat","lines":["@@ -1,25392 +0,0 @@","-;;! target = \"aarch64\"","-;;! test = \"winch\"","-(module","-  (func (export \"large\") (param i32) (result i32)","-    (block","-      (block","-        (br_table","-         