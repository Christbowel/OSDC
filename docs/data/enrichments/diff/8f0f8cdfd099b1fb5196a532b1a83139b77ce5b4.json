public interface TokenReplayCache<T> extends Closeable {","+","+    boolean contains(T id);","+","+    void putId(T id);","+","+    void putId(T id, Instant expiry);","+","+    /**","+     * Add the given identifier to the cache if, and only if, it is not already contained in it, as a","+     * single atomic operation, so that concurrent requests carrying the same identifier cannot all","+     * pass a replay check before any of them has cached it. This default implementation is only","+     * atomic with respect to other callers of this method on the same instance; an implementation","+     * should override it with the atomic put-if-absent operation of the underlying cache.","+     * @param id The identifier to be added","+     * @param expiry A custom expiry time for the identifier. Can be null in which case, the default","+     *               expiry is used.","+     * @return true if the identifier was added, false if it was already contained in the cache or is","+     *         null or empty","+     */","+    default boolean putIdIfAbsent(T id, Instant expiry) {","+        if (id == null || \"\".equals(id)) {","+            return false;","+        }","+        synchronized (this) {","+            if (contains(id)) {","+                return false;","+            }","+            putId(id, expiry);","+            return true;","+        }","+    }","+","+    void close() throws IOException;","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"rt/rs/security/xml/src/main/java/org/apache/cxf/rs/security/common/jcache/JCacheTokenReplayCache.java","lines":["@@ -0,0 +1,193 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements. See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership. The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance