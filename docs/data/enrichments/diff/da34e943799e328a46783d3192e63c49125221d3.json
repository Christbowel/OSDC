) => {","+    const classes = classNames(node);","+    if (","+      !classes.includes('twoslash-hover') ||","+      classes.includes('twoslash-query-persisted')","+    ) {","+      return;","+    }","+    for (const container of node.children) {","+      if (","+        container.type !== 'element' ||","+        !classNames(container).includes('twoslash-popup-container')","+      ) {","+        continue;","+      }","+      const html = toHtml({ type: 'root', children: container.children });","+      let index = indexes.get(html);","+      if (index === undefined) {","+        index = popups.length;","+        popups.push(html);","+        indexes.set(html, index);","+      }","+      container.children = [];","+      container.properties['dataPopup'] = String(index);","+    }","+  });","+  return popups;","+}","+","+/**","+ * Whether a module id asks for a page's popups, not the page: the query","+ * that `import.meta.glob(…, { query: '?popups' })` adds (`page.md?popups`).","+ * Dev adds queries of its own after it (`&import`).","+ */","+export function isPopupsId(id: string) {","+  const query = id.split('?')[1];","+  return query !== undefined && new URLSearchParams(query).has('popups');","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"www/build/markdown.test.ts","lines":["@@ -94,6 +94,37 @@ describe('renderMarkdown', () => {","     }).pipe(Effect.provide(NodeServices.layer)),","   );"," ","+  it.effect(","+    'leaves hover popups out of the HTML, listing each distinct one once',","+    () =>","+      Effect.gen(function* () {","+        const rendered = yield* render(","+          [","+            '```ts twoslash',","+            'const one = 1;',","+            'const two = one + one;',","+            '//    ^?',","+            'const three = two;',","+            '```',","+          ].join('\\n'),","+        );","+        const popupText = rendered.popups.map(textOf);","+        expect(popupText).toEqual([","+          'const one: 1',","+     