ll)}","             />","             <p className=\"text-sm text-muted-foreground\">","               The client of the router{' '}"],"additions":12,"deletions":5,"truncated":false},{"path":"www/src/styles.css","lines":["@@ -397,6 +397,12 @@ html {","   transform: none;"," }"," ","+/* A popup whose content hasn't loaded yet (`installTwoslashHovers` fills","+   it), so hovering before the page hydrates shows no empty box. */","+.twoslash .twoslash-popup-container[data-popup] {","+  display: none;","+}","+"," .twoslash .twoslash-hover:not(.twoslash-query-persisted) .twoslash-popup-arrow {","   display: none;"," }"],"additions":6,"deletions":0,"truncated":false},{"path":"www/src/twoslash-hovers.test.ts","lines":["@@ -3,7 +3,9 @@ import { afterEach, beforeEach, expect, test, vi } from 'vitest';"," "," import {","   closeDelay,","+  inlinePopups,","   installTwoslashHovers,","+  type LoadPopups,","   openDelay,","   switchDelay,"," } from './twoslash-hovers.ts';","@@ -19,7 +21,10 @@ let cleanup: () => void = () => {};"," beforeEach(() => {","   vi.useFakeTimers();","   document.body.innerHTML = `<div id=\"root\">${block}</div><p id=\"page\">Page</p>`;","-  cleanup = installTwoslashHovers(element('root'));","+  cleanup = installTwoslashHovers(","+    element('root'),","+    inlinePopups({ popups: [] }),","+  );"," });"," "," afterEach(() => {","@@ -153,3 +158,77 @@ test('cleanup closes the popup and stops listening', () => {","   expect(openName()).toBe(null);","   cleanup = () => {};"," });","+","+/** A block whose popups' content the page loads (`data-popup`). */","+function installLazyBlock(loadPopups: LoadPopups) {","+  cleanup();","+  document.body.innerHTML = `<div id=\"root\"><pre class=\"twoslash\"><code><span class=\"line\"><span class=\"twoslash-hover\" id=\"lazy\"><span class=\"twoslash-popup-container\" data-popup=\"1\" id=\"lazy-popup\"></span>lazy</span><span id=\"lazy-plain\"> = 1</span></span></code></pre></div>`;","+  cleanup = installTwoslashHovers(element('root'), loadPopups);","+}","+","+const lazyPopups = [","+  '<code>const other: 2</code>',","+  '<code>const lazy: 1</code>',","+];","+","+test('the popups load once the pointer enters a block, before it rests on a name', async () => {","+  const loadPopups = vi.fn<LoadPopups>(() => Promise.resolve(lazyPopups));","+  installLazyBlock(loadPopups);","+  move(null, 'lazy-plain');","+  move('lazy-plain', 'lazy');","+  expect(loadPopups).toHaveBeenCalledTimes(1);","+  await vi.advanceTimersByTimeAsync(openDelay);","+  expect(openName()).toBe('lazy');","+  expect(element('lazy-popup').innerHTML).toBe('<code>const lazy: 1</code>');","+  expect(element('lazy-popup').hasAttribute('data-popup')).toBe(false);","+});","+","+test('a popup that opens before the popups load is filled once they do', async () => {","+  const { promise, resolve } = Promise.withResolvers<ReadonlyArray<string>>();","+  installLazyBlock(() => promise);","+  // A tap: no pointer events before the click.","+  element('lazy').click();","+  expect(openName()).toBe('lazy');","+  expect(element('lazy-popup').innerHTML).toBe('');","+  resolve(lazyPopups);","+  await vi.advanceTimersByTimeAsync(0);","+  expect(element('lazy-popup').innerHTML).toBe('<code>const lazy: 1</code>');","+});","+","+test('a failed load of the popups is tried again when a popup opens', async () => {","+  const loadPopups = vi","+    .fn<LoadPopups>()","+    .mockRejectedValueOnce(new Error('offline'))","+    .mockResolvedValue(lazyPopups);","+  const logged = vi.spyOn(console, 'error').mockImplementation(() => {});","+  installLazyBlock(loadPopups);","+  // Entering the block starts a load, which fails.","+  move(null, 'lazy');","+  await vi.advanceTimersByTimeAsync(0);","+  expect(logged).toHaveBeenCalledWith(","+    'Twoslash popups failed to load',","+    new Error('offline'),","+  );","+  // Opening the popup tries again.","+  await vi.advanceTimersByTimeAsync(openDelay);","+  expect(loadPopups).toHaveBeenCalledTimes(2);","+  expect(element('lazy-popup').innerHTML).toBe('<code>const lazy: 1</code>');","+  logged.mockRestore();","+});","+","+test('a tapped name whose popup fails to load closes, so the next tap tries again', async () => {","+  const loadPopups = vi","+    .fn<LoadPopups>()","+    .mockRejectedValueOnce(new Error('offline'))","+    .mockResolvedValue(lazyPopups);","+  const logged = vi.spyOn(console, 'error').mockImplementation(() => {});","+  installLazyBlock(loadPopups);","+  element('lazy').click();","+  await vi.advanceTimersByTimeAsync(0);","+  expect(openName()).toBe(null);","+  element('lazy').click();","+  await vi.advanceTimersByTimeAsync(0);","+  expect(openName()).toBe('lazy');","+  expect(element('lazy-popup').innerHTML).toBe('<code>const lazy: 1</code>');","+  logged.mockRestore();","+});"],"additions":80,"deletions":1,"truncated":false},{"path":"www/src/twoslash-hovers.ts","lines":["@@ -15,8 +15,23 @@","  * The open name has `data-open` (and `data-pinned` when pinned). The root","  * has `data-twoslash-hovers` while this runs, which turns off the CSS","  * `:hover` popups the prerendered page uses before it hydrates.","+ *","+ * A page's HTML leaves its popups' content out, as most of it would be","+ * popups: each popup is empty, with its index in the page's popups","+ * (`data-popup`). They load once the pointer enters a block, or a name is","+ * tapped, and each popup is filled the first time it opens.","  */"," ","+/** A page's popups, by their index (`data-popup`). */","+export type LoadPopups = () => Promise<ReadonlyArray<string>>;","+","+/** Popups that came with their HTML, as a snippet's (`v11/home/step-1.md`). */","+export function inlinePopups(sample: {","+  readonly popups: ReadonlyArray<string>;","+}): LoadPopups {","+  return () => Promise.resolve(sample.popups);","+}","+"," /** How long the pointer rests on a name before its popup opens. */"," export const openDelay = 150;"," /** The same, while another name's popup is open. */","@@ -74,8 +89,48 @@ export function placePopup(hover: Element) {","   popup.scrollTop = scrollTop;"," }"," ","-/** Runs the popups of the Twoslash blocks under `root` until the returned cleanup. */","-export function installTwoslashHovers(root: HTMLElement) {","+/**","+ * Fills `popup` with its content from `popups`, unless it's filled already.","+ * False while `popups` haven't loaded.","+ */","+function fillPopup(popup: HTMLElement, popups: ReadonlyArray<string> | null) {","+  const index = popup.dataset['popup'];","+  if (index === undefined) {","+    return true;","+  }","+  if (!popups) {","+    return false;","+  }","+  // SAFETY: build-time HTML from the repo's own code blocks, as the page's.","+  popup.innerHTML = popups[Number(index)] ?? '';","+  delete popup.dataset['popup'];","+  return true;","+}","+","+/**","+ * Runs the popups of the Twoslash blocks under `root` until the returned","+ * cleanup, with their content from `loadPopups`.","+ */","+export function installTwoslashHovers(","+  root: HTMLElement,","+  loadPopups: LoadPopups,","+) {","+  let popups: ReadonlyArray<string> | null = null;","+  let loading: Promise<ReadonlyArray<string> | null> | null = null;","+  // After a failed load (offline, or a deploy removed the chunk), popups","+  // stay empty and the next hover tries again.","+  const load = () =>","+    (loading ??= loadPopups().then(","+      (loaded) => {","+        popups = loaded;","+        return loaded;","+      },","+      (error: unknown) => {","+        console.error('Twoslash popups failed to load', error);","+        loading = null;","+        return null;","+      },","+    ));","   let open: Element | null = null;","   let pending: Element | null = null;","   let openTimer: ReturnType<typeof setTimeout> | undefined;","@@ -104,6 +159,20 @@ export function installTwoslashHovers(root: HTMLElement) {","       hover.setAttribute('data-open', '');","     }","     hover.toggleAttribute('data-pinned', pinned);","+    const popup = popupOf(hover);","+    if (popup && !fillPopup(popup, popups)) {","+      void load().then((loaded) => {","+        if (open !== hover) {","+          return;","+        }","+        if (loaded && fillPopup(popup, loaded)) {","+          placePopup(hover);","+        } else {","+          // Its popup failed to load: closed, the next tap tries again.","+          close();","+        }","+      });","+    }","     placePopup(hover);","   };"," ","@@ -117,6 +186,14 @@ export function installTwoslashHovers(root: HTMLElement) {","     if (event.pointerType === 'touch') {","       return;","     }","+    // The popups load while the pointer makes its way to a name.","+    if (","+      popups === null &&","+      isElement(event.target) &&","+      event.target.closest('.twoslash')","+    ) {","+      void load();","+    }","     const hover = hoverAt(event.target);","     if (hover === open) {","       // Back on the open name, or inside its popup.",""],"additions":79,"deletions":2,"truncated":false}],"additions":344,"deletions":24,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-09T17:51:04.893407+00:00"}