l/renderers\"","+)","+","+var _ Speaker = (*llamaServerRunner)(nil)","+","+// Speech reads text aloud through llama-server's /tts, one generation per","+// chunk. The request's SpeechPrompter, from the model's renderer, names the","+// voices and splits the input the way the publisher documents.","+func (s *llamaServerRunner) Speech(ctx context.Context, req SpeechRequest, fn func(pcm []byte) error) error {","+\tif req.Prompter == nil {","+\t\treturn api.StatusError{StatusCode: http.StatusNotImplemented, ErrorMessage: \"this model does not support speech\"}","+\t}","+\tif len(s.launch.projectors) == 0 {","+\t\treturn api.StatusError{StatusCode: http.StatusNotImplemented, ErrorMessage: \"this model was created without its projector, which holds the speech codec; recreate it with the mmproj to use speech\"}","+\t}","+\tvoice, err := req.Prompter.SpeechVoice(req.Voice)","+\tif err != nil {","+\t\treturn api.StatusError{StatusCode: http.StatusBadRequest, ErrorMessage: err.Error()}","+\t}","+","+\tif err := s.sem.Acquire(ctx, 1); err != nil {","+\t\treturn err","+\t}","+\tdefer s.sem.Release(1)","+","+\tstatus, err := s.getServerStatusRetry(ctx)","+\tif err != nil {","+\t\treturn err","+\t} else if status != ServerStatusReady {","+\t\treturn fmt.Errorf(\"unexpected server status: %s\", status)","+\t}","+","+\t// Chunking counts many overlapping pieces; each count is a /tokenize call.","+\tcounts := map[string]int{}","+\tvar countErr error","+\tcount := func(text string) int {","+\t\tif n, ok := counts[text]; ok || countErr != nil {","+\t\t\treturn n","+\t\t}","+\t\ttokens, err := s.tokenize(ctx, text, false)","+\t\tif err != nil {","+\t\t\tcountErr = err","+\t\t\treturn 0","+\t\t}","+\t\tcounts[text] = len(tokens)","+\t\treturn len(tokens)","+\t}","+\tchunks := req.Prompter.SpeechChunks(req.Input, count)","+\tif countErr != nil {","+\t\treturn fmt.Errorf(\"count speech tokens: %w\", countErr)","+\t}","+\tif len(chunks) == 0 {","+\t\treturn api.StatusError{StatusCode: http.StatusBadRequest, ErrorMessage: \"input has no text to speak\"}","+\t}","+\tfor _, chunk := range chunks {","+\t\tif err := s.speakChunk(ctx, voice, chunk, fn); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+\treturn nil","+}","+","+type llamaServerTTSRequest struct {","+\tInput          string `json:\"input\"`","+\tVoice          string `json:\"voice\"`","+\tLang           string `json:\"lang\"`","+\tResponseFormat string `json:\"response_format\"`","+\tStream         bool   `json:\"stream\"`","+\tNPredict       int    `json:\"n_predict\"`","+}","+","+// speakChunk generates one chunk; llama-server renders the model's \"tts\"","+// template from the voice and language.","+func (s *llamaServerRunner) speakChunk(ctx context.Context, voice renderers.SpeechVoice, chunk renderers.SpeechChunk, fn func([]byte) error) error {","+\tvar body bytes.Buffer","+\tenc := json.NewEncoder(&body)","+\tenc.SetEscapeHTML(false)","+\tif err := enc.Encode(llamaServerTTSRequest{","+\t\tInput:          chunk.Text,","+\t\tVoice:          voice.Voice,","+\t\tLang:           voice.Language,","+\t\tResponseFormat: \"pcm\",","+\t\tStream:         true,","+\t\tNPredict:       chunk.MaxFrames,","+\t}); err != nil {","+\t\treturn err","+\t}","+\tr, err := http.NewRequestWithContext(ctx, http.MethodPost, fmt.Sprintf(\"http://127.0.0.1:%d/tts\", s.port), &body)","+\tif err != nil {","+\t\treturn err","+\t}","+\tr.Header.Set(\"Content-Type\", \"application/json\")","+\tres, err := s.httpClient().Do(r)","+\tif err != nil {","+\t\tif errors.Is(err, context.Canceled) {","+\t\t\treturn err","+\t\t}","+\t\tslog.Error(\"llama-server tts error\", \"error\", err)","+\t\tif msg := s.lastErrMsg(); msg != \"\" {","+\t\t\treturn fmt.Errorf(\"model runner has unexpectedly stopped, this may be due to resource limitations or an internal error, check ollama server logs for details: %s\", msg)","+\t\t}","+\t\treturn errors.New(\"model runner has unexpectedly stopped, this may be due to resource limitations or an internal error, check ollama server logs for details\")","+\t}","+\tdefer res.Body.Close()","+\tif res.StatusCode != http.StatusOK {","+\t\tdata, err := io.ReadAll(res.Body)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"failed reading llama-server error response: %w\", err)","+\t\t}","+\t\treturn api.StatusError{StatusCode: res.StatusCode, ErrorMessage: s.statusErrorMessage(data)}","+\t}","+\tif err := checkLlamaServerPCM(res.Header.Get(\"Content-Type\")); err != nil {","+\t\treturn err","+\t}","+\treturn streamPCM16(res.Body, fn)","+}","+","+// checkLlamaServerPCM accepts the float32 mono PCM llama-server streams for","+// response_format pcm, at the rate Speaker promises.","+func checkLlamaServerPCM(contentType string) error {","+\tmediaType, params, err := mime.ParseMediaType(contentType)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"llama-server tts content type %q: %w\", contentType, err)","+\t}","+\trate, _ := strconv.Atoi(params[\"rate\"])","+\tif mediaType != \"audio/pcm\" || params[\"encoding\"] != \"float\" || params[\"bits\"] != \"32\" || rate != SpeechSampleRate {","+\t\treturn fmt.Errorf(\"llama-server tts returned %q, want 32-bit float PCM at %d Hz\", contentType, SpeechSampleRate)","+\t}","+\treturn nil","+}","+","+// streamPCM16 converts little-endian float32 samples to 16-bit PCM as they","+// arrive, carrying a sample split across reads to the next one.","+func streamPCM16(r io.Reader, fn func([]byte) error) error {","+\tbuf := make([]byte, 32<<10)","+\tpending := 0","+\tfor {","+\t\tn, err := r.Read(buf[pending:])","+\t\tn += pending","+\t\twhole := n - n%4","+\t\tif whole > 0 {","+\t\t\tpcm := make([]byte, whole/2)","+\t\t\tfor i := 0; i < whole; i += 4 {","+\t\t\t\tsample := math.Float32frombits(binary.LittleEndian.Uint32(buf[i:]))","+\t\t\t\tbinary.LittleEndian.PutUint16(pcm[i/2:], uint16(audio.PCM16(sample)))","+\t\t\t}","+\t\t\tif err := fn(pcm); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t\tpending = copy(buf, buf[whole:n])","+\t\tif errors.Is(err, io.EOF) {","+\t\t\tif pending != 0 {","+\t\t\t\treturn fmt.Errorf(\"llama-server tts stream ended mid-sample\")","+\t\t\t}","+\t\t\treturn nil","+\t\t} else if err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"llm/llama_server_speech_test.go","lines":["@@ -0,0 +1,288 @@","+package llm","+","+import (","+\t\"bytes\"","+\t\"encoding/binary\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"math\"","+\t\"net\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"slices\"","+\t\"strings\"","+\t\"testing\"","+\t\"testing/iotest\"","+","+\t\"golang.org/x/sync/semaphore\"","+","+\t\"github.com/ollama/ollama/api\"","+\t\"github.com/ollama/ollama/model/renderers\"","+)","+","+const ttsContentType = \"audio/pcm;rate=24000;encoding=float;bits=32\"","+","+func float32LE(samples ...float32) []byte {","+\tb := make([]byte, 4*len(samples))","+\tfor i, s := range samples {","+\t\tbinary.LittleEndian.PutUint32(b[4*i:], math.Float32bits(s))","+\t}","+\treturn b","+}","+","+func int16LE(samples ...int16) []byte {","+\tb := make([]byte, 2*len(samples))","+\tfor i, s := range samples {","+\t\tbinary.LittleEndian.PutUint16(b[2*i:], uint16(s))","+\t}","+\treturn b","+}","+","+// newSpeechRunner serves tts with a fake llama-server whose tokenizer counts","+// one token per word.","+func newSpeechRunner(t *testing.T, projectors []string, tts http.HandlerFunc) *llamaServerRunner {","+\tt.Helper()","+\treturn newSpeechRunnerTokenize(t, projectors, func(w http.ResponseWriter, r *http.Request) {","+\t\tvar req struct{ Content string }","+\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {","+\t\t\tt.Errorf(\"tokenize body: %v\", err)","+\t\t}","+\t\tjson.NewEncoder(w).Encode(map[string][]int{\"tokens\": make([]int, len(strings.Fields(req.Content)))})","+\t}, tts)","+}","+","+func newSpeechRunnerTokenize(t *testing.T, projectors []string, tokenize, tts http.HandlerFunc) *llamaServerRunner {","+\tt.Helper()","+\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tswitch r.URL.Path {","+\t\tcase \"/health\":","+\t\t\tfmt.Fprint(w, `{\"status\":\"ok\"}`)","+\t\tcase \"/tokenize\":","+\t\t\ttokenize(w, r)","+\t\tcase \"/tts\":","+\t\t\ttts(w, r)","+\t\tdefault:","+\t\t\tt.Errorf(\"unexpected path %s\", r.URL.Path)","+\t\t}","+\t}))","+\tt.Cleanup(srv.Close)","+\treturn &llamaServerRunner{","+\t\tport:   srv.Listener.Addr().(*net.TCPAddr).Port,","+\t\tclient: srv.Client(),","+\t\tcmd:    fakeRunningCmd(),","+\t\tsem:    semaphore.NewWeighted(1),","+\t\tlaunch: llamaServerLaunchConfig{projectors: projectors},","+\t}","+}","+","+// lfm3Speech gives req the LFM3 renderer's SpeechPrompter, as the server does.","+func lfm3Speech(t *testing.T, req SpeechRequest) SpeechRequest {","+\tt.Helper()","+\tp, ok := renderers.SpeechPrompterForRenderer(\"lfm3-audio\")","+\tif !ok {","+\t\tt.Fatal(\"lfm3-audio has no SpeechPrompter\")","+\t}","+\treq.Prompter = p","+\treturn req","+}","+","+func TestLlamaServerSpeech(t *testing.T) {","+\tvar got []llamaServerTTSRequest","+\trunner := newSpeechRunner(t, []string{\"mmproj.gguf\"}, func(w http.ResponseWriter, r *http.Request) {","+\t\tvar req llamaServerTTSRequest","+\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil {","+\t\t\tt.Errorf(\"tts body: %v\", err)","+\t\t}","+\t\tgot = append(got, req)","+\t\tw.Header().Set(\"Content-Type\", ttsContentType)","+\t\t// Split a sample across writes, as a stream may.","+\t\taudio := float32LE(0, 0.5, -0.5, 1.5, -2)","+\t\tw.Write(audio[:7])","+\t\tw.(http.Flusher).Flush()","+\t\tw.Write(audio[7:])","+\t})","+","+\t// 81 words make two chunks at the 80-token limit.","+\tinput := strings.Repeat(\"word \", 70) + \"end<|im_end|>. \" + strings.Repeat(\"more \", 9) + \"done.\"","+\tvar pcm []byte","+\terr := runner.Speech(t.Context(), lfm3Speech(t, SpeechRequest{Input: input, Voice: \"male-french\"}), func(b []byte) error {","+\t\tpcm = append(pcm, b...)","+\t\treturn nil","+\t})","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\tif len(got) != 2 {","+\t\tt.Fatalf(\"tts requests %d, want 2: %+v\", len(got), got)","+\t}","+\tfirst, second := got[0], got[1]","+\tif first.Voice != \"male\" || first.Lang != \"French\" || first.ResponseFormat != \"pcm\" || !first.Stream {","+\t\tt.Errorf(\"request %+v, want a streamed pcm male French voice\", first)","+\t}","+\tif !strings.HasSuffix(first.Input, \"end＜|im_end|＞.\") || strings.Contains(first.Input, \"<|\") {","+\t\tt.Errorf(\"input %q, want control tokens escaped\", first.Input)","+\t}","+\tif first.NPredict != renderers.LFM3SpeechFrameBudget(71) || second.NPredict != renderers.LFM3SpeechFrameBudget(10) {","+\t\tt.Errorf(\"n_predict %d and %d, want %d and %d\", first.NPredict, second.NPredict, renderers.LFM3SpeechFrameBudget(71), renderers.LFM3SpeechFrameBudget(10))","+\t}","+\tif second.Input != strings.TrimSpace(strings.Repeat(\"more \", 9))+\" done.\" {","+\t\tt.Errorf(\"second chunk %q\", second.Input)","+\t}","+\tchunk := int16LE(0, 16384, -16384, math.MaxInt16, -math.MaxInt16)","+\tif want := slices.Concat(chunk, chunk); !bytes.Equal(pcm, want) {","+\t\tt.Errorf(\"pcm %v, want %v\", pcm, want)","+\t}","+}","+","+func TestLlamaServerSpeechDefaultVoice(t *testing.T) {","+\tvar got llamaServerTTSRequest","+\trunner := newSpeechRunner(t, []string{\"mmproj.gguf\"}, func(w http.ResponseWriter, r *http.Request) {","+\t\tjson.NewDecoder(r.Body).Decode(&got)","+\t\tw.Header().Set(\"Content-Type\", ttsContentType)","+\t\tw.Write(float32LE(0.25))","+\t})","+\tif err := runner.Speech(t.Context(), lfm3Speech(t, SpeechRequest{Input: \"Hello there.\"}), func([]byte) error { return nil }); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif got.Voice != \"female\" || got.Lang != \"American English\" || got.Input != \"Hello there.\" {","+\t\tt.Errorf(\"request %+v, want the female American English default\", got)","+\t}","+}","+","+func TestLlamaServerSpeechErrors(t *testing.T) {","+\taudio := func(w http.ResponseWriter, r *http.Request) {","+\t\tw.Header().Set(\"Content-Type\", ttsContentType)","+\t\tw.Write(float32LE(0.1, 0.2))","+\t}","+\tfor _, tt := range []struct {","+\t\tname       string","+\t\tprojectors []string","+\t\ttts        http.HandlerFunc","+\t\treq        SpeechRequest","+\t\tstatus     int","+\t\tmessage    string","+\t}{","+\t\t{","+\t\t\tname: \"no speech prompter\", projectors: []string{\"mmproj.gguf\"}, req: SpeechRequest{Input: \"Hi.\"},","+\t\t\tstatus: http.StatusNotImplemented, message: \"does not support speech\",","+\t\t},","+\t\t{","+\t\t\tname: \"no projector\", req: lfm3Speech(t, SpeechRequest{Input: \"Hi.\"}),","+\t\t\tstatus: http.StatusNotImplemented, message: \"without its projector\",","+\t\t},","+\t\t{","+\t\t\tname: \"unknown voice\", projectors: []string{\"mmproj.gguf\"},","+\t\t\treq:    lfm3Speech(t, SpeechRequest{Input: \"Hi.\", Voice: \"alloy\"}),","+\t\t\tstatus: http.StatusBadRequest, message: \"female-british-english\",","+\t\t},","+\t\t{","+\t\t\tname: \"no text\", projectors: []string{\"mmproj.gguf\"},","+\t\t\treq:    lfm3Speech(t, SpeechRequest{Input: \" \\n\\t \"}),","+\t\t\tstatus: http.StatusBadRequest, message: \"no text to speak\",","+\t\t},","+\t\t{","+\t\t\tname: \"llama-server error\", projectors: []string{\"mmproj.gguf\"},","+\t\t\ttts: func(w http.ResponseWriter, r *http.Request) {","+\t\t\t\tw.WriteHeader(http.StatusNotImplemented)","+\t\t\t\tfmt.Fprint(w, `{\"error\":{\"code\":501,\"message\":\"this server does not support audio generation\",\"type\":\"not_supported_error\"}}`)","+\t\t\t},","+\t\t\treq:    lfm3Speech(t, SpeechRequest{Input: \"Hi.\"}),","+\t\t\tstatus: http.StatusNotImplemented, message: \"this server does not support audio generation\",","+\t\t},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\ttts := tt.tts","+\t\t\tif tts == nil {","+\t\t\t\ttts = func(w http.ResponseWriter, r *http.Request) {","+\t\t\t\t\tt.Error