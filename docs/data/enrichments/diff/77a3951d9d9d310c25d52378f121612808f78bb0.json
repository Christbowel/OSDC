{"id":"77a3951d9d9d310c25d52378f121612808f78bb0","axis":"silent","repo":"mongodb/mongo","sha":"77a3951d9d9d310c25d52378f121612808f78bb0","parsed":{"files":[{"path":"jstests/disk/validate_bson_inconsistency.js","lines":["@@ -11,7 +11,9 @@ import {","     insertInvalidRegex,","     insertInvalidUTF8,","     insertNonSequentialArrayIndexes,","+    rewriteTable,","     startMongodOnExistingPath,","+    wtHeaderLines,"," } from \"jstests/disk/libs/wt_file_helper.js\";"," "," const baseName = \"validate_bson_inconsistency\";","@@ -393,3 +395,55 @@ resetDbpath(dbpath);"," ","     MongoRunner.stopMongod(mongod, null, {skipValidation: true});"," })();","+","+(function validateInvalidBSONAfterNonConformantElement() {","+    jsTest.log.info(\"Validate documents with an unknown BSON type after a non-conformant element\");","+","+    const toHex = (str) =>","+        str","+            .split(\"\")","+            .map((c) => c.charCodeAt(0).toString(16).padStart(2, \"0\"))","+            .join(\"\");","+    // {validString: \"p\"} -> {validString: \"\\x80\"}: invalid UTF-8, so only non-conformant.","+    const stringElem = \"02\" + toHex(\"validString\") + \"00\" + \"02000000\" + \"70\";","+    // {zzzz: NumberInt(1)} -> type byte 0x7e, which does not exist, so the document is invalid.","+    const intElem = \"10\" + toHex(\"zzzz\") + \"00\";","+    const corrupt = function (lines) {","+        for (let i = wtHeaderLines; i < lines.length; i += 2) {","+            assert(lines[i].includes(stringElem) && lines[i].includes(intElem), lines[i]);","+            lines[i] = lines[i]","+                .replace(stringElem, stringElem.slice(0, -2) + \"80\")","+                .replace(intElem, \"7e\" + intElem.slice(2));","+        }","+    };","+","+    for (const indexSpec of [null, {partialFilterExpression: {zzzz: {$gt: 0}}}]) {","+        let mongod = startMongodOnExistingPath(dbpath);","+        let db = mongod.getDB(baseName);","+        const collName = collNamePrefix + count++;","+        db.createCollection(collName);","+        let testColl = db[collName];","+        if (indexSpec) {","+            assert.commandWorked(testColl.createIndex({zzzz: 1}, indexSpec));","+        }","+","+        const numDocs = 10;","+        for (let i = 0; i < numDocs; ++i) {","+            assert.commandWorked(testColl.insert({validString: \"p\", zzzz: NumberInt(1)}));","+        }","+        rewriteTable(getUriForColl(testColl), mongod, corrupt);","+","+        mongod = startMongodOnExistingPath(dbpath);","+        db = mongod.getDB(baseName);","+        testColl = db[collName];","+","+        for (const options of [{}, {checkBSONConformance: true}]) {","+            const res = assert.commandWorked(testColl.validate(options));","+            assert(!res.valid, tojson(res));","+            assert.eq(res.nInvalidDocuments, numDocs, tojson(res));","+        }","+        assert.commandWorked(db.adminCommand({ping: 1}));","+","+        MongoRunner.stopMongod(mongod, null, {skipValidation: true});","+    }","+})();"],"additions":54,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/BUILD.bazel","lines":["@@ -126,6 +126,7 @@ mongo_cc_unit_test(","         \"key_string_index_consistency_test.cpp\",","         \"record_store_slicer_test.cpp\",","         \"size_limited_bsonobj_heap_test.cpp\",","+        \"validate_adaptor_test.cpp\",","         \"validate_results_test.cpp\",","     ],","     tags = ["],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/validate/collection_validation_bm.cpp","lines":["@@ -61,6 +61,8 @@ struct DataSpec {","     int arrayLength{0};   // range(4): if > 0, field \"a1\" is an array of this length (making an","                           // index on it multikey). Only \"a1\" is arrayed so this axis varies index","                           // key count without also growing document size.","+    bool deprecatedType{false};  // range(5): if nonzero, every document carries a deprecated-type","+                                 // (Symbol) field, which BSON validation reports as non-conformant."," };"," "," // Creates 'numIndexes' secondary indexes on the (empty) collection, keyed on fields a1..aK. Must be","@@ -111,6 +113,9 @@ size_t insertRecords(OperationContext* opCtx, const DataSpec& spec) {","             if (spec.payloadBytes > 0) {","                 builder.append(\"p\", payload);","             }","+            if (spec.deprecatedType) {","+                builder.appendSymbol(\"d\", \"x\");","+            }","             auto obj = builder.obj();","             totalBytes += obj.objsize();","             batch.push_back(std::move(obj));","@@ -134,6 +139,7 @@ void BM_Validate(benchmark::State& state, collection_validation::ValidateMode mo","         .payloadBytes = static_cast<int>(state.range(2)),","         .numIndexes = static_cast<int>(state.range(3)),","         .arrayLength = static_cast<int>(state.range(4)),","+        .deprecatedType = state.range(5) != 0,","     };"," ","     ValidateBenchmarkFixture fixture;","@@ -165,28 +171,35 @@ void BM_Validate(benchmark::State& state, collection_validation::ValidateMode mo"," // Baseline shape: 4 small fields, no payload, no secondary indexes. Sweeps record count."," void RecordCountArgs(benchmark::internal::Benchmark* b) {","     for (int n : {1'000, 10'000, 100'000}) {","-        b->Args({n, 4, 0, 0, 0});","+        b->Args({n, 4, 0, 0, 0, 0});","     }"," }"," "," // Fixed record count; sweeps document size via a string payload field."," void DocSizeArgs(benchmark::internal::Benchmark* b) {","     for (int payload : {0, 256, 4'096, 16'384}) {","-        b->Args({50'000, 4, payload, 0, 0});","+        b->Args({50'000, 4, payload, 0, 0, 0});","     }"," }"," "," // Fixed record count; sweeps the number of (small) fields per document, stressing BSON traversal."," void FieldCountArgs(benchmark::internal::Benchmark* b) {","     for (int fields : {1, 8, 32, 128}) {","-        b->Args({50'000, fields, 0, 0, 0});","+        b->Args({50'000, fields, 0, 0, 0, 0});","     }"," }"," "," // Fixed record count; sweeps the number of secondary indexes (keyed on a1..aK; needs >= K fields)."," void IndexCountArgs(benchmark::internal::Benchmark* b) {","     for (int indexes : {0, 1, 2, 4}) {","-        b->Args({50'000, 4, 0, indexes, 0});","+        b->Args({50'000, 4, 0, indexes, 0, 0});","+    }","+}","+","+// Fixed record count; with and without a deprecated BSON type field in every document.","+void DeprecatedTypeArgs(benchmark::internal::Benchmark* b) {","+    for (const bool deprecatedType : {false, true}) {","+        b->Args({50'000, 4, 0, 0, 0, deprecatedType});","     }"," }"," ","@@ -235,8 +248,23 @@ BENCHMARK_CAPTURE(BM_Validate,","         {1, 1},            // numFields fixed","         {0, 0},            // payloadBytes fixed","         {1, 1},            // numIndexes fixed","-        {0, 1024}          // arrayLen sweeps: 0, 1, 4, 16, 64, 256, 1024","+        {0, 1024},         // arrayLen sweeps: 0, 1, 4, 16, 64, 256, 1024","+        {0, 0}             // deprecatedType off","     });","+","+// Deprecated-type axis (non-conformant documents take an extra structural validation pass).","+BENCHMARK_CAPTURE(BM_Validate,","+                  Foreground_DeprecatedType,","+                  collection_validation::ValidateMode::kForeground)","+    ->Apply(DeprecatedTypeArgs);","+BENCHMARK_CAPTURE(BM_Validate,","+                  ForegroundFull_DeprecatedType,","+                  collection_validation::ValidateMode::kForegroundFull)","+    ->Apply(DeprecatedTypeArgs);","+BENCHMARK_CAPTURE(BM_Validate,","+                  ForegroundFullCheckBSON_DeprecatedType,","+                  collection_validation::ValidateMode::kForegroundFullCheckBSON)","+    ->Apply(DeprecatedTypeArgs);"," // ── Timeseries variant ────────────────────────────────────────────────────────"," "," const NamespaceString kTsNss ="],"additions":33,"deletions":5,"truncated":false},{"path":"src/mongo/db/validate/collection_validation_test.cpp","lines":["@@ -1614,7 +1614,11 @@ TEST_F(TimeseriesCollectionValidationTest, TimeseriesValidationCorruptData) {","     }","     foregroundValidate(_nss,","                        _opCtx,","-                       {.valid = true, .numRecords = 1, .numErrors = 0, .numWarnings = 2},","+                       {.valid = false,","+                        .numRecords = 1,","+                        .numInvalidDocuments = 1,","+                        .numErrors = 1,","+                        .numWarnings = 1},","                        {_validateMode});"," }"," "],"additions":5,"deletions":1,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor.cpp","lines":["@@ -436,11 +436,11 @@ auto ValidateAdaptor::validateRecord(OperationContext* opCtx,","     bool validDocument{true};","     {","         boost::optional<std::string> bsonValidationDescription;","-        const Status bsonValidationStatus = validateBSON(record.data.data(),","-                                                         record.data.size(),","-                                                         _validateState->getBSONValidateMode(),","-                                                         validationVersion,","-                                                         &bsonValidationDescription);","+        Status bsonValidationStatus = validateBSON(record.data.data(),","+                                                   record.data.size(),","+                                                   _validateState->getBSONValidateMode(),","+                                                   validationVersion,","+                                                   &bsonValidationDescription);"," ","         if (!bsonValidationStatus.isOK()) {","             switch (bsonValidationStatus.code()) {","@@ -452,7 +452,23 @@ auto ValidateAdaptor::validateRecord(OperationContext* opCtx,","                                           \"reason\"_attr = bsonValidationStatus);","                     compliantDocument = false;","                     results.addWarning(_describeBSONNonConformantResult(bsonValidationDescription));","-                    break;","+                    // Non Conformant BSON may trigger on the first non-compliant field, this can","+                    // mask corruption past that point in the document. In the event that","+                    // non-conformance triggers a warning, run a check for structural integrity of","+                    // the BSON document, if that fails, additionally log as an error.","+                    // TODO: SERVER-136504 Remove second structural check when full/extended","+                    // validation no longer early exit.","+                    bsonValidationStatus = validateBSON(record.data.data(),","+                                                        record.data.size(),","+                                                        BSONValidateModeEnum::kDefault,","+                                                        validationVersion,","+                                                        &bsonValidationDescription);","+                    if (bsonValidationStatus.isOK()) {","+                        // Structurally sound, only log as warning.","+                        break;","+                    }","+                    // Log error and skip subsequent checks.","+                    [[fallthrough]];","                 default:","                     // The failing check is named in the returned error message via the","                     // description passed back out-of-band, so the message stays bounded rather"],"additions":22,"deletions":6,"truncated":false},{"path":"src/mongo/db/validate/validate_adaptor_test.cpp","lines":["@@ -0,0 +1,155 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/validate/validate_adaptor.h\"","+","+#include \"mongo/base/data_view.h\"","+#include \"mongo/bson/bsonobj.h\"","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/db/shard_role/shard_catalog/catalog_test_fixture.h\"","+#include \"mongo/db/validate/key_string_index_consistency.h\"","+#include \"mongo/db/validate/validate_options.h\"","+#include \"mongo/db/validate/validate_results.h\"","+#include \"mongo/db/validate/validate_state.h\"","+#include \"mongo/unittest/unittest.h\"","+","+#include <string_view>","+#include <vector>","+","+namespace mongo::collection_validation {","+using namespace std::literals::string_view_literals;","+namespace {","+","+const auto kNss = NamespaceString::createNamespaceString_forTest(\"validateAdaptorDB.coll\"sv);","+","+class ValidateAdaptorTest : public CatalogTestFixture {","+protected:","+    struct Result {","+        ValidateAdaptor::ValidateRecordResult record;","+        ValidateResults results;","+    };","+","+    void createCollection(const CollectionOptions& options, const std::vector<BSONObj>& indexes) {","+        ASSERT_OK(storageInterface()->createCollection(operationContext(), kNss, options));","+        if (!indexes.empty()) {","+            ASSERT_OK(storageInterface()->createIndexesOnEmptyCollection(","+                operationContext(), kNss, indexes));","+        }","+    }","+","+    Result validateRecord(const std::vector<char>& data, ValidateMode mode) {","+        auto opCtx = operationContext();","+        ValidateState validateState(","+            opCtx, kNss, ValidationOptions(mode, RepairMode::kNone, /*logDiagnostics=*/false));","+        ASSERT_OK(validateState.initializeCollection(opCtx));","+        validateState.initializeCursors(opCtx);","+","+        const auto& coll = validateState.getCollection();","+        std::vector<const IndexCatalogEntry*> indexEntries;","+        for (const auto& indexIdent : validateState.getIndexIdents()) {","+            indexEntries.push_back(coll->getIndexCatalog()->findIndexByIdent(opCtx, indexIdent));","+        }","+","+        ValidateAdaptor adaptor(opCtx, &validateState);","+        KeyStringIndexConsistency keyStringIndexConsistency(opCtx, &validateState);","+        Result result;","+        const Record record{RecordId(1), RecordData(data.data(), data.size())};","+        result.record = adaptor.validateRecord(","+            opCtx, record, result.results, keyStringIndexConsistency, indexEntries);","+        return result;","+    }","+};","+","+std::vector<char> toBuffer(const BSONObj& obj) {","+    const char* begin = obj.objdata();","+    return {begin, begin + obj.objsize()};","+}","+","+// Overwrites the type byte of 'fieldName' with a type that does not exist.","+std::vector<char> withUnknownType(const BSONObj& obj, std::string_view fieldName) {","+    auto data = toBuffer(obj);","+    data[obj[fieldName].rawdata() - obj.objdata()] = 0x7E;","+    return data;","+}","+","+// Overwrites the length prefix of the string 'fieldName' so that it extends far past the buffer.","+std::vector<char> withOversizedStringLength(const BSONObj& obj, std::string_view fieldName) {","+    auto data = toBuffer(obj);","+    DataView(data.data() + (obj[fieldName].value() - obj.objdata()))","+        .write<LittleEndian<int32_t>>(0x7FFFFFF0);","+    return data;","+}","+","+BSONObj withInvalidUTF8(std::string_view fieldName) {","+    BSONObjBuilder builder;","+    builder.append(\"_id\", 1);","+    builder.append(fieldName, \"z\\xff\"sv);","+    builder.append(\"b\", 1);","+    return builder.obj();","+}","+","+TEST_F(ValidateAdaptorTest, ConformantDocumentIsValid) {","+    createCollection({}, {});","+    const auto result = validateRecord(toBuffer(BSON(\"_id\" << 1 << \"a\" << \"z\")),","+                                       ValidateMode::kForegroundCheckBSON);","+    EXPECT_OK(result.record.status);","+    EXPECT_TRUE(result.record.compliantDocument);","+    EXPECT_TRUE(result.record.validDocument);","+}","+","+TEST_F(ValidateAdaptorTest, NonConformantDocumentIsCompliantFalse) {","+    createCollection({}, {});","+    const auto result =","+        validateRecord(toBuffer(withInvalidUTF8(\"a\")), ValidateMode::kForegroundCheckBSON);","+    EXPECT_OK(result.record.status);","+    EXPECT_FALSE(result.record.compliantDocument);","+}","+","+TEST_F(ValidateAdaptorTest, InvalidBSONAfterNonConformantElementIsReported) {","+    createCollection({}, {});","+    const auto result = validateRecord(withUnknownType(withInvalidUTF8(\"a\"), \"b\"),","+                                       ValidateMode::kForegroundCheckBSON);","+    EXPECT_EQ(result.record.status.code(), ErrorCodes::InvalidBSON);","+}","+","+TEST_F(ValidateAdaptorTest, InvalidBSONAfterNonConformantElementIsReportedWithPartialIndex) {","+    createCollection({},","+                     {BSON(\"v\" << 2                        //","+                               << \"name\" << \"b_1\"          //","+                               << \"key\" << BSON(\"b\" << 1)  //","+                               << \"partialFilterExpression\" << BSON(\"b\" << BSON(\"$gt\" << 0)))});","+    const auto result = validateRecord(withUnknownType(withInvalidUTF8(\"a\"), \"b\"),","+                                       ValidateMode::kForegroundCheckBSON);","+    EXPECT_EQ(result.record.status.code(), ErrorCodes::InvalidBSON);","+}","+","+TEST_F(ValidateAdaptorTest, OversizedStringAfterNonConformantElementIsReported) {","+    createCollection({},","+                     {BSON(\"v\" << 2                //","+                               << \"name\" << \"b_1\"  //","+                               << \"key\" << BSON(\"b\" << 1))});","+    BSONObjBuilder builder;","+    builder.append(\"_id\", 1);","+    builder.append(\"a\", \"z\\xff\"sv);","+    builder.append(\"b\", \"x\");","+    const auto result = validateRecord(withOversizedStringLength(builder.obj(), \"b\"),","+                                       ValidateMode::kForegroundCheckBSON);","+    EXPECT_EQ(result.record.status.code(), ErrorCodes::InvalidBSON);","+}","+","+TEST_F(ValidateAdaptorTest, InvalidUTF8InCollatedPartialIndexFieldDoesNotThrow) {","+    CollectionOptions options;","+    options.collation = BSON(\"locale\" << \"en_US\");","+    createCollection(options,","+                     {BSON(\"v\" << 2                //","+                               << \"name\" << \"a_1\"  //","+                               << \"key\" << BSON(\"a\" << 1) << \"partialFilterExpression\"","+                               << BSON(\"a\" << BSON(\"$gt\" << \"m\")))});","+    const auto result =","+        validateRecord(toBuffer(withInvalidUTF8(\"a\")), ValidateMode::kForegroundCheckBSON);","+    EXPECT_OK(result.record.status);","+    EXPECT_FALSE(result.record.compliantDocument);","+}","+","+}  // namespace","+}  // namespace mongo::collection_validation",""],"additions":155,"deletions":0,"truncated":false}],"additions":270,"deletions":12,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-16T14:20:40.424942+00:00"}