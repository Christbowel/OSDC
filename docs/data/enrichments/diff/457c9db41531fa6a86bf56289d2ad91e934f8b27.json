(UniversalRegionRelations {","+                universal_regions: self.universal_regions,","+                outlives: self.outlives.freeze(),","+                inverse_outlives: self.inverse_outlives.freeze(),","+            }),","+            known_type_outlives_obligations: Frozen::freeze(known_type_outlives_obligations),","+            region_bound_pairs: Frozen::freeze(self.region_bound_pairs),","+            normalized_inputs_and_output,","+        }","+    }","+","     #[instrument(level = \"debug\", skip(self))]","     pub(crate) fn create(mut self) -> CreateResult<'tcx> {","+        if !self.infcx.next_trait_solver() {","+            return self.create_old();","+        }","+","         let tcx = self.infcx.tcx;","         let body_def_id = self.universal_regions.defining_ty.def_id().expect_local();","         let span = tcx.def_span(body_def_id);","@@ -378,6 +541,26 @@ impl<'tcx> UniversalRegionRelationsBuilder<'_, 'tcx> {","         }","     }"," ","+    // FIXME(#160491): Remove this once the new implied bounds impl is through FCP.","+    #[instrument(level = \"debug\", skip(self))]","+    fn add_implied_bounds(","+        &mut self,","+        ty: Ty<'tcx>,","+        span: Span,","+    ) -> Option<&'tcx QueryRegionConstraints<'tcx>> {","+        let TypeOpOutput { output: bounds, constraints, .. } = self","+            .infcx","+            .fully_perform(type_op::ImpliedOutlivesBounds { ty }, span)","+            .map_err(|_: ErrorGuaranteed| debug!(\"failed to compute implied bounds {:?}\", ty))","+            .ok()?;","+        debug!(?bounds, ?constraints);","+        // Because of #109628, we may have unexpected placeholders. Ignore them!","+        // FIXME(#109628): panic in this case once the issue is fixed.","+        let bounds = bounds.into_iter().filter(|bound| !bound.has_placeholders());","+        self.add_outlives_bounds(bounds);","+        constraints","+    }","+","     /// Registers the `OutlivesBound` items from `outlives_bounds` in