rray`","+\t\t);","+\t}","+","+\treturn warnings;","+}","+","+/**","+ * Validates that a tsconfig contains `\"extends\": \"<id>\"`","+ * @param {any} options","+ * @param {string} id","+ */","+export function extends_id(options, id) {","+\tconst o = options.extends;","+\treturn Array.isArray(o) ? o.includes(id) : o === id;","+}"],"additions":128,"deletions":0,"truncated":false},{"path":"packages/kit/src/core/sync/write_tsconfig/validate.spec.js","lines":["@@ -0,0 +1,60 @@","+import { assert, describe, test } from 'vitest';","+import { extends_id, validate_exclusions, validate_types } from './validate.js';","+","+describe('extends_id', () => {","+\tconst id = 'POTATO';","+","+\ttest('validates that a config extends an id (string)', () => {","+\t\tassert.equal(extends_id({ extends: id }, id), true);","+\t});","+","+\ttest('validates that a config extends an id (array)', () => {","+\t\tassert.equal(extends_id({ extends: [id] }, id), true);","+\t});","+","+\ttest('validates that a config does not extend an id', () => {","+\t\tassert.equal(extends_id({}, id), false);","+\t});","+});","+","+describe('validate_types', () => {","+\ttest('warns if types is overwritten', () => {","+\t\tconst warnings = validate_types([], ['pinky', 'perky'], []);","+","+\t\tassert.deepEqual(warnings, ['\"types\" was overwritten. It must include \"pinky\" and \"perky\"']);","+\t});","+});","+","+describe('validate_exclusions', () => {","+\ttest('warns if service worker is incorrectly included', () => {","+\t\tconst warnings = validate_exclusions(","+\t\t\t[],","+\t\t\t'/path/to/project',","+\t\t\t['/path/to/project/src/service-worker'],","+\t\t\t['/path/to/project/src/service-worker/index.ts']","+\t\t);","+","+\t\tassert.deepEqual(warnings, ['\"src/service-worker\" should be added to the \"exclude\" array']);","+\t});","+","+\ttest('does not warn if service worker is absent', () => {","+\t\tconst warnings = validate_exclusions(","+\t\t\t[],","+\t\t\t'/path/to/project',","+\t\t\t['/path/to/projec