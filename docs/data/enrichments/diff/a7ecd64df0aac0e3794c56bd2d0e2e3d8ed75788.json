{"id":"a7ecd64df0aac0e3794c56bd2d0e2e3d8ed75788","axis":"silent","repo":"pytorch/pytorch","sha":"a7ecd64df0aac0e3794c56bd2d0e2e3d8ed75788","parsed":{"files":[{"path":"aten/src/ATen/FakeTensor.h","lines":["@@ -26,9 +26,16 @@ TORCH_API void set_and_normalize_fake_device("," //"," // impl must read as meta: a meta tensor, or, inside a kernel, a fake. The"," // latter is how the fake fallback (later in this stack) makes a new fake of a","-// kernel's output that inherited a fake input's Fake key and ExtraMeta, such as","-// a view op's output; its fake device and mode are replaced. A rejected impl is","-// left unchanged.","+// kernel output that inherited fake state from an input. A view whose kernel","+// calls maybe_copy_fake_tensor_metadata (e.g. as_strided, alias, view,","+// _reshape_alias) has the input's fake device and mode, while one whose kernel","+// does not (view_as_real, view_as_complex, view.dtype) inherits only the Fake","+// key. A shallow copy, such as detach's output, has a copy of the input's","+// ExtraMeta (see ExtraMeta's copy constructor for what is kept), including the","+// real tensor and recorded dispatch keys (see Note [C++ fake dispatch keys]).","+// init_cpp_fake itself replaces only the fake device and mode and keeps the","+// rest of the ExtraMeta; the fallback then sets the real tensor and dispatch","+// keys as Python does for an op's output. A rejected impl is left unchanged."," TORCH_API void init_cpp_fake(","     c10::TensorImpl* impl,","     c10::Device device,"],"additions":10,"deletions":3,"truncated":false},{"path":"c10/core/TensorImpl.h","lines":["@@ -303,6 +303,21 @@ struct C10_API FakeTensorMode {","       constant_storage_mapping_;"," };"," ","+// Note [C++ fake dispatch keys]","+// A fake can record the dispatch keys of the real tensor it stands for","+// (ExtraMeta::fake_dispatch_keys_, Python's FakeTensor.dispatch_keys), so that","+// guards built from the fake check the real tensor's keys rather than the","+// fake's own. Python also derives is_mkldnn and layout from them; here only","+// guards read them, so a fake recorded with an mkldnn tensor's keys still","+// reports its own layout.","+// Python keeps them on the output of a top-level alias or detach (dispatched,","+// through functionalization, or by calling fast_detach directly), but not of","+// other views. Here ExtraMeta's copy constructor copies them, so every shallow","+// copy, such as detach, keeps them, while views, including alias, drop them;","+// matching Python is left to the C++ fake dispatch path (later in this stack).","+// Functionalization's alias/detach handling currently covers only a Python","+// FakeTensor. Unlike Python, fake.data = other gives the fake other's keys, as","+// set_data replaces the whole ExtraMeta."," struct C10_API ExtraMeta {","   std::unique_ptr<c10::SymbolicShapeMeta> symbolic_shape_meta_ = nullptr;","   intrusive_ptr<c10::BackendMeta> backend_meta_ = nullptr;","@@ -312,6 +327,8 @@ struct C10_API ExtraMeta {","   std::shared_ptr<FakeTensorMode> fake_tensor_mode_ = nullptr;","   // The real tensor this fake shadows, when propagate_real_tensors is on.","   c10::intrusive_ptr<c10::TensorImpl> real_tensor_ = nullptr;","+  // See Note [C++ fake dispatch keys]","+  std::optional<c10::DispatchKeySet> fake_dispatch_keys_ = std::nullopt;","   // The real constant this fake was created from (via","   // FakeTensorMode::set_constant), or null.","   c10::intrusive_ptr<c10::TensorImpl> fake_constant_ = nullptr;","@@ -343,6 +360,7 @@ struct C10_API ExtraMeta {","     fake_device_ = other.fake_device_;","     fake_tensor_mode_ = other.fake_tensor_mode_;","     real_tensor_ = other.real_tensor_;","+    fake_dispatch_keys_ = other.fake_dispatch_keys_;","     symbolic_wrapped_number_ = other.symbolic_wrapped_number_;","   }","   ExtraMeta& operator=(const ExtraMeta& other) = delete;","@@ -1571,6 +1589,15 @@ struct C10_API TensorImpl : public c10::intrusive_ptr_target {","     return extra_meta_->fake_tensor_mode_;","   }"," ","+  // The recorded dispatch keys of the real tensor this fake stands for.","+  void set_fake_dispatch_keys(std::optional<DispatchKeySet> keys) {","+    get_extra_meta().fake_dispatch_keys_ = keys;","+  }","+","+  std::optional<DispatchKeySet> fake_dispatch_keys() const {","+    return extra_meta_ ? extra_meta_->fake_dispatch_keys_ : std::nullopt;","+  }","+","   // The real tensor this fake shadows under propagate_real_tensors, or nullptr.","   void set_real_tensor(c10::intrusive_ptr<c10::TensorImpl> real) {","     get_extra_meta().real_tensor_ = std::move(real);"],"additions":27,"deletions":0,"truncated":false},{"path":"test/test_fake_tensor.py","lines":["@@ -45,6 +45,7 @@","     is_fake_tensor,","     maybe_get_fake_constant,","     maybe_get_fake_device,","+    maybe_get_fake_dispatch_keys,","     maybe_get_fake_mode,","     maybe_get_real_tensor,","     MetadataMismatchError,","@@ -5867,6 +5868,69 @@ def test_suspend_for_real_tensors(self):","             torch._C._unset_dispatch_mode(torch._C._TorchDispatchModeKey.FAKE)","         self.assertEqual(self._installed(), (None, False))"," ","+    @skipIfTorchDynamo(_CPP_FAKE_DYNAMO_SKIP)","+    def test_set_get_fake_dispatch_keys(self):","+        mode, _ = self._make_mode()","+        meta = torch.empty(2, device=\"meta\")","+        meta_fake = torch._C._from_meta_and_device(meta, torch.device(\"meta\"), mode)","+        self.assertIsNone(maybe_get_fake_dispatch_keys(meta_fake))","+        keys = torch._C._dispatch_keys(torch.empty(2))","+        torch._C._set_fake_dispatch_keys(meta_fake, keys)","+        self.assertEqual(maybe_get_fake_dispatch_keys(meta_fake), keys)","+        # Excluding Fake runs the kernels themselves. detach keeps them, like a","+        # Python FakeTensor's. alias's kernel does not: ops such as _conj call","+        # it internally, and Python gives their outputs no keys.","+        fake_key = torch._C.DispatchKeySet(torch._C.DispatchKey.Fake)","+        with torch._C._ExcludeDispatchKeyGuard(fake_key):","+            detached = meta_fake.detach()","+            aliased = torch.ops.aten.alias(meta_fake)","+        self.assertEqual(maybe_get_fake_dispatch_keys(detached), keys)","+        self.assertTrue(torch._C._is_fake_tensor(aliased))","+        self.assertIsNone(torch._C._get_fake_dispatch_keys(aliased))","+        self.assertEqual(maybe_get_fake_dispatch_keys(meta_fake), keys)","+        # A functional wrapper copies the fake's ExtraMeta, keys included, but","+        # is not itself a fake","+        functional = torch._to_functional_tensor(meta_fake)","+        self.assertIsNone(maybe_get_fake_dispatch_keys(functional))","+        for real in (torch.empty(2), functional):","+            with self.assertRaisesRegex(RuntimeError, \"Expected a fake tensor\"):","+                torch._C._set_fake_dispatch_keys(real, keys)","+            with self.assertRaisesRegex(RuntimeError, \"Expected a fake tensor\"):","+                torch._C._get_fake_dispatch_keys(real)","+        torch._C._set_fake_dispatch_keys(meta_fake, None)","+        self.assertIsNone(maybe_get_fake_dispatch_keys(meta_fake))","+        # set_data replaces the whole ExtraMeta, so the destination takes the","+        # source's keys, or none","+        cpu = torch.device(\"cpu\")","+        dst = torch._C._from_meta_and_device(torch.empty(2, device=\"meta\"), cpu, mode)","+        src = torch._C._from_meta_and_device(torch.empty(2, device=\"meta\"), cpu, mode)","+        torch._C._set_fake_dispatch_keys(dst, keys)","+        dst.data = src","+        self.assertIsNone(maybe_get_fake_dispatch_keys(dst))","+        torch._C._set_fake_dispatch_keys(src, keys)","+        dst.data = src","+        self.assertEqual(maybe_get_fake_dispatch_keys(dst), keys)","+        # Guards serialize the recorded keys, or the fake's own without them,","+        # and a loaded guard carries them, as tested for Python fakes in","+        # test_guard_serialization.py","+        from torch._dynamo.guards import GuardsStatePickler","+        from torch._dynamo.package import load_guards_state","+","+        torch._C._set_fake_dispatch_keys(src, None)","+        for fake, expected in ((dst, keys), (src, torch._C._dispatch_keys(src))):","+            buf = io.BytesIO()","+            pickler = GuardsStatePickler({id(fake): fake}, {}, {}, {}, buf)","+            template, _, _, keys_raw, _ = pickler.reducer_override(fake)[1]","+            self.assertIs(type(template), torch.Tensor)","+            self.assertFalse(torch._C._is_fake_tensor(template))","+            self.assertEqual(keys_raw, expected.raw_repr())","+            pickler.dump({\"t\": fake})","+            # Neither the C++ mode (_CppFakeTensorMode) nor its wrapper is pickled","+            for name in (b\"FakeTensorMode\", b\"_CppModeWrapper\"):","+                self.assertNotIn(name, buf.getvalue())","+            out = load_guards_state(buf.getvalue())[\"t\"]","+            self.assertEqual(maybe_get_fake_dispatch_keys(out), expected)","+"," "," if __name__ == \"__main__\":","     run_tests()"],"additions":64,"deletions":0,"truncated":false},{"path":"torch/_C/__init__.pyi.in","lines":["@@ -2289,6 +2289,8 @@ def _remove_cached_tensor(t: Tensor) -> None: ..."," def _is_fake_tensor(t: Tensor) -> _bool: ..."," def _get_real_tensor(t: Tensor) -> Tensor | None: ..."," def _clear_fake_real_tensor(t: Tensor) -> None: ...","+def _set_fake_dispatch_keys(fake: Tensor, keys: DispatchKeySet | None) -> None: ...","+def _get_fake_dispatch_keys(fake: Tensor) -> DispatchKeySet | None: ..."," def _fake_device(t: Tensor) -> _device: ..."," def _set_fake_device(t: Tensor, device: _device) -> None: ..."," def _set_real_tensor(fake: Tensor, real: Tensor) -> None: ..."],"additions":2,"deletions":0,"truncated":false},{"path":"torch/_dynamo/guards.py","lines":["@@ -5267,10 +5267,11 @@ def reducer_override(","                     inner_data,","                 )"," ","-            # _dispatch_keys() on a fake reports the Python and","-            # PythonTLSSnapshot keys of the fake itself; the converter may","-            # have recorded the real tensor's keys (from_meta_and_device","-            # always does, from_real_tensor only for an mkldnn source).","+            # _dispatch_keys() on a fake reports the fake's own keys: besides","+            # the fake device's backend, Python and PythonTLSSnapshot for a","+            # Python FakeTensor and Fake for a C++ fake. A fake may instead","+            # have recorded the real tensor's keys, e.g. a fake of an mkldnn","+            # tensor (see Note [C++ fake dispatch keys] for a C++ fake).","             dispatch_keys = maybe_get_fake_dispatch_keys(obj)","             if dispatch_keys is None:","                 dispatch_keys = torch._C._dispatch_keys(obj)"],"additions":5,"deletions":4,"truncated":false},{"path":"torch/_subclasses/fake_tensor.py","lines":["@@ -476,9 +476,11 @@ def maybe_clear_fake_constant(x: object) -> None:"," "," "," def maybe_get_fake_dispatch_keys(x: object) -> torch.DispatchKeySet | None:","-    # The real tensor's dispatch keys recorded on a fake.","+    # The real tensor's dispatch keys recorded on a Python or C++ fake.","     if isinstance(x, FakeTensor):  # noqa: ISINSTANCE_FAKE_TENSOR","         return x.dispatch_keys","+    if isinstance(x, Tensor) and torch._C._is_fake_tensor(x):","+        return torch._C._get_fake_dispatch_keys(x)","     return None"," "," "],"additions":3,"deletions":1,"truncated":false},{"path":"torch/csrc/Module.cpp","lines":["@@ -2882,6 +2882,26 @@ Call this whenever a new thread is created in order to propagate values from","     fake.unsafeGetTensorImpl()->set_real_tensor(nullptr);","   });"," ","+  // See Note [C++ fake dispatch keys]","+  py_module.def(","+      \"_set_fake_dispatch_keys\",","+      [](const at::Tensor& fake, std::optional<c10::DispatchKeySet> keys) {","+        TORCH_CHECK(fake.defined(), \"Expected a defined tensor\");","+        TOR