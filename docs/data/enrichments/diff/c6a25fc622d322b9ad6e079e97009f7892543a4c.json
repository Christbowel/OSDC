/app/content/MarkdownContent/plugins/rehype/lazy-highlight.ts","lines":["@@ -0,0 +1,149 @@","+/**","+ * Rehype plugin that highlights code blocks like rehype-highlight, loading highlight.js and each language only when a","+ * message has a block in it.","+ *","+ * Only `<pre><code>` blocks with a language class (`language-ts`, `lang-ts`) are highlighted; `no-highlight` opts a","+ * block out, and a language highlight.js lacks is left plain. rehype-highlight itself is not used: it bundles","+ * lowlight's common languages, which would load all at once.","+ */","+","+import { CODE_BLOCK, CODE_BLOCK_CLASS } from '#lib/constants/index.ts';","+import {","+\tgetLoadedHighlightLanguages,","+\tloadHighlightLanguages,","+\tresolveHighlightLanguage","+} from '#lib/utils/code.ts';","+import type { Element, ElementContent, Root } from 'hast';","+import type { Plugin } from 'unified';","+import { visit } from 'unist-util-visit';","+","+type Lowlight = ReturnType<(typeof import('./lowlight-core'))['createLowlight']>;","+","+export interface LazyHighlightOptions {","+\t/** Extra aliases per language, as rehype-highlight takes them: `{ xml: ['svelte', 'vue'] }`. */","+\taliases?: Record<string, string | readonly string[]>;","+}","+","+interface CodeBlock {","+\tnode: Element;","+\t/** The highlight.js language to use, or undefined for one it lacks. */","+\tname: string | undefined;","+}","+","+let lowlight: Lowlight | undefined;","+let lowlightLoading: Promise<Lowlight> | undefined;","+","+const registered = new Set<string>();","+","+// the language a code element's class names, false for `no-highlight`, as rehype-highlight reads it","+function classLanguage(node: Element): string | false | undefined {","+\tconst list = node.properties?.className;","+","+\tif (!Array.isArray(list)) return undefined;","+","+\tlet name: string | undefined;","+","+\tfor (const item of list) {","+\t\tconst value = String(item);","+","+\t\tif ((CODE_BLOCK.NO_HIGHLIGHT_CLASSES as readonly string[]).includes(value)) return false;","+","+\t\tfor (const prefix of [CODE_BLOCK.LANG_CLASS_PREFIX, CODE_BLOCK.LANGUAGE_CLASS_PREFIX]) {","+\t\t\tif (!name && value.startsWith(prefix)) name = value.slice(prefix.length);","+\t\t}","+\t}","+","+\treturn name;","+}","+","+function textContent(node: ElementContent | Element): string {","+\tif (node.type === 'text') return node.value;","+","+\tif (node.type !== 'element') return '';","+","+\treturn node.children.map(textContent).join('');","+}","+","+function loadLowlight(): Promise<Lowlight> {","+\tlowlightLoading ??= import('./lowlight-core').then(","+\t\t({ createLowlight }) => (lowlight = createLowlight()),","+\t\t(error) => {","+\t\t\tlowlightLoading = undefined;","+","+\t\t\tthrow error;","+\t\t}","+\t);","+","+\treturn lowlightLoading;","+}","+","+// registers the languages highlightCode's loader has loaded with lowlight, as highlight.js ships them","+function registerLoadedLanguages(target: Lowlight): void {","+\tfor (const [name, definition] of Object.entries(getLoadedHighlightLanguages())) {","+\t\tif (registered.has(name)) continue;","+","+\t\ttarget.register(name, definition);","+\t\tregistered.add(name);","+\t}","+}","+","+function highlightBlocks(target: Lowlight, blocks: CodeBlock[]): void {","+\tfor (const { name, node } of blocks) {","+\t\tconst className = Array.isArray(node.properties.className)","+\t\t\t? node.properties.className","+\t\t\t: (node.properties.className = []);","+","+\t\tif (!className.includes(CODE_BLOCK_CLASS.HLJS)) className.unshift(CODE_BLOCK_CLASS.HLJS);","+","+\t\tif (!name || !registered.has(name)) continue;","+","+\t\tconst result = target.highlight(name, textContent(node));","+","+\t\tif (result.children.length > 0) node.children = result.children as ElementContent[];","+\t}","+}","+","+// synchronous when there is no code block or its languages have loaded, so a message waits only for a language it","+// is the first to use, and every other one renders in the same pass as before","+export const rehypeLazyHighlight: Plugin<[LazyHighlightOptions?], Root> = (options = {}) => {","+\tconst extraAliases = new Map<string, string>();","+","+\tfor (const [language, aliases] of Object.entries(options.aliases ?? {})) {","+\t\tfor (const alias of [aliases].flat()) extraAliases.set(alias.toLowerCase(), language);","+\t}","+","+\treturn (tree) => {","+\t\tconst blocks: CodeBlock[] = [];","+","+\t\tvisit(tree, 'element', (node: Element, _, parent) => {","+\t\t\tif (node.tagName !== 'code' || parent?.type !== 'element' || parent.tagName !== 'pre') {","+\t\t\t\treturn;","+\t\t\t}","+","+\t\t\tconst language = classLanguage(node);","+","+\t\t\tif (!language) return;","+","+\t\t\tconst key = language.toLowerCase();","+","+\t\t\tblocks.push({ name: resolveHighlightLanguage(extraAliases.get(key) ?? key), node });","+\t\t});","+","+\t\tif (!blocks.length) return;","+","+\t\tconst names = [","+\t\t\t...new Set(blocks.map((block) => block.name).filter((name) => name !== undefined))","+\t\t];","+","+\t\tif (lowlight && names.every((name) => registered.has(name))) {","+\t\t\thighlightBlocks(lowlight, blocks);","+","+\t\t\treturn;","+\t\t}","+","+\t\treturn Promise.all([loadLowlight(), loadHighlightLanguages(names)]).then(([target]) => {","+\t\t\tregisterLoadedLanguages(target);","+\t\t\thighlightBlocks(target, blocks);","+\t\t});","+\t};","+};"],"additions":149,"deletions":0,"truncated":false},{"path":"ui/apps/chat/src/lib/components/app/content/MarkdownContent/plugins/rehype/lowlight-core.ts","lines":["@@ -0,0 +1,3 @@","+// lowlight without its bundled language sets, for lazy-highlight.ts to load with the first code block: a static","+// re-export of createLowlight alone lets the build drop lowlight's `common` and `all`","+export { createLowlight } from 'lowlight';"],"additions":3,"deletions":0,"truncated":false},{"path":"ui/apps/chat/src/lib/components/app/content/MarkdownContent/plugins/rehype/pre-transform.ts","lines":["@@ -1,3 +1,4 @@","+import { CODE_BLOCK } from '#lib/constants/index.ts';"," import type { Element, ElementContent, Root, Text } from 'hast';"," import type { Plugin } from 'unified';"," import { visit } from 'unist-util-visit';","@@ -50,7 +51,7 @@ export function createPreTransform("," \tcontentGuard?: (text: string) => boolean"," ): Plugin<[], Root> {"," \tconst codeClasses = (Array.isArray(languages) ? languages : [languages]).map(","-\t\t(language) => `language-${language}`","+\t\t(language) => `${CODE_BLOCK.LANGUAGE_CLASS_PREFIX}${language}`"," \t);"," "," \treturn () => {"],"additions":2,"deletions":1,"truncated":false},{"path":"ui/apps/chat/src/lib/utils/code.ts","lines":["@@ -1,6 +1,13 @@"," import { CODE_BLOCK, NEWLINE } from '#lib/constants/index.ts';"," ","-export { highlightCode, trimCodePadding } from '@ggml-org/llama-ui/code';","+export {","+\tgetLoadedHighlightLanguages,","+\thighlightCode,","+\tisHighlightLanguageLoaded,","+\tloadHighlightLanguages,","+\tresolveHighlightLanguage,","+\ttrimCodePadding","+} from '@ggml-org/llama-ui/code';"," "," export interface IncompleteCodeBlock {"," \tlanguage: string;"],"additions":8,"deletions":1,"truncated":false},{"path":"ui/apps/chat/src/lib/utils/index.ts","lines":["@@ -33,6 +33,8 @@ export {"," // Code"," export {"," \thighlightCode,","+\tisHighlightLanguageLoaded,","+\tloadHighlightLanguages,"," \tdetectIncompleteCodeBlock,"," \tsplitGluedClosingCodeFences,"," \ttrimCodePadding,"],"additions":2,"deletions":0,"truncated":false},{"path":"ui/apps/chat/tests/unit/agentic-hotpath.bench.ts","lines":["@@ -7,7 +7,11 @@"," // Run: npx vitest bench --project=unit tests/unit/agentic-hotpath.bench.ts"," "," import { classifyToolResult, parseToolResultWithMedia } from '#lib/utils/agentic.ts';","-import { detectIncompleteCodeBlock, highlightCode } from '#lib/utils/code.ts';","+import {","+\tdetectIncompleteCodeBlock,","+\thighlightCode,","+\tloadHighlightLanguages","+} from '#lib/utils/code.ts';"," import { computeLineDiff } from '#lib/utils/compute-line-diff.ts';"," import { preprocessLaTeX } from '#lib/utils/latex-protection.ts';"," import { parsePartialJsonArgs } from '#lib/utils/parse-partial-json-args.ts';","@@ -228,6 +232,9 @@ describe('parsePartialJsonArgs', () => {"," "," // --- F / I: highlight.js ---------------------------------------------------"," ","+// highlightCode returns plain text until highlight.js has loaded","+await loadHighlightLanguages();","+"," describe('highlightCode', () => {"," \tbench('short bash command (title row, per token)', () => {"," \t\thighlightCode('grep -rn \"foo\" src/ | head -50', 'bash');"],"additions":8,"deletions":1,"truncated":false},{"path":"ui/apps/chat/tests/unit/code.test.ts","lines":["@@ -1,5 +1,12 @@","-import { highlightCode, splitGluedClosingCodeFences, trimCodePadding } from '#lib/utils/code.ts';","-import { describe, expect, it } from 'vitest';","+import {","+\thighlightCode,","+\tloadHighlightLanguages,","+\tsplitGluedClosingCodeFences,","+\ttrimCodePadding","+} from '#lib/utils/code.ts';","+import { beforeAll, describe, expect, it } from 'vitest';","+","+beforeAll(() => loadHighlightLanguages());"," "," describe('trimCodePadding', () => {"," \tit('removes a single leading newline', () => {"],"additions":9,"deletions":2,"truncated":false},{"path":"ui/apps/chat/tests/unit/lazy-highlight.test.ts","lines":["@@ -0,0 +1,117 @@","+import { rehypeLazyHighlight } from '#lib/components/app/content/MarkdownContent/plugins/rehype/lazy-highlight.ts';","+import {","+\thighlightCode,","+\tisHighlightLanguageLoaded,","+\tloadHighlightLanguages,","+\tresolveHighlightLanguage","+} from '#lib/utils/code.ts';","+import type { Root } from 'hast';","+import rehypeStringify from 'rehype-stringify';","+import { remark } from 'remark';","+import remarkRehype from 'remark-rehype';","+import { describe, expect, it } from 'vitest';","+","+// one file, so these run in order against one fresh loader: nothing has loaded when it starts","+describe('highlightCode before its language loads', () => {","+\tit('resolves aliases to highlight.js names', () => {","+\t\texpect(resolveHighlightLanguage('ts')).toBe('typescript');","+\t\texpect(resolveHighlightLanguage('SH')).toBe('bash');","+\t\texpect(resolveHighlightLanguage('yml')).toBe('yaml');","+\t\texpect(resolveHighlightLanguage('python')).toBe('python');","+\t\texpect(resolveHighlightLanguage('constructor')).toBeUndefined();","+\t\texpect(resolveHighlightLanguage('not-a-language')).toBeUndefined();","+\t});","+","+\tit('returns plain text, then highlights once that language (and only it) has loaded', async () => {","+\t\texpect(highlightCode('\\nconst x = 1;\\n', 'ts')).toBe('const x = 1;');","+","+\t\tawait loadHighlightLanguages(['ts']);","+","+\t\texpect(isHighlightLanguageLoaded('typescript')).toBe(true);","+\t\texpect(highlightCode('const x = 1;', 'ts')).toContain('hljs-keyword');","+\t\texpect(isHighlightLanguageLoaded('python')).toBe(false);","+\t});","+","+\tit('loads the languages a language embeds with it', async () => {","+\t\tawait loadHighlightLanguages(['html']);","+","+\t\texpect(isHighlightLanguageLoaded('css')).toBe(true);","+\t\texpect(highlightCode('<style>a { color: red; }</style>', 'html')).toContain('hljs-attribute');","+\t});","+","+\tit('leaves an unknown language plain without auto-detection', () => {","+\t\texpect(highlightCode('<b>a && b</b>', 'not-a-language', false)).toBe(","+\t\t\t'&lt;b&gt;a &amp;&amp; b&lt;/b&gt;'","+\t\t);","+\t});","+","+\tit('auto-detects an unknown language among the common languages once they load', async () => {","+\t\tconst code = 'def greet(name):\\n    return f\"hi {name}\"';","+","+\t\texpect(highlightCode(code, 'not-a-language')).toBe(code);","+","+\t\t// that call started loading every common language","+\t\tconst html = await waitForHighlight(() => highlightCode(code, 'not-a-language'));","+","+\t\texpect(html).toContain('hljs-');","+\t});","+});","+","+async function waitForHighlight(highlight: () => string): Promise<string> {","+\tfor (let i = 0; i < 50; i++) {","+\t\tconst html = highlight();","+","+\t\tif (html.includes('hljs-')) return html;","+","+\t\tawait new Promise((resolve) => setTimeout(resolve, 20));","+\t}","+","+\treturn highlight();","+}","+","+const processor = remark()","+\t.use(remarkRehype)","+\t.use(rehypeLazyHighlight, { aliases: { xml: ['svelte'] } })","+\t.use(rehypeStringify);","+","+async function render(markdown: string): Promise<string> {","+\treturn processor.stringify((await processor.run(processor.parse(markdown))) as Root);","+}","+","+describe('rehypeLazyHighlight', () => {","+\tit('leaves a message without a code block as it is, in the same pass', () => {","+\t\tconst tree = processor.runSync(processor.parse('Just *text* and `code`')) as Root;","+","+\t\texpect(processor.stringify(tree)).toBe('<p>Just <em>text</em> and <code>code</code></p>');","+\t});","+","+\tit('loads a block language, then highlights it in the same pass', async () => {","+\t\tconst markdown = '```rust\\nfn main() {}\\n```';","+\t\tconst first = await render(markdown);","+","+\t\texpect(first).toContain('<code class=\"hljs language-rust\">');","+\t\texpect(first).toContain('hljs-keyword');","+","+\t\tconst second = processor.stringify(processor.runSync(processor.parse(markdown)) as Root);","+","+\t\texpect(second).toBe(first);","+\t});","+","+\tit('uses highlight.js definitions, not highlightCode bash changes', async () => {","+\t\tconst html = await render('```sh\\ncurl -LsSf https://example.com\\n```');","+","+\t\texpect(html).toContain('<code class=\"hljs language-sh\">');","+\t\texpect(html).not.toContain('hljs-built_in\">curl');","+\t});","+","+\tit('takes extra aliases', async () => {","+\t\texpect(await render('```svelte\\n<div>{x}</div>\\n```')).toContain('hljs-tag');","+\t});","+","+\tit('leaves unknown languages, no-highlight and blocks without a language plain', async () => {","+\t\texpect(await render('```not-a-language\\nx = 1\\n```')).toBe(","+\t\t\t'<pre><code class=\"hljs language-not-a-language\">x = 1\\n</code></pre>'","+\t\t);","+\t\texpect(await render('```\\nx = 1\\n```')).toBe('<pre><code>x = 1\\n</code></pre>');","+\t});","+});"],"additions":117,"deletions":0,"truncated":false},{"path":"ui/lib/ui/README.md","lines":["@@ -49,7 +49,13 @@ Next: llama.app's model page."," "," The constants, enums and code helpers the components use are entry points too, for an app that shows the same things:"," `@ggml-org/llama-ui/constants` (the shared classes and code-block constants), `@ggml-org/llama-ui/enums` (`ColorMode`,","-`TooltipSide`, `BooleanString`) and `@ggml-org/llama-ui/code` (`highlightCode`, `trimCodePadding`). The model data","+`TooltipSide`, `BooleanString`) and `@ggml-org/llama-ui/code` (`highlightCode`, `trimCodePadding`,","+`loadHighlightLanguages`, `isHighlightLanguageLoaded`, `resolveHighlightLanguage`, `getLoadedHighlightLanguages`).","+highlight.js loads one language at a time, each its own chunk, so none is in an app's first load: until a language","+has loaded, `highlightCode` returns the code escaped as plain text, and a `$derived` or `$effect` that called it runs","+again once it has. A language loads with the ones it embeds (CSS and JavaScript inside HTML); auto-detection picks","+among lowlight's common languages. Await `loadHighlightLanguages([...])` where highlighted output is needed at once.","+`scripts/generate-highlight-languages.mjs` regenerates the language table after a highlight.js or lowlight update. The model data"," (constants, enums, formatters and types) comes with the Model UI at `@ggml-org/llama-ui/models`."," "," ## How the apps in this repo use it"],"additions":7,"deletions":1,"truncated":false},{"path":"ui/lib/ui/scripts/generate-highlight-languages.mjs","lines":["@@ -0,0 +1,98 @@","+// Writes src/lib/utils/highlight-languages.ts: one loader per highlight.js language lowlight ships (each its own chunk","+// in an app's build), the aliases that name them, and lowlight's common languages, which auto-detection picks from.","+// Run it after updating highlight.js or lowlight: node scripts/generate-highlight-languages.mjs","+import { execFileSync } from \"node:child_process\";","+import { writeFileSync } from \"node:fs\";","+import hljs from \"highlight.js/lib/core\";","+import { all, common } from \"lowlight\";","+","+const OUTPUT = new URL(","+  \"../src/lib/utils/highlight-languages.ts\",","+  import.meta.url,","+);","+","+const names = Object.keys(all).sort();","+const aliases = {};","+const subLanguages = {};","+","+// the languages a definition embeds (`subLanguage`: CSS and JavaScript inside HTML, say), which highlight.js leaves","+// plain unless they are registered too","+function collectSubLanguages(mode, found, seen = new Set()) {","+  if (!mode || typeof mode !== \"object\" || seen.has(mode)) return found;","+","+  seen.add(mode);","+","+  for (const sub of [mode.subLanguage ?? []].flat())","+    found.add(sub.toLowerCase());","+","+  for (const value of Object.values(mode)) {","+    if (Array.isArray(value))","+      for (const item of value) collectSubLanguages(item, found, seen);","+    else if (value && typeof value === \"object\")","+      collectSubLanguages(value, found, seen);","+  }","+","+  return found;","+}","+","+// register in lowlight's order, so an alias two languages claim names the same one it does in lowlight","+for (const name of names) {","+  const highlighter = hljs.newInstance();","+","+  highlighter.registerLanguage(name, all[name]);","+","+  for (const alias of highlighter.getLanguage(name)?.aliases ?? []) {","+    const key = alias.toLowerCase();","+","+    if (key !== name && !(key in all)) aliases[key] = name;","+  }","+}","+","+for (const name of names) {","+  const definition = all[name](hljs);","+  const found = [...collectSubLanguages(definition, new Set())]","+    .map((sub) => (sub in all ? sub : aliases[sub]))","+    .filter((sub) => sub && sub !== name);","+","+  if (found.length) subLanguages[name] = [...new Set(found)].sort();","+}","+","+const quote = (s) => `'${s}'`;","+const key = (s) => (/^[a-z_$][\\w$]*$/i.test(s) ? s : quote(s));","+","+const source = `// Generated by scripts/generate-highlight-languages.mjs from lowlight's languages; do not edit by hand.","+import type { LanguageFn } from 'highlight.js';","+","+/** Loads one highlight.js language, by its name. */","+export const HIGHLIGHT_LANGUAGE_LOADERS: Record<string, () => Promise<{ default: LanguageFn }>> = {","+${names.map((n) => `\\t${key(n)}: () => import('highlight.js/lib/languages/${n}')`).join(\",\\n\")}","+};","+","+/** The language each alias names (\\`js\\` -> \\`javascript\\`), as highlight.js resolves it. */","+export const HIGHLIGHT_LANGUAGE_ALIASES: Record<string, string> = {","+${Object.keys(aliases)","+  .sort()","+  .map((a) => `\\t${key(a)}: ${quote(aliases[a])}`)","+  .join(\",\\n\")}","+};","+","+/** The languages each language embeds, to load with it so its embedded code is highlighted too. */","+export const HIGHLIGHT_SUB_LANGUAGES: Record<string, readonly string[]> = {","+${Object.keys(subLanguages)","+  .map((n) => `\\t${key(n)}: [${subLanguages[n].map(quote).join(\", \")}]`)","+  .join(\",\\n\")}","+};","+","+/** lowlight's common languages: the ones auto-detection picks from. */","+export const HIGHLIGHT_AUTO_DETECT_LANGUAGES: readonly string[] = [","+${Object.keys(common)","+  .sort()","+  .map((n) => `\\t${quote(n)}`)","+  .join(\",\\n\")}","+];","+`;","+","+writeFileSync(OUTPUT, source);","+execFileSync(\"npx\", [\"prettier\", \"--write\", OUTPUT.pathname], {","+  stdio: \"inherit\",","+});"],"additions":98,"deletions":0,"truncated":false},{"path":"ui/lib/ui/src/lib/constants/code-block.constants.ts","lines":["@@ -8,9 +8,15 @@ export const CODE_BLOCK = {","   /** Matches opening/closing markdown code fences. */","   FENCE_PATTERN: /^```|\\n```/g,","   GT_REGEX: />/g,","+  /** Short form of the class prefix that names a code element's language (`lang-ts`). */","+  LANG_CLASS_PREFIX: \"lang-\",","+  /** Class pref