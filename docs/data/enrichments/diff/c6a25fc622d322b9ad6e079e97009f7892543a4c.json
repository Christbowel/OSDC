{"id":"c6a25fc622d322b9ad6e079e97009f7892543a4c","axis":"silent","repo":"ggerganov/llama.cpp","sha":"c6a25fc622d322b9ad6e079e97009f7892543a4c","parsed":{"files":[{"path":"ui/apps/chat/src/lib/components/app/content/MarkdownContent/markdown-processor.ts","lines":["@@ -13,6 +13,7 @@ import { rehypeEnhanceMermaidBlocks } from './plugins/rehype/enhance-mermaid-blo"," import { rehypeEnhanceSvgBlocks } from './plugins/rehype/enhance-svg-blocks';"," import { rehypeEnhanceTables } from './plugins/rehype/enhance-tables';"," import { rehypeFileBadge } from './plugins/rehype/file-badge';","+import { rehypeLazyHighlight } from './plugins/rehype/lazy-highlight';"," import { rehypeLazyKatex } from './plugins/rehype/lazy-katex';"," import { rehypeMermaidPre } from './plugins/rehype/mermaid-pre';"," import { rehypeRtlSupport } from './plugins/rehype/rehype-rtl-support';","@@ -23,9 +24,7 @@ import { remarkLiteralHtml } from './plugins/remark/literal-html';"," import { FileTypeText } from '#lib/enums/files.enums.ts';"," import type { DatabaseMessageExtra } from '#lib/types/database.js';"," import type { Root as HastRoot } from 'hast';","-import { all as lowlightAll } from 'lowlight';"," import type { Root as MdastRoot } from 'mdast';","-import rehypeHighlight from 'rehype-highlight';"," import rehypeStringify from 'rehype-stringify';"," import { remark } from 'remark';"," import remarkBreaks from 'remark-breaks';","@@ -75,10 +74,9 @@ function buildPipeline({"," \t}"," "," \tconst pipeline = proc","-\t\t.use(rehypeHighlight, {","-\t\t\taliases: { [FileTypeText.XML]: [FileTypeText.SVELTE, FileTypeText.VUE] },","-\t\t\tlanguages: lowlightAll","-\t\t}) // Add syntax highlighting","+\t\t.use(rehypeLazyHighlight, {","+\t\t\taliases: { [FileTypeText.XML]: [FileTypeText.SVELTE, FileTypeText.VUE] }","+\t\t}) // Add syntax highlighting, loading highlight.js with the first message that has a code block"," \t\t.use(rehypeRestoreTableHtml) // Restore limited HTML (e.g. <br>, <ul>) inside Markdown