{"id":"76b7982a7cafa76936564f46a6b7f9511105e921","axis":"silent","repo":"expo/expo","sha":"76b7982a7cafa76936564f46a6b7f9511105e921","parsed":{"files":[{"path":".changeset/expo-spm-direct-macros-package.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo': patch","+---","+","+[iOS] A module built from its checked-in Package.swift gets the Expo Swift macros through the `ExpoModulesCoreHeaders` package, which depends on the `expo-modules-macros` Swift package. The SwiftPM plugin no longer links the macro plugin into the build folder, and the manifest needs no unsafe flags."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/haptics-sensors-direct-spm-manifests.md","lines":["@@ -0,0 +1,6 @@","+---","+'expo-haptics': patch","+'expo-sensors': patch","+---","+","+[iOS] Build from a checked-in Package.swift that the Expo SwiftPM plugin uses directly when the module is built from source."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/sensors-motion-permission-runtime.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-sensors': patch","+---","+","+[iOS] Read the `motionPermission: false` opt-out at runtime, so it also applies to precompiled and SwiftPM builds."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/expo-haptics/Package.swift","lines":["@@ -1,12 +1,9 @@"," // swift-tools-version: 6.2"," import PackageDescription"," ","-// The platforms below exist so this manifest is still valid on its own.","-//","-// `dependencies` is empty at both levels on purpose. ExpoModulesCore, React and Hermes","-// resolve to app- or build-local paths that a checked-in manifest cannot name, so Expo's","-// SwiftPM autolinking plugin and the prebuild pipeline inject them at generation time. A","-// manifest that declares them for itself is rejected rather than merged.","+// Expo's SwiftPM plugin builds this manifest through a symlink to this directory at","+// `<app>/ios/build/generated/autolinking/expo/direct/expo-haptics`. Relative package paths","+// such as `../ExpoModulesCoreHeaders` resolve against that symlink, not against this directory."," let package = Package(","   name: \"expo-haptics\",","   platforms: [","@@ -15,13 +12,18 @@ let package = Package(","   products: [","     .library(name: \"ExpoHaptics\", targets: [\"ExpoHaptics\"])","   ],","-  dependencies: [],","+  dependencies: [","+    .package(path: \"../ExpoModulesCoreHeaders\")","+  ],","   targets: [","     .target(","       name: \"ExpoHaptics\",","-      dependencies: [],","+      dependencies: [","+        .product(name: \"ExpoModulesCoreHeaders\", package: \"ExpoModulesCoreHeaders\")","+      ],","       path: \"ios\",","       exclude: [\"ExpoHaptics.podspec\"]","     )","-  ]","+  ],","+  swiftLanguageModes: [.v5]"," )"],"additions":11,"deletions":9,"truncated":false},{"path":"packages/expo-haptics/spm.config.json","lines":["@@ -11,6 +11,7 @@","         \"Hermes\",","         \"expo-modules-core/ExpoModulesCore\"","       ],","+      \"swiftLanguageVersions\": [\"5\"],","       \"targets\": [","         {","           \"type\": \"swift\","],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-sensors/Package.swift","lines":["@@ -0,0 +1,29 @@","+// swift-tools-version: 6.2","+import PackageDescription","+","+// Expo's SwiftPM plugin builds this manifest through a symlink to this directory at","+// `<app>/ios/build/generated/autolinking/expo/direct/expo-sensors`. Relative package paths","+// such as `../ExpoModulesCoreHeaders` resolve against that symlink, not against this directory.","+let package = Package(","+  name: \"expo-sensors\",","+  platforms: [","+    .iOS(\"16.4\")","+  ],","+  products: [","+    .library(name: \"ExpoSensors\", targets: [\"ExpoSensors\"])","+  ],","+  dependencies: [","+    .package(path: \"../ExpoModulesCoreHeaders\"),","+  ],","+  targets: [","+    .target(","+      name: \"ExpoSensors\",","+      dependencies: [","+        .product(name: \"ExpoModulesCoreHeaders\", package: \"ExpoModulesCoreHeaders\"),","+      ],","+      path: \"ios\",","+      exclude: [\"ExpoSensors.podspec\", \"Tests\"]","+    ),","+  ],","+  swiftLanguageModes: [.v5]","+)"],"additions":29,"deletions":0,"truncated":false},{"path":"packages/expo-sensors/ios/MotionPermissionRequester.swift","lines":["@@ -26,16 +26,27 @@ public final class MotionPermissionRequester: NSObject, EXPermissionsRequester {","     return \"motion\"","   }"," ","+  // The compile define comes from the `MOTION_PERMISSION` Podfile property. Precompiled and","+  // SwiftPM builds cannot receive a per-app define, so the config plugin also writes this key.","+  static func isMotionPermissionDisabled(","+    infoDictionaryValue: (String) -> Any? = Bundle.main.object(forInfoDictionaryKey:)","+  ) -> Bool {","+    #if EXPO_DISABLE_MOTION_PERMISSION","+    return true","+    #else","+    return infoDictionaryValue(\"ExpoSensors_disableMotionPermission\") as? Bool == true","+    #endif","+  }","+","   private var motionUsageDescription: Any? {","     infoDictionaryValue(\"NSMotionUsageDescription\")","   }"," ","   public func getPermissions() -> [AnyHashable: Any] {","-    #if EXPO_DISABLE_MOTION_PERMISSION","-    return [\"status\": EXPermissionStatusDenied.rawValue]","-    #else","+    if Self.isMotionPermissionDisabled(infoDictionaryValue: infoDictionaryValue) {","+      return [\"status\": EXPermissionStatusDenied.rawValue]","+    }","     return Self.permissions(authorizationStatus: authorizationStatus(), usageDescription: motionUsageDescription)","-    #endif","   }"," ","   // `authorizationStatus` is an autoclosure because touching CMPedometer without the usage","@@ -72,11 +83,11 @@ public final class MotionPermissionRequester: NSObject, EXPermissionsRequester {","     resolver resolve: @escaping EXPromiseResolveBlock,","     rejecter reject: @escaping EXPromiseRejectBlock","   ) {","-    #if EXPO_DISABLE_MOTION_PERMISSION","-    resolve(getPermissions())","-    #else","+    if Self.isMotionPermissionDisabled(infoDictionaryValue: infoDictionaryValue) {","+      resolve(getPermissions())","+      return","+    }","     requestPermissions(usageDescription: motionUsageDescription, resolver: resolve, rejecter: reject)","-    #endif","   }"," ","   func requestPermissions("],"additions":19,"deletions":8,"truncated":false},{"path":"packages/expo-sensors/ios/PedometerModule.swift","lines":["@@ -18,11 +18,10 @@ public final class PedometerModule: Module {","     Events(EVENT_PEDOMETER_UPDATE)"," ","     AsyncFunction(\"isAvailableAsync\") {","-      #if EXPO_DISABLE_MOTION_PERMISSION","-      return false","-      #else","+      if MotionPermissionRequester.isMotionPermissionDisabled() {","+        return false","+      }","       return CMPedometer.isStepCountingAvailable()","-      #endif","     }"," ","     AsyncFunction(\"getStepCountAsync\") { (startTime: Double, endTime: Double, promise: Promise) in"],"additions":3,"deletions":4,"truncated":false},{"path":"packages/expo-sensors/ios/SensorsUtils.swift","lines":["@@ -1,6 +1,7 @@"," // Copyright 2023-present 650 Industries. All rights reserved."," "," import CoreMotion","+import UIKit"," "," internal func getAttitudeReferenceFrame() -> CMAttitudeReferenceFrame {","   let referenceFrames = CMMotionManager.availableAttitudeReferenceFrames()"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-sensors/ios/Tests/MotionPermissionRequesterTests.swift","lines":["@@ -78,7 +78,7 @@ struct MotionPermissionRequesterTests {"," ","     let permissions = requester.getPermissions()"," ","-    #expect(infoDictionary.requestedKeys == [\"NSMotionUsageDescription\"])","+    #expect(infoDictionary.requestedKeys == [\"ExpoSensors_disableMotionPermission\", \"NSMotionUsageDescription\"])","     #expect(permissions[\"status\"] as? UInt32 == EXPermissionStatusGranted.rawValue)","   }"," ","@@ -93,7 +93,7 @@ struct MotionPermissionRequesterTests {"," ","     let permissions = requester.getPermissions()"," ","-    #expect(in