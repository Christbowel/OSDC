Status: authorizationStatus.read","+    )","+","+    let permissions = requester.getPermissions()","+","+    #expect(infoDictionary.requestedKeys == [\"ExpoSensors_disableMotionPermission\"])","+    #expect(authorizationStatus.reads == 0)","+    #expect(permissions[\"status\"] as? UInt32 == EXPermissionStatusDenied.rawValue)","+  }","+","+  @Test","+  func `requestPermissions resolves denied without touching CoreMotion when the opt-out is set`() {","+    let infoDictionary = InfoDictionarySpy([\"ExpoSensors_disableMotionPermission\": true])","+    let authorizationStatus = AuthorizationStatusSpy()","+    let requester = MotionPermissionRequester(","+      infoDictionaryValue: infoDictionary.value(forKey:),","+      authorizationStatus: authorizationStatus.read","+    )","+    var resolved: [AnyHashable: Any]?","+","+    requester.requestPermissions { result in","+      resolved = result as? [AnyHashable: Any]","+    } rejecter: { _, _, _ in","+      Issue.record(\"requestPermissions rejected instead of resolving\")","+    }","+","+    #expect(!infoDictionary.requestedKeys.contains(\"NSMotionUsageDescription\"))","     #expect(authorizationStatus.reads == 0)","     #expect(resolved?[\"status\"] as? UInt32 == EXPermissionStatusDenied.rawValue)","   }"],"additions":55,"deletions":3,"truncated":false},{"path":"packages/expo-sensors/jest.config.js","lines":["@@ -0,0 +1 @@","+module.exports = require('@expo/internal-scripts/createCompositeJestPreset')(__dirname, ['plugin']);"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-sensors/package.json","lines":["@@ -55,8 +55,5 @@","   \"peerDependencies\": {","     \"expo\": \"*\",","     \"react-native\": \"*\"","-  },","-  \"jest\": {","-    \"preset\": \"@expo/internal-scripts\"","   }"," }"],"additions":0,"deletions":3,"truncated":false},{"path":"packages/expo-sensors/plugin/src/__tests__/withSensors-test.ts","lines":["@@ -0,0 +1,25 @@","+import { DISABLE_MOTION_PERMISSION_KEY, setMotionPermissionDisabled } from '../withSensors';","+","+describe(setMotionPermissionDisabled, () => {","+  it(`sets the opt-out when motionPermission is false`, () => {","+    expect(setMotionPermissionDisabled({ motionPermission: false }, {})).toEqual({","+      ExpoSensors_disableMotionPermission: true,","+    });","+  });","+","+  it.each([undefined, 'Allow $(PRODUCT_NAME) to access your device motion'])(","+    `does not set the opt-out when motionPermission is %p`,","+    (motionPermission) => {","+      expect(setMotionPermissionDisabled({ motionPermission }, {})).toEqual({});","+    }","+  );","+","+  it(`removes a stale opt-out when motionPermission is no longer false`, () => {","+    expect(","+      setMotionPermissionDisabled(","+        {},","+        { [DISABLE_MOTION_PERMISSION_KEY]: true, CFBundleName: 'app' }","+      )","+    ).toEqual({ CFBundleName: 'app' });","+  });","+});"],"additions":25,"deletions":0,"truncated":false},{"path":"packages/expo-sensors/plugin/src/withSensors.ts","lines":["@@ -1,13 +1,18 @@"," import {","   ConfigPlugin,","   createRunOncePlugin,","+  InfoPlist,","   IOSConfig,","+  withInfoPlist,","   withPodfileProperties,"," } from 'expo/config-plugins';"," "," const pkg = require('../../package.json');"," const MOTION_USAGE = 'Allow $(PRODUCT_NAME) to access your device motion';"," ","+// Read by `MotionPermissionRequester.isMotionPermissionDisabled` in the iOS module (do not change).","+export const DISABLE_MOTION_PERMISSION_KEY = 'ExpoSensors_disableMotionPermission';","+"," export type Props = {","   /**","    * A string to set the `NSMotionUsageDescription` permission message, or `false` to disable.","@@ -17,6 +22,18 @@ export type Props = {","   motionPermission?: string | false;"," };"," ","+export function setMotionPermissionDisabled(","+  { motionPermission }: Props,","+  infoPlist: InfoPlist","+): InfoPlist {","+  if (motionPermission === false) {","+    infoPlist[DISABLE_MOTION_PERMISSION_KEY] = true;","+  } else {","+    delete infoPli