ated package over its sources."," "],"additions":3,"deletions":1,"truncated":false},{"path":"packages/expo/scripts/spm/__tests__/direct.test.js","lines":["@@ -11,12 +11,7 @@ jest.mock('../cli', () => ({"," }));"," "," const { runDumpPackage } = require('../cli');","-const {","-  dependsOnCoreHeaders,","-  dumpModuleManifest,","-  emitDirectPackage,","-  prepareDirectWatchPaths,","-} = require('../direct');","+const { dependsOnCoreHeaders, dumpModuleManifest, emitDirectPackage } = require('../direct');"," const { rerunSpmUpdate, thrownBy } = require('./helpers');"," "," const hapticsManifest = {","@@ -137,6 +132,7 @@ describe('emitDirectPackage', () => {","   let pkgDir;","   let coreHeadersXCFramework;","   let jsiHeadersPkgPath;","+  let macrosPackageRoot;"," ","   const emit = () =>","     emitDirectPackage({","@@ -145,17 +141,22 @@ describe('emitDirectPackage', () => {","       outDir,","       coreHeadersXCFramework,","       jsiHeadersPkgPath,","-      macroTool: path.join(root, 'ExpoModulesMacros'),","+      macrosPackageRoot,","       manifest: hapticsManifest,","     });","   const manifest = () => fs.readFileSync(path.join(pkgDir, 'Package.swift'), 'utf8');"," ","   beforeEach(() => {","-    delete process.env.BUILD_DIR;","     root = fs.mkdtempSync(path.join(os.tmpdir(), 'direct-emit-'));","     outDir = path.join(root, 'out');","     pkgDir = path.join(outDir, 'direct', 'ExpoModulesCoreHeaders');","     jsiHeadersPkgPath = path.join(outDir, 'ExpoModulesJSIHeaders');","+    macrosPackageRoot = path.join(root, 'node_modules', 'expo-modules-macros');","+    fs.mkdirSync(macrosPackageRoot, { recursive: true });","+    fs.writeFileSync(","+      path.join(macrosPackageRoot, 'Package.swift'),","+      '// swift-tools-version: 6.2\\n'","+    );","     fs.mkdirSync(path.join(root, 'expo-haptics'));","     coreHeadersXCFramework = path.join(","       root,","@@ -212,6 +213,33 @@ describe('emitDirectPackage', () => {","     expect(fs.existsSync(path.join(outDir, 'direct'))).toBe(false);","   });"," ","+  it('gives its dependents the macro plugin through the expo-modules-macros package', () => {","+    emit();","+    expect(manifest()).toContain(","+      '.package(name: \"expo-modules-macros\", path: \"../../../node_modules/expo-modules-macros\")'","+    );","+    expect(manifest()).toMatch(","+      /\\.target\\(\\s*name: \"ExpoModulesCoreHeadersDependencies\",\\s*dependencies: \\[[^\\]]*\\.product\\(name: \"ExpoModulesMacrosPlugin\", package: \"expo-modules-macros\"\\)/","+    );","+  });","+","+  it('links no macro plugin into the build folder', () => {","+    process.env.BUILD_DIR = path.join(root, 'Build', 'Products');","+    emit();","+    expect(fs.existsSync(path.join(root, 'Build'))).toBe(false);","+  });","+","+  it('fails, writing no package, when expo-modules-macros is too old to be a Swift package', () => {","+    fs.rmSync(path.join(macrosPackageRoot, 'Package.swift'));","+    expect(emit).toThrow(","+      `expo-haptics is built from its own Package.swift and needs the Expo Swift macros as a Swift package, but expo-modules-macros at ${macrosPackageRoot} has no Package.swift.`","+    );","+    expect(emit).toThrow('expo-modules-macros 0.29.0 or later');","+    expect(emit).toThrow('npx expo install --fix');","+    expect(emit).toThrow(rerunSpmUpdate);","+    expect(fs.existsSync(path.join(outDir, 'direct'))).toBe(false);","+  });","+","   it('places the ExpoModulesCore headers xcframework in the package by link', () => {","     emit();","     const link = path.join(pkgDir, 'ExpoModulesCoreHeaders.xcframework');","@@ -252,7 +280,7 @@ describe('emitDirectPackage', () => {","       outDir,","       coreHeadersXCFramework,","       jsiHeadersPkgPath,","-      macroTool: path.join(root, 'ExpoModulesMacros'),","+      macrosPackageRoot,","       manifest: hapticsManifest,","     });","     const link = path.join(outDir, 'direct', '@acme', 'widgets');","@@ -271,7 +299,7 @@ describe('emitDirectPackage', () => {","      