{"id":"cd94a259fea41ed8c0461db6b75ea8d8e4744580","axis":"silent","repo":"pnpm/pnpm","sha":"cd94a259fea41ed8c0461db6b75ea8d8e4744580","parsed":{"files":[{"path":".changeset/pnpr-named-registry-cacheable.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Responses for public packages read through a named registry, such as `/npm/~npmjs/<package>`, are now cacheable by shared HTTP caches. Packages that need authentication still get `Cache-Control: private, no-store`. PyPI project pages now send `Vary: Accept`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/ecosystem.rs","lines":["@@ -67,12 +67,12 @@ pub(super) fn registry_endpoint("," }"," "," /// The cache headers a response needs so a shared HTTP cache can never replay","-/// an authenticated response to an anonymous caller. A named registry's","-/// responses are always caller-scoped. The default target's are scoped only","-/// when `package` resolves to a source whose effective per-package access","-/// denies anonymous callers, so a URL that answers differently depending on","-/// `Authorization` says so. A publicly-readable resolution stays cacheable:","-/// the path-less base is the hot install path.","+/// an authenticated response to an anonymous caller. A response is scoped","+/// when `package` resolves, through the addressed registry, to a source whose","+/// effective per-package access denies anonymous callers, so a URL that","+/// answers differently depending on `Authorization` says so. A","+/// publicly-readable resolution stays cacheable on both the path-less base","+/// (the hot install path) and a named one."," pub(super) fn caller_scoped(","     state: &AppState,","     ecosystem: Ecosystem,","@@ -80,10 +80,8 @@ pub(super) fn caller_scoped(","     package: Option<&str>,","     response: Response,"," ) -> Response {","-    if registry.is_some() {","-        return private_no_cache(response);","-    }","-    match (default_registry_target(state, ecosystem), package) {","+    let target = registry.map(str::to_string).or_else(|| default_registry_target(state, ecosystem));","+    match (target, package) {","         (Some(target), Some(package))","             if resolves_to_private_source(state, &target, ecosystem, package) =>","         {"],"additions":8,"deletions":10,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/pypi.rs","lines":["@@ -107,6 +107,7 @@ fn html_response(headers: &HeaderMap, html: String) -> Response {","     Response::builder()","         .status(StatusCode::OK)","         .header(header::CONTENT_TYPE, content_type)","+        .header(header::VARY, \"Accept\")","         .body(Body::from(html))","         .expect(\"static-shape response always builds\")"," }","@@ -115,6 +116,7 @@ fn json_page_response(json: &serde_json::Value) -> Response {","     Response::builder()","         .status(StatusCode::OK)","         .header(header::CONTENT_TYPE, JSON_CONTENT_TYPE)","+        .header(header::VARY, \"Accept\")","         .body(Body::from(serde_json::to_vec(json).expect(\"static-shape JSON serializes\")))","         .expect(\"static-shape response always builds\")"," }"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/cargo_registry/publishing.rs","lines":["@@ -102,7 +102,7 @@ async fn publish_then_resolve_and_download_a_hosted_crate() {","             .unwrap();","         assert_eq!(response.status(), StatusCode::NOT_FOUND, \"{wrong}\");","     }","-    // The same crate through the named registry, caller-scoped.","+    // The same public crate through the named registry stays cacheable.","     let response = app","         .clone()","         .oneshot(","@@ -113,7 +113,7 @@ async fn publish_then_resolve_and_download_a_hosted_crate() {","         .await","         .unwrap();","     assert_eq!(response.status(), StatusCode::OK);","-    assert_eq!(response.headers()[header::CACHE_CONTROL], \"private, no-store\");","+    assert!(!response.headers().con