 @@"," mod config_store;"," mod config_value;","+pub(crate) mod de;"," mod definition;","+mod env;","+mod error;"," mod key;","+mod reader;","+mod value;"," "," pub use config_store::ConfigStore;"," pub use config_value::ConfigValue;"," pub use definition::{Definition, DefinitionKind};","+pub use error::ConfigError;"," pub use key::ConfigKey;","+pub use value::{OptValue, Value};"," "," pub(crate) use config_value::is_nonmergeable_list;","+pub(crate) use env::Env;"," pub(crate) use key::ArrayItemKeyPath;","+pub(crate) use reader::{ConfigReader, expected};"],"additions":9,"deletions":0,"truncated":false},{"path":"src/config/reader.rs","lines":["@@ -0,0 +1,277 @@","+use std::fmt;","+use std::str::FromStr;","+use std::sync::Mutex;","+","+use anyhow::{anyhow, bail};","+use cargo_util_terminal::Shell;","+","+use super::de::Deserializer;","+use super::{ConfigError, OptValue, Value};","+use crate::config::{ConfigKey, ConfigStore, ConfigValue, Definition, Env, is_nonmergeable_list};","+use crate::util::data_structures::HashMap;","+use crate::util::errors::CargoResult;","+","+use ConfigValue as CV;","+","+/// Reads configuration values from the loaded store and the environment.","+#[derive(Clone, Copy)]","+pub(crate) struct ConfigReader<'a> {","+    pub(crate) store: &'a ConfigStore,","+    pub(crate) shell: &'a Mutex<Shell>,","+    pub(crate) env: &'a Env,","+    pub(crate) advanced_env: bool,","+}","+","+/// Helper macro for creating typed access methods.","+macro_rules! get_value_typed {","+    ($name:ident, $ty:ty, $variant:ident, $expected:expr) => {","+        /// Low-level private method for getting a config value as an [`OptValue`].","+        pub(crate) fn $name(&self, key: &ConfigKey) -> Result<OptValue<$ty>, ConfigError> {","+            let cv = self.store.get_cv(key)?;","+            let env = self.get_config_env::<$ty>(key)?;","+            match (cv, env) {","+                (Some(CV::$variant(val, definition)), Some(env)) => {","+                    if definition.is_higher_priority(&env.definition) {","+                        Ok(Some(Value { val, definition }))","+                    } else {","+                        Ok(Some(env))","+                    }","+                }","+                (Some(CV::$variant(val, definition)), None) => Ok(Some(Value { val, definition })),","+                (Some(cv), _) => Err(ConfigError::expected(key, $expected, &cv)),","+                (None, Some(env)) => Ok(Some(env)),","+                (None, None) => Ok(None),","+            }","+        }","+    };","+}","+","+impl ConfigReader<'_> {","+    pub(crate) fn get<'de, T: serde::Deserialize<'de>>(self, key: ConfigKey) -> CargoResult<T> {","+        let de = Deserializer {","+            reader: self,","+            key,","+            env_prefix_ok: true,","+        };","+        Ok(T::deserialize(de)?)","+    }","+","+    pub(super) fn warn(&self, message: String) -> CargoResult<()> {","+        self.shell.lock().unwrap().warn(message)","+    }","+","+    /// This is a helper for getting a CV from a file or env var.","+    pub(crate) fn get_cv_with_env(&self, key: &ConfigKey) -> CargoResult<Option<CV>> {","+        // Determine if value comes from env, cli, or file, and merge env if","+        // possible.","+        let cv = self.store.get_cv(key)?;","+        if key.is_root() {","+            // Root table can't have env value.","+            return Ok(cv);","+        }","+        let env = self.env.get_str(key.as_env_key());","+        let env_def = Definition::Environment(key.as_env_key().to_string());","+        let use_env = match (&cv, env) {","+            // Lists are always merged.","+            (Some(CV::List(..)), Some(_)) => true,","+            (Some(cv), Some(_)) => env_def.is_higher_priority(cv.definition()),","+            (None, Some(_)) => true,","+            _ => false,","+        };","+","+        if !use_env {","+            return Ok(cv);","+        }","+","+        // Future note: If you ever need