es":["@@ -1,6 +1,8 @@"," #pragma once"," #ifdef __cplusplus"," ","+#include <cstdio>","+#include <cstdlib>"," #include <jsi/jsi.h>"," "," // React Native 0.86 split the JSI API into the abstract `jsi::IRuntime` base","@@ -17,11 +19,32 @@"," #include <cxxreact/ReactNativeVersion.h>"," #endif"," ","-#if !defined(REACT_NATIVE_VERSION_MAJOR) || \\","-    (REACT_NATIVE_VERSION_MAJOR == 0 && REACT_NATIVE_VERSION_MINOR < 86)","+// React Native 0.86 added native `TypedArray` / `Uint8Array` predicates and accessors on","+// `jsi::IRuntime`. Hermes V1 overrides these directly; engines that keep `jsi::Runtime`'s default","+// implementations (such as legacy Hermes with `RCT_HERMES_V1_ENABLED=0` or JSC) run JS fallbacks","+// that may throw `jsi::JSIException`, so callers catch `jsi::JSIException`.","+#if defined(REACT_NATIVE_VERSION_MAJOR) && defined(REACT_NATIVE_VERSION_MINOR) && \\","+    (REACT_NATIVE_VERSION_MAJOR > 0 || REACT_NATIVE_VERSION_MINOR >= 86)","+#define EXPO_JSI_HAS_RN_086 1","+#else","+#define EXPO_JSI_HAS_RN_086 0"," namespace facebook::jsi {"," using IRuntime = Runtime;"," } // namespace facebook::jsi"," #endif"," ","+namespace expo {","+","+[[noreturn]] __attribute__((availability(swift, unavailable)))","+inline void abortUnsupportedRNVersion(const char *functionName) noexcept {","+  std::fprintf(","+    stderr,","+    \"ExpoModulesJSI: %s requires React Native 0.86+ and must be gated behind hasNativeTypedArraySupport()\\n\",","+    functionName","+  );","+  std::abort();","+}","+","+} // namespace expo","+"," #endif // __cplusplus"],"additions":25,"deletions":2,"truncated":false},{"path":"packages/expo-modules-jsi/apple/Sources/ExpoModulesJSI-Cxx/include/JSIUtils.h","lines":["@@ -478,8 +478,120 @@ class PointerValueAccess : public jsi::Runtime {","   static jsi::BigInt borrowBigInt(const jsi::Value &value) noexcept {","     return make<jsi::BigInt>(const_cast<PointerValue *>(getPointerValue(value)));","   }","+","+  /**","+   A `jsi::Object` holding the pointer of the given object value without cloning it. Must live in","+   raw storage that is never destroyed, like `borrowString`.","+   */","+  static jsi::Object borrowObject(const jsi::Value &value) noexcept {","+    return make<jsi::Object>(const_cast<PointerValue *>(getPointerValue(value)));","+  }","+","+#if EXPO_JSI_HAS_RN_086","+  static jsi::TypedArray borrowTypedArray(const jsi::Object &object) noexcept {","+    return make<jsi::TypedArray>(const_cast<PointerValue *>(getPointerValue(object)));","+  }","+#endif"," } __attribute__((availability(swift, unavailable)));"," ","+inline bool isTypedArrayValue([[maybe_unused]] jsi::IRuntime &runtime, [[maybe_unused]] const jsi::Value &value) noexcept {","+#if EXPO_JSI_HAS_RN_086","+  if (!value.isObject()) {","+    return false;","+  }","+  alignas(jsi::Object) unsigned char storage[sizeof(jsi::Object)];","+  const jsi::Object *object = new (storage) jsi::Object(PointerValueAccess::borrowObject(value));","+  try {","+    return runtime.isTypedArray(*object);","+  } catch (const jsi::JSIException &) {","+    return false;","+  }","+#else","+  abortUnsupportedRNVersion(__func__);","+#endif","+}","+","+/**","+ * Reads `byteLength`, `byteOffset`, and `length` from a TypedArray object using JSI's RN 0.86+","+ * `IRuntime` TypedArray accessors. Only call when `hasNativeTypedArraySupport()` is `true` and","+ * `jsObj` has been verified as a TypedArray.","+ */","+inline TypedArrayProperties getNativeTypedArrayProperties(","+  [[maybe_unused]] jsi::IRuntime &runtime,","+  [[maybe_unused]] const jsi::Object &jsObj","+) {","+#if EXPO_JSI_HAS_RN_086","+  alignas(jsi::TypedArray) unsigned char storage[sizeof(jsi::TypedArray)];","+  const jsi::TypedArray *ta = new (storage) jsi::TypedArray(PointerValueAccess::borrowTypedArray(jsObj));","+  return {","+    runtime.byteLength(*ta),","+    runtime.byteOffset(*ta),","+    runtime.length(*ta),","+  };","+#else","+  abortUnsupportedRNVersion(__func__);","+#endif","+}","+","+/**","+ * Re