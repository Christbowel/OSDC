t_id()","     };","     if actual_source_table_id != expected_source_table_id {","         return Err(ErrorCode::InvalidMaterializedView(format!(","@@ -90,6 +97,24 @@ pub fn validate_materialized_view_source(","     Ok(())"," }"," ","+/// Reject creating, reading, or refreshing an MV whose source has a row access or masking policy.","+///","+/// REFRESH computes MV storage under the refreshing role, so the stored rows and values do not","+/// follow the policies of later readers. CREATE and policy DDL keep policies and MVs on the same","+/// source exclusive; reads and refreshes repeat the check to cover combinations created","+/// concurrently or by older versions.","+pub fn check_materialized_view_source_without_policy(","+    source_meta: &TableMeta,","+    materialized_view_name: &str,","+) -> Result<()> {","+    if source_meta.has_security_policy() {","+        return Err(ErrorCode::InvalidMaterializedView(format!(","+            \"materialized view {materialized_view_name} is not allowed because its source table has a row access or masking policy\"","+        )));","+    }","+    Ok(())","+}","+"," /// Rewrites a user MV definition into its physical storage query and records"," /// physical names and logical definition expressions in their schema order."," #[derive(Debug, Clone, Default)]"],"additions":27,"deletions":2,"truncated":false},{"path":"src/query/sql/src/planner/semantic/mod.rs","lines":["@@ -34,6 +34,7 @@ pub use grouping_check::GroupingChecker;"," pub use lowering::*;"," pub use materialized_view_rewriter::MaterializedViewChecker;"," pub use materialized_view_rewriter::MaterializedViewRewriter;","+pub use materialized_view_rewriter::check_materialized_view_source_without_policy;"," pub use materialized_view_rewriter::parse_materialized_view_query;"," pub use materialized_view_rewriter::validate_materialized_view_source;"," pub use name_resolution::IdentifierNormalizer;"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/sqllogictests/suites/ee/07_ee_materialized_view/07_0009_materialized_view_security_policy.test","lines":["@@ -0,0 +1,100 @@","+## Copyright 2023 Databend Cloud","+##","+## Licensed under the Elastic License, Version 2.0 (the \"License\");","+## you may not use this file except in compliance with the License.","+## You may obtain a copy of the License at","+##","+##     https://www.elastic.co/licensing/elastic-license","+##","+## Unless required by applicable law or agreed to in writing, software","+## distributed under the License is distributed on an \"AS IS\" BASIS,","+## WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+## See the License for the specific language governing permissions and","+## limitations under the License.","+","+# MV storage does not follow source row access or masking policies, so a table cannot be both a","+# policy target and an MV source, in either DDL order.","+","+statement ok","+set enable_experimental_row_access_policy = 1","+","+statement ok","+create or replace database test_mv_security_policy","+","+statement ok","+use test_mv_security_policy","+","+statement ok","+drop masking policy if exists mv_security_mask","+","+statement ok","+create masking policy mv_security_mask as (v string) returns string -> '***'","+","+statement ok","+drop row access policy if exists mv_security_rap","+","+statement ok","+create row access policy mv_security_rap as (r string) returns boolean -> r = 'us'","+","+statement ok","+create table source (id int, email string, region string)","+","+# A source policy blocks CREATE, even on columns the MV does not reference.","+statement ok","+alter table source modify column email set masking policy mv_security_mask","+","+statement error 2328.*source table has a row access or masking policy","+create materialized view mv as select id, region from source where id > 0","+","+statement ok","+alter table source modify column email unset masking policy","+","+statement ok","+alter table source add row access policy mv_security_rap on (region)","+","+statement error 2328.*source table has a row access or masking policy","+create materialized view mv as select id from source where id > 0","+","+statement ok","+alter table source drop row access policy mv_security_rap","+","+# An MV blocks attaching either policy, also after it becomes invalid.","+statement ok","+create materialized view mv as select id, region from source where id > 0","+","+statement error 1132.*materialized views depend on it","+alter table source modify column email set masking policy mv_security_mask","+","+statement error 1132.*materialized views depend on it","+alter table source add row access policy mv_security_rap on (region)","+","+statement ok","+alter table source rename column region to area","+","+statement error 1132.*materialized views depend on it","+alter table source modify column email set masking policy mv_security_mask","+","+statement ok","+show create materialized view mv","+","+statement ok","+drop materialized view mv","+","+# Without MVs the policy can be attached again.","+statement ok","+alter table source modify column email set masking policy mv_security_mask","+","+statement ok","+alter table source modify column email unset masking policy","+","+statement ok","+drop table source","+","+statement ok","+drop masking policy mv_security_mask","+","+statement ok","+drop row access policy mv_security_rap","+","+statement ok","+drop database test_mv_security_policy",""],"additions":100,"deletions":0,"truncated":false}],"additions":179,"deletions":22,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-10T17:07:57.042321+00:00"}