d,","                                        boost::optional<Status> abortReason = boost::none);"," "," /**","- * Assembles the namespace string for the temporary resharding collection based on the source","- * namespace components.","+ * Assembles the namespace string for the temporary resharding collection, including the","+ * source collection name so the namespace is identifiable:","+ *      <db>.system.resharding.<source name>.<source collection's UUID>","  *","- *      <db>.system.resharding.<existing collection's UUID>","- * or   <db>.system.buckets.resharding.<existing collection's UUID> for a timeseries source ns.","+ * This must only be called when creating the coordinator document, and only when","+ * gFeatureFlagReshardingTempNssContainsSourceName is enabled for the operation's pinned version.","+ * All other callers must use the value persisted in that document instead of computing the name.","+ *","+ * The source collection's UUID is the identity of the namespace. The source collection name in it","+ * can be truncated, so do not use the namespace to identify the source collection.","  */"," [[MONGO_MOD_NEEDS_REPLACEMENT]] NamespaceString constructTemporaryReshardingNss(","     const NamespaceString& nss, const UUID& sourceUuid);"," ","+/**","+ * The resharding temporary namespace without the source collection name:","+ *      <db>.system.resharding.<source collection's UUID>","+ * or   <db>.system.buckets.resharding.<source collection's UUID> for a timeseries collection.","+ */","+[[MONGO_MOD_NEEDS_REPLACEMENT]] NamespaceString constructLegacyTemporaryReshardingNss(","+    const NamespaceString& nss, const UUID& sourceUuid);","+"," /**","  * Asserts that there is not a hole or overlap in the chunks.","  */"],"additions":17,"deletions":4,"truncated":false},{"path":"src/mongo/db/s/resharding/resharding_util_test.cpp","lines":["@@ -177,6 +177,68 @@ TEST(SimpleReshardingUtilTest,","     ASSERT_EQ(Timestamp(10, 3), highestMinFetchTimestamp);"," }"," ","+// Temporary resharding namespace construction tests.","+","+TEST(SimpleReshardingUtilTest, ConstructLegacyTemporaryReshardingNssExcludesSourceName) {","+    const auto sourceNss = NamespaceString::createNamespaceString_forTest(\"test.orders\");","+    const auto sourceUuid = UUID::gen();","+","+    const auto tempNss = resharding::constructLegacyTemporaryReshardingNss(sourceNss, sourceUuid);","+","+    ASSERT_EQ(tempNss,","+              NamespaceString::createNamespaceString_forTest(","+                  \"test\", \"system.resharding.\" + sourceUuid.toString()));","+    ASSERT_EQ(tempNss.coll().find(\"orders\"), std::string::npos);","+}","+","+TEST(SimpleReshardingUtilTest, ConstructTemporaryReshardingNssIncludesSourceName) {","+    const auto sourceNss = NamespaceString::createNamespaceString_forTest(\"test.foo\");","+    const auto sourceUuid = UUID::gen();","+","+    const auto tempNss = resharding::constructTemporaryReshardingNss(sourceNss, sourceUuid);","+","+    ASSERT_EQ(tempNss,","+              NamespaceString::createNamespaceString_forTest(","+                  \"test\", \"system.resharding.foo.\" + sourceUuid.toString()));","+    ASSERT_TRUE(tempNss.isTemporaryReshardingCollection());","+}","+","+TEST(SimpleReshardingUtilTest, ConstructTemporaryReshardingNssTruncatesLongSourceName) {","+    const auto sourceNss = NamespaceString::createNamespaceString_forTest(","+        \"test\", \"orders_2024_q1\" + std::string(200, 'x'));","+    const auto sourceUuid = UUID::gen();","+","+    const auto tempNss = resharding::constructTemporaryReshardingNss(sourceNss, sourceUuid);","+","+    // The name keeps its leading characters, and the truncated namespace fills the remaining limit","+    // exactly.","+    ASSERT_EQ(tempNss.size(), NamespaceString::MaxUserNsShardedCollectionLen);","+    ASSERT_TRUE(tempNss.coll().starts_with(\"system.resharding.orders_2024_q1\"));","+    ASSERT_TRUE(tempNss.coll().ends_with(\".\" + sourceUuid.toString()));","+}","+","+TEST(SimpleReshardingUtilTest, ConstructTemporaryReshardingNssTruncatesMultibyteSourceName) {","+    // \"é\" is two bytes in UTF-8, and the 175 byte name budget is not a multiple of that, so the","+    // name has to be cut on a character boundary rather than at the budget.","+    const auto repeated = [](const char* str, int count) {","+        std::string result;","+        for (int i = 0; i < count; ++i) {","+            result += str;","+        }","+        return result;","+    };","+","+    const auto sourceNss =","+        NamespaceString::createNamespaceString_forTest(\"test\", repeated(\"\\xc3\\xa9\", 100));","+    const auto sourceUuid = UUID::gen();","+","+    const auto tempNss = resharding::constructTemporaryReshardingNss(sourceNss, sourceUuid);","+","+    ASSERT_EQ(tempNss.coll(),","+              \"system.resharding.\" + repeated(\"\\xc3\\xa9\", 87) + \".\" + sourceUuid.toString());","+    ASSERT_LE(tempNss.size(), NamespaceString::MaxUserNsShardedCollectionLen);","+}","+"," // Validate resharded chunks tests."," "," TEST_F(ReshardingUtilTest, SuccessfulValidateReshardedChunkCase) {","@@ -1063,6 +1125,50 @@ TEST_F(ReshardingUtilTest, CalculateExponentialMovingAverageBasic) {","     ASSERT_EQ(avg3, (1 - smoothFactor) * avg2 + smoothFactor * val3);"," }"," ","+TEST_F(ReshardingUtilTest, CoordinatorDocTempNssIncludesSourceNameWhenFlagEnabledAtPinnedVersion) {","+    // (Generic FCV reference): used for testing.","+    VersionContext::ScopedSetDecoration scopedVersionContext(","+        operationContext(), VersionContext{multiversion::GenericFCV::kLatest});","+","+    const CollectionType collEntry(nss(),","+                                   OID::gen(),","+                                   Timestamp(static_cast<unsigned int>(std::time(nullptr)), 1),","+                                   Date_t::now(),","+                                   UUID::gen(),","+                                   keyPattern());","+    ConfigsvrReshardCollection request(nss(), BSON(shardKey() << 1));","+    request.setDbName(nss().dbName());","+","+    auto doc = createReshardingCoordinatorDoc(","+        operationContext(), request, collEntry, primaryShardId(), nss(), true);","+","+    ASSERT_EQ(doc.getTempReshardingNss(),","+              constructTemporaryReshardingNss(nss(), collEntry.getUuid()));","+}","+","+TEST_F(ReshardingUtilTest, CoordinatorDocTempNssExcludesSourceNameWhenFlagDisabledAtPinnedVersion) {","+    // featureFlagReshardingTempNssContainsSourceName is enabled from FCV 9.1, so an operation","+    // pinned to 9.0 uses the legacy name.","+    VersionContext::ScopedSetDecoration scopedVersionContext(","+        operationContext(),","+        VersionContext{multiversion::FeatureCompatibilityVersion::kVersion_9_0});","+","+    const CollectionType collEntry(nss(),","+                                   OID::gen(),","+                                   Timestamp(static_cast<unsigned int>(std::time(nullptr)), 1),","+                                   Date_t::now(),","+                                   UUID::gen(),","+                                   keyPattern());","+    ConfigsvrReshardCollection request(nss(), BSON(shardKey() << 1));","+    request.setDbName(nss().dbName());","+","+    auto doc = createReshardingCoordinatorDoc(","+        operationContext(), request, collEntry, primaryShardId(), nss(), true);","+","+    ASSERT_EQ(doc.getTempReshardingNss(),","+              constructLegacyTemporaryReshardingNss(nss(), collEntry.getUuid()));","+}","+"," class ReshardingTxnCloningPipelineTest : public AggregationContextFixture {"," "," protected:"],"additions":106,"deletions":0,"truncated":false},{"path":"src/mongo/s/resharding/resharding_feature_flag.idl","lines":["@@ -150,3 +150,10 @@ feature_flags:","         cpp_varname: gFeatureFlagReshardingPrePostConditionsValidations","         default: false","         fcv_gated: true","+    featureFlagReshardingTempNssContainsSourceName:","+        mod_visibility: public","+        descriptio