8SafeTruncation(","+            nss.coll(), NamespaceString::MaxUserNsShardedCollectionLen - fixedLen);","+        collName = fmt::format(\"{}{}.{}\", tempCollPrefix, sourceName, sourceUuidString);","+    }","+","+    return NamespaceStringUtil::deserialize(","+        boost::none, nss.db_forSharding(), collName, SerializationContext::stateDefault());","+}","+","+NamespaceString constructLegacyTemporaryReshardingNss(const NamespaceString& nss,","+                                                      const UUID& sourceUuid) {","     auto tempCollPrefix = nss.isTimeseriesBucketsCollection()","         ? NamespaceString::kTemporaryTimeseriesReshardingCollectionPrefix","         : NamespaceString::kTemporaryReshardingCollectionPrefix;","@@ -704,7 +728,22 @@ ReshardingCoordinatorDocument createReshardingCoordinatorDoc(","         }","     }"," ","-    auto tempReshardingNss = resharding::constructTemporaryReshardingNss(nss, collEntry.getUuid());","+    // Snapshot the FCV at operation start so that feature flags are evaluated consistently for the","+    // entire operation lifetime, even across FCV transitions. If the opCtx already carries an OFCV,","+    // capture that; otherwise fall back to the global snapshot.","+    const auto fcv = serverGlobalParams.featureCompatibility.acquireFCVSnapshot();","+","+    ForwardableOperationMetadata fom(opCtx);","+    if (!fom.getVersionContext() &&","+        feature_flags::gSnapshotFCVInDDLCoordinators.isEnabled(kVersionContextIgnored_UNSAFE,","+                                                               fcv)) {","+        fom.setVersionContext(VersionContext{fcv});","+    }","+","+    auto tempReshardingNss = resharding::isEnabledWithPinnedVersion(","+                                 fom, resharding::gFeatureFlagReshardingTempNssContainsSourceName)","+        ? resharding::constructTemporaryReshardingNss(nss, collEntry.getUuid())","+        : resharding::constructLegacyTemporaryReshardingNss(nss, collEntry.getUuid());"," "," 