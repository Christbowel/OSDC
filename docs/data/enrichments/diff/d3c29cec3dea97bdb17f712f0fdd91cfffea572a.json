ional `ItemDescription` components. Wrap existing text children in `ItemLabel` ([#83493](https://github.com/WordPress/gutenberg/pull/83493))."," -   `Notice`: Remove built-in screen reader announcements and the `spokenMessage` and `politeness` props. Consumers now announce dynamic updates explicitly, for example with `speak()` from `@wordpress/a11y` ([#82737](https://github.com/WordPress/gutenberg/pull/82737))."," ","@@ -28,6 +29,10 @@"," "," -   Document component status in `CONTRIBUTING.md` ([#83536](https://github.com/WordPress/gutenberg/pull/83536))."," ","+### Documentation","+","+-   `Menu`: Explain when to disable triggers and items ([#83791](https://github.com/WordPress/gutenberg/pull/83791)).","+"," ## 0.23.0 (2026-09-23)"," "," ### Breaking Changes"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/ui/src/menu/root.tsx","lines":["@@ -68,7 +68,6 @@ function Root( props: RootProps ) {"," \t>( {"," \t\tactionsRef: props.actionsRef,"," \t\tdefaultOpen: props.defaultOpen,","-\t\tdisabled: props.disabled,"," \t\tmodal: props.modal,"," \t\tonOpenChange: handleOpenChange,"," \t\topen: props.open,"],"additions":0,"deletions":1,"truncated":false},{"path":"packages/ui/src/menu/stories/usage-guidelines.mdx","lines":["@@ -71,6 +71,33 @@ Use `Menu.Group` for related commands, links, or checkbox items. `Menu.Group` an"," "," Do not use checked menu items only to recreate a Select. If choosing a value is the whole purpose of the control, use `SelectControl`, even when the options could look like radio menu items."," ","+## Disable the trigger or individual items","+","+Set `disabled` on `Menu.Trigger` when the menu cannot be opened, such as when no actions are available. Set `disabled` on individual items when their actions are unavailable. Disabling the trigger does not disable items in an already open menu.","+","+Disabling only the trigger lets users dismiss a menu that was open when the trigger became disabled. For submenus, set `disabled` on `Menu.SubmenuTrigger`. Neither `Menu.Root` nor `Menu.SubmenuRoot` supports `disabled`.","+","+When rendering an `@wordpress/components` `Button`, keep `accessibleWhenDisabled` on the button if it should remain focusable. Put `disabled` on `Menu.Trigger`, which passes it to the rendered button and prevents the menu from opening with the keyboard or pointer.","+","+```tsx","+import { Button } from '@wordpress/components';","+import { Menu } from '@wordpress/ui';","+","+<Menu.Root>","+\t<Menu.Trigger","+\t\tdisabled={ isUnavailable }","+\t\trender={ <Button accessibleWhenDisabled /> }","+\t>","+\t\tActions","+\t</Menu.Trigger>","+\t<Menu.Popup>","+\t\t<Menu.Item disabled={ isUnavailable } onClick={ duplicate }>","+\t\t\t<Menu.ItemLabel>Duplicate</Menu.ItemLabel>","+\t\t</Menu.Item>","+\t</Menu.Popup>","+</Menu.Root>;","+```","+"," ## Add prefix icons"," "," Use `Menu.PrefixIcon` in an item's `prefix` prop for an SVG icon. It defaults to 24px and centers on a single label line at the top of the item's content row. Prefer the default size for consistent menu icons."],"additions":27,"deletions":0,"truncated":false},{"path":"packages/ui/src/menu/test/index.jsdom.test.tsx","lines":["@@ -124,6 +124,16 @@ describe( 'Menu', () => {"," \t\texpect( trigger.tagName ).toBe( 'DIV' );"," \t} );"," ","+\tit( 'does not expose disabled on menu roots', () => {","+\t\t// @ts-expect-error Disable Menu.Trigger or individual items instead.","+\t\tconst root = <Menu.Root disabled />;","+\t\t// @ts-expect-error Disable Menu.SubmenuTrigger or individual items instead.","+\t\tconst submenuRoot = <Menu.SubmenuRoot disabled />;","+","+\t\texpect( root ).toBeDefined();","+\t\texpect( submenuRoot ).toBeDefined();","+\t} );","+"," \tit( 'does not expose detached trigger props', () => {"," \t\tconst triggerWithHandle = ("," \t\t\t// @ts-expect-error Menu does not expose Base UI's handle utility.","@@ -205,21 +215,20 @@ describe( 'Menu', () => {"," \t\t}"," \t} );"," ","-\tit( 'does not close a disabled non-mo