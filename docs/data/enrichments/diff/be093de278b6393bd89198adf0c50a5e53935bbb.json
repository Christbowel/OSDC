onents/pages/organizations/$orgId/domains/$domainId',","+)","+","+// Render the dialog in place so the test does not depend on a portal.","+const dialogPath = join(consoleRoot, 'src/components/ui/dialog.tsx')","+const realDialog = { ...(await import(dialogPath)) }","+const part = ({ children }: { children?: ReactNode }) =>","+  createElement('div', null, children)","+mock.module(dialogPath, () => ({","+  ...realDialog,","+  Dialog: ({ open, children }: { open?: boolean; children?: ReactNode }) =>","+    open ? createElement('div', null, children) : null,","+  DialogContent: part,","+  DialogHeader: part,","+  DialogTitle: part,","+  DialogDescription: part,","+}))","+","+afterEach(() => cleanup())","+","+afterAll(async () => {","+  mock.module(dialogPath, () => realDialog)","+  mock.restore()","+  await GlobalRegistrator.unregister()","+})","+","+for (const file of ['ImportZone.tsx', 'ImportZoneDialog.tsx']) {","+  describe(file, () => {","+    test('says the limit is 5MB when the file is too large', async () => {","+      const { ImportZoneDialog } = await import(join(domainDir, file))","+      const view = render(","+        createElement(ImportZoneDialog, {","+          open: true,","+          onOpenChange: () => {},","+          onImport: () => {},","+        }),","+      )","+      const input = view.container.querySelector(","+        'input[type=\"file\"]',","+      ) as HTMLInputElement","+      const zone = new File(['a'], 'zone.txt', { type: 'text/plain' })","+      Object.defineProperty(zone, 'size', { value: 6 * 1024 * 1024 })","+","+      fireEvent.change(input, { target: { files: [zone] } })","+","+      expect(view.getByText('File size must be less than 5MB')).toBeTruthy()","+    })","+  })","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"apps/console/tests/unit/resource-domains-query.test.ts","lines":["@@ -0,0 +1,64 @@","+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test'","+import { sdk } from '@/lib/appwrite/sdk'","+import { fetchFunctionDomains } from '@/lib/react-query/hooks/functions'","+import { fetchSiteDomains } from '@/lib/react-query/hooks/sites'","+import { proxyRulesFilterColumns } from '@/lib/table-filters'","+","+describe('function and site domains list', () => {","+  const requests: Record<string, unknown>[] = []","+  let forProject: ReturnType<typeof spyOn>","+","+  beforeEach(() => {","+    requests.length = 0","+    forProject = spyOn(sdk, 'forProject').mockReturnValue({","+      proxy: {","+        listRules: async (params: Record<string, unknown>) => {","+          requests.push(params)","+          return { rules: [], total: 0 }","+        },","+      },","+    } as unknown as ReturnType<typeof sdk.forProject>)","+  })","+","+  afterEach(() => {","+    forProject.mockRestore()","+  })","+","+  const fetchers = [","+    ['function', fetchFunctionDomains],","+    ['site', fetchSiteDomains],","+  ] as const","+","+  for (const [resource, fetchDomains] of fetchers) {","+    test(`${resource} search goes in the queries`, async () => {","+      await fetchDomains('project', 'resource', 0, 10, '  Shop.Example ')","+","+      expect(requests).toHaveLength(1)","+      expect(requests[0].search).toBeUndefined()","+      const queries = (requests[0].queries as string[]).map((query) =>","+        JSON.parse(query),","+      )","+      const search = queries.find((query) => query.method === 'or')","+      expect(search.values).toEqual([","+        { method: 'contains', attribute: 'domain', values: ['shop.example'] },","+        { method: 'startsWith', attribute: '$id', values: ['Shop.Example'] },","+      ])","+    })","+","+    test(`${resource} without search sends no search query`, async () => {","+      await fetchDomains('project', 'resource', 0, 10, '  ')","+","+      const queries = (requests[0].queries as string[]).map((query) =>","+        JSON.parse(query),","+      )","+      expect(queries.some((query) => query.method === 'or')).toBe(false)","+    })","+  }","+})","+","+describe('proxy rules filter columns', () => {","+  test('offer no status filter the list endpoint rejects', () => {","+    const ids = proxyRulesFilterColumns.map((column) => column.id)","+    expect(ids).not.toContain('status')","+  })","+})",""],"additions":64,"deletions":0,"truncated":false}],"additions":260,"deletions":43,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-09T17:51:22.427473+00:00"}