ils();"],"additions":1,"deletions":0,"truncated":false},{"path":"components/camel-oauth/src/main/java/org/apache/camel/oauth/OAuthSessionStore.java","lines":["@@ -25,4 +25,20 @@ public interface OAuthSessionStore {","     Optional<OAuthSession> getSession(Exchange exchange);"," ","     OAuthSession createSession(Exchange exchange);","+","+    /**","+     * Rotates the session, replacing the current session identifier with a newly generated one and transferring any","+     * session state.","+     *","+     * @implNote          The default implementation is a no-op that returns the existing session unchanged.","+     *                    Implementors MUST override this method to prevent session fixation — failing to do so leaves","+     *                    the session identifier unchanged across privilege escalation (login).","+     *","+     * @param    exchange the current exchange","+     * @param    session  the existing session to rotate","+     * @return            the rotated session with a new session identifier","+     */","+    default OAuthSession rotateSession(Exchange exchange, OAuthSession session) {","+        return session;","+    }"," }"],"additions":16,"deletions":0,"truncated":false},{"path":"components/camel-oauth/src/test/java/org/apache/camel/oauth/AbstractOAuthRequestHeadersTest.java","lines":["@@ -213,6 +213,10 @@ private String loginAsBob() throws Exception {","         var callback = get(\"/auth?code=\" + StubOAuth.BOB_CODE + \"&state=\" + URLEncoder.encode(state, StandardCharsets.UTF_8),","                 cookie, null);","         assertEquals(302, callback.statusCode());","+        var postLoginCookie = setCookie(callback);","+        if (postLoginCookie != null) {","+            cookie = postLoginCookie.substring(0, postLoginCookie.indexOf(';'));","+        }","         return cookie;","     }"," "],"additions":4,"deletions":0,"truncated":false},{"path":"components/camel-oauth/src/test/java/org/apache/camel/oauth/OAuthCodeFlowSessionRotationTest.java","lines":["@@ -0,0 +1,150 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *      http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.apache.camel.oauth;","+","+import org.apache.camel.Exchange;","+import org.apache.camel.impl.DefaultCamelContext;","+import org.apache.camel.support.DefaultExchange;","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+","+import static org.apache.camel.oauth.OAuth.CAMEL_OAUTH_COOKIE;","+import static org.apache.camel.oauth.OAuth.CAMEL_OAUTH_REDIRECT_URI;","+import static org.apache.camel.oauth.OAuth.CAMEL_OAUTH_SESSION_ID;","+import static org.apache.camel.oauth.OAuthSession.OAUTH_STATE;","+import static org.assertj.core.api.Assertions.assertThat;","+","+class OAuthCodeFlowSessionRotationTest {","+","+    private static final String REDIRECT_URI = \"https://app.example.test/auth\";","+    private static final String POST_LOGIN_URL = \"https://app.example.test/dashboard\";","+","+    private DefaultCamelContext context;","+    private StubOAuth oauth;","+","+    @BeforeEach","+    void setUp() {","+        context = new DefaultCamelContext();","+        context.getPropertiesComponent().addInitialProperty(CAMEL_OAUTH_REDIRECT_URI, REDIRECT_URI);","+        oauth = new StubOAuth();","+        context.getRegistry().bind(OAuth.class.getName(), oauth);","+    }","+","+    @AfterEach","+    void tearDown() throws Exception {","+        context.close();","+    }","+","+    @Test","+    void inMemorySessionStoreRotateSessionReplacesIdAndTransfersValues() {","+        Exchange exchange = new DefaultExchange(context);","+        OAuthSession initialSession = oauth.createSession(exchange);","+        String oldSessionId = initialSession.getSessionId();","+","+        initialSession.putValue(\"customKey\", \"customValue\");","+        initialSession.putValue(\"anotherKey\", 12345);","+","+        OAuthSession rotatedSession = oauth.rotateSession(exchange, initialSession);","+        String newSessionId = rotatedSession.getSessionId();","+","+        assertThat(newSessionId).isNotEqualTo(oldSessionId);","+        assertThat(rotatedSession.getValue(\"customKey\", String.class)).contains(\"customValue\");","+        assertThat(rotatedSession.getValue(\"anotherKey\", Integer.class)).contains(12345);","+","+        // Verify the old session is no longer accessible in the store","+        Exchange oldLookupExchange = new DefaultExchange(context);","+        oldLookupExchange.getMessage().setHeader(CAMEL_OAUTH_SESSION_ID, oldSessionId);","+        assertThat(oauth.getSession(oldLookupExchange)).isEmpty();","+","+        // Verify the new session is retrievable","+        Exchange newLookupExchange = new DefaultExchange(context);","+        newLookupExchange.getMessage().setHeader(CAMEL_OAUTH_SESSION_ID, newSessionId);","+        assertThat(oauth.getSession(newLookupExchange)).containsSame(rotatedSession);","+","+        // Verify the exchange response cookie and header were updated","+        String setCookieHeader = exchange.getMessage().getHeader(\"Set-Cookie\", String.class);","+        assertThat(setCookieHeader)","+                .isNotNull()","+                .contains(CAMEL_OAUTH_COOKIE + \"=\" + newSessionId)","+                .doesNotContain(oldSessionId);","+        assertThat(exchange.getMessage().getHeader(CAMEL_OAUTH_SESSION_ID)).isEqualTo(newSessionId);","+    }","+","+    @Test","+    void callbackRotatesSessionUponSuccessfulAuthentication() throws Exception {","+        // Step 1: Pre-login initial request creates a pre-login session","+        Exchange preLoginExchange = new DefaultExchange(context);","+        OAuthSession preLoginSession = oauth.createSession(preLoginExchange);","+        String preLoginSessionId = preLoginSession.getSessionId();","+","+        String issuedState = \"secure-random-state-1234\";","+        preLoginSession.putValue(OAUTH_STATE, issuedState);","+        preLoginSession.putValue(\"OAuthPostLoginUrl\", POST_LOGIN_URL);","+","+        // Step 2: Callback completes with valid authorization code and state","+        Exchange callbackExchange = new DefaultExchange(context);","+        callbackExchange.getMessage().setHeader(\"Cookie\", CAMEL_OAUTH_COOKIE + \"=\" + preLoginSessionId);","+        callbackExchange.getMessage().setHeader(\"code\", StubOAuth.BOB_CODE);","+        callbackExchange.getMessage().setHeader(\"state\", issuedState);","+","+        new OAuthCodeFlowCallback().process(callbackExchange);","+","+        // Verify redirect to post-login URL","+        assertThat(callbackExchange.getMessage().getHeader(Exchange.HTTP_RESPONSE_CODE)).isEqualTo(302);","+        assertThat(callbackExchange.getMessage().getHeader(\"Location\")).isEqualTo(POST_LOGIN_URL);","+","+        // Verify new session cookie is emitted with rotated session ID","+        String setCookieHeader = callbackExchange.getMessage().getHeader(\"Set-Cookie\", String.class);","+        assertThat(setCookieHeader).isNotNull();","+        assertThat(setCookieHeader).doesNotContain(preLoginSessionId);","+","+        String prefix = CAMEL_OAUTH_COOKIE + \"=\";","+        int start = setCookieHeader.indexOf(prefix) + prefix.length();","+        int end = setCookieHeader.indexOf(';', start);","+        String postLoginSessionId = end > 0 ? setCookieHeader.substring(start, end) : setCookieHeader.substring(start);","+","+        assertThat(postLoginSessionId).isNotEmpty();","+        assertThat(postLoginSessionId).isNotEqualTo(preLoginSessionId);","+","+        // Step 3: Verify the pre-login session ID cannot be reused to access protected routes","+        Exchange replayExchange = new DefaultExchange(context);","+        replayExchange.getMessage().setHeader(\"Cookie\", CAMEL_OAUTH_COOKIE + \"=\" + preLoginSessionId);","+        new OAuthCodeFlowProcessor().process(replayExchange);","+","+        // The pre-login ID should not be authenticated, so OAuthCodeFlowProcessor redirects to IdP auth request","+        assertThat(replayExchange.getMessage().getHeader(Exchange.HTTP_RESPONSE_CODE)).isEqualTo(302);","+        assertThat(replayExchange.getMessage().getHeader(\"Location\", String.class)).contains(\"https://idp.example/auth?state=\");","+        assertThat(replayExchange.isRouteStop()).isTrue();","+","+        // Step 4: Verify the rotated post-login session ID successfully authenticates the user","+        Exchange authExchange = new DefaultExchange(context);","+        authExchange.getMessage().setHeader(\"Cookie\", CAMEL_OAUTH_COOKIE + \"=\" + postLoginSessionId);","+        new OAuthCodeFlowProcessor().process(authExchange);","+","+        // The authenticated request should NOT be redirected and route should not be stopped","+        assertThat(authExchange.getMessage().getHeader(Exchange.HTTP_RESPONSE_CODE)).isNull();","+        assertThat(authExchange.isRouteStop()).isFalse();","+","+        // Stored session has bob's profile","+        Exchange verifyExchange = new DefaultExchange(context);","+        verifyExchange.getMessage().setHeader(CAMEL_OAUTH_SESSION_ID, postLoginSessionId);","+        OAuthSession storedSession = oauth.getSession(verifyExchange).orElseThrow();","+        assertThat(storedSession.getUserProfile()).isPresent();","+        assertThat(storedSession.getUserProfile().get().subject()).isEqualTo(\"bob\");","+    }","+}"],"additions":150,"deletions":0,"truncated":false},{"path":"docs/user-manual/modules/ROOT/pages/camel-4x-upgrade-guide-4_24.adoc","lines":["@@ -1627,6 +1627,11 @@ with `OAuthHelper.validateOAuthToken` from camel-support instead."," For any other message, such as one from camel-undertow, the processors keep reading the message headers, but leave out"," a value that also appears in the query string of the request."," ","+`InMemorySessionStore` no longer logs session identifiers. Additionally, `OAuthCodeFlowCallback` rotates the session","+identifier upon successful authentication, replacing the pre-login session identifier with a new session identifier","+and emitting an updated session cookie. Custom `OAuthSessionStore` implementations can override the default","+`rotateSession` method to support session rotation on login.","+"," === camel-platform-http-vertx - the charset parameter of the request Content-Type in any case"," "," The consumer now reads the charset parameter of the request `Content-Type` whatever the case of its name, as",""],"additions":5,"deletions":0,"truncated":false}],"additions":231,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-28T14:43:02.893141+00:00"}