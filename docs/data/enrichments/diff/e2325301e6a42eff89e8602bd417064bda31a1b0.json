{"id":"e2325301e6a42eff89e8602bd417064bda31a1b0","axis":"silent","repo":"uber/deck.gl","sha":"e2325301e6a42eff89e8602bd417064bda31a1b0","parsed":{"files":[{"path":"docs/api-reference/core/deck.md","lines":["@@ -203,6 +203,14 @@ Notes:"," - GPU `parameters` supplied to a view override the global `parameters` for layers rendered in that view."," - GPU `parameters` supplied to individual layers override both view and global `parameters` when that layer is rendered."," ","+#### `sqlParser` (object, optional) {#sqlparser}","+","+Parses SQL in [layer queries](./layer.md#query) and Arrow accessor expressions.","+The parser can implement `parseQuery` for table queries and `parseExpression`","+for accessor expressions. Import `sqlParser` from `@deck.gl/core/sql` to use the","+math.gl parser.","+","+"," #### `layers` (LayersList) {#layers}"," "," * Default: `[]`"],"additions":8,"deletions":0,"truncated":false},{"path":"docs/api-reference/core/layer.md","lines":["@@ -337,6 +337,41 @@ applies to row chunks; transform Arrow chunks in the producer instead. See"," [Streaming Arrow data](../../developer-guide/using-with-arrow.md#streaming-arrow-data)."," "," ","+#### `query` (string, optional) {#query}","+","+SQL to execute through loaders.gl when `data` is an Arrow table, a promise resolving","+to an Arrow table, or a URL. The result becomes the layer's loaded data and is","+available to accessor queries, accessors, and picking. The layer's data is the","+implicit source. `FROM data` is optional.","+","+For URL inputs, provide a source-capable loader. Loaders that support query pushdown","+can optimize loading based on the supplied query. When the layer has a custom","+`fetch`, SQL runs on the Arrow table returned by that function. Set Deck's","+`sqlParser` prop to a parser that implements `parseQuery`.","+","+#### SQL accessor inputs","+","+Accessors that accept Arrow columns also accept `{sql: string}`. The expression","+evaluates against the loaded Arrow table after `query` and `dataTransform`. It returns","+one value per row, in source order. Use `query` for filtering or other operations","+that change the rows. Supply Deck with a `sqlParser` that implements","+`parseExpression`.","+","+An Arrow-enabled position accessor can reference columns by name. If the","+loaded `data` table has separate `longitude` and `latitude` columns, this packs","+them into a two-component 64-bit position for each row.","+","+```ts","+getPosition: {sql: 'FLOAT64x2(longitude, latitude)'}","+```","+","+If the table has `red`, `green`, and `blue` columns with floating-point values","+in the range 0–1, this packs them into an 8-bit RGBA color with full opacity.","+","+```ts","+getFillColor: {sql: 'RGBA8(red, green, blue, 1)'}","+```","+"," #### `dataTransform` (Function, optional) {#datatransform}"," "," Executed to manipulate remote data when it's fetched. This callback applies when `data` is assigned a value that is either string (URL), Promise or an async iterable."],"additions":35,"deletions":0,"truncated":false},{"path":"modules/core/package.json","lines":["@@ -34,6 +34,11 @@","       \"import\": \"./dist/index.js\",","       \"require\": \"./dist/index.cjs\"","     },","+    \"./sql\": {","+      \"types\": \"./dist/arrow/upstream-math/sql-parser.d.ts\",","+      \"import\": \"./dist/arrow/upstream-math/sql-parser.js\",","+      \"require\": \"./dist/arrow/upstream-math/sql-parser.cjs\"","+    },","     \"./arrow\": {","       \"types\": \"./dist/arrow/upstream-luma/arrow-converter.d.ts\",","       \"visgl:webgl-only\": {","@@ -64,7 +69,9 @@","     \"@luma.gl/engine\": \"10.0.0-alpha.14\",","     \"@luma.gl/graph\": \"10.0.0-alpha.14\",","     \"@luma.gl/shaders\": \"10.0.0-alpha.14\",","+","     \"@math.gl/core\": \"5.0.0-beta.8\",","+    \"@math.gl/expressions\": \"5.0.0-beta.8\",","     \"@math.gl/earth\": \"5.0.0-beta.8\",","     \"@math.gl/geospatial\": \"5.0.0-beta.8\",","     \"@math.gl/web-mercator\": \"5.0.0-beta.8\","],"additions":7,"deletions":0,"truncated":false},{"path":"modules/core/src/arrow/accessor-queries.ts","lines":["@@ -0,0 +1,60 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import {Table, type Vector} from 'apache-arrow';","+import type {SQLParser} from '../types/layer-props';","+import {evaluateColumnExpression} from './column-constructors';","+import {isArrowTableAppend} from './column-query-append';","+import {unwrapLoaderArrowResult} from '../utils/loader-utils';","+import {isArrowTable} from './upstream-math/is-arrow-table';","+","+/** Evaluates row-preserving expressions, reusing prior batches for append-only data. */","+export function evaluateAccessorQueries(","+  source: unknown,","+  expressions: Record<string, string>,","+  parseExpression: SQLParser['parseExpression'],","+  previous?: {","+    source: unknown;","+    expressions: Record<string, string>;","+    parseExpression: SQLParser['parseExpression'];","+    table?: Table;","+  }","+): Table {","+  const data = unwrapLoaderArrowResult(source);","+  if (!isArrowTable(data)) {","+    throw new Error('SQL accessors require Arrow table data');","+  }","+  if (!parseExpression) {","+    throw new Error('SQL accessors require sqlParser.parseExpression');","+  }","+","+  const entries = Object.entries(expressions);","+  const priorSource = unwrapLoaderArrowResult(previous?.source);","+  const priorTable = previous?.table;","+  const canAppend =","+    isArrowTable(priorSource) &&","+    priorTable &&","+    previous.parseExpression === parseExpression &&","+    Object.keys(previous.expressions).length === entries.length &&","+    entries.every(([name, expression]) => previous.expressions[name] === expression) &&","+    isArrowTableAppend(priorSource, data);","+  const input = canAppend","+    ? new Table(data.schema, data.batches.slice(priorSource.batches.length))","+    : data;","+  const parsed = entries.map(([name, sql]) => ({name, expression: parseExpression(sql)}));","+  const evaluate = (table: Table) => {","+    const columns: Record<string, Vector> = Object.create(null);","+    for (const {name, expression} of parsed) {","+      columns[name] = evaluateColumnExpression(expression, table);","+    }","+    return new Table(columns);","+  };","+","+  const batches = input.batches;","+  const result =","+    batches.length <= 1","+      ? evaluate(input)","+      : new Table(batches.flatMap(batch => evaluate(new Table(input.schema, [batch])).batches));","+  return canAppend ? new Table(result.schema, [...priorTable.batches, ...result.batches]) : result;","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"modules/core/src/arrow/column-constructors.ts","lines":["@@ -0,0 +1,127 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import {compileArrowExpression, type ArrowExpression} from '@math.gl/expressions/arrow';","+import {SQRT} from '@math.gl/expressions/math';","+import type {Expression} from '@math.gl/expressions';","+import {","+  Field,","+  FixedSizeList,","+  Float16,","+  Float32,","+  Float64,","+  Uint8,","+  Uint16,","+  vectorFromArray,","+  type DataType,","+  type Table,","+  type Vector","+} from 'apache-arrow';","+","+/**","+ * deck.gl-local typed vector constructors. Keep this independent of the SQL parser:","+ * these function names can move into math.gl's Arrow expression registry later.","+ */","+const CONSTRUCTORS: Record<string, {width: number; type: () => DataType; normalized?: number}> = {","+  FLOAT32X2: {width: 2, type: () => new Float32()},","+  FLOAT32X3: {width: 3, type: () => new Float32()},","+  FLOAT32X4: {width: 4, type: () => new Float32()},","+  FLOAT64X2: {width: 2, type: () => new Float64()},","+  FLOAT64X3: {width: 3, type: () => new Float64()},","+  FLOAT64X4: {width: 4, type: () => new Float64()},","+  RGBA8: {width: 4, type: () => new Uint8(), normalized: 255},","+  RGBA16: {width: 4, type: () => new Uint16(), normalized: 65535},","+  RGBA16F: {width: 4, type: () => new Float16()},","+  RGBA32F: {width: 4, type: () => new Float32()}","+};","+","+/** SQL expression node inspected for a typed constructor call. */","+type FunctionCall = Expression & {","+  type: 'CallExpression';","+  callee: {type: 'Identifier'; name: string};","+  arguments: Expression[];","+};","+","+/** Looks up a typed constructor and validates its argument count. */","+function constructorFor(expression: Expression) {","+  const node = expression as FunctionCall;","+  if (node.type !== 'CallExpression' || node.callee?.type !== 'Identifier') return null;","+  const definition = CONSTRUCTORS[node.callee.name.toUpperCase()];","+  if (!definition) return null;","+  if (node.arguments.length !== definition.width) {","+    throw new Error(`${node.callee.name} requires exactly ${definition.width} arguments`);","+  }","+  return definition;","+}","+","+/** Evaluate one row-preserving SQL expression, including local typed constructors. */","+export function evaluateColumnExpression(expression: Expression, input: Table): Vector {","+  if (expression.type === 'Identifier') {","+    const column = input.getChild(expression.name);","+    if (!column) {","+      throw new Error(`Unknown Arrow column: ${expression.name}`);","+    }","+    return column;","+  }","+  const call = expression as FunctionCall;","+  if (","+    call.type === 'CallExpression' &&","+    call.callee?.type === 'Identifier' &&","+    call.callee.name.toUpperCase() === 'FLOAT32'","+  ) {","+    if (call.arguments.length !== 1) {","+      throw new Error('FLOAT32 requires exactly 1 argument');","+    }","+    const cast: ArrowExpression = {","+      type: 'CallExpression',","+      callee: {type: 'Identifier', name: 'cast'},","+      arguments: [call.arguments[0]!, {type: 'Literal', value: 'float32', raw: '\"float32\"'}]","+    };","+    return compileArrowExpression(cast, {","+      inputSchema: input.schema,","+      functions: [SQRT]","+    }).evaluateTable(input);","+  }","+","+  const constructor = constructorFor(expression);","+  if (!constructor) {","+    return compileArrowExpression(expression, {","+      inputSchema: input.schema,","+      functions: [SQRT]","+    }).evaluateTable(input);","+  }","+","+  const components = call.arguments.map(argument =>","+    compileArrowExpression(argument as ArrowExpression, {","+      inputSchema: input.schema,","+      functions: [SQRT]","+    }).evaluateTable(input)","+  );","+  const rows: (number[] | null)[] = new Array(input.numRows);","+  for (let row = 0; row < input.numRows; row++) {","+    const values: number[] = [];","+    let nullValue = false;","+    for (let component = 0; component < components.length; component++) {","+      const value = components[component]!.get(row);","+      if (value === null || value === undefined) {","+        nullValue = true;","+        break;","+      }","+      if (typeof value !== 'number' || !Number.isFinite(value)) {","+        throw new Error(`${call.callee.name} requires finite numeric channels (row ${row})`);","+      }","+      values.push(","+        constructor.normalized === undefined","+          ? value","+          : Math.round(Math.min(1, Math.max(0, value)) * constructor.normalized)","+      );","+    }","+    // One null channel invalidates the entire vector, rather than producing NaN sentinels.","+    rows[row] = nullValue ? null : values;","+  }","+  return vectorFromArray(","+    rows,","+    new FixedSizeList(constructor.width, new Field('item', constructor.type(), true))","+  );","+}"],"additions":127,"deletions":0,"truncated":false},{"path":"modules/core/src/arrow/column-query-append.ts","lines":["@@ -0,0 +1,13 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import type {Table} from 'apache-arrow';","+","+/** Identifies a strict append to an existing Arrow batch sequence. */","+export function isArrowTableAppend(previous: Table, current: Table): boolean {","+  return (","+    previous.batches.length < current.batches.length &&","+    previous.batches.every((batch, index) => current.batches[index] === batch)","+  );","+}"],"additions":13,"deletions":0,"truncated":false},{"path":"modules/core/src/arrow/data-query.ts","lines":["@@ -0,0 +1,39 @@","+// deck.gl","+// SPDX-License-Identifier: MIT","+// Copyright (c) vis.gl contributors","+","+import {query, type Query, type QueryOptions} from '@loaders.gl/core/scan';","+import {unwrapLoaderArrowResult} from '../utils/loader-utils';","+import {isArrowTable} from './upstream-math/is-arrow-table';","+import type {Loader} from '@loaders.gl/core/loader-utils';","+import type {SQLParser} from '../types/layer-props';","+","+/** Executes SQL on URL or in-memory Arrow data through loaders.gl. */","+export async function queryLayerData(","+  input: unknown,","+  sql: string,","+  loaders: Loader[] | undefined,","+  options: unknown,","+  parseQuery: SQLParser['parseQuery']","+) {","+  if (!parseQuery) {","+    throw new Error('query requires sqlParser.parseQuery');","+  }","+  const sqlParser = (statement: string) => {","+    const parsed = parseQuery(statement) as Query;","+    return !('command' in parsed) && parsed.from === 'data' ? {...parsed, from: undefined} : parsed;","+  };","+  if (typeof input === 'string') {","+    if (!loaders?.length) {","+      throw new Error('query requires a source-capable loader');","+    }","+    return (await query(sql, {...(options as QueryOptions), source: input, loaders, sqlParser}))","+      .data;","+  }","+  const data = unwrapLoaderArrowResult(input);","+  if (!isArrowTable(data)) {","+    throw new Error('query requires a URL or Arrow table data');","+  }","+  const source = {shape: 'arrow-table' as const, data};","+  return (await query(sql, {source, sqlParser})).data;","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"modules/core/src/arrow/upstream-math/sql-parser.ts","lines":["@@ -0,0 +1,12 @@","+// deck.gl","+// SPDX-License-Identifier: MIT"