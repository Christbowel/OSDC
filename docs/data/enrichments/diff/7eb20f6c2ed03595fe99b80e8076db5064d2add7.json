{"id":"7eb20f6c2ed03595fe99b80e8076db5064d2add7","axis":"silent","repo":"pnpm/pnpm","sha":"7eb20f6c2ed03595fe99b80e8076db5064d2add7","parsed":{"files":[{"path":".config/commitlint.config.cjs","lines":["@@ -1,5 +0,0 @@","-'use strict'","-","-module.exports = {","-  extends: ['@commitlint/config-conventional']","-}"],"additions":0,"deletions":5,"truncated":false},{"path":".config/githooks/check-conventional-commit.mjs","lines":["@@ -0,0 +1,146 @@","+// Validates that a commit message header follows Conventional Commits, with the","+// header rules of `@commitlint/config-conventional`. It has no npm dependencies","+// so it runs in a fresh clone before `pnpm install`.","+//","+// Enforced on the header (`type(scope)!: subject`):","+//   - type is one of the Conventional Commits types, lower-case","+//   - subject is present, does not end with a period, does not start with a","+//     capital letter, and is not in all caps","+//   - the header has no surrounding whitespace and is at most 100 characters","+//","+// Body/footer line-length limits are intentionally not enforced: long URLs and","+// pasted output in bodies are common.","+","+import { readFileSync } from 'node:fs'","+import path from 'node:path'","+import process from 'node:process'","+import { pathToFileURL } from 'node:url'","+","+const HEADER_MAX_LENGTH = 100","+","+const ALLOWED_TYPES = new Set([","+  'build',","+  'chore',","+  'ci',","+  'docs',","+  'feat',","+  'fix',","+  'perf',","+  'refactor',","+  'revert',","+  'style',","+  'test',","+])","+","+// Auto-generated headers that never follow the Conventional Commits shape.","+const IGNORED_HEADER = [","+  /^Merge /,","+  /^Merged /,","+  /^[Rr]evert /,","+  /^[Rr]eapply /,","+  /^(?:amend|fixup|squash)!/,","+  /^Auto-merged /,","+  /^Automatic merge/,","+]","+","+/**","+ * Returns the reasons the commit message's header breaks the rules, or an","+ * empty array when it is valid or is an auto-generated header that is exempt.","+ */","+export function lintCommitMessage (raw) {","+  const header = readHeader(raw)","+  if (header.trim() === '' || IGNORED_HEADER.some((re) => re.test(header))) {","+    return []","+  }","+  return collectErrors(header)","+}","+","+// The header is the first non-empty, non-comment line. Git drops `#` comment","+// lines from the final message, so they must not be treated as the header.","+function readHeader (raw) {","+  for (const line of raw.split(/\\r?\\n/)) {","+    if (line.startsWith('#') || line.trim() === '') continue","+    return line","+  }","+  return ''","+}","+","+function collectErrors (header) {","+  const errors = []","+","+  if (header !== header.trim()) {","+    errors.push('header must not start or end with whitespace')","+  }","+  if (header.length > HEADER_MAX_LENGTH) {","+    errors.push(`header is ${header.length} characters; keep it within ${HEADER_MAX_LENGTH}`)","+  }","+","+  const match = /^([^():!\\s]+)(?:\\([^)]*\\))?!?:(?: (.*))?$/.exec(header.trim())","+  if (!match) {","+    errors.push('header must match \"type(optional scope): subject\", e.g. \"fix(core): handle empty input\"')","+    return errors","+  }","+","+  const [, type, subject = ''] = match","+","+  if (type !== type.toLowerCase()) {","+    errors.push(`type \"${type}\" must be lower-case`)","+  }","+  if (!ALLOWED_TYPES.has(type.toLowerCase())) {","+    errors.push(`type \"${type}\" is not allowed; use one of: ${[...ALLOWED_TYPES].join(', ')}`)","+  }","+","+  if (subject.trim() === '') {","+    errors.push('subject must not be empty')","+    return errors","+  }","+  if (subject.endsWith('.')) {","+    errors.push('subject must not end with a period')","+  }","+","+  // Quoted text may carry proper names (e.g. \"`Eslint` config\"), so it is","+  // ignored by the case checks, as commitlint does.","+  const casedText = subject.replace(/`.*?`|\".*?\"|'.*?'/g, '').trim()","+  // Scripts without letter case, such as Chinese, have nothing to check.","+  const hasCasedLetter = casedText.toUpperCase() !== casedText.toLowerCase()","+  if (hasCasedLetter && !/^\\d/.test(casedText)) {","+    if (casedText === casedText.toUpperCase()) {","+      errors.push('subject must not be in all upper-case')","+    } else if (casedText.charAt(0) !== casedText.charAt(0).toLowerCase()) {","+      errors.push('subject must not start with a capital letter')","+    }","+  }","+","+  return errors","+}","+","+function formatReport (header, errors) {","+  return `","+✖ Commit message rejected — it does not follow Conventional Commits:","+","+    ${header}","+","+${errors.map((e) => `  • ${e}`).join('\\n')}","+","+A header looks like \"type(optional scope): subject\", for example:","+","+    feat(config): add the blockExoticSubdeps setting","+    fix: do not crash on an empty lockfile","+","+Allowed types: ${[...ALLOWED_TYPES].join(', ')}.","+`","+}","+","+if (process.argv[1] && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url) {","+  const msgPath = process.argv[2]","+  if (!msgPath) {","+    console.error('check-conventional-commit: missing commit message file path argument')","+    process.exit(1)","+  }","+  const raw = readFileSync(msgPath, 'utf8')","+  const errors = lintCommitMessage(raw)","+  if (errors.length > 0) {","+    console.error(formatReport(readHeader(raw), errors))","+    process.exit(1)","+  }","+}"],"additions":146,"deletions":0,"truncated":false},{"path":".config/githooks/check-conventional-commit.test.mjs","lines":["@@ -0,0 +1,76 @@","+import assert from 'node:assert/strict'","+import { test } from 'node:test'","+import { lintCommitMessage } from './check-conventional-commit.mjs'","+","+test('accepts conventional headers', () => {","+  for (const header of [","+    'feat: add a setting',","+    'fix(core): handle empty input',","+    'refactor(lockfile)!: drop the v5 format',","+    'chore: bump `Eslint` to the latest',","+    'docs: mention \"Node.js\" in the guide',","+    'perf: 2x faster resolution',","+    'test: cover iOS paths',","+    'fix: 修复安装失败',","+    'fix(core): 修复 lockfile 解析',","+  ]) {","+    assert.deepEqual(lintCommitMessage(`${header}\\n\\nBody.\\n`), [], header)","+  }","+})","+","+test('skips comment lines and leading blank lines when finding the header', () => {","+  assert.deepEqual(lintCommitMessage('# Please enter the commit message\\n\\nfix: a bug\\n'), [])","+})","+","+test('ignores auto-generated headers', () => {","+  for (const header of [","+    'Merge branch \\'main\\' into topic',","+    'Revert \"feat: add a setting\"',","+    'fixup! feat: add a setting',","+    'amend! feat: add a setting',","+    'squash! feat: add a setting',","+  ]) {","+    assert.deepEqual(lintCommitMessage(header), [], header)","+  }","+})","+","+test('accepts an empty message, which git aborts on its own', () => {","+  assert.deepEqual(lintCommitMessage('# only a comment\\n'), [])","+})","+","+test('rejects a header without a type', () => {","+  assert.equal(lintCommitMessage('add a setting').length, 1)","+})","+","+test('rejects an unknown or upper-case type', () => {","+  assert.match(lintCommitMessage('feature: add a setting').join('\\n'), /not allowed/)","+  assert.match(lintCommitMessage('Feat: add a setting').join('\\n'), /must be lower-case/)","+})","+","+test('rejects a subject that starts with a capital letter', () => {","+  assert.match(lintCommitMessage('feat: Add a setting').join('\\n'), /capital letter/)","+  assert.match(lintCommitMessage('feat: Add API support').join('\\n'), /capital letter/)","+  assert.match(lintCommitMessage('feat: Add New Setting').join('\\n'), /capital letter/)","+})","+","+test('rejects an all upper-case subject', () => {","+  assert.match(lintCommitMessage('feat: ADD A SETTING').join('\\n'), /all upper-case/)","+})","+","+test('rejects a subject ending with a period', () => {","+  assert.match(lintCommitMessage('fix: handle empty input.').join('\\n'), /period/)","+})","+","+test('rejects an empty subject', () => {","+  assert.match(lintCommitMessage('fix: ').join('\\n'), /must not be empty/)","+})","+","+test('rejects a header with surrounding whitespace', () => {","+  assert.match(lintCommitMessage(' fix: handle empty input').join('\\n'), /whitespace/)","+  assert.match(lintCommitMessage('fix: handle empty input ').join('\\n'), /whitespace/)","+})","+","+test('rejects a header longer than 100 characters', () => {","+  assert.match(lintCommitMessage(`fix: ${'a'.repeat(96)}`).join('\\n'), /101 characters/)","+  assert.deepEqual(lintCommitMessage(`fix: ${'a'.repeat(95)}`), [])","+})"],"additions":76,"deletions":0,"truncated":false},{"path":".config/githooks/commit-msg","lines":["@@ -0,0 +1,8 @@","+#!/bin/sh","+# Each check is a self-contained Node.js script with no npm dependencies, so","+# the hook works in a fresh clone before `pnpm install` has run.","+set -o errexit -o nounset","+","+node .config/githooks/reject-bare-issue-refs.mjs \"$1\"","+node .config/githooks/reject-bare-mentions.mjs \"$1\"","+node .config/githooks/check-conventional-commit.mjs \"$1\""],"additions":8,"deletions":0,"truncated":false},{"path":".config/githooks/install.mjs","lines":["@@ -0,0 +1,26 @@","+// Points git at this directory so the hooks in it run. The root package runs","+// this from its \"prepare\" script, so a plain `pnpm install` wires the hooks up.","+//","+// A relative hooksPath is resolved against each working tree, so this works for","+// the bare-repo + worktrees layout described in CONTRIBUTING.md too.","+","+import { execFileSync } from 'node:child_process'","+import process from 'node:process'","+","+const HOOKS_PATH = '.config/githooks'","+","+// The hooks are a developer safety net; CI has its own gates, and a workflow","+// that commits or pushes must not pay for the pre-push compile and lint.","+if (process.env.CI) {","+  process.exit(0)","+}","+","+// Outside a git repo (e.g. when the package is unpacked from a tarball) there","+// is nothing to wire up.","+try {","+  execFileSync('git', ['rev-parse', '--git-dir'], { stdio: 'ignore' })","+} catch {","+  process.exit(0)","+}","+","+execFileSync('git', ['config', 'core.hooksPath', HOOKS_PATH])"],"additions":26,"deletions":0,"truncated":false},{"path":".config/githooks/pre-commit","lines":["rename from .config/husky/pre-commit","rename to .config/githooks/pre-commit"],"additions":0,"deletions":0,"truncated":false},{"path":".config/githooks/pre-push","lines":["rename from .config/husky/pre-push","rename to .config/githooks/pre-push"],"additions":0,"deletions":0,"truncated":false},{"path":".config/githooks/prepare-commit-msg","lines":["rename from .config/husky/prepare-commit-msg","rename to .config/githooks/prepare-commit-msg"],"additions":0,"deletions":0,"truncated":false},{"path":".config/githooks/reject-bare-issue-refs.mjs","lines":["rename from .config/husky/reject-bare-issue-refs.mjs","rename to .config/githooks/reject-bare-issue-refs.mjs"],"additions":0,"deletions":0,"truncated":false},{"path":".config/githooks/reject-bare-mentions.mjs","lines":["rename from .config/husky/reject-bare-mentions.mjs","rename to .config/githooks/reject-bare-mentions.mjs"],"additions":0,"deletions":0,"truncated":false},{"path":".config/husky/.gitignore","lines":["@@ -1 +0,0 @@","-_"],"additions":0,"deletions":1,"truncated":false},{"path":".config/husky/commit-msg","lines":["@@ -1,3 +0,0 @@","-node .config/husky/reject-bare-issue-refs.mjs \"$1\"","-node .config/husky/reject-bare-mentions.mjs \"$1\"","-pnpm commitlint --edit --config=.config/commitlint.config.cjs"],"additions":0,"deletions":3,"truncated":false},{"path":".config/pnpm/catalog.yaml","lines":["@@ -4,9 +4,6 @@ catalog:","   # above pnpm's supported floor of Node.js >=22.13.","   '@babel/core': ^7.29.7","   '@babel/plugin-transform-explicit-resource-management': ^7.29.7","-  '@commitlint/cli': ^21.2.4","-  '@commitlint/config-conventional': ^21.2.4","-  '@commitlint/prompt-cli': ^21.2.4","   '@cyclonedx/cyclonedx-library': 10.5.1","   '@emnapi/wasi-threads': 2.2.0","   '@eslint/js': ^10.0.1","@@ -150,7 +147,6 @@ catalog:","   http-proxy-agent: ^9.1.0","   https-proxy-agent: ^9.1.0","   https-proxy-server-express: 0.1.2","-  husky: ^9.1.7","   hyperdrive-schemas: ^2.0.0","   # ini 7.x requires Node.js ^22.22.2 || ^24.15.0 || >=26.0.0, above pnpm's","   # supported floor of Node.js >=22.13."],"additions":0,"deletions":4,"truncated":false},{"path":".github/workflows/ci.yml","lines":["@@ -32,6 +32,7 @@ jobs:","     outputs:","       ts: ${{ steps.force.outputs.ts || steps.filter.outputs.ts }}","       changesets: ${{ steps.filter.outputs.changesets }}","+      githooks: ${{ steps.force.outputs.ts || steps.filter.outputs.githooks }}","     steps:","       # In the merge queue the full suite must run: `TS CI / Compile & Lint`","       # is itself a required check, and a skipped job never reports its","@@ -80,6 +81,12 @@ jobs:","             # it gates that job alone.","             changesets:","               - '.changeset/**'","+            # The git hooks' tests need neither a dependency install nor a","+            # compile, so a hook-only change runs them alone rather than","+            # starting the TypeScript suite.","+            githooks:","+              - '.config/githooks/**'","+              - '.github/workflows/ci.yml'"," ","   compile-and-lint:","     needs: changes","@@ -131,6 +138,24 @@ jobs:","         path: compiled.tar.gz","         retention-days: 1"," ","+  test-git-hooks:","+    needs: changes","+    if: ${{ !cancelled() && needs.changes.outputs.githooks == 'true' }}","+    name: TS CI / Test Git Hooks","+    runs-on: blacksmith-4vcpu-ubuntu-2404","+    steps:","+    - name: Checkout Commit","+      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+      with:","+        persist-credentials: false","+    - name: Install Node.js","+      uses: pnpm/setup@731dfb6463bbd11c11fd0ee11fe00ed0e36d48a1 # v3.2.0","+      with:","+        runtime: node@22","+        install: false","+    - name: Test git hook scripts","+      run: node --test .config/githooks/*.test.mjs","+","   # Build the pnpr binaries once per OS via a per-OS reusable workflow (not a","   # single matrix job) so each platform's test jobs gate only on their own","   # build. `needs` can only target a whole job, never an individual matrix","@@ -228,6 +253,7 @@ jobs:","     needs:","       - changes","       - compile-and-lint","+      - test-git-hooks","       - build-pnpr-linux","       - build-pnpr-windows","       - test"],"additions":26,"deletions":0,"truncated":false},{"path":".github/workflows/create-release-pr.yml","lines":["@@ -46,13 +46,6 @@ jobs:","   create-release-pr:","     if: github.repository == 'pnpm/pnpm' # Only run on the main repository, not forks","     runs-on: blacksmith-4vcpu-ubuntu-2404","-    env:","-      # The husky hooks are a developer safety net; CI has its own gates. Without","-      # this, `pnpm install` wires the hooks and the pre-push hook runs the full","-      # TS compile/lint plus the Rust clippy/doc sweep during \"Commit and push\"","-      # (the shallow clone and URL remote make its change detection always","-      # conclude that Rust sources changed).","-      HUSKY: 0","     steps:","     - name: Checkout","       uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1"],"additions":0,"deletions":7,"truncated":false},{"path":".github/workflows/update-lockfile.yml","lines":["@@ -21,11 +21,6 @@ jobs:","     runs-on: blacksmith-4vcpu-ubuntu-2404","     timeout-minutes: 30","     env:","-      # The husky hooks are a developer safety net; CI has its own gates. Without","-      # this, the full install wires the hooks and the pre-push hook runs the TS","-      # compile/lint (and, when the remote branch doesn't exist yet, the Rust","-      # clippy/doc sweep) during the action's push.","-      HUSKY: 0","       # Let the install regenerate the embedded esm-loader bundle when a bumped","       # dependency changes it. The update PR's CI checks the committed result.","       PNPM_ESM_LOADER_REFRESH_BUNDLE: 'true'"],"additions":0,"deletions":5,"truncated":false},{"path":"AGENTS.md","lines":["@@ -195,19 +195,19 @@ Follow the [Conventional Commits](https://www.conventionalcommits.org/) specific"," "," ### Install the git hooks before committing"," ","-The git hooks in `.config/husky/` (including the `commit-msg` check described below) only run once husky has wired them into git. A fresh clone does **not** have them active until installed. **Before making any commit, ensure the hooks are installed** by running one of:","+The git hooks live in `.config/githooks/` and only run once git is pointed at them via `core.hooksPath`. A fresh clone does **not** have them active until installed. **Before making any commit, ensure the hooks are installed** by running one of:"," "," ```bash","-pnpm install      # runs the \"prepare\": \"husky .config/husky\" script as part of install","-# or, if dependencies are already installed, register the hooks on their own:","-pnpm exec husky .config/husky","+pnpm install      # runs the \"prepare\" script, which sets core.hooksPath","+# or, to register the hooks on their own (no dependencies needed):","+node .config/githooks/install.mjs"," ```"," ","-You can confirm the hooks are active with `git config core.hooksPath` (it should point at husky's directory) and by checking that `.config/husky/_/` exists. Do not commit with hooks uninstalled — that silently skips every check, including the bare `#NNN` rejection below.","+You can confirm the hooks are active with `git config core.hooksPath` (it should print `.config/githooks`). The `commit-msg` checks are dependency-free Node.js scripts, so they run even before `pnpm install`. Do not commit with hooks uninstalled — that silently skips every check, including the bare `#NNN` rejection below."," "," ### Never use bare `#NNN` issue/PR references"," ","-**Do not write a bare `#NNN` (a `#` followed by digits) anywhere in a commit message.** A `commit-msg` hook (`.config/husky/reject-bare-issue-refs.mjs`) rejects them.","+**Do not write a bare `#NNN` (a `#` followed by digits) anywhere in a commit message.** A `commit-msg` hook (`.config/githooks/reject-bare-issue-refs.mjs`) rejects them."," "," GitHub turns any `#NNN` into a link to issue/PR `NNN` of *this* repo, which is almost never what a bare reference means. This is a frequent AI mistake, in these forms:"," ","@@ -220,7 +220,7 @@ For references to issues/PRs in **this** repo, also use the qualified form `pnpm"," "," ### Never use a bare `@mention`"," ","-**Do not write a bare `@name` (an `@` followed by a username-like token) anywhere in a commit message.** A `commit-msg` hook (`.config/husky/reject-bare-mentions.mjs`) rejects them.","+**Do not write a bare `@name` (an `@` followed by a username-like token) anywhere in a commit message.** A `commit-msg` hook (`.config/githooks/reject-bare-mentions.mjs`) rejects them."," "," GitHub turns any `@name` into a mention of that user/org/team, which is wrong either way it is meant:"," "],"additions":7,"deletions":7,"truncated":false},{"path":"CONTRIBUTING.md","lines":["@@ -73,7 +73,7 @@ Every crate reaches the build this way, in CI as well as locally. Cargo resolves"," "," The block is a function of `Cargo.lock`, so an install regenerates it byte for byte and leaves `git status` clean. It changes only when a git-sourced dependency moves to a new revision, and that change belongs in the same commit as the lockfile. Rust CI fails if the two drift apart."," ","-Make sure `~/.cargo/bin` is on your `PATH`, ahead of any system-wide Rust in `/usr/bin`. `rustup`'s installer adds this entry through `~/.cargo/env`; ensure your shell sources it. This matters for the git hooks. The `pnpm install` step above wires up husky. Its `pre-commit` hook formats the Rust files being committed, as described under [Rust formatting](#rust-formatting), and its `pre-push` hook runs the Rust checks in `pnpm/scripts/pre-push-rust.sh` (format, doc, dylint, typos) alongside the TypeScript compile and lint. That script locates `cargo`, `rustup`, `taplo`, `typos`, and `cargo-dylint` through `PATH`, and it **skips** a check when the tool is not found rather than failing. A push that appears to pass locally with the tools off `PATH` has silently skipped the format, doc, and dylint checks, so those problems surface only in CI.","+Make sure `~/.cargo/bin` is on your `PATH`, ahead of any system-wide Rust in `/usr/bin`. `rustup`'s installer adds this entry through `~/.cargo/env`; ensure your shell sources it. This matters for the git hooks. The `pnpm install` step above points git at the hooks in `.config/githooks/`. The `pre-commit` hook formats the Rust files being committed, as described under [Rust formatting](#rust-formatting), and the `pre-push` hook runs the Rust checks in `pnpm/scripts/pre-push-rust.sh` (format, doc, dylint, typos) alongside the TypeScript compile and lint. That script locates `cargo`, `rustup`, `taplo`, `typos`, and `cargo-dylint` through `PATH`, and it **skips** a check when the tool is not found rather than failing. A push that appears to pass locally with the tools off `PATH` has silently skipped the format, doc, and dylint checks, so those problems surface only in CI."," "," For the full Rust development workflow (checks, tests, benchmarks, and the code style guide), see [`pnpm/CONTRIBUTING.md`](./pnpm/CONTRIBUTING.md)."," ","@@ -156,11 +156,13 @@ One-time setup:","    cd ~/src/pnpm/pnpm","    ```"," ","-2. Point Husky at a path that exists inside every worktree (not inside the bare repo's gitdir),","-   so commit and push hooks run when you commit from any worktree:","+2. Point git at the tracked `.config/githooks` directory so the git hooks run when you","+   commit from any worktree. The path is relative, so git resolves it inside whichever","+   worktree you commit from. (`pnpm install` does this for you in the next step; run it","+   yourself if you want the hooks active before the first install.)"," ","    ```shell","-   git config core.hooksPath .config/husky/_","+   git config core.hooksPath .config/githooks","    ```"," "," 3. Create the first worktree for `main` and install dependencies:"],"additions":6,"deletions":4,"truncated":false},{"path":"package.json","lines":["@@ -3,7 +3,7 @@","   \"private\": true,","   \"scripts\": {","     \"bump\": \"node pnpm11/__utils__/scripts/src/bump.ts\",","-    \"prepare\": \"husky .config/husky\",","+    \"prepare\": \"node .config/githooks/install.mjs\",","     \"pretest\": \"pn compile-only && pn prepare-fixtures\",","     \"prepare-fixtures\": \"pn --dir=pnpm11/__fixtures__ prepareFixtures\",","     \"lint\": \"pn spellcheck && pn lint:meta && pn check:versioning && pn lint:ts\",","@@ -62,9 +62,6 @@","     \"ci:build-pnpr\": \"cargo build --locked --release -p pnpr --bin pnpr -p pnpr-fixtures --bin pnpr-prepare\"","   },","   \"devDependencies\": {","-    \"@commitlint/cli\": \"catalog:\",","-    \"@commitlint/config-conventional\": \"catalog:\",","-    \"@commitlint/prompt-cli\": \"catalog:\",","     \"@pnpm/eslint-config\": \"workspace:*\",","     \"@pnpm/jest-config\": \"workspace:*\",","     \"@pnpm/meta-updater\": \"catalog:\",","@@ -79,7 +76,6 @@","     \"cspell\": \"catalog:\",","     \"eslint\": \"catalog:\",","     \"eslint-plugin-regexp\": \"catalog:\",","-    \"husky\": \"catalog:\",","     \"jest\": \"catalog:\",","     \"keyv\": \"catalog:\",","     \"lcov-result-merger\": \"catalog:\","],"additions":1,"deletions":5,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -185,18 +185,6 @@ snapshots:"," \t\t\t\t\t\"specifier\": \"^7.29.7\","," \t\t\t\t\t\"version\": \"7.29.7\","," \t\t\t\t},","-\t\t\t\t\"@commitlint/cli\": {","-\t\t\t\t\t\"specifier\": \"^21.2.4\",","-\t\t\t\t\t\"version\": \"21.2.4\",","-\t\t\t\t},","-\t\t\t\t\"@commitlint/config-conventional\": {","-\t\t\t\t\t\"specifier\": \"^21.2.4\",","-\t\t\t\t\t\"version\": \"21.2.4\",","-\t\t\t\t},","-\t\t\t\t\"@co