{"id":"GHSA-mmfr-pmjx-hw9w","axis":"advisories","repo":"getkin/kin-openapi","sha":"1d0a337c9b1570fab283be8a04c8af6e43b9a22c","parsed":{"files":[{"path":"openapi3filter/ghsa_mmfr_pmjx_hw9w_test.go","lines":["@@ -0,0 +1,139 @@","+package openapi3filter_test","+","+import (","+\t\"bytes\"","+\t\"mime/multipart\"","+\t\"net/http\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/getkin/kin-openapi/openapi3\"","+\t\"github.com/getkin/kin-openapi/openapi3filter\"","+\t\"github.com/getkin/kin-openapi/routers/gorillamux\"","+)","+","+// GHSA-mmfr-pmjx-hw9w: a nil-pointer dereference in convertParseError (reached","+// via ConvertErrors / ValidationErrorEncoder) lets an unauthenticated client","+// crash a server with a single multipart/form-data request.","+//","+// convertParseError dereferences e.Parameter.In in the \"query\" branch without a","+// nil guard. For request-body errors e.Parameter is always nil, and only the","+// multipart decoder produces the nested *ParseError shape that reaches that","+// branch, so a malformed scalar part (e.g. a non-numeric value for an integer","+// property) panics.","+//","+// Sending the crafted request through ValidateRequest and then ConvertErrors","+// must not panic; it must return a 400 with a meaningful message. The","+// application/json control cases confirm the JSON body path is unaffected.","+func TestGHSA_mmfr_pmjx_hw9w_ConvertErrors_NoPanic(t *testing.T) {","+\tspec := `","+openapi: '3.0.3'","+info:","+  title: t","+  version: '1.0.0'","+paths:","+  /upload:","+    post:","+      requestBody:","+        required: true","+        content:","+          multipart/form-data:","+            schema:","+              type: object","+              properties:","+                age: {type: integer}","+          application/json:","+            schema:","+              type: object","+              properties:","+                age: {type: integer}","+      responses:","+        '200': {description: ok}","+`[1:]","+","+\tloader := openapi3.NewLoader()","+\tctx := loader.Context","+","+\tdoc, err := loader.LoadFromData([]byte(spec))","+\trequire.NoError(t, err)","+\trequire.NoError(t, doc.Validate(ctx))","+","+\trouter, err := gorillamux.NewRouter(doc)","+\trequire.NoError(t, err)","+","+\tmultipartBody := func() (string, string) {","+\t\tvar buf bytes.Buffer","+\t\tw := multipart.NewWriter(&buf)","+\t\trequire.NoError(t, w.WriteField(\"age\", \"notanumber\"))","+\t\trequire.NoError(t, w.Close())","+\t\treturn w.FormDataContentType(), buf.String()","+\t}","+","+\tfor _, tc := range []struct {","+\t\tname        string","+\t\tcontentType string","+\t\tbody        string","+\t\twantStatus  int","+\t}{","+\t\t{","+\t\t\t// The crash: multipart scalar part fails primitive parsing.","+\t\t\t// e.Parameter == nil and the cause is a nested *ParseError.","+\t\t\tname:       \"multipart malformed scalar (the crash)\",","+\t\t\tbody:       \"notanumber\",","+\t\t\twantStatus: http.StatusBadRequest,","+\t\t},","+\t\t{","+\t\t\t// Control: malformed JSON body. *ParseError whose cause is an","+\t\t\t// encoding/json error, so the type assertion fails and the safe","+\t\t\t// fallback branch is taken.","+\t\t\tname:        \"json malformed body\",","+\t\t\tcontentType: \"application/json\",","+\t\t\tbody:        `{\"age\": `,","+\t\t\twantStatus:  http.StatusBadRequest,","+\t\t},","+\t\t{","+\t\t\t// Control: wrong-type JSON body. Routed through convertSchemaError","+\t\t\t// (422), never reaching convertParseError.","+\t\t\tname:        \"json wrong-type body\",","+\t\t\tcontentType: \"application/json\",","+\t\t\tbody:        `{\"age\": \"notanumber\"}`,","+\t\t\twantStatus:  http.StatusUnprocessableEntity,","+\t\t},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tcontentType, body := tc.contentType, tc.body","+\t\t\tif contentType == \"\" {","+\t\t\t\tcontentType, body = multipartBody()","+\t\t\t}","+","+\t\t\treq, err := http.NewRequest(http.MethodPost, \"/upload\", strings.NewReader(body))","+\t\t\trequire.NoError(t, err)","+\t\t\treq.Header.Set(\"Content-Type\", contentType)","+","+\t\t\troute, pathParams, err := router.FindRoute(req)","+\t\t\trequire.NoError(t, err)","+","+\t\t\treqErr := openapi3filter.ValidateRequest(ctx, &openapi3filter.RequestValidationInput{","+\t\t\t\tRequest:    req,","+\t\t\t\tPathParams: pathParams,","+\t\t\t\tRoute:      route,","+\t\t\t\tOptions:    &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc},","+\t\t\t})","+\t\t\trequire.Error(t, reqErr)","+","+\t\t\t// This is what a typical error-rendering middleware calls; it must","+\t\t\t// not panic.","+\t\t\tvar converted error","+\t\t\trequire.NotPanics(t, func() {","+\t\t\t\tconverted = openapi3filter.ConvertErrors(reqErr)","+\t\t\t})","+","+\t\t\tvar validationErr *openapi3filter.ValidationError","+\t\t\trequire.ErrorAs(t, converted, &validationErr)","+\t\t\trequire.Equal(t, tc.wantStatus, validationErr.Status)","+\t\t\trequire.NotEmpty(t, validationErr.Title, \"converted error should carry a meaningful message\")","+\t\t})","+\t}","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"openapi3filter/validation_error_encoder.go","lines":["@@ -117,16 +117,24 @@ func convertParseError(e *RequestError, innerErr *ParseError) *ValidationError {"," \t\t}"," \t} else if innerErr.RootCause() != nil {"," \t\tif rootErr, ok := innerErr.Cause.(*ParseError); ok &&","-\t\t\trootErr.Kind == KindInvalidFormat && e.Parameter.In == \"query\" {","+\t\t\trootErr.Kind == KindInvalidFormat && e.Parameter != nil && e.Parameter.In == \"query\" {"," \t\t\treturn &ValidationError{"," \t\t\t\tStatus: http.StatusBadRequest,"," \t\t\t\tTitle: fmt.Sprintf(\"parameter %q in %s is invalid: %v is %s\","," \t\t\t\t\te.Parameter.Name, e.Parameter.In, rootErr.Value, rootErr.Reason),"," \t\t\t}"," \t\t}","+\t\t// For body parse errors (e.Parameter == nil) the outer ParseError's","+\t\t// Reason is often empty, e.g. the multipart decoder wraps a part's","+\t\t// *ParseError without setting one. Fall back to the full error text so","+\t\t// the response still carries a meaningful message.","+\t\ttitle := innerErr.Reason","+\t\tif title == \"\" {","+\t\t\ttitle = innerErr.Error()","+\t\t}"," \t\treturn &ValidationError{"," \t\t\tStatus: http.StatusBadRequest,","-\t\t\tTitle:  innerErr.Reason,","+\t\t\tTitle:  title,"," \t\t}"," \t}"," \treturn nil",""],"additions":10,"deletions":2,"truncated":false}],"additions":149,"deletions":2,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-08-22T08:18:24.988881+00:00"}