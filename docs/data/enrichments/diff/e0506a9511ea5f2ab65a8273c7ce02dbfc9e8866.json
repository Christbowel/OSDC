next to this file are the script modules of the actions:","- * `post_type_supports` for the actions of every post type, `wp_block` for","- * the actions of patterns, and `wp_template_part` for the actions of","- * template parts. Each action has a folder named after its id, whose","- * `action.php` returns the serializable part of the action, and whose","- * `action.tsx` holds its JavaScript parts.","+ * `post_type_supports` for the actions of every post type, `page` for the","+ * actions of pages, `wp_block` for the actions of patterns, and","+ * `wp_template_part` for the actions of template parts. Each action has a","+ * folder named after its id, whose `action.php` returns the serializable","+ * part of the action, and whose `action.tsx` holds its JavaScript parts.","  *","  * @package WordPress","  */","@@ -30,6 +30,9 @@","  * - `restore`, `reset-post`, `delete-post`, `move-to-trash`, and","  *   `permanently-delete`, for every post type: each one checks which posts","  *   it applies to.","+ * - `set-as-homepage` and `set-as-posts-page`, for pages, when the user can","+ *   manage the site options and the theme has no `front-page` template:","+ *   each one applies to the pages with its `action-*` REST link.","  *","  * The actions are registered in that order, which is the order they are","  * shown in, each with the script module of its folder. The registry is built","@@ -57,6 +60,13 @@ function register_core_entity_actions() {"," \t\t$name       = $post_type->name;"," \t\t$can_create = current_user_can( $post_type->cap->create_posts );"," ","+\t\t// The homepage and the posts page are site settings. When the theme","+\t\t// has a `front-page` template, the front page cannot be changed, see","+\t\t// https://developer.wordpress.org/themes/basics/template-hierarchy/.","+\t\t$can_set_homepage = 'page' === $name &&","+\t\t\tcurrent_user_can( 'manage_options' ) &&","+\t\t\tempty( get_block_templates( array( 'slug__in' => array( 'front-page' ) ) ) );","+"," \t\t// The actions of the post type, keyed by the folder of their script"," \t\t// module and their id, in the order they are shown."," \t\t$applies = array(","@@ -73,6 +83,8 @@ function register_core_entity_actions() {"," \t\t\t'post_type_supports/delete-post'           => true,"," \t\t\t'post_type_supports/move-to-trash'         => true,"," \t\t\t'post_type_supports/permanently-delete'    => true,","+\t\t\t'page/set-as-homepage'                     => $can_set_homepage,","+\t\t\t'page/set-as-posts-page'                   => $can_set_homepage,"," \t\t);"," "," \t\tforeach ( array_keys( array_filter( $applies ) ) as $key ) {"],"additions":17,"deletions":5,"truncated":false},{"path":"packages/core-actions/src/page/index.ts","lines":["@@ -0,0 +1,18 @@","+/**","+ * Script module of the `page` collection: `@wordpress/core-actions/page`.","+ *","+ * The actions pages have on top of the defaults. Its default export maps the","+ * id of each action to its JavaScript parts, which the client merges into the","+ * action the server registers, see the `post_type_supports` module.","+ */","+","+import type { ActionScriptParts } from '../shared/types';","+import setAsHomepage from './set-as-homepage/action';","+import setAsPostsPage from './set-as-posts-page/action';","+","+const actions = {","+\t'set-as-homepage': setAsHomepage,","+\t'set-as-posts-page': setAsPostsPage,","+} satisfies Record< string, ActionScriptParts< any > >;","+","+export default actions;"],"additions":18,"deletions":0,"truncated":false},{"path":"packages/core-actions/src/page/set-as-homepage/action.php","lines":["@@ -0,0 +1,15 @@","+<?php","+/**","+ * The \"Set as homepage…\" action, for pages: it applies to the pages with the","+ * `action-set-homepage` REST link, the published pages that are neither the","+ * homepage nor the posts page. Its JavaScript parts (`isEligible` and","+ * `RenderModal`) are in `action.tsx`, next to this file.","+ *","+ * @package WordPress","+ */","+","+return array(","+\t'label'             => __( 'Set as homepage…', 'gutenberg' ),","+\t'modalHeader'       => __( 'Set as homepage', 'gutenberg' ),","+\t'modalFocusOnMount' => 'firstContentElement',","+);"],"additions":15,"deletions":0,"truncated":false},{"path":"packages/core-actions/src/page/set-as-homepage/action.tsx","lines":["@@ -0,0 +1,148 @@","+import { __, sprintf } from '@wordpress/i18n';","+import {","+\tButton,","+\t__experimentalText as WCText,","+\t__experimentalHStack as HStack,","+\t__experimentalVStack as VStack,","+} from '@wordpress/components';","+import { useDispatch, useRegistry, useSelect } from '@wordpress/data';","+import { store as coreStore } from '@wordpress/core-data';","+import type { Settings } from '@wordpress/core-data';","+import { store as noticesStore } from '@wordpress/notices';","+import { getItemTitle } from '../../shared/utils';","+import { hasActionLink } from '../../shared/has-action-link';","+import { refetchPages } from '../../shared/refetch-pages';","+import type {","+\tBasePost,","+\tCoreDataError,","+\tActionScriptParts,","+} from '../../shared/types';","+","+const setAsHomepage: ActionScriptParts< BasePost > = {","+\tisEligible( post ) {","+\t\t// The server adds the link to the published pages the user can set as","+\t\t// the homepage, which are neither the homepage nor the posts page. The","+\t\t// status is checked too, as the editor shows the actions of the edited","+\t\t// page.","+\t\treturn (","+\t\t\tpost.status === 'publish' &&","+\t\t\thasActionLink( post, 'wp:action-set-homepage' )","+\t\t);","+\t},","+\tRenderModal: ( { items, closeModal } ) => {","+\t\tconst [ item ] = items;","+\t\tconst pageTitle = getItemTitle( item, '' );","+\t\tconst { showOnFront, pageOnFront, currentHomePage, isSaving } =","+\t\t\tuseSelect( ( select ) => {","+\t\t\t\tconst { getEntityRecord, isSavingEntityRecord } =","+\t\t\t\t\tselect( coreStore );","+\t\t\t\tconst siteSettings = getEntityRecord(","+\t\t\t\t\t'root',","+\t\t\t\t\t'site'","+\t\t\t\t) as Partial< Settings >;","+\t\t\t\tconst currentHomePageItem = getEntityRecord(","+\t\t\t\t\t'postType',","+\t\t\t\t\t'page',","+\t\t\t\t\tsiteSettings?.page_on_front","+\t\t\t\t) as BasePost | undefined;","+\t\t\t\treturn {","+\t\t\t\t\tshowOnFront: siteSettings?.show_on_front,","+\t\t\t\t\tpageOnFront: siteSettings?.page_on_front,","+\t\t\t\t\tcurrentHomePage: currentHomePageItem,","+\t\t\t\t\tisSaving: isSavingEntityRecord( 'root', 'site' ),","+\t\t\t\t};","+\t\t\t}, [] );","+","+\t\tconst registry = useRegistry();","+\t\tconst { saveEntityRecord } = useDispatch( coreStore );","+\t\tconst { createSuccessNotice, createErrorNotice } =","+\t\t\tuseDispatch( noticesStore );","+","+\t\tasync function onSetPageAsHomepage( event: React.FormEvent ) {","+\t\t\tevent.preventDefault();","+","+\t\t\ttry {","+\t\t\t\tawait saveEntityRecord( 'root', 'site', {","+\t\t\t\t\tpage_on_front: item.id,","+\t\t\t\t\tshow_on_front: 'page',","+\t\t\t\t} );","+","+\t\t\t\t// The action links of the pages depend on the homepage, so","+\t\t\t\t// the new homepage and the previous one are requested again.","+\t\t\t\tawait refetchPages( registry, [ item.id, pageOnFront ] );","+","+\t\t\t\tcreateSuccessNotice( __( 'Homepage updated.' ), {","+\t\t\t\t\ttype: 'snackbar',","+\t\t\t\t} );","+\t\t\t} catch ( error ) {","+\t\t\t\tconst typedError = error as CoreDataError;","+\t\t\t\tconst errorMessage =","+\t\t\t\t\ttypedError.message && typedError.code !== 'unknown_error'","+\t\t\t\t\t\t? typedError.message","+\t\t\t\t\t\t: __( 'An error occurred while setting the homepage.' );","+\t\t\t\tcreateErrorNotice( errorMessage, { type: 'snackbar' } );","+\t\t\t} finally {","+\t\t\t\tcloseModal?.();","+\t\t\t}","+\t\t}","+","+\t\tlet modalWarning = '';","+\t\tif ( 'posts' === showOnFront ) {","+\t\t\tmodalWarning = __(","+\t\t\t\t'This will replace the current homepage which is set to display latest posts.'","+\t\t\t);","+\t\t} else if ( currentHomePage ) {","+\t\t\tmodalWarning = sprintf(","+\t\t\t\t// translators: %s: title of the current home page.","+\t\t\t\t__( 'This will replace the current homepage: \"%s\"' ),","+\t\t\t\tgetItemTitle( currentHomePage, '' )","+\t\t\t);","+\t\t}","+","+\t\tconst modalText = sprintf(","+\t\t\t// translators: %1$s: title of the page to be set as the homepage, %2$s: homepage replacement warning message.","+\t\t\t__( 'Set \"%1$s\" as the site homepage? %2$s' ),","+\t\t\tpageTitle,","+\t\t\tmodalWarning","+\t\t).trim();","+","+\t\t// translators: Button label to confirm setting the specified page as the homepage.","+\t\tconst modalButtonLabel = __( 'Set homepage' );","+","+\t\treturn (","+\t\t\t<form onSubmit={ onSetPageAsHomepage }>","+\t\t\t\t<VStack spacing=\"5\">","+\t\t\t\t\t<WCText>{ modalText }</WCText>","+\t\t\t\t\t<HStack justify=\"right\">","+\t\t\t\t\t\t<Button","+\t\t\t\t\t\t\t__next40pxDefaultSize","+\t\t\t\t\t\t\tvariant=\"tertiary\"","+\t\t\t\t\t\t\tonClick={ () => {","+\t\t\t\t\t\t\t\tcloseModal?.();","+\t\t\t\t\t\t\t} }","+\t\t\t\t\t\t\tdisabled={ isSaving }","+\t\t\t\t\t\t\taccessibleWhenDisabled","+\t\t\t\t\t\t>","+\t\t\t\t\t\t\t{ __( 'Cancel' ) }","+\t\t\t\t\t\t</Button>","+\t\t\t\t\t\t<Button","+\t\t\t\t\t\t\t__next40pxDefaultSize","+\t\t\t\t\t\t\tvariant=\"primary\"","+\t\t\t\t\t\t\ttype=\"submit\"","+\t\t\t\t\t\t\tdisabled={ isSaving }","+\t\t\t\t\t\t\taccessibleWhenDisabled","+\t\t\t\t\t\t>","+\t\t\t\t\t\t\t{ modalButtonLabel }","+\t\t\t\t\t\t</Button>","+\t\t\t\t\t</HStack>","+\t\t\t\t</VStack>","+\t\t\t</form>","+\t\t);","+\t},","+};","+","+/**","+ * The JavaScript parts of the action setting a page as the homepage; its data","+ * is in `action.php`.","+ */","+export default setAsHomepage;"],"additions":148,"deletions":0,"truncated":false},{"path":"packages/core-actions/src/page/set-as-posts-page/action.php","lines":["@@ -0,0 +1,15 @@","+<?php","+/**","+ * The \"Set as posts page…\" action, for pages: it applies to the pages with","+ * the `action-set-posts-page` REST link, the published pages that are neither","+ * t