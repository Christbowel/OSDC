{"id":"484082c8ea945ad3aeab29de60585de801daa6fb","axis":"silent","repo":"pnpm/pnpm","sha":"484082c8ea945ad3aeab29de60585de801daa6fb","parsed":{"files":[{"path":".changeset/hoisted-nested-project-shadowing.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.linking.real-hoist\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+Fixed `nodeLinker: hoisted` installs in a workspace where the directory of one project is inside the directory of another. A dependency of the inner project could resolve to the version in the outer project's `node_modules`. pnpm now keeps the inner project's dependency in its own `node_modules` when the outer project holds another version."],"additions":7,"deletions":0,"truncated":false},{"path":".config/pnpm/patches/@yarnpkg__nm@4.1.1.patch","lines":["@@ -1,5 +1,5 @@"," diff --git a/lib/hoist.js b/lib/hoist.js","-index 3546ae66deafeca55614dc19a22a61a1cf860af8..a59f882bbba4f8a8de6b072129db26f62a7f3cb9 100644","+index 3546ae66deafeca55614dc19a22a61a1cf860af8..b4469ec7297674ff82468c62e890700c46eb8682 100644"," --- a/lib/hoist.js"," +++ b/lib/hoist.js"," @@ -327,6 +327,59 @@ const hasUnhoistedDependencies = (node) => {","@@ -80,3 +80,32 @@ index 3546ae66deafeca55614dc19a22a61a1cf860af8..a59f882bbba4f8a8de6b072129db26f6","          return { isHoistable: Hoistable.DEPENDS, dependsOn, reason };","      }","      else {","+@@ -452,6 +505,10 @@ const hoistGraph = (tree, rootNodePath, rootNodePathLocators, usedDependencies,","+     const seenNodes = new Set();","+     let anotherRoundNeeded = false;","+     let isGraphChanged = false;","++    // Only the top root takes what a project nested in another project depends on:","++    // the enclosing project's node_modules is not on the path of the nested project's scripts","++    const isTopRoot = rootNodePath.length === 1;","++    const isClosed = (node) => node.isHoistBorder || (!isTopRoot && node.dependencyKind === HoisterDependencyKind.WORKSPACE);","+     const hoistNodeDependencies = (nodePath, locatorPath, aliasedLocatorPath, parentNode, newNodes) => {","+         if (seenNodes.has(parentNode))","+             return;","+@@ -535,7 +592,7 @@ const hoistGraph = (tree, rootNodePath, rootNodePathLocators, usedDependencies,","+                 const hoistableIdent = hoistIdents.get(node.name);","+                 if ((hoistableIdent === node.ident || !parentNode.reasons.has(node.name)) && hoistInfo.isHoistable !== Hoistable.YES)","+                     parentNode.reasons.set(node.name, hoistInfo.reason);","+-                if (!node.isHoistBorder && nextAliasedLocatorPath.indexOf(getAliasedLocator(node)) < 0) {","++                if (!isClosed(node) && nextAliasedLocatorPath.indexOf(getAliasedLocator(node)) < 0) {","+                     seenNodes.add(parentNode);","+                     const decoupledNode = decoupleGraphNode(parentNode, node);","+                     hoistNodeDependencies([...nodePath, parentNode], nextLocatorPath, nextAliasedLocatorPath, decoupledNode, nextNewNodes);","+@@ -551,7 +608,7 @@ const hoistGraph = (tree, rootNodePath, rootNodePathLocators, usedDependencies,","+         newNodes = nextNewNodes;","+         nextNewNodes = new Set();","+         for (const dep of newNodes) {","+-            if (dep.locator === rootNode.locator || dep.isHoistBorder)","++            if (dep.locator === rootNode.locator || isClosed(dep))","+                 continue;","+             const decoupledDependency = decoupleGraphNode(rootNode, dep);","+             hoistNodeDependencies([], Array.from(rootNodePathLocators), aliasedRootNodePathLocators, decoupledDependency, nextNewNodes);"],"additions":30,"deletions":1,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -1043,7 +1043,7 @@ snapshots:"," \t\t},"," \t\t\"patchedDependencies\": {"," \t\t\t\"@tybys/wasm-util@0.10.5\": \"b4720f25df1fb0342d181651d5be567d5239215aaca02dd8bbedf8d541d5bb4e\",","-\t\t\t\"@yarnpkg/nm@4.1.1\": \"4aa6174589c5d2a07e0283c8383af9355811fedc7dac08f3528afb04b31210be\",","+\t\t\t\"@yarnpkg/nm@4.1.1\": \"9fdb45a4fcfb6f6058b74da3318c5a6636270c61a316efe8d2289cad53721ca0\","," \t\t\t\"@yarnpkg/pnp@4.1.7\": \"5679b75f737d6a035d80ca67056cd14f6c4e45a200f902fe8a992128702605a2\","," \t\t\t\"deepmerge@4.3.1\": \"6241e75cd0ebdeefbe93564d0f9a0da153bc6608add12970bd3c390910e7e4f4\","," \t\t\t\"glob@11.1.0\": \"aa3a98d243db59427689bada80d8824e3e8b7cff11bf6007c528d70324791dd3\","],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hoisted_node_linker.rs","lines":["@@ -1289,6 +1289,8 @@ mod local_symlinks;"," "," mod modules_dir;"," ","+mod nested_projects;","+"," mod peer_bindings;"," "," mod repeat_install;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hoisted_node_linker/nested_projects.rs","lines":["@@ -0,0 +1,86 @@","+use super::{","+    AddMockedRegistry,","+    CommandTempCwd,","+    fs,","+    fs_remove_dir_all,","+    pacquet_at,","+    read_pkg_version,","+    write_workspace_yaml,","+};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use std::path::Path;","+","+/// `enclosing` keeps `ms@2.0.0`, because the other projects put `ms@2.1.3`","+/// at the root. `enclosing/nested` depends on `ms@2.1.3`.","+fn write_workspace_with_a_nested_project(workspace: &Path) {","+    write_workspace_yaml(","+        workspace,","+        \"nodeLinker: hoisted\\npackages:\\n  - enclosing\\n  - enclosing/nested\\n  - 'other-*'\\n\",","+    );","+    let root_manifest =","+        serde_json::json!({ \"name\": \"ws-root\", \"version\": \"0.0.0\", \"private\": true });","+    fs::write(workspace.join(\"package.json\"), root_manifest.to_string())","+        .expect(\"write root package.json\");","+    let projects = [","+        (\"enclosing\", \"2.0.0\"),","+        (\"enclosing/nested\", \"2.1.3\"),","+        (\"other-1\", \"2.1.3\"),","+        (\"other-2\", \"2.1.3\"),","+    ];","+    for (dir, ms_version) in projects {","+        fs::create_dir_all(workspace.join(dir)).expect(\"create the project directory\");","+        let manifest = serde_json::json!({","+            \"name\": dir.replace('/', \"-\"),","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"ms\": ms_version },","+        });","+        fs::write(workspace.join(dir).join(\"package.json\"), manifest.to_string())","+            .expect(\"write the project manifest\");","+    }","+}","+","+/// From `enclosing/nested`, Node.js finds `enclosing/node_modules` before","+/// the root's, so the nested project needs a copy of its own.","+fn assert_each_project_resolves_its_ms(workspace: &Path) {","+    assert_eq!(read_pkg_version(workspace, \"node_modules/ms\"), \"2.1.3\");","+    assert_eq!(read_pkg_version(workspace, \"enclosing/node_modules/ms\"), \"2.0.0\");","+    assert_eq!(read_pkg_version(workspace, \"enclosing/nested/node_modules/ms\"), \"2.1.3\");","+    assert!(!workspace.join(\"other-1/node_modules/ms\").exists());","+}","+","+#[test]","+fn a_nested_project_keeps_the_dependency_the_enclosing_project_shadows() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace_with_a_nested_project(&workspace);","+","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert_each_project_resolves_its_ms(&workspace);","+","+    pacquet_at(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert_each_project_resolves_its_ms(&workspace);","+","+    for modules_dir in [\"node_modules\", \"enclosing/node_modules\", \"enclosing/nested/node_modules\"] {","+        fs_remove_dir_all(&workspace.join(modules_dir));","+    }","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+    assert_each_project_resolves_its_ms(&workspace);","+","+    drop((root, mock_instance));","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"pnpm/crates/real-hoist/src/engine/hoist_graph.rs","lines":["@@ -3,7 +3,10 @@"," "," use super::{","     WorkNode,","-    graph::decouple,","+    graph::{","+        decouple,","+        is_workspace,","+    },","     hoist_info::{","         Hoistable,","         RootContext,","@@ -46,9 +49,21 @@ struct Pass<'pass> {","     aliased_path: Vec<Rc<str>>,","     /// Nodes hoisted to the root in this wave, walked in the next one.","     next_wave: IndexSet<RcByPtr<WorkNode>>,","+    /// Whether the hoisting root is the top of the tree. Only the top","+    /// takes what a project nested in another project depends on: the","+    /// enclosing project's `node_modules` is not on the path of the nested","+    /// project's scripts.","+    is_top_root: bool,","     outcome: PassOutcome,"," }"," ","+impl Pass<'_> {","+    /// Whether nothing below `node` may move to the hoisting root.","+    fn is_closed(&self, node: &WorkNode) -> bool {","+        node.is_hoist_border.get() || (!self.is_top_root && is_workspace(node))","+    }","+}","+"," /// Upstream's `hoistGraph`. `root_path` runs from the top of the tree to"," /// the hoisting root, which is its last entry."," pub(super) fn hoist_graph(ctx: &RootContext<'_>, root_path: &[Rc<WorkNode>]) -> PassOutcome {","@@ -64,12 +79,13 @@ pub(super) fn hoist_graph(ctx: &RootContext<'_>, root_path: &[Rc<WorkNode>]) ->","             .into_iter()","             .map(RcByPtr)","             .collect(),","+        is_top_root: root_path.len() == 1,","         outcome: PassOutcome::default(),","     };","     while !pass.next_wave.is_empty() {","         let wave = std::mem::take(&mut pass.next_wave);","         for dep in wave {","-            if dep.input.ident == ctx.root.input.ident || dep.is_hoist_border.get() {","+            if dep.input.ident == ctx.root.input.ident || pass.is_closed(&dep) {","                 continue;","             }","             let decoupled = decouple(ctx.root, &dep.0, ctx.arena);","@@ -93,7 +109,7 @@ fn hoist_node_dependencies(pass: &mut Pass<'_>, parent: &Rc<WorkNode>) {","     for child in staying_children(parent, children, &unhoistable) {","         let stays = unhoistable.contains(&RcByPtr(Rc::clone(&child)));","         if !stays","-            || child.is_hoist_border.get()","+            || pass.is_closed(&child)","             || pass.aliased_path.contains(&child.input.aliased_locator)","         {","             continue;"],"additions":19,"deletions":3,"truncated":false},{"path":"pnpm/crates/real-hoist/src/lib.rs","lines":["@@ -300,9 +300,48 @@ pub fn hoist(lockfile: &Lockfile, opts: &HoistOpts) -> Result<HoisterResult, Hoi","             .retain(|dep| !opts.external_dependencies.contains(&dep.name));","     }"," ","+    lift_nested_projects(&result);","     Ok(result)"," }"," ","+/// Make every project a child of the root, which is where the callers of","+/// [`hoist`] look for them. The hoister leaves a project under the project","+/// whose directory holds it (see [`build_tree`]).","+fn lift_nested_projects(root: &HoisterResult) {","+    let mut pending: Vec<Rc<HoisterResult>> = project_children(root);","+    while let Some(project) = pending.pop() {","+        let nested = project_children(&project);","+        project.dependencies","+            .borrow_mut()","+            .retain(|dep| !is_project(dep));","+        root.dependencies","+            .borrow_mut()","+            .extend(","+                nested","+                    .iter()","+                    .map(Rc::clone)","+                    .map(RcByPtr),","+            );","+        pending.extend(nested);","+    }","+}","+","+fn project_children(node: &HoisterResult) -> Vec<Rc<HoisterResult>> {","+    node.dependencies","+        .borrow()","+        .iter()","+        .filter(|dep| is_project(dep))","+        .map(|dep| Rc::clone(&dep.0))","+        .collect()","+}","+","+fn is_project(node: &HoisterResult) -> bool {","+    node.references","+        .borrow()","+        .iter()","+        .any(|reference| reference.starts_with(\"workspace:\"))","+}","+"," /// The layout, and the input tree of the pass that gave it. See [`repair`]:"," /// each pass hands the peers the layout failed to resolve to the next as"," /// regular dependencies. The set only grows, so the loop ends.","@@ -352,22 +391,34 @@ fn build_tree(","         root_children.insert(RcByPtr(external_placeholder(dep)));","     }"," ","-    // Non-root importers (workspace projects) become children of","-    // the virtual `.` root, unconditionally, matching pnpm v11's","-    // `hoist()`, which attaches every importer regardless of any","-    // knob. The hoister sees the whole workspace as one tree, which","-    // is what enables cross-project dedupe of conflicting versions","-    // and gives the layout `node_modules/<dep>` →","-    // `<lockfile_dir>/<importer>/node_modules/<dep>` shape the","-    // hoisted linker expects. In pnpm, `hoist-workspace-packages`","-    // only controls whether the workspace *packages themselves* get","-    // name-links in the root's hoisted modules dir (v11's","-    // `hoistedWorkspacePackages` in the headless linker); it never","-    // decides tree membership.","+    // Non-root importers (workspace projects) join the tree","+    // unconditionally, matching pnpm v11's `hoist()`, which attaches","+    // every importer regardless of any knob. The hoister sees the whole","+    // workspace as one tree, which is what enables cross-project dedupe","+    // of conflicting versions and gives the layout `node_modules/<dep>` →","+    // `<lockfile_dir>/<importer>/node_modules/<dep>` shape the hoisted","+    // linker expects. In pnpm, `hoist-workspace-packages` only controls","+    // whether the workspace *packages themselves* get name-links in the","+    // root's hoisted modules dir (v11's `hoistedWorkspacePackages` in the","+    // headless linker); it never decides tree membership.","+    //","+    // A project is a child of the project whose directory holds it, and","+    // of the `.` root otherwise: Node.js walks up through the enclosing","+    // project's `node_modules` before it reaches the root's. The ids come","+    // sorted, so an enclosing project is in `projects` before the ones","+    // it holds.","+    let mut projects: HashMap<&str, Rc<HoisterTree>> = HashMap::new();","     for (importer_id, importer) in sorted_non_root_importers(lockfile) {","         let mut importer_children: IndexSet<RcByPtr<HoisterTree>> = IndexSet::new();","         collect_importer_deps(importer, lockfile, opts, &mut cache, &mut importer_children)?;","-        root_children.insert(RcByPtr(importer_node(importer_id, importer_children)));","+        let node = importer_node(importer_id, importer_children);","+        match enclosing_project(importer_id, &projects) {","+            Some(enclosing) => enclosing.dependencies","+                .borrow_mut()","+                .insert(RcByPtr(Rc::clone(&node))),","+            None => root_children.insert(RcByPtr(Rc::clone(&node))),","+        };","+        projects.insert(importer_id, node);","     }"," ","     let root_node = Rc::new(HoisterTree {","@@ -396,6 +447,7 @@ use tree::{","     RegularPeers,","     TreeCache,","     collect_importer_deps,","+    enclosing_project,","     external_placeholder,","     importer_node,","     peers::BoundPeersByKey,"],"additions":65,"deletions":13,"truncated":false},{"path":"pnpm/crates/real-hoist/src/tests.rs","lines":["@@ -194,6 +194,8 @@ mod peer_bindings;"," "," mod peer_layout;"," ","+mod nested_projects;","+"," mod generated;"," "," mod determinism;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/real-hoist/src/tests/nested_projects.rs","lines":["@@ -0,0 +1,147 @@","+//! A project whose directory lies inside another project's. Node.js walks","+//! up from it through the enclosing project's `node_modules` before the","+//! root's, so what the enclosing project holds shadows the root.","+","+use super::{","+    HoistOpts,","+    HoisterResult,","+    Lockfile,","+    Rc,","+    assert_eq,","+    child_of,","+    hoist,","+};","+use std::{","+    collections::BTreeSet,","+    path::Path,","+};","+","+fn hoist_lockfile(yaml: &str) -> HoisterResult {","+    hoist_lockfile_with(yaml, &HoistOpts::default())","+}","+","+fn hoist_lockfile_with(yaml: &str, opts: &HoistOpts) -> HoisterResult {","+    let lockfile = Lockfile::parse(yaml, Path::new(\"pnpm-lock.yaml\"))","+        .expect(\"parse the lockfile\")","+        .expect(\"the lockfile is not empty\");","+    hoist(&lockfile, opts).expect(\"hoist should succeed\")","+}","+","+/// The names in `project`'s `node_modules`, each with the snapshot key the","+/// directory serves first.","+fn held_by(result: &HoisterResult, project: &str) -> Vec<String> {","+    let project: Rc<HoisterResult> = child_of(result, project);","+    let mut held: Vec<String> = project.dependencies","+        .borrow()","+        .iter()","+        .map(|dep| {","+            dep.references","+                .borrow()","+                .first()","+                .cloned()","+                .unwrap_or_default()","+        })","+        .collect();","+    held.sort_unstable();","+    held","+}","+","+/// `a` keeps `x@1` because the root holds `x@2`. From `a/b`, `x` then","+/// resolves to `a/node_modules/x`, so the `x@2` that `a/b` and its `y@1`","+/// depend on cannot be the root's.","+#[test]","+fn a_nested_project_keeps_what_the_enclosing_project_shadows() {","+    let result = hoist_lockfile(","+        \"lockfileVersion: '9.0'","+importers:","+  .: {}","+  a:","+    dependencies:","+      x: {specifier: 1.0.0, version: 1.0.0}","+  a/b:","+    dependencies:","+      x: {specifier: 2.0.0, version: 2.0.0}","+      y: {specifier: 1.0.0, version: 1.0.0}","+  c:","+    dependencies:","+      x: {specifier: 2.0.0, version: 2.0.0}","+      y: {specifier: 2.0.0, version: 2.0.0}","+  d:","+    dependencies:","+      y: {specifier: 2.0.0, version: 2.0.0}","+packages:","+  x@1.0.0: {resolution: {integrity: sha512-a}}","+  x@2.0.0: {resolution: {integrity: sha512-b}}","+  y@1.0.0: {resolution: {integrity: sha512-c}}","+  y@2.0.0: {resolution: {integrity: sha512-d}}","+snapshots:","+  x@1.0.0: {}","+  x@2.0.0: {}","+  y@1.0.0:","+    dependencies: {x: 2.0.0}","+  y@2.0.0: {}","+\",","+    );","+    assert_eq!(held_by(&result, \"a\"), [\"x@1.0.0\"], \"{result:#?}\");","+    assert_eq!(held_by(&result, \"a%2Fb\"), [\"x@2.0.0\", \"y@1.0.0\"], \"{result:#?}\");","+    assert!(child_of(&child_of(&result, \"a%2Fb\"), \"y\").dependencies.borrow().is_empty());","+}","+","+/// The root holds `z@1`, so the `z@2` of `a/b` stays below it. It stays in","+/// `a/b` and does not move to `a`, whose `node_modules/.bin` is not on the","+/// path of the scripts of `a/b`.","+#[test]","+fn a_nested_project_s_dependency_does_not_move_to_the_enclosing_project() {","+    let result = hoist_lockfile(","+        \"lockfileVersion: '9.0'","+importers:","+  .:","+    dependencies:","+      z: {specifier: 1.0.0, version: 1.0.0}","+  a: {}","+  a/b:","+    dependencies:","+      z: {specifier: 2.0.0, version: 2.0.0}","+packages:","+  z@1.0.0: {resolution: {integrity: sha512-a}}","+  z@2.0.0: {resolution: {integrity: sha512-b}}","+snapshots:","+  z@1.0.0: {}","+  z@2.0.0: {}","+\",","+    );","+    assert_eq!(held_by(&result, \"a\"), Vec::<String>::new(), \"{result:#?}\");","+    assert_eq!(held_by(&result, \"a%2Fb\"), [\"z@2.0.0\"], \"{result:#?}\");","+}","+","+/// The `workspaces` hoisting limit names every project as a border of the","+/// root. `a/b` is not a child of the root, and keeps its dependencies all","+/// the same.","+#[test]","+fn a_nested_project_keeps_its_dependencies_under_the_workspaces_limit() {","+    let mut opts = HoistOpts::default();","+    let projects = BTreeSet::from([\"a\".to_string(), \"a%2Fb\".to_string()]);","+    opts.hoisting_limits.insert(\".@\".to_string(), projects);","+    let result = hoist_lockfile_with(","+        \"lockfileVersion: '9.0'","+importers:","+  .: {}","+  a:","+    dependencies:","+      x: {specifier: 1.0.0, version: 1.0.0}","+  a/b:","+    dependencies:","+      y: {specifier: 1.0.0, version: 1.0.0}","+packages:","+  x@1.0.0: {resolution: {integrity: sha512-a}}","+  y@1.0.0: {resolution: {integrity: sha512-b}}","+snapshots:","+  x@1.0.0: {}","+  y@1.0.0: {}","+\",","+        &opts,","+    );","+    assert_eq!(held_by(&result, \"a\"), [\"x@1.0.0\"], \"{result:#?}\");","+    assert_eq!(held_by(&result, \"a%2Fb\"), [\"y@1.0.0\"], \"{result:#?}\");","+    assert_eq!(result.dependencies.borrow().len(), 2, \"{result:#?}\");","+}"],"additions":147,"deletions":0,"truncated":false},{"path":"pnpm/crates/real-hoist/src/tree.rs","lines":["@@ -83,6 +83,17 @@ pub(super) fn sorted_non_root_importers(lockfile: &Lockfile) -> Vec<(&String, &P","     non_root"," }"," ","+/// The project whose directory holds the directory of `importer_id`, when","+/// one of `projects` does: the nearest one.","+pub(super) fn enclosing_project<'projects>(","+    importer_id: &str,","+    projects: &'projects HashMap<&str, Rc<HoisterTree>>,","+) -> Option<&'projects Rc<HoisterTree>> {","+    importer_id","+        .rmatch_indices('/')","+        .find_map(|(separator, _)| projects.get(&importer_id[..separator]))","+}","+"," pub(super) fn importer_node(","     importer_id: &str,","     children: IndexSet<RcByPtr<HoisterTree>>,"],"additions":11,"deletions":0,"truncated":false},{"path":"pnpm11/installing/deps-installer/test/hoistedNodeLinker/install.ts","lines":["@@ -368,6 +368,40 @@ test('bins of a nested package are removed when the package is deduped into the","   expect(readBinEntries('.')).not.toHaveLength(0)"," })"," ","+test('a project nested in another project keeps the dependency that the enclosing project shadows', async () => {","+  const dependOn = (name: string, version: string) => ({","+    name,","+    version: '1.0.0',","+    dependencies: { '@pnpm.e2e/hello-world-js-bin': version },","+  })","+  const projects = [","+    { location: 'enclosing', package: dependOn('enclosing', '0.0.0') },","+    { location: 'enclosing/nested', package: dependOn('nested', '1.0.0') },","+    { location: 'other-1', package: dependOn('other-1', '1.0.0') },","+    { location: 'other-2', package: dependOn('other-2', '1.0.0') },","+  ]","+  preparePackages(projects)","+  await mutateModules(projects.map(({ location }) => ({","+    mutation: 'install' as const,","+    rootDir: path.resolve(location) as ProjectRootDir,","+  })), testDefaults({","+    allProjects: projects.map(({ location, package: manifest }) => ({","+      buildIndex: 0,","+      manifest,","+      rootDir: path.resolve(location) as ProjectRootDir,","+    })),","+    nodeLinker: 'hoisted',","+  }))","+","+  const installedVersion = (modulesDir: string) =>","+    loadJsonFileSync<{ version: string }>(path.join(modulesDir, '@pnpm.e2e/hello-world-js-bin/package.json')).version","+  expect(installedVersion('node_modules')).toBe('1.0.0')","+  expect(installedVersion('enclosing/node_modules')).toBe('0.0.0')","+  // Node.js finds enclosing/node_modules before the root's from the nested project.","+  expect(installedVersion('enclosing/nested/node_modules')).toBe('1.0.0')","+  expect(fs.readdirSync('enclosing/nested/node_modules/.bin')).toContain('hello-world-js-bin')","+})","+"," test('a project dependency that is not hoisted goes in the project modules directory set by modulesDir', async () => {","   const project1Manifest = {","     name: 'project-1',"],"additions":34,"deletions":0,"truncated":false},{"path":"pnpm11/installing/linking/real-hoist/src/index.ts","lines":["@@ -152,9 +152,16 @@ export function hoist (","   }","   const externalDependencies = toExternalDependencySet(opts?.externalDependencies)","   const rootNode = buildRootHoisterTree(lockfile, ctx, externalDependencies)","+  const projects = new Map<string, HoisterTree>()","   for (const [importerId, importer] of Object.entries(lockfile.importers)) {","     if (importerId === '.') continue","-    rootNode.dependencies.add(buildImporterHoisterTree(importerId, importer, ctx))","+    projects.set(importerId, buildImporterHoisterTree(importerId, importer, ctx))","+  }","+  // A project is a child of the project whose directory holds it: Node.js","+  // walks up through the enclosing project's node_modules before the root's.","+  for (const [importerId, project] of projects) {","+    const enclosingProject = findEnclosingProject(importerId, projects) ?? rootNode","+    enclosingProject.dependencies.add(project)","   }"," ","   const hoistingLimits = getHoistingLimits(lockfile, opts?.hoistingLimits)","@@ -162,9 +169,46 @@ export function hoist (","   if (externalDependencies) {","     filterExternalDependencies(hoisterResult, externalDependencies)","   }","+  liftNestedProjects(hoisterResult)","   return hoisterResult"," }"," ","+/** The nearest project whose directory holds the directory of `importerId`. */","+function findEnclosingProject (importerId: string, projects: Map<string, HoisterTree>): HoisterTree | undefined {","+  let separator = importerId.lastIndexOf('/')","+  while (separator !== -1) {","+    const enclosingProject = projects.get(importerId.slice(0, separator))","+    if (enclosingProject != null) return enclosingProject","+    separator = importerId.lastIndexOf('/', separator - 1)","+  }","+  return undefined","+}","+","+/**","+ * Makes every project a child of the root, which is where the callers of","+ * `hoist` look for them. The hoister leaves a project under the project","+ * whose directory holds it.","+ */","+function liftNestedProjects (root: HoisterResult): void {","+  const pending = projectChildren(root)","+  while (pending.length > 0) {","+    const project = pending.pop()!","+    for (const nestedProject of projectChildren(project)) {","+      project.dependencies.delete(nestedProject)","+      root.dependencies.add(nestedProject)","+      pending.push(nestedProject)","+    }","+  }","+}","+","+function projectChildren (node: HoisterResult): HoisterResult[] {","+  return [...node.dependencies].filter(isProject)","+}","+","+function isProject (node: HoisterResult): boolean {","+  return [...node.references].some((reference) => reference.startsWith('workspace:'))","+}","+"," function toExternalDependencySet (","   externalDependencies: Iterable<string> | undefined"," ): Set<string> | undefined {"],"additions":45,"deletions":1,"truncated":false},{"path":"pnpm11/installing/linking/real-hoist/test/index.ts","lines":["@@ -192,6 +192,75 @@ test('getHoistingLimits preserves synthetic root border when root importer is om","   expect(limits!.get('.@')).toStrictEqual(new Set(['packages%2Ffoo']))"," })"," ","+test('hoist keeps in a nested project what the enclosing project shadows', () => {","+  const lockfile: LockfileObject = {","+    lockfileVersion: '9.0',","+    importers: {","+      ['.' as ProjectId]: { specifiers: {} },","+      ['a' as ProjectId]: {","+        dependencies: { x: '1.0.0' },","+        specifiers: { x: '1.0.0' },","+      },","+      ['a/b' as ProjectId]: {","+        dependencies: { x: '2.0.0', y: '1.0.0' },","+        specifiers: { x: '2.0.0', y: '1.0.0' },","+      },","+      ['c' as ProjectId]: {","+        dependencies: { x: '2.0.0', y: '2.0.0' },","+        specifiers: { x: '2.0.0', y: '2.0.0' },","+      },","+      ['d' as ProjectId]: {","+        dependencies: { y: '2.0.0' },","+        specifiers: { y: '2.0.0' },","+      },","+    },","+    packages: {","+      ['x@1.0.0' as DepPath]: { resolution: { integrity: 'sha512-x1' } },","+      ['x@2.0.0' as DepPath]: { resolution: { integrity: 'sha512-x2' } },","+      ['y@1.0.0' as DepPath]: { resolution: { integrity: 'sha512-y1' }, dependencies: { x: '2.0.0' } },","+      ['y@2.0.0' as DepPath]: { resolution: { integrity: 'sha512-y2' } },","+    },","+  }","+","+  const result = hoist(lockfile, { autoInstallPeers: false })","+","+  expect(heldBy(result, 'a')).toStrictEqual(['x@1.0.0'])","+  expect(heldBy(result, 'a%2Fb')).toStrictEqual(['x@2.0.0', 'y@1.0.0'])","+})","+","+test('hoist does not move the dependency of a nested project to the enclosing project', () => {","+  const lockfile: LockfileObject = {","+    lockfileVersion: '9.0',","+    importers: {","+      ['.' as ProjectId]: {","+        dependencies: { z: '1.0.0' },","+        specifiers: { z: '1.0.0' },","+      },","+      ['a' as ProjectId]: { specifiers: {} },","+      ['a/b' as ProjectId]: {","+        dependencies: { z: '2.0.0' },","+        specifiers: { z: '2.0.0' },","+      },","+    },","+    packages: {","+      ['z@1.0.0' as DepPath]: { resolution: { integrity: 'sha512-z1' } },","+      ['z@2.0.0' as DepPath]: { resolution: { integrity: 'sha512-z2' } },","+    },","+  }","+","+  const result = hoist(lockfile, { autoInstallPeers: false })","+","+  expect(heldBy(result, 'a')).toStrictEqual([])","+  expect(heldBy(result, 'a%2Fb')).toStrictEqual(['z@2.0.0'])","+})","+","+/** What the root-level project `name` holds in its node_modules, by first reference. */","+function heldBy (result: HoisterResult, name: string): string[] {","+  const project = [...result.dependencies].find((dependency) => dependency.name === name)","+  if (project == null) throw new Error(`No project ${name} at the root`)","+  return [...project.dependencies].map((dependency) => [...dependency.references][0]).sort()","+}","+"," /**","  * Every dependency a hoisted package finds, walking up from its directory,","  * at another version than its snapshot records.",""],"additions":69,"deletions":0,"truncated":false}],"additions":518,"deletions":19,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-22T16:22:48.220152+00:00"}