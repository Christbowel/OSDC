{"id":"818a55a2c2f49bd4d0667cfb5e3415a8fba84870","axis":"silent","repo":"micronaut-projects/micronaut-core","sha":"818a55a2c2f49bd4d0667cfb5e3415a8fba84870","parsed":{"files":[{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/Holder.java","lines":["@@ -0,0 +1,17 @@","+package io.micronaut.inject.provider.lookuppoint;","+","+import io.micronaut.context.BeanProvider;","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+","+@Singleton","+public class Holder {","+","+    @Inject","+    @Red","+    BeanProvider<RedService> services;","+","+    @Inject","+    @Red","+    Lookup<RedService> lookup;","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/Lookup.java","lines":["@@ -0,0 +1,29 @@","+package io.micronaut.inject.provider.lookuppoint;","+","+import io.micronaut.context.BeanDependencyResolver;","+import io.micronaut.context.BeanRegistration;","+import io.micronaut.context.BeanResolutionContext;","+import io.micronaut.core.type.Argument;","+import io.micronaut.inject.BeanDefinition;","+","+/**","+ * A provider-like object built for the injection point it is injected into, which resolves a dependent on each call","+ * through the resolver of its owner, at the segment it was itself resolved at.","+ *","+ * @param resolver The resolver of the owner","+ * @param segment The segment the lookup was resolved at","+ * @param definition The definition the lookup resolves","+ * @param type The type the lookup resolves the definition as","+ * @param eager A registration resolved while the lookup was built, through the resolution context itself","+ * @param <T> The type","+ */","+public record Lookup<T>(BeanDependencyResolver resolver,","+                        BeanResolutionContext.Segment<?, ?> segment,","+                        BeanDefinition<? extends T> definition,","+                        Argument<T> type,","+                        BeanRegistration<T> eager) {","+","+    public BeanRegistration<T> get() {","+        return resolver.getBeanRegistration(definition, type, segment);","+    }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/LookupDefinition.java","lines":["@@ -0,0 +1,39 @@","+package io.micronaut.inject.provider.lookuppoint;","+","+import io.micronaut.context.BeanContext;","+import io.micronaut.context.BeanDependencyResolver;","+import io.micronaut.context.BeanRegistration;","+import io.micronaut.context.BeanResolutionContext;","+import io.micronaut.context.Qualifier;","+import io.micronaut.core.type.ArgumentCoercible;","+import io.micronaut.core.type.Argument;","+import io.micronaut.inject.BeanDefinition;","+import io.micronaut.inject.InjectionPoint;","+import io.micronaut.inject.provider.AbstractInjectionPointBeanDefinition;","+import org.jspecify.annotations.Nullable;","+","+import java.util.Objects;","+","+public final class LookupDefinition extends AbstractInjectionPointBeanDefinition<Lookup<Object>> {","+","+    @SuppressWarnings({\"unchecked\", \"rawtypes\"})","+    @Override","+    public Class<Lookup<Object>> getBeanType() {","+        return (Class) Lookup.class;","+    }","+","+    @SuppressWarnings(\"unchecked\")","+    @Override","+    protected Lookup<Object> build(BeanResolutionContext resolutionContext,","+                                   BeanContext context,","+                                   @Nullable InjectionPoint<?> injectionPoint) {","+        BeanResolutionContext.Segment<?, ?> segment = resolutionContext.getPath().currentSegment().orElseThrow();","+        Argument<Object> type = (Argument<Object>) ((ArgumentCoercible<?>) Objects.requireNonNull(injectionPoint))","+            .asArgument().getFirstTypeVariable().orElseThrow();","+        Qualifier<Object> qualifier = (Qualifier<Object>) resolutionContext.getCurrentQualifier();","+        BeanDefinition<Object> definition = context.getBeanDefinition(type, qualifier);","+        BeanDependencyResolver resolver = Objects.requireNonNull(resolutionContext.getDependencyResolver());","+        BeanRegistration<Object> eager = resolutionContext.getBeanRegistration(definition, type, new RenamedSegment<>(segment, \"eager\"));","+        return new Lookup<>(resolver, new RenamedSegment<>(segment, \"later\"), definition, type, eager);","+    }","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/LookupInjectionPointSpec.groovy","lines":["@@ -0,0 +1,115 @@","+package io.micronaut.inject.provider.lookuppoint","+","+import io.micronaut.context.ApplicationContext","+import io.micronaut.context.BeanRegistration","+import io.micronaut.context.DefaultBeanDefinitionsProvider","+import io.micronaut.inject.FieldInjectionPoint","+import spock.lang.AutoCleanup","+import spock.lang.Specification","+","+import java.util.concurrent.CountDownLatch","+import java.util.concurrent.Executors","+import java.util.concurrent.TimeUnit","+","+class LookupInjectionPointSpec extends Specification {","+","+    @AutoCleanup","+    ApplicationContext context = ApplicationContext.builder()","+            .properties(\"spec\": getClass().getSimpleName())","+            .beanDependencyTrackingEnabled(true)","+            .beanDefinitionsProvider { ClassLoader classLoader ->","+                new DefaultBeanDefinitionsProvider().provide(classLoader) + [new LookupDefinition()]","+            }","+            .start()","+","+    void \"a bean a provider creates later sees the point the provider was injected at\"() {","+        given:","+        Holder holder = context.getBean(Holder)","+","+        when:","+        RedService service = holder.services.get()","+","+        then:","+        service.point instanceof FieldInjectionPoint","+        service.point.declaringBean.beanType == Holder","+        (service.point as FieldInjectionPoint).name == 'services'","+    }","+","+    void \"a bean the dependency resolver creates later sees the segment the lookup passes\"() {","+        given:","+        Holder holder = context.getBean(Holder)","+","+        when:","+        RedService service = holder.lookup.get().bean","+","+        then:","+        service.point instanceof RenamedSegment","+        service.point.declaringBean.beanType == Holder","+        service.point.toString() == 'Holder.later'","+","+        and: 'a bean the resolution context resolved at a segment of its own saw it'","+        holder.lookup.eager.bean.point.toString() == 'Holder.eager'","+    }","+","+    void \"a bean created later at a lookup point is owned by the bean the lookup was injected into\"() {","+        given:","+        BeanRegistration<Holder> holder = context.getBeanRegistration(Holder, null)","+        BeanRegistration<RedService> looked = holder.bean.lookup.get()","+        RedService eager = holder.bean.lookup.eager.bean","+        RedService provided = holder.bean.services.get()","+","+        expect:","+        !looked.bean.destroyed","+        !eager.destroyed","+","+        and: 'the owner receives the bean once at the lookup point, and holds what its provider resolves lazily'","+        def edges = context.findDependencyGraph().get().dependenciesOf(holder).findAll { it.dependency().beanType == RedService }","+        edges.findAll { !it.lazy() }.size() == 1","+        edges.findAll { it.lazy() }.size() == 1","+","+        when:","+        holder.bean.lookup.resolver().destroy(looked)","+","+        then:","+        looked.bean.destroyed","+        !eager.destroyed","+","+        when:","+        holder.close()","+","+        then:","+        eager.destroyed","+","+        and: 'a provider owns nothing: what it resolves outlives the bean it was injected into'","+        !provided.destroyed","+    }","+","+    void \"concurrent lookups at the same point do not share a path\"() {","+        given:","+        Holder holder = context.getBean(Holder)","+        int threads = 8","+        def executor = Executors.newFixedThreadPool(threads)","+        def ready = new CountDownLatch(threads)","+        def go = new CountDownLatch(1)","+","+        when:","+        def futures = (1..threads).collect {","+            executor.submit {","+                ready.countDown()","+                go.await(10, TimeUnit.SECONDS)","+                (1..200).collect { holder.lookup.get().bean.point.toString() } +","+                        (1..200).collect { holder.services.get().point.toString() }","+            }","+        }","+        ready.await(10, TimeUnit.SECONDS)","+        go.countDown()","+        def points = futures.collect { it.get(30, TimeUnit.SECONDS) }","+","+        then:","+        points.every { it.take(200).every { p -> p == 'Holder.later' } }","+        points.every { it.drop(200).every { p -> p.contains('services') } }","+","+        cleanup:","+        executor.shutdownNow()","+    }","+}"],"additions":115,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/Red.java","lines":["@@ -0,0 +1,12 @@","+package io.micronaut.inject.provider.lookuppoint;","+","+import jakarta.inject.Qualifier;","+","+import java.lang.annotation.Retention;","+","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+@Qualifier","+@Retention(RUNTIME)","+public @interface Red {","+}"],"additions":12,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/RedService.java","lines":["@@ -0,0 +1,21 @@","+package io.micronaut.inject.provider.lookuppoint;","+","+import io.micronaut.context.annotation.Prototype;","+import io.micronaut.inject.InjectionPoint;","+import jakarta.annotation.PreDestroy;","+import jakarta.inject.Inject;","+","+@Red","+@Prototype","+public class RedService {","+","+    @Inject","+    InjectionPoint<?> point;","+","+    boolean destroyed;","+","+    @PreDestroy","+    void close() {","+        destroyed = true;","+    }","+}"],"additions":21,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/RenamedSegment.java","lines":["@@ -0,0 +1,72 @@","+package io.micronaut.inject.provider.lookuppoint;","+","+import io.micronaut.context.BeanResolutionContext;","+import io.micronaut.context.Qualifier;","+import io.micronaut.core.annotation.AnnotationMetadata;","+import io.micronaut.core.type.Argument;","+import io.micronaut.core.type.ArgumentCoercible;","+import io.micronaut.inject.BeanDefinition;","+import io.micronaut.inject.InjectionPoint;","+import org.jspecify.annotations.Nullable;","+","+/**","+ * A segment of the caller's own, as a lookup narrows the point it was injected at: the segment the lookup was","+ * resolved at, under another name, and its own injection point.","+ *","+ * @param <B> The declaring type","+ * @param <T> The injected type","+ */","+public final class RenamedSegment<B, T> implements BeanResolutionContext.Segment<B, T>, InjectionPoint<B>, ArgumentCoercible<T> {","+    private final BeanResolutionContext.Segment<B, T> delegate;","+    private final String name;","+","+    public RenamedSegment(BeanResolutionContext.Segment<B, T> delegate, String name) {","+        this.delegate = delegate;","+        this.name = name;","+    }","+","+    @Override","+    public BeanDefinition<B> getDeclaringType() {","+        return delegate.getDeclaringType();","+    }","+","+    @Override","+    public @Nullable Qualifier<B> getDeclaringTypeQualifier() {","+        return delegate.getDeclaringTypeQualifier();","+    }","+","+    @Override","+    public InjectionPoint<B> getInjectionPoint() {","+        return this;","+    }","+","+    @Override","+    public String getName() {","+        return name;","+    }","+","+    @Override","+    public Argument<T> getArgument() {","+        return delegate.getArgument();","+    }","+","+    @Override","+    public BeanDefinition<B> getDeclaringBean() {","+        return delegate.getDeclaringType();","+    }","+","+    @Override","+    public AnnotationMetadata getAnnotationMetadata() {","+        return delegate.getInjectionPoint().getAnnotationMetadata();","+    }","+","+    @Override","+    public Argument<T> asArgument() {","+        return delegate.getArgument();","+    }","+","+    @Override","+    public String toString() {","+        return delegate.getDeclaringType().getBeanType().getSimpleName() + \".\" + name;","+    }","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"inject-java/src/test/groovy/io/micronaut/inject/provider/lookuppoint/package-info.java","lines":["@@ -0,0 +1,6 @@","+@Configuration","+@Requires(property = \"spec\", value = \"LookupInjectionPointSpec\")","+package io.micronaut.inject.provider.lookuppoint;","+","+import io.micronaut.context.annotation.Configuration;","+import io.micronaut.context.annotation.Requires;"],"additions":6,"deletions":0,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/AbstractBeanResolutionContext.java","lines":["@@ -429,6 +429,17 @@ public <T> BeanRegistration<T> getBeanRegistration(BeanDefinition<? extends T> d","         return context.getBeanRegistration(this, definition, beanType);","     }"," ","+    @Override","+    public <T> BeanRegistration<T> getBeanRegistration(BeanDefinition<? extends T> definition, Argument<T> beanType,","+                                                       Segment<?, ?> lookupPoint) {","+        path.push(lookupPoint);","+        try {","+            return context.getBeanRegistration(this, definition, beanType);","+        } finally {","+            path.pop();","+        }","+    }","+","     @Override","     public <T> T getBean(BeanDefinition<? extends T> definition, Argument<T> beanType) {","         T bean = getBeanRegistration(definition, beanType).getBean();"],"additions":11,"deletions":0,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/BeanDependenc