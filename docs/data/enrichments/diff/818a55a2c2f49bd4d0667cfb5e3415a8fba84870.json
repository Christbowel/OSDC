ater: the receiving bean holds the provider, and the edge to the bean was recorded lazy as it was injected","+        boolean lazy = providedArgument(resolutionContext) != null;","+        add(segment, dependency, lazy, argument.isContainerType() || argument.getType().isArray());","     }"," ","     /**"],"additions":4,"deletions":1,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/DefaultBeanDependencyResolver.java","lines":["@@ -69,6 +69,18 @@ public <T> BeanRegistration<T> getBeanRegistration(BeanDefinition<? extends T> d","         });","     }"," ","+    @Override","+    public <T> BeanRegistration<T> getBeanRegistration(BeanDefinition<? extends T> definition, Argument<T> type,","+                                                       BeanResolutionContext.Segment<?, ?> lookupPoint) {","+        return dependencies.resolve(context, null, resolution -> {","+            // each call has a path of its own, so the segment is pushed for the whole of the resolution","+            resolution.getPath().push(lookupPoint);","+            BeanRegistration<T> registration = context.getBeanRegistration(resolution, definition, type);","+            resolution.require(registration);","+            return registration;","+        });","+    }","+","     @Override","     public BeanDependencyGroup createGroup() {","         return dependencies.resolve(context, null, resolution -> {"],"additions":12,"deletions":0,"truncated":false},{"path":"inject/src/main/java/io/micronaut/inject/provider/AbstractProviderDefinition.java","lines":["@@ -173,6 +173,28 @@ protected T build(BeanResolutionContext resolutionContext, BeanContext context,","         throw new UnsupportedOperationException(\"Cannot inject provider for Object type\");","     }"," ","+    /**","+     * Retains the resolution of the injection point a provider is built for, so that a lookup the provider makes","+     * later resolves at that point.","+     *","+     * <p>The resolution context a provider 