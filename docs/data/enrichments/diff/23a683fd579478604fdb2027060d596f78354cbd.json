{"id":"23a683fd579478604fdb2027060d596f78354cbd","axis":"silent","repo":"owncloud/core","sha":"23a683fd579478604fdb2027060d596f78354cbd","parsed":{"files":[{"path":"changelog/unreleased/41732","lines":["@@ -0,0 +1,9 @@","+Security: Do not trust cached binary paths","+","+The paths of the helper binaries used to render previews - ffmpeg, avconv and","+AtomicParsley - were cached in the distributed memory cache and used without","+being checked, then interpolated unquoted into the shell commands built from","+them. A cached path is now stored in the host local cache tier only, is","+validated before it is used, and is quoted when the command line is assembled.","+","+https://github.com/owncloud/core/pull/41732"],"additions":9,"deletions":0,"truncated":false},{"path":"lib/private/Memcache/LocalCacheFactory.php","lines":["@@ -0,0 +1,64 @@","+<?php","+/**","+ * @author Thomas Müller <thomas.mueller@tmit.eu>","+ *","+ * @copyright Copyright (c) 2026, ownCloud GmbH","+ * @license AGPL-3.0","+ *","+ * This code is free software: you can redistribute it and/or modify","+ * it under the terms of the GNU Affero General Public License, version 3,","+ * as published by the Free Software Foundation.","+ *","+ * This program is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the","+ * GNU Affero General Public License for more details.","+ *","+ * You should have received a copy of the GNU Affero General Public License, version 3,","+ * along with this program.  If not, see <http://www.gnu.org/licenses/>","+ *","+ */","+","+namespace OC\\Memcache;","+","+use OCP\\ICache;","+use OCP\\ICacheFactory;","+","+/**","+ * Resolves a cache from the host local tier of an ICacheFactory.","+ *","+ * Values which are only meaningful on the machine which produced them - resolved","+ * binary paths, theme asset paths, integrity check verdicts - must not be stored","+ * in the distributed tier: it is reachable over the network and every node would","+ * consume what any single node (or anything else able to talk to the backend)","+ * wrote there.","+ *","+ * ICacheFactory does not declare createLocal(), so the tier is requested","+ * defensively and a request scoped ArrayCache is used whenever a usable local","+ * cache cannot be obtained.","+ *","+ * @package OC\\Memcache","+ */","+class LocalCacheFactory {","+\t/**","+\t * Create a cache in the host local tier of $factory, never returning a","+\t * NullCache: when no local memcache is configured the returned cache is","+\t * request scoped rather than a no-op, so the caller still benefits from","+\t * caching within a single request.","+\t *","+\t * @param ICacheFactory $factory","+\t * @param string $prefix","+\t * @return ICache","+\t */","+\tpublic static function create(ICacheFactory $factory, $prefix = '') {","+\t\t$cache = null;","+\t\tif (\\method_exists($factory, 'createLocal')) {","+\t\t\t/* @phan-suppress-next-line PhanUndeclaredMethod */","+\t\t\t$cache = $factory->createLocal($prefix);","+\t\t}","+\t\tif (!$cache instanceof ICache || $cache instanceof NullCache) {","+\t\t\t$cache = new ArrayCache($prefix);","+\t\t}","+\t\treturn $cache;","+\t}","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"lib/private/Preview/Movie.php","lines":["@@ -97,10 +97,7 @@ private function extractMp4CoverArtwork($absPath) {"," \t\t\tif (\\strtolower($suffix) === '.mp4') {"," \t\t\t\t$tmpFolder = \\OC::$server->getTempManager()->getTemporaryFolder();"," \t\t\t\t$tmpBase = $tmpFolder.'/Cover';","-\t\t\t\t$cmd = self::$atomicParsleyBinary . ' ' .","-\t\t\t\t\t\\escapeshellarg($absPath).","-\t\t\t\t\t' --extractPixToPath ' . \\escapeshellarg($tmpBase) .","-\t\t\t\t\t' > /dev/null 2>&1';","+\t\t\t\t$cmd = self::buildAtomicParsleyCommand($absPath, $tmpBase);"," "," \t\t\t\t\\exec($cmd, $output, $returnCode);"," ","@@ -121,26 +118,56 @@ private function extractMp4CoverArtwork($absPath) {"," \t}"," "," \t/**","-\t * @param $absPath","-\t * @param $second","-\t * @return bool|string","+\t * Build the AtomicParsley command line used to extract cover artwork.","+\t *","+\t * The binary is escaped just like every other part of the command line: it","+\t * originates from OC_Helper::findBinaryPath() and must never be interpolated","+\t * into a shell string unquoted.","+\t *","+\t * @param string $absPath","+\t * @param string $tmpBase","+\t * @return string"," \t */","-\tprivate function generateFromMovie($absPath, $second) {","-\t\t$tmpPath = \\OC::$server->getTempManager()->getTemporaryFile();","+\tprivate static function buildAtomicParsleyCommand($absPath, $tmpBase) {","+\t\treturn \\escapeshellarg(self::$atomicParsleyBinary) . ' ' .","+\t\t\t\\escapeshellarg($absPath) .","+\t\t\t' --extractPixToPath ' . \\escapeshellarg($tmpBase) .","+\t\t\t' > /dev/null 2>&1';","+\t}"," ","+\t/**","+\t * Build the avconv/ffmpeg command line used to grab a single frame.","+\t *","+\t * @param string $absPath","+\t * @param int $second","+\t * @param string $tmpPath","+\t * @return string","+\t */","+\tprivate static function buildMovieCommand($absPath, $second, $tmpPath) {"," \t\tif (self::$avconvBinary) {","-\t\t\t$cmd = self::$avconvBinary . ' -y -ss ' . \\escapeshellarg($second) .","+\t\t\treturn \\escapeshellarg(self::$avconvBinary) . ' -y -ss ' . \\escapeshellarg($second) ."," \t\t\t\t' -i ' . \\escapeshellarg($absPath) ."," \t\t\t\t' -an -f mjpeg -vframes 1 -vsync 1 ' . \\escapeshellarg($tmpPath) ."," \t\t\t\t' > /dev/null 2>&1';","-\t\t} else {","-\t\t\t$cmd = self::$ffmpegBinary . ' -y -ss ' . \\escapeshellarg($second) .","-\t\t\t\t' -i ' . \\escapeshellarg($absPath) .","-\t\t\t\t' -f mjpeg -vframes 1' .","-\t\t\t\t' ' . \\escapeshellarg($tmpPath) .","-\t\t\t\t' > /dev/null 2>&1';"," \t\t}"," ","+\t\treturn \\escapeshellarg(self::$ffmpegBinary) . ' -y -ss ' . \\escapeshellarg($second) .","+\t\t\t' -i ' . \\escapeshellarg($absPath) .","+\t\t\t' -f mjpeg -vframes 1' .","+\t\t\t' ' . \\escapeshellarg($tmpPath) .","+\t\t\t' > /dev/null 2>&1';","+\t}","+","+\t/**","+\t * @param $absPath","+\t * @param $second","+\t * @return bool|string","+\t */","+\tprivate function generateFromMovie($absPath, $second) {","+\t\t$tmpPath = \\OC::$server->getTempManager()->getTemporaryFile();","+","+\t\t$cmd = self::buildMovieCommand($absPath, $second, $tmpPath);","+"," \t\t\\exec($cmd, $output, $returnCode);"," "," \t\tif ($returnCode === 0) {"],"additions":43,"deletions":16,"truncated":false},{"path":"lib/private/legacy/helper.php","lines":["@@ -518,6 +518,18 @@ public static function is_function_enabled($function_name) {"," \t\treturn true;"," \t}"," ","+\t/**","+\t * Sentinel stored in the cache to remember that a program could not be","+\t * found, so the (comparatively expensive) lookup is not repeated. It is","+\t * distinguishable from a cache miss, which yields null.","+\t */","+\tprivate const BINARY_NOT_FOUND = false;","+","+\t/**","+\t * Number of seconds a resolved binary path is cached for","+\t */","+\tprivate const BINARY_PATH_TTL = 300;","+"," \t/**"," \t * Try to find a program"," \t *","@@ -525,28 +537,66 @@ public static function is_function_enabled($function_name) {"," \t * @return null|string"," \t */"," \tpublic static function findBinaryPath($program) {","-\t\t$memcache = \\OC::$server->getMemCacheFactory()->create('findBinaryPath');","-\t\tif ($memcache->hasKey($program)) {","-\t\t\treturn $memcache->get($program);","+\t\t// host local tier only: a binary path is meaningful for this machine","+\t\t// alone and ends up in a shell command, so it must not be read from a","+\t\t// cache which other hosts - or anything able to reach the cache","+\t\t// backend - can write to.","+\t\t$memcache = \\OC\\Memcache\\LocalCacheFactory::create(","+\t\t\t\\OC::$server->getMemCacheFactory(),","+\t\t\t'findBinaryPath'","+\t\t);","+","+\t\t$cached = $memcache->get($program);","+\t\tif ($cached === self::BINARY_NOT_FOUND) {","+\t\t\treturn null;","+\t\t}","+\t\t// never hand out a cached path without checking it still describes the","+\t\t// program which was asked for","+\t\tif ($cached !== null && self::isUsableBinaryPath($program, $cached)) {","+\t\t\treturn $cached;"," \t\t}","+"," \t\t$result = null;"," \t\tif (self::is_function_enabled('exec')) {"," \t\t\t$exeSniffer = new ExecutableFinder();"," \t\t\t// Returns null if nothing is found"," \t\t\t$result = $exeSniffer->find($program);","-\t\t\t#if (empty($result)) {","-\t\t\t#\t$command = 'find ' . self::getCleanedPath(\\getenv('PATH')) . ' -name ' . \\escapeshellarg($program) . ' 2> /dev/null';","-\t\t\t#\t\\exec($command, $output, $returnCode);","-\t\t\t#\tif (\\count($output) > 0) {","-\t\t\t#\t\t$result = \\escapeshellcmd($output[0]);","-\t\t\t#\t}","-\t\t\t#}","-\t\t}","-\t\t// store the value for 5 minutes","-\t\t$memcache->set($program, $result, 300);","+\t\t}","+\t\tif (!self::isUsableBinaryPath($program, $result)) {","+\t\t\t$result = null;","+\t\t}","+","+\t\t$memcache->set(","+\t\t\t$program,","+\t\t\t$result === null ? self::BINARY_NOT_FOUND : $result,","+\t\t\tself::BINARY_PATH_TTL","+\t\t);"," \t\treturn $result;"," \t}"," ","+\t/**","+\t * Check that a path really is the executable of the requested program.","+\t *","+\t * @param string $program the program which was looked up","+\t * @param mixed $path the path to check","+\t * @return bool","+\t */","+\tprivate static function isUsableBinaryPath($program, $path) {","+\t\tif (!\\is_string($path) || $path === '') {","+\t\t\treturn false;","+\t\t}","+\t\t// a NUL byte truncates the value for any C level consumer and makes","+\t\t// escapeshellarg() throw","+\t\tif (\\strpos($path, \"\\0\") !== false) {","+\t\t\treturn false;","+\t\t}","+\t\tif (\\basename($path) !== $program) {","+\t\t\treturn false;","+\t\t}","+\t\t// is_executable() alone is not enough: it is also true for directories","+\t\treturn \\is_file($path) && \\is_executable($path);","+\t}","+"," \t/**"," \t * Return a validated (sanitised) version of the system path"," \t *"],"additions":63,"deletions":13,"truncated":false},{"path":"tests/lib/Memcache/FixedCacheFactory.php","lines":["@@ -0,0 +1,77 @@","+<?php","+/**","+ * @author Thomas Müller <thomas.mueller@tmit.eu>","+ *","+ * @copyright Copyright (c) 2026, ownCloud GmbH","+ * @license AGPL-3.0","+ *","+ * This code is free software: you can redistribute it and/or modify","+ * it under the terms of the GNU Affero General Public License, version 3,","+ * as published by the Free Software Foundation.","+ *","+ * This program is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the","+ * GNU Affero General Public License for more details.","+ *","+ * You should have received a copy of the GNU Affero General Public License, version 3,","+ * along with this program.  If not, see <http://www.gnu.org/licenses/>","+ *","+ */","+","+namespace Test\\Memcache;","+","+use OCP\\ICache;","+use OCP\\ICacheFactory;","+","+/**","+ * An ICacheFactory handing out one and the same cache for every tier, so a test","+ * can observe what the code under test stored.","+ *","+ * \\OC\\Memcache\\Factory returns a fresh cache instance per call, which makes the","+ * cache contents invisible to a test unless the factory is replaced.","+ */","+class FixedCacheFactory implements ICacheFactory {","+\t/** @var ICache */","+\tprivate $cache;","+","+\t/** @var string[] the prefixes this factory was asked for */","+\tprivate $prefixes = [];","+","+\tpublic function __construct(ICache $cache) {","+\t\t$this->cache = $cache;","+\t}","+","+\tpublic function create($prefix = '') {","+\t\t$this->prefixes[] = $prefix;","+\t\treturn $this->cache;","+\t}","+","+\tpublic function createLocal($prefix = '') {","+\t\t$this->prefixes[] = $prefix;","+\t\treturn $this->cache;","+\t}","+","+\tpublic function createDistributed($prefix = '') {","+\t\t$this->prefixes[] = $prefix;","+\t\treturn $this->cache;","+\t}","+","+\tpublic function createLocking($prefix = '') {","+\t\t$this->prefixes[] = $prefix;","+\t\treturn $this->cache;","+\t}","+","+\tpublic function isAvailable() {","+\t\treturn true;","+\t}","+","+\t/**","+\t * The prefixes this factory handed out a cache for, in call order.","+\t *","+\t * @return string[]","+\t */","+\tpublic function getRequestedPrefixes() {","+\t\treturn $this->prefixes;","+\t}","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"tests/lib/Memcache/LocalCacheFactoryTest.php","lines":["@@ -0,0 +1,113 @@","+<?php","+/**","+ * @author Thomas Müller <thomas.mueller@tmit.eu>","+ *","+ * @copyright Copyright (c) 2026, ownCloud GmbH","+ * @license AGPL-3.0","+ *","+ * This code is free software: you can redistribute it and/or modify","+ * it under the terms of the GNU Affero General Public License, version 3,","+ * as published by the Free Software Foundation.","+ *","+ * This program is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the","+ * GNU Affero General Public License for more details.","+ *","+ * You should have received a copy of the GNU Affero General Public License, version 3,","+ * along with this program.  If not, see <http://www.gnu.org/licenses/>","+ *","+ */","+namespace Test\\Memcache;","+","+use OC\\Memcache\\ArrayCache;","+use OC\\Memcache\\Factory;","+use OC\\Memcache\\LocalCacheFactory;","+use OC\\Memcache\\NullCache;","+use OCP\\ICache;","+use OCP\\ICacheFactory;","+use OCP\\ILogger;","+use Test\\TestCase;","+","+class LocalCacheFactoryTest extends TestCase {","+\t/** @var ILogger */","+\tprivate $logger;","+","+\tprotected function setUp(): void {","+\t\tparent::setUp();","+\t\t$this->logger = $this->createMock(ILogger::class);","+\t}","+","+\tpublic function testUsesTheLocalTier(): void {","+\t\t$factory = new Factory(","+\t\t\t'prefix',","+\t\t\t$this->logger,","+\t\t\tArrayCache::class,","+\t\t\tNullCache::class,","+\t\t\tnull","+\t\t);","+","+\t\t$cache = LocalCacheFactory::create($factory, 'test');","+","+\t\t$this->assertInstanceOf(ArrayCache::class, $cache);","+\t}","+","+\t/**","+\t * The distributed tier must not be used as a fallback: that is exactly the","+\t * trust boundary this helper exists to keep.","+\t */","+\tpublic function testNeverFallsBackToTheDistributedTier(): void {","+\t\t$factory = new Factory(","+\t\t\t'prefix',","+\t\t\t$this->logger,","+\t\t\tnull,","+\t\t\tArrayCache::class,","+\t\t\tnull","+\t\t);","+\t\t// no local cache configured, so the local tier is a NullCache ...","+\t\t$this->assertInstanceOf(NullCache::class, $factory->createLocal('test'));","+","+\t\t// ... and the helper substitutes a request scoped cache instead","+\t\t$cache = LocalCacheFactory::create($factory, 'test');","+\t\t$this->assertInstanceOf(ArrayCache::class, $cache);","+","+\t\t// prove it is not the distributed instance by writing through it","+\t\t$cache->set('key', 'value');","+\t\t$this->assertSame('value', $cache->get('key'));","+\t\t$this->assertNull($factory->createDistributed('test')->get('key'));","+\t}","+","+\tpublic function testFallsBackWhenCreateLocalIsNotImplemented(): void {","+\t\t// ICacheFactory does not declare createLocal(), so a bare interface","+\t\t// mock has no such method","+\t\t$factory = $this->createMock(ICacheFactory::class);","+","+\t\t$this->assertInstanceOf(ArrayCache::class, LocalCacheFactory::create($factory, 'test'));","+\t}","+","+\t/**","+\t * @dataProvider unusableLocalCacheProvider","+\t * @param mixed $returnValue","+\t */","+\tpublic function testFallsBackWhenCreateLocalReturnsSomethingUnusable($returnValue): void {","+\t\t$factory = $this->createMock(FixedCacheFactory::class);","+\t\t$factory->method('createLocal')->willReturn($returnValue);","+","+\t\t$this->assertInstanceOf(ArrayCache::class, LocalCacheFactory::create($factory, 'test'));","+\t}","+","+\tpublic function unusableLocalCacheProvider() {","+\t\treturn [","+\t\t\t'null' => [null],","+\t\t\t'a NullCache' => [new NullCache('test')],","+\t\t];","+\t}","+","+\tpublic function testPassesThroughThePrefix(): void {","+\t\t$factory = new FixedCacheFactory($this->createMock(ICache::class));","+","+\t\tLocalCacheFactory::create($factory, 'some-prefix');","+","+\t\t$this->assertSame(['some-prefix'], $factory->getRequestedPrefixes());","+\t}","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"tests/lib/Preview/MovieCommandTest.php","lines":["@@ -0,0 +1,190 @@","+<?php","+/**","+ * @author Thomas Müller <thomas.mueller@tmit.eu>","+ *","+ * @copyright Copyright (c) 2026, ownCloud GmbH","+ * @license AGPL-3.0","+ *","+ * This code is free software: you can redistribute it and/or modify","+ * it under the terms of the GNU Affero General Public License, version 3,","+ * as published by the Free Software Foundation.","+ *","+ * This program is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the","+ * GNU Affero General Public License for more details.","+ *","+ * You should have received a copy of the GNU Affero General Public License, version 3,","+ * along with this program.  If not, see <http://www.gnu.org/licenses/>","+ *","+ */","+","+namespace Test\\Preview;","+","+use OC\\Preview\\Movie;","+use Test\\TestCase;","+","+/**","+ * The binaries used by the Movie provider come from OC_Helper::findBinaryPath(),","+ * i.e. from a cache. These tests pin that they are quoted before ending up in a","+ * shell command, independently of whether ffmpeg is installed.","+ *","+ * @package Test\\Preview","+ */","+class MovieCommandTest extends TestCase {","+\t/** @var array */","+\tprivate $binaries = [];","+","+\tprotected function setUp(): void {","+\t\tparent::setUp();","+\t\t$this->binaries = [","+\t\t\tMovie::$avconvBinary,","+\t\t\tMovie::$ffmpegBinary,","+\t\t\tMovie::$atomicParsleyBinary,","+\t\t];","+\t\tMovie::$avconvBinary = null;","+\t\tMovie::$ffmpegBinary = null;","+\t\tMovie::$atomicParsleyBinary = null;","+\t}","+","+\tprotected function tearDown(): void {","+\t\tlist(","+\t\t\tMovie::$avconvBinary,","+\t\t\tMovie::$ffmpegBinary,","+\t\t\tMovie::$atomicParsleyBinary","+\t\t) = $this->binaries;","+\t\tparent::tearDown();","+\t}","+","+\tprivate function buildMovieCommand($absPath, $second, $tmpPath) {","+\t\treturn self::invokePrivate(","+\t\t\tMovie::class,","+\t\t\t'buildMovieCommand',","+\t\t\t[$absPath, $second, $tmpPath]","+\t\t);","+\t}","+","+\tprivate function buildAtomicParsleyCommand($absPath, $tmpBase) {","+\t\treturn self::invokePrivate(","+\t\t\tMovie::class,","+\t\t\t'buildAtomicParsleyCommand',","+\t\t\t[$absPath, $tmpBase]","+\t\t);","+\t}","+","+\tpublic function testFfmpegBinaryIsQuoted(): void {","+\t\tMovie::$ffmpegBinary = '/usr/bin/ffmpeg';","+","+\t\t$cmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+","+\t\t$this->assertStringStartsWith(\\escapeshellarg('/usr/bin/ffmpeg') . ' ', $cmd);","+\t}","+","+\tpublic function testAvconvBinaryIsQuoted(): void {","+\t\tMovie::$avconvBinary = '/usr/bin/avconv';","+","+\t\t$cmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+","+\t\t$this->assertStringStartsWith(\\escapeshellarg('/usr/bin/avconv') . ' ', $cmd);","+\t}","+","+\tpublic function testAvconvTakesPrecedenceOverFfmpeg(): void {","+\t\tMovie::$avconvBinary = '/usr/bin/avconv';","+\t\tMovie::$ffmpegBinary = '/usr/bin/ffmpeg';","+","+\t\t$cmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+","+\t\t$this->assertStringStartsWith(\\escapeshellarg('/usr/bin/avconv') . ' ', $cmd);","+\t\t$this->assertStringNotContainsString('ffmpeg', $cmd);","+\t}","+","+\tpublic function testAtomicParsleyBinaryIsQuoted(): void {","+\t\tMovie::$atomicParsleyBinary = '/usr/bin/AtomicParsley';","+","+\t\t$cmd = $this->buildAtomicParsleyCommand('/tmp/in.mp4', '/tmp/Cover');","+","+\t\t$this->assertStringStartsWith(\\escapeshellarg('/usr/bin/AtomicParsley') . ' ', $cmd);","+\t}","+","+\t/**","+\t * A hostile binary value must end up as a single quoted token, so the shell","+\t * treats it as one (non-existing) command name instead of parsing the","+\t * payload.","+\t *","+\t * @dataProvider hostileBinaryProvider","+\t */","+\tpublic function testHostileBinaryIsQuotedAsOneToken(string $binary): void {","+\t\tMovie::$ffmpegBinary = $binary;","+\t\t$ffmpegCmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+\t\tMovie::$ffmpegBinary = null;","+","+\t\tMovie::$avconvBinary = $binary;","+\t\t$avconvCmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+\t\tMovie::$avconvBinary = null;","+","+\t\tMovie::$atomicParsleyBinary = $binary;","+\t\t$atomicParsleyCmd = $this->buildAtomicParsleyCommand('/tmp/in.mp4', '/tmp/Cover');","+","+\t\tforeach ([$ffmpegCmd, $avconvCmd, $atomicParsleyCmd] as $cmd) {","+\t\t\t$this->assertStringStartsWith(\\escapeshellarg($binary) . ' ', $cmd);","+\t\t}","+\t}","+","+\tpublic function hostileBinaryProvider() {","+\t\treturn [","+\t\t\t'command chaining' => ['/usr/bin/ffmpeg; id'],","+\t\t\t'background' => ['/usr/bin/ffmpeg & id'],","+\t\t\t'pipe' => ['/usr/bin/ffmpeg | id'],","+\t\t\t'subshell' => ['/usr/bin/ffmpeg $(id)'],","+\t\t\t'backticks' => ['/usr/bin/ffmpeg `id`'],","+\t\t\t'newline' => [\"/usr/bin/ffmpeg\\nid\"],","+\t\t\t'quote break out' => [\"/usr/bin/ffmpeg' ; id ; '\"],","+\t\t];","+\t}","+","+\t/**","+\t * The end to end proof: hand the built command to a real shell and verify","+\t * the payload appended to the binary does not run.","+\t *","+\t * @dataProvider commandBuilderProvider","+\t */","+\tpublic function testInjectedPayloadIsNotExecutedByTheShell(string $builder): void {","+\t\t$marker = \\OC::$server->getTempManager()->getTemporaryFile();","+\t\t// the temp manager creates the file - the payload would re-create it","+\t\t\\unlink($marker);","+","+\t\t$payload = '/usr/bin/ffmpeg; touch ' . \\escapeshellarg($marker);","+\t\tMovie::$ffmpegBinary = $payload;","+\t\tMovie::$atomicParsleyBinary = $payload;","+","+\t\tif ($builder === 'movie') {","+\t\t\t$cmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+\t\t} else {","+\t\t\t$cmd = $this->buildAtomicParsleyCommand('/tmp/in.mp4', '/tmp/Cover');","+\t\t}","+","+\t\t\\exec($cmd, $output, $returnCode);","+","+\t\t$this->assertFileDoesNotExist($marker, 'the injected command must not run');","+\t\t$this->assertNotSame(0, $returnCode, 'the bogus binary must not be found');","+\t}","+","+\tpublic function commandBuilderProvider() {","+\t\treturn [","+\t\t\t'ffmpeg/avconv' => ['movie'],","+\t\t\t'AtomicParsley' => ['atomicParsley'],","+\t\t];","+\t}","+","+\t/**","+\t * Quoting the binary also fixes paths containing spaces, which used to","+\t * break the command.","+\t */","+\tpublic function testBinaryPathWithSpacesIsUsable(): void {","+\t\tMovie::$ffmpegBinary = '/opt/my apps/bin/ffmpeg';","+","+\t\t$cmd = $this->buildMovieCommand('/tmp/in.mp4', 5, '/tmp/out.jpg');","+","+\t\t$this->assertStringStartsWith(\"'/opt/my apps/bin/ffmpeg' \", $cmd);","+\t}","+}"],"additions":190,"deletions":0,"truncated":false},{"path":"tests/lib/legacy/HelperTest.php","lines":["@@ -2,9 +2,93 @@"," "," namespace Test\\legacy;"," ","+use OC\\Memcache\\ArrayCache;","+use Test\\Memcache\\FixedCacheFactory;"," use Test\\TestCase;"," "," class HelperTest extends TestCase {","+\t/** @var ArrayCache */","+\tprivate $cache;","+","+\tprotected function setUp(): void {","+\t\tparent::setUp();","+\t\t$this->cache = new ArrayCache('findBinaryPath');","+\t\t$this->overwriteService('MemCacheFactory', new FixedCacheFactory($this->cache));","+\t}","+","+\tprotected function tearDown(): void {","+\t\t$this->restoreService('MemCacheFactory');","+\t\tparent::tearDown();","+\t}","+","+\t/**","+\t * A value read back from the cache must not be handed out just because it","+\t * is there - a cache an attacker can write to would otherwise hand a","+\t * chosen string to the shell commands built from it.","+\t *","+\t * @dataProvider poisonedBinaryPathProvider","+\t * @param mixed $poisoned","+\t */","+\tpublic function testFindBinaryPathRejectsPoisonedCacheEntry($poisoned): void {","+\t\t$this->cache->set('ffmpeg', $poisoned);","+","+\t\t$this->assertNotSame(","+\t\t\t$poisoned,","+\t\t\t\\OC_Helper::findBinaryPath('ffmpeg'),","+\t\t\t'a rejected cache entry must never be returned'","+\t\t);","+\t\t// the bad entry has been replaced by whatever was resolved (or the","+\t\t// not-found sentinel), so it cannot be served again","+\t\t$this->assertNotSame($poisoned, $this->cache->get('ffmpeg'));","+\t}","+","+\tpublic function poisonedBinaryPathProvider() {","+\t\treturn [","+\t\t\t'appended command' => ['/usr/bin/ffmpeg;touch /tmp/oc-pwned'],","+\t\t\t'bare command' => ['; id'],","+\t\t\t'command substitution' => ['$(id)'],","+\t\t\t'does not exist' => ['/nonexistent/ffmpeg'],","+\t\t\t'not executable' => ['/etc/passwd'],","+\t\t\t// is_executable() is true for directories, so is_file() is required","+\t\t\t'directory' => ['/usr/bin'],","+\t\t\t'a different binary' => ['/usr/bin/env'],","+\t\t\t'nul byte' => [\"/usr/bin/ffmpeg\\0/evil\"],","+\t\t\t'empty' => [''],","+\t\t\t'not a string' => [['/usr/bin/ffmpeg']],","+\t\t\t'boolean true' => [true],","+\t\t];","+\t}","+","+\tpublic function testFindBinaryPathUsesValidCachedValue(): void {","+\t\t// PHP_BINARY is guaranteed to exist and be executable","+\t\t$program = \\basename(PHP_BINARY);","+\t\t$this->cache->set($program, PHP_BINARY);","+","+\t\t$this->assertSame(PHP_BINARY, \\OC_Helper::findBinaryPath($program));","+\t}","+","+\tpublic function testFindBinaryPathCachesMissWithoutRepeatedLookup(): void {","+\t\t$program = 'oc-definitely-no-such-binary';","+","+\t\t$this->assertNull(\\OC_Helper::findBinaryPath($program));","+\t\t// a miss is remembered, so it is distinguishable from \"not looked up yet\"","+\t\t$this->assertTrue($this->cache->hasKey($program));","+\t\t$this->assertNull(\\OC_Helper::findBinaryPath($program));","+\t}","+","+\t/**","+\t * A legacy null entry - what the previous implementation stored for a miss -","+\t * must not be mistaken for a usable path.","+\t */","+\tpublic function testFindBinaryPathHandlesLegacyNullCacheEntry(): void {","+\t\t$this->cache->set('ffmpeg', null);","+","+\t\t$result = \\OC_Helper::findBinaryPath('ffmpeg');","+\t\t$this->assertTrue($result === null || \\is_file($result));","+\t\t// the entry has been rewritten, so the legacy value heals itself","+\t\t$this->assertNotNull($this->cache->get('ffmpeg'));","+\t}","+"," \t/**"," \t * @dataProvider getCleanedPathProvider"," \t */",""],"additions":84,"deletions":0,"truncated":false}],"additions":643,"deletions":29,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-07-28T10:21:10.883761+00:00"}