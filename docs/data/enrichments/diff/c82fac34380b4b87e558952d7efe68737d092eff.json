{"id":"c82fac34380b4b87e558952d7efe68737d092eff","axis":"silent","repo":"grafana/grafana","sha":"c82fac34380b4b87e558952d7efe68737d092eff","parsed":{"files":[{"path":"pkg/plugins/definition/augment.go","lines":["@@ -48,24 +48,16 @@ func AugmentOpenAPI(oas *spec3.OpenAPI, opts SettingsResource) (*spec3.OpenAPI,"," \tif cfg == nil {"," \t\treturn nil, fmt.Errorf(\"no route registered: %s\", opts.Path)"," \t}","-\tif cfg.Post == nil {","-\t\treturn nil, fmt.Errorf(\"expecting POST under: %s\", opts.Path)","-\t}","+\t// Read-only settings have no POST, and so nowhere to show the examples;","+\t// everything else is described as for writable settings.","+\tcreate := cfg.Post"," "," \t// Replace the generic DataSourceSpec with the explicit one"," \tsettings := opts.Schema.SettingsSchema"," \tif !settings.IsZero() {"," \t\tresourceSpec := settings.Spec"," \t\tif opts.IsApp {","-\t\t\tresourceSpec = &spec.Schema{","-\t\t\t\tSchemaProps: spec.SchemaProps{","-\t\t\t\t\tType: []string{\"object\"},","-\t\t\t\t\tProperties: map[string]spec.Schema{","-\t\t\t\t\t\t\"enabled\":  *spec.BooleanProperty().WithDescription(\"can be executed\"),","-\t\t\t\t\t\t\"jsonData\": *settings.Spec,","-\t\t\t\t\t},","-\t\t\t\t},","-\t\t\t}","+\t\t\tresourceSpec = AppSettingsSpec(settings)"," "," \t\t\texample := map[string]any{"," \t\t\t\t\"metadata\": map[string]any{","@@ -122,8 +114,8 @@ func AugmentOpenAPI(oas *spec3.OpenAPI, opts SettingsResource) (*spec3.OpenAPI,"," \t\t}"," "," \t\texamples := opts.Schema.SettingsExamples","-\t\tif !examples.IsZero() {","-\t\t\tfor _, c := range cfg.Post.RequestBody.Content {","+\t\tif !examples.IsZero() && create != nil && create.RequestBody != nil {","+\t\t\tfor _, c := range create.RequestBody.Content {"," \t\t\t\tc.Examples = examples.Examples"," \t\t\t}"," \t\t}","@@ -302,3 +294,32 @@ func copyComponents(src *spec3.Components, dst *spec3.Components) {"," \t\tmaps.Copy(dst.RequestBodies, src.RequestBodies)"," \t}"," }","+","+// AppSettingsSpec is the spec of an app's settings object as the settings API","+// describes it, in its OpenAPI and its manifest: whether the app is enabled,","+// next to its jsonData. The settings schema's spec is the contents of","+// jsonData; without one, jsonData is any object (AnyJSONData).","+func AppSettingsSpec(settings *pluginschema.Settings) *spec.Schema {","+\tjsonData := AnyJSONData()","+\tif !settings.IsZero() && settings.Spec != nil {","+\t\tjsonData = settings.Spec","+\t}","+\treturn &spec.Schema{","+\t\tSchemaProps: spec.SchemaProps{","+\t\t\tType: []string{\"object\"},","+\t\t\tProperties: map[string]spec.Schema{","+\t\t\t\t\"enabled\":  *spec.BooleanProperty().WithDescription(\"can be executed\"),","+\t\t\t\t\"jsonData\": *jsonData,","+\t\t\t},","+\t\t},","+\t}","+}","+","+// AnyJSONData is the jsonData of an app whose settings schema does not define","+// it: any object.","+func AnyJSONData() *spec.Schema {","+\treturn &spec.Schema{SchemaProps: spec.SchemaProps{","+\t\tType:                 []string{\"object\"},","+\t\tAdditionalProperties: &spec.SchemaOrBool{Allows: true},","+\t}}","+}"],"additions":35,"deletions":14,"truncated":false},{"path":"pkg/plugins/definition/augment_test.go","lines":["@@ -203,11 +203,6 @@ func TestAugmentOpenAPI(t *testing.T) {"," \t\t\t\tmutate:  func(oas *spec3.OpenAPI) { delete(oas.Paths.Paths, augmentPath) },"," \t\t\t\texpects: \"no route registered\","," \t\t\t},","-\t\t\t{","-\t\t\t\tname:    \"no POST on the collection path\",","-\t\t\t\tmutate:  func(oas *spec3.OpenAPI) { oas.Paths.Paths[augmentPath].Post = nil },","-\t\t\t\texpects: \"expecting POST under\",","-\t\t\t},"," \t\t\t{"," \t\t\t\tname:    \"no {name} path\","," \t\t\t\tmutate:  func(oas *spec3.OpenAPI) { delete(oas.Paths.Paths, augmentPath+\"/{name}\") },","@@ -234,6 +229,35 @@ func TestAugmentOpenAPI(t *testing.T) {"," \t\t}"," \t})"," ","+\tt.Run(\"read-only settings are described without the examples\", func(t *testing.T) {","+\t\toas := newAugmentOAS(augmentPath)","+\t\toas.Paths.Paths[augmentPath].Post = nil","+\t\toas.Paths.Paths[augmentPath].Get = &spec3.Operation{}","+\t\tresource := newResourceSchema()","+\t\tschema := settingsOnly()","+\t\tschema.SettingsExamples = &pluginschema.SettingsExamples{Examples: map[string]*spec3.Example{\"default\": {}}}","+\t\tschema.Routes = &pluginschema.Routes{Paths: map[string]*spec3.Path{","+\t\t\t\"/resources/things\": {PathProps: spec3.PathProps{Get: &spec3.Operation{}, Post: &spec3.Operation{}}},","+\t\t}}","+","+\t\t_, err := AugmentOpenAPI(oas, SettingsResource{","+\t\t\tSchema:   schema,","+\t\t\tResource: resource,","+\t\t\tSpecName: \"SettingsSpec\",","+\t\t\tPath:     augmentPath,","+\t\t\tIsApp:    true,","+\t\t})","+\t\trequire.NoError(t, err)","+\t\tassert.Contains(t, oas.Components.Schemas, \"SettingsSpec\")","+\t\tspecProp := resource.Properties[\"spec\"]","+\t\tassert.Equal(t, \"#/components/schemas/SettingsSpec\", specProp.Ref.String())","+\t\tassert.NotContains(t, oas.Paths.Paths, augmentPath, \"the collection is rewritten to the instance\")","+\t\tassert.Contains(t, oas.Paths.Paths, augmentPath+\"/instance\")","+\t\tthings := oas.Paths.Paths[augmentPath+\"/instance/resources/things\"]","+\t\trequire.NotNil(t, things, \"the plugin's routes are published\")","+\t\tassert.NotNil(t, things.Post, \"custom routes keep their write methods\")","+\t})","+"," \tt.Run(\"registers the settings spec and links it from the resource\", func(t *testing.T) {"," \t\toas := newAugmentOAS(augmentPath)"," \t\tresource := newResourceSchema()"],"additions":29,"deletions":5,"truncated":false},{"path":"pkg/plugins/definition/settings_manifest.go","lines":["@@ -96,15 +96,21 @@ func NewSettingsManifest(p PluginDefinition, match RouteMatcher) (manifest *app."," \tmanifest.Group = p.JSONData.ID"," \tmanifest.PreferredVersion = SettingsAPIVersion"," ","+\tkind := settingsKind()"," \tversion := app.ManifestVersion{"," \t\tName:   SettingsAPIVersion,"," \t\tServed: true,","-\t\tKinds:  []app.ManifestVersionKind{settingsKind()},"," \t}","-\tdefer func() { manifest.Versions = []app.ManifestVersion{version} }()","+\tdefer func() {","+\t\tversion.Kinds = []app.ManifestVersionKind{kind}","+\t\tmanifest.Versions = []app.ManifestVersion{version}","+\t}()"," "," \tresources, proxy, components, errs := settingsRoutes(manifest)","-\tversion.OpenAPI.Components = components","+\tversion.OpenAPI.Components = cloneComponents(components)","+\tif err := withPluginSchema(&kind, &version, resources, p.Schemas[SettingsAPIVersion]); err != nil {","+\t\terrs = append(errs, err)","+\t}"," \tif len(resources) > 0 {"," \t\tcandidate := withPaths(version, resources)"," \t\tif _, err := settingsRouteMux(candidate); err != nil {"],"additions":9,"deletions":3,"truncated":false},{"path":"pkg/plugins/definition/settings_schema.go","lines":["@@ -0,0 +1,159 @@","+package definition","+","+import (","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"maps\"","+\t\"slices\"","+","+\t\"k8s.io/kube-openapi/pkg/spec3\"","+\t\"k8s.io/kube-openapi/pkg/validation/spec\"","+","+\t\"github.com/grafana/grafana-app-sdk/app\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/experimental/pluginschema\"","+)","+","+// settingsSpecSchemaName names the settings spec in the Settings kind's","+// schema, which refers to it as the kind schemas the app-sdk generates do.","+const settingsSpecSchemaName = \"spec\"","+","+// withPluginSchema adds to the settings manifest's Settings kind and version","+// what the plugin's schema for the settings API version describes, so the","+// manifest publishes it as the settings API does: the settings spec, with","+// enabled next to jsonData as the schema defines it (any object when it does","+// not), its secure values, and the routes below the resources subresource","+// with the components they refer to. What the settings manifest's foundation","+// declares is kept: a route, or a component, it declares under the same name","+// is not replaced.","+//","+// Only resource routes are taken from the schema. A proxy route must say","+// where it forwards to, which the schema does not.","+func withPluginSchema(kind *app.ManifestVersionKind, version *app.ManifestVersion, resources map[string]spec3.PathProps, schema *pluginschema.PluginSchema) error {","+\tvar errs []error","+\tvar settings *pluginschema.Settings","+\tif schema != nil {","+\t\tsettings = schema.SettingsSchema","+\t}","+\tif err := withSettingsSchema(kind, settings); err != nil {","+\t\terrs = append(errs, fmt.Errorf(\"the settings schema is left out: %w\", err))","+\t}","+\tif schema.IsZero() {","+\t\treturn errors.Join(errs...)","+\t}","+\troutes := schema.Routes","+\tif routes.IsZero() {","+\t\treturn errors.Join(errs...)","+\t}","+\tfor _, path := range slices.Sorted(maps.Keys(routes.Paths)) {","+\t\titem := routes.Paths[path]","+\t\tif item == nil || !IsBelow(path, \"/resources\") {","+\t\t\tcontinue","+\t\t}","+\t\tdeclared := settingsObjectRoot + path","+\t\tif _, ok := resources[declared]; ok {","+\t\t\tcontinue","+\t\t}","+\t\tprops, err := clonePathProps(item.PathProps)","+\t\tif err != nil {","+\t\t\terrs = append(errs, fmt.Errorf(\"schema route %s is left out: %w\", path, err))","+\t\t\tcontinue","+\t\t}","+\t\tresources[declared] = props","+\t}","+\tif c := routes.Components; c != nil {","+\t\tcomponents := &version.OpenAPI.Components","+\t\tfor name, s := range c.Schemas {","+\t\t\tif s == nil {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif _, ok := components.Schemas[name]; ok {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif components.Schemas == nil {","+\t\t\t\tcomponents.Schemas = map[string]spec.Schema{}","+\t\t\t}","+\t\t\tcomponents.Schemas[name] = *s","+\t\t}","+\t\taddMissingComponents(&components.Responses, c.Responses)","+\t\taddMissingComponents(&components.Examples, c.Examples)","+\t}","+\treturn errors.Join(errs...)","+}","+","+// withSettingsSchema sets kind's schema to the settings object, whose spec is","+// enabled next to jsonData as the settings API describes them (AppSettingsSpec),","+// and its secure values. settings may be nil: jsonData is then any object.","+func withSettingsSchema(kind *app.ManifestVersionKind, settings *pluginschema.Settings) error {","+\tif settings != nil {","+\t\tfor _, v := range settings.SecureValues {","+\t\t\tif !slices.ContainsFunc(kind.SecureValues, func(s app.ManifestVersionKindSecureValue) bool { return s.Key == v.Key }) {","+\t\t\t\tkind.SecureValues = append(kind.SecureValues, app.ManifestVersionKindSecureValue{Key: v.Key, Description: v.Description})","+\t\t\t}","+\t\t}","+\t}","+\tsettingsSpec, err := toMap(AppSettingsSpec(settings))","+\tif err != nil {","+\t\treturn err","+\t}","+\tschema, err := app.VersionSchemaFromMap(map[string]any{","+\t\tkind.Kind: map[string]any{","+\t\t\t\"type\": \"object\",","+\t\t\t\"properties\": map[string]any{","+\t\t\t\t\"spec\": map[string]any{\"$ref\": \"#/components/schemas/\" + settingsSpecSchemaName},","+\t\t\t},","+\t\t\t\"required\": []any{\"spec\"},","+\t\t},","+\t\tsettingsSpecSchemaName: settingsSpec,","+\t}, kind.Kind)","+\tif err != nil {","+\t\treturn err","+\t}","+\tkind.Schema = schema","+\treturn nil","+}","+","+// clonePathProps copies props, so publishing the manifest's routes never","+// changes the schema's, or the other way around.","+func clonePathProps(props spec3.PathProps) (spec3.PathProps, error) {","+\traw, err := json.Marshal(&spec3.Path{PathProps: props})","+\tif err != nil {","+\t\treturn spec3.PathProps{}, err","+\t}","+\tvar out spec3.Path","+\tif err := json.Unmarshal(raw, &out); err != nil {","+\t\treturn spec3.PathProps{}, err","+\t}","+\treturn out.PathProps, nil","+}","+","+func toMap(v any) (map[string]any, error) {","+\traw, err := json.Marshal(v)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tout := map[string]any{}","+\treturn out, json.Unmarshal(raw, &out)","+}","+","+func addMissingComponents[T any](dst *map[string]T, src map[string]T) {","+\tfor name, v := range src {","+\t\tif _, ok := (*dst)[name]; ok {","+\t\t\tcontinue","+\t\t}","+\t\tif *dst == nil {","+\t\t\t*dst = map[string]T{}","+\t\t}","+\t\t(*dst)[name] = v","+\t}","+}","+","+// cloneComponents copies c's maps, so adding the schema's components to the","+// settings manifest leaves its foundation's unchanged.","+func cloneComponents(c app.ManifestVersionOpenAPIComponents) app.ManifestVersionOpenAPIComponents {","+\treturn app.ManifestVersionOpenAPIComponents{","+\t\tSchemas:   maps.Clone(c.Schemas),","+\t\tResponses: maps.Clone(c.Responses),","+\t\tExamples:  maps.Clone(c.Examples),","+\t}","+}"],"additions":159,"deletions":0,"truncated":false},{"path":"pkg/plugins/definition/settings_schema_test.go","lines":["@@ -0,0 +1,129 @@","+package definition","+","+import (","+\t\"encoding/json\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\t\"k8s.io/kube-openapi/pkg/spec3\"","+\t\"k8s.io/kube-openapi/pkg/validation/spec\"","+","+\t\"github.com/grafana/grafana-app-sdk/app\"","+\t\"github.com/grafana/grafana-app-sdk/app/appmanifest/v1alpha2\"","+\t\"github.com/grafana/grafana-plugin-sdk-go/experimental/pluginschema\"","+)","+","+func testPluginSchema() *pluginschema.PluginSchema {","+\treturn &pluginschema.PluginSchema{","+\t\tSettingsSchema: &pluginschema.Settings{","+\t\t\tSpec: &spec.Schema{SchemaProps: spec.SchemaProps{","+\t\t\t\tType:       []string{\"object\"},","+\t\t\t\tProperties: map[string]spec.Schema{\"message\": *spec.StringProperty()},","+\t\t\t\tRequired:   []string{\"message\"},","+\t\t\t}},","+\t\t\tSecureValues: []pluginschema.SecureValueInfo{{Key: \"apiKey\", Description: \"a secret\", Required: true}},","+\t\t},","+\t\tRoutes: &pluginschema.Routes{","+\t\t\tPaths: map[string]*spec3.Path{","+\t\t\t\t\"/resources/clients\": {PathProps: spec3.PathProps{Get: &spec3.Operation{OperationProps: spec3.OperationProps{","+\t\t\t\t\tOperationId: \"getClients\",","+\t\t\t\t\tResponses: &spec3.Responses{ResponsesProps: spec3.ResponsesProps{StatusCodeResponses: map[int]*spec3.Response{","+\t\t\t\t\t\t200: {ResponseProps: spec3.ResponseProps{Content: map[string]*spec3.MediaType{","+\t\t\t\t\t\t\t\"application/json\": {MediaTypeProps: spec3.MediaTypeProps{Schema: spec.RefSchema(\"#/components/schemas/ClientResults\")}},","+\t\t\t\t\t\t}}},","+\t\t\t\t\t}}},","+\t\t\t\t}}}},","+\t\t\t\t// The schema does not say where a proxy route forwards to.","+\t\t\t\t\"/proxy/remote\": {PathProps: spec3.PathProps{Get: &spec3.Operation{}}},","+\t\t\t},","+\t\t\tComponents: &spec3.Components{Schemas: map[string]*spec.Schema{","+\t\t\t\t\"ClientResults\": {SchemaProps: spec.SchemaProps{Type: []string{\"object\"}}},","+\t\t\t}},","+\t\t},","+\t}","+}","+","+func TestNewSettingsManifestPublishesThePluginSchema(t *testing.T) {","+\tp := appWithRoutes(nil)","+\tp.Schemas = map[string]*pluginschema.PluginSchema{SettingsAPIVersion: testPluginSchema()}","+\tmanifest, err := NewSettingsManifest(p, testMatcher)","+\trequire.NoError(t, err)","+\trequire.Len(t, manifest.Versions, 1)","+\tversion := manifest.Versions[0]","+\trequire.Len(t, version.Kinds, 1)","+\tkind := version.Kinds[0]","+","+\trequire.NotNil(t, kind.Schema, \"the settings kind is described by the plugin's settings spec\")","+\tschemas := kind.Schema.AsOpenAPI3SchemasMap()","+\trequire.Contains(t, schemas, \"Settings\")","+\traw, err := json.Marshal(schemas[settingsSpecSchemaName])","+\trequire.NoError(t, err)","+\trequire.JSONEq(t, `{\"type\":\"object\",\"properties\":{","+\t\t\"enabled\":{\"type\":\"boolean\",\"description\":\"can be executed\"},","+\t\t\"jsonData\":{\"type\":\"object\",\"properties\":{\"message\":{\"type\":\"string\"}},\"required\":[\"message\"]}","+\t}}`, string(raw))","+\trequire.Equal(t, []app.ManifestVersionKindSecureValue{{Key: \"apiKey\", Description: \"a secret\"}}, kind.SecureValues)","+","+\tclients := version.OpenAPI.Paths[SettingsResourcesRoot+\"/clients\"]","+\trequire.NotNil(t, clients.Get, \"the schema's resource routes are published\")","+\trequire.Equal(t, \"getClients\", clients.Get.OperationId)","+\trequire.NotContains(t, version.OpenAPI.Paths, SettingsProxyRoot+\"/remote\", \"proxy routes need a forwarding target\")","+\trequire.Contains(t, version.OpenAPI.Components.Schemas, \"ClientResults\", \"with the components they refer to\")","+","+\t// The manifest renders as discovery serves it.","+\tspec, err := v1alpha2.SpecFromManifestData(*manifest)","+\trequire.NoError(t, err)","+\trequire.Contains(t, spec.Versions[0].Kinds[0].Schemas, \"Settings\")","+\trequire.Contains(t, spec.Versions[0].Openapi.Paths, SettingsResourcesRoot+\"/clients\")","+","+\t// The manifest has its own copy of the routes.","+\tclients.Get.OperationId = \"changed\"","+\trequire.Equal(t, \"getClients\", p.Schemas[SettingsAPIVersion].Routes.Paths[\"/resources/clients\"].Get.OperationId)","+}","+","+func TestNewSettingsManifestKeepsWhatItsFoundationDeclares(t *testing.T) {","+\tfoundation := &app.ManifestData{AppName: \"example-app\", Group: \"example-app\", Versions: []app.ManifestVersion{{","+\t\tName:   SettingsAPIVersion,","+\t\tServed: true,","+\t\tOpenAPI: app.ManifestVersionOpenAPI{","+\t\t\tPaths: map[string]spec3.PathProps{","+\t\t\t\tSettingsResourcesRoot + \"/clients\": {Get: &spec3.Operation{OperationProps: spec3.OperationProps{OperationId: \"declared\"}}},","+\t\t\t},","+\t\t\tComponents: app.ManifestVersionOpenAPIComponents{Schemas: map[string]spec.Schema{","+\t\t\t\t\"ClientResults\": {SchemaProps: spec.SchemaProps{Description: \"declared\"}},","+\t\t\t}},","+\t\t},","+\t}}}","+\tp := appWithRoutes(nil, foundation)","+\tp.Schemas = map[string]*pluginschema.PluginSchema{SettingsAPIVersion: testPluginSchema()}","+\tmanifest, err := NewSettingsManifest(p, testMatcher)","+\trequire.NoError(t, err)","+\tversion := manifest.Versions[0]","+\trequire.Equal(t, \"declared\", version.OpenAPI.Paths[SettingsResourcesRoot+\"/clients\"].Get.OperationId)","+\trequire.Equal(t, \"declared\", version.OpenAPI.Components.Schemas[\"ClientResults\"].Description)","+\trequire.NotNil(t, version.Kinds[0].Schema, \"the settings spec is still added\")","+\trequire.Len(t, foundation.Versions[0].OpenAPI.Components.Schemas, 1, \"the foundation is left unchanged\")","+}","+","+func TestNewSettingsManifestWithoutAPluginSchema(t *testing.T) {","+\tfor name, schemas := range map[string]map[string]*pluginschema.PluginSchema{","+\t\t\"no schema\":                 nil,","+\t\t\"a schema without settings\": {SettingsAPIVersion: {Routes: testPluginSchema().Routes}},","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tp := appWithRoutes(nil)","+\t\t\tp.Schemas = schemas","+\t\t\tmanifest, err := NewSettingsManifest(p, testMatcher)","+\t\t\trequire.NoError(t, err)","+\t\t\tkind := manifest.Versions[0].Kinds[0]","+\t\t\trequire.NotNil(t, kind.Schema, \"the settings kind is always described\")","+\t\t\traw, err := json.Marshal(kind.Schema.AsOpenAPI3SchemasMap()[settingsSpecSchemaName])","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.JSONEq(t, `{\"type\":\"object\",\"properties\":{","+\t\t\t\t\"enabled\":{\"type\":\"boolean\",\"description\":\"can be executed\"},","+\t\t\t\t\"jsonData\":{\"type\":\"object\",\"additionalProperties\":true}","+\t\t\t}}`, string(raw), \"jsonData is any object\")","+\t\t\trequire.Empty(t, kind.SecureValues)","+\t\t})","+\t}","+}"],"additions":129,"deletions":0,"truncated":false},{"path":"pkg/router/AGENTS.md","lines":["@@ -95,7 +95,9 @@ especially `specs/2026-09-25-router-design-notes.md`. Open work is tracked in","   app_settings_plugins` names, when a remote legacy reader and app-access checker are supplied","   (`PluginDependencies.Settings`). The legacy side is the same `settingsStorage` ST uses","   (`appsettings.NewReadOnlyLegacySettingsStore`), so ST and MT return identical objects. Storage","-  is selected by the migration policy, and only get/list are exposed. Health and resources call","+  is selected by the migration policy, and only get/list are exposed. The OpenAPI matches ST's,","+  plugin schema and custom routes included, with only the settings kind's writes left out","+  (`TestReadOnlySettingsOpenAPI`). Health and resources call","   the deployment's v2 client; proxy uses the shared ST handler and feature gate. The local","   standalone plugin loader still serves no settings."," - **One bad backend or plugin fails only its own group;** it must never stop the reconcile loop."],"additions":3,"deletions":1,"truncated":false},{"path":"pkg/router/cloud_settings_auth.go","lines":["@@ -11,9 +11,10 @@ import ("," "," \t\"github.com/grafana/grafana-plugin-sdk-go/backend\""," \t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/services/pluginsintegration/clientmiddleware\""," )"," ","-const accessTokenHeader = \"X-Access-Token\"","+const accessTokenHeader = clientmiddleware.AccessTokenHeaderName"," "," // newV2AuthenticationMiddleware authenticates v2 calls to a plugin the way"," // v3 calls are (see v3.WithAuthentication): each request carries an access","@@ -21,6 +22,11 @@ const accessTokenHeader = \"X-Access-Token\""," // the request's namespace. Missing caller credentials fail the request, except"," // for Grafana's own service identity, which uses the service token. A nil"," // exchanger leaves requests unauthenticated, as for v3.","+//","+// Both the cloud loader and the local (single-tenant) loader use it. In the","+// local loader it wraps Grafana's plugin client, whose core middleware then","+// keeps the token as the request's only identity (see","+// clientmiddleware.WithExchangedAccessToken)."," func newV2AuthenticationMiddleware(pluginID string, exchanger authnlib.TokenExchanger) backend.HandlerMiddleware {"," \treturn backend.HandlerMiddlewareFunc(func(next backend.Handler) backend.Handler {"," \t\tif exchanger == nil {","@@ -42,7 +48,8 @@ type v2AuthenticationHandler struct {"," "," func (h *v2AuthenticationHandler) CheckHealth(ctx context.Context, req *backend.CheckHealthRequest) (*backend.