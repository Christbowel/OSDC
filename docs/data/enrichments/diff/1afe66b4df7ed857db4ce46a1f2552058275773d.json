a quoted value\",","+\t\t\tin:   `Text/Plain; NAME=\"a\\\"; B\"; Charset=UTF-8`,","+\t\t\twant: `text/plain; name=\"a\\\"; B\"; charset=UTF-8`,","+\t\t},","+\t\t{","+\t\t\tname: \"unterminated quoted value\",","+\t\t\tin:   `Text/Plain; NAME=\"abc`,","+\t\t\twant: `text/plain; name=\"abc`,","+\t\t},","+\t\t{","+\t\t\t// A bare parameter with no '=' must not swallow what follows it.","+\t\t\tname: \"valueless parameter\",","+\t\t\tin:   \"Text/Plain; FLAG; CHARSET=UTF-8\",","+\t\t\twant: \"text/plain; flag; charset=UTF-8\",","+\t\t},","+\t\t{","+\t\t\tname: \"trailing semicolon\",","+\t\t\tin:   \"Text/Plain;\",","+\t\t\twant: \"text/plain;\",","+\t\t},","+\t\t{","+\t\t\tname: \"empty parameter between semicolons\",","+\t\t\tin:   \"Text/Plain;; CHARSET=UTF-8\",","+\t\t\twant: \"text/plain;; charset=UTF-8\",","+\t\t},","+\t}","+","+\tfor _, tc := range testCases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\th := &fasthttp.RequestHeader{}","+\t\t\th.SetContentType(tc.in)","+","+\t\t\trequire.Equal(t, tc.want, string(normalizeContentTypeMediaType(h)))","+\t\t\t// The fold is in place, so the header itself must now read back","+\t\t\t// normalized — that is what makes fasthttp's case-sensitive","+\t\t\t// multipart lookups work.","+\t\t\trequire.Equal(t, tc.want, string(h.ContentType()))","+\t\t})","+\t}","+}"],"additions":82,"deletions":0,"truncated":false},{"path":"redirect.go","lines":["@@ -12,7 +12,6 @@ import ("," \t\"sync\""," "," \t\"github.com/gofiber/utils/v2\"","-\tutilsbytes \"github.com/gofiber/utils/v2/bytes\""," \t\"github.com/valyala/bytebufferpool\""," \t\"github.com/valyala/fasthttp\""," ","@@ -192,9 +191,10 @@ func (r *Redirect) With(key, value string, level ...uint8) *Redirect {"," // This method can send form, multipart form, query data to redirected route."," // You can get them by using: Redirect().OldInputs(), Redirect().OldInput()"," func (r *Redirect) WithInput() *Redirect {","-\t// Get content-type","-\tctype :