r(t, w.Close())","+","+\t\t\tapp := New()","+\t\t\tapp.Post(\"/\", func(c Ctx) error {","+\t\t\t\tvar out struct {","+\t\t\t\t\tName string `form:\"name\"`","+\t\t\t\t}","+\t\t\t\trequire.NoError(t, c.Bind().Body(&out))","+\t\t\t\trequire.Equal(t, \"john\", out.Name)","+\t\t\t\t// The boundary value keeps its case so the request can be replayed.","+\t\t\t\trequire.Contains(t, c.Get(HeaderContentType), \"AbCdEfMixed12345\")","+\t\t\t\treturn nil","+\t\t\t})","+","+\t\t\treq := httptest.NewRequest(MethodPost, \"/\", bytes.NewReader(body.Bytes()))","+\t\t\treq.Header.Set(HeaderContentType, ctype)","+\t\t\tresp, err := app.Test(req)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, StatusOK, resp.StatusCode)","+\t\t})","+\t}","+","+\tt.Run(\"mixed-case urlencoded still binds\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tapp := New()","+\t\tapp.Post(\"/\", func(c Ctx) error {","+\t\t\tvar out struct {","+\t\t\t\tName string `form:\"name\"`","+\t\t\t}","+\t\t\trequire.NoError(t, c.Bind().Body(&out))","+\t\t\trequire.Equal(t, \"john\", out.Name)","+\t\t\treturn nil","+\t\t})","+","+\t\treq := httptest.NewRequest(MethodPost, \"/\", strings.NewReader(\"name=john\"))","+\t\treq.Header.Set(HeaderContentType, \"APPLICATION/X-WWW-FORM-URLENCODED\")","+\t\tresp, err := app.Test(req)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, StatusOK, resp.StatusCode)","+\t})","+","+\tt.Run(\"boundary case is preserved\", testBindBodyPreservesBoundary)","+}","+","+func testBindBodyPreservesBoundary(t *testing.T) {","+\tt.Parallel()","+","+\tvar body bytes.Buffer","+\tw := multipart.NewWriter(&body)","+\trequire.NoError(t, w.SetBoundary(\"AbCdEfMixedCase12345\"))","+\trequire.NoError(t, w.WriteField(\"name\", \"john\"))","+\trequire.NoError(t, w.Close())","+\traw := body.Bytes()","+","+\tconst wantCType = \"multipart/form-data; boundary=AbCdEfMixedCase12345\"","+","+\tapp := New()","+\tapp.Post(\"/\", func(c Ctx) error {","+\t\tvar out struct {","+\t\t\tName string `form:\"name\"`","+\t\t}","+\t\trequire.NoError(t, c.Bind().Body(&out))","+\t\trequire.Equal(t, \"john\", out.Name)","+","+\t\trequire.Equal(t, wantCType, c.Get(HeaderContentType))","+","+\t\t// Replaying the request from its header and body — what forwarding it","+\t\t// upstream amounts to — must still parse.","+\t\tfwd := fasthttp.AcquireRequest()","+\t\tdefer fasthttp.ReleaseRequest(fwd)","+\t\tfwd.Header.SetMethod(MethodPost)","+\t\tfwd.SetRequestURI(\"/\")","+\t\tfwd.Header.SetContentType(c.Get(HeaderContentType))","+\t\tfwd.SetBody(raw)","+","+\t\tform, err := fwd.MultipartForm()","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, []string{\"john\"}, form.Value[\"name\"])","+\t\treturn nil","+\t})","+","+\treq := httptest.NewRequest(MethodPost, \"/\", bytes.NewReader(raw))","+\treq.Header.Set(HeaderContentType, wantCType)","+\tresp, err := app.Test(req)","+\trequire.NoError(t, err)","+\trequire.Equal(t, StatusOK, resp.StatusCode)","+}","+","+// Test_Bind_Form_ContentTypeNormalization covers the Form entry point","+// directly. Bind().Body() normalizes the Content-Type before dispatching, but","+// Bind().Form() reaches the binder without going through it — so a legal","+// mixed-case media type bound nothing here and reported no error.","+func Test_Bind_Form_ContentTypeNormalization(t *testing.T) {","+\tt.Parallel()","+","+\tt.Run(\"multipart\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tvar body bytes.Buffer","+\t\tw := multipart.NewWriter(&body)","+\t\trequire.NoError(t, w.SetBoundary(\"AbCdEfMixed12345\"))","+\t\trequire.NoError(t, w.WriteField(\"name\", \"john\"))","+\t\trequire.NoError(t, w.Close())","+","+\t\tapp := New()","+\t\tapp.Post(\"/\", func(c Ctx) error {","+\t\t\tvar out struct {","+\t\t\t\tName string `form:\"name\"`","+\t\t\t}","+\t\t\trequire.NoError(t, c.Bind().Form(&out))","+\t\t\trequire.Equal(t, \"john\", out.Name)","+\t\t\treturn nil","+\t\t})","+","+\t\treq := httptest.NewRequest(MethodPost, \"/\", bytes.NewReader(body.Bytes