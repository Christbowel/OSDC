md","lines":["@@ -4,6 +4,9 @@ CHANGELOG"," 8.2"," ---"," ","+ * Add `#[RecoverableAttribute]` to declare the exceptions of a controller attribute that are passed to the controller parameter typed to receive them instead of being thrown","+ * Make `#[RateLimit]`, `#[Lock]` and `#[IsSignatureValid]` recoverable, so a controller can receive a `RateLimitExceededException`, `LockConflictedException` or `SignedUriException`","+ * Add `ControllerArgumentsEvent::getControllerReflector()`","  * Return an HTTP 204 response for controllers with a `void` return type","  * Add `Store::clear()` to remove all the entries of the HTTP cache store","  * Add the `lint:expressions` command to lint the expressions of controller attributes and the ones listed in the configuration"],"additions":3,"deletions":0,"truncated":false},{"path":"Event/ControllerArgumentsEvent.php","lines":["@@ -54,6 +54,11 @@ public function getController(): callable","         return $this->controllerEvent->getController();","     }"," ","+    public function getControllerReflector(): \\ReflectionFunctionAbstract","+    {","+        return $this->controllerEvent->getControllerReflector();","+    }","+","     /**","      * Replaces the controller and the attributes that apply to it.","      *"],"additions":5,"deletions":0,"truncated":false},{"path":"EventListener/ControllerAttributesListener.php","lines":["@@ -14,6 +14,8 @@"," use Symfony\\Component\\EventDispatcher\\EventSubscriberInterface;"," use Symfony\\Component\\ExpressionLanguage\\ConstantFunctionProvider;"," use Symfony\\Component\\ExpressionLanguage\\ExpressionLanguage;","+use Symfony\\Component\\HttpFoundation\\Request;","+use Symfony\\Component\\HttpKernel\\Attribute\\RecoverableAttribute;"," use Symfony\\Component\\HttpKernel\\Event\\ControllerArgumentsEvent;"," use Symfony\\Component\\HttpKernel\\Event\\ControllerAttributeEvent;"," use Symfony\\Component\\HttpKernel\\Event\\ControllerEvent;","@@ -32,6 +34,13 @@ class_exists(ExpressionLanguage::class);","  */"," class ControllerAttributesListener implements EventSubscriberInterface"," {","+    /**","+     * The failures of the recoverable attributes handled before the arguments are resolved, with the exceptions their attribute declares.","+     *","+     * @var \\WeakMap<Request, list<array{\\Throwable, list<class-string<\\Throwable>>}>>","+     */","+    private \\WeakMap $recoveredFailures;","+","     /**","      * @param array<string, array<class-string, true>> $attributesWithListenersByEvent","      */","@@ -39,11 +48,15 @@ public function __construct(","         private readonly array $attributesWithListenersByEvent,","         private ?ExpressionLanguage $expressionLanguage = null,","     ) {","+        $this->recoveredFailures = new \\WeakMap();","         $this->expressionLanguage ??= class_exists(ExpressionLanguage::class, false) ? new ExpressionLanguage(null, class_exists(ConstantFunctionProvider::class) ? [new ConstantFunctionProvider(['*', '*::*'])] : []) : null;","     }"," ","     private static array $attributeHierarchyCache = [];"," ","+    /** @var array<class-string, list<class-string<\\Throwable>>> */","+    private static array $recoverableExceptionsCache = [];","+","     /**","      * Attributes are cloned for each request, since listeners can change them.","      *","@@ -59,6 +72,10 @@ public function beforeController(ControllerEvent|ControllerArgumentsEvent $event","         $attributes = $this->getAttributes($event, $controller);","         $swapBudget = \\count($attributes) << 3;"," ","+        if ($event instanceof ControllerArgumentsEvent) {","+            $this->injectRecoveredFailures($event);","+        }","+","         dispatch_attributes:","         foreach ($attributes as $attribute) {","             if (!$attributeEventNames = $this->getAttributeEventNames($attribute, $eventName)) {","@@ -66,7 +83,15 @@ public function beforeController(ControllerEvent|ControllerArgumentsEvent $event","             }"," ","             foreach ($attributeEventNames as $attributeEventName) {","-                $dispatcher->dispatch(new ControllerAttributeEvent($attribute, $event, $this->expressionLanguage), $attributeEventName);","+                try {","+                    $dispatcher->dispatch(new ControllerAttributeEvent($attribute, $event, $this->expressionLanguage), $attributeEventName);","+                } catch (\\Throwable $e) {","+                    if (!$this->recover($event, $attribute, $e)) {","+                        throw $e;","+                    }","+","+                    break;","+                }"," ","                 if ($event->isPropagationStopped()) {","                     return;","@@ -103,6 +128,128 @@ public function afterController(KernelEvent $event, string $eventName, EventDisp","         }","     }"," ","+    /**","+     * Passes the failure of a recoverable attribute to the controller parameter typed to receive it, once the arguments are resolved.","+     */","+    private function recover(ControllerEvent|ControllerArgumentsEvent $event, object $attribute, \\Throwable $exception): bool","+    {","+        if (!$classes = self::getRecoverableExceptions($attribute::class)) {","+            return false;","+        }","+","+        if (null === $recoverable = self::findRecoverableException($classes, $exception)) {","+            return false;","+        }","+","+        if ($event instanceof ControllerArgumentsEvent) {","+            return $this->inject($event, $recoverable, $classes);","+        }","+","+        if (!array_any($event->getControllerReflector()->getParameters(), static fn (\\ReflectionParameter $parameter): bool => self::accepts($parameter, $recoverable, $classes))) {","+            return false;","+        }","+","+        $request = $event->getRequest();","+        $this->recoveredFailures[$request] = [...$this->recoveredFailures[$request] ?? [], [$recoverable, $classes]];","+","+        return true;","+    }","+","+    private function injectRecovere