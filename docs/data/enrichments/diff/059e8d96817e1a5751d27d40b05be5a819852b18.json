erableExceptionsCache[$class])) {","+            return self::$recoverableExceptionsCache[$class];","+        }","+","+        $exceptions = [];","+","+        for ($r = new \\ReflectionClass($class); $r; $r = $r->getParentClass()) {","+            foreach ($r->getAttributes(RecoverableAttribute::class) as $recoverable) {","+                array_push($exceptions, ...$recoverable->newInstance()->exceptions);","+            }","+        }","+","+        return self::$recoverableExceptionsCache[$class] = $exceptions;","+    }","+","+    /**","+     * @param list<class-string<\\Throwable>> $recoverableExceptions","+     */","+    private static function accepts(\\ReflectionParameter $parameter, \\Throwable $exception, array $recoverableExceptions): bool","+    {","+        if ($parameter->isVariadic() || !$type = $parameter->getType()) {","+            return false;","+        }","+","+        foreach ($type instanceof \\ReflectionUnionType ? $type->getTypes() : [$type] as $t) {","+            if (!$t instanceof \\ReflectionNamedType || $t->isBuiltin() || !is_a($exception, $t->getName())) {","+                continue;","+            }","+","+            // a broad type like \\Exception would also receive failures the controller doesn't expect","+            if (array_any($recoverableExceptions, static fn (string $class): bool => is_a($t->getName(), $class, true))) {","+                return true;","+            }","+        }","+","+        return false;","+    }","+","     /**","      * @return list<object>","      */"],"additions":148,"deletions":1,"truncated":false},{"path":"EventListener/LockAttributeListener.php","lines":["@@ -226,7 +226,7 @@ private function acquire(SharedLockInterface $lock, Lock $attribute, string $key","         }"," ","         if (!$acquired) {","-            throw new ConcurrentRequestHttpException($key, $attribute->factory);","+            throw new ConcurrentRequestHttpException($key, $attribute->factory, new LockConflictedException());