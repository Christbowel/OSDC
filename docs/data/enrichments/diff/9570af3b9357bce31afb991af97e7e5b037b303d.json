uct SQLExportDMLHelpers {"," \t                                                  const LogicalPlanVerificationPath &path);"," \t//! Whether this operator is a data-modifying statement body: a DML operator or its RETURNING projection."," \tstatic bool MatchDMLBody(LogicalOperator &op);","+\t//! Whether the statement-body chain itself crosses a replaced source boundary, in which case","+\t//! the ordinary relational export must handle it instead of the statement export.","+\tstatic bool ContainsReplacedBoundary(const LogicalPlanSQLExportContext &context, LogicalOperator &op);"," \t//! Export a data-modifying statement body outside the plan root (e.g. a materialized CTE side)."," \tstatic LogicalPlanSQLExportResult ExportBody(LogicalPlanSQLExportContext &context, LogicalOperator &op,"," \t                                             const LogicalPlanVerificationPath &path);"],"additions":5,"deletions":0,"truncated":false},{"path":"src/planner/sql_export/logical_plan_sql_exporter.cpp","lines":["@@ -264,6 +264,34 @@ LogicalPlanSQLExportContext::ExportChild(LogicalOperator &child, const LogicalPl"," \treturn ExportChild(child, path);"," }"," ","+LogicalPlanVerificationResult<LogicalPlanSQLExportedChild>","+LogicalPlanSQLExportContext::ExportRoot(LogicalOperator &root, const LogicalPlanVerificationPath &path,","+                                        const vector<LogicalPlanSQLExportSource> &sources,","+                                        const optional<vector<Identifier>> &output_names) {","+\tSourceScope scope(*this, sources);","+\tauto returning = SQLExportDMLHelpers::MatchReturningRoot(root);","+\t// a replaced root or a replaced statement below it exports through the ordinary","+\t// relational path, which reads the supplied replacement instead of the statement","+\tif (!returning || SQLExportDMLHelpers::ContainsReplacedBoundary(*this, root)) {","+\t\treturn ExportChild(root, path);","+\t}","+\t// consumers of an exported statement address its RETURNING columns p