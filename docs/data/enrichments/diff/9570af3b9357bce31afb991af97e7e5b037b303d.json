LogicalPlanVerificationResult<LogicalPlanSQLExportedChild> {","-\t\tif (!SQLExportDMLHelpers::MatchDMLBody(*cte.children[1])) {","+\t\tif (!SQLExportDMLHelpers::MatchDMLBody(*cte.children[1]) ||","+\t\t    SQLExportDMLHelpers::ContainsReplacedBoundary(export_context, *cte.children[1])) {"," \t\t\treturn export_context.ExportChild(*cte.children[1], consumer_path);"," \t\t}"," \t\tauto body = SQLExportDMLHelpers::ExportBody(export_context, *cte.children[1], consumer_path);","@@ -255,7 +256,7 @@ LogicalPlanSQLExportContext::ExportNamedProducer(LogicalOperator &op, const Logi"," \t}"," \t// A data-modifying body exports as the statement itself; parsed DML nodes are legal CTE bodies."," \t// This runs before the identity-projection reduction so a RETURNING projection stays intact.","-\tif (SQLExportDMLHelpers::MatchDMLBody(op)) {","+\tif (SQLExportDMLHelpers::MatchDMLBody(op) && !SQLExportDMLHelpers::ContainsReplacedBoundary(*this, op)) {"," \t\tauto exported = SQLExportDMLHelpers::ExportBody(*this, op, path);"," \t\tif (exported.HasError()) {"," \t\t\treturn LogicalPlanVerificationResult<LogicalPlanSQLExportedChild>::Failure(exported);"],"additions":3,"deletions":2,"truncated":false},{"path":"src/planner/sql_export/sql_export_dml.cpp","lines":["@@ -421,6 +421,22 @@ bool SQLExportDMLHelpers::MatchDMLBody(LogicalOperator &op) {"," \t}"," }"," ","+bool SQLExportDMLHelpers::ContainsReplacedBoundary(const LogicalPlanSQLExportContext &context, LogicalOperator &op) {","+\treference<LogicalOperator> current(op);","+\twhile (true) {","+\t\tif (context.FindSource(current)) {","+\t\t\treturn true;","+\t\t}","+\t\tauto &node = current.get();","+\t\tif (node.type == LogicalOperatorType::LOGICAL_PROJECTION && node.children.size() == 1 &&","+\t\t    MatchDMLBody(*node.children[0])) {","+\t\t\tcurrent = *node.children[0];","+\t\t\tcontinue;","+\t\t}","+\t\treturn false;","+\t}","+}","+"," bool SQLExportDMLHelpers::IsDMLNode(const QueryNode &query) {"," \tswitch (query.type) {"," \tcase QueryNodeType::INSERT_QUERY_NODE:"],"additions":16,"deletions":0,"truncated":false},{"path":"src/planner/sql_export/sql_export_statements.cpp","lines":["@@ -255,6 +255,25 @@ LogicalPlanSQLExportResult SQLExportStatementHelpers::ExportCreateTableAsNode(Lo"," \treturn LogicalPlanSQLExportResult::Success({std::move(node), std::move(fields.GetValue())});"," }"," ","+QueryNode &SQLExportStatementHelpers::SourceDefinitionNode(QueryNode &query) {","+\tswitch (query.type) {","+\tcase QueryNodeType::COPY_QUERY_NODE: {","+\t\tauto &info = *query.Cast<CopyQueryNode>().info;","+\t\tD_ASSERT(info.select_statement);","+\t\treturn SourceDefinitionNode(*info.select_statement);","+\t}","+\tcase QueryNodeType::STATEMENT_NODE: {","+\t\tauto &statement = query.Cast<StatementNode>().stmt;","+\t\tD_ASSERT(statement.type == StatementType::CREATE_STATEMENT);","+\t\tauto &info = statement.Cast<CreateStatement>().info->Cast<CreateTableInfo>();","+\t\tD_ASSERT(info.query && info.query->node);","+\t\treturn *info.query->node;","+\t}","+\tdefault:","+\t\treturn query;","+\t}","+}","+"," LogicalPlanSQLExportResult LogicalCopyToFile::ToSQL(LogicalPlanSQLExportContext &context,","                                                     const LogicalPlanVerificationPath &path) {"," \tif (auto issue = StatementBoundaryIssue(context, path)) {"],"additions":19,"deletions":0,"truncated":false},{"path":"test/sql_export/CMakeLists.txt","lines":["@@ -14,6 +14,7 @@ add_library_unity(","   sql_export_plan_pivot.cpp","   sql_export_plan_relations.cpp","   sql_export_plan_sources.cpp","+  sql_export_plan_statements.cpp","   sql_export_plan_values.cpp","   sql_export_statement_verification.cpp)"," "],"additions":1,"deletions":0,"truncated":false},{"path":"test/sql_export/sql_export_plan_statements.cpp","lines":["@@ -0,0 +1,292 @@","+// SQL cannot reach the ExportWithSources replacement API, so statement-root fragment export","+// is exercised here. The SQL-visible statement export is covered by test/sql/sql_export.","+","+#include \"catch.hpp\"","+#include \"duckdb/optimizer/optimizer.hpp\"","+#include \"duckdb/parser/parser.hpp\"","+#include \"duckdb/parser/statement/select_statement.hpp\"","+#include \"duckdb/planner/logical_plan_sql_exporter.hpp\"","+#include \"duckdb/planner/operator/logical_get.hpp\"","+#include \"duckdb/planner/planner.hpp\"","+#include \"logical_plan_sql_export_test_helpers.hpp\"","+#include \"test_helpers.hpp\"","+","+using namespace duckdb;","+","+namespace logical_plan_sql_export_test {","+","+static unique_ptr<LogicalOperator> OptimizeStatementPlan(Connection &connection, const string &query) {","+\tParser parser(*connection.context);","+\tparser.ParseQuery(query);","+\tREQUIRE(parser.statements.size() == 1);","+\tPlanner planner(*connection.context);","+\tplanner.CreatePlan(std::move(parser.statements[0]));","+\tOptimizer optimizer(*planner.binder, *connection.context);","+\tauto plan = optimizer.Optimize(std::move(planner.plan));","+\tplan->ResolveOperatorTypes();","+\treturn plan;","+}","+","+static optional_ptr<LogicalGet> FindRangeGet(LogicalOperator &op) {","+\tif (op.type == LogicalOperatorType::LOGICAL_GET &&","+\t    op.Cast<LogicalGet>().function.GetName().GetIdentifierName() == \"range\") {","+\t\treturn &op.Cast<LogicalGet>();","+\t}","+\tfor (auto &child : op.children) {","+\t\tif (auto found = FindRangeGet(*child)) {","+\t\t\treturn found;","+\t\t}","+\t}","+\treturn nullptr;","+}","+","+static LogicalPlanSQLExportRelation StatementReplacement(Connection &connection, LogicalOperator &op,","+                                                         const string &sql) {","+\tParser parser(*connection.context);","+\tparser.ParseQuery(sql);","+\tREQUIRE(parser.statements.size() == 1);","+\tauto bindings = op.GetColumnBindings();","+\tREQUIRE(bindings.size() == op.types.size());","+\tvector<LogicalPlanSQLExportField> fields;","+\tfor (idx_t i = 0; i < bindings.size(); i++) {","+\t\tfields.push_back({bindings[i], op.types[i]});","+\t}","+\treturn {std::move(parser.statements[0]->Cast<SelectStatement>().node), std::move(fields)};","+}","+","+static string ExportStatementFragment(Connection &connection, const string &statement, const string &source_sql,","+                                      const LogicalPlanSQLExportOptions &options = {}) {","+\tauto plan = OptimizeStatementPlan(connection, statement);","+\tauto range_get = FindRangeGet(*plan);","+\tREQUIRE(range_get);","+\tvector<LogicalPlanSQLExportReplacement> replacements;","+\treplacements.push_back({*range_get, StatementReplacement(connection, *range_get, source_sql)});","+\tauto exported = LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements, options);","+\tREQUIRE(exported.IsSuccess());","+\treturn exported.GetValue().query->ToString();","+}","+","+TEST_CASE(\"Data-modifying fragment roots accept replaced source subtrees\",","+          \"[sql_export][logical_plan_sql_export][statement_fragments]\") {","+\tDuckDB db(nullptr);","+\tConnection connection(db);","+\tREQUIRE_NO_FAIL(connection.Query(\"CREATE TABLE frag_target(a BIGINT, b VARCHAR)\"));","+\tREQUIRE_NO_FAIL(connection.Query(\"INSERT INTO frag_target VALUES (1, 'one'), (2, 'two'), (3, 'three')\"));","+\tconnection.BeginTransaction();","+","+\tSECTION(\"insert root\") {","+\t\tauto sql = ExportStatementFragment(connection, \"INSERT INTO frag_target SELECT i, 'x' || i FROM range(3) t(i)\",","+\t\t                                   \"SELECT 7::BIGINT AS i\");","+\t\tREQUIRE(sql.find(\"INSERT INTO\") != string::npos);","+\t\tREQUIRE(sql.find(\"__export_source\") != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT b FROM frag_target WHERE a = 7\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value(\"x7\"));","+\t}","+\tSECTION(\"update root\") {","+\t\tauto sql = ExportStatementFragment(connection,","+\t\t                                   \"UPDATE frag_target SET b = 'u' WHERE a IN (SELECT i FROM range(10) t(i))\",","+\t\t                                   \"SELECT 1::BIGINT AS i\");","+\t\tREQUIRE(sql.find(\"UPDATE\") != string::npos);","+\t\tREQUIRE(sql.find(\"__export_source\") != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT a FROM frag_target WHERE b = 'u'\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(1));","+\t}","+\tSECTION(\"delete root\") {","+\t\tauto sql = ExportStatementFragment(","+\t\t    connection, \"DELETE FROM frag_target WHERE a IN (SELECT i FROM range(10) t(i))\", \"SELECT 2::BIGINT AS i\");","+\t\tREQUIRE(sql.find(\"DELETE FROM\") != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT a FROM frag_target ORDER BY a\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 2);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(1));","+\t\tREQUIRE(result->Collection().GetValue(0, 1) == Value::BIGINT(3));","+\t}","+\tSECTION(\"merge root\") {","+\t\tauto sql = ExportStatementFragment(connection,","+\t\t                                   \"MERGE INTO frag_target USING (SELECT i AS a, 'm' || i AS b FROM range(5) \"","+\t\t                                   \"t(i)) s ON frag_target.a = s.a \"","+\t\t                                   \"WHEN MATCHED THEN UPDATE SET b = s.b \"","+\t\t                                   \"WHEN NOT MATCHED THEN INSERT VALUES (s.a, s.b)\",","+\t\t                                   \"SELECT 2::BIGINT AS i UNION ALL SELECT 9::BIGINT AS i\");","+\t\t// the source definitions render as the top-level WITH of the merge statement","+\t\tREQUIRE(sql.rfind(\"WITH\", 0) == 0);","+\t\tREQUIRE(sql.find(\"__export_source\") != string::npos);","+\t\tREQUIRE(sql.find(\"MERGE INTO\") != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT b FROM frag_target WHERE a IN (2, 9) ORDER BY a\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 2);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value(\"m2\"));","+\t\tREQUIRE(result->Collection().GetValue(0, 1) == Value(\"m9\"));","+\t}","+\tSECTION(\"merge consuming a materialized CTE\") {","+\t\tauto sql = ExportStatementFragment(connection,","+\t\t                                   \"WITH src AS MATERIALIZED (SELECT i FROM range(3) t(i)) \"","+\t\t                                   \"MERGE INTO frag_target USING (SELECT i AS a, 'c' AS b FROM src) s \"","+\t\t                                   \"ON frag_target.a = s.a WHEN MATCHED THEN UPDATE SET b = s.b\",","+\t\t                                   \"SELECT 3::BIGINT AS i\");","+\t\t// the replaced source precedes the consumer definition in the top-level WITH","+\t\tREQUIRE(sql.find(\"__export_source\") != string::npos);","+\t\tREQUIRE(sql.find(\"__export_source\") < sql.find(\"MERGE INTO\"));","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT b FROM frag_target WHERE a = 3\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value(\"c\"));","+\t}","+\tSECTION(\"returning aliases positionally\") {","+\t\tauto sql = ExportStatementFragment(connection,","+\t\t                                   \"INSERT INTO frag_target SELECT i, 'r' FROM range(2) t(i) RETURNING b, a\",","+\t\t                                   \"SELECT 11::BIGINT AS i UNION ALL SELECT 12::BIGINT AS i\");","+\t\tREQUIRE(sql.find(\"RETURNING\") != string::npos);","+\t\tauto result = connection.Query(sql);","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->ColumnCount() == 2);","+\t\tREQUIRE(result->ColumnName(0) == \"c0\");","+\t\tREQUIRE(result->ColumnName(1) == \"c1\");","+\t\tREQUIRE(result->RowCount() == 2);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value(\"r\"));","+\t}","+\tSECTION(\"returning honors explicit output names\") {","+\t\tLogicalPlanSQLExportOptions options;","+\t\toptions.output_names = vector<Identifier> {Identifier(\"written_b\"), Identifier(\"written_a\")};","+\t\tauto sql = ExportStatementFragment(connection,","+\t\t                                   \"INSERT INTO frag_target SELECT i, 'n' FROM range(1) t(i) RETURNING b, a\",","+\t\t                                   \"SELECT 21::BIGINT AS i\", options);","+\t\tauto result = connection.Query(sql);","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->ColumnName(0) == \"written_b\");","+\t\tREQUIRE(result->ColumnName(1) == \"written_a\");","+\t}","+\tconnection.Rollback();","+}","+","+TEST_CASE(\"Write statement fragment roots carry definitions in their source query\",","+          \"[sql_export][logical_plan_sql_export][statement_fragments]\") {","+\tDuckDB db(nullptr);","+\tConnection connection(db);","+\tconnection.BeginTransaction();","+","+\tSECTION(\"create table as\") {","+\t\tauto sql = ExportStatementFragment(connection, \"CREATE TABLE frag_made AS SELECT i AS x FROM range(3) t(i)\",","+\t\t                                   \"SELECT 7::BIGINT AS i\");","+\t\t// the statement head cannot carry a WITH clause, the definitions live in the source query","+\t\tREQUIRE(sql.rfind(\"CREATE TABLE\", 0) == 0);","+\t\tREQUIRE(sql.find(\"__export_source\") != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT x FROM frag_made\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(7));","+\t}","+\tSECTION(\"create table as with a consumer CTE\") {","+\t\tauto sql = ExportStatementFragment(","+\t\t    connection,","+\t\t    \"CREATE TABLE frag_made2 AS WITH q AS MATERIALIZED (SELECT i FROM range(3) t(i)) SELECT i + 1 AS x FROM q\",","+\t\t    \"SELECT 7::BIGINT AS i\");","+\t\tREQUIRE(sql.rfind(\"CREATE TABLE\", 0) == 0);","+\t\t// the replaced source precedes the consumer definition it feeds","+\t\tauto source_position = sql.find(\"__export_source\");","+\t\tREQUIRE(source_position != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT x FROM frag_made2\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(8));","+\t}","+\tSECTION(\"copy to\") {","+\t\tauto path = TestCreatePath(\"fragment_copy_out.csv\");","+\t\tauto sql = ExportStatementFragment(","+\t\t    connection, \"COPY (SELECT i FROM range(3) t(i)) TO '\" + path + \"' (FORMAT csv, HEADER false)\",","+\t\t    \"SELECT 7::BIGINT AS i\");","+\t\tREQUIRE(sql.rfind(\"COPY\", 0) == 0);","+\t\tREQUIRE(sql.find(\"__export_source\") != string::npos);","+\t\tREQUIRE_NO_FAIL(connection.Query(sql));","+\t\tauto result = connection.Query(\"SELECT * FROM read_csv('\" + path + \"', header=false, columns={'i':'BIGINT'})\");","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(7));","+\t}","+\tconnection.Rollback();","+}","+","+TEST_CASE(\"Statement fragment roots keep the replacement invariants\",","+          \"[sql_export][logical_plan_sql_export][statement_fragments]\") {","+\tDuckDB db(nullptr);","+\tConnection connection(db);","+\tREQUIRE_NO_FAIL(connection.Query(\"CREATE TABLE frag_guard(a BIGINT, b VARCHAR)\"));","+\tconnection.BeginTransaction();","+","+\tSECTION(\"overlapping statement boundaries\") {","+\t\tauto plan = OptimizeStatementPlan(connection, \"INSERT INTO frag_guard SELECT i, 'x' FROM range(3) t(i)\");","+\t\tauto range_get = FindRangeGet(*plan);","+\t\tREQUIRE(range_get);","+\t\tauto root_bindings = plan->GetColumnBindings();","+\t\tParser parser(*connection.context);","+\t\tparser.ParseQuery(\"SELECT 1::BIGINT AS n\");","+\t\tvector<LogicalPlanSQLExportField> root_fields;","+\t\tfor (idx_t i = 0; i < root_bindings.size(); i++) {","+\t\t\troot_fields.push_back({root_bindings[i], plan->types[i]});","+\t\t}","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back(","+\t\t    {*plan, {std::move(parser.statements[0]->Cast<SelectStatement>().node), std::move(root_fields)}});","+\t\treplacements.push_back({*range_get, StatementReplacement(connection, *range_get, \"SELECT 7::BIGINT AS i\")});","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements),","+\t\t                       LogicalPlanVerificationIssueCode::INTERNAL_INVARIANT);","+\t}","+\tSECTION(\"a replaced RETURNING root reads the replacement\") {","+\t\tREQUIRE_NO_FAIL(connection.Query(\"INSERT INTO frag_guard VALUES (2, 'kept')\"));","+\t\tauto plan = OptimizeStatementPlan(connection, \"INSERT INTO frag_guard SELECT 1::BIGINT, 'orig' RETURNING a\");","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({*plan, StatementReplacement(connection, *plan, \"SELECT 99::BIGINT AS a\")});","+\t\tauto exported = LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements);","+\t\tREQUIRE(exported.IsSuccess());","+\t\tauto result = connection.Query(exported.GetValue().query->ToString());","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(99));","+\t\t// the original write must not run","+\t\tauto count = connection.Query(\"SELECT count(*) FROM frag_guard\");","+\t\tREQUIRE(count->Collection().GetValue(0, 0) == Value::BIGINT(1));","+\t}","+\tSECTION(\"a replaced statement below a RETURNING root reads the replacement\") {","+\t\tREQUIRE_NO_FAIL(connection.Query(\"INSERT INTO frag_guard VALUES (2, 'kept')\"));","+\t\tauto plan = OptimizeStatementPlan(connection, \"INSERT INTO frag_guard SELECT 1::BIGINT, 'orig' RETURNING a\");","+\t\tREQUIRE(plan->children.size() == 1);","+\t\tauto &boundary = *plan->children[0];","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back(","+\t\t    {boundary, StatementReplacement(connection, boundary, \"SELECT 99::BIGINT AS a, 'repl' AS b\")});","+\t\tauto exported = LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements);","+\t\tREQUIRE(exported.IsSuccess());","+\t\tauto result = connection.Query(exported.GetValue().query->ToString());","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(99));","+\t\tauto count = connection.Query(\"SELECT count(*) FROM frag_guard\");","+\t\tREQUIRE(count->Collection().GetValue(0, 0) == Value::BIGINT(1));","+\t}","+\tSECTION(\"select roots behave as before\") {","+\t\tauto plan = OptimizeStatementPlan(connection, \"SELECT i + 1 FROM range(3) t(i)\");","+\t\tauto range_get = FindRangeGet(*plan);","+\t\tREQUIRE(range_get);","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({*range_get, StatementReplacement(connection, *range_get, \"SELECT 41::BIGINT AS i\")});","+\t\tauto exported = LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements);","+\t\tREQUIRE(exported.IsSuccess());","+\t\tauto result = connection.Query(exported.GetValue().query->ToString());","+\t\tREQUIRE_NO_FAIL(*result);","+\t\tREQUIRE(result->RowCount() == 1);","+\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(42));","+\t}","+\tconnection.Rollback();","+}","+","+} // namespace logical_plan_sql_export_test",""],"additions":292,"deletions":0,"truncated":false}],"additions":377,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-16T14:20:51.078798+00:00"}