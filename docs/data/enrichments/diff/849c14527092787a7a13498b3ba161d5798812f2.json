{"id":"849c14527092787a7a13498b3ba161d5798812f2","axis":"silent","repo":"vercel/turbo","sha":"849c14527092787a7a13498b3ba161d5798812f2","parsed":{"files":[{"path":"crates/turborepo-cli/src/commands/setup/first_lock.rs","lines":["@@ -353,6 +353,8 @@ fn plain_setup_locks_and_provisions_exactly_like_tools_only() {","     for flags in [LOCAL, &[\"--no-frozen\"]] {","         let f = fresh();","         fs::write(f.owned.root().join(\".nvmrc\"), \"24.x\").unwrap();","+        // Plain setup would also run pnpm, which this fixture's Node cannot.","+        fs::write(f.owned.root().join(\"turbo.json\"), SKIP_DEPENDENCIES).unwrap();","         let u = LoopbackServer::new(routes(&f, \"24.0.0\", \"10.0.0\"), |_| {}).unwrap();","         assert_eq!(f.run(&u, flags).unwrap(), 0);","         assert_eq!(u.hits(), 7);"],"additions":2,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/force_tests.rs","lines":["@@ -37,6 +37,9 @@ fn healthy_force_replaces_one_complete_generation_then_normal_reuses() {","         ] {","             fs::write(f.owned.root().join(name), format!(\"{name} sentinel\\n\")).unwrap();","         }","+        if !flags.contains(&\"--tools-only\") {","+            fs::write(f.owned.root().join(\"turbo.json\"), SKIP_DEPENDENCIES).unwrap();","+        }","         let git = |args: &[&str]| {","             let output = std::process::Command::new(\"git\")","                 .current_dir(f.owned.root())"],"additions":3,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/pnpm_install_tests.rs","lines":["@@ -0,0 +1,123 @@","+//! Locked pnpm workspace installs with the managed pnpm on the managed Node.","+use super::*;","+","+const LOCK: &[u8] = b\"lockfileVersion: '9.0'\\n\";","+","+/// The pnpm shim runs the managed Node with pnpm's CLI script, so this Node","+/// records pnpm's arguments, then runs `body` in the workspace root.","+fn installing(body: &str) -> Fixture {","+    let mut f = Fixture::new();","+    let prefix = f.node_path.rsplit('/').next().unwrap();","+    let prefix = prefix.trim_end_matches(\".tar.gz\").to_owned();","+    let node = format!(\"#!/bin/sh\\nshift\\necho \\\"$*\\\" >> pnpm-args\\n{body}\\n\");","+    f.node = archive(&prefix, &[(\"bin/node\", &node), (\"resource\", \"node\")]);","+    let artifacts = &mut f.lock[\"tools\"][\"node\"][\"installation\"][\"artifacts\"];","+    let parts = artifacts","+        .as_object_mut()","+        .unwrap()","+        .values_mut()","+        .next()","+        .unwrap();","+    parts[\"distribution\"][\"sha256\"] = json!(format!(\"{:x}\", Sha256::digest(&f.node)));","+    f.save();","+    let root = f.owned.root();","+    fs::write(root.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - apps/*\\n\").unwrap();","+    fs::write(root.join(\"pnpm-lock.yaml\"), LOCK).unwrap();","+    f","+}","+","+fn args(f: &Fixture) -> Vec<String> {","+    let args = fs::read_to_string(f.owned.root().join(\"pnpm-args\")).unwrap_or_default();","+    args.lines().map(str::to_owned).collect()","+}","+","+fn no_tasks(f: &Fixture) {","+    for path in [\"task-ran\", \"hook-ran\", \"probe-ran\"] {","+        assert!(!f.owned.root().join(path).exists(), \"{path}\");","+    }","+    assert_eq!(","+        fs::read(f.owned.root().join(\"pnpm-lock.yaml\")).unwrap(),","+        LOCK","+    );","+}","+","+#[test]","+fn locked_pnpm_workspaces_install_frozen_and_repeat_safely() {","+    let f = installing(\"mkdir -p node_modules && touch node_modules/.installed\");","+    let root = f.owned.root();","+    let u = Upstream::new(&f, false, None);","+    assert_eq!(f.run(&u, &[\"--frozen\"]).unwrap(), 0);","+    assert!(root.join(\"node_modules/.installed\").exists());","+    // Every run reinstalls, so removed dependencies are repaired; skipped","+    // scripts use pnpm's own flag, and tools-only setup never runs pnpm.","+    fs::remove_dir_all(root.join(\"node_modules\")).unwrap();","+    assert_eq!(f.run(&u, &[\"--frozen\", \"--ignore-scripts\"]).unwrap(), 0);","+    assert!(root.join(\"node_modules/.installed\").exists());","+    assert_eq!(f.run(&u, FROZEN).unwrap(), 0);","+    assert_eq!(","+        args(&f),","+        [","+            \"install --frozen-lockfile\",","+            \"install --frozen-lockfile --ignore-scripts\"","+        ]","+    );","+    no_tasks(&f);","+}","+","+#[test]","+fn pnpm_native_build_policy_is_reported_and_never_broadened() {","+    let f = installing(\"\");","+    let lock = turborepo_setup::lock::Lock::parse(&f.lock.to_string().into_bytes()).unwrap();","+    let plan = |f: &Fixture| {","+        f.dependencies(&[\"--plan\"])","+            .plan(f.owned.root(), &lock)","+            .unwrap()","+    };","+    assert_eq!(","+        plan(&f)[..2],","+        [","+            \"javascript dependencies: pnpm install --frozen-lockfile from pnpm-lock.yaml with \\","+             managed pnpm 10.0.0 (pnpm-lock.yaml stays unchanged)\",","+            \"  pnpm 10.0.0: native pnpm policy; project scripts run; dependency scripts run only \\","+             for allowed packages\",","+        ]","+    );","+    // Committed allowlists and blocks stay pnpm's to enforce: setup reports","+    // them and passes no flag of its own.","+    let workspace = \"packages:\\n  - apps/*\\nonlyBuiltDependencies:\\n  - esbuild\\n\";","+    fs::write(f.owned.root().join(\"pnpm-workspace.yaml\"), workspace).unwrap();","+    assert!(plan(&f)[1].ends_with(\"(committed: onlyBuiltDependencies in pnpm-workspace.yaml)\"));","+    let blocked = \"packages:\\n  - apps/*\\nignoreScripts: true\\n\";","+    fs::write(f.owned.root().join(\"pnpm-workspace.yaml\"), blocked).unwrap();","+    assert!(plan(&f)[1].contains(\"project scripts do not run; dependency scripts do not run\"));","+    let u = Upstream::new(&f, false, None);","+    assert_eq!(f.run(&u, &[\"--frozen\"]).unwrap(), 0);","+    assert_eq!(args(&f), [\"install --frozen-lockfile\"]);","+    no_tasks(&f);","+}","+","+#[test]","+fn pnpm_lock_mismatch_and_missing_lock_fail_readably_and_recover() {","+    // pnpm rejects a lock that no longer matches; its status passes through.","+    let f = installing(\"[ -f stale ] && exit 1\\nmkdir -p node_modules\");","+    let u = Upstream::new(&f, false, None);","+    fs::write(f.owned.root().join(\"stale\"), \"\").unwrap();","+    assert_eq!(f.run(&u, &[\"--frozen\"]).unwrap(), 1);","+    fs::remove_file(f.owned.root().join(\"stale\")).unwrap();","+    assert_eq!(f.run(&u, &[\"--frozen\"]).unwrap(), 0);","+    no_tasks(&f);","+","+    let f = installing(\"\");","+    fs::remove_file(f.owned.root().join(\"pnpm-lock.yaml\")).unwrap();","+    let u = Upstream::new(&f, false, None);","+    for flags in [&[\"--frozen\"][..], &[\"--plan\"], &[\"--check\"]] {","+        let error = f.run(&u, flags).unwrap_err().to_string();","+        assert!(","+            error.contains(\"pnpm dependency setup requires a committed pnpm-lock.yaml\"),","+            \"{error}\"","+        );","+    }","+    assert_eq!(u.hits(), 0);","+    assert!(!f.owned.root().join(\".turbo\").exists());","+    assert!(!f.owned.root().join(\"pnpm-lock.yaml\").exists());","+}"],"additions":123,"deletions":0,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/tests.rs","lines":["@@ -21,6 +21,9 @@ fn run_overrides(","     let bin = std::env::split_paths(&env[\"PATH\"]).next().unwrap();","     Ok((env, bin))"," }","+/// For plain setup in fixtures whose Node cannot run pnpm.","+const SKIP_DEPENDENCIES: &str =","+    r#\"{\"futureFlags\":{\"experimentalSetup\":true},\"setup\":{\"javascript\":{\"dependencies\":\"skip\"}}}\"#;"," fn archive(root: &str, files: &[(&str, &str)]) -> Vec<u8> {","     let mut tar = tar::Builder::new(Vec::new());","     for (path, body) in files {","@@ -267,6 +270,8 @@ mod native_plain_run;"," mod npm;"," #[path = \"offline_tests.rs\"]"," mod offline_repeat;","+#[path = \"pnpm_install_tests.rs\"]","+mod pnpm_install;"," #[path = \"publication_guards.rs\"]"," mod publication_guards;"," #[path = \"rustup_tests.rs\"]","@@ -337,6 +342,8 @@ fn authoritative_pnpm_keeps_wrong_manager_advisories_in_frozen_local_and_check()","             snapshot.previous_lock().unwrap().canonical_bytes().unwrap(),","         )","         .unwrap();","+        // Plain --check needs the lockfile pnpm would install from.","+        fs::write(f.owned.root().join(\"pnpm-lock.yaml\"), \"\").unwrap();","         let u = Upstream::new(&f, false, None);","         assert_eq!(f.run(&u, FROZEN).unwrap(), 0);","         let before = publication_guards::state(f.owned.root());","@@ -399,11 +406,14 @@ fn root_policy_and_cli_overrides_select_the_effective_setup() {","     let f = Fixture::new();","     configure(&f, \"\", r#\"{\"dependencies\":\"locked\"}\"#);","     let u = Upstream::new(&f, false, None);","-    // Locked dependencies reach dependency setup instead of failing as","-    // pending; this fixture's pnpm installer reports itself as skipped.","-    assert_eq!(f.run(&u, &[\"--frozen\"]).unwrap(), 0);","-    assert_eq!(u.hits(), 3);","+    // Locked pnpm dependencies need pnpm-lock.yaml before any download.","+    assert!(matches!(","+        f.run(&u, &[\"--frozen\"]),","+        Err(Error::Dependencies(_))","+    ));","+    assert_eq!(u.hits(), 0);","     assert_eq!(f.run(&u, FROZEN).unwrap(), 0);","+    assert_eq!(u.hits(), 3);"," ","     // Preserve the native managed adapters added after the original policy","     // stack. System Rust remains unsupported and must fail before traffic.","@@ -457,7 +467,7 @@ fn unsupported_modes_and_policy_fail_before_traffic_or_storage() {","     ] {","         let f = Fixture::new();","         let u = Upstream::new(&f, false, None);","-        if flags == [\"--no-frozen\", \"--tools-only\"] || flags == [\"--frozen\"] {","+        if flags == [\"--no-frozen\", \"--tools-only\"] {","             assert_eq!(f.run(&u, &flags).unwrap(), 0);","             assert_eq!(u.hits(), 3);","         } else if flags == [\"--check\"] {","@@ -469,8 +479,10 @@ fn unsupported_modes_and_policy_fail_before_traffic_or_storage() {","         } else {","             let result = f.run(&u, &flags);","             match flags.as_slice() {","-                // Plain plans include dependencies (none for pnpm yet).","-                [\"--plan\"] => assert_eq!(result.unwrap(), 0),","+                // Plain setup and plans need the fixture's missing pnpm-lock.yaml.","+                [\"--plan\"] | [\"--frozen\"] => {","+                    assert!(matches!(result, Err(Error::Dependencies(_))));","+                }","                 // Neither can install locked dependencies (#14486, #14518).","                 [\"--no-lock\"] | [\"--frozen\", \"--offline\"] => {","                     assert!("],"additions":19,"deletions":7,"truncated":false},{"path":"crates/turborepo-setup/src/js_install.rs","lines":["@@ -58,6 +58,7 @@ impl Frozen {","     pub fn new(manager: Manager) -> Option<Self> {","         let (lockfiles, regenerate): (&'static [_], _) = match manager {","             Manager::Npm => (&[\"npm-shrinkwrap.json\", \"package-lock.json\"], \"npm install\"),","+            Manager::Pnpm => (&[\"pnpm-lock.yaml\"], \"pnpm install\"),","             _ => return None,","         };","         Some(Self {","@@ -81,6 +82,8 @@ impl Frozen {","         match self.manager {","             // Installs exactly the lockfile and fails if package.json disagrees.","             Manager::Npm => &[\"ci\"],","+            // Installs the whole workspace and fails instead of updating the lock.","+            Manager::Pnpm => &[\"install\", \"--frozen-lockfile\"],","             _ => unreachable!(\"Frozen::new admits only adapted managers\"),","         }","     }"],"additions":3,"deletions":0,"truncated":false},{"path":"crates/turborepo-setup/src/js_install/tests.rs","lines":["@@ -45,6 +45,26 @@ fn missing_lock_is_an_error_not_permission_to_create_one() {","     assert!(Frozen::new(Manager::Aube).is_none());"," }"," ","+#[test]","+fn pnpm_installs_frozen_from_pnpm_lock_yaml() {","+    let f = Fixture::new();","+    let pnpm = Frozen::new(Manager::Pnpm).unwrap();","+    let error = pnpm.lockfile(&f.root()).unwrap_err().to_string();","+    assert!(","+        error.contains(\"committed pnpm-lock.yaml\") && error.contains(\"`pnpm install`\"),","+        \"{error}\"","+    );","+    fs::write(f.root().join(\"pnpm-lock.yaml\"), \"lockfileVersion: '9.0'\\n\").unwrap();","+    assert_eq!(pnpm.lockfile(&f.root()).unwrap(), \"pnpm-lock.yaml\");","+    let args = pnpm.args(&Version::new(10, 0, 0));","+    assert_eq!(args, [\"install\", \"--frozen-lockfile\"]);","+    let rewrite = f.npm(\"echo rewritten > pnpm-lock.yaml\");","+    let error = pnpm.run(&rewrite, args, &f.root(), &BTreeMap::new());","+    assert!(matches!(error, Err(Error::LockChanged { .. })));","+    let lock = fs::read(f.root().join(\"pnpm-lock.yaml\")).unwrap();","+    assert_eq!(lock, b\"lockfileVersion: '9.0'\\n\");","+}","+"," #[test]"," fn runs_the_frozen_command_with_the_given_environment_and_returns_its_status() {","     let f = Fixture::new();"],"additions":20,"deletions":0,"truncated":false},{"path":"crates/turborepo/tests/setup.rs","lines":["@@ -1850,18 +1850,13 @@ fn plain_setup_provisions_tools_and_reports_dependencies_skipped() {","     let monitor = TcpListener::bind(\"127.0.0.1:0\").unwrap();","     monitor.set_nonblocking(true).unwrap();","     let proxy = format!(\"http://{}\", monitor.local_addr().unwrap());","+    // pnpm installs need a pnpm-lock.yaml, so this repository skips them.","     // Plain --check checks the same tools and never claims dependency readiness.","+    let policy = r#\"{\"futureFlags\":{\"experimentalSetup\":true},\"setup\":{\"javascript\":{\"dependencies\":\"skip\"}}}\"#;","+    write(root, \"turbo.json\", policy);","     for (mode, outcome, skipped) in [","-        (","-            \"--frozen\",","-            \"reused\",","-            \"pnpm dependency installation is not supported yet\",","-        ),","-        (","-            \"--check\",","-            \"ready\",","-            \"pnpm dependency installation is not supported yet\",","-        ),","+        (\"--frozen\", \"reused\", \"turbo.json setup policy\"),","+        (\"--check\", \"ready\", \"turbo.json setup policy\"),","     ] {","         let output = Command::new(env!(\"CARGO_BIN_EXE_turbo\"))","             .env_clear()",""],"additions":5,"deletions":10,"truncated":false}],"additions":175,"deletions":17,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-16T14:18:49.726425+00:00"}