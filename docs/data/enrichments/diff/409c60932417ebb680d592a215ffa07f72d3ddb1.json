tion, Lock, Platform};"," "," pub const IDENTITY_DOMAIN: &str = \"turborepo.setup.execution.v1\";"," ","@@ -169,11 +169,19 @@ pub struct ExecutionSnapshot {","     tools: BTreeMap<String, SelectedTool>,","     canonical: Vec<u8>,","     fingerprint: String,","+    resolution: Option<&'static str>,"," }"," "," /// Marks identities selected from a `turbo setup --no-lock` record."," const CLONE_LOCAL: &str = \"clone-local\";"," ","+/// Every lock adapter a snapshot can select. Additional tools (`artifact`)","+/// share the managed projection: artifact digest, format, layout and","+/// executables, never the source URL.","+pub const ADAPTERS: [&str; 11] = [","+    \"node\", \"npm\", \"pnpm\", \"yarn\", \"bun\", \"rust\", \"rustup\", \"uv\", \"python\", \"go\", \"artifact\",","+];","+"," impl ExecutionSnapshot {","     // Lock bounds, canonical option ordering and executable collision checks are","     // trusted here; adapter-specific semantic validation still precedes activation.","@@ -217,22 +225,7 @@ impl ExecutionSnapshot {","         let mut tools = BTreeMap::new();","         for id in selected_ids {","             let tool = lock.tools().get(id).ok_or(Error::MissingTool)?;","-            // Additional tools share the managed projection: artifact digest,","-            // format, layout and executables, never the source URL.","-            if !matches!(","-                tool.adapter.as_str(),","-                \"node\"","-                    | \"npm\"","-                    | \"pnpm\"","-                    | \"yarn\"","-                    | \"bun\"","-                    | \"rust\"","-                    | \"rustup\"","-                    | \"go\"","-                    | \"uv\"","-                    | \"python\"","-                    | additional::ADAPTER","-            ) {","+            if !ADAPTERS.contains(&tool.adapter.as_str()) {","                 return Err(Error::UnsupportedAdapter);","             }","             let installation = match &tool.installation {","@@ -289,12 +282,17 @@ impl ExecutionSnapshot {","             tools,","             canonical,","             fingerprint,","+            resolution,","         })","     }"," ","     pub fn context(&self) -> &ExecutionContext {","         &self.context","     }","+    /// Selected from a `turbo setup --no-lock` record rather than turbo.lock.","+    pub fn clone_local(&self) -> bool {","+        self.resolution == Some(CLONE_LOCAL)","+    }","     pub fn tools(&self) -> &BTreeMap<String, SelectedTool> {","         &self.tools","     }"],"additions":15,"deletions":17,"truncated":false},{"path":"crates/turborepo-setup/src/execution_identity/tests.rs","lines":["@@ -438,6 +438,7 @@ fn clone_local_identity_marks_its_resolution_and_keeps_artifact_binding() {","     let local =","         ExecutionSnapshot::select_clone_local(&lock(&fixture()), context(), &selected).unwrap();","     assert_eq!(local.tools(), committed.tools());","+    assert!(local.clone_local() && !committed.clone_local());","     assert_ne!(local.fingerprint(), committed.fingerprint());","     let mut expected: Value = serde_json::from_slice(committed.canonical_identity()).unwrap();","     expected[\"resolution\"] = json!(\"clone-local\");"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/turborepo-shim/MANAGED_RUN_CAPABILITIES.md","lines":["@@ -1,28 +0,0 @@","-# Native managed-run capability selection","-","-Schema readability is not execution support. The public `managedRunSchemas` list remains empty; the experimental Node/pnpm object must never populate it from the lock parser's schema version.","-","-The standalone internal query is `--__internal-managed-run-capabilities`. Readers enforce the existing 4096-byte bound, query deadline, strict JSON/ABI validation, quiet stderr, successful exit, and owned-process cleanup.","-","-| Response key | Meaning |","-| --- | --- |","-| `abiVersion` | Native query ABI, currently `1` |","-| `cliVersion` | Diagnostic only; never a compatibility floor |","-| `managedRunSchemas` | Complete public managed-run contract; currently `[]` |","-| `experimentalNodePnpm.contractVersion` | Internal adapter/platform-bounded contract, currently `1` |","-| `experimentalNodePnpm.lockSchema` | Explicit prelaunch lock schema, currently `0` |","-| `experimentalNodePnpm.platform` | `macos-arm64` or `linux-x64-gnu` |","-","-The experimental object is absent on every other host. GNU Linux ARM64, macOS x64, Linux musl, Windows, and other architectures remain unadvertised. A peer reporting another host, contract version, or schema cannot satisfy this host's experimental check. Old strict readers reject the extension rather than mistaking it for complete-schema support.","-","-## Authorization remains required","-","-Consumers must first authorize the exact-root managed Node/pnpm cohort using current declarations, complete installation resources and exports, native execution context, and matching private setup evidence. Experimental peer support does not bypass source policy, lock validation, trust checks, or revalidation at managed execution boundaries.","-","-Installed incompatible, malformed, damaged, or unresolvable local pins fail closed rather than being substituted with the global CLI or implicitly fetched. Self-local and copied-local execution remain subject to the same capability requirement.","-","-This object does not claim npm/bundled npm, Rust, Python, Go, verify-system adapters, or complete product-schema support.","-","-## Binary-level journey","-","-The companion setup/run journey in `crates/turborepo/tests/setup_run_journey.rs` is gated to macOS ARM64 and GNU Linux x64. It exercises global setup followed by plain run, absent and incompatible local pins, copied-local compatible handoff, strict and loose task environments, drift, damaged installations, and no-network reuse. This bounded journey is not qualification of the complete public managed-run schema or other hosts."],"additions":0,"deletions":28,"truncated":false},{"path":"crates/turborepo-shim/src/capabilities.rs","lines":["@@ -1,13 +1,41 @@"," //! Native managed-run handshake. Schema readability is not execution support."," ","+use std::{collections::BTreeSet, fmt};","+"," use serde::{Deserialize, Serialize};"," use thiserror::Error;","+use turborepo_platform::{Architecture, OperatingSystem, Platform};"," "," pub const QUERY_FLAG: &str = \"--__internal-managed-run-capabilities\";"," pub const ABI_VERSION: u32 = 1;"," /// Includes the terminating newline. Consumers must bound reads before parsing."," pub const MAX_RESPONSE_BYTES: usize = 4096;"," const MAX_SCHEMAS: usize = 64;","+const MAX_FEATURES: usize = 64;","+","+/// The prelaunch `turbo.lock` schema this build activates.","+pub const EXPERIMENTAL_LOCK_SCHEMA: u32 = 0;","+/// What this build activates for that schema: each lock adapter ID, locked","+/// `verify-system` tools checked on PATH, and `clone-local` selections that","+/// `turbo setup --no-lock` records without a turbo.lock. Sorted. A name's","+/// meaning is frozen once a build advertises it: a lock or activation change","+/// that an older peer would misread needs a new name, so that peer is refused","+/// instead.","+pub const FEATURES: &[&str] = &[","+    \"artifact\",","+    \"bun\",","+    \"clone-local\",","+    \"go\",","+    \"node\",","+    \"npm\",","+    \"pnpm\",","+    \"python\",","+    \"rust\",","+    \"rustup\",","+    \"uv\",","+    \"verify-system\",","+    \"yarn\",","+];"," "," #[derive(Debug, Error, PartialEq, Eq)]"," pub enum Error {","@@ -32,43 +60,93 @@ struct Report {","     abi_version: u32,","     /// Diagnostic only: never use the CLI version as a compatibility floor.","     cli_version: String,","-    /// Sorted, unique lock schemas with the COMPLETE managed-run contract:","-    /// activation before probes, drift validation, strict/loose task env,","-    /// portable toolchain hashing, and `turbo exec` with the same environment.","-    /// Accepting a lock schema alone is insufficient.","+    /// Sorted, unique lock schemas with the COMPLETE public managed-run","+    /// contract. Empty until launch freezes a lock schema; prelaunch support","+    /// is the feature-scoped `experimental_setup` below.","     managed_run_schemas: Vec<u32>,","-    /// Internal, adapter/platform-bounded contract, NOT complete public schema","-    /// support. Older readers reject this extension rather than treating it","-    /// as complete.","+    /// Older readers reject this extension rather than treating it as","+    /// complete schema support.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","-    experimental_node_pnpm: Option<NodePnpm>,","+    experimental_setup: Option<Experimental>,"," }"," "," #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]"," #[serde(rename_all = \"camelCase\", deny_unknown_fields)]","-struct NodePnpm {","-    contract_version: u32,","+struct Experimental {","     lock_schema: u32,","-    platform: String,","+    /// The build's OS and architecture. Peers share one host and classify its","+    /// C library at runtime, so equal targets select the same artifacts.","+    target: String,","+    /// Sorted and unique. Unknown names are newer features, never errors.","+    features: Vec<String>,","+}","+","+/// What a managed selection needs from the CLI that runs it.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub struct Requirement {","+    schema: u32,","+    features: BTreeSet<String>,","+}","+","+impl Requirement {","+    pub fn new<S: Into<String>>(schema: u32, features: impl IntoIterator<Item = S>) -> Self {","+        Self {","+            schema,","+            features: features.into_iter().map(Into::into).collect(),","+        }","+    }","+","+    pub fn schema(&self) -> u32 {","+        self.schema","+    }","+","+    pub fn features(&self) -> impl Iterator<Item = &str> {","+        self.features.iter().map(String::as_str)","+    }","+}","+","+impl fmt::Display for Requirement {","+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {","+        let features = self.features().collect::<Vec<_>>().join(\", \");","+        if self.features.contains(\"clone-local\") {","+            write!(","+                f,","+                \"this clone's turbo setup --no-lock tools (schema {}: {features})\",","+                self.schema","+            )","+        } else {","+            write!(f, \"turbo.lock schema {} ({features})\", self.schema)","+        }","+    }"," }"," ","-/// Hosts whose real-binary setup -> run journey, including copied-local","-/// handoff, runs in the normal test suite. This is NOT complete public schema","-/// support; never populate `managedRunSchemas` from this internal ABI.","-fn qualified_platform() -> Option<&'static str> {","-    if cfg!(all(target_os = \"macos\", target_arch = \"aarch64\")) {","-        Some(\"macos-arm64\")","-    } else if cfg!(all(","-        target_os = \"linux\",","-        target_env = \"gnu\",","-        target_arch = \"x86_64\"","-    )) {","-        Some(\"linux-x64-gnu\")","-    } else {","-        None","+/// Builds whose host the managed-run context accepts. Linux builds cover glibc","+/// and musl hosts alike: both peers classify the host's C library at runtime,","+/// and activation admits only verify-system tools on musl. Released Linux","+/// binaries are static musl builds, so this never depends on the build's own","+/// C library. Windows arm64 is unqualified.","+fn target() -> Option<&'static str> {","+    use Architecture::{Arm64, X64};","+    use OperatingSystem::{Linux, Macos, Windows};","+    let platform = Platform::current();","+    match (platform.os(), platform.arch()) {","+        (Macos, Arm64) => Some(\"macos-arm64\"),","+        (Macos, X64) => Some(\"macos-x64\"),","+        (Linux, Arm64) => Some(\"linux-arm64\"),","+        (Linux, X64) => Some(\"linux-x64\"),","+        (Windows, X64) => Some(\"windows-x64\"),","+        _ => None,","     }"," }"," ","+fn feature(name: &str) -> bool {","+    !name.is_empty()","+        && name.len() <= 32","+        && name","+            .bytes()","+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')","+}","+"," impl Capabilities {","     /// No managed execution support, regardless of readable schemas/version.","     pub fn unsupported(cli_version: &str) -> Self {","@@ -76,35 +154,21 @@ impl Capabilities {","             abi_version: ABI_VERSION,","             cli_version: cli_version.to_owned(),","             managed_run_schemas: Vec::new(),","-            experimental_node_pnpm: None,","+            experimental_setup: None,","         })","     }"," ","-    /// Current startup-only internal ABI. Complete public schema support stays","-    /// empty until the combined activation/probe/cache/late-validation contract","-    /// is delivered and tested; this report is not that qualification.","+    /// This build's report: every feature it activates on a claimed target.","     pub fn current(cli_version: &str) -> Self {","         let mut report = Self::unsupported(cli_version);","-        report.0.experimental_node_pnpm = qualified_platform().map(|platform| NodePnpm {","-            contract_version: 1,","-            lock_schema: 0,","-            platform: platform.to_owned(),","+        report.0.experimental_setup = target().map(|target| Experimental {","+            lock_schema: EXPERIMENTAL_LOCK_SCHEMA,","+            target: target.to_owned(),","+            features: FEATURES.iter().map(|&name| name.to_owned()).collect(),","         });","         report","     }"," ","-    /// Only for consumers which already authorized a managed Node/pnpm cohort.","-    /// Never use this to infer full schema support or skip lock/tool","-    /// validation.","-    pub fn supports_experimental_node_pnpm(&self, schema: u32) -> bool {","-        self.0.experimental_node_pnpm.as_ref().is_some_and(|scope| {","-            scope.contract_version == 1","-                && scope.lock_schema == 0","-                && scope.lock_schema == schema","-                && qualified_platform() == Some(scope.platform.as_str())","-        })","-    }","-","     pub fn parse(bytes: &[u8]) -> Result<Self, Error> {","         if bytes.len() > MAX_RESPONSE_BYTES {","             return Err(Error::TooLarge);","@@ -132,19 +196,65 @@ impl Capabilities {","         self.0.managed_run_schemas.binary_search(&schema).is_ok()","     }"," ","+    /// Why this CLI cannot run `requirement` on this host; `None` when it","+    /// can. Complete schema support, or the prelaunch scope for the same","+    /// schema and target with every required feature. Never a version floor.","+    pub fn shortfall(&self, requirement: &Requirement) -> Option<String> {","+        if self.supports_schema(requirement.schema) {","+            return None;","+        }","+        let version = self.cli_version();","+        let Some(scope) = &self.0.experimental_setup else {","+            return Some(format!(\"turbo {version} does not support managed runs\"));","+        };","+        if scope.lock_schema != requirement.schema {","+            return Some(format!(","+                \"turbo {version} supports managed runs for turbo.lock schema {}, not {}\",","+                scope.lock_schema, requirement.schema","+            ));","+        }","+        let host = target();","+        if host != Some(scope.target.as_str()) {","+            return Some(format!(","+                \"turbo {version} is built for {}, but this host's turbo is built for {}\",","+                scope.target,","+                host.unwrap_or(\"an unsupported platform\")","+            ));","+        }","+        let missing: Vec<_> = requirement","+            .features()","+            .filter(|name| {","+                scope","+                    .features","+                    .binary_search_by(|f| f.as_str().cmp(name))","+                    .is_err()","+            })","+      