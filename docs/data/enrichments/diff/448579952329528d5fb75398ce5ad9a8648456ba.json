trings\"","+","+\t\"go.opentelemetry.io/otel/trace\"","+)","+","+func deterministicHash(kind string, parts ...string) [sha256.Size]byte {","+\treturn sha256.Sum256([]byte(kind + \"\\x00\" + strings.Join(parts, \"\\x00\")))","+}","+","+// DeterministicTraceID generates a TraceID deterministically from the given","+// input strings. Callers should pass strings in coarsest-to-finest order","+// and must use the same order to reproduce the same ID.","+//","+// Inputs are joined with a null byte separator to avoid ambiguity.","+func DeterministicTraceID(parts ...string) trace.TraceID {","+\tfor {","+\t\th := deterministicHash(\"trace\", parts...)","+\t\tvar id trace.TraceID","+\t\tcopy(id[:], h[:16])","+\t\tif id.IsValid() {","+\t\t\treturn id","+\t\t}","+\t\tparts = append(parts, \"x\")","+\t}","+}","+","+// DeterministicSpanID generates a SpanID deterministically from the given","+// input strings. Same conventions as DeterministicTraceID.","+func DeterministicSpanID(parts ...string) trace.SpanID {","+\tfor {","+\t\th := deterministicHash(\"span\", parts...)","+\t\tvar id trace.SpanID","+\t\tcopy(id[:], h[:8])","+\t\tif id.IsValid() {","+\t\t\treturn id","+\t\t}","+\t\tparts = append(parts, \"x\")","+\t}","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"util/telemetry/idgen.go","lines":["@@ -0,0 +1,105 @@","+package telemetry","+","+import (","+\t\"context\"","+\t\"encoding/binary\"","+\t\"math/rand/v2\"","+\t\"sync/atomic\"","+","+\tsdktrace \"go.opentelemetry.io/otel/sdk/trace\"","+\t\"go.opentelemetry.io/otel/trace\"","+)","+","+type spanIDOverrideKey struct{}","+type traceIDOverrideKey struct{}","+","+// idOverride holds a deterministic ID that is consumed exactly once by","+// the IDGenerator. After the first span is created from this context,","+// subsequent spans fall back to random IDs.","+type idOverride[T any] struct {","+\tid       T","+\tconsumed atomic.Bool","+}","+","+func (o *idOverride[T]) take() (T, bool) {","+\tif o.consumed.CompareAndSwap(false, true) {","+\t\treturn o.id, true","+\t}","+\tvar zero T","+\treturn zero, false","+}","+","+// WithSpanID returns a context that instructs the IDGenerator to use","+// the given SpanID for the next span created from this context.","+// The override is consumed once: only the immediately next span gets","+// the deterministic ID; subsequent spans get random IDs.","+func WithSpanID(ctx context.Context, id trace.SpanID) context.Context {","+\tif id.IsValid() {","+\t\treturn context.WithValue(ctx, spanIDOverrideKey{}, &idOverride[trace.SpanID]{id: id})","+\t}","+\treturn ctx","+}","+","+// WithTraceID returns a context that instructs the IDGenerator to use","+// the given TraceID for the next root span created from this context.","+// The override is consumed once, same as WithSpanID.","+func WithTraceID(ctx context.Context, id trace.TraceID) context.Context {","+\tif id.IsValid() {","+\t\treturn context.WithValue(ctx, traceIDOverrideKey{}, &idOverride[trace.TraceID]{id: id})","+\t}","+\treturn ctx","+}","+","+// DeterministicIDGenerator is an IDGenerator that checks the context for","+// a SpanID override, falling back to random generation otherwise.","+// The fallback random code is from randomIdGenerator in opentelemetry","+type DeterministicIDGenerator struct{}","+","+var _ sdktrace.IDGenerator = &DeterministicIDGenerator{}","+","+func (g *DeterministicIDGenerator) NewIDs(ctx context.Context) (trace.TraceID, trace.SpanID) {","+\ttid := trace.TraceID{}","+\tif override, ok := ctx.Value(traceIDOverrideKey{}).(*idOverride[trace.TraceID]); ok {","+\t\tif id, taken := override.take(); taken {","+\t\t\ttid = id","+\t\t}","+\t}","+\tif !tid.IsValid() {","+\t\tfor {","+\t\t\tbinary.NativeEndian.PutUint64(tid[:8], rand.Uint64())","+\t\t\tbinary.NativeEndian.PutUint64(tid[8:], rand.Uint64())","+\t\t\tif tid.IsValid() {","+\t\t\t\tbreak","+\t\t\t}","+\t\t}","+\t}","+\tif override, ok := ctx.Value(spanIDOverrideKey{}).(*idOverride[trace.SpanID]); ok {","+\t\tif id, taken := override.take(); taken {","+\t\t\treturn tid, id","+\t\t}","+\t}","+\tsid := trace.SpanID{}","+\tfor {","+\t\tbinary.NativeEndian.PutUint64(sid[:], rand.Uint64())","+\t\tif sid.IsValid() {","+\t\t\tbreak","+\t\t}","+\t}","+\treturn tid, sid","+}","+","+func (g *DeterministicIDGenerator) NewSpanID(ctx context.Context, _ trace.TraceID) trace.SpanID {","+\tif override, ok := ctx.Value(spanIDOverrideKey{}).(*idOverride[trace.SpanID]); ok {","+\t\tif id, taken := override.take(); taken {","+\t\t\treturn id","+\t\t}","+\t}","+\tsid := trace.SpanID{}","+\tfor {","+\t\tbinary.NativeEndian.PutUint64(sid[:], rand.Uint64())","+\t\tif sid.IsValid() {","+\t\t\tbreak","+\t\t}","+\t}","+\treturn sid","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"util/telemetry/idgen_test.go","lines":["@@ -0,0 +1,61 @@","+package telemetry","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"go.opentelemetry.io/otel/trace\"","+)","+","+func TestDeterministicIDGenerator_NewIDs(t *testing.T) {","+\tgen := &DeterministicIDGenerator{}","+\twant := trace.SpanID{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08}","+","+\tctx := WithSpanID(context.Background(), want)","+","+\t_, gotSpanID := gen.NewIDs(ctx)","+\tassert.Equal(t, want, gotSpanID)","+}","+","+func TestDeterministicIDGenerator_NewSpanID(t *testing.T) {","+\tgen := &DeterministicIDGenerator{}","+\twant := trace.SpanID{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08}","+","+\tctx := WithSpanID(context.Background(), want)","+","+\tgotSpanID := gen.NewSpanID(ctx, trace.TraceID{})","+\tassert.Equal(t, want, gotSpanID)","+}","+","+func TestDeterministicIDGenerator_ConsumedOnce(t *testing.T) {","+\tgen := &DeterministicIDGenerator{}","+\twant := trace.SpanID{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08}","+","+\tctx := WithSpanID(context.Background(), want)","+","+\t// First call consumes the override","+\tgotSpanID := gen.NewSpanID(ctx, trace.TraceID{})","+\tassert.Equal(t, want, gotSpanID)","+","+\t// Second call from the same context gets a random ID","+\tgotSpanID = gen.NewSpanID(ctx, trace.TraceID{})","+\tassert.NotEqual(t, want, gotSpanID)","+\tassert.True(t, gotSpanID.IsValid())","+}","+","+func TestDeterministicIDGenerator_FallsBackToRandom(t *testing.T) {","+\tgen := &DeterministicIDGenerator{}","+","+\ttid, sid := gen.NewIDs(context.Background())","+\tassert.True(t, tid.IsValid())","+\tassert.True(t, sid.IsValid())","+}","+","+func TestWithSpanID_IgnoresInvalid(t *testing.T) {","+\tgen := &DeterministicIDGenerator{}","+","+\tctx := WithSpanID(context.Background(), trace.SpanID{})","+\t_, sid := gen.NewIDs(ctx)","+\tassert.True(t, sid.IsValid()) // got a random one, not zero","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"util/telemetry/traces_list.go","lines":["@@ -52,7 +52,6 @@ func (t *Tracing) StartArchiveArtifact(ctx context.Context) (context.Context, tr"," \t\t\tlogging.RequireLoggerFromContext(ctx).WithFields(logging.Fields{\"startMethod\": \"StartArchiveArtifact\", \"expectedParents\": \"saveArtifact\", \"actualParent\": parentName}).Error(ctx, \"incorrect trace parentage\")"," \t\t}"," \t}","-"," \treturn t.tracer.Start(ctx, \"archiveArtifact\", trace.WithSpanKind(trace.SpanKindInternal))"," }"," ","@@ -69,7 +68,6 @@ func (t *Tracing) StartCaptureScriptResult(ctx context.Context) (context.Context"," \t\t\tlogging.RequireLoggerFromContext(ctx).WithFields(logging.Fields{\"startMethod\": \"StartCaptureScriptResult\", \"expectedParents\": \"runWaitContainer, runSupervisorContainer\", \"actualParent\": parentName}).Error(ctx, \"incorrect trace parentage\")"," \t\t}"," \t}","-"," \treturn t.tracer.Start(ctx, \"captureScriptResult\", trace.WithSpanKind(trace.SpanKindInternal))"," }"," ","@@ -86,7 +84,6 @@ func (t *Tracing) StartCreateTaskResult(ctx context.Context) (context.Context, t"," \t\t\tlogging.RequireLoggerFromContext(ctx).WithFields(logging.Fields{\"startMethod\": \"StartCreateTaskResult\", \"expecte