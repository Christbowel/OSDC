"src/include/duckdb/main/client_config.hpp","lines":["@@ -92,6 +92,8 @@ struct ClientConfig {"," \tvector<string> active_grammar_extensions;"," \t//! The compiled grammar active for the connection"," \tshared_ptr<CompiledGrammar> cached_grammar;","+\t//! The grammar of the database this client is CONNECT-ed to; unset when not connected","+\tshared_ptr<CompiledGrammar> connected_grammar;"," "," public:"," \tstatic ClientConfig &GetConfig(ClientContext &context);"],"additions":2,"deletions":0,"truncated":false},{"path":"src/include/duckdb/parser/peg/compiled_grammar.hpp","lines":["@@ -9,6 +9,7 @@ namespace duckdb {"," class ClientContext;"," class DialectExtension;"," class GrammarExtension;","+class PassthroughDialect;"," "," using compiled_rules_map_t = case_insensitive_map_t<unique_ptr<CompiledGrammarRule>>;"," ","@@ -53,11 +54,18 @@ struct CompiledGrammar {"," //! Per-database holder for the compiled base grammar."," struct ParserCache {"," public:","+\tParserCache();","+\t~ParserCache();","+"," \tshared_ptr<CompiledGrammar> GetMatcher();","+\t//! The grammar that forwards statements instead of interpreting them, used while CONNECT-ed","+\tshared_ptr<CompiledGrammar> GetPassthroughMatcher(const ClientContext &context);"," "," private:"," \tstd::mutex mutex;"," \tshared_ptr<CompiledGrammar> matcher;","+\tstd::mutex passthrough_mutex;","+\tunique_ptr<PassthroughDialect> passthrough_dialect;"," };"," "," } // namespace duckdb"],"additions":8,"deletions":0,"truncated":false},{"path":"src/include/duckdb/parser/peg/passthrough_dialect.hpp","lines":["@@ -0,0 +1,69 @@","+//===----------------------------------------------------------------------===//","+//                         DuckDB","+//","+// duckdb/parser/peg/passthrough_dialect.hpp","+//","+//","+//===----------------------------------------------------------------------===//","+","+#pragma once","+","+#include \"duckdb/parser/peg/dialect_extension.hpp\"","+#include \"duckdb/parser/peg/matcher.hpp\"","+","+namespace duckdb {","+","+//! Consumes any single token that is not a statement boundary, without interpreting it. Repeating this matcher","+//! covers a statement whose syntax this parser does not know, e.g. SQL destined for a remote engine.","+class PassthroughTokenMatcher : public AtomicMatcher {","+public:","+\tstatic constexpr MatcherType TYPE = MatcherType::CUSTOM;","+","+public:","+\tPassthroughTokenMatcher() : AtomicMatcher(TYPE) {","+\t}","+","+\tMatcherResult MatchAtomic(MatchState &state) const override {","+\t\tauto current = state.token_iterator.Current();","+\t\tif (!current || current->type == TokenType::TERMINATOR || current->type == TokenType::END_OF_INPUT ||","+\t\t    current->type == TokenType::END_OF_INPUT_AUTOCOMPLETE) {","+\t\t\treturn MatcherResult::Failure();","+\t\t}","+\t\t// always advances, so a repeat over this matcher terminates","+\t\tauto text = current->text;","+\t\tauto offset = current->offset;","+\t\tauto length = current->length;","+\t\tstate.token_iterator.Advance();","+\t\tstate.UpdateMaxTokenIndex();","+\t\treturn state.AllocateParseResult<TokenParseResult>(std::move(text), offset, length);","+\t}","+","+\tSuggestionType AddSuggestionInternal(MatchState &state) const override {","+\t\t// any token matches - there is nothing to suggest","+\t\treturn SuggestionType::MANDATORY;","+\t}","+","+\tstring ToString() const override {","+\t\treturn \"PassthroughToken\";","+\t}","+};","+","+//! The grammar used while a client is CONNECT-ed to a database that parses nothing locally:","+//!","+//!   Statement            <- DisconnectStatement / PassthroughStatement","+//!   PassthroughStatement <- PassthroughToken+","+//!","+//! DISCONNECT stays interpreted so the client can always end the connection; every other statement is handed to","+//! the remote verbatim. The tokenizer is unchanged, so statement boundaries are DuckDB's.","+class PassthroughDialect : public DialectExtension {","+public:","+\tstatic constexpr const char *NAME = \"passthrough\";","+","+public:","+\tPassthroughDialect() : DialectExtension(NAME) {","+\t}","+","+\tvoid ApplyGrammarChanges(GrammarChangesInput &input) override;","+};","+","+} // namespace duckdb"],"additions":69,"deletions":0,"truncated":false},{"path":"src/include/duckdb/parser/peg/transformer/parse_result.hpp","lines":["@@ -77,6 +77,7 @@ enum class ParseResultType : uint8_t {"," \tNUMBER,"," \tSTRING,"," \tEND_OF_INPUT,","+\tTOKEN,"," \tINVALID"," };"," ","@@ -108,6 +109,8 @@ inline const char *ParseResultToString(ParseResultType type) {"," \t\treturn \"STRING\";"," \tcase ParseResultType::END_OF_INPUT:"," \t\treturn \"END_OF_INPUT\";","+\tcase ParseResultType::TOKEN:","+\t\treturn \"TOKEN\";"," \tcase ParseResultType::INVALID:"," \t\treturn \"INVALID\";"," \t}","@@ -202,6 +205,22 @@ struct IdentifierParseResult : ParseResult {"," \t}"," };"," ","+//! A single token consumed without interpreting it; carries its text for debugging only","+struct TokenParseResult : ParseResult {","+\tstatic constexpr ParseResultType TYPE = ParseResultType::TOKEN;","+\tstring text;","+","+\tTokenParseResult(string text_p, optional_idx offset, optional_idx length)","+\t    : ParseResult(TYPE, offset, length), text(std::move(text_p)) {","+\t}","+","+\tvoid ToStringInternal(std::stringstream &ss, std::unordered_set<const ParseResult *> &visited,","+\t                      const std::string &indent, bool is_last) const override {","+\t\tParseResult::ToStringInternal(ss, visited, indent, is_last);","+\t\tss << \": \" << text << \"\\n\";","+\t}","+};","+"," struct EndOfInputParseResult : ParseResult {"," \tstatic constexpr ParseResultType TYPE = ParseResultType::END_OF_INPUT;"," "],"additions":19,"deletions":0,"truncated":false},{"path":"src/include/duckdb/parser/statement/list.hpp","lines":["@@ -9,6 +9,7 @@"," #include \"duckdb/parser/statement/delete_statement.hpp\""," #include \"duckdb/parser/statement/detach_statement.hpp\""," #include \"duckdb/parser/statement/disconnect_statement.hpp\"","+#