ry.hpp\""," #include \"duckdb/parser/peg/keyword_helper/parsed_grammar_keyword_helper.hpp\""," #include \"duckdb/common/string_util.hpp\"","@@ -22,6 +24,10 @@ CompiledGrammar::CompiledGrammar(MatcherAllocator &&allocator_p, unique_ptr<PEGK"," shared_ptr<CompiledGrammar> CompiledGrammar::Get(ClientContext &context) {"," \tauto &client_config = ClientConfig::GetConfig(context);"," \tauto &callback_manager = ExtensionCallbackManager::Get(context);","+\tif (client_config.connected_grammar) {","+\t\t// while CONNECT-ed, the database being talked to decides how its statements are parsed","+\t\treturn client_config.connected_grammar;","+\t}"," \tif (client_config.current_dialect) {"," \t\tauto dialect_extension = callback_manager.GetDialectExtension(*client_config.current_dialect);"," \t\tif (!dialect_extension) {","@@ -186,6 +192,21 @@ shared_ptr<CompiledGrammar> CompiledGrammar::Create(const ClientContext &context"," \treturn Create(selected_extensions);"," }"," ","+ParserCache::ParserCache() {","+}","+","+ParserCache::~ParserCache() {","+}","+","+shared_ptr<CompiledGrammar> ParserCache::GetPassthroughMatcher(const ClientContext &context) {","+\tlock_guard<std::mutex> lock(passthrough_mutex);","+\tif (!passthrough_dialect) {","+\t\tpassthrough_dialect = make_uniq<PassthroughDialect>();","+\t}","+\t// the dialect caches the compiled grammar itself","+\treturn passthrough_dialect->GetCompiledGrammar(context);","+}","+"," shared_ptr<CompiledGrammar> ParserCache::GetMatcher() {"," \t{"," \t\tstd::unique_lock<std::mutex> lock(mutex);"],"additions":21,"deletions":0,"truncated":false},{"path":"src/parser/peg/passthrough_dialect.cpp","lines":["@@ -0,0 +1,43 @@","+#include \"duckdb/parser/peg/passthrough_dialect.hpp\"","+","+#include \"duckdb/parser/peg/parsed_grammar.hpp\"","+#include \"duckdb/parser/peg/transformer/peg_transformer.hpp\"","+#include \"duckdb/parser/statement/passthrough_statement.hpp\"","+","+namespace duckdb {","+","+namespace {","+","+//! Yields the statement without looking at its tokens - the text is filled in from the parse result's extent","+class PassthroughTransformProcess final : public TransformProcess {","+public:","+\tTransformStep Resume(unique_ptr<TransformResultValue> child_result) override {","+\t\tD_ASSERT(!child_result);","+\t\tunique_ptr<SQLStatement> statement = make_uniq<PassthroughStatement>();","+\t\treturn TransformStep::Complete(make_uniq<TypedTransformResult<unique_ptr<SQLStatement>>>(std::move(statement)));","+\t}","+};","+","+unique_ptr<TransformProcess> StartPassthroughTransform(PEGTransformer &, ParseResult &) {","+\treturn make_uniq<PassthroughTransformProcess>();","+}","+","+} // namespace","+","+void PassthroughDialect::ApplyGrammarChanges(GrammarChangesInput &input) {","+\tauto &grammar = input.parsed_grammar;","+\t// the body is a placeholder: the terminal override below is what matches a token","+\tgrammar.AddRule(\"PassthroughToken <- Identifier\");","+\tgrammar.AddTerminalRuleOverride(\"PassthroughToken\", [](const PEGKeywordHelper &) -> unique_ptr<Matcher> {","+\t\treturn make_uniq<PassthroughTokenMatcher>();","+\t});","+\tgrammar.AddRule(\"PassthroughStatement <- PassthroughToken+\", StartPassthroughTransform);","+\t// keep Statement's dispatch transform - it forwards to whichever alternative matched","+\tauto statement_rule = grammar.GetRule(\"Statement\");","+\tif (!statement_rule) {","+\t\tthrow InternalException(\"The passthrough dialect requires a Statement rule\");","+\t}","+\tgrammar.ReplaceRule(\"Statement <- DisconnectStatement / PassthroughStatement\", statement_rule->transform_process);","+}","+","+} // namespace duckdb"],"additions":43,"deletions":0,"truncated":false},{"path":"src/parser/statement/CMakeLists.txt","lines":["@@ -11,6 +11,7 @@ add_library_unity(","   create_statement.cpp","   detach_statement.cpp","   disconnect_statement.cpp","+  passthrough_statement.cpp","   delete_statement.cpp","   drop_statement.cpp","   execute_statement.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"src/parser/statement/passthrough_statement.cpp","lines":["@@ -0,0 +1,16 @@","+#include \"duckdb/parser/statement/passthrough_statement.hpp\"","+","+namespace duckdb {","+","+PassthroughStatement::PassthroughStatement() : SQLStatement(StatementType::PASSTHROUGH_STATEMENT) {","+}","+","+unique_ptr<SQLStatement> PassthroughStatement::Copy() const {","+\treturn unique_ptr<PassthroughStatement>(new PassthroughStatement(*this));","+}","+","+string PassthroughStatement::ToString() const {","+\treturn query;","+}","+","+} // namespace duckdb"],"additions":16,"deletions":0,"truncated":false},{"path":"test/api/CMakeLists.txt","lines":["@@ -56,6 +56,8 @@ set(TEST_API_OBJECTS","     test_parse_statement_iterator.cpp","     test_dialect_extension.cpp","     test_grammar_extension.cpp","+    test_passthrough_dialect.cpp","+    test_passthrough_token_matcher.cpp","     test_progress_bar.cpp","     test_uuid.cpp","     test_insertion_order_preserving_map.cpp"],"additions":2,"deletions":0,"truncated":false},{"path":"test/api/test_passthrough_dialect.cpp","lines":["@@ -0,0 +1,62 @@","+#include \"catch.hpp\"","+#include \"test_helpers.hpp\"","+","+#include \"duckdb/parser/parser.hpp\"","+#include \"duckdb/parser/peg/passthrough_dialect.hpp\"","+#include \"duckdb/parser/statement/passthrough_statement.hpp\"","+","+using namespace duckdb;","+","+namespace {","+","+//! Parse with the grammar used while CONNECT-ed","+vector<unique_ptr<SQLStatement>> ParsePassthrough(ClientContext &context, const string &query) {","+\tPassthroughDialect dialect;","+\tParserOptions options;","+\toptions.compiled_grammar = dialect.GetCompiledGrammar(context);","+\tParser parser(options);","+\tparser.ParseQuery(query);","+\treturn std::move(parser.statements);","+}","+","+} // namespace","+","+TEST_CASE(\"The passthrough grammar does not interpret statements\", \"[api][passthrough]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto &context = *con.context;","+","+\t// syntax DuckDB does not have parses fine - it is meant for the remote","+\tfor (auto &query : vector<string> {\"CREATE GRANT;\", \"GRANT ALL PRIVILEGES ON DATABASE pg TO bob;\", \"SELECT 42;\",","+\t                                   \"CREATE TABLE t (i INTEGER);\"}) {","+\t\tauto statements = ParsePassthrough(context, query);","+\t\tREQUIRE(statements.size() == 1);","+\t\tREQUIRE(statements[0]->type == StatementType::PASSTHROUGH_STATEMENT);","+\t\t// the statement carries its own source text, terminator included","+\t\tREQUIRE(statements[0]->query == query);","+\t}","+}","+","+TEST_CASE(\"The passthrough grammar still interprets DISCONNECT\", \"[api][passthrough]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto &context = *con.context;","+","+\tauto statements = ParsePassthrough(context, \"DISCONNECT;\");","+\tREQUIRE(statements.size() == 1);","+\tREQUIRE(statements[0]->type == StatementType::DISCONNECT_STATEMENT);","+}","+","+TEST_CASE(\"The passthrough grammar splits statements like DuckDB does\", \"[api][passthrough]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto &context = *con.context;","+","+\tauto statements = ParsePassthrough(context, \"CREATE GRANT; DISCONNECT; SELECT 'a;b';\");","+\tREQUIRE(statements.size() == 3);","+\tREQUIRE(statements[0]->type == StatementType::PASSTHROUGH_STATEMENT);","+\tREQUIRE(statements[1]->type == StatementType::DISCONNECT_STATEMENT);","+\t// the ';' inside the string literal is not a boundary","+\tREQUIRE(statements[2]->type == StatementType::PASSTHROUGH_STATEMENT);","+\tREQUIRE(StringUtil::Contains(statements[2]->query, \"'a;b'\"));","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"test/api/test_passthrough_token_matcher.cpp","lines":["@@ -0,0 +1,86 @@","+#include \"catch.hpp\"","+","+#include \"duckdb/parser/peg/compiled_grammar.hpp\"","+#include \"duckdb/parser/peg/passthrough_dialect.hpp\"","+#include \"duckdb/parser/peg/tokenizer/parser_tokenizer.hpp\"","+#include \"duckdb/parser/token_iterator.hpp\"","+","+using namespace duckdb;","+","+namespace {","+","+struct MatchOutcome {","+\tbool success;","+\tidx_t consumed;","+\tstring text;","+};","+","+//! Match the matcher once against the token at `position` of the tokenized query","+MatchOutcome MatchTokenAt(const string &query, idx_t position) {","+\tauto compiled = CompiledGrammar::Create();","+\tvector<MatcherToken> tokens;","+\tParserTokenizerBehavior behavior(query, tokens);","+\tcompiled->GetTokenizer().TokenizeInput(behavior);","+","+\tTokenIterator iterator(tokens);","+\titerator.SetPosition(position);","+","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator parse_results;","+\tParserPackratCache packrat;","+\tidx_t max_position = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, parse_results, process_allocator, max_position, MatchMode::BUILD_PARSE_RESULT,","+\t                     IdentifierCaseMode::PRESERVE_CASE, &packrat);","+\tMatchState state(iterator, context);","+","+\tPassthroughTokenMatcher matcher;","+\tauto result = matcher.MatchParseResult(state);","+\tMatchOutcome outcome;","+\toutcome.success = result.IsSuccess();","+\toutcome.consumed = state.token_iterator.Position() - position;","+\tif (result.HasParseResult()) {","+\t\toutcome.text = result.GetParseResult()->Cast<TokenParseResult>().text;","+\t}","+\treturn outcome;","+}","+","+//! Consume tokens until the matcher fails, returning how many it took","+idx_t MatchTokensUntilFailure(const string &query) {","+\tidx_t position = 0;","+\twhile (MatchTokenAt(query, position).success) {","+\t\tposition++;","+\t}","+\treturn position;","+}","+","+} // namespace","+","+TEST_CASE(\"PassthroughTokenMatcher consumes a token of any type\", \"[api][passthrough_token]\") {","+\t// a keyword, an identifier, an operator, a string literal and a number all match","+\tfor (auto &query : vector<string> {\"CREATE\", \"my_table\", \"(\", \"'a string'\", \"42\"}) {","+\t\tauto outcome = MatchTokenAt(query, 0);","+\t\tREQUIRE(outcome.success);","+\t\tREQUIRE(outcome.consumed == 1);","+\t}","+}","+","+TEST_CASE(\"PassthroughTokenMatcher stops at a statement boundary\", \"[api][passthrough_token]\") {","+\t// GRANT is not DuckDB syntax - the point is that it is consumed anyway, up to the ';'","+\tREQUIRE(MatchTokensUntilFailure(\"GRANT ALL PRIVILEGES ON DATABASE pg TO bob; SELECT 42\") == 8);","+","+\t// the terminator itself never matches, nor does the end of input","+\tREQUIRE(!MatchTokenAt(\";\", 0).success);","+\tREQUIRE(!MatchTokenAt(\"\", 0).success);","+}","+","+TEST_CASE(\"PassthroughTokenMatcher does not split quoted text\", \"[api][passthrough_token]\") {","+\t// a ';' inside a string, a quoted identifier or a dollar-quoted body is not a boundary","+\tREQUIRE(MatchTokensUntilFailure(\"SELECT 'a;b'\") == 2);","+\tREQUIRE(MatchTokensUntilFailure(\"SELECT \\\"a;b\\\"\") == 2);","+\tREQUIRE(MatchTokensUntilFailure(\"CREATE FUNCTION f() AS $$ SELECT 1; $$\") == 7);","+","+\tauto outcome = MatchTokenAt(\"SELECT 'a;b'\", 1);","+\tREQUIRE(outcome.success);","+\tREQUIRE(outcome.text == \"'a;b'\");","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"test/sql/connect/connect_passthrough_quack.test","lines":["@@ -0,0 +1,71 @@","+# name: test/sql/connect/connect_passthrough_quack.test","+# description: While CONNECT-ed, statements are forwarded unparsed and invalid SQL fails on the server","+# group: [connect]","+","+require quack","+","+require httpfs","+","+# the Quack log type is registered by the extension, so it has to be loaded before enabling it","+statement ok","+LOAD quack;","+","+# the Quack log records every request before it is parsed; server-side entries have no 'server' URL","+statement ok","+CALL enable_logging('Quack');","+","+statement ok","+CALL quack_serve(token='test_token');","+","+statement ok","+ATTACH 'quack:localhost' AS qk (TOKEN 'test_token');","+","+statement ok","+CONNECT qk;","+","+statement error","+CREATE GRANT;","+----","+syntax error at or near \"GRANT\"","+","+# the connection stays usable after a server-side failure","+query I","+SELECT 42;","+----","+42","+","+# CONNECT is forwarded as well - only DISCONNECT stays local, so the client can always get back.","+# Forwarding CONNECT is what lets a connection chain over several hops.","+statement error","+CONNECT no_such_db;","+----","+<REGEX>:.*Error:.*","+","+statement ok","+DISCONNECT;","+","+# the forwarded CONNECT reached the server","+query I","+SELECT count(*) > 0 FROM duckdb_logs WHERE type = 'Quack' AND message LIKE '%''server'': NULL%'","+\tAND message LIKE '%''query'': CONNECT no_such_db;%';","+----","+true","+","+# the server received CREATE GRANT and its own parser rejected it","+query I","+SELECT count(*) FROM duckdb_logs WHERE type = 'Quack' AND message LIKE '%''server'': NULL%'","+\tAND message LIKE '%''query'': CREATE GRANT;%' AND message LIKE '%''error'': ''Parser Error: syntax error at or near \"GRANT\"%';","+----","+1","+","+# locally, the same statement is rejected by the client parser","+statement error","+CREATE GRANT;","+----","+<REGEX>:Parser Error:.*syntax error at or near \"GRANT\".*","+","+query I","+SELECT count(*) FROM duckdb_logs WHERE type = 'Quack' AND message LIKE '%''server'': NULL%'","+\tAND message LIKE '%''query'': CREATE GRANT;%';","+----","+1"],"additions":71,"deletions":0,"truncated":false},{"path":"test/sql/connect/connect_quack.test","lines":["@@ -33,11 +33,19 @@ SELECT range AS x, range * 2 AS y FROM range(3);"," 1\t2"," 2\t4"," ","-# CONNECT while already bound — single-binding rule errors with DISCONNECT hint.","+# CONNECT while already bound is forwarded like any other statement, which is what lets connections chain","+# over several hops. Here the remote has no such database, so the remote is the one that errors."," statement error","-CONNECT qk;","+CONNECT no_such_db;","+----","+<REGEX>:.*Error:.*","+","+# the binding survives a failure on the remote.","+query I","+SELECT 7;"," ----","-<REGEX>:Invalid Input Error:.*Already connected.*DISCONNECT first.*","+7","+"," "," # DISCONNECT drops the routing."," statement ok"],"additions":11,"deletions":3,"truncated":false},{"path":"tools/shell/tests/test_connect_hops.py","lines":["@@ -0,0 +1,107 @@","+# fmt: off","+","+import os","+import socket","+import subprocess","+import time","+","+import pytest","+from conftest import ShellTest, assert_loaded","+","+","+def free_port():","+    with socket.socket() as sock:","+        sock.bind((\"127.0.0.1\", 0))","+        return sock.getsockname()[1]","+","+","+class Server:","+    \"\"\"A quack server in its own process, kept alive by an open stdin\"\"\"","+","+    def __init__(self, shell, tmp_path, name, port, extra_statements=()):","+        init_file = tmp_path / f\"init_{name}.sql\"","+        statements = [","+            \"LOAD httpfs;\",","+            \"LOAD quack;\",","+            f\"CALL quack_serve('quack:localhost:{port}', token='{name}_token');\",","+        ]","+        statements.extend(extra_statements)","+        init_file.write_text(\"\\n\".join(statements) + \"\\n\")","+        self.port = port","+        self.process = subprocess.Popen(","+            [shell, \"--batch\", str(tmp_path / f\"{name}.db\"), \"-init\", str(init_file)],","+            stdin=subprocess.PIPE,","+            stdout=subprocess.PIPE,","+            stderr=subprocess.PIPE,","+        )","+","+    def wait_until_listening(self, timeout=30):","+        deadline = time.time() + timeout","+        while time.time() < deadline:","+            if self.process.poll() is not None:","+                raise RuntimeError(f\"server on port {self.port} exited: {self.process.communicate()[1]}\")","+            # the server may listen on either stack","+            for family, host in ((socket.AF_INET6, \"::1\"), (socket.AF_INET, \"127.0.0.1\")):","+                with socket.socket(family, socket.SOCK_STREAM) as sock:","+                    sock.settimeout(0.5)","+                    if sock.connect_ex((host, self.port)) == 0:","+                        return","+            time.sleep(0.1)","+        raise RuntimeError(f\"server on port {self.port} did not start listening\")","+","+    def stop(self):","+        self.process.stdin.close()","+        try:","+            self.process.wait(timeout=30)","+        except subprocess.TimeoutExpired:","+            self.process.kill()","+","+","+@pytest.mark.skipif(os.name == 'nt', reason=\"spawns background server processes\")"],"additions":60,"deletions":0,"truncated":false}],"additions":536,"deletions":6,"truncated":true,"file_count":26},"error":null,"fetched_at":"2026-09-29T14:23:38.019936+00:00"}