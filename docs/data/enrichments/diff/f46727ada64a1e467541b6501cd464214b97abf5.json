{"id":"f46727ada64a1e467541b6501cd464214b97abf5","axis":"silent","repo":"cypress-io/cypress","sha":"f46727ada64a1e467541b6501cd464214b97abf5","parsed":{"files":[{"path":"cli/CHANGELOG.md","lines":["@@ -37,6 +37,7 @@"," - Fixed a regression in [8.4.0](#8-4-0) where `.scrollTo()` on a scrollable element wrapped with [`Cypress.$`](https://on.cypress.io/$), other than the window or `body`, threw `TypeError: Cannot read properties of undefined (reading 'slice')` when given a selector string, a number, or `'max'`, such as `Cypress.$('#list').scrollTo('#item')` or `Cypress.$('#list').scrollTo(120)`. It now scrolls to the matching element or position. Fixed in [#35460](https://github.com/cypress-io/cypress/pull/35460)."," - Fixed an issue where Cypress failed to load your config with `Cannot read properties of undefined (reading 'getFilesByGlob')` when a [`supportFile`](https://on.cypress.io/configuration) pattern with `**`, such as `cypress/support/**/e2e.js`, searched a directory Cypress cannot read. Cypress now skips that directory, finds the support file, and runs your specs. Fixed in [#35486](https://github.com/cypress-io/cypress/pull/35486)."," - In Firefox, error stack traces in the Command Log and in `cypress run` output no longer end the names of nested anonymous functions with a stray `/` or `/</`. For example, a test's callback now shows as `at ./cypress/spec.cy.js` instead of `at ./cypress/spec.cy.js/`. A frame with no name to show now reads `at <unknown>` instead of being blank. Fixed in [#35462](https://github.com/cypress-io/cypress/pull/35462).","+- Requests from your application no longer carry Cypress's internal `__cypress.initial` and `__cypress.unload` cookies to your server or to [`cy.intercept()`](https://on.cypress.io/intercept) request handlers. For example, a request with no cookies of its own could arrive with `Cookie: __cypress.unload=true`, and now arrives without a `Cookie` header. Fixed in [#35470](https://github.com/cypress-io/cypress/pull/35470)."," - Fixed an issue where run mode durations of 24 hours or more dropped the whole days, so a run that took exactly 24 hours was reported as `0ms` and a run of 26 hours as `2:00:00`. Fixes [#34976](https://github.com/cypress-io/cypress/issues/34976)."," "," **Misc:**"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/driver/cypress/e2e/e2e/origin/cypress_cookies.cy.ts","lines":["@@ -0,0 +1,36 @@","+describe('Cypress cookies on the application\\'s origin', { browser: '!webkit' }, () => {","+  const originUrl = 'https://www.foobar.com:3502'","+","+  const fetchWithCookies = (cookies: string[]) => {","+    cy.intercept(`${originUrl}/dump-headers`).as('req')","+","+    cy.visit('/fixtures/primary-origin.html')","+    cy.get('a[data-cy=\"cookie-https\"]').click()","+","+    return cy.origin(originUrl, { args: { originUrl, cookies } }, ({ originUrl, cookies }) => {","+      cy.window().then((win) => {","+        cookies.forEach((cookie) => win.document.cookie = cookie)","+","+        expect(win.document.cookie).to.include('__cypress.unload=true')","+","+        return cy.wrap(win.fetch(`${originUrl}/dump-headers`).then((res) => res.text()))","+      })","+    })","+  }","+","+  it('sends only the application\\'s cookies with its requests', () => {","+    fetchWithCookies(['__cypress.unload=true', 'session_id=8f2c1e9a40b7']).then((headersReceived) => {","+      expect(headersReceived).to.include('\"cookie\":\"session_id=8f2c1e9a40b7\"')","+    })","+","+    cy.wait('@req').its('request.headers.cookie').should('eq', 'session_id=8f2c1e9a40b7')","+  })","+","+  it('sends no cookies when the application has none', () => {","+    fetchWithCookies(['__cypress.unload=true']).then((headersReceived) => {","+      expect(headersReceived).not.to.include('\"cookie\"')","+    })","+","+    cy.wait('@req').its('request.headers.cookie').should('be.undefined')","+  })","+})"],"additions":36,"deletions":0,"truncated":false},{"path":"packages/proxy/lib/http/request-middleware.ts","lines":["@@ -3,6 +3,7 @@ import { InterceptRequest, SetMatchingRoutes } from '@packages/net-stubbing'"," import { telemetry } from '@packages/telemetry'"," import { isVerboseTelemetry as isVerbose } from '.'"," import { doesTopNeedToBeSimulated } from './util/top-simulation'","+import { stripCypressCookies } from './util/cookies'"," import { resourceTypeAndCredentialManager } from '../resourceTypeAndCredentialManager'"," import type { HttpMiddleware } from './'"," import { getSupportedAcceptEncoding, urlMatchesOriginProtectionSpace } from '@packages/network-tools'","@@ -51,6 +52,7 @@ const ExtractCypressMetadataHeaders: RequestMiddleware = function () {","     this.debug('request for [%s %s] is from an extra target', this.req.method, this.req.proxiedUrl)"," ","     this.onlyRunMiddleware([","+      'StripCypressCookies',","       'MaybeSetBasicAuthHeaders',","     ])","   }","@@ -130,6 +132,19 @@ const FormatCookiesIfApplicable: RequestMiddleware = function () {","   return this.next()"," }"," ","+// `req.cookies` was parsed before this runs, so the proxy can still read them.","+const StripCypressCookies: RequestMiddleware = function () {","+  const appCookies = stripCypressCookies(this.req.headers.cookie)","+","+  if (appCookies) {","+    this.req.headers.cookie = appCookies","+  } else {","+    delete this.req.headers.cookie","+  }","+","+  this.next()","+}","+"," const MaybeAttachCrossOriginCookies: RequestMiddleware = async function () {","   return this.networkInterceptionCore.attachCrossOriginCookies(this)"," }","@@ -278,6 +293,7 @@ export default {","   CalculateCredentialLevelIfApplicable,","   FormatCookiesIfApplicable,","   MaybeAttachCrossOriginCookies,","+  StripCypressCookies,","   MaybeEndRequestWithBufferedResponse,","   SetMatchingRoutes,","   SendToDriver,"],"additions":16,"deletions":0,"truncated":false},{"path":"packages/proxy/lib/http/util/cookies.ts","lines":["@@ -116,6 +116,18 @@ export const addCookieJarCookiesToRequest = (applicableCookieJarCookies: Cookie[","   return applicableCookieJarCookies.concat(requestCookiesThatNeedToBeAdded).map((cookie) => cookie.cookieString()).join('; ')"," }"," ","+// `session_id=8f2c; __cypress.unload=true` becomes `session_id=8f2c`, and a","+// header holding only Cypress's cookies becomes `undefined`.","+export const stripCypressCookies = (cookieHeader: string | undefined): string | undefined => {","+  if (!cookieHeader?.includes('__cypress.')) {","+    return cookieHeader","+  }","+","+  const appCookies = cookieHeader.split(/;\\s*/).filter((pair) => pair && !pair.startsWith('__cypress.'))","+","+  return appCookies.length ? appCookies.join('; ') : undefined","+}","+"," // sameSiteContext is a concept for tough-cookie's cookie jar that helps it"," // simulate what a browser would do when determining whether or not it should"," // be set from a response or a attached to a response. it shouldn't be confused"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/proxy/lib/index.ts","lines":["@@ -13,3 +13,5 @@ export type { CreateProxyNetworkInterceptionOptions } from './adapters/create-pr"," export { defaultMiddleware } from './http'"," "," export { getMetadataHeaderValue } from './http/util/metadata-header-value'","+","+export { stripCypressCookies } from './http/util/cookies'"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/proxy/test/unit/http/request-middleware.spec.ts","lines":["@@ -51,6 +51,7 @@ describe('http/request-middleware', () => {","       'CalculateCredentialLevelIfApplicable',","       'FormatCookiesIfApplicable',","       'MaybeAttachCrossOriginCookies',","+      'StripCypressCookies',","       'MaybeEndRequestWithBufferedResponse',","       'SetMatchingRoutes',","       'SendToDriver',","@@ -119,11 +120,16 @@ describe('http/request-middleware', () => {","         const ctx = prepareContext({","           'x-cypress-is-from-extra-target': getMetadataHeaderValue(),","         })","+        let stripCypressCookiesRa