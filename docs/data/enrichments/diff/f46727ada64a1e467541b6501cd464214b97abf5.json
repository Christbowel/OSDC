nst req = await stripFrom()","+","+      expect(req.headers).not.toHaveProperty('cookie')","+    })","+  })","+","   describe('MaybeAttachCrossOriginCookies', () => {","     const { MaybeAttachCrossOriginCookies } = RequestMiddleware"," "],"additions":45,"deletions":0,"truncated":false},{"path":"packages/proxy/test/unit/http/util/cookies.spec.ts","lines":["@@ -1,5 +1,5 @@"," import { describe, expect, it } from 'vitest'","-import { calculateSiteContext, getSameSiteContext, shouldAttachAndSetCookies } from '../../../../lib/http/util/cookies'","+import { calculateSiteContext, getSameSiteContext, shouldAttachAndSetCookies, stripCypressCookies } from '../../../../lib/http/util/cookies'"," "," describe('getSameSiteContext', () => {","   describe('calculates the same site context correctly for', () => {","@@ -259,3 +259,33 @@ describe('.calculateSiteContext', () => {","     expect(calculateSiteContext(autUrl, 'https://staging.google2.com')).toEqual('cross-site')","   })"," })","+","+describe('stripCypressCookies', () => {","+  it('returns undefined when the header only holds Cypress cookies', () => {","+    expect(stripCypressCookies('__cypress.unload=true; __cypress.initial=true')).toBeUndefined()","+  })","+","+  it('keeps the application\\'s cookies', () => {","+    expect(stripCypressCookies('session_id=8f2c1e9a40b7; __cypress.unload=true; theme=dark')).toEqual('session_id=8f2c1e9a40b7; theme=dark')","+  })","+","+  it('removes Cypress cookies delimited without a space', () => {","+    expect(stripCypressCookies('session_id=8f2c1e9a40b7;__cypress.unload=true')).toEqual('session_id=8f2c1e9a40b7')","+  })","+","+  it('drops the empty pair a trailing delimiter leaves', () => {","+    expect(stripCypressCookies('session_id=8f2c1e9a40b7; __cypress.unload=true;')).toEqual('session_id=8f2c1e9a40b7')","+  })","+","+  it('leaves a header without Cypress cookies untouched', () => {","+    expect(stripCypressCookies('session_id=8f2c1e9a40b7;theme=dark')).toEqual('session_id=8f2c