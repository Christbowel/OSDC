d)"," \tauto cte_query = std::move(bind_state.query.plan);"," \tauto cte_child = std::move(child.plan);"," ","-\tauto root = make_uniq<LogicalMaterializedCTE>(bound_cte.ctename, bound_cte.setop_index, result.types.size(),","-\t                                              std::move(cte_query), std::move(cte_child), bound_cte.materialized);","+\tauto root =","+\t    make_uniq<LogicalMaterializedCTE>(bound_cte.ctename, bound_cte.setop_index, bind_state.query.types.size(),","+\t                                      std::move(cte_query), std::move(cte_child), bound_cte.materialized);"," "," \tresult.plan = std::move(root);"," \treturn result;"],"additions":3,"deletions":2,"truncated":false},{"path":"test/configs/verification_projection.json","lines":["@@ -21,9 +21,10 @@","       ]","     },","     {","-      \"reason\": \"Cost-aware projection placement tests assert topology changed by synthetic verification projections.\",","+      \"reason\": \"Projection placement and pullup tests assert topology changed by synthetic verification projections.\",","       \"paths\": [","-        \"test/optimizer/projection_placement.test\"","+        \"test/optimizer/projection_placement.test\",","+        \"test/optimizer/projection_pullup_nested_plan.test\"","       ]","     },","     {"],"additions":3,"deletions":2,"truncated":false},{"path":"test/optimizer/materialized_cte_column_count.test","lines":["@@ -0,0 +1,49 @@","+# name: test/optimizer/materialized_cte_column_count.test","+# description: Materialized CTE column counts follow the producer before and after pruning","+# group: [optimizer]","+","+require json","+","+statement ok","+CREATE TABLE t(dead VARCHAR, payload BIGINT, key INTEGER);","+","+statement ok","+INSERT INTO t VALUES ('unused', 101, 1), ('unused', 102, 1), ('unused', 201, 2), ('unused', 999, NULL);","+","+# The producer has three columns, although the final query returns only one.","+query I","+SELECT json_extract(json_serialize_plan(","+\t'WITH c AS MATERIALIZED (SELECT * FROM t) SELECT payload + key FROM c',","+\toptimize := false","+), '$.plans[0].column_count');","+----","+3","+","+# Pruning removes dead from the producer and updates its column count.","+query I","+SELECT json_extract(json_serialize_plan(","+\t'WITH c AS MATERIALIZED (SELECT * FROM t) SELECT payload + key FROM c',","+\toptimize := true","+), '$.plans[0].column_count');","+----","+2","+","+query I","+WITH c AS MATERIALIZED (SELECT * FROM t)","+SELECT payload + key FROM c ORDER BY ALL;","+----","+102","+103","+203","+NULL","+","+# Both readers retain the correct bindings after pruning the producer.","+query II","+WITH c AS MATERIALIZED (SELECT * FROM t)","+SELECT a.key, b.payload FROM c a JOIN c b ON a.key = b.key ORDER BY ALL;","+----","+1\t101","+1\t101","+1\t102","+1\t102","+2\t201"],"additions":49,"deletions":0,"truncated":false},{"path":"test/optimizer/projection_pullup_nested.test","lines":["@@ -0,0 +1,24 @@","+# name: test/optimizer/projection_pullup_nested.test","+# description: Results after pulling a computed projection over nested joins","+# group: [optimizer]","+","+statement ok","+CREATE TABLE t(i INTEGER);","+","+statement ok","+INSERT INTO t VALUES (1), (20);","+","+# Compression would introduce its own projections below the joins.","+statement ok","+SET disabled_optimizers = 'compressed_materialization';","+","+query II","+SELECT p.x, z.i","+FROM (","+\tSELECT length(a.i::VARCHAR) x, a.i","+\tFROM (SELECT i FROM t) a JOIN (SELECT i FROM t) b USING (i)","+) p JOIN t z USING (i)","+ORDER BY z.i;","+----","+1\t1","+2\t20"],"additions":24,"deletions":0,"truncated":false},{"path":"test/optimizer/projection_pullup_nested_plan.test","lines":["@@ -0,0 +1,29 @@","+# name: test/optimizer/projection_pullup_nested_plan.test","+# description: Moving a computed projection still visits projections below its child join","+# group: [optimizer]","+","+statement ok","+CREATE TABLE t(i INTEGER);","+","+statement ok","+INSERT INTO t VALUES (1), (20);","+","+# Compression would introduce its own projections below the joins.","+statement ok","+SET disabled_optimizers = 'compressed_materialization';","+","+statement ok","+SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};","+","+statement ok","+SET explain_output = 'optimized_only';","+","+# Pulling length above the outer join must also remove the inner column-reference projections.","+query II","+EXPLAIN SELECT p.x, z.i","+FROM (","+\tSELECT length(a.i::VARCHAR) x, a.i","+\tFROM (SELECT i FROM t) a JOIN (SELECT i FROM t) b USING (i)","+) p JOIN t z USING (i);","+----","+logical_opt\t<!REGEX>:(?s).*JOIN.*PROJECTION.*"],"additions":29,"deletions":0,"truncated":false},{"path":"test/optimizer/table_in_out_unique_keys.test","lines":["@@ -0,0 +1,21 @@","+# name: test/optimizer/table_in_out_unique_keys.test","+# description: Table-in/out functions can produce multiple rows for a unique input key","+# group: [optimizer]","+","+# range expands each correlated key, so row_number must not be folded to one.","+query III","+SELECT k, j, rn","+FROM (VALUES (1), (2), (1)) t(k),","+LATERAL (","+\tSELECT j, row_number() OVER (ORDER BY k, j DESC) rn","+\tFROM range(k + 1) r(j)","+) q","+ORDER BY k, j;","+----","+1\t0\t2","+1\t0\t2","+1\t1\t1","+1\t1\t1","+2\t0\t3","+2\t1\t2","+2\t2\t1",""],"additions":21,"deletions":0,"truncated":false}],"additions":137,"deletions":5,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-02T17:25:38.654695+00:00"}