{"id":"297c174fca94cb859e0229279ed05c4e71b58f8d","axis":"silent","repo":"kestra-io/kestra","sha":"297c174fca94cb859e0229279ed05c4e71b58f8d","parsed":{"files":[{"path":"ui/.storybook/apiMock.ts","lines":["@@ -298,7 +298,9 @@ function installFetchMock(): void {"," ","         return bodyPromise","             .catch(() => undefined)","-            .then((body) => jsonResponse(resolveApiRequest(method, rawUrl, {body})))","+            .then((body) => resolveApiRequest(method, rawUrl, {body}))","+            // Awaited so a handler can return a promise and hold its response until the story releases it.","+            .then(async ({status, data}) => jsonResponse({status, data: await data}))","     }"," ","     wrapper.__kestraApiMock = true"],"additions":3,"deletions":1,"truncated":false},{"path":"ui/package.json","lines":["@@ -22,6 +22,7 @@","         \"generate:sbom\": \"cyclonedx-npm --spec-version 1.6 --omit dev --output-reproducible --output-format JSON --output-file build/sbom/bom.json\",","         \"generate:openapi-spec\": \"cd .. && ./gradlew :webserver:generateOpenapiSpec\",","         \"generate:sdk\": \"node scripts/ensure-sdk.mjs --check-spec\",","+        \"generate:flow-schema-placeholder\": \"node scripts/generate-flow-schema-placeholder.mjs\",","         \"preview\": \"vite preview\",","         \"precheck:types\": \"node scripts/ensure-sdk.mjs\",","         \"check:types\": \"vue-tsc --build packages/design-system/tsconfig.app.json && echo \\\"design-system compiled\\\" \\\\\\n && vue-tsc --build tsconfig.app.json && echo \\\"app checked\\\" \\\\\\n && vue-tsc --project tsconfig.test.json && echo \\\"test checked\\\"\","],"additions":1,"deletions":0,"truncated":false},{"path":"ui/scripts/generate-flow-schema-placeholder.mjs","lines":["@@ -0,0 +1,75 @@","+#!/usr/bin/env node","+// @ts-check","+","+// Rebuilds src/stores/flow-schema.json, the schema the no-code editor renders with until the full one is loaded.","+// Usage: node scripts/generate-flow-schema-placeholder.mjs <file or URL of GET /api/v1/plugins/schemas/flow>","+import {readFileSync, writeFileSync} from \"node:fs\"","+import path from \"node:path\"","+import {fileURLToPath} from \"node:url\"","+import {inflateCompactSchema} from \"../src/utils/compactSchema.ts\"","+","+const OUTPUT = path.join(path.dirname(fileURLToPath(import.meta.url)), \"../src/stores/flow-schema.json\")","+const DEFINITIONS = \"#/definitions/\"","+// The one plugin kept, so that a list of plugins still reads as a list of typed blocks.","+const SAMPLE_PLUGIN = \"io.kestra.plugin.core.log.Log\"","+// Root property holding each list of plugins, and the definition standing in for that list.","+const PLUGIN_LISTS = {tasks: \"io.kestra.preload.tasks\", triggers: \"io.kestra.preload.triggers\"}","+","+const source = process.argv[2]","+if (!source) {","+    console.error(\"Usage: node scripts/generate-flow-schema-placeholder.mjs <file or URL of the flow schema>\")","+    process.exit(1)","+}","+","+// The endpoint serves the compact schema, whose subtype lists sit behind shared-* refs this script compares inline.","+const full = inflateCompactSchema(JSON.parse(/^https?:/.test(source) ? await (await fetch(source)).text() : readFileSync(source, \"utf8\")))","+const rootKey = full.$ref.slice(DEFINITIONS.length)","+const root = structuredClone(full.definitions[rootKey])","+","+/** @param {{items?: {anyOf?: unknown[]}}} property */","+const subtypesOf = (property) => JSON.stringify(property.items?.anyOf)","+const standInBySubtypes = new Map(Object.entries(PLUGIN_LISTS).map(([property, standIn]) => [subtypesOf(root.properties[property]), standIn]))","+","+// `errors`, `finally` and `afterExecution` repeat the list of tasks, so they share its stand-in.","+for (const [name, property] of Object.entries(root.properties)) {","+    const standIn = standInBySubtypes.get(subtypesOf(property))","+    if (standIn) {","+        root.properties[name] = {$ref: DEFINITIONS + standIn}","+    }","+}","+","+/** @type {Record<string, unknown>} */","+const definitions = {[rootKey]: root, [SAMPLE_PLUGIN]: full.definitions[SAMPLE_PLUGIN]}","+for (const standIn of Object.values(PLUGIN_LISTS)) {","+    definitions[standIn] = {type: \"array\", items: {anyOf: [{$ref: DEFINITIONS + SAMPLE_PLUGIN}]}}","+}","+","+/** @param {unknown} node @param {(key: string) => void} visit */","+function forEachRef(node, visit) {","+    if (Array.isArray(node)) {","+        node.forEach((child) => forEachRef(child, visit))","+    } else if (node && typeof node === \"object\") {","+        for (const [key, value] of Object.entries(node)) {","+            if (key === \"$ref\" && typeof value === \"string\") {","+                visit(value.slice(DEFINITIONS.length))","+            } else {","+                forEachRef(value, visit)","+            }","+        }","+    }","+}","+","+// Everything the kept definitions still reference comes along, so the placeholder has no dangling $ref.","+const pending = Object.values(definitions)","+while (pending.length) {","+    forEachRef(pending.pop(), (key) => {","+        if (!(key in definitions)) {","+            definitions[key] = full.definitions[key]","+            pending.push(definitions[key])","+        }","+    })","+}","+","+const sorted = Object.fromEntries(Object.keys(definitions).sort().map((key) => [key, definitions[key]]))","+writeFileSync(OUTPUT, JSON.stringify({$schema: full.$schema, $ref: full.$ref, definitions: sorted}, null, 2) + \"\\n\")","+console.log(`${path.relative(process.cwd(), OUTPUT)}: ${Object.keys(sorted).length} definitions`)"],"additions":75,"deletions":0,"truncated":false},{"path":"ui/src/components/inputs/FlowFileEditorTab.spec.ts","lines":["@@ -9,6 +9,7 @@ import {useViolationMarkers} from \"../../composables/useViolationMarkers\""," const fileMetadata = vi.fn()"," const readFile = vi.fn()"," const saveOrCreateFile = vi.fn()","+const lazyLoadSchemaType = vi.fn()"," "," vi.mock(\"vue-router\", () => ({","     useRoute: () => ({params: {namespace: \"io.kestra.test\"}, query: {}}),","@@ -45,7 +46,7 @@ vi.mock(\"../../composables/useViolationMarkers\", async () => {","     return {useViolationMarkers: () => ({markers, revealNext})}"," })"," vi.mock(\"../../stores/plugins\", () => ({","-    usePluginsStore: () => ({lazyLoadSchemaType: vi.fn(), editorPlugin: undefined, allTypes: [], updateDocumentation: vi.fn()}),","+    usePluginsStore: () => ({lazyLoadSchemaType, editorPlugin: undefined, allTypes: [], updateDocumentation: vi.fn()}),"," }))"," vi.mock(\"../../stores/productTour\", () => ({","     useProductTourStore: () => ({isGuidedActive: false}),","@@ -286,6 +287,14 @@ describe(\"FlowFileEditorTab\", () => {","         expect(useFlowStore().errorNavigation).toBeNull()","     })"," ","+    // The YAML worker fetches its own schema; a second copy parsed on the main thread only slows the editor down.","+    it(\"should not load the flow schema when the flow tab opens\", async () => {","+        mountWithTabContext(FlowFileEditorTab, flowTabProps)","+        await flushPromises()","+","+        expect(lazyLoadSchemaType).not.toHaveBeenCalled()","+    })","+","     it(\"should drop error navigation while the flow tab is parked in KeepAlive and restore it when shown again\", async () => {","         violationMarkers().value = locatedErrors","         const shown = ref(true)"],"additions":10,"deletions":1,"truncated":false},{"path":"ui/src/components/inputs/FlowFileEditorTab.vue","lines":["@@ -250,9 +250,6 @@","     )"," ","     onMounted(() => {","-        if(props.flow){","-            pluginsStore.lazyLoadSchemaType({type: \"flow\"})","-        }","         loadFile()","         window.addEventListener(\"keydown\", handleGlobalSave)","         window.addEventListener(\"keydown\", toggleAiShortcut)"],"additions":0,"deletions":3,"truncated":false},{"path":"ui/src/components/no-code/NoCode.stories.tsx","lines":["@@ -4,7 +4,8 @@ import InitialSchema from \"../../stores/flow-schema.json\";"," import {vueRouter} from \"storybook-vue3-router\";"," import {useFlowStore} from \"../../stores/flow\";"," import {setMockClient, type AxiosLikeClient} from \"@kestra-io/kestra-sdk\"","-import {mockResponse} from \"../../../.storybook/apiMock\"","+import {expect, waitFor, within} from \"storybook/test\"","+import {mockResponse, mockStoryApiRoutes} from \"../../../.storybook/apiMock\""," "," "," export default {","@@ -127,3 +128,90 @@ tasks:","        blockSchemaPath: \"#/definitions/io.kestra.core.models.flows.Flow/properties/tasks/items\",","     },"," };","+","+const RETURN_TYPE = \"io.kestra.plugin.core.debug.Return\"","+","+// What the backend answers once the plugins are known: the placeholder plus a task type it does not carry.","+const FULL_SCHEMA = {","+    ...InitialSchema,","+    definitions: {","+        ...InitialSchema.definitions,","+        \"io.kestra.preload.tasks\": {","+            type: \"array\",","+            items: {anyOf: [{$ref: \"#/definitions/io.kestra.plugin.core.log.Log\"}, {$ref: `#/definitions/${RETURN_TYPE}`}]},","+        },","+        [RETURN_TYPE]: {","+            type: \"object\",","+            required: [\"id\", \"type\"],","+            properties: {","+                id: InitialSchema.definitions[\"io.kestra.plugin.core.log.Log\"].properties.id,","+                type: {const: RETURN_TYPE},","+                format: {type: \"string\", title: \"The templated string to render.\"},","+            },","+        },","+    },","+}","+","+let releaseSchema: () => void = () => {}","+","+function holdSchemaResponse() {","+    mockStoryApiRoutes({","+        \"GET /plugins/schemas/:type\": () => new Promise((resolve) => {","+            releaseSchema = () => resolve(FULL_SCHEMA)","+        }),","+    })","+}","+","+const skeleton = (root: HTMLElement) => root.querySelector(\"[data-test=task-editor-schema-skeleton]\")","+","+const EDIT_FIRST_TASK = {","+    editingTask: true,","+    blockSchemaPath: \"#/definitions/io.kestra.core.models.flows.Flow/properties/tasks/items\",","+}","+","+export const TaskOpenedWhileSchemaLoads = Template.bind({});","+TaskOpenedWhileSchemaLoads.beforeEach = holdSchemaResponse","+TaskOpenedWhileSchemaLoads.args = {","+    flow: `","+id: flow1","+namespace: namespace1","+tasks:","+  - id: task1","+    type: ${RETURN_TYPE}","+    format: \"Hello world\"","+    `.trim(),","+    props: EDIT_FIRST_TASK,","+};","+TaskOpenedWhileSchemaLoads.play = async ({canvasElement}) => {","+    const canvas = within(canvasElement)","+","+    await waitFor(() => expect(skeleton(canvasElement)).toBeVisible())","+    await expect(canvas.queryAllByText(\"format\")).toHaveLength(0)","+","+    releaseSchema()","+","+    // The field label; the field's own editor repeats it as a placeholder.","+    await waitFor(() => expect(canvas.queryAllByText(\"format\")[0]).toBeVisible())","+    await expect(skeleton(canvasElement)).not.toBeInTheDocument()","+}","+","+export const KnownTaskOpenedWhileSchemaLoads = Template.bind({});","+KnownTaskOpenedWhileSchemaLoads.beforeEach = holdSchemaResponse","+KnownTaskOpenedWhileSchemaLoads.args = {","+    flow: `","+id: flow1","+namespace: namespace1","+tasks:","+  - id: task1","+    type: io.kestra.plugin.core.log.Log","+    message: \"Hello world\"","+    `.trim(),","+    props: EDIT_FIRST_TASK,","+};","+KnownTaskOpenedWhileSchemaLoads.play = async ({canvasElement}) => {","+    const canvas = within(canvasElement)","+","+    await waitFor(() => expect(canvas.queryAllByText(\"message\")[0]).toBeVisible())","+    await expect(skeleton(canvasElement)).not.toBeInTheDocument()","+    releaseSchema()","+}"],"additions":89,"deletions":1,"truncated":false},{"path":"ui/src/components/no-code/NoCode.vue","lines":["@@ -57,6 +57,7 @@","         REF_PATH_INJECTION_KEY,","         ROOT_SCHEMA_INJECTION_KEY,","         SCHEMA_DEFINITIONS_INJECTION_KEY,","+        SCHEMA_LOADER_INJECTION_KEY,","         SAVE_FLOW_FUNCTION_INJECTION_KEY,","         UPDATE_YAML_FUNCTION_INJECTION_KEY,","     } from \"./injectionKeys\"","@@ -169,6 +170,7 @@","     provide(FULL_SCHEMA_INJECTION_KEY, computed(() => pluginsStore.flowSchema ?? {}))","     provide(ROOT_SCHEMA_INJECTION_KEY, computed(() => pluginsStore.flowRootSchema ?? {}))","     provide(SCHEMA_DEFINITIONS_INJECTION_KEY, computed(() => pluginsStore.flowDefinitions ?? {}))","+    provide(SCHEMA_LOADER_INJECTION_KEY, pluginsStore.flowSchemaLoader)"," ","     provide(FIELD_VALIDATION_ERRORS_INJECTION_KEY, useFieldValidationErrors(() => {","         if (props.creatingTask) return undefined"],"additions":2,"deletions":0,"truncated":false},{"path":"ui/src/components/no-code/README.md","lines":["@@ -3,3 +3,15 @@"," > Code within `Vue` components must be written using the `<script setup>` block, as enforced by the `ESLint` rule."," "," This is a brief guide on working with the `NoCode` editor component.","+","+#### Flow schema loading","+","+The flow schema is megabytes of JSON, so it is only fetched by what needs it: the no-code tab when it mounts (`BlockEditor.vue`, or `useFlowFields` for the legacy engine), and topology once a form is opened, through the `load()` of `SCHEMA_LOADER_INJECTION_KEY` that `TaskEditor.vue` calls. The YAML editor does not load it; its worker fetches its own copy.","+","+Until the response lands, `pluginsStore.flowSchema` is the placeholder bundled in `src/stores/flow-schema.json`: the real `Flow` root and every core model it references (inputs, retry, SLA, ...), with each list of plugins cut down to a single sample task. Flow-level fields therefore render at once and do not change when the full schema arrives. A block the placeholder cannot resolve, such as a task of any other type, shows a skeleton while the loader's `isLoading` is true.","+","+Regenerate the placeholder whenever the `Flow` model or one of the models it references changes:","+","+```bash","+npm run generate:flow-schema-placeholder -- http://localhost:8080/api/v1/plugins/schemas/flow","+```"],"additions":12,"deletions":0,"truncated":false},{"path":"ui/src/components/no-code/blocks/BlockEditor.spec.ts","lines":["@@ -151,6 +151,7 @@ vi.mock(\"../../../stores/plugins\", () => ({","         icons: {},","         plugins: mockPlugins,","         ensurePlugins: mockEnsurePlugins,","+        lazyLoadSchemaType: vi.fn(),","     }),"," }))"," "],"additions":1,"deletions":0,"truncated":false},{"path":"ui/src/components/no-code/blocks/BlockEditor.vue","lines":["@@ -265,6 +265,9 @@","         emit(\"createTask\", parentPath, blockSchemaPath, refPath, \"after\")","     }"," ","+    // An authoring surface: fetched at once, so the full schema is usually there by the time a block is opened.","+    void pluginsStore.lazyLoadSchemaType({type: \"flow\"})","+","     useBlockEditorProvides({","         props,","         flowYaml,"],"additions":3,"deletions":0,"truncated":false},{"path":"ui/src/components/no-code/blocks/useBlockEditorProvides.spec.ts","lines":["@@ -36,6 +36,7 @@ import {","     ROOT_SCHEMA_INJECTION_KEY,","     SAVE_FLOW_FUNCTION_INJECTION_KEY,","     SCHEMA_DEFINITIONS_INJECTION_KEY,","+    SCHEMA_LOADER_INJECTION_KEY,","     UPDATE_YAML_FUNCTION_INJECTION_KEY,"," } from \"../injectionKeys\""," ","@@ -57,6 +58,7 @@ const KEYS = {","     FULL_SCHEMA: FULL_SCHEMA_INJECTION_KEY,","     ROOT_SCHEMA: ROOT_SCHEMA_INJECTION_KEY,","     SCHEMA_DEFINITIONS: SCHEMA_DEFINITIONS_INJECTION_KEY,","+    SCHEMA_LOADER: SCHEMA_LOADER_INJECTION_KEY,","     CREATE_TASK_FUNCTION: CREATE_TASK_FUNCTION_INJECTION_KEY,","     EDIT_TASK_FUNCTION: EDIT_TASK_FUNCTION_INJECTION_KEY,","     CLOSE_TASK_FUNCTION: CLOSE_TASK_FUNCTION_INJECTION_KEY,","@@ -265,6 +267,17 @@ describe(\"useBlockEditorProvides\", () => {","             expect(value(\"SCHEMA_DEFINITIONS\")).toEqual(flowDefinitions)","         })"," ","+        // Topology also mounts read-only on an execution, where nothing ever needs the megabytes of schema.","+        it(\"hands forms the flow schema loader without loading it\", () => {","