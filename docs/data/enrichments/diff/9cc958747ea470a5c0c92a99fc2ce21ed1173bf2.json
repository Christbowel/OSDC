atement, so `read` runs before the next step.","+pub(super) async fn first_row<Output>(","+    mut rows: libsql::Rows,","+    read: impl FnOnce(&Row) -> Result<Output>,","+) -> Result<Option<Output>> {","+    let first = match rows.next().await? {","+        Some(row) => Some(read(&row)?),","+        None => None,","+    };","+    while rows.next().await?.is_some() {}","+    Ok(first)","+}","+"," /// Connections to one database, each running one operation at a time."," ///"," /// A remote connection is a stream on the server, and each response hands the"],"additions":17,"deletions":1,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/schema.rs","lines":["@@ -1,5 +1,6 @@"," use super::{","-    Connection, Duration, LibsqlError, RegistryError, Result, TransactionBehavior, params,","+    Connection, Duration, LibsqlError, RegistryError, Result, TransactionBehavior, first_row,","+    params,"," };"," "," /// Take one slot of the capped user counter, reporting whether the cap left","@@ -33,11 +34,10 @@ where"," }"," "," pub(super) async fn ensure_user_counter(conn: &Connection) -> Result<()> {","-    let mut rows = conn.query(\"SELECT COUNT(*) FROM users\", ()).await?;","-    let Some(row) = rows.next().await? else {","+    let rows = conn.query(\"SELECT COUNT(*) FROM users\", ()).await?;","+    let Some(count) = first_row(rows, |row| Ok(row.get::<i64>(0)?)).await? else {","         return Err(missing_count_row());","     };","-    let count: i64 = row.get(0)?;","     let tx = conn.transaction().await?;","     let inserted = tx.execute(","         \"INSERT INTO auth_counters (name, value) VALUES (?1, ?2)\",","@@ -65,21 +65,16 @@ pub(super) async fn ensure_user_counter(conn: &Connection) -> Result<()> {"," "," pub(super) async fn reconcile_user_counter_overcount(conn: &Connection) -> Result<bool> {","     let tx = conn.transaction_with_behavior(TransactionBehavior::Immediate).await?;","-    let mut counter_rows =","+    let counter_rows =","         tx.query(