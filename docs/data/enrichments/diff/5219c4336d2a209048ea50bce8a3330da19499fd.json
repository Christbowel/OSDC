27,12 @@ fn expected_arguments(case: &RoundtripCase, raw_json: &str) -> Result<String> {","         sort_json_value(&mut value);","     }"," ","-    case.json_fmt","+    // Format with `serde_json_fmt`, independently of the parsers' `JsonStyle`.","+    let json_fmt = match case.json_style {","+        JsonStyle::Compact => compact_json_fmt(),","+        JsonStyle::Spaced => spaced_json_fmt(),","+    };","+    json_fmt","         .format_to_string(&value)","         .context(\"failed to format expected tool-call arguments\")"," }"],"additions":34,"deletions":27,"truncated":false},{"path":"rust/src/parser/src/tool/arguments.rs","lines":["@@ -0,0 +1,100 @@","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+//! The OpenAI `arguments` JSON of a tool call.","+","+use std::io;","+","+use serde::Serialize;","+use serde_json::ser::{Formatter, Serializer};","+","+/// JSON separators of the tool-call `arguments` a parser writes.","+///","+/// A parser that serializes `arguments` itself uses the style its format's","+/// chat template renders JSON in, so parsing a rendered tool call gives back","+/// the same text. A template that renders no JSON gets [`JsonStyle::Spaced`],","+/// the default of HF `tojson` and Python `json.dumps`.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+pub enum JsonStyle {","+    /// `,` and `:`, serde_json's default.","+    Compact,","+    /// `, ` and `: `, Python `json.dumps`'s default, which HF `tojson` uses.","+    Spaced,","+}","+","+impl JsonStyle {","+    /// Serialize `value` as JSON in this style, like [`serde_json::to_string`].","+    pub(crate) fn to_string<T: ?Sized + Serialize>(self, value: &T) -> serde_json::Result<String> {","+        let mut json = Vec::new();","+        self.to_writer(&mut json, value)?;","+        Ok(String::from_utf8(json).expect(\"serde_json writes UTF-8\"))","+    }","+","+    /// Serialize `value` as JSON in this style into `writer`, like","+    /// [`serde_json::to_writer`].","+    pub(crate) fn to_writer<W: io::Write, T: ?Sized + Serialize>(","+        self,","+        writer: W,","+        value: &T,","+    ) -> serde_json::Result<()> {","+        /// serde_json's compact formatter with a space after `,` and `:`.","+        struct SpacedFormatter;","+","+        impl Formatter for SpacedFormatter {","+            fn begin_array_value<W: ?Sized + io::Write>(","+                &mut self,","+                writer: &mut W,","+                first: bool,","+            ) -> io::Result<()> {","+                if first {","+                    Ok(())","+                } else {","+                    writer.write_all(b\", \")","+                }","+            }","+","+            fn begin_object_key<W: ?Sized + io::Write>(","+                &mut self,","+                writer: &mut W,","+                first: bool,","+            ) -> io::Result<()> {","+                if first {","+                    Ok(())","+                } else {","+                    writer.write_all(b\", \")","+                }","+            }","+","+            fn begin_object_value<W: ?Sized + io::Write>(","+                &mut self,","+                writer: &mut W,","+            ) -> io::Result<()> {","+                writer.write_all(b\": \")","+            }","+        }","+","+        match self {","+            Self::Compact => serde_json::to_writer(writer, value),","+            Self::Spaced => {","+                value.serialize(&mut Serializer::with_formatter(writer, SpacedFormatter))","+            }","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use serde_json::json;","+","+    use super::JsonStyle;","+","+    #[test]","+    fn styles_differ_only_in_separators() {","+        let value = json!({\"y\": 1.0, \"s\": \"a, b: c\", \"items\": [\"left\", {\"k\": null}]});","+","+        expect_test::expect![[r#\"{\"y\":1.0,\"s\":\"a, b: c\",\"items\":[\"left\",{\"k\":null}]}\"#]]","+            .assert_eq(&JsonStyle::Compact.to_string(&value).unwrap());","+        expect_test::expect![[r#\"{\"y\": 1.0, \"s\": \"a, b: c\", \"items\": [\"left\", {\"k\": null}]}\"#]]","+            .assert_eq(&JsonStyle::Spaced.to_string(&value).unwrap());","+    }","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"rust/src/parser/src/tool/deepseek_dsml/mod.rs","lines":["@@ -12,7 +12,7 @@ use super::utils::{","     Attributed, AttributedExt, Marker, MarkerScanState, SpecialToken,","     parse_buffered_event_attributed, safe_text_len_mul, take_until_marker,"," };","-use super::{Result, ToolCallDelta, ToolParserError, ToolParserOutput};","+use super::{JsonStyle, Result, ToolCallDelta, ToolParserError, ToolParserOutput};"," use crate::tool::Tool;"," "," mod deepseek_v32;","@@ -190,7 +190,9 @@ impl DeepSeekDsmlToolParser {","                     };","                     arguments.insert(param.name, value);","                 }","-                let arguments = serde_json::to_string(&arguments)","+                // The template renders JSON values with Python separators.","+                let arguments = JsonStyle::Spaced","+                    .to_string(&arguments)","                     .map_err(|error| parsing_failed!(\"failed to serialize arguments: {}\", error))?;"," ","                 output.push_call(ToolCallDelta {"],"additions":4,"deletions":2,"truncated":false},{"path":"rust/src/parser/src/tool/glm_xml/mod.rs","lines":["@@ -10,7 +10,7 @@ use winnow::token::{literal, rest, take_until, take_while};"," "," use super::parameters::ToolSchemas;"," use super::utils::{MarkerScanState, parse_buffered_event, safe_text_len_mul, take_until_marker};","-use super::{Result, ToolCallDelta, ToolParserError, ToolParserOutput};","+use super::{JsonStyle, Result, ToolCallDelta, ToolParserError, ToolParserOutput};"," use crate::tool::Tool;"," "," mod glm45_moe;","@@ -94,7 +94,9 @@ impl GlmXmlToolParser {","             GlmEvent::ToolCall { name, raw_params } => 