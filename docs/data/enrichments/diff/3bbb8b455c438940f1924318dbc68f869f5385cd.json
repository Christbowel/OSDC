   matches: [","+        { loaderData: undefined },","+        {","+          loaderData: { doc: { htmlKey: 'pages/hydrated.md', slug: 'a-page' } },","+        },","+      ],","+    },","+  };","+  const dehydrated = dehydratePages(router);","+  expect(dehydrated).toEqual({ pages: ['pages/hydrated.md'] });","+  await hydratePages(dehydrated, () => {","+    throw new Error('reloaded');","+  });","+  expect(pageHtml({ htmlKey: 'pages/hydrated.md' })).toBe('<p>Hydrated</p>');","+});","+","+test('a page that fails to load is tried once more before it hydrates', async () => {","+  const load = vi","+    .fn<ReturnType<typeof page>>()","+    .mockRejectedValueOnce(new Error('offline'))","+    .mockImplementation(page('<p>Retried</p>'));","+  registerPages({ 'pages/retried.md': load });","+  const reload = vi.fn<() => void>();","+  await hydratePages({ pages: ['pages/retried.md'] }, reload);","+  expect(load).toHaveBeenCalledTimes(2);","+  expect(reload).not.toHaveBeenCalled();","+  expect(pageHtml({ htmlKey: 'pages/retried.md' })).toBe('<p>Retried</p>');","+});","+","+/** Makes this page load look like one by `type`: `navigate` or `reload`. */","+function loadedBy(type: 'navigate' | 'reload') {","+  vi.spyOn(performance, 'getEntriesByType').mockReturnValue([","+    { type } as unknown as PerformanceEntry,","+  ]);","+}","+","+test('a page that keeps failing reloads once, then gives up, however slow', async () => {","+  const offline = new Error('offline');","+  registerPages({ 'pages/gone.md': () => Promise.reject(offline) });","+  const reload = vi.fn<() => void>();","+  loadedBy('navigate');","+  // Never settles: the page is reloading.","+  void hydratePages({ pages: ['pages/gone.md'] }, reload);","+  await vi.waitFor(() => {","+    expect(reload).toHaveBeenCalledTimes(1);","+  });","+  // The reloaded page fails again, however long that took.","+  loadedBy('reload');","+  vi.spyOn(Date, 'now').mockReturnValue(Date.now() + 60_000);","+  await expect(hydratePages({ pages: ['pages/gone.md'] }, reload)).rejects.toBe(","+    offline,","+  );","+  expect(reload).toHaveBeenCalledTimes(1);","+  vi.restoreAllMocks();","+});","+","+test(\"a reload's leftover mark doesn't stop a later visit's reload\", async () => {","+  registerPages({","+    'pages/later.md': () => Promise.reject(new Error('offline')),","+  });","+  // A reload for this page, whose reader left before it hydrated.","+  sessionStorage.setItem('trpc-docs:reloaded-for:pages/later.md', '');","+  // A later visit, by a link.","+  loadedBy('navigate');","+  const reload = vi.fn<() => void>();","+  void hydratePages({ pages: ['pages/later.md'] }, reload);","+  await vi.waitFor(() => {","+    expect(reload).toHaveBeenCalledTimes(1);","+  });","+  vi.restoreAllMocks();","+});","+","+test('without navigation timing, a mark stops a second reload', async () => {","+  const offline = new Error('offline');","+  registerPages({ 'pages/untimed.md': () => Promise.reject(offline) });","+  sessionStorage.setItem('trpc-docs:reloaded-for:pages/untimed.md', '');","+  vi.spyOn(performance, 'getEntriesByType').mockReturnValue([]);","+  const reload = vi.fn<() => void>();","+  await expect(","+    hydratePages({ pages: ['pages/untimed.md'] }, reload),","+  ).rejects.toBe(offline);","+  expect(reload).not.toHaveBeenCalled();","+  vi.restoreAllMocks();","+});"],"additions":119,"deletions":0,"truncated":false},{"path":"www/src/content/page-html.ts","lines":["@@ -0,0 +1,158 @@","+/**","+ * Pages' prerendered HTML, kept out of their routes' loader data.","+ *","+ * A route's loader data is sent again for hydration, in a script after the","+ * HTML it rendered, so a page's HTML was in the document twice. Loaders","+ * return a page without its HTML (with the key of its module, `htmlKey`),","+ * and the component reads the HTML from here. The server lists the pages it","+ * rendered (`dehydratePages`), and the browser loads their modules before it","+ * hydrates (`hydratePages`): each page's own content-hashed chunk, cached","+ * like the rest of the site's code.","+ */","+","+type PageModule = () => Promise<{","+  readonly default: { readonly html: string };","+}>;","+","+/** Each page's module, by its key: the path `import.meta.glob` lists it by. */","+const modules = new Map<string, PageModule>();","+/** The HTML of each page loaded so far, by its key. */","+const loaded = new Map<string, string>();","+","+/** A page as its loader returns it: without its HTML, which {@link pageHtml} reads. */","+export type WithoutHtml<T extends { readonly html: string }> = Omit<","+  T,","+  'html'","+> & {","+  /** The page's module, for {@link pageHtml}. */","+  readonly htmlKey: string;","+};","+","+/** Lists pages' modules (`import.meta.glob`), so the browser can load them to hydrate. */","+export function registerPages(pages: Readonly<Record<string, PageModule>>) {","+  for (const [key, load] of Object.entries(pages)) {","+    modules.set(key, load);","+  }","+}","+","+/** Loads a page's module, keeping its HTML here and returning the rest. */","+export async function loadPage<T extends { readonly html: string }>(","+  key: string,","+  load: () => Promise<{ readonly default: T }>,","+): Promise<WithoutHtml<T>> {","+  const page = await load();","+  const { html, ...rest } = page.default;","+  loaded.set(key, html);","+  return { ...rest, htmlKey: key };","+}","+","+/** A loaded page's HTML. Its loader, or {@link hydratePages}, loaded it. */","+export function pageHtml(page: { readonly htmlKey: string }): string {","+  const html = loaded.get(page.htmlKey);","+  if (html === undefined) {","+    throw new Error(`${page.htmlKey} renders before its module has loaded`);","+  }","+  return html;","+}","+","+function htmlKeyOf(value: unknown) {","+  return typeof value === 'object' &&","+    value !== null &&","+    'htmlKey' in value &&","+    typeof value.htmlKey === 'string'","+    ? [value.htmlKey]","+    : [];","+}","+","+export interface DehydratedPages {","+  /** The pages the server rendered, by their keys. */","+  readonly pages: ReadonlyArray<string>;","+}","+","+/** For the router's `dehydrate`: the pages its matches' loaders returned (`{ doc }`, `{ post }`). */","+export function dehydratePages(router: {","+  readonly state: {","+    readonly matches: ReadonlyArray<{ readonly loaderData?: unknown }>;","+  };","+}): DehydratedPages {","+  return {","+    pages: router.state.matches.flatMap((match) => {","+      const data: unknown = match.loaderData;","+      return typeof data === 'object' && data !== null","+        ? Object.values(data).flatMap(htmlKeyOf)","+        : [];","+    }),","+  };","+}","+","+const reloadedKey = (key: string) => `trpc-docs:reloaded-for:${key}`;","+","+/**","+ * Whether the browser loaded this page by reloading it: unknown where it","+ * doesn't say (navigation timing off).","+ */","+function isReload() {","+  const entry = performance.getEntriesByType('navigation')[0];","+  return entry && 'type' in entry ? entry.type === 'reload' : undefined;","+}","+","+/**","+ * Whether this page load is the reload for `key`, forgetting the mark","+ * either way. A reader who leaves before the reloaded page hydrates leaves","+ * the mark in the tab, and a later visit, which isn't a reload, ignores it.","+ */","+function reloadedFor(key: string) {","+  try {","+    const marked = sessionStorage.getItem(reloadedKey(key)) !== null;","+    sessionStorage.removeItem(reloadedKey(key));","+    // Not knowing, a mark means this is the reload, so it never loops.","+    return marked && (isReload() ?? true);","+  } catch {","+    // Storage is off (a private window): never reload, so never loop.","+    return true;","+  }","+}","+","+function markReloaded(key: string) {","+  try {","+    sessionStorage.setItem(reloadedKey(key), '');","+    return true;","+  } catch {","+    return false;","+  }","+}","+","+/**","+ * For the router's `hydrate`: loads the pages the server rendered before","+ * React hydrates them.","+ *","+ * Without its page, the app can't hydrate, so a failed load is tried once","+ * more, then the page reloads once: a tab opened before a deploy asks for","+ * a chunk the deploy replaced, and the reload brings the new page's. If it","+ * fails after the reload too, it rejects, and the page stays as the server","+ * rendered it.","+ */","+export async function hydratePages(","+  dehydrated: DehydratedPages,","+  reload: () => void,","+) {","+  await Promise.all(","+    dehydrated.pages.map(async (key) => {","+      const load = modules.get(key);","+      if (!load) {","+        throw new Error(`${key} isn't a registered page`);","+      }","+      try {","+        await loadPage(key, load).catch(() => loadPage(key, load));","+      } catch (error) {","+        if (reloadedFor(key) || !markReloaded(key)) {","+          throw error;","+        }","+        reload();","+        // The page is going away; hydrating it would be wasted.","+        await new Promise<never>(() => {});","+      }","+      reloadedFor(key);","+    }),","+  );","+}"],"additions":158,"deletions":0,"truncated":false},{"path":"www/src/router.tsx","lines":["@@ -7,6 +7,11 @@ import {","   hydrateCardDay,"," } from './card-day.ts';"," import { errorOptions } from './components/error-page.tsx';","+import {","+  type DehydratedPages,","+  dehydratePages,","+  hydratePages,","+} from './content/page-html.ts';"," import { NotFound } from './components/not-found.tsx';"," import { firstDocRewrite } from './first-doc.ts';"," import {","@@ -34,15 +39,20 @@ export function getRouter() {","     defaultHashScrollIntoView: { behavior: 'instant', block: 'start' },","     // Content only changes with a deploy, so a loaded page never goes stale.","     defaultStaleTime: Number.POSITIVE_INFINITY,","-    dehydrate: (): DehydratedCardDay & DehydratedRelease & RenderedPath => ({","+    dehydrate: (): DehydratedCardDay &","+      DehydratedPages &","+      DehydratedRelease &","+      RenderedPath => ({","       ...dehy