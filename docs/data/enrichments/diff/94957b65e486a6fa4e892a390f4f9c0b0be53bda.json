e.pb.h\"","+","+#include \"source/extensions/matching/input_matchers/uri_template/config.h\"","+","+#include \"test/mocks/server/server_factory_context.h\"","+#include \"test/test_common/utility.h\"","+","+#include \"gtest/gtest.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace Matching {","+namespace InputMatchers {","+namespace UriTemplate {","+","+using ::Envoy::Matcher::DataInputGetResult;","+using ::Envoy::Matcher::MatchResult;","+","+class UriTemplateInputMatcherFactoryTest : public testing::Test {","+protected:","+  Envoy::Matcher::InputMatcherFactoryCb createMatcherFactoryCb(absl::string_view path_template) {","+    envoy::extensions::matching::input_matchers::uri_template::v3::UriTemplate config;","+    config.set_path_template(path_template);","+    EXPECT_CALL(context_, messageValidationVisitor());","+    return factory_.createInputMatcherFactoryCb(config, context_);","+  }","+","+  UriTemplateInputMatcherFactory factory_;","+  testing::StrictMock<Server::Configuration::MockServerFactoryContext> context_;","+};","+","+TEST_F(UriTemplateInputMatcherFactoryTest, FactoryName) {","+  EXPECT_EQ(\"envoy.matching.matchers.uri_template\", factory_.name());","+}","+","+TEST_F(UriTemplateInputMatcherFactoryTest, RepeatedFactoryCallsCreateWorkingMatchers) {","+  const auto matcher_factory_cb = createMatcherFactoryCb(\"/api/{version}/items/{id}\");","+  const auto first_matcher = matcher_factory_cb();","+  const auto second_matcher = matcher_factory_cb();","+  EXPECT_EQ(first_matcher->match(DataInputGetResult::CreateStringView(\"/api/v1/items/123\")),","+            MatchResult::Matched);","+  EXPECT_EQ(second_matcher->match(DataInputGetResult::CreateStringView(\"/api/v1/items/123\")),","+            MatchResult::Matched);","+  EXPECT_EQ(second_matcher->match(DataInputGetResult::CreateStringView(\"/api/v1/items\")),","+            MatchResult::NoMatch);","+}","+","+TEST_F(UriTemplateInputMatcherFactoryTest, InvalidTemplateIsRejected) {","+  EXPECT_THROW_WITH_MESSAGE(createMatcherFactoryCb(\"/api/{version}/items/{id\"), EnvoyException,","+                            \"path_template /api/{version}/items/{id is invalid: Unmatched \"","+                            \"variable bracket in mixed pattern: \\\"{id\\\"\");","+}","+","+TEST_F(UriTemplateInputMatcherFactoryTest, InvalidGeneratedRegexIsRejected) {","+  EXPECT_THROW_WITH_MESSAGE(createMatcherFactoryCb(\"/a**c\"), EnvoyException,","+                            \"path_template /a**c is invalid: bad repetition operator: **\");","+}","+","+TEST_F(UriTemplateInputMatcherFactoryTest, EmptyTemplateIsRejected) {","+  EXPECT_THROW_WITH_REGEX(createMatcherFactoryCb(\"\"), EnvoyException,","+                          \"Proto constraint validation failed.*PathTemplate\");","+}","+","+} // namespace UriTemplate","+} // namespace InputMatchers","+} // namespace Matching","+} // namespace Extensions","+} // namespace Envoy"],"additions":68,"deletions":0,"truncated":false},{"path":"test/extensions/matching/input_matchers/uri_template/integration_test.cc","lines":["@@ -0,0 +1,73 @@","+#include \"test/integration/http_integration.h\"","+","+#include \"gtest/gtest.h\"","+","+namespace Envoy {","+namespace {","+","+class UriTemplateInputMatcherIntegrationTest","+    : public testing::TestWithParam<Network::Address::IpVersion>,","+      public HttpIntegrationTest {","+public:","+  UriTemplateInputMatcherIntegrationTest()","+      : HttpIntegrationTest(Http::CodecType::HTTP1, GetParam()) {}","+","+  void initialize() override {","+    // The wrapped filter replies with a 403 unless the path matches the template.","+    config_helper_.prependFilter(R\"EOF(","+name: match_delegate_filter","+typed_config:","+  \"@type\": type.googleapis.com/envoy.extensions.common.matching.v3.ExtensionWithMatcher","+  extension_config:","+    name: set-response-code","+    typed_config:","+      \"@type\": type.googleapis.com/test.integration.filters.SetResponseCodeFilterConfig","+      code: 403","+  xds_matcher:","+    matcher_list:","+      matchers:","+      - predicate:","+          single_predicate:","+            input:","+              name: envoy.matching.inputs.request_headers","+              typed_config:","+                \"@type\": type.googleapis.com/envoy.type.matcher.v3.HttpRequestHeaderMatchInput","+                header_name: \":path\"","+            custom_match:","+              name: envoy.matching.matchers.uri_template","+              typed_config:","+                \"@type\": type.googleapis.com/envoy.extensions.matching.input_matchers.uri_template.v3.UriTemplate","+                path_template: \"/api/{version}/items/{id}\"","+        on_match:","+          action:","+            name: skip","+            typed_config:","+              \"@type\": type.googleapis.com/envoy.extensions.filters.common.matcher.action.v3.SkipFilter","+)EOF\");","+    HttpIntegrationTest::initialize();","+    codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+  }","+};","+","+INSTANTIATE_TEST_SUITE_P(IpVersions, UriTemplateInputMatcherIntegrationTest,","+                         testing::ValuesIn(TestEnvironment::getIpVersionsForTest()),","+                         TestUtility::ipTestParamsToString);","+","+TEST_P(UriTemplateInputMatcherIntegrationTest, TemplateMatchSkipsFilter) {","+  initialize();","+  default_request_headers_.setPath(\"/api/v1/items/123?limit=1\");","+  auto response =","+      sendRequestAndWaitForResponse(default_request_headers_, 0, default_response_headers_, 0);","+  EXPECT_EQ(\"200\", response->headers().getStatusValue());","+}","+","+TEST_P(UriTemplateInputMatcherIntegrationTest, TemplateMissAppliesFilter) {","+  initialize();","+  default_request_headers_.setPath(\"/api/v1/items/123/extra\");","+  auto response = codec_client_->makeHeaderOnlyRequest(default_request_headers_);","+  ASSERT_TRUE(response->waitForEndStream());","+  EXPECT_EQ(\"403\", response->headers().getStatusValue());","+}","+","+} // namespace","+} // namespace Envoy"],"additions":73,"deletions":0,"truncated":false},{"path":"test/extensions/matching/input_matchers/uri_template/matcher_test.cc","lines":["@@ -0,0 +1,45 @@","+#include <memory>","+","+#include \"source/extensions/matching/input_matchers/uri_template/matcher.h\"","+","+#include \"gtest/gtest.h\"","+#include \"re2/re2.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace Matching {","+namespace InputMatchers {","+namespace UriTemplate {","+","+using ::Envoy::Matcher::DataInputGetResult;","+using ::Envoy::Matcher::MatchResult;","+","+class UriTemplateInputMatcherTest : public testing::Test {","+protected:","+  MatchResult matchPath(absl::string_view path) {","+    return matcher_.match(DataInputGetResult::CreateStringView(path));","+  }","+","+  // The character classes exclude ? and # so the match depends on removing the query and fragment.","+  UriTemplateInputMatcher matcher_{std::make_shared<const RE2>(\"/api/[a-z0-9]+/items/[0-9]+\")};","+};","+","+TEST_F(UriTemplateInputMatcherTest, IgnoresQueryAndFragment) {","+  EXPECT_EQ(matchPath(\"/api/v1/items/123?limit=1\"), MatchResult::Matched);","+  EXPECT_EQ(matchPath(\"/api/v1/items/123#top\"), MatchResult::Matched);","+}","+","+TEST_F(UriTemplateInputMatcherTest, DoesNotMatchOtherPaths) {","+  EXPECT_EQ(matchPath(\"/api/v1/items\"), MatchResult::NoMatch);","+  EXPECT_EQ(matchPath(\"/api/v1/items/123/extra\"), MatchResult::NoMatch);","+}","+","+TEST_F(UriTemplateInputMatcherTest, DoesNotMatchMissingInput) {","+  EXPECT_EQ(matcher_.match(DataInputGetResult::NoData()), MatchResult::NoMatch);","+}","+","+} // namespace UriTemplate","+} // namespace InputMatchers","+} // namespace Matching","+} // namespace Extensions","+} // namespace Envoy",""],"additions":45,"deletions":0,"truncated":false}],"additions":459,"deletions":0,"truncated":false,"file_count":19},"error":null,"fetched_at":"2026-10-14T13:05:37.959656+00:00"}