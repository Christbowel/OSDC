ig, factory_context.messageValidationVisitor());","+  const std::string& path_template = uri_template_config.path_template();","+  const absl::StatusOr<std::string> regex_pattern =","+      Extensions::UriTemplate::convertPathPatternSyntaxToRegex(path_template);","+  if (!regex_pattern.ok()) {","+    throw EnvoyException(fmt::format(\"path_template {} is invalid: {}\", path_template,","+                                     regex_pattern.status().message()));","+  }","+  const auto regex = std::make_shared<const RE2>(*regex_pattern, RE2::Quiet);","+  if (!regex->ok()) {","+    throw EnvoyException(","+        fmt::format(\"path_template {} is invalid: {}\", path_template, regex->error()));","+  }","+  return [regex]() { return std::make_unique<UriTemplateInputMatcher>(regex); };","+}","+","+REGISTER_FACTORY(UriTemplateInputMatcherFactory, Envoy::Matcher::InputMatcherFactory);","+","+} // namespace UriTemplate","+} // namespace InputMatchers","+} // namespace Matching","+} // namespace Extensions","+} // namespace Envoy"],"additions":48,"deletions":0,"truncated":false},{"path":"source/extensions/matching/input_matchers/uri_template/config.h","lines":["@@ -0,0 +1,31 @@","+#pragma once","+","+#include \"envoy/extensions/matching/input_matchers/uri_template/v3/uri_template.pb.h\"","+#include \"envoy/matcher/matcher.h\"","+#include \"envoy/server/factory_context.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace Matching {","+namespace InputMatchers {","+namespace UriTemplate {","+","+class UriTemplateInputMatcherFactory : public Envoy::Matcher::InputMatcherFactory {","+public:","+  Envoy::Matcher::InputMatcherFactoryCb createInputMatcherFactoryCb(","+      const Protobuf::Message& config,","+      Server::Configuration::ServerFactoryContext& factory_context) override;","+","+  std::string name() const override { return \"envoy.matching.matchers.uri_template\"; }","+","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::mak