et/Extensions/MSBuildOptionExtensions.cs","lines":["@@ -0,0 +1,27 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.CommandLine;","+using Microsoft.DotNet.Cli.Commands.Restore;","+using Microsoft.DotNet.ProjectTools;","+","+namespace Microsoft.DotNet.Cli;","+","+/// <summary>","+/// Replaces the definitions' default path forwarding with forwarding that escapes CLI-owned literal paths","+/// using MSBuild's API, so characters such as <c>;</c>, <c>%</c>, and <c>$</c> are not reinterpreted by MSBuild.","+/// </summary>","+internal static class MSBuildOptionExtensions","+{","+    public static Option<string> ForwardAsLiteralOutputPath(this Option<string> option, string outputPropertyName, bool surroundWithDoubleQuotes = false)","+        => option.ForwardAsOutputPath(outputPropertyName, surroundWithDoubleQuotes, MSBuildPropertyEscaping.Escape);","+","+    public static Option<string> ForwardAsLiteralPathProperty(this Option<string> option, string propertyName, bool surroundWithDoubleQuotes = false)","+        => option.ForwardAsPathProperty(propertyName, surroundWithDoubleQuotes, MSBuildPropertyEscaping.Escape);","+","+    public static void ForwardPathsAsLiterals(this ImplicitRestoreOptions options)","+    {","+        options.PackagesOption.ForwardAsLiteralPathProperty(\"RestorePackagesPath\");","+        options.ConfigFileOption.ForwardAsLiteralPathProperty(\"RestoreConfigFile\");","+    }","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"test/dotnet-watch.Tests/CommandLine/CommandLineOptionsTests.cs","lines":["@@ -685,4 +685,16 @@ public void ForwardedBuildOptions_ArtifactsPath()","         var options = VerifyOptions([\"run\", .. args]);","         AssertEx.SequenceEqual(buildArgs, options.BuildArguments);","     }","+","+    [TestMethod]","+    public void ForwardedBuildOptions_OutputPath()","+    {","+        var path = Path.Combine(SdkTestContext.Current.TestAssetsDirectory, \"out;put\") + Path.DirectorySeparatorChar;","+","+        var args = new[] { \"--output\", path };","+        var buildArgs = new[] { NugetInteractiveProperty, \"--property:OutputPath=\" + path, \"--property:_CommandLineDefinedOutputPath=true\", \"--nologo\" };","+","+        var options = VerifyOptions([\"build\", .. args]);","+        AssertEx.SequenceEqual(buildArgs, options.BuildArguments);","+    }"," }"],"additions":12,"deletions":0,"truncated":false},{"path":"test/dotnet.Tests/CommandTests/MSBuild/GivenDotnetPackInvocation.cs","lines":["@@ -22,7 +22,9 @@ public class GivenDotnetPackInvocation : SdkTest","         [DataRow(new string[] { }, new string[] { })]","         [DataRow(new string[] { \"-o\", \"<packageoutputpath>\" }, new string[] { \"--property:PackageOutputPath=<cwd><packageoutputpath>\" })]","         [DataRow(new string[] { \"--output\", \"<packageoutputpath>\" }, new string[] { \"--property:PackageOutputPath=<cwd><packageoutputpath>\" })]","+        [DataRow(new string[] { \"--output\", \"out;put\" }, new string[] { \"--property:PackageOutputPath=<cwd>out%3bput\" })]","         [DataRow(new string[] { \"--artifacts-path\", \"foo\" }, new string[] { \"--property:ArtifactsPath=<cwd>foo\" })]","+        [DataRow(new string[] { \"--artifacts-path\", \"fo%3Bo\" }, new string[] { \"--property:ArtifactsPath=<cwd>fo%253Bo\" })]","         [DataRow(new string[] { \"--no-build\" }, new string[] { \"--property:NoBuild=true\" })]","         [DataRow(new string[] { \"--include-symbols\" }, new string[] { \"--property:IncludeSymbols=true\" })]","         [DataRow(new string[] { \"--include-source\" }, new string[] { \"--property:IncludeSource=true\" })]"],"additions":2,"deletions":0,"truncated":false},{"path":"test/dotnet.Tests/CommandTests/MSBuild/GivenDotnetRestoreInvocation.cs","lines":["@@ -28,8 +28,10 @@ public class GivenDotnetRestoreInvocation : SdkTest","         [DataRow(new string[] { \"--runtime\", \"<runtime>\" }, new string[] { \"--property:RuntimeIdentifiers=<runtime>\" })]","         [DataRow(new string[] { \"-r\", \"<runtime0>\", \"-r\", \"<runtime1>\" }, new string[] { \"--property:RuntimeIdentifiers=<runtime0>%3B<runtime1>\" })]","         [DataRow(new string[] { \"--packages\", \"<packages>\" }, new string[] { \"--property:RestorePackagesPath=<cwd><packages>\" })]","+        [DataRow(new string[] { \"--packages\", \"pack;ages\" }, new string[] { \"--property:RestorePackagesPath=<cwd>pack%3bages\" })]","         [DataRow(new string[] { \"--disable-parallel\" }, new string[] { \"--property:RestoreDisableParallel=true\" })]","         [DataRow(new string[] { \"--configfile\", \"<config>\" }, new string[] { \"--property:RestoreConfigFile=<cwd><config>\" })]","+        [DataRow(new string[] { \"--configfile\", \"nuget$(x).config\" }, new string[] { \"--property:RestoreConfigFile=<cwd>nuget%24%28x%29.config\" })]","         [DataRow(new string[] { \"--no-cache\" }, new string[] { \"--property:RestoreNoCache=true\" })]","         [DataRow(new string[] { \"--no-http-cache\" }, new string[] { \"--property:RestoreNoHttpCache=true\" })]","         [DataRow(new string[] { \"--ignore-failed-sources\" }, new string[] { \"--property:RestoreIgnoreFailedSources=true\" })]"],"additions":2,"deletions":0,"truncated":false},{"path":"test/dotnet.Tests/CommandTests/MSBuild/MSBuildOptionExtensionsTests.cs","lines":["@@ -0,0 +1,104 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.CommandLine;","+using Microsoft.DotNet.Cli.CommandLine;","+","+namespace Microsoft.DotNet.Cli.MSBuild.Tests;","+","+[TestClass]","+public class MSBuildOptionExtensionsTests : SdkTest","+{","+    [TestMethod]","+    [DataRow(\"out;put\", \"out%3bput\")]","+    [DataRow(\"out%3Bput\", \"out%253Bput\")]","+    [DataRow(\"out$(Configuration)\", \"out%24%28Configuration%29\")]","+    [DataRow(\"out@(Items)\", \"out%40%28Items%29\")]","+    [DataRow(\"out'put\", \"out%27put\")]","+    [DataRow(\"out,put\", \"out%2Cput\")]","+    public void OutputPathEscapesLiteralValue(string directoryName, string escapedDirectoryName)","+        => VerifyOutputPathEscaping(directoryName, escapedDirectoryName);","+","+    [TestMethod]","+    [OSCondition(ConditionMode.Exclude, OperatingSystems.Windows)]","+    [DataRow(\"out\\\"put\", \"out%22put\")]","+    [DataRow(\"out*put\", \"out%2aput\")]","+    [DataRow(\"out?put\", \"out%3fput\")]","+    public void OutputPathEscapesUnixLiteralValue(string directoryName, string escapedDirectoryName)","+        => VerifyOutputPathEscaping(directoryName, escapedDirectoryName);","+","+    private static void VerifyOutputPathEscaping(string directoryName, string escapedDirectoryName)","+    {","+        string basePath = TestPathUtilities.FormatAbsolutePath(\"base\");","+        CommandDirectoryContext.PerformActionWithBasePath(basePath, () =>","+        {","+            var outputOption = new Option<string>(\"--output\").ForwardAsLiteralOutputPath(\"OutputPath\");","+            var command = new Command(\"build\") { outputOption };","+            command.Parse([\"--output\", directoryName]).OptionValuesToBeForwarded()","+                .Should().BeEquivalentTo([","+                    $\"--property:OutputPath={Path.Combine(basePath, escapedDirectoryName)}{Path.DirectorySeparatorChar}\",","+                    \"--property:_CommandLineDefinedOutputPath=true\"","+                ]);","+        });","+    }","+","+    [TestMethod]","+    public void AbsentOutputPathDoesNotForwardProperties()","+    {","+        var outputOption = new Option<string>(\"--output\").ForwardAsLiteralOutputPath(\"OutputPath\");","+        var command = new Command(\"build\") { outputOption };","+        command.Parse([]).OptionValuesToBeForwarded().Should().BeEmpty();","+    }","+","+    [TestMethod]","+    [DataRow(false)]","+    [DataRow(true)]","+    public 