{"id":"ce8bd32e55f1490b6a82b100ceabf4b8d8c1c167","axis":"silent","repo":"dotnet/sdk","sha":"ce8bd32e55f1490b6a82b100ceabf4b8d8c1c167","parsed":{"files":[{"path":"src/Cli/AGENTS.md","lines":["@@ -42,6 +42,16 @@ to `dotnet` and `Microsoft.DotNet.Cli.Utils`. Internal parser APIs are accessibl"," signed `dotnet` assembly through MSBuild's `InternalsVisibleTo`; keep those calls"," managed-only rather than introducing MSBuild dependencies into `Definitions`."," ","+CLI-owned path options (such as `--output`, `--artifacts-path`, `--packages`, and VSTest","+`--settings`) keep their default, unescaped forwarding in the definitions for consumers such as","+`dotnet-watch`. The managed command parsers replace it through","+[`MSBuildOptionExtensions`](dotnet/Extensions/MSBuildOptionExtensions.cs), which uses","+[`MSBuildPropertyEscaping`](../Microsoft.DotNet.ProjectTools/MSBuildPropertyEscaping.cs)","+to escape literal paths with MSBuild's API before adding command-line quotes. When adding a path","+option, forward it with `ForwardAsPathProperty`/`ForwardAsOutputPath` in the definition and wire","+the `ForwardAsLiteral*` override in the managed parser. Keep explicit `-p:` values on their","+existing MSBuild-syntax path; they are not literals.","+"," When changing AOT-linked commands, resources, dependencies, or first-run behavior,"," follow the [size and trimming contracts](dotnet-aot/DESIGN.md#size-and-trimming-contracts)."," "],"additions":10,"deletions":0,"truncated":false},{"path":"src/Cli/Microsoft.DotNet.Cli.Definitions/Commands/Pack/PackCommandDefinition.cs","lines":["@@ -25,7 +25,7 @@ internal sealed class PackCommandDefinition : Command","     {","         Description = CommandDefinitionStrings.PackCmdOutputDirDescription,","         HelpName = CommandDefinitionStrings.PackCmdOutputDir","-    }.ForwardAsSingle(o => $\"-property:PackageOutputPath={CommandDirectoryContext.GetFullPath(o)}\");","+    }.ForwardAsPathProperty(\"PackageOutputPath\");"," ","     public readonly