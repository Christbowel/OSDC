, policy);","     }","@@ -169,7 +173,6 @@ pub(super) fn check_freshness(","     }","     let unverified = state_unverified_by_changed_lockfile(check, state, &drift, policy)?;","     let state = unverified.as_ref().unwrap_or(state);","-    let held = drift.held(check, scope);","     if held.is_empty() && !drift.patches_modified {","         return settle_proven_tree(check, state, &drift, policy, scope);","     }"],"additions":4,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/freshness/drift.rs","lines":["@@ -195,9 +195,13 @@ fn project_stats<'a>(","     recorded: Option<&Validation>,","     lockfile_digest: Option<&str>,"," ) -> Vec<ManifestStat<'a>> {","+    let bins = super::super::validation::workspace_bins_digest(","+        check.workspace_root,","+        check.project_manifests,","+    );","     let mut stats = super::super::manifest_agreement::manifest_stats(","         check.project_manifests,","-        |root_dir, digest| {","+        |root_dir, manifest, digest| {","             let importer_id = importer_id_from_root_dir(check.workspace_root, root_dir);","             let Some(record) = recorded.and_then(|validation| validation.project(&importer_id))","             else {","@@ -207,7 +211,17 @@ fn project_stats<'a>(","             // and more.","             if record.lockfile != lockfile_digest {","                 ProjectStatus::LockfileChanged","-            } else if record.manifest != digest {","+            } else if record.manifest != digest","+                || !super::super::validation::project_bins_match(","+                    recorded,","+                    &importer_id,","+                    super::super::validation::project_bins_digest(","+                        &importer_id,","+                        manifest,","+                        bins.as_deref(),","+                    ),","+                )","+            {","                 ProjectStatus::ManifestChanged","             } else {","                 ProjectStatus::Proven"],"additions":16,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/manifest_agreement.rs","lines":["@@ -27,14 +27,14 @@ pub(crate) struct ManifestStat<'a> {"," /// its root directory and its manifest's digest."," pub(crate) fn manifest_stats<'a>(","     project_manifests: &'a [(PathBuf, &'a PackageManifest)],","-    status: impl Fn(&Path, String) -> ProjectStatus,","+    status: impl Fn(&Path, &PackageManifest, String) -> ProjectStatus,"," ) -> Vec<ManifestStat<'a>> {","     project_manifests","         .iter()","         .map(|(root_dir, manifest)| ManifestStat {","             root_dir,","             manifest,","-            status: status(root_dir, manifest_digest(manifest)),","+            status: status(root_dir, manifest, manifest_digest(manifest)),","         })","         .collect()"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/validation.rs","lines":["@@ -3,7 +3,8 @@"," use super::super::{","     pnpmfiles_drift,","     validation::{","-        FileDigest, FileDigests, RecordValidation, Vouched, manifest_digest, record_validation,","+        FileDigest, FileDigests, RecordValidation, Vouched, manifest_digest, project_bins_match,","+        record_validation,","     },"," };"," use pnpm_config::Config;","@@ -203,3 +204,45 @@ fn source_date_epoch_records_deterministic_pnpmfile_digests_without_trusting_mti","         \"an edited pnpmfile with mtime restored before SOURCE_DATE_EPOCH must be detected\",","     );"," }","+","+#[test]","+fn workspace_bin_digests_match_between_implementations_and_ignore_layout() {","+    use super::super::validation::workspace_bins_digest;","+    use std::path::PathBuf;","+","+    let root = Path::new(\"/project\");","+    let package = manifest(r#\"{\"name\":\"a\",\"bin\":{\"a-one\":\"one.js\",\"a-two\":\"two.js\"}}\"#);","+    let projects = [(root.join(\"packages/a\"), &package)];","+    let digest = workspace_bins_digest(root, &projects);","+    assert_eq!(digest.as_deref(), Some(\"341026c69559cca8573860896362ff03\"));","+    let reordered = manifest(","+        r#\"{\"bin\":{\"a-two\":\"two.js\",\"a-one\":\"one.js\"},\"name\":\"a\",\"description\":\"changed\"}\"#,","+    );","+    assert_eq!(workspace_bins_digest(root, &[(root.join(\"packages/a\"), &reordered)]), digest);","+    let moved = PathBuf::from(\"/moved\");","+    assert_eq!(workspace_bins_digest(&moved, &[(moved.join(\"packages/a\"), &package)]), digest);","+    for changed in [","+        r#\"{\"name\":\"a\",\"bin\":{\"a-one\":\"two.js\",\"a-two\":\"two.js\"}}\"#,","+        r#\"{\"name\":\"a\",\"bin\":{\"a-renamed\":\"one.js\",\"a-two\":\"two.js\"}}\"#,","+        r#\"{\"name\":\"a\",\"bin\":{\"a-one\":\"one.js\"}}\"#,","+        r#\"{\"name\":\"a\",\"bin\":\"one.js\"}\"#,","+        r#\"{\"name\":\"renamed\",\"bin\":{\"a-one\":\"one.js\",\"a-two\":\"two.js\"}}\"#,","+        r#\"{\"name\":\"a\",\"directories\":{\"bin\":\"bin\"}}\"#,","+        r#\"{\"name\":\"a\"}\"#,","+    ] {","+        let changed = manifest(changed);","+        assert_ne!(workspace_bins_digest(root, &[(root.join(\"packages/a\"), &changed)]), digest);","+    }","+    for value in [r#\"{\"name\":\"a\"}\"#, r#\"{\"bin\":null,\"directories\":{\"bin\":null}}\"#] {","+        let package = manifest(value);","+        assert_eq!(workspace_bins_digest(root, &[(root.join(\"packages/a\"), &package)]), None);","+    }","+}","+","+#[test]","+fn a_state_without_a_validation_record_matches_any_project_bins() {","+    assert!(project_bins_match(None, \".\", Some(\"341026c69559cca8573860896362ff03\")));","+    let recorded = Validation::default();","+    assert!(!project_bins_match(Some(&recorded), \".\", Some(\"341026c69559cca8573860896362ff03\")));","+    assert!(project_bins_match(Some(&recorded), \"packages/a\", None));","+}"],"additions":44,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/validation.rs","lines":["@@ -8,6 +8,10 @@"," //! install vouches only for the projects it installed, so the records of the"," //! others survive it unchanged."," ","+pub(crate) use bins::{","+    held_workspace_bins_match, project_bins_digest, project_bins_match, workspace_bins_digest,","+};","+"," use super::{Config, Lockfile, PackageManifest, Path, PathBuf};"," use pnpm_workspace::importer_id_from_root_dir;"," use pnpm_workspace_state::{FileSignature, Validation, WorkspaceState};","@@ -17,6 +21,8 @@ use std::{","     fs, io,"," };"," ","+mod bins;","+"," /// How many hex digits of a SHA-256 digest a record keeps."," const DIGEST_LEN: usize = 32;"," ","@@ -29,8 +35,12 @@ const WHOLE_SECOND_GRANULARITY_NS: i64 = 2_000_000_000;"," /// directly, so a manifest that only reorders its keys or its whitespace keeps"," /// its digest."," pub(crate) fn manifest_digest(manifest: &PackageManifest) -> String {","+    value_digest(manifest.value())","+}","+","+fn value_digest(value: &serde_json::Value) -> String {","     let mut hasher = Sha256::new();","-    hash_value(&mut hasher, manifest.value());","+    hash_value(&mut hasher, value);","     let mut digest = format!(\"{:x}\", hasher.finalize());","     digest.truncate(DIGEST_LEN);","     digest","@@ -387,6 +397,7 @@ fn record_projects(","     carried: Option<&Validation>,","     lockfile: Option<&str>,"," ) -> usize {","+    let bins = workspace_bins_digest(inputs.workspace_root, inputs.project_manifests);","     let records = inputs.project_manifests","         .iter()","         .filter_map(|(root_dir, manifest)| {","@@ -396,14 +407,23 @@ fn record_projects(","                 Vouched::Projects { dirs, .. } => dirs.contains(root_dir),","             };","             if vouched {","-                return Some((importer_id, manifest_digest(manifest), lockfile));","+                let project_bins = project_bins_digest(&importer_id, manifest, bins.as_deref());","+                return Some((importer_id, manifest_digest(manifest), lockfile, project_bins));","             }","             let record = carried?.project(&importer_id)?;","-            Some((importer_id.clone(), record.manifest.to_string(), record.lockfile))","+            Some((","+                importer_id.clone(),","+                record.manifest.to_string(),","+                record.lockfile,","+                carried?.workspace_bins.get(&importer_id).map(String::as_str),","+            ))","         })","         .collect::<Vec<_>>();","     let recorded = records.len();","-    for (importer_id, manifest, lockfile) in records {","+    for (importer_id, manifest, lockfile, bins) in records {","+        if let Some(bins) = bins {","+            validation.workspace_bins.insert(importer_id.clone(), bins.to_string());","+        }","         validation.insert_project(importer_id, manifest, lockfile);","     }","     recorded"],"additions":24,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/validation/bins.rs","lines":["@@ -0,0 +1,91 @@","+use super::{","+    PackageManifest, Path, PathBuf, Validation, WorkspaceState, importer_id_from_root_dir,","+    value_digest,","+};","+use crate::optimistic_repeat_install::{ManifestStat, OptimisticRepeatInstallCheck};","+","+pub(crate) fn workspace_bins_digest(","+    workspace_root: &Path,","+    projects: &[(PathBuf, &PackageManifest)],","+) -> Option<String> {","+    let bins: serde_json::Map<String, serde_json::Value> = projects","+        .iter()","+        .filter_map(|(dir, manifest)| {","+            let manifest = manifest.value();","+            let bin = manifest","+                .get(\"bin\")","+                .filter(|value| !value.is_null());","+            let directory = manifest","+                .get(\"directories\")","+                .and_then(|dirs| dirs.get(\"bin\"))","+                .filter(|value| !value.is_null());","+            if bin.is_none() && directory.is_none() {","+                return None;","+            }","+            Some((","+                importer_id_from_root_dir(workspace_root, dir),","+                serde_json::json!({","+                    \"name\": manifest.get(\"name\"),","+                    \"bin\": bin,","+                    \"directory\": directory,","+                }),","+            ))","+        })","+        .collect();","+    (!bins.is_empty()).then(|| value_digest(&serde_json::Value::Object(bins)))","+}","+","+/// The bins digest `importer_id` records: `bins` when the project links","+/// workspace bins, which the root and any project with dependencies do, and","+/// `None` otherwise.","+pub(crate) fn project_bins_digest<'a>(","+    importer_id: &str,","+    manifest: &PackageManifest,","+    bins: Option<&'a str>,","+) -> Option<&'a str> {","+    if importer_id == \".\"","+        || crate::optimistic_repeat_install::manifest_has_runtime_deps(manifest)","+        || manifest","+            .value()","+            .get(\"peerDependencies\")","+            .and_then(serde_json::Value::as_object)","+            .is_some_and(|peers| !peers.is_empty())","+    {","+        bins","+    } else {","+        None","+    }","+}","+","+/// Whether `recorded` proves `importer_id` installed with the bins digest","+/// `bins`. A state without a validation record proves nothing about any","+/// project, so it matches and leaves the verdict to the checks that handle","+/// such a state.","+pub(crate) fn project_bins_match(","+    recorded: Option<&Validation>,","+    importer_id: &str,","+    bins: Option<&str>,","+) -> bool {","+    let Some(validation) = recorded else { return true };","+    validation.workspace_bins.get(importer_id).map(String::as_str) == bins","+}","+","+pub(crate) fn held_workspace_bins_match(","+    check: &OptimisticRepeatInstallCheck<'_>,","+    state: &WorkspaceState,","+    held: &[&ManifestStat<'_>],","+) -> bool {","+    if held.is_empty() || state.v