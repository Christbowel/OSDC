{"id":"b2754b8cb235fc564e5b815e421ce06aa261aebc","axis":"silent","repo":"guzzle/psr7","sha":"b2754b8cb235fc564e5b815e421ce06aa261aebc","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -7,6 +7,10 @@ and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0"," "," ## 3.3.0 - Upcoming"," ","+### Added","+","+- Add `ErrorScope` to capture the PHP errors raised beneath a call","+"," ### Changed"," "," - Stop stream helpers failing on deprecations and silenced errors"],"additions":4,"deletions":0,"truncated":false},{"path":"README.md","lines":["@@ -56,6 +56,7 @@ $request = $request->withHeader('Accept', 'application/json');"," - [PSR-17 Factories](docs/psr-17-factories.md)"," - [Message Helpers](docs/message-helpers.md)"," - [Diagnostic Values](docs/diagnostic-values.md)","+- [Error Scopes](docs/error-scopes.md)"," - [Header and Query Helpers](docs/header-and-query-helpers.md)"," - [Stream Helpers](docs/stream-helpers.md)"," - [URI and MIME Helpers](docs/uri-and-mime-helpers.md)"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/error-scopes.md","lines":["@@ -0,0 +1,64 @@","+# Error Scopes","+","+## `GuzzleHttp\\Psr7\\ErrorScope`","+","+Captures the PHP errors raised beneath a call.","+","+PHP keeps one error handler stack per process, shared by every coroutine and","+fiber, so an error raised on another call stack is passed on to the previously","+installed handler instead of being captured. That handler is called directly, so","+it also receives error levels it was not registered for.","+","+```php","+use GuzzleHttp\\Psr7\\DiagnosticValue;","+use GuzzleHttp\\Psr7\\ErrorScope;","+","+$scope = new ErrorScope();","+$handle = $scope->run(static fn () => fopen('/path/to/file', 'r'));","+","+if ($handle === false) {","+    throw new RuntimeException(","+        DiagnosticValue::escape((string) $scope->getError())","+    );","+}","+```","+","+## `GuzzleHttp\\Psr7\\ErrorScope::__construct`","+","+`public function __construct(int $levels = E_ALL, bool $silenced = true)`","+","+Creates a scope that captures errors of the given levels.","+","+Errors of other levels are passed on to the previously installed handler, which","+may be an enclosing scope. When `$silenced` is false, so are errors silenced","+inside the call with the `@` operator, which are those whose level was reported","+as the call started and is not reported when they are raised.","+","+## `GuzzleHttp\\Psr7\\ErrorScope::run`","+","+`public function run(callable $operation): mixed`","+","+Runs the operation and returns its result, capturing the errors raised beneath","+it.","+","+A scope runs one operation at a time, so calling this again before it returns","+throws a `LogicException`.","+","+## `GuzzleHttp\\Psr7\\ErrorScope::getError`","+","+`public function getError(): ?string`","+","+Returns the message of the last error captured, if any.","+","+## `GuzzleHttp\\Psr7\\ErrorScope::getErrors`","+","+`public function getErrors(): array`","+","+Returns the errors captured, in the order they were raised.","+","+Each error is an array with `message`, `file`, and `line` keys.","+","+## Related","+","+- [Diagnostic Values](diagnostic-values.md)","+- [Stream Helpers](stream-helpers.md)"],"additions":64,"deletions":0,"truncated":false},{"path":"src/ErrorScope.php","lines":["@@ -11,8 +11,6 @@","  * fiber, so an error raised on another call stack is passed on to the","  * previously installed handler instead of being captured. That handler is","  * called directly, so it also receives error levels it was not registered for.","- *","- * @internal","  */"," final class ErrorScope"," {","@@ -22,9 +20,22 @@ final class ErrorScope"," ","     private int $reporting = 0;"," ","-    private ?string $error = null;","+    private bool $running = false;"," ","     /**","+     * @var list<array{message: string, file: string, line: int}>","+     */","+    private array $errors = [];","+","+    /**","+     * Creates a scope that captures errors of the given levels.","+     *","+     * Errors of other levels are passed on to the previously installed handler,","+     * which may be an enclosing scope. When `$silenced` is false, so are errors","+     * silenced inside the call with the `@` operator, which are those whose","+     * level was reported as the call started and is not reported when they are","+     * raised.","+     *","      * @param int  $levels   Error levels to capture","      * @param bool $silenced Whether to capture errors silenced inside the call","      */","@@ -35,17 +46,29 @@ public function __construct(int $levels = \\E_ALL, bool $silenced = true)","     }"," ","     /**","+     * Runs the operation and returns its result, capturing the errors raised","+     * beneath it.","+     *","+     * A scope runs one operation at a time, so calling this again before it","+     * returns throws a `LogicException`.","+     *","      * @template T","      *","      * @param callable(): T $operation","      *","      * @return T","+     *","+     * @throws \\LogicException if the scope is already running an operation","      */","     public function run(callable $operation)","     {","+        if ($this->running) {","+            throw new \\LogicException(static::class.' is already running an operation');","+        }","+","         $owner = $this;","         $previous = null;","-        $previous = set_error_handler(static function (int $errno, string $errstr, ...$rest) use ($owner, &$previous): bool {","+        $previous = set_error_handler(static function (int $errno, string $errstr, string $errfile = '', int $errline = 0, ...$rest) use ($owner, &$previous): bool {","             foreach (debug_backtrace(\\DEBUG_BACKTRACE_PROVIDE_OBJECT | \\DEBUG_BACKTRACE_IGNORE_ARGS) as $frame) {","                 $scope = $frame['object'] ?? null;","                 if (!$scope instanceof self) {","@@ -53,7 +76,11 @@ public function run(callable $operation)","                 }"," ","                 if ($scope->captures($errno)) {","-                    $scope->error = $errstr;","+                    $scope->errors[] = [","+                        'message' => $errstr,","+                        'file' => $errfile,","+                        'line' => $errline,","+                    ];"," ","                     return true;","                 }","@@ -64,14 +91,16 @@ public function run(callable $operation)","                 }","             }"," ","-            return $previous !== null && $previous($errno, $errstr, ...$rest) !== false;","+            return $previous !== null && $previous($errno, $errstr, $errfile, $errline, ...$rest) !== false;","         });"," ","         $this->reporting = error_reporting();","+        $this->running = true;"," ","         try {","             return $operation();","         } finally {","+            $this->running = false;","             restore_error_handler();","         }","     }","@@ -81,7 +110,19 @@ public function run(callable $operation)","      */","     public function getError(): ?string","     {","-        return $this->error;","+        $error = end($this->errors);","+","+        return $error === false ? null : $error['message'];","+    }","+","+    /**","+     * Returns the errors captured, in the order they were raised.","+     *","+     * @return list<array{message: string, file: string, line: int}>","+     */","+    public function getErrors(): array","+    {","+        return $this->errors;","     }"," ","     private function captures(int $errno): bool"],"additions":48,"deletions":7,"truncated":false},{"path":"tests/ErrorScopeTest.php","lines":["@@ -43,6 +43,19 @@ public function testCapturesErrorsRaisedBeneathTheCall(): void","         self::assertSame([], $passedOn);","     }"," ","+    public function testReturnsTheCapturedErrorsInOrder(): void","+    {","+        $scope = new ErrorScope();","+        $scope->run(static function (): void {","+            trigger_error('first', E_USER_WARNING);","+            trigger_error('second', E_USER_NOTICE);","+        });","+","+        self::assertSame(['first', 'second'], array_column($scope->getErrors(), 'message'));","+        self::assertSame([__FILE__, __FILE__], array_column($scope->getErrors(), 'file'));","+        self::assertSame([__LINE__ - 6, __LINE__ - 5], array_column($scope->getErrors(), 'line'));","+    }","+","     public function testPassesOnErrorsOutsideItsLevels(): void","     {","         $passedOn = [];","@@ -147,21 +160,53 @@ public function testCapturesErrorsSilencedBeforeTheCall(): void","         self::assertSame('silenced', $scope->getError());","     }"," ","-    public function testRestoresTheErrorHandlerWhenTheOperationThrows(): void","+    public function testCleansUpWhenTheOperationThrows(): void","     {","+        $scope = new ErrorScope();","         $handler = static fn (): bool => true;","         set_error_handler($handler);"," ","         try {","-            (new ErrorScope())->run(static function (): void {","-                throw new \\LogicException('failed');","+            $scope->run(static function (): void {","+                throw new \\RuntimeException('failed');","             });","             self::fail('Expected the operation exception.');","-        } catch (\\LogicException $e) {","+        } catch (\\RuntimeException $e) {","             self::assertSame($handler, self::currentErrorHandler());","         } finally {","             restore_error_handler();","         }","+","+        self::assertSame('result', $scope->run(static fn (): string => 'result'));","+    }","+","+    public function testRejectsASecondOperationWhileRunning(): void","+    {","+        $passedOn = [];","+        set_error_handler(static function (int $errno, string $errstr) use (&$passedOn): bool {","+            $passedOn[] = $errstr;","+","+            return true;","+        });","+","+        try {","+            $scope = new ErrorScope(E_ALL, false);","+            $scope->run(static function () use ($scope): void {","+                try {","+                    @$scope->run(static fn () => null);","+                    self::fail('Expected the second operation to be rejected.');","+                } catch (\\LogicException $e) {","+                    self::assertSame(ErrorScope::class.' is already running an operation', $e->getMessage());","+                }","+","+                @trigger_error('silenced', E_USER_WARNING);","+            });","+        } finally {","+            restore_error_handler();","+        }","+","+        self::assertNull($scope->getError());","+        self::assertSame(['silenced'], $passedOn);","     }"," ","     /**",""],"additions":49,"deletions":4,"truncated":false}],"additions":166,"deletions":11,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-13T17:04:49.646031+00:00"}