ions":0,"truncated":false},{"path":"docs/user-manual/modules/ROOT/pages/camel-catalog.adoc","lines":["@@ -88,6 +88,40 @@ nesting level in the YAML DSL, with types, descriptions, required flags, default"," and enum choices. It can be used by third-party tooling (editors, IDE plugins, visual"," designers) to provide context-aware code completion and validation for YAML DSL routes."," ","+=== Finding components by protocol or product name","+","+People, and AI agents driving Camel through tooling, often refer to a component by the protocol or","+product it connects to rather than by its Camel scheme: _mqtt_ (the component is `paho-mqtt5`),","+_s3_ (`aws2-s3`), _rabbitmq_ (`spring-rabbitmq`), _pubsub_ (`google-pubsub`). The catalog can look","+components, data formats and languages up by such a term, ranking the best matches first:","+the exact scheme or name, then declared aliases, alternative schemes, words of the title, words of the","+scheme or name, and finally names containing the term. A component that shares one implementation under","+several schemes (such as `imap`, `pop3` and `smtp`) is returned once.","+","+[source,java]","+----","+CamelCatalog catalog = new DefaultCamelCatalog();","+","+catalog.suggestComponentNames(\"mqtt\", 5);       // [paho-mqtt5]","+catalog.suggestComponentNames(\"s3\", 5);         // [aws2-s3, aws2-s3-vectors]","+catalog.suggestComponentNames(\"amq\", 5);        // [activemq, activemq6, amqp]","+catalog.suggestComponentNames(\"aws\", 5);        // at most five of the many AWS components","+catalog.suggestDataFormatNames(\"yaml\", 5);      // [snakeYaml]","+catalog.suggestLanguageNames(\"path\", 5);        // [jsonpath, xpath]","+----","+","+Component developers can declare the shorthands a title cannot provide with the `aliases` attribute of","+`@Metadata` on the endpoint class, as the mail component does for _mail_ and _email_:","+","+[source,java]","+----","+@Metadata(aliases = { \"mail\", \"email\" })","+@UriEndpoint(firstVersion = \"1.0.0\", scheme = \"imap,imaps,pop3,pop3s,smtp,smtps\", ...)","+public class MailEndpoint extends ScheduledPollEndpoint {","+----","+","+Aliases are descriptive names for discovery only; they cannot be used as the scheme in an endpoint URI.","+"," === Documentation in the Catalog"," "," The catalog includes the AsciiDoc documentation pages from all modules. This makes the full"],"additions":34,"deletions":0,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/main/java/org/apache/camel/dsl/jbang/core/commands/catalog/CatalogBaseCommand.java","lines":["@@ -96,6 +96,13 @@ protected CatalogBaseCommand(CamelJBangMain main) {"," ","     abstract List<Row> collectRows();"," ","+    /**","+     * Names the catalog suggests for a filter that matched nothing, such as a protocol or product name (mqtt, s3).","+     */","+    List<String> suggestNames(String term) {","+        return List.of();","+    }","+","     String getGAV(ArtifactModel<?> model) {","         return model.getGroupId() + \":\" + model.getArtifactId() + \":\" + model.getVersion();","     }","@@ -186,7 +193,12 @@ public Integer doCall() throws Exception {","         } else if (filterName != null) {","             // suggest similar names when filter returns no results","             List<String> allNames = collectRows().stream().map(r -> r.name).collect(Collectors.toList());","-            List<String> suggestions = SuggestSimilarHelper.didYouMean(allNames, filterName);","+            List<String> suggestions = new ArrayList<>(suggestNames(filterName));","+            for (String similar : SuggestSimilarHelper.didYouMean(allNames, filterName)) {","+                if (!suggestions.contains(similar)) {","+                    suggestions.add(similar);","+                }","+            }","             if (!suggestions.isEmpty()) {","                 printer().println(\"No results for filter: \" + filterName + \". Did you mean? \" + String.join(\", \", suggestions));","             } else {"],"additions":13,"deletions":1,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/main/java/org/apache/camel/dsl/jbang/core/commands/catalog/CatalogComponent.java","lines":["@@ -57,4 +57,9 @@ List<CatalogBaseCommand.Row> collectRows() {","         return rows;","     }"," ","+    @Override","+    List<String> suggestNames(String term) {","+        return catalog.suggestComponentNames(term, 5);","+    }","+"," }"],"additions":5,"deletions":0,"truncated":false},{"path":"dsl/camel-jbang/camel-jbang-core/src/main/java/org/apache/camel/dsl/jbang/core/commands/catalog/CatalogDataFormat.java","lines":["@@ -57,4 +57,9 @@ List<Row> collectRows() {","         return rows;","     }"," ","+    @Override","+    List<String> suggestNames(String term) {","+        return catalog.suggestDataFormatNames(term, 5);"],"additions":3,"deletions":0,"truncated":false}],"additions":380,"deletions":1,"truncated":true,"file_count":26},"error":null,"fetched_at":"2026-09-09T13:48:21.178522+00:00"}