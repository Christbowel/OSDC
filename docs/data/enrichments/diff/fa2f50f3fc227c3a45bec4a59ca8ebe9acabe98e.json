"CUDA_VISIBLE_DEVICES\": devices[1]},","-        ) as consumer,","-    ):","-        yield encoder, consumer","+    config = json.dumps(","+        {","+            \"ec_connector\": \"ECCPUConnector\",","+            \"ec_role\": role,","+            \"ec_connector_extra_config\": {","+                \"ec_enable_nixl\": True,","+                \"ec_cpu_bytes\": cpu_bytes,","+            },","+        }","+    )","+    producer = role == \"ec_producer\"","+    role_args = (","+        [\"--mm-encoder-only\", \"--disable-hybrid-kv-cache-manager\"]","+        if producer","+        else [\"--enable-mm-embeds\"]","+    )","+    return RemoteOpenAIServer(","+        MODEL,","+        common + role_args + [\"--ec-transfer-config\", config],","+        env_dict={\"CUDA_VISIBLE_DEVICES\": devices[0 if producer else 1]},","+    )","+","+","+@pytest.fixture(scope=\"module\")","+def encoder():","+    pytest.importorskip(\"nixl\")","+    if not current_platform.is_cuda() or current_platform.device_count() < 2:","+        pytest.skip(\"Requires two CUDA GPUs\")","+    with _server(\"ec_producer\") as server:","+        yield server","+","+","+@pytest.fixture(scope=\"module\")","+def consumer(request, encoder):","+    cpu_bytes = DEFAULT_EC_CPU_BYTES","+    if getattr(request, \"param\", None) == \"eviction\":","+","+        async def entry_size() -> int:","+            timeout = aiohttp.ClientTimeout(total=120)","+            async with aiohttp.ClientSession(timeout=timeout) as session:","+                _, probe, mm_hash = await _encode(session, encoder)","+            return probe[\"ec_transfer_params\"][mm_hash][\"size_bytes\"]","+","+        # Leave room for two entries of the size announced by this producer.","+        cpu_bytes = 2 * asyncio.run(entry_size())","+","+    with _server(\"ec_consumer\", cpu_bytes) as server:","+        yield server"," "," "," async def _post(session, server, body):","@@ -137,15 +150,16 @@ async def _encode(session, encoder):","     )","   