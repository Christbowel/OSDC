atus, result = await _post(session, consumer, filler)","+            assert status == 200, result","+","+        with zmq.asyncio.Context() as ctx, ctx.socket(zmq.ROUTER) as router:","+            router.setsockopt(zmq.LINGER, 0)","+            port = router.bind_to_random_port(\"tcp://127.0.0.1\")","+            request[\"ec_transfer_params\"][mm_hash].update(","+                peer_host=\"127.0.0.1\", peer_port=port","+            )","+            reads = []","+","+            async def reject_read():","+                identity, delimiter, payload = await router.recv_multipart()","+                req = msgspec.msgpack.decode(payload, type=XferReq)","+                reads.append(req.mm_hash)","+                ack = XferAck(","+                    mm_hash=req.mm_hash,","+                    status=XferStatus.NACK_MISSING,","+                    session_id=req.session_id,","+                )","+                await router.send_multipart(","+                    [identity, delimiter, msgspec.msgpack.encode(ack)]","+                )","+","+            rejection = asyncio.create_task(reject_read())","+            try:","+                status, result = await _post(session, consumer, request)","+            finally:","+                rejection.cancel()","+                await asyncio.gather(rejection, return_exceptions=True)","+            assert reads == [], \"A runner cache hit contacted the producer\"","+            assert status == 200, result","+            assert result[\"choices\"][0][\"message\"][\"content\"], result"],"additions":103,"deletions":41,"truncated":false},{"path":"tests/v1/ec_connector/unit/test_scheduler_nixl_consumer.py","lines":["@@ -17,6 +17,7 @@","     MultiModalKwargsItem,","     MultiModalSharedField,"," )","+from vllm.v1.core.encoder_cache_manager import EncoderCacheManager"," "," _N, _BS, _HID, _ES = 16, 64, 32, 2"," ","@@ -44,6 +45,9 @@ def __init__(self, features, params=None, req_id=\"r1\"):","         self.request_id = req_id",