r Share My Personal Information'","+","+describe('getPrivacyLinkLabel', () => {","+  it('shows the opt-out label to US visitors', () => {","+    expect(getPrivacyLinkLabel('US')).toBe(US_LABEL)","+  })","+","+  it('shows Privacy Settings to non-US visitors', () => {","+    expect(getPrivacyLinkLabel('DE')).toBe('Privacy Settings')","+  })","+","+  it('shows the opt-out label when the country is unknown', () => {","+    expect(getPrivacyLinkLabel(undefined)).toBe(US_LABEL)","+  })","+})","+","+describe('readVisitorCountry', () => {","+  it('reads the country among other cookies', () => {","+    expect(readVisitorCountry(`a=1; ${VISITOR_COUNTRY_COOKIE_NAME}=GB; b=2`)).toBe('GB')","+  })","+","+  it('returns undefined when the cookie is missing', () => {","+    expect(readVisitorCountry('a=1')).toBeUndefined()","+  })","+})","+","+describe('stampVisitorCountryCookie', () => {","+  const stamp = (country: string | null, { existing = '', hostname = 'supabase.com' } = {}) => {","+    const set = vi.fn()","+    const remove = vi.fn()","+    stampVisitorCountryCookie(","+      {","+        headers: { get: () => country },","+        cookies: { get: () => (existing ? { value: existing } : undefined) },","+        nextUrl: { hostname },","+      },","+      { cookies: { set, delete: remove } }","+    )","+    return { set, remove }","+  }","+  const setup = (country: string | null, existing?: string) => stamp(country, { existing }).set","+","+  it('copies the Vercel country header into the cookie', () => {","+    expect(setup('us')).toHaveBeenCalledWith(VISITOR_COUNTRY_COOKIE_NAME, 'US', {","+      path: '/',","+      sameSite: 'lax',","+      secure: true,","+      maxAge: 86400,","+    })","+  })","+","+  it('drops the secure flag on localhost', () => {","+    expect(stamp('US', { hostname: 'localhost' }).set).toHaveBeenCalledWith(","+      VISITOR_COUNTRY_COOKIE_NAME,","+      'US',","+      expect.objectContaining({ secure: false })","+    )","+  })","+","+  it('clears a stale cookie when the header is missing', () => {","+    const { set, remove } = stamp(null, { existing: 'DE' })","+    expect(set).not.toHaveBeenCalled()","+    expect(remove).toHaveBeenCalledWith(VISITOR_COUNTRY_COOKIE_NAME)","+  })","+","+  it('skips the write when the header is missing or invalid', () => {","+    expect(setup(null)).not.toHaveBeenCalled()","+    expect(setup('XX1')).not.toHaveBeenCalled()","+  })","+","+  it('skips the write when the cookie already matches', () => {","+    expect(setup('FR', 'FR')).not.toHaveBeenCalled()","+  })","+})"],"additions":83,"deletions":0,"truncated":false},{"path":"packages/common/visitor-country.ts","lines":["@@ -0,0 +1,53 @@","+export const VISITOR_COUNTRY_COOKIE_NAME = '_sb_country'","+","+const VISITOR_COUNTRY_COOKIE_MAX_AGE = 24 * 60 * 60","+","+interface MiddlewareRequest {","+  headers: { get(name: string): string | null }","+  cookies: { get(name: string): { value: string } | undefined }","+  nextUrl: { hostname: string }","+}","+","+interface MiddlewareResponse {","+  cookies: {","+    set(","+      name: string,","+      value: string,","+      options?: { path?: string; sameSite?: 'lax'; secure?: boolean; maxAge?: number }","+    ): void","+    delete(name: string): void","+  }","+}","+","+export function stampVisitorCountryCookie(","+  request: MiddlewareRequest,","+  response: MiddlewareResponse","+): void {","+  const country = request.headers.get('x-vercel-ip-country')?.toUpperCase()","+  const existing = request.cookies.get(VISITOR_COUNTRY_COOKIE_NAME)?.value","+  if (!country || !/^[A-Z]{2}$/.test(country)) {","+    if (existing) response.cookies.delete(VISITOR_COUNTRY_COOKIE_NAME)","+    return","+  }","+  if (existing === country) return","+","+  response.cookies.set(VISITOR_COUNTRY_COOKIE_NAME, country, {","+    path: '/',","+    sameSite: 'lax',","+    secure: request.nextUrl.hostname !== 'localhost',","+    maxAge: VISITOR_COUNTRY_COOKIE_MAX_AGE,","+  })","+}","+","+export function readVisitorCountry(cookie: string): string | undefined {","+  const match = cookie.match(new RegExp(`(?:^|;\\\\s*)${VISITOR_COUNTRY_COOKIE_NAME}=([A-Z]{2})`))","+  return match?.[1]","+}","+","+export const US_PRIVACY_LINK_LABEL = 'Do Not Sell or Share My Personal Information'","+export const DEFAULT_PRIVACY_LINK_LABEL = 'Privacy Settings'","+","+// A failed country lookup must still show the opt-out label.","+export function getPrivacyLinkLabel(country: string | undefined): string {","+  return country && country !== 'US' ? DEFAULT_PRIVACY_LINK_LABEL : US_PRIVACY_LINK_LABEL","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"packages/ui-patterns/src/PrivacySettings/index.tsx","lines":["@@ -1,10 +1,12 @@"," 'use client'"," "," import { useConsentState } from 'common/consent-state'","+import { getPrivacyLinkLabel, readVisitorCountry } from 'common/visitor-country'"," import Link from 'next/link'","-import { PropsWithChildren, useState } from 'react'","+import { PropsWithChildren, useEffect, useState } from 'react'"," import {","   Button,","+  cn,","   Dialog,","   DialogContent,","   DialogFooter,","@@ -19,12 +21,28 @@ import {"," "," import { Admonition } from '../Admonition'"," ","+export const PrivacySettingsLabel = () => {","+  const [country, setCountry] = useState<string>()","+  const [hasReadCountry, setHasReadCountry] = useState(false)","+","+  useEffect(() => {","+    setCountry(readVisitorCountry(document.cookie))","+    setHasReadCountry(true)","+  }, [])","+","+  // Hidden until the country cookie is read, so non-US visitors never see the US label flash.","+  return (","+    <span className={hasReadCountry ? undefined : 'invisible'}>{getPrivacyLinkLabel(country)}</span>","+  )","+}","+"," interface PrivacySettingsProps {","   className?: string"," }"," "," export const PrivacySettings = ({","   children,","+  className,","   ...props"," }: PropsWithChildren<PrivacySettingsProps>) => {","   const [isOpen, setIsOpen] = useState(false)","@@ -53,7 +71,11 @@ ex