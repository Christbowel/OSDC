,5 @@"," import {type SanityClient} from '@sanity/client'","-import {defer, firstValueFrom, map, type Observable, of} from 'rxjs'","+import {defer, firstValueFrom, map, type Observable, of, tap} from 'rxjs'"," "," /**","  * The /ping route is special in that it allows any origin to access it, and crucially","@@ -13,10 +13,23 @@ const checkRequestTag = 'protocol-check'"," "," const DEFAULT_TIMEOUT = 2_500"," ","-// The background warning is a one-shot check per client. Cache its promise so observable","-// warm-up, remounts, and multiple subscribers cannot start duplicate requests. The detailed","-// diagnostics API below remains uncached so an explicit rerun always captures a fresh result.","-const legacyHttpChecks = new WeakMap<SanityClient, Promise<boolean | undefined>>()","+/**","+ * The API version of the client the protocol check runs with. Callers share it so they share the","+ * client, and with it the cached probe.","+ *","+ * @internal","+ */","+export const PROTOCOL_CHECK_API_VERSION = '2025-03-01'","+","+interface ProtocolCheck {","+  promise: Promise<string>","+  protocol: string | undefined","+}","+","+// The background warning runs a one-shot check per client and telemetry reads its result. Cache it","+// so observable warm-up, remounts, and multiple subscribers cannot start duplicate requests. The","+// detailed diagnostics API below remains uncached so an explicit rerun always captures a fresh result.","+const protocolChecks = new WeakMap<SanityClient, ProtocolCheck>()"," "," /** @internal */"," export interface ApiNetworkResourceTiming {","@@ -62,26 +75,46 @@ export interface ApiNetworkDiagnosticOptions {","  * @internal","  */"," export function isUsingLegacyHttp(client: SanityClient): Observable<boolean | undefined> {","+  return getApiProtocol(client).pipe(","+    map((protocol) => {","+      if (protocol === 'unknown') {","+        return undefined","+      }","+","+      // Typical values are \"http/0.9\", \"http/1.0\", \"http/1.1\", \"h2\", \"h2c\", \"h3\", etc.","+      return protocol.startsWith('http/0') || protocol.startsWith('http/1')","+    }),","+  )","+}","+","+/**","+ * The `nextHopProtocol` the warning's probe found for this client, or `undefined` while the probe","+ * has not run or settled. Never starts a request.","+ *","+ * @internal","+ */","+export function getCachedApiProtocol(client: SanityClient): string | undefined {","+  return protocolChecks.get(client)?.protocol","+}","+","+function getApiProtocol(client: SanityClient): Observable<string> {","   return defer(() => {","-    let check = legacyHttpChecks.get(client)","+    const cachedCheck = protocolChecks.get(client)","+    if (cachedCheck) return cachedCheck.promise"," ","-    if (!check) {","-      check = firstValueFrom(","+    const check: ProtocolCheck = {","+      protocol: undefined,","+      promise: firstValueFrom(","         getApiNetworkDiagnostic(client).pipe(","-          map(({protocol}) => {","-            if (protocol === 'unknown') {","-              return undefined","-            }","-","-            // Typical values are \"http/0.9\", \"http/1.0\", \"http/1.1\", \"h2\", \"h2c\", \"h3\", etc.","-            return protocol.startsWith('http/0') || protocol.startsWith('http/1')","+          map((diagnostic) => diagnostic.protocol),","+          tap((protocol) => {","+            check.protocol = protocol","           }),","         ),","-      )","-      legacyHttpChecks.set(client, check)","+      ),","     }","-","-    return check","+    protocolChecks.set(client, check)","+    return check.promise","   })"," }"," "],"additions":52,"deletions":19,"truncated":false},{"path":"packages/sanity/src/core/network/listenerCount.test.ts","lines":["@@ -0,0 +1,171 @@","+import {createClient} from '@sanity/client'","+import {afterEach, beforeEach, describe, expect, it, vi} from 'vitest'","+","+import type * as ListenerCountExports from './listenerCount'","+","+type ListenerCountModule = typeof ListenerCountExports","+","+const EVENT_STREAM_HEADERS = {Accept: 'text/event-stream'}","+","+function createEventStream(): {","+  response: Response","+  push: (text: string) => void","+  end: () => void","+} {","+  let streamController: ReadableStreamDefaultController<Uint8Array> | undefined","+  const body = new ReadableStream<Uint8Array>({","+    start(controller) {","+      streamController = controller","+    },","+  })","+  const encoder = new TextEncoder()","+  return {","+    response: new Response(body, {headers: {'content-type': 'text/event-stream'}}),","+    push: (text) => streamController?.enqueue(encoder.encode(text)),","+    end: () => streamController?.close(),","+  }","+}","+","+async function drain(body: ReadableStream<Uint8Array> | null): Promise<void> {","+  const reader = body?.getReader()","+  let chunk = await reader?.read()","+  while (chunk?.done === false) {","+    chunk = await reader?.read()","+  }","+}","+","+describe('listener counting fetch', () => {","+  let listenerCount: ListenerCountModule","+","+  beforeEach(async () => {","+    vi.resetModules()","+    vi.stubGlobal('fetch', vi.fn())","+    listenerCount = await import('./listenerCount')","+  })","+","+  afterEach(() => {","+    vi.unstubAllGlobals()","+  })","+","+  it('counts a listener opened through client.listen until it is unsubscribed', async () => {","+    const stream = createEventStream()","+    vi.mocked(fetch).mockResolvedValue(stream.response)","+    const client = createClient({","+      projectId: 'abc123',","+      dataset: 'production',","+      apiVersion: '2025-03-01',","+      useCdn: false,","+      resolveFetch: listenerCount.resolveListenerCountingFetch,","+    })","+","+    const welcomed = new Promise<void>((resolve) => {","+      const subscription = client.listen('*', {}, {events: ['welcome']}).subscribe(() => {","+        subscription.unsubscribe()","+        resolve()","+      })","+    })","+    await vi.waitFor(() => expect(listenerCount.getListenerCounts().open).toBe(1))","+    stream.push('event: welcome\\ndata: {\"listenerName\":\"test\"}\\n\\n')","+    await welcomed","+","+    await vi.waitFor(() => expect(listenerCount.getListenerCounts()).toEqual({open: 0, peak: 1}))","+  })","+","+  it('passes requests that are not event streams through untouched', async () => {","+    const response = new Response('{}')","+    vi.mocked(fetch).mockResolvedValue(response)","+    const countingFetch = listenerCount.resolveListenerCountingFetch()","+","+    await expect(countingFetch('https://abc123.api.sanity.io/v1/data/query')).resolves.toBe(","+      response,","+    )","+    expect(listenerCount.getListenerCounts()).toEqual({open: 0, peak: 0})","+  })","+","+  it('keeps a listener open until the server ends its stream', async () => {","+    const stream = createEventStream()","+    vi.mocked(fetch).mockResolvedValue(stream.response)","+    const countingFetch = listenerCount.resolveListenerCountingFetch()","+","+    const response = await countingFetch('https://abc123.api.sanity.io/v1/data/listen', {","+      headers: EVENT_STREAM_HEADERS,","+    })","+    expect(listenerCount.getListenerCounts().open).toBe(1)","+","+    stream.end()","+    await drain(response.body)","+","+    expect(listenerCount.getListenerCounts()).toEqual({open: 0, peak: 1})","+  })","+","+  it('closes a listener when its request is aborted', async () => {","+    vi.mocked(fetch).mockResolvedValue(createEventStream().response)","+    const countingFetch = listenerCount.resolveListenerCountingFetch()","+    const abortController = new AbortController()","+","+    await countingFetch('https://abc123.api.sanity.io/v1/data/listen', {","+      headers: EVENT_STREAM_HEADERS,","+      signal: abortController.signal,","+    })","+    abortController.abort()","+","+    expect(listenerCount.getListenerCounts()).toEqual({open: 0, peak: 1})","+  })","+","+  it('closes a listener whose request fails or is rejected by the server', async () => {","+    vi.mocked(fetch)","+      .mockRejectedValueOnce(new TypeError('Failed to fetch'))","+      .mockResolvedValueOnce(new Response('Unauthorized', {status: 401}))","+      .mockResolvedValueOnce(new Response('{}', {headers: {'content-type': 'application/json'}}))","+    const countingFetch = listenerCount.resolveListenerCountingFetch()","+    const listen = () =>","+      countingFetch('https://abc123.api.sanity.io/v1/data/listen', {","+        headers: EVENT_STREAM_HEADERS,","+      })","+","+    await expect(listen()).rejects.toThrow('Failed to fetch')","+    await expect(listen()).resolves.toMatchObject({status: 401})","+    await expect(listen()).resolves.toMatchObject({status: 200})","+","+    expect(listenerCount.getListenerCounts()).toEqual({open: 0, peak: 1})","+  })","+","+  it('records the most listeners open at once', async () => {","+    vi.mocked(fetch).mockImplementation(() => Promise.resolve(createEventStream().response))","+    const countingFetch = listenerCount.resolveListenerCountingFetch()","+    const controllers = [new AbortController(), new AbortController(), new AbortController()]","+","+    await Promise.all(","+      controllers.map((controller) =>","+        countingFetch('https://abc123.api.sanity.io/v1/data/listen', {","+          headers: EVENT_STREAM_HEADERS,","+          signal: controller.signal,","+        }),","+      ),","+    )","+    controllers.forEach((controller) => controller.abort())","+","+    expect(listenerCount.getListenerCounts()).toEqual({open: 0, peak: 3})","+  })","+})","+","+describe('listener count subscription', () => {","+  let listenerCount: ListenerCountModule","+","+  beforeEach(async () => {","+    vi.resetModules()","+    listenerCount = await import('./listenerCount')","+  })","+","+  it('calls the subscriber when a listener opens and when it closes, until unsubscribed', () => {","+    const subscriber = vi.fn()","+    const unsubscribe = listenerCount.subscribeListenerCounts(subscriber)","+","+    const release = listenerCount.openListener()","+    release()","+    unsubscribe()","+    listenerCount.openListener()","+","+    expect(subscriber.mock.calls).toEqual([[{open: 1, peak: 1}], [{open: 0, peak: 1}]])","+  })","+})"],"additions":171,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/network/listenerCount.ts","lines":["@@ -0,0 +1,151 @@","+import {type ClientConfig} from '@sanity/client'","+import once from 'lodash-es/once.js'","+","+type FetchFunction = ReturnType<NonNullable<ClientConfig['resolveFetch']>>","+type FetchResponse = Awaited<ReturnType<FetchFunction>>","+type FetchInit = Parameters<FetchFunction>[1]","+","+/** @internal */","+export interface ListenerCounts {","+  open: number","+  peak: number","+}","+","+const listenerCounts: ListenerCounts = {open: 0, peak: 0}","+const listenerCountSubscribers = new Set<(counts: Readonly<ListenerCounts>) => void>()","+","+/**","+ * How many listeners the Studio's clients hold open in this tab right now, and the most it has","+ * held at once since the page loaded. A listener counts from the moment it is requested, so one","+ * queued behind the browser's connection limit counts too.","+ *","+ * @internal","+ */","+export function getListenerCounts(): Readonly<ListenerCounts> {","+  return {...listenerCounts}","+}","+","+/**","+ * Calls `subscriber` whenever a listener opens or closes in this tab. Returns a function that","+ * stops the calls.","+ *","+ * @internal","+ */","+export function subscribeListenerCounts(","+  subscriber: (counts: Readonly<ListenerCounts>) => void,","+): () => void {","+  listenerCountSubscribers.add(subscriber)","+  return () => {","+    listenerCountSubscribers.delete(subscriber)","+  }","+}","+","+function notifyListenerCountSubscribers(): void {","+  const counts = getListenerCounts()","+  listenerCountSubscribers.forEach((subscriber) => subscriber(counts))","+}","+","+/**","+ * A `resolveFetch` for the Studio's clients that counts every listener they open, whichever","+ * API it uses (`listen`, `live.events`), and passes every other request through untouched.","+ *","+ * @internal","+ */","+export function resolveListenerCountingFetch(): FetchFunction {","+  return countingFetch","+}","+","+function countingFetch(input: string, init?: FetchInit): Promise<FetchResponse> {","+  return isEventStreamRequest(init) ? fetchListener(input, init) : globalThis.fetch(input, init)","+}","+","+function isEventStreamRequest(init: FetchInit): boolean {","+  return new Headers(init?.headers).get('accept')?.includes('text/event-stream') ?? false","+}","+","+async function fetchListener(input: string, init: FetchInit): Promise<FetchResponse> {","+  const release = openListener()","+  init?.signal?.addEventListener('abort', release, {once: true})","+","+  try {","+    const response = await globalThis.fetch(input, init)","+    if (isOpenEventStream(response)) {","+      return withBody(response, releaseOnEnd(response.body, release))","+    }","+    release()","+    return response","+  } catch (error) {","+    release()","+    throw error","+  }","+}","+","+/**","+ * Counts a listener opened outside the Studio's clients, such as a raw `EventSource`. Call the","+ * returned function once the listener closes; calling it again does nothing.","+ *","+ * @internal","+ */","+export function openListener(): () => void {","+  listenerCounts.open += 1","+  listenerCounts.peak = Math.max(listenerCounts.peak, listenerCounts.open)","+  notifyListenerCountSubscribers()","+","+  return once(() => {","+    listenerCounts.open -= 1","+    notifyListenerCountSubscribers()","+  })","+}","+","+function isOpenEventStream(","+  response: FetchResponse,","+): response is FetchResponse & {body: ReadableStream<Uint8Array>} {","+  return (","+    response.ok &&","+    response.body !== null &&","+    (response.headers.get('content-type')?.includes('text/event-stream') ?? false)","+  )","+}","+","+// The server can end a stream without the client aborting it, so the end of the body is the","+// only reliable signal that the connection has closed.","+function releaseOnEnd(","+  body: ReadableStream<Uint8Array>,","+  release: () => void,","+): ReadableStream<Uint8Array> {","+  const reader = body.getReader()","+  return new ReadableStream<Uint8Array>({","+    async pull(controller) {","+      try {","+        const chunk = await reader.read()","+        if (chunk.done) {","+          release()","+          controller.close()","+          return","+        }","+        controller.enqueue(chunk.value)","+      } catch (error) {","+        release()","+        controller.error(error)","+      }","+    },","+    cancel(reason) {","+      release()","+      return reader.cancel(reason)","+    },","+  })","+}","+","+function withBody(response: FetchResponse, body: ReadableStream<Uint8Array>): FetchResponse {","+  return {","+    ok: response.ok,","+    status: response.status,","+    statusText: response.statusText,","+    headers: response.headers,","+    url: response.url,","+    redirected: response.redirected,","+    body,","+    text: () => new Response(body).text(),","+    arrayBuffer: () => new Response(body).arrayBuffer(),","+  }","+}"],"additions":151,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/network/studioTabs.browser.test.ts","lines":["@@ -0,0 +1,169 @@","+import {afterEach, describe, expect, test} from 'vitest'","+","+import type * as ListenerCountExports from './listenerCount'","+import type * as StudioTabsExports from './studioTabs'","+import {parseStudioTabLock} from './studioTabs'","+","+const STUDIO_TABS_URL = new URL('./studioTabs.ts', import.meta.url).href","+const LISTENER_COUNT_URL = new URL('./listenerCount.ts', import.meta.url).href","+","+interface Tab {","+  frame: HTMLIFrameElement","+  studioTabs: typeof StudioTabsExports","+  listenerCount: typeof ListenerCountExports","+}","+","+type TabWindow = Window & {","+  tabModules: Promise<[typeof StudioTabsExports, typeof ListenerCountExports]>","+}","+","+const openFrames: HTMLIFrameElement[] = []","+","+// Each same-origin iframe loads its own copy of the modules, so it stands for a separate tab","+// sharing the origin's lock manager; removing it stands for the tab closing or crashing.","+async function openTab(): Promise<Tab> {","+  const frame = document.createElement('iframe')","+  frame.srcdoc = `<script type=\"module\">window.tabModules = Promise.all([import(${JSON.stringify(STUDIO_TABS_URL)}), import(${JSON.stringify(LISTENER_COUNT_URL)})])</script>`","+  const loaded = new Promise((resolve) => frame.addEventListener('load', resolve, {once: true}))","+  document.body.append(frame)","+  openFrames.push(frame)","+  await loaded","+  const [studioTabs, listenerCount] = await (frame.contentWindow as TabWindow).tabModules","+  return {frame, studioTabs, listenerCount}","+}","+","+function uniqueScope(): string {","+  return `${crypto.randomUUID()}.api.sanity.test`","+}","+","+async function heldTabLocks(scope: string) {","+  const {held = []} = await navigator.locks.query()","+  return held.flatMap((lock) => {","+    const tabLock = parseStudioTabLock(lock.name ?? '')","+    return tabLock?.scope === scope ? [tabLock] : []","+  })","+}","+","+async function heldLockNames(scope: string): Promise<string[]> {","+  const tabLocks = await heldTabLocks(scope)","+  return tabLocks.map(({tabId, count}) => `${tabId}:${count}`).sort()","+}","+","+function delay(ms: number): Promise<void> {","+  return new Promise((resolve) => setTimeout(resolve, ms))","+}","+","+async function heldTabLockCount(): Promise<number> {","+  const {held = []} = await navigator.locks.query()","+  return held.filter((lock) => parseStudioTabLock(lock.name ?? '')).length","+}","+","+// A removed frame's locks are released asynchronously, and every test's peak counts tabs across","+// all scopes, so each test starts only once the previous test's tabs are gone.","+afterEach(async () => {","+  openFrames.splice(0).forEach((frame) => frame.remove())","+  await expect.poll(heldTabLockCount).toBe(0)","+})","+","+describe('studio tab locks (real Web Locks)', () => {","+  test(\"a tab's lock carries its scope, tab id and current listener count\", async () => {","+    const scope = uniqueScope()","+    const tab = await openTab()","+","+    tab.studioTabs.startTrackingStudioTabs(scope)","+    tab.listenerCount.openListener()","+    tab.listenerCount.openListener()","+","+    await expect.poll(() => heldLockNames(scope)).toEqual([`${tab.studioTabs.getStudioTabId()}:2`])","+  })","+","+  test('a count change settles on exactly one lock per tab with the new count', async () => {","+    const scope = uniqueScope()","+    const tabs = await Promise.all([openTab(), openTab()])","+    tabs.forEach((tab) => tab.studioTabs.startTrackingStudioTabs(scope))","+    await expect.poll(async () => (await heldTabLocks(scope)).length).toBe(2)","+","+    const releases = tabs.map((tab) => tab.listenerCount.openListener())","+    tabs[0].listenerCount.openListener()","+    releases[1]()","+","+    await expect","+      .poll(() => heldLockNames(scope))","+      .toEqual(","+        [","+          `${tabs[0].studioTabs.getStudioTabId()}:2`,","+          `${tabs[1].studioTabs.getStudioTabId()}:0`,","+        ].sort(),","+      )","+  })","+","+  test('a tab is never missing from query() while it republishes', async () => {","+    const scope = uniqueScope()","+    const tab = await openTab()","+    const tabId = tab.studioTabs.getStudioTabId()","+    tab.studioTabs.startTrackingStudioTabs(scope)","+    await expect.poll(async () => (await heldTabLocks(scope)).length).toBe(1)","+","+    const churn = Array.from({length: 6}).reduce<Promise<void>>(async (previous) => {","+      await previous","+      const release = tab.listenerCount.openListener()","+      await delay(260)","+      release()","+      await delay(260)","+    }, Promise.resolve())","+    const observations = await Promise.all(","+      Array.from({length: 500}, async (_, index) => {","+        await delay(index * 6)","+        return heldTabLocks(scope)","+      }),","+    )","+    await churn","+","+    const tabIdsSeen = observations.map((tabLocks) => new Set(tabLocks.map((lock) => lock.tabId)))","+    const countsSeen = new Set(observations.flat().map((lock) => lock.count))","+    expect(tabIdsSeen.every((tabIds) => tabIds.size === 1 && tabIds.has(tabId))).toBe(true)","+    expect([...countsSeen].sort((first, second) => first - second)).toEqual([0, 1])","+  })","+","+  test('closing a tab drops its lock', async () => {","+    const scope = uniqueScope()","+    const tab = await openTab()","+    tab.studioTabs.startTrackingStudioTabs(scope)","+    await expect.poll(async () => (await heldTabLocks(scope)).length).toBe(1)","+","+    tab.frame.remove()","+","+    await expect.poll(() => heldTabLocks(scope)).toEqual([])","+  })","+","+  test('six tabs starting together each see six, and seven once another opens', async () => {","+    const scope = uniqueScope()","+    const tabs = await Promise.all(Array.from({length: 6}, () => openTab()))","+","+    tabs.forEach((tab) => tab.studioTabs.startTrackingStudioTabs(scope))","+    tabs.forEach((tab) => tab.listenerCount.openListener())","+","+    await expect","+      .poll(() => tabs.map((tab) => tab.studioTabs.getPeakStudioTabCount()))","+      .toEqual([6, 6, 6, 6, 6, 6])","+    await delay(400)","+    const lateTab = await openTab()","+    lateTab.studioTabs.startTrackingStudioTabs(scope)","+    await expect.poll(() => lateTab.studioTabs.getPeakStudioTabCount()).toBe(7)","+    await expect","+      .poll(() => tabs.map((tab) => tab.studioTabs.getPeakStudioTabCount()))","+      .toEqual([7, 7, 7, 7, 7, 7])","+  })","+","+  test('an open tab resamples when another tab opens', async () => {","+    const scope = uniqueScope()","+    const firstTab = await openTab()","+    firstTab.studioTabs.startTrackingStudioTabs(scope)","+    await expect.poll(() => firstTab.studioTabs.getPeakStudioTabCount()).toBe(1)","+","+    const secondTab = await openTab()","+    secondTab.studioTabs.startTrackingStudioTabs(scope)","+","+    await expect.poll(() => firstTab.studioTabs.getPeakStudioTabCount()).toBe(2)","+  })","+})"],"additions":169,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/network/studioTabs.test.ts","lines":["@@ -0,0 +1,293 @@","+import {afterEach, beforeEach, describe, expect, it, vi} from 'vitest'","+","+import type * as ListenerCountExports from './listenerCount'","+import type * as StudioTabsExports from './studioTabs'","+","+const SCOPE = 'api.sanity.io'","+","+function createFakeLocks(): {","+  locks: LockManager","+  held: string[]","+  requested: string[]","+  events: string[]","+} {","+  const held: string[] = []","+  const requested: string[] = []","+  const events: string[] = []","+  const locks = {","+    request: async (name: string, callback: () => Promise<void>) => {","+      requested.push(name)","+      await Promise.resolve()","+      held.push(name)","+      events.push(`acquired ${name}`)","+      await callback()","+      held.splice(held.indexOf(name), 1)","+      events.push(`released ${name}`)","+    },","+    query: () => Promise.resolve({held: held.map((name) => ({name, mode: 'exclusive'}))}),","+  }","+  return {locks: locks as unknown as LockManager, held, requested, events}","+}","+","+describe('getStudioTabScope', () => {","+  it('is the host of the API, port included, and never throws', async () => {","+    const {getStudioTabScope} = await import('./studioTabs')","+","+    expect(","+      ['https://api.sanity.io', 'http://localhost:3900', 'api.sanity.io', undefined].map(","+        getStudioTabScope,","+      ),","+    ).toEqual(['api.sanity.io', 'localhost:3900', 'unknown', 'unknown'])","+  })","+})","+","+describe('parseStudioTabLock', () => {","+  it('reads the scope, tab id and count, ignoring fields after the count', async () => {","+    const {parseStudioTabLock} = await import('./studioTabs')","+","+    expect(parseStudioTabLock('sanity-listener-tab:api.sanity.io:tab-1:4')).toEqual({","+      scope: 'api.sanity.io',","+      tabId: 'tab-1',","+      count: 4,","+    })","+    expect(parseStudioTabLock('sanity-listener-tab:api.sanity.io:tab-1:4:stalled')).toEqual({","+      scope: 'api.sanity.io',","+      tabId: 'tab-1',","+      count: 4,","+    })","+  })","+","+  it('round-trips a scope that contains a port', async () => {","+    const {parseStudioTabLock} = await import('./studioTabs')","+","+    expect(parseStudioTabLock('sanity-listener-tab:localhost%3A3900:tab-1:2')).toEqual({","+      scope: 'localhost:3900',","+      tabId: 'tab-1',","+      count: 2,","+    })","+  })","+","+  it('rejects other prefixes and malformed names', async () => {","+    const {parseStudioTabLock} = await import('./studioTabs')","+","+    expect(","+      [","+        'sanity-studio-tab:api.sanity.io:tab-1:4',","+        'sanity-listener-tab:api.sanity.io:tab-1:four',","+        'sanity-listener-tab:api.sanity.io:tab-1:-1',","+        'sanity-listener-tab:api.sanity.io:tab-1:',","+        'sanity-listener-tab:api.sanity.io:tab-1',","+        'sanity-listener-tab::tab-1:4',","+        'sanity-listener-tab:api%E0.sanity.io:tab-1:4',","+      ].map(parseStudioTabLock),","+    ).toEqual([undefined, undefined, undefined, undefined, undefined, undefined, undefined])","+  })","+})","+","+describe('studio tab lock', () => {","+  let studioTabs: typeof StudioTabsExports","+  let listenerCount: typeof ListenerCountExports","+  let fakeLocks: ReturnType<typeof createFakeLocks>","+","+  beforeEach(async () => {","+    vi.resetModules()","+    vi.useFakeTimers()","+    fakeLocks = createFakeLocks()","+    vi.stubGlobal('navigator', {...navigator, locks: fakeLocks.locks})","+    studioTabs = await import('./studioTabs')","+    listenerCount = await import('./listenerCount')","+  })","+","+  afterEach(() => {","+    vi.useRealTimers()","+    vi.unstubAllGlobals()","+  })","+","+  it('holds one lock named for its scope, tab id and listener count', async () => {","+    studioTabs.startTrackingStudioTabs(SCOPE)","+    await vi.runAllTimersAsync()","+","+    expect(fakeLocks.held).toEqual([","+      `sanity-listener-tab:${SCOPE}:${studioTabs.getStudioTabId()}:0`,","+    ])","+    expect(studioTabs.getPeakStudioTabCount()).toBe(1)","+  })","+","+  it('republishes once, with the latest count, after changes settle for 250ms', async () => {","+    studioTabs.startTrackingStudioTabs(SCOPE)","+    await vi.runAllTimersAsync()","+","+    const releases = [1, 2, 3, 4, 5].map(() => listenerCount.openListener())","+    releases[0]()","+    await vi.advanceTimersByTimeAsync(249)","+    expect(fakeLocks.requested).toHaveLength(1)","+    await vi.advanceTimersByTimeAsync(1)","+    await vi.runAllTimersAsync()","+","+    expect(fakeLocks.requested).toHaveLength(2)","+    expect(fakeLocks.held).toEqual([","+      `sanity-listener-tab:${SCOPE}:${studioTabs.getStudioTabId()}:4`,","+    ])","+  })","+","+  it('takes the new lock before releasing the old one', async () => {","+    studioTabs.startTrackingStudioTabs(SCOPE)","+    await vi.runAllTimersAsync()","+    const lockName = (count: number) =>","+      `sanity-listener-tab:${SCOPE}:${studioTabs.getStudioTabId()}:${count}`","+","+    listenerCount.openListener()","+    await vi.runAllTimersAsync()","+","+    expect(fakeLocks.events).toEqual([","+      `acquired ${lockName(0)}`,","+      `acquired ${lockName(1)}`,","+      `released ${lockName(0)}`,","+    ])","+  })","+","+  it('keeps republishing after a lock request is rejected', async () => {","+    vi.spyOn(fakeLocks.locks, 'request').mockRejectedValueOnce(","+      new DOMException('The document is not fully active', 'InvalidStateError'),","+    )","+    studioTabs.startTrackingStudioTabs(SCOPE)"],"additions":153,"deletions":0,"truncated":false}],"additions":708,"deletions":21,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-17T18:44:29.938237+00:00"}