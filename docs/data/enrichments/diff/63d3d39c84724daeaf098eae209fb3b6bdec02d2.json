{"id":"63d3d39c84724daeaf098eae209fb3b6bdec02d2","axis":"silent","repo":"vllm-project/vllm","sha":"63d3d39c84724daeaf098eae209fb3b6bdec02d2","parsed":{"files":[{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -448,6 +448,7 @@ steps:","   - tests/model_executor/layers/test_activation.py","   - tests/models/test_language_model_cache_is_weak.py","   - tests/models/deepseek_v32/test_sequence_parallel.py","+  - tests/models/deepseek_v32/test_pp_topk.py","   - tests/models/test_deepseek_v4_fi_moe_ep.py","   - tests/models/test_dspark_mla.py","   - tests/models/transformers/test_layer_registry.py","@@ -466,6 +467,7 @@ steps:","       model_executor/layers/test_activation.py","       models/test_language_model_cache_is_weak.py","       models/deepseek_v32/test_sequence_parallel.py","+      models/deepseek_v32/test_pp_topk.py","       models/test_deepseek_v4_fi_moe_ep.py","       models/test_dspark_mla.py","       models/transformers/test_layer_registry.py"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/models/deepseek_v32/test_pp_topk.py","lines":["@@ -0,0 +1,131 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+from types import SimpleNamespace","+","+import pytest","+import torch","+from torch import nn","+","+from vllm.distributed import parallel_state","+from vllm.model_executor.models import utils as model_utils","+from vllm.models.deepseek_v32.nvidia import model as deepseek_v32_model","+from vllm.sequence import IntermediateTensors","+","+# GLM-5.3: each group of 4 layers from layer 3 reuses its first layer's top-k.","+GLM5_TOPK = dict(index_topk_freq=4, index_skip_topk_offset=3)","+","+","+def _set_pp_size(monkeypatch, pp_size: int) -> None:","+    monkeypatch.setattr(","+        parallel_state, \"get_pp_group\", lambda: SimpleNamespace(world_size=pp_size)","+    )","+","+","+class TestPPSplitsLayerSharing:","+    @pytest.mark.parametrize(","+        \"num_layers,users,consumers,pp_size,expected\",","+        [","+            (8, range(8), {1, 2, 3, 5, 6, 7}, 2, False),","+            (8, range(8), {1, 2, 4, 5, 6, 7}, 2, True),","+            (8, range(8), {1, 2, 4, 5, 6, 7}, 1, False),","+            # Layers 4-5 do not use the state, so stage 1's first user is 6.","+            (8, {0, 1, 2, 3, 6, 7}, {1, 2, 3, 7}, 2, False),","+            (8, {0, 1, 2, 3, 6, 7}, {1, 2, 3, 6, 7}, 2, True),","+            (12, range(12), {1, 2, 3, 5, 6, 7, 9, 10, 11}, 3, False),","+            (12, range(12), {1, 2, 3, 4, 6, 7, 9, 10, 11}, 3, True),","+        ],","+        ids=[","+            \"split-on-producer\",","+            \"split-on-consumer\",","+            \"no-pp\",","+            \"skip-unrelated-layers\",","+            \"unrelated-then-consumer\",","+            \"pp3-aligned\",","+            \"pp3-middle-split\",","+        ],","+    )","+    def test_stage_boundaries(","+        self, monkeypatch, num_layers, users, consumers, pp_size, expected","+    ):","+        _set_pp_size(monkeypatch, pp_size)","+        assert (","+            model_utils.pp_splits_layer_sharing(num_layers, users, consumers)","+            == expected","+        )","+","+    @pytest.mark.parametrize(","+        \"num_layers,expected\",","+        [(78, True), (76, False)],","+        ids=[\"glm5-default-split\", \"split-on-group-start\"],","+    )","+    def test_topk_buffers(self, monkeypatch, num_layers, expected):","+        _set_pp_size(monkeypatch, 2)","+        config = SimpleNamespace(","+            num_hidden_layers=num_layers, index_topk=8, **GLM5_TOPK","+        )","+        buffer = torch.empty(4, 8, dtype=torch.int32)","+        buffers = model_utils.pp_topk_buffers(config, buffer, range(num_layers))","+        assert buffers == ({\"topk_indices\": buffer} if expected else {})","+","+","+def test_empty_intermediate_tensors_follow_buffers():","+    buffer = torch.empty(16, 8, dtype=torch.int32)","+    make_empty = model_utils.make_empty_intermediate_tensors_factory(","+        [\"hidden_states\", \"residual\"], 4, {\"topk_indices\": buffer}","+    )","+    tensors = make_empty(3, torch.bfloat16, torch.device(\"cpu\"))","+","+    assert tensors[\"residual\"].shape == (3, 4)","+    assert tensors[\"topk_indices\"].shape == (3, 8)","+    assert tensors[\"topk_indices\"].dtype == torch.int32","+","+","+class _TopkReusingLayer(nn.Module):","+    \"\"\"Reads the shared top-k like a reusing layer, then indexes like the next.\"\"\"","+","+    def __init__(self, topk_indices_buffer: torch.Tensor) -> None:","+        super().__init__()","+        self.topk_indices_buffer = topk_indices_buffer","+        self.seen_topk: torch.Tensor | None = None","+","+    def forward(self, positions, hidden_states, residual, attn_in=None):","+        num_tokens = hidden_states.shape[0]","+        self.seen_topk = self.topk_indices_buffer[:num_tokens].clone()","+        self.topk_indices_buffer[:num_tokens] += 10","+        return hidden_states, torch.zeros_like(hidden_states)","+","+","+def test_middle_pp_stage_receives_and_forwards_topk(monkeypatch):","+    model = object.__new__(deepseek_v32_model.DeepseekV32Model)","+    nn.Module.__init__(model)","+    model.topk_indices_buffer = torch.full((8, 2), -1, dtype=torch.int32)","+    layer = _TopkReusingLayer(model.topk_indices_buffer)","+    model.layers = nn.ModuleList([layer])","+    model.start_layer, model.end_layer = 0, 1","+    model.use_sequence_parallel = False","+    model.aux_hidden_state_layers = ()","+    model.pp_buffers = {\"topk_indices\": model.topk_indices_buffer}","+    monkeypatch.setattr(","+        deepseek_v32_model,","+        \"get_pp_group\",","+        lambda: SimpleNamespace(is_first_rank=False, is_last_rank=False),","+    )","+    monkeypatch.setattr(","+        deepseek_v32_model, \"tensor_model_parallel_all_reduce\", lambda t: t","+    )","+","+    received_topk = torch.arange(6, dtype=torch.int32).view(3, 2)","+    output = model(","+        None,","+        torch.arange(3),","+        IntermediateTensors(","+            {","+                \"hidden_states\": torch.zeros(3, 4),","+                \"topk_indices\": received_topk,","+            }","+        ),","+    )","+","+    torch.testing.assert_close(layer.seen_topk, received_topk)","+    torch.testing.assert_close(output[\"topk_indices\"], received_topk + 10)"],"additions":131,"deletions":0,"truncated":false},{"path":"tests/models/deepseek_v32/test_sequence_parallel.py","lines":["@@ -166,6 +166,7 @@ def test_pp_stage_sends_tp_reduced_residual_stream(monkeypatch):","     model.start_layer, model.end_layer = 0, 1","     model.use_sequence_parallel = False","     model.aux_hidden_state_layers = ()","+    model.pp_buffers = {}"," ","     pp_group = SimpleNamespace(is_first_rank=False, is_last_rank=False)","     monkeypatch.setattr(deepseek_v32_model, \"get_pp_group\", lambda: pp_group)"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/utils.py","lines":["@@ -1042,7 +1042,93 @@ def is_pp_missing_parameter(name: str, model: torch.nn.Module) -> bool:","     )"," "," ","-def make_empty_intermediate_tensors_factory(keys: list[str], hidden_size: int):","+def compute_skip_topk_layers(config: \"PreTrainedConfig\") -> set[int]:","+    \"\"\"Backbone layers that reuse the top-k of the closest preceding indexer","+    layer instead of building their own indexer.\"\"\"","+    if not hasattr(config, \"index_topk\"):","+        return set()","+","+    num_hidden_layers = config.num_hidden_layers","+    indexer_types = getattr(config, \"indexer_types\", None)","+    if indexer_types is not None:","+        if len(indexer_types) != num_hidden_layers:","+            raise ValueError(","+                \"indexer_types must contain one entry per hidden layer: \"","+                f\"expected {num_hidden_layers}, got {len(indexer_types)}.\"","+            )","+        invalid_types = sorted(set(indexer_types) - {\"full\", \"shared\"})","+        if invalid_types:","+            raise ValueError(","+                f\"indexer_types only supports 'full' and 'shared', got {invalid_types}.\"","+            )","+        return {","+            layer_idx","+            for layer_idx, indexer_type in enumerate(indexer_types)","+            if indexer_type == \"shared\"","+        }","+","+    freq = getattr(config, \"index_topk_freq\", 1)","+    if not isinstance(freq, int) or freq <= 0:","+        raise ValueError(f\"index_topk_freq must be a positive integer, got {freq!r}.\")","+    pattern = getattr(config, \"index_topk_pattern\", None)","+    offset = getattr(config, \"index_skip_topk_offset\", 2)","+    skip_layers: set[int] = set()","+    for layer_idx in range(num_hidden_layers):","+        if pattern is None:","+            if max(layer_idx - offset + 1, 0) % freq != 0:","+                skip_layers.add(layer_idx)","+        elif 0 <= layer_idx < len(pattern) and pattern[layer_idx] == \"S\":","+            skip_layers.add(layer_idx)","+    return skip_layers","+","+","+def pp_splits_layer_sharing(","+    num_hidden_layers: int, users: Iterable[int], consumers: set[int]","+) -> bool:","+    \"\"\"Whether a later PP stage's first ``users`` layer is one of ``consumers``,","+    which read state an earlier layer wrote in the same forward pass.\"\"\"","+    from vllm.distributed.parallel_state import get_pp_group","+    from vllm.distributed.utils import get_pp_indices","+","+    users = sorted(users)","+    pp_size = get_pp_group().world_size","+    for rank in range(1, pp_size):","+        start, _ = get_pp_indices(num_hidden_layers, rank, pp_size)","+        if next((layer for layer in users if layer >= start), None) in consumers:","+            return True","+    return False","+","+","+def pp_topk_buffers(","+    config: \"PreTrainedConfig\",","+    topk_indices_buffer: torch.Tensor,","+    topk_layers: Iterable[int],","+) -> dict[str, torch.Tensor]:","+    \"\"\"The shared top-k, if a later PP stage starts on a layer that reuses it.\"\"\"","+    topk_layers = set(topk_layers)","+    skip_layers = compute_skip_topk_layers(config) & topk_layers","+    if pp_splits_layer_sharing(config.num_hidden_layers, topk_layers, skip_layers):","+        return {\"topk_indices\": topk_indices_buffer}","+    return {}","+","+","+def copy_pp_buffers(","+    intermediate_tensors: IntermediateTensors, buffers: Mapping[str, torch.Tensor]","+) -> None:","+    \"\"\"Copy cross-layer state received from the previous PP stage into place.\"\"\"","+    for key, buffer in buffers.items():","+        tensor = intermediate_tensors[key]","+        buffer[: tensor.shape[0]].copy_(tensor)","+","+","+def make_empty_intermediate_tensors_factory(","+    keys: list[str],","+    hidden_size: int,","+    buffers: Mapping[str, torch.Tensor] | None = None,","+):","+    \"\"\"``buffers`` are token-major cross-layer state sent along with ``keys``.\"\"\"","+    buffers = buffers or {}","+","     def make_empty_intermediate_tensors(","         batch_size: int,","         dtype: torch.dtype,","@@ -1053,6 +1139,12 @@ def make_empty_intermediate_tensors(","                 key: torch.zeros((batch_size, hidden_size), dtype=dtype, device=device)","                 for key in keys","             }","+            | {","+                key: torch.zeros(","+                    (batch_size, *buffer.shape[1:]), dtype=buffer.dtype, device=device","+                )","+                for key, buffer in buffers.items()","+            }","         )"," ","     return make_empty_intermediate_tensors"],"additions":93,"deletions":1,"truncated":false},{"path":"vllm/models/deepseek_v32/amd/model.py","lines":["@@ -34,12 +34,14 @@"," )"," from vllm.model_executor.models.utils import (","     PPMissingLayer,","+    copy_pp_buffers,","     extract_layer_index,","     get_fused_shared_expert_layers,","     get_pp_missing_layer_names,","     is_pp_missing_parameter,","     make_empty_intermediate_tensors_factory,","   