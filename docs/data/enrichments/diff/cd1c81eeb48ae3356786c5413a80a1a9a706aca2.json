"+\t\tTypeMeta: metav1.TypeMeta{APIVersion: \"v1\", Kind: \"ConfigMap\"},","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      name,","+\t\t\tNamespace: samlClientCacheNamespace,","+\t\t\tLabels:    configMapLabels,","+\t\t},","+\t\tData: map[string]string{","+\t\t\t\"expiry\": strconv.FormatInt(expiry.Unix(), 10),","+\t\t},","+\t}","+\tconst maxRetries = 3","+\tfor range maxRetries {","+\t\t_, err := s.configMaps.Create(cm)","+\t\tif err == nil {","+\t\t\treturn false, nil","+\t\t}","+\t\tif !apierrors.IsAlreadyExists(err) {","+\t\t\treturn true, err","+\t\t}","+","+\t\t// If the ConfigMap already exists, check if it's expired.","+\t\texisting, err := s.configMaps.Get(samlClientCacheNamespace, name, metav1.GetOptions{})","+\t\tif apierrors.IsNotFound(err) {","+\t\t\t// Deleted between Create and Get; retry.","+\t\t\tcontinue","+\t\t}","+\t\tif err != nil {","+\t\t\treturn true, err","+\t\t}","+\t\tif n, parseErr := strconv.ParseInt(existing.Data[\"expiry\"], 10, 64); parseErr == nil && n <= time.Now().Unix() {","+\t\t\treturn false, nil","+\t\t}","+\t\treturn true, nil","+\t}","+","+\treturn true, fmt.Errorf(\"recording SAML assertion: too many retries\")","+}","+","+func (s *configMapAssertionStore) cleanUpExpiredAssertionIDs(ctx context.Context, c <-chan time.Time) {","+\tfor {","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\treturn","+\t\tcase <-c:","+\t\t\ts.mu.Lock()","+\t\t\tconfigMaps, err := s.configMapCache.List(samlClientCacheNamespace, labels.SelectorFromSet(configMapLabels))","+\t\t\tif err != nil {","+\t\t\t\tlogrus.Errorf(\"[SAML provider] error listing config maps: %v\", err)","+\t\t\t\ts.mu.Unlock()","+\t\t\t\tcontinue","+\t\t\t}","+","+\t\t\tfor _, configMap := range configMaps {","+\t\t\t\tlogrus.Debugf(\"[SAML provider] checking config map %s for expiry\", configMap.Name)","+\t\t\t\tif expiry, parseErr := strconv.ParseInt(configMap.Data[\"expiry\"], 10, 64); parseErr == nil && expiry <= time.Now().Unix() {","+\t\t\t\t\tlogrus.Debugf(\"[SAML provider] deleting expired config map %s\", configMap.Name)","+\t\t\t\t\terr := s.configMaps.Delete(samlClientCacheNamespace, configMap.Name, &metav1.DeleteOptions{})","+\t\t\t\t\tif err != nil {","+\t\t\t\t\t\tlogrus.Errorf(\"[SAML provider] error deleting config map: %v\", err)","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+\t\t\ts.mu.Unlock()","+\t\t}","+\t}","+}","+","+// assertionConfigMapName returns a deterministic, DNS-safe ConfigMap name for an assertion ID.","+func assertionConfigMapName(id string) string {","+\th := sha256.Sum256([]byte(id))","+\treturn \"saml-assertion-\" + hex.EncodeToString(h[:16])","+}","+","+func newConfigMapIDStore(configMaps configMapInterface, cache configMapCacheInterface) *configMapAssertionStore {","+\treturn &configMapAssertionStore{configMaps: configMaps, configMapCache: cache}","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"pkg/auth/providers/saml/saml_id_store_test.go","lines":["@@ -0,0 +1,268 @@","+package saml","+","+import (","+\t\"context\"","+\t\"strconv\"","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/labels\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+)","+","+func TestPerAssertionStorage(t *testing.T) {","+\tt.Parallel()","+","+\tt.Run(\"new ID is not seen\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tstore := newConfigMapIDStore(newFakeConfigMapClient(), nil)","+","+\t\tseen, err := store.seen(\"id-1\", time.Now().Add(time.Minute))","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+\t})","+","+\tt.Run(\"same ID seen twice is a replay\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tstore := newConfigMapIDStore(newFakeConfigMapClient(), nil)","+\t\texpiry := time.Now().Add(time.Minute)","+","+\t\tseen, err := store.seen(\"id-replay\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+","+\t\tseen, err = store.seen(\"id-replay\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.True(t, seen)","+\t})","+","+\tt.Run(\"different IDs are tracked independently\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tstore := newConfigMapIDStore(newFakeConfigMapClient(), nil)","+\t\texpiry := time.Now().Add(time.Minute)","+","+\t\tseen, err := store.seen(\"id-a\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+","+\t\tseen, err = store.seen(\"id-b\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+","+\t\tseen, err = store.seen(\"id-a\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.True(t, seen)","+","+\t\tseen, err = store.seen(\"id-b\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.True(t, seen)","+\t})","+","+\tt.Run(\"each assertion gets its own ConfigMap\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tfake := newFakeConfigMapClient()","+\t\tstore := newConfigMapIDStore(fake, nil)","+\t\texpiry := time.Now().Add(time.Minute)","+","+\t\tstore.seen(\"id-x\", expiry) //nolint:errcheck","+\t\tstore.seen(\"id-y\", expiry) //nolint:errcheck","+","+\t\tfake.mu.Lock()","+\t\tcount := len(fake.configMaps)","+\t\tfake.mu.Unlock()","+\t\tassert.Equal(t, 2, count)","+\t})","+","+\tt.Run(\"expired entry left by a previous process run is replaced, not a replay\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tfake := newFakeConfigMapClient()","+\t\tstore := newConfigMapIDStore(fake, nil)","+","+\t\t// Record an assertion with an already-past expiry.","+\t\tseen, err := store.seen(\"id-stale\", time.Now().Add(-time.Second))","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+","+\t\t// Simulate a restart: create a new store backed by the same storage.","+\t\tstore2 := newConfigMapIDStore(fake, nil)","+","+\t\t// The expiry stored in the ConfigMap has passed; should clean up and treat as fresh.","+\t\tseen, err = store2.seen(\"id-stale\", time.Now().Add(time.Minute))","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+\t})","+","+\tt.Run(\"non-expired assertion survives a process restart\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tfake := newFakeConfigMapClient()","+\t\texpiry := time.Now().Add(time.Minute)","+","+\t\tseen, err := newConfigMapIDStore(fake, nil).seen(\"id-persistent\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.False(t, seen)","+","+\t\t// Simulate restart: new store instance, same backing storage.","+\t\tseen, err = newConfigMapIDStore(fake, nil).seen(\"id-persistent\", expiry)","+\t\trequire.NoError(t, err)","+\t\tassert.True(t, seen)","+\t})","+}","+","+func TestCleanUpExpiredAssertionIDs(t *testing.T) {","+\tnow := time.Now()","+","+\texpiredConfigMap := &corev1.ConfigMap{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName: \"saml-assertion-expired\", Namespace: \"cattle-system\",","+\t\t\tLabels: configMapLabels,","+\t\t},","+\t\tData: map[string]string{","+\t\t\t\"expiry\": strconv.FormatInt(now.Add(-time.Minute).Unix(), 10),","+\t\t},","+\t}","+\tliveConfigMap := &corev1.ConfigMap{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName: \"saml-assertion-live\", Namespace: \"cattle-system\",","+\t\t\tLabels: configMapLabels,","+\t\t},","+\t\tData: map[string]string{","+\t\t\t\"expiry\": strconv.FormatInt(now.Add(time.Minute).Unix(), 10),","+\t\t},","+\t}","+\tnonAssertionConfigMap := &corev1.ConfigMap{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName: \"saml-assertion-non-assertion\", Namespace: \"cattle-system\",","+\t\t},","+\t\tData: map[string]string{","+\t\t\t\"some\": \"value\",","+\t\t},","+\t}","+","+\ttests := map[string]struct {","+\t\tconfigMaps     []*corev1.ConfigMap","+\t\twantConfigMaps map[string]*corev1.ConfigMap","+\t}{","+\t\t\"remove expired sessions\": {","+\t\t\tconfigMaps:     []*corev1.ConfigMap{expiredConfigMap},","+\t\t\twantConfigMaps: map[string]*corev1.ConfigMap{},","+\t\t},","+\t\t\"remove only expired session\": {","+\t\t\tconfigMaps: []*corev1.ConfigMap{expiredConfigMap, liveConfigMap},","+\t\t\twantConfigMaps: map[string]*corev1.ConfigMap{","+\t\t\t\t\"cattle-system/saml-assertion-live\": liveConfigMap,","+\t\t\t},","+\t\t},","+\t\t\"ignores non-assertion config maps\": {","+\t\t\tconfigMaps: []*corev1.ConfigMap{expiredConfigMap, liveConfigMap, nonAssertionConfigMap},","+\t\t\twantConfigMaps: map[string]*corev1.ConfigMap{","+\t\t\t\t\"cattle-system/saml-assertion-live\":          liveConfigMap,","+\t\t\t\t\"cattle-system/saml-assertion-non-assertion\": nonAssertionConfigMap,","+\t\t\t},","+\t\t},","+\t}","+","+\tfor name, tt := range tests {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\tfakeClient := newFakeConfigMapClient(tt.configMaps...)","+\t\t\tstorage := newConfigMapIDStore(fakeClient, &fakeConfigMapCache{configMaps: tt.configMaps})","+\t\t\tctx, cancel := context.WithCancel(t.Context())","+\t\t\tc := make(chan time.Time)","+","+\t\t\tvar wg sync.WaitGroup","+\t\t\twg.Add(1)","+\t\t\tgo func() {","+\t\t\t\tdefer wg.Done()","+\t\t\t\tstorage.cleanUpExpiredAssertionIDs(ctx, c)","+\t\t\t}()","+","+\t\t\tc <- time.Unix(0, 0)","+\t\t\tcancel()","+\t\t\twg.Wait()","+","+\t\t\tassert.Equal(t, tt.wantConfigMaps, fakeClient.configMaps)","+\t\t})","+\t}","+}","+","+func newFakeConfigMapClient(configmaps ...*corev1.ConfigMap) *fakeConfigMapClient {","+\tc := &fakeConfigMapClient{","+\t\tconfigMaps: make(map[string]*corev1.ConfigMap),","+\t}","+","+\tfor _, cm := range configmaps {","+\t\tc.configMaps[cm.Namespace+\"/\"+cm.Name] = cm.DeepCopy()","+\t}","+","+\treturn c","+}","+","+type fakeConfigMapClient struct {","+\tmu         sync.Mutex","+\tconfigMaps map[string]*corev1.ConfigMap","+\tafterGet   func() // called after Get, outside mutex","+}","+","+func (f *fakeConfigMapClient) Create(cm *corev1.ConfigMap) (*corev1.ConfigMap, error) {","+\tf.mu.Lock()","+\tdefer f.mu.Unlock()","+\tif f.configMaps[cm.Namespace+\"/\"+cm.Name] != nil {","+\t\treturn nil, apierrors.NewAlreadyExists(schema.GroupResource{Resource: \"configmaps\"}, cm.Name)","+\t}","+\tcm = cm.DeepCopy()","+\tcm.ResourceVersion = \"1\"","+\tf.configMaps[cm.Namespace+\"/\"+cm.Name] = cm","+","+\treturn cm, nil","+}","+","+func (f *fakeConfigMapClient) Get(namespace, name string, options metav1.GetOptions) (*corev1.ConfigMap, error) {","+\tf.mu.Lock()","+\tcm, ok := f.configMaps[namespace+\"/\"+name]","+\tf.mu.Unlock()","+\tif f.afterGet != nil {","+\t\tf.afterGet()","+\t}","+\tif !ok {","+\t\treturn nil, apierrors.NewNotFound(schema.GroupResource{Resource: \"configmaps\"}, name)","+\t}","+","+\treturn cm, nil","+}","+","+func (f *fakeConfigMapClient) Delete(namespace, name string, options *metav1.DeleteOptions) error {","+\tf.mu.Lock()","+\tdefer f.mu.Unlock()","+\tkey := namespace + \"/\" + name","+\tif _, ok := f.configMaps[key]; !ok {","+\t\treturn apierrors.NewNotFound(schema.GroupResource{Resource: \"configmaps\"}, name)","+\t}","+\tdelete(f.configMaps, key)","+","+\treturn nil","+}","+","+type fakeConfigMapCache struct {","+\tmu         sync.Mutex","+\tconfigMaps []*corev1.ConfigMap","+}","+","+func (f *fakeConfigMapCache) List(namespace string, selector labels.Selector) ([]*corev1.ConfigMap, error) {","+\tf.mu.Lock()","+\tdefer f.mu.Unlock()","+","+\tvar result []*corev1.ConfigMap","+\tfor _, cm := range f.configMaps {","+\t\tif cm.Namespace == namespace && selector.Matches(labels.Set(cm.Labels)) {","+\t\t\tresult = append(result, cm)","+\t\t}","+\t}","+","+\treturn result, nil","+}"],"additions":268,"deletions":0,"truncated":false},{"path":"pkg/auth/providers/saml/saml_provider.go","lines":["@@ -1,10 +1,12 @@"," package saml"," "," import (","+\t\"context\""," \t\"encoding/json\""," \t\"fmt\""," \t\"net/http\""," \t\"strings\"","+\t\"time\""," "," \t\"github.com/crewjam/saml\""," \t\"github.com/pkg/errors\"","@@ -54,29 +56,33 @@ type Provider struct {"," \tsloForced       bool"," "," \tgetSamlConfig  func() (*ap