us-code']);","+        $this->assertEquals(true, $enabledResponse['body']['enabled']);","+        $this->assertEquals('Sender Name', $enabledResponse['body']['options']['fromName']);","+        $this->assertEquals('sender-email@my-domain.com', $enabledResponse['body']['options']['fromEmail']);","+        $this->assertEquals('reply-to@my-domain.com', $enabledResponse['body']['options']['replyToEmail']);","+","+        // Enabling while fromEmail is still empty must be rejected, not silently enabled.","+        $enableWithoutFromEmail = $this->client->call(Client::METHOD_PATCH, '/messaging/providers/bird-email/' . $providerId, $headers, [","+            'enabled' => true,","+        ]);","+","+        $this->assertEquals(400, $enableWithoutFromEmail['headers']['status-code']);","+        $this->assertEquals('provider_missing_credentials', $enableWithoutFromEmail['body']['type']);","+","+        // Enable once fromEmail is supplied; the stored API key is kept.","+        $enableResponse = $this->client->call(Client::METHOD_PATCH, '/messaging/providers/bird-email/' . $providerId, $headers, [","+            'name' => 'BirdEmail2',","+            'fromEmail' => 'sender-email@my-domain.com',","+            'enabled' => true,","+        ]);","+","+        $this->assertEquals(200, $enableResponse['headers']['status-code']);","+        $this->assertEquals('BirdEmail2', $enableResponse['body']['name']);","+        $this->assertEquals(true, $enableResponse['body']['enabled']);","+","+        // Sparse update: change only the sender name, the other options must be preserved.","+        $updateResponse = $this->client->call(Client::METHOD_PATCH, '/messaging/providers/bird-email/' . $providerId, $headers, [","+            'fromName' => 'New Sender',","+        ]);","+","+        $this->assertEquals(200, $updateResponse['headers']['status-code']);","+        $this->assertEquals('New Sender', $updateResponse['body']['options']['fromName']);","+        $this->assertEquals('sender-email@my-domain.com', $updateResponse['body']['options']['fromEmail']);","+        $this->assertEquals(true, $updateResponse['body']['enabled']);","+","+        // Bird's SMS provider shares the provider name, so each route must refuse the other's providers.","+        $smsResponse = $this->client->call(Client::METHOD_POST, '/messaging/providers/bird', $headers, [","+            'providerId' => Id::unique(),","+            'name' => 'BirdSms',","+            'apiKey' => 'bk_eu1_my-apikey',","+            'from' => '+123456789',","+        ]);","+","+        $this->assertEquals(201, $smsResponse['headers']['status-code']);","+        $this->assertEquals('bird', $smsResponse['body']['provider']);","+        $this->assertEquals('sms', $smsResponse['body']['type']);","+","+        $emailThroughSms = $this->client->call(Client::METHOD_PATCH, '/messaging/providers/bird/' . $providerId, $headers, [","+            'from' => '+123456789',","+        ]);","+","+        $this->assertEquals(400, $emailThroughSms['headers']['status-code']);","+        $this->assertEquals('provider_incorrect_type', $emailThroughSms['body']['type']);","+","+        $smsThroughEmail = $this->client->call(Client::METHOD_PATCH, '/messaging/providers/bird-email/' . $smsResponse['body']['$id'], $headers, [","+            'fromEmail' => 'sender-email@my-domain.com',","+        ]);","+","+        $this->assertEquals(400, $smsThroughEmail['headers']['status-code']);","+        $this->assertEquals('provider_incorrect_type', $smsThroughEmail['body']['type']);","+","+        foreach ([$providerId, $enabledResponse['body']['$id'], $smsResponse['body']['$id']] as $id) {","+            $deleteResponse = $this->client->call(Client::METHOD_DELETE, '/messaging/providers/' . $id, $headers);","+            $this->assertEquals(204, $deleteResponse['headers']['status-code']);","+        }","+    }","+","     public function testCreateTopic(): void","     {","         $response1 = $this->client->call(Client::METHOD_POST, 