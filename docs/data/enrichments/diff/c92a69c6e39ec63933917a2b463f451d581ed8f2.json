= 'password'","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"apps/console/tests/unit/template-variable-secret.test.ts","lines":["@@ -0,0 +1,24 @@","+import { describe, expect, test } from 'bun:test'","+import { isTemplateVariableSecret } from '@/lib/template-variables'","+","+describe('isTemplateVariableSecret', () => {","+  test('treats a password input as secret (REDIS_PASSWORD)', () => {","+    expect(isTemplateVariableSecret({ secret: false, type: 'password' })).toBe(","+      true,","+    )","+  })","+","+  test('treats a password input as secret when the server omits the flag (STRIPE_SECRET_KEY)', () => {","+    expect(isTemplateVariableSecret({ type: 'password' })).toBe(true)","+  })","+","+  test('keeps a plain text input readable (REDIS_HOST)', () => {","+    expect(isTemplateVariableSecret({ secret: false, type: 'text' })).toBe(","+      false,","+    )","+  })","+","+  test('honours a catalog that marks a non-password input secret', () => {","+    expect(isTemplateVariableSecret({ secret: true, type: 'text' })).toBe(true)","+  })","+})"],"additions":24,"deletions":0,"truncated":false},{"path":"tests/unit/General/TemplatesTest.php","lines":["@@ -0,0 +1,51 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Tests\\Unit\\General;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\TestCase;","+use Utopia\\Config\\Config;","+","+final class TemplatesTest extends TestCase","+{","+    /**","+     * @return \\Iterator<string, array{string}>","+     */","+    public static function catalogs(): \\Iterator","+    {","+        yield 'functions' => ['templates-function'];","+        yield 'sites' => ['templates-site'];","+    }","+","+    /**","+     * The setup wizards classify a template variable from the catalog entry, so","+     * a credential input left unmarked is stored as a readable variable and","+     * handed back in clear text to anything holding `functions.read` or","+     * `sites.read`.","+     */","+    #[DataProvider('catalogs')]","+    public function testPasswordVariablesAreSecret(string $config): void","+    {","+        $templates = Config::getParam($config, []);","+","+        $this->assertNotEmpty($templates);","+","+        $passwords = 0;","+","+        foreach ($templates as $template) {","+            foreach ($template['variables'] ?? [] as $variable) {","+                if (($variable['type'] ?? '') !== 'password') {","+                    continue;","+                }","+","+                $passwords++;","+","+                $this->assertTrue($variable['secret'] ?? false, ($template['id'] ?? $template['key']) . ': ' . $variable['name']);","+            }","+        }","+","+        $this->assertGreaterThan(0, $passwords);","+    }","+}",""],"additions":51,"deletions":0,"truncated":false}],"additions":157,"deletions":6,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-11T15:39:02.168057+00:00"}