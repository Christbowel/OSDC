the next shared lookup, and the other callers that denial left without an answer join it. When that one is","+     * denied for other credentials too (a denied caller started it first), these credentials ask Comet on their own.","+     */","+    private Mono<Lookup> lookupFor(Caller caller, boolean deniedForOthersBefore) {","+        var lookup = sharedLookup(caller);","+        return lookup.answer().asMono().flatMap(answer -> {","+            if (!(answer instanceof Denied) || caller.credentials().equals(lookup.credentials())) {","+                return Mono.just(answer);","+            }","+            if (deniedForOthersBefore) {","+                return ask(caller);","+            }","+            // The denied lookup leaves the map only after all its waiters got the answer: dropped here, so this","+            // caller starts the next lookup instead of joining the finished one again","+            lookupsInFlight.remove(caller.workspaceId(), lookup);","+            return lookupFor(caller, true);","         });","     }"," ","+    private SharedLookup sharedLookup(Caller caller) {","+        var started = SharedLookup.builder()","+                .credentials(caller.credentials())","+                .answer(Sinks.one())","+                .build();","+        var running = lookupsInFlight.putIfAbsent(caller.workspaceId(), started);","+        if (running != null) {","+            return running;","+        }","+        // Subscribed on its own, not as part of the caller's chain: a caller that goes away (closed connection,","+        // timeout) must not cancel a lookup other callers wait on, or the refresh behind a stale answer","+        Mono.defer(() -> ask(caller))","+                .contextWrite(caller.context())","+                .doFinally(signal -> lookupsInFlight.remove(caller.workspaceId(), started))","+                .subscribe(started.answer()::tryEmitValue, started.answer()::tryEmitError,","+                        started.answer()::tryEmitEm