","+","+import { isObject } from '../../../../../base/common/types.js';","+","+const sandboxCertificateKey = 'vscode.sandboxCertificate';","+export const sandboxCertificateInstallationCapability = 'vscode.sandboxCertificate.install';","+export const sandboxCertificateRotationCapability = 'vscode.sandboxCertificate.rotate';","+export const sandboxCertificateRemovalCapability = 'vscode.sandboxCertificate.remove';","+","+/** Installation requires an explicit host capability, not just a status observation. */","+export function supportsSandboxCertificateInstallation(source: { readonly _meta?: Record<string, unknown> } | undefined): boolean {","+\treturn source?._meta?.[sandboxCertificateInstallationCapability] === true;","+}","+","+export function supportsSandboxCertificateRotation(source: { readonly _meta?: Record<string, unknown> } | undefined): boolean {","+\treturn source?._meta?.[sandboxCertificateRotationCapability] === true;","+}","+","+export function supportsSandboxCertificateRemoval(source: { readonly _meta?: Record<string, unknown> } | undefined): boolean {","+\treturn source?._meta?.[sandboxCertificateRemovalCapability] === true;","+}","+","+/** A host-cached observation, not a requirement to install a certificate or disable sandboxing. */","+export interface IAgentSandboxCertificateStatus {","+\treadonly scopeId: string;","+\treadonly state: 'notRequired' | 'unsupported' | 'notInstalled' | 'installed' | 'error';","+\treadonly canInstall: boolean;","+\treadonly requiresRotation: boolean;","+\treadonly detail?: string;","+}","+","+/** Each chat has its own applicability; chats using the same runtime share a scope ID. */","+export function readAgentSandboxCertificate(source: { readonly _meta?: Record<string, unknown> } | undefined, chat: string): IAgentSandboxCertificateStatus | undefined {","+\tconst entry = readEntries(source?._meta)?.[chat];","+\tif (!isObject(entry)) {","+\t\treturn undefined;","+\t}","+\tconst value = entry as Record<string, unknown>;","+