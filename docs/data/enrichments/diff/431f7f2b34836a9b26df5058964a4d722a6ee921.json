{"id":"431f7f2b34836a9b26df5058964a4d722a6ee921","axis":"silent","repo":"TYPO3/typo3","sha":"431f7f2b34836a9b26df5058964a4d722a6ee921","parsed":{"files":[{"path":"typo3/sysext/core/Documentation/Changelog/14.3.x/Important-109582-ExtensionBrowsingAsksTerDirectly.rst","lines":["@@ -0,0 +1,45 @@","+..  include:: /Includes.rst.txt","+","+..  _important-109582-1789042648:","+","+=========================================================","+Important: #109582 - Extension browsing asks TER directly","+=========================================================","+","+See :issue:`109582`","+","+Description","+===========","+","+The \"Get Extensions\" module answered every listing, search and detail view from","+a local mirror of the TER catalogue: the :file:`extensions.xml.gz` dump, several","+megabytes of it, imported into a database table whenever the editor pressed","+\"Update from TER\". Everything the module showed was therefore as old as the last","+import, and a freshly released extension could not be found at all until someone","+refreshed the list.","+","+The module now asks the TER REST API at `https://extensions.typo3.org/api/v1`","+for what it displays. Listings are fetched one page at a time, searches are","+answered by TER itself, and the catalogue is filtered to the running TYPO3","+version, which the imported list could not do. As long as nothing has been","+published for the running major version yet, extensions for the previous major","+version are listed instead.","+","+Should TER not answer - the installation is offline, a proxy blocks it, the","+service is down or a rate limit was reached - the imported list answers instead.","+Browsing then behaves exactly as it did before, only with older data, and the","+failure is recorded in the log rather than shown as an error. TER is then not","+asked again for five minutes, so an installation without internet access does","+not wait for a timeout on every page. Importing the list therefore keeps working","+and keeps being worthwhile.","+","+Requests carry a :html:`TYPO3/<version>` user agent, and responses are cached","+for an hour in the new :php:`extensionmanager_ter_api` cache, so paging back and","+forth does not produce a request per click.","+","+Downloading an extension is unaffected: the archive is still fetched from the","+file TER stores for it and verified against its SHA-256 hash. Resolving which","+package to download still uses the imported list, so installing an extension","+continues to require it - the module says so when the record is missing.","+","+..  index:: Backend, ext:extensionmanager, NotScanned"],"additions":45,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Controller/DownloadController.php","lines":["@@ -30,6 +30,7 @@"," use TYPO3\\CMS\\Extensionmanager\\Domain\\Model\\PackageIdentifier;"," use TYPO3\\CMS\\Extensionmanager\\Domain\\Repository\\ExtensionRepository;"," use TYPO3\\CMS\\Extensionmanager\\Exception\\ExtensionManagerException;","+use TYPO3\\CMS\\Extensionmanager\\Exception\\ExtensionNotFoundException;"," use TYPO3\\CMS\\Extensionmanager\\Service\\ExtensionManagementService;"," "," /**","@@ -67,7 +68,20 @@ protected function initializeAction(): void","      */","     public function checkDependenciesAction(PackageIdentifier $identifier): ResponseInterface","     {","-        $extension = $this->extensionRepository->getByPackageIdentifier($identifier);","+        try {","+            $extension = $this->extensionRepository->getByPackageIdentifier($identifier);","+        } catch (ExtensionNotFoundException $e) {","+            // The list may show a version the imported list has no record for","+            $this->view->assign('value', [","+                'dependencies' => null,","+                'url' => '',","+                'message' => $e->getMessage(),","+                'hasErrors' => true,","+                'hasDependencies' => false,","+                'title' => $this->translate('extensionList.dependenciesResolveDownloadError.title'),","+            ]);","+            return $this->jsonResponse();","+        }","         $message = '';","         $title = '';","         $hasDependencies = false;","@@ -201,9 +215,8 @@ public function checkDistributionDependenciesAction(PackageIdentifier $identifie","             ], JSON_THROW_ON_ERROR));","         }"," ","-        $extension = $this->extensionRepository->getByPackageIdentifier($identifier);","-","         try {","+            $extension = $this->extensionRepository->getByPackageIdentifier($identifier);","             $dependencyTypes = $this->managementService->getAndResolveDependencies($extension);","             $dependencyErrors = $this->managementService->getDependencyErrors();"," ","@@ -238,8 +251,15 @@ public function checkDistributionDependenciesAction(PackageIdentifier $identifie","      */","     public function installDistributionAction(PackageIdentifier $identifier): ResponseInterface","     {","-        $extension = $this->extensionRepository->getByPackageIdentifier($identifier);","         $this->assertAllowedHttpMethod($this->request, 'POST');","+        try {","+            $extension = $this->extensionRepository->getByPackageIdentifier($identifier);","+        } catch (ExtensionNotFoundException $e) {","+            return $this->jsonResponse(json_encode([","+                'success' => false,","+                'error' => $e->getMessage(),","+            ], JSON_THROW_ON_ERROR));","+        }"," ","         if (!ExtensionManagementUtility::isLoaded('impexp')) {","             return $this->jsonResponse(json_encode(["],"additions":24,"deletions":4,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Domain/FallbackExtensionCatalogue.php","lines":["@@ -0,0 +1,139 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Domain;","+","+use Psr\\Log\\LoggerInterface;","+use TYPO3\\CMS\\Core\\Configuration\\ExtensionConfiguration;","+use TYPO3\\CMS\\Extensionmanager\\Domain\\Model\\Extension;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\ApiRequestFailedException;","+","+/**","+ * Asks a catalogue that reads a remote live, and falls back to one that reads","+ * the locally imported list whenever the remote cannot answer - because the","+ * installation is offline, the remote is down, a proxy blocks it or a rate","+ * limit was reached. With \"offlineMode\" enabled, the remote is not asked at all.","+ *","+ * This is what keeps browsing no worse than it was before the remote was","+ * consulted at all: the imported list stays a complete answer, only an older","+ * one.","+ *","+ * @internal This class is a specific ExtensionManager implementation and is not part of the Public TYPO3 API.","+ */","+readonly class FallbackExtensionCatalogue implements ExtensionCatalogueInterface","+{","+    public function __construct(","+        private ExtensionCatalogueInterface $remoteCatalogue,","+        private ExtensionCatalogueInterface $localCatalogue,","+        private LoggerInterface $logger,","+        private ExtensionConfiguration $extensionConfiguration,","+    ) {}","+","+    public function countAll(): int","+    {","+        return $this->ask(","+            'countAll',","+            fn(): int => $this->remoteCatalogue->countAll(),","+            fn(): int => $this->localCatalogue->countAll()","+        );","+    }","+","+    public function findAll(int $offset, int $limit): array","+    {","+        return $this->ask(","+            'findAll',","+            fn(): array => $this->remoteCatalogue->findAll($offset, $limit),","+            fn(): array => $this->localCatalogue->findAll($offset, $limit)","+        );","+    }","+","+    public function findByTitleOrAuthorNameOrExtensionKey(string $searchString, int $offset, int $limit): array","+    {","+        return $this->ask(","+            'findByTitleOrAuthorNameOrExtensionKey',","+            fn(): array => $this->remoteCatalogue->findByTitleOrAuthorNameOrExtensionKey($searchString, $offset, $limit),","+            fn(): array => $this->localCatalogue->findByTitleOrAuthorNameOrExtensionKey($searchString, $offset, $limit)","+        );","+    }","+","+    public function countByTitleOrAuthorNameOrExtensionKey(string $searchString): int","+    {","+        return $this->ask(","+            'countByTitleOrAuthorNameOrExtensionKey',","+            fn(): int => $this->remoteCatalogue->countByTitleOrAuthorNameOrExtensionKey($searchString),","+            fn(): int => $this->localCatalogue->countByTitleOrAuthorNameOrExtensionKey($searchString)","+        );","+    }","+","+    public function findByExtensionKeyOrderedByVersion(string $extensionKey): array","+    {","+        return $this->ask(","+            'findByExtensionKeyOrderedByVersion',","+            fn(): array => $this->remoteCatalogue->findByExtensionKeyOrderedByVersion($extensionKey),","+            fn(): array => $this->localCatalogue->findByExtensionKeyOrderedByVersion($extensionKey)","+        );","+    }","+","+    public function findOneByCurrentVersionByExtensionKey(string $extensionKey): ?Extension","+    {","+        return $this->ask(","+            'findOneByCurrentVersionByExtensionKey',","+            fn(): ?Extension => $this->remoteCatalogue->findOneByCurrentVersionByExtensionKey($extensionKey),","+            fn(): ?Extension => $this->localCatalogue->findOneByCurrentVersionByExtensionKey($extensionKey)","+        );","+    }","+","+    public function findAllOfficialDistributions(bool $showUnsuitableDistributions = false): array","+    {","+        return $this->ask(","+            'findAllOfficialDistributions',","+            fn(): array => $this->remoteCatalogue->findAllOfficialDistributions($showUnsuitableDistributions),","+            fn(): array => $this->localCatalogue->findAllOfficialDistributions($showUnsuitableDistributions)","+        );","+    }","+","+    public function findAllCommunityDistributions(bool $showUnsuitableDistributions = false): array","+    {","+        return $this->ask(","+            'findAllCommunityDistributions',","+            fn(): array => $this->remoteCatalogue->findAllCommunityDistributions($showUnsuitableDistributions),","+            fn(): array => $this->localCatalogue->findAllCommunityDistributions($showUnsuitableDistributions)","+        );","+    }","+","+    /**","+     * @template T","+     * @param \\Closure(): T $remote","+     * @param \\Closure(): T $local","+     * @return T","+     */","+    private function ask(string $question, \\Closure $remote, \\Closure $local): mixed","+    {","+        if ((bool)$this->extensionConfiguration->get('extensionmanager', 'offlineMode')) {","+            return $local();","+        }","+        try {","+            return $remote();","+        } catch (ApiRequestFailedException $e) {","+            $this->logger->notice(","+                'Answering \"{question}\" from the imported extension list, the remote could not be asked: {reason}',","+                ['question' => $question, 'reason' => $e->getMessage(), 'exception' => $e]","+            );","+            return $local();","+        }","+    }","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Domain/TerExtensionCatalogue.php","lines":["@@ -0,0 +1,185 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Domain;","+","+use TYPO3\\CMS\\Core\\Information\\Typo3Version;","+use TYPO3\\CMS\\Extensionmanager\\Domain\\Model\\Extension;","+use TYPO3\\CMS\\Extensionmanager\\Enum\\ExtensionCategory;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\Dto\\TerExtension;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\TerApiClient;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\TerExtensionMapper;","+","+/**","+ * The TER catalogue, read live through the REST API instead of the weekly","+ * extensions.xml.gz dump imported into the database.","+ *","+ * The extensions handed out keep the \"ter\" remote identifier, so downloading","+ * one still goes through the registered remote for it.","+ *","+ * @internal This class is a specific ExtensionManager implementation and is not part of the Public TYPO3 API.","+ */","+readonly class TerExtensionCatalogue implements ExtensionCatalogueInterface","+{","+    /**","+     * The user every distribution published by the TYPO3 CMS team belongs to.","+     */","+    private const OFFICIAL_DISTRIBUTION_OWNER = 'typo3v4';","+","+    /**","+     * The most the API hands out per page.","+     */","+    private const MAX_PAGE_SIZE = 50;","+","+    public function __construct(","+        private TerApiClient $client,","+        private TerExtensionMapper $mapper,","+        private Typo3Version $typo3Version,","+        private string $remoteIdentifier = 'ter',","+    ) {}","+","+    public function countAll(): int","+    {","+        return $this->client->query('', $this->getMajorVersion(), 1, 1)->totalResults;","+    }","+","+    public function findAll(int $offset, int $limit): array","+    {","+        return $this->toExtensions($this->queryPage('', $offset, $limit));","+    }","+","+    public function findByTitleOrAuthorNameOrExtensionKey(string $searchString, int $offset, int $limit): array","+    {","+        return $this->toExtensions($this->queryPage($searchString, $offset, $limit));","+    }","+","+    public function countByTitleOrAuthorNameOrExtensionKey(string $searchString): int","+    {","+        return $this->client->query($searchString, $this->getMajorVersion(), 1, 1)->totalResults;","+    }","+","+    public function findByExtensionKeyOrderedByVersion(string $extensionKey): array","+    {","+        $remoteExtension = $this->client->getExtension($extensionKey);","+        if ($remoteExtension === null) {","+            return [];","+        }","+        $extensions = [];","+        foreach ($this->client->getVersions($extensionKey) as $version) {","+            if ($version->reviewState < 0) {","+                continue;","+            }","+            $extensions[] = $this->mapper->map($remoteExtension, $version, $this->remoteIdentifier);","+        }","+        return $extensions;","+    }","+","+    public function findOneByCurrentVersionByExtensionKey(string $extensionKey): ?Extension","+    {","+        $remoteExtension = $this->client->getExtension($extensionKey);","+        if ($remoteExtension === null || $remoteExtension->currentVersion === null || $remoteExtension->currentVersion->reviewState < 0) {","+            return null;","+        }","+        return $this->mapper->map($remoteExtension, null, $this->remoteIdentifier);","+    }","+","+    public function findAllOfficialDistributions(bool $showUnsuitableDistributions = false): array","+    {","+        return $this->toExtensions(","+            $this->queryDistributions($showUnsuitableDistributions, self::OFFICIAL_DISTRIBUTION_OWNER)","+        );","+    }","+","+    public function findAllCommunityDistributions(bool $showUnsuitableDistributions = false): array","+    {","+        // The API can filter for an owner but not against one, so the official","+        // distributions are taken out here - they have their own listing.","+        return $this->toExtensions(array_filter(","+            $this->queryDistributions($showUnsuitableDistributions, null),","+            static fn(TerExtension $extension): bool => $extension->owner !== self::OFFICIAL_DISTRIBUTION_OWNER","+        ));","+    }","+","+    /**","+     * @return TerExtension[]","+     */","+    private function queryDistributions(bool $showUnsuitableDistributions, ?string $owner): array","+    {","+        $distributions = [];","+        $page = 1;","+        do {","+            $result = $this->client->query(","+                '',","+                $showUnsuitableDistributions ? 0 : $this->getMajorVersion(),","+                $page++,","+                self::MAX_PAGE_SIZE,","+                ExtensionCategory::Distribution->getStringValue(),","+                $owner","+            );","+            $distributions = [...$distributions, ...$result->extensions];","+        } while ($result->extensions !== [] && count($distributions) < $result->totalResults);","+        return $distributions;","+    }","+","+    /**","+     * The paginator counts in offsets while the API counts in pages, and it only","+     * ever asks for whole pages, so the offset maps onto a page number.","+     *","+     * @return TerExtension[]","+     */","+    private function queryPage(string $search, int $offset, int $limit): array","+    {","+        $limit = max(1, $limit);","+        return $this->client->query(","+            $search,","+            $this->getMajorVersion(),","+            intdiv(max(0, $offset), $limit) + 1,","+            $limit","+        )->extensions;","+    }","+","+    /**","+     * @param TerExtension[] $remoteExtensions","+     * @return Extension[]","+     */","+    private function toExtensions(array $remoteExtensions): array","+    {","+        $extensions = [];","+        foreach ($remoteExtensions as $remoteExtension) {","+            if ($remoteExtension->currentVersion === null || $remoteExtension->currentVersion->reviewState < 0) {","+                continue;","+            }","+            $extensions[] = $this->mapper->map($remoteExtension, null, $this->remoteIdentifier);","+        }","+        return $extensions;","+    }","+","+    /**","+     * Early in a major version's life, and on its development branch, TER has","+     * nothing published for it yet. Offering what fits the previous major version","+     * then beats an empty module. The probe is the same request countAll() sends,","+     * so the response cache answers it after the first time.","+     */","+    private function getMajorVersion(): int","+    {","+        $majorVersion = $this->typo3Version->getMajorVersion();","+        if ($this->client->query('', $majorVersion, 1, 1)->totalResults === 0) {","+            return $majorVersion - 1;","+        }","+        return $majorVersion;","+    }","+}"],"additions":185,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/ApiRequestFailedException.php","lines":["@@ -0,0 +1,31 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Remote;","+","+use TYPO3\\CMS\\Extensionmanager\\Exception\\ExtensionManagerException;","+","+/**","+ * A remote API could not answer a question: it was unreachable, refused the","+ * request, ran into a rate limit or replied with something unusable.","+ *","+ * This says nothing about the answer itself. A remote that reports \"no such","+ * extension\" or \"no results\" has answered, and does not throw.","+ *","+ * @internal This class is a specific ExtensionManager implementation and is not part of the Public TYPO3 API.","+ */","+class ApiRequestFailedException extends ExtensionManagerException {}"],"additions":31,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/Dto/TerAuthor.php","lines":["@@ -0,0 +1,42 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Remote\\Dto;","+","+/**","+ * Value object mirroring the \"author\" schema of the TER REST API.","+ *","+ * @internal This class is not part of the Public TYPO3 API.","+ */","+final readonly class TerAuthor","+{","+    public function __construct(","+        public string $name = '',","+        public string $email = '',","+    ) {}","+","+    public static function fromArray(?array $data): ?self","+    {","+        if (!is_array($data) || $data === []) {","+            return null;","+        }","+        return new self(","+            name: (string)($data['name'] ?? ''),","+            email: (string)($data['email'] ?? ''),","+        );","+    }","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/Dto/TerExtension.php","lines":["@@ -0,0 +1,51 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Remote\\Dto;","+","+/**","+ * Value object mirroring the top-level \"extension\" schema of the TER REST API.","+ *","+ * @internal This class is not part of the Public TYPO3 API.","+ */","+final readonly class TerExtension","+{","+    public function __construct(","+        public string $key,","+        public string $owner = '',","+        public int $downloads = 0,","+        public string $composerName = '',","+        public string $documentationLink = '',","+        public ?TerExtensionVersion $currentVersion = null,","+    ) {}","+","+    public static function fromArray(?array $data): ?self","+    {","+        if (!is_array($data) || !isset($data['key'])) {","+            return null;","+        }","+        $meta = is_array($data['meta'] ?? null) ? $data['meta'] : [];","+        return new self(","+            key: (string)$data['key'],","+            owner: (string)($data['owner'] ?? ''),","+            downloads: (int)($data['downloads'] ?? 0),","+            composerName: (string)($meta['composer_name'] ?? ''),","+            documentationLink: (string)($meta['external_manual'] ?? ''),","+            currentVersion: TerExtensionVersion::fromArray(is_array($data['current_version'] ?? null) ? $data['current_version'] : null),","+        );","+    }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/Dto/TerExtensionListResult.php","lines":["@@ -0,0 +1,49 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Remote\\Dto;","+","+/**","+ * Result of a paginated extension listing / search against the TER REST API.","+ *","+ * @internal This class is not part of the Public TYPO3 API.","+ */","+final readonly class TerExtensionListResult","+{","+    /**","+     * @param TerExtension[] $extensions the extensions on the requested page","+     */","+    public function __construct(","+        public int $totalResults,","+        public array $extensions = [],","+    ) {}","+","+    public static function fromArray(array $data): self","+    {","+        $extensions = [];","+        foreach ((is_array($data['extensions'] ?? null) ? $data['extensions'] : []) as $extensionData) {","+            $extension = TerExtension::fromArray(is_array($extensionData) ? $extensionData : null);","+            if ($extension !== null) {","+                $extensions[] = $extension;","+            }","+        }","+        return new self(","+            totalResults: (int)($data['results'] ?? count($extensions)),","+            extensions: $extensions,","+        );","+    }","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/Dto/TerExtensionVersion.php","lines":["@@ -0,0 +1,81 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Remote\\Dto;","+","+/**","+ * Value object mirroring the \"version\" schema of the TER REST API.","+ *","+ * @internal This class is not part of the Public TYPO3 API.","+ */","+final readonly class TerExtensionVersion","+{","+    /**","+     * @param array<string, string> $dependencies map of extension key => version constraint","+     * @param array<string, string> $conflicts map of extension key => version constraint","+     */","+    public function __construct(","+        public string $number,","+        public string $title = '',","+        public string $description = '',","+        public string $uploadComment = '',","+        public string $state = '',","+        public string $category = '',","+        public array $dependencies = [],","+        public array $conflicts = [],","+        public int $uploadDate = 0,","+        public int $reviewState = 0,","+        public ?TerAuthor $author = null,","+        public string $artifactSha256 = '',","+    ) {}","+","+    public static function fromArray(?array $data): ?self","+    {","+        if (!is_array($data) || !isset($data['number'])) {","+            return null;","+        }","+        return new self(","+            number: (string)$data['number'],","+            title: (string)($data['title'] ?? ''),","+            description: (string)($data['description'] ?? ''),","+            uploadComment: (string)($data['upload_comment'] ?? ''),","+            state: (string)($data['state'] ?? ''),","+            category: (string)($data['category'] ?? ''),","+            dependencies: self::normalizeConstraints($data['dependencies'] ?? null),","+            conflicts: self::normalizeConstraints($data['conflicts'] ?? null),","+            uploadDate: (int)($data['upload_date'] ?? 0),","+            reviewState: (int)($data['review_state'] ?? 0),","+            author: TerAuthor::fromArray(is_array($data['author'] ?? null) ? $data['author'] : null),","+            artifactSha256: (string)($data['artifact_sha256'] ?? ''),","+        );","+    }","+","+    /**","+     * @return array<string, string>","+     */","+    private static function normalizeConstraints(mixed $constraints): array","+    {","+        if (!is_array($constraints)) {","+            return [];","+        }","+        $normalized = [];","+        foreach ($constraints as $key => $constraint) {","+            $normalized[(string)$key] = (string)$constraint;","+        }","+        return $normalized;","+    }","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/TerApiClient.php","lines":["@@ -0,0 +1,213 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Remote;","+","+use Psr\\Http\\Message\\ResponseInterface;","+use TYPO3\\CMS\\Core\\Cache\\Frontend\\FrontendInterface;","+use TYPO3\\CMS\\Core\\Http\\RequestFactory;","+use TYPO3\\CMS\\Core\\Information\\Typo3Version;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\Dto\\TerExtension;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\Dto\\TerExtensionListResult;","+use TYPO3\\CMS\\Extensionmanager\\Remote\\Dto\\TerExtensionVersion;","+","+/**","+ * Connector to the TER REST API at https://extensions.typo3.org/api/v1.","+ *","+ * Reads the catalogue live, without the local mirror of extensions.xml.gz.","+ * Downloading is not its business: an extension is fetched 