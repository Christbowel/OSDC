{"id":"cbe3ee731efd7546784e1decac20d72dde391455","axis":"silent","repo":"salvo-rs/salvo","sha":"cbe3ee731efd7546784e1decac20d72dde391455","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -115,6 +115,8 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).","   hoops and lifecycle hooks run, and reject malformed override headers."," - Reject malformed CSRF bcrypt proofs and costs that differ from the configured cost before","   verification, require bcrypt 0.19.2 or newer, and omit CSRF cipher keys from debug output.","+- Reissue invalid session-backed CSRF proofs on safe requests after cipher key","+  or token-size changes, instead of indefinitely reusing unusable tokens."," - Replace all depot JWT authentication results on each attempt so missing or","   rejected credentials cannot retain another middleware instance's claims/token,","   and successful authentication cannot retain an earlier error."],"additions":2,"deletions":0,"truncated":false},{"path":"crates/csrf/src/session_store.rs","lines":["@@ -4,6 +4,10 @@ use salvo_session::SessionDepotExt;"," use super::{CsrfCipher, CsrfStore};"," "," /// A `CsrfStore` implementation that stores the CSRF proof in a session.","+///","+/// Stored proofs are checked with the current cipher before reuse. An invalid","+/// proof is treated as missing, allowing a safe request to issue a fresh token","+/// after a key or token-format change; unsafe requests still require a valid pair."," #[derive(Debug)]"," pub struct SessionStore {","     name: String,","@@ -26,11 +30,12 @@ impl SessionStore {"," "," impl CsrfStore for SessionStore {","     type Error = Error;","-    async fn load<C: CsrfCipher>(&self, _req: &mut Request, depot: &mut Depot, _cipher: &C) -> Option<(String, String)> {","+    async fn load<C: CsrfCipher>(&self, _req: &mut Request, depot: &mut Depot, cipher: &C) -> Option<(String, String)> {","         depot","             .session()","             .and_then(|s| s.get::<String>(&self.name))","-            .and_then(|s| s.split_once('.').map(|(t, p)| (t.into(), p.into())))","+            .and_then(|s| s.split_once('.').map(|(t, p)| (t.to_owned(), p.to_owned())))","+            .filter(|(token, proof)| cipher.verify(token, proof))","     }","     async fn save(","         &self,"],"additions":7,"deletions":2,"truncated":false},{"path":"crates/csrf/tests/session_key_rotation.rs","lines":["@@ -0,0 +1,88 @@","+//! Session-backed CSRF tokens must be reissued after their proof becomes invalid.","+","+#![cfg(all(feature = \"session-store\", feature = \"hmac-cipher\"))]","+","+use salvo_core::prelude::*;","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_csrf::{Csrf, CsrfDepotExt, HeaderFinder, HmacCipher};","+use salvo_session::{MemoryStore, SessionHandler};","+","+#[handler]","+async fn token(depot: &mut Depot) -> String {","+    depot.csrf_token().unwrap().to_owned()","+}","+","+#[handler]","+async fn accepted() -> &'static str {","+    \"accepted\"","+}","+","+fn service(store: MemoryStore, cipher: HmacCipher) -> Service {","+    Service::new(","+        Router::new()","+            .hoop(SessionHandler::builder(store, &[42; 64]).build().unwrap())","+            .hoop(Csrf::new(","+                cipher,","+                salvo_csrf::SessionStore::new(),","+                HeaderFinder::new(\"x-csrf-token\"),","+            ))","+            .get(token)","+            .post(accepted),","+    )","+}","+","+#[tokio::test]","+async fn safe_request_recovers_session_token_after_cipher_configuration_changes() {","+    for (old_cipher, new_cipher) in [","+        (HmacCipher::new([1; 32]), HmacCipher::new([2; 32])),","+        (","+            HmacCipher::new([1; 32]),","+            HmacCipher::new([1; 32]).token_size(16),","+        ),","+    ] {","+        let store = MemoryStore::new();","+        let old_service = service(store.clone(), old_cipher);","+        let mut first = TestClient::get(\"http://localhost/\")","+            .send(&old_service)","+            .await;","+        let old_cookie = format!(","+            \"salvo.session.id={}\",","+            first.cookie(\"salvo.session.id\").unwrap().value()","+        );","+        let old_token = first.take_string().await.unwrap();","+","+        let new_service = service(store, new_cipher);","+        // An old proof must not authorize an unsafe request under the new key.","+        let rejected = TestClient::post(\"http://localhost/\")","+            .add_header(\"cookie\", old_cookie.clone(), true)","+            .add_header(\"x-csrf-token\", old_token.clone(), true)","+            .send(&new_service)","+            .await;","+        assert_eq!(rejected.status_code, Some(StatusCode::FORBIDDEN));","+","+        let mut refreshed = TestClient::get(\"http://localhost/\")","+            .add_header(\"cookie\", old_cookie.clone(), true)","+            .send(&new_service)","+            .await;","+        assert_eq!(refreshed.status_code, Some(StatusCode::OK));","+        let cookie = refreshed","+            .cookie(\"salvo.session.id\")","+            .map(|cookie| format!(\"salvo.session.id={}\", cookie.value()))","+            .unwrap_or(old_cookie);","+        let new_token = refreshed.take_string().await.unwrap();","+        assert_ne!(new_token, old_token, \"safe request reused an invalid proof\");","+","+        let response = TestClient::post(\"http://localhost/\")","+            .add_header(\"cookie\", cookie.clone(), true)","+            .add_header(\"x-csrf-token\", new_token.clone(), true)","+            .send(&new_service)","+            .await;","+        assert_eq!(response.status_code, Some(StatusCode::OK));","+","+        let mut stable = TestClient::get(\"http://localhost/\")","+            .add_header(\"cookie\", cookie, true)","+            .send(&new_service)","+            .await;","+        assert_eq!(stable.take_string().await.unwrap(), new_token);","+    }","+}",""],"additions":88,"deletions":0,"truncated":false}],"additions":97,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-29T15:20:44.872102+00:00"}