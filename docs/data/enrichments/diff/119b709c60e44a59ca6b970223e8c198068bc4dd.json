{"id":"119b709c60e44a59ca6b970223e8c198068bc4dd","axis":"silent","repo":"nrwl/nx","sha":"119b709c60e44a59ca6b970223e8c198068bc4dd","parsed":{"files":[{"path":"astro-docs/src/content/docs/kb/browser-support.mdoc","lines":["@@ -6,11 +6,23 @@ topics:","   - 'Recipes'"," ---"," ","-The official Nx plugins rely on [browserslist](https://github.com/browserslist/browserslist) for configuring application browser support. This affects builds, both production and development, and will decide on which transformations will be run on the code when built.","+Builds that use [browserslist](https://github.com/browserslist/browserslist), such as `@nx/rspack` web builds, read your application's browser support from it.","+It decides which transformations run on your code in both production and development builds.","+","+Vite doesn't read browserslist.","+Set [`build.target`](https://vite.dev/config/build-options#build-target) in your Vite config instead."," "," In general, the more modern your applications browser support is, the smaller the filesize as the code can rely on modern API's being present and not have to ship polyfills or shimmed code."," ","-By default, applications generated from official Nx generators ship an aggressively modern browser support config, in the form of a `.browserslistrc` file in the root of the application with the following contents.","+Nx generators don't create a browserslist config.","+To add one, use either of these options:","+","+- Create a `.browserslistrc` file in the project root.","+- Add a `browserslist` key to the project's `package.json`.","+","+Browserslist also looks in parent directories, so a config in the workspace root applies to every project that doesn't have its own.","+","+For example, the following `.browserslistrc` supports only recent browser versions."," "," ```text"," last 1 Chrome version","@@ -33,23 +45,27 @@ Sometimes broad configurations like `> 0.5%, not IE 11` can lead to surprising r"," To see what browsers your configuration is supporting, run `npx browserslist` in the application's directory to get an output of browsers and versions to support."," "," ```text {% title=\"npx browserslist\" frame=\"terminal\" %}","-and_chr 61","-chrome 83","-edge 83","-edge 81","-firefox 78","-firefox 68","-ie 11","-ios_saf 13.4-13.5","-ios_saf 13.3","-ios_saf 13.2","-ios_saf 13.0-13.1","-ios_saf 12.2-12.4","-ios_saf 12.0-12.1","-safari 13.1","-safari 13","-safari 12.1","-safari 12","+chrome 154","+edge 154","+edge 153","+firefox 157","+firefox 153","+ios_saf 27.0","+ios_saf 26.6","+ios_saf 26.5","+ios_saf 26.4","+ios_saf 26.3","+ios_saf 26.2","+ios_saf 26.1","+ios_saf 26.0","+safari 27","+safari 26.6","+safari 26.5","+safari 26.4","+safari 26.3","+safari 26.2","+safari 26.1","+safari 26.0"," ```"," "," Alternatively, if your support config is short you can just add it as a string param on the CLI:"],"additions":35,"deletions":19,"truncated":false},{"path":"packages/rspack/src/plugins/nx-app-rspack-plugin/nx-app-rspack-plugin.browserslist.spec.ts","lines":["@@ -0,0 +1,232 @@","+import { rspack, type Configuration } from '@rspack/core';","+import {","+  mkdirSync,","+  mkdtempSync,","+  readFileSync,","+  rmSync,","+  writeFileSync,","+} from 'fs';","+import { tmpdir } from 'os';","+import { join } from 'path';","+import { NxAppRspackPlugin } from './nx-app-rspack-plugin';","+","+vi.mock('../utils/plugins/normalize-options', () => ({","+  normalizeOptions: (options) => options,","+}));","+","+describe('NxAppRspackPlugin browserslist support', () => {","+  let root: string;","+","+  beforeEach(() => {","+    root = mkdtempSync(join(tmpdir(), 'nx-rspack-browserslist-'));","+    mkdirSync(join(root, 'src'));","+    writeFileSync(","+      join(root, 'src/main.ts'),","+      `import './styles.css';\\nconsole.log(Number(globalThis.x) ** 2);\\n`","+    );","+    writeFileSync(join(root, 'src/styles.css'), '.a { user-select: none; }\\n');","+    mkdirSync(join(root, 'node_modules/browserslist-config-test'), {","+      recursive: true,","+    });","+    writeFileSync(","+      join(root, 'node_modules/browserslist-config-test/index.js'),","+      `module.exports = ['last 1 chrome version'];`","+    );","+    global.NX_GRAPH_CREATION = false;","+  });","+","+  afterEach(() => {","+    vi.restoreAllMocks();","+    delete global.NX_GRAPH_CREATION;","+    rmSync(root, { recursive: true, force: true });","+  });","+","+  async function build(","+    target: Configuration['target'],","+    mode: Configuration['mode'] = 'production'","+  ) {","+    const compiler = rspack({","+      mode,","+      target,","+      output: { path: join(root, 'dist') },","+      plugins: [","+        new NxAppRspackPlugin({","+          root,","+          projectRoot: '.',","+          main: 'src/main.ts',","+          index: 'src/index.html',","+          mode,","+          optimization: true,","+          outputHashing: 'none',","+          externalDependencies: 'none',","+          generateIndexHtml: false,","+          typeCheckOptions: false,","+          useTsconfigPaths: false,","+          progress: false,","+        } as ConstructorParameters<typeof NxAppRspackPlugin>[0]),","+      ],","+    });","+    await new Promise<void>((resolve, reject) =>","+      compiler.run((err, stats) =>","+        compiler.close((closeErr) => {","+          if (err || closeErr) {","+            reject(err ?? closeErr);","+          } else if (stats.hasErrors()) {","+            reject(new Error(stats.toString({ errors: true, all: false })));","+          } else {","+            resolve();","+          }","+        })","+      )","+    );","+  }","+","+  it.each([","+    {","+      name: 'the default targets without a browserslist config',","+      browserslist: null,","+      script: 'Math.pow(',","+      style: '-webkit-user-select:none',","+    },","+    {","+      name: 'the browsers in a browserslist query',","+      browserslist: 'last 1 chrome version',","+      script: '**2',","+      style: '.a{user-select:none}',","+    },","+    {","+      name: 'the browsers in an extended browserslist config',","+      browserslist: 'extends browserslist-config-test',","+      script: '**2',","+      style: '.a{user-select:none}',","+    },","+    {","+      name: 'Safari Technology Preview',","+      browserslist: 'safari TP',","+      script: '**2',","+      style: '.a{user-select:none}',","+    },","+    {","+      name: 'the browsers in a browserslist config with the browserslist target',","+      browserslist: 'last 1 chrome version',","+      target: 'browserslist' as const,","+      script: '**2',","+      style: '.a{user-select:none}',","+    },","+    {","+      name: 'the browsers in a browserslist target query',","+      browserslist: null,","+      target: 'browserslist:last 1 chrome version' as const,","+      script: '**2',","+      style: '.a{user-select:none}',","+    },","+  ])(","+    'builds web apps for $name',","+    async ({ browserslist, target = 'web' as const, script, style }) => {","+      if (browserslist) {","+        writeFileSync(join(root, '.browserslistrc'), browserslist);","+      }","+","+      await build(target);","+","+      expect(readFileSync(join(root, 'dist/main.js'), 'utf8')).toContain(","+        script","+      );","+      expect(readFileSync(join(root, 'dist/main.css'), 'utf8')).toContain(","+        style","+      );","+    }","+  );","+","+  it.each([","+    {","+      name: 'the default browserslist query',","+      browserslist: 'defaults',","+      script: '**2',","+    },","+    {","+      name: 'the oldest version of browsers that share a swc name',","+      browserslist: 'op_mob 12.1, opera 100',","+      script: 'Math.pow(',","+    },","+  ])('compiles scripts for $name', async ({ browserslist, script }) => {","+    writeFileSync(join(root, '.browserslistrc'), browserslist);","+","+    await build('web');","+","+    expect(readFileSync(join(root, 'dist/main.js'), 'utf8')).toContain(script);","+  });","+","+  it.each([","+    {","+      name: 'the browsers in a browserslist config',","+      browserslist: 'ie 11',","+      style: /\\{\\s*-ms-user-select: none;\\s*user-select: none;\\s*\\}/,","+    },","+    {","+      name: 'apps without a browserslist config',","+      browserslist: null,","+      style: /\\{\\s*user-select: none;\\s*\\}/,","+    },","+  ])(","+    'builds CSS modules in development for $name',","+    async ({ browserslist, style }) => {","+      writeFileSync(","+        join(root, 'src/main.ts'),","+        `import styles from './app.module.css';\\nconsole.log(styles);\\n`","+      );","+      writeFileSync(","+        join(root, 'src/app.module.css'),","+        '.a { user-select: none; }\\n'","+      );","+      if (browserslist) {","+        writeFileSync(join(root, '.browserslistrc'), browserslist);","+      }","+","+      await build('web', 'development');","+","+      expect(readFileSync(join(root, 'dist/main.css'), 'utf8')).toMatch(style);","+    }","+  );","+","+  it('builds web apps when rspack returns nothing from its defaults', async () => {","+    const applyDefaults = rspack.config.applyRspackOptionsDefaults;","+    vi.spyOn(rspack.config, 'applyRspackOptionsDefaults').mockImplementation(","+      (options) => {","+        applyDefaults(options);","+        // Rspack 1.6 and earlier return nothing.","+        return undefined;","+      }","+    );","+","+    await build('web');","+","+    expect(readFileSync(join(root, 'dist/main.css'), 'utf8')).toContain(","+      'user-select:none'","+    );","+  });","+","+  it('writes the rspack runtime for the browsers in a browserslist config', async () => {","+    writeFileSync(join(root, '.browserslistrc'), 'ie 11');","+","+    await build('web');","+","+    expect(readFileSync(join(root, 'dist/runtime.js'), 'utf8')).not.toContain(","+      '=>'","+    );","+  });","+","+  it('does not apply a browserslist config to node builds', async () => {","+    writeFileSync(","+      join(root, 'src/main.ts'),","+      'console.log(Number(globalThis.x) ** 2);\\n'","+    );","+    writeFileSync(join(root, '.browserslistrc'), 'last 1 chrome version');","+","+    await build('node');","+","+    expect(readFileSync(join(root, 'dist/main.js'), 'utf8')).toContain(","+      'Math.pow('","+    );","+  });","+});"],"additions":232,"deletions":0,"truncated":false},{"path":"packages/rspack/src/plugins/nx-app-rspack-plugin/nx-app-rspack-plugin.ts","lines":["@@ -1,4 +1,4 @@","-import type { Compiler } from '@rspack/core';","+import type { Compiler, Configuration } from '@rspack/core';"," import type {","   NormalizedNxAppRspackPluginOptions,","   NxAppRspackPluginOptions,","@@ -7,6 +7,7 @@ import { normalizeOptions } from '../utils/plugins/normalize-options';"," import { READY_SIGNAL_PLUGIN } from '../../utils/dev-server-ready-signal';"," import { applyBaseConfig } from '../utils/apply-base-config';"," import { applyWebConfig } from '../utils/apply-web-config';","+import { loadRspackCore } from '../../utils/load-rspack-core';"," "," /**","  * This plugin provides features to build Node and Web applications.","@@ -15,7 +16,7 @@ import { applyWebConfig } from '../utils/apply-web-config';","  * - Stylesheets handling","  * - index.html and package.json generation","  *","- * Web-only features, such as stylesheets and images, are only supported when `target` is `web` or `webworker`.","+ * Web-only features, such as stylesheets and images, are only supported when `target` runs in a browser, such as `web`, `webworker` or `browserslist`.","  */"," export class NxAppRspackPlugin {","   private readonly options: NormalizedNxAppRspackPluginOptions;","@@ -59,11 +60,7 @@ export class NxAppRspackPlugin {","       this.options.target = compiler.options.target;","     }"," ","-    if (","-      this.options.target === 'web' ||","-      this.options.target === 'webworker' ||","-      this.options.ssr","-    ) {","+    if (isBrowserTarget(compiler, this.options.target) || this.options.ssr) {","       applyWebConfig(this.options, compiler.options, {","         useNormalizedEntry: true,","         compiler,","@@ -71,3 +68,20 @@ export class NxAppRspackPlugin {","     }","   }"," }","+","+// Let rspack resolve the platform so `browserslist` targets count by the browsers they list.","+function isBrowserTarget(compiler: Compiler, target: string | string[]) {","+  const { config } = loadRspackCore(compiler);","+  const options = config.getNormalizedRspackOptions({","+    context: compiler.options.context,","+    target: target as Configuration['target'],","+    // Rspack throws for targets without a default chunk format, such as `es2020`.","+    output: { chunkFormat: false },","+  });","+  // Read the applied defaults: rspack 1.6 and earlier return nothing from this call.","+  config.applyRspackOptionsDefaults(options);","+  return (","+    options.externalsPresets.web === true &&","+    options.externalsPresets.node === false","+  );","+}"],"additions":21,"deletions":7,"truncated":false},{"path":"packages/rspack/src/plugins/utils/apply-base-config.ts","lines":["@@ -18,6 +18,10 @@ import { GeneratePackageJsonPlugin } from './plugins/generate-package-json-plugi"," import { getOutputHashFormat } from './hash-format';"," import { NxTsconfigPathsRspackPlugin } from './plugins/nx-tsconfig-paths-rspack-plugin';"," import { getTerserEcmaVersion } from './get-terser-ecma-version';","+import {","+  getBrowserslistTargets,","+  getUnsupportedEnvironmentFeatures,","+} from './get-browserslist-targets';"," import nodeExternals = require('webpack-node-externals');"," import { NormalizedNxAppRspackPluginOptions } from './models';"," import { isUsingTsSolutionSetup } from '@nx/js/internal';","@@ -513,6 +517,25 @@ function applyNxDependentConfig(","         cache,","       }).cache","     : cache;","+  const projectRoot = path.join(options.root, options.projectRoot);","+  const browserslistTargets = getBrowserslistTargets(","+    config.target,","+    projectRoot","+  );","+  if (browserslistTargets) {","+    // For `web`, rspack writes its runtime code with arrow functions and other modern syntax.","+    config.output = {","+      ...config.output,","+      environment: {","+        ...getUnsupportedEnvironmentFeatures(","+          rspackCore,","+          projectRoot,","+          browserslistTargets.queries","+        ),","+        ...config.output?.environment,","+      },","+    };","+  }","   config.module = {","     ...config.module,","     rules: [","@@ -548,6 +571,9 @@ function applyNxDependentConfig("," ","         type: 'javascript/auto',","         options: {","+          ...(browserslistTargets","+            ? { env: { targets: browserslistTargets.swc } }","+            : {}),","           jsc: {","             parser: {","               syntax: 'typescript',"],"additions":26,"deletions":0,"truncated":false},{"path":"packages/rspack/src/plugins/utils/apply-web-config.ts","lines":["@@ -8,6 +8,7 @@ import type {"," } from '@rspack/core';"," import { join, resolve } from 'path';"," import { WriteIndexHtmlPlugin } from '../write-index-html-plugin';","+import { getBrowserslistTargets } from './get-browserslist-targets';"," import { getOutputHashFormat } from './hash-format';"," import { instantiateScriptPlugins } from './instantiate-script-plugins';"," import {","@@ -112,11 +113,17 @@ export function applyWebConfig(","     }","   }"," ","+  const browserslistQueries = getBrowserslistTargets(","+    config.target,","+    join(options.root, options.projectRoot)","+  )?.queries;","+","   const minimizer: RspackPluginInstance[] = [];","   if (isProd && stylesOptimization) {","     minimizer.push(","       new LightningCssMinimizerRspackPlugin({","         test: /\\.(?:css|scss|sass|less)$/,","+        minimizerOptions: { targets: browserslistQueries },","       })","     );","   }","@@ -169,7 +176,8 @@ export function applyWebConfig(","       use: getCommonLoadersForCssModules(","         options,","         includePaths,","-        cssExtractLoader","+        cssExtractLoader,","+        browserslistQueries","       ),","     },","     {","@@ -179,7 +187,8 @@ export function applyWebConfig(","         ...getCommonLoadersForCssModules(","           options,","           includePaths,","-          cssExtractLoader","+          cssExtractLoader,","+          browserslistQueries","         ),","         {","           loader: require.resolve('sass-loader'),","@@ -203,7 +212,8 @@ export function applyWebConfig(","         ...getCommonLoadersForCssModules(","           options,","           includePaths,","-          cssExtractLoader","+          cssExtractLoader,","+          browserslistQueries","         ),","         {","           loader: join(__dirname, 'loaders/deprecated-less-loader.js'),","@@ -225,7 +235,8 @@ export function applyWebConfig(","       use: getCommonLoadersForGlobalCss(","         options,","         includePaths,","-        cssExtractLoader","+        cssExtractLoader,","+        browserslistQueries","       ),","     },","     {","@@ -235,7 +246,8 @@ export function applyWebConfig(","         ...getCommonLoadersForGlobalCss(","           options,","           includePaths,","-          cssExtractLoader","+          cssExtractLoader,","+          browserslistQueries","         ),","         {","           loader: require.resolve('sass-loader'),","@@ -261,7 +273,8 @@ export function applyWebConfig(","         ...getCommonLoadersForGlobalCss(","           options,","           includePaths,","-          cssExtractLoader","+          cssExtractLoader,","+          browserslistQueries","         ),","         {","           loader: join(__dirname, 'loaders/deprecated-less-loader.js'),","@@ -285,7 +298,8 @@ export function applyWebConfig(","       use: getCommonLoadersForGlobalStyle(","         options,","         includePaths,","-        cssExtractLoader","+        cssExtractLoader,","+        browserslistQueries","       ),","     },","     {","@@ -295,7 +309,8 @@ export function applyWebConfig(","         ...getCommonLoadersForGlobalStyle(","           options,","           includePaths,","-          cssExtractLoader","+          cssExtractLoader,","+          browserslistQueries","         ),","         {","           loader: require.resolve('sass-loader'),","@@ -321,7 +336,8 @@ export function applyWebConfig(","         ...getCommonLoadersForGlobalStyle(","           options,","           includePaths,","-          cssExtractLoader","+          cssExtractLoader,","+          browserslistQueries","         ),","         {","           loader: join(__dirname, 'loaders/deprecated-less-loader.js'),"],"additions":25,"deletions":9,"truncated":false},{"path":"packages/rspack/src/plugins/utils/get-browserslist-targets.spec.ts","lines":["@@ -0,0 +1,68 @@","+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'fs';","+import { tmpdir } from 'os';","+import { join } from 'path';","+import type { Configuration } from '@rspack/core';","+import { getBrowserslistTargets } from './get-browserslist-targets';","+","+describe('getBrowserslistTargets', () => {","+  const root = mkdtempSync(join(tmpdir(), 'nx-browserslist-targets-'));","+","+  beforeAll(() => {","+    writeFileSync(","+      join(root, '.browserslistrc'),","+      'chrome 110\\n\\n[modern]\\nchrome 120\\n'","+    );","+    mkdirSync(join(root, 'config'));","+    writeFileSync(","+      join(root, 'config/.browserslistrc'),","+      'firefox 110\\n\\n[modern]\\nfirefox 120\\n'","+    );","+  });","+","+  afterAll(() => {","+    rmSync(root, { recursive: true, force: true });","+  });","+","+  it.each<{","+    name: string;","+    target: Configuration['target'];","+    browser: string;","+    version: string;","+  }>([","+    {","+      name: 'a query',","+      target: 'browserslist:chrome 100',","+      browser: 'chrome',","+      version: '100',","+    },","+    {","+      name: 'an environment of the project config',","+      target: 'browserslist:modern',","+      browser: 'chrome',","+      version: '120',","+    },","+    {","+      name: 'an environment the project config does not define',","+      target: 'browserslist:production',","+      browser: 'chrome',","+      version: '110',","+    },","+    {","+      name: 'a config path with an environment',","+      target: `browserslist:${join(root, 'config/.browserslistrc')}:modern`,","+      browser: 'firefox',","+      version: '120',","+    },","+    {","+      name: 'a browserslist entry in a target array',","+      target: ['web', 'browserslist:chrome 100'],","+      browser: 'chrome',","+      version: '100',","+    },","+  ])('reads the browsers of $name', ({ target, browser, version }) => {","+    expect(getBrowserslistTargets(target, root)).toEqual({","+      queries: [`${browser} >= ${version}`],","+      swc: { [browser]: `${version}.0.0` },","+    });","+  });","+});"],"additions":68,"deletions":0,"truncated":false},{"path":"packages/rspack/src/plugins/utils/get-browserslist-targets.ts","lines":["@@ -0,0 +1,150 @@","+import type { Configuration } from '@rspack/core';","+import browserslist = require('browserslist');","+import { coerce, lt, type SemVer } from 'semver';","+","+// Rspack 2 renames browsers like this before it passes its own targets to swc,","+// and drops the ones swc rejects.","+const SWC_BROWSER_NAMES: Record<string, string | null> = {","+  and_chr: 'chrome',","+  and_ff: 'firefox',","+  ie_mob: 'ie',","+  ios_saf: 'ios',","+  op_mob: 'opera',","+  and_qq: null,","+  and_uc: null,","+  baidu: null,","+  bb: null,","+  kaios: null,","+};","+","+export interface BrowserslistTargets {","+  queries: string[];","+  swc: Record<string, string>;","+}","+","+export function getBrowserslistTargets(","+  target: Configuration['target'],","+  projectRoot: string","+): BrowserslistTargets | undefined {","+  const browsers = getBrowsers(target, projectRoot)?.map((entry) => {","+    const [name, versions] = entry.split(' ');","+    return { entry, name, lowestVersion: versions.split('-')[0] };","+  });","+  if (!browsers) {","+    return undefined;","+  }","+","+  return {","+    // Lightning CSS rejects exact versions newer than its data, so pass numeric versions as `>=`.","+    queries: browsers.map(({ entry, name, lowestVersion }) =>","+      isVersion(lowestVersion) ? `${name} >= ${lowestVersion}` : entry","+    ),","+    swc: getSwcTargets(browsers),","+  };","+}","+","+function getBrowsers(","+  target: Configuration['target'],","+  projectRoot: string","+): string[] | undefined {","+  // `web` and `webworker` carry no browser versions, so use the project's config.","+  if (target === 'web' || target === 'webworker') {","+    return loadBrowserslist(undefined, projectRoot);","+  }","+","+  // Autoprefixer never sees these browsers, and rspack 1 passes them to neither swc nor","+  // Lightning CSS.","+  const lists = (Array.isArray(target) ? target : [target])","+    .map((entry) =>","+      typeof entry === 'string' ? entry.match(/^browserslist(?::(.+))?$/) : null","+    )","+    .filter(Boolean)","+    .map((match) => loadBrowserslist(match[1]?.trim(), projectRoot))","+    .filter(Boolean);","+  return lists.length ? lists.flat() : undefined;","+}","+","+// Reads `browserslist:<rest>` like rspack: a config path with an optional env, then","+// a query, then an env. Resolve in JS so `extends` packages are found from the project.","+function loadBrowserslist(","+  rest: string | undefined,","+  projectRoot: string","+): string[] | undefined {","+  const [, configPath, env] =","+    (rest ?? '').match(/^(?:((?:[A-Z]:)?[/\\\\].*?))?(?::(.+?))?$/) ?? [];","+  if (configPath) {","+    return browserslist(undefined, {","+      config: configPath,","+      env,","+      path: projectRoot,","+    });","+  }","+  if (rest) {","+    try {","+      return browserslist(rest, { path: projectRoot });","+    } catch (error) {","+      if (!error?.browserslist) {","+        throw error;","+      }","+      return browserslist(undefined, { env: rest, path: projectRoot });","+    }","+  }","+","+  const config = browserslist.loadConfig({ path: projectRoot });","+  return config ? browserslist(config, { path: projectRoot }) : undefined;","+}","+","+// swc in rspack 1.7.0 and earlier lowers everything for queries newer than its","+// data, but compares minimum versions directly.","+function getSwcTargets(","+  browsers: { name: string; lowestVersion: string }[]","+): Record<string, string> {","+  const targets: Record<string, SemVer> = {};","+  for (const { name, lowestVersion } of browsers) {","+    const swcName = name in SWC_BROWSER_NAMES ? SWC_BROWSER_NAMES[name] : name;","+    // Safari Technology Preview supports every feature.","+    const version =","+      lowestVersion === 'TP'","+        ? coerce('999')","+        : isVersion(lowestVersion)","+          ? coerce(lowestVersion)","+          : null;","+    if (","+      swcName &&","+      version &&","+      (!targets[swcName] || lt(version, targets[swcName]))","+    ) {","+      targets[swcName] = version;","+    }","+  }","+  return Object.fromEntries(","+    Object.entries(targets).map(([name, version]) => [name, version.version])","+  );","+}","+","+function isVersion(version: string): boolean {","+  return /^\\d+(\\.\\d+)*$/.test(version);","+}","+","+export function getUnsupportedEnvironmentFeatures(","+  rspackCore: typeof import('@rspack/core'),","+  projectRoot: string,","+  browserslistQueries: string[]","+): Record<string, false> {","+  const { config } = rspackCore;","+  const options = config.getNormalizedRspackOptions({","+    context: projectRoot,","+    // Rspack throws when its data has none of these versions. Adding the latest","+    // Chrome avoids that without turning off a feature the others support.","+    target: [","+      'web',","+      `browserslist:${[...browserslistQueries, 'last 1 chrome version'].join(', ')}`,","+    ],","+  });","+  config.applyRspackOptionsDefaults(options);","+  return Object.fromEntries(","+    Objec