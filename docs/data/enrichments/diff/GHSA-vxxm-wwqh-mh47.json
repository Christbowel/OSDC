        assertThat(provider.verify(credentials, GET), equalTo(true))","+    }","+}",""],"additions":69,"deletions":0,"truncated":false}],"additions":71,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-08-18T09:08:06.139448+00:00"}