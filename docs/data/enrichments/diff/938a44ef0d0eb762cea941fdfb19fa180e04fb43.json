             continue","+            self.assertEqual(","+                names[head] in model.tp_plan,","+                names[embedding] in model.tp_plan,","+                f\"{model_class.__name__} ties `{names[head]}` to `{names[embedding]}`, so its TP plan must shard both \"","+                \"or neither\",","             )"," ","     def test_reverse_loading_mapping(self, check_keys_were_modified=True, skip_base_model=False):",""],"additions":18,"deletions":21,"truncated":false}],"additions":46,"deletions":22,"truncated":false,"file_count":25},"error":null,"fetched_at":"2026-11-17T18:44:51.645912+00:00"}