e info \", rhs_pass->get_type_info(), \" can't be merged.\");"],"additions":3,"deletions":3,"truncated":false},{"path":"src/common/snippets/src/lowered/pass/pass_config.cpp","lines":["@@ -4,6 +4,7 @@"," "," #include \"snippets/lowered/pass/pass_config.hpp\""," ","+#include \"openvino/core/except.hpp\""," #include \"openvino/core/type.hpp\""," "," namespace ov::snippets::lowered::pass {","@@ -26,6 +27,19 @@ bool PassConfig::is_enabled(const DiscreteTypeInfo& type_info) const {","     return m_enabled.count(type_info) != 0U;"," }"," ","+PassConfig PassConfig::merge_configs(const PassConfig& lhs, const PassConfig& rhs) {","+    PassConfig merged_config(lhs);","+    merged_config.m_disabled.insert(rhs.m_disabled.begin(), rhs.m_disabled.end());","+    merged_config.m_enabled.insert(rhs.m_enabled.begin(), rhs.m_enabled.end());","+    for (const auto& type_info : merged_config.m_disabled) {","+        OPENVINO_ASSERT(!merged_config.is_enabled(type_info),","+                        \"PassConfigs with conflicting settings for pass \",","+                        type_info,","+                        \" cannot be merged.\");","+    }","+    return merged_config;","+}","+"," bool operator==(const PassConfig& lhs, const PassConfig& rhs) {","     return lhs.m_disabled == rhs.m_disabled && lhs.m_enabled == rhs.m_enabled;"," }"],"additions":14,"deletions":0,"truncated":false},{"path":"src/common/snippets/tests/sources.cmake","lines":["@@ -16,6 +16,7 @@ set(SNIPPETS_TESTS_SRCS","     ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/loop.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/move_scalar_to_consumer.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/optimize_domain.cpp","+    ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/pass_pipeline.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/serialize_data_flow.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/set_buffer_reg_group.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/lowered/pass/split_loops.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"src/common/snippets/tests/src/lowered/pass/pass_pipeline.cpp","lines":["@@ -0,0 +1,71 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include <gtest/gtest.h>","+","+#include \"openvino/core/except.hpp\"","+#include \"snippets/lowered/pass/init_loops.hpp\"","+#include \"snippets/lowered/pass/insert_load_store.hpp\"","+#include \"snippets/lowered/pass/iter_handler.hpp\"","+#include \"snippets/lowered/pass/pass.hpp\"","+","+namespace ov::test::snippets {","+","+using namespace ov::snippets::lowered;","+using namespace ov::snippets::lowered::pass;","+","+class PassPipelineMergeTest : public testing::TestWithParam<bool> {};","+","+TEST_P(PassPipelineMergeTest, PreservesBothConfigs) {","+    PassPipeline lhs;","+    lhs.register_pass<UpdateMemoryAccessCounts>(4);","+    lhs.get_pass_config()->disable<UpdateMemoryAccessCounts>();","+    lhs.get_pass_config()->enable<InitLoops>();","+","+    PassPipeline rhs;","+    rhs.register_pass<SetLoopIncrementOne>();","+    rhs.get_pass_config()->disable<SetLoopIncrementOne>();","+    rhs.get_pass_config()->enable<InsertLoadStore>();","+","+    const auto merged = GetParam() ? PassPipeline::merge_pipelines(rhs, lhs) : PassPipeline::merge_pipelines(lhs, rhs);","+    const auto& config = merged.get_pass_config();","+    ASSERT_TRUE(config->is_disabled<UpdateMemoryAccessCounts>());","+    ASSERT_TRUE(config->is_disabled<SetLoopIncrementOne>());","+    EXPECT_TRUE(config->is_enabled<InitLoops>());","+    EXPECT_TRUE(config->is_enabled<InsertLoadStore>());","+    ASSERT_EQ(merged.get_passes().size(), 2);","+","+    LinearIR linear_ir;","+    EXPECT_NO_THROW(merged.run(linear_ir));","+}","+","+TEST_P(PassPipelineMergeTest, RejectsConflictingConfigs) {","+    PassPipeline lhs;","+    lhs.get_pass_config()->disable<SetLoopIncrementOne>();","+    PassPipeline rhs;","+    rhs.get_pass_config()->enable<SetLoopIncrementOne>();","+","+    if (GetParam()) {","+        EXPECT_THROW(PassPipeline::merge_pipelines(rhs, lhs), ov::AssertFailure);","+    } else {","+        EXPECT_THROW(PassPipeline::merge_pipelines(lhs, rhs), ov::AssertFailure);","+    }","+}","+","+INSTANTIATE_TEST_SUITE_P(Smoke, PassPipelineMergeTest, testing::Bool());","+","+TEST(PassPipelineMerge, DoesNotModifyInputConfigs) {","+    PassPipeline lhs;","+    lhs.get_pass_config()->disable<SetLoopIncrementOne>();","+    PassPipeline rhs;","+    rhs.get_pass_config()->disable<SetLoopIncrementOne>();","+","+    const auto merged = PassPipeline::merge_pipelines(lhs, rhs);","+    EXPECT_TRUE(merged.get_pass_config()->is_disabled<SetLoopIncrementOne>());","+    merged.get_pass_config()->enable<SetLoopIncrementOne>();","+    EXPECT_TRUE(lhs.get_pass_config()->is_disabled<SetLoopIncrementOne>());","+    EXPECT_TRUE(rhs.get_pass_config()->is_disabled<SetLoopIncrementOne>());","+}","+","+}  // namespace ov::test::snippets",""],"additions":71,"deletions":0,"truncated":false}],"additions":91,"deletions":3,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-23T14:16:53.159069+00:00"}