{"id":"0b839f98b150485944188cff36e9f059548401c5","axis":"silent","repo":"strapi/strapi","sha":"0b839f98b150485944188cff36e9f059548401c5","parsed":{"files":[{"path":"docs/docs/architecture/09-enterprise-edition.md","lines":["@@ -35,8 +35,19 @@ Every time a new EE feature is added in Strapi, in the settings menu, you should","             to: '/settings/purchase-new-ee-feature',","             id: 'new-ee-feature',","             licenseOnly: true,","+            licenseFeature: 'new-ee-feature',","           },","         ]","       : []),"," ..."," ```","+","+## The ⚡ on paid-feature links","+","+A main navigation or settings link with `licenseOnly: true` shows a ⚡. Its `licenseFeature` names the license feature it needs. `getLicenseIconFill` in `admin/src/utils/licenseFeature.ts` picks the colour for both menus:","+","+- Purple: a trial grants the feature.","+- No icon: a paid license includes the feature.","+- Grey: the license doesn't include the feature, so the link opens its purchase page. A link that names no `licenseFeature` is grey too, since its availability can't be checked.","+","+The colour comes from `window.strapi.features.isEnabled` and `window.strapi.isTrial`, the same flags that decide whether a plugin registers the feature page or its purchase page. A lapsed license grants nothing here, even while the Plan card still lists what it included."],"additions":11,"deletions":0,"truncated":false},{"path":"packages/core/admin/admin/src/components/MainNav/MainNavLinks.tsx","lines":["@@ -8,6 +8,7 @@ import { styled } from 'styled-components';"," "," import { useIsDesktop } from '../../hooks/useMediaQuery';"," import { MenuItem } from '../../hooks/useMenu';","+import { getLicenseIconFill } from '../../utils/licenseFeature';"," import { tours } from '../GuidedTour/Tours';"," "," import { NavLink } from './NavLink';","@@ -62,7 +63,8 @@ const MainNavIcons = ({","   return listLinks.length > 0","     ? listLinks.map((link) => {","         const LinkIcon = link.ic