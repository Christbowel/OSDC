{"id":"2db0ad2602ba83e30e4c6cd147fea0051859f47b","axis":"silent","repo":"TYPO3/typo3","sha":"2db0ad2602ba83e30e4c6cd147fea0051859f47b","parsed":{"files":[{"path":"composer.json","lines":["@@ -78,7 +78,6 @@"," \t\t\"guzzlehttp/promises\": \"^3.1.0\","," \t\t\"guzzlehttp/psr7\": \"^3.2.0\","," \t\t\"lolli42/finediff\": \"^1.1.2\",","-\t\t\"masterminds/html5\": \"^2.11.0\","," \t\t\"nikic/php-parser\": \"^5.4.0\","," \t\t\"phpdocumentor/type-resolver\": \"^2.0.0\","," \t\t\"phpstan/phpdoc-parser\": \"^2.1\","],"additions":0,"deletions":1,"truncated":false},{"path":"composer.lock","lines":["@@ -4,7 +4,7 @@","         \"Read more about it at https://getcomposer.org/doc/01-basic-usage.md#installing-dependencies\",","         \"This file is @generated automatically\"","     ],","-    \"content-hash\": \"a16e13818b5eb058d56d939a2db755b9\",","+    \"content-hash\": \"5f60bc8044488390b5888662061d3665\",","     \"packages\": [","         {","             \"name\": \"bacon/bacon-qr-code\","],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Classes/DependencyInjection/CommonFactory.php","lines":["@@ -1,33 +0,0 @@","-<?php","-","-declare(strict_types=1);","-","-/*","- * This file is part of the TYPO3 CMS project.","- *","- * It is free software; you can redistribute it and/or modify it under","- * the terms of the GNU General Public License, either version 2","- * of the License, or any later version.","- *","- * For the full copyright and license information, please read the","- * LICENSE.txt file that was distributed with this source code.","- *","- * The TYPO3 project - inspiring people to share!","- */","-","-namespace TYPO3\\CMS\\Core\\DependencyInjection;","-","-use Masterminds\\HTML5;","-","-/**","- * @internal","- */","-readonly class CommonFactory","-{","-    public static function createHtml5Parser(): HTML5","-    {","-        return new HTML5([","-            'disable_html_ns' => true,","-        ]);","-    }","-}"],"additions":0,"deletions":33,"truncated":false},{"path":"typo3/sysext/core/Configuration/Services.yaml","lines":["@@ -219,6 +219,3 @@ services:"," ","   GuzzleHttp\\Client:","     factory: ['@TYPO3\\CMS\\Core\\Http\\Client\\GuzzleClientFactory', 'getClient']","-  Masterminds\\HTML5:","-    public: true","-    factory: ['TYPO3\\CMS\\Core\\DependencyInjection\\CommonFactory', 'createHtml5Parser']"],"additions":0,"deletions":3,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Important-111440-HtmlTransformationUsesNativeHtml5Parser.rst","lines":["@@ -0,0 +1,82 @@","+..  include:: /Includes.rst.txt","+","+..  _important-111440-1794584649:","+","+=================================================================","+Important: #111440 - HTML transformation uses native HTML5 parser","+=================================================================","+","+See :issue:`111440`","+","+Description","+===========","+","+The internal class :php:`\\TYPO3\\CMS\\Frontend\\Html\\HtmlWorker`, which backs the","+Fluid ViewHelper :html:`<f:transform.html>`, no longer parses markup with the","+third-party library `masterminds/html5`. It now uses the native, spec-compliant","+HTML5 parser of PHP, :php:`\\Dom\\HTMLDocument`, available since PHP 8.4.","+","+Along with this, the internal class","+:php:`\\TYPO3\\CMS\\Core\\DependencyInjection\\CommonFactory` and the public","+service :php:`Masterminds\\HTML5` have been removed from the dependency","+injection container, and `masterminds/html5` is no longer a direct requirement","+of `typo3/cms-core`. The library is still installed as a dependency of","+`typo3/html-sanitizer`, so HTML sanitizing, :typoscript:`parseFunc` and RTE","+processing are not affected. Extensions that injected or fetched the service","+:php:`Masterminds\\HTML5` must either require `masterminds/html5` themselves","+and instantiate the parser, or switch to :php:`\\Dom\\HTMLDocument`.","+","+The native parser is implemented in C. In a local measurement on PHP 8.5 with","+an HTML document of about 510 KB, parsing and serializing took about 8 ms","+instead of about 130 ms with `masterminds/html5`. The actual gain depends on","+the markup, but is in the order of magnitude of 12 to 16 times faster.","+","+The native parser follows the WHATWG HTML parsing and serialization","+algorithms, the markup is parsed as a fragment in the context of a","+:html:`<div>` element. This results in the following differences:","+","+..  list-table::","+    :header-rows: 1","+","+    *   -   Input","+        -   Output (before)","+        -   Output (now)","+    *   -   :html:`<a href>visit</a>`","+        -   :html:`<a href>visit</a>`","+        -   :html:`<a href=\"\">visit</a>`","+    *   -   :html:`<custom-el/>after`","+        -   :html:`<custom-el></custom-el>after`","+        -   :html:`<custom-el>after</custom-el>`","+    *   -   :html:`<td>cell</td>`","+        -   :html:`<td>cell</td>`","+        -   :html:`cell`","+    *   -   :html:`<table>text<tr><td>cell</td></tr></table>`","+        -   unchanged","+        -   :html:`text<table><tbody><tr><td>cell</td></tr></tbody></table>`","+    *   -   :html:`<svg><path d=\"M0 0\"/></svg>`","+        -   :html:`<svg><path d=\"M0 0\" /></svg>`","+        -   :html:`<svg><path d=\"M0 0\"></path></svg>`","+","+*   Empty attributes are serialized with an empty value, for example","+    :html:`<img alt>` becomes :html:`<img alt=\"\">` and :html:`disabled`","+    becomes :html:`disabled=\"\"`.","+*   The self-closing syntax is not honoured for non-void HTML elements.","+*   Table cells and rows outside of a table lose their tag, an implied","+    :html:`<tbody>` is added, and misplaced content is moved in front of the","+    table.","+*   Node and attribute names of the ViewHelper argument `selector` are matched","+    case-insensitively, :html:`A.HREF` now matches :html:`<a href=\"...\">`.","+","+Entities, void elements such as :html:`<br>`, the raw content of","+:html:`<script>` and :html:`<style>`, comments and the `onFailure` behaviours","+are unchanged.","+","+The changes only apply where :html:`<f:transform.html>` is used. In TYPO3 Core,","+these are the labels and texts of EXT:form rendered in the frontend (checkbox","+labels, static text elements, the summary page, the confirmation finisher and","+the default email finisher template), as well as the news on the backend login","+screen and the module descriptions of the backend submodule overview. Custom","+templates and extensions using the ViewHelper are affected as well and should","+check their rendered output if they pass unusual or invalid markup.","+","+..  index:: Fluid, Frontend, PHP-API, NotScanned, ext:frontend"],"additions":82,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/composer.json","lines":["@@ -60,7 +60,6 @@"," \t\t\"guzzlehttp/promises\": \"^3.1.0\","," \t\t\"guzzlehttp/psr7\": \"^3.2.0\","," \t\t\"lolli42/finediff\": \"^1.1.2\",","-\t\t\"masterminds/html5\": \"^2.11.0\","," \t\t\"psr/clock\": \"^1.0\","," \t\t\"psr/container\": \"^2.0\","," \t\t\"psr/event-dispatcher\": \"^1.0\","],"additions":0,"deletions":1,"truncated":false},{"path":"typo3/sysext/fluid/Tests/Functional/ViewHelpers/Transform/HtmlViewHelperTest.php","lines":["@@ -69,7 +69,7 @@ public static function isTransformedDataProvider(): array","             ],","             'empty' => [","                 '<a href>visit</a>',","-                '<a href>visit</a>',","+                '<a href=\"\">visit</a>',","             ],","             'invalid' => [","                 '<a href=\"#\">visit</a>',"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/frontend/Classes/Html/HtmlWorker.php","lines":["@@ -17,7 +17,6 @@"," "," namespace TYPO3\\CMS\\Frontend\\Html;"," ","-use Masterminds\\HTML5;"," use Symfony\\Component\\DependencyInjection\\Attribute\\Autoconfigure;"," use TYPO3\\CMS\\Core\\Security\\ContentSecurityPolicy\\ConsumableNonce;"," use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","@@ -48,29 +47,22 @@ class HtmlWorker","      */","     public const REMOVE_ENCLOSURE_ON_FAILURE = 4;"," ","-    protected ?\\DOMNode $mount = null;","-    protected ?\\DOMDocument $document = null;","+    protected ?\\Dom\\Element $mount = null;"," ","     public function __construct(","         protected readonly LinkFactory $linkFactory,","-        protected readonly HTML5 $parser","     ) {}"," ","     public function __toString(): string","     {","-        if (!$this->mount instanceof \\DOMNode || !$this->document instanceof \\DOMDocument) {","-            return '';","-        }","-        return $this->parser->saveHTML($this->mount->childNodes);","+        return $this->mount === null ? '' : $this->mount->innerHTML;","     }"," ","     public function parse(string $html): self","     {","-        // use document fragment to separate markup from default structure (html, body, ...)","-        $fragment = $this->parser->parseFragment($html);","-        // mount fragment to make it accessible in current document","-        $this->mount = $this->mountFragment($fragment);","-        $this->document = $this->mount->ownerDocument;","+        // fragment parsing with a `<div>` context element, keeps markup apart from the default structure (html, body, ...)","+        $this->mount = \\Dom\\HTMLDocument::createEmpty()->createElement('div');","+        $this->mount->innerHTML = $html;","         return $this;","     }"," ","@@ -80,15 +72,14 @@ public function parse(string $html): self","      */","     public function addNonceAttribute(string|ConsumableNonce $nonce, string ...$nodeNames): self","     {","-        if ($nodeNames === []) {","+        if ($nodeNames === [] || $this->mount === null) {","             return $this;","         }","-        $xpath = new \\DOMXPath($this->document);","         foreach ($nodeNames as $nodeName) {","-            $expression = sprintf('//%s[not(@*)]', $nodeName);","-            /** @var \\DOMElement $element */","-            foreach ($xpath->query($expression, $this->mount) as $element) {","-                $element->setAttribute('nonce', (string)$nonce);","+            foreach ($this->findElements($nodeName) as $element) {","+                if ($element->attributes->length === 0) {","+                    $element->setAttribute('nonce', (string)$nonce);","+                }","             }","         }","         return $this;","@@ -96,18 +87,16 @@ public function addNonceAttribute(string|ConsumableNonce $nonce, string ...$node"," ","     public function transformUri(string $selector, int $flags = 0): self","     {","-        if (!$this->mount instanceof \\DOMNode || !$this->document instanceof \\DOMDocument) {","+        if ($this->mount === null) {","             return $this;","         }","-        $subjects = $this->parseSelector($selector);","-        // use xpath to traverse potential candidates having \"links\"","-        $xpath = new \\DOMXPath($this->document);","-        foreach ($subjects as $subject) {","+        foreach ($this->parseSelector($selector) as $subject) {","             $attrName = $subject['attr'];","-            $expression = sprintf('//%s[@%s]', $subject['node'], $attrName);","-            /** @var \\DOMElement $element */","-            foreach ($xpath->query($expression, $this->mount) as $element) {","-                $elementAttrValue = $element->getAttribute($attrName);","+            foreach ($this->findElements($subject['node']) as $element) {","+                if (!$element->hasAttribute($attrName)) {","+                    continue;","+                }","+                $elementAttrValue = (string)$element->getAttribute($attrName);","                 $scheme = parse_url($elementAttrValue, PHP_URL_SCHEME);","                 // skip values not having a URI-scheme","                 if (empty($scheme)) {","@@ -115,7 +104,7 @@ public function transformUri(string $selector, int $flags = 0): self","                 }","                 try {","                     $linkResult = $this->linkFactory->createUri($elementAttrValue);","-                } catch (UnableToLinkException $exception) {","+                } catch (UnableToLinkException) {","                     $this->onTransformUriFailure($element, $subject, $flags);","                     continue;","                 }","@@ -135,29 +124,21 @@ public function transformUri(string $selector, int $flags = 0): self","     }"," ","     /**","-     * @param \\DOMElement $element current element encountered failure","+     * @param \\Dom\\Element $element current element encountered failure","      * @param array{node: string, attr: string} $subject node-attr combination","      */","-    protected function onTransformUriFailure(\\DOMElement $element, array $subject, int $flags): void","+    protected function onTransformUriFailure(\\Dom\\Element $element, array $subject, int $flags): void","     {","         if (($flags & self::REMOVE_TAG_ON_FAILURE) === self::REMOVE_TAG_ON_FAILURE) {","-            $element->parentNode->removeChild($element);","+            $element->remove();","         } elseif (($flags & self::REMOVE_ATTR_ON_FAILURE) === self::REMOVE_ATTR_ON_FAILURE) {","-            $attrName = $subject['attr'];","-            $element->removeAttribute($attrName);","+            $element->removeAttribute($subject['attr']);","         } elseif (($flags & self::REMOVE_ENCLOSURE_ON_FAILURE) === self::REMOVE_ENCLOSURE_ON_FAILURE) {","-            // moves children out of element's enclosure, then removes (empty) element","-            // eg `<ELEMENT><a><b><c></ELEMENT><NEXT>`","-            // 1) `<ELEMENT><b><c></ELEMENT><a><NEXT>`","-            // 2) `<ELEMENT><c></ELEMENT><a><b><NEXT>`","-            // 3) `<ELEMENT></ELEMENT><a><b><c><NEXT>`","-            // rm `<a><b><c><NEXT>`","-            $parentNode = $element->parentNode;","+            // copies children in front of the element, then removes the element","             foreach ($element->childNodes as $child) {","-                $cloned = $child->cloneNode(true);","-                $parentNode->insertBefore($cloned, $element);","+                $element->before($child->cloneNode(true));","             }","-            $parentNode->removeChild($element);","+            $element->remove();","         }","     }"," ","@@ -183,14 +164,17 @@ static function (string $item): ?array {","         return array_filter($items);","     }"," ","-    protected function mountFragment(\\DOMDocumentFragment $fragment): \\DOMNode","+    /**","+     * Elements are collected upfront, since modifications during","+     * iteration would affect the live `HTMLCollection`.","+     *","+     * @return list<\\Dom\\Element>","+     */","+    protected function findElements(string $nodeName): array","     {","-        $document = $fragment->ownerDocument;","-        $mount = $document->createElement('div');","-        $document->appendChild($mount);","-        if ($fragment->hasChildNodes()) {","-            $mount->appendChild($fragment);","+        if ($this->mount === null) {","+            return [];","         }","-        return $mount;","+        return iterator_to_array($this->mount->getElementsByTagName($nodeName), false);","     }"," }"],"additions":35,"deletions":51,"truncated":false},{"path":"typo3/sysext/frontend/Tests/Functional/Controller/ShowImageControllerTest.php","lines":["@@ -17,7 +17,6 @@"," "," namespace TYPO3\\CMS\\Frontend\\Tests\\Functional\\Controller;"," ","-use Masterminds\\HTML5;"," use PHPUnit\\Framework\\Attributes\\DataProvider;"," use PHPUnit\\Framework\\Attributes\\Test;"," use TYPO3\\CMS\\Core\\Crypto\\HashAlgo;","@@ -101,10 +100,10 @@ public function contentIsGeneratedForLocalFiles(","         $content = (string)$response->getBody();","         self::assertNotEmpty($content);"," ","-        $document = new HTML5()->loadHTML($content);","+        $document = \\Dom\\HTMLDocument::createFromString($content, LIBXML_NOERROR);","         $titles = $document->getElementsByTagName('title');","         $images = $document->getElementsByTagName('img');","-        self::assertSame($expectedTitle, $titles->item(0)->nodeValue);","+        self::assertSame($expectedTitle, $titles->item(0)->textContent);","         self::assertSame($expectedSource, $images->item(0)->getAttribute('src'));","         self::assertSame($expectedTitle, $images->item(0)->getAttribute('title'));","         self::assertSame($expectedAlternative, $images->item(0)->getAttribute('alt'));","@@ -163,7 +162,7 @@ public function contentIsGeneratedForSystemResources(): void","         $response = $this->executeFrontendSubRequest(new InternalRequest((string)$uri));"," ","         self::assertSame(200, $response->getStatusCode());","-        $images = new HTML5()->loadHTML((string)$response->getBody())->getElementsByTagName('img');","+        $images = \\Dom\\HTMLDocument::createFromString((string)$response->getBody(), LIBXML_NOERROR)->getElementsByTagName('img');","         self::assertStringContainsString('typo3temp/assets/images/system/', $images->item(0)->getAttribute('src'));","         self::assertSame('119', $images->item(0)->getAttribute('width'));","         self::assertSame('50', $images->item(0)->getAttribute('height'));"],"additions":3,"deletions":4,"truncated":false},{"path":"typo3/sysext/frontend/Tests/Unit/Html/HtmlWorkerTest.php","lines":["@@ -0,0 +1,350 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Frontend\\Tests\\Unit\\Html;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Core\\Security\\ContentSecurityPolicy\\ConsumableNonce;","+use TYPO3\\CMS\\Frontend\\Html\\HtmlWorker;","+use TYPO3\\CMS\\Frontend\\Typolink\\LinkFactory;","+use TYPO3\\CMS\\Frontend\\Typolink\\LinkResult;","+use TYPO3\\CMS\\Frontend\\Typolink\\UnableToLinkException;","+use TYPO3\\TestingFramework\\Core\\Unit\\UnitTestCase;","+","+final class HtmlWorkerTest extends UnitTestCase","+{","+    private function createSubject(): HtmlWorker","+    {","+        $linkFactory = self::createStub(LinkFactory::class);","+        $linkFactory->method('createUri')->willReturnCallback(","+            static function (string $uri): LinkResult {","+                if ($uri === 't3://page?uid=1') {","+                    return new LinkResult('page', 'https://typo3.localhost/');","+                }","+                if ($uri === 't3://page?uid=2') {","+                    return new LinkResult('page', 'https://typo3.localhost/two')","+                        ->withTarget('_blank')","+                        ->withAttribute('rel', 'noopener');","+                }","+                throw new UnableToLinkException('Unable to link', 1763030000);","+            }","+        );","+        return new HtmlWorker($linkFactory);","+    }","+","+    #[Test]","+    public function toStringReturnsEmptyStringWithoutParsing(): void","+    {","+        self::assertSame('', (string)$this->createSubject());","+    }","+","+    public static function parseAndSerializeDataProvider(): array","+    {","+        return [","+            'empty string' => [","+                '',","+                '',","+            ],","+            'text only' => [","+                'just text',","+                'just text',","+            ],","+            'multiple top-level nodes' => [","+                'before<p>one</p>between<p>two</p>after',","+                'before<p>one</p>between<p>two</p>after',","+            ],","+            'nested elements with attributes' => [","+                '<div class=\"a\" id=\"b\"><span data-x=\"1\">x</span></div>',","+                '<div class=\"a\" id=\"b\"><span data-x=\"1\">x</span></div>',","+            ],","+            'uppercase tags and attributes' => [","+                '<P CLASS=\"x\">text</P>',","+                '<p class=\"x\">text</p>',","+            ],","+            'single-quoted attribute' => [","+                '<a href=\\'https://typo3.localhost/\\'>visit</a>',","+                '<a href=\"https://typo3.localhost/\">visit</a>',","+            ],","+            'void elements' => [","+                'a<br>b<br/>c<img src=\"x.png\" alt=\"\">',","+                'a<br>b<br>c<img src=\"x.png\" alt=\"\">',","+            ],","+            'boolean attribute' => [","+                '<input type=\"checkbox\" disabled checked=\"checked\">',","+                '<input type=\"checkbox\" disabled=\"\" checked=\"checked\">',","+            ],","+            'angle brackets in attribute' => [","+                '<span title=\"a &lt; b > c\">x</span>',","+                '<span title=\"a < b > c\">x</span>',","+            ],","+            'self-closing custom element' => [","+                '<custom-el/>after',","+                '<custom-el>after</custom-el>',","+            ],","+            'table cell without table' => [","+                '<td>cell</td>',","+                'cell',","+            ],","+            'text directly in table' => [","+                '<table>text<tr><td>cell</td></tr></table>',","+                'text<table><tbody><tr><td>cell</td></tr></tbody></table>',","+            ],","+            'svg' => [","+                '<svg viewBox=\"0 0 1 1\"><path d=\"M0 0\"/></svg>',","+                '<svg viewBox=\"0 0 1 1\"><path d=\"M0 0\"></path></svg>',","+            ],","+            'unclosed paragraphs' => [","+                '<p>one<p>two',","+                '<p>one</p><p>two</p>',","+            ],","+            'speci