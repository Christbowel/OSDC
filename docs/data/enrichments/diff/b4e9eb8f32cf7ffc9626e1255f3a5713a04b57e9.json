*","+ * Pure chart embed — the cross-origin iframe plus the postMessage bridge, and","+ * nothing else. Mirrors mobile's AdvancedChart.tsx (the WebView component","+ * only).","+ *","+ * All toolbar UI (IntervalBar, IndicatorBar) lives in separate components","+ * rendered by the parent, matching mobile's architecture where","+ * Price.advanced.tsx composes IntervalBar + AdvancedChart + IndicatorBar.","+ */","+","+export const CHART_ORIGIN_UAT = 'https://chart.uat.metamask-charts.com';","+export const CHART_ORIGIN_PRD = 'https://chart.metamask-charts.com';","+","+/**","+ * Resolves the Advanced Charts iframe origin for the current MetaMask","+ * environment. Production and release-candidate builds use the production","+ * origin; every other environment (staging, dev, CI, PR, local) uses UAT.","+ *","+ * `CHART_ORIGIN_URL` (set via `.metamaskrc`/env) overrides the mapping so a","+ * developer can point at a local chart-origin server (e.g.","+ * `http://localhost:8001`).","+ *","+ * @returns The chart origin for the current build.","+ */","+export function getChartOrigin(): string {","+  if (process.env.CHART_ORIGIN_URL) {","+    return process.env.CHART_ORIGIN_URL;","+  }","+","+  switch (process.env.METAMASK_ENVIRONMENT) {","+    case ENVIRONMENT.PRODUCTION:","+    case ENVIRONMENT.RELEASE_CANDIDATE:","+      return CHART_ORIGIN_PRD;","+    case ENVIRONMENT.STAGING:","+    case ENVIRONMENT.DEVELOPMENT:","+    case ENVIRONMENT.TESTING:","+    case ENVIRONMENT.PULL_REQUEST:","+    case ENVIRONMENT.OTHER:","+    default:","+      return CHART_ORIGIN_UAT;","+  }","+}","+","+export const CHART_ORIGIN = getChartOrigin();","+","+// If the chart hasn't emitted CHART_READY within this window, fall back to legacy.","+// Sized for a cold CDN cache fetching the ~20 MB TradingView library, not for","+// the local chart-origin server.","+export const LOAD_TIMEOUT_MS = 30_000;","+","+const TRADINGVIEW_URL = 'https://www.tradingview.com';","+","+/**","+ * Narrows an engine-supplied URL to TradingView before we hand it to the","+ * browser. The engine already filters, but it runs on a remote origin.","+ *","+ * @param raw - The url from the CHART_TRADINGVIEW_CLICKED payload, if any.","+ * @returns A safe TradingView url.","+ */","+function toTradingViewUrl(raw?: unknown): string {","+  if (typeof raw !== 'string' || raw === '') {","+    return TRADINGVIEW_URL;","+  }","+  try {","+    const parsed = new URL(raw);","+    const host = parsed.hostname.toLowerCase();","+    if (","+      parsed.protocol === 'https:' &&","+      (host === 'tradingview.com' || host.endsWith('.tradingview.com'))","+    ) {","+      return parsed.toString();","+    }","+  } catch {","+    // Malformed url — fall through to the plain TradingView link.","+  }","+  return TRADINGVIEW_URL;","+}","+","+/** Imperative handle so the parent can send messages to the chart engine. */","+export type AdvancedChartIframeRef = {","+  postMessage: (message: Record<string, unknown>) => void;","+};","+","+type AdvancedChartIframeProps = {","+  /**","+   * Identifies the series currently plotted. Together with `selectedInterval`","+   * it tells the component when the data below is a different series rather","+   * than a newer version of the same one.","+   */","+  assetId: string;","+  chartType: number;","+  selectedInterval: string;","+  /**","+   * The currency the bars are priced in. Part of the series identity: a fiat","+   * change re-prices every bar, which must rebuild the chart rather than tick.","+   */","+  currency?: string;","+  /** Persisted indicator selection, re-applied to each freshly loaded chart. */","+  activeIndicators?: Set<string>;","+  /** OHLCV data from parent (includes merged realtime updates) */","+  ohlcvData: OHLCVBar[];","+  onError?: (error: string) => void;","+  onReady?: () => void;","+  /** Real-time candle update from useOHLCVRealtime hook */","+  realtimeBar?: OHLCVRealtimeBar;","+};","+","+const AdvancedChartIframe = forwardRef<","+  AdvancedCh