+\t\t\t}","+\t\t},","+\t});","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"api/src/services/graphql/schema/parse-query.test.ts","lines":["@@ -467,6 +467,69 @@ describe('parseFields', () => {"," \t\texpect(query.fields).toContain('parent:child.id');"," \t\texpect(query.fields).toContain('parentAlias:child.id');"," \t});","+","+\ttest('should keep every alias nested under an M2A member', async () => {","+\t\tconst selections = [","+\t\t\tbuildField('parent', {","+\t\t\t\tchildren: [","+\t\t\t\t\tbuildInlineFragment('child', [","+\t\t\t\t\t\tbuildField('rel', { alias: 'first', children: [buildField('id')] }),","+\t\t\t\t\t\tbuildField('rel', { alias: 'second', children: [buildField('id')] }),","+\t\t\t\t\t]),","+\t\t\t\t],","+\t\t\t}),","+\t\t];","+","+\t\tconst query = await getQuery({}, m2aSchema, selections, mockVariableValues, mockAccountability, 'test_collection');","+","+\t\t// The deep node is keyed `parent__child`, so reading it back as `parent:child` found nothing and","+\t\t// each alias replaced the one before it","+\t\texpect(query.deep).toEqual({ parent__child: { _alias: { first: 'rel', second: 'rel' } } });","+\t});","+","+\ttest('should record an alias without copying what its parent already holds', async () => {","+\t\t// Every alias used to merge a fresh copy of everything collected under the parent, so this","+\t\t// took ~12s. The work is linear now, so a regression fails on the test timeout rather than on","+\t\t// a measured duration.","+\t\tconst COUNT = 4000;","+\t\tconst filter = buildFilterArgument({ status: { _eq: 'published' } });","+","+\t\tconst children = Array.from({ length: COUNT }, (_value, index) =>","+\t\t\tbuildField('role', { alias: `a${index}`, args: [filter], children: [buildField('id')] }),","+\t\t);","+","+\t\tconst selections = [buildField('author', { children })];","+","+\t\tconst query = await getQuery({}, mockSchema, selections, mockVariableValues, mockAccountability);","+","+\t\t// Counted rather than compa