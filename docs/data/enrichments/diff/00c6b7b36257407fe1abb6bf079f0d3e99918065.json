{"id":"00c6b7b36257407fe1abb6bf079f0d3e99918065","axis":"silent","repo":"directus/directus","sha":"00c6b7b36257407fe1abb6bf079f0d3e99918065","parsed":{"files":[{"path":".changeset/bound-query-parsing-cost.md","lines":["@@ -0,0 +1,31 @@","+---","+'@directus/api': major","+'@directus/env': minor","+'@directus/utils': patch","+---","+","+Bounded the work that parsing query parameters can cause","+","+::: notice","+","+`filter` and `deep` are now rejected with an `InvalidQueryError` once they exceed a limit on total node count or nesting depth.","+","+The node allowance is spent across a whole query, so a filter nested under `deep` draws from what is left rather than starting over. Set a limit to `Infinity` to opt out of it.","+","+- `QUERY_FILTER_MAX_NODES` (default `10000`) — total `filter`/`deep` nodes","+- `QUERY_FILTER_MAX_DEPTH` (default `50`) — nesting depth of a filter or of `deep`","+- `GRAPHQL_QUERY_SELECTION_LIMIT` (default `10000`) — fields a GraphQL operation may select across all its root fields once its fragments are expanded, checked during validation","+","+`QUERY_FILTER_MAX_NODES` is the one most likely to be reached. Every object, array and value counts,","+so `{\"id\":{\"_in\":[…]}}` costs one node per value plus three, and an `_in` of more than 9997 values is","+rejected.","+","+A `$NOW(...)` adjustment longer than 64 characters is now treated as unparseable, which also rejects","+a zero-padded amount that long, such as `$NOW(0000…0005s)`. A dynamic variable path deeper than 25","+segments now resolves to its default value.","+","+A `$CURRENT_USER`, `$CURRENT_ROLE`, `$CURRENT_ROLES` or `$CURRENT_POLICIES` path in a query filter is","+now held to `MAX_RELATIONAL_DEPTH`, the same as the fields it is fetched as, and is rejected with an","+`InvalidQueryError` beyond it.","+","+:::"],"additions":31,"deletions":0,"truncated":false},{"path":".changeset/bound-websocket-message-size.md","lines":["@@ -0,0 +1,13 @@","+---","+'@directus/api': patch","+---","+","+Enforced `MAX_PAYLOAD_SIZE` on incoming WebSocket messages","+","+::: notice","+","+A WebSocket message larger than `MAX_PAYLOAD_SIZE` (default `1mb`) now closes the connection with","+code `1009`. The setting applied only to REST bodies before this, leaving a message bounded by the","+100MB `ws` allows on its own.","+","+:::"],"additions":13,"deletions":0,"truncated":false},{"path":".changeset/keep-aliases-under-m2a-members.md","lines":["@@ -0,0 +1,5 @@","+---","+'@directus/api': patch","+---","+","+Fixed m2a alias being dropped from a GraphQL selection"],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/linear-regex-backtracking.md","lines":["@@ -0,0 +1,7 @@","+---","+'@directus/app': patch","+'@directus/release-notes-generator': patch","+'@directus/utils': patch","+---","+","+Reworked regexes whose worst-case matching time grew faster than the length of their input","\\ No newline at end of file"],"additions":7,"deletions":0,"truncated":false},{"path":"api/src/permissions/utils/extract-required-dynamic-variable-context.test.ts","lines":["@@ -58,3 +58,20 @@ test('Extracts dynamic variables context arbitrary objects', () => {"," \t\t$CURRENT_POLICIES: new Set(),"," \t});"," });","+","+test('Does not confuse the $CURRENT_ROLE and $CURRENT_ROLES prefixes', () => {","+\tconst result = extractRequiredDynamicVariableContext({ a: '$CURRENT_ROLES.id', b: '$CURRENT_ROLE.id' });","+","+\texpect(result.$CURRENT_ROLES).toEqual(new Set(['id']));","+\texpect(result.$CURRENT_ROLE).toEqual(new Set(['id']));","+});","+","+test('Walks input deeper than the call stack allows', () => {","+\tlet val: Record<string, any> = { deep: '$CURRENT_USER.id' };","+","+\tfor (let level = 0; level < 100_000; level++) {","+\t\tval = { a: val };","+\t}","+","+\texpect(extractRequiredDynamicVariableContext(val).$CURRENT_USER).toEqual(new Set(['id']));","+});"],"additions":17,"deletions":0,"truncated":false},{"path":"api/src/permissions/utils/extract-required-dynamic-variable-context.ts","lines":["@@ -1,5 +1,5 @@"," import type { Permission } from '@directus/types';","-import { deepMap } from '@directus/utils';","+import { isPlainObject } from 'lodash-es';"," "," export interface DynamicVariableContext {"," \t$CURRENT_USER: Set<string>;","@@ -8,13 +8,33 @@ export interface DynamicVariableContext {"," \t$CURRENT_POLICIES: Set<string>;"," }"," ","-export function extractRequiredDynamicVariableContextForPermissions(permissions: Permission[]) {","-\tlet permissionContext: DynamicVariableContext = {","+const placeholders = ['$CURRENT_USER', '$CURRENT_ROLE', '$CURRENT_ROLES', '$CURRENT_POLICIES'] as const;","+","+export function createDynamicVariableContext(): DynamicVariableContext {","+\treturn {"," \t\t$CURRENT_USER: new Set<string>(),"," \t\t$CURRENT_ROLE: new Set<string>(),"," \t\t$CURRENT_ROLES: new Set<string>(),"," \t\t$CURRENT_POLICIES: new Set<string>(),"," \t};","+}","+","+/**","+ * Records the field a single `$CURRENT_*` reference needs. Exposed separately so a walk that","+ * already visits every value can collect the context in passing, instead of making a second pass.","+ */","+export function collectDynamicVariableContext(value: unknown, context: DynamicVariableContext): void {","+\tif (typeof value !== 'string') return;","+","+\tfor (const placeholder of placeholders) {","+\t\tif (value.startsWith(`${placeholder}.`)) {","+\t\t\tcontext[placeholder].add(value.slice(placeholder.length + 1));","+\t\t}","+\t}","+}","+","+export function extractRequiredDynamicVariableContextForPermissions(permissions: Permission[]) {","+\tlet permissionContext = createDynamicVariableContext();"," "," \tfor (const permission of permissions) {"," \t\tpermissionContext = mergeContexts(permissionContext, extractRequiredDynamicVariableContext(permission.permissions));","@@ -26,30 +46,30 @@ export function extractRequiredDynamicVariableContextForPermissions(permissions:"," \treturn permissionContext;"," }"," ","-export function extractRequiredDynamicVariableContext(val: any) {","-\tconst permissionContext: DynamicVariableContext = {","-\t\t$CURRENT_USER: new Set<string>(),","-\t\t$CURRENT_ROLE: new Set<string>(),","-\t\t$CURRENT_ROLES: new Set<string>(),","-\t\t$CURRENT_POLICIES: new Set<string>(),","-\t};","-","-\tdeepMap(val, extractPermissionData);","+/**","+ * Iterative rather than recursive, so input deeper than the call stack allows is walked rather","+ * than overflowing.","+ */","+export function extractRequiredDynamicVariableContext(val: any): DynamicVariableContext {","+\tconst context = createDynamicVariableContext();","+\tconst stack: unknown[] = isContainer(val) ? [val] : [];"," ","-\treturn permissionContext;","+\twhile (stack.length > 0) {","+\t\tconst value = stack.pop();"," ","-\tfunction extractPermissionData(val: any) {","-\t\tfor (const placeholder of [","-\t\t\t'$CURRENT_USER',","-\t\t\t'$CURRENT_ROLE',","-\t\t\t'$CURRENT_ROLES',","-\t\t\t'$CURRENT_POLICIES',","-\t\t] as (keyof typeof permissionContext)[]) {","-\t\t\tif (typeof val === 'string' && val.startsWith(`${placeholder}.`)) {","-\t\t\t\tpermissionContext[placeholder].add(val.replace(`${placeholder}.`, ''));","-\t\t\t}","+\t\tif (isContainer(value)) {","+\t\t\tfor (const child of Object.values(value)) stack.push(child);","+\t\t\tcontinue;"," \t\t}","+","+\t\tcollectDynamicVariableContext(value, context);"," \t}","+","+\treturn context;","+}","+","+function isContainer(value: unknown): value is object {","+\treturn Array.isArray(value) || isPlainObject(value);"," }"," "," function mergeContexts(context1: DynamicVariableContext, context2: DynamicVariableContext) {"],"additions":43,"deletions":23,"truncated":false},{"path":"api/src/services/files/utils/parse-image-metadata.test.ts","lines":["@@ -0,0 +1,84 @@","+import { describe, expect, test } from 'vitest';","+import { parseXmp } from './parse-image-metadata.js';","+","+const xmp = (source: string) => parseXmp(Buffer.from(source));","+","+describe('parseXmp', () => {","+\ttest('reads the fields of a packet', () => {","+\t\tconst packet = `<?xpacket begin=\"\" id=\"W5M0MpCehiHzreSzNTczkc9d\"?><x:xmpmeta xmlns:x=\"adobe:ns:meta/\">","+\t\t\t<rdf:RDF><rdf:Description>","+\t\t\t\t<dc:title><rdf:Alt><rdf:li xml:lang=\"x-default\">A photo</rdf:li></rdf:Alt></dc:title>","+\t\t\t\t<dc:subject><rdf:Bag><rdf:li>sky</rdf:li><rdf:li>sea</rdf:li></rdf:Bag></dc:subject>","+\t\t\t\t<dc:creator><rdf:Seq><rdf:li>Ada</rdf:li></rdf:Seq></dc:creator>","+\t\t\t</rdf:Description></rdf:RDF></x:xmpmeta><?xpacket end=\"w\"?>`;","+","+\t\texpect(xmp(packet)).toStrictEqual({ title: 'A photo', subject: ['sky', 'sea'], creator: 'Ada' });","+\t});","+","+\ttest('reads a plain value', () => {","+\t\texpect(xmp('<dc:title>Hello world</dc:title>')).toStrictEqual({ title: 'Hello world' });","+\t});","+","+\ttest('reads a value spanning several lines', () => {","+\t\texpect(xmp('<dc:title>line one\\nline two</dc:title>')).toStrictEqual({ title: 'line one\\nline two' });","+\t});","+","+\ttest('trims the surrounding whitespace', () => {","+\t\texpect(xmp('<dc:title>   padded   </dc:title>')).toStrictEqual({ title: 'padded' });","+\t});","+","+\ttest('strips markup from inside a value', () => {","+\t\texpect(xmp('<dc:description><p>bold <b>bit</b></p></dc:description>')).toStrictEqual({ description: 'bold bit' });","+\t});","+","+\ttest('collects the items of a bag', () => {","+\t\texpect(xmp('<dc:subject><rdf:bag><rdf:li>a</rdf:li><rdf:li>b</rdf:li></rdf:bag></dc:subject>')).toStrictEqual({","+\t\t\tsubject: ['a', 'b'],","+\t\t});","+\t});","+","+\ttest('stops collecting at an unclosed item', () => {","+\t\texpect(xmp('<dc:subject><rdf:bag><rdf:li>a</rdf:li><rdf:li>b</rdf:bag></dc:subject>')).toStrictEqual({","+\t\t\tsubject: ['a'],","+\t\t});","+\t});","+","+\ttest('only treats a bag as a list when the value opens with one', () => {","+\t\texpect(xmp('<dc:subject>text <rdf:bag><rdf:li>x</rdf:li></rdf:bag></dc:subject>')).toStrictEqual({","+\t\t\tsubject: 'text x',","+\t\t});","+\t});","+","+\ttest.each([","+\t\t['uppercase', '<DC:TITLE>Shouty</DC:TITLE>', 'Shouty'],","+\t\t['mixed case', '<Dc:Title>Mixed</dC:tItLe>', 'Mixed'],","+\t])('matches tags in %s', (_label, source, expected) => {","+\t\texpect(xmp(source)).toStrictEqual({ title: expected });","+\t});","+","+\ttest('keeps an empty value', () => {","+\t\texpect(xmp('<dc:title></dc:title>')).toStrictEqual({ title: '' });","+\t});","+","+\ttest('takes the first of several values', () => {","+\t\texpect(xmp('<dc:title>first</dc:title><dc:title>second</dc:title>')).toStrictEqual({ title: 'first' });","+\t});","+","+\ttest('ignores a closing tag that precedes the opening one', () => {","+\t\texpect(xmp('</dc:title><dc:title>after</dc:title>')).toStrictEqual({ title: 'after' });","+\t});","+","+\ttest.each([","+\t\t['there are no tags', 'not xmp at all'],","+\t\t['the tag is never closed', '<dc:title>never ends'],","+\t])('reports no field when %s', (_label, source) => {","+\t\texpect(xmp(source)).toStrictEqual({});","+\t});","+","+\ttest('finishes on a packet of opening tags that are never closed', () => {","+\t\t// The pattern was `<dc:title>(.*?)</dc:title>`, which scans to the end of the packet for every","+\t\t// opening tag. At this size that took ~11s, so a regression fails on the test timeout rather","+\t\t// than on a measured duration.","+\t\texpect(xmp('<dc:title>'.repeat(100_000))).toStrictEqual({});","+\t});","+});"],"additions":84,"deletions":0,"truncated":false},{"path":"api/src/services/files/utils/parse-image-metadata.ts","lines":["@@ -50,35 +50,56 @@ export function parseIptc(buffer: Buffer): Record<string, unknown> {"," \treturn iptc;"," }"," ","-export function parseXmp(buffer: Buffer): Record<string, unknown> {","-\tconst xmp: Record<string, unknown> = {};","+function readTag(source: string, tag: string, offset = 0): { value: string; end: number } | undefined {","+\tconst openTagPattern = new RegExp(`<${tag}>`, 'gi');","+\topenTagPattern.lastIndex = offset;"," ","-\t['title', 'description', 'rights', 'creator', 'subject'].forEach((x) => {","-\t\tconst tagRegex = new RegExp(`<dc:${x}>(.*?)</dc:${x}>`, 'smig'),","-\t\t\ttagMatches = tagRegex.exec(buffer.toString());","+\tif (openTagPattern.exec(source) === null) return;"," ","-\t\tif (!tagMatches || tagMatches.length === 0) {","-\t\t\treturn;","-\t\t}","+\tconst valueStart = openTagPattern.lastIndex;","+\tconst closeTagPattern = new RegExp(`</${tag}>`, 'gi');","+\tcloseTagPattern.lastIndex = valueStart;"," ","-\t\tconst value = tagMatches[1]?.trim();","+\tconst closeTagMatch = closeTagPattern.exec(source);"," ","-\t\tif (value?.toLowerCase().indexOf('<rdf:bag>') === 0) {","-\t\t\tconst r = new RegExp('<rdf:li>(.*?)</rdf:li>', 'smig');","-\t\t\tlet match = r.exec(value);","-\t\t\tconst result = [];","+\tif (closeTagMatch === null) return;"," ","-\t\t\twhile (match) {","-\t\t\t\tresult.push(match[1]);","+\tconst tagEnd = closeTagPattern.lastIndex;","+\tconst valueEnd = closeTagMatch.index;","+\tconst value = source.slice(valueStart, valueEnd);"," ","-\t\t\t\tmatch = r.exec(value);","-\t\t\t}","+\treturn { value, end: tagEnd };","+}"," ","-\t\t\txmp[x] = result;","+function readTagList(source: string, tag: string): string[] {","+\tconst items: string[] = [];","+\tlet item = readTag(source, tag);","+","+\twhile (item) {","+\t\titems.push(item.value);","+\t\titem = readTag(source, tag, item.end);","+\t}","+","+\treturn items;","+}","+","+export function parseXmp(buffer: Buffer): Record<string, unknown> {","+\tconst xmp: Record<string, unknown> = {};","+\tconst source = buffer.toString();","+","+\tfor (const name of ['title', 'description', 'rights', 'creator', 'subject']) {","+\t\tconst tag = readTag(source, `dc:${name}`);","+","+\t\tif (tag === undefined) continue;","+","+\t\tconst value = tag.value.trim();","+","+\t\tif (value.toLowerCase().startsWith('<rdf:bag>')) {","+\t\t\txmp[name] = readTagList(value, 'rdf:li');"," \t\t} else {","-\t\t\txmp[x] = value?.replace(/<[^>]*>?/gm, '').trim();","+\t\t\txmp[name] = value.replace(/<[^>]*>?/gm, '').trim();"," \t\t}","-\t});","+\t}"," "," \treturn xmp;"," }"],"additions":41,"deletions":20,"truncated":false},{"path":"api/src/services/graphql/rules/get-validation-rules.test.ts","lines":["@@ -1,13 +1,15 @@","-import { useEnv } from '@directus/env';"," import { NoSchemaIntrospectionCustomRule } from 'graphql';"," import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';","-import { mockEnv } from '../../../test-utils/env.js';","+import { resetEnv, setEnv } from '../../../test-utils/env.js';"," import { BlockFieldSuggestionsRule, getValidationRules } from './index.js';"," ","-vi.mock('@directus/env', () => ({ useEnv: vi.fn() }));","+vi.mock('@directus/env', async () => {","+\tconst { mockUseEnv } = await import('../../../test-utils/env.js');","+\treturn mockUseEnv();","+});"," "," beforeEach(() => {","-\tvi.mocked(useEnv).mockReturnValue(mockEnv({ GRAPHQL_INTROSPECTION: true }));","+\tresetEnv();"," });"," "," afterEach(() => {","@@ -23,7 +25,7 @@ describe('getValidationRules', () => {"," \t});"," "," \ttest('adds the introspection rules when introspection is disabled', () => {","-\t\tvi.mocked(useEnv).mockReturnValue(mockEnv({ GRAPHQL_INTROSPECTION: false }));","+\t\tsetEnv({ GRAPHQL_INTROSPECTION: false });"," "," \t\tconst rules = getValidationRules();"," "],"additions":7,"deletions":5,"truncated":false},{"path":"api/src/services/graphql/rules/get-validation-rules.ts","lines":["@@ -2,6 +2,7 @@ import { useEnv } from '@directus/env';"," import type { ValidationRule } from 'graphql';"," import { NoSchemaIntrospectionCustomRule, specifiedRules } from 'graphql';"," import { BlockFieldSuggestionsRule } from './block-field-suggestions.js';","+import { limitSelections } from './limit-selections.js';"," import { limitSensitiveMutations } from './limit-sensitive-mutations.js';"," "," export interface GetValidationRulesOptions {","@@ -14,7 +15,11 @@ export interface GetValidationRulesOptions {"," export function getValidationRules({ operationName }: GetValidationRulesOptions = {}): ValidationRule[] {"," \tconst { GRAPHQL_INTROSPECTION } = useEnv();"," ","-\tconst rules: ValidationRule[] = [...specifiedRules, limitSensitiveMutations(operationName)];","+\tconst rules: ValidationRule[] = [","+\t\t...specifiedRules,","+\t\tlimitSensitiveMutations(operationName),","+\t\tlimitSelections(operationName),","+\t];"," "," \tif (!GRAPHQL_INTROSPECTION) {"," \t\trules.push(NoSchemaIntrospectionCustomRule);"],"additions":6,"deletions":1,"truncated":false},{"path":"api/src/services/graphql/rules/index.ts","lines":["@@ -1,3 +1,4 @@"," export { BlockFieldSuggestionsRule } from './block-field-suggestions.js';","+export { countSelections, limitSelections } from './limit-selections.js';"," export { assertSensitiveMutationLimit, limitSensitiveMutations } from './limit-sensitive-mutations.js';"," export { getValidationRules, type GetValidationRulesOptions } from './get-validation-rules.js';"],"additions":1,"deletions":0,"truncated":false},{"path":"api/src/services/graphql/rules/limit-selections.test.ts","lines":["@@ -0,0 +1,140 @@","+import { buildSchema, parse, specifiedRules, validate } from 'graphql';","+import { beforeEach, describe, expect, test, vi } from 'vitest';","+import { useLogger } from '../../../logger/index.js';","+import { resetEnv, setEnv } from '../../../test-utils/env.js';","+import { createMockLogger } from '../../../test-utils/logger.js';","+import { countSelections, limitSelections } from './limit-selections.js';","+","+vi.mock('@directus/env', async () => {","+\tconst { mockUseEnv } = await import('../../../test-utils/env.js');","+\treturn mockUseEnv();","+});","+","+vi.mock('../../../logger/index.js');","+","+let logger: ReturnType<typeof createMockLogger>;","+","+beforeEach(() => {","+\tresetEnv();","+","+\tlogger = createMockLogger();","+\tvi.mocked(useLogger).mockReturnValue(logger as any);","+});","+","+const schema = buildSchema(`","+\ttype Role { id: ID, users: [User] }","+\ttype User { id: ID, email: String, role: Role }","+\ttype Query { users: [User], roles: [Role] }","+`);","+","+/** `Fi { a: role { users { ...Fi-1 } } b: role { users { ...Fi-1 } } }`, which expands to 2^depth paths */","+function buildAliasChain(depth: number) {","+\tconst fragments = ['fragment F0 on User { id }'];","+","+\tfor (let level = 1; level <= depth; level++) {","+\t\tconst nested = `role { users { ...F${level - 1} } }`;","+\t\tfragments.push(`fragment F${level} on User { a: ${nested} b: ${nested} }`);","+\t}","+","+\treturn `query { users { ...F${depth} } } ${fragments.join(' ')}`;","+}","+","+function count(query: string) {","+\tconst document = parse(query);","+","+\tconst fragments = new Map(","+\t\tdocument.definitions.flatMap((d) => (d.kind === 'FragmentDefinition' ? [[d.name.value, d]] : [])),","+\t);","+","+\tconst operation = document.definitions.find((d) => d.kind === 'OperationDefinition')!;","+","+\treturn countSelections(operation.selectionSet, (name) => fragments.get(name));","+}","+","+function validateQuery(query: string, operationName?: string) {","+\treturn validate(schema, parse(query), [...specifiedRules, limitSelections(operationName)]);","+}","+","+describe('countSelections', () => {","+\ttest('counts every field, nested ones included', () => {","+\t\texpect(count('{ users { id role { id } } }')).toBe(4);","+\t});","+","+\ttest('counts the fields of a fragment everywhere it is spread', () => {","+\t\texpect(count('{ users { ...F role { users { ...F } } } } fragment F on User { id email }')).toBe(7);","+\t});","+","+\ttest('counts the fields of inline fragments', () => {","+\t\texpect(count('{ users { ... on User { id } } }')).toBe(2);","+\t});","+","+\ttest('counts a fragment spread twice into the same selection set twice', () => {","+\t\texpect(count('{ users { ...F ...F } } fragment F on User { id }')).toBe(3);","+\t});","+","+\ttest('counts a chain of aliased spreads without expanding it', () => {","+\t\t// 2^40 paths, which only terminates because each fragment is sized once","+\t\texpect(count(buildAliasChain(40))).toBeGreaterThan(2 ** 40);","+\t});","+","+\ttest('does not recurse forever on a fragment cycle', () => {","+\t\texpect(count('{ users { ...A } } fragment A on User { id ...B } fragment B on User { ...A }')).toBe(2);","+\t});","+","+\ttest('ignores unknown fragments', () => {","+\t\texpect(count('{ users { ...Missing } }')).toBe(1);","+\t});","+});","+","+describe('limitSelections', () => {","+\ttest('allows an operation within the limit', () => {","+\t\texpect(validateQuery('{ users { id email role { id } } }')).toEqual([]);","+\t});","+","+\ttest('rejects an aliased fragment chain before it is expanded', () => {","+\t\tconst errors = validateQuery(buildAliasChain(18));","+","+\t\texpect(errors).toHaveLength(1);","+\t\texpect(errors[0]?.message).toContain('maximum allowed selection count of 10000');","+\t});","+","+\ttest('rejects a chain of fragments that each spread the one below twice', () => {","+\t\t// `Fk { ...Fk-1 ...Fk-1 }` expands to 2^k fields without a single alias","+\t\tconst fragments = ['fragment F0 on User { id }'];","+","+\t\tfor (let level = 1; level <= 20; level++) {","+\t\t\tfragments.push(`fragment F${level} on User { ...F${level - 1} ...F${level - 1} }`);","+\t\t}","+","+\t\texpect(validateQuery(`query { users { ...F20 } } ${fragments.join(' ')}`)).toHaveLength(1);","+\t});","+","+\ttest('counts the root fields of an operation together', () => {","+\t\tsetEnv({ GRAPHQL_QUERY_SELECTION_LIMIT: 3 });","+","+\t\texpect(validateQuery('{ users { id } }')).toEqual([]);","+\t\texpect(validateQuery('{ users { id } roles { id } }')).toHaveLength(1);","+\t});","+","+\ttest('only checks the operation that will be executed', () => {","+\t\tsetEnv({ GRAPHQL_QUERY_SELECTION_LIMIT: 2 });","+","+\t\tconst query = 'query Small { users { id } } query Large { users { id email } }';","+","+\t\texpect(validateQuery(query, 'Small')).toEqual([]);","+\t\texpect(validateQuery(query, 'Large')).toHaveLength(1);","+\t});","+","+\ttest('falls back to the default for an invalid limit, and says so', () => {","+\t\tsetEnv({ GRAPHQL_QUERY_SELECTION_LIMIT: 'nope' });","+","+\t\texpect(validateQuery(buildAliasChain(18))[0]?.message).toContain('10000');","+\t\texpect(logger.warn).toHaveBeenCalledWith('Invalid value for GRAPHQL_QUERY_SELECTION_LIMIT, falling back to 10000.');","+\t});","+","+\ttest('honors Infinity as an opt-out', () => {","+\t\tsetEnv({ GRAPHQL_QUERY_SELECTION_LIMIT: Infinity });","+","+\t\texpect(validateQuery(buildAliasChain(18))).toEqual([]);","+\t});","+});"],"additions":140,"deletions":0,"truncated":false},{"path":"api/src/services/graphql/rules/limit-selections.ts","lines":["@@ -0,0 +1,81 @@","+import type { FragmentDefinitionNode, SelectionSetNode, ValidationRule } from 'graphql';","+import { GraphQLError, Kind } from 'graphql';","+import { limitFromEnv } from '../../../utils/query-limits.js';","+","+/**","+ * Count the fields an operation selects once every fragment in it is expanded, as the resolvers","+ * will expand them.","+ *","+ * Fragments let a document reuse a selection set under any number of fields, so the expanded size","+ * can grow exponentially with the size of the document, e.g. `Fk { a: f { ...Fk-1 } b: f { ...Fk-1 } }`.","+ * Each fragment's size is therefore computed once and reused, which keeps this linear in the size","+ * of the document no matter how large the expansion is.","+ *","+ * Every spread is counted, a repeated one included, because `buildSelections` expands every spread.","+ */","+export function countSelections(","+\tselectionSet: SelectionSetNode,","+\tgetFragment: (name: string) => FragmentDefinitionNode | null | undefined,","+): number {","+\tconst fragmentSizes = new Map<string, number>();","+","+\tconst count = (selectionSet: SelectionSetNode): number => {","+\t\tlet total = 0;","+","+\t\tfor (const selection of selectionSet.selections) {","+\t\t\tif (selection.kind === Kin