{"id":"4daebc813e16b39a5e72163dd44f47a561a83597","axis":"silent","repo":"rust-lang/rust","sha":"4daebc813e16b39a5e72163dd44f47a561a83597","parsed":{"files":[{"path":"library/std/src/sys/thread_local/guard/aix.rs","lines":["@@ -0,0 +1,30 @@","+//! AIX registers thread destructors using `__pt_atexit_np`.","+//! Calling it registers a callback that runs on thread termination","+//! and upon process exit (for the main thread).","+","+use crate::cell::Cell;","+use crate::sys::thread_local::destructors;","+","+pub fn enable() {","+    #[thread_local]","+    static REGISTERED: Cell<bool> = Cell::new(false);","+","+    unsafe extern \"C\" {","+        fn __pt_atexit_np(flags: i32, dtor: unsafe extern \"C\" fn(i32) -> i32) -> i32;","+    }","+","+    if !REGISTERED.replace(true) {","+        let ret = unsafe { __pt_atexit_np(0, run_dtors) };","+        if ret != 0 {","+            rtabort!(\"failed to register thread destructor\");","+        }","+    }","+","+    unsafe extern \"C\" fn run_dtors(_: i32) -> i32 {","+        unsafe {","+            destructors::run();","+            crate::rt::thread_cleanup();","+        }","+        0","+    }","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"library/std/src/sys/thread_local/mod.rs","lines":["@@ -101,6 +101,10 @@ pub(crate) mod guard {","             mod apple;","             pub(crate) use apple::enable;","         }","+        all(target_thread_local, target_os = \"aix\") => {","+            mod aix;","+            pub(crate) use aix::enable;","+        }","         target_os = \"windows\" => {","             mod windows;","             pub(crate) use windows::enable;"],"additions":4,"deletions":0,"truncated":false},{"path":"tests/run-make/dynamic-loading-cdylib/load_and_unload.rs","lines":["@@ -48,6 +48,8 @@ mod libloading {","     use std::ffi::{c_char, c_int, c_void};"," ","     const RTLD_NOW: c_int = 2;","+    #[cfg(target_os = \"aix\")]","+    const RTLD_MEMBER: c_int = 0x00040000;"," ","     fn cstr_null(s: &str) -> Vec<c_char> {","         assert!(!s.as_bytes().contains(&0), \"string must not contain interior NUL\");","@@ -58,10 +60,17 @@ mod libloading {","         #[cfg(target_os = \"macos\")]","         let filename = cstr_null(&format!(\"lib{}.dylib\", lib_name));"," ","-        #[cfg(not(target_os = \"macos\"))]","+        #[cfg(target_os = \"aix\")]","+        let filename = cstr_null(&format!(\"./lib{0}.a(lib{0}.so)\", lib_name));","+","+        #[cfg(not(any(target_os = \"macos\", target_os = \"aix\")))]","         let filename = cstr_null(&format!(\"./lib{}.so\", lib_name));"," ","-        let handle = unsafe { dlopen(filename.as_ptr(), RTLD_NOW) };","+        let flags = RTLD_NOW;","+        #[cfg(target_os = \"aix\")]","+        let flags = flags | RTLD_MEMBER;","+","+        let handle = unsafe { dlopen(filename.as_ptr(), flags) };","         if handle.is_null() { None } else { Some(handle) }","     }"," "],"additions":11,"deletions":2,"truncated":false},{"path":"tests/run-make/dynamic-loading-cdylib/rmake.rs","lines":["@@ -5,21 +5,29 @@"," // - `foo.rs` is a cdylib."," // - `load_and_unload.rs` is a binary that loads and unloads the cdylib."," //","-// This test is ignored on musl hosts because musl's dlclose is a no-op and","-// therefore destructors won't run when the library is unloaded.","-// See https://wiki.musl-libc.org/functional-differences-from-glibc.html#Unloading-libraries"," "," //@ ignore-cross-compile","-//@ ignore-musl"," "," use run_make_support::{diff, run_with_args, rustc};"," ","+// On musl and AIX, `dlclose` does not invoke TLS destructors upon unloading,","+// so only the `load_only` case is tested on those platforms.","+//","+// Reference for musl:","+// https://wiki.musl-libc.org/functional-differences-from-glibc.html#Unloading-libraries","+","+#[cfg(any(target_env = \"musl\", target_os = \"aix\"))]","+const TEST_MODES: &[&str] = &[\"load_only\"];","+","+#[cfg(not(any(target_env = \"musl\", target_os = \"aix\")))]","+const T