!self.extra_output.contains(&selection) {","+                self.extra_output.push(selection);","+            }","+        }","+    }","+","     /// Enables build infos for a debug run, which reads the compiled sources from them. Unless","     /// build infos were already enabled, they leave out the AST, which debug runs do not use.","     ///","@@ -7829,6 +7856,28 @@ mod tests {","         assert!(requests_ast(&config));","     }"," ","+    #[test]","+    fn internal_call_artifacts_request_both_function_tables_only() {","+        let requested = |config: &Config| {","+            let settings = config.solc_settings().unwrap().settings;","+            let outputs = &settings.output_selection.as_ref()[\"*\"];","+            (","+                outputs.contains_key(\"\"),","+                outputs[\"*\"].iter().any(|output| output == \"evm.bytecode.functionDebugData\"),","+                outputs[\"*\"]","+                    .iter()","+                    .any(|output| output == \"evm.deployedBytecode.functionDebugData\"),","+            )","+        };","+","+        let mut config = Config::default();","+        assert_eq!(requested(&config), (false, false, false));","+        config.enable_internal_call_artifacts();","+        config.enable_internal_call_artifacts();","+        assert_eq!(requested(&config), (false, true, true));","+        assert_eq!(config.extra_output.len(), 2);","+    }","+","     #[test]","     fn tempo_network_defaults_to_latest_tempo_hardfork() {","         figment::Jail::expect_with(|jail| {"],"additions":50,"deletions":1,"truncated":false},{"path":"crates/debugger/src/soldb.rs","lines":["@@ -1020,7 +1020,11 @@ mod tests {","                 source: Arc::new(\"contract C {}\".to_string()),","                 language: Default::default(),","                 path: PathBuf::from(\"src/C.sol\"),","-                contract_definitions: Vec::new(),","+                functions: Default::default(),","+                call_sites: Default::default(),","+                contract_bases: Vec::new(),","+                contract_libraries: Vec::new(),","+                source_edits: Vec::new(),","             }),","         );","         sources.artifacts_by_name.insert(","@@ -1033,6 +1037,9 @@ mod tests {","                 build_id: \"build\".to_string(),","                 file_id: 0,","                 via_ir: Some(false),","+                functions: Default::default(),","+                functions_runtime: Default::default(),","+                selectors: Default::default(),","             }],","         );","         let mut arena = CallTraceArena::default();"],"additions":8,"deletions":1,"truncated":false},{"path":"crates/evm/traces/src/debug/functions.rs","lines":["@@ -0,0 +1,848 @@","+//! Functions, modifiers, and getters of a Solar AST, found by the offset where solc's source map","+//! places their definition.","+//!","+//! solc's `functionDebugData` lists an internal function by the offset of its entry `JUMPDEST`,","+//! and the source map puts that instruction at the start of the function's definition. The Solar","+//! AST that Foundry parses for every source file holds the definition there, with the contract it","+//! is in, its name, and its parameters. Solar resolves the types of the parameters when it lowers","+//! the sources to its HIR, which is what the types of the functions come from.","+","+use super::Param;","+use alloy_dyn_abi::{DynSolType, parser::Storage};","+use solar::{","+    ast::{","+        DataLocation, ElementaryType, Expr, ExprKind, FunctionKind, Item, ItemFunction, ItemKind,","+        SourceUnit, Type, TypeKind, VariableDefinition, Visibility,","+        visit::Visit,","+        yul::{self, StmtKind as YulStmtKind},","+    },","+    data_structures::Never,","+    interface::{Ident, source_map::SourceMap},","+    sema::{","+        Gcx,","+        hir::ItemId,","+        ty::{Ty, TyKind},","+    },","+};","+use std::{","+    collections::HashMap,","+    hash::{DefaultHasher, Hash, Hasher},","+    ops::ControlFlow,","+    sync::Arc,","+};","+","+/// What a source declares: its functions by the offset of their definition, the bases of its","+/// contracts, and whether each contract is a library.","+#[derive(Debug, Default)]","+pub struct Declarations {","+    pub functions: HashMap<usize, Arc<SourceFunction>>,","+    pub bases: Vec<(String, Vec<String>)>,","+    /// The contracts by name, and whether they are libraries.","+    pub libraries: Vec<(String, bool)>,","+}","+","+/// The types of the parameters and return values of a function that Solar resolved.","+#[derive(Clone, Debug)]","+pub struct ResolvedTypes {","+    params: Vec<ResolvedType>,","+    returns: Vec<ResolvedType>,","+}","+","+/// The type of a parameter or return value that Solar resolved.","+#[derive(Clone, Debug)]","+struct ResolvedType {","+    /// The type that its stack words can be decoded as. Structs and function types are not.","+    decodable: Option<DynSolType>,","+    abi: AbiType,","+    /// The name that the signature of a library function spells for the type: enums, structs and","+    /// contracts by name, and storage pointers with `storage`.","+    library_name: Option<String>,","+}","+","+/// A function, modifier, public state variable getter, or Yul function.","+#[derive(Clone, Debug)]","+pub struct SourceFunction {","+    /// The contract that defines it. Free functions have none.","+    pub contract: Option<String>,","+    /// The name of the function, modifier, or variable.","+    pub name: String,","+    /// Whether the dispatcher or the call frame itself enters it, which is then the external call","+    /// that the trace shows already, such as a public function or getter.","+    pub is_entry: bool,","+    /// Whether it is a function of an inline assembly block. Those have no types: every value is","+    /// a word.","+    pub is_yul: bool,","+    /// A hash of the body without spaces and of the parameter and return types, with the names of","+    /// the parameters and return values replaced by their positions, for telling which functions","+    /// can have the same code. `None` for getters and functions without a body.","+    pub body_hash: Option<u64>,","+    /// The parameters, or `None` for a getter, whose parameters the AST does not list.","+    pub(super) params: Option<Vec<SourceParam>>,","+    /// The return values, or `None` for a getter.","+    pub(super) returns: Option<Vec<SourceParam>>,","+}","+","+/// A function that has run, with the types of its parameters and return values.","+#[derive(Clone, Debug)]","+pub struct FunctionInfo {","+    /// `Contract::name(types)`, or `Contract::name` when a type has no canonical name. Free","+    /// functions have no contract.","+    pub name: String,","+    /// The parameters, or `None` if they are unknown.","+    pub params: Option<Vec<Param>>,","+    /// The return values, or `None` if they are unknown.","+    pub returns: Option<Vec<Param>>,","+    /// The name that the function is declared with, which the ABI spells too.","+    pub declared_name: String,","+    /// What the ABI spells for each parameter, or `None` if the parameters are not known.","+    pub abi_types: Option<Vec<AbiType>>,","+    /// The signature that a library dispatches this function by.","+    pub library_signature: LibrarySignature,","+    /// Whether the dispatcher or the call frame itself enters it.","+    pub is_entry: bool,","+    /// The names of the functions without an entry point that the compiler may have merged into","+    /// this function, because they take and leave as many words and have the same code. A call","+    /// to the entry can be a call to any of them.","+    pub merged: Vec<String>,","+}","+","+/// What the ABI spells for a parameter of a function.","+#[derive(Clone, Debug, PartialEq, Eq)]","+pub enum AbiType {","+    /// The name that the ABI spells, such as `uint256[]` or `(uint256,address)` for a struct.","+    Known(String),","+    /// A type that Solar did not resolve.","+    Unknown,","+}","+","+/// The signature that a library dispatches a function by, which spells enums, structs and","+/// contracts by name and storage pointers with `storage`.","+#[derive(Clone, Debug, PartialEq, Eq)]","+pub enum LibrarySignature {","+    /// The types of the parameters are not known.","+    Unknown,","+    /// A parameter has a type that no external function takes, an internal function type, so the","+    /// function is not dispatched.","+    Internal,","+    Exact(String),","+}","+","+impl FunctionInfo {","+    /// Whether `signature`, as the ABI spells it, can be the signature of this function. The","+    /// parameters that are not known match any type.","+    pub fn matches_signature(&self, signature: &str) -> bool {","+        let Some((name, arguments)) = signature.split_once('(') else { return false };","+        if name != self.declared_name {","+            return false;","+        }","+        let Some(types) = &self.abi_types else { return true };","+        let Some(arguments) = arguments.strip_suffix(')') else { return false };","+        // Split at the commas outside tuples.","+        let mut depth = 0;","+        let mut arguments = arguments","+            .split(|c| {","+                match c {","+                    '(' => depth += 1,","+                    ')' => depth -= 1,","+                    _ => {}","+                }","+                c == ',' && depth == 0","+            })","+            .filter(|argument| !argument.is_empty());","+        let matches = types.iter().all(|ty| {","+            arguments.next().is_some_and(|argument| match ty {","+                AbiType::Known(known) => known == argument,","+                AbiType::Unknown => true,","+            })","+        });","+        matches && arguments.next().is_none()","+    }","+","+    /// A function that only the name is known of.","+    pub fn untyped(name: String, is_entry: bool) -> Self {","+        Self {","+            declared_name: name.clone(),","+            name,","+            params: None,","+            returns: None,","+            abi_types: None,","+            library_signature: LibrarySignature::Unknown,","+            is_entry,","+            merged: Vec::new(),","+        }","+    }","+}","+","+#[derive(Clone, Debug)]","+pub(super) struct SourceParam {","+    ty: ResolvedType,","+    storage: Option<Storage>,","+    /// The number of stack words the value takes.","+    slots: usize,","+}","+","+impl SourceFunction {","+    /// The types of the parameters and return values.","+    pub fn info(&self) -> FunctionInfo {","+        let params = |params: &Option<Vec<SourceParam>>| {","+            params.as_ref().map(|params| {","+                params","+                    .iter()","+                    .map(|param| Param {","+                        ty: param.ty.decodable.clone(),","+                        storage: param.storage,","+                        slots: param.slots,","+                    })","+                    .collect::<Vec<_>>()","+            })","+        };","+        let params_and_returns = (params(&self.params), params(&self.returns));","+        let (params, returns) = params_and_returns;","+        // A parameter type without a canonical name leaves the name without types, and so do Yul","+        // functions, which have none.","+        let types = params.as_deref().filter(|_| !self.is_yul).and_then(|params| {","+            params","+                .iter()","+                .map(|param| param.ty.as_ref().map(DynSolType::sol_type_name))","+                .collect::<Option<Vec<_>>>()","+        });","+        let signature = types.map(|types| format!(\"{}({})\", self.name, types.join(\",\")));","+        let abi_types = self","+            .params","+            .as_ref()","+            .filter(|_| !self.is_yul)","+            .map(|params| params.iter().map(|param| param.ty.abi.clone()).collect());","+        let library_signature = match self.params.as_ref().filter(|_| !self.is_yul) {","+            None => LibrarySignature::Unknown,","+            Some(params) => params","+                .iter()","+                .map(|param| param.ty.library_name.clone())","+                .collect::<Option<Vec<_>>>()","+                .map_or(LibrarySignature::Internal, |names| {","+                    LibrarySignature::Exact(format!(\"{}({})\", self.name, names.join(\",\")))","+                }),","+        };","+        let spelled = signature.as_ref().unwrap_or(&self.name);","+        let name = match &self.contract {","+            Some(contract) => format!(\"{contract}::{spelled}\"),","+            None => spelled.clone(),","+        };","+        FunctionInfo {","+            name,","+            params,","+            returns,","+            declared_name: self.name.clone(),","+            abi_types,","+            library_signature,","+            is_entry: self.is_entry,","+            merged: Vec::new(),","+        }","+    }","+}","+","+/// Resolves the types of the parameters and return values of the functions of a source, by the","+/// offset of the function, with the types that Solar resolved when it lowered the sources to HIR.","+/// A source that is not lowered has none.","+pub fn resolve_types(","+    gcx: Gcx<'_>,","+    source_map: &SourceMap,","+    path: impl Into<solar::interface::source_map::FileName>,","+) -> HashMap<usize, ResolvedTypes> {","+    let mut resolved = HashMap::new();","+    if gcx.stage().is_none_or(|stage| stage.is_parsing()) {","+        return resolved;","+    }","+    let Some((_, source)) = gcx.get_hir_source(path) else { return resolved };","+    let mut function = |id| {","+        let function = gcx.hir.function(id);","+        if function.gettee.is_some() {","+            return;","+        }","+        let Ok(range) = source_map.span_to_range(function.span) else { return };","+        let types = |variables: &[solar::sema::hir::VariableId]| {","+            variables","+                .iter()","+                .map(|&variable| resolve_type(gcx, gcx.type_of_item(variable.into())))","+                .collect()","+        };","+        resolved.insert(","+            range.start,","+            ResolvedTypes { params: types(function.parameters), returns: types(function.returns) },","+        );","+    };","+    for item in source.items {","+        match item {","+            ItemId::Function(id) => function(*id),","+            ItemId::Contract(id) => gcx.hir.contract(*id).functions().for_each(&mut function),","+            _ => {}","+        }","+    }","+    resolved","+}","+","+fn resolve_type<'gcx>(gcx: Gcx<'gcx>, ty: Ty<'gcx>) -> ResolvedType {","+    let library_name = library_name(gcx, ty, false);","+    match dyn_type(gcx, ty, 0) {","+        Some(dyn_type) => ResolvedType {","+            abi: AbiType::Known(abi_name(&dyn_type)),","+            decodable: Some(dyn_type).filter(|ty| !has_tuple_or_function(ty)),","+            library_name,","+        },","+        None => ResolvedType { decodable: None, abi: AbiType::Unknown, library_name },","+    }","+}","+","+/// The name that the signature of a library function spells for a type: enums, structs and","+/// contracts by their qualified name, user-defined value types as their underlying type (but by","+/// their qualified name inside a mapping), external function types as `function`, and storage","+/// pointers with `storage`.","+fn library_name<'gcx>(gcx: Gcx<'gcx>, ty: Ty<'gcx>, in_mapping: bool) -> Option<String> {","+    Some(match ty.kind {","+        TyKind::Elementary(ty) => abi_name(&elementary(ty)),","+        TyKind::Ref(inner, location) => {","+            let name = library_name(gcx, inner, in_mapping)?;","+            if matches!(location, DataLocation::Storage) { format!(\"{name} storage\") } else { name }","+        }","+        TyKind::Udvt(_, id) if in_mapping => gcx.item_canonical_name(id).to_string(),","+        TyKind::Udvt(inner, _) => return library_name(gcx, inner, in_mapping),","+        TyKind::Array(element, size) => {","+            let size: usize = size.try_into().ok()?;","+            format!(\"{}[{size}]\", library_name(gcx, element, in_mapping)?)","+        }","+        TyKind::DynArray(element) => format!(\"{}[]\", library_name(gcx, element, in_mapping)?),","+        TyKind::Enum(id) => gcx.item_canonical_name(id).to_string(),","+        TyKind::Struct(id) => gcx.item_canonical_name(id).to_string(),","+        TyKind::Contract(id) => gcx.item_canonical_name(id).to_string(),","+        TyKind::Mapping(key, value) => format!(","+            \"mapping({} => {})\",","+            library_name(gcx, key, true)?,","+            library_name(gcx, value, true)?","+        ),","+        TyKind::Fn(function) if function.is_external() => \"function\".to_string(),","+        _ => return None,","+    })","+}","+","+/// The type that the ABI has for a type of Solar: user-defined value types are their underlying","+/// type, enums `uint8`, contracts `address`, and structs tuples of their fields. `depth` stops the","+/// structs that contain themselves.","+fn dyn_type<'gcx>(gcx: Gcx<'gcx>, ty: Ty<'gcx>, depth: usize) -> Option<DynSolType> {","+    Some(match ty.kind {","+        TyKind::Elementary(ty) => elementary(ty),","+        TyKind::Ref(inner, _) | TyKind::Udvt(inner, _) => return dyn_type(gcx, inner, depth),","+        TyKind::Array(element, size) => {","+            DynSolType::FixedArray(Box::new(dyn_type(gcx, element, depth)?), size.try_into().ok()?)","+        }","+        TyKind::DynArray(element) => DynSolType::Array(Box::new(dyn_type(gcx, element, depth)?)),","+        TyKind::Struct(id) if depth < 8 => DynSolType::Tuple(","+            gcx.struct_field_types(id)","+                .iter()","+                .map(|field| dyn_type(gcx, *field, depth + 1))","+                .collect::<Option<Vec<_>>>()?,","+        ),","+        TyKind::Enum(_) => DynSolType::Uint(8),","+        TyKind::Contract(_) => DynSolType::Address,","+        TyKind::Fn(function) if function.is_external() => DynSolType::Function,","+        _ => return None,","+    })","+}","+","+const fn elementary(ty: ElementaryType) -> DynSolType {","+    match ty {","+        ElementaryType::Address(_) => DynSolType::Address,","+        ElementaryType::Bool => DynSolType::Bool,","+        ElementaryType::String => DynSolType::String,","+        ElementaryType::Bytes => DynSolType::Bytes,","+        ElementaryType::Int(size) => DynSolType::Int(size.bits() as usize),","+        ElementaryType::UInt(size) => DynSolType::Uint(size.bits() as usize),","+        ElementaryType::FixedBytes(size) => DynSolType::FixedBytes(size.bytes() as usize),","+    }","+}","+","+/// The name that the ABI spells for a type, with structs as tuples.","+fn abi_name(ty: &DynSolType) -> String {","+    match ty {","+        DynSolType::Tuple(fields) => {","+            format!(\"({})\", fields.iter().map(abi_name).collect::<Vec<_>>().join(\",\"))","+        }","+        DynSolType::Array(element) => format!(\"{}[]\", abi_name(element)),","+        DynSolType::FixedArray(element, size) => format!(\"{}[{size}]\", abi_name(element)),","+        DynSolType::Function => \"function\".to_string(),","+        ty => ty.sol_type_name().into_owned(),","+    }","+}","+","+/// Whether the words of a value of the type are a pointer or a function: not a value to decode.","+fn has_tuple_or_function(ty: &DynSolType) -> bool {","+    match ty {","+        DynSolType::Tuple(_) | DynSolType::Function => true,","+        DynSolType::Array(element) | DynSolType::FixedArray(element, _) => {","+            has_tuple_or_function(element)","+        }","+        _ => false,","+    }","+}","+","+/// Collects the functions of a parsed source file, with the types that `types` has for them by the","+/// offset of their definition.","+///","+/// `declarations.functions` maps the byte offset of each definition in the source to the function.","+pub fn collect<'ast>(","+    ast: &'ast SourceUnit<'ast>,","+    source_map: &SourceMap,","+    types: &HashMap<usize, ResolvedTypes>,","+    declarations: &mut Declarations,","+) {","+    for item in ast.items.iter() {","+        match &item.kind {","+            ItemKind::Contract(contract) => {","+                let name = contract.name.to_string();","+                let bases = contract","+                    .bases","+                    .iter()","+                    .filter_map(|base| base.name.segments().last().map(|last| last.to_string()))","+                    .collect();","+                declarations.bases.push((name.clone(), bases));","+                declarations.libraries.push((name.clone(), contract.kind.is_library()));","+                for member in contract.body.iter() {","+                    collect_item(member, Some(&name), source_map, types, declarations);","+                }","+            }","+            _ => collect_item(item, None, source_map, types, declarations),","+        }","+    }","+}","+","+fn collect_item<'ast>(","+    item: &'ast Item<'ast>,","+    contract: Option<&str>,","+    source_map: &SourceMap,","+    types: &HashMap<usize, ResolvedTypes>,","+    declarations: &mut Declarations,","+) {","+    let Ok(range) = source_map.span_to_range(item.span) else { return };","+    let function = match &item.kind {","+        ItemKind::Function(function) => {","+            let mut yul =","+                YulFunctions { contract, source_map, functions: &mut declarations.functions };","+            let _ = yul.visit_item_function(function);","+            let Some(name) = &function.header.name else { return };","+            let public = matches!(","+                function.header.visibility(),","+                Some(Visibility::Public | Visibility::External)","+            );","+            let returns = function.header.returns.as_ref().map_or(&[][..], |r| r.vars);","+            let resolved = types.get(&range.start);","+      