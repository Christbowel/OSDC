 the base grammar","+\tauto result = con.Query(\"SELECT 1\");","+\tREQUIRE_NO_FAIL(*result);","+\tREQUIRE(result->Collection().GetValue(0, 0) == Value::INTEGER(1));","+\tauto base_grammar = CompiledGrammar::Get(*con.context);","+\t// an explicitly activated grammar, registered and SET before the default-active one exists","+\tRegisterGrammarExtensionTestSyntax(*db.instance);","+\tActivateGrammarExtensionTestSyntax(con);","+\tCheckGrammarExtensionTestSyntax(con);","+","+\t// mid-session registration (what a LOAD does): the next statement parses with the grammar, no SET","+\t// needed, and the default-active grammar composes with the explicitly activated ones: ANSWER still","+\t// parses (its atom transform bypasses AdditiveExpression) and ordinary expressions are rewritten","+\tGrammarExtension::Register(*db.instance, make_shared_ptr<DefaultActiveSevenGrammarExtension>(\"default_seven\"));","+\tCheckGrammarExtensionTestSyntax(con);","+\tRequireSeven(con);","+\tREQUIRE(CompiledGrammar::Get(*con.context) != base_grammar);","+","+\t// connections opened after the registration parse with it without any SET","+\tConnection later(db);","+\tRequireSeven(later);","+","+\t// clearing the explicit list drops ANSWER but does not deactivate the default-active grammar","+\tREQUIRE_NO_FAIL(*con.Query(\"RESET active_grammar_extensions\"));","+\tRequireSeven(con);","+\tREQUIRE_FAIL(con.Query(\"ANSWER\"));","+}","+"," TEST_CASE(\"The least recently used grammar for active grammar extensions is evicted\", \"[api][grammar_extension]\") {"," \tDuckDB db(nullptr);"," \tstd::atomic<idx_t> compilations(0);",""],"additions":49,"deletions":0,"truncated":false}],"additions":115,"deletions":12,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-05T16:30:07.789632+00:00"}