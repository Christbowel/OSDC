component>","       <component group=\"org.opentest4j\" name=\"opentest4j\" version=\"1.2.0\">"],"additions":89,"deletions":139,"truncated":false},{"path":"x-pack/libs/es-opensaml-security-api/build.gradle","lines":["@@ -13,10 +13,18 @@ apply plugin: 'com.gradleup.shadow'"," "," dependencies {","   implementation \"org.opensaml:opensaml-security-api:${versions.opensaml}\"","-  compileOnly \"org.opensaml:opensaml-core:${versions.opensaml}\"","+  compileOnly \"org.opensaml:opensaml-core-api:${versions.opensaml}\"","+  compileOnly \"org.opensaml:opensaml-core-impl:${versions.opensaml}\"","+  // Embed cryptacular with a patched CertUtil (see CertUtil.java for details).","+  // BC jars are excluded to avoid bundling them in the shadow jar.","+  implementation (\"org.cryptacular:cryptacular:1.3.0\") {","+    exclude group: 'org.bouncycastle'","+  }","+  // Needed to compile the patched CertUtil against org.bouncycastle.asn1.x509 types.","+  compileOnly \"org.bouncycastle:bcprov-jdk18on:${versions.bouncycastle}\""," }"," ","-['jarHell', 'thirdPartyAudit', 'splitPackagesAudit', 'forbiddenApisMain', 'licenseHeaders' ].each {","+['jarHell', 'thirdPartyAudit', 'splitPackagesAudit', 'forbiddenApisMain', 'licenseHeaders', 'checkstyleMain'].each {","   tasks.named(it).configure {","     enabled = false","   }","@@ -24,6 +32,7 @@ dependencies {"," "," tasks.withType(AbstractDependenciesTask).configureEach {","   mapping from: /opensaml-.*/, to: 'shibboleth'","+  mapping from: /cryptacular.*/, to: 'cryptacular'"," }"," "," tasks.named(\"shadowJar\").configure {"],"additions":11,"deletions":2,"truncated":false},{"path":"x-pack/libs/es-opensaml-security-api/licenses/cryptacular-LICENSE.txt","lines":["rename from x-pack/plugin/identity-provider/licenses/cryptacular-LICENSE.txt","rename to x-pack/libs/es-opensaml-security-api/licenses/cryptacular-LICENSE.txt"],"additions":0,"deletions":0,"truncated":false},{"path":"x-pack/libs/es-opensaml-security-api/licenses/cryptacular-NOTICE.txt","lines":["rename from x-pack/plugin/identity-provider/licenses/cryptacular-NOTICE.txt","rename to x-pack/libs/es-opensaml-security-api/licenses/cryptacular-NOTICE.txt"],"additions":0,"deletions":0,"truncated":false},{"path":"x-pack/libs/es-opensaml-security-api/src/main/java/org/cryptacular/util/CertUtil.java","lines":["@@ -0,0 +1,656 @@","+/* See LICENSE for licensing and NOTICE for copyright. */","+","+package org.cryptacular.util;","+","+import org.bouncycastle.asn1.x509.GeneralName;","+import org.bouncycastle.asn1.x509.GeneralNames;","+import org.bouncycastle.asn1.x509.GeneralNamesBuilder;","+import org.bouncycastle.asn1.x509.KeyPurposeId;","+import org.bouncycastle.asn1.x509.KeyUsage;","+import org.bouncycastle.asn1.x509.PolicyInformation;","+import org.cryptacular.CryptUtil;","+import org.cryptacular.EncodingException;","+import org.cryptacular.StreamException;","+import org.cryptacular.codec.Base64Encoder;","+import org.cryptacular.x509.ExtensionReader;","+import org.cryptacular.x509.GeneralNameType;","+import org.cryptacular.x509.KeyUsageBits;","+import org.cryptacular.x509.dn.NameReader;","+import org.cryptacular.x509.dn.StandardAttributeType;","+","+import java.io.ByteArrayInputStream;","+import java.io.File;","+import java.io.IOException;","+import java.io.InputStream;","+import java.nio.ByteBuffer;","+import java.nio.CharBuffer;","+import java.security.KeyPair;","+import java.security.PrivateKey;","+import java.security.cert.Certificate;","+import java.security.cert.CertificateEncodingException;","+import java.security.cert.CertificateException;","+import java.security.cert.CertificateFactory;","+import java.security.cert.X509Certificate;","+import java.time.Duration;","+import java.util.ArrayList;","+import java.util.Arrays;","+import java.util.Collection;","+import java.util.Date;","+import java.util.List;","+","+import javax.security.auth.x500.X500Principal;","+","+/**","+ * Patched copy of cryptacular's {@code CertUtil} for Elasticsearch's FIPS-safe shadow jar.","+ * Two changes from upstream:","+ * <ol>","+ *   <li>{@code generateX509Certificate} is stubbed out. The original method caught","+ *       {@code OperatorCreationException} (bcpkix), which the JVM resolves in the class's","+ *       exception table at load time. Without bcpkix on the security plugin's runtime classpath,","+ *       this caused {@code NoClassDefFoundError} the moment any code loaded {@code CertUtil}.","+ *       Even code paths that only call {@code decodeCertificate}. This method is never called","+ *       by OpenSAML or any Elasticsearch code path.</li>","+ *   <li>The {@code BouncyCastleProvider} instantiation that was present in the original","+ *       {@code generateX509Certificate} body is removed. The default JCA provider is used","+ *       instead, which resolves to the appropriate provider (BC-FIPS or bcprov) at runtime.</li>","+ * </ol>","+ */","+public final class CertUtil {","+","+    /** Private constructor of utility class. */","+    private CertUtil() {}","+","+    /**","+     * Gets the common name attribute (CN) of the certificate subject distinguished name.","+     *","+     * @param  cert  Certificate to examine.","+     *","+     * @return  Subject CN or null if no CN attribute is defined in the subject DN.","+     *","+     * @throws  EncodingException  on cert field extraction.","+     */","+    public static String subjectCN(final X509Certificate cert) throws EncodingException {","+        CryptUtil.assertNotNullArg(cert, \"Certificate cannot be null\");","+        return new NameReader(cert).readSubject().getValue(StandardAttributeType.CommonName);","+    }","+","+    /**","+     * Gets all subject alternative names defined on the given certificate.","+     *","+     * @param  cert  X.509 certificate to examine.","+     *","+     * @return  List of subject alternative names or null if no subject alt names are defined."],"additions":82,"deletions":0,"truncated":false}],"additions":195,"deletions":144,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-08-28T19:54:50.766352+00:00"}