erService(IndexMode mode, String type) throws IOException {","+        return createMapperService(Settings.builder().put(IndexSettings.MODE.getKey(), mode.getName()).build(), mapping(b -> {","+            b.startObject(\"@timestamp\").field(\"type\", \"date\").endObject();","+            b.startObject(\"labels\").field(\"type\", \"flattened\");","+            b.startObject(\"properties\").startObject(\"n\").field(\"type\", type).endObject().endObject();","+            b.endObject();","+        }));","+    }","+","+    /** Two distinct values of {@code type}, each written the way synthetic source writes it back. */","+    private static List<Object> twoDistinctSubFieldValues(String type) {","+        return switch (type) {","+            case \"keyword\" -> {","+                String first = randomAlphaOfLength(5);","+                yield List.of(first, randomValueOtherThan(first, () -> randomAlphaOfLength(5)));","+            }","+            case \"long\" -> {","+                long first = randomLong();","+                yield List.of(first, randomValueOtherThan(first, ESTestCase::randomLong));","+            }","+            case \"ip\" -> {","+                String first = NetworkAddress.format(randomIp(randomBoolean()));","+                yield List.of(first, randomValueOtherThan(first, () -> NetworkAddress.format(randomIp(randomBoolean()))));","+            }","+            case \"boolean\" -> {","+                boolean first = randomBoolean();","+                yield List.of(first, first == false);","+            }","+            case \"date\" -> {","+                long first = randomLongBetween(0, 4102444800000L);","+                long second = randomValueOtherThan(first, () -> randomLongBetween(0, 4102444800000L));","+                yield List.of(","+                    DateFieldMapper.DEFAULT_DATE_TIME_FORMATTER.formatMillis(first),","+                    DateFieldMapper.DEFAULT_DATE_TIME_FORMATTER.formatMillis(second)","+                );",