ole.warn(`Ghost config has unknown keys, which are ignored:\\n${report}`);","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"ghost/core/shared/config/schema.ts","lines":["@@ -4,6 +4,7 @@ import { auth } from './schema/auth';"," import { database } from './schema/database';"," import { explore } from './schema/explore';"," import { httpUrl } from './schema/primitives';","+import { spam } from './schema/spam';"," import { makePathsAbsolute } from './utils';"," "," /**","@@ -116,6 +117,7 @@ export const configSchema = z.looseObject({","   // Feature config, one file per area in ./schema. See SCHEMA.md.","   auth,","   explore,","+  spam,"," });"," "," export type ValidatedConfig = z.infer<typeof configSchema>;"],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/core/shared/config/schema/primitives.ts","lines":["@@ -1,4 +1,6 @@"," import { z } from 'zod';","+import { reportUnknownKeys } from '../report';","+import { getNodeEnv } from '../utils';"," "," /**","  * An absolute `http://` or `https://` URL. Parsed with `new URL()`, as Ghost's","@@ -11,3 +13,31 @@ export function httpUrl(params: Parameters<typeof z.url>[0] = {}) {","     ...(typeof params === 'string' ? { error: params } : params),","   });"," }","+","+/**","+ * A closed object that reports keys it does not name, then strips them.","+ *","+ * Under test an unknown key is this repo's mistake, so it fails the parse with","+ * zod's own `unrecognized_keys` issue, as `z.strictObject` would. Elsewhere it","+ * only warns, even in strict mode: a strict object would make every new key a","+ * breaking change for configs written against an older Ghost. The environment","+ * is read at parse time, as the loader reads it. `name` labels the warning; a","+ * transform cannot see its own path.","+ */","+export function knownKeys<S extends z.ZodRawShape>(name: string, shape: S) {","+  const isKnown = (key: string) => Object.hasOwn(shape, key);","+","+  return z.looseObject(shape).transform((value,