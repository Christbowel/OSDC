heSharesSavedPrefix(t *testing.T) {","+\tfor name, newEnv := range map[string]func() *testEnv{","+\t\t\"full\":      newTransformerEnv,","+\t\t\"sliding\":   newSlidingWindowEnv,","+\t\t\"recurrent\": newRecurrentEnv,","+\t\t\"stateless\": newStatelessLayerEnv,","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tsource, destination := newEnv(), newEnv()","+\t\t\tdefer destination.pc.close()","+\t\t\tinputs := []int32{1, 2, 3, 4, 5, 6, 7, 8, 9}","+\t\t\t// Keep the source request active and ahead of its saved boundary.","+\t\t\tactive := source.pc.begin(inputs, nil)","+\t\t\tactive.schedulePrefillSnapshots([]int{4})","+\t\t\tfeedAll(source.caches, inputs[:8])","+\t\t\tactive.attachPrefillSnapshots()","+\t\t\tforkTokens := []int32{1, 2, 3, 4, 30, 31, 32}","+\t\t\tfork := destination.pc.begin(forkTokens, nil, source.pc)","+\t\t\tif got := len(forkTokens) - len(fork.remaining); got != 4 {","+\t\t\t\tt.Fatalf(\"reused %d tokens, want saved boundary 4\", got)","+\t\t\t}","+\t\t\tdestination.assertAllTokens(t, \"restored fork\", inputs[:4])","+\t\t\tsource.assertAllTokens(t, \"unmodified source\", inputs[:8])","+\t\t\t// The source can finish and be destroyed without invalidating the fork.","+\t\t\tactive.close()","+\t\t\tsource.pc.close()","+\t\t\tfeedAll(destination.caches, []int32{30, 31})","+\t\t\tdestination.assertAllTokens(t, \"independent fork\", []int32{1, 2, 3, 4, 30, 31})","+\t\t\tfork.close()","+\t\t\tfor _, snapshot := range source.tracker.all {","+\t\t\t\tif snapshot.closeCount != 1 {","+\t\t\t\t\tt.Fatalf(\"source snapshot closed %d times, want once\", snapshot.closeCount)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestPrefixCacheSharedPrefixSelection(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname                 string","+\t\tlocal, first, second int","+\t\twant                 int","+\t}{","+\t\t{\"longest peer\", 0, 4, 6, 6},","+\t\t{\"local wins\", 8, 4, 6, 8},","+\t\t{\"peer beats local\", 4, 6, 2, 6},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tinputs := []int32{1, 2, 3, 4, 5, 6, 7, 8, 9}","+\t\t\tlocal, first, second := newRecurrentEnv(), newRecurrentEnv(), newRecurrentEnv()","+\t\t\tfor i, env := range []*testEnv{local, first, second} {","+\t\t\t\tdefer env.pc.close()","+\t\t\t\tn := []int{tc.local, tc.first, tc.second}[i]","+\t\t\t\tif n > 0 {","+\t\t\t\t\tsimulateRequest(t, env.pc, inputs[:n+1], nil, n)","+\t\t\t\t}","+\t\t\t}","+\t\t\tsession := local.pc.begin(inputs, nil, first.pc, second.pc)","+\t\t\tif got := len(inputs) - len(session.remaining); got != tc.want {","+\t\t\t\tt.Fatalf(\"reused %d, want %d\", got, tc.want)","+\t\t\t}","+\t\t\tlocal.assertAllTokens(t, \"chosen prefix\", inputs[:tc.want])","+\t\t\tsession.close()","+\t\t})","+\t}","+}","+","+func TestPrefixCacheSharedPrefixStopsAtMissingEdge(t *testing.T) {","+\tsource, destination := newRecurrentEnv(), newRecurrentEnv()","+\tdefer source.pc.close()","+\tdefer destination.pc.close()","+\tinputs := []int32{1, 2, 3, 4, 5, 6, 7, 8, 9}","+\tsimulateRequest(t, source.pc, inputs, nil, 4, 8)","+\tpath, _ := findBestMatch(source.pc.root, source.pc.key(effectiveKeyTokens(inputs, nil)))","+\tpath[1].setSnapshots(nil, &source.pc.pagedOutBytes)","+\tsession := destination.pc.begin(inputs, nil, source.pc)","+\tif !slices.Equal(session.remaining, inputs) {","+\t\tt.Fatalf(\"reused an incomplete snapshot path: remaining %v\", session.remaining)","+\t}","+\tsession.close()","+}","+","+func TestSharedPrefixSurvivesIntermediateEviction(t *testing.T) {","+\tfor name, newEnv := range map[string]func() *testEnv{","+\t\t\"full\": newTransformerEnv, \"sliding\": newSlidingWindowEnv, \"recurrent\": newRecurrentEnv,","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tsource, destination := newEnv(), newEnv()","+\t\t\tdefer source.pc.close()","+\t\t\tdefer destination.pc.close()","+\t\t\tinputs := []int32{1, 2, 3, 4, 5, 6, 7, 8, 9}","+\t\t\tsimulateRequest(t, source.pc, inputs, nil, 4, 8)","+\t\t\tpath, _ := findBestMatch(source.pc.root, source.pc.key(effectiveKeyTokens(inputs, nil)))","+\t\t\tif len(path) != 3 {","+\t\t\t\tt.Fatalf(\"saved path has %d nodes, want root and two checkpoints\", len(path))","+\t\t\t}","+\t\t\t// Eviction merges the earlier edge into its child: continuous KV","+\t\t\t// history must remain reusable, even though the earlier checkpoint is gone.","+\t\t\tsource.pc.evictNode(path[1])","+\t\t\tpath, _ = findBestMatch(source.pc.root, source.pc.key(effectiveKeyTokens(inputs, nil)))","+\t\t\tif len(path) != 2 || path[1].endOffset != 8 || !hasAllSnapshots(path[1], source.caches) {","+\t\t\t\tt.Fatal(\"eviction did not preserve a complete merged checkpoint at 8\")","+\t\t\t}","+\t\t\tfork := destination.pc.begin(inputs, nil, source.pc)","+\t\t\tdefer fork.close()","+\t\t\tif got := len(inputs) - len(fork.remaining); got != 8 {","+\t\t\t\tt.Fatalf(\"reused %d tokens after intermediate eviction, want 8\", got)","+\t\t\t}","+\t\t\tdestination.assertAllTokens(t, \"merged peer restore\", inputs[:8])","+\t\t\tcheckTrieInvariants(t, source.pc.root)","+\t\t})","+\t}","+}","+","+func TestSharedPrefixWhileDonorHasPendingCaptures(t *testing.T) {","+\tfor name, newEnv := range map[string]func() *testEnv{","+\t\t\"full\": newTransformerEnv, \"sliding\": newSlidingWindowEnv, \"recurrent\": newRecurrentEnv,","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tsource, destination := newEnv(), newEnv()","+\t\t\tdefer source.pc.close()","+\t\t\tdefer destination.pc.close()","+\t\t\told := []int32{1, 2, 3, 4, 5, 6, 7, 8, 9}","+\t\t\tsimulateRequest(t, source.pc, old, nil, 4, 8)","+\t\t\t// Give the fake snapshots a cost so borrowing triggers the donor's","+\t\t\t// normal eviction policy while its new captures are still pending.","+\t\t\twalkNodes(source.pc.root, func(n *trieNode) bool {","+\t\t\t\tfor _, s := range n.snapshots {","+\t\t\t\t\tif s != nil {","+\t\t\t\t\t\ts.(*fakeSnapshot).byteSize = 32","+\t\t\t\t\t\tsource.pc.pagedOutBytes += 32","+\t\t\t\t\t}","+\t