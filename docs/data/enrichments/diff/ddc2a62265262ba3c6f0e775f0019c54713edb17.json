{"id":"ddc2a62265262ba3c6f0e775f0019c54713edb17","axis":"silent","repo":"mlflow/mlflow","sha":"ddc2a62265262ba3c6f0e775f0019c54713edb17","parsed":{"files":[{"path":"mlflow/server/handlers.py","lines":["@@ -5750,21 +5750,15 @@ def _invoke_issue_detection_handler():"," ","     # Fail fast when no credential source exists, instead of submitting a job doomed to fail","     if not endpoint_name and not secret_id:","-        from mlflow.utils.providers import _CORE_PROVIDER_ENV_VARS","+        from mlflow.utils.providers import has_env_credentials, provider_credential_env_vars"," ","-        env_config = _CORE_PROVIDER_ENV_VARS.get(provider_name)","-        if not env_config:","+        env_vars = provider_credential_env_vars(provider_name)","+        if not env_vars:","             raise MlflowException.invalid_parameter_value(","                 f\"Unsupported provider '{provider}'. Choose a supported provider or \"","                 \"AI Gateway endpoint.\"","             )","-        if isinstance(env_config, dict):","-            env_vars = (","-                [env_config[\"api_key\"]] if \"api_key\" in env_config else list(env_config.values())","-            )","-        else:","-            env_vars = [env_config]","-        if not any(os.environ.get(env_var) for env_var in env_vars):","+        if not has_env_credentials(provider_name):","             env_var_hint = env_vars[0] if len(env_vars) == 1 else f\"one of {', '.join(env_vars)}\"","             raise MlflowException.invalid_parameter_value(","                 f\"No API key available for provider '{provider}'. Save an API key in \"","@@ -7835,9 +7829,18 @@ def _list_supported_models():"," @_disable_if_artifacts_only"," @_disable_if_gateway_disabled"," def _get_provider_config():","+    from mlflow.utils.providers import has_env_credentials","+","     try:","         provider = request.args.get(\"provider\")","+        # Normalized here rather than relying on `has_env_credentials` to lower-case internally,","+        # which is how a mixed-case provider works today -- by accident rather than by contract.","+        provider_name = provider.lower() if provider else provider","         config = get_provider_config_response(provider)","+        # Reported so a client can tell whether this provider needs a key saved at all. A server","+        # started with the provider's own environment variable set already has a credential, and","+        # asking for another would be asking for one it would not use.","+        config[\"env_credentials_available\"] = has_env_credentials(provider_name)","         return jsonify(config)","     except (ImportError, ValueError) as e:","         raise MlflowException(str(e), error_code=INVALID_PARAMETER_VALUE)"],"additions":13,"deletions":10,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/components/experiment-page/components/traces-v3/IssueDetectionModelDropdown.tsx","lines":["@@ -209,10 +209,19 @@ export const IssueDetectionModelDropdown = ({","   endpoints,","   value,","   onChange,","+  disabled = false,","+  overlayZIndex,"," }: {","   endpoints: Endpoint[];","   value: IssueDetectionModelSelection;","   onChange: (value: IssueDetectionModelSelection) => void;","+  disabled?: boolean;","+  /**","+   * Lifts this control's overlays -- the option list and the \"Create endpoint\" modal it can open --","+   * above a host that raises its own stacking context (a modal that sets `zIndex`), which would","+   * otherwise render over them. Left unset, the design system's defaults apply.","+   */","+  overlayZIndex?: number;"," }) => {","   const { theme } = useDesignSystemTheme();","   const { refetch: refetchEndpoints } = useEndpointsQuery();","@@ -255,6 +264,7 @@ export const IssueDetectionModelDropdown = ({","         <button","           type=\"button\"","           data-testid=\"model-dropdown-trigger\"","+          disabled={disabled}","           css={{","             display: 'flex',","             alignItems: 'center',","@@ -265,11 +275,14 @@ export const IssueDetectionModelDropdown = ({","             textAlign: 'left',","             border: `1px solid ${theme.colors.border}`,","             borderRadius: theme.borders.borderRadiusMd,","-            cursor: 'pointer',","-            '&:hover': {","-              backgroundColor: theme.colors.actionTertiaryBackgroundHover,","-              borderColor: theme.colors.actionDefaultBorderHover,","-            },","+            cursor: disabled ? 'not-allowed' : 'pointer',","+            color: disabled ? theme.colors.actionDisabledText : undefined,","+            '&:hover': disabled","+              ? undefined","+              : {","+                  backgroundColor: theme.colors.actionTertiaryBackgroundHover,","+                  borderColor: theme.colors.actionDefaultBorderHover,","+                },","           }}","         >","           {triggerLogo && <ProviderLogo src={triggerLogo} srcDark={triggerLogoDark} />}","@@ -288,7 +301,7 @@ export const IssueDetectionModelDropdown = ({","         sideOffset={4}","         collisionPadding={16}","         avoidCollisions={false}","-        style={{ padding: 0, minWidth: 260 }}","+        style={{ padding: 0, minWidth: 260, ...(overlayZIndex === undefined ? {} : { zIndex: overlayZIndex }) }}","       >","         <div","           css={{","@@ -324,6 +337,7 @@ export const IssueDetectionModelDropdown = ({","       {isCreateModalOpen && (","         <CreateEndpointModal","           open={isCreateModalOpen}","+          zIndex={overlayZIndex}","           onClose={() => setIsCreateModalOpen(false)}","           onSuccess={(endpoint) => {","             refetchEndpoints();"],"additions":20,"deletions":6,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/constants.ts","lines":["@@ -95,6 +95,10 @@ export const MLFLOW_ISSUE_DETECTION_RESULT_TOTAL_TRACES_TAG = 'mlflow.issueDetec"," export const MLFLOW_ISSUE_DETECTION_RESULT_SUMMARY_TAG = 'mlflow.issueDetection.result.summary';"," // Experiment-level detection settings, stored as one JSON value: instructions plus category toggles."," export const MLFLOW_ISSUE_DETECTION_PRIORITIES_TAG = 'mlflow.issueDetection.priorities';","+// The experiment's recurring detection schedule: cadence, timezone and paused flag.","+export const MLFLOW_ISSUE_DETECTION_SCHEDULE_TAG = 'mlflow.issueDetection.schedule';","+// The equality clauses narrowing which traces a scheduled detection run analyzes.","+export const MLFLOW_ISSUE_DETECTION_SCHEDULE_TRACE_FILTER_TAG = 'mlflow.issueDetection.scheduleTraceFilter';"," "," export const MLFLOW_RUN_GIT_SOURCE_BRANCH_TAG = 'mlflow.source.git.branch';"," export const MLFLOW_PROMPT_VERSION_COUNT_TAG = 'PromptVersionCount';"],"additions":4,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/hooks/useServerInfo.tsx","lines":["@@ -36,6 +36,7 @@ interface ServerInfoResponse {","  */"," export const SERVER_FEATURE_KEYS = {","   GATEWAY: 'gateway',","+  SCHEDULED_ISSUE_DETECTION: 'scheduled_issue_detection',"," } as const;"," "," export type FeatureKey = (typeof SERVER_FEATURE_KEYS)[keyof typeof SERVER_FEATURE_KEYS];"],"additions":1,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/pages/experiment-issues/ExperimentIssuesActionBar.tsx","lines":["@@ -3,6 +3,7 @@ import { useIntl } from 'react-intl';"," import { DetectIssuesButton } from '@databricks/web-shared/genai-traces-table/components/DetectIssuesButton';"," import { CancelIssueDetectionButton } from './CancelIssueDetectionButton';"," import { IssueDetectionSettingsControl } from './IssueDetectionSettingsControl';","+import { ExperimentIssuesScheduleControl } from './ExperimentIssuesScheduleControl';"," import { ExperimentIssuesFilterControl } from './ExperimentIssuesToolbar';"," import type { ExperimentIssuesToolbarControls } from './useExperimentIssuesListControls';"," ","@@ -80,7 +81,12 @@ export const ExperimentIssuesActionBar = ({","       </div>","       <ExperimentIssuesFilterControl controls={controls} align=\"start\" />","       <div css={{ flex: 1 }} />","-      {detectionEnabled && <IssueDetectionSettingsControl experimentId={experimentId} />}","+      {detectionEnabled && (","+        <>","+          <IssueDetectionSettingsControl experimentId={experimentId} />","+          <ExperimentIssuesScheduleControl experimentId={experimentId} />","+        </>","+      )}","       {detectionEnabled &&","         // A run that exists can be cancelled, so the action becomes that rather than a disabled","         // button with no way out of a run that has stopped reporting progress. While one is still"],"additions":7,"deletions":1,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/pages/experiment-issues/ExperimentIssuesPage.test.tsx","lines":["@@ -727,7 +727,7 @@ describe('Experiment Issues', () => {","     await screen.findByText('Unable to update detection progress');","     expect(screen.getByRole('button', { name: 'Cancel detection' })).toBeEnabled();","     expect(screen.queryByRole('button', { name: 'Detect issues in traces' })).not.toBeInTheDocument();","-    expect(screen.getByRole('button', { name: 'Retry status' })).toBeEnabled();","+    await waitFor(() => expect(screen.getByRole('button', { name: 'Retry status' })).toBeEnabled());","   });","   test('a failed cancel still refreshes job status, so a finished run stops blocking', async () => {","     // Reported in review. One failed status read stops polling, so this client can be holding"],"additions":1,"deletions":1,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/pages/experiment-issues/ExperimentIssuesScheduleControl.test.tsx","lines":["@@ -0,0 +1,862 @@","+import { beforeEach, describe, expect, test } from '@jest/globals';","+import { rest } from 'msw';","+import userEvent, { PointerEventsCheckLevel } from '@testing-library/user-event';","+","+import { renderWithDesignSystem, screen, waitFor } from '../../../common/utils/TestUtils.react18';","+import { setupServer } from '../../../common/utils/setup-msw';","+import { QueryClient, QueryClientProvider } from '../../../common/utils/reactQueryHooks';","+import { MLFLOW_ISSUE_DETECTION_SCHEDULE_TAG, MLFLOW_ISSUE_DETECTION_SCHEDULE_TRACE_FILTER_TAG } from '../../constants';","+import { ExperimentIssuesScheduleControl } from './ExperimentIssuesScheduleControl';","+import { ISSUE_DETECTION_SCHEDULE_VERSION, MAX_TRACE_FILTERS } from './issueDetectionSchedule';","+","+interface SavedTag {","+  key: string;","+  value: string;","+}","+","+let experimentTags: SavedTag[];","+let written: SavedTag[];","+let saveFails: boolean;","+/** Key of a tag whose write should fail, to exercise a partial save. */","+let failWriteOfTag: string | null;","+/** Set to fail the experiment read, which is how a load failure is exercised. */","+let loadFails: boolean;","+let scheduledDetectionEnabled: boolean;","+let gatewayEndpoints: { name: string }[];","+let gatewaySecrets: { secret_id: string; secret_name: string; provider: string }[];","+/** What the server reports about a credential of its own for the selected provider. */","+let envCredentialsAvailable: boolean | undefined;","+let createdSecrets: { secret_name: string; provider?: string; secret_value: Record<string, string> }[];","+","+const server = setupServer(","+  rest.get('*/ajax-api/3.0/mlflow/server-info', (_req, res, ctx) =>","+    res(","+      ctx.json({","+        store_type: 'SqlStore',","+        features_enabled: { gateway: true, scheduled_issue_detection: scheduledDetectionEnabled },","+      }),","+    ),","+  ),","+  rest.get('*/ajax-api/2.0/mlflow/experiments/get', (_req, res, ctx) =>","+    loadFails","+      ? res(ctx.status(500), ctx.json({ message: 'nope' }))","+      : res(ctx.json({ experiment: { experiment_id: '1', name: 'exp', tags: experimentTags } })),","+  ),","+  rest.post('*/ajax-api/2.0/mlflow/experiments/set-experiment-tag', async (req, res, ctx) => {","+    if (saveFails) {","+      return res(ctx.status(500), ctx.json({ message: 'nope' }));","+    }","+    const body = (await req.json()) as SavedTag;","+    if (failWriteOfTag === body.key) {","+      return res(ctx.status(500), ctx.json({ message: 'nope' }));","+    }","+    written.push({ key: body.key, value: body.value });","+    return res(ctx.json({}));","+  }),","+  rest.get('*/ajax-api/3.0/mlflow/gateway/endpoints/list', (_req, res, ctx) =>","+    res(ctx.json({ endpoints: gatewayEndpoints })),","+  ),","+  rest.get('*/ajax-api/3.0/mlflow/gateway/secrets/list', (_req, res, ctx) =>","+    res(ctx.json({ secrets: gatewaySecrets })),","+  ),","+  rest.get('*/ajax-api/3.0/mlflow/gateway/provider-config', (_req, res, ctx) =>","+    res(","+      ctx.json({","+        auth_modes: [],","+        default_mode: 'api_key',","+        ...(envCredentialsAvailable === undefined ? {} : { env_credentials_available: envCredentialsAvailable }),","+      }),","+    ),","+  ),","+  rest.post('*/ajax-api/3.0/mlflow/gateway/secrets/create', async (req, res, ctx) => {","+    const body = (await req.json()) as (typeof createdSecrets)[number];","+    createdSecrets.push(body);","+    const secret = { secret_id: 'sec-new', secret_name: body.secret_name, provider: body.provider ?? '' };","+    gatewaySecrets = [...gatewaySecrets, secret];","+    return res(ctx.json({ secret }));","+  }),","+);","+","+const scheduleTag = (cadence: string | null, paused = false, timezone = 'UTC'): SavedTag => ({","+  key: MLFLOW_ISSUE_DETECTION_SCHEDULE_TAG,","+  value: JSON.stringify({","+    version: ISSUE_DETECTION_SCHEDULE_VERSION,","+    cadence,","+    timezone,","+    paused,","+  }),","+});","+","+const traceFilterTag = (filters: unknown[]): SavedTag => ({","+  key: MLFLOW_ISSUE_DETECTION_SCHEDULE_TRACE_FILTER_TAG,","+  value: JSON.stringify(filters),","+});","+","+const render = () => {","+  const client = new QueryClient({ defaultOptions: { queries: { retry: false, cacheTime: 0 } } });","+  return renderWithDesignSystem(","+    <QueryClientProvider client={client}>","+      <ExperimentIssuesScheduleControl experimentId=\"1\" />","+    </QueryClientProvider>,","+  );","+};","+","+const setup = () => userEvent.setup({ pointerEventsCheck: PointerEventsCheckLevel.Never });","+","+const COMPONENT_ID = 'mlflow.experiment-issues.schedule';","+","+const savedSchedule = (): Record<string, unknown> =>","+  JSON.parse(written.find(({ key }) => key === MLFLOW_ISSUE_DETECTION_SCHEDULE_TAG)?.value ?? '{}');","+","+const savedTraceFilters = (): unknown[] =>","+  JSON.parse(written.find(({ key }) => key === MLFLOW_ISSUE_DETECTION_SCHEDULE_TRACE_FILTER_TAG)?.value ?? 'null');","+","+const openModal = async (user: ReturnType<typeof setup>, name = /schedule detection/i) => {","+  // Re-queried inside the wait rather than captured once: until `server-info` answers, the control","+  // renders its disabled branch, and becoming available swaps in a different button. Waiting on the","+  // element found first would wait forever on a node that has been detached.","+  await waitFor(async () => expect(await screen.findByRole('button', { name })).not.toBeDisabled());","+  await user.click(await screen.findByRole('button', { name }));","+  return screen.findByRole('dialog');","+};","+","+const chooseCadence = async (user: ReturnType<typeof setup>, cadence: string) => {","+  await user.click(await screen.findByRole('combobox', { name: /cadence/i }));","+  await user.click(await screen.findByRole('option', { name: cadence }));","+};","+","+const save = async (user: ReturnType<typeof setup>) => user.click(await screen.findByRole('button', { name: 'Save' }));","+","+describe('ExperimentIssuesScheduleControl', () => {","+  beforeEach(() => {","+    experimentTags = [];","+    written = [];","+    saveFails = false;","+    failWriteOfTag = null;","+    loadFails = false;","+    scheduledDetectionEnabled = true;","+    gatewayEndpoints = [];","+    gatewaySecrets = [];","+    createdSecrets = [];","+    // The default server here already has a credential of its own, which is what keeps the","+    // schedule tests about cadence and filters rather than about keys.","+    envCredentialsAvailable = true;","+  });","+","+  test('labels the trigger \"Schedule detection\" when off and shows the cadence when scheduled', async () => {","+    const { unmount } = render();","+    expect(await screen.findByRole('button', { name: /schedule detection/i })).toBeInTheDocument();","+    unmount();","+","+    experimentTags = [scheduleTag('hourly')];","+    render();","+    expect(await screen.findByRole('button', { name: /scheduled: hourly/i })).toBeInTheDocument();","+  });","+","+  test(\"swaps the trigger's clock for a green checkmark while a schedule is on\", async () => {","+    const { unmount } = render();","+    await screen.findByRole('button', { name: /schedule detection/i });","+    expect(screen.queryByTestId('schedule-on-icon')).not.toBeInTheDocument();","+    unmount();","+","+    experimentTags = [scheduleTag('daily')];","+    render();","+    const trigger = await screen.findByRole('button', { name: /scheduled: daily/i });","+    // In the label, not the leading icon slot, whose colour the button sets.","+    expect(trigger).toContainElement(screen.getByTestId('schedule-on-icon'));","+  });","+","+  test('a paused schedule reads as Off while keeping the cadence it had', async () => {","+    experimentTags = [scheduleTag('weekly', true)];","+    const user = setup();","+    render();","+","+    await openModal(user);","+    expect(await screen.findByRole('combobox', { name: /cadence/i })).toHaveTextContent('Off');","+","+    // Turning it back on offers the cadence it was paused at, rather than starting from nothing.","+    await chooseCadence(user, 'Weekly');","+    await save(user);","+    await waitFor(() => expect(savedSchedule()['cadence']).toBe('weekly'));","+    expect(savedSchedule()['paused']).toBe(false);","+  });","+","+  test('closes the modal from the footer without saving', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+","+    await user.click(await screen.findByRole('button', { name: 'Cancel' }));","+    await waitFor(() => expect(screen.queryByRole('dialog')).not.toBeInTheDocument());","+    expect(written).toEqual([]);","+  });","+","+  test('shows only the Add filter button when there are no clauses, and saves none', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+","+    expect(screen.queryByRole('combobox', { name: 'Field' })).not.toBeInTheDocument();","+    await chooseCadence(user, 'Daily');","+    await save(user);","+","+    await waitFor(() => expect(savedTraceFilters()).toEqual([]));","+    expect(savedSchedule()['cadence']).toBe('daily');","+    // Saved in the browser's zone, so the cadence keeps firing at the local hour it was set in.","+    expect(savedSchedule()['timezone']).toEqual(expect.any(String));","+  });","+","+  test('adds and saves clauses, defaulting a new row to the metadata field and the equals operator', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+    await chooseCadence(user, 'Daily');","+","+    await user.click(await screen.findByRole('button', { name: 'Add filter' }));","+    await user.type(await screen.findByRole('textbox', { name: 'Filter key' }), 'environment');","+    await user.type(await screen.findByRole('textbox', { name: 'Filter value' }), 'production');","+    await save(user);","+","+    await waitFor(() =>","+      expect(savedTraceFilters()).toEqual([","+        { field: 'metadata', operator: '=', key: 'environment', value: 'production' },","+      ]),","+    );","+  });","+","+  test('prefills mixed metadata and tag clauses and preserves field and operator on save', async () => {","+    const stored = [","+      { field: 'metadata', operator: '=', key: 'environment', value: 'production' },","+      { field: 'tag', operator: '=', key: 'team', value: 'search' },","+    ];","+    experimentTags = [scheduleTag('daily'), traceFilterTag(stored)];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: daily/i);","+    const keys = await screen.findAllByRole('textbox', { name: 'Filter key' });","+    expect(keys.map((input) => (input as HTMLInputElement).value)).toEqual(['environment', 'team']);","+","+    await save(user);","+    await waitFor(() => expect(savedTraceFilters()).toEqual(stored));","+  });","+","+  test('drops a removed clause from the saved model', async () => {","+    experimentTags = [","+      scheduleTag('daily'),","+      traceFilterTag([","+        { field: 'metadata', operator: '=', key: 'environment', value: 'production' },","+        { field: 'tag', operator: '=', key: 'team', value: 'search' },","+      ]),","+    ];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: daily/i);","+    const removeButtons = await screen.findAllByRole('button', { name: 'Remove filter' });","+    await user.click(removeButtons[0]);","+    await save(user);","+","+    await waitFor(() =>","+      expect(savedTraceFilters()).toEqual([{ field: 'tag', operator: '=', key: 'team', value: 'search' }]),","+    );","+  });","+","+  test('removing the last clause collapses back to just the Add filter button', async () => {","+    experimentTags = [","+      scheduleTag('daily'),","+      traceFilterTag([{ field: 'tag', operator: '=', key: 'team', value: 'search' }]),","+    ];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: daily/i);","+    await user.click(await screen.findByRole('button', { name: 'Remove filter' }));","+    expect(screen.queryByRole('textbox', { name: 'Filter key' })).not.toBeInTheDocument();","+    expect(await screen.findByRole('button', { name: 'Add filter' })).toBeInTheDocument();","+  });","+","+  test('a blank-key clause is dropped rather than saved', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+    await chooseCadence(user, 'Daily');","+","+    await user.click(await screen.findByRole('button', { name: 'Add filter' }));","+    await user.type(await screen.findByRole('textbox', { name: 'Filter value' }), 'production');","+    await save(user);","+","+    await waitFor(() => expect(savedTraceFilters()).toEqual([]));","+  });","+","+  test('holds Save until the model selection resolves, so an active schedule never saves without one', async () => {","+    // The endpoint list is what the default selection is derived from, and the credential queries","+    // can settle before it. Saving in that gap stored no model -- the run would fall back to the","+    // server default rather than the endpoint this dialog was about to show -- and skipped the key","+    // step, since that only applies to a direct provider selection.","+    envCredentialsAvailable = false;","+    gatewayEndpoints = [{ name: 'prod-gateway' }];","+    let releaseEndpoints: () => void = () => {};","+    const endpointsHeld = new Promise<void>((resolve) => {","+      releaseEndpoints = resolve;","+    });","+    server.use(","+      rest.get('*/ajax-api/3.0/mlflow/gateway/endpoints/list', async (_req, res, ctx) => {","+        await endpointsHeld;","+        return res(ctx.json({ endpoints: gatewayEndpoints }));","+      }),","+    );","+","+    const user = setup();","+    render();","+    await openModal(user);","+    await chooseCadence(user, 'Daily');","+","+    // The credential answers have arrived; the endpoint list has not.","+    await waitFor(() => expect(screen.getByRole('button', { name: 'Save' })).toBeDisabled());","+    expect(written).toEqual([]);","+","+    releaseEndpoints();","+    await waitFor(() => expect(screen.getByRole('button', { name: 'Save' })).not.toBeDisabled());","+    await save(user);","+","+    // The resolved endpoint is stored rather than nothing, and it needs no API key of its own.","+    await waitFor(() => expect(savedSchedule()['cadence']).toBe('daily'));","+    expect(savedSchedule()['model']).toEqual({ endpointName: 'prod-gateway' });","+    expect(screen.queryByTestId('schedule-api-key-view')).not.toBeInTheDocument();","+  });","+","+  test('says the cost recurs while a cadence is selected, and not when off', async () => {","+    const costNote = /incur model usage costs on every occurrence/;","+    experimentTags = [scheduleTag('hourly')];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: hourly/i);","+    expect(await screen.findByText(costNote)).toBeInTheDocument();","+","+    // Turning the schedule off stops it firing, so there is no recurring spend to warn about.","+    await chooseCadence(user, 'Off');","+    await waitFor(() => expect(screen.queryByText(costNote)).not.toBeInTheDocument());","+  });","+","+  test('offers no more filters than scheduled runs apply', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+    await chooseCadence(user, 'Daily');","+","+    const addFilter = await screen.findByRole('button', { name: 'Add filter' });","+    for (let i = 0; i < MAX_TRACE_FILTERS; i++) {","+      await user.click(addFilter);","+    }","+    expect(await screen.findAllByRole('textbox', { name: 'Filter key' })).toHaveLength(MAX_TRACE_FILTERS);","+    // A further clause would show here as active and be dropped by every run.","+    expect(addFilter).toBeDisabled();","+  });","+","+  test(\"keeps a schedule's stored timezone when it is edited from somewhere else\", async () => {","+    // The modal has no timezone control, so a save made elsewhere must not move when the schedule","+    // fires: pausing a Tokyo daily schedule from another zone would otherwise resume it at 09:00","+    // local to whoever paused it.","+    experimentTags = [scheduleTag('daily', false, 'Asia/Tokyo')];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: daily/i);","+    await chooseCadence(user, 'Off');","+    await save(user);","+","+    await waitFor(() => expect(savedSchedule()['paused']).toBe(true));","+    expect(savedSchedule()['timezone']).toBe('Asia/Tokyo');","+  });","+","+  test('adopts the browser timezone only when the schedule has none stored', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+    await chooseCadence(user, 'Daily');","+    await save(user);","+","+    await waitFor(() => expect(savedSchedule()['cadence']).toBe('daily'));","+    expect(savedSchedule()['timezone']).toBe(Intl.DateTimeFormat().resolvedOptions().timeZone);","+  });","+","+  test('turns a schedule off', async () => {","+    experimentTags = [scheduleTag('hourly')];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: hourly/i);","+    await chooseCadence(user, 'Off');","+    await save(user);","+","+    await waitFor(() => expect(savedSchedule()['paused']).toBe(true));","+    // The cadence is kept, so turning it back on restores it.","+    expect(savedSchedule()['cadence']).toBe('hourly');","+  });","+","+  test('disables the clause inputs and Add filter when the cadence is Off', async () => {","+    experimentTags = [","+      scheduleTag('hourly'),","+      traceFilterTag([{ field: 'tag', operator: '=', key: 'team', value: 'search' }]),","+    ];","+    const user = setup();","+    render();","+","+    await openModal(user, /scheduled: hourly/i);","+    expect(await screen.findByRole('textbox', { name: 'Filter key' })).not.toBeDisabled();","+","+    await chooseCadence(user, 'Off');","+    expect(await screen.findByRole('textbox', { name: 'Filter key' })).toBeDisabled();","+    expect(await screen.findByRole('button', { name: 'Add filter' })).toBeDisabled();","+  });","+","+  test('keeps the modal open and shows an error when saving fails', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+    await chooseCadence(user, 'Daily');","+","+    saveFails = true;","+    await save(user);","+","+    expect(await screen.findByText(/Couldn't save the schedule/)).toBeInTheDocument();","+    // The draft is still there to retry with, rather than discarded by a closing modal.","+    expect(await screen.findByRole('dialog')).toBeInTheDocument();","+    expect(await screen.findByRole('combobox', { name: /cadence/i })).toHaveTextContent('Daily');","+  });","+","+  test('disables the trigger and explains why when the server cannot run a schedule', async () => {","+    scheduledDetectionEnabled = false;","+    render();","+","+    // Only the unavailable branch wraps the trigger in a tooltip, so that attribute is what says","+    // the control took it. Waiting on `toBeDisabled` alone would not discriminate: the ordinary","+    // trigger is disabled too while the schedule loads, so that assertion can hold for the wrong","+    // reason. The capability itself reads false until `server-info` answers","+    // (`useFeatureEnabled(SCHEDULED_ISSUE_DETECTION, false)`), which is the fail-closed direction","+    // for a capability question -- a control that looks available and saves a schedule the server","+    // cannot run is the worse default.","+    await waitFor(async () =>","+      expect(await screen.findByRole('button', { name: /schedule detection/i })).toHaveAttribute('tooltip-data-state'),","+    );","+    expect(await screen.findByRole('button', { name: /schedule detection/i })).toBeDisabled();","+","+    // The reason itself is not asserted here: the design system makes the disabled button its own","+    // tooltip trigger, and jsdom delivers no pointer or focus event to a disabled element, so no","+    // unit test can open it. Driving it with a simulated hover passed only intermittently, which is","+    // worse than not asserting it. The wording is covered by the screenshots on the pull request.","+  });","+","+  test('saves the model the picker is left on, defaulting to the first provider', async () => {","+    const user = setup();","+    render();","+    await openModal(user);","+    expect(await screen.findByTestId('model-dropdown-trigger')).toHaveTextContent('OpenAI');","+    await chooseCadence(user, 'Daily');","+    await save(user);","+","+    await waitFor(() => expect(savedSchedule()['model']).toEqual({ provider: 'openai', model: 'gpt-5.6-sol' }));","+  });","+","+  test('defaults to the first AI Gateway endpoint when the server has one, as the ad-hoc dialog does', async () => {","+    gatewayEndpoints = [{ name: 'prod-gateway' }];","+    const user = setup();","+    render();","+    await openModal(user);","+    expect(await screen.findByTestId('model-dropdown-trigger')).toHaveTextContent('prod-gateway');","+    await chooseCadence(user, 'Daily');","+    await save(user);","+","+    await waitFor(() => expect(savedSchedule()['model']).toEqual({ endpointName: 'prod-gateway' }));","+  });","+","+  test('prefills the picker from the stored model', async () => {","+    experimentTags = [","+      {","+        key: MLFLOW_ISSUE_DETECTION_SCHEDULE_TAG,","+        value: JSON.stringify({","+          version: ISSUE_DETECTION_SCHEDULE_VERSION,"],"additions":480,"deletions":0,"truncated":false}],"additions":526,"deletions":18,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-10-27T15:03:47.122457+00:00"}