this file's source contains `--wpds-` text, the","-   design-system fallback build plugin claims it (it matches any file whose","-   source includes `--wpds-`, comments included) and, in doing so, displaces","-   the Emotion transform for this file. That is harmless ONLY because this file","-   holds plain value constants and no Emotion `css`/styled component selectors.","-   Do not add any here: a co-located component selector would silently fail to","-   compile and break the build, with no lint signal (see #79245). Keep this","-   file selector-free — define styles elsewhere and consume these constants. */","+   mapping to design system tokens. The build plugin injects generated fallbacks. */"," "," const white = '#fff';"," "],"additions":1,"deletions":10,"truncated":false},{"path":"packages/docgen/CHANGELOG.md","lines":["@@ -6,6 +6,10 @@"," "," -   Raise the minimum required Node.js version to `>=22.13.0`, for stable `require(esm)` support ([#84313](https://github.com/WordPress/gutenberg/pull/84313))."," ","+### Enhancements","+","+-   Parse JSX and TypeScript without requiring project Babel configuration, while retaining support for custom Babel configuration ([#84707](https://github.com/WordPress/gutenberg/pull/84707)).","+"," ## 2.57.0 (2026-10-07)"," "," ## 2.56.0 (2026-09-23)"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/docgen/README.md","lines":["@@ -1,12 +1,12 @@"," # `docgen`"," ","-`docgen` helps you to generate the _public API_ of your code. Given an entry point file, it outputs the ES6 export statements and their corresponding JSDoc comments in human-readable format. It also supports TypeScript via the TypeScript babel plugin.","+`docgen` helps you to generate the _public API_ of your code. Given an entry point file, it outputs the ES6 export statements and their corresponding JSDoc comments in human-readable format. It also supports TypeScript."," "," Some characteristics:"," "," - If the export statement doesn't contain any JSDoc, it'll look up for JSDoc up to the declaration."," - It can resolve relative dependencies, either files or directories. For example, `import default from './dependency'` will find `dependency.js` or `dependency/index.js`","-- For TypeScript support, all types must be explicitly annotated as the TypeScript Babel plugin is unable to consume inferred types (it does not run the TS compiler, after all—it merely parses TypeScript). For example, all function return types must be explicitly annotated if they are to be documented by `docgen`.","+- For TypeScript support, all types must be explicitly annotated because `docgen` parses TypeScript without running the TypeScript compiler or inferring types. For example, all function return types must be explicitly annotated if they are to be documented by `docgen`."," "," ## Installation"," ","@@ -45,7 +45,7 @@ This command will generate a file named `entry-point-api.md` containing all the"," "," `@wordpress/docgen` follows the default [project-wide configuration of Babel](https://babeljs.io/docs/en/next/config-files#project-wide-configuration). Like Babel, it will automatically search for a `babel.config.json` file, or an equivalent one using the [supported extensions](https://babeljs.io/docs/en/next/config-files#supported-file-extensions), in the project root directory."," ","-Without it, `@wordpress/docgen` runs with the default option. In other words, it cannot parse JSX or other advanced syntaxes.","+JSX and TypeScript are supported without a Babel configuration. TypeScript parsing follows the `.ts`, `.tsx`, `.mts`, and `.cts` file extensions. Use a Babel configuration for other syntax extensions."," "," ## Examples"," "],"additions":3,"deletions":3,"truncated":false},{"path":"packages/docgen/lib/engine.js","lines":["@@ -2,7 +2,18 @@ const babel = require( '@babel/core' );"," const getIntermediateRepresentation = require( './get-intermediate-representation' );"," "," const getAST = ( source, filename ) => {","-\treturn babel.parse( source, { filename } ).program;","+\tconst config = babel.loadPartialConfig( { filename } );","+\tconst isTypeScript = /\\.[cm]?tsx?$/.test( filename );","+\tconst supportsJSX = ! isTypeScript || filename.endsWith( '.tsx' );","+\tconst parserOpts = config?.hasFilesystemConfig()","+\t\t? config.options.parserOpts","+\t\t: {","+\t\t\t\tplugins: [","+\t\t\t\t\t...( isTypeScript ? [ 'typescript' ] : [] ),","+\t\t\t\t\t...( supportsJSX ? [ 'jsx' ] : [] ),","+\t\t\t\t],","+\t\t\t};","+\treturn babel.parse( source, { filename, parserOpts } ).program;"," };"," "," const getExportTokens = ( ast ) =>"],"additions":12,"deletions":1,"truncated":false},{"path":"packages/docgen/test/engine.js","lines":["@@ -1,3 +1,8 @@","+import { execFileSync } from 'node:child_process';","+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';","+import { tmpdir } from 'node:os';","+import { join } from 'node:path';","+import { fileURLToPath } from 'node:url';"," import { describe, expect, it } from 'vitest';"," import engine from '../lib/engine';"," ","@@ -6,4 +11,59 @@ describe( 'Engine', () => {"," \t\tconst { ir } = engine( undefined );"," \t\texpect( ir ).toHaveLength( 0 );"," \t} );","+","+\tit( 'parses JSX in JavaScript without a Babel configuration', () => {","+\t\tconst { ast } = engine(","+\t\t\t'example.js',","+\t\t\t'export const element = <div />;'","+\t\t);","+","+\t\texpect( ast.body[ 0 ].declaration.declarations[ 0 ].init.type ).toBe(","+\t\t\t'JSXElement'","+\t\t);","+\t} );","+","+\tit( 'parses TypeScript type assertions without enabling JSX', () => {","+\t\tconst { ast } = engine(","+\t\t\t'example.ts',","+\t\t\t'export const value = <number>1;'","+\t\t);","+","+\t\texpect( ast.body[ 0 ].declaration.declarations[ 0 ].init.type ).toBe(","+\t\t\t'TSTypeAssertion'","+\t\t);","+\t} );","+","+\tit( 'honors custom Babel parser options', () => {","+\t\tconst project = mkdtempSync( join( tmpdir(), 'docgen-babel-config-' ) );","+","+\t\ttry {","+\t\t\twriteFileSync("