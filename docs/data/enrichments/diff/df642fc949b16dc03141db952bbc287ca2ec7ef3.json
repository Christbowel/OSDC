tatement ok con1","+COMMIT;","+","+# the duplicate is only detected when con2 appends to the shared indexes at COMMIT","+statement error con2","+COMMIT;","+----","+<REGEX>:.*Failed to commit.*","+","+# The failed commit must not invalidate the database.","+query II","+SELECT count(*), count(DISTINCT k) FROM pk;","+----","+2\t2","+","+query I","+SELECT v FROM pk WHERE k = 5000;","+----","+first","+","+# All keys of the failed commit must have been removed from both indexes.","+statement ok","+INSERT INTO pk SELECT i, i, 'retry' FROM range(1, 5000) r(i);","+","+statement error","+INSERT INTO pk VALUES (1, 50000, 'duplicate');","+----","+violates primary key constraint","+","+statement error","+INSERT INTO pk VALUES (50001, 1, 'duplicate');","+----","+<REGEX>:Constraint Error.*","+","+statement ok","+CHECKPOINT;","+","+query III","+SELECT count(*), count(DISTINCT k), count(DISTINCT u) FROM pk;","+----","+5001\t5001\t5001","+","+# A non-unique expression index is first evaluated at COMMIT: an expression error there","+# must be a normal error that removes all keys of the failed commit.","+statement ok","+CREATE TABLE ix (k INTEGER PRIMARY KEY, j INTEGER, l BIGINT);","+","+statement ok","+CREATE INDEX ix_e ON ix ((j + l));","+","+statement error","+INSERT INTO ix SELECT i, 1, CASE WHEN i = 5000 THEN 9223372036854775807 ELSE i END FROM range(1, 5001) r(i);","+----","+<REGEX>:.*Overflow.*","+","+statement ok","+INSERT INTO ix SELECT i, 1, i FROM range(1, 5000) r(i);","+","+query I","+SELECT count(*) FROM ix;","+----","+4999"],"additions":86,"deletions":0,"truncated":false},{"path":"test/sql/transactions/test_commit_flush_append_failure.test","lines":["@@ -0,0 +1,101 @@","+# name: test/sql/transactions/test_commit_flush_append_failure.test","+# description: A failed commit-time flush invalidates the database and leaves no partial state behind","+# group: [transactions]","+","+require skip_reload","+","+load {TEST_DIR}/commit_flush_append_failure.db","+","+# Copy path: appends to a non-empty table are copied row by row at commit.","+","+statement ok","+CREATE TABLE pk (k INTEGER PRIMARY KEY, v VARCHAR);","+","+statement ok","+INSERT INTO pk VALUES (1, 'a'), (2, 'b');","+","+# the restart below replays the WAL with the debug setting still enabled","+statement ok","+CHECKPOINT;","+","+statement ok","+BEGIN;","+","+statement ok","+INSERT INTO pk VALUES (3, 'c'), (4, 'd');","+","+statement ok","+SET debug_force_flush_append_failure = true;","+","+statement error","+COMMIT;","+----","+Forced flush append failure","+","+statement error","+SELECT count(*) FROM pk;","+----","+<REGEX>:.*invalidated.*","+","+restart","+","+# global settings survive a restart in the test runner","+statement ok","+SET debug_force_flush_append_failure = false;","+","+# The failed commit must not have persisted any rows or index keys.","+query II","+SELECT count(*), max(k) FROM pk;","+----","+2\t2","+","+statement ok","+INSERT INTO pk VALUES (3, 'c2'), (4, 'd2');","+","+statement error","+INSERT INTO pk VALUES (3, 'dup');","+----","+violates primary key constraint","+","+statement ok","+CHECKPOINT;","+","+query II","+SELECT count(*), max(k) FROM pk;","+----","+4\t4","+","+# Merge path: a bulk append (at least one full row group, no deletes) moves the local row groups","+# over directly instead of copying.","+","+statement ok","+CREATE TABLE m (k INTEGER PRIMARY KEY);","+","+statement ok","+BEGIN;","+","+statement ok","+INSERT INTO m SELECT i FROM range(122880) r(i);","+","+statement ok","+SET debug_force_flush_append_failure = true;","+","+statement error","+COMMIT;","+----","+Forced flush append failure","+","+statement error","+SELECT count(*) FROM m;","+----","+<REGEX>:.*invalidated.*","+","+restart","+","+statement ok","+SET debug_force_flush_append_failure = false;","+","+query I","+SELECT count(*) FROM m;","+----","+0"],"additions":101,"deletions":0,"truncated":false},{"path":"test/sql/transactions/test_commit_oom_ghost_keys.test","lines":["@@ -0,0 +1,70 @@","+# name: test/sql/transactions/test_commit_oom_ghost_keys.test","+# description: A COMMIT that runs out of memory while inserting into a primary key index invalidates the database, and its keys are gone after a restart","+# group: [transactions]","+","+require no_alternative_verify","+","+require skip_reload","+","+require no_force_storage","+","+require vector_size 2048","+","+load {TEST_DIR}/commit_oom_ghost_keys.db","+","+statement ok","+SET threads = 1;","+","+statement ok","+CREATE TABLE t (server_id INTEGER, account VARCHAR, n INTEGER, payload VARCHAR, PRIMARY KEY (server_id, account));","+","+statement ok","+INSERT INTO t SELECT 11, 'old' || i, 0, 'x' FROM range(100) r(i);","+","+statement ok","+CHECKPOINT;","+","+# No spilling: the commit must fail once memory_limit is reached.","+statement ok","+SET max_temp_directory_size = '0KB';","+","+statement ok","+INSERT OR REPLACE INTO t SELECT 11, 'old' || i, 1, 'x' FROM range(50) r(i);","+","+statement ok","+BEGIN;","+","+# Long keys: inserting them into the primary key index at commit needs more memory than is left.","+statement ok","+INSERT INTO t SELECT 12, 'key' || i || repeat('k', 1000), 0, 'x' FROM range(20000) r(i);","+","+statement ok","+SET memory_limit = '70MB';","+","+statement error","+COMMIT;","+----","+Failed to commit","+","+# A checkpoint must not persist the partially inserted keys.","+statement error","+CHECKPOINT;","+----","+<REGEX>:.*invalidated.*","+","+restart","+","+# global settings survive a restart in the test runner","+statement ok","+RESET memory_limit;","+","+statement ok","+RESET max_temp_directory_size;","+","+statement ok","+INSERT INTO t SELECT 12, 'key' || i || repeat('k', 1000), 0, 'x' FROM range(20000) r(i);","+","+query II","+SELECT count(*), count(*) FILTER (WHERE server_id = 11) FROM t;","+----","+20100\t100",""],"additions":70,"deletions":0,"truncated":false}],"additions":396,"deletions":79,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-11T15:41:08.278674+00:00"}