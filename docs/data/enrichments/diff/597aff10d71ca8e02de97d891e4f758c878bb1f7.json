,) = dag_maker.create_dagrun().get_task_instances()","+        ti.set_state(State.QUEUED)","+        dag_maker.session.flush()","+        return ti","+","+    def test_old_version_strips_execution_timeout(self, old_ver_client, stub_ti):","+        response = old_ver_client.patch(f\"/execution/task-instances/{stub_ti.id}/run\", json=RUN_PATCH_BODY)","+        assert response.status_code == 200","+        assert \"execution_timeout\" not in response.json()","+","+    def test_head_version_includes_execution_timeout(self, client, stub_ti):","+        response = client.patch(f\"/execution/task-instances/{stub_ti.id}/run\", json=RUN_PATCH_BODY)","+        assert response.status_code == 200","+        assert response.json()[\"execution_timeout\"] == 90.0","+","+"," @pytest.fixture"," def archived_attempt(client, exec_app, monkeypatch, create_task_instance, session):","     \"\"\"A running attempt, authenticated with a signed token, that has since been retried.\"\"\""],"additions":34,"deletions":0,"truncated":false},{"path":"airflow-core/tests/unit/dag_processing/test_processor.py","lines":["@@ -2371,7 +2371,7 @@ def get_type_names(union_type):","             \"UpdateHITLDetail\",","             \"GetHITLDetailResponse\",","             \"SetRenderedMapIndex\",","-            \"SetExecutionTimeout\",","+            \"StartExecutionTimeout\",","             # AIP-103 task/asset store — Dag processor has no task execution context.","             \"GetTaskStateStore\",","             \"SetTaskStateStore\","],"additions":1,"deletions":1,"truncated":false},{"path":"airflow-core/tests/unit/jobs/test_triggerer_job.py","lines":["@@ -3313,7 +3313,7 @@ def get_type_names(union_type):","             \"ResendLoggingFD\",","             \"CreateHITLDetailPayload\",","             \"SetRenderedMapIndex\",","-            \"SetExecutionTimeout\",","+            \"StartExecutionTimeout\",","             \"GetDag\",","             # AIP-103 task store — triggerer has no task execution conte