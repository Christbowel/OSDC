{"id":"597aff10d71ca8e02de97d891e4f758c878bb1f7","axis":"silent","repo":"apache/airflow","sha":"597aff10d71ca8e02de97d891e4f758c878bb1f7","parsed":{"files":[{"path":"airflow-core/docs/core-concepts/tasks.rst","lines":["@@ -140,10 +140,10 @@ Timeouts"," If you want a task to have a maximum runtime, set its ``execution_timeout`` attribute to a ``datetime.timedelta`` value"," that is the maximum permissible runtime. This applies to all Airflow tasks, including sensors. ``execution_timeout`` controls the"," maximum time allowed for every execution. If ``execution_timeout`` is breached, the task times out and","-``AirflowTaskTimeout`` is raised. For tasks executed by the Python task runner, the task supervisor enforces","-the timeout from outside the task process too: if the task has not stopped within ``[core] killed_task_cleanup_time``","-seconds after ``execution_timeout`` elapses (for example because it is blocked in native code that never returns","-control to Python), the supervisor sends it SIGTERM, and SIGKILL after the same period again.","+``AirflowTaskTimeout`` is raised. The task supervisor also enforces the timeout from outside the task process:","+if the task has not stopped within ``[core] killed_task_cleanup_time`` seconds after ``execution_timeout`` elapses","+(for example because it is blocked in native code), the supervisor sends it SIGTERM, and SIGKILL after the same","+period again. Tasks run by a language SDK do not raise ``AirflowTaskTimeout`` and are stopped only this way."," "," In addition, sensors have a ``timeout`` parameter. This only matters for sensors in ``reschedule`` mode. ``timeout`` controls the maximum"," time allowed for the sensor to succeed. If ``timeout`` is breached, ``AirflowSensorTimeout`` will be raised and the sensor fails immediately"],"additions":4,"deletions":4,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/datamodels/taskinstance.py","lines":["@@ -555,6 +555,13 @@ class TIRunContext(BaseModel):","     ``None`` for regular tasks and for stub tasks that declare no parameters.","     \"\"\""," ","+    execution_timeout: float | None = None","+    \"\"\"","+    The task's ``execution_timeout`` in seconds, taken from its serialized Dag.","+","+    The supervisor enforces the timeout with this value. ``None`` when no timeout is set.","+    \"\"\"","+","     multi_team: bool = False","     \"\"\"","     Whether the deployment runs in multi-team mode."],"additions":7,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/routes/task_instances.py","lines":["@@ -92,6 +92,8 @@"," from airflow.api_fastapi.execution_api.services.task_instances import (","     client_supports_arg_bindings,","     get_arg_bindings,","+    get_execution_timeout,","+    get_task,"," )"," from airflow.api_fastapi.execution_api.versions.v2026_10_30 import IdentifyArchivedTaskStateUpdates"," from airflow.configuration import conf","@@ -380,11 +382,11 @@ def ti_run(","         if first_task_reschedule_start_date is not None:","             context.first_task_reschedule_start_date = first_task_reschedule_start_date"," ","+        serialized_task = get_task(dag_bag, ti, session=session)","+","         # Only set for lang-SDK (foreign-runtime) tasks with a captured TaskFlow arg","         # spec; the route excludes unset fields, keeping regular responses lean.","-        if client_supports_arg_bindings() and (","-            arg_bindings := get_arg_bindings(dag_bag, ti, session=session)","-        ):","+        if client_supports_arg_bindings() and (arg_bindings := get_arg_bindings(serialized_task)):","             try:","                 context.arg_bindings = get_arg_bindings_adapter().validate_python(arg_bindings)","             except ValidationError:","@@ -402,6 +404,9 @@ def ti_run(","                     },","                 )"," ","+        if (execution_timeout := get_execution_timeout(serialized_task)) is not None:","+            context.execution_timeout = execution_timeout","+","         # Only set if they are non-null","         if ti.next_method:","             context.next_method = ti.next_method"],"additions":8,"deletions":3,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/services/task_instances.py","lines":["@@ -24,6 +24,7 @@","     from sqlalchemy.orm import Session"," ","     from airflow.models.dagbag import DBDagBag","+    from airflow.serialization.serialized_objects import SerializedOperator"," "," "," def client_supports_arg_bindings() -> bool:","@@ -44,18 +45,35 @@ def client_supports_arg_bindings() -> bool:","     return AddArgBindingsToTIRunContext.is_applied"," "," ","-def get_arg_bindings(dag_bag: DBDagBag, ti: Any, *, session: Session) -> list | None:","+def get_task(dag_bag: DBDagBag, ti: Any, *, session: Session) -> SerializedOperator | None:","+    \"\"\"Return the task of *ti* from its Dag version, or ``None`` if it cannot be found.\"\"\"","+    if ti.dag_version_id is None:","+        return None","+    if (dag := dag_bag.get_dag(ti.dag_version_id, session=session)) is None:","+        return None","+    return dag.task_dict.get(ti.task_id)","+","+","+def get_arg_bindings(task: SerializedOperator | None) -> list | None:","     \"\"\"","-    Extract the stub task's TaskFlow arg spec from its Dag version.","+    Return the TaskFlow arg spec of *task* if it is a stub task."," ","     Mapped (``.expand()``) stubs never capture a parse-time spec, so they resolve to","     ``None`` here and keep the legacy ignored-args behavior; per-map-index delivery","     lands in a follow-up.","     \"\"\"","-    if ti.dag_version_id is None:","-        return None","-    if (dag := dag_bag.get_dag(ti.dag_version_id, session=session)) is None:","-        return None","-    if (task := dag.task_dict.get(ti.task_id)) is None or not task.is_stub:","+    if task is None or not task.is_stub:","         return None","     return task.arg_bindings","+","+","+def get_execution_timeout(task: SerializedOperator | None) -> float | None:","+    \"\"\"","+    Return the ``execution_timeout`` of *task* in seconds.","+","+    Like the Python task runner, a zero timeout means no timeout, and a negative one has","+    already elapsed.","+    \"\"\"","+    if task is None or not task.execution_timeout:","+        return None","+    return max(task.execution_timeout.total_seconds(), 0.0)"],"additions":25,"deletions":7,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/versions/__init__.py","lines":["@@ -56,6 +56,7 @@","     AddArgBindingsToTIRunContext,","     AddCallbackRunEndpoint,","     AddDagRunNoteUpdateEndpoint,","+    AddExecutionTimeoutToTIRunContext,","     AddExpandedTICountToTIRunContext,","     AddFirstTaskRescheduleStartDateField,","     AddLoopContext,","@@ -79,6 +80,7 @@","         AddArgBindingsToTIRunContext,","         AddCallbackRunEndpoint,","         AddDagRunNoteUpdateEndpoint,","+        AddExecutionTimeoutToTIRunContext,","         AddExpandedTICountToTIRunContext,","         AddLoopContext,","         AddLoopDecisionField,"],"additions":2,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/api_fastapi/execution_api/versions/v2026_10_30.py","lines":["@@ -93,6 +93,20 @@ def remove_arg_bindings_field(response: ResponseInfo) -> None:","         response.body.pop(\"arg_bindings\", None)"," "," ","+class AddExecutionTimeoutToTIRunContext(VersionChange):","+    \"\"\"Add ``execution_timeout`` so the supervisor can enforce it.\"\"\"","+","+    description = __doc__","+    instructions_to_migrate_to_previous_version = (","+        schema(TIRunContext).field(\"execution_timeout\").didnt_exist,","+    )","+","+    @convert_response_to_previous_version_for(TIRunContext)  # type: ignore[arg-type]","+    def remove_execution_timeout_field(response: ResponseInfo) -> None:  # type: ignore[misc]","+        \"\"\"Strip ``execution_timeout`` from the run context for older clients.\"\"\"","+        response.body.pop(\"execution_timeout\", None)","+","+"," class AddCallbackRunEndpoint(VersionChange):","     \"\"\"Add the callbacks/{callback_id}/run endpoint a worker uses to exchange its single-use callback token.\"\"\""," "],"additions":14,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/serialization/serialized_objects.py","lines":["@@ -2156,9 +2156,9 @@ def fill_config_defaults(cls, serialized_obj: dict[str, Any]) -> None:","         Fill in the Dag settings a serialized Dag leaves unset from the Airflow config, as a Python Dag does."," ","         A Lang-SDK runtime cannot read the Airflow config, so it leaves ``max_active_tasks``,","-        ``max_active_runs``, ``max_consecutive_failed_dag_runs``, ``catchup`` and","-        ``disable_bundle_versioning`` out unless the Dag sets them. A value the Dag sets is kept.","-        *serialized_obj* is changed in place.","+        ``max_active_runs``, ``max_consecutive_failed_dag_runs``, ``catchup``,","+        ``disable_bundle_versioning`` and the tasks' default ``execution_timeout`` out unless the Dag","+        sets them. A value the Dag sets is kept. *serialized_obj* is changed in place.","         \"\"\"","         dag = serialized_obj.get(\"dag\")","         if not isinstance(dag, dict):","@@ -2178,6 +2178,9 @@ def fill_config_defaults(cls, serialized_obj: dict[str, Any]) -> None:","         ):","             if key not in dag:","                 dag[key] = get(section, option)","+        if (execution_timeout := conf.gettimedelta(\"core\", \"default_task_execution_timeout\")) is not None:","+            task_defaults = serialized_obj.setdefault(\"client_defaults\", {}).setdefault(\"tasks\", {})","+            task_defaults.setdefault(\"execution_timeout\", execution_timeout.total_seconds())"," ","     @classmethod","     def validate_serialized_dag(cls, serialized_obj: dict[str, Any]) -> SerializedDAG:"],"additions":6,"deletions":3,"truncated":false},{"path":"airflow-core/tests/unit/api_fast