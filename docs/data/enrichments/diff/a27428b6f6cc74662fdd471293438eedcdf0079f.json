cf\\ufdf0-\\ufffd'","-                         r'\\:\\-\\.0-9\\u00b7\\u0300-\\u036f\\u203f-\\u2040]+')","+    NAME_RE = NAME_RE"," ","     def run(self, doc: Element) -> None:","         for elem in doc.iter():","@@ -190,7 +201,7 @@ def sanitize_name(self, name: str) -> str:","         Sanitize name as 'an XML Name, minus the `:`.'","         See <https://www.w3.org/TR/REC-xml-names/#NT-NCName>.","         \"\"\"","-        return self.NAME_RE.sub('_', name)","+        return sanitize_name(name)"," "," "," class AttrListExtension(Extension):"],"additions":17,"deletions":6,"truncated":false},{"path":"markdown/extensions/fenced_code.py","lines":["@@ -25,7 +25,7 @@"," from . import Extension"," from ..preprocessors import Preprocessor"," from .codehilite import CodeHilite, CodeHiliteExtension, parse_hl_lines","-from .attr_list import get_attrs_and_remainder, AttrListExtension","+from .attr_list import get_attrs_and_remainder, sanitize_name, AttrListExtension"," from ..util import parseBoolValue"," from ..serializers import _escape_attrib_html"," import re","@@ -157,7 +157,8 @@ def run(self, lines: list[str]) -> list[str]:","                         # pairs were defined on the code block, and the `use_pygments` key was not set to `True`. The","                         # `use_pygments` key could be either set to `False` or not defined. It is omitted from output.","                         kv_pairs = ''.join(","-                            f' {k}=\"{_escape_attrib_html(v)}\"' for k, v in config.items() if k != 'use_pygments'","+                            f' {sanitize_name(k)}=\"{_escape_attrib_html(v)}\"'","+                            for k, v in config.items() if k != 'use_pygments'","                         )","                     code = self._escape(m.group('code'))","                     code = f'<pre{id_attr}{class_attr}><code{lang_attr}{kv_pairs}>{code}</code></pre>'"],"additions":3,"deletions":2,"truncated":false},{"path":"markdown/extensions/legacy_attrs.py","