fast=fail_fast,","+        strict=strict,","+        ref=ref,","+        metadata=metadata,","+        serialization=serialization,","+    )","+","+"," # (input_value: Any, /) -> Any"," NoInfoValidatorFunction: TypeAlias = Callable[[Any], Any]"," ","@@ -4338,6 +4407,7 @@ def definition_reference_schema(","         | FrozenSetSchema","         | GeneratorSchema","         | DictSchema","+        | FrozenDictSchema","         | AfterValidatorFunctionSchema","         | BeforeValidatorFunctionSchema","         | WrapValidatorFunctionSchema","@@ -4400,6 +4470,7 @@ def definition_reference_schema(","     'frozenset',","     'generator',","     'dict',","+    'frozendict',","     'function-after',","     'function-before',","     'function-wrap',","@@ -4475,6 +4546,7 @@ def definition_reference_schema(","     'string_not_ascii',","     'enum',","     'dict_type',","+    'frozen_dict_type',","     'mapping_type',","     'list_type',","     'tuple_type',"],"additions":72,"deletions":0,"truncated":false},{"path":"pydantic-core/src/common/frozendict.rs","lines":["@@ -0,0 +1,10 @@","+use pyo3::prelude::*;","+use pyo3::sync::PyOnceLock;","+use pyo3::types::PyType;","+","+static FROZENDICT_TYPE: PyOnceLock<Py<PyType>> = PyOnceLock::new();","+","+// TODO: remove when https://github.com/PyO3/pyo3/pull/6174 gets released and use `PyFrozenDict` instead:","+pub fn get_frozendict_type(py: Python<'_>) -> PyResult<&Bound<'_, PyType>> {","+    FROZENDICT_TYPE.import(py, \"builtins\", \"frozendict\")","+}"],"additions":10,"deletions":0,"truncated":false},{"path":"pydantic-core/src/common/mod.rs","lines":["@@ -1,3 +1,4 @@","+pub(crate) mod frozendict;"," pub(crate) mod missing_sentinel;"," pub(crate) mod prebuilt;"," pub(crate) mod union;"],"additions":1,"deletions":0,"truncated":false},{"path":"pydantic-core/src/errors/types.rs","lines":["@@ -267,6 +267,7 @@ error_types! {","     // ---------------------","     // dict errors","     DictType {},","+    FrozenDictType {},","     MappingTyp