ate) = &module_rule.r#as","+    && let Some(match_resource_data) = create_rule_as_resource(template, resource_data)","+  {","+    *resource_data = Cow::Owned(match_resource_data);","+  }"," ","   if let Some(rules) = &module_rule.rules {","-    module_rules_matcher(rules, ctx, matched_rules).await?;","+    module_rules_matcher_async(rules, ctx, resource_data, matched_rules).await?;","   }"," ","   if let Some(one_of) = &module_rule.one_of {","     let mut matched_once = false;","     for rule in one_of {","-      if module_rule_matcher(rule, ctx, matched_rules).await? {","+      if module_rule_matcher(rule, ctx, resource_data, matched_rules).await? {","         matched_once = true;","         break;","       }"],"additions":58,"deletions":16,"truncated":false},{"path":"packages/rspack/src/config/adapter.ts","lines":["@@ -380,6 +380,7 @@ const getRawModuleRule = (","   }"," ","   const rawModuleRule: RawModuleRule = {","+    as: rule.as,","     test: rule.test ? getRawRuleSetCondition(rule.test) : undefined,","     include: rule.include ? getRawRuleSetCondition(rule.include) : undefined,","     exclude: rule.exclude ? getRawRuleSetCondition(rule.exclude) : undefined,"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/rspack/src/config/types.ts","lines":["@@ -962,6 +962,14 @@ export type RuleSetRuleUseAndLoader ="," "," /** Rule defines the conditions for matching a module and the behavior of handling those modules. */"," export type RuleSetRule = RuleSetRuleUseAndLoader & {","+  /**","+   * Create a resource for matching subsequent rules from a path template.","+   * `[resource-path]` expands to the current matching path, including its extension.","+   * Query and fragment are preserved. The original resource is used by loaders.","+   * @experimental","+   */","+  as?: string;","+","   /** Matches all modules that match this resource, and will match against Resource. */","   test?: RuleSetCondition;"," "],"additions":8,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/module/rule-as/example.source.js","lines":["@@ -0,0 +1 @@","+original source"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/module/rule-as/index.js","lines":["@@ -0,0 +1,27 @@","+import source from './example.source.js';","+import sourceWithQuery from './example.source.js?inline#fragment';","+import sourceWithMatchResource from './virtual.source.js?inline#fragment!=!./example.source.js?original#real';","+import literal from './literal.source.js';","+import ordinary from './ordinary.js';","+","+it('applies templates sequentially to later and nested rules without restarting', () => {","+  expect(source).toBe('nested:next:child:final:selected:original source\\n');","+});","+","+it('preserves query and fragment when replacing the matching resource', () => {","+  expect(sourceWithQuery).toBe(","+    'nested:next:child:final:selected:query:original source\\n',","+  );","+});","+","+it('expands the current inline match resource path', () => {","+  expect(sourceWithMatchResource).toBe(sourceWithQuery);","+});","+","+it('preserves literal text and continues oneOf matching with the updated resource', () => {","+  expect(literal).toBe('choice:literal:original source\\n');","+});","+","+it('does not change unrelated modules', () => {","+  expect(ordinary).toBe('ordinary');","+});"],"additions":27,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/module/rule-as/literal.source.js","lines":["@@ -0,0 +1 @@","+original source"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/module/rule-as/ordinary.js","lines":["@@ -0,0 +1 @@","+export default 'ordinary';"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/module/rule-as/prefix-loader.mjs","lines":["@@ -0,0 +1,14 @@","+import assert from 'node:assert/strict';","+","+export default function (source) {","+  assert.match(this.resourcePath, /(?:example|literal)\\.source\\.js$/);","+  assert.equal(","+    this.resource,","+    this.resourcePath + this.resourceQuery + this.resourceFragment,","+  );","+  if (this._module.matchResource) {","+    assert.equal(this.resourceQuery, '?original');","+    assert.equal(this.resourceFragment, '#real');","+  }","+  return `${this.getOptions().prefix}${source}`;","+}"],"additions":14,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/module/rule-as/rspack.config.ts","lines":["@@ -0,0 +1,85 @@","+import { defineConfig } from '@rspack/cli';","+","+export default ['sync', 'async', 'mixed'].map((mode) => {","+  const condition = (regexp: RegExp) =>","+    mode === 'async' ? (value: string) => regexp.test(value) : regexp;","+  const use = (prefix: string) => ({","+    loader: './prefix-loader.mjs',","+    options: { prefix },","+  });","+","+  return defineConfig({","+    module: {","+      rules: [","+        { test: condition(/\\.txt$/), use: use('wrong:') },","+        { test: condition(/never-match/), as: 'wrong.txt' },","+        {","+          test: condition(/(?:example|virtual)\\.source\\.js$/),","+          type: 'asset/source',","+          as: '[resource-path].txt',","+          oneOf: [","+            { test: condition(/\\.js$/), use: use('wrong:') },","+            { test: condition(/\\.txt$/), use: use('nested:') },","+          ],","+        },","+        {","+          test: condition(/\\.source\\.js\\.txt$/),","+          include: condition(/[/\\\\]rule-as[/\\\\]/),","+          use: use('next:'),","+          as: '[resource-path].processed',","+          rules: [","+            {","+              test: condition(/\\.txt\\.processed$/),","+              use: use('child:'),","+              as: '[resource-path].final',","+            },","+          ],","+        },","+        {","+          test: condition(/\\.processed\\.final$/),","+          use: use('final:'),","+          as: '[resource-path].selected',","+          oneOf: [{ test: condition(/never-match/), as: 'wrong.txt' }],","+        },","+        {","+          test:","+            mode === 'mixed'","+              ? (value: string) =>","+                  /\\.source\\.js\\.txt\\.processed\\.final\\.selected$/.test(value)","+              : condition(/\\.source\\.js\\.txt\\.processed\\.final\\.selected$/),","+          use: use('selected:'),","+        },","+        {","+          test: condition(/\\.final\\.selected$/),","+          resourceQuery: condition(/^\\?inline$/),","+          resourceFragment: condition(/^#fragment$/),","+          use: use('query:'),","+        },","+        {","+          test: condition(/literal\\.source\\.js$/),","+          type: 'asset/source',","+          as: 'virtual/[resourcePath]-[name]*.txt',","+          oneOf: [","+            {","+              test: condition(/\\.txt$/),","+              as: '[resource-path].candidate',","+              oneOf: [{ test: condition(/never-match/), as: 'wrong.txt' }],","+            },","+            {","+              test: condition(/\\.candidate$/),","+              as: '[resource-path].chosen',","+              use: use('choice:'),","+            },","+            { test: condition(/\\.chosen$/), use: use('wrong:') },","+          ],","+        },","+        {","+          test: condition(","+            /^virtual\\/\\[resourcePath\\]-\\[name\\]\\*\\.txt\\.candidate\\.chosen$/,","+          ),","+          use: use('literal:'),","+        },","+      ],","+    },","+  });","+});"],"additions":85,"deletions":0,"truncated":false},{"path":"website/docs/en/config/module-rules.mdx","lines":["@@ -682,6 +682,40 @@ There are two phases that all loaders enter one after the other:"," - **Pitching phase:** the `pitch` method on loaders is called in the order `post, inline, normal, pre`. See [Pitching Loader](/api/loader-api/writing-loaders#pitching-loader) for details."," - **Normal phase:** the default method on loaders is executed in the order `pre, normal, inline, post`. Transformation on the source code of a module happens in this phase."," ","+## rules[].as","+","+<ApiMeta stability={Stability.Experimental} addedVersion=\"2.3.2\" />","+","+- **Type:** `string`","+","+Creates a separate resource for rule matching using a path template. The only supported placeholder is `[resource-path]`, which expands to the current matching path, including its extension but excluding query and fragment. All other text, including `*`, is used literally.","+","+Rules are evaluated in order. When a matching rule has `as`, its template sets the new matching path, and the full matching resource is rebuilt with the original query and fragment. Matching then continues with nested and subsequent rules; earlier rules are not evaluated again. A later `as` expands `[resource-path]` using the path produced by the previous `as`.","+","+The original resource is preserved for file reading and loaders. If the request contains an [inline match resource](/api/loader-api/inline-match-resource), `as` uses that matching path as its starting point.","+","+For example, `example.source.js` matches the later `.txt` rule as `example.source.js.txt`, then the `.processed` rule as `example.source.js.txt.processed`:","+","+```js title=\"rspack.config.mjs\"","+export default {","+  module: {","+    rules: [","+      {","+        test: /\\.source\\.js$/,","+        type: 'asset/source',","+        as: '[resource-path].txt',","+      },","+      {","+        test: /\\.txt$/,","+        use: './text-loader.js',","+        as: '[resource-path].processed',","+      },","+      { test: /\\.processed$/, use: './processed-loader.js' },","+    ],","+  },","+};","+```","+"," ## rules[].type"," "," - **Type:** `string`"],"additions":34,"deletions":0,"truncated":false},{"path":"website/docs/zh/config/module-rules.mdx","lines":["@@ -680,6 +680,40 @@ export default {"," - **Pitching 阶段:** loader 导出的 `pitch` 方法在 `post, inline, normal, pre` 顺序下被调用。详见 [Pitching Loader](/api/loader-api/writing-loaders#pitching-loader)。"," - **Normal 阶段:** loader 导出的默认方法在 `pre, normal, inline, post` 顺序下被执行。模块的源码转换发生在该阶段。"," ","+## rules[].as","+","+<ApiMeta stability={Stability.Experimental} addedVersion=\"2.3.2\" />","+","+- **类型：** `string`","+","+使用路径模板创建独立的规则匹配资源。目前只支持 `[resource-path]` 占位符，它会展开为当前匹配路径，包含扩展名，但不包含查询参数和片段。其他内容（包括 `*`）均作为字面量使用。","+","+规则按顺序执行。命中的规则包含 `as` 时，会用模板生成新的匹配路径，并加上原有查询参数和片段组成完整的匹配资源，然后继续匹配嵌套规则和后续规则，不会重新匹配之前的规则。后续 `as` 中的 `[resource-path]` 会使用前一次 `as` 生成的路径。","+","+文件读取和 loader 仍使用原始资源。如果请求包含 [inline match resource](/api/loader-api/inline-match-resource)，`as` 会以该匹配路径为起点。","+","+例如，`example.source.js` 会以 `example.source.js.txt` 匹配后续的 `.txt` 规则，再以 `example.source.js.txt.processed` 匹配 `.processed` 规则：","+","+```js title=\"rspack.config.mjs\"","+export default {","+  module: {","+    rules: [","+      {","+        test: /\\.source\\.js$/,","+        type: 'asset/source',","+        as: '[resource-path].txt',","+      },","+      {","+        test: /\\.txt$/,","+        use: './text-loader.js',","+        as: '[resource-path].processed',","+      },","+      { test: /\\.processed$/, use: './processed-loader.js' },","+    ],","+  },","+};","+```","+"," ## rules[].type"," "," - **类型：** `string`",""],"additions":34,"deletions":0,"truncated":false}],"additions":298,"deletions":17,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-06T17:00:02.137098+00:00"}