","+ * Validates that the current Node.js major version is at least the minimum one in `engines.node` of this package.","+ * If it is older, displays an error message and exits the process.","  *","  * @throws {void} Exits the process with code 1 if Node.js version is incompatible","  */","@@ -14,13 +17,22 @@ export default function checkRequirements() {"," \tconst nodeVersion = process.versions.node;"," \tconst currentMajor = +nodeVersion.split('.')[0];"," ","-\tconst expectedMajor = 22;","+\tconst minimumMajor = getMinimumMajor();"," ","-\tif (currentMajor !== expectedMajor) {","+\tif (currentMajor < minimumMajor) {"," \t\tconsole.error(`You are running ${chalk.red(`Node.js ${nodeVersion}`)}.`);","-\t\tconsole.error(`Directus requires ${chalk.green(`Node.js ${expectedMajor}`)}.`);","+\t\tconsole.error(`Directus requires ${chalk.green(`Node.js ${minimumMajor}`)} or newer.`);"," \t\tconsole.error('Please adjust your Node.js version and try again.');"," "," \t\tprocess.exit(1);"," \t}"," }","+","+/**","+ * Get the minimum supported Node.js major version from `engines.node` of this package.","+ *","+ * @returns {number} The minimum supported major version","+ */","+export function getMinimumMajor() {","+\treturn +pkg.engines.node.match(/\\d+/)[0];","+}"],"additions":17,"deletions":5,"truncated":false},{"path":"packages/create-directus-project/lib/check-requirements.test.js","lines":["@@ -1,5 +1,18 @@","+import { readFileSync } from 'node:fs';"," import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';","-import checkRequirements from './check-requirements.js';","+import checkRequirements, { getMinimumMajor } from './check-requirements.js';","+","+// The minimum major is read from package.json, so the versions below are derived from it","+const major = getMinimumMajor();","+","+describe('getMinimumMajor', () => {","+\tit('should return the major version from engines.node in package.json', () => {","+\t\tconst pkg = JSON.parse(readFileSync(new URL('../p