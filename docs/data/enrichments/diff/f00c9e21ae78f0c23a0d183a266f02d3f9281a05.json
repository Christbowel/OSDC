ted":false},{"path":"api/src/utils/get-cache-key.ts","lines":["@@ -1,4 +1,3 @@","-import url from 'url';"," import { toArray } from '@directus/utils';"," import { ipInNetworks } from '@directus/utils/node';"," import { version } from 'directus/version';","@@ -9,13 +8,14 @@ import getDatabase from '../database/index.js';"," import { getFlowManager } from '../flows.js';"," import { fetchPoliciesIpAccess } from '../permissions/modules/fetch-policies-ip-access/fetch-policies-ip-access.js';"," import { getGraphqlQueryAndVariables } from './get-graphql-query-and-variables.js';","+import { parseRequestUrl } from './parse-request-url.js';"," "," // Match /flows/trigger/<uuid> and extract the UUID"," const FLOW_TRIGGER_PATTERN = /^\\/flows\\/trigger\\/([0-9a-f-]+)/i;"," "," export async function getCacheKey(req: Request) {","-\tconst path = url.parse(req.originalUrl).pathname;","-\tconst isGraphQl = path?.startsWith('/graphql');","+\tconst path = parseRequestUrl(req.originalUrl).pathname;","+\tconst isGraphQl = path.startsWith('/graphql');"," "," \tlet flowTriggerQuery: Record<string, any> | undefined = undefined;"," "],"additions":3,"deletions":3,"truncated":false},{"path":"api/src/utils/parse-request-url.test.ts","lines":["@@ -0,0 +1,54 @@","+import { describe, expect, test } from 'vitest';","+import { parseRequestUrl } from './parse-request-url.js';","+","+describe('parseRequestUrl', () => {","+\ttest('returns the pathname of a path without query', () => {","+\t\texpect(parseRequestUrl('/items/articles')).toEqual({ pathname: '/items/articles', query: null });","+\t});","+","+\ttest('splits off the query string', () => {","+\t\texpect(parseRequestUrl('/items/articles?fields=id&limit=1')).toEqual({","+\t\t\tpathname: '/items/articles',","+\t\t\tquery: 'fields=id&limit=1',","+\t\t});","+\t});","+","+\ttest('returns an empty query for a trailing question mark', () => {","+\t\texpect(parseRequestUrl('/items/articles?')).toEqual({ pathname: '/items/articles', query: '' });","+\t});","+","+\ttest('keeps question marks after the first one in the query', () => {","+\t\texpect(parseRequestUrl('/items/articles?filter=a?b')).toEqual({ pathname: '/items/articles', query: 'filter=a?b' });","+\t});","+","+\ttest('drops the fragment', () => {","+\t\texpect(parseRequestUrl('/items/articles?limit=1#top')).toEqual({ pathname: '/items/articles', query: 'limit=1' });","+\t\texpect(parseRequestUrl('/items/articles#top?limit=1')).toEqual({ pathname: '/items/articles', query: null });","+\t});","+","+\ttest('drops the origin of absolute-form request targets', () => {","+\t\texpect(parseRequestUrl('http://example.com/graphql?query=x')).toEqual({ pathname: '/graphql', query: 'query=x' });","+","+\t\texpect(parseRequestUrl('HTTPS://user@example.com:8055/server/ping')).toEqual({","+\t\t\tpathname: '/server/ping',","+\t\t\tquery: null,","+\t\t});","+\t});","+","+\ttest('returns the root pathname for an absolute-form target without path', () => {","+\t\texpect(parseRequestUrl('http://example.com')).toEqual({ pathname: '/', query: null });","+\t\texpect(parseRequestUrl('http://example.com?a=1')).toEqual({ pathname: '/', query: 'a=1' });","+\t});","+","+\ttest.each(['//example.com/items/articles', '/items/../server/info', '/items/%2e%2e/server/info', '/items/a\\\\b'])(","+\t\t'does not normalize \"%s\"',","+\t\t(requestUrl) => {","+\t\t\texpect(parseRequestUrl(requestUrl)).toEqual({ pathname: requestUrl, query: null });","+\t\t},","+\t);","+","+\ttest('does not throw on malformed input', () => {","+\t\texpect(parseRequestUrl('/items/%zz?%%')).toEqual({ pathname: '/items/%zz', query: '%%' });","+\t\texpect(parseRequestUrl('http://[/items')).toEqual({ pathname: '/items', query: null });","+\t});","+});"],"additions":54,"deletions":0,"truncated":false},{"path":"api/src/utils/parse-request-url.ts","lines":["@@ -0,0 +1,17 @@","+/**","+ * Split a raw request URL (`req.url` / `req.originalUrl`) into its pathname and query string.","+ *","+ * Replaces the deprecated `url.parse`. Unlike the WHATWG `URL` it never throws and doesn't normalize the path","+ * (`..`, `%2e%2e`, `//`), so the pathname stays the one the router matched against. The `scheme://authority` prefix","+ * of absolute-form request targets (`GET http://host/path`) is dropped, the same way the router ignores it.","+ *","+ * @param requestUrl Raw request URL","+ */","+export function parseRequestUrl(requestUrl: string): { pathname: string; query: string | null } {","+\tconst withoutHash = requestUrl.replace(/^[a-z][a-z\\d+.-]*:\\/\\/[^/?#]*/i, '').split('#', 1)[0] || '';","+\tconst queryIndex = withoutHash.indexOf('?');","+","+\tif (queryIndex === -1) return { pathname: withoutHash || '/', query: null };","+","+\treturn { pathname: withoutHash.slice(0, queryIndex) || '/', query: withoutHash.slice(queryIndex + 1) };","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"api/src/utils/should-skip-cache.ts","lines":["@@ -1,7 +1,7 @@","-import url from 'url';"," import { useEnv } from '@directus/env';"," import { getEndpoint } from '@directus/utils';"," import type { Request } from 'express';","+import { parseRequestUrl } from './parse-request-url.js';"," import { Url } from './url.js';"," "," /**","@@ -34,9 +34,7 @@ export function shouldSkipCache(req: Request): boolean {"," \tfunction checkAutoPurge() {"," \t\tif (env['CACHE_AUTO_PURGE'] === false) return true;"," ","-\t\tconst path = url.parse(req.originalUrl).pathname;","-","-\t\tif (!path) return false;","+\t\tconst path = parseRequestUrl(req.originalUrl).pathname;"," "," \t\tfor (const collection of env['CACHE_AUTO_PURGE_IGNORE_LIST'] as string[]) {"," \t\t\tconst ignoredPath = getEndpoint(collection);"],"additions":2,"deletions":4,"truncated":false},{"path":"app/vite.config.js","lines":["@@ -93,6 +93,8 @@ export default defineConfig({"," \t\tdir: path.resolve(__dirname, '..'),"," \t\tinclude: ['app/**/*.test.ts'],"," \t\tenvironment: 'happy-dom',","+\t\t// Node 25+ defines its own localStorage/sessionStorage