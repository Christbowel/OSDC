@ func TestPodSandboxByCreatedThenID(t *testing.T) {"," \t\t})"," \t}"," }","+","+func TestToKubeRuntimeStatusCgroupMountMode(t *testing.T) {","+\ttestCases := []struct {","+\t\tname                  string","+\t\tfeatures              *runtimeapi.RuntimeFeatures","+\t\texpectedFeatures      bool","+\t\texpectedCgroupSupport bool","+\t}{","+\t\t{","+\t\t\tname:             \"nil features\",","+\t\t\tfeatures:         nil,","+\t\t\texpectedFeatures: false,","+\t\t},","+\t\t{","+\t\t\tname:                  \"supports cgroup mount mode\",","+\t\t\tfeatures:              &runtimeapi.RuntimeFeatures{CgroupMountMode: true},","+\t\t\texpectedFeatures:      true,","+\t\t\texpectedCgroupSupport: true,","+\t\t},","+\t\t{","+\t\t\tname:                  \"does not support cgroup mount mode\",","+\t\t\tfeatures:              &runtimeapi.RuntimeFeatures{CgroupMountMode: false},","+\t\t\texpectedFeatures:      true,","+\t\t\texpectedCgroupSupport: false,","+\t\t},","+\t}","+","+\tfor _, tc := range testCases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tstatus := &runtimeapi.RuntimeStatus{","+\t\t\t\tConditions: []*runtimeapi.RuntimeCondition{","+\t\t\t\t\t{Type: \"RuntimeReady\", Status: true},","+\t\t\t\t},","+\t\t\t}","+\t\t\tresult := toKubeRuntimeStatus(status, nil, tc.features)","+\t\t\tif !tc.expectedFeatures {","+\t\t\t\tassert.Nil(t, result.Features)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tassert.NotNil(t, result.Features)","+\t\t\tassert.Equal(t, tc.expectedCgroupSupport, result.Features.CgroupMountMode)","+\t\t})","+\t}","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/component-helpers/nodedeclaredfeatures/features/cgroupoptions/feature.go","lines":["@@ -0,0 +1,88 @@","+/*","+Copyright The Kubernetes Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package cgroupoptions","+","+import (","+\tv1 \"k8s.io/api/core/v1\"","+\t\"k8s.io/apimachinery/pkg/util/version\"","+\t\"k8s.io/component-helpers/nodedeclaredfeatures/types\"","+)","+","+var _ types.Feature = &cgroupOptionsFeature{}","+","+const (","+\t// CgroupOptionsFeatureGate is the feature gate name.","+\tCgroupOptionsFeatureGate = \"CgroupOptions\"","+\t// CgroupOptionsFeatureName is the declared feature name.","+\tCgroupOptionsFeatureName = \"CgroupOptions\"","+)","+","+// Feature is the implementation of the `CgroupOptions` feature.","+var Feature = &cgroupOptionsFeature{}","+","+type cgroupOptionsFeature struct{}","+","+func (f *cgroupOptionsFeature) Name() string {","+\treturn CgroupOptionsFeatureName","+}","+","+func (f *cgroupOptionsFeature) Requirements() *types.FeatureRequirements {","+\treturn &types.FeatureRequirements{","+\t\tEnabledFeatureGates: []string{CgroupOptionsFeatureGate},","+\t\tRequiredRuntimeFeatures: &types.RuntimeFeatures{","+\t\t\tCgroupMountMode: true,","+\t\t},","+\t}","+}","+","+func (f *cgroupOptionsFeature) Discover(cfg *types.NodeConfiguration) bool {","+\tif !cfg.FeatureGates.Enabled(CgroupOptionsFeatureGate) {","+\t\treturn false","+\t}","+\treturn cfg.RuntimeFeatures.CgroupMountMode","+}","+","+func (f *cgroupOptionsFeature) InferForScheduling(podInfo *types.PodInfo) bool {","+\tfor i := range podInfo.Spec.Containers {","+\t\tif requestsCgroupMountMode(podInfo.Spec.Containers[i].SecurityContext) {","+\t\t\treturn true","+\t\t}","+\t}","+\tfor i := range podInfo.Spec.InitContainers {","+\t\tif requestsCgroupMountMode(podInfo.Spec.InitContainers[i].SecurityContext) {","+\t\t\treturn true","+\t\t}","+\t}","+\tfor i := range podInfo.Spec.EphemeralContainers {","+\t\tif requestsCgroupMountMode(podInfo.Spec.EphemeralContainers[i].SecurityContext) {","+\t\t\treturn true","+\t\t}","+\t}","+\treturn false","+}","+","+func (f *cgroupOptionsFeature) InferForUpdate(oldPodInfo, newPodInfo *types.PodInfo) bool {","+\treturn false","+}","+","+func (f *cgroupOptionsFeature) MaxVersion() *version.Version {","+\treturn nil","+}","+","+func requestsCgroupMountMode(sc *v1.SecurityContext) bool {","+\treturn sc != nil && sc.CgroupOptions != nil && sc.CgroupOptions.MountMode != nil","+}"],"additions":88,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/component-helpers/nodedeclaredfeatures/features/cgroupoptions/feature_test.go","lines":["@@ -0,0 +1,148 @@","+/*","+Copyright The Kubernetes Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package cgroupoptions","+","+import (","+\t\"testing\"","+","+\tv1 \"k8s.io/api/core/v1\"","+\t\"k8s.io/component-helpers/nodedeclaredfeatures/types\"","+)","+","+func TestRequirements(t *testing.T) {","+\treqs := Feature.Requirements()","+\tif reqs == nil {","+\t\tt.Fatalf(\"Requirements returned nil\")","+\t}","+\tif len(reqs.EnabledFeatureGates) != 1 || reqs.EnabledFeatureGates[0] != CgroupOptionsFeatureGate {","+\t\tt.Fatalf(\"unexpected required feature gates: %v\", reqs.EnabledFeatureGates)","+\t}","+\tif reqs.RequiredRuntimeFeatures == nil || !reqs.RequiredRuntimeFeatures.CgroupMountMode {","+\t\tt.Fatalf(\"unexpected required runtime features: %v\", reqs.RequiredRuntimeFeatures)","+\t}","+}","+","+func TestName(t *testing.T) {","+\tif Feature.Name() != CgroupOptionsFeatureName {","+\t\tt.Fatalf(\"expected Name to be %s, got %s\", CgroupOptionsFeatureName, Feature.Name())","+\t}","+}","+","+func TestDiscoverFeature(t *testing.T) {","+\ttests := []struct {","+\t\tname           string","+\t\tfeatureGate    bool","+\t\truntimeSupport bool","+\t\texpected       bool","+\t}{","+\t\t{","+\t\t\tname:           \"feature gate disabled\",","+\t\t\tfeatureGate:    false,","+\t\t\truntimeSupport: true,","+\t\t\texpected:       false,","+\t\t},","+\t\t{","+\t\t\tname:           \"runtime does not support cgroup mount mode\",","+\t\t\tfeatureGate:    true,","+\t\t\truntimeSupport: false,","+\t\t\texpected:       false,","+\t\t},","+\t\t{","+\t\t\tname:           \"all requirements met\",","+\t\t\tfeatureGate:    true,","+\t\t\truntimeSupport: true,","+\t\t\texpected:       true,","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tcfg := &types.NodeConfiguration{","+\t\t\t\tFeatureGates:    types.FeatureGateMap{CgroupOptionsFeatureGate: tt.featureGate},","+\t\t\t\tRuntimeFeatures: types.RuntimeFeatures{CgroupMountMode: tt.runtimeSupport},","+\t\t\t}","+\t\t\tif got := Feature.Discover(cfg); got != tt.expected {","+\t\t\t\tt.Errorf(\"Discover() = %v, want %v\", got, tt.expected)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func readWriteCgroupsSecurityContext() *v1.SecurityContext {","+\tmountMode := v1.CgroupMountModeReadWrite","+\treturn &v1.SecurityContext{CgroupOptions: &v1.CgroupOptions{MountMode: &mountMode}}","+}","+","+func readOnlyCgroupsSecurityContext() *v1.SecurityContext {","+\tmountMode := v1.CgroupMountModeReadOnly","+\treturn &v1.SecurityContext{CgroupOptions: &v1.CgroupOptions{MountMode: &mountMode}}","+}","+","+func TestInferForScheduling(t *testing.T) {","+\ttests := []struct {","+\t\tname     string","+\t\tspec     v1.PodSpec","+\t\texpected bool","+\t}{","+\t\t{","+\t\t\tname:     \"no security context\",","+\t\t\tspec:     v1.PodSpec{Containers: []v1.Container{{Name: \"a\"}}},","+\t\t\texpected: false,","+\t\t},","+\t\t{","+\t\t\tname:     \"read-only mount mode\",","+\t\t\tspec:     v1.PodSpec{Containers: []v1.Container{{Name: \"a\", SecurityContext: readOnlyCgroupsSecurityContext()}}},","+\t\t\texpected: true,","+\t\t},","+\t\t{","+\t\t\tname:     \"empty cgroupOptions\",","+\t\t\tspec:     v1.PodSpec{Containers: []v1.Container{{Name: \"a\", SecurityContext: &v1.SecurityContext{CgroupOptions: &v1.CgroupOptions{}}}}},","+\t\t\texpected: false,","+\t\t},","+\t\t{","+\t\t\tname:     \"read-write container\",","+\t\t\tspec:     v1.PodSpec{Containers: []v1.Container{{Name: \"a\", SecurityContext: readWriteCgroupsSecurityContext()}}},","+\t\t\texpected: true,","+\t\t},","+\t\t{","+\t\t\tname:     \"read-write init container\",","+\t\t\tspec:     v1.PodSpec{InitContainers: []v1.Container{{Name: \"a\", SecurityContext: readWriteCgroupsSecurityContext()}}},","+\t\t\texpected: true,","+\t\t},","+\t\t{","+\t\t\tname:     \"read-only init container\",","+\t\t\tspec:     v1.PodSpec{InitContainers: []v1.Container{{Name: \"a\", SecurityContext: readOnlyCgroupsSecurityContext()}}},","+\t\t\texpected: true,","+\t\t},","+\t\t{","+\t\t\tname: \"read-write ephemeral container\",","+\t\t\tspec: v1.PodSpec{EphemeralContainers: []v1.EphemeralContainer{{","+\t\t\t\tEphemeralContainerCommon: v1.EphemeralContainerCommon{Name: \"a\", SecurityContext: readWriteCgroupsSecurityContext()},","+\t\t\t}}},","+\t\t\texpected: true,","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tspec := tt.spec","+\t\t\tif got := Feature.InferForScheduling(&types.PodInfo{Spec: &spec}); got != tt.expected {","+\t\t\t\tt.Errorf(\"InferForScheduling() = %v, want %v\", got, tt.expected)","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":148,"delet