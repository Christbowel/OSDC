e.projects) ?? [], [data?.pages])","+","+  useEffect(() => {","+    if (entry?.isIntersecting && hasNextPage && !isFetching && !isFetchingNextPage) {","+      fetchNextPage()","+    }","+  }, [entry?.isIntersecting, hasNextPage, isFetching, isFetchingNextPage, fetchNextPage])","+","+  const handleSelect = (project: ProjectInfoInfinite) => {","+    onSelectProject(project)","+    onChange(project.ref)","+  }","+","+  return (","+    <Command shouldFilter={false}>","+      <CommandInput","+        showResetIcon","+        value={search}","+        onValueChange={setSearch}","+        placeholder=\"Find project...\"","+        handleReset={() => setSearch('')}","+        className=\"text-base sm:text-sm\"","+        // FilterBar keeps focus on the chip's input, so move it here for cmdk's arrow/enter keys","+        autoFocus","+      />","+      <CommandList className=\"max-h-[300px] overflow-y-auto overflow-x-hidden\">","+        <CommandGroup>","+          {isLoading && (","+            <div className=\"px-2 py-1\">","+              <ShimmeringLoader className=\"py-2\" />","+            </div>","+          )}","+          {isError && (","+            <p className=\"text-xs text-center text-foreground-lighter py-3\">","+              Failed to retrieve projects: {error.message}","+            </p>","+          )}","+          {isSuccess && projects.length === 0 && (","+            <p className=\"text-xs text-center text-foreground-lighter py-3\">","+              {search.length > 0 ? 'No projects found based on your search' : 'No projects found'}","+            </p>","+          )}","+          {isSuccess &&","+            projects.map((project) => (","+              <CommandItem","+                key={project.ref}","+                value={`${project.name.replaceAll('\"', '')}-${project.ref}`}","+                className=\"cursor-pointer w-full\"","+                onSelect={() => handleSelect(project)}","+              >","+                {project.name}","+      