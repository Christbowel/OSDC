 } = await emitDestination(","+\t\t\t{ entrypoint: 'astro/logger/json', config: { level: 'info' } },","+\t\t\tresolveAll,","+\t\t);","+","+\t\tassert.deepEqual(imports, ['import _logger0 from \"/resolved/astro/logger/json\";']);","+\t\tassert.equal(expression, '_logger0({\"level\":\"info\"})');","+\t});","+","+\tit('instantiates with `undefined` when no config is provided', async () => {","+\t\tconst { expression } = await emitDestination({ entrypoint: 'astro/logger/json' }, resolveAll);","+\t\tassert.equal(expression, '_logger0(undefined)');","+\t});","+","+\tit('starts numbering at the given offset', async () => {","+\t\tconst { expression, imports } = await emitDestination(","+\t\t\t{ entrypoint: 'astro/logger/json' },","+\t\t\tresolveAll,","+\t\t\t3,","+\t\t);","+","+\t\tassert.deepEqual(imports, ['import _logger3 from \"/resolved/astro/logger/json\";']);","+\t\tassert.equal(expression, '_logger3(undefined)');","+\t});","+","+\tit('inlines composed destinations under unique import names', async () => {","+\t\tconst { expression, imports } = await emitDestination(","+\t\t\t{","+\t\t\t\tentrypoint: 'astro/logger/compose',","+\t\t\t\tloggers: [","+\t\t\t\t\t{ entrypoint: 'astro/logger/json', config: { level: 'warn' } },","+\t\t\t\t\t{ entrypoint: 'astro/logger/console' },","+\t\t\t\t],","+\t\t\t},","+\t\t\tresolveAll,","+\t\t);","+","+\t\tassert.deepEqual(imports, [","+\t\t\t'import _logger0 from \"/resolved/astro/logger/compose\";',","+\t\t\t'import _logger1 from \"/resolved/astro/logger/json\";',","+\t\t\t'import _logger2 from \"/resolved/astro/logger/console\";',","+\t\t]);","+\t\tassert.equal(expression, '_logger0([_logger1({\"level\":\"warn\"}), _logger2(undefined)])');","+\t});","+","+\tit('keeps import names unique across nested composed destinations', async () => {","+\t\tconst { expression, imports } = await emitDestination(","+\t\t\t{","+\t\t\t\tentrypoint: 'astro/logger/compose',","+\t\t\t\tloggers: [","+\t\t\t\t\t{","+\t\t\t\t\t\tentrypoint: 'astro/logg