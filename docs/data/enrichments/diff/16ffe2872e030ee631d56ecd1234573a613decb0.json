{"id":"16ffe2872e030ee631d56ecd1234573a613decb0","axis":"silent","repo":"pnpm/pnpm","sha":"16ffe2872e030ee631d56ecd1234573a613decb0","parsed":{"files":[{"path":".changeset/moved-tree-store-on-project-volume.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm run` and `pnpm exec` with `verifyDepsBeforeRun` now accept a moved project whose store is on the project's volume. Before, the check reported that the workspace structure had changed whenever the default store was not on the home volume."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/apply.rs","lines":["@@ -26,6 +26,7 @@ where","     }","     let resolved = resolve_store_dir::<Sys>(store_dir, &workspace_dir)?;","     config.store_dir = StoreDir::from(lexical_normalize(&resolved));","+    config.store_dir_placement_skipped = false;","     if let Some(store_dir) = store_dir.to_str() {","         config.explicit_settings.insert(","             \"storeDir\".to_string(),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests/paths.rs","lines":["@@ -232,7 +232,7 @@ fn store_dir_override_expands_quoted_home_path() {","         }","     }"," ","-    let mut config = Config::default();","+    let mut config = Config { store_dir_placement_skipped: true, ..Config::default() };","     apply_store_dir_override::<FakeHome>(","         &mut config,","         std::path::Path::new(\"~/quoted-store\"),","@@ -248,6 +248,7 @@ fn store_dir_override_expands_quoted_home_path() {","         config.explicit_settings.get(\"storeDir\"),","         Some(&serde_json::Value::String(\"~/quoted-store\".to_string())),","     );","+    assert!(!config.store_dir_placement_skipped, \"a pinned store needs no placement\");"," }"," "," #[test]"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/derive_layout.rs","lines":["@@ -149,7 +149,9 @@ impl Config {","         // Without this, typescript-eslint's