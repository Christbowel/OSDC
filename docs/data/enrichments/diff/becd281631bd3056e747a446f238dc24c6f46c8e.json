s)"," \t}"," "],"additions":1,"deletions":1,"truncated":false},{"path":"internal/command/views/providers_schema.go","lines":["@@ -0,0 +1,114 @@","+// Copyright IBM Corp. 2014, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package views","+","+import (","+\t\"fmt\"","+","+\t\"github.com/hashicorp/terraform/internal/command/arguments\"","+\t\"github.com/hashicorp/terraform/internal/command/jsonprovider\"","+\t\"github.com/hashicorp/terraform/internal/terraform\"","+\t\"github.com/hashicorp/terraform/internal/tfdiags\"","+)","+","+// ProvidersSchema is the view used for the `providers schema` command.","+type ProvidersSchema interface {","+\tSchemas(schemas *terraform.Schemas) tfdiags.Diagnostics","+","+\tDiagnostics(diags tfdiags.Diagnostics)","+}","+","+func NewProvidersSchema(viewType arguments.ViewType, view *View) ProvidersSchema {","+\t// formatVersion represents the version of the json format and will be","+\t// incremented for any change to this format that requires changes to a","+\t// consuming parser.","+\tformatVersion := \"1.0\"","+","+\tswitch viewType {","+\tcase arguments.ViewHuman:","+\t\treturn &ProvidersSchemaHuman{view: view}","+\tcase arguments.ViewJSON:","+\t\treturn &ProvidersSchemaJSON{","+\t\t\tformatVersion: formatVersion,","+\t\t\tview:          NewJSONStaticView[ProvidersSchemaOutput](view),","+\t\t\tlegacyView:    view,","+\t\t}","+\tdefault:","+\t\tpanic(\"unsupported view type: \" + string(viewType))","+\t}","+}","+","+// The human view is only rendered to enable rendering argument-parsing errors","+// when the user has failed to supply the -json flag. This is due to Terraform's","+// design of human-output as the default experience.","+type ProvidersSchemaHuman struct {","+\tview *View","+}","+","+var _ ProvidersSchema = (*ProvidersSchemaHuman)(nil)","+","+// Argument-parsing errors should cause an early exit before the command invokes this.","+func (v *ProvidersSchemaHuman) Schemas(schemas *terraform.Schemas) tfdiags.Diagnostics {","+\tpanic(\"not implemented\")","+}","+","+func (v *ProvidersSchemaHuman) Diagnostics(diags tfdiags.Diagnostics) {","+\tv.view.Diagnostics(diags)","+}","+","+// CURRENTLY UNUSED: This view implementation isn't in control of the JSON output format.","+// See jsonview package's `newProviders` function. This sets a format_version value","+// that is at the top-level of `provider schema`'s output. Therefore it's both describing the","+// format of the schema object and the overall command's output structure.","+//","+// Due to this we cannot add diagnostics to the JSON output, as we cannot increment the","+// format_version value easily (i.e. do we include nested format_versions for JSON schemas shared","+// between commands? This decision impacts what we do here.).","+//","+// For an example of current output structure, see:","+// internal/command/testdata/providers-schema/basic/output.json","+type ProvidersSchemaOutput struct {","+\t// unused due to issue described above; diagnostics cannot be displayed in JSON format.","+}","+","+type ProvidersSchemaJSON struct {","+\tview *JSONStaticView[ProvidersSchemaOutput]","+","+\tlegacyView *View","+","+\tformatVersion string","+}","+","+var _ ProvidersSchema = (*ProvidersSchemaJSON)(nil)","+","+func (v *ProvidersSchemaJSON) Schemas(schemas *terraform.Schemas) tfdiags.Diagnostics {","+\tif schemas == nil {","+\t\tschemas = &terraform.Schemas{}","+\t}","+","+\tjsonSchemas, err := jsonprovider.Marshal(schemas)","+\tif err != nil {","+\t\tdiags := tfdiags.Diagnostics{","+\t\t\ttfdiags.Sourceless(","+\t\t\t\ttfdiags.Error,","+\t\t\t\t\"Failed to render schemas as JSON\",","+\t\t\t\tfmt.Sprintf(\"Failed to marshal provider schemas to json: %s\", err),","+\t\t\t),","+\t\t}","+\t\treturn diags","+\t}","+","+\tv.view.view.streams.Println(string(jsonSchemas))","+\treturn nil","+}","+","+// Human-readable diagnostics output for the JSON view for backwards compatibility and also","+// because we cannot easily change the JSON output for