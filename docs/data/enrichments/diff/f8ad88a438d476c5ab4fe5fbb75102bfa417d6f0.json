{"id":"f8ad88a438d476c5ab4fe5fbb75102bfa417d6f0","axis":"silent","repo":"elsa-workflows/elsa-core","sha":"f8ad88a438d476c5ab4fe5fbb75102bfa417d6f0","parsed":{"files":[{"path":"core/src/modules/Elsa.Workflows.Admission/AdmissionWorkflowRuntime.cs","lines":["@@ -50,6 +50,21 @@ public async Task<RunWorkflowInstanceResponse> RunInstanceAsync(RunWorkflowInsta","             var owned = await store.FindByInstanceAsync(WorkflowInstanceId, cancellationToken);","             return owned == null ? await inner.RunInstanceAsync(request, cancellationToken) : await execution.ResumeAsync(owned, request, cancellationToken);","         }","+        public async Task<RunWorkflowInstanceResponse?> RunInstanceIfPendingAsync(RunWorkflowInstanceRequest request, CancellationToken cancellationToken = default)","+        {","+            var owned = await store.FindByInstanceAsync(WorkflowInstanceId, cancellationToken);","+            if (owned != null)","+            {","+                // The admission execution service serialises resumption of an admitted instance;","+                // keep the same run path, with the pending decision made against the stored state.","+                var state = await inner.ExportStateAsync(cancellationToken);","+                return state.SubStatus == WorkflowSubStatus.Pending","+                    ? await execution.ResumeAsync(owned, request, cancellationToken)","+                    : null;","+            }","+","+            return await inner.RunInstanceIfPendingAsync(request, cancellationToken);","+        }","         public async Task CancelAsync(CancellationToken cancellationToken = default)","         {","             await guard.DemandUnownedAsync(WorkflowInstanceId, cancellationToken);"],"additions":15,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime.Distributed/Services/DistributedWorkflowClient.cs","lines":["@@ -34,6 +34,13 @@ public async Task<RunWorkflowInstanceResponse> RunInstanceAsync(RunWorkflowInsta","         return result;","     }"," ","+    public async Task<RunWorkflowInstanceResponse?> RunInstanceIfPendingAsync(RunWorkflowInstanceRequest request, CancellationToken cancellationToken = default)","+    {","+        // Read and run under the same lock: deciding outside it lets two dispatchers that","+        // both observed Pending pass the guard and run the instance twice (#8869).","+        return await WithLockAsync(async () => await _localWorkflowClient.RunInstanceIfPendingAsync(request, cancellationToken), cancellationToken);","+    }","+","     public async Task<RunWorkflowInstanceResponse> CreateAndRunInstanceAsync(CreateAndRunWorkflowInstanceRequest request, CancellationToken cancellationToken = default)","     {","         // We need to lock newly created workflow instances too, because it might dispatch child workflows that attempt to resume the parent workflow."],"additions":7,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Contracts/IWorkflowClient.cs","lines":["@@ -1,3 +1,4 @@","+using Elsa.Workflows;"," using Elsa.Workflows.Runtime.Messages;"," using Elsa.Workflows.State;"," ","@@ -23,6 +24,21 @@ public interface IWorkflowClient","     /// Executes the workflow instance and waits for it to complete or reach a suspend point.","     /// </summary>","     Task<RunWorkflowInstanceResponse> RunInstanceAsync(RunWorkflowInstanceRequest request, CancellationToken cancellationToken = default);","+","+    /// <summary>","+    /// Runs the instance only while it is still pending.","+    /// The default implementation exports the state and then runs, which is best-effort: another caller can change the","+    /// sub-status between the two calls. Implementations that can read and run under the same instance lock override","+    /// this method to make the guard atomic.","+    /// Returns <c>null</c> without running when the instance has already left the pending sub-status.","+    /// </summary>","+    async Task<RunWorkflowInstanceResponse?> RunInstanceIfPendingAsync(RunWorkflowInstanceRequest request, CancellationToken cancellationToken = default)","+    {","+        var state = await ExportStateAsync(cancellationToken);","+        return state.SubStatus == WorkflowSubStatus.Pending","+            ? await RunInstanceAsync(request, cancellationToken)","+            : null;","+    }","     ","     /// <summary>","     /// Creates a new workflow instance and executes it."],"additions":16,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Services/LocalWorkflowClient.cs","lines":["@@ -90,6 +90,21 @@ public async Task<RunWorkflowInstanceResponse> RunInstanceAsync(RunWorkflowInsta","         return await RunInstanceAsync(workflowInstance, request, cancellationToken);","     }"," ","+    /// <inheritdoc />","+    public async Task<RunWorkflowInstanceResponse?> RunInstanceIfPendingAsync(RunWorkflowInstanceRequest request, CancellationToken cancellationToken = default)","+    {","+        await DemandUnownedAsync(workflowInstanceId, cancellationToken);","+        var workflowInstance = await GetWorkflowInstanceAsync(cancellationToken);","+","+        if (workflowInstance.SubStatus != WorkflowSubStatus.Pending)","+        {","+            logger.LogDebug(\"Skipping run of workflow instance {WorkflowInstanceId}: sub-status is {SubStatus}, not Pending.\", workflowInstanceId, workflowInstance.SubStatus);","+            return null;","+        }","+","+        return await RunInstanceAsync(workflowInstance, request, cancellationToken);","+    }","+","     /// <inheritdoc />","     public async Task<RunWorkflowInstanceResponse> CreateAndRunInstanceAsync(CreateAndRunWorkflowInstanceRequest request, CancellationToken cancellationToken = default)","     {"],"additions":15,"deletions":0,"truncated":false},{"path":"core/test/unit/Elsa.Workflows.Runtime.UnitTests/Services/DistributedWorkflowClientTests.cs","lines":["@@ -111,4 +111,101 @@ public async Task CreateAndRunInstanceAsync_PreservesSchedulingMetadata()","         Assert.Equal(\"parent-instance-8\", observedOptions.SchedulingWorkflowInstanceId);","         Assert.Equal(6, observedOptions.SchedulingCallStackDepth);","     }","+","+    [Fact]","+    public async Task RunInstanceIfPendingAsync_TakesTheInstanceLockAndRunsAPendingInstance()","+    {","+        var lockProvider = SubscribeLockProviderFor(\"instance-1\");","+        var runner = Substitute.For<IWorkflowRunner>();","+","+        var client = CreatePendingGuardClient(WorkflowSubStatus.Pending, runner, lockProvider);","+","+        var response = await client.RunInstanceIfPendingAsync(new RunWorkflowInstanceRequest());","+","+        Assert.NotNull(response);","+        lockProvider.Received(1).CreateLock(\"workflow-instance:instance-1\");","+        await runner.Received(1).RunAsync(Arg.Any<WorkflowGraph>(), Arg.Any<WorkflowState>(), Arg.Any<RunWorkflowOptions>(), Arg.Any<CancellationToken>());","+    }","+","+    [Fact]","+    public async Task RunInstanceIfPendingAsync_SkipsWithoutRunningWhenTheInstanceLeftPending()","+    {","+        var lockProvider = SubscribeLockProviderFor(\"instance-1\");","+        var runner = Substitute.For<IWorkflowRunner>();","+","+        var client = CreatePendingGuardClient(WorkflowSubStatus.Suspended, runner, lockProvider);","+","+        var response = await client.RunInstanceIfPendingAsync(new RunWorkflowInstanceRequest());","+","+        Assert.Null(response);","+        // The read still happens under the instance lock, so the decision cannot race a run.","+        lockProvider.Received(1).CreateLock(\"workflow-instance:instance-1\");","+        await runner.DidNotReceive().RunAsync(Arg.Any<WorkflowGraph>(), Arg.Any<WorkflowState>(), Arg.Any<RunWorkflowOptions>(), Arg.Any<CancellationToken>());","+    }","+","+    private static IDistributedLockProvider SubscribeLockProviderFor(string instanceId)","+    {","+        var lockProvider = Substitute.For<IDistributedLockProvider>();","+        var distributedLock = Substitute.For<IDistributedLock>();","+        var lockHandle = Substitute.For<IDistributedSynchronizationHandle>();","+        lockProvider.CreateLock($\"workflow-instance:{instanceId}\").Returns(distributedLock);","+        distributedLock.AcquireAsync(Arg.Any<TimeSpan?>(), Arg.Any<CancellationToken>())","+            .Returns(ValueTask.FromResult(lockHandle));","+        return lockProvider;","+    }","+","+    private static DistributedWorkflowClient CreatePendingGuardClient(","+        WorkflowSubStatus subStatus,","+        IWorkflowRunner runner,","+        IDistributedLockProvider lockProvider)","+    {","+        var instanceManager = Substitute.For<IWorkflowInstanceManager>();","+        var definitionService = Substitute.For<IWorkflowDefinitionService>();","+","+        var workflow = new Workflow { Id = \"definition-1\", Identity = new WorkflowIdentity(\"definition-1\", 1, \"version-1\") };","+        var node = new ActivityNode(workflow, \"root\");","+        var graph = new WorkflowGraph(workflow, node, [node]);","+        var definition = new WorkflowDefinition { Id = \"version-1\", DefinitionId = \"definition-1\" };","+        definitionService.TryFindWorkflowGraphAsync(Arg.Any<WorkflowDefinitionHandle>(), Arg.Any<CancellationToken>())","+            .Returns(new WorkflowGraphFindResult(definition, graph));","+","+        var state = new WorkflowState","+        {","+            Id = \"instance-1\",","+            DefinitionId = \"definition-1\",","+            DefinitionVersionId = \"version-1\",","+            Status = WorkflowStatus.Running,","+            SubStatus = subStatus","+        };","+        var instance = new WorkflowInstance","+        {","+            Id = \"instance-1\",","+            DefinitionId = \"definition-1\",","+            DefinitionVersionId = \"version-1\",","+            Status = WorkflowStatus.Running,","+            SubStatus = subStatus,","+            WorkflowState = state","+        };","+        instanceManager.FindByIdAsync(\"instance-1\", Arg.Any<CancellationToken>()).Returns(instance);","+        runner.RunAsync(Arg.Any<WorkflowGraph>(), Arg.Any<WorkflowState>(), Arg.Any<RunWorkflowOptions>(), Arg.Any<CancellationToken>())","+            .Returns(new RunWorkflowResult(null!, state, workflow, null, Journal.Empty));","+","+        var services = new ServiceCollection()","+            .AddSingleton(instanceManager)","+            .AddSingleton(definitionService)","+            .AddSingleton(runner)","+            .AddSingleton(Substitute.For<IWorkflowCanceler>())","+            .AddSingleton(Substitute.For<IWorkflowActivationGate>())","+            .AddSingleton(Substitute.For<WorkflowStateMapper>())","+            .AddSingleton(Substitute.For<ILogger<LocalWorkflowClient>>())","+            .BuildServiceProvider();","+","+        return new DistributedWorkflowClient(","+            \"instance-1\",","+            lockProvider,","+            Substitute.For<ITransientExceptionDetector>(),","+            Microsoft.Extensions.Options.Options.Create(new DistributedLockingOptions()),","+            services,","+            Substitute.For<ILogger<DistributedWorkflowClient>>());","+    }"," }"],"additions":97,"deletions":0,"truncated":false},{"path":"core/test/unit/Elsa.Workflows.Runtime.UnitTests/Services/LocalWorkflowClientTests.cs","lines":["@@ -358,6 +358,41 @@ public async Task CreateAndRunInstanceAsync_CancelsRunner_WhenDistributedLeaseIs","         await _workflowInstanceManager.DidNotReceiveWithAnyArgs().CreateAndCommitWorkflowInstanceAsync(default!, default, default);","     }"," ","+    [Fact]","+    public async Task RunInstanceIfPendingAsync_RunsTheInstanceWhenPending()","+    {","+        var client = CreateClient();","+        var instance = CreateRunningInstance();","+        instance.SubStatus = WorkflowSubStatus.Pending;","+        _workflowInstanceManager.FindByIdAsync(\"test-workflow-instance-id\", Arg.Any<CancellationToken>()).R