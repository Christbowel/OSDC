35 @@ func NewEncoder(version string, format cyclonedx.BOMFileFormat, pretty bool) (En"," "," func (e Encoder) Encode(writer io.Writer, s sbom.SBOM) error {"," \tbom := cyclonedxhelpers.ToFormatModel(s)","+\tif e.version < cyclonedx.SpecVersion1_6 {","+\t\t// cyclonedx-go does not downgrade this 1.6+ reference type for older spec versions","+\t\t// (see https://github.com/CycloneDX/cyclonedx-go/issues/291), so drop it rather than emit an invalid document","+\t\tdropExternalReferenceType(bom.Components, cyclonedx.ERTypeSourceDistribution)","+\t}"," \tenc := cyclonedx.NewBOMEncoder(writer, e.format)"," \tenc.SetPretty(e.pretty)"," \tenc.SetEscapeHTML(false)"," "," \treturn enc.EncodeVersion(bom, e.version)"," }","+","+func dropExternalReferenceType(components *[]cyclonedx.Component, refType cyclonedx.ExternalReferenceType) {","+\tif components == nil {","+\t\treturn","+\t}","+\tfor i := range *components {","+\t\tc := &(*components)[i]","+\t\tdropExternalReferenceType(c.Components, refType)","+\t\tif c.ExternalReferences == nil {","+\t\t\tcontinue","+\t\t}","+\t\trefs := slices.DeleteFunc(*c.ExternalReferences, func(r cyclonedx.ExternalReference) bool {","+\t\t\treturn r.Type == refType","+\t\t})","+\t\tif len(refs) == 0 {","+\t\t\tc.ExternalReferences = nil","+\t\t\tcontinue","+\t\t}","+\t\tc.ExternalReferences = &refs","+\t}","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"syft/format/internal/cyclonedxutil/helpers/component.go","lines":["@@ -47,14 +47,6 @@ func EncodeComponent(p pkg.Package, supplier string, locationSorter func(a, b fi"," \t\tcomponentType = cyclonedx.ComponentTypeMachineLearningModel"," \t}"," ","-\texternalRefs := encodeExternalReferences(p)","-\tif srcRef := encodeSourcePackageExternalReference(p); srcRef != nil {","-\t\tif externalRefs == nil {","-\t\t\texternalRefs = &[]cyclonedx.ExternalReference{}","-\t\t}","-\t\t*externalRefs = append(*externalRefs, *srcRef)","-\t}","-"," \treturn cyclonedx.Component{"," \t\tType:               componentType,"," \t\tName:               p.Name,","@@ -67,7 +59,7 @@ func EncodeComponent(p pkg.Package, supplier string, locationSorter func(a, b fi"," \t\tAuthor:             encodeAuthor(p),"," \t\tPublisher:          encodePublisher(p),"," \t\tDescription:        encodeDescription(p),","-\t\tExternalReferences: externalRefs,","+\t\tExternalReferences: encodeExternalReferences(p),"," \t\tProperties:         properties,"," \t\tBOMRef:             DeriveBomRef(p),"," \t}"],"additions":1,"deletions":9,"truncated":false},{"path":"syft/format/internal/cyclonedxutil/helpers/external_references.go","lines":["@@ -80,42 +80,68 @@ func encodeExternalReferences(p pkg.Package) *[]cyclonedx.ExternalReference {"," \t\t\t}"," \t\t}"," \t}","-","+\tif srcRef := encodeSourcePackageExternalReference(p); srcRef != nil {","+\t\trefs = append(refs, *srcRef)","+\t}"," \tif len(refs) > 0 {"," \t\treturn &refs"," \t}"," \treturn nil"," }"," ","+// encodeSourcePackageExternalReference returns a \"source-distribution\" reference holding the PURL of the distro","+// source package that a binary OS package was built from (e.g. libpam-runtime -> pkg:deb/debian/pam@...?arch=source).","+// It is only emitted when the source differs from the binary package (by name or version) and when the package PURL","+// is of the type implied by the metadata. The main consumer is vulnerability matching, since distros tend to report","+// vulnerabilities against the source package rather than each binary package built from it.","+//","+// why an external reference and not pedigree: `component.pedigree.ancestors` looks like the obvious spot for \"this","+// binary came from that source\", but pedigree describes code lineage (forks, patched variants, and the patches that","+// separate them). A binary built unmodified from its own distro source package is the same code in a different form,","+// not a fork, and CycloneDX components are deliberately agnostic to source vs binary form (see the comments from the","+// CycloneDX maintainers in https://github.com/CycloneDX/specification/issues/612#issuecomment-2958800363). The","+// ancestor slot is better left for the upstream project a distro patched (e.g. Linux-PAM for Debian's pam), which","+// syft does not know today.","+//","+// why \"source-distribution\": the spec defines it as \"the location where the source code distributable can be","+// obtained\", and a deb/rpm source package is exactly that distributable (a .dsc and tarballs in the Debian source","+// pool, a .src.rpm in an SRPMS repo). The value is a PURL (an identifier) rather than a download URL, which the","+// schema allows since external reference URLs are URIs of any scheme, and a CycloneDX maintainer confirmed this exact","+// shape is valid in https://github.com/CycloneDX/specification/issues/612#issuecomment-5428057874. A first-class","+// \"source\" component type was discussed in that issue and deferred to CycloneDX 2.0."," func encodeSourcePackageExternalReference(p pkg.Package) *cyclonedx.ExternalReference {","-\tname, version, arch := sourceCoordinates(p)","-\tif name == \"\" || version == \"\" {","+\tif p.PURL == \"\" {"," \t\treturn nil"," \t}","-\tif p.PURL == \"\" {","+\tsrc := sourcePackageOf(p)","+\tif src == nil {"," \t\treturn nil"," \t}"," ","-\tpkgPurl, err := packageurl.FromString(p.PURL)","-\tif err != nil {","+\t// the binary PURL is only consulted for the namespace and a small set of qualifiers (e.g. distro), everything","+\t// else describes the binary package and must not be restated as a fact about the source package.","+\tbinPurl, err := packageurl.FromString(p.PURL)","+\tif err != nil || binPurl.Type != src.purlType {"," \t\treturn nil"," \t}"," ","-\tqualifiers := pkgPurl.Qualifiers.Map()","-\tdelete(qualifiers, pkg.PURLQualifierUpstream)","-\tdelete(qualifiers, pkg.PURLQualifierArch)","-","-\tif arch != \"\" {","-\t\tqualifiers[pkg.PURLQualifierArch] = arch","+\tqualifiers := map[string]string{}","+\tfor _, q := range binPurl.Qualifiers {","+\t\tif src.keepQualifier(q.Key) {","+\t\t\tqualifiers[q.Key] = q.Value","+\t\t}","+\t}","+\tif src.arch != \"\" {","+\t\tqualifiers[pkg.PURLQualifierArch] = src.arch"," \t}"," "," \tsrcPurl := packageurl.NewPackageURL(","-\t\tpkgPurl.Type,","-\t\tpkgPurl.Namespace,","-\t\tname,","-\t\tversion,","+\t\tsrc.purlType,","+\t\tbinPurl.Namespace,","+\t\tsrc.name,","+\t\tsrc.version,"," \t\tpackageurl.QualifiersFromMap(qualifiers),","-\t\tpkgPurl.Subpath,","+\t\t\"\","," \t)"," "," \treturn &cyclonedx.ExternalReference{","@@ -124,51 +150,90 @@ func encodeSourcePackageExternalReference(p pkg.Package) *cyclonedx.ExternalRefe"," \t}"," }"," ","-func sourceCoordinates(p pkg.Package) (name, version, arch string) {","-\tswitch metadata := p.Metadata.(type) {","-\tcase pkg.ApkDBEntry:","-\t\tif metadata.OriginPackage != \"\" && metadata.OriginPackage != metadata.Package {","-\t\t\treturn metadata.OriginPackage, metadata.Version, \"\"","-\t\t}","+// sourcePackage is the identity of the source package a binary OS package was built from.","+type sourcePackage struct {","+\tpurlType string","+\tname     string","+\tversion  string","+\t// arch is the ecosystem's source architecture marker (\"source\" for deb, \"src\" or \"nosrc\" for rpm)","+\tarch string","+}","+","+func (s sourcePackage) keepQualifier(key string) bool {","+\tswitch key {","+\tcase pkg.PURLQualifierDistro:","+\t\treturn true","+\tcase pkg.PURLQualifierEpoch, pkg.PURLQualifierRpmModularity:","+\t\treturn s.purlType == pkg.RpmPkg.PackageURLType()","+\t}","+\treturn false","+}","+","+// sourcePackageOf returns the source package for p, or nil when there is none or it is the same as the binary.","+//","+// only deb and rpm are supported, since those are the ecosystems that publish real source packages with their own","+// PURL identity (arch=source / arch=src). apk (origin) and alpm (pkgbase) are intentionally left out: there the","+// \"source\" is a build recipe rather than a published source distributable, and its name is usually also the name of","+// a real binary package (e.g. pkg:apk/alpine/libc-dev@0.7.2-r3 is an installable package, not a source archive), so","+// a \"source-distribution\" reference would point at a binary package. Whether those ecosystems have a meaningful","+// source PURL is still an open question, and until then the `upstream` PURL qualifier continues to carry that info.","+func sourcePackageOf(p pkg.Package) *sourcePackage {","+\tvar src sourcePackage","+\tvar binName, binVersion string","+\tswitch m := p.Metadata.(type) {"," \tcase pkg.DpkgDBEntry:","-\t\treturn dpkgSourceCoordinates(metadata)","+\t\tsrc = dpkgSourcePackage(m)","+\t\tbinName, binVersion = m.Package, m.Version"," \tcase pkg.DpkgArchiveEntry:","-\t\treturn dpkgSourceCoordinates(pkg.DpkgDBEntry(metadata))","+\t\tsrc = dpkgSourcePackage(pkg.DpkgDBEntry(m))","+\t\tbinName, binVersion = m.Package, m.Version"," \tcase pkg.RpmDBEntry:","-\t\treturn rpmSourceCoordinates(metadata.SourceRpm)","+\t\tsrc = rpmSourcePackage(m.SourceRpm)","+\t\tbinName, binVersion = m.Name, m.Version+\"-\"+m.Release"," \tcase pkg.RpmArchive:","-\t\treturn rpmSourceCoordinates(metadata.SourceRpm)","-\tcase pkg.AlpmDBEntry:","-\t\tif metadata.BasePackage != \"\" {","-\t\t\treturn metadata.BasePackage, metadata.Version, \"\"","-\t\t}","+\t\tsrc = rpmSourcePackage(m.SourceRpm)","+\t\tbinName, binVersion = m.Name, m.Version+\"-\"+m.Release","+\tdefault:","+\t\treturn nil","+\t}","+\tif src.name == \"\" || src.version == \"\" {","+\t\treturn nil","+\t}","+\tif src.name == binName && src.version == binVersion {","+\t\treturn nil"," \t}","-\treturn \"\", \"\", \"\"","+\treturn &src"," }"," ","-func dpkgSourceCoordinates(entry pkg.DpkgDBEntry) (name, version, arch string) {","-\tif entry.Source == \"\" {","-\t\treturn \"\", \"\", \"\"","+func dpkgSourcePackage(entry pkg.DpkgDBEntry) sourcePackage {","+\tversion := entry.SourceVersion","+\tif version == \"\" {","+\t\tversion = entry.Version"," \t}","-\tif entry.SourceVersion != \"\" {","-\t\treturn entry.Source, entry.SourceVersion, \"source\"","-\t}","-\treturn entry.Source, entry.Version, \"source\"","+\treturn sourcePackage{purlType: pkg.DebPkg.PackageURLType(), name: entry.Source, version: version, arch: \"source\"}"," }"," ","-func rpmSourceCoordinates(sourceRpm string) (name, version, arch string) {","-\t// <name>-<version>-<release>.src.rpm","-\tsourceRpm = strings.TrimSuffix(sourceRpm, \".rpm\")","-\tsourceRpm = strings.TrimSuffix(strings.TrimSuffix(sourceRpm, \".src\"), \".nosrc\")","-\trelease := strings.LastIndex(sourceRpm, \"-\")","+// rpmSourcePackage parses a source RPM filename of the form <name>-<version>-<release>.(no)src.rpm.","+func rpmSourcePackage(sourceRpm string) sourcePackage {","+\tvar arch string","+\tswitch {","+\tcase strings.HasSuffix(sourceRpm, \".src.rpm\"):","+\t\tarch = \"src\"","+\tcase strings.HasSuffix(sourceRpm, \".nosrc.rpm\"):","+\t\tarch = \"nosrc\"","+\tdefault:","+\t\treturn sourcePackage{}","+\t}","+\tnvr := strings.TrimSuffix(sourceRpm, \".\"+arch+\".rpm\")","+\trelease := strings.LastIndex(nvr, \"-\")"," \tif release < 0 {","-\t\treturn \"\", \"\", \"\"","+\t\treturn sourcePackage{}"," \t}","-\tver := strings.LastIndex(sourceRpm[:release], \"-\")","+\tver := strings.LastIndex(nvr[:release], \"-\")"," \tif ver < 0 {","-\t\treturn \"\", \"\", \"\"","+\t\treturn sourcePackage{}"," \t}","-\treturn sourceRpm[:ver], sourceRpm[ver+1:], \"src\"","+\treturn sourcePackage{purlType: pkg.RpmPkg.PackageURLType(), name: nvr[:ver], version: nvr[ver+1:], arch: arch}"," }"," "," // supported algorithm in cycloneDX as of 1.4"],"additions":113,"deletions":48,"truncated":false},{"path":"syft/format/internal/cyclonedxutil/helpers/external_references_test.go","lines":["@@ -159,20 +159,20 @@ func Test_encodeSourcePackage(t *testing.T) {"," \t\t{"," \t\t\tname: \"no PURL\","," \t\t\tinput: pkg.Package{","-\t\t\t\tName:    \"some-package\",","-\t\t\t\tVersion: \"1.0.0-r1\",","-\t\t\t\tType:    p