{"id":"fd45cd484077c2cd61a402a27ec600455f7d2109","axis":"silent","repo":"envoyproxy/envoy","sha":"fd45cd484077c2cd61a402a27ec600455f7d2109","parsed":{"files":[{"path":"changelogs/current/bug_fixes/jwt_authn__remove-query-param-in-place.rst","lines":["@@ -0,0 +1,5 @@","+Fixed the JWT filter rewriting the whole query string when ``forward: false`` removes a token","+carried in a query parameter. Envoy decoded every other parameter, sorted them and appended ``=``","+to parameters without a value. Now only the token parameter is removed and the rest of the query","+string is left as sent. This behavior can be reverted by setting the runtime guard","+``envoy.reloadable_features.jwt_authn_remove_query_param_in_place`` to ``false``."],"additions":5,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -153,6 +153,7 @@ RUNTIME_GUARD(envoy_reloadable_features_ja4_alpn_hex_conversion_fix);"," RUNTIME_GUARD(envoy_reloadable_features_ja4_filter_grease_signature_algorithms);"," RUNTIME_GUARD(envoy_reloadable_features_json_formatter_omit_empty_values);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_add_verification_status_header);","+RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_remove_query_param_in_place);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_sanitize_payload_headers_filter_wide);"," RUNTIME_GUARD(envoy_reloadable_features_jwt_authn_select_key_by_x5t);"," // A SotW LDS update removes only the listeners received through LDS, so it no longer removes the"],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/jwt_authn/BUILD","lines":["@@ -17,7 +17,9 @@ envoy_cc_library(","         \"//envoy/runtime:runtime_interface\",","         \"//source/common/http:header_utility_lib\",","         \"//source/common/http:utility_lib\",","+        \"//source/common/runtime:runtime_features_lib\",","         \"@abseil-cpp//absl/container:btree\",","+        \"@abseil-cpp//absl/strings\",","         \"@envoy_api//envoy/extensions/filters/http/jwt_authn/v3:pkg_cc_proto\",","     ],"," )"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/jwt_authn/authenticator.cc","lines":["@@ -419,8 +419,7 @@ void AuthenticatorImpl::handleGoodJwt(bool cache_hit) {","   }"," ","   if (!provider.forward()) {","-    // TODO(potatop) remove JWT from queries.","-    // Remove JWT from headers.","+    // Remove the JWT from the header or query parameter it was extracted from.","     curr_token_->removeJwt(*headers_);","   }"," "],"additions":1,"deletions":2,"truncated":false},{"path":"source/extensions/filters/http/jwt_authn/extractor.cc","lines":["@@ -13,6 +13,8 @@"," "," #include \"absl/container/btree_map.h\""," #include \"absl/strings/match.h\"","+#include \"absl/strings/str_cat.h\"","+#include \"absl/strings/str_split.h\""," "," using envoy::extensions::filters::http::jwt_authn::v3::JwtProvider;"," using Envoy::Http::LowerCaseString;","@@ -112,13 +114,41 @@ class JwtParamLocation : public JwtLocationBase {","     if (path_entry == nullptr) {","       return;","     }","-    Http::Utility::QueryParamsMulti query_params =","-        Http::Utility::QueryParamsMulti::parseAndDecodeQueryString(","-            path_entry->value().getStringView());","+    if (!Runtime::runtimeFeatureEnabled(","+            \"envoy.reloadable_features.jwt_authn_remove_query_param_in_place\")) {","+      Http::Utility::QueryParamsMulti query_params =","+          Http::Utility::QueryParamsMulti::parseAndDecodeQueryString(","+              path_entry->value().getStringView());","+      query_params.remove(param_);","+      headers.setPath(query_params.replaceQueryString(path_entry->value()));","+      return;","+    }"," ","-    query_params.remove(param_);","+    const absl::string_view path = path_entry->value().getStringView();","+    const size_t query_start = path.find('?');","+    if (query_start == absl::string_view::npos) {","+      return;","+    }"," ","-    const auto updated_path = query_params.replaceQueryString(path_entry->value());","+    // Drop only the token parameter and keep the rest of the query string as sent: same order,","+    // same encoding, and no \"=\" added to valueless parameters.","+    std::string updated_path(path.substr(0, query_start + 1));","+    bool first = true;","+    for (absl::string_view param : absl::StrSplit(path.substr(query_start + 1), '&')) {","+      const absl::string_view name = param.substr(0, param.find('='));","+      if (Http::Utility::PercentEncoding::decode(name) == param_) {","+        continue;","+      }","+      if (!first) {","+        updated_path.push_back('&');","+      }","+      absl::StrAppend(&updated_path, param);","+      first = false;","+    }","+    if (updated_path.size() == query_start + 1) {","+      // Nothing is left of the query, so drop the \"?\".","+      updated_path.pop_back();","+    }","     headers.setPath(updated_path);","   }"," "],"additions":35,"deletions":5,"truncated":false},{"path":"test/extensions/filters/http/jwt_authn/extractor_test.cc","lines":["@@ -211,6 +211,91 @@ TEST_F(ExtractorTest, TestDefaultParamLocation) {","   EXPECT_EQ(query_params.getFirstValue(\"access_token\").has_value(), false);"," }"," ","+// Removing the token leaves the rest of the query string untouched: original order, original","+// percent-encoding, and valueless parameters stay valueless. With the runtime guard off, the old","+// code decodes the query, sorts it by name and writes it back without encoding it again, which","+// changes the meaning of percent-encoded values.","+TEST_F(ExtractorTest, TestRemoveParamTokenKeepsOtherParams) {","+  struct TestCase {","+    std::string path;","+    std::string in_place;","+    std::string legacy;","+  };","+  const std::vector<TestCase> test_cases = {","+      {\"/p?z=1&access_token=T&a=2\", \"/p?z=1&a=2\", \"/p?a=2&z=1\"},","+      {\"/p?b=1&a=x&b=2&access_token=T\", \"/p?b=1&a=x&b=2\", \"/p?a=x&b=1&b=2\"},","+      {\"/p?flag&access_token=T\", \"/p?flag\", \"/p?flag=\"},","+      {\"/p?q=a%26b%3Dc&access_token=T\", \"/p?q=a%26b%3Dc\", \"/p?q=a&b=c\"},","+      {\"/p?next=%2Fhome%23top&access_token=T\", \"/p?next=%2Fhome%23top\", \"/p?next=/home#top\"},","+      {\"/p?sum=1%2B1&access_token=T\", \"/p?sum=1%2B1\", \"/p?sum=1+1\"},","+      {\"/p?name=John%20Doe&access_token=T\", \"/p?name=John%20Doe\", \"/p?name=John Doe\"},","+      {\"/p?v=%2525&access_token=T\", \"/p?v=%2525\", \"/p?v=%25\"},","+      {\"/p?&a=1&access_token=T\", \"/p?&a=1\", \"/p?=&a=1\"},","+  };","+","+  for (const bool in_place : {true, false}) {","+    TestScopedRuntime scoped_runtime;","+    scoped_runtime.mergeValues({{\"envoy.reloadable_features.jwt_authn_remove_query_param_in_place\",","+                                 in_place ? \"true\" : \"false\"}});","+    for (const auto& test_case : test_cases) {","+      SCOPED_TRACE(absl::StrCat(test_case.path, in_place ? \" (in place)\" : \" (legacy)\"));","+      auto headers = TestRequestHeaderMapImpl{{\":path\", test_case.path}};","+      auto tokens = extractor_->extract(headers);","+      ASSERT_EQ(tokens.size(), 1);","+      EXPECT_EQ(tokens[0]->token(), \"T\");","+","+      tokens[0]->removeJwt(headers);","+      EXPECT_EQ(headers.getPathValue(), in_place ? test_case.in_place : test_case.legacy);","+    }","+  }","+}","+","+// The extractor matches percent-encoded parameter names, so removal must match them too. Every","+// occurrence of the parameter is removed, and the \"?\" is dropped when nothing is left.","+TEST_F(ExtractorTest, TestRemoveParamTokenEncodedNameAndDuplicates) {","+  auto headers =","+      TestRequestHeaderMapImpl{{\":path\", \"/path?access%5Ftoken=jwt_token&access_token=other\"}};","+  auto tokens = extractor_->extract(headers);","+  ASSERT_EQ(tokens.size(), 1);","+  EXPECT_EQ(tokens[0]->token(), \"jwt_token\");","+","+  tokens[0]->removeJwt(headers);","+  EXPECT_EQ(headers.getPathValue(), \"/path\");","+}","+","+// Each token parameter goes together with one \"&\" next to it, so no stray \"?\" or \"&\" is left","+// where the token was, and empty segments elsewhere in the query are kept as sent.","+TEST_F(ExtractorTest, TestRemoveParamTokenEmptySegments) {","+  const std::vector<std::pair<std::string, std::string>> test_cases = {","+      {\"/path?access_token=T&\", \"/path\"},","+      {\"/path?&access_token=T\", \"/path\"},","+      {\"/path?a=1&&access_token=T&b\", \"/path?a=1&&b\"},","+      {\"/path?a=1&&b=2&access_token=T\", \"/path?a=1&&b=2\"},","+      {\"/path?access_token=T&&\", \"/path?&\"},","+  };","+  for (const auto& [path, expected] : test_cases) {","+    SCOPED_TRACE(path);","+    auto headers = TestRequestHeaderMapImpl{{\":path\", path}};","+    auto tokens = extractor_->extract(headers);","+    ASSERT_EQ(tokens.size(), 1);","+","+    tokens[0]->removeJwt(headers);","+    EXPECT_EQ(headers.getPathValue(), expected);","+  }","+}","+","+// If the query string is gone by the time removeJwt runs (e.g. a filter rewrote the path),","+// the path is left as it is.","+TEST_F(ExtractorTest, TestRemoveParamTokenPathWithoutQuery) {","+  auto headers = TestRequestHeaderMapImpl{{\":path\", \"/path?access_token=jwt_token\"}};","+  auto tokens = extractor_->extract(headers);","+  ASSERT_EQ(tokens.size(), 1);","+","+  headers.setPath(\"/other\");","+  tokens[0]->removeJwt(headers);","+  EXPECT_EQ(headers.getPathValue(), \"/other\");","+}","+"," // Test extracting token from the custom header: \"token-header\""," TEST_F(ExtractorTest, TestCustomHeaderToken) {","   auto headers = TestRequestHeaderMapImpl{{\"token-header\", \"jwt_token\"}};",""],"additions":85,"deletions":0,"truncated":false}],"additions":129,"deletions":7,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-25T18:25:03.133534+00:00"}