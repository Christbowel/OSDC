se lsp_types::{PositionEncodingKind, TextEdit, Uri};"," use ruff_db::system::{SystemPathBuf, SystemVirtualPath, SystemVirtualPathBuf};","+use ty_ide::RangedValue;"," ","+use crate::Db;"," use crate::system::AnySystemPath;"," pub(crate) use location::ToLink;"," pub use notebook::NotebookDocument;","@@ -18,6 +22,30 @@ pub(crate) use range::{"," pub use text_document::TextDocument;"," pub(crate) use text_document::{DocumentVersion, LanguageId};"," ","+/// Appends replacements grouped by document URI, skipping edits without an LSP location.","+pub(crate) fn extend_lsp_edits<T: Into<String>>(","+    db: &dyn Db,","+    encoding: PositionEncoding,","+    edits: impl IntoIterator<Item = RangedValue<T>>,","+    changes: &mut HashMap<Uri, Vec<TextEdit>>,","+) {","+    for edit in edits {","+        if let Some(range) = edit.range.to_lsp_range(db, encoding)","+            && let Some(location) = range.into_location()","+        {","+            changes","+                .entry(location.uri)","+                .or_default()","+                .push(TextEdit::new(location.range, edit.value.into()));","+        } else {","+            tracing::debug!(","+                path = %edit.range.file().path(db),","+                \"Skipping edit because its LSP location could not be resolved\"","+            );","+        }","+    }","+}","+"," /// A convenient enumeration for supported text encodings. Can be converted to [`lsp_types::PositionEncodingKind`]."," // Please maintain the order from least to greatest priority for the derived `Ord` impl."," #[derive(Default, Debug, Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]"],"additions":29,"deletions":1,"truncated":false},{"path":"crates/ty_server/src/server/api.rs","lines":["@@ -115,6 +115,9 @@ pub(super) fn request(req: server::Request) -> Task {","         >(","             req, BackgroundSchedule::Worker","         ),","+        requests::WillRenameFilesHandler::METHOD => background_request_task::<","+            requests::WillRenameFilesHandler,","+        >(req, BackgroundSchedule::Worker),","         requests::PrepareTypeHierarchyRequestHandler::METHOD => background_document_request_task::<","             requests::PrepareTypeHierarchyRequestHandler,","         >(","@@ -258,7 +261,7 @@ where","     <<R as RequestHandler>::RequestType as Request>::Params: UnwindSafe,"," {","     let retry = R::RETRY_ON_CANCELLATION.then(|| req.clone());","-    let (id, params) = cast_request::<R>(req)?;","+    let (id, mut params) = cast_request::<R>(req)?;"," ","     Ok(Task::background(schedule, move |session: &Session| {","         let cancellation_token = session","@@ -267,6 +270,8 @@ where","             .cancellation_token(&id)","             .expect(\"request should have been tested for cancellation before scheduling\");"," ","+        R::prepare_params(session, &mut params);","+","         // SAFETY: The `snapshot` is safe to move across the unwind boundary because it is not used","         // after unwinding.","         let snapshot = AssertUnwindSafe(session.snapshot_session());"],"additions":6,"deletions":1,"truncated":false},{"path":"crates/ty_server/src/server/api/requests.rs","lines":["@@ -39,6 +39,7 @@ mod shutdown;"," mod signature_help;"," mod type_hierarchy_subtypes;"," mod type_hierarchy_supertypes;","+mod will_rename_files;"," mod workspace_diagnostic;"," mod workspace_symbols;"," ","@@ -69,5 +70,6 @@ pub(super) use shutdown::ShutdownHandler;"," pub(super) use signature_help::SignatureHelpRequestHandler;"," pub(super) use type_hierarchy_subtypes::TypeHierarchySubtypesRequestHandler;"," pub(super) use type_hierarchy_supertypes::TypeHierarchySupertypesRequestHandler;","+pub(super) use will_rename_files::WillRenameFilesHandler;"," pub(super) use workspace_diagnostic::WorkspaceDiagnosticRequestHandler;"," pub(super) use workspace_symbols::WorkspaceSymbolRequestHandler;"],"additions":2,"deletions":0,"truncated":false},{"path":"crates/ty_server/src/server/api/requests/rename.rs","lines":["@@ -2,11 +2,11 @@ use std::borrow::Cow;"," use std::collections::HashMap;"," "," use lsp_types::RenameRequest;","-use lsp_types::{RenameParams, TextEdit, Uri, WorkspaceEdit};","-use ty_ide::rename;","+use lsp_types::{RenameParams, Uri, WorkspaceEdit};","+use ty_ide::{RangedValue, rename};"," use ty_project::{ProjectDatabase, SemanticDb as _};"," ","-use crate::document::{PositionExt, ToLink};","+use crate::document::{PositionExt, extend_lsp_edits};"," use crate::server::api::traits::{","     BackgroundDocumentRequestHandler, RequestHandler, RetriableRequestHandler,"," };","@@ -55,19 +55,12 @@ impl BackgroundDocumentRequestHandler for RenameRequestHandler {","             return Ok(None);","         };"," ","-        // Group text edits by file","-        let mut changes: HashMap<Uri, Vec<TextEdit>> = HashMap::new();","-","-        for reference in rename_results {","-            if let Some(location) = reference.to_location(db, snapshot.encoding()) {","-                let edit = TextEdit {","-                    range: location.range,","-                    new_text: params.new_name.clone(),","-                };","-","-                changes.entry(location.uri).or_default().push(edit);","-            }","-        }","+        let edits = rename_results.into_iter().map(|reference| RangedValue {","+            range: reference.file_range(),","+            value: params.new_name.as_str(),","+        });","+        let mut changes = HashMap::new();","+        extend_lsp_edits(db, snapshot.encoding(), edits, &mut changes);"," ","         if changes.is_empty() {","             return Ok(None);"],"additions":9,"deletions":16,"truncated":false},{"path":"crates/ty_server/src/server/api/requests/will_rename_files.rs","lines":["@@ -0,0 +1,101 @@","+use std::collections::HashMap;","+","+use lsp_types::{","+    FileRename as LspFileRename, RenameFilesParams, TextEdit, Uri, WillRenameFilesRequest,","+    WorkspaceEdit,","+};","+use ruff_db::files::system_path_to_file;","+use ruff_db::system::SystemPathBuf;","+use ty_ide::{FileRename, will_rename_files};","+use ty_project::ProjectDatabase;","+","+use crate::document::extend_lsp_edits;","+use crate::server::api::traits::{","+    BackgroundRequestHandler, RequestHandler, RetriableRequestHandler,","+};","+use crate::session::client::Client;","+use crate::session::{Session, SessionSnapshot};","+","+/// Handles `workspace/willRenameFiles` for Python module files.","+pub(crate) struct WillRenameFilesHandler;","+","+impl RequestHandler for WillRenameFilesHandler {","+    type RequestType = WillRenameFilesRequest;","+}","+","+impl BackgroundRequestHandler for WillRenameFilesHandler {","+    fn prepare_params(session: &Session, params: &mut RenameFilesParams) {","+        params.files.retain(|rename| {","+            let Some(old_path) = file_uri_to_path(&rename.old_uri) else {","+                return false;","+            };","+","+            session.allows_file_rename_edits(&old_path)","+        });","+    }","+","+    fn run(","+        snapshot: &SessionSnapshot,","+        _client: &Client,","+        params: RenameFilesParams,","+    ) -> crate::server::Result<Option<WorkspaceEdit>> {","+        let mut changes = HashMap::new();","+","+        for db in snapshot.projects() {","+            let renames: Vec<_> = params","+                .files","+                .iter()","+                .filter_map(|rename| prepare_rename(db, rename))","+                .collect();","+            if renames.is_empty() {","+                continue;","+            }","+","+            let result = will_rename_files(db, &renames);","+            extend_lsp_edits(db, snapshot.position_encoding(), result, &mut changes);","+        }","+","+        // Different projects can propose conflicting edits for the same file, so normalize only","+        // after collecting every project's results.","+        normalize_lsp_edits(&mut changes);","+","+        Ok((!changes.is_empty()).then(|| WorkspaceEdit::new(Some(changes), None, None)))","+    }","+}","+","+impl RetriableRequestHandler for WillRenameFilesHandler {","+    const RETRY_ON_CANCELLATION: bool = true;","+}","+","+/// Converts an LSP rename request into our internal representation of the same.","+fn prepare_rename(db: &ProjectDatabase, rename: &LspFileRename) -> Option<FileRename> {","+    let old_path = file_uri_to_path(&rename.old_uri)?;","+    let new_path = file_uri_to_path(&rename.new_uri)?;","+    let file = system_path_to_file(db, &old_path).ok()?;","+    Some(FileRename { file, new_path })","+}","+","+/// Deduplicates edits and drops files with overlapping edits.","+fn normalize_lsp_edits(changes: &mut HashMap<Uri, Vec<TextEdit>>) {","+    changes.retain(|_, edits| {","+        edits.sort_unstable_by(|left, right| {","+            left.range","+                .cmp(&right.range)","+                .then_with(|| left.new_text.cmp(&right.new_text))","+        });","+        edits.dedup();","+","+        !edits.is_empty()","+            && !edits","+                .windows(2)","+                .any(|pair| pair[1].range.start < pair[0].range.end)","+    });","+}","+","+fn file_uri_to_path(uri: &Uri) -> Option<SystemPathBuf> {","+    if uri.scheme() == \"file\" {","+        SystemPathBuf::from_path_buf(uri.to_file_path().ok()?).ok()","+    } else {","+        None","+    }","+}"],"additions":101,"deletions":0,"truncated":false},{"path":"crates/ty_server/src/server/api/traits.rs","lines":["@@ -131,6 +131,13 @@ pub(super) trait BackgroundDocumentRequestHandler: RetriableRequestHandler {"," /// operations that require access to the entire session state, such as fetching workspace"," /// diagnostics."," pub(super) trait BackgroundRequestHandler: RetriableRequestHandler {","+    /// Prepares request parameters using the live session before taking a snapshot.","+    fn prepare_params(","+        _session: &Session,","+        _params: &mut <<Self as RequestHandler>::RequestType as Request>::Params,","+    ) {","+    }","+","     /// Processes the request parameters and returns the LSP request result.","     ///","     /// This is the main method that handlers implement. It takes the request parameters"],"additions":7,"deletions":0,"truncated":false},{"path":"crates/ty_server/src/session.rs","lines":["@@ -1238,6 +1238,19 @@ impl Session {","         })","     }"," ","+    /// Returns whether client settings permit import updates for a rename of `path`.","+    pub(crate) fn allows_file_rename_edits(&self, path: &SystemPath) -> bool {","+        match self.workspaces.for_path(path) {","+            Some(workspace) => !workspace.settings().is_language_services_disabled(),","+            None => !self","+                .initialization_options","+                .options","+                .workspace","+                .disable_language_services","+                .unwrap_or_default(),","+        }","+    }","+","     /// Selects an open document or a supported closed document for a request.","     fn document_target(&self, uri: &Uri) -> Result<DocumentRequestTarget, DocumentError> {","         match self.index().open_document_handle(uri) {"],"additions":13,"deletions":0,"truncated":false},{"path":"crates/ty_server/tests/e2e/main.rs","lines":["@@ -49,6 +49,7 @@ mod script_preparation;"," mod semantic_tokens;"," mod signature_help;"," mod type_hierarchy;","+mod will_rename_files;"," mod workspace_folders;"," "," use std::collections::{BTreeMap, HashMap, VecDeque};","@@ -86,6 +87,7 @@ use lsp_types::{","     WorkspaceDiagnosticParams, WorkspaceDiagnosticReport, WorkspaceDiagnosticRequest,","     WorkspaceEdit, WorkspaceFolder, WorkspaceFoldersChangeEvent, WorkspaceFoldersInitializeParams,"," };","+use lsp_types::{FileRename, WillRenameFilesRequest};"," #[cfg(feature = \"test-uv\")]"," use ruff_db::system::System as _;"," use ruff_db::system::{OsSystem, SystemPath, SystemPathBuf, SystemVirtualPath, TestSystem};","@@ -1025,6 +1027,10 @@ impl TestServer {","         )","     }"," ","+    pub(crate) fn will_rename_files(&mut self, files: Vec<FileRename>) -> Option<WorkspaceEdit> {","+        self.send_request_await::<WillRenameFilesRequest>(lsp_types::RenameFilesParams { files })","+    }","+","     /// Send a `textDocument/diagnostic` request for the document at the given path.","     pub(crate) fn document_diagnostic_request(","         &mut self,"],"additions":6,"deletions":0,"truncated":false},{"path":"crates/ty_server/tests/e2e/snapshots/e2e__initialize__initialization.snap","lines":["@@ -109,6 +109,19 @@ expression: initialization_result","       \"workspaceFolders\": {","         \"supported\": true,","         \"changeNotifications\": true","+      },","+      \"fileOperations\": {","+        \"willRename\": {","+          \"filters\": [","+            {","+              \"scheme\": \"file\",","+              \"pattern\": {","+                \"glob\": \"**/*.{py,pyi}\",","+                \"matches\": \"file\"","+              }","+            }","+          ]","+        }","       }","     }","   },"],"additions":13,"deletions":0,"truncated":false},{"path":"crates/ty_server/tests/e2e/snapshots/e2e__initialize__initialization_with_workspace.snap","lines":["@@ -109,6 +109,19 @@ expression: initialization_result","       \"workspaceFolders\": {","         \"supported\": true,","         \"changeNotifications\": true","+      },","+      \"fileOperations\": {","+        \"willRename\": {","+          \"filters\": [","+            {","+              \"scheme\": \"file\",","+              \"pattern\": {","+                \"glob\": \"**/*.{py,pyi}\",","+                \"matches\": \"file\"","+              }","+            }","+          ]","+        }","       }","     }","   },"],"additions":13,"deletions":0,"truncated":false},{"path":"crates/ty_server/tests/e2e/will_rename_files.rs","lines":["@@ -0,0 +1,289 @@","+use lsp_types::{FileRename, Position, Range, TextEdit, Uri, WorkspaceEdit};","+use ruff_db::system::SystemPath;","+use ty_server::ClientOptions;","+","+use crate::notebook::NotebookBuilder;","+use crate::{TestServer, TestServerBuilder};","+","+#[test]","+fn batch_updates_only_indexed_sources() -> anyhow::Result<()> {","+    let mut server = TestServerBuilder::new()?","+        .with_files([","+            (\"old.py\", \"\"),","+            (\"other.py\", \"\"),","+            // This consumer stays closed, so it must be found through the project index.","+            (","+                \"consumer.py\",","+                \"import old, other","+old\",","+            ),","+        ])?","+        .build()","+        .wait_until_workspaces_are_initialized();","+","+    // An open virtual notebook is absent from the project index.","+    let mut notebook = NotebookBuilder::virtual_file(\"consumer.ipynb\");","+    notebook.add_python_cell(\"import other\");","+    notebook.open(&mut server);","+    // Consume the cell's diagnostics so the test server has no unclaimed notifications at teardown.","+    server.collect_publish_diagnostic_notifications(1);","+","+    // One batch updates the indexed file but not the open notebook cell.","+    let edit = rename_edit(","+        &mut server,","+        &[(\"old.py\", \"new.py\"), (\"other.py\", \"renamed.py\")],","+    );","+","+    assert_edits(","+        edit.as_ref(),","+        &[(","+            server.file_uri(\"consumer.py\"),","+            &[","+                ExpectedEdit {","+                    line: 0,","+                    columns: 7..10,","+                    new_text: \"new\",","+                },","+                ExpectedEdit {","+                    line: 0,","+                    columns: 12..17,","+                    new_text: \"renamed\",","+                },","+                ExpectedEdit {","+                    line: 1,","+                    columns: 0..3,","+                    new_text: \"new\",","+                },","+            ],","+        )],","+    );","+","+    Ok(())","+}","+","+#[test]","+fn unsupported_renames_do_not_suppress_supported_edits() -> anyhow::Result<()> {","+    let mut server = TestServerBuilder::new()?","+        .with_files([(\"old.py\", \"\"), (\"use.py\", \"import old\"), (\"notes.txt\", \"\")])?","+        .build()","+        .wait_until_workspaces_are_initialized();","+","+    let edit = rename_edit(","+        &mut server,","+        &[","+            // Non-Python renames are unsupported and must be skipped.","+            (\"notes.txt\", \"new.txt\"),","+            // The Python rename must still update its consumer in the same batch.","+            (\"old.py\", \"new.py\"),","+        ],","+    );","+","+    assert_edits(","+        edit.as_ref(),","+        &[(","+            server.file_uri(\"use.py\"),","+            &[ExpectedEdit {","+                line: 0,","+                columns: 7..10,","+                new_text: \"new\",","+            }],","+        )],","+    );","+","+    Ok(())","+}","+","+#[test]","+fn combines_project_edits_and_skips_conflicting_files() -> anyhow::Result<()> {","+    let mut server = TestServerBuilder::new()?","+        .with_workspace(SystemPath::new(\"repo\"), None)?","+        .with_workspace(SystemPath::new(\"repo/inner\"), None)?","+        .with_files([","+            (\"repo/ty.toml\", \"\"),","+            (\"repo/inner/ty.toml\", \"environment.root = [\\\".\\\", \\\"..\\\"]\"),","+            (\"repo/old.py\", \"\"),","+            (\"repo/conflict.py\", \"\"),","+            (\"repo/inner/conflict.py\", \"\"),","+            (\"repo/use.py\", \"import old\"),","+            (\"repo/inner/use.py\", \"import old\"),","+            (\"repo/inner/conflicted.py\", \"import old, conflict\"),","+        ])?","+        .build()","+        .wait_until_workspaces_are_initialized();","+","+    // The projects agree on `old` but resolve `conflict` in their respective roots.","+    // `conflicted.py` must receive no edits, including the agreed replacement for `old`.","+    let edit = rename_edit(","+        &mut server,","+        &[","+            (\"repo/old.py\", \"repo/new.py\"),","+            (\"repo/conflict.py\", \"repo/new_outer.py\"),","+            (\"repo/inner/conflict.py\", \"repo/inner/new_inner.py\"),","+        ],","+    );","+","+    assert_edits(","+        edit.as_ref(),","+        &[","+            (","+                server.file_uri(\"repo/use.py\"),","+                &[ExpectedEdit {","+                    line: 0,","+                    columns: 7..10,","+                    new_text: \"new\",","+                }],","+            ),","+            (","+                server.file_uri(\"repo/inner/use.py\"),","+                &[ExpectedEdit {","+                    line: 0,","+                    columns: 7..10,","+                    new_text: \"new\",","+                }],","+            ),","+        ],","+    );","+","+    Ok(())","+}","+","+#[test]","+fn disabled_language_services_suppress_file_rename_edits() -> anyhow::Result<()> {","+    let mut server = TestServerBuilder::new()?","+        .with_initialization_options(&ClientOptions::default().with_disable_language_services(true))","+        .with_files([(\"old.py\", \"\"), (\"use.py\", \"import old\")])?","+        .build()","+        .wait_until_workspaces_are_initialized();","+","+    let edit = rename_edit(&mut server, &[(\"old.py\", \"new.py\")]);","+","+    assert_eq!(edit, None);","+","+    Ok(())","+}","+","+#[test]","+fn file_renames_use_the_source_workspace_setting() -> anyhow::Result<()> {","+    let mut server = TestServerBuilder::new()?","+        .with_workspace(SystemPath::new(\"repo\"), None)?","+        .with_workspace(","+            SystemPath::new(\"repo/disabled\"),","+            Some(ClientOptions::default().with_disable_language_services(true)),","+        )?","+        .with_files([","+            // Both workspaces discover the project at `repo`, which indexes files in both.","+            (\"repo/ty.toml\", \"\"),","+            (\"repo/disabled/__init__.py\", \"\"),","+            (\"repo/disabled/old.py\", \"\"),","+            (\"repo/use.py\", \"from disabled import old\"),","+            (\"repo/shared.py\", \"\"),","+            (\"repo/disabled/use.py\", \"import shared\"),","+        ])?","+        .build()","+        .wait_until_workspaces_are_initialized();","+","+    let edit = rename_edit(","+        &mut server,","+        &[","+            (\"repo/disabled/old.py\", \"repo/disabled/new.py\"),","+            (\"repo/shared.py\", \"repo/renamed.py\"),","+        ],","+    );","+","+    // The disabled source is skipped. The enabled source can still update a disabled importer.","+    assert_edits(","+        edit.as_ref(),","+        &[(","+            server.file_uri(\"repo/disabled/use.py\"),","+            &[ExpectedEdit {","+                line: 0,","+                columns: 7..13,","+                new_text: \"renamed\",","+            }],","+        )],","+    );","+","+    Ok(())","+}","+","+#[test]","+fn external_file_renames_use_the_initialization_setting() -> anyhow::Result<()> {","+    for disable_language_services in [None, Some(true)] {","+        let mut initialization_options = ClientOptions::default();","+        initialization_options.workspace.disable_language_services = disable_language_services;","+","+        let mut server = TestServerBuilder::new()?","+            .with_initialization_options(&initialization_options)","+            .with_workspace(","+                SystemPath::new(\"app\"),","+                Some(ClientOptions::default().with_disable_language_services(true)),","+            )?","+            .with_files([","+                (\"app/ty.toml\", r#\"environment.extra-paths = [\"../shared\"]\"#),","+                (\"shared/old.py\", \"\"),","+                (\"app/use.py\", \"import old\"),","+            ])?","+            .build()","+            .wait_until_workspaces_are_initialized();","+","+        let edit = rename_edit(&mut server, &[(\"shared/old.py\", \"shared