 The values of partial depend on the index mode: synthetic","+        // source loads them from partial.keyword, which the role doesn't grant.","+        EsqlResult fls = assertFetchPhaseMatchesEager(\"fls_user\", \"FROM index | SORT value DESC | LIMIT 10\");","+        assertThat(fls.columnNames(), not(hasItem(\"org\")));","+        assertThat(fls.columnNames(), hasItem(\"partial\"));","+","+        // alias_user1 reads index-user1 only through first-alias, whose filter keeps its sales documents","+        EsqlResult alias = assertFetchPhaseMatchesEager(\"alias_user1\", \"FROM first-*,index-* | SORT value DESC | LIMIT 10\");","+        assertThat(alias.values(\"value\"), equalTo(List.of(31.0d)));","+        assertThat(alias.values(\"org\"), equalTo(List.of(\"sales\")));","+    }","+","+    /**","+     * Runs {@code query} as {@code user} with the fetch phase and without it. Checks that both return the same columns and","+     * rows, and that the fetch phase fetched documents.","+     */","+    private EsqlResult assertFetchPhaseMatchesEager(String user, String query) throws IOException {","+        Map<String, Object> eager = entityAsMap(runWithFetchPhase(user, query, false));","+        Map<String, Object> fetched = entityAsMap(runWithFetchPhase(user, query, true));","+        assertThat(fetched.get(\"columns\"), equalTo(eager.get(\"columns\")));","+        assertThat(fetched.get(\"values\"), equalTo(eager.get(\"values\")));","+        assertThat(\"documents fetched by [\" + query + \"] as [\" + user + \"]\", fetchedDocuments(fetched), greaterThan(0));","+        return EsqlResult.of(fetched);","+    }","+","+    /**","+     * Runs a profiled query that sets the {@code fetch_phase} pragma, and no other pragma.","+     */","+    private Response runWithFetchPhase(String user, String query, boolean fetchPhase) throws IOException {","+        XContentBuilder json = JsonXContent.contentBuilder().startObject();","+        json.field(\"query\", query);","+        json.field(\"profile\", true);","+        json.startObject(\"pragma\").field(\"fetch_phase\", fetchPhase).endObject();","+        json.endObject();","+        Request request = new Request(\"POST\", \"_query\");","+        request.setJsonEntity(Strings.toString(json));","+        request.setOptions(runAsUserOptions(user, null));","+        request.addParameter(\"error_trace\", \"true\");","+        return client().performRequest(request);","+    }","+","+    /**","+     * The documents that the fetch operators of a profiled query fetched.","+     */","+    @SuppressWarnings(\"unchecked\")","+    private static int fetchedDocuments(Map<String, Object> result) {","+        int documents = 0;","+        for (Map<String, Object> driver : (List<Map<String, Object>>) ((Map<String, Object>) result.get(\"profile\")).get(\"drivers\")) {","+            for (Map<String, Object> operator : (List<Map<String, Object>>) driver.get(\"operators\")) {","+                if (((String) operator.get(\"operator\")).startsWith(\"FetchOperator\")) {","+                    documents += ((Number) ((Map<String, Object>) operator.get(\"status\")).get(\"documents\")).intValue();","+                }","+            }","+        }","+        return documents;","+    }","+","     public void testUnauthorizedIndices() throws IOException {","         ResponseException error;","         error = expectThrows(ResponseException.class, () -> runESQLCommand(\"user1\", \"from index-user2 | stats sum(value)\"));"],"additions":72,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/EsqlFetchPhaseMultiNodeIT.java","lines":["@@ -0,0 +1,16 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.test.ESIntegTestCase;","+","+/**","+ * The fetch phase on three data nodes, where a query fetches from several nodes at once.","+ */","+@ESIntegTestCase.ClusterScope(numDataNodes = 3)","+public class EsqlFetchPhaseMultiNodeIT extends EsqlFetchPhaseTestCase {}"],"additions":16,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/EsqlFetchPhaseSingleNodeIT.java","lines":["@@ -0,0 +1,16 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.test.ESIntegTestCase;","+","+/**","+ * The fetch phase on one data node, which holds every document of every query.","+ */","+@ESIntegTestCase.ClusterScope(numDataNodes = 1)","+public class EsqlFetchPhaseSingleNodeIT extends EsqlFetchPhaseTestCase {}"],"additions":16,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/EsqlFetchPhaseTestCase.java","lines":["@@ -0,0 +1,956 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.action.bulk.BulkRequestBuilder;","+import org.elasticsearch.action.support.WriteRequest;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.compute.lucene.read.FetchDocsSourceOperator;","+import org.elasticsearch.compute.lucene.read.ValuesSourceReaderOperatorStatus;","+import org.elasticsearch.compute.operator.DriverProfile;","+import org.elasticsearch.compute.operator.OperatorStatus;","+import org.elasticsearch.xpack.esql.EsqlTestUtils;","+import org.elasticsearch.xpack.esql.fetch.FetchOperator;","+import org.elasticsearch.xpack.esql.fetch.FetchService;","+import org.elasticsearch.xpack.esql.plugin.ComputeService;","+import org.elasticsearch.xpack.esql.plugin.EsqlFlags;","+import org.elasticsearch.xpack.esql.plugin.QueryPragmas;","+import org.junit.Before;","+","+import java.util.ArrayList;","+import java.util.Arrays;","+import java.util.HashSet;","+import java.util.List;","+import java.util.Locale;","+import java.util.Map;","+import java.util.Set;","+import java.util.concurrent.TimeUnit;","+","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;","+import static org.elasticsearch.xpack.esql.action.EsqlQueryRequest.syncEsqlQueryRequest;","+import static org.hamcrest.Matchers.empty;","+import static org.hamcrest.Matchers.equalTo;","+import static org.hamcrest.Matchers.hasSize;","+import static org.hamcrest.Matchers.not;","+","+/**","+ * Queries that the fetch phase plans, and queries it leaves alone, each run with the fetch phase on and off. Both runs","+ * must return the same columns and rows. The profile of the run with the fetch phase then shows where each column was","+ * loaded: by the drivers before the cut, or by the {@code fetch} drivers on the nodes that hold the documents of the rows","+ * that survived it.","+ */","+public abstract class EsqlFetchPhaseTestCase extends AbstractEsqlIntegTestCase {","+    private String indexName;","+    /**","+     * Without node-level reduction the data drivers send their documents straight to the coordinator, instead of the","+     * node reduce driver. Both runs of a test use the same choice.","+     */","+    private final boolean nodeLevelReduction = randomBoolean();","+","+    /**","+     * The result and the profile of one run.","+     */","+    protected record Run(List<String> columns, List<List<Object>> rows, List<DriverProfile> drivers) {}","+","+    @Before","+    public void setupIndex() {","+        assumeTrue(\"the fetch phase needs its feature flag\", EsqlFlags.FETCH_PHASE_FEATURE_FLAG.isEnabled());","+        indexName = \"fetch_phase_\" + getTestName().toLowerCase(Locale.ROOT).replaceAll(\"[^a-z0-9]+\", \"_\");","+        assertAcked(","+            indicesAdmin().prepareCreate(indexName)","+                .setSettings(indexSettings(4, 0))","+                .setMapping(","+                    \"unique_sort\",","+                    \"type=long\",","+                    \"sorted\",","+                    \"type=long\",","+                    \"tie_breaker\",","+                    \"type=long\",","+                    \"payload\",","+                    \"type=keyword\",","+                    \"source_payload\",","+                    \"type=keyword,doc_values=false\",","+                    \"category\",","+                    \"type=keyword\",","+                    \"metric\",","+                    \"type=long\"","+                )","+        );","+        BulkRequestBuilder bulk = client().prepareBulk();","+        for (int i = 0; i < 64; i++) {","+            bulk.add(","+                prepareIndex(indexName).setId(Integer.toString(i))","+                    .setSource(","+                        Map.of(","+                            \"unique_sort\",","+                            i,","+                            \"sorted\",","+                            i / 4,","+                            \"tie_breaker\",","+                            i % 4,","+                            \"payload\",","+                            \"payload-\" + i,","+                            \"source_payload\",","+                            \"source-payload-\" + i,","+                            \"category\",","+                            \"cat-\" + (i % 5),","+                            \"metric\",","+                            i * 10L","+                        )","+                    )","+            );","+        }","+        bulk.setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE).get();","+    }","+","+    public void testFetchesTheColumnsOfTheWinners() {","+        Run run = runBoth(\"FROM \" + indexName + \" | SORT unique_sort + 1 DESC | LIMIT 5 | KEEP unique_sort, payload, category\");","+        assertThat(","+            run.rows(),","+            equalTo(","+                List.of(","+                    List.of(63L, \"payload-63\", \"cat-3\"),","+                    List.of(62L, \"payload-62\", \"cat-2\"),","+                    List.of(61L, \"payload-61\", \"cat-1\"),","+                    List.of(60L, \"payload-60\", \"cat-0\"),","+                    List.of(59L, \"payload-59\", \"cat-4\")","+                )","+            )","+        );","+        assertFetched(run, 5);","+        assertLoadedOnlyBeforeTheCut(run, \"unique_sort\");","+        assertFetchedOnly(run, \"payload\");","+        assertFetchedOnly(run, \"category\");","+    }","+","+    /**","+     * A plain {@code LIMIT}, written or the default one, loads its columns eagerly even when the query asks for the fetch","+     * phase: the coordinator drops few of the rows the data nodes load. Without a sort the rows change from run to run, so","+     * the test checks that each row holds the values of its own document.","+     */","+    public void testAPlainLimitKeepsThePlanEager() {","+        Map<String, Integer> rowsOfQuery = Map.of(","+            \"FROM \" + indexName + \" | LIMIT 10 | KEEP unique_sort, payload, category\",","+            10,","+            // the default LIMIT is above the 64 documents of the index","+            \"FROM \" + indexName + \" | KEEP unique_sort, payload, category\",","+            64","+        );","+        rowsOfQuery.forEach((query, rows) -> {","+            Run run = runQuery(query, true);","+            assertThat(run.rows(), hasSize(rows));","+            for (List<Object> row : run.rows()) {","+                long uniqueSort = (Long) row.getFirst();","+                assertThat(row, equalTo(List.of(uniqueSort, \"payload-\" + uniqueSort, \"cat-\" + (uniqueSort % 5))));","+            }","+            assertNotFetched(run);","+        });","+    }","+","+    /**","+     * A name under a {@code flattened} field is a field, the key of that name. The node that loads the fetched columns reads","+     * it the way the query phase does, so the key keeps its values.","+     */","+    public void testFetchesTheKeyOfAFlattenedField() {","+        assumeTrue(\"a name under a flattened field is a field\", EsqlCapabilities.Cap.FLATTENED_KEYS.isEnabled());","+        String index = indexName + \"_flattened\";","+        assertAcked(","+            indicesAdmin().prepareCreate(index)","+                .setSettings(indexSettings(4, 0))","+                .setMapping(\"unique_sort\", \"type=long\", \"attributes\", \"type=flattened\")","+        );","+        BulkRequestBuilder bulk = client().prepareBulk();","+        for (int i = 0; i < 64; i++) {","+            bulk.add(prepareIndex(index).setSource(\"unique_sort\", i, \"attributes\", Map.of(\"host\", Map.of(\"name\", \"host-\" + i))));","+        }","+        bulk.setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE).get();","+","+        Run run = runBoth(\"FROM \" + index + \" | SORT unique_sort DESC | LIMIT 3 | KEEP unique_sort, attributes.host.name\");","+","+        assertThat(run.rows(), equalTo(List.of(List.of(63L, \"host-63\"), List.of(62L, \"host-62\"), List.of(61L, \"host-61\"))));","+        assertFetched(run, 3);","+    }","+","+    /**","+     * {@code MV_EXPAND} before the cut repeats the {@code _doc} of a row for each of its values. The fetch loads each","+     * document once, for every row it repeats.","+     */","+    public void testFetchesTheDocumentsAnMvExpandRepeats() {","+        String index = indexName + \"_mv_expand\";","+        assertAcked(","+            indices