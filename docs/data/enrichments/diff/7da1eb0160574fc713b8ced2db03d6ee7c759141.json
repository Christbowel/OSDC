ivate volatile boolean noMoreInputs = false;"," ","     public ExchangeBuffer(int maxSize) {","+        this(maxSize, page -> {});","+    }","+","+    /**","+     * @param onDiscard gets each page that the buffer drops instead of handing it out, before the page is released. It must","+     *                  not throw, and must not keep the page.","+     */","+    public ExchangeBuffer(int maxSize, Consumer<Page> onDiscard) {","         if (maxSize < 1) {","             throw new IllegalArgumentException(\"max_buffer_size must be at least one; got=\" + maxSize);","         }","         this.maxSize = maxSize;","+        this.onDiscard = onDiscard;","     }"," ","     public void addPage(Page page) {","@@ -49,7 +60,7 @@ public void addPage(Page page) {","             // O(N) but acceptable because it only occurs with the stop API, and the queue size should be very small.","             if (page.batchMetadata() == null) {","                 if (queue.removeIf(p -> p == page)) {","-                    page.releaseBlocks();","+                    discard(page);","                     final int size = queueSize.decrementAndGet();","                     if (size == maxSize - 1) {","                         notifyNotFull();","@@ -129,7 +140,15 @@ public IsBlockedResult waitForReading() {","     private void discardPages() {","         Page p;","         while ((p = pollPage()) != null) {","-            p.releaseBlocks();","+            discard(p);","+        }","+    }","+","+    private void discard(Page page) {","+        try {","+            onDiscard.accept(page);","+        } finally {","+            page.releaseBlocks();","         }","     }"," "],"additions":21,"deletions":2,"truncated":false},{"path":"x-pack/plugin/esql/compute/src/main/java/org/elasticsearch/compute/operator/exchange/ExchangeSinkHandler.java","lines":["@@ -17,6 +17,7 @@"," import java.util.concurrent.Semaphore;"," import java.util.concurrent.atomic.AtomicInteger;"," import java.util.concurrent.at