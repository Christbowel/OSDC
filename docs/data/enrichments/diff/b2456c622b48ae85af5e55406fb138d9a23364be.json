{"id":"b2456c622b48ae85af5e55406fb138d9a23364be","axis":"silent","repo":"vllm-project/vllm","sha":"b2456c622b48ae85af5e55406fb138d9a23364be","parsed":{"files":[{"path":".buildkite/release-pipeline.yaml","lines":["@@ -703,547 +703,280 @@ steps:","           DOCKER_BUILDKIT: \"1\"","           DOCKERHUB_USERNAME: \"vllmbot\""," ","+  - trigger: \"perf-eval\"","+    label: \"Trigger perf-eval (CUDA)\"","+    key: trigger-perf-eval-cuda","+    if: build.env(\"NIGHTLY\") == \"1\" || build.env(\"RUN_PERF_EVAL\") == \"1\"","+    depends_on:","+      - build-release-image-x86","+    async: true","+    soft_fail: true","+    build:","+      branch: \"main\"","+      message: \"(NIGHTLY=${NIGHTLY:-0}) Evaluate vLLM $BUILDKITE_COMMIT (CUDA)\"","+      env:","+        NIGHTLY: 1 # run all perf-eval workloads","+        VLLM_COMMIT: \"$BUILDKITE_COMMIT\"","+        VLLM_IMAGE_CUDA: \"public.ecr.aws/q9t5s3a7/vllm-release-repo:$BUILDKITE_COMMIT-x86_64\"","+","+  - trigger: \"perf-eval\"","+    label: \"Trigger perf-eval (ROCm)\"","+    key: trigger-perf-eval-rocm","+    if: build.env(\"NIGHTLY\") == \"1\" || build.env(\"RUN_PERF_EVAL\") == \"1\"","+    depends_on:","+      - build-rocm100-release-image","+    async: true","+    soft_fail: true","+    build:","+      branch: \"main\"","+      message: \"(NIGHTLY=${NIGHTLY:-0}) Evaluate vLLM $BUILDKITE_COMMIT (ROCm)\"","+      env:","+        NIGHTLY: 1 # run all perf-eval workloads","+        VLLM_COMMIT: \"$BUILDKITE_COMMIT\"","+        VLLM_IMAGE_ROCM: \"public.ecr.aws/q9t5s3a7/vllm-release-repo:$BUILDKITE_COMMIT-rocm100\"","+","   # =============================================================================","-  # ROCm Release Pipeline (x86_64 only)","+  # ROCm Release Pipelines (x86_64 only)","   # =============================================================================","   #","-  # vLLM version is determined by the Buildkite checkout (like CUDA pipeline).","-  # To build a specific version, trigger the build from that branch/tag.","+  # One group per ROCm stack, identified by its base Dockerfile (ROCM_BASE_DOCKERFILE).","+  # The scripts derive the ROCm version, wheel variant, cache keys and image tags from","+  # it (.buildkite/scripts/rocm/stack.sh), so both groups share one set of step","+  # definitions, anchored on the ROCm 10.0 group.","   #","-  # Environment variables for ROCm builds (set via Buildkite UI or schedule):","-  #","-  # Note: ROCm version is determined by BASE_IMAGE in docker/Dockerfile.rocm_base","+  # - ROCm 10.0 (TheRock, docker/Dockerfile.rocm{,_base}) is the default: it owns the","+  #   :nightly / :latest images and the root wheel index.","+  # - ROCm 7.2 (docker/Dockerfile.rocm_72{,_base}) is kept for a transition period as","+  #   rocm72 images and wheels.","   #","+  # vLLM version is determined by the Buildkite checkout (like the CUDA pipeline).","   # ============================================================================="," ","-  - group: \"Build ROCm Wheel / Image \"","-    key: \"build-rocm-wheel-image\"","+  - group: \"Build ROCm 10.0 Wheel / Image\"","+    key: \"build-rocm100\"","     depends_on: ~","     steps:","-      # ROCm Job 1: Build ROCm Base Wheels (with S3 caching)","-      - label: \":rocm: Build ROCm Base Image & Wheels\"","-        id: build-rocm-base-wheels","+      - label: \":rocm: Build ROCm 10.0 Base Image & Wheels\"","+        id: build-rocm100-base","         depends_on: ~","-        agents:","+        agents: &rocm_build_agents","           queue: cpu_queue_release","-        commands:","+        timeout_in_minutes: 360","+        env: &rocm100_env","+          ROCM_BASE_DOCKERFILE: \"docker/Dockerfile.rocm_base\"","+          ROCM_DEFAULT_ARG: \"--default\"","+          DOCKER_BUILDKIT: \"1\"","+          S3_BUCKET: \"vllm-wheels\"","+          DOCKERHUB_USERNAME: \"vllmbot\"","+        commands: &rocm_base_commands","           - |","             set -euo pipefail","-","-            # Generate cache key","-            CACHE_KEY=$$(.buildkite/scripts/cache-rocm-base-wheels.sh key)","-            ECR_CACHE_TAG=\"public.ecr.aws/q9t5s3a7/vllm-release-repo:$${CACHE_KEY}-rocm-base\"","-","-            echo \"========================================\"","-            echo \"ROCm Base Build Configuration\"","-            echo \"========================================\"","-            echo \"  CACHE_KEY: $${CACHE_KEY}\"","-            echo \"  ECR_CACHE_TAG: $${ECR_CACHE_TAG}\"","-            echo \"========================================\"","-            ","-            # Login to ECR","+            source .buildkite/scripts/rocm/stack.sh \"$${ROCM_BASE_DOCKERFILE}\"","+            SCCACHE_ARGS=(--build-arg USE_SCCACHE=1 --build-arg SCCACHE_BUCKET_NAME=vllm-build-sccache","+              --build-arg SCCACHE_REGION_NAME=us-west-2 --build-arg SCCACHE_S3_NO_CREDENTIALS=0)","             aws ecr-public get-login-password --region us-east-1 | \\","               docker login --username AWS --password-stdin public.ecr.aws/q9t5s3a7","-            ","-            IMAGE_EXISTS=false","-            WHEELS_EXIST=false","-            ","-            # Check ECR for Docker image","-","-            if docker manifest inspect \"$${ECR_CACHE_TAG}\" > /dev/null 2>&1; then","-              IMAGE_EXISTS=true","-              echo \"ECR image cache HIT\"","-            fi","-            ","-            # Check S3 for wheels","-            WHEEL_CACHE_STATUS=$(.buildkite/scripts/cache-rocm-base-wheels.sh check)","-            if [ \"$${WHEEL_CACHE_STATUS}\" = \"hit\" ]; then","-              WHEELS_EXIST=true","-              echo \"S3 wheels cache HIT\"","-            fi"," ","-            ","-            # Scenario 1: Both cached (best case)","-            if [ \"$${IMAGE_EXISTS}\" = \"true\" ] && [ \"$${WHEELS_EXIST}\" = \"true\" ]; then","-              echo \"\"","-              echo \"FULL CACHE HIT - Reusing both image and wheels\"","-              echo \"\"","-","-              # Download wheels","-              .buildkite/scripts/cache-rocm-base-wheels.sh download","-              ","-              # Save ECR tag for downstream jobs","-              buildkite-agent meta-data set \"rocm-base-image-tag\" \"$${ECR_CACHE_TAG}\"","-              ","-            # Scenario 2: Full rebuild needed","+            # Base image, cached in ECR by the base Dockerfile's hash","+            if docker manifest inspect \"$${ROCM_STACK_ECR_BASE}\" > /dev/null 2>&1; then","+              echo \"ECR image cache HIT: $${ROCM_STACK_ECR_BASE}\"","             else","-              echo \"\"","-              echo \" CACHE MISS - Building from scratch...\"","-              echo \"\"","-              ","-              # Build full base image and push to ECR","-              DOCKER_BUILDKIT=1 docker buildx build \\","-                --file docker/Dockerfile.rocm_base \\","-                --tag \"$${ECR_CACHE_TAG}\" \\","-                --build-arg USE_SCCACHE=1 \\","-                --build-arg SCCACHE_BUCKET_NAME=vllm-build-sccache \\","-                --build-arg SCCACHE_REGION_NAME=us-west-2 \\","-                --build-arg SCCACHE_S3_NO_CREDENTIALS=0 \\","-                --push \\","-                .","-              ","-              # Build wheel extraction stage","-              DOCKER_BUILDKIT=1 docker buildx build \\","-                --file docker/Dockerfile.rocm_base \\","-                --tag rocm-base-debs:$${BUILDKITE_BUILD_NUMBER} \\","-                --target debs_wheel_release \\","-                --build-arg USE_SCCACHE=1 \\","-                --build-arg SCCACHE_BUCKET_NAME=vllm-build-sccache \\","-                --build-arg SCCACHE_REGION_NAME=us-west-2 \\","-                --build-arg SCCACHE_S3_NO_CREDENTIALS=0 \\","-                --load \\","-                .","-              ","-              # Extract and upload wheels","-              mkdir -p artifacts/rocm-base-wheels","-              cid=$(docker create rocm-base-debs:$${BUILDKITE_BUIL