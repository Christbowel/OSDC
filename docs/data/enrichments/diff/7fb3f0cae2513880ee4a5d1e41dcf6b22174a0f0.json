,","+\t\t{","+\t\t\tname: \"s3 backend with a directory bucket\",","+\t\t\tconfig: func() *Config {","+\t\t\t\tcfg := NewDefaultConfig()","+\t\t\t\tcfg.StorageConfig.Trace.Backend = backend.S3","+\t\t\t\tcfg.StorageConfig.Trace.S3.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\t\t\treturn cfg","+\t\t\t}(),","+\t\t\texpect: []ConfigWarning{warnS3DirectoryBucket},","+\t\t},","+\t\t{","+\t\t\tname: \"s3express backend\",","+\t\t\tconfig: func() *Config {","+\t\t\t\tcfg := NewDefaultConfig()","+\t\t\t\tcfg.StorageConfig.Trace.Backend = backend.S3Express","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Region = \"eu-central-1\"","+\t\t\t\treturn cfg","+\t\t\t}(),","+\t\t\texpect: nil,","+\t\t},","+\t\t{","+\t\t\tname: \"s3express backend with an invalid config\",","+\t\t\tconfig: func() *Config {","+\t\t\t\tcfg := NewDefaultConfig()","+\t\t\t\tcfg.StorageConfig.Trace.Backend = backend.S3Express","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Region = \"eu-central-1\"","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Insecure = true","+\t\t\t\treturn cfg","+\t\t\t}(),","+\t\t\texpect: []ConfigWarning{","+\t\t\t\t{","+\t\t\t\t\tMessage: \"insecure isn't supported: Tempo can only sign uploads to S3 directory buckets over https\",","+\t\t\t\t\tExplain: \"Tempo will not start with an invalid storage.trace.s3express configuration\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"s3express backend with an ignored option\",","+\t\t\tconfig: func() *Config {","+\t\t\t\tcfg := NewDefaultConfig()","+\t\t\t\tcfg.StorageConfig.Trace.Backend = backend.S3Express","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Region = \"eu-central-1\"","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.ListBlocksConcurrency = 3","+\t\t\t\treturn cfg","+\t\t\t}(),","+\t\t\texpect: []ConfigWarning{","+\t\t\t\t{","+\t\t\t\t\tMessage: \"list_blocks_concurrency is 3, but S3 directory buckets don't list keys in order, so their blocks are listed with a single listing\",","+\t\t\t\t\tExplain: \"storage.trace.s3express contains an option that doesn't apply to S3 directory buckets and will be ignored\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"trace storage conflicts with overrides storage - s3express\",","+\t\t\tconfig: func() *Config {","+\t\t\t\tcfg := NewDefaultConfig()","+\t\t\t\tcfg.StorageConfig.Trace.Backend = backend.S3Express","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\t\t\tcfg.StorageConfig.Trace.S3Express.Region = \"eu-central-1\"","+\t\t\t\tcfg.Overrides.UserConfigurableOverridesConfig.Client.Backend = backend.S3Express","+\t\t\t\tcfg.Overrides.UserConfigurableOverridesConfig.Client.S3Express.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\t\t\treturn cfg","+\t\t\t}(),","+\t\t\texpect: []ConfigWarning{warnTracesAndUserConfigurableOverridesStorageConflict},","+\t\t},"," \t}"," "," \tfor _, tc := range tt {"],"additions":68,"deletions":0,"truncated":false},{"path":"cmd/tempo/app/modules.go","lines":["@@ -48,6 +48,7 @@ import ("," \t\"github.com/grafana/tempo/v3/tempodb/backend/gcs\""," \t\"github.com/grafana/tempo/v3/tempodb/backend/local\""," \t\"github.com/grafana/tempo/v3/tempodb/backend/s3\"","+\t\"github.com/grafana/tempo/v3/tempodb/backend/s3express\""," )"," "," // The various modules that make up tempo.","@@ -617,6 +618,8 @@ func (t *App) initUsageReport() (services.Service, error) {"," \t\treader, writer, _, err = gcs.New(t.cfg.StorageConfig.Trace.GCS)"," \tcase backend.S3:"," \t\treader, writer, _, err = s3.New(t.cfg.StorageConfig.Trace.S3)","+\tcase backend.S3Express:","+\t\treader, writer, _, err = s3express.New(t.cfg.StorageConfig.Trace.S3Express)"," \tcase backend.Azure:"," \t\treader, writer, _, err = azure.New(t.cfg.StorageConfig.Trace.Azure)"," \tdefault:","@@ -664,6 +667,8 @@ func (t *App) initBackendScheduler() (services.Service, error) {"," \t\treader, writer, _, err = gcs.New(t.cfg.StorageConfig.Trace.GCS)"," \tcase backend.S3:"," \t\treader, writer, _, err = s3.New(t.cfg.StorageConfig.Trace.S3)","+\tcase backend.S3Express:","+\t\treader, writer, _, err = s3express.New(t.cfg.StorageConfig.Trace.S3Express)"," \tcase backend.Azure:"," \t\treader, writer, _, err = azure.New(t.cfg.StorageConfig.Trace.Azure)"," \tdefault:"],"additions":5,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/_index.md","lines":["@@ -1596,7 +1596,7 @@ storage:","     trace:"," ","         # The storage backend to use","-        # Should be one of \"gcs\", \"s3\", \"azure\" or \"local\" (only supported in the monolithic mode)","+        # Should be one of \"gcs\", \"s3\", \"s3express\", \"azure\" or \"local\" (only supported in the monolithic mode)","         # CLI flag -storage.trace.backend","         [backend: <string>]"," ","@@ -1848,6 +1848,22 @@ storage:","               # It expects a 32 byte long string.","               encryption_key:"," ","+        # S3 directory bucket configuration. Will be used only if value of backend is \"s3express\".","+        # Takes the options of s3, except insecure, which isn't supported, and list_blocks_concurrency, which is ignored.","+        # Check the S3 doc within this folder for information on directory bucket specific permissions.","+        s3express:","+","+            # Name of the directory bucket, which ends in --x-s3.","+            # Example: \"bucket: tempo--euc1-ist1-az1--x-s3\"","+            [bucket: <string>]","+","+            # The Region of the bucket's Availability Zone or Local Zone. Required.","+            # Example: \"region: eu-central-1\"","+            [region: <string>]","+","+            # Optional. Defaults to the bucket's Zonal endpoint, s3express-<zone-id>.<region>.amazonaws.com.","+            [endpoint: <string>]","+","         # Azure configuration. Will be used only if value of backend is \"azure\".","         azure:"," ","@@ -2840,7 +2856,7 @@ overrides:"," ","     client:","       # The storage backend to use","-      # Should be one of \"gcs\", \"s3\", \"azure\" or \"local\"","+      # Should be one of \"gcs\", \"s3\", \"s3express\", \"azure\" or \"local\"","       [backend: <string>]"," ","       # Backend-specific configuration, support the same configuration options as the","@@ -2848,6 +2864,7 @@ overrides:","       local:","       gcs:","       s3:","+      s3express:","       azure:"," ","       # Check whether the backend supports versioning at startup. If enabled Tempo will not start if"],"additions":19,"deletions":2,"truncated":false},{"path":"docs/sources/tempo/configuration/hosted-storage/s3.md","lines":["@@ -53,6 +53,56 @@ The following IAM policy shows minimal permissions required by Tempo, where the"," "," A lifecycle policy is recommended that deletes incomplete multipart uploads after one day."," ","+## S3 directory buckets","+","+To store traces in an [S3 directory bucket](https://docs.aws.amazon.com/AmazonS3/latest/userguide/directory-buckets-overview.html),","+in an Availability Zone (S3 Express One Zone) or a Local Zone,","+use the `s3express` backend.","+The `s3` backend doesn't support directory buckets,","+whose names end in `--x-s3`.","+","+The `s3express` backend authenticates like the AWS SDKs do:","+it creates a session with the `CreateSession` API using your IAM credentials,","+then signs requests with the session credentials.","+Grant `s3express:CreateSession` on the bucket instead of the `s3:*` actions:","+","+```json","+{","+  \"Version\": \"2012-10-17\",","+  \"Statement\": [","+    {","+      \"Sid\": \"TempoPermissions\",","+      \"Effect\": \"Allow\",","+      \"Action\": [\"s3express:CreateSession\"],","+      \"Resource\": [\"arn:aws:s3express:<region>:<account-id>:bucket/<bucketname>\"]","+    }","+  ]","+}","+```","+","+The `s3express` backend takes the options of the `s3` backend.","+Set `region` to the parent Region of the bucket's zone.","+If you leave `endpoint` empty,","+Tempo uses the bucket's Zonal endpoint, `s3express-<zone-id>.<region>.amazonaws.com`.","+Directory buckets only accept virtual-hosted-style requests,","+which Tempo uses for `amazonaws.com` endpoints unless `forcepathstyle` or `bucket_lookup_type` say otherwise.","+","+```yaml","+storage:","+  trace:","+    backend: s3express","+    s3express:","+      bucket: tempo--euc1-ist1-az1--x-s3","+      region: eu-central-1","+```","+","+Tempo writes to directory buckets only over HTTPS,","+so `insecure` isn't supported.","+Directory buckets don't list objects in order,","+so Tempo lists the blocks of a tenant with a single listing and ignores `list_blocks_concurrency`.","+Directory buckets don't support object tags or SSE-C encryption,","+so leave `tags` and `sse.type: SSE-C` unset.","+"," ## S3-compatible local stores for testing"," "," {{< admonition type=\"note\" >}}"],"additions":50,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/manifest.md","lines":["@@ -738,6 +738,44 @@ storage:","                 kms_key_id: \"\"","                 kms_encryption_context: \"\"","                 encryption_key: \"\"","+        s3express:","+            tls_cert_path: \"\"","+            tls_key_path: \"\"","+            tls_ca_path: \"\"","+            tls_server_name: \"\"","+            tls_insecure_skip_verify: false","+            tls_cipher_suites: \"\"","+            tls_min_version: VersionTLS12","+            bucket: \"\"","+            prefix: \"\"","+            endpoint: \"\"","+            region: \"\"","+            access_key: \"\"","+            secret_key: \"\"","+            session_token: \"\"","+            insecure: false","+            part_size: 0","+            hedge_requests_at: 0s","+            hedge_requests_up_to: 2","+            retry_max_attempts: 10","+            retry_backoff_initial: 