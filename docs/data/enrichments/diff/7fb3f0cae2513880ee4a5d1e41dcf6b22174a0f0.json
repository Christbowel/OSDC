e.GCS.BucketName)","+\t\tassert.Equal(t, \"tempo--euc1-ist1-az1--x-s3\", trace.Azure.ContainerName)","+\t\tassert.True(t, trace.GCS.Insecure)","+\t})","+","+\tt.Run(\"unset options keep the config\", func(t *testing.T) {","+\t\ttrace := newTraceConfig()","+\t\ttrace.Backend = backend.S3Express","+\t\ttrace.S3Express.Bucket = \"tempo--euc1-ist1-az1--x-s3\"","+\t\ttrace.S3Express.Endpoint = \"s3express-euc1-ist1-az1.eu-central-1.amazonaws.com\"","+\t\t(&backendOptions{}).apply(trace)","+","+\t\tassert.Equal(t, backend.S3Express, trace.Backend)","+\t\tassert.Equal(t, \"tempo--euc1-ist1-az1--x-s3\", trace.S3Express.Bucket)","+\t\tassert.Equal(t, \"s3express-euc1-ist1-az1.eu-central-1.amazonaws.com\", trace.S3Express.Endpoint)","+\t})","+}","+","+func TestBackendFlag(t *testing.T) {","+\tfor _, value := range []string{backend.Local, backend.GCS, backend.S3, backend.S3Express, backend.Azure} {","+\t\tt.Run(value, func(t *testing.T) {","+\t\t\tvar opts struct {","+\t\t\t\tbackendOptions","+\t\t\t}","+\t\t\tparser, err := kong.New(&opts)","+\t\t\trequire.NoError(t, err)","+","+\t\t\t_, err = parser.Parse([]string{\"--backend\", value})","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Equal(t, value, opts.Backend)","+\t\t})","+\t}","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"cmd/tempo/app/config.go","lines":["@@ -29,6 +29,7 @@ import ("," \t\"github.com/grafana/tempo/v3/pkg/util\""," \t\"github.com/grafana/tempo/v3/tempodb\""," \t\"github.com/grafana/tempo/v3/tempodb/backend\"","+\t\"github.com/grafana/tempo/v3/tempodb/backend/s3express\""," )"," "," const defaultGRPCCompression = \"snappy\"","@@ -225,6 +226,26 @@ func (c *Config) CheckConfig() []ConfigWarning {"," \t\twarnings = append(warnings, warnNativeAWSAuthEnabled)"," \t}"," ","+\tif c.StorageConfig.Trace.Backend == backend.S3 && s3express.IsDirectoryBucket(c.StorageConfig.Trace.S3.Bucket) {","+\t\twarnings = append(warnings, warnS3DirectoryBucket)","+\t}","+","+\tif c.StorageConfig.Trace.Backend ==