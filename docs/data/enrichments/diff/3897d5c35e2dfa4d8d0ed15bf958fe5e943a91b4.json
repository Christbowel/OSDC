{"id":"3897d5c35e2dfa4d8d0ed15bf958fe5e943a91b4","axis":"silent","repo":"aquasecurity/trivy","sha":"3897d5c35e2dfa4d8d0ed15bf958fe5e943a91b4","parsed":{"files":[{"path":"pkg/fanal/types/crypto.go","lines":["@@ -135,8 +135,7 @@ func (a CryptoAssetInfo) Validate() error {"," \treturn nil"," }"," ","-// CompareCryptoAssets orders assets by identity, then by file path and key format,","-// since one identity can be found in several files and containers.","+// CompareCryptoAssets orders assets by identity, then by where they were found."," func CompareCryptoAssets(a, b CryptoAsset) int {"," \treturn cmp.Or("," \t\tcmp.Compare(a.Kind, b.Kind),","@@ -145,6 +144,7 @@ func CompareCryptoAssets(a, b CryptoAsset) int {"," \t\tcmp.Compare(a.Identity.Value, b.Identity.Value),"," \t\tcmp.Compare(a.Identity.Parameters, b.Identity.Parameters),"," \t\tcmp.Compare(a.FilePath, b.FilePath),","+\t\tcmp.Compare(a.Layer.DiffID, b.Layer.DiffID),"," \t\tcmp.Compare(a.Format, b.Format),"," \t)"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"pkg/fanal/types/crypto_descriptor.go","lines":["@@ -132,7 +132,7 @@ func (d CryptoDescriptor) validateParameters() error {"," \tif d.Kind != CryptoKindAlgorithm || d.Identity.Method != CryptoMethodOID {"," \t\treturn xerrors.Errorf(\"parameters are only valid for OID algorithm descriptors\")"," \t}","-\tif err := validateAlgorithmParameters(d.Identity.Parameters); err != nil {","+\tif err := d.Identity.validateAlgorithmParameter(); err != nil {"," \t\treturn xerrors.Errorf(\"validate algorithm parameters: %w\", err)"," \t}"," \treturn nil","@@ -207,25 +207,40 @@ const ("," \tCryptoParameterCurve CryptoAlgorithmParameter = \"curve\""," )"," ","-// validateAlgorithmParameters accepts only empty parameters, key-size=<canonical positive","+// AlgorithmParameter returns the parameter that distinguishes algorithm assets sharing an","+// OID. It reports false when the identity carries none.","+func (i CryptoIdentity) AlgorithmParameter() (CryptoAlgorithmParameter, string, bool) {","+\tname, value, found := strings.Cut(i.Parameters, \"=\")","+\tif !found {","+\t\treturn \"\", \"\", false","+\t}","+\treturn CryptoAlgorithmParameter(name), value, true","+}","+","+// validateAlgorithmParameter accepts only empty parameters, key-size=<canonical positive"," // decimal>, and curve=<non-empty name>.","-func validateAlgorithmParameters(parameters string) error {","-\tif parameters == \"\" {","+func (i CryptoIdentity) validateAlgorithmParameter() error {","+\tif i.Parameters == \"\" {"," \t\treturn nil"," \t}","-\tif value, ok := strings.CutPrefix(parameters, string(CryptoParameterKeySize)+\"=\"); ok {","+\tname, value, found := i.AlgorithmParameter()","+\tif !found {","+\t\treturn xerrors.Errorf(\"unknown algorithm parameters %q\", i.Parameters)","+\t}","+","+\tswitch name {","+\tcase CryptoParameterKeySize:"," \t\tif !isCanonicalPositiveDecimal(value) {"," \t\t\treturn xerrors.Errorf(\"key size parameter must be a canonical positive decimal\")"," \t\t}","-\t\treturn nil","-\t}","-\tif value, ok := strings.CutPrefix(parameters, string(CryptoParameterCurve)+\"=\"); ok {","+\tcase CryptoParameterCurve:"," \t\tif value == \"\" {"," \t\t\treturn xerrors.Errorf(\"curve parameter must not be empty\")"," \t\t}","-\t\treturn nil","+\tdefault:","+\t\treturn xerrors.Errorf(\"unknown algorithm parameters %q\", i.Parameters)"," \t}","-\treturn xerrors.Errorf(\"unknown algorithm parameters %q\", parameters)","+\treturn nil"," }"," "," func isLowerSHA256(value string) bool {"],"additions":25,"deletions":10,"truncated":false},{"path":"pkg/sbom/core/bom.go","lines":["@@ -75,6 +75,10 @@ type BOM struct {"," \tcomponents    map[uuid.UUID]*Component"," \trelationships map[uuid.UUID][]Relationship"," ","+\t// cryptoComponents are the cryptographic assets of the BOM. They are an inventory and","+\t// take no part in the dependency graph, so they are kept outside components.","+\tcryptoComponents []*CryptoComponent","+"," \t// externalReferences is a list of documents that are referenced from this BOM but hosted elsewhere."," \t// They are currently used to look for linked VEX documents"," \texternalReferences []ExternalReference","@@ -203,6 +207,55 @@ func (f File) IsEmpty() bool {"," \treturn f.Path == \"\" && len(f.Digests) == 0"," }"," ","+// CryptoComponent describes a cryptographic asset: a certificate, a key or an algorithm.","+// It is kept apart from Component, which describes software.","+type CryptoComponent struct {","+\t// Asset is what the component describes. Its identity is derived from content and does","+\t// not depend on where the asset was found.","+\t// CycloneDX: component.cryptoProperties","+\t// SPDX: N/A","+\tAsset ftypes.CryptoAssetInfo","+","+\t// Occurrences are the places the asset was found at. One component is merged from the","+\t// assets of several files and layers, and each of them becomes an occurrence.","+\t// CycloneDX: component.evidence.occurrences","+\t// SPDX: N/A","+\tOccurrences []Occurrence","+}","+","+// BOMRef returns the reference of the component, derived from the asset identity.","+func (c *CryptoComponent) BOMRef() string {","+\treturn CryptoBOMRef(c.Asset.Descriptor())","+}","+","+// Clone creates a deep copy of the CryptoComponent","+func (c *CryptoComponent) Clone() *CryptoComponent {","+\treturn &CryptoComponent{","+\t\tAsset:       c.Asset.Clone(),","+\t\tOccurrences: slices.Clone(c.Occurrences),","+\t}","+}","+","+// CryptoBOMRef returns the BOM reference of the component describing an asset.","+//","+// The prefix scopes cryptographic assets in a namespace shared with package components,","+// whose reference is a package URL.","+func CryptoBOMRef(descriptor ftypes.CryptoDescriptor) string {","+\treturn \"crypto:\" + descriptor.String()","+}","+","+// Occurrence is a place a component was found at.","+type Occurrence struct {","+\t// Location is the path of the file the component was found in.","+\t// CycloneDX: component.evidence.occurrences[].location","+\tLocation string","+","+\t// LayerDiffID is the layer the file was found in. It is empty for a target that has no","+\t// layers.","+\t// CycloneDX: component.evidence.occurrences[].additionalContext","+\tLayerDiffID string","+}","+"," type Property struct {"," \tName      string"," \tValue     string","@@ -279,6 +332,10 @@ func (b *BOM) AddComponent(c *Component) {"," \tb.components[c.id] = c"," }"," ","+func (b *BOM) AddCryptoComponent(c *CryptoComponent) {","+\tb.cryptoComponents = append(b.cryptoComponents, c)","+}","+"," func (b *BOM) AddRelationship(parent, child *Component, relationshipType RelationshipType) {"," \t// Check the wrong parent to avoid `panic`"," \tif parent == nil {","@@ -346,6 +403,10 @@ func (b *BOM) Components() map[uuid.UUID]*Component {"," \treturn b.components"," }"," ","+func (b *BOM) CryptoComponents() []*CryptoComponent {","+\treturn b.cryptoComponents","+}","+"," func (b *BOM) Relationships() map[uuid.UUID][]Relationship {"," \treturn b.relationships"," }","@@ -395,6 +456,11 @@ func (b *BOM) Clone() *BOM {"," \t\t\treturn c.Clone()"," \t\t}),"," ","+\t\t// Deep copy cryptographic components","+\t\tcryptoComponents: lo.Map(b.cryptoComponents, func(c *CryptoComponent, _ int) *CryptoComponent {","+\t\t\treturn c.Clone()","+\t\t}),","+"," \t\t// Deep copy relationships"," \t\trelationships: lo.MapValues(b.relationships, func(rels []Relationship, _ uuid.UUID) []Relationship {"," \t\t\treturn slices.Clone(rels)"],"additions":66,"deletions":0,"truncated":false},{"path":"pkg/sbom/cyclonedx/crypto.go","lines":["@@ -0,0 +1,250 @@","+package cyclonedx","+","+import (","+\t\"strconv\"","+\t\"strings\"","+\t\"time\"","+","+\tcdx \"github.com/CycloneDX/cyclonedx-go\"","+","+\tftypes \"github.com/aquasecurity/trivy/pkg/fanal/types\"","+\t\"github.com/aquasecurity/trivy/pkg/log\"","+\t\"github.com/aquasecurity/trivy/pkg/sbom/core\"","+\txslices \"github.com/aquasecurity/trivy/pkg/x/slices\"","+)","+","+// ellipticCurves maps the curve names of crypto/elliptic to the CycloneDX elliptic curve","+// enumeration, which qualifies a curve with the body that standardized it. A curve absent","+// from the map is left out, because the enumeration accepts nothing else.","+var ellipticCurves = map[string]string{","+\t\"P-224\": \"nist/P-224\",","+\t\"P-256\": \"nist/P-256\",","+\t\"P-384\": \"nist/P-384\",","+\t\"P-521\": \"nist/P-521\",","+}","+","+// marshalCryptoComponent turns a cryptographic asset into a CycloneDX component.","+func (m *Marshaler) marshalCryptoComponent(component *core.CryptoComponent) cdx.Component {","+\treturn cdx.Component{","+\t\tBOMRef:           component.BOMRef(),","+\t\tType:             cdx.ComponentTypeCryptographicAsset,","+\t\tName:             component.Asset.Name,","+\t\tCryptoProperties: m.cryptoProperties(component.Asset),","+\t\tEvidence:         m.evidence(component.Occurrences),","+\t}","+}","+","+// cryptoProperties translates a cryptographic asset into CycloneDX crypto properties.","+// This is the only place where the neutral model meets the CycloneDX types.","+func (m *Marshaler) cryptoProperties(asset ftypes.CryptoAssetInfo) *cdx.CryptoProperties {","+\t// A report can come from a JSON file, through `trivy convert`, and nothing validates it,","+\t// so the detail is checked and not assumed from the kind.","+\tswitch {","+\tcase asset.Kind == ftypes.CryptoKindCertificate && asset.Certificate != nil:","+\t\treturn &cdx.CryptoProperties{","+\t\t\tAssetType:             cdx.CryptoAssetTypeCertificate,","+\t\t\tCertificateProperties: m.certificateProperties(asset),","+\t\t}","+\tcase asset.Kind == ftypes.CryptoKindKey && asset.Key != nil:","+\t\treturn &cdx.CryptoProperties{","+\t\t\tAssetType:                       cdx.CryptoAssetTypeRelatedCryptoMaterial,","+\t\t\tRelatedCryptoMaterialProperties: m.relatedCryptoMaterialProperties(asset),","+\t\t}","+\tcase asset.Kind == ftypes.CryptoKindAlgorithm && asset.Algorithm != nil:","+\t\treturn &cdx.CryptoProperties{","+\t\t\tAssetType:           cdx.CryptoAssetTypeAlgorithm,","+\t\t\tAlgorithmProperties: m.algorithmProperties(asset),","+\t\t\tOID:                 asset.Identity.Value,","+\t\t}","+\t}","+","+\t// Either the kind is unknown, or the details it names are missing.","+\tm.logger.Debug(\"Omitting crypto properties of the cryptographic asset that has no details matching its kind\",","+\t\tlog.String(\"bom-ref\", core.CryptoBOMRef(asset.Descriptor())), log.Any(\"kind\", asset.Kind))","+\treturn nil","+}","+","+func (m *Marshaler) certificateProperties(asset ftypes.CryptoAssetInfo) *cdx.CertificateProperties {","+\tcert := asset.Certificate","+\treturn &cdx.CertificateProperties{","+\t\tSerialNumber:      cert.SerialNumber,","+\t\tSubjectName:       cert.Subject,","+\t\tIssuerName:        cert.Issuer,","+\t\tNotValidBefore:    formatTime(cert.NotBefore),","+\t\tNotValidAfter:     formatTime(cert.NotAfter),","+\t\tCertificateFormat: string(cert.Format),","+\t\t// The identity is the digest of the whole DER, the fingerprint openssl and browsers","+\t\t// report. The 1.7 schema describes this field as a hash of the certificate","+\t\t// \"excluding it's signature\", which is a digest nothing else computes.","+\t\t// https://github.com/CycloneDX/specification/issues/1031","+\t\tFingerprint: &cdx.Hash{","+\t\t\tAlgorithm: cdx.HashAlgoSHA256,","+\t\t\tValue:     asset.Identity.Value,","+\t\t},","+\t\tCertificateExtensions:      m.certificateExtensions(cert),","+\t\tRelatedCryptographicAssets: m.relatedCryptographicAssets(asset.Relationships),","+\t}","+}","+","+// certificateExtensions renders the parsed extensions as the strings CycloneDX expects,","+// following the notation of the OpenSSL text output.","+func (*Marshaler) certificateExtensions(cert *ftypes.CryptoCertificate) *[]cdx.CertificateExtension {","+\tvar extensions []cdx.CertificateExtension","+\tadd := func(name cdx.CertificateExtensionName, value string) {","+\t\textensions = append(extensions, cdx.CertificateExtension{","+\t\t\tCommon: &cdx.CommonCertificateExtension{","+\t\t\t\tName:  name,","+\t\t\t\tValue: value,","+\t\t\t},","+\t\t})","+\t}","+","+\tif cert.BasicConstraintsValid {","+\t\tvalue := \"CA:FALSE\"","+\t\tif cert.IsCA {","+\t\t\tvalue = \"CA:TRUE\"","+\t\t}","+\t\t// A path length is stated only by a CA that constrains the chain below it. Zero is","+\t\t// such a constraint, and an unset zero is not, so the two are told apart by the flag.","+\t\tif cert.IsCA && (cert.MaxPathLen > 0 || cert.MaxPathLenZero) {","+\t\t\tvalue += \", pathlen:\" + strconv.Itoa(cert.MaxPathLen)","+\t\t}","+\t\tadd(cdx.CertExtBasicConstraints, value)","+\t}","+\tif len(cert.KeyUsage) != 0 {","+\t\tadd(cdx.CertExtKeyUsage, strings.Join(cert.KeyUsage, \", \"))","+\t}","+\tif len(cert.ExtendedKeyUsage) != 0 {","+\t\tadd(cdx.CertExtExtendedKeyUsage, strings.Join(cert.ExtendedKeyUsage, \", \"))","+\t}","+\t// Each subject alternative name states its own type, because one extension holds names","+\t// of every type at once.","+\tnames := prefixAll(\"DNS:\", cert.DNSNames)","+\tnames = append(names, prefixAll(\"email:\", cert.EmailAddresses)...)","+\tnames = append(names, prefixAll(\"IP:\", cert.IPAddresses)...)","+\tnames = append(names, prefixAll(\"URI:\", cert.URIs)...)","+\tif len(names) != 0 {","+\t\tadd(cdx.CertExtSubjectAlternativeName, strings.Join(names, \", \"))","+\t}","+","+\tif len(extensions) == 0 {","+\t\treturn nil","+\t}","+\treturn &extensions","+}","+","+func (m *Marshaler) relatedCryptoMaterialProperties(asset ftypes.CryptoAssetInfo) *cdx.RelatedCryptoMaterialProperties {","+\tkey := asset.Key","+\tproperties := &cdx.RelatedCryptoMaterialProperties{","+\t\tType:                       relatedCryptoMaterialType(asset.KeyType),","+\t\tRelatedCryptographicAssets: m.relatedCryptographicAssets(asset.Relationships),","+\t}","+\tif key.Size > 0 {","+\t\tproperties.Size = new(key.Size)","+\t}","+\t// The schema asks for a hash of the asset, and both key identities are one: the digest","+\t// of the SubjectPublicKeyInfo, or of the container when it stays encrypted.","+\tproperties.Fingerprint = &cdx.Hash{","+\t\tAlgorithm: cdx.HashAlgoSHA256,","+\t\tValue:     asset.Identity.Value,","+\t}","+\treturn properties","+}","+","+func (m *Marshaler) algorithmProperties(asset ftypes.CryptoAssetInfo) *cdx.CryptoAlgorithmProperties {","+\tproperties := &cdx.CryptoAlgorithmProperties{","+\t\tPrimitive:       cryptoPrimitive(asset.Algorithm.Primitive),","+\t\tAlgorithmFamily: asset.Algorithm.Family,","+\t}","+","+\t// The property that distinguishes algorithms sharing one OID is kept as a parameter of","+\t// the identity, and only its value is reported here.","+\tname, value, found := asset.Identity.AlgorithmParameter()","+\tif !found {","+\t\treturn properties","+\t}","+\tswitch name {","+\tcase ftypes.CryptoParameterKeySize:","+\t\tproperties.ParameterSetIdentifier = value","+\tcase ftypes.CryptoParameterCurve:","+\t\tproperties.EllipticCurve = ellipticCurves[value]","+\t}","+\treturn properties","+}","+","+// relatedCryptographicAssets refers to the neighboring assets. CycloneDX describes what","+// the target is rather than how it is related, so the relationship types of the model","+// collapse into the kind of the target.","+func (*Marshaler) relatedCryptographicAssets(relationships []ftypes.CryptoRelationship) *[]cdx.RelatedCryptographicAsset {","+\tif len(relationships) == 0 {","+\t\treturn nil","+\t}","+","+\trelated := xslices.Map(relationships, func(relationship ftypes.CryptoRelationship) cdx.RelatedCryptographicAsset {","+\t\treturn cdx.RelatedCryptographicAsset{","+\t\t\tType: relatedCryptographicAssetType(relationship.RelatedAsset),","+\t\t\tRef:  core.CryptoBOMRef(relationship.RelatedAsset),","+\t\t}","+\t})","+\treturn &related","+}","+","+func relatedCryptographicAssetType(descriptor ftypes.CryptoDescriptor) string {","+\tif descriptor.Kind == ftypes.CryptoKindKey {","+\t\tif descriptor.KeyType == ftypes.CryptoKeyTypePrivate {","+\t\t\treturn \"privateKey\"","+\t\t}","+\t\treturn \"publicKey\"","+\t}","+\treturn \"algorithm\"","+}","+","+func relatedCryptoMaterialType(keyType ftypes.CryptoKeyType) cdx.RelatedCryptoMaterialType {","+\tif keyType == ftypes.CryptoKeyTypePrivate {","+\t\treturn cdx.RelatedCryptoMaterialTypePrivateKey","+\t}","+\treturn cdx.RelatedCryptoMaterialTypePublicKey","+}","+","+func cryptoPrimitive(primitive ftypes.CryptoPrimitive) cdx.CryptoPrimitive {","+\tswitch primitive {","+\tcase ftypes.CryptoPrimitiveSignature:","+\t\treturn cdx.CryptoPrimitiveSignature","+\tcase ftypes.CryptoPrimitivePKE:","+\t\treturn cdx.CryptoPrimitivePKE","+\t}","+\treturn cdx.CryptoPrimitiveUnknown","+}","+","+// evidence reports where the component was found. A cryptographic asset is merged by","+// identity, so one component has an occurrence per file and layer it was found in.","+//","+// CycloneDX 1.7 has no structured field for the layer of an occurrence, so the layer goes to","+// additionalContext as a Trivy-specific name-value pair.","+func (*Marshaler) evidence(occurrences []core.Occurrence) *cdx.Evidence {","+\tif len(occurrences) == 0 {","+\t\treturn nil","+\t}","+","+\tfound := xslices.Map(occurrences, func(occurrence core.Occurrence) cdx.EvidenceOccurrence {","+\t\to := cdx.EvidenceOccurrence{Location: occurrence.Location}","+\t\tif occurrence.LayerDiffID != \"\" {","+\t\t\to.AdditionalContext = Namespace + core.PropertyLayerDiffID + \"=\" + occurrence.LayerDiffID","+\t\t}","+\t\treturn o","+\t})","+\treturn &cdx.Evidence{Occurrences: &found}","+}","+","+func formatTime(t time.Time) string {","+\tif t.IsZero() {","+\t\treturn \"\"","+\t}","+\treturn t.UTC().Format(timeLayout)","+}","+","+func prefixAll(prefix string, values []string) []string {","+\treturn xslices.Map(values, func(value string) string {","+\t\treturn prefix + value","+\t})","+}"],"additions":250,"deletions":0,"truncated":false},{"path":"pkg/sbom/cyclonedx/crypto_test.go","lines":["@@ -0,0 +1,609 @@","+package cycloned