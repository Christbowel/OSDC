    </>","+      );","+      expect(buttonRef.current).toBe(screen.getByRole('button', { name: 'Save' }));","+      expect(anchorRef.current).toBe(screen.getByRole('link', { name: 'Docs' }));","+    });","+  });","+","+  describe('as a button', () => {","+    it('calls onClick when clicked', async () => {","+      const onClick = jest.fn();","+      render(<AbstractButton onClick={onClick}>Save</AbstractButton>);","+      await userEvent.click(screen.getByRole('button', { name: 'Save' }));","+      expect(onClick).toHaveBeenCalledTimes(1);","+    });","+","+    it('does not call onClick when disabled', async () => {","+      const onClick = jest.fn();","+      render(","+        <AbstractButton onClick={onClick} disabled>","+          Save","+        </AbstractButton>","+      );","+      const button = screen.getByRole('button', { name: 'Save' });","+      expect(button).toBeDisabled();","+      await userEvent.click(button);","+      expect(onClick).not.toHaveBeenCalled();","+    });","+","+    it('uses aria-disabled instead of disabled when it has a tooltip, so the tooltip stays reachable', async () => {","+      const onClick = jest.fn();","+      render(","+        <AbstractButton onClick={onClick} disabled tooltip=\"Not available\">","+          Save","+        </AbstractButton>","+      );","+      const button = screen.getByRole('button', { name: 'Save' });","+      expect(button).toHaveAttribute('aria-disabled', 'true');","+      expect(button).toBeEnabled();","+      await userEvent.click(button);","+      expect(onClick).not.toHaveBeenCalled();","+    });","+  });","+","+  describe('as an anchor', () => {","+    it('sanitizes javascript: URLs', () => {","+      render(","+        <AbstractButton as=\"a\" href=\"javascript:alert(1)\">","+          Open","+        </AbstractButton>","+      );","+      expect(screen.getByRole('link', { name: 'Open' })).toHaveAttribute('href', 'about:blank');","+    });","+","+    it('leaves the tab order and is marked disab