al_name = vec![0u8; block.file_name_length as usize];","+        if let Err(e) = reader.read_exact(&mut local_name) {","+            let _ = reader.seek(SeekFrom::Start(current_pos));","+            return Err(e.into());","+        }","+","+        let mut local_extra = vec![0u8; block.extra_field_length as usize];","+        if let Err(e) = reader.read_exact(&mut local_extra) {","+            let _ = reader.seek(SeekFrom::Start(current_pos));","+            return Err(e.into());","+        }","+","+        // Restore reader position","+        reader.seek(SeekFrom::Start(current_pos))?;","+","+        let variable_fields_len =","+            u64::from(block.file_name_length) + u64::from(block.extra_field_length);","+        let data_start = self","+            .header_start","+            .checked_add((size_of::<Magic>() + size_of::<ZipLocalEntryBlock>()) as u64)","+            .and_then(|v| v.checked_add(variable_fields_len))","+            .ok_or(ZipError::InvalidArchive(Cow::Borrowed(","+                \"Local header end offset overflows u64\",","+            )))?;","+        let _ = self.data_start.set(data_start);","+","+        let local_extra_fields = ExtraFields::parse(&local_extra, &block, true)?;","+        let mut local_data = Self::from_local_block(block, local_extra_fields)?;","+        local_data.apply_extra_fields(&mut local_name)?;","+","+        let local_meta = local_data.consistency_metadata(&local_name, true);","+        let central_meta = self.consistency_metadata(expected_name, false);","+","+        local_meta.validate_matches(&central_meta)","+    }","+","     /// Check if the file is a directory based on the file name.","     pub(crate) fn is_dir(&self, file_name: &[u8]) -> bool {","         is_dir(file_name)"],"additions":83,"deletions":0,"truncated":false},{"path":"tests/header_consistency.rs","lines":["@@ -0,0 +1,825 @@","+#![cfg(all(","+    not(miri),","+    not(all(feature = \"deflate-zopfli\", not(feature = \"deflate-flate2\")))","+))]","+//! Tests for header consistency validation in ZipStreamReader.","+//! Verifies mitigation for dual-header desynchronization / Zip Cloaking (CWE-436 / CWE-20).","+","+use std::fs;","+use std::io::{Cursor, Write};","+use tempfile::tempdir;","+use zip::result::ZipError;","+use zip::unstable::stream::ZipStreamReader;","+use zip::write::SimpleFileOptions;","+use zip::{ZipArchive, ZipWriter};","+","+/// Simulates a security gateway inspection using Central Directory (CDFH).","+fn security_gateway_inspection(archive_bytes: &[u8]) -> Result<(), String> {","+    let mut archive = ZipArchive::new(Cursor::new(archive_bytes))","+        .map_err(|e| format!(\"Corrupted archive: {:?}\", e))?;","+","+    for i in 0..archive.len() {","+        let entry = archive","+            .by_index(i)","+            .map_err(|e| format!(\"Entry error: {:?}\", e))?;","+        let name = entry.name().map_err(|e| format!(\"Name error: {:?}\", e))?;","+","+        if name.ends_with(\".sh\") || name.ends_with(\".exe\") || name.ends_with(\".bat\") {","+            return Err(format!(\"Blocked executable/script: {}\", name));","+        }","+        if !name.ends_with(\".pdf\") {","+            return Err(format!(\"Policy violation: {}\", name));","+        }","+    }","+    Ok(())","+}","+","+/// Constructs a dual-header archive where LFH is \"cron_worker.sh\" and CDFH is \"doc_report.pdf\".","+fn create_dual_header_archive() -> Vec<u8> {","+    const SCRIPT_NAME: &str = \"cron_worker.sh\";","+    const SPOOFED_NAME: &str = \"doc_report.pdf\";","+    const CENTRAL_HEADER_BASE_SIZE: usize = 46;","+","+    let mut payload = Cursor::new(Vec::new());","+    let mut writer = ZipWriter::new(&mut payload);","+    let options = SimpleFileOptions::default();","+","+    writer.start_file(SCRIPT_NAME, options).unwrap();","+    writer","+        .write_all(b\"#!/bin/sh\\necho 'MALICIOUS SCRIPT EXECUTED'\\n\")"],"additions":49,"deletions":0,"truncated":false}],"additions":516,"deletions":25,"truncated"