{"id":"eb34bc88b899993ad9ecce2b108095667e4fa54b","axis":"silent","repo":"pnpm/pnpm","sha":"eb34bc88b899993ad9ecce2b108095667e4fa54b","parsed":{"files":[{"path":".changeset/recursive-gate-one-discovery.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+A recursive `pnpm run` or `pnpm exec` with `verifyDepsBeforeRun` set no longer reads every `package.json` in the workspace once per project when `sharedWorkspaceLockfile` is `false`. In a 300-project workspace, `pnpm -r exec true` went from 490 ms to 42 ms [pnpm/tasks#256](https://github.com/pnpm/tasks/issues/256)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/verify_deps.rs","lines":["@@ -15,7 +15,9 @@ use miette::{Diagnostic, IntoDiagnostic};"," use pnpm_config::{Config, VerifyDepsBeforeRun};"," use pnpm_default_reporter::colors::Colors;"," use pnpm_fs::DirLock;","-use pnpm_package_manager::{RunDepsStatus, check_deps_status_before_run_at, deps_install_root};","+use pnpm_package_manager::{","+    GateWorkspace, RunDepsStatus, check_deps_status_before_run_at, deps_install_root,","+};"," use std::{","     collections::HashSet,","     io::{self, IsTerminal},","@@ -76,7 +78,22 @@ pub(crate) fn verify_deps_before_run(","     if !config.verify_deps_before_run.is_enabled() {","         return Ok(());","     }","-    let Some(status) = check_deps_status_before_run_at(dir, config, selected_project_dirs) else {","+    verify_deps_before_run_in(dir, (selected_project_dirs, None), config, reporter)","+}","+","+/// [`verify_deps_before_run`] with the workspace projects a recursive","+/// command discovered once for the gates of all its projects. The gate","+/// forgets them when it finds the dependencies out of date. The caller","+/// checks that `verifyDepsBeforeRun` is enabled.","+fn verify_deps_before_run_in(","+    dir: &Path,","+    (selected_project_dirs, workspace): (&[&Path], Option<&mut GateWorkspace>),","+    config: &Config,","+    reporter: ReporterType,","+) -> miette::Result<()> {","+    let Some(status) =","+        check_deps_status_before_run_at(dir, config, selected_project_dirs, workspace.as_deref())","+    else {","         return Ok(());","     };","     let (issue, mut install_args) = match status {","@@ -88,7 +105,12 @@ pub(crate) fn verify_deps_before_run(","             );","             return Ok(());","         }","-        RunDepsStatus::Outdated { issue, install_args } => (issue, install_args),","+        RunDepsStatus::Outdated { issue, install_args } => {","+            if let Some(workspace) = workspace {","+                workspace.forget_projects();","+            }","+            (issue, install_args)","+        }","     };","     // A filtered `run` or `exec` only selected some of the workspace's","     // projects, so its install has to select the same ones.","@@ -147,9 +169,15 @@ pub(crate) fn verify_deps_before_recursive_run<ProjectPath: AsRef<Path>>(","             .collect();","         verify_deps_before_run(workspace_root, &selected, config, reporter)","     } else {","+        let mut workspace = GateWorkspace::of(workspace_root, config);","         for project_dir in &project_dirs {","             let project_dir = project_dir.as_ref();","-            verify_deps_before_run(project_dir, &[project_dir], config, reporter)?;","+            verify_deps_before_run_in(","+                project_dir,","+                (&[project_dir], workspace.as_mut()),","+                config,","+                reporter,","+            )?;","         }","         Ok(())","     }","@@ -198,7 +226,7 @@ fn locked_install(","         (None, false)","     });","     let install_args = if waited {","-        match check_deps_status_before_run_at(dir, config, selected_project_dirs) {","+        match check_deps_status_before_run_at(dir, config, selected_project_dirs, None) {","             Some(RunDepsStatus::Outdated { mut install_args, .. }) => {","                 install_args.extend(install_selection_args(config));","                 install_args","@@ -223,7 +251,7 @@ fn warn_if_still_outdated(","     reporter: ReporterType,"," ) {","     if let Some(RunDepsStatus::Outdated { issue, .. }) =","-        check_deps_status_before_run_at(dir, config, selected_project_dirs)","+        check_deps_status_before_run_at(dir, config, selected_project_dirs, None)","     {","         warn(","             matches!(reporter, ReporterType::Silent),"],"additions":34,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_records.rs","lines":["@@ -971,3 +971,84 @@ fn a_workspace_with_project_lockfiles_verifies_patches_after_a_project_is_remove","     assert!(text.contains(\"ERR_PNPM_UNUSED_PATCH\"), \"{text}\");","     drop((root, mock_instance));"," }","+","+/// [`write_workspace_with_project_lockfiles`] with a gate that fails a","+/// command on outdated dependencies, and a project `c` that also links `b`.","+fn write_gated_workspace_with_project_lockfiles(workspace: &Path) {","+    write_workspace_with_project_lockfiles(workspace);","+    let workspace_yaml = workspace.join(\"pnpm-workspace.yaml\");","+    let mut yaml = fs::read_to_string(&workspace_yaml).expect(\"read pnpm-workspace.yaml\");","+    yaml.push_str(\"verifyDepsBeforeRun: error\\n\");","+    fs::write(&workspace_yaml, yaml).expect(\"write pnpm-workspace.yaml\");","+    fs::create_dir_all(workspace.join(\"packages/c\")).expect(\"create packages/c\");","+    fs::write(","+        workspace.join(\"packages/c/package.json\"),","+        serde_json::json!({ \"name\": \"c\", \"version\": \"1.0.0\", \"dependencies\": { \"b\": \"workspace:*\" } })","+            .to_string(),","+    )","+    .expect(\"write packages/c/package.json\");","+}","+","+fn recursive_exec(workspace: &Path, registry: &str) -> std::process::Output {","+    pacquet_in(workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", registry)","+        .with_args([\"-r\", \"exec\", \"node\", \"-e\", \"0\"])","+        .output()","+        .expect(\"run pnpm -r exec\")","+}","+","+#[test]","+fn a_recursive_exec_gate_with_project_lockfiles_passes_an_up_to_date_workspace() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_gated_workspace_with_project_lockfiles(&workspace);","+    pacquet","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    trust_recorded_stats(&workspace, mock_instance.url());","+","+    let output = recursive_exec(&workspace, mock_instance.url());","+","+    assert!(output.status.success(), \"{}\", combined_output(&output));","+    drop((root, mock_instance));","+}","+","+#[test]","+fn a_recursive_exec_gate_with_project_lockfiles_reports_an_outdated_project() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_gated_workspace_with_project_lockfiles(&workspace);","+    pacquet","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    trust_recorded_stats(&workspace, mock_instance.url());","+    fs::write(","+        workspace.join(\"packages/c/package.json\"),","+        serde_json::json!({ \"name\": \"c\", \"version\": \"1.0.0\", \"dependencies\": { \"a\": \"workspace:*\" } })","+            .to_string(),","+    )","+    .expect(\"edit packages/c/package.json\");","+","+    let output = recursive_exec(&workspace, mock_instance.url());","+","+    let text = combined_output(&output);","+    assert!(!output.status.success(), \"{text}\");","+    assert!(text.contains(\"ERR_PNPM_VERIFY_DEPS_BEFORE_RUN\"), \"{text}\");","+    drop((root, mock_instance));","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/repeat_install_records/opens.rs","lines":["@@ -4,8 +4,8 @@"," "," use super::{","     GATE_DECIDED_FROM_RECORDS, combined_output, traced_run, trust_recorded_stats,","-    write_gated_workspace, write_workspace, write_workspace_with_pnpmfile,","-    write_workspace_with_project_lockfiles,","+    write_gated_workspace, write_gated_workspace_with_project_lockfiles, write_workspace,","+    write_workspace_with_pnpmfile, write_workspace_with_project_lockfiles,"," };"," use crate::_utils::pacquet_in;"," use assert_cmd::prelude::*;","@@ -25,8 +25,11 @@ fn count_opens(paths: &[PathBuf], run: impl FnOnce()) -> usize {","     assert!(fd >= 0, \"inotify_init1: {}\", std::io::Error::last_os_error());","     for path in paths {","         let path = CString::new(path.as_os_str().as_bytes()).expect(\"a path without NUL\");","+        // The kernel merges an event into an identical one left unread at the","+        // tail of the queue, so the closes keep back-to-back opens apart.","+        let mask = libc::IN_OPEN | libc::IN_CLOSE;","         // SAFETY: `fd` is the inotify descriptor above and `path` outlives the call.","-        let watch = unsafe { libc::inotify_add_watch(fd, path.as_ptr(), libc::IN_OPEN) };","+        let watch = unsafe { libc::inotify_add_watch(fd, path.as_ptr(), mask) };","         assert!(watch >= 0, \"inotify_add_watch: {}\", std::io::Error::last_os_error());","     }","     run();","@@ -205,3 +208,59 @@ fn an_up_to_date_install_with_project_lockfiles_opens_no_project_manifest() {","     assert_eq!(opens, 0);","     drop((root, mock_instance));"," }","+","+/// The gates of a recursive command share one discovery of the workspace","+/// projects. The gates add two reads of `a`'s manifest to the command's own,","+/// that discovery and `a`'s own gate, however many projects link workspace","+/// commands.","+#[test]","+fn a_recursive_exec_with_project_lockfiles_discovers_the_projects_once() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_gated_workspace_with_project_lockfiles(&workspace);","+    install(&workspace, mock_instance.url());","+","+    let opens = count_opens(&[workspace.join(\"packages/a/package.json\")], || {","+        pacquet_in(&workspace)","+            .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+            .with_args([\"-r\", \"exec\", \"true\"])","+            .assert()","+            .success();","+    });","+","+    assert!((3..=4).contains(&opens), \"packages/a/package.json was opened {opens} times\");","+    drop((root, mock_instance));","+}","+","+/// A gate that finds its project out of date leaves the next gate to","+/// discover the workspace projects again, since an install in between may","+/// have changed their manifests.","+#[test]","+fn a_recursive_exec_with_project_lockfiles_rediscovers_after_an_outdated_gate() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_gated_workspace_with_project_lockfiles(&workspace);","+    install(&workspace, mock_instance.url());","+    let outdated = serde_json::json!({","+        \"name\": \"b\",","+        \"version\": \"1.0.0\",","+        \"bin\": { \"b\": \"cli.js\" },","+        \"peerDependencies\": { \"is-positive\": \"1.0.0\" },","+    });","+    fs::write(workspace.join(\"packages/b/package.json\"), outdated.to_string())","+        .expect(\"edit packages/b/package.json\");","+","+    let opens = count_opens(&[workspace.join(\"packages/a/package.json\")], || {","+        pacquet_in(&workspace)","+            .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+            .with_env(\"PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN\", \"warn\")","+            .with_args([\"-r\", \"exec\", \"true\"])","+            .assert()","+            .success();","+    });","+","+    assert!(opens >= 5, \"packages/a/package.json was opened {opens} times\");","+    drop((root, mock_instance));","+}"],"additions":62,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install.rs","lines":["@@ -25,7 +25,7 @@ pub(crate) use workspace_state::{","     update_workspace_state_or_warn, workspace_packages_for_freshness,"," };"," pub use workspace_state::{","-    UpToDateFastPathCheck, UpToDateWorkspace, build_workspace_packages_map,","+    GateWorkspace, UpToDateFastPathCheck, UpToDateWorkspace, build_workspace_packages_map,","     check_deps_status_before_run_at, deps_install_root, install_already_up_to_date,","     install_already_up_to_date_from_records, install_already_up_to_date_per_project,"," };"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state.rs","lines":["@@ -1,4 +1,4 @@","-pub use discovery::{check_deps_status_before_run_at, deps_install_root};","+pub use discovery::{GateWorkspace, check_deps_status_before_run_at, deps_install_root};"," pub use per_project::install_already_up_to_date_per_project;"," pub(crate) use projects::replace_project_manifest;"," pub(super) use projects::{"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state/discovery.rs","lines":["@@ -28,11 +28,16 @@ use std::borrow::Cow;"," /// as unverifiable (\"Cannot check whether dependencies are outdated\"),"," /// matching pnpm's catch-all: in the worst case the configured action"," /// runs a redundant install.","+///","+/// `workspace` is shared by the gates of one command, so under dedicated","+/// per-project lockfiles each gate reads its projects instead of walking","+/// the workspace again."," #[must_use]"," pub fn check_deps_status_before_run_at(","     dir: &Path,","     config: &Config,","     selected_project_dirs: &[&Path],","+    workspace: Option<&GateWorkspace>,"," ) -> Option<crate::RunDepsStatus> {","     let Ok(workspace_dir_opt) = configured_or_discovered_workspace_dir(config, dir) else {","         return cannot_check_deps();","@@ -73,11 +78,62 @@ pub fn check_deps_status_before_run_at(","             workspace_manifest: workspace_manifest.as_ref(),","             workspace_root,","             lockfile_root: &lockfile_root,","+            workspace,","         },","         selected_project_dirs,","     )"," }"," ","+/// The workspace projects the verify-deps gate reads under dedicated","+/// per-project lockfiles, for the gates of several projects in one command.","+/// The first gate that needs them discovers them, and the others reuse them.","+pub struct GateWorkspace {","+    root: PathBuf,","+    discovered: std::sync::OnceLock<Option<DiscoveredProjects>>,","+}","+","+/// One discovery of the workspace projects, with the workspace manifest and","+/// the key of the options it ran with.","+struct DiscoveredProjects {","+    manifest: pnpm_workspace::WorkspaceManifest,","+    key: pnpm_workspace::DiscoveryKey,","+    projects: Vec<pnpm_workspace::Project>,","+}","+","+impl GateWorkspace {","+    /// The workspace that `dir` belongs to. `None` outside a workspace.","+    #[must_use]","+    pub fn of(dir: &Path, config: &Config) -> Option<Self> {","+        let root = configured_or_discovered_workspace_dir(config, dir).ok()??;","+        Some(Self { root, discovered: std::sync::OnceLock::new() })","+    }","+","+    /// Drop the workspace manifest and the discovered projects, so the next","+    /// gate reads them again after an install that may have changed them.","+    pub fn forget_projects(&mut self) {","+        self.discovered.take();","+    }","+","+    /// Its projects, as [`check_deps_status_before_run_at`] would discover","+    /// them under `config`. `None` when the discovery failed, or when","+    /// `config` discovers with other options than the gate that ran it, such","+    /// as a project's own `modulesDir`.","+    fn projects(&self, config: &Config) -> Option<&[pnpm_workspace::Project]> {","+        let discovered = self.discovered","+            .get_or_init(|| {","+                let manifest = pnpm_workspace::read_workspace_manifest(&self.root).ok()??;","+                let opts = super::super::lifecycle::checked_projects_opts(config, &manifest);","+                let projects = pnpm_workspace::find_workspace_projects(&self.root, &opts).ok()?;","+                let key = opts.discovery_key(&self.root);","+                Some(DiscoveredProjects { manifest, key, projects })","+            })","+            .as_ref()?;","+        let key = super::super::lifecycle::checked_projects_opts(config, &discovered.manifest)","+            .discovery_key(&self.root);","+        (discovered.key == key).then_some(discovered.projects.as_slice())","+    }","+}","+"," /// What the verify-deps gate read before it consults the workspace state."," #[derive(Clone, Copy)]"," pub(super) struct GateInputs<'a> {","@@ -86,6 +142,8 @@ pub(super) struct GateInputs<'a> {","     pub(super) workspace_manifest: Option<&'a pnpm_workspace::WorkspaceManifest>,","     pub(super) workspace_root: &'a Path,","     pub(super) lockfile_root: &'a Path,","+    /// See [`check_deps_status_before_run_at`].","+    pub(super) workspace: Option<&'a GateWorkspace>,"," }"," "," /// pnpm reports \"cannot check\" straight from the missing workspace state,","@@ -112,15 +170,9 @@ fn deps_status_from_state(","     match pnpm_workspace_state::load_workspace_state_in_modules(","         &inputs.config.workspace_state_modules_dir(inputs.lockfile_root),","     ) {","-        Ok(Some(workspace_state)) => check_discovered_deps(","-            inputs.config,","-            inputs.manifest,","-            inputs.workspace_manifest,","-            inputs.workspace_root,","-            inputs.lockfile_root,","-            &workspace_state,","-            selected_project_dirs,","-        ),","+        Ok(Some(workspace_state)) => {","+            check_discovered_deps(inputs, &workspace_state, selected_project_dirs)","+        }","         // Nothing was installed here yet. Spawning an install for projects","         // that give it nothing to do would only leave a lockfile and","         // `node_modules` behind.","@@ -171,14 +223,18 @@ pub(super) fn cannot_check_deps() -> Option<crate::RunDepsStatus> {","     })"," }"," pub(super) fn check_discovered_deps(","-    config: &Config,","-    manifest: &PackageManifest,","-    workspace_manifest: Option<&pnpm_workspace::WorkspaceManifest>,","-    workspace_root: &Path,","-    lockfile_root: &Path,","+    inputs: &GateInputs<'_>,","     workspace_state: &pnpm_workspace_state::WorkspaceState,","     selected_project_dirs: &[&Path],"," ) -> Option<crate::RunDepsStatus> {","+    let &GateInputs {","+        config,","+        manifest,","+        workspace_manifest,","+        workspace_root,","+        lockfile_root,","+        ..","+    } = inputs;","     let Some(catalogs) = configured_catalogs(config, workspace_manifest) else {","         return cannot_check_deps();","     };","@@ -194,13 +250,11 @@ pub(super) fn check_discovered_deps(","         Ok(()) => return Some(crate::RunDepsStatus::UpToDate),","         Err(listed) => listed,","     };","-    let Ok(workspace_projects) =","-        load_gated_workspace(config, manifest, workspace_root, workspace_manifest, listed)","-    else {","+    let mut loaded = None;","+    let Ok(workspace_projects) = gate_workspace_projects(inputs, listed, &mut loaded) else {","         return cannot_check_deps();","     };","-    let (project_manifests, bin_projects) =","-        gated_projects(config, manifest, workspace_projects.as_deref());","+    let (project_manifests, bin_projects) = gated_projects(config, manifest, workspace_projects);","     Some(run_gate(","         &gate,","         crate::DeclaredManifests::new(&project_manifests),","@@ -253,6 +307,35 @@ fn gate_from_records(","     Err(Some(listed))"," }"," ","+/// The workspace projects the gate reads, `None` when it reads none. Under","+/// dedicated lockfiles the projects only feed the bins, so the ones the","+/// command discovered stand in for a walk of the workspace. A walk leaves","+/// its projects in `loaded`.","+fn gate_workspace_projects<'a>(","+    inputs: &GateInputs<'a>,","+    listed: Option<Vec<pnpm_workspace::ProjectManifestPaths>>,","+    loaded: &'a mut Option<Vec<pnpm_workspace::Project>>,","+) -> Result<Option<&'a [pnpm_workspace::Project]>, pnpm_workspace::FindWorkspaceProjectsError> {","+    let &GateInputs {","+        config,","+        manifest,","+        workspace_manifest,","+        workspace_root,","+        workspace,","+        ..","+    } = inputs;","+    let links = crate::optimistic_repeat_install::validation::links_workspace_commands(manifest);","+    let discovered = workspace","+        .filter(|workspace| workspace.root == workspace_root)","+        .filter(|_| !config.shares_one_lockfile() && links)","+        .and_then(|workspace| workspace.projects(config));","+    if discovered.is_some() {","+        return Ok(discovered);","+    }","+    *loaded = load_gated_workspace(config, manifest, workspace_root, workspace_manifest, listed)?;","+    Ok(loaded.as_deref())","+}","+"," /// [`crate::check_deps_status_before_run`] on `project_manifests`."," fn run_gate(","     gate: &GateCheck<'_>,","@@ -381,3 +464,6 @@ pub(super) fn configured_catalogs(","         None => get_catalogs_from_workspace_manifest(workspace_manifest).ok(),","     }"," }","+","+#[cfg(test)]","+mod tests;"],"additions":105,"deletions":19,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state/discovery/tests.rs","lines":["@@ -0,0 +1,94 @@","+use super::{GateInputs, GateWorkspace, gate_workspace_projects};","+use pnpm_config::Config;","+use pnpm_package_manifest::PackageManifest;","+use std::fs;","+use tempfile::tempdir;","+","+#[test]","+fn only_a_gate_with_other_discovery_results_skips_the_shared_projects() {","+    let dir = tempdir().expect(\"create a temporary directory\");","+    let root = dir.path();","+    fs::write(root.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write pnpm-workspace.yaml\");","+    fs::create_dir_all(root.join(\"packages/a\")).expect(\"create packages/a\");","+    fs::write(root.join(\"packages/a/package.json\"), r#\"{\"name\":\"a\"}\"#)","+        .expect(\"write packages/a/package.json\");","+    let mut config = Config::new();","+    config.workspace_dir = Some(root.to_path_buf());","+    config.modules_dir = root.join(\"packages/a/node_modules\");","+    let mut own_node_modules = config.clone();","+    own_node_modules.modules_dir = root.join(\"packages/b/node_modules\");","+    let mut other_modules_dir = config.clone();","+    other_modules_dir.modules_dir = root.join(\"packages/a/other_modules\");","+    let workspace = GateWorkspace::of(root, &config).expect(\"a workspace\");","+","+    let projects = workspace.projects(&config).expect(\"the discovered projects\");","+    assert_eq!(projects.len(), 1);","+    assert!(workspace.projects(&own_node_modules).is_some());","+    assert!(workspace.projects(&other_modules_dir).is_none());","+}","+","+#[test]","+fn forgetting_the_projects_reads_the_workspace_manifest_again() {","+    let dir = tempdir().expect(\"create a temporary directory\");","+    let root = dir.path();","+    fs::write(root.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write pnpm-workspace.yaml\");","+    for project in [\"packages/a\", \"tools/b\"] {","+        fs::create_dir_all(root.join(project)).expect(\"create the project directory\");","+        fs::write(root.join(project).join(\"package.json\"), \"{}\").expect(\"write package.json\");","+    }","+    let mut config = Config::new();","+    config.workspace_dir = Some(root.to_path_buf());","+    let mut workspace = GateWorkspace::of(root, &config).expect(\"a workspace\");","+    assert_eq!(workspace.projects(&config).map(<[_]>::len), Some(1));","+    fs::write(root.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n  - tools/*\\n\")","+        .expect(\"rewrite pnpm-workspace.yaml\");","+","+    workspace.forget_projects();","+","+    assert_eq!(workspace.projects(&config).map(<[_]>::len), Some(2));","+}","+","+#[test]","+fn a_gate_in_a_nested_workspace_walks_its_own_workspace() {","+    let dir = tempdir().expect(\"create a temporary directory\");","+    let outer = dir.path();","+    let nested = outer.join(\"packages/nested\");","+    for (root, project) in [(outer, \"packages/a\"), (nested.as_path(), \"packages/b\")] {","+        fs::create_dir_all(root.join(project)).expect(\"create the project directory\");","+        fs::write(root.join(project).join(\"package.json\"), \"{}\").expect(\"write package.json\");","+        fs::write(root.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+            .expect(\"write pnpm-workspace.yaml\");","+    }","+    let mut config = Config::new();","+    config.shared_workspace_lockfile = false;","+    let workspace = GateWorkspace::of(outer, &config).expect(\"the outer workspace\");","+    let nested_manifest = pnpm_workspace::read_workspace_manifest(&nested)","+        .expect(\"read the nested workspace manifest\")","+        .expect(\"a nested workspace manifest\");","+    let manifest = PackageManifest::from_value(","+        nested.join(\"packages/b/package.json\"),","+        serde_json::json!({ \"dependencies\": { \"a\": \"workspace:*\" } }),","+    );","+    let inputs = GateInputs {","+        config: &config,","+        manifest: &manifest,","+        workspace_manifest: Some(&nested_manifest),","+        workspace_root: &nested,","+        lockfile_root: &nested.join(\"packages/b\"),","+        workspace: Some(&workspace),","+    };","+    let mut loaded = None;","+","+    let projects = gate_workspace_projects(&inputs, None, &mut loaded)","+        .expect(\"discover the projects\")","+        .expect(\"the projects of the nested workspace\");","+","+    let roots: Vec<_> = projects","+        .iter()","+        .map(|project| project.root_dir.clone())","+        .collect();","+    assert!(roots.contains(&nested.join(\"packages/b\")), \"{roots:?}\");","+    assert!(!roots.contains(&outer.join(\"packages/a\")), \"{roots:?}\");","+}"],"additions":94,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state/nothing_to_install.rs","lines":["@@ -25,6 +25,7 @@ pub(super) fn projects_have_nothing_to_install(inputs: &GateInputs<'_>) -> bool","         workspace_manifest,","         workspace_root,","         lockfile_root,","+        ..","     } = *inputs;","     if manifest.path().parent() != Some(lockfile_root)","         || project_has_install_work(config, manifest)"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace/src/lib.rs","lines":["@@ -31,10 +31,10 @@ pub use project_manifest::{","     safe_read_project_manifest_only, try_read_project_manifest,"," };"," pub use projects::{","-    FindWorkspaceProjectsError, FindWorkspaceProjectsOpts, Project, ProjectManifestPaths,","-    belongs_to_workspace, find_workspace_project_manifests, find_workspace_projects,","-    find_workspace_projects_no_check, is_workspace_project_dir, needs_package_patterns,","-    read_workspace_projects,","+    DiscoveryKey, FindWorkspaceProjectsError, FindWorkspaceProjectsOpts, Project,","+    ProjectManifestPaths, belongs_to_workspace, find_workspace_project_manifests,","+    find_workspace_projects, find_workspace_projects_no_check, is_workspace_project_dir,","+    needs_package_patterns, read_workspace_projects,"," };"," pub use projects_graph_view::GraphPkg;"," pub use root_finder::{"],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/workspace/src/projects.rs","lines":["@@ -72,6 +72,41 @@ pub struct FindWorkspaceProjectsOpts {","     pub ignored_directories: Vec<PathBuf>,"," }"," ","+impl FindWorkspaceProjectsOpts {","+    /// What decides which projects [`find_workspace_projects`] finds under","+    /// `workspace_root` with these options. Ignored directories the walk","+    /// skips by name anyway are left out, unless an include pattern names","+    /// such a directory itself.","+    #[must_use]","+    pub fn discovery_key(&self, workspace_root: &Path) -> DiscoveryKey {","+        let ignored_directories = if self.patterns_name_skipped_directories() {","+            resolve_ignored_directories(workspace_root, &self.ignored_directories)","+        } else {","+            ignored_directories_beyond_the_walk(workspace_root, &self.ignored_directories)","+        };","+        DiscoveryKey { patterns: self.patterns.clone(), ignored_directories }","+    }","+","+    fn patterns_name_skipped_directories(&self) -> bool {","+        self.patterns","+            .iter()","+            .flatten()","+            .filter(|pattern| !pattern.starts_with('!'))","+            .any(|pattern| {","+                let pattern = pattern.to_ascii_lowercase();","+                pattern.contains(\"node_modules\") || pattern.contains(\"bower_components\")","+            })","+    }","+}","+","+/// Equal for two sets of options with which [`find_workspace_projects`]","+/// finds the same projects. See [`FindWorkspaceProjectsOpts::discovery_key`].","+#[derive(Debug, PartialEq, Eq)]","+pub struct DiscoveryKey {","+    patterns: Option<Vec<String>>,","+    ignored_directories: Vec<PathBuf>,","+}","+"," /// Error type of the public entry points."," #[derive(Debug, Display, Error, Diagnostic)]"," #[non_exhaustive]","@@ -383,7 +418,7 @@ struct WorkspacePattern<'source> {"," }"," "," mod managed;","-use managed::resolve_ignored_directories;","+use managed::{ignored_directories_beyond_the_walk, resolve_ignored_directories};"," "," mod membership;"," mod negations;"],"additions":36,"deletions":1,"truncated":false},{"path":"pnpm/crates/workspace/src/projects/managed.rs","lines":["@@ -2,8 +2,8 @@"," //! discovery never reports projects from. See"," //! [`FindWorkspaceProjectsOpts::ignored_directories`](super::FindWorkspaceProjectsOpts::ignored_directories)."," ","-use super::{Path, PathBuf};","-use std::path::Component;","+use super::{Path, PathBuf, walk::is_always_ignored_name};","+use std::{ffi::OsStr, fs, path::Component};"," "," /// Whether `path` sits under one of the directories returned by"," /// [`resolve_ignored_directories`]. `path` is normalized lexically first:","@@ -64,3 +64,42 @@ pub(super) fn resolve_ignored_directories(","         .filter(|dir| !starts_with_directory(&workspace_root, dir))","         .collect()"," }","+","+/// [`resolve_ignored_directories`] without the directories the walk skips","+/// by name anyway. The walk still receives them all.","+pub(super) fn ignored_directories_beyond_the_walk(","+    workspace_root: &Path,","+    ignored_directories: &[PathBuf],","+) -> Vec<PathBuf> {","+    let root = pnpm_fs::lexical_normalize(workspace_root);","+    resolve_ignored_directories(workspace_root, ignored_directories)","+        .into_iter()","+        .filter(|dir| !walk_skips_by_name(&root, dir))","+        .collect()","+}","+","+/// Whether `dir` sits under a `node_modules` or `bower_components` that the","+/// walk's name check recognizes: one spelled that way on disk, or one that","+/// does not exist. On a case-insensitive filesystem the configured spelling","+/// can name a directory spelled otherwise, which only the exclusion skips."],"additions":20,"deletions":2,"truncated":false}],"additions":444,"deletions":37,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-04T16:05:06.447819+00:00"}