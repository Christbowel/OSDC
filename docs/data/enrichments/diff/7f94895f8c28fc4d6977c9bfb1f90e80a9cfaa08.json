{"id":"7f94895f8c28fc4d6977c9bfb1f90e80a9cfaa08","axis":"silent","repo":"withastro/astro","sha":"7f94895f8c28fc4d6977c9bfb1f90e80a9cfaa08","parsed":{"files":[{"path":".changeset/logger-relative-entrypoint.md","lines":["@@ -0,0 +1,21 @@","+---","+'astro': minor","+---","+","+Adds support for paths relative to your project root in `logger.entrypoint`","+","+Previously, pointing `logger.entrypoint` at a custom log handler living in your own project required building an absolute `URL`. You can now write the path directly:","+","+```diff","+// astro.config.mjs","+import { defineConfig } from 'astro/config';","+","+export default defineConfig({","+  logger: {","+-    entrypoint: new URL('./src/logger.js', import.meta.url),","++    entrypoint: './src/logger.js',","+  },","+});","+```","+","+Paths starting with `./` or `../` are resolved against your project root. Package specifiers such as `@org/astro-logger`, absolute paths, and `URL` entrypoints keep working as before."],"additions":21,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/logger/config.ts","lines":["@@ -1,6 +1,6 @@"," export interface LoggerHandlerConfig {"," \t/** Serializable options used by the driver implementation */"," \tconfig?: Record<string, any> | undefined;","-\t/** URL or package import */","+\t/** A package import, a path relative to the project root, or a URL */"," \tentrypoint: string | URL;"," }"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/logger/load.ts","lines":["@@ -20,8 +20,8 @@ import {","  * while the Vite one *generates code* doing so, to bundle the handler into the build output.","  */"," async function createDestination(config: NormalizedLoggerConfig): Promise<AstroLoggerDestination> {","-\t// `normalizeLoggerConfig()` turns `URL` entrypoints into absolute paths, which","-\t// `import()` only accepts as file URLs on Windows. Package entrypoints keep their","+\t// `normalizeLoggerConfig()` turns `URL` and relative entrypoints into absolute paths,","+\t// which `import()` only accepts as file URLs on Windows. Package entrypoints keep their"," \t// specifier and resolve through the regular module resolution."," \tconst specifier = isAbsolute(config.entrypoint)"," \t\t? pathToFileURL(config.entrypoint).href","@@ -42,8 +42,10 @@ async function createDestination(config: NormalizedLoggerConfig): Promise<AstroL","  */"," export async function loadLoggerDestination("," \tconfig: LoggerHandlerConfig,","+\t/** The project root, which relative entrypoints are resolved against */","+\troot: URL,"," ): Promise<AstroLoggerDestination> {","-\tconst normalized = normalizeLoggerConfig(config);","+\tconst normalized = normalizeLoggerConfig(config, root);"," "," \ttry {"," \t\treturn await createDestination(normalized);","@@ -76,7 +78,7 @@ export async function loadOrCreateNodeLogger("," \ttry {"," \t\tif (astroConfig.logger) {"," \t\t\treturn new AstroLogger({","-\t\t\t\tdestination: await loadLoggerDestination(astroConfig.logger),","+\t\t\t\tdestination: await loadLoggerDestination(astroConfig.logger, astroConfig.root),"," \t\t\t\tlevel: inlineAstroConfig.logLevel ?? 'info',"," \t\t\t});"," \t\t} else {"],"additions":6,"deletions":4,"truncated":false},{"path":"packages/astro/src/core/logger/utils.ts","lines":["@@ -1,4 +1,6 @@","+import { resolve } from 'node:path';"," import { fileURLToPath } from 'node:url';","+import { isRelativePath } from '../path.js';"," import type { LoggerHandlerConfig } from './config.js';"," "," export const COMPOSE_LOGGER_ENTRYPOINT = 'astro/logger/compose';","@@ -18,24 +20,39 @@ export interface NormalizedLoggerConfig {","  * (see `loadLoggerDestination`), and by applying the same treatment to the handlers","  * composed through `astro/logger/compose`.","  *","- * Concretely, a `URL` entrypoint becomes an absolute file path — mirroring what session","- * drivers do, since both Vite and `import()` can handle those — while a string entrypoint,","- * e.g. a package specifier, is left untouched.","+ * Concretely, `URL` and relative entrypoints become absolute file paths — mirroring what","+ * session drivers do, since both Vite and `import()` can handle those — while any other","+ * string entrypoint, e.g. a package specifier, is left untouched.","  */","-export function normalizeLoggerConfig(logger: LoggerHandlerConfig): NormalizedLoggerConfig {","-\tconst entrypoint = normalizeEntrypoint(logger.entrypoint);","+export function normalizeLoggerConfig(","+\tlogger: LoggerHandlerConfig,","+\t/** The project root, which relative entrypoints are resolved against */","+\troot: URL,","+): NormalizedLoggerConfig {","+\tconst entrypoint = normalizeEntrypoint(logger.entrypoint, root);"," "," \tif (entrypoint === COMPOSE_LOGGER_ENTRYPOINT) {"," \t\tconst loggers: LoggerHandlerConfig[] = logger.config?.loggers ?? [];"," \t\treturn {"," \t\t\tentrypoint,","-\t\t\tloggers: loggers.map((nested) => normalizeLoggerConfig(nested)),","+\t\t\tloggers: loggers.map((nested) => normalizeLoggerConfig(nested, root)),"," \t\t};"," \t}"," "," \treturn { entrypoint, config: logger.config };"," }"," ","-function normalizeEntrypoint(entrypoint: LoggerHandlerConfig['entrypoint']): string {","-\treturn entrypoint instanceof URL ? fileURLToPath(entrypoint) : entrypoint;","+function normalizeEntrypoint(entrypoint: LoggerHandlerConfig['entrypoint'], root: URL): string {","+\tif (entrypoint instanceof URL) {","+\t\treturn fileURLToPath(entrypoint);","+\t}","+","+\t// A relative specifier would otherwise be resolved against whichever module happens to","+\t// import it — astro core for `import()`, the importer passed to Vite's resolver — so it","+\t// is anchored to the project root instead, like every other path in the Astro config.","+\tif (isRelativePath(entrypoint)) {","+\t\treturn resolve(fileURLToPath(root), entrypoint);","+\t}","+","+\treturn entrypoint;"," }"],"additions":25,"deletions":8,"truncated":false},{"path":"packages/astro/src/core/logger/vite-plugin.ts","lines":["@@ -105,7 +105,7 @@ export function vitePluginLogger({"," \t\t\t\t// resolve from the project's node_modules, not from astro core's location."," \t\t\t\tconst importerPath = fileURLToPath(new URL('package.json', settings.config.root));"," \t\t\t\tconst { expression, imports } = await emitDestination(","-\t\t\t\t\tnormalizeLoggerConfig(loggerConfig),","+\t\t\t\t\tnormalizeLoggerConfig(loggerConfig, settings.config.root),"," \t\t\t\t\tasync (entrypoint) => (await this.resolve(entrypoint, importerPath))?.id ?? null,"," \t\t\t\t);"," "],"additions":1,"deletions":1,"truncated":false},{"path":"packages/astro/src/integrations/hooks.ts","lines":["@@ -352,7 +352,9 @@ export async function runHookConfigSetup({"," \t\ttry {"," \t\t\tupdatedConfig = await validateConfigRefined(updatedConfig);"," \t\t\tif (isLoggerUpdated) {","-\t\t\t\tlogger.setDestination(await loadLoggerDestination(updatedConfig.logger!));","+\t\t\t\tlogger.setDestination(","+\t\t\t\t\tawait loadLoggerDestination(updatedConfig.logger!, updatedConfig.root),","+\t\t\t\t);"," \t\t\t}"," \t\t} catch (error) {"," \t\t\tintegrationLogger.error('An error occurred while updating the config');"],"additions":3,"deletions":1,"truncated":false},{"path":"packages/astro/src/types/public/config.ts","lines":["@@ -1623,7 +1623,8 @@ export interface AstroUserConfig<"," \t * @description"," \t *"," \t * The entrypoint for the [logger implementation](https://docs.astro.build/en/reference/logger-reference/#the-logger-implementation).","-\t * This can be an npm package, or a `URL` pointing to a file in your project:","+\t * This can be an npm package, a path relative to your project root, or a `URL` pointing to a","+\t * file in your project:"," \t *"," \t * ```js title=\"astro.config.mjs\""," \t * import { defineConfig } from 'astro/config';"],"additions":2,"deletions":1,"truncated":false},{"path":"packages/astro/test/fixtures/ssr-assets/src/logger.mjs","lines":["@@ -0,0 +1,6 @@","+// Used by `test/logger.test.ts` to check that a `logger.entrypoint` given as a path","+// relative to the project root is resolved and bundled. `__relative` lets the test assert","+// this module was actually used, rather than a built-in fallback.","+export default function () {","+\treturn { __relative: true, write() {} };","+}"],"additions":6,"deletions":0,"truncated":false},{"path":"packages/astro/test/logger.test.ts","lines":["@@ -57,4 +57,33 @@ describe('Logger', () => {"," \t\t\tassert.equal(destination.__custom, true, 'Should use the custom logger');"," \t\t});"," \t});","+","+\t// A path relative to the project root, resolved the same way whether the destination is","+\t// instantiated by Node at build time or bundled into the server output by Vite.","+\tdescribe('relative entrypoint', () => {","+\t\tlet fixture: Fixture;","+","+\t\tbefore(async () => {","+\t\t\tfixture = await loadFixture({","+\t\t\t\troot: './fixtures/ssr-assets/',","+\t\t\t\toutDir: './dist/logger-relative-entrypoint/',","+\t\t\t\tcacheDir: './node_modules/.astro-test/logger-relative-entrypoint/',","+\t\t\t\toutput: 'server',","+\t\t\t\tadapter: testAdapter(),","+\t\t\t\tlogger: { entrypoint: './src/logger.mjs' },","+\t\t\t});","+\t\t\tawait fixture.build();","+\t\t});","+","+\t\tit('bundles and uses the custom logger at runtime (SSR)', async () => {","+\t\t\tconst app = await fixture.loadTestAdapterApp();","+\t\t\tconst response = await app.render(new Request('http://example.com/'));","+\t\t\tassert.equal(response.status, 200);","+","+\t\t\tconst destination = app.logger.options.destination;","+\t\t\tassert.ok(destination, 'Logger destination should exist');","+\t\t\t// @ts-expect-error __relative is not part of the destination type","+\t\t\tassert.equal(destination.__relative, true, 'Should use the custom logger');","+\t\t});","+\t});"," });"],"additions":29,"deletions":0,"truncated":false},{"path":"packages/astro/test/units/logger/load.test.ts","lines":["@@ -4,39 +4,74 @@ import { loadLoggerDestination } from '../../../dist/core/logger/load.js';"," "," // A real logger impl module on disk whose default export returns a destination."," const CONSOLE_IMPL_URL = new URL('../../../dist/core/logger/impls/console.js', import.meta.url);","+// Stands in for a project root. Deliberately *not* the directory holding `load.js`, so that","+// a relative entrypoint resolved against the wrong base — `import()` resolves relative","+// specifiers against the importing module — cannot accidentally point at a real file.","+const ROOT = new URL('../../../dist/core/', import.meta.url);"," "," describe('loadLoggerDestination', () => {"," \tit('loads a custom logger destination from a string entrypoint', async () => {","-\t\tconst destination = await loadLoggerDestination({ entrypoint: CONSOLE_IMPL_URL.href });","+\t\tconst destination = await loadLoggerDestination({ entrypoint: CONSOLE_IMPL_URL.href }, ROOT);"," \t\tassert.equal(typeof destination.write, 'function');"," \t});"," "," \tit('loads a custom logger destination from a URL entrypoint', async () => {","-\t\tconst destination = await loadLoggerDestination({ entrypoint: CONSOLE_IMPL_URL });","+\t\tconst destination = await loadLoggerDestination({ entrypoint: CONSOLE_IMPL_URL }, ROOT);","+\t\tassert.equal(typeof destination.write, 'function');","+\t});","+","+\tit('loads a custom logger destination from a relative entrypoint', async () => {","+\t\tconst destination = await loadLoggerDestination(","+\t\t\t{ entrypoint: './logger/impls/console.js' },","+\t\t\tROOT,","+\t\t);","+\t\tassert.equal(typeof destination.write, 'function');","+\t});","+","+\tit('loads a custom logger destination from an entrypoint above the root', async () => {","+\t\tconst destination = await loadLoggerDestination(","+\t\t\t{ entrypoint: '../core/logger/impls/console.js' },","+\t\t\tROOT,","+\t\t);"," \t\tassert.equal(typeof destination.write, 'function');"," \t});"," "," \tit('loads a built-in logger destination from a package entrypoint', async () => {","-\t\tconst destination = await loadLoggerDestination({ entrypoint: 'astro/logger/json' });","+\t\tconst destination = await loadLoggerDestination({ entrypoint: 'astro/logger/json' }, ROOT);"," \t\tassert.equal(typeof destination.write, 'function');"," \t});"," "," \tit('loads composed logger destinations', async () => {","-\t\tconst destination = await loadLoggerDestination({","-\t\t\tentrypoint: 'astro/logger/compose',","-\t\t\tconfig: {","-\t\t\t\tloggers: [{ entrypoint: CONSOLE_IMPL_URL }, { entrypoint: 'astro/logger/json' }],","+\t\tconst destination = await loadLoggerDestination(","+\t\t\t{","+\t\t\t\tentrypoint: 'astro/logger/compose',","+\t\t\t\tconfig: {","+\t\t\t\t\tloggers: [{ entrypoint: CONSOLE_IMPL_URL }, { entrypoint: './logger/impls/json.js' }],","+\t\t\t\t},"," \t\t\t},","-\t\t});","+\t\t\tROOT,","+\t\t);"," \t\tassert.equal(typeof destination.write, 'function');"," \t});"," "," \tit('throws with the resolved path when a URL entrypoint cannot be loaded', async () => {"," \t\tconst missing = new URL('../../../dist/core/logger/impls/does-not-exist.js', import.meta.url);","-\t\tawait assert.rejects(loadLoggerDestination({ entrypoint: missing }), (error: Error) => {","+\t\tawait assert.rejects(loadLoggerDestination({ entrypoint: missing }, ROOT), (error: Error) => {"," \t\t\t// The error message should surface the normalized path, not \"[object URL]\"."," \t\t\tassert.match(error.message, /does-not-exist\\.js/);"," \t\t\treturn true;"," \t\t});"," \t});","+","+\tit('throws with the resolved path when a relative entrypoint cannot be loaded', async () => {","+\t\tawait assert.rejects(","+\t\t\tloadLoggerDestination({ entrypoint: './logger/does-not-exist.js' }, ROOT),","+\t\t\t(error: Error) => {","+\t\t\t\t// The path is reported as resolved against the root, so it says where Astro looked.","+\t\t\t\tassert.match(error.message, /logger[\\\\/]does-not-exist\\.js/);","+\t\t\t\tassert.doesNotMatch(error.message, /\"\\.\\//);","+\t\t\t\treturn true;","+\t\t\t},","+\t\t);","+\t});"," });"],