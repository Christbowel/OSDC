malized.loggers?.[0].entrypoint, join(ROOT_PATH, 'src', 'logger.mjs'));","+\t\tassert.equal(","+\t\t\tnormalized.loggers?.[1].loggers?.[0].entrypoint,","+\t\t\tjoin(ROOT_PATH, 'src', 'nested-logger.mjs'),","+\t\t);","+\t});","+"," \tit('normalizes a composed logger without children', () => {","-\t\tconst normalized = normalizeLoggerConfig({ entrypoint: 'astro/logger/compose' });","+\t\tconst normalized = normalizeLoggerConfig({ entrypoint: 'astro/logger/compose' }, ROOT);"," \t\tassert.deepEqual(normalized.loggers, []);"," \t});"," });",""],"additions":69,"deletions":14,"truncated":false}],"additions":207,"deletions":39,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-08-06T10:23:46.814126+00:00"}