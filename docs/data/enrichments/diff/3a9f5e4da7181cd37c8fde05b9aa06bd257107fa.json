"     }"," ","+    /**","+     * Uncompressed length for gzip (from the ISIZE trailer), so plain and gzipped extract sets","+     * agree on lengths and min/max filtering; on-disk length for everything else.","+     */","+    public static long extractLength(Path extractFile) throws IOException {","+        long onDisk = Files.size(extractFile);","+        String name = extractFile.getFileName().toString().toLowerCase(Locale.ROOT);","+        if (onDisk < 18 || !(name.endsWith(\".gz\") || name.endsWith(\".gzip\"))) {","+            return onDisk;","+        }","+        ByteBuffer trailer = ByteBuffer.allocate(4).order(ByteOrder.LITTLE_ENDIAN);","+        try (FileChannel ch = FileChannel.open(extractFile, StandardOpenOption.READ)) {","+            while (trailer.hasRemaining()) {","+                if (ch.read(trailer, onDisk - 4 + trailer.position()) < 0) {","+                    return onDisk;","+                }","+            }","+        }","+        long isize = trailer.getInt(0) & 0xFFFFFFFFL;","+        // smaller than even stored blocks could yield: wrapped past 4 GiB or multi-member","+        if (isize + (onDisk >> 10) + 64 < onDisk) {","+            return onDisk;","+        }","+        return isize;","+    }","+","     public List<Metadata> loadExtract(Path extractFile) throws ExtractReaderException {"," ","         List<Metadata> metadataList = null;","@@ -112,7 +142,7 @@ public List<Metadata> loadExtract(Path extractFile) throws ExtractReaderExceptio"," ","         long length = -1L;","         try {","-            length = Files.size(extractFile);","+            length = extractLength(extractFile);","         } catch (IOException e) {","             throw new ExtractReaderException(ExtractReaderException.TYPE.IO_EXCEPTION, e);","         }"],"additions":31,"deletions":1,"truncated":false},{"path":"tika-eval/tika-eval-app/src/test/java/org/apache/tika/eval/app/ComparerGzipExtractsTest.java","lines":["@@ -0,0 +1,97 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one or more","+ * contributor license agreements.  See the NOTICE file distributed with","+ * this work for additional information regarding copyright ownership.","+ * The ASF licenses this file to You under the Apache License, Version 2.0","+ * (the \"License\"); you may not use this file except in compliance with","+ * the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.apache.tika.eval.app;","+","+import static org.junit.jupiter.api.Assertions.assertEquals;","+","+import java.io.IOException;","+import java.io.OutputStream;","+import java.nio.file.Files;","+import java.nio.file.Path;","+import java.nio.file.Paths;","+import java.sql.Connection;","+import java.sql.ResultSet;","+import java.sql.Statement;","+import java.util.ArrayList;","+import java.util.List;","+import java.util.stream.Stream;","+import java.util.zip.GZIPOutputStream;","+","+import org.apache.commons.io.FileUtils;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.io.TempDir;","+","+import org.apache.tika.eval.app.db.H2Util;","+","+/** A gzipped extract set ({@code .json.gz}, as the file-system emitter writes it) compares like its plain twin. */","+public class ComparerGzipExtractsTest {","+","+    private static final String[] QUERIES = {","+            \"select file_path || ' ' || extract_file_length_a || ' ' || extract_file_length_b\"","+                    + \" from containers order by file_path\",","+            \"select count(1) from profiles_a\",","+            \"select count(1) from profiles_b\",","+            \"select count(1) from extract_exceptions_a\",","+            \"select count(1) from extract_exceptions_b\",","+            \"select count(1) from content_comparisons\"","+    };","+","+    @TempDir","+    Path tmp;","+","+    @Test","+    public void testGzipOnEitherSide() throws Exception {","+        Path testDirs = Paths.get(getClass().getResource(\"/test-dirs\").toURI());","+        Path a = testDirs.resolve(\"extractsA\");","+        Path b = testDirs.resolve(\"extractsB\");","+        List<String> plain = compare(\"plain\", a, b);","+        assertEquals(plain, compare(\"gzB\", a, gzipCopy(b, tmp.resolve(\"bGz\"))), \"gzipped B\");","+        assertEquals(plain, compare(\"gzA\", gzipCopy(a, tmp.resolve(\"aGz\")), b), \"gzipped A\");","+    }","+","+    private List<String> compare(String name, Path a, Path b) throws Exception {","+        Path db = tmp.resolve(name);","+        ExtractComparerRunner.main(new String[]{","+                \"-a\", a.toString(), \"-b\", b.toString(), \"-d\", db.toAbsolutePath().toString()","+        });","+        List<String> results = new ArrayList<>();","+        try (Connection c = new H2Util(db).getConnection(); Statement st = c.createStatement()) {","+            for (String q : QUERIES) {","+                try (ResultSet rs = st.executeQuery(q)) {","+                    while (rs.next()) {","+                        results.add(q + \" -> \" + rs.getString(1));","+                    }","+                }","+            }","+        }","+        return results;","+    }","+","+    private static Path gzipCopy(Path src, Path dest) throws IOException {","+        FileUtils.copyDirectory(src.toFile(), dest.toFile());","+        try (Stream<Path> files = Files.walk(dest)) {","+            for (Path p : files.filter(f -> f.toString().endsWith(\".json\")).toList()) {","+                try (OutputStream os = new GZIPOutputStream(","+                        Files.newOutputStream(p.resolveSibling(p.getFileName() + \".gz\")))) {","+   