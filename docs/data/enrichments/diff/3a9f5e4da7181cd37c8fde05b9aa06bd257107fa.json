  if (onExists == FileSystemEmitterConfig.ON_EXISTS.EXCEPTION) {","+                    throw alreadyExistsException(output);","+                }","+            }","+            return;","+        }","         if (onExists == FileSystemEmitterConfig.ON_EXISTS.REPLACE) {","             Files.copy(inputStream, output, StandardCopyOption.REPLACE_EXISTING);","             return;","@@ -275,7 +340,8 @@ private FileSystemEmitterConfig getConfig(ParseContext parseContext) throws Tika","         if (parseContext.hasJsonConfig(configKey)) {","             JsonConfig configJson = parseContext.getJsonConfig(configKey);","             if (configJson != null) {","-                // basePath, allowAbsolutePaths and atomicWrites are not runtime keys; naming one fails","+                // basePath, allowAbsolutePaths, atomicWrites and compression are not runtime keys;","+                // naming one fails","                 FileSystemEmitterRuntimeConfig runtimeConfig =","                         PluginJson.read(configJson, FileSystemEmitterRuntimeConfig.class);"," ","@@ -283,7 +349,7 @@ private FileSystemEmitterConfig getConfig(ParseContext parseContext) throws Tika","                 // init-time allowAbsolutePaths -- neither may be changed at runtime.","                 config = new FileSystemEmitterConfig(fileSystemEmitterConfig.basePath(), runtimeConfig.getFileExtension(), runtimeConfig.getOnExists(),","                         runtimeConfig.isPrettyPrint(), fileSystemEmitterConfig.allowAbsolutePaths(),","-                        fileSystemEmitterConfig.atomicWrites());","+                        fileSystemEmitterConfig.atomicWrites(), fileSystemEmitterConfig.compression());","                 checkConfig(config);","             }","         }"],"additions":79,"deletions":13,"truncated":false},{"path":"tika-pipes/tika-pipes-plugins/tika-pipes-file-system/src/main/java/org/apache/tika/pipes/emitter/fs/FileSystemEmitterConfig.java","lines":["@@ -20,13 +20,20 @@"," import org