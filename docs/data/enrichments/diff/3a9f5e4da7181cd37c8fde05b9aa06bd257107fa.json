osesFileWhenFinishFails() throws Exception {","+        boolean[] closed = {false};","+        // room for the 10-byte header only, so finish() hits the full disk","+        OutputStream full = new OutputStream() {","+            int written;","+","+            @Override","+            public void write(int b) throws IOException {","+                if (++written > 10) {","+                    throw new IOException(\"No space left on device\");","+                }","+            }","+","+            @Override","+            public void close() {","+                closed[0] = true;","+            }","+        };","+        OutputStream gz = FileSystemEmitter.gzip(full);","+        assertThrows(IOException.class, gz::close);","+        assertTrue(closed[0]);","+    }"," }",""],"additions":90,"deletions":0,"truncated":false}],"additions":328,"deletions":20,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-22T13:46:26.015015+00:00"}