):","     # `external/py_windows_x86_64/dist`. Bazel sets the action's CWD to","     # the execroot on Windows, so the launcher's DLL search finds","     # `python313.dll` in this directory.","-    return {\"PATH\": interpreter.dirname}","+    #","+    # PYTHONHOME is also needed because rules_python can launch the interpreter","+    # through a manifest-only runfiles alias. Without it, CPython derives its","+    # stdlib location from that alias and cannot find encodings before the","+    # action's PYTHONPATH is processed.","+    return {","+        \"PATH\": interpreter.dirname,","+        \"PYTHONHOME\": interpreter.dirname,","+    }"," "," def py_exec_import_paths(ctx, py_deps):","     \"\"\"Exec-tree PYTHONPATH entries for exec-configured python deps.","@@ -110,3 +130,17 @@ def py_exec_import_paths(ctx, py_deps):","             if candidate not in python_path:","                 python_path.append(candidate)","     return python_path","+","+def py_action_env_pythonpath(ctx, python_binary, runfiles_package_dir):","+    \"\"\"Returns a PYTHONPATH containing a Python binary and its dependencies.","+","+    Custom actions that invoke a py_binary directly do not get the import path","+    setup performed by the standard rules_python launcher. Include the binary's","+    runfiles package directory and its exec-configured dependency imports so","+    those actions work when Windows runfiles are manifest-only.","+    \"\"\"","+    python_path = [runfiles_package_dir] + py_exec_import_paths(ctx, [python_binary])","+    python = ctx.toolchains[\"@rules_python//python:toolchain_type\"].py3_runtime","+    return {","+        \"PYTHONPATH\": py_runtime_pythonpath(python, python_path),","+    }"],"additions":36,"deletions":2,"truncated":false},{"path":"bazel/config/py_action_env_test.bzl","lines":["@@ -0,0 +1,50 @@","+load(\"@bazel_skylib//lib:unittest.bzl\", \"analysistest\", \"asserts\", \"unittest\")","+load(\"@rules_python//python:py_info.bzl\", \"PyInfo\")","+load(\":py_action_env.bzl\", \"py_action_env_pythonpath\", \"py_runtime_pythonpath\")","+","+def _runtime_pythonpath_test_impl(ctx):","+    env = unittest.begin(ctx)","+    paths = [\"bazel-out\\\\exec\\\\asn1crypto\", \"bazel-out\\\\exec\\\\cryptography\"]","+    linux_python = struct(interpreter = struct(extension = \"\"))","+    windows_python = struct(interpreter = struct(extension = \"exe\"))","+    asserts.equals(env, \"bazel-out/exec/asn1crypto:bazel-out/exec/cryptography\", py_runtime_pythonpath(linux_python, paths))","+    asserts.equals(env, \"bazel-out/exec/asn1crypto;bazel-out/exec/cryptography\", py_runtime_pythonpath(windows_python, paths))","+    binary = {","+        PyInfo: struct(","+            imports = depset([\"dependency/site-packages\"]),","+            transitive_sources = depset([struct(path = \"bazel-out/exec/bin/external/dependency/lib.py\")]),","+        ),","+    }","+    for runtime, host_separator, expected in [","+        (linux_python, \";\", \"runfiles/package:bazel-out/exec/bin/external/dependency/site-packages\"),","+        (windows_python, \":\", \"runfiles/package;bazel-out/exec/bin/external/dependency/site-packages\"),","+    ]:","+        context = struct(","+            configuration = struct(host_path_separator = host_separator),","+            toolchains = {\"@rules_python//python:toolchain_type\": struct(py3_runtime = runtime)},","+        )","+        asserts.equals(env, expected, py_action_env_pythonpath(context, binary, \"runfiles/package\")[\"PYTHONPATH\"])","+    return unittest.end(env)","+","+runtime_pythonpath_test = unittest.make(_runtime_pythonpath_test_impl)","+","+def _template_renderer_python_path_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    actions = [","+        action","+        for action in analysistest.target_actions(env)","+        if action.mnemonic == \"TemplateRenderer\"","+    ]","+    asserts.equals(env, 1, len(actions))","+","+    python_path = actions[0].env.get(\"PYTHONPATH\", \"\")","+    asserts.true(","+        env,","+        \"pyyaml@\" in python_path and \"site-packages\" in python_path,","+        \"TemplateRenderer PYTHONPATH must include the pyyaml wheel import path\",","+    )","+    return analysistest.end(env)","+","+template_renderer_python_path_analysis_test = analysistest.make(","+    _template_renderer_python_path_test_impl,","+)"],"additions":50,"deletions":0,"truncated":false},{"path":"bazel/config/python_genrule.bzl","lines":["@@ -1,5 +1,5 @@"," load(\"//bazel:utils.bzl\", \"write_target\")","-load(\"//bazel/config:py_action_env.bzl\", \"py_action_env_windows_dll_path\")","+load(\"//bazel/config:py_action_env.bzl\", \"py_action_env_pythonpath\", \"py_action_env_windows_dll_path\")"," load(\"@bazel_skylib//rules:common_settings.bzl\", \"BuildSettingInfo\")"," load(\"@rules_python//python:defs.bzl\", \"py_binary\")"," ","@@ -11,7 +11,7 @@ def python_genrule_impl(ctx):"," ","     # Add runfiles package dir to PYTHONPATH so scripts can import python_libs (e.g. gen_helper).","     runfiles_package_dir = ctx.executable.python_binary.path + \".runfiles/\" + ctx.workspace_name + \"/\" + ctx.label.package","-    env = {\"PYTHONPATH\": runfiles_package_dir}","+    env = py_action_env_pythonpath(ctx, ctx.attr.python_binary, runfiles_package_dir)","     env.update(py_action_env_windows_dll_path(ctx))","     windows_cross_host_path = ctx.attr._windows_cross_host_path[BuildSettingInfo].value","     if windows_cross_host_path:"],"additions":2,"deletions":2,"truncated":false},{"path":"bazel/config/render_template.bzl","lines":["@@ -1,10 +1,10 @@"," load(\"//bazel:utils.bzl\", \"write_target\")","-load(\"//bazel/config:py_action_env.bzl\", \"py_action_env_windows_dll_path\")","+load(\"//bazel/config:py_action_env.bzl\", \"py_action_env_pythonpath\", \"py_action_env_windows_dll_path\")"," load(\"@bazel_skylib//rules:common_settings.bzl\", \"BuildSettingInfo\")"," load(\"@rules_python//python:defs.bzl\", \"py_binary\")"," "," def _python_action_env