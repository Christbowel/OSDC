{"id":"59d521393ed42bf4a788af2d81718d3ebffe2007","axis":"silent","repo":"electron/electron","sha":"59d521393ed42bf4a788af2d81718d3ebffe2007","parsed":{"files":[{"path":"docs/api/command-line-switches.md","lines":["@@ -392,6 +392,13 @@ Finally, you'll need to ensure that the version of Chromium in Electron matches","   [`long-animation-frame`](https://developer.mozilla.org/en-US/docs/Web/API/Performance_API/Long_animation_frame_timing)","   `PerformanceObserver` events for non-http(s), non-data, non-blob URLs (such as `file:` or custom","   protocol URLs).","+* `SpareRendererForSitePerProcess`: keeps a spare renderer process running at all times so","+  that a new window, or a navigation that needs a new process, does not wait for a process to","+  launch. Electron starts one such process when the default session is created, for the first","+  sandboxed window that uses it; enable this if the app opens windows regularly and the memory of an","+  idle renderer is acceptable. Only windows whose `webPreferences` are sandboxed and set none of `additionalArguments`,","+  `enableBlinkFeatures`, `disableBlinkFeatures`, `experimentalFeatures`, `offscreen` or (macOS)","+  `scrollBounce` can use it."," "," [app]: app.md"," [append-switch]: command-line.md#commandlineappendswitchswitch-value"],"additions":7,"deletions":0,"truncated":false},{"path":"patches/chromium/.patches","lines":["@@ -160,3 +160,4 @@ dbus_let_embedders_exit_cleanly_when_the_bus_connection_is_lost.patch"," chore_let_the_embedder_handle_shared_d-bus_disconnects.patch"," remove_cr_xcode_build_define_from_build_gn.patch"," fix_wayland_window_stuck_maximized_after_early_maximize.patch","+fix_register_the_spare_renderer_before_initializing_it.patch"],"additions":1,"deletions":0,"truncated":false},{"path":"patches/chromium/fix_register_the_spare_renderer_before_initializing_it.patch","lines":["@@ -0,0 +1,40 @@","+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","+From: Shelley Vohr <shelley.vohr@gmail.com>","+Date: Mon, 24 Aug 2026 07:19:20 +0000","+Subject: fix: register the spare renderer before initializing it","+","+SpareRenderProcessHostManagerImpl added a new spare to spare_rphs_ only","+after RenderProcessHost::Init(), so RenderProcessHost::IsSpare() was","+false while the process launched, including in","+ContentBrowserClient::AppendExtraCommandLineSwitches(). Electron decides","+a renderer's switches per WebContents there and needs to recognise the","+spare, which has none. Push it onto the list first; nothing between the","+two calls reads the list.","+","+Upstreamed at https://chromium-review.googlesource.com/c/chromium/src/+/8283216;","+remove once it lands and rolls in.","+","+diff --git a/content/browser/renderer_host/spare_render_process_host_manager_impl.cc b/content/browser/renderer_host/spare_render_process_host_manager_impl.cc","+index b1b0e04561e4ffa3a126b7599c0afb0ce2e385d8..861215e2254e1d19018df0a898fc153be9d1b435 100644","+--- a/content/browser/renderer_host/spare_render_process_host_manager_impl.cc","+@@ -558,8 +558,8 @@ RenderProcessHost* SpareRenderProcessHostManagerImpl::WarmupSpare(","+       RenderProcessHostImpl::CreateSpareRenderProcessHost(","+           browser_context, nullptr /* site_instance */);","+   new_spare_rph->AddObserver(this);","+-  new_spare_rph->Init();","+   spare_rphs_.push_back(new_spare_rph);","++  new_spare_rph->Init();","+ ","+   // Use the new timeout if there is no previous renderer or","+   // the specified timeout will be triggered after the current timeout","+@@ -1063,8 +1063,8 @@ void SpareRenderProcessHostManagerImpl::MaybeCreateExtraSpare() {","+       RenderProcessHostImpl::CreateSpareRenderProcessHost(","+           browser_context, nullptr /* site_instance */);","+   new_spare_rph->AddObserver(this);","+-  new_spare_rph->Init();","+   spare_rphs_.push_back(new_spare_rph);","++  new_spare_rph->Init();","+ }","+ ","+ void SpareRenderProcessHostManagerImpl::OnMetricsHeartbeatTimerFired() {"],"additions":39,"deletions":0,"truncated":false},{"path":"shell/browser/api/electron_api_session.cc","lines":["@@ -43,6 +43,7 @@"," #include \"content/public/browser/preconnect_manager.h\""," #include \"content/public/browser/preconnect_request.h\""," #include \"content/public/browser/render_process_host.h\"","+#include \"content/public/browser/spare_render_process_host_manager.h\""," #include \"content/public/browser/storage_partition.h\""," #include \"electron/buildflags/buildflags.h\""," #include \"gin/arguments.h\"","@@ -1772,7 +1773,15 @@ Session* Session::FromPartition(v8::Isolate* isolate,","     browser_context =","         ElectronBrowserContext::From(partition, true, std::move(options));","   }","-  return FromOrCreate(isolate, browser_context);","+  const bool creating = !FromBrowserContext(browser_context);","+  Session* session = FromOrCreate(isolate, browser_context);","+  // One renderer started ahead of the first window; the first sandboxed","+  // WebContents takes it (ElectronBrowserClient::ShouldUseSpareRenderProcess-","+  // Host), anything else lets content discard it.","+  if (creating && partition.empty()) {","+    content::SpareRenderProcessHostManager::Get().WarmupSpare(browser_context);","+  }","+  return session;"," }"," "," // static"],"additions":10,"deletions":1,"truncated":false},{"path":"shell/browser/api/electron_api_web_contents.cc","lines":["@@ -14,6 +14,7 @@"," #include <utility>"," #include <vector>"," ","+#include \"base/auto_reset.h\""," #include \"base/base64.h\""," #include \"base/command_line.h\""," #include \"base/containers/fixed_flat_map.h\"","@@ -1005,6 +1006,9 @@ WebContents::WebContents(v8::Isolate* isolate,","     params.starting_sandbox_flags = starting_sandbox_flags;","     params.initially_hidden = !initially_shown;","     params.enable_wake_locks = !disable_wake_locks;","+    base::AutoReset<bool> reset(","+        ElectronBrowserClient::Get()->spare_renderer_compatible(),","+        RendererProcessPreferences::Fro