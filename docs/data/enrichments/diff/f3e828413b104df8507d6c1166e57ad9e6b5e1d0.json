icStorage policy_name(policy, symbol_table);","+","+  // Flat name \"<prefix>.<policy>.<leaf>\", tag-extracted name \"<base>.<leaf>\", policy name tag.","+  const Stats::StatNameJoiner flat_name({prefix.name(), policy_name.statName(), leaf},","+                                        symbol_table);","+  const Stats::StatNameJoiner base_name({prefix.baseName(), leaf}, symbol_table);","+","+  Stats::StatNameTagVec tags(prefix.tags().begin(), prefix.tags().end());","+  tags.emplace_back(names_.policy_tag_, policy_name.statName());","+  scope_.counterFromTaggedName(base_name.statName(), tags, flat_name.statName()).inc();","+}","+"," std::string responseDetail(absl::string_view policy_id) {","   // Replace whitespaces in policy_id with '_' to avoid breaking the access log (inconsistent number","   // of segments between log entries when the separator is whitespace)."],"additions":82,"deletions":13,"truncated":false},{"path":"source/extensions/filters/common/rbac/utility.h","lines":["@@ -4,6 +4,7 @@"," "," #include \"source/common/common/fmt.h\""," #include \"source/common/singleton/const_singleton.h\"","+#include \"source/common/stats/utility.h\""," #include \"source/extensions/filters/common/rbac/engine_impl.h\""," "," namespace Envoy {","@@ -26,6 +27,18 @@ namespace RBAC {","   COUNTER(shadow_allowed)                                                                          \\","   COUNTER(shadow_denied)"," ","+// Pre-encoded constant pieces of the per-policy stat names.","+struct PerPolicyStatNames {","+  explicit PerPolicyStatNames(Stats::SymbolTable& symbol_table);","+","+  Stats::StatNamePool pool_;","+  const Stats::StatName policy_tag_;","+  const Stats::StatName allowed_;","+  const Stats::StatName denied_;","+  const Stats::StatName shadow_allowed_;","+  const Stats::StatName shadow_denied_;","+};","+"," /**","  * Wrapper struct for shadow rules in RBAC filter stats. @see stats_macros.h","  */","@@ -34,37 +47,38 @@ struct RoleBasedAccessControlFilterStats {","  