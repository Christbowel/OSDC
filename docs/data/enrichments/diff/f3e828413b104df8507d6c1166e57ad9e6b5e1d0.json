unter.name());","+  EXPECT_EQ(tag_extracted_name, counter.tagExtractedName());","+  std::vector<std::pair<std::string, std::string>> tags;","+  for (const Stats::Tag& tag : counter.tags()) {","+    tags.emplace_back(tag.name_, tag.value_);","+  }","+  EXPECT_EQ(expected_tags, tags);","+}","+","+TEST(GenerateStats, NetworkFilterPrefixIsTagged) {","+  Stats::IsolatedStoreImpl store;","+  auto stats = generateStats(\"tcp.\", \"rules_\", \"\", false, *store.rootScope());","+","+  expectCounter(stats.allowed_, \"tcp.rbac.rules_.allowed\", \"rbac.allowed\",","+                {{\"envoy.rbac_prefix\", \"tcp\"}, {\"envoy.rbac_rules_prefix\", \"rules_\"}});","+  expectCounter(stats.shadow_allowed_, \"tcp.rbac.shadow_allowed\", \"rbac.shadow_allowed\",","+                {{\"envoy.rbac_prefix\", \"tcp\"}});","+","+  stats.incPolicyAllowed(\"foo\");","+  expectCounter(*TestUtility::findCounter(store, \"tcp.rbac.rules_.policy.foo.allowed\"),","+                \"tcp.rbac.rules_.policy.foo.allowed\", \"rbac.policy.allowed\",","+                {{\"envoy.rbac_prefix\", \"tcp\"},","+                 {\"envoy.rbac_rules_prefix\", \"rules_\"},","+                 {\"envoy.rbac_policy_name\", \"foo\"}});","+}","+","+TEST(GenerateStats, HttpFilterEmptyPrefix) {","+  Stats::IsolatedStoreImpl store;","+  auto stats = generateStats(\"\", \"\", \"shadow_\", true, *store.rootScope());","+","+  expectCounter(stats.allowed_, \"rbac.allowed\", \"rbac.allowed\", {});","+  expectCounter(stats.shadow_allowed_, \"rbac.shadow_.shadow_allowed\", \"rbac.shadow_allowed\",","+                {{\"envoy.rbac_http_prefix\", \"shadow_\"}});","+","+  stats.incPolicyShadowAllowed(\"foo\");","+  expectCounter(*TestUtility::findCounter(store, \"rbac.shadow_.policy.foo.shadow_allowed\"),","+                \"rbac.shadow_.policy.foo.shadow_allowed\", \"rbac.policy.shadow_allowed\",","+                {{\"envoy.rbac_http_prefix\", \"shadow_\"}, {\"envoy.rbac_policy_name\", \"foo\"}});","+}","+","+TEST(GenerateSt