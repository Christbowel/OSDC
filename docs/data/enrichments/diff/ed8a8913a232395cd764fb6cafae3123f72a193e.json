ows;","+    }","+","+    public boolean isIncludeMissingRows() {","+        return includeMissingRows;","+    }","+","     /** Re-opened from the zip on rewind rather than cached: the entry is in the container already. */","     private static TikaInputStream entryStream(ZipFile zipFile, ZipArchiveEntry entry) {","         return TikaInputStream.get(() -> zipFile.getInputStream(entry), new TemporaryResources(), null);","@@ -300,14 +316,16 @@ private void handleZipArchiveEntry(ZipArchiveEntry entry, TikaInputStream tisZip","                 meta.parse(tisZip, new DefaultHandler(), metadata, context);","         } else if (entry.getName().endsWith(\"content.xml\")) {","             if (content instanceof OpenDocumentContentParser) {","-                    ((OpenDocumentContentParser) content).parseInternal(tisZip, handler, metadata, context);","+                    ((OpenDocumentContentParser) content).parseInternal(tisZip, handler, metadata, context,","+                            includeMissingRows);","             } else {","                 // Foreign content parser was set:","                 content.parse(TikaInputStream.get(tisZip), handler, metadata, context);","             }","         } else if (entry.getName().endsWith(\"styles.xml\")) {","             if (content instanceof OpenDocumentContentParser) {","-                    ((OpenDocumentContentParser) content).parseInternal(tisZip, handler, metadata, context);","+                    ((OpenDocumentContentParser) content).parseInternal(tisZip, handler, metadata, context,","+                            includeMissingRows);","             } else {","                 // Foreign content parser was set:","                 content.parse(TikaInputStream.get(tisZip), handler, metadata, context);"],"additions":20,"deletions":2,"truncated":false},{"path":"tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-miscoffice-module/src/main/java/org/apache/tika/parser/odf/RepeatedElementHandler.java","lines":["@@ -38,11 +38,17 @@","  * ODF stores runs of identical cells or rows once with a count. One with content is","  * replayed. Empty ones, repeated or not, are held back and written only if a sibling","  * with content follows before the parent closes, so the filler that pads a sheet out to","- * its last column or row (often thousands of cells, a million rows) is dropped.","+ * its last column or row (often thousands of cells, a million rows) is dropped. Gaps","+ * before content are written up to {@code maxEmptyWritten} empty elements per document:","+ * cells pad out to the next value's column, as the Excel parsers do, and empty rows are","+ * dropped unless asked for.","+ * <p>","+ * Padding and every replayed copy are charged to a shared {@link Budget} at one unit per","+ * character and per element (each element writes a tab or newline).","  */"," class RepeatedElementHandler extends ContentHandlerDecorator {"," ","-    /** Characters a document may add by replaying, beyond each element's first copy. */","+    /** Characters and elements a document may add by padding and replaying. */","     static final long MAX_REPLAYED_CHARS = 10_000_000L;"," ","     /** Replay budget shared by the cell and row handlers of one document. */","@@ -61,13 +67,27 @@ boolean take(long extra) {","                 replayedChars += extra;","                 return true;","             }","+            warn();","+            return false;","+        }","+","+        /** Takes as much of {@code extra} as fits; warns once when not all of it does. */","+        long takeUpTo(long extra) {","+            long granted = Math.min(extra, MAX_REPLAYED_CHARS - replayedChars);","+            replayedChars += granted;","+            if (granted < extra) {","+                warn();","+            }","+            return granted;","+        }","+","+        private void warn() {","             if (!warned && metadata != null) {","                 metadata.add(TikaCoreProperties.TIKA_META_EXCEPTION_WARNING,","                         \"OpenDocument repeated cells/rows exceeded \" + MAX_REPLAYED_CHARS","                                 + \" replayed characters; the rest were written once\");","             }","             warned = true;","-            return false;","         }","     }"," ","@@ -88,6 +108,8 @@ private static final class EmptyRun {","         }","     }"," ","+    private static final Attributes EMPTY_ATTRIBUTES = new AttributesImpl();","+","     private interface Event {","         void replay(ContentHandler h) throws SAXException;","     }","@@ -96,6 +118,8 @@ private interface Event {","     private final String element;","     private final String parent;","     private final int maxRepeat;","+    private long emptyLeft;","+    private final String emptyChild;","     private final Budget budget;"," ","     private int nextRepeat;","@@ -107,20 +131,25 @@ private interface Event {","     private int repeat;","     private boolean hasContent;","     private long chars;","+    private long elements;","     private final Deque<EmptyRun> pendingEmpty = new ArrayDeque<>();","     private long pendingCount;"," ","     /**","      * @param element the XHTML element that repeats ({@code td} or {@code tr})","      * @param parent  the element whose end drops pending empty copies","+     * @param maxEmptyWritten most empty elements written before content, per document","+     * @param emptyChild      element written inside each empty one, or null","      */","     RepeatedElementHandler(ContentHandler out, String element, String parent, int maxRepeat,","-                           Budget budget) {","+                           long maxEmptyWritten, String emptyChild, Budget budget) {","         super(out);","         this.out = out;","         this.element = element;","         this.parent = parent;","         this.maxRepeat = maxRepeat;","+        this.emptyLeft = maxEmptyWritten;","+        this.emptyChild = emptyChild;","         this.budget = budget;","     }"," ","@@ -151,6 +180,7 @@ public void startElement(String uri, String localName, String name, Attributes a","             throws SAXException {","         if (buffer != null) {","             depth++;","+            elements++;","             if (localName.equals(\"img\")) {","                 hasContent = true;","             }","@@ -164,6 +194,7 @@ public void startElement(String uri, String localName, String name, Attributes a","             repeat = Math.max(1, nextRepeat);","             hasContent = false;","             chars = 0;","+            elements = 1;","             nextRepeat = 0;","             AttributesImpl copy = new AttributesImpl(atts);","             bufferUri = uri;","@@ -193,7 +224,7 @@ public void endElement(String uri, String localName, String name) throws SAXExce","             }","             writePendingEmpty();","             int copies = repeat;","-            if (copies > 1 && !budget.take(chars * (copies - 1))) {","+            if (copies > 1 && !budget.take((chars + elements) * (copies - 1))) {","                 copies = 1;","             }","             for (int i = 0; i < copies; i++) {","@@ -241,7 +272,7 @@ public void ignorableWhitespace(char[] ch, int start, int length) throws SAXExce","     }"," ","     private void hold(String uri, String localName, String name, Attributes atts, int count) {","-        int n = (int) Math.min(count, maxRepeat - pendingCount);","+        int n = (int) Math.min(count, Math.min(maxRepeat, emptyLeft) - pendingCount);","         if (n <= 0) {","             return;","         }","@@ -260,9 +291,16 @@ private void clearPending() {","     }"," ","     private void writePendingEmpty() throws SAXException {","+        int units = emptyChild == null ? 1 : 2;","+        long n = budget.takeUpTo(pendingCount * units) / units;","+        emptyLeft -= n;","         for (EmptyRun run : pendingEmpty) {","-            for (int i = 0; i < run.count; i++) {","+            for (int i = 0; i < run.count && n > 0; i++, n--) {","                 super.startElement(run.uri, run.localName, run.name, run.atts);","+                if (emptyChild != null) {","+                    super.startElement(run.uri, emptyChild, emptyChild, EMPTY_ATTRIBUTES);","+                    super.endElement(run.uri, emptyChild, emptyChild);","+                }","                 super.endElement(run.uri, run.localName, run.name);","             }","         }"],"additions":45,"deletions":7,"truncated":false},{"path":"tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-miscoffice-module/src/test/java/org/apache/tika/parser/odf/OpenDocumentContentParserTest.java","lines":["@@ -21,9 +21,13 @@"," import static org.junit.jupiter.api.Assertions.assertThrows;"," import static org.junit.jupiter.api.Assertions.assertTrue;"," ","+import java.io.ByteArrayOutputStream;"," import java.nio.charset.StandardCharsets;"," import java.util.regex.Matcher;"," import java.util.regex.Pattern;","+import java.util.zip.CRC32;","+import java.util.zip.ZipEntry;","+import java.util.zip.ZipOutputStream;"," "," import org.apache.commons.compress.compressors.gzip.GzipCompressorInputStream;"," import org.junit.jupiter.api.Test;","@@ -31,8 +35,11 @@"," import org.xml.sax.helpers.DefaultHandler;"," "," import org.apache.tika.TikaTest;","+import org.apache.tika.config.JsonConfig;"," import org.apache.tika.io.TikaInputStream;"," import org.apache.tika.metadata.Metadata;","+import org.apache.tika.metadata.TikaCoreProperties;","+import org.apache.tika.parser.AutoDetectParser;"," import org.apache.tika.parser.ParseContext;"," import org.apache.tika.parser.Parser;"," import org.apache.tika.sax.ToXMLContentHandler;","@@ -119,7 +126,7 @@ public void testRepeatedCells() throws Exception {","                 + \"<tr><tdcolspan=\\\"2\\\"><p>wide</p></td><td><p>c</p></td></tr>\"","                 + \"<tr><td><p>r</p></td><td><p>s</p></td><td><p>s</p></td></tr>\"","                 + \"<tr><