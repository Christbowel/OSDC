office:spreadsheet></office:body></office:document>\")","+                .getBytes(StandardCharsets.UTF_8);","+    }","+","+    private static byte[] ods(String rows) throws Exception {","+        String content = \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><office:document-content\" + NS","+                + \" office:version=\\\"1.3\\\"><office:body><office:spreadsheet>\"","+                + \"<table:table table:name=\\\"S\\\">\" + rows","+                + \"</table:table></office:spreadsheet></office:body></office:document-content>\";","+        ByteArrayOutputStream bos = new ByteArrayOutputStream();","+        try (ZipOutputStream zos = new ZipOutputStream(bos)) {","+            ZipEntry mime = new ZipEntry(\"mimetype\");","+            mime.setMethod(ZipEntry.STORED);","+            byte[] mimeBytes = SHEET_MIME.getBytes(StandardCharsets.US_ASCII);","+            CRC32 crc = new CRC32();","+            crc.update(mimeBytes);","+            mime.setSize(mimeBytes.length);","+            mime.setCrc(crc.getValue());","+            zos.putNextEntry(mime);","+            zos.write(mimeBytes);","+            zos.closeEntry();","+            zos.putNextEntry(new ZipEntry(\"content.xml\"));","+            zos.write(content.getBytes(StandardCharsets.UTF_8));","+            zos.closeEntry();","+        }","+        return bos.toByteArray();","+    }","+","+    private XMLResult autoDetect(byte[] bytes, String name, Metadata metadata) throws Exception {","+        return autoDetect(bytes, name, metadata, AUTO_DETECT_PARSER);","+    }","+","+    private XMLResult autoDetect(byte[] bytes, String name, Metadata metadata, Parser parser)","+            throws Exception {","+        metadata.set(TikaCoreProperties.RESOURCE_NAME_KEY, name);","+        try (TikaInputStream tis = TikaInputStream.get(bytes)) {","+            return getXML(tis, parser, metadata);","+        }","+    }","+","+    private static final String INCLUDE_MISSING_ROWS = \"{\\\"includeMissingRows\\\": true}\";","+","+    // the AutoDetectParser wrapper keeps the zip-bomb guard in play","+    private static Parser odsWithMissingRows() {","+        return new AutoDetectParser(","+                new OpenDocumentParser(JsonConfig.trusted(INCLUDE_MISSING_ROWS)));","+    }","+","+    private static Parser fodsWithMissingRows() {","+        return new AutoDetectParser(","+                new FlatOpenDocumentParser(JsonConfig.trusted(INCLUDE_MISSING_ROWS)));","+    }","+","+    private static String table(String xml) {","+        return xml.substring(xml.indexOf(\"<table>\"), xml.indexOf(\"</table>\")).replaceAll(\"\\\\s+\", \"\");","+    }","+","+    private static int count(String haystack, String needle) {","+        return haystack.split(Pattern.quote(needle), -1).length - 1;","+    }","+","+    @Test","+    public void testMillionRowGapFods() throws Exception {","+        byte[] bytes = fods(row(\"before\") + emptyRows(1048565) + row(\"after\"));","+        String xml = autoDetect(bytes, \"gap.fods\", new Metadata()).xml;","+        assertEquals(\"<table><tr><td><p>before</p></td></tr><tr><td><p>after</p></td></tr>\",","+                table(xml));","+        assertTrue(xml.length() < 2000, \"output length \" + xml.length());","+    }","+","+    @Test","+    public void testMillionRowGapOds() throws Exception {","+        byte[] bytes = ods(row(\"before\") + emptyRows(1048565) + row(\"after\"));","+        String xml = autoDetect(bytes, \"gap.ods\", new Metadata()).xml;","+        assertEquals(\"<table><tr><td><p>before</p></td></tr><tr><td><p>after</p></td></tr>\",","+                table(xml));","+    }","+","+    @Test","+    public void testWideCellGapInRepeatedRows() throws Exception {","+        byte[] bytes = fods(\"<table:table-row table:number-rows-repeated=\\\"100000\\\">\"","+                + emptyCells(16383) + \"<table:table-cell><text:p>x</text:p></table:table-cell>\"","+                + \"</table:table-row>\" + row(\"after\"));","+        