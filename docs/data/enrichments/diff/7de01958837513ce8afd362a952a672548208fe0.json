{"id":"7de01958837513ce8afd362a952a672548208fe0","axis":"silent","repo":"pnpm/pnpm","sha":"7de01958837513ce8afd362a952a672548208fe0","parsed":{"files":[{"path":".changeset/filtered-install-hoisted-groups-and-freshness.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install --filter` with `nodeLinker: hoisted` and `--prod` or `--dev` now preserves previously installed dependency groups for unselected workspace projects [pnpm/tasks#164](https://github.com/pnpm/tasks/issues/164). Repeat filtered installs also re-resolve when a transitive injected workspace dependency or a linked dependency's version changes."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_filters/warm_install.rs","lines":["@@ -1,6 +1,7 @@"," use super::{","-    HELLO, ManifestDeps, PARENT, WorkspaceFixture, assert_eq, fs, importing_started_count,","-    reports_up_to_date,","+    CATALOG_FOO, DEP, HELLO, ManifestDeps, NO_DEPS, PARENT, WorkspaceFixture, assert_eq, fs,","+    has_link, has_snapshot, importer_version, importing_started_count, reports_up_to_date,","+    set_dependency, set_version,"," };"," "," #[test]","@@ -55,3 +56,293 @@ fn filtered_install_takes_the_up_to_date_path_after_a_full_install() {","     assert_eq!(fs::read(&lockfile_path).expect(\"read lockfile\"), before);","     assert!(!fixture.state().filtered_install, \"the short-circuit narrowed nothing\");"," }","+","+#[test]","+fn filtered_hoisted_prod_install_preserves_unselected_dev_dependencies() {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(\"nodeLinker: hoisted\\n\");","+    fixture.project(","+        \"selected\",","+        \"selected\",","+        ManifestDeps {","+            prod: &[(HELLO, \"1.0.0\")],","+            dev: &[(NO_DEPS, \"1.0.0\")],","+            ..Default::default()","+        },","+    );","+    fixture.project(","+        \"unselected\",","+        \"unselected\",","+        ManifestDeps { dev: &[(PARENT, \"100.0.0\")], ..Default::default() },","+    );","+    fixture.run([\"install\"]);","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(HELLO)","+            .is_dir(),","+    );","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(NO_DEPS)","+            .is_dir(),","+    );","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(PARENT)","+            .is_dir(),","+    );","+","+    fixture.run([\"--filter\", \"selected\", \"install\", \"--prod\"]);","+","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(HELLO)","+            .is_dir(),","+        \"selected prod dependency must remain hoisted\",","+    );","+    assert!(","+        !fixture.workspace","+            .join(\"node_modules\")","+            .join(NO_DEPS)","+            .exists(),","+        \"selected devDependency must be pruned under --prod\",","+    );","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(PARENT)","+            .is_dir(),","+        \"unselected prior devDependency must remain hoisted\",","+    );","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(DEP)","+            .is_dir(),","+        \"unselected prior transitive devDependency must remain hoisted\",","+    );","+    let current = fixture.current();","+    assert!(","+        current.importers[\"packages/selected\"].dev_dependencies.is_none(),","+        \"current lockfile must strip devDependencies from selected importer\",","+    );","+    assert!(","+        current.importers[\"packages/unselected\"].dev_dependencies.is_some(),","+        \"current lockfile must retain devDependencies on unselected importer\",","+    );","+    assert!(has_snapshot(&current, PARENT, \"100.0.0\"));","+    assert!(!has_snapshot(&current, NO_DEPS, \"1.0.0\"));","+}","+","+#[test]","+fn filtered_hoisted_dev_install_preserves_unselected_prod_dependencies() {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(\"nodeLinker: hoisted\\n\");","+    fixture.project(","+        \"selected\",","+        \"selected\",","+        ManifestDeps {","+            prod: &[(NO_DEPS, \"1.0.0\")],","+            dev: &[(HELLO, \"1.0.0\")],","+            ..Default::default()","+        },","+    );","+    fixture.project(","+        \"unselected\",","+        \"unselected\",","+        ManifestDeps { prod: &[(PARENT, \"100.0.0\")], ..Default::default() },","+    );","+    fixture.run([\"install\"]);","+","+    fixture.run([\"--filter\", \"selected\", \"install\", \"--dev\"]);","+","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(HELLO)","+            .is_dir(),","+        \"selected devDependency must remain hoisted\",","+    );","+    assert!(","+        !fixture.workspace","+            .join(\"node_modules\")","+            .join(NO_DEPS)","+            .exists(),","+        \"selected prod dependency must be pruned under --dev\",","+    );","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(PARENT)","+            .is_dir(),","+        \"unselected prior prod dependency must remain hoisted\",","+    );","+    let current = fixture.current();","+    assert!(","+        current.importers[\"packages/selected\"].dependencies.is_none(),","+        \"current lockfile must strip dependencies from selected importer under --dev\",","+    );","+    assert!(","+        current.importers[\"packages/unselected\"].dependencies.is_some(),","+        \"current lockfile must retain dependencies on unselected importer\",","+    );","+}","+","+#[test]","+fn filtered_hoisted_no_optional_install_preserves_unselected_optional_dependencies() {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(\"nodeLinker: hoisted\\n\");","+    fixture.project(","+        \"selected\",","+        \"selected\",","+        ManifestDeps {","+            prod: &[(HELLO, \"1.0.0\")],","+            optional: &[(NO_DEPS, \"1.0.0\")],","+            ..Default::default()","+        },","+    );","+    fixture.project(","+        \"unselected\",","+        \"unselected\",","+        ManifestDeps { optional: &[(PARENT, \"100.0.0\")], ..Default::default() },","+    );","+    fixture.run([\"install\"]);","+","+    fixture.run([\"--filter\", \"selected\", \"install\", \"--no-optional\"]);","+","+    assert!(","+        !fixture.workspace","+            .join(\"node_modules\")","+            .join(NO_DEPS)","+            .exists(),","+        \"selected optionalDependency must be pruned under --no-optional\",","+    );","+    assert!(","+        fixture.workspace","+            .join(\"node_modules\")","+            .join(PARENT)","+            .is_dir(),","+        \"unselected prior optionalDependency must remain hoisted\",","+    );","+    let current = fixture.current();","+    assert!(","+        current.importers[\"packages/selected\"].optional_dependencies.is_none(),","+        \"current lockfile must strip optionalDependencies from selected importer\",","+    );","+    assert!(","+        current.importers[\"packages/unselected\"].optional_dependencies.is_some(),","+        \"current lockfile must retain optionalDependencies on unselected importer\",","+    );","+    let parent_key: pnpm_lockfile::PackageKey = format!(\"{PARENT}@100.0.0\").parse().unwrap();","+    let parent_snapshot = current.snapshots","+        .as_ref()","+        .and_then(|snapshots| snapshots.get(&parent_key))","+        .expect(\"retained optional snapshot\");","+    assert!(parent_snapshot.optional, \"retained optional snapshot must keep optional: true\");","+}","+","+#[test]","+fn filtered_install_succeeds_under_sparse_checkout_when_unselected_catalog_importer_is_missing_from_disk()","+ {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(&format!(\"catalog:\\n  '{CATALOG_FOO}': 1.0.0\\n\"));","+    let selected = fixture.project(","+        \"selected\",","+        \"selected\",","+        ManifestDeps { prod: &[(HELLO, \"1.0.0\")], ..Default::default() },","+    );","+    let missing = fixture.project(","+        \"missing\",","+        \"missing\",","+        ManifestDeps { prod: &[(CATALOG_FOO, \"catalog:\")], ..Default::default() },","+    );","+    fixture.run([\"install\", \"--lockfile-only\"]);","+","+    fs::remove_dir_all(&missing).expect(\"simulate sparse checkout omitting packages/missing\");","+    fixture.run([\"--filter\", \"selected\", \"install\"]);","+","+    assert!(has_link(&selected, HELLO), \"selected project must be materialized\");","+    let wanted = fixture.wanted();","+    assert_eq!(","+        importer_version(&wanted, \"packages/missing\", CATALOG_FOO),","+        \"1.0.0\",","+        \"sparse-checkout missing project must remain preserved in wanted lockfile\",","+    );","+    assert!(","+        wanted.catalogs","+            .as_ref()","+            .and_then(|catalogs| catalogs.get(\"default\"))","+            .is_some_and(|entries| entries.contains_key(CATALOG_FOO)),","+        \"catalog entry referenced by sparse-checkout missing project must be preserved\",","+    );","+}","+","+#[test]","+fn filtered_repeat_install_re_resolves_when_transitive_injected_dependency_changes() {","+    let fixture = WorkspaceFixture::new();","+    fixture.append_workspace_yaml(\"injectWorkspacePackages: true\\ndedupeInjectedDeps: false\\n\");","+    let pkg_a = fixture.project(","+        \"pkg-a\",","+        \"pkg-a\",","+        ManifestDeps { prod: &[(HELLO, \"1.0.0\")], ..Default::default() },","+    );","+    fixture.project(","+        \"pkg-b\",","+        \"pkg-b\",","+        ManifestDeps { prod: &[(\"pkg-a\", \"workspace:*\")], ..Default::default() },","+    );","+    fixture.project(","+        \"pkg-c\",","+        \"pkg-c\",","+        ManifestDeps { prod: &[(\"pkg-b\", \"workspace:*\")], ..Default::default() },","+    );","+    fixture.run([\"install\"]);","+    assert!(!has_snapshot(&fixture.wanted(), NO_DEPS, \"1.0.0\"));","+","+    set_dependency(&pkg_a, \"dependencies\", NO_DEPS, \"1.0.0\");","+    let records = fixture.run([\"--filter\", \"pkg-c\", \"install\"]);","+","+    assert!(","+        !reports_up_to_date(&records),","+        \"transitive injected dependency change must invalidate repeat-install fast path\",","+    );","+    assert!(","+        has_snapshot(&fixture.wanted(), NO_DEPS, \"1.0.0\"),","+        \"re-resolved lockfile must include new transitive dependency of pkg-a\",","+    );","+}","+","+#[test]","+fn filtered_repeat_install_fails_when_linked_dependency_version_breaks_range() {","+    let fixture = WorkspaceFixture::new();","+    let pkg_a = fixture.project(","+        \"pkg-a\",","+        \"pkg-a\",","+        ManifestDeps { prod: &[(HELLO, \"1.0.0\")], ..Default::default() },","+    );","+    fixture.project(","+        \"pkg-b\",","+        \"pkg-b\",","+        ManifestDeps { prod: &[(\"pkg-a\", \"workspace:^1.0.0\")], ..Default::default() },","+    );","+    fixture.run([\"install\"]);","+","+    set_version(&pkg_a, \"2.0.0\");","+    let output = fixture.command_at(&fixture.workspace, [\"--filter\", \"pkg-b\", \"install\"]);","+    let stderr = String::from_utf8_lossy(&output.stderr);","+","+    assert!(","+        !output.status.success(),","+        \"breaking workspace:^1.0.0 on linked pkg-a must invalidate fast path and fail resolution\",","+    );","+    assert!(","+        stderr.contains(","+            \"No matching version found for pkg-a@workspace:^1.0.0 inside the workspace\"","+        ),","+        \"failure must come from the unsatisfied workspace range: {stderr}\",","+    );","+}"],"additions":293,"deletions":2,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/i