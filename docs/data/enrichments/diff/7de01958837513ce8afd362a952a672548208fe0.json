dencyGroup::Optional,","+            ])","         })","         .map(|(alias, _)| alias.to_string())","         .collect()","@@ -493,26 +477,3 @@ fn pkg_roots_by_key<'n>(","     }","     roots"," }","-","-/// Clone the lockfile with every importer's excluded dep groups","-/// cleared, so seeds for the hoist tree come only from the included","-/// groups. Snapshots that thereby become unreachable are simply never","-/// visited by the hoister, so the snapshot/package maps stay as-is.","-pub(crate) fn exclude_importer_groups(","-    lockfile: &Lockfile,","-    included: IncludedDependencies,","-) -> Lockfile {","-    let mut filtered = lockfile.clone();","-    for importer in filtered.importers.values_mut() {","-        if !included.dependencies {","-            importer.dependencies = None;","-        }","-        if !included.dev_dependencies {","-            importer.dev_dependencies = None;","-        }","-        if !included.optional_dependencies {","-            importer.optional_dependencies = None;","-        }","-    }","-    filtered","-}"],"additions":11,"deletions":50,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/hoisted/stale_links.rs","lines":["@@ -33,7 +33,6 @@ pub(super) fn unlink_stale_direct_links(","         inputs.config.modules_dir_name(),","         inputs.graph.lockfile,","         current_lockfile,","-        inputs.projects.dependency_groups,","     )","     .map_err(HoistedLinkerError::PruneStaleLinks)"," }"],"additions":0,"deletions":1,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/hoisted/workspace_links.rs","lines":["@@ -4,6 +4,9 @@ use super::{"," use crate::SymlinkDirectDependencies;"," use std::collections::HashSet;"," ","+const ALL_DEPENDENCY_GROUPS: [super::DependencyGroup; 3] =","+    [super::DependencyGroup::Prod, super::DependencyGroup::Dev, super::DependencyGroup::Optional];","+"," // The hoisted walker skips workspace links, which still need symlinks in each