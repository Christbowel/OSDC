ndencies","    */","   public function uninstall(array $theme_list);"," ","+  /**","+   * Determines the full set of themes to uninstall for the given list.","+   *","+   * @param string[] $theme_list","+   *   An array of theme machine names.","+   * @param bool $uninstall_dependents","+   *   (optional) If TRUE, installed sub-themes of the given themes are added to","+   *   the returned list. If FALSE, an exception is thrown when a given base","+   *   theme has an installed sub-theme that is not also in the list.","+   *","+   * @return string[]","+   *   The machine names of the themes to uninstall, including any added","+   *   sub-themes.","+   *","+   * @throws \\Drupal\\Core\\Extension\\Exception\\UnknownExtensionException","+   *   Thrown when a requested theme is not installed.","+   *","+   * @throws \\InvalidArgumentException","+   *   Thrown when trying to uninstall the admin theme, the default theme or,","+   *   when $uninstall_dependents is FALSE, a theme that another theme depends","+   *   on.","+   */","+  public function getThemesToUninstall(array $theme_list, bool $uninstall_dependents = TRUE): array;","+"," }"],"additions":24,"deletions":0,"truncated":false},{"path":"core/misc/cspell/drupal-dictionary.txt","lines":["@@ -20,6 +20,7 @@ drupalorg"," druplicon"," drush"," exin","+exun"," fapi"," fieldable"," fulldate"],"additions":1,"deletions":0,"truncated":false},{"path":"core/modules/system/src/Form/ModulesUninstallConfirmForm.php","lines":["@@ -152,6 +152,9 @@ public function buildForm(array $form, FormStateInterface $form_state) {","     }"," ","     $data = $this->moduleExtensionList->getList();","+    // Resolves all modules to uninstall including any dependencies in the order","+    // the module installer will uninstall them.","+    $this->modules = $this->moduleInstaller->getModulesToUninstall($this->modules);","     $form['text']['#markup'] = '<p>' . $this->t('The following modules will be completely uninstalled from your site, and <em>all data from these modules will be lost</em>!') . '</p>';","     $form['modules'] = [","       '#theme' => 'item_list',"],"additions":3,"deletions":0,"truncated":false},{"path":"core/tests/Drupal/KernelTests/Core/Extension/Command/ExtensionUninstallCommandTest.php","lines":["@@ -0,0 +1,236 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Drupal\\KernelTests\\Core\\Extension\\Command;","+","+use Drupal\\Core\\Command\\Exception\\UserAbortException;","+use Drupal\\KernelTests\\KernelTestBase;","+use Drupal\\Core\\Extension\\Command\\ExtensionUninstallCommand;","+use PHPUnit\\Framework\\Attributes\\CoversClass;","+use PHPUnit\\Framework\\Attributes\\Group;","+use PHPUnit\\Framework\\Attributes\\RunTestsInSeparateProcesses;","+use Symfony\\Component\\Console\\Command\\Command;","+use Symfony\\Component\\Console\\Tester\\CommandTester;","+","+/**","+ * Tests the 'ex:uninstall' command.","+ */","+#[Group('Console')]","+#[RunTestsInSeparateProcesses]","+#[CoversClass(ExtensionUninstallCommand::class)]","+class ExtensionUninstallCommandTest extends KernelTestBase {","+","+  /**","+   * {@inheritdoc}","+   */","+  protected static $modules = ['system', 'user'];","+","+  /**","+   * {@inheritdoc}","+   */","+  protected function setUp(): void {","+    parent::setUp();","+    // hook_modules_uninstalled() in the User module cleans up users_data.","+    $this->installSchema('user', ['users_data']);","+    // console_test depends on autowire_test, and test_subtheme on","+    // test_base_theme, so uninstalling the dependency pulls in the dependent.","+    $this->container->get('module_installer')->install(['console_test']);","+    $this->container->get('theme_installer')->install(['test_subtheme']);","+  }","+","+  /**","+   * Builds a command tester for the 'ex:uninstall' command.","+   */","+  private function commandTester(): CommandTester {","+    $command = new ExtensionUninstallCommand(","+      $this->container->get('module_installer'),","+      $this->container->get('theme_installer'),","+      $this->container->get('extension.list.module'),","+      $this->container->get('extension.list.theme'),","+      $this->container->get('messenger'),","+    );","+    return new CommandTester($command);","+  }","+","+  /**","+   * Whether the given module is installed.","+   */","+  private function moduleInstalled(string $module): bool {","+    return $this->container->get('module_handler')->moduleExists($module);","+  }","+","+  /**","+   * Whether the given theme is installed.","+   */","+  private function themeInstalled(string $theme): bool {","+    return array_key_exists($theme, $this->container->get('theme_handler')->listInfo());","+  }","+","+  /**","+   * Tests that --dry-run lists the operations but uninstalls nothing.","+   */","+  public function testDryRunUninstallsNothing(): void {","+    $tester = $this->commandTester();","+    $code = $tester->execute(['extensions' => 'autowire_test', '--dry-run' => TRUE]);","+    $display = $tester->getDisplay();","+","+    $this->assertEquals(Command::SUCCESS, $code, $tester->getDisplay());","+    // The requested module and its dependent are reported.","+    $this->assertStringContainsString('autowire_test', $display);","+    $this->assertStringContainsString('console_test', $display);","+    $this->assertStringContainsString('Dry run', $display);","+    // Nothing was actually uninstalled.","+    $this->assertTrue($this->moduleInstalled('autowire_test'));","+    $this->assertTrue($this->moduleInstalled('console_test'));","+  }","+","+  /**","+   * Tests confirming the prompt uninstalls the module and its dependent.","+   */","+  public function testUninstallWithConfirmedDependent(): void {","+    $tester = $this->commandTester();","+    $tester->setInputs(['yes']);","+    $code = $tester->execute(['extensions' => 'autowire_test'], ['interactive' => TRUE]);","+","+    $this->assertEquals(Command::SUCCESS, $code, $tester->getDisplay());","+    $this->assertFalse($this->moduleInstalled('autowire_test'));","+    $this->assertFalse($this->moduleInstalled('console_test'));","+  }","+","+  /**","+   * Tests that declining the prompt throws a UserAbortException.","+   */","+  public function testDeclinedPromptAborts(): void {","+    $tester = $this->commandTester();","+    $tester->setInputs(['no']);","+","+    try {","+      $tester->execute(['extensions' => 'autowire_test'], ['interactive' => TRUE]);","+      $this->fail('Expected a UserAbortException to be thrown.');","+    }","+    catch (UserAbortException) {","+      // Expected.","+    }","+","+    $this->assertTrue($this->moduleInstalled('autowire_test'));","+    $this->assertTrue($this->moduleInstalled('console_test'));","+  }","+","+  /**","+   * Tests that --yes skips the confirmation prompt.","+   */","+  public function testYesOptionSkipsPrompt(): void {","+    $tester = $this->commandTester();","+    // No inputs are provided; with --yes the prompt must not be reached.","+    $code = $tester->execute(['extensions' => 'autowire_test', '--yes' => TRUE]);","+","+    $this->assertEquals(Command::SUCCESS, $code, $tester->getDisplay());","+    $this->assertFalse($this->moduleInstalled('autowire_test'));","+    $this->assertFalse($this->moduleInstalled('console_test'));","+  }","+","+  /**","+   * Tests that a non-interactive run aborts unless --yes is supplied.","+   */","+  public function testNonInteractiveAbortsWithoutYes(): void {","+    // Dependents must be confirmed with --yes when there is no interactive","+    // prompt to answer; the command aborts before uninstalling anything.","+    $this->expectException(UserAbortException::class);","+    $this->commandTester()->execute(['extensions' => 'autowire_test'], ['interactive' => FALSE]);","+  }","+","+  /**","+   * Tests uninstalling a module without additional dependents.","+   */","+  public function testUninstallWithoutDependents(): void {","+    $tester = $this->commandTester();","+    $code = $tester->execute(['extensions' =>