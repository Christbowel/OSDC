","+\t// streamed log write sends 200 implicitly, while a validation failure","+\t// inside ReadLog can still produce a non-2xx JSON response."," \tw.Header().Set(\"Content-Type\", \"text/plain\")"," \tw.Header().Set(\"Cache-Control\", \"no-cache, private\")"," ","@@ -67,8 +78,24 @@ func (s *RunLogServer) ReadRunLogV1(w http.ResponseWriter, r *http.Request) {"," \t}"," }"," ","+// This route is registered directly on the mux rather than through grpc-gateway,","+// so the caller identity arrives in the request headers, not in gRPC metadata.","+// Copy the headers into metadata so the authenticators can read them, as","+// canUploadVersionedPipeline does.","+// The dedicated readLog verb keeps log access behind a SubjectAccessReview even","+// in shared read mode, which auto-approves the shared get/list verbs.","+func (s *RunLogServer) authorize(r *http.Request, runID string) error {","+\tmd := metadata.MD{}","+\tfor key, values := range r.Header {","+\t\tmd.Set(key, values...)","+\t}","+\tctx := metadata.NewIncomingContext(r.Context(), md)","+\treturn s.canAccessRun(ctx, runID, &authorizationv1.ResourceAttributes{Verb: common.RbacResourceVerbReadLog})","+}","+"," func (s *RunLogServer) writeErrorToResponse(w http.ResponseWriter, code int, err error) {"," \tglog.Errorf(\"Failed to read run log. Error: %+v\", err)","+\tw.Header().Set(\"Content-Type\", \"application/json\")"," \tw.WriteHeader(code)"," \terrorResponse := &api.Error{ErrorMessage: err.Error(), ErrorDetails: fmt.Sprintf(\"%+v\", err)}"," \terrBytes, err := json.Marshal(errorResponse)","@@ -79,5 +106,11 @@ func (s *RunLogServer) writeErrorToResponse(w http.ResponseWriter, code int, err"," }"," "," func NewRunLogServer(resourceManager *resource.ResourceManager) *RunLogServer {","-\treturn &RunLogServer{resourceManager: resourceManager, httpClient: http.DefaultClient}","+\treturn &RunLogServer{","+\t\tBaseRunServer: &BaseRunServer{","+\t\t\tresourceManager: resourceManager,","+\t\t\toptions:         &RunServerOptions{CollectMetrics: false},","+\t\t},","+\t\thttpClient: http.DefaultClient,","+\t}"," }"],"additions":37,"deletions":4,"truncated":false},{"path":"backend/src/apiserver/server/run_log_server_test.go","lines":["@@ -22,7 +22,14 @@ import ("," "," \t\"github.com/gorilla/mux\""," \tapi \"github.com/kubeflow/pipelines/backend/api/v1beta1/go_client\"","+\t\"github.com/kubeflow/pipelines/backend/src/apiserver/client\"","+\t\"github.com/kubeflow/pipelines/backend/src/apiserver/common\"","+\t\"github.com/kubeflow/pipelines/backend/src/apiserver/resource\"","+\t\"github.com/kubeflow/pipelines/backend/src/common/util\"","+\t\"github.com/spf13/viper\""," \t\"github.com/stretchr/testify/assert\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," )"," "," func TestNewRunLogServer(t *testing.T) {","@@ -83,3 +90,108 @@ func TestReadRunLogV1_MissingNodeId(t *testing.T) {"," \tassert.Equal(t, http.StatusBadRequest, recorder.Code)"," \tassert.Contains(t, recorder.Body.String(), NodeKey)"," }","+","+func TestReadRunLogV1_Unauthorized(t *testing.T) {","+\tviper.Set(common.MultiUserMode, \"true\")","+\tdefer viper.Set(common.MultiUserMode, \"false\")","+","+\tclients, _, run := initWithOneTimeRun(t)","+\tdefer clients.Close()","+","+\t// Deny access for the log read while keeping the seeded run intact, so the","+\t// request reaches the authorization check rather than failing earlier.","+\tclients.SubjectAccessReviewClientFake = client.NewFakeSubjectAccessReviewClientUnauthorized()","+\tmanager := resource.NewResourceManager(clients, &resource.ResourceManagerOptions{CollectMetrics: false})","+\tserver := NewRunLogServer(manager)","+","+\treq := httptest.NewRequest(\"GET\", \"/apis/v1alpha1/runs/\"+run.UUID+\"/nodes/node-1/log\", nil)","+\treq.Header.Set(common.GoogleIAPUserIdentityHeader, common.GoogleIAPUserIdentityPrefix+\"user@google.com\")","+\treq = mux.SetURLVars(req, map[string]string{","+\t\tRunKey:  run.UUID,","+\t\tNodeKey: \"node-1\