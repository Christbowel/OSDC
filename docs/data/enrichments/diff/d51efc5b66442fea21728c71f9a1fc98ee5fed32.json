    {","                     if (!Fix(param, ref useSiteInfo))","                     {","-                        result = InferenceResult.InferenceFailed;","+                        needsFixing[param] = false;","+","+                        // Keep going, trying to fix other type parameters","+                        // - can bind some lambdas and that might enable some useful intellisense in an incomplete code.","+                        // - can still infer enough information for successful partial type inference from first argument","+                        _inferenceFailed[param] = true;","+                        UpdateDependenciesAfterFix(param);","+                    }","+                    else","+                    {","+                        anyFixed = true;","                     }","                 }","             }","+","+            // Type parameter inference from constraints:","+            // SPEC: When Xi is fixed to V, a lower-bound inference is performed from V to","+            // SPEC: each of the types in Xi's constraints, if any. This lets the type","+            // SPEC: parameters mentioned in those constraints (which depend on Xi, and so","+            // SPEC: are fixed after Xi) pick up bounds from the type Xi was fixed to.","+            if (anyFixed && IsFeatureTypeParameterInferenceFromConstraintsEnabled && !AllFixed())","+            {","+                for (int param = 0; param < _methodTypeParameters.Length; param++)","+                {","+                    if (needsFixing[param])","+                    {","+                        foreach (var constraintType in _methodTypeParameters[param].ConstraintTypesNoUseSiteDiagnostics)","+                        {","+                            LowerBoundInference(_fixedResults[param].Type, constraintType, ref useSiteInfo);","+                        }","+                    }","+                }","+            }","+","             return result;","         }"," ","@@ -1127,6 +1181,7 @@ private bool DependsDirectlyOn(int iParam, int jParam)","         {","             Debug.Assert(ValidIndex(iParam));","             Debug.Assert(ValidIndex(jParam));","+            Debug.Assert(iParam != jParam);"," ","             // SPEC: An unfixed type parameter Xi depends directly on an unfixed type","             // SPEC: parameter Xj if for some argument Ek with type Tk, Xj occurs","@@ -1151,6 +1206,36 @@ private bool DependsDirectlyOn(int iParam, int jParam)","                     return true;","                 }","             }","+","+            // SPEC EXTENSION (type parameter inference from constraints):","+            // SPEC: Xi depends directly on Xj if Xi occurs in a constraint for Xj.","+            // This lets the type inferred for Xj contribute to the inference of the","+            // type parameters mentioned in Xj's constraints, by ensuring Xj is fixed first.","+            if (IsFeatureTypeParameterInferenceFromConstraintsEnabled && DependsDirectlyOnThroughConstraints(iParam, jParam))","+            {","+                return true;","+            }","+","+            return false;","+        }","+","+        private readonly bool DependsDirectlyOnThroughConstraints(int iParam, int jParam)","+        {","+            Debug.Assert(iParam != jParam);","+","+            if (_methodTypeParameters[jParam].ConstraintTypesNoUseSiteDiagnostics is { Length: not 0 } constraintTypes)","+            {","+                TypeParameterSymbol possiblyDependent = _methodTypeParameters[iParam];","+","+                foreach (var constraintType in constraintTypes)","+                {","+                    if (constraintType.Type.ContainsTypeParameter(possiblyDependent))","+                    {","+                        return true;","+                    }","+                }","+            }","+","             return false;","         }"," ","@@ -1200,7 +1285,7 @@ private void InitializeDependencies()","             {","                 fo