ts"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/insights/src/entry.cloudflare-pages.tsx","lines":["@@ -0,0 +1,14 @@","+import {","+  createQwikRouter,","+  type PlatformCloudflarePages,","+} from '@qwik.dev/router/middleware/cloudflare-pages';","+import render from './entry.ssr';","+","+declare global {","+  interface QwikRouterPlatform extends PlatformCloudflarePages {}","+}","+","+// Telemetry ingestion accepts requests from applications on other origins.","+const fetch = createQwikRouter({ render, checkOrigin: false });","+","+export { fetch };"],"additions":14,"deletions":0,"truncated":false},{"path":"packages/insights/src/entry.netlify-edge.tsx","lines":["@@ -1,21 +0,0 @@","-/*","- * WHAT IS THIS FILE?","- *","- * It's the entry point for Netlify Edge when building for production.","- *","- * Learn more about the Netlify integration here:","- * - https://qwik.dev/docs/deployments/netlify-edge/","- *","- */","-import { createQwikRouter, type PlatformNetlify } from '@qwik.dev/router/middleware/netlify-edge';","-import render from './entry.ssr';","-","-declare global {","-  interface QwikRouterPlatform extends PlatformNetlify {}","-}","-","-export default createQwikRouter({","-  render,","-  // disable CSRF protection because we get called from everywhere","-  checkOrigin: false,","-});"],"additions":0,"deletions":21,"truncated":false},{"path":"packages/insights/src/routes/cloudflare-request.unit.ts","lines":["@@ -0,0 +1,48 @@","+import { describe, expect, it, vi } from 'vitest';","+import type { RequestEvent } from '@qwik.dev/router';","+import { onRequest } from './plugin@cloudflare';","+","+describe('Cloudflare request completion', () => {","+  it('keeps telemetry writes alive after the response is sent', async () => {","+    let finishWrites!: () => void;","+    const completion = new Promise<void>((resolve) => {","+      finishWrites = resolve;","+    });","+    const waitUntil = vi.fn();","+    const next = vi.fn(() => completion);","+","+    const result = onRequest({ next, platform: { ctx: { waitUntil } } } as unknown as RequestEvent);","+","+    expect(next).toHaveBeenCalledOnce();","+    expect(waitUntil).toHaveBeenCalledOnce();","+    const backgroundCompletion = waitUntil.mock.calls[0][0] as Promise<void>;","+    const completed = vi.fn();","+    void backgroundCompletion.then(completed);","+    await Promise.resolve();","+    expect(completed).not.toHaveBeenCalled();","+    finishWrites();","+    await result;","+    await backgroundCompletion;","+    expect(completed).toHaveBeenCalledOnce();","+  });","+","+  it('completes requests during local development without a Worker context', async () => {","+    const next = vi.fn(async () => {});","+","+    await onRequest({ next, platform: {} } as unknown as RequestEvent);","+","+    expect(next).toHaveBeenCalledOnce();","+  });","+","+  it('leaves request errors to the router without failing background completion', async () => {","+    const failure = new Error('Telemetry write failed');","+    const completion = Promise.reject(failure);","+    const waitUntil = vi.fn();","+    const next = () => completion;","+","+    const result = onRequest({ next, platform: { ctx: { waitUntil } } } as unknown as RequestEvent);","+","+    await expect(result).rejects.toBe(failure);","+    await expect(waitUntil.mock.calls[0][0]).resolves.toBeUndefined();","+  });","+});"],"additions":48,"deletions":0,"truncated":false},{"path":"packages/insights/src/routes/plugin@cloudflare.ts","lines":["@@ -0,0 +1,11 @@","+import type { RequestHandler } from '@qwik.dev/router';","+import type { PlatformCloudflarePages } from '@qwik.dev/router/middleware/cloudflare-pages';","+","+export const onRequest: RequestHandler = ({ next, platform }) => {","+  const completion = next();","+  // Keep telemetry writes alive after Cloudflare sends the response.","+  const { ctx } = platform as Partial<PlatformCloudflarePages>;","+  // The router handles redirects and errors through the original promise.","+  ctx?.waitUntil(completion.catch(() => {}));","+  return completion;","+};"],"additions":11,"deletions":0,"truncated":false},{"path":"packages/insights/wrangler.jsonc","lines":["@@ -0,0 +1,27 @@","+{","+  \"$schema\": \"node_modules/wrangler/config-schema.json\",","+  \"name\": \"qwik-insights\",","+  \"account_id\": \"1deff5204b2644a7a301da3467316319\",","+  \"main\": \"./dist/_worker.js\",","+  \"compatibility_date\": \"2026-11-09\",","+  \"compatibility_flags\": [\"nodejs_compat\", \"global_fetch_strictly_public\"],","+  \"workers_dev\": true,","+  \"routes\": [","+    {","+      \"pattern\": \"insights.qwik.dev\",","+      \"custom_domain\": true,","+      \"zone_name\": \"qwik.dev\",","+    },","+  ],","+  \"assets\": {","+    \"binding\": \"ASSETS\",","+    \"directory\": \"./dist\",","+  },","+  \"observability\": {","+    \"enabled\": true,","+  },","+  \"vars\": {","+    \"PRIVATE_LIBSQL_DB_URL\": \"libsql://qwik-bundalyzer-mhevery.aws-us-west-2.turso.io\",","+    \"PRIVATE_GITHUB_ID\": \"0a2c93802deff0d3bd3c\",","+  },","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"patches/extract-zip@2.0.1.patch","lines":["@@ -1,16 +0,0 @@","-diff --git a/index.js b/index.js","-index 23384ea16bb848616886f356d8d69f94325535bf..3a653349ecaa68f0ed804251733972600c09b1a3 100644","-+++ b/index.js","-@@ -126,6 +126,11 @@ class Extractor {","- ","-     if (symlink) {","-       const link = await getStream(readStream)","-+      const linkTarget = path.resolve(path.dirname(dest), link)","-+      const relativeLinkTarget = path.relative(this.opts.dir, linkTarget)","-+      if (relativeLinkTarget === '..' || relativeLinkTarget.startsWith(`..${path.sep}`)) {","-+        throw new Error(`Out of bound symlink \"${link}\" found while processing file ${entry.fileName}`)","-+      }","-       debug('creating symlink', link, dest)","-       await fs.symlink(link, dest)","-     } else {"],"additions":0,"deletions":15,"truncated":false},{"path":"pnpm-lock.y