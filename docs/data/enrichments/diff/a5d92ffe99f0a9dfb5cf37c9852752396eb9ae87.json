ing) => dirname(realpathSync(createRequire(join(from, 'package.json')).resolve(`${id}/package.json`)))","+  const runtimeCore = resolveDir('@vue/runtime-core', resolveDir('@vue/runtime-dom', resolveDir('vue', rootDir)))","+  for (const [id, source] of [['@vue/runtime-core', runtimeCore], ['@vue/reactivity', resolveDir('@vue/reactivity', runtimeCore)], ['@vue/shared', resolveDir('@vue/shared', runtimeCore)]] as const) {","+    cpSync(source, join(store, 'node_modules', id), { recursive: true, dereference: true })","+  }","+","+  mkdirSync(dir, { recursive: true })","+  if (!existsSync(join(rootDir, 'node_modules/duplicate-vue-ui'))) {","+    symlinkSync(dir, join(rootDir, 'node_modules/duplicate-vue-ui'), 'junction')","+  }","+  cpSync(join(rootDir, 'ui/package.json'), join(dir, 'package.json'))","+  writeFileSync(join(dir, 'index.js'), entry)","+}","+","+const runs = runsOncePerBuildInMatrix && isBuilt","+","+if (runs) {","+  installPackageWithHoistedVue(fileURLToPath(fixtureURL))","+}","+","+await setupFixture(fixtureURL, runs)","+","+describe.skipIf(!runs)('a package that imports vue without declaring it', () => {","+  it('renders on the same copy of vue as the app', async () => {","+    expect(await $fetch<string>('/')).toContain('<div><!--[-->rendered slot<!--]--></div>')","+  })","+})"],"additions":52,"deletions":0,"truncated":false},{"path":"test/fixtures/duplicate-vue/app.vue","lines":["@@ -0,0 +1,7 @@","+<script setup lang=\"ts\">","+import SlotWrapper from 'duplicate-vue-ui'","+</script>","+","+<template>","+  <SlotWrapper>rendered slot</SlotWrapper>","+</template>"],"additions":7,"deletions":0,"truncated":false},{"path":"test/fixtures/duplicate-vue/nuxt.config.ts","lines":["@@ -0,0 +1,16 @@","+import { isNuxtPrepare, projectSuffix, withMatrix } from '../../matrix.ts'","+","+export default withMatrix({","+  ...(isNuxtPrepare ? {} : { buildDir: `.nuxt-${projectSuffix}` }),","+  build: {","+    transpile: ['duplicate-vue-ui'],","+  },","+  nitro: {","+    out