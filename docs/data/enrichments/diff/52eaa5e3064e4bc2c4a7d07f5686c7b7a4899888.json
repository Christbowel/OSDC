{"id":"52eaa5e3064e4bc2c4a7d07f5686c7b7a4899888","axis":"silent","repo":"facebook/folly","sha":"52eaa5e3064e4bc2c4a7d07f5686c7b7a4899888","parsed":{"files":[{"path":"folly/result/BUCK","lines":["@@ -178,7 +178,6 @@ fb_dirsync_cpp_library(","         \"//folly:utility\",","         \"//folly/lang:exception\",","         \"//folly/lang:pretty\",","-        \"//folly/portability:source_location\",","         \"//folly/result/detail:rich_exception_ptr_storage\",","     ],"," )","@@ -213,7 +212,6 @@ fb_dirsync_cpp_library(","         \"//folly:utility\",","         \"//folly/lang:exception\",","         \"//folly/lang:safe_assert\",","-        \"//folly/portability:source_location\",","     ],"," )"," "],"additions":0,"deletions":2,"truncated":false},{"path":"folly/result/CMakeLists.txt","lines":["@@ -149,7 +149,6 @@ folly_add_library(","     folly_lang_exception","     folly_lang_pretty","     folly_portability","-    folly_portability_source_location","     folly_result_detail_rich_exception_ptr_storage","     folly_result_rich_error_fwd","     folly_traits","@@ -182,7 +181,6 @@ folly_add_library(","     fmt::fmt","     folly_lang_exception","     folly_lang_safe_assert","-    folly_portability_source_location","     folly_utility"," )"," "],"additions":0,"deletions":2,"truncated":false},{"path":"folly/result/coded_rich_error.h","lines":["@@ -16,6 +16,8 @@"," "," #pragma once"," ","+#include <source_location>","+"," #include <folly/result/rich_error.h>"," #include <folly/result/rich_error_base.h>"," #include <folly/result/rich_error_code.h>","@@ -75,7 +77,7 @@ class coded_rich_error : public rich_error_base {","       rich_msg msg = vtag<literal_string{\"\"}>)","       : codes_{code_entry<Codes>{codes}...}, msg_{std::move(msg)} {}"," ","-  folly::source_location source_location() const noexcept override {","+  std::source_location source_location() const noexcept override {","     return msg_.location();","   }"," "],"additions":3,"deletions":1,"truncated":false},{"path":"folly/result/docs/epitaphs.md","lines":["@@ -45,7 +45,7 @@ There is no way to add rich context *into* the `logic_error`, so we wrap it."," Internally, `epitaph` stores:","   - A `rich_exception_ptr` owning the original `logic_error`, accessible via","     `underlying_error()` for O(1) unwrapping by `get_exception<Ex>()`.","-  - A `source_location` of the `epitaph` call-site.","+  - A `std::source_location` of the `epitaph` call-site.","   - A `rich_msg` message (empty, literal, or heap-formatted)."," "," **Important:** Epitaphs **cannot** add error codes. Codes direct control flow,"],"additions":1,"deletions":1,"truncated":false},{"path":"folly/result/docs/future_epitaph_in_place.md","lines":["@@ -158,7 +158,7 @@ lock, garbling the count. Mitigations:"," #### Nullable entries for tear-free reads"," "," `rich_msg` has two fields: `exception_shared_string` (a pointer) and","-`source_location` (8 bytes). A 16-byte atomic write is costly on most","+`std::source_location` (8 bytes). A 16-byte atomic write is costly on most"," architectures. Fortunately, the single-writer-per-slot invariant means each"," entry has exactly one writer, so we only need reader-writer synchronization."," ","@@ -168,7 +168,7 @@ in `std::atomic`:"," "," ```cpp"," class nullable_rich_msg {","-  source_location loc_;                    // not atomic","+  std::source_location loc_;               // not atomic","   nullable_exception_shared_string str_;   // contains std::atomic<char*>"," "," public:","@@ -185,7 +185,7 @@ public:","   }"," ","   // Precondition: !empty()","-  folly::source_location source_location() const noexcept { return loc_; }","+  std::source_location source_location() const noexcept { return loc_; }"," };"," ```"," "],"additions":3,"deletions":3,"truncated":false},{"path":"folly/result/docs/future_ideas.md","lines":["@@ -151,7 +151,7 @@ These are *roughly* sorted from \"near future\" to \"far future\"."," "," ## Auto-capture locations for immortals on C++23"," ","-A \"nice to have\" would be a way to automatically capture `source_location`","+A \"nice to have\" would be a way to automatically capture `std::source_location`"," while supplying a `rich_msg` to an `immortal_rich_error<MyErr, ...>` template"," parameter list."," ","@@ -159,7 +159,7 @@ You can see a not-very-satisfactory example of what *can* be done today in"," `immortal_rich_error_test.cpp`. Roughly:"," "," ```cpp","-constexpr static auto myLoc = source_location::current();","+constexpr static auto myLoc = std::source_location::current();"," auto rep = immortal_rich_error<MyErr, &myLoc>.ptr();"," ```"," ","@@ -168,27 +168,27 @@ structural helper type implicitly-convertible to `rich_msg` (as with `vtag<Str>`"," today). We do want to use `rich_msg` in the user types, since that offers a"," consistent & good experience for runtime errors."," ","-The trouble is that `source_location` is not structural, and so the helper type","+The trouble is that `std::source_location` is not structural, and so the helper type"," can only store its pointer. But, in C++20, there is no way to allocate static"," storage from a variable -- unless it's `constexpr`, which an auto-captured","-`source_location::current()` could not be. So, we have to wait for C++23 support","+`std::source_location::current()` could not be. So, we have to wait for C++23 support"," of `static constexpr` locals. As of late 2025, this sort of thing only works on"," GCC. Clang wrongly garbage-collects the `loc` symbol, getting a linker error."," And the MSVC on Godbolt doesn't seem to support the C++23 feature yet."," "," ```cpp","-template<const source_location* Loc>","+template<const std::source_location* Loc>"," struct SourceTag { ... };"," #define HERE() \\"," ([] { \\","-  static constexpr auto loc = source_location::current(); \\","+  static constexpr auto loc = std::source_location::current(); \\","   return SourceTag<&loc>{}; \\"," }())"," ```"," "," Technically, one could side-step these issues by creating a custom structural"," type that stores filename & function name as char arrays, and is constructed via","-a macro. Essentially, roll-your-own-`source_location` (be sure to indirect it","+a macro. Essentially, roll-your-own-`std::source_location` (be sure to indirect it"," through a pointer so that `rich_msg` stays 8 bytes!). However, using a"," non-standard type is a heavy interface cost, for a use-case that doesn't seem"," that critical. After all, one can usually easily search for an immortal string"],"additions":7,"deletions":7,"truncated":false},{"path":"folly/result/epitaph.h","lines":["@@ -20,6 +20,7 @@"," #include <cstddef>"," #include <cstdint>"," #include <memory>","+#include <source_location>"," "," #include <folly/CppAttributes.h>"," #include <folly/Portability.h> // FOLLY_HAS_RESULT","@@ -41,10 +42,10 @@ namespace detail {"," // Source location (the regular epitaph case)."," struct epitaph_source_location {","   static constexpr bool has_stack = false;","-  source_location loc_{};","+  std::source_location loc_{};"," ","   epitaph_source_location() = default;","-  explicit epitaph_source_location(source_location loc)","+  explicit epitaph_source_location(std::source_location loc)","       : loc_{std::move(loc)} {} // NOLINT(performance-move-const-arg)"," };"," ","@@ -113,8 +114,9 @@ void format_epitaph_stack("," "," // Common epitaph implementation parameterized on location storage."," //","-//   `epitaph_source_location`: regular epitaph (message + `source_location`)","-//   `epitaph_stack_location<Opt>`: stack epitaph (message + inline frames)","+//   `epitaph_source_location`: regular epitaph (message +","+//   `std::source_location`) `epitaph_stack_location<Opt>`: stack epitaph","+//   (message + inline frames)"," //"," // IMPORTANT: Epitaphs should NEVER support adding codes.  Codes often direct"," // program control flow, whereas epitaphs are inherently discardable.  There","@@ -201,7 +203,7 @@ class epitaph_impl : public rich_error_base {","     setu