\"([^\"]*)\"|'([^']*)'|([^\\\\s>]+))`, 'i');","+\tconst match = pattern.exec(tag);","+\tif (!match) return undefined;","+\tconst value = match[1] ?? match[2] ?? match[3];","+\treturn value === undefined ? undefined : unescape(value);","+}","+","+/**","+ * Extracts the target of a meta refresh `content` value — the part after","+ * `<delay>;url=` — or `undefined` when the value has no `url` directive.","+ */","+function refreshTarget(content: string): string | undefined {","+\tconst separator = content.indexOf(';');","+\tif (separator === -1) return undefined;","+\tconst directive = content.slice(separator + 1).trim();","+\tconst equals = directive.indexOf('=');","+\tif (equals === -1 || directive.slice(0, equals).trim().toLowerCase() !== 'url') {","+\t\treturn undefined;","+\t}","+\treturn stripQuotes(directive.slice(equals + 1).trim());","+}","+","+function stripQuotes(value: string): string {","+\tconst first = value[0];","+\tif ((first === '\"' || first === \"'\") && value.length > 1 && value.endsWith(first)) {","+\t\treturn value.slice(1, -1);","+\t}","+\treturn value;","+}","+","+/**","+ * Reports whether `html` contains a `<meta http-equiv=\"refresh\">` tag pointing at","+ * `location`.","+ *","+ * In a static build the meta refresh tag *is* the redirect — there is no `Location`","+ * header — so a redirect page that omits it, or points it somewhere else, silently","+ * strands visitors.","+ */","+export function hasMetaRefreshTo(html: string, location: string): boolean {","+\tfor (const [tag] of html.matchAll(META_TAG_RE)) {","+\t\tif (attributeValue(tag, 'http-equiv')?.trim().toLowerCase() !== 'refresh') continue;","+\t\tconst content = attributeValue(tag, 'content');","+\t\tif (content !== undefined && refreshTarget(content) === location) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}"],"additions":60,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/routing/astro-designed-error-pages.ts","lines":["@@ -1,8 +1,9 @@"," import 