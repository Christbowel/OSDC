{"id":"0b302391059dbc4f8ece24d7b44599c7ec9fef24","axis":"silent","repo":"withastro/astro","sha":"0b302391059dbc4f8ece24d7b44599c7ec9fef24","parsed":{"files":[{"path":".changeset/olive-moons-repeat.md","lines":["@@ -0,0 +1,52 @@","+---","+'astro': minor","+---","+","+Adds `experimental.redirectPage`, letting you provide your own `src/pages/3xx.astro` in place of the redirect page Astro generates in static builds.","+","+A static site has no server to send an HTTP `Location` header, so Astro generates a small HTML page with a `<meta http-equiv=\"refresh\">` tag for each redirect it builds:","+","+- Your [`redirects`](https://docs.astro.build/en/reference/configuration-reference/#redirects) entries","+- `Astro.redirect()` calls in prerendered pages","+- i18n redirects","+","+That page's markup, wording, and refresh delay were fixed, so you could not brand or translate it.","+","+To enable this feature, add the experimental flag to your Astro config:","+","+```js","+// astro.config.mjs","+import { defineConfig } from 'astro/config';","+","+export default defineConfig({","+  experimental: {","+    redirectPage: true,","+  },","+});","+```","+","+Then create `src/pages/3xx.astro`. Astro renders it once per redirect, passing that redirect's details as props:","+","+```astro","+---","+// src/pages/3xx.astro","+import type { RedirectPageProps as Props } from 'astro';","+","+const { from, to, status, delay } = Astro.props;","+---","+","+<html lang=\"en\">","+  <head>","+    <meta http-equiv=\"refresh\" content={`${delay};url=${to}`} />","+    <meta name=\"robots\" content=\"noindex\" />","+    <title>Redirecting…</title>","+  </head>","+  <body>","+    <p>This page has moved. <a href={to}>Continue to {to}</a>.</p>","+  </body>","+</html>","+```","+","+Your page must render a `<meta http-equiv=\"refresh\">` tag pointing at `to`, because in a static build that tag is the redirect. Astro logs a warning during the build if it is missing.","+","+See the [experimental redirect page documentation](https://docs.astro.build/en/reference/experimental-flags/redirect-page/) for more information."],"additions":52,"deletions":0,"truncated":false},{"path":"packages/astro/src/container/environment.ts","lines":["@@ -154,6 +154,7 @@ export function createContainerEnvironment({"," \t\t},"," "," \t\terrorStrategy: 'default',","+\t\trendersRedirectPage: () => false,"," \t\tinjectCspMetaTagsOnErrorPages: false,"," \t\tlogRequest() {},"," \t};"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/build/common.ts","lines":["@@ -11,8 +11,8 @@ import {"," import type { AstroSettings } from '../../types/astro.js';"," import type { AstroConfig } from '../../types/public/config.js';"," import type { RouteData, RouteType } from '../../types/public/internal.js';","+import { STATUS_CODE_PAGES } from '../constants.js';"," ","-const STATUS_CODE_PAGES = new Set(['/404', '/500']);"," const FALLBACK_OUT_DIR_NAME = './.astro/';"," "," function getOutRoot(astroSettings: AstroSettings): URL {"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/build/default-prerenderer.ts","lines":["@@ -43,7 +43,13 @@ export function createDefaultPrerenderer({"," \t\t\tconst { app }: { app: BuildApp } = await import(prerenderEntryUrl.toString());"," "," \t\t\tapp.setInternals(internals);","-\t\t\tapp.setOptions(options);","+\t\t\tapp.setOptions({","+\t\t\t\tsettings: {","+\t\t\t\t\tscripts: options.settings.scripts,","+\t\t\t\t\tredirectPage: options.settings.config.experimental.redirectPage,","+\t\t\t\t},","+\t\t\t\tlogger: options.logger,","+\t\t\t});"," \t\t\t// Rebuilds in one process reuse the cached module, and its stale static paths."," \t\t\tapp.routeCache.clearAll();"," \t\t\tprerenderer.app = app;"],"additions":7,"deletions":1,"truncated":false},{"path":"packages/astro/src/core/build/environment.ts","lines":["@@ -20,7 +20,7 @@ export interface BuildEnvironmentInternals {"," }"," "," export interface BuildEnvironmentOptions {"