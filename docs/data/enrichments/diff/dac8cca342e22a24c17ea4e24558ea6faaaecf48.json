d here\\n\\s+at .*pkg1.package\\.json:(\\d+:\\d+)/)?.[1],","+    exitCode,","+  }).toEqual({ error: \"1:9\", note: \"5:11\", exitCode: 1 });","+});","+"," // Auto-install reads the project from the folder of the script, not from the root."," test.concurrent(\"a script that imports a missing package reports two workspaces with the same name\", async () => {","   using ctx = await setupTest();"],"additions":30,"deletions":0,"truncated":false},{"path":"test/cli/update_interactive_install.test.ts","lines":["@@ -105,3 +105,117 @@ describe.concurrent(\"bun update --interactive actually installs packages\", () =>","     expect(pkg.dependencies[\"is-even\"]).toBe(\"0.1.0\");","   });"," });","+","+// Installs the workspace in `files`, then types 'l' and Enter into `bun update --interactive`: the first row goes to its Latest.","+async function updateFirstRowToLatest(files: Record<string, string>, cwd: string, args: string[] = []) {","+  using dir = tempDir(\"update-interactive-workspace\", {","+    \"bunfig.toml\": `[install]\\ncache = false\\nregistry = \"${registry.registryUrl()}\"\\nsaveTextLockfile = true\\n`,","+    ...files,","+  });","+","+  await using install = Bun.spawn({ cmd: [bunExe(), \"install\"], cwd: String(dir), env: bunEnv, stderr: \"pipe\" });","+  expect({ stderr: await install.stderr.text(), exitCode: await install.exited }).toMatchObject({ exitCode: 0 });","+","+  await using update = Bun.spawn({","+    cmd: [bunExe(), \"update\", \"--interactive\", ...args],","+    cwd: join(String(dir), cwd),","+    env: bunEnv,","+    stdin: \"pipe\",","+    stdout: \"pipe\",","+    stderr: \"pipe\",","+  });","+  update.stdin.write(\"l\\r\");","+  update.stdin.end();","+  const [stderr, exitCode] = await Promise.all([update.stderr.text(), update.exited, update.stdout.text()]);","+  return {","+    stderr,","+    exitCode,","+    packageJson: await Bun.file(join(String(dir), \"package.json\")).text(),","+    lockfile: await Bun.file(join(String(dir), \"bun.lock\")).text(),","+  };","+}","+","+// `bun update -i` saves the root package.json, and then the install reads it from the cache, not from the file.","+// In each case the install does not save that file again before it reads positions in it.","+describe.concurrent(\"bun update --interactive installs from the package.json that it saved\", () => {","+  // `a-dep` is in two groups: each parse of the root reports the position of the second one.","+  // The save prints LF, so a file with CRLF line endings loses one byte per line. A position in the old text is","+  // then past the end of the new text.","+  const crlfRoot =","+    JSON.stringify(","+      {","+        name: \"root\",","+        workspaces: [\"packages/*\"],","+        catalog: { \"no-deps\": \"^1.0.0\" },","+        scripts: Object.fromEntries(Array.from({ length: 128 }, (_, i) => [`script${i}`, \"true\"])),","+        dependencies: { \"a-dep\": \"1.0.10\" },","+        devDependencies: { \"a-dep\": \"1.0.10\" },","+      },","+      null,","+      2,","+    ).replaceAll(\"\\n\", \"\\r\\n\") + \"\\r\\n\";","+  const catalogMember = JSON.stringify({ name: \"a\", dependencies: { \"no-deps\": \"catalog:\" } });","+  // The save prints the file without the comment.","+  const dependencyRoot = `{","+  \"name\": \"root\",","+  \"workspaces\": [\"packages/*\"],","+  // ${Buffer.alloc(4096, \"-\").toString()}","+  \"dependencies\": { \"a\": \"workspace:*\", \"no-deps\": \"^1.0.0\", \"a-dep\": \"1.0.10\" },","+  \"devDependencies\": { \"a-dep\": \"1.0.10\" }","+}","+`;","+","+  test.each([","+    { row: \"a catalog entry\", from: \"a workspace member\", root: crlfRoot, member: catalogMember, cwd: \"packages/a\" },","+    // `...a` is `a` and its dependents. The install parses the root to find them.","+    {","+      row: \"a dependency of the root\",","+      from: \"the root with a --filter on the dependency graph\",","+      root: dependencyRoot,","+      member: JSON.stringify({ name: \"a\" }),","+      args: [\"--filter\", \"...a\"],","+    },","+  ])(\"updates $row from $from\", async ({ root, member, cwd = \".\", args }) => {","+    const { stderr, exitCode, lockfile, packageJson } = await updateFirstRowToLatest(","+      { \"package.json\": root, \"packages/a/package.json\": member },","+      cwd,","+      args,","+    );","+    // Without these two, an old tree in the cache changes nothing that this test can see.","+    expect(stderr).toContain('Duplicate dependency: \"a-dep\"');","+    expect(packageJson.length).toBeLessThan(root.indexOf('\"a-dep\"'));","+    expect({","+      declared: lockfile.match(/\"no-deps\": \"(\\^[^\"]+)\"/)?.[1],","+      resolved: lockfile.match(/\"no-deps@([^\"]+)\"/)?.[1],","+      exitCode,","+    }).toEqual({ declared: \"^2.0.0\", resolved: \"2.0.0\", exitCode: 0 });","+  });","+","+  test(\"reports a patchedDependencies key at its position in the package.json that it saved\", async () => {","+    // The save prints the catalog on three lines, so the `patchedDependencies` key moves. A key without a version","+    // gets a warning after the install.","+    const { stderr, exitCode, packageJson } = await updateFirstRowToLatest(","+      {","+        \"package.json\": `{","+  \"name\": \"root\",","+  \"workspaces\": [\"packages/*\"],","+  \"catalog\": { \"no-deps\": \"^1.0.0\" },","+  \"patchedDependencies\": {","+    \"no-deps\": \"patches/no-deps.patch\"","+  }","+}","+`,","+        \"patches/no-deps.patch\": `diff --git a/index.js b/index.js\\n--- a/index.js\\n+++ b/index.js\\n@@ -1 +1 @@\\n-module.exports = 1;\\n+module.exports = 2;\\n`,","+        \"packages/a/package.json\": catalogMember,","+      },","+      \"packages/a\",","+    );","+    const linesToKey = packageJson.slice(0, packageJson.indexOf(`\"no-deps\": \"patches/`)).split(\"\\n\");","+    expect({","+      reportedAt: stderr.match(","+        /warn: patchedDependencies keys need a version: no-deps@2\\.0\\.0\\n +at .*package\\.json:(\\d+:\\d+)/,"],"additions":109,"deletions":0,"truncated":false}],"additions":244,"deletions":124,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-10-22T13:45:07.497710+00:00"}