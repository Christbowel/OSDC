ject root,","+          // then `src/`, trying each page extension in config order. Exact","+          // names, so compound extensions like `page.ts` match. Turbopack also","+          // checks parent folders and tries longer extensions first, so with","+          // more than one candidate file the two bundlers can pick different","+          // ones.","+          'private-next-instrumentation-user': [","+            ...['', 'src'].flatMap((subDir) =>","+              pageExtensions.map((ext) =>","+                path.join(dir, subDir, `instrumentation.${ext}`)","+              )","+            ),","+            'private-next-empty-module',","+          ],","+        }),","+","+    // disable typechecker, webpack5 allows aliases to be set to false to create a no-op module","+    'private-next-empty-module': false as any,"," ","     [DOT_NEXT_ALIAS]: distDir,","     ...(isClient || isEdgeServer ? getOptimizedModuleAliases() : {}),"],"additions":21,"deletions":4,"truncated":false},{"path":"packages/next/src/build/index.ts","lines":["@@ -147,6 +147,7 @@ import {","   pageToRoute,"," } from './utils'"," import type { DynamicManifestRoute, PageInfo, PageInfos } from './utils'","+import { INSTRUMENTATION_INJECT_STUB_PATH } from './next-dir-paths'"," import type {","   FallbackRouteParam,","   PrerenderRouteMatcher,","@@ -1535,7 +1536,10 @@ export default async function build(","         )","       }"," ","-      const hasInstrumentationHook = Boolean(instrumentationHookFilePath)","+      const hasInstrumentationInject =","+        (config.instrumentationInject?.length ?? 0) > 0","+      const hasInstrumentationHook =","+        Boolean(instrumentationHookFilePath) || hasInstrumentationInject","       const hasMiddlewareFile = Boolean(middlewareFilePath)","       const hasProxyFile = Boolean(proxyFilePath)"," ","@@ -1577,13 +1581,28 @@ export default async function build(","           createPagesMapping({","             isDev: false,","             pageExtensions: config.pageExtensions,","-            pagePaths: rootPaths,","+            // The stub loads the project's instrumentation file, so don't","+            // create a separate entry for it when instrumentation is injected.","+            pagePaths: hasInstrumentationInject","+              ? rootPaths.filter(","+                  (rootPath) =>","+                    !instrumentationHookDetectionRegExp.test(","+                      path.basename(rootPath)","+                    )","+                )","+              : rootPaths,","             pagesType: PAGE_TYPES.ROOT,","             pagesDir,","             appDir,","             appDirOnly,","           })","         )","+      if (hasInstrumentationInject) {","+        // The stub chains the project's instrumentation file after the","+        // injected entries, so it replaces that file as the entry.","+        NextBuildContext.mappedRootPaths[`/${INSTRUMENTATION_HOOK_FILENAME}`] =","+          INSTRUMENTATION_INJECT_STUB_PATH","+      }"," ","       const {","         pageRoutes,"],"additions":21,"deletions":2,"truncated":false},{"path":"packages/next/src/build/next-dir-paths.ts","lines":["@@ -6,3 +6,14 @@ export const NEXT_PROJECT_ROOT_DIST_CLIENT = path.join(","   NEXT_PROJECT_ROOT_DIST,","   'client'"," )","+","+/**","+ * The webpack entry for the instrumentation slot when `instrumentationInject`","+ * is set. `next-instrumentation-inject-loader` replaces its contents with a","+ * module that runs every entry's hooks, then the project's own","+ * `instrumentation` file.","+ */","+export const INSTRUMENTATION_INJECT_STUB_PATH = path.join(","+  NEXT_PROJECT_ROOT_DIST,","+  'build/webpack/loaders/instrumentation-inject-stub.js'","+)"],"additions":11,"deletions":0,"truncated":false},{"path":"packages/next/src/build/swc/index.ts","lines":["@@ -989,6 +989,17 @@ function bindingToApi(","       )","     }"," ","+    // Turbopack resolves a leading `/` from the project root, so make absolute","+    // instrumentationInject entries relative. Package names stay as they are.","+    if (nextConfigSerializable.instrumentationInject?.length) {","+      nextConfigSerializable.instrumentationInject =","+        nextConfigSerializable.instrumentationInject.map((entry: string) =>","+          path.isAbsolute(entry)","+            ? './' + normalizePathOnWindows(path.relative(projectPath, entry))","+            : entry","+        )","+    }","+","     if (nextConfigSerializable.turbopack != null) {","       // clone to allow in-place mutations","       const turbopack = { ...nextConfigSerializable.turbopack }"],"additions":11,"deletions":0,"truncated":false},{"path":"packages/next/src/build/webpack-config.ts","lines":["@@ -90,6 +90,7 @@ import {","   getReactCompilerLoader,"," } from './get-babel-loader-config'"," import {","+  INSTRUMENTATION_INJECT_STUB_PATH,","   NEXT_PROJECT_ROOT,","   NEXT_PROJECT_ROOT_DIST_CLIENT,"," } from './next-dir-paths'","@@ -1375,6 +1376,7 @@ export default async function getBaseWebpackConfig(","         'next-swc-loader',","         'next-client-pages-loader',","         'next-instrumentation-client-loader',","+        'next-instrumentation-inject-loader',","         'next-image-loader',","         'next-metadata-image-loader',","         'next-style-loader',","@@ -1956,6 +1958,18 @@ export default async function getBaseWebpackConfig(","             },","           },","         },","+        // The server instrumentation entry when `instrumentationInject` is set.","+        // The loader emits one module that runs every entry's hooks, then the","+        // project's own instrumentation file.","+        {","+          test: /[\\\\/]next[\\\\/]dist[\\\\/](esm[\\\\/])?build[\\\\/]webpack[\\\\/]loaders[\\\\/]instrumentation-inject-stub\\.js$/,","+          use: {","+            loader: 'next-instrumentation-inject-loader',","+            options: {","+              modules: config.instrumentationInject ?? [],","+            },","+          },","+        },","         {","           // This loader rule should be before other rules, as it can output code","           // that still contains `\"use client\"` or `\"use server\"` statements that","@@ -1995,6 +2009,18 @@ export default async function getBaseWebpackConfig(","       ],","     },","     plugins: [","+      !isClient &&","+        config.instrumentationInject?.length &&","+        new bundler.NormalModuleReplacementPlugin(","+          new RegExp(","+            `^${escapeStringRegexp(INSTRUMENTATION_INJECT_STUB_PATH)}$`","+          ),","+          ({ createData }) => {","+            if (createData?.resource === INSTRUMENTATION_INJECT_STUB_PATH) {","+              createData.context = dir","+            }","+          }","+        ),","       // In prod Webpack will already have a runtime for all reachable chunks.","       // During dev, it will update the runtime as chunks come in which may be too late for Flight.","       dev && new CompleteRuntimePlugin(),","@@ -2391,6 +2417,8 @@ export default async function getBaseWebpackConfig(","     optimizePackageImports: config?.experimental?.optimizePackageImports,","     crossOrigin: config.crossOrigin,","     pageExtensions: pageExtensions,","+    instrumentationInject: config.instrumentationInject,","+    instrumentationClientInject: config.instrumentationClientInject,","     trailingSlash: config.trailingSlash,","     devIndicatorsPosition:","       config.devIndicators === false"],"additions":28,"deletions":0,"truncated":false},{"path":"packages/next/src/build/webpack/loaders/instrumentation-inject-stub.js","lines":["@@ -0,0 +1,5 @@","+// Placeholder module. When `instrumentationInject` is set, this file is the","+// instrumentation entry. Its contents are replaced by","+// `next-instrumentation-inject-loader` via a `module.rules` entry in","+// webpack-config.ts.","+module.exports = {}"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/next/src/build/webpack/loaders/next-instrumentation-inject-loader.ts","lines":["@@ -0,0 +1,27 @@","+import type { webpack } from 'next/dist/compiled/webpack/webpack'","+","+export type InstrumentationInjectLoaderOptions = {","+  modules: string[]","+}","+","+// Keep in sync with `instrumentation_source` in crates/next-api/src/project.rs.","+const NextInstrumentationInjectLoader: webpack.LoaderDefinitionFunction<InstrumentationInjectLoaderOptions> =","+  function () {","+    const { modules } = this.getOptions()","+","+    // Keep package requests intact so webpack's externals handler can apply","+    // serverExternalPackages and the built-in opt-out list. The webpack config","+    // sets this module's context to the project root before module creation.","+    // The project's own `instrumentation` file runs last, or an empty module","+    // when there is none (see `create-compiler-aliases.ts`).","+    const allModules = [...modules, 'private-next-instrumentation-user']","+","+    return (","+      `const { combineInstrumentation } = require('next/dist/lib/combine-instrumentation');\\n` +","+      `module.exports = combineInstrumentation([${allModules","+        .map((spec) => `require(${JSON.stringify(spec)})`)","+        .join(', ')}]);\\n`","+    )","+  }","+","+export default NextInstrumentationInjectLoader"],"additions":27,"deletions":0,"truncated":false},{"path":"packages/next/src/lib/combine-instrumentation.test.ts","lines":["@@ -0,0 +1,198 @@","+import { combineInstrumentation } from './combine-instrumentation'","+","+const request = { path: '/', method: 'GET', headers: {} }","+const context = {","+  routerKind: 'App Router',","+  routePath: '/',","+  routeType: 'render',","+  revalidateReason: undefined,","+} as const","+","+describe('combineInstrumentation', () => {","+  it('runs every register in array order', async () => {","+    const calls: string[] = []","+    const combined = combineInstrumentation([","+      { register: async () => void calls.push('a') },","+      { register: () => void calls.push('b') },","+    ])","+    await combined.register()","+    expect(calls).toEqual(['a', 'b'])","+  })","+","+  it('keeps running after a register throws, then rethrows that error', async () => {","+    const calls: string[] = []","+    const failure = new Error('a failed')","+    const combined = combineInstrumentation([","+      {","+        register: () => {","+          throw failure","+        },","+      },","+      { register: () => void calls.push('b') },","+    ])","+    await expect(combined.register()).rejects.toBe(failure)","+    expect(calls).toEqual(['b'])","+  })","+","+  it('throws an AggregateError when several hooks fail', async () => {","+    const combined = combineInstrumentation([","+      {","+        register: () => {","+          throw new Error('a')","+        },","+      },","+      {","+        register: async () => {","+          throw new Error('b')","+        },","+      },","+    ])","+    const err: AggregateError = await combined.register().catch((e) => e)","+    expect(err).toBeInstanceOf(AggregateError)","+    expect(err.errors.map((e: Error) => e.message)).toEqual(['a', 'b'])","+  })","+","+  it('passes onRequestError arguments to every module', async () => {","+    const seen: unknown[][] = []","+    const error = new Error('request failed')","+    const combined = combineInstrumentation([","+      {","+        onRequestError: () => {","+          throw new Error('reporter down')","+        },","+      },","+      { onRequestError: (...args: unknown[]) => void seen.push(args) },","+    ])","+    await expect(","+      combined.onRequestError(error, request, context)","+    ).rejects.toThrow('reporter down')","+    expect(seen).toEqual([[error, request, context]])","+  })","+","+  it('runs every onRequestError even when an earlier one never settles', async () => {","+    const calls: string[] = []","+    const combined = combineInstrumentation([","+      { onRequestError: () => new Promise<void>(() => {}) },","+      { onRequestError: () => void calls.push('project') },","+    ])","+    void combined.onRequestError(new Error('boom'), request, context)","+    await new Promise((resolve) => setImmediate(resolve))","+    expect(calls).toEqual(['project'])","+  })","+","+  it('collects onRequestError failures from every module', async () => {","+    const first = new Error('a failed')","+    const second = new Error('b failed')","+    const combined = combineInstrumentation([","+      { onRequestError: () => Promise.reject(first) },","+      {","+        onRequestError: () => {","+          throw second","+        },","+      },","+    ])","+    const error = await combined","+      .onRequestError(new Error('boom'), request, context)","+      .catch((err: unknown) => err)","+    expect(error).toBeInstanceOf(AggregateError)","+    expect((error as AggregateError).errors).toEqual([first, second])","+  })","+","+  it('awaits modules that require() returns as promises', async () => {","+    const calls: string[] = []","+    const combined = combineInstrumentation([","+      Promise.resolve({ register: () => void calls.push('async module') }),","+      { register: () => void calls.push('sync module') },","+    ])","+    await combined.register()","+    expect(calls).toEqual(['async module', 'sync module'])","+  })","+","+  it('collects a module that fails to load and runs the rest', async () => {","+    const calls: string[] = []","+    const failure = new Error('load failed')","+    const combined = combineInstrumentation([","+      Promise.reject(failure),","+      { register: () => void calls.push('b') },","+    ])","+    await expect(combined.register()).rejects.toBe(failure)","+    expect(calls).toEqual(['b'])","+  })","+","+  it('does not leave a later module rejection unhandled while an earlier hook awaits', async () => {","+    const unhandled: unknown[] = []","+    const onUnhandled = (reason: unknown) => void unhandled.push(reason)","+    process.on('unhandledRejection', onUnhandled)","+    try {","+      const failure = new Error('load failed')","+      let rejectLater!: (err: unknown) => void","+      const later = new Promise((_, reject) => (rejectLater = reject))","+      const combined = combineInstrumentation([","+        {","+          register: async () => {","+            rejectLater(failure)","+            // Let Node detect unhandled rejections while this hook waits.","+            await new Promise((resolve) => setTimeout(resolve, 10))","+          },","+        },","+        later,","+      ])","+      await expect(combined.register()).rejects.toBe(failure)","+      expect(unhandled).toEqual([])","+    } finally {","+      process.off('unhandledRejection', onUnhandled)","+    }","+  })","+","+  it('skips missing hooks and reads hooks from a default export', async () => {","+    const calls: string[] = []","+    const combined = combineInstrumentation([","+      {},","+      { default: { register: () => void calls.push('default') } },","+      undefined,","+    ])","+    await combined.register()","+    await combined.onRequestError(new Error('x'), request, context)","+    expect(calls).toEqual(['default'])","+  })","+","+  it('prefers the default export over named hooks after awaiting the module', async () => {","+    const register = jest.fn()","+    const onRequestError = jest.fn()","+    const namedRegister = jest.fn()","+    const namedOnRequestError = jest.fn()","+    const instrumentation = { register, onRequestError }","+    const combined = combineInstrumentation([","+      Promise.resolve({","+        default: instrumentation,","+        register: namedRegister,","+        onRequestError: namedOnRequestError,","+      }),","+    ])","+    const error = new Error('request failed')","+","+    await combined.register()","+    await combined.onRequestError(error, request, context)","+","+    expect(register).toHaveBeenCalledTimes(1)","+    expect(register.mock.contexts).toEqual([instrumentation])","+    expect(onRequestError).toHaveBeenCalledWith(error, request, context)","+    expect(onRequestError.mock.contexts).toEqual([instrumentation])","+    expect(namedRegister).not.toHaveBeenCalled()","+    expect(namedOnRequestError).not.toHaveBeenCalled()","+  })","+","+  it('does not fall back to named hooks when the default export omits them', async () => {","+    const register = jest.fn()","+    const onRequestError = jest.fn()","+    const combined = combineInstrumentation([","+      { default: {}, register, onRequestError },","+    ])","+","+    await combined.register()","+    await combined.onRequestError(new Error('request failed'), request, context)","+","+    expect(register).not.toHaveBeenCalled()","+    expect(onRequestError).not.toHaveBeenCalled()","+  })","+})"],"additions":198,"deletions":0,"truncated":false},{"path":"packages/next/src/lib/combine-instrumentation.ts","lines":["@@ -0,0 +1,94 @@","+import type {","+  InstrumentationModule,","+  InstrumentationOnRequestError,","+} from '../server/instrumentation/types'","+import { interopDefault } from './interop-default'","+","+type Hook = keyof InstrumentationModule","+","+type CombinedInstrumentation = {","+  register(): Promise<void>","+  onRequestError(","+    ...args: Parameters<InstrumentationOnRequestError>","+  ): Promise<void>","+}","+","+/**","+ * Combines the `instrumentationInject` modules and the project's own","+ * instrumentation file into one instrumentation module. `register` runs every","+ * module's export in array order. `onRequestError` runs them concurrently, so","+ * one handler can't hold up another. A hook that throws, or a module with","+ * top-level await that fails to load, does not stop the others. Errors are","+ * rethrown after all have run.","+ */","+export function combineInstrumentation(","+  modules: readonly unknown[]","+): CombinedInstrumentation {","+  // Every module is required before any hook runs, so an async module can","+  // reject while an earlier hook is still awaiting. Mark those promises as","+  // handled now. `callEach` still awaits them and collects the error.","+  for (const mod of modules) {","+    if (typeof (mod as PromiseLike<unknown> | undefined)?.then === 'function') {","+      ;(mod as PromiseLike<unknown>).then(undefined, () => {})","+    }","+  }","+","+  async function callHook(mod: unknown, name: Hook, args: unknown[]) {","+    // `require()` returns a promise for a module that uses top-level await. If","+    // one of those fails to load, its error is collected like a hook error. A","+    // module without top-level await that throws while loading stops startup","+    // before this runs.","+    const instrumentation = interopDefault((await mod) ?? {}) as Record<","+      string,","+      unknown","+    >","+    const hook = instrumentation[name]","+    if (typeof hook === 'function') await hook.apply(instrumentation, args)","+  }","+","+  function throwCollected(name: Hook, errors: unknown[]) {","+    if (errors.length === 1) {","+      throw errors[0]","+    }","+    if (errors.length > 1) {","+      throw new AggregateError(","+        errors,","+        `${errors.length} instrumentation modules failed in ${name}()`","+      )","+    }","+  }","+","+  // `register` runs in array order, so a later module can rely on an earlier","+  // one having set up.","+  async function registerInOrder() {","+    const errors: unknown[] = []","+    for (const mod of modules) {","+      try {","+        await callHook(mod, 'register', [])","+      } catch (err) {","+        errors.push(err)","+      }","+    }","+    throwCollected('register', errors)","+  }","+","+  // `onRequestError` handlers are independent, so they run together: a slow or","+  // hanging injected handler can't stop the project's own handler from running.","+  async function reportToAll(args: unknown[]) {","+    const results = await Promise.allSettled(","+      modules.map((mod) => callHook(mod, 'onRequestError', args))","+    )","+    throwCollected(","+      'onRequestError',","+      re