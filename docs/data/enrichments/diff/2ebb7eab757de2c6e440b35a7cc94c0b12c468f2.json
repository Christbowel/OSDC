+2630,68 @@ impl Project {","         ))","     }"," ","+    /// The source compiled into the instrumentation slot. Without `instrumentationInject`, that is","+    /// the project's instrumentation file, including one in a parent directory. Otherwise a","+    /// virtual module at the project root requires every `instrumentationInject` entry, so the","+    /// bundler resolves them there, then the project's file, and runs all of their hooks.","+    /// `entrypoints` and `instrumentation_endpoint` both read this.","+    #[turbo_tasks::function]","+    async fn instrumentation_source(self: Vc<Self>) -> Result<Vc<OptionSource>> {","+        let project_file = match &*self.find_instrumentation().await? {","+            FindContextFileResult::Found(fs_path, _) => Some(fs_path.clone()),","+            _ => None,","+        };","+        let inject = self.next_config().instrumentation_inject().await?;","+        if inject.is_empty() {","+            let Some(fs_path) = project_file else {","+                return Ok(Vc::cell(None));","+            };","+            let source = Vc::upcast::<Box<dyn Source>>(FileSource::new(fs_path));","+            return Ok(Vc::cell(Some(source.to_resolved().await?)));","+        }","+        let project_path = self.project_path().owned().await?;","+        let mut specifiers: Vec<RcStr> = inject.iter().cloned().collect();","+        if let Some(fs_path) = &project_file {","+            let request = project_path","+                .get_relative_request_to(fs_path)","+                .context(\"project instrumentation file is outside the project filesystem\")?;","+            specifiers.push(request);","+        }","+        // Keep in sync with","+        // packages/next/src/build/webpack/loaders/next-instrumentation-inject-loader.ts.","+        let requires = specifiers","+            .iter()","+            .map(|spec| {","+                Ok(format!(","+                    \"require({})\",","+                    serde_json::to_string