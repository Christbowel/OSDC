{"id":"400c5b2d2021e12f116e246a3dd483c07c389c8e","axis":"silent","repo":"owncloud/core","sha":"400c5b2d2021e12f116e246a3dd483c07c389c8e","parsed":{"files":[{"path":"changelog/unreleased/41779","lines":["@@ -0,0 +1,19 @@","+Bugfix: Do not echo secrets when setting config values via occ","+","+config:system:set and config:app:set printed the value that had just been","+written back to stdout, so every secret configured through occ ended up in the","+terminal scrollback, the container log or the CI log of whoever ran the command.","+WOPI signing keys and the JWT secrets of apps leaked out of Docker deployments","+that configure them from a startup hook this way.","+","+Both commands now print a placeholder instead of the value when the config key","+holds a secret. Recognition reuses the existing list of sensitive keys in","+OC\\SystemConfig, which gained an accessor telling whether a key path is","+sensitive, and falls back to matching the key name against the patterns","+credential, key, passwd, password, pwd, salt, secret and token. That fallback","+covers the keys of apps, which core does not know, such as wopi.token.key or","+jwt_secret. Boolean values keep being shown, as they cannot hold a secret. Only","+the confirmation output changed, the stored value is written as before.","+","+https://github.com/owncloud/core/issues/41779","+https://github.com/owncloud/core/pull/41780"],"additions":19,"deletions":0,"truncated":false},{"path":"core/Command/Config/App/SetConfig.php","lines":["@@ -22,6 +22,7 @@"," namespace OC\\Core\\Command\\Config\\App;"," "," use OC\\Core\\Command\\Base;","+use OC\\Core\\Command\\Config\\SensitiveValueTrait;"," use OCP\\IConfig;"," use Symfony\\Component\\Console\\Input\\InputArgument;"," use Symfony\\Component\\Console\\Input\\InputInterface;","@@ -29,6 +30,8 @@"," use Symfony\\Component\\Console\\Output\\OutputInterface;"," "," class SetConfig extends Base {","+\tuse SensitiveValueTrait;","+"," \t/** * @var IConfig */"," \tprotected $config;"," ","@@ -93,7 +96,11 @@ protected function execute(InputInterface $input, OutputInterface $output): int"," \t\t$configValue = $input->getOption('value');"," \t\t$this->config->setAppValue($appName, $configName, $configValue);"," ","-\t\t$output->writeln('<info>Config value ' . $configName . ' for app ' . $appName . ' set to ' . $configValue . '</info>');","+\t\t// secrets are never echoed, so that they do not end up in the terminal","+\t\t// scrollback or in any log tailing it","+\t\t$readableValue = $this->isSensitiveKeyName($configName) ? IConfig::SENSITIVE_VALUE : $configValue;","+","+\t\t$output->writeln('<info>Config value ' . $configName . ' for app ' . $appName . ' set to ' . $readableValue . '</info>');"," \t\treturn 0;"," \t}"," }"],"additions":8,"deletions":1,"truncated":false},{"path":"core/Command/Config/SensitiveValueTrait.php","lines":["@@ -0,0 +1,70 @@","+<?php","+/**","+ * @author Thomas Müller <thomas.mueller@tmit.eu>","+ *","+ * @copyright Copyright (c) 2026, ownCloud GmbH","+ * @license AGPL-3.0","+ *","+ * This code is free software: you can redistribute it and/or modify","+ * it under the terms of the GNU Affero General Public License, version 3,","+ * as published by the Free Software Foundation.","+ *","+ * This program is distributed in the hope that it will be useful,","+ * but WITHOUT ANY WARRANTY; without even the implied warranty of","+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the","+ * GNU Affero General Public License for more details.","+ *","+ * You should have received a copy of the GNU Affero General Public License, version 3,","+ * along with this program.  If not, see <http://www.gnu.org/licenses/>","+ *","+ */","+","+namespace OC\\Core\\Command\\Config;","+","+/**","+ * Recognizes config keys which hold secrets, so that commands never echo their","+ * value back to the terminal, the container log or the CI log.","+ *","+ * The authoritative list of known core config keys lives in","+ * \\OC\\SystemConfig::$sensitiveValues and is exact match only. It cannot cover","+ * the keys of apps - core does not know them - so these name patterns act as a","+ * fallback for anything not on that list, e.g. \"wopi.token.key\" or the","+ * \"jwt_secret\" of an app.","+ */","+trait SensitiveValueTrait {","+\t/**","+\t * Substrings which mark a config key as holding a secret. Matched case","+\t * insensitively against the key name.","+\t *","+\t * @var string[]","+\t */","+\tprivate static $sensitiveNamePatterns = [","+\t\t'credential',","+\t\t'key',","+\t\t'passwd',","+\t\t'password',","+\t\t'pwd',","+\t\t'salt',","+\t\t'secret',","+\t\t'token',","+\t];","+","+\t/**","+\t * Checks whether any of the given config key names indicates a secret.","+\t *","+\t * @param string ...$names","+\t * @return bool","+\t */","+\tprotected function isSensitiveKeyName(...$names) {","+\t\tforeach ($names as $name) {","+\t\t\t$name = \\strtolower((string) $name);","+\t\t\tforeach (self::$sensitiveNamePatterns as $pattern) {","+\t\t\t\tif (\\strpos($name, $pattern) !== false) {","+\t\t\t\t\treturn true;","+\t\t\t\t}","+\t\t\t}","+\t\t}","+","+\t\treturn false;","+\t}","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"core/Command/Config/System/SetConfig.php","lines":["@@ -23,13 +23,17 @@"," namespace OC\\Core\\Command\\Config\\System;"," "," use OC\\Core\\Command\\Base;","+use OC\\Core\\Command\\Config\\SensitiveValueTrait;"," use OC\\SystemConfig;","+use OCP\\IConfig;"," use Symfony\\Component\\Console\\Input\\InputArgument;"," use Symfony\\Component\\Console\\Input\\InputInterface;"," use Symfony\\Component\\Console\\Input\\InputOption;"," use Symfony\\Component\\Console\\Output\\OutputInterface;"," "," class SetConfig extends Base {","+\tuse SensitiveValueTrait;","+"," \t/** * @var SystemConfig */"," \tprotected $systemConfig;"," ","@@ -77,7 +81,9 @@ protected function configure() {"," \tprotected function execute(InputInterface $input, OutputInterface $output): int {"," \t\t$configNames = $input->getArgument('name');"," \t\t$configName = $configNames[0];","-\t\t$configValue = $this->castValue($input->getOption('value'), $input->getOption('type'));","+\t\t$sensitive = $this->systemConfig->isSensitiveKey($configNames)","+\t\t\t|| $this->isSensitiveKeyName(...$configNames);","+\t\t$configValue = $this->castValue($input->getOption('value'), $input->getOption('type'), $sensitive);"," \t\t$updateOnly = $input->getOption('update-only');"," "," \t\tif ($configName === '') {","@@ -111,10 +117,12 @@ protected function execute(InputInterface $input, OutputInterface $output): int"," \t/**"," \t * @param string $value"," \t * @param string $type","+\t * @param bool $sensitive when true the readable value holds a placeholder","+\t *                        instead of the value itself"," \t * @return mixed"," \t * @throws \\InvalidArgumentException"," \t */","-\tprotected function castValue($value, $type) {","+\tprotected function castValue($value, $type, $sensitive = false) {"," \t\tswitch ($type) {"," \t\t\tcase 'integer':"," \t\t\tcase 'int':","@@ -123,7 +131,7 @@ protected function castValue($value, $type) {"," \t\t\t\t}"," \t\t\t\treturn ["," \t\t\t\t\t'value' => (int) $value,","-\t\t\t\t\t'readable-value' => 'integer ' . (int) $value,","+\t\t\t\t\t'readable-value' => 'integer ' . $this->readableValue((int) $value, $sensitive),"," \t\t\t\t];"," "," \t\t\tcase 'double':","@@ -133,11 +141,13 @@ protected function castValue($value, $type) {"," \t\t\t\t}"," \t\t\t\treturn ["," \t\t\t\t\t'value' => (double) $value,","-\t\t\t\t\t'readable-value' => 'double ' . (double) $value,","+\t\t\t\t\t'readable-value' => 'double ' . $this->readableValue((double) $value, $sensitive),"," \t\t\t\t];"," "," \t\t\tcase 'boolean':"," \t\t\tcase 'bool':","+\t\t\t\t// a boolean cannot hold a secret - both of its values are","+\t\t\t\t// public knowledge - so it is never masked"," \t\t\t\t$value = \\strtolower($value);"," \t\t\t\tswitch ($value) {"," \t\t\t\t\tcase 'true':","@@ -167,7 +177,7 @@ protected function castValue($value, $type) {"," \t\t\t\t$value = (string) $value;"," \t\t\t\treturn ["," \t\t\t\t\t'value' => $value,","-\t\t\t\t\t'readable-value' => ($value === '') ? 'empty string' : 'string ' . $value,","+\t\t\t\t\t'readable-value' => ($value === '') ? 'empty string' : 'string ' . $this->readableValue($value, $sensitive),"," \t\t\t\t];"," "," \t\t\tcase 'json':","@@ -177,7 +187,7 @@ protected function castValue($value, $type) {"," \t\t\t\t}"," \t\t\t\treturn ["," \t\t\t\t\t'value' => $decodedJson,","-\t\t\t\t\t'readable-value' => 'json ' . $value,","+\t\t\t\t\t'readable-value' => 'json ' . $this->readableValue($value, $sensitive),"," \t\t\t\t];"," "," \t\t\tdefault:","@@ -185,6 +195,18 @@ protected function castValue($value, $type) {"," \t\t}"," \t}"," ","+\t/**","+\t * The value as it is shown to the user - secrets are never echoed, so that","+\t * they do not end up in the terminal scrollback or in any log tailing it.","+\t *","+\t * @param mixed $value","+\t * @param bool $sensitive","+\t * @return string","+\t */","+\tprivate function readableValue($value, $sensitive) {","+\t\treturn $sensitive ? IConfig::SENSITIVE_VALUE : (string) $value;","+\t}","+"," \t/**"," \t * @param array $configNames"," \t * @param mixed $existingValues"],"additions":28,"deletions":6,"truncated":false},{"path":"lib/private/SystemConfig.php","lines":["@@ -141,6 +141,48 @@ public function getFilteredValue($key, $default = '') {"," \t\treturn $value;"," \t}"," ","+\t/**","+\t * Checks whether the value stored under the given key path holds sensitive","+\t * data, based on the very same list that getFilteredValue() uses.","+\t *","+\t * A key is reported as sensitive when it is marked as such itself, or when","+\t * it is the parent of a sensitive key - setting or printing the parent","+\t * passes the nested secret along as well.","+\t *","+\t * @param array $keys key path, e.g. ['redis', 'password']","+\t * @return bool","+\t */","+\tpublic function isSensitiveKey(array $keys) {","+\t\t$definition = $this->sensitiveValues;","+","+\t\tforeach ($keys as $key) {","+\t\t\tif (!\\is_array($definition)) {","+\t\t\t\treturn false;","+\t\t\t}","+","+\t\t\tif (!isset($definition[$key])) {","+\t\t\t\t/*","+\t\t\t\t * The 0 key indicates a possibly repeating array of actual","+\t\t\t\t * entries 0,1,2,3... - they all share the same definition.","+\t\t\t\t */","+\t\t\t\tif (\\is_numeric($key) && isset($definition[0])) {","+\t\t\t\t\t$definition = $definition[0];","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+\t\t\t\treturn false;","+\t\t\t}","+","+\t\t\t$definition = $definition[$key];","+","+\t\t\tif ($definition === true) {","+\t\t\t\treturn true;","+\t\t\t}","+\t\t}","+","+\t\t// the remaining definition still holds sensitive keys below this path","+\t\treturn $keys !== [] && \\is_array($definition);","+\t}","+"," \t/**"," \t * Delete a system wide defined value"," \t *"],"additions":42,"deletions":0,"truncated":false},{"path":"tests/Core/Command/Config/App/SetConfigTest.php","lines":["@@ -22,6 +22,7 @@"," namespace Tests\\Core\\Command\\Config\\App;"," "," use OC\\Core\\Command\\Config\\App\\SetConfig;","+use OCP\\IConfig;"," use Test\\TestCase;"," "," class SetConfigTest extends TestCase {","@@ -113,4 +114,65 @@ public function testSet($configName, $newValue, $configExists, $updateOnly, $upd"," "," \t\tself::invokePrivate($this->command, 'execute', [$this->consoleInput, $this->consoleOutput]);"," \t}","+","+\tpublic function sensitiveValueProvider() {","+\t\treturn [","+\t\t\t['jwt_secret', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t['token', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t['wopi_key', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t['smtp_password', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t['bind_pwd', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t['user_salt', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t['api_credentials', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t// name matching is case insensitive","+\t\t\t['JWT_SECRET', 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw', true],","+\t\t\t// harmless keys keep showing the value","+\t\t\t['DocumentServerUrl', 'https://example.com/onlyoffice', false],","+\t\t\t['enabled', 'yes', false],","+\t\t];","+\t}","+","+\t/**","+\t * @dataProvider sensitiveValueProvider","+\t *","+\t * @param string $configName","+\t * @param string $newValue","+\t * @param bool $expectMasked","+\t */","+\tpublic function testSensitiveValueIsNotEchoed($configName, $newValue, $expectMasked) {","+\t\t$this->config->method('getAppKeys')","+\t\t\t->with('app-name')","+\t\t\t->willReturn([$configName]);","+","+\t\t$this->consoleInput->method('getArgument')","+\t\t\t->willReturnMap([","+\t\t\t\t['app', 'app-name'],","+\t\t\t\t['name', $configName],","+\t\t\t]);","+\t\t$this->consoleInput->method('getOption')","+\t\t\t->with('value')","+\t\t\t->willReturn($newValue);","+\t\t$this->consoleInput->method('hasParameterOption')","+\t\t\t->with('--update-only')","+\t\t\t->willReturn(false);","+","+\t\t$message = null;","+\t\t$this->consoleOutput->expects($this->once())","+\t\t\t->method('writeln')","+\t\t\t->willReturnCallback(function ($line) use (&$message) {","+\t\t\t\t$message = $line;","+\t\t\t});","+","+\t\tself::invokePrivate($this->command, 'execute', [$this->consoleInput, $this->consoleOutput]);","+","+\t\t$this->assertStringContainsString($configName, $message);","+\t\t$this->assertStringContainsString('app-name', $message);","+\t\tif ($expectMasked) {","+\t\t\t$this->assertStringNotContainsString($newValue, $message);","+\t\t\t$this->assertStringContainsString(IConfig::SENSITIVE_VALUE, $message);","+\t\t} else {","+\t\t\t$this->assertStringContainsString($newValue, $message);","+\t\t\t$this->assertStringNotContainsString(IConfig::SENSITIVE_VALUE, $message);","+\t\t}","+\t}"," }"],"additions":62,"deletions":0,"truncated":false},{"path":"tests/Core/Command/Config/System/SetConfigTest.php","lines":["@@ -22,6 +22,7 @@"," namespace Tests\\Core\\Command\\Config\\System;"," "," use OC\\Core\\Command\\Config\\System\\SetConfig;","+use OCP\\IConfig;"," use Test\\TestCase;"," "," class SetConfigTest extends TestCase {","@@ -161,6 +162,76 @@ public function testSetJson($configNames, $newValue, $existingData, $expectedVal"," \t\tself::invokePrivate($this->command, 'execute', [$this->consoleInput, $this->consoleOutput]);"," \t}"," ","+\tpublic function sensitiveValueProvider() {","+\t\treturn [","+\t\t\t// masked because the key is on the SystemConfig sensitive list","+\t\t\t[['dbpassword'], 'string', 'topsecret', true, true],","+\t\t\t[['log.condition', 0, 'shared_secret'], 'string', 'topsecret', true, true],","+\t\t\t// masked because the key name matches a sensitive name pattern,","+\t\t\t// even though it is not on the list","+\t\t\t[['wopi.token.key'], 'string', 'Pc7rTwpsnKfT3NfpvbChTPMxVfMr9X7t', false, true],","+\t\t\t[['some_app.api_secret'], 'string', 'topsecret', false, true],","+\t\t\t[['custom.smtp_password'], 'string', 'topsecret', false, true],","+\t\t\t[['ldap.bind_pwd'], 'string', 'topsecret', false, true],","+\t\t\t[['some.private_salt'], 'string', 'topsecret', false, true],","+\t\t\t[['aws.credentials'], 'json', '{\"a\":\"topsecret\"}', false, true],","+\t\t\t// a secret can be numeric as well","+\t\t\t[['some.secret_pin'], 'integer', '123456', false, true],","+\t\t\t// name matching is case insensitive","+\t\t\t[['My.Secret.Thing'], 'string', 'topsecret', false, true],","+\t\t\t// harmless keys keep showing the value","+\t\t\t[['loglevel'], 'integer', '2', false, false],","+\t\t\t[['trusted_domains'], 'string', 'example.com', false, false],","+\t\t\t// a boolean holds no secret, so it stays readable even when the key","+\t\t\t// name matches a pattern - \"token_auth_enforced\" is a real example","+\t\t\t[['token_auth_enforced'], 'boolean', 'true', false, false],","+\t\t\t[['grace_period.demo_key.show_popup'], 'boolean', 'false', false, false],","+\t\t];","+\t}","+","+\t/**","+\t * @dataProvider sensitiveValueProvider","+\t *","+\t * @param array $configNames","+\t * @param string $type","+\t * @param string $newValue","+\t * @param bool $onSensitiveList","+\t * @param bool $expectMasked","+\t */","+\tpublic function testSensitiveValueIsNotEchoed($configNames, $type, $newValue, $onSensitiveList, $expectMasked) {","+\t\t$this->systemConfig->method('isSensitiveKey')","+\t\t\t->willReturn($onSensitiveList);","+\t\t$this->systemConfig->method('getValue')","+\t\t\t->willReturn(null);","+","+\t\t$this->consoleInput->method('getArgument')","+\t\t\t->with('name')","+\t\t\t->willReturn($configNames);","+\t\t$this->consoleInput->method('getOption')","+\t\t\t->will($this->returnValueMap([","+\t\t\t\t['value', $newValue],","+\t\t\t\t['type', $type],","+\t\t\t]));","+","+\t\t$message = null;","+\t\t$this->consoleOutput->expects($this->once())","+\t\t\t->method('writeln')","+\t\t\t->willReturnCallback(function ($line) use (&$message) {","+\t\t\t\t$message = $line;","+\t\t\t});","+","+\t\tself::invokePrivate($this->command, 'execute', [$this->consoleInput, $this->consoleOutput]);","+","+\t\t$this->assertStringContainsString(\\implode(' => ', $configNames), $message);","+\t\tif ($expectMasked) {","+\t\t\t$this->assertStringNotContainsString($newValue, $message);","+\t\t\t$this->assertStringContainsString(IConfig::SENSITIVE_VALUE, $message);","+\t\t} else {","+\t\t\t$this->assertStringContainsString($newValue, $message);","+\t\t\t$this->assertStringNotContainsString(IConfig::SENSITIVE_VALUE, $message);","+\t\t}","+\t}","+"," \tpublic function castValueProvider() {"," \t\treturn ["," \t\t\t[null, 'string', ['value' => '', 'readable-value' => 'empty string']],"],"additions":71,"deletions":0,"truncated":false},{"path":"tests/acceptance/features/bootstrap/OccContext.php","lines":["@@ -933,6 +933,32 @@ public function theCommandOutputContainsTheText(string $text):void {"," \t\t);"," \t}"," ","+\t/**","+\t * @Then /^the command output should not contain the text ((?:'[^']*')|(?:\"[^\"]*\"))$/","+\t *","+\t * @param string $text","+\t *","+\t * @return void","+\t * @throws Exception","+\t */","+\tpublic function theCommandOutputDoesNotContainTheText(string $text):void {","+\t\t// The capturing group of the regex always includes the quotes at each","+\t\t// end of the captured string, so trim them.","+\t\t$text = \\trim($text, $text[0]);","+\t\t$commandOutput = $this->featureContext->getStdOutOfOccCommand();","+\t\t$lines = SetupHelper::findLines(","+\t\t\t$commandOutput,","+\t\t\t$text","+\t\t);","+\t\tAssert::assertCount(","+\t\t\t0,","+\t\t\t$lines,","+\t\t\t\"The command output should not contain the text on stdout '$text'\\n\" .","+\t\t\t\"The command output on stdout was:\\n\" .","+\t\t\t$commandOutput","+\t\t);","+\t}","+"," \t/**"," \t * @Then /^the command output should contain the text ((?:'[^']*')|(?:\"[^\"]*\")) about user \"([^\"]*)\"$/"," \t *"],"additions":26,"deletions":0,"truncated":false},{"path":"tests/acceptance/features/cliMain/configKey.feature","lines":["@@ -42,6 +42,26 @@ Feature: add and delete app configs using occ command","     And system config key \"con\" should have value \"\""," "," ","+  Scenario: admin adds a system config holding a secret and the value is not echoed","+    When the administrator adds system config key \"wopi.token.key\" with value \"Pc7rTwpsnKfT3NfpvbChTPMxVfMr9X7t\" using the occ command","+    Then the command should have been successful","+    And the command output should not contain the text 'Pc7rTwpsnKfT3NfpvbChTPMxVfMr9X7t'","+    And the command output should contain the text 'System config value wopi.token.key set to string ***REMOVED SENSITIVE VALUE***'","+    And system config key \"wopi.token.key\" should have value \"Pc7rTwpsnKfT3NfpvbChTPMxVfMr9X7t\"","+    When the administrator deletes system config key \"wopi.token.key\" using the occ command","+    Then the command should have been successful","+","+","+  Scenario: admin adds an app config holding a secret and the value is not echoed","+    When the administrator adds config key \"jwt_secret\" with value \"VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw\" in app \"core\" using the occ command","+    Then the command should have been successful","+    And the command output should not contain the text 'VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw'","+    And the command output should contain the text 'Config value jwt_secret for app core set to ***REMOVED SENSITIVE VALUE***'","+    And the config key \"jwt_secret\" of app \"core\" should have value \"VmNz3qhMWjsxnw4rMPpFxnM7C9hg9Xw\"","+    When the administrator deletes config key \"jwt_secret\" of app \"core\" using the occ command","+    Then the command should have been successful","+","+","   Scenario: admin tries to add an empty config key for an app using the occ command","     When the administrator adds config key \"''\" with value \"conkey\" in app \"core\" using the occ command","     Then the command should have failed with exit code 1"],"additions":20,"deletions":0,"truncated":false},{"path":"tests/lib/SystemConfigTest.php","lines":["@@ -249,6 +249,54 @@ public function testGetFilteredValue($key, $default, $returnedValue, $expectedVa"," \t\t}"," \t}"," ","+\tpublic function dataIsSensitiveKey() {","+\t\treturn [","+\t\t\t// plain sensitive keys","+\t\t\t[['dbpassword'], true],","+\t\t\t[['passwordsalt'], true],","+\t\t\t[['secret'], true],","+\t\t\t[['license-key'], true],","+\t\t\t// nested sensitive keys","+\t\t\t[['redis', 'password'], true],","+\t\t\t[['objectstore', 'arguments', 'password'], true],","+\t\t\t[['objectstore', 'arguments', 'options', 'credentials', 'secret'], true],","+\t\t\t[['openid-connect', 'client-secret'], true],","+\t\t\t// repeating numeric entries, the list defines them under key 0","+\t\t\t[['log.condition', 0, 'shared_secret'], true],","+\t\t\t[['log.conditions', 0, 'shared_secret'], true],","+\t\t\t[['log.conditions', 3, 'shared_secret'], true],","+\t\t\t// the console passes the key path as strings","+\t\t\t[['log.conditions', '3', 'shared_secret'], true],","+\t\t\t[['log.conditions', '0', 'logfile'], false],","+\t\t\t// a parent of a sensitive key is sensitive as a whole, because","+\t\t\t// setting it means passing the nested secret along","+\t\t\t[['redis'], true],","+\t\t\t[['objectstore', 'arguments'], true],","+\t\t\t[['log.conditions'], true],","+\t\t\t// harmless neighbours of sensitive keys","+\t\t\t[['redis', 'host'], false],","+\t\t\t[['objectstore', 'arguments', 'bucket'], false],","+\t\t\t[['log.conditions', 0, 'logfile'], false],","+\t\t\t// plain harmless keys","+\t\t\t[['loglevel'], false],","+\t\t\t[['trusted_domains'], false],","+\t\t\t[[], false],","+\t\t\t// keys of third party apps are not part of the list - those are","+\t\t\t// caught by the name patterns of the config:*:set commands","+\t\t\t[['wopi.token.key'], false],","+\t\t];","+\t}","+","+\t/**","+\t * @dataProvider dataIsSensitiveKey","+\t *","+\t * @param array $keys","+\t * @param bool $expected","+\t */","+\tpublic function testIsSensitiveKey($keys, $expected) {","+\t\t$this->assertSame($expected, $this->systemConfig->isSensitiveKey($keys));","+\t}","+"," \tpublic function testDeleteValue() {"," \t\t$key = 'mahkey';"," \t\t$this->config->expects($this->once())",""],"additions":48,"deletions":0,"truncated":false}],"additions":394,"deletions":7,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-08-19T08:08:03.062799+00:00"}