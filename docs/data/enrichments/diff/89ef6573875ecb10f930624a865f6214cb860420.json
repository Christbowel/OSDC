e('owner', 'repo', 'docs/../.Git/config', 'content');","+    }","+","     public function testCreateFileRejectsEmptyPath(): void","     {","         $this->expectException(\\Exception::class);"],"additions":7,"deletions":0,"truncated":false},{"path":"packages/vcs/tests/GitTest.php","lines":["@@ -0,0 +1,60 @@","+<?php","+","+declare(strict_types=1);","+","+namespace Utopia\\VCS\\Tests;","+","+use PHPUnit\\Framework\\TestCase;","+","+final class GitTest extends TestCase","+{","+    private string $root;","+","+    protected function setUp(): void","+    {","+        $this->root = sys_get_temp_dir() . '/vcs-checkout-' . bin2hex(random_bytes(6));","+        mkdir($this->root . '/checkout', 0777, true);","+        mkdir($this->root . '/outside');","+    }","+","+    protected function tearDown(): void","+    {","+        exec('rm -rf ' . escapeshellarg($this->root));","+    }","+","+    public function testWritesInsideTheCheckout(): void","+    {","+        new CheckoutWriter()->write($this->root . '/checkout', 'docs/./guide.md', 'content');","+","+        $this->assertSame('content', file_get_contents($this->root . '/checkout/docs/guide.md'));","+    }","+","+    public function testRefusesASymlinkedDirectory(): void","+    {","+        symlink($this->root . '/outside', $this->root . '/checkout/linked');","+","+        try {","+            new CheckoutWriter()->write($this->root . '/checkout', 'linked/escape.txt', 'content');","+            $this->fail('A write through a linked directory must be refused');","+        } catch (\\Exception $error) {","+            $this->assertStringContainsString('escapes the repository', $error->getMessage());","+        }","+","+        $this->assertFileDoesNotExist($this->root . '/outside/escape.txt');","+    }","+","+    public function testRefusesASymlinkedFile(): void","+    {","+        file_put_contents($this->root . '/outside/target.txt', 'original');","+        symlink($this->root . '/outside/target.txt', $this->root . '/checkout/linked.txt');","+","+        try {","+            new CheckoutWriter()->write($this->root . '/checkout', 'linked.txt', 'content');","+            $this->fail('A write through a linked file must be refused');","+        } catch (\\Exception $error) {","+            $this->assertStringContainsString('escapes the repository', $error->getMessage());","+        }","+","+        $this->assertSame('original', file_get_contents($this->root . '/outside/target.txt'));","+    }","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"packages/vcs/tests/GogsTest.php","lines":["@@ -4,6 +4,7 @@"," "," namespace Utopia\\VCS\\Tests;"," ","+use PHPUnit\\Framework\\Attributes\\DataProvider;"," use Utopia\\Cache\\Adapter\\None;"," use Utopia\\Cache\\Cache;"," use Utopia\\VCS\\Adapter\\Git\\Gogs;","@@ -19,4 +20,24 @@ protected function createAdapter(): Gogs","     {","         return new Gogs(new Cache(new None()));","     }","+","+    /**","+     * @return \\Iterator<string, array{string, string, string}>","+     */","+    public static function unsafePathProvider(): \\Iterator","+    {","+        yield 'parent directory' => ['../escape.txt', '', 'escapes the repository'];","+        yield 'parent directory on a branch' => ['docs/../../escape.txt', 'feature', 'escapes the repository'];","+        yield 'git metadata' => ['.git/config', '', 'names repository metadata'];","+        yield 'git metadata on a branch' => ['nested/.GIT/hooks/pre-commit', 'feature', 'names repository metadata'];","+        yield 'no file' => ['./.', 'feature', 'names no file'];","+    }","+","+    #[DataProvider('unsafePathProvider')]","+    public function testCreateFileRejectsUnsafePath(string $path, string $branch, string $message): void","+    {","+        $this->expectException(\\Exception::class);","+        $this->expectExceptionMessage($message);","+        $this->createAdapter()->createFile('owner', 'repo', $path, 'content', 'Add file', $branch);","+    }"," }"],"additions":21,"deletions":0