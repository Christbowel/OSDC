nsOptions::default(),","             logged_methods: &logged_methods,","+            git_source_cache: &pnpm_git_fetcher::GitSourceCache::default(),","         },","         http_client: &pnpm_network::ThrottledClient::default(),","         store_index: None,","@@ -732,6 +733,7 @@ async fn without_mem_cache_skips_coordination_and_downloads() {","             allow_build_policy: &allow_build_policy,","             link_options: &pnpm_cmd_shim::LinkBinsOptions::default(),","             logged_methods: &logged_methods,","+            git_source_cache: &pnpm_git_fetcher::GitSourceCache::default(),","         },","         http_client: &pnpm_network::ThrottledClient::default(),","         store_index: None,","@@ -808,6 +810,7 @@ async fn cold_batch_falls_back_when_prefetch_failed() {","             allow_build_policy: &allow_build_policy,","             link_options: &pnpm_cmd_shim::LinkBinsOptions::default(),","             logged_methods: &logged_methods,","+            git_source_cache: &pnpm_git_fetcher::GitSourceCache::default(),","         },","         http_client: &pnpm_network::ThrottledClient::default(),","         store_index: None,","@@ -909,6 +912,7 @@ async fn run_snapshot_install_with_session(","             allow_build_policy: &allow_build_policy,","             link_options: &pnpm_cmd_shim::LinkBinsOptions::default(),","             logged_methods: &logged_methods,","+            git_source_cache: &pnpm_git_fetcher::GitSourceCache::default(),","         },","         http_client: &pnpm_network::ThrottledClient::default(),","         store_index: None,","@@ -1243,6 +1247,7 @@ async fn installing_a_runtime_persists_the_synthesized_manifest_into_the_store_i","             allow_build_policy: &allow_build_policy,","             link_options: &pnpm_cmd_shim::LinkBinsOptions::default(),","             logged_methods: &logged_methods,","+            git_source_cache: &pnpm_git_fetcher::GitSourceCache::default(),","         },","         http_client: &pnpm_netw