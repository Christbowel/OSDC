{"id":"9be0dbc4858576350eb15e65454c0ccb13265972","axis":"silent","repo":"ray-project/ray","sha":"9be0dbc4858576350eb15e65454c0ccb13265972","parsed":{"files":[{"path":"doc/source/serve/llm/user-guides/kv-aware-routing.md","lines":["@@ -112,9 +112,11 @@ curl http://localhost:8000/v1/chat/completions \\","   -d '{\"model\": \"qwen3-0.6b\", \"messages\": [{\"role\": \"user\", \"content\": \"Hello!\"}]}'"," ```"," ","-The first request selects a replica by estimated token load and KV cache overlap. Later turns stay on that replica even when another has lower load or more cached tokens. After the session's idle timeout, or if the replica becomes unavailable or ineligible, the router selects again.","+Session affinity works at two levels. At the ingress, HAProxy uses consistent hashing to send requests with the same session ID to the same ingress request router (`LLMRouter`). That router tokenizes requests and can reuse tokenized conversation prefixes across turns. The router might run on another node, which adds a network round trip. For long multi-turn conversations, prefix token reuse saves more than this hop costs. For short prompts, the hop can cost more than it saves."," ","-Session pinning is enabled by default with a 30-minute idle timeout. Set `session_affinity_ttl_s` in seconds to change it:","+Then, the router (`LLMRouter`) selects a model replica (`LLMServer`) for the first request by estimated token load and KV cache overlap. Later turns stay on that model replica even when another has lower load or more cached tokens. After the session's idle timeout, or if the model replica becomes unavailable or ineligible, the router selects again.","+","+Session pinning to the model replica is enabled by default with a 30-minute idle timeout. Set `session_affinity_ttl_s` in seconds to change it:"," "," ```python"," request_router_config = RequestRouterConfig(","@@ -123,7 +125,7 @@ request_router_config = RequestRouterConfig("," )"," ```"," ","-Set it to `0` to disable pinning. Requests without `x-session-id` use token-load scoring and KV cache overlap.","+Set it to `0` to disable model replica pinning. Requests without `x-session-id` use token-load scoring and KV cache overlap."," "," ### Tuning"," ","@@ -132,6 +134,7 @@ Set these in the cluster environment:"," | Environment variable | Default | Effect |"," | --- | --- | --- |"," | `RAY_SERVE_INGRESS_ROUTER_REPLICAS_PER_NODE` | 1 | Ingress replicas per proxy node. Raise it when ingress tokenization and request scoring bound throughput. |","+| `RAY_SERVE_HAPROXY_RETRIES` | HAProxy default (3) | Retries for failed backend connections, including ingress replicas. |"," | `RAY_SERVE_LLM_KV_TOKEN_STAGING_TTL_S` | 60 | How long a replica holds a staged prompt-token payload before eviction. |"," | `RAY_SERVE_LLM_KV_TOKEN_STAGING_MAX_ENTRIES` | 8192 | Staged payloads retained per engine replica. |"," | `RAY_SERVE_LLM_KV_TOKEN_STAGING_MAX_BYTES` | 1 GiB | Memory allocated for staged payloads per engine replica. |","@@ -204,6 +207,15 @@ The router scores requests using token IDs, so each request is tokenized at the"," "," - **Tokenization is not repeated at the engine.** The ingress sends the tokenized prompt to the selected engine replica, avoiding duplicate tokenization. The tokens are sent over a separate channel and may arrive before the corresponding HTTP request, so the engine replica temporarily **stages** them until the request arrives. Delivery is best effort: if the token payload is missing or has expired, the engine simply tokenizes the prompt again. The `RAY_SERVE_LLM_KV_TOKEN_STAGING_*` variables control how long and how much token data each engine replica can stage."," ","+When vLLM uses fastokens, its native segment cache reuses tokenized conversation segments across turns and branches. Ray Serve LLM defaults `FASTOKENS_SEGMENT_CACHE` to `1024` MiB for `KVAwareRouter` Override the budget in the `LLMConfig.runtime_env`:","+","+```yaml","+runtime_env:","+  env_vars:","+    VLLM_USE_FASTOKENS: \"1\"","+    FASTOKENS_SEGMENT_CACHE: \"1024\"","+```","+"," You can use `KVAwareRouter` with Anthropic Messages (`/v1/messages`) clients such as Claude Code. Use the same routing configuration as for OpenAI requests."," "," "],"additions":15,"deletions":3,"truncated":false},{"path":"python/ray/llm/_internal/serve/core/ingress/builder.py","lines":["@@ -86,12 +86,14 @@ class (``LLMServer``, ``DPServer``, ``PDDecodeServer``/``DPPDDecodeServer``)","     )"," "," ","-def _get_tokenizing_router_runtime_env(llm_config: LLMConfig) -> Optional[dict]:","-    runtime_env = llm_config.runtime_env","-    if runtime_env is None or \"env_vars\" not in runtime_env:","-        return None","-","-    return {\"env_vars\": runtime_env[\"env_vars\"]}","+def _get_tokenizing_router_runtime_env(llm_config: LLMConfig) -> dict:","+    env_vars = dict((llm_config.runtime_env or {}).get(\"env_vars\", {}))","+    # Budget in MiB, configurable through FASTOKENS_SEGMENT_CACHE.","+    # Default headroom for 32 concurrent conversations of about 500k tokens each.","+    env_vars.setdefault(","+        \"FASTOKENS_SEGMENT_CACHE\", os.environ.get(\"FASTOKENS_SEGMENT_CACHE\", \"1024\")","+    )","+    return {\"env_vars\": env_vars}"," "," "," def _build_openai_ingress_request_router("],"additions":8,"deletions":6,"truncated":false},{"path":"python/ray/llm/tests/serve/cpu/deployments/routers/kv/test_tokenizer.py","lines":["@@ -1,5 +1,6 @@"," import copy"," import json","+import os"," import sys"," from typing import Any, Dict"," from unittest.mock import AsyncMock, MagicMock, patch","@@ -7,8 +8,10 @@"," import pytest"," from fastapi import HTTPException"," from starlette.datastructures import Headers","+from transformers import AutoTokenizer"," from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest"," from vllm.entrypoints.openai.completion.protocol import CompletionRequest","+from vllm.tokenizers.fastokens import apply_fastokens_patch"," "," from ray.llm._internal.serve.core.configs.llm_config import LLMConfig"," from ray.llm._internal.serve.core.ingress.builder import (","@@ -438,27 +441,88 @@ def enable_direct_streaming(self, monkeypatch):","             (RoundRobinRouter, False),","         ],","     )","-    def test_enabled_only_for_kv_aware_router(self, request_router_class, expected):","+    def test_enabled_only_for_kv_aware_router(","+        self, request_router_class, expected, monkeypatch","+    ):","+        monkeypatch.delenv(\"FASTOKENS_SEGMENT_CACHE\", raising=False)","         app = _build_llm_app(request_router_class)","         init_kwargs = _router_init_kwargs(app)","         # A non-None llm_config is the sole signal for pre-routing tokenization;","         # it must be bound exactly when the router is KV-aware.","         assert (init_kwargs[\"llm_config\"] is not None) is expected","+        if expected:","+            env_vars = _router_ray_actor_options(app)[\"runtime_env\"][\"env_vars\"]","+            assert env_vars[\"FASTOKENS_SEGMENT_CACHE\"] == \"1024\"","+            assert \"VLLM_USE_FASTOKENS\" not in env_vars"," ","-    def test_runtime_env_reaches_tokenizing_router(self):","-        app = _build_llm_app(","-            KVAwareRouter,","-            runtime_env={\"env_vars\": {\"VLLM_USE_FASTOKENS\": \"1\", \"EXTRA_VAR\": \"value\"}},","-        )","+    @pytest.mark.parametrize(","+        \"inherited_cache_mib, configured_cache_mib, expected_cache_mib\",","+        [(\"32\", None, \"32\"), (\"128\", \"0\", \"0\"), (\"128\", \"64\", \"64\")],","+        ids=[\"inherited\", \"disabled\", \"configured\"],","+    )","+    def test_runtime_env_reaches_tokenizing_router(","+        self, monkeypatch, inherited_cache_mib, configured_cache_mib, expected_cache_mib","+    ):","+        monkeypatch.setenv(\"FASTOKENS_SEGMENT_CACHE\", inherited_cache_mib)","+        model_env = {\"VLLM_USE_FASTOKENS\": \"1\", \"EXTRA_VAR\": \"value\"}","+        if configured_cache_mib is not None:","+            model_env[\"FASTOKENS_SEGMENT_CACHE\"] = configured_cache_mib","+        app = _build_llm_app(KVAwareRouter, runtime_env={\"env_vars\": model_env})","         runtime_env = _router_ray_actor_options(app)[\"runtime_env\"]","         llm_config = _router_init_kwargs(app)[\"llm_config\"]","-        for name, value in llm_config.runtime_env[\"env_vars\"].items():","+        assert (","+            llm_config.runtime_env[\"env_vars\"].get(\"FASTOKENS_SEGMENT_CACHE\")","+            == configured_cache_mib","+        )","+        for name, value in model_env.items():","             assert runtime_env[\"env_vars\"][name] == value","+        assert runtime_env[\"env_vars\"][\"FASTOKENS_SEGMENT_CACHE\"] == expected_cache_mib","         assert (","             runtime_env[\"env_vars\"][\"RAY_SERVE_RUN_USER_CODE_IN_SEPARATE_THREAD\"] == \"0\"","         )","         assert runtime_env[\"env_vars\"][\"RAY_SERVE_RUN_ROUTER_IN_SEPARATE_LOOP\"] == \"0\""," "," ","+def test_native_cache_reuses_multiturn_prefix(monkeypatch):","+    fastokens = pytest.importorskip(\"fastokens\")","+    monkeypatch.setenv(\"FASTOKENS_SEGMENT_CACHE\", \"1\")","+    model = os.environ.get(\"RAY_TOKEN_CACHE_TEST_MODEL\", \"Qwen/Qwen3-0.6B\")","+    fastokens.unpatch_transformers()","+    reference = AutoTokenizer.from_pretrained(model)","+    apply_fastokens_patch()","+    try:","+        tokenizer = AutoTokenizer.from_pretrained(model)","+        backend = tokenizer.backend_tokenizer","+        if not hasattr(backend, \"segment_cache_stats\"):","+            pytest.skip(\"fastokens does not provide the native segment cache API\")","+        assert backend.segment_cache_stats()[\"max_bytes\"] == 1 << 20","+","+        context = \"shared reference material \" * 50","+        prefix = (","+            \"<|im_start|>system\\n\" + context + \"<|im_end|>\\n\"","+            \"<|im_start|>user\\nFirst question.<|im_end|>\\n\"","+            \"<|im_start|>assistant\\n\"","+        )","+        followup = (","+            prefix + \"First answer.<|im_end|>\\n\"","+            \"<|im_start|>user\\nFollow-up question.<|im_end|>\\n\"","+            \"<|im_start|>assistant\\n\"","+        )","+        kwargs = {\"add_special_tokens\": False}","+        assert (","+            tokenizer(prefix, **kwargs)[\"input_ids\"]","+            == reference(prefix, **kwargs)[\"input_ids\"]","+        )","+        before = backend.segment_cache_stats()","+        assert (","+            tokenizer(followup, **kwargs)[\"input_ids\"]","+            == reference(followup, **kwargs)[\"input_ids\"]","+        )","+        after = backend.segment_cache_stats()","+        assert after[\"hit_bytes\"] - before[\"hit_bytes\"] >= len(context)","+    finally:","+        fastokens.unpatch_transformers()","+","+"," if __name__ == \"__main__\":","     sys.exit(pytest.main([\"-v\", __file__]))"],"additions":71,"deletions":7,"truncated":false},{"path":"python/ray/serve/_private/constants.py","lines":["@@ -777,6 +777,12 @@","     \"RAY_SERVE_INGRESS_ROUTER_REPLICAS_PER_NODE\", 1"," )"," ","+# HAProxy weight for every ingress request router on the session hash ring.","+# HAProxy places weight * 16 virtual nodes per router, so 16 gives 256 virual","+# nodes per router: enough for an even session spread without a large ring.","+# Every proxy must use the same value, or sessions map to different routers.","+HAPROXY_INGRESS_REQUEST_ROUTER_WEIGHT = 16","+"," # Feature flag to include client IP address in HTTP access logs."," # Off by default for privacy; set to \"1\" to enable."," RAY_SERVE_LOG_CLIENT_ADDRESS = ("],"additions":6,"deletions":0,"truncated":false},{"path":"python/ray/serve/_private/haproxy.py","lines":["@@ -17,6 +17,7 @@"," from dataclasses import dataclass, field"," from pathlib import Path"," from typing import Any, Dict, List, Optional, Set, Tuple","+from zlib import crc32"," "," import ray"," from ray._common.network_utils import get_localhost_ip","@@ -33,6 +34,7 @@"," )"," from ray.serve._private.constants import (","     DRAINING_MESSAGE,","+    HAPROXY_INGRESS_REQUEST_ROUTER_WEIGHT,","     HEALTHY_MESSAGE,","     NO_REPLICAS_MESSAGE,","     NO_ROUTES_MESSAGE,","@@ -190,6 +192,23 @@ def _routers_and_targets_by_backend(","     return routers, targets"," "," ","+def _assign_ingress_router_server_ids(servers: \"List[ServerConfig]\") -> Dict[str, int]:","+    \"\"\"Assign deterministic server IDs for HAProxy's native hash ring.\"\"\"","+    # HAProxy 2.8 uses numeric server IDs, not replica names, for ring positions.","+    # Its built-in hash functions hash request keys, not server names.","+    ids = {}","+    used = set()","+    # HAProxy 2.8 scales server IDs by 4096 in its 32-bit ring hash.","+    max_id = (1 << 20) - 1","+    for server in sorted(servers, key=lambda s: s.name):","+        server_id = (crc32(server.name.encode()) & max_id) or 1","+        while server_id in used:","+            server_id = server_id % max_id + 1","+        used.add(server_id)","+        ids[server.name] = server_id","+    return ids","+","+"," def _format_routers_lua(routers: \"Dict[str, List[ServerConfig]]\") -> str:","     \"\"\"Render {backend_name: [ServerConfig, ...]} as a Lua table literal.\"\"\""," ","@@ -842,6 +861,11 @@ def frontend_host(self) -> str:"," ","         return self.http_options.host"," ","+    @property","+    def ingress_router_socket_path(self) -> str:","+        # Lua sends routing consultations here for HAProxy's native router selection.","+        return str(Path(self.socket_path).with_suffix(\".ir\"))","+","     @property","     def frontend_port(self) -> int:","         return self.http_options.port","@@ -1365,6 +1389,7 @@ def _write_ingress_request_router_lua(","             SESSION_HEADER=SERVE_SESSION_ID.lower(),","             REQUEST_PATH_HEADER=SERVE_INGRESS_ROUTER_REQUEST_PATH_HEADER,","             ROUTERS=_format_routers_lua(routers),","+            ROUTER_SOCKET=_lua_str(self.cfg.ingress_router_socket_path),","             REPLICA