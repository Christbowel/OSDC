equest_routers","+    bind unix@{{ config.ingress_router_socket_path }} mode 600","+    no log","+    {%- for backend in backends if backend.name in ingress_router_server_ids %}","+    use_backend {{ backend.name }}-ingress-request-routers if { path /{{ backend.name }} }","+    {%- endfor %}","+    default_backend default_backend","+{%- for item in backends_with_health_config if item.backend.name in ingress_router_server_ids %}","+{%- set backend = item.backend %}","+{%- set hc = item.health_config %}","+backend {{ backend.name }}-ingress-request-routers","+    no log","+    balance hdr(x-serve-router-session-id)","+    hash-type consistent sdbm avalanche","+    hash-balance-factor 0","+    http-request set-path /internal/route","+    http-reuse always","+    timeout server {{ ingress_request_router_timeout_s }}s","+    # Draining routers fail /-/healthz and leave the ring.","+    {%- if hc.health_path %}","+    option httpchk GET {{ hc.health_path }}","+    http-check expect status 200","+    {%- endif %}","+    {{ hc.default_server_directive }} weight {{ ingress_router_weight }}","+    {%- for server in backend.ingress_request_router_servers %}","+    server {{ server.name }} {{ server.host }}:{{ server.port }} id {{ ingress_router_server_ids[backend.name][server.name] }} check","+    {%- endfor %}","+{%- endfor %}","+{%- endif %}"," {%- for item in backends_with_health_config %}"," {%- set backend = item.backend %}"," {%- set hc = item.health_config %}"],"additions":30,"deletions":0,"truncated":false},{"path":"python/ray/serve/_private/ingress_request_router.lua.tmpl","lines":["@@ -4,6 +4,7 @@ local FORWARD_BODY = ${FORWARD_BODY}"," local MODEL_ID_HEADER = \"serve_multiplexed_model_id\""," local ROUTERS = ${ROUTERS}"," local REPLICA_TARGETS = ${REPLICA_TARGETS}","+local ROUTER_SOCKET = ${ROUTER_SOCKET}"," local _rr_cursor = {}"," "," -- Headers named by Connection are added dynamically.","@@ -84,16 +85,22 @@ local function route(txn, app, pool, replica_map)","   