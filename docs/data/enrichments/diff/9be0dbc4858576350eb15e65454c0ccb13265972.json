ss proxies regardless of server ordering.\"\"\"","+    if force_id_collision:","+        # Exercise ID collision resolution and wraparound through real routing.","+        monkeypatch.setattr(haproxy, \"crc32\", lambda _: (1 << 20) - 1)","+    pool = ingress_router_pool","+    _, _, first_port = await pool.start_proxy(\"first\", nbthread=1)","+    # Session routing must not depend on Lua's per-thread round-robin cursors.","+    _, _, second_port = await pool.start_proxy(\"second\", reverse=True, nbthread=2)","+    owners = {","+        f\"session-{i}\": pool.post(first_port, {SERVE_SESSION_ID: f\"session-{i}\"})","+        for i in range(32)","+    }","+    assert set(owners.values()) == {0, 1, 2}","+    for sid, owner in owners.items():","+        assert pool.post(first_port, {SERVE_SESSION_ID: sid}) == owner","+        assert pool.post(second_port, {SERVE_SESSION_ID: sid}) == owner","+","+","+@pytest.mark.asyncio","+async def test_router_session_reload(ingress_router_pool):","+    \"\"\"Pool updates preserve unaffected sessions and restore owners on readdition.\"\"\"","+    pool = ingress_router_pool","+    api, backend, port = await pool.start_proxy(\"proxy\")","+    owners = {","+        f\"session-{i}\": pool.post(port, {SERVE_SESSION_ID: f\"session-{i}\"})","+        for i in range(32)","+    }","+    original_servers = backend.ingress_request_router_servers","+    removed = 1","+    backend.ingress_request_router_servers = [","+        s for s in original_servers if s.name != f\"router_{removed}\"","+    ]","+    api.set_backend_configs({\"llm\": backend})","+    await api.reload()","+    for sid, owner in owners.items():","+        replacement = pool.post(port, {SERVE_SESSION_ID: sid})","+        assert replacement != removed","+        if owner != removed:","+            assert replacement == owner","+    backend.ingress_request_router_servers = original_servers","+    api.set_backend_configs({\"llm\": backend})","+    await api.reload()","+    for sid, owner in owners.items():","+        assert pool.post(port, {SERVE_SESSION_ID: sid}) == owner","+","+","+@pytest.mark.asyncio","+@pytest.mark.parametrize(\"failure\", [\"stopped\", \"draining\"])","+async def test_router_session_failover(ingress_router_pool, failure):","+    \"\"\"A stopped or draining router loses its sessions; recovery restores them.","+","+    A draining router still accepts connections, so only /-/healthz removes it.","+    \"\"\"","+    pool = ingress_router_pool","+    _, _, port = await pool.start_proxy(\"proxy\")","+    owners = {","+        f\"session-{i}\": pool.post(port, {SERVE_SESSION_ID: f\"session-{i}\"})","+        for i in range(32)","+    }","+    sid = next(iter(owners))","+    failed_owner = owners[sid]","+    if failure == \"stopped\":","+        pool.stop_router(failed_owner)","+    else:","+        pool.set_router_healthy(failed_owner, False)","+    await async_wait_for_condition(","+        lambda: pool.post(port, {SERVE_SESSION_ID: sid}) != failed_owner, timeout=10","+    )","+    for session, owner in owners.items():","+        if owner != failed_owner:","+            assert pool.post(port, {SERVE_SESSION_ID: session}) == owner","+    if failure == \"stopped\":","+        pool.restart_router(failed_owner)","+    else:","+        pool.set_router_healthy(failed_owner, True)","+    await async_wait_for_condition(","+        lambda: pool.post(port, {SERVE_SESSION_ID: sid}) == failed_owner, timeout=10","+    )","+    for session, owner in owners.items():","+        assert pool.post(port, {SERVE_SESSION_ID: session}) == owner","+","+","+@pytest.mark.asyncio","+async def test_router_session_headers(ingress_router_pool):","+    \"\"\"Client session headers control affinity; missing or empty values use round robin.\"\"\"","+    pool = ingress_router_pool","+    _, _, port = await pool.start_proxy(\"proxy\")","+    sid = \"session-0\"","+    owner = pool.post(port, {SERVE_SESSION_ID: sid})"],"additions":217,"deletions":6,"truncated":fals