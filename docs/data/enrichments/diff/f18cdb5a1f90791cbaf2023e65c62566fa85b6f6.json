{"id":"f18cdb5a1f90791cbaf2023e65c62566fa85b6f6","axis":"silent","repo":"electron/electron","sha":"f18cdb5a1f90791cbaf2023e65c62566fa85b6f6","parsed":{"files":[{"path":"patches/chromium/.patches","lines":["@@ -138,7 +138,6 @@ fix_add_reinitializegeneratedcodecachecontext_to.patch"," feat_carry_embedder_startup_data_in_createnewwindowreply.patch"," feat_deliver_service_worker_preload_data_via_embeddedworkerstartparams.patch"," build_allow_resource_allowlist_generation_for_linux_and_macos.patch","-build_fix_profile_runtime_resolution_for_pgo_instrumented_builds.patch"," fix_guard_webstoreprivateapi_factory_against_null_delegate.patch"," allow_authenticator_responses_to_override_client_data_json.patch"," fix_don_t_read_a_stale_last-error_in_replacefile_on_windows.patch"],"additions":0,"deletions":1,"truncated":false},{"path":"patches/chromium/build_fix_profile_runtime_resolution_for_pgo_instrumented_builds.patch","lines":["@@ -1,54 +0,0 @@","-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","-From: Sam Attard <sattard@anthropic.com>","-Date: Sun, 31 May 2026 00:51:17 +0000","-Subject: build: fix profile runtime resolution for PGO instrumented builds","-","-fixes where -fprofile-generate builds fail because the compiler or","-driver references the profile runtime by a name that does not exist in","-the clang package:","-","-Windows cross-compiles: objects compiled by Linux clang embed","-   /DEFAULTLIB:clang_rt.profile.lib (per-target runtime naming), but the","-   Windows package ships the legacy layout","-   (lib/windows/clang_rt.profile-<arch>.lib). Linking fails with:","-     lld-link: error: could not open 'clang_rt.profile.lib'","-   Native Windows compiles do not hit this because clang-cl checks the","-   on-disk layout and embeds the legacy name; cross compiles always use","-   the per-target name.","-","-Suppress the automatic runtime reference (-noprofilelib /","-/nodefaultlib:) and link the correctly-named archive explicitly.","-","-Upstream has never hit this case: Chrome's instrumented Windows","-builds compile natively on Windows.","-This patch can be upstreamed.","-","-diff --git a/build/config/compiler/pgo/BUILD.gn b/build/config/compiler/pgo/BUILD.gn","-index c60ce3b4343646f5e662840783d57d9758e22670..08fa609e2a7f69f07d166e6d5a2abffc6bde31b5 100644","-+++ b/build/config/compiler/pgo/BUILD.gn","-@@ -45,6 +45,24 @@ config(\"pgo_instrumentation_flags\") {","-       # linking, and embeds the path to the profile runtime library as","-       # dependent library into each object file.","-       ldflags = [ \"-fprofile-generate\" ]","-+    } else {","-+      # Objects compiled on Linux cross-compile workers embed","-+      # /DEFAULTLIB:clang_rt.profile.lib (the per-target runtime name), but","-+      # the Windows clang package ships the legacy layout","-+      # (lib/windows/clang_rt.profile-<arch>.lib), so the embedded reference","-+      # cannot be resolved at link time. Ignore it and link the","-+      # correctly-named archive explicitly.","-+      ldflags = [ \"/nodefaultlib:clang_rt.profile.lib\" ]","-+      if (current_cpu == \"x64\") {","-+        _profile_rt_arch = \"x86_64\"","-+      } else if (current_cpu == \"x86\") {","-+        _profile_rt_arch = \"i386\"","-+      } else if (current_cpu == \"arm64\") {","-+        _profile_rt_arch = \"aarch64\"","-+      } else {","-+        assert(false, \"unsupported target_cpu for PGO instrumentation\")","-+      }","-+      libs = [ \"$clang_base_path/lib/clang/$clang_version/lib/windows/clang_rt.profile-${_profile_rt_arch}.lib\" ]","-     }","-   }","- }"],"additions":0,"deletions":53,"truncated":false},{"path":"patches/reclient-configs/.patches","lines":["@@ -1 +1,2 @@"," fix_mark_the_generated_clang_remote_wrapper_executable.patch","+fix_expose_the_host_clang_s_resource_lib_dir_to_the_linux_clang.patch"],"additions":1,"deletions":0,"truncated":false},{"path":"patches/reclient-configs/fix_expose_the_host_clang_s_resource_lib_dir_to_the_linux_clang.patch","lines":["@@ -0,0 +1,35 @@","+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","+From: Shelley Vohr <shelley.vohr@gmail.com>","+Date: Thu, 10 Sep 2026 12:37:16 +0000","+Subject: fix: expose the host clang's resource lib dir to the linux clang","+","+clang_remote_wrapper already links the host package's resource include","+directory next to the linux clang it runs on the worker. Link the resource","+lib directory too, so runtime archives uploaded from the host package are","+found where clang looks for them. clang-cl in particular checks for","+lib/windows/clang_rt.profile-<arch>.lib to decide which profile runtime","+name to embed for -fprofile-generate, and without it emits","+/DEFAULTLIB:clang_rt.profile.lib, which the Windows package does not ship.","+","+diff --git a/chromium-browser-clang/clang_remote_wrapper.template b/chromium-browser-clang/clang_remote_wrapper.template","+index b0738610da8bcc2a2982ea1867171529039d3630..29a8e464828b506da0b6eff9475c8f3cedcbb9b0 100644","+--- a/chromium-browser-clang/clang_remote_wrapper.template","+@@ -42,6 +42,17 @@ if [[ -d $clang_include_dir && ! -d $linux_clang_include_dir ]]; then","+   ln -sr \"$clang_include_dir\" \"$linux_clang_include_dir\"","+ fi","+ ","++# Do the same for the resource \"lib\" directory, so runtime libraries uploaded","++# from the host package (e.g. lib/windows/clang_rt.profile-<arch>.lib, which","++# clang-cl probes to choose the profile runtime name) are visible to the linux","++# clang.","++clang_lib_dir=\"$(dirname \"$clang_include_dir\")/lib\"","++linux_clang_lib_dir=\"$(dirname \"$linux_clang_include_dir\")/lib\"","++if [[ -d $clang_lib_dir && ! -d $linux_clang_lib_dir ]]; then","++  mkdir -p \"$(dirname \"${linux_clang_lib_dir}\")\"","++  ln -sr \"$clang_lib_dir\" \"$linux_clang_lib_dir\"","++fi","++","+ # Convert clang binary path to the linux version.","+ linux_clang_binary=\"$1\"","+ linux_clang_binary=\"${linux_clang_binary//\\\\//}\"",""],"additions":34,"deletions":0,"truncated":false}],"additions":35,"deletions":54,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-09-11T13:01:16.367221+00:00"}