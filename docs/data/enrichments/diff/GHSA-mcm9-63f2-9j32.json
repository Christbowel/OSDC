\t} else if (typeof thing === 'symbol') {"," \t\t\tthrow new DevalueError(`Cannot stringify a Symbol primitive`, keys, thing, value);","+\t\t} else if (","+\t\t\t(typeof thing === 'string' && thing.length >= MIN_STRING_LENGTH) ||","+\t\t\ttypeof thing === 'bigint'","+\t\t) {","+\t\t\tcounts.set(thing, (counts.get(thing) || 0) + 1);"," \t\t}"," \t}"," ","@@ -151,11 +185,27 @@ export function uneval(value, replacer) {"," "," \tconst names = new Map();"," ","-\tArray.from(counts)","-\t\t.filter((entry) => entry[1] > 1)","+\t/** @type {Array<[any, number]>} */","+\tconst repeated = [];","+\t// Avoid allocating entries for all the values that will never be hoisted.","+\tcounts.forEach((count, thing) => {","+\t\tif (count > 1) repeated.push([thing, count]);","+\t});","+","+\trepeated"," \t\t.sort((a, b) => b[1] - a[1])","-\t\t.forEach((entry, i) => {","-\t\t\tnames.set(entry[0], get_name(i));","+\t\t.forEach(([thing, count]) => {","+\t\t\tconst name = get_name(names.size);","+","+\t\t\tif (is_primitive(thing)) {","+\t\t\t\tconst length = stringify_cached_primitive(thing).length;","+\t\t\t\t// Hoisting costs one literal, a parameter and a reference per occurrence.","+\t\t\t\t// Allow for the IIFE wrapper and separators even if one already exists,","+\t\t\t\t// so inexpensive repetitions stay inline.","+\t\t\t\tif (length * count <= length + (count + 1) * name.length + 25) return;","+\t\t\t}","+","+\t\t\tnames.set(thing, name);"," \t\t});"," "," \t/**","@@ -384,7 +434,7 @@ export function uneval(value, replacer) {"," \t\t\t}"," "," \t\t\tif (is_primitive(thing)) {","-\t\t\t\tvalues.push(stringify_primitive(thing));","+\t\t\t\tvalues.push(stringify_cached_primitive(thing));"," \t\t\t\treturn;"," \t\t\t}"," ","@@ -394,9 +444,18 @@ export function uneval(value, replacer) {"," \t\t\t\tcase 'Number':"," \t\t\t\tcase 'String':"," \t\t\t\tcase 'Boolean':","-\t\t\t\tcase 'BigInt':","-\t\t\t\t\tvalues.push(`Object(${stringify(thing.valueOf())})`);","+\t\t\t\tcase 'BigInt': {","+\t\t\t\t\tconst primitive = thing.valueOf();","+\t\t\t\t\tif (names.has(primitive)) {","+\t\t\t\t\t\t// A hoisted primitive is only in scope inside the IIFE, not in","+\t\t\t\t\t\t// its arguments. Reconstruct the box before assigning references.","+\t\t\t\t\t\tvalues.push('{}');","+\t\t\t\t\t\treconstructions.push(`${name}=Object(${stringify(primitive)})`);","+\t\t\t\t\t} else {","+\t\t\t\t\t\tvalues.push(`Object(${stringify(primitive)})`);","+\t\t\t\t\t}"," \t\t\t\t\tbreak;","+\t\t\t\t}"," "," \t\t\t\tcase 'RegExp':"," \t\t\t\t\tconst { source, flags } = thing;"],"additions":68,"deletions":9,"truncated":false},{"path":"test/uneval-primitives.test.js","lines":["@@ -0,0 +1,183 @@","+import * as assert from 'uvu/assert';","+import { suite } from 'uvu';","+import { parse, stringify, uneval } from '../index.js';","+","+const test = suite('uneval: repeated primitives');","+","+for (const [name, make_primitive] of [","+\t['string', (n) => 'x'.repeat(n)],","+\t['escaped string', (n) => '</script>\\n\"\\\\\\0\\u2028\\u2029'.repeat(n)],","+\t['bigint', (n) => BigInt('9'.repeat(n))]","+]) {","+\ttest(`${name} output grows linearly when reserializing compact input`, () => {","+\t\tlet previous_length = 0;","+","+\t\tfor (const n of [2000, 4000]) {","+\t\t\tconst primitive = make_primitive(n);","+\t\t\tconst encoded = JSON.stringify([","+\t\t\t\tArray(n).fill(1),","+\t\t\t\ttypeof primitive === 'bigint' ? ['BigInt', String(primitive)] : primitive","+\t\t\t]);","+\t\t\tconst value = parse(encoded);","+\t\t\tconst serialized = uneval(value);","+","+\t\t\tassert.ok(serialized.length < encoded.length * 4);","+\t\t\tif (previous_length) assert.ok(serialized.length < previous_length * 2.1);","+\t\t\tprevious_length = serialized.length;","+","+\t\t\tassert.equal((0, eval)(serialized), value);","+\t\t\tassert.not.ok(serialized.includes('<'));","+\t\t}","+\t});","+","+\ttest(`${name} shared by distinct boxes stays compact`, () => {","+\t\tconst primitive = make_primitive(2000);","+\t\tconst encoded = stringify(Array.from({ length: 2000 }, () => Object(primitive)));","+\t\tconst serialized = uneval(parse(encoded));","+","+\t\tassert.ok(serialized.length < encoded.length * 4);","+\t\tconst result = (0, eval)(serialized);","+\t\tassert.is(result.length, 2000);","+\t\tassert.is(new Set(result).size, 2000);","+\t\tfor (const box of result) {","+\t\t\tassert.type(box, 'object');","+\t\t\tassert.is(box.valueOf(), primitive);","+\t\t}","+\t});","+","+\ttest(`${name} preserves shared and distinct box identities`, () => {","+\t\tconst primitive = make_primitive(256);","+\t\tconst box = Object(primitive);","+\t\tconst value = [box, box, primitive, primitive, Object(primitive)];","+\t\tconst result = (0, eval)(uneval(value));","+","+\t\tassert.is(result[0], result[1]);","+\t\tassert.is(result[0].valueOf(), primitive);","+\t\tassert.is(result[2], primitive);","+\t\tassert.is(result[3], primitive);","+\t\tassert.is(result[4].valueOf(), primitive);","+\t\tassert.is(new Set([result[0], result[4]]).size, 2);","+\t});","+","+\ttest(`${name} round-trips in shared and cyclic containers`, () => {","+\t\tconst primitive = make_primitive(256);","+\t\tconst array = [primitive];","+\t\tconst map = new Map([[primitive, primitive]]);","+\t\tconst set = new Set([primitive]);","+\t\tconst box = Object(primitive);","+\t\tconst sparse = [];","+\t\tsparse[1000] = primitive;","+\t\tconst value = Object.assign(Object.create(null), {","+\t\t\tprimitive,","+\t\t\tarray,","+\t\t\tarray_again: array,","+\t\t\tmap,","+\t\t\tmap_again: map,","+\t\t\tset,","+\t\t\tset_again: set,","+\t\t\tbox,","+\t\t\tbox_again: box,","+\t\t\tsparse","+\t\t});","+\t\tvalue.self = value;","+","+\t\tconst result = (0, eval)(uneval(value));","+\t\tassert.is(Object.getPrototypeOf(result), null);","+\t\tassert.is(result.self, result);","+\t\tassert.is(result.primitive, primitive);","+\t\tassert.is(result.array, result.array_again);","+\t\tassert.is(result.array[0], primitive);","+\t\tassert.is(result.map, result.map_again);","+\t\tassert.is(result.map.get(primitive), primitive);","+\t\tassert.is(result.set, result.set_again);","+\t\tassert.ok(result.set.has(primitive));","+\t\tassert.is(result.box, result.box_again);","+\t\tassert.is(result.box.valueOf(), primitive);","+\t\tassert.equal(result.sparse, sparse);","+\t});","+}","+","+test('keeps inexpensive repetitions inline', () => {","+\tassert.is(uneval(['a string', 'a string']), '[\"a string\",\"a string\"]');","+\tassert.is(uneval(['', '', 1n, 1n]), '[\"\",\"\",1n,1n]');","+\tconst value = Array(1000).fill('pending');","+\tassert.is(uneval(value), JSON.stringify(value));","+});","+","+test('bounds expansion on both sides of the short-string cutoff', () => {","+\tfor (const length of [127, 128, 129]) {","+\t\tfor (const character of ['x', '<']) {","+\t\t\tconst value = Array(2000).fill(character.repeat(length));","+\t\t\tconst serialized = uneval(value);","+","+\t\t\tassert.equal((0, eval)(serialized), value);","+\t\t\tassert.not.ok(serialized.includes('<'));","+\t\t\tif (length < 128) {","+\t\t\t\tassert.ok(serialized.startsWith('['));","+\t\t\t\tassert.ok(serialized.length <= value.length * (6 * length + 3) + 1);","+\t\t\t} else {","+\t\t\t\tassert.ok(serialized.length < 6 * length + 3 * value.length);","+\t\t\t}","+\t\t}","+\t}","+});","+","+test('preserves other primitives alongside hoisted values', () => {","+\tconst text = 'x'.repeat(256);","+\tconst value = [","+\t\ttext,","+\t\ttext,","+\t\t0,","+\t\t-0,","+\t\t0,","+\t\t-0,","+\t\tNaN,","+\t\tNaN,","+\t\tInfinity,","+\t\t-Infinity,","+\t\tundefined,","+\t\tnull,","+\t\ttrue,","+\t\tfalse","+\t];","+\tconst result = (0, eval)(uneval(value));","+","+\tfor (let i = 0; i < value.length; i += 1) {","+\t\tassert.ok(Object.is(result[i], value[i]));","+\t}","+});","+","+test('preserves replacer behavior and recursive uneval scopes', () => {","+\tclass Box {","+\t\tconstructor(value) {","+\t\t\tthis.value = value;","+\t\t}","+\t}","+","+\tconst text = 'x'.repeat(256);","+\tconst box = new Box([text, text]);","+\tconst value = [box, box, text, text];","+\tconst visited = [];","+\tconst serialized = uneval(value, (value, uneval) => {","+\t\tvisited.push(value);","+\t\tif (value instanceof Box) return `new Box(${uneval(value.value)})`;","+\t});","+\tconst result = new Function('Box', `return ${serialized}`)(Box);","+","+\tassert.equal(visited, [value, box, box.value]);","+\tassert.is(result[0], result[1]);","+\tassert.ok(result[0] instanceof Box);","+\tassert.equal(result[0].value, [text, text]);","+\tassert.equal(result.slice(2), [text, text]);","+});","+","+test('supports more hoisted primitives than the function parameter limit', () => {","+\tconst strings = Array.from({ length: 66000 }, (_, i) => String(i).padStart(128, 'x'));","+\tconst value = [strings, strings.slice()];","+\tconst serialized = uneval(value);","+","+\tassert.ok(serialized.length < JSON.stringify(value).length);","+\tassert.equal((0, eval)(serialized), value);","+});","+","+test.run();",""],"additions":183,"deletions":0,"truncated":false}],"additions":320,"deletions":9,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-02T14:42:37.891552+00:00"}