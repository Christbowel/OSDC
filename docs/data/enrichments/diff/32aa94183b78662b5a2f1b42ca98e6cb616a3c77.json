{"id":"32aa94183b78662b5a2f1b42ca98e6cb616a3c77","axis":"silent","repo":"kestra-io/kestra","sha":"32aa94183b78662b5a2f1b42ca98e6cb616a3c77","parsed":{"files":[{"path":"ui/eslint.config.js","lines":["@@ -10,7 +10,7 @@ import kestraI18n from \"./scripts/translations/eslintPlugin.mjs\""," import {vueWithStyles} from \"./scripts/css-lint/vueStyleProcessor.mjs\""," "," export default defineConfig([","-    globalIgnores([\"**/node_modules/*\", \"node/*\", \"playwright-report/*\", \"test-results/*\", \"coverage/*\", \"**/dist/*\", \"**/storybook-static/*\", \"packages/kestra-sdk/src/openapi/*\"]),","+    globalIgnores([\"**/node_modules/*\", \"node/*\", \"playwright-report/*\", \"test-results/*\", \"coverage/*\", \"**/dist/*\", \"**/storybook-static/*\", \"packages/kestra-sdk/src/openapi/*\", \"packages/topology/src/standalone.css\"]),","     ...pluginVue.configs[\"flat/base\"],","     {","         files: [\"**/*.vue\"],"],"additions":1,"deletions":1,"truncated":false},{"path":"ui/package-lock.json","lines":["@@ -24110,6 +24110,7 @@","                 \"@vue-flow/background\": \"^1.3.2\",","                 \"@vue-flow/controls\": \"^1.1.3\",","                 \"@vue-flow/core\": \"^1.48.2\",","+                \"element-plus\": \">=2.13.5\",","                 \"vue\": \"^3.5.0\",","                 \"vue-i18n\": \"^11.4.4\"","             },"],"additions":1,"deletions":0,"truncated":false},{"path":"ui/packages/topology/README.md","lines":["@@ -12,12 +12,12 @@ Give it a flow's YAML and the graph Kestra's API computes for it. It lays out th"," ## Install"," "," ```bash","-npm install @kestra-io/topology @kestra-io/design-system @vue-flow/core @vue-flow/controls @vue-flow/background vue-i18n","+npm install @kestra-io/topology @kestra-io/design-system element-plus @vue-flow/core @vue-flow/controls @vue-flow/background vue-i18n"," ```"," ","-`vue`, `@vue-flow/core`, `@vue-flow/controls`, `@vue-flow/background`, `@kestra-io/design-system` and `vue-i18n` are peer dependencies, so the app owns their versions. The design system brings peers of its own, listed in [its README](https://github.com/kestra-io/kestra/tree/develop/ui/packages/design-system#readme).","+`vue`, `@vue-flow/core`, `@vue-flow/controls`, `@vue-flow/background`, `@kestra-io/design-system`, `element-plus` and `vue-i18n` are peer dependencies, so the app owns their versions. The design system brings peers of its own, listed in [its README](https://github.com/kestra-io/kestra/tree/develop/ui/packages/design-system#readme)."," ","-npm lists `vue-i18n` as optional, but the nodes call `useI18n()`, so the app has to install it.","+npm lists `vue-i18n` as optional, but the nodes call `useI18n()`, so the app has to install it (`app.use(createI18n({legacy: false, locale: \"en\"}))` is enough)."," "," ## Usage"," ","@@ -31,7 +31,7 @@ npm lists `vue-i18n` as optional, but the nodes call `useI18n()`, so the app has"," <script setup lang=\"ts\">","     import {onMounted, ref} from \"vue\"","     import {Topology, type FlowGraph} from \"@kestra-io/topology\"","-    import \"@kestra-io/design-system/styleBase\"","+    import \"@kestra-io/topology/standalone.css\"","     import \"@kestra-io/topology/style.css\""," ","     const source = `id: hello-world","@@ -73,7 +73,12 @@ The tenant is `main` on an open-source instance. Both take a `subflows` query pa"," "," ### Styles"," ","-`@kestra-io/topology/style.css` holds the graph's own styles and the Vue Flow base styles. The colors come from the design system's `--ks-*` tokens, so `@kestra-io/design-system/styleBase` has to be loaded once in the app, before it.","+`@kestra-io/topology/style.css` holds the graph's own styles and the Vue Flow base styles. Its colors, sizes and spacing come from the design system's `--ks-*` tokens.","+","+- In an app that loads `@kestra-io/design-system/styleBase` and installs the design-system plugin, as the Kestra UI does, `style.css` is all it needs.","+- Anywhere else, load `@kestra-io/topology/standalone.css` before it. It carries the design system's tokens, light and dark (`html.dark`), declared on the graph and on its tooltips and menus rather than on `:root`, so the graph looks as it does in Kestra whatever `--ks-*` variables the page defines, and the page's own styles are left alone. It also carries the Element Plus base styles its tooltips and menus need, in the `kel` namespace the graph provides to its own components. It holds only what the graph reads: tokens nothing in the graph or its design-system components refers to, and Element Plus rules for components it never renders, are left out. It does not set a font: the graph uses the page's.","+","+`standalone.css` is generated from the design system by `npm run generate:standalone`; a unit test fails when it falls out of date."," "," ### Task icons"," ","@@ -89,7 +94,7 @@ The component receives the task class as `cls`, plus the `icons` map and `loadIc"," "," ### Translations"," ","-The labels are keys of the Kestra UI's messages (`topology-graph.*`, `state_history.*`, `edit`, `delete` and a few more), read through the app's `vue-i18n` instance. An app without those keys shows the keys themselves. The English values are in [`ui/src/translations/en.json`](https://github.com/kestra-io/kestra/blob/develop/ui/src/translations/en.json).","+The labels are keys of the Kestra UI's messages (`topology-graph.*`, `state_history.*`, `edit`, `delete` and a few more), read through the app's `vue-i18n` instance. The package ships their English values and adds the ones the app does not define to its `en` messages, so an app without Kestra's translations shows English labels. The English values are kept equal to [`ui/src/translations/en.json`](https://github.com/kestra-io/kestra/blob/develop/ui/src/translations/en.json) by a unit test."," "," ### Controlling the canvas"," "],"additions":11,"deletions":6,"truncated":false},{"path":"ui/packages/topology/package.json","lines":["@@ -16,7 +16,8 @@","     \"exports\": {","         \".\": \"./src/index.ts\",","         \"./vue-flow-utils\": \"./src/vue-flow-utils.ts\",","-        \"./flow-yaml-utils\": \"./src/utils/flowYamlUtils.ts\"","+        \"./flow-yaml-utils\": \"./src/utils/flowYamlUtils.ts\",","+        \"./standalone.css\": \"./src/standalone.css\"","     },","     \"main\": \"./dist/index.js\",","     \"types\": \"./dist/index.d.ts\",","@@ -34,6 +35,7 @@","     \"scripts\": {","         \"build\": \"tsdown\",","         \"dev\": \"tsdown --watch\",","+        \"generate:standalone\": \"node scripts/generate-standalone-css.mjs\",","         \"check:types\": \"vue-tsc --noEmit\",","         \"test\": \"npm run test:unit\",","         \"test:unit\": \"vitest run --config vitest.unit.config.ts\",","@@ -54,6 +56,7 @@","         \"@vue-flow/background\": \"^1.3.2\",","         \"@vue-flow/controls\": \"^1.1.3\",","         \"@vue-flow/core\": \"^1.48.2\",","+        \"element-plus\": \">=2.13.5\",","         \"vue\": \"^3.5.0\",","         \"vue-i18n\": \"^11.4.4\"","     },"],"additions":4,"deletions":1,"truncated":false},{"path":"ui/packages/topology/scripts/generate-standalone-css.mjs","lines":["@@ -0,0 +1,214 @@","+/**","+ * Builds src/standalone.css: the design-system styles a page without the design system needs for the graph.","+ * Keeps only what the graph reads; run `npm run generate:standalone` after the design system changes.","+ */","+import fs from \"node:fs\"","+import path from \"node:path\"","+import {fileURLToPath} from \"node:url\"","+import * as sass from \"sass-embedded\"","+","+const here = path.dirname(fileURLToPath(import.meta.url))","+const ui = path.resolve(here, \"../../..\")","+const nodeModules = path.join(ui, \"node_modules\")","+const topologySrc = path.resolve(here, \"../src\")","+const designSystemSrc = path.join(ui, \"packages/design-system/src\")","+const designSystemStyles = path.join(designSystemSrc, \"assets/styles\")","+const OUTPUT = path.join(topologySrc, \"standalone.css\")","+","+/** Element Plus teleports tooltips and menus to <body>, so they carry the tokens too. */","+const SCOPE = \":where(.ks-topology, .kel-popper)\"","+","+/** Token files and the selector each declares on; `html.dark-2` is a Kestra UI theme, so it is left out. */","+const TOKEN_FILES = {","+    \"ks-tokens.css\": {from: \":root\", to: SCOPE},","+    \"ks-palette.css\": {from: \":root\", to: SCOPE},","+    \"ks-theme-light.css\": {from: \":root\", to: SCOPE},","+    \"ks-theme-dark.css\": {from: \"html.dark\", to: `:where(html.dark) ${SCOPE}`},","+}","+","+/** Tokens the host sets at runtime on <html> (the Kestra UI font size), with the value to assume without it. */","+const HOST_TOKENS = {\"--ks-font-scale\": \"1\"}","+","+/** Element Plus styles the graph's tooltips and menus use besides their own: ElTooltip fades, ElDropdown zooms. */","+const ELEMENT_INFRASTRUCTURE = [\"popper\", \"icon\", \"fade-in\", \"zoom-in\"]","+","+/** Unprefixed copies Element Plus emits of a few transitions; its components only use the `kel-` ones. */","+const UNPREFIXED_DUPLICATES = /^\\.(fade-in-linear-|collapse-transition|horizontal-collapse-transition|v-modal)/","+","+const PAGE_SELECTOR = /^(:root|html\\.dark)$/","+","+const read = (file) => fs.readFileSync(file, \"utf8\")","+","+const SASS_OPTIONS = {loadPaths: [designSystemStyles, nodeModules], style: \"expanded\", logger: sass.Logger.silent}","+const compileScssFile = (file) => sass.compile(file, SASS_OPTIONS).css","+const compileScss = (source) => sass.compileString(source, SASS_OPTIONS).css","+","+/** Splits CSS into its top-level `prelude { body }` blocks; a body keeps its nested blocks as text. */","+function parseBlocks(css) {","+    const source = css.replace(/\\/\\*[\\s\\S]*?\\*\\//g, \"\").replace(/^@charset[^;]*;/, \"\")","+    const blocks = []","+    let depth = 0","+    let start = 0","+    let open = 0","+    for (let i = 0; i < source.length; i++) {","+        if (source[i] === \"{\" && depth++ === 0) open = i","+        if (source[i] === \"}\" && --depth === 0) {","+            blocks.push({prelude: source.slice(start, open).trim(), body: source.slice(open + 1, i)})","+            start = i + 1","+        }","+    }","+    return blocks","+}","+","+const printBlocks = (blocks) => blocks.map(({prelude, body}) => `${prelude} {${body}}`).join(\"\\n\")","+","+const namesIn = (text) => new Set(text.match(/--(?:ks|kel)-[\\w-]*\\w/g))","+","+/** Prefixes of token names the source builds at runtime, such as `--ks-status-${state}`. */","+const dynamicPrefixesIn = (text) => [...text.matchAll(/(--(?:ks|kel)-[\\w-]*)\\$\\{/g)].map(([, prefix]) => prefix)","+","+/** The graph's own source files, whose styles and scripts name the tokens it reads. */","+function topologyFiles(dir = topologySrc) {","+    return fs.readdirSync(dir, {withFileTypes: true}).flatMap((entry) => {","+        const file = path.join(dir, entry.name)","+        if (entry.isDirectory()) return topologyFiles(file)","+        const isSource = /\\.(vue|ts|css)$/.test(entry.name) && !/\\.(test|stories)\\.ts$/.test(entry.name)","+        return isSource && file !== OUTPUT ? [file] : []","+    })","+}","+","+/** The design-system component files the graph renders, including the ones they render themselves. */","+function designSystemComponents(files) {","+    const index = read(path.join(designSystemSrc, \"index.ts\"))","+    const fileOf = Object.fromEntries([...index.matchAll(/^import (Ks\\w+) from \"(\\.\\/components\\/[^\"]+\\.vue)\"/gm)]","+        .map(([, name, file]) => [name, path.join(designSystemSrc, file)]))","+    const pending = files","+        .flatMap((file) => [...read(file).matchAll(/import\\s*\\{([^}]+)\\}\\s*from\\s*\"@kestra-io\\/design-system\"/g)])","+        .flatMap(([, names]) => names.split(\",\").map((name) => fileOf[name.trim().split(/\\s+as\\s+/)[0]]))","+        .filter(Boolean)","+    const found = new Set()","+    while (pending.length) {","+        const file = pending.pop()","+        if (found.has(file)) continue","+        found.add(file)","+        for (const [, relative] of read(file).matchAll(/import\\s+\\w+\\s+from\\s+\"(\\.{1,2}\\/[^\"]+\\.vue)\"/g)) {","+            pending.push(path.resolve(path.dirname(file), relative))","+        }","+    }","+    return [...found]","+}","+","+/** Element Plus component styles those design-system components load (`button`, `tooltip`...). */","+const elementComponentsOf = (components) =>","+    [...new Set(components.flatMap((file) => [...read(file).matchAll(/@use ['\"]element-plus\\/theme-chalk\\/src\\/([\\w-]+)['\"]/g)].map(([, name]) => name)))].sort()","+","+/** The design-system token files, rescoped from the page to the graph. */","+function tokenBlocks() {","+    return Object.entries(TOKEN_FILES).flatMap(([file, {from, to}]) => parseBlocks(read(path.join(designSystemStyles, file))).map(({prelude, body}) => {","+        if (prelude !== from) throw new Error(`${file}: expected \"${from}\", found \"${prelude}\"`)","+        let scoped = body","+        for (const [token, fallback] of Object.entries(HOST_TOKENS)) {","+            scoped = scoped","+                .replace(new RegExp(`^\\\\s*${token}\\\\s*:[^;]*;$`, \"gm\"), \"\")","+                .replaceAll(`var(${token})`, `var(${token}, ${fallback})`)","+        }","+        return {prelude: to, body: scoped}","+    }))","+}","+","+/** Keeps the rules whose `kel-` classes all belong to `used`; any rule outside that namespace is an error. */","+function keepUsedRules(blocks, used) {","+    const keepSelector = (selector) => {","+        const classes = [...selector.matchAll(/\\.kel-([\\w-]+)/g)].map(([, cls]) => cls)","+        if (classes.length) return classes.every((cls) => used.some((name) => cls.startsWith(name)))","+        if (UNPREFIXED_DUPLICATES.test(selector)) return false","+        if (PAGE_SELECTOR.test(selector)) return true","+        throw new Error(`element-plus.scss emits a rule outside the kel namespace: \"${selector}\"`)","+    }","+    return blocks.flatMap(({prelude, body}) => {","+        if (prelude.startsWith(\"@keyframes\")) return [{prelude, body}]","+        if (prelude.startsWith(\"@media\")) {","+            const inner = keepUsedRules(parseBlocks(body), used)","+            return inner.length ? [{prelude, body: `\\n${printBlocks(inner)}\\n`}] : []","+        }","+        if (prelude.startsWith(\"@\")) throw new Error(`element-plus.scss emits an unexpected at-rule: \"${prelude}\"`)","+        const selectors = prelude.split(\",\").map((selector) => selector.trim()).filter(keepSelector)","+        return selectors.length ? [{prelude: selectors.join(\",\\n\"), body}] : []","+    })","+}","+","+/** Drops the keyframes no remaining rule animates with. */","+function keepUsedKeyframes(blocks) {","+    const rules = printBlocks(blocks.filter(({prelude}) => !prelude.startsWith(\"@keyframes\")))","+    const animations = new Set([...rules.matchAll(/animation(?:-name)?\\s*:\\s*([^;]+);/g)].flatMap(([, value]) => value.split(/[\\s,]+/)))","+    return blocks.filter(({prelude}) => !prelude.startsWith(\"@keyframes\") || animations.has(prelude.split(/\\s+/)[1]))","+}","+","+/** Element Plus's base styles from the design system, limited to what the graph renders. */","+function elementBlocks(used) {","+    const blocks = parseBlocks(compileScssFile(path.join(designSystemStyles, \"element-plus.scss\")))","+    return keepUsedKeyframes(keepUsedRules(blocks, used))","+}","+","+/** Icon sizing from vue-material-design-icons and the design system's global.css, scoped to the graph. */","+function iconBlock() {","+    const base = read(path.join(nodeModules, \"vue-material-design-icons/styles.css\"))","+    const global = read(path.join(designSystemStyles, \"global.css\"))","+    const sizing = global.slice(0, global.indexOf(\"/* global */\")).replace(\"/* material-design-icon */\", \"\")","+    return {prelude: SCOPE, body: `\\n${base.trim()}\\n${sizing.trim()}\\n`}","+}","+","+/** Removes the custom properties nothing reads, following `var()` references from `roots`. */","+function pruneProperties(blocks, roots, prefixes) {","+    const references = new Map()","+    for (const [, name, value] of printBlocks(blocks).matchAll(/(--[\\w-]+)\\s*:\\s*([^;{}]*);/g)) {","+        const refs = references.get(name) ?? new Set()","+        for (const [, ref] of value.matchAll(/var\\(\\s*(--[\\w-]+)/g)) refs.add(ref)","+        references.set(name, refs)","+    }","+    const reachable = new Set()","+    const pending = [...references.keys()].filter((name) => roots.has(name) || prefixes.some((prefix) => name.startsWith(prefix)))","+    while (pending.length) {","+        const name = pending.pop()","+        if (reachable.has(name)) continue","+        reachable.add(name)","+        pending.push(...(references.get(name) ?? []))","+    }","+    const isUnread = (line) => {","+        const name = line.match(/^\\s*(--[\\w-]+)\\s*:/)?.[1]","+        return name !== undefined && !reachable.has(name)","+    }","+    return blocks","+        .map(({prelude, body}) => ({prelude, body: body.split(\"\\n\").filter((line) => !isUnread(line) && line.trim()).join(\"\\n\")}))","+        .filter(({body}) => body.trim())","+        .map(({prelude, body}) => ({prelude, body: `\\n${body}\\n`}))","+}","+","+export function buildStandaloneCss() {","+    const files = topologyFiles()","+    const components = designSystemComponents(files)","+    const elementComponents = elementComponentsOf(components)","+    const tokens = tokenBlocks()","+    const element = elementBlocks([...elementComponents, ...ELEMENT_INFRASTRUCTURE])","+    const icons = iconBlock()","+","+    const elementComponentCss = compileScss([\"@use 'el-ns';\", ...elementComponents.map((name) => `@use 'element-plus/theme-chalk/src/${name}';`)].join(\"\\n\"))","+    const elementRules = element.filter(({prelude}) => !prelude.split(\",\").every((selector) => PAGE_SELECTOR.test(selector.trim())))","+    const consumers = [...files, ...components].map(read).join(\"\\n\")","+    const roots = new Set([...namesIn(consumers), ...namesIn(elementComponentCss), ...namesIn(printBlocks(elementRules)), ...namesIn(printBlocks([icons]))])","+    const prune = (blocks) => printBlocks(pruneProperties(blocks, roots, dynamicPrefixesIn(consumers)))","+","+    return [","+        \"/* Generated by scripts/generate-standalone-css.mjs from the design system. Do not edit. */\",","+        \"/* design-system-disable-start: copies the palette, like the design system it comes from */\",","+        `/* Design-system tokens the graph reads, scoped to it */\\n${prune(tokens)}`,","+        `/* Element Plus base in the kel namespace, for the tooltips and menus inside the graph */\\n${prune(element)}`,","+        `/* Icon sizing */\\n${printBlocks([icons])}`,","+        \"/* design-system-disable-end */\",","+    ].join(\"\\n\\n\") + \"\\n\"","+}","+","+if (process.argv[1] === fileURLToPath(import.meta.url)) {","+    fs.writeFileSync(OUTPUT, buildStandaloneCss())","+    console.log(`wrote ${path.relative(process.cwd(), OUTPUT)}`)","+}"],"additions":214,"deletions":0,"truncated":false},{"path":"ui/packages/topology/src/Topology.test.ts","lines":["@@ -198,4 +198,10 @@ describe(\"Topology collapse all\", () => {"," ","         expect(wrapper.find(\"[data-test='topology-collapse-all']\").exists()).toBe(false)","     })","+","+    it(\"offers nothing to collapse when the API returns no clusters\", () => {","+        const wrapper = mountWithControls({nodes: graph.nodes, edges: graph.edges})","+","+        expect(wrapper.find(\"[data-test='topology-collapse-all']\").exists()).toBe(false)","+    })"," })"],"additions":6,"deletions":0,"truncated":false},{"path":"ui/packages/topology/src/Topology.vue","lines":["@@ -1,5 +1,5 @@"," <template>","-    <div class=\"topology-shell\">","+    <div class=\"topology-shell ks-topology\">","         <FlowSummaryChip","             v-if=\"flowId && !isReadOnly && isAllowedEdit\"","             class=\"topology-flow-bar\"","@@ -214,7 +214,7 @@"," ","     <div","         v-if=\"dragGhost\"","-        class=\"drag-ghost\"","+        class=\"drag-ghost ks-topology\"","         :style=\"{transform: `translate(${dragGhost.x}px, ${dragGhost.y}px)`}\"","         aria-hidden=\"true\"","     >","@@ -261,6 +261,8 @@","     import {EXECUTION_INJECTION_KEY, SUBFLOWS_EXECUTIONS_INJECTION_KEY, LOD_INJECTION_KEY, VALIDATION_ISSUES_INJECTION_KEY, FOCUSED_TASK_INJECTION_KEY, DROP_EDGE_INJECTION_KEY, DRAGGING_NODE_INJECTION_KEY, CANVAS_HOVERED_INJECTION_KEY, LOOP_LANES_INJECTION_KEY, PILL_ZOOM_COMPENSATION_INJECTION_KEY, ARTIFACT_COUNTS_INJECTION_KEY} from \"./injectionKeys\"","     import type {LoopLaneData} from \"./utils/loopOutcome\"","     import BasicNode from \"./nodes/BasicNode.vue\"","+    import {provideGlobalConfig} from \"element-plus\"","+    import {registerTopologyMessages} from \"./i18n\""," ","     const props = withDefaults(defineProps<{","         id: string;","@@ -327,6 +329,11 @@","         defaultViewport: undefined,","     })"," ","+    // The Ks* components render Element Plus markup in the `kel` namespace their styles target.","+    // The Kestra UI sets it app-wide; a page without the design-system plugin gets it here.","+    provideGlobalConfig({namespace: \"kel\"})","+    registerTopologyMessages()","+","     const isRunning = computed(() => {","         const current = props.execution?.state?.current","         return current !== undefined && State.isRunning(current) === true","@@ -636,7 +643,7 @@"," ","     const collapsibleLaneUids = computed(() =>","         outermostLaneUids(","-            props.flowGraph.clusters","+            (props.flowGraph.clusters ?? [])","                 .filter((entry) => VueFlowUtils.isTrueFlowableCluster(entry.cluster))","                 .map((entry) => entry.cluster.uid.replace(CLUSTER_PREFIX, \"\")),","         ),"],"additions":10,"deletions":3,"truncated":false},{"path":"ui/packages/topology/src/i18n.test.ts","lines":["@@ -0,0 +1,75 @@","+import fs from \"node:fs\"","+import path from \"node:path\"","+import {describe, expect, it} from \"vitest\"","+import {defineComponent, h} from \"vue\"","+import {mount} from \"@vue/test-utils\"","+import {createI18n, useI18n} from \"vue-i18n\"","+import bundled from \"./translations/en.json\"","+import {registerTopologyMessages} from \"./i18n\"","+","+type Messages = {[key: string]: string | Messages}","+","+const flatten = (messages: Messages, prefix = \"\"): Record<string, string> =>","+    Object.fromEntries(Object.entries(messages).flatMap(([key, value]) =>","+        typeof value === \"string\" ? [[prefix + key, value]] : Object.entries(flatten(value, `${prefix}${key}.`))))","+","+const lookup = (messages: Messages, key: string): unknown =>","+    key in messages ? messages[key] : key.split(\".\").reduce<unknown>((node, part) => (node as Messages | undefined)?.[part], messages)","+","+const sourceKeys = () => {","+    const keys = new Set<string>()","+    const walk = (dir: string) => {","+        for (const entry of fs.readdirSync(dir, {withFileTypes: true})) {","+            const file = path.join(dir, entry.name)","+            if (entry.isDirectory()) walk(file)","+            else if (/\\.(vue|ts)$/.test(entry.name) && !entry.name.endsWith(\".test.ts\")) {","+                const source = fs.readFileSync(file, \"utf8\")","+                for (const match of source.matchAll(/(?:\\$t|(?<![.\\w])t)\\(\\s*[\"'`]([^\"'`$]+)[\"'`]/g)) keys.add(match[1])","+                for (const match of source.matchAll(/label:\\s*\"([^\"]+)\",\\s*\\/\\/ i18n key/g)) keys.add(match[1])","+            }","+        }","+    }","+    walk(__dirname)","+    return [...keys]","+}","+","+describe(\"bundled English messages\", () => {","+    const ui = JSON.parse(fs.readFileSync(path.resolve(__dirname, \"../../../src/translations/en.json\"), \"utf8\")).en as Messages","+","+    it(\"cover every key the graph translates\", () => {","+        const missing = sourceKeys().filter((key) => typeof lookup(bundled as Messages, key) !== \"string\")","+","+        expect(missing).toEqual([])","+    })","+","+    it(\"match the Kestra UI's English\", () => {","+        // On failure, copy the new values from ui/src/translations/en.json into src/translations/en.json.","+        for (const [key, value] of Object.entries(flatten(bundled as Messages))) {","+            expect(lookup(ui, key), key).toBe(value)","+        }","+    })","+})","+","+describe(\"registerTopologyMessages\", () => {","+    const translate = (messages: Messages, key: string) => {","+        let text = \"\"","+        const Probe = defineComponent({","+            setup() {","+                registerTopologyMessages()","+                const {t} = useI18n()","+                text = t(key)","+                return () => h(\"div\")","+            },","+        })","+        mount(Probe, {global: {plugins: [createI18n({legacy: false, locale: \"en\", messages: {en: messages}})]}})","+        return text","+    }","+","+    it(\"fills in the labels an app does not translate\", () => {","+        expect(translate({}, \"topology-graph.zoom-in\")).toBe(\"Zoom in\")","+    })","+","+    it(\"keeps the app's own translation\", () => {","+        expect(translate({\"topology-graph\": {\"zoom-in\": \"Magnify\"}}, \"topology-graph.zoom-in\")).toBe(\"Magnify\")","+    })","+})"],"additions":75,"deletions":0,"truncated":false},{"path":"ui/packages/topology/src/i18n.ts","lines":["@@ -0,0 +1,25 @@","+import {useI18n} from \"vue-i18n\"","+import en from \"./translations/en.json\"","+","+type Messages = {[key: string]: string | Messages}","+","+const registered = new WeakSet<object>()","+","+function missingFrom(messages: Messages, has: (key: string) => boolean, prefix = \"\"): Messages | undefined {","+    const missing: Messages = {}","+    for (const [key, value] of Object.entries(messages)) {","+        const path = prefix + key","+        const entry = typeof value === \"string\" ? (has(path) ? undefined : value) : missingFrom(value, has, `${path}.`)","+        if (entry !== undefined) missing[key] = entry","+    }","+    return Object.keys(missing).length ? missing : undefined","+}","+","+/** Adds the graph's English labels to the app's i18n, for the keys the app does not translate itself. */","+export function registerTopologyMessages() {","+    const i18n = useI18n({useScope: \"global\"})","+    if (registered.has(i18n)) return","+    registered.add(i18n)","+    const missing = missingFrom(en as Messages, (key) => i18n.te(key, \"en\"))","+    if (missing) i18n.mergeLocaleMessage(\"en\", missing)","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"ui/packages/topology/src/standalone.css","lines":["@@ -0,0 +1,762 @@","+/* Generated by scripts/generate-standalone-css.mjs from the design system. Do not edit. */","+","+/* design-system-disable-start: copies the palette, like the design system it comes from */","+","+/* Design-system tokens the graph reads, scoped to it */","+:where(.ks-topology, .kel-popper) {","+    --ks-font-family-mono: \"JetBrains Mono\", monospace;","+    --ks-font-size-2xs: calc(0.625rem * var(--ks-font-scale, 1));","+    --ks-font-size-xs: calc(0.6875rem * var(--ks-font-scale, 1));","+    --ks-font-size-sm: calc(0.75rem * var(--ks-font-scale, 1));","+    --ks-font-size-lg: calc(1rem * var(--ks-font-scale, 1));","+    --ks-font-size-xl: calc(1.125rem * var(--ks-font-scale, 1));","+    --ks-font-size-2xl: calc(1.25rem * var(--ks-font-scale, 1));","+    --ks-radius-xs: 0.25rem;","+    --ks-radius-sm: 0.375rem;","+    --ks-radius-base: 0.5rem;","+    --ks-radius-lg: 0.625rem;","+    --ks-radius-xl: 0.875rem;","+    --ks-spacing-px: 1px;","+    --ks-spacing-1: 0.25rem;","+    --ks-spacing-2: 0.5rem;","+    --ks-spacing-3: 0.75rem;","+    --ks-spacing-4: 1rem;","+    --ks-spacing-5: 1.5rem;","+    --ks-spacing-7: 2.5rem;","+    --ks-z-dropdown: 1000;","+    --ks-font-weight-regular: 400;","+    --ks-font-wei