FileIndexer,","+)","+from ray.data._internal.datasource_v2.common.round_robin_partitioner import (","+    RoundRobinPartitioner,","+)","+from ray.data._internal.datasource_v2.common.synthesized_columns import PathColumn","+from ray.data._internal.datasource_v2.formats.webdataset.webdataset_scanner import (","+    WebDatasetScanner,","+)","+from ray.data._internal.datasource_v2.formats.webdataset.webdataset_utils import (","+    ALLOW_UNSAFE_DESERIALIZATION_ENV_VAR,","+)","+from ray.data._internal.datasource_v2.interfaces.datasource_v2 import (","+    DatasourceCategory,","+    FileDataSourceV2,","+)","+from ray.data._internal.datasource_v2.interfaces.file_indexer import FileIndexer","+from ray.data._internal.datasource_v2.interfaces.file_manifest import FileManifest","+from ray.data._internal.datasource_v2.interfaces.in_memory_size_estimator import (","+    InMemorySizeEstimator,","+)","+from ray.data._internal.datasource_v2.interfaces.synthesized_columns import (","+    SynthesizedColumn,","+)","+from ray.data._internal.util import (","+    RetryingPyFileSystem,","+    _is_local_scheme,","+    _normalize_paths_to_strings,","+)","+from ray.data.context import DataContext","+from ray.data.datasource.path_util import _resolve_paths_and_filesystem","+from ray.util.annotations import DeveloperAPI","+","+if TYPE_CHECKING:","+    from pyarrow.fs import FileSystem","+","+    from ray.data._internal.datasource_v2.interfaces.file_partitioner import (","+        PartitionHints,","+    )","+    from ray.data.datasource.file_based_datasource import FileShuffleConfig","+","+# In-memory size / tar file size, measured on Imagenette shards.","+WEBDATASET_ENCODING_RATIO_RAW = 0.7","+WEBDATASET_ENCODING_RATIO_DECODED = 8.9  # Measured with default decoder.","+","+","+@DeveloperAPI","+class WebDatasetInMemorySizeEstimator(InMemorySizeEstimator):","+    \"\"\"Estimates in-memory sizes of tar shards with a fixed encoding ratio.\"\"\"","+","+    def __init__(self, encoding_ratio: float):","+        self._encoding_ratio = encoding_ratio","+","+    def estimate_in_memory_sizes(self, manifest: FileManifest) -> np.ndarray:","+        return self._encoding_ratio * manifest.file_sizes","+","+","+@DeveloperAPI","+class WebDatasetDatasourceV2(FileDataSourceV2):","+    \"\"\"V2 datasource that lists tar shards and reads them with WebDatasetScanner.","+","+    RoundRobinPartitioner groups shards into read tasks by estimated","+    in-memory size. The schema is resolved from the first read block.","+    \"\"\"","+","+    def __init__(","+        self,","+        paths: List[str],","+        *,","+        filesystem: Optional[\"FileSystem\"] = None,","+        decoder: Optional[Union[bool, str, Callable, list]] = True,","+        fileselect: Optional[Union[list, Callable]] = None,","+        filerename: Optional[Union[list, Callable]] = None,","+        suffixes: Optional[Union[list, Callable]] = None,","+        verbose_open: bool = False,","+        expand_json: bool = False,","+        include_paths: bool = False,","+        file_extensions: Optional[List[str]] = None,","+        shuffle: Optional[Union[Literal[\"files\"], \"FileShuffleConfig\"]] = None,","+        open_stream_args: Optional[Dict[str, Any]] = None,","+    ):","+        super().__init__(name=\"WebDatasetV2\", category=DatasourceCategory.FILE_BASED)","+        # Check ``local://`` against the original paths.","+        self._supports_distributed_reads = not _is_local_scheme(paths)","+        resolved_paths, resolved_filesystem = _resolve_paths_and_filesystem(","+            paths, filesystem","+        )","+        self._paths: List[str] = resolved_paths","+        # The resolved paths above lose their URI scheme; lineage tracking","+        # reads the caller's paths through ``source_paths``.","+        self._source_paths: List[str] = _normalize_paths_to_strings(paths)","+        self._filesystem = RetryingPyFileSystem.wrap(","+            resolved_filesystem,","+            retryable_errors=DataContext.get_current().retried_io_errors,","+        )","+        self._decoder = decoder","+        self._fileselect = fileselect","+        self._filerename = filerename","+        self._suffixes = suffixes","+        self._verbose_open = verbose_open","+        self._expand_json = expand_json","+        self._file_extensions = file_extensions","+        self._shuffle = shuffle","+        self._open_stream_args = open_stream_args or {}","+        self._allow_unsafe_deserialization = env_bool(","+            ALLOW_UNSAFE_DESERIALIZATION_ENV_VAR, False","+        )","+        synthesized_columns: List[SynthesizedColumn] = []","+        if include_paths:","+            synthesized_columns.append(PathColumn())","+        self._synthesized_columns = tuple(synthesized_columns)","+","+    @property","+    def paths(self) -> List[str]:","+        return self._paths","+","+    @property","+    def source_paths(self) -> List[str]:","+        return self._source_paths","+","+    @property","+    def filesystem(self) -> \"FileSystem\":","+        return self._filesystem","+","+    @property","+    def file_extensions(self) -> Optional[List[str]]:","+        return self._file_extensions","+","+    @property","+    def shuffle(self) -> Optional[Union[Literal[\"files\"], \"FileShuffleConfig\"]]:","+        return self._shuffle","+","+    def _get_file_indexer(self) -> FileIndexer:","+        # One listing row per tar file, or shard.","+        return NonSamplingFileIndexer(ignore_missing_paths=False)","+","+    def get_file_partitioner(","+        self, *, hints: Optional[\"PartitionHints\"] = None","+    ) -> Optional[RoundRobinPartitioner]:","+        if hints is None:","+            return None","+        if DataContext.get_current().execution_options.preserve_order:","+            # One bucket fills in listing order; several deal shards round-robin.","+            hints = dataclasses.replace(hints, num_buckets=1)","+        encoding_ratio = (","+            WEBDATASET_ENCODING_RATIO_RAW","+            if self._decoder is None","+            else WEBDATASET_ENCODING_RATIO_DECODED","+        )","+        return RoundRobinPartitioner(","+            WebDatasetInMemorySizeEstimator(encoding_ratio), hints=hints","+        )","+","+    @property","+    def schema_needs_file_sample(self) -> bool:","+        return True","+","+    def infer_schema(self, sample: Optional[FileManifest]) -> Optional[pa.Schema]:","+        \"\"\"Return ``None`` so the schema is resolved from the first read block.","+","+        A tar shard stores no schema, and decoded column types depend on the","+        decoder, so the schema is only known after decoding samples. Decoding","+        them here would run on the driver and hold a whole chunk in its memory.","+        \"\"\"","+        return None","+","+    def create_scanner(","+        self,","+        schema: Optional[pa.Schema],","+        filesystem: Optional[\"FileSystem\"] = None,","+        **options: Any,","+    ) -> WebDatasetScanner:","+        return WebDatasetScanner(","+            schema=schema,","+            filesystem=filesystem or self._filesystem,","+            decoder=self._decoder,","+            fileselect=self._fileselect,","+            filerename=self._filerename,","+            suffixes=self._suffixes,","+            verbose_open=self._verbose_open,","+            expand_json=self._expand_json,","+            allow_unsafe_deserialization=self._allow_unsafe_deserialization,","+            open_stream_args=dict(self._open_stream_args),","+            synthesized_columns=self._synthesized_columns,","+            target_block_size=DataContext.get_current().target_max_block_size,","+            partitioning=options.get(\"partitioning\"),","+            shuffle=self._shuffle,","+        )"],"additions":204,"deletions":0,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/formats/webdataset/webdataset_reader.py","lines":["@@ -0,0 +1,204 @@","+\"\"\"``WebDatasetReader``: reads WebDataset tar shards into Arrow tables.","+","+Each shard is read sequentially from start to end. Members that share a key","+form one sample, which is decoded and added to the current table. A table is","+cut every ``WEBDATASET_READ_CHUNK_SIZE`` samples or once its samples reach","+``target_block_size`` bytes. A tar stream can't be rewound, so a retryable error","+reopens the shard and reads it again from the start, skipping the tables already","+yielded. Snappy shards are decompressed whole into memory.","+\"\"\"","+","+import functools","+import sys","+from typing import (","+    TYPE_CHECKING,","+    Any,","+    Callable,","+    Dict,","+    Iterator,","+    List,","+    Optional,","+    Sequence,","+    Tuple,","+    Union,","+)","+","+import pyarrow as pa","+","+from ray.data._internal.datasource_v2.common.line_chunkable_file_reader import (","+    read_snappy_buffer,","+)","+from ray.data._internal.datasource_v2.formats.webdataset.webdataset_utils import (","+    WEBDATASET_READ_CHUNK_SIZE,","+    iter_webdataset_rows,","+)","+from ray.data._internal.datasource_v2.interfaces.file_manifest import FileManifest","+from ray.data._internal.datasource_v2.interfaces.read_units import ReadUnit","+from ray.data._internal.datasource_v2.interfaces.reader import Reader","+from ray.data._internal.datasource_v2.interfaces.synthesized_columns import (","+    ReadUnitPosition,","+    SynthesizedColumn,","+)","+from ray.data._internal.util import infer_compression, iterate_with_retry","+from ray.data.block import BlockAccessor, BlockType","+from ray.data.context import DataContext","+from ray.util.annotations import DeveloperAPI","+","+if TYPE_CHECKING:","+    from pyarrow.fs import FileSystem","+","+","+def _rows_to_arrow(rows: List[Dict[str, Any]]) -> pa.Table:","+    columns = list(dict.fromkeys(key for row in rows for key in row))","+    return BlockAccessor.batch_to_block(","+        # A sample that lacks a key gets a null in that column.","+        {column: [row.get(column) for row in rows] for column in columns},","+        block_type=BlockType.ARROW,","+    )","+","+","+def _estimate_bytes(value: Any) -> int:","+    \"\"\"Estimate the in-memory size of a decoded sample value.\"\"\"","+    if isinstance(value, (bytes, str)):","+        return len(value)","+    if isinstance(value, dict):","+        return sum(_estimate_bytes(v) for v in value.values())","+    if isinstance(value, (list, tuple)):","+        return sum(_estimate_bytes(v) for v in value)","+    nbytes = getattr(value, \"nbytes\", None)","+    if isinstance(nbytes, int):","+        # NumPy arrays and torch tensors.","+        return nbytes","+    if hasattr(value, \"getbands\"):","+        # PIL images.","+        width, height = value.size","+        return width * height * len(value.getbands())","+    return sys.getsizeof(value)","+","+","+@DeveloperAPI","+class WebDatasetReader(Reader[FileManifest]):","+    \"\"\"Reads the tar shards in a manifest and yields Arrow tables.","+","+    Each shard is read sequentially from start to end.","+    \"\"\"","+","+    def __init__(","+        self,","+        *,","+        filesystem: \"FileSystem\",","+        decoder: Optional[Union[bool, str, Callable, list]],","+        fileselect: Optional[Union[list, Callable]],","+        filerename: Optional[Union[list, Callable]],","+        suffixes: Optional[Union[list, Callable]],","+        verbose_open: bool,","+        expand_json: bool,","+        allow_unsafe_deserialization: bool,","+        open_stream_args: Optional[Dict[str, Any]] = None,","+        synthesized_columns: Sequence[SynthesizedColumn] = (),","+        target_block_size: Optional[int] = None,","+    ):","+        \"\"\"Initialize the reader.","+","+        Args:","+            filesystem: Filesystem the tar shards are opened with.","+            decoder: Decoder spec applied to each sample, or ``None`` to skip.","+            fileselect: Patterns or function selecting files while reading.","+            f