{"id":"a2a9b9ef93f5e0b90098fe390156f49a509ac30f","axis":"silent","repo":"TryGhost/Ghost","sha":"a2a9b9ef93f5e0b90098fe390156f49a509ac30f","parsed":{"files":[{"path":"docs/plans/better-auth-migration.md","lines":["@@ -572,14 +572,14 @@ compatibility."," Compatibility controllers map Better Auth `APIError`s to `@tryghost/errors`"," with today's messages, so older Admin builds keep working:"," ","-| Better Auth                    | Ghost error                                                 |","-| ------------------------------ | ----------------------------------------------------------- |","-| `INVALID_EMAIL_OR_PASSWORD`    | today's messages or one generic message, decided with SC-90 |","-| `PASSWORD_RESET_REQUIRED`      | `PasswordResetRequiredError`                                |","-| `ACCOUNT_SUSPENDED`            | `NoPermissionError` `This account has been suspended.`      |","-| `DEVICE_VERIFICATION_REQUIRED` | `NoPermissionError`, `Needs2FAError`, `2FA_*` code          |","-| `INVALID_TOKEN` / expired      | existing reset-token messages                               |","-| `TOO_MANY_REQUESTS`            | `TooManyRequestsError`                                      |","+| Better Auth                    | Ghost error                                              |","+| ------------------------------ | -------------------------------------------------------- |","+| `INVALID_EMAIL_OR_PASSWORD`    | `ValidationError` `Your email or password is incorrect.` |","+| `PASSWORD_RESET_REQUIRED`      | `PasswordResetRequiredError`                             |","+| `ACCOUNT_SUSPENDED`            | `NoPermissionError` `This account has been suspended.`   |","+| `DEVICE_VERIFICATION_REQUIRED` | `NoPermissionError`, `Needs2FAError`, `2FA_*` code       |","+| `INVALID_TOKEN` / expired      | existing reset-token messages                            |","+| `TOO_MANY_REQUESTS`            | `TooManyRequestsError`                                   |"," "," The native endpoints emit the codes the React `AuthClient` expects"," (`PASSWORD_RESET_REQUIRED`, `INVALID_CODE`, `twoFactorRedirect` +","@@ -589,9 +589,11 @@ Better Auth's `INVALID_EMAIL_OR_PASSWORD`, so `USER_NOT_FOUND` and"," `INVALID_PASSWORD` are not used. Admin's sign-in form keys on those two codes"," to mark the email or password field, so its native client must treat"," `INVALID_EMAIL_OR_PASSWORD` as one error for both fields. Suspension and","-`PASSWORD_RESET_REQUIRED` only show after a matching password. Today's","-messages enumerate staff (SC-90); whether the compatibility controllers keep","-them is decided with SC-90.","+`PASSWORD_RESET_REQUIRED` only show after a matching password. The","+compatibility `POST /session` does the same (SC-90): it answers","+`INVALID_EMAIL_OR_PASSWORD` with one generic `ValidationError` (422, no `code`),","+so Admin shows the message without marking either field. Legacy sign-in keeps","+today's messages."," "," ### 5.4 Behaviour"," "],"additions":13,"deletions":11,"truncated":false},{"path":"ghost/core/server/api/endpoints/session.ts","lines":["@@ -3,12 +3,37 @@ import type { NextFunction, Request, Response } from 'express';"," import * as errors from '@tryghost/errors';"," import tpl from '@tryghost/tpl';"," import type { SpamPrevention } from '../../web/shared/middleware/api/spam-prevention';","+import config from '../../../shared/config';","+import urlUtils from '../../../shared/url-utils';"," "," const models = require('../../models');"," const auth = require('../../auth');"," const api = require('./index');"," const spamPrevention: SpamPrevention = require('../../web/shared/middleware/api/spam-prevention');"," ","+// Chosen once at load, as in auth/authenticate.ts","+const isBetterAuth = config.get('auth:engine') === 'better-auth';","+","+type BetterAuthSession = ReturnType<","+  typeof import('../../auth/better-auth/session-controller').createSessionController","+>;","+","+// Better Auth loads only under its engine","+let betterAuthSession: BetterAuthSession | undefined;","+function getBetterAuthSession(): BetterAuthSession {","+  if (!betterAuthSession) {","+    const { createSessionController } = require('../../auth/better-auth/session-controller');","+","+    betterAuthSession = createSessionController({","+      getAuth: () => auth.betterAuth.service.api,","+      getOriginOfRequest: auth.session.getOriginOfRequest,","+      getAdminOrigin: () => urlUtils.getAdminOrigin(),","+      resetUserLogin: (req: Request) => spamPrevention.userLogin().resetRequest(req),","+    }) as BetterAuthSession;","+  }","+  return betterAuthSession;","+}","+"," const messages = {","   accessDenied: 'Access Denied.',"," };","@@ -31,6 +56,17 @@ const controller = {","       );","     }"," ","+    if (isBetterAuth) {","+      const credentials = { email: object.username, password: object.password };","+      return Promise.resolve(function betterAuthSignInMw(","+        req: Request,","+        res: Response,","+        next: NextFunction,","+      ) {","+        getBetterAuthSession().signIn(req, res, next, credentials);","+      });","+    }","+","     let skipVerification = false;"," ","     return models.User.getByEmail(object.username)","@@ -86,6 +122,16 @@ const controller = {","       });","   },","   delete(): Promise<SessionMiddleware> {","+    if (isBetterAuth) {","+      return Promise.resolve(function betterAuthSignOutMw(","+        req: Request,","+        res: Response,","+        next: NextFunction,","+      ) {","+        getBetterAuthSession().signOut(req, res, next);","+      });","+    }","+","     return Promise.resolve(function logoutSessionMw(","       req: Request,","       res: Response,"],"additions":46,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/README.md","lines":["@@ -81,6 +81,8 @@ until Phase 4.","   user's status too. Server-only: `createVerifiedSession`, which requires the","   admin origin, `revokeUserSessions` and `revokeAllSessions`, which no Ghost","   caller uses yet.","+- `session-controller.ts`: `POST` and `DELETE /session` under `better-auth`,","+  described below."," - `routes.ts`: the Better Auth paths that matchers, limiters and","   `disabledPaths` refer to. A mistyped path matches nothing, silently."," ","@@ -164,6 +166,51 @@ table graduates), all of this uses `users.password` as before."," > (`pnpm reset:db`, or `pnpm reset:data` for generated content), or reset the"," > affected users' passwords."," ","+## Running Better Auth locally","+","+The monorepo's development config already has the tables and","+`auth:betterAuthDev`, so only the engine needs switching:","+","+```bash","+auth__engine=better-auth pnpm dev:up","+```","+","+Or set `\"auth\": {\"engine\": \"better-auth\"}` in `ghost/config.local.json`.","+Outside the monorepo's config, also set `auth:betterAuthDev` to `true`. Legacy","+session cookies are not read, so staff sign in again once, and again after","+switching back to `legacy`. Sign-in pins each session to the admin origin, so","+sign in through the admin URL Ghost is configured with; a session used from","+another origin is refused. Development config has","+`security:staffDeviceVerification` off, so every new session is verified; with","+it on, sign-in can't complete until device verification moves (plan Phase 3).","+","+## Compatibility routes","+","+Under `better-auth`, `POST /session` (`session-controller.ts`) calls","+`signInEmail` with headers only and `returnHeaders`, and forwards the session","+cookie, with the legacy body, `201`, rate limits and `userLogin` reset on","+success. `DELETE /session` calls `signOut` and answers `204`. Server-side calls skip Better","+Auth's origin checks, so the controller keeps the legacy login-CSRF check. It","+answers Better Auth's `INVALID_EMAIL_OR_PASSWORD` with one generic error, a","+`422` `ValidationError` \"Your email or password is incorrect.\" with no `code`,","+for an unknown email, a wrong password and a wrong password on a suspended","+account. Status errors still need a matching password. The legacy `sessions` table is untouched.","+","+A `session.create.before` hook in `create-auth.ts` sets what","+`resolvePrincipal` checks on every new session:","+","+- `origin`: the request's origin, by the legacy session's rule (Origin, else","+  Referer, else the admin URL). On `POST /session` the controller has already","+  required it to be the admin origin, and native `/sign-in/email` has Better","+  Auth's origin check. A session without one resolves as anonymous.","+- `verified`: `true` while `security:staffDeviceVerification` is off, as","+  legacy does.","+","+A rotation (`/change-password` with `revokeOtherSessions`) carries `origin`","+and `verified` over from the replaced session. The hook keeps the `origin`","+that `createVerifiedSession` requires, and never sets `verified` back to","+`false`.","+"," ## Tables"," "," `user_accounts`, `user_sessions` and `verifications` are defined in"],"additions":47,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/create-auth.ts","lines":["@@ -41,8 +41,14 @@ export type CreateAuthDeps = {","   limiters: Limiters;","   /** Emails a legacy password reset link; a locked user's sign-in sends one */","   sendPasswordResetEmail(email: string): Promise<void>;","+  /** `security:staffDeviceVerification`, read per session so config changes apply */","+  isStaffDeviceVerificationEnabled(): boolean;","+  /** The legacy session's origin rule (Origin, else Referer, else the admin URL) */","+  getRequestOrigin(headers: Headers): string | null;"," };"," ","+type SessionPins = { userId?: string; verified?: boolean; origin?: string | null };","+"," /**","  * Refuses a database Better Auth can't run on (plan §3.2): SQLite, or one","  * that doesn't keep Better Auth's data. `auth:betterAuthDev` only applies where","@@ -195,6 +201,32 @@ export function createAuth(deps: CreateAuthDeps) {","         }","       }),","     },","+    databaseHooks: {","+      session: {","+        create: {","+          async before(session, ctx) {","+            const data: { verified?: boolean; origin?: string } = {};","+            // A rotation (`/change-password` revoking others) replaces the current session","+            const replaced = ctx?.context.session?.session as SessionPins | undefined;","+            const rotated = replaced?.userId === session.userId ? replaced : undefined;","+","+            // Never downgrades: createVerifiedSession passes `verified` itself","+            if (rotated?.verified || !deps.isStaffDeviceVerificationEnabled()) {","+              data.verified = true;","+            }","+            // Pinned at creation; resolvePrincipal treats a session without one as anonymous","+            if (!session.origin) {","+              const origin =","+                rotated?.origin ?? (ctx?.headers ? deps.getRequestOrigin(ctx.headers) : null);","+              if (origin) {","+                data.origin = origin;","+              }","+            }","+            return { data };","+          },","+        },","+      },","+    },","     plugins: [ghostStaffLifecycle({ sendPasswordResetEmail: deps.sendPasswordResetEmail })],","     telemetry: { enabled: false },","     logger: {"],"additions":32,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/index.ts","lines":["@@ -40,6 +40,10 @@ export default defineService('Better Auth', async (): Promise<GhostAuth> => {","       const token = await passwordreset.generateToken(email, api.settings);","       await passwordreset.sendResetNotification(token, api.mail);","     },","+    // Only `true` turns it on, as in `auth/session`","+    isStaffDeviceVerificationEnabled: () => config.get('security:staffDeviceVerification') === true,","+    getRequestOrigin: (headers) =>","+      require('../session').default.getOriginOfRequest({ headers: Object.fromEntries(headers) }),","   });","   // betterAuth() defers its setup to this promise; awaiting it fails boot, not the first request","   await auth.$context;"],"additions":4,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/session-controller.ts","lines":["@@ -0,0 +1,134 @@","+import errors, { utils as errorUtils } from '@tryghost/errors';","+import { BASE_ERROR_CODES } from 'better-auth';","+import { isAPIError } from 'better-auth/api';","+import { fromNodeHeaders } from 'better-auth/node';","+import type { NextFunction, Request, Response } from 'express';","+import type { GhostAuth } from './create-auth';","+import { SESSION_COOKIE_NAME } from './create-auth';","+import { STAFF_LIFECYCLE_ERROR_CODES } from './plugins/staff-lifecycle';","+","+// Legacy messages (`models/user.js`, `api/endpoints/session.js`), plus one generic sign-in error","+const messages = {","+  accessDenied: 'Access Denied.',","+  accountSuspended: 'Your account was suspended.',","+  incorrectCredentials: 'Your email or password is incorrect.',","+  noOrigin:","+    'Could not determine origin of request. Please ensure an Origin or Referrer header is present.',","+};","+","+export type SessionControllerDeps = {","+  /** Read per call: the instance is built by boot */","+  getAuth(): Pick<GhostAuth['api'], 'signInEmail' | 'signOut'>;","+  /** The legacy session's origin rule: Origin, else Referer, else the admin URL */","+  getOriginOfRequest(req: Request): string | null;","+  getAdminOrigin(): string;","+  /** Clears this request's failed sign-ins, as legacy sign-in does */","+  resetUserLogin(req: Request): Promise<unknown>;","+};","+","+// Ghost sets only the session cookie; Better Auth also expires cookies Ghost never sets","+const isSessionCookie = (cookie: string) => {","+  const name = cookie.slice(0, cookie.indexOf('='));","+  return name === SESSION_COOKIE_NAME || name === `__Secure-${SESSION_COOKIE_NAME}`;","+};","+","+function forwardSessionCookie(headers: Headers, res: Response) {","+  // An array, as express-session sends it","+  res.setHeader('Set-Cookie', headers.getSetCookie().filter(isSessionCookie));","+}","+","+/**","+ * `POST` and `DELETE /session` on Better Auth, with the legacy responses and","+ * errors (plan §5.1, §5.3).","+ */","+export function createSessionController(deps: SessionControllerDeps) {","+  // Server-side calls skip Better Auth's origin checks, so this is the login-CSRF check","+  function assertAdminOrigin(req: Request) {","+    const origin = deps.getOriginOfRequest(req);","+    if (!origin) {","+      throw new errors.BadRequestError({ message: messages.noOrigin });","+    }","+    const adminOrigin = deps.getAdminOrigin();","+    if (origin !== adminOrigin) {","+      throw new errors.BadRequestError({","+        message: `Request made from incorrect origin. Expected '${adminOrigin}' received '${origin}'.`,","+      });","+    }","+  }","+","+  // One error for an unknown email or a wrong password, so sign-in does not enumerate staff","+  // (status errors need a matching password). The lifecycle plugin has already emailed a locked user.","+  const credentialsError = () =>","+    new errors.ValidationError({ message: messages.incorrectCredentials });","+","+  function toGhostError(err: unknown) {","+    if (!isAPIError(err)) {","+      return errorUtils.isGhostError(err as Error)","+        ? err","+        : new errors.UnauthorizedError({ message: messages.accessDenied, err: err as Error });","+    }","+","+    switch (err.body?.code) {","+      case BASE_ERROR_CODES.INVALID_EMAIL_OR_PASSWORD.code:","+      case BASE_ERROR_CODES.INVALID_EMAIL.code:","+        return credentialsError();","+      case STAFF_LIFECYCLE_ERROR_CODES.PASSWORD_RESET_REQUIRED.code:","+        return new errors.PasswordResetRequiredError();","+      case STAFF_LIFECYCLE_ERROR_CODES.ACCOUNT_SUSPENDED.code:","+        return new errors.NoPermissionError({ message: messages.accountSuspended });","+      default:","+        if (err.statusCode === 429) {","+          return new errors.TooManyRequestsError({ message: err.message, err });","+        }","+        return new errors.UnauthorizedError({ message: messages.accessDenied, err: err as Error });","+    }","+  }","+","+  async function signIn(","+    req: Request,","+    res: Response,","+    next: NextFunction,","+    { email, password }: { email: string; password: string },","+  ) {","+    try {","+      assertAdminOrigin(req);","+","+      let headers: Headers;","+      try {","+        // `headers` without `request`, so Better Auth returns headers rather than a Response","+        ({ headers } = await deps.getAuth().signInEmail({","+          body: { email, password },","+          headers: fromNodeHeaders(req.headers),","+          returnHeaders: true,","+        }));","+      } catch (err) {","+        throw toGhostError(err);","+      }","+","+      await deps.resetUserLogin(req);","+      forwardSessionCookie(headers, res);","+      res.sendStatus(201);","+    } catch (err) {","+      next(err);","+    }","+  }","+","+  async function signOut(req: Request, res: Response, next: NextFunction) {","+    try {","+      const { headers } = await deps.getAuth().signOut({","+        headers: fromNodeHeaders(req.headers),","+        returnHeaders: true,","+      });","+      forwardSessionCookie(headers, res);","+      res.sendStatus(204);","+    } catch (err) {","+      next(","+        errorUtils.isGhostError(err as Error)","+          ? err","+          : new errors.InternalServerError({ err: err as Error }),","+      );","+    }","+  }","+","+  return { signIn, signOut };","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"ghost/test/e2e-api/admin/credential-passwords.test.ts","lines":["@@ -40,6 +40,8 @@ function betterAuth() {","     logger: { debug() {}, info() {}, warn() {}, error() {} },","     limiters: { globalBlock: allow, globalReset: allow, userLogin: allow, userReset: allow },","     sendPasswordResetEmail: async () => {},","+    isStaffDeviceVerificationEnabled: () => false,","+    getRequestOrigin: (headers) => headers.get('origin'),","   });","   const origin = urlUtils.getAdminOrigin();"," "],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/test/e2e-api/admin/session.test.js","lines":["@@ -8,6 +8,9 @@ const {"," const { mockMail, assert, restore } = require('../../utils/e2e-framework-mock-manager');"," const { anyContentVersion, anyEtag, stringMatching, anyUuid } = matchers;"," ","+// Device verification on Better Auth is plan Phase 3","+const isBetterAuth = configUtils.config.get('auth:engine') === 'better-auth';","+"," describe('Sessions API', function () {","   let agent;"," ","@@ -50,7 +53,7 @@ describe('Sessions API', function () {","     await agent.get('/users/me/').expectStatus(403);","   });"," ","-  describe('Staff 2FA', function () {","+  describe.skipIf(isBetterAuth)('Staff 2FA', function () {","     let mail;"," ","     beforeEach(async function () {"],"additions":4,"deletions":1,"truncated":false},{"path":"ghost/test/e2e-server/better-auth-principal.isolated.test.ts","lines":["@@ -45,6 +45,8 @@ describe.skipIf(isSQLite)('Admin API session principal under auth:engine better-","     configUtils.set('createInDevelopmentTables', true);","     configUtils.set('url', `${siteOrigin}/`);","     configUtils.set('admin:url', `${adminOrigin}/`);","+    // Native sign-in then starts unverified; each test sets the state it needs","+    configUtils.set('security:staffDeviceVerification', true);"," ","     app = await startGhost({ backend: true, frontend: false, server: false });","     await fixtureManager.init('users');"],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/test/e2e-server/better-auth-session.isolated.test.ts","lines":["@@ -0,0 +1,178 @@","+import assert from 'node:assert/strict';","+import sinon from 'sinon';","+import request from 'supertest';","+","+const {","+  startGhost,","+  fixtureManager,","+  configUtils,","+  mockManager,","+  resetRateLimits,","+} = require('../utils/e2e-framework');","+const db = require('../../core/server/data/db');","+const jobsService = require('../../core/server/services/jobs-service');","+const stripe = require('../../core/server/services/stripe');","+const sentry = require('../../core/shared/sentry');","+const DataGenerator = require('../utils/fixtures/data-generator');","+","+const isSQLite = ['sqlite3', 'better-sqlite3'].includes(db.knex.client.config.client);","+","+const [owner, locked, inactive] = DataGenerator.Content.users;","+","+// POST and DELETE /session as compatibility controllers over Better Auth","+describe.skipIf(isSQLite)('Admin API /session under auth:engine better-auth', function () {","+  const sandbox = sinon.createSandbox();","+  const adminOrigin = 'http://localhost:2369';","+  const host = new URL(adminOrigin).host;","+  let app: Parameters<typeof request>[0];","+","+  const signIn = (username: string, password: string, origin = adminOrigin) =>","+    request(app)","+      .post('/ghost/api/admin/session/')","+      .set('Host', host)","+      .set('Origin', origin)","+      .send({ username, password });","+","+  const cookieOf = (response: request.Response) =>","+    [response.headers['set-cookie']].flat().map((c: string) => c.split(';')[0]);","+","+  const me = (cookie: string[]) =>","+    request(app)","+      .get('/ghost/api/admin/users/me/')","+      .set('Host', host)","+      .set('Origin', adminOrigin)","+      .set('Cookie', cookie);","+","+  const sessions = (userId: string) => db.knex('user_sessions').where({ user_id: userId });","+","+  beforeAll(async function () {","+    configUtils.set('sentry:disabled', true);","+    sandbox.stub(sentry, 'captureException');","+    sandbox.stub(sentry, 'captureMessage');","+    configUtils.set('auth:engine', 'better-auth');","+    configUtils.set('createInDevelopmentTables', true);","+    configUtils.set('url', `${adminOrigin}/`);","+","+    app = await startGhost({ backend: true, frontend: false, server: false });","+    await fixtureManager.init('users');","+  });","+","+  beforeEach(async function () {","+    // mockManager.restore() resets config, and the origin check reads the URL per request","+    configUtils.set('url', `${adminOrigin}/`);","+    configUtils.set('security:staffDeviceVerification', false);","+    await resetRateLimits();","+    await db.knex('user_sessions').del();","+    await db.knex('users').update({ status: 'active' });","+    await db.knex('users').where({ id: locked.id }).update({ status: 'locked' });","+    await db.knex('users').where({ id: inactive.id }).update({ status: 'inactive' });","+    mockManager.mockMail();","+  });","+","+  afterEach(function () {","+    mockManager.restore();","+  });","+","+  afterAll(async function () {","+    sandbox.restore();","+    try {","+      await jobsService.shutdown();","+    } finally {","+      await stripe.shutdown();","+      await configUtils.restore();","+    }","+  });","+","+  it('signs in with a verified session pinned to the admin origin, then signs out', async function () {","+    const response = await signIn(owner.email, owner.password).expect(201);","+    const cookie = cookieOf(response);","+","+    assert.deepEqual(cookie.length, 1);","+    assert.match(cookie[0], /^ghost-admin-api-session=/);","+    const [session] = await sessions(owner.id);","+    assert.equal(Boolean(session.verified), true);","+    assert.equal(session.origin, adminOrigin);","+    await me(cookie).expect(200);","+","+    const signOut = await request(app)","+      .delete('/ghost/api/admin/session/')","+      .set('Host', host)","+      .set('Origin', adminOrigin)","+      .set('Cookie', cookie)","+      .expect(204);","+","+    assert.match(cookieOf(signOut)[0], /^ghost-admin-api-session=$/);","+    assert.equal((await sessions(owner.id)).length, 0);","+    await me(cookie).expect(403);","+  });","+","+  it('leaves the session unverified when device verification is on', async function () {","+    configUtils.set('security:staffDeviceVerification', true);","+","+    const response = await signIn(owner.email, owner.password).expect(201);","+","+    const [session] = await sessions(owner.id);","+    assert.equal(Boolean(session.verified), false);","+    await me(cookieOf(response)).expect(403);","+  });","+","+  const assertIncorrectCredentials = (response: request.Response) => {","+    const [error] = response.body.errors;","+    assert.equal(error.type, 'ValidationError');","+    assert.equal(error.message, 'Your email or password is incorrect.');","+    assert.equal(error.code, null);","+  };","+","+  it('reports a wrong password with the generic error', async function () {","+    assertIncorrectCredentials(await signIn(owner.email, 'not-the-password').expect(422));","+  });","+","+  it('reports an unknown email with the generic error', async function () {","+    assertIncorrectCredentials(await signIn('nobody@example.com', owner.password).expect(422));","+  });","+","+  it('reports a wrong password on a suspended user with the generic error', async function () {","+    assertIncorrectCredentials(await signIn(inactive.email, 'not-the-password').expect(422));","+  });","+","+  it('reports a suspended user only after a matching password', async function () {","+    const response = await signIn(inactive.email, inactive.password).expect(403);","+","+    assert.equal(response.body.errors[0].message, 'Your account was suspended.');","+    assert.equal((await sessions(inactive.id)).length, 0);","+  });","+","+  it('emails a locked user on a wrong password without saying so', async function () {","+    assertIncorrectCredentials(await signIn(locked.email, 'not-the-password').expect(422));","+","+    await mockManager.assert.sentEmailEventually({ to: locked.email });","+    assert.equal((await sessions(locked.id)).length, 0);","+  });","+","+  it('reports a locked user only after a matching password', async function () {","+    const response = await signIn(locked.email, locked.password).expect(401);","+","+    assert.equal(response.body.errors[0].type, 'PasswordResetRequiredError');","+    assert.equal((await sessions(locked.id)).length, 0);","+  });","+","+  it('refuses a missing password', async function () {","+    const response = await request(app)","+      .post('/ghost/api/admin/session/')","+      .set('Host', host)","+      .set('Origin', adminOrigin)","+      .send({ username: owner.email })","+      .expect(401);","+","+    assert.equal(response.body.errors[0].message, 'Access Denied.');","+  });","+","+  it('refuses a cross-origin sign-in', async function () {","+    const response = await signIn(owner.email, owner.password, 'http://elsewhere.example').expect(","+      400,","+    );","+","+    assert.match(response.body.errors[0].message, /incorrect origin/);","+    assert.equal((await sessions(owner.id)).length, 0);","+  });","+});"],"additions":178,"deletions":0,"truncated":false},{"path":"ghost/test/integration/auth/create-auth.test.ts","lines":["@@ -6,6 +6,7 @@ import config from '../../../core/shared/config';"," import urlUtils from '../../../core/shared/url-utils';"," import { createAuth } from '../../../core/server/auth/better-auth/create-auth';"," import { seedCredentialAccounts } from '../../../core/server/auth/better-auth/seed-credential-accounts';","+import legacySession from '../../../core/server/auth/session';"," "," // Never blocks; the rate limits have their own tests"," const allow = () => ({ consume: async () => ({ allowed: true as const }), reset: async () => {} });","@@ -30,7 +31,7 @@ describe.skipIf(isSQLite)('Better Auth instance', function () {","     sinon.restore();","   });"," ","-  function build() {","+  function build({ deviceVerification = true } = {}) {","     return createAuth({","       db: knex,","       secret: 'a'.repeat(64),","@@ -40,6 +41,9 @@ describe.skipIf(isSQLite)('Better Auth instance', function () {","       logger: { debug() {}, info() {}, warn() {}, error() {} },","       limiters,","       sendPasswordResetEmail: async () => {},",