il regex","+        yield [ 'data:text/html,<h1>xss</h1>',           false, '' ];","+","+        // Null byte in host (percent-encoded): % is not in [a-zA-Z0-9._-]","+        yield [ 'http://evil.com%00.example.com/',        false, '' ];","+","+        // Host that is only invalid characters","+        yield [ 'http://!@#$%^&*()/path',                 false, '' ];","+    }","+","+    /**","+     * Test yourls_get_domain() against well-formed, IDN, bogus and exploit-attempt URLs","+     */","+    #[\\PHPUnit\\Framework\\Attributes\\DataProvider('list_of_get_domain')]","+    function test_get_domain( $url, $include_scheme, $expected ) {","+        $this->assertSame( $expected, yourls_get_domain( $url, $include_scheme ) );","+    }","+"," }",""],"additions":63,"deletions":0,"truncated":false}],"additions":106,"deletions":17,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-08-22T08:18:23.019496+00:00"}