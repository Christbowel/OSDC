 run attribute,","+// and that it is not set for ordinary runs.","+func TestRemote_minimalRefresh(t *testing.T) {","+\tcases := map[string]struct {","+\t\tapply          bool","+\t\tminimalRefresh bool","+\t}{","+\t\t\"plan\":                  {},","+\t\t\"plan minimal refresh\":  {minimalRefresh: true},","+\t\t\"apply\":                 {apply: true},","+\t\t\"apply minimal refresh\": {apply: true, minimalRefresh: true},","+\t}","+","+\tfor name, tc := range cases {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tb, bCleanup := testBackendDefault(t)","+\t\t\tdefer bCleanup()","+\t\t\tb.client.SetFakeRemoteAPIVersion(cloud.MinimalRefreshMinAPIVersion)","+","+\t\t\tvar op *backendrun.Operation","+\t\t\tvar configCleanup func()","+\t\t\tif tc.apply {","+\t\t\t\to, cc, done := testOperationApply(t, \"./testdata/apply\")","+\t\t\t\tdefer done(t)","+\t\t\t\top, configCleanup = o, cc","+\t\t\t} else {","+\t\t\t\to, cc, done := testOperationPlan(t, \"./testdata/plan\")","+\t\t\t\tdefer done(t)","+\t\t\t\top, configCleanup = o, cc","+\t\t\t}","+\t\t\tdefer configCleanup()","+","+\t\t\top.Workspace = backend.DefaultStateName","+\t\t\top.PlanMinimalRefresh = tc.minimalRefresh","+","+\t\t\trun, err := b.Operation(context.Background(), op)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"error starting operation: %v\", err)","+\t\t\t}","+\t\t\t<-run.Done()","+","+\t\t\terrOutput := b.CLI.(*cli.MockUi).ErrorWriter.String()","+\t\t\tif run.Result != backendrun.OperationSuccess {","+\t\t\t\tt.Fatalf(\"operation failed: %s\", errOutput)","+\t\t\t}","+\t\t\tif strings.Contains(errOutput, \"not supported\") {","+\t\t\t\tt.Fatalf(\"unexpected unsupported diagnostic: %s\", errOutput)","+\t\t\t}","+","+\t\t\trunsAPI := b.client.Runs.(*cloud.MockRuns)","+\t\t\tif got := len(runsAPI.Runs); got != 1 {","+\t\t\t\tt.Fatalf(\"wrong number of runs in the mock client %d; want 1\", got)","+\t\t\t}","+\t\t\tfor _, r := range runsAPI.Runs {","+\t\t\t\tif got, want := r.MinimalRefresh, tc.minimalRef