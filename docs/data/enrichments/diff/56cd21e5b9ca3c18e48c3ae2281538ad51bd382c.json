ed","+parser's limit::","+","+    from mistune import BlockParser, HTMLRenderer, Markdown","+","+    markdown = Markdown(","+        renderer=HTMLRenderer(),","+        block=BlockParser(max_nested_level=12),","+    )","+    assert markdown.inline.max_nested_level == 12","+","+The older inline settings ``max_emphasis_depth`` and ``max_image_depth`` are","+aliases for the shared limit. Limits must be positive; they cannot disable","+nesting bounds.","+","+Link reference labels follow CommonMark's maximum of 999 source characters,","+including backslashes used for escapes. Bare link destinations must have","+balanced parentheses, bounded by the parser's nesting limit, and cannot","+contain ASCII control characters. Parenthesized titles cannot contain an","+unescaped opening parenthesis.","+","+A failed candidate becomes ordinary text. Parsing resumes after the failed","+marker, so later valid links, emphasis, and code spans remain recognizable.","+Reaching a nesting limit does not turn the remainder of the document into","+unparsed text.","+","+Links use an opening-bracket stack. Code spans and inline extensions use","+source-local indexes of closing delimiters; they do not retain parse-failure","+caches across nested sources or documents. Inline HTML terminators use the","+same scanner, so repeated unclosed comments do not repeatedly scan the","+remaining document.","+"," Extension performance"," ---------------------"," "],"additions":38,"deletions":0,"truncated":false},{"path":"src/mistune/_inline/delimiters.py","lines":["@@ -0,0 +1,68 @@","+\"\"\"Indexes of closing delimiters for one inline source.","+","+Each delimiter family scans its source once. These are lexical positions, not","+memoized parse failures, and are never shared with copied or sliced sources.","+\"\"\"","+","+import re","+from bisect import bisect_left, bisect_right","+from typing import Dict, List, Optional, Tuple","+","+_BACKTICKS = re.compile(r\"`+\")","+","+","+class DelimiterScanner:","+    def __init__(self, src: str) -> None:","+        self.src = src","+        self._code: Optional[Dict[int, List[int]]] = None","+        self._ends: Dict[Tuple[str, bool], List[int]] = {}","+","+    def code_end(self, marker: str, pos: int) -> Optional[int]:","+        size = len(marker)","+        if self._code is None:","+            end = self.src.find(marker, pos)","+            if end >= 0 and (end == 0 or self.src[end - 1] != \"`\"):","+                after = end + size","+                if after == len(self.src) or self.src[after] != \"`\":","+                    return end","+            self._code = {}","+            for match in _BACKTICKS.finditer(self.src):","+                self._code.setdefault(match.end() - match.start(), []).append(match.start())","+        positions = self._code.get(size, [])","+        index = bisect_left(positions, pos)","+        return positions[index] if index < len(positions) else None","+","+    def find(self, marker: str, pos: int, *, formatting: bool = False) -> Optional[int]:","+        key = (marker, formatting)","+        positions = self._ends.get(key)","+        if positions is None:","+            positions = []","+            start = self.src.find(marker)","+            while start >= 0:","+                if not formatting or _formatting_closer(self.src, start, marker):","+                    positions.append(start)","+                start = self.src.find(marker, start + 1)","+            self._ends[key] = positions","+        index = bisect_right(positions, pos) if formatting else bisect_left(positions, pos)","+        return positions[index] if index < len(positions) else None","+","+","+def _formatting_closer(src: str, start: int, marker: str) -> bool:","+    char = marker[0]","+    end = start + len(marker)","+    if end < len(src) and src[end] == char and not src.startswith(marker, end):","+        return False","+    if not start:","+        return False","+    previous = src[start - 1]","+    if previous !