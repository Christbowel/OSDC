sting)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\trel, err := filepath.Rel(existing, path)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\treturn filepath.Join(existingResolved, rel), nil","+}","+","+func requireWithin(root, candidate string) error {","+\trel, err := filepath.Rel(root, candidate)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"compare path to root: %w\", err)","+\t}","+\tif rel == \"..\" || filepath.IsAbs(rel) || strings.HasPrefix(rel, \"..\"+string(filepath.Separator)) {","+\t\treturn fmt.Errorf(\"path escapes allowed root\")","+\t}","+\treturn nil","+}"],"additions":145,"deletions":0,"truncated":false},{"path":"internal/safepath/path_test.go","lines":["@@ -0,0 +1,52 @@","+package safepath","+","+import (","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+)","+","+func TestResolveRejectsTraversalAndPlatformAlternatePaths(t *testing.T) {","+\troot := t.TempDir()","+\tfor _, path := range []string{","+\t\t\"../outside\",","+\t\t`..\\outside`,","+\t\tfilepath.Join(filepath.Dir(root), \"outside\"),","+\t\t`C:\\outside`,","+\t\t`\\\\server\\share\\outside`,","+\t\t`\\\\?\\C:\\outside`,","+\t} {","+\t\tif got, err := Resolve(root, path); err == nil {","+\t\t\tt.Errorf(\"Resolve(%q) = %q, want error\", path, got)","+\t\t}","+\t}","+}","+","+func TestResolveAllowsContainedPathAndRejectsSymlinkEscape(t *testing.T) {","+\troot := t.TempDir()","+\tinside, err := Resolve(root, \"guides/setup.md\")","+\tif err != nil || inside != filepath.Join(root, \"guides\", \"setup.md\") {","+\t\tt.Fatalf(\"contained path = %q, err=%v\", inside, err)","+\t}","+","+\toutside := t.TempDir()","+\tlink := filepath.Join(root, \"linked\")","+\tif err := os.Symlink(outside, link); err != nil {","+\t\tt.Skipf(\"symlinks unavailable: %v\", err)","+\t}","+\tif got, err := Resolve(root, \"linked/escape.md\"); err == nil {","+\t\tt.Fatalf(\"symlink escape resolved to %q\", got)","+\t}","+}","+","+func TestResolveProjectAllowsOnlyContainedAbsolutePath(t *testi