{"id":"beb91e69459b77f65be2c5e2ddad91ec8a76be09","axis":"silent","repo":"matomo-org/matomo","sha":"beb91e69459b77f65be2c5e2ddad91ec8a76be09","parsed":{"files":[{"path":"core/API/DataTableGenericFilter.php","lines":["@@ -236,10 +236,17 @@ protected function applyGenericFilters($datatable)","                 }","             }"," ","-            if (!$exceptionRaised) {","+            if ($exceptionRaised) {","+                continue;","+            }","+","+            $searchFilter = $this->getReportSearchFilter($filterName, $filterParameters);","+            if (null !== $searchFilter) {","+                $datatable->filter($searchFilter);","+            } else {","                 $datatable->filter($filterName, $filterParameters);","-                $filterApplied = true;","             }","+            $filterApplied = true;","         }"," ","         if (!$rowLimitingFiltersReached) {","@@ -249,6 +256,26 @@ protected function applyGenericFilters($datatable)","         return $filterApplied;","     }"," ","+    /**","+     * Returns the report's own filter for a label search, see {@link Report::getSearchFilter()}.","+     *","+     * @param string $filterName","+     * @param array $filterParameters","+     */","+    private function getReportSearchFilter($filterName, $filterParameters): ?callable","+    {","+        if (","+            null === $this->report","+            || !in_array($filterName, ['Pattern', 'PatternRecursive'], true)","+            || $filterParameters[0] !== 'label'","+            || $filterParameters[1] === ''","+        ) {","+            return null;","+        }","+","+        return $this->report->getSearchFilter($filterParameters[1]);","+    }","+","     private function invokeCallbackBeforeRowLimitingFilters(DataTable $datatable): void","     {","         if (null !== $this->callbackBeforeRowLimitingFilters) {"],"additions":29,"deletions":2,"truncated":false},{"path":"core/Plugin/Report.php","lines":["@@ -763,6 +763,24 @@ public function getSecondarySortColumnCallback()","         return null;","     }"," ","+    /**","+     * Returns a filter to search the report's rows with, in place of matching the pattern against","+     * each row's label, or `null` to keep matching the label.","+     *","+     * Lets a report recognise a search the label alone cannot answer, such as a full URL pasted","+     * into a report whose labels hold only the path. The filter is applied to every table of the","+     * response, and has to keep a row whose subtable still holds a match.","+     *","+     * @param string $pattern The search as {@link Common::getRequestVar()} returns it, sanitized","+     *                        like the pattern the label filter receives.","+     * @return callable|null A filter taking the DataTable to search.","+     * @ignore","+     */","+    public function getSearchFilter(string $pattern): ?callable","+    {","+        return null;","+    }","+","     /**","      * Get the list of related reports if there are any. They will be displayed for instance below a report as a","      * recommended related report."],"additions":18,"deletions":0,"truncated":false},{"path":"core/Tracker/PageUrl.php","lines":["@@ -31,6 +31,28 @@ class PageUrl","         'https://'     => 2,","     );"," ","+    /**","+     * Returns the site's main URL and aliases, asked for once per request.","+     *","+     * @param int $idSite","+     * @return list<string>","+     * @internal","+     */","+    public static function getSiteUrls($idSite): array","+    {","+        $cache = Cache::getTransientCache();","+        $cacheKeySiteUrls = CacheId::siteAware('siteurls', [$idSite]);","+","+        $siteUrls = $cache->fetch($cacheKeySiteUrls);","+","+        if (empty($siteUrls)) {","+            $siteUrls = APISitesManager::getInstance()->getSiteUrlsFromId($idSite);","+            $cache->save($cacheKeySiteUrls, $siteUrls);","+        }","+","+        return $siteUrls;","+    }","+","     /**","      * Given the Input URL, will exclude all query parameters set for this site","      *","@@ -357,20 +379,12 @@ public static function shouldUseHttpsHost($idSite, $host)","     {","         $cache = Cache::getTransientCache();"," ","-        $cacheKeySiteUrls = CacheId::siteAware('siteurls', [$idSite]);","         $cacheKeyHttpsForHost = CacheId::siteAware(sprintf('shouldusehttps-%s', $host), [$idSite]);"," ","-        $siteUrlCache = $cache->fetch($cacheKeySiteUrls);","-","-        if (empty($siteUrlCache)) {","-            $siteUrlCache = APISitesManager::getInstance()->getSiteUrlsFromId($idSite);","-            $cache->save($cacheKeySiteUrls, $siteUrlCache);","-        }","-","         if (!$cache->contains($cacheKeyHttpsForHost)) {","             $hostSiteCache = false;"," ","-            foreach ($siteUrlCache as $siteUrl) {","+            foreach (self::getSiteUrls($idSite) as $siteUrl) {","                 if (str_starts_with(mb_strtolower($siteUrl), mb_strtolower('https://' . $host))) {","                     $hostSiteCache = true;","                     break;"],"additions":23,"deletions":9,"truncated":false},{"path":"plugins/Actions/DataTable/Filter/PageUrlSearch.php","lines":["@@ -0,0 +1,189 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Actions\\DataTable\\Filter;","+","+use Piwik\\Config;","+use Piwik\\DataTable;","+use Piwik\\DataTable\\BaseFilter;","+use Piwik\\Site;","+use Piwik\\Tracker\\PageUrl;","+","+/**","+ * Searches a page URL report for a full URL, as copied from the browser, rather than for a pattern","+ * in the labels, which hold only the path.","+ *","+ * A row matches when its `url` metadata has the searched path and query, ignoring case like the","+ * search of the labels, the scheme and a leading `www.` being ignored. Its host is not compared: a row gathers every host the path was viewed on","+ * and keeps only the URL viewed the most, so the host it holds may be an alias, or a host the","+ * site's URLs do not list. The searched URL has to be on one of the site's URLs, or on the host","+ * the row holds.","+ *","+ * Like the archiver, a path ending with `/` is compared with `action_default_name` appended: `/docs/`","+ * and `/docs/index` are a single row, which holds only one of the two URLs.","+ *","+ * The URL is searched both without the parameters the site excludes today, and as pasted: a row","+ * holds its URL as tracked, before a parameter was excluded.","+ *","+ * Folders have no URL of their own: they are kept when one of the pages they hold matches.","+ */","+class PageUrlSearch extends BaseFilter","+{","+    /**","+     * @var string","+     */","+    private $searchedUrl;","+","+    /**","+     * @var string","+     */","+    private $defaultActionName = '';","+","+    /**","+     * @param DataTable $table","+     * @param string $searchedUrl A full URL, see {@link isFullUrl()}, sanitized as the request holds it.","+     */","+    public function __construct($table, string $searchedUrl)","+    {","+        parent::__construct($table);","+        $this->searchedUrl = $searchedUrl;","+    }","+","+    public static function isFullUrl(string $search): bool","+    {","+        return preg_match('~^https?://[^/?#\\s]+~i', trim($search)) === 1;","+    }","+","+    /**","+     * @param DataTable $table","+     */","+    public function filter($table)","+    {","+        $site = $table->getMetadata('site');","+        if (!$site instanceof Site) {","+            // without its site, the URL cannot be normalized like the tracker did: search the labels instead","+            $table->filter('PatternRecursive', ['label', $this->searchedUrl]);","+            return;","+        }","+","+        $this->defaultActionName = (string) Config::getInstance()->General['action_default_name'];","+","+        $idSite = $site->getId();","+        $urls = [PageUrl::cleanupUrl($this->searchedUrl)];","+        try {","+            $urls[] = (string) PageUrl::excludeQueryParametersFromUrl(trim($this->searchedUrl), $idSite);","+        } catch (\\Exception $e) {","+            // for example when the site's tracker cache fails to build: the URL is searched as pasted only","+        }","+","+        $siteHosts = $this->getSiteHosts($idSite);","+        $searchedUrls = [];","+        foreach (array_unique($urls) as $url) {","+            $searched = $this->splitUrl($url);","+            if (null !== $searched) {","+                $searched['isOnSiteHost'] = in_array($searched['host'], $siteHosts, true);","+                $searchedUrls[] = $searched;","+            }","+        }","+","+        $this->deleteRowsNotMatching($table, $searchedUrls);","+    }","+","+    /**","+     * @param list<array{host: string, path: string, isOnSiteHost: bool}> $searchedUrls","+     * @return int The number of rows left.","+     */","+    private function deleteRowsNotMatching(DataTable $table, array $searchedUrls): int","+    {","+        foreach ($table->getRows() as $key => $row) {","+            $subtable = $row->getSubtable();","+            if ($subtable && $this->deleteRowsNotMatching($subtable, $searchedUrls) > 0) {","+                continue;","+            }","+","+            $url = $row->getMetadata('url');","+            $rowUrl = is_string($url) ? $this->splitUrl($url) : null;","+","+            if (null === $rowUrl || !$this->isMatchingAny($rowUrl, $searchedUrls)) {","+                $table->deleteRow($key);","+            }","+        }","+","+        return $table->getRowsCount();","+    }","+","+    /**","+     * @param array{host: string, path: string} $rowUrl","+     * @param list<array{host: string, path: string, isOnSiteHost: bool}> $searchedUrls","+     */","+    private function isMatchingAny(array $rowUrl, array $searchedUrls): bool","+    {","+        foreach ($searchedUrls as $searched) {","+            // the path and query are compared as tracked, neither decoded nor reordered: `/café` does","+            // not find a page tracked as `/caf%C3%A9`, nor `?b=2&a=1` one tracked as `?a=1&b=2`","+            if (","+                $rowUrl['path'] === $searched['path']","+                && ($searched['isOnSiteHost'] || $rowUrl['host'] === $searched['host'])","+            ) {","+                return true;","+            }","+        }","+","+        return false;","+    }","+","+    /**","+     * @return array{host: string, path: string}|null The host, without `www.`, and everything after","+     *                                                it, `/` for nothing, with `action_default_name`","+     *                                                after a trailing `/`, both lower-cased.","+     */","+    private function splitUrl(string $url): ?array","+    {","+        $withoutPrefix = PageUrl::normalizeUrl($url);","+        if (null === $withoutPrefix['prefixId']) {","+            return null;","+        }","+","+        $parts = preg_split('~(?=[/?#])~', $withoutPrefix['url'], 2);","+        $host = mb_strtolower($parts[0]);","+        $path = $parts[1] ?? '';","+","+        if ($host === '') {","+            return null;","+        }","+","+        if ($path === '' || $path[0] !== '/') {","+            $path = '/' . $path;","+        }","+","+        // like ArchivingHelper::parseNameFromPageUrl(), which looks before the fragment, query included","+        $fragmentStart = strcspn($path, '#');","+        if ($path[$fragmentStart - 1] === '/') {","+            $path = substr_replace($path, $this->defaultActionName, $fragmentStart, 0);","+        }","+","+        return ['host' => $host, 'path' => mb_strtolower($path)];","+    }","+","+    /**","+     * @return list<string> The hosts of the site's main URL and aliases, as {@link splitUrl()} returns them.","+     */","+    private function getSiteHosts(int $idSite): array","+    {","+        $hosts = [];","+        foreach (PageUrl::getSiteUrls($idSite) as $siteUrl) {","+            $split = $this->splitUrl($siteUrl);","+            if (null !== $split) {","+                $hosts[] = $split['host'];","+            }","+        }","+","+        return array_values(array_unique($hosts));","+    }","+}"],"additions":189,"deletions":0,"truncated":false},{"path":"plugins/Actions/Reports/Base.php","lines":["@@ -11,6 +11,7 @@"," "," use Piwik\\Common;"," use Piwik\\Config\\GeneralConfig;","+use Piwik\\DataTable;"," use Piwik\\Metrics;"," use Piwik\\Metrics\\Formatter;"," use Piwik\\Piwik;","@@ -22,6 +23,7 @@"," use Piwik\\Plugins\\Actions\\Columns\\ExitPageUrl;"," use Piwik\\Plugins\\Actions\\Columns\\PageTitle;"," use Piwik\\Plugins\\Actions\\Columns\\PageUrl;","+use Piwik\\Plugins\\Actions\\DataTable\\Filter\\PageUrlSearch;"," use Piwik\\Plugins\\CoreVisualizations\\Visualizations\\HtmlTable;"," use Piwik\\API\\Request;"," ","@@ -146,14 +148,35 @@ public function getRecursiveLabelSeparator()","             return GeneralConfig::getConfigValue('action_title_category_delimiter') ?: $this->recursiveLabelSeparator;","         }"," ","-        if (","-            $this->dimension instanceof PageUrl","-            || $this->dimension instanceof EntryPageUrl","-            || $this->dimension instanceof ExitPageUrl","-        ) {","+        if ($this->isPageUrlReport()) {","             return GeneralConfig::getConfigValue('action_url_category_delimiter') ?: $this->recursiveLabelSeparator;","         }"," ","         return parent::getRecursiveLabelSeparator();","     }","+","+    /**","+     * Searches a page URL report for a full URL pasted into it, which its labels, holding only","+     * the path, never match.","+     */","+    public function getSearchFilter(string $pattern): ?callable","+    {","+        if (","+            !$this->isPageUrlReport()","+            || !PageUrlSearch::isFullUrl($pattern)","+        ) {","+            return null;","+        }","+","+        return function (DataTable $table) use ($pattern) {","+            $table->filter(PageUrlSearch::class, [$pattern]);","+        };","+    }","+","+    private function isPageUrlReport(): bool","+    {","+        return $this->dimension instanceof PageUrl","+            || $this->dimension instanceof EntryPageUrl","+            || $this->dimension instanceof ExitPageUrl;","+    }"," }"],"additions":28,"deletions":5,"truncated":false},{"path":"plugins/Actions/tests/System/PageUrlSearchTest.php","lines":["@@ -0,0 +1,291 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Actions\\tests\\System;","+","+use Piwik\\API\\Request;","+use Piwik\\DataTable;","+use Piwik\\Piwik;","+use Piwik\\Tests\\Framework\\Fixture;","+use Piwik\\Tests\\Framework\\TestCase\\IntegrationTestCase;","+use Piwik\\Tracker\\Cache as TrackerCache;","+","+/**","+ * A full URL pasted into the search of a page URL report, which the labels, holding only the path,","+ * never match.","+ *","+ * @group Actions","+ * @group PageUrlSearchTest","+ */","+class PageUrlSearchTest extends IntegrationTestCase","+{","+    private const DATE = '2015-03-04';","+","+    /**","+     * @var int","+     */","+    private static $idSite;","+","+    /**","+     * Tracks once for the whole class: the tables are restored before each test.","+     */","+    protected static function beforeTableDataCached()","+    {","+        parent::beforeTableDataCached();","+","+        self::$idSite = Fixture::createWebsite(","+            self::DATE . ' 00:00:00',","+            $ecommerce = 0,","+            $siteName = false,","+            ['http://example.com', 'https://shop.example.org'],","+            $siteSearch = 1,","+            $searchKeywordParameters = null,","+            $searchCategoryParameters = null,","+            $timezone = null,","+            $type = null,","+            $excludeUnknownUrls = 0,","+            $excludedParameters = 'sessionid'","+        );","+","+        self::trackPageViews([","+            'http://example.com/products/item?id=123',","+            'http://example.com/products/item?id=124',","+            // the same last part of the path, under another folder","+            'http://example.com/blog/item?id=123',","+            'https://shop.example.org/cart/view',","+            'http://example.com/account/login?sessionid=abc',","+            // a host the site's URLs do not list","+            'http://preview.example.com/pricing',","+            'http://example.com:8080/staging/page',","+            // a single row, holding the URL tracked the most","+            'http://example.com/docs/',","+            'http://example.com/docs/',","+            'http://example.com/docs/index',","+            // tracked as `/thing?id=5`","+            'http://example.com/thing;id=5',","+        ]);","+    }","+","+    /**","+     * @dataProvider getSearches","+     * @param list<string> $expectedPages","+     */","+    public function testFindsThePageAFullUrlWasTrackedAs(string $search, bool $flat, array $expectedPages)","+    {","+        $this->assertEquals($expectedPages, $this->searchPageUrls($search, $flat));","+    }","+","+    public function getSearches(): iterable","+    {","+        foreach ([false, true] as $flat) {","+            $view = $flat ? 'flat' : 'hierarchical';","+","+            yield \"a page on the site's main URL, $view\" => [","+                'https://example.com/products/item?id=123',","+                $flat,","+                ['/products/item?id=123'],","+            ];","+","+            yield \"the scheme and www. are ignored, $view\" => [","+                'http://www.example.com/products/item?id=123',","+                $flat,","+                ['/products/item?id=123'],","+            ];","+","+            yield \"a page on an alias of the site, $view\" => [","+                'https://shop.example.org/cart/view',","+                $flat,","+                ['/cart/view'],","+            ];","+","+            yield \"the main URL finds a page tracked on an alias, $view\" => [","+                'https://example.com/cart/view',","+                $flat,","+                ['/cart/view'],","+            ];","+","+            yield \"the main URL finds a page tracked on a host the site's URLs do not list, $view\" => [","+                'https://example.com/pricing',","+                $flat,","+                ['/pricing'],","+            ];","+","+            yield \"the URL a page holds, on a host the site's URLs do not list, $view\" => [","+                'http://preview.example.com/pricing',","+                $flat,","+                ['/pricing'],","+            ];","+","+            yield \"a host with a port, $view\" => [","+                'http://example.com:8080/staging/page',","+                $flat,","+                ['/staging/page'],","+            ];","+","+            yield \"an upper-case scheme and host, $view\" => [","+                'HTTPS://WWW.EXAMPLE.COM/products/item?id=123',","+                $flat,","+                ['/products/item?id=123'],","+            ];","+","+            yield \"a path and query in another case, $view\" => [","+                'https://example.com/Products/ITEM?Id=123',","+                $flat,","+                ['/products/item?id=123'],","+            ];","+","+            yield \"a host that is not one of the site's URLs, $view\" => [","+                'https://elsewhere.example.net/products/item?id=123',","+                $flat,","+                [],","+            ];","+","+            yield \"a parameter excluded from tracking is ignored, $view\" => [","+                'http://example.com/account/login?sessionid=xyz',","+                $flat,","+                ['/account/login'],","+            ];","+","+            yield \"the URL a page holds, ending with /, $view\" => [","+                'https://example.com/docs/',","+                $flat,","+                // the flat view labels the row by the URL it holds","+                [$flat ? '/docs/' : '/docs/index'],","+            ];","+","+            yield \"a URL sharing its row with a URL ending with /, $view\" => [","+                'https://example.com/docs/index',","+                $flat,","+                [$flat ? '/docs/' : '/docs/index'],","+            ];","+","+            yield \"a URL tracked for none of the pages, $view\" => [","+                'https://example.com/products/item?id=999',","+                $flat,","+                [],","+            ];","+        }","+    }","+","+    public function testKeepsSearchingLabelsForTextThatIsNotAFullUrl()","+    {","+        $this->assertEquals(","+            ['/blog/item?id=123', '/products/item?id=123', '/products/item?id=124'],","+            $this->searchPageUrls('item', true)","+        );","+    }","+","+    public function testFindsThePageInTheEntryAndExitPageReports()","+    {","+        foreach (['Actions.getEntryPageUrls', 'Actions.getExitPageUrls'] as $method) {","+            $this->assertEquals(","+                ['/cart/view'],","+                $this->searchPageUrls('https://shop.example.org/cart/view', true, $method),","+                $method","+            );","+        }","+    }","+","+    public function testFindsAPageTrackedWithAParameterTheSiteExcludesSinceThen()","+    {","+        Request::processRequest('SitesManager.updateSite', [","+            'idSite' => self::$idSite,","+            'excludedQueryParameters' => 'sessionid,id',","+        ]);","+","+        $this->assertEquals(","+            ['/products/item?id=123'],","+            $this->searchPageUrls('https://example.com/products/item?id=123', true)","+        );","+        $this->assertEquals(['/thing?id=5'], $this->searchPageUrls('https://example.com/thing;id=5', true));","+    }","+","+    public function testComparesTheSearchedUrlAsIsWhenItCannotBeNormalized()","+    {","+        // archive first, then make the site's tracker cache, which the normalization reads, fail to build","+        $this->searchPageUrls('item', true);","+        TrackerCache::deleteCacheWebsiteAttributes(self::$idSite);","+        $isNormalizationFailing = false;","+        Piwik::addAction('Tracker.Cache.getSiteAttributes', function () use (&$isNormalizationFailing) {","+            $isNormalizationFailing = true;","+            throw new \\Exception('The tracker cache cannot be built');","+        });","+","+        // without the normalization, the excluded parameter is kept: the page tracked without it is not found","+        $this->assertEquals([], $this->searchPageUrls('http://example.com/account/login?sessionid=xyz', true));","+        $this->assertTrue($isNormalizationFailing);","+","+        $this->assertEquals(","+            ['/products/item?id=123'],","+            $this->searchPageUrls('https://example.com/products/item?id=123', true)","+        );","+    }","+","+    /**","+     * @param list<string> $urls Each one tracked as its own visit.","+     */","+    private static function trackPageViews(array $urls): void","+    {","+        foreach ($urls as $index => $url) {","+            $tracker = Fixture::getTracker(self::$idSite, sprintf('%s %02d:00:00', self::DATE, $index), $defaultInit = true);","+            $tracker->setUrl($url);","+            Fixture::checkResponse($tracker->doTrackPageView('page ' . $index));","+        }","+    }","+","+    /**","+     * @return list<string> The path of each page the search finds, sorted.","+     */","+    private function searchPageUrls(string $search, bool $flat, string $method = 'Actions.getPageUrls'): array","+    {","+        /** @var DataTable $table */","+        $table = Request::processRequest($method, [","+            'idSite' => self::$idSite,","+            'period' => 'day',","+            'date' => self::DATE,","+            'flat' => $flat ? '1' : '0',","+            'expanded' => $flat ? '0' : '1',","+            'filter_column_recursive' => 'label',","+            'filter_pattern_recursive' => $search,","+            'filter_limit' => '-1',","+        ]);","+","+        $pages = $this->collectPagePaths($table, '');","+        sort($pages);","+","+        return $pages;","+    }","+","+    /**","+     * @return list<string>","+     */","+    private function collectPagePaths(DataTable $table, string $folder): array","+    {","+        $pages = [];","+        foreach ($table->getRows() as $row) {","+            $label = (string) $row->getColumn('label');","+            $subtable = $row->getSubtable();","+","+            if ($subtable) {","+                $pages = array_merge($pages, $this->collectPagePaths($subtable, $folder . '/' . $label));","+            } else {","+                // a page's label starts with `/` in both views, see ArchivingHelper::URL_ACTION_LEAF_MARKER","+                $pages[] = $folder . $label;","+            }","+        }","+","+        return $pages;","+    }","+","+    protected static function configureFixture($fixture)","+    {","+        parent::configureFixture($fixture);","+        $fixture->createSuperUser = true;","+    }","+}"],"additions":291,"deletions":0,"truncated":false},{"path":"plugins/Actions/tests/Unit/PageUrlSearchTest.php","lines":["@@ -0,0 +1,35 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+namespace Piwik\\Plugins\\Actions\\tests\\Unit;","+","+use Piwik\\DataTable;","+use Piwik\\DataTable\\Row;","+use Piwik\\Plugins\\Actions\\DataTable\\Filter\\PageUrlSearch;","+","+/**","+ * @group Actions","+ * @group PageUrlSearchTest","+ * @group Plugins","+ */","+class PageUrlSearchTest extends \\PHPUnit\\Framework\\TestCase","+{","+    public function testSearchesTheLabelsOfATableWithoutItsSite()","+    {","+        $table = new DataTable();","+        $table->addRowsFromArray([","+            [Row::COLUMNS => ['label' => 'https://example.com/pricing', 'nb_visits' => 1]],","+            [Row::COLUMNS => ['label' => '/pricing', 'nb_visits' => 1]],","+        ]);","+","+        $table->filter(PageUrlSearch::class, ['https://example.com/pricing']);","+","+        $this->assertEquals(['https://example.com/pricing'], $table->getColumn('label'));","+    }","+}",""],"additions":35,"deletions":0,"truncated":false}],"additions":613,"deletions":16,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-04T16:06:20.121809+00:00"}