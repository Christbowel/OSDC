al cursor-open behavior.","+     * This caller only borrows the cursor, so restore the caller's dhandle rather than retaining a","+     * pointer without a reference.","+     */","+    WT_WITHOUT_DHANDLE(","+      session, ret = __wt_cursor_cache_get(session, uri, hash_value, NULL, NULL, &cursor));","+    if (ret == 0) {","         *hs_btreep = CUR2BT(cursor);","         /*","          * The pattern of acquiring a cursor, obtaining its dhandle, and then closing the cursor is","          * generally unsafe and can lead to undefined behavior. This is because the sweep server","          * checks for references to dhandles, and closing the cursor may result in the dhandle being","-         * swept while still in use. However, history store dhandles are an exception as they are","-         * not subject to sweeping.","+         * swept while still in use. The local history store dhandle is never swept, and the shared","+         * history store dhandle is only swept after a step-down marks it outdated. Even then this","+         * caller is safe: it reads the btree under the eviction pass lock, and sweep must close the","+         * btree before freeing it, which waits for that lock.","          */","         WT_RET(cursor->close(cursor));","     }"],"additions":15,"deletions":3,"truncated":false},{"path":"src/third_party/wiredtiger/src/cursor/cur_stat.c","lines":["@@ -16,6 +16,10 @@"," #define WT_STAT_KEY_MIN(cst) ((cst)->stats_base)"," #define WT_STAT_KEY_OFFSET(cst) ((cst)->key - (cst)->stats_base)"," ","+#define WT_STAT_OTEL_SUBSET_FLAGS \\","+    (WT_STAT_OTEL_COUNTERS | WT_STAT_OTEL_GAUGES | WT_STAT_OTEL_HISTOGRAMS | WT_STAT_OTEL_NONE)","+#define WT_STAT_OTEL_SUBSET(cst) F_ISSET(cst, WT_STAT_OTEL_SUBSET_FLAGS)","+"," /*","  * __curstat_print_value --","  *     Convert statistics cursor value to printable format.","@@ -182,6 +186,80 @@ __curstat_set_value(WT_CURSOR *cursor, ...)","     WT_UNUSED(cursor);"," }"," ","+/*","+ * __curstat_otel_next --","+ *     Move to