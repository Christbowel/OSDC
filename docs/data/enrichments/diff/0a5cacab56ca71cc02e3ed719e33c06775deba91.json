{"id":"0a5cacab56ca71cc02e3ed719e33c06775deba91","axis":"silent","repo":"salvo-rs/salvo","sha":"0a5cacab56ca71cc02e3ed719e33c06775deba91","parsed":{"files":[{"path":"crates/csrf/README.md","lines":["@@ -49,6 +49,46 @@ salvo = { version = \"*\", features = [\"csrf\"] }"," "," [![Docs](https://img.shields.io/docsrs/salvo-csrf.svg)](https://docs.rs/salvo-csrf)"," ","+## Choosing token storage","+","+For browser-facing HTTPS services, prefer `CookieStore::host_prefixed()` over","+the compatibility default `CookieStore::new()`:","+","+```rust,ignore","+use salvo::csrf::{BcryptCipher, CookieStore, Csrf, FormFinder};","+let csrf = Csrf::new(","+    BcryptCipher::new(),","+    CookieStore::host_prefixed(),","+    FormFinder::new(\"csrf\"),","+);","+```","+","+The resulting `__Host-salvo.csrf` cookie has `Secure`, `HttpOnly`, `Path=/`,","+and no `Domain`. Browsers reject attempts by sibling subdomains to set a","+parent-domain cookie with that name. The server rejects invalid prefix","+configurations, including later builder or public-field changes. The public","+origin must use HTTPS; the constructor also works behind a trusted TLS-terminating","+proxy because `Secure` is explicit rather than inferred from the internal hop.","+","+The compatibility default is a double-submit cookie **without authentication","+session binding**. `SameSite=Strict` does not separate untrusted sibling subdomains.","+If an attacker can inject a known valid CSRF cookie and the application accepts","+form submissions without another origin check, that pair can be replayed with","+the victim's independent login cookie. Using a global HMAC key alone does not","+bind the pair to that login session. A custom-header finder also depends on the","+application's CORS and origin policy; do not grant credentialed access to untrusted","+origins.","+","+When the application already uses server-side sessions, enable `session-store`","+and use `SessionStore`, with `SessionHandler` before `Csrf`. The proof then belongs","+to that session; copying another session's token or CSRF cookie is insufficient.","+Secure the authentication session cookie as well, and rotate/reissue session","+state at the appropriate authentication boundary. Host-prefixed cookies prevent","+cookie injection, but do not protect against same-origin script execution or","+replace application authorization.","+","+See the [OWASP CSRF prevention guidance](https://cheatsheetseries.owasp.org/cheatsheets/Cross-Site_Request_Forgery_Prevention_Cheat_Sheet.html#signed-double-submit-cookie-recommended).","+"," ## ☕ Donate"," "," Salvo is an open source project. If you want to support Salvo, you can ☕ [**buy me a coffee here**](https://ko-fi.com/chrislearn)."],"additions":40,"deletions":0,"truncated":false},{"path":"crates/csrf/src/cookie_store.rs","lines":["@@ -3,11 +3,15 @@ use cookie::{Cookie, Expiration, SameSite};"," use salvo_core::http::SecureCookiePolicy;"," use salvo_core::{Depot, Error, Request, Response};"," ","-use crate::CsrfCipher;","-"," use super::CsrfStore;","+use crate::CsrfCipher;"," "," /// A `CsrfStore` implementation that stores the CSRF proof in a cookie.","+///","+/// This is a double-submit cookie, not a token bound to an authentication session.","+/// Use [`Self::host_prefixed`] on HTTPS deployments to prevent sibling subdomains","+/// from injecting a parent-domain CSRF cookie, or use `SessionStore`","+/// when the token must be bound to a server-side session."," #[derive(Debug)]"," #[non_exhaustive]"," pub struct CookieStore {","@@ -32,6 +36,23 @@ impl Default for CookieStore {"," }"," "," impl CookieStore {","+    /// Creates a host-only CSRF cookie for HTTPS deployments.","+    ///","+    /// The browser enforces the `__Host-` prefix: `Secure`, `Path=/`, and no","+    /// `Domain`. Invalid combinations (including public-field changes) are","+    /// rejected on save and ignored on load. TLS-terminating proxies may use","+    /// this constructor because it always emits `Secure` independently of the","+    /// internal connection scheme. The browser-facing origin must use HTTPS.","+    ///","+    /// This prevents parent-domain cookie injection; it does not bind tokens to","+    /// a login session. Renaming the cookie without the prefix opts out of the","+    /// browser's host-prefix protection. Loads match the original request Cookie","+    /// name exactly, ignoring percent-encoded aliases and cookie-jar overrides.","+    #[must_use]","+    pub fn host_prefixed() -> Self {","+        Self::new().name(\"__Host-salvo.csrf\").secure(true)","+    }","+","     /// Create a new `CookieStore`.","     #[must_use]","     pub fn new() -> Self {","@@ -92,6 +113,24 @@ impl CookieStore {","         self.secure_cookie_policy = policy;","         self","     }","+","+    fn cookie_is_secure(&self, req: &Request) -> bool {","+        self.secure","+            .map(SecureCookiePolicy::from_bool)","+            .unwrap_or(self.secure_cookie_policy)","+            .is_secure(req)","+    }","+","+    fn validate_prefix(&self, secure: bool) -> Result<(), Error> {","+        if self.name.starts_with(\"__Host-\")","+            && (!secure || self.path != \"/\" || self.domain.is_some())","+        {","+            return Err(Error::other(","+                \"__Host- CSRF cookies require Secure, Path=/, and no Domain\",","+            ));","+        }","+        Ok(())","+    }"," }"," impl CsrfStore for CookieStore {","     type Error = Error;","@@ -101,15 +140,36 @@ impl CsrfStore for CookieStore {","         _depot: &mut Depot,","         cipher: &C,","     ) -> Option<(String, String)> {","-        req.cookie(&self.name)","-            .and_then(|c| c.value().split_once('.'))","-            .and_then(|(token, proof)| {","-                if cipher.verify(token, proof) {","-                    Some((token.into(), proof.into()))","-                } else {","-                    None","-                }","-            })","+        self.validate_prefix(self.cookie_is_secure(req)).ok()?;","+        let parsed;","+        let cookie = if self.name.starts_with(\"__Host-\") {","+            // The general cookie jar decodes percent escapes in names. Browsers","+            // enforce prefixes on the original name, so an encoded alias must","+            // never replace a genuinely prefixed cookie in this store.","+            let mut exact = req","+                .headers()","+                .get_all(salvo_core::http::header::COOKIE)","+                .iter()","+                .filter_map(|header| header.to_str().ok())","+                .flat_map(|header| header.split(';'))","+                .map(str::trim)","+                .filter(|raw| {","+                    raw.split_once('=')","+                        .is_some_and(|(name, _)| name.trim() == self.name)","+                });","+            let raw = exact.next()?;","+            if exact.next().is_some() {","+                return None;","+            }","+            parsed = Cookie::parse_encoded(raw).ok()?;","+            &parsed","+        } else {","+            req.cookie(&self.name)?","+        };","+        let (token, proof) = cookie.value().split_once('.')?;","+        cipher","+            .verify(token, proof)","+            .then(|| (token.into(), proof.into()))","     }","     async fn save(","         &self,","@@ -119,11 +179,8 @@ impl CsrfStore for CookieStore {","         token: &str,","         proof: &str,","     ) -> Result<(), Self::Error> {","-        let secure = self","-            .secure","-            .map(SecureCookiePolicy::from_bool)","-            .unwrap_or(self.secure_cookie_policy)","-            .is_secure(req);","+        let secure = self.cookie_is_secure(req);","+        self.validate_prefix(secure)?;","         let expires = cookie::time::OffsetDateTime::now_utc() + self.ttl;","         let cookie_builder = Cookie::build((self.name.clone(), format!(\"{token}.{proof}\")))","             .http_only(true)","@@ -143,9 +200,107 @@ impl CsrfStore for CookieStore {"," "," #[cfg(test)]"," mod tests {","+    use salvo_core::test::TestClient;","+","     use super::*;","     use crate::bcrypt_cipher::BcryptCipher;","-    use salvo_core::test::TestClient;","+","+    #[tokio::test]","+    async fn host_prefixed_cookie_has_browser_enforced_scope() {","+        let store = CookieStore::host_prefixed();","+        let mut req = TestClient::get(\"http://internal-proxy/\").build();","+        let mut res = Response::new();","+        store","+            .save(&mut req, &mut Depot::new(), &mut res, \"token\", \"proof\")","+            .await","+            .unwrap();","+        let cookie = res.cookies().get(\"__Host-salvo.csrf\").unwrap();","+        assert_eq!(cookie.secure(), Some(true));","+        assert_eq!(cookie.path(), Some(\"/\"));","+        assert_eq!(cookie.domain(), None);","+        assert_eq!(cookie.http_only(), Some(true));","+    }","+","+    #[tokio::test]","+    async fn host_prefix_uses_original_cookie_names_not_decoded_jar_aliases() {","+        let store = CookieStore::host_prefixed();","+        let cipher = BcryptCipher::new().cost(4);","+        let (victim, victim_proof) = cipher.generate();","+        let (attacker, attacker_proof) = cipher.generate();","+        let genuine = format!(\"__Host-salvo.csrf={victim}.{victim_proof}\");","+        for name in [","+            \"%5F_Host-salvo.csrf\",","+            \"__Host-salvo%2Ecsrf\",","+            \"__%48ost-salvo.csrf\",","+        ] {","+            let alias = format!(\"{name}={attacker}.{attacker_proof}\");","+            let mut req = TestClient::get(\"https://app.example.com/\")","+                .add_header(\"cookie\", &genuine, true)","+                .add_header(\"cookie\", &alias, false)","+                .build();","+            // Exercise the actual Request parser: the alias shadows the genuine","+            // cookie in its decoded jar, but must not affect prefixed-store load.","+            assert_eq!(","+                req.cookie(&store.name).unwrap().value(),","+                format!(\"{attacker}.{attacker_proof}\")","+            );","+            assert_eq!(","+                store.load(&mut req, &mut Depot::new(), &cipher).await,","+                Some((victim.clone(), victim_proof.clone()))","+            );","+            let mut req = TestClient::get(\"https://app.example.com/\")","+                .add_header(\"cookie\", &alias, true)","+                .build();","+            assert!(","+                store","+                    .load(&mut req, &mut Depot::new(), &cipher)","+                    .await","+                    .is_none()","+            );","+            let mut req = TestClient::get(\"https://app.example.com/\")","+                .add_header(\"cookie\", format!(\"{alias}; {genuine}\"), true)","+                .build();","+            assert_eq!(","+                store.load(&mut req, &mut Depot::new(), &cipher).await,","+                Some((victim.clone(), victim_proof.clone()))","+            );","+        }","+        let mut req = TestClient::get(\"https://app.example.com/\")","+            .add_header(\"cookie\", format!(\"{genuine}; {genuine}\"), true)","+            .build();","+        assert!(","+            store","+                .load(&mut req, &mut Depot::new(), &cipher)","+                .await","+                .is_none()","+        );","+    }","+","+    #[tokio::test]","+    async fn invalid_host_prefix_configuration_fails_closed() {","+        let cipher = BcryptCipher::new().cost(4);","+        let (token, proof) = cipher.generate();","+        for store in [","+            CookieStore::host_prefixed().domain(\"example.com\"),","+            CookieStore::host_prefixed().path(\"/nested\"),","+            CookieStore::host_prefixed().secure(false),","+            CookieStore::host_prefixed().secure_cookie_policy(SecureCookiePolicy::Never),","+        ] {","+            let mut req = TestClient::get(\"https://example.com/\").build();","+            req.cookies_mut()","+                .add(Cookie::new(\"__Host-salvo.csrf\", format!(\"{token}.{proof}\")));","+            let mut depot = Depot::new();","+            let mut res = Response::new();","+            assert!(store.load(&mut req, &mut depot, &cipher).await.is_none());","+            assert!(","+                store","+                    .save(&mut req, &mut depot, &mut res, &token, &proof)","+                    .await","+                    .is_err()","+            );","+            assert!(res.cookies().get(\"__Host-salvo.csrf\").is_none());","+        }","+    }"," ","     #[tokio::test]","     async fn test_cookie_store() {","@@ -162,7 +317,10 @@ mod tests {","         assert_eq!(cookie_store.path, \"/test\");","         assert_eq!(cookie_store.domain.as_deref(), Some(\"example.com\"));","         assert_eq!(cookie_store.secure, Some(true));","-        assert_eq!(cookie_store.secure_cookie_policy, SecureCookiePolicy::Always);","+        assert_eq!(","+            cookie_store.secure_cookie_policy,","+            SecureCookiePolicy::Always","+        );"," ","         let mut req = TestClient::get(\"http://example.com/test\").build();","         let mut depot = Depot::new();"],"additions":176,"deletions":18,"truncated":false},{"path":"crates/csrf/src/session_store.rs","lines":["@@ -12,6 +12,45 @@ use super::{CsrfCipher, CsrfStore};"," pub struct SessionStore {","     name: String,"," }","+","+#[cfg(all(test, feature = \"bcrypt-cipher\"))]","+mod tests {","+    use salvo_core::http::cookie::Cookie;","+    use salvo_core::test::TestClient;","+    use salvo_session::Session;","+","+    use super::*;","+    use crate::{BcryptCipher, CsrfCipher};","+","+    #[tokio::test]","+    async fn another_sessions_pair_cannot_be_injected_through_a_cookie() {","+        let cipher = BcryptCipher::new().cost(4);","+        let store = SessionStore::new();","+        let mut attacker = Depot::new();","+        attacker.set_session(Session::new());","+        let mut victim = Depot::new();","+        victim.set_session(Session::new());","+        let (token, proof) = cipher.generate();","+        let mut req = TestClient::get(\"https://app.example.test/\").build();","+        store","+            .save(","+                &mut req,","+                &mut attacker,","+                &mut Response::new(),","+                &token,","+                &proof,","+            )","+            .await","+            .unwrap();","+        req.cookies_mut()","+            .add(Cookie::new(\"salvo.csrf\", format!(\"{token}.{proof}\")));","+        assert_eq!(","+            store.load(&mut req, &mut attacker, &cipher).await,","+            Some((token, proof))","+        );","+        assert!(store.load(&mut req, &mut victim, &cipher).await.is_none());","+    }","+}"," impl Default for SessionStore {","     fn default() -> Self {","         Self::new()","@@ -30,7 +69,12 @@ impl SessionStore {"," "," impl CsrfStore for SessionStore {","     type Error = Error;","-    async fn load<C: CsrfCipher>(&self, _req: &mut Request, depot: &mut Depot, cipher: &C) -> Option<(String, String)> {","+    async fn load<C: CsrfCipher>(","+        &self,","+        _req: &mut Request,","+        depot: &mut Depot,","+        cipher: &C,","+    ) -> Option<(String, String)> {","         depot","             .session()","             .and_then(|s| s.get::<String>(&self.name))"],"additions":45,"deletions":1,"truncated":false},{"path":"crates/csrf/tests/browser/README.md","lines":["@@ -0,0 +1,27 @@","+# Browser cookie isolation regression","+","+```sh","+cd crates/csrf/tests/browser","+npm install","+npx playwright install chromium","+npm test","+```","+","+An already installed Chromium executable may instead be passed as","+`npm test -- /absolute/path/to/chrome`. All HTTPS requests for app/attacker","+subdomains of `csrf.test` are intercepted and fulfilled locally. The test","+uses real browser cookie storage and a same-site cross-origin form POST;","+it does not contact an external server or depend on DNS/hosts-file changes.","+","+Checks include a rejected parent-domain host-prefix injection, an accepted","+legacy-cookie injection control, a sibling's separate host-only cookie,","+invalid Path/Secure rejection, and the cookies sent by the forged form.","+This covers browser cookie scope; Rust tests separately verify the store's","+actual cookie attributes and server-side rejection of invalid configuration.","+","+The browser also accepts a sibling's percent-encoded `%5F_Host-salvo.csrf` parent-domain","+cookie as a distinct, unprefixed name and sends it alongside the genuine cookie. This is","+an injection control, not a browser prefix violation. The Rust Request-parser regression","+in `host_prefix_uses_original_cookie_names_not_decoded_jar_aliases` verifies that","+CookieStore selects the original exact name even when the general decoded cookie jar","+has been shadowed by this alias. Duplicate exact names fail closed."],"additions":27,"deletions":0,"truncated":false},{"path":"crates/csrf/tests/browser/host_prefix.js","lines":["@@ -0,0 +1,62 @@","+// Run this function with a Playwright Page in a fresh browser context.","+// All requests are fulfilled locally; the .test names never reach a real service.","+export default async function hostPrefix(page) {","+  const context = page.context();","+  await context.clearCookies();","+  let submitted;","+  await page.route(\"https://*.csrf.test/**\", async route => {","+    const url = new URL(route.request().url());","+    if (url.pathname === \"/start\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"__Host-salvo.csrf=victim; Secure; HttpOnly; SameSite=Strict; Path=/\"}, body: \"victim\"});","+    } else if (url.pathname === \"/inject\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"__Host-salvo.csrf=attacker; Secure; Domain=csrf.test; Path=/\"}, body: \"injection\"});","+    } else if (url.pathname === \"/encoded-alias\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"%5F_Host-salvo.csrf=encoded-attacker; Secure; SameSite=Strict; Domain=csrf.test; Path=/\"}, body: \"encoded alias\"});","+    } else if (url.pathname === \"/legacy\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"salvo.csrf=attacker; Secure; SameSite=Strict; Domain=csrf.test; Path=/action\"}, body: \"legacy\"});","+    } else if (url.pathname === \"/own\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"__Host-salvo.csrf=attacker-own; Secure; Path=/\"}, body: \"own\"});","+    } else if (url.pathname === \"/bad-path\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"__Host-invalid=bad; Secure; Path=/nested\"}, body: \"bad path\"});","+    } else if (url.pathname === \"/bad-secure\") {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\", \"set-cookie\":","+        \"__Host-insecure=bad; Path=/\"}, body: \"insecure\"});","+    } else if (url.pathname === \"/action\") {","+      submitted = {method: route.request().method(), headers: await route.request().allHeaders(), body: route.request().postData()};","+      await route.fulfill({status: 200, body: \"submitted\"});","+    } else {","+      await route.fulfill({status: 200, headers: {\"content-type\": \"text/html\"}, body: \"ready\"});","+    }","+  });","+  await page.goto(\"https://app.csrf.test/start\");","+  await page.goto(\"https://attacker.csrf.test/inject\");","+  await page.goto(\"https://attacker.csrf.test/encoded-alias\");","+  await page.goto(\"https://attacker.csrf.test/legacy\");","+  await page.goto(\"https://attacker.csrf.test/own\");","+  await page.goto(\"https://attacker.csrf.test/bad-path\");","+  await page.goto(\"https://attacker.csrf.test/bad-secure\");","+  const cookies = await context.cookies(\"https://app.csrf.test/action\");","+  const host = cookies.filter(c => c.name === \"__Host-salvo.csrf\");","+  if (host.length !== 1 || host[0].value !== \"victim\" || host[0].domain !== \"app.csrf.test\") throw Error(\"host cookie overwritten\");","+  if (!cookies.some(c => c.name === \"%5F_Host-salvo.csrf\" && c.value === \"encoded-attacker\")) throw Error(\"encoded alias control failed\");","+  if (!cookies.some(c => c.name === \"salvo.csrf\" && c.value === \"attacker\")) throw Error(\"legacy injection control failed\");","+  if ((await context.cookies()).some(c => c.name === \"__Host-invalid\" || c.name === \"__Host-insecure\")) throw Error(\"invalid prefix accepted\");","+  await page.evaluate(() => {","+    const form = document.createElement(\"form\");","+    form.method = \"POST\";","+    form.action = \"https://app.csrf.test/action\";","+    const token = document.createElement(\"input\");","+    token.name = \"csrf\"; token.value = \"attacker\"; form.append(token);","+    document.body.append(form); form.submit();","+  });","+  await page.waitForURL(\"https://app.csrf.test/action\");","+  const cookie = submitted.headers.cookie || \"\";","+  if (submitted.method !== \"POST\" || !cookie.includes(\"__Host-salvo.csrf=victim\") || !cookie.includes(\"salvo.csrf=attacker\") || !cookie.includes(\"%5F_Host-salvo.csrf=encoded-attacker\")) throw Error(\"same-site form control failed\");","+  return {encodedParentDomainAliasIsDistinct: true, hostCookiePreserved: true, parentDomainInjectionRejected: true, invalidAttributesRejected: true, legacyInjectionControl: true, sameSiteFormCarriesVictimHostCookie: true};","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"crates/csrf/tests/browser/package-lock.json","lines":["@@ -0,0 +1,42 @@","+{","+  \"name\": \"salvo-csrf-browser-regressions\",","+  \"lockfileVersion\": 3,","+  \"requires\": true,","+  \"packages\": {","+    \"\": {","+      \"name\": \"salvo-csrf-browser-regressions\",","+      \"devDependencies\": {","+        \"playwright\": \"1.65.0\"","+      }","+    },","+    \"node_modules/playwright\": {","+      \"version\": \"1.65.0\",","+      \"resolved\": \"https://registry.npmjs.org/playwright/-/playwright-1.65.0.tgz\",","+      \"integrity\": \"sha512-F3AMWcR44qMBt4kq+6Kb6mX7bjGXshktKFOPULd7reED6ZJWevjbNRqysP7q+AATE9kdPEZBibex1BYsvpVoeA==\",","+      \"dev\": true,","+      \"license\": \"Apache-2.0\",","+      \"dependencies\": {","+        \"playwright-core\": \"1.65.0\"","+      },","+      \"bin\": {","+        \"playwright\": \"cli.js\"","+      },","+      \"engines\": {","+        \"node\": \">=20\"","+      }","+    },","+    \"node_modules/playwright-core\": {","+      \"version\": \"1.65.0\",","+      \"resolved\": \"https://registry.npmjs.org/playwright-core/-/playwright-core-1.65.0.tgz\",","+      \"integrity\": \"sha512-vNSKgH6YqtN7cdT/L334zo0a+YwkrpicyrHJlWWPIm/Q+Nn2SWInil01oT0mbu96U4GgoRtCYQD9CzJQgju+lA==\",","+      \"dev\": true,","+      \"license\": \"Apache-2.0\",","+      \"bin\": {","+        \"playwright-core\": \"cli.js\"","+      },","+      \"engines\": {","+        \"node\": \">=20\"","+      }","+    }","+  }","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"crates/csrf/tests/browser/package.json","lines":["@@ -0,0 +1,7 @@","+{","+  \"name\": \"salvo-csrf-browser-regressions\",","+  \"private\": true,","+  \"type\": \"module\",","+  \"scripts\": { \"test\": \"node run.mjs\" },","+  \"devDependencies\": { \"playwright\": \"1.65.0\" }","+}"],"additions":7,"deletions":0,"truncated":false},{"path":"crates/csrf/tests/browser/run.mjs","lines":["@@ -0,0 +1,12 @@","+import { chromium } from \"playwright\";","+import hostPrefix from \"./host_prefix.js\";","+","+const executablePath = process.argv[2];","+const browser = await chromium.launch({ headless: true, ...(executablePath ? { executablePath } : {}) });","+try {","+  const context = await browser.newContext();","+  const result = await hostPrefix(await context.newPage());","+  console.log(JSON.stringify({ browser: browser.version(), ...result }));","+} finally {","+  await browser.close();","+}",""],"additions":12,"deletions":0,"truncated":false}],"additions":411,"deletions":19,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-10T17:07:56.295178+00:00"}