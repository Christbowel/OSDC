{"id":"feb4266c594058c1fd4a821238b49359275b97cc","axis":"silent","repo":"tensorflow/tensorflow","sha":"feb4266c594058c1fd4a821238b49359275b97cc","parsed":{"files":[{"path":"third_party/xla/xla/backends/gpu/target_config/BUILD","lines":["@@ -185,8 +185,10 @@ cc_library(","         \":__subpackages__\",","     ]),","     deps = [","+        \":target_config\",","         \"//xla/service:gpu_topology\",","         \"//xla/service:gpu_topology_proto_cc\",","+        \"//xla/stream_executor:device_description\",","         \"@com_google_absl//absl/algorithm:container\",","         \"@com_google_absl//absl/status\",","         \"@com_google_absl//absl/status:status_macros\",","@@ -203,6 +205,7 @@ xla_cc_test(","         \":target_config\",","         \"//xla/service:gpu_topology\",","         \"//xla/service:gpu_topology_proto_cc\",","+        \"//xla/stream_executor:device_description\",","         \"//xla/stream_executor/cuda:cuda_compute_capability_proto_cc\",","         \"@com_google_absl//absl/status\",","         \"@com_google_absl//absl/status:status_matchers\","],"additions":3,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/target_config/gpu_topology_utils.cc","lines":["@@ -17,16 +17,86 @@ limitations under the License."," "," #include <array>"," #include <memory>","+#include <string>"," "," #include \"absl/algorithm/container.h\""," #include \"absl/status/status.h\""," #include \"absl/status/status_macros.h\""," #include \"absl/status/statusor.h\""," #include \"absl/strings/string_view.h\"","+#include \"xla/backends/gpu/target_config/target_config.h\""," #include \"xla/service/gpu_topology.h\""," #include \"xla/service/gpu_topology.pb.h\"","+#include \"xla/stream_executor/device_description.h\""," "," namespace xla::gpu {","+namespace {","+","+// Returns the primary non-empty device or platform identifier from `topology`,","+// checking `gpu_target_config().device_description_str`,","+// `gpu_target_config().device_description.name()`, and `platform_version()` in","+// order.","+absl::string_view PrimaryTopologyDeviceIdentifier(const GpuTopology& topology) {","+  if (topology.has_gpu_target_config()) {","+    if (!topology.gpu_target_config().device_description_str.empty()) {","+      return topology.gpu_target_config().device_description_str;","+    }","+    if (!topology.gpu_target_config().device_description.name().empty()) {","+      return topology.gpu_target_config().device_description.name();","+    }","+  }","+  return topology.platform_version();","+}","+","+// Resolves a canonical device description string for `topology`, normalizing","+// SKU variants belonging to a registered `GpuPlatformConfig` to that platform's","+// primary device description string.","+absl::StatusOr<std::string> ResolveDeviceDescriptionStr(","+    const GpuTopology& topology) {","+  if (topology.has_gpu_target_config()) {","+    for (absl::string_view candidate :","+         {absl::string_view(","+              topology.gpu_target_config().device_description_str),","+          absl::string_view(","+              topology.gpu_target_config().device_description.name())}) {","+      if (!candidate.empty()) {","+        absl::StatusOr<const GpuPlatformConfig*> config =","+            GetGpuPlatformConfig(candidate);","+        if (config.ok() && !(*config)->device_descriptions.empty()) {","+          return (*config)->device_descriptions.front();","+        }","+        return std::string(candidate);","+      }","+    }","+  }","+  if (!topology.platform_version().empty()) {","+    absl::StatusOr<const GpuPlatformConfig*> config =","+        GetGpuPlatformConfig(topology.platform_version());","+    if (config.ok() && !(*config)->device_descriptions.empty()) {","+      return (*config)->device_descriptions.front();","+    }","+  }","+  return absl::InvalidArgumentError(","+      \"GpuTargetConfig is required to determine compatibility.\");","+}","+","+}  // namespace","+","+absl::Status ValidateSupportedGpuTopology(const GpuTopology& gpu_topology) {","+  absl::string_view identifier = PrimaryTopologyDeviceIdentifier(gpu_topology);","+  if (identifier.empty()) {","+    return absl::InvalidArgumentError(","+        \"GPU topology does not specify a device or platform identifier.\");","+  }","+  return GetGpuPlatformConfig(identifier).status();","+}","+","+absl::Status ValidateSupportedGpuTopology(","+    const xla::GpuTopologyProto& gpu_topology_proto) {","+  ABSL_ASSIGN_OR_RETURN(std::unique_ptr<const GpuTopology> gpu_topology,","+                   GpuTopology::FromProto(gpu_topology_proto));","+  return ValidateSupportedGpuTopology(*gpu_topology);","+}"," "," absl::StatusOr<bool> IsCompatibleWithTargetTopology(","     const GpuTopology& compiler_topology, const GpuTopology& target_topology) {","@@ -39,20 +109,20 @@ absl::StatusOr<bool> IsCompatibleWithTargetTopology(","     return false;","   }"," ","-  // If the platform version is the same, the topologies are compatible.","-  if (compiler_topology.platform_version() ==","-      target_topology.platform_version()) {","+  // If a non-empty platform version is the same, the topologies are compatible.","+  if (!compiler_topology.platform_version().empty() &&","+      compiler_topology.platform_version() ==","+          target_topology.platform_version()) {","     return true;","   }"," ","-  if (!compiler_topology.has_gpu_target_config() ||","-      !target_topology.has_gpu_target_config()) {","-    return absl::InvalidArgumentError(","-        \"GpuTargetConfig is required to determine compatibility.\");","-  }","+  ABSL_ASSIGN_OR_RETURN(std::string compiler_device_description,","+                   ResolveDeviceDescriptionStr(compiler_topology));","+  ABSL_ASSIGN_OR_RETURN(std::string target_device_description,","+                   ResolveDeviceDescriptionStr(target_topology));"," ","-  if (compiler_topology.gpu_target_config().device_description_str ==","-      target_topology.gpu_target_config().device_description_str) {","+  if (!compiler_device_description.empty() &&","+      compiler_device_description == target_device_description) {","     return true;","   }"," ","@@ -65,13 +135,9 @@ absl::StatusOr<bool> IsCompatibleWithTargetTopology(","       // NVIDIA B300 (HGX) and B300 (Superchip) are similar enough to consider","       // them compatible.","       CompatibleGpuPair{\"NVIDIA GB300\", \"NVIDIA B300\"}};","-  for (const auto& compatible_gpu_pair : kCompatibleGpus) {","-    if (absl::c_contains(","-            compatible_gpu_pair,","-            compiler_topology.gpu_target_config().device_description_str) &&","-        absl::c_contains(","-            compatible_gpu_pair,","-            target_topology.gpu_target_config().device_description_str)) {","+  for (const CompatibleGpuPair& compatible_gpu_pair : kCompatibleGpus) {","+    if (absl::c_contains(compatible_gpu_pair, compiler_device_description) &&","+        absl::c_contains(compatible_gpu_pair, target_device_description)) {","       return true;","     }","   }"],"additions":83,"deletions":17,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/target_config/gpu_topology_utils.h","lines":["@@ -16,12 +16,22 @@ limitations under the License."," #ifndef XLA_BACKENDS_GPU_TARGET_CONFIG_GPU_TOPOLOGY_UTILS_H_"," #define XLA_BACKENDS_GPU_TARGET_CONFIG_GPU_TOPOLOGY_UTILS_H_"," ","+#include \"absl/status/status.h\""," #include \"absl/status/statusor.h\""," #include \"xla/service/gpu_topology.h\""," #include \"xla/service/gpu_topology.pb.h\""," "," namespace xla::gpu {"," ","+// Validates that `gpu_topology` represents a GPU platform or SKU registered in","+// XLA:GPU.","+absl::Status ValidateSupportedGpuTopology(const GpuTopology& gpu_topology);","+","+// Validates that `gpu_topology` represents a GPU platform or SKU registered in","+// XLA:GPU.","+absl::Status ValidateSupportedGpuTopology(","+    const xla::GpuTopologyProto& gpu_topology);","+"," // Returns true if a host with `compiler_topology` can be used to compile for a"," // host with `target_topology`."," absl::StatusOr<bool> IsCompatibleWithTargetTopology("],"additions":10,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/target_config/gpu_topology_utils_test.cc","lines":["@@ -23,12 +23,14 @@ limitations under the License."," #include \"xla/service/gpu_topology.h\""," #include \"xla/service/gpu_topology.pb.h\""," #include \"xla/stream_executor/cuda/cuda_compute_capability.pb.h\"","+#include \"xla/stream_executor/device_description.h\""," "," namespace xla::gpu {"," namespace {"," "," using ::absl_testing::IsOkAndHolds;"," using ::absl_testing::StatusIs;","+using ::testing::HasSubstr;"," "," TEST(IsCompatibleWithTargetTopologyTest, SamePlatformsAreCompatible) {","   GpuTopology single_topology(\"platform_version\", 1, 1, 1);","@@ -174,5 +176,132 @@ TEST(IsCompatibleWithTargetTopoologyTest, FailsWithInvalidProto) {","       StatusIs(absl::StatusCode::kInvalidArgument));"," }"," ","+TEST(IsCompatibleWithTargetTopologyTest,","+     RegisteredPlatformSkuVariantsAreCompatible) {","+  ASSERT_OK_AND_ASSIGN(GpuTopology gb300_topology,","+                       GetGpuTopologyForPlatform(\"oberon_b300\", 1, 1, 4));","+  ASSERT_OK_AND_ASSIGN(GpuTopology b300_topology,","+                       GetGpuTopologyForPlatform(\"umbriel_b300\", 1, 1, 8));","+","+  GpuTargetConfig maxq_config = gb300_topology.gpu_target_config();","+  maxq_config.device_description_str = \"NVIDIA GB300 Max-Q\";","+  maxq_config.device_description.set_name(\"NVIDIA GB300 Max-Q\");","+  GpuTopology gb300_maxq_topology(\"NVIDIA GB300 Max-Q\", 1, 1, 4, maxq_config);","+","+  EXPECT_THAT(","+      IsCompatibleWithTargetTopology(gb300_topology, gb300_maxq_topology),","+      IsOkAndHolds(true));","+  EXPECT_THAT(","+      IsCompatibleWithTargetTopology(b300_topology, gb300_maxq_topology),","+      IsOkAndHolds(true));","+","+  GpuTargetConfig b300_sxm_config = b300_topology.gpu_target_config();","+  b300_sxm_config.device_description_str = \"NVIDIA B300 SXM6 AC\";","+  b300_sxm_config.device_description.set_name(\"NVIDIA B300 SXM6 AC\");","+  GpuTopology b300_sxm_topology(\"NVIDIA B300 SXM6 AC\", 1, 1, 8,","+                                b300_sxm_config);","+  EXPECT_THAT(IsCompatibleWithTargetTopology(b300_topology, b300_sxm_topology),","+              IsOkAndHolds(true));","+","+  ASSERT_OK_AND_ASSIGN(GpuTopology vr200_topology,","+                       GetGpuTopologyForPlatform(\"velorum_r200\", 1, 1, 4));","+  GpuTargetConfig generic_vr_config = vr200_topology.gpu_target_config();","+  generic_vr_config.device_description_str = \"NVIDIA Graphics Device\";","+  generic_vr_config.device_description.set_name(\"NVIDIA Graphics Device\");","+  GpuTopology generic_vr_topology(\"NVIDIA Graphics Device\", 1, 1, 4,","+                                  generic_vr_config);","+  EXPECT_THAT(","+      IsCompatibleWithTargetTopology(vr200_topology, generic_vr_topology),","+      IsOkAndHolds(true));","+","+  // Distinct platforms that share a compute capability but are not in","+  // `CompatibleGpuPair` remain incompatible.","+  ASSERT_OK_AND_ASSIGN(GpuTopology h100_topology,","+                       GetGpuTopologyForPlatform(\"nvidia_h100\", 1, 1, 8));","+  ASSERT_OK_AND_ASSIGN(GpuTopology h200_topology,","+                       GetGpuTopologyForPlatform(\"tesla_h200\", 1, 1, 8));","+  EXPECT_THAT(IsCompatibleWithTargetTopology(h100_topology, h200_topology),","+              IsOkAndHolds(false));","+","+  ASSERT_OK_AND_ASSIGN(GpuTopology a100_40_topology,","+                       GetGpuTopologyForPlatform(\"tesla_a100\", 1, 1, 16));","+  ASSERT_OK_AND_ASSIGN(GpuTopology a100_80_topology,","+                       GetGpuTopologyForPlatform(\"tesla_a100_80gib\", 1, 1, 8));","+  EXPECT_THAT(","+      IsCompatibleWithTargetTopology(a100_40_topology, a100_80_topology),","+      IsOkAndHolds(false));","+}","+","+TEST(IsCompatibleWithTargetTopologyTest,","+     FallsBackWhenTargetConfigDeviceDescriptionStrIsEmpty) {","+  ASSERT_OK_AND_ASSIGN(GpuTopology target_topology,","+                       GetGpuTopologyForPlatform(\"oberon_b300\", 1, 1, 4));","+","+  // Fallback to `device_description.name()` when `device_description_str` is","+  // empty.","+  GpuTargetConfig named_device_config = target_topology.gpu_target_config();","+  named_device_config.device_description_str.clear();","+  named_device_config.device_description.set_name(\"NVIDIA GB300 Max-Q\");","+  GpuTopology named_device_topology(\"custom_platform\", 1, 1, 4,","+                                    named_device_config);","+  EXPECT_OK(ValidateSupportedGpuTopology(named_device_topology));","+  EXPECT_THAT(","+      IsCompatibleWithTargetTopology(named_device_topology, target_topology),","+      IsOkAndHolds(true));","+","+  // Fallback to `platform_version()` when both `device_description_str` and","+  // `device_description.name()` are empty.","+  GpuTargetConfig empty_desc_config = target_topology.gpu_target_config();","+  empty_desc_config.device_description_str.clear();","+  empty_desc_config.device_description.set_name(\"\");","+  GpuTopology platform_fallback_topology(\"NVIDIA GB300 Max-Q\", 1, 1, 4,","+                                         empty_desc_config);","+  EXPECT_OK(ValidateSupportedGpuTopology(platform_fallback_topology));","+  EXPECT_THAT(IsCompatibleWithTargetTopology(platform_fallback_topology,","+                                             target_topology),","+              IsOkAndHolds(true));","+","+  // When all three identifiers are empty/unrecognized, compatibility fails fast","+  // with `InvalidArgumentError`.","+  GpuTopology unrecognized_a(\"unrecognized_p1\", 1, 1, 4, empty_desc_config);","+  GpuTopology unrecognized_b(\"unrecognized_p2\", 1, 1, 4, empty_desc_config);","+  EXPECT_THAT(","+      ValidateSupportedGpuTopology(unrecognized_a),","+      StatusIs(absl::StatusCode::kInvalidArgument,","+               HasSubstr(\"Unsupported GPU platform type: unrecognized_p1\")));","+  EXPECT_THAT(IsCompatibleWithTargetTopology(unrecognized_a, unrecognized_b),","+              StatusIs(absl::StatusCode::kInvalidArgument));","+}","+","+TEST(ValidateSupportedGpuTopologyTest, AcceptsSupportedPlatformsAndSkus) {","+  ASSERT_OK_AND_ASSIGN(GpuTopology gb300_topology,","+                       GetGpuTopologyForPlatform(\"oberon_b300\", 1, 1, 4));","+  GpuTargetConfig maxq_config = gb300_topology.gpu_target_config();","+  maxq_config.device_description_str = \"NVIDIA GB300 Max-Q\";","+  GpuTopology gb300_maxq_topology(\"NVIDIA GB300 Max-Q\", 1, 1, 4, maxq_config);","+  EXPECT_OK(ValidateSupportedGpuTopology(gb300_maxq_topology));","+","+  GpuTopology p100_pcie_topology(\"Tesla P100-PCIE-16GB\", 1, 1, 1);","+  EXPECT_OK(ValidateSupportedGpuTopology(p100_pcie_topology));","+","+  GpuTopology named_only_topology(\"NVIDIA H100 80GB HBM3\", 1, 1, 8);","+  EXPECT_OK(ValidateSupportedGpuTopology(named_only_topology));","+}","+","+TEST(ValidateSupportedGpuTopologyTest, RejectsUnsupportedGpuTopology) {","+  GpuTopology unknown_topology(\"Unsupported GPU SKU\", 1, 1, 1);","+  EXPECT_THAT(","+      ValidateSupportedGpuTopology(unknown_topology),","+      StatusIs(","+          absl::StatusCode::kInvalidArgument,","+          HasSubstr(\"Unsupported GPU platform type: Unsupported GPU SKU\")));","+","+  GpuTopology empty_topology(\"\", 1, 1, 1);","+  EXPECT_THAT(ValidateSupportedGpuTopology(empty_topology),","+              StatusIs(absl::StatusCode::kInvalidArgument,","+                       HasSubstr(\"GPU topology does not specify a device or \"","+                                 \"platform identifier\")));","+}","+"," }  // namespace"," }  // namespace xla::gpu"],"additions":129,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/service/BUILD","lines":["@@ -6568,12 +6568,16 @@ cc_library(","         \"//xla:status_macros\",","         \"//xla/backends/cpu:target_machine_options\",","         \"//xla/backends/gpu/target_config\",","+        \"//xla/st