ion __construct(","         string|callable $description = '',","@@ -133,6 +135,14 @@ public static function tryFrom(\\ReflectionParameter|\\ReflectionProperty $member)","             $self->suggestedValues = $self->possibleValues;","         }"," ","+        if (!$self->suggestedValues && (InputFileType::isInputFile($reflection) || InputFileType::isInputFileCollection($reflection))) {","+            $self->suggestedValues = static function (CompletionInput $input, CompletionSuggestions $suggestions): array {","+                $suggestions->suggestPaths();","+","+                return [];","+            };","+        }","+","         return $self;","     }"," "],"additions":13,"deletions":3,"truncated":false},{"path":"src/Symfony/Component/Console/CHANGELOG.md","lines":["@@ -4,6 +4,8 @@ CHANGELOG"," 8.2"," ---"," ","+ * Add `CompletionSuggestions::suggestPaths()`, `suggestDirectories()` and `getPathSuggestion()` to let the shell complete file system paths, as `InputFile` arguments and options now do","+ * Pass the `CompletionSuggestions` to the `suggestedValues` closures of arguments and options","  * List the accepted values of `#[Argument]` and `#[Option]` inputs mapped to backed enums in their description, e.g. `[possible values: pending, paid]`","  * Map `#[Argument]` and `#[Option]` arrays to backed enums when their PHPDoc narrows them, e.g. `@param list<Suit> $suits` or `@var Suit[]`","  * Add `LockableTrait::setLockFactory()`, autowired with the lock factory of the resource named `console` when the app declares one"],"additions":2,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Console/Command/CompleteCommand.php","lines":["@@ -36,7 +36,9 @@"," #[AsCommand(name: '|_complete', description: 'Internal command to provide shell completion suggestions')]"," final class CompleteCommand extends Command"," {","-    public const COMPLETION_API_VERSION = '1';","+    public const COMPLETION_API_VERSION = '2';","+","+    private const MINIMUM_COMPLETION_API_VERSION = '1';"," ","     private array $completionOutputs;","     private bool $isDebug = false;","@@ -77,8 +79,8 @@ protected function execute(InputInterface $input, OutputInterface $output): int","         try {","             // \"symfony\" must be kept for compat with the shell scripts generated by Symfony Console 5.4 - 6.1","             $version = $input->getOption('symfony') ? '1' : $input->getOption('api-version');","-            if ($version && version_compare($version, self::COMPLETION_API_VERSION, '<')) {","-                $message = \\sprintf('Completion script version is not supported (\"%s\" given, \">=%s\" required).', $version, self::COMPLETION_API_VERSION);","+            if ($version && version_compare($version, self::MINIMUM_COMPLETION_API_VERSION, '<')) {","+                $message = \\sprintf('Completion script version is not supported (\"%s\" given, \">=%s\" required).', $version, self::MINIMUM_COMPLETION_API_VERSION);","                 $this->log($message);"," ","                 $output->writeln($message.' Install the Symfony completion script again by using the \"completion\" command.');","@@ -168,18 +170,30 @@ protected function execute(InputInterface $input, OutputInterface $output): int","                 }","             }"," ","+            // the scripts complete paths since version 2 of the API","+            if (($paths = $suggestions->getPathSuggestion()) && (!$version || version_compare($version, '2', '<'))) {","+                $this->log('  The completion script cannot complete '.$paths.', install it again to fix this.');","+                $paths = null;","+            }","+","             /** @var CompletionOutputInterface $completionOutput */","             $completionOutput = new $completionOutput();"," ","             $this->log('<info>Suggestions:</>');","+            if ($paths) {","+                $this->log('  <comment>'.ucfirst($paths).'</> are completed by the shell');","+            }","             if ($options = $suggestions->getOptionSuggestions()) {","                 $this->log('  --'.implode(' --', array_map(static fn ($o) => $o->getName(), $options)));","             } elseif ($values = $suggestions->getValueSuggestions()) {","                 $this->log('  '.implode(' ', $values));","-            } else {","+            } elseif (!$paths) {","                 $this->log('  <comment>No suggestions were provided</>');","             }"," ","+            if ($paths) {","+                $output->writeln(':'.$paths);","+            }","             $completionOutput->write($suggestions, $output);","         } catch (\\Throwable $e) {","             $this->log(["],"additions":18,"deletions":4,"truncated":false},{"path":"src/Symfony/Component/Console/Completion/CompletionSuggestions.php","lines":["@@ -22,6 +22,7 @@ final class CompletionSuggestions"," {","     private array $valueSuggestions = [];","     private array $optionSuggestions = [];","+    private ?string $pathSuggestion = null;"," ","     /**","      * Add a suggested value for an input option or argument.","@@ -81,6 +82,34 @@ public function suggestOptions(array $options): static","         return $this;","     }"," ","+    /**","+     * Lets the shell complete file system paths, in addition to the suggested values.","+     *","+     * Completion scripts installed by older versions of Symfony ignore it.","+     *","+     * @return $this","+     */","+    public function suggestPaths(): static","+    {","+        $this->pathSuggestion = 'paths';","+","+        return $this;","+    }","+","+    /**","+     * Lets the shell complete directory paths, in addition to the suggested values.","+     *","+     * Completion scripts installed by older versions of Symfony ignore it.","+     *","+     * @return $this","+     */","+    public function suggestDirectories(): static","+    {","+        $this->pathSuggestion ??= 'directories';","+","+        return $this;","+    }","+","     /**","      * @return InputOption[]","      */","@@ -96,4 +125,14 @@ public function getValueSuggestions(): array","     {","         return $this->valueSuggestions;","     }","+","+    /**","+     * Returns the kind of paths the shell should complete, if any.","+     *","+     * @return 'paths'|'directories'|null","+     */","+    public function getPathSuggestion(): ?string","+    {","+        return $this->pathSuggestion;","+    }"," }"],"additions":39,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Console/Input/InputArgument.php","lines":["@@ -146,7 +146,7 @@ public function hasCompletion(): bool","     public function complete(CompletionInput $input, CompletionSuggestions $suggestions): void","     {","         $values = $this->suggestedValues;","-        if ($values instanceof \\Closure && !\\is_array($values = $values($input))) {","+        if ($values instanceof \\Closure && !\\is_array($values = $values($input, $suggestions))) {","             throw new LogicException(\\sprintf('Closure for argument \"%s\" must return an array. Got \"%s\".', $this->name, get_debug_type($values)));","         }","         if ($values) {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/Console/Input/InputOption.php","lines":["@@ -275,7 +275,7 @@ public function hasCompletion(): bool","     public function complete(CompletionInput $input, CompletionSuggestions $suggestions): void","     {","         $values = $this->suggestedValues;","-        if ($values instanceof \\Closure && !\\is_array($values = $values($input))) {","+        if ($values instanceof \\Closure && !\\is_array($values = $values($input, $suggestions))) {","             throw new LogicException(\\sprintf('Closure for option \"%s\" must return an array. Got \"%s\".', $this->name, get_debug_type($values)));","         }","         if ($values) {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/Console/Resources/completion.bash","lines":["@@ -81,6 +81,30 @@ _sf_{{ COMMAND_NAME }}() {","             cur=\"${cur#*=}\"","         fi"," ","+        # the first line can ask to complete the paths or the directories along","+        # with the values. Readline then quotes the values the same way as paths.","+        local paths=\"${sfcomplete%%$'\\n'*}\"","+        if [[ \"$paths\" == :paths || \"$paths\" == :directories ]]; then","+            # the word can start with a quote or contain escaped characters","+            local word=\"$cur\" s q","+            [[ \"${cur:0:1}\" == [\\'\\\"] ]] && word=\"${cur:1}\"","+","+            while IFS= read -r s; do","+                printf -v q %q \"$s\"","+                [[ -n \"$s\" && ( \"$s\" == \"$word\"* || \"$q\" == \"$cur\"* ) ]] && COMPREPLY+=(\"$s\")","+            done <<< \"${sfcomplete#\"$paths\"}\"","+","+            compopt -o filenames 2> /dev/null","+            if [[ \"$paths\" == :directories ]]; then","+                _filedir -d","+            else","+                _filedir","+            fi","+            __ltrim_colon_completions \"$cur\"","+","+            return 0","+        fi","+","         quote=${cur:0:1}"," ","         # Use single quotes by default if suggestions contains backslash (FQCN)"],"additions":24,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Console/Resources/completion.fish","lines":["@@ -28,9 +28,30 @@ function _sf_{{ COMMAND_NAME }}"," ","     set sfcomplete (env SHELL_VERBOSITY=0 $completecmd)"," ","+    # the first line can ask to complete the paths or the directories along with the values","+    set paths \"\"","+    if contains -- \"$sfcomplete[1]\" :paths :directories","+        set paths $sfcomplete[1]","+        set -e sfcomplete[1]","+    end","+","     for i in $sfcomplete","         echo \"$flag_prefix$i\"","     end","+","+    # fish completes the paths, after the \"=\" of an option. \"complete -C\" reads the","+    # token as typed, while __fish_complete_path ignores its quotes before fish 3.7.","+    set token (commandline -ct)","+    set token (string sub -s (math (string length -- \"$flag_prefix\") + 1) -- \"$token\")","+    if [ \"$paths\" = \":paths\" ]","+        for i in (complete -C\"'' $token\")","+            echo \"$flag_prefix$i\"","+        end","+    else if [ \"$paths\" = \":directories\" ]","+        for i in (__fish_complete_directories \"$token\")","+            echo \"$flag_prefix$i\"","+        end","+    end"," end"," "," complete -c '{{ COMMAND_NAME }}' -a '(_sf_{{ COMMAND_NAME }})' -f"],"additions":21,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Console/Resources/completion.zsh","lines":["@@ -16,7 +16,7 @@"," #"," _sf_{{ COMMAND_NAME }}() {","     local lastParam out comp sf_cmd","-    local -a completions flagPrefix requestComp inputs","+    local -a completions flagPrefix requestComp inputs files"," ","     # The user could have moved the cursor backwards on the command-line.","     # We need to trigger completion from the $CURRENT location, so we need","@@ -69,6 +69,18 @@ _sf_{{ COMMAND_NAME }}() {","     # \"$(...)\" or a backtick typed on the command line is not executed","     out=$(SHELL_VERBOSITY=0 \"${requestComp[@]}\" \"${inputs[@]}\" 2>/dev/null)"," ","+    # The first line can ask to complete the paths or the directories along with the values","+    case \"${out%%$'\\n'*}\" in","+        :paths)","+            files=(_files)","+            out=\"${out#:paths}\"","+            ;;","+        :directories)","+            files=(_directories)","+            out=\"${out#:directories}\"","+            ;;","+    esac","+","     while IFS='\\n' read -r comp; do","         if [ -n \"$comp\" ]; then","             # If requested, completions are returned with a description.","@@ -84,7 +96,15 @@ _sf_{{ COMMAND_NAME }}() {"," ","     # Let inbuilt _describe handle completions","     _describe \"completions\" completions \"${flagPrefix[@]}\"","-    return $?","+    local ret=$?","+","+    # Let inbuilt _files or _directories complete the 