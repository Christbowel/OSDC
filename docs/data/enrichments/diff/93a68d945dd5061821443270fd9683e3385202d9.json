{"id":"93a68d945dd5061821443270fd9683e3385202d9","axis":"silent","repo":"pnpm/pnpm","sha":"93a68d945dd5061821443270fd9683e3385202d9","parsed":{"files":[{"path":".changeset/concurrency-group-wait-order.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pacquet\": minor","+---","+","+Waiting tasks of a concurrency group now take available slots in arrival order, with higher `priority` tasks going first. If workspaces use different limits for the same group, a later task can take a free slot that earlier tasks cannot use. `pnpm tasks status` lists running and waiting tasks in each group. It also shows how long each task has been running or waiting.","+","+A package script named `tasks` takes precedence. Use `pnpm pm tasks status` to inspect groups when that script exists."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args.rs","lines":["@@ -91,6 +91,7 @@ pub mod stars;"," pub mod store;"," pub mod sudo_guard;"," pub mod supported_architectures;","+pub mod tasks;"," pub mod team;"," pub mod undeprecate;"," pub mod unlink;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command.rs","lines":["@@ -74,6 +74,7 @@ use super::{","     star::StarArgs,","     stars::StarsArgs,","     store::StoreCommand,","+    tasks::TasksArgs,","     team::TeamArgs,","     undeprecate::UndeprecateArgs,","     unlink::UnlinkArgs,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -9,8 +9,8 @@ use super::{","     PingArgs, PipelineArgs, PkgArgs, PrefixArgs, PruneArgs, PublishArgs, RebuildArgs, RemoveArgs,","     RepoArgs, RestartArgs, RootArgs, RunArgs, RuntimeArgs, SbomArgs, ScriptShortcutArgs,","     SearchArgs, SelfUpdateArgs, SetScriptArgs, SetupArgs, ShimArgs, StageArgs, StarArgs, StarsArgs,","-    StoreCommand, Subcommand, SummaryScope, TeamArgs, UndeprecateArgs, UnlinkArgs, UnpublishArgs,","-    UnstarArgs, UpdateArgs, VersionArgs, ViewArgs, WhyArg