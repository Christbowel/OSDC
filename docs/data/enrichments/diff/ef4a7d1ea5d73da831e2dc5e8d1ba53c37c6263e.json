d = \"device\",","+                                   layout = \"default\">","+// CHECK-LABEL: \"type_array_explicit_defaults\"","+// CHECK-NEXT: (%[[ARG0:.*]]: {{.*}}):","+func.func @type_array_explicit_defaults(%arg0: !array_explicit_def0)","+    attributes {ifrt.function} {","+  // CHECK: \"vifrt.CopyArraysV2\"(%[[ARG0]])","+  // CHECK-SAME: (!vifrt.array_v1<tensor<2x4xi32>, #vifrt.sharding_param_v2<1x1 to [0] on 2>, [0, 1], memory_kind = \"vifrt.default\", layout = \"vifrt.default\">) -> (!vifrt.array_v1<tensor<2x4xi32>, #vifrt.sharding_param_v2<1x1 to [0] on 2>, [2, 3], memory_kind = \"vifrt.default\", layout = \"vifrt.default\">, !vifrt.control_v1)","+  %0, %ctrl = ifrt.CopyArrays(%arg0)","+      : (!array_explicit_def0) -> !array_explicit_def1","+  return","+}","+","+// Verifies that non-default `memory_kind` and user `layout` attributes are","+// preserved through VIFRT legalization and round-trip.","+!array_non_def0 = !ifrt.array<tensor<2x4xi32>,","+                              #ifrt.sharding_param<1x1 to [0] on 2>, [0, 1],","+                              memory_kind = \"pinned_host\", layout = \"{0,1}\">","+!array_non_def1 = !ifrt.array<tensor<2x4xi32>,","+                              #ifrt.sharding_param<1x1 to [0] on 2>, [2, 3],","+                              memory_kind = \"pinned_host\", layout = \"{1,0}\">","+// CHECK-LABEL: \"type_array_non_default_memory_kind_and_layout\"","+// CHECK-NEXT: (%[[ARG0:.*]]: {{.*}}):","+func.func @type_array_non_default_memory_kind_and_layout(%arg0: !array_non_def0)","+    attributes {ifrt.function} {","+  // CHECK: \"vifrt.CopyArraysV2\"(%[[ARG0]])","+  // CHECK-SAME: (!vifrt.array_v1<tensor<2x4xi32>, #vifrt.sharding_param_v2<1x1 to [0] on 2>, [0, 1], memory_kind = \"pinned_host\", layout = \"{0,1}\">) -> (!vifrt.array_v1<tensor<2x4xi32>, #vifrt.sharding_param_v2<1x1 to [0] on 2>, [2, 3], memory_kind = \"pinned_host\", layout = \"{1,0}\">, !vifrt.control_v1)","+  %0, %ctrl = ifrt.CopyArrays(%arg0) : (!array_non_def0) -> !array_non_def1","+  return","+}","+"," !array_us0 = !ifrt.array<tensor<2x4xi32>, #ifrt.sharding_unspecified, [0,1]>"," !array_us1 = !ifrt.array<tensor<2x4xi32>, #ifrt.sharding_unspecified, [2,3]>"," // CHECK-LABEL: \"attr_unspecified_sharding\""],"additions":39,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/python/ifrt/ir/export/tests/vifrt_legalize_to_ifrt.mlir","lines":["@@ -0,0 +1,36 @@","+// Copyright 2026 The OpenXLA Authors. All Rights Reserved.","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+// ==============================================================================","+// RUN: ifrt-opt %s --vifrt-legalize-to-ifrt | FileCheck %s","+","+// Verifies that legacy VIFRT arrays carrying literal `\"device\"` / `\"default\"`","+// strings canonicalize to default IFRT attributes (omitted when printed) while","+// non-default attributes are preserved.","+!v_explicit_def = !vifrt.array_v1<tensor<2x4xi32>,","+                                  #vifrt.sharding_param_v2<1x1 to [0] on 2>,","+                                  [0, 1], memory_kind = \"device\",","+                                  layout = \"default\">","+!v_non_def = !vifrt.array_v1<tensor<2x4xi32>,","+                             #vifrt.sharding_param_v2<1x1 to [0] on 2>, [2, 3],","+                             memory_kind = \"pinned_host\", layout = \"{0,1}\">","+// CHECK: #sp = #ifrt.sharding_param<1x1 to [0] on 2>","+// CHECK-LABEL: fun