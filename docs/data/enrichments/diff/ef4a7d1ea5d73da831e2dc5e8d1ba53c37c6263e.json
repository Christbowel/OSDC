/ Canonicalizes `memory_kind_attr` for `IfrtArrayType` construction: maps","+// `nullptr` (omitted) to the default IFRT memory kind (`\"device\"`), preserving","+// non-null attributes (including `\"\"`) so `verify()` rejects invalid values.","+mlir::StringAttr CanonicalizeMemoryKindAttr(mlir::MLIRContext* context,","+                                            mlir::StringAttr memory_kind_attr) {","+  if (memory_kind_attr == nullptr) {","+    return mlir::StringAttr::get(context, xla::ifrt::MemoryKind().value());","+  }","+  return memory_kind_attr;","+}","+","+// Canonicalizes `layout_attr` for `IfrtArrayType` construction: maps `nullptr`","+// (omitted) to `\"default\"`, preserving non-null attributes so `verify()`","+// validates them.","+mlir::StringAttr CanonicalizeLayoutAttr(mlir::MLIRContext* context,","+                                        mlir::StringAttr layout_attr) {","+  if (layout_attr == nullptr) {","+    return mlir::StringAttr::get(context, kDefaultLayoutMode);","+  }","+  return layout_attr;","+}","+","+}  // namespace","+","+IfrtArrayType IfrtArrayType::get(mlir::MLIRContext* context,","+                                 mlir::RankedTensorType shape,","+                                 IfrtShardingAttrInterface sharding_attr,","+                                 IfrtDevicesAttr devices_attr,","+                                 mlir::StringAttr memory_kind_attr,","+                                 mlir::StringAttr layout_attr) {","+  return Base::get(context, shape, sharding_attr, devices_attr,","+                   CanonicalizeMemoryKindAttr(context, memory_kind_attr),","+                   CanonicalizeLayoutAttr(context, layout_attr));","+}","+","+IfrtArrayType IfrtArrayType::getChecked(","+    llvm::function_ref<mlir::InFlightDiagnostic()> emitError,","+    mlir::MLIRContext* context, mlir::RankedTensorType shape,","+    IfrtShardingAttrInterface sharding_attr, IfrtDevicesAttr devices_attr,","+    mlir::StringAttr memory_kind_attr, mlir::StringAttr layout_attr) {","+  return Base::getChecked(emitError, context, shape, sharding_attr,","+                          devices_attr,","+                          CanonicalizeMemoryKindAttr(context, memory_kind_attr),","+                          CanonicalizeLayoutAttr(context, layout_attr));","+}","+"," // Returns an array of logical device ids."," llvm::ArrayRef<int> IfrtArrayType::getDevices() const {","   return getDevicesAttr().getIds();","@@ -463,7 +515,8 @@ mlir::LogicalResult IfrtArrayType::verify(","     mlir::RankedTensorType shape, IfrtShardingAttrInterface sharding_attr,","     IfrtDevicesAttr devices_attr, mlir::StringAttr memory_kind_attr,","     mlir::StringAttr layout_attr) {","-  if (shape == nullptr || sharding_attr == nullptr || devices_attr == nullptr) {","+  if (shape == nullptr || sharding_attr == nullptr || devices_attr == nullptr ||","+      memory_kind_attr == nullptr || layout_attr == nullptr) {","     return emitError() << \"expected non-null IfrtArrayType parameters\";","   }","   if (shape.getEncoding() != nullptr) {","@@ -497,117 +550,156 @@ mlir::LogicalResult IfrtArrayType::verify(","       return emitError() << \"Unsupported array element type: \" << element_type;","     }","   }","-  if (memory_kind_attr != nullptr && memory_kind_attr.getValue().empty()) {","+  if (!llvm::isa<mlir::NoneType>(memory_kind_attr.getType())) {","+    return emitError()","+           << \"Memory kind must be an untyped string attribute, got \"","+           << memory_kind_attr;","+  }","+  if (memory_kind_attr.getValue().empty()) {","     return emitError() << \"Memory kind cannot be empty\";","   }","   if (mlir::failed(","           sharding_attr.CanApplyTo(emitError, shape, devices_attr.getIds()))) {","     return mlir::failure();","   }","-  if (layout_attr != nullptr) {","-    absl::StatusOr<xla::LayoutMode> layout_mode =","-        xla::LayoutMode::FromString(layout_attr.str());","-    if (!layout_mode.ok()) {","-      return emitError() << \"Invalid layout mode: \"","-                         << layout_mode.status().message();","-    }","-    if (llvm::isa<IfrtTokenType, IfrtStringType>(element_type)) {","-      if (layout_mode->mode != xla::LayoutMode::Mode::kDefault) {","-        return emitError() << \"Array with element type \" << element_type","-                           << \" only supports default layout mode, got \"","-                           << layout_attr;","-      }","-    } else if (layout_mode->mode == xla::LayoutMode::Mode::kUserSpecified) {","-      CHECK(layout_mode->user_layout.has_value());","-      const int64_t layout_rank = static_cast<int64_t>(","-          layout_mode->user_layout->minor_to_major().size());","-      if (layout_rank != shape.getRank()) {","-        return emitError() << \"Layout minor_to_major size (\" << layout_rank","-                           << \") does not match array rank (\" << shape.getRank()","-                           << \"): \" << layout_attr;","-      }","-      // Validate against the per-shard shape when divisible so shard-local","-      // `split_configs` bounds are checked. Non-divisible shardings and","-      // `#ifrt.sharding_unspecified` validate against the global shape. This","-      // cannot falsely reject a valid layout because `ValidateLayoutForShape`","-      // checks only that `split_index < dim_size` (every other check depends","-      // only on element type, rank, or layout-internal fields), which is","-      // monotone in `dim_size`, and `local_dim <= global_dim` always holds.","-      absl::StatusOr<llvm::SmallVector<int64_t>> local_shape =","-          sharding_attr.LocalShapeFromGlobalShape(shape.getShape());","-      const llvm::ArrayRef<int64_t> validation_dims =","-          local_shape.ok() ? llvm::ArrayRef<int64_t>(*local_shape)","-                           : shape.getShape();","-      absl::StatusOr<xla::Shape> xla_shape = xla::ShapeUtil::MakeValidatedShape(","-          primitive_type,","-          absl::MakeConstSpan(validation_dims.data(), validation_dims.size()));","-      if (!xla_shape.ok()) {","-        return emitError() << \"Invalid array shape for layout validation: \"","-                           << xla_shape.status().message();","-      }","-      if (const absl::Status status = xla::LayoutUtil::ValidateLayoutForShape(","-              *layout_mode->user_layout, *xla_shape);","-          !status.ok()) {","-        return emitError() << \"Invalid layout \" << layout_attr << \": \"","-                           << status.message();","-      }","-    }","+  if (!llvm::isa<mlir::NoneType>(layout_attr.getType())) {","+    return emitError()","+           << \"Layout mode must be an untyped string attribute, got \"","+           << layout_attr;","+  }","+  const llvm::StringRef layout_value = layout_attr.getValue();","+  if (layout_value == kDefaultLayoutMode) {","+    return mlir::success();","+  }","+  if (llvm::isa<IfrtTokenType, IfrtStringType>(element_type)) {","+    return emitError() << \"Array with element type \" << element_type","+                       << \" only supports default layout mode, got \"","+                       << layout_attr;","+  }","+  if (layout_value == kAutoLayoutMode) {","+    return mlir::success();","+  }","+  absl::StatusOr<xla::LayoutMode> layout_mode =","+      xla::LayoutMode::FromString(layout_attr.str());","+  if (!layout_mode.ok()) {","+    return emitError() << \"Invalid layout mode: \"","+                       << layout_mode.status().message();","+  }","+  CHECK(layout_mode->user_layout.has_value());","+  const int64_t layout_rank =","+      static_cast<int64_t>(layout_mode->user_layout->minor_to_major().size());","+  if (layout_rank != shape.getRank()) {","+    return emitError() << \"Layout minor_to_major size (\" << layout_rank","+                       << \") does not match array rank (\" << shape.getRank()","+                       << \"): \" << layout_attr;","+  }","+  // Validate against the per-shard shape when divisible so shard-local","+  // `split_configs` bounds are checked. Non-divisible shardings and","+  // `#ifrt.sharding_unspecified` validate against the global shape. This","+  // cannot falsely reject a valid layout because `ValidateLayoutForShape`","+  // checks only that `split_index < dim_size` (every other check depends","+  // only on element type, rank, or layout-internal fields), which is","+  // monotone in `dim_size`, and `local_dim <= global_dim` always holds.","+  absl::StatusOr<llvm::SmallVector<int64_t>> local_shape =","+      sharding_attr.LocalShapeFromGlobalShape(shape.getShape());","+  const llvm::ArrayRef<int64_t> validation_dims =","+      local_shape.ok() ? llvm::ArrayRef<int64_t>(*local_shape)","+                       : shape.getShape();","+  absl::StatusOr<xla::Shape> xla_shape = xla::ShapeUtil::MakeValidatedShape(","+      primitive_type,","+      absl::MakeConstSpan(validation_dims.data(), validation_dims.size()));","+  if (!xla_shape.ok()) {","+    return emitError() << \"Invalid array shape for layout validation: \"","+                       << xla_shape.status().message();","+  }","+  // `xla::LayoutUtil::ValidateLayoutForShape` returns OK early whenever","+  // `minor_to_major` is empty and `memory_space != 0` (to allow non-scalar AUTO","+  // layouts with a memory space), which skips all validation on rank-0 arrays.","+  // Clear `memory_space` on a copy for validation only; nothing after that","+  // early return inspects `memory_space`, and the original layout is preserved","+  // for the checks below.","+  absl::Status validation_status;","+  if (shape.getRank() == 0 && layout_mode->user_layout->memory_space() != 0) {","+    xla::Layout layout_for_validation = *layout_mode->user_layout;","+    layout_for_validation.set_memory_space(0);","+    validation_status = xla::LayoutUtil::ValidateLayoutForShape(","+        layout_for_validation, *xla_shape);","+  } else {","+    validation_status = xla::LayoutUtil::ValidateLayoutForShape(","+        *layout_mode->user_layout, *xla_shape);","+  }","+  if (!validation_status.ok()) {","+    return emitError() << \"Invalid layout \" << layout_attr << \": \"","+                       << validation_status.message();","+  }","+  if (layout_mode->user_layout->dynamic_shape_metadata_prefix_bytes() != 0) {","+    return emitError()","+           << \"Invalid layout \" << layout_attr","+           << \": layout dynamic_shape_metadata_prefix_bytes must be 0, got \"","+           << layout_mode->user_layout->dynamic_shape_metadata_prefix_bytes();","+  }","+  if (const std::string canonical_layout = layout_mode->user_layout->ToString();","+      layout_value != canonical_layout) {","+    return emitError() << \"Non-canonical layout mode: \" << layout_attr","+                       << \" (expected \\\"\" << canonical_layout << \"\\\")\";","   }","   return mlir::success();"," }"," "," xla::ifrt::MemoryKind IfrtArrayType::MemoryKind() const {","-  static const absl::NoDestructor<std::string> default_memory_kind(","-      absl::StrCat(xla::ifrt::MemoryKind()));","-  mlir::StringAttr memory_kind_attr = getMemoryKindAttr();","-  return memory_kind_attr == nullptr ||","-                 memory_kind_attr.getValue() == *default_memory_kind","-             ? xla::ifrt::MemoryKind()","-             : xla::ifrt::MemoryKind(memory_kind_attr.str());","-};","+  return xla::ifrt::MemoryKind(","+      absl::string_view(getMemoryKindAttr().getValue()));","+}"," "," // TODO(icgog): Migrate to xla::ifrt::Layout."," xla::LayoutMode IfrtArrayType::LayoutMode() const {","-  if (auto layout_attr = getLayoutAttr()) {","-    auto layout_mode = xla::LayoutMode::FromString(layout_attr.str());","-    CHECK_OK(layout_mode) << \"Invalid layout mode: \" << layout_attr.str();","-    return *layout_mode;","+  const mlir::StringAttr layout_attr = getLayoutAttr();","+  const llvm::StringRef value = layout_attr.getValue();","+  if (value == kDefaultLayoutMode) {","+    return xla::LayoutMode(xla::LayoutMode::Mode::kDefault);","+  }","+  if (value == kAutoLayoutMode) {","+    return xla::LayoutMode(xla::LayoutMode::Mode::kAuto);","   }","-  return xla::LayoutMode(xla::LayoutMode::Mode::kDefault);","+  absl::StatusOr<xla::LayoutMode> layout_mode =","+      xla::LayoutMode::FromString(layout_attr.str());","+  CHECK_OK(layout_mode) << \"Invalid layout mode: \" << layout_attr.str();","+  return *std::move(layout_mode);"," }"," "," absl::StatusOr<llvm::SmallVector<int64_t>> IfrtArrayType::LocalShape() const {","   return getShardingAttr().LocalShapeFromGlobalShape(getShape().getShape());"," }"," ","+bool IfrtArrayType::HasSameMemoryKind(IfrtArrayType other) const {","+  return getMemoryKindAttr() == other.getMemoryKindAttr();","+}","+"," bool IfrtArrayType::HasSameLayout(IfrtArrayType other) const {","-  if (getLayoutAttr() == other.getLayoutAttr()) {","-    return true;","-  }","-  xla::LayoutMode lhs_mode = LayoutMode();","-  xla::LayoutMode rhs_mode = other.LayoutMode();","-  if (lhs_mode.mode != rhs_mode.mode) {","-    return false;","-  }","-  if (lhs_mode.mode == xla::LayoutMode::Mode::kUserSpecified) {","-    return lhs_mode.user_layout == rhs_mode.user_layout;","-  }","-  return true;","+  return getLayoutAttr() == other.getLayoutAttr();","+}","+","+bool IfrtArrayType::HasDefaultMemoryKind() const {","+  return getMemoryKindAttr().getValue() ==","+         llvm::StringRef(xla::ifrt::MemoryKind().value());","+}","+","+bool IfrtArrayType::HasDefaultLayout() const {","+  return getLayoutAttr().getValue() == kDefaultLayoutMode;"," }"," "," void IfrtArrayType::print(mlir::AsmPrinter& odsPrinter) const {","-  mlir::Builder odsBuilder(getContext());","   odsPrinter << \"<\";","   odsPrinter.printStrippedAttrOrType(getShape());","   odsPrinter << \", \";","   odsPrinter.printStrippedAttrOrType(getShardingAttr());","   odsPrinter << \", \";","   odsPrinter.printStrippedAttrOrType(getDevicesAttr());","-  if (getMemoryKindAttr()) {","+  if (!HasDefaultMemoryKind()) {","     odsPrinter << \", memory_kind = \";","     odsPrinter.printStrippedAttrOrType(getMemoryKindAttr());","   }","-  if (getLayoutAttr()) {","+  if (!HasDefaultLayout()) {","     odsPrinter << \", layout = \";","     odsPrinter.printStrippedAttrOrType(getLayoutAttr());","   }"],"additions":172,"deletions":80,"truncated":false},{"path":"third_party/xla/xla/python/ifrt/ir/ifrt_dialect.h","lines":["@@ -16,7 +16,10 @@ limitations under the License."," #ifndef XLA_PYTHON_IFRT_IR_IFRT_DIALECT_H_"," #define XLA_PYTHON_IFRT_IR_IFRT_DIALECT_H_"," ","+#include \"llvm/ADT/STLFunctionalExtras.h\"","+#include \"mlir/IR/Diagnostics.h\""," #include \"mlir/IR/Dialect.h\"","+#include \"mlir/IR/MLIRContext.h\""," #include \"mlir/IR/Operation.h\""," #include \"mlir/IR/Value.h\""," #include \"mlir/Support/LogicalResult.h\""],"additions":3,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/python/ifrt/ir/ifrt_dialect.td","lines":["@@ -168,45 +168,38 @@ def Ifrt_ArrayType : TypeDef<Ifrt_Dialect, \"IfrtArray\"> {","   let summary = [{","     An Ifrt array sharded on a set of devices."," ","-    Both memory_kind and layout are optional. When memory_kind is not specified,","-    the device default memory kind is used. The layout has the following","-    semantics:","-    - attribute is not set: the layout is inherited from the input arrays.","-    - set to \"default\": the device default layout is used.","-    - set to \"auto\": the layout will be determined by the compiler. It is only","-      allowed on arrays that are input of a `ifrt.Call`,","-      `ifrt.CallLoadedExecutable`, or `ifrt.LoadedExecutableOp` op.","-    - set to user-specified custom layout.","+    Both `memory_kind` and `layout` are optional in assembly syntax and are","+    canonicalized on construction to non-null, untyped `mlir::StringAttr`","+    values:","+    - `memory_kind`: defaults to the IFRT default memory kind (`\"device\"`) when","+      omitted. Empty strings are rejected.","+    - `layout`: defaults to `\"default\"` (device default layout) when omitted.","+      Allowed values are:","+      - `\"default\"`: the device default layout is used.","+      - `\"auto\"`: the layout will be determined by the compiler. It is only","+        allowed on arrays that are input or output of an `ifrt.Call`,","+        `ifrt.CallLoadedExecutable`, or `ifrt.LoadedExecutable` op.","+      - A canonical user-specified XLA layout string with zero","+        `dynamic_shape_metadata_prefix_bytes` (e.g., `\"{0,1}\"`; non-canonical","+        spellings such as `\"{0, 1}\"` or `\"{0,1:S(0)}\"` are rejected).","   }];"," ","   let parameters = (ins","     \"::mlir::RankedTensorType\":$shape,","     \"::xla::ifrt::IfrtShardingAttrInterface\":$sharding_attr,","     Ifrt_DevicesAttr:$devices_attr,","-    OptionalParameter<\"::mlir::StringAttr\">:$memory_kind_attr,","-    OptionalParameter<\"::mlir::StringAttr\">:$layout_attr);","+    \"::mlir::StringAttr\":$memory_kind_attr,","+    \"::mlir::StringAttr\":$layout_attr);","+","+  let skipDefaultBuilders = 1;"," ","   let builders = [","-    // Constructs an array with unspecified sharding.","-    TypeBuilder<(ins","-      \"::mlir::RankedTensorType\":$shape,","-      \"::xla::ifrt::IfrtDevicesAttr\":$devices_attr,","-      \"::mlir::StringAttr\":$memory_kind_attr,","-      \"::mlir::StringAttr\":$layout_attr), [{","-        return Base::get(","-          $_ctxt, shape, ::xla::ifrt::IfrtUnspecifiedShardingAttr::get($_ctxt),","-          devices_attr, memory_kind_attr, layout_attr);","-      }]>,","     TypeBuilder<(ins","       \"::mlir::RankedTensorType\":$shape,","-      \"::xla::ifrt::IfrtShardingParamAttr\":$sharding_attr,","+      \"::xla::ifrt::IfrtShardingAttrInterface\":$sharding_attr,","       \"::xla::ifrt::IfrtDevicesAttr\":$devices_attr,","       \"::mlir::StringAttr\":$memory_kind_attr,","-      \"::mlir::StringAttr\":$layout_attr), [{","-        return Base::get(","-          $_ctxt, shape, sharding_attr, devices_attr, memory_kind_attr,","-          layout_attr);","-      }]>","+      \"::mlir::StringAttr\":$layout_attr)>","   ];"," ","   let hasCustomAssemblyFormat = 1;","@@ -214,18 +207,40 @@ def Ifrt_ArrayType : TypeDef<Ifrt_Dialect, \"IfrtArray\"> {","   let genVerifyDecl = 1;"," ","   let extraClassDeclaration = [{","+    // Forwards `getChecked` calls with convertible argument types (e.g.,","+    // `nullptr` or concrete `IfrtShardingAttrInterface` subclasses) through","+    // canonicalization instead of `Base::getChecked`. Uses","+    // copy-list-initialization so explicit constructors such as","+    // `Interface(mlir::Attribute)` are rejected at compile time.","+    template <typename ShapeT, typename ShardingT, typename DevicesT,","+              typename MemoryKindT, typename LayoutT>","+    static IfrtArrayType getChecked(","+        ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError,","+        ::mlir::MLIRContext* context, ShapeT shape, ShardingT sharding_attr,","+        DevicesT devices_attr, MemoryKindT memory_kind_attr,","+        LayoutT layout_attr) {","+      return getChecked(emitError, context, {shape}, {sharding_attr},","+                        {devices_attr}, {memory_kind_attr}, {layout_attr});","+    }","     // Get logical device ids from `devices_attr`.","     ::llvm::ArrayRef<int> getDevices() const;","     // Get the memory kind from `memory_kind_attr`.","     ::xla::ifrt::MemoryKind MemoryKind() const;","-    // Get the layout mode from `layout_attr`. Returns default layout mode if","-    // the layout attribute is not set.","+    // Get the layout mode from `layout_attr`.","     ::xla::LayoutMode LayoutMode() const;"],"additions":36,"deletions":29,"truncated":false}],"additions":324,"deletions":125,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-24T20:29:33.173069+00:00"}