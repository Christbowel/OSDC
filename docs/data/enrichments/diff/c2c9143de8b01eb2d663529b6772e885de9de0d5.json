rt failure even though the version actually landed (e.g. a","@@ -247,7 +245,7 @@ export async function publishSinglePackage(","     return {","       name: pkg.name,","       success: false,","-      details: `pnpm publish failed for ${pkg.name} (exit code ${retryExitCode})`,","+      details: `pnpm publish failed for ${pkg.name} (exit code ${lastExitCode})`,","     }","   } catch (err: unknown) {","     console.error(err)"],"additions":22,"deletions":24,"truncated":false},{"path":"tools/releaser/src/lib/listReleaseTags.ts","lines":["@@ -0,0 +1,10 @@","+import { execFileSync } from 'child_process'","+","+import { pinnedMajorTagGlob } from './pinnedMajor.js'","+","+/** Lists local git tags on the pinned major, e.g. `v4.*`. */","+export const listReleaseTags = (): string[] =>","+  execFileSync('git', ['tag', '--list', pinnedMajorTagGlob], { encoding: 'utf8' })","+    .split('\\n')","+    .map((line) => line.trim())","+    .filter(Boolean)"],"additions":10,"deletions":0,"truncated":false},{"path":"tools/releaser/src/lib/publishSinglePackage.spec.ts","lines":["@@ -87,6 +87,20 @@ describe('publishSinglePackage idempotency + retry', () => {","     expect(spawn).toHaveBeenCalledTimes(1)","   })"," ","+  it('should treat an \"already published\" conflict on the retry as success', async () => {","+    vi.mocked(isVersionPublished).mockResolvedValue(false)","+    vi.mocked(spawn)","+      .mockImplementationOnce(() => spawnExiting(1) as never)","+      .mockImplementationOnce(","+        () => spawnExiting(1, 'npm error code EPUBLISHCONFLICT\\ncannot publish over') as never,","+      )","+","+    const result = await publishSinglePackage(pkg, { tag: 'canary' })","+","+    expect(result).toEqual({ name: 'payload', success: true })","+    expect(spawn).toHaveBeenCalledTimes(2)","+  })","+","   it('should treat a landed-despite-error version as success after a failed retry', async () => {","     vi.mocked(isVersionPublished).mockResolvedValueOnce(false).mockResolvedValueOnce(true)","     vi.mocked(spawn)"],"additions":14,"deletions":0,"truncated":false},{"path":"tools/releaser/src/lib/pushWithRebaseRetry.ts","lines":["@@ -1,8 +1,3 @@","-const isNonFastForward = (err: unknown): boolean => {","-  const message = err instanceof Error ? err.message : String(err)","-  return /non-fast-forward|fetch first/i.test(message)","-}","-"," /**","  * Pushes HEAD:main and the release tag atomically. If main moved underneath us","  * (a merge raced the push), rebase onto the new main, recreate the tag at the","@@ -51,3 +46,8 @@ export const pushWithRebaseRetry = async ({","     }","   }"," }","+","+const isNonFastForward = (err: unknown): boolean => {","+  const message = err instanceof Error ? err.message : String(err)","+  return /non-fast-forward|fetch first/i.test(message)","+}"],"additions":5,"deletions":5,"truncated":false},{"path":"tools/releaser/src/lib/runCommand.spec.ts","lines":["@@ -0,0 +1,61 @@","+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'","+","+import { pushWithRebaseRetry } from './pushWithRebaseRetry.js'","+import { runCommand } from './runCommand.js'","+","+const rejection = '! [rejected]        HEAD -> main (fetch first)'","+// The rejection text comes from the environment so it is never part of the command string.","+const failWithRejectionCmd = 'echo \"$FAKE_GIT_STDERR\" >&2; exit 1'","+","+describe('runCommand', () => {","+  beforeEach(() => {","+    vi.stubEnv('FAKE_GIT_STDERR', rejection)","+    vi.spyOn(process.stderr, 'write').mockImplementation(() => true)","+  })","+","+  afterEach(() => {","+    vi.unstubAllEnvs()","+    vi.restoreAllMocks()","+  })","+","+  it('should include stderr in the error when the command fails', () => {","+    expect(() => runCommand({ cmd: failWithRejectionCmd, cwd: process.cwd() })).toThrow(","+      /fetch first/,","+    )","+  })","+","+  it('should print stderr', () => {","+    expect(() => runCommand({ cmd: failWithRejectionCmd, cwd: process.cwd() })).toThrow()","+","+    expect(process.stderr.write).toHaveBeenCalledWith(expect.stringContaining(rejection))","+  })","+","+  it('should not throw when the command succeeds', () => {","+    expect(() => runCommand({ cmd: 'exit 0', cwd: process.cwd() })).not.toThrow()","+  })","+","+  it('should not throw when a successful command writes to stderr', () => {","+    expect(() =>","+      runCommand({ cmd: 'echo \"$FAKE_GIT_STDERR\" >&2; exit 0', cwd: process.cwd() }),","+    ).not.toThrow()","+    expect(process.stderr.write).toHaveBeenCalledWith(expect.stringContaining(rejection))","+  })","+","+  it('should let pushWithRebaseRetry rebase after a real rejected push', async () => {","+    let pushAttempts = 0","+    const run = vi.fn((cmd: string) => {","+      if (cmd.startsWith('git push') && pushAttempts++ === 0) {","+        runCommand({ cmd: failWithRejectionCmd, cwd: process.cwd() })","+      }","+    })","+","+    await pushWithRebaseRetry({ log: () => {}, run, tag: 'v4.0.0-beta.3' })","+","+    expect(run.mock.calls.map(([cmd]) => cmd)).toEqual([","+      'git push --atomic origin HEAD:main refs/tags/v4.0.0-beta.3',","+      'git pull --rebase origin main',","+      'git tag -f -a v4.0.0-beta.3 -m v4.0.0-beta.3',","+      'git push --atomic origin HEAD:main refs/tags/v4.0.0-beta.3',","+    ])","+  })","+})"],"additions":61,"deletions":0,"truncated":false},{"path":"tools/releaser/src/lib/runCommand.ts","lines":["@@ -0,0 +1,23 @@","+import { spawnSync } from 'child_process'","+","+/**","+ * Runs a shell command with stdout streamed live. Stderr is captured, printed, and included in the","+ * thrown error, so callers can classify a failure by its text, such as a rejected git push.","+ */","+export const runCommand = ({ cmd, cwd }: { cmd: string; cwd: string }): void => {","+  const result = spawnSync(cmd, {","+    cwd,","+    encoding: 'utf8',","+    shell: true,","+    stdio: ['inherit', 'inherit', 'pipe'],","+  })","+  if (result.stderr) {","+    process.stderr.write(result.stderr)","+  }","+  if (result.error) {","+    throw result.error","+  }","+  if (result.status !== 0) {","+    throw new Error(`Command failed: ${cmd}\\n${result.stderr}`)","+  }","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"tools/releaser/src/lib/runPublishSequence.ts","lines":["@@ -6,21 +6,6 @@ export type PublishResult = {","   success: boolean"," }"," ","-const printSummary = (results: PublishResult[]): void => {","-  console.log(`\\n\\nResults:\\n`)","-  console.log(","-    results","-      .map((result) => {","-        if (!result.success) {","-          console.error(result.details)","-          return `  ❌ ${result.name}`","-        }","-        return `  ✅ ${result.name}`","-      })","-      .join('\\n') + '\\n',","-  )","-}","-"," /**","  * Publishes packages sequentially and stops at the first failure (fail-fast).","  * Combined with a topological publish order, a partial publish always leaves a","@@ -52,3 +37,18 @@ export const runPublishSequence = async ({","   printSummary(results)","   return results"," }","+","+const printSummary = (results: PublishResult[]): void => {","+  console.log(`\\n\\nResults:\\n`)","+  console.log(","+    results","+      .map((result) => {","+        if (!result.success) {","+          console.error(result.details)","+          return `  ❌ ${result.name}`","+        }","+        return `  ✅ ${result.name}`","+      })","+      .join('\\n') + '\\n',","+  )","+}"],"additions":15,"deletions":15,"truncated":false},{"path":"tools/releaser/src/lib/workspacePublishOrder.spec.ts","lines":["@@ -0,0 +1,58 @@","+import { EventEmitter } from 'node:events'","+import { beforeEach, describe, expect, it, vi } from 'vitest'","+","+vi.mock('child_process', () => ({ execSync: vi.fn(), spawn: vi.fn() }))","+vi.mock('./getPackageRegistryVersions.js', () => ({","+  isVersionPublished: vi.fn(),","+}))","+vi.mock('globby', () => ({ default: vi.fn() }))","+vi.mock('fs-extra', () => ({ default: { readJson: vi.fn() } }))","+","+import { spawn } from 'child_process'","+import fse from 'fs-extra'","+import globby from 'globby'","+","+import { isVersionPublished } from './getPackageRegistryVersions.js'","+import { getWorkspace } from './getWorkspace.js'","+import { packagePublishList } from './publishList.js'","+","+const spawnExiting = (exitCode: number) => {","+  const child = Object.assign(new EventEmitter(), {","+    stderr: new EventEmitter(),","+    stdout: new EventEmitter(),","+  })","+  queueMicrotask(() => child.emit('close', exitCode))","+  return child","+}","+","+const spawnedPaths = () =>","+  vi.mocked(spawn).mock.calls.map(([, args]) => args[args.indexOf('-C') + 1])","+","+const nameFor = (shortName: string) =>","+  shortName === 'payload' || shortName === 'create-payload-app'","+    ? shortName","+    : `@payloadcms/${shortName}`","+","+describe('workspace.publish order', () => {","+  beforeEach(() => {","+    vi.clearAllMocks()","+    vi.spyOn(console, 'log').mockImplementation(() => {})","+    // Reverse alphabetical glob order, plus a package that is not on the publish list.","+    const globbed = [...packagePublishList, 'not-published'].sort().reverse()","+    vi.mocked(globby).mockResolvedValue(","+      globbed.map((shortName) => `/repo/packages/${shortName}/package.json`),","+    )","+    vi.mocked(fse.readJson).mockImplementation(async (packageJsonPath: string) => ({","+      name: nameFor(packageJsonPath.split('/').at(-2) ?? ''),","+      version: '4.0.0-beta.2',","+    }))","+    vi.mocked(isVersionPublished).mockResolvedValue(false)","+    vi.mocked(spawn).mockImplementation(() => spawnExiting(0) as never)","+  })","+","+  it('should spawn publishes in packagePublishList order for a single tag', async () => {","+    await getWorkspace().publish({ tag: 'beta' })","+","+    expect(spawnedPaths()).toEqual(packagePublishList.map((shortName) => `packages/${shortName}`))","+  })","+})"],"additions":58,"deletions":0,"truncated":false},{"path":"tools/releaser/src/lib/writeStepSummary.spec.ts","lines":["@@ -0,0 +1,31 @@","+import fs from 'fs'","+import os from 'os'","+import path from 'path'","+import { afterEach, beforeEach, describe, expect, it } from 'vitest'","+","+import { writeStepSummary } from './writeStepSummary.js'","+","+describe('writeStepSummary', () => {","+  let tempDir: string","+","+  beforeEach(() => {","+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'summary-'))","+  })","+","+  afterEach(() => {","+    fs.rmSync(tempDir, { force: true, recursive: true })","+  })","+","+  it('should append markdown to the summary file', () => {","+    const summaryPath = path.join(tempDir, 'summary.md')","+","+    writeStepSummary({ markdown: '# a', summaryPath })","+    writeStepSummary({ markdown: '# b', summaryPath })","+","+    expect(fs.readFileSync(summaryPath, 'utf8')).toBe('# a\\n# b\\n')","+  })","+","+  it('should do nothing when summaryPath is undefined', () => {","+    expect(() => writeStepSummary({ markdown: '# a', summaryPath: undefined })).not.toThrow()","+  })","+})"],"additions":31,"deletions":0,"truncated":false},{"path":"tools/releaser/src/lib/writeStepSummary.ts","lines":["@@ -0,0 +1,18 @@","+import fs from 'fs'","+","+/**","+ * Appends markdown to the GitHub Actions job summary. Outside Actions the path is","+ * unset, so this is a no-op.","+ */","+export const writeStepSummary = ({","+  markdown,","+  summaryPath,","+}: {","+  markdown: string","+  summaryPath: string | undefined","+}): void => {","+  if (!summaryPath) {","+    return","+  }","+  fs.appendFileSync(summaryPath, markdown + '\\n')","+}"],"additions":18,"deletions":0,"truncated":false},{"path":"tools/releaser/src/release-bump.spec.ts","lines":["@@ -4,6 +4,8 @@ import { runReleaseBump } from './release-bump.js'"," "," const baseDeps = () => ({","   env: { GITHUB_TOKEN: 'token' } as NodeJS.ProcessEnv,","+  findChangelogBaseTag: vi.fn(async (): Promise<string | undefined> => 'v4.0.0-beta.9'),","+  generateReleaseNotes: vi.fn(async () => ({ releaseNo