,"+/**","+ * Fetches a registry URL, retrying only network errors, 429, and 5xx with exponential","+ * backoff. Every other response is returned for the caller to interpret. When attempts","+ * run out, the last transient response is returned (so the caller throws on its status)","+ * or the last network error is rethrown, so a persistent failure is never swallowed.","+ */","+const fetchWithRetry = async ({","+  fetchImpl,","+  sleep,","+  url,","+}: {","+  fetchImpl: typeof fetch","+  sleep: (ms: number) => Promise<void>","+  url: string","+}): Promise<Response> => {","+  for (let attempt = 1; ; attempt++) {","+    const isLastAttempt = attempt === maxAttempts","+    let res: Response","+    try {","+      res = await fetchImpl(url, { signal: AbortSignal.timeout(attemptTimeoutMs) })","+    } catch (err) {","+      if (isLastAttempt) {","+        throw err","+      }","+      await sleep(baseBackoffMs * 2 ** (attempt - 1))","+      continue","+    }","+    if (!isTransientStatus(res.status) || isLastAttempt) {","+      return res","+    }","+    // Releases the pooled connection; an unread body holds it until GC","+    await res.body?.cancel()","+    await sleep(baseBackoffMs * 2 ** (attempt - 1))","+  }","+}"],"additions":54,"deletions":1,"truncated":false},{"path":"tools/releaser/src/lib/getWorkspace.ts","lines":["@@ -18,6 +18,8 @@ const cwd = PROJECT_ROOT"," "," const execaOpts: execa.Options = { stdio: 'inherit', cwd }"," ","+const publishAttempts = 2","+"," type PackageDetails = {","   /** Name in package.json / npm registry */","   name: string","@@ -208,33 +210,29 @@ export async function publishSinglePackage(","       cmdArgs.push('--dry-run')","     }"," ","-    const { exitCode, output } = await runPnpm(cmdArgs)","-","-    if (exitCode === 0) {","-      console.log(`✅ ${pkg.name} published`)","-      return { name: pkg.name, success: true }","-    }","+    let lastExitCode = 0"," ","-    // An already-published conflict means a prior run landed this versio