).DialContext(ctx, network, address)","+\t}}","+\tdefer transport.CloseIdleConnections()","+\te := echo.New()","+\te.Use(ProxyWithConfig(ProxyConfig{","+\t\tBalancer:       NewRoundRobinBalancer([]*ProxyTarget{{URL: target}}),","+\t\tTransport:      transport,","+\t\tModifyResponse: func(response *http.Response) error { modified <- response.StatusCode; return nil },","+\t}))","+\tserver := httptest.NewServer(e)","+\tdefer server.Close()","+\tconn, err := websocket.Dial(\"ws\"+server.URL[len(\"http\"):], \"\", \"http://localhost/\")","+\trequire.NoError(t, err)","+\tdefer conn.Close()","+\trequire.NoError(t, conn.SetDeadline(time.Now().Add(3*time.Second)))","+\trequire.NoError(t, websocket.Message.Send(conn, \"hello\"))","+\tvar message string","+\trequire.NoError(t, websocket.Message.Receive(conn, &message))","+\trequire.Equal(t, \"hello\", message)","+\trequire.Positive(t, dials.Load())","+\tselect {","+\tcase status := <-modified:","+\t\trequire.Equal(t, http.StatusSwitchingProtocols, status)","+\tcase <-time.After(3 * time.Second):","+\t\tt.Fatal(\"ModifyResponse was not called for the upgrade\")","+\t}","+}",""],"additions":257,"deletions":0,"truncated":false}],"additions":605,"deletions":95,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-10-24T12:58:25.612307+00:00"}