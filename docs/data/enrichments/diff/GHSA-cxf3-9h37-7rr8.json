oContent(http.StatusOK)","+\t\t\t\t})","+\t\t\t\treq := httptest.NewRequest(http.MethodPost, \"/\", strings.NewReader(\"ABCDEFGH\"))","+\t\t\t\tif !knownLength {","+\t\t\t\t\treq.ContentLength = -1","+\t\t\t\t\treq.TransferEncoding = []string{\"chunked\"}","+\t\t\t\t}","+\t\t\t\trec := httptest.NewRecorder()","+\t\t\t\te.ServeHTTP(rec, req)","+\t\t\t\trequire.Equal(t, http.StatusRequestEntityTooLarge, rec.Code)","+\t\t\t\trequire.False(t, accepted)","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestBodyDumpPreservesBodyLimitChunkedHTTP(t *testing.T) {","+\te := echo.New()","+\te.Use(BodyLimit(5), BodyDumpWithConfig(BodyDumpConfig{MaxRequestBytes: 4, Handler: func(*echo.Context, []byte, []byte, error) {}}))","+\te.POST(\"/\", func(c *echo.Context) error {","+\t\tbody, err := io.ReadAll(c.Request().Body)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\treturn c.String(http.StatusOK, string(body))","+\t})","+\tserver := httptest.NewServer(e)","+\tdefer server.Close()","+\treq, err := http.NewRequest(http.MethodPost, server.URL, io.NopCloser(strings.NewReader(\"ABCDEFGH\")))","+\trequire.NoError(t, err)","+\treq.TransferEncoding = []string{\"chunked\"}","+\tresponse, err := server.Client().Do(req)","+\trequire.NoError(t, err)","+\tdefer response.Body.Close()","+\trequire.Equal(t, http.StatusRequestEntityTooLarge, response.StatusCode)","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"middleware/body_dump_test.go","lines":["@@ -4,12 +4,16 @@"," package middleware"," "," import (","+\t\"bytes\""," \t\"errors\"","+\t\"fmt\""," \t\"io\""," \t\"net/http\""," \t\"net/http/httptest\""," \t\"strings\"","+\t\"sync\""," \t\"testing\"","+\t\"testing/iotest\""," "," \t\"github.com/labstack/echo/v5\""," \t\"github.com/stretchr/testify/assert\"","@@ -280,8 +284,8 @@ func TestBodyDump_RequestExceedsLimit(t *testing.T) {"," \tassert.NoError(t, err)"," \tassert.Equal(t, int(limit), len(requestBodyDumped), \"Dumped request should be truncated to limit\")"," \tassert.