})","+\t\t\tserver := httptest.NewServer(e)","+\t\t\tt.Cleanup(server.Close)","+\t\t\tconn, err := net.Dial(\"tcp\", server.Listener.Addr().String())","+\t\t\trequire.NoError(t, err)","+\t\t\tt.Cleanup(func() { _ = conn.Close() })","+\t\t\trequire.NoError(t, conn.SetDeadline(time.Now().Add(3*time.Second)))","+\t\t\t_, err = fmt.Fprint(conn, \"GET /gateway HTTP/1.1\\r\\nHost: example.com\\r\\nConnection: Upgrade\\r\\nUpgrade: websocket\\r\\n\\r\\n\")","+\t\t\trequire.NoError(t, err)","+\t\t\treader := bufio.NewReader(conn)","+\t\t\tresponse, err := http.ReadResponse(reader, nil)","+\t\t\trequire.NoError(t, err)","+\t\t\tbody, err := io.ReadAll(response.Body)","+\t\t\trequire.NoError(t, response.Body.Close())","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, status, response.StatusCode)","+\t\t\trequire.Equal(t, \"upgrade declined\", string(body))","+\t\t\t_, err = fmt.Fprint(conn, \"GET /admin HTTP/1.1\\r\\nHost: example.com\\r\\nConnection: close\\r\\n\\r\\n\")","+\t\t\trequire.NoError(t, err)","+\t\t\tresponse, err = http.ReadResponse(reader, nil)","+\t\t\trequire.NoError(t, err)","+\t\t\t_, err = io.Copy(io.Discard, response.Body)","+\t\t\trequire.NoError(t, response.Body.Close())","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, http.StatusForbidden, response.StatusCode)","+\t\t\trequire.Zero(t, adminCalls.Load(), \"later requests must return through Echo's route guards\")","+\t\t})","+\t}","+}","+","+func TestProxyUpgradeClosesBothConnections(t *testing.T) {","+\tfor _, disconnect := range []string{\"client\", \"upstream\", \"client_upstream_ignores_eof\"} {","+\t\tt.Run(disconnect, func(t *testing.T) {","+\t\t\tbackendConn := make(chan net.Conn, 1)","+\t\t\tbackendReturned := make(chan struct{})","+\t\t\tbackendReadEOF := make(chan struct{})","+\t\t\tbackendRelease := make(chan struct{})","+\t\t\tupstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\t\t\tdefer close(backendReturned)","+\t\t\t\tconn, rw, err := http.NewResponseController(w).Hijack()","+\t\t\t\tif err != nil {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tdefer conn.Close()","+\t\t\t\tbackendConn <- conn","+\t\t\t\t_, _ = fmt.Fprint(rw, \"HTTP/1.1 101 Switching Protocols\\r\\nConnection: Upgrade\\r\\nUpgrade: websocket\\r\\n\\r\\n\")","+\t\t\t\tif rw.Flush() != nil {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tmessage := make([]byte, 4)","+\t\t\t\tif _, err := io.ReadFull(rw, message); err != nil {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\tif string(message) != \"ping\" {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t\t_, _ = conn.Write([]byte(\"pong\"))","+\t\t\t\t_, _ = io.Copy(io.Discard, rw)","+\t\t\t\tclose(backendReadEOF)","+\t\t\t\tif disconnect == \"client_upstream_ignores_eof\" {","+\t\t\t\t\t// Some upstreams retain the connection after receiving EOF.","+\t\t\t\t\t// The proxy must finish without waiting for them to close it.","+\t\t\t\t\t<-backendRelease","+\t\t\t\t}","+\t\t\t}))","+\t\t\tt.Cleanup(upstream.Close)","+\t\t\tt.Cleanup(func() { close(backendRelease) })","+\t\t\ttarget, err := url.Parse(upstream.URL)","+\t\t\trequire.NoError(t, err)","+\t\t\ttarget.Scheme = \"ws\"","+\t\t\te := echo.New()","+\t\t\tproxyReturned := make(chan struct{})","+\t\t\te.Use(func(next echo.HandlerFunc) echo.HandlerFunc {","+\t\t\t\treturn func(c *echo.Context) error { defer close(proxyReturned); return next(c) }","+\t\t\t})","+\t\t\te.Use(Proxy(NewRoundRobinBalancer([]*ProxyTarget{{URL: target}})))","+\t\t\tserver := httptest.NewServer(e)","+\t\t\tt.Cleanup(server.Close)","+\t\t\tconn, err := net.Dial(\"tcp\", server.Listener.Addr().String())","+\t\t\trequire.NoError(t, err)","+\t\t\tt.Cleanup(func() { _ = conn.Close() })","+\t\t\trequire.NoError(t, conn.SetDeadline(time.Now().Add(3*time.Second)))","+\t\t\t_, err = fmt.Fprint(conn, \"GET / HTTP/1.1\\r\\nHost: example.com\\r\\nConnection: Upgrade\\r\\nUpgrade: websocket\\r\\n\\r\\n\")","+\t\t\trequire.NoError(t, err)","+\t\t\tvar backend net.Conn","+\