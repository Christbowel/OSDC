{"id":"1649093c395cc64741fa7a95cb34386f62b1ad6b","axis":"silent","repo":"modal-labs/modal-client","sha":"1649093c395cc64741fa7a95cb34386f62b1ad6b","parsed":{"files":[{"path":"CHANGELOG_DEV.md","lines":["@@ -10,6 +10,7 @@ Draft releases notes should be added as part of the PR introducing the change. D"," - Fixed `modal.Image.from_dockerfile(..., force_build=True)` to rebuild the Dockerfile's own steps instead of reusing them from the cache."," - Added an `App.stop()` method."," - Added a `--set-image-builder-version` option to `modal environment update` for overriding the image builder version of a single Environment, and an image builder version column to `modal environment list`.","+- Added implicit OAuth refresh token authentication through the `MODAL_OAUTH_REFRESH_TOKEN`, `MODAL_OAUTH_CLIENT_ID`, and either `MODAL_OAUTH_CLIENT_SECRET` or `MODAL_OAUTH_JWT_KEY` environment variables, with [`modal.Client.from_oauth_credentials()`](/docs/sdk/py/latest/Client#from_oauth_credentials) available for explicitly constructed clients. RSA private keys require the `modal[oauth]` extra."," "," ## JS"," "],"additions":1,"deletions":0,"truncated":false},{"path":"py/modal/_utils/grpc_utils.py","lines":["@@ -9,7 +9,7 @@"," import typing"," import urllib.parse"," import uuid","-from collections.abc import AsyncIterator, Sequence","+from collections.abc import AsyncIterator, Callable, Mapping, Sequence"," from dataclasses import dataclass, field"," from functools import cache"," from typing import Any, Optional, TypeVar, Union","@@ -42,6 +42,7 @@"," "," RequestType = TypeVar(\"RequestType\", bound=Message)"," ResponseType = TypeVar(\"ResponseType\", bound=Message)","+MetadataProvider = Callable[[], Mapping[str, str]]"," "," if typing.TYPE_CHECKING:","     import modal._grpc_client","@@ -224,17 +225,29 @@ class ConnectionManager:","     should share the same connection.","     \"\"\""," ","-    def __init__(self, client: \"modal.client._Client\", metadata: dict[str, str] = {}):","+    def __init__(","+        self,","+        client: \"modal.client._Client\",","+        metadata: dict[str, str] = {},","+        metadata_provider: MetadataProvider | None = None,","+    ):","         self._client = client","         # This metadata is injected into all requests on all channels created by this manager.","         self._metadata = metadata","+        self._metadata_provider = metadata_provider","         self._channels: dict[str, asyncio.Future[grpclib.client.Channel]] = {}"," ","     async def get_or_create_channel(self, server_url: str) -> grpclib.client.Channel:","         fut = self._channels.get(server_url)","         if fut is None or (fut.done() and (fut.cancelled() or fut.exception() is not None)):","             # Cache the attempt rather than the channel, so callers racing to connect share one.","-            fut = asyncio.ensure_future(create_channel_with_fallbacks(server_url, self._metadata))","+            fut = asyncio.ensure_future(","+                create_channel_with_fallbacks(","+                    server_url,","+                    self._metadata,","+                    metadata_provider=self._metadata_provider,","+                )","+            )","             self._channels[server_url] = fut","         # Shielded so one caller giving up doesn't cancel the connection for the others.","         return await asyncio.shield(fut)","@@ -357,6 +370,7 @@ async def recv_trailing_metadata(event: grpclib.events.RecvTrailingMetadata) ->"," def create_channel(","     server_url: str,","     metadata: dict[str, str] = {},","+    metadata_provider: MetadataProvider | None = None,"," ) -> grpclib.client.Channel:","     \"\"\"Creates a grpclib.Channel to be used by a GRPC stub."," ","@@ -387,6 +401,10 @@ def create_channel(","     async def send_request(event: grpclib.events.SendRequest) -> None:","         for k, v in metadata.items():","             event.metadata[k] = v","+        if metadata_provider is not None:","+            provided_metadata = await asyncio.to_thread(metadata_provider)","+            for k, v in provided_metadata.items():","+                event.metadata[k] = v"," ","         if o.hostname is not None:","             # GRPC actually injects a :authority pseudo-header containing the hostname.","@@ -412,6 +430,7 @@ async def create_channel_with_fallbacks(","     server_url: str,","     metadata: dict[str, str] = {},","     stagger_delay: float = 3.0,","+    metadata_provider: MetadataProvider | None = None,"," ) -> grpclib.client.Channel:","     \"\"\"Create a connected channel, supporting comma-separated fallback URLs."," ","@@ -440,7 +459,7 @@ async def connect(index: int, url: str) -> grpclib.client.Channel:","                 await asyncio.wait_for(failed[index - 1].wait(), timeout=index * stagger_delay)","             except asyncio.TimeoutError:","                 pass","-        channel = create_channel(url, metadata)","+        channel = create_channel(url, metadata, metadata_provider)","         try:","             await channel.__connect__()","         except BaseException:"],"additions":23,"deletions":4,"truncated":false},{"path":"py/modal/_utils/oauth.py","lines":["@@ -0,0 +1,66 @@","+# Copyright Modal Labs 2026","+import base64","+import hashlib","+import json","+import time","+import uuid","+from collections.abc import Mapping","+from typing import Any","+","+from modal.exception import InvalidError","+","+_OAUTH_CLIENT_ASSERTION_AUDIENCE = \"modal-server\"","+_OAUTH_CLIENT_ASSERTION_LIFETIME_SECONDS = 5 * 60","+_MIN_RSA_KEY_SIZE = 2048","+","+","+class OAuthAssertionProvider:","+    \"\"\"Mint short-lived private_key_jwt assertions for OAuth client authentication.\"\"\"","+","+    def __init__(self, client_id: str, private_key_pem: str):","+        try:","+            import jwt","+            from cryptography.hazmat.primitives.asymmetric.rsa import RSAPrivateKey","+            from jwt.algorithms import RSAAlgorithm","+            from jwt.exceptions import InvalidKeyError","+        except ImportError:","+            raise ImportError(","+                \"Private-key OAuth authentication requires the 'oauth' extra. \"","+                \"Install it with `pip install 'modal[oauth]'`.\"","+            ) from None","+","+        private_key_pem = private_key_pem.replace(\"\\\\n\", \"\\n\")","+        try:","+            private_key = RSAAlgorithm(RSAAlgorithm.SHA256).prepare_key(private_key_pem)","+        except (TypeError, InvalidKeyError):","+            raise InvalidError(\"oauth_jwt_key must be an unencrypted RSA private key encoded as PEM.\") from None","+        if not isinstance(private_key, RSAPrivateKey):","+            raise InvalidError(\"oauth_jwt_key must be an RSA private key.\")","+        if private_key.key_size < _MIN_RSA_KEY_SIZE:","+            raise InvalidError(\"oauth_jwt_key must be at least 2048 bits.\")","+","+        public_jwk: dict[str, Any] = RSAAlgorithm.to_jwk(private_key.public_key(), as_dict=True)","+        thumbprint_jwk = {field: public_jwk[field] for field in (\"e\", \"kty\", \"n\")}","+        canonical_jwk = json.dumps(thumbprint_jwk, sort_keys=True, separators=(\",\", \":\")).encode()","+","+        self._client_id = client_id","+        self._private_key = private_key","+        self._kid = base64.urlsafe_b64encode(hashlib.sha256(canonical_jwk).digest()).rstrip(b\"=\").decode()","+        self._jwt = jwt","+","+    def __call__(self) -> Mapping[str, str]:","+        issued_at = int(time.time())","+        assertion = self._jwt.encode(","+            {","+                \"iss\": self._client_id,","+                \"sub\": self._client_id,","+                \"aud\": _OAUTH_CLIENT_ASSERTION_AUDIENCE,","+                \"iat\": issued_at,","+                \"exp\": issued_at + _OAUTH_CLIENT_ASSERTION_LIFETIME_SECONDS,","+                \"jti\": str(uuid.uuid4()),","+            },","+            self._private_key,","+            algorithm=\"RS256\",","+            headers={\"kid\": self._kid},","+        )","+        return {\"x-modal-oauth-client-assertion\": assertion}"],"additions":66,"deletions":0,"truncated":false},{"path":"py/modal/cli/config.py","lines":["@@ -33,6 +33,8 @@ def show(redact: bool, include_internal: bool, json: bool):","         config_dict[\"oauth_refresh_token\"] = \"***\"","     if redact and config_dict.get(\"oauth_client_secret\"):","         config_dict[\"oauth_client_secret\"] = \"***\"","+    if redact and config_dict.get(\"oauth_jwt_key\"):","+        config_dict[\"oauth_jwt_key\"] = \"***\""," ","     # Accept --json as a no-op for consistency; we may change the default formatting later","     OutputManager.get().print_json(dumps(config_dict))"],"additions":2,"deletions":0,"truncated":false},{"path":"py/modal/cli/profile.py","lines":["@@ -67,6 +67,7 @@ async def list_(json: bool | None = False):","         \"MODAL_OAUTH_REFRESH_TOKEN\",","         \"MODAL_OAUTH_CLIENT_ID\",","         \"MODAL_OAUTH_CLIENT_SECRET\",","+        \"MODAL_OAUTH_JWT_KEY\",","     )","     if any(env_var in os.environ for env_var in credential_env_vars):","         try:"],"additions":1,"deletions":0,"truncated":false},{"path":"py/modal/cli/token.py","lines":["@@ -36,6 +36,7 @@ async def info():","         \"MODAL_OAUTH_REFRESH_TOKEN\",","         \"MODAL_OAUTH_CLIENT_ID\",","         \"MODAL_OAUTH_CLIENT_SECRET\",","+        \"MODAL_OAUTH_JWT_KEY\",","     ):","         if os.environ.get(env_var):","             env_vars.append(env_var)"],"additions":1,"deletions":0,"truncated":false},{"path":"py/modal/client.py","lines":["@@ -35,7 +35,8 @@"," class _OAuthCredentials:","     refresh_token: str = field(repr=False)","     client_id: str","-    client_secret: str = field(repr=False)","+    client_secret: str | None = field(default=None, repr=False)","+    jwt_key: str | None = field(default=None, repr=False)"," "," "," def _get_metadata(","@@ -75,9 +76,10 @@ def _get_metadata(","             {","                 \"x-modal-refresh-tok