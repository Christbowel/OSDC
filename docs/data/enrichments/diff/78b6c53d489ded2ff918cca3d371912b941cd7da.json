String>,","+}","+","+/// Per-class signal facts indexed on [`crate::types::analysis::FileData`] so Stage 2 can walk","+/// `extends` chains across source and `.d.ts` files, including undecorated base classes.","+#[derive(Clone, Debug)]","+pub struct ClassSignalFacts {","+    pub reference_id: ReferenceId,","+    pub class_name: String,","+    pub own: OwnSignalFacts,","+    pub super_class: Option<DeclarationTuple>,","+}","+","+pub(crate) fn ts_class_signal_facts(","+    class: &Class<'_>,","+    reference_id: ReferenceId,","+    own: OwnSignalFacts,","+    super_class: Option<DeclarationTuple>,","+) -> Option<ClassSignalFacts> {","+    let class_name = class.id.as_ref()?.name.to_string();","+    Some(ClassSignalFacts {","+        reference_id,","+        class_name,","+        own,","+        super_class,","+    })","+}","+","+pub(crate) fn dts_class_signal_facts<'a>(","+    class: &Class<'a>,","+    reference_id: ReferenceId,","+    semantic: &Semantic<'a>,","+    import_map: &HashMap<String, ImportedSymbol>,","+    super_class: Option<DeclarationTuple>,","+    signal_input_names: impl IntoIterator<Item = &'a str>,","+) -> (OwnSignalFacts, Option<ClassSignalFacts>) {","+    let mut own = extract_own_signal_facts(class, semantic, import_map, false, true);","+    for name in signal_input_names {","+        if !name.is_empty() && !name.contains('.') {","+            own.declared_members.insert(name.to_string());","+            push_unique(&mut own.signal_members, name.to_string());","+        }","+    }","+    let class_facts = class.id.as_ref().map(|id| ClassSignalFacts {","+        reference_id,","+        class_name: id.name.to_string(),","+        own: own.clone(),","+        super_class,","+    });","+    (own, class_facts)","+}","+","+pub(crate) fn index_signal_facts(","+    facts: Vec<ClassSignalFacts>,","+) -> HashMap<String, ClassSignalFacts> {","+    facts","+        .into_iter()","+        .map(|facts| (facts.class_name.clone(), facts))","+        .collect()","+}","+","+#[derive(Default)]","+struct OwnExtractState {","+    own: OwnSignalFacts,","+    /// Signal member paths rooted at an ECMAScript private field (`#count`, `#state.count`),","+    /// stored without the leading `#`. Tracked only to resolve `this.#foo.asReadonly()` on the","+    /// same class; never exposed on `OwnSignalFacts` since private fields cannot be read in","+    /// templates or inherited.","+    private_signals: Vec<String>,","+    /// Members (`(name, is_private)`) with an explicit non-signal type annotation (such as a","+    /// nullable union `Signal<string> | null`), preventing constructor assignments from treating","+    /// them as non-nullable signals.","+    explicit_non_signals: HashSet<(String, bool)>,","+    /// Deferred `this.<path>.asReadonly()` / `this.#<path>.asReadonly()` aliases whose source","+    /// member had not yet been recorded when visited.","+    pending_readonly: Vec<PendingReadonly>,","+}","+","+struct PendingReadonly {","+    target: String,","+    target_is_private: bool,","+    declare_root_on_resolve: bool,","+    source: String,","+    source_is_private: bool,","+}","+","+impl OwnExtractState {","+    fn has_signal(&self, path: &str, is_private: bool) -> bool {","+        if is_private {","+            self.private_signals.iter().any(|s| s == path)","+        } else {","+            self.own.signal_members.iter().any(|s| s == path)","+        }","+    }","+","+    fn record_signal(&mut self, path: String, is_private: bool, declare_root: bool) {","+        if is_private {","+            push_unique(&mut self.private_signals, path);","+        } else {","+            if declare_root {","+                if let Some(root) = path.split('.').next() {","+                    self.own.declared_members.insert(root.to_string());","+                }","+            }","+            push_unique(&mut self.own.signal_members, path);","+        }","+    }","+","+    fn resolve_pending_readonly(&mut self) {","+        let Self {","+            own,","+            private_signals,","+            pending_readonly,","+            ..","+        } = self;","+        loop {","+            let mut progressed = false;","+            pending_readonly.retain(|item| {","+                let is_known = if item.source_is_private {","+                    private_signals.iter().any(|s| s == &item.source)","+                } else {","+                    own.signal_members.iter().any(|s| s == &item.source)","+                };","+                if !is_known {","+                    return true;","+                }","+                if item.target_is_private {","+                    push_unique(private_signals, item.target.clone());","+                } else {","+                    if item.declare_root_on_resolve {","+                        if let Some(root) = item.target.split('.').next() {","+                            own.declared_members.insert(root.to_string());","+                        }","+                    }","+                    push_unique(&mut own.signal_members, item.target.clone());","+                }","+                progressed = true;","+                false","+            });","+            if !progressed {","+                break;","+            }","+        }","+    }","+}","+","+/// Extract signal members and declared root member names from `class`'s own body.","+pub(crate) fn extract_own_signal_facts<'a>(","+    class: &Class<'a>,","+    semantic: &Semantic<'a>,","+    import_map: &HashMap<String, ImportedSymbol>,","+    is_core: bool,","+    in_declaration_file: bool,","+) -> OwnSignalFacts {","+    let mut state = OwnExtractState::default();","+    let cx = SignalDetectCtx {","+        semantic,","+        import_map,","+        is_core,","+    };","+","+    for element in &class.body.body {","+        match element {","+            ClassElement::PropertyDefinition(prop) if !prop.r#static => {","+                cx.collect_field_signals(","+                    &