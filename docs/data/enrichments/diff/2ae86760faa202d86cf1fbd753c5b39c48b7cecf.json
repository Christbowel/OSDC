a diagram', async () => {"],"additions":40,"deletions":1,"truncated":false},{"path":"public/app/features/provisioning/components/Folders/FolderReadmePanel.tsx","lines":["@@ -19,10 +19,12 @@ import { useFolderDocs } from '../../hooks/useFolderDocs';"," import { type FolderReadmeStatus, useFolderReadme } from '../../hooks/useFolderReadme';"," import { type FolderDoc, FOLDER_DOC_TAB_PARAM, getDocTabLabel } from '../../utils/folderDocConventions';"," import { getRepoEditFileUrl, getRepoNewFileUrl } from '../../utils/git';","+import { splitFrontmatter } from '../../utils/markdownFrontmatter';"," import { RESOURCE_PATH_ATTR, rewriteRelativeMarkdownLinks } from '../../utils/markdownLinks';"," import { createGrafanaLinkResolver } from '../../utils/markdownResourceLinks';"," import { splitPath } from '../utils/path';"," ","+import { MarkdownFrontmatterTable } from './MarkdownFrontmatterTable';"," import { FolderReadmeEvents } from './analytics/main';"," "," export const FOLDER_README_ANCHOR_ID = 'folder-readme';","@@ -231,14 +233,22 @@ function RenderedMarkdown({","   const repositoryName = repository.name;","   const repositoryPath = repository.path;"," ","-  // renderMarkdown's default sanitizer strips the href of bare relative links","-  // (e.g. `dashboard.json`, `subfolder/`), leaving `<a href>` that resolves to","-  // the app root — so folder/dashboard links can't be rewritten or resolved.","-  // Render without it and rely on textUtil.sanitize below (the XSS boundary),","-  // which preserves relative links.","-  const html = renderMarkdown(markdown, { noSanitize: true });","-  const rewritten = rewriteRelativeMarkdownLinks(html, { repository, baseDirInRepo });","-  const safe = textUtil.sanitize(rewritten);","+  // The parent re-renders on every intersection change; keep marked and the","+  // sanitizer off the scroll path.","+  const { frontmatter, safe } = useMemo(() => {","+    // Front matter isn't markdown: left in, marked turns the `---` fences into an","+    // <hr> and a heading. Show it as a metadata table instead, like GitHub does.","+    const { frontmatter, body } = splitFrontmatter(markdown);","+","+    // renderMarkdown's default sanitizer strips the href of bare relative links","+    // (e.g. `dashboard.json`, `subfolder/`), leaving `<a href>` that resolves to","+    // the app root — so folder/dashboard links can't be rewritten or resolved.","+    // Render without it and rely on textUtil.sanitize (the XSS boundary), which","+    // preserves relative links.","+    const html = renderMarkdown(body, { noSanitize: true });","+    const rewritten = rewriteRelativeMarkdownLinks(html, { repository, baseDirInRepo });","+    return { frontmatter, safe: textUtil.sanitize(rewritten) };","+  }, [markdown, repository, baseDirInRepo]);","   const containerRef = useRef<HTMLDivElement>(null);","   // Only the latest async (first-click) resolution navigates, so overlapping","   // clicks can't race and push an earlier link's destination after a later one.","@@ -346,8 +356,17 @@ function RenderedMarkdown({","   const innerHtml = useMemo(() => ({ __html: safe }), [safe]);","   useMermaidDiagrams(containerRef, safe);"," ","+  // The metadata table sits outside the markdown container so the link-click","+  // handler and the mermaid hook only ever see rendered markdown.","   return (","-    <div ref={containerRef} className={cx('markdown-html', styles.markdownBody)} dangerouslySetInnerHTML={innerHtml} />","+    <>","+      {frontmatter && <MarkdownFrontmatterTable data={frontmatter} />}","+      <div","+        ref={containerRef}","+        className={cx('markdown-html', styles.markdownBody)}","+        dangerouslySetInnerHTML={innerHtml}","+      />","+    </>","   );"," }"," "],"additions":28,"deletions":9,"truncated":false},{"path":"public/app/features/provisioning/components/Folders/MarkdownFrontmatterTable.test.tsx","lines":["@@ -0,0 +1,90 @@","+import { render, screen, within } from 'test/test-utils';","+","+import { type YamlNode } from '../../utils/markdownFrontmatter';","+","+import { MarkdownFrontmatterTable } from './MarkdownFrontmatterTable';","+","+describe('MarkdownFrontmatterTable', () => {","+  it('renders one row per key, with the key as the row header, scalars as text and an empty value as an empty cell', () => {","+    render(<MarkdownFrontmatterTable data={{ title: 'Team A', version: '1.10', editable: 'false', owner: null }} />);","+","+    expect(screen.getByRole('table', { name: 'Document metadata' })).toBeInTheDocument();","+    expect(screen.getByRole('rowheader', { name: 'title' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: 'Team A' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: '1.10' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: 'false' })).toBeInTheDocument();","+","+    const ownerRow = screen.getByRole('rowheader', { name: 'owner' }).closest('tr')!;","+    expect(within(ownerRow).getByRole('cell')).toBeEmptyDOMElement();","+  });","+","+  it('renders http(s) values as external links and every other string as plain text', () => {","+    render(","+      <MarkdownFrontmatterTable","+        data={{","+          sourceUrl: 'https://example.com/docs',","+          note: 'see https://example.com',","+          unsafe: 'javascript:alert(1)',","+        }}","+      />","+    );","+","+    const link = screen.getByRole('link', { name: /https:\\/\\/example\\.com\\/docs/ });","+    expect(link).toHaveAttribute('href', 'https://example.com/docs');","+    expect(screen.getAllByRole('link')).toHaveLength(1);","+    expect(screen.getByRole('cell', { name: 'see https://example.com' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: 'javascript:alert(1)' })).toBeInTheDocument();","+  });","+","+  it('lays out a list as one row of cells', () => {","+    render(<MarkdownFrontmatterTable data={{ tags: ['as-code', 'markdown'] }} />);","+","+    const row = screen.getByRole('rowheader', { name: 'tags' }).closest('tr')!;","+    const inner = row.querySelector('table tr')!;","+    expect(Array.from(inner.querySelectorAll('td')).map((cell) => cell.textContent)).toEqual(['as-code', 'markdown']);","+  });","+","+  it('renders a nested mapping as nested key/value rows', () => {","+    render(<MarkdownFrontmatterTable data={{ owner: { team: 'platform', slack: '#platform' } }} />);","+","+    expect(screen.getByRole('rowheader', { name: 'team' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: 'platform' })).toBeInTheDocument();","+    expect(screen.getByRole('rowheader', { name: 'slack' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: '#platform' })).toBeInTheDocument();","+  });","+","+  it('shows containers nested more than two levels deep as a placeholder', () => {","+    render(<MarkdownFrontmatterTable data={{ a: { b: { c: ['1', '2'], d: { e: '1' } } } }} />);","+","+    expect(screen.getByRole('rowheader', { name: 'c' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: '[…]' })).toBeInTheDocument();","+    expect(screen.getByRole('rowheader', { name: 'd' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: '{…}' })).toBeInTheDocument();","+  });","+","+  it('shows empty lists and mappings as [] and {}', () => {","+    render(<MarkdownFrontmatterTable data={{ tags: [], meta: {} }} />);","+","+    expect(screen.getByRole('cell', { name: '[]' })).toBeInTheDocument();","+    expect(screen.getByRole('cell', { name: '{}' })).toBeInTheDocument();","+  });","+","+  it('cuts a self-referencing list off at the nesting limit instead of serializing it', () => {","+    // js-yaml resolves `loop: &x [*x]` to an array that contains itself.","+    const loop: YamlNode[] = [];","+    loop.push(loop);","+","+    render(<MarkdownFrontmatterTable data={{ loop }} />);","+","+    const row = screen.getByRole('rowheader', { name: 'loop' }).closest('tr')!;","+    // Expanded as a list twice (the nesting limit), then a placeholder.","+    expect(row.querySelectorAll('table')).toHaveLength(2);","+    expect(row).toHaveTextContent(/^loop\\[…\\]$/);","+  });","+","+  it('renders nothing for an empty mapping', () => {","+    const { container } = render(<MarkdownFrontmatterTable data={{}} />);","+","+    expect(container).toBeEmptyDOMElement();","+  });","+});"],"additions":90,"deletions":0,"truncated":false},{"path":"public/app/features/provisioning/components/Folders/MarkdownFrontmatterTable.tsx","lines":["@@ -0,0 +1,135 @@","+import { css, cx } from '@emotion/css';","+","+import { type GrafanaTheme2 } from '@grafana/data';","+import { t } from '@grafana/i18n';","+import { TextLink, useStyles2 } from '@grafana/ui';","+import { isHttpUrl } from 'app/core/utils/url';","+","+import { type YamlMapping, type YamlNode } from '../../utils/markdownFrontmatter';","+","+interface Props {","+  data: YamlMapping;","+}","+","+// Lists and mappings render as inner tables down to this depth; anything deeper","+// is shown as a placeholder so a deeply nested document can't blow up the layout.","+const MAX_NESTING = 2;","+","+/**","+ * GitHub-style metadata table for a document's YAML front matter: one row per","+ * top-level key. Values only ever reach the DOM through React bindings, so","+ * nothing from the file is rendered as HTML.","+ */","+export function MarkdownFrontmatterTable({ data }: Props) {","+  const styles = useStyles2(getStyles);","+  const entries = Object.entries(data);","+  if (entries.length === 0) {","+    return null;","+  }","+","+  // `markdown-html` gives the table the same borders, padding and link styling","+  // as tables in the document body, so the two can't drift apart.","+  return (","+    <div className={cx('markdown-html', styles.scroll)}>","+      <table className={styles.table} aria-label={t('browse-dashboards.readme.metadata-label', 'Document metadata')}>","+        <MappingRows entries={entries} depth={0} />","+      </table>","+    </div>","+  );","+}","+","+function MappingRows({ entries, depth }: { entries: Array<[string, YamlNode]>; depth: number }) {","+  return (","+    <tbody>","+      {entries.map(([key, value]) => (","+        <tr key={key}>","+          <th scope=\"row\">{key}</th>","+          <td>","+            <FrontmatterValue value={value} depth={depth} />","+          </td>","+        </tr>","+      ))}","+    </tbody>","+  );","+}","+","+// A list is one row of cells, like GitHub lays it out.","+function ListRow({ items, depth }: { items: YamlNode[]; depth: number }) {","+  const styles = useStyles2(getStyles);","+  return (","+    <table className={styles.list}>","+      <tbody>","+        <tr>","+          {items.map((item, index) => (","+            <td key={index}>","+              <FrontmatterValue value={item} depth={depth} />","+            </td>","+          ))}","+        </tr>","+      </tbody>","+    </table>","+  );","+}","+","+function FrontmatterValue({ value, depth }: { value: YamlNode; depth: number }) {","+  if (typeof value === 'string') {","+    return isHttpUrl(value) ? (","+      <TextLink href={value} external>","+        {value}","+      </TextLink>","+    ) : (","+      <>{value}</>","+    );","+  }","+","+  // A key with no value (`owner:`) gets an empty cell, like GitHub shows it.","+  if (value === null) {","+    return null;","+  }","+","+  const isList = Array.isArray(value);","+","+  // Never serialize the parsed YAML: anchors can make it cyclic (JSON.stringify","+  // throws) or expand a few aliased lines into megabytes. Containers we don't","+  // expand get a fixed-size stand-in instead.","+  const isEmpty = Object.keys(value).length === 0;","+  if (isEmpty || depth >= MAX_NESTING) {","+    const inner = isEmpty ? '' : '…';","+    const placeholder = isList ? `[${inner}]` : `{${inner}}`;","+    return <>{placeholder}</>;","+  }","+","+  return isList ? (","+    <ListRow items={value} depth={depth + 1} />","+  ) : (","+    <table>","+      <MappingRows entries={Object.entries(value)} depth={depth + 1} />","+    </table>","+  );","+}","+","+const getStyles = (theme: GrafanaTheme2) => ({","+  // The panel clips overflow, so a table wider than the panel scrolls instead of being cut off.","+  scroll: css({","+    overflowX: 'auto',","+    marginBottom: theme.spacing(2),","+  }),","+  table: css({","+    'th, td': {","+      verticalAlign: 'top',","+      // A long value (typically a URL) wraps rather than widening the table.","+      overflowWrap: 'anywhere',","+    },","+    // Multi-line values (YAML block scalars) keep their line breaks.","+    td: {","+      whiteSpace: 'pre-line',","+    },","+  }),","+  // List items share one row; keep each one whole and let the row scroll rather","+  // than squeezing them into letter-wrapped slivers.","+  list: css({","+    '& > tbody > tr > td': {","+      whiteSpace: 'nowrap',","+    },","+  }),","+});"],"additions":135,"deletions":0,"truncated":false},{"path":"public/app/features/provisioning/utils/markdownFrontmatter.test.ts","lines":["@@ -0,0 +1,101 @@","+import { splitFrontmatter } from './markdownFrontmatter';","+","+describe('splitFrontmatter', () => {","+  it('splits a leading YAML block into a mapping and returns the rest as the body', () => {","+    const markdown = [","+      '---',","+      'title: Team A',","+      'tags:',","+      '  - as-code',","+      '  - markdown',","+      '---',","+      '# Hello',","+      '',","+      'Body.',","+    ].join('\\n');","+","+    expect(splitFrontmatter(markdown)).toEqual({","+      frontmatter: { title: 'Team A', tags: ['as-code', 'markdown'] },","+      body: '# Hello\\n\\nBody.',","+    });","+  });","+","+  it('accepts `...` as the closing fence', () => {","+    expect(splitFrontmatter('---\\ntitle: Team A\\n...\\n# Hello')).toEqual({","+      frontmatter: { title: 'Team A' },","+      body: '# Hello',","+    });","+  });","+","+  it('handles CRLF line endings and keeps them in the body', () => {","+    expect(splitFrontmatter('---\\r\\ntitle: Team A\\r\\n---\\r\\n# Hello\\r\\n')).toEqual({","+      frontmatter: { title: 'Team A' },","+      body: '# Hello\\r\\n',","+    });","+  });","+","+  it('ignores a UTF-8 BOM before the opening fence', () => {","+    expect(splitFrontmatter('\\uFEFF---\\ntitle: Team A\\n---\\n# Hello')).toEqual({","+      frontmatter: { title: 'Team A' },","+      body: '# Hello',","+    });","+  });","+","+  it('handles a document that is only front matter, with no trailing newline', () => {","+    expect(splitFrontmatter('---\\ntitle: Team A\\n---')).toEqual({","+      frontmatter: { title: 'Team A' },","+      body: '',","+    });","+  });","+","+  it('keeps the body exactly as written, including a later `---` thematic break', () => {","+    const body = '\\n\\nIntro\\n\\n---\\n\\nMore  \\n';","+","+    expect(splitFrontmatter(`---\\na: 1\\n---\\n${body}`).body).toBe(body);","+  });","+","+  it('keeps scalars as the text the author wrote and an empty value as null', () => {","+    expect(splitFrontmatter('---\\neditable: false\\nweight: 1.10\\nzip: 01234\\nowner:\\n---\\n').frontmatter).toEqual({","+      editable: 'false',","+      weight: '1.10',","+      zip: '01234',","+      owner: null,","+    });","+  });","+","+  it('keeps dates as the text the author wrote rather than Date objects', () => {","+    expect(splitFrontmatter('---\\nupdated: 2024-01-15\\n---\\n').frontmatter).toEqual({ updated: '2024-01-15' });","+  });","+","+  it('keeps nested mappings', () => {","+    expect(splitFrontmatter('---\\nowner:\\n  team: platform\\n  slack: \"#platform\"\\n---\\n').frontmatter).toEqual({","+      owner: { team: 'platform', slack: '#platform' },","+    });","+  });","+","+  it('takes the last value when a key is repeated instead of rejecting the block', () => {","+    expect(splitFrontmatter('---\\ntitle: First\\ntitle: Second\\n---\\n# Hello')).toEqual({","+      frontmatter: { title: 'Second' },","+      body: '# Hello',","+    });","+  });","+","+  it.each([","+    { desc: 'empty', markdown: '---\\n---\\n# Hello' },","+    { desc: 'only comments', markdown: '---\\n# TODO: add metadata\\n---\\n# Hello' },","+  ])('strips a block that is $desc and returns an empty mapping', ({ markdown }) => {","+    expect(splitFrontmatter(markdown)).toEqual({ frontmatter: {}, body: '# Hello' });","+  });","+","+  it.each([","+    { desc: 'the fence is not on the first line', markdown: '# Title\\n\\n---\\ntitle: Team A\\n---\\n' },","+    { desc: 'a blank line precedes the fence', markdown: '\\n---\\ntitle: Team A\\n---\\n' },","+    { desc: 'the opening fence is never closed', markdown: '---\\ntitle: Team A\\n\\n# Hello' },","+    { desc: 'the YAML is invalid', markdown: '---\\ntitle: [unclosed\\n---\\n# Hello' },","+    { desc: 'the YAML uses an explicit non-string tag', markdown: '---\\nweight: !!int 5\\n---\\n# Hello' },","+    { desc: 'the YAML is a list', markdown: '---\\n- a\\n- b\\n---\\n# Hello' },","+    { desc: 'the YAML is a scalar', markdown: '---\\njust text\\n---\\n# Hello' },","+  ])('returns the document unchanged with no front matter when $desc', ({ markdown }) => {","+    expect(splitFrontmatter(markdown)).toEqual({ body: markdown });","+  });","+});"],"additions":101,"deletions":0,"truncated":false},{"path":"public/app/features/provisioning/utils/markdownFrontmatter.ts","lines":["@@ -0,0 +1,44 @@","+import { FAILSAFE_SCHEMA, load } from 'js-yaml';","+","+export type YamlNode = string | null | YamlNode[] | YamlMapping;","+export type YamlMapping = { [key: string]: YamlNode };","+","+// `---` on the first line (BOM allowed) through a closing `---` or `...` line; CRLF and trailing spaces OK.","+const FRONTMATTER_RE = /^\\uFEFF?---[ \\t]*\\r?\\n(?:([\\s\\S]*?)\\r?\\n)?(?:---|\\.\\.\\.)[ \\t]*(?:\\r?\\n|$)/;","+","+/**","+ * Split a leading YAML front matter block off a markdown document, like GitHub does.","+ * Anything that isn't a YAML mapping (invalid YAML, a list, a scalar) stays in the","+ * document so it renders as before.","+ */","+export function splitFrontmatter(markdown: string): { frontmatter?: YamlMapping; body: string } {","+  const match = FRONTMATTER_RE.exec(markdown);","+  if (!match) {","+    return { body: markdown };","+  }","+","+  const frontmatter = parseMapping(match[1] ?? '');","+  if (!frontmatter) {","+    return { body: markdown };","+  }","+","+  return { frontmatter, body: markdown.slice(match[0].length) };","+}","+","+// The failsafe schema keeps scalars as written (`1.10`, `01234`, `0x1F`, `false`) instead of","+// coercing them; an explicit non-string tag like `!!int` throws and the block stays in the document.","+// `json` lets a repeated key override instead of failing.","+// An empty or comment-only block parses to nothing; treat it as `{}` so its fences are stripped too.","+function parseMapping(yaml: string): YamlMapping | undefined {","+  try {","+    const parsed = load(yaml, { schema: FAILSAFE_SCHEMA, json: true }) ?? {};","+    return isYamlMapping(parsed) ? parsed : undefined;","+  } catch {","+    return undefined;","+  }","+}","+","+// Only sound because the failsafe schema yields nothing but strings, nulls, arrays and plain objects.","+function isYamlMapping(value: unknown): value is YamlMapping {","+  return typeof value === 'object' && value !== null && !Array.isArray(value);","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"public/app/features/visualization/data-hover/DataHoverView.test.tsx","lines":["@@ -3,24 +3,13 @@ import { render, screen } from '@testing-library/react';"," import { arrayToDataFrame, createDataFrame, FieldType } from '@grafana/data';"," "," import { DataHoverView, getDisplayValuesAndLinks } from './DataHoverView';","-import { isHttpUrl, renderValue } from './renderValue';","+import { renderValue } from './renderValue';"," "," jest.mock('@grafana/ui', () => ({","   ...jest.requireActual('@grafana/ui'),","   getFieldDisplayLinks: jest.fn().mockReturnValue([]),"," }));"," ","-describ