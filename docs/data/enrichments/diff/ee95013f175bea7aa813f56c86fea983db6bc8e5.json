,"+@@ -654,6 +655,12 @@ InsertionOrderPreservingMap<string> DuckLakeDelete::ParamsToString() const {","+ }","+ ","+ optional_ptr<PhysicalTableScan> FindDeleteSource(PhysicalOperator &plan) {","++\tif (plan.type == PhysicalOperatorType::MERGE_ACTION_SOURCE) {","++\t\t// the rows of a merge action are pushed into the source by the merge into - look for the scan in the plan","++\t\t// that the merge into reads from","++\t\tauto &merge_input = plan.Cast<PhysicalMergeActionSource>().merge_input;","++\t\treturn merge_input ? FindDeleteSource(*merge_input) : nullptr;","++\t}","+ \tif (plan.type == PhysicalOperatorType::TABLE_SCAN) {","+ \t\t// does this emit the virtual columns?","+ \t\tauto &scan = plan.Cast<PhysicalTableScan>();","+diff --git a/src/storage/ducklake_merge_into.cpp b/src/storage/ducklake_merge_into.cpp","+index a79cd3da..b5e8473f 100644","+--- a/src/storage/ducklake_merge_into.cpp","+@@ -1,652 +1,25 @@","+ #include \"storage/ducklake_catalog.hpp\"","+ #include \"duckdb/execution/physical_plan_generator.hpp\"","+-#include \"duckdb/execution/operator/persistent/physical_merge_into.hpp\"","+ #include \"duckdb/planner/operator/logical_merge_into.hpp\"","+-#include \"storage/ducklake_update.hpp\"","+-#include \"storage/ducklake_delete.hpp\"","+-#include \"storage/ducklake_insert.hpp\"","+-#include \"storage/ducklake_inline_data.hpp\"","+-#include \"storage/ducklake_table_entry.hpp\"","+-#include \"duckdb/planner/operator/logical_update.hpp\"","+-#include \"duckdb/planner/operator/logical_dummy_scan.hpp\"","+-#include \"duckdb/planner/operator/logical_delete.hpp\"","+-#include \"duckdb/planner/operator/logical_insert.hpp\"","+-#include \"duckdb/planner/expression/bound_reference_expression.hpp\"","+-#include \"duckdb/parallel/thread_context.hpp\"","+-#include \"duckdb/catalog/catalog_entry/table_catalog_entry.hpp\"","+-#include \"duckdb/execution/operator/projection/physical_projection.hpp\"","+-#include \"duckdb/execution/operator/scan/physical_dummy_scan.hpp\"","+-#include \"duckdb/execution/operator/persistent/physical_copy_to_file.hpp\"","+-#include \"duckdb/parallel/event.hpp\"","+ ","+ namespace duckdb {","+ ","+-//===--------------------------------------------------------------------===//","+-// Merge Insert","+-//===--------------------------------------------------------------------===//","+-class DuckLakeMergeInsert : public PhysicalOperator {","+-public:","+-\tDuckLakeMergeInsert(PhysicalPlan &physical_plan, const vector<LogicalType> &types, PhysicalOperator &catalog_insert,","+-\t                    optional_ptr<DuckLakeInlineData> inline_data_op, PhysicalOperator &physical_copy);","+-","+-\t//! The copy operator that writes to the file","+-\tPhysicalOperator &physical_copy;","+-\t//! The final insert operator","+-\tPhysicalOperator &catalog_insert;","+-\t//! The inline data operator (if data inlining is enabled)","+-\toptional_ptr<DuckLakeInlineData> inline_data_op;","+-\t//! Extra Projections","+-\tvector<unique_ptr<Expression>> extra_projections;","+-","+-public:","+-\t// Source interface","+-\tSourceResultType GetDataInternal(ExecutionContext &context, DataChunk &chunk,","+-\t                                 OperatorSourceInput &input) const override;","+-","+-\tbool IsSource() const override {","+-\t\treturn true;","+-\t}","+-","+-public:","+-\t// Sink interface","+-\tSinkResultType Sink(ExecutionContext &context, DataChunk &chunk, OperatorSinkInput &input) const override;","+-\tSinkCombineResultType Combine(ExecutionContext &context, OperatorSinkCombineInput &input) const override;","+-\tSinkFinalizeType Finalize(Pipeline &pipeline, Event &event, ClientContext &context,","+-\t                          OperatorSinkFinalizeInput &input) const override;","+-\tunique_ptr<GlobalSinkState> GetGlobalSinkState(ClientContext &context) const override;","+-\tunique_ptr<LocalSinkState> GetLocalSinkState(ExecutionContext &context) const override;","+-","+-\tbool IsSink() const override {","+-\t\treturn true;","+-\t}","+-","+-\tbool ParallelSink() const override {","+-\t\treturn true;","+-\t}","+-};","+-","+-DuckLakeMergeInsert::DuckLakeMergeInsert(PhysicalPlan &physical_plan, const vector<LogicalType> &types,","+-                                         PhysicalOperator &catalog_insert,","+-                                         optional_ptr<DuckLakeInlineData> inline_data_op,","+-                                         PhysicalOperator &physical_copy)","+-    : PhysicalOperator(physical_plan, PhysicalOperatorType::EXTENSION, types, 1), physical_copy(physical_copy),","+-      catalog_insert(catalog_insert), inline_data_op(inline_data_op) {","+-}","+-","+-SourceResultType DuckLakeMergeInsert::GetDataInternal(ExecutionContext &context, DataChunk &chunk,","+-                                                      OperatorSourceInput &input) const {","+-\treturn SourceResultType::FINISHED;","+-}","+-","+-//===--------------------------------------------------------------------===//","+-// Shared helpers","+-//===--------------------------------------------------------------------===//","+-","+-// Apply extra projections and casts before feeding a chunk to CopyToFile — shared by MergeInsert and MergeUpdate","+-static void ProjectAndCastForCopy(ClientContext &context, DataChunk &input_chunk, PhysicalOperator &copy_op,","+-                                  ExpressionExecutor *expression_executor, DataChunk &projected_chunk,","+-                                  DataChunk &cast_chunk) {","+-\treference<DataChunk> chunk_ref = input_chunk;","+-\tif (expression_executor) {","+-\t\tprojected_chunk.Reset();","+-\t\texpression_executor->Execute(input_chunk, projected_chunk);","+-\t\tchunk_ref = projected_chunk;","+-\t}","+-\tauto &copy_types = copy_op.Cast<PhysicalCopyToFile>().expected_types;","+-\tfor (idx_t i = 0; i < chunk_ref.get().ColumnCount(); i++) {","+-\t\tif (chunk_ref.get().data[i].GetType() != copy_types[i]) {","+-\t\t\tVectorOperations::Cast(context, chunk_ref.get().data[i], cast_chunk.data[i], chunk_ref.get().size());","+-\t\t} else {","+-\t\t\tcast_chunk.data[i].Reference(chunk_ref.get().data[i]);","+-\t\t}","+-\t}","+-\tcast_chunk.SetChildCardinality(chunk_ref.get().size());","+-}","+-","+-//===--------------------------------------------------------------------===//","+-// Sink","+-//===--------------------------------------------------------------------===//","+-// Shared sink state for the merge operators that copy/inline rows (DuckLakeMergeInsert and DuckLakeMergeUpdate).","+-class DuckLakeMergeSinkGlobalState : public GlobalSinkState {","+-public:","+-\tunique_ptr<GlobalOperatorState> inline_data_gstate;","+-};","+-","+-class DuckLakeMergeSinkLocalState : public LocalSinkState {","+-public:","+-\tunique_ptr<LocalSinkState> copy_sink_state;","+-\tunique_ptr<OperatorState> inline_data_lstate;","+-\tDataChunk inline_output;","+-\t//! Used if we have extra projections","+-\tDataChunk cast_chunk;","+-\tDataChunk projected_chunk;","+-\tunique_ptr<ExpressionExecutor> expression_executor;","+-};","+-","+-// Run a chunk through the optional inline-data operator or send it straight to the copy sink.","+-static void SinkInlineOrCopy(ExecutionContext &context, DataChunk &execute_input,","+-                             optional_ptr<DuckLakeInlineData> inline_data_op, PhysicalOperator &physical_copy,","+-                             DuckLakeMergeSinkGlobalState &gstate, DuckLakeMergeSinkLocalState &lstate,","+-                             InterruptState &interrupt_state) {","+-\tauto sink_to_copy = [&](DataChunk &chunk) {","+-\t\tProjectAndCastForCopy(context.client, chunk, physical_copy, lstate.expression_executor.get(),","+-\t\t                      lstate.projected_chunk, lstate.cast_chunk);","+-\t\tOperatorSinkInput copy_input {*physical_copy.sink_state, *lstate.copy_sink_state, interrupt_state};","+-\t\tphysical_copy.Sink(context, lstate.cast_chunk, copy_input);","+-\t};","+-","+-\t// run the chunk through the inline data operator - it inlines what fits and passes the rest to the copy sink","+-\tif (inline_data_op) {","+-\t\tlstate.inline_output.Reset();","+-\t\tauto result = inline_data_op->Execute(context, execute_input, lstate.inline_output, *gstate.inline_data_gstate,","+-\t\t                                      *lstate.inline_data_lstate);","+-\t\tif (lstate.inline_output.size() > 0) {","+-\t\t\tsink_to_copy(lstate.inline_output);","+-\t\t}","+-\t\twhile (result == OperatorResultType::HAVE_MORE_OUTPUT) {","+-\t\t\tlstate.inline_output.Reset();","+-\t\t\tresult = inline_data_op->Execute(context, execute_input, lstate.inline_output, *gstate.inline_data_gstate,","+-\t\t\t                                 *lstate.inline_data_lstate);","+-\t\t\tif (lstate.inline_output.size() > 0) {","+-\t\t\t\tsink_to_copy(lstate.inline_output);","+-\t\t\t}","+-\t\t}","+-\t} else {","+-\t\tsink_to_copy(execute_input);","+-\t\treturn;","+-\t}","+-}","+-","+-static void DrainInlineData(optional_ptr<DuckLakeInlineData> inline_data_op, ExecutionContext &context,","+-                            OperatorSinkCombineInput &input, PhysicalOperator &physical_copy,","+-                            DuckLakeMergeSinkGlobalState &gstate, DuckLakeMergeSinkLocalState &lstate) {","+-\tauto &inline_output = lstate.inline_output;","+-\twhile (true) {","+-\t\tlstate.inline_output.Reset();","+-\t\tauto fresult = inline_data_op->FinalExecute(context, inline_output, *gstate.inline_data_gstate,","+-\t\t                                            *lstate.inline_data_lstate);","+-\t\tif (inline_output.size() > 0) {","+-\t\t\tProjectAndCastForCopy(context.client, inline_output, physical_copy, lstate.expression_executor.get(),","+-\t\t\t                      lstate.projected_chunk, lstate.cast_chunk);","+-\t\t\tOperatorSinkInput copy_input {*physical_copy.sink_state, *lstate.copy_sink_state, input.interrupt_state};","+-\t\t\tphysical_copy.Sink(context, lstate.cast_chunk, copy_input);","+-\t\t}","+-\t\tif (fresult == OperatorFinalizeResultType::FINISHED) {","+-\t\t\tbreak;","+-\t\t}","+-\t}","+-}","+-","+-SinkResultType DuckLakeMergeInsert::Sink(ExecutionContext &context, DataChunk &chunk, OperatorSinkInput &input) const {","+-\tauto &gstate = input.global_state.Cast<DuckLakeMergeSinkGlobalState>();","+-\tauto &lstate = input.local_state.Cast<DuckLakeMergeSinkLocalState>();","+-","+-\tSinkInlineOrCopy(context, chunk, inline_data_op, physical_copy, gstate, lstate, input.interrupt_state);","+-\treturn SinkResultType::NEED_MORE_INPUT;","+-}","+-","+-SinkCombineResultType DuckLakeMergeInsert::Combine(ExecutionContext &context, OperatorSinkCombineInput &input) const {","+-\tauto &gstate = input.global_state.Cast<DuckLakeMergeSinkGlobalState>();","+-\tauto &lstate = input.local_state.Cast<DuckLakeMergeSinkLocalState>();","+-","+-\t// drain inline data","+-\tif (inline_data_op) {","+-\t\tDrainInlineData(inline_data_op, context, input, physical_copy, gstate, lstate);","+-\t}","+-","+-\tOperatorSinkCombineInput combine_input {*physical_copy.sink_state, *lstate.copy_sink_state, input.interrupt_state};","+-\tphysical_copy.Combine(context, combine_input);","+-\treturn SinkCombineResultType::FINISHED;","+-}","+-","+-namespace {","+-","+-//! Extend the Event class to be able to capture a created Event","+-//! When an Event is created through 'Event::InsertEvent' it gets added to the 'parents'","+-//! Through GetCapturedEvent we can access this newly created event","+-class CaptureEvent : public Event {","+-public:","+-\texplicit CaptureEvent(Executor &executor) : Event(executor) {","+-\t}","+-","+-\tvoid Schedule() override {","+-\t\t// No-op","+-\t}","+-","+-\tshared_ptr<Event> GetCapturedEvent() {","+-\t\tif (parents.empty()) {","+-\t\t\treturn nullptr;","+-\t\t}","+-\t\treturn parents[0].lock();","+-\t}","+-};","+-","+-} // namespace","+-","+-// Scan copy operator source and sink into insert operator — shared by MergeInsert and MergeUpdate","+-static SinkFinalizeType FinalizeCopyToInsert(Pipeline &pipeline, Event &event, ClientContext &context,","+-                                             PhysicalOperator &copy_op, PhysicalOperator &insert_op,","+-                                             InterruptState &interrupt_state) {","+-\tOperatorSinkFinalizeInput copy_finalize {*copy_op.sink_state, interrupt_state};","+-\tCaptureEvent capture_event(pipeline.executor);","+-\tauto finalize_result = copy_op.Finalize(pipeline, capture_event, context, copy_finalize);","+-\tif (finalize_result == SinkFinalizeType::BLOCKED) {","+-\t\treturn SinkFinalizeType::BLOCKED;","+-\t}","+-","+-\t//! PhysicalCopyToFile creates an Event as part of Finalize","+-\t//! We need to intercept and execute this event's tasks, to finish the finalize work","+-\tauto captured_event = capture_event.GetCapturedEvent();","+-\tif (captured_event) {","+-\t\t// Schedule the event's tasks with our token","+-\t\tcaptured_event->Schedule();","+-","+-\t\t// Work on tasks until the event is finished","+-\t\tshared_ptr<Task> task;","+-\t\tauto &token = pipeline.executor.GetToken();","+-\t\twhile (!captured_event->IsFinished()) {","+-\t\t\tif (TaskScheduler::GetScheduler(context).GetTaskFromProducer(token, task)) {","+-\t\t\t\ttask->Execute(TaskExecutionMode::PROCESS_ALL);","+-\t\t\t\ttask.reset();","+-\t\t\t}","+-\t\t}","+-\t}","+-","+-\tDataChunk chunk;","+-\tchunk.Initialize(context, copy_op.types);","+-","+-\tThreadContext thread(context);","+-\tExecutionContext exec_context(context, thread, nullptr);","+-","+-\tauto copy_global = copy_op.GetGlobalSourceState(context);","+-\tauto copy_local = copy_op.GetLocalSourceState(exec_context, *copy_global);","+-\tOperatorSourceInput source_input {*copy_global, *copy_local, interrupt_state};","+-","+-\tauto insert_global = insert_op.GetGlobalSinkState(context);","+-\tauto insert_local = insert_op.GetLocalSinkState(exec_context);","+-\tOperatorSinkInput sink_input {*insert_global, *insert_local, interrupt_state};","+-\tSourceResultType source_res = SourceResultType::HAVE_MORE_OUTPUT;","+-\twhile (source_res == SourceResultType::HAVE_MORE_OUTPUT) {","+-\t\tchunk.Reset();","+-\t\tsource_res = copy_op.GetData(exec_context, chunk, source_input);","+-\t\tif (chunk.size() == 0) {","+-\t\t\tcontinue;","+-\t\t}","+-\t\tif (source_res == SourceResultType::BLOCKED) {","+-\t\t\tthrow InternalException(\"BLOCKED not supported in DuckLakeMerge\");","+-\t\t}","+-","+-\t\tauto sink_result = insert_op.Sink(exec_context, chunk, sink_input);","+-\t\tif (sink_result != SinkResultType::NEED_MORE_INPUT) {","+-\t\t\tthrow InternalException(\"BLOCKED not supported in DuckLakeMerge\");","+-\t\t}","+-\t}","+-\tOperatorSinkCombineInput combine_input {*insert_global, *insert_local, interrupt_state};","+-\tauto combine_res = insert_op.Combine(exec_context, combine_input);","+-\tif (combine_res == SinkCombineResultType::BLOCKED) {","+-\t\tthrow InternalException(\"BLOCKED not supported in DuckLakeMerge\");","+-\t}","+-\tOperatorSinkFinalizeInput finalize_input {*insert_global, interrupt_state};","+-\tauto finalize_res = insert_op.Finalize(pipeline, event, context, finalize_input);","+-\tif (finalize_res == SinkFinalizeType::BLOCKED) {","+-\t\tthrow InternalException(\"BLOCKED not supported in DuckLakeMerge\");","+-\t}","+-\treturn SinkFinalizeType::READY;","+-}","+-","+-SinkFinalizeType DuckLakeMergeInsert::Finalize(Pipeline &pipeline, Event &event, ClientContext &context,","+-                                               OperatorSinkFinalizeInput &input) const {","+-\tif (inline_data_op) {","+-\t\tauto &gstate = input.global_state.Cast<DuckLakeMergeSinkGlobalState>();","+-\t\tOperatorFinalizeInput inline_finalize {*gstate.inline_data_gstate, input.interrupt_state};","+-\t\tinline_data_op->OperatorFinalize(pipeline, event, context, inline_finalize);","+-\t}","+-","+-\treturn FinalizeCopyToInsert(pipeline, event, context, physical_copy, catalog_insert, input.interrupt_state);","+-}","+-","+-unique_ptr<GlobalSinkState> DuckLakeMergeInsert::GetGlobalSinkState(ClientContext &context) const {","+-\tauto result = make_uniq<DuckLakeMergeSinkGlobalState>();","+-\tif (inline_data_op) {","+-\t\tresult->inline_data_gstate = inline_data_op->GetGlobalOperatorState(context);","+-\t}","+-\tphysical_copy.sink_state = physical_copy.GetGlobalSinkState(context);","+-\treturn std::move(result);","+-}","+-","+-unique_ptr<LocalSinkState> DuckLakeMergeInsert::GetLocalSinkState(ExecutionContext &context) const {","+-\tauto result = make_uniq<DuckLakeMergeSinkLocalState>();","+-\tresult->copy_sink_state = physical_copy.GetLocalSinkState(context);","+-\tif (inline_data_op) {","+-\t\tresult->inline_data_lstate = inline_data_op->GetOperatorState(context);","+-\t\tresult->inline_output.Initialize(context.client, inline_data_op->types);","+-\t}","+-\tif (!extra_projections.empty()) {","+-\t\tresult->expression_executor = make_uniq<ExpressionExecutor>(context.client, extra_projections);","+-\t\tvector<LogicalType> insert_types;","+-\t\tfor (auto &expr : result->expression_executor->expressions) {","+-\t\t\tinsert_types.push_back(expr->GetReturnType());","+-\t\t}","+-\t\tresult->projected_chunk.Initialize(context.client, insert_types);","+-\t}","+-\tresult->cast_chunk.Initialize(context.client, physical_copy.Cast<PhysicalCopyToFile>().expected_types);","+-","+-\treturn std::move(result);","+-}","+-","+-//===--------------------------------------------------------------------===//","+-// Merge Update","+-//===--------------------------------------------------------------------===//","+-class DuckLakeMergeUpdate : public PhysicalOperator {","+-public:","+-\tDuckLakeMergeUpdate(PhysicalPlan &physical_plan, const vector<LogicalType> &types, DuckLakeUpdate &update_op,","+-\t                    optional_ptr<DuckLakeInlineData> inline_data_op, PhysicalOperator &physical_copy,","+-\t                    PhysicalOperator &catalog_insert)","+-\t    : PhysicalOperator(physical_plan, PhysicalOperatorType::EXTENSION, types, 1), update_op(update_op),","+-\t      inline_data_op(inline_data_op), physical_copy(physical_copy), catalog_insert(catalog_insert) {","+-\t}","+-","+-\tDuckLakeUpdate &update_op;","+-\toptional_ptr<DuckLakeInlineData> inline_data_op;","+-\tPhysicalOperator &physical_copy;","+-\tPhysicalOperator &catalog_insert;","+-\t//! Extra projections for partition columns","+-\tvector<unique_ptr<Expression>> extra_projections;","+-","+-public:","+-\tSourceResultType GetDataInternal(ExecutionContext &context, DataChunk &chunk,","+-\t                                 OperatorSourceInput &input) const override {","+-\t\treturn SourceResultType::FINISHED;","+-\t}","+-\tbool IsSource() const override {","+-\t\treturn true;","+-\t}","+-\tbool IsSink() const override {","+-\t\treturn true;","+-\t}","+-\tbool ParallelSink() const override {","+-\t\treturn true;","+-\t}","+-\tstring GetName() const override {","+-\t\treturn \"DUCKLAKE_MERGE_UPDATE\";","+-\t}","+-","+-\tunique_ptr<GlobalSinkState> GetGlobalSinkState(ClientContext &context) const override;","+-\tunique_ptr<LocalSinkState> GetLocalSinkState(ExecutionContext &context) const override;","+-\tSinkResultType Sink(ExecutionContext &context, DataChunk &chunk, OperatorSinkInput &input) const override;","+-\tSinkCombineResultType Combine(ExecutionContext &context, OperatorSinkCombineInput &input) const override;","+-\tSinkFinalizeType Finalize(Pipeline &pipeline, Event &event, ClientContext &context,","+-\t                          OperatorSinkFinalizeInput &input) const override;","+-};","+-","+-class DuckLakeMergeUpdateGlobalState : public DuckLakeMergeSinkGlobalState {","+-public:","+-\tunique_ptr<GlobalOperatorState> update_gstate;","+-};","+-","+-class DuckLakeMergeUpdateLocalState : public DuckLakeMergeSinkLocalState {","+-public:","+-\tunique_ptr<OperatorState> update_lstate;","+-\tDataChunk update_output;","+-};","+-","+-unique_ptr<GlobalSinkState> DuckLakeMergeUpdate::GetGlobalSinkState(ClientContext &context) const {","+-\tauto result = make_uniq<DuckLakeMergeUpdateGlobalState>();","+-\tresult->update_gstate = update_op.GetGlobalOperatorState(context);","+-\tif (inline_data_op) {","+-\t\tresult->inline_data_gstate = inline_data_op->GetGlobalOperatorState(context);","+-\t}","+-\tphysical_copy.sink_state = physical_copy.GetGlobalSinkState(context);","+-\treturn std::move(result);","+-}","+-","+-unique_ptr<LocalSinkState> DuckLakeMergeUpdate::GetLocalSinkState(ExecutionContext &context) const {","+-\tauto result = make_uniq<DuckLakeMergeUpdateLocalState>();","+-\tresult->update_lstate = update_op.GetOperatorState(context);","+-\tif (inline_data_op) {","+-\t\tresult->inline_data_lstate = inline_data_op->GetOperatorState(context);","+-\t\tresult->inline_output.Initialize(context.client, inline_data_op->types);","+-\t}","+-\tresult->copy_sink_state = physical_copy.GetLocalSinkState(context);","+-\tresult->update_output.Initialize(context.client, update_op.types);","+-\tif (!extra_projections.empty()) {","+-\t\tresult->expression_executor = make_uniq<ExpressionExecutor>(context.client, extra_projections);","+-\t\tvector<LogicalType> projected_types;","+-\t\tfor (auto &expr : result->expression_executor->expressions) {","+-\t\t\tprojected_types.push_back(expr->GetReturnType());","+-\t\t}","+-\t\tresult->projected_chunk.Initialize(context.client, projected_types);","+-\t}","+-\tresult->cast_chunk.Initialize(context.client, physical_copy.Cast<PhysicalCopyToFile>().expected_types);","+-\treturn std::move(result);","+-}","+-","+-SinkResultType DuckLakeMergeUpdate::Sink(ExecutionContext &context, DataChunk &chunk, OperatorSinkInput &input) const {","+-\tauto &gstate = input.global_state.Cast<DuckLakeMergeUpdateGlobalState>();","+-\tauto &lstate = input.local_state.Cast<DuckLakeMergeUpdateLocalState>();","+-","+-\tlstate.update_output.Reset();","+-\tupdate_op.Execute(context, chunk, lstate.update_output, *gstate.update_gstate, *lstate.update_lstate);","+-","+-\tif (lstate.update_output.size() == 0) {","+-\t\treturn SinkResultType::NEED_MORE_INP