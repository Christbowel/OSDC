  $platform instanceof \\Doctrine\\DBAL\\Platforms\\PostgreSQLPlatform => 'CAST(EXTRACT(epoch FROM NOW()) AS DOUBLE PRECISION)',"],"additions":2,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/Lock/Store/PdoStore.php","lines":["@@ -288,7 +288,8 @@ private function getDriver(): string","     private function getCurrentTimestampStatement(): string","     {","         return match ($this->getDriver()) {","-            'mysql' => 'UNIX_TIMESTAMP(NOW(6))',","+            // NOW() is in the session time zone, so UNIX_TIMESTAMP(NOW(6)) jumps by an hour when DST ends","+            'mysql' => 'UNIX_TIMESTAMP() + MICROSECOND(NOW(6)) / 1e6',","             'sqlite' => \"(julianday('now') - 2440587.5) * 86400.0\",","             'pgsql' => 'CAST(EXTRACT(epoch FROM NOW()) AS DOUBLE PRECISION)',","             'oci' => \"(CAST(systimestamp AT TIME ZONE 'UTC' AS DATE) - DATE '1970-01-01') * 86400 + TO_NUMBER(TO_CHAR(systimestamp AT TIME ZONE 'UTC', 'SSSSS.FF'))\","],"additions":2,"deletions":1,"truncated":false},{"path":"src/Symfony/Component/Lock/Tests/Store/DoctrineDbalStoreTest.php","lines":["@@ -35,6 +35,7 @@ class_exists(\\Doctrine\\DBAL\\Platforms\\PostgreSqlPlatform::class);"," class DoctrineDbalStoreTest extends AbstractStoreTestCase"," {","     use ExpiringStoreTestTrait;","+    use MysqlDaylightSavingTimeTestTrait;"," ","     protected static string $dbFile;"," ","@@ -71,6 +72,17 @@ public function getStore(): PersistingStoreInterface","         return new DoctrineDbalStore(DriverManager::getConnection(['driver' => 'pdo_sqlite', 'path' => self::$dbFile], $config));","     }"," ","+    protected function createMysqlStore(array $params): array","+    {","+        $config = new Configuration();","+        if (class_exists(DefaultSchemaManagerFactory::class)) {","+            $config->setSchemaManagerFactory(new DefaultSchemaManagerFactory());","+        }","+        $conn = DriverManager::getConnection(['driver' => 'pdo_mysql'] + $params, $config);","+","+        return [new DoctrineDbalStore($conn, [], 0.0), $conn->executeStatement(...)];","+    }","+","     public function testAbortAfterExpiration()","     {","         $this->markTestSkipped('Pdo expects a TTL greater than 1 sec. Simulating a slow network is too hard');"],"additions":12,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Lock/Tests/Store/MysqlDaylightSavingTimeTestTrait.php","lines":["@@ -0,0 +1,81 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Lock\\Tests\\Store;","+","+use Symfony\\Component\\Lock\\Exception\\LockConflictedException;","+use Symfony\\Component\\Lock\\Key;","+use Symfony\\Component\\Lock\\PersistingStoreInterface;","+","+trait MysqlDaylightSavingTimeTestTrait","+{","+    /**","+     * @param array{host: string, user: string, password: string, dbname: string} $params","+     *","+     * @return array{PersistingStoreInterface, \\Closure(string): mixed} The store and a closure that runs SQL on its connection","+     */","+    abstract protected function createMysqlStore(array $params): array;","+","+    /**","+     * @requires extension pdo_mysql","+     *","+     * @group integration","+     */","+    public function testMysqlLockSurvivesDaylightSavingTimeChange()","+    {","+        // On 2025-11-02, America/Chicago went from 02:00 CDT back to 01:00 CST at 07:00 UTC, so 01:00-02:00 local happened twice.","+        $this->doTestMysqlLockSurvivesDaylightSavingTimeChange('lock taken before 02:00 CST', gmmktime(7, 58, 0, 11, 2, 2025), gmmktime(8, 0, 30, 11, 2, 2025), true);","+        $this->doTestMysqlLockSurvivesDaylightSavingTimeChange('lock expired after the second 01:00', gmmktime(6, 58, 0, 11, 2, 2025), gmmktime(7, 4, 0, 11, 2, 2025), false);","+    }","+","+    private function doTestMysqlLockSurvivesDaylightSavingTimeChange(string $case, int $holderTime, int $contenderTime, bool $holderKeepsLock)","+    {","+        if (!$host = getenv('MYSQL_HOST')) {","+            $this->markTestSkipped('Missing MYSQL_HOST env variable');","+        }","+","+        $params = [","+            'host' => $host,","+            'user' => getenv('MYSQL_USERNAME') ?: 'root',","+            'password' => getenv('MYSQL_PASSWORD') ?: '',","+            'dbname' => 'symfony_lock_test',","+        ];","+        $pdo = new \\PDO('mysql:host='.$host, $params['user'], $params['password']);","+","+        if (null === $pdo->query(\"SELECT CONVERT_TZ('2025-11-02 07:00:00', '+00:00', 'America/Chicago')\")->fetchColumn()) {","+            $this->markTestSkipped('MySQL time zone tables are not loaded');","+        }","+","+        $pdo->exec('CREATE DATABASE IF NOT EXISTS symfony_lock_test');","+","+        try {","+            [$store, $exec] = $this->createMysqlStore($params);","+            $exec(\"SET time_zone = 'America/Chicago'\");","+            $holder = new Key(__METHOD__);","+            $contender = new Key(__METHOD__);","+","+            $exec('SET TIMESTAMP = '.$holderTime);","+            $store->save($holder);","+","+            $exec('SET TIMESTAMP = '.$contenderTime);","+            try {","+                $store->save($contender);","+            } catch (LockConflictedException) {","+                // expected when the holder keeps the lock","+            }","+","+            $this->assertSame($holderKeepsLock, $store->exists($holder), $case);","+            $this->assertSame(!$holderKeepsLock, $store->exists($contender), $case);","+        } finally {","+            $pdo->exec('DROP DATABASE IF EXISTS symfony_lock_test');","+        }","+    }","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Lock/Tests/Store/PdoStoreTest.php","lines":["@@ -25,6 +25,7 @@"," class PdoStoreTest extends AbstractStoreTestCase"," {","     use ExpiringStoreTestTrait;","+    use MysqlDaylightSavingTimeTestTrait;"," ","     protected static string $dbFile;"," ","@@ -51,6 +52,13 @@ public function getStore(): PersistingStoreInterface","         return new PdoStore('sqlite:'.self::$dbFile);","     }"," ","+    protected function createMysqlStore(array $params): array","+    {","+        $pdo = new \\PDO('mysql:host='.$params['host'].';dbname='.$params['dbname'], $params['user'], $params['password']);","+","+        return [new PdoStore($pdo, [], 0.0), $pdo->exec(...)];","+    }","+","     public function testAbortAfterExpiration()","     {","         $this->markTestSkipped('Pdo expects a TTL greater than 1 sec. Simulating a slow network is too hard');",""],"additions":8,"deletions":0,"truncated":false}],"additions":113,"deletions":2,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-16T17:23:51.494448+00:00"}