isioningResourceReadOnly(resource: ManagedResource): boolean {","+  return isManaged(resource) && resource.metadata?.annotations?.[AnnoKeyManagerAllowsEdits] !== 'true';","+}","+","+/**","+ * True when a provisioning resource is a leftover of configuration that no longer names it:","+ * owned by file provisioning, with nothing left running. Its configuration still comes from a","+ * file rather than from here, so it stays read-only, but deleting it is the documented remedy","+ * for clearing the setting — so that one action has to stay available.","+ */","+export function isReleasedByFileProvisioning(resource: ManagedResource, isRunning: boolean): boolean {","+  return !isRunning && getManagerKind(resource) === ManagerKind.FileProvisioning;","+}","+"," /**","  * Some surfaces (search results, folder DTOs) carry the manager kind as a flattened `managedBy`","  * field on the item itself rather than in `metadata.annotations`. This is the counterpart to"],"additions":21,"deletions":0,"truncated":false},{"path":"public/app/features/provisioning/utils/resourceKinds.test.ts","lines":["@@ -55,6 +55,36 @@ describe('resourceKinds registry', () => {","       itemType: 'DataSource',","       collectionGroup: true,","     });","+    expect(resourceKindInfos.repository).toMatchObject({","+      group: 'provisioning.grafana.app',","+      kind: 'Repository',","+      resource: 'repositories',","+      itemType: 'Repository',","+    });","+    expect(resourceKindInfos.connection).toMatchObject({","+      group: 'provisioning.grafana.app',","+      kind: 'Connection',","+      resource: 'connections',","+      itemType: 'Connection',","+    });","+  });","+","+  // A bootstrap repository provisions repositories and connections, and their stat badges fall","+  // back to a generic icon and a dead link for any kind the registry does not know.","+  it('resolves provisioning kinds from a repository stat, including their admin routes', () => {","+    const repository = getKindInfoByStat(