 => string | undefined,","+): string | null | undefined => {","+  switch (groupByKey) {","+    case EVAL_RUN_SCORERS_GROUP_BY_KEY:","+      return getScorersGroupValue(parseEvalRunScorersDigest(getTag(EVAL_RUN_SCORERS_DIGEST_TAG)));","+    case EVAL_RUN_AGENT_GROUP_BY_KEY:","+      return (","+        asNonEmptyString(getTag(EVAL_RUN_AGENT_URI_TAG)) ??","+        asNonEmptyString(getTag(EVAL_RUN_AGENT_FUNCTION_TAG)) ??","+        null","+      );","+    default:","+      return undefined;","+  }","+};","+"," export const getEvalRunAgentLineage = (","   tags: Record<string, string | undefined>,","   loggedModelId?: string,"],"additions":45,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/pages/experiment-evaluation-runs/EvalRunsUnifiedSearch.test.tsx","lines":["@@ -135,6 +135,38 @@ describe('EvalRunsUnifiedSearch', () => {","     expect(screen.getByTestId('compiled-search')).toHaveTextContent(\"attributes.run_name ILIKE 'foo'\");","   });"," ","+  test.each([","+    \"metric.f1_score > 0.9 AND params.model = 'tree'\",","+    \"dataset.name IN ('dataset1', 'dataset2')\",","+    \"attributes.run_id IN ('a1b2c3d4', 'e5f6g7h8')\",","+    \"tags.model_class LIKE 'sklearn.linear_model%'\",","+  ])('submits the search help example %s as a raw SearchRuns expression', async (expression) => {","+    const user = userEvent.setup();","+    renderWithDesignSystem(<Harness />);","+","+    const search = screen.getByRole('combobox', { name: 'Search evaluation runs' });","+    await user.click(search);","+    await user.paste(expression);","+    await user.keyboard('{Enter}');","+","+    // Exact match: a run-name search would wrap the expression in `attributes.run_name ILIKE '%…%'`.","+    expect(screen.getByTestId('compiled-search').textContent).toBe(expression);","+  });","+","+  test('shows the search syntax help with examples and a docs link', async () => {","+    const user = userEvent.setup();","+    renderWithDesignSystem(<Harness />);","+",