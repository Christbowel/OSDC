tic const case_insensitive_map_t<PEGRuleId> lookup = [] {\\n\")","+    cpp.append(\"\\t\\tcase_insensitive_map_t<PEGRuleId> result;\\n\")","+    cpp.append(\"\\t\\tfor (uint32_t i = 1; i < static_cast<uint32_t>(PEGRuleId::BUILTIN_COUNT); i++) {\\n\")","+    cpp.append(\"\\t\\t\\tresult.emplace(PEG_RULE_NAMES[i], static_cast<PEGRuleId>(i));\\n\")","+    cpp.append(\"\\t\\t}\\n\")","+    cpp.append(\"\\t\\treturn result;\\n\")","+    cpp.append(\"\\t}();\\n\")","+    cpp.append(\"\\tauto entry = lookup.find(rule_name);\\n\")","+    cpp.append(\"\\treturn entry == lookup.end() ? PEGRuleId::INVALID : entry->second;\\n\")","+    cpp.append(\"}\\n\\n\")","+    cpp.append(\"} // namespace duckdb\\n\")","+    rule_id_cpp_path.write_text(\"\".join(cpp))","+    print(f\"Updated {rule_id_cpp_path}\")","+","+"," def write_matcher_rule_overrides(matcher_overrides):","     content = matcher_override_cpp_path.read_text()","     lines = []","@@ -1632,6 +1710,7 @@ def main():","         write_packrat_memoized_rules(packrat_rules)","         write_collapsible_rules(collapsible_rules)","         write_expression_depth_rules(*load_expression_depth_rules(grammar_types_file, all_rules.keys()))","+        write_rule_ids(all_rules)","     elif args.report:","         print(f\"grammar files: {', '.join(grammar_files)}\")","         print(emitter.emit_report())"],"additions":88,"deletions":9,"truncated":false},{"path":"scripts/parser/grammar_types.py","lines":["@@ -14,7 +14,7 @@ class GrammarTypeInfo:","     cpp_type: str","     by_value: bool = False  # True for unique_ptr<T>, vector<unique_ptr<T>> (non-copyable)","     default_initializer: str = \"\"  # Optional enum member/full C++ initializer for Optional(...) values","-    pass_location: bool = False  # Pass parse_result.offset to the hand-written body","+    pass_location: bool = False  # Pass the parse result's offset to the hand-written body"," "," "," def load_grammar_types_yaml(types_file):"],"additions":1,"deletions":1,"truncated"