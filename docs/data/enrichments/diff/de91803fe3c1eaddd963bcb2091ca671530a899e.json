{"id":"de91803fe3c1eaddd963bcb2091ca671530a899e","axis":"silent","repo":"open-telemetry/opentelemetry-collector","sha":"de91803fe3c1eaddd963bcb2091ca671530a899e","parsed":{"files":[{"path":".chloggen/codeboten_fix-mdatagen-escape-values.yaml","lines":["@@ -0,0 +1,25 @@","+# Use this changelog template to create an entry for release notes.","+","+# One of 'breaking', 'deprecation', 'new_component', 'enhancement', 'bug_fix'","+change_type: bug_fix","+","+# The name of the component, or a single word describing the area of concern, (e.g. receiver/otlp)","+component: cmd/mdatagen","+","+# A brief description of the change.  Surround your text with quotes (\"\") if it needs to start with a backtick (`).","+note: Ensure metadata values are escaped in templates","+","+# One or more tracking issues or pull requests related to the change","+issues: [16396]","+","+# (Optional) One or more lines of additional information to render under the primary note.","+# These lines will be padded with 2 spaces and then inserted directly into the document.","+# Use pipe (|) for multiline entries.","+subtext:","+","+# Optional: The change log or logs in which this entry should be included.","+# e.g. '[user]' or '[user, api]'","+# Include 'user' if the change is relevant to end users.","+# Include 'api' if there is a change to a library API.","+# Default: '[user]'","+change_logs: []"],"additions":25,"deletions":0,"truncated":false},{"path":"cmd/mdatagen/internal/command_test.go","lines":["@@ -10,6 +10,7 @@ import ("," \t\"go/token\""," \t\"os\""," \t\"path/filepath\"","+\t\"strconv\""," \t\"strings\""," \t\"testing\""," ","@@ -2348,3 +2349,82 @@ func TestGenerateConfigFiles_ReadmeLinksObjectRefToExportedSection(t *testing.T)"," \trequire.Contains(t, readme, \"| `child` | object (see [exported_configs.inner](#exported_configs.inner)) |\")"," \trequire.NotContains(t, readme, \"exported_configs.outer.child\")"," }","+","+// TestRunQuotedDescriptions verifies that descriptions coming from metadata.yaml are rendered as","+// properly escaped Go string literals, so that a description cannot close the literal and inject","+// code or a //go:generate directive into the generated files.","+func TestRunQuotedDescriptions(t *testing.T) {","+\tconst (","+\t\tmetricDescription = \"Number of requests.\\\" + `\\n//go:generate sh -c \\\"id > /tmp/metric-description\\\"\\n`[:0] + \\\"\"","+\t\tgateDescription   = \"Gate \\\" + `\\n//go:generate sh -c \\\"id > /tmp/gate-description\\\"\\n`[:0] + \\\"\"","+\t)","+","+\ttmpdir := filepath.Join(t.TempDir(), \"shortname\")","+\trequire.NoError(t, os.MkdirAll(tmpdir, 0o750))","+\tymlContent, err := os.ReadFile(filepath.Join(\"testdata\", \"quoted_descriptions.yaml\"))","+\trequire.NoError(t, err)","+\tmetadataFile := filepath.Join(tmpdir, \"metadata.yaml\")","+\trequire.NoError(t, os.WriteFile(metadataFile, ymlContent, 0o600)) // #nosec G703","+\trequire.NoError(t, os.WriteFile(filepath.Join(tmpdir, \"empty.go\"), []byte(\"package shortname\"), 0o600))","+\trequire.NoError(t, os.WriteFile(filepath.Join(tmpdir, \"go.mod\"), []byte(\"module shortname\"), 0o600))","+\trequire.NoError(t, os.WriteFile(filepath.Join(tmpdir, \"README.md\"), []byte(\"<!-- status autogenerated section -->\\nfoo\\n<!-- end autogenerated section -->\"), 0o600))","+","+\trequire.NoError(t, run(metadataFile))","+","+\tgeneratedDir := filepath.Join(tmpdir, \"internal\", \"metadata\")","+\tmetrics, err := os.ReadFile(filepath.Clean(filepath.Join(generatedDir, \"generated_metrics.go\")))","+\trequire.NoError(t, err)","+\tmetricsTest, err := os.ReadFile(filepath.Clean(filepath.Join(generatedDir, \"generated_metrics_test.go\")))","+\trequire.NoError(t, err)","+\tgates, err := os.ReadFile(filepath.Clean(filepath.Join(generatedDir, \"generated_feature_gates.go\")))","+\trequire.NoError(t, err)","+","+\tassert.Contains(t, string(metrics), \"m.data.SetDescription(\"+strconv.Quote(metricDescription)+\")\")","+\tassert.Contains(t, string(metricsTest), strconv.Quote(metricDescription))","+\tassert.Contains(t, string(gates), \"featuregate.WithRegisterDescription(\"+strconv.Quote(gateDescription)+\")\")","+","+\t// No generated file may contain a go:generate directive at the start of a line.","+\tfiles, err := os.ReadDir(generatedDir)","+\trequire.NoError(t, err)","+\tfor _, f := range files {","+\t\tif f.IsDir() {","+\t\t\tcontinue","+\t\t}","+\t\tcontent, err := os.ReadFile(filepath.Clean(filepath.Join(generatedDir, f.Name())))","+\t\trequire.NoError(t, err)","+\t\tassert.NotRegexp(t, `(?m)^//go:generate`, string(content), f.Name())","+\t}","+}","+","+// TestRunConfigCommentsDoNotInjectDirectives checks that multi-line values written into","+// the comment above the generated Config struct stay inside that comment.","+func TestRunConfigCommentsDoNotInjectDirectives(t *testing.T) {","+\ttmpdir := filepath.Join(t.TempDir(), \"shortname\")","+\trequire.NoError(t, os.MkdirAll(tmpdir, 0o750))","+\tymlContent, readErr := os.ReadFile(filepath.Join(\"testdata\", \"hostile_config_comments.yaml\"))","+\trequire.NoError(t, readErr)","+\tmetadataFile := filepath.Join(tmpdir, \"metadata.yaml\")","+\trequire.NoError(t, os.WriteFile(metadataFile, ymlContent, 0o600)) // #nosec G703","+\trequire.NoError(t, os.WriteFile(filepath.Join(tmpdir, \"empty.go\"), []byte(\"package shortname\"), 0o600))","+\trequire.NoError(t, os.WriteFile(filepath.Join(tmpdir, \"go.mod\"), []byte(\"module shortname\"), 0o600))","+\trequire.NoError(t, os.WriteFile(filepath.Join(tmpdir, \"README.md\"), []byte(\"<!-- status autogenerated section -->\\nfoo\\n<!-- end autogenerated section -->\"), 0o600))","+","+\trequire.NoError(t, run(metadataFile))","+","+\t// The Config struct is generated next to metadata.yaml.","+\tfor _, dir := range []string{tmpdir, filepath.Join(tmpdir, \"internal\", \"metadata\")} {","+\t\tfiles, err := os.ReadDir(dir)","+\t\trequire.NoError(t, err)","+\t\tfor _, f := range files {","+\t\t\tif f.IsDir() || filepath.Ext(f.Name()) != \".go\" {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tcontent, err := os.ReadFile(filepath.Clean(filepath.Join(dir, f.Name())))","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.NotRegexp(t, `(?m)^//go:generate`, string(content), f.Name())","+\t\t}","+\t}","+\tcfg, readErr := os.ReadFile(filepath.Clean(filepath.Join(tmpdir, \"generated_config.go\")))","+\trequire.NoError(t, readErr)","+\tassert.Contains(t, string(cfg), \"// //go:generate sh -c \\\"id > /tmp/config-description\\\"\")","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"cmd/mdatagen/internal/templates/config_from_cfggen.go.tmpl","lines":["@@ -114,9 +114,9 @@ import ("," "," {{- if $hasConfig }}","     {{- if .Metadata.Config.Description }}","-        // {{ .Metadata.Config.Description }}","+        {{ .Metadata.Config.Description | goComment }}","     {{- else }}","-        // Config defines the configuration for {{ .Metadata.DisplayName }} component.","+        {{ printf \"Config defines the configuration for %s component.\" .Metadata.DisplayName | goComment }}","     {{- end }}","     {{- if .Metadata.Config.Deprecated }}","         {{ printf \"Deprecated: [%s] %s\" .Metadata.Config.Deprecated.Since .Metadata.Config.Deprecated.Note | goComment }}"],"additions":2,"deletions":2,"truncated":false},{"path":"cmd/mdatagen/internal/templates/feature_gates.go.tmpl","lines":["@@ -11,11 +11,11 @@ import ("," var {{ printf \"%s\" $gate.ID | publicVar }}FeatureGate = featuregate.GlobalRegistry().MustRegister("," \t\"{{ $gate.ID }}\","," \tfeaturegate.Stage{{ printf \"%s\" $gate.Stage | casesTitle }},","-\tfeaturegate.WithRegisterDescription(\"{{ $gate.Description }}\"),","-\tfeaturegate.WithRegisterReferenceURL(\"{{ $gate.ReferenceURL }}\"),","-\tfeaturegate.WithRegisterFromVersion(\"{{ $gate.FromVersion }}\"),","+\tfeaturegate.WithRegisterDescription({{ printf \"%q\" $gate.Description }}),","+\tfeaturegate.WithRegisterReferenceURL({{ printf \"%q\" $gate.ReferenceURL }}),","+\tfeaturegate.WithRegisterFromVersion({{ pri