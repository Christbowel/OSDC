ICAL_AGGREGATE_AND_GROUP_BY: {","+\t\tauto &aggregate = op.Cast<LogicalAggregate>();","+\t\tfor (idx_t i = 0; i < aggregate.groups.size(); i++) {","+\t\t\tif (is_compared(aggregate.group_index, i)) {","+\t\t\t\tadd_sources(*aggregate.groups[i]);","+\t\t\t}","+\t\t}","+\t\tbreak;","+\t}","+\tcase LogicalOperatorType::LOGICAL_UNION:","+\tcase LogicalOperatorType::LOGICAL_EXCEPT:","+\tcase LogicalOperatorType::LOGICAL_INTERSECT: {","+\t\tauto &setop = op.Cast<LogicalSetOperation>();","+\t\tfor (auto &child : setop.children) {","+\t\t\tauto child_bindings = child->GetColumnBindings();","+\t\t\tfor (idx_t i = 0; i < MinValue<idx_t>(setop.column_count, child_bindings.size()); i++) {","+\t\t\t\tif (is_compared(setop.table_index, i)) {","+\t\t\t\t\tbindings.insert(child_bindings[i]);","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tbreak;","+\t}","+\tcase LogicalOperatorType::LOGICAL_MATERIALIZED_CTE: {","+\t\t// the references to the CTE are in the query that uses it: trace that before the definition","+\t\tcte_bindings[op.Cast<LogicalMaterializedCTE>().table_index] = op.children[0]->GetColumnBindings();","+\t\tAddSourceBindings(*op.children[1], bindings, cte_bindings);","+\t\tAddSourceBindings(*op.children[0], bindings, cte_bindings);","+\t\treturn;","+\t}","+\tcase LogicalOperatorType::LOGICAL_CTE_REF: {","+\t\tauto &cte_ref = op.Cast<LogicalCTERef>();","+\t\tauto entry = cte_bindings.find(cte_ref.cte_index);","+\t\tif (entry == cte_bindings.end()) {","+\t\t\tbreak;","+\t\t}","+\t\tauto &definition_bindings = entry->second;","+\t\tfor (idx_t i = 0; i < MinValue<idx_t>(cte_ref.chunk_types.size(), definition_bindings.size()); i++) {","+\t\t\tif (is_compared(cte_ref.table_index, i)) {","+\t\t\t\tbindings.insert(definition_bindings[i]);","+\t\t\t}","+\t\t}","+\t\tbreak;","+\t}","+\tdefault:","+\t\tbreak;","+\t}","+\tfor (auto &child : op.children) {","+\t\tAddSourceBindings(*child, bindings, cte_bindings);","+\t}","+}","+","+//! Whether a scan of the plan emits one of the bindings from a column that holds only NULLs","+static bool ScansAllNullBinding(ClientContext &context, LogicalOperator &op, const column_binding_set_t &bindings) {","+\tif (op.type == LogicalOperatorType::LOGICAL_GET) {","+\t\tauto &get = op.Cast<LogicalGet>();","+\t\tauto &column_ids = get.GetColumnIds();","+\t\tfor (idx_t i = 0; i < column_ids.size(); i++) {","+\t\t\tif (bindings.find(ColumnBinding(get.table_index, ProjectionIndex(i))) == bindings.end()) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tauto stats = StatisticsPropagator::GetColumnStatistics(context, get, column_ids[i]);","+\t\t\tif (StatisticsPropagator::HasNoValidValue(stats.get())) {","+\t\t\t\treturn true;","+\t\t\t}","+\t\t}","+\t}","+\tfor (auto &child : op.children) {","+\t\tif (ScansAllNullBinding(context, *child, bindings)) {","+\t\t\treturn true;","+\t\t}","+\t}","+\treturn false;","+}","+","+bool FilterStatisticsOptimizer::ComparesAllNullColumn(LogicalOperator &plan) const {","+\tif (optimizer.OptimizerDisabled(OptimizerType::STATISTICS_PROPAGATION)) {","+\t\treturn false;","+\t}","+\tcolumn_binding_set_t bindings;","+\tGetComparedBindings(plan, bindings);","+\tif (bindings.empty()) {","+\t\treturn false;","+\t}","+\tunordered_map<TableIndex, vector<ColumnBinding>> cte_bindings;","+\tAddSourceBindings(plan, bindings, cte_bindings);","+\treturn ScansAllNullBinding(optimizer.context, plan, bindings);","+}","+"," void FilterStatisticsOptimizer::Optimize(unique_ptr<LogicalOperator> &plan) {","-\tif (ContainsDelimJoin(*plan) || !HasMultiBindingFilter(*plan)) {","+\tif (ContainsDelimJoin(*plan)) {","+\t\treturn;","+\t}","+\t// a comparison with a column that holds only NULLs never passes: propagating the statistics here removes","+\t// the filters and joins on it before the join order is chosen","+\tif (!HasMultiBindingFilter(*plan) && !ComparesAllNullColumn(*plan)) {"," \t\treturn;"," \t}"," "],"additions":153,"deletions":1,"truncated":false},{"path":"src/optimizer/statistics/expression/propagate_between.cpp"