 -234,8 +234,6 @@ describe(\"queued-operation query-memory load shedding\", function () {","     itPerEngine(","         \"with load shedding disabled, a queued getMore is admitted when the ticket frees\",","         function () {","-            // The loadShedding serverStatus section only exists while the feature is enabled, so","-            // capture the baseline first.","             const shedBefore = loadSheddingStats(db).operationsShed;","             setParam(db, {queryMemoryLoadSheddingLowMarkPercent: -1});","             const cursorId = openGroupCursor(coll);","@@ -268,8 +266,9 @@ describe(\"queued-operation query-memory load shedding\", function () {","                 });","                 // Give the disabled feature many intervals to misbehave.","                 sleep(500);","-                // While disabled there is no loadShedding serverStatus section at all.","-                assert.eq(undefined, loadSheddingStats(db));","+                const stats = loadSheddingStats(db);","+                assert.eq(false, stats.active, tojson(stats));","+                assert.eq(shedBefore, stats.operationsShed, \"disabled shedding must not shed\");","                 assert.eq(1, queuedReaders(db), \"getMore should still be queued\");","                 pressureFp.off();","             });"],"additions":3,"deletions":4,"truncated":false},{"path":"src/mongo/db/memory_tracking/BUILD.bazel","lines":["@@ -127,6 +127,7 @@ mongo_cc_unit_test(","         \"//src/mongo/otel/metrics:metrics_test_util\",","         \"//src/mongo/otel/metrics:otel_metrics_service\",","         \"//src/mongo/unittest\",","+        \"//src/mongo/util:mock_periodic_runner\",","     ],"," )"," "],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/memory_tracking/query_memory_load_shedding.cpp","lines":["@@ -52,6 +52,8 @@ struct QueryMemoryLoadSheddingState {","     // Written (fetchAndAdd) on every shed. On its own cache line so those writes don't invalidate","     // the read-hot rssBytes/memLimitBytes line for the interrupt-check path (avoids false sharing).","     CacheExclusive<AtomicWord<long long>> operationsShed{0};","+    // Tracked memory held by shed operations, across all shed paths.","+    CacheExclusive<AtomicWord<long long>> bytesShed{0};"," ","     // Cursors reaped while idle, and the tracked memory they held. These totals are also included","     // in 'operationsShed' but tracked separately to distinguish the different classes of shedding.","@@ -116,9 +118,20 @@ constexpr Milliseconds kMaxShedEvalDt{1000};"," struct QueryMemoryRssMonitorHolder {","     std::mutex mutex;","     std::shared_ptr<PeriodicJobAnchor> anchor;","+    // Start time of the current active period, or none while inactive.","+    boost::optional<Date_t> activeSince;","+    // Total duration of completed active periods.","+    Milliseconds completedActiveTime{0};"," };"," const auto getMonitorHolder = ServiceContext::declareDecoration<QueryMemoryRssMonitorHolder>();"," ","+// Duration of the current active period, clamped so a wall-clock step back can't shrink the total.","+Milliseconds currentActiveTime(ServiceContext* serviceContext,","+                               const QueryMemoryRssMonitorHolder& holder) {","+    return std::max(Milliseconds{0},","+                    serviceContext->getFastClockSource()->now() - *holder.activeSince);","+}","+"," // Test-only: overrides the RSS signal. Data {usagePercent: <int>} = percent of the memory limit."," MONGO_FAIL_POINT_DEFINE(queryMemoryPressureOverride);"," ","@@ -165,6 +178,14 @@ otel::metrics::Counter<int64_t>& operationsShedCounter() {","     return counter;"," }"," ","+otel::metrics::Counter<int64_t>& bytesShedCounter() {","+    static auto& counter = otel::metrics::MetricsService::instance().createInt64Counter(","+        otel::metrics::MetricNames::kQueryMemoryLoadSheddingBytesShed,","+        \"Tracked query memory held by operations shed due to query-memory pressure\",","+        otel::metrics::MetricUnit::kBytes);","+    return counter;","+}","+"," // The pressure inputs for one shed evaluation, read together so a single decision is"," // self-consistent."," struct PressureSnapshot {","@@ -259,6 +280,8 @@ void recordShed(QueryMemoryLoadSheddingState& processState,","                 bool waitingForTicket) {","     const long long total = processState.operationsShed->fetchAndAdd(1) + 1;","     operationsShedCounter().add(1);","+    processState.bytesShed->fetchAndAdd(opTrackedBytes);","+    bytesShedCounter().add(opTrackedBytes);","     // Rate-limit to one full line per second to avoid flooding the log under sustained pressure;","     // subsequent lines within the second drop to a debug severity.","     static logv2::SeveritySuppressor logSeverity{","@@ -537,6 +560,8 @@ IdleQueryShedDecision queryMemoryShouldShedIdleQuery(OperationContext* opCtx,","     decision.shed = true;","     processState.operationsShed->fetchAndAdd(1);","     operationsShedCounter().add(1);","+    processState.bytesShed->fetchAndAdd(trackedBytes);","+    bytesShedCounter().add(trackedBytes);","     processState.idleShed->cursors.fetchAndAdd(1);","     idleCursorsShedCounter().add(1);","     processState.idleShed->bytes.fetchAndAdd(trackedBytes);","@@ -552,20 +577,38 @@ boost::optional<Milliseconds> queryMemoryIdleQuerySheddingInterval() {"," }"," "," void appendQueryMemoryLoadSheddingStats(ServiceContext* serviceContext, BSONObjBuilder& b) {","-    if (!sheddingActive()) {","+    if (!loadSheddingSupportedOnThisProcess()) {","         return;","     }","+    bool active;","+    Milliseconds activeTime;","+    {","+        auto& holder = getMonitorHolder(serviceContext);","+        std::lock_guard lk(holder.mutex);","+        active = holder.activeSince.has_value();","+        activeTime = holder.completedActiveTime;","+        if (active) {","+            activeTime += currentActiveTime(serviceContext, holder);","+        }","+    }","     auto& processState = getProcessState(serviceContext);","-    const int64_t memLimit = processState.memLimitBytes.loadRelaxed();","-    const int32_t lowPct = gQueryMemoryLoadSheddingLowMarkPercent.loadRelaxed();","-    const int32_t highPct = gQueryMemoryLoadSheddingHighMarkPercent.loadRelaxed();","-    const int64_t rss = processState.rssBytes.loadRelaxed();","     BSONObjBuilder sub(b.subobjStart(\"loadShedding\"));","-    sub.appendNumber(\"currentUsageBytes\", static_cast<long long>(rss < 0 ? 0 : rss));","-    sub.appendNumber(\"lowMarkBytes\", static_cast<long long>(memLimit * lowPct / 100));","-    sub.appendNumber(\"highMarkBytes\", static_cast<long long>(memLimit * highPct / 100));","-    sub.appendNumber(\"memLimitBytes\", static_cast<long long>(memLimit));","+    sub.append(\"active\", active);","+    // The RSS sample and water marks are only meaningful while the monitor runs.","+    if (active) {","+        const int64_t memLimit = processState.memLimitBytes.loadRelaxed();","+        const int32_t lowPct = gQueryMemoryLoadSheddingLowMarkPercent.loadRelaxed();","+        const int32_t highPct = gQueryMemoryLoadSheddingHighMarkPercent.loadRelaxed();","+        const int64_t rss = processState.rssBytes.loadRelaxed();","+        sub.appendNumber(\"currentUsageBytes\", static_cast<long long>(rss < 0 ? 0 : rss));","+        sub.appendNumber(\"lowMarkBytes\", static_cast<long long>(memLimit * lowPct / 100));","+        sub.appendNumber(\"highMarkBytes\", static_cast<long long>(memLimit * highPct / 100));","+        sub.appendNumber(\"memLimitBytes\", static_cast<long long>(memLimit));","+    }","+    // Cumulative counters are always reported so consumers see no gaps across enable/disable.","+    sub.appendNumber(\"activeMillis\", durationCount<Milliseconds>(activeTime));","     sub.appendNumber(\"operationsShed\", processState.operationsShed->loadRelaxed());","+    sub.appendNumber(\"bytesShed\", processState.bytesShed->loadRelaxed());","     sub.appendNumber(\"idleCursorsShed\", processState.idleShed->cursors.loadRelaxed());","     sub.appendNumber(\"idleCursorBytesShed\", processState.idleShed->bytes.loadRelaxed());"," }","@@ -630,6 +673,7 @@ void startQueryMemoryRssMonitor(ServiceContext* serviceContext, bool ignoreWhenN","         /*isKillableByStepdown=*/false);","     holder.anchor = std::make_shared<PeriodicJobAnchor>(runner->makeJob(std::move(job)));","     holder.anchor->start();","+    holder.activeSince = serviceContext->getFastClockSource()->now();"," }"," "," void stopQueryMemoryRssMonitor(ServiceContext* serviceContext) {","@@ -638,6 +682,10 @@ void stopQueryMemoryRssMonitor(ServiceContext* serviceContext) {","         auto& holder = getMonitorHolder(serviceContext);","         std::lock_guard lk(holder.mutex);","         anchor = std::exchange(holder.anchor, nullptr);","+        if (holder.activeSince) {","+            holder.completedActiveTime += currentActiveTime(serviceContext, holder);","+            holder.activeSince = boost::none;","+        }","     }","     // stop() blocks until the sampler has quiesced; do it outside the lock so we don't hold the","     // mutex during that wait."],"additions":57,"deletions":9,"truncated":false},{"path":"src/mongo/db/memory_tracking/query_memory_load_shedding.h","lines":["@@ -101,7 +101,8 @@ struct IdleQueryShedDecision {"," [[MONGO_MOD_PUBLIC]] boost::optional<Milliseconds> queryMemoryIdleQuerySheddingInterval();"," "," /**","- * Appends the load-shedding metrics to 'b'. No-op when disabled.","+ * Appends the load-shedding metrics to 'b'. No-op if the process does not support shedding.","+ * More details are included if load shedding is currently active.","  */"," void appendQueryMemoryLoadSheddingStats(ServiceContext* serviceContext, BSONObjBuilder& b);"," "],"additions":2,"deletions":1,"truncated":false},{"path":"src/mongo/db/memory_tracking/query_memory_load_shedding_test.cpp","lines":["@@ -22,6 +22,7 @@"," #include \"mongo/unittest/unittest.h\""," #include \"mongo/util/clock_source_mock.h\""," #include \"mongo/util/fail_point.h\"","+#include \"mongo/util/mock_periodic_runner.h\""," #include \"mongo/util/scopeguard.h\""," #include \"mongo/util/time_support.h\""," ","@@ -324,6 +325,9 @@ TEST_F(QueryMemoryLoadSheddingCheckTest, ShedIncrementsOtelOperationsShedCounter","         ASSERT_EQ(capturer.readInt64Counter(","                       otel::metrics::MetricNames::kQueryMemoryLoadSheddingOperationsShed),","                   1);","+        ASSERT_EQ(capturer.readInt64Counter(","+                      otel::metrics::MetricNames::kQueryMemoryLoadSheddingBytesShed),","+                  1 << 20);","     }"," }"," ","@@ -570,10 +574,10 @@ class QueryMemoryLoadSheddingQueuedSweepTest : public ClockSourceMockServiceCont","         });","         waitUntilQueued(waiterOpCtx);"," ","-        const long long shedBefore = [&] {","+        const BSONObj before = [&] {","             BSONObjBuilder b;","             appendQueryMemoryLoadSheddingStats(getServiceContext(), b);","-            return b.obj()[\"loadShedding\"][\"operationsShed\"].numberLong();","+            return b.obj().getObjectField(\"loadShedding\").getOwned();","         }();"," ","         // First pass only primes the sweep clock for the newly observed queued op.","@@ -599,8 +603,9 @@ class QueryMemoryLoadSheddingQueuedSweepTest : public ClockSourceMockServiceCont","         // Hold the builder's obj so 'after' does not view a buffer owned by a temporary.","         BSONObj statsObj = b.obj();","         const BSONObj after = statsObj[\"loadShedding\"].Obj();","-        // The queued sweep's shed is counted in operationsShed like any other shed.","-        ASSERT_EQ(after[\"operationsShed\"].numberLong(), shedBefore + 1);","+        // The queued sweep's shed is counted like any other shed.","+        ASSERT_EQ(after[\"operationsShed\"].numberLong(), before[\"operationsShed\"].numberLong() + 1);","+        ASSERT_EQ(after[\"bytesShed\"].numberLong(), before[\"bytesShed\"].numberLong() + (1 << 20));","     }"," };"," ","@@ -891,6 +896,7 @@ TEST_F(QueryMemoryLoadSheddingIdleTest, ShedCountsCursorsAndBytes) {","     const BSONObj after = readStats();","     // The idle shed is included in the comprehensive operationsShed total.","     ASSERT_EQ(after[\"operationsShed\"].numberLong(), before[\"operationsShed\"].numberLong() + 1);","+    ASSERT_EQ(after[\"bytesShed\"].numberLong(), before[\"bytesShed\"].numberLong() + kTrackedBytes);","     // And in the idle-specific breakdown.","     ASSERT_EQ(after[\"idleCursorsShed\"].numberLong(), before[\"idleCursorsShed\"].numberLong() + 1);","     ASSERT_EQ(after[\"idleCursorBytesShed\"].numberLong(),","@@ -907,6 +913,9 @@ TEST_F(QueryMemoryLoadSheddingIdleTest, ShedCountsCursorsAndBytes) {","         ASSERT_EQ(capturer.readInt64Counter(","                       otel::metrics::MetricNames::kQueryMemoryLoadSheddingIdleCursorBytesShed),","                   kTrackedBytes);","+        ASSERT_EQ(capturer.readInt64Counter(","+                      otel::metrics::MetricNames::kQueryMemoryLoadSheddingBytesShed),","+                  kTrackedBytes);","     }"," }"," ","@@ -923,5 +932,97 @@ TEST_F(QueryMemoryLoadSheddingIdleTest, SheddingIntervalOnlyReportedWhileEnabled","               Milliseconds(gQueryMemoryIdleCursorSheddingIntervalMillis.load()));"," }"," ","+// The cumulative shed counters stay in serverStatus while shedding is disabled, so a consumer","+// computing a shed rate sees no gaps as shedding is toggled.","+TEST_F(QueryMemoryLoadSheddingIdleTest, ShedCountersReportedWhileDisabled) {","+    auto restore = scopedRestoreMarks();","+    gQueryMemoryLoadSheddingLowMarkPercent.store(50);  // enable (high mark stays default)","+    ON_BLOCK_EXIT([] {","+        globalFailPointRegistry().find(\"queryMemoryPressureOverride\")->setMode(FailPoint::off);","+        globalFailPointRegistry()","+            .find(\"queryMemoryLoadSheddingAlwaysShed\")","+            ->setMode(FailPoint::off);","+    });","+","+    auto readStats = [&] {","+        BSONObjBuilder b;","+        appendQueryMemoryLoadSheddingStats(getServiceContext(), b);","+        return b.obj().getObjectField(\"loadShedding\").getOwned();","+    };","+","+    auto* opCtx = getExpCtx()->getOperationContext();","+    markOperationQueryMemorySheddingEligible(opCtx);","+    setPressureOverride(95);","+    globalFailPointRegistry()","+        .find(\"queryMemoryLoadSheddingAlwaysShed\")","+        ->setMode(FailPoint::alwaysOn);","+    ASSERT_TRUE(queryMemoryShouldShedIdleQuery(opCtx, 1 << 20).shed);","+    const BSONObj enabled = readStats();","+    ASSERT_GT(enabled[\"operationsShed\"].numberLong(), 0);","+","+    gQueryMemoryLoadSheddingLowMarkPercent.store(-1);","+    const BSONObj disabled = readStats();","+    for (auto field : {\"operationsShed\", \"bytesShed\", \"idleCursorsShed\", \"idleCursorBytesShed\"}) {","+        ASSERT_EQ(disabled[field].numberLong(), enabled[field].numberLong()) << field;","+    }","+}","+","+// Runs the real RSS monitor lifecycle on a mock periodic runner and mock clock.","+class QueryMemoryLoadSheddingMonitorTest : public ClockSourceMockServiceContextTest {","+public:","+    void setUp() override {","+        ClockSourceMockServiceContextTest::setUp();","+        getServiceContext()->setPeriodicRunner(std::make_unique<MockPeriodicRunner>());","+    }","+","+    void tearDown() override {","+        stopQueryMemoryRssMonitor(getServiceContext());","+        ClockSourceMockServiceContextTest::tearDown();","+    }","+","+    BSONObj readStats() {","+        BSONObjBuilder b;","+        appendQueryMemoryLoadSheddingStats(getServiceContext(), b);","+        return b.obj().getObjectField(\"loadShedding\").getOwned();","+    }","+","+    void advance(Milliseconds ms) {","+        static_cast<ClockSourceMock*>(getServiceContext()->getFastClockSource())->advance(ms);","+    }","+","+    static void assertThresholdFields(const BSONObj& stats, bool present) {","+        for (auto field : {\"currentUsageBytes\", \"lowMarkBytes\", \"highMarkBytes\", \"memLimitBytes\"}) {","+            ASSERT_EQ(stats.hasField(field), present) << field << \" \" << stats;","+        }","+    }","+};","+","+// Shedding is active while the monitor runs. activeMillis grows during an active period and holds","+// while inactive.","+TEST_F(QueryMemoryLoadSheddingMonitorTest, ActiveMillisAccumulatesWhileMonitorRuns) {","+    auto restore = scopedRestoreMarks();","+    gQueryMemoryLoadSheddingLowMarkPercent.store(50);","+    auto* svcCtx = getServiceContext();","+","+    BSONObj stats = readStats();","+    ASSERT_FALSE(stats[\"active\"].Bool());","+    ASSERT_EQ(stats[\"activeMillis\"].numberLong(), 0);","+    assertThresholdFields(stats, false);","+","+    startQueryMemoryRssMonitor(svcCtx);","+    advance(Milliseconds(100));","+    stats = readStats();","+    ASSERT_TRUE(stats[\"active\"].Bool());","+    ASSERT_EQ(stats[\"activeMillis\"].numberLong(), 100);","+    assertThresholdFields(stats, true);","+","+    stopQueryMemoryRssMonitor(svcCtx);","+    advance(Milliseconds(50));","+    stats = readStats();","+    ASSERT_FALSE(stats[\"active\"].Bool());","+    ASSERT_EQ(stats[\"activeMillis\"].numberLong(), 100);","+    assertThresholdFields(stats, false);","+}","+"," }  // namespace"," }  // namespace mongo"],"additions":105,"deletions":4,"truncated":false},{"path":"src/mongo/db/memory_tracking/query_memory_server_status_section.cpp","lines":["@@ -7,9 +7,10 @@"," namespace mongo {"," namespace {"," ","-// serverStatus().queryMemory -- query-memory metrics. Holds the load-shedding decision state","-// (current RSS usage, the water marks, the memory limit, and the shed count) when load shedding is","-// enabled; the \"queryMemory\" parent leaves room for future query memory-tracking metrics.","+// serverStatus().queryMemory -- query-memory metrics. On shedding-eligible processes holds the","+// load-shedding state: whether shedding is active, the cumulative shed counters, and (while active)","+// the current RSS usage, water marks, and memory limit. The \"queryMemory\" parent leaves room for","+// future query memory-tracking metrics."," class QueryMemoryServerStatusSection : public ServerStatusSection {"," public:","     using ServerStatusSection::ServerStatusSection;"],"additions":4,"deletions":3,"truncated":false},{"path":"src/mongo/otel/metrics/metric_names.h","lines":["@@ -344,6 +344,8 @@ class MetricNames {","     // Query Execution Team Metrics","     static constexpr MetricName kQueryMemoryLoadSheddingOperationsShed =","         MetricNameMaker::make(\"mongodb.serverStatus.queryMemory.loadShedding.operationsShed\");","+    static constexpr MetricName kQueryMemoryLoadSheddingBytesShed =","+        MetricNameMaker::make(\"mongodb.serverStatus.queryMemory.loadShedding.bytesShed\");","     static constexpr MetricName kQueryMemoryLoadSheddingIdleCursorsShed =","         MetricNameMaker::make(\"mongodb.serverStatus.queryMemory.loadShedding.idleCursorsShed\");","     static constexpr MetricName kQueryMemoryLoadSheddingIdleCursorBytesShed =",""],"additions":2,"deletions":0,"truncated":false}],"additions":229,"deletions":49,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-13T17:05:14.617493+00:00"}