{"id":"6eaa09d6639664bcdce99733ce56e2b6a198111a","axis":"silent","repo":"ray-project/ray","sha":"6eaa09d6639664bcdce99733ce56e2b6a198111a","parsed":{"files":[{"path":"doc/source/data/inspecting-data.md","lines":["@@ -45,7 +45,13 @@ print(ds)"," ```"," "," ```{testoutput}","-Dataset(num_rows=..., schema=...)","+shape: (?, 5)","+╭───────────────────┬──────────────────┬───────────────────┬──────────────────┬────────╮","+│ sepal length (cm) ┆ sepal width (cm) ┆ petal length (cm) ┆ petal width (cm) ┆ target │","+│ ---               ┆ ---              ┆ ---               ┆ ---              ┆ ---    │","+│ double            ┆ double           ┆ double            ┆ double           ┆ int64  │","+╰───────────────────┴──────────────────┴───────────────────┴──────────────────┴────────╯","+(Dataset isn't materialized)"," ```"," "," (inspecting-rows)="],"additions":7,"deletions":1,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/common/actor_pool.py","lines":["@@ -0,0 +1,140 @@","+\"\"\"The actor-pool protocol shared by the footer and header reader pools.","+","+Parquet footer reads and CSV header reads both run in a pool of Ray actors","+for one ``list_files`` call: several SPREAD-scheduled actors, batches handed","+out round-robin with a bounded in-flight window, results delivered in","+dispatch order, then every actor killed. The pool is made on first use, so","+a listing that needs no actor work (CSV files all smaller than one chunk)","+starts none.","+\"\"\"","+","+from __future__ import annotations","+","+import logging","+from collections import deque","+from contextlib import contextmanager","+from typing import (","+    TYPE_CHECKING,","+    Any,","+    Callable,","+    Deque,","+    Iterable,","+    Iterator,","+    List,","+    Optional,","+    Tuple,","+)","+","+import ray","+","+if TYPE_CHECKING:","+    from ray.actor import ActorProxy","+    from ray.data._internal.datasource_v2.interfaces.file_indexer import FileInfo","+","+logger = logging.getLogger(__name__)","+","+","+class LazyActorPool:","+    \"\"\"A round-robin pool of reader actors, made on first use.","+","+    ``len`` is the configured size without provisioning, so an in-flight","+    window can be sized before the first actor exists; the actors are","+    built by ``make_actors`` on the first :meth:`next_actor` call.","+    \"\"\"","+","+    def __init__(","+        self,","+        num_actors: int,","+        make_actors: Callable[[], List[\"ActorProxy[Any]\"]],","+    ):","+        self._num_actors = num_actors","+        self._make_actors = make_actors","+        self._actors: List[\"ActorProxy[Any]\"] = []","+        self._dispatched = 0","+","+    def __len__(self) -> int:","+        return self._num_actors","+","+    def next_actor(self) -> \"ActorProxy[Any]\":","+        \"\"\"Return the next actor, round-robin; build the pool on first use.\"\"\"","+        if not self._actors:","+            self._actors = self._make_actors()","+            logger.debug(\"Provisioned %d reader actors\", len(self._actors))","+        actor = self._actors[self._dispatched % len(self._actors)]","+        self._dispatched += 1","+        return actor","+","+    def kill(self) -> None:","+        \"\"\"Kill every actor, a no-op until the pool has been made.\"\"\"","+        for actor in self._actors:","+            # ``ActorProxy`` is ``ActorHandle | type[T]``; kill wants a handle.","+            # pyrefly: ignore[bad-argument-type]","+            ray.kill(actor)","+","+","+@contextmanager","+def reader_actor_pool(","+    actor_cls: Any,","+    *,","+    num_actors: int,","+    options: Optional[dict] = None,","+    **ctor_kwargs: Any,","+) -> Iterator[LazyActorPool]:","+    \"\"\"Yield a :class:`LazyActorPool` of ``num_actors`` actors, killed on exit.","+","+    ``options`` go to ``.options()`` (e.g. ``max_restarts``) and the rest to","+    the constructor. SPREAD keeps the reads' IO from bottlenecking on one","+    node; killing every actor even on an early exit cancels their in-flight","+    reads.","+    \"\"\"","+    pool = LazyActorPool(","+        num_actors,","+        lambda: [","+            actor_cls.options(scheduling_strategy=\"SPREAD\", **(options or {})).remote(","+                **ctor_kwargs","+            )","+            for _ in range(num_actors)","+        ],","+    )","+    try:","+        yield pool","+    finally:","+        pool.kill()","+","+","+def dispatch_batches(","+    pool: LazyActorPool,","+    batches: Iterable[List[\"FileInfo\"]],","+    submit: Callable[[LazyActorPool, List[\"FileInfo\"]], Any],","+    *,","+    window: int = 0,","+) -> Iterator[Tuple[List[\"FileInfo\"], Any]]:","+    \"\"\"Yield each batch with what ``submit`` returned for it, at most ``window`` ahead.","+","+    ``submit`` draws actors from the pool itself, so a batch that turns out","+    to need no work (CSV files with no header to read) draws none and the","+    pool stays unprovisioned. Batches come back in dispatch order, so a","+    caller rebuilding a listing in order never waits unless every batch in","+    the window is still being read. ``window`` (``0`` -> two per actor)","+    bounds the in-flight batches, keeping listing roughly demand-driven and","+    memory flat. A caller that abandons this iterator early stops","+    dispatch; the in-flight reads are cancelled when its actor pool is","+    killed.","+    \"\"\"","+    batches = iter(batches)","+    pending: Deque[Tuple[List[\"FileInfo\"], Any]] = deque()","+    window = window or len(pool) * 2","+","+    def dispatch_next() -> bool:","+        batch = next(batches, None)","+        if batch is None:","+            return False","+        pending.append((batch, submit(pool, batch)))","+        return True","+","+    for _ in range(window):","+        if not dispatch_next():","+            break","+    while pending:","+        yield pending.popleft()","+        dispatch_next()"],"additions":140,"deletions":0,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/common/file_reader.py","lines":["@@ -30,6 +30,7 @@","     make_async_gen,"," )"," from ray.data.context import DataContext","+from ray.data.datasource.file_based_datasource import _add_partitions_to_table"," from ray.data.datasource.partitioning import (","     Partitioning,","     PathPartitionParser,","@@ -127,6 +128,13 @@ def __init__(","         )","         self._schema = schema"," ","+    @cached_property","+    def _partition_keys(self) -> Set[str]:","+        \"\"\"Partition keys parsed from paths, named by the partitioning.\"\"\"","+        if self._partition_parser is None:","+            return set()","+        return set(self._partition_parser._scheme.field_names or [])","+","     @cached_property","     def _file_dataset_schema(self) -> Optional[pa.Schema]:","         \"\"\"Schema passed to ``pds.dataset`` — partition keys and synthesized","@@ -160,11 +168,7 @@ def _file_dataset_schema(self) -> Optional[pa.Schema]:","             return None","         if any(isinstance(f.type, pa.ExtensionType) for f in schema):","             return None","-        partition_keys = (","-            set(self._partition_parser._scheme.field_names or [])","-            if self._partition_parser is not None","-            else set()","-        )","+        partition_keys = self._partition_keys","         synthesized = {c.name for c in self._synthesized_columns}","         fields = [","             f","@@ -199,27 +203,44 @@ def _apply_partition_values(","         *,","         required_columns: Optional[Set[str]] = None,","     ) -> pa.Table:","-        \"\"\"Replace requested columns with typed path-derived partition values.","+        \"\"\"Add typed path-derived partition values as columns."," ","         Format readers call this before residual filtering. The base read loop","         keeps its post-read placement for formats using the default path."," ","+        A key that a file column already has is checked, not overwritten, by","+        V1's ``_add_partitions_to_table``. The file column keeps its own type and","+        position, and the path value must equal its values, with a null path value","+        matching only an all-null column. A mismatch raises ``ValueError``, as in","+        V1 CSV, JSON and ORC.","+","+        Only readers that read the file's own column reach this check, such as","+        CSV and JSON. Parquet and ORC scan a dataset schema without the partition","+        keys, so a same-named file column is never read and the path value is the","+        only one.","+","         Args:","             table: Batch receiving the path-derived values.","             values: Partition values for the current file or fragment.","             required_columns: Keys to synthesize, or None for all parsed keys."," ","         Returns:","-            Table with requested path values replacing same-named columns.","+            Table with the requested path values added.","+","+        Raises:","+            ValueError: A file column's values differ from the path value, or the","+                path value can't be cast to the file column's type.","         \"\"\"","         for name, value in values.items():","             if required_columns is not None and name not in required_columns:","                 continue","             if name in table.column_names:","-                table = table.drop([name])","-            table = table.append_column(","-                name, self._broadcast_partition_value(name, value, table.num_rows)","-            )","+                table = _add_partitions_to_table(table, {name: value})","+            else:","+                table = table.append_column(","+                    name,","+                    self._broadcast_partition_value(name, value, table.num_rows),","+                )","         return table"," ","     def read(self, input_split: FileManifest) -> Iterator[pa.Table]:"],"additions":32,"deletions":11,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/common/line_chunk_file_indexer.py","lines":["@@ -79,18 +79,25 @@ def __init__(","         assert chunk_size > 0, f\"chunk_size must be positive, got {chunk_size}\"","         self._chunk_size = chunk_size"," ","+    def _is_chunked(self, file_info: FileInfo) -> bool:","+        \"\"\"Whether the file is listed as byte-range chunks, not read whole.","+","+        Byte ranges need the file's size, so a file of unknown size is read","+        whole, like a compressed one.","+        \"\"\"","+        return (","+            file_info.size is not None","+            and file_info.size > self._chunk_size","+            and not _is_compressed(file_info.path)","+        )","+","     @override","     def _chunk_metadatas_of_file(","         self, file_info: FileInfo","     ) -> List[Optional[ChunkMetadata]]:","-        # Byte ranges need the file's size, so a file of unknown size is read","-        # whole, like a compressed one.","-        if (","-            file_info.size is None","-            or file_info.size <= self._chunk_size","-            or _is_compressed(file_info.path)","-        ):","+        if not self._is_chunked(file_info):","             return [None]","+        assert file_info.size is not None","         return [","             chunk.to_metadata()","             for chunk in split_into_line_chunks("],"additions":14,"deletions":7,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/common/line_chunkable_datasource_v2.py","lines":["@@ -0,0 +1,220 @@","+\"\"\"Shared ``FileDataSourceV2`` for newline-delimited formats (CSV and JSONL).","+","+A subclass names the format and supplies three hooks: whether its options","+allow splitting files at newlines (``_can_split_files``), how to read one","+file's schema (``_read_file_schema``), and ``create_scanner``. The rest is","+shared:","+","+- Listing uses ``LineChunkFileIndexer``, which cuts large uncompressed files","+  into ``chunk_size`` byte ranges, or ``NonSamplingFileIndexer`` when the","+  file can't be split.","+- ``RoundRobinPartitioner`` groups rows into read tasks by their bytes on","+  disk, as V1 sizes CSV and JSON reads, weighing a chunk by its own bytes so","+  a chunk the size of a block fills a task by itself. With","+  ``preserve_order`` it fills one task at a time, in listing order.","+- The plan-time schema is the unified schema of up to 16 sampled files, plus","+  partition and synthesized columns.","+\"\"\"","+","+from __future__ import annotations","+","+import dataclasses","+from typing import TYPE_CHECKING, List, Literal, Optional, Union","+","+import pyarrow as pa","+from typing_extensions import override","+","+from ray._common.utils import env_integer","+from ray.data._internal.datasource_v2.common.line_chunk_file_indexer import (","+    LineChunkFileIndexer,","+)","+from ray.data._internal.datasource_v2.common.non_sampling_file_indexer import (","+    NonSamplingFileIndexer,","+)","+from ray.data._internal.datasource_v2.common.partitioning_utils import (","+    resolve_partitioning,","+)","+from ray.data._internal.datasource_v2.common.round_robin_partitioner import (","+    RoundRobinPartitioner,","+)","+from ray.data._internal.datasource_v2.common.schema_inference import (","+    infer_schema_from_files,","+)","+from ray.data._internal.datasource_v2.common.size_estimators import (","+    OnDiskSizeEstimator,","+)","+from ray.data._internal.datasource_v2.common.synthesized_columns import PathColumn","+from ray.data._internal.datasource_v2.interfaces.datasource_v2 import (","+    DatasourceCategory,","+    FileDataSourceV2,","+)","+from ray.data._internal.datasource_v2.interfaces.file_indexer import FileIndexer","+from ray.data._internal.datasource_v2.interfaces.file_manifest import FileManifest","+from ray.data._internal.datasource_v2.interfaces.file_partitioner import (","+    FilePartitioner,","+    PartitionHints,","+)","+from ray.data._internal.util import (","+    MiB,","+    RetryingPyFileSystem,","+    _is_local_scheme,","+    _normalize_paths_to_strings,","+)","+from ray.data.context import DataContext","+from ray.data.datasource.file_based_datasource import FileShuffleConfig","+from ray.data.datasource.partitioning import (","+    Partitioning,","+    PathPartitionParser,","+    _partition_field_types_to_pa_schema,","+)","+from ray.data.datasource.path_util import _resolve_paths_and_filesystem","+from ray.util.annotations import DeveloperAPI","+","+if TYPE_CHECKING:","+    from pyarrow.fs import FileSystem","+","+","+@DeveloperAPI","+class LineChunkableDatasourceV2(FileDataSourceV2):","+    \"\"\"Base datasource for CSV and JSONL files read in byte-range chunks.\"\"\"","+","+    # Names the format in schema-merge errors.","+    _FORMAT_NAME: str = \"\"","+","+    def __init__(","+        self,","+        paths: List[str],","+        *,","+        name: str,","+        filesystem: Optional[\"FileSystem\"] = None,","+        partitioning: Optional[Partitioning] = None,","+        file_extensions: Optional[List[str]] = None,","+        ignore_missing_paths: bool = False,","+        include_paths: bool = False,","+        shuffle: Optional[Union[Literal[\"files\"], FileShuffleConfig]] = None,","+    ):","+        super().__init__(name=name, category=DatasourceCategory.FILE_BASED)","+        self._supports_distributed_reads = not _is_local_scheme(paths)","+        resolved_paths, resolved_filesystem = _resolve_paths_and_filesystem(","+            paths, filesystem","+        )","+        self._paths = resolved_paths","+        # The resolved paths above lose their URI scheme; lineage tracking","+        # reads the caller's paths through ``source_paths``.","+        self._source_paths = _normalize_paths_to_strings(paths)","+        self._filesystem = RetryingPyFileSystem.wrap(","+            resolved_filesystem,","+            retryable_errors=DataContext.get_current().retried_io_errors,","+        )","+        self._partitioning = partitioning","+        self._file_extensions = file_extensions","+        self._ignore_missing_paths = ignore_missing_paths","+        self._shuffle = shuffle","+        self._synthesized_columns = (PathColumn(),) if include_paths else ()","+        # Read once here and carried to the indexer and the readers, so both","+        # map a chunk index to the same byte range.","+        self._chunk_size = env_integer(\"RAY_DATA_LINE_CHUNK_BYTES\", 128 * MiB)","+","+    @property","+    @override","+    def paths(self) -> List[str]:","+        return self._paths","+","+    @property","+    @override","+    def source_paths(self) -> List[str]:","+        \"\"\"Override when :attr:`paths` is resolved and loses URI schemes.\"\"\"","+        return self._source_paths","+","+    @property","+    @override","+    def filesystem(self) -> \"FileSystem\":","+        return self._filesystem","+","+    @property","+    @override","+    def file_extensions(self) -> Optional[List[str]]:","+        return self._file_extensions","+","+    @property","+    @override","+    def shuffle(self) -> Optional[Union[Literal[\"files\"], FileShuffleConfig]]:","+        return self._shuffle","+","+    def _can_split_files(self) -> bool:","+        \"\"\"Whether every newline ends a row, so files can be cut at newlines.\"\"\"","+        return True","+","+    def _read_file_schema(self, path: str) -> pa.Schema:","+        \"\"\"Return the schema pyarrow infers for one file.\"\"\"","+        raise NotImplementedError","+","+    @override","+    def _get_file_indexer(self) -> FileIndexer:","+        if self._can_split_files():","+            return LineChunkFileIndexer(","+                chunk_size=self._chunk_size,","+                ignore_missing_paths=self._ignore_missing_paths,","+            )","+        return NonSamplingFileIndexer(ignore_missing_paths=self._ignore_missing_paths)","+","+    @override","+    def get_file_partitioner(","+        self, *, hints: Optional[PartitionHints] = None","+    ) -> Optional[FilePartitioner]:","+        if hints is None:","+            return None","+        if DataContext.get_current().execution_options.preserve_order:","+            # A single bucket fills in listing order, so read tasks keep each","+            # file's chunks in order instead of dealing them round-robin.","+            hints = dataclasses.replace(hints, num_buckets=1)","+        return RoundRobinPartitioner(OnDiskSizeEstimator(), hints=hints)","+","+    @property","+    @override","+    def schema_needs_file_sample(self) -> bool:","+        return True","+","+    @override","+    def infer_schema(self, sample: Optional[FileManifest]) -> pa.Schema:","+        if sample is None or len(sample) == 0:","+            return pa.schema([])","+        sample_paths = sample.paths.tolist()","+        schema = infer_schema_from_files(","+            sample_paths, self._read_file_schema, format_name=self._FORMAT_NAME","+        )","+","+        resolved_partitioning = self.resolve_partitioning(sample)","+        if resolved_partitioning is not None:","+            parser = PathPartitionParser(resolved_partitioning)","+            partition_names = list(","+                dict.fromkeys(","+                    name for path in sample_paths for name in parser(path).keys()","+                )","+            )","+            if partition_names:","+                partition_schema = _partition_field_types_to_pa_schema(","+                    field_names=partition_names,","+                    field_types=resolved_partitioning.field_types or {},","+                )","+                for name in partition_names:","+                    if schema.get_field_index(name) == -1:","+                        schema = schema.append(partition_schema.field(name))","+","+        for column in self._synthesized_columns:","+            index = schema.get_field_index(column.name)","+            field = pa.field(column.name, column.type)","+            if index == -1:","+                schema = schema.append(field)","+            elif schema.field(index).type != column.type:","+                schema = schema.set(index, field)","+","+        return schema","+","+    @override","+    def resolve_partitioning(","+        self, sample: Optional[FileManifest]","+    ) -> Optional[Partitioning]:","+        return resolve_partitioning(","+            self._partitioning, sample.paths.tolist() if sample else []","+        )"],"additions":220,"deletions":0,"truncated":false},{"path":"python/ray/data/_internal/datasource_v2/common/line_chunkable_file_reader.py","lines":["@@ -17,10 +17,10 @@"," 3. Scans that fragment through ``_iter_fragment_tables``, with the schema","    ``_get_scan_schema`` picks."," ","-A whole-file row of an uncompressed file of at most ``chunk_size`` bytes is","-read with one request and scanned like a chunk. Larger and compressed files","-take the plain ``FileReader`` path, which streams them and lets pyarrow","-decompress them by extension.","+A whole-file row of an uncompressed file of known size, at most ``chunk_size``","+bytes, is read with one request and scanned like a chunk. Larger, compressed","+and unknown-size files take the plain ``FileReader`` path, which streams them","+and lets pyarrow decompress them by extension."," "," Design decisions:"," ","@@ -65,7 +65,7 @@","   override, so JSONL carries nothing for it."," \"\"\""," ","-from typing import Any, Dict, Iterator, List, Optional","+from typing import TYPE_CHECKING, Any, Dict, Iterator, List, Optional"," "," import pyarrow as pa"," import pyarrow.dataset as pds","@@ -79,13 +79,31 @@","     line_chunk_byte_range,","     read_line_aligned,"," )","-from ray.data._internal.datasource_v2.interfaces.file_manifest import FileChunk","+from ray.data._internal.datasource_v2.interfaces.file_manifest import (","+    FileChunk,","+    FileManifest,","+)"," from ray.data._internal.datasource_v2.interfaces.read_units import (","     ReadUnit,","     ReadUnitFragment,"," )"," from ray.data._internal.object_extensions.arrow import raise_on_pickle_object_columns","-from ray.data._internal.util import NumBytes","+from ray.data._internal.util import NumBytes, RetryingPyFileSystem","+from ray.data.datasource.file_based_datasource import _decompress_snappy","+","+if TYPE_CHECKING:","+    from pyarrow.fs import FileSystem","+","+","+def read_snappy_buffer(path: str, filesystem: \"FileSystem\") -> pa.Buffer:","+    \"\"\"Return a whole Snappy file decompressed, since pyarrow can't read it.\"\"\"","+    if isinstance(filesystem, RetryingPyFileSystem):","+        # Unwrap the retry wrapper, as V1 does, so ``_decompress_snappy``","+        # sees the ``HadoopFileSystem`` underneath and applies Hadoop framing.","+        filesystem = filesystem.unwrap()","+    with filesystem.open_input_stream(path, compression=None) as file:","+        return pa.py_buffer(_decompress_snappy(file, filesystem).getbuffer())","+"," "," # pyarrow's ``ReadOptions.block_size`` is a 32-bit int."," _MAX_BLOCK_SIZE = 2**31 - 1","@@ -129,6 +147,16 @@ def __init__(","         # TODO: Carry each chunk's byte range in the manifest instead, once","         # bin sizes can vary per file.","         self._chunk_size = chunk_size","+        self._file_sizes: Dict[str, Optional[int]] = {}","+","+    @override","+    def _get_fragments_to_read(","+        self,","+        dataset: pds.Dataset,","+        manifest: FileManifest,","+    ) -> List[ReadUnitFragment]:","+        self._file_sizes = dict(zip(manifest.paths, manifest.known_file_sizes))","+        return super()._get_fragments_to_read(dataset, manifest)"," ","     @override","     def _get_chunk_fragments(","@@ -180,9 +208,9 @@ def _iter_unit_tables(","         \"\"\"Read one chunk's whole lines and scan them as if they were a file."," ","         Runs inside the retry loop and the scan threads, so the range read is","-        retried and chunks download in parallel. A small uncompressed file is","-        read the same way, in one request; other whole file