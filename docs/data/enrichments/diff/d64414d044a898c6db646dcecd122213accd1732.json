elta","+from types import SimpleNamespace"," from unittest.mock import MagicMock, patch"," "," import numpy as np","@@ -10,8 +11,11 @@"," import torch.distributed as dist"," import torch.multiprocessing as mp"," ","+import vllm.config.parallel as parallel_config_module","+import vllm.distributed.eplb.eplb_state as eplb_state_module"," from vllm.config import ParallelConfig","-from vllm.distributed.eplb import eplb_state","+from vllm.config.parallel import EPLBConfig","+from vllm.config.utils import hash_config_cached"," from vllm.distributed.eplb.eplb_state import (","     EplbState,","     _commit_eplb_maps,","@@ -25,6 +29,46 @@"," from vllm.distributed.parallel_state import GroupCoordinator"," from vllm.platforms import current_platform"," from vllm.utils.network_utils import get_open_port","+from vllm.v1.worker.gpu.eplb_utils import draft_model_supports_eplb","+","+","+@pytest.mark.parametrize(","+    (","+        \"method\",","+        \"model_type\",","+        \"is_rocm\",","+        \"has_moe\",","+        \"draft_enable_eplb\",","+        \"expected\",","+    ),","+    [","+        (\"dspark\", \"deepseek_v4\", False, True, True, True),","+        (\"dspark\", \"deepseek_v41\", False, True, True, True),","+        (\"dspark\", \"deepseek_v41\", True, True, True, False),","+        (\"dspark\", \"deepseek_v41\", False, False, True, False),","+        (\"dspark\", \"deepseek_v41\", False, True, False, False),","+        (\"eagle3\", \"deepseek_v41\", False, True, False, False),","+    ],","+)","+def test_draft_model_supports_eplb(","+    monkeypatch, method, model_type, is_rocm, has_moe, draft_enable_eplb, expected","+):","+    speculative_config = SimpleNamespace(","+        method=method,","+        draft_enable_eplb=draft_enable_eplb,","+        draft_model_config=SimpleNamespace(","+            hf_config=SimpleNamespace(model_type=model_type)","+        ),","+    )","+    monkeypatch.setattr(current_platform, \"is_rocm\", lambda: is_rocm)","+","+    assert