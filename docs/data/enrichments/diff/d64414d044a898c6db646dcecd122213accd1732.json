[tuple[int, int]] = []","+","+    @classmethod","+    def rebalance_experts(","+        cls,","+        weight: torch.Tensor,","+        num_replicas: int,","+        num_groups: int,","+        num_nodes: int,","+        num_ranks: int,","+        old_global_expert_indices: torch.Tensor | None = None,","+    ) -> torch.Tensor:","+        cls.calls.append((num_replicas, num_groups))","+        assert old_global_expert_indices is not None","+        return old_global_expert_indices","+","+","+class _EplbTestGroup:","+    def __init__(self):","+        self.device_group = self","+","+    def rank(self) -> int:","+        return 1","+","+    def size(self) -> int:","+        return 2","+","+","+class _EplbTestEvent:","+    def record(self, stream: torch.Stream | None = None) -> None:","+        pass","+","+","+@pytest.mark.parametrize(\"use_async\", [False, True])","+def test_rearrange_handles_heterogeneous_model_topologies(monkeypatch, use_async):","+    \"\"\"Rearrangement keeps each model's physical expert and group counts.\"\"\"","+    monkeypatch.setattr(","+        parallel_config_module.current_platform, \"is_cuda_alike\", lambda: True","+    )","+    parallel_config = ParallelConfig(","+        tensor_parallel_size=2,","+        distributed_executor_backend=\"mp\",","+        enable_expert_parallel=True,","+        enable_eplb=True,","+        eplb_config=EPLBConfig(","+            window_size=4,","+            step_interval=8,","+            use_async=use_async,","+            communicator=\"torch_gloo\",","+        ),","+    )","+    monkeypatch.setattr(eplb_state_module, \"CpuGpuEvent\", _EplbTestEvent)","+    state = EplbState(parallel_config, torch.device(\"cpu\"))","+    group = _EplbTestGroup()","+    monkeypatch.setattr(eplb_state_module, \"get_ep_group\", lambda: group)","+    monkeypatch.setattr(eplb_state_module, \"get_eplb_group\", lambda: group)","+    monkeypatch.setattr(eplb_state_module, \"get_node_count\", lambda: 1)","+    monkeypatch.setattr(