                   use_native_mega_moe=False,","+                    n_redundant_experts=6,","+                )","+            )","+        ],","+        confidence_head=None,","+    )","+    draft.config = SimpleNamespace(","+        dspark_n_routed_experts=4,","+        n_routed_experts=4 if model_type == \"deepseek_v4\" else 8,","+        num_attention_heads=4,","+        expert_dtype=\"fp4\",","+    )","+    draft.pad_shared_expert = False","+    draft.quant_config = None","+    draft.named_parameters = lambda: [(param_name, param)]"," ","-def test_eplb_state_rejects_mismatched_dsv4_draft_redundant_experts():","-    draft = _make_moe_topology(num_redundant_experts=0)","-    target = _make_moe_topology(num_redundant_experts=4)","+    # With EP=2, rank 0 owns physical slots 0..4; slots 0 and 4 both map to expert 0.","+    checkpoint_weight = torch.tensor([3.0, 7.0])","+    draft.load_weights([(\"mtp.0.ffn.experts.0.w1.weight\", checkpoint_weight)])"," ","-    with pytest.raises(RuntimeError, match=\"mismatch\"):","-        EplbState.assert_confs_equal(draft, target)","+    torch.testing.assert_close(param[0], checkpoint_weight)","+    torch.testing.assert_close(param[4], checkpoint_weight)"," "," ","-@pytest.mark.parametrize(","-    (\"model_type\", \"expected\"),","-    [","-        (\"deepseek_v4\", True),","-        (\"deepseek_v41\", False),","-    ],","-)","-def test_dspark_draft_supports_eplb(","-    dspark_vllm_config, model_type: str, expected: bool","+@pytest.mark.parametrize(\"model_type\", [\"deepseek_v4\", \"deepseek_v41\"])","+def test_eplb_registers_dspark_draft_when_supported(","+    dspark_vllm_config, monkeypatch: pytest.MonkeyPatch, model_type"," ):","-    draft_model_config = dspark_vllm_config.speculative_config.draft_model_config","-    draft_model_config.hf_config.model_type = model_type","-    assert dspark_draft_supports_eplb(draft_model_config) is expected","+    \"\"\"Register DSpark MoE drafts only on platforms that support draft EPLB.\"\"\"","+    dspark_vllm_config.speculative_config.draft_model_config.hf_config.model_type = (","+        model_type","+    )","+    FakeEplbState.instances.clear()","+    monkeypatch.setattr(","+        \"vllm.v1.worker.gpu.eplb_utils.EplbState\",","+        FakeEplbState,","+    )","+    monkeypatch.setattr(","+        \"vllm.v1.worker.gpu.eplb_utils.get_mixture_of_experts_model\",","+        lambda model: model,","+    )"," ","+    draft = SimpleNamespace()","+    controller = EPLBController(dspark_vllm_config.parallel_config, torch.device(\"cpu\"))","+    controller.prepare_load()","+    speculator = SimpleNamespace(model=draft, eplb_state=None)"," ","-def test_draft_model_supports_eplb_requires_draft_moe(dspark_vllm_config):","-    assert not draft_model_supports_eplb(","+    def set_eplb_state(state) -> None:","+        speculator.eplb_state = state","+","+    speculator.set_eplb_state = set_eplb_state","+","+    registered = controller.maybe_register_speculator(","+        speculator,","         dspark_vllm_config.speculative_config,","-        None,","+        load_dummy_weights=False,","     )"," ","+    supports_draft_eplb = not current_platform.is_rocm()","+    assert registered is supports_draft_eplb","+    assert controller.state is not None","+    expected_calls = (","+        [","+            (","+                draft,","+                dspark_vllm_config.speculative_config.draft_model_config,","+                \"dspark (draft)\",","+            )","+        ]","+        if supports_draft_eplb","+        else []","+    )","+    assert controller.state.add_model_calls == expected_calls","+    assert speculator.eplb_state is (controller.state if supports_draft_eplb else None)"," ","-@pytest.mark.parametrize(","-    \"model_type,load_dummy_weights,expected_registered\",","-    [","-        (\"deepseek_v4\", False, True),","-        (\"deepseek_v4\", True, False),","-        (\"deepseek_v41\", False, False),","-    ],","-)","-def test_eplb_dspark_draft