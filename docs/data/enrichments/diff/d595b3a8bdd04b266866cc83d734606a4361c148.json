{"id":"d595b3a8bdd04b266866cc83d734606a4361c148","axis":"silent","repo":"pnpm/pnpm","sha":"d595b3a8bdd04b266866cc83d734606a4361c148","parsed":{"files":[{"path":".changeset/read-workspace-package-settings-from-env.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm now reads the `linkWorkspacePackages`, `injectWorkspacePackages`, `extendNodePath`, `frozenStore`, and `optimisticRepeatInstall` settings from `PNPM_CONFIG_*` environment variables, such as `PNPM_CONFIG_LINK_WORKSPACE_PACKAGES=true`. `--config.extend-node-path` now applies too. Before, pnpm ignored these environment variables."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay.rs","lines":["@@ -15,10 +15,10 @@"," //! as a low-priority auth-file fallback."," "," use crate::{","-    AuditLevel, CatalogMode, ColorMode, HoistingLimits, InitType, LogLevel, NodeLinkerSetting,","-    NodePackageMapMode, NodePackageMapType, PackageImportMethod, PmOnFail, ReporterType,","-    ResolutionMode, RuntimeOnFail, SaveWorkspaceProtocol, StoreIndexFormat, TrustPolicy,","-    VerifyDepsBeforeRun, VirtualStoreType, WorkspaceSettings,","+    AuditLevel, CatalogMode, ColorMode, HoistingLimits, InitType, LinkWorkspacePackages, LogLevel,","+    NodeLinkerSetting, NodePackageMapMode, NodePackageMapType, PackageImportMethod, PmOnFail,","+    ReporterType, ResolutionMode, RuntimeOnFail, SaveWorkspaceProtocol, StoreIndexFormat,","+    TrustPolicy, VerifyDepsBeforeRun, VirtualStoreType, WorkspaceSettings,","     api::EnvVar,","     workspace_yaml::{MachineSettings, TrustedSettings},"," };"],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay/resolution.rs","lines":["@@ -1,6 +1,9 @@"," //! The peer and resolution settings of the environment overlay."," ","-use super::{HoistingLimits, StringReader, WorkspaceSettings, parse_json, parse_json_or_string};","+use super::{","+    HoistingLimits, LinkWorkspacePackages, StringReader, WorkspaceSettings, parse_json,","+    parse_json_or_string,","+};"," "," impl WorkspaceSettings {","     pub(super) fn read_peer_env(&mut self, reader: &StringReader<'_>) {","@@ -27,7 +30,17 @@ impl WorkspaceSettings {","     pub(super) fn read_resolution_env(&mut self, reader: &StringReader<'_>) {","         let settings = self;","         json_field!(settings, reader, exclude_links_from_lockfile, \"EXCLUDE_LINKS_FROM_LOCKFILE\");","+        json_field!(settings, reader, optimistic_repeat_install, \"OPTIMISTIC_REPEAT_INSTALL\");","         json_field!(settings, reader, hoist_workspace_packages, \"HOIST_WORKSPACE_PACKAGES\");","+        json_field!(settings, reader, extend_node_path, \"EXTEND_NODE_PATH\");","+        enum_field!(","+            settings,","+            reader,","+            link_workspace_packages,","+            \"LINK_WORKSPACE_PACKAGES\",","+            LinkWorkspacePackages","+        );","+        json_field!(settings, reader, inject_workspace_packages, \"INJECT_WORKSPACE_PACKAGES\");","         enum_field!(settings, reader, hoisting_limits, \"HOISTING_LIMITS\", HoistingLimits);","         json_field!(settings, reader, external_dependencies, \"EXTERNAL_DEPENDENCIES\");","         json_field!(settings, reader, auto_dedupe, \"AUTO_DEDUPE\");","@@ -47,6 +60,7 @@ impl WorkspaceSettings {","         json_field!(settings, reader, fail_if_no_match, \"FAIL_IF_NO_MATCH\");","         json_field!(settings, reader, ignore_workspace_cycles, \"IGNORE_WORKSPACE_CYCLES\");","         json_field!(settings, reader, disallow_workspace_cycles, \"DISALLOW_WORKSPACE_CYCLES\");","+        json_field!(settings, reader, frozen_store, \"FROZEN_STORE\");","         json_field!(settings, reader, side_effects_cache, \"SIDE_EFFECTS_CACHE\");","         json_field!(settings, reader, side_effects_cache_readonly, \"SIDE_EFFECTS_CACHE_READONLY\");","     }"],"additions":15,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay/tests.rs","lines":["@@ -1,7 +1,7 @@"," use super::{TrustedSettings, WorkspaceSettings, parse_json_or_string, parse_tri_array};"," use crate::{","-    ColorMode, Config, NodeLinker, NodePackageMapType, SaveWorkspaceProtocol, TrustPolicy,","-    VirtualStoreType, api::EnvVar,","+    ColorMode, Config, LinkWorkspacePackages, NodeLinker, NodePackageMapType,","+    SaveWorkspaceProtocol, TrustPolicy, VirtualStoreType, api::EnvVar,"," };"," use pnpm_store_dir::StoreIndexFormat;"," use pretty_assertions::assert_eq;","@@ -187,6 +187,30 @@ fn save_workspace_protocol_reads_from_the_environment() {","     assert_eq!(settings.save_workspace_protocol, Some(SaveWorkspaceProtocol::On));"," }"," ","+#[test]","+fn resolution_settings_read_from_the_environment() {","+    struct EnvResolution;","+    impl EnvVar for EnvResolution {","+        fn var(name: &str) -> Option<String> {","+            match name {","+                \"PNPM_CONFIG_LINK_WORKSPACE_PACKAGES\"","+                | \"PNPM_CONFIG_INJECT_WORKSPACE_PACKAGES\"","+                | \"PNPM_CONFIG_FROZEN_STORE\" => Some(\"true\".to_owned()),","+                \"PNPM_CONFIG_EXTEND_NODE_PATH\" | \"PNPM_CONFIG_OPTIMISTIC_REPEAT_INSTALL\" => {","+                    Some(\"false\".to_owned())","+                }","+                _ => None,","+            }","+        }","+    }","+    let settings = TrustedSettings::from_pnpm_config_env::<EnvResolution>().settings;","+    assert_eq!(settings.link_workspace_packages, Some(LinkWorkspacePackages::DirectOnly));","+    assert_eq!(settings.inject_workspace_packages, Some(true));","+    assert_eq!(settings.frozen_store, Some(true));","+    assert_eq!(settings.extend_node_path, Some(false));","+    assert_eq!(settings.optimistic_repeat_install, Some(false));","+}","+"," #[test]"," fn enum_env_var_accepts_bare_identifier() {","     assert_eq!(parse_json_or_string::<NodeLinker>(\"hoisted\"), Some(NodeLinker::Hoisted));","@@ -449,3 +473,75 @@ fn tag_parses_from_env() {","         Some(\"next\"),","     );"," }","+","+/// Every setting has a `PNPM_CONFIG_*` read or is listed in","+/// [`SETTINGS_NOT_READ_FROM_ENV`] with the reason it has none.","+#[test]","+fn every_setting_is_read_from_the_environment() {","+    let requested = std::cell::RefCell::new(std::collections::BTreeSet::new());","+    let record = |suffix: &str| {","+        requested","+            .borrow_mut()","+            .insert(crate::naming_cases::to_camel_case(&suffix.to_lowercase()));","+        None","+    };","+    TrustedSettings::from_reader(&super::StringReader { read: &record, read_allow_empty: &record });","+    let requested = requested.into_inner();","+","+    let Ok(serde_json::Value::Object(settings)) =","+        TrustedSettings::from_resolved(&Config::default()).to_json()","+    else {","+        panic!(\"the projected settings serialize to a JSON object\");","+    };","+    let unread: Vec<&str> = settings","+        .keys()","+        .map(String::as_str)","+        .filter(|key| !requested.contains(*key) && !SETTINGS_NOT_READ_FROM_ENV.contains(key))","+        .collect();","+    assert_eq!(unread, Vec::<&str>::new(), \"settings with no PNPM_CONFIG_* read\");","+","+    let stale: Vec<&str> = SETTINGS_NOT_READ_FROM_ENV","+        .iter()","+        .copied()","+        .filter(|key| requested.contains(*key) || !settings.contains_key(*key))","+        .collect();","+    assert_eq!(stale, Vec::<&str>::new(), \"listed settings that are read or no longer exist\");","+}","+","+const SETTINGS_NOT_READ_FROM_ENV: &[&str] = &[","+    // Read under the nested key's suffix, such as `NODE_PACKAGE_MAP_MODE`.","+    \"nodePackageMap\",","+    \"macosBackup\",","+    // Read with the auth files, not through the overlay.","+    \"_auth\",","+    \"npmrcAuthFile\",","+    // Not in the schema pnpm v11 reads `PNPM_CONFIG_*` against.","+    \"audit\",","+    \"bootConfig\",","+    \"cargo\",","+    \"catalog\",","+    \"catalogPrune\",","+    \"catalogs\",","+    \"cleanupUnusedCatalogs\",","+    \"configDependencies\",","+    \"ignoredBuiltDependencies\",","+    \"minimumReleaseAgeExcludePrune\",","+    \"namedRegistries\",","+    \"neverBuiltDependencies\",","+    \"onlyBuiltDependencies\",","+    \"packageConfigs\",","+    \"packages\",","+    \"permissions\",","+    \"pipelineBase\",","+    \"pipelines\",","+    \"python\",","+    \"registries\",","+    \"remoteCache\",","+    \"remoteSideEffectsCache\",","+    \"requiredScripts\",","+    \"skills\",","+    \"tasks\",","+    \"trustPolicyExcludePrune\",","+    \"update\",","+    \"versioning\",","+];"],"additions":98,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/tests/workspace_settings_materialization_env_vars_override.rs","lines":["@@ -379,6 +379,19 @@ pub fn node_version_from_pnpm_config_env_overrides_workspace_yaml() {","     assert_eq!(config.node_version.as_deref(), Some(\"20.0.0\"));"," }"," ","+#[test]","+pub fn link_workspace_packages_from_pnpm_config_env_overrides_workspace_yaml() {","+    fake_env!(load_with_fake_env);","+    let tmp = tempdir().unwrap();","+    fs::write(tmp.path().join(\"pnpm-workspace.yaml\"), \"linkWorkspacePackages: false\\n\")","+        .expect(\"write to pnpm-workspace.yaml\");","+","+    set_fake_env(&[(\"PNPM_CONFIG_LINK_WORKSPACE_PACKAGES\", \"deep\")]);","+    let config = load_with_fake_env(tmp.path());","+","+    assert_eq!(config.link_workspace_packages, crate::LinkWorkspacePackages::Deep);","+}","+"," #[test]"," pub fn catalog_prune_from_workspace_yaml() {","     let tmp = tempdir().unwrap();",""],"additions":13,"deletions":0,"truncated":false}],"additions":135,"deletions":7,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-04T16:05:12.110128+00:00"}