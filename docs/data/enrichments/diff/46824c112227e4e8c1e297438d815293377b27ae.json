eturn try SealedData(","-            iv: iv.intoData(),","-            ciphertext: ciphertext.intoData(),","-            tag: tagData","-          )","-        }","-","-        let tagLength: Int = tag?.get() ?? DEFAULT_TAG_LENGTH","-        return try SealedData(","-          iv: iv.intoData(),","-          ciphertextWithTag: ciphertext.intoData(),","-          tagLength: tagLength","-        )","-      }","+@Union","+enum NonceInput {","+  case base64(String)","+  case bytes(Data)","+  case length(Int)","+}"," ","-      Property(\"combinedSize\") { (sealedData: SealedData) in","-        sealedData.combined.count","-      }","-      Property(\"ivSize\") { (sealedData: SealedData) in","-        sealedData.iv.count","-      }","-      Property(\"tagSize\") { (sealedData: SealedData) in","-        sealedData.tag.count","-      }","+@Union","+enum BinaryOutput {","+  case bytes(Data)","+  case base64(String)","+}"," ","-      AsyncFunction(\"iv\") { (sealedData: SealedData, format: DataFormat?) -> Any in","-        sealedData.iv.formatted(with: format)","-      }","-      AsyncFunction(\"tag\") { (sealedData: SealedData, format: DataFormat?) -> Any in","-        sealedData.tag.formatted(with: format)","-      }","-      AsyncFunction(\"combined\") { (sealedData: SealedData, format: DataFormat?) -> Any in","-        sealedData.combined.formatted(with: format)","-      }","-      AsyncFunction(\"ciphertext\") { (sealedData: SealedData, options: CiphertextOptions?) -> Any in","-        sealedData","-          .ciphertext(withTag: options?.includeTag ?? false)","-          .formatted(with: options?.outputFormat)","-      }","+@ExpoModule(\"ExpoCryptoAES\", classes: [EncryptionKey.self, SealedData.self])","+public class AesCryptoModule: Module {","+  @JS(.concurrent)","+  func encryptAsync(","+    plaintext: BinaryInput,","+    key: EncryptionKey,","+    options: EncryptOptions?","+  ) async throws -> SealedData {","+    return try mapCryptoKitError(to: EncryptionFailedException()) {","+      return try encrypt(plaintext: plaintext, key: key, options: options)","     }","   }"," ","-  private func generateKey(size: KeySize?) -> EncryptionKey {","-    EncryptionKey(size: size ?? KeySize.aes256)","-  }","-","-  private func importKey(","-    rawKey: Either<Data, String>,","-    encoding: DataEncoding?","-  ) throws -> EncryptionKey {","-    if rawKey.is(Data.self) {","-      return try EncryptionKey(bytes: rawKey.as(Data.self))","-    }","-","-    guard let dataEncoding = encoding else {","-      throw MissingEncodingException()","+  @JS(.concurrent)","+  func decryptAsync(","+    sealedData: SealedData,","+    key: EncryptionKey,","+    options: DecryptOptions?","+  ) async throws -> BinaryOutput {","+    return try mapCryptoKitError(to: DecryptionFailedException()) {","+      return try decrypt(sealedData: sealedData, key: key, options: options)","     }","-    let keyString = try rawKey.as(String.self)","-    return try EncryptionKey(string: keyString, encodedWith: dataEncoding)","   }"," ","   private func encrypt(","@@ -153,16 +94,17 @@ public class AesCryptoModule: Module {","     options: EncryptOptions?","   ) throws -> SealedData {","     let iv: AES.GCM.Nonce","-    if let bytes: Data = options?.nonce?.get() {","-      iv = try AES.GCM.Nonce(data: bytes)","-    } else if let base64: String = options?.nonce?.get() {","+    switch options?.nonce {","+    case .base64(let base64):","       guard let bytes = Data(base64Encoded: base64) else {","         throw InvalidBase64Exception()","       }","       iv = try AES.GCM.Nonce(data: bytes)","-    } else if let size: Int = options?.nonce?.get() {","+    case .bytes(let bytes):","+      iv = try AES.GCM.Nonce(data: bytes)","+    case .length(let size):","       iv = try AES.GCM.Nonce(ofSize: size)","-    } else {","+    case nil:","       iv = AES.GCM.Nonce()  // defaults to 12-byte nonce","     }"," ","@@ -189,7 +131,7 @@ public class AesCryptoModule: Module {","     sealedData: SealedData,","     key: EncryptionKey,","     options: DecryptOptions?","-  ) throws -> Any {","+  ) throws -> BinaryOutput {","     let plaintext: Data =","       if let aad = options?.additionalData {","         try AES.GCM.open(","@@ -204,9 +146,6 @@ public class AesCryptoModule: Module {","         )","       }"," ","-    if options?.output == .base64 {","-      return plaintext.base64EncodedString()","-    }","-    return plaintext","+    return plaintext.formatted(with: options?.output)","   }"," }"],"additions":55,"deletions":116,"truncated":false},{"path":"packages/expo-crypto/ios/AES/EncryptionKey.swift","lines":["@@ -17,6 +17,7 @@ enum KeySize: Int, Enumerable {","   }"," }"," ","+@SharedObject"," final class EncryptionKey: SharedObject {","   private var inner: CryptoKit.SymmetricKey"," ","@@ -46,7 +47,27 @@ final class EncryptionKey: SharedObject {","     try self.init(bytes: bytes)","   }"," ","-  var keySize: KeySize {","+  @JS","+  static func generate(size: KeySize?) async -> EncryptionKey {","+    return EncryptionKey(size: size ?? .aes256)","+  }","+","+  @JS(\"import\")","+  static func importKey(rawKey: BinaryInput, encoding: DataEncoding?) async throws -> EncryptionKey {","+    switch rawKey {","+    case .bytes(let bytes):","+      return try EncryptionKey(bytes: bytes)","+    case .string(let keyString):","+      guard let encoding else {","+        throw MissingEncodingException()","+      }","+      return try EncryptionKey(string: keyString, encodedWith: encoding)","+    }","+  }","+","+  // `nonisolated` so `bytes` and `getAdditionalMemoryPressure()`, which aren't isolated, can read it.","+  @JS(\"size\")","+  nonisolated var keySize: KeySize {","     // size is always verified when inner is created","     // swiftlint:disable:next force_unwrapping","     KeySize(rawValue: inner.bitCount)!","@@ -62,7 +83,13 @@ final class EncryptionKey: SharedObject {","     return keyBytes","   }"," ","-  func encoded(with encoding: DataEncoding) -> String {","+  @JS(\"bytes\")","+  func bytesData() async -> Data {","+    return bytes","+  }","+","+  @JS","+  func encoded(with encoding: DataEncoding) async -> String {","     bytes.getEncoded(with: encoding)","   }"," "],"additions":29,"deletions":2,"truncated":false},{"path":"packages/expo-crypto/ios/AES/Exceptions.swift","lines":["@@ -1,3 +1,4 @@","+import CryptoKit"," import ExpoModulesCore"," "," final class InvalidKeySizeException: GenericException<Int>, @unchecked Sendable {","@@ -30,3 +31,31 @@ final class MissingEncodingException: Exception, @unchecked Sendable {","     \"Encoding argument must be provided for string inputs\"","   }"," }","+","+final class EncryptionFailedException: Exception, @unchecked Sendable {","+  override var reason: String {","+    \"Cannot encrypt the data because AES-GCM rejected the input. Check the nonce, or omit it to generate a 12-byte nonce\"","+  }","+}","+","+final class DecryptionFailedException: Exception, @unchecked Sendable {","+  override var reason: String {","+    \"Cannot decrypt the sealed data because its authentication failed. Use the key and the additional data that encrypted it\"","+  }","+}","+","+final class InvalidSealedDataConfigException: Exception, @unchecked Sendable {","+  override var reason: String {","+    \"Cannot create the sealed data because the IV, the ciphertext, or the tag has an invalid length. Use the IV and tag lengths that encryption used\"","+  }","+}","+","+/// Runs `body` and rethrows a CryptoKit error as the given exception, with the CryptoKit error as its","+/// cause, so JavaScript receives an error with a code.","+func mapCryptoKitError<T>(to exception: @autoclosure () -> Exception, _ body: () throws -> T) throws -> T {","+  do {","+    return try body()","+  } catch let error as CryptoKitError {","+    throw exception().causedBy(error)","+  }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/ios/AES/SealedData.swift","lines":["@@ -1,14 +1,19 @@"," import CryptoKit"," import ExpoModulesCore"," ","-internal struct SealedDataConfig: Record {","-  @Field","+@Record","+internal struct SealedDataConfig {","   var ivLength: Int = DEFAULT_IV_LENGTH","-","-  @Field","   var tagLength: Int = DEFAULT_TAG_LENGTH"," }"," ","+@Union","+enum TagInput {","+  case bytes(Data)","+  case length(Int)","+}","+","+@SharedObject"," final class SealedData: SharedObject {","   private var inner: AES.GCM.SealedBox"," ","@@ -48,6 +53,39 @@ final class SealedData: SharedObject {","     )","   }"," ","+  @JS","+  static func fromCombined(combined: BinaryInput, config: SealedDataConfig?) throws -> SealedData {","+    let config = config ?? SealedDataConfig()","+","+    return try mapCryptoKitError(to: InvalidSealedDataConfigException()) {","+      return try SealedData(","+        ivLength: config.ivLength,","+        tagLength: config.tagLength,","+        content: combined.intoData()","+      )","+    }","+  }","+","+  @JS","+  static func fromParts(iv: BinaryInput, ciphertext: BinaryInput, tag: TagInput?) throws -> SealedData {","+    return try mapCryptoKitError(to: InvalidSealedDataConfigException()) {","+      switch tag ?? .length(DEFAULT_TAG_LENGTH) {","+      case .bytes(let tagData):","+        return try SealedData(","+          iv: iv.intoData(),","+          ciphertext: ciphertext.intoData(),","+          tag: tagData","+        )","+      case .length(let tagLength):","+        return try SealedData(","+          iv: iv.intoData(),","+          ciphertextWithTag: ciphertext.intoData(),","+          tagLength: tagLength","+        )","+      }","+    }","+  }","+","   var combined: Data {","     // combined works only if IV length is 12 bytes","     if let combined = inner.combined {","@@ -72,6 +110,42 @@ final class SealedData: SharedObject {","     return inner.ciphertext","   }"," ","+  @JS","+  var combinedSize: Int {","+    return combined.count","+  }","+","+  @JS","+  var ivSize: Int {","+    return iv.count","+  }","+","+  @JS","+  var tagSize: Int {","+    return tag.count","+  }","+","+  @JS","+  func iv(format: DataFormat?) async -> BinaryOutput {","+    return iv.formatted(with: format)","+  }","+","+  @JS","+  func tag(format: DataFormat?) async -> BinaryOutput {","+    return tag.formatted(with: format)","+  }","+","+  @JS","+  func combined(format: DataFormat?) async -> BinaryOutput {","+    return combined.formatted(with: format)","+  }","+","+  @JS","+  func ciphertext(options: CiphertextOptions?) async -> BinaryOutput {","+    return ciphertext(withTag: options?.includeTag ?? false)","+      .formatted(with: options?.outputFormat)","+  }","+","   var nativeValue: AES.GCM.SealedBox { inner }"," ","   override func getAdditionalMemoryPressure() -> Int {"],"additions":78,"deletions":4,"truncated":false},{"path":"packages/expo-crypto/ios/AES/Utilities.swift","lines":["@@ -26,12 +26,12 @@ extension Data {","     }","   }"," ","-  func formatted(with format: DataFormat?) -> Any {","+  func formatted(with format: DataFormat?) -> BinaryOutput {","     switch format {","     case .bytes, nil:","-      return self","+      return .bytes(self)","     case .base64:","-      return self.base64EncodedString()","+      return .base64(self.base64EncodedString())","     }","   }"," }"],"additions":3,"deletions":3,"truncated":false},{"path":"packages/expo-crypto/ios/Benchmarks/Benchmarks.swift","lines":["@@ -0,0 +1,163 @@","+// Copyright 2026-present 650 Industries. All rights reserved.","+","+import ExpoCrypto","+import ExpoModulesCore","+import ExpoModulesTestCore","+import Testing","+","+/// Umbrella suite for the ExpoCrypto benchmarks.","+///","+/// The benchmarks are the `Benchmarks` test spec of the pod, separate from the unit tests. Run them","+/// with `et native-unit-tests -p ios --packages expo-crypto --benchmarks`, which builds the pods in","+/// the Release configuration and runs the bundle natively on the Mac through the Mac Catalyst","+/// destination. Each case prints one `[benchmark]` line with the median and minimum ns/op.","+///","+/// The suite is serialized so only one benchmark runs at a time: the `JavaScriptActor` executor runs","+/// jobs synchronously on the calling thread, so cases running in parallel would disturb each other's","+/// measurements.","+@Suite(.serialized)","+struct Benchmarks {}","+","+/// End-to-end benchmarks for JavaScript using the native AES module. A JavaScript driver runs the","+/// measured loop against `expo.modules.ExpoCryptoAES`, so each operation covers the engine's call","+/// dispatch, argument decoding, the native work and encoding the result back. The drivers pass the","+/// arguments the way `src/aes/index.ts` does: `aesEncryptAsync` passes `{}` when the caller gives no","+/// options and the nonce and the additional data as base64 strings, and `aesDecryptAsync` passes","+/// `{ additionalData: undefined }`.","+///","+/// Read the synchronous cases against `JS: empty driver loop`, and the cases that await a promise","+/// against `JS: empty async driver loop`.","+extension Benchmarks {","+  @Test","+  func `JS: empty driver loop`() async throws {","+    try await aesBenchmark(\"JS: empty driver loop\", body: \"\")","+  }","+","+  @Test","+  func `size read`() async throws {","+    try await aesBenchmark(\"key.size\", body: \"key.size;\")","+  }","+","+  @Test","+  func `ivSize read`() async throws {","+    try await aesBenchmark(\"sealedData.ivSize\", body: \"sealedData.ivSize;\")","+  }","+","+  @Test","+  func `fromCombined with 44 bytes`() async throws {","+    try await aesBenchmark(\"SealedData.fromCombined (44 B)\", body: \"AES.SealedData.fromCombined(combined, undefined);\")","+  }","+","+  @Test","+  func `fromParts with a tag`() async throws {","+    try await aesBenchmark(\"SealedData.fromParts with a tag\", body: \"AES.SealedData.fromParts(iv, ciphertext, tag);\")","+  }","+","+  @Test","+  func `JS: empty async driver loop`() async throws {","+    try await aesBenchmark(\"JS: empty async driver loop\", body: \"await null;\")","+  }","+","+  @Test","+  func `generate a key`() async throws {","+    try await aesBenchmark(\"await EncryptionKey.generate()\", body: \"await AES.EncryptionKey.generate();\")","+  }","+","+  @Test","+  func `import key bytes`() async throws {","+    try await aesBenchmark(\"await EncryptionKey.import (32 B)\", body: \"await AES.EncryptionKey.import(keyBytes);\")","+  }","+","+  @Test","+  func `export key bytes`() async throws {","+    try await aesBenchmark(\"await key.bytes()\", body: \"await key.bytes();\")","+  }","+","+  @Test","+  func `combined as bytes`() async throws {","+    try await aesBenchmark(\"await sealedData.combined()\", body: \"await sealedData.combined();\")","+  }","+","+  @Test","+  func `combined as base64`() async throws {","+    try await aesBenchmark(\"await sealedData.combined('base64')\", body: \"await sealedData.combined('base64');\")","+  }","+","+  @Test","+  func `encrypt 16 bytes`() async throws {","+    try await aesBenchmark(\"await encryptAsync (16 B)\", body: \"await AES.encryptAsync(smallPlaintext, key, {});\")","+  }","+","+  @Test","+  func `encrypt 16 bytes with a nonce and additional data`() async throws {","+    try await aesBenchmark(","+      \"await encryptAsync (16 B) with nonce and AAD\",","+      body: \"await AES.encryptAsync(smallPlaintext, key, encryptOptions);\"","+    )","+  }","+","+  @Test","+  func `decrypt 16 bytes`() async throws {","+    try await aesBenchmark(\"await decryptAsync (16 B)\", body: \"await AES.decryptAsync(sealedData, key, decryptOptions);\")","+  }","+","+  @Test","+  func `encrypt 1 MiB`() async throws {","+    try await aesBenchmark(\"await encryptAsync (1 MiB)\", body: \"await AES.encryptAsync(bigPlaintext, key, {});\")","+  }","+","+  @Test","+  func `decrypt 1 MiB`() async throws {","+    try await aesBenchmark(\"await decryptAsync (1 MiB)\", body: \"await AES.decryptAsync(bigSealedData, key, decryptOptions);\")","+  }","+}","+","+/// The globals every case can use, created once before the driver runs:","+/// - `AES`: the native module.","+/// - `keyBytes` and `key`: a 256-bit key, as bytes and as an `EncryptionKey`.","+/// - `smallPlaintext` and `bigPlaintext`: a 16-byte and a 1 MiB `Uint8Array`.","+/// - `sealedData` and `bigSealedData`: the two plaintexts encrypted with `key`.","+/// - `combined`, `iv`, `ciphertext` and `tag`: the parts of `sealedData` as bytes.","+/// - `encryptOptions` and `decryptOptions`: the options that `src/aes/index.ts` passes.","+private let fixtures = \"\"\"","+  var AES = expo.modules.ExpoCryptoAES;","+  var keyBytes = new Uint8Array(32).fill(7);","+  var smallPlaintext = new Uint8Array(16).fill(1);","+  var bigPlaintext = new Uint8Array(1024 * 1024).fill(1);","+  var encryptOptions = { nonce: 'CQkJCQkJCQkJCQkJ', additionalData: 'ChQeKA==' };","+  var decryptOptions = { additionalData: undefined };","+  var key, sealedData, bigSealedData, combined, iv, ciphertext, tag;","+  (async function () {","+    key = await AES.EncryptionKey.import(keyBytes);","+    sealedData = await AES.encryptAsync(smallPlaintext, key, {});","+    bigSealedData = await AES.encryptAsync(bigPlaintext, key, {});","+    combined = await sealedData.combined();","+    iv = await sealedData.iv();","+    ciphertext = await sealedData.ciphertext();","+    tag = await sealedData.tag();","+  })()","+  \"\"\"","+","+/// Measures `body` with the `ExpoCryptoAES` module registered and the `fixtures` created. The runtime","+/// of a `TestAppContext` has its own JavaScript thread, which the fixtures need to await the async","+/// members, and async functions settle their promises there. Each batch runs an async driver on that","+/// thread, which runs `body` once per iteration, and blocks until the driver's promise settles. When","+/// `body` awaits an async member, a result is the time from one call to its settled promise.","+private func aesBenchmark(_ name: String, body: String) async throws {","+  try await benchmarkCase {","+    let appContext = TestAppContext()","+    appContext.moduleRegistry.register(module: AesCryptoModule(appContext: appContext), name: nil)","+    let runtime = try appContext.runtime","+    try runtime.execute { () async throws -> Void in","+      _ = try await runtime.eval(fixtures).getPromise().await()","+      _ = try runtime.eval(\"var run = async function (n) { for (var i = 0; i < n; i++) { \\(body) } };\")","+    }","+    try withExtendedLifetime(appContext) {","+      try benchmark(name, runtime: runtime) { iterations in","+        try runtime.execute { () async throws -> Void in","+          _ = try await runtime.eval(\"run(\\(iterations))\").getPromise().await()","+        }","+      }","+    }","+  }","+}"],"additions":163,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/ios/ExpoCrypto.podspec","lines":["@@ -26,4 +26,23 @@ Pod::Spec.new do |s|","     'DEFINES_MODULE' => 'YES',","     'SWIFT_COMPILATION_MODE' => 'wholemodule'","   }","+","+  s.exclude_files = ['Tests/', 'Benchmarks/']","+  s.test_spec 'Tests' do |test_spec|","+    # ExpoModulesCore requires React-hermes or React-jsc in tests, add ExpoModulesTestCore for the underlying dependencies","+    test_spec.dependency 'ExpoModulesTestCore'","+","+    test_spec.source_files = 'Tests/**/*.{m,swift}'","+    # The test bundle links C++ code from ExpoModulesCore but does not inherit its","+    # user_target_xcconfig (-lc++), so link the C++ runtime explicitly.","+    test_spec.libraries = 'c++'","+  end","+","+  # Performance benchmarks, run with `et native-unit-tests --benchmarks`. A separate spec, so unit","+  # test runs neither build nor run them.","+  s.test_spec 'Benchmarks' do |test_spec|","+    test_spec.dependency 'ExpoModulesTestCore'","+    test_spec.source_files = 'Benchmarks/**/*.swift'","+    test_spec.libraries = 'c++'","+  end"," end"],"additions":19,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/ios/Tests/AesCryptoModuleTests.swift","lines":["@@ -0,0 +1,469 @@","+// Copyright 2026-present 650 Industries. All rights reserved.","+","+import ExpoModulesTestCore","+import Testing","+","+@testable import ExpoCrypto","+@testable import ExpoModulesCore","+","+/// Calls the AES module from JavaScript, so the arguments and the results go through the same","+/// conversions as in an app.","+@Suite(\"AesCryptoModule\")","+@JavaScriptActor","+struct AesCryptoModuleTests {","+  let appContext: AppContext","+  let runtime: ExpoRuntime","+","+  init() throws {","+    appContext = TestAppContext()","+    runtime = try appContext.runtime","+    appContext.moduleRegistry.register(","+      holder: ModuleHolder(","+        appContext: appContext,","+        module: AesCryptoModule(appContext: appContext),","+        name: \"ExpoCryptoAES\"","+      )","+    )","+    _ = try runtime.eval(","+      \"\"\"","+      var AES = expo.modules.ExpoCryptoAES;","+      var key = new Uint8Array(32).fill(7);","+      var nonce = new Uint8Array(12).fill(9);","+      var plaintext = new Uint8Array([1, 2, 3, 4, 5]);","+      var additionalData = new Uint8Array([10, 20, 30, 40]);","+      function hex(bytes) {","+        return Array.from(bytes, function (byte) {","+          return byte.toString(16).padStart(2, '0');","+        }).join('');","+      }","+      function fromHex(string) {","+        return new Uint8Array(string.match(/../g).map(function (pair) {","+          return parseInt(pair, 16);","+        }));","+      }","+      function join(values) {","+        return values.join(' ');","+      }","+      function encrypt(input, options) {","+        return AES.EncryptionKey.import(key).then(function (encryptionKey) {","+          return AES.encryptAsync(input, encryptionKey, options);","+        });","+      }","+      function decrypt(sealedData, options) {","+        return AES.EncryptionKey.import(key).then(function (encryptionKey) {","+          return AES.decryptAsync(sealedData, encryptionKey, options);","+        });","+      }","+      // Resolves to the nonce, the ciphertext and the tag in hex, separated by spaces.","+      function partsInHex(sealedData) {","+        return Promise.all([sealedData.iv(), sealedData.ciphertext(), sealedData.tag()]).then(function (parts) {","+          return parts.map(hex).join(' ');","+        });","+      }","+      // Resolves to the code of the error that rejects the promise, or to 'resolved'.","+      function rejectionCode(promise) {","+        return promise.then(","+          function () {","+            return 'resolved';","+          },","+          function (error) {","+            return String(error.code);","+          }","+        );","+      }","+      // For errors whose code comes from Expo Modules Core rather than from this module.","+      function rejects(promise) {","+        return promise.then(","+          function () {","+            return false;","+          },","+          function () {","+            return true;","+          }","+        );","+      }","+      // Returns the code of the error that the callback throws, or 'returned'.","+      function thrownCode(callback) {","+        try {","+          callback();","+          return 'returned';","+        } catch (error) {","+          return String(error.code);","+        }","+      }","+      \"\"\"","+    )","+  }","+","+  // MARK: - EncryptionKey","+","+  @Test","+  func `generate creates a 256-bit EncryptionKey by default`() async throws {","+    let result = try await runtime.evalAsync(","+      \"\"\"","+      AES.EncryptionKey.generate().then(function (encryptionKey) {","+        return join([encryptionKey instanceof AES.EncryptionKey, encryptionKey.size]);","+      })","+      \"\"\"","+    )","+    #expect(try result.asString() == \"true 256\")","+  }","+","+  @Test","+  func `generate creates a key of each supported size`() async throws {","+    let result = try await runtime.evalAsync(","+      \"\"\"","+      Promise.all([128, 192, 256].map(function (size) {","+        return AES.EncryptionKey.generate(size);","+      })).then(function (keys) {","+        return join(keys.map(function (encryptionKey) {","+          return encryptionKey.size;","+        }));","+      })","+      \"\"\"","+    )","+    #expect(try result.asString() == \"128 192 256\")","+  }","+","+  @Test","+  func `generate rejects an unsupported key size`() async throws {","+    let result = try await runtime.evalAsync(\"rejects(AES.EncryptionKey.generate(100))\")","+    #expect(try result.asBool() == true)","+  }","+","+  @Test","+  func `import accepts key bytes of each supported size`() async throws {","+    let result = try await runtime.evalAsync(","+      \"\"\"","+      Promise.all([16, 24, 32].map(function (length) {","+        return AES.EncryptionKey.import(new Uint8Array(length));","+      })).then(function (keys) {","+        return join(keys.map(function (encryptionKey) {","+          return encryptionKey.size;","+        }));","+      })","+      \"\"\"","+    )","+    #expect(try result.asString() == \"128 192 256\")","+  }","+","+  @Test","+  func `import accepts hex and base64 strings`() async throws {","+    let result = try await runtime.evalAsync(","+      \"\"\"","+      Promise.all([","+        AES.EncryptionKey.import('\\(Reference.keyHex)', 'hex'),","+        AES.EncryptionKey.import('\\(Reference.keyBase64)', 'base64'),","+      ]).then(function (keys) {","+        return Promise.all(keys.map(function (encryptionKey) {","+          return encryptionKey.bytes().then(hex);","+        }));","+      }).then(join)","+      \"\"\"","+    )","+    #expect(try result.asString() == \"\\(Reference.keyHex) \\(Reference.keyHex)\")","+  }","+","+  @Test","+  func `bytes and encoded export the key`() async throws {","+    let result = try await runtime.evalAsync(","+      \"\"\"","+      AES.EncryptionKey.import(key).then(function (encryptionKey) {","+        return Promise.all([","+          encryptionKey.bytes().then(hex),","+          encryptionKey.encoded('hex'),","+          encryptionKey.encoded('base64'),","+        ]);","+      }).then(join)","+      \"\"\""],"additions":178,"deletions":0,"truncated":false}],"additions":578,"deletions":129,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-01T15:16:10.936834+00:00"}