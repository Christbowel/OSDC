{"id":"12788112433a65869bbc08edfbf03a002d5122e1","axis":"silent","repo":"gfx-rs/wgpu","sha":"12788112433a65869bbc08edfbf03a002d5122e1","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -286,6 +286,8 @@ By @alextechcc in [#8014](https://github.com/gfx-rs/wgpu/pull/8014)."," - Fix pending buffer mappings incorrectly succeeding when the device is lost before they are processed. By @jinleili in [#10301](https://github.com/gfx-rs/wgpu/pull/10301)."," - Fix initialization tracking for `external_texture` binding points, for both `ExternalTexture`s and `TextureView`s bound to them. By @ErichDonGubler in [#10276](https://github.com/gfx-rs/wgpu/pull/10276) and [#10366](https://github.com/gfx-rs/wgpu/pull/10366)."," - Make `TextureBlitter` respect the `sample_type` when performing downsampling. Previously, `FilterMode::Nearest` was always used when copying a larger texture to a smaller one. By @DouglasDwyer in [#10657](https://github.com/gfx-rs/wgpu/pull/10657)","+- Fixed some cases where `Adapter::get_texture_format_features` and `TextureFormat::guaranteed_format_features` did not match the validation applied by `create_texture`. By @andyleiserson in [#TODO](https://github.com/gfx-rs/wgpu/pull/TODO).","+- `STORAGE_BINDING` usage is no longer allowed for multi-planar textures. It was previously accepted, but was untested, and likely broken. By @andyleiserson in [#TODO](https://github.com/gfx-rs/wgpu/pull/TODO)."," "," #### naga"," "],"additions":2,"deletions":0,"truncated":false},{"path":"tests/tests/wgpu-gpu/planar_texture/mod.rs","lines":["@@ -12,6 +12,10 @@ pub fn all_tests(tests: &mut Vec<GpuTestInitializer>) {","         NV12_TEXTURE_COPYING,","         P010_TEXTURE_COPYING,","         NV12_PLANE_TO_SINGLE_PLANE_COPY,","+        NV12_FORMAT_FEATURES_MATCH_CREATE_TEXTURE,","+        NV12_ADAPTER_FORMAT_FEATURES_MATCH_CREATE_TEXTURE,","+        P010_FORMAT_FEATURES_MATCH_CREATE_TEXTURE,","+        P010_ADAPTER_FORMAT_FEATURES_MATCH_CREATE_TEXTURE,","     ]);"," }"," ","@@ -221,6 +225,84 @@ fn test_planar_texture_rendering(","     ctx.queue.submit([encoder.finish()]);"," }"," ","+// Helper function to check that `create_texture` accepts exactly the usages","+// in the format features that the device validates against, and that the","+// adapter reports every usage that is guaranteed.","+async fn test_format_features_match_create_texture(","+    ctx: &TestingContext,","+    format: wgpu::TextureFormat,","+) {","+    let features = ctx.device.features();","+    let adapter_usages = ctx","+        .adapter","+        .get_texture_format_features(format)","+        .allowed_usages;","+    let guaranteed_usages = format.guaranteed_format_features(features).allowed_usages;","+    let uses_adapter_features = features","+        .contains(wgpu::Features::TEXTURE_ADAPTER_SPECIFIC_FORMAT_FEATURES)","+        || !ctx","+            .adapter_downlevel_capabilities","+            .flags","+            .contains(wgpu::DownlevelFlags::WEBGPU_TEXTURE_FORMAT_SUPPORT);","+    let expected_usages = if uses_adapter_features {","+        adapter_usages","+    } else {","+        guaranteed_usages","+    };","+","+    let mut mismatches = Vec::new();","+    for usage in [","+        wgpu::TextureUsages::COPY_SRC,","+        wgpu::TextureUsages::COPY_DST,","+        wgpu::TextureUsages::TEXTURE_BINDING,","+        wgpu::TextureUsages::STORAGE_BINDING,","+        wgpu::TextureUsages::RENDER_ATTACHMENT,","+    ] {","+        let scope = ctx.device.push_error_scope(wgpu::ErrorFilter::Validation);","+        let _ = ctx.device.create_texture(&wgpu::TextureDescriptor {","+            label: None,","+            dimension: wgpu::TextureDimension::D2,","+            size: wgpu::Extent3d {","+                width: 256,","+                height: 128,","+                depth_or_array_layers: 1,","+            },","+            format,","+            usage,","+            mip_level_count: 1,","+            sample_count: 1,","+            view_formats: &[],","+ 