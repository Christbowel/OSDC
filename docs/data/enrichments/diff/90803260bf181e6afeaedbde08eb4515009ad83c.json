@","+import { test, expect } from \"@playwright/test\"","+import { nextEventNamed, readEventLogs, visitAction } from \"../helpers/page\"","+","+test(\"Drive visits scroll to percent-encoded Unicode fragment targets\", async ({ page }) => {","+  await page.goto(\"/src/tests/fixtures/navigation.html\")","+  await readEventLogs(page)","+","+  await page.evaluate(() => window.Turbo.visit(\"/src/tests/fixtures/encoded_anchors.html#%E5%89%8D%E4%B8%96\"))","+  await nextEventNamed(page, \"turbo:load\")","+","+  await expect(page).toHaveURL(/encoded_anchors\\.html#%E5%89%8D%E4%B8%96$/)","+  expect(await visitAction(page)).toEqual(\"advance\")","+  const target = page.locator('[data-anchor=\"unicode\"]')","+  await expect(target).toBeInViewport()","+  await expect.poll(() => target.evaluate((element) => Math.abs(element.getBoundingClientRect().top))).toBeLessThanOrEqual(1)","+})"],"additions":16,"deletions":0,"truncated":false},{"path":"src/tests/functional/form_submission_body_tests.js","lines":["@@ -0,0 +1,27 @@","+import { expect, test } from \"@playwright/test\"","+","+test(\"an empty POST form populated during submit-start does not add its body to the URL\", async ({ page }) => {","+  await page.goto(\"/src/tests/fixtures/form.html\")","+  await page.evaluate(() => {","+    const form = document.createElement(\"form\")","+    form.method = \"post\"","+    form.action = \"/__turbo/redirect?path=/src/tests/fixtures/one.html\"","+    const button = document.createElement(\"button\")","+    button.textContent = \"Submit empty form\"","+    form.append(button)","+    form.addEventListener(\"turbo:submit-start\", ({ detail }) => {","+      detail.formSubmission.fetchRequest.body.append(\"message\", \"event-only\")","+    })","+    document.body.prepend(form)","+  })","+","+  const requestPromise = page.waitForRequest((request) =>","+    request.method() === \"POST\" && new URL(request.url()).pathname === \"/__turbo/redirect\"","+  )","+  await page.getByRole(\"button\", { name: \"Submit empty form\" }).click()","+  const request = await requestPromise","+","+  expect(Array.from(new URL(request.url()).searchParams)).toEqual([[\"path\", \"/src/tests/fixtures/one.html\"]])","+  expect(new URLSearchParams(request.postData()).get(\"message\")).toEqual(\"event-only\")","+  await expect(page.locator(\"h1\")).toHaveText(\"One\")","+})"],"additions":27,"deletions":0,"truncated":false},{"path":"src/tests/functional/frame_form_submission_tests.js","lines":["@@ -0,0 +1,208 @@","+import { expect, test } from \"@playwright/test\"","+","+const heldRequests = new WeakMap()","+const pageErrors = new WeakMap()","+","+test.beforeEach(async ({ page }) => {","+  pageErrors.set(page, [])","+  page.on(\"pageerror\", (error) => pageErrors.get(page).push(error.message))","+  await page.goto(\"/src/tests/fixtures/frames/form_submission_lifecycle.html\")","+  await page.evaluate(() => {","+    window.frameFormEvents = []","+    window.frameFormSubmissions = new Map()","+    for (const type of [\"turbo:before-fetch-request\", \"turbo:submit-start\", \"turbo:submit-end\"]) {","+      addEventListener(type, (event) => {","+        const { formSubmission } = event.detail","+        const formId = formSubmission?.formElement.id || event.target.id","+        window.frameFormEvents.push([type, formId])","+        if (formSubmission) window.frameFormSubmissions.set(formId, formSubmission)","+      })","+    }","+  })","+})","+","+test.afterEach(async ({ page }) => {","+  const requests = heldRequests.get(page) || []","+  for (const request of requests) request.release()","+  await Promise.all(requests.map((request) => request.finished))","+  expect(pageErrors.get(page)).toEqual([])","+})","+","+for (const formId of [\"external-form\", \"form-a\"]) {","+  test(`removing the destination cancels the GET submitted by ${formId}`, async ({ page }) => {","+    const gate = await holdRequests(page)","+    await submitForm(page, formId)","+    await gate.arrived","+    const [held] = gate.requests","+    const failed = page.waitForEvent(\"requestfailed\", (request) => request === held.request)","+","+    await page.locator(\"#destination\").evaluate((frame) => frame.remove())","+","+    expect(await submissionAborted(page, formId)).toEqual(true)","+    await failed","+    await submissionEnded(page, formId)","+    await expect(page).toHaveURL(/\\/frames\\/form_submission_lifecycle\\.html$/)","+  })","+}","+","+test(\"removing the source preserves a GET aimed at another connected frame\", async ({ page }) => {","+  const gate = await holdRequests(page)","+  await submitForm(page, \"form-a\")","+  await gate.arrived","+","+  await page.locator(\"#source-a\").evaluate((frame) => frame.remove())","+","+  expect(await submissionAborted(page, \"form-a\")).toEqual(false)","+  gate.requests[0].release()","+  await expect(page.locator(\"#destination\")).toHaveText(\"Updated destination\")","+  await submissionEnded(page, \"form-a\")","+})","+","+test(\"removing the destination cancels GET submissions from both source frames\", async ({ page }) => {","+  const gate = await holdRequests(page, 2)","+  await submitForm(page, \"form-a\")","+  await submitForm(page, \"form-c\")","+  await gate.arrived","+  const failures = gate.requests.map(({ request }) => page.waitForEvent(\"requestfailed\", (failed) => failed === request))","+","+  await page.locator(\"#destination\").evaluate((frame) => frame.remove())","+","+  expect(await submissionAborted(page, \"form-a\")).toEqual(true)","+  expect(await submissionAborted(page, \"form-c\")).toEqual(true)","+  await Promise.all(failures)","+  await submissionEnded(page, \"form-a\")","+  await submissionEnded(page, \"form-c\")","+})","+","+test(\"finishing one GET does not unregister another source's pending submission\", async ({ page }) => {","+  const gate = await holdRequests(page, 2)","+  await submitForm(page, \"form-a\")","+  await submitForm(page, \"form-c\")","+  await gate.arrived","+  const first = gate.requests.find(({ request }) => new URL(request.url()).searchParams.get(\"source\") === \"a\")","+  const second = gate.requests.find(({ request }) => new URL(request.url()).searchParams.get(\"source\") === \"c\")","+  first.release()","+  await submissionEnded(page, \"form-a\")","+  await expect(page.locator(\"#destination\")).toHaveText(\"Updated destination\")","+  const failed = page.waitForEvent(\"requestfailed\", (request) => request === second.request)","+","+  await page.locator(\"#destination\").evaluate((frame) => frame.remove())","+","+  expect(await submissionAborted(page, \"form-c\")).toEqual(true)","+  await failed","+  await submissionEnded(page, \"form-c\")","+})","+","+test(\"declining confirmation does not start a frame form submission\", async ({ page }) => {","+  await deferConfirmation(page)","+  await submitForm(page, \"form-a\")","+  await page.waitForFunction(() => window.confirmationAsked)","+","+  await page.evaluate(() => window.answerConfirmation(false))","+  await page.waitForFunction(() => window.confirmationResolved)","+  await page.locator(\"#destination\").evaluate((frame) => frame.remove())","+","+  expect(await page.evaluate(() => window.frameFormEvents)).toEqual([])","+})","+","+test(\"removing the destination while confirming prevents the accepted GET from starting\", async ({ page }) => {","+  await deferConfirmation(page)","+  await submitForm(page, \"form-a\")","+  await page.waitForFunction(() => window.confirmationAsked)","+","+  await page.locator(\"#destination\").evaluate((frame) => frame.remove())","+  await page.evaluate(() => window.answerConfirmation(true))","+  await page.waitForFunction(() => window.confirmationResolved)","+","+  expect(await page.evaluate(() => window.frameFormEvents)).toEqual([])","+})","+","+test(\"removing the destination preserves a POST Turbo Stream response\", async ({ page }) => {","+  const gate = await holdRequests(page, 1, \"**/__turbo/messages\")","+  await submitForm(page, \"post-form\")","+  await gate.arrived","+","+  await page.locator(\"#destination\").evaluate((frame) => frame.remove())","+","+  expect(await submissionAborted(page, \"post-form\")).toEqual(false)","+  gate.requests[0].release()","+  await expect(page.locator(\"#messages .message\")).toHaveText(\"POST applied\")","+  await submissionEnded(page, \"post-form\")","+})","+","+test(\"moving the connected destination atomically preserves its GET submission\", async ({ page }) => {","+  const gate = await holdRequests(page)","+  await submitForm(page, \"form-a\")","+  await gate.arrived","+","+  await page.locator(\"#destination\").evaluate((frame) => document.getElementById(\"moved-frames\").append(frame))","+","+  expect(await submissionAborted(page, \"form-a\")).toEqual(false)","+  gate.requests[0].release()","+  await expect(page.locator(\"#moved-frames #destination\")).toHaveText(\"Updated destination\")","+  await submissionEnded(page, \"form-a\")","+})","+","+test(\"removing a destination with recurse preserves its GET submission\", async ({ page }) => {","+  const gate = await holdRequests(page)","+  await page.locator(\"#destination\").evaluate((frame) => frame.setAttribute(\"recurse\", \"nested\"))","+  await submitForm(page, \"external-form\")","+  await gate.arrived","+","+  await page.locator(\"#destination\").evaluate((frame) => {","+    window.detachedDestination = frame","+    frame.remove()","+  })","+","+  expect(await submissionAborted(page, \"external-form\")).toEqual(false)","+  gate.requests[0].release()","+  await page.waitForFunction(() => window.detachedDestination.textContent.includes(\"Updated destination\"))","+  await submissionEnded(page, \"external-form\")","+})","+","+async function holdRequests(page, count = 1, pattern = \"**/frames/form_submission_target.html?*\") {","+  const requests = []","+  heldRequests.set(page, requests)","+  let arrived","+  const allArrived = new Promise((resolve) => arrived = resolve)","+  await page.route(pattern, async (route) => {","+    let release","+    const gate = new Promise((resolve) => release = resolve)","+    const request = route.request()","+    const held = { request, release }","+    held.finished = (async () => {","+      await gate","+      if (!request.failure()) await route.continue()","+    })()","+    requests.push(held)","+    if (requests.length === count) arrived()","+    await held.finished","+  })","+","+  return { requests, arrived: allArrived }","+}","+","+async function submitForm(page, id) {","+  await page.locator(`#${id}`).evaluate((form) => form.requestSubmit())","+}","+","+async function submissionAborted(page, id) {","+  return page.evaluate((id) => window.frameFormSubmissions.get(id).fetchRequest.abortSignal.aborted, id)","+}","+","+async function submissionEnded(page, id) {","+  await page.waitForFunction((id) => window.frameFormEvents.some(([type, formId]) => type === \"turbo:submit-end\" && formId === id), id)","+}","+","+async function deferConfirmation(page) {","+  await page.locator(\"#form-a\").evaluate((form) => form.setAttribute(\"data-turbo-confirm\", \"Continue?\"))","+  await page.evaluate(() => {","+    const answer = new Promise((resolve) => window.answerConfirmation = resolve)","+    window.Turbo.config.forms.confirm = async () => {","+      window.confirmationAsked = true","+      const result = await answer","+      window.confirmationResolved = true","+      return result","+    }","+  })","+}"],"additions":208,"deletions":0,"truncated":false},{"path":"src/tests/functional/frame_navigation_tests.js","lines":["@@ -1,5 +1,7 @@"," import { expect, test } from \"@playwright/test\"","-import { getFromLocalStorage, nextBeat, nextEventNamed, nextEventOnTarget, pathname, scrollToSelector, withPathname } from \"../helpers/page\"","+import { getFromLocalStorage, nextBeat, nextEventNamed, nextEventOnTarget, pathname, readEventLogs, scrollToSelector, withPathname } from \"../helpers/page\"","+","+const frameNavigationPath = \"/src/tests/fixtures/frame_navigation.html\""," "," test(\"frame navigation with descendant link\", async ({ page }) => {","   await page.goto(\"/src/tests/fixtures/frame_navigation.html\")","@@ -29,6 +31,43 @@ test(\"frame navigation with exterior link in Shadow DOM\", async ({ page }) => {","   await nextEventOnTarget(page, \"frame\", \"turbo:frame-load\")"," })"," ","+for (const { description, selector, target } of [","+  { description: \"uses the inner frame target when clicking slotted content\", selector: \"#shadow-link-slot\", target: \"frame\" },","+  { description: \"uses the inner frame target when clicking an inner span\", selector: \"#shadow-frame-span span\", target: \"frame\" },","+  { description: \"preserves the host frame target over an inner _top target\", selector: \"#shadow-frame-host\", target: \"frame\" },","+  { description: \"respects an inner _top target\", selector: \"#shadow-top-link\", target: \"_top\" },","+  { description: \"preserves the host _top target over an inner frame target\", selector: \"#shadow-top-host\", target: \"_top\" },","+  { description: \"preserves an empty host target over an inner frame target\", selector: \"#shadow-empty-host\", target: \"_top\" },","+  { description: \"targets another frame from inside an enclosing frame\", selector: \"#shadow-frame-nested\", target: \"empty-head\" }","+]) {","+  test(`frame navigation from a Shadow DOM link ${description}`, async ({ page }) => {","+    await prepareShadowLinkNavigation(page)","+    const requests = trackFrameNavigationRequests(page)","+","+    await page.click(selector)","+","+    if (target === \"_top\") {","+      await nextEventNamed(page, \"turbo:load\")","+      await expect(page).toHaveURL(`${frameNavigationPath}?shadow=top`)","+      await expect(page.locator(\"h1\")).toHaveText(\"Frame navigation tests\")","+    } else {","+      await nextEventOnTarget(page, target, \"turbo:frame-load\")","+      await expect(page).toHaveURL(frameNavigationPath)","+      await expect(page.locator(\"h1\")).toHaveText(\"Original page\")","+","+      if (target === \"frame\") {","+        await expect(page.locator(\"#frame h2\")).toHaveText(\"Frame Navigation\")","+        await expect(page.locator(\"#empty-head\")).toHaveText(\"Original second frame\")","+      } else {","+        await expect(page.locator(\"#empty-head p\")).toContainText(\"The following link\")","+        await expect(page.locator(\"#frame h2\")).toHaveText(\"Original frame\")","+      }","+    }","+","+    expect(requests, \"makes one request with the correct frame target\").toEqual([target === \"_top\" ? undefined : target])","+  })","+}","+"," test(\"frame navigation with data-turbo-action\", async ({ page }) => {","   await page.goto(\"/src/tests/fixtures/frame_navigation.html\")","   await page.click(\"#link-to-frame-with-empty-head\")","@@ -123,3 +162,21 @@ test(\"promoted frame navigations are cached\", async ({ page }) => {","   await expect(page.locator(\"#tab-frame\"), \"caches one.html without #tab-frame[src]\").not.toHaveAttribute(\"src\")","   await expect(page.locator(\"#tab-frame\"), \"caches one.html without [complete]\").not.toHaveAttribute(\"complete\")"," })","+","+async function prepareShadowLinkNavigation(page) {","+  await page.goto(frameNavigationPath)","+  await page.locator(\"h1\").evaluate((element) => element.textContent = \"Original page\")","+  await page.locator(\"#frame h2\").evaluate((element) => element.textContent = \"Original frame\")","+  await page.locator(\"#empty-head\").evaluate((element) => element.textContent = \"Original second frame\")","+  await readEventLogs(page)","+}","+","+function trackFrameNavigationRequests(page) {","+  const requests = []","+  page.on(\"request\", (request) => {","+    if (new URL(request.url()).pathname === frameNavigationPath) {","+      requests.push(request.headers()[\"turbo-frame\"])","+    }","+  })","+  return requests","+}"],"additions":58,"deletions":1,"truncated":false},{"path":"src/tests/functional/frame_tests.js","lines":["@@ -5,7 +5,6 @@ import {","   nextAttributeMutationNamed,","   noNextAttributeMutationNamed,","   nextBeat,","-  nextBody,","   nextEventNamed,","   nextEventOnTarget,","   noNextEventNamed,","@@ -390,28 +389,6 @@ for (const status of [200, 422]) {","   })"," }"," ","-test(\"removing a frame cancels a GET form submission targeting it\", async ({ page }) => {"],"additions":0,"deletions":2,"truncated":false}],"additions":473,"deletions":17,"truncated":true,"file_count":19},"error":null,"fetched_at":"2026-11-13T17:05:09.421757+00:00"}