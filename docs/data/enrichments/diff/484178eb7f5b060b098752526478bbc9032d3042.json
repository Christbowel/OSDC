{"id":"484178eb7f5b060b098752526478bbc9032d3042","axis":"silent","repo":"vercel/next.js","sha":"484178eb7f5b060b098752526478bbc9032d3042","parsed":{"files":[{"path":".config/nextest.toml","lines":["@@ -1,3 +1,12 @@","+# These tests launch Go compiler processes and hash the SDK. Limit concurrent owners","+# so cold SDK/build caches do not starve startup and shutdown deadlines on CI runners.","+[test-groups.go-compiler]","+max-threads = 2","+","+[[profile.default.overrides]]","+filter = 'package(turbopack-cli) | package(turbopack-go)'","+test-group = 'go-compiler'","+"," [profile.tp-test-linux.junit]"," path = \"junit.xml\""," report-name = \"Turbopack tests (Linux)\""],"additions":9,"deletions":0,"truncated":false},{"path":".github/workflows/build_reusable.yml","lines":["@@ -316,6 +316,13 @@ jobs:","       - name: Wait for Rust toolchain","         wait: install-rust"," ","+      - name: Install Go for native bundle tests","+        if: ${{ inputs.needsNextest == 'yes' }}","+        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0","+        with:","+          go-version: '1.24.x'","+          cache: false","+","       - name: Install nextest","         if: ${{ inputs.needsNextest == 'yes' }}","         run: cargo binstall --no-confirm --locked cargo-nextest@0.9.133"],"additions":7,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -9632,6 +9632,7 @@ dependencies = [","  \"rustc-hash 2.1.1\",","  \"serde\",","  \"swc_core 82.2.0\",","+ \"tempfile\",","  \"tokio\",","  \"tracing\",","  \"tracing-subscriber\",","@@ -9652,6 +9653,7 @@ dependencies = [","  \"turbopack-ecmascript\",","  \"turbopack-ecmascript-runtime\",","  \"turbopack-env\",","+ \"turbopack-go\",","  \"turbopack-node\",","  \"turbopack-nodejs\",","  \"turbopack-resolve\",","@@ -9928,6 +9930,28 @@ dependencies = [","  \"turbopack-ecmascript\","," ]"," ","+[[package]]","+name = \"turbopack-go\"","+version = \"0.1.0\"","+dependencies = [","+ \"anyhow\",","+ \"bincode\