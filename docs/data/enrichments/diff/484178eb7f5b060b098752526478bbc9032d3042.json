.1.6\""," windows-sys = { workspace = true, features = [","   \"Win32_Foundation\",","+  \"Win32_Security\", # Required by CreateFileW in src/windows.rs.","   \"Win32_Storage_FileSystem\",","   \"Win32_System_SystemServices\","," ] }"],"additions":4,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbo-tasks-fs/src/content.rs","lines":["@@ -341,6 +341,12 @@ impl File {","         self","     }"," ","+    /// Sets the permissions used when materializing this file.","+    pub fn with_permissions(mut self, permissions: Permissions) -> Self {","+        self.meta.permissions = permissions;","+        self","+    }","+","     /// Returns a Read/AsyncRead/Stream/Iterator to access the File's contents.","     pub fn read(&self) -> RopeReader<'_> {","         self.content.read()"],"additions":6,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbo-tasks-fs/src/disk.rs","lines":["@@ -503,6 +503,23 @@ impl DiskFileSystem {","         Ok(())","     }"," ","+    /// Track a file consumed by an external reader (for example a compiler subprocess).","+    /// Unlike depending on `read()`, this invalidates the calling task for every file event,","+    /// including an edit that restores identical bytes. Call before accessing the OS path.","+    pub async fn track_file(&self, path: &FileSystemPath) -> Result<()> {","+        self.inner","+            .register_read_invalidator(&Arc::new(self.to_sys_path_raw(path)))","+            .await","+    }","+","+    /// Track directory membership consumed by an external reader. Missing directories are","+    /// watched through their nearest existing parent, just like ordinary filesystem reads.","+    pub async fn track_directory(&self, path: &FileSystemPath) -> Result<()> {","+        self.inner","+            .register_dir_invalidator(&Arc::new(self.to_sys_path_raw(path)))","+            .await","+    }","+","     pub fn invalidate(&self) {","         self.inner.invalidate();","     }","@@ -1354,25 +1371,46 @@ impl FileSystem for DiskFileSystem {","                     PersistedFileContent::Content(..) => {","                         let content = content.clone();"," ","+                        fn write_file(path: &Path, file: &File) -> io::Result<()> {","+                            let write = |output: &mut std::fs::File| {","+                                std::io::copy(&mut file.read(), output)?;","+                                #[cfg(unix)]","+                                output.set_permissions(file.meta.permissions.into())?;","+                                output.flush()","+                            };","+","+                            #[cfg(any(unix, windows))]","+                            if file.meta.permissions == crate::Permissions::Executable {","+                                // Replace the executable instead of truncating it, so a running","+                                // Unix binary can keep using the previous file.","+                                let mut temporary = tempfile::NamedTempFile::new_in(","+                                    path.parent().ok_or(ErrorKind::InvalidInput)?,","+                                )?;","+                                write(temporary.as_file_mut())?;","+                                return temporary","+                                    .into_temp_path()","+                                    .persist(path)","+                                    .map_err(|error| error.error);","+                            }","+","+                            write(&mut std::fs::File::create(path)?)","+                        }","+","                         let mut missing_parent_dir = false;","                         let do_write = || {","                             if missing_parent_dir && let Some(parent) = full_path.parent() {","                                 std::fs::create_dir_all(parent)?;","                                 missing_parent_dir = false;","                             }","-                            let mut f = std::fs::File::create(&**full_path).inspect_err(|err| {","+                            let PersistedFileContent::Content(file) = &*content else {","+                                unreachable!()","+                            };","+                            write_file(full_path, file).inspect_err(|err| {","                                 if err.kind() == ErrorKind::NotFound {","                                     // create the parent dirs in the next attempt","                                     missing_parent_dir = true;","                                 }","                             })?;","-                            let PersistedFileContent::Content(file) = &*content else {","-                                unreachable!()","-                            };","-                            std::io::copy(&mut file.read(), &mut f)?;","-                            #[cfg(unix)]","-                            f.set_permissions(file.meta.permissions.into())?;","-                            f.flush()?;"," ","                             static WRITE_VERSION: LazyLock<bool> = LazyLock::new(|| {","                                 std::env::var_os(\"TURBO_ENGINE_WRITE_VERSION\")","@@ -1389,11 +1427,7 @@ impl FileSystem for DiskFileSystem {","                                 }","                                 full_path.set_extension(ext);","                                 validate_path_length(&full_path)?;","-                                let mut f = std::fs::File::create(&*full_path)?;","-                                std::io::copy(&mut file.read(), &mut f)?;","-                                #[cfg(unix)]","-                                f.set_permissions(file.meta.permissions.into())?;","-                                f.flush()?;","+                                write_file(&full_path, file)?;","                             }","                             Ok::<(), io::Error>(())","                         };","@@ -1766,6 +1800,70 @@ mod tests {","         Ok(take_effects(op).await?.cell())","     }"," ","+    #[cfg(not(miri))]","+    #[turbo_tasks::function(operation, root)]","+    fn external_tracking_filesystem(root: RcStr) -> Vc<DiskFileSystem> {","+        DiskFileSystem::new_with_options(","+            rcstr!(\"external-tracking\"),","+            Vc::cell(root),","+            Vec::new(),","+            DiskWatcherConfig {","+                // Registration must walk back to the canonical root on Windows too.","+                recursive_mode: Some(crate::DiskWatcherRecursiveMode::NonRecursive),","+                ..Default::default()","+            },","+            DiskFileSystemMap::empty(),","+        )","+    }","+","+    #[cfg(not(miri))] // Native filesystem watchers are unavailable under Miri.","+    #[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+    async fn external_tracking_uses_internal_paths() -> Result<()> {","+        let scratch = tempfile::tempdir()?;","+        let root = std::fs::canonicalize(scratch.path())?;","+        std::fs::create_dir(root.join(\"nested\"))?;","+        std::fs::write(root.join(\"nested/input.txt\"), \"input\")?;","+        let tt = turbo_tasks::TurboTasks::new(TurboTasksBackend::new(","+            BackendOptions::default(),","+            noop_backing_storage(),","+        ));","+        tt.run_once(async move {","+            let fs = external_tracking_filesystem(RcStr::from(root.to_str().unwrap()))","+                .resolve()","+                .strongly_consistent()","+                .await?;","+            let root_path = FileSystemPath {","+                fs: ResolvedVc::upcast(fs),","+                path: rcstr!(\"\"),","+            };","+            let fs = fs.await?;","+            fs.start_watching().await?;","+            let file = root_path.join(\"nested/input.txt\")?;","+            let directory = root_path.join(\"nested\")?;","+            assert!(turbo_tasks::get_invalidator().is_some());","+            fs.track_file(&file).await?;","+            fs.track_directory(&directory).await?;","+            // Watcher events and writes use these same raw paths as invalidation keys.","+            assert!(","+                fs.inner","+                    .invalidator_map","+                    .lock()","+                    .unwrap()","+                    .contains_key(fs.to_sys_path_raw(&file).as_path())","+            );","+            assert!(","+                fs.inner","+                    .dir_invalidator_map","+                    .lock()","+                    .unwrap()","+                    .contains_key(fs.to_sys_path_raw(&directory).as_path())","+            );","+            fs.stop_watching().await;","+            anyhow::Ok(())","+        })","+        .await","+    }","+","     #[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","     async fn test_try_from_sys_path() {","         let sys_root = if cfg!(windows) {"],"additions":111,"deletions":13,"truncated":false},{"path":"turbopack/crates/turbopack-cli/Cargo.toml","lines":["@@ -60,6 +60,7 @@ turbopack = { workspace = true }"," turbopack-browser = { workspace = true }"," turbopack-cli-utils = { workspace = true }"," turbopack-core = { workspace = true }","+turbopack-go = { workspace = true }"," turbopack-css = { workspace = true }"," turbopack-dev-server = { workspace = true }"," turbopack-ecmascript = { workspace = true }","@@ -78,5 +79,6 @@ vergen-gitcl = { workspace = true }"," [dev-dependencies]"," criterion = { workspace = true, features = [\"async_tokio\"] }"," regex = { workspace = true }","+tempfile = { workspace = true }"," turbopack-bench = { workspace = true }"," turbo-tasks-malloc = { workspace = true, features = [\"custom_allocator\"] }"],"additions":2,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbopack-cli/README.md","lines":["@@ -0,0 +1,200 @@","+# Turbopack CLI","+","+`turbopack-cli` builds JavaScript/TypeScript entrypoints and, experimentally,","+native executables from `.go` files. Both languages participate in the same","+compiler task graph and output pipeline, including mixed entrypoints.","+","+Build the CLI from the repository root:","+","+```sh","+cargo build -p turbopack-cli","+./target/debug/turbopack-cli build --help","+```","+","+The shell examples below use POSIX syntax. On Windows, the CLI and generated","+executables have an `.exe` suffix.","+","+## JavaScript and TypeScript","+","+```sh","+./target/debug/turbopack-cli build src/index.ts --dir path/to/project","+./target/debug/turbopack-cli build src/index.ts --dir path/to/project --target browser","+./target/debug/turbopack-cli dev src/index.ts --dir path/to/project","+```","+","+Entrypoints resolve relative to `--dir`, which defaults to the current directory.","+Builds emit into `dist`. `dev` serves the application and rebuilds when its","+dependencies change. See `dev --help` for its options.","+","+## Go quickstart","+","+Install Go 1.24 or newer and put `go` on `PATH`, or select an installation with","+`--go`. Save this as `main.go` in `path/to/go-project`:","+","+```go","+package main","+","+import \"fmt\"","+","+func main() {","+\tfmt.Println(\"Hello, Go!\")","+}","+```","+","+From the repository root, build and run it:","+","+```sh","+./target/debug/turbopack-cli build main.go --dir path/to/go-project","+./path/to/go-project/dist/main","+```","+","+The executable prints `Hello, Go!`. This example uses only the standard library,","+so it does not need a `go.mod` file.","+","+If `main.go` calls functions defined in `helper.go`, name both files:","+","+```sh","+./target/debug/turbopack-cli build main.go helper.go --dir path/to/go-project","+```","+","+All named Go entry files must have the same parent directory and form `package main`","+with a `main` function. That source directory can be the module root or a subdirectory","+such as `cmd/server`. Unlisted sibling files are excluded. Explicitly named entries are","+compiled regardless of their filename platform suffixes or `//go:build` tags;","+imported packages use Go's normal host-platform and build-tag selection. Filenames","+have no special application conventions.","+","+### Options and paths","+","+| Option    | Behavior and default                                                                               |","+| --------- | -------------------------------------------------------------------------------------------------- |","+| `--dir`   | Directory used to resolve input filenames; defaults to the current directory.                      |","+| `--root`  | Optional containment check for the module or standalone source directory.                          |","+| `--go`    | Go executable, resolved from `PATH` or a path relative to the current directory; defaults to `go`. |","+| `--tags`  | Build tags passed to Go discovery and compilation; defaults to no additional tags.                 |","+| `--watch` | Rebuild after input changes with `build`; `dev` watches automatically.                             |","+","+Absolute input filenames also work. The nearest ancestor `go.mod` identifies the","+module; without one, the existing source directory is used. For `main.go helper.go`,","+the output is `dist/main` under `--dir` (`dist/main.exe` on Windows). The first Go","+input determines the executable name, even when JavaScript entries appear first.","+Go executables use the same asset writer as JavaScript outputs.","+","+For example, compile TypeScript and Go together, enabling a Go build tag in","+imported packages:","+","+```sh","+./target/debug/turbopack-cli build src/index.ts main.go \\","+  --dir path/to/project --tags special","+```","+","+Keep Go sources and embedded assets outside `dist`. Go output paths must not","+overlap tracked inputs or embed patterns. Go's build cache must be outside both the","+source project and module cache, and cannot contain either tree.","+","+### Module dependencies and environment","+","+Versioned dependencies that do not require CGO must already be in `GOMODCACHE`. Builds disable","+downloads and use `-mod=readonly`; missing dependencies or checksums produce","+Go diagnostics without modifying `go.mod` or `go.sum`.","+","+The CLI tracks the resolved module cache as a separate filesystem root. Watch mode","+observes both roots, so preparing a missing dependency can repair a running watch","+session. This root is configured automatically and does not need to be inside","+`--root`, which checks the source module or standalone source directory.","+","+The CLI ignores Go environment files (`GOENV=off`), including settings written by","+`go env -w`. It resolves cache paths from the process environment or the selected","+toolchain's defaults. To use a custom module cache, export `GOMODCACHE` before both","+preparing dependencies and running the CLI. `GOCACHE` selects the build cache.","+","+Prepare dependencies with the same Go installation you select with `--go` (or","+`go` from `PATH`). These POSIX commands use `go` from `PATH` and disable Go","+configuration that the CLI does not use:","+","+```sh","+cd path/to/go-project","+export GOENV=off GOTOOLCHAIN=local GOWORK=off CGO_ENABLED=0 GOFLAGS=","+go mod tidy","+go mod download","+/path/to/turbopack-cli build main.go helper.go","+```","+","+Preparation can download dependencies and update module metadata. The CLI only","+reads the resulting module configuration and cache. Its Go installation and","+resolved environment must stay unchanged during a build or watch session.","+","+### Watching","+","+```sh","+./target/debug/turbopack-cli build main.go helper.go \\","+  --dir path/to/go-project --watch","+./target/debug/turbopack-cli dev main.go helper.go --dir path/to/go-project","+```","+","+`build --watch` and `dev` rebuild after changes to sources, imported packages,","+module metadata and embedded assets. They retain the last successful executable","+when Go compilation fails, and later edits can repair the build. Start and restart","+your native application separately.","+","+Mixed entrypoints also work in both modes:","+","+```sh","+./target/debug/turbopack-cli dev src/index.ts main.go --dir path/to/project","+```","+","+The dev server serves the JavaScript application while the shared compiler emits","+the Go executable into `dist`. Go-only `dev` watches and compiles without starting","+an HTTP server or opening a browser. JavaScript target and optimization options","+control the JavaScript outputs in a mixed build.","+","+Go commands that run for more than 180 seconds print a warning and keep running. A failed single build exits with code 1 and preserves","+an existing output. Ctrl-C and, on Unix, SIGTERM cancel active Go commands and stop","+the watcher.","+","+Go owns dependency discovery and compilation through `go list` and `go build`;","+Turbopack watches the reported inputs. See the [Go crate README](../turbopack-go/README.md)","+for the integration design.","+","+### Persistent caching","+","+Add `--persistent-caching` to `build`, `build --watch`, or `dev` to reuse Go","+compiler results and JavaScript tasks across CLI processes. This works for both","+Go-only and mixed entrypoints. The default task cache is `.turbopack/cache` under","+`--dir`; `--cache-dir` selects another directory.","+","+Each process probes the Go toolchain and re-registers input observations. Unchanged","+compiler inputs restore executable bytes without invoking `go build`; Go source,","+dependency, toolchain and build-option changes invalidate the","+appropriate compiler results. Cancellation handles and watcher leases belong to","+the current process, including after a warm restore. JavaScript compilation keeps","+its own persistent task identity, independent of the Go orchestration state.","+","+Go's build and module caches are separate from the Turbo Tasks cache.","+","+### Current limitations","+","+- Native host executables only, with CGO disabled. Imported packages may contain","+  Go assembly, local assembly headers and system object files; packages requiring CGO","+  are unsupported.","+- Go inputs are filenames, not package paths or patterns. All Go entries in one","+  invocation must have the same parent directory and form one executable.","+- Module replacements (all `replace` directives), project Go workspaces, vendoring,","+  source symlinks and cross-compilation are unsupported. Symlink checks cover files","+  and directory components in consumed inputs.","+","+## Contributor verification","+","+With Go on `PATH`, run from the repository root:","+","+```sh","+cargo test -p turbopack-go -p turbopack-cli","+```","+","+Set `TURBOPACK_GO=/path/to/go/bin/go` to select a test toolchain.","+","+See the [CLI tests](tests/go.rs), [library tests](../turbopack-go/tests/live.rs),","+and the existing [Rust CI workflow](../../../.github/workflows/build_and_test.yml).","+Its workspace test job installs Go and includes both crates. The","+[checked-in Go fixture](../turbopack-go/tests/fixture) is also available for manual","+smoke tests."],"additions":200,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbopack-cli/benches/small_apps.rs","lines":["@@ -65,26 +65,35 @@ fn bench_small_apps(c: &mut Criterion) {","                     let app_name = app.file_name().unwrap().to_string_lossy().to_string();"," ","                     rt.block_on(async move {","-                        turbopack_cli::build::build(&BuildArguments {","-                            common: CommonArguments {","-                                entries: Some(vec![format!(\"{app_name}/index.tsx\")]),","-                                dir: Some(app.clone()),","-                                root: Some(apps_dir),","-                                log_level: None,","-                                show_all: false,","-                                log_detail: false,","-                                full_stats: false,","-                                target: None,","-                     