ude prune for a workspace with a lockfile per project","@@ -249,31 +252,46 @@ pub fn prune_against_project_lockfiles(","         else {","             return Ok(());","         };","-        record_resolved_package_versions(&lockfile, &mut resolved);","+        record_resolved_package_versions(","+            lockfile.snapshots.iter().flat_map(|snapshots| snapshots.keys()),","+            &mut resolved,","+        );","     }","-    prune_unresolved_entries(config, workspace_dir, &resolved)","+    prune_unresolved_entries(config, workspace_dir, resolved)"," }"," "," fn prune_unresolved_entries(","     config: &Config,","     workspace_dir: &Path,","-    resolved: &ResolvedPackageVersions,","+    mut resolved: ResolvedPackageVersions,"," ) -> Result<(), WriteWorkspaceCatalogsError> {","+    if (config.minimum_release_age_exclude_prune || config.trust_policy_exclude_prune)","+        && let Some(mut env) = EnvLockfile::read(config.root_project_manifest_dir(workspace_dir))","+            .map_err(WriteWorkspaceCatalogsError::LoadLockfile)?","+    {","+        env.root_importer_mut().config_dependencies","+            .retain(|name, _| {","+                config.config_dependencies","+                    .as_ref()","+                    .is_some_and(|dependencies| dependencies.contains_key(name))","+            });","+        prune_env_lockfile(&mut env);","+        record_resolved_package_versions(env.snapshots.keys(), &mut resolved);","+    }","     update_workspace_manifest(","         workspace_dir,","         &UpdateWorkspaceManifestOptions {","             prune_minimum_release_age_excludes: config.minimum_release_age_exclude_prune,","             prune_trust_policy_excludes: config.trust_policy_exclude_prune,","             prune_allow_builds: true,","-            resolved_package_versions: Some(resolved),","+            resolved_package_versions: Some(&resolved),","             ..Default::default()","         },","     )","     .map_err(WriteWorkspaceCatalogsError::Write)"," }"," ","-/// Adds every package in the lockfile to `resolved` with its resolved","-/// versions.","+/// Adds each snapshot key to `resolved` with its resolved version."," /// A registry-qualified slot (`<name>@<registryName>:<version>`)"," /// registers the version after the prefix — `PkgVerPeer::version_semver`"," /// treats it as opaque for reuse/preference paths, but here the version","@@ -282,8 +300,11 @@ fn prune_unresolved_entries("," /// `file:`) register only their name: their presence can still be"," /// confirmed (a bare-name exclude entry survives), but no exact version"," /// can (a versioned entry is pruned).","-fn record_resolved_package_versions(lockfile: &Lockfile, resolved: &mut ResolvedPackageVersions) {","-    for key in lockfile.snapshots.iter().flat_map(|snapshots| snapshots.keys()) {","+fn record_resolved_package_versions<'a>(","+    keys: impl IntoIterator<Item = &'a PackageKey>,","+    resolved: &mut ResolvedPackageVersions,","+) {","+    for key in keys {","         let versions = resolved.entry(key.name.to_string()).or_default();","         let version = key.suffix","             .version_semver()"],"additions":32,"deletions":11,"truncated":false},{"path":"pnpm/crates/package-manager/src/catalog_cleanup/tests.rs","lines":["@@ -2,7 +2,7 @@ use super::{","     post_install_prune, prune_against_project_lockfiles, record_resolved_package_versions,"," };"," use pnpm_config::Config;","-use pnpm_lockfile::Lockfile;","+use pnpm_lockfile::{EnvLockfile, Lockfile};"," use pnpm_package_manifest::PackageManifest;"," use pnpm_workspace_manifest_writer::ResolvedPackageVersions;"," use std::path::Path;","@@ -10,7 +10,10 @@ use tempfile::tempdir;"," "," fn resolved_package_versions(lockfile: &Lockfile) -> ResolvedPackageVersions {","     let mut resolved = ResolvedPackageVersions::new();","-    record_resolved_package_versions(lockfile, &mut resolved);","+    record_resolved_package_versions(","+        lockfile.snapshots.iter().flat_map(|snapshots| snapshots.keys()),","+        &mut resolved,","+    );","     resolved"," }"," ","@@ -206,3 +209,103 @@ fn skips_the_pass_when_a_project_has_no_lockfile() {","         workspace_yaml,","     );"," }","+","+#[test]","+fn preserves_config_dependency_excludes_in_all_lockfile_layouts() {","+    for layout in [\"shared\", \"per-project\", \"relocated\"] {","+        let tmp = tempdir().expect(\"temp dir\");","+        let workspace_dir = tmp.path();","+        let mut config = Config::new();","+        config.minimum_release_age_exclude_prune = true;","+        config.trust_policy_exclude_prune = true;","+        config.config_dependencies = Some(","+            serde_json::from_value(serde_json::json!({ \"@example/plugin\": \"2.0.0\" }))","+                .expect(\"parse config dependency declarations\"),","+        );","+        config.shared_workspace_lockfile = layout != \"per-project\";","+        if layout == \"relocated\" {","+            config.lockfile_dir = Some(workspace_dir.join(\"locks\"));","+        }","+        let lockfile_dir = config.lockfile_dir_for(workspace_dir);","+        std::fs::create_dir_all(lockfile_dir).expect(\"create lockfile directory\");","+        std::fs::write(workspace_dir.join(\"package.json\"), r#\"{\"name\":\"root\"}\"#)","+            .expect(\"write manifest\");","+        std::fs::write(","+            workspace_dir.join(\"pnpm-workspace.yaml\"),","+            \"packages: ['.']\\n\\","+             minimumReleaseAgeExclude:\\n  \\","+             - '@example/plugin'\\n  \\","+             - 'foo@1.0.0 || 2.0.0 || 3.0.0'\\n  \\","+             - unused-plugin\\n\\","+             trustPolicyExclude:\\n  \\","+             - '@example/plugin@1.0.0 || 2.0.0'\\n  \\","+             - foo\\n  \\","+             - unused-plugin\\n\",","+        )","+        .expect(\"write workspace settings\");","+        std::fs::write(","+            lockfile_dir.join(\"pnpm-lock.yaml\"),","+            \"lockfileVersion: '9.0'\\nsnapshots:\\n  foo@1.0.0: {}\\n\",","+        )","+        .expect(\"write main lockfile\");","+        let mut env = EnvLockfile::create();","+        env.root_importer_mut().config_dependencies = serde_json::from_value(serde_json::json!({","+            \"@example/plugin\": { \"specifier\": \"2.0.0\", \"version\": \"2.0.0\" },","+            \"unused-plugin\": { \"specifier\": \"1.0.0\", \"version\": \"1.0.0\" },","+        }))","+        .expect(\"parse config dependency resolutions\");","+        env.snapshots = serde_saphyr::from_str(\"'@example/plugin@2.0.0':\\n  dependencies:\\n    foo: 2.0.0\\nfoo@2.0.0: {}\\nunused-plugin@1.0.0: {}\\n\")","+            .expect(\"parse env snapshots\");","+        env.write(lockfile_dir).expect(\"write env lockfile\");","+        let manifest =","+            PackageManifest::from_path(workspace_dir.join(\"package.json\")).expect(\"read manifest\");","+","+        if layout == \"per-project\" {","+            prune_against_project_lockfiles(&config, workspace_dir).expect(\"cleanup runs\");","+        } else {","+            post_install_prune(&config, Some(workspace_dir), &manifest).expect(\"cleanup runs\");","+        }","+","+        let yaml = std::fs::read_to_string(workspace_dir.join(\"pnpm-workspace.yaml\"))","+            .expect(\"read workspace settings\");","+        let settings: pnpm_config::WorkspaceSettings =","+            serde_saphyr::from_str(&yaml).expect(\"parse workspace settings\");","+        assert_eq!(","+            settings.minimum_release_age_exclude,","+            Some(vec![\"@example/plugin\".into(), \"foo@1.0.0 || 2.0.0\".into()]),","+            \"{layout}\",","+        );","+        assert_eq!(","+            settings.trust_policy_exclude,","+            Some(vec![\"@example/plugin@2.0.0\".into(), \"foo\".into()]),","+            \"{layout}\",","+        );","+    }","+}","+","+#[test]","+fn skips_malformed_env_documents_without_exclusion_pruning() {","+    let tmp = tempdir().expect(\"temp dir\");","+    let workspace_dir = tmp.path();","+    std::fs::write(","+        workspace_dir.join(\"pnpm-workspace.yaml\"),","+        \"allowBuilds:\\n  foo: set this to true or false\\n  stale: set this to true or false\\n\",","+    )","+    .expect(\"write workspace settings\");","+    std::fs::write(","+        workspace_dir.join(\"pnpm-lock.yaml\"),","+        \"---\\ninvalid: [\\n---\\nlockfileVersion: '9.0'\\nsnapshots:\\n  foo@1.0.0: {}\\n\",","+    )","+    .expect(\"write lockfile\");","+    let manifest = PackageManifest::from_value(","+        workspace_dir.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"project\" }),","+    );","+","+    post_install_prune(&Config::new(), Some(workspace_dir), &manifest).expect(\"cleanup runs\");","+","+    let yaml = std::fs::read_to_string(workspace_dir.join(\"pnpm-workspace.yaml\"))","+        .expect(\"read workspace settings\");","+    assert!(yaml.contains(\"foo:\"), \"a resolved build placeholder survives\");","+    assert!(!yaml.contains(\"stale:\"), \"an unused build placeholder is pruned\");","+}"],"additions":105,"deletions":2,"truncated":false},{"path":"pnpm/docs/settings/dependency-resolution.md","lines":["@@ -365,7 +365,7 @@ Added in: v11.22.0"," * Default: **false**"," * Type: **Boolean**"," ","-When set to `true`, `pnpm install`, `pnpm add`, `pnpm update`, `pnpm remove`, and `pnpm dedupe` prune the entries of [`minimumReleaseAgeExclude`](#minimumreleaseageexclude) in `pnpm-workspace.yaml` that the freshly written lockfile no longer resolves: a version that is gone is dropped (an entry is removed once none of its versions remain), and an entry for a package that is no longer in the lockfile is removed too. Name patterns (`@myorg/*`) are always kept.","+When set to `true`, `pnpm install`, `pnpm add`, `pnpm update`, `pnpm remove`, and `pnpm dedupe` prune the entries of [`minimumReleaseAgeExclude`](#minimumreleaseageexclude) in `pnpm-workspace.yaml` that the freshly written lockfile no longer resolves: a version that is gone is dropped (an entry is removed once none of its versions remain), and an entry for a package that is no longer in the lockfile is removed too. Name patterns (`@myorg/*`) are always kept. Pruning also checks resolved configuration dependencies and their transitive dependencies."," "," The cleanup is skipped when the install's lockfile does not cover the whole workspace ([`sharedWorkspaceLockfile: false`](../workspaces.md#sharedworkspacelockfile)), since entries another project still needs would look stale. Comments on the entries that are kept survive the rewrite."," ","@@ -447,7 +447,7 @@ Added in: v12.4.0"," * Default: **false**"," * Type: **Boolean**"," ","-When set to `true`, `pnpm install`, `pnpm add`, `pnpm update`, `pnpm remove`, and `pnpm dedupe` prune the entries of [`trustPolicyExclude`](#trustpolicyexclude) in `pnpm-workspace.yaml` that the freshly written lockfile no longer resolves: a version that is gone is dropped (an entry is removed once none of its versions remain), and an entry for a package that is no longer in the lockfile is removed too. Name patterns (`@myorg/*`) are always kept.","+When set to `true`, `pnpm install`, `pnpm add`, `pnpm update`, `pnpm remove`, and `pnpm dedupe` prune the entries of [`trustPolicyExclude`](#trustpolicyexclude) in `pnpm-workspace.yaml` that the freshly written lockfile no longer resolves: a version that is gone is dropped (an entry is removed once none of its versions remain), and an entry for a package that is no longer in the lockfile is removed too. Name patterns (`@myorg/*`) are always kept. Pruning also checks resolved configuration dependencies and their transitive dependencies."," "," The cleanup is skipped when the install's lockfile does not cover the whole workspace ([`sharedWorkspaceLockfile: false`](../workspaces.md#sharedworkspacelockfile)), since entries another project still needs would look stale. Comments on the entries that are kept survive the rewrite."," "],"addit