id()) {","-\t\t// we can write the current pointer as-is","+\tif (!oldest_uncheckpointed_delete_commit.IsValid() ||","+\t    oldest_uncheckpointed_delete_commit.GetIndex() >= options.visibility_bound) {","+\t\t// nothing below the bound changed since the last checkpoint: the blocks on disk are current. A delete that","+\t\t// committed above the bound, while this checkpoint ran, is written by the next checkpoint"," \t\t// ensure the blocks we are pointing to are not marked as free"," \t\tmanager.ClearModifiedBlocks(storage_pointers);"," \t\t// return the current set of pointers","@@ -279,10 +284,12 @@ vector<MetaBlockPointer> RowVersionManager::Checkpoint(RowGroupWriter &writer) {"," \t\tmetadata_writer.Flush();"," \t}"," ","-\tif (uncheckpointed_delete_commit.IsValid() && uncheckpointed_delete_commit.GetIndex() < options.visibility_bound) {","+\tif (newest_uncheckpointed_delete_commit.IsValid() &&","+\t    newest_uncheckpointed_delete_commit.GetIndex() < options.visibility_bound) {"," \t\t// the last checkpointed id was either before or on the transaction we are checkpointing"," \t\t// nothing to checkpoint in future commits until more deletes appear","-\t\tuncheckpointed_delete_commit = optional_idx();","+\t\tnewest_uncheckpointed_delete_commit = optional_idx();","+\t\toldest_uncheckpointed_delete_commit = optional_idx();"," \t}"," \treturn storage_pointers;"," }","@@ -313,13 +320,14 @@ shared_ptr<RowVersionManager> RowVersionManager::Deserialize(MetaBlockPointer de"," \t\t}"," \t\tversion_info->vector_info[vector_index] = std::move(info);"," \t}","-\tversion_info->uncheckpointed_delete_commit = optional_idx();","+\tversion_info->newest_uncheckpointed_delete_commit = optional_idx();","+\tversion_info->oldest_uncheckpointed_delete_commit = optional_idx();"," \treturn version_info;"," }"," ","-bool RowVersionManager::HasUnserializedChanges() {","+bool RowVersionManager::HasUnserializedChanges(VisibilityBound bound) {"," \tlock_guard<mutex> lock(version_lock);","-\treturn uncheckpointed_delete_commit.IsValid();","+\treturn oldest_uncheckpointed_delete_commit.IsValid() && oldest_uncheckpointed_delete_commit.GetIndex() < bound;"," }"," "," bool RowVersionManager::HasDeletes() {","@@ -344,7 +352,7 @@ bool RowVersionManager::HasUncommittedChanges() {"," "," vector<MetaBlockPointer> RowVersionManager::GetStoragePointers() {"," \tlock_guard<mutex> lock(version_lock);","-\tD_ASSERT(!uncheckpointed_delete_commit.IsValid());","+\tD_ASSERT(!newest_uncheckpointed_delete_commit.IsValid());"," \treturn storage_pointers;"," }"," "],"additions":18,"deletions":10,"truncated":false},{"path":"test/sql/storage/concurrent_checkpoint_delete_before_and_during.test_slow","lines":["@@ -0,0 +1,110 @@","+# name: test/sql/storage/concurrent_checkpoint_delete_before_and_during.test_slow","+# description: A checkpoint writes a delete that committed before it started even when another delete commits while it runs","+# group: [storage]","+","+statement ok","+SET checkpoint_threshold='1TB'","+","+statement ok","+PRAGMA disable_checkpoint_on_shutdown","+","+statement ok","+ATTACH '{TEST_DIR}/delete_before_and_during.db' AS db (BLOCK_SIZE 16384, ROW_GROUP_SIZE 1048576)","+","+statement ok","+CREATE TABLE db.test AS SELECT i, 'str' || i AS s FROM range(400000) t(i)","+","+statement ok","+CREATE SEQUENCE db.marker","+","+statement ok","+CHECKPOINT db","+","+statement ok","+DELETE FROM db.test WHERE i % 2 = 0","+","+statement ok","+CHECKPOINT db","+","+statement ok","+DETACH db","+","+statement ok","+ATTACH '{TEST_DIR}/delete_before_and_during.db' AS db","+","+# a delete that commits before the checkpoint: it lies below the checkpoint's bound, and its WAL is truncated by the","+# checkpoint, so the checkpoint has to write it","+statement ok","+DELETE FROM db.test WHERE i % 8 = 3","+","+query I","+SELECT COUNT(*) FROM db.test","+----","+150000","+","+# the checkpoint pauses for four seconds after it looked at the row groups, before it writes the table","+statement ok","+SET debug_checkpoint_scan_sleep_ms=4000","+","+concurrentloop threadid 0 2","+","+# a second delete on the same row group commits during the pause: it lies above the bound and is written by the next","+# checkpoint; it must not make this checkpoint skip the first delete","+onlyif threadid=1","+statement ok","+BEGIN TRANSACTION","+","+onlyif threadid=1","+query I","+SELECT COUNT(*) FROM db.test","+----","+150000","+","+onlyif threadid=1","+statement ok","+DELETE FROM db.test WHERE i % 8 = 7","+","+sleep 1000 millisecond","+","+# a commit after the transaction's snapshot, so that the checkpoint is concurrent instead of waiting for the","+# transaction; it writes no table","+onlyif threadid=0","+statement ok","+SELECT nextval('db.marker')","+","+onlyif threadid=0","+statement ok","+CHECKPOINT db","+","+sleep 2000 millisecond","+","+onlyif threadid=1","+statement ok","+COMMIT","+","+endloop","+","+statement ok","+SET debug_checkpoint_scan_sleep_ms=0","+","+query I","+SELECT COUNT(*) FROM db.test","+----","+100000","+","+# reopen without a checkpoint: the first delete has to come from the checkpoint, the second is replayed from the WAL","+statement ok","+DETACH db","+","+statement ok","+ATTACH '{TEST_DIR}/delete_before_and_during.db' AS db","+","+query I","+SELECT COUNT(*) FROM db.test","+----","+100000","+","+query I","+SELECT COUNT(*) FROM db.test WHERE i % 8 = 3 OR i % 8 = 7","+----","+0"],"additions":110,"deletions":0,"truncated":false},{"path":"test/sql/storage/concurrent_checkpoint_unchanged_table_delete_blocks.test_slow","lines":["@@ -0,0 +1,116 @@","+# name: test/sql/storage/concurrent_checkpoint_unchanged_table_delete_blocks.test_slow","+# description: A delete committed while a checkpoint reuses its table's metadata keeps the persisted delete blocks","+# group: [storage]","+","+statement ok","+SET checkpoint_threshold='1TB'","+","+statement ok","+PRAGMA disable_checkpoint_on_shutdown","+","+# small blocks and one large row group: the persisted deletes below span several metadata blocks that hold","+# nothing else","+statement ok","+ATTACH '{TEST_DIR}/unchanged_table_delete_blocks.db' AS db (BLOCK_SIZE 16384, ROW_GROUP_SIZE 1048576)","+","+statement ok","+CREATE TABLE db.test AS SELECT i, 'str' || i AS s FROM range(400000) t(i)","+","+statement ok","+CREATE SEQUENCE db.marker","+","+statement ok","+CHECKPOINT db","+","+# half of every vector deleted, persisted by this checkpoint as full bitmasks","+statement ok","+DELETE FROM db.test WHERE i % 2 = 0","+","+statement ok","+CHECKPOINT db","+","+query I","+SELECT COUNT(*) FROM db.test","+----","+200000","+","+# reload the table: a row group rewritten by a checkpoint counts as changed until it is read from disk again","+statement ok","+DETACH db","+","+statement ok","+ATTACH '{TEST_DIR}/unchanged_table_delete_blocks.db' AS db","+","+# the checkpoint pauses for four seconds after it found the table unchanged, before it finishes","+statement ok","+SET debug_checkpoint_scan_sleep_ms=4000","+","+concurrentloop threadid 0 2","+","+# a delete that commits during the pause: it lies above the checkpoint's bound and must not touch the persisted blocks","+onlyif threadid=1","+statement ok","+BEGIN TRANSACTION","+","+onlyif threadid=1","+query I","+SELECT COUNT(*) FROM db.test","+----","+200000","+","+onlyif threadid=1","+statement ok","+DELETE FROM db.test WHERE i % 4 = 1","+","+sleep 1000 millisecond","+","+# a commit after the transaction's snapshot, so that the checkpoint is concurrent instead of waiting for the","+# transaction; it writes no table, so that the checkpoint pauses only for the table under test","+onlyif threadid=0","+statement ok","+SELECT nextval('db.marker')","+","+onlyif threadid=0","+statement ok","+CHECKPOINT db","+","+sleep 2000 millisecond","+","+onlyif threadid=1","+statement ok","+COMMIT","+","+endloop","+","+statement ok","+SET debug_checkpoint_scan_sleep_ms=0","+","+query I","+SELECT COUNT(*) FROM db.test","+----","+100000","+","+# an append of two full row groups, written to free blocks before the commit: a delete block the checkpoint freed while","+# the reused metadata still referenced it is overwritten here","+statement ok","+CREATE TABLE db.filler (i BIGINT, j BIGINT)","+","+statement ok","+INSERT INTO db.filler SELECT range, range FROM range(2100000)","+","+# reopen without a checkpoint: replaying the delete loads the persisted deletes","+statement ok","+DETACH db","+","+statement ok","+ATTACH '{TEST_DIR}/unchanged_table_delete_blocks.db' AS db","+","+query I","+SELECT COUNT(*) FROM db.test","+----","+100000","+","+query I","+SELECT COUNT(*) FROM db.filler","+----","+2100000",""],"additions":116,"deletions":0,"truncated":false}],"additions":280,"deletions":17,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-09-22T12:51:48.552487+00:00"}