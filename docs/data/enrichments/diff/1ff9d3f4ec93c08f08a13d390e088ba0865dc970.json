ackageKey)]) {","+        if aliases.is_empty() {","+            return;","+        }","+        let mut locations_by_key: HashMap<PackageKey, Vec<PathBuf>> = HashMap::new();","+        for (alias, key) in aliases {","+            locations_by_key","+                .entry(key.clone())","+                .or_default()","+                .push(pnpm_fs::join_slash_separated_path(&directory, alias));","+        }","+        *self.private_hoist.lock().unwrap_or_else(std::sync::PoisonError::into_inner) =","+            Some(PrivateHoistedBins { directory, locations_by_key });","+    }","+","+    pub(crate) fn initialize_private_hoist_for(","+        &self,","+        key: &PackageKey,","+    ) -> Result<(), LinkBinsError> {","+        let directory = {","+            let guard =","+                self.private_hoist.lock().unwrap_or_else(std::sync::PoisonError::into_inner);","+            let Some(private_hoist) = guard.as_ref() else { return Ok(()) };","+            if !private_hoist.locations_by_key.contains_key(key) {","+                return Ok(());","+            }","+            private_hoist.directory.clone()","+        };","+        let entry = self.directory(&directory);","+        let mut entry = entry.lock().unwrap_or_else(std::sync::PoisonError::into_inner);","+        entry.initialize(&directory)","+    }","+","+    pub(crate) fn refresh_private_hoist_for(","+        &self,","+        key: &PackageKey,","+        base_options: &LinkBinsOptions,","+    ) -> Result<(), LinkBinsError> {","+        let (directory, locations) = {","+            let guard =","+                self.private_hoist.lock().unwrap_or_else(std::sync::PoisonError::into_inner);","+            let Some(private_hoist) = guard.as_ref() else { return Ok(()) };","+            let Some(locations) = private_hoist.locations_by_key.get(key) else {","+                return Ok(());","+            };","+            (","+                private_hoist.directory.clone(),","+                locations","+                    .iter()","+                    .cloned()","+                    .collect::<HashSet<PathBuf>>(),","+            )","+        };","+        let entry = self.directory(&directory);","+        let mut entry = entry.lock().unwrap_or_else(std::sync::PoisonError::into_inner);","+        if entry.completed.contains(key) {","+            return Ok(());","+        }","+        entry.initialize(&directory)?;","+        let mut options = base_options.clone();","+        options.force = true;","+        let plan = entry.plan.as_mut().expect(\"private hoist bin plan initialized\");","+        plan.refresh::<Host>(&locations, &directory.join(\".bin\"), &options)?;","+        entry.completed.insert(key.clone());","+        Ok(())","+    }","+","+    pub(crate) fn refresh_private_hoist(","+        &self,","+        mutated: &HashSet<PackageKey>,","+        base_options: &LinkBinsOptions,","+    ) -> Result<(), LinkBinsError> {","+        let Some(MutatedPrivateHoist {","+            directory,","+            completed,","+            locations_by_key,","+        }) = self.collect_mutated_private_hoist(mutated)","+        else {","+            return Ok(());","+        };","+        let entry = self.directory(&directory);","+        let mut entry = entry.lock().unwrap_or_else(std::sync::PoisonError::into_inner);","+        if completed.is_subset(&entry.completed) {","+            return Ok(());","+        }","+        entry.initialize(&directory)?;","+        let pending: HashSet<PackageKey> = completed","+            .difference(&entry.completed)","+            .cloned()","+            .collect();","+        let locations: HashSet<PathBuf> = pending","+            .iter()","+            .filter_map(|key| locations_by_key.get(key))","+            .flatten()","+            .cloned()","+            .collect();","+        let mut options = base_options.clone();","+        options.force = true;","+        let plan = entry.plan.as_mut().expect(\"private hoist bin plan