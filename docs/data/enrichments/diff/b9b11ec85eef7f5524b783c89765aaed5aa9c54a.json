{"id":"b9b11ec85eef7f5524b783c89765aaed5aa9c54a","axis":"silent","repo":"envoyproxy/envoy","sha":"b9b11ec85eef7f5524b783c89765aaed5aa9c54a","parsed":{"files":[{"path":"changelogs/current/bug_fixes/udp__send-zero-length-datagrams.rst","lines":["@@ -0,0 +1,5 @@","+Fixed a bug where Envoy silently dropped zero-length UDP datagrams before issuing a socket","+operation. Empty datagrams are now sent through both connected and unconnected UDP sockets while","+preserving their packet boundaries.","+This behavior can be temporarily reverted by setting the runtime guard","+``envoy.reloadable_features.udp_send_zero_length_datagrams`` to ``false``."],"additions":5,"deletions":0,"truncated":false},{"path":"contrib/vcl/source/vcl_io_handle.cc","lines":["@@ -277,6 +277,11 @@ Api::IoCallUint64Result VclIoHandle::write(Buffer::Instance& buffer) {","   return result;"," }"," ","+Api::IoCallUint64Result VclIoHandle::send(const void* buffer, size_t length) {","+  Buffer::RawSlice slice{const_cast<void*>(buffer), length};","+  return writev(&slice, 1);","+}","+"," Api::IoCallUint64Result VclIoHandle::recv(void* buffer, size_t length, int flags) {","   VCL_LOG(\"recv on sh {:x}\", sh_);","   int rv = vppcom_session_recvfrom(sh_, buffer, length, flags, nullptr);","@@ -303,7 +308,8 @@ Api::IoCallUint64Result VclIoHandle::sendmsg(const Buffer::RawSlice* slices, uin","     }","   }","   if (num_slices_to_write == 0) {","-    return Api::ioCallUint64ResultNoError();","+    uint8_t empty_payload = 0;","+    return vclCallResultToIoCallResult(vppcom_session_write_msg(sh_, &empty_payload, /*n=*/0));","   }"," ","   // VCL has no sendmsg semantics- Treat as a session write followed by a flush"],"additions":7,"deletions":1,"truncated":false},{"path":"contrib/vcl/source/vcl_io_handle.h","lines":["@@ -39,6 +39,7 @@ class VclIoHandle : public Envoy::Network::IoHandle,","                                std::optional<uint64_t> max_length) override;","   Api::IoCallUint64Result writev(const Buffer::RawS