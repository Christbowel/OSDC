"+ */","+","+package org.springframework.integration.jms.inbound;","+","+import jakarta.jms.Message;","+import org.junit.jupiter.api.Test;","+","+import org.springframework.integration.jms.StubTextMessage;","+import org.springframework.jms.core.JmsTemplate;","+import org.springframework.jms.support.converter.MessageConversionException;","+import org.springframework.jms.support.converter.MessageConverter;","+import org.springframework.messaging.MessagingException;","+","+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;","+import static org.mockito.ArgumentMatchers.any;","+import static org.mockito.BDDMockito.given;","+import static org.mockito.Mockito.mock;","+","+/**","+ * @author Glenn Renfro","+ *","+ * @since 7.2","+ */","+class JmsDestinationPollingSourceTests {","+","+\t@Test","+\tvoid nullPayloadFromConverterThrowsMessageConversionException() throws Exception {","+\t\tMessage jmsMessage = new StubTextMessage(\"test\");","+","+\t\tMessageConverter converter = mock();","+","+\t\tJmsTemplate jmsTemplate = mock();","+\t\tgiven(jmsTemplate.getMessageConverter()).willReturn(converter);","+\t\tgiven(jmsTemplate.receiveSelected(any())).willReturn(jmsMessage);","+","+\t\tJmsDestinationPollingSource source = new JmsDestinationPollingSource(jmsTemplate);","+","+\t\tassertThatExceptionOfType(MessagingException.class)","+\t\t\t\t.isThrownBy(source::receive)","+\t\t\t\t.withCauseInstanceOf(MessageConversionException.class);","+\t}","+","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"spring-integration-jms/src/test/java/org/springframework/integration/jms/outbound/JmsOutboundGatewayTests.java","lines":["@@ -38,6 +38,7 @@"," import org.springframework.integration.channel.QueueChannel;"," import org.springframework.integration.expression.ValueExpression;"," import org.springframework.integration.jms.ActiveMQMultiContextTests;","+import org.springframework.integration.jms.StubConnection;"," import org.springframework.integration.jms.outbound.JmsOutboundGateway.ReplyContainerProperties;"," import org.springframework.integration.test.support.TestApplicationContextAware;"," import org.springframework.integration.test.util.TestUtils;","@@ -46,11 +47,15 @@"," import org.springframework.jms.connection.CachingConnectionFactory;"," import org.springframework.jms.core.JmsTemplate;"," import org.springframework.jms.core.MessageCreator;","+import org.springframework.jms.support.converter.MessageConversionException;","+import org.springframework.jms.support.converter.MessageConverter;","+import org.springframework.messaging.MessageHandlingException;"," import org.springframework.messaging.support.GenericMessage;"," import org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler;"," import org.springframework.util.ObjectUtils;"," "," import static org.assertj.core.api.Assertions.assertThat;","+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;"," import static org.mockito.ArgumentMatchers.any;"," import static org.mockito.ArgumentMatchers.anyLong;"," import static org.mockito.ArgumentMatchers.isNull;","@@ -155,6 +160,28 @@ public void testReplyContainerRecovery() throws Exception {"," \t\t}"," \t}"," ","+\t@Test","+\tpublic void nullPayloadFromConverterThrowsMessageConversionException() throws Exception {","+\t\tJmsOutboundGateway gateway = new JmsOutboundGateway();","+\t\tConnectionFactory connectionFactory = mock();","+\t\tgateway.setConnectionFactory(connectionFactory);","+\t\tgateway.setRequestDestinationName(\"testDestination\");","+\t\tgateway.setReplyDestinationName(\"testReplyDestination\");","+\t\tgateway.setCorrelationKey(\"JMSCorrelationID\");","+\t\tMessageConverter messageConverter = mock();","+\t\twhen(messageConverter.toMessage(any(), any())).thenReturn(mock());","+\t\tgateway.setMessageConverter(messageConverter);","+\t\tgateway.setBeanFactory(mock());","+","+\t\tConnection connection = new StubConnection(\"reply\");","+\t\twhen(connectionFactory.createConnection()).thenReturn(connection);","+","+\t\t// A JMS reply converted to a null payload is a conversion failure, not a discarded reply.","+\t\tassertThatExceptionOfType(MessageHandlingException.class)","+\t\t\t\t.isThrownBy(() -> gateway.handleMessage(new GenericMessage<>(\"test request\")))","+\t\t\t\t.withRootCauseInstanceOf(MessageConversionException.class);","+\t}","+"," \t@Test"," \tpublic void testConnectionBreakOnReplyMessageIdCorrelation() {"," \t\tCachingConnectionFactory connectionFactory1 = new CachingConnectionFactory(ActiveMQMultiContextTests.amqFactory);"],"additions":27,"deletions":0,"truncated":false},{"path":"src/reference/antora/modules/ROOT/pages/jms.adoc","lines":["@@ -858,6 +858,10 @@ NOTE: When you provide your own `MessageConverter` instance, it is still wrapped"," This means that the 'extract-request-payload' and 'extract-reply-payload' properties can affect the actual objects passed to your converter."," The `HeaderMappingMessageConverter` itself delegates to a target `MessageConverter` while also mapping the Spring Integration `MessageHeaders` to JMS message properties and back again."," ","+IMPORTANT: If `MessageConverter.fromMessage()` returns `null` (for example, because the JMS `Message` has no payload), Spring Integration treats this as a conversion failure and throws a `MessageConversionException`, rather than silently discarding the message.","+This applies to the inbound channel adapters, the inbound and outbound gateways, and JMS-backed message channels.","+See <<jms-channel>>.","+"," [[jms-channel]]"," == JMS-backed Message Channels"," ","@@ -928,6 +932,8 @@ Use `subscription` to name the subscription."," Starting with version 7.1, the `AbstractJmsChannel` and its implementations use a `DefaultJmsHeaderMapper` internally to map all headers from the message-to-send to JMS message properties; and on consuming side, map all JMS message properties into message headers."," The custom header-mapping and payload conversion logic can be done by the `org.springframework.jms.support.converter.MessagingMessageConverter` injection into the `JmsTemplate` used for `AbstractJmsChannel` instances."," ","+Starting with version 7.2, if the `MessageConverter` returns `null` when converting an incoming JMS `Message`, the `AbstractJmsChannel` implementations treat it as a conversion failure and throw a `MessageConversionException` rather than discarding the message.","+"," [[jms-selectors]]"," == Using JMS Message Selectors"," "],"additions":6,"deletions":0,"truncated":false},{"path":"src/reference/antora/modules/ROOT/pages/whats-new.adoc","lines":["@@ -43,3 +43,11 @@ See xref:jdbc/metadata-store.adoc[] for more information."," "," The `RestTemplate`-based configuration for the HTTP outbound gateway and outbound channel adapter (the `rest-template` attribute, and the respective Java DSL and constructor options) is now deprecated in favor of `RestClient`-based configuration, which also gains new options for configuring error handling."," See the xref:http.adoc[HTTP Support] chapter for more information about these and other changes.","+","+[[x7.2-jms-changes]]","+=== JMS Support Changes","+","+Spring Framework's JMS `MessageConverter` implementations may now return `null` from `fromMessage()` when a JMS `Message` has no payload.","+A `null` payload conversion is treated as a conversion failure, a `MessageConversionException` is then thrown.","+This affects `AbstractJmsChannel`, `JmsDestinationPollingSource`, `ChannelPublishingJmsMessageListener`, and `JmsOutboundGateway`.","+See xref:jms.adoc[JMS Support] for more information.",""],"additions":8,"deletions":0,"truncated":false}],"additions":215,"deletions":16,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-08-27T18:54:08.334925+00:00"}