t bound","+/// by the key is the package's own and is always followed.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+pub enum BoundPeerEdges {","+    Follow,","+    /// Leave them out, so packages reachable only as a peer are not in the","+    /// graph.","+    Skip,"," }"," "," /// Breadth-first walk from `root_ids`, recording every reachable node","@@ -130,25 +143,70 @@ pub fn build_dependency_graph(","             continue;","         }"," ","-        let edges = node_edges(&node_id, opts, &skipped_peer_edges, &publish_dirs);","-        let peers = match &node_id {","-            TreeNodeId::Package(dep_path) => peer_names(opts.lockfile, dep_path),","-            TreeNodeId::Importer(_) => HashSet::new(),","-        };","-","+        let node = graph_node(&node_id, opts, &skipped_peer_edges, &publish_dirs);","         queue.extend(","-            edges","+            node.edges","                 .iter()","                 .filter_map(|edge| edge.target.as_ref())","                 .filter(|target| !visited.contains(*target))","                 .cloned(),","         );","-        graph.nodes.insert(node_id, GraphNode { edges, peers });","+        graph.nodes.insert(node_id, node);","     }"," ","     graph"," }"," ","+fn graph_node(","+    node_id: &TreeNodeId,","+    opts: &BuildGraphOptions<'_>,","+    skipped_peer_edges: &PeerSatisfactionEdges,","+    publish_dirs: &HashMap<String, String>,","+) -> GraphNode {","+    let mut edges = node_edges(node_id, opts, skipped_peer_edges, publish_dirs);","+    let peers = match node_id {","+        TreeNodeId::Package(dep_path) => peer_names(opts.lockfile, dep_path),","+        TreeNodeId::Importer(_) => HashSet::new(),","+    };","+    match opts.bound_peer_edges {","+        BoundPeerEdges::Follow => {}","+        BoundPeerEdges::Skip => {","+            if let TreeNodeId::Package(dep_path) = node_id {","+                drop_bound_peer_edges(&mut edges, dep_path, &peers, opts.lockfile);","+            }","+        }","+    }","+    GraphNode { edges, peers }","+}","+","+/// A key without a peer suffix binds nothing, so every dependency of that","+/// package is its own, even one whose name it also declares as a peer.","+fn drop_bound_peer_edges(","+    edges: &mut Vec<GraphEdge>,","+    dep_path: &PkgNameVerPeer,","+    peers: &HashSet<String>,","+    lockfile: &Lockfile,","+) {","+    if peers.is_empty() || dep_path.suffix.peer().is_empty() {","+        return;","+    }","+    let providers = BoundProviders::of_snapshot(lockfile.into(), dep_path);","+    edges.retain(|edge| !is_bound_peer_edge(edge, peers, &providers));","+}","+","+/// An edge without a virtual-store target counts as bound when its alias is a","+/// declared peer, since there is no key to check the bindings against.","+fn is_bound_peer_edge(","+    edge: &GraphEdge,","+    peers: &HashSet<String>,","+    providers: &BoundProviders,","+) -> bool {","+    peers.contains(&edge.alias)","+        && edge.dep_path","+            .as_ref()","+            .is_none_or(|target| providers.binds(target))","+}","+"," /// The outgoing edges of one node. A node the lockfile does not describe has"," /// none."," fn node_edges(","@@ -333,3 +391,6 @@ pub fn normalize_importer_path(base: &str, relative: &str) -> Option<String> {","     }","     if parts.is_empty() { Some(\".\".to_string()) } else { Some(parts.join(\"/\")) }"," }","+","+#[cfg(test)]","+mod tests;"],"additions":69,"deletions":8,"truncated":false},{"path":"pnpm/crates/deps-inspection/src/graph/tests.rs","lines":["@@ -0,0 +1,223 @@","+use std::{","+    collections::BTreeSet,","+    fmt::Write,","+};","+","+use pnpm_lockfile::{","+    Lockfile,","+    PeerEdgeOptions,","+};","+use pnpm_modules_yaml::IncludedDependencies;","+use pretty_assertions::assert_eq;","+","+use super::{","+    BoundPeerEdges,","+    BuildGraphOptions,","+    build_dependency_graph,","+};","+use crate::TreeNodeId;","+","+/// `parent` declares `peer` as a peer dependency, and `peer` has a regular","+/// dependency of its own. `root_dependencies` lists what the root project","+/// depends on directly.","+fn load_peer_lockfile(dir: &std::path::Path, root_dependencies: &[&str]) -> Lockfile {","+    let mut yaml =","+        String::from(\"lockfileVersion: '9.0'\\n\\nimporters:\\n\\n  .:\\n    dependencies:\\n\");","+    for name in root_dependencies {","+        let version = if *name == \"parent\" { \"1.0.0(peer@1.0.0)\" } else { \"1.0.0\" };","+        writeln!(yaml, \"      {name}:\\n        specifier: 1.0.0\\n        version: {version}\")","+            .unwrap();","+    }","+    yaml.push_str(","+        \"","+packages:","+","+  parent@1.0.0:","+    resolution: {integrity: sha512-parent}","+    peerDependencies:","+      peer: ^1.0.0","+","+  peer@1.0.0:","+    resolution: {integrity: sha512-peer}","+","+  peer-dep@1.0.0:","+    resolution: {integrity: sha512-peer-dep}","+","+snapshots:","+","+  parent@1.0.0(peer@1.0.0):","+    dependencies:","+      peer: 1.0.0","+","+  peer@1.0.0:","+    dependencies:","+      peer-dep: 1.0.0","+","+  peer-dep@1.0.0: {}","+\",","+    );","+    std::fs::write(dir.join(\"pnpm-lock.yaml\"), yaml).unwrap();","+    Lockfile::load_wanted_from_dir(dir).unwrap().unwrap()","+}","+","+fn package_nodes(lockfile: &Lockfile, bound_peer_edges: BoundPeerEdges) -> BTreeSet<String> {","+    let graph = build_dependency_graph(","+        &[TreeNodeId::Importer(\".\".to_string())],","+        &BuildGraphOptions {","+            lockfile,","+            include: IncludedDependencies {","+                dependencies: true,","+                dev_dependencies: true,","+                optional_dependencies: true,","+            },","+            only_projects: false,","+            peer_edges: PeerEdgeOptions::default(),","+            bound_peer_edges,","+        },","+    );","+    graph.nodes","+        .keys()","+        .filter_map(|node_id| match node_id {","+            TreeNodeId::Package(dep_path) => Some(dep_path.to_string()),","+            TreeNodeId::Importer(_) => None,","+        })","+        .collect()","+}","+","+#[test]","+fn skipping_bound_peer_edges_leaves_out_packages_reached_only_as_a_peer() {","+    let dir = tempfile::tempdir().unwrap();","+    let lockfile = load_peer_lockfile(dir.path(), &[\"parent\"]);","+","+    let followed = package_nodes(&lockfile, BoundPeerEdges::Follow);","+    let skipped = package_nodes(&lockfile, BoundPeerEdges::Skip);","+    dbg!(&followed, &skipped);","+    assert_eq!(","+        followed,","+        BTreeSet::from([","+            \"parent@1.0.0(peer@1.0.0)\".to_string(),","+            \"peer@1.0.0\".to_string(),","+            \"peer-dep@1.0.0\".to_string(),","+        ]),","+    );","+    assert_eq!(skipped, BTreeSet::from([\"parent@1.0.0(peer@1.0.0)\".to_string()]));","+}","+","+#[test]","+fn skipping_bound_peer_edges_keeps_packages_that_are_also_reached_directly() {","+    let dir = tempfile::tempdir().unwrap();","+    let lockfile = load_peer_lockfile(dir.path(), &[\"parent\", \"peer\"]);","+","+    let skipped = package_nodes(&lockfile, BoundPeerEdges::Skip);","+    dbg!(&skipped);","+    assert_eq!(","+        skipped,","+        BTreeSet::from([","+            \"parent@1.0.0(peer@1.0.0)\".to_string(),","+            \"peer@1.0.0\".to_string(),","+            \"peer-dep@1.0.0\".to_string(),","+        ]),","+    );","+}","+","+/// `wrapper` declares `mid` in both `dependencies` and `peerDependencies`,","+/// and its key carries no `(mid@1.0.0)` binding, so `mid` is its own","+/// dependency rather than a resolved peer.","+#[test]","+fn skipping_bound_peer_edges_keeps_an_own_dependency_declared_as_a_peer() {","+    let dir = tempfile::tempdir().unwrap();","+    std::fs::write(","+        dir.path().join(\"pnpm-lock.yaml\"),","+        \"lockfileVersion: '9.0'","+","+importers:","+","+  .:","+    dependencies:","+      wrapper:","+        specifier: 1.0.0","+        version: 1.0.0","+","+packages:","+","+  wrapper@1.0.0:","+    resolution: {integrity: sha512-wrapper}","+    peerDependencies:","+      mid: ^1.0.0","+","+  mid@1.0.0:","+    resolution: {integrity: sha512-mid}","+","+snapshots:","+","+  wrapper@1.0.0:","+    dependencies:","+      mid: 1.0.0","+","+  mid@1.0.0: {}","+\",","+    )","+    .unwrap();","+    let lockfile = Lockfile::load_wanted_from_dir(dir.path()).unwrap().unwrap();","+","+    let skipped = package_nodes(&lockfile, BoundPeerEdges::Skip);","+    dbg!(&skipped);","+    assert_eq!(skipped, BTreeSet::from([\"mid@1.0.0\".to_string(), \"wrapper@1.0.0\".to_string()]));","+}","+","+/// `wrapper`'s key has no peer suffix, so its `link:` dependency on `mid`","+/// is its own even though it also declares `mid` as a peer.","+#[test]","+fn skipping_bound_peer_edges_keeps_a_linked_own_dependency_of_an_unsuffixed_key() {","+    let dir = tempfile::tempdir().unwrap();","+    std::fs::write(","+        dir.path().join(\"pnpm-lock.yaml\"),","+        \"lockfileVersion: '9.0'","+","+importers:","+","+  .:","+    dependencies:","+      wrapper:","+        specifier: 1.0.0","+        version: 1.0.0","+","+packages:","+","+  wrapper@1.0.0:","+    resolution: {integrity: sha512-wrapper}","+    peerDependencies:","+      mid: ^1.0.0","+","+snapshots:","+","+  wrapper@1.0.0:","+    dependencies:","+      mid: link:../mid","+\",","+    )","+    .unwrap();","+    let lockfile = Lockfile::load_wanted_from_dir(dir.path()).unwrap().unwrap();","+    let graph = build_dependency_graph(","+        &[TreeNodeId::Importer(\".\".to_string())],","+        &BuildGraphOptions {","+            lockfile: &lockfile,","+            include: IncludedDependencies {","+                dependencies: true,","+                dev_dependencies: true,","+                optional_dependencies: true,","+            },","+            only_projects: false,","+            peer_edges: PeerEdgeOptions::default(),","+            bound_peer_edges: BoundPeerEdges::Skip,","+        },","+    );","+","+    let wrapper = &graph.nodes[&TreeNodeId::Package(\"wrapper@1.0.0\".parse().unwrap())];","+    let aliases: Vec<&str> = wrapper.edges","+        .iter()","+        .map(|edge| edge.alias.as_str())","+        .collect();","+    dbg!(&aliases);","+    assert_eq!(aliases, [\"mid\"]);","+}"],"additions":223,"deletions":0,"truncated":false},{"path":"pnpm/crates/napi/src/dependents.rs","lines":["@@ -51,6 +51,7 @@ use pnpm_deps_inspection::{","         render_dependents_tree,","     },","     graph::{","+        BoundPeerEdges,","         BuildGraphOptions,","         build_dependency_graph,","     },","@@ -115,6 +116,9 @@ pub struct DependentsOptions {","     /// every importer when a walk that leaves out a group decides which","     /// optional-peer edges to skip. Defaults to `false`.","     pub resolve_peers_from_workspace_root: Option<bool>,","+    /// Whether to leave out the packages reached only as a resolved peer","+    /// dependency, as `pnpm why --exclude-peers` does. Defaults to `false`.","+    pub exclude_peer_dependencies: Option<bool>,"," }"," "," /// Inputs for [`render_dependents`].","@@ -283,6 +287,7 @@ fn build_trees(options: &DependentsOptions) -> napi::Result<Vec<DependentsTree>>","             include: included_dependencies(options),","             only_projects: false,","             peer_edges: peer_edge_options(options),","+            bound_peer_edges: bound_peer_edges(options),","         },","     );","     let searcher =","@@ -373,6 +378,14 @@ fn included_dependencies(options: &DependentsOptions) -> IncludedDependencies {","     }"," }"," ","+fn bound_peer_edges(options: &DependentsOptions) -> BoundPeerEdges {","+    if options.exclude_peer_dependencies.unwrap_or(false) {","+        BoundPeerEdges::Skip","+    } else {","+        BoundPeerEdges::Follow","+    }","+}","+"," fn peer_edge_options(options: &DependentsOptions) -> PeerEdgeOptions {","     PeerEdgeOptions {","         resolve_peers_from_workspace_root: options"],"additions":13,"deletions":0,"truncated":false