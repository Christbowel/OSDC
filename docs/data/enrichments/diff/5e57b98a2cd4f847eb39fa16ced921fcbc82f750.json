{"id":"5e57b98a2cd4f847eb39fa16ced921fcbc82f750","axis":"silent","repo":"MetaMask/metamask-extension","sha":"5e57b98a2cd4f847eb39fa16ced921fcbc82f750","parsed":{"files":[{"path":".devcontainer/download-builds.ts","lines":["@@ -1,112 +0,0 @@","-import { execSync } from 'node:child_process';","-import unzipper from 'unzipper';","-import { version } from '../package.json';","-import { program, Option } from 'commander';","-import {","-  BuildType,","-  getBuildLinks,","-} from '../development/metamaskbot-build-announce/artifacts';","-","-const getBranch = () => {","-  try {","-    return execSync('git symbolic-ref --short HEAD').toString().trim();","-  } catch (error) {","-    return 'main';","-  }","-};","-","-interface DownloadBuildsArgs {","-  owner: string;","-  repository: string;","-  workflowId: string;","-  branch: string;","-  buildType: BuildType;","-  githubToken: string;","-  awsCloudfrontUrl: string;","-}","-","-program","-  .addOption(","-    new Option('-o, --owner <string>', 'owner of the repository')","-      .default('metamask')","-      .env('OWNER'),","-  )","-  .addOption(","-    new Option('-r, --repository <string>', 'repository name')","-      .default('metamask-extension')","-      .env('REPOSITORY'),","-  )","-  .addOption(","-    new Option('-w, --workflow-id <string>', 'workflow id')","-      .default('main.yml')","-      .env('WORKFLOW_ID'),","-  )","-  .addOption(","-    new Option('-b, --branch <string>', 'branch name')","-      .default(getBranch())","-      .env('BRANCH'),","-  )","-  .addOption(","-    new Option('-t, --build-type <string>', 'build type')","-      .default('main')","-      .env('BUILD_TYPE')","-      .choices(['main', 'beta', 'experimental', 'flask', 'test', 'test-flask']),","-  )","-  .addOption(","-    new Option('-g, --github-token <string>', 'github token')","-      .default('')","-      .env('GITHUB_TOKEN'),","-  )","-  .addOption(","-    new Option('-a, --aws-cloudfront-url <string>', 'aws cloudfront url')","-      .default('https://diuv6g5fj9pvx.cloudfront.net')","-      .env('AWS_CLOUDFRONT_URL'),","-  )","-  .action(async (args: DownloadBuildsArgs) => {","-    const { Octokit } = await import('octokit');","-","-    console.log('Downloading latest builds from');","-    console.log(`- Branch: ${args.branch}`);","-    console.log(`- Build type: ${args.buildType}`);","-    console.log('- Bundler: webpack');","-","-    const github = new Octokit({ auth: args.githubToken });","-","-    const runs = await github.rest.actions.listWorkflowRuns({","-      owner: args.owner,","-      repo: args.repository,","-      workflow_id: args.workflowId,","-      branch: args.branch,","-      status: 'success',","-      per_page: 1,","-    });","-","-    const latestRun = runs.data.workflow_runs.at(0);","-","-    if (!latestRun)","-      throw new Error(`No successful builds found on branch '${args.branch}'`);","-","-    console.log(`- Run number: ${latestRun.id}`);","-","-    const HOST_URL = `${args.awsCloudfrontUrl}/${args.repository}/${latestRun.id}`;","-","-    const buildLinks = getBuildLinks({ hostUrl: HOST_URL, version });","-","-    const builds = buildLinks.webpack[args.buildType];","-","-    console.log(`Downloading build for chrome from ${builds.chrome}`);","-    console.log(`Downloading build for firefox from ${builds.firefox}`);","-","-    await Promise.all(","-      Object.entries(builds).map(async ([platform, url]) => {","-        const artifact = await fetch(url);","-        const buffer = Buffer.from(await artifact.arrayBuffer());","-        const zip = await unzipper.Open.buffer(buffer);","-        await zip.extract({ path: `dist/${platform}` });","-      }),","-    );","-","-    console.log('Builds downloaded and unzipped successfully.');","-  });","-","-program.parse();"],"additions":0,"deletions":112,"truncated":false},{"path":".github/scripts/shared/resolve-build-run.mts","lines":["@@ -0,0 +1,364 @@","+import { execFileSync } from 'node:child_process';","+import { appendFileSync, writeFileSync } from 'node:fs';","+import { setTimeout as delay } from 'node:timers/promises';","+import { fileURLToPath } from 'node:url';","+import { parseArgs } from 'node:util';","+","+type BuildRun = {","+  head_sha: string;","+  html_url: string;","+  status: string;","+  event: string;","+  referenced_workflows?: { path: string; sha: string }[];","+};","+type Artifact = { name: string; expired: boolean };","+type BuildJob = { name: string; status: string; conclusion: string | null };","+type BuildStatus = { context: string; description: string | null };","+","+export type GitHubApi = (endpoint: string) => Promise<unknown>;","+export type BuildProvenance = {","+  requestedCommit: string;","+  runHeadCommit: string;","+  buildCommit: string;","+  runId: number;","+  runUrl: string;","+  reusedBuild: boolean;","+};","+","+type ResolveOptions = {","+  repository: string;","+  ref: string;","+  artifactNames: string[];","+  waitSeconds: number;","+  pollSeconds: number;","+};","+","+type Dependencies = {","+  api: GitHubApi;","+  sleep: (milliseconds: number) => Promise<void>;","+  now: () => number;","+  log: (message: string) => void;","+};","+","+type BuildAvailability =","+  | { status: 'ready'; provenance: BuildProvenance }","+  | { status: 'pending'; message: string };","+","+/**","+ * Resolves an immutable source commit to CI's canonical donor run and waits for its artifacts.","+ * Used by yarn download-builds and the fixture workflow, independent of download transport.","+ *","+ * @param options - Repository, ref, required artifacts, and bounded wait policy.","+ * @param dependencies - GitHub API and clock implementations.","+ * @returns Requested commit and canonical build provenance.","+ */","+export async function resolveBuildRun(","+  options: ResolveOptions,","+  dependencies: Dependencies,","+): Promise<BuildProvenance> {","+  validateResolveOptions(options);","+  const { repository, ref, artifactNames, waitSeconds } = options;","+  const { api, now } = dependencies;","+  const deadline = now() + waitSeconds * 1000;","+  const repositoryPath = `repos/${repository}`;","+  const { sha: requestedCommit } = (await api(","+    `${repositoryPath}/commits/${encodeURIComponent(ref)}`,","+  )) as { sha: string };","+","+  for (;;) {","+    const availability = await checkCanonicalBuildAvailability(","+      repositoryPath,","+      requestedCommit,","+      artifactNames,","+      api,","+    );","+    if (availability.status === 'ready') {","+      return availability.provenance;","+    }","+    await waitForNextBuildCheck(","+      availability.message,","+      deadline,","+      options,","+      dependencies,","+    );","+  }","+}","+","+function validateResolveOptions(options: ResolveOptions): void {","+  const { repository, ref, artifactNames, waitSeconds, pollSeconds } = options;","+  if (","+    !/^[\\w.-]+\\/[\\w.-]+$/u.test(repository) ||","+    !ref ||","+    !artifactNames.length ||","+    !Number.isFinite(waitSeconds) ||","+    waitSeconds < 0 ||","+    !Number.isFinite(pollSeconds) ||","+    pollSeconds <= 0","+  ) {","+    throw new Error(","+      'Invalid repository, ref, artifacts, or wait/poll interval',","+    );","+  }","+}","+","+async function checkCanonicalBuildAvailability(","+  repositoryPath: string,","+  requestedCommit: string,","+  artifactNames: string[],","+  api: GitHubApi,","+): Promise<BuildAvailability> {","+  const runId = await findCanonicalBuildRunId(","+    repositoryPath,","+    requestedCommit,","+    api,","+  );","+  if (runId === undefined) {","+    return {","+      status: 'pending',","+      message: `No 'builds-from-run' status on ${requestedCommit} yet. The Main workflow must publish it.`,","+    };","+  }","+","+  const runPath = `${repositoryPath}/actions/runs/${runId}`;","+  const run = (await api(runPath)) as BuildRun;","+  const artifacts = await listGitHubPages<Artifact>(","+    api,","+    `${runPath}/artifacts`,","+    'artifacts',","+  );","+  const missingArtifactNames = findMissingArtifactNames(","+    artifactNames,","+    artifacts,","+  );","+  if (!missingArtifactNames.length) {","+    return {","+      status: 'ready',","+      provenance: {","+        requestedCommit,","+        runHeadCommit: run.head_sha,","+        buildCommit: resolveBuildCommit(repositoryPath, run),","+        runId,","+        runUrl: run.html_url,","+        reusedBuild: run.head_sha !== requestedCommit,","+      },","+    };","+  }","+","+  assertArtifactsHaveNotExpired(missingArtifactNames, artifacts, run.html_url);","+  await assertBuildCanStillProduceArtifacts(","+    runPath,","+    run,","+    missingArtifactNames,","+    api,","+  );","+  return {","+    status: 'pending',","+    message: `${missingArtifactNames.join(', ')} not uploaded yet: ${run.html_url}`,","+  };","+}","+","+function resolveBuildCommit(repositoryPath: string, run: BuildRun): string {","+  const workflowPath = `${repositoryPath.slice('repos/'.length)}/.github/workflows/run-build.yml@`;","+  const workflows = (run.referenced_workflows ?? []).filter((workflow) =>","+    workflow.path.toLowerCase().startsWith(workflowPath.toLowerCase()),","+  );","+  // The same-repository reusable build workflow uses the default checkout.","+  // Its recorded SHA identifies the historical PR merge tree, unlike head_sha.","+  if (workflows.length === 1 && /^[a-f\\d]{40}$/iu.test(workflows[0].sha)) {","+    return workflows[0].sha;","+  }","+  // These events check out head_sha directly; PR runs must have merge metadata.","+  if (","+    !workflows.length &&","+    ['push', 'schedule', 'merge_group'].includes(run.event)","+  ) {","+    return run.head_sha;","+  }","+  throw new Error(","+    `Cannot determine build commit from run-build.yml metadata on ${run.html_url}. Re-run the build.`,","+  );","+}","+","+async function findCanonicalBuildRunId(","+  repositoryPath: string,","+  requestedCommit: string,","+  api: GitHubApi,","+): Promise<number | undefined> {","+  const statuses = await listGitHubPages<BuildStatus>(","+    api,","+    `${repositoryPath}/commits/${requestedCommit}/status`,","+    'statuses',","+  );","+  const pointer = statuses.find(","+    (status) => status.context === 'builds-from-run',","+  );","+  if (!pointer) {","+    return undefined;","+  }","+  const runId = Number(pointer.description);","+  if (","+    !/^\\d+$/u.test(pointer.description ?? '') ||","+    !Number.isSafeInteger(runId) ||","+    runId <= 0","+  ) {","+    throw new Error(`Invalid 'builds-from-run' status on ${requestedCommit}`);","+  }","+  return runId;","+}","+","+function findMissingArtifactNames(","+  requiredNames: string[],","+  artifacts: Artifact[],","+): string[] {","+  return requiredNames.filter(","+    (name) =>","+      !artifacts.some(","+        (artifact) => artifact.name === name && !artifact.expired,","+      ),","+  );","+}","+","+function assertArtifactsHaveNotExpired(","+  missingNames: string[],","+  artifacts: Artifact[],","+  runUrl: string,","+): void {","+  if (","+    artifacts.some(","+      (artifact) => missingNames.includes(artifact.name) && artifact.expired,","+    )","+  ) {","+    throw new Error(`Build artifact expired on ${runUrl}. Re-run the build.`);","+  }","+}","+","+async function assertBuildCanStillProduceArtifacts(","+  runPath: string,","+  run: BuildRun,","+  missingArtifactNames: string[],","+  api: GitHubApi,","+): Promise<void> {","+  const jobs = await listGitHubPages<BuildJob>(api, `${runPath}/jobs`, 'jobs');","+  const failedJob = jobs.find((job) =>","+    isFailedArtifactJob(job, missingArtifactNames),","+  );","+  if (failedJob) {","+    throw new Error(","+      `${failedJob.name} ${failedJob.conclusion} on ${run.html_url}`,","+    );","+  }","+  if (run.status === 'completed') {","+    throw new Error(","+      `${missingArtifactNames.join(', ')} missing from completed run ${run.html_url}. Re-run the build.`,","+    );","+  }","+}","+","+function isFailedArtifactJob(job: BuildJob, artifactNames: string[]): boolean {","+  const producesMissingArtifact = artifactNames.some(","+    (name) => job.name === name || job.name.endsWith(`/ ${name}`),","+  );","+  return (","+    producesMissingArtifact &&","+    job.status === 'completed' &&","+    job.conclusion !== 'success'","+  );","+}","+","+async function listGitHubPages<Value>(","+  api: GitHubApi,","+  endpoint: string,","+  key: string,","+): Promise<Value[]> {","+  const items: Value[] = [];","+  for (let page = 1; ; page += 1) {","+    const response = (await api(","+      `${endpoint}${endpoint.includes('?') ? '&' : '?'}per_page=100&page=${page}`,","+    )) as Record<string, Value[]>;","+    const batch = response[key];","+    items.push(...batch);","+    if (batch.length < 100) {","+      return items;","+    }","+  }","+}","+","+async function waitForNextBuildCheck(","+  pendingMessage: string,","+  deadline: number,","+  options: ResolveOptions,","+  dependencies: Dependencies,","+): Promise<void> {","+  const { waitSeconds, pollSeconds } = options;","+  const { now, log, sleep } = dependencies;","+  const remaining = deadline - now();","+  if (remaining <= 0) {","+    throw new Error(","+      `${pendingMessage} Wait limit reached (${waitSeconds}s). Retry when available.`,","+    );","+  }","+  log(`${pendingMessage} Waiting up to ${Math.ceil(remaining / 1000)}s more.`);","+  await sleep(Math.min(pollSeconds * 1000, remaining));","+}","+","+/** Resolves the fixture workflow's artifact owner; downloading stays with its gh step. */","+async function main(): Promise<void> {","+  const { values } = parseArgs({","+    options: {","+      repo: { type: 'string', default: 'MetaMask/metamask-extension' },","+      ref: { type: 'string' },","+      artifact: { type: 'string', default: 'build-dist-webpack' },","+      metadata: { type: 'string' },","+      'wait-seconds': { type: 'string', default: '1200' },","+      'poll-seconds': { type: 'string', default: '20' },","+      help: { type: 'boolean' },","+    },","+  });","+  if (values.help) {","+    console.log(","+      'Usage: node resolve-build-run.mts [--ref SHA] [--repo OWNER/REPO] [--artifact NAME] [--metadata FILE] [--wait-seconds 1200]',","+    );","+    return;","+  }","+  const metadata = await resolveBuildRun(","+    {","+      repository: values.repo,","+      ref:","+        values.ref ??","+        execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(),","+      artifactNames: [values.artifact],","+      waitSeconds: Number(values['wait-seconds']),","+      pollSeconds: Number(values['poll-seconds']),","+    },","+    {","+      api: async (endpoint) =>","+        JSON.parse(","+          execFileSync('gh', ['api', endpoint], {","+            encoding: 'utf8',","+            maxBuffer: 10 * 1024 * 1024,","+          }),","+        ),","+      sleep: delay,","+      now: Date.now,","+      log: (message) => console.error(message),","+    },","+  );","+  const metadataJson = JSON.stringify(metadata, null, 2);","+  if (values.metadata) {","+    writeFileSync(values.metadata, `${metadataJson}\\n`);","+  }","+  if (process.env.GITHUB_OUTPUT) {","+    appendFileSync(","+      process.env.GITHUB_OUTPUT,","+      `run-id=${metadata.runId}\\nbuild-sha=${metadata.buildCommit}\\n`,","+    );","+  }","+  console.log(metadataJson);","+}","+","+if (process.argv[1] === fileURLToPath(import.meta.url)) {","+  main().catch((error: unknown) => {","+    console.error(error instanceof Error ? error.message : error);","+    process.exitCode = 1;","+  });","+}"],"additions":364,"deletions":0,"truncated":false},{"path":".github/scripts/shared/resolve-build-run.test.mts","lines":["@@ -0,0 +1,259 @@","+/** @jest-environment node */","+import { resolveBuildRun } from './resolve-build-run.mts';","+","+const commit = 'a'.repeat(40);","+const donor = 'b'.repeat(40);","+const merge = 'c'.repeat(40);","+const buildWorkflow = {","+  path: `MetaMask/metamask-extension/.github/workflows/run-build.yml@${merge}`,","+  ref: 'refs/pull/47118/merge',","+  sha: merge,","+};","+const runUrl =","+  'https://github.com/MetaMask/metamask-extension/actions/runs/123';","+const options = {","+  repository: 'MetaMask/metamask-extension',","+  ref: commit,","+  artifactNames: ['build-dist-webpack'],","+  waitSeconds: 60,","+  pollSeconds: 20,","+};","+","+function fixture({","+  pointer = '123',","+  artifact = true,","+  expired = false,","+  runStatus = 'in_progress',","+  conclusion = null,","+  event = 'push',","+  headSha = donor,","+  referencedWorkflows,","+}: {","+  pointer?: string;","+  artifact?: boolean;","+  expired?: boolean;","+  runStatus?: string;","+  conclusion?: string | null;","+  event?: string;","+  headSha?: string;","+  referencedWorkflows?: { path: string; ref?: string; sha: string }[];","+} = {}) {","+  let clock = 0;","+  const api = jest.fn(async (endpoint: string): Promise<unknown> => {","+    if (endpoint.includes('/status?'))","+      return {","+        statuses: pointer","+          ? [{ context: 'builds-from-run', description: pointer }]","+          : [],","+      };","+    if (endpoint.includes('/artifacts?'))","+      return {","+        artifacts: artifact ? [{ name: 'build-dist-webpack', expired }] : [],","+      };","+    if (endpoint.includes('/jobs?'))","+      return {","+        jobs: [","+          {","+            name: 'build-dist-webpack / build-dist-webpack',","+            status: conclusion ? 'completed' : 'in_progress',","+            conclusion,","+          },","+        ],","+      };","+    if (endpoint.includes('/actions/runs/'))","+      return {","+        head_sha: headSha,","+        html_url: runUrl,","+        status: runStatus,","+        event,","+        referenced_workflows: referencedWorkflows,","+      };","+    return { sha: commit };","+  });","+  return {","+    api,","+    sleep: jest.fn(async (ms: number) => {","+      clock += ms;","+    }),","+    now: () => clock,","+    log: jest.fn(),","+  };","+}","+","+describe('resolveBuildRun', () => {","+  it('resolves the donor before unrelated workflow jobs finish', async () => {","+    const dependencies = fixture();","+    expect(await resolveBuildRun(options, dependencies)).toStrictEqual({","+      requestedCommit: commit,","+      runHeadCommit: donor,","+      buildCommit: donor,","+      runId: 123,","+      runUrl,","+      reusedBuild: true,","+    });","+    expect(dependencies.sleep).not.toHaveBeenCalled();","+  });","+","+  it.each([","+    { headSha: commit, reusedBuild: false },","+    { headSha: donor, reusedBuild: true },","+  ])(","+    'resolves the historical PR merge SHA with reuse=$reusedBuild',","+    async ({ headSha, reusedBuild }) => {","+      const metadata = await resolveBuildRun(","+        // The CLI defaults to a lowercase owner; API workflow paths use MetaMask.","+        { ...options, repository: 'metamask/metamask-extension' },","+        fixture({","+          event: 'pull_request',","+          headSha,","+          referencedWorkflows: [","+            {","+              ...buildWorkflow,","+              path: 'other/repo/.github/workflows/run-build.yml@main',","+              sha: donor,","+            },","+            {","+              ...buildWorkflow,","+              path: `MetaMask/metamask-extension/.github/workflows/run-e2e.yml@${donor}`,","+              sha: donor,","+            },","+            buildWorkflow,","+          ],","+        }),","+      );","+      expect(metadata).toMatchObject({","+        requestedCommit: commit,","+        runHeadCommit: headSha,","+        buildCommit: merge,","+        reusedBuild,","+      });","+    },","+  );","+","+  it.each(['push', 'schedule', 'merge_group'])(","+    'uses the run head for a %s run without referenced build workflow metadata',","+    async (event) => {","+      const metadata = await resolveBuildRun(options, fixture({ event }));","+      expect(metadata.buildCommit).toBe(donor);","+    },","+  );","+","+  it.each([","+    { name: 'missing', referencedWorkflows: undefined },","+    { name: 'empty', referencedWorkflows: [] },","+    {","+      name: 'another repository',","+      referencedWorkflows: [","+        { ...buildWorkflow, path: 'other/repo/.github/workflows/run-build.yml@main' },","+      ],","+    },","+    {","+      name: 'a mutable ref instead of a SHA',","+      referencedWorkflows: [{ ...buildWorkflow, sha: 'refs/pull/47118/merge' }],","+    },","+    {","+      name: 'ambiguous',","+      referencedWorkflows: [buildWorkflow, { ...buildWorkflow, sha: donor }],","+    },","+  ])(","+    'rejects PR build workflow metadata that is $name',","+    async ({ referencedWorkflows }) => {","+      await expect(","+        resolveBuildRun(","+          options,","+          fixture({ event: 'pull_request', referencedWorkflows }),","+        ),","+      ).rejects.toThrow('Cannot determine build commit');","+    },","+  );","+","+  it('pins a branch once and waits for the pointer and artifact', async () => {","+    const dependencies = fixture();","+    const original = dependencies.api.getMockImplementation()!;","+    let pointerChecks = 0;","+    let artifactChecks = 0;","+    dependencies.api.mockImplementation(async (endpoint) => {","+      if (endpoint.includes('/status?') && pointerChecks++ === 0)","+        return { statuses: [] };","+      if (endpoint.includes('/artifacts?') && artifactChecks++ === 0)","+        return { artifacts: [] };","+      return original(endpoint);","+    });","+    const metadata = await resolveBuildRun(","+      { ...options, ref: 'release/13.53.0' },","+      dependencies,","+    );","+    expect(metadata.requestedCommit).toBe(commit);","+    expect(","+      dependencies.api.mock.calls.filter(([endpoint]) =>","+        endpoint.endsWith('release%2F13.53.0'),","+      ),","+    ).toHaveLength(1);","+    expect(dependencies.sleep).toHaveBeenCalledTimes(2);","+  });","+","+  it('times out while the build is running', async () => {","+    const dependencies = fixture({ artifact: false });","+    await expect(resolveBuildRun(options, dependencies)).rejects.toThrow(","+      'Wait limit reached',","+    );","+    expect(dependencies.sleep).toHaveBeenCalledTimes(3);","+  });","+","+  it('reports failed builds, expired artifacts, and completed missing artifacts', async () => {","+    await expect(","+      resolveBuildRun(","+        options,","+        fixture({ artifact: false, conclusion: 'failure' }),","+      ),","+    ).rejects.toThrow('failure');","+    await expect(","+      resolveBuildRun(options, fixture({ expired: true })),","+    ).rejects.toThrow('expired');","+    await expect(","+      resolveBuildRun(","+        options,","+        fixture({ artifact: false, runStatus: 'completed' }),","+      ),","+    ).rejects.toThrow('missing from completed run');","+  });","+","+  it('rejects malformed pointers', async () => {","+    await expect(","+      resolveBuildRun(options, fixture({ pointer: '../run' })),","+    ).rejects.toThrow('Invalid');","+  });","+","+  it('requires all requested browser artifacts', async () => {","+    await expect(","+      resolveBuildRun(","+        {","+          ...options,","+          artifactNames: ['build-dist-webpack', 'build-dist-mv2-webpack'],","+          waitSeconds: 0,","+        },","+        fixture(),","+      ),","+    ).rejects.toThrow('build-dist-mv2-webpack');","+  });","+","+  it('paginates artifact lists to find the required artifact', async () => {","+    const dependencies = fixture();","+    const original = dependencies.api.getMockImplementation()!;","+    dependencies.api.mockImplementation(async (endpoint) => {","+      if (endpoint.includes('/artifacts?') && endpoint.endsWith('page=1')) {","+        return {","+          artifacts: Array.from({ length: 100 }, (_, index) => ({","+            name: `other-${index}`,","+            expired: false,","+          })),","+        };","+      }","+      return original(endpoint);","+    });","+    expect(