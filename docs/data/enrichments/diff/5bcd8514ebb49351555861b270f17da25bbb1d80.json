 + \".Length\";"],"additions":1,"deletions":0,"truncated":false},{"path":"documentation/src/main/asciidoc/reference/_ch02.adoc","lines":["@@ -689,6 +689,10 @@ With one exception also these constraints apply to the field/property level, onl"," \tSupported data types::: `CharSequence`"," \tHibernate metadata impact::: None"," ","+`@IBAN`:: Checks that the annotated character sequence is a valid https://en.wikipedia.org/wiki/International_Bank_Account_Number[IBAN] (International Bank Account Number). The country-specific length and the ISO 7064 MOD 97-10 check digits are both verified. Spaces are ignored during validation.","+\tSupported data types::: `CharSequence`","+\tHibernate metadata impact::: None","+"," `@IpAddress`:: Checks that the annotated character sequence is a valid https://en.wikipedia.org/wiki/IP_address[IP address]. `type` determines the version of IP address."," The default is `ANY`, which means both IPv4 and IPv6 addresses are considered valid."," \tSupported data types::: `CharSequence`"],"additions":4,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/cfg/defs/IBANDef.java","lines":["@@ -0,0 +1,21 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.cfg.defs;","+","+import org.hibernate.validator.cfg.ConstraintDef;","+import org.hibernate.validator.constraints.IBAN;","+","+/**","+ * An {@link IBAN} constraint definition.","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+public class IBANDef extends ConstraintDef<IBANDef, IBAN> {","+","+\tpublic IBANDef() {","+\t\tsuper( IBAN.class );","+\t}","+}"],"additions":21,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/constraints/IBAN.java","lines":["@@ -0,0 +1,63 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.constraints;","+","+import static java.lang.annotation.ElementType.ANNOTATION_TYPE;","+import static java.lang.annotation.ElementType.CONSTRUCTOR;","+import static java.lang.annotation.ElementType.FIELD;","+import static java.lang.annotation.ElementType.METHOD;","+import static java.lang.annotation.ElementType.PARAMETER;","+import static java.lang.annotation.ElementType.TYPE_USE;","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+import java.lang.annotation.Documented;","+import java.lang.annotation.Repeatable;","+import java.lang.annotation.Retention;","+import java.lang.annotation.Target;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+import org.hibernate.validator.constraints.IBAN.List;","+","+/**","+ * Checks that the annotated character sequence is a valid","+ * <a href=\"https://en.wikipedia.org/wiki/International_Bank_Account_Number\">IBAN</a>","+ * (International Bank Account Number).","+ * <p>","+ * The country-specific length and the ISO 7064 MOD 97-10 check digits are both verified.","+ * <p>","+ * The supported type is {@code CharSequence}. {@code null} is considered valid.","+ * <p>","+ * During validation spaces are ignored. This is useful when validating IBANs that use spaces","+ * to separate groups of characters (ex. {@code GB82 WEST 1234 5698 7654 32}).","+ *","+ * @author Andrea Boriero","+ * @since 9.2","+ */","+@Documented","+@Constraint(validatedBy = { })","+@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+@Retention(RUNTIME)","+@Repeatable(List.class)","+public @interface IBAN {","+","+\tString message() default \"{org.hibernate.validator.constraints.IBAN.message}\";","+","+\tClass<?>[] groups() default { };","+","+\tClass<? extends Payload>[] payload() default { };","+","+\t/**","+\t * Defines several {@code @IBAN} annotations on the same element.","+\t */","+\t@Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })","+\t@Retention(RUNTIME)","+\t@Documented","+\tpublic @interface List {","+","+\t\tIBAN[] value();","+\t}","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/constraintvalidators/hv/IBANValidator.java","lines":["@@ -0,0 +1,171 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.internal.constraintvalidators.hv;","+","+import java.util.Collections;","+import java.util.HashMap;","+import java.util.Locale;","+import java.util.Map;","+import java.util.regex.Pattern;","+","+import jakarta.validation.ConstraintValidator;","+import jakarta.validation.ConstraintValidatorContext;","+","+import org.hibernate.validator.constraints.IBAN;","+","+/**","+ * Checks that a given character sequence (e.g. string) is a valid IBAN (International Bank Account Number).","+ * <p>","+ * Validation is performed by checking the country-specific length and the ISO 7064 MOD 97-10 check digits.","+ *","+ * @author Andrea Boriero","+ */","+public class IBANValidator implements ConstraintValidator<IBAN, CharSequence> {","+","+\tprivate static final int MODULUS = 97;","+","+\t/**","+\t * The general IBAN structure: two letters (country code), two check digits and up to 30 alphanumeric","+\t * characters (BBAN). The country-specific length is verified separately.","+\t */","+\tprivate static final Pattern IBAN_STRUCTURE = Pattern.compile( \"[A-Za-z]{2}[0-9]{2}[A-Za-z0-9]+\" );","+","+\t/**","+\t * The expected total IBAN length per country, as defined by the SWIFT IBAN registry.","+\t */","+\tprivate static final Map<String, Integer> IBAN_COUNTRY_LENGTHS = buildCountryLengths();","+","+\t@Override","+\tpublic boolean isValid(CharSequence value, ConstraintValidatorContext context) {","+\t\tif ( value == null ) {","+\t\t\treturn true;","+\t\t}","+","+\t\t// Spaces are used to group characters when printing an IBAN, they are not part of the actual number.","+\t\tfinal String iban = removeSpaces( value );","+","+\t\tif ( !IBAN_STRUCTURE.matcher( iban ).matches() ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t// Reject unknown country codes and any IBAN whose length does not match the fixed length defined for its country.","+\t\tfinal Integer expectedLength = IBAN_COUNTRY_LENGTHS.get( iban.substring( 0, 2 ).toUpperCase( Locale.ROOT ) );","+\t\tif ( expectedLength == null || expectedLength != iban.length() ) {","+\t\t\treturn false;","+\t\t}","+","+\t\treturn hasValidCheckDigits( iban );","+\t}","+","+\tprivate static String removeSpaces(CharSequence value) {","+\t\treturn value.toString().replace( \" \", \"\" );","+\t}","+","+\t/**","+\t * Validates the ISO 7064 MOD 97-10 check digits: the first four characters are moved to the end,","+\t * each letter is replaced by two digits ('A' = 10, ..., 'Z' = 35) and the resulting number must","+\t * yield a remainder of 1 when divided by 97. The remainder is computed piece by piece to avoid","+\t * building a potentially very large integer.","+\t */","+\tprivate static boolean hasValidCheckDigits(String iban) {","+\t\tint length = iban.length();","+\t\tint mod = 0;","+\t\tfor ( int i = 0; i < length; i++ ) {","+\t\t\t// Start with the BBAN (chars after the first four), then wrap around to the country code and check digits.","+\t\t\tchar c = iban.charAt( ( i + 4 ) % length );","+\t\t\tif ( c >= '0' && c <= '9' ) {","+\t\t\t\tmod = ( mod * 10 + ( c - '0' ) ) % MODULUS;","+\t\t\t}","+\t\t\telse {","+\t\t\t\tmod = ( mod * 100 + ( Character.toUpperCase( c ) - 'A' + 10 ) ) % MODULUS;","+\t\t\t}","+\t\t}","+\t\treturn mod == 1;","+\t}","+","+\tprivate static Map<String, Integer> buildCountryLengths() {","+\t\tMap<String, Integer> lengths = new HashMap<>();","+\t\tlengths.put( \"AD\", 24 );","+\t\tlengths.put( \"AE\", 23 );","+\t\tlengths.put( \"AL\", 28 );","+\t\tlengths.put( \"AT\", 20 );","+\t\tlengths.put( \"AZ\", 28 );","+\t\tlengths.put( \"BA\", 20 );","+\t\tlengths.put( \"BE\", 16 );","+\t\tlengths.put( \"BG\", 22 );","+\t\tlengths.put( \"BH\", 22 );","+\t\tlengths.put( \"BR\", 29 );","+\t\tlengths.put( \"BY\", 28 );","+\t\tlengths.put( \"CH\", 21 );","+\t\tlengths.put( \"CR\", 22 );","+\t\tlengths.put( \"CY\", 28 );","+\t\tlengths.put( \"CZ\", 24 );","+\t\tlengths.put( \"DE\", 22 );","+\t\tlengths.put( \"DK\", 18 );","+\t\tlengths.put( \"DO\", 28 );","+\t\tlengths.put( \"EE\", 20 );","+\t\tlengths.put( \"EG\", 29 );","+\t\tlengths.put( \"ES\", 24 );","+\t\tlengths.put( \"FI\", 18 );","+\t\tlengths.put( \"FO\", 18 );","+\t\tlengths.put( \"FR\", 27 );","+\t\tlengths.put( \"GB\", 22 );","+\t\tlengths.put( \"GE\", 22 );","+\t\tlengths.put( \"GI\", 23 );","+\t\tlengths.put( \"GL\", 18 );","+\t\tlengths.put( \"GR\", 27 );","+\t\tlengths.put( \"GT\", 28 );","+\t\tlengths.put( \"HR\", 21 );","+\t\tlengths.put( \"HU\", 28 );","+\t\tlengths.put( \"IE\", 22 );","+\t\tlengths.put( \"IL\", 23 );","+\t\tlengths.put( \"IQ\", 23 );","+\t\tlengths.put( \"IS\", 26 );","+\t\tlengths.put( \"IT\", 27 );","+\t\tlengths.put( \"JO\", 30 );","+\t\tlengths.put( \"KW\", 30 );","+\t\tlengths.put( \"KZ\", 20 );","+\t\tlengths.put( \"LB\", 28 );","+\t\tlengths.put( \"LC\", 32 );","+\t\tlengths.put( \"LI\", 21 );","+\t\tlengths.put( \"LT\", 20 );","+\t\tlengths.put( \"LU\", 20 );","+\t\tlengths.put( \"LV\", 21 );","+\t\tlengths.put( \"LY\", 25 );","+\t\tlengths.put( \"MC\", 27 );","+\t\tlengths.put( \"MD\", 24 );","+\t\tlengths.put( \"ME\", 22 );","+\t\tlengths.put( \"MK\", 19 );","+\t\tlengths.put( \"MR\", 27 );","+\t\tlengths.put( \"MT\", 31 );","+\t\tlengths.put( \"MU\", 30 );","+\t\tlengths.put( \"NL\", 18 );","+\t\tlengths.put( \"NO\", 15 );","+\t\tlengths.put( \"PK\", 24 );","+\t\tlengths.put( \"PL\", 28 );","+\t\tlengths.put( \"PS\", 29 );","+\t\tlengths.put( \"PT\", 25 );","+\t\tlengths.put( \"QA\", 29 );","+\t\tlengths.put( \"RO\", 24 );","+\t\tlengths.put( \"RS\", 22 );","+\t\tlengths.put( \"SA\", 24 );","+\t\tlengths.put( \"SC\", 31 );","+\t\tlengths.put( \"SD\", 18 );","+\t\tlengths.put( \"SE\", 24 );","+\t\tlengths.put( \"SI\", 19 );","+\t\tlengths.put( \"SK\", 24 );","+\t\tlengths.put( \"SM\", 27 );","+\t\tlengths.put( \"ST\", 25 );","+\t\tlengths.put( \"SV\", 28 );","+\t\tlengths.put( \"TL\", 23 );","+\t\tlengths.put( \"TN\", 24 );","+\t\tlengths.put( \"TR\", 26 );","+\t\tlengths.put( \"UA\", 29 );","+\t\tlengths.put( \"VA\", 22 );","+\t\tlengths.put( \"VG\", 24 );","+\t\tlengths.put( \"XK\", 20 );","+\t\treturn Collections.unmodifiableMap( lengths );","+\t}","+}"],"additions":171,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/BuiltinConstraint.java","lines":["@@ -55,6 +55,7 @@ enum BuiltinConstraint {"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_CONTAINS( \"org.hibernate.validator.constraints.Contains\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_CURRENCY( \"org.hibernate.validator.constraints.Currency\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_DATE_TIME_FORMAT( \"org.hibernate.validator.constraints.DateTimeFormat\" ),","+\tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_IBAN( \"org.hibernate.validator.constraints.IBAN\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_IP_ADDRESS( \"org.hibernate.validator.constraints.IpAddress\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_ISBN( \"org.hibernate.validator.constraints.ISBN\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_LENGTH( \"org.hibernate.validator.constraints.Length\" ),"],"additions":1,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/ConstraintHelper.java","lines":["@@ -38,6 +38,7 @@"," import static org.hibernate.validator.internal.metadata.core.BuiltinConstraint.ORG_HIBERNATE_VALIDATOR_CONSTRAINTS_CURRENCY;"," import static org.hibernate.validator.internal.metadata.core.BuiltinConstraint.ORG_HIBERNATE_VALIDATOR_CONSTRAINTS_DATE_TIME_FORMAT;"," import static org.hibernate.validator.internal.metadata.core.BuiltinConstraint.ORG_HIBERNATE_VALIDATOR_CONSTRAINTS_EAN;","+import static org.h