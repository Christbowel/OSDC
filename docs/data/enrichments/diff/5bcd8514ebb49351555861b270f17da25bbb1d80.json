ertValidIBAN( \"NO9386011117947\" );","+\t\tassertValidIBAN( \"SA0380000000608010167519\" );","+\t}","+","+\t@Test","+\tpublic void validIBANWithSpaces() throws Exception {","+\t\t// Spaces used to group characters when printing an IBAN are ignored.","+\t\tassertValidIBAN( \"GB82 WEST 1234 5698 7654 32\" );","+\t\tassertValidIBAN( \"DE89 3704 0044 0532 0130 00\" );","+\t}","+","+\t@Test","+\tpublic void invalidCheckDigits() throws Exception {","+\t\tassertInvalidIBAN( \"GB94WEST12345698765432\" );","+\t\tassertInvalidIBAN( \"DE99370400440532013000\" );","+\t\tassertInvalidIBAN( \"BE68539007547035\" );","+\t}","+","+\t@Test","+\tpublic void invalidLengthForCountry() throws Exception {","+\t\t// GB IBANs are 22 characters long.","+\t\tassertInvalidIBAN( \"GB82WEST1234569876543\" );","+\t\tassertInvalidIBAN( \"GB82WEST123456987654321\" );","+\t}","+","+\t@Test","+\tpublic void invalidStructure() throws Exception {","+\t\tassertInvalidIBAN( \"\" );","+\t\t// Missing check digits.","+\t\tassertInvalidIBAN( \"GBWEST12345698765432\" );","+\t\t// Non-alphanumeric characters.","+\t\tassertInvalidIBAN( \"GB82WEST1234-698765432\" );","+\t}","+","+\t@Test","+\tpublic void unknownCountry() throws Exception {","+\t\tassertInvalidIBAN( \"ZZ82WEST12345698765432\" );","+\t}","+","+\t@Test","+\tpublic void testProgrammaticDefinition() throws Exception {","+\t\tHibernateValidatorConfiguration config = getConfiguration( HibernateValidator.class );","+\t\tConstraintMapping mapping = config.createConstraintMapping();","+\t\tmapping.type( Account.class )","+\t\t\t\t.field( \"iban\" )","+\t\t\t\t.constraint( new IBANDef() );","+\t\tconfig.addMapping( mapping );","+\t\tValidator validator = config.buildValidatorFactory().getValidator();","+","+\t\tSet<ConstraintViolation<Account>> constraintViolations = validator.validate( new Account( \"GB82WEST12345698765432\" ) );","+\t\tassertNoViolations( constraintViolations );","+","+\t\tconstraintViolations = validator.validate( new Account( \"GB94WEST12345698765432\" ) );","+\t\tassertThat( constraintViolations ).containsOnlyViolations(","+\t\t\t\tviolationOf( IBAN.class )","+\t\t);","+\t}","+","+\tprivate void assertValidIBAN(String iban) {","+\t\tassertTrue( validator.isValid( iban, null ), iban + \" should be a valid IBAN\" );","+\t}","+","+\tprivate void assertInvalidIBAN(String iban) {","+\t\tassertFalse( validator.isValid( iban, null ), iban + \" should be an invalid IBAN\" );","+\t}","+","+\tprivate static class Account {","+","+\t\tprivate final String iban;","+","+\t\tprivate Account(String iban) {","+\t\t\tthis.iban = iban;","+\t\t}","+\t}","+}",""],"additions":129,"deletions":0,"truncated":false}],"additions":463,"deletions":0,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-08-28T19:54:47.085593+00:00"}