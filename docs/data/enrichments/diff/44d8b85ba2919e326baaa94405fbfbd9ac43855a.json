uct PackedDirectory {","+    pub(super) project_dir: PathBuf,","+    pub(super) source_manifest: Value,","+    /// The version's manifest: its `any` archive's, or the base manifest of","+    /// a version published with variants only.","+    pub(super) published_manifest: Value,","+    /// The version's archive that targets `any`; `None` for a version","+    /// published with variants only.","+    pub(super) any: Option<PackedTarball>,","+    pub(super) notes: Option<String>,","+    /// The platform variants published with the version.","+    pub(super) variants: Vec<PackedVariant>,","+}","+","+/// A packed archive's bytes, where pack wrote it, and what it holds.","+pub(super) struct PackedTarball {","+    pub(super) data: Vec<u8>,","+    pub(super) path: String,","+    pub(super) contents: Vec<String>,","+    pub(super) unpacked_size: u64,","+}","+","+impl PackedDirectory {","+    pub(super) fn packed_pkg(&self) -> PackedPkg<'_> {","+        let any = self.any.as_ref();","+        PackedPkg {","+            published_manifest: &self.published_manifest,","+            tarball_data: any.map_or(&[], |any| &any.data),","+            tarball_path: any.map_or(\"\", |any| &any.path),","+            contents: any.map_or(&[], |any| &any.contents),","+            unpacked_size: any.map_or(0, |any| any.unpacked_size),","+            notes: self.notes.as_deref(),","+            variants: &self.variants,","+            any_archive: any.is_some(),","+        }","+    }","+}","+","+/// Whether the project's manifest declares `publishConfig.variants`.","+pub(super) fn declares_variants(manifest: &Value) -> bool {","+    manifest.pointer(\"/publishConfig/variants\").is_some()","+}","+","+/// The packed archives of the project at `project_dir`, read for publishing:","+/// the archive that targets `any` as the version's, and every other one as a","+/// platform variant. A version without an `any` archive is published with","+/// the base manifest.","+pub(super) fn packed_directory(","+    project_dir: &Path,","+    source_manifest: Value,","+    packed: PackedArchives,","+) -> miette::Result<PackedDirectory> {","+    let mut any = None;","+    let mut variants = Vec::new();","+    for archive in packed.archives {","+        match archive.entry.and_then(|entry| entry.tag) {","+            Some(tag) => {","+                let tarball_data = read_tarball(&archive.result.tarball_path)?;","+                variants.push(PackedVariant { tag, tarball_data });","+            }","+            None => any = Some(archive.result),","+        }","+    }","+    let published_manifest = match &any {","+        Some(result) => result.published_manifest.clone(),","+        None => packed.base_manifest,","+    };","+    let any = any","+        .map(|result| -> miette::Result<PackedTarball> {","+            Ok(PackedTarball {","+                data: read_tarball(&result.tarball_path)?,","+                path: result.tarball_path,","+                contents: result.contents,","+                unpacked_size: result.unpacked_size,","+            })","+        })","+        .transpose()?;","+    Ok(PackedDirectory {","+        project_dir: project_dir.to_path_buf(),","+        source_manifest,","+        published_manifest,","+        any,","+        notes: None,","+        variants,","+    })","+}","+","+fn read_tarball(path: &str) -> miette::Result<Vec<u8>> {","+    std::fs::read(path).into_diagnostic().wrap_err(\"read packed tarball\")","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/publish/tests.rs","lines":["@@ -46,6 +46,7 @@ fn publish_flags() -> PublishFlags {","                 no_release_notes: false,","                 publication_name: None,","             },","+            no_variants: false,","         },","         git: crate::cli_args::publish::PublishGitArgs {","             publish_branch: None,","@@ -162,11 +163,17 @@ async fn pack_for_publish_writes_a_tarball_and_returns_the_manifest() {"," ","     let args = publish_args_with(PublishFlags { ignore_scripts: true, ..publish_flags() });","     let result = args","-        .pack_for_publish::<SilentReporter>(dir.path(), &Config::default(), dest.path(), &[], None)","+        .pack_for_publish::<SilentReporter>(","+            dir.path(),","+            &Config::default(),","+            dest.path(),","+            &[],","+            (None, &[]),","+        )","         .await","         .expect(\"packing succeeds\");"," ","-    assert_eq!(result.published_manifest[\"name\"], \"pkg\");","+    assert_eq!(result.archives[0].result.published_manifest[\"name\"], \"pkg\");","     let wrote_tarball = std::fs::read_dir(dest.path())","         .expect(\"read the destination\")","         .flatten()"],"additions":9,"deletions":2,"truncated":false},{"path":"pnpm/crates/pack/src/lib.rs","lines":["@@ -22,7 +22,7 @@ pub use options::{"," };"," pub use output::{format_pack_output, pack_output_path, to_pack_result_json};"," pub use pnpm_exportable_manifest::WorkspacePackageManifest;","-pub use variants::{PackedArchive, archive_result_json, pack_archives};","+pub use variants::{PackedArchive, PackedArchives, archive_result_json, pack_archives};"," "," mod capabilities;"," mod collation;","@@ -206,8 +206,13 @@ pub enum PackError {","     )]","     VariantEntryPointMissing { targets: String, path: String },"," ","-    #[display(\"The package declares publishConfig.variants, which this command cannot publish yet\")]","-    #[diagnostic(code(ERR_PNPM_VARIANTS_UNSUPPORTED))]","+    #[display(","+        \"The package declares publishConfig.variants, so it packs into one archive per entry\"","+    )]","+    #[diagnostic(","+        code(ERR_PNPM_VARIANTS_UNSUPPORTED),","+        help(\"Pack it with pnpm pack, which writes every archive.\")","+    )]","     OneArchiveOfVariants,"," ","     #[display(\"The package declares no publishConfig.variants to pack {target:?} from\")]"],"additions":8,"deletions":3,"truncated":false},{"path":"pnpm/crates/pack/src/tests.rs","lines":["@@ -1347,6 +1347,8 @@ mod bundled_dependencies;"," mod dotenv;"," mod variants;"," ","+mod variant_warnings;","+"," #[test]"," fn bin_with_crlf_shebang_is_rejected() {","     use miette::Diagnostic;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/pack/src/tests/variant_warnings.rs","lines":["@@ -0,0 +1,127 @@","+//! The warnings a `publishConfig.variants` declaration earns.","+","+use super::{Host, PackOptions, fixture, touch};","+use crate::pack_archives;","+use pnpm_reporter::{LogEvent, LogLevel, Reporter};","+use serde_json::{Value, json};","+use std::sync::Mutex;","+","+/// Pack the package at `opts.dir` with `Recorder`, and give the warnings `events`","+/// recorded.","+fn warnings<Recorder: Reporter>(opts: &PackOptions, events: &Mutex<Vec<LogEvent>>) -> Vec<String> {","+    tokio::runtime::Builder::new_current_thread()","+        .enable_all()","+        .build()","+        .unwrap()","+        .block_on(pack_archives::<Recorder, Host>(opts, &[]))","+        .unwrap();","+    events","+        .lock()","+        .unwrap()","+        .iter()","+        .filter_map(|event| match event {","+            LogEvent::Pnpm(log) if matches!(log.level, LogLevel::Warn) => Some(log.message.clone()),","+            _ => None,","+        })","+        .collect()","+}","+","+fn declaration(files: Option<Value>, variants: &Value) -> Value {","+    let mut manifest = json!({","+        \"name\": \"example-cli\",","+        \"version\": \"4.0.0\",","+        \"publishConfig\": { \"variants\": variants },","+    });","+    if let Some(files) = files {","+        manifest[\"files\"] = files;","+    }","+    manifest","+}","+","+macro_rules! recording_reporter {","+    ($reporter:ident, $events:ident) => {","+        static $events: Mutex<Vec<LogEvent>> = Mutex::new(Vec::new());","+        struct $reporter;","+        impl Reporter for $reporter {","+            fn emit(event: &LogEvent) {","+                $events","+                    .lock()","+                    .unwrap()","+                    .push(event.clone());","+            }","+        }","+    };","+}","+","+#[test]","+fn a_declaration_with_an_any_entry_and_files_earns_no_warning() {","+    recording_reporter!(Recording, EVENTS);","+    let (dir, opts) = fixture(&declaration(","+        Some(json!([])),","+        &json!([","+            { \"targets\": [\"any\"], \"files\": [\"lib.js\"] },","+            { \"targets\": [\"linux-x64\"], \"files\": [\"native/cli\"] },","+        ]),","+    ));","+    touch(dir.path(), \"lib.js\", \"\");","+    touch(dir.path(), \"native/cli\", \"\");","+    assert_eq!(warnings::<Recording>(&opts, &EVENTS), Vec::<String>::new());","+}","+","+#[test]","+fn a_declaration_without_an_any_entry_warns() {","+    recording_reporter!(Recording, EVENTS);","+    let (dir, opts) = fixture(&declaration(","+        Some(json!([])),","+        &json!([{ \"targets\": [\"linux-x64\"], \"files\": [\"native/cli\"] }]),","+    ));","+    touch(dir.path(), \"native/cli\", \"\");","+    let warnings = warnings::<Recording>(&opts, &EVENTS);","+    assert_eq!(warnings.len(), 1, \"{warnings:?}\");","+    assert!(warnings[0].contains(r#\"no entry that targets \"any\"\"#), \"{}\", warnings[0]);","+}","+","+#[test]","+fn platform_variants_without_files_warn() {","+    recording_reporter!(Recording, EVENTS);","+    let (dir, opts) = fixture(&declaration(","+        None,","+        &json!([","+            { \"targets\": [\"any\"], \"files\": [\"lib.js\"] },","+            { \"targets\": [\"linux-x64\"], \"files\": [\"native/cli\"] },","+        ]),","+    ));","+    touch(dir.path(), \"lib.js\", \"\");","+    touch(dir.path(), \"native/cli\", \"\");","+    let warnings = warnings::<Recording>(&opts, &EVENTS);","+    assert_eq!(warnings.len(), 1, \"{warnings:?}\");","+    assert!(warnings[0].contains(r#\"has no \"files\" field\"#), \"{}\", warnings[0]);","+}","+","+/// A `files` that is not an array lists nothing, as no `files` does.","+#[test]","+fn platform_variants_with_a_files_that_is_no_list_warn() {","+    recording_reporter!(Recording, EVENTS);","+    let (dir, opts) = fixture(&declaration(","+        Some(Value::Null),","+        &json!([","+            { \"targets\": [\"any\"], \"files\": [\"lib.js\"] },","+            { \"targets\": [\"linux-x64\"], \"files\": [\"native/cli\"] },","+        ]),","+    ));","+    touch(dir.path(), \"lib.js\", \"\");","+    touch(dir.path(), \"native/cli\", \"\");","+    let warnings = warnings::<Recording>(&opts, &EVENTS);","+    assert_eq!(warnings.len(), 1, \"{warnings:?}\");","+}","+","+/// An `any` entry alone ships no file in two archives, so it needs no","+/// `files`.","+#[test]","+fn an_any_entry_alone_needs_no_files() {","+    recording_reporter!(Recording, EVENTS);","+    let (dir, opts) =","+        fixture(&declaration(None, &json!([{ \"targets\": [\"any\"], \"files\": [\"lib.js\"] }])));","+    touch(dir.path(), \"lib.js\", \"\");","+    assert_eq!(warnings::<Recording>(&opts, &EVENTS), Vec::<String>::new());","+}"],"additions":127,"deletions":0,"truncated":false},{"path":"pnpm/crates/pack/src/tests/variants.rs","lines":["@@ -17,6 +17,7 @@ fn pack(opts: &PackOptions, targets: &[&str]) -> Result<Vec<PackedArchive>, Pack","         .build()","         .unwrap()","         .block_on(pack_archives::<SilentReporter, Host>(opts, &targets))","+        .map(|packed| packed.archives)"," }"," "," fn addon() -> Value {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/pack/src/variants.rs","lines":["@@ -13,13 +13,16 @@"," //! [`check_archive`] runs the checks of one packed archive."," "," pub(crate) use export::export_entry_dependencies;","-pub use packing::{PackedArchive, archive_result_json, pack_archives};","+pub use packing::{PackedArchive, PackedArchives, archive_result_json, pack_archives};","+pub(crate) use warnings::warn_about_declaration;"," "," mod packing;"," "," mod export;","+"," #[cfg(test)]"," mod tests;","+mod warnings;"," "," use derive_more::{Display, Error};"," use miette::Diagnostic;","@@ -258,7 +261,7 @@ impl VariantDeclaration {"," }"," "," /// `base` without the declaration, which no archive publishes.","-fn base_manifest(base: &Value) -> Value {","+pub(crate) fn base_manifest(base: &Value) -> Value {","     let mut manifest = base.clone();","     let Some(publish_config) = manifest.get_mut(\"publishConfig\").and_then(Value::as_object_mut)","     else {"],"additions":5,"deletions":2,"truncated":false},{"path":"pnpm/crates/pack/src/variants/packing.rs","lines":["@@ -38,6 +38,15 @@ pub struct PackedArchive {","     pub result: PackResult,"," }"," ","+/// The archives [`pack_archives`] packed, and the manifest of the version","+/// they share: the base manifest without the declaration, which a version","+/// without an `any` archive is published with.","+#[derive(Debug)]","+pub struct PackedArchives {","+    pub base_manifest: Value,","+    pub archives: Vec<PackedArchive>,","+}","+"," /// Pack the package at `opts.dir`: every archive its `publishConfig.variants`"," /// declares, or the archives of the entries `targets` names (any one target"," /// of an entry names it, `any` the primary's). A package without variants","@@ -49,7 +58,7 @@ pub struct PackedArchive {"," pub async fn pack_archives<Reporter, Sys>(","     opts: &PackOptions,","     targets: &[String],","-) -> Result<Vec<PackedArchive>, PackError>","+) -> Result<PackedArchives, PackError>"," where","     Reporter: self::Reporter,","     Sys: FsReadFile + FsFileLen + FsCreateDirAll + FsAtomicWrite + FsIsExecutable,","@@ -62,8 +71,13 @@ where","             return Err(PackError::NoVariants { target: target.clone() });","         }","         let result = pack_source::<Reporter, Sys>(opts, source).await?;","-        return Ok(vec![PackedArchive { entry: None, result }]);","+        let base_manifest = result.published_manifest.clone();","+        return Ok(PackedArchives {","+            base_ma