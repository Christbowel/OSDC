{"id":"95684255a9b287ae9804cd2f182ac8f80dd45aa0","axis":"silent","repo":"tensorflow/tensorflow","sha":"95684255a9b287ae9804cd2f182ac8f80dd45aa0","parsed":{"files":[{"path":"third_party/xla/xla/backends/autotuner/profiler.h","lines":["@@ -35,6 +35,15 @@ struct ProfileOptions {","   // Whether to initialize the buffers with random data or leave them","   // uninitialized.","   bool should_init_buffers = false;","+  // Number of timed runs of each executable. The reported duration is the","+  // mean over all timed runs, which reduces run-to-run noise and the","+  // quantization error of the device timer.","+  int num_timed_runs = 1;","+  // Whether to flush the device caches before every timed run, so that the","+  // executable reads its inputs from device memory. This matches production","+  // workloads, where large operands such as weights are usually not cached","+  // when a kernel starts.","+  bool flush_caches = false;"," };"," "," struct ProfileResult {"],"additions":9,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/BUILD","lines":["@@ -549,6 +549,8 @@ cc_library(","         \"//xla/service/gpu/autotuning:redzone_buffers\",","         \"//xla/stream_executor:device_address\",","         \"//xla/stream_executor:device_address_allocator\",","+        \"//xla/stream_executor:device_description\",","+        \"//xla/stream_executor:stream\",","         \"//xla/stream_executor:stream_executor_address_allocator\",","         \"//xla/stream_executor:stream_executor_h\",","         \"//xla/stream_executor/gpu:redzone_allocator\",","@@ -870,7 +872,9 @@ xla_test(","         \"//xla/service/gpu:gpu_compiler\",","         \"//xla/stream_executor:device_address\",","         \"//xla/stream_executor:device_address_allocator\",","+        \"//xla/stream_executor:device_description\",","         \"//xla/stream_executor:platform\",","+        \"//xla/stream_executor:stream\",","         \"//xla/stream_executor:stream_executor_address_allocator\",","         \"//xla/stream_executor:stream_executor_h\",","         \"@com_google_absl//absl/log\","],"additions":4,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/gpu_profiler.cc","lines":["@@ -15,6 +15,7 @@ limitations under the License."," "," #include \"xla/backends/gpu/autotuner/gpu_profiler.h\""," ","+#include <algorithm>"," #include <cstddef>"," #include <cstdint>"," #include <memory>","@@ -58,7 +59,9 @@ limitations under the License."," #include \"xla/shape_util.h\""," #include \"xla/stream_executor/device_address.h\""," #include \"xla/stream_executor/device_address_allocator.h\"","+#include \"xla/stream_executor/device_description.h\""," #include \"xla/stream_executor/gpu/redzone_allocator.h\"","+#include \"xla/stream_executor/stream.h\""," #include \"xla/stream_executor/stream_executor.h\""," #include \"xla/stream_executor/stream_executor_address_allocator.h\""," #include \"xla/util/buffer_slice_merge.h\"","@@ -70,6 +73,10 @@ namespace gpu {"," "," namespace {"," ","+// Minimum size of the buffer used to flush the caches, in case the device does","+// not report its L2 cache size.","+constexpr int64_t kMinCacheFlushBytes = int64_t{64} << 20;  // 64 MiB","+"," std::vector<ExecutionInput> CreateExecutionInputsFromBuffers(","     absl::Span<se::DeviceAddressBase const> buffers,","     absl::Span<Shape const> shapes) {","@@ -255,13 +262,37 @@ std::unique_ptr<GpuProfiler> GpuProfiler::Create(","     LOG(ERROR) << \"Failed to create stream: \" << stream.status();","     return nullptr;","   }","-  return absl::WrapUnique(new GpuProfiler(stream_executor, active_allocator,","-                                          std::move(owned_allocator),","-                                          stream.value(), options));","+","+  // Overwriting twice the L2 cache size evicts all previously cached lines.","+  const int64_t cache_flush_bytes =","+      options.flush_caches","+          ? std::max(","+                2 * stream_executor->GetDeviceDescription().l2_cache_size(),","+                kMinCacheFlushBytes)","+          : 0;","+  return absl::WrapUnique(new GpuProfiler(","+      stream_executor, active_allocator, std::move(owned_allocator),","+      stream.value(), options, cache_flush_bytes));","+}","+","+GpuProfiler::~GpuProfiler() {","+  if (!cache_flush_buffer_.is_null()) {","+    absl::Status status = stream_->BlockHostUntilDone();","+    if (!status.ok()) {","+      LOG(ERROR) << \"Failed to synchronize stream before freeing cache flush \"","+                    \"buffer: \"","+                 << status;","+    }","+  }"," }"," "," absl::StatusOr<std::unique_ptr<InputBuffers>> GpuProfiler::CreateInputBuffers(","     const Executable* executable, const HloInstruction* instr) {","+  if (!cache_flush_buffer_.is_null()) {","+    ABSL_RETURN_IF_ERROR(stream_->BlockHostUntilDone());","+    ABSL_RETURN_IF_ERROR(cache_flush_buffer_.Free());","+  }","+  cache_flush_alloc_failed_ = false;","   ABSL_ASSIGN_OR_RETURN(","       RedzoneBuffers buffers,","       RedzoneBuffers::FromProgramShape(","@@ -326,21 +357,80 @@ absl::StatusOr<ProfileResult> GpuProfiler::Profile(","     }","   }"," ","+  // Average over several timed runs. With a single run, the device timer's","+  // quantization and run-to-run noise are comparable to the differences","+  // between the best candidates, which makes the selection nondeterministic.","+  const int num_timed_runs = std::max(1, options_.num_timed_runs);","+  absl::Duration total_duration = absl::ZeroDuration();","   ExecutionProfile profile;","-  profile.set_warmup_run_executed(true);","-  std::vector<ExecutionInput> execution_inputs =","-      CreateExecutionInputsFromBuffers(rz_buffers.input_buffers(),","-                                       rz_buffers.input_shapes());","+  for (int run = 0; run < num_timed_runs; ++run) {","+    ABSL_RETURN_IF_ERROR(FlushCaches());","+    profile.Clear();","+    profile.set_warmup_run_executed(true);","+    std::vector<ExecutionInput> execution_inputs =","+        CreateExecutionInputsFromBuffers(rz_buffers.input_buffers(),","+                                         rz_buffers.input_shapes());"," ","-  ABSL_ASSIGN_OR_RETURN(","-      ExecutionOutput execution_output,","-      Execute(executable, std::move(execution_inputs), &profile, allocator_));","+    ABSL_ASSIGN_OR_RETURN(","+        ExecutionOutput execution_output,","+        Execute(executable, std::move(execution_inputs), &profile, allocator_));"," ","-  result.duration = absl::Nanoseconds(profile.compute_time_ns());","-  result.output_buffer = execution_output.Commit().ConsumeResult();","+    total_duration += absl::Nanoseconds(profile.compute_time_ns());","+    if (run == num_timed_runs - 1) {","+      result.output_buffer = execution_output.Commit().ConsumeResult();","+    }","+  }","+  result.duration = total_duration / num_timed_runs;","   return result;"," }"," ","+absl::Status GpuProfiler::FlushCaches() {","+  if (cache_flush_bytes_ <= 0 || cache_flush_alloc_failed_) {","+    return absl::OkStatus();","+  }","+  auto allocate_flush_buffer = [&]() {","+    absl::StatusOr<se::ScopedDeviceAddress<uint8_t>> buffer =","+        allocator_->Allocate(stream_executor_->device_ordinal(),","+                             cache_flush_bytes_,","+                             /*retry_on_failure=*/false);","+    if (!buffer.ok()) {","+      cache_flush_alloc_failed_ = true;","+      if (!logged_cache_flush_alloc_failure_) {","+        logged_cache_flush_alloc_failure_ = true;","+        LOG(WARNING) << \"Failed to allocate \" << cache_flush_bytes_","+                     << \" bytes to flush caches between autotuning runs, \"","+                        \"profiling with warm caches: \"","+                     << buffer.status();","+      }","+    }","+    return buffer;","+  };","+","+  if (allocator_->AllowsAsynchronousDeallocation()) {","+    // Pool and VMM allocators handle stream-ordered reuse in Deallocate(), so","+    // release the scratch buffer immediately after scheduling MemZero() rather","+    // than holding it across input-buffer creation, warm-up redzones, or","+    // timed executions.","+    absl::StatusOr<se::ScopedDeviceAddress<uint8_t>> buffer =","+        allocate_flush_buffer();","+    if (!buffer.ok()) {","+      return absl::OkStatus();","+    }","+    return stream_->MemZero(buffer->ptr(), (*buffer)->size());","+  }","+","+  if (cache_flush_buffer_.is_null()) {","+    absl::StatusOr<se::ScopedDeviceAddress<uint8_t>> buffer =","+        allocate_flush_buffer();","+    if (!buffer.ok()) {","+      return absl::OkStatus();","+    }","+    cache_flush_buffer_ = *std::move(buffer);","+  }","+  return stream_->MemZero(cache_flush_buffer_.ptr(),","+                          cache_flush_buffer_->size());","+}","+"," absl::StatusOr<ExecutionOutput> GpuProfiler::Execute(","     Executable* executable, std::vector<ExecutionInput> inputs,","     ExecutionProfile* profile, se::DeviceAddressAllocator* allocator) {"],"additions":102,"deletions":12,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/gpu_profiler.h","lines":["@@ -16,11 +16,13 @@ limitations under the License."," #ifndef XLA_BACKENDS_GPU_AUTOTUNER_GPU_PROFILER_H_"," #define XLA_BACKENDS_GPU_AUTOTUNER_GPU_PROFILER_H_"," ","+#include <cstdint>"," #include <memory>"," #include <utility>"," #include <vector>"," "," #include \"absl/log/log.h\"","+#include \"absl/status/status.h\""," #include \"absl/status/statusor.h\""," #include \"xla/backends/autotuner/profiler.h\""," #include \"xla/service/executable.h\"","@@ -44,6 +46,8 @@ class GpuProfiler : public Profiler {","       stream_executor::StreamExecutor* stream_executor, ProfileOptions options,","       se::DeviceAddressAllocator* external_allocator = nullptr);"," ","+  ~GpuProfiler() override;","+","   // The input buffers shapes are taken from the attatched HloModule to the","   // executable.","   // TODO(b/407494793): Add a better way to get the input buffer shapes.","@@ -65,22 +69,33 @@ class GpuProfiler : public Profiler {","       se::StreamExecutor* stream_executor,","       se::DeviceAddressAllocator* allocator,","       std::unique_ptr<se::DeviceAddressAllocator> owned_allocator,","-      se::Stream* stream, ProfileOptions options)","+      se::Stream* stream, ProfileOptions options, int64_t cache_flush_bytes)","       : stream_executor_(stream_executor),","         allocator_(allocator),","         owned_allocator_(std::move(owned_allocator)),","         stream_(stream),","-        options_(options) {}","+        options_(options),","+        cache_flush_bytes_(cache_flush_bytes) {}"," ","   absl::StatusOr<ExecutionOutput> Execute(","       Executable* executable, std::vector<ExecutionInput> inputs,","       ExecutionProfile* profile, se::DeviceAddressAllocator* allocator);"," ","+  // Evicts the inputs of the previous run from the L2 cache by overwriting a","+  // buffer that is larger than the cache. No-op if cache flushing is disabled.","+  absl::Status FlushCaches();","+","   se::StreamExecutor* stream_executor_;","   se::DeviceAddressAllocator* allocator_;","   std::unique_ptr<se::DeviceAddressAllocator> owned_allocator_;","   se::Stream* stream_;","   ProfileOptions options_;","+  int64_t cache_flush_bytes_ = 0;","+  bool cache_flush_alloc_failed_ = false;","+  bool logged_cache_flush_alloc_failure_ = false;","+  // Reused across timed runs only when","+  // `!allocator_->AllowsAsynchronousDeallocation()`.","+  se::ScopedDeviceAddress<uint8_t> cache_flush_buffer_;"," };"," "," }  // namespace gpu"],"additions":17,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/gpu_profiler_test.cc","lines":["@@ -15,7 +15,9 @@ limitations under the License."," "," #include \"xla/backends/gpu/autotuner/gpu_profiler.h\""," ","+#include <algorithm>"," #include <cstdint>","+#include <limits>"," #include <memory>"," #include <string>"," #include <utility>","@@ -48,7 +50,9 @@ limitations under the License."," #include \"xla/shape_util.h\""," #include \"xla/stream_executor/device_address.h\""," #include \"xla/stream_executor/device_address_allocator.h\"","+#include \"xla/stream_executor/device_description.h\""," #include \"xla/stream_executor/platform.h\"","+#include \"xla/stream_executor/stream.h\""," #include \"xla/stream_executor/stream_executor.h\""," #include \"xla/stream_executor/stream_executor_address_allocator.h\""," #include \"xla/xla_data.pb.h\"","@@ -69,10 +73,19 @@ class MockExecutable : public Executable {","   explicit MockExecutable(std::shared_ptr<HloModule> module, int duration_ns,","                           bool should_fail = false,","                           bool write_past_allocated_buffer = false)","+      : MockExecutable(std::move(module), std::vector<int>{duration_ns},","+                       should_fail, write_past_allocated_buffer) {}","+","+  // The i-th profiled run reports the duration","+  // `durations_ns[i % durations_ns.size()]`.","+  MockExecutable(std::shared_ptr<HloModule> module,","+                 std::vector<int> durations_ns, bool should_fail = false,","+                 bool write_past_allocated_buffer = false)","       : Executable(module),","-        duration_ns_(duration_ns),","+        durations_ns_(std::move(durations_ns)),","         should_fail_(should_fail),","         write_past_allocated_buffer_(write_past_allocated_buffer) {}","+","   absl::StatusOr<ExecutionOutput> ExecuteAsyncOnStream(","       const ServiceExecutableRunOptions* run_options,","       std::vector<ExecutionInput> arguments) override {","@@ -81,7 +94,9 @@ class MockExecutable : public Executable {","     }","     ExecutionProfile* profile = run_options->run_options().execution_profile();","     if (profile != nullptr) {","-      profile->set_compute_time_ns(duration_ns_);","+      profile->set_compute_time_ns(","+          durations_ns_[num_profiled_runs_ % durations_ns_.size()]);","+      ++num_profiled_runs_;","     }","     if (write_past_allocated_buffer_) {","       ABSL_RETURN_IF_ERROR(WriteOutOfBounds(*run_options));","@@ -93,6 +108,8 @@ class MockExecutable : public Executable {","                            run_options->run_options().device_ordinal());","   }"," ","+  int num_profiled_runs() const { return num_profiled_runs_; }","+","  private:","   // Simulates a kernel that writes past the end of an allocated buffer:","   // allocates a buffer through the run's allocator and then writes a few","@@ -117,11 +134,82 @@ class MockExecutable : public Executable {","                                                        kOverrunBytes);","   }"," ","-  int duration_ns_;","+  std::vector<int> durations_ns_;","+  int num_profiled_runs_ = 0;","   bool should_fail_;","   bool write_past_allocated_buffer_;"," };"," ","+// Forwards to another allocator, records allocations, and optionally enforces a","+// live-memory cap or asynchronous-deallocation semantics.","+class RecordingAllocator : public se::DeviceAddressAllocator {","+ public:","+  struct AllocationRecord {","+    uint64_t size;","+    bool retry_on_failure;","+  };","+","+  explicit RecordingAllocator(","+      se::DeviceAddressAllocator* wrapped,","+      bool allows_async_deallocation = false,","+      uint64_t max_live_bytes = std::numeric_limits<uint64_t>::max())","+      : se::DeviceAddressAllocator(wrapped->platform()),","+        wrapped_(wrapped),","+        allows_async_deallocation_(allows_async_deallocation),","+        max_live_bytes_(max_live_bytes) {}","+","+  absl::StatusOr<se::ScopedDeviceAddress<uint8_t>> Allocate(","+      int device_ordinal, uint64_t size, bool retry_on_failure,","+      int64_t memory_space) override {","+    allocations_.push_back({size, retry_on_failure});","+    if (size > max_live_bytes_ - live_bytes_) {","+      return absl::ResourceExhaustedError(\"Simulated allocator OOM.\");","+    }","+    ABSL_ASSIGN_OR_RETURN(se::ScopedDeviceAddress<uint8_t> address,","+                     wrapped_->Allocate(device_ordinal, size, retry_on_failure,","+                                        memory_space));","+    live_bytes_ += address->size();","+    peak_live_bytes_ = std::max(peak_live_bytes_, live_bytes_);","+    return se::ScopedDeviceAddress<uint8_t>(address.Release(), device_ordinal,","+                                            this);","+  }","+","+  bool AllowsAsynchronousDeallocation() const override {","+    return allows_async_deallocation_;","+  }","+","+  absl::StatusOr<se::Stream*> GetStream(int device_ordinal) override {","+    return wrapped_->GetStream(device_ordinal);","+  }","+","+  absl::Status Deallocate(int device_ordinal,","+                          se::DeviceAddressBase mem) override {","+    if (!mem.is_null()) {","+      if (allows_async_deallocation_ &&","+          !wrapped_->AllowsAsynchronousDeallocation()) {","+        ABSL_ASSIGN_OR_RETURN(se::Stream * stream, GetStream(device_ordinal));","+        ABSL_RETURN_IF_ERROR(stream->BlockHostUntilDone());","+      }","+      live_bytes_ -= mem.size();","+    }","+    return wrapped_->Deallocate(device_ordinal, mem);","+  }","+","+  const std::vector<AllocationRecord>& allocations() const {","+    return allocations_;","+  }","+  uint64_t live_bytes() const { return live_bytes_; }","+  uint64_t peak_live_bytes() const { return peak_live_bytes_; }","+","+ private:","+  se::DeviceAddressAllocator* wrapped_;","+  bool allows_async_deallocation_;","+  uint64_t max_live_bytes_;","+  uint64_t live_bytes_ = 0;","+  uint64_t peak_live_bytes_ = 0;","+  std::vector<AllocationRecord> allocations_;","+};","+"," absl::StatusOr<ScopedShapedBuffer> CreateTestBuffer(","     se::DeviceAddressAllocator* allocator, se::StreamExecutor* stream_exec,","     se::Stream* stream, int32_t value) {","@@ -259,6 +347,188 @@ TEST_F(GpuProfilerTest, FailingExecutablesReturnStatus) {","               StatusIs(absl::StatusCode::kInternal));"," }"," ","+TEST_F(GpuProfilerTest, ReportsMeanDurationOfTimedRuns) {","+  constexpr absl::string_view kHloModule = R\"(","+    HloModule module","+    ENTRY main {","+      ROOT c = s32[] constant(1)","+    }","+  )\";","+  ASSERT_OK_AND_ASSIGN(std::shared_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloModule));","+  MockExecutable mock_executable(module, std::vector<int>{1000, 2000, 6000});","+  ProfileOptions options;","+  options.num_timed_runs = 3;","+  auto profiler = GpuProfiler::Create(stream_exec_, options, allocator_.get());","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<InputBuffers> buffers,","+                       profiler->CreateInputBuffers(&mock_executable));","+  ASSERT_OK_AND_ASSIGN(ProfileResult profile,","+                       profiler->Profile(&mock_executable, *buffers));","+  EXPECT_EQ(profile.duration, absl::Nanoseconds(3000));","+  EXPECT_EQ(mock_executable.num_profiled_runs(), 3);","+  EXPECT_EQ(profile.output_buffer->on_device_shape(),","+            ShapeUtil::MakeShape(S32, {}));","+}","+","+TEST_F(GpuProfilerTest, DoesNotAllocateCacheFlushBufferByDefault) {","+  constexpr absl::string_view kHloModule = R\"(","+    HloModule module","+    ENTRY main {","+      ROOT c = s32[] constant(1)","+    }","+  )\";","+  ASSERT_OK_AND_ASSIGN(std::shared_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloModule));","+  MockExecutable mock_executable(module, 1000);","+  RecordingAllocator allocator(allocator_.get());","+  auto profiler =","+      GpuProfiler::Create(stream_exec_, ProfileOptions(), &allocator);","+  ASSERT_NE(profiler, nullptr);","+  EXPECT_THAT(allocator.allocations(), ::testing::IsEmpty());","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<InputBuffers> buffers,","+                       profiler->CreateInputBuffers(&mock_executable));","+  ASSERT_OK_AND_ASSIGN(ProfileResult profile,","+                       profiler->Profile(&mock_executable, *buffers));","+  EXPECT_EQ(profile.duration, absl::Nanoseconds(1000));","+  const uint64_t min_flush_bytes = std::max<uint64_t>(","+      2 * stream_exec_->GetDeviceDescription().l2_cache_size(), 64ULL << 20);","+  EXPECT_LT(allocator.peak_live_bytes(), min_flush_bytes);","+}","+","+TEST_F(GpuProfilerTest, FlushesCachesBeforeTimedRuns) {","+  constexpr absl::string_view kHloModule = R\"(","+    HloModule module","+    ENTRY main {","+      ROOT c = s32[] constant(1)","+    }","+  )\";","+  ASSERT_OK_AND_ASSIGN(std::shared_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloModule));","+  MockExecutable mock_executable(module, std::vector<int>{1000, 3000});","+  RecordingAllocator allocator(allocator_.get(),","+                               /*allows_async_deallocation=*/false);","+  ProfileOptions options;","+  options.flush_caches = true;","+  options.num_timed_runs = 2;","+  options.redzone_padding_bytes = 1024;","+  auto profiler = GpuProfiler::Create(stream_exec_, options, &allocator);","+  ASSERT_NE(profiler, nullptr);","+  EXPECT_THAT(allocator.allocations(), ::testing::IsEmpty());","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<InputBuffers> buffers,","+                       profiler->CreateInputBuffers(&mock_executable));","+  ASSERT_OK_AND_ASSIGN(ProfileResult profile,","+                       profiler->Profile(&mock_executable, *buffers));","+  EXPECT_EQ(profile.duration, absl::Nanoseconds(2000));","+  EXPECT_EQ(mock_executable.num_profiled_runs(), 2);","+  EXPECT_OK(profiler->CheckInputBuffers(*buffers));","+","+  const uint64_t min_flush_bytes = std::max<uint64_t>(","+      2 * stream_exec_->GetDeviceDescription().l2_cache_size(), 64ULL << 20);","+  int flush_alloc_count = 0;","+  for (const auto& alloc : allocator.allocations()) {","+    if (alloc.size >= min_flush_bytes) {","+      ++flush_alloc_count;","+      EXPECT_FALSE(alloc.retry_on_failure);","+    }","+  }","+  // Synchronous allocators allocate the cache-flush buffer lazily once per","+  // instruction group and reuse it across timed runs.","+  EXPECT_EQ(flush_alloc_count, 1);","+}","+","+TEST_F(GpuProfilerTest,","+       ReleasesCacheFlushBufferBetweenRunsWithAsyncDeallocation) {","+  constexpr absl::string_view kHloModule = R\"(","+    HloModule module","+    ENTRY main {","+      p0 = s32[] parameter(0)","+      ROOT copy = s32[] copy(p0)","+    }","+  )\";","+  ASSERT_OK_AND_ASSIGN(std::shared_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloModule));","+  MockExecutable mock_executable(module, std::vector<int>{1000, 3000});","+  const uint64_t min_flush_bytes = std::max<uint64_t>(","+      2 * stream_exec_->GetDeviceDescription().l2_cache_size(), 64ULL << 20);","+  // Budget fits input redzones (16 MiB) + warm-up output redzones (16 MiB) =","+  // 32 MiB, and fits input redzones (16 MiB) + transient cache-flush scratch,","+  // but CANNOT hold input redzones + warm-up redzones + cache-flush scratch","+  // simultaneously (32 MiB + min_flush_bytes > max_live_bytes).","+  RecordingAllocator allocator(allocator_.get(),","+                               /*allows_async_deallocation=*/true,","+                               /*max_live_bytes=*/min_flush_bytes + (20 << 20));","+  ProfileOptions options;","+  options.flush_caches = true;","+  options.num_timed_runs = 2;","+  options.redzone_padding_bytes = 8 << 20;","+  auto profiler = GpuProfiler::Create(stream_exec_, options, &allocator);","+  ASSERT_NE(profiler, nullptr);","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<InputBuffers> buffers,","+                       profiler->CreateInputBuffers(&mock_executable));","+  ASSERT_OK_AND_ASSIGN(ProfileResult profile,","+                       profiler->Profile(&mock_executable, *buffers));","+  EXPECT_EQ(profile.duration, absl::Nanoseconds(2000));","+  EXPECT_EQ(mock_executable.num_profiled_runs(), 2);","+","+  int flush_alloc_count = 0;","+  for (const auto& alloc : allocator.allocations()) {","+    if (alloc.size >= min_flush_bytes) {","+      ++flush_alloc_count;","+      EXPECT_FALSE(alloc.retry_on_failure);","+    }","+  }","+  EXPECT_EQ(flush_alloc_count, 2);","+  // After Profile() returns, only input buffers + committed output remain live.","+  EXPECT_LT(allocator.live_bytes(), min_flush_bytes);","+}","+","+TEST_F(GpuProfilerTest,","+       FallsBackToWarmCacheWhenPoolTooSmallWithoutStarvingInputs) {","+  constexpr absl::string_view kHloModule = R\"(","+    HloModule module","+    ENTRY main {","+      p0 = s32[] parameter(0)","+      ROOT copy = s32[] copy(p0)","+    }","+  )\";","+  ASSERT_OK_AND_ASSIGN(std::shared_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloModule));","+  MockExecutable mock_executable(module, std::vector<int>{1000, 3000});","+  const uint64_t min_flush_bytes = std::max<uint64_t>(","+      2 * stream_exec_->GetDeviceDescription().l2_cache_size(), 64ULL << 20);","+  // Pool is slightly larger than min_flush_bytes (e.g. 128 MiB BFCAllocator on","+  // H100 where min_flush_bytes = 100 MiB), so an eager persistent allocation in","+  // Create() would starve the 16 MiB input redzones in CreateInputBuffers().","+  RecordingAllocator allocator(allocator_.get(),","+                               /*allows_async_deallocation=*/true,","+                               /*max_live_bytes=*/min_flush_bytes + (4 << 20));","+  ProfileOptions options;","+  options.flush_caches = true;","+  options.num_timed_runs = 2;","+  options.redzone_padding_bytes = 8 << 20;","+  auto profiler = GpuProfiler::Create(stream_exec_, options, &allocator);","+  ASSERT_NE(profiler, nullptr);","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<InputBuffers> buffers,","+                       profiler->CreateInputBuffers(&mock_executable));","+  ASSERT_OK_AND_ASSIGN(ProfileResult profile,","+                       profiler->Profile(&mock_executable, *buffers));","+  EXPECT_EQ(profile.duration, absl::Nanoseconds(2000));","+  EXPECT_EQ(mock_executable.num_profiled_runs(), 2);","+","+  int flush_attempt_count = 0;","+  for (const aut