{"id":"87a3e2e91f292e4fb42233f019abb2cd0605ee30","axis":"silent","repo":"jaegertracing/jaeger","sha":"87a3e2e91f292e4fb42233f019abb2cd0605ee30","parsed":{"files":[{"path":"cmd/anonymizer/Dockerfile","lines":["@@ -4,7 +4,8 @@"," FROM scratch"," ARG TARGETARCH"," ARG USER_UID=10001","+ARG USER_GID=10001"," "," COPY anonymizer-linux-$TARGETARCH /go/bin/anonymizer-linux"," ENTRYPOINT [\"/go/bin/anonymizer-linux\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"],"additions":2,"deletions":1,"truncated":false},{"path":"cmd/es-index-cleaner/Dockerfile","lines":["@@ -6,6 +6,7 @@ ARG base_image"," FROM $base_image AS release"," ARG TARGETARCH"," ARG USER_UID=10001","+ARG USER_GID=10001"," COPY es-index-cleaner-linux-$TARGETARCH /go/bin/es-index-cleaner-linux"," ENTRYPOINT [\"/go/bin/es-index-cleaner-linux\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"],"additions":2,"deletions":1,"truncated":false},{"path":"cmd/es-rollover/Dockerfile","lines":["@@ -6,6 +6,7 @@ ARG base_image"," FROM $base_image AS release"," ARG TARGETARCH"," ARG USER_UID=10001","+ARG USER_GID=10001"," COPY es-rollover-linux-$TARGETARCH /go/bin/es-rollover"," ENTRYPOINT [\"/go/bin/es-rollover\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"],"additions":2,"deletions":1,"truncated":false},{"path":"cmd/jaeger/Dockerfile","lines":["@@ -9,6 +9,7 @@ ARG debug_image"," FROM $base_image AS release"," ARG TARGETARCH"," ARG USER_UID=10001","+ARG USER_GID=10001"," "," ENV JAEGER_LISTEN_HOST=0.0.0.0"," ","@@ -47,13 +48,14 @@ COPY sampling-strategies.json /cmd/jaeger/sampling-strategies.json"," "," VOLUME [\"/tmp\"]"," ENTRYPOINT [\"/cmd/jaeger/jaeger-linux\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"," "," # ------------- Begin DEBUG image -------------"," "," FROM $debug_image AS debug"," ARG TARGETARCH=amd64"," ARG USER_UID=10001","+ARG USER_GID=10001"," "," ENV JAEGER_LISTEN_HOST=0.0.0.0"," ","@@ -96,4 +98,4 @@ COPY sampling-strategies.json /cmd/jaeger/sampling-strategies.json"," VOLUME [\"/tmp\"]"," # Launch Jaeger under Delve debugger in headless mode but without pausing on start (--continue)."," ENTRYPOINT [\"/go/bin/dlv\", \"exec\", \"/cmd/jaeger/jaeger-linux\", \"--continue\", \"--headless\", \"--listen=:12345\", \"--api-version=2\", \"--accept-multiclient\", \"--log\", \"--\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"],"additions":4,"deletions":2,"truncated":false},{"path":"cmd/jaeger/dockerfile_test.go","lines":["@@ -0,0 +1,79 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package main","+","+import (","+\t\"os\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/jaegertracing/jaeger/internal/testutils\"","+)","+","+func TestMain(m *testing.M) {","+\ttestutils.VerifyGoLeaks(m)","+}","+","+type dockerStage struct {","+\tname string","+\tuser string","+}","+","+// The cmd directory has no Go package of its own, so the images of all","+// commands are checked here. Every stage in these Dockerfiles is a","+// published image.","+func TestImagesRunWithNonRootUserAndGroup(t *testing.T) {","+\tdockerfiles, err := filepath.Glob(\"../*/Dockerfile\")","+\trequire.NoError(t, err)","+\trequire.NotEmpty(t, dockerfiles)","+","+\tfor _, dockerfile := range dockerfiles {","+\t\tt.Run(filepath.Base(filepath.Dir(dockerfile)), func(t *testing.T) {","+\t\t\tcontent, err := os.ReadFile(dockerfile)","+\t\t\trequire.NoError(t, err)","+\t\t\tstages := parseDockerStages(string(content))","+\t\t\trequire.NotEmpty(t, stages)","+","+\t\t\tfor _, stage := range stages {","+\t\t\t\tuid, gid, hasGroup := strings.Cut(stage.user, \":\")","+\t\t\t\tassert.True(t, hasGroup, \"stage %s: want USER <uid>:<gid>, got %q\", stage.name, stage.user)","+\t\t\t\tassert.NotContains(t, []string{\"\", \"0\", \"root\"}, uid, \"stage %s: user\", stage.name)","+\t\t\t\tassert.NotContains(t, []string{\"\", \"0\", \"root\"}, gid, \"stage %s: group\", stage.name)","+\t\t\t}","+\t\t})","+\t}","+}","+","+// parseDockerStages returns the final USER of each build stage, with the","+// stage's own ARG defaults substituted.","+func parseDockerStages(dockerfile string) []dockerStage {","+\tvar stages []dockerStage","+\targs := make(map[string]string)","+\tfor _, line := range strings.Split(dockerfile, \"\\n\") {","+\t\tfields := strings.Fields(line)","+\t\tif len(fields) < 2 {","+\t\t\tcontinue","+\t\t}","+\t\tswitch strings.ToUpper(fields[0]) {","+\t\tcase \"FROM\":","+\t\t\tstages = append(stages, dockerStage{name: fields[len(fields)-1]})","+\t\t\targs = make(map[string]string)","+\t\tcase \"ARG\":","+\t\t\tif name, value, ok := strings.Cut(fields[1], \"=\"); ok {","+\t\t\t\targs[name] = value","+\t\t\t}","+\t\tcase \"USER\":","+\t\t\tif len(stages) > 0 {","+\t\t\t\tstages[len(stages)-1].user = os.Expand(fields[1], func(name string) string { return args[name] })","+\t\t\t}","+\t\tdefault:","+\t\t\t// No other instruction affects the user a stage runs as.","+\t\t}","+\t}","+\treturn stages","+}"],"additions":79,"deletions":0,"truncated":false},{"path":"cmd/remote-storage/Dockerfile","lines":["@@ -9,15 +9,17 @@ ARG SVC=remote-storage"," FROM $base_image AS release"," ARG TARGETARCH"," ARG USER_UID=10001","+ARG USER_GID=10001"," COPY remote-storage-linux-$TARGETARCH /go/bin/remote-storage-linux"," EXPOSE 16686/tcp"," ENTRYPOINT [\"/go/bin/remote-storage-linux\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"," "," FROM $debug_image AS debug"," ARG TARGETARCH=amd64"," ARG USER_UID=10001","+ARG USER_GID=10001"," COPY remote-storage-debug-linux-$TARGETARCH /go/bin/remote-storage-linux"," EXPOSE 12345/tcp 16686/tcp"," ENTRYPOINT [\"/go/bin/dlv\", \"exec\", \"/go/bin/remote-storage-linux\", \"--headless\", \"--listen=:12345\", \"--api-version=2\", \"--accept-multiclient\", \"--log\", \"--\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"],"additions":4,"deletions":2,"truncated":false},{"path":"cmd/tracegen/Dockerfile","lines":["@@ -4,7 +4,8 @@"," FROM scratch"," ARG TARGETARCH"," ARG USER_UID=10001","+ARG USER_GID=10001"," "," COPY tracegen-linux-$TARGETARCH /go/bin/tracegen-linux"," ENTRYPOINT [\"/go/bin/tracegen-linux\"]","-USER ${USER_UID}","+USER ${USER_UID}:${USER_GID}"],"additions":2,"deletions":1,"truncated":false},{"path":"internal/storage/v1/badger/docs/storage-file-non-root-permission.md","lines":["@@ -2,6 +2,8 @@"," "," After the release of 1.50, Jaeger's Docker image is no longer running with root privileges (in [#4783](https://github.com/jaegertracing/jaeger/pull/4783)). In some installations it may cause issues such as \"permission denied\" errors when writing data."," ","+The images also set a non-root primary group, so the process runs with uid `10001` and gid `10001` rather than gid `0`. A data directory that Jaeger could write only through group `0` (for example, after `chgrp 0` and `chmod g+w`) needs its owner changed as shown below.","+"," A possible workaround for this ([proposed here](https://github.com/jaegertracing/jaeger/issues/4906#issuecomment-1991779425)) is to run an initialization step as `root` that pre-creates the Badger data directory and updates its owner to the user that will run the main Jaeger process."," "," ```yaml",""],"additions":2,"deletions":0,"truncated":false}],"additions":97,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-08T16:17:06.217900+00:00"}