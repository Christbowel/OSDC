s_reconstruct_lookahead_block_hashes(lookahead: int):","+    block_size = 2","     manager = make_kv_cache_manager(","-        make_kv_cache_config(block_size, num_blocks=10),","+        make_kv_cache_config(block_size, num_blocks=20),","         max_model_len=8192,","         enable_caching=True,","-        use_eagle=True,","+        use_eagle=False,","+        num_hash_lookahead_tokens=lookahead,","         hash_block_size=block_size,","+        enable_kv_cache_events=True,","     )","-    # 2 full blocks + 5 tokens (non-divisible length)","-    token_ids = [0] * (2 * block_size + 5)","-    req = make_request(\"partial_block_test\", token_ids, block_size, sha256)","+    token_ids = list(range(2 * block_size + lookahead))","+    request = make_request(","+        \"request\",","+        token_ids,","+        block_size,","+        sha256,","+        num_hash_lookahead_tokens=lookahead,","+    )","+    assert manager.allocate_slots(request, request.num_tokens) is not None"," ","-    # Prime the cache","-    computed_blocks, _, _ = manager.get_computed_blocks(req)","-    manager.allocate_slots(","-        req, len(token_ids), len(computed_blocks.blocks[0]) * 16, computed_blocks","+    (event,) = manager.take_events()","+    assert isinstance(event, BlockStored)","+    assert event.block_hashes == [","+        kv_cache_utils.maybe_convert_block_hash(block_hash)","+        for block_hash in request.block_hashes","+    ]","+    assert event.token_ids == [0, 1, 2, 3]","+    assert event.lookahead_token_ids == [","+        token_ids[end : end + lookahead] for end in (2, 4)","+    ]","+    reconstructed_hashes = []","+    parent_hash = event.parent_block_hash","+    assert event.extra_keys is not None","+    for block_start, extra_keys, lookahead_token_ids in zip(","+        range(0, len(event.token_ids), block_size),","+        event.extra_keys,","+        event.lookahead_token_ids,","+        strict=True,","+    ):","+        parent_hash = kv_cache_utils.hash_block_tokens(","+            sha256,","+            parent_hash,","+            event.token_ids[block_start : block_start + block_size],","+            (extra_keys, *lookahead_token_ids),","+        )","+        reconstructed_hashes.append(parent_hash)","+    assert reconstructed_hashes == request.block_hashes","+","+","+@pytest.mark.parametrize(","+    \"lookahead,prompt_len,expected_boundary\",","+    [","+        (0, 1089, 1088),","+        (1, 1089, 1088),","+        (2, 1089, 1024),","+        (2, 1090, 1088),","+        (3, 1089, 1024),","+        (3, 1091, 1088),","+    ],","+)","+@pytest.mark.parametrize(\"checkpoint_blocks\", [0, 1])","+@pytest.mark.parametrize(\"full_block_size\", [64, 128])","+def test_lookahead_checkpoint_has_available_hash(","+    lookahead, prompt_len, expected_boundary, checkpoint_blocks, full_block_size","+):","+    \"\"\"Prefill checkpoints must be reusable at the boundary their hash proves.\"\"\"","+    config = _make_hybrid_kv_cache_config(64, 100, [\"full\", \"mamba\", \"full\"])","+    config.kv_cache_groups[0].kv_cache_spec = replace(","+        config.kv_cache_groups[0].kv_cache_spec, block_size=full_block_size","+    )","+    config.kv_cache_groups[1].kv_cache_spec = replace(","+        config.kv_cache_groups[1].kv_cache_spec,","+        block_size=512,","+        num_prefill_checkpoint_blocks=checkpoint_blocks,","+        prefill_checkpoint_alignment=64 if checkpoint_blocks else None,","+    )","+    config.kv_cache_groups[2].is_eagle_group = bool(lookahead)","+    manager = make_kv_cache_manager(","+        config,","+        max_model_len=4096,","+        enable_caching=True,","+        hash_block_size=64,","+        num_prefill_lookahead=lookahead,","+        num_hash_lookahead_tokens=lookahead,","     )","-    manager.free(req)","+    tokens = list(range(prompt_len))","+    request = make_request(","+        \"producer\", tokens, 64, sha256, num_hash_lookahead_tokens=lookahead","+    )","+    if not checkpoint_blocks:","+        assert manager.allocate_slots(request, expected_boundary) is not None","+        request.num_computed_tokens = expected_boundary","+        manager.new_step_starts()","+    assert manager.allocate_slots(request, len(tokens) - request.num_computed_tokens)","+    checkpoint_hash = request.block_hashes[expected_boundary // 64 - 1]","+    blocks = manager.block_pool.get_cached_block(checkpoint_hash, [1])","+    assert blocks is not None","+    assert blocks[0].block_hash_num_tokens == expected_boundary","+    if checkpoint_blocks:","+        offsets, cols = compute_mamba_prefill_checkpoints(","+            [prompt_len],","+            [prompt_len],","+            hash_block_size=64,","+            mamba_block_size=512,","+            checkpoint_alignment=64,","+            drop_eagle_block=False,","+            cache_hit_alignment_tokens=64,","+            num_hash_lookahead_tokens=lookahead,","+        )","+        assert offsets == [expected_boundary]","+        assert (","+            blocks[0].block_id == manager.get_block_ids(request.request_id)[1][cols[0]]","+        )"," ","-    # New request with Eagle enabled","-    req_eagle = make_request(\"partial_eagle\", token_ids, block_size, sha256)","-    computed_blocks, num_tokens, _ = manager.get_computed_blocks(req_eagle)","-    # Original match: 2 full blocks → Eagle removes 1 → 1 remaining","-    assert len(computed_blocks.blocks[0]) == 1","-    assert num_tokens == 1 * block_size","+    request.num_computed_tokens = len(tokens)","+    manager.free(request)","+    manager.new_step_starts()","+    replay = make_request(","+        \"replay\", tokens, 64, sha256, num_hash_lookahead_tokens=lookahead","+    )","+    _, hit_tokens, _ = manager.get_computed_blocks(replay)","+    assert hit_tokens == expected_boundary","+","+","+def test_eagle_hybrid_mamba_hits_partial_prompt_boundary():","+    hash_block_size = 16","+    mamba_block_size = 544","+    token_ids = list(range(1249))"],"additions":155,"deletions":40,"truncate