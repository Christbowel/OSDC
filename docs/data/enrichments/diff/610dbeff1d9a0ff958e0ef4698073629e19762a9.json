ny slice, whichever cluster it is on and whichever clusters hold slice-enabled indices.","+ */","+public class SliceCrossClusterSearchIT extends AbstractMultiClustersTestCase {","+","+    private static final String REMOTE = \"cluster_a\";","+    private static final String SLICED = \"tenants\";","+    private static final String PLAIN = \"reference\";","+    private static final Map<String, Integer> DOCS_PER_SLICE = Map.of(\"acme\", 4, \"globex\", 3);","+","+    @Override","+    protected List<String> remoteClusterAlias() {","+        return List.of(REMOTE);","+    }","+","+    @Override","+    protected Map<String, Boolean> skipUnavailableForRemoteClusters() {","+        return Map.of(REMOTE, false);","+    }","+","+    @Before","+    public void setupIndices() {","+        assumeTrue(\"slice indexing feature flag must be enabled\", SliceIndexing.SLICE_FEATURE_FLAG.isEnabled());","+        for (String cluster : List.of(LOCAL_CLUSTER, REMOTE)) {","+            createIndex(cluster, SLICED, true);","+            createIndex(cluster, PLAIN, false);","+        }","+    }","+","+    public void testSliceOnEveryCluster() throws Exception {","+        SearchRequest request = search(SLICED, REMOTE + \":\" + SLICED).searchSlice(\"acme\");","+        assertResponse(client(LOCAL_CLUSTER).search(request), response -> {","+            assertNoFailures(response);","+            assertThat(response.getHits().getHits().length, equalTo(2 * DOCS_PER_SLICE.get(\"acme\")));","+            for (SearchHit hit : response.getHits().getHits()) {","+                assertThat(hit.getId(), startsWith(\"acme-\"));","+            }","+        });","+    }","+","+    public void testSliceOnClusterWithoutSlicedIndex() throws Exception {","+        for (String[] indices : List.of(","+            new String[] { SLICED, REMOTE + \":\" + PLAIN },","+            new String[] { PLAIN, REMOTE + \":\" + SLICED },","+            new String[] { PLAIN, REMOTE + \":\" + PLAIN },","+            new String[] { REMOTE + \":\" + PLAIN }","+        )) {","+            SearchRequest request = search(indices).searchSlice(\"acme\");","+            int expected = List.of(indices).toString().contains(SLICED) ? DOCS_PER_SLICE.get(\"acme\") : 0;","+            assertResponse(client(LOCAL_CLUSTER).search(request), response -> {","+                assertNoFailures(response);","+                assertThat(List.of(indices).toString(), response.getHits().getHits().length, equalTo(expected));","+                for (SearchHit hit : response.getHits().getHits()) {","+                    assertThat(hit.getIndex(), equalTo(SLICED));","+                    assertThat(hit.getId(), startsWith(\"acme-\"));","+                }","+            });","+        }","+    }","+","+    private SearchRequest search(String... indices) {","+        SearchRequest request = new SearchRequest(indices).source(new SearchSourceBuilder().size(100));","+        request.setCcsMinimizeRoundtrips(randomBoolean());","+        request.allowPartialSearchResults(false);","+        return request;","+    }","+","+    private void createIndex(String cluster, String index, boolean sliced) {","+        Client client = client(cluster);","+        Settings.Builder settings = Settings.builder().put(\"index.number_of_shards\", randomIntBetween(1, 3));","+        if (sliced) {","+            settings.put(IndexSettings.SLICE_ENABLED.getKey(), true);","+        }","+        assertAcked(client.admin().indices().prepareCreate(index).setSettings(settings));","+        BulkRequestBuilder bulk = client.prepareBulk().setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE);","+        DOCS_PER_SLICE.forEach((slice, docs) -> {","+            for (int i = 0; i < docs; i++) {","+                IndexRequest doc = new IndexRequest(index).id(slice + \"-\" + i).source(\"position\", i);","+                // the documents of the plain index are routed with the slice name as a regular routing value","+                bulk.add(sliced ? doc.routing(slice).setRoutingFromSlice(true) : doc.routing(slice));","+            }","+        });","+        assertNoFailures(bulk.get());","+    }","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"server/src/internalClusterTest/java/org/elasticsearch/validate/SimpleValidateQueryIT.java","lines":["@@ -442,14 +442,14 @@ public void testNoSliceDefaultsToAllWhenSliceEnabledIndex() {","         assertTrue(response.isValid());","     }"," ","-    public void testSliceRejectedWhenSliceDisabledIndex() {","+    public void testSliceAcceptedWhenSliceDisabledIndex() {","         assumeTrue(\"slice indexing feature flag must be enabled\", SliceIndexing.SLICE_FEATURE_FLAG.isEnabled());","         createIndex(\"slice-disabled\");","         ensureGreen(\"slice-disabled\");"," ","         ValidateQueryRequest request = new ValidateQueryRequest(\"slice-disabled\").searchSlice(\"s1\");","-        IllegalArgumentException e = expectThrows(IllegalArgumentException.class, () -> indicesAdmin().validateQuery(request).actionGet());","-        assertThat(e.getMessage(), containsString(\"[_slice] is not allowed when [index.slice.enabled] is false\"));","+        ValidateQueryResponse response = indicesAdmin().validateQuery(request).actionGet();","+        assertTrue(response.isValid());","     }"," ","     public void testSliceValidateQuerySucceedsWhenSliceEnabledIndex() {"],"additions":3,"deletions":3,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/action/admin/cluster/shards/TransportClusterSearchShardsAction.java","lines":["@@ -166,8 +166,7 @@ static String validateAndResolveSliceRouting(","             request.routing(),","             requestedSlice,","             \"search shards request\",","-            target,","-            false","+            target","         );","     }"," }"],"additions":1,"deletions":2,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/action/admin/indices/validate/query/TransportValidateQueryAction.java","lines":[