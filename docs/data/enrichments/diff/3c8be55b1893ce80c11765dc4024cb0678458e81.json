","+        username = argv[1];","+","+        /* Release the home while it is being removed. The release is queued until the removal is complete,","+         * and must then get a reply instead of being left waiting until the call times out. */","+        ASSERT_OK(bus_call_method_async(bus, /* ret_slot= */ NULL, bus_home_mgr, \"RemoveHome\",","+                                        on_remove_reply, &remove_result, \"s\", username));","+        ASSERT_OK(sd_bus_flush(bus));","+","+        (void) bus_call_method(bus, bus_home_mgr, \"ReleaseHome\", &error, /* ret_reply= */ NULL, \"s\", username);","+        ASSERT_TRUE(sd_bus_error_has_name(&error, BUS_ERROR_NO_SUCH_HOME));","+","+        /* Wait for the removal itself to complete */","+        while (remove_result == 0) {","+                if (ASSERT_OK(sd_bus_process(bus, /* ret= */ NULL)) > 0)","+                        continue;","+","+                ASSERT_OK(sd_bus_wait(bus, UINT64_MAX));","+        }","+","+        ASSERT_EQ(remove_result, 1);","+","+        return 0;","+}","+","+DEFINE_MAIN_FUNCTION(run);"],"additions":61,"deletions":0,"truncated":false},{"path":"test/units/TEST-46-HOMED.sh","lines":["@@ -280,7 +280,11 @@ testcase_basic() {","     /usr/lib/systemd/tests/unit-tests/manual/test-homed-regression-31896 test-user"," ","     wait_for_state test-user inactive","-    homectl remove test-user","+    # The reference FIFO created by the test above must be removed together with the home","+    test -p /run/systemd/home/test-user.please-suspend","+    /usr/lib/systemd/tests/unit-tests/manual/test-homed-regression-44837 test-user","+    test ! -e /run/systemd/home/test-user.please-suspend","+    test ! -e /run/systemd/home/test-user.dont-suspend"," }"," "," testcase_recovery_key_file() (",""],"additions":5,"deletions":1,"truncated":false}],"additions":137,"deletions":14,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-20T18:00:14.406879+00:00"}