/** Binds {@link SessionWorkspacesEnabledContext} to its setting, without creating the workspaces service. */","+export class SessionWorkspacesContextKeys extends Disposable implements IWorkbenchContribution {","+","+\tstatic readonly ID = 'workbench.contrib.sessionWorkspacesContextKeys';","+","+\tconstructor(","+\t\t@IContextKeyService contextKeyService: IContextKeyService,","+\t\t@IConfigurationService configurationService: IConfigurationService,","+\t) {","+\t\tsuper();","+","+\t\tconst enabled = observableConfigValue(SESSIONS_WORKSPACES_ENABLED_SETTING, false, configurationService);","+\t\tthis._register(bindContextKey(SessionWorkspacesEnabledContext, contextKeyService, reader => enabled.read(reader)));","+\t}","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"src/vs/workbench/contrib/sessions/browser/sessionWorkspacesService.ts","lines":["@@ -0,0 +1,840 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { Limiter, RunOnceScheduler, Sequencer } from '../../../../base/common/async.js';","+import { VSBuffer } from '../../../../base/common/buffer.js';","+import { toErrorMessage } from '../../../../base/common/errorMessage.js';","+import { CancellationError } from '../../../../base/common/errors.js';","+import { Disposable, DisposableMap, DisposableStore } from '../../../../base/common/lifecycle.js';","+import { autorun, derived, IObservable, observableValue } from '../../../../base/common/observable.js';","+import { dirname, joinPath } from '../../../../base/common/resources.js';","+import { isObject } from '../../../../base/common/types.js';","+import { URI, UriComponents } from '../../../../base/common/uri.js';","+import { generateUuid } from '../../../../base/common/uuid.js';","+import { localize } from '../../../../nls.js';","+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';","+import { IEnvironmentService } from '../../../../platform/environment/common/environment.js';","+import { FileOperationError, FileOperationResult, FileSystemProviderCapabilities, FileSystemProviderErrorCode, IFileContent, IFileService, toFileSystemProviderErrorCode } from '../../../../platform/files/common/files.js';","+import { ILogService } from '../../../../platform/log/common/log.js';","+import { INotificationService } from '../../../../platform/notification/common/notification.js';","+import { observableConfigValue } from '../../../../platform/observable/common/platformObservableUtils.js';","+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';","+import { IUriIdentityService } from '../../../../platform/uriIdentity/common/uriIdentity.js';","+import { hasWorkspaceFileExtension } from '../../../../platform/workspace/common/workspace.js';","+import { isRecentWorkspace, IWorkspacesService } from '../../../../platform/workspaces/common/workspaces.js';","+import { SESSIONS_WORKSPACES_ENABLED_SETTING } from '../common/sessionConfig.js';","+import { ISessionWorkspaceFileContent, ISessionWorkspaceFileEdit, SessionWorkspaceFile } from '../common/sessionWorkspaceFile.js';","+import { IRecentSessionWorkspace, ISessionWorkspaceAppearance, ISessionWorkspaceRemoveOptions, ISessionWorkspacesService, ISessionWorkspaceUpdate, SessionWorkspaceError } from '../common/sessionWorkspaces.js';","+import { ISessionsRecentWorkspacesService } from './sessionsRecentWorkspacesService.js';","+","+const STORAGE_KEY_WORKSPACES = 'sessions.workspaces';","+const STORAGE_KEY_FORGOTTEN_WORKSPACE_FILES = 'sessions.forgottenRecentWorkspaceFiles';","+const MAX_MANAGED_WORKSPACES = 50;","+const MAX_RECENT_WORKSPACE_FILES = 20;","+const MAX_WORKSPACE_FILE_SIZE = 1024 * 1024;","+const MAX_CONCURRENT_READS = 4;","+const OWNED_WORKSPACES_FOLDER = 'AgentsWorkspaces';","+","+interface IStoredWorkspace {","+\treadonly uri: UriComponents;","+\treadonly name: string;","+\treadonly folders: readonly UriComponents[];","+\treadonly owned: boolean;","+\t/** The icon and color shown, as last read from or written to the workspace file. */","+\treadonly icon?: string;","+\treadonly color?: string;","+\t/** The icon and color kept on this computer: for a standalone folder, or when they could not be written to the file. */","+\treadonly local?: ISessionWorkspaceAppearance;","+\treadonly previousUris?: readonly UriComponents[];","+}","+","+export class SessionWorkspacesService extends Disposable implements ISessionWorkspacesService {","+","+\tdeclare readonly _serviceBrand: undefined;","+","+\treadonly enabled: IObservable<boolean>;","+","+\tprivate readonly _managedWorkspaces = observableValue<readonly IRecentSessionWorkspace[]>(this, []);","+\treadonly managedWorkspaces: IObservable<readonly IRecentSessionWorkspace[]> = this._managedWorkspaces;","+","+\t/** The comparison keys of the recent workspace files that the user removed. */","+\tprivate readonly _forgottenWorkspaceFiles = observableValue<ReadonlySet<string>>(this, new Set());","+","+\treadonly recentWorkspaceFiles: IObservable<readonly IRecentSessionWorkspace[]> = derived(this, reader => {","+\t\tif (!this.enabled.read(reader)) {","+\t\t\treturn [];","+\t\t}","+\t\tconst extUri = this.uriIdentityService.extUri;","+\t\tconst managed = this._managedWorkspaces.read(reader);","+\t\tconst forgotten = this._forgottenWorkspaceFiles.read(reader);","+\t\treturn this.recentWorkspacesService.vsCodeRecentWorkspaceFiles.read(reader)","+\t\t\t.filter(file =>","+\t\t\t\t// A workspace file of one folder is listed as that folder already","+\t\t\t\tfile.folders.length > 1","+\t\t\t\t// VS Code's untitled workspaces are its own scratch files","+\t\t\t\t&& !extUri.isEqualOrParent(file.uri, this.untitledWorkspacesHome)","+\t\t\t\t&& !forgotten.has(extUri.getComparisonKey(file.uri))","+\t\t\t\t&& !managed.some(workspace => extUri.isEqual(workspace.uri, file.uri) || workspace.previousUris?.some(previous => extUri.isEqual(previous, file.uri)))","+\t\t\t\t// The folders of a remote VS Code window, which no session can work in here","+\t\t\t\t&& file.folders.every(folder => this.fileService.hasProvider(folder)))","+\t\t\t.slice(0, MAX_RECENT_WORKSPACE_FILES)","+\t\t\t.map(file => this._withAppearance({ uri: file.uri, name: file.name, folders: [...file.folders], owned: false }, file));","+\t});","+","+\treadonly workspaces: IObservable<readonly IRecentSessionWorkspace[]> = derived(this, reader => [...this._managedWorkspaces.read(reader), ...this.recentWorkspaceFiles.read(reader)]);","+","+\tprivate readonly ownedWorkspacesHome: URI;","+\tprivate readonly untitledWorkspacesHome: URI;","+\tprivate readonly _workspaceFile: SessionWorkspaceFile;","+","+\t/** The icon and color kept on this computer, by comparison key; the workspace file's own icon and color win over them. */","+\tprivate _localAppearance = new Map<string, ISessionWorkspaceAppearance>();","+\tprivate readonly _fileWatchers = this._register(new DisposableMap<string>());","+\t/** The comparison keys of the workspace files that changed on disk since they were last read. */","+\tprivate readonly _changedFiles = new Set<string>();","+\t/** Refreshes run one after another, so that an older read never wins over a newer one. */","+\tprivate readonly _refreshes = new Sequencer();","+\t/**","+\t * Creates and updates run one after another, since each one decides from the workspaces that the one before it left,","+\t * for example that a standalone folder still needs a workspace file. Removing is not queued behind them: an update in","+\t * progress keeps a workspace that is removed meanwhile removed (see {@link _removals}), and an update still waiting","+\t * for a workspace that is removed meanwhile is dropped.","+\t */","+\tprivate readonly _mutations = new Sequencer();","+\tprivate _queuedMutations = 0;","+\t/**","+\t * The URIs that workspaces had before a queued create or update moved them, for example a standalone folder that got a","+\t * workspace file, by their comparison keys, so that an update queued meanwhile with the URI it had follows it.","+\t * Cleared when no create or update is queued.","+\t */","+\tprivate readonly _movedUris = new Map<string, URI>();","+\tprivate readonly _refreshScheduler = this._register(new RunOnceScheduler(() => {","+\t\tconst changed = new Set(this._changedFiles);","+\t\tthis._changedFiles.clear();","+\t\tvoid this._refreshes.queue(() => this._refresh(changed));","+\t}, 300));","+\t/** When each workspace was last removed, by the comparison keys of its URIs, so that an update finishing after its workspace was removed does not add it again. */","+\tprivate readonly _removedAt = new Map<string, number>();","+\tprivate _removals = 0;","+","+\tconstructor(","+\t\t@IFileService private readonly fileService: IFileService,","+\t\t@IStorageService private readonly storageService: IStorageService,","+\t\t@IUriIdentityService private readonly uriIdentityService: IUriIdentityService,","+\t\t@IEnvironmentService environmentService: IEnvironmentService,","+\t\t@IConfigurationService configurationService: IConfigurationService,","+\t\t@ILogService private readonly logService: ILogService,","+\t\t@ISessionsRecentWorkspacesService private readonly recentWorkspacesService: ISessionsRecentWorkspacesService,","+\t\t@INotificationService private readonly notificationService: INotificationService,","+\t\t@IWorkspacesService private readonly workspacesService: IWorkspacesService,","+\t) {","+\t\tsuper();","+","+\t\tthis._workspaceFile = new SessionWorkspaceFile(uriIdentityService.extUri);","+\t\tthis.untitledWorkspacesHome = environmentService.untitledWorkspacesHome;","+\t\tthis.ownedWorkspacesHome = joinPath(dirname(environmentService.untitledWorkspacesHome), OWNED_WORKSPACES_FOLDER);","+\t\tthis.enabled = observableConfigValue(SESSIONS_WORKSPACES_ENABLED_SETTING, false, configurationService);","+","+\t\tthis._managedWorkspaces.set(this._readStorage(), undefined);","+\t\t// Other windows of the profile share the catalogue","+\t\tthis._register(this.storageService.onDidChangeValue(StorageScope.PROFILE, STORAGE_KEY_WORKSPACES, this._store)(e => {","+\t\t\tif (e.external) {","+\t\t\t\tthis._managedWorkspaces.set(this._readStorage(), undefined);","+\t\t\t}","+\t\t}));","+\t\tthis._forgottenWorkspaceFiles.set(this._readForgottenWorkspaceFiles(), undefined);","+\t\tthis._register(this.storageService.onDidChangeValue(StorageScope.PROFILE, STORAGE_KEY_FORGOTTEN_WORKSPACE_FILES, this._store)(e => {","+\t\t\tif (e.external) {","+\t\t\t\tthis._forgottenWorkspaceFiles.set(this._readForgottenWorkspaceFiles(), undefined);","+\t\t\t}","+\t\t}));","+","+\t\t// Workspace files are read and watched only while workspaces are enabled","+\t\tthis._register(autorun(reader => {","+\t\t\tif (this.enabled.read(reader)) {","+\t\t\t\tvoid this.refresh();","+\t\t\t}","+\t\t}));","+\t\tthis._register(autorun(reader => this._watchWorkspaceFiles(this.enabled.read(reader) ? this._managedWorkspaces.read(reader) : [])));","+\t}","+","+\tgetWorkspace(uri: URI): IRecentSessionWorkspace | undefined {","+\t\treturn this._getManagedWorkspace(uri) ?? this.recentWorkspaceFiles.get().find(file => this.uriIdentityService.extUri.isEqual(file.uri, uri));","+\t}","+","+\tasync resolveWorkspaceFile(workspaceFile: URI): Promise<IRecentSessionWorkspace> {","+\t\tconst managed = this._getManagedWorkspace(workspaceFile);","+\t\tlet parsed: ISessionWorkspaceFileContent;","+\t\ttry {","+\t\t\tparsed = await this._readWorkspaceFile(workspaceFile, await this._getRemoteAuthorities());","+\t\t} catch (error) {","+\t\t\t// What is known about a managed workspace file stays, rather than folders that may be on another computer","+\t\t\tif (this._isFoldersUnknownError(error) && managed && this.uriIdentityService.extUri.isEqual(managed.uri, workspaceFile)) {","+\t\t\t\treturn managed;","+\t\t\t}","+\t\t\tthrow error;","+\t\t}","+\t\tconst local = this._localAppearance.get(this.uriIdentityService.extUri.getComparisonKey(workspaceFile));","+\t\treturn this._withAppearance({","+\t\t\turi: workspaceFile,","+\t\t\tname: parsed.name,","+\t\t\tfolders: parsed.folders,","+\t\t\towned: managed?.owned ?? this._isOwnedWorkspaceFile(workspaceFile),","+\t\t\t...(managed?.previousUris ? { previousUris: managed.previousUris } : {}),","+\t\t}, this._displayAppearance(parsed, local));","+\t}","+","+\tcreateWorkspace(name: string, folders: readonly URI[], appearance?: ISessionWorkspaceAppearance): Promise<IRecentSessionWorkspace> {","+\t\treturn this._queueMutation(() => this._createWorkspace(name, folders, appearance));","+\t}","+","+\tprivate _queueMutation<T>(mutation: () => Promise<T>): Promise<T> {","+\t\tthis._queuedMutations++;","+\t\treturn this._mutations.queue(async () => {","+\t\t\ttry {","+\t\t\t\treturn await mutation();","+\t\t\t} finally {","+\t\t\t\tif (--this._queuedMutations === 0) {","+\t\t\t\t\tthis._movedUris.clear();","+\t\t\t\t}","+\t\t\t}","+\t\t});","+\t}","+","+\t/** The URI that a workspace has now, which a create or update queued before may have moved from `uri`. */","+\tprivate _currentUri(uri: URI): URI {","+\t\tconst extUri = this.uriIdentityService.extUri;","+\t\tif (this._managedWorkspaces.get().some(workspace => extUri.isEqual(workspace.uri, uri))) {","+\t\t\treturn uri;","+\t\t}","+\t\treturn this._movedUris.get(extUri.getComparisonKey(uri)) ?? uri;","+\t}","+","+\tprivate async _createWorkspace(name: string, folders: readonly URI[], appearance: ISessionWorkspaceAppearance | undefined): Promise<IRecentSessionWorkspace> {","+\t\tconst workspace = await this._create(name, folders, appearance);","+\t\tthis._upsert(workspace);","+\t\treturn workspace;","+\t}","+","+\t/** Creates a standalone folder for one folder, and an owned workspace file, with its icon and color, for several. */","+\tprivate async _create(name: string, folders: readonly URI[], appearance: ISessionWorkspaceAppearance | undefined): Promise<IRecentSessionWorkspace> {","+\t\tif (!folders.length) {","+\t\t\tthrow new Error(localize('workspaceWithoutFolders', \"A workspace needs at least one folder.\"));","+\t\t}","+\t\tif (folders.length === 1) {","+\t\t\tthis._setLocalAppearance(folders[0], appearance);","+\t\t\treturn this._withAppearance({ uri: folders[0], name, folders: [folders[0]], owned: true }, appearance);","+\t\t}","+\t\tconst uri = joinPath(this.ownedWorkspacesHome, generateUuid(), this._workspaceFile.toFileName(name));","+\t\tconst content = this._workspaceFile.stringify(uri, { name, folders, icon: appearance?.icon ?? null, color: appearance?.color ?? null }, { forceAbsolute: true });","+\t\tawait this.fileService.writeFile(uri, VSBuffer.fromString(content));","+\t\tthis._setLocalAppearance(uri, undefined);","+\t\treturn this._withAppearance({ uri, name, folders: [...folders], owned: true }, appearance);","+\t}","+","+\tupdateWorkspace(uri: URI, update: ISessionWorkspaceUpdate): Promise<IRecentSessionWorkspace> {","+\t\tconst removals = this._removals;","+\t\treturn this._queueMutation(async () => {","+\t\t\tconst current = this._currentUri(uri);","+\t\t\t// A workspace removed while its update waited stays removed, and its file is not written again","+\t\t\tif (this._removedSince([uri, current], removals)) {","+\t\t\t\tthrow new CancellationError();","+\t\t\t}","+\t\t\treturn this._updateWorkspace(current, update, removals);","+\t\t});","+\t}","+","+\t/**","+\t * @param removals The count of removals when the update was asked for, so that a workspace removed since is not","+\t * added again.","+\t */","+\tprivate async _updateWorkspace(uri: URI, update: ISessionWorkspaceUpdate, removals: number): Promise<IRecentSessionWorkspace> {","+\t\tconst extUri = this.uriIdentityService.extUri;"