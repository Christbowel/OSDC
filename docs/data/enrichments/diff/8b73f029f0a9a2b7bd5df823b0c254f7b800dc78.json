{"id":"8b73f029f0a9a2b7bd5df823b0c254f7b800dc78","axis":"silent","repo":"dotnet/runtime","sha":"8b73f029f0a9a2b7bd5df823b0c254f7b800dc78","parsed":{"files":[{"path":"src/libraries/System.Net.Security/src/Resources/Strings.resx","lines":["@@ -341,6 +341,9 @@","   <data name=\"net_ssl_read_bio_failed_error\" xml:space=\"preserve\">","     <value>SSL Read BIO failed with OpenSSL error - {0}.</value>","   </data>","+  <data name=\"net_ssl_read_client_hello_failed\" xml:space=\"preserve\">","+    <value>The TLS ClientHello could not be read from the socket.</value>","+  </data>","   <data name=\"net_ssl_tlssession_context_not_set\" xml:space=\"preserve\">","     <value>The session has no TlsContext assigned. Call SetContext with a client or server TlsContext before invoking this operation.</value>","   </data>"],"additions":3,"deletions":0,"truncated":false},{"path":"src/libraries/System.Net.Security/src/System/Net/Security/TlsSession.OpenSsl.cs","lines":["@@ -156,7 +156,9 @@ partial void TryPeekClientHello(ref TlsOperationStatus? result)","                 }","                 if (rc < 0)","                 {","-                    throw new IOException(SR.net_ssl_read_bio_failed_error);","+                    // EOF, a recv() error, a record larger than the peek buffer, bad arguments or","+                    // allocation failure. None of these pushes an OpenSSL error, so there is none to report.","+                    throw new IOException(SR.net_ssl_read_client_hello_failed);","                 }"," ","                 ReadOnlySpan<byte> frame = new ReadOnlySpan<byte>(framePtr, frameLen);"],"additions":3,"deletions":1,"truncated":false},{"path":"src/libraries/System.Net.Security/tests/FunctionalTests/TlsSessionTests.cs","lines":["@@ -4290,6 +4290,73 @@ public async Task SocketBoundSession_GetClientHelloBytes_ReturnsWireBytes()","             Assert.Equal(serverName, session.TargetHostName);","         }"," ","+        public enum ClientHelloPeekFailure","+        {","+            PeerClosed,","+            PeerReset,","+            OversizedRecord,","+        }","+","+        // A socket-bound server session peeks the ClientHello off the socket before OpenSSL","+        // takes it over. When the peer closes or resets the connection before a full record","+        // arrives, or announces a record larger than the peek buffer, the peek fails with an","+        // IOException whose message must be complete (no unformatted placeholder).","+        [Theory]","+        [InlineData(ClientHelloPeekFailure.PeerClosed)]","+        [InlineData(ClientHelloPeekFailure.PeerReset)]","+        [InlineData(ClientHelloPeekFailure.OversizedRecord)]","+        [PlatformSpecific(TestPlatforms.Linux)]","+        public async Task SocketBoundServerSession_ClientHelloPeekFails_ThrowsIOExceptionWithMessage(ClientHelloPeekFailure failure)","+        {","+            using X509Certificate2 serverCert = TestCertificates.GetServerCertificate();","+","+            using Socket listener = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);","+            listener.Bind(new IPEndPoint(IPAddress.Loopback, 0));","+            listener.Listen(1);","+            int port = ((IPEndPoint)listener.LocalEndPoint!).Port;","+","+            using Socket clientUnderlying = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);","+            Task connect = clientUnderlying.ConnectAsync(IPAddress.Loopback, port);","+            using Socket serverSocket = await listener.AcceptAsync();","+            await connect;","+            serverSocket.Blocking = false;","+","+            using TlsContext ctx = TlsContext.CreateServer(new SslServerAuthenticationOptions","+            {","+                ServerCertificate = serverCert,","+                EnabledSslProtocols = SslProtocols.Tls12 | SslProtocols.Tls13,","+            });","+            using TlsSocketSession session = NewSocketSession(ctx, serverSocket.SafeHandle);","+","+            switch (failure)","+            {","+                case ClientHelloPeekFailure.PeerClosed:","+                    clientUnderlying.Shutdown(SocketShutdown.Send);","+                    break;","+                case ClientHelloPeekFailure.PeerReset:","+                    clientUnderlying.LingerState = new LingerOption(true, 0);","+                    clientUnderlying.Close();","+                    break;","+                case ClientHelloPeekFailure.OversizedRecord:","+                    // Handshake record header announcing a 65535-byte fragment.","+                    clientUnderlying.Send(new byte[] { 0x16, 0x03, 0x01, 0xFF, 0xFF });","+                    break;","+            }","+","+            IOException ex = Assert.Throws<IOException>(() =>","+            {","+                for (int i = 0; i < 10; i++)","+                {","+                    Assert.Equal(TlsOperationStatus.NeedMoreData, session.Handshake());","+                    Assert.True(serverSocket.Poll(30_000_000, SelectMode.SelectRead));","+                }","+            });","+","+            // No OpenSSL call failed, so the message must not claim an OpenSSL error.","+            Assert.DoesNotContain(\"{0}\", ex.Message);","+            Assert.DoesNotContain(\"OpenSSL\", ex.Message);","+        }","+","         [Fact]","         public void ClientSession_GetClientHelloBytes_Throws()","         {",""],"additions":67,"deletions":0,"truncated":false}],"additions":73,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-19T15:01:08.485069+00:00"}