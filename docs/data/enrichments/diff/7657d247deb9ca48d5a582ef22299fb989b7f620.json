 String INVALID_SELECTOR = \"{\";","+","+    public void testInstantQuery() throws IOException {","+        assertParsedOnlyOnceAuthorized(","+            \"/_prometheus/api/v1/query\",","+            new BasicNameValuePair(\"query\", INVALID_QUERY),","+            new BasicNameValuePair(\"time\", START)","+        );","+    }","+","+    /** A string literal reads no index, but is still only answered to a caller that may run ES|QL. */","+    public void testInstantQueryStringLiteral() throws IOException {","+        var params = new NameValuePair[] { new BasicNameValuePair(\"query\", \"\\\"a string\\\"\"), new BasicNameValuePair(\"time\", START) };","+        assertThat(status(prometheusGetRequest(\"/_prometheus/api/v1/query\", writeApiKey, params)), equalTo(403));","+        var response = ObjectPath.createFromResponse(","+            client().performRequest(prometheusGetRequest(\"/_prometheus/api/v1/query\", readApiKey, params))","+        );","+        assertThat(response.evaluate(\"data.resultType\"), equalTo(\"string\"));","+        assertThat(response.evaluate(\"data.result.1\"), equalTo(\"a string\"));","+    }","+","+    public void testRangeQuery() throws IOException {","+        assertParsedOnlyOnceAuthorized(","+            \"/_prometheus/api/v1/query_range\",","+            new BasicNameValuePair(\"query\", INVALID_QUERY),","+            new BasicNameValuePair(\"start\", START),","+            new BasicNameValuePair(\"end\", END),","+            new BasicNameValuePair(\"step\", \"1m\")","+        );","+    }","+","+    public void testQueryExemplars() throws IOException {","+        assertParsedOnlyOnceAuthorized(","+            \"/_prometheus/api/v1/query_exemplars\",","+            new BasicNameValuePair(\"query\", INVALID_QUERY),","+            new BasicNameValuePair(\"start\", START),","+            new BasicNameValuePair(\"end\", END)","+        );","+    }","+","+    /** A string literal selects no series, but its empty exemplars are still only returned to a caller that may run ES|QL. */","+    public void testQueryExemplarsStringLiteral() throws IOException {","+        var params = new NameValuePair[] {","+            new BasicNameValuePair(\"query\", \"\\\"a string\\\"\"),","+            new BasicNameValuePair(\"start\", START),","+            new BasicNameValuePair(\"end\", START) };","+        assertThat(status(prometheusGetRequest(\"/_prometheus/api/v1/query_exemplars\", writeApiKey, params)), equalTo(403));","+        var response = ObjectPath.createFromResponse(","+            client().performRequest(prometheusGetRequest(\"/_prometheus/api/v1/query_exemplars\", readApiKey, params))","+        );","+        assertThat(response.evaluate(\"status\"), equalTo(\"success\"));","+        assertThat(response.evaluate(\"data\"), equalTo(List.of()));","+    }","+","+    public void testSeries() throws IOException {","+        assertParsedOnlyOnceAuthorized(\"/_prometheus/api/v1/series\", new BasicNameValuePair(\"match[]\", INVALID_SELECTOR));","+    }","+","+    public void testLabels() throws IOException {","+        assertParsedOnlyOnceAuthorized(\"/_prometheus/api/v1/labels\", new BasicNameValuePair(\"match[]\", INVALID_SELECTOR));","+    }","+","+    public void testLabelValues() throws IOException {","+        assertParsedOnlyOnceAuthorized(\"/_prometheus/api/v1/label/job/values\", new BasicNameValuePair(\"match[]\", INVALID_SELECTOR));","+    }","+","+    private void assertParsedOnlyOnceAuthorized(String path, NameValuePair... params) throws IOException {","+        assertThat(\"refused before the query is parsed\", status(prometheusGetRequest(path, writeApiKey, params)), equalTo(403));","+        assertThat(\"the query is parsed once authorized\", status(prometheusGetRequest(path, readApiKey, params)), equalTo(400));","+    }","+","+    private static int status(Request request) throws IOException {","+        ResponseException e = expectThrows(ResponseException.class, () -> client().performRequest(request));","+        return e.getResponse().getStatusLine().getStatusCode();","+    }","+}"],"additions":106,"deletions":0,"truncated":false},{"path":"x-pack/plugin/prometheus/src/main/java/org/elasticsearch/xpack/prometheus/rest/PrometheusInstantQueryRestAction.java","lines":["@@ -7,6 +7,7 @@"," "," package org.elasticsearch.xpack.prometheus.rest;"," ","+import org.elasticsearch.action.ActionListener;"," import org.elasticsearch.client.internal.node.NodeClient;"," import org.elasticsearch.core.TimeValue;"," import org.elasticsearch.logging.LogManager;","@@ -19,7 +20,6 @@"," import org.elasticsearch.rest.ServerlessScope;"," import org.elasticsearch.xpack.esql.core.tree.Source;"," import org.elasticsearch.xpack.esql.parser.promql.PromqlParserUtils;","-import org.elasticsearch.xpack.prometheus.rest.PromqlQueryPlanBuilder.PromqlStatementResult;"," "," import java.time.Instant;"," import java.util.List;","@@ -100,32 +100,32 @@ private RestChannelConsumer prepareQuery(RestRequest request, NodeClient client)","             ? PromqlParserUtils.parseDate(Source.EMPTY, timeStr)","             : Instant.now();"," ","-        PromqlStatementResult result = PromqlQueryPlanBuilder.buildStatement(","-            query,","+        var esqlRequest = new PromqlQueryRequest(","             index,","-            evaluationTime,","-            PrometheusQueryResponseListener.QueryMode.INSTANT","+            () -> PromqlQueryPlanBuilder.buildStatement(query, index, evaluationTime, PrometheusQueryResponseListener.QueryMode.INSTANT),","+            query,","+            LIMIT_PARAM,","+            limit == DEFAULT_LIMIT ? null : limit","         );","-        if (result.stringValue() != null) {","-            // a string literal: the response is the literal itself, no statement runs","-            String value = result.stringValue();","-            return channel -> channel.sendResponse(","-                new RestResponse(RestStatus.OK, PrometheusQueryResponseListener.buildStringResult(eval