e.ConstantTimeCompare([]byte(provided), []byte(expected)) != 1 {","+\t\treturn httperror.Forbidden(\"Invalid or missing setup token. Provide the X-Setup-Token header with the token printed in the server logs at startup.\", errInvalidSetupToken)","+\t}","+","+\treturn nil","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"api/http/security/setuptoken/setuptoken_test.go","lines":["@@ -0,0 +1,46 @@","+package setuptoken","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func Test_Generate(t *testing.T) {","+\ttoken, err := Generate()","+\trequire.NoError(t, err)","+\tassert.Len(t, token, 64, \"hex-encoded 32 bytes should be 64 characters\")","+","+\ttoken2, err := Generate()","+\trequire.NoError(t, err)","+\tassert.NotEqual(t, token, token2, \"two generated tokens should differ\")","+}","+","+func Test_Validate_alwaysPassesWhenExpectedEmpty(t *testing.T) {","+\tr := httptest.NewRequest(http.MethodPost, \"/\", nil)","+\tassert.Nil(t, Validate(r, \"\"))","+}","+","+func Test_Validate_missingHeader(t *testing.T) {","+\tr := httptest.NewRequest(http.MethodPost, \"/\", nil)","+\therr := Validate(r, \"secret\")","+\trequire.NotNil(t, herr)","+\tassert.Equal(t, http.StatusForbidden, herr.StatusCode)","+}","+","+func Test_Validate_wrongToken(t *testing.T) {","+\tr := httptest.NewRequest(http.MethodPost, \"/\", nil)","+\tr.Header.Set(HeaderName, \"wrong\")","+\therr := Validate(r, \"secret\")","+\trequire.NotNil(t, herr)","+\tassert.Equal(t, http.StatusForbidden, herr.StatusCode)","+}","+","+func Test_Validate_correctToken(t *testing.T) {","+\tr := httptest.NewRequest(http.MethodPost, \"/\", nil)","+\tr.Header.Set(HeaderName, \"secret\")","+\tassert.Nil(t, Validate(r, \"secret\"))","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"api/http/server.go","lines":["@@ -115,6 +115,7 @@ type Server struct {"," \tPlatformService  