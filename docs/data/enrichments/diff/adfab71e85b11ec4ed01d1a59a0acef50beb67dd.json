ckResolvedValue(true);","+      fallbackSecondary.stub._get.mockResolvedValue(null);","+      thirdPersistence.stub._isAvailable.mockResolvedValue(true);","+      thirdPersistence.stub._get.mockResolvedValue(null);","+","+      const out = await PersistenceUserManager.create(auth, [","+        fallbackSecondary.persistence,","+        brokenPrimary.persistence,","+        thirdPersistence.persistence","+      ]);","+","+      expect(out.persistence).toBe(fallbackSecondary.persistence);","+      expect(await out.getCurrentUser()).toBeNull();","+      // Never delete from a store we couldn't read, while still cleaning readable non-selected stores","+      expect(brokenPrimary.stub._remove).not.toHaveBeenCalled();","+      expect(thirdPersistence.stub._remove).toHaveBeenCalledTimes(1);","+    });","+","+    it('keeps persistence with user when _shouldAllowMigration is true but no other migration target is available', async () => {","+      const a = makePersistence(PersistenceType.LOCAL, true);","+      const user = testUser(auth, 'existing-local-uid');","+","+      // Simulate #10540 with single [indexedDBLocalPersistence] where readwrite (_isAvailable)","+      // fails due to a suspended background tab, while readonly (_get) still succeeds.","+      a.stub._isAvailable.mockResolvedValue(false);","+      a.stub._get.mockResolvedValue(user.toJSON());","+","+      const out = await PersistenceUserManager.create(auth, [a.persistence]);","+      // Should keep `a.persistence` rather than polluting the shared inMemoryPersistence singleton","+      expect(out.persistence).toBe(a.persistence);","+      expect((await out.getCurrentUser())?.uid).toBe('existing-local-uid');","+    });","+","+    it('reads user via _get before probing _isAvailable so a readwrite probe cannot block readonly user discovery (#10540)', async () => {","+      const a = makePersistence(PersistenceType.LOCAL, true);","+      const b = makePersistence(PersistenceType.LOCAL, true);","+      const user =