rows for unparsable blob (wrong format)","           }","-          if (persistence !== selectedPersistence) {","-            userToMigrate = user;","-          }","-          selectedPersistence = persistence;","+          foundUser = user;","+          foundPersistence = persistence;","           break;","         }","       } catch {}","     }"," ","+    // Eliminate any persistences that are not available","+    const availablePersistences = (","+      await Promise.all(","+        persistenceHierarchy.map(async persistence => {","+          try {","+            if (await persistence._isAvailable()) {","+              return persistence;","+            }","+            if (persistence._lastProbeTimedOut) {","+              unreadablePersistences.add(persistence);","+            }","+          } catch {","+            return undefined;","+          }","+          return undefined;","+        })","+      )","+    ).filter(persistence => persistence) as PersistenceInternal[];","+","+    // Fall back to the first persistence listed, or in memory if none available","+    let selectedPersistence =","+      availablePersistences[0] ||","+      _getInstance<PersistenceInternal>(inMemoryPersistence);","+","+    let userToMigrate: UserInternal | null = null;","+    if (foundPersistence && foundUser) {","+      if (foundPersistence !== selectedPersistence) {","+        userToMigrate = foundUser;","+      }","+      selectedPersistence = foundPersistence;","+    }","+","     // If we find the user in a persistence that does support migration, use","     // that migration path (of only persistences that support migration)","     const migrationHierarchy = availablePersistences.filter(","@@ -216,11 +233,16 @@ export class PersistenceUserManager {","       await selectedPersistence._set(key, userToMigrate.toJSON());","     }"," ","-    // Attempt to clear the key in other persistences but ignore errors. This helps prevent issues","-    // such as users getting stuck with a previous account after signing out and refreshing the tab.","+    // Attempt to clear the key in other persistences (except those whose _get threw or whose","+    // _isAvailable() probe timed out, so we never delete from a store we couldn't read or that","+    // is blocked by another tab) and ignore errors. This helps prevent issues such as users","+    // getting stuck with a previous account after signing out and refreshing the tab.","     await Promise.all(","       persistenceHierarchy.map(async persistence => {","-        if (persistence !== selectedPersistence) {","+        if (","+          persistence !== selectedPersistence &&","+          !unreadablePersistences.has(persistence)","+        ) {","           try {","             await persistence._remove(key);","           } catch {}"],"additions":57,"deletions":35,"truncated":false},{"path":"packages/auth/src/platform_browser/persistence/indexed_db.test.ts","lines":["@@ -18,6 +18,12 @@"," import { FakeServiceWorker } from '../../../test/helpers/fake_service_worker';"," import { testAuth, testUser } from '../../../test/helpers/mock_auth';"," import { PersistenceInternal, PersistenceType } from '../../core/persistence';","+import {","+  _persistenceKeyName,","+  KeyName,","+  PersistenceUserManager","+} from '../../core/persistence/persistence_user_manager';","+import { browserLocalPersistence } from './local_storage';"," import {","   SingletonInstantiator,","   _getInstance","@@ -143,6 +149,217 @@ describe('platform_browser/persistence/indexed_db', () => {","       expect(await persistence._isAvailable()).toBe(true);","       expect((indexedDB.open as MockInstance).mock.calls.length).toBe(3);","     });","+","+    it('should time out without retrying and close late connection if indexedDB.open hangs', async () => {","+      (persistence as any).dbPromise = null;","+      let successCallback: (() => void) | undefined;","+      const fakeDbClose = vi.fn();","+      const fakeRequest: any = {","+        result: { close: fakeDbClose },","+        addEventListener(evt: string, cb: () => void) {","+          if (evt === 'success') {","+            successCallback = cb;","+          }","+        }","+      };","+      vi.spyOn(indexedDB, 'open').mockReturnValue(fakeRequest);","+","+      expect(await persistence._isAvailable()).toBe(false);","+      // Should not retry on timeout","+      expect((indexedDB.open as MockInstance).mock.calls.length).toBe(1);","+","+      // If the hung open request eventually succeeds after timeout, it must close the leaked connection","+      expect(successCallback).toBeDefined();","+      successCallback!();","+      expect(fakeDbClose).toHaveBeenCalledTimes(1);","+    });","+","+    it('should time out, abort blocked transaction, and return false if readwrite transaction hangs due to a suspended tab', async () => {","+      (persistence as any).dbPromise = null;","+      const abortSpy = vi.fn();","+      const fakeDb: any = {","+        close: vi.fn(),","+        transaction: () => ({","+          objectStore: () => ({","+            put: () => ({","+              transaction: { abort: abortSpy },","+              addEventListener: () => {}","+            })","+          })","+        })","+      };","+","+      vi.spyOn(persistence as any, '_openDb').mockResolvedValue(fakeDb);","+","+      expect(await persistence._isAvailable()).toBe(false);","+      expect(abortSpy).toHaveBeenCalledTimes(1);","+      expect(fakeDb.close).toHaveBeenCalledTimes(1);","+    });","+","+    it('should unblock PersistenceUserManager.create and preserve user when a suspended background tab blocks readwrite transactions (#10540)', async () => {","+      const auth = await testAuth();","+      const user = testUser(auth, 'tab-a-signed-in-uid');","+      const userKey = _persistenceKeyName(","+        KeyName.AUTH_USER,","+        auth.config.apiKey,","+        auth.name","+      );","+      const fallbackLocal = _getInstance<PersistenceInternal>(","+        browser