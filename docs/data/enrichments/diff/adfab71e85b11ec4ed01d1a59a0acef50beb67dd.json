er = await PersistenceUserManager.create(auth, [","+          persistence","+        ]);","+        expect(abortSpy).toHaveBeenCalledTimes(1);","+        // Stop background polling before testing getCurrentUser() so in-flight 800ms _poll()","+        // timers from step 3 don't fire during step 4's abortSpy assertions","+        singleManager.delete();","+        // Keeps indexedDBLocalPersistence and returns the user (cached in localCache during initial _get","+        // before _isAvailable queued a readwrite lock) even when subsequent getCurrentUser() times out!","+        expect(singleManager.persistence).toBe(persistence);","+        expect((await singleManager.getCurrentUser())?.uid).toBe(","+          'tab-a-signed-in-uid'","+        );","+","+        // 4. Reset simulated lock queue for fresh Tab B2 with [indexedDBLocalPersistence, browserLocalPersistence]","+        abortSpy.mockClear();","+        readWriteQueuedInBrowser = false;","+        delete (persistence as any).localCache[userKey];","+        const multiManager = await PersistenceUserManager.create(auth, [","+          persistence,","+          fallbackLocal","+        ]);","+","+        // Verify Tab B2 read the user via readonly _get before _isAvailable queued a readwrite lock,","+        // migrated the user to browserLocalPersistence, skipped _remove on the unavailable","+        // indexedDBLocalPersistence, and preserved the signed-in user!","+        expect(abortSpy).toHaveBeenCalledTimes(1);","+        expect(multiManager.persistence).toBe(fallbackLocal);","+        expect((await multiManager.getCurrentUser())?.uid).toBe(","+          'tab-a-signed-in-uid'","+        );","+        multiManager.delete();","+      } finally {","+        vi.restoreAllMocks();","+        await persistence._remove(userKey);","+        await fallbackLocal._remove(userKey);","+      }","+    });","+","+    it('should retain indexedDBLocalPersistence and preserve user when cold indexedDB.open takes 1.2s (> _DB_PROB