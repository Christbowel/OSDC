{"id":"47e939f0659072a9f91c80fcaa5fd92b02633244","axis":"silent","repo":"rails/rails","sha":"47e939f0659072a9f91c80fcaa5fd92b02633244","parsed":{"files":[{"path":"activesupport/CHANGELOG.md","lines":["@@ -1,3 +1,15 @@","+*   Raise `ActiveSupport::EncryptedFile::InvalidKeyLengthError` when reading","+    with a key of the wrong length, not only when writing.","+","+    A key that lost its last character could still decrypt the file if that","+    character was a `0`, so `EncryptedFile#read` and `EncryptedConfiguration`","+    accepted it while `#write` raised. Reading now raises","+    `InvalidKeyLengthError` for all keys of the wrong length, including keys","+    that are two or more characters short, which used to raise OpenSSL's","+    `ArgumentError`. With comma-separated keys, each key is checked.","+","+    *Dennis Paagman*","+"," *   Don't show the encryption key in `ActiveSupport::EncryptedFile#inspect`."," ","     Previously the key, read from the key file or environment variable, was"],"additions":12,"deletions":0,"truncated":false},{"path":"activesupport/lib/active_support/encrypted_file.rb","lines":["@@ -67,6 +67,7 @@ def key?","     # - MissingKeyError if the key is missing and `raise_if_missing_key` is true.","     # - MissingContentError if the encrypted file does not exist or otherwise","     #   if the key is missing.","+    # - InvalidKeyLengthError if the key does not have the expected length.","     # - ActiveSupport::MessageEncryptor::InvalidMessage if the content cannot be","     #   decrypted or verified.","     def read","@@ -109,7 +110,6 @@ def writing(contents)"," "," ","       def encrypt(contents)","-        check_key_length","         encryptor.encrypt_and_sign contents","       end"," ","@@ -119,9 +119,9 @@ def decrypt(contents)"," ","       def encryptor","         @encryptor ||= begin","-          keys = key.split(\",\")","-          encryptor = ActiveSupport::MessageEncryptor.new([ keys.shift ].pack(\"H*\"), cipher: CIPHER, serializer: Marshal)","-          keys.each { |key| encryptor.rotate([ key ].pack(\"H*\")) }","+          primary_key, *rotated_keys = encryption_keys","+          encryptor = ActiveSupport::MessageEncryptor.new(primary_key, cipher: CIPHER, serializer: Marshal)","+          rotated_keys.each { |rotated_key| encryptor.rotate(rotated_key) }","           encryptor","         end","       end","@@ -139,8 +139,14 @@ def handle_missing_key","         raise MissingKeyError.new(key_path: key_path, env_key: env_key) if raise_if_missing_key","       end"," ","-      def check_key_length","-        raise InvalidKeyLengthError if key&.length != self.class.expected_key_length","+      def encryption_keys","+        keys = key.to_s.split(\",\")","+","+        if keys.empty? || keys.any? { |k| k.length != self.class.expected_key_length }","+          raise InvalidKeyLengthError","+        end","+","+        keys.map { |k| [ k ].pack(\"H*\") }","       end","   end"," end"],"additions":12,"deletions":6,"truncated":false},{"path":"activesupport/test/encrypted_configuration_test.rb","lines":["@@ -11,10 +11,7 @@ class EncryptedConfigurationTest < ActiveSupport::TestCase","     @credentials_key_path = File.join(@tmpdir, \"master.key\")","     File.write(@credentials_key_path, ActiveSupport::EncryptedConfiguration.generate_key)"," ","-    @credentials = ActiveSupport::EncryptedConfiguration.new(","-      config_path: @credentials_config_path, key_path: @credentials_key_path,","-      env_key: \"RAILS_MASTER_KEY\", raise_if_missing_key: true","-    )","+    @credentials = new_credentials","   end"," ","   teardown do","@@ -129,6 +126,13 @@ class EncryptedConfigurationTest < ActiveSupport::TestCase","     end","   end"," ","+  test \"raises InvalidKeyLengthError when the key has the wrong length\" do","+    @credentials.write({ something: { good: true } }.to_yaml)","+    File.write(@credentials_key_path, File.read(@credentials_key_path).chop)","+","+    assert_raise(ActiveSupport::EncryptedFile::InvalidKeyLengthError) { new_credentials.config }","+  end","+","   test \"raises key error when accessing config via bang method\" do","     assert_raise(KeyError) { @credentials.something! }","   end","@@ -200,4 +204,12 @@ class EncryptedConfigurationTest < ActiveSupport::TestCase","   test \"optional missing key with default block returning nil returns nil\" do","     assert_nil @credentials.option(:missing, default: -> { nil })","   end","+","+  private","+    def new_credentials","+      ActiveSupport::EncryptedConfiguration.new(","+        config_path: @credentials_config_path, key_path: @credentials_key_path,","+        env_key: \"RAILS_MASTER_KEY\", raise_if_missing_key: true","+      )","+    end"," end"],"additions":16,"deletions":4,"truncated":false},{"path":"activesupport/test/encrypted_file_test.rb","lines":["@@ -111,18 +111,53 @@ class EncryptedFileTest < ActiveSupport::TestCase","   end"," ","   test \"raise InvalidKeyLengthError when key is too short\" do","-    File.write(@key_path, ActiveSupport::EncryptedFile.generate_key[0..-2])","+    @encrypted_file.write(@content)","+    File.write(@key_path, @key.chop)"," ","-    assert_raise ActiveSupport::EncryptedFile::InvalidKeyLengthError do","-      @encrypted_file.write(@content)","-    end","+    assert_raise(ActiveSupport::EncryptedFile::InvalidKeyLengthError) { encrypted_file(@content_path).read }","+    assert_raise(ActiveSupport::EncryptedFile::InvalidKeyLengthError) { encrypted_file(@content_path).write(@content) }","   end"," ","   test \"raise InvalidKeyLengthError when key is too long\" do","-    File.write(@key_path, ActiveSupport::EncryptedFile.generate_key + \"0\")","+    @encrypted_file.write(@content)","+    File.write(@key_path, @key + \"0\")","+","+    assert_raise(ActiveSupport::EncryptedFile::InvalidKeyLengthError) { encrypted_file(@content_path).read }","+    assert_raise(ActiveSupport::EncryptedFile::InvalidKeyLengthError) { encrypted_file(@content_path).write(@content) }","+  end","+","+  test \"key? does not raise when the key has the wrong length\" do","+    File.write(@key_path, @key.chop)","+","+    assert_nothing_raised do","+      assert_predicate encrypted_file(@content_path), :key?","+    end","+  end","+","+  test \"reading and writing with comma-separated env keys\" do","+    FileUtils.rm_rf @key_path","+    old_key = ActiveSupport::EncryptedFile.generate_key","+","+    ENV[\"CONTENT_KEY\"] = old_key","+    encrypted_file(@content_path).write(@content)","+","+    ENV[\"CONTENT_KEY\"] = \"#{@key},#{old_key}\"","+    assert_equal @content, encrypted_file(@content_path).read","+","+    encrypted_file(@content_path).write(@content)","+    ENV[\"CONTENT_KEY\"] = @key","+    assert_equal @content, encrypted_file(@content_path).read","+  end","+","+  test \"raise InvalidKeyLengthError when one of the comma-separated env keys has the wrong length\" do","+    FileUtils.rm_rf @key_path","+    ENV[\"CONTENT_KEY\"] = @key","+    @encrypted_file.write(@content)","+","+    ENV[\"CONTENT_KEY\"] = \"#{@key},#{@key.chop}\""," ","     assert_raise ActiveSupport::EncryptedFile::InvalidKeyLengthError do","-      @encrypted_file.write(@content)","+      encrypted_file(@content_path).read","     end","   end"," "],"additions":41,"deletions":6,"truncated":false},{"path":"railties/CHANGELOG.md","lines":["@@ -1,3 +1,14 @@","+*   Show a readable error in `credentials:edit`, `credentials:show`,","+    `credentials:fetch`, `encrypted:edit` and `encrypted:show` when the key has","+    the wrong length.","+","+    `credentials:edit` and `encrypted:edit` now fail before opening the","+    editor, instead of failing when saving and losing the changes.","+    `credentials:diff` prints the encrypted file, as it does when decryption","+    fails for other reasons.","+","+    *Dennis Paagman*","+"," *   Fix `db:system:change` to update Dockerfile packages for current and older","     generated applications."," "],"additions":11,"deletions":0,"truncated":false},{"path":"