er-state checks.\").Get()) * time.Second"," "," type stat struct {"," \tname  string","@@ -108,7 +114,8 @@ func GetUpdateStatusStats(localHostAddr string, adminPort uint16) (*Stats, error"," \t}"," "," \thostPort := net.JoinHostPort(localHostAddr, strconv.Itoa(int(adminPort)))","-\tstats, err := http.DoHTTPGet(fmt.Sprintf(\"http://%s/stats?usedonly&filter=%s\", hostPort, updateStatsRegex))","+\tupdateURL := fmt.Sprintf(\"http://%s/stats?usedonly&filter=%s\", hostPort, updateStatsRegex)","+\tstats, err := http.DoHTTPGetWithTimeout(updateURL, readinessTimeout)"," \tif err != nil {"," \t\treturn nil, err"," \t}"],"additions":9,"deletions":2,"truncated":false},{"path":"pilot/cmd/pilot-agent/status/util/stats_test.go","lines":["@@ -0,0 +1,113 @@","+// Copyright Istio Authors","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package util","+","+import (","+\t\"fmt\"","+\t\"net\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"strconv\"","+\t\"testing\"","+\t\"time\"","+","+\t\"istio.io/istio/pkg/test\"","+)","+","+const (","+\treadyStatsBody = `server.state: 0","+listener_manager.workers_started: 1","+`","+\tupdateStatsBody = `cluster_manager.cds.update_success: 1","+cluster_manager.cds.update_rejected: 0","+listener_manager.lds.update_success: 1","+listener_manager.lds.update_rejected: 0","+`","+)","+","+// newStatsServer starts a test server that serves the given body after an optional delay,","+// and returns its host and admin port for use with the stats helpers.","+func newStatsServer(t test.Failer, body string, delay time.Duration) (string, uint16) {","+\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tif delay > 0 {","+\t\t\ttime.Sleep(delay)","+\t\t}","+\t\tfmt.Fprint(w, body)","+\t}))","+\tt.Cleanup(srv.Close)","+","+\tu, err := url.Parse(srv.URL)","+\tif err != nil {","+\t\tt.Fatalf(\"failed to parse test server URL %q: %v\", srv.URL, err)","+\t}","+\thost, portStr, err := net.SplitHostPort(u.Host)","+\tif err != nil {","+\t\tt.Fatalf(\"failed to split host/port from %q: %v\", u.Host, err)","+\t}","+\tport, err := strconv.ParseUint(portStr, 10, 16)","+\tif err != nil {","+\t\tt.Fatalf(\"failed to parse port %q: %v\", portStr, err)","+\t}","+\treturn host, uint16(port)","+}","+","+func TestGetReadinessStats(t *testing.T) {","+\thost, port := newStatsServer(t, readyStatsBody, 0)","+","+\tstate, workersStarted, err := GetReadinessStats(host, port)","+\tif err != nil {","+\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t}","+\tif state == nil || *state != 0 {","+\t\tt.Fatalf(\"expected server state 0 (LIVE), got %v\", state)","+\t}","+\tif !workersStarted {","+\t\tt.Fatal(\"expected workers to be started\")","+\t}","+}","+","+func TestGetUpdateStatusStats(t *testing.T) {","+\thost, port := newStatsServer(t, updateStatsBody, 0)","+","+\ts, err := GetUpdateStatusStats(host, port)","+\tif err != nil {","+\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t}","+\tif s.CDSUpdatesSuccess != 1 || s.LDSUpdatesSuccess != 1 {","+\t\tt.Fatalf(\"unexpected update stats: %s\", s.String())","+\t}","+}","+","+// TestReadinessTimeout verifies that both readiness helpers honor the configurable","+// readinessTimeout, which is overridable via the PROXY_READINESS_PROBE_TIMEOUT_SECONDS env var.","+func TestReadinessTimeout(t *testing.T) {","+\t// Shrink the timeout well below the server delay so the request is guaranteed to time out.","+\ttest.SetForTest(t, &readinessTimeout, 50*time.Millisecond)","+","+\tt.Run(\"GetReadinessStats\", func(t *testing.T) {","+\t\thost, port := newStatsServer(t, readyStatsBody, 500*time.Millisecond)","+\t\tif _, _, err := GetReadinessStats(host, port); err == nil {","+\t\t\tt.Fatal(\"expected timeout error, got nil\")","+\t\t}","+\t})","+","+\tt.Run(\"GetUpdateStatusStats\", func(t *testing.T) {","+\t\thost, port := newStatsServer(t, updateStatsBody, 500*time.Millisecond)","+\t\tif _, err := GetUpdateStatusStats(host, port); err == nil {","+\t\t\tt.Fatal(\"expected timeout error, got nil\")","+\t\t}","+\t})","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"pkg/kube/inject/inject_test.go","lines":["@@ -206,6 +206,7 @@ func TestInjection(t *testing.T) {"," \t\t\t\t`values.global.proxy.readinessInitialDelaySeconds=100`,"," \t\t\t\t`values.global.proxy.readinessPeriodSeconds=200`,"," \t\t\t\t`values.global.proxy.readinessFailureThreshold=300`,","+\t\t\t\t`values.global.proxy.readinessTimeoutSeconds=5`,"," \t\t\t},"," \t\t},"," \t\t{"],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/kube/inject/testdata/inject/status_annotations.yaml","lines":["@@ -14,6 +14,7 @@ spec:","         readiness.status.sidecar.istio.io/initialDelaySeconds: \"100\"","         readiness.status.sidecar.istio.io/periodSeconds: \"200\"","         readiness.status.sidecar.istio.io/failureThreshold: \"300\"","+        readiness.status.sidecar.istio.io/timeoutSeconds: \"5\"","         readiness.status.sidecar.istio.io/applicationPorts: \"1,2,3\"","       labels:","         app: status"],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/kube/inject/testdata/inject/status_annotations.yaml.injected","lines":["@@ -21,6 +21,7 @@ spec:","         readiness.status.sidecar.istio.io/failureThreshold: \"300\"","         readiness.status.sidecar.istio.io/initialDelaySeconds: \"100\"","         readiness.status.sidecar.istio.io/periodSeconds: \"200\"","+        readiness.status.sidecar.istio.io/timeoutSeconds: \"5\"","         sidecar.istio.io/status: '{\"initContainers\":[\"istio-init\",\"istio-proxy\"],\"containers\":null,\"volumes\":[\"workload-socket\",\"credential-socket\",\"workload-certs\",\"istio-envoy\",\"istio-data\",\"istio-podinfo\",\"istio-token\",\"istiod-ca-cert\",\"istio-ca-crl\"],\"imagePullSecrets\":null,\"revision\":\"default\"}'","         status.sidecar.istio.io/port: \"123\"","       labels:","@@ -126,6 +127,8 @@ spec:","             ]","         - name: ISTIO_META_APP_CONTAINERS","           value: status","+        - name: PROXY_READINESS_PROBE_TIMEOUT_SECONDS","+          value: \"5\"","         - name: GOMEMLIMIT","           valueFrom:","             resourceFieldRef:","@@ -169,7 +172,7 @@ spec:","             port: 15021","           initialDelaySeconds: 100","           periodSeconds: 200","-          timeoutSeconds: 3","+          timeoutSeconds: 5","         resources:","           limits:","             cpu: \"2\"","@@ -194,7 +197,7 @@ spec:","             path: /healthz/ready","             port: 15021","           periodSeconds: 1","-          timeoutSeconds: 3","+          timeoutSeconds: 5","         volumeMounts:","         - mountPath: /var/run/secrets/workload-spiffe-uds","           name: workload-socket"],"additions":5,"deletions":2,"truncated":false},{"path":"pkg/kube/inject/testdata/inject/status_params.yaml.injected","lines":["@@ -121,6 +121,8 @@ spec:","             ]","         - name: ISTIO_META_APP_CONTAINERS","           value: status","+        - name: PROXY_READINESS_PROBE_TIMEOUT_SECONDS","+          value: \"5\"","         - name: GOMEMLIMIT","           valueFrom:","             resourceFieldRef:","@@ -164,7 +166,7 @@ spec:","             port: 15021","           initialDelaySeconds: 100","           periodSeconds: 200","-          timeoutSeconds: 3","+          timeoutSeconds: 5","         resources:","           limits:","             cpu: \"2\"","@@ -189,7 +191,7 @@ spec:","             path: /healthz/ready","             port: 15021","           periodSeconds: 1","-          timeoutSeconds: 3","+          timeoutSeconds: 5","         volumeMounts:","         - mountPath: /var/run/secrets/workload-spiffe-uds","           name: workload-socket"],"additions":4,"deletions":2,"truncated":false},{"path":"releasenotes/notes/proxy-readiness-probe-timeout.yaml","lines":["@@ -0,0 +1,12 @@","+apiVersion: release-notes/v2","+kind: feature","+area: traffic-management","+releaseNotes:","+- |","+    **Added** the `global.proxy.readinessTimeoutSeconds` Helm value and the","+    `readiness.status.sidecar.istio.io/timeoutSeconds` annotation to configure the proxy readiness","+    probe timeout. The injected probe `timeoutSeconds` and the `PROXY_READINESS_PROBE_TIMEOUT_SECONDS`","+    environment variable of the proxy are both set from it, so the timeout of the readiness checks","+    the pilot-agent issues against the Envoy admin endpoint stays aligned with the Kubernetes probe.","+    This timeout now applies uniformly to both the config-status and server-state checks. The","+    default is `3s` (previously the config-status check used a fixed `1s` timeout).",""],"additions":12,"deletions":0,"truncated":false}],"additions":191,"deletions":16,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-18T16:51:19.432937+00:00"}