       // We know this because inference fields cannot be declared under a nested field. Therefore, the nested scope for knn filter queries","+        // is the root scope.","+        for (QueryBuilder filter : originalQuery.filterQueries()) {","+            innerKnnQuery.addFilterQuery(new RootScopedQueryBuilder(filter));","+        }"," ","         return QueryBuilders.nestedQuery(SemanticTextField.getChunksFieldName(getField()), innerKnnQuery, ScoreMode.Max)","             .boost(originalQuery.boost())"],"additions":7,"deletions":1,"truncated":false},{"path":"x-pack/plugin/inference/src/main/java/org/elasticsearch/xpack/inference/queries/LegacySemanticKnnVectorQueryRewriteInterceptor.java","lines":["@@ -23,6 +23,14 @@"," import java.util.List;"," import java.util.Map;"," ","+/**","+ * Legacy knn query rewrite interceptor for semantic_text fields.","+ * <p>","+ * Knn filters on nested fields do not work with this interceptor, because the filters are built in the chunks nested scope instead of","+ * the root scope (see <a href=\"https://github.com/elastic/elasticsearch/issues/162043\">#162043</a>).","+ * {@link InterceptedInferenceKnnVectorQueryBuilder} fixes this with {@link RootScopedQueryBuilder}, but that fix cannot be applied here:","+ * this interceptor runs entirely on the coordinator node, and the fix must be applied on the data node.","+ */"," @Deprecated"," public class LegacySemanticKnnVectorQueryRewriteInterceptor extends LegacySemanticQueryRewriteInterceptor {"," "],"additions":8,"deletions":0,"truncated":false},{"path":"x-pack/plugin/inference/src/main/java/org/elasticsearch/xpack/inference/queries/RootScopedQueryBuilder.java","lines":["@@ -0,0 +1,121 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearc