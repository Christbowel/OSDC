.fused_moe.modular_kernel as mk","+from tests.kernels.moe.utils import make_dummy_moe_config"," from vllm.model_executor.layers.activation import SiluAndMul","+from vllm.model_executor.layers.fused_moe.config import (","+    FusedMoEParallelConfig,","+    FusedMoEQuantConfig,","+)"," from vllm.model_executor.layers.fused_moe.experts.flashinfer_cutedsl_batched_moe import (  # noqa: E501","+    FlashInferCuteDSLBatchedExperts,","     flashinfer_cutedsl_moe_masked,","+    flashinfer_cutedsl_mxfp8_moe_masked,","+    swizzle_mxfp8_moe_weight_scales,","+)","+from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","+    dequant_mxfp8_to_bf16,","+    mxfp8_e4m3_quantize,","+)","+from vllm.model_executor.layers.quantization.utils.quant_utils import (","+    kMxfp8Dynamic,","+    kMxfp8Static,"," )"," from vllm.utils.flashinfer import (","     flashinfer_cutedsl_grouped_gemm_nt_masked as cutedsl_gmm_masked,","@@ -521,6 +540,160 @@ def test_flashinfer_cutedsl_moe_masked(","     )"," "," ","+@pytest.mark.parametrize(","+    \"num_experts, max_m, hidden_dim, inter_dim\",","+    [(8, 64, 256, 128), (16, 128, 512, 384)],","+)","+@torch.inference_mode()","+def test_flashinfer_cutedsl_mxfp8_moe_masked(","+    num_experts: int, max_m: int, hidden_dim: int, inter_dim: int","+):","+    torch.manual_seed(42)","+    device = \"cuda\"","+    hidden_states = torch.randn(","+        num_experts, max_m, hidden_dim, dtype=torch.bfloat16, device=device","+    )","+    # Empty, partially filled and full experts.","+    masked_m = torch.randint(","+        0, max_m + 1, (num_experts,), dtype=torch.int32, device=device","+    )","+    masked_m[0], masked_m[-1] = 0, max_m","+    w1 = torch.randn(","+        num_experts, 2 * inter_dim, hidden_dim, dtype=torch.bfloat16, device=device","+    ) / (hidden_dim**0.5)","+    w2 = torch.randn(","+        num_experts, hidden_dim, inter_dim, dtype=torch.bfloat16, device=device","+    ) / (inter_dim**0.5)","+    w1_fp8, w1_scale = mxfp8_e4m3_quantize(w1)","+    w2_fp8, w2_scale = mxfp8_e4m3_quantize(w2)","+    w1_fp8 = w1_fp8.view(num_experts, 2 * inter_dim, hidden_dim)","+    w1_scale = w1_scale.view(num_experts, 2 * inter_dim, hidden_dim // 32)","+    w2_fp8 = w2_fp8.view(num_experts, hidden_dim, inter_dim)","+    w2_scale = w2_scale.view(num_experts, hidden_dim, inter_dim // 32)","+","+    out = torch.empty_like(hidden_states)","+    flashinfer_cutedsl_mxfp8_moe_masked(","+        hidden_states,","+        w1_fp8,","+        swizzle_mxfp8_moe_weight_scales(w1_scale),","+        w2_fp8,","+        swizzle_mxfp8_moe_weight_scales(w2_scale),","+        masked_m,","+        torch.empty(","+            num_experts, max_m, 2 * inter_dim, dtype=torch.bfloat16, device=device","+        ),","+        out,","+    )","+","+    # reference: both GEMM inputs are MXFP8 quantize-dequantized and the gate/up","+    # output is rounded to bf16, as in the kernel.","+    w1_ref = dequant_mxfp8_to_bf16(w1_fp8, w1_scale).float()","+    w2_ref = dequant_mxfp8_to_bf16(w2_fp8, w2_scale).float()","+    for i, m in enumerate(masked_m.tolist()):","+        if m == 0:","+            continue","+        x_q, x_s = mxfp8_e4m3_quantize(hidden_states[i, :m])","+        gate_up = dequant_mxfp8_to_bf16(x_q, x_s.view(m, -1)).float() @ w1_ref[i].T","+        gate_up = gate_up.to(torch.bfloat16)","+        act = F.silu(gate_up[:, :inter_dim].float()) * gate_up[:, inter_dim:]","+        act_q, act_s = mxfp8_e4m3_quantize(act.to(torch.bfloat16))","+        ref = dequant_mxfp8_to_bf16(act_q, act_s.view(m, -1)).float() @ w2_ref[i].T","+        torch.testing.assert_close(out[i, :m], ref.to(out.dtype), atol=3e-2, rtol=5e-2)","+","+","+@pytest.mark.parametrize(","+    \"overrides, supported\",","+    [","+        pytest.param({}, True, id=\"supported\"),","+        pytest.param({\"has_bias\": True}, False, id=\"bias\"),","+        pytest.param({\"swiglu_limit\": 7.0}, False, id=\"swiglu_limit\"),","+        pytest.param({\"swiglu_alpha\": 1.702}, False, id=\"swiglu_alpha\"),","+        pytest.param({\"swiglu_beta\": 1.0}, False, id=\"swiglu_beta\"),","+        pytest.param({\"hidden_dim\": 192}, False, id=\"unaligned_hidden\"),","+        pytest.param({\"intermediate_size\": 192}, False, id=\"unaligned_inter\"),","+    ],","+)","+def test_flashinfer_cutedsl_batched_mxfp8_supported_config(","+    overrides: dict, supported: bool","+):","+    \"\"\"MXFP8 needs plain SiLU-and-mul without expert biases, and 128-aligned","+    hidden and intermediate sizes.\"\"\"","+    overrides = dict(overrides)","+    moe_config = make_dummy_moe_config(","+        hidden_dim=overrides.pop(\"hidden_dim\", 256),","+        intermediate_size=overrides.pop(\"intermediate_size\", 128),","+    )","+    moe_config.moe_parallel_config = dataclasses.replace(","+        FusedMoEParallelConfig.make_no_parallel(),","+        dp_size=2,","+        ep_size=2,","+        use_ep=True,","+        all2all_backend=\"deepep_low_latency\",","+    )","+    for name, value in overrides.items():","+        setattr(moe_config, name, value)","+","+    result, reason = FlashInferCuteDSLBatchedExperts.is_supported_config(","+        FlashInferCuteDSLBatchedExperts,","+        moe_config,","+        kMxfp8Static,","+        kMxfp8Dynamic,","+        mk.FusedMoEActivationFormat.BatchedExperts,","+    )","+    assert result == supported","+    if not supported:","+        assert reason is not None and \"mxfp8\" in reason","+","+","+@pytest.mark.parametrize(\"all2all_backend\", [\"deepep_low_latency\", \"nixl_ep\"])","+@torch.inference_mode()","+def test_batched_dispatch_keeps_mxfp8_activations_unquantized(all2all_backend: str):","+    \"\"\"The DeepEP low-latency and NIXL EP dispatches hand MXFP8 activations to","+    the experts in bfloat16, without scales.\"\"\"","+    num_experts, max_tokens, hidden_dim = 4, 16, 256","+    if all2all_backend == \"deepep_low_latency\":","+        pytest.importorskip(\"deep_ep\")","+        from vllm.model_executor.layers.fused_moe.prepare_finalize.deepep_ll import (  # noqa: E501","+            DeepEPLLPrepareAndFinalize,","+        )","+","+        prepare_finalize = DeepEPLLPrepareAndFinalize(","+            buffer=None, max_tokens_per_rank=max_tokens, num_dispatchers=2","+        )","+    else:","+        pytest.importorskip(\"nixl_ep\")","+        from vllm.model_executor.layers.fused_moe.prepare_finalize.nixl_ep import (","+            NixlEPPrepareAndFinalize,","+        )","+","+        prepare_finalize = NixlEPPrepareAndFinalize(","+            buffer=None,","+            max_tokens_per_rank=max_tokens,","+            num_dispatchers=2,","+            expert_capacity=num_experts,","+        )","+    quant_config = FusedMoEQuantConfig.make(","+        \"mxfp8\",","+        w1_scale=torch.ones(1, device=\"cuda\"),","+        w2_scale=torch.ones(1, device=\"cuda\"),","+        block_shape=[1, 32],","+        is_scale_swizzled=False,","+    )","+    x = torch.randn(","+        num_experts, max_tokens, hidden_dim, dtype=torch.bfloat16, device=\"cuda\"","+    )","+    expert_num_tokens = torch.tensor(","+        [0, 3, max_tokens, 7], dtype=torch.int32, device=\"cuda\"","+    )","+","+    out, scales = prepare_finalize._do_quant(","+        x, torch.bfloat16, quant_config, expert_num_tokens","+    )","+","+    assert scales is None","+    torch.testing.assert_close(out, x, atol=0, rtol=0)","+","+"," @pytest.mark.parametrize(","     \"bs, hidden_dim, inter_dim, topk\", [(2, 128, 256, 2), (16, 128, 512, 5)]"," )","@@ -583,4 +756,5 @@ def test_grouped_gemm_nt_masked("," "," if __name__ == \"__main__\":","     test_flashinfer_cutedsl_moe_masked(16, 128, 512, 4)","+    test_flashinfer_cutedsl_mxfp8_moe_masked(16, 128, 512, 384)","     test_grouped_gemm_nt_masked(16, 128, 512, 4)"],"additions":174,"deletions":0,"truncated":false},{"path":"vllm/config/kernel.py","lines":["@@ -349,7 +349,8 @@ class KernelConfig:","     - \"cutlass\": Use vLLM CUTLASS kernels","     - \"flashinfer_trtllm\": Use FlashInfer with TRTLLM-GEN kernels","     - \"flashinfer_cutlass\": Use FlashInfer with CUTLASS kernels","-    - \"flashinfer_cutedsl\": Use FlashInfer with CuteDSL kernels (FP4 only)","+    - \"flashinfer_cutedsl\": Use FlashInfer with CuteDSL kernels (NVFP4, and","+      MXFP8 with `--all2all-backend deepep_low_latency` or `nixl_ep`)","     - \"flashinfer_moe_ep_cutedsl\": Use FlashInfer's CuTeDSL MoE-EP","       mega-kernel with NVFP4 or MXFP4 weights on Blackwell (SM100/SM103,","       where MXFP4 checkpoints are requantized to NVFP4 at load, or SM107,"],"additions":2,"deletions":1,"truncated":false},{"path":"vllm/model_executor/layers/fused_moe/experts/flashinfer_cutedsl_batched_moe.py","lines":["@@ -17,6 +17,8 @@"," )"," from vllm.model_executor.layers.quantization.utils.quant_utils import (","     QuantKey,","+    kMxfp8Dynamic,","+    kMxfp8Static,","     kNvfp4Dynamic,","     kNvfp4Static,"," )","@@ -24,14 +26,25 @@"," from vllm.utils.flashinfer import (","     flashinfer_cutedsl_grouped_gemm_nt_masked,","     has_flashinfer_cutedsl_grouped_gemm_nt_masked,","+    mxfp8_grouped_quantize,","+    nvfp4_block_scale_interleave,","     scaled_fp4_grouped_quantize,","+    silu_and_mul_mxfp8_experts_quantize,","     silu_and_mul_scaled_nvfp4_experts_quantize,"," )","+from vllm.utils.math_utils import round_up"," "," logger = init_logger(__name__)"," "," "," class FlashInferCuteDSLBatchedExperts(mk.FusedMoEExpertsModular):","+    \"\"\"NVFP4 or MXFP8 (W8A8) experts on the batched activation format.","+","+    MXFP8 experts take the dispatched activations unquantized and quantize only","+    the valid rows of each expert; their weight scales must be swizzled at load","+    time with `swizzle_mxfp8_moe_weight_scales`.","+    \"\"\"","+","     def __init__(","         self,","         moe_config: FusedMoEConfig,","@@ -45,17 +58,20 @@ def __init__(","             max_num_tokens=max_num_tokens,","             num_dispatchers=num_dispatchers,","         )","-    