port (","+\t\"encoding/hex\"","+\t\"encoding/json\"","+\t\"fmt\"","+\t\"strconv\"","+","+\tcoltracepb \"go.opentelemetry.io/proto/otlp/collector/trace/v1\"","+\tcommonpb \"go.opentelemetry.io/proto/otlp/common/v1\"","+\tresourcepb \"go.opentelemetry.io/proto/otlp/resource/v1\"","+\ttracepb \"go.opentelemetry.io/proto/otlp/trace/v1\"","+)","+","+// ExportTraceServiceRequest corresponds to coltracepb.ExportTraceServiceRequest.","+type ExportTraceServiceRequest struct {","+\tResourceSpans []*ResourceSpans `json:\"resourceSpans,omitempty\"`","+}","+","+// ResourceSpans corresponds to tracepb.ResourceSpans.","+type ResourceSpans struct {","+\tResource   *Resource     `json:\"resource,omitempty\"`","+\tScopeSpans []*ScopeSpans `json:\"scopeSpans,omitempty\"`","+\tSchemaURL  string        `json:\"schemaUrl,omitempty\"`","+}","+","+// Resource corresponds to resourcepb.Resource.","+type Resource struct {","+\tAttributes             []*KeyValue  `json:\"attributes,omitempty\"`","+\tDroppedAttributesCount uint32       `json:\"droppedAttributesCount,omitempty\"`","+\tEntityRefs             []*EntityRef `json:\"entityRefs,omitempty\"`","+}","+","+// ScopeSpans corresponds to tracepb.ScopeSpans.","+type ScopeSpans struct {","+\tScope     *InstrumentationScope `json:\"scope,omitempty\"`","+\tSpans     []*Span               `json:\"spans,omitempty\"`","+\tSchemaURL string                `json:\"schemaUrl,omitempty\"`","+}","+","+// InstrumentationScope corresponds to tracepb.InstrumentationScope.","+type InstrumentationScope struct {","+\tName                   string      `json:\"name,omitempty\"`","+\tVersion                string      `json:\"version,omitempty\"`","+\tAttributes             []*KeyValue `json:\"attributes,omitempty\"`","+\tDroppedAttributesCount uint32      `json:\"droppedAttributesCount,omitempty\"`","+}","+","+// EntityRef corresponds to resourcepb.EntityRef.","+type EntityRef struct {","+\tSchemaURL       string   `json:\"schemaUrl,omitempty\"`","+\tType            string   `json:\"type,omitempty\"`","+\tIdKeys          []string `json:\"idKeys,omitempty\"`","+\tDescriptionKeys []string `json:\"descriptionKeys,omitempty\"`","+}","+","+// KeyValue corresponds to commonpb.KeyValue.","+type KeyValue struct {","+\tKey   string    `json:\"key\"`","+\tValue *AnyValue `json:\"value,omitempty\"`","+}","+","+// AnyValue corresponds to commonpb.AnyValue.","+type AnyValue struct {","+\tStringValue *string      `json:\"stringValue,omitempty\"`","+\tBoolValue   *bool        `json:\"boolValue,omitempty\"`","+\tIntValue    *Int64       `json:\"intValue,omitempty\"`","+\tDoubleValue *float64     `json:\"doubleValue,omitempty\"`","+\tArrayValue  *ArrayValue  `json:\"arrayValue,omitempty\"`","+\tKvlistValue *KvlistValue `json:\"kvlistValue,omitempty\"`","+\tBytesValue  []byte       `json:\"bytesValue,omitempty\"`","+}","+","+// ArrayValue corresponds to commonpb.ArrayValue.","+type ArrayValue struct {","+\tValues []*AnyValue `json:\"values,omitempty\"`","+}","+","+// KvlistValue corresponds to commonpb.KeyValueList.","+type KvlistValue struct {","+\tValues []*KeyValue `json:\"values,omitempty\"`","+}","+","+// Span corresponds to tracepb.Span.","+type Span struct {","+\tTraceID                TraceID     `json:\"traceId\"`","+\tSpanID                 SpanID      `json:\"spanId\"`","+\tTraceState             string      `json:\"traceState,omitempty\"`","+\tParentSpanID           *SpanID     `json:\"parentSpanId,omitempty\"`","+\tFlags                  uint32      `json:\"flags,omitempty\"`","+\tName                   string      `json:\"name,omitempty\"`","+\tKind                   int32       `json:\"kind,omitempty\"`","+\tStartTimeUnixNano      Uint64      `json:\"startTimeUnixNano,omitempty\"`","+\tEndTimeUnixNano        Uint64      `json:\"endTimeUnixNano,omitempty\"`","+\tAttributes             []*KeyValue `json:\"attributes,omitempty\"`","+\tDroppedAttributesCount uint32      `json:\"droppedAttributesCount,omitempty\"`","+\tEvents                 []*Event    `json:\"events,omitempty\"`","+\tDroppedEventsCount     uint32      `json:\"droppedEventsCount,omitempty\"`","+\tLinks                  []*Link     `json:\"links,omitempty\"`","+\tDroppedLinksCount      uint32      `json:\"droppedLinksCount,omitempty\"`","+\tStatus                 *Status     `json:\"status,omitempty\"`","+}","+","+// Event corresponds to tracepb.Span_Event.","+type Event struct {","+\tTimeUnixNano           Uint64      `json:\"timeUnixNano,omitempty\"`","+\tName                   string      `json:\"name,omitempty\"`","+\tAttributes             []*KeyValue `json:\"attributes,omitempty\"`","+\tDroppedAttributesCount uint32      `json:\"droppedAttributesCount,omitempty\"`","+}","+","+// Link corresponds to tracepb.Span_Link.","+type Link struct {","+\tTraceID                TraceID     `json:\"traceId\"`","+\tSpanID                 SpanID      `json:\"spanId\"`","+\tTraceState             string      `json:\"traceState,omitempty\"`","+\tAttributes             []*KeyValue `json:\"attributes,omitempty\"`","+\tDroppedAttributesCount uint32      `json:\"droppedAttributesCount,omitempty\"`","+\tFlags                  uint32      `json:\"flags,omitempty\"`","+}","+","+// Status corresponds to tracepb.Status.","+type Status struct {","+\tMessage string `json:\"message,omitempty\"`","+\tCode    int32  `json:\"code,omitempty\"`","+}","+","+// MarshalExportTraceServiceRequest encodes an ExportTraceServiceRequest as JSON Protobuf encoded bytes.","+func MarshalExportTraceServiceRequest(req *coltracepb.ExportTraceServiceRequest) ([]byte, error) {","+\tif req == nil {","+\t\treturn []byte(\"{}\"), nil","+\t}","+\tr := &ExportTraceServiceRequest{}","+\tfor _, rs := range req.ResourceSpans {","+\t\tr.ResourceSpans = append(r.ResourceSpans, encodeResourceSpans(rs))","+\t}","+\treturn json.Marshal(r)","+}","+","+func encodeResourceSpans(rs *tracepb.ResourceSpans) *ResourceSpans {","+\tif rs == nil {","+\t\treturn nil","+\t}","+\tout := &ResourceSpans{SchemaURL: rs.SchemaUrl}","+\tif rs.Resource != nil {","+\t\tout.Resource = &Resource{","+\t\t\tAttributes:             encodeKeyValues(rs.Resource.Attributes),","+\t\t\tDroppedAttributesCount: rs.Resource.DroppedAttributesCount,","+\t\t\tEntityRefs:             encodeEntityRefs(rs.Resource.EntityRefs),","+\t\t}","+\t}","+\tfor _, ss := range rs.ScopeSpans {","+\t\tout.ScopeSpans = append(out.ScopeSpans, encodeScopeSpans(ss))","+\t}","+\treturn out","+}","+","+func encodeEntityRefs(ers []*commonpb.EntityRef) []*EntityRef {","+\tif len(ers) == 0 {","+\t\treturn nil","+\t}","+\tout := make([]*EntityRef, len(ers))","+\tfor i, er := range ers {","+\t\tif er == nil {","+\t\t\tcontinue","+\t\t}","+\t\tout[i] = &EntityRef{","+\t\t\tSchemaURL:       er.SchemaUrl,","+\t\t\tType:            er.Type,","+\t\t\tIdKeys:          er.IdKeys,","+\t\t\tDescriptionKeys: er.DescriptionKeys,","+\t\t}","+\t}","+\treturn out","+}","+","+func encodeScopeSpans(ss *tracepb.ScopeSpans) *ScopeSpans {","+\tif ss == nil {","+\t\treturn nil","+\t}","+\tout := &ScopeSpans{SchemaURL: ss.SchemaUrl}","+\tif ss.Scope != nil {","+\t\tout.Scope = &InstrumentationScope{","+\t\t\tName:                   ss.Scope.Name,","+\t\t\tVersion:                ss.Scope.Version,","+\t\t\tAttributes:             encodeKeyValues(ss.Scope.Attributes),","+\t\t\tDroppedAttributesCount: ss.Scope.DroppedAttributesCount,","+\t\t}","+\t}","+\tfor _, s := range ss.Spans {","+\t\tout.Spans = append(out.Spans, encodeSpan(s))","+\t}","+\treturn out","+}","+","+func encodeSpan(s *tracepb.Span) *Span {"],"additions":207,"deletions":0,"truncated":false}],"additions":635,"deletions":21,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-08-13T09:12:16.168047+00:00"}