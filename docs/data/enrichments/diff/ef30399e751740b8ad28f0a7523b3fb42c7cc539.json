 '../constants'","+import { isDirectRequest } from '../plugins/css'","+import type { IndexHtmlTransformContext } from '../plugins/html'","+import { checkPublicFile } from '../publicDir'","+import type { ViteDevServer } from '../server'","+import {","+  decodeURIIfPossible,","+  injectQuery,","+  isCSSRequest,","+  isDataUrl,","+  isExternalUrl,","+  isImportRequest,","+  isInternalRequest,","+  normalizePath,","+  removeImportQuery,","+  removeTimestampQuery,","+  safeRealpathSync,","+  stripBase,","+  urlRE,","+} from '../utils'","+import { resolveStaticPathname } from './middlewares/static'","+import { isTransformRequest } from './middlewares/transform'","+import { browserUrlToModuleUrl, moduleUrlToFilePath } from './moduleUrl'","+","+export function htmlUrlToRequestUrl(","+  url: string,","+  base: string,","+  ctx: Pick<IndexHtmlTransformContext, 'path' | 'originalUrl'>,","+): string | undefined {","+  url = url.split('#', 1)[0]","+  if (!url || isExternalUrl(url) || isDataUrl(url)) return","+","+  let resolvedUrl: URL","+  try {","+    // ctx.path has already passed through the base and HTML fallback middleware.","+    const documentUrl = new URL(","+      ctx.originalUrl ?? joinUrlSegments(base, ctx.path),","+      'http://example.com',","+    )","+    resolvedUrl = new URL(url, documentUrl)","+  } catch {","+    return","+  }","+  if (resolvedUrl.origin !== 'http://example.com') return","+","+  // The browser resolves the URL before the base middleware sees the request.","+  return stripBase(resolvedUrl.pathname + resolvedUrl.search, base)","+}","+","+export function getHtmlAssetFetchDest(","+  tag: string,","+  attr: string,","+  attributes: Record<string, string>,","+): string | undefined {","+  if (attr === 'src' && ['iframe', 'frame', 'fencedframe'].includes(tag)) {","+    return tag","+  }","+  if (tag !== 'link' || attr !== 'href') return","+","+  const rel = attributes.rel?.trim().toLowerCase().split(/\\s+/)","+  if (rel?.includes('modulepreload')) return 'script'","+  if (rel?.includes('stylesheet')) return 'style'","+  if (rel?.includes('preload')) return attributes.as?.trim().toLowerCase()","+}","+","+export async function addHtmlRequestToSafeModulePaths(","+  requestUrl: string,","+  server: ViteDevServer,","+  fetchDest?: string,","+): Promise<void> {","+  const { config } = server","+  const decodedUrl = decodeURIIfPossible(removeTimestampQuery(requestUrl))","+  if (decodedUrl === undefined) return","+  const pathname = cleanUrl(decodedUrl)","+  if (","+    !isInternalRequest(requestUrl) &&","+    !isImportRequest(requestUrl) &&","+    !urlRE.test(requestUrl) &&","+    checkPublicFile(pathname, config)","+  ) {","+    return","+  }","+","+  if (isTransformRequest(decodedUrl, fetchDest)) {","+    let moduleUrl = browserUrlToModuleUrl(","+      removeImportQuery(decodedUrl.replace(NULL_BYTE_PLACEHOLDER, '\\0')),","+      '',","+    )","+    if (","+      fetchDest === 'style' &&","+      isCSSRequest(moduleUrl) &&","+      !isDirectRequest(moduleUrl)","+    ) {","+      moduleUrl = injectQuery(moduleUrl, 'direct')","+    }","+    const resolved =","+      await server.environments.client.pluginContainer.resolveId(moduleUrl)","+    if (resolved) {","+      if (!resolved.external) config.safeModulePaths.addId(resolved.id)","+      return","+    }","+  }","+","+  if (isInternalRequest(pathname) && !pathname.startsWith(FS_PREFIX)) return","+","+  const filePath = pathname.startsWith(FS_PREFIX)","+    ? moduleUrlToFilePath(pathname, config.root)","+    : normalizePath(","+        path.join(","+          config.root,","+          resolveStaticPathname(pathname, config) || pathname,","+        ),","+      )","+  const { postfix } = splitFileAndPostfix(decodedUrl)","+  config.safeModulePaths.addId(filePath + postfix)","+  if (!config.resolve.preserveSymlinks) {","+    try {","+      config.safeModulePaths.addId(","+        normalizePath(safeRealpathSync(filePath)) + postfix,","+      )","+    } catch {","+      // Files referenced by HTML may not exist yet.","+    }","+  }","+}"],"additions":132,"deletions":0,"truncated":false},{"path":"packages/vite/src/node/server/middlewares/__tests__/fixtures/root/classic.js","lines":["@@ -0,0 +1 @@","+console.log('classic')"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/vite/src/node/server/middlewares/__tests__/fixtures/root/dynamic.js","lines":["@@ -0,0 +1 @@","+export default 'dynamic'"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/vite/src/node/server/middlewares/__tests__/fixtures/root/style.css","lines":["@@ -0,0 +1,3 @@","+body {","+  color: red;","+}"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/vite/src/node/server/middlewares/__tests__/indexHtml.spec.ts","lines":["@@ -1,9 +1,14 @@"," import fs from 'node:fs'","+import os from 'node:os'"," import path from 'node:path'"," import { describe, expect, onTestFinished, test, vi } from 'vitest'","+import { splitFileAndPostfix } from '../../../../shared/utils'","+import type { InlineConfig } from '../../../config'"," import { FS_PREFIX } from '../../../constants'"," import { createServer } from '../../../server'","+import { mergeConfig, normalizePath } from '../../../utils'"," import { browserUrlToModuleUrl } from '../../moduleUrl'","+import { isFileLoadingAllowed } from '../static'"," "," const FIXTURE_DIR = path.resolve(import.meta.dirname, 'fixtures')"," const HTML_PATH = path.resolve(FIXTURE_DIR, 'root/index.html')","@@ -12,22 +17,30 @@ const OUTSIDE_HTML_PATH = path.resolve(FIXTURE_DIR, 'outside.html')"," const OUTSIDE_HTML_CONTENT = fs.readFileSync(OUTSIDE_HTML_PATH, 'utf-8')"," const VITE_PACKAGE_DIR = path.resolve(import.meta.dirname, '../../../../..')"," ","-async function createTestServer(rootDir?: string) {","+async function createTestServer({","+  root: rootDir,","+  ...config","+}: InlineConfig = {}) {","   const root = path.resolve(import.meta.dirname, rootDir ?? 'fixtures/root')"," ","-  const server = await creat