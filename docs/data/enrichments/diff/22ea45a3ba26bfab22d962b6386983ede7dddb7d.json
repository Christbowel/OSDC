upabase on your machine.' },","+  {","+    id: 'dashboard',","+    label: 'Dashboard',","+    description: 'Create a hosted project in the cloud.',","+  },","+] as const","+","+export const EXPLORE_ITEMS: ExploreItem[] = [","+  {","+    id: 'auth',","+    name: 'Add users',","+    feature: 'Auth',","+    description: 'Sign users in with email, passwordless links, OAuth, or phone.',","+    href: '/guides/auth',","+    shape: 'Auth',","+  },","+  {","+    id: 'ai-tools',","+    name: 'Connect your AI agent',","+    feature: 'AI tools',","+    description: 'Install the Supabase plugin, which bundles the MCP server and agent skills.',","+    href: '/guides/ai-tools',","+    shape: 'Platform',","+    shapeClassName: 'origin-left scale-90',","+  },","+  {","+    id: 'storage',","+    name: 'Handle files and uploads',","+    feature: 'Storage',","+    description: 'Store and serve files with access policies.',","+    href: '/guides/storage/quickstart',","+    shape: 'Storage',","+  },","+  {","+    id: 'realtime',","+    name: 'Reflect changes live',","+    feature: 'Realtime',","+    description: 'Listen to database changes, broadcast messages, and track presence.',","+    href: '/guides/realtime',","+    shape: 'Realtime',","+  },","+  {","+    id: 'functions',","+    name: 'Add server-side logic',","+    feature: 'Edge Functions',","+    description: 'Run TypeScript close to your users, for webhooks, emails, and AI calls.',","+    href: '/guides/functions/quickstart',","+    shape: 'Edge Functions',","+    shapeClassName: 'origin-left scale-75',","+  },","+]","+","+export const parseChoices = (params: { get: (key: string) => string | null }): Choices => ({","+  start: START_OPTIONS.find((option) => option.id === params.get('start'))?.id ?? 'agent',","+  fw: FRAMEWORKS.find((framework) => framework.slug === params.get('fw'))?.slug ?? null,","+  features: EXPLORE_ITEMS.filter((item) =>","+    (params.get('features') ?? '').split(',').includes(item.id)","+  ).map((item) => item.id),","+})","+","+export const CREATE_PROJECT_URL = 'https://supabase.com/dashboard/new'","+","+export const LOCAL_COMMANDS = [","+  setupCommand.installCli,","+  setupCommand.initialize,","+  setupCommand.start,","+].join('\\n')","+","+export const NEXT_STEPS: NextStep[] = [","+  {","+    id: 'row-level-security',","+    title: 'Secure your data',","+    description: 'Control who can read and write each row with Row Level Security.',","+    href: '/guides/database/postgres/row-level-security',","+  },","+  {","+    id: 'production',","+    title: 'Go to production',","+    description: 'Check security, performance, and availability before you launch.',","+    href: '/guides/deployment/going-into-prod',","+  },","+]"],"additions":115,"deletions":0,"truncated":false},{"path":"apps/docs/features/getting-started/GettingStarted.frameworks.ts","lines":["@@ -0,0 +1,125 @@","+import { frameworks } from '~/components/FrameworkQuickstarts.constants'","+import { isFeatureEnabled } from 'common/enabled-features'","+","+interface Framework {","+  slug: string","+  name: string","+  icon: string","+  href: string","+  hasLightIcon?: boolean","+  sdk: SdkId","+  install?: string","+  isCommunity?: boolean","+}","+","+interface FrameworkGroup {","+  id: string","+  label: string","+  frameworks: Framework[]","+}","+","+type SdkId = 'js' | 'dart' | 'swift' | 'kotlin' | 'python' | 'postgres'","+","+// SDKs without an install command defer to the framework quickstart","+const SDKS: Record<SdkId, { install?: string; isCommunity?: boolean }> = {","+  js: { install: 'npm install @supabase/supabase-js' },","+  dart: { install: 'flutter pub add supabase_flutter' },","+  swift: {},","+  kotlin: { isCommunity: true },","+  python: { install: 'pip install supabase' },","+  postgres: {},","+}","+","+// frameworks not listed here use the JavaScript SDK","+const FRAMEWORK_SDKS: Record<string, SdkId> = {","+  'ios-swiftui': 'swift',","+  kotlin: 'kotlin',","+  flutter: 'dart',","+  flask: 'python',","+  reflex: 'python',","+  laravel: 'postgres',","+  redwoodjs: 'postgres',","+  'ruby-on-rails': 'postgres',","+  'spring-boot': 'postgres',","+}","+","+const INSTALL_OVERRIDES: Record<string, string> = {","+  'expo-react-native':","+    'npx expo install @supabase/supabase-js react-native-url-polyfill expo-sqlite',","+  tanstack: 'npm install @supabase/supabase-js @supabase/ssr',","+  reflex: 'uv add supabase',","+}","+","+// these quickstarts start from a template that already installs the client","+const TEMPLATE_SLUGS = ['nextjs', 'hono', 'refine']","+","+export const FRAMEWORKS: Framework[] = frameworks","+  .filter((framework) => framework.enabled !== false)","+  .map((framework) => {","+    const slug = framework.href.slice(framework.href.lastIndexOf('/') + 1)","+    const sdk = FRAMEWORK_SDKS[slug] ?? 'js'","+","+    return {","+      slug,","+      name: framework.name,","+      icon: framework.icon,","+      href: framework.href,","+      hasLightIcon: framework.hasLightIcon,","+      sdk,","+      install: TEMPLATE_SLUGS.includes(slug)","+        ? undefined","+        : (INSTALL_OVERRIDES[slug] ?? SDKS[sdk].install),","+      isCommunity: SDKS[sdk].isCommunity,","+    }","+  })","+","+const getFrameworksBySlug = (slugs: string[]): Framework[] =>","+  slugs.flatMap((slug) => FRAMEWORKS.filter((framework) => framework.slug === slug))","+","+export const FRAMEWORK_GROUPS: FrameworkGroup[] = [","+  {","+    id: 'popular',","+    label: 'Popular',","+    frameworks: getFrameworksBySlug([","+      'nextjs',","+      'reactjs',","+      'vue',","+      'sveltekit',","+      'expo-react-native',","+      'flutter',","+    ]),","+  },","+  {","+    id: 'fullstack',","+    label: 'Full stack',","+    frameworks: getFrameworksBySlug([","+      'nextjs',","+      'tanstack',","+      'astrojs',","+      'nuxtjs',","+      'sveltekit',","+      'redwoodjs',","+      'reflex',","+      'laravel',","+      'ruby-on-rails',","+    ]),","+  },","+  {","+    id: 'frontend',","+    label: 'Frontend',","+    frameworks: getFrameworksBySlug(['reactjs', 'vue', 'solidjs', 'refine']),","+  },","+  {","+    id: 'mobile',","+    label: 'Mobile',","+    frameworks: getFrameworksBySlug(['expo-react-native', 'flutter', 'ios-swiftui', 'kotlin']),","+  },","+  {","+    id: 'backend',","+    label: 'Backend',","+    frameworks: getFrameworksBySlug(['hono', 'flask', 'spring-boot']),","+  },","+].filter((group) => group.frameworks.length > 0 && isFeatureEnabled('docs:framework_quickstarts'))","+","+export const getFramework = (slug: string | null): Framework | undefined =>","+  FRAMEWORKS.find((framework) => framework.slug === slug)"],"additions":125,"deletions":0,"truncated":false},{"path":"apps/docs/features/getting-started/GettingStarted.prompts.ts","lines":["@@ -0,0 +1,33 @@","+import { setupCommand } from '~/components/HomePageCover.constants'","+import { PROD_URL } from '~/lib/constants'","+","+import { CREATE_PROJECT_URL, EXPLORE_ITEMS } from './GettingStarted.data'","+","+const toMarkdownUrl = (href: string) => `${PROD_URL}${href}.md`","+","+export const buildPrompt = (features: string[]): string => {","+  const selected = EXPLORE_ITEMS.filter((item) => features.includes(item.id))","+  const productGuides = EXPLORE_ITEMS.filter((item) => item.id !== 'ai-tools')","+    .map((item) => `${item.feature} (${toMarkdownUrl(item.href)})`)","+    .join(', ')","+  const featureLines =","+    selected.length > 0","+      ? selected.map((item) => `Set up ${item.feature}. Follow ${toMarkdownUrl(item.href)}.`)","+      : [`Ask me which features I need, then follow the matching guides: ${productGuides}.`]","+  const lines = [","+    'Find the framework and language of my app from its project files, such as `package.json`, `pubspec.yaml`, or `Package.swift`. If the folder has no app, ask what I want to build, then suggest a framework and wait for my choice.',","+    // the npm install needs a Node.js project, which other SDKs do not have","+    `Install the Supabase CLI. In a Node.js project, install it as a dev dependency with \\`${setupCommand.installCli}\\`. Otherwise, use the method for my operating system from ${toMarkdownUrl('/guides/local-development/cli/getting-started')}.`,","+    `Install the Supabase plugin with \\`${setupCommand.installPlugin}\\`.`,","+    `If I do not have a Supabase project, ask whether I want a hosted project (${CREATE_PROJECT_URL}) or a local one (\\`supabase init\\`, then \\`supabase start\\`). In a Node.js project, put \\`npx\\` before each command.`,","+    `Connect my app. Follow the quickstart for its framework from ${toMarkdownUrl('/guides/getting-started')}.`,","+    ...featureLines,","+    'Check the connection. Create a `todos` table with a `title` column and one row, and enable Row Level Security with a policy that lets anyone read it. Then read the row from my app and show its title, and ask whether I want to keep the `todos` table or drop it.',","+    'Finish by telling me what you changed and how to run my app.',","+  ]","+","+  return [","+    'Help me set up Supabase in my app. Before you create a project or change my files, tell me your plan and wait for my go-ahead. Do the following:',","+    ...lines.map((line, index) => `${index + 1}. ${line}`),","+  ].join('\\n')","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"apps/docs/features/getting-started/GettingStartedStepper.client.tsx","lines":["@@ -0,0 +1,634 @@","+'use client'","+","+import { StepHikeCompact } from '~/components/StepHikeCompact'","+import { SOURCE_FOOTER_CLASSES, SourceFrame } from '~/features/directives/CodeSample.client'","+import { CodeTabs } from '~/features/directives/CodeTabs.components'","+import { IconLinkImage } from '~/features/ui/IconLink'","+import {","+  Prompt,","+  PromptContent,","+  PromptCopy,","+  PromptMarkdown,","+  PromptPanel,","+  PromptTitle,","+} from '~/features/ui/PromptPanel'","+import { TabPanel } from '~/features/ui/Tabs'","+import { useSendTelemetryEvent } from '~/lib/telemetry'","+import { useSearchParamsShallow } from 'common'","+import { type DocsContentListingClickedEvent } from 'common/telemetry-constants'","+import { ArrowRight, ArrowUpRight, Check } from 'lucide-react'","+import { animate, useMotionValue, useMotionValueEvent, useReducedMotion } from 'motion/react'","+import Link from 'next/link'","+import { RadioGroup } from 'radix-ui'","+import { useId, useState, type ReactNode } from 'react'","+import { Badge, Button, cn, ToggleGroup, ToggleGroupItem } from 'ui'","+import { IsoShape } from 'ui-patterns/IsoShape/IsoShape'","+import { FLUID_RISE_MS } from 'ui-patterns/IsoShape/IsoShape.glyphs'","+","+import {","+  CREATE_PROJECT_URL,","+  EXPLORE_ITEMS,","+  NEXT_STEPS,","+  parseChoices,","+  START_OPTIONS,","+  type ExploreItem,","+} from './GettingStarted.data'","+import { FRAMEWORK_GROUPS, getFramework } from './GettingStarted.frameworks'","+import { buildPrompt } from './GettingStarted.prompts'","+import { useGettingStartedVariant } from './useGettingStartedVariant'","+","+interface GettingStartedVariantSwitchProps {","+  control: ReactNode","+  children: ReactNode","+}","+","+interface GettingStartedStepperClientProps {","+  localCommandsCode: ReactNode","+  installCodes: Record<string, ReactNode>","+}","+","+interface StepperLink {","+  href: string","+  title: string","+  groupTitle: string","+}","+","+interface ExploreCardProps {","+  item: ExploreItem","+}","+","+interface LinkCardProps extends StepperLink {","+  motionHandlers?: ShapeMotion['motionHandlers']","+  children: ReactNode","+}","+","+interface FeatureToggleCardProps {","+  item: ExploreItem","+  isSelected: boolean","+  onFeatureToggle: (id: string) => void","+}","+","+interface NotchCardProps {","+  notch: ReactNode","+  isSelected?: boolean","+  children: ReactNode","+}","+","+interface ChoiceIndicatorProps {","+  type: 'checkbox' | 'radio'","+  isSelected: boolean","+}","+","+interface FilledCheckProps {","+  shape: 'circle' | 'square'","+}","+","+interface FeatureCardBodyProps {","+  item: Pick<ExploreItem, 'name' | 'description'> & Partial<Pick<ExploreItem, 'feature'>>","+}","+","+interface ShapeMotion {","+  shapeProps: { yaw: number; activation: number; fluidStep: number }","+  motionHandlers: {","+    onPointerEnter: () => void","+    onPointerLeave: () => void","+    onFocus: () => void","+    onBlur: () => void","+  }","+}","+","+interface StartChoiceCardsProps {","+  value: string","+  onValueChange: (value: string) => void","+}","+","+// builds without framework quickstarts skip the framework step","+const HAS_FRAMEWORKS = FRAMEWORK_GROUPS.length > 0","+const FULL_TURN = Math.PI * 2","+const TURN_DURATION_S = 2.4","+const ACTIVATE_DURATION_S = 0.7","+","+const toStepperLinkEvent = ({","+  href,","+  title,","+  groupTitle,","+}: StepperLink): DocsContentListingClickedEvent => ({","+  action: 'docs_content_listing_clicked',","+  properties: {","+    targetPath: href,","+    linkTitle: title,","+    groupTitle,","+    listingId: 'getting-started-stepper',","+  },","+})","+","+const useShapeMotion = (): ShapeMotion => {","+  const yaw = useMotionValue(0)","+  const activation = useMotionValue(0)","+  const [renderedYaw, setRenderedYaw] = useState(0)","+  const [renderedActivation, setRenderedActivation] = useState(0)","+  const shouldReduceMotion = useReducedMotion()","+  useMotionValueEvent(yaw, 'change', setRenderedYaw)","+  useMotionValueEvent(activation, 'change', setRenderedActivation)","+","+  const handleActivate = () => {","+    animate(activation, 1, {","+      duration: shouldReduceMotion ? 0 : ACTIVATE_DURATION_S,","+      ease: 'easeOut',","+    })","+    if (shouldReduceMotion) return","+    animate(yaw, yaw.get() + FULL_TURN, {","+      duration: TURN_DURATION_S,","+      ease: 'linear',","+      repeat: Infinity,","+    })","+  }","+  const handleDeactivate = () => {","+    animate(activation, 0, {","+      duration: shouldReduceMotion ? 0 : ACTIVATE_DURATION_S,","+      ease: 'easeOut',","+    })","+    animate(yaw, Math.round(yaw.get() / FULL_TURN) * FULL_TURN, {","+      duration: 0.6,","+      ease: 'easeOut',","+    })","+  }","+","+  return {","+    shapeProps: {","+      yaw: renderedYaw,","+      activation: renderedActivation,","+      // the glyphs move only while the shape turns","+      fluidStep: Math.floor(renderedYaw / (FULL_TURN / ((TURN_DURATION_S * 1000) / FLUID_RISE_MS))),","+    },","+    motionHandlers: {","+      onPointerEnter: handleActivate,","+      onPointerLeave: handleDeactivate,","+      onFocus: handleActivate,","+      onBlur: handleDeactivate,","+    },","+  }","+}","+","+// flags load in the browser, so the server html and readers without javascript get the control","+export const GettingStartedVariantSwitch = ({","+  control,","+  children,","+}: GettingStartedVariantSwitchProps) => {","+  const { variant, isReady } = useGettingStartedVariant()","+","+  return (","+    <div className={cn(!isReady && 'invisible noscript:visible')}>","+      {variant === 'stepper' ? children : control}","+    </div>","+  )","+}","+","+export const GettingStartedStepperClient = ({","+  localCommandsCode,","+  installCodes,","+}: GettingStartedStepperClientProps) => {","+  const searchParams = useSearchParamsShallow()","+  const choices = parseChoices(searchParams)","+  const framework = getFramework(choices.fw)","+  const isAgent = choices.start === 'agent'","+  const setupPrompt = buildPrompt(choices.features)","+  const sendTelemetryEvent = useSendTelemetryEvent()","+  const [selectedGroupId, setSelectedGroupId] = useState<string | null>(null)","+  // until the reader picks a group, show the first group that holds the framework","+  const activeGroup =","+    FRAMEWORK_GROUPS.find((group) => group.id === selectedGroupId) ??","+    FRAMEWORK_GROUPS.find((group) => group.frameworks.some((item) => item.slug === choices.fw)) ??","+    FRAMEWORK_GROUPS[0]","+","+  const handleStartChange = (start: string) => {","+    searchParams.set('start', start)","+    sendTelemetryEvent({","+      action: 'docs_getting_started_option_clicked',","+      properties: { optionType: 'start', optionId: start },","+    })","+  }","+  const handleFrameworkChange = (fw: string) => {","+    searchParams.set('fw', fw)","+    sendTelemetryEvent({","+      action: 'docs_getting_started_option_clicked',","+      properties: { optionType: 'framework', optionId: fw },","+    })","+  }","+  // an empty list means the reader skipped the step, so the prompt asks","+  const handleFeatureToggle = (id: string) => {","+    const wasSelected = choices.features.includes(id)","+    searchParams.set(","+      'features',","+      wasSelected","+        ? choices.features.filter((feature) => feature !== id).join(',')","+        : [...choices.features, id].join(',')","+    )","+    sendTelemetryEvent({","+      action: 'docs_getting_started_option_clicked',","+      properties: { optionType: 'feature', optionId: id, isSelected: !wasSelected },","+    })","+  }","+  const handleQuickstartClick = () => {","+    if (!framework) return","+    sendTelemetryEvent(","+      toStepperLinkEvent({","+        href: framework.href,","+        title: `${framework.name} quickstart`,","+        groupTitle: 'Connect your app',","+      })","+    )","+  }","+  const handleCreateProjectClick = () =>","+    sendTelemetryEvent(","+      toStepperLinkEvent({","+        href: CREATE_PROJECT_URL,","+        title: 'Create a project',","+        groupTitle: 'Create a project',","+      })","+    )","+  const handleGroupChange = (groupId: string) => {","+    const group = FRAMEWORK_GROUPS.find((item) => item.id === groupId)","+    if (!group) return","+    setSelectedGroupId(group.id)","+    if (!group.frameworks.some((item) => item.slug === choices.fw)) {","+      searchParams.delete('fw')","+    }","+  }","+","+  return (","+    <div className=\"not-prose @container flex flex-col gap-12\">","+      <p className=\"m-0 text-lg text-foreground-light\">","+        Create a Supabase project and connect it to your app.","+      </p>","+      <StepHikeCompact title=\"Get started\">","+        <StepHikeCompact.Step step={1} title=\"Choose how to start\">","+          <StepHikeCompact.Details title=\"Choose how to start\">","+            <p className=\"m-0 text-sm text-foreground-light\">","+              Let your AI agent set up Supabase, run Supabase locally, or create a hosted project.","+            </p>","+          </StepHikeCompact.Details>","+          <StepHikeCompact.Code>","+            <StartChoiceCards value={choices.start} onValueChange={handleStartChange} />","+          </StepHikeCompact.Code>","+        </StepHikeCompact.Step>","+        {choices.start === 'cli' ? (","+          <StepHikeCompact.Step step={2} title=\"Run Supabase locally\">","+            <StepHikeCompact.Details title=\"Run Supabase locally\">","+              <p className=\"m-0 text-sm text-foreground-light\">","+                Install the Supabase CLI, initialize your project, then start the local stack. The","+                CLI needs Node.js 20 or later, and the local stack needs Docker or another container","+                runtime. Without a Node.js project,{' '}","+                <Link","+                  href=\"/guides/local-development/cli/getting-started\"","+                  className=\"text-foreground underline underline-offset-4\"","+                >","+                  install the CLI for your operating system","+                </Link>{' '}","+                instead.","+              </p>","+            </StepHikeCompact.Details>","+            <StepHikeCompact.Code>{localCommandsCode}</StepHikeCompact.Code>","+          </StepHikeCompact.Step>","+        ) : choices.start === 'dashboard' ? (","+          <StepHikeCompact.Step step={2} title=\"Create a project\">","+            <StepHikeCompact.Details title=\"Create a project\">","+              <p className=\"m-0 text-sm text-foreground-light\">"],"additions":296,"deletions":0,"truncated":false}],"additions":697,"deletions":143,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-14T15:13:33.419295+00:00"}