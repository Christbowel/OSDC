_insecure = false;","+    let fixture = TestFixture::setup_with_config(&config).await?;","+    let db = fixture.default_db_name();","+    fixture","+        .execute_command(&format!(\"create database {db}\"))","+        .await?;","+","+    let dir = tempfile::tempdir()?;","+    let url = format!(\"fs://{}/\", dir.path().display());","+","+    for sql in [","+        format!(\"create stage insecure_fs_stage url = '{url}'\"),","+        format!(","+            \"create stage insecure_http_stage url = 's3://bucket/dir/' connection = (endpoint_url = 'http://127.0.0.1:9000' access_key_id = 'a' secret_access_key = 'b')\"","+        ),","+        format!(\"create table {db}.insecure_fs_table(a int) '{url}'\"),","+        format!(\"create temporary table {db}.insecure_fs_tmp(a int) '{url}'\"),","+    ] {","+        let err = fixture.execute_command(&sql).await.expect_err(sql.as_str());","+        assert_eq!(err.code(), ErrorCode::STORAGE_INSECURE, \"{sql}: {err}\");","+    }","+","+    let sql = \"create connection insecure_conn storage_type = 's3' endpoint_url = 'http://127.0.0.1:9000' access_key_id = 'a' secret_access_key = 'b'\";","+    let err = fixture.execute_command(sql).await.expect_err(sql);","+    assert_eq!(err.code(), ErrorCode::STORAGE_INSECURE, \"{sql}: {err}\");","+","+    // A stage stored before the DDL check must not be usable either.","+    let stored = StageInfo::new_external_stage(","+        StorageParams::Fs(StorageFsConfig {","+            root: format!(\"{}/\", dir.path().display()),","+        }),","+        false,","+    )","+    .with_stage_name(\"stored_fs_stage\");","+    UserApiProvider::instance()","+        .add_stage(&fixture.default_tenant(), stored, false, None)","+        .await?;","+    for sql in [","+        \"select read_file('@stored_fs_stage/a')\",","+        \"list @stored_fs_stage\",","+    ] {","+        let err = query_error(&fixture, sql).await;","+        assert_eq!(err.code(), ErrorCode::STORAGE_INSECURE, \"{sql}: {err}\");","+    }","+","+    fixture","+        .execute_command(\"create stage internal_stage\")","+        .await?;","+    let sql = format!(\"alter stage internal_stage set url = '{url}'\");","+    let err = fixture.execute_command(&sql).await.expect_err(sql.as_str());","+    assert_eq!(err.code(), ErrorCode::STORAGE_INSECURE, \"{sql}: {err}\");","+","+    Ok(())","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_user_name_must_be_a_single_path_component() -> Result<()> {","+    let fixture = TestFixture::setup().await?;","+","+    for name in [\"\", \".\", \"..\", \"../..\", \"alice/\", \"/\"] {","+        let sql = format!(\"create user '{name}' identified by 'password'\");","+        let err = fixture.execute_command(&sql).await.expect_err(sql.as_str());","+        assert_eq!(err.code(), ErrorCode::ILLEGAL_USER, \"{sql}: {err}\");","+    }","+","+    fixture","+        .execute_command(\"create user 'user@example.com' identified by 'password'\")","+        .await?;","+","+    Ok(())","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_read_file_rejects_parent_components() -> Result<()> {","+    let fixture = TestFixture::setup().await?;","+    fixture","+        .execute_command(\"create stage read_file_stage\")","+        .await?;","+    fixture","+        .execute_command(\"create table read_file_paths(stage_name string, path string)\")","+        .await?;","+    fixture","+        .execute_command(","+            \"insert into read_file_paths values ('@read_file_stage', '../x'), ('@~', 'a/../../x')\",","+        )","+        .await?;","+","+    for sql in [","+        \"select read_file('@~/../x')\",","+        \"select read_file('@read_file_stage/a/../../x')\",","+        \"select read_file('@~', '../x')\",","+        \"select read_file(stage_name || '/' || path) from read_file_paths\",","+        \"select read_file('@read_file_stage', path) from read_file_paths\",","+        \"select read_file(stage_name, '../x') from read_fi