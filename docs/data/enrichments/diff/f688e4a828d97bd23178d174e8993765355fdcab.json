alueError(","                 f\"The number of semantic quantizers should be lower than the total number of quantizers {self.num_quantizers}, but is currently {self.num_semantic_quantizers}.\"","             )","+        if self.codebook_size & (self.codebook_size - 1):","+            raise ValueError(f\"`codebook_size` must be a power of 2, but is {self.codebook_size}.\")"," ","     @property","     def encodec_frame_rate(self) -> int:","@@ -180,5 +189,108 @@ def frame_rate(self) -> float:","             return self._frame_rate","         return self.sampling_rate / self.frame_size"," ","+    # derived, not `sub_configs`: the halves share every field, and Mimi checkpoints are flat","+    @property","+    def encoder_config(self) -> \"MimiEncoderConfig | None\":","+        if not self._has_encoder:","+            return None","+        encoder_config = MimiEncoderConfig(**self.to_dict())","+        # `to_dict` drops the attention backend, which the encoder half must share with the full model","+        encoder_config._attn_implementation = self._attn_implementation","+        return encoder_config","+","+    @encoder_config.setter","+    def encoder_config(self, value: None):","+        if value is not None:","+            raise ValueError(","+                \"`encoder_config` is derived from the fields of `MimiConfig`: it can only be set to `None`.\"","+            )","+        if not self._has_decoder:","+            raise ValueError(\"Mimi needs an encoder, a decoder, or both: the decoder is already dropped.\")","+        self._has_encoder = False","+","+    @property","+    def decoder_config(self) -> \"MimiDecoderConfig | None\":","+        if not self._has_decoder:","+            return None","+        decoder_config = MimiDecoderConfig(**self.to_dict())","+        # `to_dict` drops the attention backend, which the decoder half must share with the full model","+        decoder_config._attn_implementation = self._attn_implementation","+        return decoder_config","+","+    @decoder_config.setter","+    def decoder_config(self, value: None):","+        if value is not None:","+            raise ValueError(","+                \"`decoder_config` is derived from the fields of `MimiConfig`: it can only be set to `None`.\"","+            )","+        if not self._has_encoder:","+            raise ValueError(\"Mimi needs an encoder, a decoder, or both: the encoder is already dropped.\")","+        self._has_decoder = False","+","+    def to_dict(self):","+        output = super().to_dict()","+        # a dropped half is saved as `\"encoder_config\": null`, loaded back through its setter","+        for half in (\"encoder\", \"decoder\"):","+            if not output.pop(f\"_has_{half}\", True):","+                output[f\"{half}_config\"] = None","+        return output","+","+","+@strict","+class MimiEncoderConfig(MimiConfig):","+    \"\"\"","+    Configuration of the encoder half of Mimi (SEANet encoder, encoder transformer and downsampling). It shares every","+    field with [`MimiConfig`] (see its documentation for the arguments), so it can be loaded directly from a full Mimi","+    checkpoint.","+    \"\"\"","+","+    model_type = \"mimi_encoder\"","+","+    # a half has no halves: the `null` saved for a codec's dropped half is ignored when loading the other one","+    @property","+    def encoder_config(self):","+        return None","+","+    @encoder_config.setter","+    def encoder_config(self, value):","+        pass","+","+    @property","+    def decoder_config(self):","+        return None","+","+    @decoder_config.setter","+    def decoder_config(self, value):","+        pass","+","+","+@strict","+class MimiDecoderConfig(MimiConfig):","+    \"\"\"","+    Configuration of the decoder half of Mimi (upsampling, decoder transformer and SEANet decoder). It shares every","+    field with [`MimiConfig`] (see its documentation for the arguments), so it can be loaded directly from a full Mimi","+    checkpoint.","+    