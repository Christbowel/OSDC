rafana/pkg/storage/unified/resource\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+// A federated PreRank search can authorize several indexes concurrently.","+// Accumulate locally and update histograms once per executed search.","+type searchAuthObservation struct {","+\tmetrics *resource.BleveIndexMetrics","+\tchecks  atomic.Int64","+}","+","+func withSearchAuthObservation(access authlib.AccessClient, metrics *resource.BleveIndexMetrics) (authlib.AccessClient, *searchAuthObservation) {","+\tobservation := &searchAuthObservation{metrics: metrics}","+\tif access != nil {","+\t\taccess = &observedSearchAccessClient{AccessClient: access, observation: observation}","+\t}","+\treturn access, observation","+}","+","+func (o *searchAuthObservation) start(req *resourcepb.ResourceSearchRequest, access authlib.AccessClient, postRank, cursorFallback bool) func(*resourcepb.ResourceSearchResponse, error) {","+\tmode := \"pre_rank\"","+\tif access == nil {","+\t\tmode = \"none\"","+\t} else if postRank {","+\t\tmode = \"post_rank\"","+\t}","+\tif cursorFallback {","+\t\to.metrics.SearchAuthEvents.WithLabelValues(\"cursor_fallback\").Inc()","+\t}","+\tstarted := time.Now()","+\treturn func(result *resourcepb.ResourceSearchResponse, err error) {","+\t\to.observe(mode, searchAuthQueryType(req), started, result, err)","+\t}","+}","+","+func searchAuthQueryType(req *resourcepb.ResourceSearchRequest) string {","+\tif req.IsDeleted {","+\t\treturn \"trash\"","+\t}","+\tif len(req.Facet) > 0 {","+\t\treturn \"facets\"","+\t}","+\tif req.Limit == 0 {","+\t\treturn \"count\"","+\t}","+\treturn \"page\"","+}","+","+func (o *searchAuthObservation) observe(mode, queryType string, started time.Time, result *resourcepb.ResourceSearchResponse, err error) {","+\toutcome := \"success\"","+\tif err != nil || result == nil || result.Error != nil {","+\t\toutcome = \"error\"","+\t} else {","+\t\treturned := len(result.Rows)","+\t\tif result.Results != nil {","+\t\t\treturned = len(result.Results.Rows)","+\t\t}","+\t\to.metrics.SearchAuthReturned.WithLabelValues(mode, queryType).Observe(float64(returned))","+\t}","+\to.metrics.SearchAuthDuration.WithLabelValues(mode, queryType, outcome).Observe(time.Since(started).Seconds())","+\to.metrics.SearchAuthChecks.WithLabelValues(mode, queryType).Observe(float64(o.checks.Load()))","+}","+","+type observedSearchAccessClient struct {","+\tauthlib.AccessClient","+\tobservation *searchAuthObservation","+}","+","+func (c *observedSearchAccessClient) Check(ctx context.Context, id authlib.AuthInfo, req authlib.CheckRequest, folder string) (authlib.CheckResponse, error) {","+\tc.observation.checks.Add(1)","+\treturn c.AccessClient.Check(ctx, id, req, folder)","+}","+","+func (c *observedSearchAccessClient) BatchCheck(ctx context.Context, id authlib.AuthInfo, req authlib.BatchCheckRequest) (authlib.BatchCheckResponse, error) {","+\tc.observation.checks.Add(int64(len(req.Checks)))","+\treturn c.AccessClient.BatchCheck(ctx, id, req)","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/search/search_auth_metrics_test.go","lines":["@@ -0,0 +1,146 @@","+package search_test","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"fmt\"","+\t\"testing\"","+\t\"time\"","+","+\tauthlib \"github.com/grafana/authlib/types\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\tdto \"github.com/prometheus/client_model/go\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search\"","+)","+","+func newAuthMetricsIndex(t *testing.T, postRank bool, cfg search.PostRankAuthzConfig) (resource.ResourceIndex, *resource.BleveIndexMetrics) {","+\tt.Helper()","+\tmetrics := resource.ProvideIndexMetrics(prometheus.NewRegistry())","+\tbackend, err := search.NewBleveBackend(search.BleveOptions{","+\t\tRoot: t.TempDir(), FileThreshold: threshold,","+\t\tPostRankAuthzEnabled: postRank, PostRankAuthz: cfg,","+\t\tSearchFields: resource.NewSearchFieldsRegistry(nil, nil, map[resource.LowerGroupResource]resource.SearchFieldsProvider{","+\t\t\tresource.NewLowerGroupResource(\"dashboard.grafana.app\", \"dashboards\"): search.DashboardSearchFieldsProviderForTest(),","+\t\t}),","+\t}, metrics)","+\trequire.NoError(t, err)","+\tt.Cleanup(backend.Stop)","+\tindex, err := backend.BuildIndex(context.Background(), postRankKey, 100, \"test\", noop, nil, false, time.Time{}, 0)","+\trequire.NoError(t, err)","+\tfor i := range 100 {","+\t\tindexDocs(t, index, []*resource.BulkIndexItem{newDocWithTags(fmt.Sprintf(\"doc-%03d\", i), \"allowed\", []string{\"tag\"})})","+\t}","+\treturn index, metrics","+}","+","+func authHistogram(t *testing.T, vec *prometheus.HistogramVec, labels ...string) *dto.Histogram {","+\tt.Helper()","+\tmetric := &dto.Metric{}","+\trequire.NoError(t, vec.WithLabelValues(labels...).(prometheus.Metric).Write(metric))","+\treturn metric.GetHistogram()","+}","+","+func TestSearchAuthMetricsModes(t *testing.T) {","+\tfor _, mode := range []string{\"pre_rank\", \"post_rank\", \"none\"} {","+\t\tt.Run(mode, func(t *testing.T) {","+\t\t\tindex, metrics := newAuthMetricsIndex(t, mode != \"pre_rank\", search.PostRankAuthzConfig{})","+\t\t\tclient := &countingAccessClient{allowAll: true}","+\t\t\tvar access authlib.AccessClient = client","+\t\t\tif mode == \"none\" {","+\t\t\t\taccess = nil","+\t\t\t}","+\t\t\tnames, _ := searchNames(t, index, access, listQuery(10))","+\t\t\trequire.Len(t, names, 10)","+\t\t\trequire.EqualValues(t, 1, authHistogram(t, metrics.SearchAuthDuration, mode, \"page\", \"success\").GetSampleCount())","+\t\t\trequire.EqualValues(t, 10, authHistogram(t, metrics.SearchAuthReturned, mode, \"page\").GetSampleSum())","+\t\t\trequire.EqualValues(t, client.checked, authHistogram(t, metrics.SearchAuthChecks, mode, \"page\").GetSampleSum())","+\t\t\tswitch mode {","+\t\t\tcase \"pre_rank\":","+\t\t\t\trequire.Equal(t, 100, client.checked)","+\t\t\tcase \"post_rank\":","+\t\t\t\trequire.Positive(t, client.checked)","+\t\t\t\trequire.Less(t, client.checked, 100, \"PostRank must stop before authorizing the entire result set\")","+\t\t\tcase \"none\":","+\t\t\t\trequire.Zero(t, client.checked)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestSearchAuthMetricsBudgets(t *testing.T) {","+\tfor _, facets := range []bool{false, true} {","+\t\tt.Run(fmt.Sprintf(\"facets=%v\", facets), func(t *testing.T) {","+\t\t\tindex, metrics := newAuthMetricsIndex(t, true, search.PostRankAuthzConfig{MaxCandidates: 20, FacetSampleSize: 20})","+\t\t\tclient := &countingAccessClient{allowAll: true}","+\t\t\tquery := listQuery(0)","+\t\t\tkind, reason := \"count\", \"candidate_budget\"","+\t\t\tif facets {","+\t\t\t\tquery = listQuery(10)","+\t\t\t\tquery.Facet = map[string]*resourcepb.ResourceSearchRequest_Facet{\"tags\": {Field: \"tags\", Limit: 10}}","+\t\t\t\tkind, reason = \"facets\", \"facet_budget\"","+\t\t\t}","+\t\t\t_, response := searchNames(t, index, client, query)","+\t\t\trequire.False(t, response.TotalHitsExact)","+\t\t\trequire.EqualValues(t, 1, testutil.ToFloat64(metrics.SearchAuthEvents.WithLabelValues(reason)))","+\t\t\trequire.EqualValues(t, client.checked, authHistogram(t, metrics.SearchAuthChecks, \"post_rank\", kind).GetSampleSum(), \"include both facet and page authorization passes\")","+\t\t\trequire.EqualValues(t, 1, authHistogram(t, metrics.SearchAuthDuration, \"post_rank\", kind, \"success\").GetSampleCount())","+\t\t})","+\t}","+}","+","+type failingSearchAccessClient struct{ authlib.AccessClient }","+","+func (failingSearchAccessClient) BatchCheck(context.Context, authlib.AuthInfo, authlib.BatchCheckRequest) (authlib.BatchCheckResponse, error) {","+\treturn authlib.BatchCheckResponse{}, errors.New(\"authz unavailable\")","+}","+","+func TestSearchAuthMetricsFailure(t *testing.T) {","+\tfor _, mode := range []string{\"pre_rank\", \"post_rank\"} {","+\t\tt.Run(mode, func(t *testing.T) {","+\t\t\tindex, metrics := newAuthMetricsIndex(t, mode == \"post_rank\", search.PostRankAuthzConfig{})","+\t\t\trequester := &identity.StaticRequester{Type: authlib.TypeUser, UserID: 1, Namespace: postRankKey.Namespace}","+\t\t\tctx := authlib.WithAuthInfo(context.Background(), requester)","+\t\t\t_, err := index.Search(ctx, failingSearchAccessClient{}, listQuery(10), nil, nil)","+\t\t\trequire.Error(t, err)","+\t\t\trequire.EqualValues(t, 1, authHistogram(t, metrics.SearchAuthDuration, mode, \"page\", \"error\").GetSampleCount())","+\t\t\trequire.Positive(t, authHistogram(t, metrics.SearchAuthChecks, mode, \"page\").GetSampleSum())","+\t\t\trequire.Zero(t, authHistogram(t, metrics.SearchAuthReturned, mode, \"page\").GetSampleCount())","+\t\t})","+\t}","+}","+","+func TestSearchAuthMetricsCursorFallback(t *testing.T) {","+\tindex, metrics := newAuthMetricsIndex(t, true, search.PostRankAuthzConfig{})","+\tquery := listQuery(10)","+\tquery.SearchAfter = []string{\"doc-000\", \"doc-000\"}","+\t_, response := searchNames(t, index, &countingAccessClient{allowAll: true}, query)","+\trequire.NotNil(t, response)","+\trequire.EqualValues(t, 1, testutil.ToFloat64(metrics.SearchAuthEvents.WithLabelValues(\"cursor_fallback\")))","+\trequire.EqualValues(t, 1, authHistogram(t, metrics.SearchAuthDuration, \"pre_rank\", \"page\", \"success\").GetSampleCount())","+\trequire.Zero(t, authHistogram(t, metrics.SearchAuthDuration, \"post_rank\", \"page\", \"success\").GetSampleCount())","+}","+","+func TestSearchAuthMetricsFieldValues(t *testing.T) {","+\tfor _, mode := range []string{\"pre_rank\", \"post_rank\"} {","+\t\tt.Run(mode, func(t *testing.T) {","+\t\t\tindex, metrics := newAuthMetricsIndex(t, mode == \"post_rank\", search.PostRankAuthzConfig{})","+\t\t\trequester := &identity.StaticRequester{Type: authlib.TypeUser, UserID: 1, Namespace: postRankKey.Namespace}","+\t\t\tctx := authlib.WithAuthInfo(context.Background(), requester)","+\t\t\tquery := listQuery(10)","+\t\t\tquery.ResultFormat = resourcepb.ResourceSearchRequest_FIELD_VALUES","+\t\t\tresponse, err := index.Search(ctx, &countingAccessClient{allowAll: true}, query, nil, nil)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Nil(t, response.Error)","+\t\t\trequire.Nil(t, response.Results)","+\t\t\trequire.Len(t, response.Rows, 10)","+\t\t\trequire.EqualValues(t, 10, authHistogram(t, metrics.SearchAuthReturned, mode, \"page\").GetSampleSum())","+\t\t\trequire.EqualValues(t, 1, authHistogram(t, metrics.SearchAuthDuration, mode, \"page\", \"success\").GetSampleCount())","+\t\t})","+\t}","+}",""],"additions":146,"deletions":0,"truncated":false}],"additions":264,"deletions":1,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-09T15:15:01.254567+00:00"}