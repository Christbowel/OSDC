{"id":"3cd3893a3805ef2760584fe6650c06beb3d43dcb","axis":"silent","repo":"grafana/grafana","sha":"3cd3893a3805ef2760584fe6650c06beb3d43dcb","parsed":{"files":[{"path":"pkg/storage/unified/resource/bleve_index_metrics.go","lines":["@@ -8,6 +8,10 @@ import ("," )"," "," type BleveIndexMetrics struct {","+\tSearchAuthDuration   *prometheus.HistogramVec","+\tSearchAuthReturned   *prometheus.HistogramVec","+\tSearchAuthChecks     *prometheus.HistogramVec","+\tSearchAuthEvents     *prometheus.CounterVec"," \tIndexSize            prometheus.Gauge"," \tIndexedKinds         *prometheus.GaugeVec"," \tIndexCreationTime    *prometheus.HistogramVec","@@ -82,7 +86,23 @@ var IndexCreationBuckets = []float64{1, 5, 10, 25, 50, 75, 100, 200, 300, 400, 5"," // ProvideIndexMetrics builds the index metrics. A nil reg leaves them"," // unregistered, so callers without a registry never have to check for nil."," func ProvideIndexMetrics(reg prometheus.Registerer) *BleveIndexMetrics {","+\thistogram := func(name, help string, labels ...string) *prometheus.HistogramVec {","+\t\treturn promauto.With(reg).NewHistogramVec(prometheus.HistogramOpts{","+\t\t\tName:                            name,","+\t\t\tHelp:                            help,","+\t\t\tNativeHistogramBucketFactor:     1.1,","+\t\t\tNativeHistogramMaxBucketNumber:  160,","+\t\t\tNativeHistogramMinResetDuration: time.Hour,","+\t\t}, labels)","+\t}"," \tm := &BleveIndexMetrics{","+\t\tSearchAuthDuration: histogram(\"grafana_index_server_search_auth_execution_duration_seconds\", \"Search execution duration after request validation, including authorization, ranking and response conversion, by actual auth mode (pre_rank, post_rank, none), query type and outcome. Count is executed searches, not incoming RPCs.\", \"mode\", \"query_type\", \"outcome\"),","+\t\tSearchAuthReturned: histogram(\"grafana_index_server_search_auth_returned_documents\", \"Documents returned per successful executed search.\", \"mode\", \"query_type\"),","+\t\tSearchAuthChecks:   histogram(\"grafana_index_server_search_auth_checks\", \"Check items submitted through Check and BatchCheck per executed search, including failed calls. Excludes Compile and is not a network RPC count.\", \"mode\", \"query_type\"),","+\t\tSearchAuthEvents: promauto.With(reg).NewCounterVec(prometheus.CounterOpts{","+\t\t\tName: \"grafana_index_server_search_auth_events_total\",","+\t\t\tHelp: \"Search auth events: cursor_fallback selects PreRank instead of PostRank; candidate_budget and facet_budget indicate a PostRank scan stopped at its scan limit, without guaranteeing that more matches remain.\",","+\t\t}, []string{\"reason\"}),"," \t\tIndexSize: promauto.With(reg).NewGauge(prometheus.GaugeOpts{"," \t\t\tName: \"grafana_index_server_index_size_bytes\","," \t\t\tHelp: \"Size of the index in bytes - only for file-based indices\","],"additions":20,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/search/bleve.go","lines":["@@ -2356,7 +2356,7 @@ func (b *bleveIndex) Search("," \treq *resourcepb.ResourceSearchRequest,"," \tfederate []resource.ResourceIndex, // For federated queries, these will match the values in req.federate"," \tstats *resource.SearchStats,","-) (response *resourcepb.ResourceSearchResponse, _ error) {","+) (response *resourcepb.ResourceSearchResponse, resultErr error) {"," \tctx, span := tracer.Start(ctx, \"search.bleveIndex.Search\")"," \tdefer span.End()"," ","@@ -2383,6 +2383,8 @@ func (b *bleveIndex) Search("," \t// the match set, otherwise Bleve's unfiltered count with"," \t// TotalHitsExact=false."," \tpostRank := b.postRankAuthzEnabled && access != nil","+\taccess, authMetrics := withSearchAuthObservation(access, b.indexMetrics)","+\tcursorFallback := false"," "," \t// A trash search replaces the read check with the trash rule on whichever authz"," \t// path runs. Built once per request, because it caches folder-admin results.","@@ -2440,6 +2442,7 @@ func (b *bleveIndex) Search("," \t}"," \tif postRank && cursorLen >