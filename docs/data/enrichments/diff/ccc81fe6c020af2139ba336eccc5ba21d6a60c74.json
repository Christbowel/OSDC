{"id":"ccc81fe6c020af2139ba336eccc5ba21d6a60c74","axis":"silent","repo":"tensorflow/tensorflow","sha":"ccc81fe6c020af2139ba336eccc5ba21d6a60c74","parsed":{"files":[{"path":"third_party/xla/xla/backends/gpu/codegen/triton/tests/reduce/reduce_tiled_block_config.hlo","lines":["@@ -0,0 +1,52 @@","+// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation %s | FileCheck %s","+// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation --abs_error_bound=1e-7 --rel_error_bound=1e-7 %s","+","+// Same as reduce_tiled.hlo, but the reduction tile size comes from","+// `sequential_tile_sizes` in the block-level fusion config instead of the","+// backend config of the reduce instruction.","+","+region {","+  p0 = f32[] parameter(0)","+  p1 = f32[] parameter(1)","+  ROOT add = f32[] add(p0, p1)","+}","+","+fusion {","+  p = f32[8,16] parameter(0)","+  c = f32[] constant(0)","+  ROOT reduce = f32[8] reduce(p, c), dimensions={1}, to_apply=region","+}","+","+ENTRY main {","+  p = f32[8,16] parameter(0)","+  ROOT fusion = f32[8] fusion(p), kind=kCustom, calls=fusion,","+    backend_config={","+      \"fusion_backend_config\":{","+        \"kind\":\"__triton\",","+        \"block_level_fusion_config\":{","+          \"output_tiles\":[{\"sizes\":[\"4\"]}],","+          \"sequential_tile_sizes\":[\"4\"],","+          \"num_warps\":\"1\",","+          \"num_ctas\":\"1\",","+          \"num_stages\":\"1\"}}}","+}","+","+// CHECK-DAG:  %[[C0:.*]] = arith.constant 0 : index","+// CHECK-DAG:  %[[C4:.*]] = arith.constant 4 : index","+// CHECK-DAG:  %[[C1:.*]] = arith.constant 1 : index","+// CHECK-DAG:  %[[INIT:.*]] = arith.constant dense<0.000000e+00> : tensor<4x4xf32>","+","+// CHECK: %[[FOR:.*]] = scf.for %[[IV:.*]] = %[[C0]] to %[[C4]] step %[[C1]]","+// CHECK-SAME: iter_args(%[[ACC:.*]] = %[[INIT]]) -> (tensor<4x4xf32>) {","+","+// CHECK:   %[[OFFSET_P:.*]] = xla.apply_indexing","+// CHECK:   %[[OFFSET_R:.*]] = xla.apply_indexing","+// CHECK:   %[[EXTRACT:.*]] = xtile.extract %{{.*}}[%[[OFFSET_P]], %[[OFFSET_R]]] [4, 4]","+// CHECK:   %[[COMBINE:.*]] = arith.addf %[[ACC]], %[[EXTRACT]] : tensor<4x4xf32>","+// CHECK:   scf.yield %[[COMBINE]] : tensor<4x4xf32>","+// CHECK: }","+// CHECK: %[[REDUCE:.*]] = \"tt.reduce\"(%[[FOR]]) <{axis = 1 : i32}> ({","+// CHECK: ^bb0(%[[ARG0:.*]]: f32, %[[ARG1:.*]]: f32):","+// CHECK:   %[[SUM:.*]] = arith.addf %[[ARG0]], %[[ARG1]] : f32","+// CHECK:   tt.reduce.return %[[SUM]] : f32","+// CHECK: }) : (tensor<4x4xf32>) -> tensor<4xf32>"],"additions":52,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/codegen/tiling/experimental/tiling_space.cc","lines":["@@ -751,6 +751,12 @@ int64_t TilingSpace::num_parallel_dimensions() const {","   });"," }"," ","+int64_t TilingSpace::num_sequential_dimensions() const {","+  return absl::c_count_if(dimensions_, [](const DimensionInfo& dim) {","+    return dim.type == DimensionSemantics::kSequential;","+  });","+}","+"," void TilingSpace::InitSimplificationIndexing() {","   CHECK(!is_symbolic_) << \"Tile sizes must be assigned before initializing \"","                           \"cached indexing map variables.\";","@@ -821,24 +827,35 @@ TilingSpace::SimplificationResult TilingSpace::SimplifyExpressions("," }"," "," absl::StatusOr<std::vector<llvm::SmallVector<int64_t, 4>>>","-TilingSpace::GetValidTilings() {","+TilingSpace::GetValidTilings(bool tile_reduction_dimensions) {","   // TODO: b/511080616 - returned tilings should be valid. Right now we return","   // all possible tilings and rely on the downstream to check the validity.","   llvm::SmallVector<int64_t, 4> input_space;"," ","-  // Sequential reduce dimensions are not tiled yet. To work around the","-  // limitation of `GetFlatTilingsForInputSpace`, we set the tile size to 1 here","-  // and later replace with the actual dimension size.","+  // TODO(b/534676634): Lift this condition once multi-reduction and","+  // multi-dimension reduction fusions are supported.","+  // Reduction dimensions are only tiled when requested and the fusion has a","+  // single reduce that reduces a single dimension. Otherwise, sequential reduce","+  // dimensions are not tiled. To work around the limitation of","+  // `GetFlatTilingsForInputSpace`, we set the tile size to 1 here and later","+  // replace with the actual dimension size.","+  const int64_t num_reduction_dims =","+      absl::c_count_if(dimensions_, [](const DimensionInfo& dim) {","+        return dim.type == DimensionSemantics::kSequential &&","+               dim.hlo->opcode() == HloOpcode::kReduce;","+      });","+  const bool tile_reduction_dims =","+      tile_reduction_dimensions && num_reduction_dims == 1;","+  auto is_untiled_dim = [&](const DimensionInfo& dim) {","+    return !tile_reduction_dims &&","+           dim.type == DimensionSemantics::kSequential &&","+           dim.hlo->opcode() == HloOpcode::kReduce;","+  };","   for (const auto& dim : dimensions_) {","     if (dim.type == DimensionSemantics::kReplica) {","       continue;","     }","-    if (dim.type == DimensionSemantics::kSequential &&","-        dim.hlo->opcode() == HloOpcode::kReduce) {","-      input_space.push_back(1);","-    } else {","-      input_space.push_back(dim.dimension_size);","-    }","+    input_space.push_back(is_untiled_dim(dim) ? 1 : dim.dimension_size);","   }"," ","   ABSL_ASSIGN_OR_RETURN(auto flat_tilings, GetFlatTilingsForInputSpace(input_space));","@@ -849,8 +866,7 @@ TilingSpace::GetValidTilings() {","       if (dim.type == DimensionSemantics::kReplica) {","         continue;","       }","-      if (dim.type == DimensionSemantics::kSequential &&","-          dim.hlo->opcode() == HloOpcode::kReduce) {","+      if (is_untiled_dim(dim)) {","         flat_tiling[idx] = dim.dimension_size;","       }","       ++idx;"],"additions":28,"deletions":12,"truncated":false},{"path":"third_party/xla/xla/codegen/tiling/experimental/tiling_space.h","lines":["@@ -201,6 +201,7 @@ class TilingSpace {"," ","   int64_t num_dimensions() const { return dimensions_.size(); }","   int64_t num_parallel_dimensions() const;","+  int64_t num_sequential_dimensions() const;","   int64_t num_rt_vars() const { return rt_vars_.size(); }"," ","   void AppendDimension(const HloInstruction* hlo, int64_t dim_position,","@@ -243,8 +244,12 @@ class TilingSpace {","       const llvm::SmallVector<SymbolicExpr>& expressions,","       llvm::ArrayRef<std::pair<SymbolicExpr, Interval>> constraints = {}) const;"," ","-  // Returns the list of valid tilings for the tiling space.","-  absl::StatusOr<std::vector<llvm::SmallVector<int64_t, 4>>> GetValidTilings();","+  // Returns the list of valid tilings for the tiling space. If","+  // `tile_reduction_dimensions` is set, tile sizes for the sequential","+  // dimensions of reduces are enumerated too; otherwise each of them is covered","+  // by a single tile of the dimension size.","+  absl::StatusOr<std::vector<llvm::SmallVector<int64_t, 4>>> GetValidTilings(","+      bool tile_reduction_dimensions = false);"," ","  private:","   absl::Status InitializeDimensions("],"additions":7,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/codegen/tiling/experimental/tiling_space_test.cc","lines":["@@ -1113,5 +1113,99 @@ TEST_F(TilingSpaceTest,","   }"," }"," ","+TEST_F(TilingSpaceTest, GetValidTilingsTilesReductionDimOfSingleDimReduce) {","+  HloInstruction* root = ParseAndGetRoot(R\"(","+      HloModule m","+      add {","+        p0 = f32[] parameter(0)","+        p1 = f32[] parameter(1)","+        ROOT res = f32[] add(p0, p1)","+      }","+      ENTRY e {","+        p0 = f32[2,4] parameter(0)","+        c0 = f32[] constant(0)","+        ROOT r = f32[2] reduce(p0, c0), dimensions={1}, to_apply=add","+      }","+  )\");","+  auto fusion_adaptor = HloFusionAdaptor::ForInstruction(root);","+  ASSERT_OK_AND_ASSIGN(auto tiling_space,","+                       TilingSpace::Create(*fusion_adaptor, &mlir_context_));","+  ASSERT_OK_AND_ASSIGN(","+      auto valid_tilings,","+      tiling_space->GetValidTilings(/*tile_reduction_dimensions=*/true));","+  EXPECT_THAT(valid_tilings, ElementsAre(ElementsAre(1, 1), ElementsAre(1, 2),","+                                         ElementsAre(1, 4), ElementsAre(2, 1),","+                                         ElementsAre(2, 2), ElementsAre(2, 4)));","+","+  // By default, the reduction dimension is covered by a single tile.","+  ASSERT_OK_AND_ASSIGN(auto untiled_valid_tilings,","+                       tiling_space->GetValidTilings());","+  EXPECT_THAT(untiled_valid_tilings,","+              ElementsAre(ElementsAre(1, 4), ElementsAre(2, 4)));","+}","+","+// TODO(b/534676634): Remove this test once tiling reduction dimensions of","+// multi-reduction fusions is supported.","+TEST_F(TilingSpaceTest,","+       GetValidTilingsDoesNotTileReductionDimsOfMultipleReduces) {","+  HloInstruction* root = ParseAndGetRoot(R\"(","+      HloModule m","+      add {","+        p0 = f32[] parameter(0)","+        p1 = f32[] parameter(1)","+        ROOT res = f32[] add(p0, p1)","+      }","+      fused_computation {","+        p0 = f32[2,4,8] parameter(0)","+        c0 = f32[] constant(0)","+        r0 = f32[2,4] reduce(p0, c0), dimensions={2}, to_apply=add","+        ROOT r1 = f32[2] reduce(r0, c0), dimensions={1}, to_apply=add","+      }","+      ENTRY e {","+        p0 = f32[2,4,8] parameter(0)","+        ROOT fusion = f32[2] fusion(p0), kind=kLoop, calls=fused_computation","+      }","+  )\");","+  auto fusion_adaptor = HloFusionAdaptor::ForInstruction(root);","+  ASSERT_OK_AND_ASSIGN(auto tiling_space,","+                       TilingSpace::Create(*fusion_adaptor, &mlir_context_));","+  ASSERT_OK_AND_ASSIGN(","+      auto valid_tilings,","+      tiling_space->GetValidTilings(/*tile_reduction_dimensions=*/true));","+  // Dimensions are ordered use-before-def: r1's reduction dimension (4) comes","+  // before r0's (8). Both are kept at their full size.","+  EXPECT_THAT(valid_tilings,","+              ElementsAre(ElementsAre(1, 4, 8), ElementsAre(2, 4, 8)));","+}","+","+// TODO(b/534676634): Remove this test once tiling reduction dimensions of","+// multi-dimension reductions is supported.","+TEST_F(TilingSpaceTest,","+       GetValidTilingsDoesNotTileReductionDimsOfMultiDimReduce) {","+  HloInstruction* root = ParseAndGetRoot(R\"(","+      HloModule m","+      add {","+        p0 = f32[] parameter(0)","+        p1 = f32[] parameter(1)","+        ROOT res = f32[] add(p0, p1)","+      }","+      ENTRY e {","+        p0 = f32[2,4,8] parameter(0)","+        c0 = f32[] constant(0)","+        ROOT r = f32[2] reduce(p0, c0), dimensions={1,2}, to_apply=add","+      }","+  )\");","+  auto fusion_adaptor = HloFusionAdaptor::ForInstruction(root);","+  ASSERT_OK_AND_ASSIGN(auto tiling_space,","+                       TilingSpace::Create(*fusion_adaptor, &mlir_context_));","+  ASSERT_OK_AND_ASSIGN(","+      auto valid_tilings,","+      tiling_space->GetValidTilings(/*tile_reduction_dimensions=*/true));","+  // Multi-dimension reductions keep both reduction dimensions at their full","+  // size.","+  EXPECT_THAT(valid_tilings,","+              ElementsAre(ElementsAre(1, 4, 8), ElementsAre(2, 4, 8)));","+}","+"," }  // namespace"," }  // namespace xla::gpu::experimental"],"additions":94,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/codegen/xtile/block_level_parameters.h","lines":["@@ -40,6 +40,10 @@ struct BlockLevelParameters {","   int num_tiles_per_pid = 1;","   int waves_per_eu = 0;"," ","+  // Tile sizes of the sequential dimensions, in tiling space order. Empty when","+  // sequential tile sizes are not set in the fusion config.","+  std::vector<int64_t> sequential_tile_sizes;","+","   // Returns a BlockLevelParameters struct from a BlockLevelFusionConfig proto.","   static BlockLevelParameters FromBlockLevelFusionConfig(","       const xla::xtile::BlockLevelFusionConfig& config) {","@@ -57,6 +61,8 @@ struct BlockLevelParameters {","       result.