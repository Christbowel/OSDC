","+    has_clang_input = False","+    for path in input_paths:","+        if \"windows_rc_action_test_clang\" in path:","+            has_clang_input = True","+            break","+    asserts.true(","+        env,","+        has_clang_input,","+        \"WindowsRC must stage clang for llvm-rc preprocessing\",","+    )","+    has_windows_sdk_header = False","+    for path in input_paths:","+        if \"winres.h\" in path:","+            has_windows_sdk_header = True","+            break","+    asserts.true(","+        env,","+        has_windows_sdk_header,","+        \"WindowsRC must stage Windows SDK headers for resource preprocessing\",","+    )","+    has_windows_sdk_include = False","+    for argument in action.argv:","+        if \"sysroot/winsdk/include/um\" in argument or \"sysroot\\\\winsdk\\\\include\\\\um\" in argument:","+            has_windows_sdk_include = True","+            break","+    asserts.true(","+        env,","+        has_windows_sdk_include,","+        \"WindowsRC must pass the Windows SDK include directory to llvm-rc\",","+    )","+    has_generated_include = False","+    for argument in action.argv:","+        if \"bazel-out\" in argument and argument.endswith(\"/src\"):","+            has_generated_include = True","+            break","+    asserts.true(","+        env,","+        has_generated_include,","+        \"WindowsRC must use a forward-slash generated-source include directory\",","+    )","+    asserts.true(","+        env,","+        \"bazel-out\" in action.env.get(\"PATH\", \"\"),","+        \"WindowsRC PATH must include the hermetic LLVM tools directory\",","+    )","+    for variable in [\"TEMP\", \"TMP\", \"TMPDIR\"]:","+        asserts.equals(","+            env,","+            \"/tmp\",","+            action.env.get(variable),","+            \"WindowsRC must use a temporary directory on the Linux worker\",","+        )","+    has_rewritten_source = False","+    for path in input_paths:","+        if path.endswith(\"_windows_cross.rc\"):","+            has_rewritten_source = True","+            break","+    asserts.true(","+        env,","+        has_rewritten_source,","+        \"WindowsRC must rewrite resource paths to staged Bazel inputs\",","+    )","+    return analysistest.end(env)","+","+windows_rc_action_analysis_test = analysistest.make(","+    _windows_rc_action_test_impl,","+    config_settings = {","+        \"//command_line_option:platforms\": \"@@//bazel/platforms:windows_x86_64_cross\",","+    },","+)","+","+def _windows_rc_native_action_test_impl(ctx):","+    env = analysistest.begin(ctx)","+    actions = [","+        action","+        for action in analysistest.target_actions(env)","+        if action.mnemonic == \"WindowsRC\"","+    ]","+    asserts.equals(env, 1, len(actions))","+    action = actions[0]","+    asserts.true(env, action.argv[-1].endswith(\"windows_rc_action_test.rc\"))","+    input_paths = [file.path for file in action.inputs.to_list()]","+    asserts.false(env, any([path.endswith(\"_windows_cross.rc\") for path in input_paths]))","+    for variable in [\"PATH\", \"LD_LIBRARY_PATH\", \"TEMP\", \"TMP\", \"TMPDIR\"]:","+        asserts.false(env, variable in action.env, \"Native WindowsRC must retain its environment\")","+    return analysistest.end(env)","+","+windows_rc_native_action_analysis_test = analysistest.make(","+    _windows_rc_native_action_test_impl,","+    config_settings = {","+        \"//command_line_option:platforms\": \"@@//bazel/platforms:windows_amd64\",","+    },","+)"],"additions":121,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_action_test.rc","lines":["@@ -0,0 +1,8 @@","+#include <winres.h>","+1 VERSIONINFO","+FILEVERSION 1,0,0,0","+PRODUCTVERSION 1,0,0,0","+BEGIN","+END","+","+1 RCDATA \"mongo/db/mongo.ico\""],"additions":8,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_action_test_clang","lines":["@@ -0,0 +1 @@","+test clang input"],"additions":1,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_action_test_rc.sh","lines":["@@ -0,0 +1,2 @@","+#!/bin/sh","+exit 0"],"additions":2,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_helpers.bzl","lines":["@@ -0,0 +1,84 @@","+\"\"\"Helpers for resource compilation with the Windows cross toolchain.\"\"\"","+","+_WINDOWS_CROSS_RC_INCLUDE_DIRS = [","+    \"msvc/include\",","+    \"msvc/atlmfc/include\",","+    \"winsdk/include/ucrt\",","+    \"winsdk/include/shared\",","+    \"winsdk/include/um\",","+    \"winsdk/include/winrt\",","+    \"winsdk/include/cppwinrt\",","+]","+","+def windows_cross_rc_include_dirs(ctx):","+    \"\"\"Returns Windows cross sysroot include directories from staged files.\"\"\"","+    if not ctx.files.rc_sysroot:","+        return []","+","+    sysroot = None","+    separator = \"/\"","+    for file in ctx.files.rc_sysroot:","+        if \"/sysroot/\" in file.path:","+            sysroot = file.path.split(\"/sysroot/\", 1)[0] + \"/sysroot\"","+            break","+        if \"\\\\sysroot\\\\\" in file.path:","+            sysroot = file.path.split(\"\\\\sysroot\\\\\", 1)[0] + \"\\\\sysroot\"","+            separator = \"\\\\\"","+            break","+","+    if sysroot == None:","+        fail(\"windows_rc: rc_sysroot files are not under a sysroot directory\")","+","+    return [","+        sysroot + separator + relative.replace(\"/\", separator)","+        for relative in _WINDOWS_CROSS_RC_INCLUDE_DIRS","+    ]","+","+def windows_cross_rc_source(ctx):","+    \"\"\"Creates an RC source with paths to Bazel's staged resource inputs.\"\"\"","+    substitutions = {}","+    for resource in ctx.files.resources:","+        short_path = resource.short_path.replace(\"\\\\\", \"/\")","+        if short_path.startswith(\"src/\"):","+            logical_path = short_path[len(\"src/\"):]","+        else:","+            path_parts = short_path.split(\"/src/\")","+            if len(path_parts) == 1:","+                continue","+            logical_path = path_parts[-1]","+","+        # Headers are found through the include search path. Rewriting an","+        # #include to a path relative to the generated RC source makes Clang","+        # look below the RC output directory and fail to find the header.","+        if logical_path.endswith(\".h\"):","+            continue","+","+        substitutions[logical_path] = resource.path.replace(\"\\\\\", \"/\")","+","+    if not substitutions:","+        return ctx.file.src","+","+    rc_source = ctx.actions.declare_file(ctx.label.name + \"_windows_cross.rc\")","+    ctx.actions.expand_template(","+        template = ctx.file.src,","+        output = rc_source,","+        substitutions = substitutions,","+    )","+    return rc_source","+","+def windows_cross_rc_library_dirs(files):","+    \"\"\"Returns loader paths for the bundled shared libraries staged with RC tools.\"\"\"","+    runtime_dirs = {}","+    archive_dirs = {}","+    for file in files:","+        if not (file.basename.endswith(\".so\") or \".so.\" in file.basename):","+            continue","+        directory = file.dirname.replace(\"\\\\\", \"/\")","+","+        # Windows archive extraction can leave placeholder symlinks in llvm/lib.","+        # Prefer the regular library copies prepared by the toolchain repository.","+        if directory.endswith(\"/runtime_libs\"):","+            runtime_dirs[directory] = True","+        else:","+            archive_dirs[directory] = True","+    return sorted(runtime_dirs.keys()) + sorted(archive_dirs.keys())"],"additions":84,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_test_runtime/llvm/lib/libwindows_rc_test.so.1","lines":["@@ -0,0 +1 @@","+Analysis-only runtime library fixture."],"additions":1,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_test_runtime/runtime_libs/libwindows_rc_test.so","lines":["@@ -0,0 +1 @@","+Analysis-only runtime library fixture."],"additions":1,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_windows_cross/windows_rc_test_sysroot/sysroot/winsdk/include/um/winres.h","lines":["@@ -0,0 +1 @@","+/* Test-only Windows SDK header used to verify WindowsRC inputs. */"],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/BUILD.bazel","lines":["@@ -1,24 +1,11 @@"," load(\"//bazel:mongo_src_rules.bzl\", \"mongo_cc_library\")"," load(\"//bazel/config:generate_config_header.bzl\", \"generate_config_header\")","-load(\"@rules_python//python:defs.bzl\", \"py_library\", \"py_test\")"," "," package(default_visibility = [\"//visibility:public\"])"," ","-py_library(","-    name = \"mongo_config_header_lib\",","-    srcs = [\"mongo_config_header.py\"],","-    imports = [\".\"],","-)","-","-py_test(","-    name = \"mongo_config_header_test\",","-    srcs = [\"mongo_config_header_test.py\"],","-    deps = [\":mongo_config_header_lib\"],","-)","-"," generate_config_header(","     name = \"mongo_config_header\",","-    checks = \"mongo_config_header.py\",","+    checks = \"//bazel/config/config_header:mongo_config_header.py\",","     extra_definitions = select({","         \"//bazel/config:use_wiredtiger_enabled\": {","             \"MONGO_CONFIG_WIREDTIGER_ENABLED\": \"1\","],"additions":1,"deletions":14,"truncated":false},{"path":"src/mongo/OWNERS.yml","lines":["@@ -3,9 +3,3 @@ filters:","   - \"config.h.in\":","     approvers:","       - 10gen/server-programmability","-  - \"mongo_config_header.py\":","-    approvers:","-      - 10gen/server-programmability","-  - \"mongo_config_header_test.py\":","-    approvers:","-      - 10gen/devprod-build"],"additions":0,"deletions":6,"truncated":false},{"path":"src/mongo/shell/mongo.rc","lines":["@@ -12,7 +12,7 @@"," // remains consistent on all systems."," #define IDI_ICON2 102"," ","-IDI_ICON2               ICON                    \"mongo/db/mongo.ico\"","+