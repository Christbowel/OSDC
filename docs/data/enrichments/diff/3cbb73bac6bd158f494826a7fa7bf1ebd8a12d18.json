{"id":"3cbb73bac6bd158f494826a7fa7bf1ebd8a12d18","axis":"silent","repo":"pnpm/pnpm","sha":"3cbb73bac6bd158f494826a7fa7bf1ebd8a12d18","parsed":{"files":[{"path":".changeset/pnpr-resolve-locally-on-refusal.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+If the pnpr server refuses a setting the install uses, or cannot return the lockfile format pnpm reads, `pnpm install` and `pnpm update` print a warning and resolve locally. Cargo and Python resolution also fall back to resolving locally. pnpm now rejects a pnpr resolution of npm dependencies that does not name its lockfile format."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/pnpr-resolve-negotiation.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+The pnpr resolver refuses a request with a field it does not know, with the error code `ERR_PNPR_UNSUPPORTED_REQUEST_FIELD`. A request's `acceptedLockfileFormats` now names formats such as `pnpm-lock/9.0`. Every resolve `done` frame names the format of its lockfile in `lockfileFormat`. A streamed resolve sends a `progress` frame every 15 seconds."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps/lockfile.rs","lines":["@@ -209,9 +209,10 @@ pub(super) async fn read_or_resolve_lockfile("," /// index server-side instead of making this client fetch one index file"," /// per crate in the graph."," ///","-/// `None` when there is no server to ask, or when the one configured","-/// resolves npm alone: a server that does not serve Cargo resolution","-/// means a local resolve, not a failed install.","+/// `None` when there is no server to ask, when the one configured","+/// resolves npm alone, or when it refuses the request as one it cannot","+/// handle: a server that does not serve this Cargo resolution means a","+/// local resolve, not a failed install."," pub(super) async fn resolve_via_pnpr(config: &Config, metadata: &str) -> Result<Option<String>> {","     let Some(pnpr_server) = config.pnpr_server.as_deref().filter(|_| !config.offline) else {","         return Ok(None);","@@ -227,16 +228,19 @@ pub(super) async fn resolve_via_pnpr(config: &Config, metadata: &str) -> Result<","     // use for.","     let metadata = pnpm_cargo_resolver::resolve_inputs(metadata)","         .wrap_err(\"reduce cargo metadata for the pnpr server\")?;","-    client","-        .resolve_cargo(CargoResolveOptions {","-            metadata,","-            registry: config.cargo_index_url().to_string(),","-            authorization: config.auth_headers.for_url(pnpr_server),","-        })","-        .await","-        .into_diagnostic()","-        .wrap_err(\"resolve Cargo dependencies through the pnpr server\")","-        .map(Some)","+    let resolved = client.resolve_cargo(CargoResolveOptions {","+        metadata,","+        registry: config.cargo_index_url().to_string(),","+        authorization: config.auth_headers.for_url(pnpr_server),","+    })","+    .await;","+    match resolved {","+        Err(error) if error.is_unsupported_request() => Ok(None),","+        resolved => resolved","+            .into_diagnostic()","+            .wrap_err(\"resolve Cargo dependencies through the pnpr server\")","+            .map(Some),","+    }"," }"," "," async fn read_cargo_metadata(root_dir: &Path, checkout: Option<&Path>) -> Result<String> {"],"additions":17,"deletions":13,"truncated":false},{"path":"pnpm/crates/cli/src/cargo_deps/tests/pnpr.rs","lines":["@@ -42,7 +42,7 @@ async fn cargo_resolution_is_offloaded_to_the_pnpr_server() {","             \"registry\": CRATES_IO_SPARSE_INDEX,","         })))","         .with_header(\"content-type\", \"application/x-ndjson\")","-        .with_body(\"{\\\"type\\\":\\\"done\\\",\\\"lockfile\\\":\\\"version = 4\\\\n\\\"}\\n\")","+        .with_body(\"{\\\"type\\\":\\\"done\\\",\\\"lockfileFormat\\\":\\\"cargo-lock\\\",\\\"lockfile\\\":\\\"version = 4\\\\n\\\"}\\n\")","         .expect(1)","         .create_async()","         .await;","@@ -56,6 +56,34 @@ async fn cargo_resolution_is_offloaded_to_the_pnpr_server() {","     resolve.assert_async().await;"," }"," ","+#[tokio::test]","+async fn a_request_the_pnpr_server_refuses_resolves_locally() {","+    let mut server = mockito::Server::new_async().await;","+    let _handshake = server","+        .mock(\"GET\", \"/-/pnpr\")","+        .with_body(handshake_body(&[\"cargo\"]))","+        .create_async()","+        .await;","+    let resolve = server","+        .mock(\"POST\", \"/-/pnpr/v0/resolve\")","+        .with_status(400)","+        .with_header(\"content-type\", \"application/json\")","+        .with_body(r#\"{\"error\":\"refused\",\"code\":\"ERR_PNPR_UNSUPPORTED_REQUEST_FIELD\"}\"#)","+        .expect(1)","+        .create_async()","+        .await;","+","+    let lockfile = resolve_via_pnpr(","+        &config_for_pnpr(&server.url()),","+        r#\"{\"packages\":[],\"workspace_members\":[]}\"#,","+    )","+    .await","+    .unwrap();","+","+    assert_eq!(lockfile, None);","+    resolve.assert_async().await;","+}","+"," #[tokio::test]"," async fn configured_cargo_registry_is_sent_to_the_pnpr_server() {","     let mut server = mockito::Server::new_async().await;","@@ -71,7 +99,7 @@ async fn configured_cargo_registry_is_sent_to_the_pnpr_server() {","             \"registry\": \"https://registry.example.test/index/\",","         })))","         .with_header(\"content-type\", \"application/x-ndjson\")","-        .with_body(\"{\\\"type\\\":\\\"done\\\",\\\"lockfile\\\":\\\"version = 4\\\\n\\\"}\\n\")","+        .with_body(\"{\\\"type\\\":\\\"done\\\",\\\"lockfileFormat\\\":\\\"cargo-lock\\\",\\\"lockfile\\\":\\\"version = 4\\\\n\\\"}\\n\")","         .create_async()","         .await;","     let mut config = config_for_pnpr(&server.url());","@@ -152,7 +180,7 @@ async fn a_second_terminal_frame_fails_the_resolve() {","         .mock(\"POST\", \"/-/pnpr/v0/resolve\")","         .with_header(\"content-type\", \"application/x-ndjson\"