));","         }","         if let Some(target) = pnpr_target::<Reporter>(&state, &link).await? {","-            Box::pin(install_via_pnpr_inner::<Reporter>(&state, target, selection.as_ref(), link))","-                .await?;","+            let server = target.server;","+            let installed = Box::pin(install_via_pnpr_inner::<Reporter>(","+                &state,","+                target,","+                selection.as_ref(),","+                link,","+            ))","+            .await;","+            match installed {","+                Err(error) if resolves_locally_after::<Reporter>(&error, server) => {","+                    let link =","+                        self.resolve_link_options(state.config, &lockfile_path, frozen_lockfile);","+                    self.run_local::<Reporter>(&state, link, selection.as_ref()).await?;","+                }","+                installed => installed?,","+            }","         } else {","             self.run_local::<Reporter>(&state, link, selection.as_ref()).await?;","         }"],"additions":19,"deletions":3,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_resolution.rs","lines":["@@ -245,7 +245,36 @@ impl miette::Diagnostic for ServerErrorWithCode {","     }"," }"," ","+/// The pnpr server refused to resolve because it cannot honor a setting or","+/// the lockfile format this client sent. See","+/// [`PnprClientError::is_unsupported_request`].","+#[derive(Debug, Display, Error)]","+pub(crate) struct PnprUnsupportedRequest {","+    message: String,","+}","+","+impl miette::Diagnostic for PnprUnsupportedRequest {}","+","+/// Whether `error` is a [`PnprUnsupportedRequest`], after warning that the","+/// install resolves locally instead.","+pub(crate) fn resolves_locally_after<Reporter: self::Reporter>(","+    error: &miette::Report,","+    server: &str,","+) -> bool {","+    let Some(refusal) = error.downcast_ref::<PnprUnsupportedRequest>() else {","+        return false;","+    };","+    let server = pnpm_network::redact_url_for_display(server);","+    pnpm_reporter::emit_global_warning::<Reporter>(&format!(","+        \"Resolving dependencies locally because the pnpr server at {server} cannot handle this request: {refusal}\",","+    ));","+    true","+}","+"," fn map_pnpr_client_error(err: PnprClientError) -> miette::Report {","+    if err.is_unsupported_request() {","+        return miette::Report::new(PnprUnsupportedRequest { message: err.to_string() });","+    }","     match err {","         PnprClientError::Verification(verify_err) => miette::Report::new(verify_err),","         PnprClientError::Server { message, code: Some(code) } => {"],"additions":29,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/update/execution.rs","lines":["@@ -5,7 +5,10 @@ use super::{"," use crate::{","     cli_args::{","         ecosystem_deps::excludes_only,","-        install::{PnprLink, PnprTarget, install_selected_via_pnpr, install_via_pnpr, pnpr_target},","+        install::{","+            PnprLink, PnprTarget, install_selected_via_pnpr, install_via_pnpr, pnpr_target,","+            resolves_locally_after,","+        },","     },","     state::command_lockfile,"," };","@@ -80,9 +83,11 @@ impl UpdateArgs {","         let lockfile_path = state.lockfile_path();","         if self.can_delegate_patch_refresh(update_actions, &include_direct) {","             let link = self.pnpr_patch_link(&state, &lockfile_path);","-            if let Some(target) = pnpr_target::<Reporter>(&state, &link).await? {","-                return run_patch_refresh::<Reporter>(&state, selection.as_ref(), target, link)","-                    .await;","+            if let Some(target) = pnpr_target::<Reporter>(&state, &link).await?","+                && run_patch_refresh::<Reporter>(&state, selection.as_ref(), target, link).await?","+                    == PatchRefresh::Refreshed","+            {","+                return Ok(());","             }","         }","         let workspace_packages = match &selection {","@@ -369,16 +374,32 @@ impl UpdateArgs {","     }"," }"," ","+/// What [`run_patch_refresh`] did.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+enum PatchRefresh {","+    Refreshed,","+    /// The server refused the request, so the update resolves locally.","+    ResolveLocally,","+}","+","+/// Refresh patches through the pnpr server."," async fn run_patch_refresh<Reporter: self::Reporter + 'static>(","     state: &State,","     selection: Option<&InstallFamilySelection>,","     target: PnprTarget<'_>,","     link: PnprLink<'_>,","-) -> miette::Result<()> {","-    match selection {","+) -> miette::Result<PatchRefresh> {","+    let server = target.server;","+    let refreshed = match selection {","         Some(selection) => {","             install_selected_via_pnpr::<Reporter>(state, target, selection, link).await","         }","         None => install_via_pnpr::<Reporter>(state, target, link).await,","+    };","+    match refreshed {","+        Err(error) if resolves_locally_after::<Reporter>(&error, server) => {","+            Ok(PatchRefresh::ResolveLocally)","+        }","+        refreshed => refreshed.map(|()| PatchRefresh::Refreshed),","     }"," }"],"additions":27,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install.rs","lines":["@@ -780,5 +780,6 @@ fn pnpr_done_frame(request: &mockito::Request, mut frame: serde_json::Value) ->","         policies[\"trustPolicy\"] = Value::Null;","     }","     frame[\"appliedPolicies\"] = policies;","+    frame[\"lockfileFormat\"] = json!(\"pnpm-lock/9.0\");","     format!(\"{frame}\\n\").into_bytes()"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install/resolution.rs","lines":["@@ -305,6 +305,98 @@ fn install_via_pnpr_rejects_a_lockfile_resolved_without_add_missing_peer_types()","     drop((root, mock_instance));"," }"," ","+fn refusing_pnpr_server() -> (mockito::ServerGuard, mockito::Mock) {","+    let mut server = mockito::Server::new();","+    let resolve = server","+        .mock(\"POST\", \"/-/pnpr/v0/resolve\")","+        .with_status(400)","+        .with_header(\"content-type\", \"application/json\")","+        .with_body(","+            serde_json::json!({","+                \"error\": \"pnpr does not support the request field `projects`\",","+                \"code\": \"ERR_PNPR_UNSUPPORTED_REQUEST_FIELD\",","+            })","+            .to_string(),","+        )","+        .expect(1)","+        .create();","+    (server, resolve)","+}","+","+fn assert_resolved_locally(output: &std::process::Output, workspace: &Path) {","+    let combined = format!(","+        \"{}{}\",","+        String::from_utf8_lossy(&output.stdout),","+        String::from_utf8_lossy(&output.stderr),","+    );","+    assert!(output.status.success(), \"{combined}\");","+    assert!(combined.contains(\"Resolving dependencies locally\"), \"{combined}\");","+    assert!(workspace.join(\"node_modules/.pnpm/@foo+no-deps@1.0.0\").exists());","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"'@foo/no-deps@1.0.0'\"), \"{lockfile}\");","+}","+","+#[test]","+fn install_resolves_locally_when_pnpr_refuses_the_request() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let (server, resolve_mock) = refusing_pnpr_server();","+    let package_json = serde_json::json!({","+        \"dependencies\": { \"@foo/no-deps\": \"1.0.0\" },","+    });","+    fs::write(workspace.join(\"package.json\"), package_json.to_string())","+        .expect(\"write package.json\");","+","+    let output = pacquet","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([\"install\", \"--pnpr-server\", &server.url()])","+        .output()","+        .expect(\"run pnpm install\");","+","+    assert_resolved_locally(&output, &workspace);","+    resolve_mock.assert();","+    drop((root, mock_instance));","+}","+","+#[test]","+fn update_patches_resolves_locally_when_pnpr_refuses_the_request() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let package_json = serde_json::json!({","+        \"dependencies\": { \"@foo/no-deps\": \"1.0.0\" },","+    });","+    fs::write(workspace.join(\"package.json\"), package_json.to_string())","+        .expect(\"write package.json\");","+    pacquet","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let (server, resolve_mock) = refusing_pnpr_server();","+","+    let output = pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([\"update\", \"--patches\", \"--pnpr-server\", &server.url()])","+        .output()","+        .expect(\"run pnpm update\");","+","+    assert_resolved_locally(&output, &workspace);","+    resolve_mock.assert();","+    drop((root, mock_instance));","+}","+"," /// A pnpr-resolved lockfile is rewritten wholesale from the server's"," /// answer, so `time:` has to survive the round trip the same way a"," /// locally resolved install preserves it."],"additions":92,"deletions":0,"truncated":false},{"path":"pnpm/crates/pnpr-client/src/ecosystems.rs","lines":["@@ -1,7 +1,8 @@"," use super::{","-    CargoResolveOptions, Deserialize, MAX_ERROR_BODY_SIZE, PnprClient, PnprClientError,","-    PypiResolveOptions, RenderedViolation, VerifyError, VerifyLockfileOptions, read_ndjson_frames,","-    response_body_bounded,","+    CargoResolveOptions, Deseria