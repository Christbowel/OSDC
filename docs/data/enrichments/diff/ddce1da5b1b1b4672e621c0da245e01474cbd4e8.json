reset(IndexScanDesc scan)"," {","+\tIndexScanHeapData *hscan = (IndexScanHeapData *) scan->xs_table_opaque;","+","+\t/* Heap fetches from the last rescan don't count towards this limit */","+\thscan->xs_blkswitch_count = 0;","+"," \t/*","-\t * Resets are a no-op.","-\t *"," \t * Deliberately avoid dropping pins now held in xs_cbuf and xs_vmbuffer."," \t * This saves cycles during certain tight nested loop joins (it can avoid"," \t * repeated pinning and unpinning of the same buffer across rescans).","@@ -51,9 +108,9 @@ heapam_index_fetch_reset(IndexFetchTableData *scan)"," }"," "," void","-heapam_index_fetch_end(IndexFetchTableData *scan)","+heapam_index_scan_end(IndexScanDesc scan)"," {","-\tIndexFetchHeapData *hscan = (IndexFetchHeapData *) scan;","+\tIndexScanHeapData *hscan = (IndexScanHeapData *) scan->xs_table_opaque;"," "," \t/* drop pin if there's a pinned heap page */"," \tif (BufferIsValid(hscan->xs_cbuf))","@@ -228,38 +285,195 @@ heap_hot_search_buffer(ItemPointer tid, Relation relation, Buffer buffer,"," \treturn false;"," }"," ","-bool","-heapam_index_fetch_tuple(struct IndexFetchTableData *scan,","-\t\t\t\t\t\t ItemPointer tid,","-\t\t\t\t\t\t Snapshot snapshot,","-\t\t\t\t\t\t TupleTableSlot *slot,","-\t\t\t\t\t\t bool *heap_continue, bool *all_dead)","+/* xs_getnext_slot callback: amgettuple, plain index scan */","+static bool","+heapam_index_plain_tuple_getnext_slot(IndexScanDesc scan,","+\t\t\t\t\t\t\t\t\t  ScanDirection direction,","+\t\t\t\t\t\t\t\t\t  TupleTableSlot *slot)","+{","+\tAssert(!scan->xs_want_itup);","+\tAssert(scan->indexRelation->rd_indam->amgettuple != NULL);","+","+\treturn heapam_index_getnext_slot(scan, direction, slot, false);","+}","+","+/* xs_getnext_slot callback: amgettuple, index-only scan */","+static bool","+heapam_index_only_tuple_getnext_slot(IndexScanDesc scan,","+\t\t\t\t\t\t\t\t\t ScanDirection direction,","+\t\t\t\t\t\t\t\t\t TupleTableSlot *slot)","+{","+\tAssert(scan->xs_want_itup);","+\tAssert(scan->indexRelation->rd_indam->amgettuple != NULL);","+","+\treturn heapam_index_getnext_slot(scan, direction, slot, true);","+}","+","+/*","+ * Common implementation for both heapam_index_*_getnext_slot variants.","+ *","+ * The result is true if a tuple satisfying the scan keys and the snapshot was","+ * found, false otherwise.  This is per the table_index_getnext_slot","+ * interface.","+ *","+ * The index_only parameter is a compile-time constant at each call site,","+ * allowing the compiler to specialize the code for each variant.","+ */","+static pg_always_inline bool","+heapam_index_getnext_slot(IndexScanDesc scan, ScanDirection direction,","+\t\t\t\t\t\t  TupleTableSlot *slot, bool index_only)","+{","+\tAssert(TransactionIdIsValid(RecentXmin));","+\tAssert(index_only || scan->xs_visited_pages_limit == 0);","+","+\tfor (;;)","+\t{","+\t\tIndexScanHeapData *hscan;","+\t\tbool\t\tall_visible;","+","+\t\t/*","+\t\t * Get the next TID from the index, unless we're still working through","+\t\t * a HOT chain (index-only scans never do that, and plain index scans","+\t\t * only do it with a non-MVCC snapshot)","+\t\t */","+\t\tAssert(!index_only || !scan->xs_heap_continue);","+\t\tif (index_only || likely(!scan->xs_heap_continue))","+\t\t{","+\t\t\tif (!tableam_index_getnext_tid(scan, direction))","+\t\t\t\treturn false;","+\t\t}","+","+\t\t/* The scan's next TID was set in scan->xs_heaptid for us */","+\t\tAssert(ItemPointerIsValid(&scan->xs_heaptid));","+","+\t\thscan = (IndexScanHeapData *) scan->xs_table_opaque;","+","+\t\tif (!index_only)","+\t\t{","+\t\t\t/* Plain index scan */","+\t\t\tif (!heapam_index_heap_fetch(scan, hscan, slot, false))","+\t\t\t\tcontinue;\t\t/* no visible tuple, try next index entry */","+\t\t}","+\t\telse","+\t\t{","+\t\t\t/*","+\t\t\t * Note: VM_ALL_VISIBLE does not lock the visibility map buffer,","+\t\t\t * so the result could be slightly stale.  See the comments above","+\t\t\t * visibilitymap_get_status for why this is okay.","+\t\t\t */","+\t\t\tall_visible = VM_ALL_VISIBLE(scan->heapRelation,","+\t\t\t\t\t\t\t\t\t\t ItemPointerGetBlockNumber(&scan->xs_heaptid),","+\t\t\t\t\t\t\t\t\t\t &hscan->xs_vmbuffer);","+","+\t\t\t/* Page isn't all-visible, so verify visibility with a heap fetch */","+\t\t\tif (unlikely(!all_visible))","+\t\t\t{","+\t\t\t\tif (!heapam_index_only_heap_fetch(scan))","+\t\t\t\t{","+\t\t\t\t\t/* No visible tuple */","+\t\t\t\t\tif (heapam_index_visited_pages_exceeded(scan))","+\t\t\t\t\t\treturn false;\t/* give up */","+","+\t\t\t\t\tcontinue;\t/* try next index entry */","+\t\t\t\t}","+\t\t\t}","+\t\t\telse","+\t\t\t{","+\t\t\t\t/*","+\t\t\t\t * Index-only scan with all-visible item.","+\t\t\t\t *","+\t\t\t\t * We won't access the heap, so we'll need to take a predicate","+\t\t\t\t * lock explicitly, as if we had.  For now we do that at page","+\t\t\t\t * level.","+\t\t\t\t */","+\t\t\t\tPredicateLockPage(scan->heapRelation,","+\t\t\t\t\t\t\t\t  ItemPointerGetBlockNumber(&scan->xs_heaptid),","+\t\t\t\t\t\t\t\t  scan->xs_snapshot);","+\t\t\t}","+","+\t\t\t/*","+\t\t\t * Fill slot with data returned by the index AM (during plain","+\t\t\t * scans heapam_index_heap_fetch does this for us instead)","+\t\t\t */","+\t\t\ttableam_index_fill_ios_slot(scan, slot);","+\t\t}","+","+\t\treturn true;","+\t}","+","+\tpg_unreachable();","+","+\treturn false;","+}","+","+/*","+ * Get the scan's next heap tuple.","+ *","+ * Returns true if a visible heap tuple associated with the index TID most","+ * recently fetched by our caller in scan->xs_heaptid was found, false if no","+ * more matching tuples exist.  (There can be more than one matching tuple","+ * because of HOT chains, although when using an MVCC snapshot it should be","+ * impossible for more than one such tuple to exist.)","+ *","+ * Plain index scans have us store the tuple in their slot, and its buffer","+ * stays pinned until a later call here (or heapam_index_scan_end) releases","+ * it.  Index-only scans just need us to verify tuple visibility, so they pass","+ * a NULL slot.","+ *","+ * When the TID's whole HOT chain turns out to be dead, we arrange for the","+ * index AM to kill its entry for the TID before returning false.","+ */","+static pg_always_inline bool","+heapam_index_heap_fetch(IndexScanDesc scan, IndexScanHeapData *hscan,","+\t\t\t\t\t\tTupleTableSlot *slot, bool index_only)"," {","-\tIndexFetchHeapData *hscan = (IndexFetchHeapData *) scan;","-\tBufferHeapTupleTableSlot *bslot = (BufferHeapTupleTableSlot *) slot;","+\tRelation\trel = scan->heapRelation;","+\tItemPointer tid = &scan->xs_heaptid;","+\tSnapshot\tsnapshot = scan->xs_snapshot;","+\tHeapTupleData tupdata;","+\tHeapTuple\theapTuple;"," \tbool\t\tgot_heap_tuple;","+\tbool\t\tall_dead;"," ","-\tAssert(TTS_IS_BUFFERTUPLE(slot));","+\tif (!index_only)","+\t{","+\t\t/* Plain index scans have us store fetched tuple in their slot */","+\t\tBufferHeapTupleTableSlot *bslot = (BufferHeapTupleTableSlot *) slot;","+","+\t\tAssert(TTS_IS_BUFFERTUPLE(slot));","+\t\theapTuple = &bslot->base.tupdata;","+\t}","+\telse","+\t{","+\t\t/* Index-only scans only need to verify tuple visibility */","+\t\tpg_assume(slot == NULL);","+\t\theapTuple = &tupdata;","+","+\t\tif (scan->instrument)","+\t\t\tscan->instrument->ntabletuplefetches++;","+\t}"," "," \t/* We can skip the buffer-switching logic if we're on the same page. */"," \tif (hscan->xs_blk != ItemPointerGetBlockNumber(tid))"," \t{","-\t\tAssert(!*heap_continue);","+\t\tAssert(!scan->xs_heap_continue);"," "," \t\t/* Remember this buffer's block number for next time */"," \t\thscan->xs_blk = ItemPointerGetBlockNumber(tid);"," ","+\t\t/* We're switching to a new heap block, so count it */","+\t\thscan->xs_blkswitch_count++;","+"," \t\tif (BufferIsValid(hscan->xs_cbuf))"," \t\t\tReleaseBuffer(hscan->xs_cbuf);"," ","-\t\thscan->xs_cbuf = ReadBuffer(hscan->xs_base.rel, hscan->xs_blk);","+\t\thscan->xs_cbuf = ReadBuffer(rel, hscan->xs_blk);"," "," \t\t/*"," \t\t * Prune page when it is pinned for the first time"," \t\t */","-\t\theap_page_prune_opt(hscan->xs_base.rel, hscan->xs_cbuf,","-\t\t\t\t\t\t\t&hscan->xs_vmbuffer,","-\t\t\t\t\t\t\thscan->xs_base.flags & SO_HINT_REL_READ_ONLY);","+\t\theap_page_prune_opt(rel, hscan->xs_cbuf, &hscan->xs_vmbuffer,","+\t\t\t\t\t\t\thscan->xs_readonly);"," \t}"," "," \tAssert(BufferGetBlockNumber(hscan->xs_cbuf) == hscan->xs_blk);","@@ -268,31 +482,106 @@ heapam_index_fetch_tuple(struct IndexFetchTableData *scan,"," \t/* Obtain share-lock on the buffer so we can examine visibility */"," \tLockBuffer(hscan->xs_cbuf, BUFFER_LOCK_SHARE);"," \tgot_heap_tuple = heap_hot_search_buffer(tid,","-\t\t\t\t\t\t\t\t\t\t\thscan->xs_base.rel,","+\t\t\t\t\t\t\t\t\t\t\trel,"," \t\t\t\t\t\t\t\t\t\t\thscan->xs_cbuf,"," \t\t\t\t\t\t\t\t\t\t\tsnapshot,","-\t\t\t\t\t\t\t\t\t\t\t&bslot->base.tupdata,","-\t\t\t\t\t\t\t\t\t\t\tall_dead,","-\t\t\t\t\t\t\t\t\t\t\t!*heap_continue);","-\tbslot->base.tupdata.t_self = *tid;","+\t\t\t\t\t\t\t\t\t\t\theapTuple,","+\t\t\t\t\t\t\t\t\t\t\t&all_dead,","+\t\t\t\t\t\t\t\t\t\t\t!scan->xs_heap_continue);","+\theapTuple->t_self = *tid;"," \tLockBuffer(hscan->xs_cbuf, BUFFER_LOCK_UNLOCK);"," "," \tif (got_heap_tuple)"," \t{","-\t\t/*","-\t\t * Only in a non-MVCC snapshot can more than one member of the HOT","-\t\t * chain be visible.","-\t\t */","-\t\t*heap_continue = !IsMVCCLikeSnapshot(snapshot);","+\t\tif (!index_only)","+\t\t{","+\t\t\t/*","+\t\t\t * Only with a non-MVCC snapshot can more than one HOT chain","+\t\t\t * member be visible, so only then must we keep walking the chain","+\t\t\t */","+\t\t\tscan->xs_heap_continue = !IsMVCCLikeSnapshot(snapshot);","+","+\t\t\tExecStoreBufferHeapTuple(heapTuple, slot, hscan->xs_cbuf);"," ","-\t\tslot->tts_tableOid = RelationGetRelid(scan->rel);","-\t\tExecStoreBufferHeapTuple(&bslot->base.tupdata, slot, hscan->xs_cbuf);","+\t\t\tAssert(slot->tts_tableOid == RelationGetRelid(rel));","+\t\t}","+\t\telse","+\t\t{","+\t\t\t/*","+\t\t\t * Index-only scans stop at the first 