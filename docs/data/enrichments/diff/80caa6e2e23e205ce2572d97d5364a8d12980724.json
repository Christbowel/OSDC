{"id":"80caa6e2e23e205ce2572d97d5364a8d12980724","axis":"silent","repo":"mongodb/mongo","sha":"80caa6e2e23e205ce2572d97d5364a8d12980724","parsed":{"files":[{"path":"src/mongo/db/query/compiler/ce/persistence/BUILD.bazel","lines":["@@ -0,0 +1,66 @@","+load(\"//bazel:mongo_src_rules.bzl\", \"idl_generator\", \"mongo_cc_library\", \"mongo_cc_unit_test\")","+","+package(default_visibility = [\"//visibility:public\"])","+","+exports_files(","+    glob([","+        \"*.h\",","+        \"*.cpp\",","+    ]),","+)","+","+idl_generator(","+    name = \"persistent_stats_config_gen\",","+    src = \"persistent_stats_config.idl\",","+    hdrs = [","+        \"persistent_stats_config_serialization.h\",","+    ],","+    deps = [","+        \"//src/mongo/db:basic_types_gen\",","+    ],","+)","+","+mongo_cc_library(","+    name = \"persistent_stats_config\",","+    srcs = [","+        \"persistent_stats_config_serialization.cpp\",","+        \"persistent_stats_config_update.cpp\",","+        \"persistent_stats_config_validation.cpp\",","+        \":persistent_stats_config_gen\",","+    ],","+    hdrs = [","+        \"persistent_stats_config_serialization.h\",","+        \"persistent_stats_config_update.h\",","+        \"persistent_stats_config_validation.h\",","+    ],","+    deps = [","+        \"//src/mongo/db:server_base\",","+        \"//src/mongo/db/query:query_knobs\",","+    ],","+)","+","+mongo_cc_unit_test(","+    name = \"persistent_stats_config_update_test\",","+    srcs = [","+        \"persistent_stats_config_update_test.cpp\",","+    ],","+    tags = [\"mongo_unittest_second_group\"],","+    deps = [","+        \":persistent_stats_config\",","+        \"//src/mongo/unittest\",","+    ],","+)","+","+mongo_cc_unit_test(","+    name = \"persistent_stats_config_validation_test\",","+    srcs = [","+        \"persistent_stats_config_validation_test.cpp\",","+    ],","+    tags = [\"mongo_unittest_sixth_group\"],","+    deps = [","+        \":persistent_stats_config\",","+        \"//src/mongo/db:service_context_test_fixture\",","+        \"//src/mongo/unittest\",","+        \"//src/mongo/unittest:server_parameter_guard\",","+    ],","+)"],"additions":66,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/OWNERS.yml","lines":["@@ -0,0 +1,8 @@","+version: 1.0.0","+filters:","+  - \"*\":","+    approvers:","+      - 10gen/query-optimization-persistent-stats","+  - \"OWNERS.yml\":","+    approvers:","+      - 10gen/query-optimization-staff-leads"],"additions":8,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config.idl","lines":["@@ -0,0 +1,87 @@","+# Copyright (c) MongoDB, Inc.","+# SPDX-License-Identifier: SSPL-1.0","+","+global:","+    cpp_namespace: \"mongo\"","+    cpp_includes:","+        - \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_serialization.h\"","+    mod_visibility: public","+","+imports:","+    - \"mongo/db/basic_types.idl\"","+","+types:","+    PersistentStatsSampleSize:","+        bson_serialization_type: any","+        description: >-","+            A sample size for the persistent samples of a collection: a positive number to set the","+            size, or null to remove it.","+        cpp_type: \"mongo::SampleSizeUpdate\"","+        is_view: false","+        serializer: \"::mongo::sampleSizeUpdateSerializeToBSON\"","+        deserializer: \"::mongo::sampleSizeUpdateParseFromBSON\"","+","+structs:","+    PersistentStatsSamplesConfig:","+        description: >-","+            The number of documents to sample when generating the persistent samples used by the","+            cost-based ranker and the join optimizer.","+        generate_comparison_operators: true","+        fields:","+            sampleSize:","+                description: >-","+                    The number of documents to sample for cardinality estimation in the","+                    cost-based ranker.","+                type: safeInt","+                optional: true","+                validator:","+                    gt: 0","+                stability: unstable","+            joinSampleSize:","+                description: \"The number of documents to sample for the join optimizer.\"","+                type: safeInt","+                optional: true","+                validator:","+                    gt: 0","+                stability: unstable","+","+    PersistentStatsConfig:","+        description: \"Configuration for the persistent statistics collected on a collection.\"","+        generate_comparison_operators: true","+        fields:","+            samples:","+                description: \"The sample sizes for the persistent samples of this collection.\"","+                type: PersistentStatsSamplesConfig","+                optional: true","+                stability: unstable","+","+    PersistentStatsSamplesConfigUpdate:","+        description: >-","+            A partial update to the sample sizes of a collection's persistent stats. Sample sizes","+            that are omitted are left unchanged; sample sizes set to null are removed.","+        strict: true","+        fields:","+            sampleSize:","+                description: >-","+                    The number of documents to sample for cardinality estimation in the","+                    cost-based ranker, or null to remove it.","+                type: PersistentStatsSampleSize","+                optional: true","+                stability: unstable","+            joinSampleSize:","+                description: \"The number of documents to sample for the join optimizer, or null to remove it.\"","+                type: PersistentStatsSampleSize","+                optional: true","+                stability: unstable","+","+    PersistentStatsConfigUpdate:","+        description: >-","+            A partial update to a collection's persistentStatsConfig. Sample sizes that are","+            omitted are left unchanged; sample sizes set to null are removed.","+        strict: true","+        fields:","+            samples:","+                description: \"The sample size updates for the persistent samples of this collection.\"","+                type: PersistentStatsSamplesConfigUpdate","+                optional: true","+                stability: unstable"],"additions":87,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_serialization.cpp","lines":["@@ -0,0 +1,36 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_serialization.h\"","+","+#include \"mongo/bson/bsontypes.h\"","+#include \"mongo/util/assert_util.h\"","+#include \"mongo/util/str.h\"","+","+namespace mongo {","+","+void sampleSizeUpdateSerializeToBSON(const SampleSizeUpdate& sampleSize,","+                                     std::string_view fieldName,","+                                     BSONObjBuilder* builder) {","+    if (const auto* setSampleSize = std::get_if<SetSampleSize>(&sampleSize)) {","+        builder->appendNumber(fieldName, setSampleSize->value);","+    } else {","+        builder->appendNull(fieldName);","+    }","+}","+","+SampleSizeUpdate sampleSizeUpdateParseFromBSON(const BSONElement& elem) {","+    if (elem.type() == BSONType::null || elem.type() == BSONType::undefined) {","+        return RemoveSampleSize{};","+    }","+","+    const std::int32_t sampleSize = elem.safeNumberInt();","+    uassert(ErrorCodes::BadValue,","+            str::stream() << \"'persistentStatsConfig.samples.\" << elem.fieldNameStringData()","+                          << \"' must be greater than 0\",","+            sampleSize > 0);","+","+    return SetSampleSize{sampleSize};","+}","+","+}  // namespace mongo"],"additions":36,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_serialization.h","lines":["@@ -0,0 +1,37 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/bson/bsonelement.h\"","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/util/modules.h\"","+","+#include <cstdint>","+#include <string_view>","+#include <variant>","+","+namespace mongo {","+","+// Sets the sample size of the persistent samples of a collection.","+struct [[MONGO_MOD_PUBLIC]] SetSampleSize {","+    std::int32_t value;","+};","+","+// Removes the sample size of the persistent samples of a collection.","+struct [[MONGO_MOD_PUBLIC]] RemoveSampleSize {};","+","+// The value of a sample size field in a 'persistentStatsConfig' update: either a new sample size","+// or the request to remove it. IDL cannot distinguish an explicit null from an omitted field, so","+// the field is a custom IDL type; the enclosing boost::optional tracks whether it was specified.","+using SampleSizeUpdate = std::variant<SetSampleSize, RemoveSampleSize>;","+","+[[MONGO_MOD_PUBLIC]]","+void sampleSizeUpdateSerializeToBSON(const SampleSizeUpdate& sampleSize,","+                                     std::string_view fieldName,","+                                     BSONObjBuilder* builder);","+","+[[MONGO_MOD_PUBLIC]]","+SampleSizeUpdate sampleSizeUpdateParseFromBSON(const BSONElement& elem);","+","+}  // namespace mongo"],"additions":37,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_update.cpp","lines":["@@ -0,0 +1,53 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_update.h\"","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_gen.h\"","+","+#include <cstdint>","+","+namespace mongo {","+","+namespace {","+boost::optional<std::int32_t> toStoredSampleSize(const SampleSizeUpdate& sampleSize) {","+    if (const auto* setSampleSize = std::get_if<SetSampleSize>(&sampleSize)) {","+        return setSampleSize->value;","+    }","+    return boost::none;","+}","+}  // namespace","+","+boost::optional<PersistentStatsConfig> applyPersistentStatsConfigUpdate(","+    const boost::optional<PersistentStatsConfig>& current,","+    const PersistentStatsConfigUpdate& update) {","+    boost::optional<std::int32_t> sampleSize;","+    boost::optional<std::int32_t> joinSampleSize;","+    if (current && current->getSamples()) {","+        sampleSize = current->getSamples()->getSampleSize();","+        joinSampleSize = current->getSamples()->getJoinSampleSize();","+    }","+","+    if (const auto& samples = update.getSamples()) {","+        if (const auto& updatedSampleSize = samples->getSampleSize()) {","+            sampleSize = toStoredSampleSize(*updatedSampleSize);","+        }","+        if (const auto& updatedJoinSampleSize = samples->getJoinSampleSize()) {","+            joinSampleSize = toStoredSampleSize(*updatedJoinSampleSize);","+        }","+    }","+","+    if (!sampleSize && !joinSampleSize) {","+        return boost::none;","+    }","+","+    PersistentStatsSamplesConfig samples;","+    samples.setSampleSize(sampleSize);","+    samples.setJoinSampleSize(joinSampleSize);","+","+    PersistentStatsConfig config;","+    config.setSamples(samples);","+    return config;","+}","+","+}  // namespace mongo"],"additions":53,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_update.h","lines":["@@ -0,0 +1,20 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_gen.h\"","+#include \"mongo/util/modules.h\"","+","+#include <boost/optional.hpp>","+","+namespace mongo {","+","+// Applies 'update' to 'current': unmentioned sample sizes are preserved, null removes one, and","+// having no sample size left unsets the configuration.","+[[MONGO_MOD_PUBLIC]]","+boost::optional<PersistentStatsConfig> applyPersistentStatsConfigUpdate(","+    const boost::optional<PersistentStatsConfig>& current,","+    const PersistentStatsConfigUpdate& update);","+","+}  // namespace mongo"],"additions":20,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_update_test.cpp","lines":["@@ -0,0 +1,138 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_update.h\"","+","+#include \"mongo/bson/json.h\"","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_gen.h\"","+#include \"mongo/idl/idl_parser.h\"","+#include \"mongo/unittest/unittest.h\"","+","+#include <cstdint>","+#include <variant>","+","+#include <boost/optional.hpp>","+","+namespace mongo {","+namespace {","+","+PersistentStatsConfigUpdate parsePersistentStatsConfigUpdate(const BSONObj& update) {","+    return PersistentStatsConfigUpdate::parse(update, IDLParserContext(\"persistentStatsConfig\"));","+}","+","+boost::optional<PersistentStatsConfig> makeConfig(boost::optional<std::int32_t> sampleSize,","+                                                  boost::optional<std::int32_t> joinSampleSize) {","+    PersistentStatsSamplesConfig samples;","+    samples.setSampleSize(sampleSize);","+    samples.setJoinSampleSize(joinSampleSize);","+","+    PersistentStatsConfig config;","+    config.setSamples(samples);","+    return config;","+}","+","+}  // namespace","+","+TEST(PersistentStatsConfigUpdate, ParsesDelta) {","+    const auto update = parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: 1000}}\"));","+    ASSERT_TRUE(update.getSamples());","+    ASSERT_TRUE(update.getSamples()->getSampleSize());","+    ASSERT_TRUE(std::holds_alternative<SetSampleSize>(*update.getSamples()->getSampleSize()));","+    ASSERT_EQUALS(std::get<SetSampleSize>(*update.getSamples()->getSampleSize()).value, 1000);","+    ASSERT_FALSE(update.getSamples()->getJoinSampleSize());","+","+    // A null sample size means \"remove it\" and must round-trip so that the oplog and the sharded","+    // DDL path apply the same update.","+    const auto removal =","+        parsePersistentStatsConfigUpdate(fromjson(\"{samples: {joinSampleSize: null}}\"));","+    ASSERT_TRUE(removal.getSamples());","+    ASSERT_TRUE(removal.getSamples()->getJoinSampleSize());","+    ASSERT_TRUE(","+        std::holds_alternative<RemoveSampleSize>(*removal.getSamples()->getJoinSampleSize()));","+    ASSERT_BSONOBJ_EQ(removal.toBSON(), fromjson(\"{samples: {joinSampleSize: null}}\"));","+","+    const auto mixed = parsePersistentStatsConfigUpdate(","+        fromjson(\"{samples: {sampleSize: null, joinSampleSize: 2000}}\"));","+    ASSERT_TRUE(mixed.getSamples()->getSampleSize());","+    ASSERT_TRUE(std::holds_alternative<RemoveSampleSize>(*mixed.getSamples()->getSampleSize()));","+    ASSERT_EQUALS(std::get<SetSampleSize>(*mixed.getSamples()->getJoinSampleSize()).value, 2000);","+}","+","+TEST(PersistentStatsConfigUpdate, CoercesIntegralDoubleToSampleSize) {","+    // Sample sizes are read with BSONElement::safeNumberInt(), so integral doubles are accepted","+    // and truncated the same way knobs and server parameters accept them.","+    const auto update =","+        parsePersistentStatsConfigUpdate(BSON(\"samples\" << BSON(\"sampleSize\" << 1.0)));","+    ASSERT_TRUE(update.getSamples()->getSampleSize());","+    ASSERT_TRUE(std::holds_alternative<SetSampleSize>(*update.getSamples()->getSampleSize()));","+    ASSERT_EQUALS(std::get<SetSampleSize>(*update.getSamples()->getSampleSize()).value, 1);","+}","+","+TEST(PersistentStatsConfig, CoercesIntegralDoubleToSampleSize) {","+    // The stored configuration declares its sample sizes as safeInt, which is also parsed with","+    // BSONElement::safeNumberInt().","+    const auto config = PersistentStatsConfig::parse(BSON(\"samples\" << BSON(\"sampleSize\" << 1.0)),","+                                                     IDLParserContext(\"persistentStatsConfig\"));","+    ASSERT_TRUE(config.getSamples());","+    ASSERT_EQUALS(*config.getSamples()->getSampleSize(), 1);","+}","+","+TEST(PersistentStatsConfigUpdate, RejectsUnknownFields) {","+    ASSERT_THROWS(parsePersistentStatsConfigUpdate(fromjson(\"{unknownField: 1}\")), DBException);","+    ASSERT_THROWS(parsePersistentStatsConfigUpdate(fromjson(\"{samples: {unknownField: 1}}\")),","+                  DBException);","+    ASSERT_THROWS(parsePersistentStatsConfigUpdate(fromjson(\"{samples: 5}\")), DBException);","+}","+","+TEST(PersistentStatsConfigUpdate, RejectsInvalidSampleSizes) {","+    ASSERT_THROWS(parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: 0}}\")),","+                  DBException);","+    ASSERT_THROWS(parsePersistentStatsConfigUpdate(fromjson(\"{samples: {joinSampleSize: -1}}\")),","+                  DBException);","+    ASSERT_THROWS(parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: 'x'}}\")),","+                  DBException);","+}","+","+TEST(PersistentStatsConfigUpdate, AppliesDelta) {","+    // Setting a sample size on a collection with no configuration creates one.","+    auto result = applyPersistentStatsConfigUpdate(","+        boost::none, parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: 1000}}\")));","+    ASSERT_EQUALS(*result->getSamples()->getSampleSize(), 1000);","+    ASSERT_FALSE(result->getSamples()->getJoinSampleSize());","+","+    result = applyPersistentStatsConfigUpdate(","+        boost::none,","+        parsePersistentStatsConfigUpdate(fromjson(\"{samples: {joinSampleSize: 2000}}\")));","+    ASSERT_FALSE(result->getSamples()->getSampleSize());","+    ASSERT_EQUALS(*result->getSamples()->getJoinSampleSize(), 2000);","+","+    // Sample sizes the update does not mention are preserved.","+    result = applyPersistentStatsConfigUpdate(","+        makeConfig(1000, 2000),","+        parsePersistentStatsConfigUpdate(fromjson(\"{samples: {joinSampleSize: 500}}\")));","+    ASSERT_EQUALS(*result->getSamples()->getSampleSize(), 1000);","+    ASSERT_EQUALS(*result->getSamples()->getJoinSampleSize(), 500);","+","+    // Removing a sample size preserves the other one.","+    result = applyPersistentStatsConfigUpdate(","+        makeConfig(1000, 2000),","+        parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: null}}\")));","+    ASSERT_FALSE(result->getSamples()->getSampleSize());","+    ASSERT_EQUALS(*result->getSamples()->getJoinSampleSize(), 2000);","+","+    // Removing a sample size that is not set is a no-op.","+    result = applyPersistentStatsConfigUpdate(","+        makeConfig(boost::none, 2000),","+        parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: null}}\")));","+    ASSERT_FALSE(result->getSamples()->getSampleSize());","+    ASSERT_EQUALS(*result->getSamples()->getJoinSampleSize(), 2000);","+","+    // Removing the last sample size leaves nothing configured.","+    result = applyPersistentStatsConfigUpdate(","+        makeConfig(1000, 2000),","+        parsePersistentStatsConfigUpdate(","+            fromjson(\"{samples: {sampleSize: null, joinSampleSize: null}}\")));","+    ASSERT_FALSE(result);","+}","+","+}  // namespace mongo"],"additions":138,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation.cpp","lines":["@@ -0,0 +1,50 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation.h\"","+","+#include \"mongo/base/error_codes.h\"","+#include \"mongo/db/query/query_feature_flags_gen.h\"","+#include \"mongo/db/server_options.h\"","+#include \"mongo/db/version_context.h\"","+","+namespace mongo {","+","+Status validatePersistentStatsConfigIsApplicable(OperationContext* opCtx, bool isView) {","+    if (!feature_flags::gFeatureFlagPersistentStats.isEnabled(","+            VersionContext::getDecoration(opCtx),","+            serverGlobalParams.featureCompatibility.acquireFCVSnapshot())) {","+        return {ErrorCodes::InvalidOptions, \"unknown option: persistentStatsConfig\"};","+    }","+","+    if (isView) {","+        return {ErrorCodes::InvalidOptions,","+                \"option not supported on a view: persistentStatsConfig\"};","+    }","+","+    return Status::OK();","+}","+","+Status validatePersistentStatsConfig(const PersistentStatsConfig& persistentStatsConfig) {","+    const auto& samples = persistentStatsConfig.getSamples();","+    if (!samples || (!samples->getSampleSize() && !samples->getJoinSampleSize())) {","+        return {ErrorCodes::InvalidOptions,","+                \"'persistentStatsConfig' must specify at least one of 'samples.sampleSize' or \"","+                \"'samples.joinSampleSize'\"};","+    }","+","+    return Status::OK();","+}","+","+Status validatePersistentStatsConfigUpdate(const PersistentStatsConfigUpdate& update) {","+    const auto& samples = update.getSamples();","+    if (!samples || (!samples->getSampleSize() && !samples->getJoinSampleSize())) {","+        return {ErrorCodes::InvalidOptions,","+                \"'persistentStatsConfig' must specify at least one of 'samples.sampleSize' or \"","+                \"'samples.joinSampleSize'\"};","+    }","+","+    return Status::OK();","+}","+","+}  // namespace mongo"],"additions":50,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation.h","lines":["@@ -0,0 +1,22 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/base/status.h\"","+#include \"mongo/db/operation_context.h\"","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_gen.h\"","+#include \"mongo/util/modules.h\"","+","+namespace mongo {","+","+[[MONGO_MOD_PUBLIC]]","+Status validatePersistentStatsConfigIsApplicable(OperationContext* opCtx, bool isView);","+","+[[MONGO_MOD_PUBLIC]]","+Status validatePersistentStatsConfig(const PersistentStatsConfig& persistentStatsConfig);","+","+[[MONGO_MOD_PUBLIC]]","+Status validatePersistentStatsConfigUpdate(const PersistentStatsConfigUpdate& update);","+","+}  // namespace mongo"],"additions":22,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation_test.cpp","lines":["@@ -0,0 +1,95 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation.h\"","+","+#include \"mongo/bson/json.h\"","+#include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_gen.h\"","+#include \"mongo/db/service_context_test_fixture.h\"","+#include \"mongo/idl/idl_parser.h\"","+#include \"mongo/unittest/server_parameter_guard.h\"","+#include \"mongo/unittest/unittest.h\"","+","+#include <cstdint>","+","+#include <boost/optional.hpp>","+","+namespace mongo {","+namespace {","+","+PersistentStatsConfig makeConfig(boost::optional<std::int32_t> sampleSize,","+                                 boost::optional<std::int32_t> joinSampleSize) {","+    PersistentStatsSamplesConfig samples;","+    samples.setSampleSize(sampleSize);","+    samples.setJoinSampleSize(joinSampleSize);","+","+    PersistentStatsConfig config;","+    config.setSamples(samples);","+    return config;","+}","+","+PersistentStatsConfigUpdate parsePersistentStatsConfigUpdate(const BSONObj& update) {","+    return PersistentStatsConfigUpdate::parse(update, IDLParserContext(\"persistentStatsConfig\"));","+}","+","+template <bool kFeatureFlagEnabled>","+class PersistentStatsConfigValidationTest : public ServiceContextTest {","+public:","+    void setUp() override {","+        ServiceContextTest::setUp();","+        _featureFlag.emplace(\"featureFlagPersistentStats\", kFeatureFlagEnabled);","+        _opCtx = makeOperationContext();","+    }","+","+    OperationContext* opCtx() const {","+        return _opCtx.get();","+    }","+","+private:","+    boost::optional<unittest::ServerParameterGuard> _featureFlag;","+    ServiceContext::UniqueOperationContext _opCtx;","+};","+","+using FeatureFlagDisabledTest = PersistentStatsConfigValidationTest<false>;","+using FeatureFlagEnabledTest = PersistentStatsConfigValidationTest<true>;","+","+TEST_F(FeatureFlagDisabledTest, RejectsWhenFeatureFlagIsDisabled) {","+    ASSERT_EQ(validatePersistentStatsConfigIsApplicable(opCtx(), false).code(),","+              ErrorCodes::InvalidOptions);","+}","+","+TEST_F(FeatureFlagEnabledTest, AcceptsACollection) {","+    ASSERT_OK(validatePersistentStatsConfigIsApplicable(opCtx(), false));","+}","+","+TEST_F(FeatureFlagEnabledTest, RejectsViews) {","+    ASSERT_EQ(validatePersistentStatsConfigIsApplicable(opCtx(), true).code(),","+              ErrorCodes::InvalidOptions);","+}","+","+TEST(PersistentStatsConfigValidation, AcceptsAnySampleSize) {","+    ASSERT_OK(validatePersistentStatsConfig(makeConfig(1000, boost::none)));","+    ASSERT_OK(validatePersistentStatsConfig(makeConfig(boost::none, 2000)));","+}","+","+TEST(PersistentStatsConfigValidation, RejectsAConfigWithoutSampleSizes) {","+    ASSERT_EQ(validatePersistentStatsConfig(PersistentStatsConfig{}).code(),","+              ErrorCodes::InvalidOptions);","+    ASSERT_EQ(validatePersistentStatsConfig(makeConfig(boost::none, boost::none)).code(),","+              ErrorCodes::InvalidOptions);","+}","+","+TEST(PersistentStatsConfigUpdateValidation, RejectsAnUpdateWithoutSampleSizes) {","+    ASSERT_EQ(ErrorCodes::InvalidOptions,","+              validatePersistentStatsConfigUpdate(parsePersistentStatsConfigUpdate(fromjson(\"{}\")))","+                  .code());","+    ASSERT_EQ(ErrorCodes::InvalidOptions,","+              validatePersistentStatsConfigUpdate(","+                  parsePersistentStatsConfigUpdate(fromjson(\"{samples: {}}\")))","+                  .code());","+    ASSERT_OK(validatePersistentStatsConfigUpdate(","+        parsePersistentStatsConfigUpdate(fromjson(\"{samples: {sampleSize: null}}\"))));","+}","+","+}  // namespace","+}  // namespace mongo",""],"additions":95,"deletions":0,"truncated":false}],"additions":612,"deletions":0,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-17T18:46:51.259532+00:00"}