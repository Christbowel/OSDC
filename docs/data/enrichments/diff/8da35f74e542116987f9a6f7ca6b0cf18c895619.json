{"id":"8da35f74e542116987f9a6f7ca6b0cf18c895619","axis":"silent","repo":"envoyproxy/envoy","sha":"8da35f74e542116987f9a6f7ca6b0cf18c895619","parsed":{"files":[{"path":"api/BUILD","lines":["@@ -95,6 +95,7 @@ proto_library(","         \"//contrib/envoy/extensions/filters/network/client_ssl_auth/v3:pkg\",","         \"//contrib/envoy/extensions/filters/network/generic_proxy/codecs/kafka/v3:pkg\",","         \"//contrib/envoy/extensions/filters/network/golang/v3alpha:pkg\",","+        \"//contrib/envoy/extensions/filters/network/istio_hbone/v3alpha:pkg\",","         \"//contrib/envoy/extensions/filters/network/kafka_broker/v3:pkg\",","         \"//contrib/envoy/extensions/filters/network/kafka_mesh/v3alpha:pkg\",","         \"//contrib/envoy/extensions/filters/network/metadata_exchange/v3:pkg\","],"additions":1,"deletions":0,"truncated":false},{"path":"api/contrib/envoy/extensions/filters/network/istio_hbone/v3alpha/BUILD","lines":["@@ -0,0 +1,14 @@","+# DO NOT EDIT. This file is generated by tools/proto_format/proto_sync.py.","+","+load(\"@envoy_api//bazel:api_build_system.bzl\", \"api_proto_package\")","+","+licenses([\"notice\"])  # Apache 2","+","+api_proto_package(","+    deps = [","+        \"//envoy/config/core/v3:pkg\",","+        \"//envoy/extensions/transport_sockets/internal_upstream/v3:pkg\",","+        \"@xds//udpa/annotations:pkg\",","+        \"@xds//xds/annotations/v3:pkg\",","+    ],","+)"],"additions":14,"deletions":0,"truncated":false},{"path":"api/contrib/envoy/extensions/filters/network/istio_hbone/v3alpha/README.md","lines":["@@ -0,0 +1 @@","+Configuration for Istio HBONE CONNECT wait transport sockets and connection pool adapters."],"additions":1,"deletions":0,"truncated":false},{"path":"api/contrib/envoy/extensions/filters/network/istio_hbone/v3alpha/istio_hbone.proto","lines":["@@ -0,0 +1,48 @@","+syntax = \"proto3\";","+","+package envoy.extensions.filters.network.istio_hbone.v3alpha;","+","+import \"envoy/config/core/v3/base.proto\";","+import \"envoy/extensions/transport_sockets/internal_upstream/v3/internal_upstream.proto\";","+","+import \"xds/annotations/v3/status.proto\";","+","+import \"udpa/annotations/status.proto\";","+","+option java_package = \"io.envoyproxy.envoy.extensions.filters.network.istio_hbone.v3alpha\";","+option java_outer_classname = \"IstioHboneProto\";","+option java_multiple_files = true;","+option go_package = \"github.com/envoyproxy/go-control-plane/contrib/envoy/extensions/filters/network/istio_hbone/v3alpha\";","+option (udpa.annotations.file_status).package_version_status = ACTIVE;","+option (xds.annotations.v3.file_status).work_in_progress = true;","+","+// [#protodoc-title: Istio HBONE CONNECT wait]","+","+// Transport socket for clusters whose endpoints are HBONE origination internal","+// listeners using TCP proxy. Holds connection readiness and all application bytes","+// until the tunneling pool receives a successful CONNECT response. Use together with","+// ConnectionPoolConfig on both application and HBONE clusters.","+// [#extension: envoy.transport_sockets.istio_hbone]","+message UpstreamConfig {","+  // Metadata to pass to the internal listener, including original destination","+  // metadata when required by the listener's original destination filter.","+  repeated transport_sockets.internal_upstream.v3.InternalUpstreamTransport.MetadataValueSource","+      passthrough_metadata = 1;","+","+  // Optional wrapped transport, started only after CONNECT acceptance. Defaults","+  // to raw buffer. Use TLS here on the inner HTTP/2 cluster of double HBONE, with","+  // the pool adapter on the outer HBONE cluster.","+  config.core.v3.TransportSocket transport_socket = 2;","+}","+","+// Required cluster upstream_config for both application and HBONE clusters using","+// CONNECT wait. On HBONE clusters, signals connection readiness after CONNECT","+// acceptance. Handles permanent CONNECT rejections before retry and outlier accounting.","+// HTTP callers receive 403 for CONNECT 401, the original status for other 4xx,","+// and 502 for other non-5xx statuses. The original CONNECT status is retained in","+// failure diagnostics with the ``UF`` response flag. TCP callers are closed.","+// Successful connections and transient failures retain the standard pool behavior.","+// Must be deployed together with the adapter sockets.","+// [#extension: envoy.upstreams.istio_hbone]","+message ConnectionPoolConfig {","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"api/versioning/BUILD","lines":["@@ -27,6 +27,7 @@ proto_library(","         \"//contrib/envoy/extensions/filters/network/client_ssl_auth/v3:pkg\",","         \"//contrib/envoy/extensions/filters/network/generic_proxy/codecs/kafka/v3:pkg\",","         \"//contrib/envoy/extensions/filters/network/golang/v3alpha:pkg\",","+        \"//contrib/envoy/extensions/filters/network/istio_hbone/v3alpha:pkg\",","         \"//contrib/envoy/extensions/filters/network/kafka_broker/v3:pkg\",","         \"//contrib/envoy/extensions/filters/network/kafka_mesh/v3alpha:pkg\",","         \"//contrib/envoy/extensions/filters/network/metadata_exchange/v3:pkg\","],"additions":1,"deletions":0,"truncated":false},{"path":"changelogs/current/new_features/contrib__istio-hbone-connect-wait.rst","lines":["@@ -0,0 +1,8 @@","+Added experimental :ref:`Istio HBONE CONNECT wait <config_istio_hbone>` extensions","+that defer internal connection readiness and application I/O until HTTP/2 CONNECT","+acceptance. Transient establishment failures retain connection-failure retries;","+permanent CONNECT rejections terminate HTTP or TCP requests without retry or outlier","+failure reporting. CONNECT 401 is exposed as an HTTP 403 with the ``UF`` response","+flag, retaining the original CONNECT status in failure diagnostics.","+Single and double HBONE origination are supported, including","+wrapped TLS and Istio's baggage peer-metadata exchange."],"additions":8,"deletions":0,"truncated":false},{"path":"contrib/contrib_build_config.bzl","lines":["@@ -26,14 +26,26 @@ CONTRIB_EXTENSIONS = {","     #"," ","     \"envoy.filters.network.client_ssl_auth\":                    \"//contrib/client_ssl_auth/filters/network/source:config\",","+    \"envoy.filters.network.golang\":                             \"//contrib/golang/filters/network/source:config\",","     \"envoy.filters.network.kafka_broker\":                       \"//contrib/kafka/filters/network/source/broker:config_lib\",","     \"envoy.filters.network.kafka_mesh\":                         \"//contrib/kafka/filters/network/source/mesh:config_lib\",","+    \"envoy.filters.network.metadata_exchange\":                  \"//contrib/istio/filters/network/metadata_exchange/source:config\",","     \"envoy.filters.network.mysql_proxy\":                        \"//contrib/mysql_proxy/filters/network/source:config\",","+    \"envoy.filters.network.peer_metadata\":                      \"//contrib/istio/filters/network/peer_metadata/source:config\",","     \"envoy.filters.network.postgres_proxy\":                     \"//contrib/postgres_proxy/filters/network/source:config\",","     \"envoy.filters.network.rocketmq_proxy\":                     \"//contrib/rocketmq_proxy/filters/network/source:config\",","-    \"envoy.filters.network.golang\":                             \"//contrib/golang/filters/network/source:config\",","-    \"envoy.filters.network.metadata_exchange\":                  \"//contrib/istio/filters/network/metadata_exchange/source:config\",","-    \"envoy.filters.network.peer_metadata\":                      \"//contrib/istio/filters/network/peer_metadata/source:config\",","+","+    #","+    # Transport sockets","+    #","+","+    \"envoy.transport_sockets.istio_hbone\":                      \"//contrib/istio/filters/network/hbone/source:upstream_config\",","+","+    #","+    # Upstreams","+    #","+","+    \"envoy.upstreams.istio_hbone\":                              \"//contrib/istio/filters/network/hbone/source:pool_config\","," ","     #","     # Listener filters"],"additions":15,"deletions":3,"truncated":false},{"path":"contrib/extensions_metadata.yaml","lines":["@@ -186,6 +186,20 @@ envoy.filters.network.peer_metadata:","   status: alpha","   type_urls:","   - envoy.extensions.network_filters.peer_metadata.Config","+envoy.transport_sockets.istio_hbone:","+  categories:","+  - envoy.transport_sockets.upstream","+  security_posture: requires_trusted_downstream_and_upstream","+  status: wip","+  type_urls:","+  - envoy.extensions.filters.network.istio_hbone.v3alpha.UpstreamConfig","+envoy.upstreams.istio_hbone:","+  categories:","+  - envoy.upstreams","+  security_posture: requires_trusted_downstream_and_upstream","+  status: wip","+  type_urls:","+  - envoy.extensions.filters.network.istio_hbone.v3alpha.ConnectionPoolConfig"," envoy.filters.network.metadata_exchange:","   categories:","   - envoy.filters.network"],"additions":14,"deletions":0,"truncated":false},{"path":"contrib/istio/filters/network/hbone/README.md","lines":["@@ -0,0 +1,39 @@","+# HBONE CONNECT wait","+","+HBONE CONNECT wait holds transport readiness and application I/O until CONNECT","+acceptance, allowing connection-failure retries before application bytes are sent.","+The HBONE CONNECT adapter uses an internal upstream transport, the standard TCP proxy","+filter, and a connection pool adapter on both application and HBONE clusters.","+","+The implementation uses Envoy's existing internal listener, user-space socket pair,","+TCP proxy and HTTP/2 connection pool. No core Envoy changes are required. Each CONNECT","+is a separate stream; the existing pool continues multiplexing those streams over","+outer HTTP/2 connections.","+","+For double HBONE, both HBONE clusters select the pool adapter. The inner HTTP/2 cluster's","+adapter transport wraps its TLS socket and connects to the outer origination listener.","+Inner TLS starts after the outer CONNECT succeeds.","+Each hop keeps separate readiness state; accepted streams retain normal TLS and","+forwarding behavior.","+","+See [configuration and retry semantics](../../../../../docs/root/configuration/other_features/istio_hbone.rst).","+","+Build and run the focused tests inside the repository's build container:","+","+```sh","+bazel test -c fastbuild \\","+  //contrib/istio/filters/network/hbone/test:hbone_test \\","+  //contrib/istio/filters/network/hbone/test:pool_test \\","+  //contrib/istio/filters/network/hbone/test:hbone_integration_test","+```","+","+The integration tests use an HTTP/2 fake HBONE peer to isolate CONNECT acceptance,","+refusal, multiplexing and GOAWAY behavior. They do not exercise ztunnel or mutual TLS","+identity configuration.","+","+When retaining Istio's baggage peer-metadata filters, the listener and service-cluster","+filters must remain paired. The upstream peer-metadata filter recognizes","+`connect_originate_hbone_adapter` and `inner_connect_originate_hbone_adapter`, so it consumes","+the metadata preamble before the application codec sees the response. Run","+`//contrib/istio/filters/network/peer_metadata/test:peer_metadata_test` as well when","+changing this integration."],"additions":39,"deletions":0,"truncated":false},{"path":"contrib/istio/filters/network/hbone/source/BUILD","lines":["@@ -0,0 +1,62 @@","+load(","+    \"//bazel:envoy_build_system.bzl\",","+    \"envoy_cc_contrib_extension\",","+    \"envoy_cc_library\",","+    \"envoy_contrib_package\",","+)","+","+licenses([\"notice\"])  # Apache 2","+","+envoy_contrib_package()","+","+envoy_cc_contrib_extension(","+    name = \"pool_config\",","+    srcs = [\"pool.cc\"],","+    hdrs = [\"pool.h\"],","+    deps = [","+        \":hbone_lib\",","+        \"//envoy/router:router_filter_interface\",","+        \"//envoy/router:router_interface\",","+        \"//envoy/stream_info:bool_accessor_interface\",","+        \"//envoy/tcp:upstream_interface\",","+        \"//source/common/common:assert_lib\",","+        \"//source/common/config:utility_lib\",","+        \"//source/common/tcp_proxy:upstream_lib\",","+        \"//source/extensions/upstreams/http/generic:config\",","+        \"//source/extensions/upstreams/tcp/generic:config\",","+        \"@envoy_api//contrib/envoy/extensions/filters/network/istio_hbone/v3alpha:pkg_cc_proto\",","+    ],","+)","+","+# Include the connection pool factories required by CONNECT wait.","+envoy_cc_contrib_extension(","+    name = \"upstream_config\",","+    srcs = [\"config.cc\"],","+    hdrs = [\"config.h\"],","+    deps = [","+        \":hbone_lib\",","+        \":pool_config\",","+        \"//envoy/registry\",","+        \"//envoy/server:transport_socket_config_interface\",","+        \"//source/common/config:utility_lib\",","+        \"//source/common/network:raw_buffer_socket_lib\",","+        \"//source/common/network:transport_socket_options_lib\",","+        \"//source/extensions/transport_sockets/internal_upstream:config\",","+        \"@envoy_api//contrib/envoy/extensions/filters/network/istio_hbone/v3alpha:pkg_cc_proto\",","+    ],","+)","+","+envoy_cc_library(","+    name = \"hbone_lib\",","+    srcs = [\"hbone.cc\"],","+    hdrs = [\"hbone.h\"],","+    deps = [","+        \"//envoy/event:dispatcher_interface\",","+        \"//envoy/event:file_event_interface\",","+        \"//envoy/stream_info:filter_state_interface\",","+        \"//source/common/network:raw_buffer_socket_lib\",","+        \"//source/extensions/io_socket/user_space:io_handle_lib\",","+        \"//source/extensions/transport_sockets/internal_upstream\",","+        \"@abseil-cpp//absl/strings\",","+    ],","+)"],"additions":62,"deletions":0,"truncated":false},{"path":"contrib/istio/filters/network/hbone/source/config.cc","lines":["@@ -0,0 +1,71 @@","+#include \"contrib/istio/filters/network/hbone/source/config.h\"","+","+#include \"envoy/registry/registry.h\"","+","+#include \"source/common/config/utility.h\"","+#include \"source/common/network/raw_buffer_socket.h\"","+","+#include \"contrib/istio/filters/network/hbone/source/hbone.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace Istio {","+namespace Hbone {","+namespace {","+","+envoy::extensions::transport_sockets::internal_upstream::v3::InternalUpstreamTransport","+metadataConfig(const SocketConfig& config) {","+  envoy::extensions::transport_sockets::internal_upstream::v3::InternalUpstreamTransport result;","+  *result.mutable_passthrough_metadata() = config.passthrough_metadata();","+  return result;","+}","+","+} // namespace","+","+UpstreamSocketFactory::UpstreamSocketFactory(","+    const SocketConfig& config, Stats::Scope& scope,","+    Network::UpstreamTransportSocketFactoryPtr inner_factory)","+    : PassthroughFactory(std::move(inner_factory)),","+      metadata_config_(metadataConfig(config), scope) {}","+","+Network::TransportSocketPtr","+UpstreamSocketFactory::createTransportSocket(Network::TransportSocketOptionsConstSharedPtr options,","+                                             Upstream::HostDescriptionConstSharedPtr host) const {","+  auto inner = transport_socket_factory_->createTransportSocket(options, host);","+  if (!inner) {","+    return nullptr;","+  }","+  return std::make_unique<UpstreamSocket>(","+      std::make_shared<ConnectState>(), host ? metadata_config_.extractMetadata(host) : nullptr,","+      options ? options->downstreamSharedFilterStateObjects() : StreamInfo::FilterState::Objects{},","+      std::move(inner));","+}","+","+absl::StatusOr<Network::UpstreamTransportSocketFactoryPtr>","+SocketConfigFactory::createTransportSocketFactory(","+    const Protobuf::Message& config,","+    Server::Configuration::TransportSocketFactoryContext& context) {","+  const auto& socket_config = MessageUtil::downcastAndValidate<const SocketConfig&>(","+      config, context.messageValidationVisitor());","+  Network::UpstreamTransportSocketFactoryPtr inner =","+      std::make_unique<Network::RawBufferSocketFactory>();","+  if (socket_config.has_transport_socket()) {","+    auto& factory = Envoy::Config::Utility::getAndCheckFactory<","+        Server::Configuration::UpstreamTransportSocketConfigFactory>(","+        socket_config.transport_socket());","+    auto inner_config = Envoy::Config::Utility::translateToFactoryConfig(","+        socket_config.transport_socket(), context.messageValidationVisitor(), factory);","+    auto result = factory.createTransportSocketFactory(*inner_config, context);","+    RETURN_IF_NOT_OK_REF(result.status());","+    inner = std::move(result.value());","+  }","+  return std::make_unique<UpstreamSocketFactory>(socket_config, context.statsScope(),","+                                                 std::move(inner));","+}","+","+REGISTER_FACTORY(SocketConfigFactory, Server::Configuration::UpstreamTransportSocketConfigFactory);","+","+} // namespace Hbone","+} // namespace Istio","+} // namespace Extensions","+} // namespace Envoy"],"additions":71,"deletions":0,"truncated":false},{"path":"contrib/istio/filters/network/hbone/source/config.h","lines":["@@ -0,0 +1,43 @@","+#pragma once","+","+#include \"envoy/server/transport_socket_config.h\"","+","+#include \"source/common/network/transport_socket_options_impl.h\"","+#include \"source/extensions/transport_sockets/internal_upstream/config.h\"","+","+#include \"contrib/envoy/extensions/filters/network/istio_hbone/v3alpha/istio_hbone.pb.validate.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace Istio {","+namespace Hbone {","+","+using SocketConfig = envoy::extensions::filters::network::istio_hbone::v3alpha::UpstreamConfig;","+","+class UpstreamSocketFactory : public TransportSockets::PassthroughFactory {","+public:","+  UpstreamSocketFactory(const SocketConfig& config, Stats::Scope& scope,","+                        Network::UpstreamTransportSocketFactoryPtr inner_factory);","+  Network::TransportSocketPtr","+  createTransportSocket(Network::TransportSocketOptionsConstSharedPtr options,","+                        Upstream::HostDescriptionConstSharedPtr host) const override;","+","+private:","+  const TransportSockets::InternalUpstream::Config metadata_config_;","+};","+","+class SocketConfigFactory : public Server::Configuration::UpstreamTransportSocketConfigFactory {","+public:","+  std::string name() const override { return \"envoy.transport_sockets.istio_hbone\"; }","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<SocketConfig>();","+  }","+  absl::StatusOr<Network::UpstreamTransportSocketFactoryPtr> createTransportSocketFactory(","+      const Protobuf::Message& config,","+      Server::Configuration::TransportSocketFactoryContext& context) override;","+};","+","+} // namespace Hbone","+} // namespace Istio","+} // namespace Extensions","+} // namespace Envoy"],"additions":43,"deletions":0,"truncated":false},{"path":"contrib/istio/filters/network/hbone/source/hbone.cc","lines":["@@ -0,0 +1,203 @@","+#include \"contrib/istio/filters/network/hbone/source/hbone.h\"","+","+#include \"envoy/event/file_event.h\"","+","+#include \"source/common/network/raw_buffer_socket.h\"","+#include \"source/extensions/io_socket/user_space/io_handle.h\"","+","+#include \"absl/strings/match.h\"","+#include \"absl/strings/numbers.h\"","+#include \"absl/strings/str_cat.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace Istio {","+namespace Hbone {","+namespace {","+","+constexpr absl::string_view RejectionPrefix = \"istio_hbone_connect_rejected:\";","+","+std::optional<uint32_t> rejectedStatus(absl::string_view reason, absl::string_view prefix) {","+  if (!absl::StartsWith(reason, prefix)) {","+    return std::nullopt;","+  }","+  reason.remove_prefix(prefix.size());","+  uint32_t status;","+  if (reason.size() != 3 || !absl::SimpleAtoi(reason, &status) || status < 100 ||","+      (status >= 500 && status < 600) || status == 200) {","+    return std::nullopt;","+  }","+  return status;","+}","+","+StreamInfo::FilterState::Objects withConnectState(StreamInfo::FilterState::Objects objects,","+                                                  const ConnectStateSharedPtr& state) {","+  objects.push_back(","+      {state, StreamInfo::StreamSharingMayImpactPooling::None, std::string(ConnectState::Key)});","+  return objects;","+}","+","+} // namespace","+","+std::optional<uint32_t> permanentConnectRejection(absl::string_view reason) {","+  return rejectedStatus(reason, RejectionPrefix);","+}","+","+std::string tunnelFailureReason(absl::string_view reason) {","+  if (const auto status = rejectedStatus(reason, \"tunnel_response:\")) {","+    return absl::StrCat(RejectionPrefix, *status);","+  }","+  return std::string(reason);","+}","+","+void ConnectState::notify() {","+  if (callback_) {","+    callback_();","+  }","+}","+","+void ConnectState::accept() {","+  if (phase_ == Phase::Pending) {","+    failure_reason_.clear();","+    phase_ = Phase::Accepted;","+    notify();","+  }","+}","+","+void ConnectState::recordAttemptFailure(absl::string_view reason) {","+  if (phase_ == Phase::Pending) {","+    failure_reason_ = std::string(reason);","+  }","+}","+","+void ConnectState::fail(absl::string_view reason) {","+  // Once readiness has been released, normal stream forwarding owns close and","+  // half-close semantics. In particular, do not discard final buffered data.","+  if (phase_ == Phase::Connected || phase_ == Phase::Failed) {","+    return;","+  }","+  failure_reason_ = std::string(reason);","+  phase_ = Phase::Failed;","+  notify();","+}","+","+void ConnectState::connected() {","+  ASSERT(phase_ == Phase::Accepted);","+  phase_ = Phase::Connected;","+}","+","+UpstreamSocket::UpstreamSocket(ConnectStateSharedPtr state,","+                               std::unique_ptr<envoy::config::core::v3::Metadata> metadata,","+                               StreamInfo::FilterState::Objects objects,","+                               Network::TransportSocketPtr inner_socket)","+    : InternalSocket(inner_socket ? std::move(inner_socket)","+                                  : std::make_unique<Network::RawBufferSocket>(),","+                     std::move(metadata), withConnectState(std::move(objects), state)),","+      state_(std::move(state)) {}","+","+UpstreamSocket::~UpstreamSocket() { cancel(); }","+","+absl::string_view UpstreamSocket::failureReason() const {","+  // Keep nested TLS diagnostics when CONNECT itself succeeded.","+  return state_->failureReason().empty() ? InternalSocket::failureReason()","+                                         : state_->failureReason();","+}","+","+void UpstreamSocket::setTransportSocketCallbacks(Network::TransportSocketCallbacks& callbacks) {","+  InternalSocket::setTransportSocketCallbacks(callbacks);","+  callbacks_ = &callbacks;","+  ready_callback_ = callbacks.connection().dispatcher().createSchedulableCallback(","+      [this]() { completeConnect(); });","+  state_->setCallback([this]() { scheduleReady(); });","+  if (dynamic_cast<IoSocket::UserSpace::IoHandle*>(&callbacks.ioHandle()) == nullptr) {","+    state_->fail(\"hbone adapter requires an internal listener\");","+  }","+}","+","+Api::SysCallIntResult UpstreamSocket::connect(Network::ConnectionSocket& socket) {","+  if (state_->phase() == ConnectState::Phase::Failed) {","+    return {-1, SOCKET_ERROR_INVAL};","+  }","+  return InternalSocket::connect(socket);","+}","+","+void UpstreamSocket::onConnected() {","+  internal_connected_ = true;","+  scheduleReady();","+}","+","+void UpstreamSocket::scheduleReady() {","+  if (internal_connected_ && ready_callback_ &&","+      (state_->phase() == ConnectState::Phase::Accepted ||","+       state_->phase() == ConnectState::Phase::Failed)) {","+    ready_callback_->scheduleCallbackNextIteration();","+  }","+}","+","+void UpstreamSocket::completeConnect() {","+  if (state_->phase() == ConnectState::Phase::Failed) {","+    // Return a read error through ConnectionImpl so the pool sees RemoteClose","+    // while still waiting for transport readiness.","+    callbacks_->setTransportSocketIsReadable();","+    return;","+  }","+  ASSERT(state_->phase() == ConnectState::Phase::Accepted);","+  state_->connected();","+  InternalSocket::onConnected();","+  if (callbacks_->connection().state() == Network::Connection::State::Open) {","+    // A server-first protocol may have sent data while readiness was deferred.","+    callbacks_->setTransportSocketIsReadable();","+    // Connected only flushes nonempty write buffers; also resume a pending empty half-close.","+    callbacks_->ioHandle().activateFileEvents(Event::FileReadyType::Write);","+  }","+}","+","+Network::IoResult UpstreamSocket::doRead(Buffer::Instance& buffer) {","+  if (state_->phase() == ConnectState::Phase::Failed) {","+    return {Network::PostIoAction::Close, 0, false};","+  }","+  if (state_->phase() != ConnectState::Phase::Connected) {","+    // Detect a peer close even if the accepting filter was never instantiated.","+    auto* io = dynamic_cast<IoSocket::UserSpace::IoHandle*>(&callbacks_->ioHandle());","+    if (state_->phase() == ConnectState::Phase::Pending && io != nullptr && io->hasReceivedEof()) {","+      state_->fail(state_->failureReason().empty()","+                       ? \"hbone internal peer closed before CONNECT readiness\"","+                       : state_->failureReason());","+      return {Network::PostIoAction::Close, 0, false};","+    }","+    return {Network::PostIoAction::KeepOpen, 0, false};","+  }","+  return InternalSocket::doRead(buffer);","+}","+","+Network::IoResult UpstreamSocket::doWrite(Buffer::Instance& buffer, bool end_stream) {","+  if (state_->phase() == ConnectState::Phase::Failed) {","+    return {Network::PostIoAction::Close, 0, false};","+  }","+  if (state_->phase() != ConnectState::Phase::Connected) {","+    return {Network::PostIoAction::KeepOpen, 0, false};","+  }","+  return InternalSocket::doWrite(buffer, end_stream);","+}","+","+bool UpstreamSocket::canFlushClose() {","+  return state_->phase() == 