{"id":"afc502c855bfb50a6236d67daf78186404a2a33b","axis":"silent","repo":"expo/expo","sha":"afc502c855bfb50a6236d67daf78186404a2a33b","parsed":{"files":[{"path":".changeset/crypto-aes-sealed-data-validation.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-crypto': patch","+---","+","+[iOS] `AESSealedData.fromCombined` and `fromParts` now reject negative lengths and combined data shorter than the IV and the tag with `ERR_INVALID_SEALED_DATA_CONFIG`, like Android and web do, instead of crashing or building malformed sealed data. A negative nonce length passed to `aesEncryptAsync` rejects with `ERR_NONCE_GENERATION_FAILED` instead of crashing."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/crypto-aes-string-tag.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-crypto': patch","+---","+","+Fix `AESSealedData.fromParts` rejecting a base64 string tag on Android and iOS."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/ios/AES/SealedData.swift","lines":["@@ -22,6 +22,10 @@ final class SealedData: SharedObject {","   }"," ","   init(ivLength: Int, tagLength: Int, content: Data) throws {","+    // Compare without adding the lengths, so that huge values can't overflow and trap.","+    guard ivLength >= 0, tagLength >= 0, ivLength <= content.count, tagLength <= content.count - ivLength else {","+      throw InvalidSealedDataConfigException()","+    }","     // SealedBox(combined:) works only if IV length is 12 (default)","     // otherwise this needs to be done manually","     if ivLength == DEFAULT_IV_LENGTH {","@@ -46,6 +50,9 @@ final class SealedData: SharedObject {","   }"," ","   convenience init(iv: Data, ciphertextWithTag: Data, tagLength: Int) throws {","+    guard tagLength >= 0, ciphertextWithTag.count >= tagLength else {","+      throw InvalidSealedDataConfigException()","+    }","     try self.init(","       iv: iv,","       ciphertext: ciphertextWithTag.dropLast(tagLength),"],"additions":7,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/ios/AES/Utilities.swift","lines":["@@ -38,6 +38,9 @@ extension Data {"," "," extension AES.GCM.Nonce {","   init(ofSize size: Int) throws {","+    guard size >= 0 else {","+      throw NonceGenerationFailedException(size)","+    }","     var data = Data(count: size)","     let status = try data.withUnsafeMutableBytes { (ptr: UnsafeMutableRawBufferPointer) in","       guard let baseAddress = ptr.baseAddress else {"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/ios/Tests/AesCryptoModuleTests.swift","lines":["@@ -442,6 +442,60 @@ struct AesCryptoModuleTests {","     )","     #expect(try result.asString() == \"ERR_INVALID_SEALED_DATA_CONFIG ERR_INVALID_SEALED_DATA_CONFIG\")","   }","+","+  @Test","+  func `fromCombined rejects content shorter than the IV and the tag for a custom config`() throws {","+    let result = try runtime.eval(","+      \"\"\"","+      thrownCode(function () {","+        return AES.SealedData.fromCombined(new Uint8Array(20), { ivLength: 16, tagLength: 16 });","+      })","+      \"\"\"","+    )","+    #expect(try result.asString() == \"ERR_INVALID_SEALED_DATA_CONFIG\")","+  }","+","+  @Test","+  func `fromCombined and fromParts reject negative lengths`() throws {","+    let result = try runtime.eval(","+      \"\"\"","+      join([","+        thrownCode(function () {","+          return AES.SealedData.fromCombined(new Uint8Array(40), { ivLength: 16, tagLength: -1 });","+        }),","+        thrownCode(function () {","+          return AES.SealedData.fromCombined(new Uint8Array(40), { ivLength: -1, tagLength: 16 });","+        }),","+        thrownCode(function () {","+          return AES.SealedData.fromParts(nonce, plaintext, -1);","+        }),","+      ])","+      \"\"\"","+    )","+    #expect(","+      try result.asString()","+        == \"ERR_INVALID_SEALED_DATA_CONFIG ERR_INVALID_SEALED_DATA_CONFIG ERR_INVALID_SEALED_DATA_CONFIG\"","+    )","+  }","+","+  @Test","+  func `fromCombined rejects lengths whose sum overflows`() throws {","+    // The sum of these lengths doesn't fit in `Int`, so a check that adds them would trap.","+    let result = try runtime.eval(","+      \"\"\"","+      thrownCode(function () {","+        return AES.SealedData.fromCombined(new Uint8Array(40), { ivLength: 2 ** 62, tagLength: 2 ** 62 });","+      })","+      \"\"\"","+    )","+    #expect(try result.asString() == \"ERR_INVALID_SEALED_DATA_CONFIG\")","+  }","+","+  @Test","+  func `encryptAsync rejects a negative nonce length`() async throws {","+    let result = try await runtime.evalAsync(\"rejectionCode(encrypt(plaintext, { nonce: -1 }))\")","+    #expect(try result.asString() == \"ERR_NONCE_GENERATION_FAILED\")","+  }"," }"," "," /// AES-256-GCM output for the inputs that the JavaScript prelude declares, computed with the Node.js"],"additions":54,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/src/aes/__tests__/SealedData-test.native.ts","lines":["@@ -0,0 +1,36 @@","+import AesCryptoModule from '../ExpoCryptoAES';","+import { AESSealedData } from '../index';","+","+jest.mock('../ExpoCryptoAES', () => ({","+  __esModule: true,","+  default: {","+    EncryptionKey: class {},","+    SealedData: class {","+      static fromParts = jest.fn();","+      static fromCombined = jest.fn();","+    },","+    encryptAsync: jest.fn(),","+    decryptAsync: jest.fn(),","+  },","+}));","+","+const IV = new Uint8Array(12).fill(0xaa);","+const CIPHERTEXT = new Uint8Array(20).fill(0xbb);","+const TAG = new Uint8Array(16).fill(0xcc);","+const TAG_BASE64 = 'zMzMzMzMzMzMzMzMzMzMzA==';","+","+describe('AESSealedData.fromParts', () => {","+  it('decodes a base64 string tag to bytes before calling native', () => {","+    AESSealedData.fromParts(IV, CIPHERTEXT, TAG_BASE64);","+","+    const [, , tag] = (AesCryptoModule.SealedData.fromParts as jest.Mock).mock.lastCall;","+    expect(tag).toBeInstanceOf(Uint8Array);","+    expect(Array.from(tag)).toEqual(Array.from(