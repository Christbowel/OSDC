(\"keycloak_auth_manager\", \"cli_device_code_enabled\"): \"True\"})","+    @patch(\"airflow.providers.keycloak.auth_manager.services.token.KeycloakAuthManager.get_keycloak_client\")","+    def test_start_device_authorization_keycloak_error(","+        self, mock_get_keycloak_client, error, expected_status","+    ):","+        mock_get_keycloak_client.return_value = Mock(spec=KeycloakOpenID)","+        mock_get_keycloak_client.return_value.device.side_effect = error","+","+        with pytest.raises(fastapi.exceptions.HTTPException) as exc_info:","+            start_device_authorization()","+","+        assert exc_info.value.status_code == expected_status","+","+    @pytest.mark.parametrize(","+        \"call\",","+        [","+            pytest.param(start_device_authorization, id=\"start\"),","+            pytest.param(partial(create_token_from_device_code, \"device\", 10), id=\"token\"),","+        ],","+    )","+    @conf_vars({(\"keycloak_auth_manager\", \"cli_device_code_enabled\"): \"False\"})","+    @patch(\"airflow.providers.keycloak.auth_manager.services.token.KeycloakAuthManager.get_keycloak_client\")","+    def test_device_code_disabled(self, mock_get_keycloak_client, call):","+        with pytest.raises(fastapi.exceptions.HTTPException) as exc_info:","+            call()","+","+        assert exc_info.value.status_code == 400","+        assert exc_info.value.detail == \"Device code login is not enabled for command-line clients\"","+        mock_get_keycloak_client.assert_not_called()","+","+    @conf_vars({(\"keycloak_auth_manager\", \"cli_device_code_enabled\"): \"True\"})","+    @patch(\"airflow.providers.keycloak.auth_manager.services.token.get_auth_manager\")","+    @patch(\"airflow.providers.keycloak.auth_manager.services.token.KeycloakAuthManager.get_keycloak_client\")","+    def test_create_token_from_device_code(self, mock_get_keycloak_client, mock_get_auth_manager):","+        mock_keycloak_client = Mock(spec=KeycloakOpenID)","+        mock_ke