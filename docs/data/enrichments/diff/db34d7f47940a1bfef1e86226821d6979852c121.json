{"id":"db34d7f47940a1bfef1e86226821d6979852c121","axis":"silent","repo":"systemd/systemd","sha":"db34d7f47940a1bfef1e86226821d6979852c121","parsed":{"files":[{"path":"docs/ENVIRONMENT.md","lines":["@@ -928,3 +928,8 @@ Tools using the Varlink protocol (such as `varlinkctl`) or sd-bus (such as","   notification carries no list of updated resources. This is useful to","   unconditionally trigger follow-up work such as relinking a kernel or","   recomputing a TPM policy.","+","+`systemd-report-geoip`:","+","+* `$SYSTEMD_REPORT_GEOIP_ENDPOINT` – takes an HTTP endpoint","+  URL. Overrides the GeoIP endpoint to use."],"additions":5,"deletions":0,"truncated":false},{"path":"man/report-geoip.conf.xml","lines":["@@ -0,0 +1,101 @@","+<?xml version='1.0'?>","+<!DOCTYPE refentry PUBLIC \"-//OASIS//DTD DocBook XML V4.5//EN\"","+  \"http://www.oasis-open.org/docbook/xml/4.5/docbookx.dtd\">","+<!-- SPDX-License-Identifier: LGPL-2.1-or-later -->","+","+<refentry id=\"report-geoip.conf\" conditional=\"ENABLE_REPORT HAVE_LIBCURL\"","+          xmlns:xi=\"http://www.w3.org/2001/XInclude\">","+  <refentryinfo>","+    <title>report-geoip.conf</title>","+    <productname>systemd</productname>","+  </refentryinfo>","+","+  <refmeta>","+    <refentrytitle>report-geoip.conf</refentrytitle>","+    <manvolnum>5</manvolnum>","+  </refmeta>","+","+  <refnamediv>","+    <refname>report-geoip.conf</refname>","+    <refname>report-geoip.conf.d</refname>","+    <refpurpose>GeoIP report metrics configuration file</refpurpose>","+  </refnamediv>","+","+  <refsynopsisdiv>","+    <para><simplelist>","+      <member><filename>/etc/systemd/report-geoip.conf</filename></member>","+      <member><filename>/run/systemd/report-geoip.conf</filename></member>","+      <member><filename>/usr/local/lib/systemd/report-geoip.conf</filename></member>","+      <member><filename>/usr/lib/systemd/report-geoip.conf</filename></member>","+      <member><filename>/etc/systemd/report-geoip.conf.d/*.conf</filename></member>","+      <member><filename>/run/systemd/report-geoip.conf.d/*.conf</filename></member>","+      <member><filename>/usr/local/lib/systemd/report-geoip.conf.d/*.conf</filename></member>","+      <member><filename>/usr/lib/systemd/report-geoip.conf.d/*.conf</filename></member>","+    </simplelist></para>","+  </refsynopsisdiv>","+","+  <refsect1>","+    <title>Description</title>","+","+    <para>This file configures the behavior of","+    <citerefentry><refentrytitle>systemd-report-geoip@.service</refentrytitle><manvolnum>8</manvolnum></citerefentry>,","+    a metrics source for","+    <citerefentry><refentrytitle>systemd-report</refentrytitle><manvolnum>1</manvolnum></citerefentry>","+    reporting the approximate geographic location of the system.</para>","+  </refsect1>","+","+  <xi:include href=\"standard-conf.xml\" xpointer=\"main-conf\" />","+","+  <refsect1>","+    <title>Options</title>","+","+    <para>All options are configured in the [GeoIP] section:</para>","+","+    <variablelist class='config-directives'>","+","+      <varlistentry>","+        <term><varname>Endpoint=</varname></term>","+","+        <listitem><para>The HTTP or HTTPS URL of the geolocation web service to query. The service must","+        answer a GET request with a JSON object in the format of the","+        <ulink url=\"https://reallyfreegeoip.org/\">reallyfreegeoip.org</ulink> service, describing the","+        location of the address the request originates from. The field names used by","+        <ulink url=\"https://ipinfo.io/\">ipinfo.io</ulink> (i.e. <literal>country</literal>,","+        <literal>region</literal>, <literal>continent</literal> in place of <literal>country_name</literal>,","+        <literal>region_name</literal>, <literal>continent_name</literal>) are understood too. Fields the","+        service does not provide are not reported. If assigned the empty string, the default is","+        restored. The default is chosen at compile time.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/>","+        </listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><varname>RefreshSec=</varname></term>","+","+        <listitem><para>Controls how often the geolocation data is refreshed from the endpoint, at most.","+        Takes a time span, see","+        <citerefentry><refentrytitle>systemd.time</refentrytitle><manvolnum>7</manvolnum></citerefentry> for","+        details. The acquired data is cached locally, and the endpoint is only contacted again once the","+        cached data is older than the specified time. If set to zero, the endpoint is contacted on every","+        request. If set to <literal>infinity</literal>, the endpoint is contacted only once, and the cached","+        data is used from then on. Defaults to <literal>30min</literal>.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/>","+        </listitem>","+      </varlistentry>","+    </variablelist>","+","+    <para>Use <programlisting>systemd-analyze cat-config systemd/report-geoip.conf</programlisting>","+    to display the full config.</para>","+  </refsect1>","+","+  <refsect1>","+    <title>See Also</title>","+    <para><simplelist type=\"inline\">","+      <member><citerefentry><refentrytitle>systemd-report-geoip@.service</refentrytitle><manvolnum>8</manvolnum></citerefentry></member>","+      <member><citerefentry><refentrytitle>systemd-report</refentrytitle><manvolnum>1</manvolnum></citerefentry></member>","+    </simplelist></para>","+  </refsect1>","+","+</refentry>"],"additions":101,"deletions":0,"truncated":false},{"path":"man/rules/meson.build","lines":["@@ -83,6 +83,10 @@ manpages = [","  ['poweroff', '8', ['halt', 'reboot'], ''],","  ['pstore.conf', '5', ['pstore.conf.d'], 'ENABLE_PSTORE'],","  ['repart.d', '5', [], 'ENABLE_REPART'],","+ ['report-geoip.conf',","+  '5',","+  ['report-geoip.conf.d'],","+  'ENABLE_REPORT HAVE_LIBCURL'],","  ['resolvectl', '1', ['resolvconf'], 'ENABLE_RESOLVE'],","  ['resolved.conf', '5', ['resolved.conf.d'], 'ENABLE_RESOLVE'],","  ['run0', '1', [], ''],","@@ -1225,6 +1229,10 @@ manpages = [","   '8',","   ['systemd-report-files', 'systemd-report-files.socket'],","   'ENABLE_REPORT'],","+ ['systemd-report-geoip@.service',","+  '8',","+  ['systemd-report-geoip', 'systemd-report-geoip.socket'],","+  'ENABLE_REPORT HAVE_LIBCURL'],","  ['systemd-report-hwmon@.service',","   '8',","   ['systemd-report-hwmon', 'systemd-report-hwmon.socket'],"],"additions":8,"deletions":0,"truncated":false},{"path":"man/systemd-report-geoip@.service.xml","lines":["@@ -0,0 +1,156 @@","+<?xml version=\"1.0\"?> <!--*-nxml-*-->","+<!DOCTYPE refentry PUBLIC \"-//OASIS//DTD DocBook XML V4.5//EN\"","+  \"http://www.oasis-open.org/docbook/xml/4.5/docbookx.dtd\">","+<!-- SPDX-License-Identifier: LGPL-2.1-or-later -->","+","+<refentry id=\"systemd-report-geoip_.service\" conditional=\"ENABLE_REPORT HAVE_LIBCURL\"","+          xmlns:xi=\"http://www.w3.org/2001/XInclude\">","+","+  <refentryinfo>","+    <title>systemd-report-geoip@.service</title>","+    <productname>systemd</productname>","+  </refentryinfo>","+","+  <refmeta>","+    <refentrytitle>systemd-report-geoip@.service</refentrytitle>","+    <manvolnum>8</manvolnum>","+  </refmeta>","+","+  <refnamediv>","+    <refname>systemd-report-geoip@.service</refname>","+    <refname>systemd-report-geoip.socket</refname>","+    <refname>systemd-report-geoip</refname>","+    <refpurpose>Report the approximate geographic location of the system as a metric</refpurpose>","+  </refnamediv>","+","+  <refsynopsisdiv>","+    <para><filename>systemd-report-geoip@.service</filename></para>","+    <para><filename>systemd-report-geoip.socket</filename></para>","+    <para><filename>/usr/lib/systemd/systemd-report-geoip</filename></para>","+  </refsynopsisdiv>","+","+  <refsect1>","+    <title>Description</title>","+","+    <para><command>systemd-report-geoip@.service</command> is a metrics source for","+    <citerefentry><refentrytitle>systemd-report</refentrytitle><manvolnum>1</manvolnum></citerefentry>. It","+    reports the approximate geographic location of the system, as determined by a public IP geolocation","+    web service from the public IP address the system connects to it with. It implements the","+    <constant>io.systemd.Metrics</constant> Varlink interface on a socket linked into the","+    <filename>/run/systemd/report/</filename> directory.</para>","+","+    <para>The geolocation data is acquired via HTTP from the endpoint configured in","+    <citerefentry><refentrytitle>report-geoip.conf</refentrytitle><manvolnum>5</manvolnum></citerefentry>. The","+    acquired data is cached, and only refreshed once the cache is older than the configured","+    <varname>RefreshSec=</varname> interval. If the endpoint cannot be reached, the cached data is reported","+    even if it is older than that. If no data is available at all, no metrics are reported.</para>","+  </refsect1>","+","+  <refsect1>","+    <title>Metrics</title>","+","+    <para>The following metrics are reported, all in the <literal>io.systemd.GeoIP.</literal> namespace. Fields","+    the geolocation service does not provide are not reported.</para>","+","+    <variablelist>","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.PublicAddress</constant></term>","+        <listitem><para>The public IP address of the system, as seen by the geolocation service. The address","+        is validated and reported in normalized form.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.ASN</constant></term>","+        <term><constant>io.systemd.GeoIP.ASName</constant></term>","+        <term><constant>io.systemd.GeoIP.ASDomain</constant></term>","+        <listitem><para>The Autonomous System Number (e.g. <literal>AS3320</literal>) of the network the public","+        IP address belongs to, and the name and domain of the organization operating it.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.ContinentCode</constant></term>","+        <term><constant>io.systemd.GeoIP.ContinentName</constant></term>","+        <listitem><para>The code (e.g. <literal>EU</literal>) and the name of the continent the system is","+        located in.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.CountryCode</constant></term>","+        <term><constant>io.systemd.GeoIP.CountryName</constant></term>","+        <listitem><para>The ISO 3166-1 alpha-2 code and the name of the country the system is located","+        in.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.RegionCode</constant></term>","+        <term><constant>io.systemd.GeoIP.RegionName</constant></term>","+        <listitem><para>The code and name of the region (state, province, …) the system is located","+        in.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.City</constant></term>","+        <term><constant>io.systemd.GeoIP.ZipCode</constant></term>","+        <listitem><para>The city and postal code of the area the system is located in.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.Timezone</constant></term>","+        <listitem><para>The IANA time zone name of the area the system is located in.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.Latitude</constant></term>","+        <term><constant>io.systemd.GeoIP.Longitude</constant></term>","+        <listitem><para>The geographic coordinates of the system's location, in decimal degrees.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+","+      <varlistentry>","+        <term><constant>io.systemd.GeoIP.Timestamp</constant></term>","+        <listitem><para>The time at which the reported data was acquired from the geolocation service, in","+        microseconds since the UNIX epoch (<constant>CLOCK_REALTIME</constant>). When the data is served from","+        the cache this is the time the cache was last refreshed, not the time of the report.</para>","+","+        <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></listitem>","+      </varlistentry>","+    </variablelist>","+  </refsect1>","+","+  <refsect1>","+    <title>Privacy</title>","+","+    <para>Note that refreshing the geolocation data means contacting a third party web service, which","+    thereby learns the public IP address of the system. The reported metrics identify the system's public IP","+    address and approximate location, and hence are sensitive. Only enable this service if this is acceptable","+    for the systems the reports are collected from.</para>","+  </refsect1>","+","+  <!-- Note: we do not document the command line switches here. The systemd-report-geoip binary itself should","+       not be invoked by users, but only as a service. Use systemd-report(1) to acquire metrics. -->","+","+  <refsect1>","+    <title>See Also</title>","+    <para><simplelist type=\"inline\">","+      <member><citerefentry><refentrytitle>systemd</refentrytitle><manvolnum>1</manvolnum></citerefentry></member>","+      <member><citerefentry><refentrytitle>systemd-report</refentrytitle><manvolnum>1</manvolnum></citerefentry></member>","+      <member><citerefentry><refentrytitle>report-geoip.conf</refentrytitle><manvolnum>5</manvolnum></citerefentry></member>","+    </simplelist></para>","+  </refsect1>","+","+</refentry>"],"additions":156,"deletions":0,"truncated":false},{"path":"meson.build","lines":["@@ -981,6 +981,9 @@ conf.set_quoted('DNS_SERVERS', dns_servers)"," ntp_servers = get_option('ntp-servers')"," conf.set_quoted('NTP_SERVERS', ntp_servers)"," ","+geoip_endpoint = get_option('geoip-endpoint')","+conf.set_quoted('GEOIP_ENDPOINT', geoip_endpoint)","+"," default_locale = get_option('default-locale')"," conf.set_quoted('SYSTEMD_DEFAULT_LOCALE', default_locale)"," ","@@ -3149,6 +3152,7 @@ summary({","         'default LLMNR mode'                        : default_llmnr,","         'default DNS servers'                       : dns_servers.split(' '),","         'default NTP servers'                       : ntp_servers.split(' '),","+        'default GeoIP endpoint'                    : geoip_endpoint,","         'default net.naming_scheme= value'          : default_net_naming_scheme,","         'default KillUserProcesses= value'          : kill_user_processes,","         'default locale'                            : default_locale,"],"additions":4,"deletions":0,"truncated":false},{"path":"meson_options.txt","lines":["@@ -602,3 +602,7 @@ option('oss-fuzz', type : 'boolean', value : false,","        description : 'build against oss-fuzz')"," option('llvm-fuzz', type : 'boolean', value : false,","        description : 'build against LLVM libFuzzer')","+","+option('geoip-endpoint', type : 'string',","+       description : 'default URL of the IP geolocation web service queried by systemd-report-geoip',","+       value : 'https://reallyfreegeoip.org/json/')"],"additions":4,"deletions":0,"truncated":false},{"path":"shell-completion/bash/systemd-analyze","lines":["@@ -107,7 +107,7 @@ _systemd_analyze() {"," ","     local CONFIGS='locale.conf systemd/bootchart.conf systemd/coredump.conf systemd/journald.conf","                        systemd/journal-remote.conf systemd/journal-upload.conf systemd/logind.conf","-                       systemd/resolved.conf systemd/networkd.conf systemd/pstore.conf systemd/resolved.conf","+                       systemd/resolved.conf systemd/networkd.conf systemd/pstore.conf systemd/report-geoip.conf systemd/resolved.conf","                        systemd/sleep.conf systemd/system.conf systemd/timedated.conf","                        systemd/timesyncd.conf systemd/user.conf udev/udev.conf'"," "],"additions":1,"deletions":1,"truncated":false},{"path":"src/report/meson.build","lines":["@@ -58,6 +58,17 @@ executables += [","                         'report-files-server.c',","                 ),","         },","+        libexec_template + {","+                'name' : 'systemd-report-geoip',","+                'sources' : files(","+                        'report-geoip.c',","+                        'report-geoip-server.c',","+                ),","+                'dependencies' : [","+                        libcurl_cflags,","+                ],","+                'conditions' : ['HAVE_LIBCURL'],","+        },","         libexec_template + {","                 'name' : 'systemd-report-hwmon',","                 'sources' : files(","@@ -101,3 +112,10 @@ executables += [","                 ),","         },"," ]","+","+custom_target(","+        input : 'report-geoip.conf.in',","+        output : 'report-geoip.conf',","+        command : [jinja2_cmdline, '@INPUT@', '@OUTPUT@'],","+        install : conf.get('HAVE_LIBCURL') == 1 and install_sysconfdir_samples,","+        install_dir : pkgconfigfiledir)"],"additions":18,"deletions":0,"truncated":false},{"path":"src/report/report-geoip-server.c","lines":["@@ -0,0 +1,175 @@","+/* SPDX-License-Identifier: LGPL-2.1-or-later */","+","+#include \"sd-json.h\"","+#include \"sd-varlink.h\"","+","+#include \"alloc-util.h\"","+#include \"build.h\"","+#include \"conf-parser.h\"","+#include \"dlopen-note.h\"","+#include \"log.h\"","+#include \"main-func.h\"","+#include \"report-geoip.h\"","+#include \"string-util.h\"","+#include \"time-util.h\"","+#include \"varlink-io.systemd.Metrics.h\"","+#include \"varlink-util.h\"","+#include \"verbs.h\"","+#include \"web-util.h\"","+","+#define REPORT_GEOIP_DEFAULT_REFRESH_USEC (30 * USEC_PER_MINUTE)","+","+COMMAND(","+        \"systemd-report-geoip\\0\",","+        \"Report the approximate geographic location of the system as a metric.\",","+        .man_pages = \"systemd-report-geoip@.service(8)\\0\",","+);","+","+char *arg_endpoint = NULL;","+usec_t arg_refresh_usec = REPORT_GEOIP_DEFAULT_REFRESH_USEC;","+","+STATIC_DESTRUCTOR_REGISTER(arg_endpoint, freep);","+","+static int config_parse_endpoint(","+                const char *unit,","+                const char *filename,","+                unsigned line,","+                const char *section,","+                unsigned section_line,","+                const char *lvalue,","+                int ltype,","+                const char *rvalue,","+                void *data,","+                void *userdata) {","+","+        char **s = ASSERT_PTR(data);","+","+        assert(filename);","+        assert(lvalue);","+        assert(rvalue);","+","+        if (isempty(rvalue)) {","+                *s = mfree(*s);","+                return 0;","+        }","+","+        if (!http_url_is_valid(rvalue)) {","+                log_syntax(unit, LOG_WARNING, filename, line, 0,","+                           \"%s= URL is not valid, ignoring: %s\", lvalue, rvalue);","+                return 0;","+        }","+","+        return free_and_strdup_warn(s, rvalue);","+}","+","+static int parse_config(void) {","+        static const ConfigTableItem items[] = {","+                { \"GeoIP\", \"Endpoint\",   config_parse_endpoint, 0, &arg_endpoint     },","+                { \"GeoIP\", \"RefreshSec\", config_parse_sec,      0, &arg_refresh_usec },","+                {}","+        };","+","+        return config_parse_standard_file_with_dropins(","+                        \"systemd/report-geoip.conf\",","+                        \"GeoIP\\0\",","+                        config_item_table_lookup, items,","+                        CONFIG_PARSE_WARN,","+                        /* userdata= */ NULL);","+}","+","+static int parse_environment(void) {","+","+        const char *d = secure_getenv(\"SYSTEMD_REPORT_GEOIP_ENDPOINT\");","+        if (!d)","+                return 0;","+","+        if (isempty(d)) {","+                arg_endpoint = mfree(arg_endpoint);","+                return 0;","+        }","+","+        if (!http_url_is_valid(d)) {","+                log_warning(\"$SYSTEMD_REPORT_GEOIP_ENDPOINT is not a valid URL, ignoring: %s\", d);","+                return 0;","+        }","+","+        return free_and_strdup_warn(&arg_endpoint, d);","+}","+","+static int vl_server(void) {","+        _cleanup_(sd_varlink_server_unrefp) sd_varlink_server *vs = NULL;","+        int r;","+","+        r = varlink_server_new(&vs, /* flags= */ 0, /* userdata= */ NULL);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to allocate Varlink server: %m\");","+","+        r = sd_varlink_server_add_interface(vs, &vl_interface_io_systemd_Metrics);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to add Varlink interface: %m\");","+","+        r = sd_varlink_server_bind_method_many(","+                        vs,","+                        \"io.systemd.Metrics.List\",     vl_method_list_metrics,","+                        \"io.systemd.Metrics.Describe\", vl_method_describe_metrics);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to bind Varlink methods: %m\");","+","+        r = sd_varlink_server_loop_auto(vs);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to run Varlink event loop: %m\");","+","+        return 0;","+}","+","+static int parse_argv(int argc, char *argv[]) {","+        int r;","+","+        assert(argc >= 0);","+        assert(argv);","+","+        OptionParser opts = { argc, argv };","+","+        FOREACH_OPTION_OR_RETURN(c, &opts)","+                switch (c) {","+                OPTION_COMMON_HELP:","+                        return command_print_help();","+","+                OPTION_COMMON_VERSION:","+                        return version();","+","+                OPTION_COMMON_INTROSPECT_CLI:","+                        return introspect_cli(SD_JSON_FORMAT_OFF);","+                }","+","+        if (option_parser_get_n_args(&opts) > 0)","+                return log_error_errno(SYNTHETIC_ERRNO(EINVAL),","+                                       \"This program takes no arguments.\");","+","+        r = sd_varlink_invocation(SD_VARLINK_ALLOW_ACCEPT);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to check if invoked in Varlink mode: %m\");","+        if (r == 0)","+                return log_error_errno(SYNTHETIC_ERRNO(EINVAL),","+                                       \"This program can only run as a Varlink service.\");","+        return 1;","+}","+","+static int run(int argc, char *argv[]) {","+        int r;","+","+        LIBCURL_NOTE(required);","+","+        log_setup();","+","+        r = parse_argv(argc, argv);","+        if (r <= 0)","+                return r;","+","+        (void) parse_config();","+        (void) parse_environment();","+","+        return vl_server();","+}","+","+DEFINE_MAIN_FUNCTION(run);"],"additions":175,"deletions":0,"truncated":false},{"path":"src/report/report-geoip.c","lines":["@@ -0,0 +1,686 @@","+/* SPDX-License-Identifier: LGPL-2.1-or-later */","+","+#include <math.h>","+#include <sys/stat.h>","+","+#include \"sd-json.h\"","+#include \"sd-varlink.h\"","+","+#include \"alloc-util.h\"","+#include \"curl-util.h\"","+#include \"fd-util.h\"","+#include \"fileio.h\"","+#include \"in-addr-util.h\"","+#include \"iovec-util.h\"","+#include \"json-util.h\"","+#include \"lock-util.h\"","+#include \"log.h\"","+#include \"metrics.h\"","+#include \"mkdir.h\"","+#include \"path-lookup.h\"","+#include \"path-util.h\"","+#include \"report-geoip.h\"","+#include \"stat-util.h\"","+#include \"string-util.h\"","+#include \"time-util.h\"","+#include \"version.h\"","+#include \"web-util.h\"","+","+#define METRIC_IO_SYSTEMD_GEOIP_PREFIX \"io.systemd.GeoIP.\"","+","+/* The cache lives below the service's StateDirectory= (as passed via $STATE_DIRECTORY), so that it survives","+ * reboots, falling back to this path below /var/lib/ when started directly from the command line. All","+ * instances of the socket activated service share it, hence access is serialized via a lock file next to it. */","+#define REPORT_GEOIP_STATE_DIR_SUFFIX \"systemd/report-geoip\"","+#define REPORT_GEOIP_CACHE_FILE_NAME \"cache.json\"","+","+/* Upper bound on the size of the answer we accept from the server, and of the cache file we are willing to","+ * read back. The actual answer is a couple of hundred bytes. */","+#define REPORT_GEOIP_ANSWER_MAX (64U * 1024U)","+","+/* The overall Varlink call is bounded by the client's timeout (30s for systemd-report), hence keep the","+ * network timeout well below that, so that we can still fall back to the cache in time. */","+#define REPORT_GEOIP_NETWORK_TIMEOUT_USEC (10 * USEC_PER_SEC)","+","+/* Follow HTTP redirects, but only a few of them. */","+#define REPORT_GEOIP_MAX_REDIRECTS 5L","+","+typedef enum GeoIPField {","+        GEOIP_FIELD_IP,","+        GEOIP_FIELD_ASN,","+        GEOIP_FIELD_AS_NAME,","+        GEOIP_FIELD_AS_DOMAIN,","+        GEOIP_FIELD_CONTINENT_CODE,","+        GEOIP_FIELD_CONTINENT_NAME,","+        GEOIP_FIELD_COUNTRY_CODE,","+        GEOIP_FIELD_COUNTRY_NAME,","+        GEOIP_FIELD_REGION_CODE,","+        GEOIP_FIELD_REGION_NAME,","+        GEOIP_FIELD_CITY,","+        GEOIP_FIELD_ZIP_CODE,","+        GEOIP_FIELD_TIME_ZONE,","+        GEOIP_FIELD_LATITUDE,","+        GEOIP_FIELD_LONGITUDE,","+        GEOIP_FIELD_TIMESTAMP,","+        _GEOIP_FIELD_MAX,","+        _GEOIP_FIELD_INVALID = -EINVAL,","+} GeoIPField;","+","+typedef enum GeoIPValueType {","+        GEOIP_VALUE_STRING,    /* A free-form string, reported as is */","+        GEOIP_VALUE_ADDRESS,   /* An IP address, stored in parsed form and reported in normalized form */","+        GEOIP_VALUE_DOUBLE,    /* A floating point number */","+        GEOIP_VALUE_TIMESTAMP, /* A CLOCK_REALTIME timestamp in µs */","+        _GEOIP_VALUE_TYPE_MAX,","+        _GEOIP_VALUE_TYPE_INVALID = -EINVAL,","+} GeoIPValueType;","+","+/* The data we pick out of the server's JSON answer, plus when we acquired it. */","+typedef struct GeoIPData {","+        struct in_addr_data ip;","+        char *asn;","+        char *as_name;","+        char *as_domain;","+        char *continent_code;","+        char *continent_name;","+        char *country_code;","+        char *country_name;","+        char *region_code;","+        char *region_name;","+        char *city;","+        char *zip_code;","+        char *time_zone;","+        double latitude;","+        double longitude;","+        usec_t timestamp; /* CLOCK_REALTIME, when the data was downloaded (i.e. the mtime of the cache file) */","+} GeoIPData;","+","+#define GEOIP_DATA_INIT                                                 \\","+        (GeoIPData) {                                                   \\","+                .ip.family = AF_UNSPEC,                                 \\","+                .latitude = NAN,                                        \\","+                .longitude = NAN,                                       \\","+                .timestamp = USEC_INFINITY,                             \\","+        }","+","+static void geoip_data_done(GeoIPData *d) {","+        assert(d);","+","+        d->asn = mfree(d->asn);","+        d->as_name = mfree(d->as_name);","+        d->as_domain = mfree(d->as_domain);","+        d->continent_code = mfree(d->continent_code);","+        d->continent_name = mfree(d->continent_name);","+        d->country_code = mfree(d->country_code);","+        d->country_name = mfree(d->country_name);","+        d->region_code = mfree(d->region_code);","+        d->region_name = mfree(d->region_name);","+        d->city = mfree(d->city);","+        d->zip_code = mfree(d->zip_code);","+        d->time_zone = mfree(d->time_zone);","+}","+","+static int geoip_data_parse(const char *text, GeoIPData *ret) {","+        /* Note that different providers return slightly different fields, hence the partially redundant","+         * definitions here. Additional fields the server might return are ignored. */","+        static const sd_json_dispatch_field dispatch_table[] = {","+                { \"ip\",             _SD_JSON_VARIANT_TYPE_INVALID, json_dispatch_in_addr_data, offsetof(GeoIPData, ip),             SD_JSON_NULLABLE },","+                { \"asn\",            SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, asn),            SD_JSON_NULLABLE },","+                { \"as_name\",        SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, as_name),        SD_JSON_NULLABLE },","+                { \"as_domain\",      SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, as_domain),      SD_JSON_NULLABLE },","+                { \"continent_code\", SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, continent_code), SD_JSON_NULLABLE },","+                { \"continent\",      SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, continent_name), SD_JSON_NULLABLE },","+                { \"continent_name\", SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, continent_name), SD_JSON_NULLABLE },","+                { \"country_code\",   SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, country_code),   SD_JSON_NULLABLE },","+                { \"country\",        SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, country_name),   SD_JSON_NULLABLE },","+                { \"country_name\",   SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, country_name),   SD_JSON_NULLABLE },","+                { \"region_code\",    SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, region_code),    SD_JSON_NULLABLE },","+                { \"region\",         SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, region_name),    SD_JSON_NULLABLE },","+                { \"region_name\",    SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, region_name),    SD_JSON_NULLABLE },","+                { \"city\",           SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, city),           SD_JSON_NULLABLE },","+                { \"zip_code\",       SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, zip_code),       SD_JSON_NULLABLE },","+                { \"time_zone\",      SD_JSON_VARIANT_STRING,        sd_json_dispatch_string,    offsetof(GeoIPData, time_zone),      SD_JSON_NULLABLE },","+                { \"latitude\",       _SD_JSON_VARIANT_TYPE_INVALID, sd_json_dispatch_double,    offsetof(GeoIPData, latitude),       SD_JSON_NULLABLE },","+                { \"longitude\",      _SD_JSON_VARIANT_TYPE_INVALID, sd_json_dispatch_double,    offsetof(GeoIPData, longitude),      SD_JSON_NULLABLE },","+                {},","+        };","+","+        int r;","+","+        assert(text);","+        assert(ret);","+","+        _cleanup_(sd_json_variant_unrefp) sd_json_variant *v = NULL;","+        r = sd_json_parse(text, SD_JSON_PARSE_MUST_BE_OBJECT, &v, /* reterr_line= */ NULL, /* reterr_colum