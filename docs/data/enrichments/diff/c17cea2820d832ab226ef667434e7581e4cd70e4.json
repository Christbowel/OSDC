{"id":"c17cea2820d832ab226ef667434e7581e4cd70e4","axis":"silent","repo":"micronaut-projects/micronaut-core","sha":"c17cea2820d832ab226ef667434e7581e4cd70e4","parsed":{"files":[{"path":"inject-java/src/test/groovy/io/micronaut/inject/beans/RuntimeBeanDefinitionResolutionContextLookupSpec.groovy","lines":["@@ -0,0 +1,209 @@","+package io.micronaut.inject.beans","+","+import io.micronaut.context.ApplicationContext","+import io.micronaut.context.BeanContext","+import io.micronaut.inject.BeanDefinition","+import io.micronaut.context.BeanRegistration","+import io.micronaut.context.RuntimeBeanDefinition","+import io.micronaut.context.annotation.Prototype","+import io.micronaut.context.exceptions.NoSuchBeanException","+import io.micronaut.core.type.Argument","+import io.micronaut.inject.beans.injectionpoints.DisposableDependency","+import spock.lang.Specification","+","+import java.util.function.BiConsumer","+import java.util.function.Function","+","+/**","+ * A bean the caller chose by definition is resolved within the caller's resolution context: what is created for it","+ * sees the caller as the injection point it is created for, and a dependent it creates belongs to the caller's","+ * registration.","+ */","+class RuntimeBeanDefinitionResolutionContextLookupSpec extends Specification {","+","+    private static RuntimeBeanDefinition<Chosen> chosenDefinition() {","+        RuntimeBeanDefinition.builder(Chosen, { RuntimeBeanDefinition.CreationContext ctx ->","+            new Chosen(","+                    ctx.injectionPoint.map { it.declaringBean.beanType }.orElse(null),","+                    ctx.getBean(Argument.of(DisposableDependency))","+            )","+        } as Function<RuntimeBeanDefinition.CreationContext, Chosen>)","+                .scope(Prototype)","+                .disposer({ BeanContext bc, Chosen chosen -> chosen.disposed = true } as BiConsumer<BeanContext, Chosen>)","+                .build()","+    }","+","+    private static RuntimeBeanDefinition<Outer> outerDefinition(Function<RuntimeBeanDefinition.CreationContext, BeanRegistration<Chosen>> resolve) {","+        RuntimeBeanDefinition.builder(Outer, { RuntimeBeanDefinition.CreationContext ctx ->","+            new Outer(resolve.apply(ctx))","+        } as Function<RuntimeBeanDefinition.CreationContext, Outer>)","+                .scope(Prototype)","+                .build()","+    }","+","+    private static ApplicationContext start(RuntimeBeanDefinition<?>... definitions) {","+        ApplicationContext.builder()","+                .beanDefinitions(definitions)","+                .build()","+                .start()","+    }","+","+    void 'test a bean resolved by definition in the caller resolution context is created for the caller'() {","+        given:","+        def context = start(chosenDefinition(), outerDefinition(ctx -> {","+            BeanDefinition<Chosen> definition = ctx.beanContext.getBeanDefinition(Chosen)","+            ctx.getBeanRegistration(definition, Argument.of(Chosen))","+        }))","+","+        when:","+        Outer outer = context.getBean(Outer)","+        Chosen chosen = outer.chosenRegistration.bean","+","+        then: \"the chosen bean was created in the resolution the outer bean started\"","+        chosen.declaringBeanType == Outer","+        outer.chosenRegistration.beanDefinition.beanType == Chosen","+","+        cleanup:","+        context.close()","+    }","+","+    void 'test a bean resolved by definition outside a resolution context is created for no injection point'() {","+        given:","+        def context = start(chosenDefinition())","+","+        when:","+        Chosen chosen = context.getBeanRegistration(context.getBeanDefinition(Chosen), Argument.of(Chosen)).bean","+","+        then:","+        chosen.declaringBeanType == null","+","+        cleanup:","+        context.close()","+    }","+","+    void 'test a dependent resolved by definition in the caller resolution context is owned by the caller registration'() {","+        given:","+        def context = start(chosenDefinition(), outerDefinition(ctx -> {","+            BeanDefinition<Chosen> definition = ctx.beanContext.getBeanDefinition(Chosen)","+            ctx.getBeanRegistration(definition, Argument.of(Chosen))","+        }))","+","+        when:","+        BeanRegistration<Outer> outerRegistration = context.getBeanRegistration(Outer, null)","+        Chosen chosen = outerRegistration.bean.chosenRegistration.bean","+","+        then:","+        !chosen.disposed","+        !chosen.dependency.destroyed","+","+        when: \"the outer registration is closed\"","+        outerRegistration.close()","+","+        then: \"the chosen bean and what it created go with it\"","+        chosen.disposed","+        chosen.dependency.destroyed","+","+        cleanup:","+        context.close()","+    }","+","+    void 'test the registration of a bean resolved by definition in the caller resolution context destroys it on its own'() {","+        given:","+        def context = start(chosenDefinition(), outerDefinition(ctx -> {","+            BeanDefinition<Chosen> definition = ctx.beanContext.getBeanDefinition(Chosen)","+            ctx.getBeanRegistration(definition, Argument.of(Chosen))","+        }))","+","+        when:","+        BeanRegistration<Outer> outerRegistration = context.getBeanRegistration(Outer, null)","+        BeanRegistration<Chosen> chosenRegistration = outerRegistration.bean.chosenRegistration","+        chosenRegistration.close()","+","+        then: \"closing the dependent registration itself destroys it, as closing one a lookup by type returned does\"","+        chosenRegistration.bean.disposed","+        chosenRegistration.bean.dependency.destroyed","+","+        when:","+        outerRegistration.close()","+","+        then: \"and the outer bean does not destroy it again\"","+        noExceptionThrown()","+","+        cleanup:","+        context.close()","+    }","+","+    void 'test the bean of a registration resolved by definition in the caller resolution context has the same lifetime'() {","+        given:","+        def context = start(chosenDefinition(), outerDefinition(ctx -> {","+            BeanDefinition<Chosen> definition = ctx.beanContext.getBeanDefinition(Chosen)","+            Chosen resolved = ctx.getBeanRegistration(definition, Argument.of(Chosen)).bean","+            BeanRegistration.of(ctx.beanContext, null, definition, resolved)","+        }))","+","+        when:","+        BeanRegistration<Outer> outerRegistration = context.getBeanRegistration(Outer, null)","+        Chosen chosen = outerRegistration.bean.chosenRegistration.bean","+","+        then:","+        chosen.declaringBeanType == Outer","+","+        when:","+        outerRegistration.close()","+","+        then:","+        chosen.disposed","+        chosen.dependency.destroyed","+","+        cleanup:","+        context.close()","+    }","+","+    void 'test a definition that is not a candidate for the type fails in the caller resolution context'() {","+        given:","+        def context = start(chosenDefinition(), outerDefinition(ctx -> {","+            BeanDefinition<Chosen> definition = ctx.beanContext.getBeanDefinition(Chosen)","+            ctx.getBeanRegistration(definition, (Argument) Argument.of(String))","+        }))","+","+        when:","+        context.getBean(Outer)","+","+        then:","+        def e = thrown(Exception)","+        causeOf(e, NoSuchBeanException) != null","+","+        cleanup:","+        context.close()","+    }","+","+    private static Throwable causeOf(Throwable e, Class<? extends Throwable> type) {","+        Throwable current = e","+        while (current != null) {","+            if (type.isInstance(current)) {","+                return current","+            }","+            current = current.cause","+        }","+        return null","+    }","+","+    static class Chosen {","+        final Class<?> declaringBeanType","+        final DisposableDependency dependency","+        boolean disposed","+","+        Chosen(Class<?> declaringBeanType, DisposableDependency dependency) {","+            this.declaringBeanType = declaringBeanType","+            this.dependency = dependency","+        }","+    }","+","+    static class Outer {","+        final BeanRegistration<Chosen> chosenRegistration","+","+        Outer(BeanRegistration<Chosen> chosenRegistration) {","+            this.chosenRegistration = chosenRegistration","+        }","+    }","+}"],"additions":209,"deletions":0,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/AbstractBeanResolutionContext.java","lines":["@@ -424,9 +424,14 @@ public <T> T getBean(Class<T> beanType, @Nullable Qualifier<T> qualifier) {","         return getBean(Argument.of(beanType), qualifier);","     }"," ","+    @Override","+    public <T> BeanRegistration<T> getBeanRegistration(BeanDefinition<? extends T> definition, Argument<T> beanType) {","+        return context.getBeanRegistration(this, definition, beanType);","+    }","+","     @Override","     public <T> T getBean(BeanDefinition<? extends T> definition, Argument<T> beanType) {","-        T bean = context.getBeanRegistration(this, definition, beanType).getBean();","+        T bean = getBeanRegistration(definition, beanType).getBean();","         if (tracer != null) {","             tracer.traceBeanResolved(","                 this,"],"additions":6,"deletions":1,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/BeanResolutionContext.java","lines":["@@ -153,6 +153,26 @@ default <R> R withDependencies(Function<BeanDependencyGroup, R> action) {","      */","     <T> T getBean(BeanDefinition<? extends T> definition, Argument<T> beanType);"," ","+    /**","+     * Resolves the registration of the bean of the given definition as the given bean type, on behalf of the bean","+     * this context resolves for.","+     *","+     * <p>This is {@link #getBean(BeanDefinition, Argument)} with the registration kept: the bean is resolved within","+     * this context, so what is created for it sees this context's path, and a bean that has no scope of its own is a","+     * dependent of the bean this context resolves for and is destroyed with it. The registration is","+     * the one {@link BeanDefinitionRegistry#getBeanRegistration(BeanDefinition, Argument)} returns when the","+     * resolution starts no context of its own, with that ownership.</p>","+     *","+     * @param definition The bean definition","+     * @param beanType   The potentially parameterized bean type to resolve the definition as","+     * @param <T>        The bean type","+     * @return The bean registration","+     * @throws io.micronaut.context.exceptions.NoSuchBeanException if the definition is not a candidate for the bean","+     *                                                             type","+     * @since 5.3.0","+     */","+    <T> BeanRegistration<T> getBeanRegistration(BeanDefinition<? extends T> definition, Argument<T> beanType);","+","     /**","      * Obtains the bean registrations for the given type and qualifier.","      *"],"additions":20,"deletions":0,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/DefaultRuntimeBeanDefinition.java","lines":["@@ -399,6 +399,11 @@ public BeanContext getBeanContext() {","             return resolutionContext.getContext();","         }"," ","+        @Override","+        public <V> BeanRegistration<V> getBeanRegistration(BeanDefinition<? extends V> definition, Argument<V> type) {","+            return resolutionContext.getBeanRegistration(definition, type);","+        }","+","         @Override","         public <V> V getBean(Argument<V> type, @Nullable Qualifier<V> qualifier) {","             Objects.requireNonNull(type, MSG_BEAN_TYPE_CANNOT_BE_NULL);"],"additions":5,"deletions":0,"truncated":false},{"path":"inject/src/main/java/io/micronaut/context/RuntimeBeanDefinition.java","lines":["@@ -335,6 +335,2