th() - 1);","+        }","+        if (managementUrl.endsWith(\"/lets-encrypt\")) {","+            return managementUrl;","+        }","+        return managementUrl + \"/q/lets-encrypt\";","+    }","+","     private <T> T await(Future<T> future) {","         try {","             return future.toCompletionStage().toCompletableFuture().get(30, TimeUnit.SECONDS);"],"additions":20,"deletions":8,"truncated":false},{"path":"extensions/tls-registry/cli/src/main/java/io/quarkus/tls/cli/letsencrypt/LetsEncryptIssueCommand.java","lines":["@@ -29,9 +29,9 @@ public class LetsEncryptIssueCommand implements Callable<Integer> {","             \"--tls-configuration-name\" }, description = \"The name of the TLS configuration to be used, if not set, the default configuration is used\")","     String tlsConfigurationName;"," ","-    // TODO Check if /lets-encrypt is appended","     @CommandLine.Option(names = {","-            \"--management-url\" }, description = \"The URL of the management endpoint to use for the ACME challenge\", required = true)","+            \"--management-url\" }, description = \"The URL of the management endpoint to use for the ACME challenge. \"","+                    + \"With a custom root path, use the URL that ends with /lets-encrypt\", required = true)","     String managementUrl;"," ","     @CommandLine.Option(names = {"],"additions":2,"deletions":2,"truncated":false},{"path":"extensions/tls-registry/cli/src/main/java/io/quarkus/tls/cli/letsencrypt/LetsEncryptRenewCommand.java","lines":["@@ -27,7 +27,8 @@ public class LetsEncryptRenewCommand implements Callable<Integer> {","     String tlsConfigurationName;"," ","     @CommandLine.Option(names = {","-            \"--management-url\" }, description = \"The URL of the management endpoint to use for the ACME challenge\", required = true)","+            \"--management-url\" }, description = \"The URL of the management endpoint to use for the ACME challenge. \"","+                    + \"With a custom root path, use the URL that ends with /lets-encrypt\", required = true)","     String managementUrl;"," ","     @CommandLine.Option(names = {"],"additions":2,"deletions":1,"truncated":false},{"path":"extensions/tls-registry/cli/src/test/java/io/quarkus/tls/cli/letsencrypt/AcmeClientTest.java","lines":["@@ -0,0 +1,74 @@","+package io.quarkus.tls.cli.letsencrypt;","+","+import java.util.concurrent.atomic.AtomicReference;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.Assertions;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+","+import io.vertx.core.Vertx;","+import io.vertx.core.http.HttpServer;","+","+class AcmeClientTest {","+","+    private final AtomicReference<String> requestedPath = new AtomicReference<>();","+    private Vertx vertx;","+    private HttpServer server;","+","+    @BeforeEach","+    void startServer() throws Exception {","+        vertx = Vertx.vertx();","+        server = vertx.createHttpServer()","+                .requestHandler(req -> {","+                    requestedPath.set(req.path());","+                    req.response().setStatusCode(204).end();","+                })","+                .listen(0)","+                .toCompletionStage().toCompletableFuture().get();","+    }","+","+    @AfterEach","+    void stopServer() throws Exception {","+        vertx.close().toCompletionStage().toCompletableFuture().get();","+    }","+","+    @Test","+    void testDefaultRootPath() {","+        assertChallengePath(\"\", \"/q/lets-encrypt/challenge\");","+    }","+","+    @Test","+    void testRootWithTrailingSlash() {","+        assertChallengePath(\"/\", \"/q/lets-encrypt/challenge\");","+    }","+","+    @Test","+    void testCustomRootPath() {","+        assertChallengePath(\"/admin/lets-encrypt\", \"/admin/lets-encrypt/challenge\");","+    }","+","+    @Test","+    void testCustomRootPathWithTrailingSlash() {","+        assertChallengePath(\"/admin/lets-encrypt/\", \"/admin/lets-encrypt/challenge\");","+    }","+","+    @Test","+    void testCertsPath() {","+        try (AcmeClient client = newClient(\"/admin/lets-encrypt\")) {","+            client.certificateChainAndKeyAreReady();","+        }","+        Assertions.assertEquals(\"/admin/lets-encrypt/certs\", requestedPath.get());","+    }","+","+    private void assertChallengePath(String managementPath, String expectedPath) {","+        try (AcmeClient client = newClient(managementPath)) {","+            Assertions.assertTrue(client.checkReadiness());","+        }","+        Assertions.assertEquals(expectedPath, requestedPath.get());","+    }","+","+    private AcmeClient newClient(String managementPath) {","+        return new AcmeClient(\"http://localhost:\" + server.actualPort() + managementPath, null, null, null, false);","+    }","+}",""],"additions":74,"deletions":0,"truncated":false}],"additions":103,"deletions":11,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-02T17:25:11.856694+00:00"}