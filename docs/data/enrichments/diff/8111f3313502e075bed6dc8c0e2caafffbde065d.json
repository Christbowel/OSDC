{"id":"8111f3313502e075bed6dc8c0e2caafffbde065d","axis":"silent","repo":"facebook/lexical","sha":"8111f3313502e075bed6dc8c0e2caafffbde065d","parsed":{"files":[{"path":".changeset/lexical-large-block-append.md","lines":["@@ -0,0 +1,7 @@","+---","+'lexical': patch","+---","+","+[fix] Inserting into, splitting, or pressing Enter in a block with tens of thousands of children (past roughly 100,000 to 125,000 on V8's main thread, 65,536 on JavaScriptCore: a paragraph pasted from a text with that many line feeds) no longer throws `RangeError: Maximum call stack size exceeded`","+","+Verify: in a paragraph of more than 130,000 text nodes and line breaks, press Enter after its first character, insert a paragraph at its end with `$insertNodes`, and call `$splitNode` on it; each moves the children as it does in a small paragraph, with no error."],"additions":7,"deletions":0,"truncated":false},{"path":".changeset/lexical-y-large-container-spreads.md","lines":["@@ -0,0 +1,5 @@","+---","+'@lexical/y': patch","+---","+","+[chore] The binding no longer spreads a list that grows with the document into a call's arguments (the children of an inline element in a line it writes, the runs of text an edit spans), which a large enough document could make throw `RangeError: Maximum call stack size exceeded` (past roughly 100,000 to 125,000 arguments on V8's main thread, 65,536 on JavaScriptCore); a source test keeps such calls out of the package"],"additions":5,"deletions":0,"truncated":false},{"path":"AGENTS.md","lines":["@@ -364,6 +364,15 @@ Always access node properties/methods within read/update context. Nodes automati","     tests (jsdom/Node), but browser tests should clean up with","     `onTestFinished(() => editor.dispose())` instead — `editor.dispose()` is a plain method","     available on the result of `buildEditorFromExtensions`.","+- **Size tests** - Vitest, located in `packages/**/__tests__/size/**/*.test.ts`","+  (the `unit-size` project, part of `pnpm run test-unit` but not of the watch","+  script). They run in the `forks` pool, so each file runs on a child","+  process's main thread, whose argument limit (roughly 100,000 to 125,000 on","+  Node, depending on stack depth) is the one","+  production code runs under; a worker thread takes 4x that. Put a test here","+  when it needs a document past that limit (a list of content spread into a","+  call's arguments throws only there). Keep each file to one case so the","+  project runs them in parallel."," - **E2E tests** - Playwright, located in `packages/lexical-playground/__tests__/e2e/**/*.spec.{ts,mjs}`"," - E2E tests require the playground dev server running"," - Use `pnpm run debug-test-e2e-chromium` to debug E2E tests with browser UI"],"additions":9,"deletions":0,"truncated":false},{"path":"package.json","lines":["@@ -46,7 +46,7 @@","     \"collab\": \"cross-env HOST=localhost PORT=1234 pnpm exec y-websocket\",","     \"collab:y\": \"cross-env HOST=localhost PORT=1235 node packages/lexical-playground/scripts/collab-y-server.mjs\",","     \"vitest\": \"vitest\",","-    \"test-unit\": \"vitest --project unit --project scripts-unit --no-watch\",","+    \"test-unit\": \"vitest --project unit --project unit-size --project scripts-unit --no-watch\",","     \"test-unit-watch\": \"vitest --project unit --project scripts-unit\",","     \"test-browser\": \"vitest --project browser --no-watch\",","     \"test-browser-watch\": \"vitest --project browser\","],"additions":1,"deletions":1,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/LargeContainer.InlineChildren.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeShape, SHAPES} from '../utils/sizeShapes';","+","+describeShape(SHAPES[3]);"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/LargeContainer.LinkChildren.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeShape, SHAPES} from '../utils/sizeShapes';","+","+describeShape(SHAPES[4]);"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/LargeContainer.LongLine.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeShape, SHAPES} from '../utils/sizeShapes';","+","+describeShape(SHAPES[0]);"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/LargeContainer.ManyLines.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeShape, SHAPES} from '../utils/sizeShapes';","+","+describeShape(SHAPES[2]);"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/LargeContainer.ShortLines.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeShape, SHAPES} from '../utils/sizeShapes';","+","+describeShape(SHAPES[1]);"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/MigrateLargeContainer.LongLine.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeMigration, UNITS} from '../utils/sizeShapes';","+","+describeMigration(1, 'y'.repeat(UNITS));"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/size/MigrateLargeContainer.ShortLines.test.ts","lines":["@@ -0,0 +1,13 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// The size gate at production's argument limit (see utils/sizeShapes.ts).","+","+import {describeMigration, UNITS} from '../utils/sizeShapes';","+","+describeMigration(Math.ceil(UNITS / 3), 'ab');"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/unit/SpreadArguments.test.ts","lines":["@@ -0,0 +1,167 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// @vitest-environment node","+","+// The number of arguments a call can take is bounded by the stack it runs","+// on (a RangeError past 131,072 on Node's main thread), and content is as","+// long as a user makes it: a list of content spread into a call's arguments","+// (`array.push(...items)`, `parent.append(...nodes)`, `Math.max(...values)`,","+// `fn.apply(null, values)`) throws on a large enough document (#9880). This","+// test reads every source file of the package and allows such a call only","+// where it is listed below with the reason its list is bounded (a chunk of","+// at most ARGUMENTS_CHUNK items, an argument tuple).","+// Anything else uses `pushAll`, `spliceAll` or `$appendAll`","+// (internal/Arrays.ts), or a loop.","+","+import * as fs from 'node:fs';","+import * as path from 'node:path';","+import ts from 'typescript';","+import {expect, test} from 'vitest';","+","+const SRC = path.resolve(__dirname, '../..');","+","+/** Spread arguments that are bounded, by file and call text, with why. */","+const ALLOWED: Record<string, Record<string, string>> = {","+  'internal/Arrays.ts': {","+    'array.splice(start, deleteCount, ...items)':","+      'spliceAll: only when items.length <= ARGUMENTS_CHUNK',","+    'parent.append(...nodes.slice(i, i + ARGUMENTS_CHUNK))':","+      '$appendAll: a chunk of at most ARGUMENTS_CHUNK nodes',","+  },","+  'internal/Binding.ts': {","+    'String.fromCharCode.apply( null, Array.from(bytes.subarray(i, i + 4096)), )':","+      'byteString: a chunk of at most 4,096 bytes',","+    'head.splitText( ...offsets.slice(Math.max(0, end - ARGUMENTS_CHUNK), end), )':","+      'a chunk of at most ARGUMENTS_CHUNK offsets',","+    'super.emit(...args)': \"an event's argument tuple (forwarded)\",","+    'um.emit(...args)': \"an event's argument tuple (held, then forwarded)\",","+  },","+  'internal/Read.ts': {","+    'this.$readInline(...args)': \"$readInline's own parameters (forwarded)\",","+  },","+};","+","+function sourceFiles(dir: string, out: string[] = []): string[] {","+  for (const entry of fs.readdirSync(dir, {withFileTypes: true})) {","+    const full = path.join(dir, entry.name);","+    if (entry.isDirectory()) {","+      if (entry.name !== '__tests__') {","+        sourceFiles(full, out);","+      }","+    } else if (/\\.tsx?$/.test(entry.name) && !entry.name.endsWith('.d.ts')) {","+      out.push(full);","+    }","+  }","+  return out;","+}","+","+const oneLine = (text: string) => text.replace(/\\s+/g, ' ').trim();","+","+type Found = {file: string; line: number; call: string};","+","+/** The calls in `source` that pass a list as their arguments. */","+function spreadCallsIn(source: ts.SourceFile, file: string): Found[] {","+  const found: Found[] = [];","+  const visit = (node: ts.Node) => {","+    if (","+      (ts.isCallExpression(node) || ts.isNewExpression(node)) &&","+      node.arguments !== undefined","+    ) {","+      const spread = node.arguments.some(arg => ts.isSpreadElement(arg));","+      // fn.apply(thisArg, list), fn['apply'](...), Reflect.apply(fn, thisArg,","+      // list), Reflect.construct(C, list): the list is the arguments. (An","+      // alias of Function.prototype.apply or of Reflect is not recognized.)","+      const callee = node.expression;","+      const name = ts.isPropertyAccessExpression(callee)","+        ? callee.name.text","+        : ts.isElementAccessExpression(callee) &&","+            ts.isStringLiteralLike(callee.argumentExpression)","+          ? callee.argumentExpression.text","+          : null;","+      const onReflect =","+        ts.isPropertyAccessExpression(callee) &&","+        ts.isIdentifier(callee.expression) &&","+        callee.expression.text === 'Reflect';","+      const apply =","+        ts.isCallExpression(node) &&","+        ((name === 'apply' && (node.arguments.length >= 2 || onReflect)) ||","+          (name === 'construct' && onReflect));","+      if (spread || apply) {","+        found.push({","+          call: oneLine(node.getText(source)),","+          file,","+          line:","+            source.getLineAndCharacterOfPosition(node.getStart(source)).line +","+            1,","+        });","+      }","+    }","+    ts.forEachChild(node, visit);","+  };","+  visit(source);","+  return found;","+}","+","+const parse = (file: string, text: string) =>","+  ts.createSourceFile(file, text, ts.ScriptTarget.Latest, true);","+","+/** Every such call in the package's sources. */","+function spreadCalls(): Found[] {","+  return sourceFiles(SRC).flatMap(full =>","+    spreadCallsIn(","+      parse(full, fs.readFileSync(full, 'utf8')),","+      path.relative(SRC, full).split(path.sep).join('/'),","+    ),","+  );","+}","+","+test('no list of content is spread into a call', () => {","+  const calls = spreadCalls();","+  const unbounded = calls","+    .filter(({file, call}) => ALLOWED[file]?.[call] === undefined)","+    .map(({file, line, call}) => `${file}:${line}: ${call}`);","+  expect(unbounded).toEqual([]);","+  // Every allowance still names a call in the source.","+  const seen = new Set(calls.map(({file, call}) => `${file}\\0${call}`));","+  const stale = Object.entries(ALLOWED).flatMap(([file, entries]) =>","+    Object.keys(entries)","+      .filter(call => !seen.has(`${file}\\0${call}`))","+      .map(call => `${file}: ${call}`),","+  );","+  expect(stale).toEqual([]);","+});","+","+test('the check finds every call given a list as its arguments', () => {","+  const probe = parse(","+    'probe.ts',","+    [","+      'out.push(...items);',","+      'Math.max(...values);',","+      'new Set(...lists);',","+      'String.fromCharCode.apply(null, codes);',","+      \"fn['apply'](null, codes);\",","+      'Reflect.apply(fn, null, codes);',","+      'Reflect.construct(Array, items);',","+      'parent.append(...nodes.slice(i, i + ARGUMENTS_CHUNK));',","+      // A method named apply that takes one value is not a list call.","+      'this.apply(step);',","+    ].join('\\n'),","+  );","+  expect(spreadCallsIn(probe, 'probe.ts').map(f => f.call)).toEqual([","+    'out.push(...items)',","+    'Math.max(...values)',","+    'new Set(...lists)',","+    'String.fromCharCode.apply(null, codes)',","+    \"fn['apply'](null, codes)\",","+    'Reflect.apply(fn, null, codes)',","+    'Reflect.construct(Array, items)',","+    // Chunks too: each is listed in ALLOWED with its bound.","+    'parent.append(...nodes.slice(i, i + ARGUMENTS_CHUNK))',","+  ]);","+});"],"additions":167,"deletions":0,"truncated":false},{"path":"packages/lexical-y/src/__tests__/utils/sizeShapes.ts","lines":["@@ -0,0 +1,336 @@","+/**","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ *","+ */","+","+// Documents with more content in one container than a call can take as","+// arguments, through every path that reads or writes a whole container:","+// the binding's first write (writer), a fresh binding's load (reader), an","+// edit both ways, the headless read, seed and edit, and a migration from","+// layout 1. The `unit-size` project runs this file on a child process's main","+// thread, whose argument limit (131,072 on Node) is the one production code","+// runs under; the documents are sized past the limit of the runtime they run","+// in, and past 130,000 units in any case. A list of content spread into a","+// call's arguments throws `RangeError: Maximum call stack size exceeded`","+// here (#9880 was one in the migration runner).","+","+//","+// Each file under __tests__/size/ registers one shape or one migration","+// (describeShape, describeMigration), so the project runs them in parallel.","+","+import {$createLinkNode} from '@lexical/link';","+import * as Y from '@y/y';","+import {","+  $createLineBreakNode,","+  $createParagraphNode,","+  $createTextNode,","+  $getRoot,","+  $isElementNode,","+  $isLineBreakNode,","+  createEditor,","+  type ElementNode,","+  type LexicalNode,","+} from 'lexical';","+import {describe, expect, test} from 'vitest';","+","+import {","+  createYWriter,","+  editYState,","+  readYState,","+  seedYState,","+} from '../../headless';","+import {migrateYState} from '../../migrate';","+import step1to2 from '../../migrate/1to2';","+import step2to3 from '../../migrate/2to3';","+import {freshReader, NODES, setup} from './harness';","+","+/**","+ * The smallest power of two of arguments a spread into a call throws on in","+ * this runtime (Node's main thread: 131,072; a worker thread: 524,288).","+ */","+function argumentLimit(): number {","+  for (let n = 1 << 16; n <= 1 << 24; n *= 2) {","+    const items = new Array<string>(n).fill('x');","+    try {","+      [].push(...(items as never[]));","+    } catch {","+      return n;","+    }","+  }","+  throw new Error('no argument limit up to 2^24');","+}","+","+export const LIMIT = argumentLimit();","+/** Units in the one container: past the limit, and past 130,000. */","+export const UNITS = Math.max(130_000, LIMIT) + 4_096;","+","+const CONFIG = {nodes: NODES, onWarn: () => {}, schemaVersion: 1};","+const WRITER = createYWriter('lexical-y-size-test');","+","+/** A document shape: how to build it, and how many units its line holds. */","+export type Shape = {","+  name: string;","+  $build: () => void;","+};","+","+export const SHAPES: Shape[] = [","+  {","+    // One string item: the line's text is one unit per character.","+    $build: () => {","+      $getRoot().append(","+        $createParagraphNode().append($createTextNode('y'.repeat(UNITS))),","+      );","+    },","+    name: `one line of ${UNITS} characters`,","+  },","+  {","+    // The root's lines: each line's text and its marker.","+    $build: () => {","+      const lines = Math.ceil(UNITS / 3);","+      const paragraphs: LexicalNode[] = [];","+      for (let i = 0; i < lines; i++) {","+        paragraphs.push($createParagraphNode().append($createTextNode('ab')));","+      }","+      appendAll($getRoot(), paragraphs);","+    },","+    name: `${Math.ceil(UNITS / 3)} lines of 2 characters`,","+  },","+  {","+    // More lines than a call takes: one child of the root each.","+    $build: () => {","+      const paragraphs: LexicalNode[] = [];","+      for (let i = 0; i < UNITS; i++) {","+        paragraphs.push($createParagraphNode().append($createTextNode('c')));","+      }","+      appendAll($getRoot(), paragraphs);","+    },","+    name: `${UNITS} lines of 1 character`,","+  },","+  {","+    // One line of many inline nodes: a text and a line break each.","+    $build: () => {","+      const children: LexicalNode[] = [];","+      for (let i = 0; i < UNITS / 2; i++) {","+        children.push($createTextNode('d'), $createLineBreakNode());","+      }","+      $getRoot().append(appendAll($createParagraphNode(), children));","+    },","+    name: `one line of ${UNITS / 2} texts and line breaks`,","+  },","+  {","+    // One line holding a link of many inline nodes.","+    $build: () => {","+      const children: LexicalNode[] = [];","+      for (let i = 0; i < UNITS / 2; i++) {","+        children.push($createTextNode('e'), $createLineBreakNode());","+      }","+      $getRoot().append(","+        $createParagraphNode().append(","+          appendAll($createLinkNode('https://example.com'), children),","+        ),","+      );","+    },","+    name: `one line holding a link of ${UNITS / 2} texts and line breaks`,","+  },","+];","+","+/** `parent.append(...nodes)` for any number of nodes (a test's own build). */","+function appendAll(parent: ElementNode, nodes: LexicalNode[]): ElementNode {","+  for (let i = 0; i < nodes.length; i += 4096) {","+    parent.append(...nodes.slice(i, i + 4096));","+  }","+  return parent;","+}","+","+/** The root's block at `index` (from the end when negative). */","+function $block(index: number): ElementNode {","+  const root = $getRoot();","+  const block = root.getChildAtIndex(","+    index < 0 ? root.getChildrenSize() + index : index,","+  );","+  if (!$isElementNode(block)) {","+    throw new Error(`no block at ${index}`);","+  }","+  return block;","+}","+","+/** A compact description of the root: block count, text and line breaks. */","+function $summary(): {blocks: number; text: number; breaks: number} {","+  let text = 0;","+  let breaks = 0;","+  const stack: LexicalNode[] = [$getRoot()];","+  while (stack.length > 0) {","+    const node = stack.pop()!;","+    if ($isElementNode(node)) {","+      for (const child of node.getChildren()) {","+        stack.push(child);","+      }","+    } else if ($isLineBreakNode(node)) {","+      breaks++;","+    } else {","+      text += node.getTextContentSize();","+    }","+  }","+  return {blocks: $getRoot().getChildrenSize(), breaks, text};","+}","+","+/** The summary of `shape` built in a plain editor. */","+function expectedOf(shape: Shape): ReturnType<typeof $summary> {","+  const editor = createEditor({","+    namespace: 'size',","+    nodes: NODES,","+    onError: error => {","+      throw error;","+    },","+  });","+  editor.update(","+    () => {","+      $getRoot().clear();","+      shape.$build();","+    },","+    {discrete: true},","+  );","+  return editor.read($summary);","+}","+","+/** Registers a shape's tests (each file under size/ registers one). */","+export function describeShape(shape: Shape): void {","+  describe('the runtime this file runs in', () => {","+    test('takes no more arguments than a main thread', () => {","+      expect(LIMIT).toBeLessThanOrEqual(131_072);","+      expect(UNITS).toBeGreaterThan(130_000);","+    });","+  });","+  describe(shape.name, () => {","+    for (const gc of [false, true]) {","+      test(`binding write, fresh load, edits both ways, headless read/seed/edit (gc ${gc ? 'on' : 'off'})`, async () => {","+        const {a, sync} = await setup(shape.$build, {gc, ids: [1]});","+        expect(a.errors).toEqual([]);","+        const expected = a.read($summary);","+        const root = a.doc.get('lexical-y');","+        expect(root.length).toBeGreaterThan(LIMIT);","+","+        // A fresh binding loads it.","+        const b = await freshReader(a);","+        expect(b.errors).toEqual([]);","+        expect(b.read($summary)).toEqual(expected);","+","+        // An edit in the loaded editor, deep in the container, reaches A.","+        b.update(() => {","+          const last = $block(-1);","+          last.append($createTextNode('!'));","+          $block(0).append($createTextNode('?'));","+        });","+        Y.applyUpdate(","+          a.doc,","+          Y.encodeStateAsUpdate(b.doc, Y.encodeStateVector(a.doc)),","+        );","+        await sync();","+        const edited = {...expected, text: expected.text + 2};","+        expect(a.read($summary)).toEqual(edited);","+        expect(b.read($summary)).toEqual(edited);","+","+        // And one from A reaches B.","+        a.update(() => {","+          $getRoot().append(","+            $createParagraphNode().append($createTextNode('end')),","+          );","+        });","+        Y.applyUpdate(","+          b.doc,","+          Y.encodeStateAsUpdate(a.doc, Y.encodeStateVector(b.doc)),","+        );","+        await sync();","+        const appended = {","+          ...edited,","+          blocks: edited.blocks + 1,","+          text: edited.text + 3,","+        };","+        expect(b.read($summary)).toEqual(appended);","+        expect(a.errors).toEqual([]);","+        expect(b.errors).toEqual([]);","+","+        // Saved, it reads headless the same, and a headless edit writes.","+        const saved = Y.encodeStateAsUpdate(a.doc);","+        expect(readYState(saved, CONFIG, $summary)).toEqual(appended);","+        const result = editYState(","+          saved,","+          CONFIG,","+          () => {","+            $block(0).append($createTextNode('#'));","+          },","+          {writer: WRITER},","+        );","+        expect(result.update).not.toBeNull();","+        const after = Y.mergeUpdates([","+          saved as Uint8Array<ArrayBuffer>,","+          result.update as Uint8Array<ArrayBuffer>,","+        ]);","+        expect(readYState(after, CONFIG, $summary)).toEqual({","+          ...appended,","+          text: appended.text + 1,","+        });","+      }, 600_000);","+    }","+","+    test('headless seed reads back the same', () => {","+      const seeded = seedYState(CONFIG, shape.$build);","+      expect(readYState(seeded, CONFIG, $summary)).toEqual(expectedOf(shape));","+    }, 600_000);","+  });","+}","+","+/**","+ * A layout 1 document of `lines` top-level paragraphs, each holding `text`","+ * (see MigrateLargeContainer.test.ts).","+ */","+function layout1Document(lines: number, text: string): Uint8Array {","+  const doc = new Y.Doc({gc: false});","+  doc.cleanupFormatting = false;","+  doc.clientID = 4243;","+  const root = doc.get('lexical-y');","+  doc.transact(() => {","+    root.setAttr('lexical-y:1', true);","+    root.setAttr('lexical-y-schema:1', true);","+    root.setAttr('k:paragraph', 'line');","+    let index = 0;","+    for (let i = 0; i < lines; i++) {","+      root.insert(index, text);","+      index += text.length;","+      root.insert(index, [new Y.Node('¶')]);","+      index += 1;","+    }","+  });","+  return Y.encodeStateAsUpdate(doc);","+}","+","+/** Registers a migration's tests: `lines` lines of `text`, from layout 1. */","+export function describeMigration(lines: number, text: string): void {","+  const name =","+    lines === 1","+      ? `one line of ${text.length} characters`","+      : `${lines} lines of ${text.length} characters`;","+  describe('a layout 1 document past the limit migrates on the main thread', () => {","+    test('the runtime takes no more arguments than a main thread', () => {","+      expect(LIMIT).toBeLessThanOrEqual(131_072);","+      expect(UNITS).toBeGreaterThan(130_000);","+    });","+    for (const gc of [false, true]) {","+      test(`${name} (gc ${gc ? 'on' : 'off'})`, () => {","+        const input = layout1Document(lines, text);","+        const result = migrateYState(input, [step1to2, step2to3], {gc});","+        expect(result.receipt.changed).toBe(true);","+        const re