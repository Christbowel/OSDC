         return;","             }"],"additions":2,"deletions":0,"truncated":false},{"path":"test/org/apache/catalina/valves/TestRequestFilterValve.java","lines":["@@ -17,22 +17,35 @@"," package org.apache.catalina.valves;"," "," import java.io.IOException;","+import java.util.Collections;","+import java.util.List;","+import java.util.Map;","+import java.util.concurrent.atomic.AtomicInteger;"," "," import jakarta.servlet.ServletException;","+import jakarta.servlet.http.HttpServlet;","+import jakarta.servlet.http.HttpServletRequest;","+import jakarta.servlet.http.HttpServletResponse;"," "," import org.junit.Assert;"," import org.junit.Test;"," "," import org.apache.catalina.Context;","+import org.apache.catalina.authenticator.BasicAuthenticator;"," import org.apache.catalina.connector.Connector;"," import org.apache.catalina.connector.Request;"," import org.apache.catalina.connector.Response;"," import org.apache.catalina.core.StandardContext;","+import org.apache.catalina.realm.NullRealm;","+import org.apache.catalina.startup.Tomcat;","+import org.apache.catalina.startup.TomcatBaseTest;","+import org.apache.tomcat.util.buf.ByteChunk;","+import org.apache.tomcat.util.descriptor.web.LoginConfig;"," "," /**","  * {@link RequestFilterValve} Tests","  */","-public class TestRequestFilterValve {","+public class TestRequestFilterValve extends TomcatBaseTest {"," ","     private static final int OK = 200;","     private static final int FORBIDDEN = 403;","@@ -366,4 +379,95 @@ public void testRemoteCIDR6Valve() {","         standardTests(CIDR6_ALLOW_PROP, CIDR6_DENY_PROP, CIDR6_ONLY_ALLOW, CIDR6_ONLY_DENY, CIDR6_ALLOW_AND_DENY,","                 CIDR6_NO_ALLOW_NO_DENY, true, \"CIDR\");","     }","+","+","+    // Matches the loopback address however the client connects","+    private static final String DENY_LOOPBACK = \"127.0.0.0/8,::1/128\";","+    private static final String DENY_OTHER = \"192.0.2.0/24\";","+","+","+    @Test","+    public void testDeniedNoAuthorizationHeader() throws Exception {","+        CountingServlet servlet = doTest(DENY_LOOPBACK, null);","+        Assert.assertEquals(\"Denied client must have been challenged\", 401, getLastStatus());","+        Assert.assertEquals(\"Denied client must not reach the resource\", 0, servlet.getCount());","+    }","+","+","+    @Test","+    public void testDeniedNonBasicAuthorizationHeader() throws Exception {","+        CountingServlet servlet = doTest(DENY_LOOPBACK, \"Bearer abc\");","+        Assert.assertEquals(\"Denied client must have been challenged\", 401, getLastStatus());","+        Assert.assertEquals(\"Denied client must not reach the resource\", 0, servlet.getCount());","+    }","+","+","+    @Test","+    public void testAllowed() throws Exception {","+        CountingServlet servlet = doTest(DENY_OTHER, null);","+        Assert.assertEquals(200, getLastStatus());","+        Assert.assertEquals(1, servlet.getCount());","+    }","+","+","+    private int lastStatus;","+","+    private int getLastStatus() {","+        return lastStatus;","+    }","+","+","+    private CountingServlet doTest(String deny, String authorizationHeader) throws Exception {","+        Tomcat tomcat = getTomcatInstance();","+","+        // No file system docBase required","+        Context ctx = getProgrammaticRootContext();","+        ctx.setPreemptiveAuthentication(true);","+        ctx.setRealm(new NullRealm());","+","+        LoginConfig loginConfig = new LoginConfig();","+        loginConfig.setAuthMethod(\"BASIC\");","+        ctx.setLoginConfig(loginConfig);","+","+        RemoteCIDRValve valve = new RemoteCIDRValve();","+        valve.setDeny(deny);","+        valve.setInvalidAuthenticationWhenDeny(true);","+        ctx.getPipeline().addValve(valve);","+        ctx.getPipeline().addValve(new BasicAuthenticator());","+","+        // Deliberately no security constraint","+        CountingServlet servlet = new CountingServlet();","+        Tomcat.addServlet(ctx, \"counting\", servlet);","+        ctx.addServletMapping(\"/\", \"counting\");","+","+        tomcat.start();","+","+        Map<String,List<String>> reqHead = null;","+        if (authorizationHeader != null) {","+            reqHead = Collections.singletonMap(\"Authorization\", Collections.singletonList(authorizationHeader));","+        }","+        ByteChunk bc = new ByteChunk();","+        lastStatus = getUrl(\"http://localhost:\" + getPort() + \"/\", bc, reqHead, null);","+","+        return servlet;","+    }","+","+","+    private static final class CountingServlet extends HttpServlet {","+","+        private static final long serialVersionUID = 1L;","+","+        private final AtomicInteger count = new AtomicInteger();","+","+        @Override","+        protected void doGet(HttpServletRequest req, HttpServletResponse resp) throws IOException {","+            count.incrementAndGet();","+            resp.setContentType(\"text/plain\");","+            resp.getWriter().print(\"OK\");","+        }","+","+        int getCount() {","+            return count.get();","+        }","+    }"," }"],"additions":105,"deletions":1,"truncated":false},{"path":"webapps/docs/changelog.xml","lines":["@@ -241,6 +241,13 @@","         Expand the user name normalisation options available in the","         <code>LockOutRealm</code>. (markt)","       </fix>","+      <fix>","+        Harden the <code>RequestFilterValve</code>. If","+        <code>invalidAuthenticationWhenDeny</code> is configured and allows a","+        request through to be authenticated but the authenticator that processes","+        the request does not support preemptive authentication, then the request","+        is denied. (markt)","+      </fix>","     </changelog>","   </subsection>","   <subsection name=\"Coyote\">"],"additions":7,"deletions":0,"truncated":false},{"path":"webapps/docs/config/valve.xml","lines":["@@ -707,13 +707,20 @@"," ","       <attribute name=\"invalidAuthenticationWhenDeny\" required=\"false\">","         <p>When a request should be denied, do not deny but instead","-        set an invalid <code>authentication</code> header. This only works","-        if the context has the attribute <code>preemptiveAuthentication=\"true\"</code>","-        set. An already existing <code>authentication</code> header will not be","-        overwritten. In effect this will trigger authentication instead of deny","-        even if the application does not have a security constraint configured.</p>","-        <p>This can be combined with <code>addConnectorPort</code> to trigger authentication","-        depending on the client and the connector that is used to access an application.</p>","+        set an invalid <code>authorization</code> header that triggers","+        pre-emptive authentication. An already existing","+        <code>authorization</code> header will not be overwritten. This feature","+        triggers authentication instead of deny even if the application does not","+        have a security constraint configured.</p>","+        <p>This feature requires that the context has the attribute","+        <code>preemptiveAuthentication=\"true\"</code> set and is configured with","+        an authentication mechanism (BASIC, DIGEST, SPNEGO or CLIENT-CERT) that","+        supports pre-emptive authentication. If this is not the case, the Tomcat","+        provided authenticators will deny the request. Custom authenticators may","+        allow the request.</p>","+        <p>This feature can be combined with <code>addConnectorPort</code> to","+        trigger authentication depending on the client and the connector that is","+        used to access an application.</p>","       </attribute>"," ","     </attributes>",""],"additions":14,"deletions":7,"truncated":false}],"additions":170,"deletions":12,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-24T20:29:56.906976+00:00"}