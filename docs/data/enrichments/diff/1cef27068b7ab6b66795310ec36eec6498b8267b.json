{"id":"1cef27068b7ab6b66795310ec36eec6498b8267b","axis":"silent","repo":"salvo-rs/salvo","sha":"1cef27068b7ab6b66795310ec36eec6498b8267b","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -8,6 +8,15 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)."," "," ### Fixed"," ","+- Omit query strings from OpenTelemetry spans by default; opt in to selected","+  non-sensitive fields with `Tracing::query_fields`.","+- Run middleware bcrypt CSRF operations on bounded blocking workers while","+  retaining capacity until cancelled work actually finishes.","+- Serve only the committed TUS upload prefix and retain read locks while","+  streamed downloads use the file.","+- Defer small-file preloading until conditional and range handling completes,","+  and bound automatic directory listings by scanned entries and output bytes.","+"," - Fix OpenAPI macros with renamed `salvo` dependencies, `craft(endpoint)` with","   direct `salvo_core`/`salvo-oapi` dependencies, extractor error handling without","   a `Writer` import, endpoint functions and parameters using raw identifiers,"],"additions":9,"deletions":0,"truncated":false},{"path":"CONTRIBUTING.md","lines":["@@ -138,6 +138,23 @@ chained setters that use the `with_` prefix."," - Prefer direct, grammatical wording that explains what is missing or why the operation failed."," - Do not mechanically rewrite standardized protocol text such as HTTP reason phrases, RFC terms, or other externally defined wire-format strings."," ","+### Timeout And Filesystem Boundaries","+","+When changing timeout code or documentation, identify the phase being bounded: handler","+processing, connection establishment, request headers, request-body gaps, response-body","+production, transport inactivity, or total stream lifetime. Test stalled headers and stalled","+body frames separately. Include a legitimate long-stream case such as SSE, and distinguish","+body-production observations from socket delivery. A timeout around a handler future does","+not continue after it returns a streaming response.","+","+For static-file containment changes, distinguish fixed symlink/junction escapes from","+concurrent filesystem replacement. Canonical-path checks reject a fixed outside-root","+target but do not make a later path-based open atomic. A race requires an actor able to","+rename relevant directories or create/switch links; ordinary file upload access alone","+does not establish that capability. Keep served roots and their ancestors outside untrusted","+rename/link control, and document that assumption. Tests for a pre-existing escape link","+must not be presented as proof against concurrent replacement.","+"," ## Pull Requests"," "," - Explain the motivation, scope, and user-visible impact."],"additions":17,"deletions":0,"truncated":false},{"path":"crates/core/src/fs/named_file.rs","lines":["@@ -9,7 +9,6 @@ use std::os::unix::fs::MetadataExt;"," use std::path::{Path, PathBuf};"," use std::time::{Duration, SystemTime, UNIX_EPOCH};"," ","-use bytes::Bytes;"," use enumflags2::{BitFlags, bitflags};"," use headers::*;"," use mime::Mime;","@@ -140,13 +139,14 @@ pub struct NamedFile {","     file: File,","     modified: Option<SystemTime>,","     buffer_size: u64,","+    #[cfg(unix)]","     metadata: Metadata,","     flags: BitFlags<Flag>,","     content_type: mime::Mime,","     content_disposition: Option<HeaderValue>,","     content_encoding: Option<HeaderValue>,","-    /// Pre-read content for small files, avoiding ChunkedFile + spawn_blocking overhead.","-    preread: Option<Bytes>,","+    preload_threshold: u64,","+    length: u64,"," }"," "," /// Builder for constructing [`NamedFile`] instances with custom configuration.","@@ -184,6 +184,7 @@ pub struct NamedFileBuilder {","     content_encoding: Option<String>,","     buffer_size: Option<u64>,","     preload_threshold: Option<u64>,","+    max_length: Option<u64>,","     flags: BitFlags<Flag>,"," }"," impl NamedFileBuilder {","@@ -256,9 +257,9 @@ impl NamedFileBuilder {"," ","     /// Sets small-file preload threshold and returns `Self`.","     ///","-    /// Files whose size is less than or equal to this threshold are read during build and sent from","-    /// memory. Larger files are streamed in chunks using [`Self::buffer_size`]. Set this to `0` to","-    /// disable preloading for non-empty files.","+    /// Full responses whose size is less than or equal to this threshold are read only after","+    /// conditional and range checks, then sent from memory. Larger files are streamed using","+    /// [`Self::buffer_size`]. Set this to `0` to disable preloading for non-empty files.","     #[inline]","     #[must_use]","     pub fn preload_threshold(mut self, threshold: u64) -> Self {","@@ -266,6 +267,18 @@ impl NamedFileBuilder {","         self","     }"," ","+    /// Limits the served representation to at most this many bytes from the file start.","+    ///","+    /// The length is captured at build time as the smaller of this limit and the physical","+    /// file length. Content detection, validators, byte ranges and response bodies all use","+    /// that representation. Callers must prevent concurrent modification of those bytes.","+    #[inline]","+    #[must_use]","+    pub fn max_length(mut self, length: u64) -> Self {","+        self.max_length = Some(length);","+        self","+    }","+","     /// Specifies whether to use ETag or not.","     ///","     /// Default is true.","@@ -329,6 +342,7 @@ impl NamedFileBuilder {","             content_encoding,","             buffer_size,","             preload_threshold,","+            max_length,","             disposition_type,","             attached_name,","             disposition_name,","@@ -369,39 +383,23 @@ impl NamedFileBuilder {"," ","         let needs_detection_sample = needs_charset || needs_detect;"," ","-        // Single spawn_blocking: open + metadata + optional preread/detection sample.","-        // This replaces 3-7 separate spawn_blocking calls with just 1.","+        // Open and inspect only. Defer body reads until conditional/range checks finish.","         struct FileInfo {","             file: std::fs::File,","             metadata: Metadata,","-            preread: Option<Vec<u8>>,","+            length: u64,","             detection_sample: Option<Vec<u8>>,","         }","         let blocking_path = path.clone();","         let info = tokio::task::spawn_blocking(move || -> std::io::Result<FileInfo> {","             let mut file = std::fs::File::open(&blocking_path)?;","             let metadata = file.metadata()?;","-            let file_size = metadata.len();","-","-            // For small files (size <= preload_threshold), read the entire content now.","-            // This avoids ChunkedFile's spawn_blocking + into_std overhead later.","-            let preread = if file_size <= preload_threshold {","-                let mut buf = vec![0u8; file_size as usize];","-                file.read_exact(&mut buf)?;","-                Some(buf)","-            } else {","-                None","-            };","-","+            let length = metadata.len().min(max_length.unwrap_or(u64::MAX));","             let detection_sample = if needs_detection_sample {","-                if let Some(preread) = &preread {","-                    Some(preread[..cmp::min(1024, preread.len())].to_vec())","-                } else {","-                    let mut sample = vec![0u8; cmp::min(1024, file_size) as usize];","-                    file.read_exact(&mut sample)?;","-                    file.seek(SeekFrom::Start(0))?;","-                    Some(sample)","-                }","+                let mut sample = vec![0u8; cmp::min(1024, length) as usize];","+                file.read_exact(&mut sample)?;","+                file.seek(SeekFrom::Start(0))?;","+                Some(sample)","             } else {","                 None","             };","@@ -409,7 +407,7 @@ impl NamedFileBuilder {","             Ok(FileInfo {","                 file,","                 metadata,","-                preread,","+                length,","                 detection_sample,","             })","         })","@@ -419,7 +417,7 @@ impl NamedFileBuilder {"," ","         let file = File::from_std(info.file);"," ","-        // Resolve content type, using preread bytes for charset detection if needed.","+        // Resolve content type using the bounded detection sample if needed.","         let content_type = if let Some(mut mime) = inferred_mime {","             if needs_charset {","                 let sample = info.detection_sample.as_deref().unwrap_or(&[]);","@@ -433,8 +431,6 @@ impl NamedFileBuilder {","             mime::APPLICATION_OCTET_STREAM","         };"," ","-        let preread = info.preread.map(Bytes::from);","-","         let content_encoding = match content_encoding {","             Some(content_encoding) => Some(","                 content_encoding","@@ -460,11 +456,13 @@ impl NamedFileBuilder {","             content_type,","             content_disposition,","             modified: info.metadata.modified().ok(),","+            #[cfg(unix)]","             metadata: info.metadata,","             content_encoding,","             buffer_size: buf_size,","             flags,","-            preread,","+            preload_threshold,","+            length: info.length,","         })","     }"," }","@@ -615,6 +613,7 @@ impl NamedFile {","             content_encoding: None,","             buffer_size: None,","             preload_threshold: None,","+            max_length: None,","             flags: BitFlags::default(),","         }","     }","@@ -742,7 +741,7 @@ impl NamedFile {","             let etag_str = format!(","                 \"\\\"{:x}-{:x}-{:x}-{:x}\\\"\",","                 ino,","-                self.metadata.len(),","+                self.length,","                 dur.as_secs(),","                 dur.subsec_nanos()","             );","@@ -92