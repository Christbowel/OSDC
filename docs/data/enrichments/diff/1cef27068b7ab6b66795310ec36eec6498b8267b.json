    res.headers_mut().typed_insert(ContentLength(length));"," ","-            // Fast path: send preread bytes directly — zero spawn_blocking calls","-            if let Some(preread) = self.preread.take() {","-                res.replace_body(ResBody::Once(preread));","+            if length <= self.preload_threshold {","+                let mut file = self.file.into_std().await;","+                let read = tokio::task::spawn_blocking(move || -> std::io::Result<Vec<u8>> {","+                    let size = usize::try_from(length).map_err(std::io::Error::other)?;","+                    let mut bytes = vec![0; size];","+                    file.seek(SeekFrom::Start(0))?;","+                    file.read_exact(&mut bytes)?;","+                    Ok(bytes)","+                })","+                .await;","+                match read {","+                    Ok(Ok(bytes)) => {","+                        res.replace_body(ResBody::Once(bytes.into()));","+                    }","+                    error => {","+                        tracing::error!(error = ?error, \"read file body failed\");","+                        res.headers_mut()","+                            .remove(crate::http::header::CONTENT_LENGTH);","+                        res.headers_mut().remove(CONTENT_ENCODING);","+                        res.render(StatusError::internal_server_error());","+                    }","+                }","             } else {","                 let reader = ChunkedFile {","                     offset,","@@ -1589,7 +1600,7 @@ mod tests {","             .expect(\"build named file\");"," ","         assert_eq!(named.buffer_size, PRELOAD_THRESHOLD * 2);","-        assert!(named.preread.is_none());","+        assert_eq!(named.preload_threshold, PRELOAD_THRESHOLD);","     }"," ","     #[tokio::test]","@@ -1607,12 +1618,106 @@ mod tests {","             .await","             .expect(\"build named file\");"," ","-        assert_eq!(","-            named.preread.as_ref().map(Bytes::len),","-            Some((PRELOAD_THRESHOLD + 1) as usize)","+        assert_eq!(named.preload_threshold, PRELOAD_THRESHOLD + 1);","+        let mut res = Response::new();","+        named.send(&HeaderMap::new(), &mut res).await;","+        assert!(","+            matches!(res.body, ResBody::Once(bytes) if bytes.len() == (PRELOAD_THRESHOLD + 1) as usize)","         );","     }"," ","+    #[tokio::test]","+    async fn conditional_responses_do_not_read_file_bodies() {","+        let root = tempfile::tempdir().unwrap();","+        let path = root.path().join(\"data.bin\");","+        for status in [StatusCode::NOT_MODIFIED, StatusCode::PRECONDITION_FAILED] {","+            std::fs::write(&path, vec![42; 900 * 1024]).unwrap();","+            let mut named = NamedFile::builder(&path)","+                .content_type(mime::APPLICATION_OCTET_STREAM)","+                .build()","+                .await","+                .unwrap();","+            // A build must inspect metadata only when no content sample is needed.","+            assert_eq!(named.file.stream_position().await.unwrap(), 0);","+            let mut headers = HeaderMap::new();","+            if status == StatusCode::NOT_MODIFIED {","+                headers.typed_insert(IfNoneMatch::from(named.etag().unwrap()));","+            } else {","+                headers.insert(IF_MATCH, HeaderValue::from_static(\"\\\"does-not-match\\\"\"));","+            }","+            // Any late body read would now fail with UnexpectedEof.","+            std::fs::OpenOptions::new()","+                .write(true)","+                .open(&path)","+                .unwrap()","+                .set_len(0)","+                .unwrap();","+            let mut res = Response::new();","+            named.send(&headers, &mut res).await;","+            assert_eq!(res.status_code, Some(status));","+            assert!(matches!(res.body, ResBody::None));","+        }","+    }","+","+    #[tokio::test]","+    async fn max_length_bounds_full_range_and_validators() {","+        use crate::test::ResponseExt;","+        let root = tempfile::tempdir().unwrap();","+        let path = root.path().join(\"data.txt\");","+        std::fs::write(&path, b\"committedUNCOMMITTED\").unwrap();","+        let mut full = Response::new();","+        let named = NamedFile::builder(&path)","+            .max_length(9)","+            .build()","+            .await","+            .unwrap();","+        let bounded_etag = named.etag();","+        let complete = NamedFile::open(&path).await.unwrap();","+        assert_ne!(bounded_etag, complete.etag());","+        named.send(&HeaderMap::new(), &mut full).await;","+        assert_eq!(full.headers()[crate::http::header::CONTENT_LENGTH], \"9\");","+        assert_eq!(full.take_string().await.unwrap(), \"committed\");","+        let named = NamedFile::builder(&path)","+            .max_length(9)","+            .preload_threshold(0)","+            .build()","+            .await","+            .unwrap();","+        let mut streamed = Response::new();","+        named.send(&HeaderMap::new(), &mut streamed).await;","+        assert_eq!(streamed.take_string().await.unwrap(), \"committed\");","+        for (range, status, body) in [","+            (\"bytes=7-20\", StatusCode::PARTIAL_CONTENT, \"ed\"),","+            (\"bytes=9-\", StatusCode::RANGE_NOT_SATISFIABLE, \"\"),","+        ] {","+            let named = NamedFile::builder(&path)","+                .max_length(9)","+                .build()","+                .await","+                .unwrap();","+            let mut headers = HeaderMap::new();","+            headers.insert(RANGE, HeaderValue::from_static(range));","+            let mut res = Response::new();","+            named.send(&headers, &mut res).await;","+            assert_eq!(res.status_code, Some(status));","+            if status == StatusCode::PARTIAL_CONTENT {","+                assert_eq!(res.take_string().await.unwrap(), body);","+            } else {","+                assert_eq!(","+                    res.headers()[crate::http::header::CONTENT_RANGE],","+                    \"bytes */9\"","+                );","+            }","+        }","+        let named = NamedFile::builder(&path)","+            .max_length(0)","+            .build()","+            .await","+            .unwrap();","+        assert_eq!(named.length, 0);","+        assert_eq!(named.content_type().type_(), mime::TEXT);","+    }","+","     #[tokio::test]","     async fn preload_threshold_zero_still_detects_extensionless_text_mime() {","         let temp_dir = tempfile::tempdir().expect(\"create temp dir\");","@@ -1627,7 +1732,7 @@ mod tests {"," ","         assert_eq!(named.content_type().type_(), mime::TEXT);","         assert_eq!(named.content_type().subtype(), mime::PLAIN);","-        assert!(named.preread.is_none());","+        assert_eq!(named.preload_threshold, 0);","     }"," ","     #[tokio::test]","@@ -1651,7 +1756,7 @@ mod tests {","                 .map(|v| v.as_str()),","             Some(\"utf-8\")","         );","-        assert!(named.preread.is_none());","+        assert_eq!(named.preload_threshold, 0);","     }"," ","     #[tokio::test]"],"additions":166,"deletions":61,"truncated":false},{"path":"crates/csrf/Cargo.toml","lines":["@@ -30,7 +30,7 @@ full = ["," ]"," cookie-store = [\"salvo_core/cookie\", \"dep:cookie\"]"," session-store = [\"dep:salvo-session\"]","-bcrypt-cipher = [\"dep:bcrypt\"]","+bcrypt-cipher = [\"dep:bcrypt\", \"dep:tokio\"]"," hmac-cipher = [\"dep:hmac\", \"dep:sha2\"]"," aes-gcm-cipher = [\"dep:aead\", \"dep:aes-gcm\", \"dep:subtle\"]"," ccp-cipher = [\"dep:aead\", \"dep:chacha20poly1305\", \"dep:subtle\"]","@@ -53,10 +53,11 @@ salvo-session = { workspace = true, optional = true }"," serde_json = { workspace = true }"," sha2 = { workspace = true, optional = true }"," subtle = { workspace = true, optional = true }","+tokio = { workspace = true, features = [\"rt\", \"sync\"], optional = true }"," "," [dev-dependencies]"," salvo_core = { workspace = true, features = [\"test\"] }","-tokio = { workspace = true, features = [\"macros\", \"rt-multi-thread\"] }","+tokio = { workspace = true, features = [\"macros\", \"rt-multi-thread\", \"time\"] }"," "," [lints]"," workspace = true"],"additions":3,"deletions":2,"truncated":false},{"path":"crates/csrf/README.md","lines":["@@ -49,6 +49,18 @@ salvo = { version = \"*\", features = [\"csrf\"] }"," "," [![Docs](https://img.shields.io/docsrs/salvo-csrf.svg)](https://docs.rs/salvo-csrf)"," ","+## Cipher scheduling","+","+For high-throughput applications, prefer the keyed `HmacCipher`, `AesGcmCipher`,","+or `CcpCipher` features. Bcrypt intentionally performs substantially more CPU work.","+The middleware and built-in stores use asynchronous cipher operations; bcrypt","+runs on blocking workers with a process-wide limit equal to available CPU parallelism.","+Cancelling a request aborts queued work; already-running work retains its capacity","+permit until it finishes. Apply request timeouts and admission limits to bound","+requests waiting for capacity. Direct `generate()` and `verify()` calls remain","+synchronous; custom expensive ciphers can override `generate_async()` and","+`verify_async()` while existing cipher implementations keep working.","+"," ## Choosing token storage"," "," For browser-facing HTTPS services, prefer `CookieStore::host_prefixed()` over"],"additions":12,"deletions":0,"truncated":false},{"path":"crates/csrf/src/bcrypt_cipher.rs","lines":["@@ -1,9 +1,15 @@"," use base64::engine::general_purpose::URL_SAFE_NO_PAD;"," use base64::Engine;","+use std::sync::{Arc, OnceLock};","+use tokio::sync::Semaphore;"," "," use super::CsrfCipher;"," "," /// CSRF protection implementation that uses bcrypt.","+///","+/// Middleware uses bounded blocking tasks, shared across all bcrypt ciphers in this process.","+/// The synchronous [`CsrfCipher::generate`] and [`CsrfCipher::verify`] methods remain blocking.","+/// Prefer a keyed HMAC/AEAD cipher for high-throughput applications."," #[derive(Debug, Clone)]"," pub struct BcryptCipher {","     cost: u32,","@@ -49,6 +55,26 @@ impl BcryptCipher {"," }"," "," impl CsrfCipher for BcryptCipher {","+    async fn verify_async(&self, token: &str, proof: &str) -> bool {","+        if token.len() != (self.token_size * 4).div_ceil(3)","+            || proof.len() != 60","+            || !proof.is_ascii()","+        {","+            return false;","+        }","+        let cipher = self.clone();","+        let token = token.to_owned();","+        let proof = proof.to_owned();","+        run_blocking(move || cipher.verify(&token, &proof))","+            .await","+            .unwrap_or(false)","+    }","+","+    async fn generate_async(&self) -> Result<(String, String), salvo_core::Error> {","+        let cipher = self.clone();","+        run_blocking(move || cipher.generate()).await","+    }","+","     fn verify(&self, token: &str, proof: &str) -> bool {","         // Reject malformed input before allocating or entering bcrypt. The token and","         // hash format are public; only the hash comparison needs constant-time handling.","@@ -90,6 +116,38 @@ impl CsrfCipher for BcryptCipher {","     }"," }"," ","+// Acquire before spawning, and move the permit into the task. Cancellation of the request must","+// not release capacity while already-started bcrypt work is still running.","+async fn run_blocking<T: Send + 'static>(","+    work: impl FnOnce() -> T + Send + 'static,","+) -> Result<T, salvo_core::Error> {","+    static CAPACITY: OnceLock<Arc<Semaphore>> = OnceLock::new();","+    let capacity = CAPACITY.get_or_init(|| {","+        Arc::new(Semaphore::new(","+            std::thread::available_parallelism().map_or(1, usize::from),","+        ))","+    });","+    run_with_capacity(capacity.clone(), work).await","+}","+","+async fn run_with_capacity<T: Send + 'static>(","+    capacity: Arc<Semaphore>,","+    work: impl FnOnce() -> T + Send + 'static,","+) -> Result<T, salvo_core::Error> {","+    let permit = capacity.acquire_owned().await.map_err(salvo_core::Error::other)?;","+    struct Task<T>(tokio::task::JoinHandle<T>);","+    impl<T> Drop for Task<T> {","+        fn drop(&mut self) {","+            self.0.abort();","+        }","+    }","+    let mut task = Task(tokio::task::spawn_blocking(move || {","+        let _permit = permit;","+        work()","+    }));","+    (&mut task.0).await.map_err(salvo_core::Error::other)","+}","+"," #[cfg(test)]"," mod tests {","     use base64::engine::general_purpose::URL_SAFE_NO_PAD;","@@ -97,6 +155,41 @@ mod tests {"," ","     use super::*;"," ","+    #[tokio::test]","+    async fn cancelled_request_keeps_capacity_until_blocking_work_finishes() {","+        let capacity = Arc::new(Semaphore::new(1));","+        let runtime_thread = std::thread::current().id();","+        let (started_tx, started_rx) = tokio::sync::oneshot::channel();","+        let (release_tx, release_rx) = std::sync::mpsc::channel();","+        let first = tokio::spawn(run_with_capacity(capacity.clone(), move || {","+            started_tx.send(std::thread::current().id()).unwrap();","+            release_rx.recv_timeout(std::time::Duration::from_secs(5)).unwrap();","+        }));","+        assert_ne!(started_rx.await.unwrap(), runtime_thread);","+        first.abort();","+        assert!(first.await.unwrap_err().is_cancelled());","+        assert_eq!(capacity.available_permits(), 0);","+","+        let (second_tx, mut second_rx) = tokio::sync::oneshot::channel();","+        let second = tokio::spawn(run_with_capacity(capacity.clone(), move || {","+            second_tx.send(()).unwrap();","+        }));","+        assert!(tokio::time::timeout(std::time::Duration::from_millis(30), &mut second_rx)","+            .await.is_err());","+        release_tx.send(()).unwrap();","+        tokio::time::timeout(std::time::Duration::from_secs(5), second_rx)","+            .await.unwrap().unwrap();","+      