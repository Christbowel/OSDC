               customizations.OperationModifiers[\"PutValue\"] = new OperationModifier { MarshallNameOverrides = [overrides] };","+                break;","+            case \"injectTaken\":","+                customizations.ShapeModifiers[\"Spec\"] = TestCustomizations.Inject(\"Kind\", new PropertyInjector { Shape = \"NameList\" });","+                break;","+            case \"accessModifier\":","+                customizations.ShapeModifiers[\"Spec\"] = TestCustomizations.Modify(\"Kind\", new PropertyModifier { AccessModifier = \"private\" });","+                break;","+            case \"marshallNameOverride\":","+                names[\"Missing\"] = new MarshallNameOverride { MarshallName = \"Value\" };","+                overrides[\"PutValueRequest\"] = names;","+                customizations.OperationModifiers[\"PutValue\"] = new OperationModifier { MarshallNameOverrides = [overrides] };","+                break;","+            case \"suppressWrapped\":","+                customizations.OperationModifiers[\"ListBuckets\"] = new OperationModifier { UseWrappingResult = true, WrappedResultShape = \"BucketPage\", WrappedResultMember = \"Page\" };","+                customizations.SuppressResultGeneration.Add(\"ListBuckets\");","+                break;","+        }","+","+        var ex = Assert.Throws<GeneratorException>(() => Apply(customizations));","+        Assert.Contains(expectedInMessage, ex.Message);","+    }"," }"],"additions":163,"deletions":0,"truncated":false},{"path":"generator/SmithyDotNet/SmithyDotNet.Generator.Tests/Generation/Customizations/CustomizationsModelTests.cs","lines":["@@ -109,10 +109,32 @@ public void Load_ExcludeAndWrappingResult_ReadsHooks()","     }"," ","     [Fact]","-    public void Load_ShapeSubstitutions_EmitAsShape_Throws()","+    public void Load_Ec2Hooks_ReadsHooks()","     {","-        var ex = Assert.Throws<GeneratorException>(() => LoadFiles(\"\"\"{ \"shapeSubstitutions\": { \"Thing\": { \"emitAsShape\": \"String\" }