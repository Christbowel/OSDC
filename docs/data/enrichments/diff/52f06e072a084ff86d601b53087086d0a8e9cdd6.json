 \"duckdb/function/scalar/nested_functions.hpp\"","+#include \"duckdb/planner/expression_iterator.hpp\"","+#include \"duckdb/storage/statistics/base_statistics.hpp\"","+","+namespace duckdb {","+","+namespace {","+","+void BarrierFunction(DataChunk &args, ExpressionState &state, Vector &result) {","+\tresult.Reference(args.data[0]);","+}","+","+unique_ptr<FunctionData> BarrierBind(BindScalarFunctionInput &input) {","+\tauto &bound_function = input.GetBoundFunction();","+\tauto &arguments = input.GetArguments();","+\tbound_function.SetReturnType(arguments[0]->GetReturnType());","+\treturn make_uniq<VariableReturnBindData>(bound_function.GetReturnType());","+}","+","+unique_ptr<BaseStatistics> BarrierStats(ClientContext &context, FunctionStatisticsInput &input) {","+\t// the barrier returns its argument unchanged - the statistics of the child carry over","+\treturn input.child_stats[0].ToUnique();","+}","+","+ScalarFunction GetBarrierFunction(const LogicalType &type) {","+\tScalarFunction fun(BarrierFun::Name, {type}, type, BarrierFunction);","+\tfun.SetBindCallback(BarrierBind);","+\tfun.SetStatisticsCallback(BarrierStats);","+\t// default null handling replaces the call with a NULL constant when the argument is typed as NULL - that would","+\t// swallow the very expression the barrier exists to preserve, e.g. __internal_barrier(error('boom'))","+\tfun.SetNullHandling(FunctionNullHandling::SPECIAL_HANDLING);","+\t// the barrier itself never throws, but marking it fallible keeps the expression out of every optimization that","+\t// evaluates an expression on more rows than it would otherwise see (dictionary execution, filter reordering)","+\tfun.SetFallible();","+\treturn fun;","+}","+","+} // namespace","+","+ScalarFunction BarrierFun::GetFunction() {","+\treturn GetBarrierFunction(LogicalType::ANY);","+}","+","+bool ExpressionBarrier::IsBarrier(const Expression &expr) {","+\tif (expr.GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {","+\t\treturn false;","+\t}","+\treturn expr.Cast<BoundFunctionExpression>().Function().GetName() == BarrierFun::Name;","+}","+","+bool ExpressionBarrier::Contains(const Expression &expr) {","+\tif (IsBarrier(expr)) {","+\t\treturn true;","+\t}","+\tbool contains = false;","+\tExpressionIterator::EnumerateChildren(expr, [&](const Expression &child) { contains |= Contains(child); });","+\treturn contains;","+}","+","+bool ExpressionBarrier::Required(const Expression &expr) {","+\treturn expr.CanThrow() || expr.IsVolatile() || expr.HasSubquery();","+}","+","+unique_ptr<Expression> ExpressionBarrier::Wrap(unique_ptr<Expression> expr) {","+\tauto return_type = expr->GetReturnType();","+\tauto function = GetBarrierFunction(return_type);","+","+\tvector<unique_ptr<Expression>> arguments;","+\targuments.push_back(std::move(expr));","+\treturn make_uniq<BoundFunctionExpression>(BoundScalarFunction(function), std::move(arguments),","+\t                                          make_uniq<VariableReturnBindData>(return_type));","+}","+","+} // namespace duckdb"],"additions":78,"deletions":0,"truncated":false},{"path":"src/function/scalar/generic/functions.json","lines":["@@ -21,6 +21,14 @@","         \"example\": \"error('access_mode')\",","         \"type\": \"scalar_function\"","     },","+    {","+        \"name\": \"__internal_barrier\",","+        \"struct\": \"BarrierFun\",","+        \"parameters\": \"arg\",","+        \"description\": \"Returns arg unchanged, and marks it as an optimizer barrier: the expression is never evaluated on rows removed by the operators around it\",","+        \"example\": \"__internal_barrier(s::INTEGER = 42)\",","+        \"type\": \"scalar_function\"","+    },","     {","         \"name\": \"create_sort_key\",","         \"parameters\": \"parameters...\","],"additions":8,"deletions":0,"truncated":false},{"path":"src/include/duckdb/execution/operator/helper/physical_secure_view.hpp","lines":["@@ -19,10 +19,13 @@ class PhysicalSecureView : public PhysicalOperator {"