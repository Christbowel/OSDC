s.dir, &entry_manifest)?;"," ","     if !opts.scripts.ignore {","         opts.scripts.run_if_present::<Reporter>(","@@ -45,13 +46,6 @@ where","         )?;","     }"," ","-    // The publish directory may differ from the project root when","-    // `publishConfig.directory` redirects packing at a build output.","-    let dir = match publish_config_directory(&entry_manifest) {","-        Some(relative) => opts.dir.join(relative),","-        None => opts.dir.clone(),","-    };","-","     // Re-read the manifest from `dir`: a `prepack` / `prepare` script","     // may have rewritten it.","     let manifest = read_manifest(&dir)?;","@@ -180,13 +174,58 @@ fn read_manifest(dir: &Path) -> Result<Value, PackError> {","     }"," }"," ","-/// `publishConfig.directory`, when set to a non-empty string.","-fn publish_config_directory(manifest: &Value) -> Option<&str> {","-    manifest","+/// Resolve `publishConfig.directory` to a relative path inside `project_dir`.","+///","+/// Validation stays lexical so build outputs symlinked into the package keep","+/// packing (see [pnpm/pnpm#17390](https://github.com/pnpm/pnpm/issues/17390)).","+/// Root, prefix, and `..` segments are rejected so paths cannot escape","+/// `project_dir` or a symlink target.","+fn resolve_publish_directory(project_dir: &Path, manifest: &Value) -> Result<PathBuf, PackError> {","+    let Some(raw_value) = manifest","         .get(\"publishConfig\")","         .and_then(|config| config.get(\"directory\"))","-        .and_then(Value::as_str)","-        .filter(|directory| !directory.is_empty())","+        .filter(|value| !value.is_null())","+    else {","+        return Ok(project_dir.to_path_buf());","+    };","+    let Some(relative) = raw_value.as_str() else {","+        return Err(PackError::InvalidPublishDirectory { dir: raw_value.to_string() });","+    };","+    if relative.is_empty() {","+        return Ok(project_dir.to_path_buf());","+    }","+    if is_invalid_publish_directory(relative) {","+        return Err(PackError::InvalidPublishDirectory { dir: relative.to_string() });","+    }","+    let mut dir = project_dir.to_path_buf();","+    for component in Path::new(relative).components() {","+        if let Component::Normal(segment) = component {","+            dir.push(segment);","+        }","+    }","+    Ok(dir)","+}","+","+fn is_invalid_publish_directory(raw: &str) -> bool {","+    let path = Path::new(raw);","+    if raw.contains(['\\0', ':']) || path.is_absolute() || raw.starts_with(['/', '\\\\']) {","+        return true;","+    }","+    path.components()","+        .any(|component| {","+            matches!(component, Component::ParentDir | Component::RootDir | Component::Prefix(_))","+        })","+        || raw","+            .split(['/', '\\\\'])","+            .any(is_dot_traversal_segment)","+}","+","+fn is_dot_traversal_segment(segment: &str) -> bool {","+    !segment.is_empty()","+        && segment != \".\"","+        && segment","+            .bytes()","+            .all(|byte| byte == b'.' || byte == b' ')"," }"," "," /// Reject a packed executable whose shebang line ends with CRLF, which Unix"],"additions":52,"deletions":13,"truncated":false},{"path":"pnpm/crates/pack/src/tests.rs","lines":["@@ -1363,6 +1363,7 @@ fn pack_preserves_internal_symlinks() {"," mod bundled_dependencies;"," mod dotenv;"," mod output;","+mod publish_directory;"," "," #[test]"," fn bin_with_crlf_shebang_is_rejected() {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/pack/src/tests/publish_directory.rs","lines":["@@ -0,0 +1,218 @@","+use super::{Host, PackError, api, fixture, json, tarball_entry_names, touch};","+use miette::Diagnostic;","+use pnpm_reporter::SilentReporter;","+use tempfile::tempdir;","+","+#[test]","+fn rejects_escaping_and_rooted_publish_config_directories() {","+    let outside = tempdir().unwrap();","+    touch(","+        outside.path(),","+        \"package.json\",","+        &serde_json::to_string(&json!({ \"name\": \"outside-pkg\", \"version\": \"1.0.0\" })).unwrap(),","+    );","+    touch(outside.path(), \"secret.txt\", \"SENSITIVE_DATA=123\");","+    let outside_str = outside","+        .path()","+        .to_str()","+        .unwrap()","+        .to_string();","+","+    let invalid_dirs = [","+        outside_str.as_str(),","+        \"/dist\",","+        \"/\",","+        \"//server/share\",","+        r\"\\outside\",","+        r\"\\\\server\\share\\outside\",","+        r\"\\\\?\\C:\\outside\",","+        \"C:outside\",","+        \"c:outside\",","+        r\"C:\\outside\",","+        \"D:/outside\",","+        \"C:\",","+        \"dist/C:outside\",","+        \"dist/D:outside\",","+        \"sub/C:/sensitive\",","+        r\"dist\\D:outside\",","+        \"dist:stream\",","+        \"..\",","+        \"../outside\",","+        \"../../outside\",","+        \"sub/../../outside\",","+        \"sub/../dist\",","+        r\"..\\outside\",","+        r\"sub\\..\\..\\outside\",","+        \"...\",","+        \".. \",","+        \". \",","+        \"   \",","+        \"sub/.. /outside\",","+        \"dist\\0/../outside\",","+    ];","+","+    for directory in invalid_dirs {","+        let (dir, opts) = fixture(&json!({","+            \"name\": \"repro\",","+            \"version\": \"1.0.0\",","+            \"publishConfig\": { \"directory\": directory },","+        }));","+","+        let err = api::<SilentReporter, Host>(&opts)","+            .expect_err(&format!(\"publishConfig.directory {directory:?} must be rejected\"));","+        assert_eq!(","+            err.code().map(|code| code.to_string()),","+            Some(\"ERR_PNPM_INVALID_PUBLISH_DIRECTORY\".to_string()),","+            \"directory: {directory:?}\",","+        );","+        assert!(matches!(err, PackError::InvalidPublishDirectory { ref dir } if dir == directory));","+        assert!(","+            !outside","+                .path()","+                .join(\"outside-pkg-1.0.0.tgz\")","+                .exis