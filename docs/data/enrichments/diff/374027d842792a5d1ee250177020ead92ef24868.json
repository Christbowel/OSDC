     (json!(\"..hidden\"), \"..hidden\"),","+        (json!(\"dist..v2\"), \"dist..v2\"),","+    ] {","+        let (dir, opts) = fixture(&json!({","+            \"name\": \"pkg\",","+            \"version\": \"1.0.0\",","+            \"publishConfig\": { \"directory\": directory },","+        }));","+        if rel_dir != \".\" {","+            touch(","+                dir.path(),","+                &format!(\"{rel_dir}/package.json\"),","+                &serde_json::to_string(&json!({ \"name\": \"pkg\", \"version\": \"1.0.0\" })).unwrap(),","+            );","+        }","+        touch(dir.path(), &format!(\"{rel_dir}/index.js\"), \"module.exports = 1;\\n\");","+","+        let result = api::<SilentReporter, Host>(&opts)","+            .unwrap_or_else(|err| panic!(\"valid directory {directory:?} failed: {err}\"));","+        let tarball = dir","+            .path()","+            .join(rel_dir)","+            .join(\"pkg-1.0.0.tgz\");","+        assert!(tarball.is_file(), \"expected tarball at {}\", tarball.display());","+        let entries = tarball_entry_names(&tarball);","+        assert!(entries.contains(&\"package/index.js\".to_string()), \"entries: {entries:?}\");","+        assert_eq!(result.packed_manifest[\"name\"], \"pkg\");","+    }","+}","+","+#[cfg(unix)]","+#[test]","+fn packs_publish_directory_reached_through_symlink_and_rejects_parent_escape() {","+    let outer = tempdir().unwrap();","+    let pkg_dir = outer.path().join(\"pkg\");","+    let out_dist = outer.path().join(\"output/dist\");","+    let sibling_secret = outer.path().join(\"output/secret\");","+    std::fs::create_dir_all(&pkg_dir).unwrap();","+    std::fs::create_dir_all(&out_dist).unwrap();","+    std::fs::create_dir_all(&sibling_secret).unwrap();","+","+    touch(","+        &pkg_dir,","+        \"package.json\",","+        &serde_json::to_string(&json!({","+            \"name\": \"symlinked-publish-directory\",","+            \"version\": \"1.0.0\",","+            \"publishConfig\": { \"directory\": \"build/dist\" },","+        }))","+        .unwrap(),","+    );","+    touch(","+        &out_dist,","+        \"package.json\",","+        &serde_json::to_string(&json!({","+            \"name\": \"symlinked-publish-directory\",","+            \"version\": \"1.0.0\",","+        }))","+        .unwrap(),","+    );","+    touch(&out_dist, \"index.js\", \"module.exports = 1;\\n\");","+    touch(","+        &sibling_secret,","+        \"package.json\",","+        &serde_json::to_string(&json!({ \"name\": \"secret-pkg\", \"version\": \"1.0.0\" })).unwrap(),","+    );","+    std::os::unix::fs::symlink(\"../output\", pkg_dir.join(\"build\")).unwrap();","+","+    let (_unused, mut opts) = fixture(&json!({ \"name\": \"placeholder\", \"version\": \"1.0.0\" }));","+    opts.dir = pkg_dir.clone();","+    opts.output.destination = Some(pkg_dir.to_str().unwrap().to_string());","+","+    api::<SilentReporter, Host>(&opts).expect(\"symlinked build/dist must pack (pnpm/pnpm#17390)\");","+    let tarball = pkg_dir.join(\"symlinked-publish-directory-1.0.0.tgz\");","+    let entries = tarball_entry_names(&tarball);","+    assert!(entries.contains(&\"package/index.js\".to_string()));","+","+    touch(","+        &pkg_dir,","+        \"package.json\",","+        &serde_json::to_string(&json!({","+            \"name\": \"symlinked-publish-directory\",","+            \"version\": \"1.0.0\",","+            \"publishConfig\": { \"directory\": \"build/dist/../secret\" },","+        }))","+        .unwrap(),","+    );","+    let err = api::<SilentReporter, Host>(&opts)","+        .expect_err(\".. after symlinked publish directory must be rejected\");","+    assert!(matches!(err, PackError::InvalidPublishDirectory { .. }));","+}"],"additions":218,"deletions":0,"truncated":false},{"path":"pnpm11/releasing/commands/src/publish/packApi.ts","lines":["@@ -15,7 +15,7 @@ import { glob } from 'tinyglobby'"," import validateNpmPackageName from 'validate-npm-package-name'"," "," i