{"id":"60bf0f444ac1ea64d8cc3b1204b2e44cc8e7a05e","axis":"silent","repo":"grafana/mimir","sha":"60bf0f444ac1ea64d8cc3b1204b2e44cc8e7a05e","parsed":{"files":[{"path":"pkg/compartments/config.go","lines":["@@ -5,6 +5,8 @@ package compartments"," import ("," \t\"errors\""," \t\"flag\"","+\t\"fmt\"","+\t\"math\""," \t\"strconv\""," \t\"strings\""," )","@@ -17,10 +19,15 @@ const ("," \t// WriteCompartmentIDPlaceholder is replaced with the write compartment ID when expanding templated"," \t// settings such as the Kafka cluster address and SASL credentials."," \tWriteCompartmentIDPlaceholder = \"<write-compartment-id>\"","+","+\t// MaxReadCompartments is the maximum number of read compartments, so a read compartment ID","+\t// always fits in a uint8.","+\tMaxReadCompartments = math.MaxUint8 + 1"," )"," "," var ("," \tErrInvalidNumReadCompartments  = errors.New(\"compartments read.num-compartments must be greater than 0 when compartments are enabled\")","+\tErrTooManyReadCompartments     = fmt.Errorf(\"compartments read.num-compartments must not be greater than %d\", MaxReadCompartments)"," \tErrInvalidNumWriteCompartments = errors.New(\"compartments write.num-compartments must be greater than 0 when compartments are enabled\")"," )"," ","@@ -66,6 +73,9 @@ func (cfg *Config) Validate() error {"," \tif cfg.Read.NumCompartments <= 0 {"," \t\treturn ErrInvalidNumReadCompartments"," \t}","+\tif cfg.Read.NumCompartments > MaxReadCompartments {","+\t\treturn ErrTooManyReadCompartments","+\t}"," \tif cfg.Write.NumCompartments <= 0 {"," \t\treturn ErrInvalidNumWriteCompartments"," \t}"],"additions":10,"deletions":0,"truncated":false},{"path":"pkg/compartments/config_test.go","lines":["@@ -28,6 +28,13 @@ func TestConfig_Validate(t *testing.T) {"," \t\t\tcfg:         Config{Enabled: true, Read: ReadConfig{NumCompartments: -1}, Write: WriteConfig{NumCompartments: 3}},"," \t\t\texpectedErr: ErrInvalidNumReadCompartments,"," \t\t},","+\t\t\"enabled with the maximum number of read compartments passes\": {","+\t\t\tcfg: Config{Enabled: true, Read: ReadConfig{NumCompartments: MaxReadCompartments}, Write: WriteConfig{NumCompartments: 3}},","+\t\t},","+\t\t\"enabled with too many read compartments is rejected\": {","+\t\t\tcfg:         Config{Enabled: true, Read: ReadConfig{NumCompartments: MaxReadCompartments + 1}, Write: WriteConfig{NumCompartments: 3}},","+\t\t\texpectedErr: ErrTooManyReadCompartments,","+\t\t},"," \t\t\"enabled with zero write compartments is rejected\": {"," \t\t\tcfg:         Config{Enabled: true, Read: ReadConfig{NumCompartments: 2}, Write: WriteConfig{NumCompartments: 0}},"," \t\t\texpectedErr: ErrInvalidNumWriteCompartments,"],"additions":7,"deletions":0,"truncated":false},{"path":"pkg/compartments/tenant_id.go","lines":["@@ -0,0 +1,71 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+package compartments","+","+import (","+\t\"strconv\"","+\t\"strings\"","+","+\t\"github.com/grafana/dskit/tenant\"","+)","+","+// readCompartmentTenantIDInfix is inserted into tenant IDs as \"/rc/<id>\" before any metadata.","+const readCompartmentTenantIDInfix = \"/rc/\"","+","+// TenantIDWithReadCompartment returns tenantID with the \"/rc/<compartmentID>\" suffix. tenantID must","+// not contain tenant metadata. Use tenant.Metadata.WithTenant to add the metadata after the suffix.","+func TenantIDWithReadCompartment(tenantID string, compartmentID int) string {","+\treturn tenantID + readCompartmentTenantIDInfix + strconv.Itoa(compartmentID)","+}","+","+// BaseTenantID returns tenantIDWithMetadata without the tenant metadata and without a well-formed","+// \"/rc/<compartmentID>\" suffix. It does not allocate.","+func BaseTenantID(tenantIDWithMetadata string) string {","+\tif baseTenantID, _, ok := splitReadCompartmentTenantID(tenantIDWithMetadata); ok {","+\t\treturn baseTenantID","+\t}","+\treturn tenant.TrimMetadata(tenantIDWithMetadata)","+}","+","+// ParseTenantIDWithMetadata parses tenantIDWithMetadata like tenant.ParseWithMetadata. It also accepts","+// a well-formed \"/rc/<compartmentID>\" suffix before the metadata, and the returned tenantID keeps that","+// suffix. It does not allocate when the input is valid.","+func ParseTenantIDWithMetadata(tenantIDWithMetadata string) (tenantID string, metadata tenant.Metadata, err error) {","+\tbaseTenantID, metadataSource, ok := splitReadCompartmentTenantID(tenantIDWithMetadata)","+\tif !ok {","+\t\treturn tenant.ParseWithMetadata(tenantIDWithMetadata)","+\t}","+\tif err := tenant.ValidTenantID(baseTenantID); err != nil {","+\t\treturn \"\", tenant.Metadata{}, err","+\t}","+\tif metadata, err = tenant.ParseMetadata(metadataSource); err != nil {","+\t\treturn \"\", tenant.Metadata{}, err","+\t}","+\treturn tenantIDWithMetadata[:len(tenantIDWithMetadata)-len(metadataSource)], metadata, nil","+}","+","+// splitReadCompartmentTenantID splits tenantIDWithMetadata into the tenant ID without a","+// well-formed \"/rc/<compartmentID>\" suffix and the metadata (including the leading ':').","+// ok is false when no well-formed suffix is present. The returned strings are slices of the","+// input and do not allocate.","+func splitReadCompartmentTenantID(tenantIDWithMetadata string) (tenantID, metadata string, ok bool) {","+\t// Most tenant IDs have no read compartment suffix. IndexByte finds those IDs faster than LastIndex.","+\tif strings.IndexByte(tenantIDWithMetadata, '/') < 0 {","+\t\treturn \"\", \"\", false","+\t}","+","+\ttenantWithCompartment, metadata := tenantIDWithMetadata, \"\"","+\tif idx := strings.IndexByte(tenantIDWithMetadata, ':'); idx != -1 {","+\t\ttenantWithCompartment, metadata = tenantIDWithMetadata[:idx], tenantIDWithMetadata[idx:]","+\t}","+","+\trcIdx := strings.LastIndex(tenantWithCompartment, readCompartmentTenantIDInfix)","+\tif rcIdx < 0 {","+\t\treturn \"\", \"\", false","+\t}","+","+\tif _, err := strconv.Atoi(tenantWithCompartment[rcIdx+len(readCompartmentTenantIDInfix):]); err != nil {","+\t\treturn \"\", \"\", false","+\t}","+\treturn tenantWithCompartment[:rcIdx], metadata, true","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"pkg/compartments/tenant_id_test.go","lines":["@@ -0,0 +1,123 @@","+// SPDX-License-Identifier: AGPL-3.0-only","+","+package compartments","+","+import (","+\t\"testing\"","+","+\t\"github.com/grafana/dskit/tenant\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestTenantIDWithReadCompartment(t *testing.T) {","+\tassert.Equal(t, \"123/rc/2\", TenantIDWithReadCompartment(\"123\", 2))","+\tassert.Equal(t, \"user/rc/0\", TenantIDWithReadCompartment(\"user\", 0))","+}","+","+func TestBaseTenantID(t *testing.T) {","+\ttests := map[string]struct {","+\t\tinput    string","+\t\texpected string","+\t}{","+\t\t\"read compartment without metadata\": {","+\t\t\tinput:    \"tenant/rc/1\",","+\t\t\texpected: \"tenant\",","+\t\t},","+\t\t\"read compartment with metadata\": {","+\t\t\tinput:    \"tenant/rc/1:source=x\",","+\t\t\texpected: \"tenant\",","+\t\t},","+\t\t\"compartment zero\": {","+\t\t\tinput:    \"user/rc/0\",","+\t\t\texpected: \"user\",","+\t\t},","+\t\t\"no read compartment\": {","+\t\t\tinput:    \"tenant\",","+\t\t\texpected: \"tenant\",","+\t\t},","+\t\t\"metadata only\": {","+\t\t\tinput:    \"tenant:source=x\",","+\t\t\texpected: \"tenant\",","+\t\t},","+\t\t\"malformed non-digit compartment\": {","+\t\t\tinput:    \"tenant/rc/x\",","+\t\t\texpected: \"tenant/rc/x\",","+\t\t},","+\t\t\"malformed empty compartment\": {","+\t\t\tinput:    \"tenant/rc/\",","+\t\t\texpected: \"tenant/rc/\",","+\t\t},","+\t\t\"malformed wrong infix\": {","+\t\t\tinput:    \"tenant/foo/1\",","+\t\t\texpected: \"tenant/foo/1\",","+\t\t},","+\t\t\"malformed non-digit compartment with metadata\": {","+\t\t\tinput:    \"tenant/rc/x:source=x\",","+\t\t\texpected: \"tenant/rc/x\",","+\t\t},","+\t}","+","+\tfor name, tc := range tests {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tassert.Equal(t, tc.expected, BaseTenantID(tc.input))","+\t\t})","+\t}","+}","+","+func TestParseTenantIDWithMetadata(t *testing.T) {","+\ttests := map[string]struct {","+\t\tinput            string","+\t\texpectedTenantID string","+\t\texpectedMetadata string","+\t\texpectedErr      error","+\t}{","+\t\t\"without read compartment\": {","+\t\t\tinput:            \"tenant\",","+\t\t\texpectedTenantID: \"tenant\",","+\t\t},","+\t\t\"without read compartment, with metadata\": {","+\t\t\tinput:            \"tenant:source=x\",","+\t\t\texpectedTenantID: \"tenant\",","+\t\t\texpectedMetadata: \":source=x\",","+\t\t},","+\t\t\"with read compartment\": {","+\t\t\tinput:            \"tenant/rc/1\",","+\t\t\texpectedTenantID: \"tenant/rc/1\",","+\t\t},","+\t\t\"with read compartment and metadata\": {","+\t\t\tinput:            \"tenant/rc/1:source=x\",","+\t\t\texpectedTenantID: \"tenant/rc/1\",","+\t\t\texpectedMetadata: \":source=x\",","+\t\t},","+\t\t\"malformed non-digit compartment\": {","+\t\t\tinput:       \"tenant/rc/x\",","+\t\t\texpectedErr: tenant.ValidTenantID(\"tenant/rc/x\"),","+\t\t},","+\t\t\"malformed wrong infix\": {","+\t\t\tinput:       \"tenant/foo/1\",","+\t\t\texpectedErr: tenant.ValidTenantID(\"tenant/foo/1\"),","+\t\t},","+\t\t\"invalid tenant ID with read compartment\": {","+\t\t\tinput:       \"bad tenant/rc/1\",","+\t\t\texpectedErr: tenant.ValidTenantID(\"bad tenant\"),","+\t\t},","+\t\t\"invalid metadata with read compartment\": {","+\t\t\tinput:       \"tenant/rc/1:source=\\xb5\",","+\t\t\texpectedErr: tenant.ValidMetadata(\":source=\\xb5\"),","+\t\t},","+\t}","+","+\tfor name, tc := range tests {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\ttenantID, metadata, err := ParseTenantIDWithMetadata(tc.input)","+\t\t\tif tc.expectedErr != nil {","+\t\t\t\trequire.EqualError(t, err, tc.expectedErr.Error())","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+\t\t\tassert.Equal(t, tc.expectedTenantID, tenantID)","+\t\t\tassert.Equal(t, tenant.NewMetadata(tc.expectedMetadata), metadata)","+\t\t})","+\t}","+}"],"additions":123,"deletions":0,"truncated":false},{"path":"pkg/distributor/compartments.go","lines":["@@ -3,8 +3,14 @@"," package distributor"," "," import (","+\t\"slices\"","+\t\"sync\"","+","+\t\"github.com/grafana/dskit/tenant\"","+"," \t\"github.com/grafana/mimir/pkg/compartments\""," \t\"github.com/grafana/mimir/pkg/mimirpb\"","+\t\"github.com/grafana/mimir/pkg/usagetracker/usagetrackerclient\""," \t\"github.com/grafana/mimir/pkg/util/extract\""," )"," ","@@ -68,3 +74,65 @@ func getCompartmentTokensForWriteRequest(router *compartments.TopicRouter, userI"," \t}"," \treturn filtered, initialMetadataIndex"," }","+","+// groupSeriesHashesScratch holds the scratch buffers of groupSeriesHashesByReadCompartment.","+type groupSeriesHashesScratch struct {","+\toffsets []int","+\t// seriesCompartments is a uint8 because compartments.Config.Validate caps the number of read","+\t// compartments at compartments.MaxReadCompartments.","+\tseriesCompartments []uint8","+}","+","+var groupSeriesHashesScratchPool = sync.Pool{","+\tNew: func() any { return &groupSeriesHashesScratch{} },","+}","+","+// groupSeriesHashesByReadCompartment groups seriesHashes by the read compartment of each series in","+// timeseries. Each group is treated by the usage-tracker client as a separate user. The groups are","+// ordered by ascending compartment ID and share one backing array for the hashes.","+func groupSeriesHashesByReadCompartment(router *compartments.TopicRouter, userID string, metadata tenant.Metadata, timeseries []mimirpb.PreallocTimeseries, seriesHashes []uint64) []usagetrackerclient.UserSeries {","+\tnumCompartments := router.NumCompartments()","+","+\tscratch := groupSeriesHashesScratchPool.Get().(*groupSeriesHashesScratch)","+\tdefer groupSeriesHashesScratchPool.Put(scratch)","+\tscratch.offsets = slices.Grow(scratch.offsets[:0], numCompartments)[:numCompartments]","+\tscratch.seriesCompartments = slices.Grow(scratch.seriesCompartments[:0], len(timeseries))[:len(timeseries)]","+\toffsets, seriesCompartments := scratch.offsets, scratch.seriesCompartments","+","+\t// Find the read compartment of each series. At first, offsets holds the number of series of each","+\t// compartment.","+\tclear(offsets)","+\tfor i, ts := range timeseries {","+\t\tmetricName, _ := extract.UnsafeMetricNameFromLabelAdapters(ts.Labels)","+\t\tcompartment := router.CompartmentForMetric(userID, metricName)","+\t\tseriesCompartments[i] = uint8(compartment)","+\t\toffsets[compartment]++","+\t}","+","+\t// Reserve one contiguous slice of the shared hashes array for each non-empty compartment, in","+\t// ascending compartment order. Then offsets[compartment] is the first free slot of that slice.","+\thashes := make([]uint64, len(seriesHashes))","+\tseriesHashesByReadCompartment := make([]usagetrackerclient.UserSeries, 0, numCompartments)","+\tstart := 0","+\tfor compartment, count := range offsets {","+\t\toffsets[compartment] = start","+\t\tif count > 0 {","+\t\t\tend := start + count","+\t\t\tseriesHashesByReadCompartment = append(seriesHashesByReadCompartment, usagetrackerclient.UserSeries{","+\t\t\t\tUserID: metadata.WithTenant(compartments.TenantIDWithReadCompartment(userID, compartment)),","+\t\t\t\tSeries: hashes[start:end:end],","+\t\t\t})","+\t\t\tstart = end","+\t\t}","+\t}","+","+\t// Write each series hash into the next free slot of its compartment. Within a compartment the","+\t// hashes keep the order of the original request.","+\tfor i, hash := range seriesHashes {","+\t\tcompartment := seriesCompartments[i]","+\t\thashes[offsets[compartment]] = hash","+\t\toffsets[compartment]++","+\t}","+","+\treturn seriesHashesByReadCompartment","+}"],"additions":68,"deletions":0,"truncated":false},{"path":"pkg/distributor/compartments_test.go","lines":["@@ -4,13 +4,17 @@ package distributor"," "," import ("," \t\"slices\"","+\t\"strconv\""," \t\"testing\""," ","+\t\"github.com/grafana/dskit/tenant\""," \t\"github.com/prometheus/common/model\""," \t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\""," "," \t\"github.com/grafana/mimir/pkg/compartments\""," \t\"github.com/grafana/mimir/pkg/mimirpb\"","+\t\"github.com/grafana/mimir/pkg/usagetracker/usagetrackerclient\""," )"," "," func TestCompartmentTokens_WriteRequestIndexes(t *testing.T) {","@@ -99,3 +103,41 @@ func TestGetCompartmentTokensForWriteRequest(t *testing.T) {"," \t\tassert.Equal(t, 1, total)"," \t})"," }","+","+func TestGroupSeriesHashesByReadCompartment(t *testing.T) {","+\tconst (","+\t\tuserID          = \"user-1\"","+\t\tnumCompartments = 5","+\t)","+\tmetadata := tenant.NewMetadata(\":source=test\")","+\trouter := compartments.NewTopicRouter(numCompartments, \"comp-<read-compartment-id>\")","+","+\tmetricNames := []string{\"metric_a\", \"metric_b\", \"metric_a\", \"metric_c\", \"metric_d\", \"metric_b\"}","+\ttimeseries := make([]mimirpb.PreallocTimeseries, 0, len(metricNames))","+\tseriesHashes := make([]uint64, 0, len(metricNames))","+\texpectedHashes := map[int][]uint64{}","+\tfor i, metricName := range metricNames {","+\t\ttimeseries = append(timeseries, makeTimeseries([]string{model.MetricNameLabel, metricName}, makeSamples(1000, 1), nil, nil))","+\t\thash := uint64(100 + i)","+\t\tseriesHashes = append(seriesHashes, hash)","+\t\tcompartment := router.CompartmentForMetric(userID, metricName)","+\t\texpectedHashes[compartment] = append(expectedHashes[compartment], hash)","+\t}","+","+\tvar expectedGroups []usagetrackerclient.UserSeries","+\tfor compartment := range numCompartments {","+\t\tif hashes, ok := expectedHashes[compartment]; ok {","+\t\t\texpectedGroups = append(expectedGroups, usagetrackerclient.UserSeries{","+\t\t\t\tUserID: userID + \"/rc/\" + strconv.Itoa(compartment) + \":source=test\",","+\t\t\t\tSeries: hashes,","+\t\t\t})","+\t\t}","+\t}","+\t// The test needs more than one group and at least one empty compartment.","+\trequire.Greater(t, len(expectedGroups), 1)","+\trequire.Less(t, len(expectedGroups), numCompartments)","+","+\tassert.Equal(t, expectedGroups, groupSeriesHashesByReadCompartment(router, userID, metadata, timeseries, seriesHashes))","+\t// The second call can get the scratch buffers that the first call returned to the pool.","+\tassert.Equal(t, expectedGroups, groupSeriesHashesByReadCompartment(router, userID, metadata, timeseries, seriesHashes))","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"pkg/distributor/distributor.go","lines":["@@ -109,6 +109,7 @@ const ("," type usageTrackerGenericClient interface {"," \tservices.Service"," \tTrackSeries(ctx context.Context, userID string, series []uint64) ([]uint64, error)","+\tTrackSeriesMulti(ctx context.Context, users []usagetrackerclient.UserSeries) ([][]uint64, error)"," \tTrackSeriesAsync(ctx context.Context, userID string, series []uint64) error"," \tCanTrackAsync(userID string) bool"," }","@@ -1869,34 +1870,46 @@ func (d *Distributor) prePushMaxSeriesLimitMiddleware(next PushFunc) PushFunc {"," "," \t\t// Track the series and check if anyone should be rejected because over the limit."," \t\t// For users that are far from their limits, we can do this asynchronously.","-\t\tif d.usageTrackerClient.CanTrackAsync(limitsKey) {","+\t\tvar (","+\t\t\ttrackedAsync   bool","+\t\t\trejectedHashes []uint64","+\t\t)","+\t\tif d.compartmentRouter == nil {","+\t\t\ttrackedAsync, rejectedHashes, err = d.trackTenantSeries(ctx, limitsKey, seriesHashes)","+\t\t} else {","+\t\t\tseriesHashesByReadCompartment := groupSeriesHashesByReadCompartment(d.compartmentRouter, userID, metadata, req.Timeseries, seriesHashes)","+\t\t\ttrackedAsync, rejectedHashes, err = d.trackReadCompartmentSeries(ctx, seriesHashesByReadCompartment)","+\t\t}","+\t\tif err != nil {","+\t\t\treturn errors.Wrap(err, \"failed to enforce max series limit\")","+\t\t}","+","+\t\tif trackedAsync {"," \t\t\t// User is far from limit."," \t\t\t// We can perform the track call in parallel with the metrics ingestion hoping that no series would be rejected.","-"," \t\t\td.asyncUsageTrackerCalls.WithLabelValues(userID).Inc()","-","-\t\t\tif err := d.usageTrackerClient.TrackSeriesAsync(ctx, limitsKey, seriesHashes); err != nil {","-\t\t\t\tlevel.Error(d.log).Log(\"msg\", \"failed to track series asynchronously\", \"err\", err, \"user\", limitsKey, \"series\", len(seriesHashes))","-\t\t\t}","-"," \t\t\treturn next(ctx, pushReq)"," \t\t}"," ","-\t\t// User is close to limit, track synchronously.","-\t\trejectedHashes, err := d.usageTrackerClient.TrackSeries(ctx, limitsKey, seriesHashes)","-\t\tif err != nil {","-\t\t\treturn errors.Wrap(err, \"failed to enforce max series limit\")","-\t\t}","-","-\t\tvar discardedSamples int","+\t\t// User is close to limit, the series were tracked synchronously.","+\t\tvar (","+\t\t\tdiscardedSamples       int","+\t\t\tactiveSeriesLimitedErr error","+\t\t)"," \t\tif len(rejectedHashes) > 0 {"," \t\t\tdiscardedSamples = filterOutRejectedSeries(req, seriesHashes, rejectedHashes)"," \t\t\td.discardedSamplesPerUserSeriesLimit.WithLabelValues(userID, pushReq.group).Add(float64(discardedSamples))","+","+\t\t\tif d.compartmentRouter != nil {","+\t\t\t\tactiveSeriesLimitedErr = newActiveSeriesLimitedInReadCompartmentsError(totalTimeseries, len(rejectedHashes), d.limits.ActiveSeriesLimitResponseCode(limitsKey), int64(discardedSamples))","+\t\t\t} else {","+\t\t\t\tactiveSeriesLimitedErr = newActiveSeriesLimitedError(totalTimeseries, len(rejectedHashes), d.limits.MaxActiveOrGlobalSeriesPerUser(limitsKey), d.limits.ActiveSeriesLimitResponseCode(limitsKey), int64(discardedSamples))","+\t\t\t}"," \t\t}"," "," \t\tif len(req.Timeseries) == 0 {"," \t\t\t// All series have been rejected, no need to talk to ingesters.","-\t\t\treturn newActiveSeriesLimitedError(totalTimeseries, len(rejectedHashes), d.limits.MaxActiveOrGlobalSeriesPerUser(limitsKey), d.limits.ActiveSeriesLimitResponseCode(limitsKey), int64(discardedSamples))","+\t\t\treturn activeSeriesLimited