src/routes/decisions/questions.rs","lines":["@@ -32,6 +32,20 @@ impl QuestionType {","     /// Every type, in Python's registration order.","     pub(super) const ALL: [Self; 3] = [Self::Choice, Self::Noul, Self::Score];"," ","+    /// The name requests use for the type.","+    pub(super) fn name(self) -> &'static str {","+        match self {","+            Self::Choice => \"choice\",","+            Self::Noul => \"noul\",","+            Self::Score => \"score\",","+        }","+    }","+","+    /// The type a request names, if any.","+    pub(super) fn from_name(name: &str) -> Option<Self> {","+        Self::ALL.into_iter().find(|question_type| question_type.name() == name)","+    }","+","     /// The labels of a question's options, in option order.","     pub(super) fn label_set(self) -> &'static [&'static str] {","         match self {"],"additions":14,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes/decisions/structured.rs","lines":["@@ -0,0 +1,536 @@","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+//! Structured decisions API (`POST /v1/systemone`): questions keyed by id","+//! about a state, answered with next-token reads.","+//!","+//! Original Python definitions: `vllm/entrypoints/generate/structured_decisions/`","+//! and the question types' `parse_options` and `answer` in","+//! `vllm/entrypoints/openai/decisions/question_types.py`.","+","+use std::collections::{BTreeSet, HashMap, HashSet};","+","+use indexmap::IndexMap;","+use serde::{Deserialize, Serialize};","+use serde_json::{Map, Value};","+use serde_json_fmt::JsonFormat;","+","+use super::next_token::{MAX_QUESTIONS, QuestionRead};","+use super::questions::{Question, QuestionOption, QuestionType, argmax};","+use crate::error::{ApiError, bail_invalid_request, invalid_request};","+","+/// `POST /v1/systemone` request body.","+#[derive(Debug, Clone, Deserialize)]","+#[serde(deny_unknown_fields)]","+pub struct StructuredDecisionRequest {","+    pub model: Option<String>,","+    /// What the questions are about: text or JSON.","+    pub state: Value,","+    /// Question id to question, asked in this order.","+    pub questions: IndexMap<String, QuestionSpec>,","+    /// Context placed ahead of the questions, as a system message.","+    pub instructions: Option<String>,","+    pub images: Option<Vec<String>>,","+    pub audio: Option<Vec<String>>,","+    pub videos: Option<Vec<String>>,","+    pub chat_template_kwargs: Option<HashMap<String, Value>>,","+    /// Answer the questions jointly; diffusion models only.","+    #[serde(default)]","+    pub joint: bool,","+    pub cache_salt: Option<String>,","+    #[serde(default)]","+    pub priority: i32,","+    pub request_id: Option<String>,","+}","+","+/// One question of a request. Python's `QuestionSpec`.","+#[derive(Debug, Clone, Deserialize)]","+pub struct QuestionSpec {","+    #[serde(rename = \"type\")]","+    pub question_type: String,","+    #[serde(default)]","+    pub instructions: Value,","+    /// Shaped by the type; [`parse_options`] reads it.","+    #[serde(default)]","+    pub criteria: Value,","+    /// Fields the spec does not declare, which Python refuses by name.","+    #[serde(flatten)]","+    pub extra: Map<String, Value>,","+}","+","+impl StructuredDecisionRequest {","+    /// Refuse the request's media, like Python's `_media`: a read renders","+    /// images only, and only for a multimodal model, which the Rust frontend","+    /// does not do yet.","+    pub fn check_media(&self, multimodal: bool) -> Result<(), ApiError> {","+        let media: BTreeSet<_> = [","+            (\"image\", &self.images),","+            (\"audio\", &self.audio),","+            (\"video\", &self.videos),","+        ]","+        .into_iter()","+        .filter(|(_, urls)| urls.as_ref().is_some_and(|urls| !urls.is_empty()))","+        .map(|(modality, _)| modality)","+        .collect();","+        let unsupported: Vec<_> = (me