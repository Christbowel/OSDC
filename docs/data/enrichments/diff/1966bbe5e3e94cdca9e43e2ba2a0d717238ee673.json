{"id":"1966bbe5e3e94cdca9e43e2ba2a0d717238ee673","axis":"silent","repo":"vimeo/psalm","sha":"1966bbe5e3e94cdca9e43e2ba2a0d717238ee673","parsed":{"files":[{"path":"docs/security_analysis/annotations.md","lines":["@@ -1,6 +1,6 @@"," # Security analysis annotations"," ","-## `@psalm-taint-source <taint-type>`","+## `@psalm-taint-source <taint-type> [return['key']]`"," "," See [Custom taint sources](custom_taint_sources.md#taint-source-annotation)."," "],"additions":1,"deletions":1,"truncated":false},{"path":"docs/security_analysis/custom_taint_sources.md","lines":["@@ -16,6 +16,20 @@ In the below example the `input` taint type is specified as a standin for input"," function getQueryParam(string $name) : string {}"," ```"," ","+When only a key of what a function or a method returns comes from the user, name it after `return`: the other keys","+aren't sources. Keys are quoted (`'name'` or `\"name\"`) or digits, and can be nested: `return['file']['name']`.","+","+```php","+<?php","+/**","+ * The name the client gave the uploaded file is its input; the path the upload is moved to isn't.","+ *","+ * @psalm-taint-source input return['original']","+ * @return array{original: string, path: string}","+ */","+function handleUpload(): array {}","+```","+"," ## Custom taints declared in the configuration"," "," Custom taints can be declared in `psalm.xml`, so that the annotations can name them without a plugin registering"],"additions":14,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/Call/FunctionCallReturnTypeFetcher.php","lines":["@@ -1933,6 +1933,43 @@ public static function taintUsingStorage(","             $taint_source = $function_call_node->setTaints($taints);","             $graph->addSource($taint_source);","         }","+","+        self::addReturnKeySources($function_storage, $graph, $function_call_node);","+    }","+","+    /**","+     * Adds the sources of the taints a function-like returns under keys (`@psalm-taint-source input return['key']`),","+     * leading into its return node $return_node under those keys","+     *","+     * @psalm-capabilities read-props|write-this-props|write-props|write-refs","+     */","+    public static function addReturnKeySources(","+        FunctionLikeStorage $function_storage,","+        TaintFlowGraph $graph,","+        DataFlowNode $return_node,","+    ): void {","+        foreach ($function_storage->taint_source_keys as [$keys, $taints]) {","+            $taints &= ~$function_storage->removed_taints;","+            if ($taints === 0) {","+                continue;","+            }","+","+            // a node for each key, outermost first, with a path to the node of the array holding it","+            $parent = $return_node;","+            $prefix = [];","+            foreach ($keys as $i => $key) {","+                $prefix[] = $key;","+                $is_source = $i === count($keys) - 1;","+                $node = DataFlowNode::getForReturnKey($return_node, $prefix, $is_source ? $taints : 0);","+                if ($is_source) {","+                    $graph->addSource($node);","+                }","+","+                $graph->addNode($node);","+                $graph->addPath($node, $parent, 'arrayvalue-assignment-\\'' . $key . '\\'');","+                $parent = $node;","+            }","+        }","     }"," ","     /**"],"additions":37,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/Analyzer/Statements/Expression/Call/StaticCallAnalyzer.php","lines":["@@ -480,6 +480,8 @@ public static function taintReturnType(","         }"," ","         if ($method_storage) {","+            FunctionCallReturnTypeFetcher::addReturnKeySources($method_storage, $taint_flow_graph, $method_source);","+","             FunctionCallReturnTypeFetcher::taintUsingFlows(","                 $method_storage,","                 $taint_flow_graph,"],"additions":2,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/DataFlow/DataFlowNode.php","lines":["@@ -930,6 +930,31 @@ public static function getForPathVariant(string $from_id, ?self $from, string $p","         );","     }"," ","+    /**","+     * The source of the taints a function-like returns under the keys $keys, outermost first, which leads into its","+     * return node $return_node (see FunctionCallReturnTypeFetcher::taintUsingStorage()). Its label and location, a","+     * pure function of its id, are those of the return node.","+     *","+     * @param non-empty-list<string> $keys","+     * @psalm-mutation-free","+     */","+    public static function getForReturnKey(self $return_node, array $keys, int $taints = 0): self","+    {","+        $suffix = '';","+        foreach ($keys as $key) {","+            $suffix .= \"['\" . $key . \"']\";","+        }","+","+        return new self(","+            $return_node->id . $suffix,","+            null,","+            null,","+            $return_node->label . $suffix,","+            $return_node->code_location,","+            $taints,","+        );","+    }","+","     /**","      * A node identified only by its id, with no location and no taint state. Used by the","      * variable-use graph, whose nodes are never taint-reporting sites; a null location trivially"],"additions":25,"deletions":0,"truncated":false},{"path":"src/Psalm/Internal/PhpVisitor/Reflector/FunctionLikeDocblockParser.php","lines":["@@ -29,6 +29,7 @@"," use function pathinfo;"," use function preg_last_error_msg;"," use function preg_match;","+use function preg_match_all;"," use function preg_replace;"," use function preg_split;"," use function reset;","@@ -265,8 +266,24 @@ public static function parse("," ","                 if ($param_parts[0]) {","                     $t = $codebase->getOrRegisterTaint($param_parts[0], $code_location);","+                    $keys = isset($param_parts[1]) && str_starts_with($param_parts[1], 'return[')","+                        ? self::parseReturnKeys($param_parts[1])","+                        : null;","+                    if ($keys === []) {","+                        // the whole of what is returned is a source, as the annotation says no key it can read","+                        $info->docblock_issues[] = new InvalidDocblock(","+                            '@psalm-taint-source expects keys of the return like return[\\'key\\'] in docblock for '","+                                . $cased_function_id,","+                            $code_location,","+                        );","+                    }","+","                     if ($t !== null) {","-                        $info->taint_source_types |= $t;","+                        if ($keys !== null && $keys !== []) {","+                            $info->taint_source_keys[] = [$keys, $t];","+                        } else {","+                            $info->taint_source_types |= $t;","+                        }","                     }","                 } else {","                     $info->docblock_issues[] = new InvalidDocblock(","@@ -617,6 +634,29 @@ public static function parse(","         return $info;","     }"," ","+    /**","+     * The keys of `return['key']['other']` (quoted with ' or \", or digits), outermost first, or [] if it isn't","+     * that","+     *","+     * @return list<string>","+     * @psalm-pure","+     */","+    private static function parseReturnKeys(string $target): array","+    {","+        if (preg_match('/^return((?:\\[(?:\\'[^\\'\\]]*\\'|\"[^\"\\]]*\"|\\d+)\\])+)$/', $target, $matches) !== 1) {","+            return [];","+        }","+","+        preg_match_all('/\\[([^\\]]*)\\]/', $matches[1], $key_matches);","+","+        $keys = [];","+        foreach ($key_matches[1] as $key) {","+            $keys[] = $key[0] === '\\'' || $key[0] === '\"' ? substr($key, 1, -1) : $key;","+        }","+","+        return $keys;","+    }","+","     /**","      * @psalm-pure","      * @param list<string> $line_parts"],"additions":41,"deletions":1,"truncated":false},{"path":"src/Psal