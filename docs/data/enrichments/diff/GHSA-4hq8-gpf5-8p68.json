fname","+    assert \"$output\" =~ 'invalid image env variable \"HOST\\*\"' \"Host env leak from image env on kube play\"","+","+    run_podman pod rm $podname","+    run_podman rmi $image","+}","+"," # vim: filetype=sh",""],"additions":52,"deletions":0,"truncated":false}],"additions":135,"deletions":7,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-09-25T13:31:01.826701+00:00"}