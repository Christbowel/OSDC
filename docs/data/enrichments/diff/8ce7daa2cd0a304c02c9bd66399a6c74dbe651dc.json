{"id":"8ce7daa2cd0a304c02c9bd66399a6c74dbe651dc","axis":"silent","repo":"swc-project/swc","sha":"8ce7daa2cd0a304c02c9bd66399a6c74dbe651dc","parsed":{"files":[{"path":".changeset/native-cache-user-namespace.md","lines":["@@ -0,0 +1,5 @@","+---","+swc_core: patch","+---","+","+fix(native): Allow Linux cache ancestors owned by an unmapped overflow UID while preserving directory permission checks."],"additions":5,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/src/platform/unix.rs","lines":["@@ -12,6 +12,9 @@ use std::{"," "," use crate::{Error, ErrorKind, Result};"," ","+#[cfg(target_os = \"linux\")]","+mod linux_cache_owner;","+"," #[cfg(target_os = \"macos\")]"," const STICKY_BIT: u32 = libc::S_ISVTX as u32;"," #[cfg(not(target_os = \"macos\"))]","@@ -71,6 +74,7 @@ pub fn executable_cache_root(root: &Path) -> Result<()> {"," /// world-writable sticky directory such as /tmp is safe only when it belongs"," /// to the effective user or root. A sticky directory owned by another user"," /// still lets that owner rename our private namespace after validation.","+/// On Linux, an unmapped overflow owner follows the same mode rules as root."," /// Trusted environments may explicitly skip this ancestor validation with"," /// `SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK=1`. Absolute paths, private"," /// cache entries, and executable-mount requirements are still enforced.","@@ -90,6 +94,9 @@ pub fn secure_cache_root(root: &Path) -> io::Result<()> {","         tracing::debug!(path = %root.display(), \"skipping native cache root security check by explicit environment opt-out\");","         return Ok(());","     }","+    let current = unsafe { libc::geteuid() };","+    #[cfg(target_os = \"linux\")]","+    let namespace = linux_cache_owner::CacheOwner::default();","     for directory in root.ancestors() {","         let metadata = fs::symlink_metadata(directory)?;","         if !metadata.is_dir() || metadata.file_type().is_symlink() {","@@ -98,7 +105,10 @@ pub fn secure_cache_root(root: &Path) -> io::Result<()> {","                 \"cache root contains a non-directory or symlink\",","             ));","         }","-        if !cache_ancestor_is_secure(metadata.mode(), metadata.uid(), unsafe { libc::geteuid() }) {","+        let owner = metadata.uid();","+        #[cfg(target_os = \"linux\")]","+        let owner = namespace.trusted_owner(owner, current);","+        if !cache_ancestor_is_secure(metadata.mode(), owner, current) {","             return Err(io::Error::new(","                 io::ErrorKind::PermissionDenied,","                 \"cache root has a parent writable by another user without trusted sticky \\"],"additions":11,"deletions":1,"truncated":false},{"path":"crates/swc_native_addon/src/platform/unix/linux_cache_owner.rs","lines":["@@ -0,0 +1,105 @@","+//! Trust an overflow owner only when it cannot identify a user in this","+//! namespace.","+","+use std::{cell::OnceCell, fs};","+","+/// Keep proc reads local to one validation: a later call may use another user","+/// namespace. Ordinary root/current-user ancestors never need these reads.","+#[derive(Default)]","+pub(super) struct CacheOwner {","+    unmapped_overflow: OnceCell<Option<u32>>,","+}","+","+impl CacheOwner {","+    pub(super) fn trusted_owner(&self, owner: u32, current: u32) -> u32 {","+        if owner == 0 || owner == current {","+            return owner;","+        }","+        let overflow = self.unmapped_overflow.get_or_init(|| {","+            let result = (|| {","+                let overflow = fs::read_to_string(\"/proc/sys/kernel/overflowuid\").ok()?;","+                let mapping = fs::read_to_string(\"/proc/self/uid_map\").ok()?;","+                unmapped_overflow_uid(&overflow, &mapping)","+            })();","+            tracing::debug!(?result, \"checked native cache overflow owner mapping\");","+            result","+        });","+        if *overflow == Some(owner) {","+            // An unmapped owner cannot chmod or rename the ancestor from this","+            // namespace. Apply root's mode rules, including sticky protection;","+            // this does not relax ownership checks on private cache entries.","+            0","+        } else {","+            owner","+        }","+    }","+}","+","+/// Validate every row before trusting the result. The first column contains","+/// namespace UIDs; the second contains parent-namespace UIDs and cannot tell us","+/// whether the overflow UID identifies a user in the current namespace.","+fn unmapped_overflow_uid(overflow: &str, mapping: &str) -> Option<u32> {","+    let overflow: u32 = overflow.trim().parse().ok()?;","+    if overflow == u32::MAX {","+        return None;","+    }","+    let mut found = false;","+    let mut mapped = false;","+    for line in mapping.lines() {","+        let mut fields = line.split_whitespace();","+        let inside: u32 = fields.next()?.parse().ok()?;","+        let outside: u32 = fields.next()?.parse().ok()?;","+        let count: u32 = fields.next()?.parse().ok()?;","+        if fields.next().is_some() || count == 0 {","+            return None;","+        }","+        let end = inside.checked_add(count)?;","+        outside.checked_add(count)?;","+        mapped |= (inside..end).contains(&overflow);","+        found = true;","+    }","+    (found && !mapped).then_some(overflow)","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn owner_mapping_fixtures() {","+        for line in include_str!(\"../../../tests/fixtures/linux-cache-owner.txt\").lines() {","+            if line.is_empty() || line.starts_with('#') {","+                continue;","+            }","+            let fields: Vec<_> = line.split('|').collect();","+            assert_eq!(fields.len(), 4, \"{line}\");","+            let mapping = fields[2].replace(';', \"\\n\");","+            let overflow = unmapped_overflow_uid(fields[1], &mapping);","+            let expected = match fields[3] {","+                \"trusted\" => Some(65534),","+                \"rejected\" => None,","+                _ => panic!(\"unknown owner fixture: {line}\"),","+            };","+            assert_eq!(overflow, expected, \"{}\", fields[0]);","+            let namespace = CacheOwner {","+                unmapped_overflow: OnceCell::from(overflow),","+            };","+            for (owner, trusted) in [","+                (0, true),","+                (1000, true),","+                (1001, false),","+                (65534, expected.is_some()),","+            ] {","+                let owner = namespace.trusted_owner(owner, 1000);","+                for mode in [0o0755, 0o0555, 0o1777] {","+                    assert_eq!(","+                        super::super::cache_ancestor_is_secure(mode, owner, 1000),","+                        trusted,","+                        \"{line}: {mode:o}\"","+                    );","+                }","+                assert!(!super::super::cache_ancestor_is_secure(0o0777, owner, 1000));","+            }","+        }","+    }","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/tests/fixtures/linux-cache-owner.txt","lines":["@@ -0,0 +1,23 @@","+# name|overflowuid|uid_map rows separated by semicolons|result","+single-user|65534|1000 1000 1|trusted","+initial-namespace|65534|0 0 4294967295|rejected","+multiple-unmapped|65534|1000 65534 1;2000 3000 10|trusted","+multiple-mapped|65534|1000 1000 1;65534 2000 1|rejected","+range-start|65534|65534 1000 2|rejected","+range-last|65534|65533 1000 2|rejected","+range-end-exclusive|65534|65533 1000 1|trusted","+range-above|65534|65535 1000 1|trusted","+empty-map|65534||rejected","+missing-field|65534|1000 1000|rejected","+extra-field|65534|1000 1000 1 2|rejected","+invalid-number|65534|invalid 1000 1|rejected","+zero-length|65534|1000 1000 0|rejected","+inside-overflow|65534|4294967294 0 2|rejected","+outside-overflow|65534|0 4294967294 2|rejected","+malformed-after-valid|65534|1000 1000 1;invalid|rejected","+malformed-after-mapped|65534|65534 1000 1;invalid|rejected","+empty-row|65534|1000 1000 1;;2000 2000 1|rejected","+invalid-overflow|invalid|1000 1000 1|rejected","+empty-overflow||1000 1000 1|rejected","+oversized-overflow|4294967296|1000 1000 1|rejected","+reserved-overflow|4294967295|1000 1000 1|rejected"],"additions":23,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/tests/fixtures/linux-user-namespace.txt","lines":["@@ -0,0 +1,5 @@","+# Native fixture loading without the security opt-out, with and without unshare.","+default","+custom","+temporary","+fallback"],"additions":5,"deletions":0,"truncated":false},{"path":"crates/swc_native_addon/tests/linux_user_namespace.rs","lines":["@@ -0,0 +1,113 @@","+#![cfg(target_os = \"linux\")]","+","+mod support;","+","+use std::{env, fs, os::unix::fs::MetadataExt, process::Command};","+","+use swc_native_addon::{","+    cache::{self, CacheMode},","+    format::Payload,","+    platform,","+};","+","+#[test]","+fn cache_loading_in_user_namespace() {","+    let available = Command::new(\"unshare\")","+        .args([\"--user\", \"--map-current-user\", \"true\"])","+        .output();","+    if !available","+        .as_ref()","+        .is_ok_and(|output| output.status.success())","+    {","+        assert!(","+            env::var_os(\"SWC_TEST_REQUIRE_USERNS\").is_none(),","+            \"user namespaces are required: {available:?}\"","+        );","+        eprintln!(","+            \"skipping user namespace cache fixture: unshare unavailable or forbidden: \\","+             {available:?}\"","+        );","+        return;","+    }","+    for namespaced in [false, true] {","+        let executable = env::current_exe().unwrap();","+        let mut command = if namespaced {","+            let mut command = Command::new(\"unshare\");","+            command","+                .args([\"--user\", \"--map-current-user\"])","+                .arg(&executable);","+            command","+        } else {","+            Command::new(&executable)","+        };","+        let output = command","+            .args([\"--exact\", \"cache_loading_worker\", \"--nocapture\"])","+            .env(\"SWC_TEST_USERNS_WORKER\", \"1\")","+            .env_remove(\"SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK\")","+            .env_remove(\"SWC_NATIVE_BINDING_CACHE\")","+            .output()","+            .unwrap();","+        assert!(","+            output.status.success(),","+            \"namespaced={namespaced}: {}{}\",","+            String::from_utf8_lossy(&output.stdout),","+            String::from_utf8_lossy(&output.stderr)","+        );","+    }","+}","+","+#[test]","+fn cache_loading_worker() {","+    if env::var_os(\"SWC_TEST_USERNS_WORKER\").is_none() {","+        return;","+    }","+    eprintln!(","+        \"uid_map: {}root owner: {} mode: {:o}\",","+        fs::read_to_string(\"/proc/self/uid_map\").unwrap(),","+        fs::metadata(\"/\").unwrap().uid(),","+        fs::metadata(\"/\").unwrap().mode()","+    );","+    let temporary = tempfile::tempdir().unwrap();","+    let root = temporary.path();","+    let home = root.join(\"home\");","+    let custom = root.join(\"custom\");","+    let blocked = root.join(\"blocked\");","+    fs::write(&blocked, b\"not a directory\").unwrap();","+    let bytes = support::packed();","+    let payload = Payload::parse(&bytes).unwrap();","+    let raw = fs::read(support::fixture()).unwrap();","+    for case in include_str!(\"fixtures/linux-user-namespace.txt\").lines() {","+        if case.is_empty() || case.starts_with('#') {","+            continue;","+        }","+        env::set_var(\"HOME\", &home);","+        env::set_var(\"XDG_CACHE_HOME\", &home);","+        env::set_var(\"TMPDIR\", \"/tmp\");","+        let (mode, selected) = match case {","+            \"default\" => (CacheMode::Default, home.clone()),","+            \"custom\" => (CacheMode::Custom(custom.clone()), custom.clone()),","+            \"temporary\" => (CacheMode::Temporary, home.clone()),","+            \"fallback\" => {","+                env::set_var(\"HOME\", &blocked);","+                env::set_var(\"XDG_CACHE_HOME\", &blocked);","+                (CacheMode::Default, \"/tmp\".into())","+            }","+            _ => panic!(\"unknown namespace fixture {case}\"),","+        };","+        let mut image = cache::materialize(&payload, &mode).unwrap();","+        assert!(","+            image.path().starts_with(","+                selected","+                    .join(platform::user_namespace().unwrap())","+                    .join(\"v1\")","+            ),","+            \"{case}\"","+        );","+        assert_eq!(fs::read(image.path()).unwrap(), raw, \"{case}\");","+        let path = image.path().to_owned();","+        let library = unsafe { libloading::Library::new(&path) }.unwrap();","+        image.loaded().unwrap();","+        assert_eq!(path.exists(), mode != CacheMode::Temporary, \"{case}\");","+        drop(library);","+    }","+}",""],"additions":113,"deletions":0,"truncated":false}],"additions":262,"deletions":1,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-16T14:18:48.302614+00:00"}