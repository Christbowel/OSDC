{"id":"2258e7a75ada3eeccb717ee25f4d570d6f080606","axis":"silent","repo":"solidjs/solid","sha":"2258e7a75ada3eeccb717ee25f4d570d6f080606","parsed":{"files":[{"path":".changeset/compiler-attribute-entity-semicolon.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@solidjs/compiler\": patch","+---","+","+The native compiler now decodes HTML entities in JSX attribute strings only when they end with `;`, as Babel does, so a static `href=\"/s?a=1&param=2\"` no longer becomes `/s?a=1¶m=2`; to match Babel, HTML5-only names (`&check;`, `&NewLine;`, `&AMP;`) and uppercase `&#X41;` stay literal, `&#0;` gives NUL, and a surrogate pair written as two references (`&#xD83D;&#xDE00;`) gives one character."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/compiler/__tests__/parity-probes.test.js","lines":["@@ -372,6 +372,18 @@ const b = <pre>{\"line1\"}"," `,","   \"html entities\": `"," const a = <div title=\"a&amp;b &lt;c&gt; &quot;d&quot;\">&nbsp;&lt;tag&gt; &amp;&amp; &#169; text</div>;","+`,","+  \"attribute entities without a semicolon stay literal\": `","+const a = <a href=\"/s?a=1&param=2&region=3\" title=\"&amp x &copy y &#65 &#x+41; &notit; &amp;\" style=\"content: '&copy'\">x</a>;","+`,","+  \"component prop entities without a semicolon stay literal\": `","+const a = <Comp href=\"/s?a=1&param=2&region=3\" title=\"&amp x &copy y &amp;\" />;","+`,","+  \"spread attribute entities without a semicolon stay literal\": `","+const a = <a {...props} href=\"/s?a=1&param=2&region=3\" title=\"&amp x &copy y &amp;\" style=\"content: '&copy'\">x</a>;","+`,","+  \"attribute surrogate pair references decode to one character\": `","+const a = <a title=\"&#xD83D;&#xDE00; &#55357;&#56832; &#xD83D;&#56832;\">x</a>;"," `,","   \"comment only child\": `"," const a = <div>{/* just a comment */}</div>;"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/compiler/src/dom/spread.rs","lines":["@@ -8,7 +8,7 @@ use crate::shared::array::expression_to_array_element;"," use cr