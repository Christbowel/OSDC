x).ok()?;","+    Some((code, digits[end..].strip_prefix(';')?))","+}","+"," pub(crate) fn format_attribute_value_with_quotes(value: &str, omit_quotes: bool) -> String {","     // Quoting need is decided on the unescaped text (as the Babel plugin","     // does); HTML escaping applies either way.","@@ -722,7 +769,24 @@ pub(crate) fn jsx_child_is_function_hole(child: &JSXChild<'_>) -> bool {"," "," #[cfg(test)]"," mod tests {","-    use super::format_number;","+    use super::{decode_jsx_attribute_entities, format_number};","+","+    #[test]","+    fn jsx_attribute_entities_keep_unrepresentable_references_literal() {","+        let value = \"&#xD800; &#xDE00; &#xD83D;&#65; &#x110000; &#1114112; &#99999999999;\";","+        assert_eq!(","+            decode_jsx_attribute_entities(value),","+            value.replace(\"&#65;\", \"A\")","+        );","+    }","+","+    #[test]","+    fn jsx_attribute_entities_decode_long_values_in_linear_time() {","+        let value = format!(\"{};\", \"&a\".repeat(1 << 16));","+        let started = std::time::Instant::now();","+        assert_eq!(decode_jsx_attribute_entities(&value), value);","+        assert!(started.elapsed() < std::time::Duration::from_secs(2));","+    }"," ","     /// Each pair is `String(value)` as Node prints it.","     #[test]"],"additions":65,"deletions":1,"truncated":false},{"path":"packages/compiler/src/ssr/transform.rs","lines":["@@ -33,8 +33,8 @@ use crate::shared::constants::{","     reserved_namespace,"," };"," use crate::shared::utils::{","-    child_slot_allocates_ids, decode_html_entities, element_name, escape_html_attribute,","-    escape_html_text_expression, expression_can_return_hydratable_child,","+    child_slot_allocates_ids, decode_html_entities, decode_jsx_attribute_entities, element_name,","+    escape_html_attribute, escape_html_text_expression, expression_can_return_hydratable_child,","     expression_is_function_shaped, format_number, is_component_name, is_void_element,","     normalize_