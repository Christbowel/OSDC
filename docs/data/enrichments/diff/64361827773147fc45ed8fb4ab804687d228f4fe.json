ermissions.forRoles(roles), roles: roles.map((name) => ({ name })) };","+}","+","+function loadApiKey(role: string | null) {","+  return {","+    permissions: role ? rolePermissions.forRoles([role]) : [],","+    roles: [role ? { name: role } : null],","+  };","+}","+","+const userView = (roles: string[]) =>","+  Object.freeze({","+    id: '1',","+    email: 'a@example.com',","+    name: 'A',","+    status: 'active',","+    roles: roles.map((name) => ({ id: `role-${name}`, name })),","+  });","+const keyView = (type: string, role: string | null) =>","+  Object.freeze({","+    id: 'key',","+    type,","+    user_id: null,","+    integration_id: 'integration',","+    role: role ? { id: `role-${role}`, name: role } : null,","+  });","+","+// Apps are always scoped; with every key in scope, the cap changes nothing","+const everyKey = Object.entries(permissionData).flatMap(([objectType, actions]) =>","+  actions.map((action) => `${objectType}:${action}`),","+);","+","+const staffRoles = ['Owner', 'Administrator', 'Super Editor', 'Editor', 'Author', 'Contributor'];","+const integrationRoles = rolePermissions.roleNames().filter((name) => name.endsWith('Integration'));","+","+interface Case {","+  name: string;","+  principal: Principal;","+  /** What canThis loaded for the same request before */","+  legacy: LoadedActors;","+}","+","+const cases: Case[] = [];","+","+for (const role of [...staffRoles, ...integrationRoles, 'Unknown Role']) {","+  const user = loadUser([role]);","+  cases.push({","+    name: `${role} session`,","+    principal: { kind: 'user', method: 'session', user: userView([role]) },"],"additions":96,"deletions":0,"truncated":false}],"additions":561,"deletions":72,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-19T17:58:23.745968+00:00"}