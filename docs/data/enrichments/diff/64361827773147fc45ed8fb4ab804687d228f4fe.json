l([...app.granted], ['post:read']);","+      assert.deepEqual(app.scopes, new Set(['post:read']));","+    });","+","+    it('grants an app acting for a user that user’s grants, capped by its scopes', function () {","+      const app = capabilities(appPrincipal(['Editor'], ['post:read']));","+      assert.deepEqual(app.granted, capabilities(user(['Editor'])).granted);","+      assert.deepEqual(app.scopes, new Set(['post:read']));","+    });","+","+    it('expands a wildcard scope to every action of its type', function () {","+      const { scopes } = capabilities(integration(null, ['webhook:*', 'tag:read', 'nope:*']));","+      assert.deepEqual(","+        scopes,","+        new Set(['webhook:add', 'webhook:edit', 'webhook:destroy', 'tag:read']),","+      );","+      assert.deepEqual(","+        [...capabilities(appPrincipal(null, ['webhook:*'])).granted],","+        ['webhook:add', 'webhook:edit', 'webhook:destroy'],","+      );","+    });","+","+    it('gives a whole wildcard only; extra fields grant nothing', function () {","+      const { scopes } = capabilities(integration(null, ['post:*:extra', 'post:edit:extra']));","+      assert.deepEqual(scopes, new Set(['post:*:extra', 'post:edit:extra']));","+      assert.equal(scopesAllow(scopes, 'post:edit'), false);","+    });","+","+    it('allows an app nothing when its scopes are missing', function () {","+      const actingForOwner = capabilities(appPrincipal(['Owner'], undefined));","+      assert.deepEqual(actingForOwner.scopes, new Set());","+      assert.deepEqual(capabilities(appPrincipal(null, undefined)).granted, new Set());","+    });","+","+    it('scopes a token principal by its scopes', function () {","+      assert.deepEqual(capabilities(user(['Owner'], ['tag:edit'])).scopes, new Set(['tag:edit']));","+      assert.deepEqual(capabilities(integration(null, [])).scopes, new Set());","+    });","+  });","+","+  describe('scopes', function () {","+    it('allows everything when unlimited', function () {","+