kind: 'internal' } }).edit.tag(), {","         errorType: 'NoPermissionError',","       });","     });"],"additions":46,"deletions":6,"truncated":false},{"path":"ghost/test/unit/server/auth/policy/authorize.test.ts","lines":["@@ -0,0 +1,169 @@","+import assert from 'node:assert/strict';","+import { authorize } from '../../../../../core/server/auth/policy/authorize';","+import { capabilities } from '../../../../../core/server/auth/policy/capabilities';","+import { rowRules } from '../../../../../core/server/auth/policy/rules';","+import { scopesAllow } from '../../../../../core/server/auth/policy/scopes';","+import type { Principal } from '../../../../../core/server/auth/principal';","+","+const roleViews = (roles: string[]) => roles.map((name) => ({ id: `role-${name}`, name }));","+const userView = (roles: string[]) => ({","+  id: '1',","+  email: 'a@example.com',","+  name: 'A',","+  status: 'active',","+  roles: roleViews(roles),","+});","+const user = (roles: string[], scopes?: string[]): Principal => ({","+  kind: 'user',","+  method: 'session',","+  user: userView(roles),","+  ...(scopes ? { scopes } : {}),","+});","+const integration = (role: string | null, scopes?: string[]): Principal => ({","+  kind: 'integration',","+  method: role ? 'admin_api_key' : 'content_api_key',","+  apiKey: {","+    id: 'key',","+    type: role ? 'admin' : 'content',","+    user_id: null,","+    integration_id: 'integration',","+    role: role ? { id: `role-${role}`, name: role } : null,","+  },","+  integration: null,","+  ...(scopes ? { scopes } : {}),","+});","+const appPrincipal = (roles: string[] | null, scopes: string[] | undefined): Principal => ({","+  kind: 'app',","+  method: roles ? 'oauth_authorization_code' : 'oauth_client_credentials',","+  app: { id: 'installation' },","+  actingFor: roles ? userView(roles) : null,","+  scopes: scopes as string[],","+});","+","+const noPermission = { errorType: 'NoPermissionError' };","+","+describe('Authorization policy', function 