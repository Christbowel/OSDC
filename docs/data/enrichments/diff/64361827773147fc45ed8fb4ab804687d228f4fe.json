nted = capabilities(principal).granted.has(capabilityKey(objType, actType));"," ","-  // Check api key permissions if they were passed","-  hasApiKeyPermission = true;","-  if (!_.isNull(apiKeyPermissions)) {","-    if (loadedPermissions.user) {","-      // Staff API key scenario: both user and API key present","-      // Use USER permissions and ignore API key permissions","-      hasApiKeyPermission = true; // Allow API key check to pass","-    } else {","-      // Traditional API key scenario: API key only, no user","-      // Use API key permissions as before","-      hasUserPermission = true;","-      hasApiKeyPermission = _.some(apiKeyPermissions, checkPermission);","-    }","+  // An integration key's grant is the key's flag; every other principal's is the user's","+  if (principal.kind === 'integration') {","+    return { hasUserPermission: true, hasApiKeyPermission: granted };","   }","-","-  return { hasUserPermission, hasApiKeyPermission };","+  return { hasUserPermission: granted, hasApiKeyPermission: true };"," }"," "," function rolePermissions(roles: readonly RoleView[]): LoadedPermissions {","@@ -173,11 +145,9 @@ class CanThisResultBuilder {","             return Promise.resolve();","           }"," ","-          // Until scopes are enforced (PLA-639), an app is only ever the user it acts for","+          // Until PLA-639, an app needs a user to act for, whatever its scopes","           if (isAppWithoutUser(context)) {","-            return Promise.reject(","-              new errors.NoPermissionError({ message: tpl(messages.noPermissionToAction) }),","-            );","+            return Promise.reject(noPermission());","           }"," ","           if (_.isNumber(modelOrId) || _.isString(modelOrId)) {","@@ -192,38 +162,42 @@ class CanThisResultBuilder {","             return Promise.reject(actors);","           }"," ","-          return Promise.resolve(actors).then(function (loadedPermissions) {","-            const { hasUserPermission, hasApiKeyPermission } = getGrantFlags(","-              loadedPermissions,","-              actType,","-              objType,","-            );","+          // Only `context.internal` grants everything, never a principal claiming it","+          const principal =","+            !context.principal || context.principal.kind === 'internal'","+              ? ANONYMOUS","+              : context.principal;"," ","-            // Ensure permission decisions are based on the user's role if present, not their staff-token.","-            const permissionsForModel = loadedPermissions.user","-              ? { ...loadedPermissions, apiKey: null }","-              : loadedPermissions;","+          return Promise.resolve(actors).then(function (loadedPermissions) {","+            // Scopes cap the hooks as they will cap row rules; unscoped principals pass","+            const { scopes } = capabilities(principal);","+            if (!scopesAllow(scopes, capabilityKey(objType, actType))) {","+              return Promise.reject(noPermission());","+            }"," ","             // Offer a chance for the TargetModel to override the results","             if (TargetModel && _.isFunction(TargetModel.permissible)) {","+              const { hasUserPermission, hasApiKeyPermission } = getGrantFlags(","+                principal,","+                actType,","+                objType,","+              );","+","               return TargetModel.permissible(","                 modelId,","                 actType,","                 context,","                 unsafeAttrs,","-                permissionsForModel,","+                loadedPermissions,","                 hasUserPermission,","                 hasApiKeyPermission,","               );","             }"," ","-            if (hasUserPermission && hasApiKeyPermission) {","-              return;","-            }","-","-            return Promise.reject(","-              new errors.NoPermissionError({ message: tpl(messages.noPermissionToAction) }),","-            );","+            return authorize(principal, actType, objType, {","+              resource: modelId,","+              attrs: unsafeAttrs,","+            }).then(toCheckResult);","           });","         };"," "],"additions":40,"deletions":66,"truncated":false},{"path":"ghost/core/server/auth/policy/authorize.ts","lines":["@@ -0,0 +1,59 @@","+import errors from '@tryghost/errors';","+import tpl from '@tryghost/tpl';","+import type { Principal } from '../principal';","+import { capabilities, capabilityKey } from './capabilities';","+import { rowRules } from './rules';","+import { scopesAllow } from './scopes';","+","+const messages = {","+  noPermissionToAction: 'You do not have permission to perform this action',","+};","+","+export interface AuthorizeOptions {","+  /** The resource, or its id, when the check is for one */","+  resource?: unknown;","+  /** The request's `unsafeAttrs` */","+  attrs?: Record<string, unknown>;","+}","+","+/** An allowed request; the endpoint strips `excludedAttrs` before the write. */","+export interface Allowed {","+  excludedAttrs?: string[];","+}","+","+export function noPermission() {","+  return new errors.NoPermissionError({ message: tpl(messages.noPermissionToAction) });","+}","+","+/**","+ * Resolves when the principal may take the action, and throws otherwise. A","+ * row rule for the type decides, and can narrow or widen the grant, but is","+ * only reached when the scopes allow the key.","+ */","+export async function authorize(","+  principal: Principal,","+  action: string,","+  objectType: string,","+  { resource, attrs = {} }: AuthorizeOptions = {},","+): Promise<Allowed> {","+  if (principal.kind === 'internal') {","+    return {};","+  }","+","+  const { granted, scopes } = capabilities(principal);","+  const key = capabilityKey(objectType, action);","+","+  if (!scopesAllow(scopes, key)) {","+    throw noPermission();","+  }","+","+  if (Object.hasOwn(rowRules, objectType)) {","+    return rowRules[objectType]({ principal, action, granted: granted.has(key), resource, attrs });","+  }","+","+  if (!granted.has(key)) {","+    throw noPermission();","+  }","+","+  return {};","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/policy/capabilities.ts","lines":["@@ -0,0 +1,118 @@","+import { permissions as permissionData } from '../permissions/permissions-data';","+import * as rolePermissions from '../permissions/role-permissions';","+import type { Principal, RoleView, Scopes } from '../principal';","+","+/** An `object_type:action` key, such as `post:edit`. */","+export type Capability = `${string}:${string}`;","+","+export interface Capabilities {","+  /** The keys the principal's roles grant, or an app's scopes when it has no user */","+  granted: ReadonlySet<Capability>;","+  /** The keys its token and app scopes allow, or `unlimited` when it has neither */","+  scopes: ReadonlySet<Capability> | 'unlimited';","+}","+","+export function capabilityKey(objectType: string, action: string): Capability {","+  return `${objectType}:${action}`;","+}","+","+const ALL: ReadonlySet<Capability> = new Set(","+  Object.entries(permissionData).flatMap(([objectType, actions]) =>","+    actions.map((action) => capabilityKey(objectType, action)),","+  ),","+);","+","+const NONE: ReadonlySet<Capability> = new Set();","+","+// Grants are code, so each role's keys are built once at import","+const byRole = new Map<string, ReadonlySet<Capability>>(","+  rolePermissions","+    .roleNames()","+    .map((name) => [","+      name,","+      new Set(","+        rolePermissions","+          .forRoles([name])","+          .map((perm) => capabilityKey(perm.object_type, perm.action_type)),","+      ),","+    ]),","+);","+","+function roleGrants(roles: readonly string[]): ReadonlySet<Capability> {","+  return roles.reduce((all, role) => all.union(byRole.get(role) ?? NONE), NONE);","+}","+","+/** A staff user's grants; Owner is granted every key. */","+function staffGrants(roles: readonly string[]): ReadonlySet<Capability> {","+  return roles.includes('Owner') ? ALL : roleGrants(roles);","+}","+","+/** Scopes as exact keys; `post:*` expands to every action of that type. */","+function toKeys(scopes: Scopes | null | undefined): ReadonlySet<Capability> {","+  // Missing scopes allow nothing, whatever the type promises","+  if (!Array.isArray(scopes)) {","+    return NONE;","+  }","+  return new Set(","+    scopes.flatMap((scope): Capability[] => {","+      const parts = scope.split(':');","+      // Only a whole `type:*` is a wildcard; anything else must match a key exactly","+      if (parts.length !== 2 || parts[1] !== '*') {","+        return [scope as Capability];","+      }","+      const [objectType] = parts;","+      const actions: readonly string[] = Object.hasOwn(permissionData, objectType)","+        ? permissionData[objectType as keyof typeof permissionData]","+        : [];","+      return actions.map((each) => capabilityKey(objectType, each));","+    }),","+  );","+}","+","+const names = (roles: readonly RoleView[]) => roles.map((role) => role.name);","+","+function granted(principal: Principal): ReadonlySet<Capability> {","+  switch (principal.kind) {","+    case 'internal':","+      return ALL;","+    case 'anonymous':","+      return NONE;","+    case 'user':","+      return staffGrants(names(principal.user.roles));","+    // A legacy key takes its integration role's grants, with no Owner bypass","+    case 'integration':","+      return principal.apiKey.role ? roleGrants([principal.apiKey.role.name]) : NONE;","+    // With no user to act for, an app is granted exactly its scopes","+    case 'app':","+      return principal.actingFor","+        ? staffGrants(names(principal.actingFor.roles))","+        : toKeys(principal.scopes);","+  }","+}","+","+// Only one scope source exists per principal today; app tokens will intersect theirs here","+function scopeLimit(principal: Principal): Capabilities['scopes'] {","+  if (principal.kind === 'internal' || principal.kind === 'anonymous') {","+    return 'unlimited';","+  }","+  // An app is always scoped, so missing scopes mean no access rather than none to apply","+  if (principal.kind === 'app') {","+    return toKeys(principal.scopes);","+  }","+  return principal.scopes ? toKeys(principal.scopes) : 'unlimited';","+}","+","+// Keyed on the principal object, which is frozen once per request","+const memo = new WeakMap<Principal, Capabilities>();","+","+/** The keys the principal is granted and the keys its scopes allow. */","+export function capabilities(principal: Principal): Capabilities {","+  let result = memo.get(principal);","+","+  if (!result) {","+    result = Object.freeze({ granted: granted(principal), scopes: scopeLimit(principal) });","+    memo.set(principal, result);","+  }","+","+  return result;","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/policy/rules/index.ts","lines":["@@ -0,0 +1,20 @@","+import type { Allowed } from '../authorize';","+import type { Principal } from '../../principal';","+","+export interface RowRuleInput {","+  principal: Principal;","+  action: string;","+  /** Whether the principal's grants hold the key; the rule may narrow or widen it */","+  granted: boolean;","+  resource?: unknown;","+  attrs: Record<string, unknown>;","+}","+","+/** Decides one object type's requests; resolves when allowed and throws otherwise. */","+export type RowRule = (input: RowRuleInput) => Promise<Allowed>;","+","+/**","+ * Row rules by object type. Empty until the model `permissible` hooks move","+ * here, one model at a time.","+ */","+export const rowRules: Readonly<Record<string, RowRule>> = Object.freeze({});"],"additions":20,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/policy/scopes.ts","lines":["@@ -0,0 +1,6 @@","+import type { Capabilities, Capability } from './capabilities';","+","+/** Whether the scopes allow the key. Finer scopes come with PLA-639. */","+export function scopesAllow(scopes: Capabilities['scopes'], key: Capability): boolean {","+  return scopes === 'unlimited' || scopes.has(key);","+}"],"additions":6,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/auth/permissions/can-this.test.ts","lines":["@@ -7,6 +7,7 @@ import testUtils from '../../../../utils';"," import models = require('../../../../../core/server/models');"," import type permissionsType from '../../../../../core/server/auth/permissions';"," import type * as limitsType from '../../../../../core/server/services/limits';","+import { toCheckResult } from '../../../../../core/server/auth/permissions/can-this';"," "," // require(), not import: the stubs must patch the instances the models load"," const permissions: typeof permissionsType = require('../../../../../core/server/auth/permissions');","@@ -430,7 +431,7 @@ describe('Permissions', function () {","       sinon.assert.notCalled(permissibleStub);","     });"," ","-    const actingFor = (roles: string[]) => ({","+    const appFor = (scopes: string[], roles = ['Administrator']) => ({","       user: '1',","       // A stale key beside the app is never used","       api_key: { id: 'key', type: 'admin' },","@@ -439,17 +440,56 @@ describe('Permissions', function () {","         method: 'oauth_authorization_code',","         app,","         actingFor: userView(roles),","-        scopes: [],","+        scopes,","       },","     });"," ","-    // Interim, until PLA-639 enforces scopes: the empty scopes here must deny once it lands","-    it('treats an app acting for a user as that user, ignoring any key', async function () {","-      assert.equal(await canThis(actingFor(['Administrator'])).edit.tag({ id: 1 }), undefined);","+    it('treats an app acting for a user as that user, within its scopes, ignoring any key', async function () {","+      assert.equal(await canThis(appFor(['tag:edit'])).edit.tag({ id: 1 }), undefined);","     });"," ","     it('refuses an 