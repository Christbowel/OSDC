","+","+        [Fact]","+        public void DecodingDoesNotWritePastDestinationBoundaries()","+        {","+            const byte Sentinel = 0xA5;","+            const int MaxSourceLength = 300;","+","+            byte[] rawData = Enumerable.Range(0, Base64Url.GetMaxDecodedLength(MaxSourceLength))","+                .Select(i => (byte)((i % 127) + 1))","+                .ToArray();","+","+            for (int sourceLength = 1; sourceLength <= MaxSourceLength; sourceLength++)","+            {","+                int maxDecodedLength = Base64Url.GetMaxDecodedLength(sourceLength);","+                int minimumDestinationLength = Math.Max(0, maxDecodedLength - 3);","+                int validSourceLength = (sourceLength & 0x3) == 1 ? sourceLength - 1 : sourceLength;","+                byte[] utf8Source = new byte[sourceLength];","+                char[] charSource = new char[sourceLength];","+                byte[] reference = new byte[maxDecodedLength];","+","+                Assert.Equal(","+                    OperationStatus.Done,","+                    Base64Url.EncodeToUtf8(","+                        rawData.AsSpan(0, maxDecodedLength),","+                        utf8Source.AsSpan(0, validSourceLength),","+                        out int rawConsumed,","+                        out int encodedWritten));","+                Assert.Equal(maxDecodedLength, rawConsumed);","+                Assert.Equal(validSourceLength, encodedWritten);","+","+                if (validSourceLength != sourceLength)","+                {","+                    utf8Source[validSourceLength] = (byte)'A';","+                }","+","+                for (int i = 0; i < sourceLength; i++)","+                {","+                    charSource[i] = (char)utf8Source[i];","+                }","+","+                OperationStatus referenceStatus = Base64Url.DecodeFromUtf8(","+                    utf8Source,","+                    reference,","+                    out int referenceConsumed,","