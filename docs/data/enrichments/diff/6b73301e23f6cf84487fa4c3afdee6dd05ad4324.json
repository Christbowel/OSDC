@ mongo_cc_unit_test(","     tags = [\"mongo_unittest_third_group\"],","     deps = [","         \":end_of_transaction_parameter\",","+        \"//src/mongo/db/commands/server_status:server_status_metric\",","         \"//src/mongo/unittest\",","         \"//src/mongo/unittest:server_parameter_guard\",","     ],"],"additions":3,"deletions":0,"truncated":false},{"path":"src/mongo/db/change_stream_metrics_util.h","lines":["@@ -13,6 +13,7 @@"," #include \"mongo/util/modules.h\""," "," #include <cstdint>","+#include <string_view>"," #include <vector>"," "," #include <boost/optional.hpp>","@@ -489,4 +490,232 @@ inline otel::metrics::UpDownCounter<int64_t>& createShardTargetingDegradedGauge(","         opts);"," }"," ","+// --- End-of-transaction (EOT) change stream metrics ---","+//","+// All accessors use function-local statics; the eager-registration block in","+// 'document_source_change_stream.cpp' touches them at static-init time so they are visible in","+// serverStatus at zero. A successful rebuild must bump 'endOfTransactionRebuildsSucceeded()' and","+// record its latency into 'endOfTransactionRebuildTimeMicros()' together; a failed rebuild records","+// neither.","+","+inline otel::metrics::Counter<int64_t>& endOfTransactionRebuildsSucceeded() {","+    static auto& counter = []() -> otel::metrics::Counter<int64_t>& {","+        otel::metrics::CounterOptions opts{};","+        opts.serverStatusOptions = otel::metrics::ServerStatusOptions{","+            .dottedPath = \"changeStreams.endOfTransaction.rebuilds.succeeded\",","+            .role = ::mongo::ClusterRole{::mongo::ClusterRole::RouterServer},","+        };","+        return otel::metrics::MetricsService::instance().createInt64Counter(","+            otel::metrics::MetricNames::kChangeStreamEndOfTransactionRebuildsSucceeded,","+            \"Number of on-demand end-of-transaction rebuilds that completed the resume at the \"","+            \"consumer's position.\",","+            otel::metrics::MetricUnit::kEvents,","+            opts);","+    }();","+    return counter;","+}","+","+inline otel::metrics::Counter<int64_t>& endOfTransactionRebuildsFailed() {","+    static auto& counter = []() -> otel::metrics::Counter<int64_t>& {","+        otel::metrics::CounterOptions opts{};","+        opts.serverStatusOptions = otel::metrics::ServerStatusOptions{","+            .dottedPath = \"changeStreams.endOfTransaction.rebuilds.failed\",","+            .role = ::mongo::ClusterRole{::mongo::ClusterRole::RouterServer},","+        };","+        return otel::metrics::MetricsService::instance().createInt64Counter(","+            otel::metrics::MetricNames::kChangeStreamEndOfTransactionRebuildsFailed,","+            \"Number of end-of-transaction rebuilds that reached the rebuild cap and failed the \"","+            \"stream.\",","+            otel::metrics::MetricUnit::kEvents,","+            opts);","+    }();","+    return counter;","+}","+","+inline otel::metrics::Histogram<int64_t>& endOfTransactionRebuildTimeMicros() {","+    static auto& histogram = []() -> otel::metrics::Histogram<int64_t>& {","+        otel::metrics::HistogramOptions opts{};","+        opts.serverStatusOptions = otel::metrics::ServerStatusOptions{","+            .dottedPath = \"changeStreams.endOfTransaction.rebuildTimeMicros\",","+            .role = ::mongo::ClusterRole{::mongo::ClusterRole::RouterServer},","+        };","+        // Successful rebuilds only: from catching the lookback kickback to the rebuilt stream","+        // having resumed at the consumer's resume position. Spans a cheap kickback to a slow","+        // oplog re-scan. Kept under the 10-bucket cap requested by MaaS.","+        opts.serializationFormat = otel::metrics::HistogramSerializationFormat::kBucketCounts;","+        opts.explicitBucketBoundaries = std::vector<double>({1e3, 1e4, 1e5, 1e6, 1e7, 1e8});","+        return otel::metrics::MetricsService::instance().createInt64Histogram(","+            otel::metrics::MetricNames::kChangeStreamEndOfTransactionRebuildTimeMicros,","+            \"Latency of successful end-of-transaction rebuilds in microseconds.\",","+            otel::metrics::MetricUnit::kMicroseconds,","+            opts);","+    }();","+    return histogram;","+}","+","+inline otel::metrics::Counter<int64_t>& endOfTransactionSynthesisTransactionsEvicted() {","+    static auto& counter = []() -> otel::metrics::Counter<int64_t>& {","+        otel::metrics::CounterOptions opts{};","+        opts.serverStatusOptions = otel::metrics::ServerStatusOptions{","+            .dottedPath = \"changeStreams.endOfTransaction.synthesis.transactions.evicted\",","+            .role = ::mongo::ClusterRole{::mongo::ClusterRole::RouterServer},","+        };","+        return otel::metrics::MetricsService::instance().createInt64Counter(","+            otel::metrics::MetricNames::kChangeStreamEndOfTransactionSynthesisTransactionsEvicted,","+            \"Number of tracked transactions evicted because an expected participant's accounting \"","+            \"record was never observed (whenAvailable disposition: event silently omitted).\",","+            otel::metrics::MetricUnit::kEvents,","+            opts);","+    }();","+    return counter;","+}","+","+inline otel::metrics::Counter<int64_t>& endOfTransactionSynthesisPbrtBumps() {","+    static auto& counter = []() -> otel::metrics::Counter<int64_t>& {","+        otel::metrics::CounterOptions opts{};","+        opts.serverStatusOptions = otel::metrics::ServerStatusOptions{","+            .dottedPath = \"changeStreams.endOfTransaction.synthesis.pbrtBumps\",","+            .role = ::mongo::ClusterRole{::mongo::ClusterRole::RouterServer},","+        };","+        return otel::metrics::MetricsService::instance().createInt64Counter(","+            otel::metrics::MetricNames::kChangeStreamEndOfTransactionSynthesisPbrtBumps,","+            \"Number of explicit advances of the client-visible post-batch resume token to the \"","+            \"emitted end-of-transaction token.\",","+            otel::metrics::MetricUnit::kEvents,","+            opts);","+    }();","+    return counter;","+}","+","+inline otel::metrics::UpDownCounter<int64_t>& endOfTransactionSynthesisTransactionsTracked() {","+    static auto& counter = []() -> otel::metrics::UpDownCounter<int64_t>& {","+        otel::metrics::UpDownCounterOptions opts{};","+        opts.serverStatusOptions = otel::metrics::ServerStatusOptions{","+            .dottedPath = \"changeStreams.endOfTransaction.synthesis.transactions.tracked\",","+            .role = ::mongo::ClusterRole{::mongo::ClusterRole::RouterServer},","+        };","+        return otel::metrics::MetricsService::instance().createInt64UpDownCounter(","+            otel::metrics::MetricNames::kChangeStreamEndOfTransactionSynthesisTransactionsTracked,","+            \"Current number of transaction state entries held by router-side end-of-transaction \"","+            \"aggregators, summed across all open change streams.\",","+            otel::metrics::MetricUnit::kCount,","+            opts);","+    }();","+    return counter;","+}","+","+inline otel::metrics::Counter<int64_t>& endOfTransactionCompletedWithRemovedShards() {","+    static auto& counter = []() -> otel::metrics::Counter<int64_t>& {","+        otel::metrics::CounterOptions opts{};"],"additions":118,"deletions":0,"truncated":false}],"additions":333,"deletions":75,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-26T18:56:48.663405+00:00"}