{"id":"2f6f7861ba075b72b530b3d0b7889fc55b500ae4","axis":"silent","repo":"vllm-project/vllm","sha":"2f6f7861ba075b72b530b3d0b7889fc55b500ae4","parsed":{"files":[{"path":".buildkite/test_areas/kernels.yaml","lines":["@@ -43,6 +43,7 @@ steps:","   - vllm/kernels/triton/","   - tests/kernels/test_concat_mla_q.py","   - tests/kernels/test_fused_qk_norm_rope_gate.py","+  - vllm/model_executor/layers/fused_qk_norm_rope.py","   commands:","     - >-","       pytest -v -s","@@ -73,6 +74,7 @@ steps:","       - vllm/_aiter_ops.py","       - vllm/platforms/rocm.py","       - tests/kernels/test_fused_qk_norm_rope_gate.py","+      - vllm/model_executor/layers/fused_qk_norm_rope.py","       commands:","       - >-","         pytest -v -s"],"additions":2,"deletions":0,"truncated":false},{"path":"tests/kernels/fla/test_chunk_int64_offsets.py","lines":["@@ -0,0 +1,116 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"FLA chunk kernels on batches whose offsets do not fit in int32.\"\"\"","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+from vllm.third_party.flash_linear_attention.ops.chunk_delta_h import (","+    chunk_gated_delta_rule_fwd_h,","+)","+from vllm.third_party.flash_linear_attention.ops.solve_tril import solve_tril","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_cuda_alike(), reason=\"needs a GPU\"","+)","+","+BT = 64","+","+","+def _skip_if_low_memory(need: int) -> None:","+    free, _ = current_platform.mem_get_info()","+    if free < need + (1 << 30):","+        pytest.skip(\"not enough free device memory\")","+","+","+@torch.inference_mode()","+def test_chunk_delta_h_int64_seq_offset():","+    \"\"\"A later sequence's start offsets need int64.","+","+    The second sequence starts at token 2^31 // (H * V), so its v, w and v_new","+    offsets (bos * H * V) and its h offset (chunk * H * V * K) pass 2^31.","+    \"\"\"","+    H, Hg, K, V = 64, 16, 128, 128","+    L1, L2 = 2**31 // (H * V), 2 * BT","+    T = L1 + L2","+    # k, w, u, v_new and h, all bf16.","+    _skip_if_low_memory(T * (Hg * K + 3 * H * V) * 2 + T // BT * H * V * K * 2)","+","+    device = torch.device(\"cuda\")","+    gen = torch.Generator(device=device).manual_seed(0)","+","+    def randn(*shape, scale=1.0):","+        x = torch.randn(*shape, device=device, generator=gen, dtype=torch.bfloat16)","+        return x.mul_(scale)","+","+    k = randn(1, T, Hg, K, scale=0.09)","+    w = randn(1, T, H, K, scale=0.05)","+    u = randn(1, T, H, V)","+    # Chunk-local cumulative log decay, as chunk_local_cumsum produces it.","+    g = torch.rand(1, T // BT, BT, H, device=device, generator=gen) * -0.05","+    g = g.cumsum(2).view(1, T, H)","+    h0 = torch.randn(2, H, V, K, device=device, generator=gen) * 0.1","+    cu_seqlens = torch.tensor([0, L1, T], dtype=torch.int32, device=device)","+","+    h, v_new, ht = chunk_gated_delta_rule_fwd_h(","+        k,","+        w,","+        u,","+        g=g,","+        initial_state=h0,","+        output_final_state=True,","+        cu_seqlens=cu_seqlens,","+    )","+","+    # Reference: the second sequence on its own, where its offsets are 0.","+    h_ref, v_new_ref, ht_ref = chunk_gated_delta_rule_fwd_h(","+        k[:, L1:].contiguous(),","+        w[:, L1:].contiguous(),","+        u[:, L1:].contiguous(),","+        g=g[:, L1:].contiguous(),","+        initial_state=h0[1:].contiguous(),","+        output_final_state=True,","+        cu_seqlens=torch.tensor([0, L2], dtype=torch.int32, device=device),","+    )","+    assert v_new is not None and ht is not None","+    assert v_new_ref is not None and ht_ref is not None","+    torch.testing.assert_close(h[:, L1 // BT :], h_ref, atol=0, rtol=0)","+    torch.testing.assert_close(v_new[:, L1:], v_new_ref, atol=0, rtol=0)","+    torch.testing.assert_close(ht[1:], ht_ref, atol=0, rtol=0)","+","+","+@torch.inference_mode()","+def test_solve_tril_int64_offsets():","+    \"\"\"Rows past 2^31 // (H * BT) need int64 offsets.","+","+    The first sequence runs past row 2^31 // (H * BT), which the per-row loads","+    reach, and the second sequence starts past it, which the base offset","+    (bos * H * BT) reaches.","+    \"\"\"","+    H = 64","+    L1, L2 = 2**31 // (H * BT) + 2 * BT, 2 * BT","+    T = L1 + L2","+    # A in fp32 and its inverse in bf16.","+    _skip_if_low_memory(T * H * BT * (4 + 2))","+","+    device = torch.device(\"cuda\")","+    gen = torch.Generator(device=device).manual_seed(0)","+    # Strictly lower triangular inside each chunk of BT rows.","+    A = torch.randn(1, T, H, BT, device=device, generator=gen).mul_(0.1)","+    mask = torch.ones(BT, BT, device=device).tril(-1)","+    A.view(1, T // BT, BT, H, BT).mul_(mask[:, None, :])","+    cu_seqlens = torch.tensor([0, L1, T], dtype=torch.int32, device=device)","+","+    Ai = solve_tril(A, cu_seqlens=cu_seqlens, output_dtype=torch.bfloat16)","+","+    # Chunks are independent, so the last two chunks of each sequence on","+    # their own are the reference.","+    for end in (L1, T):","+        start = end - 2 * BT","+        ref = solve_tril(","+            A[:, start:end].contiguous(),","+            cu_seqlens=torch.tensor([0, 2 * BT], dtype=torch.int32, device=device),","+            output_dtype=torch.bfloat16,","+        )","+        torch.testing.assert_close(Ai[:, start:end], ref, atol=0, rtol=0)"],"additions":116,"deletions":0,"truncated":false},{"path":"tests/kernels/fla/test_fla_layernorm_guard.py","lines":["@@ -545,6 +545,39 @@ def test_rmsnorm_gated_3d_matches_flattened_2d(","     assert cuda_3d.shape == (num_tokens, num_heads, head_dim)"," "," ","+@torch.inference_mode()","+def test_rmsnorm_gated_int64_row_offset() -> None:","+    \"\"\"Rows past 2^31 // row stride need int64 offsets.","+","+    Mirrors RMSNormGated on the GDN output: [num_tokens, num_heads, 128]","+    flattened to rows of 128, so tokens from 2^31 // (num_heads * 128) on","+    (262,144 for 64 heads) wrap in int32.","+    \"\"\"","+    num_heads, head_dim = 64, 128","+    num_tokens = 2**31 // (num_heads * head_dim) + 4","+    # x, z and the output, all bf16.","+    need = num_tokens * num_heads * head_dim * 2 * 3","+    free, _ = current_platform.mem_get_info()","+    if free < need + (1 << 30):","+        pytest.skip(\"not enough free device memory\")","+","+    set_random_seed(0)","+    device = torch.device(DEVICE)","+    shape = (num_tokens, num_heads, head_dim)","+    x = torch.randn(shape, dtype=torch.bfloat16, device=device)","+    z = torch.randn(shape, dtype=torch.bfloat16, device=device)","+    weight = torch.randn(head_dim, dtype=torch.bfloat16, device=device)","+","+    out = layernorm_fn(","+        x, weight, None, z=z, eps=1e-6, norm_before_gate=True, is_rms_norm=True","+    )","+","+    # Reference on the first token and the last tokens, past the int32 boundary.","+    rows = torch.tensor([0, *range(num_tokens - 4, num_tokens)], device=device)","+    ref = rms_norm_ref(x[rows], weight, None, z=z[rows], eps=1e-6)","+    torch.testing.assert_close(out[rows], ref, atol=1e-2, rtol=1e-2)","+","+"," if __name__ == \"__main__\":","     # Run a quick smoke test","     test_layer_norm_fwd_basic(128, 1024, torch.float16, 42, False)"],"additions":33,"deletions":0,"truncated":false},{"path":"tests/kernels/fla/test_fused_gdn_post_conv.py","lines":["@@ -220,6 +220,45 @@ def test_fused_post_conv_l0():","     assert g.shape == (0, HV)"," "," ","+def test_fused_post_conv_int64_token_offset():","+    \"\"\"Rows past 2^31 // qkv_dim need int64 offsets.\"\"\"","+    device = \"cuda\"","+    H, HV, K, V = 16, 32, 128, 128","+    qkv_dim = 2 * H * K + HV * V","+    L = 2**31 // qkv_dim + 16","+    # conv_output plus the q, k and v outputs, all bf16.","+    need = L * (qkv_dim + 2 * H * K + HV * V) * 2","+    free, _ = current_platform.mem_get_info()","+    if free < need + (1 << 30):","+        pytest.skip(\"not enough free device memory\")","+","+    torch.manual_seed(0)","+    conv_output = torch.randn(L, qkv_dim, dtype=torch.bfloat16, device=device)","+    a = torch.randn(L, HV, dtype=torch.bfloat16, device=device)","+    b = torch.randn(L, HV, dtype=torch.bfloat16, device=device)","+    A_log = torch.randn(HV, dtype=torch.float32, device=device) - 2.0","+    dt_bias = torch.randn(HV, dtype=torch.float32, device=device) * 0.1","+","+    fused = fused_post_conv_prep(","+        conv_output,","+        a,","+        b,","+        A_log,","+        dt_bias,","+        num_k_heads=H,","+        head_k_dim=K,","+        head_v_dim=V,","+    )","+","+    # Reference on the first row and the last rows, past the int32 boundary.","+    rows = torch.tensor([0, *range(L - 16, L)], device=device)","+    ref = reference_post_conv(","+        conv_output[rows], a[rows], b[rows], A_log, dt_bias, H, K, V","+    )","+    for out, expected in zip(fused, ref):","+        torch.testing.assert_close(out[rows], expected, atol=1e-3, rtol=1e-3)","+","+"," @pytest.mark.parametrize(","     \"head_ratio,tp_size,query_lengths,state_dtype,norm_dtype\",","     ["],"additions":39,"deletions":0,"truncated":false},{"path":"tests/kernels/mamba/test_checkpoint_exporter.py","lines":["@@ -172,3 +172,41 @@ def test_exporter_stores_each_callers_checkpoints(caller: str, state_layout: str"," ","     assert torch.equal(conv_state, expected_conv)","     assert torch.equal(recurrent_state, expected_recurrent)","+","+","+@pytest.mark.skipif(not current_platform.is_cuda_alike(), reason=\"needs a GPU\")","+def test_exporter_int64_token_offset():","+    \"\"\"Conv windows of rows past 2^31 // row stride need int64 input offsets.","+","+    Qwen3.5 passes ``raw_qkv`` as the qkv slice of the packed qkvz projection,","+    so its row stride is wider than its width.","+    \"\"\"","+    width, row_stride, state_len, slot = 8192, 12288, 3, 5","+    num_tokens = 2**31 // row_stride + 64","+    free, _ = current_platform.mem_get_info()","+    if free < num_tokens * row_stride * 2 + (1 << 30):","+        pytest.skip(\"not enough free device memory\")","+","+    device = torch.device(\"cuda\")","+    gen = torch.Generator(device=device).manual_seed(0)","+    qkvz = torch.randn(","+        num_tokens, row_stride, device=device, dtype=torch.bfloat16, generator=gen","+    )","+    raw_qkv = qkvz[:, :width]","+    cu_seqlens = torch.tensor([0, num_tokens], dtype=torch.int32, device=device)","+    conv_state = torch.zeros(","+        NUM_SLOTS, width, state_len, device=device, dtype=torch.bfloat16","+    )","+    offset = num_tokens - 16","+    expected_conv = conv_state.clone()","+    expected_conv[slot] = raw_qkv[offset - state_len : offset].T","+","+    checkpoint = MambaPrefillCheckpointMetadata(","+        torch.tensor([offset], dtype=torch.int32, device=device),","+        torch.tensor([slot], dtype=torch.int32, device=device),","+    )","+    MambaPrefillCheckpointExporter(state_len=state_len).export(","+        checkpoint, raw_qkv=raw_qkv, conv_state=conv_state, cu_seqlens=cu_seqlens","+    )","+","+    assert torch.equal(conv_state, expected_conv)"],"additions":38,"deletions":0,"truncated":false},{"path":"tests/kernels/test_fused_qk_norm_rope_gate.py","lines":["@@ -118,3 +118,79 @@ def test_fused_qk_norm_rope_gate_matches_reference(","     torch.testing.assert_close(q_out, q_ref, atol=1e-2, rtol=1e-2)","     torch.testing.assert_close(k_out, k_ref, atol=1e-2, rtol=1e-2)","     torch.testing.assert_close(gate_out, gate_ref, atol=0, rtol=0)","+","+","+@pytest.mark.skipif(","+    not (current_platform.is_cuda_alike() or current_platform.is_xpu()),","+    reason=\"fused_qk_rmsnorm_rope_gate Triton kernel requires CUDA/ROCm/XPU\",","+)","+@torch.inference_mode()","+def test_fused_qk_norm_rope_gate_int64_row_offset(default_vllm_config) -> None:","+    # q_gate and k are views into the packed qkv output, so a token's input","+    # offset is token * row_stride. Rows from 2^31 // row_stride + 1 on","+    # (149,797 here, 209,716 for Qwen3.5-9B) need int64 offsets.","+    num_q_heads, num_kv_heads = 24, 4","+    q_size = num_q_heads * HEAD_DIM","+    kv_size = num_kv_heads * HEAD_DIM","+    row_stride = 2 * q_size + 2 * kv_size","+    num_tokens = 2**31 // row_stride + 8","+    # packed qkv plus the q, k and gate outputs, all bf16.","+    need = num_tokens * (row_stride + 2 * q_size + kv_size) * 2","+    free, _ = current_platform.mem_get_info()","+    if free < need + (1 << 30):","+        pytest.skip(\"not enough free device memory\")","+","+    device = torch.device(","+        current_platform.device_type, torch.accelerator.current_device_index()","+    )","+    torch.set_default_device(device)","+    set_random_seed(SEED)","+","+    qkv = torch.randn(num_tokens, row_stride, dtype=DTYPE, device=device)","+    q_gate, k, _ = qkv.split([2 * q_size, kv_size, kv_size], dim=-1)","+    q_norm = GemmaRMSNorm(HEAD_DIM, eps=RMS_NORM_EPS).to(device, dtype=DTYPE)","+    k_norm = GemmaRMSNorm(HEAD_DIM, eps=RMS_NORM_EPS).to(device, dtype=DTYPE)","+    q_norm.weight.normal_(std=0.1)","+    k_norm.weight.normal_(std=0.1)","+    rope = RotaryEmbedding(","+        HEAD_DIM,","+        ROTARY_DIM,","+        MAX_POSITION_EMBEDDINGS,","+        ROPE_THETA,","+        True,","+        DTYPE,","+    ).to(device)","+    positions = torch.arange(num_tokens, dtype=torch.long, device=device)","+","+    q_out, k_out, gate_out = fused_qk_rmsnorm_rope_gate(","+        q_gate,","+        k,","+        q_norm.weight,","+        k_norm.weight,","+        rope.cos_sin_cache,","+        positions,","+        RMS_NORM_EPS,","+        num_q_heads,","+        num_kv_heads,","+        HEAD_DIM,","+        ROTARY_DIM,","+        norm_beta=1.0,","+    )","+","+    # Reference on the first row and the last rows, past the int32 boundary.","+    rows = torch.tensor([0, *range(num_tokens - 8, num_tokens)], device=device)","+    n = rows.numel()","+    q_gate_heads = q_gate[rows].view(n, num_q_heads, 2 * HEAD_DIM)","+    gate_ref = q_gate_heads[..., HEAD_DIM:].reshape(n, q_size)","+    q_ref = q_norm.forward_native(q_gate_heads[..., :HEAD_DIM])","+    k_ref = k_norm.forward_native(k[rows].view(n, num_kv_heads, HEAD_DIM))","+    assert isinstance(q_ref, torch.Tensor)","+    assert isinstance(k_ref, torch.Tensor)","+    q_ref, k_ref = rope.forward_native(","+        positions[rows], q_ref.reshape(n, q_size), k_ref.reshape(n, kv_size)","+    )","+    assert k_ref is not None","+","+    torch.testing.assert_close(q_out[rows], q_ref, atol=1e-2, rtol=1e-2)","+    torch.testing.assert_close(k_out[rows], k_ref, atol=1e-2, rtol=1e-2)","+    torch.testing.assert_close(gate_out[rows], gate_ref, atol=0, rtol=0)"],"additions":76,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/fused_qk_norm_rope.py","lines":["@@ -47,7 +47,8 @@ def _fused_qk_rmsnorm_rope_gate_kernel(","     MROPE_SECTION_H: tl.constexpr,","     MROPE_SECTION_W: tl.constexpr,"," ):","-    token = tl.program_id(0)","+    # int64 so that token * stride does not overflow int32 for large batches.","+    token = tl.program_id(0).to(tl.int64)","     head = tl.program_id(1)","     is_k = head >= num_q_heads","     local_head = tl.where(is_k, head - num_q_heads, head)"],"additions":2,"deletions":1,"truncated":false},{"path":"vllm/model_executor/layers/mamba/checkpoint.py","lines":["@@ -282,7 +282,7 @@ def store_cache_checkpoints_kernel(","     if HAS_TOKEN_MAP:","         token_idx = tl.load(token_indices_ptr + token_idx, mask=valid_conv, other=0)","     values = tl.load(","-        x_ptr + token_idx * x_stride_0 + width_idx * x_stride_1,","+        x_ptr + token_idx.to(tl.int64) * x_stride_0 + width_idx * x_stride_1,","         mask=valid_conv,","     )","     tl.store("],"additions":1,"deletions":1,"truncated":false},{"path":"vllm/third_party/flash_linear_attention/ops/chunk_delta_h.py","lines":["@@ -94,20 +94,21 @@ def chunk_gated_delta_rule_fwd_kernel_h_blockdim64(","         b_h4 = tl.zeros([BV, 64], d