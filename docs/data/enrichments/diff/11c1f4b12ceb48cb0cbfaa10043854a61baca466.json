{"id":"11c1f4b12ceb48cb0cbfaa10043854a61baca466","axis":"silent","repo":"gfx-rs/wgpu","sha":"11c1f4b12ceb48cb0cbfaa10043854a61baca466","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -139,6 +139,7 @@ By @sagudev in [#10307](https://github.com/gfx-rs/wgpu/pull/10307)."," "," - Added `Utf16SourceLocation` which is analogue to `SourceLocation` but using UTF-16 code units. Added `Utf16SourceLocation::to_utf8` and `SourceLocation::to_utf16` to convert between them. By @sagudev in [#10294](https://github.com/gfx-rs/wgpu/pull/10294)."," - Add `as_core` and `from_core` methods on various wgpu resources. By @sagudev in [#10211](https://github.com/gfx-rs/wgpu/pull/10211).","+- Added `Features::UNRESTRICTED_BYTES_PER_ROW`: `bytes_per_row` in `copy_buffer_to_texture` and `copy_texture_to_buffer` need only be a multiple of the texel block copy size, not of 256. Supported on Vulkan, Metal, GL, and DX12 with `UnrestrictedBufferTextureCopyPitchSupported`. By @michael-dm in [#10619](https://github.com/gfx-rs/wgpu/pull/10619)."," "," #### Naga"," "],"additions":1,"deletions":0,"truncated":false},{"path":"tests/tests/wgpu-gpu/transfer.rs","lines":["@@ -1,12 +1,14 @@"," use wgpu::util::DeviceExt;"," use wgpu_test::{","-    apply, fail, gpu_test, image::ReadbackBuffers, GpuTestConfiguration, GpuTestInitializer,","-    TestParameters,","+    apply, fail, gpu_test, image::ReadbackBuffers, FailureCase, GpuTestConfiguration,","+    GpuTestInitializer, TestParameters,"," };"," "," pub fn all_tests(vec: &mut Vec<GpuTestInitializer>) {","     vec.push(COPY_OVERFLOW_Z);","     vec.push(COPY_TEXTURE_TO_TEXTURE_3D);","+    vec.push(COPY_UNALIGNED_ROWS);","+    vec.push(COPY_UNALIGNED_COMPRESSED_ROWS);"," }"," "," #[apply(gpu_test!)]","@@ -186,3 +188,145 @@ static COPY_OVERFLOW_Z: GpuTestConfiguration = GpuTestConfiguration::new()","             Some(\"unable to select texture mip level\"),","         );","     });","+","+#[apply(gpu_test!)]","+static COPY_UNALIGNED_ROWS: GpuTestConfiguration = GpuTestConfiguration::new()","+    .parameters(TestParameters::default().features(wgpu::Features::UNRESTRICTED_BYTES_PER_ROW))","+    .run_async(|ctx| {","+        copy_unaligned_rows(","+            ctx,","+            &[","+                wgpu::TextureFormat::R8Unorm,","+                wgpu::TextureFormat::Rg8Unorm,","+                wgpu::TextureFormat::Rgba8Unorm,","+                wgpu::TextureFormat::Rgba32Float,","+                wgpu::TextureFormat::Depth16Unorm,","+                wgpu::TextureFormat::Stencil8,","+            ],","+        )","+    });","+","+#[apply(gpu_test!)]","+static COPY_UNALIGNED_COMPRESSED_ROWS: GpuTestConfiguration = GpuTestConfiguration::new()","+    .parameters(","+        TestParameters::default()","+            .features(","+                wgpu::Features::UNRESTRICTED_BYTES_PER_ROW | wgpu::Features::TEXTURE_COMPRESSION_BC,","+            )","+            // GL doesn't implement copies from compressed textures to buffers.","+            .skip(FailureCase::backend(wgpu::Backends::GL)),","+    )","+    .run_async(|ctx| {","+        copy_unaligned_rows(","+            ctx,","+            &[","+                wgpu::TextureFormat::Bc1RgbaUnorm,","+                wgpu::TextureFormat::Bc7RgbaUnorm,","+            ],","+        )","+    });","+","+/// Copies an array texture from a buffer and back, with rows and images padded by one block","+/// and a non-zero offset, so copies must honour a `bytes_per_row` that is neither tight nor a","+/// multiple of 256.","+async fn copy_unaligned_rows(ctx: wgpu_test::TestingContext, formats: &[wgpu::TextureFormat]) {","+    const BLOCKS: wgpu::Extent3d = wgpu::Extent3d {","+        width: 3,","+        height: 2,","+        depth_or_array_layers: 2,","+    };","+    const OFFSET: u32 = 16;","+    for &format in formats {","+        if format.is_depth_stencil_format()","+            && !ctx","+                .adapter_downlevel_capabilities","+                .flags","+                .contains(wgpu::DownlevelFlags::DEPTH_TEXTURE_AND_BUFFER_COPIES)","+        {","+            continue;","+        }","+        let (block_width, block_height) = format.block_dimensions();","+        let block_size = format.block_copy_size(None).unwrap();","+        let size = wgpu::Extent3d {","+            width: BLOCKS.width * block_width,","+            height: BLOCKS.height * block_height,","+            depth_or_array_layers: BLOCKS.depth_or_array_layers,","+        };","+        let bytes_per_row = (BLOCKS.width + 1) * block_size;","+        let rows_per_image = BLOCKS.height + 1;","+        let layout = wgpu::TexelCopyBufferLayout {","+            offset: OFFSET.into(),","+            bytes_per_row: Some(bytes_per_row),","+            rows_per_image: Some(rows_per_image),","+        };","+        let image_bytes = bytes_per_row * rows_per_image;","+        let data: Vec<u8> = (0..OFFSET + image_bytes * BLOCKS.depth_or_array_layers)","+            .map(|index| {","+                let Some(byte) = index.checked_sub(OFFSET) else {","+                    return 0;","+                };","+                let row = byte % image_bytes / bytes_per_row;","+                let row_byte = byte % bytes_per_row;","+                if row < BLOCKS.height && row_byte < BLOCKS.width * block_size {","+                    byte as u8 | 1","+                } else {","+                    0","+                }","+            })","+            .collect();","+        let upload = ctx","+            .device","+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {","+                label: None,","+                contents: &data,","+                usage: wgpu::BufferUsages::COPY_SRC,","+            });","+        let texture = ctx.device.create_texture(&wgpu::TextureDescriptor {","+            label: None,","+            dimension: wgpu::TextureDimension::D2,","+            size,","+            format,","+            usage: wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::COPY_SRC,","+            mip_level_count: 1,","+            sample_count: 1,","+            view_formats: &[],","+        });","+        let readback = ctx.device.create_buffer(&wgpu::BufferDescriptor {","+            label: None,","+            size: data.len() as u64,","+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,","+            mapped_at_creation: false,","+        });","+","+        let mut encoder = ctx","+            .device","+            .create_command_encoder(&wgpu::CommandEncoderDescriptor { label: None });","+        encoder.copy_buffer_to_texture(","+            wgpu::TexelCopyBufferInfo {","+                buffer: &upload,","+                layout,","+            },","+            texture.as_image_copy(),","+            size,","+        );","+        encoder.copy_texture_to_buffer(","+            texture.as_image_copy(),","+            wgpu::TexelCopyBufferInfo {","+                buffer: &readback,","+                layout,","+            },","+            size,","+        );","+        ctx.queue.submit(Some(encoder.finish()));","+","+        readback.slice(..).map_async(wgpu::MapMode::Read, |_| ());","+        ctx.async_poll(wgpu::PollType::wait_indefinitely())","+            .await","+            .unwrap();","+        assert_eq!(","+            *readback.slice(..).get_mapped_range().unwrap(),","+            data[..],","+            \"{format:?}\"","+        );","+    }","+}"],"additions":146,"deletions":2,"truncated":false},{"path":"tests/tests/wgpu-validation/api/texture.rs","lines":["@@ -2,7 +2,7 @@"," "," use std::sync::Arc;"," ","-use wgpu_test::{fail, valid};","+use wgpu_test::{fail, fail_if, valid};"," "," /// Ensures that submitting a command buffer referencing an already destroyed texture"," /// results in an error.","@@ -583,6 +583,79 @@ fn copy_buffer_to_texture_forbidden_format_aspect() {","     }"," }"," ","+/// Ensures that `bytes_per_row` of buffer-texture copies must be a multiple of 256, or only","+/// of the texel block copy size with [`wgpu::Features::UNRESTRICTED_BYTES_PER_ROW`].","+#[test]","+fn copy_bytes_per_row_alignment() {","+    for (features, format, should_fail) in [","+        (wgpu::Features::empty(), wgpu::TextureFormat::R8Unorm, true),","+        (","+            wgpu::Features::UNRESTRICTED_BYTES_PER_ROW,","+            wgpu::TextureFormat::R8Unorm,","+            false,","+        ),","+        (","+            wgpu::Features::UNRESTRICTED_BYTES_PER_ROW,","+            wgpu::TextureFormat::Rg8Unorm,","+            true,","+        ),","+    ] {","+        let (device, _queue) = wgpu::Device::noop(&wgpu::DeviceDescriptor {","+            required_features: features,","+            ..Default::default()","+        });","+        let size = wgpu::Extent3d {","+            width: 2,","+            height: 2,","+            depth_or_array_layers: 1,","+        };","+        let texture = device.create_texture(&wgpu::TextureDescriptor {","+            label: None,","+            size,","+            mip_level_count: 1,","+            sample_count: 1,","+            dimension: wgpu::TextureDimension::D2,","+            format,","+            usage: wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::COPY_SRC,","+            view_formats: &[],","+        });","+        let buffer = device.create_buffer(&wgpu::BufferDescriptor {","+            label: None,","+            size: 256,","+            usage: wgpu::BufferUsages::COPY_SRC | wgpu::BufferUsages::COPY_DST,","+            mapped_at_creation: false,","+        });","+        let buffer_copy = wgpu::TexelCopyBufferInfo {","+            buffer: &buffer,","+            layout: wgpu::TexelCopyBufferLayout {","+                offset: 0,","+                bytes_per_row: Some(101),","+                rows_per_image: None,","+            },","+        };","+","+        let mut encoder =","+            device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: None });","+        encoder.copy_buffer_to_texture(buffer_copy, texture.as_image_copy(), size);","+        fail_if(","+            &device,","+            should_fail,","+            || encoder.finish(),","+            Some(\"is not a multiple of\"),","+        );","+","+        let mut encoder =","+            device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: None });","+        encoder.copy_texture_to_buffer(texture.as_image_copy(), buffer_copy, size);","+        fail_if(","+            &device,","+            should_fail,","+            || encoder.finish(),","+            Some(\"is not a multiple of\"),","+        );","+    }","+}","+"," /// Ensures that attempting to create a texture with [`wgpu::TextureUsages::TRANSIENT_ATTACHMENT`]"," /// and its unsupported usages fails validation."," #[test]"],"additions":74,"deletions":1,"truncated":false},{"path":"wgpu-core/src/command/transfer.rs","lines":["@@ -117,8 +117,8 @@ pub enum TransferError {","     UnalignedCopyOriginX,","     #[error(\"Copy origin's y component is not a multiple of block height\")]","     UnalignedCopyOriginY,","-    #[error(\"Bytes per row does not respect `COPY_BYTES_PER_ROW_ALIGNMENT`\")]","-    UnalignedBytesPerRow,","+    #[error(\"Bytes per row ({bytes_per_row}) is not a multiple of {alignment}\")]","+    UnalignedBytesPerRow { bytes_per_row: u32, alignment: u32 },","     #[error(\"Number of bytes per row needs to be specified since more than one row is copied\")]","     UnspecifiedBytesPerRow,","     #[error(\"Number of rows per image needs to be specified since more than one image is copied\")]","@@ -202,7 +202,7 @@ impl WebGpuError for TransferError {","             | Self::UnalignedCopyHeight","             | Self::UnalignedCopyOriginX","             | Self::UnalignedCopyOriginY","-            | Self::UnalignedBytesPerRow","+            | Self::UnalignedBytesPerRow { .. }","             | Self::UnspecifiedBytesPerRow","             | Self::UnspecifiedRowsPerImage","            