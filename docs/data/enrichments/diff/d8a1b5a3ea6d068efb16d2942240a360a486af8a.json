"+\t\tdropS3 := false","+\t\tfor _, field := range restrictedS3Fields {","+\t\t\tif !isRestricted(field.name) {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tpinned := \"\"","+\t\t\tif serverS3 != nil {","+\t\t\t\tpinned = *field.value(serverS3)","+\t\t\t}","+\t\t\trequested := field.value(sr.S3)","+\t\t\tif *requested == pinned {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tignored = append(ignored, field.name)","+\t\t\t*requested = pinned","+\t\t\tif field.identifiesTarget && serverS3 == nil {","+\t\t\t\tdropS3 = true","+\t\t\t}","+\t\t}","+\t\tif dropS3 {","+\t\t\tsr.S3 = nil","+\t\t}","+\t}","+","+\tswitch len(ignored) {","+\tcase 0:","+\t\treturn nil","+\tcase 1:","+\t\treturn []string{fmt.Sprintf(\"%s override ignored by server-side snapshot restrictions. Using the server-configured destination.\", ignored[0])}","+\tdefault:","+\t\treturn []string{fmt.Sprintf(\"restricted snapshot options were ignored: %s. Using the server-configured snapshot destination.\", strings.Join(ignored, \", \"))}","+\t}","+}","+","+// addWarnings sends each message to the client as an RFC 7234 \"299\" Warning header, which the","+// CLI prints when it reads the response.","+func addWarnings(h http.Header, warnings []string) {","+\tfor _, w := range warnings {","+\t\tvalue, err := utilnet.NewWarningHeader(299, \"\", w)","+\t\tif err != nil {","+\t\t\tlogrus.Warnf(\"Unable to send warning to etcd-snapshot client: %v: %s\", err, w)","+\t\t\tcontinue","+\t\t}","+\t\th.Add(\"Warning\", value)","+\t}","+}","+","+// validSnapshotName returns true if name is a plain snapshot file name. Names are joined onto","+// the snapshot directory and used as S3 object keys, so anything that is a path - one with","+// separators, an absolute path, or \".\" / \"..\" - could address something other than a snapshot.","+func validSnapshotName(name string) bool {","+\treturn name != \"\" && name != \".\" && name != \"..\" && filepath.Base(name) == name","+}"],"additions":145,"deletions":6,"truncated":false},{"path":"pkg/etcd/snapshot_handler_test.go","lines":["@@ -0,0 +1,381 @@","+package etcd","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"reflect\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/k3s-io/k3s/pkg/daemons/config\"","+\tutilnet \"k8s.io/apimachinery/pkg/util/net\"","+)","+","+func Test_UnitSnapshotRestrictions(t *testing.T) {","+\ttests := []struct {","+\t\tname         string","+\t\trestrictions []string","+\t\tdataDir      string","+\t\tserverDir    string","+\t\tserverS3     *config.EtcdS3","+\t\treqDir       *string","+\t\treqS3        *config.EtcdS3","+","+\t\twantWarnings []string","+\t\twantDir      *string","+\t\t// wantS3 is the S3 config expected on the request afterwards. Nil means the request","+\t\t// carries no S3 config: either none was sent, or it was dropped.","+\t\twantS3 *config.EtcdS3","+\t}{","+\t\t{","+\t\t\tname:   \"no restrictions leaves the request untouched\",","+\t\t\treqDir: stringPtr(\"/tmp/custom\"),","+\t\t\treqS3: &config.EtcdS3{","+\t\t\t\tEndpoint: \"custom-endpoint\",","+\t\t\t\tBucket:   \"custom-bucket\",","+\t\t\t\tFolder:   \"custom-folder\",","+\t\t\t\tProxy:    \"custom-proxy\",","+\t\t\t},","+\t\t\twantDir: stringPtr(\"/tmp/custom\"),","+\t\t\twantS3: &config.EtcdS3{","+\t\t\t\tEndpoint: \"custom-endpoint\",","+\t\t\t\tBucket:   \"custom-bucket\",","+\t\t\t\tFolder:   \"custom-folder\",","+\t\t\t\tProxy:    \"custom-proxy\",","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:         \"one restricted field is pinned to the server value, others pass through\",","+\t\t\trestrictions: []string{\"s3-bucket\"},","+\t\t\tserverS3:     &config.EtcdS3{Bucket: \"server-bucket\", Folder: \"server-folder\"},","+\t\t\treqDir:       stringPtr(\"/tmp/custom\"),","+\t\t\treqS3:        &config.EtcdS3{Bucket: \"custom-bucket\", Folder: \"custom-folder\"},","+\t\t\twantWarnings: []string{\"s3-bucket override ignored\"},","+\t\t\twantDir:      stringPtr(\"/tmp/custom\"),","+\t\t\twantS3:       &config.EtcdS3{Bucket: \"server-bucket\", Folder: \"custom-folder\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"restricted target field on a server without S3 drops the S3 section\",","+\t\t\trestrictions: []string{\"s3-bucket\"},","+\t\t\treqS3:        &config.EtcdS3{Bucket: \"custom-bucket\", Folder: \"custom-folder\"},","+\t\t\twantWarnings: []string{\"s3-bucket override ignored\"},","+\t\t\twantS3:       nil,","+\t\t},","+\t\t{","+\t\t\tname:         \"restricted non-target field on a server without S3 keeps the S3 section\",","+\t\t\trestrictions: []string{\"s3-folder\"},","+\t\t\treqS3:        &config.EtcdS3{Endpoint: \"e\", Bucket: \"b\", Folder: \"f\", Proxy: \"p\"},","+\t\t\twantWarnings: []string{\"s3-folder override ignored\"},","+\t\t\twantS3:       &config.EtcdS3{Endpoint: \"e\", Bucket: \"b\", Folder: \"\", Proxy: \"p\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"values equal to the server values emit no warning\",","+\t\t\trestrictions: []string{\"s3-endpoint\", \"s3-bucket\"},","+\t\t\tserverS3:     &config.EtcdS3{Endpoint: \"e\", Bucket: \"b\"},","+\t\t\treqS3:        &config.EtcdS3{Endpoint: \"e\", Bucket: \"b\", Folder: \"f\"},","+\t\t\twantS3:       &config.EtcdS3{Endpoint: \"e\", Bucket: \"b\", Folder: \"f\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"multiple restricted fields are listed in order\",","+\t\t\trestrictions: []string{\"s3-bucket\", \"s3-endpoint\"},","+\t\t\tserverS3:     &config.EtcdS3{Endpoint: \"server-endpoint\", Bucket: \"server-bucket\"},","+\t\t\treqS3:        &config.EtcdS3{Endpoint: \"custom-endpoint\", Bucket: \"custom-bucket\", Folder: \"custom-folder\"},","+\t\t\twantWarnings: []string{\"restricted snapshot options were ignored: s3-endpoint, s3-bucket\"},","+\t\t\twantS3:       &config.EtcdS3{Endpoint: \"server-endpoint\", Bucket: \"server-bucket\", Folder: \"custom-folder\"},","+\t\t},","+\t\t{","+\t\t\tname:         \"snapshot-dir matching the server dir emits no warning\",","+\t\t\trestrictions: []string{\"snapshot-dir\"},","+\t\t\tserv