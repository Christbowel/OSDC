mits for a release name.","+const maxHelmReleaseNameLength = 53","+","+// helmReleaseNameRegexp mirrors the release name validation Helm itself applies","+// (a DNS-1123 subdomain). Keeping this identical to Helm's own rule means any","+// name Helm would have accepted is still accepted here, so this validation","+// rejects nothing that previously worked.","+var helmReleaseNameRegexp = regexp.MustCompile(`^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$`)","+","+// ValidateReleaseName ensures a Helm release name is well-formed before it is","+// handed to the helm binary.","+//","+// This is a security control, not merely input hygiene. The release name is","+// attacker-controlled via spec.source.helm.releaseName (and via a repository's","+// .argocd-source.yaml). It must never be able to reach a Helm flag that is","+// evaluated as a Go template, because Helm's template engine exposes the sprig","+// function library, including env() and getHostByName(), which would disclose","+// the repo-server's process environment and permit DNS egress.","+//","+// This is enforced at the point of use in template(), so that every caller is","+// covered. It is exported so callers can additionally validate earlier and","+// report which field was at fault.","+func ValidateReleaseName(name string) error {","+\tif name == \"\" {","+\t\treturn errors.New(\"helm release name is empty\")","+\t}","+\tif len(name) > maxHelmReleaseNameLength {","+\t\treturn fmt.Errorf(\"invalid helm release name %q: must be no more than %d characters\", name, maxHelmReleaseNameLength)","+\t}","+\tif !helmReleaseNameRegexp.MatchString(name) {","+\t\treturn fmt.Errorf(\"invalid helm release name %q: must consist of lower case alphanumeric characters, '-' or '.', and must start and end with an alphanumeric character\", name)","+\t}","+\treturn nil","+}","+"," func cleanSetParameters(val string) string {"," \t// `{}` equal helm list parameters format, so don't escape `,`."," \tif strings