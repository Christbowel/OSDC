ve over gRPC or gRPC-Web with arbitrary (including empty) messages, so optional sub-messages may","+// be nil and must be checked before they are dereferenced."," func bug21955WorkaroundInterceptor(ctx context.Context, req any, _ *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (resp any, err error) {"," \tswitch req := req.(type) {"," \tcase *repositorypkg.RepoQuery:","@@ -1835,17 +1844,21 @@ func bug21955WorkaroundInterceptor(ctx context.Context, req any, _ *grpc.UnarySe"," \t\t}"," \t\treq.Repo = repo"," \tcase *repositorypkg.RepoAppDetailsQuery:","-\t\trepo, err := url.QueryUnescape(req.Source.RepoURL)","-\t\tif err != nil {","-\t\t\treturn nil, err","+\t\tif req.Source != nil {","+\t\t\trepo, err := url.QueryUnescape(req.Source.RepoURL)","+\t\t\tif err != nil {","+\t\t\t\treturn nil, err","+\t\t\t}","+\t\t\treq.Source.RepoURL = repo"," \t\t}","-\t\treq.Source.RepoURL = repo"," \tcase *repositorypkg.RepoUpdateRequest:","-\t\trepo, err := url.QueryUnescape(req.Repo.Repo)","-\t\tif err != nil {","-\t\t\treturn nil, err","+\t\tif req.Repo != nil {","+\t\t\trepo, err := url.QueryUnescape(req.Repo.Repo)","+\t\t\tif err != nil {","+\t\t\t\treturn nil, err","+\t\t\t}","+\t\t\treq.Repo.Repo = repo"," \t\t}","-\t\treq.Repo.Repo = repo"," \tcase *repocredspkg.RepoCredsQuery:"," \t\tpattern, err := url.QueryUnescape(req.Url)"," \t\tif err != nil {"],"additions":21,"deletions":8,"truncated":false},{"path":"server/server_test.go","lines":["@@ -40,6 +40,9 @@ import ("," \t\"github.com/argoproj/argo-cd/v3/common\""," \t\"github.com/argoproj/argo-cd/v3/pkg/apiclient\""," \tapplicationpkg \"github.com/argoproj/argo-cd/v3/pkg/apiclient/application\"","+\tclusterpkg \"github.com/argoproj/argo-cd/v3/pkg/apiclient/cluster\"","+\trepocredspkg \"github.com/argoproj/argo-cd/v3/pkg/apiclient/repocreds\"","+\trepositorypkg \"github.com/argoproj/argo-cd/v3/pkg/apiclient/repository\""," \t\"github.com/argoproj/argo-cd/v3/pkg/apiclient/session\""," \t\"github.com/argoproj/argo-cd/v3/pkg/ap