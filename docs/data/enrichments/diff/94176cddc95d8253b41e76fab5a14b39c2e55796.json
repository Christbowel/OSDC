{"id":"94176cddc95d8253b41e76fab5a14b39c2e55796","axis":"silent","repo":"pnpm/pnpm","sha":"94176cddc95d8253b41e76fab5a14b39c2e55796","parsed":{"files":[{"path":".changeset/shim-dispatch-reentry.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Running a global command such as `node` in a project that pins its version no longer hangs while pnpm installs that version. The hang kept starting new processes until the machine ran out of memory."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/lib.rs","lines":["@@ -90,6 +90,9 @@ pub fn main() -> ExitCode {","     let argv: Vec<OsString> = std::env::args_os().collect();","     let launch = shim_dispatch::ShimLaunch::detect(&argv);","     let argv = if launch.is_shim() { argv } else { argv_with_alias_subcommand(argv) };","+    // Like the `--env-file` load below, this sets a variable, so it runs","+    // before the startup thread exists.","+    launch.mark_preparation();","     // Load `--env-file` variables here, on the main thread before the","     // startup thread below exists: `std::env::set_var` must not run once","     // another thread is alive (see `env_file`). A shim launch is exempt:"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/shim_dispatch.rs","lines":["@@ -69,6 +69,7 @@ use settings::{"," use std::{","     ffi::OsString,","     path::{Path, PathBuf},","+    sync::atomic::{AtomicBool, Ordering},"," };"," use trust::is_trusted;"," ","@@ -80,6 +81,19 @@ mod trust;"," /// sibling `node` shim included, inherit."," const BYPASS_ENV: &str = \"PNPM_SHIM_BYPASS\";"," ","+/// Environment variable marking the processes a shim dispatch spawns while","+/// it prepares the program it runs, such as the `node --version` probe of","+/// a runtime install. A shim launched with it set runs its global target:","+/// dispatching again would prepare the same program, and a shim that","+/// prepares a runtime by running that runtime's own shim recurses forever.","+/// The program the dispatch finally runs does not inherit it, so the","+/// project's own nested commands dispatch as usual.","+const PREPARING_ENV: &str = \"PNPM_SHIM_PREPARING\";","+","+/// Whether this process set [`PREPARING_ENV`], rather than inheriting it","+/// from an enclosing dispatch.","+static SET_PREPARING_ENV: AtomicBool = AtomicBool::new(false);","+"," /// What this process was launched as, resolved once in [`crate::main`]."," ///"," /// Classification reads the shim sidecar, so reading it again later in","@@ -126,6 +140,22 @@ impl ShimLaunch {","         !matches!(self, Self::Cli)","     }"," ","+    /// Set [`PREPARING_ENV`] for a shim launch that no enclosing dispatch","+    /// has marked. Must run on the main thread before any other thread","+    /// exists (see [`crate::main`]).","+    pub(crate) fn mark_preparation(&self) {","+        if !self.is_shim() || std::env::var_os(PREPARING_ENV).is_some() {","+            return;","+        }","+        // SAFETY: `crate::main` calls this before `run_on_big_stack` spawns","+        // the startup thread, so no other thread exists that could access","+        // the environment concurrently.","+        unsafe {","+            std::env::set_var(PREPARING_ENV, \"1\");","+        }","+        SET_PREPARING_ENV.store(true, Ordering::Relaxed);","+    }","+","     /// Intercept a launch under a shim name, or a legacy shim's `--shim`","     /// invocation of the dispatcher it replaced. `None` means this is pnpm","     /// itself and the regular CLI should proceed; `Some(code)` means the","@@ -166,7 +196,7 @@ fn dispatch_target(","     state_dir: &Path,"," ) -> i32 {","     let ShimInvocation { name, target, .. } = *shim;","-    if bypass_requested() || shims.dispatches_nothing() {","+    if bypass_requested() || inside_preparation() || shims.dispatches_nothing() {","         return run_global_target(shim, args);","     }","     let Some(package) = shim_package(target) else {","@@ -293,6 +323,19 @@ fn runtime_runs_promptless(policy: ShimPolicy, name: &str, version_spec: &str) -","     }"," }"," ","+/// Whether an enclosing shim dispatch is still preparing what it runs.","+fn inside_preparation() -> bool {","+    !SET_PREPARING_ENV.load(Ordering::Relaxed) && std::env::var_os(PREPARING_ENV).is_some()","+}","+","+/// Keep [`PREPARING_ENV`] out of the program a dispatch finally runs when","+/// this process set it.","+fn unmark_preparation(command: &mut crate::process::Command) {","+    if SET_PREPARING_ENV.load(Ordering::Relaxed) {","+        command.env_remove(PREPARING_ENV);","+    }","+}","+"," fn bypass_requested() -> bool {","     std::env::var(BYPASS_ENV)","         .is_ok_and(|value| !value.is_empty() && value != \"0\" && value != \"false\")"],"additions":44,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/shim_dispatch/run_program.rs","lines":["@@ -5,6 +5,7 @@"," use super::{","     ShimInvocation, ShimTarget,","     rust_toolchain::{RUST_SHIM_PACKAGE, run_next_on_path},","+    unmark_preparation,"," };"," use crate::process::Command;"," use pnpm_cmd_shim::{Host as CmdShimHost, ScriptRuntime, search_script_runtime};","@@ -163,6 +164,7 @@ fn program_command("," ) -> Result<Command, i32> {","     let mut command = Command::new(program);","     command.args(args);","+    unmark_preparation(&mut command);","     if bin_dirs.is_empty() {","         return Ok(command);","     }"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global_shims.rs","lines":["@@ -174,6 +174,100 @@ fn bypass_env_skips_the_project_bin() {","     assert_eq!(stdout.trim(), \"global\");"," }"," ","+/// A shim launched while another dispatch prepares its program, such as the","+/// `node --version` probe of a runtime install, runs the global target and","+/// passes the marker on. The dispatch that set the marker keeps it from the","+/// program it runs.","+#[cfg(unix)]","+#[test]","+fn a_shim_inside_a_dispatch_preparation_runs_the_global_target() {","+    let root = tempfile::tempdir().unwrap();","+    let (project, global_target) = prepare_local_and_global(&root, \"tool\");","+    write_script(&global_target, \"global-[$PNPM_SHIM_PREPARING]\");","+    write_script(&project.join(\"node_modules/tool/cli.sh\"), \"local-[$PNPM_SHIM_PREPARING]\");","+    let command = || {","+        shim_command(&root, &project, \"tool\", global_target.to_str().unwrap())","+            .with_env(AUTO_TRUST_ENV, \"1\")","+            .with_env(\"PNPM_CONFIG_GLOBAL_SHIMS\", r#\"{\"tool\": true}\"#)","+    };","+    let stdout =","+        |output: &std::process::Output| String::from_utf8_lossy(&output.stdout).trim().to_string();","+","+    let outside = command().assert().success();","+    assert_eq!(stdout(outside.get_output()), \"local-[]\");","+","+    let inside = command()","+        .with_env(\"PNPM_SHIM_PREPARING\", \"1\")","+        .assert()","+        .success();","+    assert_eq!(stdout(inside.get_output()), \"global-[1]\");","+}","+","+/// A runtime install probes `node --version` through `PATH` when the","+/// environment sets its lockfile directory, and `PATH` here finds the","+/// runtime's own shim first. That probe must reach the global `node` rather","+/// than dispatch the pin again, which would wait on the install that is","+/// waiting for it.","+#[cfg(unix)]","+#[test]","+fn a_runtime_install_does_not_dispatch_its_own_shim_again() {","+    use pipe_trait::Pipe;","+","+    let root = tempfile::tempdir().unwrap();","+    let mut server = mockito::Server::new();","+    let version = \"24.0.0-rc.4\";","+    let _mocks = crate::install_runtimes::mock_node_release(&mut server, version);","+    let (project, global_target) = runtime_pin_project(&root, &server, version, \".nvmrc\");","+    let path = std::iter::once(root.path().join(\"global-bin\"))","+        .chain(std::env::split_paths(&std::env::var_os(\"PATH\").unwrap_or_default()))","+        .pipe(std::env::join_paths)","+        .unwrap();","+    let lockfile_dir = root.path().join(\"lockfile-dir\");","+    fs::create_dir_all(&lockfile_dir).unwrap();","+    let global_runs = root.path().join(\"global-runs\");","+    write_script(&global_target, &format!(\"global >> '{}'\", global_runs.display()));","+    let stderr = root.path().join(\"stderr\");","+","+    // A regression loops through new processes, so the shim leads a group","+    // of its own and the whole group dies at the end, not only the shim.","+    // Its output goes to files: a surviving descendant would hold a pipe","+    // open.","+    let mut command = shim_command(&root, &project, \"node\", global_target.to_str().unwrap())","+        .with_env(AUTO_TRUST_ENV, \"1\")","+        .with_env(\"PNPM_CONFIG_GLOBAL_SHIMS\", r#\"{\"tool\": true}\"#)","+        .with_env(\"PATH\", path)","+        .with_env(\"PNPM_CONFIG_LOCKFILE_DIR\", &lockfile_dir)","+        .with_stdout(std::process::Stdio::null())","+        .with_stderr(fs::File::create(&stderr).unwrap().into());","+    std::os::unix::process::CommandExt::process_group(&mut command, 0);","+    let mut shim = command.spawn().unwrap();","+    let deadline = std::time::Instant::now() + std::time::Duration::from_mins(1);","+    let status = loop {","+        if let Some(status) = shim.try_wait().unwrap() {","+            break Some(status);","+        }","+        if std::time::Instant::now() >= deadline {","+            break None;","+        }","+        std::thread::sleep(std::time::Duration::from_millis(100));","+    };","+    let group = i32::try_from(shim.id()).unwrap();","+    // SAFETY: the group is the one this test's shim leads.","+    unsafe {","+        libc::killpg(group, libc::SIGKILL);","+    }","+    if status.is_none() {","+        shim.wait().unwrap();","+    }","+    eprintln!(\"{}\", fs::read_to_string(&stderr).unwrap());","+","+    // Not `success()`: the leaked lockfile directory that makes the install","+    // probe `node` also sends the install outside the runtime environment,","+    // where pnpm then rejects the runtime it installed.","+    assert!(status.is_some(), \"the dispatch must finish, not wait on itself\");","+    assert!(global_runs.exists(), \"the probe must run the global node\");","+}","+"," #[cfg(unix)]"," #[test]"," fn shim_args_reach_the_target() {"],"additions":94,"deletions":0,"truncated":false},{"path":"pnpm/crates/testing-utils/src/command_env.rs","lines":["@@ -54,15 +54,17 @@ fn ambient_pnpm_config_vars() -> impl Iterator<Item = OsString> {"," "," /// Whether `name` steers the pnpm under test: either spelling of the"," /// `pnpm_config_` / `npm_config_` prefixes, the context-aware shim kill","-/// switch, or the lifecycle event a parent `pnpm run` sets. `PNPM_HOME`","-/// is deliberately not one of them — the suites spawn the ambient pnpm","-/// for their compatibility checks.","+/// switch and preparation marker, or the lifecycle event a parent","+/// `pnpm run` sets. `PNPM_HOME` is deliberately not one of them — the","+/// suites spawn the ambient pnpm for their compatibility checks."," fn is_pnpm_config_var(name: &str) -> bool {","     const PREFIXES: [&str; 2] = [\"pnpm_config_\", \"npm_config_\"];","     const SHIM_BYPASS: &str = \"PNPM_SHIM_BYPASS\";","+    const SHIM_PREPARING: &str = \"PNPM_SHIM_PREPARING\";","     const LIFECYCLE_EVENT: &str = \"npm_lifecycle_event\";"," ","     name.eq_ignore_ascii_case(SHIM_BYPASS)","+        || name.eq_ignore_ascii_case(SHIM_PREPARING)","         || name.eq_ignore_ascii_case(LIFECYCLE_EVENT)","         || PREFIXES","             .iter()"],"additions":5,"deletions":3,"truncated":false},{"path":"pnpm/crates/testing-utils/src/command_env/tests.rs","lines":["@@ -16,6 +16,7 @@ fn pnpm_and_npm_settings_match_in_either_spelling() {","         \"npm_config_registry\",","         \"PNPM_SHIM_BYPASS\",","         \"pnpm_shim_bypass\",","+        \"PNPM_SHIM_PREPARING\",","         \"npm_lifecycle_event\",","         \"NPM_LIFECYCLE_EVENT\",","     ] {",""],"additions":1,"deletions":0,"truncated":false}],"additions":154,"deletions":4,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-06T17:00:23.900807+00:00"}