penvino/op/add.hpp\""," #include \"openvino/op/broadcast.hpp\""," #include \"openvino/op/concat.hpp\"","@@ -25,17 +27,77 @@"," #include \"openvino/op/multiply.hpp\""," #include \"openvino/op/reshape.hpp\""," #include \"openvino/op/shape_of.hpp\"","+#include \"openvino/op/slice.hpp\"","+#include \"openvino/op/split.hpp\""," #include \"openvino/op/squeeze.hpp\""," #include \"openvino/op/subtract.hpp\""," #include \"openvino/op/tile.hpp\""," #include \"openvino/op/transpose.hpp\""," #include \"openvino/op/unsqueeze.hpp\"","+#include \"transformations/utils/utils.hpp\""," #include \"utils.hpp\""," "," namespace ov::frontend::gguf::op {"," "," static OutputVector translate_gated_delta_net_ref(const NodeContext& context);"," ","+namespace {","+","+struct FeatureSlice {","+    std::shared_ptr<ov::op::v1::Reshape> reshape;","+    std::shared_ptr<ov::op::v8::Slice> slice;","+    int64_t begin, end;","+};","+","+std::optional<FeatureSlice> match_feature_slice(const Output<Node>& value, const std::vector<int64_t>& target) {","+    using ov::op::util::has_constant_value;","+    const auto reshape = ov::as_type_ptr<ov::op::v1::Reshape>(value.get_node_shared_ptr());","+    if (!reshape || !reshape->get_special_zero() ||","+        !has_constant_value<int64_t>(reshape->get_input_node_shared_ptr(1), target))","+        return std::nullopt;","+    const auto slice = ov::as_type_ptr<ov::op::v8::Slice>(reshape->get_input_node_shared_ptr(0));","+    if (!slice || slice->get_input_size() != 5 ||","+        !has_constant_value<int64_t>(slice->get_input_node_shared_ptr(3), 1) ||","+        !has_constant_value<int64_t>(slice->get_input_node_shared_ptr(4), 3))","+        return std::nullopt;","+    const auto begin = ov::as_type_ptr<ov::op::v0::Constant>(slice->get_input_node_shared_ptr(1));","+    const auto end = ov::as_type_ptr<ov::op::v0::Constant>(slice->get_input_node_shared_ptr(2));","+    if (!begin || !end || ov::shape_size(begin->get_shape()) != 1 || ov::shape_size(end->get_shape()) != 1)","+        return std::nullopt;","+    return FeatureSlice{reshape, slice, begin->cast_vector<int64_t>()[0], end->cast_vector<int64_t>()[0]};","+}","+","+}  // namespace","+","+static Output<Node> join_adjacent_qk(const Output<Node>& q, const Output<Node>& k) {","+    const auto shape = q.get_partial_shape();","+    if (shape.rank() != 4 || !shape[2].is_static() || !shape[3].is_static() ||","+        q.get_element_type() != k.get_element_type())","+        return {};","+    const auto heads = shape[2].get_length(), width = shape[3].get_length();","+    const std::vector<int64_t> target{0, -1, heads, width};","+    const auto qs = match_feature_slice(q, target);","+    const auto ks = match_feature_slice(k, target);","+    if (!qs || !ks || qs->slice->input_value(0) != ks->slice->input_value(0))","+        return {};","+    const auto source_shape = qs->slice->get_input_partial_shape(0);","+    if (qs->begin < 0 || qs->end - qs->begin != heads * width || ks->begin != qs->end ||","+        ks->end - ks->begin != heads * width || source_shape.rank() != 4 || source_shape[1] != 1 ||","+        !source_shape[3].is_static() || ks->end > source_shape[3].get_length())","+        return {};","+    const auto slice = std::make_shared<ov::op::v8::Slice>(qs->slice->input_value(0),","+                                                           qs->slice->input_value(1),","+                                                           ks->slice->input_value(2),","+                                                           qs->slice->input_value(3),","+                                                           qs->slice->input_value(4));","+    const auto joined = std::make_shared<ov::op::v1::Reshape>(","+        slice,","+        ov::op::v0::Constant::create<int64_t>(ov::element::i64, {4}, {0, -1, 2 * heads, width}),","+        true);","+    ov::copy_runtime_info({qs->slice, ks->slice, qs->reshape, ks->reshape}, {slice, joined});","+    return joined;","+}","+"," // GGML_OP_GATED_DELTA_NET (qwen3next linear-attention block). Emits the internal (non-opset) op"," // ov::op::internal::GatedDeltaNet for the device's fused kernel; a model using it is not"," // IR-serializable (see docs/runtime.md). The fused op only supports scalar gating, so the","@@ -82,8 +144,15 @@ OutputVector translate_gated_delta_net(const NodeContext& context) {","     // square root instead, which differs for small vectors, so normalize here.","     if (context.get_attribute<bool>(\"fuse_qk_l2norm\", false)) {","         const float eps = context.get_attribute<float>(\"qk_l2_norm_eps\", 1e-6f);","-        q = make_l2_norm(q, eps);","-        k = make_l2_norm(k, eps);","+        if (const auto joined = join_adjacent_qk(q, k); joined.get_node()) {","+            const auto axis = ov::op::v0::Constant::create(ov::element::i64, {}, {2});","+            const auto normalized = std::make_shared<ov::op::v1::Split>(make_l2_norm(joined, eps), axis, 2);","+            q = normalized->output(0);","+            k = normalized->output(1);","+        } else {","+            q = make_l2_norm(q, eps);","+            k = make_l2_norm(k, eps);","+        }","     }"," ","     // ggml maps GQA heads in tiled order, while the OV op maps repeated heads in grouped order:"],"additions":71,"deletions":2,"truncated":false},{"path":"src/frontends/gguf/src/pass/adapt_to_genai.cpp","lines":["@@ -52,6 +52,7 @@"," #include \"openvino/pass/matcher_pass.hpp\""," #include \"openvino/pass/pattern/op/wrap_type.hpp\""," #include \"openvino/runtime/properties.hpp\"","+#include \"pass/simplify_activation_shapes.hpp\""," #include \"utils.hpp\""," "," namespace ov::frontend::gguf::pass {","@@ -775,6 +776,9 @@ bool AdaptToGenAI::run_on_model(const std::shared_ptr<ov::Model>& model) {","         if (!uses_ids)","             model->remove_parameter(input_ids);","     }","+    ov::pass::Manager activation_shapes_manager;","+    activation_shapes_manager.register_pass<SimplifyActivationShapes>();","+    activation_shapes_manager.run_passes(model);","     return true;"," }"," "],"additions":4,"deletions":0,"truncated":false},{"path":"src/frontends/gguf/src/pass/isolate_precision_sensitive_outputs.cpp","lines":["@@ -0,0 +1,40 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"pass/isolate_precision_sensitive_outputs.hpp\"","+","+#include \"openvino/core/rt_info.hpp\"","+#include \"openvino/op/convert.hpp\"","+#include \"openvino/op/split.hpp\"","+#include \"openvino/pass/pattern/op/wrap_type.hpp\"","+#include \"openvino/util/pp.hpp\"","+#include \"transformations/rt_info/disable_precision_conversion.hpp\"","+","+namespace ov::frontend::gguf::pass {","+","+IsolatePrecisionSensitiveOutputs::IsolatePrecisionSensitiveOutputs() {","+    const auto protected_fp32 = ov::pass::pattern::any_input([](const ov::Output<ov::Node>& value) {","+        return value.get_element_type() == ov::element::f32 &&","+               ov::is_conversion_disabled(value.get_node_shared_ptr(), ov::element::f16);","+    });","+    const auto split = ov::pass::pattern::wrap_type<ov::op::v1::Split>(","+        {protected_fp32, ov::pass::pattern::any_input()},","+        [](const ov::Output<ov::Node>& value) {","+            return !ov::is_conversion_disabled(value.get_node_shared_ptr(), ov::element::f16);","+        });","+    const ov::matcher_pass_callback callback = [OV_CAPTURE_CPY_AND_THIS](ov::pass::pattern::Matcher& matcher) {","+        const auto node = matcher.get_match_root();","+        if (transformation_callback(node))","+            return false;","+        const auto input = matcher.get_pattern_value_map().at(protected_fp32);","+        const auto boundary = std::make_shared<ov::op::v0::Convert>(input, input.get_element_type());","+        ov::copy_runtime_info(node, boundary);","+        node->input(0).replace_source_output(boundary);","+        return true;","+    };","+    register_matcher(std::make_shared<ov::pass::pattern::Matcher>(split, \"gguf::IsolatePrecisionSensitiveOutputs\"),","+                     callback);","+}","+","+}  // namespace ov::frontend::gguf::pass"],"additions":40,"deletions":0,"truncated":false},{"path":"src/frontends/gguf/src/pass/isolate_precision_sensitive_outputs.hpp","lines":["@@ -0,0 +1,20 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#pragma once","+","+#include \"openvino/pass/matcher_pass.hpp\"","+","+namespace ov::frontend::gguf::pass {","+","+// Add a same-type Convert between a protected FP32 producer and an unprotected Split.","+// Inference-precision lowering can then convert once before splitting, while retaining","+// the producer's computation precision and the original graph's types and values.","+class IsolatePrecisionSensitiveOutputs : public ov::pass::MatcherPass {","+public:","+    OPENVINO_MATCHER_PASS_RTTI(\"ov::frontend::gguf::pass::IsolatePrecisionSensitiveOutputs\");","+    IsolatePrecisionSensitiveOutputs();","+};","+","+}  // namespace ov::frontend::gguf::pass"],"additions":20,"deletions":0,"truncated":false},{"path":"src/frontends/gguf/src/pass/simplify_activation_shapes.cpp","lines":["@@ -0,0 +1,167 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"pass/simplify_activation_shapes.hpp\"","+","+#include <algorithm>","+#include <unordered_set>","+","+#include \"openvino/core/graph_util.hpp\"","+#include \"openvino/core/rt_info.hpp\"","+#include \"openvino/op/constant.hpp\"","+#include \"openvino/op/convert.hpp\"","+#include \"openvino/op/gather.hpp\"","+#include \"openvino/op/normalize_l2.hpp\"","+#include \"openvino/op/reduce_mean.hpp\"","+#include \"openvino/op/reduce_sum.hpp\"","+#include \"openvino/op/reshape.hpp\"","+#include \"openvino/op/squeeze.hpp\"","+#include \"openvino/op/swish.hpp\"","+#include \"openvino/op/unsqueeze.hpp\"","+#include \"openvino/op/util/binary_elementwise_arithmetic.hpp\"","+#include \"openvino/op/util/symbolic_info.hpp\"","+#include \"openvino/op/util/unary_elementwise_arithmetic.hpp\"","+#include \"openvino/pass/manager.hpp\"","+#include \"transformations/symbolic_transformations/symbolic_optimizations.hpp\"","+#include \"transformations/symbolic_transformations/utils.hpp\"","+#include \"transformations/utils/utils.hpp\"","+","+namespace ov::frontend::gguf::pass {","+namespace {","+","+bool activation_shape(const ov::PartialShape& shape) {","+    return shape.rank() == 4 && shape[1] == 1;","+}","+","+ov::PartialShape reduced_shape(const ov::PartialShape& shape) {","+    return {shape[0], shape[2], shape[3]};","+}","+","+bool same_shape(const ov::PartialShape& lhs, const ov::PartialShape& rhs) {","+    if (lhs.rank().is_dynamic() || lhs.rank() != rhs.rank())","+        return false;","+    for (size_t i = 0; i < lhs.size(); ++i) {","+        if (!ov::symbol::util::dims_are_equal(lhs[i], rhs[i]))","+            return false;","+    }","+    return true;","+}","+","+ov::Output<ov::Node> unwrapped(const ov::Output<ov::Node>& value) {","+    const auto node = ov::as_type_ptr<ov::op::v0::Unsqueeze>(value.get_node_shared_ptr());","+    if (node && node->input_value(0).get_partial_shape().rank() == 3 &&","+        ov::op::util::has_constant_value<int64_t>(node->get_input_node_shared_ptr(1), 1))","+        return node->input_value(0);","+    return value;","+}","+","+}  // namespace","+","+bool SimplifyActivationShapes::run_on_model(const std::shared_ptr<ov::Model>& model) {","+    ov::pass::Manager symbols;","+    symbols.set_per_pass_validation(false);","+    symbols.register_pass<ov::pass::SymbolicPropagation>();","+    symbols.run_passes(model);","+    const auto nodes = model->get_ordered_ops();","+    std::unordered_set<const ov::Node*> constants;","+    for (const auto& node : nodes) {","+        const auto inputs = node->inputs();","+        if (ov::is_type<ov::op::v0::Constant>(node) ||","+            (!inputs.empty() && std::all_of(in