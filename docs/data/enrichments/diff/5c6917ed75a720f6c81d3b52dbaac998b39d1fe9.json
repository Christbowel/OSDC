ape->get_input_partial_shape(0));","+                if (reshape->get_special_zero() && !reduced_input)","+                    continue;","+                const auto indices = ov::op::v0::Constant::create(ov::element::i64, {3}, {0, 2, 3});","+                const auto zero = ov::op::v0::Constant::create(ov::element::i64, {}, {0});","+                const auto target =","+                    ov::op::util::make_try_fold<ov::op::v8::Gather>(reshape->input_value(1), indices, zero);","+                created.insert(created.end(), {indices, zero, target});","+                result = std::make_shared<ov::op::v1::Reshape>(reduced_input ? lower(reshape->input_value(0)) : value,","+                                                               target,","+                                                               reshape->get_special_zero());","+            }","+        } else if (ov::is_type_any_of<ov::op::v1::ReduceMean, ov::op::v1::ReduceSum, ov::op::v0::NormalizeL2>(node)) {","+            if (!activation_shape(node->get_input_partial_shape(0)))","+                continue;","+            const auto axes = ov::as_type_ptr<ov::op::v0::Constant>(node->get_input_node_shared_ptr(1));","+            if (!ov::op::util::has_constant_value<int64_t>(axes, -1) &&","+                !ov::op::util::has_constant_value<int64_t>(axes, 3))","+                continue;","+            const auto last = ov::op::v0::Constant::create(axes->get_element_type(), axes->get_shape(), {-1});","+            created.push_back(last);","+            result = node->clone_with_new_inputs({lower(node->input_value(0)), last});","+        } else {","+            const auto binary = ov::as_type_ptr<ov::op::util::BinaryElementwiseArithmetic>(node);","+            if (binary) {","+                const auto type = binary->get_autob().m_type;","+                if (type != ov::op::AutoBroadcastType::NUMPY && type != ov::op::AutoBroadcastType::NONE)","+                    continue;","+                cons