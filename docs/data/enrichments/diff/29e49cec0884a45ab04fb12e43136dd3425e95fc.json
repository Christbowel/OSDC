ar DbTask $entity */","+\t\t$entity = $this->taskMapper->insert(DbTask::fromPublicTask($task));","+\t\treturn $entity;","+\t}","+","+\tpublic function testCountTasks(): void {","+\t\t// Far in the future, so that tasks of other tests are outside of the window","+\t\t$now = time() + 365 * 24 * 3600;","+\t\t$window = $now - 7200;","+\t\t$totalBefore = $this->manager->countTasks();","+\t\t$entities = [];","+","+\t\ttry {","+\t\t\t// Scheduled within the window, picked up after 1 minute","+\t\t\t$entities[] = $this->insertTask(Task::STATUS_SUCCESSFUL, $now - 3600, $now - 3540);","+\t\t\t// Scheduled within the window, picked up after 10 minutes","+\t\t\t$entities[] = $this->insertTask(Task::STATUS_SUCCESSFUL, $now - 3600, $now - 3000);","+\t\t\t// Scheduled within the window, picked up after 10 minutes, but failed","+\t\t\t$entities[] = $this->insertTask(Task::STATUS_FAILED, $now - 3600, $now - 3000);","+\t\t\t// Scheduled within the window, never picked up","+\t\t\t$entities[] = $this->insertTask(Task::STATUS_CANCELLED, $now - 3600, null);","+\t\t\t// Scheduled before the window, picked up after 10 minutes","+\t\t\t$entities[] = $this->insertTask(Task::STATUS_SUCCESSFUL, $now - 90000, $now - 89400);","+","+\t\t\tself::assertEquals($totalBefore + 5, $this->manager->countTasks());","+\t\t\tself::assertEquals(4, $this->manager->countTasks(scheduleAfter: $window));","+\t\t\tself::assertEquals(1, $this->manager->countTasks(status: Task::STATUS_FAILED, scheduleAfter: $window));","+\t\t\t// Tasks that were never picked up are not counted as slow","+\t\t\tself::assertEquals(2, $this->manager->countTasks(scheduleAfter: $window, minPickupDelay: 60 * 4));","+\t\t\tself::assertEquals(1, $this->manager->countTasks(status: Task::STATUS_SUCCESSFUL, scheduleAfter: $window, minPickupDelay: 60 * 4));","+\t\t\tself::assertEquals(0, $this->manager->countTasks(scheduleAfter: $window, minPickupDelay: 60 * 20));","+\t\t\tself::assertEquals(4, $this->manager->countTasks(taskTypeIds: [TextToText::ID], scheduleAfter: $window));","+\t\t\tself::assertEquals(0, $this->manager->countTasks(taskTypeIds: [TextToImage::ID], scheduleAfter: $window));","+\t\t} finally {","+\t\t\tforeach ($entities as $entity) {","+\t\t\t\t$this->taskMapper->delete($entity);","+\t\t\t}","+\t\t}","+\t}","+"," \tpublic function testOldTasksShouldBeCleanedUp(): void {"," \t\t$currentTime = new \\DateTime('now');"," \t\t$timeFactory = $this->createMock(ITimeFactory::class);",""],"additions":49,"deletions":0,"truncated":false}],"additions":195,"deletions":123,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-09-21T15:30:22.435425+00:00"}