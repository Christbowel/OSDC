"+","+use super::{","+    FreshnessCheckError, LockfileFreshnessInputs,","+    directory_deps::{InjectedDirectory, is_declared_local_directory, unhooked_manifest},","+    project_manifests_by_dir,","+};","+use crate::install::{Arc, Lockfile, PackageManifest, PathBuf};","+use pnpm_package_manifest::DependencyGroup;","+use std::collections::HashSet;","+","+/// The manifests of the dependencies `lockfile` records as injected into","+/// the importers of `inputs`, keyed by their directory, with","+/// `packageExtensions` and the pnpmfile's `readPackage` applied as the","+/// resolver applied them.","+///","+/// Empty unless the importer is a workspace project with its own lockfile.","+/// Every other install holds the injected projects among its own, already","+/// hooked; this one holds only itself.","+pub(super) async fn hooked_injected_manifests(","+    lockfile: &Lockfile,","+    inputs: &LockfileFreshnessInputs<'_, '_>,","+) -> Result<Vec<(PathBuf, PackageManifest)>, FreshnessCheckError> {","+    let config = inputs.config;","+    if config.shares_one_lockfile()","+        || (inputs.pnpmfile_hook.is_none() && config.package_extensions.is_none())","+    {","+        return Ok(Vec::new());","+    }","+    let mut injected = unhooked_injected_manifests(lockfile, inputs);","+    if let Some(extensions) = config.package_extensions.as_ref() {","+        let extender = crate::PackageExtender::new(extensions)","+            .map_err(FreshnessCheckError::InvalidPackageExtensionSelector)?;","+        for manifest in &mut injected {","+            extender.apply(manifest.manifest.value_mut());","+        }","+    }","+    let Some(hook) = inputs.pnpmfile_hook else {","+        return Ok(injected","+            .into_iter()","+            .map(|injected| (injected.dir, injected.manifest))","+            .collect());","+    };","+    futures_util::future::try_join_all(","+        injected","+            .into_iter()","+            .map(|injected| async move {","+                // The resolver hands the hook the directory the lockfile records.","+                let ctx = pnpm_hooks::HookContext {","+                    log: Arc::new(|_| {}),","+                    dir: Some(injected.recorded_directory),","+                };","+                let hooked = hook","+                    .read_package(injected.manifest.value().clone(), ctx)","+                    .await","+                    .map_err(FreshnessCheckError::ReadPackageHook)?;","+                let mut manifest = injected.manifest;","+                *manifest.value_mut() = (*hooked).clone();","+                Ok((injected.dir, manifest))","+            }),","+    )","+    .await","+}","+","+struct InjectedManifest {","+    dir: PathBuf,","+    recorded_directory: String,","+    manifest: PackageManifest,","+}","+","+fn unhooked_injected_manifests(","+    lockfile: &Lockfile,","+    inputs: &LockfileFreshnessInputs<'_, '_>,","+) -> Vec<InjectedManifest> {","+    let manifests_by_dir = project_manifests_by_dir(","+        inputs.manifests.iter().map(|(_, manifest)| *manifest),","+        inputs.dependency_manifests,","+    );","+    let workspace_root = inputs.config.workspace_dir.as_deref().unwrap_or(inputs.lockfile_dir);","+    let mut manifests: Vec<InjectedManifest> = Vec::new();","+    let mut seen: HashSet<PathBuf> = HashSet::new();","+    for (importer_id, _) in inputs.manifests {","+        let groups = [DependencyGroup::Prod, DependencyGroup::Dev, DependencyGroup::Optional];","+        for dependency in lockfile.injected_dependencies(importer_id, groups) {","+            let dir = pnpm_fs::lexical_normalize(&inputs.lockfile_dir.join(","+                &dependency.directory.directory,","+            ));","+            if manifests_by_dir.contains_key(&dir) || !seen.insert(dir.clone()) {","+                continue;","+            }","+            let Some(manifest) = unhooked_manifest(&InjectedDirectory {","+                dir: &dir,","+                declared_as_file: is_declared_local_directory(&dependency.spec.specifier),","+                workspace_root,","+                manifests_by_dir: &manifests_by_dir,","+            }) else {","+                continue;","+            };","+            manifests.push(InjectedManifest {","+                dir,","+                recorded_directory: dependency.directory.directory.clone(),","+                manifest,","+            });","+        }","+    }","+    manifests","+}"],"additions":108,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run/dispatch.rs","lines":["@@ -422,7 +422,9 @@ pub(super) async fn auto_frozen_path(","         Err(","             error @ (FreshnessCheckError::InvalidCatalog(_)","             | FreshnessCheckError::InvalidOverrides(_)","-            | FreshnessCheckError::CalcPatchHashes(_)),","+            | FreshnessCheckError::CalcPatchHashes(_)","+            | FreshnessCheckError::InvalidPackageExtensionSelector(_)","+            | FreshnessCheckError::ReadPackageHook(_)),","         ) => Err(error.into()),","     }"," }"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/run/manifests.rs","lines":["@@ -88,8 +88,7 @@ pub(super) fn resolve_pnpmfile_hook(","     if config.ignore_pnpmfile {","         return Ok(None);","     }","-    pnpm_hooks::finder::load_pnpmfiles(workspace_root, crate::pnpmfile_selection(config))","-        .map_err(InstallError::MissingPnpmfile)","+    crate::load_install_pnpmfiles(config, workspace_root).map_err(InstallError::MissingPnpmfile)"," }"," /// Borrow the rewritten manifests when a pass produced any, keeping the"],"additions":1,"deletions":2,"truncated":false}],"additions":466,"deletions":53,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-10-18T13:00:46.272335+00:00"}