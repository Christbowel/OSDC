{"id":"cf6770e47c1e58aed8509c65ca9ad5d804c3fc4b","axis":"silent","repo":"pnpm/pnpm","sha":"cf6770e47c1e58aed8509c65ca9ad5d804c3fc4b","parsed":{"files":[{"path":".changeset/global-pnpmfile-own-lockfiles.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/installing.commands\": patch","+\"pnpm\": patch","+---","+","+With `sharedWorkspaceLockfile: false`, `pnpm install` now runs the `preResolution` hooks and custom resolvers and fetchers of the workspace root's pnpmfile for every project, next to the project's own. A global pnpmfile now runs once per project, and each project's lockfile records the checksum of the root pnpmfile when the project has none of its own. Before, a project's own pnpmfile replaced these root hooks, the global hooks ran twice, and edits to the root pnpmfile could go unnoticed."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/root-pnpmfile-own-lockfiles.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+With `sharedWorkspaceLockfile: false`, `pnpm install` now runs the workspace root's pnpmfile for every project, after the project's own pnpmfile. Before, it ran only the pnpmfile in the project's directory."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hooks.rs","lines":["@@ -1416,3 +1416,99 @@ patchedDependencies:"," ","     drop((root, mock_instance));"," }","+","+/// A workspace whose projects keep their own lockfiles, with `root_pnpmfile`","+/// at the workspace root and `projects` as `(name, manifest)` pairs.","+fn write_own_lockfile_workspace(","+    workspace: &Path,","+    root_pnpmfile: &str,","+    projects: &[(&str, serde_json::Value)],","+) {","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - 'packages/*'\\nsharedWorkspaceLockfile: false\\ninjectWorkspacePackages: true\\ndedupeInjectedDeps: false\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"root\", \"private\": true }).to_string(),","+    )","+    .expect(\"write root package.json\");","+    fs::write(workspace.join(\".pnpmfile.cjs\"), root_pnpmfile).expect(\"write root pnpmfile\");","+    for (name, manifest) in projects {","+        let dir = workspace.join(\"packages\").join(name);","+        fs::create_dir_all(&dir).expect(\"mkdir project\");","+        fs::write(dir.join(\"package.json\"), manifest.to_string()).expect(\"write project manifest\");","+    }","+}","+","+/// pnpm loads the workspace root's pnpmfile for a project with its own","+/// lockfile too, and records its checksum there.","+#[test]","+fn root_pnpmfile_applies_to_a_project_with_its_own_lockfile() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_own_lockfile_workspace(","+        &workspace,","+        \"module.exports = { hooks: { readPackage (pkg) { if (pkg.name === 'is-positive') pkg.dependencies = { ...pkg.dependencies, 'is-negative': '1.0.0' }; return pkg } } }\\n\",","+        &[(","+            \"app\",","+            serde_json::json!({ \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"is-positive\": \"1.0.0\" } }),","+        )],","+    );","+","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"packages/app/pnpm-lock.yaml\"))","+        .expect(\"read the project's lockfile\");","+    assert!(lockfile.contains(\"pnpmfileChecksum\"), \"{lockfile}\");","+    assert!(lockfile.contains(\"is-negative@1.0.0\"), \"{lockfile}\");","+","+    drop((root, mock_instance));","+}","+","+/// The consumer's lockfile records an injected project as the root","+/// pnpmfile rewrote it, and the frozen install compares it with the","+/// rewritten manifest.","+#[test]","+fn frozen_install_accepts_an_injected_project_the_root_pnpmfile_rewrites() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_own_lockfile_workspace(","+        &workspace,","+        \"module.exports = { hooks: { readPackage (pkg) { if (pkg.name === 'lib') pkg.dependencies['is-positive'] = '2.0.0'; return pkg } } }\\n\",","+        &[","+            (","+                \"lib\",","+                serde_json::json!({ \"name\": \"lib\", \"version\": \"1.0.0\", \"dependencies\": { \"is-positive\": \"1.0.0\" } }),","+            ),","+            (","+                \"app\",","+                serde_json::json!({ \"name\": \"app\", \"version\": \"1.0.0\", \"dependencies\": { \"lib\": \"workspace:*\" } }),","+            ),","+        ],","+    );","+","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let lockfile = fs::read_to_string(workspace.join(\"packages/app/pnpm-lock.yaml\"))","+        .expect(\"read the consumer's lockfile\");","+    assert!(lockfile.contains(\"is-positive@2.0.0\"), \"{lockfile}\");","+","+    for dir in [\"node_modules\", \"packages/lib/node_modules\", \"packages/app/node_modules\"] {","+        let _ = fs::remove_dir_all(workspace.join(dir));","+    }","+    pacquet_in(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+","+    drop((root, mock_instance));","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"pnpm/crates/hooks/src/finder.rs","lines":["@@ -160,14 +160,66 @@ pub fn load_pnpmfiles(","         // has to go through the wrapper, including a lone global one: its hash","         // must not become the project's.","         (1, 0) => hooks.into_iter().next(),","-        _ => Some(Arc::new(CombinedPnpmfileHooks { hooks, checksum_skips })),","+        _ => Some(Arc::new(CombinedPnpmfileHooks {","+            workspace_hooks_from: hooks.len(),","+            hooks,","+            checksum_skips,","+        })),","     })"," }"," ","+/// The pnpmfiles an install of a workspace project with its own lockfile","+/// runs: the project's own (see [`load_pnpmfiles`]), then the workspace","+/// root's that are not among them, the global pnpmfile once. The","+/// `pnpmfileChecksum` covers the project's pnpmfiles when they define any","+/// hooks, else the workspace root's.","+pub fn load_workspace_project_pnpmfiles(","+    project_dir: &Path,","+    workspace_root: &Path,","+    selection: PnpmfileSelection<'_>,","+) -> Result<Option<Arc<dyn PnpmfileHooks>>, MissingPnpmfileError> {","+    validate_configured_pnpmfiles(selection)?;","+    let project_paths = find_pnpmfiles(project_dir, selection);","+    let workspace_paths: Vec<PathBuf> =","+        find_pnpmfiles(workspace_root, PnpmfileSelection { global: None, ..selection })","+            .into_iter()","+            .filter(|path| !project_paths.contains(path))","+            .collect();","+    if workspace_paths.is_empty() {","+        return load_pnpmfiles(project_dir, selection);","+    }","+    let workspace_hooks_from = project_paths.len();","+    let hooks: Vec<_> = project_paths","+        .into_iter()","+        .chain(workspace_paths)","+        .map(load_pnpmfile_at)","+        .collect();","+    Ok(Some(Arc::new(CombinedPnpmfileHooks {","+        hooks,","+        checksum_skips: usize::from(selection.global.is_some()),","+        workspace_hooks_from,","+    })))","+}","+","+/// Whether any of `hooks` exports a `hooks` object, which is what makes a","+/// pnpmfile count toward `pnpmfileChecksum`.","+async fn defines_hooks(hooks: &[Arc<dyn PnpmfileHooks>]) -> bool {","+    for hook in hooks {","+        if hook.calculate_pnpmfile_checksum().await.is_some() {","+            return true;","+        }","+    }","+    false","+}","+"," struct CombinedPnpmfileHooks {","     hooks: Vec<Arc<dyn PnpmfileHooks>>,","     /// How many leading entries of [`Self::hooks`] the checksum leaves out.","     checksum_skips: usize,","+    /// Where the workspace root's hooks start (see","+    /// [`load_workspace_project_pnpmfiles`]), or `hooks.len()` when there are","+    /// none.","+    workspace_hooks_from: usize,"," }"," "," #[async_trait]","@@ -254,15 +306,20 @@ impl PnpmfileHooks for CombinedPnpmfileHooks {","     }"," ","     async fn calculate_pnpmfile_checksum(&self) -> Option<String> {","-        let mut includes_hooks = false;","-        for hook in &self.hooks {","-            includes_hooks |= hook.calculate_pnpmfile_checksum().await.is_some();","-        }","-        if !includes_hooks {","+        let (project_hooks, workspace_hooks) = self.hooks.split_at(self.workspace_hooks_from);","+        let (global_hooks, project_hooks) = project_hooks.split_at(self.checksum_skips);","+        let checksummed = if defines_hooks(project_hooks).await {","+            project_hooks","+        } else if defines_hooks(workspace_hooks).await {","+            workspace_hooks","+        } else if defines_hooks(global_hooks).await {","+            // A lone global pnpmfile still records a checksum, over no file.","+            project_hooks","+        } else {","             return None;","-        }","+        };"," ","-        let mut paths: Vec<&Path> = self.hooks[self.checksum_skips..]","+        let mut paths: Vec<&Path> = checksummed","             .iter()","             .filter_map(|hook| hook.source_path())","             .collect();"],"additions":65,"deletions":8,"truncated":false},{"path":"pnpm/crates/hooks/tests/node_hooks/integrity.rs","lines":["@@ -75,3 +75,89 @@ async fn current_pnpmfile_checksum_trusts_the_hash_when_the_lockfile_records_one","         Some(recorded),","     );"," }","+","+const ROOT_PNPMFILE: &str = \"module.exports = { hooks: { readPackage: (pkg) => ({ ...pkg, order: (pkg.order ?? '') + 'root' }) } }\\n\";","+const PROJECT_PNPMFILE: &str = \"module.exports = { hooks: { readPackage: (pkg) => ({ ...pkg, order: (pkg.order ?? '') + 'project' }) } }\\n\";","+","+/// A workspace root holding [`ROOT_PNPMFILE`] and a project under it, with","+/// `project_pnpmfile` as the project's own when given.","+fn workspace_with_project(project_pnpmfile: Option<&str>) -> (TempDir, std::path::PathBuf) {","+    let tmp = TempDir::new().expect(\"temp dir\");","+    std::fs::write(tmp.path().join(\".pnpmfile.cjs\"), ROOT_PNPMFILE).expect(\"write root pnpmfile\");","+    let project = tmp.path().join(\"project\");","+    std::fs::create_dir(&project).expect(\"create project\");","+    if let Some(source) = project_pnpmfile {","+        std::fs::write(project.join(\".pnpmfile.cjs\"), source).expect(\"write project pnpmfile\");","+    }","+    (tmp, project)","+}","+","+fn load_workspace_project(","+    tmp: &TempDir,","+    project: &std::path::Path,","+) -> std::sync::Arc<dyn pnpm_hooks::PnpmfileHooks> {","+    finder::load_workspace_project_pnpmfiles(","+        project,","+        tmp.path(),","+        finder::PnpmfileSelection::default(),","+    )","+    .expect(\"no configured pnpmfile is missing\")","+    .expect(\"the workspace root has a pnpmfile\")","+}","+","+/// pnpm v11 runs a project's own hooks before those it loaded at the","+/// workspace root.","+#[tokio::test]","+async fn workspace_project_pnpmfiles_run_the_project_hook_before_the_root_hook() {","+    let (tmp, project) = workspace_with_project(Some(PROJECT_PNPMFILE));","+    let hooks = load_workspace_project(&tmp, &project);","+    let pkg = hooks","+        .read_package(serde_json::json!({ \"name\": \"foo\" }), super::noop_context())","+        .await","+        .expect(\"readPackage should succeed\");","+    assert_eq!(pkg[\"order\"], \"projectroot\");","+}","+","+#[tokio::test]","+async fn workspace_project_pnpmfile_checksum_covers_the_project_pnpmfile_when_it_has_one() {","+    let (tmp, project) = workspace_with_project(Some(PROJECT_PNPMFILE));","+    assert_eq!(","+        load_workspace_project(&tmp, &project).calculate_pnpmfile_checksum().await,","+        Some(pnpm_crypto_hash::create_hash(PROJECT_PNPMFILE)),","+    );","+}","+","+#[tokio::test]","+async fn workspace_project_pnpmfile_checksum_covers_the_root_pnpmfile_otherwise() {","+    let (tmp, project) = workspace_with_project(None);","+    let hooks = load_workspace_project(&tmp, &project);","+    let pkg = hooks","+        .read_package(serde_json::json!({ \"name\": \"foo\" }), super::noop_context())","+        .await","+        .expect(\"readPackage should succeed\");","+    assert_eq!(pkg[\"order\"], \"root\");","+    assert_eq!(","+        hooks.calculate_pnpmfile_checksum().await,","+        Some(pnpm_crypto_hash::create_hash(ROOT_PNPMFILE)),","+    );","+}","+","+/// The global pnpmfile is not the project's: with no pnpmfile of its own, the","+/// project's checksum covers the workspace root's.","+#[tokio::test]","+async fn workspace_project_pnpmfile_checksum_covers_the_root_pnpmfile_beside_a_global_one() {","+    let (tmp, project) = workspace_with_project(None);","+    let global = tmp.path().join(\"global.cjs\");","+    std::fs::write(&global, PROJECT_PNPMFILE).expect(\"write global pnpmfile\");","+    let hooks = finder::load_workspace_project_pnpmfiles(","+        &project,","+        tmp.path(),","+        finder::PnpmfileSelection { global: Some(&global), ..Default::default() },","+    )","+    .expect(\"no configured pnpmfile is missing\")","+    .expect(\"the workspace root has a pnpmfile\");","+    assert_eq!(","+        hooks.calculate_pnpmfile_checksum().await,","+        Some(pnpm_crypto_hash::create_hash(ROOT_PNPMFILE)),","+    );","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"pnpm/crates/lockfile/src/injected_deps.rs","lines":["@@ -1,6 +1,6 @@"," //! Which direct dependencies of an importer are injected."," ","-use crate::{Lockfile, LockfileResolution, PkgName};","+use crate::{DirectoryResolution, Lockfile, LockfileResolution, PkgName, ResolvedDependencySpec};"," use pnpm_package_manifest::DependencyGroup;"," "," impl Lockfile {","@@ -17,24 +17,31 @@ impl Lockfile {","         &'a self,","         importer_id: &str,","         groups: impl IntoIterator<Item = DependencyGroup> + 'a,","-    ) -> impl Iterator<Item = &'a PkgName> + 'a {","+    ) -> impl Iterator<Item = InjectedDependency<'a>> + 'a {","         let packages = self.packages.as_ref();","         self.importers","             .get(importer_id)","             .map(|importer| importer.dependencies_by_groups(groups))","             .into_iter()","             .flatten()","-            .filter(move |(alias, spec)| {","-                spec.version","-                    .resolved_key(alias)","-                    .and_then(|key| packages?.get(&key.without_peer()))","-                    .is_some_and(|metadata| {","-                        matches!(metadata.resolution, LockfileResolution::Directory(_))","-                    })","+            .filter_map(move |(alias, spec)| {","+                let metadata = packages?.get(&spec.version.resolved_key(alias)?.without_peer())?;","+                match &metadata.resolution {","+                    LockfileResolution::Directory(directory) => {","+                        Some(InjectedDependency { alias, spec, directory })","+                    }","+                    _ => None,","+                }","             })","-            .map(|(alias, _)| alias)","     }"," }"," ","+/// One entry of [`Lockfile::injected_dependencies`].","+pub struct InjectedDependency<'a> {","+    pub alias: &'a PkgName,","+    pub spec: &'a ResolvedDependencySpec,","+    pub directory: &'a DirectoryResolution,","+}","+"," #[cfg(test)]"," mod tests;"],"additions":17,"deletions":10,"truncated":false},{"path":"pnpm/crates/lockfile/src/injected_deps/tests.rs","lines":["@@ -17,7 +17,7 @@ fn injected_in_groups(","     let lockfile: Lockfile = serde_saphyr::from_str(lockfile).unwrap();","     let mut aliases = lockfile","         .injected_dependencies(importer_id, groups)","-        .map(ToString::to_string)","+        .map(|dependency| dependency.alias.to_string())","         .collect::<Vec<_>>();","     aliases.sort();","     aliases"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/lockfile/src/lib.rs","lines":["@@ -6,6 +6,7 @@ pub use comver::*;"," pub use env_lockfile::*;"," pub use filter_by_importers::*;"," pub use freshness::*;","+pub use injected_deps::*;"," pub use lazy_lockfile::*;"," pub use load_lockfile::*;"," pub use lockfile_version::*;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness.rs","lines":["@@ -11,6 +11,8 @@ pub(crate) use manifest::{","     check_importer_satisfies,"," };"," ","+mod injected_manifests;","+"," use rayon::prelude::*;"," "," use super::{","@@ -339,20 +341,29 @@ pub(super) async fn check_lockfile_freshness(","         }));","     }"," ","-    check_importer_freshness(lockfile, inputs, parsed_overrides_opt.as_deref())","+    let injected = injected_manifests::hooked_injected_manifests(lockfile, inputs).await?;","+    check_importer_freshness(lockfile, inputs, (parsed_overrides_opt.as_deref(), &injected))"," }"," "," // Parallel checks settle before the serial fold reports the first error in importer order."," fn check_importer_freshness(","     lockfile: &Lockfile,","     inputs: &LockfileFreshnessInputs<'_, '_>,","-    parsed_overrides: Option<&[pnpm_config_parse_overrides::VersionOverride]>,","+    (parsed_overrides, injected): (","+        Option<&[pnpm_config_parse_overrides::VersionOverride]>,","+        &[(PathBuf, PackageManifest)],","+    ),"," ) -> Result<Vec<UnresolvedOptionalDependency>, FreshnessCheckError> {","     let ignored_optional_matcher = ignored_optional_matcher(inputs.config);","-    let project_manifests = project_manifests_by_dir(","+    let mut project_manifests = project_manifests_by_dir(","         inputs.manifests.iter().map(|(_, manifest)| *manifest),","         inputs.dependency_manifests,","     );","+    project_manifests.extend(","+        injected","+            .iter()","+            .map(|(dir, manifest)| (dir.clone(), manifest)),","+    );","     // Each importer's check reads only shared references, so a","     // workspace-scale importer list fans out across the rayon pool; the","     // serial fold keeps the first error in importer order."],"additions":14,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps.rs","lines":["@@ -133,7 +133,7 @@ fn dependency_is_injected(","         .unwrap_or(false)"," }"," ","-fn is_declared_local_directory(spec: &str) -> bool {","+pub(super) fn is_declared_local_directory(spec: &str) -> bool {","     let Some(path) = spec.strip_prefix(\"file:\") else {","         return false;","     };","@@ -186,49 +186,69 @@ fn check_single_dep_spec_directory_freshness(","     Ok(())"," }"," ","-/// The manifest the resolver described the dependency with. A workspace","-/// project injected as its `publishConfig.directory` is described by the","-/// project's own manifest, not by a `package.json` a build wrote into that","-/// directory. A `file:` dependency is described by the directory's","-/// `package.json`, and by the publishing project's only while that is","-/// missing."," fn read_and_override_manifest(","     check: &ImporterSatisfactionCheck<'_>,","     dep: &LocalDepContext<'_>,"," ) -> Result<PackageManifest, FreshnessCheckError> {","-    let manifests_by_dir = check.workspace.manifests_by_dir;","+    let mut local_manifest = unhooked_manifest(&InjectedDirectory {","+        dir: dep.dir,","+        declared_as_file: dep.declared_as_file,","+        workspace_root: dep.dirs.workspace_root,","+        manifests_by_dir: check.workspace.manifests_by_dir,","+    })","+    .ok_or_else(|| dep.outdated())?;","+    if let Some(parsed) = check.parsed_overrides {","+        crate::VersionsOverrider::new(parsed, check.lockfile_dir)","+            .apply(&mut local_manifest, Some(dep.dir));","+    }","+    Ok(local_manifest)","+}","+","+/// A local directory dependency's directory and where its manifest may come","+/// from.","+pub(super) struct InjectedDirectory<'a> {","+    pub(super) dir: &'a Path,","+    /// See [`LocalDepContext::declared_as_file`].","+    pub(super) declared_as_file: bool,","+    pub(super) workspace_root: &'a Path,","+    pub(super) manifests_by_dir: &'a ProjectManifestsByDir<'a>,","+}","+","+/// The manifest the resolver described the dependency with, before any hook.","+/// A workspace project injected as its `publishConfig.directory` is","+/// described by the project's own manifest, not by a `package.json` a build","+/// wrote into that directory. A `file:` dependency is described by the","+/// directory's `package.json`, and by the publishing project's only while","+/// that is missing.","+pub(super) fn unhooked_manifest(injected: &InjectedDirectory<'_>) -> Option<PackageManifest> {","     let project_manifest = || {","-        manifests_by_dir","-            .get(&pnpm_fs::lexical_normalize(dep.dir))","+        injected.manifests_by_dir","+            .get(&pnpm_fs::lexical_normalize(injected.dir))","             .map(|manifest| (*manifest).clone())","     };","-    let on_disk = || pnpm_workspace::safe_read_project_manifest_only(dep.dir).ok().flatten();","-    let publishing_project = || manifest_of_project_publishing_from(dep);","-    let local_manifest = if dep.declared_as_file {","+    let on_disk = || pnpm_workspace::safe_read_project_manifest_only(injected.dir).ok().flatten();","+    let publishing_project = || manifest_of_project_publishing_from(injected);","+    if injected.declared_as_file {","         project_manifest().or_else(on_disk).or_else(publishing_project)","     } else {","         project_manifest().or_else(publishing_project).or_else(on_disk)","-  