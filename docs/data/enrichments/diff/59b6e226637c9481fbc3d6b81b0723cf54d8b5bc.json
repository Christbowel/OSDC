{"id":"59b6e226637c9481fbc3d6b81b0723cf54d8b5bc","axis":"silent","repo":"pnpm/pnpm","sha":"59b6e226637c9481fbc3d6b81b0723cf54d8b5bc","parsed":{"files":[{"path":".changeset/pnpr-upstream-metadata.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now fetches the package document when an upstream answers a version manifest request with HTTP 501. Scoped version manifests and attestations use an encoded package name.","+","+Package resolution and lockfile verification now send custom upstream headers on npm, Cargo, and Python package metadata requests. Importing a registry with credentials requires HTTPS or loopback HTTP, including IPv4-mapped loopback addresses."],"additions":7,"deletions":0,"truncated":false},{"path":".config/crate-layers.toml","lines":["@@ -379,7 +379,7 @@ pnpm-workspace-task-scheduler = 2"," pnpr = 41"," pnpr-auth = 6"," pnpr-cargo = 2","-pnpr-config = 8","+pnpr-config = 9"," pnpr-fixtures = 5"," pnpr-libsql = 3"," pnpr-osv = 3"],"additions":1,"deletions":1,"truncated":false},{"path":"Cargo.lock","lines":["@@ -7511,6 +7511,7 @@ dependencies = [","  \"pnpm-config-dir\",","  \"pnpm-deps-path\",","  \"pnpm-env-replace\",","+ \"pnpm-network\",","  \"pnpm-testing-utils\",","  \"pnpm-transparency-log\",","  \"pnpr-error\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/network/src/auth.rs","lines":["@@ -94,6 +94,11 @@ pub trait UpstreamRouteHook: Send + Sync {","     /// route the decision selected. `None` means fetch anonymously.","     fn authorize(&self, url: &str, package: Option<&str>) -> Option<String>;"," ","+    /// Headers owned by the selected route. Callers reselect them for each redirect.","+    fn request_headers(&self, url: &str, package: Option<&str>) -> reqwest::header::HeaderMap {","+        authorization_headers(self.authorize(url, package).as_deref())","+    }","+","     /// Whether this deployment may fetch `url` at all.","     ///","     /// A server resolves on behalf of callers who describe their own","@@ -502,6 +507,49 @@ impl AuthHeaders {","         self.for_url_with_package(url, pkg_name)","     }"," ","+    /// Select the deployment's headers for each hop within the original credential scope.","+    pub(crate) fn managed_request_headers<'a>(","+        &'a self,","+        start: &'a str,","+        package: Option<&'a str>,","+    ) -> Option<impl Fn(&str) -> reqwest::header::HeaderMap + 'a> {","+        let hook = self.route_hook.as_ref()?;","+        let origin = reqwest::Url::parse(start).ok().map(|url| url.origin());","+        let headers = if self.require_secure_transport && !is_url_secure_for_credentials(start) {","+            reqwest::header::HeaderMap::new()","+        } else {","+            hook.request_headers(start, package)","+        };","+        Some(move |url: &str| {","+            if url == start {","+                return headers.clone();","+            }","+            if !headers.is_empty()","+                && reqwest::Url::parse(url).is_ok_and(|url| Some(url.origin()) == origin)","+                && self.metadata_scope(start, package) == self.metadata_scope(url, package)","+            {","+                return hook.request_headers(url, package);","+            }","+            reqwest::header::HeaderMap::new()","+        })","+    }","+","+    pub(crate) fn secure_request_auth<'a>(","+        &'a self,","+        start: &'a str,","+    ) -> impl Fn(reqwest::RequestBuilder, &str) -> reqwest::RequestBuilder + 'a {","+        let managed = self.managed_request_headers(start, None);","+        move |request, url| {","+            if !is_url_secure_for_credentials(url) {","+                return request;","+            }","+            match &managed {","+                Some(headers) => request.headers(headers(url)),","+                None => apply_authorization(request, self.for_url(url)),","+            }","+        }","+    }","+","     /// Dispatch a GET locally when the route hook owns its destination.","     #[must_use]","     pub fn fetch_local(","@@ -575,6 +623,24 @@ impl AuthHeaders {","     }"," }"," ","+pub(super) fn apply_authorization(","+    request: reqwest::RequestBuilder,","+    value: Option<String>,","+) -> reqwest::RequestBuilder {","+    match value {","+        Some(value) => request.header(reqwest::header::AUTHORIZATION, value),","+        None => request,","+    }","+}","+","+fn authorization_headers(authorization: Option<&str>) -> reqwest::header::HeaderMap {","+    let mut headers = reqwest::header::HeaderMap::new();","+    if let Some(value) = authorization.map(str::parse).and_then(Result::ok) {","+        headers.insert(reqwest::header::AUTHORIZATION, value);","+    }","+    headers","+}","+"," /// Canonicalize an auth-map key to the trailing-slash form the lookup"," /// compares against, so `//reg.com` and `//reg.com/` cannot coexist as"," /// two entries for one registry."],"additions":66,"deletions":0,"truncated":false},{"path":"pnpm/crates/network/src/auth/tests.rs","lines":["@@ -54,7 +54,7 @@ fn registry_alias_does_not_change_outbound_credential_scope() {"," #[test]"," fn secure_transport_restricts_all_credential_lookups_and_survives_cloning() {","     let mut headers = AuthHeaders::default().with_secure_transport();","-    for host in [\"registry.example\", \"127.0.0.1\", \"localhost\", \"[::1]\"] {","+    for host in [\"registry.example\", \"127.0.0.1\", \"localhost\", \"[::1]\", \"[::ffff:127.0.0.2]\"] {","         headers.insert_url_header(&format!(\"https://{host}/simple/\"), \"Basic secret\".to_string());","     }","     for headers in [headers.clone(), headers] {","@@ -65,6 +65,7 @@ fn secure_transport_restricts_all_credential_lookups_and_survives_cloning() {","             (\"http://127.0.0.1/simple/pkg.whl\", true),","             (\"http://localhost/simple/pkg.whl\", true),","             (\"http://[::1]/simple/pkg.whl\", true),","+            (\"http://[::ffff:127.0.0.2]/simple/pkg.whl\", true),","         ] {","           