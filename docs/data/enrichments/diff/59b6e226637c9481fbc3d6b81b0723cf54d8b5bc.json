ientGuard,","+    retry::RequestRetry,","+};","+","+/// A registry metadata request and the package whose route supplies its headers.","+pub struct PackageRequest<'a> {","+    pub url: &'a str,","+    pub package: &'a str,","+    pub auth: &'a AuthHeaders,","+    pub headers: reqwest::header::HeaderMap,","+    pub method: reqwest::Method,","+    pub priority: u64,","+}","+","+impl PackageRequest<'_> {","+    pub async fn send<'client>(","+        &self,","+        client: &'client ThrottledClient,","+        retry: RetryOpts,","+    ) -> Result<(ThrottledClientGuard<'client>, Response), reqwest::Error> {","+        let mut retry = RequestRetry::new(self.url, retry);","+        loop {","+            if let Some(result) = retry.finish_attempt(self.send_once(client).await).await {","+                return result;","+            }","+        }","+    }","+","+    pub async fn send_once<'client>(","+        &self,","+        client: &'client ThrottledClient,","+    ) -> Result<(ThrottledClientGuard<'client>, Response), reqwest::Error> {","+        let Some(credentials) = self.auth.managed_request_headers(self.url, Some(self.package))","+        else {","+            let guard = client.acquire_for_url_with_priority(self.url, self.priority).await;","+            let request = crate::auth::apply_authorization(","+                guard.request(self.method.clone(), self.url).headers(self.headers.clone()),","+                self.auth.for_url_with_package(self.url, Some(self.package)),","+            );","+            let response = request","+                .send()","+                .await","+                .inspect_err(|error| client.downscale_on_timeout(self.url, error))?;","+            return Ok((guard, response));","+        };","+        let configure = |request: RequestBuilder, url: &str| {","+            request","+                .headers(self.headers.clone())","+                .headers(credentials(url))","+        };","+        let (response, guard) = client.package_response_with_scoped_headers(","+            self.method.clone(),","+            self.url,","+            self.priority,","+            configure,","+        )","+        .await?;","+        Ok((guard, response))","+    }","+}"],"additions":69,"deletions":0,"truncated":false},{"path":"pnpm/crates/network/src/requests.rs","lines":["@@ -89,7 +89,12 @@ impl ThrottledClient {","     ) -> Result<SecureAuthResponse, reqwest::Error> {","         let authorize = authorize_without_downgrade(auth_headers, url);","         retry::get_bytes(url, retry_opts, || {","-            self.get_limited_bytes_with_scoped_auth(url, authorize, accept, body_limit)","+            self.get_limited_bytes_with_scoped_auth(","+                url,","+                |request, hop| crate::auth::apply_authorization(request, authorize(hop)),","+                accept,","+                body_limit,","+            )","         })","         .await","     }","@@ -120,7 +125,7 @@ impl ThrottledClient {","         if let Some(response) = auth_headers.fetch_local(url, None, headers) {","             return self.read_response(response.await, body_limit).await;","         }","-        let authorize = |url: &str| auth_headers.for_secure_url(url);","+        let authorize = auth_headers.secure_request_auth(url);","         self.get_limited_bytes_with_scoped_auth(url, authorize, accept, body_limit).await","     }"," ","@@ -128,7 +133,7 @@ impl ThrottledClient {","     pub(super) async fn get_limited_bytes_with_scoped_auth(","         &self,","         url: &str,","-        authorize: impl Fn(&str) -> Option<String> + Sync,","+        authorize: impl Fn(reqwest::RequestBuilder, &str) -> reqwest::RequestBuilder + Sync,","         accept: Option<&str>,","         body_limit: usize,","     ) -> Result<SecureAuthResponse, reqwest::Error> {","@@ -136,10 +141,7 @@ impl ThrottledClient {","             if let Some(accept) = accept {","                 request = request.header(reqwest::header::ACCEPT, accept);"