 = new VectorSimilarityFilterOperator(reader,","+        new VectorSimilarityPredicate(ExpressionContext.forIdentifier(\"embedding\"), queryVector, 1), 10, params,","+        forward);","+    operator.setSearchDistances(searchDistances);","+","+    Assert.assertEquals(operator.getBitmaps().reduce().toArray(), new int[]{0});","+    Assert.assertNull(request.getDistances());","+    verify(reader, never()).getCosineDistances(any(float[].class), anyInt());","+  }","+","+  /// Without a request, a search collects only doc ids, so queries that do not project cosineDistance pay nothing.","+  @Test","+  public void testDoesNotAskForDistancesWithoutRequest() {","+    float[] queryVector = {1.0f, 2.0f, 3.0f};","+    VectorIndexReader reader = mock(VectorIndexReader.class);","+    when(reader.getDocIds(queryVector, 3)).thenReturn(MutableRoaringBitmap.bitmapOf(1, 3, 5));","+    VectorSearchDistances searchDistances = new VectorSearchDistances();","+    searchDistances.request(reader, new float[]{9.0f, 9.0f, 9.0f});","+","+    VectorSimilarityFilterOperator operator = newOperator(reader, queryVector, null);","+    operator.setSearchDistances(searchDistances);","+","+    Assert.assertEquals(operator.getBitmaps().reduce().toArray(), new int[]{1, 3, 5});","+    verify(reader, never()).getCosineDistances(any(float[].class), anyInt());","+  }","+","+  /// An index that returns no distances still answers the filter through `getDocIds`.","+  @Test","+  public void testFallsBackToDocIdsWhenIndexReturnsNoDistances() {","+    float[] queryVector = {1.0f, 2.0f, 3.0f};","+    VectorIndexReader reader = mock(VectorIndexReader.class);","+    when(reader.getCosineDistances(queryVector, 3)).thenReturn(null);","+    when(reader.getDocIds(queryVector, 3)).thenReturn(MutableRoaringBitmap.bitmapOf(1, 3, 5));","+    VectorSearchDistances searchDistances = new VectorSearchDistances();","+    VectorSearchDistances.Request request = searchDistances.request(reader, queryVector);","+","+    VectorSimilar