ector) {","+    return _requests.computeIfAbsent(new Key(reader, vector), k -> new Request());","+  }","+","+  /// Returns the request for the distances of a search of `reader` for `vector`, or `null` when none was made.","+  @Nullable","+  public Request getRequest(VectorIndexReader reader, float[] vector) {","+    return _requests.get(new Key(reader, vector));","+  }","+","+  /// Distances of one search, keyed by doc id. The filter sets them before the projection reads them, both on the","+  /// thread that processes the segment.","+  public static final class Request {","+    @Nullable","+    private volatile Int2FloatMap _distances;","+","+    public void setDistances(Int2FloatMap distances) {","+      _distances = distances;","+    }","+","+    /// Returns the distances of the search, or `null` when the search has not run or the index returned none.","+    @Nullable","+    public Int2FloatMap getDistances() {","+      return _distances;","+    }","+  }","+","+  /// Identifies a search by the reader instance (one per segment and column) and the query vector.","+  private static final class Key {","+    private final VectorIndexReader _reader;","+    private final float[] _vector;","+    private final int _hashCode;","+","+    Key(VectorIndexReader reader, float[] vector) {","+      _reader = reader;","+      _vector = vector;","+      _hashCode = 31 * System.identityHashCode(reader) + Arrays.hashCode(vector);","+    }","+","+    @Override","+    public boolean equals(Object o) {","+      if (this == o) {","+        return true;","+      }","+      if (!(o instanceof Key)) {","+        return false;","+      }","+      Key key = (Key) o;","+      return _reader == key._reader && Arrays.equals(_vector, key._vector);","+    }","+","+    @Override","+    public int hashCode() {","+      return _hashCode;","+    }","+  }","+}"],"additions":109,"deletions":0,"truncated":false},{"path":"pinot-core/src/main/java/org/apache/pinot/core/operator/filter/VectorSimilarityFilt