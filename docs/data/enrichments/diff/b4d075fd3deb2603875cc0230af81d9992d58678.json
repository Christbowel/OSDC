turn resource|false","+\t */","+\tpublic static function wrap($source, int|float $size, bool $fixedSize, callable $callback) {","+\t\treturn self::wrapSource($source, [","+\t\t\t'source' => $source,","+\t\t\t'size' => $size,","+\t\t\t'fixedSize' => $fixedSize,","+\t\t\t'callback' => $callback,","+\t\t]);","+\t}","+","+\t#[\\Override]","+\tpublic function dir_opendir($path, $options) {","+\t\treturn false;","+\t}","+","+\t#[\\Override]","+\tpublic function stream_open($path, $mode, $options, &$opened_path) {","+\t\t$context = $this->loadContext();","+\t\t$this->size = $context['size'];","+\t\t$this->fixedSize = $context['fixedSize'];","+\t\t$this->callback = $context['callback'];","+\t\treturn true;","+\t}","+","+\t#[\\Override]","+\tpublic function stream_read($count) {","+\t\tif ($this->fixedSize) {","+\t\t\t$count = (int)min($count, $this->size - $this->bytesDelivered);","+\t\t\tif ($count <= 0) {","+\t\t\t\treturn '';","+\t\t\t}","+\t\t}","+","+\t\t$data = $this->readSource($count);","+\t\tif ($this->fixedSize && $data === '') {","+\t\t\t$data = str_repeat(\"\\0\", $count);","+\t\t}","+","+\t\t$this->bytesDelivered += strlen($data);","+\t\treturn $data;","+\t}","+","+\t#[\\Override]","+\tpublic function stream_eof() {","+\t\tif ($this->fixedSize) {","+\t\t\treturn $this->bytesDelivered >= $this->size;","+\t\t}","+\t\treturn $this->failed || $this->sourceEnded;","+\t}","+","+\t#[\\Override]","+\tpublic function stream_write($data) {","+\t\treturn false;","+\t}","+","+\t#[\\Override]","+\tpublic function stream_seek($offset, $whence = SEEK_SET) {","+\t\treturn false;","+\t}","+","+\t#[\\Override]","+\tpublic function stream_close() {","+\t\tif ($this->fixedSize && !$this->failed && !$this->sourceEnded) {","+\t\t\t// check whether the source holds more data than the declared size","+\t\t\ttry {","+\t\t\t\t$extra = fread($this->source, 1);","+\t\t\t\t$this->truncated = $extra !== false && $extra !== '';","+\t\t\t} catch (\\Throwable) {","+\t\t\t}","+\t\t}","+","+\t\t$result = parent::stream_close();","+\t\t($this->callback)($this);","+\t\treturn $result;","+\t}","+","+\t/**","+\t * Bytes read from the source stream.","+\t */","+\tpublic function getBytesRead(): int|float {","+\t\treturn $this->bytesRead;","+\t}","+","+\t/**","+\t * Whether reading from the source stream failed before it ended.","+\t */","+\tpublic function hasFailed(): bool {","+\t\treturn $this->failed;","+\t}","+","+\t/**","+\t * The throwable thrown by the source stream, if any.","+\t */","+\tpublic function getThrowable(): ?\\Throwable {","+\t\treturn $this->throwable;","+\t}","+","+\t/**","+\t * Whether the source held more data than the declared size (fixed size mode only).","+\t */","+\tpublic function isTruncated(): bool {","+\t\treturn $this->truncated;","+\t}","+","+\tprivate function readSource(int $count): string {","+\t\tif ($this->failed || $this->sourceEnded) {","+\t\t\treturn '';","+\t\t}","+","+\t\ttry {","+\t\t\t$data = fread($this->source, $count);","+\t\t} catch (\\Throwable $e) {","+\t\t\t$this->throwable = $e;","+\t\t\t$data = false;","+\t\t}","+","+\t\tif ($data === false) {","+\t\t\t$this->failed = true;","+\t\t\treturn '';","+\t\t}","+\t\tif ($data === '') {","+\t\t\t$this->sourceEnded = true;","+\t\t}","+","+\t\t$this->bytesRead += strlen($data);","+\t\treturn $data;","+\t}","+}"],"additions":170,"deletions":0,"truncated":false},{"path":"apps/dav/lib/Connector/Sabre/ZipFolderPlugin.php","lines":["@@ -9,7 +9,6 @@"," "," namespace OCA\\DAV\\Connector\\Sabre;"," ","-use Icewind\\Streams\\CountWrapper;"," use OC\\Streamer;"," use OCA\\DAV\\Connector\\Sabre\\Exception\\Forbidden;"," use OCP\\EventDispatcher\\IEventDispatcher;","@@ -45,6 +44,7 @@ class ZipFolderPlugin extends ServerPlugin {"," \tprivate ?Server $server = null;"," \tprivate bool $reportMissingFiles;"," \tprivate array $missingInfo = [];","+\tprivate bool $tarArchive = false;"," "," \t/**"," \t * Whether handleDownload has fully streamed an archive for the current request.","@