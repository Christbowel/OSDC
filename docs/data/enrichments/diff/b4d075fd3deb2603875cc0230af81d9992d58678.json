ad());","+\t\t$this->assertSame($expectedFailed, $entry->hasFailed());","+\t\t$this->assertSame($expectedTruncated, $entry->isTruncated());","+\t\tif ($throwOnRead !== null) {","+\t\t\t$this->assertInstanceOf(\\RuntimeException::class, $entry->getThrowable());","+\t\t} else {","+\t\t\t$this->assertNull($entry->getThrowable());","+\t\t}","+\t}","+","+\tpublic static function dataArchiveStaysValid(): array {","+\t\treturn [","+\t\t\t'zip, failing read' => ['tar' => false, 'brokenContent' => str_repeat('b', 10000), 'brokenSize' => 10000, 'throwOnRead' => 2, 'expected' => str_repeat('b', 8192)],","+\t\t\t'tar, failing read' => ['tar' => true, 'brokenContent' => str_repeat('b', 10000), 'brokenSize' => 10000, 'throwOnRead' => 2, 'expected' => str_repeat('b', 8192) . str_repeat(\"\\0\", 1808)],","+\t\t\t'tar, short read' => ['tar' => true, 'brokenContent' => 'bbb', 'brokenSize' => 1000, 'throwOnRead' => null, 'expected' => 'bbb' . str_repeat(\"\\0\", 997)],","+\t\t\t'tar, long read' => ['tar' => true, 'brokenContent' => str_repeat('b', 1000), 'brokenSize' => 600, 'throwOnRead' => null, 'expected' => str_repeat('b', 600)],","+\t\t];","+\t}","+","+\t/**","+\t * Tests that an archive containing a broken entry can still be read,","+\t * including the entries written after it.","+\t */","+\t#[DataProvider(methodName: 'dataArchiveStaysValid')]","+\tpublic function testArchiveStaysValid(bool $tar, string $brokenContent, int $brokenSize, ?int $throwOnRead, string $expected): void {","+\t\t$output = fopen('php://temp', 'w+');","+\t\t$streamer = $tar ? new TarStreamer(['outstream' => $output]) : new ZipStreamer(['outstream' => $output, 'zip64' => false]);","+\t\t$add = static function (string $name, $source, int $size) use ($streamer, $tar): void {","+\t\t\t$tar ? $streamer->addFileFromStream($source, $name, $size) : $streamer->addFileFromStream($source, $name);","+\t\t};","+","+\t\t$add('first.txt', $this->createSource('first', null), 5);","+\t\t$broken = ArchiveEntryStream::wrap($