ion{}.Process(input, \"\")","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\twant := `<a:e xmlns:a=\"urn:a\"><b:e xmlns:b=\"urn:b\" xmlns:p=\"urn:p2\" p:attr=\"x\"></b:e><c:e xmlns:c=\"urn:c\" xmlns:p=\"urn:p1\" p:attr=\"y\"></c:e></a:e>`","+\tif got != want {","+\t\tt.Fatalf(\"got %q, want %q\", got, want)","+\t}","+}","+","+func TestExclusiveCanonicalizationInclusiveNamespaces(t *testing.T) {","+\tinput := `<foo:root xmlns:foo=\"urn:foo\" xmlns:bar=\"urn:bar\"><foo:child>x</foo:child></foo:root>`","+\ttransform := `<Transform><InclusiveNamespaces PrefixList=\"bar\"></InclusiveNamespaces></Transform>`","+\tgot, err := ExclusiveCanonicalization{}.Process(input, transform)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\twant := `<foo:root xmlns:bar=\"urn:bar\" xmlns:foo=\"urn:foo\"><foo:child>x</foo:child></foo:root>`","+\tif got != want {","+\t\tt.Fatalf(\"got %q, want %q\", got, want)","+\t}","+}","+","+func TestExclusiveCanonicalizationProcessElementInheritsAncestorNS(t *testing.T) {","+\tdoc := etree.NewDocument()","+\tif err := doc.ReadFromString(`<parent xmlns:foo=\"urn:foo\"><foo:child>text</foo:child></parent>`); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tchild := doc.FindElement(\"//foo:child\")","+\tif child == nil {","+\t\tt.Fatal(\"missing foo:child\")","+\t}","+\tgot, err := ExclusiveCanonicalization{}.ProcessElement(child, \"\")","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\twant := `<foo:child xmlns:foo=\"urn:foo\">text</foo:child>`","+\tif got != want {","+\t\tt.Fatalf(\"got %q, want %q\", got, want)","+\t}","+}","+","+func TestExclusiveCanonicalizationNestedUnusedNamespacesLinearMemory(t *testing.T) {","+\tconst depth = 250","+\tconst nsPerLevel = 20","+\txml := nestedUnusedNamespaces(depth, nsPerLevel)","+","+\tvar before, after runtime.MemStats","+\truntime.GC()","+\truntime.ReadMemStats(&before)","+","+\tout, err := ExclusiveCanonicalization{}.Process(xml, \"\")","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\truntime.ReadMemStats(&after)","+\tallocated := after.TotalAlloc - before.TotalAlloc","+\tconst maxAlloc = 64 << 20 // 64 MiB","+\tif allocated > maxAlloc {","+\t\tt.Fatalf(\"exclusive c14n allocated %d bytes for %d-byte input; want <%d (namespace map must not be copied per node)\", allocated, len(xml), maxAlloc)","+\t}","+","+\tif strings.Contains(out, \"xmlns:p\") {","+\t\tt.Fatal(\"unused namespace prefixes must not be emitted\")","+\t}","+\tif !strings.Contains(out, `xmlns:n1=\"urn:n1\"`) {","+\t\tt.Fatal(\"visibly used prefix n1 should be rendered\")","+\t}","+}","+","+func TestExclusiveCanonicalizationNamespaceLimit(t *testing.T) {","+\tvar sb strings.Builder","+\tsb.WriteString(`<a:e xmlns:a=\"urn:a\"`)","+\tfor i := 0; i < maxInScopeNamespaces; i++ {","+\t\tfmt.Fprintf(&sb, ` xmlns:p%d=\"urn:%d\"`, i, i)","+\t}","+\tsb.WriteString(`>x</a:e>`)","+","+\t_, err := ExclusiveCanonicalization{}.Process(sb.String(), \"\")","+\tif err == nil {","+\t\tt.Fatal(\"expected error when exceeding in-scope namespace limit\")","+\t}","+\tif !strings.Contains(err.Error(), \"in-scope namespaces\") {","+\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t}","+}","+","+func TestValidateReferencesNestedNamespacesCompletes(t *testing.T) {","+\tpemString, err := os.ReadFile(\"./testdata/rsa.crt\")","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tpemBlock, _ := pem.Decode(pemString)","+\tcert, err := x509.ParseCertificate(pemBlock.Bytes)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+","+\txml := `<Response xmlns=\"urn:test\">` + nestedUnusedNamespaces(80, 15) +","+\t\t`<Signature xmlns=\"http://www.w3.org/2000/09/xmldsig#\"><SignedInfo>` +","+\t\t`<CanonicalizationMethod Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\"></CanonicalizationMethod>` +","+\t\t`<SignatureMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#rsa-sha256\"></SignatureMethod>` +","+\t\t`<Reference URI=\"\"><Transforms>` +","+\t\t`<Transform Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\"></Transform>` +","+\t\t`</Transforms>` +","+\t\t`<DigestMethod Algorithm=\"http://www.w3.org/2001/04/xmlenc#sha256\"></DigestMethod>` +","+\t\t`<DigestValue>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</DigestValue>` +","+\t\t`</Reference></SignedInfo><SignatureValue>AAAA</SignatureValue></Signature></Response>`","+","+\tv, err := NewValidator(xml)","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\tv.Certificates = []x509.Certificate{*cert}","+","+\t_, verr := v.ValidateReferences()","+\tif verr == nil {","+\t\tt.Fatal(\"expected digest or signature failure\")","+\t}","+}","+","+func nestedUnusedNamespaces(depth, nsPerLevel int) string {","+\tvar sb strings.Builder","+\tfor d := 1; d <= depth; d++ {","+\t\tfmt.Fprintf(&sb, `<n%d:e`, d)","+\t\tfor k := 0; k < nsPerLevel; k++ {","+\t\t\tfmt.Fprintf(&sb, ` xmlns:p%d_%d=\"urn:%d_%d\"`, d, k, d, k)","+\t\t}","+\t\tfmt.Fprintf(&sb, ` xmlns:n%d=\"urn:n%d\">`, d, d)","+\t}","+\tsb.WriteString(\"x\")","+\tfor d := depth; d >= 1; d-- {","+\t\tfmt.Fprintf(&sb, `</n%d:e>`, d)","+\t}","+\treturn sb.String()","+}",""],"additions":178,"deletions":0,"truncated":false}],"additions":285,"deletions":44,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-10-22T13:43:47.233984+00:00"}