,"deletions":0,"truncated":false},{"path":"pkg/middlewares/stateful.go","lines":["@@ -1,11 +0,0 @@","-package middlewares","-","-import \"net/http\"","-","-// Stateful interface groups all http interfaces that must be","-// implemented by a stateful middleware (ie: recorders).","-type Stateful interface {","-\thttp.ResponseWriter","-\thttp.Hijacker","-\thttp.Flusher","-}"],"additions":0,"deletions":11,"truncated":false},{"path":"pkg/plugins/external.go","lines":["@@ -0,0 +1,145 @@","+package plugins","+","+import (","+\t\"bufio\"","+\t\"context\"","+\t\"errors\"","+\t\"net\"","+\t\"net/http\"","+\t\"time\"","+)","+","+type entryWriterKey struct{}","+","+// wrapExternal builds, with the given build function, a plugin handler (Yaegi, Wasm), whose code we do not control, around next.","+// The external handler receives a ResponseWriter implementing http.Flusher and http.Hijacker,","+// as such code asserts them directly instead of using http.ResponseController.","+// The ResponseWriter it gives to next may not implement Unwrap:","+// it is wrapped to reach the deadlines, full duplex and hijacking of the ResponseWriter given to the external handler,","+// when the external ResponseWriter does not support them.","+// Flush is left to the external ResponseWriter: a buffering writer must not be flushed past.","+func wrapExternal(next http.Handler, build func(next http.Handler) (http.Handler, error)) (http.Handler, error) {","+\thandler, _, err := wrapExternalWith(next, func(next http.Handler) (http.Handler, struct{}, error) {","+\t\texternal, err := build(next)","+\t\treturn external, struct{}{}, err","+\t})","+","+\treturn handler, err","+}","+","+// wrapExternalWith is wrapExternal for a build function which also returns a value, such as a context modifier, returned as is.","+func wrapExternalWith[T any](next http.Handler, build func(next http.Handler) (http.Handler, T, error)) (http.Handler, T, error) {","+\texternal, value, err := build(exitHandler(next))","+\tif err != nil {","+\t\tvar zero T","+\t\treturn nil, zero, err","+\t}","+","+\treturn entryHandler(external), value, nil","+}","+","+func entryHandler(external http.Handler) http.Handler {","+\treturn http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\tentry := newEntryWriter(rw)","+\t\texternal.ServeHTTP(entry, req.WithContext(context.WithValue(req.Context(), entryWriterKey{}, entry)))","+\t})","+}","+","+func exitHandler(next http.Handler) http.Handler {","+\treturn http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\tentry, ok := req.Context().Value(entryWriterKey{}).(http.ResponseWriter)","+\t\tif !ok || rw == entry {","+\t\t\tnext.ServeHTTP(rw, req)","+\t\t\treturn","+\t\t}","+","+\t\tnext.ServeHTTP(&exitWriter{ResponseWriter: rw, entry: entry}, req)","+\t})","+}","+","+// entryWriter exposes http.Flusher and http.Hijacker backed by http.ResponseController.","+type entryWriter struct {","+\thttp.ResponseWriter","+","+\trc *http.ResponseController","+}","+","+// newEntryWriter wraps the given ResponseWriter in an entryWriter, unless it already is one.","+func newEntryWriter(rw http.ResponseWriter) http.ResponseWriter {","+\tif ew, ok := rw.(*entryWriter); ok {","+\t\treturn ew","+\t}","+","+\treturn &entryWriter{ResponseWriter: rw, rc: http.NewResponseController(rw)}","+}","+","+// Flush sends any buffered data to the client.","+func (w *entryWriter) Flush() {","+\t_ = w.FlushError()","+}","+","+// FlushError sends any buffered data to the client, and is preferred over Flush by http.ResponseController.","+func (w *entryWriter) FlushError() error {","+\treturn w.rc.Flush()","+}","+","+// Hijack hijacks the connection.","+func (w *entryWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {","+\treturn w.rc.Hijack()","+}","+","+// Unwrap exposes the underlying ResponseWriter for http.ResponseController.","+func (w *entryWriter) Unwrap() http.ResponseWriter {","+\treturn w.ResponseWriter","+}","+","+// exitWriter wraps the ResponseWriter created by an external handler.","+type exitWriter struct {","+\thttp.ResponseWriter","+","+\t// entry is the ResponseWriter given to the external handler.","+\tentry http.ResponseWriter","+}","+","+// SetReadDeadline sets the read deadline through the external ResponseWriter, or the entry ResponseWriter if it does not support it.","+func (w *exitWriter) SetReadDeadline(deadline time.Time) error {","+\tif err := http.NewResponseController(w.ResponseWriter).SetReadDeadline(deadline); !errors.Is(err, http.ErrNotSupported) {","+\t\treturn err","+\t}","+","+\treturn http.NewResponseController(w.entry).SetReadDeadline(deadline)","+}","+","+// SetWriteDeadline sets the write deadline through the external ResponseWriter, or the entry ResponseWriter if it does not support it.","+func (w *exitWriter) SetWriteDeadline(deadline time.Time) error {","+\tif err := http.NewResponseController(w.ResponseWriter).SetWriteDeadline(deadline); !errors.Is(err, http.ErrNotSupported) {","+\t\treturn err","+\t}","+","+\treturn http.NewResponseController(w.entry).SetWriteDeadline(deadline)"],"additions":119,"deletions":0,"truncated":false}],"additions":275,"deletions":216,"truncated":true,"file_count":19},"error":null,"fetched_at":"2026-10-22T13:46:21.876634+00:00"}