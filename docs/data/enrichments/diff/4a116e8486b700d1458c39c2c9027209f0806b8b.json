{"id":"4a116e8486b700d1458c39c2c9027209f0806b8b","axis":"silent","repo":"pnpm/pnpm","sha":"4a116e8486b700d1458c39c2c9027209f0806b8b","parsed":{"files":[{"path":".changeset/pnpr-postgres-transaction-pooler.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Fixed writes on PostgreSQL waiting until they timed out when more than one pnpr instance wrote through PgBouncer or another connection pool in transaction mode."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/sql/src/adapter.rs","lines":["@@ -51,6 +51,9 @@ pub trait Connection {","         Dialect::Sqlite","     }"," ","+    /// Take the schema lock, which admits one migrating instance at a time.","+    /// `PostgreSQL` holds it in each write transaction the connection begins","+    /// from then on, and those read committed data, not one snapshot.","     fn lock_schema(&self) -> Result<()> {","         Ok(())","     }"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/sql/src/network/dialect.rs","lines":["@@ -1,6 +1,7 @@"," use super::super::{","     adapter::{Param, Query},","     dialect::Dialect,","+    schema::MARKER,"," };"," use pnpr_error::{RegistryError, Result};"," use std::{fmt::Write as _, time::Duration};","@@ -13,6 +14,10 @@ macro_rules! schema_key {","     };"," }"," ","+fn postgres_lock_writes() -> String {","+    format!(\"LOCK TABLE {MARKER} IN SHARE ROW EXCLUSIVE MODE\")","+}","+"," #[derive(Debug, Clone, Copy)]"," pub(super) enum NetworkDialect {","     Postgres,","@@ -54,66 +59,79 @@ impl NetworkDialect {","         false","     }"," ","-    pub(super) fn lock_schema(self, timeout: Duration) -> String {","-        match self {","-            Self::Postgres => {","-                concat!(\"SELECT 1 FROM pg_advisory_lock(70607832, \", schema_key!(), \")\").to_string()","-            }","-            Self::Mysql => format!(","-                \"SELECT GET_LOCK(CONCAT('pnpr_schema:', MD5(DATABASE())), {})\",","-                timeout.as_secs_f64(),","-            ),","-        }","+    /// Whether the dialect's locks belong to the session and outlive a","+    /// transaction. `PostgreSQL`'s belong to the transaction, so they hold","+    /// behind a pooler that gives each transaction another server connection.","+    pub(super) const fn session_locks(self) -> bool {","+        matches!(self, Self::Mysql)","     }"," ","-    pub(super) fn unlock_schema(self) -> &'static str {","-        match self {","-            Self::Postgres => concat!(\"SELECT pg_advisory_unlock(70607832, \", schema_key!(), \")\"),","-            Self::Mysql => \"SELECT RELEASE_LOCK(CONCAT('pnpr_schema:', MD5(DATABASE())))\",","-        }","+    /// The statement that takes the schema lock of a [`Self::session_locks`]","+    /// dialect and returns `1` once held.","+    pub(super) fn lock_schema(timeout: Duration) -> String {","+        format!(","+            \"SELECT GET_LOCK(CONCAT('pnpr_schema:', MD5(DATABASE())), {})\",","+            timeout.as_secs_f64(),","+        )","     }"," ","-    /// The statement that takes the database's write lock, a session lock","-    /// that returns `1` once held. Writers queue on it instead of failing","-    /// each other's serializable transactions. It is taken before `BEGIN`, so","-    /// the transaction's snapshot holds every commit made under it.","-    pub(super) fn lock_writes(self, timeout: Duration) -> String {","-        match self {","-            Self::Postgres => {","-                concat!(\"SELECT 1 FROM pg_advisory_lock(70607833, \", schema_key!(), \")\").to_string()","-            }","-            Self::Mysql => format!(","-                \"SELECT GET_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())), {})\",","-                timeout.as_secs_f64(),","-            ),","-        }","-    }","+    pub(super) const UNLOCK_SCHEMA: &str =","+        \"SELECT RELEASE_LOCK(CONCAT('pnpr_schema:', MD5(DATABASE())))\";"," ","-    pub(super) fn unlock_writes(self) -> &'static str {","-        match self {","-            Self::Postgres => concat!(\"SELECT pg_advisory_unlock(70607833, \", schema_key!(), \")\"),","-            Self::Mysql => \"DO RELEASE_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())))\",","-        }","+    /// The statement that takes the write lock of a [`Self::session_locks`]","+    /// dialect and returns `1` once held. Writers queue on it instead of","+    /// failing each other's serializable transactions. It is taken before","+    /// `BEGIN`, so the transaction's snapshot holds every commit made under it.","+    pub(super) fn lock_writes(timeout: Duration) -> String {","+        format!(","+            \"SELECT GET_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())), {})\",","+            timeout.as_secs_f64(),","+        )","     }"," ","-    /// `COMMIT`, then [`Self::unlock_writes`] in the same round trip.","-    pub(super) fn commit_write(self) -> &'static str {","+    pub(super) const UNLOCK_WRITES: &str =","+        \"DO RELEASE_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())))\";","+","+    /// `COMMIT`, then [`Self::UNLOCK_WRITES`] in the same round trip.","+    pub(super) const COMMIT_AND_UNLOCK_WRITES: &str =","+        \"COMMIT; DO RELEASE_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())))\";","+","+    /// `ROLLBACK`, then [`Self::UNLOCK_WRITES`] in the same round trip.","+    pub(super) const ROLLBACK_AND_UNLOCK_WRITES: &str =","+        \"ROLLBACK; DO RELEASE_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())))\";","+","+    /// Begin a write transaction. `PostgreSQL` takes the write lock in it, as","+    /// a lock on [`MARKER`] that queues writers and admits readers. `LOCK","+    /// TABLE` takes no snapshot, so the transaction's snapshot holds every","+    /// commit made under the lock, which an advisory lock taken by a `SELECT`","+    /// would not give it.","+    pub(super) fn begin_write(self) -> String {","         match self {","             Self::Postgres => {","-                concat!(\"COMMIT; SELECT pg_advisory_unlock(70607833, \", schema_key!(), \")\")","+                format!(\"BEGIN ISOLATION LEVEL SERIALIZABLE; {}\", postgres_lock_writes())","+            }","+            Self::Mysql => {","+                \"SET TRANSACTION ISOLATION LEVEL SERIALIZABLE; START TRANSACTION\".to_string()","             }","-            Self::Mysql => \"COMMIT; DO RELEASE_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())))\",","         }","     }"," ","-    /// `ROLLBACK`, then [`Self::unlock_writes`] in the same round trip.","-    pub(super) fn rollback_write(self) -> &'static str {","-        match self {","-            Self::Postgres => {","-                concat!(\"ROLLBACK; SELECT pg_advisory_unlock(70607833, \", schema_key!(), \")\")","-            }","-            Self::Mysql => \"ROLLBACK; DO RELEASE_LOCK(CONCAT('pnpr_write:', MD5(DATABASE())))\",","-        }","+    /// Begin a `PostgreSQL` transaction that holds the schema lock until it","+    /// ends. It reads committed data, so what it reads after waiting for the","+    /// lock includes the migration that held it.","+    pub(super) const BEGIN_MIGRATION: &str = concat!(","+        \"BEGIN ISOLATION LEVEL READ COMMITTED; SELECT pg_advisory_xact_lock(70607832, \",","+        schema_key!(),","+        \")\",","+    );","+","+    /// Take the `PostgreSQL` write lock in a migration, which runs before","+    /// [`MARKER`] exists in a new database.","+    pub(super) fn lock_writes_of_a_migration() -> String {","+        format!(","+            \"DO $$ BEGIN IF to_regclass('{MARKER}') IS NOT NULL THEN {}; END IF; END $$\",","+            postgres_lock_writes(),","+        )","     }"," ","     pub(super) fn table_names(self) -> &'static str {","@@ -127,13 +145,6 @@ impl NetworkDialect {","         }","     }"," ","-    pub(super) fn begin_write(self) -> &'static str {","-        match self {","-            Self::Postgres => \"BEGIN ISOLATION LEVEL SERIALIZABLE\",","-            Self::Mysql => \"SET TRANSACTION ISOLATION LEVEL SERIALIZABLE; START TRANSACTION\",","-        }","-    }","-","     pub(super) fn begin_read(self) -> &'static str {","         match self {","             Self::Postgres => \"BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY\","],"additions":65,"deletions":54,"truncated":false},{"path":"pnpr/crates/sql/src/network/driver.rs","lines":["@@ -166,6 +166,9 @@ macro_rules! driver {","                 dialect: NetworkDialect,","                 runtime: tokio::runtime::Handle,","                 timeout: Duration,","+                /// Whether the connection holds the schema lock: in its","+                /// session, or in each write transaction it begins when the","+                /// dialect has no [`NetworkDialect::session_locks`].","                 schema_locked: Cell<bool>,","                 /// Whether the session holds [`NetworkDialect::lock_writes`].","                 writes_locked: Cell<bool>,","@@ -186,12 +189,13 @@ macro_rules! driver {","                     let rollback =","                         if self.transaction_open.get() { self.rollback() } else { Ok(()) };","                     let unlock_writes = if self.writes_locked.get() {","-                        self.execute_batch(self.dialect.unlock_writes())","+                        self.execute_batch(NetworkDialect::UNLOCK_WRITES)","                     } else {","                         Ok(())","                     };","-                    let unlock = if self.schema_locked.get() {","-                        self.execute_batch(self.dialect.unlock_schema())","+                    let session_locks = self.dialect.session_locks();","+                    let unlock = if session_locks && self.schema_locked.get() {","+                        self.execute_batch(NetworkDialect::UNLOCK_SCHEMA)","                     } else {","                         Ok(())","                     };","@@ -263,6 +267,16 @@ macro_rules! driver {","                     Ok(())","                 }"," ","+                /// Begin the transaction that holds the schema lock, unless","+                /// the connection is in it.","+                fn begin_migration(&self) -> Result<()> {","+                    if self.transaction_open.get() {","+                        return Ok(());","+                    }","+                    self.transaction_open.set(true);","+                    self.execute_batch(NetworkDialect::BEGIN_MIGRATION)","+                }","+","                 /// End the transaction with `end`, or with `end_write` when","                 /// the session holds the write lock, which it releases.","                 fn end_transaction(&self, end: &str, end_write: &str) -> Result<()> {","@@ -291,9 +305,19 @@ macro_rules! driver {","                 }"," ","                 fn lock_schema(&self) -> Result<()> {","-                    self.take_session_lock(&self.dialect.lock_schema(self.timeout), \"schema\")?;","+                    if self.dialect.session_locks() {","+                        let lock = NetworkDialect::lock_schema(self.timeout);","+                        self.take_session_lock(&lock, \"schema\")?;","+                        self.schema_locked.set(true);","+                        return Ok(());","+                    }","+                    if self.transaction_open.get() && !self.schema_locked.get() {","+                        return Err(RegistryError::Internal {","+                            reason: \"schema lock requested inside a transaction\".to_string(),","+                        });","+                    }","                     self.schema_locked.set(true);","-                    Ok(())","+                    self.begin_migration()","                 }"," ","                 fn execute(&self, sql: &str, params: &[Param<'_>]) -> Result<()> {","@@ -353,12 +377,17 @@ macro_rules! driver {","                 }"," ","                 fn begin_write(&self) -> Result<()> {","-                    if !self.writes_locked.get() {","-                        self.take_session_lock(&self.dialect.lock_writes(self.timeout), \"write\")?;","+                    if !self.dialect.session_locks() && self.schema_locked.get() {","+                        self.begin_migration()?;","+                        return self.execute_batch(&NetworkDialect::lock_writes_of_a_migration());","+                    }","+                    if self.dialect.session_locks() && !self.writes_locked.get() {","+                        let lock = NetworkDialect::lock_writes(self.timeout);","+                        self.take_session_lock(&lock, \"write\")?;","                         self.writes_locked.set(true);","                     }","                     self.transaction_open.set(true);","-                    self.execute_batch(self.dialect.begin_write())","+                    self.execute_batch(&self.dialect.begin_write())","                 }"," ","                 fn begin_read(&self) -> Result<()> {","@@ -367,11 +396,11 @@ macro_rules! driver {","                 }"," ","                 fn commit(&self) -> Result<()> {","-                    self.end_transaction(\"COMMIT\", self.dialect.commit_write())","+                    self.end_transaction(\"COMMIT\", NetworkDialect::COMMIT_AND_UNLOCK_WRITES)","                 }"," ","                 fn rollback(&self) -> Result<()> {","-                    self.end_transaction(\"ROLLBACK\", self.dialect.rollback_write())","+                    self.end_transaction(\"ROLLBACK\", NetworkDialect::ROLLBACK_AND_UNLOCK_WRITES)","                 }"," ","                 fn schema_table_names(&self) -> Result<Vec<Row>> {"],"additions":39,"deletions":10,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/tests.rs","lines":["@@ -16,6 +16,8 @@ mod notes;"," mod nul_text;"," mod payload_benchmark;"," #[cfg(feature = \"backend-postgres\")]","+mod postgres_locks;","+#[cfg(feature = \"backend-postgres\")]"," mod postgres_schemas;"," mod publications;"," mod reclaims;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/tests/nul_text.rs","lines":["@@ -1,7 +1,10 @@"," //! Text holding a NUL character, which `PostgreSQL` cannot store."," "," use super::Db;","-use crate::database::sql::adapter::{Param, Query, ReadSource, WriteTransaction};","+use crate::database::sql::{","+    adapter::{Param, Query, ReadSource, WriteTransaction},","+    schema,","+};"," use pnpr_error::RegistryError;"," "," async fn text_with_a_nul_is_refused_on_every_database(db: Db) {","@@ -9,6 +12,7 @@ async fn text_with_a_nul_is_refused_on_every_database(db: Db) {","     let sql = db.sql(\"SELECT ?1\", \"SELECT CAST(?1 AS TEXT)\", \"SELECT ?1\");","     let nul = [Param::Text(\"a\\0b\")];","     tokio::task::spawn_blocking(move || {","+        assert!(schema::prepare_adapter_with_steps(&*adapter, schema::STEPS)?.is_none());","         adapter.write(&mut |connection| {","             let transaction = WriteTransaction::begin(connection)?;","             assert_bad_request(&transaction.execute(sql, &nul));"],"additions":5,"deletions":1,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/tests/postgres_locks.rs","lines":["@@ -0,0 +1,151 @@","+//! `PostgreSQL` locks end with their transaction, so they hold behind a","+//! pooler that gives each transaction another server connection.","+","+use super::{Adapter as Backend, Db};","+use crate::database::sql::{","+    adapter::{Adapter, WriteTransaction},","+    schema,","+};","+use pnpr_error::Result;","+use std::time::Duration;","+","+mod on_postgres {","+    use super::{","+        Duration, adapters, initialize, lock_schema_in_a_transaction,","+        migrate_after_an_ended_migration, migrate_during_an_open_write, write_after_an_ended_write,","+    };","+    use crate::database::sql::schema;","+","+    #[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+    #[ignore = \"requires PNPR_TEST_POSTGRES_URL\"]","+    async fn a_session_whose_write_ended_holds_no_write_lock() {","+        let (_db, first, second) = adapters().await;","+        tokio::task::spawn_blocking(move || write_after_an_ended_write(&*first, &*second))","+            .await","+            .unwrap()","+            .unwrap();","+    }","+","+    #[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+    #[ignore = \"requires PNPR_TEST_POSTGRES_URL\"]","+    async fn a_session_whose_migration_ended_holds_no_schema_lock() {","+        let (_db, first, second) = adapters().await;","+        tokio::task::spawn_blocking(move || migrate_after_an_ended_migration(&*first, &*second))","+            .await","+            .unwrap()","+            .unwrap();","+    }","+","+    #[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+    #[ignore = \"requires PNPR_TEST_POSTGRES_URL\"]","+    async fn a_migration_waits_for_an_open_write() {","+        let (_db, first, second) = adapters().await;","+        tokio::task::spawn_blocking(move || migrate_during_an_open_write(&*first, &*second))","+            .await","+            .unwrap()","+            .unwrap();","+    }","+","+    #[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+    #[ignore = \"requires PNPR_TEST_POSTGRES_URL\"]","+    async fn a_transaction_that_is_open_refuses_the_schema_lock() {","+        let (_db, first, _second) = adapters().await;","+        tokio::task::spawn_blocking(move || lock_schema_in_a_transaction(&*first))","+            .await","+            .unwrap()","+            .unwrap();","+    }","+","+    #[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+    #[ignore = \"requires PNPR_TEST_POSTGRES_URL\"]","+    async fn a_migration_that_waited_reads_what_the_holder_committed() {","+        let (_db, first, second) = adapters().await;","+        let (locked, acquired) = std::sync::mpsc::channel();","+        let holding = tokio::task::spawn_blocking(move || {","+            first.write(&mut |connection| {","+                connection.lock_schema()?;","+                locked.send(()).unwrap();","+                std::thread::sleep(Duration::from_millis(300));","+                assert!(schema::prepare(connection)?.is_none());","+                Ok(())","+            })","+        });","+        tokio::task::spawn_blocking(move || {","+            acquired.recv().unwrap();","+            initialize(&*second)","+        })","+        .await","+        .unwrap()","+        .unwrap();","+        holding.await.unwrap().unwrap();","+    }","+}","+","+/// Two instances on one new database, with a timeout short enough that","+/// waiting for a lock the other left behind fails the test.","+async fn adapters() -> (Db, Box<dyn Adapter>, Box<dyn Adapter>) {","+    let mut db = Db::network(\"PNPR_TEST_POSTGRES_URL\").await;","+    let Backend::Network(settings) = &mut db.adapter else { unreachable!() };","+    settings.timeout = Duration::from_secs(2);","+    let adapters = (db.adapter(), db.adapter());","+    (db, adapters.0, adapters.1)","+}","+","+fn initialize(adapter: &dyn Adapter) -> Result<()> {","+    assert!(schema::prepare_adapter_with_steps(adapter, schema::STEPS)?.is_none());","+    Ok(())","+}","+","+/// Write through `second` while the session of `first` stays open after its","+/// write transaction ended, as a server connection does behind a pooler.","+fn write_after_an_ended_write(first: &dyn Adapter, second: &dyn Adapter) -> Result<()> {","+    initialize(first)?;","+    first.write(&mut |connection| {","+        connection.begin_write()?;","+        connection.execute_batch(\"ROLLBACK\")?;","+        second.write(&mut |other| WriteTransaction::begin(other)?.commit())","+    })","+}","+","+/// Migrate through `second` while the session of `first` stays open after its","+/// migration transaction ended.","+fn migrate_after_an_ended_migration(first: &dyn Adapter, second: &dyn Adapter) -> Result<()> {","+    first.write(&mut |connection| {","+        connection.lock_schema()?;","+        connection.execute_batch(\"ROLLBACK\")?;","+        initialize(second)","+    })","+}","+","+/// Begin a migration's write through `second` while `first` holds the write","+/// lock. It waits until its statement times out.","+fn migrate_during_an_open_write(first: &dyn Adapter, second: &dyn Adapter) -> Result<()> {","+    initialize(first)?;","+    first.write(&mut |connection| {","+        let held = WriteTransaction::begin(connection)?;","+        let waiting = second.write(&mut |other| {","+            other.lock_schema()?;","+            other.begin_write()","+        });","+        let error = waiting.unwrap_err().to_string();","+        // The server and the client hold the same deadline.","+        assert!(","+            error.contains(\"statement timeout\") || error.contains(\"database operation timed out\"),","+            \"{error}\",","+        );","+        held.commit()","+    })","+}","+","+fn lock_schema_in_a_transaction(adapter: &dyn Adapter) -> Result<()> {","+    initialize(adapter)?;","+    adapter.write(&mut |connection| {","+        connection.begin_read()?;","+        let error = connection","+            .lock_schema()","+            .unwrap_err()","+            .to_string();","+        assert!(error.contains(\"schema lock requested inside a transaction\"), \"{error}\");","+        Ok(())","+    })","+}"],"additions":151,"deletions":0,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/tests/postgres_schemas.rs","lines":["@@ -1,7 +1,10 @@"," //! pnpr instances on different schemas of one `PostgreSQL` database."," "," use super::{Adapter as Backend, Db};","-use crate::database::sql::adapter::{Adapter, WriteTransaction};","+use crate::database::sql::{","+    adapter::{Adapter, WriteTransaction},","+    schema,","+};"," use pnpr_config::SqlBackendSettings;"," use pnpr_error::Result;"," use std::time::Duration;","@@ -34,6 +37,9 @@ mod on_postgres {"," /// Commit a write through `second` while a write through `first` holds its"," /// write lock."," fn write_while_holding(first: &dyn Adapter, second: &dyn Adapter) -> Result<()> {","+    for adapter in [first, second] {","+        assert!(schema::prepare_adapter_with_steps(adapter, schema::STEPS)?.is_none());","+    }","     first.write(&mut |connection| {","         let held = WriteTransaction::begin(connection)?;","         second.write(&mut |other| WriteTransaction::begin(other)?.commit())?;"],"additions":7,"deletions":1,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/tests/schema.rs","lines":["@@ -43,6 +43,7 @@ pub(super) async fn execute(db: &Db, statements: &[&str]) {","         .collect();","     tokio::task::spawn_blocking(move || {","         adapter.write(&mut |connection| {","+            connection.lock_schema()?;","             let transaction = WriteTransaction::begin(connection)?;","             for statement in &statements {","                 transaction.execute(statement, params![])?;","@@ -224,6 +225,7 @@ async fn applying_every_step_matches_the_fresh_schema(db: Db) {","     let adapter = db.adapter();","     tokio::task::spawn_blocking(move || {","         adapter.write(&mut |connection| {","+            connection.lock_schema()?;","             let transaction = WriteTransaction::begin(connection)?;","             for statement in schema::statements(TABLES.get(transaction.dialect())) {","                 transaction.execute_ddl(&statement)?;","@@ -317,6 +319,7 @@ async fn seed_v1_fixture(db: &Db) {","     let adapter = db.adapter();","     tokio::task::spawn_blocking(move || {","         adapter.write(&mut |connection| {","+            connection.lock_schema()?;","             let transaction = WriteTransaction::begin(connection)?;","             for statement in schema::statements(&ddl) {","                 transaction.execute_ddl(&statement)?;"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/docs/auth-backends.md","lines":["@@ -90,6 +90,20 @@ schema with the `options` URL parameter, for example"," must exist before pnpr starts, and the database user needs permission to create"," tables in it."," ","+### Connection poolers {#postgresql-poolers}","+","+pnpr works behind a connection pooler in session mode. Behind a pooler in","+transaction mode:","+","+- The pooler must support prepared statements. PgBouncer does from version","+  1.21, with `max_prepared_statements` above `0`.","+- Set the schema as the database user's default, with","+  `ALTER ROLE <user> SET search_path = <schema>`. PgBouncer does not apply the","+  `options` URL parameter to the connections pnpr's transactions run on, so","+  pnpr would use the default schema.","+  The setting applies to connections opened after it. Reconnect the pooler's","+  open server connections before pnpr starts.","+"," ## MySQL"," "," :::warning",""],"additions":14,"deletions":0,"truncated":false}],"additions":294,"deletions":66,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-17T18:44:16.826653+00:00"}