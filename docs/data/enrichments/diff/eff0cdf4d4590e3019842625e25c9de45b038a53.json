{"id":"eff0cdf4d4590e3019842625e25c9de45b038a53","axis":"silent","repo":"envoyproxy/envoy","sha":"eff0cdf4d4590e3019842625e25c9de45b038a53","parsed":{"files":[{"path":"changelogs/current/new_features/dynamic_modules__bootstrap_xds.rst","lines":["@@ -0,0 +1,4 @@","+Added ``envoy_dynamic_module_callback_bootstrap_extension_set_xds_notifications`` and","+``envoy_dynamic_module_on_bootstrap_extension_xds_update``, with Rust SDK","+``set_xds_notifications`` and ``on_xds_update``, for :ref:`bootstrap xDS outcome notifications","+<config_bootstrap_extensions_dynamic_modules_xds_notifications>`, including rejection error details."],"additions":4,"deletions":0,"truncated":false},{"path":"docs/root/configuration/other_features/bootstrap_extensions/dynamic_modules.rst","lines":["@@ -324,6 +324,36 @@ configuration.","   version, Gauge, Hash of the last successful subscription version","   version_text, TextReadout, Last successful subscription version"," ","+.. _config_bootstrap_extensions_dynamic_modules_xds_notifications:","+","+xDS Notifications","+-----------------","+","+After server initialization, enable gRPC xDS notifications with","+``envoy_dynamic_module_callback_bootstrap_extension_set_xds_notifications``. The optional","+``envoy_dynamic_module_on_bootstrap_extension_xds_update`` hook receives the resource type URL","+and outcome. Accepted and rejected responses include their version and nonce; unsubscriptions","+include the resource name. Enabling fails in ``--mode init_only``.","+","+Accepted follows successful processing, before ACK; resources may still be warming.","+Rejected precedes NACK and may follow partial application. Its error details are the NACK","+message and may quote rejected configuration. They are empty for other outcomes.","+","+The hook runs on the main thread and must not block. Unsubscribed is posted to the dispatcher once","+no watch on the stream still names the resource, avoiding a call during cluster destruction. It","+can arrive after later outcomes, such as the CDS Accepted that removed a cluster.","+","+:ref:`Configuration snapshot <config_bootstrap_extensions_dynamic_modules_config_snapshots>`","+collection returns ``NotAllowed`` during Accepted and Rejected. Defer collection with the bootstrap","+config scheduler. Collection can succeed during the posted Unsubscribed callback.","+","+Disabling notifications discards queued unsubscriptions. Re-enabling does not replay them.","+Delivery stops when shutdown begins.","+","+The version is ``version_info`` for SotW and ``system_version_info`` for Delta. A Delta system","+version is not a per-resource version, and nonces are scoped to an xDS stream and resource type.","+Resource payloads are not included. Strings are valid only during the callback.","+"," .. _config_bootstrap_extensions_dynamic_modules_config_snapshots:"," "," Configuration Snapshots"],"additions":30,"deletions":0,"truncated":false},{"path":"envoy/config/BUILD","lines":["@@ -213,6 +213,8 @@ envoy_cc_library(","         \":grpc_mux_interface\",","         \":subscription_factory_interface\",","         \":subscription_interface\",","+        \":xds_config_tracker_interface\",","+        \"//envoy/common:callback\",","         \"//envoy/common:optref_lib\",","         \"//envoy/common:pure_lib\",","         \"//envoy/stats:scope_interface\","],"additions":2,"deletions":0,"truncated":false},{"path":"envoy/config/xds_config_tracker.h","lines":["@@ -34,6 +34,12 @@ class XdsConfigTracker {"," public:","   virtual ~XdsConfigTracker() = default;"," ","+  /**","+   * Returns whether xDS notifications are needed. May change between updates. While false, Envoy","+   * skips every callback, including unsubscriptions, and does not replay them.","+   */","+  virtual bool enabled() const { return true; }","+","   /**","    * Invoked when SotW xDS configuration updates have been successfully parsed, applied on","    * the Envoy instance, and are about to be ACK'ed.","@@ -50,6 +56,15 @@ class XdsConfigTracker {","   virtual void onConfigAccepted(const absl::string_view type_url,","                                 const std::vector<DecodedResourcePtr>& resources) PURE;"," ","+  /**","+   * Includes the accepted SotW response. Forwards to onConfigAccepted by default.","+   */","+  virtual void","+  onConfigAcceptedWithResponse(const envoy::service::discovery::v3::DiscoveryResponse& message,","+                               const std::vector<DecodedResourcePtr>& resources) {","+    onConfigAccepted(message.type_url(), resources);","+  }","+","   /**","    * Invoked when Delta xDS configuration updates have been successfully accepted, applied on","    * the Envoy instance, and are about to be ACK'ed.","@@ -68,6 +83,16 @@ class XdsConfigTracker {","                    absl::Span<const envoy::service::discovery::v3::Resource* const> added_resources,","                    const Protobuf::RepeatedPtrField<std::string>& removed_resources) PURE;"," ","+  /**","+   * Includes the accepted Delta response. Forwards to onConfigAccepted by default.","+   */","+  virtual void onConfigAcceptedWithResponse(","+      const envoy::service::discovery::v3::DeltaDiscoveryResponse& message,","+      absl::Span<const envoy::service::discovery::v3::Resource* const> added_resources,","+      const Protobuf::RepeatedPtrField<std::string>& removed_resources) {","+    onConfigAccepted(message.type_url(), added_resources, removed_resources);","+  }","+","   /**","    * Invoked when xds configs are rejected during xDS ingestion.","    *"],"additions":25,"deletions":0,"truncated":false},{"path":"envoy/config/xds_manager.h","lines":["@@ -4,6 +4,7 @@"," #include <string>"," #include <vector>"," ","+#include \"envoy/common/callback.h\""," #include \"envoy/common/optref.h\""," #include \"envoy/common/pure.h\""," #include \"envoy/config/bootstrap/v3/bootstrap.pb.h\"","@@ -11,6 +12,7 @@"," #include \"envoy/config/grpc_mux.h\""," #include \"envoy/config/subscription.h\""," #include \"envoy/config/subscription_factory.h\"","+#include \"envoy/config/xds_config_tracker.h\""," #include \"envoy/stats/scope.h\""," #include \"envoy/upstream/cluster_manager.h\""," ","@@ -63,6 +65,14 @@ class XdsManager {","    */","   virtual void startXdstpAdsMuxes() PURE;"," ","+  /**","+   * Registers a tracker alongside the bootstrap-configured tracker. Destroying the returned handle","+   * unregisters it. Both operations run on the main thread. The tracker must outlive the handle.","+   * Trackers removed during a callback are skipped; new trackers wait until the next notification.","+   */","+  ABSL_MUST_USE_RESULT virtual Common::CallbackHandlePtr","+  addXdsConfigTracker(XdsConfigTracker& tracker) PURE;","+","   /**","    * Subscription to a singleton resource.","    * This will create a subscription to a singleton resource, based on the resource_name and the"],"additions":10,"deletions":0,"truncated":false},{"path":"source/common/config/BUILD","lines":["@@ -378,10 +378,13 @@ envoy_cc_library(","         \":singleton_subscription_adapter_lib\",","         \":subscription_factory_lib\",","         \":utility_lib\",","+        \"//envoy/config:xds_config_tracker_interface\",","         \"//envoy/config:xds_manager_interface\",","         \"//envoy/upstream:cluster_manager_interface\",","+        \"//source/common/common:cleanup_lib\",","         \"//source/common/common:thread_lib\",","         \"//source/common/upstream:load_stats_reporter_lib\",","+        \"@abseil-cpp//absl/functional:function_ref\",","         \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","     ],"," )"],"additions":3,"deletions":0,"truncated":false},{"path":"source/common/config/xds_manager_impl.cc","lines":["@@ -1,6 +1,7 @@"," #include \"source/common/config/xds_manager_impl.h\""," "," #include <algorithm>","+#include <functional>"," #include <memory>"," #include <optional>"," #include <string>","@@ -155,12 +156,14 @@ absl::Status XdsManagerImpl::initialize(const envoy::config::bootstrap::v3::Boot","     xds_config_tracker_ = tracker_factory.createXdsConfigTracker(","         bootstrap.xds_config_tracker_extension().typed_config(),","         validation_context_.dynamicValidationVisitor(), api_, main_thread_dispatcher_);","+    if (xds_config_tracker_ != nullptr) {","+      xds_config_tracker_handle_ = addXdsConfigTracker(*xds_config_tracker_);","+    }","   }"," ","   OptRef<XdsResourcesDelegate> xds_resources_delegate =","       makeOptRefFromPtr<XdsResourcesDelegate>(xds_resources_delegate_.get());","-  OptRef<XdsConfigTracker> xds_config_tracker =","-      makeOptRefFromPtr<XdsConfigTracker>(xds_config_tracker_.get());","+  OptRef<XdsConfigTracker> xds_config_tracker{xds_config_trackers_};"," ","   subscription_factory_ = std::make_unique<SubscriptionFactoryImpl>(","       local_info_, main_thread_dispatcher_, *cm_, validation_context_.dynamicValidationVisitor(),","@@ -207,8 +210,7 @@ XdsManagerImpl::initializeAdsConnections(const envoy::config::bootstrap::v3::Boo","     RETURN_IF_NOT_OK_REF(strategy_or_error.status());","     JitteredExponentialBackOffStrategyPtr backoff_strategy = std::move(strategy_or_error.value());"," ","-    OptRef<XdsConfigTracker> xds_config_tracker =","-        makeOptRefFromPtr<XdsConfigTracker>(xds_config_tracker_.get());","+    OptRef<XdsConfigTracker> xds_config_tracker{xds_config_trackers_};"," ","     if (dyn_resources.ads_config().api_type() ==","         envoy::config::core::v3::ApiConfigSource::DELTA_GRPC) {","@@ -457,8 +459,7 @@ XdsManagerImpl::createAuthority(const envoy::config::core::v3::ConfigSource& con","   RETURN_IF_NOT_OK_REF(strategy_or_error.status());","   JitteredExponentialBackOffStrategyPtr backoff_strategy = std::move(strategy_or_error.value());"," ","-  OptRef<XdsConfigTracker> xds_config_tracker =","-      makeOptRefFromPtr<XdsConfigTracker>(xds_config_tracker_.get());","+  OptRef<XdsConfigTracker> xds_config_tracker{xds_config_trackers_};"," ","   GrpcMuxSharedPtr authority_mux = nullptr;","   if (api_config_source.api_type() ==","@@ -617,5 +618,108 @@ XdsManagerImpl::replaceAdsMux(const envoy::config::core::v3::ApiConfigSource& ad","   return status;"," }"," ","+class XdsConfigTrackers::Registration : public Common::CallbackHandle {","+public:","+  Registration(const std::shared_ptr<Trackers>& trackers, XdsConfigTracker& tracker)","+      : trackers_(trackers), tracker_(tracker) {","+    trackers_->entries_.push_back(this);","+  }","+  ~Registration() override {","+    ASSERT_IS_MAIN_OR_TEST_THREAD();","+    auto& entries = trackers_->entries_;","+    const auto it = std::find(entries.begin(), entries.end(), this);","+    ASSERT(it != entries.end());","+    if (trackers_->iteration_depth_ > 0) {","+      *it = nullptr;","+      trackers_->has_removed_entries_ = true;","+    } else {","+      entries.erase(it);","+    }","+  }","+","+  XdsConfigTracker& tracker() const { return tracker_; }","+","+private:","+  const std::shared_ptr<Trackers> trackers_;","+  XdsConfigTracker& tracker_;","+};","+","+Common::CallbackHandlePtr XdsConfigTrackers::add(XdsConfigTracker& tracker) {","+  ASSERT_IS_MAIN_OR_TEST_THREAD();","+  return std::make_unique<Registration>(trackers_, tracker);","+}","+","+bool XdsConfigTrackers::enabled() const {","+  return std::any_of(","+      trackers_->entries_.begin(), trackers_->entries_.end(),","+      [](const Registration* entry) { return entry != nullptr && entry->tracker().enabled(); });","+}","+","+void XdsConfigTrackers::forEach(absl::FunctionRef<void(XdsConfigTracker&)> callback) {","+  auto& trackers = *trackers_;","+  ++trackers.iteration_depth_;","+  Cleanup cleanup([&trackers] {","+    if (--trackers.iteration_depth_ == 0 && trackers.has_removed_entries_) {","+      std::erase(trackers.entries_, nullptr);","+      trackers.has_removed_entries_ = false;","+    }","+  });","+  // callbacks can remove any registration or append new ones","+  const size_t size_at_start = trackers.entries_.size();","+  for (size_t i = 0; i < size_at_start; ++i) {","+    const auto* entry = trackers.entries_[i];","+    if (entry != nullptr && entry->tracker().enabled()) {","+      callback(entry->tracker());","+    }","+  }","+}","+","+void XdsConfigTrackers::onConfigAccepted(absl::string_view type_url,","+                                         const std::vector<DecodedResourcePtr>& resources) {","+  forEach([&](XdsConfigTracker& tracker) { tracker.onConfigAccepted(type_url, resources); });","+}","+","+void XdsConfigTrackers::onConfigAccepted(","+    absl::string_view type_url,","+    absl::Span<const envoy::service::discovery::v3::Resource* const> added_resources,","+    const Protobuf::RepeatedPtrField<std::string>& removed_resources) {","+  forEach([&](XdsConfigTracker& tracker) {","+    tracker.onConfigAccepted(type_url, added_resources, removed_resources);","+  });","+}","+","+void XdsConfigTrackers::onConfigAcceptedWithResponse(","+    const envoy::service::discovery::v3::DiscoveryResponse& message,","+    const std::vector<DecodedResourcePtr>& resources) {","+  forEach(","+      [&](XdsConfigTracker& tracker) { tracker.onConfigAcceptedWithResponse(message, resources); });","+}","+","+void XdsConfigTrackers::onConfigAcceptedWithResponse(","+    const envoy::service::discovery::v3::DeltaDiscoveryResponse& message,","+    absl::Span<const envoy::service::discovery::v3::Resource* const> added_resources,","+    const Protobuf::RepeatedPtrField<std::string>& removed_resources) {","+  forEach([&](XdsConfigTracker& tracker) {","+    tracker.onConfigAcceptedWithResponse(message, added_resources, removed_resources);","+  });","+}","+","+void XdsConfigTrackers::onConfigRejected(","+    const envoy::service::discovery::v3::DiscoveryResponse& message,","+    absl::string_view error_detail) {","+  forEach([&](XdsConfigTracker& tracker) { tracker.onConfigRejected(message, error_detail); });","+}","+","+void XdsConfigTrackers::onConfigRejected(","+    const envoy::service::discovery::v3::DeltaDiscoveryResponse& message,","+    absl::string_view error_detail) {","+  forEach([&](XdsConfigTracker& tracker) { tracker.onConfigRejected(message, error_detail); });","+}","+","+void XdsConfigTrackers::onResourceUnsubscribed(absl::string_view type_url,","+                                               absl::string_view resource) {","+  forEach([&](XdsConfigTracker& tracker) { tracker.onResourceUnsubscribed(type_url, resource); });","+}","+"," } // namespace Config"," } // namespace Envoy"],"additions":110,"deletions":6,"truncated":false},{"path":"source/common/config/xds_manager_impl.h","lines":["@@ -1,14 +1,59 @@"," #pragma once"," ","+#include <cstdint>","+#include <memory>","+#include <vector>","+","+#include \"envoy/config/xds_config_tracker.h\""," #include \"envoy/config/xds_manager.h\""," "," #include \"source/common/common/thread.h\""," #include \"source/common/config/subscription_factory_impl.h\""," #include \"source/common/config/xds_resource.h\""," ","+#include \"absl/functional/function_ref.h\"","+"," namespace Envoy {"," namespace Config {"," ","+class XdsConfigTrackers : public XdsConfigTracker {","+public:","+  ABSL_MUST_USE_RESULT Common::CallbackHandlePtr add(XdsConfigTracker& tracker);","+","+  // Config::XdsConfigTracker","+  bool enabled() const override;","+  void onConfigAccepted(absl::string_view type_url,","+                        const std::vector<DecodedResourcePtr>& resources) override;","+  void","+  onConfigAccepted(absl::string_view type_url,","+                   absl::Span<const envoy::service::discovery::v3::Resource* const> added_resources,","+                   const Protobuf::RepeatedPtrField<std::string>& removed_resources) override;","+  void onConfigAcceptedWithResponse(const envoy::service::discovery::v3::DiscoveryResponse& message,","+                                    const std::vector<DecodedResourcePtr>& resources) override;","+  void onConfigAcceptedWithResponse(","+      const envoy::service::discovery::v3::DeltaDiscoveryResponse& message,","+      absl::Span<const envoy::service::discovery::v3::Resource* const> added_resources,","+      const Protobuf::RepeatedPtrField<std::string>& removed_resources) override;","+  void onConfigRejected(const envoy::service::discovery::v3::DiscoveryResponse& message,","+                        absl::string_view error_detail) override;","+  void onConfigRejected(const envoy::service::discovery::v3::DeltaDiscoveryResponse& message,","+                        absl::string_view error_detail) override;","+  void onResourceUnsubscribed(absl::string_view type_url, absl::string_view resource) override;","+","+private:","+  class Registration;","+  struct Trackers {","+    std::vector<Registration*> entries_;","+    uint32_t iteration_depth_{0};","+    bool has_removed_entries_{false};","+  };","+","+  void forEach(absl::FunctionRef<void(XdsConfigTracker&)> callback);","+","+  // registration handles can outlive the manager during server teardown","+  const std::shared_ptr<Trackers> trackers_{std::make_shared<Trackers>()};","+};","+"," class XdsManagerImpl : public XdsManager {"," public:","   XdsManagerImpl(Event::Dispatcher& main_thread_dispatcher, Api::Api& api, Stats::Store& stats,","@@ -24,6 +69,10 @@ class XdsManagerImpl : public XdsManager {","   absl::Status","   initializeAdsConnections(const envoy::config::bootstrap::v3::Bootstrap& bootstrap) override;","   void startXdstpAdsMuxes() override;","+  ABSL_MUST_USE_RESULT Common::CallbackHandlePtr","+  addXdsConfigTracker(XdsConfigTracker& tracker) override {","+    return xds_config_trackers_.add(tracker);","+  }","   absl::StatusOr<SubscriptionPtr> subscribeToSingletonResource(","       absl::string_view resource_name, OptRef<const envoy::config::core::v3::ConfigSource> config,","       absl::string_view type_url, Stats::Scope& scope, SubscriptionCallbacks& callbacks,","@@ -85,6 +134,8 @@ class XdsManagerImpl : public XdsManager {","   ProtobufMessage::ValidationContext& validation_context_;","   XdsResourcesDelegatePtr xds_resources_delegate_;","   XdsConfigTrackerPtr xds_config_tracker_;","+  XdsConfigTrackers xds_config_trackers_;","+  Common::CallbackHandlePtr xds_config_tracker_handle_;","   std::unique_ptr<SubscriptionFactoryImpl> subscription_factory_;","   // The cm_ will only be valid after the cluster-manager is initialized.","   // Note that this implies that the xDS-manager must be shut down properly"],"additions":51,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/BUILD","lines":["@@ -173,6 +173,8 @@ envoy_cc_library(","         \":filter_chain_config_writer_lib\",","         \":listener_writer_lib\",","         \"//envoy/common:optref_lib\",","+        \"//envoy/config:xds_config_tracker_interface\",","+        \"//envoy/config:xds_manager_interface\",","         \"//envoy/event:dispatcher_interface\",","         \"//envoy/http:async_client_interface\",","         \"//envoy/server:admin_interface\","],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/abi_impl.cc","lines":["@@ -832,6 +832,18 @@ bool envoy_dynamic_module_callback_bootstrap_extension_enable_listener_lifecycle","   return config->enableListenerLifecycle();"," }"," ","+// -------------------- xDS Notification Callbacks --------------------","+","+bool envoy_dynamic_module_callback_bootstrap_extension_set_xds_notifications(","+    envoy_dynamic_module_type_bootstrap_extension_config_envoy_ptr config_envoy_ptr, bool enabled) {","+  if (!Envoy::Thread::MainThread::isMainOrTestThread()) {","+    IS_ENVOY_BUG(absl::StrCat(__func__, \" must be called on the main thread\"));","+    return false;","+  }","+  auto* config = static_cast<DynamicModuleBootstrapExtensionConfig*>(config_envoy_ptr);","+  return config->setXdsNotifications(enabled);","+}","+"," // -------------------- Runtime Update Callbacks --------------------"," "," bool envoy_dynamic_module_callback_bootstrap_extension_enable_runtime_update("],"additions":12,"deletions":0,"truncated":false},{"path":"source/extensions/bootstrap/dynamic_modules/extension_config.cc","lines":["@@ -4,6 +4,7 @@"," #include <utility>"," #include <vector>"," ","+#include \"envoy/config/xds_manager.h\""," #include \"envoy/server/admin.h\""," #include \"envoy/server/options.h\""," ","@@ -47,6 +48,7 @@ DynamicModuleBootstrapExtensionConfig::DynamicModuleBootstrapExtensionConfig("," }"," "," DynamicModuleBootstrapExtensionConfig::~DynamicModuleBootstrapExtensionConfig() {","+  xds_update_handle_.reset();","   extension_config_subscription_.reset();","   // Cancel any pending HTTP callouts before destroying the config.","   for (auto& callout : http_callouts_) {","@@ -250,6 +252,108 @@ void DynamicModuleBootstrapExtensionConfig::onListenerRemoval(const std::string&","   }"," }"," ","+bool DynamicModuleBootstrapExtensionConfig::setXdsNotifications(bool enabled) {","+  if (!enabled) {","+    ++xds_notifications_generation_;","+    xds_update_handle_.reset();","+    return true;","+  }","+  if (!server_initialized_) {","+    ENVOY_LOG(error, \"cannot enable xDS notifications before server is initialized\");","+    return false;","+  }","+  if (extension_destroyed_ || !shutdownNotificationExpected()) {","+    ENVOY_LOG(error, \"cannot enable xDS notifications once shutdown started or in init only mode\");","+    return false;","+  }","+  if (on_bootstrap_extension_xds_update_ == nullptr) {","+    ENVOY_LOG(error, \"cannot enable xDS notifications without the xDS update hook\");","+    return false;","+  }","+  if (xds_update_handle_ != nullptr) {","+    return true;","+  }","+  xds_update_handle_ = context_.xdsManager().addXdsConfigTracker(*this);","+  return xds_update_handle_ != nullptr;","+}","+","+void DynamicModuleBootstrapExtensionConfig::onConfigAccepted(","+    absl::string_view type_url, const std::vector<Config::DecodedResourcePtr>&) {","+  notifyXdsUpdate(type_url, envoy_dynamic_module_type_bootstrap_xds_update_status_Accepted, {}, {},","+             