"+\t\t\t\tawait assertSCIMEmailAvailable(ctx, userPatch.email, userId);","+\t\t\t\t// A reassigned email is unverified until the new address is confirmed.","+\t\t\t\tuserPatch.emailVerified = false;","+\t\t\t}","+","+\t\t\tconst deactivating = resolveSCIMActiveDeactivation(ctx, userPatch);","+"," \t\t\tawait Promise.all(["," \t\t\t\tObject.keys(userPatch).length > 0"," \t\t\t\t\t? ctx.context.internalAdapter.updateUser(userId, {","@@ -1136,6 +1251,10 @@ export const patchSCIMUser = (authMiddleware: AuthMiddleware) =>"," \t\t\t\t\t: Promise.resolve(),"," \t\t\t]);"," ","+\t\t\tif (deactivating) {","+\t\t\t\tawait ctx.context.internalAdapter.deleteUserSessions(userId);","+\t\t\t}","+"," \t\t\tctx.setStatus(204);"," \t\t\treturn;"," \t\t},","@@ -1258,6 +1377,19 @@ export const deleteSCIMUser = (authMiddleware: AuthMiddleware) =>"," \t\t\t\treturn;"," \t\t\t}"," ","+\t\t\t// Non-organization token: SCIM DELETE removes this provider's account,","+\t\t\t// not the global principal. Delete the global user only when this","+\t\t\t// provider's account is their sole identity; otherwise the user has","+\t\t\t// other linked accounts and we only unlink, leaving them intact.","+\t\t\tconst accounts = await ctx.context.internalAdapter.findAccounts(userId);","+\t\t\tconst hasOtherAccounts = accounts.some((a) => a.id !== account.id);","+","+\t\t\tif (hasOtherAccounts) {","+\t\t\t\tawait ctx.context.internalAdapter.deleteAccount(account.id);","+\t\t\t\tctx.setStatus(204);","+\t\t\t\treturn;","+\t\t\t}","+"," \t\t\tawait ctx.context.internalAdapter.deleteUserSessions(userId);"," \t\t\tawait ctx.context.internalAdapter.deleteUser(userId);"," "],"additions":141,"deletions":9,"truncated":false},{"path":"packages/scim/src/scim-resources.ts","lines":["@@ -28,7 +28,9 @@ export const createUserResource = ("," \t\t\tformatted: user.name,"," \t\t},"," \t\tdisplayName: user.name,","-\t\tactive: true,","+\t\t// `active` reflects the enforced disabled-user state. Without the admin","+\t\t// plu