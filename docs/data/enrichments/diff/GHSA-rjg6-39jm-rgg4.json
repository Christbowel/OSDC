{"id":"GHSA-rjg6-39jm-rgg4","axis":"advisories","repo":"better-auth/better-auth","sha":"7c126dcd1aad24468ec37e876545c1d083d8acca","parsed":{"files":[{"path":".changeset/scim-write-path.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@better-auth/scim\": patch","+---","+","+Tighten the SCIM user write path and honor the `active` attribute.","+","+A non-organization SCIM `DELETE` now unlinks the provider's own account when the user has other linked identities, and deletes the global user only when the SCIM account is their sole identity. `PUT` and `PATCH` reject changing a user's email to one already used by another user with a `409` conflict, and clear `emailVerified` when the email changes.","+","+The SCIM `active` attribute is honored on create, update, and patch. `active: false` deactivates the user through the admin plugin's banned state and revokes their sessions; `active: true` reactivates. The user resource reports the real state instead of always reporting active. Honoring `active` requires the admin plugin."],"additions":9,"deletions":0,"truncated":false},{"path":"docs/content/docs/plugins/scim.mdx","lines":["@@ -413,7 +413,9 @@ Allows to apply a partial update to the user details. This operation can only up"," "," #### Deletes a user resource"," ","-Completely deletes a user resource from the database. This operation can only delete users that belong to the same provider and organization than the SCIM token.","+Removes a user resource. This operation only affects users that belong to the same provider (and organization) as the SCIM token.","+","+For an organization-scoped token, the user is deprovisioned from the organization: their membership and the provider account are removed, while the global user record is kept. For a non-organization token, the global user is deleted only when this provider's account is their sole identity; otherwise just that account is unlinked."," "," <APIMethod path=\"/scim/v2/Users/:userId\" method=\"DELETE\" forceAsParam requireBearerToken isExternalOnly note=\"Deletes an existing user resource. See https://datatracker.ietf.org/doc/html/rfc7644#section-3.6\">","   ```ts","@@ -488,6 +490,8 @@ By default, the SCIM provisioning will automatically map the following fields:"," * `account.accountId`: Defaults to `externalId` and fallbacks to `userName`"," * `member.organizationId`: Organization associated to the provider"," ","+The SCIM `active` attribute maps to the user's disabled state. `active: false` deactivates the user (via the [admin](/docs/plugins/admin) plugin's `banned` state) and revokes their sessions; `active: true` reactivates. Honoring `active` requires the admin plugin. Changing a user's email through SCIM also resets their verified status.","+"," ## Schema"," "," The plugin requires additional fields in the `scimProvider` table to store the provider's configuration."],"additions":5,"deletions":1,"truncated":false},{"path":"packages/scim/src/patch-operations.ts","lines":["@@ -49,7 +49,15 @@ const familyName = (user: User, op: Operation, resources: Resources) => {"," \t});"," };"," ","+const active = (user: User, op: Operation, resources: Resources) => {","+\t// SCIM `active:false` deactivates the user; map it to the admin plugin's","+\t// enforced `banned` state (`banned = !active`). The handler requires the","+\t// admin plugin and revokes sessions on deactivation.","+\treturn op.value === false || op.value === \"false\";","+};","+"," const userPatchMappings: Record<string, Mapping> = {","+\t\"/active\": { resource: \"user\", target: \"banned\", map: active },"," \t\"/name/formatted\": { resource: \"user\", target: \"name\", map: identity },"," \t\"/name/givenName\": { resource: \"user\", target: \"name\", map: givenName },"," \t\"/name/familyName\": {"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/scim/src/routes.ts","lines":["@@ -277,6 +277,66 @@ async function checkSCIMProviderAccess("," \treturn provider;"," }"," ","+/**","+ * Rejects a SCIM email change that would collide with another user. Mirrors the","+ * uniqueness guard `createSCIMUser` already performs, so PUT/PATCH cannot","+ * reassign one user's email onto another existing user (which corrupts","+ * email-keyed login on adapters without a unique index and 500s on those with","+ * one). Only call this when the email actually changes.","+ */","+async function assertSCIMEmailAvailable(","+\tctx: GenericEndpointContext,","+\temail: string,","+\tuserId: string,","+): Promise<void> {","+\tconst existing = await ctx.context.adapter.findOne<User>({","+\t\tmodel: \"user\",","+\t\twhere: [{ field: \"email\", value: email.toLowerCase() }],","+\t});","+\tif (existing && existing.id !== userId) {","+\t\tthrow new SCIMAPIError(\"CONFLICT\", {","+\t\t\tdetail: \"Email already in use\",","+\t\t\tscimType: \"uniqueness\",","+\t\t});","+\t}","+}","+","+/**","+ * Applies SCIM `active` semantics to a pending user update. `active` maps to the","+ * admin plugin's `banned` field, the only enforced disabled-user state in Better","+ * Auth, so honoring deactivation requires the admin plugin. Returns whether the","+ * update deactivates the user, so the caller can revoke their sessions. A","+ * deactivation without the admin plugin is rejected, never silently dropped.","+ */","+function resolveSCIMActiveDeactivation(","+\tctx: GenericEndpointContext,","+\tuserUpdate: Record<string, unknown>,","+): boolean {","+\tif (!(\"banned\" in userUpdate)) return false;","+\tconst deactivating = userUpdate.banned === true;","+\tif (!ctx.context.hasPlugin(\"admin\")) {","+\t\tif (deactivating) {","+\t\t\tthrow new SCIMAPIError(\"BAD_REQUEST\", {","+\t\t\t\tdetail:","+\t\t\t\t\t\"Setting `active: false` requires the admin plugin, which provides the enforced disabled-user state\",","+\t\t\t});","+\t\t}","+\t\t// No admin plugin means no `banned` column: a reactivation has nothing to","+\t\t// clear, so drop it rather than write an unknown field.","+\t\t// biome-ignore lint/performance/noDelete: the field must not reach updateUser without an admin `banned` column.","+\t\tdelete userUpdate.banned;","+\t\treturn false;","+\t}","+\tif (deactivating) {","+\t\tuserUpdate.banReason = \"Deactivated via SCIM\";","+\t\treturn true;","+\t}","+\t// Reactivation clears the ban and its metadata, matching the admin plugin.","+\tuserUpdate.banReason = null;","+\tuserUpdate.banExpires = null;","+\treturn false;","+}","+"," export const generateSCIMToken = (opts: SCIMOptions) =>"," \tcreateAuthEndpoint("," \t\t\"/scim/generate-token\",","@@ -707,7 +767,16 @@ export const createSCIMUser = ("," \t\t\t\t});"," \t\t\t}"," ","-\t\t\tconst email = getUserPrimaryEmail(body.userName, body.emails);","+\t\t\t// Reject `active:false` before provisioning so create never persists a","+\t\t\t// user it cannot then deactivate.","+\t\t\tif (body.active === false) {","+\t\t\t\tresolveSCIMActiveDeactivation(ctx, { banned: true });","+\t\t\t}","+","+\t\t\tconst email = getUserPrimaryEmail(","+\t\t\t\tbody.userName,","+\t\t\t\tbody.emails,","+\t\t\t).toLowerCase();"," \t\t\tconst name = getUserFullName(email, body.name);"," "," \t\t\tconst existingUser = await ctx.context.adapter.findOne<User>({","@@ -792,6 +861,19 @@ export const createSCIMUser = ("," \t\t\t\t});"," \t\t\t}"," ","+\t\t\tif (body.active === false) {","+\t\t\t\tconst deactivation: Record<string, unknown> = { banned: true };","+\t\t\t\tresolveSCIMActiveDeactivation(ctx, deactivation);","+\t\t\t\tconst banned = await ctx.context.internalAdapter.updateUser(","+\t\t\t\t\tuser.id,","+\t\t\t\t\tdeactivation,","+\t\t\t\t);","+\t\t\t\tif (banned) {","+\t\t\t\t\tuser = banned;","+\t\t\t\t}","+\t\t\t\tawait ctx.context.internalAdapter.deleteUserSessions(user.id);","+\t\t\t}","+"," \t\t\tconst userResource = createUserResource("," \t\t\t\tctx.context.baseURL,"," \t\t\t\tuser,","@@ -850,19 +932,37 @@ export const updateSCIMUser = (authMiddleware: AuthMiddleware) =>"," \t\t\t\t});"," \t\t\t}"," ","+\t\t\tconst email = getUserPrimaryEmail(","+\t