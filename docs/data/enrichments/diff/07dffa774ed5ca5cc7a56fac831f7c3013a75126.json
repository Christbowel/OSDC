,"+    {","+        if ($token === '' || !$this->isSelectorConsistent($parameters)) {","+            return false;","+        }","+","+        return hash_equals($this->createToken($parameters), $token);","+    }","+","+    /**","+     * Creates the token based on the incoming parameters.","+     * Note: This method is currently private on purpose, it may become public at a later point.","+     *","+     * @param array<string, int|string> $parameters","+     */","+    private function createToken(array $parameters): string","+    {","+        return $this->hashService->hmac(implode('|', $parameters), self::ADDITIONAL_SECRET, HashAlgo::SHA3_256);","+    }","+","+    /**","+     * Ensures exactly one of the object selectors \"f\" (sys_file), \"r\" (sys_file_reference)","+     * or \"p\" (sys_file_processedfile) is present, and that it matches the signed \"t\" value.","+     *","+     * @param array<string, int|string> $parameters","+     */","+    private function isSelectorConsistent(array $parameters): bool","+    {","+        $present = array_values(array_intersect(['f', 'r', 'p'], array_keys($parameters)));","+        if (count($present) !== 1) {","+            return false;","+        }","+        return ($parameters['t'] ?? null) === $present[0];","+    }","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Controller/FileDumpControllerTest.php","lines":["@@ -0,0 +1,139 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Tests\\Functional\\Controller;","+","+use PHPUnit\\Framework\\Attributes\\DataProvider;","+use PHPUnit\\Framework\\Attributes\\Test;","+use Psr\\Http\\Message\\ServerRequestInterface;","+use TYPO3\\CMS\\Core\\Controller\\FileDumpController;","+use TYPO3\\CMS\\Core\\Crypto\\HashAlgo;","+use TYPO3\\CMS\\Core\\Crypto\\HashService;","+use TYPO3\\CMS\\Core\\Http\\ServerRequest;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class FileDumpControllerTest extends FunctionalTestCase","+{","+    protected array $pathsToProvideInTestInstance = [","+        'typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/user_upload/harmless.jpg' => 'fileadmin/user_upload/harmless.jpg',","+        'typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/user_upload/secret.jpg' => 'fileadmin/user_upload/secret.jpg',","+        'typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/_processed_/harmless_processed.jpg' => 'fileadmin/_processed_/harmless_processed.jpg',","+        'typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/_processed_/secret_processed.jpg' => 'fileadmin/_processed_/secret_processed.jpg',","+    ];","+","+    private FileDumpController $controller;","+    private HashService $hashService;","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/Controller/FileDumpController/DatabaseImport.csv');","+        $this->controller = $this->get(FileDumpController::class);","+        $this->hashService = $this->get(HashService::class);","+    }","+","+    /**","+     * Fixture layout (uids deliberately colliding across tables):","+     *   sys_file uid=1                 -> harmless.jpg","+     *   sys_file uid=2                 -> secret.jpg","+     *   sys_file_reference uid=1       -> uid_local=2 (secret.jpg)   <- collides with sys_file uid 1","+     *   sys_file_reference uid=2       -> uid_local=1 (harmless.jpg) <- legitimate","+     *   sys_file_processedfile uid=1   -> original=2 (secret.jpg)    <- collides with sys_file uid 1","+     *   sys_file_processedfile uid=3   -> original=1 (harmless.jpg)  <- legitimate","+     */","+    public static function replayedTokenIsRejectedDataProvider(): iterable","+    {","+        yield 'token for f=1 replayed as r=1 must not resolve sys_file_reference' => [","+            ['eID' => 'dumpFile', 't' => 'f', 'f' => 1],","+            ['eID' => 'dumpFile', 't' => 'f', 'r' => 1],","+        ];","+        yield 'token for f=1 replayed as p=1 must not resolve sys_file_processedfile' => [","+            ['eID' => 'dumpFile', 't' => 'f', 'f' => 1],","+            ['eID' => 'dumpFile', 't' => 'f', 'p' => 1],","+        ];","+    }","+","+    #[Test]","+    #[DataProvider('replayedTokenIsRejectedDataProvider')]","+    public function replayedTokenIsRejected(array $signedParameters, array $requestParameters): void","+    {","+        $token = $this->createToken($signedParameters);","+        $response = $this->controller->dumpAction($this->buildRequest($requestParameters, $token));","+","+        self::assertSame(403, $response->getStatusCode());","+    }","+","+    public static function matchingSelectorAndTypeSucceedsDataProvider(): iterable","+    {","+        yield 'sys_file, harmless' => [['eID' => 'dumpFile', 't' => 'f', 'f' => 1], 'harmless.jpg'];","+        yield 'sys_file, secret' => [['eID' => 'dumpFile', 't' => 'f', 'f' => 2], 'secret.jpg'];","+        yield 'sys_file_reference, legitimate' => [['eID' => 'dumpFile', 't' => 'r', 'r' => 2], 'harmless.jpg'];","+        yield 'sys_file_processedfile, legitimate' => [['eID' => 'dumpFile', 't' => 'p', 'p' => 3], 'harmless_processed.jpg'];","+    }","+","+    #[Test]","+    #[DataProvider('matchingSelectorAndTypeSucceedsDataProvider')]","+    public function matchingSelectorAndTypeSucceeds(array $parameters, string $expectedFilename): void","+    {","+        $token = $this->createToken($parameters);","+        $response = $this->controller->dumpAction($this->buildRequest($parameters, $token));","+","+        self::assertSame(200, $response->getStatusCode());","+        self::assertStringContainsString($expectedFilename, $response->getHeaderLine('Content-Disposition'));","+    }","+","+    #[Test]","+    public function requestWithoutAnySelectorIsRejected(): void","+    {","+        $parameters = ['eID' => 'dumpFile', 't' => 'f'];","+        $token = $this->createToken($parameters);","+        $response = $this->controller->dumpAction($this->buildRequest($parameters, $token));","+","+        self::assertSame(403, $response->getStatusCode());","+    }","+","+    #[Test]","+    public function requestWithTwoSelectorsIsRejected(): void","+    {","+        $parameters = ['eID' => 'dumpFile', 't' => 'f', 'f' => 1, 'r' => 2];","+        $token = $this->createToken($parameters);","+        $response = $this->controller->dumpAction($this->buildRequest($parameters, $token));","+","+        self::assertSame(403, $response->getStatusCode());","+    }","+","+    #[Test]","+    public function requestWithTypeNotMatchingAnySelectorIsRejected(): void","+    {","+        $parameters = ['eID' => 'dumpFile', 't' => 'x', 'f' => 1];","+        $token = $this->createToken($parameters);","+        $response = $this->controller->dumpAction($this->buildRequest($parameters, $token));","+","+        self::assertSame(403, $response->getStatusCode());","+    }","+","+    private function createToken(array $parameters): string","+    {","+        return $this->hashService->hmac(implode('|', $parameters), 'resourceStorageDumpFile', HashAlgo::SHA3_256);","+    }","+","+    private function buildRequest(array $parameters, string $token): ServerRequestInterface","+    {","+        unset($parameters['eID']);","+        return new ServerRequest()->withQueryParams(array_merge(['eID' => 'dumpFile'], $parameters, ['token' => $token]));","+    }","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/DatabaseImport.csv","lines":["@@ -0,0 +1,12 @@","+sys_file,,,,,,,,,,,,,,","+,uid,pid,storage,type,identifier,identifier_hash,folder_hash,extension,mime_type,name,sha1,size,creation_date,modification_date","+,1,0,1,2,/user_upload/harmless.jpg,b5d74b3b4fe10ebbd0c0a418d3e8d9a5abe33a0f,85b130b44ae1a7dae9348a42b3d4a68e5450fc44,jpg,image/jpeg,harmless.jpg,da39a3ee5e6b4b0d3255bfef95601890afd80709,0,1389878273,1389878273","+,2,0,1,2,/user_upload/secret.jpg,7ad7bcf65fc717fb759bf1d1865bd481c6afd206,85b130b44ae1a7dae9348a42b3d4a68e5450fc44,jpg,image/jpeg,secret.jpg,da39a3ee5e6b4b0d3255bfef95601890afd80709,0,1389878273,1389878273","+sys_file_reference,,,,,,,,,,,,,,","+,uid,uid_local,uid_foreign,tablenames,fieldname,,,,,,,,","+,1,2,1,tt_content,image,,,,,,,,","+,2,1,1,tt_content,image,,,,,,,,","+sys_file_processedfile,,,,,,,,,,,,,,","+,uid,storage,original,identifier,name,configuration,width,height,task_type,,,,,","+,1,1,2,/_processed_/secret_processed.jpg,secret_processed.jpg,a:0:{},300,225,Image.Preview,,,,,","+,3,1,1,/_processed_/harmless_processed.jpg,harmless_processed.jpg,a:0:{},300,225,Image.Preview,,,,,"],"additions":12,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/_processed_/harmless_processed.jpg","lines":[],"additions":0,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/_processed_/secret_processed.jpg","lines":[],"additions":0,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpController/Folders/fileadmin/user_upload/harmless.jpg","lines":[],"additions":0,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Fixtures/Controller/FileDumpCo