string())));","+    assert_eq!(python_args, [\"--hf-token\", \"hf_secret\"]);","+    assert!(!format!(\"{config:?}\").contains(\"hf_secret\"));","+    // `/server_info` serializes the config.","+    assert!(!serde_json::to_string(&config).unwrap().contains(\"hf_secret\"));","+","+    let cli =","+        Cli::try_parse_from([\"vllm-rs\", \"render\", \"org/model\", \"--hf-token\", \"hf_secret\"]).unwrap();","+    let Command::Render(args) = cli.command else {","+        panic!(\"expected render args\");","+    };","+    assert_eq!(","+        args.into_config().hf_token,","+        Some(HfToken(\"hf_secret\".to_string()))","+    );","+","+    let frontend = |hf_token: &str| {","+        let payload = format!(r#\"{{\"model_tag\":\"org/model\",\"hf_token\":{hf_token}}}\"#);","+        Cli::try_parse_from([","+            \"vllm-rs\",","+            \"frontend\",","+            \"--listen-fd\",","+            \"3\",","+            \"--input-listener-fd\",","+            \"999999\",","+            \"--output-listener-fd\",","+            \"999998\",","+            \"--args-json\",","+            &payload,","+        ])","+        .map(|cli| {","+            let Command::Frontend(args) = cli.command else {","+                panic!(\"expected frontend args\");","+            };","+            args.into_config().hf_token","+        })","+    };","+    // Python sends `True` for a bare flag and the string otherwise.","+    assert_eq!(frontend(\"true\").unwrap(), None);","+    assert_eq!(","+        frontend(r#\"\"hf_secret\"\"#).unwrap(),","+        Some(HfToken(\"hf_secret\".to_string()))","+    );","+    assert!(frontend(\"false\").is_err());","+}","+"," #[test]"," fn hf_overrides_preserve_merge_patch_in_cli_and_python_bootstrap() {","     let patch = r#\"{\"text_config\":{\"rope_parameters\":{\"factor\":4}},\"sliding_window\":null}\"#;","@@ -3289,6 +3357,7 @@ fn serve_args_accept_handshake_aliases() {","                             tokenizer_revision: None,","           