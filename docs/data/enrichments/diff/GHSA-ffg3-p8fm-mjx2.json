vents `_` function arguments together with a single `*`.\"\"\"","     result = compile_restricted_exec(\"def foo(good, *, _bad): pass\")","     assert result.errors == (functiondef_err_msg,)"," "," ","+def test_positional_only_lambda_arg_with_underscore_is_rejected():","+    \"\"\"It prevents positional-only lambda arguments starting with `_`.\"\"\"","+    result = compile_restricted_exec(\"f = lambda _bad, /: None\")","+    assert result.errors == (functiondef_err_msg,)","+","+"," BLACKLISTED_FUNC_NAMES_CALL_TEST = \"\"\""," def __init__(test):","     test",""],"additions":18,"deletions":0,"truncated":false}],"additions":25,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-08-29T13:43:41.411439+00:00"}