+    for patch in patches {","+        if !patched_dependencies.contains_key(patch) {","+            return Err(PatchRemoveError::PatchNotFound { patch: patch.clone() });","+        }","+    }","+    Ok(())","+}","+","+fn collect_removal_targets(","+    patches: &[String],","+    patched_dependencies: &IndexMap<String, String>,","+    ctx: &PatchRemovalContext,","+) -> Result<Vec<PatchRemovalTarget>, PatchRemoveError> {","+    patches","+        .iter()","+        .map(|patch| {","+            let patch_file = patched_dependencies","+                .get(patch)","+                .ok_or_else(|| PatchRemoveError::PatchNotFound { patch: patch.clone() })?;","+            PatchRemovalTarget::new(patch, patch_file, ctx)","+        })","+        .collect()","+}","+","+fn unlink_removed_patches(","+    targets: &[PatchRemovalTarget],","+    remaining: &HashSet<PathBuf>,","+) -> Result<(), PatchRemoveError> {","+    for target in targets {","+        if !remaining.contains(&target.target_path) {","+            unlink_patch_if_exists(target)?;","+        }","+    }","+    Ok(())","+}","+"," fn patches_to_remove(","     patches: Vec<String>,","     patched_dependencies: &IndexMap<String, String>,"],"additions":59,"deletions":25,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_remove/tests.rs","lines":["@@ -4,7 +4,7 @@ use super::{","     patches_from_selected_indices, patches_to_remove, remove_empty_patch_dirs,","     remove_empty_patch_dirs_with_fs, select_patches_from_indices, unlink_patch_if_exists,"," };","-use crate::State;","+use crate::{State, cli_args::patch_state::StateFileError};"," use indexmap::IndexMap;"," use std::{io::IsTerminal, path::Path};"," ","@@ -404,3 +404,75 @@ impl PatchRemoveFs for NonEmptyDirFs {","         panic!(\"non-empty dirs should not be removed\")","     }"," }","+","+/// A project with one patch, `pkg@1.0.0`, whose `state.json` the caller","+/// writes through `write_state`.","+async fn run_patch_remove_with_state(","+    write_state: impl FnOnce(&Path),","+) -> (tempfile::TempDir, std::path::PathBuf, PatchRemoveError) {","+    let tmp = tempfile::tempdir().expect(\"temp dir\");","+    std::fs::write(tmp.path().join(\"package.json\"), \"{}\").expect(\"write package.json\");","+    let patch_file = tmp.path().join(\"patches/pkg.patch\");","+    std::fs::create_dir_all(patch_file.parent().expect(\"patch parent\"))","+        .expect(\"create patches dir\");","+    std::fs::write(&patch_file, \"patch\").expect(\"write patch\");","+    let modules_dir = tmp.path().join(\"node_modules\");","+    std::fs::create_dir_all(modules_dir.join(\".pnpm_patches\")).expect(\"create state dir\");","+    write_state(&modules_dir.join(\".pnpm_patches/state.json\"));","+","+    let mut config = pnpm_config::Config::new();","+    config.workspace_dir = Some(tmp.path().to_path_buf());","+    config.modules_dir = modules_dir;","+    config.patched_dependencies =","+        Some(IndexMap::from([(\"pkg@1.0.0\".to_string(), \"patches/pkg.patch\".to_string())]));","+    let config: &'static pnpm_config::Config = Box::leak(Box::new(config));","+    let state = State {","+        tarball_mem_cache: std::sync::Arc::new(pnpm_tarball::MemCache::default()),","+        http_client: std::sync::Arc::new(pnpm_network::ThrottledClient::default()),","+        config,","+        manifest: pnpm_package_manifest::PackageManifest::from_path(","+            tmp.path().join(\"package.json\"),","+        )","+        .expect(\"package manifest\"),","+        lockfile: pnpm_lockfile::LazyLockfile::disabled(),","+        resolved_packages: pnpm_package_manager::ResolvedPackages::new(),","+        dedicated: None,","+        discovered_workspace: None,","+    };","+","+    let err = PatchRemoveArgs { patches: vec![\"pkg@1.0.0\".to_string()] }","+        .run(tmp.path(), state)","+        .await","+        .expect_err(\"unsafe patch state should error\");","+    (tmp, patch_file, err)","+}","+","+#[tokio::test]","+async fn run_rejects_malformed_patch_state_before_removing_patches() {","+    let (_tmp, patch_file, err) = run_patch_remove_with_state(|state_file| {","+        std::fs::write(state_file, \"{\").expect(\"write state\");","+    })","+    .await;","+","+    assert!(matches!(err, PatchRemoveError::StateFile(StateFileError::Parse { .. })), \"{err:?}\");","+    assert!(patch_file.exists());","+}","+","+#[cfg(unix)]","+#[tokio::test]","+async fn run_rejects_symlinked_patch_state_file_before_removing_patches() {","+    let outside = tempfile::tempdir().expect(\"outside dir\");","+    let outside_state = outside.path().join(\"state.json\");","+    std::fs::write(&outside_state, \"{}\").expect(\"write outside state\");","+    let (_tmp, patch_file, err) = run_patch_remove_with_state(|state_file| {","+        std::os::unix::fs::symlink(&outside_state, state_file).expect(\"symlink state\");","+    })","+    .await;","+","+    assert!(","+        matches!(err, PatchRemoveError::StateFile(StateFileError::UnsafePath { .. })),","+        \"{err:?}\",","+    );","+    assert!(patch_file.exists());","+    assert_eq!(std::fs::read_to_string(&outside_state).expect(\"outside state\"), \"{}\");","+}"],"additions":73,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_state.rs","lines":["@@ -4,7 +4,7 @@ use pnpm_fs::{is_subdir, lexical_normalize};"," use pnpm_lockfile::PackageKey;"," use serde::{Deserialize, Serialize};"," use std::{","-    collections::BTreeMap,","+    collections::{BTreeMap, HashSet},","     env, fs, io,","     path::{Path, PathBuf},"," };","@@ -73,6 +73,22 @@ pub(crate) enum StateFileError {","         #[error(source)]","         source: io::Error,","     },","+","+    #[display(\"Failed to remove patch state file {path:?}: {source}\")]","+    #[diagnostic(code(ERR_PNPM_PATCH_STATE_REMOVE))]","+    Remove {","+        path: PathBuf,","+        #[error(source)]","+        source: io::Error,","+    },","+","+    #[display(\"Failed to remove patch edit directory {path:?}: {source}\")]","+    #[diagnostic(code(ERR_PNPM_PATCH_STATE_REMOVE_EDIT_DIR))]","+    RemoveEditDir {","+        path: PathBuf,","+        #[error(source)]","+        source: io::Error,","+    },"," }"," "," pub(crate) fn read_edit_dir_state(","@@ -110,6 +126,147 @@ pub(crate) fn write_edit_dir_state(","         .map_err(|source| StateFileError::Write { path, source })"," }"," ","+pub(crate) fn validate_patch_state_dir(modules_dir: &Path) -> Result<(), StateFileError> {","+    let state_dir = modules_dir.join(STATE_DIR);","+    reject_state_symlink_if_exists(&state_dir)?;","+    if let (Ok(real_modules_dir), Ok(real_state_dir)) =","+        (dunce::canonicalize(modules_dir), dunce::canonicalize(&state_dir))","+        && !is_subdir(&real_modules_dir, &real_state_dir)","+    {","+        return Err(StateFileError::UnsafePath {","+            path: state_dir,","+            reason: \"must stay under the modules directory\",","+        });","+    }","+    Ok(())","+}","+","+pub(crate) fn clean_patch_state_and_edit_dirs(","+    modules_dir: &Path,","+    patches: &[String],","+) -> Result<(), StateFileError> {","+    validate_patch_state_dir(modules_dir)?;","+    let state_dir = modules_dir.join(STATE_DIR);","+    let mut dirs_to_remove = remove_matching_state_entries(modules_dir, &state_dir, patches)?;","+    for patch in patches {","+        dirs_to_remove.insert(state_dir.join(patch));","+    }","+    remove_edit_dirs(&state_dir, &dirs_to_remove)?;","+    remove_state_dir_if_empty(&state_dir);","+    Ok(())","+}","+","+fn remove_matching_state_entries(","+    modules_dir: &Path,","+    state_dir: &Path,","+    patches: &[String],","+) -> Result<HashSet<PathBuf>, StateFileError> {","+    let path = checked_state_file_path_for_read(modules_dir)?;","+    let Some(text) = read_state_file_text(&path)? else {","+        return Ok(HashSet::new());","+    };","+    let mut state: BTreeMap<String, EditDirState> = serde_json::from_str(&text)","+        .map_err(|source| StateFileError::Parse { path: path.clone(), source })?;","+    let mut dirs = HashSet::new();","+    let patches_set: HashSet<&str> = patches","+        .iter()","+        .map(String::as_str)","+        .collect();","+    let target_keys: HashSet<String> = patches","+        .iter()","+        .map(|patch| state_dir.join(patch))","+        .filter(|edit_dir| {","+            !edit_dir.exists() || link_free_relative_path(state_dir, edit_dir).is_some()","+        })","+        .map(|edit_dir| edit_dir_key(&edit_dir))","+        .collect::<Result<_, _>>()?;","+    state.retain(|key, entry| {","+        let matches = patches_set.contains(entry.patched_pkg.as_str()) || target_keys.contains(key);","+        if matches {","+            dirs.insert(PathBuf::from(key));","+            false","+        } else {","+            true","+        }","+    });","+    save_or_remove_state_file(&path, &state)?;","+    Ok(dirs)","+}","+","+fn save_or_remove_state_file(","+    path: &Path,","+    state: &BTreeMap<String, EditDirState>,","+) -> Result<(), StateFileError> {","+    if state.is_empty() {","+        if let Err(source) = fs::remove_file(path)","+            && source.kind() != io::ErrorKind::NotFound","+        {","+            return Err(StateFileError::Remove { path: path.to_path_buf(), source });","+        }","+    } else {","+        let text = serde_json::to_string_pretty(state)","+            .map_err(|source| StateFileError::Serialize { path: path.to_path_buf(), source })?;","+        pnpm_fs::write_atomic(path, text.as_bytes())","+            .map_err(|source| StateFileError::Write { path: path.to_path_buf(), source })?;","+    }","+    Ok(())","+}","+","+fn remove_edit_dirs(state_dir: &Path, dirs: &HashSet<PathBuf>) -> Result<(), StateFileError> {","+    for dir in dirs {","+        if !is_real_dir(dir) {","+            continue;","+        }","+        let Some(relative) = link_free_relative_path(state_dir, dir) else { continue };","+        if let Err(source) = fs::remove_dir_all(dir)","+            && source.kind() != io::ErrorKind::NotFound","+        {","+            return Err(StateFileError::RemoveEditDir { path: dir.clone(), source });","+        }","+        remove_empty_ancestors(state_dir, &relative);","+    }","+    Ok(())","+}","+","+/// The path of `dir` relative to `state_dir` when `dir` is strictly inside","+/// `state_dir` with no symbolic link on the way, so removing it cannot reach","+/// another edit directory or leave the state directory. `dir` may be spelled","+/// through `state_dir` or its canonical form.","+fn link_free_relative_path(state_dir: &Path, dir: &Path) -> Option<PathBuf> {","+    let canonical_state_dir = dunce::canonicalize(state_dir).ok()?;","+    let relative = dir","+        .strip_prefix(state_dir)","+        .or_else(|_| dir.strip_prefix(&canonical_state_dir))","+        .ok()?;","+    let is_link_free = !relative.as_os_str().is_empty()","+        && dunce::canonicalize(dir).is_ok_and(|real| real == canonical_state_dir.join(relative));","+    is_link_free.then(|| relative.to_path_buf())","+}","+","+/// Whether `path` is a directory itself, not a file or a link to a directory.","+fn is_real_dir(path: &Path) -> bool {","+    fs::symlink_metadata(path).is_ok_and(|meta| meta.is_dir())","+}","+","+/// Removes the directories between `state_dir` and a removed edit directory","+/// at `relative`, such as the scope directory of `@scope/pkg@1.0.0`, while","+/// they are empty.","+fn remove_empty_ancestors(state_dir: &Path, relative: &Path) {","+    for parent in relative.ancestors().skip(1) {","+        if parent.as_os_str().is_empty() || fs::remove_dir(state_dir.join(parent)).is_err() {","+            break;","+        }","+    }","+}","+","+fn remove_state_dir_if_empty(state_dir: &Path) {","+    if let Ok(mut entries) = fs::read_dir(state_dir)","+        && entries.next().is_none()","+    {","+        let _ = fs::remove_dir(state_dir);","+    }","+}","+"," fn read_state_file_for_write(","     path: &Path,"," ) -> Result<BTreeMap<String, EditDirState>, StateFileError> {"],"additions":158,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/patch_state/tests.rs","lines":["@@ -1,6 +1,9 @@"," #[cfg(unix)]"," use super::edit_dir_key;","-use super::{EditDirState, StateFileError, read_edit_dir_state, write_edit_dir_state};","+use super::{","+    EditDirState, StateFileError, clean_patch_state_and_edit_dirs, read_edit_dir_state,","+    write_edit_dir_state,","+};"," use pretty_assertions::assert_eq;"," use serde_json::json;"," use std::{env, fs, path::Path, sync::Mutex};","@@ -277,6 +280,229 @@ fn patch_state_errors_when_edit_dir_parent_is_not_a_directory() {","     assert!(matches!(err, StateFileError::ResolveEditDir { .. }));"," }"," ","+#[test]","+fn patch_state_clean_removes_matching_entry_and_edit_dir() {","+    let tmp = tempdir().expect(\"temp dir\");","+    let modules_dir = tmp.path().join(\"node_modules\");","+    let first_edit_dir = modules_dir.join(\".pnpm_patches\").join(\"is-positive@1.0.0\");","+    let second_edit_dir = modules_dir.join(\".pnpm_patches\").join(\"is-negative@1.0.0\");","+    fs::create_dir_all(&first_edit_dir).expect(\"create first edit dir\");","+    fs::create_dir_all(&second_edit_dir).expect(\"create second edit dir\");","+","+    write_edit_dir_state(&modules_dir, &first_edit_dir, &sample_state()).unwrap();","+    write_edit_dir_state(","+        &modules_dir,","+        &second_edit_dir,","+        &EditDirState {","+            patched_pkg: \"is-negative@1.0.0\".to_string(),","+            apply_to_all: true,","+            package_key: None,","+        },","+    )","+    .unwrap();","+","+    clean_patch_state_and_edit_dirs(&modules_dir, &[\"is-positive@1.0.0\".to_string()]).unwrap();","+","+    assert!(!first_edit_dir.exists());","+    assert!(second_edit_dir.exists());","+    let remaining = read_edit_dir_state(&modules_dir, &second_edit_dir).unwrap();","+    assert_eq!(","+        remaining,","+        Some(EditDirState {","+            patched_pkg: \"is-negative@1.0.0\".to_string(),","+            apply_to_all: true,","+            package_key: None,","+        }),","+    );","+    assert_eq!(read_edit_dir_state(&modules_dir, &first_edit_dir).unwrap(), None);","+}","+","+#[test]","+fn patch_state_clean_removes_state_file_and_state_dir_when_empty() {","+    let tmp = tempdir().expect(\"temp dir\");","+    let modules_dir = tmp.path().join(\"node_modules\");","+    let edit_dir = modules_dir.join(\".pnpm_patches\").join(\"is-positive@1.0.0\");","+    fs::create_dir_all(&edit_dir).expect(\"create edit dir\");","+","+    write_edit_dir_state(&modules_dir, &edit_dir, &sample_state()).unwrap();","+","+    clean_patch_state_and_edit_dirs(&modules_dir, &[\"is-positive@1.0.0\".to_string()]).unwrap();","+","+    assert!(!edit_dir.exists());","+    let state_file = modules_dir.join(\".pnpm_patches\").join(\"state.json\");","+    assert!(!state_file.exists());","+    assert!(!modules_dir.join(\".pnpm_patches\").exists());","+}","+","+#[test]","+fn patch_state_clean_does_not_remove_entries_with_suffix_names() {","+    let tmp = tempdir().expect(\"temp dir\");","+    let modules_dir = tmp.path().join(\"node_modules\");","+    let target_edit_dir = modules_dir.join(\".pnpm_patches\").join(\"foo\");","+    let suffix_edit_dir = modules_dir.join(\".pnpm_patches\").join(\"my-foo\");","+    fs::create_dir_all(&target_edit_dir).expect(\"create target edit dir\");","+    fs::create_dir_all(&suffix_edit_dir).expect(\"create suffix edit dir\");","+","+    write_edit_dir_state(","+        &modules_dir,","+        &target_edit_dir,","+        &EditDirState { patched_pkg: \"foo\".to_string(), apply_to_all: true, package_key: None },","+    )","+    .unwrap();","+    write_edit_dir_state(","+        &modules_dir,","+        &suffix_edit_dir,","+        &EditDirState { patched_pkg: \"my-foo\".to_string(), apply_to_all: true, package_key: None },","+    )","+    .unwrap();","+","+    clean_patch_state_and_edit_dirs(&modules_dir, &[\"foo\".to_string()]).unwrap();","+","+    assert!(!target_edit_dir.exists());","+    assert!(suffix_edit_dir.exists());","+    assert_eq!(","+        read_edit_dir_state(&modules_dir, &suffix_edit_dir).unwrap(),","+        Some(EditDirState {","+            patched_pkg: \"my-foo\".to_string(),","+            apply_to_all: true,","+            package_key: None,","+        }),","+    );","+    assert_eq!(read_edit_dir_state(&modules_dir, &target_edit_dir).unwrap(), None);","+}","+","+#[test]","+fn patch_state_clean_keeps_edit_dirs_when_patch_names_the_state_dir() {","+    let tmp = tempdir().expect(\"temp dir\");","+    let modules_dir = tmp.path().join(\"node_modules\");","+    let other_edit_dir = modules_dir.join(\".pnpm_patches\").join(\"is-positive@1.0.0\");","+    fs::create_dir_all(&other_edit_dir).expect(\"create other edit dir\");","+    write_edit_dir_state(&modules_dir, &other_edit_dir, &sample_state()).unwrap();","+","+    clean_patch_state_and_edit_dirs(&modules_dir, &[\".\".to_string()]).unwrap();","+","+    assert!(other_edit_dir.exists());","+    assert_eq!(read_edit_dir_state(&modules_dir, &other_edit_dir).unwrap(), Some(sample_state()));","+}","+","+#[test]","+fn patch_state_clean_keeps_state_file_when_patch_names_it() {","+    let tmp = tempdir().expect(\"temp dir\");","+    let modules_dir = tmp.path().join(\"node_modules\");","+    let other_edit_dir = modules_dir.join(\".pnpm_patches\").join(\"is-positive@1.0.0\");","+    fs::create_dir_all(&other_edit_dir).expect(\"create other edit dir\");","+    write_edit_dir_state(&modules_dir, &other_edit_dir, &sample_state()).unwrap();","+","+    clean_patch_state_and_edit_dirs(&modules_dir, &[\"state.json\".to_string()]).unwrap();","+","+    assert_eq!(read_edit_dir_state(&modules_dir, &other_edit_dir).unwrap(), Some(sample_state()));","+}","+","+#[test]","+fn patch_state_clean_removes_empty_scope_dir() {","+    let tmp = tempdir().expect(\"temp dir\");","+    