","+#[tokio::test]","+async fn an_uncached_upstream_streams_verified_downloads_without_caching() {","+    let mut upstream = mockito::Server::new_async().await;","+    let archive = crate_archive(\"sample_crate\", \"1.0.0\");","+    upstream","+        .mock(\"GET\", \"/config.json\")","+        .with_body(json!({ \"dl\": format!(\"{}/dl\", upstream.url()) }).to_string())","+        .create_async()","+        .await;","+    upstream","+        .mock(\"GET\", \"/sa/mp/sample_crate\")","+        .with_body(format!(","+            \"{}\\n\",","+            json!({","+                \"name\": \"sample_crate\",","+                \"vers\": \"1.0.0\",","+                \"deps\": [],","+                \"cksum\": sha256_hex(&archive),","+                \"features\": {},","+                \"yanked\": false,","+                \"v\": 1,","+            }),","+        ))","+        .create_async()","+        .await;","+    let download_mock = upstream","+        .mock(\"GET\", \"/dl/sample_crate/1.0.0/download\")","+        .with_body(archive.clone())","+        .expect(2)","+        .create_async()","+        .await;","+","+    let tmp = TempDir::new().unwrap();","+    let mut config = cargo_config(tmp.path().to_path_buf(), &upstream.url(), \"$all\");","+    config.routing.upstreams.get_mut(\"cratesio\").expect(\"`cratesio` upstream\").cache = false;","+    let app = router_with_auth(config, AuthState::in_memory());","+","+    for _ in 0..2 {","+        let response = app","+            .clone()","+            .oneshot(","+                Request::get(\"/cargo/api/v1/crates/sample_crate/1.0.0/download\")","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::OK);","+        assert_eq!(response.headers()[header::CONTENT_LENGTH], archive.len().to_string());","+        assert_eq!(body_bytes(response.into_body()).await, archive);","+    }","+    download_mock.assert_async().await;","+    let cache = tmp.path().join(\".pnpr-cache\");","+    assert!(","+        find_file(&cache, &blob_segment(\"sample-crate\", \"sample_crate-1.0.0.crate\")).is_none(),","+        \"a cache: false upstream persists no download\",","+    );","+}","+"," #[tokio::test]"," async fn a_download_that_fails_the_index_checksum_is_never_cached() {","     let mut upstream = mockito::Server::new_async().await;"],"additions":61,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/server/tarball_proxy.rs","lines":["@@ -1,8 +1,8 @@"," use super::{","-    AccessList, Body, PackageRules, Request, ServiceExt, StatusCode, TempDir, Value, access_rule,","-    body_bytes, body_json, config_for, enable_osv, foo_packument, header, json,","-    mock_packument_for_tarball, osv_database, public_cache_blob, public_cache_blobs, router,","-    router_with_auth, sha512_integrity, upstream_endpoint_config,","+    AccessList, Body, Duration, PackageRules, Request, ServiceExt, StatusCode, TempDir, Value,","+    access_rule, await_no_tgz, body_bytes, body_json, config_for, enable_osv, foo_packument,","+    header, json, mock_packument_for_tarball, osv_database, public_cache_blob, public_cache_blobs,","+    router, router_with_auth, sha512_integrity, upstream_endpoint_config,"," };"," use crate::tokens::issue_token;"," ","@@ -1007,3 +1007,118 @@ async fn upstream_pnpr_version_route_tarball_is_proxied() {","     packument_mock.assert_async().await;","     tarball_mock.assert_async().await;"," }","+","+/// `maxTarballSize` caps a tarball fetched from an upstream: one that","+/// declares more is refused before any of it is streamed, and the same tarball","+/// is served once the cap is raised past it. The response carries no reason,","+/// like every upstream failure; the cap is what tells the two runs apart.","+#[tokio::test]","+async fn upstream_tarball_over_max_tarball_size_is_refused_until_the_cap_is_raised() {","+    let mut upstream = mockito::Server::new_async().await;","+    let bytes = vec![0xAB_u8; 8 * 1024];","+    let _packument_mock = mock_packument_for_tarball(&mut upstream, \"big\", \"1.0.0\", &bytes).await;","+    let tarball_mock = upstream","+        .mock(\"GET\", \"/big/-/big-1.0.0.tgz\")","+        .with_status(200)","+        .with_header(\"content-type\", \"application/octet-stream\")","+        .with_body(&bytes)","+        .expect(2)","+        .create_async()","+        .await;","+    let tmp = TempDir::new().unwrap();","+    let request = || {","+        Request::get(\"/npm/big/-/big-1.0.0.tgz\")","+            .body(Body::empty())","+            .unwrap()","+    };","+","+    let mut config = config_for(&upstream.url(), tmp.path().to_path_buf());","+    config.http.max_tarball_bytes = 4 * 1024;","+    let refused = router(config)","+        .oneshot(request())","+        .await","+        .unwrap();","+    assert_eq!(refused.status(), StatusCode::BAD_GATEWAY);","+    assert!(!public_cache_blob(tmp.path(), \"big\", \"big-1.0.0.tgz\").exists(), \"nothing is cached\");","+","+    let mut config = config_for(&upstream.url(), tmp.path().to_path_buf());","+    config.http.max_tarball_bytes = 16 * 1024;","+    let served = router(config)","+        .oneshot(request())","+        .await","+        .unwrap();","+    assert_eq!(served.status(), StatusCode::OK);","+    assert_eq!(body_bytes(served.into_body()).await, bytes);","+    tarball_mock.assert_async().await;","+}","+","+/// A cached upstream that declares no size is already streaming to the client","+/// when the tarball crosses `maxTarballSize`, so the cap can only cut the body","+/// off: the status is 200, reading the body fails, and nothing is cached.","+#[tokio::test]","+async fn cached_upstream_tarball_of_undeclared_size_is_cut_off_at_max_tarball_size() {","+    let mut upstream = mockito::Server::new_async().await;","+    let bytes = vec![0xAB_u8; 8 * 1024];","+    let _packument_mock = mock_packument_for_tarball(&mut upstream, \"big\", \"1.0.0\", &bytes).await;","+    let chunked = bytes.clone();","+    let tarball_mock = upstream","+        .mock(\"GET\", \"/big/-/big-1.0.0.tgz\")","+        .with_status(200)","+        .with_header(\"content-type\", \"application/octet-stream\")","+        .with_chunked_body(move |writer| writer.write_all(&chunked))","+        .expect(1)","+        .create_async()","+        .await;","+    let tmp = TempDir::new().unwrap();","+    let mut config = config_for(&upstream.url(), tmp.path().to_path_buf());","+    config.http.max_tarball_bytes = 4 * 1024;","+","+    let response = router(config)","+        .oneshot(","+            Request::get(\"/npm/big/-/big-1.0.0.tgz\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(response.status(), StatusCode::OK);","+    assert!(","+        axum::body::to_bytes(response.into_body(), usize::MAX).await.is_err(),","+        \"crossing the cap mid-stream must surface as a body error\",","+    );","+    tarball_mock.assert_async().await;","+    assert!(","+        await_no_tgz(&public_cache_blobs(tmp.path(), \"big\"), Duration::from_secs(1)).await,","+        \"the cut-off tarball is never cached\",","+    );","+}","+","+/// A `cache: false` upstream spools the tarball to a temporary file before it","+/// is served, so the same cap applies there.","+#[tokio::test]","+async fn uncached_upstream_tarball_over_max_tarball_size_is_refused() {","+    let mut upstream = mockito::Server::new_async().await;","+    let bytes = vec![0xCD_u8; 8 * 1024];","+    let _packument_mock = mock_packument_for_tarball(&mut upstream, \"big\", \"1.0.0\", &bytes).await;","+    let _mock = upstream","+        .mock(\"GET\", \"/big/-/big-1.0.0.tgz\")","+        .with_status(200)","+        .with_header(\"content-type\", \"application/octet-stream\")","+        .with_body(&bytes)","+        .create_async()","+        .await;","+    let tmp = TempDir::new().unwrap();","+    let mut config = config_for(&upstream.url(), tmp.path().to_path_buf());","+    config.routing.upstreams.get_mut(\"npmjs\").expect(\"default `npmjs` upstream\").cache = false;","+    config.http.max_tarball_bytes = 4 * 1024;","+","+    let refused = router(config)","+        .oneshot(","+            Request::get(\"/npm/big/-/big-1.0.0.tgz\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(refused.status(), StatusCode::BAD_GATEWAY);","+}"],"additions":119,"deletions":4,"truncated":false},{"path":"pnpr/docs/configuration.md","lines":["@@ -604,6 +604,35 @@ Can be specified as an integer number of seconds (e.g. `10`) or with a duration"," packumentTtl: 30s"," ```"," ","+## `maxTarballSize`","+","+The largest tarball pnpr fetches from an upstream registry. The same limit","+applies to Cargo crates and Python distributions fetched from an upstream. pnpr writes each","+proxied tarball to a temporary file while it verifies the integrity, so this","+bounds the disk each tarball can take. An upstream tarball that declares a size","+over the limit is refused with `502 Bad Gateway`. pnpm then fails the install","+with `ERR_PNPM_TARBALL_HTTP_STATUS`. When a cached upstream does not declare","+the size, pnpr is already streaming the tarball when it crosses the limit, so","+pnpr cuts the download off and the client reports a download error instead.","+pnpr verifies the tarball before it responds for an upstream with","+`cache: false` and for a [registry revision](https://pnpm.io/registry-revisions).","+There an over-limit tarball always gets `502 Bad Gateway`, whether the upstream","+declared the size or pnpr found it during the download.","+","+Defaults to `100MiB`. Takes an integer number of bytes or a size suffix such"],"additions":16,"deletions":0,"truncated":false}],"additions":358,"deletions":60,"truncated":true,"file_count":18},"error":null,"fetched_at":"2026-11-11T15:38:43.500222+00:00"}