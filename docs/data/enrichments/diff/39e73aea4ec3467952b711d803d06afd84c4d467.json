{"id":"39e73aea4ec3467952b711d803d06afd84c4d467","axis":"silent","repo":"pnpm/pnpm","sha":"39e73aea4ec3467952b711d803d06afd84c4d467","parsed":{"files":[{"path":".changeset/pnpr-max-tarball-size.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Added the `maxTarballSize` setting, the largest tarball pnpr fetches from an upstream registry. It takes a byte size such as `256MiB`. The default is `100MiB`, the limit pnpr applied before. A tarball that declares a size over the limit is refused with a 502 status."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/config.yaml","lines":["@@ -9,6 +9,9 @@ storage: ./storage"," #  maxSize: 20GB"," #  maxAge: 30d"," ","+# The largest tarball fetched from an upstream registry. Defaults to 100MiB.","+#maxTarballSize: 256MiB","+"," # Cross-origin browser access (disabled unless exact origins are listed)."," #cors:"," #  allowedOrigins:"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/byte_size.rs","lines":["@@ -77,7 +77,8 @@ pub fn parse_byte_size(raw: &str) -> Option<u64> {","         _ => return None,","     };","     let total = num * multiplier;","-    if total < 0.0 || total > (u64::MAX as f64) {","+    // `u64::MAX as f64` rounds up to 2^64, so a total equal to it overflows.","+    if total < 0.0 || total >= (u64::MAX as f64) {","         return None;","     }","     Some(total as u64)"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/config/src/byte_size/tests.rs","lines":["@@ -27,6 +27,14 @@ fn parse_byte_size_rejects_invalid_values() {","     assert_eq!(parse_byte_size(\"100xyz\"), None);"," }"," ","+#[test]","+fn parse_byte_size_rejects_sizes_that_overflow_u64() {","+    assert_eq!(parse_byte_size(\"18446744073709551615\"), Some(u64::MAX));","+    assert_eq!(parse_byte_size(\"18446744073709551616\"), None);","+    assert_eq!(parse_byte_size(\"16777216TiB\"), None);","+    assert_eq!(parse_byte_size(\"16384PiB\"), None);","+}","+"," #[test]"," fn byte_size_deserializes_from_yaml_types() {","     #[derive(serde::Deserialize)]"],"additions":8,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/config_file.rs","lines":["@@ -221,6 +221,10 @@ pub(super) struct ConfigFile {","     /// Duration before a cached packument is considered stale and refetched.","     #[serde(default)]","     pub(super) packument_ttl: Option<Interval>,","+    /// The largest tarball pnpr fetches from an upstream registry (e.g.","+    /// `100MiB`).","+    #[serde(default)]","+    pub(super) max_tarball_size: Option<ByteSize>,","     /// pnpr-only: how pnpr's own package document is served.","     #[serde(default)]","     pub(super) package_documents: Option<PackageDocumentsFile>,"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -220,6 +220,12 @@ pub struct HttpConfig {","     /// re-fetched from the resolved upstream. Ignored when no upstream","     /// matches.","     pub packument_ttl: Duration,","+    /// The largest tarball pnpr fetches from an upstream registry, in bytes.","+    /// pnpr spools each proxied tarball to disk while it verifies the","+    /// integrity, so this bounds the temporary disk each tarball takes. An","+    /// upstream tarball over it is refused. Sourced from the YAML","+    /// `maxTarballSize:` key; defaults to [`Self::DEFAULT_MAX_TARBALL_BYTES`].","+    pub max_tarball_bytes: u64,","     /// Reverse-proxy networks trusted to supply client IP headers.","     pub trusted_proxies: Vec<IpNetwork>,","     /// Which forwarding header to inspect when behind a trusted proxy.","@@ -236,6 +242,8 @@ pub struct HttpConfig {"," "," impl HttpConfig {","     pub const DEFAULT_REQUEST_TIMEOUT: Duration = Duration::from_mins(1);","+    /// 100 MiB, the size npm itself caps a published package at.","+    pub const DEFAULT_MAX_TARBALL_BYTES: u64 = 100 * 1024 * 1024;"," ","     /// The checks config loading applies to `metrics`, for a config built in","     /// code."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/loading.rs","lines":["@@ -293,19 +293,16 @@ fn build_http_config(","         }","         None => Some(super::HttpConfig::DEFAULT_REQUEST_TIMEOUT),","     };","+    let packument_ttl = build_packument_ttl(file.packument_ttl.take())?;","+    let max_tarball_bytes = build_max_tarball_bytes(file.max_tarball_size.take())?;","     Ok(super::HttpConfig {","         listen,","         public_url: public_url.unwrap_or_else(|| format!(\"http://{listen}\")),","         cors,","         ui,","         oci: std::mem::take(&mut file.oci),","-        packument_ttl: match &file.packument_ttl {","-            Some(interval) => super::parse_interval(&interval.0)","-                .ok_or_else(|| RegistryError::InvalidConfig {","-                    reason: format!(\"packumentTtl {:?} is not a valid interval\", interval.0),","-                })?,","-            None => Config::DEFAULT_PACKUMENT_TTL,","-        },","+        packument_ttl,","+        max_tarball_bytes,","         trusted_proxies,","         trusted_proxy_header,","         request_timeout,","@@ -314,6 +311,37 @@ fn build_http_config(","     })"," }"," ","+/// The `packumentTtl:` key as a duration, defaulting to","+/// [`Config::DEFAULT_PACKUMENT_TTL`].","+fn build_packument_ttl(raw: Option<super::Interval>) -> Result<std::time::Duration, RegistryError> {","+    let Some(super::Interval(raw)) = raw else {","+        return Ok(Config::DEFAULT_PACKUMENT_TTL);","+    };","+    super::parse_interval(&raw)","+        .ok_or_else(|| RegistryError::InvalidConfig {","+            reason: format!(\"packumentTtl {raw:?} is not a valid interval\"),","+        })","+}","+","+/// The `maxTarballSize:` key as bytes, defaulting to","+/// [`super::HttpConfig::DEFAULT_MAX_TARBALL_BYTES`]. Zero is refused: it would","+/// turn every upstream tarball away.","+fn build_max_tarball_bytes(raw: Option<super::ByteSize>) -> Result<u64, RegistryError> {","+    let Some(super::ByteSize(raw)) = raw else {","+        return Ok(super::HttpConfig::DEFAULT_MAX_TARBALL_BYTES);","+    };","+    let bytes = super::parse_byte_size(&raw)","+        .ok_or_else(|| RegistryError::InvalidConfig {","+            reason: format!(\"maxTarballSize {raw:?} is not a valid byte size\"),","+        })?;","+    if bytes == 0 {","+        return Err(RegistryError::InvalidConfig {","+            reason: \"maxTarballSize must be greater than zero\".to_string(),","+        });","+    }","+    Ok(bytes)","+}","+"," fn build_metrics_config(","     file: &mut ConfigFile,","     listen: SocketAddr,"],"additions":35,"deletions":7,"truncated":false},{"path":"pnpr/crates/config/src/tests/server_options.rs","lines":["@@ -411,6 +411,49 @@ fn request_timeout_defaults_and_overrides() {","     );"," }"," ","+#[test]","+fn packument_ttl_rejects_an_invalid_interval() {","+    let yaml = \"storage: ./s\\npackumentTtl: forever\\n\";","+    let err = Config::from_yaml_str(yaml, Path::new(\"/x\"), listen(), None).unwrap_err();","+    assert!(","+        matches!(err, RegistryError::InvalidConfig { ref reason } if reason.contains(\"packumentTtl\")),","+        \"expected InvalidConfig naming packumentTtl, got {err:?}\",","+    );","+}","+","+#[test]","+fn max_tarball_size_defaults_to_100_mib() {","+    let config = Config::from_yaml_str(\"storage: ./s\\n\", Path::new(\"/x\"), listen(), None).unwrap();","+    assert_eq!(config.http.max_tarball_bytes, crate::HttpConfig::DEFAULT_MAX_TARBALL_BYTES);","+    assert_eq!(config.http.max_tarball_bytes, 100 * 1024 * 1024);","+}","+","+#[test]","+fn max_tarball_size_accepts_a_byte_size_or_a_byte_count() {","+    let sized = \"storage: ./s\\nmaxTarballSize: 512MiB\\n\";","+    let config = Config::from_yaml_str(sized, Path::new(\"/x\"), listen(), None).unwrap();","+    assert_eq!(config.http.max_tarball_bytes, 512 * 1024 * 1024);","+","+    let counted = \"storage: ./s\\nmaxTarballSize: 120000000\\n\";","+    let config = Config::from_yaml_str(counted, Path::new(\"/x\"), listen(), None).unwrap();","+    assert_eq!(config.http.max_tarball_bytes, 120_000_000);","+}","+","+#[test]","+fn max_tarball_size_rejects_an_invalid_size_and_zero() {","+    for yaml in [","+        \"storage: ./s\\nmaxTarballSize: huge\\n\",","+        \"storage: ./s\\nmaxTarballSize: 0\\n\",","+        \"storage: ./s\\nmaxTarballSize: \\\"18446744073709551616\\\"\\n\",","+    ] {","+        let err = Config::from_yaml_str(yaml, Path::new(\"/x\"), listen(), None).unwrap_err();","+        assert!(","+            matches!(err, RegistryError::InvalidConfig { ref reason } if reason.contains(\"maxTarballSize\")),","+            \"expected InvalidConfig naming maxTarballSize for {yaml:?}, got {err:?}\",","+        );","+    }","+}","+"," #[test]"," fn package_documents_default_to_a_64_kib_threshold_and_a_30_day_window() {","     let config = Config::from_yaml_str(\"\", Path::new(\"/config\"), listen(), None).unwrap();"],"additions":43,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr-fixtures/src/presets.rs","lines":["@@ -187,6 +187,7 @@ fn http_config(listen: SocketAddr) -> pnpr_config::HttpConfig {","         ui: UiConfig::default(),","         oci: OciConfig::default(),","         packument_ttl: Config::DEFAULT_PACKUMENT_TTL,","+        max_tarball_bytes: pnpr_config::HttpConfig::DEFAULT_MAX_TARBALL_BYTES,","         trusted_proxies: Vec::new(),","         trusted_proxy_header: TrustedProxyHeader::default(),","         request_timeout: Some(pnpr_config::HttpConfig::DEFAULT_REQUEST_TIMEOUT),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -218,17 +218,14 @@ const ABBREVIATED_CONTENT_TYPE: &str = \"application/vnd.npm.install-v1+json\";"," /// sends it."," const GENERATION_HEADER: &str = \"pnpr-generation\";"," ","-/// Cap tarballs at 100 MiB while pnpr has to spool them to disk for SRI","-/// verification. This bounds per-request tem