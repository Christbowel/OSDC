{"id":"35d6bb6f613b539f88d60ba0fd90afcd8496db81","axis":"silent","repo":"pnpm/pnpm","sha":"35d6bb6f613b539f88d60ba0fd90afcd8496db81","parsed":{"files":[{"path":".changeset/version-selector-overrides-catalog.md","lines":["@@ -0,0 +1,10 @@","+---","+\"@pnpm/deps.inspection.outdated\": patch","+\"@pnpm/deps.status\": patch","+\"@pnpm/hooks.read-package-hook\": patch","+\"@pnpm/installing.deps-installer\": patch","+\"pacquet\": patch","+\"pnpm\": patch","+---","+","+Version-selector `overrides` entries such as `\"ms@^2.0.0\": \"2.1.1\"` now apply to dependencies declared with the `catalog:` protocol when the catalog entry's range matches the selector [#17922](https://github.com/pnpm/pnpm/issues/17922)."],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -2765,6 +2765,8 @@ snapshots:"," \t\t\"pnpm11/hooks/read-package-hook\": {"," \t\t\t\"name\": \"@pnpm/hooks.read-package-hook\","," \t\t\t\"dependencies\": {","+\t\t\t\t\"@pnpm/catalogs.resolver\": \"workspace:*\",","+\t\t\t\t\"@pnpm/catalogs.types\": \"workspace:*\","," \t\t\t\t\"@pnpm/config.matcher\": \"workspace:*\","," \t\t\t\t\"@pnpm/config.parse-overrides\": \"workspace:*\","," \t\t\t\t\"@pnpm/deps.peer-range\": \"workspace:*\","],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/outdated/query.rs","lines":["@@ -93,7 +93,9 @@ impl OutdatedRun {","         // override resolves against does not matter here.","         let project_dir = project_dir(manifest);","         let mut overridden = manifest.clone();","-        VersionsOverrider::new(&overrides, project_dir).apply(&mut overridden, Some(project_dir));","+        VersionsOverrider::new(&overrides, project_dir)","+            .with_catalogs(&self.catalogs)","+            .apply(&mut overridden, Some(project_dir));","         Ok(Cow::Owned(overridden))","     }"," "],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/hooks.rs","lines":["@@ -194,6 +194,45 @@ fn update_config_catalog_applies_to_outdated() {","     drop((root, mock_instance));"," }"," ","+#[test]","+fn update_config_version_selector_override_applies_to_catalog_dependency() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"name\": \"catalog-hook-override-project\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { (CATALOG_DEP): \"catalog:\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        format!(","+            \"module.exports = {{ hooks: {{ updateConfig (config) {{ config.catalogs = {{ default: {{ '{CATALOG_DEP}': '^100.0.0' }} }}; config.overrides = {{ ...config.overrides, '{CATALOG_DEP}@^100.0.0': '100.0.0' }}; return config }} }} }}\",","+        ),","+    )","+    .expect(\"write pnpmfile\");","+","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let wanted = pnpm_lockfile::Lockfile::load_wanted_from_dir(&workspace)","+        .expect(\"load wanted lockfile\")","+        .expect(\"wanted lockfile\");","+    let dep_name = CATALOG_DEP.parse().expect(\"package name\");","+    let dependency = &wanted.importers[\".\"].dependencies.as_ref().expect(\"dependencies\")[&dep_name];","+    assert_eq!(dependency.specifier, \"100.0.0\");","+    assert_eq!(dependency.version.to_string(), \"100.0.0\");","+","+    drop((root, mock_instance));","+}","+"," /// The workspace shape of pnpm/pnpm#15047: `b` depends on workspace"," /// package `a`, whose `peerDependencies` use a catalog only the"," /// `updateConfig` hook provides. `peers check` resolves that catalog when"],"additions":39,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/lockfile_resolution_reuse/overrides.rs","lines":["@@ -739,3 +739,107 @@ fn an_override_on_a_cataloged_package_keeps_the_lockfile_reusable() {","         \"catalog:\\n  '@pnpm.e2e/bar': 100.0.0\\noverrides:\\n  '@pnpm.e2e/bar': 100.0.0\\n\",","     );"," }","+","+#[test]","+fn a_version_selector_override_applies_to_a_catalog_dependency() {","+    let fixture = CommandTempCwd::init().add_mocked_registry();","+    let manifest_path = fixture.workspace.join(\"package.json\");","+    let workspace_yaml_path = fixture.workspace.join(\"pnpm-workspace.yaml\");","+    fs::write(","+        &manifest_path,","+        serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": {","+                \"@pnpm.e2e/foo\": \"catalog:\",","+                \"@pnpm.e2e/bar\": \"catalog:legacy\"","+            }","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    let workspace_yaml =","+        fs::read_to_string(&workspace_yaml_path).expect(\"read pnpm-workspace.yaml\");","+    fs::write(","+        &workspace_yaml_path,","+        format!(","+            \"{workspace_yaml}catalog:\\n  '@pnpm.e2e/foo': ^100.0.0\\ncatalogs:\\n  legacy:\\n    '@pnpm.e2e/bar': ^100.0.0\\noverrides:\\n  '@pnpm.e2e/foo@^100.0.0': 100.0.0\\n  '@pnpm.e2e/bar@^200.0.0': 100.0.0\\n\",","+        ),","+    )","+    .expect(\"write catalog and version-selector overrides\");","+    pacquet_at(&fixture.workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let wanted = pnpm_lockfile::Lockfile::load_wanted_from_dir(&fixture.workspace)","+        .expect(\"load wanted lockfile\")","+        .expect(\"wanted lockfile\");","+    let foo_name = \"@pnpm.e2e/foo\".parse().expect(\"foo package name\");","+    let bar_name = \"@pnpm.e2e/bar\".parse().expect(\"bar package name\");","+    let dependencies = wanted.importers[\".\"].dependencies.as_ref().expect(\"dependencies\");","+    assert_eq!(dependencies[&foo_name].specifier, \"100.0.0\");","+    assert_eq!(dependencies[&foo_name].version.to_string(), \"100.0.0\");","+    assert_eq!(dependencies[&bar_name].specifier, \"catalog:legacy\");","+    assert_eq!(dependencies[&bar_name].version.to_string(), \"100.1.0\");","+","+    // Frozen lockfile and update both respect the version-selector override on","+    // the catalog dependency while preserving `catalog:` in package.json.","+    pacquet_at(&fixture.workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+    pacquet_at(&fixture.workspace)","+        .with_arg(\"update\")","+        .assert()","+        .success();","+    let updated_manifest: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&manifest_path).expect(\"read package.json\"))","+            .expect(\"parse package.json\");","+    assert_eq!(updated_manifest[\"dependencies\"][\"@pnpm.e2e/foo\"], \"catalog:\");","+    assert_eq!(updated_manifest[\"dependencies\"][\"@pnpm.e2e/bar\"], \"catalog:legacy\");","+","+    // When `pnpm update --latest` bumps a catalog entry into a range matched by a","+    // version-selector override, the override applies immediately and a subsequent","+    // frozen-lockfile install succeeds.","+    fs::write(","+        &workspace_yaml_path,","+        format!(","+            \"{workspace_yaml}catalog:\\n  '@pnpm.e2e/foo': ^100.0.0\\ncatalogs:\\n  legacy:\\n    '@pnpm.e2e/bar': 100.0.0\\noverrides:\\n  '@pnpm.e2e/foo@^100.0.0': 100.0.0\\n  '@pnpm.e2e/bar@^100.1.0': 100.0.0\\n\",","+        ),","+    )","+    .expect(\"write catalog before latest update\");","+    pacquet_at(&fixture.workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let wanted_before_latest = pnpm_lockfile::Lockfile::load_wanted_from_dir(&fixture.workspace)","+        .expect(\"load wanted lockfile\")","+        .expect(\"wanted lockfile\");","+    let deps_before_latest =","+        wanted_before_latest.importers[\".\"].dependencies.as_ref().expect(\"dependencies\");","+    assert_eq!(deps_before_latest[&bar_name].specifier, \"catalog:legacy\");","+    assert_eq!(deps_before_latest[&bar_name].version.to_string(), \"100.0.0\");","+    pacquet_at(&fixture.workspace)","+        .with_args([\"update\", \"--latest\", \"@pnpm.e2e/bar\"])","+        .assert()","+        .success();","+    let updated_workspace = pnpm_workspace::read_workspace_manifest(&fixture.workspace)","+        .expect(\"read workspace manifest\")","+        .expect(\"workspace manifest\");","+    let catalogs = updated_workspace.catalogs.expect(\"named catalogs\");","+    assert_eq!(catalogs[\"legacy\"][\"@pnpm.e2e/bar\"], \"100.1.0\");","+    let wanted_after_latest = pnpm_lockfile::Lockfile::load_wanted_from_dir(&fixture.workspace)","+        .expect(\"load wanted lockfile\")","+        .expect(\"wanted lockfile\");","+    let deps_after_latest =","+        wanted_after_latest.importers[\".\"].dependencies.as_ref().expect(\"dependencies\");","+    assert_eq!(deps_after_latest[&bar_name].specifier, \"100.0.0\");","+    assert_eq!(deps_after_latest[&bar_name].version.to_string(), \"100.0.0\");","+    pacquet_at(&fixture.workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+","+    drop(fixture);","+}"],"additions":104,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/range_fallback.rs","lines":["@@ -108,7 +108,8 @@ fn override_specifier(","     let overrider = crate::overrides::VersionsOverrider::new(","         &parsed,","         inputs.add.config.root_project_manifest_dir(&lockfile_root),","-    );","+    )","+    .with_catalogs(inputs.catalogs);","     Ok(overridden_specifier(package_name, project_dir, &overrider, inputs, manifest))"," }"," "],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/pack