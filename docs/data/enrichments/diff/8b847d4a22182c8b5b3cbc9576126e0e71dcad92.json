tokens, which a preemption resets to zero","+    and an admitted remote load sets before the KV arrives. The other requests,","+    streaming sessions that wait for more input included, count as queued","+    prefill work with all their tokens. This is a queue category, not an","+    execution phase: a resumed request may have to recompute its prefill.","+    \"\"\"","+","+    num_prefill_requests: int = 0","+    sum_prefill_tokens: int = 0","+    var_prefill_length: float = 0.0","+    num_decode_requests: int = 0","+    sum_decode_kv_tokens: int = 0","+    var_decode_kv_tokens: float = 0.0","+","+","+def _variance(count: int, total: int, total_squares: int) -> float:","+    \"\"\"Population variance, exact up to the final division.\"\"\"","+    if not count:","+        return 0.0","+    return (count * total_squares - total * total) / (count * count)","+","+","+def _variance_of(lengths: list[int]) -> float:","+    return _variance(len(lengths), sum(lengths), sum(x * x for x in lengths))","+","+","+def make_scheduled_workload(","+    new_requests: Iterable[\"Request\"],","+    running_requests: Iterable[\"Request\"],","+    num_scheduled_tokens: Mapping[str, int],","+) -> ScheduledWorkload:","+    \"\"\"Summarize the scheduled requests before their computed tokens advance.","+","+    Prefill and decode requests are told apart as in `IterationDetails`.","+    \"\"\"","+    prefill_kv_tokens = 0","+    # Twice the prefill length, to keep half tokens exact.","+    prefill_lengths: list[int] = []","+    decode_lengths: list[int] = []","+    for requests, is_new in ((new_requests, True), (running_requests, False)):","+        for request in requests:","+            kv_tokens = request.num_computed_tokens","+            if is_new or request.is_prefill_chunk:","+                prefill_kv_tokens += kv_tokens","+                prefill_lengths.append(","+                    2 * kv_tokens + num_scheduled_tokens[request.request_id]"],"additions":87,"deletions":0,"truncated":f