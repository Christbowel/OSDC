th":"tests/v1/metrics/test_stats.py","lines":["@@ -6,6 +6,10 @@"," from vllm.config import SpeculativeConfig"," from vllm.v1.engine import EngineCoreOutput, EngineCoreOutputs, FinishReason"," from vllm.v1.metrics.cache_hit_source import CacheHitSource","+from vllm.v1.metrics.iteration_workload import (","+    QueuedWorkload,","+    ScheduledWorkload,","+)"," from vllm.v1.metrics.stats import (","     IterationStats,","     LoRARequestStates,","@@ -99,11 +103,16 @@ def test_scheduler_iteration_details_serialization():","         elapsed_ms=6.7,","         num_encoder_inputs=2,","         num_encoder_output_tokens=392,","+        scheduled_workload=ScheduledWorkload(","+            sum_decode_kv_tokens=9, var_decode_kv_tokens=0.5","+        ),","     )","+    queued_workload = QueuedWorkload(num_prefill_requests=1, sum_prefill_tokens=7)","     outputs = EngineCoreOutputs(","         scheduler_stats=SchedulerStats(","             kv_cache_usage=0.5,","             iteration_records=[iteration_details],","+            queued_workload=queued_workload,","         )","     )"," ","@@ -113,6 +122,7 @@ def test_scheduler_iteration_details_serialization():","     assert decoded.scheduler_stats is not None","     assert decoded.scheduler_stats.kv_cache_usage == 0.5","     assert decoded.scheduler_stats.iteration_records == [iteration_details]","+    assert decoded.scheduler_stats.queued_workload == queued_workload"," "," "," def test_prefix_cache_stats_hits_by_source_accumulate():"],"additions":10,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_iteration_timing.py","lines":["@@ -12,6 +12,7 @@"," from vllm.v1.core.sched.output import IterationDetails"," from vllm.v1.executor.multiproc_executor import MultiprocExecutor"," from vllm.v1.metrics import loggers","+from vllm.v1.metrics.iteration_workload import ScheduledWorkload"," from vllm.v1.metrics.stats import SchedulerStats"," from vllm.v1.outputs import AsyncModelRunnerOutput, ModelRunnerOutput"," from vllm.v1.worker.iteration_timing import (","@@ -120,6 +121,20 @@ def test_record_rides_a_later_output_once_its_gpu_work_completes(gpu):","     assert first.elapsed_ms == 4.0 and not first.is_dummy"," "," ","+def test_record_carries_the_scheduled_workload(gpu):","+    worker = FakeWorker()","+    workload = ScheduledWorkload(sum_decode_kv_tokens=7)","+    details = IterationDetails(num_decode_tokens=1, scheduled_workload=workload)","+","+    worker.execute_model(SimpleNamespace(iteration_details=details))","+    worker.sample_tokens()","+    worker.execute_dummy_batch()","+    step, dummy = worker.completed()","+","+    assert step.scheduled_workload is workload","+    assert dummy.is_dummy and dummy.scheduled_workload is None","+","+"," def test_dummy_batches_are_timed_and_return_earlier_records(gpu):","     worker = FakeWorker()"," "],"additions":15,"deletions":0,"truncated":false},{"path":"vllm/config/observability.py","lines":["@@ -103,7 +103,17 @@ def show_hidden_metrics(self) -> bool:","     If set, vllm EngineCore will log iteration details","     This includes number of context/generation requests and tokens","     and, where the output worker measures it with CUDA events, the","-    elapsed GPU time for the iteration.\"\"\"","+    elapsed GPU time for the iteration.","+","+    Stat loggers also receive two workload summaries, which are not printed","+    in the log; read them in a custom stat logger. Each iteration record has","+    `scheduled_workload`, a summary of the KV context lengths of the requests","+    that iteration scheduled, and `SchedulerStats` has `queued_workload`, a","+    summary of the requests that are still waiting.","+","+    With `--api-server-count` above 1, the engine sends the stats of each","+    step to only one of the API servers, so the stat loggers of any one","+    server receive only part of the iterations.\"\"\""," ","     jit_monitor_mode: Literal[\"warn\", \"error\"] = \"warn\"","     \"\"\"How to handle post-warmup JIT compilation events.\"\"\""],"additions":11,"deletions":1,"truncated":false},{"path":"vllm/v1/core/sched/output.py","lines":["@@ -8,6 +8,7 @@"," "," from vllm.multimodal.utils import strip_covered_mm_data"," from vllm.utils.gc_utils import untrack_long_lists","+from vllm.v1.metrics.iteration_workload import ScheduledWorkload"," "," if TYPE_CHECKING:","     import numpy as np","@@ -201,6 +202,8 @@ class IterationDetails:","     num_decode_tokens: int = 0","     num_encoder_inputs: int = 0","     num_encoder_output_tokens: int = 0","+    # Only with --enable-logging-iteration-details.","+    scheduled_workload: ScheduledWorkload | None = None"," ","     # Temporary aliases for existing EngineCore and worker profiler consumers.","     @property"],"additions":3,"deletions":0,"truncated":false},{"path":"vllm/v1/core/sched/request_queue.py","lines":["@@ -7,6 +7,7 @@"," from collections.abc import Iterable, Iterator"," from enum import Enum"," ","+from vllm.v1.metrics.iteration_workload import QueuedWorkloadTally"," from vllm.v1.request import Request"," "," ","@@ -197,11 +198,67 @@ def __iter__(self) -> Iterator[Request]:","             yield heapq.heappop(heap_copy)"," "," ","-def create_request_queue(policy: SchedulingPolicy) -> RequestQueue:","-    \"\"\"Create request queue based on scheduling policy.\"\"\"","+class TalliedRequestQueue(RequestQueue):","+    \"\"\"A queue that reports the requests entering and leaving it to a tally.\"\"\"","+","+    def __init__(self, queue: RequestQueue, tally: QueuedWorkloadTally) -> None:","+        self._queue = queue","+        self._tally = tally","+","+    def add_request(self, request: Request) -> None:","+        self._queue.add_request(request)","+        self._tally.add(self, request)","+","+    def pop_request(self) -> Request:","+        request = self._queue.pop_request()","+        self._tally.discard(self, request)","+        return request","+","+    def peek_request(self) -> Request:","+        return self._queue.peek_request()","+","+    def prepend_request(self, request: Request) -> None:","+        self._queue.prepend_request(request)","+        self._tally.add(self, request)","+","+    def prepend_requests(self, requests: Iterable[Request]) -> None:","+        requests = list(requests)","+        self._queue.prepend_requests(requests)","+        for request in requests:","+            self._tally.add(self, request)","+","+    def remove_request(self, request: Request) -> None:","+        self._queue.remove_request(request)","+        self._tally.discard(self, request)","+","+    def remove_requests(self, requests: Iterable[Request]) -> None:","+        requests = set(requests)","+        self._queue.remove_requests(requests)","+        for request in requests:","+            self._tally.discard(self, request)","+","+    def __bool__(self) -> bool:","+        return bool(self._queue)","+","+    def __len__(self) -> int:","+        return len(self._queue)","+","+    def __iter__(self) -> Iterator[Request]:","+        return iter(self._queue)","+","+","+def create_request_queue(","+    policy: SchedulingPolicy, tally: QueuedWorkloadTally | None = None","+) -> RequestQueue:","+    \"\"\"Create request queue based on scheduling policy.","+","+    With a tally, the queue reports the requests entering and leaving it.","+    \"\"\"","+    queue: RequestQueue","     if policy == SchedulingPolicy.PRIORITY:","-        return PriorityRequestQueue()","+        queue = PriorityRequestQueue()","     elif policy == SchedulingPolicy.FCFS:","-        return FCFSRequestQueue()","+        queue = FCFSRequestQueue()","     else:","         raise ValueError(f\"Unknown scheduling policy: {policy}\")","+    return queue if tally is None else TalliedRequestQueue(queue, tally)"],"additions":61,"deletions":4,"truncated":false},{"path":"vllm/v1/core/sched/scheduler.py","lines":["@@ -72,6 +72,10 @@","     get_reusable_prefix_length,","     is_mamba_prefill_checkpoint_valid,"," )","+from vllm.v1.metrics.iteration_wor