       if (certSet != null)","+                    {","+                        foreach (CertificateChoiceAsn cert in certSet)","+                        {","+                            if (cert.Certificate is not null)","+                            {","+                                newColl.Add(X509CertificateLoader.LoadCertificate(cert.Certificate.Value.Span));","+                            }","+                        }","+                    }","+","+                    _coll = newColl;","+                    _arr = certSet;","+                }","+","+                return _coll;","+            }","+","+            internal X509Certificate2? FindCertificate(SubjectIdentifier signerIdentifier)","+            {","+                const int LinearSearchThreshold = 10;","+","+                X509Certificate2Collection coll = GetCollection();","+","+                if (coll.Count > LinearSearchThreshold)","+                {","+                    if (signerIdentifier.Type == SubjectIdentifierType.SubjectKeyIdentifier)","+                    {","+                        if (_skiLookup is null)","+                        {","+                            _skiLookup = new Dictionary<string, X509Certificate2>(coll.Count, StringComparer.Ordinal);","+","+                            foreach (X509Certificate2 item in coll)","+                            {","+                                string ski = PkcsPal.Instance.GetSubjectKeyIdentifier(item).ToSkiString();","+","+                                // The first certificate in the collection with the same SKI wins,","+                                // since the linear method returns the first match.","+#if NET","+                                _ = _skiLookup.TryAdd(ski, item);","+#else","+                                try","+                                {","+                                    _skiLookup.Add(ski, item);","+                                }","+                                catch (ArgumentException)","+                                {","+                                }","+#endif","+                            }","+                        }","+","+                        string key = (string)signerIdentifier.Value!;","+                        key = key.ToUpperInvariant();","+","+                        Debug.Assert(signerIdentifier.Value is not null);","+                        _ = _skiLookup.TryGetValue(key, out X509Certificate2? cert);","+                        return CloneCert(cert);","+                    }","+                    else if (signerIdentifier.Type == SubjectIdentifierType.IssuerAndSerialNumber)","+                    {","+                        if (_issuerSerialLookup is null)","+                        {","+                            _issuerSerialLookup = new Dictionary<string, X509Certificate2>(coll.Count, StringComparer.Ordinal);","+","+                            foreach (X509Certificate2 item in coll)","+                            {","+                                // Serial number is a hexadecimal string, so it cannot contain a pipe character.","+                                // Therefore, the separator cannot be caller-influenced.","+                                string itemKey = $\"{item.SerialNumber}||{item.IssuerName.Name}\";","+","+                                // The first certificate in the collection with the same issuer/serial wins.","+#if NET","+                                _ = _issuerSerialLookup.TryAdd(itemKey, item);","+#else","+                                try","+                                {","+                                    _issuerSerialLookup.Add(itemKey, item);","+                                }","+                                catch (ArgumentException)","+                                {","+                                }","+#endif","+                            }","+                        }","+","+                        var issuerSerial = (Xml.X509IssuerSerial)signerIdentifier.Value!;","+                        string key = $\"{issuerSerial.SerialNumber.ToUpperInvariant()}||{issuerSerial.IssuerName}\";","+","+                        _ = _issuerSerialLookup.TryGetValue(key, out X509Certificate2? cert);","+                        return CloneCert(cert);","+                    }","+                    else if (signerIdentifier.Type == SubjectIdentifierType.NoSignature)","+                    {","+                        return null;","+                    }","+                    else","+                    {","+                        // Fail in debug, but at runtime fall back to the other function.","+                        Debug.Fail($\"Missing handler for SubjectIdentifierType {signerIdentifier.Type}\");","+                    }","+                }","+","+                return SignerInfo.FindSignerCertificate(signerIdentifier, coll);","+","+                static X509Certificate2? CloneCert(X509Certificate2? cert)","+                {","+                    if (cert is null)","+                    {","+                        return null;","+                    }","+","+                    return X509CertificateLoader.LoadCertificate(","+#if NET","+                        cert.RawDataMemory.Span","+#else","+                        cert.RawData","+#endif","+                    );","+                }","+            }","+        }","     }"," }"],"additions":173,"deletions":13,"truncated":false},{"path":"src/libraries/System.Security.Cryptography.Pkcs/src/System/Security/Cryptography/Pkcs/SignerInfo.cs","lines":["@@ -501,10 +501,10 @@ private bool CheckHash(bool compatMode)"," ","         private X509Certificate2? FindSignerCertificate()","         {","-            return FindSignerCertificate(SignerIdentifier, _document.Certificates);","+            return _document.FindCertificate(SignerIdentifier);","         }"," ","-        private static X509Certificate2? FindSignerCertificate(","+        internal static X509Certificate2? FindSignerCertificate(","             SubjectIdentifier signerIdentifier,","             X509Certificate2Collection? extraStore)","         {"],"additions":2,"deletions":2,"truncated":false},{"path":"src/libraries/System.Security.Cryptography.Pkcs/tests/SignedCms/SignedCmsTests.cs","lines":["@@ -1741,6 +1741,159 @@ public static void Decode_CanDecodeWithAttributeCertificate()","             cms.CheckSignature(verifySignatureOnly: true);","         }"," ","+        [Fact]","+        public static void LargeSignerCountSanityTest()","+        {","+            // Ignoring the fact that they long preceded computers, pretend the 1789 U.S. Electoral College","+            // signed their vote tallies with CMS.","+            //","+            // Build that, and make sure the document works at scale.","+","+            const int ElectorsCount = 69;","+            X509Certificate2 root = null;","+            X509Certificate2 issuer = null;","+            X509Certificate2 lastSigner = null;","+            string dateSuffix = $\"{DateTime.UtcNow:yyyy-MM-dd HH:mm:ss.ffff}\";","+","+            ContentInfo content = new ContentInfo(","+                Text.Encoding.ASCII.GetBytes(@\"","+President:","+George Washington (69)","+","+Vice President:","+John Adams (34)","+","+No Office:","+John Jay (9)","+Robert H. Harrison (6)","+John Rutledge (6)","+John Hancock (4)","+George Clinton (3)","+Samuel Huntington (2)","+John Milton (2)","+James Armstrong (1)","+Benjamin Lincoln (1)","+Edward Telfair (1)","+\"));","+","+            byte[] encoded;","+","+            try","+            {","+                SignedCms builder = new SignedCms(content, detached: false);","+","+                root = MakeRoot(dateSuffix);","+                issuer = MakeChild(\"Elector Issuing Authority\", root, dateSuffix, isCA: true);","+","+                for (int i = 0; i < ElectorsCount; i++)","+                {","+                    lastSigner?.Dispose();","+                    lastSigner = MakeChild($\"Elector {i + 1} of {ElectorsCount}\", issuer, dateSuffix);","+","+                    // Alternate between IssuerAndSerialNumber and SubjectKeyIdentifier to make sure both work.","+                    SubjectIdentifierType type = (SubjectIdentifierType)(1 + i & 1);","+                    CmsSigner signer = new CmsSigner(type, lastSigner)","+                    {","+                        IncludeOption = X509IncludeOption.EndCertOnly,","+                    };","+","+                    if (i == 0)","+                    {","+                        signer.Certificates.Add(issuer);","+                        signer.Certificates.Add(root);","+                    }","+","+                    builder.ComputeSignature(signer, silent: true);","+                }","+","+                encoded = builder.Encode();","+            }","+            finally","+            {","+                lastSigner?.Dispose();","+                issuer?.Dispose();","+                root?.Dispose();","+            }","+","+            SignedCms verifier = new SignedCms();","+            verifier.Decode(encoded);","+","+            AssertExtensions.Equal(ElectorsCount + 2, verifier.Certificates.Count);","+","+            foreach (SignerInfo signerInfo in verifier.SignerInfos)","+            {","+                Assert.NotNull(signerInfo.Certificate);","+","+                // Assert.NoThrow","+                signerInfo.CheckSignature(verifySignatureOnly: true);","+            }","+","+            // Assert.NoThrow","+            verifier.CheckSignature(verifySignatureOnly: true);","+","+            static X509Certificate2 MakeRoot(string dateSuffix)","+            {","+                using (ECDsa key = ECDsa.Create(ECCurve.NamedCurves.nistP521))","+                {","+                    CertificateRequest req = new CertificateRequest(","+                        $\"CN=Elector Root Authority {dateSuffix}, O=Mythical Elector Attestation\",","+                        key,","+                        HashAlgorithmName.SHA512);","+","+                    req.CertificateExtensions.Add(new X509BasicConstraintsExtension(true, false, 0, true));","+                    req.CertificateExtensions.Add(","+                        new X509SubjectKeyIdentifierExtension(req.PublicKey, false));","+                    DateTimeOffset now = DateTimeOffset.UtcNow;","+                    return req.CreateSelfSigned(now.AddMinutes(-3), now.AddMinutes(120));","+                }","+            }","+","+            static X509Certificate2 MakeChild(string cn, X509Certificate2 issuer, string dateSuffix, bool isCA = false)","+            {","+                ECCurve curve = isCA ? ECCurve.NamedCurves.nistP384 : ECCurve.NamedCurves.nistP256;","+","+                using (ECDsa key = ECDsa.Create(curve))","+                {","+                    CertificateRequest req = new CertificateRequest(","+                        $\"CN={cn} {dateSuffix}, O=Mythical Elector Attestation\",","+                        key,","+                        HashAlgorithmName.SHA512);"],"additions":117,"deletions":0,"truncated":false}],"additions":476,"deletions":29,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-15T13:23:24.337016+00:00"}