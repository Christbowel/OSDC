ol","+","+  private var stack: StackConfiguration {","+    StackConfiguration(","+      axis: .vertical,","+      alignment: alignment.stackAlignment,","+      spacing: spacing,","+      ownDimensions: ownDimensions,","+      resolvesOwnPercentage: resolvesOwnPercentage","+    )","+  }","+","+  func makeCache(subviews: Subviews) -> StackLayoutCache {","+    StackLayoutCache()","+  }","+","+  func updateCache(_ cache: inout StackLayoutCache, subviews: Subviews) {","+    cache.reset()","+  }","+","+  func sizeThatFits(proposal: ProposedViewSize, subviews: Subviews, cache: inout StackLayoutCache) -> CGSize {","+    stack.measurement(for: proposal, subviews: subviews, cache: &cache).size","+  }","+","+  func placeSubviews(in bounds: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout StackLayoutCache) {","+    stack.place(in: bounds, proposal: proposal, subviews: subviews, cache: &cache)","+  }","+}","+","+/**","+ Measurements by proposal.","+ SwiftUI asks for several sizes and then places with one of them, so placement reuses that measurement.","+ SwiftUI resets the cache when the subviews change.","+ */","+internal struct StackLayoutCache {","+  fileprivate var measurements: [StackMeasurementKey: StackMeasurement] = [:]","+","+  fileprivate mutating func reset() {","+    measurements.removeAll(keepingCapacity: true)","+  }","+}","+","+private struct StackMeasurementKey: Hashable {","+  let width: CGFloat?","+  let height: CGFloat?","+  let spacing: CGFloat?","+  let ownDimensions: UniversalLayoutDimensions","+  let resolvesOwnPercentage: Bool","+}","+","+private struct StackAlignment {","+  enum Fill {","+    case start","+    case center","+    case end","+  }","+","+  /// The guide every child lines up on.","+  let guide: (ViewDimensions) -> CGFloat","+  /// Where the aligned children sit when the stack is larger than they are.","+  let fill: Fill","+","+  func offset(container: CGFloat, content: CGFloat) -> CGFloat {","+    switch fill {","+    case .start:","+      return 0","+    case .center:","+      return (container - content) / 2","+    case .end:","+      return container - content","+    }","+  }","+}","+","+extension VerticalAlignmentOptions {","+  fileprivate var stackAlignment: StackAlignment {","+    let guide = toVerticalAlignment()","+    let fill: StackAlignment.Fill","+    switch self {","+    case .top, .firstTextBaseline, .lastTextBaseline:","+      fill = .start","+    case .center:","+      fill = .center","+    case .bottom:","+      fill = .end","+    }","+    return StackAlignment(guide: { $0[guide] }, fill: fill)","+  }","+}","+","+extension HorizontalAlignmentOptions {","+  fileprivate var stackAlignment: StackAlignment {","+    let guide = toHorizontalAlignment()","+    let fill: StackAlignment.Fill","+    switch self {","+    case .leading:","+      fill = .start","+    case .center:","+      fill = .center","+    case .trailing:","+      fill = .end","+    }","+    return StackAlignment(guide: { $0[guide] }, fill: fill)","+  }","+}","+","+private struct StackMeasurement {","+  let size: CGSize","+  let sizes: [CGSize]","+  let proposals: [ProposedViewSize]","+  let spacings: [CGFloat]","+  /// Cross-axis offset of each child inside the aligned content.","+  let crossOffsets: [CGFloat]","+  let contentCross: CGFloat","+}","+","+private struct MeasuredChild {","+  var size: CGSize","+  var proposal: ProposedViewSize","+  /// Cross-axis proposal from the first pass.","+  /// The flexible pass must keep it, or a `ScrollView` in a column loses the column width.","+  var crossProposal: CGFloat?","+  /// Grows past its ideal size on the main axis, so it shares the leftover space.","+  var flexible: Bool","+  /// False for a resolved percentage or a flexible child.","+  var canCompress: Bool","+  var priority: Double","+  var maxMain: CGFloat","+}","+","+private struct MeasuredChildren {","+  var children: [MeasuredChild]","+  var contentMain: CGFloat","+  var definiteMain: CGFloat?","+  var definiteCross: CGFloat?","+}","+","+private struct CompressionCandidate {","+  let index: Int","+  let idealMain: CGFloat","+  let minMain: CGFloat","+  let priority: Double","+","+  var slack: CGFloat { idealMain - minMain }","+}","+","+private struct StackConfiguration {","+  let axis: Axis","+  let alignment: StackAlignment","+  let spacing: CGFloat?","+  let ownDimensions: UniversalLayoutDimensions","+  let resolvesOwnPercentage: Bool","+","+  func measurement(","+    for proposal: ProposedViewSize,","+    subviews: LayoutSubviews,","+    cache: inout StackLayoutCache","+  ) -> StackMeasurement {","+    let key = StackMeasurementKey(","+      width: proposal.width,","+      height: proposal.height,","+      spacing: spacing,","+      ownDimensions: ownDimensions,","+      resolvesOwnPercentage: resolvesOwnPercentage","+    )","+    if let cached = cache.measurements[key] {","+      return cached","+    }","+    let measurement = measure(proposal: proposal, subviews: subviews)","+    if cache.measurements.count >= 8 {","+      cache.reset()","+    }","+    cache.measurements[key] = measurement","+    return measurement","+  }","+","+  func place(","+    in bounds: CGRect,","+    proposal: ProposedViewSize,","+    subviews: LayoutSubviews,","+    cache: inout StackLayoutCache","+  ) {","+    let measurement = self.measurement(","+      for: placementProposal(bounds: bounds, proposal: proposal),","+      subviews: subviews,","+      cache: &cache","+    )","+    let fill = alignment.offset(container: crossLength(bounds.size, axis: axis), content: measurement.contentCross)","+    // The origin stays leading.","+    // SwiftUI mirrors a custom layout in right-to-left.","+    var cursor = axis == .horizontal ? bounds.minX : bounds.minY","+    for index in subviews.indices {","+      let cross = (axis == .horizontal ? bounds.minY : bounds.minX) + fill + measurement.crossOffsets[index]","+      let origin = axis == .horizontal ? CGPoint(x: cursor, y: cross) : CGPoin