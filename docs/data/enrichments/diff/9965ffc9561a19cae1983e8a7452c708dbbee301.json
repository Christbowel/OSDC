{"id":"9965ffc9561a19cae1983e8a7452c708dbbee301","axis":"silent","repo":"mongodb/mongo","sha":"9965ffc9561a19cae1983e8a7452c708dbbee301","parsed":{"files":[{"path":"bazel/BUILD.bazel","lines":["@@ -12,10 +12,22 @@ package(default_visibility = [\"//visibility:public\"])"," exports_files([","     \"utils.bzl\",","     \"hermetic_container/hermetic_container.py\",","+    \"hermetic_container/container_paths.py\",","     \"install_rules.py\",","     \"run_under_working_dir.sh\","," ])"," ","+py_library(","+    name = \"container_paths\",","+    srcs = [\"hermetic_container/container_paths.py\"],","+)","+","+py_test(","+    name = \"container_paths_test\",","+    srcs = [\"hermetic_container/container_paths_test.py\"],","+    deps = [\":container_paths\"],","+)","+"," sh_binary(","     name = \"lint\",","     srcs = [\"lint.sh\"],"],"additions":12,"deletions":0,"truncated":false},{"path":"bazel/hermetic_container/container_paths.py","lines":["@@ -0,0 +1,48 @@","+\"\"\"Pure path conversion shared by container entry points.","+","+Callers choose destination drive case and supply the WSL mount prefix. This module","+does not read environment variables, select engines, or resolve host symlinks.","+\"\"\"","+","+from __future__ import annotations","+","+import pathlib","+import re","+","+","+def container_path(","+    path: pathlib.PurePath | str, *, windows: bool = False, lowercase_drive: bool = False","+) -> str:","+    \"\"\"Convert a host path to its Linux container destination.\"\"\"","+    value = str(path)","+    if not windows and not re.match(r\"^[A-Za-z]:[\\\\/]\", value):","+        return pathlib.PurePosixPath(value).as_posix()","+","+    windows_path = pathlib.PureWindowsPath(value)","+    drive = windows_path.drive.rstrip(\":\")","+    if windows_path.drive:","+        if len(drive) != 1 or not drive.isascii() or not drive.isalpha() or not windows_path.root:","+            raise ValueError(f\"Expected a drive-qualified Windows path: {path}\")","+        if lowercase_drive:","+            drive = drive.lower()","+        return pathlib.PurePosixPath(\"/\", drive, *windows_path.parts[1:]).as_posix()","+    return windows_path.as_posix()","+","+","+def drive_mount_prefix(prefix: str) -> str:","+    \"\"\"Validate a WSL mount prefix before using it in a privileged mount command.\"\"\"","+    normalized = prefix.rstrip(\"/\")","+    if not re.fullmatch(r\"/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\", normalized) or any(","+        part in {\".\", \"..\"} for part in normalized.split(\"/\")","+    ):","+        raise ValueError(f\"Invalid WSL drive mount prefix: {prefix!r}\")","+    return normalized","+","+","+def wsl_volume_source(path: pathlib.PurePath | str, mount_prefix: str) -> str:","+    \"\"\"Convert a drive-qualified Windows source to the Docker daemon's DrvFS path.\"\"\"","+    windows_path = pathlib.PureWindowsPath(str(path))","+    if not windows_path.drive:","+        return str(path)","+    destination = container_path(path, windows=True, lowercase_drive=True)","+    return f\"{drive_mount_prefix(mount_prefix)}{destination}\""],"additions":48,"deletions":0,"truncated":false},{"path":"bazel/hermetic_container/container_paths_test.py","lines":["@@ -0,0 +1,52 @@","+\"\"\"Path policies shared by whole-command containers and action containers.\"\"\"","+","+from __future__ import annotations","+","+import unittest","+","+from bazel.hermetic_container import container_paths","+","+","+class ContainerPathsTest(unittest.TestCase):","+    def test_destination_drive_case_is_explicit(self):","+        path = r\"C:\\work\\mongo\"","+        self.assertEqual(container_paths.container_path(path), \"/C/work/mongo\")","+        self.assertEqual(","+            container_paths.container_path(path, lowercase_drive=True), \"/c/work/mongo\"","+        )","+","+    def test_windows_root_relative_path_keeps_all_components(self):","+        self.assertEqual(","+            container_paths.container_path(r\"\\mongo-execroot\\bazel-out\", windows=True),","+            \"/mongo-execroot/bazel-out\",","+        )","+","+    def test_posix_paths_preserve_literal_backslashes(self):","+        self.assertEqual(container_paths.container_path(r\"/repo/a\\b\"), r\"/repo/a\\b\")","+","+    def test_wsl_source_accepts_explicit_prefix_without_environment(self):","+        self.assertEqual(","+            container_paths.wsl_volume_source(r\"Z:\\output base\\repo\", \"/drives\"),","+            \"/drives/z/output base/repo\",","+        )","+        self.assertEqual(container_paths.wsl_volume_source(\"/repo\", \"/mnt\"), \"/repo\")","+","+    def test_wsl_source_rejects_unc_and_drive_relative_paths(self):","+        for path in [r\"\\\\server\\share\\repo\", r\"C:repo\"]:","+            with self.subTest(path=path), self.assertRaises(ValueError):","+                container_paths.wsl_volume_source(path, \"/mnt\")","+","+    def test_mount_prefix_rejects_traversal_and_shell_metacharacters(self):","+        for prefix in [\"/mnt/../tmp\", \"/mnt/./drives\", \"/mnt;touch /tmp/oops\", \"relative\", \"/\"]:","+            with self.subTest(prefix=prefix), self.assertRaises(ValueError):","+                container_paths.wsl_volume_source(\"C:/repo\", prefix)","+","+    def test_mount_prefix_accepts_trailing_slashes(self):","+        self.assertEqual(","+            container_paths.wsl_volume_source(\"C:/repo\", \"/mnt/drives///\"),","+            \"/mnt/drives/c/repo\",","+        )","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"additions":52,"deletions":0,"truncated":false},{"path":"bazel/hermetic_container/hermetic_container.py","lines":["@@ -1,3 +1,4 @@","+import collections"," import getpass"," import hashlib"," import json","@@ -9,9 +10,11 @@"," import shutil"," import subprocess"," import sys","-import collections"," import time"," ","+# Also support loading this standalone module directly by filename.","+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))","+from container_paths imp