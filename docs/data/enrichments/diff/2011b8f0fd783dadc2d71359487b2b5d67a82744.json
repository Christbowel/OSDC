nt_id: u64 },"," }"," ","+/// Check an adapter's name and path, and that its name does not shadow a","+/// served base model.","+pub(crate) fn check_lora_module(","+    base_model_names: &[String],","+    module: &LoraModulePath,","+) -> Result<(), LoadLoraError> {","+    if module.name.trim().is_empty() {","+        bail_invalid_adapter!(\"lora_name must not be empty\");","+    }","+    if module.path.trim().is_empty() {","+        bail_invalid_adapter!(\"lora_path must not be empty\");","+    }","+    if base_model_names.contains(&module.name) {","+        return Err(LoadLoraError::BaseModelName {","+            lora_name: module.name.clone(),","+        });","+    }","+    Ok(())","+}","+"," impl LoraManager {","     pub fn new() -> Self {","         Self {","@@ -265,22 +285,14 @@ impl LoraManager {","         module: LoraModulePath,","         load_inplace: bool,","     ) -> Result<LoadedLora, LoadLoraError> {","+        check_lora_module(base_model_names, &module)?;","         let LoraModulePath {","             name: lora_name,","             path: lora_path,","             base_model_name,","             is_3d_lora_weight,","         } = module;","-        if lora_name.trim().is_empty() {","-            bail_invalid_adapter!(\"lora_name must not be empty\");","-        }","-        if lora_path.trim().is_empty() {","-            bail_invalid_adapter!(\"lora_path must not be empty\");","-        }","         let _guard = self.update_lock.lock().await;","-        if base_model_names.iter().any(|name| name == &lora_name) {","-            return Err(LoadLoraError::BaseModelName { lora_name });","-        }","         let adapters = self.adapters.read().await;","         let existing_lora_int_id = adapters.get(&lora_name).map(|adapter| adapter.lora_int_id);","         if !load_inplace && existing_lora_int_id.is_some() {"],"additions":21,"deletions":9,"truncated":false},{"path":"rust/src/server/src/mm_wire.rs","lines":["@@ -0,0 +1,46 @@","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+//! Wire forms of prepared multimodal items shared by the HTTP `features` and","+//! gRPC `PreprocessedMediaFeatures` formats. Kwargs use the engine protocol's","+//! MessagePack encoding, which Python's `MsgpackDecoder` also reads.","+","+use std::io::Cursor;","+","+use serde::Deserialize as _;","+use thiserror_ext::AsReport as _;","+use vllm_engine_core_client::protocol::encode_msgpack;","+use vllm_engine_core_client::protocol::multimodal::MmKwargsItem;","+use vllm_engine_core_client::protocol::tensor::{WireArrayData, WireTensor};","+","+const MAX_MSGPACK_DEPTH: usize = 32;","+","+/// Encode one item with all tensors inline.","+pub(crate) fn encode_kwargs(item: &MmKwargsItem) -> Result<Vec<u8>, String> {","+    encode_msgpack(item).map_err(|error| error.to_report_string())","+}","+","+/// Decode one item using the engine protocol's typed serde schema, rejecting","+/// deep nesting and trailing data.","+pub(crate) fn decode_kwargs(bytes: &[u8]) -> Result<MmKwargsItem, String> {","+    let mut decoder = rmp_serde::Deserializer::new(Cursor::new(bytes));","+    decoder.set_max_depth(MAX_MSGPACK_DEPTH);","+    let kwargs = MmKwargsItem::deserialize(&mut decoder).map_err(|error| {","+        format!(","+            \"invalid multimodal kwargs MessagePack: {}\",","+            error.as_report()","+        )","+    })?;","+    if decoder.position() != bytes.len() as u64 {","+        return Err(\"kwargs contains trailing MessagePack data\".to_string());","+    }","+    Ok(kwargs)","+}","+","+/// Read an inline boolean `is_embed` mask.","+pub(crate) fn mask_to_bools(mask: &WireTensor) -> Result<Vec<bool>, String> {","+    match &mask.data {","+        WireArrayData::RawView(bytes) => Ok(bytes.iter().map(|&byte| byte != 0).collect()),","+        WireArrayData::AuxIndex(_) => Err(\"is_embed mask must be stored inline\".to_string()),","+    }","+}"],"additions":46,"deletions":0,"truncated":false},{"path":"rust/src/server/src/render.rs","lines":["@@ -1,23 +1,26 @@"," // SPDX-License-Identifier: Apache-2.0"," // SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","-use std::collections::HashMap;","+use std::collections::{HashMap, HashSet};"," use std::sync::Arc;"," "," use anyhow::{Context as _, Result, bail};"," use serde_json::Value;"," use tokio_util::sync::CancellationToken;"," use tracing::info;","+use vllm_chat::multimodal::MmLimitPerPrompt;"," use vllm_chat::{","     ChatRequestProcessor, ChatTemplateContentFormatOption, LoadModelBackendsOptions,","     ParserSelection, RendererSelection, ToolStrictLevel, load_model_backends,"," };","+use vllm_engine_core_client::protocol::dtype::ModelDtype;"," use vllm_text::TextRequestProcessor;"," use vllm_text::backend::hf::{HfOverrides, ModelSource};"," ","+use crate::lora::check_lora_module;"," use crate::model_names::ServedModelNames;"," use crate::{","-    HttpListenerMode, ReasoningEffort, TlsConfig,","+    HttpListenerMode, LoraModulePath, ReasoningEffort, TlsConfig,","     listener::{Listener, MaybeTlsListener},","     tls,"," };","@@ -53,6 +56,16 @@ pub struct RenderConfig {","     pub chat_template_content_format: ChatTemplateContentFormatOption,","     pub max_model_len: Option<u32>,","     pub max_logprobs: Option<i32>,","+    /// LoRA adapters whose names are accepted as the request model. Rendering","+    /// does not depend on adapter weights, so they are not loaded.","+    pub lora_modules: Vec<LoraModulePath>,","+    /// Disable multimodal preprocessing and treat the model as language-only.","+    pub language_model_only: bool,","+    /// Dtype multimodal tensors are produced in; must match the engine's.","+    /// `None` follows the model config, like vLLM's `--dtype auto`.","+    pub dtype: Option<ModelDtype>,","+    /// Maximum multimodal items per prompt for each modality.","+    pub limit_mm_per_prompt: MmLimitPerPrompt,","     pub tls: Option<TlsConfig>,"," }","