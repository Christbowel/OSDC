m","+  module YAMLSerializer","+    class Builder","+      VALID_OPS = %w[= != > < >= <= ~>].freeze","+      ARRAY_FIELDS = %w[files test_files executables extra_rdoc_files].freeze","+      MAX_ALIAS_EXPANSION = 100_000","+","+      def initialize(permitted_classes: [], permitted_symbols: [], aliases: true)","+        @permitted_classes = permitted_classes.map {|c| \"!ruby/object:#{c}\" }","+        @permitted_symbols = permitted_symbols","+        @aliases = aliases","+        @anchor_values = {}","+        @anchor_sizes = {}","+        @expanded_size = 0","+        @alias_expansion = 0","+      end","+","+      def build(node)","+        return nil if node.nil?","+","+        result = build_node(node)","+","+        if result.is_a?(Hash) && result[:tag] == \"!ruby/object:Gem::Specification\"","+          build_specification(result)","+        else","+          result","+        end","+      end","+","+      private","+","+      def build_node(node)","+        start = @expanded_size","+        case node","+        when nil then nil","+        when AliasRef then resolve_alias(node)","+        when Scalar then store_anchor(node.anchor, node.value, start)","+        when Mapping then store_anchor(node.anchor, build_mapping(node), start)","+        when Sequence then store_anchor(node.anchor, node.items.map {|item| build_node(item) }, start)","+        else node # already a Ruby object","+        end","+      end","+","+      def resolve_alias(node)","+        raise Psych::AliasesNotEnabled unless @aliases","+        unless @anchor_values.key?(node.name)","+          raise Psych::AnchorNotDefined, node.name if defined?(Psych::AnchorNotDefined)","+          raise Psych::BadAlias, \"An alias referenced an unknown anchor: #{node.name}\"","+        end","+        # Charge the expanded size of the anchor, weighing scalars by length,","+        # so neither nested aliases nor aliases to a long string blow up.","+        size = @anchor_sizes.fetch(node.name)","+        @expan