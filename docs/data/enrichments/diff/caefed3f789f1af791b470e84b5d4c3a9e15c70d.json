ORAGE_KEY = 'chat.dismissedPromoIds';","@@ -40,7 +40,7 @@ export class ChatPromoNotificationContribution extends Disposable implements IWo"," \t\tthis._register(this._chatInputNotificationService.onDidDismiss(id => {"," \t\t\tconst promoId = this._shownNotifications.get(id)?.promoId;"," \t\t\tif (promoId) {","-\t\t\t\tthis._persistDismissedPromo(promoId);","+\t\t\t\taddDismissedNotificationId(this._storageService, DISMISSED_PROMOS_STORAGE_KEY, promoId);"," \t\t\t\tthis._update();"," \t\t\t}"," \t\t}));","@@ -56,7 +56,7 @@ export class ChatPromoNotificationContribution extends Disposable implements IWo"," \tprivate readonly _shownNotifications = new Map<string, { promoId: string; modelIdentifier: string }>();"," "," \tprivate _update(): void {","-\t\tconst dismissed = this._getDismissedPromoIds();","+\t\tconst dismissed = readDismissedNotificationIds(this._storageService, DISMISSED_PROMOS_STORAGE_KEY);"," \t\tconst modelIds = this._languageModelsService.getLanguageModelIds();"," "," \t\t// Bucket one non-dismissed promo per harness (a model's `targetChatSessionType`,","@@ -119,33 +119,5 @@ export class ChatPromoNotificationContribution extends Disposable implements IWo"," \t\t}"," \t}"," ","-\tprivate _persistDismissedPromo(promoId: string): void {","-\t\tconst dismissed = this._getDismissedPromoIds();","-\t\tif (dismissed.has(promoId)) {","-\t\t\treturn;","-\t\t}","-\t\tdismissed.add(promoId);","-\t\tthis._storageService.store(","-\t\t\tDISMISSED_PROMOS_STORAGE_KEY,","-\t\t\tJSON.stringify([...dismissed]),","-\t\t\tStorageScope.APPLICATION,","-\t\t\tStorageTarget.USER,","-\t\t);","-\t}"," ","-\tprivate _getDismissedPromoIds(): Set<string> {","-\t\tconst raw = this._storageService.get(DISMISSED_PROMOS_STORAGE_KEY, StorageScope.APPLICATION);","-\t\tif (!raw) {","-\t\t\treturn new Set();","-\t\t}","-\t\ttry {","-\t\t\tconst parsed = JSON.parse(raw);","-\t\t\tif (Array.isArray(parsed)) {","-\t\t\t\treturn new Set(parsed.filter((v): v is string => typeof v === 'string'));","-\t\t\t}","-\t\t} catch {","-\t\t\t// ignore malformed data","-\t\t}","-\t\treturn new Set();","-\t}"," }"],"additions":4,"deletions":32,"truncated":false},{"path":"src/vs/workbench/contrib/chat/browser/expNotification/chatExpNotificationConfig.ts","lines":["@@ -0,0 +1,293 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+/**","+ * Contract for chat notifications delivered as an experiment treatment.","+ *","+ * A notification is fully described by a versioned JSON payload, so its words, its targeting and","+ * its buttons can be authored or retired without shipping code. The payload is a serializable","+ * spelling of {@link IChatInputNotification}, which it builds directly.","+ */","+","+import { stableStringify } from '../../../../../base/common/objects.js';","+import { expandModelMatchCandidates, ID_PATTERN, isObject, MAX_ID_LENGTH, modelSelectorAliases, normalizeSelector, parseExpPayloadEnvelope, readSelectorList, readText } from '../../common/expPayload.js';","+import { ChatInputNotificationActionKind, ChatInputNotificationSeverity, IChatInputNotification, IChatInputNotificationAction } from '../widget/input/chatInputNotificationService.js';","+","+/** Payload versions this build understands. Bump when making a breaking shape change. */","+export const CHAT_EXP_NOTIFICATION_VERSION = 1;","+","+const MAX_NOTIFICATIONS = 8;","+const MAX_ACTIONS = 3;","+const MAX_CONFIG_KEYS = 8;","+","+const MATCH_KEYS = ['sessionTypes', 'selectedModels', 'excludeSelectedModels'];","+const MAX_TITLE_LENGTH = 120;","+const MAX_DESCRIPTION_LENGTH = 500;","+const MAX_LABEL_LENGTH = 40;","+","+// A Map has no prototype keys, so a payload cannot reach `Object.prototype` members through it.","+const SEVERITIES = new Map([","+\t['info', ChatInputNotificationSeverity.Info],","+\t['warning', ChatInputNotificationSeverity.Warning],","+\t['error', ChatInputNotificationSeverity.Error],","+]);","+","+/**","+ * Which chats a notification attaches to. An omitted or empty selector list means any.","+ *","+ * Both lists are matched against a set of candidates rather than one string, so a selector can","+ * name a session type or the harness behind it, and a model by id, family, name or vendor.","+ */","+export interface IChatExpNotificationMatch {","+\treadonly sessionTypes: readonly string[];","+\treadonly selectedModels: readonly string[];","+\t/** Models that suppress the notification, so a nudge can skip users already on its target. */","+\treadonly excludeSelectedModels: readonly string[];","+}","+","+/** A parsed notification, ready to hand to the notification service once `when` is bound. */","+export type ChatExpNotification = Omit<IChatInputNotification, 'when'> & {","+\treadonly match: IChatExpNotificationMatch;","+\t/** The entry's source text, used to tell a changed notification from an unchanged one. */","+\treadonly signature: string;","+};","+","+/** An action always carries its payload id, so duplicate ids can be reported. */","+type ChatExpNotificationAction = IChatInputNotificationAction & { telemetryActionId: string };","+","+export type ChatExpNotificationParseResult =","+\t| { readonly notifications: readonly ChatExpNotification[]; readonly error?: undefined }","+\t| { readonly notifications?: undefined; readonly error: string };","+","+/** Describes the chat a notification is matched against. The caller resolves the harness. */","+export interface IChatExpNotificationMatchContext {","+\treadonly sessionType: string | undefined;","+\t/** Agent host provider id, or `undefined` for sessions with no agent host. */","+\treadonly harness: string | undefined;","+\treadonly selectedModelId: string | undefined;","+\t/** Other identifiers for the selected model, such as its id, family, name and vendor. */","+\treadonly selectedModelAliases: readonly string[] | undefined;","+}","+","+/**","+ * Parses and validates a notification payload. Never throws, and rejects a bad payload whole","+ * rather than in part, so a malformed entry cannot quietly change who sees what.","+ */","+export function parseChatExpNotifications(raw: string | undefined): ChatExpNotificationParseResult {","+\tconst parsed = parseExpPayloadEnvelope(raw, CHAT_EXP_NOTIFICATION_VERSION);","+\tif (typeof parsed === 'string') {","+\t\treturn { error: parsed };","+\t}","+\t// An empty list is how a running experiment retires its notification without being removed.","+\tif (!Array.isArray(parsed.notifications)) {","+\t\treturn { error: 'notifications must be an array' };","+\t}","+\tif (parsed.notifications.length > MAX_NOTIFICATIONS) {","+\t\treturn { error: `notifications exceeds ${MAX_NOTIFICATIONS} entries` };","+\t}","+","+\tconst notifications: ChatExpNotification[] = [];","+\tconst seen = new Set<string>();","+\tfor (let i = 0; i < parsed.notifications.length; i++) {","+\t\tconst notification = readNotification(parsed.notifications[i], `notifications[${i}]`);","+\t\tif (typeof notification === 'string') {","+\t\t\treturn { error: notification };","+\t\t}","+\t\tif (seen.has(notification.id)) {","+\t\t\treturn { error: `notifications[${i}].id \"${notification.id}\" is duplicated` };","+\t\t}","+\t\tseen.add(notification.id);","+\t\tnotifications.push(notification);","+\t}","+","+\treturn { notifications };","+}","+","+function readNotification(raw: unknown, path: string): ChatExpNotification | string {","+\tif (!isObject(raw)) {","+\t\treturn `${path} must be an object`;","+\t}","+","+\tconst id = readText(raw.id, MAX_ID_LENGTH, ID_PATTERN);","+\tif (!id) {","+\t\treturn `${path}.id is missing or malformed`;","+\t}","+","+\tconst message = readText(raw.title, MAX_TITLE_LENGTH);","+\tif (!message) {","+\t\treturn `${path}.title is missing or too long`;","+\t}","+","+\tconst description = raw.description === undefined ? undefined : readText(raw.description, MAX_DESCRIPTION_LENGTH);","+\tif (raw.description !== undefined && !description) {","+\t\treturn `${path}.description is empty or too long`;","+\t}","+","+\tconst severity = raw.severity === undefined ? ChatInputNotificationSeverity.Info : SEVERITIES.get(raw.severity as string);","+\tif (severity === undefined) {","+\t\treturn `${path}.severity must be \"info\", \"warning\" or \"error\"`;","+\t}","+","+\tconst match = readMatch(raw.match, `${path}.match`);","+\tif (typeof match === 'string') {","+\t\treturn match;","+\t}","+","+\tconst actions = readActions(raw.actions, `${path}.actions`);","+\tif (typeof actions === 'string') {","+\t\treturn actions;","+\t}","+","+\tconst dismissible = readBoolean(raw.dismissible, true);","+\tconst autoDismissOnMessage = readBoolean(raw.autoDismissOnMessage, false);","+\tif (dismissible === undefined || autoDismissOnMessage === undefined) {","+\t\treturn `${path}.dismissible and ${path}.autoDismissOnMessage must be booleans`;","+\t}","+","+\t// A notice with no dismiss, no action and no auto-dismiss can never be cleared, and would","+\t// outrank the permission and setup prompts a user needs to get on with their work.","+\tif (!dismissible && !autoDismissOnMessage && !actions.length) {","+\t\treturn `${path} must be dismissible, auto-dismiss on message, or offer an action`;","+\t}","+","+\treturn {","+\t\tid,","+\t\ttelemetryId: id,","+\t\tseverity,","+\t\tmessage,","+\t\tdescription,","+\t\tmatch,","+\t\tactions,","+\t\tdismissible,","+\t\tautoDismissOnMessage,","+\t\tsignature: stableStringify(raw),","+\t};","+}","+","+function readBoolean(raw: unknown, fallback: boolean): boolean | undefined {","+\treturn raw === undefined ? fallback : typeof raw === 'boolean' ? raw : undefined;","+}","+","+function readMatch(raw: unknown, path: string): IChatExpNotificationMatch | string {","+\tif (raw !== undefined && !isObject(raw)) {","+\t\treturn `${path} must be an object`;","+\t}","+\tconst source = isObject(raw) ? raw : {};","+","+\t// A misspelled predicate would otherwise be ignored, silently widening the audience to","+\t// everyone the remaining predicates allow.","+\tconst unknown = Object.keys(source).find(key => !MATCH_KEYS.includes(key));","+\tif (unknown) {","+\t\treturn `${path} has unknown key ${JSON.stringify(unknown)}`;","+\t}","+","+\tconst sessionTypes = readSelectorList(source.sessionTypes, `${path}.sessionTypes`);","+\tif (typeof sessionTypes === 'string') {","+\t\treturn sessionTypes;","+\t}","+\tconst selectedModels = readSelectorList(source.selectedModels, `${path}.selectedModels`);","+\tif (typeof selectedModels === 'string') {","+\t\treturn selectedModels;","+\t}","+\tconst excludeSelectedModels = readSelectorList(source.excludeSelectedModels, `${path}.excludeSelectedModels`);","+\tif (typeof excludeSelectedModels === 'string') {","+\t\treturn excludeSelectedModels;","+\t}","+\tif (!sessionTypes.length && !selectedModels.length && !excludeSelectedModels.length) {","+\t\treturn `${path} must narrow at least one dimension`;","+\t}","+","+\treturn { sessionTypes, selectedModels, excludeSelectedModels };","+}","+","+function readActions(raw: unknown, path: string): ChatExpNotificationAction[] | string {","+\tif (raw === undefined) {","+\t\treturn [];","+\t}","+\tif (!Array.isArray(raw)) {","+\t\treturn `${path} must be an array`;","+\t}","+\tif (raw.length > MAX_ACTIONS) {","+\t\treturn `${path} exceeds ${MAX_ACTIONS} entries`;","+\t}","+","+\tconst actions: ChatExpNotificationAction[] = [];","+\tconst seen = new Set<string>();","+\tfor (let i = 0; i < raw.length; i++) {","+\t\tconst action = readAction(raw[i], `${path}[${i}]`);","+\t\tif (typeof action === 'string') {","+\t\t\treturn action;","+\t\t}","+\t\tif (seen.has(action.telemetryActionId)) {","+\t\t\treturn `${path}[${i}].id \"${action.telemetryActionId}\" is duplicated`;","+\t\t}","+\t\tseen.add(action.telemetryActionId);","+\t\tactions.push(action);","+\t}","+\treturn actions;","+}","+","+function readAction(raw: unknown, path: string): ChatExpNotificationAction | string {","+\tif (!isObject(raw)) {","+\t\treturn `${path} must be an object`;","+\t}","+","+\tconst telemetryActionId = readText(raw.id, MAX_ID_LENGTH, ID_PATTERN);","+\tif (!telemetryActionId) {","+\t\treturn `${path}.id is missing or malformed`;","+\t}","+","+\tconst label = readText(raw.label, MAX_LABEL_LENGTH);","+\tif (!label) {","+\t\treturn `${path}.label is missing or too long`;","+\t}","+","+\tconst base = { label, telemetryActionId };","+\tswitch (raw.kind) {","+\t\tcase ChatInputNotificationActionKind.OpenModelPicker:","+\t\t\treturn { ...base, kind: ChatInputNotificationActionKind.OpenModelPicker };","+","+\t\tcase ChatInputNotificationActionKind.Command: {","+\t\t\tif (typeof raw.commandId !== 'string' || !raw.commandId.trim()) {","+\t\t\t\treturn `${path}.commandId is missing`;","+\t\t\t}","+\t\t\tif (raw.args !== undefined && !Array.isArray(raw.args)) {","+\t\t\t\treturn `${path}.args must be an array`;","+\t\t\t}","+\t\t\treturn { ...base, kind: ChatInputNotificationActionKind.Command, commandId: raw.commandId.trim(), commandArgs: raw.args ?? [] };","+\t\t}","+","+\t\tcase ChatInputNotificationActionKind.SwitchToModel: {","+\t\t\tif (typeof raw.model !== 'string' || !raw.model.trim()) {","+\t\t\t\treturn `${path}.model is missing`;","+\t\t\t}","+\t\t\tif (raw.config !== undefined && (!isObject(raw.config) || Object.keys(raw.config).length > MAX_CONFIG_KEYS)) {","+\t\t\t\treturn `${path}.config must be an object of at most ${MAX_CONFIG_KEYS} keys`;","+\t\t\t}","+\t\t\t// Normalized like every other selector, so a display name such as \"Claude Sonnet 4.5\" matches.","+\t\t\tconst target = normalizeSelector(raw.model);","+\t\t\treturn {","+\t\t\t\t...base,","+\t\t\t\tkind: ChatInputNotificationActionKind.SwitchToModel,","+\t\t\t\tmatchesModel: model => expandModelMatchCandidates(model.identifier, modelSelectorAliases(model.metadata)).has(target),","+\t\t\t\tconfig: raw.config,","+\t\t\t\trequireUniqueModel: true,","+\t\t\t};","+\t\t}","+\t}","+","+\treturn `${path}.kind must be \"${ChatInputNotificationActionKind.Command}\", \"${ChatInputNotificationActionKind.OpenModelPicker}\" or \"${ChatInputNotificationActionKind.SwitchToModel}\"`;","+}","+","+/** Whether the chat described by `context` should be shown a notification matching `match`. */","+export function matchesChatExpNotification(match: IChatExpNotificationMatch, context: IChatExpNotificationMatchContext): boolean {","+\tconst { sessionTypes, selectedModels, excludeSelectedModels } = match;","+\tconst sessionCandidates = [context.sessionType, context.harness].map(value => value && normalizeSelector(value));","+\tconst modelCandidates = expandModelMatchCandidates(context.selectedModelId, context.selectedModelAliases);","+","+\treturn (!sessionTypes.length || sessionTypes.some(selector => sessionCandidates.includes(selector)))","+\t\t&& (!selectedModels.length || selectedModels.some(selector => modelCandidates.has(selector)))","+\t\t&& !excludeSelectedModels.some(selector => modelCandidates.has(selector));","+}"],"additions":293,"deletions":0,"truncated":false},{"path":"src/vs/workbench/contrib/chat/browser/expNotification/chatExpNotificationContribution.ts","lines":["@@ -0,0 +1,142 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { Disposable } from '../../../../../base/common/lifecycle.js';","+import { ChatAIDisabledSettingId } from '../../../../../platform/chat/common/chatSettings.js';","+import { IConfigurationService } from '../../../../../platform/configuration/common/configuration.js';","+import { ILogService } from '../../../../../platform/log/common/log.js';","+import { IStorageService, StorageScope } from '../../../../../platform/storage/common/storage.js';","+import { IWorkbenchContribution } from '../../../../common/contributions.js';","+import { IWorkbenchAssignmentService } from '../../../../services/assignment/common/assignmentService.js';","+import { IChatEntitlementService } from '../../../../services/chat/common/chatEntitlementService.js';","+import { IChatSessionsService } from '../../common/chatSessionsService.js';","+import { modelSelectorAliases } from '../../common/expPayload.js';","+import { addDismissedNotificationId, IChatInputNotificationContext, IChatInputNotificationService, readDismissedNotificationIds } from '../widget/input/chatInputNotificationService.js';","+import { ChatExpNotification, IChatExpNotificationMatch, matchesChatExpNotification, parseChatExpNotifications } from './chatExpNotificationConfig.js';","+","+export const CHAT_EXP_NOTIFICATION_TREATMENT = 'chatNotifications';","+","+const DISMISSED_STORAGE_KEY = 'chat.dismissedExpNotificationIds';","+","+/** Payload ids share a global map with built-in notifications, so they are namespaced. */","+const ID_PREFIX = 'chat.expNotification.';","+","+/**","+ * Renders chat input notifications described by an experiment treatment.","+ *","+ * The treatment carries the words, the targeting and the buttons, so a notification can be","+ * authored or retired without shipping code. Removing the assignment is the kill switch.","+ */","+export class ChatExpNotificationContribution extends Disposable implements IWorkbenchContribution {","+","+\tstatic readonly ID = 'workbench.contrib.chatExpNotification';","+","+\t/** Registered payload ids, each mapped to the entry text that produced it. */","+\tprivate readonly _registered = new Map<string, string>();","+\tprivate _notifications: readonly ChatExpNotification[] = [];","+\t/** Increments on every refresh so a slow in-flight resolution cannot overwrite a newer one. */","+\tprivate _generation = 0;","+","+\tconstructor(","+\t\t@IWorkbenchAssignmentService private readonly _assignmentService: IWorkbenchAssignmentService,","+\t\t@IChatInputNotificationService private readonly _notificationService: IChatInputNotificationService,","+\t\t@IChatSessionsService private readonly _chatSessionsService: IChatSessionsService,","+\t\t@IConfigurationService private readonly _configurationService: IConfigurationService,","+\t\t@IChatEntitlementService private readonly _entitlementService: IChatEntitlementService,","+\t\t@IStorageService private readonly _storageService: IStorageService,","+\t\t@ILogService private readonly _logService: ILogService,","+\t) {","+\t\tsuper();","+","+\t\tvoid this._resolve();","+\t\tthis._register(this._assignmentService.onDidRefetchAssignments(() => void this._resolve()));","+\t\tthis._register(this._notificationService.onDidDismiss(id => this._handleDismissed(id)));","+\t\tthis._register(this._storageService.onDidChangeValue(StorageScope.APPLICATION, DISMISSED_STORAGE_KEY, this._store)(() => this._update()));","+\t\t// `when` reads both gates, so mounted widgets must be told to re-evaluate when either flips.","+\t\tthis._register(this._entitlementService.onDidChangeSentiment(() => this._notificationService.refresh()));","+\t\tthis._register(this._configurationService.onDidChangeConfiguration(e => {","+\t\t\tif (e.affectsConfiguration(ChatAIDisabledSettingId)) {","+\t\t\t\tthis._notificationService.refresh();","+\t\t\t}","+\t\t}));","+\t}","+","+\tprivate async _resolve(): Promise<void> {","+\t\tconst generation = ++this._generation;","+\t\tlet payload: string | undefined;","+\t\ttry {","+\t\t\tpayload = await this._assignmentService.getTreatment<string>(CHAT_EXP_NOTIFICATION_TREATMENT);","+\t\t} catch (err) {","+\t\t\t// A failed lookup is not a retired assignment, so leave what is showing in place.","+\t\t\tthis._logService.trace(`[chatExpNotification] failed to resolve treatment: ${err}`);","+\t\t\treturn;","+\t\t}","+","+\t\tif (generation !== this._generation) {","+\t\t\treturn;","+\t\t}","+","+\t\t// An absent treatment is how an assignment is removed, so it clears what is showing.","+\t\t// Only a thrown lookup is treated as transient.","+\t\tconst result = payload === undefined ? undefined : parseChatExpNotifications(payload);","+\t\tif (result?.error) {","+\t\t\tthis._logService.warn(`[chatExpNotification] ignoring invalid payload: ${result.error}`);","+\t\t}","+\t\tthis._notifications = result?.notifications ?? [];","+","+\t\tthis._update();","+\t}","+","+\tprivate _update(): void {","+\t\tconst dismissed = readDismissedNotificationIds(this._storageService, DISMISSED_STORAGE_KEY);","+\t\tconst active = this._notifications.filter(notification => !dismissed.has(notification.id));","+","+\t\tfor (const id of [...this._registered.keys()]) {","+\t\t\tif (!active.some(notification => notification.id === id)) {","+\t\t\t\tthis._notificationService.deleteNotification(ID_PREFIX + id);","+\t\t\t\tthis._registered.delete(id);","+\t\t\t}","+\t\t}","+","+\t\tfor (const { match, signature, ...notification } of active) {","+\t\t\t// Persisted dismissals are already filtered out above, so what this protects is the","+\t\t\t// in-memory `autoDismissOnMessage` state that setting a notification would clear.","+\t\t\tif (this._registered.get(notification.id) === signature) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tthis._registered.set(notification.id, signature);","+\t\t\tthis._notificationService.setNotification({","+\t\t\t\t...notification,","+\t\t\t\tid: ID_PREFIX + notification.id,","+\t\t\t\twhen: context => this._matches(match, context),","+\t\t\t});","+\t\t}","+\t}","+","+\tprivate _matches(match: IChatExpNotificationMatch, context: IChatInputNotificationContext): boolean {","+\t\t// Checked here rather than by unregistering, so turning AI features off and on again","+\t\t// does not discard a