ir frontend TLS validation configuration.","+func getGatewaysForFrontendTLSConfigMap(ctx context.Context, c client.Client, cfgMap *corev1.ConfigMap, logger *slog.Logger) []*gatewayv1.Gateway {","+\tscopedLog := logger.With(logfields.Resource, cfgMap.GetName())","+\tcfgMapKey := client.ObjectKeyFromObject(cfgMap)","+\tcfgMapNamespace := gatewayv1.Namespace(cfgMap.Namespace)","+","+\tgwList := &gatewayv1.GatewayList{}","+\tif err := c.List(ctx, gwList); err != nil {","+\t\tscopedLog.ErrorContext(ctx, \"Unable to list Gateways\", logfields.Error, err)","+\t\treturn nil","+\t}","+","+\tgrants := &gatewayv1.ReferenceGrantList{}","+\tif err := c.List(ctx, grants); err != nil {","+\t\tscopedLog.ErrorContext(ctx, \"Unable to list ReferenceGrants\", logfields.Error, err)","+\t\treturn nil","+\t}","+","+\tvar gateways []*gatewayv1.Gateway","+\tfor i := range gwList.Items {","+\t\tgw := &gwList.Items[i]","+","+\t\trefs := helpers.FrontendTLSConfigMapRefSet(gw)","+\t\tif _, ok := refs[cfgMapKey]; !ok {","+\t\t\tcontinue","+\t\t}","+","+\t\tif !helpers.IsReferenceAllowed(","+\t\t\tgw.Namespace,","+\t\t\tcfgMap.Name,","+\t\t\t&cfgMapNamespace,","+\t\t\tgatewayv1.SchemeGroupVersion.WithKind(\"Gateway\"),","+\t\t\tcorev1.SchemeGroupVersion.WithKind(\"ConfigMap\"),","+\t\t\tgrants.Items,","+\t\t) {","+\t\t\tcontinue","+\t\t}","+","+\t\tgateways = append(gateways, gw)","+\t}","+","+\treturn gateways","+}","+","+func (h *SecretSyncHandler) EnqueueFrontendTLSConfigMapsReferenceGrant() handler.EventHandler {","+\treturn handler.EnqueueRequestsFromMapFunc(func(ctx context.Context, obj client.Object) []reconcile.Request {","+\t\tgrant, ok := obj.(*gatewayv1.ReferenceGrant)","+\t\tif !ok {","+\t\t\treturn nil","+\t\t}","+","+\t\tgwList := &gatewayv1.GatewayList{}","+\t\tif err := h.client.List(ctx, gwList); err != nil {","+\t\t\th.logger.ErrorContext(ctx, \"Failed to list Gateways for ReferenceGrant change\", logfields.Error, err)","+\t\t\treturn nil","+\t\t}","+","+\t\trequests := map[reconcile.Request]struct{}{}","+","+\t\tfor i := range gwList.Items {","+\t\t\tgw := &gwList.Items[i]","+","+\t\t\tif !helpers.GatewayHasMatchingControllerFn(ctx, h.client, h.controllerName, h.logger)(gw) {","+\t\t\t\tcontinue","+\t\t\t}","+","+\t\t\tfor cfgMap := range helpers.FrontendTLSConfigMapRefSet(gw) {","+\t\t\t\t// ReferenceGrants only matter for cross-namespace references,","+\t\t\t\t// and this grant can only affect references into its namespace.","+\t\t\t\tif cfgMap.Namespace == gw.Namespace || cfgMap.Namespace != grant.Namespace {","+\t\t\t\t\tcontinue","+\t\t\t\t}","+","+\t\t\t\trequests[reconcile.Request{NamespacedName: cfgMap}] = struct{}{}","+\t\t\t}","+\t\t}","+","+\t\treqs := make([]reconcile.Request, 0, len(requests))","+\t\tfor req := range requests {","+\t\t\treqs = append(reqs, req)","+\t\t}","+\t\treturn reqs","+\t})","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"operator/pkg/gateway-api/secretsync_frontendtls_test.go","lines":["@@ -0,0 +1,148 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package gateway_api","+","+import (","+\t\"testing\"","+","+\t\"github.com/cilium/hive/hivetest\"","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/types\"","+\t\"k8s.io/client-go/util/workqueue\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client/fake\"","+\t\"sigs.k8s.io/controller-runtime/pkg/event\"","+\t\"sigs.k8s.io/controller-runtime/pkg/reconcile\"","+\tgatewayv1 \"sigs.k8s.io/gateway-api/apis/v1\"","+","+\t\"github.com/cilium/cilium/operator/pkg/gateway-api/helpers\"","+\t\"github.com/cilium/cilium/operator/pkg/gateway-api/helpers/testhelpers\"","+)","+","+func TestFrontendTLSConfigMapSyncUsesOnlyFirstRef(t *testing.T) {","+\tlogger := hivetest.Logger(t)","+","+\tgw := gatewayWithFrontendTLSConfigMapRefs(\"gateway\", []gatewayv1.ObjectReference{"],"additions":27,"deletions":0,"truncate