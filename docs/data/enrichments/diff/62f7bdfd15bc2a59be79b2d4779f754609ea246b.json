{"id":"62f7bdfd15bc2a59be79b2d4779f754609ea246b","axis":"silent","repo":"pnpm/pnpm","sha":"62f7bdfd15bc2a59be79b2d4779f754609ea246b","parsed":{"files":[{"path":".changeset/config-get-lists-every-ca.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+`pnpm config get ca` and `pnpm config list` now show every certificate authority set with `ca=` or `ca[]=` lines in `.npmrc`. Several certificate authorities are printed as a JSON array, and a single one is still printed as a string. They showed only the last one."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config/tests.rs","lines":["@@ -962,7 +962,7 @@ fn config_for_get(explicit: &[(&str, Value)], auth: &[(&str, &str)]) -> Config {","         config.explicit_settings.insert((*key).to_string(), value.clone());","     }","     for (key, value) in auth {","-        config.raw_auth_config.insert((*key).to_string(), (*value).to_string());","+        config.raw_auth_config.insert((*key).to_string(), json!(value));","     }","     config"," }","@@ -1041,6 +1041,19 @@ fn get_unknown_key_is_undefined() {","     }"," }"," ","+#[test]","+fn get_ca_prints_every_configured_ca() {","+    let mut config = config_for_get(&[], &[]);","+    config.raw_auth_config.insert(\"ca\".to_string(), json!([\"first-ca\", \"second-ca\"]));","+    assert_eq!(","+        serde_json::from_str::<Value>(","+            &config_get(&config, flags(false, None, false), \"ca\").unwrap()","+        )","+        .unwrap(),","+        json!([\"first-ca\", \"second-ca\"]),","+    );","+}","+"," #[test]"," fn get_scoped_registry_from_auth_and_merged() {","     let from_auth ="],"additions":14,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config/values.rs","lines":["@@ -278,7 +278,7 @@ fn auth_value(config: &Config, key: &str) -> Value {","     config.raw_auth_config","         .get(key)","         .cloned()","-        .map_or(Value::Null, Value::String)","+        .unwrap_or(Value::Null)"," }"," "," /// `lookupByPropertyPath`: resolve a (possibly nested) property path against the","@@ -354,7 +354,7 @@ fn config_to_record(config: &Config) -> Map<String, Value> {","     merge_default_catalog(&mut result);","     absolutize_patch_paths(&mut result, config);","     for (key, value) in &config.raw_auth_config {","-        result.entry(key.clone()).or_insert_with(|| Value::String(value.clone()));","+        result.entry(key.clone()).or_insert_with(|| value.clone());","     }","     // The `registry` / `@scope:registry` rows show the merged routes (the","     // values `config get` answers) so a raw `.npmrc` row cannot contradict"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks.rs","lines":["@@ -500,8 +500,8 @@ fn resolved_config_views("," /// to name one. `pnpm config list` merges them the same way."," fn resolved_auth_config(config: &Config, registries_by_scope: &BTreeMap<String, String>) -> Value {","     let mut auth_config: serde_json::Map<String, Value> = config.raw_auth_config","-        .iter()","-        .map(|(k, v)| (k.clone(), Value::String(v.clone())))","+        .clone()","+        .into_iter()","         .collect();","     for (scope, url) in registries_by_scope {","         let key ="],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/config_get_set.rs","lines":["@@ -200,6 +200,26 @@ fn config_set_preserves_repeated_ca_and_comments_in_npmrc() {","     drop(root);"," }"," ","+#[test]","+fn config_get_ca_prints_every_ca_in_npmrc() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    fs::write(workspace.join(\".npmrc\"), \"ca[]=certificate-A\\nca=certificate-B\\n\")","+        .expect(\"write .npmrc\");","+","+    let output = pacquet_in(&workspace)","+        .with_args([\"config\", \"get\", \"ca\"])","+        .output()","+        .expect(\"run pacquet config get\");","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(output.status.success(), \"stderr={stderr}\");","+","+    let printed: serde_json::Value =","+        serde_json::from_slice(&output.stdout).expect(\"config get ca prints JSON\");","+    assert_eq!(printed, serde_json::json!([\"certificate-A\", \"certificate-B\"]));","+","+    drop(root);","+}","+"," #[test]"," fn config_delete_preserves_repeated_ca_and_comments_in_npmrc() {","     let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();"],"additions":20,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/auth_sources.rs","lines":["@@ -1,4 +1,9 @@","-use std::borrow::Cow;","+use std::{","+    borrow::Cow,","+    collections::BTreeMap,","+};","+","+use serde_json::Value;"," "," use super::{","     Config,","@@ -229,6 +234,25 @@ fn is_dlx_stripped_npmrc_key(key: &str) -> bool {","         .any(|suffix| key.ends_with(suffix))"," }"," ","+/// [`NpmrcAuth::raw_ini_config`] keeps only the last value of each key, so","+/// `ca` comes from the inline CA list, which keeps every entry and merges","+/// across sources the same way.","+fn raw_auth_config(auth: &mut NpmrcAuth) -> BTreeMap<String, Value> {","+    let mut raw: BTreeMap<String, Value> = std::mem::take(&mut auth.raw_ini_config)","+        .into_iter()","+        .map(|(key, value)| (key, Value::String(value)))","+        .collect();","+    if auth.tls.ca.len() > 1 {","+        let entries = auth.tls.ca","+            .iter()","+            .cloned()","+            .map(Value::String)","+            .collect();","+        raw.insert(\"ca\".to_string(), Value::Array(entries));","+    }","+    raw","+}","+"," fn clear_dlx_untrusted_project_npmrc(auth: &mut NpmrcAuth) {","     auth.proxy = crate::npmrc_auth::NpmrcProxy::default();","     auth.tls = crate::npmrc_auth::NpmrcTls::default();","@@ -399,7 +423,7 @@ impl Config {","         // Retain the merged raw `.npmrc` / `auth.ini` config keys for","         // `pnpm config get` / `pnpm config list` before the structured fields","         // are consumed below.","-        self.raw_auth_config = std::mem::take(&mut npmrc_auth.raw_ini_config);","+        self.raw_auth_config = raw_auth_config(&mut npmrc_auth);"," ","         npmrc_auth.move_warnings_to(self);","         let trusted_auth = merge_auth_sources(trusted_sources);"],"additions":26,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -1982,8 +1982,11 @@ pub struct Config {","     /// [`config_types::is_ini_config_key`](crate::config_types::is_ini_config_key) holds: `registry`, `@scope:registry`,","     /// `//host/:_authToken`, `username`, `ca`, ...), post-`${VAR}` substitution","     /// and merged across sources. The raw auth-config map, consumed by","-    /// `pnpm config get` / `pnpm config list`.","-    pub raw_auth_config: BTreeMap<String, String>,","+    /// `pnpm config get` / `pnpm config list` and passed to pnpmfile hooks.","+    ///","+    /// Each value is a string, except `ca`: an array when more than one","+    /// `ca` or `ca[]` entry is in effect, so no CA is hidden.","+    pub raw_auth_config: BTreeMap<String, serde_json::Value>,"," ","     /// The global pnpm config directory (`<configDir>`), where `config.yaml`","     /// and `auth.ini` live. `None` when it cannot be determined. Consumed by"],"additions":5,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/tests.rs","lines":["@@ -97,10 +97,9 @@ pub(crate) fn capture_warnings<Func: FnOnce()>(f: Func) -> Vec<String> {"," ","     let subscriber = tracing_subscriber::registry().with(CaptureLayer(messages_clone));","     tracing::subscriber::with_default(subscriber, f);","-    Arc::try_unwrap(messages)","-        .unwrap()","-        .into_inner()","-        .unwrap()","+    // A callsite registered on another test thread can still hold the","+    // subscriber, so take the messages instead of unwrapping the `Arc`.","+    std::mem::take(&mut *messages.lock().unwrap())"," }"," "," /// `Config::current` requires `Sys: LinkProbe` so the late-stage"],"additions":3,"deletions":4,"truncated":false},{"path":"pnpm/crates/config/src/tests/authorization_npmrc_auth_file_override.rs","lines":["@@ -287,7 +287,9 @@ pub fn cli_config_auth_outranks_url_scoped_env_and_project_npmrc() {","         Some(\"Bearer cli-token\"),","     );","     assert_eq!(","-        config.raw_auth_config.get(\"//env2e.example.com/:_authToken\").map(String::as_str),","+        config.raw_auth_config","+            .get(\"//env2e.example.com/:_authToken\")","+            .and_then(serde_json::Value::as_str),","         Some(\"cli-token\"),","     );"," }","@@ -687,7 +689,9 @@ pub fn rescoped_token_helper_is_reported_under_its_pinned_key() {","     let config = load_with_project_and_user(\"\", user_file);"," ","     assert_eq!(","-        config.raw_auth_config.get(\"//trusted.example.com/:tokenHelper\").map(String::as_str),","+        config.raw_auth_config","+            .get(\"//trusted.example.com/:tokenHelper\")","+            .and_then(serde_json::Value::as_str),","         Some(\"/bin/echo\"),","     );"," }"],"additions":6,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/tests/reporting.rs","lines":["@@ -76,7 +76,9 @@ pub fn rescoped_creds_are_reported_under_their_pinned_key() {","     let config = load_with_project_and_user(\"registry=https://attacker.example.com/\\n\", user_file);"," ","     assert_eq!(","-        config.raw_auth_config.get(\"//trusted.example.com/:_authToken\").map(String::as_str),","+        config.raw_auth_config","+            .get(\"//trusted.example.com/:_authToken\")","+            .and_then(serde_json::Value::as_str),","         Some(\"user-secret\"),","     );","     assert!(!config.raw_auth_config.contains_key(\"_authToken\"));"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/tests/tls_settings.rs","lines":["@@ -265,3 +265,43 @@ fn cli_tls_settings_reach_the_bootstrap_over_the_global_config_yaml_and_the_envi","     assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","     assert_eq!(config.package_manager_bootstrap.tls.local_address, local_address(LOCAL_ADDRESS));"," }","+","+fn raw_ca_from_project_npmrc(npmrc: &str) -> Option<serde_json::Value> {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(&project.path().join(\".npmrc\"), npmrc);","+    let config = Config::new().current::<HostNoHome>(project.path()).expect(\"load config\");","+    config.raw_auth_config.get(\"ca\").cloned()","+}","+","+#[test]","+fn raw_auth_config_lists_every_ca_array_entry() {","+    assert_eq!(","+        raw_ca_from_project_npmrc(\"ca[]=first-ca\\nca[]=second-ca\\n\"),","+        Some(serde_json::json!([\"first-ca\", \"second-ca\"])),","+    );","+}","+","+#[test]","+fn raw_auth_config_lists_repeated_ca_entries_in_file_order() {","+    assert_eq!(","+        raw_ca_from_project_npmrc(\"ca=first-ca\\nca[]=second-ca\\nca=third-ca\\n\"),","+        Some(serde_json::json!([\"first-ca\", \"second-ca\", \"third-ca\"])),","+    );","+}","+","+#[test]","+fn raw_auth_config_keeps_a_single_ca_as_a_string() {","+    assert_eq!(raw_ca_from_project_npmrc(\"ca[]=only-ca\\n\"), Some(serde_json::json!(\"only-ca\")));","+}","+","+#[test]","+fn raw_auth_config_ca_leaves_out_cafile_certificates() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(&project.path().join(\"extra.pem\"), \"file-ca\");","+    write_file(&project.path().join(\".npmrc\"), \"ca=inline-ca\\ncafile=extra.pem\\n\");","+","+    let config = Config::new().current::<HostNoHome>(project.path()).expect(\"load config\");","+","+    assert_eq!(config.tls.ca.len(), 2, \"tls.ca={:?}\", config.tls.ca);","+    assert_eq!(config.raw_auth_config.get(\"ca\"), Some(&serde_json::json!(\"inline-ca\")));","+}",""],"additions":40,"deletions":0,"truncated":false}],"additions":126,"deletions":16,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-27T19:03:04.447152+00:00"}