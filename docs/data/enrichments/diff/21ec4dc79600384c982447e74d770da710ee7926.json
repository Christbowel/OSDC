 ScopedEnvVar {","+public:","+    explicit ScopedEnvVar(const std::vector<std::pair<std::string, std::string>>& env) {","+        for (auto&& [envKey, envValue] : env) {","+            boost::optional<std::string> saved;","+            if (const char* oldValue = getenv(envKey.c_str()))","+                saved.emplace(oldValue);","+            _capturedEnv.emplace_back(envKey, std::move(saved));","+            setenv(envKey.c_str(), envValue.c_str(), 1);","+        }","+    }","+","+    ScopedEnvVar(ScopedEnvVar&&) = default;","+    ScopedEnvVar& operator=(ScopedEnvVar&&) = default;","+","+    ~ScopedEnvVar() {","+        for (auto&& [envKey, oldValue] : _capturedEnv) {","+            if (oldValue) {","+                setenv(envKey.c_str(), oldValue->c_str(), 1);","+            } else {","+                unsetenv(envKey.c_str());","+            }","+        }","+    }","+","+private:","+    std::vector<std::pair<std::string, boost::optional<std::string>>> _capturedEnv;","+};","+","+class StartupOptionsTest : public unittest::Test {","+public:","+    void setUp() override {","+        ASSERT_OK(addGeneralServerOptions(&_options));","+        ASSERT_OK(addNonGeneralServerOptions(&_options));","+    }","+","+    Status parseOptions(const SetupOptionsTestConfig& config) {","+        scopedEnvVar = ScopedEnvVar{config.envVars()};","+        if (!config.configFileName().empty()) {","+            _parser.setConfig(config.configFileName(), config.configFileContents());","+        }","+","+        return _parser.run(_options, config.binaryArgs(), &_environment);","+    }","+","+    void loadOptions(const SetupOptionsTestConfig& config) {","+        SCOPED_TRACE(config.toString());","+        ASSERT_OK(_environment.validate(/*setValue=*/false));","+        ASSERT_OK(validateServerOptions(_environment));","+        ASSERT_OK(canonicalizeServerOptions(&_environment));","+        ASSERT_OK(_environment.validate());","+        ASSERT_OK(setupServerOptions(config.binaryArgs()));","+        ASSERT_OK(storeServerOptions(_environment));","+    }","+","+    void parseAndLoadOptions(const SetupOptionsTestConfig& config) {","+        ASSERT_OK(parseOptions(config));","+        loadOptions(config);","+    }","+","+    moe::OptionSection& options() {","+        return _options;","+    }","+","+    moe::Environment& environment() {","+        return _environment;","+    }","+","+    auto makeForkDetachesOutputStreamsGuard() {","+        return ScopedValueRestore{serverGlobalParams.forkDetachesOutputStreams};","+    }","+","+private:","+    OptionsParserTester _parser;","+    moe::OptionSection _options;","+    moe::Environment _environment;","+    boost::optional<ScopedEnvVar> scopedEnvVar;","+};","+","+TEST_F(StartupOptionsTest, ForkDetachesOutputStreamsFalseParsedFromCLI) {","+    auto restore = makeForkDetachesOutputStreamsGuard();","+","+    const SetupOptionsTestConfig config{{\"--forkDetachesOutputStreams=false\"}, \"\", {}, {}};","+    parseAndLoadOptions(config);","+","+    ASSERT_FALSE(serverGlobalParams.forkDetachesOutputStreams);","+}","+","+TEST_F(StartupOptionsTest, ForkDetachesOutputStreamsFalseParsedFromYAML) {","+    auto restore = makeForkDetachesOutputStreamsGuard();","+","+    const SetupOptionsTestConfig config{","+        {}, \"config.yaml\", {{\"processManagement.forkDetachesOutputStreams\", \"false\"}}, {}};","+    parseAndLoadOptions(config);","+","+    ASSERT_FALSE(serverGlobalParams.forkDetachesOutputStreams);","+}","+","+TEST_F(StartupOptionsTest, ForkDetachesOutputStreamsTrueParsedFromCLI) {","+    auto restore = makeForkDetachesOutputStreamsGuard();","+","+    const SetupOptionsTestConfig config{{\"--forkDetachesOutputStreams=true\"}, \"\", {}, {}};","+    parseAndLoadOptions(config);","+","+    ASSERT_TRUE(serverGlobalParams.forkDetachesOutputStreams);","+}","+","+TEST_F(StartupOptionsTest, ForkDetachesOutputStreamsTrueParsedFromYAML) {","+    auto restore = makeForkDetachesOutputStreamsGuard();","+","+    const SetupO