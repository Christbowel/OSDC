{"id":"21ec4dc79600384c982447e74d770da710ee7926","axis":"silent","repo":"mongodb/mongo","sha":"21ec4dc79600384c982447e74d770da710ee7926","parsed":{"files":[{"path":"jstests/noPassthrough/libs/OWNERS.yml","lines":["@@ -1,5 +1,8 @@"," version: 1.0.0"," filters:","+  - \"*startup_shutdown*\":","+    approvers:","+      - 10gen/server-programmability","   - \"*server_parameter*\":","     approvers:","       - 10gen/server-programmability"],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/noPassthrough/libs/startup_shutdown_helpers.js","lines":["@@ -141,12 +141,15 @@ function forkThenShutdownMongoProgram(program, args) {","     }","     jsTestLog(\"Forked process exited with code \" + exitCode);","     assert.eq(0, exitCode);","+","+    return rawOutput;"," }"," "," /**","  * Starts mongod with the given arguments plus --fork, sets a failpoint that will cause the forked","  * process to shutdown immediately after startup completes, and asserts that both the parent and","- * child process exit with a code of 0.","+ * child process exit with a code of 0. Returns the raw output i.e., stdout and stderr merged into","+ * a single stream (unfortunately).","  */"," export function forkThenShutdownMongod(args = {}) {","     const defaultArgs = {","@@ -159,13 +162,14 @@ export function forkThenShutdownMongod(args = {}) {","     };"," ","     const testArgs = MongoRunner.mongodOptions({...defaultArgs, ...args});","-    forkThenShutdownMongoProgram(\"mongod\", testArgs);","+    return forkThenShutdownMongoProgram(\"mongod\", testArgs);"," }"," "," /**","  * Starts mongos with the given config server and arguments (plus --fork) sets a failpoint that","  * will cause the forked process to shutdown immediately after startup completes, and asserts that","- * both the parent and child process exit with a code of 0.","+ * both the parent and child process exit with a code of 0. Returns the raw output i.e., stdout and","+ * stderr merged into a single stream (unfortunately).","  */"," export function forkThenShutdownMongos(configRS, args = {}) {","     const defaultArgs = {","@@ -179,5 +183,5 @@ export function forkThenShutdownMongos(configRS, args = {}) {","     };"," ","     const testArgs = MongoRunner.mongosOptions({...defaultArgs, ...args});","-    forkThenShutdownMongoProgram(\"mongos\", testArgs);","+    return forkThenShutdownMongoProgram(\"mongos\", testArgs);"," }"],"additions":8,"deletions":4,"truncated":false},{"path":"jstests/noPassthrough/startup_shutdown/fork_detaches_output_streams.js","lines":["@@ -0,0 +1,145 @@","+/**","+ * Tests for the --forkDetachesOutputStreams server option.","+ */","+","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {ReplSetTest} from \"jstests/libs/replsettest.js\";","+import {isLinux} from \"jstests/libs/server_security/os_helpers.js\";","+import {","+    forkThenShutdownMongod,","+    forkThenShutdownMongos,","+    startThenShutdownMongod,","+    startThenShutdownMongos,","+} from \"jstests/noPassthrough/libs/startup_shutdown_helpers.js\";","+","+if (!isLinux()) {","+    jsTestLog(\"Skipping test due to non-linux platform.\");","+    quit();","+}","+","+// Markers that will be written directly to standard streams by a failpoint.","+const markers = {","+    stdout: \"stdout marker\",","+    stderr: \"stderr marker\",","+};","+","+// setParameter options to enable the failpoints we'll use to write to standard streams","+// and subsequently shutdown cleanly.","+const failpointParameters = {","+    \"failpoint.writeToStandardStreamsAtStartup\": tojsononeline({mode: \"alwaysOn\", data: markers}),","+    \"failpoint.shutdownAtStartup\": tojsononeline({mode: \"alwaysOn\"}),","+};","+","+/**","+ * Returns whether or not the given `text` contains a line that is exactly `marker`,","+ * accounting for the shell's prefixing of lines to indicate which process they came","+ * from e.g., \"d20040| <marker>\" for mongod and \"s20040| <marker>\" for mongos.","+ */","+function containsMarker(text, marker) {","+    return text.split(\"\\n\").some((line) => line.replace(/^[ds]\\d+\\| /, \"\") === marker);","+}","+","+/**","+ * Starts a forked mongod with the given command line options plus startup failpoints that cause","+ * writes to stdout and stderr and subsequently make the forked daemon shutdown. The failpoint","+ * actions all happen post-forking. Returns the raw output (which is unfortunately merged into","+ * a single stream).","+ */","+function runMongodWithStartupFailpoints(args) {","+    return forkThenShutdownMongod({...args, setParameter: failpointParameters});","+}","+","+/**","+ * Asserts that the marker lines appear in the raw program output only if the","+ * forkDetachesOutputStreams option is false.","+ */","+function assertMarkerLines(args, rawOutput) {","+    const keepStreams = args.forkDetachesOutputStreams === false;","+    for (const stream of [\"stdout\", \"stderr\"]) {","+        const markerLine = containsMarker(rawOutput, markers[stream]);","+        if (keepStreams) {","+            assert(markerLine, `expected a ${stream} marker line in program output`, {rawOutput});","+        } else {","+            assert(!markerLine, `expected no ${stream} marker line in program output`, {rawOutput});","+        }","+    }","+}","+","+function testMongod(args) {","+    const rawOutput = runMongodWithStartupFailpoints(args);","+    assertMarkerLines(args, rawOutput);","+}","+","+/**","+ * Starts a forked mongos with the given command line options plus startup failpoints that cause","+ * writes to stdout and stderr and subsequently make the forked daemon shutdown. The failpoint","+ * actions all happen post-forking. Returns the raw output (which is unfortunately merged into a","+ * single stream).","+ */","+function runMongosWithStartupFailpoints(configRS, args) {","+    return forkThenShutdownMongos(configRS, {...args, setParameter: failpointParameters});","+}","+","+function testMongos(configRS, args) {","+    const rawOutput = runMongosWithStartupFailpoints(configRS, args);","+    assertMarkerLines(args, rawOutput);","+}","+","+describe(\"mongod forkDetachesOutputStreams\", function () {","+    // Detaching is the default.","+    it(\"detaches output streams by default\", function () {","+        testMongod({});","+    });","+    it(\"handles forkDetachesOutputStreams=true\", function () {","+        testMongod({forkDetachesOutputStreams: true});","+    });","+    it(\"handles forkDetachesOutputStreams=false\", function () {","+        testMongod({forkDetachesOutputStreams: false});","+    });","+    it(\"handles --forkDetachesOutputStreams as a flag\", function () {","+        testMongod({forkDetachesOutputStreams: \"\"});","+    });","+","+    // Without --fork, the option is accepted but has no effect.","+    it(\"accepts forkDetachesOutputStreams=false without --fork\", function () {","+        startThenShutdownMongod({forkDetachesOutputStreams: false});","+    });","+    it(\"accepts forkDetachesOutputStreams=true without --fork\", function () {","+        startThenShutdownMongod({forkDetachesOutputStreams: true});","+    });","+});","+","+describe(\"mongos forkDetachesOutputStreams\", function () {","+    // For mongos to start up successfully, it needs a config server to connect to.","+    let configRS;","+","+    before(function () {","+        configRS = new ReplSetTest({nodes: 1});","+        configRS.startSet({configsvr: \"\"});","+        configRS.initiate();","+    });","+    after(function () {","+        configRS.stopSet();","+    });","+","+    it(\"detaches output streams by default\", function () {","+        testMongos(configRS, {});","+    });","+    it(\"handles forkDetachesOutputStreams=true\", function () {","+        testMongos(configRS, {forkDetachesOutputStreams: true});","+    });","+    it(\"handles forkDetachesOutputStreams=false\", function () {","+        testMongos(configRS, {forkDetachesOutputStreams: false});","+    });","+    it(\"handles --forkDetachesOutputStreams as a flag\", function () {","+        testMongos(configRS, {forkDetachesOutputStreams: \"\"});","+    });","+","+    // Without --fork, the option is accepted but has no effect.","+    it(\"accepts forkDetachesOutputStreams=false without --fork\", function () {","+        startThenShutdownMongos(configRS, {forkDetachesOutputStreams: false});","+    });","+    it(\"accepts forkDetachesOutputStreams=true without --fork\", function () {","+        startThenShutdownMongos(configRS, {forkDetachesOutputStreams: true});","+    });","+});"],"additions":145,"deletions":0,"truncated":false},{"path":"src/mongo/db/BUILD.bazel","lines":["@@ -284,6 +284,7 @@ mongo_cc_library(","         \":connection_health_metrics_parameter\",","         \":server_base\",","         \"//src/mongo/db/auth:cluster_auth_mode\",","+        \"//src/mongo/util:fail_point\",","         \"//src/mongo/util/options_parser\",","     ],"," )"],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/OWNERS.yml","lines":["@@ -81,6 +81,9 @@ filters:","   - \"index_names.*\":","     approvers:","       - 10gen/query-execution-write-exec","+  - \"initialize_server_global_state.*\":","+    approvers:","+      - 10gen/server-programmability","   - \"keys_collection*\":","     approvers:","       - 10gen/server-cluster-scalability"],"additions":3,"deletions":0,"truncated":false},{"path":"src/mongo/db/initialize_server_global_state.cpp","lines":["@@ -276,10 +276,12 @@ static bool forkServer() {","     };","     if (!stdioDetach(stdin, \"r\", \"stdin\"))","         return false;","-    if (!stdioDetach(stderr, \"w\", \"stderr\"))","-        return false;","-    if (!stdioDetach(stdout, \"w\", \"stdout\"))","-        return false;","+    if (serverGlobalParams.forkDetachesOutputStreams) {","+        if (!stdioDetach(stderr, \"w\", \"stderr\"))","+            return false;","+        if (!stdioDetach(stdout, \"w\", \"stdout\"))","+            return false;","+    }","     return true