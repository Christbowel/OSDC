t\t\t sx;","+\tu_int\t\t\t\t sy;","+","+\tTAILQ_ENTRY(redraw_damage)\tentry;","+};","+","+/*","+ * If there are more damage rectangles than this, they are collapsed into","+ * one.","+ */","+#define REDRAW_DAMAGE_MAX 16","+"," /* Cell for building the scene. */"," struct redraw_build_cell {"," \tstruct redraw_span_data\t data;"," };","-"," static struct redraw_build_cell\t*redraw_cells;"," static size_t\t\t\t redraw_ncells;"," ","+/*","+ * We can reuse the same pane status lines during one damage redraw, but when","+ * we enter a new one, the client or format variables may have changed, so we","+ * need to make them again. The generation is increased so this happens.","+ */","+static u_int\tredraw_status_generation;","+"," /* Context for building the scene. */"," struct redraw_build_ctx {"," \tstruct client\t\t\t\t*c;","@@ -1054,6 +1076,13 @@ redraw_free_scene(struct redraw_scene *scene)"," \tfree(scene);"," }"," ","+/* Does a client's cached scene show this window? */","+int","+redraw_client_has_window(struct client *c, struct window *w)","+{","+\treturn (c->redraw_scene != NULL && c->redraw_scene->w == w);","+}","+"," /* Mark a window's cached redraw scenes as out of date. */"," void"," redraw_invalidate_scene(struct window *w)","@@ -1061,6 +1090,104 @@ redraw_invalidate_scene(struct window *w)"," \tw->redraw_scene_generation++;"," }"," ","+/* Free all pending damage for a window. */","+void","+redraw_free_damage(struct window *w)","+{","+\tstruct redraw_damage\t*rd, *rd1;","+","+\tTAILQ_FOREACH_SAFE(rd, &w->damage, entry, rd1) {","+\t\tTAILQ_REMOVE(&w->damage, rd, entry);","+\t\tfree(rd);","+\t}","+\tw->damage_count = 0;","+}","+","+/* Collapse all pending damage for a window into one rectangle. */","+static void","+redraw_collapse_damage(struct window *w)","+{","+\tstruct redraw_damage\t*rd, *rd1, *first;","+\tu_int\t\t\t x0, y0, x1, y1;","+","+\tfirst = TAILQ_FIRST(&w->damage);","+\tif (first == NULL)","+\t\treturn;","+\tx0 = first->x;","+\ty0 = first->y;","+\tx1 = first->x + first->sx;","+\ty1 = first->y + first->sy;","+","+\tTAILQ_FOREACH_SAFE(rd, &w->damage, entry, rd1) {","+\t\tif (rd->x < x0)","+\t\t\tx0 = rd->x;","+\t\tif (rd->y < y0)","+\t\t\ty0 = rd->y;","+\t\tif (rd->x + rd->sx > x1)","+\t\t\tx1 = rd->x + rd->sx;","+\t\tif (rd->y + rd->sy > y1)","+\t\t\ty1 = rd->y + rd->sy;","+\t\tif (rd != first) {","+\t\t\tTAILQ_REMOVE(&w->damage, rd, entry);","+\t\t\tfree(rd);","+\t\t}","+\t}","+","+\tfirst->x = x0;","+\tfirst->y = y0;","+\tfirst->sx = x1 - x0;","+\tfirst->sy = y1 - y0;","+\tw->damage_count = 1;","+}","+","+/* Record window damage, merging nearby rectangles and limiting the count. */","+void","+redraw_damage_window(struct window *w, u_int x, u_int y, u_int sx, u_int sy)","+{","+\tstruct redraw_damage\t*rd;","+\tu_int\t\t\t x0, y0, x1, y1, area, union_area;","+","+\tif (x >= w->sx || y >= w->sy)","+\t\treturn;","+\tif (x + sx > w->sx)","+\t\tsx = w->sx - x;","+\tif (y + sy > w->sy)","+\t\tsy = w->sy - y;","+\tif (sx == 0 || sy == 0)","+\t\treturn;","+","+\tTAILQ_FOREACH(rd, &w->damage, entry) {","+\t\tif (x > rd->x + rd->sx || rd->x > x + sx ||","+\t\t    y > rd->y + rd->sy || rd->y > y + sy)","+\t\t\tcontinue;","+","+\t\tx0 = (x < rd->x) ? x : rd->x;","+\t\ty0 = (y < rd->y) ? y : rd->y;","+\t\tx1 = (x + sx > rd->x + rd->sx) ? x + sx : rd->x + rd->sx;","+\t\ty1 = (y + sy > rd->y + rd->sy) ? y + sy : rd->y + rd->sy;","+","+\t\tarea = sx * sy + rd->sx * rd->sy;","+\t\tunion_area = (x1 - x0) * (y1 - y0);","+\t\tif (union_area > 2 * area)","+\t\t\tcontinue;","+","+\t\trd->x = x0;","+\t\trd->y = y0;","+\t\trd->sx = x1 - x0;","+\t\trd->sy = y1 - y0;","+\t\treturn;","+\t}","+","+\trd = xcalloc(1, sizeof *rd);","+\trd->x = x;","+\trd->y = y;","+\trd->sx = sx;","+\trd->sy = sy;","+\tTAILQ_INSERT_TAIL(&w->damage, rd, entry);","+\tif (++w->damage_count > REDRAW_DAMAGE_MAX)","+\t\tredraw_collapse_damage(w);","+}","+"," /* Mark all cached redraw scenes as out of date. */"," void"," redraw_invalidate_all_scenes(void)","@@ -1603,6 +1730,24 @@ redraw_set_draw_context(struct redraw_draw_ctx *dctx,"," \t\tdctx->flags |= REDRAW_ISOLATES;"," }"," ","+/* Build a pane prompt. */","+static void","+redraw_make_pane_prompt(struct window_pane *wp, struct screen *screen)","+{","+\tstruct screen_write_ctx\t ctx;","+\tstruct prompt_draw_data\t pdd;","+","+\tscreen_init(screen, wp->sx, 1, 0);","+\tscreen_write_start(&ctx, screen);","+\tpdd.ctx = &ctx;","+\tpdd.cursor_x = &wp->prompt_cx;","+\tpdd.area_x = 0;","+\tpdd.area_width = wp->sx;","+\tpdd.prompt_line = 0;","+\tprompt_draw(wp->prompt, &pdd);","+\tscreen_write_stop(&ctx);","+}","+"," /* Draw a pane's prompt over its content. */"," static void"," redraw_draw_pane_prompt(struct redraw_draw_ctx *dctx, struct window_pane *wp)","@@ -1611,8 +1756,6 @@ redraw_draw_pane_prompt(struct redraw_draw_ctx *dctx, struct window_pane *wp)"," \tstruct client\t\t*c = scene->c;"," \tstruct tty\t\t*tty = &c->tty;"," \tstruct screen\t\t screen;","-\tstruct screen_write_ctx\t ctx;","-\tstruct prompt_draw_data\t pdd;"," \tint\t\t\t ox = scene->ox, oy = scene->oy;"," \tint\t\t\t sx = scene->sx, sy = scene->sy;"," \tint\t\t\t line, cy, px, offset, width, wy;","@@ -1645,16 +1788,7 @@ redraw_draw_pane_prompt(struct redraw_draw_ctx *dctx, struct window_pane *wp)"," \tif (px + width > sx)"," \t\twidth = sx - px;"," ","-\tscreen_init(&screen, wp->sx, 1, 0);","-\tscreen_write_start(&ctx, &screen);","-\tpdd.ctx = &ctx;","-\tpdd.cursor_x = &wp->prompt_cx;","-\tpdd.area_x = 0;","-\tpdd.area_width = wp->sx;","-\tpdd.prompt_line = 0;","-\tprompt_draw(wp->prompt, &pdd);","-\tscreen_write_stop(&ctx);","-","+\tredraw_make_pane_prompt(wp, &screen);"," \ttty_draw_line(tty, &screen, offset, 0, width, px, cy, NULL);"," \tscreen_free(&screen);"," }","@@ -1684,7 +1818,9 @@ redraw_draw(struct client *c, struct window_pane *wp, int flags)"," \t\t\tredraw = status_prompt_redraw(c);"," \t\telse"," \t\t\tredraw = status_redraw(c);","-\t\tif (!redraw && !REDRAW_IS_ALL(flags)) {","+\t\tif (!redraw &&","+\t\t    (~c->flags & CLIENT_REDRAWSTATUSALWAYS) &&","+\t\t    !REDRAW_IS_ALL(flags)) {"," \t\t\tflags &= ~REDRAW_STATUS;"," \t\t\tif (flags == 0)"," \t\t\t\treturn;","@@ -1834,7 +1970,7 @@ redraw_screen(struct client *c)"," \telse {"," \t\tif (c->flags & CLIENT_REDRAWBORDERS)"," \t\t\tflags |= (REDRAW_PANE_BORDER|REDRAW_PANE_STATUS);","-\t\tif (c->flags & CLIENT_REDRAWSTATUS)","+\t\tif (c->flags & (CLIENT_REDRAWSTATUS|CLIENT_REDRAWSTATUSALWAYS))"," \t\t\tflags |= (REDRAW_STATUS|REDRAW_PANE_STATUS);"," \t\tif (c->flags & CLIENT_REDRAWMENU)"," \t\t\tflags |= REDRAW_MENU;","@@ -1860,3 +1996,138 @@ redraw_pane_scrollbar(struct client *c, struct window_pane *wp)"," {"," \tredraw_draw(c, wp, REDRAW_PANE_SCROLLBAR);"," }","+","+/* Rebuild damaged pane status. */","+static void","+redraw_damage_refresh_status(struct redraw_draw_ctx *dctx,","+    struct window_pane *wp)","+{","+\tstruct redraw_span\t*first;","+\tu_int\t\t\t g = wp->status_generation, width;","+","+\tif ((wp->flags & PANE_NEWSTATUS) && g == redraw_status_generation)","+\t\treturn;","+\twidth = redraw_pane_status_width(dctx, wp, &first);","+\tif (width != 0) {","+\t\twindow_make_pane_status(wp, dctx->scene->c, width, first);","+\t\twp->flags |= PANE_NEWSTATUS;","+\t\twp->status_generation = redraw_status_generation;","+\t}","+}","+","+/* Draw a pane's prompt over a damaged span. */","+static void","+redraw_damage_draw_pane_prompt(struct redraw_draw_ctx *dctx,","+    struct redraw_span *span, u_int y)","+{","+\tstruct redraw_scene\t*scene = dctx->scene;","+\tstruct window_pane\t*wp = span->data.p.wp;","+\tstruct tty\t\t*tty = &scene->c->tty;","+\tstruct screen\t\t screen;","+\tu_int\t\t\t px = span->data.p.px, width, prompt_y;","+","+\tif (wp->prompt == NULL || wp->sx == 0 || wp->sy == 0)","+\t\treturn;","+\tif (dctx->flags & REDRAW_STATUS_TOP)","+\t\tprompt_y = 0;","+\telse","+\t\tprompt_y = wp->sy - 1;","+\tif (span->data.p.py != prompt_y)","+\t\treturn;","+\tredraw_make_pane_prompt(wp, &screen);","+\tif (px < screen_size_x(&screen)) {","+\t\twidth = span->width;","+\t\tif (width > screen_size_x(&screen) - px)","+\t\t\twidth = screen_size_x(&screen) - px;","+\t\ttty_draw_line(tty, &screen, px, 0, width, span->x, y, NULL);","+\t}","+\tscreen_free(&screen);","+}","+","+/* Draw the spans intersecting a damaged rectangle. */","+static void","+redraw_draw_damage_rectangle(struct redraw_draw_ctx *dctx, u_int x, u_int y,","+    u_int sx, u_int sy)","+{","+\tstruct redraw_scene\t*scene = dctx->scene;","+\tstruct redraw_line\t*line;","+\tstruct redraw_spans\t*spans;","+\tstruct redraw_span\t*span;","+\tu_int\t\t\t cy, yy, type;","+","+\tif (x >= scene->sx || y >= scene->sy)","+\t\treturn;","+\tif (x + sx > scene->sx)","+\t\tsx = scene->sx - x;","+\tif (y + sy > scene->sy)","+\t\tsy = scene->sy - y;","+\tif (sx == 0 || sy == 0)","+\t\treturn;","+","+\tfor (yy = y; yy < y + sy; yy++) {","+\t\tline = &scene->lines[yy];","+\t\tif (dctx->flags & REDRAW_STATUS_TOP)","+\t\t\tcy = dctx->status_lines + yy;","+\t\telse","+\t\t\tcy = yy;","+\t\tfor (type = 0; type < REDRAW_SPAN_TYPES; type++) {","+\t\t\tspans = &line->spans[type];","+\t\t\tTAILQ_FOREACH(span, spans, entry) {","+\t\t\t\tif (span->x >= x + sx)","+\t\t\t\t\tcontinue;","+\t\t\t\tif (span->x + span->width <= x)","+\t\t\t\t\tcontinue;","+\t\t\t\tif (type == REDRAW_SPAN_STATUS) {","+\t\t\t\t\tredraw_damage_refresh_status(dctx,","+\t\t\t\t\t    span->data.st.wp);","+\t\t\t\t}","+\t\t\t\tredraw_draw_span(dctx, span, cy);","+\t\t\t\tif (type == REDRAW_SPAN_PANE) {","+\t\t\t\t\tredraw_damage_draw_pane_prompt(dctx,","+\t\t\t\t\t    span, cy);","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+}","+","+/* Draw pending window damage on this client. */","+void","+redraw_client_damage(struct client *c)","+{","+\tstruct window\t\t*w = c->session->curw->window;","+\tstruct window_pane\t*wp;","+\tstruct redraw_scene\t*scene;","+\tstruct redraw_draw_ctx\t dctx;","+\tstruct redraw_damage\t*rd;","+\tu_int\t\t\t ox, oy, sx, sy, x0, y0, x1, y1;","+