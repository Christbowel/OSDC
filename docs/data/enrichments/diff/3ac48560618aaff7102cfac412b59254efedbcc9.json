+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit-jfr</artifactId>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit-deployment</artifactId>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-jfr-deployment</artifactId>","+        </dependency>","+","+        <!-- the helpers shared with the tests of quarkus-http-rate-limit-deployment -->","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>test-jar</type>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-rest-deployment</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-junit-internal</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>org.assertj</groupId>","+            <artifactId>assertj-core</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.vertx</groupId>","+            <artifactId>vertx-web-client</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>org.awaitility</groupId>","+            <artifactId>awaitility</artifactId>","+            <scope>test</scope>","+        </dependency>","+    </dependencies>","+","+    <build>","+        <plugins>","+            <plugin>","+                <artifactId>maven-compiler-plugin</artifactId>","+                <executions>","+                    <execution>","+                        <id>default-compile</id>","+                        <configuration>","+                            <annotationProcessorPaths>","+                                <path>","+                                    <groupId>io.quarkus</groupId>","+                                    <artifactId>quarkus-extension-processor</artifactId>","+                                    <version>${project.version}</version>","+                                </path>","+                            </annotationProcessorPaths>","+                        </configuration>","+                    </execution>","+                </executions>","+            </plugin>","+        </plugins>","+    </build>","+</project>"],"additions":87,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/jfr/deployment/src/test/java/io/quarkus/http/ratelimit/JfrEventsTest.java","lines":["@@ -0,0 +1,200 @@","+package io.quarkus.http.ratelimit;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.io.IOException;","+import java.net.URL;","+import java.nio.file.Files;","+import java.nio.file.Path;","+import java.time.Duration;","+import java.util.Comparator;","+import java.util.List;","+import java.util.Map;","+import java.util.concurrent.atomic.AtomicReference;","+","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+","+import org.junit.jupiter.api.AfterEach;","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.test.common.http.TestHTTPResource;","+import io.smallrye.common.annotation.Identifier;","+import io.smallrye.mutiny.Uni;","+import io.vertx.core.Vertx;","+import io.vertx.core.buffer.Buffer;","+import io.vertx.ext.web.client.HttpResponse;","+import jdk.jfr.Recording;","+import jdk.jfr.ValueDescriptor;","+import jdk.jfr.consumer.RecordedEvent;","+import jdk.jfr.consumer.RecordingFile;","+","+public class JfrEventsTest {","+","+    private static final String PREFIX = \"quarkus.http.rate-limit.\";","+    private static final String REJECTED = \"quarkus.RateLimitRejected\";","+    private static final String EVALUATION = \"quarkus.RateLimitEvaluation\";","+    private static final Duration DELAY = Duration.ofMillis(50);","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest()","+            .withApplicationRoot(jar -> jar.addClasses(TestHttp.class, TestClient.class, TestHttp.Resource.class,","+                    TestRateLimitClock.class, SlowStore.class))","+            .overrideConfigKey(\"quarkus.vertx.event-loops-pool-size\", \"1\")","+            .overrideConfigKey(PREFIX + \"rules.api.paths\", \"/limited/*\")","+            .overrideConfigKey(PREFIX + \"rules.api.phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"rules.api.request-key\", \"header:X-Test-Client\")","+            .overrideRuntimeConfigKey(PREFIX + \"rules.api.permits\", \"1\")","+            .overrideRuntimeConfigKey(PREFIX + \"rules.api.window\", \"1m\")","+            .overrideConfigKey(PREFIX + \"rules.slow.paths\", \"/slow/*\")","+            .overrideConfigKey(PREFIX + \"rules.slow.phase\", \"pre-authentication\")","+            .overrideConfigKey(PREFIX + \"rules.slow.store\", \"slow\")","+            .overrideConfigKey(PREFIX + \"rules.slow.request-key\", \"ip\")","+            .overrideRuntimeConfigKey(PREFIX + \"rules.slow.permits\", \"100\")","+            .overrideRuntimeConfigKey(PREFIX + \"rules.slow.window\", \"1m\")","+            .overrideRuntimeConfigKey(\"quarkus.http.rate-limit.store-timeout\", \"5s\");","+","+    @Inject","+    Vertx vertx;","+","+    @TestHTTPResource","+    URL url;","+","+    TestClient http;","+","+    @BeforeEach","+    void createClient() {","+        http = new TestClient(vertx, url);","+    }","+","+    @AfterEach","+    void closeClient() {","+        http.close();","+    }","+","+    @Test","+    void rejectionRecordsOneEventWithoutKeyOrAddress() throws IOException {","+        AtomicReference<String> retryAfter = new AtomicReference<>();","+        List<RecordedEvent> events = record(Duration.ZERO, () -> {","+            assertThat(get(\"/limited/a\").statusCode()).isEqualTo(200);","+            // a matrix parameter does not change the path the rule matches, nor the one the event records","+            HttpResponse<Buffer> rejected = http.get(\"/limited/a;x=1\", Map.of(\"X-Test-Client\", \"/limited/a\"));","+            assertThat(rejected.statusCode()).isEqualTo(429);","+            retryAfter.set(rejected.getHeader(\"Retry-After\"));","+        });","+","+        List<RecordedEvent> rejections = named(events, REJECTED);","+        assertThat(rejections).hasSize(1);","+        RecordedEvent rejection = rejections.getFirst();","+        assertThat(rejection.getString(\"rule\")).isEqualTo(\"api\");","+        assertThat(rejection.getString(\"phase\")).isEqualTo(\"pre-authentication\");","+        assertThat(rejection.getString(\"httpMethod\")).isEqualTo(\"GET\");","+        assertThat(rejection.getString(\"path\")).isEqualTo(\"/limited/a\");","+        assertThat(rejection.getDuration(\"retryAfter\").toSeconds()).isEqualTo(Long.parseLong(retryAfter.get()));","+        // keys can be addresses, API keys or token hashes, and recordings are shared","+        assertThat(rejection.getFields()).extracting(ValueDescriptor::getName)","+                .doesNotContain(\"key\", \"clientAddress\", \"address\", \"client\", \"principal\");","+","+        // both events of the rejected request carry the same request ID","+        assertThat(rejection.getString(\"traceId\")).isNotNull();","+        List<RecordedEvent> evaluations = named(events, EVALUATION);","+        assertThat(evaluations).hasSize(2);","+        assertThat(evaluations).extracting(e -> e.getString(\"outcome\")).containsExactly(\"ALLOWED\", \"REJECTED\");","+        RecordedEvent rejectedEvaluation = evaluations.get(1);","+        assertThat(rejectedEvaluation.getString(\"traceId\")).isEqualTo(rejection.getString(\"traceId\"));","+        assertThat(rejectedEvaluation.getString(\"spanId\")).isEqualTo(rejection.getString(\"spanId\"));","+        assertThat(evaluations.getFirst().getString(\"traceId\")).isNotNull()","+                .isNotEqualTo(rejection.getString(\"traceId\"));","+        assertThat(rejectedEvaluation.getFields()).extracting(ValueDescriptor::getName)","+                .doesNotContain(\"key\", \"clientAddress\", \"address\", \"client\", \"principal\");","+    }","+","+    @Test","+    void slowEvaluationIsRecordedWithTheDefaultThreshold() throws IOException {","+        // the first local decisions of a cold JVM can exceed the threshold","+        for (int i = 0; i < 20; i++) {","+            assertThat(get(\"/limited/warm-up-\" + i).statusCode()).isEqualTo(200);","+        }","+        List<RecordedEvent> events = record(null, () -> {","+            assertThat(get(\"/slow/a\").statusCode()).isEqualTo(200);","+            // a local decision is far below the default threshold of 10 ms","+            assertThat(get(\"/limited/b\").statusCode()).isEqualTo(200);","+        });","+","+        List<RecordedEvent> evaluations = named(events, EVALUATION);","+        assertThat(evaluations).hasSize(1);","+        RecordedEvent evaluation = evaluations.getFirst();","+        assertThat(evaluation.getString(\"rule\")).isEqualTo(\"slow\");","+        assertThat(evaluation.getString(\"phase\")).isEqualTo(\"pre-authentication\");","+        assertThat(evaluation.getString(\"store\")).isEqualTo(\"slow\");","+        assertThat(evaluation.getString(\"outcome\")).isEqualTo(\"ALLOWED\");","+        assertThat(evaluation.getDuration()).isGreaterThanOrEqualTo(DELAY);","+        assertThat(evaluation.getString(\"traceId\")).isNotNull();","+    }","+","+    @Test","+    void fastEvaluationIsRecordedWithAZeroThreshold() throws IOException {","+        List<RecordedEvent> events = record(Duration.ZERO,","+                () -> assertThat(get(\"/limited/c\").statusCode()).isEqualTo(200));","+","+        List<RecordedEvent> evaluations = named(events, EVALUATION);","+        assertThat(evaluations).hasSize(1);","+        assertThat(evaluations.getFirst().getString(\"rule\")).isEqualTo(\"api\");","+        assertThat(evaluations.getFirst().getString(\"store\")).isEqualTo(\"local\");","+        assertThat(evaluations.getFirst().getString(\"outcome\")).isEqualTo(\"ALLOWED\");","+        assertThat(named(events, REJECTED)).isEmpty();","+    }","+","+    /**","+     * @param threshold the evaluation threshold, {@code null} for the event's default","+     */","+    private static List<RecordedEvent> record(Duration threshold, Runnable action)","+            throws IOException {","+        Path dump = Files.createTempFile(\"rate-limit\", \".jfr\");","+        try {","+            try (Recording recording = new Recording()) {","+                recording.enable(REJECTED);","+                if (threshold == null) {","+                    recording.enable(EVALUATION);","+                } else {","+                    recording.enable(EVALUATION).withThreshold(threshold);","+                }","+                recording.start();","+                action.run();","+                recording.stop();","+                recording.dump(dump);","+            }","+            return RecordingFile.readAllEvents(dump).stream()","+                    .sorted(Comparator.comparing(RecordedEvent::getStartTime))","+                    .toList();","+        } finally {","+            Files.deleteIfExists(dump);","+        }","+    }","+","+    private static List<RecordedEvent> named(List<RecordedEvent> events, String name) {","+        return events.stream().filter(e -> e.getEventType().getName().equals(name)).toList();","+    }","+","+    private HttpResponse<Buffer> get(String path) {","+        // use a distinct test client for each request sequence","+        return http.get(path, Map.of(\"X-Test-Client\", path));","+    }","+","+    /**","+     * Admits every request after {@link #DELAY}.","+     */","+    @Singleton","+    @Identifier(\"slow\")","+    public static class SlowStore implements RateLimitStore {","+","+        @Override","+        public Uni<RateLimitDecision> tryConsume(String key, long cost, RateLimitPolicy policy) {","+            return Uni.createFrom().<RateLimitDecision> item(RateLimitDecision.allowed(policy.burst() - cost))","+                    .onItem().delayIt().by(DELAY);","+        }","+    }","+}"],"additions":200,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/jfr/pom.xml","lines":["@@ -0,0 +1,23 @@","+<?xml version=\"1.0\" encoding=\"UTF-8\"?>","+<project xmlns=\"http://maven.apache.org/POM/4.0.0\"","+         xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"","+         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">","+    <modelVersion>4.0.0</modelVersion>","+","+    <parent>","+        <groupId>io.quarkus</groupId>","+        <artifactId>quarkus-http-rate-limit-parent</artifactId>","+        <version>999-SNAPSHOT</version>","+    </parent>","+","+    <artifactId>quarkus-http-rate-limit-jfr-parent</artifactId>","+    <packaging>pom</packaging>","+","+    <name>Quarkus - HTTP Rate Limit - JFR</name>","+","+    <modules>","+        <module>deployment</module>","+        <module>runtime</module>","+    </modules>","+","+</project>"],"additions":23,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/jfr/runtime/pom.xml","lines":["@@ -0,0 +1,60 @@","+<?xml version=\"1.0\" encoding=\"UTF-8\"?>","+<project xmlns=\"http://maven.apache.org/POM/4.0.0\"","+         xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"","+         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">","+    <modelVersion>4.0.0</modelVersion>","+","+    <parent>","+        <groupId>io.quarkus</groupId>","+        <artifactId>quarkus-http-rate-limit-jfr-parent</artifactId>","+        <version>999-SNAPSHOT</version>","+    </parent>","+","+    <artifactId>quarkus-http-rate-limit-jfr</artifactId>","+","+    <name>Quarkus - HTTP Rate Limit - JFR - Runtime</name>","+    <description>JDK Flight Recorder events of the HTTP rate limiter; included automatically next to quarkus-http-rate-limit when quarkus-jfr is present</description>","+","+    <dependencies>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit</artifactId>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-jfr</artifactId>","+        </dependency>","+    </dependencies>","+","+    <build>","+        <plugins>","+            <plugin>","+                <groupId>io.quarkus</groupId>","+                <artifactId>quarkus-extension-maven-plugin</artifactId>","+                <configuration>","+                    <!-- included automatically next to quarkus-http-rate-limit when quarkus-jfr is present -->","+                    <dependencyCondition>","+                        <artifact>io.quarkus:quarkus-jfr</artifact>","+                    </dependencyCondition>","+                </configuration>","+            </plugin>","+            <plugin>","+                <artifactId>maven-compiler-plugin</artifactId>","+                <executions>","+                    <execution>","+                        <id>default-compile</id>","+                        <configuration>","+                            <annotationProcessorPaths>","+                                <path>","+                                    <groupId>io.quarkus</groupId>","+                                    <artifactId>quarkus-extension-processor</artifactId>","+                                    <version>${project.version}</version>","+                                </path>","+                            </annotationProcessorPaths>","+                        </configuration>","+                    </execution>","+                </executions>","+            </plugin>","+        </plugins>","+    </build>","+</project>"],"additions":60,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/jfr/runtime/src/main/java/io/quarkus/http/ratelimit/jfr/runtime/internal/JfrRateLimitFlightRecorder.java","lines":["@@ -0,0 +1,122 @@","+package io.quarkus.http.ratelimit.jfr.runtime.internal;","+","+import jakarta.inject.Singleton;","+","+import io.quarkus.arc.Arc;","+import io.quarkus.arc.ManagedContext;","+import io.quarkus.arc.Unremovable;","+import io.quarkus.http.ratelimit.RateLimitDecision;","+import io.quarkus.http.ratelimit.runtime.internal.rules.Outcome;","+import io.quarkus.http.ratelimit.runtime.internal.rules.RuleEvaluator;","+import io.quarkus.http.ratelimit.runtime.internal.telemetry.RateLimitFlightRecorder;","+import io.quarkus.jfr.api.IdProducer;","+import io.quarkus.vertx.http.runtime.security.HttpSecurityUtils;","+import io.vertx.ext.web.RoutingContext;","+","+/**","+ * Commits the rate limit JFR events. A bean only when the JFR extension is present.","+ * <p>","+ * An evaluation event is begun only when it is enabled, and every event is populated only when it will be committed.","+ */","+@Singleton","+@Unremovable","+public class JfrRateLimitFlightRecorder implements RateLimitFlightRecorder {","+","+    private static final String IDS_KEY = JfrRateLimitFlightRecorder.class.getName() + \".ids\";","+","+    private final IdProducer idProducer;","+","+    public JfrRateLimitFlightRecorder(IdProducer idProducer) {","+        this.idProducer = idProducer;","+    }","+","+    @Override","+    public Object evaluationStarted() {","+        RateLimitEvaluationEvent event = new RateLimitEvaluationEvent();","+        if (!event.isEnabled()) {","+            return null;","+        }","+        event.begin();","+        return event;","+    }","+","+    /**","+     * The decision is asynchronous: {@link #evaluationStarted()} and this method may run on different threads, which","+     * JFR allows (begin and end only take timestamps; the event is not shared concurrently, as the stages of a","+     * {@code Uni} happen one after another). The recorded thread is the one that commits.","+     */","+    @Override","+    public void evaluated(Object evaluation, RoutingContext ctx, Outcome outcome) {","+        if (!(evaluation instanceof RateLimitEvaluationEvent event)) {","+            return;","+        }","+        event.end();","+        if (event.shouldCommit()) {","+            Ids ids = ids(ctx);","+            event.traceId = ids.traceId;","+            event.spanId = ids.spanId;","+            RuleEvaluator evaluator = outcome.evaluator();","+            event.rule = evaluator.rule();","+            event.phase = evaluator.phase().configName();","+            event.store = evaluator.storeName();","+            event.outcome = outcome(outcome);","+            event.commit();","+        }","+    }","+","+    @Override","+    public void rejected(RoutingContext ctx, RuleEvaluator evaluator, long retryAfterSeconds) {","+        RateLimitRejectedEvent event = new RateLimitRejectedEvent();","+        if (event.shouldCommit()) {","+            Ids ids = ids(ctx);","+            event.traceId = ids.traceId;","+            event.spanId = ids.spanId;","+            event.rule = evaluator.rule();","+            event.phase = evaluator.phase().configName();","+            event.httpMethod = ctx.request().method().name();","+            // the path the rules were matched against","+            event.path = HttpSecurityUtils.normalizePath(ctx.normalizedPath());","+            event.retryAfter = retryAfterSeconds;","+            event.commit();","+        }","+    }","+","+    private static String outcome(Outcome outcome) {","+        return switch (outcome.kind()) {","+            case DECIDED -> switch (outcome.decision()) {","+                case RateLimitDecision.Allowed allowed -> \"ALLOWED\";","+                case RateLimitDecision.Rejected rejected -> \"REJECTED\";","+            };","+            case SKIPPED, UNAVAILABLE -> outcome.kind().name();","+        };","+    }","+","+    /**","+     * The IDs of the request, the same for every event of the request. The rate limit filters run before any CDI","+     * request context exists; the request scoped {@link IdProducer} then needs one of its own, only for as long as","+     * the IDs are read. Without OpenTelemetry, the trace ID of these events is therefore not that of the REST events of","+     * the same request.","+     */","+    private Ids ids(RoutingContext ctx) {","+        Ids ids = ctx.get(IDS_KEY);","+        if (ids != null) {","+            return ids;","+        }","+        ManagedContext requestContext = Arc.container().requestContext();","+        if (requestContext.isActive()) {","+            ids = new Ids(idProducer.getTraceId(), idProducer.getSpanId());","+        } else {","+            requestContext.activate();","+            try {","+                ids = new Ids(idProducer.getTraceId(), idProducer.getSpanId());","+            } finally {","+                requestContext.terminate();","+            }","+        }","+        ctx.put(IDS_KEY, ids);","+        return ids;","+    }","+","+    private record Ids(String traceId, String spanId) {","+    }","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/jfr/runtime/src/main/java/io/quarkus/http/ratelimit/jfr/runtime/internal/RateLimitEvaluationEvent.java","lines":["@@ -0,0 +1,50 @@","+package io.quarkus.http.ratelimit.jfr.runtime.internal;","+","+import io.quarkus.jfr.api.SpanIdRelational;","+import io.quarkus.jfr.api.TraceIdRelational;","+import jdk.jfr.Category;","+import jdk.jfr.Description;","+import jdk.jfr.Event;","+import jdk.jfr.Label;","+import jdk.jfr.Name;","+import jdk.jfr.StackTrace;","+import jdk.jfr.Threshold;","+","+/**","+ * Spans one rule's decision for one request: key resolution, limitResolver and the store call. Never records the key or","+ * the client address.","+ */","+@Label(\"Rate Limit Evaluation\")","+@Category({ \"Quarkus\", \"HTTP\" })","+@Name(\"quarkus.RateLimitEvaluation\")","+@Description(\"A rate limit rule decided on a request during this period\")","+@StackTrace(false)","+@Threshold(\"10 ms\")","+public class RateLimitEvaluationEvent extends Event {","+","+    @Label(\"Trace ID\")","+    @Description(\"Trace ID to identify the request\")","+    @TraceIdRelational","+    String traceId;","+","+    @Label(\"Span ID\")","+    @Description(\"Span ID to identify the request if necessary\")","+    @SpanIdRelational","+    String spanId;","+","+    @Label(\"Rule\")","+    @Description(\"Name of the rate limit rule\")","+    String rule;","+","+    @Label(\"Phase\")","+    @Description(\"pre-authentication or post-authentication\")","+    String phase;","+","+    @Label(\"Store\")","+    @Description(\"Name of the store of the rule\")","+    String store;","+","+    @Label(\"Outcome\")","+    @Description(\"ALLOWED, REJECTED, UNAVAILABLE, or SKIPPED\")","+    String outcome;","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"extensions/http-rate-limit/jfr/runtime/src/main/java/io/quarkus/http/ratelimit/jfr/runtime/internal/RateLimitRejectedEvent.java","lines":["@@ -0,0 +1,54 @@","+package io.quarkus.http.ratelimit.jfr.runtime.internal;","+","+import io.quarkus.jfr.api.SpanIdRelational;","+import io.quarkus.jfr.api.TraceIdRelational;","+import jdk.jfr.Category;","+import jdk.jfr.Description;","+import jdk.jfr.Event;","+import jdk.jfr.Label;","+import jdk.jfr.Name;","+import jdk.jfr.StackTrace;","+import jdk.jfr.Timespan;","+","+/**","+ * Never records the key or the client address: keys c