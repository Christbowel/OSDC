      using var listener = new RuntimeProviderListener(GCKeyword);","+                if (i % 2 == 0)","+                {","+                    await Task.Delay(1);","+                }","+            }","+","+            await Task.Delay(500);","+","+            using var finalListener = new RuntimeProviderListener(GCKeyword);","+            for (int attempt = 0; attempt < 50 && !finalListener.ReceivedEvent; attempt++)","+            {","+                GC.Collect();","+                await Task.Delay(100);","+            }","+","+            Assert.True(finalListener.ReceivedEvent, \"A new runtime-provider subscription received no events.\");","+        }","+","+        private sealed class RuntimeProviderListener : EventListener","+        {","+            private readonly EventKeywords _keywords;","+","+            public volatile bool ReceivedEvent;","+","+            public RuntimeProviderListener(EventKeywords keywords)","+            {","+                _keywords = keywords;","+                // Sources created before the listener are delivered from the base constructor, before _keywords is set.","+                foreach (EventSource source in EventSource.GetSources())","+                {","+                    OnEventSourceCreated(source);","+                }","+            }","+","+            protected override void OnEventSourceCreated(EventSource source)","+            {","+                if (source.Name == \"Microsoft-Windows-DotNETRuntime\" && _keywords != 0)","+                {","+                    EnableEvents(source, EventLevel.Informational, _keywords);","+                }","+            }","+","+            protected override void OnEventWritten(EventWrittenEventArgs eventData) => ReceivedEvent = true;","+        }","+","         private void ExerciseEventSource(WeakReference wrProvider, WeakReference wrEventSource)","         {","             using (var es = new LifetimeTestEventSource())"],"additions":60,"deletions":0,"truncated":