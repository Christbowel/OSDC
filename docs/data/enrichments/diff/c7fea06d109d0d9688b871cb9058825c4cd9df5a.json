with_required(|| Err(crate::signature::error::SigningError::ForkAtNotSupported))?;","         self.ensure_transaction_closed();","         Ok(Self {","             doc: self.doc.fork_at(heads)?,","@@ -1531,3 +1548,7 @@ mod tests {","         is_send::<super::AutoCommit>();","     }"," }","+","+#[cfg(test)]","+#[path = \"autocommit/author_tests.rs\"]","+mod author_tests;"],"additions":29,"deletions":8,"truncated":false},{"path":"rust/automerge/src/autocommit/author_tests.rs","lines":["@@ -0,0 +1,116 @@","+//! AutoCommit authors are fixed at construction; forks decide before closing edits.","+","+use ed25519_dalek::SigningKey;","+","+use crate::signature::error::SigningError;","+use crate::signature::{ed25519, signing_message};","+use crate::transaction::Transactable;","+use crate::{Author, AutomergeError, ChangeHash, ReadDoc, ROOT};","+","+use super::AutoCommit;","+","+fn author(seed: u8) -> Author<'static> {","+    Author::from(","+        SigningKey::from_bytes(&[seed; 32])","+            .verifying_key()","+            .to_bytes()","+            .to_vec(),","+    )","+}","+","+fn signature(seed: u8, hash: &ChangeHash) -> ed25519::Signature {","+    use ed25519_dalek::Signer;","+    ed25519::Signature::from_bytes(","+        SigningKey::from_bytes(&[seed; 32])","+            .sign(&signing_message(hash))","+            .to_bytes(),","+    )","+}","+","+#[test]","+fn rejected_author_fork_does_not_close_an_open_transaction() {","+    let mut weak = vec![0; 32];","+    weak[0] = 1;","+    for proposed in [","+        None,","+        Some(Author::from(vec![1, 2, 3])),","+        Some(Author::from(weak)),","+        Some(author(8)),","+    ] {","+        let mut doc = AutoCommit::from_config(crate::Config::default().signing(author(7)).unwrap());","+        doc.put(ROOT, \"pending\", 1).unwrap();","+        assert!(doc.transaction.is_some());","+        assert!(doc.doc.get_heads().is_empty());","+        let before = format!(\"{doc:?}\");","+        let error = doc.fork_with_author(proposed.clone()).unwrap_err();","+        match proposed {","+            Some(candidate) if candidate == author(8) => assert!(matches!(","+                error,","+                AutomergeError::Signing(SigningError::UnpublishedLocalChanges)","+            )),","+            _ => assert!(matches!(error, AutomergeError::SigningAuthor(_))),","+        }","+        assert_eq!(format!(\"{doc:?}\"), before);","+        assert_eq!(doc.rollback(), 1);","+        assert!(doc.doc.get_heads().is_empty());","+        assert!(doc.get(ROOT, \"pending\").unwrap().is_none());","+    }","+}","+","+#[test]","+fn rolled_back_transaction_permits_a_different_author_fork_of_published_work() {","+    let mut doc = AutoCommit::from_config(crate::Config::default().signing(author(7)).unwrap());","+    doc.put(ROOT, \"x\", 1).unwrap();","+    let hash = doc.commit().unwrap();","+    doc.insert_signatures([(hash, signature(7, &hash))]);","+    assert!(!doc.has_unpublished_changes());","+","+    doc.put(ROOT, \"y\", 2).unwrap();","+    assert!(doc.fork_with_author(Some(author(8))).is_err());","+    assert_eq!(doc.pending_ops(), 1);","+    doc.rollback();","+","+    let fork = doc.fork_with_author(Some(author(8))).unwrap();","+    assert_eq!(fork.get_author(), Some(&author(8)));","+    assert_ne!(fork.get_actor(), doc.get_actor());","+}","+","+#[test]","+fn same_author_fork_commits_pending_work_and_rotates_only_the_fork_actor() {","+    let mut doc = AutoCommit::from_config(crate::Config::default().signing(author(7)).unwrap());","+    doc.put(ROOT, \"pending\", 1).unwrap();","+    let actor = doc.doc.get_actor().clone();","+    let mut fork = doc.fork_with_author(Some(author(7))).unwrap();","+    assert!(doc.transaction.is_none());","+    assert_eq!(doc.pending_ops(), 0, \"pending work was drained\");","+    assert_eq!(doc.doc.get_actor(), &actor);","+    assert_ne!(fork.doc.get_actor(), &actor);","+    assert_eq!(fork.get_heads(), doc.get_heads());","+    assert_eq!(fork.get_author(), Some(&author(7)));","+    assert_eq!(fork.try_signing().unwrap().required_signatures().len(), 1);","+    let changes = doc.doc.get_changes(&[]);","+    assert_eq!(changes.len(), 1);","+    assert_eq!(changes[0].actor_id(), &actor);","+    assert_eq!(changes[0].author(), Some(author(7)));","+    assert_eq!(fork.doc.get_changes(&[]).len(), 1);","+}","+","+#[test]","+fn unsigned_constructors_and_forks_remain_permissive() {","+    let arbitrary = Author::from(vec![1, 2, 3]);","+    let mut doc = AutoCommit::from_config(crate::Config::default().author(Some(arbitrary.clone())));","+    doc.put(ROOT, \"pending\", 1).unwrap();","+    let mut fork = doc.fork_with_author(None).unwrap();","+    assert!(doc.transaction.is_none());","+    assert_eq!(fork.get_heads(), doc.get_heads(), \"pending edits committed\");","+    assert_eq!(","+        doc.doc.get_changes(&[])[0].author(),","+        Some(arbitrary.clone())","+    );","+    assert_eq!(doc.get_author(), Some(&arbitrary));","+    assert!(fork.get_author().is_none());","+    let replaced = doc.fork_with_author(Some(Author::from(vec![2]))).unwrap();","+    assert_eq!(replaced.get_author(), Some(&Author::from(vec![2])));","+    let doc = AutoCommit::from_config(crate::Config::default().author(None));","+    assert!(doc.get_author().is_none());","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"rust/automerge/src/automerge.rs","lines":["@@ -35,8 +35,8 @@ use crate::transaction::{"," };"," use crate::types::{ActorId, ChangeHash, ObjId, ObjMeta, OpId, SequenceType, TextEncoding, Value};"," use crate::write_frontier::WriteFrontier;","-use crate::Config;"," use crate::{AutomergeError, Change, Cursor, Fragment, ObjType, Prop};","+use crate::{Config, ForkOptions};"," use actor::ActorMaintenance;"," use author::AuthorRegistration;"," use history::History;","@@ -347,6 +347,12 @@ pub struct Automerge {","     actor: Actor,"," }"," ","+/// Validated full-fork identity choices, consumed after pending edits commit.","+pub(crate) struct PreparedFork {","+    author: Option<DocumentAuthor<'static>>,","+    actor: ActorId,","+}","+"," impl Automerge {","     /// Create a new document with a random actor id.","     pub fn new() -> Self {","@@ -1080,10 +1086,71 @@ impl Automerge {","         &self,","         author: Option<Author<'static>>,","     ) -> Result<Self, AutomergeError> {","-        let identity = self.signing.fork_identity(author, false)?;","-        let mut fork = self.fork();","-        fork.signing.set_fork_identity(identity);","-        Ok(fork)","+        self.fork_with_options(ForkOptions::default().author(author))","+    }","+","+    /// Create a full writable fork after checking author and actor choices.","+    ///","+    /// # Errors","+    /// Rejects incompatible actors, unusable signing keys, or a changed signing","+    /// author while local drafts remain unpublished. Rejection leaves the source","+    /// unchanged; the fork inherits its signing mode.","+    pub fn fork_with_options(&self, options: ForkOptions) -> Result<Self, AutomergeError> {","+        let prepared = self.prepare_fork(options, None)?;","+        Ok(self.fork_prepared(prepared))","+    }","+","+    pub(crate) fn prepare_fork(","+        &self,","+        options: ForkOptions,","+        pending_actor: Option<&ActorId>,","+    ) -> Result<PreparedFork, AutomergeError> {","+        let author = options.author.unwrap_or_else(|| self.get_author().cloned());","+        let changed = author.as_ref() != self.get_author();","+        let prepared_author = if changed {","+            Some(","+                self.signing","+                    .prepare_fork_author(author.clone(), pending_actor.is_some())?,","+            )","+        } else {","+            None","+        };","+        if let Some(actor) = &options.actor {","+            if let Some(index) = self.ops.lookup_actor(actor) {","+                let existing = self.authors.get_author_for_actor(index);","+                if self.authors.is_bound(index)","+                    && existing.as_ref().map(Author::as_bytes)","+                        != author.as_ref().map(Author::as_bytes)","+                {","+                    return Err(AutomergeError::ActorAuthorMismatch {","+                        actor: actor.clone(),","+                    });","+                }","+            }","+        }","+        if let Some(actor) = pending_actor {","+            if changed && options.actor.as_ref() == Some(actor) {","+                return Err(AutomergeError::ActorAuthorMismatch {","+                    actor: actor.clone(),","+                });","+            }","+        }","+        Ok(PreparedFork {","+            author: prepared_author,","+            actor: options.actor.unwrap_or_else(ActorId::random),","+        })","+    }","+","+    pub(crate) fn fork_prepared(&self, prepared: PreparedFork) -> Self {","+        let mut fork = self.clone();","+        if let Some(author) = prepared.author {","+            fork.signing.replace_fork_author(author);","+        }","+        fork.actor = match fork.ops.lookup_actor(&prepared.actor) {","+            Some(index) => Actor::Cached(index),","+            None => Actor::Unused(prepared.actor),","+        };","+        fork","     }"," ","     /// Fork this document at the current point with a fresh actor and the same author."],"additions":72,"deletions":5,"truncated":false},{"path":"rust/automerge/src/automerge/signing.rs","lines":["@@ -15,9 +15,11 @@ use crate::author::Authors;"," use crate::change_graph::ChangeGraph;"," use crate::clock::SeqClock;"," use crate::config::DocumentAuthor;","+use crate::error::SigningAuthorErrorInner;"," use crate::op_set2::OpSet;"," use crate::signature::{ed25519, Insert, Signature, SignatureStore};"," use crate::storage::signatures::{HashEntries, SignaturesChunk};","+use crate::SigningAuthorError;"," use crate::{Author, Change, ChangeHash, Fragment, PatchLog};"," "," use super::Automerge;","@@ -114,37 +116,40 @@ impl SigningState {","         }","     }"," ","-    pub(crate) fn fork_identity(","+    pub(super) fn prepare_fork_author(","         &self,","         author: Option<Author<'static>>,","-        pending: bool,","+        has_pending_edits: bool,","     ) -> Result<DocumentAuthor<'static>, crate::AutomergeError> {","         match self {","             Self::Unsigned { .. } => Ok(author.into()),","-            Self::Required(state) => {","-                let author = author.ok_or(crate::SigningAuthorError(","-                    crate::error::SigningAuthorErrorInner::MissingAuthor,","-                ))?;","-                if &author == state.author.author() {","-                    return Ok(DocumentAuthor::Verifier(state.author.clone()));","-                }","-                let prepared = DocumentAuthor::signing(author)?;","-                if pending || !state.local_drafts.is_empty() {","+            Self::Required(signing) => {","+                let author =","+                    author.ok_or(SigningAuthorError(SigningAuthorErrorInner::MissingAuthor))?;","+                let changed = &author != signing.author.author();","+                let prepared = if changed {","+                    ed25519::VerifyingAuthor::new(author).map_err(|error| {","+                        SigningAuthorError(SigningAuthorErrorInner::InvalidKey(error))","+                    })?","+                } else {","+                    signing.author.clone()","+                };","+                if changed && (has_pending_edits || !signing.local_drafts.is_empty()) {","                     return Err(","                         crate::signature::error::SigningError::UnpublishedLocalChanges.into(),","                     );","                 }","-                Ok(prepared)","+                Ok(DocumentAuthor::Verifier(prepared))","             }","         }","     }"," ","-    pub(crate) fn set_fork_identity(&mut self, identity: DocumentAuthor<'static>) {","-        match (self, identity) {","+    pub(super) fn replace_fork_author(&mut self, author: DocumentAuthor<'static>) {","+        match (self, author) {","             (Self::Unsigned { author }, DocumentAuthor::Unset) => *author = None,","             (Self::Unsigned { author }, DocumentAuthor::Set(value)) => *author = Some(value),","             (Self::Required(state), DocumentAuthor::Verifier(value)) => state.author = value,","-            _ => unreachable!(\"fork preserves signing mode\"),","+            _ => unreachable!(\"prepared fork must preserve signing mode\"),","         }","     }"," "],"additions":20,"deletions":15,"truncated":false},{"path":"rust/automerge/src/automerge/signing/tests.rs","lines":["@@ -10,6 +10,7 @@ use super::error;"," use crate::{SignatureBatchOutcome, SignatureInsertError};"," "," mod batch;","+mod fork;"," mod fragments;"," mod identity;"," mod incoming;"],"additions":1,"deletions":0,"truncated":false},{"path":"rust/automerge/src/automerge/signing/tests/fork.rs","lines":["@@ -0,0 +1,352 @@","+//! Immutable construction-time authors and the guarded new-author fork.","+","+use crate::signature::error::SigningError;","+use crate::{AutoCommit, AutomergeError, LoadOptions, Signature};","+","+use super::*;","+","+fn weak_author() -> Author<'static> {","+    let mut weak = vec![0; 32];","+    weak[0] = 1;","+    Author::from(weak)","+}","+","+fn invalid_authors() -> Vec<Author<'static>> {","+    vec![Author::from(vec![1, 2, 3]), weak_author()]","+}","+","+fn unsigned_doc(author: Author<'static>) -> Automerge {","+    Automerge::from_config(crate::Config::default().author(Some(author)))","+        .with_actor(ActorId::from([1]))","+        .unwrap()","+}","+","+#[test]","+fn unsigned_commits_carry_the_configured_author() {","+    let arbitrary = Author::from(vec![1, 2, 3]);","+    let mut doc = unsigned_doc(arbitrary.clone());","+    let first = append_at_level(&mut doc, None, 1, 0);","+    assert_eq!(","+        doc.get_change_by_hash(&first).unwrap().author(),","+        Some(arbitrary)","+    );","+}","+","+#[test]","+fn load_options_author_overrides_the_saved_author() {","+    let mut doc = unsigned_doc(Author::from(vec![1, 2, 3]));","+    append_at_level(&mut doc, None, 1, 0);","+    let bytes = doc.save();","+","+    let other = Author::from(vec![9, 9]);","+    let loaded =","+        Automerge::load_with_options(&bytes, LoadOptions::new().author(other.clone())).unwrap();","+    assert_eq!(loaded.get_author(), Some(&other));","+    let empty =","+        Automerge::load_with_options(&[], LoadOptions::new().author(other.clone())).unwrap();","+    assert_eq!(empty.get_author(), Some(&other));","+    assert!(Automerge::load(&bytes).unwrap().get_author().is_none());","+}","+","+#[test]","+fn fork_inherits_the_author_with_a_fresh_actor() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    append_at_level(&mut doc, None, 1, 0);","+","+    let fork = doc.fork();","+    assert_eq!(fork.get_author(), Some(&author(&k)));","+    assert_ne!(fork.get_actor(), doc.get_actor());","+    assert!(fork.signing.is_required());","+}","+","+#[test]","+fn clone_is_exact() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    append_at_level(&mut doc, None, 1, 0);","+","+    let clone = doc.clone();","+    assert_eq!(clone.get_actor(), doc.get_actor());","+    assert_eq!(format!(\"{clone:?}\"), format!(\"{doc:?}\"));","+}","+","+#[test]","+fn same_author_fork_copies_drafts_with_independent_provenance() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+","+    let mut same = doc.fork_with_author(Some(author(&k))).unwrap();","+    assert_eq!(same.get_author(), Some(&author(&k)));","+    assert_ne!(same.get_actor(), doc.get_actor());","+    assert_eq!(drafts(&mut same), [a]);","+    assert_eq!(drafts(&mut doc), [a]);","+    // Independent provenance: publishing in one copy does not touch the other.","+    sign_doc(&mut same, a, &k);","+    assert!(drafts(&mut same).is_empty());","+    assert_eq!(drafts(&mut doc), [a]);","+}","+","+#[test]","+fn different_author_fork_is_rejected_while_an_unsigned_draft_remains() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    append_at_level(&mut doc, None, 1, 0);","+    let before = format!(\"{doc:?}\");","+","+    assert!(matches!(","+        doc.fork_with_author(Some(author(&key(8)))),","+        Err(AutomergeError::Signing(","+            SigningError::UnpublishedLocalChanges","+        ))","+    ));","+    assert_eq!(format!(\"{doc:?}\"), before);","+}","+","+#[test]","+fn different_author_fork_is_rejected_while_a_signed_but_unpublished_draft_remains() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    // With the loose gap `a` unsigned, signing `b` stores its proof but cannot","+    // publish it, so a draft remains.","+    let a = append_at_level(&mut doc, None, 1, 0);","+    let b = append_at_level(&mut doc, None, 2, 0);","+    doc.insert_signatures([(b, sig(&k, &b))]);","+    assert!(!is_published(&mut doc, &b));","+    assert_eq!(drafts(&mut doc), [a, b]);","+    let before = format!(\"{doc:?}\");","+","+    assert!(matches!(","+        doc.fork_with_author(Some(author(&key(8)))),","+        Err(AutomergeError::Signing(","+            SigningError::UnpublishedLocalChanges","+        ))","+    ));","+    assert_eq!(format!(\"{doc:?}\"), before);","+}","+","+#[test]","+fn required_mode_fork_never_removes_the_author() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    append_at_level(&mut doc, None, 1, 0);","+    let before = format!(\"{doc:?}\");","+","+    assert!(matches!(","+        doc.fork_with_author(None),","+        Err(AutomergeError::SigningAuthor(_))","+    ));","+    assert_eq!(format!(\"{doc:?}\"), before);","+}","+","+#[test]","+fn fork_with_an_unusable_author_is_a_key_error_before_the_draft_gate() {","+    let k = key(7);","+    let mut doc = signing_doc(&k, 1);","+    append_at_level(&mut doc, None, 1, 0);","+    let before = format!(\"{doc:?}\");","+","+    for invalid in invalid_authors() {","+        assert!(matches!(","+            doc.fork_with_author(Some(invalid)),","+            Err(AutomergeError::SigningAuthor(_))","+        ));","+    }","+    assert_eq!(format!(\"{doc:?}\"), before);","+}","+","+#[test]","+fn fully_published_fork_with_a_new_author_keeps_the_old_proofs() {","+    let k = key(7);","+    let k2 = key(8);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+    assert!(is_published(&mut doc, &a));","+","+    let mut fork = doc.fork_with_author(Some(author(&k2))).unwrap();","+    assert_eq!(fork.get_author(), Some(&author(&k2)));","+    assert_eq!(doc.get_author(), Some(&author(&k)));","+    assert!(fork.signing.is_required());","+    assert!(is_published(&mut fork, &a));","+    assert_eq!(","+        fork.get_change_by_hash(&a).unwrap().author(),","+        Some(author(&k))","+    );","+    assert!(drafts(&mut fork).is_empty());","+}","+","+#[test]","+fn fully_published_fork_with_a_new_author_uses_a_fresh_actor() {","+    let k = key(7);","+    let k2 = key(8);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+","+    let mut fork = doc.fork_with_author(Some(author(&k2))).unwrap();","+    assert_ne!(fork.get_actor(), doc.get_actor());","+","+    let b = append_at_level(&mut fork, None, 2, 0);","+    let change = fork.get_change_by_hash(&b).unwrap();","+    assert_eq!(change.author(), Some(author(&k2)));","+    assert_ne!(change.actor_id(), &ActorId::from([1]));","+    assert_eq!(drafts(&mut fork), [b]);","+    assert!(fork.has_unpublished_changes());","+}","+","+#[test]","+fn forked_author_work_is_signed_only_by_the_new_author() {","+    let k = key(7);","+    let k2 = key(8);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+    let mut fork = doc.fork_with_author(Some(author(&k2))).unwrap();","+    let b = append_at_level(&mut fork, None, 2, 0);","+","+    // The old author cannot sign the new author's change.","+    assert!(insert_one(&mut fork, b, &sig(&k, &b)).is_err());","+    fork.insert_signatures([(b, sig(&k2, &b))]);","+    assert!(is_published(&mut fork, &b));","+}","+","+#[test]","+fn both_authors_proofs_verify_on_reload_of_the_published_fork() {","+    let k = key(7);","+    let k2 = key(8);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+    let mut fork = doc.fork_with_author(Some(author(&k2))).unwrap();","+    let b = append_at_level(&mut fork, None, 2, 0);","+    fork.insert_signatures([(b, sig(&k2, &b))]);","+","+    let bytes = fork.bundle_fragments(fork.fragments(..)).concat();","+    let mut reloaded = Automerge::load_with_options(","+        &bytes,","+        LoadOptions::new().signing(author(&key(200))).unwrap(),","+    )","+    .unwrap();","+    assert_eq!(reloaded.get_heads(), fork.get_heads());","+    assert!(is_published(&mut reloaded, &a));","+    assert!(is_published(&mut reloaded, &b));","+}","+","+#[test]","+fn the_source_admits_the_new_authors_work_when_it_is_delivered_later() {","+    let k = key(7);","+    let k2 = key(8);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+    let mut fork = doc.fork_with_author(Some(author(&k2))).unwrap();","+    let b = append_at_level(&mut fork, None, 2, 0);","+    fork.insert_signatures([(b, sig(&k2, &b))]);","+","+    let b_bytes = attach(","+        fork.get_change_by_hash(&b).unwrap().raw_bytes(),","+        [(b, Signature::ed25519(sig(&k2, &b)))],","+    );","+    doc.load_incremental(&b_bytes).unwrap();","+    assert!(is_published(&mut doc, &b));","+    assert_eq!(doc.get_heads(), fork.get_heads());","+}","+","+#[test]","+fn unsigned_fork_removes_the_author_freely() {","+    let mut doc = unsigned_doc(Author::from(vec![1, 2, 3]));","+    append_at_level(&mut doc, None, 1, 0);","+","+    let removed = doc.fork_with_author(None).unwrap();","+    assert!(removed.get_author().is_none());","+    assert!(!removed.signing.is_required());","+}","+","+#[test]","+fn unsigned_fork_replaces_the_author_freely() {","+    let arbitrary = Author::from(vec![1, 2, 3]);","+    let mut doc = unsigned_doc(arbitrary.clone());","+    append_at_level(&mut doc, None, 1, 0);","+","+    let replaced = doc.fork_with_author(Some(weak_author())).unwrap();","+    assert_eq!(replaced.get_author(), Some(&weak_author()));","+    assert_ne!(replaced.get_actor(), doc.get_actor());","+    assert_eq!(doc.get_author(), Some(&arbitrary));","+}","+","+#[test]","+fn incoming_pending_groups_do_not_block_a_new_author_fork() {","+    let k = key(7);","+    let k2 = key(8);","+    let mut doc = signing_doc(&k, 1);","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+","+    // A foreign author extends `a` twice on an unsigned replica of the same","+    // history; only the tip is delivered, so it must wait for `b`.","+    let mut remote = Automerge::from_config(crate::Config::default().author(Some(author(&k2))))","+        .with_actor(ActorId::from([2]))","+        .unwrap();","+    remote","+        .apply_changes([doc.get_change_by_hash(&a).unwrap()])","+        .unwrap();","+    let b = append_at_level(&mut remote, None, 2, 0);","+    let c = append_at_level(&mut remote, None, 3, 0);","+    let c_bytes = attach(","+        remote.get_change_by_hash(&c).unwrap().raw_bytes(),","+        [(c, Signature::ed25519(sig(&k2, &c)))],","+    );","+    assert_eq!(doc.load_incremental(&c_bytes).unwrap(), 0);","+    assert!(doc.signing.has_pending_groups());","+    assert!(drafts(&mut doc).is_empty());","+","+    let k3 = key(9);","+    let mut fork = doc.fork_with_author(Some(author(&k3))).unwrap();","+    assert_eq!(fork.get_author(), Some(&author(&k3)));","+    assert!(fork.signing.has_pending_groups());","+    // The retained group still completes once `b` arrives.","+    let b_bytes = attach(","+        remote.get_change_by_hash(&b).unwrap().raw_bytes(),","+        [(b, Signature::ed25519(sig(&k2, &b)))],","+    );","+    fork.load_incremental(&b_bytes).unwrap();","+    assert!(is_published(&mut fork, &b));","+    assert!(is_published(&mut fork, &c));","+}","+","+#[test]","+fn required_mode_automerge_fork_at_is_unsupported() {","+    let k = key(7);","+    let mut doc = Automerge::from_config(crate::Config::default().signing(author(&k)).unwrap());","+    let a = append_at_level(&mut doc, None, 1, 0);","+    doc.insert_signatures([(a, sig(&k, &a))]);","+    assert!(matches!(","+        doc.fork_at(&[a]),","+        Err(AutomergeError::Signing(SigningError::ForkAtNotSupported))","+    ));","+}","+","+#[test]","+fn required_mode_autocommit_fork_at_is_unsupported_and_keeps_the_transaction_open() {","+    let k = key(7);","+    let mut auto = AutoCommit::from_config(crate::Config::default().signing(author(&k)).unwrap());","+    auto.put(ROOT, \"pending\", 1).unwrap();","+    assert!(matches!(","+        auto.fork_at(&[]),","+        Err(AutomergeError::Signing(SigningError::ForkAtNotSupported))","+    ));","+    assert_eq!(auto.pending_ops(), 1, \"transaction stays open\");","+    assert!(!auto.has_unpublished_changes(), \"nothing was committed\");","+}","+","+#[test]","+fn unsigned_autocommit_fork_at_commits_pending_edits_first() {","+    let mut unsigned = AutoCommit::new();","+    unsigned.put(ROOT, \"pending\", 1).unwrap();","+    let mut fork = unsigned.fork_at(&[]).unwrap();","+    assert_eq!(unsigned.pending_ops(), 0);","+    assert_eq!(unsigned.get_heads().len(), 1);","+    assert!(fork.get_heads().is_empty());","+}"]