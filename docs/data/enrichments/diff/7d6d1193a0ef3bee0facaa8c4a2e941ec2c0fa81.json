{"id":"7d6d1193a0ef3bee0facaa8c4a2e941ec2c0fa81","axis":"silent","repo":"open-telemetry/opentelemetry-collector","sha":"7d6d1193a0ef3bee0facaa8c4a2e941ec2c0fa81","parsed":{"files":[{"path":".chloggen/pprofile-locationindices-bounds.yaml","lines":["@@ -0,0 +1,30 @@","+# Use this changelog template to create an entry for release notes.","+","+# One of 'breaking', 'deprecation', 'new_component', 'enhancement', 'bug_fix'","+change_type: bug_fix","+","+# The name of the component, or a single word describing the area of concern, (e.g. receiver/otlp)","+component: pkg/pprofile","+","+# A brief description of the change.  Surround your text with quotes (\"\") if it needs to start with a backtick (`).","+note: add bounds checks to FromLocationIndices and switchDictionary","+","+# One or more tracking issues or pull requests related to the change","+issues: [15697]","+","+# (Optional) One or more lines of additional information to render under the primary note.","+# These lines will be padded with 2 spaces and then inserted directly into the document.","+# Use pipe (|) for multiline entries.","+subtext: |","+  FromLocationIndices now returns an error instead of panicking on an out-of-range or","+  negative location index, mirroring FromAttributeIndices.","+  The index checks used when merging profiles now also reject negative indices. These","+  were previously reachable with a negative index decoded from an OTLP payload, which","+  panicked the collector via Profiles.MergeTo.","+","+# Optional: The change log or logs in which this entry should be included.","+# e.g. '[user]' or '[user, api]'","+# Include 'user' if the change is relevant to end users.","+# Include 'api' if there is a change to a library API.","+# Default: '[user]'","+change_logs: [user, api]"],"additions":30,"deletions":0,"truncated":false},{"path":"pdata/pprofile/location.go","lines":["@@ -30,7 +30,7 @@ func (ms Location) switchDictionary(src, dst ProfilesDictionary) error {"," \t}"," "," \tfor i, v := range ms.AttributeIndices().All() {","-\t\tif src.AttributeTable().Len() <= int(v) {","+\t\tif v < 0 || src.AttributeTable().Len() <= int(v) {"," \t\t\treturn fmt.Errorf(\"invalid attribute index %d\", v)"," \t\t}"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pdata/pprofile/location_test.go","lines":["@@ -261,6 +261,29 @@ func TestLocationSwitchDictionary(t *testing.T) {"," \t\t\twantDictionary: NewProfilesDictionary(),"," \t\t\twantErr:        errors.New(\"invalid attribute index 2\"),"," \t\t},","+\t\t{","+\t\t\tname: \"with a negative attribute index\",","+\t\t\tlocation: func() Location {","+\t\t\t\tl := NewLocation()","+\t\t\t\tl.AttributeIndices().Append(-1)","+\t\t\t\treturn l","+\t\t\t}(),","+","+\t\t\tsrc: func() ProfilesDictionary {","+\t\t\t\td := NewProfilesDictionary()","+\t\t\t\td.AttributeTable().AppendEmpty()","+\t\t\t\treturn d","+\t\t\t}(),","+\t\t\tdst: NewProfilesDictionary(),","+","+\t\t\twantLocation: func() Location {","+\t\t\t\tl := NewLocation()","+\t\t\t\tl.AttributeIndices().Append(-1)","+\t\t\t\treturn l","+\t\t\t}(),","+\t\t\twantDictionary: NewProfilesDictionary(),","+\t\t\twantErr:        errors.New(\"invalid attribute index -1\"),","+\t\t},"," \t\t{"," \t\t\tname: \"with an existing line\","," \t\t\tlocation: func() Location {"],"additions":23,"deletions":0,"truncated":false},{"path":"pdata/pprofile/locations.go","lines":["@@ -5,21 +5,25 @@ package pprofile // import \"go.opentelemetry.io/collector/pdata/pprofile\""," "," import ("," \t\"errors\"","+\t\"fmt\""," \t\"math\""," )"," "," // FromLocationIndices builds a slice containing all the locations of a Stack."," // Updates made to the returned map will not be applied back to the Stack.","-func FromLocationIndices(table LocationSlice, record Stack) LocationSlice {","+func FromLocationIndices(table LocationSlice, record Stack) (LocationSlice, error) {"," \tm := NewLocationSlice()"," \tm.EnsureCapacity(record.LocationIndices().Len())"," "," \tfor _, idx := range record.LocationIndices().All() {","+\t\tif idx < 0 || int(idx) >= table.Len() {","+\t\t\treturn m, fmt.Errorf(\"location index %d out of bounds [0, %d)\", idx, table.Len())","+\t\t}"," \t\tl := table.At(int(idx))"," \t\tl.CopyTo(m.AppendEmpty())"," \t}"," ","-\treturn m","+\treturn m, nil"," }"," "," var errTooManyLocationTableEntries = errors.New(\"too many entries in LocationTable\")"],"additions":6,"deletions":2,"truncated":false},{"path":"pdata/pprofile/locations_test.go","lines":["@@ -18,12 +18,14 @@ func TestFromLocationIndices(t *testing.T) {"," \ttable.AppendEmpty().SetAddress(2)"," "," \tstack := NewStack()","-\tlocs := FromLocationIndices(table, stack)","+\tlocs, err := FromLocationIndices(table, stack)","+\trequire.NoError(t, err)"," \tassert.Equal(t, locs, NewLocationSlice())"," "," \t// Add a location"," \tstack.LocationIndices().Append(0)","-\tlocs = FromLocationIndices(table, stack)","+\tlocs, err = FromLocationIndices(table, stack)","+\trequire.NoError(t, err)"," "," \ttLoc := NewLocationSlice()"," \ttLoc.AppendEmpty().SetAddress(1)","@@ -32,8 +34,21 @@ func TestFromLocationIndices(t *testing.T) {"," \t// Add another location"," \tstack.LocationIndices().Append(1)"," ","-\tlocs = FromLocationIndices(table, stack)","+\tlocs, err = FromLocationIndices(table, stack)","+\trequire.NoError(t, err)"," \tassert.Equal(t, table, locs)","+","+\t// Out-of-bounds location index","+\toob := NewStack()","+\toob.LocationIndices().Append(int32(table.Len()))","+\t_, err = FromLocationIndices(table, oob)","+\trequire.ErrorContains(t, err, \"out of bounds\")","+","+\t// Negative location index","+\tneg := NewStack()","+\tneg.LocationIndices().Append(-1)","+\t_, err = FromLocationIndices(table, neg)","+\tassert.ErrorContains(t, err, \"out of bounds\")"," }"," "," func TestSetLocation(t *testing.T) {","@@ -90,7 +105,7 @@ func BenchmarkFromLocationIndices(b *testing.B) {"," \tb.ReportAllocs()"," "," \tfor b.Loop() {","-\t\t_ = FromLocationIndices(table, obj)","+\t\t_, _ = FromLocati