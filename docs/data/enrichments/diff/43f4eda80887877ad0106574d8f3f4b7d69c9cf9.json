o draft depth disables speculative decoding\",","+\t\t\tdraftType: draftTypeDFlash,","+\t\t\tdraftPath: \"draft.gguf\",","+\t\t\topts:      api.Options{Runner: api.Runner{DraftNumPredict: 0}},","+\t\t\twant:      []string{\"base\"},"," \t\t},"," \t}"," "," \tfor _, tt := range tests {"," \t\tt.Run(tt.name, func(t *testing.T) {","-\t\t\tgot := appendMTPDraftArgs([]string{\"base\"}, tt.config, tt.opts)","+\t\t\tgot := appendDraftArgs([]string{\"base\"}, tt.draftType, tt.draftPath, tt.opts)"," \t\t\tif !slices.Equal(got, tt.want) {","-\t\t\t\tt.Fatalf(\"appendMTPDraftArgs = %v, want %v\", got, tt.want)","+\t\t\t\tt.Fatalf(\"appendDraftArgs = %v, want %v\", got, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestExternalDraftType(t *testing.T) {","+\ttests := []struct {","+\t\tarchitecture string","+\t\twant         string","+\t}{","+\t\t{architecture: \"dflash\", want: draftTypeDFlash},","+\t\t{architecture: \"qwen35\", want: draftTypeMTP},","+\t\t{architecture: \"unknown\", want: draftTypeMTP},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.architecture, func(t *testing.T) {","+\t\t\tpath, _ := writeTestGGML(t, ggml.KV{\"general.architecture\": tt.architecture}, nil)","+\t\t\tgot, err := externalDraftType(path)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t\tif got != tt.want {","+\t\t\t\tt.Fatalf(\"externalDraftType = %q, want %q\", got, tt.want)"," \t\t\t}"," \t\t})"," \t}"],"additions":53,"deletions":19,"truncated":false},{"path":"model/parsers/glimmer.go","lines":["@@ -0,0 +1,516 @@","+package parsers","+","+import (","+\t\"fmt\"","+\t\"log/slog\"","+\t\"strings\"","+","+\t\"github.com/ollama/ollama/api\"","+)","+","+const (","+\tglimmerStartTag      = \"<|start|>\"","+\tglimmerMessageTag    = \"<|message|>\"","+\tglimmerEndMessageTag = \"<|eom|>\"","+\tglimmerEndTurnTag    = \"<|eot|>\"","+","+\tglimmerAssistantHeaderPrefix = glimmerStartTag + \"assistant\"","+","+\tglimmerATEMCallsOpen   = \"<atem:function_calls>\"","+\tglimmerATEMCallsClose  = \"</atem:function_calls>\"","+\tglimmerATEMInvokeOpen  = `<atem:invoke name=\"`","+\tglimmerATEMInvokeClose = \"</atem:invoke>\"","+\tglimmerATEMParamOpen   = `<atem:parameter name=\"`","+\tglimmerATEMParamClose  = \"</atem:parameter>\"","+)","+","+type glimmerParserState int","+","+const (","+\tglimmerParserHeader glimmerParserState = iota","+\tglimmerParserContent","+\tglimmerParserThinking","+\tglimmerParserTool","+)","+","+type GlimmerParser struct {","+\tstate        glimmerParserState","+\tbuffer       strings.Builder","+\trecipient    string","+\ttools        map[string]api.Tool","+\tcallIndex    int","+\temitThinking bool","+","+\t// contentStreamed records whether any of the current message's body has","+\t// already been emitted as content. The fumbled-recipient tool-call","+\t// fallback only applies while nothing has streamed, so a message either","+\t// becomes a tool call or streams as content — never half of each.","+\tcontentStreamed bool","+}","+","+func (p *GlimmerParser) HasToolSupport() bool     { return true }","+func (p *GlimmerParser) HasThinkingSupport() bool { return true }","+","+func (p *GlimmerParser) PreservedTokens() []string {","+\treturn []string{glimmerStartTag, glimmerMessageTag, glimmerEndMessageTag, glimmerEndTurnTag}","+}","+","+func (p *GlimmerParser) Init(tools []api.Tool, lastMessage *api.Message, thinkValue *api.ThinkValue) []api.Tool {","+\tp.state = glimmerParserHeader","+\tp.buffer.Reset()","+\tp.recipient = \"\"","+\tp.tools = glimmerToolsByName(tools)","+\tp.callIndex = 0","+\tp.emitThinking = thinkValue == nil || thinkValue.Bool()","+\tp.contentStreamed = false","+\treturn tools","+}","+","+func (p *GlimmerParser) Add(s string, done bool) (content string, thinking string, calls []api.ToolCall, err error) {","+\tp.buffer.WriteString(s)","+\tvar contentSB, thinkingSB strings.Builder","+","+\tfor {","+\t\tif p.state == glimmerParserHeader {","+\t\t\tprogress, fallback := p.consumeHeader(done)","+\t\t