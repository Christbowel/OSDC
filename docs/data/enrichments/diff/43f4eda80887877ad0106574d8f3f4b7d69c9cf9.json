e/color\"","+\t\"image/draw\"","+\t\"image/png\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/ollama/ollama/api\"","+\t\"golang.org/x/image/font\"","+\t\"golang.org/x/image/font/gofont/goregular\"","+\t\"golang.org/x/image/font/opentype\"","+\t\"golang.org/x/image/math/fixed\"","+)","+","+const visionOCRReference = \"HARBOR-DELTA-8061\"","+","+func registerVisionOCRDocumentCases(models []string) {","+\tregisterModelIntegrationCases(\"vision-ocr-document\", models, runVisionOCRDocument)","+}","+","+func runVisionOCRDocument(t *testing.T, model string) {","+\tt.Helper()","+","+\tskipUnderMinVRAM(t, 8)","+\tskipKnownIntegrationFlake(t, \"vision-ocr-document\", model)","+\tctx, cancel := context.WithTimeout(t.Context(), 5*time.Minute)","+\tdefer cancel()","+\tclient, _, cleanup := InitServerConnection(ctx, t)","+\tdefer cleanup()","+","+\trequireCapability(ctx, t, client, model, \"vision\")","+\tpullOrSkip(ctx, t, client, model)","+","+\tdocument, err := visionOCRDocument()","+\tif err != nil {","+\t\tt.Fatal(err)","+\t}","+\treq := api.ChatRequest{","+\t\tModel: model,","+\t\tMessages: []api.Message{","+\t\t\t{","+\t\t\t\tRole: \"user\",","+\t\t\t\tContent: \"Scan the entire document and read the unique FINAL AUDIT CODE field. \" +","+\t\t\t\t\t\"Reply with only its value.\",","+\t\t\t\tImages: []api.ImageData{document},","+\t\t\t},","+\t\t},","+\t\tStream: &stream,","+\t\tOptions: map[string]any{","+\t\t\t\"seed\":        42,","+\t\t\t\"temperature\": 0.0,","+\t\t},","+\t\tKeepAlive: &api.Duration{Duration: 10 * time.Second},","+\t}","+","+\tpreloadGenerateModel(ctx, t, client, api.GenerateRequest{Model: req.Model})","+\tskipIfNotGPULoaded(ctx, t, client, req.Model, 80)","+","+\t// The shared response normalization collapses whitespace runs but keeps","+\t// single spaces, and quantized models occasionally split the code with a","+\t// stray space (\"HARBO R-...\"). Accept any stream and compare with all","+\t// whitespace removed instead — every glyph still has to be right.","+\tmsg := DoChat(ctx, t, client, req, []string{\"\"}, 240*time.Second, 30*time.Second)","+\tif msg == nil {","+\t\treturn","+\t}","+\tdespace := func(s string) string { return strings.Join(strings.Fields(s), \"\") }","+\tif !strings.Contains(despace(msg.Content), despace(visionOCRReference)) {","+\t\tt.Fatalf(\"%s: audit code %q not found in %q\", model, visionOCRReference, msg.Content)","+\t}","+}","+","+func visionOCRDocument() ([]byte, error) {","+\tconst (","+\t\ttileWidth  = 800","+\t\ttileHeight = 800","+\t\tcolumns    = 3","+\t\trows       = 4","+\t)","+","+\tparsedFont, err := opentype.Parse(goregular.TTF)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"parse document font: %w\", err)","+\t}","+\tbodyFace, err := opentype.NewFace(parsedFont, &opentype.FaceOptions{","+\t\tSize:    40,","+\t\tDPI:     72,","+\t\tHinting: font.HintingFull,","+\t})","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"create document font: %w\", err)","+\t}","+\treferenceFace, err := opentype.NewFace(parsedFont, &opentype.FaceOptions{","+\t\tSize:    48,","+\t\tDPI:     72,","+\t\tHinting: font.HintingFull,","+\t})","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"create reference font: %w\", err)","+\t}","+","+\twhite := color.RGBA{R: 255, G: 255, B: 255, A: 255}","+\tink := image.NewUniform(color.RGBA{R: 24, G: 29, B: 36, A: 255})","+\trule := color.RGBA{R: 180, G: 186, B: 194, A: 255}","+\ttile := image.NewRGBA(image.Rect(0, 0, tileWidth, tileHeight))","+\tdraw.Draw(tile, tile.Bounds(), image.NewUniform(white), image.Point{}, draw.Src)","+\tdrawOCRRule(tile, image.Rect(40, 40, tileWidth-40, 44), rule)","+\tdrawOCRRule(tile, image.Rect(40, 130, tileWidth-40, 134), rule)","+\tdrawOCRRule(tile, image.Rect(40, 520, tileWidth-40, 524), rule)","+\tdrawOCRText(tile, bodyFace, ink, 48, 110, \"FIELD SERVICE RECORD\")","+\tdrawOCRText(tile, bodyFace, ink, 48, 220, \"Equipment: turbine assembly\")","+\tdrawOCRText(tile, bodyFace, ink, 48, 290, \"Inspection: pressure and seals\")","+\tdrawOCRText(tile, bodyFace, ink, 48, 360, \"Status: passed\")","+\tdrawOCRText(tile, bodyFace, ink, 48, 470, \"Technician notes: no defects\")","+","+\tpage := image.NewRGBA(image.Rect(0, 0, columns*tileWidth, rows*tileHeight))","+\tdraw.Draw(page, page.Bounds(), image.NewUniform(white), image.Point{}, draw.Src)","+\tfor row := range rows {","+\t\tfor column := range columns {","+\t\t\tcell := image.NewRGBA(tile.Bounds())","+\t\t\tdraw.Draw(cell, cell.Bounds(), tile, image.Point{}, draw.Src)","+\t\t\tdrawOCRText(cell, bodyFace, ink, 48, 190, fmt.Sprintf(\"ROW %d  COLUMN %d\", row+1, column+1))","+","+\t\t\tlabel := \"REFERENCE:\"","+\t\t\treference := fmt.Sprintf(\"CELL-R%d-C%d-%04d\", row+1, column+1, (row+1)*100+column+1)","+\t\t\tif row == rows-1 && column == columns-1 {","+\t\t\t\tlabel = \"FINAL AUDIT CODE:\"","+\t\t\t\treference = visionOCRReference","+\t\t\t}","+\t\t\tdrawOCRText(cell, referenceFace, ink, 48, 640, label)","+\t\t\tdrawOCRText(cell, referenceFace, ink, 48, 710, reference)","+","+\t\t\torigin := image.Pt(column*tileWidth, row*tileHeight)","+\t\t\tdraw.Draw(page, image.Rectangle{Min: origin, Max: origin.Add(cell.Bounds().Size())}, cell, image.Point{}, draw.Src)","+\t\t}","+\t}","+","+\tvar encoded bytes.Buffer","+\tif err := png.Encode(&encoded, page); err != nil {","+\t\treturn nil, fmt.Errorf(\"encode OCR document: %w\", err)","+\t}","+\treturn encoded.Bytes(), nil","+}","+","+func drawOCRText(dst draw.Image, face font.Face, source image.Image, x, y int, text string) {","+\tdrawer := font.Drawer{","+\t\tDst:  dst,","+\t\tSrc:  source,","+\t\tFace: face,","+\t\tDot:  fixed.P(x, y),","+\t}","+\tdrawer.DrawString(text)","+}","+","+func drawOCRRule(dst draw.Image, bounds image.Rectangle, fill color.Color) {","+\tdraw.Draw(dst, bounds, image.NewUniform(fill), image.Point{}, draw.Src)","+}"],"additions":166,"deletions":0,"truncated":false},{"path":"llm/llama_server.go","lines":["@@ -169,6 +169,7 @@ type llamaSe