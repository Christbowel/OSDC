yGetBackgroundColor(TerminalColor &color) {","+bool Terminal::TryGetBackgroundColor(TerminalColor &color, bool allow_probe) {"," #if defined(_WIN32) || defined(WIN32)"," \t// FIXME: always emit black background on Windows"," \tcolor.r = 0;","@@ -487,8 +487,16 @@ bool Terminal::TryGetBackgroundColor(TerminalColor &color) {"," \tif (TryGetBackgroundColorFromEnvironment(color)) {"," \t\treturn true;"," \t}","+\tif (!allow_probe) {","+\t\t// stdin is not read by the line editor - querying the terminal would swallow its input","+\t\treturn false;","+\t}","+\tif (rawmode) {","+\t\t// the line editor owns the terminal - probing would clobber the saved terminal settings","+\t\treturn false;","+\t}"," \tif (IsContinuousIntegrationEnvironment()) {","-\t\t// no terminal emulator is attached in CI","+\t\t// CI is conventionally non-interactive - opt out of probing"," \t\treturn false;"," \t}"," \tauto term = getenv(\"TERM\");","@@ -496,7 +504,7 @@ bool Terminal::TryGetBackgroundColor(TerminalColor &color) {"," \t\t// no terminal that can answer the query"," \t\treturn false;"," \t}","-\t// buffer any available input - we need to interact with stdin","+\t// keep pending input for the line editor"," \tBufferAvailableInput();"," \tint ifd = STDIN_FILENO;"," \tint ofd = STDOUT_FILENO;"],"additions":11,"deletions":3,"truncated":false},{"path":"tools/shell/shell.cpp","lines":["@@ -602,6 +602,8 @@ char *ShellState::OneInputLine(FILE *in, char *&zPrior, int isContinuation) {"," \t\t}"," \t\tfree(zPrior);"," \t\tzPrior = nullptr;","+\t\t// probing the terminal inside the line editor is not possible - detect before editing","+\t\tDetectDarkLightMode();"," \t\treturn linenoise(prompt_text);"," \t}"," #endif","@@ -3775,7 +3777,9 @@ void ShellState::DetectDarkLightMode() {"," \t\treturn;"," \t}"," \t// detect terminal colors","-\tauto terminal_color = linenoiseGetTerminalColorMode();","+\t// the terminal is not queried while stdin is read by the shell itself (-batch) - only COLORFGBG is used then","+\tauto terminal_color =","+\t    linenoiseGetTerminalColorMode(rl_version == ReadLineVersion::LINENOISE && (stdin_is_interactive || !readStdin));"," \tif (terminal_color == LINENOISE_DARK_MODE) {"," \t\thighlight_mode = HighlightMode::DARK_MODE;"," \t\thighlight.ToggleMode(HighlightMode::DARK_MODE);","@@ -3848,7 +3852,7 @@ int RunShell(int argc, const char **argv) {"," "," \tauto no_color = getenv(\"NO_COLOR\");"," \tif (no_color && no_color[0]) {","-\t\t// https://no-color.org - can still be turned on explicitly with .highlighting on","+\t\t// https://no-color.org - can still be turned on explicitly with .highlight on"," \t\tShellHighlight::SetHighlighting(false);"," \t}"," "],"additions":6,"deletions":2,"truncated":false},{"path":"tools/shell/tests/test_highlighting.py","lines":["@@ -6,6 +6,7 @@"," from typing import List"," from conftest import ShellTest"," import os","+import re"," "," lineitem_ddl = 'CREATE TABLE lineitem(l_orderkey BIGINT NOT NULL, l_partkey BIGINT NOT NULL, l_suppkey BIGINT NOT NULL, l_linenumber BIGINT NOT NULL, l_quantity DECIMAL(15,2) NOT NULL, l_extendedprice DECIMAL(15,2) NOT NULL, l_discount DECIMAL(15,2) NOT NULL, l_tax DECIMAL(15,2) NOT NULL, l_returnflag VARCHAR NOT NULL, l_linestatus VARCHAR NOT NULL, l_shipdate DATE NOT NULL, l_commitdate DATE NOT NULL, l_receiptdate DATE NOT NULL, l_shipinstruct VARCHAR NOT NULL, l_shipmode VARCHAR NOT NULL, l_comment VARCHAR NOT NULL);'"," ","@@ -183,4 +184,99 @@ def test_manual_uses_detected_color_mode(shell):","     assert status == 0, output","     assert output.count(b'\\x1b]11;?') == 1"," ","+def run_interactive_in_pty(shell, arguments, inputs, extra_env=None, no_color=None):","+    # runs the shell on a pseudo-terminal that answers the background color query, feeding each input after a pause","+    import pty, select, time, termios","+    master, slave = pty.openpty()","+    env = ShellTest(shell).get_environment()","+    for key in ('NO_COLOR', 'CI', 'COLORFGBG'):","+        env.pop(key, None)","+    env.update({'TERM': 'xterm-256color', 'COLUMNS': '80', 'ROWS': '24'})","+    env.update(extra_env or {})","+    if no_color is not None:","+        env['NO_COLOR'] = no_color","+    response = b'\\x1b]11;rgb:ffff/ffff/ffff\\x07\\x1b[?62c'","+    process = subprocess.Popen([shell, '-no-init', *arguments], stdin=slave, stdout=slave, stderr=slave, env=env)","+    os.close(slave)","+    output = b''","+    probes = 0","+    start = time.monotonic()","+    pending = list(inputs)","+    last_activity = time.monotonic()","+    try:","+        while process.poll() is None and time.monotonic() - start < 30:","+            if select.select([master], [], [], 0.05)[0]:","+                try:","+                    chunk = os.read(master, 4096)","+                except OSError:","+                    break","+                output += chunk","+                last_activity = time.monotonic()","+                if output.count(b'\\x1b]11;?') > probes:","+                    probes = output.count(b'\\x1b]11;?')","+                    os.write(master, response)","+            elif pending and time.monotonic() - last_activity > 0.7:","+                os.write(master, pending.pop(0))","+                last_activity = time.monotonic()","+        try:","+            process.wait(timeout=5)","+        except subprocess.TimeoutExpired:","+            process.kill()","+            process.wait()","+        flags = termios.tcgetattr(master)","+    finally:","+        if process.poll() is None:","+            process.kill()","+            process.wait()","+        os.close(master)","+    return process.returncode, output, flags","+","+def check_terminal_restored(flags):","+    import termios","+    assert flags[3] & termios.ECHO","+    assert flags[3] & termios.ICANON","+    assert flags[1] & termios.OPOST","+","+SGR = re.compile(rb'\\x1b\\[[0-9;]*m')","+","+# the pseudo-terminal echoes the input, so the tests only look for results that are not part of the input","+@pytest.mark.skipif(os.name == 'nt', reason=\"requires a POSIX pseudo-terminal\")","+@pytest.mark.parametrize(\"setup,no_color\", [","+    (b\".highlight on\\n\", '1'),","+    (b\".highlight_mode dark\\n.highlight_mode auto\\n\", None),","+])","+def test_repl_restores_terminal_after_lazy_probe(shell, setup, no_color):","+    # NO_COLOR disables highlighting at startup, so the first probe only happens after the setting changes","+    status, output, flags = run_interactive_in_pty(shell, [], [b\".prompt 'D '\\n\", setup, b\"SELECT 40+2;\\n\", b\".quit\\n\"], no_color=no_color)","+    assert status == 0, output","+    assert b'42' in output.replace(b'40+2', b'')","+    check_terminal_restored(flags)","+","+@pytest.mark.skipif(os.name == 'nt', reason=\"requires a POSIX pseudo-terminal\")","+def test_repl_detects_colors_up_front(shell):","+    status, output, flags = run_interactive_in_pty(shell, [], [b\"SELECT 40+2;\\n\", b\".quit\\n\"])","+    assert status == 0, output","+    assert output.count(b'\\x1b]11;?') == 1","+    assert b'42' in output.replace(b'40+2', b'')","+    check_terminal_restored(flags)","+","+@pytest.mark.skipif(os.name == 'nt', reason=\"requires a POSIX pseudo-terminal\")","+@pytest.mark.parametrize(\"arguments\", [[], ['-csv'], ['-cmd', 'SELECT 1;']])","+def test_batch_on_terminal_keeps_pasted_input(shell, arguments):","+    # batch mode reads stdin through stdio - the terminal must never be queried","+    status, output, _ = run_interactive_in_pty(shell, ['-batch', *arguments], [b\"SELECT 100+11 AS a;\\nSELECT 200+22 AS b;\\n\", b\"\\x04\"])","+    assert status == 0, output","+    assert output.count(b'\\x1b]11;?') == 0","+    assert b'111' in output.replace(b'100+11', b'')","+    assert b'222' in output.replace(b'200+22', b'')","+","+@pytest.mark.skipif(os.name == 'nt', reason=\"requires a POSIX pseudo-terminal\")","+def test_no_color_can_be_overridden_by_highlight_on(shell):","+    status, output, _ = run_interactive_in_pty(shell, ['-batch'], [b\".highlight on\\nSELECT 100+11 AS a;\\nSELECT 200+22 AS b;\\n\", b\"\\x04\"], no_color='1')","+    assert status == 0, output","+    assert output.count(b'\\x1b]11;?') == 0","+    assert b'111' in output.replace(b'100+11', b'')","+    assert b'222' in output.replace(b'200+22', b'')","+    assert SGR.search(output)","+"," # fmt: on",""],"additions":96,"deletions":0,"truncated":false}],"additions":117,"deletions":9,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-04T16:06:54.075134+00:00"}