uted with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.pinot.common.utils;","+","+import com.google.common.annotations.VisibleForTesting;","+import io.netty.buffer.ByteBuf;","+import io.netty.buffer.PooledByteBufAllocator;","+import io.netty.util.internal.PlatformDependent;","+import java.util.concurrent.atomic.AtomicLong;","+import javax.annotation.Nullable;","+import org.apache.arrow.memory.AllocationManager;","+import org.apache.arrow.memory.ArrowBuf;","+import org.apache.arrow.memory.BufferAllocator;","+import org.apache.arrow.memory.OutOfMemoryException;","+import org.apache.arrow.memory.ReferenceManager;","+import org.apache.arrow.memory.RootAllocator;","+","+import static com.google.common.base.Preconditions.checkArgument;","+","+","+/// Creates Arrow allocators with a shared allocation budget and Netty-backed, int-sized buffers.","+///","+/// The budget uses Netty's existing direct-memory ceiling. Int-sized allocations also participate in","+/// Netty's direct-memory counter, preserving the limit shared with transport buffers without relying","+/// on Arrow 19's private Netty buffer casts. Larger allocations retain Arrow's raw-memory path but","+/// now count against the shared Arrow budget; that path is separate from Netty's counter.","+///","+/// Callers still own their root allocator and retain their existing per-allocator limit. Children","+/// inherit the allocation manager. Allocations through other factories or native Arrow libraries","+/// are outside this budget.","+public final class ArrowAllocators {","+  private static final long MAX_ALLOCATION = PlatformDependent.maxDirectMemory();","+  private static final AtomicLong ALLOCATED_MEMORY = new AtomicLong();","+  private static final ArrowBuf EMPTY_BUFFER = new ArrowBuf(ReferenceManager.NO_OP, null, 0, 0);","+  private static final AllocationManager.Factory ALLOCATION_MANAGER_FACTORY = new AllocationManager.Factory() {","+    @Override","+    public AllocationManager create(BufferAllocator allocator, long size) {","+      reserve(size);","+      try {","+        return new NettyAllocationManager(allocator, size);","+      } catch (RuntimeException | Error e) {","+        ALLOCATED_MEMORY.addAndGet(-size);","+        if (e instanceof OutOfMemoryError) {","+          throw new OutOfMemoryException(\"Failure allocating buffer.\", e);","+        }","+        throw e;","+      }","+    }","+","+    @Override","+    public ArrowBuf empty() {","+      return EMPTY_BUFFER;","+    }","+  };","+","+  private ArrowAllocators() {","+  }","+","+  /// Creates a caller-owned root with the supplied accounting limit and the shared physical allocation budget.","+  public static RootAllocator newRootAllocator(long maxAllocation) {","+    return new RootAllocator(RootAllocator.configBuilder().maxAllocation(maxAllocation)","+        .allocationManagerFactory(ALLOCATION_MANAGER_FACTORY).build());","+  }","+","+  private static void reserve(long size) {","+    checkArgument(size >= 0, \"Allocation size must be non-negative: %s\", size);","+    long allocated;","+    do {","+      allocated = ALLOCATED_MEMORY.get();","+      if (size > MAX_ALLOCATION - allocated) {","+        throw new OutOfMemoryException(\"Arrow allocation of \" + size + \" bytes exceeds the shared limit of \"","+            + MAX_ALLOCATION + \" bytes (already allocated: \" + allocated + \").\");","+      }","+    } while (!ALLOCATED_MEMORY.compareAndSet(allocated, allocated + size));","+  }","+","+  @VisibleForTesting","+  static long getAllocatedMemory() {","+    return ALLOCATED_MEMORY.get();","+  }","+","+  /// Owns one physical allocation until the final Arrow reference is released.","+  private static final class NettyAllocationManager extends AllocationManager {","+    private final long _size;","+    private final long _address;","+    @Nullable","+    private final ByteBuf _buffer;","+","+    private NettyAllocationManager(BufferAllocator allocator, long size) {","+      super(allocator);","+      _size = size;","+      if (size > Integer.MAX_VALUE) {","+        _buffer = null;","+        _address = PlatformDependent.allocateMemory(size);","+      } else {","+        ByteBuf buffer = PooledByteBufAllocator.DEFAULT.directBuffer((int) size, (int) size);","+        try {","+          _address = buffer.memoryAddress();","+        } catch (RuntimeException | Error e) {","+          buffer.release();","+          throw e;","+        }","+        _buffer = buffer;","+      }","+    }","+","+    @Override","+    public long getSize() {","+      return _size;","+    }","+","+    @Override","+    protected long memoryAddress() {","+      return _address;","+    }","+","+    @Override","+    protected void release0() {","+      if (_buffer != null) {","+        _buffer.release();","+      } else {","+        PlatformDependent.freeMemory(_address);","+      }","+      ALLOCATED_MEMORY.addAndGet(-_size);","+    }","+  }","+}"],"additions":143,"deletions":0,"truncated":false},{"path":"pinot-common/src/main/java/org/apache/pinot/common/utils/ServiceStartableUtils.java","lines":["@@ -27,6 +27,7 @@"," import org.apache.helix.zookeeper.datamodel.serializer.ZNRecordSerializer;"," import org.apache.helix.zookeeper.impl.client.ZkClient;"," import org.apache.pinot.common.utils.request.RequestUtils;","+import org.apache.pinot.common.utils.tls.ZooKeeperSslContextSupplier;"," import org.apache.pinot.segment.spi.index.ForwardIndexConfig;"," import org.apache.pinot.spi.config.table.FieldConfig.CompressionCodec;"," import org.apache.pinot.spi.data.FieldSpec;","@@ -56,6 +57,7 @@ private ServiceStartableUtils() {","   /// - pinot.all.\\* will be replaced to role specific config, e.g. pinot.controller.\\* for controllers","   public static void applyClusterConfig(PinotConfiguration instanceConfig, String zkAddress, String clusterName,","       ServiceRole serviceRole) {","+    ZooKeeperSslContextSupplier.initialize();","     int zkClientSessionConfig =","         instanceConfig.getProperty(CommonConstants.Helix.ZkClient.ZK_CLIENT_SESSION_TIMEOUT_MS_CONFIG,","             CommonConstants.Helix.ZkClient.DEFAULT_SESSION_TIMEOUT_MS);"],"additions":2,"deletions":0,"truncated":false},{"path":"pinot-common/src/main/java/org/apache/pinot/common/utils/helix/HelixHelper.java","lines":["@@ -33,6 +33,8 @@"," import org.apache.helix.HelixAdmin;"," import org.apache.helix.HelixDataAccessor;"," import org.apache.helix.HelixManager;","+import org.apache.helix.HelixManagerFactory;","+import org.apache.helix.InstanceType;"," import org.apache.helix.PropertyKey.Builder;"," import org.apache.helix.model.ExternalView;"," import org.apache.helix.model.HelixConfigScope;","@@ -46,6 +48,7 @@"," import org.apache.pinot.common.helix.ExtraInstanceConfig;"," import org.apache.pinot.common.metadata.ZKMetadataProvider;"," import org.apache.pinot.common.utils.config.TagNameUtils;","+import org.apache.pinot.common.utils.tls.ZooKeeperSslContextSupplier;"," import org.apache.pinot.common.version.PinotVersion;"," import org.apache.pinot.common.workload.WorkloadChangeListener;"," import org.apache.pinot.spi.config.table.TableConfig;","@@ -78,6 +81,14 @@ private HelixHelper() {"," ","   public static final String BROKER_RESOURCE = CommonConstants.Helix.BROKER_RESOURCE_INSTANCE;"," ","+  /// Creates a ZooKeeper-backed manager with Pinot's TLS bootstrap policy applied before construction.","+  /// Callers retain responsibility for the manager's connect/disconnect lifecycle.","+  public static HelixManager createZkHelixManager(String clusterName, String instanceName, InstanceType instanceType,","+      String zkAddress) {","+    ZooKeeperSslContextSupplier.initialize();","+    return HelixManagerFactory.getZKHelixManager(clusterName, instanceName, instanceType, zkAddress);","+  }","+","   public static IdealState cloneIdealState(IdealState idealState) {","     return new IdealState(","         (ZNRecord) ZN_RECORD_SERIALIZER.deserialize(ZN_RECORD_SERIALIZER.serialize(idealState.getRecord())));"],"additions":11,"deletions":0,"truncated":false},{"path":"pinot-common/src/main/java/org/apache/pinot/common/utils/tls/TlsUtils.java","lines":["@@ -342,8 +342,11 @@ public static SslContext buildClientContext(TlsConfig tlsConfig) {","     SSLFactory sslFactory =","         RenewableTlsUtils.createSSLFactoryAndEnableAutoRenewalWhenUsingFileStores(","             tlsConfig, PinotInsecureMode::isPinotInInsecureMode);","-    SslContextBuilder sslContextBuilder =","-        SslContextBuilder.forClient().sslProvider(SslProvider.valueOf(tlsConfig.getSslProvider()));","+    // Keep Pinot's existing TLS behavior: verify certificate trust without hostname verification.","+    // Netty 4.2 enables hostname verification by default, which requires a peer hostname.","+    SslContextBuilder sslContextBuilder = SslContextBuilder.forClient()","+        .sslProvider(SslProvider.valueOf(tlsConfig.getSslProvider()))","+        .endpointIdentificationAlgorithm(null);","     sslFactory.getKeyManagerFactory().ifPresent(sslContextBuilder::keyManager);","     sslFactory.getTrustManagerFactory().ifPresent(sslContextBuilder::trustManager);"," "],"additions":5,"deletions":2,"truncated":false},{"path":"pinot-common/src/main/java/org/apache/pinot/common/utils/tls/ZooKeeperSslContextSupplier.java","lines":["@@ -0,0 +1,77 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.pinot.common.utils.tls;","+","+import io.netty.handler.ssl.CipherSuiteConverter;","+import java.util.Properties;","+import java.util.function.Supplier;","+import javax.net.ssl.SSLContext;","+import org.apache.zookeeper.common.ClientX509Util;","+import org.apache.zookeeper.common.X509Exception.SSLContextException;","+import org.apache.zookeeper.common.ZKConfig;","+","+","+/// Preserves disabled ZooKeeper hostname verification with Netty 4.2 using ZooKeeper's JDK context supplier hook.","+///","+/// Pinot's Helix clients use process-wide ZooKeeper TLS bootstrap properties. Call [#initialize()] before creating","+/// these clients; existing custom suppliers retain ownership of their context and provider. The vendor's no-argument","+/// supplier cannot consume arbitrary per-client TLS overrides, so it is intended for these bootstrap-owned clients.","+/// Each context uses ZooKeeper's configured stores, protocol, revocation and FIPS policy, without caching key material.","+public class ZooKeeperSslContextSupplier implements Supplier<SSLContext> {","+  /// Installs the JDK adapter only when bootstrap configuration explicitly disables hostname verification.","+  /// Enabled verification and custom suppliers keep their existing construction paths. TLS bootstrap configuration","+  /// must be supplied before client creation; it cannot be obtained from the cluster being connected to.","+  public static void initialize() {","+    Properties properties = System.getProperties();","+    synchronized (properties) {","+      try (ClientX509Util util = new ClientX509Util()) {","+        ZKConfig config = new ZKConfig();","+        if (util.isServerHostnameVerificationEnabled(config)","+            || config.getProperty(util.getSslContextSupplierClassProperty()) != null) {","+          return;","+        }","+        // The supplied JDK context needs JSSE names for ciphers previously configured for OpenSSL.","+        String cipherSuites = config.getProperty(util.getSslCipherSuitesProperty());","+        if (cipherSuites != null) {","+          String[] ciphers = cipherSuites.split(\",\", -1);","+          for (int i = 0; i < ciphers.length; i++) {","+            String javaCipher = CipherSuiteConverter.toJava(ciphers[i], \"TLS\");","+            if (javaCipher != null) {","+              ciphers[i] = javaCipher;","+            }","+          }","+          properties.setProperty(util.getSslCipherSuitesProperty(), String.join(\",\", ciphers));","+        }","+        // ZooKeeper 3.9.6 supports supplied SSLContext instances only with its JDK provider.","+        properties.setProperty(util.getSslProviderProperty(), \"JDK\");","+        properties.setProperty(util.getSslContextSupplierClassProperty(), ZooKeeperSslContextSupplier.class.getName());","+      }","+    }","+  }","+","+  @Override","+  public SSLContext get() {","+    try (ClientX509Util util = new ClientX509Util()) {","+      // Bypass supplier loading without temporarily removing the process-wide supplier property.","+      return util.createSSLContextAndOptionsFromConfig(new ZKConfig()).getSSLContext();","+    } catch (SSLContextException e) {","+      throw new IllegalStateException(\"Unable to create the ZooKeeper TLS context from bootstrap configuration\", e);","+    }","+  }","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"pinot-common/src/test/java/org/apache/pinot/common/utils/ArrowAllocatorsTest.java","lines":["@@ -0,0 +1,137 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.pinot.common.utils;","+","+import io.netty.buffer.ByteBuf;","+import io.netty.buffer.PooledByteBufAllocator;","+import java.nio.charset.StandardCharsets;","+import java.nio.file.Path;","+import java.util.Collections;","+import java.util.concurrent.TimeUnit;","+import org.apache.arrow.memory.ArrowBuf;","+import org.apache.arrow.memory.BufferAllocator;","+import org.apache.arrow.memory.OutOfMemoryException;","+import org.apache.arrow.memory.RootAllocator;","+import org.apache.pinot.common.response.broker.ResultTable;","+import org.apache.pinot.common.response.encoder.ArrowResponseEncoder;","+import org.apache.pinot.common.utils.DataSchema.ColumnDataType;","+import org.testng.annotations.Test;","+","+import static org.testng.Assert.assertEquals;","+import static org.testng.Assert.assertTrue;","+import static org.testng.Assert.expectThrows;","+","+","+/// Verifies allocation limits and encoder recovery in an isolated JVM.","+public class ArrowAllocatorsTest {","+  @Test","+  public void testProcessMemoryLimitAndEncoderRecovery()","+      throws Exception {","+    String classpath = System.getProperty(\"surefire.test.class.path\", System.getProperty(\"java.class.path\"));","+    Process process = new ProcessBuilder(Path.of(System.getProperty(\"java.home\"), \"bin\", \"java\").toString(),","+        \"-Xmx64m\", \"-XX:MaxDirectMemorySize=1m\", \"--add-opens=java.base/java.nio=ALL-UNNAMED\",","+        \"-Dio.netty.maxDirectMemory=1048576\", \"-Dio.netty.tryReflectionSetAccessible=true\",","+        \"-Dio.netty.allocator.numDirectArenas=1\", \"-Dio.netty.allocator.maxOrder=4\", \"-cp\", classpath,","+        MemoryLimitProbe.class.getName()).redirectErrorStream(true).start();","+    try {","+      assertTrue(process.waitFor(30, TimeUnit.SECONDS), \"Arrow memory limit probe timed out\");","+      String output = new String(process.getInputStream().readAllBytes(), StandardCharsets.UTF_8);","+      assertEquals(process.exitValue(), 0, output);","+    } finally {","+      process.destroyForcibly();","+    }","+  }","+","+  /// Exercises the production allocator and encoder in a JVM with a bounded direct-memory limit.","+  public static final class MemoryLimitProbe {","+    private MemoryLimitProbe() {","+    }","+","+    public static void main(String[] args)","+        throws Exception {","+      testSharedBudgetAndChildren();","+      testNettyBudgetAndRetainedReferences();","+      testEncoderRecovery();","+    }","+","+    private static void testSharedBudgetAndChildren() {","+      try (RootAllocator first = ArrowAllocators.newRootAllocator(Long.MAX_VALUE);","+          RootAllocator second = ArrowAllocators.newRootAllocator(Long.MAX_VALUE);","+          BufferAllocator child = first.newChildAllocator(\"query\", 0, Long.MAX_VALUE)) {","+        ArrowBuf firstBuffer = child.buffer(512 * 1024);","+        ArrowBuf secondBuffer = second.buffer(256 * 1024);","+        try {","+          assertEquals(ArrowAllocators.getAllocatedMemory(), 768 * 1024L);","+          expectThrows(OutOfMemoryException.class, () -> second.buffer(512 * 1024));","+          assertEquals(second.getAllocatedMemory(), 256 * 1024L);","+          firstBuffer.close();","+          firstBuffer = null;","+          try (ArrowBuf recovered = second.buffer(512 * 1024)) {","+            recovered.setLong(0, 42L);","+            assertEquals(recovered.getLong(0), 42L);","+            assertEquals(recovered.memoryAddress() % Long.BYTES, 0L);","+          }","+          expectThrows(OutOfMemoryException.class, () -> child.buffer((long) Integer.MAX_VALUE + 1));","+        } finally {","+          if (firstBuffer != null) {","+            firstBuffer.close();","+          }","+          secondBuffer.close();","+        }","+      }","+      assertEquals(ArrowAllocators.getAllocatedMemory(), 0L);","+    }","+","+    private static void testNettyBudgetAndRetainedReferences() {","+      try (RootAllocator allocator = ArrowAllocators.newRootAllocator(Long.MAX_VALUE)) {","+        ByteBuf occupied = PooledByteBufAllocator.DEFAULT.directBuffer(1024 * 1024, 1024 * 1024);","+        try {","+          expectThrows(OutOfMemoryException.class, () -> allocator.buffer(4096));","+          assertEquals(allocator.getAllocatedMemory(), 0L);","+          assertEquals(ArrowAllocators.getAllocatedMemory(), 0L);","+        } finally {","+          occupied.release();","+        }","+        ArrowBuf buffer = allocator.buffer(512 * 1024);","+        buffer.getReferenceManager().retain();","+        buffer.close();","+        assertEquals(ArrowAllocators.getAllocatedMemory(), 512 * 1024L);","+        buffer.close();","+        assertEquals(ArrowAllocators.getAllocatedMemory(), 0L);","+      }","+    }","+","+    private static void testEncoderRecovery()","+        throws Exception {","+      ArrowResponseEncoder encoder = new ArrowResponseEncoder();","+      DataSchema schema = new DataSchema(new String[]{\"id\", \"value\"},","+          new ColumnDataType[]{ColumnDataType.INT, ColumnDataType.STRING});","+      ResultTable oversized = new ResultTable(schema, Collections.singletonList(new Object[]{1,","+          \"x\".repeat(2 * 1024 * 1024)}));","+      expectThrows(OutOfMemoryException.class, () -> encoder.encodeResultTable(oversized, 0, 1));","+      assertEquals(ArrowAllocators.getAllocatedMemory(), 0L);","+      ResultTable small = new ResultTable(schema, Collections.singletonList(new Object[]{1, \"ok\"}));","+      byte[] encoded = encoder.encodeResultTable(small, 0, 1);","+      ResultTable decoded = encoder.decodeResultTable(encoded, 1, schema);","+      assertEquals(decoded.getRows().size(), 1);","+      assertEquals(decoded.getRows().get(0), small.getRows().get(0));","+      assertEquals(ArrowAllocators.getAllocatedMemory(), 0L);","+    }","+  }","+}"],"additions":137,"deletions":0,"truncated":false},{"path":"pinot-common/src/test/java/org/apache/pinot/common/utils/tls/ZooKeeperSslContextSupplierTest.java","lines":["@@ -0,0 +1,209 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.pinot.common.utils.tls;","+","+import io.netty.bootstrap.Bootstrap;","+import io.netty.buffer.ByteBufAllocator;","+import io.netty.channel.Channel;","+import io.netty.channel.ChannelInitializer;","+import io.netty.channel.EventLoopGroup;","+import io.netty.channel.MultiThreadIoEventLoopGroup;","+import io.netty.channel.nio.NioIoHandler;","+import io.netty.channel.socket.SocketChannel;","+import io.netty.channel.socket.nio.NioSocketChannel;","+import io.netty.handler.ssl.SslContext;","+import io.netty.handler.ssl.SslHandler;","+import java.io.InputStream;","+import java.net.InetSocketAddress;","+import java.nio.file.Files;","+import java.nio.file.Path;","+import java.security.KeyStore;","+import java.security.cert.CertificateException;","+import java.util.HashMap;","+import java.util.Map;","+import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.AtomicReference;","+import javax.net.ssl.KeyManagerFactory;","+import javax.net.ssl.SSLContext;","+import javax.net.ssl.SSLServerSocket;","+import javax.net.ssl.SSLSocket;","+import org.apache.helix.HelixManagerFactory;","+import org.apache.helix.InstanceType;","+import org.apache.pinot.common.utils.helix.HelixHelper;","+import org.apache.zookeeper.common.ClientX509Util;","+import org.apache.zookeeper.common.ZKConfig;","+import org.mockito.MockedStatic;","+import org.testng.annotations.AfterMethod;","+import org.testng.annotations.BeforeMethod;","+import org.testng.annotations.DataProvider;","+import org.testng.annotations.Test;","+","+import static org.mockito.Mockito.mockStatic;","+import static org.testng.Assert.assertEquals;","+import static org.testng.Assert.assertFalse;","+import static org.testng.Assert.assertTrue;","+","+","+/// Exercises the released ZooKeeper context factory against a trusted certificate with a mismatched peer identity.","+@Test(singleThreaded = true)","+public class ZooKeeperSslContextSupplierTest {","+  private final Map<String, String> _savedProperties = new HashMap<>();","+","+  @BeforeMethod","+  public void saveBootstrapProperties() {","+    try (ClientX509Util util = new ClientX509Util()) {","+      for (String key : new String[]{util.getSslContextSupplierClassProperty(), util.getSslProviderProperty(),","+          util.getSslHostnameVerificationEnabledProperty(), util.getFipsModeProperty(),","+          util.getSslCipherSuitesProperty(), util.getSslTruststoreLocationProperty(),","+          util.getSslTruststorePasswdProperty(), util.getSslTruststoreTypeProperty()}) {","+        _savedProperties.put(key, System.getProperty(key));","+      }","+      System.clearProperty(util.getSslContextSupplierClassProperty());","+    }","+  }","+","+  @AfterMethod(alwaysRun = true)","+  public void restoreBootstrapProperties() {","+    _savedProperties.forEach((key, value) -> {","+      if (value == null) {","+        System.clearProperty(key);","+      } else {","+        System.setProperty(key, value);","+      }","+    });","+    _savedProperties.clear();","+  }","+","+  @Test","+  public void testCustomSupplierKeepsProviderOwnership() {","+    try (ClientX509Util util = new ClientX509Util();","+        MockedStatic<HelixManagerFactory> ignored = mockStatic(HelixManagerFactory.class)) {","+      System.setProperty(util.getSslHostnameVerificationEnabledProperty(), \"false\");","+      System.setProperty(util.getSslContextSupplierClassProperty(), \"custom.supplier\");","+      System.setProperty(util.getSslProviderProperty(), \"OPENSSL\");","+      System.setProperty(util.getSslCipherSuitesProperty(), \"ECDHE-RSA-AES128-GCM-SHA256\");","+      HelixHelper.createZkHelixManager(\"test-cluster\", \"test-instance\", InstanceType.SPECTATOR, \"localhost:2181\");","+      assertEquals(System.getProperty(util.getSslContextSupplierClassProperty()), \"custom.supplier\");","+      assertEquals(System.getProperty(util.getSslProviderProperty()), \"OPENSSL\");","+      assertEquals(System.getProperty(util.getSslCipherSuitesProperty()), \"ECDHE-RSA-AES128-GCM-SHA256\");","+    }","+  }","+","+  @DataProvider","+  public Object[][] hostnamePolicies() {","+    return new Object[][]{{false, false, \"OPENSSL\"}, {false, true, \"OPENSSL_REFCNT\"},","+        {true, false, \"JDK\"}, {true, true, \"JDK\"}};","+  }","+","+  @Test(dataProvider = \"hostnamePolicies\")","+  public void testConfiguredHostnamePolicy(boolean verifyHostname, boolean fips, String provider)","+      throws Exception {","+    try (ClientX509Util util = new ClientX509Util();","+        MockedStatic<HelixManagerFactory> factory = mockStatic(HelixManagerFactory.class)) {","+      System.setProperty(util.getSslHostnameVerificationEnabledProperty(), Boolean.toString(verifyHostname));","+      System.setProperty(util.getFipsModeProperty(), Boolean.toString(fips));","+      System.setProperty(util.getSslProviderProperty(), provider);","+      System.setProperty(util.getSslCipherSuitesProperty(),","+          verifyHostname ? \"TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256\" : \"ECDHE-RSA-AES128-GCM-SHA256\");","+      System.setProperty(util.getSslTruststoreLocationProperty(), resourcePath(\"truststore.p12\").toString());"],"additions":124,"deletions":0,"truncated":false}],"additions":524,"deletions":6,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-15T13:23:00.327798+00:00"}