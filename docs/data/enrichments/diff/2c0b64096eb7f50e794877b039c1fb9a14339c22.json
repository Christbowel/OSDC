"+","+        assertThat(violation).isEmpty();","+    }","+","+    @Test","+    void shouldRejectColorThatIsNeitherHexNorStateOrLevelName() {","+        Optional<ConstraintViolationException> violation = validate(\"\"\"","+            - value: critical","+              color: red","+            \"\"\");","+","+        assertThat(violation).isPresent();","+        assertThat(violation.get().getMessage()).contains(\"Color 'red' of value 'critical'\");","+    }","+","+    @Test","+    void shouldRejectStateThatHasNoColor() {","+        Optional<ConstraintViolationException> violation = validate(\"\"\"","+            - value: queued","+              color: submitted","+            \"\"\");","+","+        assertThat(violation).isPresent();","+        assertThat(violation.get().getMessage()).contains(\"Color 'submitted' of value 'queued'\");","+    }","+","+    @Test","+    void shouldRejectValueListedTwice() {","+        Optional<ConstraintViolationException> violation = validate(\"\"\"","+            - value: critical","+              color: failed","+            - value: critical","+              label: Critical","+            \"\"\");","+","+        assertThat(violation).isPresent();","+        assertThat(violation.get().getMessage()).contains(\"Value 'critical' is listed more than once\");","+    }","+","+    private Optional<ConstraintViolationException> validate(String colorByValues) {","+        String yaml = \"\"\"","+            id: open_by_priority","+            type: io.kestra.plugin.core.dashboard.chart.Pie","+            chartOptions:","+              displayName: Open issues by priority","+              colorByColumn: state","+              colorByValues:","+            %s","+            data:","+              type: io.kestra.plugin.core.dashboard.data.Executions","+              columns:","+                state:","+                  field: STATE","+                total:","+                  agg: COUNT","+            \"\"\".formatted(colorByValues.indent(4));","+        return modelValidator.isValid(YamlParser.parse(yaml, Chart.class));","+    }","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"ui/AGENTS.md","lines":["@@ -455,7 +455,7 @@ If your `<style>` block needs to exist:"," "," | Component | Purpose |"," |-----------|---------|","-| `KsEchart` | ECharts base wrapper (lazy-load) |","+| `KsEchart` | ECharts base wrapper (lazy-load); `seriesLabel` sets the text of a series or pie slice in the external tooltip |"," | `KsLine` / `KsBar` / `KsPie` | Line, bar, and pie charts (lazy-load) |"," | `KsGraph` | Graph / network visualization (lazy-load) |"," ","@@ -513,6 +513,7 @@ Token families currently exposed:"," - `--ks-btn-*` — button background / border / text variants (`primary`, `secondary`, `run`, `success`) across `default` / `hover` / `active` / `inactive` states"," - `--ks-toggle-*` — toggle / switch states (`default`, `hover`, `active`, `inactive`, `playground`)"," - `--ks-dropdown-*`, `--ks-scrollbar-*`, `--ks-shadow-*` — component-specific tokens","+- `--ks-chart-categorical-1` … `-10`: palette for chart categories with no status meaning; dashboard charts hand them out with `chartCategoryColors()`"," - `--ks-status-*` — palette for charts and status (`success`, `error`, `warning`, `info`, `running`, `pending`, `neutral`); pair with `cssVar(\"--ks-status-success\")` in JS"," - `--ks-editor-*`, `--ks-dependencies-*`, `--ks-topology-*` — domain-specific surfaces"," "],"additions":2,"deletions":1,"truncated":false},{"path":"ui/packages/design-system/scripts/Figma.json","lines":["@@ -746,6 +746,66 @@","             \"var\": \"\",","             \"rootAlias\": \"\"","           },","+          {","+            \"name\": \"ks/chart-categorical-1\",","+            \"value\": \"#6929c4\",","+            \"var\": \"\",","+            \"rootAlias\": \"\"","+          },","+          {","+            \"name\": \"ks/chart-categorical-2\",","+            \"value\": \"#1192e8\",","+            \"var\": \"\"