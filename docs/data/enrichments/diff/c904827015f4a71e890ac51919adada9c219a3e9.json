{ content, stage } = script;"," \t\tif (stage === 'head-inline' || stage === 'before-hydration') {","@@ -165,3 +149,65 @@ export async function trackScriptHashes({"," "," \treturn clientScriptHashes;"," }","+","+interface TrackScriptIntegrityOptions {","+\tsettings: AstroSettings;","+\talgorithm: CspAlgorithm;","+\tclientRoot: URL;","+\t/** Paths of the files in the client output directory, relative to `clientRoot`. */","+\tclientFiles: Iterable<string>;","+\t/** Query string the adapter appends to rendered asset URLs (`assetQueryParams`). */","+\tassetQueryString?: string;","+}","+","+interface ScriptIntegrity {","+\t/** JSON content of a `<script type=\"importmap\">` whose `integrity` map covers every client script. */","+\timportMapContent: string;","+\t/** Hashes of every client script and of the import map itself, for `script-src`. */","+\thashes: CspHash[];","+}","+","+/**","+ * Hashes every JavaScript file Astro emitted under `build.assets` in the client output.","+ *","+ * Under `'strict-dynamic'`, browsers ignore `'self'`, so module scripts (`<script src>`, the chunks","+ * they import, and the `import()` calls of islands) load only when their hash is in `script-src` and","+ * the browser has integrity metadata for the request. An import map `integrity` entry provides that","+ * metadata for every module request, including the root `<script src>`.","+ *","+ * Returns `undefined` when the client output has no scripts.","+ */","+export async function trackScriptIntegrity({","+\tsettings,","+\talgorithm,","+\tclientRoot,","+\tclientFiles,","+\tassetQueryString,","+}: TrackScriptIntegrityOptions): Promise<ScriptIntegrity | undefined> {","+\tconst assetsDir = `${settings.config.build.assets}/`;","+\tconst scripts = Array.from(clientFiles)","+\t\t.filter((file) => file.startsWith(assetsDir) && (file.endsWith('.js') || file.endsWith('.mjs')))","+\t\t.sort();","+\tif (scripts.length === 0) {","+\t\treturn undefined;","+\t}","+","+\tconst integrity: Record<string, s