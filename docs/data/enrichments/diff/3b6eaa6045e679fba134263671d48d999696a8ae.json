{"id":"3b6eaa6045e679fba134263671d48d999696a8ae","axis":"silent","repo":"prisma/prisma","sha":"3b6eaa6045e679fba134263671d48d999696a8ae","parsed":{"files":[{"path":"packages/3-targets/0-shared/type-implementations/README.md","lines":["@@ -10,7 +10,7 @@ Value logic that more than one target's codecs, data types and `now()` generator"," - **Layer**: shared"," - **Plane**: shared"," ","-The target packs (domain `extensions`) and the adapters (domain `targets`) can both import it. Its only dependency is `temporal-spec`, for types.","+The target packs (domain `extensions`) and the adapters (domain `targets`) can both import it. Its only dependency is `temporal-spec`, for types; `isDate` uses Node's `node:util`."," "," ## What belongs here"," ","@@ -21,5 +21,5 @@ Code goes here when more than one target uses it and it depends on no database a"," - **Finding `Temporal`** (`./temporal`): `findTemporal()` returns the runtime's global `Temporal`, else the fallback `setFallbackTemporal` set once per process, else `undefined`. A target's control entry sets the fallback; the target raises its own error when there is no `Temporal`."," - **`now()` values** (`./now`): the generator ids contracts store, each named for the value and not for a database type, and the value each produces in UTC through `Date.now()`: `instantNow`, `plainDateTimeNow`, `plainDateNow`, `plainTimeNow`, and the ISO 8601 text forms `instantStringNow`, `dateStringNow` and `timeStringNow`. `dateTimeStringNow` writes the text of a date and time with no offset; no shared id produces it, and PostgreSQL's `timestampStringNow` calls it. The Temporal values take the implementation to construct with. Each value with a time rounds down to the fraction digits it is given, and a text value writes its fraction trimmed of trailing zeros or with every digit, as the target stores it; `fractionDigitsOf(params, max)` reads the digits from a generator's `precision` param, with the target's maximum as the default. A target keeps an id named after one of its own types, such as PostgreSQL's `timestamptzStringNow`."," - **Temporal values and ISO text** (`./temporal-text`): `temporalFromText` reads text with a parser and returns the value or why it was refused. `temporalToText` writes a value of the expected kind, checked by `Symbol.toStringTag` so any implementation's values are accepted, and refuses a value of another kind or a calendar other than ISO 8601. `withoutUtcDesignator` drops a trailing `Z`, and `describeValue` names a value of the wrong type in an error message.","-- **`Date` checks** (`./date`): `isValidDate`, `hasDigitsBelowAMillisecond` for ISO text a `Date` cannot hold exactly, and `utcIsoTextOf`, the `Date.toISOString` text of a `Date` on or after a target's earliest instant.","+- **`Date` checks** (`./date`): `isDate`, which holds for a `Date` from any realm, such as a `vm` context or a Jest test file, where `instanceof Date` is false; `isValidDate`, which also refuses an Invalid Date; `hasDigitsBelowAMillisecond` for ISO text a `Date` cannot hold exactly, and `utcIsoTextOf`, the `Date.toISOString` text of a `Date` on or after a target's earliest instant."," - **ISO 8601 durations** (`./duration`): `ISO_DURATION`, a duration with a sign on each component and no weeks, and `ISO_DURATION_AS_WRITTEN`, which also matches what `Temporal.Duration#toString()` writes: one sign before `P`, and weeks."],"additions":2,"deletions":2,"truncated":false},{"path":"packages/3-targets/0-shared/type-implementations/src/date.ts","lines":["@@ -1,6 +1,19 @@","+import { types } from 'node:util';","+","+/** Whether `value` is a `Date`, including one created in another realm such as a `vm` context or a Jest test file. */","+export function isDate(value: unknown): value is Date {","+  return types.isDate(value);","+}","+","+/** The same instant as a `Date` of this realm, which a driver that checks `instanceof Date` or the string tag recognises. */","+export function dateOfThisRealm(date: Date): Date {","+  const instant = date.getTime();","+  return date instanceof Date ? date : new Date(instant);","+}","+"," /** Whether `value` is a `Date` that holds an instant, not an Invalid Date. */"," export function isValidDate(value: unknown): value is Date {","-  return value instanceof Date && Number.isFinite(value.getTime());","+  return isDate(value) && Number.isFinite(value.getTime());"," }"," "," /** Whether ISO text has nonzero fraction digits past the first `fractionDigits`. */"],"additions":14,"deletions":1,"truncated":false},{"path":"packages/3-targets/0-shared/type-implementations/src/exports/date.ts","lines":["@@ -1,6 +1,8 @@"," export {","+  dateOfThisRealm,","   hasDigitsBelow,","   hasDigitsBelowAMillisecond,","+  isDate,","   isValidDate,","   utcIsoTextOf,","   withoutZerosBelowAMillisecond,"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/3-targets/0-shared/type-implementations/src/temporal-text.ts","lines":["@@ -1,3 +1,4 @@","+import { isDate } from './date';"," import type { TemporalImplementation } from './temporal';"," "," /** The `Symbol.toStringTag` of each Temporal kind a codec reads and writes. */","@@ -67,7 +68,7 @@ function describeEncodeInput(value: unknown, tag: unknown): string {"," /** A value of the wrong type, as an error message names it: `null`, `a Date`, or `a` and its `typeof`. */"," export function describeValue(value: unknown): string {","   if (value === null) return 'null';","-  if (value instanceof Date) return 'a Date';","+  if (isDate(value)) return 'a Date';","   return `a ${typeof value}`;"," }"," "],"additions":2,"deletions":1,"truncated":false},{"path":"packages/3-targets/0-shared/type-implementations/test/date.test.ts","lines":["@@ -1,7 +1,10 @@","+import { runInNewContext } from 'node:vm';"," import { describe, expect, it } from 'vitest';"," import {","+  dateOfThisRealm,","   hasDigitsBelow,","   hasDigitsBelowAMillisecond,","+  isDate,","   isValidDate,","   utcIsoTextOf,","   withoutZerosBelowAMillise