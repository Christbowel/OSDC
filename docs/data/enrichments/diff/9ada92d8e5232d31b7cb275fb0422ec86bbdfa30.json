{"id":"9ada92d8e5232d31b7cb275fb0422ec86bbdfa30","axis":"silent","repo":"pnpm/pnpm","sha":"9ada92d8e5232d31b7cb275fb0422ec86bbdfa30","parsed":{"files":[{"path":".changeset/record-runtime-on-fail.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/workspace.state\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+A repeat `pnpm install` now runs a full install when the `runtimeOnFail` setting changes. Before, it printed \"Already up to date\" and did not install the runtime a project declares in `devEngines.runtime` [pnpm/tasks#303](https://github.com/pnpm/tasks/issues/303)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_runtimes.rs","lines":["@@ -862,6 +862,39 @@ fn runtime_on_fail_ignore_removes_the_synthesized_runtime_dependency() {","     assert!(!lockfile.contains(\"node@runtime:\"), \"lockfile was:\\n{lockfile}\");"," }"," ","+#[test]","+fn repeat_install_acts_on_a_runtime_on_fail_change() {","+    let root = tempfile::tempdir().unwrap();","+    let mut server = mockito::Server::new();","+    let version = \"24.0.0-rc.4\";","+    let _mocks = mock_node_release(&mut server, version);","+    let mirrors = format!(\"nodeDownloadMirrors:\\n  rc: '{}/'\\n\", server.url());","+    let workspace = prepare_workspace(&root, &format!(\"{mirrors}runtimeOnFail: ignore\\n\"));","+    write_devengines_manifest(&workspace, version, None);","+    command(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let workspace_manifest = workspace.join(\"pnpm-workspace.yaml\");","+    let settings = fs::read_to_string(&workspace_manifest).unwrap();","+    fs::write(","+        &workspace_manifest,","+        settings.replace(\"runtimeOnFail: ignore\", \"runtimeOnFail: download\"),","+    )","+    .unwrap();","+","+    command(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).unwrap();","+    assert!(","+        lockfile.contains(format!(\"node@runtime:{version}\").as_str()),","+        \"lockfile was:\\n{lockfile}\",","+    );","+    assert!(workspace.join(\"node_modules/node/package.json\").exists());","+}","+"," #[test]"," fn explicit_node_version_takes_priority_over_the_manifest_runtime() {","     let root = tempfile::tempdir().unwrap();"],"additions":33,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install_runtimes/no_runtime.rs","lines":["@@ -6,7 +6,7 @@ use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"," use pnpm_graph_hasher::{host_arch, host_platform};"," use pnpm_testing_utils::fs::{MTIME_STEP_MS, set_mtime_ms};","-use pnpm_workspace_state::{load_workspace_state, update_workspace_state};","+use pnpm_workspace_state::{RuntimeOnFail, load_workspace_state, update_workspace_state};"," use serde_json::{Value, json};"," use std::{fs, path::Path};"," ","@@ -360,6 +360,41 @@ fn run_after_a_no_runtime_install_does_not_install_again() {","     assert_eq!(state.settings.runtime, Some(false));"," }"," ","+/// A script runs with the runtime the last install linked, so a","+/// `--runtime-on-fail` the run does not repeat must not make the gate install.","+#[test]","+fn run_after_a_runtime_on_fail_flag_install_does_not_install_again() {","+    let root = tempfile::tempdir().unwrap();","+    let mut server = mockito::Server::new();","+    let (workspace, _fixture) =","+        locked_runtime_project(&root, &mut server, \"verifyDepsBeforeRun: error\\n\");","+    let manifest_path = workspace.join(\"package.json\");","+    let mut manifest: Value = serde_json::from_slice(&fs::read(&manifest_path).unwrap()).unwrap();","+    manifest[\"scripts\"] = json!({ \"noop\": \"exit 0\" });","+    fs::write(manifest_path, manifest.to_string()).unwrap();","+","+    command(&workspace)","+        .with_args([\"install\", \"--runtime-on-fail=download\"])","+        .assert()","+        .success();","+    let mut state = load_workspace_state(&workspace).unwrap().unwrap();","+    assert_eq!(state.settings.runtime_on_fail, Some(RuntimeOnFail::Download));","+    // A lockfile newer than the state, with unchanged content, makes the gate","+    // refresh the state.","+    state.last_validated_timestamp -= 4 * MTIME_STEP_MS;","+    let validated = state.last_validated_timestamp;","+    update_workspace_state(&workspace, &state).unwrap();","+    set_mtime_ms(&workspace.join(\"pnpm-lock.yaml\"), validated + 2 * MTIME_STEP_MS);","+","+    command(&workspace)","+        .with_args([\"run\", \"noop\"])","+        .assert()","+        .success();","+    let state = load_workspace_state(&workspace).unwrap().unwrap();","+    assert!(state.last_validated_timestamp > validated);","+    assert_eq!(state.settings.runtime_on_fail, Some(RuntimeOnFail::Download));","+}","+"," #[test]"," fn no_runtime_install_unlinks_a_linked_runtime() {","     for linker in [\"isolated\", \"hoisted\"] {"],"additions":36,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/setting_types.rs","lines":["@@ -1,6 +1,7 @@"," pub use workspace::{CatalogMode, PackageImportMethod, ResolutionMode};"," "," pub use pnpm_resolving_resolver_base::{LinkWorkspacePackages, SaveWorkspaceProtocol, TrustPolicy};","+pub use pnpm_workspace_state::RuntimeOnFail;"," "," use super::{Deserialize, Serialize};"," ","@@ -217,33 +218,6 @@ pub enum InitType {","     Commonjs,"," }"," ","-/// What to do when a runtime declared through `devEngines.runtime` or","-/// `engines.runtime` does not match the current process.","-///","-/// The `runtimeOnFail` setting overrides the manifest-level `onFail` value.","-/// `download` reifies the runtime as a dependency; the other modes leave it","-/// as an engine constraint only.","-#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]","-#[serde(rename_all = \"lowercase\")]","-pub enum RuntimeOnFail {","-    Download,","-    Error,","-    Warn,","-    Ignore,","-}","-","-impl RuntimeOnFail {","-    #[must_use]","-    pub fn as_str(self) -> &'static str {","-        match self {","-            Self::Download => \"download\",","-            Self::Error => \"error\",","-            Self::Warn => \"warn\",","-            Self::Ignore => \"ignore\",","-        }","-    }","-}","-"," /// What `pnpm run` / `pnpm exec` do when `node_modules` is out of sync"," /// with the lockfile before running a script."," ///"],"additions":1,"deletions":27,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state/write.rs","lines":["@@ -46,7 +46,7 @@ pub(crate) struct CarriedSettings<'a> {","     /// [`recorded_registry_routes_after_install`](crate::install_state::recorded_registry_routes_after_install)","     /// for an install and the recorded ones for a passing check.","     pub(crate) registry_routes: Option<std::collections::BTreeMap<String, String>>,","-    /// The recorded dependency groups, runtime setting and store location to","+    /// The recorded dependency groups, runtime settings and store location to","     /// keep instead of the run's, for a writer that ignored their drift.","     pub(crate) kept_settings: Option<&'a pnpm_workspace_state::WorkspaceStateSettings>,"," }","@@ -91,6 +91,7 @@ pub(crate) fn recorded_workspace_state(write: &StateWrite<'_>) -> WorkspaceState","         state.settings.optional = kept.optional;","         state.settings.production = kept.production;","         state.settings.runtime = kept.runtime;","+        state.settings.runtime_on_fail = kept.runtime_on_fail;","         state.settings.store_dir.clone_from(&kept.store_dir);","         state.settings.virtual_store_dir.clone_from(&kept.virtual_store_dir);","     }"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install_state/settings/install_policy.rs","lines":["@@ -22,6 +22,7 @@ pub(super) fn install_policy_settings(","         dangerously_allow_all_builds: Some(config.dangerously_allow_all_builds),","         extend_node_path: (!config.extend_node_path).then_some(false),","         runtime: config.skip_runtimes.then_some(false),","+        runtime_on_fail: config.runtime_on_fail,","         trust_lockfile: config.trust_lockfile.then_some(true),","         ..rest","     }","@@ -44,6 +45,7 @@ impl SettingsComparison<'_> {","                     != live.extend_node_path.unwrap_or(true),","             ),","             (\"runtime\", recorded.runtime.unwrap_or(true) != live.runtime.unwrap_or(true)),","+            (\"runtimeOnFail\", recorded.runtime_on_fail != live.runtime_on_fail),","             (\"trustLockfile\", differs(recorded.trust_lockfile, live.trust_lockfile)),","         ]","         .into_iter()"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/deps_status.rs","lines":["@@ -22,6 +22,7 @@ const RUN_IGNORED_SETTINGS: &[&str] = &[","     \"production\",","     \"registryPrefixes\",","     \"runtime\",","+    \"runtimeOnFail\",","     \"storeDir\",","     \"virtualStoreDir\",","     \"virtualStoreDirMaxLength\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/settings_classification.rs","lines":["@@ -9,7 +9,7 @@"," use super::{super::config_blocks_fast_path, current_settings, isolated_included};"," use crate::install_state::first_setting_drift;"," use indexmap::IndexMap;","-use pnpm_config::{Config, LinkWorkspacePackages, NodeLinker, TrustPolicy};","+use pnpm_config::{Config, LinkWorkspacePackages, NodeLinker, RuntimeOnFail, TrustPolicy};"," use pnpm_workspace_state::WorkspaceState;"," use std::{collections::BTreeSet, path::Path};"," ","@@ -244,7 +244,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"resolution_mode\", NotAnInput(RESOLUTION_ONLY)),","     (\"resolve_peers_from_workspace_root\", NotAnInput(RESOLUTION_ONLY)),","     (\"reverse\", NotAnInput(CLI_ONLY)),","-    (\"runtime_on_fail\", NotAnInput(\"whether a missing runtime fails the command\")),","+    (\"runtime_on_fail\", Recorded { key: \"runtimeOnFail\", change: |config| config.runtime_on_fail = Some(RuntimeOnFail::Download) }),","     (\"save_catalog_name\", NotAnInput(OTHER_COMMAND)),","     (\"save_exact\", NotAnInput(OTHER_COMMAND)),","     (\"save_peer\", NotAnInput(OTHER_COMMAND)),"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/workspace-state/src/lib.rs","lines":["@@ -380,6 +380,9 @@ pub struct WorkspaceStateSettings {","     /// `runtime`, recorded only while it is off.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub runtime: Option<bool>,","+    /// `runtimeOnFail`, recorded only when set.","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub runtime_on_fail: Option<RuntimeOnFail>,","     /// `skills.dirs`, recorded only when set. pnpm v11 has no such setting.","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub skills_dirs: Option<Vec<String>>,","@@ -443,6 +446,33 @@ pub enum TrustPolicy {","     NoDowngrade,"," }"," ","+/// What to do when a runtime declared through `devEngines.runtime` or","+/// `engines.runtime` does not match the current process.","+///","+/// The `runtimeOnFail` setting overrides the manifest-level `onFail` value.","+/// `download` reifies the runtime as a dependency; the other modes leave it","+/// as an engine constraint only.","+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]","+#[serde(rename_all = \"lowercase\")]","+pub enum RuntimeOnFail {","+    Download,","+    Error,","+    Warn,","+    Ignore,","+}","+","+impl RuntimeOnFail {","+    #[must_use]","+    pub fn as_str(self) -> &'static str {","+        match self {","+            Self::Download => \"download\",","+            Self::Error => \"error\",","+            Self::Warn => \"warn\",","+            Self::Ignore => \"ignore\",","+        }","+    }","+}","+"," /// pnpm's `nodeLinker: 'hoisted' | 'isolated' | 'pnp'`. Same wire"," /// format as `pnpm_modules_yaml::NodeLinker`; duplicated here rather"," /// than depending on `pnpm-modules-yaml` so `workspace-state` stays"],"additions":30,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace-state/src/tests.rs","lines":["@@ -1,5 +1,5 @@"," use super::{","-    LoadWorkspaceStateError, NodeLinker, ProjectEntry, UpdateWorkspaceStateError,","+    LoadWorkspaceStateError, NodeLinker, ProjectEntry, RuntimeOnFail, UpdateWorkspaceStateError,","     WORKSPACE_STATE_FILENAME, WorkspaceState, WorkspaceStateSettings, get_file_path,","     load_workspace_state, now_millis, update_workspace_state,"," };","@@ -134,6 +134,25 @@ fn node_linker_serializes_lowercase() {","     assert_eq!(value, serde_json::Value::from(\"pnp\"));"," }"," ","+/// pnpm v11 records `runtimeOnFail` under this key with these values, and","+/// each CLI compares the state the other one wrote.","+#[test]","+fn runtime_on_fail_round_trips_in_the_v11_wire_format() {","+    for (variant, wire) in [","+        (RuntimeOnFail::Download, \"download\"),","+        (RuntimeOnFail::Error, \"error\"),","+        (RuntimeOnFail::Warn, \"warn\"),","+        (RuntimeOnFail::Ignore, \"ignore\"),","+    ] {","+        let settings =","+            WorkspaceStateSettings { runtime_on_fail: Some(variant), ..Default::default() };","+        let value = serde_json::to_value(&settings).expect(\"serialize\");","+        assert_eq!(value, serde_json::json!({ \"runtimeOnFail\": wire }));","+        let parsed: WorkspaceStateSettings = serde_json::from_value(value).expect(\"deserialize\");","+        assert_eq!(parsed.runtime_on_fail, Some(variant));","+    }","+}","+"," /// pnpm writes the flag only when it is set, so an entry without it reads"," /// as a project with no recorded modules directory."," #[test]"],"additions":20,"deletions":1,"truncated":false},{"path":"pnpm11/deps/status/test/checkDepsStatus.test.ts","lines":["@@ -402,6 +402,7 @@ describe('checkDepsStatus - settings change detection', () => {","     ['dangerouslyAllowAllBuilds', undefined, true],","     ['extendNodePath', false, undefined],","     ['runtime', false, undefined],","+    ['runtimeOnFail', 'ignore', 'download'],","     ['trustLockfile', true, undefined],","     ['virtualStoreDirMaxLength', 120, 10],","   ] as const)('returns upToDate: false when %s has changed', async (setting, recorded, current) => {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm11/exec/commands/src/runDepsStatusCheck.ts","lines":["@@ -45,7 +45,7 @@ export async function runDepsStatusCheck (commandOpts: RunDepsStatusCheckOptions","     // A script also runs the same from whichever store `node_modules` was linked from,","     // and whatever keys the lockfile records, and with the runtime the last","     // install linked or skipped.","-    ignoredWorkspaceStateSettings: ['dev', 'optional', 'production', 'registryPrefixes', 'runtime', 'storeDir', 'virtualStoreDir', 'virtualStoreDirMaxLength'] satisfies Array<keyof WorkspaceStateSettings>,","+    ignoredWorkspaceStateSettings: ['dev', 'optional', 'production', 'registryPrefixes', 'runtime', 'runtimeOnFail', 'storeDir', 'virtualStoreDir', 'virtualStoreDirMaxLength'] satisfies Array<keyof WorkspaceStateSettings>,","     selectedProjectsGraph: await selectProjectsToVerify(commandOpts),","   }"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm11/pnpm/test/install/runtimeOnFail.ts","lines":["@@ -48,6 +48,44 @@ test('runtimeOnFail=ignore prevents Node.js download even when manifest sets onF","   expect(lockfile.importers['.'].devDependencies).toBeUndefined()"," })"," ","+test('a repeat install downloads Node.js after runtimeOnFail changes to download', async () => {","+  const project = prepare({","+    devEngines: {","+      runtime: {","+        name: 'node',","+        version: '24.0.0',","+      },","+    },","+  })","+  fs.writeFileSync('pnpm-workspace.yaml', 'runtimeOnFail: ignore\\n', 'utf8')","+  await execPnpm(['install'])","+  expectNoNodeBin()","+","+  fs.writeFileSync('pnpm-workspace.yaml', 'runtimeOnFail: download\\n', 'utf8')","+  await execPnpm(['install'])","+","+  project.isExecutable('.bin/node')","+})","+","+test('pnpm run does not reinstall when only an earlier install set runtimeOnFail on the command line', async () => {","+  prepare({","+    devEngines: {","+      runtime: {","+        name: 'node',","+        version: '24.0.0',","+        onFail: 'download',","+      },","+    },","+    scripts: {","+      noop: 'node -e \"\"',","+    },","+  })","+  fs.writeFileSync('pnpm-workspace.yaml', 'verifyDepsBeforeRun: error\\n', 'utf8')","+  await execPnpm(['install', '--config.runtimeOnFail=download'])","+","+  await execPnpm(['run', 'noop'])","+})","+"," test('--no-runtime keeps the runtime entry in the lockfile but skips installing the binary', async () => {","   const project = prepare({","     devEngines: {"],"additions":38,"deletions":0,"truncated":false},{"path":"pnpm11/workspace/state/src/types.ts","lines":["@@ -131,6 +131,8 @@ export const WORKSPACE_STATE_SETTING_KEYS = [","   'publicHoistPattern',","   // Turned back on, it links the runtime the last install skipped.","   'runtime',","+  // It decides whether the install links the runtime a project declares.","+  'runtimeOnFail',","   // `node_modules` is linked from the store and virtual store it was","   // installed with, so a change to either must reach the install, which","   // recreates it. Recorded as resolved by `resolveStoreLocationSettings`.",""],"additions":2,"deletions":0,"truncated":false}],"additions":176,"deletions":33,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-10T17:05:38.241319+00:00"}