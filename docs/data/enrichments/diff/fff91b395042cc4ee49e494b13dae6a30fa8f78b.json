nly\"]","+        assert cookie[\"max-age\"] == \"300\"","+","+    @pytest.mark.parametrize(","+        \"next_url\",","+        [","+            \"https://attacker.example.net/dags\",","+            \"//attacker.example.net/dags\",","+            \"javascript:alert(1)\",","+        ],","+    )","+    @patch(\"airflow.providers.keycloak.auth_manager.routes.login.KeycloakAuthManager.get_keycloak_client\")","+    def test_login_does_not_store_unsafe_next_url(self, mock_get_keycloak_client, next_url, client):","+        mock_keycloak_client = Mock()","+        mock_keycloak_client.auth_url.return_value = \"redirect_url\"","+        mock_get_keycloak_client.return_value = mock_keycloak_client","+        response = client.get(","+            AUTH_MANAGER_FASTAPI_APP_PREFIX + \"/login\",","+            params={\"next\": next_url},","+            follow_redirects=False,","+        )","+        assert response.status_code == 307","+        assert \"_login_next_url\" not in response.cookies","+","+    @patch(\"airflow.providers.keycloak.auth_manager.routes.login.KeycloakAuthManager.get_keycloak_client\")","+    def test_login_without_next_url_clears_previous_next_url(self, mock_get_keycloak_client, client):","+        mock_keycloak_client = Mock()","+        mock_keycloak_client.auth_url.return_value = \"redirect_url\"","+        mock_get_keycloak_client.return_value = mock_keycloak_client","+        response = client.get(","+            AUTH_MANAGER_FASTAPI_APP_PREFIX + \"/login\",","+            cookies={\"_login_next_url\": \"/dags/stale_dag\"},","+            follow_redirects=False,","+        )","+        set_cookies = response.headers.get_list(\"set-cookie\")","+        assert any(c.startswith('_login_next_url=\"\"') and \"Max-Age=0\" in c for c in set_cookies)","+","+    @pytest.mark.parametrize(","+        (\"next_url_cookie\", \"expected_location\"),","+        [","+            (\"/dags/my_dag/runs/run_id/tasks/my_task\", \"/dags/my_dag/runs/run_id/tasks/my_task\"),","+            (None, \"/\"),","+            (\"https://attacker.example.net/dags\", \"/\"),","+        ],","+    )","+    @patch(\"airflow.providers.keycloak.auth_manager.routes.login.get_auth_manager\")","+    @patch(\"airflow.providers.keycloak.auth_manager.routes.login.KeycloakAuthManager.get_keycloak_client\")","+    def test_login_callback_redirects_to_next_url(","+        self, mock_get_keycloak_client, mock_get_auth_manager, next_url_cookie, expected_location, client","+    ):","+        state = \"state\"","+        mock_keycloak_client = Mock()","+        mock_keycloak_client.token.return_value = {","+            \"access_token\": \"access_token\",","+            \"refresh_token\": \"refresh_token\",","+            \"id_token\": \"id_token\",","+        }","+        mock_keycloak_client.userinfo.return_value = {","+            \"sub\": \"sub\",","+            \"preferred_username\": \"preferred_username\",","+        }","+        mock_get_keycloak_client.return_value = mock_keycloak_client","+        mock_auth_manager = Mock()","+        mock_get_auth_manager.return_value = mock_auth_manager","+        mock_auth_manager.generate_jwt.return_value = \"token\"","+        cookies = {\"_oauth_state\": state}","+        if next_url_cookie:","+            cookies[\"_login_next_url\"] = next_url_cookie","+        response = client.get(","+            AUTH_MANAGER_FASTAPI_APP_PREFIX + f\"/login_callback?code=code&state={state}\",","+            follow_redirects=False,","+            cookies=cookies,","+        )","+        assert response.status_code == 303","+        assert response.headers[\"location\"] == expected_location","+        assert response.cookies[\"_token\"] == \"token\"","+        set_cookies = response.headers.get_list(\"set-cookie\")","+        assert any(c.startswith('_login_next_url=\"\"') and \"Max-Age=0\" in c for c in set_cookies)","+","     def test_login_callback_without_code(self, client):","         response = client.get(AUTH_MANAGER_FASTAPI_APP_PREFIX + \"/login_callback\")","         assert response.status_code == 400"],"additions":103,"deletions":0,"truncated":false},{"path":"providers/keycloak/tests/unit/keycloak/auth_manager/test_keycloak_auth_manager.py","lines":["@@ -372,6 +372,10 @@ def test_get_url_login(self, auth_manager):","         result = auth_manager.get_url_login()","         assert result == f\"{AUTH_MANAGER_FASTAPI_APP_PREFIX}/login\""," ","+    def test_get_url_login_with_next_url(self, auth_manager):","+        result = auth_manager.get_url_login(next_url=\"/dags/my_dag?tab=grid\")","+        assert result == f\"{AUTH_MANAGER_FASTAPI_APP_PREFIX}/login?next=%2Fdags%2Fmy_dag%3Ftab%3Dgrid\"","+","     def test_get_url_logout(self, auth_manager):","         result = auth_manager.get_url_logout()","         assert result == f\"{AUTH_MANAGER_FASTAPI_APP_PREFIX}/logout\"",""],"additions":4,"deletions":0,"truncated":false}],"additions":134,"deletions":3,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-17T18:45:02.735400+00:00"}