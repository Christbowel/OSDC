,"+  test.each([","+    ['without a password', { firstname: 'Kai' }],","+    ['with a password', { password: 'Testing1234' }],","+  ])('updateById resolves null %s', async (_label, attributes) => {","+    const usersBefore = await strapi.db.query('admin::user').count();","+","+    await expect(","+      strapi.service('admin::user').updateById(missingId, attributes)","+    ).resolves.toBeNull();","+","+    expect(await strapi.db.query('admin::user').count()).toBe(usersBefore);","+  });","+});",""],"additions":63,"deletions":0,"truncated":false}],"additions":261,"deletions":5,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-17T18:44:20.265611+00:00"}