{"id":"72cf815977903f89969f248f176a90d1c13a8499","axis":"silent","repo":"grafana/tempo","sha":"72cf815977903f89969f248f176a90d1c13a8499","parsed":{"files":[{"path":".chloggen/querier-trace-by-id-blocks.yaml","lines":["@@ -0,0 +1,7 @@","+change_type: change","+component: querier","+note: Move trace by ID block selection from queriers to the query-frontend and deprecate querier blocklist polling.","+issues: []","+subtext: |","+  Upgrade Note: Upgrade all components to this version, then set `querier.blocklist_polling: false` on queriers. Older versions of tempo will fail to start with `blocklist_polling` in their config.","+user: electron0zero"],"additions":7,"deletions":0,"truncated":false},{"path":"cmd/tempo/app/modules.go","lines":["@@ -409,7 +409,8 @@ func (t *App) initQuerier() (services.Service, error) {"," \t}"," "," \t// do not enable polling if this is the single binary. in that case the backend-worker will take care of polling","-\tif t.cfg.Target == Querier {","+\t// TODO: remove with querier blocklist polling","+\tif t.cfg.Target == Querier && t.cfg.Querier.BlocklistPolling {"," \t\tt.store.EnablePolling(context.Background(), nil)"," \t}"," "],"additions":2,"deletions":1,"truncated":false},{"path":"docs/sources/tempo/configuration/_index.md","lines":["@@ -1293,6 +1293,14 @@ querier:","     # not distinguish between the types of queries.","     [max_concurrent_queries: <int> | default = 20]"," ","+    # Control blocklist polling in the querier.","+    #","+    # Queriers only use the blocklist to choose blocks for trace by ID, but query-frontends now send blocks in each job.","+    # This is a temporary rollout switch, and will be removed together with querier blocklist polling in a future release.","+    # Set blocklist_polling after all components run the release that added this setting. Older versions fail to start on this setting.","+    # With false, the querier rejects trace by ID jobs without blocks, such as jobs from older query-frontends.","+    [blocklist_polling: <bool> | default = true]","+","     trace_by_id:","         # Timeout for trace lookup requests","         [query_timeout: <duration> | default = 10s]"],"additions":8,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/manifest.md","lines":["@@ -355,6 +355,7 @@ querier:","     shuffle_sharding_ingesters_enabled: false","     shuffle_sharding_ingesters_lookback_period: 1h0m0s","     query_relevant_ingesters: false","+    blocklist_polling: true"," query_frontend:","     max_outstanding_per_tenant: 2000","     max_batch_size: 7"],"additions":1,"deletions":0,"truncated":false},{"path":"integration/api/tracebyid/config-querier-no-polling.yaml","lines":["@@ -0,0 +1,6 @@","+querier:","+  blocklist_polling: false","+","+live_store:","+  complete_block_timeout: 5s # timings: drop traces from live-stores soon so trace by id must read the backend","+  flush_op_timeout: 1s # timings: check for blocks to drop every second"],"additions":6,"deletions":0,"truncated":false},{"path":"integration/api/tracebyid/trace_by_id_no_querier_polling_test.go","lines":["@@ -0,0 +1,93 @@","+package tracebyid","+","+import (","+\t\"io\"","+\t\"net/http\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/grafana/e2e\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/tempo/v3/integration/util\"","+\ttempoquerier \"github.com/grafana/tempo/v3/modules/querier\"","+\ttempoUtil \"github.com/grafana/tempo/v3/pkg/util\"","+)","+","+// TestTraceByIDWithoutQuerierPolling checks that queriers find backend traces using only the blocks the query-frontend sends.","+func TestTraceByIDWithoutQuerierPolling(t *testing.T) {","+\tutil.RunIntegrationTests(t, util.TestHarnessConfig{","+\t\tConfigOverlay: \"config-querier-no-polling.yaml\",","+\t\tComponents:    util.ComponentsRecentDataQuerying | util.ComponentsBackendQuerying | util.ComponentsBackendWork,","+\t}, func(h *util.TempoHarness) {","+\t\th.WaitTracesWritable(t)","+","+\t\t// separate flushes give the backend-worker blocks to compact","+\t\tcountTraces := 5","+\t\tvar infos []*tempoUtil.TraceInfo","+\t\tfor batch := 1; batch <= 2; batch++ {","+\t\t\tfor _, info := range tempoUtil.NewTraceInfos(time.Now(), countTraces, \"\") {","+\t\t\t\trequire.NoError(t, h.WriteTraceInfo(info, \"\"))","+\t\t\t\tinfos = append(infos, info)","+\t\t\t}","+\t\t\th.WaitTracesQueryable(t, batch*countTraces)","+\t\t\th.WaitTracesWrittenToBackend(t, batch*countTraces)","+\t\t}","+","+\t\tquerier := h.Services[util.ServiceQuerier]","+\t\tworker := h.Services[util.ServiceBackendWorker]","+\t\tapiClient := h.APIClientHTTP(\"\")","+","+\t\tinLiveStores := func(info *tempoUtil.TraceInfo) bool {","+\t\t\tresp, err := http.Get(\"http://\" + querier.HTTPEndpoint() + \"/querier/api/traces/\" + info.HexID() + \"?mode=ingesters\")","+\t\t\trequire.NoError(t, err)","+\t\t\tdefer resp.Body.Close()","+\t\t\treturn resp.StatusCode != http.StatusNotFound","+\t\t}","+","+\t\t// the frontend's blocklist lags flushes and compaction, so a gap between views shows up as a missing trace","+\t\tvar settledAt time.Time","+\t\tdeadline := time.Now().Add(2 * time.Minute)","+\t\tfor {","+\t\t\tfor _, info := range infos {","+\t\t\t\tutil.QueryAndAssertTrace(t, apiClient, info)","+\t\t\t}","+","+\t\t\tif settledAt.IsZero() {","+\t\t\t\tcompacted, err := worker.SumMetrics([]string{\"tempodb_compaction_blocks_total\"}, e2e.SkipMissingMetrics)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tdropped := true","+\t\t\t\tfor _, info := range infos {","+\t\t\t\t\tif inLiveStores(info) {","+\t\t\t\t\t\tdropped = false","+\t\t\t\t\t\tbreak","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t\tif dropped && compacted[0] > 0 {","+\t\t\t\t\tsettledAt = time.Now()","+\t\t\t\t}","+\t\t\t}","+\t\t\t// give the frontend's view a few polls to catch up with compaction","+\t\t\tif !settledAt.IsZero() && time.Since(settledAt) > 10*time.Second {","+\t\t\t\tbreak","+\t\t\t}","+","+\t\t\trequire.True(t, time.Now().Before(deadline), \"traces did not leave the live-stores or blocks were not compacted\")","+\t\t\ttime.Sleep(500 * time.Millisecond)","+\t\t}","+","+\t\t// without its own blocklist, the querier can only have used the frontend's blocks","+\t\tpolls, err := querier.SumMetrics([]string{\"tempodb_blocklist_poll_duration_seconds\"}, e2e.WithMetricCount)","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, float64(0), polls[0])","+","+\t\t// mode=blocks without blocks simulates an old query-frontend, which must fail on a querier with polling disabled","+\t\tresp, err := http.Get(\"http://\" + querier.HTTPEndpoint() + \"/querier/api/traces/\" + infos[0].HexID() + \"?mode=blocks\")","+\t\trequire.NoError(t, err)","+\t\tdefer resp.Body.Close()","+\t\trequire.Equal(t, http.StatusBadRequest, resp.StatusCode)","+\t\tbody, err := io.ReadAll(resp.Body)","+\t\trequire.NoError(t, err)","+\t\trequire.Contains(t, string(body), tempoquerier.ErrTraceByIDBlocksRequired.Error())","+\t})","+}"],"additions":93,"deletions":0,"truncated":false},{"path":"integration/storage/backend_scheduler_test.go","lines":["@@ -304,7 +304,7 @@ func TestBackendSchedulerRedaction(t *testing.T) {"," \t\t// tempodbReader's poll can still race the writer's last block - retry like the post-redaction check below."," \t\trequire.Eventually(t, func() bool {"," \t\t\ttempodbReader.PollNow(ctx)","-\t\t\ttrs, failedBlocks, err = tempodbReader.Find(ctx, testTenant, traceID, tempodb.BlockIDMin, tempodb.BlockIDMax, time.Time{}, time.Time{}, common.DefaultSearchOptions())","+\t\t\ttrs, failedBlocks, err = tempodbReader.Find(ctx, testTenant, &tempopb.TraceByIDRequest{TraceID: traceID, BlockStart: tempodb.BlockIDMin, BlockEnd: tempodb.BlockIDMax}, common.DefaultSearchOptions())"," \t\t\treturn err == nil && len(failedBlocks) == 0 && len(trs) > 0"," \t\t}, 60*time.Second, 2*time.Second, \"trace must be findable in all blocks before redaction\")"," ","@@ -361,7 +361,7 @@ func TestBackendSchedulerRedaction(t *testing.T) {"," \t\t// of the lookback w