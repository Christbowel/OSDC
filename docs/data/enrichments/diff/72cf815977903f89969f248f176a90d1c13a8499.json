.BlockIDMin, BlockEnd: tempodb.BlockIDMax}, common.DefaultSearchOptions())"," \t\t\treturn err == nil && len(trs) == 0"," \t\t}, 60*time.Second, 2*time.Second, \"query-matched trace must not be findable after redaction\")"," ","-\t\tkeepTrs, _, err := tempodbReader.Find(ctx, testTenant, keepID, tempodb.BlockIDMin, tempodb.BlockIDMax, time.Time{}, time.Time{}, common.DefaultSearchOptions())","+\t\tkeepTrs, _, err := tempodbReader.Find(ctx, testTenant, &tempopb.TraceByIDRequest{TraceID: keepID, BlockStart: tempodb.BlockIDMin, BlockEnd: tempodb.BlockIDMax}, common.DefaultSearchOptions())"," \t\trequire.NoError(t, err)"," \t\trequire.NotEmpty(t, keepTrs, \"non-matching trace must survive redaction\")"," \t})"],"additions":5,"deletions":5,"truncated":false},{"path":"modules/frontend/docs/config-reference.md","lines":["@@ -351,6 +351,7 @@ querier:","     shuffle_sharding_ingesters_enabled: false","     shuffle_sharding_ingesters_lookback_period: 1h0m0s","     query_relevant_ingesters: false","+    blocklist_polling: true"," query_frontend:","     max_outstanding_per_tenant: 2000","     max_batch_size: 7"],"additions":1,"deletions":0,"truncated":false},{"path":"modules/frontend/search_sharder_test.go","lines":["@@ -8,6 +8,7 @@ import ("," \t\"net/http\""," \t\"net/http/httptest\""," \t\"net/url\"","+\t\"slices\""," \t\"sort\""," \t\"strconv\""," \t\"strings\"","@@ -43,6 +44,8 @@ var _ tempodb.Reader = (*mockReader)(nil)"," type mockReader struct {"," \tmetas   []*backend.BlockMeta"," \ttenants []string","+\t// returned by TraceByIDBlockMetas only, like recently compacted blocks","+\tcompactedMetas []*backend.BlockMeta"," }"," "," func (m *mockReader) SearchTags(context.Context, *backend.BlockMeta, *tempopb.SearchTagsBlockRequest, common.SearchOptions) (*tempopb.SearchTagsV2Response, error) {","@@ -61,10 +64,24 @@ func (m *mockReader) FetchTagValues(context.Context, *backend.BlockMeta, traceql"," \treturn nil"," }"," ","-func (m *mockReader) Find(context.Context, string, co