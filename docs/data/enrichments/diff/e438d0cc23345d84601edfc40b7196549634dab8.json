     val batch = unloader.getRecordBatch()","+      Utils.tryWithSafeFinally {","+        val e = intercept[IllegalStateException](unloader.getRecordBatch())","+        assert(e.getMessage === \"compression failed\")","+        // A suppressed exception means that a buffer was released twice. If this fails after an","+        // Arrow upgrade, Arrow releases these buffers itself and ReleasingVectorUnloader must be","+        // removed.","+        assert(e.getSuppressed.isEmpty)","+        assert(batch.getBuffers.asScala.forall(_.refCnt() == 1))","+      } {","+        batch.close()","+      }","+    } {","+      // Closing the allocator fails if a buffer is left behind.","+      root.close()","+      allocator.close()","+    }","+  }"," }",""],"additions":41,"deletions":0,"truncated":false}],"additions":116,"deletions":11,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-01T15:16:21.126768+00:00"}