entries {","+\t\tif entry == nil {","+\t\t\treturn fmt.Errorf(\"tpm_cert[%d]: configuration is empty\", idx)","+\t\t}","+","+\t\tblockName := fmt.Sprintf(blockFmt, idx)","+\t\tif entry.Name != \"\" {","+\t\t\tif prev, exists := seenNames[entry.Name]; exists {","+\t\t\t\tif prev.line > 0 && entry.LineNumber > 0 {","+\t\t\t\t\treturn fmt.Errorf(\"%s (line %d) name %q duplicates tpm_cert[%d] (line %d)\", blockName, entry.LineNumber, entry.Name, prev.idx, prev.line)","+\t\t\t\t}","+\t\t\t\treturn fmt.Errorf(\"%s name %q duplicates tpm_cert[%d]\", blockName, entry.Name, prev.idx)","+\t\t\t}","+\t\t\tseenNames[entry.Name] = seenBlockName{idx: idx, line: entry.LineNumber}","+\t\t}","+","+\t\tns := namespace.Canonicalize(entry.Namespace)","+\t\tif ns == \"\" {","+\t\t\tns = namespace.Canonicalize(inheritedNamespace)","+\t\t}","+\t\tentry.Namespace = ns","+","+\t\tif strings.TrimSpace(entry.MountPath) == \"\" {","+\t\t\treturn fmt.Errorf(\"%s.mount_path must be specified\", blockName)","+\t\t}","+","+\t\tif err := validateRenew(blockName, entry); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif err := validateDestination(blockName, idx, seenDestinationPaths, entry); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\treturn nil","+}","+","+func validateRenew(blockName string, entry *TPMCert) error {","+\tif entry.Renew == nil {","+\t\tentry.Renew = &TPMCertRenew{}","+\t}","+","+\tif entry.Renew.PercentRenewBeforeExpiry == nil {","+\t\tdefaultPercent := defaultPercentRenewBeforeExpiry","+\t\tentry.Renew.PercentRenewBeforeExpiry = &defaultPercent","+\t} else if *entry.Renew.PercentRenewBeforeExpiry <= 0 || *entry.Renew.PercentRenewBeforeExpiry >= 100 {","+\t\treturn fmt.Errorf(\"%s.renew.percent_renew_before_expiry must be between 1 and 99\", blockName)","+\t}","+","+\treturn nil","+}","+","+func validateDestination(blockName string, idx int, seenDestinationPaths map[string]int, entry *TPMCert) error {","+\tif entry.Destination == nil {","+\t\treturn fmt.Errorf(\"%s.d