om/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/vault/sdk/helper/backoff\"","+\tsdktpm \"github.com/hashicorp/vault/sdk/helper/tpm\"","+)","+","+// AttestFunc performs TPM attestation and returns the result. The function is","+// responsible for all Vault client interaction and TPM configuration; Manager","+// treats it as an opaque operation.","+type AttestFunc func(ctx context.Context) (*sdktpm.AttestationResult, error)","+","+// ValidateFunc validates a loaded AttestationResult against the local TPM","+// hardware (e.g. verifying that the persisted key blobs are still usable).","+// A nil ValidateFunc skips hardware validation.","+type ValidateFunc func(*sdktpm.AttestationResult) error","+","+type Manager struct {","+\tattest       AttestFunc","+\tvalidate     ValidateFunc","+\tdestPath     string","+\tumask        os.FileMode","+\trenewPercent int","+\tlogger       hclog.Logger","+","+\tmu           sync.RWMutex","+\ttimer        *time.Timer","+\tretryBackoff *backoff.Backoff","+","+\tstopCh  chan struct{}","+\tstarted bool","+\tstopped atomic.Bool","+}","+","+// NewManager creates a Manager that periodically calls attest to obtain and","+// renew TPM certificate material. validate may be nil to skip hardware","+// validation when loading persisted material.","+func NewManager(attest AttestFunc, validate ValidateFunc, destPath string, umask os.FileMode, renewPercent int, logger hclog.Logger) (*Manager, error) {","+\tif attest == nil {","+\t\treturn nil, fmt.Errorf(\"attest func cannot be nil\")","+\t}","+","+\treturn &Manager{","+\t\tattest:       attest,","+\t\tvalidate:     validate,","+\t\tdestPath:     destPath,","+\t\tumask:        umask,","+\t\trenewPercent: renewPercent,","+\t\tlogger:       logger,","+\t\tstopCh:       make(chan struct{}),","+\t\tretryBackoff: backoff.NewBackoff(math.MaxInt, 1*time.Minute, 1*time.Hour),","+\t}, nil","+}","+","+func (m *Manager) Start(ctx context.Context) {","+\tm.mu.Lock()","+\tif m.started {","+\t\tm.mu.Unlock()","+\t\treturn","+\t}","+\tm.started = true","+\tm.mu.Unlock()","+","+\tm.logger.Info(\"starting TPM attestation manager\")","+\tdefer m.logger.Info(\"TPM attestation manager stopped\")","+","+\treused, err := m.loadPersistedMaterial()","+\tif err != nil {","+\t\tm.logger.Warn(\"failed to load persisted TPM certificate material, will reissue\", \"error\", err)","+\t}","+","+\tif !reused {","+\t\tif err != nil {","+\t\t\tm.logger.Info(\"starting initial acquisition after load failure\")","+\t\t} else {","+\t\t\tm.logger.Info(\"no reusable persisted TPM certificate material found, starting initial acquisition\")","+\t\t}","+\t\tif err := m.acquireMaterial(ctx); err != nil {","+\t\t\tm.logger.Error(\"failed to acquire initial TPM certificate material\", \"error\", err)","+\t\t\tm.scheduleRetryAfter()","+\t\t}","+\t} else {","+\t\tm.logger.Info(\"loaded persisted TPM certificate material\")","+\t}","+","+\tfor {","+\t\tm.mu.RLock()","+\t\ttimerC := m.timerC()","+\t\tm.mu.RUnlock()","+","+\t\tselect {","+\t\tcase <-ctx.Done():","+\t\t\treturn","+\t\tcase <-m.stopCh:","+\t\t\treturn","+\t\tcase <-timerC:","+\t\t\tm.logger.Info(\"renewal timer triggered\")","+\t\t\tif err := m.acquireMaterial(ctx); err != nil {","+\t\t\t\tm.logger.Error(\"TPM certificate renewal failed\", \"error\", err)","+\t\t\t\tm.scheduleRetryAfter()","+\t\t\t}","+\t\t}","+\t}","+}","+","+func (m *Manager) Stop() {","+\tif !m.stopped.CompareAndSwap(false, true) {","+\t\treturn","+\t}","+","+\tm.mu.Lock()","+\tif m.timer != nil {","+\t\tm.timer.Stop()","+\t\tm.timer = nil","+\t}","+\tm.mu.Unlock()","+","+\tclose(m.stopCh)","+}","+","+func (m *Manager) acquireMaterial(ctx context.Context) error {","+\tm.logger.Info(\"acquiring TPM certificate material\")","+","+\tresult, err := m.attest(ctx)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"failed to attest with TPM: %w\", err)","+\t}","+","+\tif err := result.SaveToDirectory(m.destPath, m.umask); err != nil {","+\t\treturn fmt.Errorf(\"failed to save TPM material: %w\", err)","+\t}","+","+\tm.scheduleRenewal(result)","+","+\treturn nil","+}","+","+func (m *Manager) loadPersistedMaterial() (bool, error) {","+\tresult, err := sdktpm.LoadFromDirectory(m.destPath)","+\tif err != nil {","+\t\tif os.IsNotExist(err) {","+\t\t\treturn false, nil","+\t\t}","+\t\treturn false, fmt.Errorf(\"failed to load persisted material: %w\", err)","+\t}","+","+\tif time.Now().After(result.NotAfter) {","+\t\treturn false, fmt.Errorf(\"persisted certificate has expired at %s\", result.NotAfter)","+\t}","+","+\tif m.validate != nil {","+\t\tif err := m.validate(result); err != nil {","+\t\t\treturn false, fmt.Errorf(\"persisted material failed validation: %w\", err)","+\t\t}","+\t}","+","+\tm.scheduleRenewal(result)","+\treturn true, nil","+}","+","+// parseUmask parses a umask string (e.g., \"077\") into an os.FileMode.","+func parseUmask(umaskStr string) (os.FileMode, error) {","+\tif umaskStr == \"\" {","+\t\treturn 0, nil","+\t}","+","+\tumaskVal, err := strconv.ParseUint(umaskStr, 8, 32)","+\tif err != nil {","+\t\treturn 0, fmt.Errorf(\"invalid umask value %q: %w\", umaskStr, err)","+\t}","+","+\treturn os.FileMode(umaskVal), nil","+}","+","+// timerC returns the channel of the current renewal timer, or a nil channel","+// (which blocks forever) when no timer is set. Must be called with m.mu held","+// for reading.","+func (m *Manager) timerC() <-chan time.Time {","+\tif m.timer == nil {","+\t\treturn nil","+\t}","+\treturn m.timer.C","+}","+","+// resetTimer arms the renewal timer to fire after duration. If a timer already","+// exists its channel is reused (via Reset) so that any goroutine already","+// selecting on that channel will wake up. Must be called with m.mu held for","+// writing.","+func (m *Manager) resetTimer(duration time.Duration) {","+\tif m.timer != nil {","+\t\t// Stop and drain before Reset per the time.Timer docs.","+\t\tif !m.timer.Stop() {","+\t\t\tselect {","+\t\t\tcase <-m.timer.C:","+\t\t\tdefault:","+\t\t\t}","+\t\t}","+\t\tm.timer.Reset(duration)","+\t\treturn","+\t}","+\tm.timer = time.NewTimer(duration)","+}","+","+func (m *Manager) scheduleRenewal(result *sdktpm.AttestationResult) {","+\tlifetime := result.NotAfter.Sub(result.NotBefore)","+\trenewalThreshold := time.Duration(float64(lifetime) * float64(m.renewPercent) / 100.0)","+\trenewalTime := result.NotAfter.Add(-renewalThreshold)","+","+\tduration := time.Until(renewalTime)","+\tif duration < 0 {","+\t\tduration = time.Second","+\t} else {","+\t\tjitterRange := float64(duration) * 0.1","+\t\tjitter := time.Duration(mathrand.Float64()*jitterRange*2 - jitterRange)","+\t\tduration += jitter","+\t\tif duration < 0 {","+\t\t\tduration = time.Second","+\t\t}","+\t}","+","+\tm.mu.Lock()","+\tm.retryBackoff.Reset()","+\tm.resetTimer(duration)","+\tm.mu.Unlock()","+","+\tm.logger.Info(\"scheduled TPM certificate renewal\", \"renewal_time\", renewalTime, \"duration\", duration)","+}","+","+func (m *Manager) scheduleRetryAfter() {","+\tm.mu.Lock()","+\t// Discard error; can only be ErrMaxRetry and we use math.MaxInt retries.","+\tduration, _ := m.retryBackoff.Next()","+\tm.resetTimer(duration)","+\tm.mu.Unlock()","+","+\tm.logger.Warn(\"scheduled TPM certificate retry after failure\", \"duration\", duration)","+}"],"additions":251,"deletions":0,"truncated":false},{"path":"command/client/agentproxyshared/tpmattest/server.go","lines":["@@ -0,0 +1,172 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package tpmattest","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"sync\"","+","+\t\"github.com/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/vault/api\"","+\t\"github.com/hashicorp/vault/command/client/agentproxyshared/tpmconfig\"","+\tsdktpm \"github.com/hashicorp/vault/sdk/helper/tpm\"","+\t\"go.uber.org/atomic\"","+)","+","+type ServerConfig struct {","+\tLogger hclog.Logger","+\t// TPMCerts are the validated tpm_cert blocks from the Agent or Proxy config.","+\tTPMCerts []*tpmconfig.