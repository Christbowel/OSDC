{"id":"fc26f480d84d7c78591750a41e56e60117719d91","axis":"silent","repo":"TryGhost/Ghost","sha":"fc26f480d84d7c78591750a41e56e60117719d91","parsed":{"files":[{"path":"ghost/core/server/auth/better-auth/README.md","lines":["@@ -80,6 +80,10 @@ until Phase 4.","   or token (the Admin API resolver, revocation, app tokens) must check the","   user's status too. Server-only: `createVerifiedSession`, which requires the","   admin origin, `revokeUserSessions` and `revokeAllSessions`.","+- `plugins/sso.ts` (`ghostSso`): server-only `createSsoSession`, for the SSO","+  adapter hook described below. It applies the passwordless rules above","+  (unlocks `locked`, refuses `inactive`) and creates a verified session pinned","+  to the admin origin. Team SSO is `@better-auth/sso` (Phase 8)."," - `session-controller.ts`: `POST` and `DELETE /session` under `better-auth`,","   described below."," - `staff-sessions.ts`: the security events' session changes, described below.","@@ -236,6 +240,16 @@ the user's legacy rows, and suspension and deletion keep legacy behaviour."," Sessions that `createVerifiedSession` creates have no IP or user agent, since"," the API controllers don't see the request."," ","+## SSO adapter","+","+Ghost(Pro) support access implements the `@tryghost/adapter-base-sso`","+contract, which `createSessionFromToken()` in `auth/session` mounts on","+`/ghost`. The adapter still resolves the user under either engine. Under","+`better-auth` the hook calls `staffSessions.createSsoSession` and forwards its","+cookie instead of creating a legacy session; the engine is chosen when the","+backend app mounts the hook. A refused user gets no cookie, and the request","+carries on, as under `legacy`.","+"," ## Tables"," "," `user_accounts`, `user_sessions` and `verifications` are defined in"],"additions":14,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/create-auth.ts","lines":["@@ -7,6 +7,7 @@ import type { Knex } from 'knex';"," import { CLIENT_IP_HEADER } from './client-ip';"," import { createKnexAdapter } from './knex-adapter';"," import { rateLimitStorage, type Limiters } from './rate-limit';","+import { ghostSso } from './plugins/sso';"," import { ghostStaffLifecycle } from './plugins/staff-lifecycle';"," import { ROUTES } from './routes';"," import {","@@ -227,7 +228,10 @@ export function createAuth(deps: CreateAuthDeps) {","         },","       },","     },","-    plugins: [ghostStaffLifecycle({ sendPasswordResetEmail: deps.sendPasswordResetEmail })],","+    plugins: [","+      ghostStaffLifecycle({ sendPasswordResetEmail: deps.sendPasswordResetEmail }),","+      ghostSso(),","+    ],","     telemetry: { enabled: false },","     logger: {","       log: (level, message, ...args) => deps.logger[level](message, ...args),"],"additions":5,"deletions":1,"truncated":false},{"path":"ghost/core/server/auth/better-auth/plugins/sso.ts","lines":["@@ -0,0 +1,57 @@","+import { runWithTransaction } from '@better-auth/core/context';","+import { APIError, BASE_ERROR_CODES, getCurrentAdapter } from 'better-auth';","+import type { BetterAuthPlugin } from 'better-auth';","+import { createAuthEndpoint } from 'better-auth/api';","+import { setSessionCookie } from 'better-auth/cookies';","+import { z } from 'zod';","+import { admitStaffUser, type StaffUser } from './staff-lifecycle';","+","+/**","+ * Sessions for the `@tryghost/adapter-base-sso` contract, which Ghost(Pro)","+ * support access implements (plan §3.3). The adapter resolves the user;","+ * team SSO is `@better-auth/sso`.","+ */","+export const ghostSso = () =>","+  ({","+    id: 'ghost-sso',","+","+    endpoints: {","+      /** A verified session for a user the SSO adapter resolved; SSO sign-in is passwordless */","+      createSsoSession: createAuthEndpoint.serverOnly(","+        {","+          method: 'POST',","+          body: z.object({","+            userId: z.string(),","+            origin: z.string(),","+          }),","+        },","+        async (ctx) => {","+          const { userId, origin } = ctx.body;","+          const session = await runWithTransaction(ctx.context.adapter, async () => {","+            const adapter = await getCurrentAdapter(ctx.context.adapter);","+            const found = await adapter.findOne<StaffUser>({","+              model: 'user',","+              where: [{ field: 'id', value: userId }],","+            });","+            if (!found) {","+              throw APIError.from('NOT_FOUND', BASE_ERROR_CODES.USER_NOT_FOUND);","+            }","+            await admitStaffUser(adapter, found, { passwordless: true });","+            // overrideAll keeps `verified` from its default","+            return ctx.context.internalAdapter.createSession(","+              userId,","+              false,","+              { verified: true, origin },","+              true,","+            );","+          });","+          const user = await ctx.context.internalAdapter.findUserById(userId);","+          if (!user) {","+            throw APIError.from('NOT_FOUND', BASE_ERROR_CODES.USER_NOT_FOUND);","+          }","+          await setSessionCookie(ctx, { session, user });","+          return ctx.json({ session, user });","+        },","+      ),","+    },","+  }) satisfies BetterAuthPlugin;"],"additions":57,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/plugins/staff-lifecycle.ts","lines":["@@ -34,7 +34,9 @@ const PASSWORDLESS_SIGN_IN: string[] = [ROUTES.magicLinkVerify, ROUTES.passkeyVe"," const isPasswordlessSignIn = (path: string | undefined) =>","   !!path && (PASSWORDLESS_SIGN_IN.includes(path) || path.startsWith(SSO_PREFIX));"," ","-type StaffUser = User & { status?: string | null };","+export type StaffUser = User & { status?: string | null };","+","+type Adapter = Awaited<ReturnType<typeof getCurrentAdapter>>;"," "," export type StaffLifecycleOptions = {","   /** Emails a password reset link, as the legacy session endpoint does for a locked user */","@@ -46,23 +48,43 @@ const refusal = (status: unknown) =>","     ? APIError.from('UNAUTHORIZED', ERRORS.PASSWORD_RESET_REQUIRED)","     : APIError.from('FORBIDDEN', ERRORS.ACCOUNT_SUSPENDED);"," ","+// Matches the status read earlier, so a lock or suspension committed since stands","+const setStatus = (adapter: Adapter, userId: string, from: string[], to: string) =>","+  adapter.updateMany({","+    model: 'user',","+    where: [","+      { field: 'id', value: userId },","+      { field: 'status', operator: 'in', value: from },","+    ],","+    update: { status: to },","+  });","+","+/**","+ * Throws unless the user may sign in. A passwordless sign-in unlocks a","+ * `locked` user; `inactive` is always refused.","+ */","+export async function admitStaffUser(","+  adapter: Adapter,","+  user: StaffUser,","+  { passwordless }: { passwordless: boolean },","+): Promise<void> {","+  if (isActiveStatus(user.status)) {","+    return;","+  }","+  if (user.status === 'locked' && passwordless) {","+    // No match means the user was suspended since the read","+    if (await setStatus(adapter, user.id, ['locked'], 'active')) {","+      return;","+    }","+    throw refusal('inactive');","+  }","+  throw refusal(user.status);","+}","+"," /** Ghost's staff status rules on top of Better Auth core (plan §3.3). */"," export const ghostStaffLifecycle = (options: StaffLifecycleOptions) => {","   let authContext: AuthContext;"," ","-  // Matches the status read earlier, so a lock or suspension committed since stands","-  const setStatus = async (userId: string, from: string[], to: string): Promise<number> => {","-    const adapter = await getCurrentAdapter(authContext.adapter);","-    return adapter.updateMany({","-      model: 'user',","-      where: [","-        { field: 'id', value: userId },","-        { field: 'status', operator: 'in', value: from },","-      ],","-      update: { status: to },","-    });","-  };","-","   return {","     id: 'ghost-staff-lifecycle',","     $ERROR_CODES: STAFF_LIFECYCLE_ERROR_CODES,","@@ -84,17 +106,9 @@ export const ghostStaffLifecycle = (options: StaffLifecycleOptions) => {","                   if (!user) {","                     throw APIError.from('NOT_FOUND', BASE_ERROR_CODES.USER_NOT_FOUND);","                   }","-                  if (isActiveStatus(user.status)) {","-                    return;","-                  }","-                  if (user.status === 'locked' && isPasswordlessSignIn(endpoint?.path)) {","-                    // No match means the user was suspended since the read","-                    if (await setStatus(user.id, ['locked'], 'active')) {","-                      return;","-                    }","-                    throw refusal('inactive');","-                  }","-                  throw refusal(user.status);","+                  await admitStaffUser(adapter, user, {","+                    passwordless: isPasswordlessSignIn(endpoint?.path),","+                  });","                 },","                 // Bookkeeping only: the session exists by now, so a failure is logged, not thrown","                 async after(session) {","@@ -108,7 +122,7 @@ export const ghostStaffLifecycle = (options: StaffLifecycleOptions) => {","                       where: [{ field: 'id', value: session.userId }],","                       update: { last_seen: new Date() },","                     });","-                    await setStatus(session.userId, WARN_STATUSES, 'active');","+                    await setStatus(adapter, session.userId, WARN_STATUSES, 'active');","                   } catch (err) {","                     authContext.logger.error('Updating the user after sign-in failed', err);","                   }"],"additions":40,"deletions":26,"truncated":false},{"path":"ghost/core/server/auth/better-auth/staff-sessions.ts","lines":["@@ -5,7 +5,7 @@ export type StaffSessionsDeps = {","   /** Read per call: the instance is built by boot */","   getAuth(): Pick<","     GhostAuth['api'],","-    'createVerifiedSession' | 'revokeUserSessions' | 'revokeAllSessions'","+    'createVerifiedSession' | 'createSsoSession' | 'revokeUserSessions' | 'revokeAllSessions'","   >;","   /** Deletes the user's legacy `sessions` rows */","   deleteLegacyUserSessions(userId: string): Promise<unknown>;","@@ -37,6 +37,15 @@ export function createStaffSessions(deps: StaffSessionsDeps) {","       });","       return sessionCookies(headers);","     },","+","+    /** As `createVerifiedSession`, for a user the SSO adapter resolved; unlocks a locked user */","+    async createSsoSession(userId: string): Promise<string[]> {","+      const { headers } = await deps.getAuth().createSsoSession({","+        body: { userId, origin: deps.getAdminOrigin() },","+        returnHeaders: true,","+      });","+      return sessionCookies(headers);","+    },","   };"," }"," "],"additions":10,"deletions":1,"truncated":false},{"path":"ghost/core/server/auth/session/index.ts","lines":["@@ -109,6 +109,12 @@ const sessionService = createSessionService({","   t,"," });"," ","+// Better Auth's `ghostSso`: a verified session pinned to the admin origin","+async function createBetterAuthSsoSession(_req: Request, res: Response, user: { id: string }) {","+  const getStaffSessions = require('../better-auth/staff-sessions').default;","+  res.append('Set-Cookie', await getStaffSessions().createSsoSession(user.id));","+}","+"," // Looks funky but this is a \"custom\" piece of middleware"," function createSessionFromToken() {","   const ssoAdapter = adapterManager.getAdapter('sso');","@@ -130,14 +136,20 @@ function createSessionFromToken() {","     },","   });"," ","+  // Chosen once, when the backend app mounts this","+  const createSession =","+    config.get('auth:engine') === 'better-auth'","+      ? createBetterAuthSsoSession","+      : // The service attaches req.session itself before reading it","+        (sessionService.createVerifiedSessionForUser as (","+          req: Request,","+          res: Response,","+          user: { id: string },","+        ) => Promise<void>);","+","   return sessionFromToken({","     callNextWithError: false,","-    // The service attaches req.session itself before reading it","-    createSession: sessionService.createVerifiedSessionForUser as (","-      req: Request,","-      res: Response,","-      user: { id: string },","-    ) => Promise<void>,","+    createSession,","     findUserByLookup: ssoAdapter.getUserForIdentity.bind(ssoAdapter),","     getLookupFromToken: ssoAdapter.getIdentityFromCredentials.bind(ssoAdapter),","     getTokenFromRequest: ssoAdapter.getRequestCredentials.bind(ssoAdapter),"],"additions":18,"deletions":6,"truncated":false},{"path":"ghost/test/e2e-server/better-auth-sso.isolated.test.ts","lines":["@@ -0,0 +1,158 @@","+import assert from 'node:assert/strict';","+import sinon from 'sinon';","+import request from 'supertest';","+import { SSOBase } from '@tryghost/adapter-base-sso';","+","+const {","+  startGhost,","+  fixtureManager,","+  configUtils,","+  mockManager,","+  resetRateLimits,","+} = require('../utils/e2e-framework');","+const db = require('../../core/server/data/db');","+const adapterManager = require('../../core/server/services/adapter-manager').default;","+const jobsService = require('../../core/server/services/jobs-service');","+const stripe = require('../../core/server/services/stripe');","+const sentry = require('../../core/shared/sentry');","+const DataGenerator = require('../utils/fixtures/data-generator');","+","+const isSQLite = ['sqlite3', 'better-sqlite3'].includes(db.knex.client.config.client);","+","+const [owner, locked, inactive] = DataGenerator.Content.users;","+","+// The SSO adapter hook (Ghost(Pro) support access) under ghostSso","+describe.skipIf(isSQLite)('SSO under auth:engine better-auth', function () {","+  const sandbox = sinon.createSandbox();","+  const adminOrigin = 'http://localhost:2369';","+  const host = new URL(adminOrigin).host;","+  let app: Parameters<typeof request>[0];","+","+  // Resolves the email in a request header through the user repository Ghost injects","+  class MockSSOAdapter extends SSOBase<string, string> {","+    async getRequestCredentials(req: { get(name: string): string | undefined }) {","+      return req.get('x-test-sso-email') ?? null;","+    }","+","+    async getIdentityFromCredentials(email: string) {","+      return email;","+    }","+","+    async getUserForIdentity(email: string) {","+      return this.getUserByEmail(email);","+    }","+  }","+","+  // The admin app answers POST /ghost/ with a 404 after the hook runs, as in sso.test.js","+  const ssoSignIn = (email?: string) => {","+    const req = request(app).post('/ghost/').set('Host', host);","+    return email ? req.set('x-test-sso-email', email) : req;","+  };","+","+  const cookieOf = (response: request.Response) =>","+    [response.headers['set-cookie'] ?? []].flat().map((c: string) => c.split(';')[0]);","+","+  const me = (cookie: string[]) =>","+    request(app)","+      .get('/ghost/api/admin/users/me/')","+      .set('Host', host)","+      .set('Origin', adminOrigin)","+      .set('Cookie', cookie);","+","+  const sessions = (userId: string) => db.knex('user_sessions').where({ user_id: userId });","+  const statusOf = async (userId: string) =>","+    (await db.knex('users').where({ id: userId }).first('status')).status;","+","+  beforeAll(async function () {","+    configUtils.set('sentry:disabled', true);","+    sandbox.stub(sentry, 'captureException');","+    sandbox.stub(sentry, 'captureMessage');","+    configUtils.set('auth:engine', 'better-auth');","+    configUtils.set('createInDevelopmentTables', true);","+    configUtils.set('url', `${adminOrigin}/`);","+","+    const getAdapter = adapterManager.getAdapter;","+    sandbox","+      .stub(adapterManager, 'getAdapter')","+      .callsFake((name: unknown) =>","+        name === 'sso' ? new MockSSOAdapter() : getAdapter.call(adapterManager, name),","+      );","+","+    app = await startGhost({ backend: true, frontend: false, server: false });","+    await fixtureManager.init('users');","+  });","+","+  beforeEach(async function () {","+    configUtils.set('url', `${adminOrigin}/`);","+    // SSO counts as verified, so device verification stays on","+    configUtils.set('security:staffDeviceVerification', true);","+    await resetRateLimits();","+    await db.knex('user_sessions').del();","+    await db.knex('users').update({ status: 'active' });","+    await db.knex('users').where({ id: locked.id }).update({ status: 'locked' });","+    await db.knex('users').where({ id: inactive.id }).update({ status: 'inactive' });","+    mockManager.mockMail();","+  });","+","+  afterEach(function () {","+    mockManager.restore();","+  });","+","+  afterAll(async function () {","+    sandbox.restore();","+    try {","+      await jobsService.shutdown();","+    } finally {","+      await stripe.shutdown();","+      await configUtils.restore();","+    }","+  });","+","+  it('signs in with a verified session pinned to the admin origin', async function () {","+    const cookie = cookieOf(await ssoSignIn(owner.email));","+","+    assert.equal(cookie.length, 1);","+    assert.match(cookie[0], /^ghost-admin-api-session=./);","+    const [session] = await sessions(owner.id);","+    assert.equal(Boolean(session.verified), true);","+    assert.equal(session.origin, adminOrigin);","+","+    const response = await me(cookie).expect(200);","+    assert.equal(response.body.users[0].id, owner.id);","+  });","+","+  it('unlocks a locked user', async function () {","+    const cookie = cookieOf(await ssoSignIn(locked.email));","+","+    assert.equal(await statusOf(locked.id), 'active');","+    await me(cookie).expect(200);","+  });","+","+  it('refuses a suspended user', async function () {","+    const response = await ssoSignIn(inactive.email);","+","+    assert.deepEqual(cookieOf(response), []);","+    assert.equal(await statusOf(inactive.id), 'inactive');","+    assert.equal((await sessions(inactive.id)).length, 0);","+  });","+","+  it('leaves the request alone without credentials', async function () {","+    const response = await ssoSignIn();","+","+    assert.deepEqual(cookieOf(response), []);","+    assert.equal(","+      await db","+        .knex('user_sessions')","+        .count('* as n')","+        .first()","+        .then((r: { n: number }) => r.n),","+      0,","+    );","+  });","+","+  it('leaves no legacy session', async function () {","+    await ssoSignIn(owner.email);","+","+    assert.equal((await db.knex('sessions').where({ user_id: owner.id })).length, 0);","+  });","+});"],"additions":158,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/auth/better-auth/plugins/sso.test.ts","lines":["@@ -0,0 +1,131 @@","+import assert from 'node:assert/strict';","+import { betterAuth } from 'better-auth/minimal';","+import { memoryAdapter } from 'better-auth/adapters/memory';","+import { ghostSso } from '../../../../../../core/server/auth/better-auth/plugins/sso';","+import { ghostStaffLifecycle } from '../../../../../../core/server/auth/better-auth/plugins/staff-lifecycle';","+","+type Row = Record<string, unknown>;","+","+const ORIGIN = 'http://localhost:2368';","+","+function setup(users: Array<{ id: string; status: string }>) {","+  const now = new Date();","+  const db: Record<string, Row[]> = {","+    user: users.map(({ id, status }) => ({","+      id,","+      status,","+      name: id,","+      email: `${id}@example.com`,","+      emailVerified: true,","+      last_seen: null,","+      createdAt: now,","+      updatedAt: now,","+    })),","+    account: [],","+    session: [],","+    verification: [],","+  };","+","+  const auth = betterAuth({","+    baseURL: ORIGIN,","+    secret: 'a'.repeat(64),","+    database: memoryAdapter(db),","+    user: {","+      additionalFields: {","+        status: { type: 'string', required: false, input: false },","+        last_seen: { type: 'date', required: false, input: false },","+      },","+    },","+    session: {","+      additionalFields: {","+        verified: { type: 'boolean', defaultValue: false, input: false },","+        origin: { type: 'string', required: false, input: false },","+      },","+    },","+    rateLimit: { enabled: false },","+    telemetry: { enabled: false },","+    logger: { disabled: true },","+    plugins: [ghostStaffLifecycle({ sendPasswordResetEmail: async () => {} }), ghostSso()],","+  });","+","+  const user = (id: string) => db.user.find((row) => row.id === id)!;","+  const sessionsOf = (id: string) => db.session.filter((row) => row.userId === id);","+  const createSsoSession = (userId: string) =>","+    auth.api.createSsoSession({ body: { userId, origin: ORIGIN }, returnHeaders: true });","+","+  return { auth, user, sessionsOf, createSsoSession };","+}","+","+const apiError = (status: string, code: string) => (err: unknown) => {","+  const error = err as { status?: string; body?: { code?: string } };","+  assert.equal(error.status, status);","+  assert.equal(error.body?.code, code);","+  return true;","+};","+","+describe('ghostSso', function () {","+  describe('createSsoSession', function () {","+    it('creates a verified session pinned to the origin, with its cookie', async function () {","+      const { sessionsOf, user, createSsoSession } = setup([{ id: 'active', status: 'active' }]);","+","+      const { headers } = await createSsoSession('active');","+","+      const [session] = sessionsOf('active');","+      assert.equal(session.verified, true);","+      assert.equal(session.origin, ORIGIN);","+      assert.match(headers.get('set-cookie') ?? '', new RegExp(`=${session.token}\\\\.`));","+      assert.ok(user('active').last_seen instanceof Date);","+    });","+","+    it('signs in a warned user and sets them active', async function () {","+      const { sessionsOf, user, createSsoSession } = setup([{ id: 'warned', status: 'warn-1' }]);","+","+      await createSsoSession('warned');","+","+      assert.equal(sessionsOf('warned').length, 1);","+      assert.equal(user('warned').status, 'active');","+    });","+","+    it('unlocks a locked user', async function () {","+      const { sessionsOf, user, createSsoSession } = setup([{ id: 'locked', status: 'locked' }]);","+","+      await createSsoSession('locked');","+","+      assert.equal(user('locked').status, 'active');","+      assert.equal(sessionsOf('locked').length, 1);","+    });","+","+    it('refuses an inactive user', async function () {","+      const { sessionsOf, user, createSsoSession } = setup([","+        { id: 'inactive', status: 'inactive' },","+      ]);","+","+      await assert.rejects(","+        createSsoSession('inactive'),","+        apiError('FORBIDDEN', 'ACCOUNT_SUSPENDED'),","+      );","+      assert.equal(user('inactive').status, 'inactive');","+      assert.equal(sessionsOf('inactive').length, 0);","+    });","+","+    it('refuses an unknown user', async function () {","+      const { createSsoSession } = setup([]);","+","+      await assert.rejects(createSsoSession('nobody'), apiError('NOT_FOUND', 'USER_NOT_FOUND'));","+    });","+","+    it('is not served over HTTP', async function () {","+      const { auth } = setup([{ id: 'active', status: 'active' }]);","+","+      const response = await auth.handler(","+        new Request(`${ORIGIN}/api/auth/create-sso-session`, {","+          method: 'POST',","+          headers: { 'content-type': 'application/json' },","+          body: JSON.stringify({ userId: 'active', origin: ORIGIN }),","+        }),","+      );","+","+      assert.equal(response.status, 404);","+    });","+  });","+});",""],"additions":131,"deletions":0,"truncated":false}],"additions":433,"deletions":34,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-18T16:50:22.674495+00:00"}