{"id":"397478e1506965e83dae7f321ff1a30e96d5a814","axis":"silent","repo":"pnpm/pnpm","sha":"397478e1506965e83dae7f321ff1a30e96d5a814","parsed":{"files":[{"path":".changeset/calm-paths-settle.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pacquet\": patch","+---","+","+A `link:` or relative-path dependency of a local directory dependency now resolves from that directory. In any other package, such as a local tarball, it resolves from the lockfile directory. Both used to resolve from the importing project's directory [pnpm/tasks#319](https://github.com/pnpm/tasks/issues/319).","+","+Two workspace projects that declare the same injected relative-path dependency, such as `../child`, no longer share the directory the first one resolved."],"additions":7,"deletions":0,"truncated":false},{"path":".changeset/quiet-foxes-repair.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/lockfile.verification\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm install --frozen-lockfile` now fails when the `injected` setting of a dependency of a local directory dependency no longer matches the lockfile [pnpm/tasks#319](https://github.com/pnpm/tasks/issues/319)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/local_child_freshness.rs","lines":["@@ -0,0 +1,262 @@","+use crate::_utils::pacquet_in;","+","+use assert_cmd::prelude::*;","+use std::{fs, path::Path, process::Command};","+use tempfile::TempDir;","+","+fn pnpm_at(workspace: &Path) -> Command {","+    pacquet_in(workspace)","+}","+","+fn workspace() -> (TempDir, std::path::PathBuf) {","+    let root = tempfile::tempdir().expect(\"create temporary root\");","+    let workspace = root.path().join(\"workspace\");","+    fs::create_dir_all(&workspace).expect(\"create workspace\");","+    (root, workspace)","+}","+","+fn write_json(path: &Path, value: &serde_json::Value) {","+    fs::create_dir_all(path.parent().expect(\"parent directory\")).expect(\"create parent directory\");","+    fs::write(path, value.to_string()).expect(\"write JSON file\");","+}","+","+fn assert_frozen_install_is_outdated(workspace: &Path) {","+    let result = pnpm_at(workspace)","+        .args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .failure();","+    let stderr = String::from_utf8_lossy(&result.get_output().stderr);","+    assert!(stderr.contains(\"ERR_PNPM_OUTDATED_LOCKFILE\"), \"stderr: {stderr}\");","+}","+","+/// The parent is a directory outside the workspace, so no importer entry","+/// records its children and only the snapshot check can see the change.","+#[test]","+fn frozen_install_rejects_a_changed_injected_setting_of_a_local_directory_child() {","+    let (_root, workspace) = workspace();","+    write_json(&workspace.join(\"package.json\"), &serde_json::json!({ \"name\": \"root\" }));","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write workspace configuration\");","+    write_json(","+        &workspace.join(\"packages/app/package.json\"),","+        &serde_json::json!({","+            \"name\": \"app\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"lib\": \"file:../../vendor/lib\" },","+        }),","+    );","+    write_json(","+        &workspace.join(\"packages/workspace-child/package.json\"),","+        &serde_json::json!({ \"name\": \"workspace-child\", \"version\": \"1.0.0\" }),","+    );","+    write_json(","+        &workspace.join(\"vendor/path-child/package.json\"),","+        &serde_json::json!({ \"name\": \"path-child\", \"version\": \"1.0.0\" }),","+    );","+    let write_lib = |injected: &[&str]| {","+        let mut manifest = serde_json::json!({","+            \"name\": \"lib\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"path-child\": \"../path-child\", \"workspace-child\": \"workspace:*\" },","+        });","+        for child in injected {","+            manifest[\"dependenciesMeta\"][child][\"injected\"] = serde_json::json!(true);","+        }","+        write_json(&workspace.join(\"vendor/lib/package.json\"), &manifest);","+    };","+    let install = |args: &[&str]| {","+        pnpm_at(&workspace)","+            .arg(\"install\")","+            .args(args)","+            .assert()","+            .success();","+    };","+","+    write_lib(&[]);","+    install(&[]);","+    install(&[\"--frozen-lockfile\"]);","+    for injected in [&[\"path-child\"][..], &[\"workspace-child\"]] {","+        write_lib(injected);","+        assert_frozen_install_is_outdated(&workspace);","+    }","+","+    write_lib(&[\"path-child\", \"workspace-child\"]);","+    install(&[]);","+    install(&[\"--frozen-lockfile\"]);","+    for injected in [&[\"path-child\"][..], &[\"workspace-child\"]] {","+        write_lib(injected);","+        assert_frozen_install_is_outdated(&workspace);","+    }","+}","+","+#[test]","+fn a_local_tarball_child_link_is_resolved_from_the_lockfile_directory() {","+    let (_root, workspace) = workspace();","+    let app = workspace.join(\"packages/app\");","+    fs::create_dir_all(&app).expect(\"create app directory\");","+    let child = workspace.join(\"child\");","+    let decoy = app.join(\"child\");","+    fs::create_dir_all(&child).expect(\"create child directory\");","+    fs::create_dir_all(&decoy).expect(\"create importer-relative decoy directory\");","+    fs::write(child.join(\"package.json\"), r#\"{\"name\":\"child\",\"version\":\"1.0.0\"}\"#)","+        .expect(\"write child package.json\");","+    fs::write(decoy.join(\"package.json\"), r#\"{\"name\":\"child\",\"version\":\"2.0.0\"}\"#)","+        .expect(\"write importer-relative decoy package.json\");","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - packages/*\\n\")","+        .expect(\"write workspace configuration\");","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"root\",\"version\":\"1.0.0\"}\"#)","+        .expect(\"write root package.json\");","+    fs::write(","+        workspace.join(\"tpkg.tgz\"),","+        pnpm_testing_utils::fixtures::tarball_with_manifest(&serde_json::json!({","+            \"name\": \"tpkg\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"child\": \"link:child\", \"child-bare\": \"./child\" },","+        })),","+    )","+    .expect(\"write local tarball\");","+    fs::write(","+        app.join(\"package.json\"),","+        r#\"{\"name\":\"app\",\"version\":\"1.0.0\",\"dependencies\":{\"tpkg\":\"file:../../tpkg.tgz\"}}\"#,","+    )","+    .expect(\"write app package.json\");","+","+    pnpm_at(&app)","+        .arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"child: link:child\"), \"lockfile:\\n{lockfile}\");","+    assert!(lockfile.contains(\"child-bare: link:child\"), \"lockfile:\\n{lockfile}\");","+","+    let installed_tarball =","+        fs::canonicalize(app.join(\"node_modules/tpkg\")).expect(\"resolve installed tarball\");","+    let siblings = installed_tarball.parent().expect(\"directory holding the tarball's children\");","+    for alias in [\"child\", \"child-bare\"] {","+        assert_eq!(","+            fs::canonicalize(siblings.join(alias)).expect(\"resolve installed child\"),","+            fs::canonicalize(&child).expect(\"resolve child directory\"),","+            \"{alias}\",","+        );","+    }","+}","+","+#[test]","+fn a_root_local_tarball_child_keeps_its_path_resolver_shape() {","+    let (_root, workspace) = workspace();","+    let child = workspace.join(\"child\");","+    fs::create_dir_all(&child).expect(\"create child directory\");","+    fs::write(child.join(\"package.json\"), r#\"{\"name\":\"child\",\"version\":\"1.0.0\"}\"#)","+        .expect(\"write child package.json\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        r#\"{\"name\":\"root\",\"dependencies\":{\"tpkg\":\"file:tpkg.tgz\"}}\"#,","+    )","+    .expect(\"write root package.json\");","+    fs::write(","+        workspace.join(\"tpkg.tgz\"),","+        pnpm_testing_utils::fixtures::tarball_with_manifest(&serde_json::json!({","+            \"name\": \"tpkg\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"child\": \"./child\" },","+        })),","+    )","+    .expect(\"write local tarball\");","+","+    pnpm_at(&workspace)","+        .arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"child: link:child\"), \"lockfile:\\n{lockfile}\");","+}","+","+#[test]","+fn local_directory_children_are_scoped_to_their_parent_directory() {","+    let (_root, workspace) = workspace();","+    fs::write(workspace.join(\"package.json\"), r#\"{\"name\":\"root\",\"dependencies\":{\"first\":\"file:packages/first/parent\",\"second\":\"file:packages/second/parent\"}}\"#)","+        .expect(\"write root package.json\");","+    for (parent, child_name) in [(\"first\", \"first-child\"), (\"second\", \"second-child\")] {","+        let parent_dir = workspace","+            .join(\"packages\")","+            .join(parent)","+            .join(\"parent\");","+        let child = workspace","+            .join(\"packages\")","+            .join(parent)","+            .join(\"child\");","+        fs::create_dir_all(&parent_dir).expect(\"create parent directory\");","+        fs::create_dir_all(&child).expect(\"create child directory\");","+        let mut manifest = serde_json::json!({ \"name\": parent, \"version\": \"1.0.0\" });","+        manifest[\"dependencies\"][child_name] = serde_json::json!(\"../child\");","+        fs::write(parent_dir.join(\"package.json\"), manifest.to_string())","+            .expect(\"write parent package.json\");","+        fs::write(","+            child.join(\"package.json\"),","+            serde_json::json!({ \"name\": child_name, \"version\": \"1.0.0\" }).to_string(),","+        )","+        .expect(\"write child package.json\");","+    }","+","+    pnpm_at(&workspace)","+        .arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"first-child: link:packages/first/child\"), \"lockfile:\\n{lockfile}\");","+    assert!(lockfile.contains(\"second-child: link:packages/second/child\"), \"lockfile:\\n{lockfile}\");","+","+    pnpm_at(&workspace)","+        .args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+}","+","+#[test]","+fn injected_children_with_the_same_relative_path_stay_apart_across_importers() {","+    let (_root, workspace) = workspace();","+    write_json(&workspace.join(\"package.json\"), &serde_json::json!({ \"name\": \"root\" }));","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages:\\n  - '*/app'\\n\")","+        .expect(\"write workspace configuration\");","+    for group in [\"first\", \"second\"] {","+        let group_dir = workspace.join(group);","+        write_json(","+            &group_dir.join(\"app/package.json\"),","+            &serde_json::json!({","+                \"name\": format!(\"{group}-app\"),","+                \"version\": \"1.0.0\",","+                \"dependencies\": { \"lib\": \"file:../lib\" },","+            }),","+        );","+        write_json(","+            &group_dir.join(\"lib/package.json\"),","+            &serde_json::json!({","+                \"name\": format!(\"{group}-lib\"),","+                \"version\": \"1.0.0\",","+                \"dependencies\": { \"child\": \"../child\" },","+                \"dependenciesMeta\": { \"child\": { \"injected\": true } },","+            }),","+        );","+        write_json(","+            &group_dir.join(\"child/package.json\"),","+            &serde_json::json!({ \"name\": \"child\", \"version\": \"1.0.0\" }),","+        );","+    }","+","+    pnpm_at(&workspace)","+        .arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"child: file:first/child\"), \"lockfile:\\n{lockfile}\");","+    assert!(lockfile.contains(\"child: file:second/child\"), \"lockfile:\\n{lockfile}\");","+","+    pnpm_at(&workspace)","+        .args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+}"],"additions":262,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -106,6 +106,7 @@ mod lifecycle_scripts;"," mod link;"," mod linker_parity;"," mod list;","+mod local_child_freshness;"," mod local_directory_manifest_hooks;"," mod local_directory_without_manifest;"," mod local_override_metadata_cache;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/local-spec/src/lib.rs","lines":["@@ -124,13 +124,16 @@ impl LocalSpec {","         // disagrees on Windows about a rooted path carrying no drive","         // prefix and would re-anchor one the resolver resolves from the","         // filesystem root.","+        let home_relative_path = pkg_path.strip_prefix(\"~/\");","         let specified_via_relative_path =","-            !names_its_own_location(pkg_path) && !pkg_path.starts_with(\"~/\");","-        let absolute_path = lexical_normalize(&if specified_via_relative_path {","-            base_dir.join(candidate)","-        } else {","-            candidate.to_path_buf()","-        });","+            !names_its_own_location(pkg_path) && home_relative_path.is_none();","+        let absolute_path = match home_relative_path {","+            // Normalized below the `~`, which `..` must not cancel: the","+            // resolver expands it to the home directory first.","+            Some(below_home) => Path::new(\"~\").join(lexical_normalize(Path::new(below_home))),","+            None if specified_via_relative_path => lexical_normalize(&base_dir.join(candidate)),","+            None => lexical_normalize(candidate),","+        };","         LocalSpec { protocol, absolute_path, specified_via_relative_path }","     }"," "],"additions":9,"deletions":6,"truncated":false},{"path":"pnpm/crates/local-spec/src/tests.rs","lines":["@@ -70,6 +70,19 @@ fn leaves_a_home_relative_specifier_alone() {","     }"," }"," ","+#[test]","+fn keeps_a_home_relative_specifier_that_leaves_the_home_directory() {","+    for specifier in [\"link:~/../shared\", \"file:~/../shared/x.tgz\"] {","+        assert_eq!(render(specifier, Some(\"packages/foo\")), specifier);","+        assert_eq!(render(specifier, None), specifier);","+    }","+    assert_eq!(","+        render_filesystem(\"~/../shared\", Some(\"packages/foo\")).as_deref(),","+        Some(\"~/../shared\"),","+    );","+    assert_eq!(render(r\"link:~\\..\\shared\", Some(\"packages/foo\")), \"link:~/../shared\");","+}","+"," /// A home-relative path is recognized only after normalization, so the"," /// backslash spelling needs its own case: were the two ever reordered,"," /// this form would be re-anchored under the workspace instead."],"additions":13,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/children.rs","lines":["@@ -218,12 +218,14 @@ fn implicit_workspace_target_satisfies(","         && !super::is_declared_by_path(&child.bare_specifier)","     {","         let spec = child.bare_specifier.strip_prefix(\"npm:\").unwrap_or(&child.bare_specifier);","+        let workspace_spec = format!(\"workspace:{spec}\");","         return Some(","             super::spec::spec_satisfies_snapshot_dep(","                 &dep.dirs,","                 dep.dir,","                 &child.alias,","-                &format!(\"workspace:{spec}\"),","+                &workspace_spec,","+                None,","                 recorded,","             )","             .unwrap_or(false),","@@ -305,8 +307,24 @@ fn recorded_child_satisfies_spec(","     child: &DependencySpec,","     recorded: &pnpm_lockfile::SnapshotDepRef,"," ) -> bool {","-    spec_satisfies_snapshot_dep(&dep.dirs, dep.dir, &child.alias, &child.bare_specifier, recorded)","-        .unwrap_or(check.optional_exclusions.frozen_lockfile)","+    spec_satisfies_snapshot_dep(","+        &dep.dirs,","+        dep.dir,","+        &child.alias,","+        &child.bare_specifier,","+        Some(child_is_injected(check, child)),","+        recorded,","+    )","+    .unwrap_or(check.optional_exclusions.frozen_lockfile)","+}","+","+fn child_is_injected(check: &ImporterSatisfactionCheck<'_>, child: &DependencySpec) -> bool {","+    child.injected","+        || (child.bare_specifier.starts_with(\"workspace:\")","+            && (check.config.inject_workspace_packages","+                || check.lockfile.settings","+                    .as_ref()","+                    .is_some_and(|settings| settings.inject_workspace_packages)))"," }"," "," /// Which of a snapshot's two dependency maps a child is recorded in."],"additions":21,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/spec.rs","lines":["@@ -33,8 +33,15 @@ pub(super) fn spec_satisfies_snapshot_dep(","     local_dep_dir: &Path,","     dep_name: &str,","     spec: &str,","+    injected: Option<bool>,","     lockfile_dep: &pnpm_lockfile::SnapshotDepRef,"," ) -> Option<bool> {","+    if let Some(injected) = injected","+        && uses_injection_setting(spec)","+        && lockfile_dep.as_link_target().is_none() != injected","+    {","+        return Some(false);","+    }","     if let Some(matches) =","         file_or_link_spec_satisfies(dirs.lockfile_dir, local_dep_dir, spec, lockfile_dep)","     {","@@ -56,6 +63,10 @@ pub(super) fn spec_satisfies_snapshot_dep(","     npm_or_registry_spec_satisfies(dirs.registries, dep_name, spec, lockfile_dep)"," }"," ","+fn uses_injection_setting(spec: &str) -> bool {","+    spec.starts_with(\"workspace:\") || (bare_path_is_unambiguous(spec) && !is_tarball_filename(spec))","+}","+"," /// Whether a spec that names one exact source, a tarball URL or a git"," /// commit, asks for a source other than the one the child is locked to. The"," /// lockfile keys such a child by the URL or commit it resolved."],"additions":11,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/spec/tests.rs","lines":["@@ -349,8 +349,77 @@ fn local_spec_satisfies(","     spec: &str,","     lockfile_dep: &pnpm_lockfile::SnapshotDepRef,"," ) -> bool {","-    super::spec_satisfies_snapshot_dep(dirs, local_dep_dir, dep_name, spec, lockfile_dep)","-        .expect(\"a local spec is judged\")","+    local_spec_satisfies_injected(","+        dirs,","+        local_dep_dir,","+        dep_name,","+        spec,","+        lockfile_dep.as_link_target().is_none(),","+        lockfile_dep,","+    )","+}","+","+fn local_spec_satisfies_injected(","+    dirs: &SpecDirs<'_>,","+    local_dep_dir: &Path,","+    dep_name: &str,","+    spec: &str,","+    injected: bool,","+    lockfile_dep: &pnpm_lockfile::SnapshotDepRef,","+) -> bool {","+    super::spec_satisfies_snapshot_dep(","+        dirs,","+        local_dep_dir,","+        dep_name,","+        spec,","+        Some(injected),","+        lockfile_dep,","+    )","+    .expect(\"a local spec is judged\")","+}","+","+#[test]","+fn local_child_injection_setting_must_match_the_lockfile_reference_kind() {","+    let workspace_root = PathBuf::from(\"/workspace\");","+    let local_dep_dir = workspace_root.join(\"packages/injected\");","+    let dirs = dirs(&workspace_root, &workspace_root);","+    let linked: pnpm_lockfile::SnapshotDepRef = \"link:packages/child\".parse().unwrap();","+    let injected: pnpm_lockfile::SnapshotDepRef = \"file:packages/child\".parse().unwrap();","+","+    for spec in [\"../child\", \"workspace:../child\"] {","+        assert!(local_spec_satisfies_injected(","+            &dirs,","+            &local_dep_dir,","+            \"child\",","+            spec,","+            false,","+            &linked","+        ));","+        assert!(!local_spec_satisfies_injected(","+            &dirs,","+            &local_dep_dir,","+            \"child\",","+            spec,","+            true,","+            &linked","+        ));","+        assert!(local_spec_satisfies_injected(","+            &dirs,","+            &local_dep_dir,","+            \"child\",","+            spec,","+            true,","+            &injected","+        ));","+        assert!(!local_spec_satisfies_injected(","+            &dirs,","+            &local_dep_dir,","+            \"child\",","+            spec,","+            false,","+            &injected","+        ));","+    }"," }"," "," #[test]"],"additions":71,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/tree_ctx.rs","lines":["@@ -4,6 +4,9 @@"," //! `workspace:` path specifiers resolved against their declaring"," //! manifest's directory."," ","+pub(super) use child_spec::opts_for_child_spec;","+mod child_spec;","+"," use chrono::{DateTime, Utc};"," use pnpm_catalogs_types::Catalogs;"," use pnpm_hooks::PnpmfileHooks;","@@ -13,7 +16,6 @@ use pnpm_resolving_resolver_base::{"," };"," use rustc_hash::{FxHashMap as HashMap, FxHashSet as HashSet};"," use std::{","-    borrow::Cow,","     path::{Path, PathBuf},","     sync::{Arc, OnceLock},"," };","@@ -31,9 +33,9 @@ use super::{"," /// Whether a wanted dep's resolution is computed relative to the"," /// consuming importer's directory rather than being"," /// importer-independent. True for the `link:` / `file:` / `workspace:`","-/// protocols, whose resolved path `resolve_from_local_package` derives","-/// from `project_dir`. Such resolutions must not be shared across","-/// importers in [`WantedKey`].","+/// protocols and for a bare local path, whose resolved path","+/// `resolve_from_local_package` derives from `project_dir`. Such","+/// resolutions must not be shared across importers in [`WantedKey`]."," ///"," /// [`WantedKey`]: super::workspace_ctx::WantedKey"," pub(super) fn project_relative_cache_scope(","@@ -43,7 +45,10 @@ pub(super) fn project_relative_cache_scope(","     (wanted.bare_specifier","         .as_deref()","         .is_some_and(|spec| {","-            spec.starts_with(\"link:\") || spec.starts_with(\"file:\") || spec.starts_with(\"workspace:\")","+            spec.starts_with(\"link:\")","+                || spec.starts_with(\"file:\")","+                || spec.starts_with(\"workspace:\")","+                || pnpm_local_spec::bare_path_is_unambiguous(spec)","         })","         || (opts.project.link_workspace_packages.enabled_at_depth(0)","             && opts.project.workspace_packages.is_some()))","@@ -91,30 +96,6 @@ pub(crate) fn resolves_from_declaring_manifest(spec: &str) -> bool {","     spec.starts_with(\"file:\") || pnpm_workspace_spec::is_workspace_path_specifier(spec)"," }"," ","-/// Point a specifier matching [`resolves_from_declaring_manifest`] at","-/// its declaring manifest's directory. Every other specifier keeps the","-/// caller's options.","-pub(super) fn opts_relative_to_declaring_manifest<'a>(","-    opts: &'a ResolveOptions,","-    wanted: &WantedDependency,","-    parent_dir: Option<&Path>,","-) -> Cow<'a, ResolveOptions> {","-    match parent_dir {","-        Some(parent_dir)","-            if wanted.bare_specifier.as_deref().is_some_and(resolves_from_declaring_manifest) =>","-        {","-            Cow::Owned(ResolveOptions {","-                project: pnpm_resolving_resolver_base::ResolverProjectOptions {","-                    project_dir: parent_dir.to_path_buf(),","-                    ..opts.project.clone()","-                },","-                ..opts.clone()","-            })","-        }","-        _ => Cow::Borrowed(opts),","-    }","-}","-"," /// Mutable workspace for an in-flight tree walk. The orchestrator"," /// (`resolve_importer`) holds one of these across hoist iterations and"," /// extends it via [`extend_tree`] so newly-hoisted peer dependencies"],"additions":10,"deletions":29,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/tree_ctx/child_spec.rs","lines":["@@ -0,0 +1,54 @@","+use super::resolves_from_declaring_manifest;","+use pnpm_resolving_resolver_base::{ResolveOptions, WantedDependency};","+use std::{borrow::Cow, path::Path};","+","+/// Point a child's local specifier at the directory it is written from.","+///","+/// - A `link:` or bare-path child is written from `parent_dir`, or from","+///   `fallback_dir` when its parent has no directory. Its specifier is","+///   rewritten to name the same target from the importer, because the","+///   `link:` id the resolver returns is read relative to the importer.","+/// - A specifier matching [`resolves_from_declaring_manifest`] resolves","+///   with `parent_dir` as the project directory.","+/// - Every other specifier keeps the caller's options.","+pub(in crate::resolve_dependency_tree) fn opts_for_child_spec<'a>(","+    opts: &'a ResolveOptions,","+    wanted: &mut WantedDependency,","+    parent_dir: Option<&Path>,","+    fallback_dir: Option<&Path>,","+) -> Cow<'a, ResolveOptions> {","+    let spec = wanted.bare_specifier.as_deref().unwrap_or_default();","+    if let Some(base_dir) = parent_dir.or(fallback_dir)","+        && let Some(spec) = local_child_specifier(spec, base_dir, &opts.project.project_dir)","+    {","+        wanted.bare_specifier = Some(spec);","+        return Cow::Borrowed(opts);","+    }","+    match parent_dir {","+        Some(parent_dir) if resolves_from_declaring_manifest(spec) => Cow::Owned(ResolveOptions {","+            project: pnpm_resolving_resolver_base::ResolverProjectOptions {","+                project_dir: parent_dir.to_path_buf(),","+                ..opts.project.clone()","+            },","+            ..opts.clone()","+        }),","+        _ => Cow::Borrowed(opts),","+    }","+}","+","+/// The `link:` or bare-path `spec` written from `base_dir`, as the importer","+/// names it. `None` for every other specifier.","+///","+/// A bare path stays relative: an absolute one opens with a drive letter on","+/// Windows, which a named-registry alias claims first.","+fn local_child_specifier(spec: &str, base_dir: &Path, importer_dir: &Path) -> Option<String> {","+    let is_link = spec.starts_with(\"link:\");","+    if !is_link && !pnpm_local_spec::bare_path_is_unambiguous(spec) {","+        return None;","+    }","+    pnpm_local_spec::LocalSpec::parse_filesystem(spec, base_dir)","+        .map(|local_spec| local_spec.render((!is_link).then_some(importer_dir)))","+}","+","+#[cfg(test)]","+mod tests;"],"additions":54,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/tree_ctx/child_spec/tests.rs","lines":["@@ -0,0 +1,38 @@","+use super::local_child_specifier;","+","+#[test]","+fn local_child_specifiers_keep_resolver_paths_unambiguous() {","+    let lockfile_dir = std::env::current_dir().unwrap().join(\"workspace\");","+    let importer_dir = lockfile_dir.join(\"packages/app\");","+    let absolute_path = lockfile_dir","+        .join(\"child\")","+        .display()","+        .to_string()","+        .replace('\\\\', \"/\");","+","+    assert_eq!(","+        local_child_specifier(\"link:child\", &lockfile_dir, &importer_dir),","+        Some(format!(\"link:{absolute_path}\")),","+    );","+    assert_eq!(","+        local_child_specifier(\"./child\", &lockfile_dir, &importer_dir),","+        Some(\"../../child\".to_string()),","+    );","+    assert_eq!(","+        local_child_specifier(\"link:~/child\", &lockfile_dir, &importer_dir),","+        Some(\"link:~/child\".to_string()),","+    );","+    assert_eq!(","+        local_child_specifier(&format!(\"link:{absolute_path}\"), &lockfile_dir, &importer_dir),","+        Some(format!(\"link:{absolute_path}\")),","+    );","+}","+","+#[test]","+fn local_child_specifiers_keep_unambiguous_local_path_shapes() {","+    let lockfile_dir = std::env::current_dir().unwrap().join(\"workspace\");","+    assert_eq!(","+        local_child_specifier(\"./child\", &lockfile_dir, &lockfile_dir),","+        Some(\"./child\".to_string()),","+    );","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/walk.rs","lines":["@@ -94,8 +94,7 @@ use super::{","         wanted_lockfile_contains_satisfying_entry,","     },","     tree_ctx::{","-        TreeCtx, declaring_manifest_dir, opts_relative_to_declaring_manifest,","-        project_relative_cache_scope,","+        TreeCtx, declaring_manifest_dir, opts_for_child_spec, project_relative_cache_scope,","     },","     update_scope::{is_update_target, update_unpins_edge},","     workspace_ctx::{"],"additions":1,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/walk/edge_resolution.rs","lines":["@@ -8,7 +8,7 @@ use super::{","     current_pkg_from_lockfile, dependencies_named_as_peers, emit_deprecation_if_needed,","     ensure_same_registry_revision, failed_edge::SkippedOptionalReport, is_exotic_resolved_via,","     is_update_target, keeps_locked_runtime, keeps_locked_version, lock_recoverable, node_alias,","-    node_depends_on_changed_direct_dep, opts_relative_to_declaring_manifest, overlay_version_view,","+    node_depends_on_changed_direct_dep, opts_for_child_spec, overlay_version_view,","     package_root_link_result, parent_ids_contain_sequence, peer_shadowed_dependencies,","     pin_locked_version, pin_patched_revision, project_relative_cache_scope,","     register_shadowable_dep_na