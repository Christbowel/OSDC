","+\tif (cached.IsSuccess()) {","+\t\tREQUIRE(cached.HasParseResult());","+\t\tREQUIRE(cached.GetParseResult()->name == \"nested result\");","+\t}","+}","+","+TEST_CASE(\"Compiled grammar processes use arena ownership\", \"[api][grammar_extension]\") {","+\tvector<MatcherToken> tokens;","+\tTokenIterator iterator(tokens);","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator parse_results;","+\tidx_t max_token_index = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, parse_results, process_allocator, max_token_index);","+\tMatchState state(iterator, context);","+\tauto grammar = CompiledGrammar::Create();","+\tauto process = grammar->TopLevelStatementMatcher().StartMatch(state);","+\tREQUIRE(process);","+\tREQUIRE(process_allocator.SizeInBytes() > 0);","+\tprocess.reset();","+\tprocess_allocator.Reset();","+\tREQUIRE(process_allocator.SizeInBytes() == 0);","+}","+"," TEST_CASE(\"Grammar changes expose structured metadata\", \"[api][grammar_extension]\") {"," \tauto add_rule = GrammarChange::AddRule(\"TrackedRule <- 'tracked'\");"," \tREQUIRE(add_rule.Type() == GrammarChangeType::ADD_RULE);",""],"additions":298,"deletions":7,"truncated":false}],"additions":361,"deletions":39,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-09-09T13:49:27.589359+00:00"}