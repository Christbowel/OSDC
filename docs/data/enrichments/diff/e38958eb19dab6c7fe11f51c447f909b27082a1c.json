t);","+\tMatchProcessLifetimeState lifetime;","+\tArenaNestedTestMatcher matcher(lifetime);","+","+\tSECTION(\"Repeated executions preserve process storage and destruction order\") {","+\t\tMatchStack stack;","+\t\tfor (idx_t depth :","+\t\t     {idx_t(1), idx_t(64), idx_t(65), idx_t(128), idx_t(129), idx_t(130), idx_t(33), idx_t(130)}) {","+\t\t\tprocess_allocator.Reset();","+\t\t\tlifetime.depth = depth;","+\t\t\tlifetime.started = 0;","+\t\t\tlifetime.destroyed.clear();","+\t\t\tREQUIRE(stack.Execute({matcher, state}).IsSuccess());","+\t\t\tREQUIRE(lifetime.started == depth);","+\t\t\tREQUIRE(lifetime.active == 0);","+\t\t\tREQUIRE(lifetime.storage_valid);","+\t\t\tREQUIRE(lifetime.state_valid);","+\t\t\tREQUIRE(lifetime.destroyed.size() == depth);","+\t\t\tfor (idx_t i = 0; i < depth; i++) {","+\t\t\t\tREQUIRE(lifetime.destroyed[i] == depth - i);","+\t\t\t}","+\t\t}","+\t}","+","+\tSECTION(\"Resume exceptions destroy arena children before their parents\") {","+\t\tlifetime.throw_at_leaf = true;","+\t}","+\tSECTION(\"Constructor exceptions destroy constructed members and parent processes\") {","+\t\tlifetime.throw_in_constructor = true;","+\t}","+\tSECTION(\"Siblings preserve process storage while their parent stays alive\") {","+\t\tlifetime.depth = 65;","+\t\tlifetime.root_children = 2;","+\t\tMatchStack stack;","+\t\tREQUIRE(stack.Execute({matcher, state}).IsSuccess());","+\t\tREQUIRE(lifetime.active == 0);","+\t\tREQUIRE(lifetime.storage_valid);","+\t\tREQUIRE(lifetime.state_valid);","+\t\tREQUIRE(lifetime.started == 1 + 2 * (lifetime.depth - 1));","+\t}","+\tif (lifetime.throw_at_leaf || lifetime.throw_in_constructor) {","+\t\tlifetime.depth = 130;","+\t\t{","+\t\t\tMatchStack stack;","+\t\t\tREQUIRE_THROWS_AS(stack.Execute({matcher, state}), InvalidInputException);","+\t\t}","+\t\tREQUIRE(lifetime.active == 0);","+\t\tREQUIRE(lifetime.started == lifetime.depth);","+\t\tREQUIRE(lifetime.storage_valid);","+\t\tREQUIRE(lifetime.state_valid);","+\t\tREQUIRE(lifetime.destroyed.size() == lifetime.depth);","+\t\tfor (idx_t i = 0; i < lifetime.depth; i++) {","+\t\t\tREQUIRE(lifetime.destroyed[i] == lifetime.depth - i);","+\t\t}","+\t}","+}","+","+TEST_CASE(\"Recursive matcher preserves arena process storage and unwinds safely\", \"[api][grammar_extension]\") {","+\tvector<MatcherToken> tokens;","+\tTokenIterator iterator(tokens);","+\tvector<MatcherSuggestion> suggestions;","+\tParseResultAllocator parse_results;","+\tidx_t max_token_index = 0;","+\tArenaAllocator process_allocator(Allocator::DefaultAllocator());","+\tMatchContext context(suggestions, parse_results, process_allocator, max_token_index);","+\tcontext.use_heap_based_parser = false;","+\tMatchState state(iterator, context);","+\tMatchProcessLifetimeState lifetime;","+\tlifetime.depth = 130;","+\tlifetime.destroyed.reserve(lifetime.depth);","+\tArenaNestedTestMatcher matcher(lifetime);","+","+\tSECTION(\"Siblings preserve storage while their parent remains alive\") {","+\t\tlifetime.root_children = 2;","+\t}","+\tSECTION(\"Failed matches destroy every process\") {","+\t\tlifetime.fail_at_leaf = true;","+\t}","+\tSECTION(\"Resume exceptions unwind children before parents\") {","+\t\tlifetime.throw_at_leaf = true;","+\t}","+\tSECTION(\"Constructor exceptions unwind children before parents\") {","+\t\tlifetime.throw_in_constructor = true;","+\t}","+","+\tif (lifetime.throw_at_leaf || lifetime.throw_in_constructor) {","+\t\tREQUIRE_THROWS_AS(matcher.MatchParseResult(state), InvalidInputException);","+\t} else {","+\t\tREQUIRE(matcher.MatchParseResult(state).IsSuccess() == !lifetime.fail_at_leaf);","+\t}","+\tauto child_count = lifetime.depth - 1;","+\tREQUIRE(lifetime.active == 0);","+\tREQUIRE(lifetime.storage_valid);","+\tREQUIRE(lifetime.state_valid);","+\tREQUIRE(lifetime.started == 1 + lifetime.root_children * child_count);","+\tREQUIRE(lifetime.destroyed.size() == lifetime.started);","+\tfor (idx_t sibling = 0; sibling < lifetime.root_children; sibling++) {","+\