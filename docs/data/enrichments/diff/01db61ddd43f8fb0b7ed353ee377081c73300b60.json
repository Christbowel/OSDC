alidateInitialization(); err != nil {"," \t\treturn err"," \t}","+\t// Logged so the effective order can be diffed across API servers: a staticOrder","+\t// rolled out to only part of an HA control plane changes mutation order depending","+\t// on which instance served the request. Without manifest-based webhooks there is","+\t// nothing to merge, so the line would only be noise.","+\tif staticManifestsDir := a.Webhook.GetStaticManifestsDir(); len(staticManifestsDir) > 0 {","+\t\tklog.InfoS(\"Configured mutating webhook merge order\", \"plugin\", PluginName, \"staticManifestsDir\", staticManifestsDir, \"staticOrder\", a.Webhook.GetStaticOrder())","+\t}"," \treturn nil"," }"," "],"additions":8,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/mutating/staticorder_test.go","lines":["@@ -0,0 +1,149 @@","+/*","+Copyright The Kubernetes Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package mutating","+","+import (","+\t\"bytes\"","+\t\"context\"","+\t\"fmt\"","+\t\"io\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"k8s.io/apiserver/pkg/admission/plugin/webhook\"","+\t\"k8s.io/apiserver/pkg/admission/plugin/webhook/config/apis/webhookadmission\"","+\t\"k8s.io/apiserver/pkg/admission/plugin/webhook/generic\"","+\twebhooktesting \"k8s.io/apiserver/pkg/admission/plugin/webhook/testing\"","+\t\"k8s.io/apiserver/pkg/features\"","+\tutilfeature \"k8s.io/apiserver/pkg/util/feature\"","+\tfeaturegatetesting \"k8s.io/component-base/featuregate/testing\"","+\t\"k8s.io/klog/v2\"","+)","+","+// TestStaticOrderAccepted verifies that the MutatingAdmissionWebhook plugin accepts","+// every supported merge order.","+func TestStaticOrderAccepted(t *testing.T) {","+\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.ManifestBasedAdmissionControlConfig, true)","+\tmanifestsDir := t.TempDir()","+","+\tfor _, staticOrder := range []webhookadmission.StaticOrder{\"\", webhookadmission.StaticFirst, webhookadmission.StaticLast, webhookadmission.ByName} {","+\t\tt.Run(string(staticOrder), func(t *testing.T) {","+\t\t\tconfigFile := fmt.Sprintf(`","+kind: WebhookAdmissionConfiguration","+apiVersion: apiserver.config.k8s.io/v1","+staticManifestsDir: %q","+staticOrder: %q","+`, manifestsDir, staticOrder)","+","+\t\t\tp, err := NewMutatingWebhook(bytes.NewBufferString(configFile))","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"expected no error, got %v\", err)","+\t\t\t}","+\t\t\twant := staticOrder","+\t\t\tif len(want) == 0 {","+\t\t\t\twant = webhookadmission.StaticFirst","+\t\t\t}","+\t\t\tif got := p.Webhook.GetStaticOrder(); got != want {","+\t\t\t\tt.Fatalf(\"expected StaticOrder %q, got %q\", want, got)","+\t\t\t}","+\t\t})","+\t}","+}","+","+// TestStaticOrderStartupLog verifies that the effective merge order is logged at startup","+// only when manifest-based webhooks are configured. Without staticManifestsDir there is","+// nothing to merge, so the line would be noise on every API server.","+func TestStaticOrderStartupLog(t *testing.T) {","+\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.ManifestBasedAdmissionControlConfig, true)","+\tmanifestsDir := t.TempDir()","+","+\ttestCases := []struct {","+\t\tname       string","+\t\tconfigFile io.Reader","+\t\twantLog    []string","+\t}{","+\t\t{","+\t\t\tname: \"no staticManifestsDir\",","+\t\t},","+\t\t{","+\t\t\tname: \"staticManifestsDir with staticOrder\",","+\t\t\tconfigFile: bytes.NewBufferString(fmt.Sprintf(`","+kind: WebhookAdmissionConfiguration","+apiVersion: apiserver.config.k8s.io/v1","+staticManifestsDir: %q","+staticOrder: ByName","+`, manifestsDir)),","+\t\t\twantLog: []string{","+\t\t\t\t`\"Configured mutating webhook merge order\"`,","+\t\t\t\t`plugin=\"MutatingAdmissionWebhook\"`,","+\t\t\t\tfmt.Sprintf(`staticManifestsDir=%q`, manifestsDir),","+\t\t\t\t`staticOrder=\"ByName\"`,","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tc := range testCases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tvar buf bytes.Buffer","+\t\t\tklog.SetOutput(&buf)","+\t\t\tklog.LogToStderr(false)","+\t\t\tt.Cleanup(func() {","+\t\t\t\tklog.SetOutput(io.Discard)","+\t\t\t\tklog.LogToStderr(true)","+\t\t\t})","+","+\t\t\tstopCh := make(chan struct{})","+\t\t\tt.Cleanup(func() { close(stopCh) })","+","+\t\t\twh, err := NewMutatingWebhook(tc.configFile)","+\t\t\tif err != nil {","+\t\t\t\tt.Fatalf(\"failed to create mutating webhook: %v\", err)","+\t\t\t}","+\t\t\tclient, informer := webhooktesting.NewFakeMutatingDataSource(\"default\", nil, stopCh)","+\t\t\twh.SetExternalKubeClientSet(client)","+\t\t\twh.SetExternalKubeInformerFactory(informer)","+\t\t\twh.SetDrainedNotification(stopCh)","+\t\t\twh.SetStaticSourceFactory(func(string) (generic.ReloadableSource, error) {","+\t\t\t\treturn emptyReloadableSource{}, nil","+\t\t\t})","+\t\t\tif err := wh.ValidateInitialization(); err != nil {","+\t\t\t\tt.Fatalf(\"failed to validate initialization: %v\", err)","+\t\t\t}","+\t\t\tklog.Flush()","+","+\t\t\tgot := buf.String()","+\t\t\tif len(tc.wantLog) == 0 {","+\t\t\t\tif strings.Contains(got, \"merge order\") {","+\t\t\t\t\tt.Fatalf(\"expected no merge order log line, got:\\n%s\", got)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tfor _, want := range tc.wantLog {","+\t\t\t\tif !strings.Contains(got, want) {","+\t\t\t\t\tt.Errorf(\"expected log output to contain %s, got:\\n%s\", want, got)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+// emptyReloadableSource is a manifest-based webhook source with no webhooks.","+type emptyReloadableSource struct{}","+","+func (emptyReloadableSource) Webhooks() []webhook.WebhookAccessor { return nil }","+func (emptyReloadableSource) HasSynced() bool                     { return true }","+func (emptyReloadableSource) RunReloadLoop(ctx context.Context)   { <-ctx.Done() }"],"additions":149,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/validating/plugin.go","lines":["@@ -18,11 +18,14 @@ package validating"," "," import ("," \t\"context\"","+\t\"fmt\""," \t\"io\""," ","+\t\"k8s.io/apimachinery/pkg/util/validation/field\""," \t\"k8s.io/apiserver/pkg/admission\""," \t\"k8s.io/apiserver/pkg/admission/configuration\""," \t\"k8s.io/apiserver/pkg/admission/initializer\"","+\t\"k8s.io/apiserver/pkg/admission/plugin/webhook/config/apis/webhookadmission\""," \t\"k8s.io/apiserver/pkg/admission/plugin/webhook/generic\""," \t\"k8s.io/apiserver/pkg/admission/plugin/webhook/manifest/source\""," )","@@ -76,6 +79,13 @@ func NewValidatingAdmissionWebhook(configFile io.Reader) (*Plugin, error) {"," \tif err != nil {"," \t\treturn nil, err"," \t}","+\t// Validating webhooks are dispatched in parallel against the same object, so the","+\t// merge order between manifest-based and API-based webhooks is not observable.","+\t// Reject anything but the default rather than silently ignoring the request.","+\tif staticOrder := p.Webhook.GetStaticOrder(); staticOrder != webhookadmission.StaticFirst {","+\t\treturn nil, field.Invalid(field.NewPath(\"staticOrder\"), staticOrder,","+\t\t\tfmt.Sprintf(\"only %q is supported by %s\", webhookadmission.StaticFirst, PluginName))","+\t}"," \treturn p, nil"," }"," "],"additions":10,"deletions":0,"truncated":false},{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/validating/staticorder_test.go","lines":["@@ -0,0 +1,84 @@","+/*","+Copyright The Kubernetes 