 _, tc := range testcases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tconfigFile := fmt.Sprintf(`","+kind: WebhookAdmissionConfiguration","+apiVersion: apiserver.config.k8s.io/v1","+staticManifestsDir: %q","+staticOrder: %q","+`, manifestsDir, tc.staticOrder)","+","+\t\t\t_, err := NewValidatingAdmissionWebhook(bytes.NewBufferString(configFile))","+\t\t\tif len(tc.expectErr) == 0 {","+\t\t\t\tif err != nil {","+\t\t\t\t\tt.Fatalf(\"expected no error, got %v\", err)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif err == nil {","+\t\t\t\tt.Fatalf(\"expected error %q, got none\", tc.expectErr)","+\t\t\t}","+\t\t\tif err.Error() != tc.expectErr {","+\t\t\t\tt.Fatalf(\"expected error %q, got %q\", tc.expectErr, err.Error())","+\t\t\t}","+\t\t})","+\t}","+}",""],"additions":84,"deletions":0,"truncated":false}],"additions":456,"deletions":14,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-21T13:28:15.972890+00:00"}