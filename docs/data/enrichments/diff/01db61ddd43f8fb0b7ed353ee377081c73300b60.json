{"id":"01db61ddd43f8fb0b7ed353ee377081c73300b60","axis":"silent","repo":"kubernetes/kubernetes","sha":"01db61ddd43f8fb0b7ed353ee377081c73300b60","parsed":{"files":[{"path":"staging/src/k8s.io/apiserver/pkg/admission/plugin/webhook/generic/composite_webhook_source.go","lines":["@@ -17,16 +17,21 @@ limitations under the License."," package generic"," "," import (","+\t\"slices\"","+\t\"strings\""," \t\"sync\""," "," \t\"k8s.io/apiserver/pkg/admission/plugin/webhook\"","+\t\"k8s.io/apiserver/pkg/admission/plugin/webhook/config/apis/webhookadmission\""," )"," "," // compositeWebhookSource combines multiple webhook sources into a single source.","-// Static (manifest-based) webhooks are returned before API-based webhooks.","+// The relative order of static (manifest-based) and API-based webhooks is determined","+// by staticOrder."," type compositeWebhookSource struct {"," \tstaticSource Source"," \tapiSource    Source","+\tstaticOrder  webhookadmission.StaticOrder"," "," \tmu              sync.RWMutex"," \tlastStaticSlice []webhook.WebhookAccessor","@@ -36,21 +41,23 @@ type compositeWebhookSource struct {"," "," var _ Source = &compositeWebhookSource{}"," ","-// NewCompositeWebhookSource creates a webhook source that combines static and API-based sources.","-// Static webhooks are evaluated first, followed by API-based webhooks.","+// newCompositeWebhookSource creates a webhook source that combines static and API-based","+// sources using staticOrder, which callers are expected to have validated and normalized","+// (see NewWebhook)."," // If staticSource is nil, only apiSource webhooks are returned.","-func NewCompositeWebhookSource(staticSource, apiSource Source) Source {","+func newCompositeWebhookSource(staticSource, apiSource Source, staticOrder webhookadmission.StaticOrder) Source {"," \tif staticSource == nil {"," \t\treturn apiSource"," \t}"," \treturn &compositeWebhookSource{"," \t\tstaticSource: staticSource,"," \t\tapiSource:    apiSource,","+\t\tstaticOrder: