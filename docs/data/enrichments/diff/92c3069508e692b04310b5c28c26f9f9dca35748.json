s and no rows.","+     * Failures that a regular query would hit during analysis, such as unknown indices or columns, are reported as failures.","+     * It is meant for checking a query without running it, so it is not logged and does not count towards query metrics.","+     */","+    public static PreparedEsqlQueryRequest analyzeOnly(EsqlStatement statement, String queryDescription) {","+        return new PreparedEsqlQueryRequest(false, statement, queryDescription, true);","     }"," ","     /**","@@ -90,6 +102,11 @@ public String queryDescription() {","         return queryDescription;","     }"," ","+    @Override","+    public boolean analyzeOnly() {","+        return analyzeOnly;","+    }","+","     public String getIndex() {","         return null;","     }"],"additions":20,"deletions":3,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Verifier.java","lines":["@@ -130,6 +130,14 @@ public Verifier(Metrics metrics, XPackLicenseState licenseState, List<BiConsumer","         this.extraCheckers = extraCheckers;","     }"," ","+    /**","+     * A copy of this verifier that runs every check but records no feature or function telemetry. Diagnostic analyses —","+     * such as the analyze-only pass that validates a view definition — must not count the plans they walk as feature usage.","+     */","+    public Verifier withoutMetrics() {","+        return new Verifier(null, licenseState, extraCheckers);","+    }","+","     /**","      * Verify that a {@link LogicalPlan} can be executed.","      *","@@ -204,7 +212,7 @@ Collection<Failure> verify(LogicalPlan plan, BitSet partialMetrics, AnalyzerCont","         }"," ","         // gather metrics","-        if (failures.hasFailures() == false) {","+        if (metrics != null && failures.hasFailures() == false) {","             gatherMetrics(plan, partialMetrics);","         }"," "],"additions":9,"deletions":1,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/o