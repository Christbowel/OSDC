,"+        from contextlib import suppress","+","+        with suppress(ValueError, OSError):","+            prior = json.loads(report_path.read_text(encoding=\"utf-8\"))","+    report = {","+        \"status\": \"fallback_concurrency_baseline\",","+        \"selection_objective\": \"preserve_prior_sla_feasible_config\",","+        \"recommended\": {","+            \"tensor_parallel_size\": config.get(\"tensor-parallel-size\", 1),","+            \"data_parallel_size\": config.get(\"data-parallel-size\", 1),","+            \"max_num_seqs\": None,","+            \"max_num_batched_tokens\": None,","+            \"vllm_default_parameters\": [\"max_num_seqs\", \"max_num_batched_tokens\"],","+        },","+        \"measured\": None,","+        \"baseline_source\": \"concurrency-recommendation.json\",","+        \"baseline_measured\": result.get(\"measured\"),","+        \"scheduler_attempt_status\": prior.get(\"status\", \"sweep_failed\"),","+        \"candidates\": prior.get(\"candidates\", []),","+    }","+    report_path.write_text(json.dumps(report, indent=2) + \"\\n\", encoding=\"utf-8\")","+    print(\"Scheduler tuning failed: using SLA-feasible concurrency baseline\")","+","+","+def main() -> None:","+    parser = argparse.ArgumentParser()","+    parser.add_argument(\"--sweep-dir\", type=Path, required=True)","+    args = parser.parse_args()","+    fallback(args.sweep_dir)","+","+","+if __name__ == \"__main__\":","+    main()"],"additions":75,"deletions":0,"truncated":false},{"path":"tools/recipes/sweep/scheduler_sweep_prepare.py","lines":["@@ -122,13 +122,22 @@ def add(","             candidate[\"max_num_batched_tokens\"] = max_num_batched_tokens","         candidates.append(candidate)"," ","+    # Begin with the known-good configuration from the concurrency stage.","+    add(\"vllm_defaults\", None, None)","+    # Isolate each parameter before testing combinations.","+    for name, batch in (","+        (\"initial_batch_default_seqs\", initial_batch),","+       