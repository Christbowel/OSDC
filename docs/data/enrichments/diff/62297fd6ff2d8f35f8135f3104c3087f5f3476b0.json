{"id":"62297fd6ff2d8f35f8135f3104c3087f5f3476b0","axis":"silent","repo":"comet-ml/comet-llm","sha":"62297fd6ff2d8f35f8135f3104c3087f5f3476b0","parsed":{"files":[{"path":"apps/opik-frontend/src/api/api.ts","lines":["@@ -76,6 +76,8 @@ export const LLM_MODEL_PROFILES_REST_ENDPOINT ="," export const ENVIRONMENTS_REST_ENDPOINT = \"/v1/private/environments/\";"," export const AI_SPEND_REST_ENDPOINT = \"/v1/private/ai-spend/\";"," export const AGENT_INSIGHTS_REST_ENDPOINT = \"/v1/private/agent-insights/\";","+export const GUARDRAIL_POLICIES_REST_ENDPOINT =","+  \"/v1/private/guardrails/policies/\";"," // OAuth endpoints are public (no /v1/private prefix); served by opik-backend's MCP OAuth AS."," export const OAUTH_REST_ENDPOINT = \"/oauth/\";"," export const OAUTH_AUTHORIZE_CONTEXT_KEY = \"oauth-authorize-context\";","@@ -112,6 +114,9 @@ export const AGENT_INSIGHTS_ISSUES_KEY = \"agent-insights-issues\";"," export const AGENT_INSIGHTS_ISSUE_KEY = \"agent-insights-issue\";"," export const AGENT_INSIGHTS_JOB_KEY = \"agent-insights-job\";"," export const OLLIE_CREDITS_KEY = \"ollie-credits\";","+export const GUARDRAILS_ENABLED_KEY = \"guardrails-enabled\";","+export const GUARDRAIL_POLICIES_KEY = \"guardrail-policies\";","+export const GUARDRAIL_POLICY_KEY = \"guardrail-policy\";"," "," // stats for feedback"," export const STATS_COMET_ENDPOINT = \"https://stats.comet.com/notify/event/\";"],"additions":5,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailPoliciesList.ts","lines":["@@ -0,0 +1,56 @@","+import { QueryFunctionContext, useQuery } from \"@tanstack/react-query\";","+import api, {","+  GUARDRAIL_POLICIES_KEY,","+  GUARDRAIL_POLICIES_REST_ENDPOINT,","+  QueryConfig,","+} from \"@/api/api\";","+import { GuardrailPolicy } from \"@/types/guardrails\";","+import { Sorting } from \"@/types/sorting\";","+import { processSorting } from \"@/lib/sorting\";","+","+type UseGuardrailPoliciesListParams = {","+  // Not sent: the workspace travels in the request headers. It is part of the params so that","+  // switching workspace produces a different query key.","+  workspaceName: string;","+  sorting?: Sorting;","+  search?: string;","+  page: number;","+  size: number;","+};","+","+type UseGuardrailPoliciesListResponse = {","+  content: GuardrailPolicy[];","+  sortable_by: string[];","+  total: number;","+};","+","+const getGuardrailPoliciesList = async (","+  { signal }: QueryFunctionContext,","+  { sorting, search, size, page }: UseGuardrailPoliciesListParams,","+) => {","+  const { data } = await api.get<UseGuardrailPoliciesListResponse>(","+    GUARDRAIL_POLICIES_REST_ENDPOINT,","+    {","+      signal,","+      params: {","+        ...processSorting(sorting),","+        ...(search && { name: search }),","+        size,","+        page,","+      },","+    },","+  );","+","+  return data;","+};","+","+export default function useGuardrailPoliciesList(","+  params: UseGuardrailPoliciesListParams,","+  options?: QueryConfig<UseGuardrailPoliciesListResponse>,","+) {","+  return useQuery({","+    queryKey: [GUARDRAIL_POLICIES_KEY, params],","+    queryFn: (context) => getGuardrailPoliciesList(context, params),","+    ...options,","+  });","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailPolicyBatchDeleteMutation.test.tsx","lines":["@@ -0,0 +1,64 @@","+import React from \"react\";","+import { describe, expect, it, vi } from \"vitest\";","+import { act, renderHook, waitFor } from \"@testing-library/react\";","+import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";","+","+const del = vi.fn();","+const toast = vi.fn();","+","+vi.mock(\"@/api/api\", () => ({","+  default: { delete: (url: string) => del(url) },","+  GUARDRAIL_POLICIES_REST_ENDPOINT: \"/v1/private/guardrails/policies/\",","+  GUARDRAIL_POLICIES_KEY: \"guardrail-policies\",","+  GUARDRAIL_POLICY_KEY: \"guardrail-policy\",","+}));","+vi.mock(\"@/ui/use-toast\", () => ({ useToast: () => ({ toast }) }));","+","+import useGuardrailPolicyBatchDeleteMutation from \"./useGuardrailPolicyBatchDeleteMutation\";","+","+const forbidden = (message: string) =>","+  Object.assign(new Error(\"Request failed with status code 403\"), {","+    response: { data: { message } },","+  });","+","+describe(\"useGuardrailPolicyBatchDeleteMutation\", () => {","+  it(\"reports every failed deletion and drops the deleted policy from the cache\", async () => {","+    del.mockImplementation((url: string) =>","+      url.endsWith(\"p1\")","+        ? Promise.resolve({})","+        : Promise.reject(forbidden(\"User not allowed to delete policies\")),","+    );","+    const queryClient = new QueryClient({","+      defaultOptions: { mutations: { retry: false } },","+    });","+    const removed: unknown[] = [];","+    queryClient.removeQueries = vi.fn(({ queryKey }) => {","+      removed.push(queryKey);","+    }) as never;","+    queryClient.invalidateQueries = vi.fn(() => Promise.resolve()) as never;","+    const wrapper = ({ children }: { children: React.ReactNode }) => (","+      <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>","+    );","+    const { result } = renderHook(","+      () => useGuardrailPolicyBatchDeleteMutation(),","+      { wrapper },","+    );","+","+    await act(async () => {","+      result.current.mutate({ ids: [\"p1\", \"p2\", \"p3\"] });","+    });","+","+    await waitFor(() => expect(result.current.isError).toBe(true));","+    expect(del).toHaveBeenCalledTimes(3);","+    expect(toast).toHaveBeenCalledWith({","+      title: \"Error\",","+      description:","+        \"2 of 3 policies could not be deleted: User not allowed to delete policies\",","+      variant: \"destructive\",","+    });","+    expect(removed).toEqual([[\"guardrail-policy\", { policyId: \"p1\" }]]);","+    expect(queryClient.invalidateQueries).toHaveBeenCalledWith({","+      queryKey: [\"guardrail-policies\"],","+    });","+  });","+});"],"additions":64,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailPolicyBatchDeleteMutation.ts","lines":["@@ -0,0 +1,79 @@","+import { useMutation, useQueryClient } from \"@tanstack/react-query\";","+import get from \"lodash/get\";","+import uniq from \"lodash/uniq\";","+import { useToast } from \"@/ui/use-toast\";","+import api, {","+  GUARDRAIL_POLICIES_KEY,","+  GUARDRAIL_POLICIES_REST_ENDPOINT,","+  GUARDRAIL_POLICY_KEY,","+} from \"@/api/api\";","+","+type UseGuardrailPolicyBatchDeleteMutationParams = {","+  ids: string[];","+};","+","+const useGuardrailPolicyBatchDeleteMutation = () => {","+  const queryClient = useQueryClient();","+  const { toast } = useToast();","+","+  return useMutation({","+    // The API deletes one policy per call. Every call is waited for, so one failure neither hides the others nor","+    // leaves a deleted policy in the cache.","+    mutationFn: async ({","+      ids,","+    }: UseGuardrailPolicyBatchDeleteMutationParams) => {","+      const results = await Promise.allSettled(","+        ids.map((id) => api.delete(`${GUARDRAIL_POLICIES_REST_ENDPOINT}${id}`)),","+      );","+","+      // A deleted policy reopened in the same session must not come back from the cache.","+      results.forEach((result, index) => {","+        if (result.status === \"fulfilled\") {","+          queryClient.removeQueries({","+            queryKey: [GUARDRAIL_POLICY_KEY, { policyId: ids[index] }],","+          });","+        }","+      });","+","+      const messages = uniq(","+        results.flatMap((result) =>","+          result.status === \"rejected\"","+            ? [","+                get(","+                  result.reason,","+                  [\"response\", \"data\", \"message\"],","+                  result.reason?.message,","+                ),","+              ]","+            : [],","+        ),","+      );","+      const failed = results.filter(","+        (result) => result.status === \"rejected\",","+      ).length;","+      if (failed > 0) {","+        throw new Error(","+          ids.length === 1","+            ? messages[0]","+            : `${failed} of ${","+                ids.length","+              } policies could not be deleted: ${messages.join(\"; \")}`,","+        );","+      }","+    },","+    onError: (error) => {","+      toast({","+        title: \"Error\",","+        description: error.message,","+        variant: \"destructive\",","+      });","+    },","+    onSettled: () => {","+      return queryClient.invalidateQueries({","+        queryKey: [GUARDRAIL_POLICIES_KEY],","+      });","+    },","+  });","+};","+","+export default useGuardrailPolicyBatchDeleteMutation;"],"additions":79,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailPolicyById.ts","lines":["@@ -0,0 +1,34 @@","+import { QueryFunctionContext, useQuery } from \"@tanstack/react-query\";","+import api, {","+  GUARDRAIL_POLICIES_REST_ENDPOINT,","+  GUARDRAIL_POLICY_KEY,","+  QueryConfig,","+} from \"@/api/api\";","+import { GuardrailPolicy } from \"@/types/guardrails\";","+","+type UseGuardrailPolicyByIdParams = {","+  policyId: string;","+};","+","+const getGuardrailPolicyById = async (","+  { signal }: QueryFunctionContext,","+  { policyId }: UseGuardrailPolicyByIdParams,","+) => {","+  const { data } = await api.get<GuardrailPolicy>(","+    `${GUARDRAIL_POLICIES_REST_ENDPOINT}${policyId}`,","+    { signal },","+  );","+","+  return data;","+};","+","+export default function useGuardrailPolicyById(","+  params: UseGuardrailPolicyByIdParams,","+  options?: QueryConfig<GuardrailPolicy>,","+) {","+  return useQuery({","+    queryKey: [GUARDRAIL_POLICY_KEY, params],","+    queryFn: (context) => getGuardrailPolicyById(context, params),","+    ...options,","+  });","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailPolicyCreateMutation.ts","lines":["@@ -0,0 +1,43 @@","+import { useMutation, useQueryClient } from \"@tanstack/react-query\";","+import api, {","+  GUARDRAIL_POLICIES_KEY,","+  GUARDRAIL_POLICIES_REST_ENDPOINT,","+} from \"@/api/api\";","+import { GuardrailPolicy } from \"@/types/guardrails\";","+import { extractIdFromLocation } from \"@/lib/utils\";","+","+export type GuardrailPolicyPayload = Pick<","+  GuardrailPolicy,","+  \"name\" | \"execution_scope\" | \"rules\"","+> &","+  Partial<Pick<GuardrailPolicy, \"description\">>;","+","+type UseGuardrailPolicyCreateMutationParams = {","+  policy: GuardrailPolicyPayload;","+};","+","+/**","+ * No default error handler: a duplicate name has to show on the name field rather than as a","+ * toast, so the caller presents errors.","+ */","+const useGuardrailPolicyCreateMutation = () => {","+  const queryClient = useQueryClient();","+","+  return useMutation({","+    mutationFn: async ({ policy }: UseGuardrailPolicyCreateMutationParams) => {","+      const { headers } = await api.post(","+        GUARDRAIL_POLICIES_REST_ENDPOINT,","+        policy,","+      );","+","+      return { id: extractIdFromLocation(headers?.location) };","+    },","+    onSettled: () => {","+      return queryClient.invalidateQueries({","+        queryKey: [GUARDRAIL_POLICIES_KEY],","+      });","+    },","+  });","+};","+","+export default useGuardrailPolicyCreateMutation;"],"additions":43,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailPolicyUpdateMutation.ts","lines":["@@ -0,0 +1,37 @@","+import { useMutation, useQueryClient } from \"@tanstack/react-query\";","+import api, {","+  GUARDRAIL_POLICIES_KEY,","+  GUARDRAIL_POLICIES_REST_ENDPOINT,","+  GUARDRAIL_POLICY_KEY,","+} from \"@/api/api\";","+import { GuardrailPolicyPayload } from \"@/api/guardrail-policies/useGuardrailPolicyCreateMutation\";","+","+type UseGuardrailPolicyUpdateMutationParams = {","+  policyId: string;","+  policy: GuardrailPolicyPayload;","+};","+","+/**","+ * The endpoint replaces the policy whole, rules included: a rule left out of the payload is","+ * removed. Like create, it leaves error presentation to the caller.","+ */","+const useGuardrailPolicyUpdateMutation = () => {","+  const queryClient = useQueryClient();","+","+  return useMutation({","+    mutationFn: async ({","+      policyId,","+      policy,","+    }: UseGuardrailPolicyUpdateMutationParams) => {","+      await api.put(`${GUARDRAIL_POLICIES_REST_ENDPOINT}${policyId}`, policy);","+    },","+    onSettled: () => {","+      queryClient.invalidateQueries({ queryKey: [GUARDRAIL_POLICY_KEY] });","+      return queryClient.invalidateQueries({","+        queryKey: [GUARDRAIL_POLICIES_KEY],","+      });","+    },","+  });","+};","+","+export default useGuardrailPolicyUpdateMutation;"],"additions":37,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailsEnabled.test.tsx","lines":["@@ -0,0 +1,171 @@","+import React from \"react\";","+import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";","+import { act, renderHook, waitFor } from \"@testing-library/react\";","+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";","+","+import usePluginsStore from \"@/store/PluginsStore\";","+import { FeatureToggleKeys } from \"@/types/feature-toggles\";","+import useGuardrailsEnabled from \"./useGuardrailsEnabled\";","+","+const { toggles } = vi.hoisted(() => ({","+  toggles: {","+    current: {} as Record<string, unknown>,","+  },","+}));","+","+vi.mock(\"@/api/feature-toggle/useFeatureToggle\", () => ({","+  default: () => toggles.current,","+}));","+vi.mock(\"@/store/AppStore\", async (importOriginal) => ({","+  ...(await importOriginal<typeof import(\"@/store/AppStore\")>()),","+  useActiveWorkspaceName: () => \"workspace\",","+}));","+","+const togglesLoaded = (guardrailsOn: boolean) => ({","+  data: { [FeatureToggleKeys.GUARDRAILS_VALIDATIONS_ENABLED]: guardrailsOn },","+  isPending: false,","+  isError: false,","+  refetch: vi.fn(),","+});","+","+const renderEnabled = () => {","+  const queryClient = new QueryClient({","+    defaultOptions: { queries: { retry: false } },","+  });","+  return renderHook(() => useGuardrailsEnabled(), {","+    wrapper: ({ children }: { children: React.ReactNode }) => (","+      <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>","+    ),","+  });","+};","+","+describe(\"useGuardrailsEnabled\", () => {","+  beforeEach(() => {","+    usePluginsStore.setState({ getGuardrailsEnabled: null });","+  });","+","+  afterEach(() => {","+    usePluginsStore.setState({ getGuardrailsEnabled: null });","+  });","+","+  it(\"is pending while the toggles load\", () => {","+    toggles.current = {","+      data: undefined,","+      isPending: true,","+      isError: false,","+      refetch: vi.fn(),","+    };","+","+    expect(renderEnabled().result.current).toMatchObject({","+      isEnabled: false,","+      isPending: true,","+      isError: false,","+    });","+  });","+","+  it(\"reports a failed toggles request as an error with a retry, not as disabled\", () => {","+    const refetch = vi.fn();","+    toggles.current = {","+      data: undefined,","+      isPending: false,","+      isError: true,","+      refetch,","+    };","+","+    const { result } = renderEnabled();","+","+    expect(result.current).toMatchObject({","+      isEnabled: false,","+      isPending: false,","+      isError: true,","+    });","+    result.current.refetch();","+    expect(refetch).toHaveBeenCalled();","+  });","+","+  it(\"keeps guardrails on when a background refetch of the toggles fails\", () => {","+    toggles.current = { ...togglesLoaded(true), isError: true };","+","+    expect(renderEnabled().result.current).toMatchObject({","+      isEnabled: true,","+      isPending: false,","+      isError: false,","+    });","+  });","+","+  it(\"is disabled when the deployment does not run guardrails, without asking the plugin\", () => {","+    const getGuardrailsEnabled = vi.fn();","+    usePluginsStore.setState({ getGuardrailsEnabled });","+    toggles.current = togglesLoaded(false);","+","+    expect(renderEnabled().result.current).toMatchObject({","+      isEnabled: false,","+      isPending: false,","+      isError: false,","+    });","+    expect(getGuardrailsEnabled).not.toHaveBeenCalled();","+  });","+","+  it(\"lets the toggle decide when no platform plugin can say more\", () => {","+    toggles.current = togglesLoaded(true);","+","+    expect(renderEnabled().result.current).toMatchObject({","+      isEnabled: true,","+      isPending: false,","+      isError: false,","+    });","+  });","+","+  it.each([","+    [true, true],","+    [false, false],","+  ])(","+    \"follows the organization's enablement from the plugin (%s)\",","+    async (organizationEnabled, expected) => {","+      usePluginsStore.setState({","+        getGuardrailsEnabled: vi.fn().mockResolvedValue(organizationEnabled),","+      });","+      toggles.current = togglesLoaded(true);","+","+      const { result } = renderEnabled();","+","+      await waitFor(() => expect(result.current.isPending).toBe(false));","+      expect(result.current).toMatchObject({","+        isEnabled: expected,","+        isError: false,","+      });","+    },","+  );","+","+  it(\"reports a failed organization lookup as an error, not as disabled\", async () => {","+    usePluginsStore.setState({","+      getGuardrailsEnabled: vi.fn().mockRejectedValue(new Error(\"down\")),","+    });","+    toggles.current = togglesLoaded(true);","+","+    const { result } = renderEnabled();","+","+    await waitFor(() => expect(result.current.isError).toBe(true));","+    expect(result.current.isEnabled).toBe(false);","+  });","+","+  it(\"keeps the organization's answer when a background refetch of it fails\", async () => {","+    const getGuardrailsEnabled = vi","+      .fn()","+      .mockResolvedValueOnce(true)","+      .mockRejectedValue(new Error(\"down\"));","+    usePluginsStore.setState({ getGuardrailsEnabled });","+    toggles.current = togglesLoaded(true);","+","+    const { result } = renderEnabled();","+    await waitFor(() => expect(result.current.isEnabled).toBe(true));","+    await act(async () => {","+      await result.current.refetch();","+      // React Query hands the result to the component on a later tick.","+      await new Promise((resolve) => setTimeout(resolve, 0));","+    });","+","+    expect(getGuardrailsEnabled).toHaveBeenCalledTimes(2);","+    expect(result.current).toMatchObject({ isEnabled: true, isError: false });","+  });","+});"],"additions":171,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/api/guardrail-policies/useGuardrailsEnabled.ts","lines":["@@ -0,0 +1,83 @@","+import { useQuery } from \"@tanstack/react-query\";","+import { GUARDRAILS_ENABLED_KEY } from \"@/api/api\";","+import useFeatureToggle from \"@/api/feature-toggle/useFeatureToggle\";","+import { useActiveWorkspaceName } from \"@/store/AppStore\";","+import usePluginsStore from \"@/store/PluginsStore\";","+import { FeatureToggleKeys } from \"@/types/feature-toggles\";","+","+/**","+ * Whether guardrails are available in the active workspace: the deployment runs them (the backend toggle) and,","+ * where a platform plugin can say so, the workspace's organization has them enabled. Without the plugin (OSS) the","+ * toggle alone decides.","+ *","+ * Reads the toggles query itself rather than the provider, which reports its defaults until the toggles arrive and","+ * would turn a hard load of the page into a \"no access\" flash. A failed lookup is not an answer: it comes back as","+ * isError with a refetch, so callers can offer a retry instead of showing guardrails as off. A failed background","+ * refetch keeps the answer already given, so it doesn't take the page away from someone in the middle of an edit.","+ */","+export default function useGuardrailsEnabled() {","+  const