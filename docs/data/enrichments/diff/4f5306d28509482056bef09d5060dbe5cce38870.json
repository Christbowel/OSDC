read of `log`, by the rules of every hosted","-    /// registry of its namespace.","-    fn of(state: &AppState, log: &LogId, identity: &Identity) -> Self {","-        let routing = state.routing();","-        let hosted: Vec<&HostedConfig> = routing.hosted","-            .iter()","-            .filter(|(name, hosted)| {","-                hosted.namespace == log.namespace","-                    && routing.registries.ecosystem(name) == Some(log.ecosystem)","-            })","-            .map(|(_, hosted)| hosted)","-            .collect();","-        let is_admin = identity","-            .user_id()","-            .is_some_and(|username| state.inner.config.identity.admins.contains(username));","-        // No registry's rules admit anyone to a log no registry holds.","-        let may_read_all = is_admin","-            || (!hosted.is_empty()","-                && hosted","-                    .iter()","-                    .all(|hosted| hosted.rules.snapshot().all_access_admit(identity)));","-        let may_read_some = may_read_all","-            || hosted","-                .iter()","-                .any(|hosted| hosted.rules.snapshot().any_access_admits(identity));","-        Self { may_read_some, may_read_all }","-    }","-}","-"," /// `GET <base>/<name>/<version>+r<revision>/evidence`: the record's digest"," /// and the inclusion proof of its log entry, with the registry's statements"," /// and the publisher's Sigstore bundle. It is read as the record is, and changes with every newer"],"additions":14,"deletions":42,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/log_routes/readers.rs","lines":["@@ -0,0 +1,122 @@","+use super::super::{","+    AppState,","+    Identity,","+    Registry,","+    RoutingSnapshot,","+};","+use pnpm_release_record::{","+    LogEntry,","+    RecordIdentity,","+};","+use pnpm_transparency_log::TILE_WIDTH;","+use pnpr_config::HostedConfig;","+use pnpr_registry::PackagePattern;","+use pnpr_storage::transparency_log::LogId;","+","+fn log_registries<'a>(","+    routing: &'a RoutingSnapshot,","+    log: &'a LogId,","+) -> impl Iterator<Item = (&'a str, &'a HostedConfig, &'a [PackagePattern])> {","+    routing.hosted","+        .iter()","+        .filter_map(move |(name, hosted)| {","+            if hosted.namespace != log.namespace","+                || routing.registries.ecosystem(name) != Some(log.ecosystem)","+            {","+                return None;","+            }","+            let Registry::Hosted { patterns } = routing.registries.get(name)? else { return None };","+            let claims =","+                if patterns.is_empty() { &[PackagePattern::All][..] } else { patterns.as_slice() };","+            Some((name.as_str(), hosted, claims))","+        })","+}","+","+/// What one caller may read of a log.","+pub(super) struct LogReaders {","+    /// The caller may read some package the log holds.","+    pub(super) may_read_some: bool,","+    /// The caller may read every package the log holds.","+    pub(super) may_read_all: bool,","+}","+","+impl LogReaders {","+    /// What `identity` may read of `log`, by the rules of every hosted","+    /// registry of its namespace.","+    pub(super) fn of(state: &AppState, log: &LogId, identity: &Identity) -> Self {","+        let routing = state.routing();","+        let mut may_read_some = false;","+        let mut may_read_all = true;","+        for (_, hosted, claims) in log_registries(&routing, log) {","+            let rules = hosted.rules.snapshot();","+            may_read_some |= rules.any_access_admits_in(identity, claims);","+            may_read_all &= rules.all_access_admit_in(identity, claims);","+        }","+        let may_read_all = may_read_some && may_read_all;","+        Self { may_read_some, may_read_all }","+    }","+}","+","+/// A log retains entries after its registry narrows its claims. Check the","+/// append-only prefix once per routing snapshot, across all bundles.","+pub(super) async fn log_still_claimed(","+    state: &AppState,","+    log: &LogId,","+    index: u64,","+    width: u32,","+) -> pnpr_error::Result<bool> {","+    let routing = state.routing();","+    let Some(end) = index","+        .checked_mul(u64::from(TILE_WIDTH))","+        .and_then(|start| start.checked_add(u64::from(width)))","+    else {","+        return Ok(false);","+    };","+    let database = state.inner.storage.sql_database();","+    for (name, _, patterns) in log_registries(&routing, log) {","+        if patterns.contains(&PackagePattern::All) {","+            continue;","+        }","+        let mut prefix = routing.caches.claimed_log_prefixes[name].lock().await;","+        if !check_prefix(database, log, patterns, end, &mut prefix).await? {","+            return Ok(false);","+        }","+    }","+    Ok(true)","+}","+","+async fn check_prefix(","+    database: &std::sync::Arc<pnpr_storage::database::SqlDatabase>,","+    log: &LogId,","+    patterns: &[PackagePattern],","+    end: u64,","+    prefix: &mut Option<u64>,","+) -> pnpr_error::Result<bool> {","+    let Some(mut checked) = *prefix else { return Ok(false) };","+    let size = database.log_size(log).await?;","+    if size < end {","+        return Ok(false);","+    }","+    while checked < size {","+        let next = size.min(checked.saturating_add(u64::from(TILE_WIDTH)));","+        let entries = database.log_entries(log, checked..next).await?;","+        if !entries.iter().all(|entry| claimed_entry(patterns, entry)) {","+            *prefix = None;","+            return Ok(false);","+        }","+        checked = next;","+        *prefix = Some(checked);","+    }","+    Ok(true)","+}","+","+fn claimed_entry(patterns: &[PackagePattern], bytes: &[u8]) -> bool {","+    let Ok(entry) = LogEntry::parse(bytes) else { return false };","+    let RecordIdentity::Package(purl) = &entry.key().identity else { return false };","+    purl.npm_package()","+        .is_some_and(|(name, _)| {","+            patterns","+                .iter()","+                .any(|pattern| pattern.matches(&name))","+        })","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_owners.rs","lines":["@@ -7,10 +7,13 @@"," //! neither protocol defines one."," "," use super::{","+    Action,","     AppState,","     AuthedCaller,","+    Ownership,","     RegistrySource,","     TargetRegistry,","+    authorize_with_ownership,","     documents::{","         HostedDocument,","         read_hosted_document,","@@ -175,7 +178,10 @@ pub(super) async fn change_owners<Document: HostedDocument>(","     let current =","         storage.read_hosted_document_for_update(&key).await?.ok_or(RegistryError::NotFound)?;","     let current = parse_current::<Document>(&key, &current.bytes)?;","-    authorize_owner_change(state, identity, &key, current.owners())?;","+    let source = RegistrySource::Hosted(target.source.clone());","+    let authorize =","+        |owners: &[String]| authorize_owner_change(state, identity, &source, (&key, owners));","+    authorize(current.owners())?;","     let requested = account_ids(state, &logins, change).await?;","     let outcome = storage.update_hosted_document_with_retry(","         &key,","@@ -184,7 +190,7 @@ pub(super) async fn change_owners<Document: HostedDocument>(","         |bytes| {","             let Some(bytes) = bytes else { return Ok(None) };","             let mut document = parse_current::<Document>(&key, bytes)?;","-            authorize_owner_change(state, identity, &key, document.owners())?;","+            authorize(document.owners())?;","             apply_change(&key, document.owners_mut(), &requested, change)?;","             Ok(Some(document.to_bytes()))","         },","@@ -270,8 +276,8 @@ fn parse_current<Document: HostedDocument>("," fn authorize_owner_change(","     state: &AppState,","     identity: &Identity,","-    key: &CanonicalPackageName,","-    owners: &[String],","+    source: &RegistrySource,","+    (key, owners): (&CanonicalPackageName, &[String]),"," ) -> Result<(), RegistryError> {","     let allowed = identity","         .user_id()","@@ -282,7 +288,13 @@ fn authorize_owner_change(","                     .any(|owner| owner == caller)","         });","     if allowed {","-        return Ok(());","+        return authorize_with_ownership(","+            state,","+            identity,","+            source,","+            (key.as_str(), &Ownership::Owners(owners)),","+            Action::Annotate,","+        );","     }","     Err(RegistryError::Forbidden {","         user: identity"],"additions":17,"deletions":5,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/registry_graph/snapshot.rs","lines":["@@ -52,8 +52,7 @@ pub(crate) struct RoutingSnapshot {","     /// per-request path doesn't re-sort and re-hash an upstream's headers.","     pub(crate) upstream_cache_namespaces: IndexMap<String, String>,","     pub(crate) route_context: Arc<RouteContext>,","-    /// The resolver engine for this graph, built on the first resolve.","-    pub(crate) resolver: OnceLock<crate::resolver::Resolver>,","+    pub(crate) caches: RoutingCaches,","     /// The stored graph revision this snapshot was built from. `None` for a","     /// graph the configuration file declares.","     pub(crate) generation: Option<u64>,","@@ -63,6 +62,14 @@ pub(crate) struct RoutingSnapshot {","     client_keys: IndexMap<String, UpstreamClientKey>,"," }"," ","+pub(crate) struct RoutingCaches {","+    /// The resolver engine for this graph, built on the first resolve.","+    pub(crate) resolver: OnceLock<crate::resolver::Resolver>,","+    /// For each hosted registry, the log prefix checked against this graph's","+    /// claims. None once an entry falls outside them.","+    pub(crate) claimed_log_prefixes: IndexMap<String, tokio::sync::Mutex<Option<u64>>>,","+}","+"," impl Deref for RoutingSnapshot {","     type Target = RoutingConfig;"," ","@@ -127,12 +134,16 @@ pub(crate) fn build_snapshot(","         })","      