 let denied = get(&app, uri, Some(&admin)).await;","+        assert_eq!(denied.status(), StatusCode::NOT_FOUND);","+        assert_eq!(denied.headers()[header::CACHE_CONTROL], \"private, no-store\");","+    }","+}","+","+#[tokio::test]","+async fn narrowed_claims_withhold_every_bundle_of_the_old_log() {","+    let tmp = TempDir::new().unwrap();","+    let auth = AuthState::in_memory();","+    let token = issue_token(&auth, \"publisher\").await;","+    let app = router_with_auth(acme_config(tmp.path(), Vec::new()), auth.clone());","+    publish(&app, &token, \"@acme/widget\", \"1.0.0\").await;","+    publish(&app, &token, \"@acme/other\", \"1.0.0\").await;","+    wait_for_checkpoint_size(&app, 2).await;","+    drop(app);","+    let mut config = acme_config(tmp.path(), Vec::new());","+    let hosted = Registry::Hosted {","+        patterns: vec![PackagePattern::parse(\"@acme/widget\", Ecosystem::Npm).unwrap()],","+    };","+    config.routing.registries =","+        Registries::new([(\"acme\".to_string(), hosted)].into(), Some(\"acme\".to_string()));","+    let app = router_with_auth(config, auth);","+    assert_eq!(get(&app, \"/npm/-/log/checkpoint\", None).await.status(), StatusCode::OK);","+    for uri in [\"/npm/-/log/tile/entries/000.p/1\", \"/npm/-/log/tile/entries/000.p/2\"] {","+        assert_eq!(get(&app, uri, None).await.status(), StatusCode::NOT_FOUND);","+    }","+}","+"," /// A hosted registry serves its namespace's log, also when addressed by"," /// name, and a registry that reaches no namespace serves none."," #[tokio::test]"],"additions":60,"deletions":0,"truncated":false},{"path":"pnpr/crates/policy/src/grants.rs","lines":["@@ -162,17 +162,24 @@ impl Grant {","             .collect()","     }"," ","-    /// Whether the patterns the grant excludes leave it no package.","-    fn covers_nothing(&self) -> bool {","-        let excluded = |pattern: &PackagePattern| {","-            self.exclude","+    /// Whether the grant covers some name in `claim`. Intersecting package","+    /// patterns are nested, so their intersection is the narrower pattern.","+    fn intersects(&self, claim: &PackagePattern) -> bool {","+        let available = |pattern: &PackagePattern| {","+            !self.exclude","                 .iter()","                 .any(|exclude| exclude.covers(pattern))","         };","-        if self.include.is_empty() {","-            return excluded(&PackagePattern::All);","-        }","-        self.include.iter().all(excluded)","+        self.include","+            .iter()","+            .any(|include| {","+                if include.covers(claim) {","+                    available(claim)","+                } else {","+                    claim.covers(include) && available(include)","+                }","+            })","+            || (self.include.is_empty() && available(claim))","     }"," ","     /// Whether the grant gives `action` to a subject `identity` matches.","@@ -270,19 +277,37 @@ impl Grants {","     }"," ","     pub(super) fn any_admits(&self, action: Action, identity: &Identity) -> bool {","-        self.all","-            .iter()","-            .filter(|grant| !grant.covers_nothing())","-            .any(|grant| grant.gives(action, identity, false))","+        self.any_admits_in(action, identity, &[PackagePattern::All])","     }"," ","     /// Whether `identity` may do `action` on every package.","-    pub(super) fn all_admit(&self, action: Action, identity: &Identity) -> bool {","+    pub(super) fn all_admit(","+        &self,","+        action: Action,","+        identity: &Identity,","+        claims: &[PackagePattern],","+    ) -> bool {","         let giving: Vec<&Grant> = self.all","             .iter()","             .filter(|grant| grant.gives(action, identity, false))","             .collect();","-        covered(&giving, &PackagePattern::All)","+        claims.iter().all(|claim| covered(&giving, claim))","+    }","+","+    pub(super) fn any_admits_in(","+        &self,","+  