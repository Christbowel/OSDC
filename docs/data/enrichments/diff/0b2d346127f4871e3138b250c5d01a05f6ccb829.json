;","+      const fsr = { root: \"routes\", style: \"nextjs-pages\", serverEntryPoint: \"./server.ts\" };","+      // The framework's plugins are parsed first, then root fails the type check.","+      const app = { framework: { fileSystemRouterTypes: [fsr], plugins: [] }, root: 123 };","+      const count = () => heapStats().protectedObjectTypeCounts.BundlerPlugin ?? 0;","+      const before = count();","+      const errors = new Set();","+      for (let i = 0; i < 10; i++) {","+        try {","+          Bun.serve({ port: 0, development: true, app, fetch: () => new Response() }).stop(true);","+          errors.add(\"no error\");","+        } catch (e) {","+          errors.add(e.code);","+        }","+      }","+      console.log(\"errors: \" + [...errors].join(\", \"));","+      console.log(\"leaked plugins: \" + (count() - before));","+    `,","+  });","+","+  await using proc = Bun.spawn({","+    cmd: [bunExe(), \"fixture.ts\"],","+    env: bunEnv,","+    cwd: String(dir),","+    stdout: \"pipe\",","+    stderr: \"pipe\",","+  });","+  const [stdout, stderr, exitCode] = await Promise.all([proc.stdout.text(), proc.stderr.text(), proc.exited]);","+","+  expect(stdout).toBe(\"errors: ERR_INVALID_ARG_TYPE\\nleaked plugins: 0\\n\");","+  expect(exitCode).toBe(0);","+});","+","+test.concurrent(\"Bun.serve({ app }) skips the directories in fileSystemRouterTypes[].ignoreDirs\", async () => {","+  using dir = tempDir(\"bake-app-ignore-dirs\", {","+    \"server.ts\": `export function render() { return new Response(\"ok\"); }`,","+    \"routes/index.ts\": `export default 1;`,","+    // Both routes are invalid. Only the one outside ignoreDirs is scanned and reported.","+    \"routes/skipped/[].ts\": `export default 1;`,","+    \"routes/scanned/[].ts\": `export default 1;`,","+    \"fixture.ts\": `","+      const fsr = { root: \"routes\", style: \"nextjs-pages\", serverEntryPoint: \"./server.ts\", ignoreDirs: [\"skipped\"] };","+      Bun.serve({ port: 0, development: true, app: { framework: { fileSystemRouterTypes: [fsr] } } }).stop(true);","+      console.log(\"started\");","+    `,","+  });","+","+  await using proc = Bun.spawn({","+    cmd: [bunExe(), \"fixture.ts\"],","+    env: bunEnv,","+    cwd: String(dir),","+    stdout: \"pipe\",","+    stderr: \"pipe\",","+  });","+  const [stdout, stderr, exitCode] = await Promise.all([proc.stdout.text(), proc.stderr.text(), proc.exited]);","+","+  expect(stderr).toContain(\"scanned/[].ts\");","+  expect(stderr).not.toContain(\"skipped/[].ts\");","+  expect(stdout).toBe(\"started\\n\");","+  expect(exitCode).toBe(0);","+});","+","+test.concurrent(\"Bun.serve({ app }) reports a route with more than 64 params\", async () => {","+  const route = Array.from({ length: 65 }, (_, i) => `[p${i}]`).join(\"/\");","+  using dir = tempDir(\"bake-app-too-many-params\", {","+    \"server.ts\": `export function render() { return new Response(\"ok\"); }`,","+    [`routes/${route}.ts`]: `export default 1;`,","+    \"fixture.ts\": `","+      const fsr = { root: \"routes\", style: \"nextjs-pages\", serverEntryPoint: \"./server.ts\" };","+      Bun.serve({ port: 0, development: true, app: { framework: { fileSystemRouterTypes: [fsr] } } }).stop(true);","+      console.log(\"started\");","+    `,","+  });","+","+  await using proc = Bun.spawn({","+    cmd: [bunExe(), \"fixture.ts\"],","+    env: bunEnv,","+    cwd: String(dir),","+    stdout: \"pipe\",","+    stderr: \"pipe\",","+  });","+  const [stdout, stderr, exitCode] = await Promise.all([proc.stdout.text(), proc.stderr.text(), proc.exited]);","+","+  expect(stderr).toContain(\"Pattern cannot have more than 64 param\");","+  expect(stdout).toBe(\"started\\n\");","+  expect(exitCode).toBe(0);","+});",""],"additions":91,"deletions":0,"truncated":false}],"additions":129,"deletions":21,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-17T12:24:48.434907+00:00"}