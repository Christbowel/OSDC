\\FunctionalTestCase;","+","+final class InternalLinktypeTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = [","+        'linkvalidator',","+        'info',","+    ];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/../../../../core/Tests/Functional/Fixtures/be_users_admin.csv');","+        $GLOBALS['BE_USER'] = $this->setUpBackendUser(1);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($GLOBALS['BE_USER']);","+        $GLOBALS['EXEC_TIME'] = time();","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/input_content_with_link_to_page_hidden_by_parent.csv');","+    }","+","+    public static function getErrorMessageNamesPageThatHidesTheLinkedPageDataProvider(): array","+    {","+        return [","+            'page is hidden itself' => [","+                2,","+                'Page \\'Hidden with subpages\\' (id=2) is not visible.',","+            ],","+            'page is hidden by its parent page' => [","+                3,","+                'Page \\'Below a hidden page with subpages\\' (id=3) is not visible, because the page \\'Hidden with subpages\\' (id=2) hides its subpages.',","+            ],","+            'page is hidden by an expired grandparent page' => [","+                8,","+                'Page \\'Two levels below an expired page with subpages\\' (id=8) is not visible, because the page \\'Expired with subpages\\' (id=6) hides its subpages.',","+            ],","+        ];","+    }","+","+    #[DataProvider('getErrorMessageNamesPageThatHidesTheLinkedPageDataProvider')]","+    #[Test]","+    public function getErrorMessageNamesPageThatHidesTheLinkedPage(int $pageId, string $expectedMessage): void","+    {","+        $subject = $this->get(InternalLinktype::class);","+        $softRefEntry = ['substr' => ['type' => 'db', 'recordRef' => 'pages:' . $pageId, 'tokenValue' => (string)$