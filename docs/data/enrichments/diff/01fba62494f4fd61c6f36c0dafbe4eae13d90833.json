nchConfig {","+    /// This config with saving turned off, for a run whose result the caller","+    /// saves itself (sweep points, `--num-runs`).","+    pub(crate) fn without_save(&self) -> Self {","+        let mut config = self.clone();","+        config.save_result = false;","+        config.append_result = false;","+        config","+    }","+","     pub fn from_args(args: &BenchServeArgs) -> Result<Self> {","         if args.burstiness <= 0.0 {","             return Err(BenchError::Config(\"Burstiness must be positive\".into()));"],"additions":9,"deletions":0,"truncated":false},{"path":"rust/src/bench/src/metrics/calculator.rs","lines":["@@ -3,7 +3,7 @@"," "," use crate::backends::RequestFuncOutput;"," use crate::config::GoodputConfig;","-use crate::metrics::{BenchmarkMetrics, MultiTurnMetrics};","+use crate::metrics::{BenchmarkMetrics, LatencyStats, MultiTurnMetrics};"," use crate::multi_turn::ConversationOutput;"," "," fn log_failed_requests(outputs: &[RequestFuncOutput]) {","@@ -209,11 +209,45 @@ pub fn calculate_metrics(","         max_output_tokens_per_s,","         max_concurrent_requests,","         steady_state: None,","+        client_queue_time: None,","+        e2el_including_client_queue: None,","     };"," ","     (metrics, actual_output_lens)"," }"," ","+/// Attach Python's client-side queueing metrics, computed over successful","+/// requests: `client_queue_time` with `--max-concurrency`, and","+/// `e2el_including_client_queue` when the request rate is also finite.","+pub fn attach_client_queue_metrics(","+    metrics: &mut BenchmarkMetrics,","+    outputs: &[RequestFuncOutput],","+    max_concurrency: Option<usize>,","+    request_rate: f64,","+    selected_percentiles: &[f64],","+) {","+    if max_concurrency.is_none() {","+        return;","+    }","+    let successful = outputs.iter().filter(|o| o.success);","+    let queue_times: Vec<f64> = successful.clone().map(|o| o.client_queue_time).collect();","+    metrics.client_queue_time = Some(l