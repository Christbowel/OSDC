iscovery runs on the HTTP server, not WebKit's native message callback.","+func desktopModelSettingsHandler() http.Handler {","+\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)","+\t\tdefer cancel()","+\t\tcatalog := r.URL.Query().Get(\"catalog\") == \"true\"","+\t\tvar result any","+\t\tswitch r.PathValue(\"integration\") {","+\t\tcase \"claude-desktop\":","+\t\t\tstatus := claudeDesktopSettingsSummary()","+\t\t\tif catalog && status.Installed && status.Used {","+\t\t\t\tstatus = claudeDesktopConnectionStatus(ctx)","+\t\t\t}","+\t\t\tresult = status","+\t\tcase \"chatgpt\":","+\t\t\tsettings := codexDesktopSettingsSummary()","+\t\t\tresponse := codexDesktopModelsSettingsResult{Settings: settings}","+\t\t\tif catalog && settings.Installed {","+\t\t\t\tvar err error","+\t\t\t\tresponse.Settings, err = codexDesktopSettingsWithInventory(ctx, settings)","+\t\t\t\tif err != nil {","+\t\t\t\t\tresponse.Warning = codexDesktopModelRefreshError(response.Settings)","+\t\t\t\t}","+\t\t\t}","+\t\t\tresult = response","+\t\tdefault:","+\t\t\thttp.NotFound(w, r)","+\t\t\treturn","+\t\t}","+\t\tif ctx.Err() != nil {","+\t\t\thttp.Error(w, \"Model discovery timed out\", http.StatusGatewayTimeout)","+\t\t\treturn","+\t\t}","+\t\tw.Header().Set(\"Content-Type\", \"application/json\")","+\t\tw.Header().Set(\"Cache-Control\", \"no-store\")","+\t\tjson.NewEncoder(w).Encode(result)","+\t})","+}","+","+func claudeDesktopSettingsSummary() claudeDesktopStatus {","+\tstatus := getClaudeDesktopConnectionSummary()","+\tselected := activeClaudeDesktopModels()","+\tmappings := proxy.ClaudeDesktopMappings(selected)","+\tif saved := launch.ClaudeDesktopModelMappings(); len(saved) > 0 {","+\t\tmappings = saved","+\t}","+\tfor _, route := range proxy.ClaudeDesktopRoutes() {","+\t\tstatus.Mappings = append(status.Mappings, claudeDesktopMappingStatus{","+\t\t\tRouteID: route.ID, RouteName: route.DisplayName, Model: mappings[route.ID],","+\t\t})","+\t}","+\tfor _, model := range selected {","+\t\tname := model.Name","+\t\tif model.Cloud {","+\t\t\tname = model.OllamaModel","+\t\t}","+\t\tstatus.Models = append(status.Models, claudeDesktopModelStatus{","+\t\t\tName: name, DisplayName: name, Cloud: model.Cloud, Selected: true,","+\t\t\tAvailability: \"unknown\", AutoMode: claudeDesktopModelSupportsAutoMode(model),","+\t\t})","+\t}","+\tfor _, mapping := range status.Mappings {","+\t\tname := mapping.Model","+\t\tknown := false","+\t\tfor _, model := range status.Models {","+\t\t\tknown = known || model.Name == name","+\t\t}","+\t\tif name != \"\" && !known {","+\t\t\tstatus.Models = append(status.Models, claudeDesktopModelStatus{","+\t\t\t\tName: name, DisplayName: name, Selected: true, Availability: \"unknown\",","+\t\t\t})","+\t\t}","+\t}","+\tautoMode, err := launch.ClaudeDesktopAutoModeEnabled()","+\tstatus.AutoMode = autoMode","+\tif err != nil && status.Error == \"\" {","+\t\tstatus.Error = err.Error()","+\t}","+\treturn status","+}"],"additions":94,"deletions":0,"truncated":false},{"path":"app/cmd/app/desktop_models_darwin_test.go","lines":["@@ -0,0 +1,149 @@","+//go:build darwin","+","+package main","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"path/filepath\"","+\t\"slices\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/ollama/ollama/api\"","+\t\"github.com/ollama/ollama/app/store\"","+\t\"github.com/ollama/ollama/cmd/config\"","+\t\"github.com/ollama/ollama/cmd/launch\"","+\t\"github.com/ollama/ollama/internal/proxy\"","+)","+","+func TestDesktopModelsClaudeSummaryPreservesMappingsWithoutCatalog(t *testing.T) {","+\tt.Setenv(\"HOME\", t.TempDir())","+\tpreviousStore, previousInstalled := appStore, claudeDesktopInstalled","+\tappStore = &store.Store{DBPath: filepath.Join(t.TempDir(), \"db.sqlite\")}","+\tclaudeDesktopInstalled = func() bool { return false }","+\tclaudeProxyMu.Lock()","+\tpreviousGateway, previousAvailable := claudeAppProxy, claudeAvailableModels","+\tclaudeAppProxy, claudeAvailableModels = nil, nil","+\tclaudeProxyMu.Unlock()","+\tt.Cleanup(func() {","+\t\tappStore.Close()","+\t\tappStore, claudeDesktopInstalled = previousStore, previousInstalled","+\t\tclaudeProxyMu.Lock()","+\t\tclaudeAppProxy, claudeAvailableModels = previousGateway, previousAvailable","+\t\tclaudeProxyMu.Unlock()","+\t})","+\tif err := launch.SaveClaudeDesktopModelMappings(map[string]string{\"claude-sonnet-5\": \"saved-model\"}); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tstatus := claudeDesktopSettingsSummary()","+\tfor _, mapping := range status.Mappings {","+\t\tif mapping.RouteID == \"claude-sonnet-5\" && mapping.Model == \"saved-model\" {","+\t\t\tfor _, model := range status.Models {","+\t\t\t\tif model.Name == mapping.Model && model.Availability == \"unknown\" {","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}","+\tt.Fatalf(\"saved mapping missing from summary: %#v\", status)","+}","+","+func TestDesktopModelsSavedSettingsWithoutDiscovery(t *testing.T) {","+\tt.Setenv(\"HOME\", t.TempDir())","+\tcontroller, factory := codexDesktop, codexDesktopClientFactory","+\tt.Cleanup(func() { codexDesktop, codexDesktopClientFactory = controller, factory })","+\tif err := config.SaveIntegration(codexDesktopIntegrationName, []string{\"saved-model\"}); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tcodexDesktopClientFactory = func() (*api.Client, error) {","+\t\tt.Error(\"saved settings must not discover models\")","+\t\treturn nil, errors.New(\"discovery unavailable\")","+\t}","+\tfor _, tt := range []struct {","+\t\tname, query string","+\t\tinstalled   bool","+\t}{","+\t\t{\"saved settings\", \"catalog=false\", true},","+\t\t{\"uninstalled app\", \"catalog=true\", false},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tcodexDesktop = &fakeCodexDesktopController{installed: tt.installed}","+\t\t\tr := httptest.NewRequest(http.MethodGet, \"/?\"+tt.query, nil)","+\t\t\tr.SetPathValue(\"integration\", \"chatgpt\")","+\t\t\tw := httptest.NewRecorder()","+\t\t\tdesktopModelSettingsHandler().ServeHTTP(w, r)","+\t\t\tvar result codexDesktopModelsSettingsResult","+\t\t\tif err := json.Unmarshal(w.Body.Bytes(), &result); err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t\tif w.Code != http.StatusOK || !slices.Equal(result.Settings.Selected, []string{\"saved-model\"}) || result.Warning != \"\" {","+\t\t\t\tt.Fatalf(\"response = %d %s\", w.Code, w.Body)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestDesktopModelsSlowDiscoveryDoesNotBlockSavedSettings(t *testing.T) {","+\tt.Setenv(\"HOME\", t.TempDir())","+\tcontroller, factory := codexDesktop, codexDesktopClientFactory","+\trecommendations, access, cloud := codexDesktopRecommendations, codexDesktopAccessState, codexDesktopCloudModels","+\tt.Cleanup(func() {","+\t\tcodexDesktop, codexDesktopClientFactory = controller, factory","+\t\tcodexDesktopRecommendations, codexDesktopAccessState, codexDesktopCloudModels = recommendations, access, cloud","+\t})","+\tcodexDesktop = &fakeCodexDesktopController{installed: true}","+\tcodexDesktopClientFactory = func() (*api.Client, error) {","+\t\treturn api.NewClient(&url.URL{Scheme: \"http\", Host: \"127.0.0.1\"}, http.DefaultClient), nil","+\t}","+\tstarted := make(chan struct{})","+\tcodexDesktopRecommendations = func(ctx context.Context) ([]api.ModelRecommendation, error) {","+\t\tclose(started)","+\t\t<-ctx.Done()","+\t\treturn nil, ctx.Err()","+\t}","+\tcodexDesktopAccessState = func(ctx context.Context) (proxy.ClaudeDesktopAccessState, error) {","+\t\treturn proxy.ClaudeDesktopAccessState{}, ctx.Err()","+\t}","+\tcodexDesktopCloudModels = func(ctx context.Context) ([]string, error) { return nil, ctx.Err() }","+","+\tctx, cancel := context.WithCancel(context.Background())","+\tdefer cancel()","+\tr := httptest.NewRequest(http.MethodGet, \"/?catalog=true\", nil).WithContext(ctx)","+\tr.SetPathValue(\"integration\", \"chatgpt\")","+\tw := httptest.NewRecorder()","+\thandler := desktopModelSettingsHandler()","+\tdone := make(chan struct{})","+\tgo func() { defer close(done); handler.ServeHTTP(w, r) }()","+\tt.Cleanup(func() { cancel(); <-done })","+\tselect {","+\tcase <-started:","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"discovery did not start\")","+\t}","+\tsummary := httptest.NewRequest(http.MethodGet, \"/?catalog=false\", nil)","+\tsummary.SetPathValue(\"integration\", \"chatgpt\")","+\tsummaryDone := make(chan struct{})","+\tgo func() {","+\t\tdefer close(summaryDone)","+\t\thandler.ServeHTTP(httptest.NewRecorder(), summary)","+\t}()","+\tselect {","+\tcase <-summaryDone:","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"saved settings waited for model discovery\")","+\t}","+\tcancel()","+\tselect {","+\tcase <-done:","+\tcase <-time.After(time.Second):","+\t\tt.Fatal(\"discovery did not honor cancellation\")","+\t}","+\tif w.Code != http.StatusGatewayTimeout {","+\t\tt.Fatalf(\"canceled discovery returned %d\", w.Code)","+\t}","+}"],"additions":149,"deletions":0,"truncated":false},{"path":"app/cmd/app/desktop_models_windows.go","lines":["@@ -0,0 +1,7 @@","+//go:build windows","+","+package main","+","+import \"net/http\"","+","+func desktopModelSettingsHandler() http.Handler { return nil }"],"additions":7,"deletions":0,"truncated":false},{"path":"app/ui/app/package.json","lines":["@@ -13,6 +13,7 @@","     \"storybook\": \"storybook dev -p 6006\",","     \"build-storybook\": \"storybook build\",","     \"test\": \"vitest\",","+    \"test:browser\": \"vitest run --mode browser\",","     \"test:ui\": \"vitest --ui\",","     \"test:coverage\": \"vitest --coverage\"","   },"],"additions":1,"deletions":0,"truncated":false},{"path":"app/ui/app/src/api.test.ts","lines":["@@ -7,9 +7,47 @@ vi.mock(\"./lib/ollama-client\", () => ({"," import {","   fetchConnectUrl,","   getClaudeDesktopAvailableModels,","+  getClaudeDesktopModelsSettings,","+  getC