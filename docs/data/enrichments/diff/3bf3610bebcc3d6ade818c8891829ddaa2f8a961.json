{"id":"3bf3610bebcc3d6ade818c8891829ddaa2f8a961","axis":"silent","repo":"apache/hadoop","sha":"3bf3610bebcc3d6ade818c8891829ddaa2f8a961","parsed":{"files":[{"path":"hadoop-common-project/hadoop-common/src/main/java/org/apache/hadoop/security/token/delegation/AbstractDelegationTokenSecretManager.java","lines":["@@ -559,33 +559,61 @@ private void removeExpiredKeys() {","   ","   @Override","   protected byte[] createPassword(TokenIdent identifier) {","+    DelegationTokenInformation tokenInfo;","     this.apiLock.writeLock().lock();","     try {","-      int sequenceNum;","-      long now = Time.now();","-      sequenceNum = incrementDelegationTokenSeqNum();","-      identifier.setIssueDate(now);","-      identifier.setMaxDate(now + tokenMaxLifetime);","-      identifier.setMasterKeyId(currentKey.getKeyId());","-      identifier.setSequenceNumber(sequenceNum);","-      LOG.info(\"Creating password for identifier: \" + formatTokenId(identifier) +","-          \", currentKey: \" + currentKey.getKeyId());","-      byte[] password = createPassword(identifier.getBytes(), currentKey.getKey());","-      DelegationTokenInformation tokenInfo =","-          new DelegationTokenInformation(now + tokenRenewInterval, password,","-              getTrackingIdIfEnabled(identifier));","+      tokenInfo = prepareToken(identifier,","+          incrementDelegationTokenSeqNum());","       try {","         METRICS.trackStoreToken(() -> storeToken(identifier, tokenInfo));","       } catch (IOException ioe) {","         LOG.error(\"Could not store token \" + formatTokenId(identifier) + \"!!\", ioe);","       }","-      return password;","     } finally {","       this.apiLock.writeLock().unlock();","     }","+    logTokenCreation(identifier);","+    return tokenInfo.getPassword();","   }"," ","+  /**","+   * Initialize an identifier and its password using a consistent signing key.","+   * Sequence allocation and persistence are the caller's responsibility and","+   * must not be performed inside this critical section by external stores.","+   * The caller must not modify the identifier after preparation.","+   *","+   * @param identifier identifier to initialize","+   * @param sequenceNumber previously allocated unique sequence number","+   * @return prepared token information","+   */","+  protected final DelegationTokenInformation prepareToken(TokenIdent identifier,","+      int sequenceNumber) {","+    DelegationTokenInformation tokenInfo;","+    this.apiLock.writeLock().lock();","+    try {","+      long now = Time.now();","+      identifier.setIssueDate(now);","+      identifier.setMaxDate(now + tokenMaxLifetime);","+      identifier.setMasterKeyId(currentKey.getKeyId());","+      identifier.setSequenceNumber(sequenceNumber);","+      byte[] password = createPassword(identifier.getBytes(), currentKey.getKey());","+      tokenInfo = new DelegationTokenInformation(now + tokenRenewInterval, password,","+          getTrackingIdIfEnabled(identifier));","+    } finally {","+      this.apiLock.writeLock().unlock();","+    }","+    return tokenInfo;","+  }"," ","+  /**","+   * Log token creation after releasing the API write lock.","+   *","+   * @param identifier initialized token identifier","+   */","+  protected final void logTokenCreation(TokenIdent identifier) {","+    LOG.info(\"Creating password for identifier: \" + formatTokenId(identifier)","+        + \", currentKey: \" + identifier.getMasterKeyId());","+  }"," ","   /**","    * Find the DelegationTokenInformation for the given token id, and verify that"],"additions":42,"deletions":14,"truncated":false},{"path":"hadoop-common-project/hadoop-common/src/main/java/org/apache/hadoop/security/token/delegation/ZKDelegationTokenSecretManager.java","lines":["@@ -150,6 +150,7 @@ protected static CuratorFramework getCurator() {","   private CuratorCacheBridge keyCache;","   private CuratorCacheBridge tokenCache;","   private final int seqNumBatchSize;","+  private final Object sequenceNumberLock = new Object();","   private int currentSeqNum;","   private int currentMaxSeqNum;"," ","@@ -266,10 +267,9 @@ public void startThreads() throws IOException {","       }","       // the first batch range should be allocated during this starting window","       // by calling the incrSharedCount","-      currentSeqNum = incrSharedCount(delTokSeqCounter, seqNumBatchSize);","-      currentMaxSeqNum = currentSeqNum + seqNumBatchSize;","-      LOG.info(\"Fetched initial range of seq num, from {} to {} \",","-          currentSeqNum+1, currentMaxSeqNum);","+      synchronized (sequenceNumberLock) {","+        reserveTokenSequenceRange();","+      }","     } catch (Exception e) {","       throw new IOException(\"Could not start Sequence Counter\", e);","     }","@@ -499,29 +499,49 @@ private int incrSharedCount(SharedCount sharedCount, int batchSize)","     }","   }"," ","+  /**","+   * Reserves a range before updating local allocator state. The caller must","+   * hold sequenceNumberLock, including during initialization.","+   */","+  private void reserveTokenSequenceRange() throws Exception {","+    int start = incrSharedCount(delTokSeqCounter, seqNumBatchSize);","+    currentSeqNum = start;","+    currentMaxSeqNum = start + seqNumBatchSize;","+    LOG.info(\"Fetched new range of seq num, from {} to {}\",","+        currentSeqNum + 1, currentMaxSeqNum);","+  }","+","   @Override","   protected int incrementDelegationTokenSeqNum() {","-    // The secret manager will keep a local range of seq num which won't be","-    // seen by peers, so only when the range is exhausted it will ask zk for","-    // another range again","-    if (currentSeqNum >= currentMaxSeqNum) {","-      try {","-        // after a successful batch request, we can get the range starting point","-        currentSeqNum = incrSharedCount(delTokSeqCounter, seqNumBatchSize);","-        currentMaxSeqNum = currentSeqNum + seqNumBatchSize;","-        LOG.info(\"Fetched new range of seq num, from {} to {} \",","-            currentSeqNum+1, currentMaxSeqNum);","-      } catch (InterruptedException e) {","-        // The ExpirationThread is just finishing.. so dont do anything..","-        LOG.debug(","-            \"Thread interrupted while performing token counter increment\", e);","-        Thread.currentThread().interrupt();","-      } catch (Exception e) {","-        throw new RuntimeException(\"Could not increment shared counter !!\", e);","+    synchronized (sequenceNumberLock) {","+      // A range belongs exclusively to this manager. Never consume a number","+      // beyond the range unless its replacement was successfully reserved.","+      if (currentSeqNum >= currentMaxSeqNum) {","+        try {","+          reserveTokenSequenceRange();","+        } catch (InterruptedException e) {","+          Thread.currentThread().interrupt();","+          throw new IllegalStateException(\"Interrupted reserving token sequence range\", e);","+        } catch (Exception e) {","+          throw new IllegalStateException(\"Could not increment shared counter\", e);","+        }","       }","+      return ++currentSeqNum;","     }","+  }"," ","-    return ++currentSeqNum;","+  @Override","+  protected byte[] createPassword(TokenIdent identifier) {","+    // Neither range reservation nor token persistence may hold apiLock.","+    DelegationTokenInformation info = prepareToken(identifier,","+        incrementDelegationTokenSeqNum());","+    logTokenCreation(identifier);","+    try {","+      getMetrics().trackStoreToken(() -> storeToken(identifier, info));","+    } catch (IOException e) {","+      throw new IllegalStateException(\"Could not store delegation token\", e);","+    }","+    return info.getPassword();","   }"," ","   @Override"],"additions":42,"deletions":22,"truncated":false},{"path":"hadoop-common-project/hadoop-common/src/test/java/org/apache/hadoop/security/token/delegation/TestZKDelegationTokenCreation.java","lines":["@@ -0,0 +1,458 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+","+package org.apache.hadoop.security.token.delegation;","+","+import java.io.ByteArrayInputStream;","+import java.io.DataInputStream;","+import java.io.IOException;","+import java.lang.reflect.Field;","+import java.util.HashSet;","+import java.util.Set;","+import java.util.concurrent.CountDownLatch;","+import java.util.concurrent.ExecutorService;","+import java.util.concurrent.Executors;","+import java.util.concurrent.Future;","+import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.AtomicBoolean;","+import java.util.concurrent.atomic.AtomicLong;","+import java.util.concurrent.locks.ReentrantReadWriteLock;","+","+import org.apache.curator.test.TestingServer;","+import org.apache.curator.framework.recipes.shared.SharedCount;","+import org.apache.hadoop.conf.Configuration;","+import org.apache.hadoop.io.Text;","+import org.apache.hadoop.security.token.Token;","+import org.apache.hadoop.security.token.delegation.web.DelegationTokenIdentifier;","+import org.apache.log4j.AppenderSkeleton;","+import org.apache.log4j.Level;","+import org.apache.log4j.Logger;","+import org.apache.log4j.spi.LoggingEvent;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.Timeout;","+import org.junit.jupiter.api.condition.EnabledIfSystemProperty;","+","+import static org.junit.jupiter.api.Assertions.assertArrayEquals;","+import static org.junit.jupiter.api.Assertions.assertThrows;","+import static org.mockito.ArgumentMatchers.any;","+import static org.mockito.ArgumentMatchers.anyInt;","+import static org.mockito.Mockito.doThrow;","+import static org.mockito.Mockito.spy;","+import static org.junit.jupiter.api.Assertions.assertEquals;","+import static org.junit.jupiter.api.Assertions.assertFalse;","+import static org.junit.jupiter.api.Assertions.assertNotNull;","+import static org.junit.jupiter.api.Assertions.assertNull;","+import static org.junit.jupiter.api.Assertions.assertTrue;","+","+/** Tests creation ordering while external storage is slow. */","+@Timeout(60)","+public class TestZKDelegationTokenCreation {","+  private static class Manager extends","+      ZKDelegationTokenSecretManager<DelegationTokenIdentifier> {","+    private volatile CountDownLatch entered;","+    private volatile CountDownLatch release;","+    private volatile boolean blockAllocation;","+    private volatile long delayMillis;","+    private volatile boolean failStorage;","+","+    Manager(String connectString) {","+      super(configuration(connectString));","+    }","+","+    private static Configuration configuration(String connectString) {","+      Configuration conf = new Configuration(false);","+      conf.set(ZK_DTSM_ZK_CONNECTION_STRING, connectString);","+      conf.set(ZK_DTSM_ZK_AUTH_TYPE, \"none\");","+      conf.setInt(ZK_DTSM_TOKEN_SEQNUM_BATCH_SIZE, 3);","+      return conf;","+    }","+","+    @Override","+    public DelegationTokenIdentifier createIdentifier() {","+      return new DelegationTokenIdentifier(new Text(\"TEST\"));","+    }","+","+    @Override","+    protected void rollMasterKey() {","+      // Keep maintenance out of the creation-only concurrency experiment.","+    }","+","+    void rotate() throws IOException {","+      super.rollMasterKey();","+    }","+","+    byte[] sign(DelegationTokenIdentifier id) {","+      return createPassword(id.getBytes(), getDelegationKey(id.getMasterKeyId()).getKey());","+    }","+","+    private void awaitRelease() {","+      entered.countDown();","+      try {","+        if (!release.await(20, TimeUnit.SECONDS)) {","+          throw new IllegalStateException(\"Test did not release creation\");","+        }","+      } catch (InterruptedException e) {","+        Thread.currentThread().interrupt();","+        throw new IllegalStateException(e);","+      }","+    }","+","+    @Override","+    protected int incrementDelegationTokenSeqNum() {","+      if (blockAllocation && entered != null) {","+        awaitRelease();","+      }","+      return super.incrementDelegationTokenSeqNum();","+    }","+","+    @Override","+    protected void addOrUpdateToken(DelegationTokenIdentifier identifier,","+        DelegationTokenInformation info, boolean update) throws Exception {","+      if (!update) {","+        if (failStorage) {","+          throw new IOException(\"Injected create failure\");","+        }","+        if (!blockAllocation && entered != null) {","+          awaitRelease();","+        }","+        if (delayMillis > 0) {","+          Thread.sleep(delayMillis);","+        }","+      }","+      super.addOrUpdateToken(identifier, info, update);","+    }","+","+    Token<DelegationTokenIdentifier> issue() {","+      return new Token<>(new DelegationTokenIdentifier(","+          new Text(\"TEST\"), new Text(\"owner\"), new Text(\"renewer\"),","+          new Text()), this);","+    }","+","+    void verify(Token<DelegationTokenIdentifier> token) throws IOException {","+      verifyToken(identifier(token), token.getPassword());","+    }","+  }","+","+  private static void assertCreationLogOutsideWriteLock(","+      AbstractDelegationTokenSecretManager<?> manager, Runnable issue) throws Exception {","+    Field field = AbstractDelegationTokenSecretManager.class.getDeclaredField(\"apiLock\");","+    field.setAccessible(true);","+    ReentrantReadWriteLock lock = (ReentrantReadWriteLock) field.get(manager);","+    AtomicBoolean logged = new AtomicBoolean();","+    AtomicBoolean heldWriteLock = new AtomicBoolean();","+    Logger logger = Logger.getLogger(AbstractDelegationTokenSecretManager.class);","+    Level previousLevel = logger.getLevel();","+    AppenderSkeleton appender = new AppenderSkeleton() {","+      @Override","+      protected void append(LoggingEvent event) {","+        if (event.getRenderedMessage().startsWith(\"Creating password for identifier:\")) {","+          logged.set(true);","+          heldWriteLock.set(lock.isWriteLockedByCurrentThread());","+        }","+      }","+","+      @Override","+      public boolean requiresLayout() {","+        return false;","+      }","+","+      @Override","+      public void close() {","+      }","+    };","+    logger.setLevel(Level.INFO);","+    logger.addAppender(appender);","+    try {","+      issue.run();","+      assertTrue(logged.get(), \"Creation must retain its log message\");","+      assertFalse(heldWriteLock.get(), \"Creation logging must not hold the API write lock\");","+    } finally {","+      logger.removeAppender(appender);","+      logger.setLevel(previousLevel);","+    }","+  }","+","+  @Test","+  public void testInMemoryCreationLogOutsideWriteLock() throws Exception {","+    TestDelegationToken.TestDelegationTokenSecretManager manager =","+        new TestDelegationToken.TestDelegationTokenSecretManager(","+            3600000, 3600000, 3600000, 3600000);","+    try {","+      manager.startThreads();","+      assertCreationLogOutsideWriteLock(manager, () -> new Token<>(","+          new TestDelegationToken.TestDelegationTokenIdentifier(","+              new Text(\"owner\"), new Text(\"renewer\"), new Text()), manager));","+    } finally {","+      manager.stopThreads();","+    }","+  }","+","+  @Test","+  public void testZKCreationLogOutsideWriteLock() throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager manager = new Manager(server.getConnectString());","+      try {","+        manager.startThreads();","+        assertCreationLogOutsideWriteLock(manager, manager::issue);","+      } finally {","+        manager.stopThreads();","+      }","+    }","+  }","+","+  private static DelegationTokenIdentifier identifier(","+      Token<DelegationTokenIdentifier> token) throws IOException {","+    DelegationTokenIdentifier identifier =","+        new DelegationTokenIdentifier(new Text(\"TEST\"));","+    try (DataInputStream input = new DataInputStream(","+        new ByteArrayInputStream(token.getIdentifier()))) {","+      identifier.readFields(input);","+    }","+    return identifier;","+  }","+","+  @Test","+  public void testVerificationDuringPersistence() throws Exception {","+    verifyWhileCreationBlocked(false);","+  }","+","+  @Test","+  public void testVerificationDuringAllocation() throws Exception {","+    verifyWhileCreationBlocked(true);","+  }","+","+  private void verifyWhileCreationBlocked(boolean allocation) throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager manager = new Manager(server.getConnectString());","+      ExecutorService workers = Executors.newFixedThreadPool(2);","+      try {","+        manager.startThreads();","+        Token<DelegationTokenIdentifier> existing = manager.issue();","+        manager.verify(existing); // Warm the cache before blocking creation.","+        manager.blockAllocation = allocation;","+        manager.entered = new CountDownLatch(1);","+        manager.release = new CountDownLatch(1);","+        Future<Token<DelegationTokenIdentifier>> creation =","+            workers.submit(manager::issue);","+        assertTrue(manager.entered.await(10, TimeUnit.SECONDS));","+        assertFalse(creation.isDone(), \"Issuance must wait for storage/allocation\");","+        Future<?> verification = workers.submit(() -> {","+          manager.verify(existing);","+          return null;","+        });","+        verification.get(2, TimeUnit.SECONDS);","+        assertFalse(creation.isDone(), \"Verification must not release creation\");","+        manager.release.countDown();","+        Token<DelegationTokenIdentifier> created = creation.get(10, TimeUnit.SECONDS);","+        assertNotNull(manager.getTokenInfoFromZK(identifier(created)));","+        manager.verify(created);","+      } finally {","+        if (manager.release != null) {","+          manager.release.countDown();","+        }","+        workers.shutdownNow();","+        assertTrue(workers.awaitTermination(10, TimeUnit.SECONDS));","+        manager.stopThreads();","+      }","+    }","+  }","+","+  @Test","+  public void testConcurrentSequenceRanges() throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager first = new Manager(server.getConnectString());","+      Manager second = new Manager(server.getConnectString());","+      ExecutorService workers = Executors.newFixedThreadPool(8);","+      try {","+        first.startThreads();","+        second.startThreads();","+        Set<Future<Token<DelegationTokenIdentifier>>> creations = new HashSet<>();","+        for (int i = 0; i < 120; i++) {","+          Manager manager = i % 2 == 0 ? first : second;","+          creations.add(workers.submit(manager::issue));","+        }","+        Set<Integer> sequences = new HashSet<>();","+        for (Future<Token<DelegationTokenIdentifier>> creation : creations) {","+          Token<DelegationTokenIdentifier> token = creation.get(20, TimeUnit.SECONDS);","+          assertTrue(sequences.add(identifier(token).getSequenceNumber()));","+          assertNotNull(first.getTokenInfoFromZK(identifier(token)));","+          first.verify(token);","+          second.verify(token);","+        }","+        assertEquals(120, sequences.size());","+      } finally {","+        workers.shutdownNow();","+        assertTrue(workers.awaitTermination(10, TimeUnit.SECONDS));","+        first.stopThreads();","+        second.stopThreads();","+      }","+    }","+  }","+","+  @Test","+  public void testFailedPersistenceDoesNotPublishToken() throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager manager = new Manager(server.getConnectString());","+      try {","+        manager.startThreads();","+        manager.failStorage = true;","+        DelegationTokenIdentifier id = new DelegationTokenIdentifier(","+            new Text(\"TEST\"), new Text(\"owner\"), new Text(\"renewer\"), new Text());","+        assertThrows(RuntimeException.class, () -> new Token<>(id, manager));","+        assertNull(manager.getTokenInfoFromMemory(id));","+        assertNull(manager.getTokenInfoFromZK(id));","+      } finally {","+        manager.stopThreads();","+      }","+    }","+  }","+","+  @Test","+  public void testInterruptedRefillDoesNotIssueUnreservedNumber() throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager manager = new Manager(server.getConnectString());","+      try {","+        manager.startThreads();","+        for (int i = 0; i < 3; i++) {","+          manager.incrementDelegationTokenSeqNum();","+        }","+        Field field = ZKDelegationTokenSecretManager.class","+            .getDeclaredField(\"delTokSeqCounter\");","+        field.setAccessible(true);","+        SharedCount original = (SharedCount) field.get(manager);","+        SharedCount counter = spy(original);","+        doThrow(new InterruptedException(\"Injected interruption\"))","+            .when(counter).trySetCount(any(), anyInt());","+        field.set(manager, counter);","+        try {","+          assertThrows(IllegalStateException.class,","+              manager::incrementDelegationTokenSeqNum);","+          assertTrue(Thread.currentThread().isInterrupted());","+        } finally {","+          Thread.interrupted();","+          field.set(manager, original);","+        }","+      } finally {","+        manager.stopThreads();","+      }","+    }","+  }","+","+  @Test","+  public void testRotationDuringPersistenceUsesPreparedKey() throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager manager = new Manager(server.getConnectString());","+      ExecutorService worker = Executors.newSingleThreadExecutor();","+      try {","+        manager.startThreads();","+        manager.entered = new CountDownLatch(1);","+        manager.release = new CountDownLatch(1);","+        Future<Token<DelegationTokenIdentifier>> creation = worker.submit(manager::issue);","+        assertTrue(manager.entered.await(10, TimeUnit.SECONDS));","+        // Invoke the actual implementation rather than the maintenance override.","+        manager.rotate();","+        manager.release.countDown();","+        Token<DelegationTokenIdentifier> token = creation.get(10, TimeUnit.SECONDS);","+        DelegationTokenIdentifier id = identifier(token);","+        assertArrayEquals(token.getPassword(), manager.sign(id));","+        manager.verify(token);","+      } finally {","+        if (manager.release != null) {","+          manager.release.countDown();","+        }","+        worker.shutdownNow();","+        assertTrue(worker.awaitTermination(10, TimeUnit.SECONDS));","+        manager.stopThreads();","+      }","+    }","+  }","+","+  /** Opt-in experiment; use the same test against the parent and fixed code. */","+  @Test","+  @Timeout(300)","+  @EnabledIfSystemProperty(named = \"token.creation.benchmark\", matches = \"true\")","+  public void testVerificationThroughputWithSlowCreation() throws Exception {","+    String[] delays = System.getProperty(\"token.creation.benchmark.delays.ms\",","+        \"0,1,2,5,10,25\").split(\",\");","+    int repetitions = Integer.getInteger(\"token.creation.benchmark.repetitions\", 3);","+    for (int repetition = 1; repetition <= repetitions; repetition++) {","+      for (String delay : delays) {","+        measureThroughput(Long.parseLong(delay.trim()), repetition);","+      }","+    }","+  }","+","+  private void measureThroughput(long delayMillis, int repetition) throws Exception {","+    try (TestingServer server = new TestingServer()) {","+      Manager manager = new Manager(server.getConnectString());","+      ExecutorService workers = Executors.newFixedThreadPool(9);","+      AtomicBoolean running = new AtomicBoolean(true);","+      AtomicBoolean measuring = new AtomicBoolean(false);","+      AtomicLong verifications = new AtomicLong();","+      AtomicLong creations = new AtomicLong();","+      Set<Future<?>> tasks = new HashSet<>();","+      try {","+        manager.startThreads();","+        Token<DelegationTokenIdentifier> existing = manager.issue();","+        manager.verify(existing);","+        manager.delayMillis = delayMillis;","+        tasks.add(workers.submit(() -> {","+          while (running.get()) {","+            manager.issue();","+            if (measuring.get()) {","+              creations.incrementAndGet();","+            }","+          }","+        }));","+        for (int i = 0; i < 8; i++) {","+          tasks.add(workers.submit(() -> {","+            while (running.get()) {","+              manager.verify(existing);","+              if (measuring.get()) {","+                verifications.incrementAndGet();","+              }","+            }","+            return null;","+          }));","+        }","+        Thread.sleep(1000); // Warm up before measuring each scenario.","+        long start = System.nanoTime();","+        measuring.set(true);","+        Thread.sleep(3000);","+        measuring.set(false);","+        double seconds = (System.nanoTime() - start) / 1_000_000_000.0;","+        running.set(false);","+        for (Future<?> task : tasks) {","+          task.get(15, TimeUnit.SECONDS);","+        }","+        System.out.printf(\"TOKEN_CREATION_BENCHMARK delayMillis=%d repetition=%d \"","+            + \"seconds=%.3f verifications=%d verifyPerSecond=%.1f \"","+            + \"creations=%d createPerSecond=%.1f%n\", delayMillis, repetition,","+            seconds, verifications.get(), verifications.get() / seconds,","+            creations.get(), creations.get() / seconds);","+        assertTrue(creations.get() > 0);","+        assertTrue(verifications.get() > 0);","+      } finally {","+        running.set(false);","+        workers.shutdownNow();","+        assertTrue(workers.awaitTermination(10, TimeUnit.SECONDS));","+        manager.stopThreads();","+      }","+    }","+  }","+}"],"additions":458,"deletions":0,"truncated":false},{"path":"hadoop-common-project/hadoop-common/src/test/scripts/kms-http-benchmark/README.md","lines":["@@ -0,0 +1,128 @@","+<!--","+  Licensed to the Apache Software Foundation (ASF) under one","+  or more contributor license agreements. See the NOTICE file","+  distributed with this work for additional information","+  regarding copyright ownership. The ASF licenses this file","+  to you under the Apache License, Version 2.0 (the","+  \"License\"); you may not use this file except in compliance","+  with the License. You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+  Unless required by applicable law or agreed to in writing, software","+  distributed under the License is distributed on an \"AS IS\" BASIS,","+  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+  See the License for the specific language governing permissions and","+  limitations under the License.","+-->","+","+# KMS HTTP throughput benchmark","+","+This opt-in benchmark compares original and fixed delegation-token secret-manager code through real KMS HTTP requests. Each case runs one KMS server JVM, one standalone ZooKeeper JVM, and a separate load-generator JVM. It injects no storage delay and fixes the sequence-number batch size at the trunk default of 100.","+","+## Workloads","+","+A verify operation is `GET /kms/v1/key/benchmark-key/_metadata` with an existing delegation token in the `X-Hadoop-Delegation-Token` header and no authentication cookie. A create operation is `GET /kms/v1/?op=GETDELEGATIONTOKEN&renewer=benchmark&user.name=benchmark` with primary simple authentication and no delegation-token header.","+","+The verify request traverses KMS authentication, delegation-token password verification, authorization, the cached key provider, JSON serialization, and HTTP response processing. The create request traverses KMS primary authentication, token preparation, synchronous ZooKeeper persistence, serialization, and HTTP response processing. A precreated local JCEKS key avoids changing key material during measurement.","+","+The benchmark uses simple authentication for issuance so that only KMS and ZooKeeper servers are needed. It does not measure Kerberos handshakes, TLS, a ZooKeeper quorum, encryption throughput, or production storage/network capacity.","+","+```mermaid","+flowchart LR","+  C[Load generator JVM] -->|Token authenticated metadata GET| K[One KMS JVM]","+  C -->|GETDELEGATIONTOKEN| K","+  K -->|Real token writes and range reservation| Z[One ZooKeeper JVM]","+  K --> P[Local JCEKS provider]","+```","+","+## Fixed comparison matrix","+","+| Dimension | Values |","+| --- | --- |","+| Code | Original and fixed common jar |","+| Verify to create ratio | 100:0, 99:1, 95:5, 90:10 |","+| Concurrent HTTP requests | 32 |","+| Sequence batch size | 100 |","+| Added latency | None |","+| Repetitions | Three |","+| Warmup per case | Five seconds |","+| Measurement per case | Fifteen seconds |","+","+There are eight configurations and 24 cases. The full concurrency sweep is excluded. Warmup and measurement alone take eight minutes; startup, preflight checks, Maven, and draining add overhead. Each case has fresh server processes, ZooKeeper data, and a key store. Each original/fixed pair uses the same seeded request schedule, and pair order alternates across repetitions.","+","+## Authentication and artifact checks","+","+Before loading the server, the harness configures the same test-only diagnostic subclass of KMS's normal pseudo delegation-token handler for both versions. All authentication and token-management behavior delegates to the real implementation. During preflight it counts entry to delegation-token authentication and token-acquisition management operations, checks the actual secret-manager class is `DelegationTokenManager$ZKSecretManager`, checks successful authenticated metadata access, and checks rejection of a token with an invalid password and a request with no credentials. Diagnostic counters are disabled before warmup.","+","+The HTTP client disables cookie management, redirects, and automatic retries. A primary-authentication cookie therefore cannot bypass delegation-token verification, and retry traffic cannot silently change the requested mix. Each successful acquisition response is decoded and its token kind and nonempty identifier/password are checked. Issued tokens are not renewed or cancelled during load.","+","+The child KMS process records its loaded common-jar location and SHA-256 hashes of the actual abstract and ZooKeeper secret-manager class bytes. The comparison runner checks those hashes against the requested jars for every case. The same KMS and client code are used in both versions; only the child server classpaths change. Neither sources nor installed Maven artifacts are modified by the comparison runner."],"additions":60,"deletions":0,"truncated":false}],"additions":602,"deletions":36,"truncated":true,"file_count":4},"error":null,"fetched_at":"2026-11-04T16:06:09.895116+00:00"}