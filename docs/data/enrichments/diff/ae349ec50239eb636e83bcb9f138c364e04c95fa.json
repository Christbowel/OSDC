, FetchResult } from '@pnpm/fetching.fetcher-base'"," import type { FetchFromRegistry, GetAuthHeader } from '@pnpm/fetching.types'","+import { assertUnpackedSize, DEFAULT_MAX_TARBALL_UNPACKED_SIZE } from '@pnpm/store.cafs'"," import type { StoreIndex } from '@pnpm/store.index'"," import { addFilesFromDir } from '@pnpm/worker'"," import { isSubdir } from 'is-subdir'","@@ -29,6 +30,8 @@ export interface CreateBinaryFetcherOptions {","    * archive's top-level directory (i.e. after the `prefix` has been stripped).","    */","   archiveFilters?: Record<string, string>","+  /** Limits the total size of the files extracted from a zip archive. */","+  maxTarballUnpackedSize?: number"," }"," "," export function createBinaryFetcher (ctx: CreateBinaryFetcherOptions): { binary: BinaryFetcher } {","@@ -123,6 +126,7 @@ async function fetchZipArchive (","     basename: resolution.prefix ?? '',","     authHeaderValue: getSecureNodeMirrorAuthHeader(ctx.getAuthHeader, resolution.url, opts.pkg.name),","     ignoreEntry: archiveFilter?.regex,","+    maxTarballUnpackedSize: ctx.maxTarballUnpackedSize,","   }, tempLocation)","   return addFilesFromDir({","     storeDir: cafs.storeDir,","@@ -161,6 +165,8 @@ export interface AssetInfo {","    * Matching entries are skipped during extraction.","    */","   ignoreEntry?: RegExp","+  /** The most bytes the extracted files may total. Defaults to `DEFAULT_MAX_TARBALL_UNPACKED_SIZE`. */","+  maxTarballUnpackedSize?: number"," }"," "," /**","@@ -179,7 +185,7 @@ export async function downloadAndUnpackZip ("," ","   try {","     await downloadWithIntegrityCheck(fetchFromRegistry, assetInfo, tmp)","-    await extractZipToTarget(tmp, assetInfo.basename, targetDir, assetInfo.ignoreEntry)","+    await extractZipToTarget(tmp, assetInfo.basename, targetDir, assetInfo)","   } finally {","     try {","       await fsPromises.unlink(tmp)","@@ -226,7 +232,7 @@ async function extractZipToTarget (","   zipPath: string,","   basename: string,","   targetDir: s