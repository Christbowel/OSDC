  ? player.firstFrameAt - requestedAt","+    firstFrameAt != null && manifestLoadedAt != null","+      ? Math.max(0, firstFrameAt - manifestLoadedAt)","+      : null","+  const manifestMs =","+    manifestLoadedAt != null && requestedAt != null","+      ? Math.max(0, manifestLoadedAt - requestedAt)","       : null","   const stallMs = qoe.stalls.reduce((sum, s) => sum + stallDuration(s, now), 0)","   const rebufferRatio =","@@ -146,6 +153,7 @@ export function computeQoeMetrics("," ","   return {","     startupMs,","+    manifestMs,","     stallCount: qoe.stalls.length,","     stallMs,","     rebufferRatio,"],"additions":13,"deletions":5,"truncated":false},{"path":"apps/console/src/lib/i18n/dictionaries/he/videos.ts","lines":["@@ -725,7 +725,10 @@ export const heVideosDictionary: Record<string, string> = {","   Fair: 'סביר',","   Poor: 'חלש',","   Startup: 'זמן פתיחה',","-  'Time until the first frame': 'הזמן עד לפריים הראשון',","+  'Time from the manifest to the first frame':","+    'הזמן מהמניפסט ועד לפריים הראשון',","+  'Manifest (not counted)': 'מניפסט (לא נספר)',","+  'Metadata (not counted)': 'מטא-נתונים (לא נספרים)',","   Smoothness: 'רציפות',","   'Stalls and time spent rebuffering': 'עצירות וזמן המתנה לטעינה',","   'Picture quality': 'איכות תמונה',"],"additions":4,"deletions":1,"truncated":false},{"path":"apps/console/src/lib/i18n/dictionaries/ja/videos.ts","lines":["@@ -739,7 +739,10 @@ export const jaVideosDictionary: Record<string, string> = {","   Fair: '普通',","   Poor: '悪い',","   Startup: '起動',","-  'Time until the first frame': '最初のフレームまでの時間',","+  'Time from the manifest to the first frame':","+    'マニフェストから最初のフレームまでの時間',","+  'Manifest (not counted)': 'マニフェスト（計測外）',","+  'Metadata (not counted)': 'メタデータ（計測外）',","   Smoothness: 'スムーズさ',","   'Stalls and time spent rebuffering': '停止回数とリバッファリング時間',","   'Picture quality': '画質',"],"additions":4,"deletions":1,"truncated":false},{"path":"apps/console/src/lib/videos/first-frame.ts","lines":["@@ -0,0 +1,55 @@","+/**","+ * When a `<video>` first has a picture to show, on the page's monotonic clock","+ * (`performance.now()`), the clock players time their requests with.","+ *","+ * `loadeddata` says so once the main thread gets to it, so a busy page hears","+ * it late. `requestVideoFrameCallback` reports when the frame reached the","+ * compositor, whatever the main thread was doing. The earlier of the two","+ * counts: a browser that presents the first frame only once playback starts","+ * reports it later, and waiting for the viewer to press play is not startup.","+ *","+ * Calls `onFrame` with each earlier time it learns of, and returns a function","+ * that stops watching.","+ */","+export function watchFirstFrame(","+  video: HTMLVideoElement,","+  onFrame: (at: number) => void,","+): () => void {","+  // A frame presented before this point is the previous source's.","+  const since = performance.now()","+  let first = Number.POSITIVE_INFINITY","+  const report = (at: number) => {","+    if (at >= first) return","+    first = at","+    onFrame(at)","+  }","+","+  const onLoadedData = (event: Event) => report(eventTime(event))","+  video.addEventListener('loadeddata', onLoadedData)","+","+  let request: number | null = null","+  const awaitFrame = () => {","+    request = video.requestVideoFrameCallback((_now, frame) => {","+      request = null","+      const at = frame.presentationTime","+      if (at < since) {","+        // Once `loadeddata` has come, a later frame cannot be the first.","+        if (first === Number.POSITIVE_INFINITY) awaitFrame()","+        return","+      }","+      if (at <= performance.now()) report(at)","+    })","+  }","+  if (typeof video.requestVideoFrameCallback === 'function') awaitFrame()","+","+  return () => {","+    video.removeEventListener('loadeddata', onLoadedData)","+    if (request != null) video.cancelVideoFrameCallback(request)","+  }","+}","+","+/** When the browser fired `event`, on the same clock; now when it cannot say. */","+export function eventTime(event: Event): number {","+  const now = performance.now()","+  return event.timeStamp > 0 && event.timeStamp <= now ? event.timeStamp : now","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"apps/console/tests/unit/video-first-frame.test.ts","lines":["@@ -0,0 +1,112 @@","+import { describe, expect, test } from 'bun:test'","+import { eventTime, watchFirstFrame } from '@/lib/videos/first-frame'","+","+type FrameCallback = (now: number, frame: { presentationTime: number }) => void","+","+/** A `<video>` that presents a frame when the test says so. */","+class FakeVideo extends EventTarget {","+  private callbacks = new Map<number, FrameCallback>()","+  private lastId = 0","+","+  requestVideoFrameCallback(callback: FrameCallback): number {","+    this.lastId += 1","+    this.callbacks.set(this.lastId, callback)","+    return this.lastId","+  }","+","+  cancelVideoFrameCallback(id: number): void {","+    this.callbacks.delete(id)","+  }","+","+  /** Runs the waiting callbacks for a frame presented at `presentationTime`. */","+  present(presentationTime: number): void {","+    const waiting = [...this.callbacks.values()]","+    this.callbacks.clear()","+    for (const callback of waiting) {","+      callback(performance.now(), { presentationTime })","+    }","+  }","+","+  get waiting(): number {","+    return this.callbacks.size","+  }","+}","+","+/** A browser without `requestVideoFrameCallback`. */","+class OlderVideo extends EventTarget {}","+","+function loadedData(timeStamp: number): Event {","+  const event = new Event('loadeddata')","+  Object.defineProperty(event, 'timeStamp', { value: timeStamp })","+  return event","+}","+","+function watch(video: EventTarget) {","+  const frames: number[] = []","+  const stop = watchFirstFrame(video as unknown as HTMLVideoElement, (at) =>","+    frames.push(at),","+  )","+  return { frames, stop }","+}","+","+describe('watchFirstFrame', () => {","+  test('takes the frame the compositor got before loadeddata reached the page', () => {","+    const video = new FakeVideo()","+    const { frames, stop } = watch(video)","+    const presented = performance.now()","+    video.dispatchEvent(loadedData(performance.now()))","+    video.present(presented)","+    expect(frames.at(-1)).toBe(presented)","+    stop()","+  })","+","+  test('keeps loadeddata when the frame shows only once playback starts', () => {","+    const video = new FakeVideo()","+    const { frames, stop } = watch(video)","+    const announced = performance.now()","+    video.dispatchEvent(loadedData(announced))","+    video.present(performance.now())","+    expect(frames).toEqual([announced])","+    stop()","+  })","+","+  test('skips a frame from the previous source and waits for the next', () => {","+    const video = new FakeVideo()","+    const before = performance.now()","+    const { frames, stop } = watch(video)","+    video.present(before - 1)","+    expect(frames).toEqual([])","+    expect(video.waiting).toBe(1)","+    const presented = performance.now()","+    video.present(presented)","+    expect(frames).toEqual([presented])","+    stop()","+  })","+","+  test('uses loadeddata where the browser cannot report frames', () => {","+    const video = new OlderVideo()","+    const { frames, stop } = watch(video)","+    const announced = performance.now()","+    video.dispatchEvent(loadedData(announced))","+    expect(frames).toEqual([announced])","+    stop()","+  })","+","+  test('stops listening once cleaned up', () => {","+    const video = new FakeVideo()","+    const { frames, stop } = watch(video)","+    stop()","+    expect(video.waiting).toBe(0)","+    video.dispatchEvent(loadedData(performance.now()))","+    expect(frames).toEqual([])","+  })","+})","+","+describe('eventTime', () => {","+  test(\"reads the event's time, or now when it carries none\", () => {","+    const at = performance.now()","+    expect(eventTime(loadedData(at))).toBe(at)","+    const before = performance.now()","+    expect(eventTime(loadedData(0))).toBeGreaterThanOrEqual(before)","+  })","+})"],"additions":112,"deletions":0,"truncated":false},{"path":"apps/console/tests/unit/video-qoe-startup.test.ts","lines":["@@ -40,21 +40,28 @@ function player(timing: Partial<StreamPlayerState>): StreamPlayerState {"," }"," "," describe('computeQoeMetrics startup', () => {","-  test('starts at the stream request, not while the player library loads', () => {","+  test(\"counts from the manifest's last byte to the first frame\", () => {","     const metrics = computeQoeMetrics(","       qoe,","-      player({ loadStartedAt: 1000, requestedAt: 1500, firstFrameAt: 1660 }),","+      player({","+        loadStartedAt: 1000,","+        requestedAt: 1500,","+        manifestLoadedAt: 1620,","+        firstFrameAt: 1706,","+      }),","       null,","     )","-    expect(metrics.startupMs).toBe(160)","+    expect(metrics.startupMs).toBe(86)","+    expect(metrics.manifestMs).toBe(120)","   })"," ","-  test('falls back to the mount when the request time is unknown', () => {","+  test('waits for the manifest instead of counting from the request', () => {","     const metrics = computeQoeMetrics(","       qoe,","-      player({ loadStartedAt: 1000, firstFrameAt: 1660 }),","+      player({ loadStartedAt: 1000, requestedAt: 1500, firstFrameAt: 1706 }),","       null,","     )","-    expect(metrics.startupMs).toBe(660)","+    expect(metrics.startupMs).toBeNull()","+    expect(metrics.manifestMs).toBeNull()","   })"," })",""],"additions":13,"deletions":6,"truncated":false}],"additions":328,"deletions":50,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-27T19:03:19.806765+00:00"}