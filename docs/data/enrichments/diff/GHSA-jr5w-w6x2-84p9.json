{"id":"GHSA-jr5w-w6x2-84p9","axis":"advisories","repo":"electron/electron","sha":"093583c71be71c85453e6e225137bf2af755fbcc","parsed":{"files":[{"path":"patches/chromium/.patches","lines":["@@ -483,3 +483,4 @@ cherry-pick-1d69cc5a0259.patch"," cherry-pick-cc41d04685b9.patch"," cherry-pick-3f6b73b9e0b3.patch"," cherry-pick-08f529c57faa.patch","+add_entries_to_the_spki_blocklist.patch"],"additions":1,"deletions":0,"truncated":false},{"path":"patches/chromium/add_entries_to_the_spki_blocklist.patch","lines":["@@ -0,0 +1,55 @@","+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","+From: Sam Attard <sattard@anthropic.com>","+Date: Tue, 20 Oct 2026 00:13:01 +0000","+Subject: Add entries to the SPKI blocklist","+","+Adds public key hashes that Chrome ships to its users through the CRLSet","+component, which Electron does not consume, so they are carried in the","+compiled-in list instead. The comment above each entry is the SHA-256","+fingerprint of the corresponding certificate.","+","+This patch can be removed once the hashes land in the upstream blocklist.","+","+diff --git a/net/cert/cert_verify_proc_blocklist.inc b/net/cert/cert_verify_proc_blocklist.inc","+index bbe9b585a379810582ad55a6e59f7232d46fcd7a..b2f5e32365fb2a039b430d408114b83752ceb1b9 100644","+--- a/net/cert/cert_verify_proc_blocklist.inc","+@@ -395,6 +395,38 @@ static constexpr uint8_t","+         {0x89, 0x28, 0xc5, 0x93, 0x98, 0xb0, 0xf1, 0x71, 0xc0, 0xf9, 0x6f,","+          0xda, 0xe6, 0xab, 0x8d, 0xd0, 0xf4, 0x8e, 0xe0, 0x6d, 0x17, 0x4d,","+          0xa1, 0x0c, 0x40, 0x4a, 0xc0, 0x01, 0x43, 0xc7, 0xa7, 0x49},","++        // 0164d7ceae5bb909c272af151ff44b1177ae9b47d9424b94f1d9558c30934d19.pem","++        {0x49, 0xdd, 0x35, 0x3d, 0xc2, 0xb9, 0x19, 0xa3, 0x77, 0x06, 0x45,","++         0x11, 0x7d, 0x0e, 0x60, 0xc1, 0x61, 0x15, 0xe7, 0xd1, 0xbc, 0x25,","++         0x9e, 0xef, 0xe7, 0x34, 0xb0, 0x0e, 0xa4, 0x34, 0xfe, 0x5f},","++        // 432ec25f0d28de9006d97bf752f17bbb2cd41f669933fcb072d9a1148d0261f3.pem","++        {0x5c, 0x06, 0x60, 0xa2, 0xb1, 0x64, 0x91, 0x0d, 0x8f, 0xf5, 0x89,","++         0xc1, 0x8e, 0x14, 0x55, 0x2e, 0x9e, 0x0e, 0xc2, 0x37, 0xdc, 0xef,","++         0xe2, 0xcb, 0x73, 0x6d, 0x41, 0xa4, 0x81, 0x1f, 0x81, 0xa0},","++        // cb6e15165ac802e9b3f993f16c25d41f4e81c21ebde71ae1b012ac00bf9c7c3f.pem","++        {0x63, 0xec, 0xef, 0xee, 0x43, 0x1d, 0x49, 0x52, 0x3b, 0xc1, 0x13,","++         0x6c, 0x4e, 0x72, 0xd0, 0x20, 0x6a, 0x47, 0x70, 0x86, 0xca, 0xf6,","++         0x06, 0xcd, 0x5c, 0xf0, 0x25, 0x68, 0x6c, 0x10, 0x9c, 0xf8},","++        // 4b2460a466f95fd40113bcdcca2ceb29b3b093921de45474da7df48874c630b1.pem","++        {0x92, 0xc0, 0x63, 0xd6, 0x7e, 0x8f, 0x14, 0xdb, 0x71, 0xd2, 0x88,","++         0xe1, 0x12, 0x66, 0xff, 0xda, 0xf6, 0x9c, 0xbf, 0x11, 0x5f, 0x7b,","++         0xab, 0x14, 0xf3, 0xbc, 0x2f, 0x68, 0xd2, 0x5e, 0x0e, 0x30},","++        // 42c4accd12c4f59597925e1a08a7a90102608543809308d50ec427e118ba1493.pem","++        {0xeb, 0xed, 0x64, 0x75, 0xc2, 0xc2, 0xd8, 0x0f, 0xcb, 0x19, 0x9f,","++         0x3f, 0xe8, 0xdd, 0x6e, 0x6b, 0x3c, 0xe6, 0x0b, 0x77, 0xeb, 0x15,","++         0xd4, 0xe4, 0x2c, 0x3d, 0xec, 0x0c, 0x6f, 0x5b, 0x51, 0x05},","++        // 9e39de2881273acc225a149c72ba3e0f51424963669ab633ee1dc7df5db067b4.pem","++        {0xec, 0x4f, 0xfa, 0x1a, 0xd0, 0xac, 0x88, 0x08, 0x13, 0x14, 0xb7,","++         0xaa, 0xff, 0xef, 0x6a, 0x91, 0xf9, 0x7c, 0xd5, 0x72, 0x91, 0xbb,","++         0x5b, 0xa6, 0x86, 0xc5, 0x41, 0x5f, 0x5e, 0xb4, 0xf6, 0xb6},","++        // 98b896625c0c230adeec3eb2cf6aad5001ecf9156a68644e82374ce5833bc25b.pem","++        {0x43, 0xbf, 0xfa, 0x19, 0xd6, 0xef, 0x65, 0x14, 0x51, 0xf6, 0x84,","++         0x1e, 0x01, 0x99, 0x31, 0xe9, 0x6f, 0x6f, 0x2e, 0xae, 0xff, 0x28,","++         0xab, 0x4b, 0x6f, 0x1c, 0xe4, 0x57, 0x6d, 0xe2, 0x71, 0x7b},","++        // e7568fe6e12331f4fd7de61da4c7559d0f8eb192a218d4741a3ba75184333838.pem","++        {0xe0, 0x25, 0x4c, 0x7f, 0xcd, 0xc2, 0x65, 0xe2, 0xf0, 0xf8, 0xa4,","++         0x28, 0xda, 0xbb, 0x75, 0xab, 0x4a, 0xe0, 0x39, 0xb4, 0x87, 0x2d,","++         0x62, 0xf5, 0xee, 0x57, 0xf0, 0x87, 0x7d, 0x5a, 0x8a, 0x41},","+ };","+ ","+ // Hashes of SubjectPublicKeyInfos known to be used for interception by a"],"additions":54,"deletions":0,"truncated":false},{"path":"patches/node/.patches","lines":["@@ -64,3 +64,4 @@ src_keep_global_list_of_addon-provided_cleanup_hooks.patch"," src_fix_use-after-free_in_cleanuphookthunkrun.patch"," test_add_regression_test_for_cleanup_hook_uaf.patch"," fs_support_removing_read-only_files_in_rmsync_on_windows.patch","+tls_reject_chains_containing_blocked_public_keys.patch"],"additions":1,"deletions":0,"truncated":false},{"path":"patches/node/tls_reject_chains_containing_blocked_public_keys.patch","lines":["@@ -0,0 +1,167 @@","+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","+From: Sam Attard <sattard@anthropic.com>","+Date: Tue, 20 Oct 2026 00:10:09 +0000","+Subject: tls: reject chains containing blocked public keys","+","+Node has no equivalent of Chromium's SPKI blocklist, so a chain through a","+key on that list still verifies in Node as long as it reaches a trusted","+root. Wrap X509_verify_cert for every SecureContext and report","+X509_V_ERR_CERT_REVOKED when any certificate in the verified chain (or,","+if no chain could be built, any certificate the peer sent) has a","+SubjectPublicKeyInfo hash on a small compiled-in list. The list mirrors","+the entries Electron adds to Chromium's net blocklist. Test-only hooks","+allow the spec suite to extend the list at runtime.","+","+diff --git a/src/crypto/crypto_context.cc b/src/crypto/crypto_context.cc","+index 6fd9f1488aa319780df47bb182b4a25f107190dc..77ea6f6786da631a519604861a0d85a8213aaf69 100644","+--- a/src/crypto/crypto_context.cc","+@@ -17,6 +17,7 @@","+ #endif","+ #include <openssl/pkcs12.h>","+ #include <openssl/rand.h>","++#include <openssl/sha.h>","+ #include <openssl/x509.h>","+ #ifndef OPENSSL_NO_ENGINE","+ #include <openssl/engine.h>","+@@ -30,7 +31,10 @@","+ #include <wincrypt.h>","+ #endif","+ ","++#include <array>","++#include <cstring>","+ #include <set>","++#include <vector>","+ ","+ namespace node {","+ ","+@@ -78,6 +82,105 @@ using v8::String;","+ using v8::Value;","+ ","+ namespace crypto {","++","++namespace {","++","++// SHA-256 hashes of SubjectPublicKeyInfos that must never appear in a","++// verified chain, regardless of what the trust store says.","++constexpr uint8_t kBlockedSPKIs[][SHA256_DIGEST_LENGTH] = {","++    // 0164d7ceae5bb909c272af151ff44b1177ae9b47d9424b94f1d9558c30934d19","++    {0x49, 0xdd, 0x35, 0x3d, 0xc2, 0xb9, 0x19, 0xa3, 0x77, 0x06, 0x45,","++     0x11, 0x7d, 0x0e, 0x60, 0xc1, 0x61, 0x15, 0xe7, 0xd1, 0xbc, 0x25,","++     0x9e, 0xef, 0xe7, 0x34, 0xb0, 0x0e, 0xa4, 0x34, 0xfe, 0x5f},","++    // 432ec25f0d28de9006d97bf752f17bbb2cd41f669933fcb072d9a1148d0261f3","++    {0x5c, 0x06, 0x60, 0xa2, 0xb1, 0x64, 0x91, 0x0d, 0x8f, 0xf5, 0x89,","++     0xc1, 0x8e, 0x14, 0x55, 0x2e, 0x9e, 0x0e, 0xc2, 0x37, 0xdc, 0xef,","++     0xe2, 0xcb, 0x73, 0x6d, 0x41, 0xa4, 0x81, 0x1f, 0x81, 0xa0},","++    // cb6e15165ac802e9b3f993f16c25d41f4e81c21ebde71ae1b012ac00bf9c7c3f","++    {0x63, 0xec, 0xef, 0xee, 0x43, 0x1d, 0x49, 0x52, 0x3b, 0xc1, 0x13,","++     0x6c, 0x4e, 0x72, 0xd0, 0x20, 0x6a, 0x47, 0x70, 0x86, 0xca, 0xf6,","++     0x06, 0xcd, 0x5c, 0xf0, 0x25, 0x68, 0x6c, 0x10, 0x9c, 0xf8},","++    // 4b2460a466f95fd40113bcdcca2ceb29b3b093921de45474da7df48874c630b1","++    {0x92, 0xc0, 0x63, 0xd6, 0x7e, 0x8f, 0x14, 0xdb, 0x71, 0xd2, 0x88,","++     0xe1, 0x12, 0x66, 0xff, 0xda, 0xf6, 0x9c, 0xbf, 0x11, 0x5f, 0x7b,","++     0xab, 0x14, 0xf3, 0xbc, 0x2f, 0x68, 0xd2, 0x5e, 0x0e, 0x30},","++    // 42c4accd12c4f59597925e1a08a7a90102608543809308d50ec427e118ba1493","++    {0xeb, 0xed, 0x64, 0x75, 0xc2, 0xc2, 0xd8, 0x0f, 0xcb, 0x19, 0x9f,","++     0x3f, 0xe8, 0xdd, 0x6e, 0x6b, 0x3c, 0xe6, 0x0b, 0x77, 0xeb, 0x15,","++     0xd4, 0xe4, 0x2c, 0x3d, 0xec, 0x0c, 0x6f, 0x5b, 0x51, 0x05},","++    // 9e39de2881273acc225a149c72ba3e0f51424963669ab633ee1dc7df5db067b4","++    {0xec, 0x4f, 0xfa, 0x1a, 0xd0, 0xac, 0x88, 0x08, 0x13, 0x14, 0xb7,","++     0xaa, 0xff, 0xef, 0x6a, 0x91, 0xf9, 0x7c, 0xd5, 0x72, 0x91, 0xbb,","++     0x5b, 0xa6, 0x86, 0xc5, 0x41, 0x5f, 0x5e, 0xb4, 0xf6, 0xb6},","++    // 98b896625c0c230adeec3eb2cf6aad5001ecf9156a68644e82374ce5833bc25b","++    {0x43, 0xbf, 0xfa, 0x19, 0xd6, 0xef, 0x65, 0x14, 0x51, 0xf6, 0x84,","++     0x1e, 0x01, 0x99, 0x31, 0xe9, 0x6f, 0x6f, 0x2e, 0xae, 0xff, 0x28,","++     0xab, 0x4b, 0x6f, 0x1c, 0xe4, 0x57, 0x6d, 0xe2, 0x71, 0x7b},","++    // e7568fe6e12331f4fd7de61da4c7559d0f8eb192a218d4741a3ba75184333838","++    {0xe0, 0x25, 0x4c, 0x7f, 0xcd, 0xc2, 0x65, 0xe2, 0xf0, 0xf8, 0xa4,","++     0x28, 0xda, 0xbb, 0x75, 0xab, 0x4a, 0xe0, 0x39, 0xb4, 0x87, 0x2d,","++     0x62, 0xf5, 0xee, 0x57, 0xf0, 0x87, 0x7d, 0x5a, 0x8a, 0x41},","++};","++","++std::vector<std::array<uint8_t, SHA256_DIGEST_LENGTH>>&","++BlockedSPKIsForTesting() {","++  static std::vector<std::array<uint8_t, SHA256_DIGEST_LENGTH>> list;","++  return list;","++}","++","++bool IsBlockedSPKI(const X509* cert) {","++  if (cert == nullptr) return false;","++  uint8_t* spki = nullptr;","++  int spki_len = i2d_X509_PUBKEY(X509_get_X509_PUBKEY(cert), &spki);","++  if (spki_len <= 0) return false;","++  uint8_t digest[SHA256_DIGEST_LENGTH];","++  SHA256(spki, spki_len, digest);","++  OPENSSL_free(spki);","++  for (const auto& blocked : kBlockedSPKIs) {","++    if (memcmp(digest, blocked, sizeof(digest)) == 0) return true;","++  }","++  for (const auto& blocked : BlockedSPKIsForTesting()) {","++    if (memcmp(digest, blocked.data(), sizeof(digest)) == 0) return true;","++  }","++  return false;","++}","++","++bool ContainsBlockedSPKI(const STACK_OF(X509)* certs) {","++  if (certs == nullptr) return false;","++  for (size_t i = 0; i < sk_X509_num(certs); i++) {","++    if (IsBlockedSPKI(sk_X509_value(certs, i))) return true;","++  }","++  return false;","++}","++","++// Wraps X509_verify_cert so that a chain through a blocked key is reported","++// as revoked even when the trust store would otherwise accept it. When no","++// verified chain is available every certificate the peer sent is checked.","++int CertVerifyCallback(X509_STORE_CTX* ctx, void* arg) {","++  int ok = X509_verify_cert(ctx);","++  bool blocked = ok == 1","++      ? ContainsBlockedSPKI(X509_STORE_CTX_get0_chain(ctx))","++      : IsBlockedSPKI(X509_STORE_CTX_get0_cert(ctx)) ||","++            ContainsBlockedSPKI(X509_STORE_CTX_get0_untrusted(ctx));","++  if (blocked) {","++    X509_STORE_CTX_set_error(ctx, X509_V_ERR_CERT_REVOKED);","++    return 0;","++  }","++  return ok;","++}","++","++}  // namespace","++","++void AddBlockedSPKIForTesting(const uint8_t* sha256_hash) {","++  std::array<uint8_t, SHA256_DIGEST_LENGTH> entry;","++  memcpy(entry.data(), sha256_hash, entry.size());","++  BlockedSPKIsForTesting().push_back(entry);","++}","++","++void ClearBlockedSPKIsForTesting() {","++  BlockedSPKIsForTesting().clear();","++}","++","+ static const char* const root_certs[] = {","+ #include \"node_root_certs.h\"  // NOLINT(build/include_order)","+ };","+@@ -1562,6 +1665,7 @@ void SecureContext::Init(const FunctionCallbackInfo<Value>& args) {","+ ","+   env->external_memory_accounter()->Increase(env->isolate(), kExternalSize);","+   SSL_CTX_set_app_data(sc->ctx_.get(), sc);","++  SSL_CTX_set_cert_verify_callback(sc->ctx_.get(), CertVerifyCallback, nullptr);","+ ","+   // OpenSSL populates cert_comp_prefs with all available algorithms by","+   // default when compression libraries are linked. Clear them so that","+diff --git a/src/crypto/crypto_context.h b/src/crypto/crypto_context.h","+index b1c6ba671314b1efc69751aa6b31d968708db2db..223fc70e0e686b1112cde79a5dad6a824bc91216 100644","+--- a/src/crypto/crypto_context.h","+@@ -29,6 +29,11 @@ X509_STORE* GetOrCreateRootCertStore();","+ ","+ ncrypto::BIOPointer LoadBIO(Environment* env, v8::Local<v8::Value> v);","+ ","++// Test-only hooks for the SPKI blocklist applied to every SecureContext. The","++// hash is the SHA-256 of a DER-encoded SubjectPublicKeyInfo.","++NODE_EXTERN void AddBlockedSPKIForTesting(const uint8_t* sha256_hash);","++NODE_EXTERN void ClearBlockedSPKIsForTesting();","++","+ class SecureContext final : public BaseObject {","+  public:","+   using GetSessionCb = SSL_SESSION* (*)(SSL*, const unsigned char*, int, int*);"],"additions":165,"deletions":0,"truncated":false},{"path":"shell/common/api/electron_api_testing.cc","lines":["@@ -4,7 +4,9 @@"," "," #include <memory>"," #include <optional>","+#include <string>"," #include <utility>","+#include <vector>"," "," #include \"base/command_line.h\""," #include \"base/dcheck_is_on.h\"","@@ -12,6 +14,7 @@"," #include \"base/logging.h\""," #include \"base/memory/ptr_util.h\""," #include \"base/no_destructor.h\"","+#include \"base/strings/string_number_conversions.h\""," #include \"build/build_config.h\""," #include \"content/browser/network_service_instance_impl.h\"  // nogncheck"," #include \"content/public/browser/browser_task_traits.h\"","@@ -21,6 +24,7 @@"," #include \"shell/common/callback_util.h\""," #include \"shell/common/gin_converters/callback_converter.h\""," #include \"shell/common/gin_helper/dictionary.h\"","+#include \"shell/common/gin_helper/error_thrower.h\""," #include \"shell/common/gin_helper/promise.h\""," #include \"shell/common/node_includes.h\""," #include \"v8/include/v8.h\"","@@ -34,6 +38,11 @@"," #endif"," "," #if DCHECK_IS_ON()","+namespace node::crypto {","+NODE_EXTERN void AddBlockedSPKIForTesting(const uint8_t* sha256_hash);","+NODE_EXTERN void ClearBlockedSPKIsForTesting();","+}  // namespace node::crypto","+"," namespace {"," "," class CallbackTestingHelper final {","@@ -280,6 +289,20 @@ v8::Local<v8::Promise> SettlePromiseOutsideTask(","   return handle;"," }"," ","+void AddNodeBlockedSPKIForTesting(gin_helper::ErrorThrower thrower,","+                                  const std::string& hex) {","+  std::vector<uint8_t> hash;","+  if (!base::HexStringToBytes(hex, &hash) || hash.size() != 32) {","+    thrower.ThrowTypeError(\"expected a 64 character hex SHA-256\");","+    return;","+  }","+  node::crypto::AddBlockedSPKIForTesting(hash.data());","+}","+","+void ClearNodeBlockedSPKIsForTesting() {","+  node::crypto::ClearBlockedSPKIsForTesting();","+}","+"," void Initialize(v8::Local<v8::Object> exports,","                 v8::Local<v8::Value> unused,","                 v8::Local<v8::Context> context,","@@ -289,6 +312,8 @@ void Initialize(v8::Local<v8::Object> exports,","   dict.SetMethod(\"log\", &Log);","   dict.SetMethod(\"getLoggingDestination\", &GetLoggingDestination);","   dict.SetMethod(\"simulateNetworkServiceCrash\", &SimulateNetworkServiceCrash);","+  dict.SetMethod(\"addNodeBlockedSPKI\", &AddNodeBlockedSPKIForTesting);","+  dict.SetMethod(\"clearNodeBlockedSPKIs\", &ClearNodeBlockedSPKIsForTesting);","   dict.SetMethod(\"holdRepeatingCallbackForTesting\",","                  &HoldRepeatingCallbackForTesting);","   dict.SetMethod(\"copyHeldRepeatingCallbackForTesting\","],"additions":25,"deletions":0,"truncated":false},{"path":"spec/cert-revocation.spec.ts","lines":["@@ -0,0 +1,95 @@","+import { afterAll, afterEach, beforeAll, describe, expect, it } from 'vitest';","+","+import * as crypto from 'node:crypto';","+import { once } from 'node:events';","+import * as fs from 'node:fs';","+import * as https from 'node:https';","+import * as path from 'node:path';","+import * as tls from 'node:tls';","+","+import { ifdescribe, isTestingBindingAvailable, listen } from './lib/spec-helpers.ts';","+","+const certPath = path.resolve(import.meta.dirname, 'fixtures', 'certificates');","+const rootCA = fs.readFileSync(path.join(certPath, 'rootCA.pem'), 'utf8');","+const intermediateCA = fs.readFileSync(path.join(certPath, 'intermediateCA.pem'), 'utf8');","+const serverCert = fs.readFileSync(path.join(certPath, 'server.pem'), 'utf8');","+const serverKey = fs.readFileSync(path.join(certPath, 'server.key'), 'utf8');","+","+const spkiHash = (pem: string) =>","+  crypto","+    .createHash('sha256')","+    .update(new crypto.X509Certificate(pem).publicKey.export({ type: 'spki', format: 'der' }))","+    .digest();","+","+ifdescribe(isTestingBindingAvailable())('certificate revocation', () => {","+  const testing = process._linkedBinding('electron_common_testing');","+  let server: https.Server;","+  let port: number;","+","+  beforeAll(async () => {","+    server = https.createServer({ key: serverKey, cert: serverCert + intermediateCA }, (req, res) => {","+      res.setHeader('Connection', 'close');","+      res.end('ok');","+    });","+    port = (await listen(server)).port;","+  });","+  afterAll(() => new Promise<void>((resolve) => server.close(() => resolve())));","+","+  describe('Node.js TLS', () => {","+    afterEach(() => testing.clearNodeBlockedSPKIs());","+","+    const connect = async (options: Partial<tls.ConnectionOptions> = {}) => {","+      const socket = tls.connect({","+        host: '127.0.0.1',","+        port,","+        servername: 'localhost',","+        ca: [rootCA],","+        rejectUnauthorized: false,","+        ...options","+      });","+      try {","+        await once(socket, 'secureConnect');","+        return socket.authorizationError ? String(socket.authorizationError) : null;","+      } finally {","+        socket.destroy();","+      }","+    };","+","+    it('reports a chain through a blocked intermediate key as revoked', async () => {","+      await expect(connect(), 'before').resolves.not.toBe('CERT_REVOKED');","+      testing.addNodeBlockedSPKI(spkiHash(intermediateCA).toString('hex'));","+      await expect(connect(), 'after').resolves.toBe('CERT_REVOKED');","+    });","+","+    it('reports a blocked leaf key as revoked', async () => {","+      testing.addNodeBlockedSPKI(spkiHash(serverCert).toString('hex'));","+      await expect(connect()).resolves.toBe('CERT_REVOKED');","+    });","+","+    it('fails the handshake when rejectUnauthorized is set', async () => {","+      testing.addNodeBlockedSPKI(spkiHash(intermediateCA).toString('hex'));","+      const socket = tls.connect({","+        host: '127.0.0.1',","+        port,","+        servername: 'localhost',","+        ca: [rootCA],","+        rejectUnauthorized: true","+      });","+      const [err] = await once(socket, 'error');","+      socket.destroy();","+      expect((err as NodeJS.ErrnoException).code).toBe('CERT_REVOKED');","+    });","+","+    it('applies to https.request', async () => {","+      testing.addNodeBlockedSPKI(spkiHash(intermediateCA).toString('hex'));","+      const req = https.get({ host: '127.0.0.1', port, servername: 'localhost', ca: [rootCA] });","+      const [err] = await once(req, 'error');","+      expect((err as NodeJS.ErrnoException).code).toBe('CERT_REVOKED');","+    });","+","+    it('does not affect chains without a blocked key', async () => {","+      testing.addNodeBlockedSPKI(crypto.randomBytes(32).toString('hex'));","+      await expect(connect()).resolves.not.toBe('CERT_REVOKED');","+    });","+  });","+});",""],"additions":95,"deletions":0,"truncated":false}],"additions":341,"deletions":0,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-24T12:58:19.572293+00:00"}