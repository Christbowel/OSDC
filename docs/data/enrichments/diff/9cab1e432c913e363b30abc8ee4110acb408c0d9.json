"+) : Algorithm(checkNotNull(signatureAlgorithm.jwaName), signatureAlgorithm.jcaAlgorithm) {","+","+    override fun verify(jwt: DecodedJWT) {","+        val signature = signatureAlgorithm.toJcaSignature()","+        val verified = try {","+            val signatureBytes = JwsBase64.decode(jwt.signature)","+            signature.initVerify(publicKey)","+            signature.update(\"${jwt.header}.${jwt.payload}\".toByteArray(Charsets.US_ASCII))","+            signature.verify(signatureBytes)","+        } catch (cause: IllegalArgumentException) {","+            throw SignatureVerificationException(this, cause)","+        } catch (cause: InvalidKeyException) {","+            throw SignatureVerificationException(this, cause)","+        } catch (cause: SignatureException) {","+            throw SignatureVerificationException(this, cause)","+        }","+        if (!verified) {","+            throw SignatureVerificationException(this)","+        }","+    }","+","+    override fun sign(headerBytes: ByteArray, payloadBytes: ByteArray): ByteArray =","+        sign { signature ->","+            signature.update(headerBytes)","+            signature.update('.'.code.toByte())","+            signature.update(payloadBytes)","+        }","+","+    override fun sign(contentBytes: ByteArray): ByteArray =","+        sign { signature -> signature.update(contentBytes) }","+","+    private inline fun sign(update: (Signature) -> Unit): ByteArray {","+        val signature = signatureAlgorithm.toJcaSignature()","+        return try {","+            signature.initSign(","+                checkNotNull(privateKey) {","+                    \"Private key is required to sign ${signatureAlgorithm.name}\"","+                }","+            )","+            update(signature)","+            signature.sign()","+        } catch (cause: InvalidKeyException) {","+            throw SignatureGenerationException(this, cause)","+        } catch (cause: SignatureException) {","+            throw Signatu