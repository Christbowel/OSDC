{"id":"a501fdc385fa5aab573cdc2c607b47d82c4189a8","axis":"silent","repo":"grafana/grafana","sha":"a501fdc385fa5aab573cdc2c607b47d82c4189a8","parsed":{"files":[{"path":"apps/dashboard/pkg/apis/dashboard/cuevalidator/validator.go","lines":["@@ -1,68 +1,30 @@"," package cuevalidator"," "," import (","-\t\"sync\"","-"," \t\"cuelang.org/go/cue\""," \t\"cuelang.org/go/cue/cuecontext\""," \tcuejson \"cuelang.org/go/encoding/json\""," )"," ","-const (","-\t// maxValidations limits how many validations can use the same context before it's recreated.","-\t// This prevents unbounded memory growth while still allowing schema reuse for performance.","-\t// After this many validations, the context is discarded and a new one is created.","-\tmaxValidations = 100","-)","-","-// Validator provides thread-safe CUE schema validation with periodic context recreation.","+// Validator validates JSON using a separate CUE context for each call."," //","-// CUE is not safe for concurrent use: https://github.com/cue-lang/cue/discussions/1205#discussioncomment-1189238","-// This validator uses a mutex to protect concurrent access to the underlying CUE validation.","-//","-// To prevent memory leaks from CUE's internal caching, we reuse a context for up to maxValidations","-// validations, then recreate it. This balances performance (schema reuse) with memory safety","-// (periodic garbage collection of cached values).","-//","-// See https://github.com/grafana/grafana/issues/114344#issuecomment-3605562491 for details","-// about the memory leak issue and this fix.","+// CUE contexts retain compiled instances, so sharing a context across validations","+// would keep validated payloads alive."," type Validator struct {","-\tschemaSource    string","-\tschemaPath      cue.Path","-\tmu              sync.Mutex","-\tctx             *cue.Context","-\tcompiledSchema  cue.Value","-\tvalidationCount int","+\tschemaSource string","+\tschemaPath   cue.Path"," }"," "," // NewValidatorFromSource creates a new validator from a schema source string and path.","-// This prevents memory leaks by periodically recreating the CUE context after maxValidations uses."," func NewValidatorFromSource(schemaSource string, schemaPath cue.Path) *Validator {","-\tcueCtx := cuecontext.New()","-\tcompiledSchema := cueCtx.CompileString(schemaSource).LookupPath(schemaPath)"," \treturn &Validator{","-\t\tschemaSource:   schemaSource,","-\t\tschemaPath:     schemaPath,","-\t\tctx:            cueCtx,","-\t\tcompiledSchema: compiledSchema,","+\t\tschemaSource: schemaSource,","+\t\tschemaPath:   schemaPath,"," \t}"," }"," "," func (v *Validator) Validate(data []byte) error {","-\tv.mu.Lock()","-\tdefer v.mu.Unlock()","-","-\t// Increment validation count","-\tv.validationCount++","-","-\t// If we've reached the maximum number of validations, recreate the context","-\tif v.validationCount >= maxValidations {","-\t\t// Recreate context to allow GC to reclaim cached values","-\t\tv.ctx = cuecontext.New()","-\t\tv.compiledSchema = v.ctx.CompileString(v.schemaSource).LookupPath(v.schemaPath)","-\t\tv.validationCount = 0","-\t}","-","-\t// Validate using the current compiled schema","-\treturn cuejson.Validate(data, v.compiledSchema)","+\tcueCtx := cuecontext.New()","+\tcompiledSchema := cueCtx.CompileString(v.schemaSource).LookupPath(v.schemaPath)","+\treturn cuejson.Validate(data, compiledSchema)"," }"],"additions":10,"deletions":48,"truncated":false},{"path":"apps/dashboard/pkg/apis/dashboard/cuevalidator/validator_test.go","lines":["@@ -0,0 +1,118 @@","+package cuevalidator","+","+import (","+\t\"encoding/json\"","+\t\"fmt\"","+\t\"os\"","+\t\"runtime\"","+\t\"strings\"","+\t\"sync\"","+\t\"testing\"","+","+\t\"cuelang.org/go/cue\"","+\t\"cuelang.org/go/cue/cuecontext\"","+\t\"cuelang.org/go/cue/errors\"","+\tcuejson \"cuelang.org/go/encoding/json\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestValidate(t *testing.T) {","+\tconst schema = `","+Other: int","+#Spec: {","+\ttitle: string","+\tcount: int & >=0","+\tkind: \"panel\" | \"row\"","+\tnote?: string","+}`","+\ttests := []struct {","+\t\tname    string","+\t\tdata    string","+\t\twantErr bool","+\t}{","+\t\t{name: \"valid\", data: `{\"title\":\"dashboard\",\"count\":1,\"kind\":\"panel\"}`},","+\t\t{name: \"escaped string\", data: `{\"title\":\"dashboard\",\"count\":1,\"kind\":\"row\",\"note\":\"\\\\(literal)\\n\\\"quoted\\\"\"}`},","+\t\t{name: \"wrong type\", data: `{\"title\":123,\"count\":1,\"kind\":\"panel\"}`, wantErr: true},","+\t\t{name: \"constraint\", data: `{\"title\":\"dashboard\",\"count\":-1,\"kind\":\"panel\"}`, wantErr: true},","+\t\t{name: \"disjunction\", data: `{\"title\":\"dashboard\",\"count\":1,\"kind\":\"unknown\"}`, wantErr: true},","+\t\t{name: \"unknown field\", data: `{\"title\":\"dashboard\",\"count\":1,\"kind\":\"panel\",\"unknown\":true}`, wantErr: true},","+\t\t{name: \"malformed JSON\", data: `{\"title\":`, wantErr: true},","+\t\t{name: \"CUE is not JSON\", data: `{title: \"dashboard\", count: 1, kind: \"panel\"}`, wantErr: true},","+\t}","+\tvalidator := NewValidatorFromSource(schema, cue.ParsePath(\"#Spec\"))","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tdata := []byte(tt.data)","+\t\t\terr := validator.Validate(data)","+\t\t\tif !tt.wantErr {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.Error(t, err)","+\t\t\treference := cuecontext.New().CompileString(schema).LookupPath(cue.ParsePath(\"#Spec\"))","+\t\t\twant := errors.Errors(cuejson.Validate(data, reference))","+\t\t\tgot := errors.Errors(err)","+\t\t\trequire.Len(t, got, len(want))","+\t\t\tfor i, e := range got {","+\t\t\t\tassert.Equal(t, want[i].Path(), e.Path())","+\t\t\t\twantFormat, wantArgs := want[i].Msg()","+\t\t\t\tgotFormat, gotArgs := e.Msg()","+\t\t\t\tassert.Equal(t, fmt.Sprintf(wantFormat, wantArgs...), fmt.Sprintf(gotFormat, gotArgs...))","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestValidateDoesNotRetainPayloads(t *testing.T) {","+\tvalidator := NewValidatorFromSource(`values: [...number]`, cue.ParsePath(\"\"))","+\tdata := []byte(`{\"values\":[` + strings.Repeat(\"12345,\", 9999) + `12345]}`)","+\trequire.NoError(t, validator.Validate(data))","+\truntime.GC()","+\tvar before runtime.MemStats","+\truntime.ReadMemStats(&before)","+","+\t// Cover infrequent dashboard writes that stayed below the old 100-call reset threshold.","+\tfor range 20 {","+\t\trequire.NoError(t, validator.Validate(data))","+\t}","+\truntime.GC()","+\tvar after runtime.MemStats","+\truntime.ReadMemStats(&after)","+\truntime.KeepAlive(validator)","+","+\tconst maxRetainedBytes = 8 << 20","+\tretained := int64(after.HeapAlloc) - int64(before.HeapAlloc)","+\tt.Logf(\"retained heap after 20 validations: %d bytes\", retained)","+\tassert.Less(t, retained, int64(maxRetainedBytes), \"validated payloads must be collectible while the validator remains alive\")","+}","+","+func TestValidateConcurrent(t *testing.T) {","+\tvalidator := NewValidatorFromSource(`value: int & >=0`, cue.ParsePath(\"\"))","+\tvar wg sync.WaitGroup","+\tfor range 10 {","+\t\twg.Go(func() {","+\t\t\tfor range 25 {","+\t\t\t\tassert.NoError(t, validator.Validate([]byte(`{\"value\":1}`)))","+\t\t\t\tassert.Error(t, validator.Validate([]byte(`{\"value\":-1}`)))","+\t\t\t}","+\t\t})","+\t}","+\twg.Wait()","+}","+","+func BenchmarkValidateDashboardSpec(b *testing.B) {","+\tschema, err := os.ReadFile(\"../v2/dashboard_spec.cue\")","+\trequire.NoError(b, err)","+\tdata, err := os.ReadFile(\"../../../migration/conversion/testdata/input/migrated_dashboards_from_v0_to_v2/v2beta1.v38.timeseries_table_display_mode.json\")","+\trequire.NoError(b, err)","+\tvar dashboard struct {","+\t\tSpec json.RawMessage `json:\"spec\"`","+\t}","+\trequire.NoError(b, json.Unmarshal(data, &dashboard))","+\tvalidator := NewValidatorFromSource(string(schema), cue.ParsePath(\"DashboardSpec\"))","+\tb.ReportAllocs()",