":68,"deletions":0,"truncated":false},{"path":"tools/ui/tests/unit/conversation-import.test.ts","lines":["@@ -0,0 +1,112 @@","+import { beforeAll, describe, expect, it } from 'vitest';","+import { zipSync, strToU8 } from 'fflate';","+import { MessageRole, MessageType } from '$lib/enums';","+import { NEWLINE } from '$lib/constants';","+import type { ExportedConversation } from '$lib/types/database';","+","+let conversationsStore: typeof import('$lib/stores/conversations.svelte').conversationsStore;","+","+// node env unit project has no DOM, install a minimal localStorage backed by a","+// Map before the store module reads it. Transforming the store takes seconds,","+// so import it once for the whole file.","+beforeAll(async () => {","+\tconst store = new Map<string, string>();","+\tconst polyfill: Storage = {","+\t\tget length() {","+\t\t\treturn store.size;","+\t\t},","+\t\tclear: () => store.clear(),","+\t\tgetItem: (k) => (store.has(k) ? store.get(k)! : null),","+\t\tkey: (i) => Array.from(store.keys())[i] ?? null,","+\t\tremoveItem: (k) => {","+\t\t\tstore.delete(k);","+\t\t},","+\t\tsetItem: (k, v) => {","+\t\t\tstore.set(k, String(v));","+\t\t}","+\t};","+\t(globalThis as unknown as { localStorage: Storage }).localStorage = polyfill;","+","+\t({ conversationsStore } = await import('$lib/stores/conversations.svelte'));","+}, 30000);","+","+function makeSession(id: string): ExportedConversation {","+\treturn {","+\t\tconv: { id, currNode: `${id}-msg`, lastModified: 0, name: `Chat ${id}` },","+\t\tmessages: [","+\t\t\t{","+\t\t\t\tid: `${id}-msg`,","+\t\t\t\tconvId: id,","+\t\t\t\ttype: MessageType.TEXT,","+\t\t\t\ttimestamp: 0,","+\t\t\t\trole: MessageRole.USER,","+\t\t\t\tcontent: `hello from ${id}`,","+\t\t\t\tparent: null,","+\t\t\t\tchildren: []","+\t\t\t}","+\t\t]","+\t} as unknown as ExportedConversation;","+}","+","+/**","+ * `parseImportFile` detects the format from the file contents. iOS has no UTI","+ * for `.jsonl`, so the picker cannot filter on it and the filename carries no","+ * guarantee: a JSONL export must import under any name.","+ */","+describe('conversationsStore.parseImportFile', () => {","+\tit('imports a JSONL export whose name has no meaningful extension', async () => {","+\t\tconst jsonl = conversationsStore.serializeSessionToJsonl(makeSession('a'));","+","+\t\tconst sessions = await conversationsStore.parseImportFile(new File([jsonl], 'export'));","+","+\t\texpect(sessions).toHaveLength(1);","+\t\texpect(sessions[0].conv.id).toBe('a');","+\t\texpect(sessions[0].messages[0].content).toBe('hello from a');","+\t});","+","+\tit('imports several sessions from one JSONL file', async () => {","+\t\tconst jsonl = [makeSession('a'), makeSession('b')]","+\t\t\t.map((session) => conversationsStore.serializeSessionToJsonl(session))","+\t\t\t.join(NEWLINE);","+","+\t\tconst sessions = await conversationsStore.parseImportFile(new File([jsonl], 'export.txt'));","+","+\t\texpect(sessions.map((session) => session.conv.id)).toEqual(['a', 'b']);","+\t});","+","+\tit('imports a ZIP archive whose name has no meaningful extension', async () => {","+\t\tconst zipped = zipSync({","+\t\t\t'a.jsonl': strToU8(conversationsStore.serializeSessionToJsonl(makeSession('a'))),","+\t\t\t'b.jsonl': strToU8(conversationsStore.serializeSessionToJsonl(makeSession('b'))),","+\t\t\t'notes.txt': strToU8('ignored')","+\t\t});","+","+\t\tconst sessions = await conversationsStore.parseImportFile(new File([zipped], 'archive'));","+","+\t\texpect(sessions.map((session) => session.conv.id).sort()).toEqual(['a', 'b']);","+\t});","+","+\tit('imports the legacy JSON array format', async () => {","+\t\tconst json = JSON.stringify([makeSession('a')], null, 2);","+","+\t\tconst sessions = await conversationsStore.parseImportFile(new File([json], 'export.jsonl'));","+","+\t\texpect(sessions).toHaveLength(1);","+\t\texpect(sessions[0].conv.id).toBe('a');","+\t});","+","+\tit('imports the legacy JSON single object format', async () => {","+\t\tconst