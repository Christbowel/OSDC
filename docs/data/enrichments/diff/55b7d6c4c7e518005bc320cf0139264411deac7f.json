ion: message });","-\t\t\t\t\treject(new Error(`Import failed: ${message}`));","-\t\t\t\t}","-\t\t\t};","-","-\t\t\tinput.click();","-\t\t});","-\t}","-"," \t/**"," \t * Imports conversations from provided data (without file picker)"," \t * @param data - Array of conversation data with messages","-\t * @returns Import result with counts","+\t * @returns The conversations written to the database and the ones skipped"," \t */"," \tasync importConversationsData("," \t\tdata: ExportedConversations","-\t): Promise<{ imported: number; skipped: number }> {","+\t): Promise<{ imported: DatabaseConversation[]; skipped: DatabaseConversation[] }> {"," \t\tconst result = await DatabaseService.importConversations(data);"," \t\tawait this.loadConversations();"," \t\treturn result;"],"additions":52,"deletions":83,"truncated":false},{"path":"tools/ui/src/lib/utils/modality-file-validation.ts","lines":["@@ -161,9 +161,3 @@ export function generateModalityErrorMessage("," "," \treturn message;"," }","-","-/**","- * Generate file input accept string based on model modalities","- * @param capabilities - The modality capabilities to check against","- * @returns Accept string for HTML file input element","- */"],"additions":0,"deletions":6,"truncated":false},{"path":"tools/ui/tests/client/conversation-import-db.svelte.test.ts","lines":["@@ -0,0 +1,68 @@","+import { afterEach, describe, expect, it } from 'vitest';","+import { DatabaseService } from '$lib/services/database.service';","+import { MessageRole, MessageType } from '$lib/enums';","+import type { ExportedConversation } from '$lib/types/database';","+","+function makeSession(id: string): ExportedConversation {","+\treturn {","+\t\tconv: { id, currNode: `${id}-msg`, lastModified: 0, name: `Chat ${id}` },","+\t\tmessages: [","+\t\t\t{","+\t\t\t\tid: `${id}-msg`,","+\t\t\t\tconvId: id,","+\t\t\t\ttype: MessageType.TEXT,","+\t\t\t\ttimestamp: 0,","+\t\t\t\trole: MessageRole.USER,","+\t\t\t\tcontent: `hello from ${id}`,","+\t\t\t\tparen