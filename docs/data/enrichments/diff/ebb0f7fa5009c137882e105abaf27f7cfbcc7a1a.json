les).toEqual(new Map());","     expect(removedFiles).toEqual(new Set());","+    expect(fs.lstat).not.toHaveBeenCalled();","   });"," ","-  test('calls lstat only for files with existing mtime', async () => {","+  test(\"stats only the files that were stat'd before, without looking them up\", async () => {","     vol.fromJSON({","       '/project/fruits/apple.js': 'a',","       '/project/fruits/banana.js': 'b',","@@ -257,13 +267,17 @@ describe('node crawler', () => {","     const previousFiles: FileData = new Map([","       // apple has a real mtime → will be lstat'd, mtime differs → changed","       ['fruits/apple.js', [appleStat.mtime.getTime() - 1000, 0, 1, null, 0, null] as FileMetadata],","-      // banana has null mtime → stat is deferred","-      ['fruits/banana.js', [null, 0, 0, null, 0, null] as FileMetadata],","+      // banana has null mtime → not stat'd","+      ['fruits/banana.js', [null, null, 0, null, 0, null] as FileMetadata],","     ]);","+    const fileSystem = makeTreeFS(previousFiles);","+    // The comparison with the previous file map finds them.","+    const lookup = jest.spyOn(fileSystem, 'lookup');","+    const linkStats = jest.spyOn(fileSystem, 'linkStats');"," ","     const { changedFiles, removedFiles } = await crawl({","       previousState: {","-        fileSystem: makeTreeFS(previousFiles),","+        fileSystem,","         clocks: new Map(),","       },","     });","@@ -278,6 +292,10 @@ describe('node crawler', () => {","       ])","     );","     expect(removedFiles).toEqual(new Set());","+    expect(fs.lstat).toHaveBeenCalledTimes(1);","+    expect(fs.lstat).toHaveBeenCalledWith('/project/fruits/apple.js', expect.any(Function));","+    expect(lookup).not.toHaveBeenCalled();","+    expect(linkStats).not.toHaveBeenCalled();","   });"," ","   test('excludes unchanged files when lstat mtime matches cache', async () => {","@@ -312,6 +330,67 @@ describe('node crawler', () => {","     expect(removedFiles).toEqual(new Set());","   });"," ","+  test('does not compare a file with one reached through a previous symlink', async () => {","+    vol.fromJSON({","+      '/project/fruits/directory/strawberry.js': 'a',","+      '/project/fruits/tomato.js': 'b',","+    });","+","+    // Before, `directory` was a symlink to `other`, whose strawberry.js has the","+    // same modified time as the crawled one (as a hard link would).","+    const strawberryStat = vol.statSync('/project/fruits/directory/strawberry.js');","+    const previousFiles: FileData = new Map([","+      ['fruits/directory', [0, 0, 0, null, 'fruits/other', null] as FileMetadata],","+      [","+        'fruits/other/strawberry.js',","+        [strawberryStat.mtime.getTime(), 1, 1, 'abc', 0, null] as FileMetadata,","+      ],","+      ['fruits/tomato.js', [null, null, 0, null, 0, null] as FileMetadata],","+    ]);","+","+    const { changedFiles, removedFiles } = await crawl({","+      previousState: {","+        fileSystem: makeTreeFS(previousFiles),","+        clocks: new Map(),","+      },","+    });","+","+    expect(changedFiles).toEqual(","+      new Map([['fruits/directory/strawberry.js', [null, null, 0, null, 0, null] as FileMetadata]])","+    );","+    expect(removedFiles).toEqual(new Set(['fruits/directory', 'fruits/other/strawberry.js']));","+  });","+","+  test(\"a scoped recrawl stats files that weren't stat'd before\", async () => {","+    vol.fromJSON({","+      '/project/fruits/directory/strawberry.js': 'a',","+      '/project/fruits/tomato.js': 'b',","+    });","+","+    const previousFiles: FileData = new Map([","+      ['fruits/directory/strawberry.js', [null, null, 0, null, 0, null] as FileMetadata],","+      ['fruits/tomato.js', [null, null, 0, null, 0, null] as FileMetadata],","+    ]);","+","+    const { changedFiles } = await crawl({","+      previousState: {","+        fileSystem: makeTreeFS(previousFiles),","+        clocks: new Map(),","+      },","+      subpath: 'fruits',","+    });","+","+    // Their contents may have been read outside the file map, so they're","+    // reported as changed.","+    expect(changedFiles).toEqual(","+      new Map([","+        ['fruits/directory/strawberry.js', [expect.any(Number), 1, 0, null, 0, null]],","+        ['fruits/tomato.js', [expect.any(Number), 1, 0, null, 0, null]],","+      ])","+    );","+    expect(fs.lstat).toHaveBeenCalledTimes(2);","+  });","+","   test('stats symlinks on a cold start', async () => {","     vol.fromJSON({","       '/project/fruits/apple.js': 'a',"],"additions":89,"deletions":10,"truncated":false},{"path":"packages/@expo/metro-file-map/src/crawlers/node/fallback.ts","lines":["@@ -108,13 +108,13 @@ export default function createFallbackFilesystem(","             const target = normalizePathSeparatorsToPosix(","               rootPathUtils.resolveSymlinkToNormal(childNormalPath, symlinkTarget)","             );","-            result.set(name, [null, 0, 0, null, target, null]);","+            result.set(name, [null, null, 0, null, target, null]);","           } catch {}","         }","       } else if (entry.isFile()) {","         const ext = path.extname(name).slice(1);","         if (exts[ext] && !result.has(name)) {","-          result.set(name, [null, 0, 0, null, 0, null]);","+          result.set(name, [null, null, 0, null, 0, null]);","         }","       }","     }"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/@expo/metro-file-map/src/crawlers/node/index.ts","lines":["@@ -10,102 +10,88 @@"," import * as fs from 'fs';"," import * as path from 'path';"," ","+import H from '../../constants';"," import { RootPathUtils } from '../../lib/RootPathUtils';","-import type {","-  Console,","-  CrawlerOptions,","-  CrawlResult,","-  FileData,","-  FileSystem,","-  IgnoreMatcher,","-} from '../../types';","-","-type Callback = (result: FileData) => void;","-","-function find(","-  roots: readonly string[],","-  extensions: readonly string[],","-  ignore: IgnoreMatcher,","-  includeSymlinks: boolean,","