{"id":"c75993719a5f84f193124cbc2cce50adce481ccc","axis":"silent","repo":"Azure/azure-sdk-for-python","sha":"c75993719a5f84f193124cbc2cce50adce481ccc","parsed":{"files":[{"path":"sdk/communication/azure-communication-callautomation/CHANGELOG.md","lines":["@@ -1,6 +1,6 @@"," # Release History"," ","-## 1.6.0 (Unreleased)","+## 1.7.0b1 (Unreleased)"," "," ### Features Added"," ","@@ -8,6 +8,27 @@"," - Added support for retrieving Teams phone call details, including the ability to specify a custom calling context for enhanced integration scenarios."," - Added `operation_callback_url` keyword argument to `start_continuous_dtmf_recognition`, allowing the default callback URL set by `create_call`/`answer_call` to be overridden for this operation."," ","+### Bugs Fixed","+","+- Fixed synchronous and asynchronous client construction with custom policy lists that omit a retry policy, while preserving recording URL validation before authentication.","+","+## 1.6.1 (2026-10-29)","+","+### Bugs Fixed","+","+- Security: Hardened recording URL validation against ambiguous authorities that could send authenticated requests to unintended endpoints. Synchronous and asynchronous recording downloads and deletes now validate each redirect destination before authentication.","+","+### Other Changes","+","+- Deprecated version 1.6.0 as of 2026-10-22 due to the recording URL validation security issue. Upgrade to 1.6.1 or a later fixed release to receive the security fix. This deprecation applies to version 1.6.0 only, not to the library as a whole.","+","+## 1.6.0 (2026-06-24)","+","+### Features Added","+","+- Added support for moving a participant from one call to another, enabling seamless participant transfer between active calls.","+- Added support for retrieving Teams phone call details, including the ability to specify a custom calling context for enhanced integration scenarios.","+"," ## 1.5.0 (2025-09-10)"," "," ### Features Added"],"additions":22,"deletions":1,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/README.md","lines":["@@ -8,6 +8,26 @@ This package contains a Python SDK for Azure Communication Call Automation. Call"," _Azure SDK Python packages support for Python 2.7 has ended 01 January 2022. For more information and questions, please"," refer to https://github.com/Azure/azure-sdk-for-python/issues/20691_"," ","+## Security notice: version 1.6.0 deprecated","+","+Version **1.6.0** of `azure-communication-callautomation` is deprecated as of","+**2026-10-22** because of a recording URL validation security issue. This notice","+applies to version 1.6.0, not to the library as a whole.","+","+In applications that pass attacker-influenced recording URLs to the synchronous","+`download_recording` or `delete_recording` methods using the default Requests","+transport, an ambiguous URL can bypass hostname validation and send an","+authenticated request to an unintended endpoint, potentially exposing a Bearer","+token.","+","+Upgrade to **1.6.1** or a later fixed release to receive the security fix.","+Use only service-generated recording URLs received through trusted,","+integrity-protected events; do not pass untrusted recording URLs to these methods.","+","+Refer to the [release history](https://github.com/Azure/azure-sdk-for-python/blob/main/sdk/communication/azure-communication-callautomation/CHANGELOG.md) and","+[Azure SDK support policy](https://azure.github.io/azure-sdk/policies_support.html)","+for more information.","+"," ## Getting started"," ### Prerequisites"," - Python 3.8 or later is required to use this package.","@@ -29,6 +49,17 @@ pip install azure-communication-callautomation"," | Callback Events      | Callback events are events sent back during duration of the call. It gives information and state of the call, such as `CallConnected`. `CallbackUrl` must be provided during `createCall` and `answerCall`, and callback events will be sent to this url. |"," | Incoming Call Event  | When incoming call happens (that can be answered with `answerCall`), incoming call eventgrid event will be sent. This is different from Callback events above, and should be setup on Azure portal. See [Incoming Call][incomingcall] for detail.                                                                                        |"," ","+### Recording URL security","+","+`download_recording` and `delete_recording` accept only HTTPS URLs with ASCII DNS","+hostnames under `*.asm.skype.com`, `*.asyncgw.teams.microsoft.com`, or","+`*.ams.gov.teams.microsoft.us`. URLs containing user information, raw backslashes,","+whitespace, control characters, or malformed authorities are rejected with","+`ValueError` before authentication. Redirect destinations are subject to the same","+validation. Valid signed query parameters are preserved.","+","+Use service-generated recording URLs from trusted, integrity-protected events.","+"," ## Examples"," ### Initialize CallAutomationClient"," ```Python","@@ -120,4 +151,4 @@ additional questions or comments."," [build3]: https://learn.microsoft.com/azure/communication-services/quickstarts/voice-video-calling/play-action?pivots=programming-language-csharp"," [build4]: https://learn.microsoft.com/azure/communication-services/quickstarts/voice-video-calling/recognize-action?pivots=programming-language-csharp"," [recording1]: https://learn.microsoft.com/azure/communication-services/concepts/voice-video-calling/call-recording","-[recording2]: https://learn.microsoft.com/azure/communication-services/quickstarts/voice-video-calling/get-started-call-recording?pivots=programming-language-csharp","+[recording2]: https://learn.microsoft.com/azure/communication-services/quickstarts/voice-video-calling/get-started-call-recording?pivots=programming-language-csharp","\\ No newline at end of file"],"additions":32,"deletions":1,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/_call_automation_client.py","lines":["@@ -15,6 +15,7 @@"," from ._call_connection_client import CallConnectionClient"," from ._generated._client import AzureCommunicationCallAutomationService"," from ._shared.auth_policy_utils import get_authentication_policy","+from ._recording_url_validator import configure_recording_url_validation"," from ._shared.utils import parse_connection_str"," from ._shared.models import CommunicationIdentifier"," from ._generated.models import (","@@ -107,6 +108,8 @@ def __init__(","         if not parsed_url.netloc:","             raise ValueError(f\"Invalid URL: {format(endpoint)}\")"," ","+        configure_recording_url_validation(kwargs)","+","         self._client = AzureCommunicationCallAutomationService(","             endpoint,","             credential,  # type: ignore[arg-type]"],"additions":3,"deletions":0,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/_content_downloader.py","lines":["@@ -22,7 +22,7 @@"," from ._generated import models as _models"," from ._generated._utils.serialization import Serializer"," from ._generated.operations import CallRecordingOperations","-from ._shared.recording_url_validator import validate_recording_url","+from ._recording_url_validator import validate_recording_url"," "," _SERIALIZER = Serializer()"," _SERIALIZER.client_side_validation = False","@@ -66,7 +66,8 @@ def download_streaming(","             raise ValueError(\"Recording client endpoint must not be None.\")"," ","         # Validate recording URL before sending authenticated request","-        validate_recording_url(source_location, \"source_location\")","+        source_location = validate_recording_url(source_location, \"source_location\")","+        kwargs[\"_recording_url_parameter_name\"] = \"source_location\""," ","         _headers = kwargs.pop(\"headers\", {}) or {}","         _params = kwargs.pop(\"params\", {}) or {}","@@ -116,7 +117,8 @@ def delete_recording(self, recording_location: str, **kwargs: Any) -> None:","             raise ValueError(\"Recording client endpoint must not be None.\")"," ","         # Validate recording URL before sending authenticated request","-        validate_recording_url(recording_location, \"recording_location\")","+        recording_location = validate_recording_url(recording_location, \"recording_location\")","+        kwargs[\"_recording_url_parameter_name\"] = \"recording_location\""," ","         _headers = kwargs.pop(\"headers\", {}) or {}","         _params = kwargs.pop(\"params\", {}) or {}"],"additions":5,"deletions":3,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/_recording_url_validator.py","lines":["@@ -0,0 +1,135 @@","+# -------------------------------------------------------------------------","+# Copyright (c) Microsoft Corporation. All rights reserved.","+# Licensed under the MIT License. See License.txt in the project root for","+# license information.","+# --------------------------------------------------------------------------","+","+import re","+from collections.abc import Iterable","+from typing import Any, Dict, Tuple","+from urllib.parse import urlparse","+","+from azure.core.pipeline import PipelineRequest, PipelineResponse","+from azure.core.pipeline.policies import (","+    AsyncRedirectPolicy,","+    AsyncRetryPolicy,","+    RedirectPolicy,","+    RetryPolicy,","+    SansIOHTTPPolicy,","+)","+","+# Allowed recording endpoint host suffixes.","+# These are the only domains permitted for recording URLs to prevent credential exfiltration.","+ALLOWED_HOST_SUFFIXES: Tuple[str, ...] = (","+    \".asm.skype.com\",","+    \".asyncgw.teams.microsoft.com\",","+    \".ams.gov.teams.microsoft.us\",","+)","+","+","+def _validate_url_characters(url: str, parameter_name: str) -> None:","+    if any(char == \"\\\\\" or char.isspace() or ord(char) < 32 or 127 <= ord(char) <= 159 for char in url):","+        raise ValueError(f\"{parameter_name} must not contain backslashes, whitespace, or control characters.\")","+","+","+def validate_recording_url(recording_url: str, parameter_name: str) -> str:","+    \"\"\"","+    Validate that a recording URL points to Azure Communication Services","+    endpoint before credentials are attached.","+    This prevents credential exfiltration via SSRF attacks.","+","+    :param recording_url: The recording URL to validate.","+    :type recording_url: str","+    :param parameter_name: The parameter name for exception messages.","+    :type parameter_name: str","+    :return: The validated URL with a canonical ASCII authority.","+    :rtype: str","+    :raises TypeError: If the recording URL is None or empty.","+    :raises ValueError: If the recording URL is not a valid absolute HTTPS URI or not from an allowed domain.","+    \"\"\"","+    if not recording_url:","+        raise TypeError(f\"{parameter_name} cannot be null or undefined.\")","+    if not isinstance(recording_url, str):","+        raise TypeError(f\"{parameter_name} must be a string.\")","+","+    # Reject syntax that URL parsers may discard or interpret as a different authority.","+    _validate_url_characters(recording_url, parameter_name)","+    parsed_url = urlparse(recording_url)","+","+    # Validate it's a valid absolute URI","+    if not parsed_url.scheme or not parsed_url.netloc:","+        raise ValueError(f\"{parameter_name} must be a valid absolute URI.\")","+","+    # Ensure the URL uses HTTPS","+    if parsed_url.scheme.lower() != \"https\":","+        raise ValueError(f\"{parameter_name} must use HTTPS scheme for security.\")","+","+    if \"@\" in parsed_url.netloc or not parsed_url.netloc.isascii():","+        raise ValueError(f\"{parameter_name} must have an ASCII hostname and must not contain user information.\")","+","+    host = parsed_url.hostname","+    if not host:","+        raise ValueError(f\"{parameter_name} must have a valid hostname.\")","+","+    host_lower = host.lower()","+    if len(host_lower) > 253 or not all(","+        re.fullmatch(r\"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\", label) for label in host_lower.split(\".\")","+    ):","+        raise ValueError(f\"{parameter_name} must have a valid DNS hostname.\")","+","+    port = parsed_url.port","+    if \":\" in parsed_url.netloc and not parsed_url.netloc.rsplit(\":\", 1)[1].isdigit():","+        raise ValueError(f\"{parameter_name} must have a valid port.\")","+","+    # Check against allowed suffixes","+    is_valid_endpoint = any(host_lower.endswith(suffix) for suffix in ALLOWED_HOST_SUFFIXES)","+","+    if not is_valid_endpoint:","+        raise ValueError(","+            f\"{parameter_name} host '{host}' is not a valid Azure Communication Services recording endpoint. \"","+            \"Only URLs pointing to *.asm.skype.com, *.asyncgw.teams.microsoft.com are allowed.\"","+        )","+","+    authority = host_lower if port is None else f\"{host_lower}:{port}\"","+    return parsed_url._replace(scheme=\"https\", netloc=authority).geturl()","+","+","+def configure_recording_url_validation(kwargs: Dict[str, Any]) -> None:","+    \"\"\"Install validation before authentication and inside redirect/retry loops.","+","+    :param kwargs: Client options to update with the validation policy.","+    :type kwargs: dict[str, typing.Any]","+    \"\"\"","+    policies = kwargs.get(\"policies\")","+    if policies is not None:","+        policies = list(policies)","+        validation_index = 0","+        for index, policy in enumerate(policies):","+            if isinstance(policy, (RedirectPolicy, AsyncRedirectPolicy, RetryPolicy, AsyncRetryPolicy)):","+                validation_index = index + 1","+        policies.insert(validation_index, RecordingURLValidationPolicy())","+        kwargs[\"policies\"] = policies","+    else:","+        per_retry_policies = kwargs.pop(\"per_retry_policies\", None) or []","+        if not isinstance(per_retry_policies, Iterable):","+            per_retry_policies = [per_retry_policies]","+        kwargs[\"per_retry_policies\"] = [*per_retry_policies, RecordingURLValidationPolicy()]","+","+","+class RecordingURLValidationPolicy(SansIOHTTPPolicy):","+    \"\"\"Validate recording destinations on every attempt, before authentication.\"\"\"","+","+    def on_request(self, request: PipelineRequest) -> None:","+        parameter_name = request.context.options.pop(\"_recording_url_parameter_name\", None)","+        if parameter_name is not None:","+            request.context[\"_recording_url_parameter_name\"] = parameter_name","+        parameter_name = request.context.get(\"_recording_url_parameter_name\")","+        if parameter_name:","+            request.http_request.url = validate_recording_url(request.http_request.url, parameter_name)","+","+    def on_response(self, request: PipelineRequest, response: PipelineResponse) -> None:","+        parameter_name = request.context.get(\"_recording_url_parameter_name\")","+        location = response.http_response.headers.get(\"location\")","+        if parameter_name and location and response.http_response.status_code in (300, 301, 302, 303, 307, 308):","+            # RedirectPolicy parses Location before the next on_request, potentially discarding controls.","+            _validate_url_characters(location, parameter_name)"],"additions":135,"deletions":0,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/_shared/recording_url_validator.py","lines":["@@ -1,59 +0,0 @@","-# -------------------------------------------------------------------------","-# Copyright (c) Microsoft Corporation. All rights reserved.","-# Licensed under the MIT License. See License.txt in the project root for","-# license information.","-# --------------------------------------------------------------------------","-","-from typing import Tuple","-from urllib.parse import urlparse","-","-","-# Allowed recording endpoint host suffixes.","-# These are the only domains permitted for recording URLs to prevent credential exfiltration.","-ALLOWED_HOST_SUFFIXES: Tuple[str, ...] = (","-    \".asm.skype.com\",","-    \".asyncgw.teams.microsoft.com\",","-    \".ams.gov.teams.microsoft.us\",","-)","-","-","-def validate_recording_url(recording_url: str, parameter_name: str) -> None:","-    \"\"\"","-    Validate that a recording URL points to Azure Communication Services","-    endpoint before credentials are attached.","-    This prevents credential exfiltration via SSRF attacks.","-","-    :param recording_url: The recording URL to validate.","-    :type recording_url: str","-    :param parameter_name: The parameter name for exception messages.","-    :type parameter_name: str","-    :raises TypeError: If the recording URL is None or empty.","-    :raises ValueError: If the recording URL is not a valid absolute HTTPS URI or not from an allowed domain.","-    \"\"\"","-    if not recording_url:","-        raise TypeError(f\"{parameter_name} cannot be null or undefined.\")","-","-    parsed_url = urlparse(recording_url)","-","-    # Validate it's a valid absolute URI","-    if not parsed_url.scheme or not parsed_url.netloc:","-        raise ValueError(f\"{parameter_name} must be a valid absolute URI.\")","-","-    # Ensure the URL uses HTTPS","-    if parsed_url.scheme.lower() != \"https\":","-        raise ValueError(f\"{parameter_name} must use HTTPS scheme for security.\")","-","-    host = parsed_url.hostname","-    if not host:","-        raise ValueError(f\"{parameter_name} must have a valid hostname.\")","-","-    host_lower = host.lower()","-","-    # Check against allowed suffixes","-    is_valid_endpoint = any(host_lower.endswith(suffix) for suffix in ALLOWED_HOST_SUFFIXES)","-","-    if not is_valid_endpoint:","-        raise ValueError(","-            f\"{parameter_name} host '{host}' is not a valid Azure Communication Services recording endpoint. \"","-            \"Only URLs pointing to *.asm.skype.com, *.asyncgw.teams.microsoft.com are allowed.\"","-        )"],"additions":0,"deletions":59,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/_version.py","lines":["@@ -4,6 +4,6 @@"," # license information."," # --------------------------------------------------------------------------"," ","-VERSION = \"1.6.0\"","+VERSION = \"1.7.0b1\""," "," SDK_MONIKER = f\"communication-callautomation/{format(VERSION)}\""],"additions":1,"deletions":1,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/aio/_call_automation_client_async.py","lines":["@@ -15,6 +15,7 @@"," from ._call_connection_client_async import CallConnectionClient"," from .._generated.aio import AzureCommunicationCallAutomationService"," from .._shared.auth_policy_utils import get_authentication_policy","+from .._recording_url_validator import configure_recording_url_validation"," from .._shared.utils import parse_connection_str"," from .._shared.models import CommunicationIdentifier"," from .._generated.models import (","@@ -108,6 +109,8 @@ def __init__(","         if not parsed_url.netloc:","             raise ValueError(f\"Invalid URL: {format(endpoint)}\")"," ","+        configure_recording_url_validation(kwargs)","+","         self._client = AzureCommunicationCallAutomationService(","             endpoint,","             credential,  # type: ignore[arg-type]"],"additions":3,"deletions":0,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/azure/communication/callautomation/aio/_content_downloader_async.py","lines":["@@ -22,7 +22,7 @@"," from .._generated import models as _models"," from .._generated._utils.serialization import Serializer"," from .._generated.aio.operations import CallRecordingOperations","-from .._shared.recording_url_validator import validate_recording_url","+from .._recording_url_validator import validate_recording_url"," "," _SERIALIZER = Serializer()"," _SERIALIZER.client_side_validation = False","@@ -67,7 +67,8 @@ async def download_streaming(","             raise ValueError(\"Recording client endpoint must not be None.\")"," ","         # Validate recording URL before sending authenticated request","-        validate_recording_url(source_location, \"source_location\")","+        source_location = validate_recording_url(source_location, \"source_location\")","+        kwargs[\"_recording_url_parameter_name\"] = \"source_location\""," ","         _headers = kwargs.pop(\"headers\", {}) or {}","         _params = kwargs.pop(\"params\", {}) or {}","@@ -118,7 +119,8 @@ async def delete_recording(self, recording_location: str, **kwargs: Any) -> None","             raise ValueError(\"Recording client endpoint must not be None.\")"," ","         # Validate recording URL before sending authenticated request","-        validate_recording_url(recording_location, \"recording_location\")","+        recording_location = validate_recording_url(recording_location, \"recording_location\")","+        kwargs[\"_recording_url_parameter_name\"] = \"recording_location\""," ","         _headers = kwargs.pop(\"headers\", {}) or {}","         _params = kwargs.pop(\"params\", {}) or {}"],"additions":5,"deletions":3,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/setup.py","lines":["@@ -39,7 +39,7 @@","     url=\"https://github.com/Azure/azure-sdk-for-python\",","     keywords=\"azure, azure sdk\",","     classifiers=[","-        \"Development Status :: 5 - Production/Stable\",","+        \"Development Status :: 4 - Beta\",","         \"Programming Language :: Python\",","         \"Programming Language :: Python :: 3 :: Only\",","         \"Programming Language :: Python :: 3\","],"additions":1,"deletions":1,"truncated":false},{"path":"sdk/communication/azure-communication-callautomation/tests/test_recording_url_security.py","lines":["@@ -0,0 +1,413 @@","+# -------------------------------------------------------------------------","+# Copyright (c) Microsoft Corporation. All rights reserved.","+# Licensed under the MIT License. See License.txt in the project root for","+# license information.","+# --------------------------------------------------------------------------","+import time","+from io import BytesIO","+from unittest.mock import AsyncMock, MagicMock, Mock","+from urllib.parse import urlparse","+","+import pytest","+import requests","+from unittest_helpers import mock_response","+","+from azure.core.credentials import AccessToken","+from azure.core.pipeline.policies import (","+    AsyncBearerTokenCredentialPolicy,","+    AsyncRedirectPolicy,","+    AsyncRetryPolicy,","+    BearerTokenCredentialPolicy,","+    RedirectPolicy,","+    RetryPolicy,","+    SansIOHTTPPolicy,","+)","+# Transports are exported dynamically through the module's __getattr__.","+from azure.core.pipeline.transport import AioHttpTransport, RequestsTransport  # pylint: disable=no-name-in-module","+from azure.communication.callautomation import CallAutomationClient","+from azure.communication.callautomation.aio import CallAutomationClient as AsyncCallAutomationClient","+from azure.communication.callautomation._recording_url_validator import validate_recording_url","+","+ENDPOINT = \"https://example.communication.azure.com\"","+VALID_URL = \"https://x.asm.skype.com/recording?sig=a%2Fb%3D&part=1\"","+BYPASS_URL = \"https://127.0.0.1:8443\\\\@x.asm.skype.com/recording\"","+OPERATIONS = (\"download_recording\", \"delete_recording\")","+INVALID_URLS = [","+    BYPASS_URL,","+    \"https://127.0.0.1:8443\\\\\\\\@x.asm.skype.com/recording\",","+    \"https://user:password@x.asm.skype.com/recording\",","+    \"https://127.0.0.1:8443/recording\",","+    \"https://x.asm.skype.com.attacker.example/recording\",","+    \"https://asm.skype.com/recording\",","+    \"http://x.asm.skype.com/recording\",","+    \"//x.asm.skype.com/recording\",","+    \"https://x.asm.skype.com:/recording\",","+    \"https://x.asm.skype.com:invalid/recording\",","+    \"https://x.asm.skype.com:65536/recording\",","+    \"https://%78.asm.skype.com/recording\",","+    \"https://bad_host.asm.skype.com/recording\",","+    \"https://x..asm.skype.com/recording\",","+    \"https://[x.asm.skype.com]/recording\",","+    \"https://\\u212a.asm.skype.com/recording\",","+] + [f\"https://x.asm.skype.com/record{chr(code)}ing\" for code in (*range(33), 127, 133)]","+","+","+@pytest.fixture(autouse=True)","+def start_proxy():","+    # These tests must not start the service test proxy or make network requests.","+    return","+","+","+def credential(async_client=False):","+    get_token = AsyncMock if async_client else Mock","+    return Mock(","+        spec=[\"get_token\"],","+        get_token=get_token(return_value=AccessToken(\"ACS-CALLAUTOMATION-CANARY-TOKEN\", int(time.time()) + 3600)),","+    )","+","+","+CUSTOM_POLICY_LISTS = [","+    (),","+    (\"authentication\",),","+    (\"redirect\", \"authentication\"),","+    (\"retry\", \"authentication\"),","+    (\"redirect\", \"retry\", \"authentication\"),","+]","+","+","+def custom_policies(names, token, async_client=False):","+    factories = {","+        \"authentication\": lambda: (AsyncBearerTokenCredentialPolicy if async_client else BearerTokenCredentialPolicy)(","+            token, \"https://communication.azure.com/.default\"","+        ),","+        \"redirect\": AsyncRedirectPolicy if async_client else RedirectPolicy,","+        \"retry\": AsyncRetryPolicy if async_client else RetryPolicy,","+    }","+    return [factories[name]() for name in names]","+","+","+@pytest.mark.parametrize(\"names\", CUSTOM_POLICY_LISTS)","+@pytest.mark.parametrize(\"operation\", OPERATIONS)","+def test_custom_policy_list_supports_recording_operations(names, operation):","+    token = credential()","+    policies = custom_policies(names, token)","+    original_policies = list(policies)","+    transport = MagicMock(send=Mock(return_value=mock_response()))","+    with CallAutomationClient(ENDPOINT, token, policies=policies, transport=transport) as client:","+        getattr(client, operation)(VALID_URL)","+    assert policies == original_policies","+    assert transport.send.call_count == 1","+    assert transport.send.call_args.args[0].url == VALID_URL","+    assert token.get_token.call_count == int(\"authentication\" in names)","+","+","+@pytest.mark.asyncio","+@pytest.mark.parametrize(\"names\", CUSTOM_POLICY_LISTS)","+@pytest.mark.parametrize(\"operation\", OPERATIONS)","+async def test_async_custom_policy_list_supports_recording_operations(names, operation):","+    token = credential(async_client=True)","+    policies = custom_policies(names, token, async_client=True)","+    original_policies = list(policies)","+    transport = MagicMock(send=AsyncMock(return_value=mock_response()))","+    async with AsyncCallAutomationClient(ENDPOINT, token, policies=policies, transport=transport) as client:","+        await getattr(client, operation)(VALID_URL)","+    assert policies == original_policies","+    assert transport.send.call_count == 1","+    assert transport.send.call_args.args[0].url == VALID_URL","+    assert token.get_token.call_count == int(\"authentication\" in names)","+","+","+class RewriteURLPolicy(SansIOHTTPPolicy):","+    def on_request(self, request):","+        request.http_request.url = BYPASS_URL","+","+","+@pytest.mark.parametrize(\"names\", CUSTOM_POLICY_LISTS)","+@pytest.mark.parametrize(\"operation\", OPERATIONS)","+def test_custom_policy_list_validates_before_authentication(names, operation):","+    token = credential()","+    transport = MagicMock(send=Mock())","+    with CallAutomationClient(","+        ENDPOINT,","+        token,","+        policies=custom_policies(names, token),","+        per_call_policies=RewriteURLPolicy(),","+        transport=transport,","+    ) as client:","+        with pytest.raises(ValueError):","+            getattr(client, operation)(