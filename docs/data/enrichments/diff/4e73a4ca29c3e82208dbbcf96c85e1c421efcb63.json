{"id":"4e73a4ca29c3e82208dbbcf96c85e1c421efcb63","axis":"silent","repo":"grafana/tempo","sha":"4e73a4ca29c3e82208dbbcf96c85e1c421efcb63","parsed":{"files":[{"path":".chloggen/tenant-index-v2.yaml","lines":["@@ -0,0 +1,14 @@","+change_type: enhancement","+","+component: storage","+","+note: Add a V2 tenant index format that is smaller and cheaper to decode. It is always written, and read when `blocklist_poll_tenant_index_v2` is enabled. Blocks can also carry general purpose `options`.","+","+issues: []","+","+subtext: |","+  The V2 index is written to `index.v2.zst` in addition to the existing indexes.","+  Enable reading it only after every component runs a version that supports it.","+  Blocks with different `options` are not compacted together.","+","+user: mdisibio"],"additions":14,"deletions":0,"truncated":false},{"path":"Makefile","lines":["@@ -406,6 +406,7 @@ gen-proto:  ## Generate proto files"," "," \t@# Generate backend proto (uses go_package for output path)"," \t$(BUF) generate --config buf/buf.gen-config.yaml --template buf/buf.gen.backend.yaml --path tempodb/backend/v1/v1.proto","+\t$(BUF) generate --config buf/buf.gen-config.yaml --template buf/buf.gen.backend.yaml --path tempodb/backend/v2/v2.proto"," "," \t@# Generate frontend proto"," \t$(BUF) generate --config buf/buf.gen-config.yaml --template buf/buf.gen.frontend.yaml --path modules/frontend/v1/frontendv1pb/frontend.proto"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/_index.md","lines":["@@ -1941,6 +1941,13 @@ storage:","         # Default 0 (disabled).","         [blocklist_poll_stale_tenant_index: <duration>]"," ","+        # Read the tenant index in the V2 format,","+        # which is smaller and cheaper to decode.","+        # Tempo always writes it, so enable this only after","+        # every component runs a version that supports it.","+        # Default false.","+        [blocklist_poll_tenant_index_v2: <bool>]","+","         # Delays each unknown block metadata read by a random amount, up to the provided value in milliseconds.","         # Does not delay tenant-index reads or enforce a cluster-wide request rate limit.","         # Default 0 (disabled)"],"additions":7,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/manifest.md","lines":["@@ -679,6 +679,7 @@ storage:","         blocklist_poll_fallback: true","         blocklist_poll_tenant_index_builders: 2","         blocklist_poll_stale_tenant_index: 0s","+        blocklist_poll_tenant_index_v2: false","         blocklist_poll_jitter_ms: 0","         blocklist_poll_tolerate_consecutive_errors: 1","         blocklist_poll_tolerate_tenant_failures: 1"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/operations/monitor/polling.md","lines":["@@ -31,6 +31,12 @@ so an overlong cycle delays subsequent updates."," "," The index is written in two formats: both a `gzip` compressed JSON located at `/<tenant>/index.json.gz` and a zstd compressed proto encoded object located at `/<tenant>/index.pb.zst`. Only the proto object is read, falling back to the JSON if the proto does not exist, which should only happen as part of the transition to the new format. These indexes contain an entry for every block and compacted block for the tenant."," ","+The index is also written to `/<tenant>/index.v2.zst`.","+When `blocklist_poll_tenant_index_v2` is enabled,","+that object is read first, falling back to the proto object if it doesn't exist.","+The V2 format stores the fields blocks have in common once, instead of in every block entry,","+so the object is smaller and uses less CPU and memory to decode.","+"," The blocklist is eventually consistent."," When polls fit within their intervals and indexes are updated successfully,"," discovery takes approximately two polling intervals:"],"additions":6,"deletions":0,"truncated":false},{"path":"integration/util/config-base.yaml","lines":["@@ -45,6 +45,7 @@ storage:","       max_workers: 10","       queue_depth: 100","     blocklist_poll: 2s # timings: check for updated blocklists every 2s","+    blocklist_poll_tenant_index_v2: true"," "," memberlist:","   abort_if_cluster_join_fails: false"],"additions":1,"deletions":0,"truncated":false},{"path":"modules/frontend/docs/config-reference.md","lines":["@@ -675,6 +675,7 @@ storage:","         blocklist_poll_fallback: true","         blocklist_poll_tenant_index_builders: 2","         blocklist_poll_stale_tenant_index: 0s","+        blocklist_poll_tenant_index_v2: false","         blocklist_poll_jitter_ms: 0","         blocklist_poll_tolerate_consecutive_errors: 1","         blocklist_poll_tolerate_tenant_failures: 1"],"additions":1,"deletions":0,"truncated":false},{"path":"tempodb/backend/block_meta_test.go","lines":["@@ -679,3 +679,39 @@ func TestDedicatedColumns_Validate(t *testing.T) {"," \t\t})"," \t}"," }","+","+func TestBlockMetaOptions(t *testing.T) {","+\twithOpts := NewBlockMeta(\"t\", uuid.New(), \"vParquet5\")","+\twithOpts.Options = map[string]string{\"b\": \"2\", \"a\": \"1\"}","+\tnoOpts := NewBlockMeta(\"t\", uuid.New(), \"vParquet5\")","+","+\tt.Run(\"json round trip\", func(t *testing.T) {","+\t\tb, err := json.Marshal(withOpts)","+\t\trequire.NoError(t, err)","+\t\trequire.Contains(t, string(b), `\"options\":{\"a\":\"1\",\"b\":\"2\"}`) // sorted keys, deterministic","+","+\t\tgot := &BlockMeta{}","+\t\trequire.NoError(t, json.Unmarshal(b, got))","+\t\trequire.Equal(t, withOpts.Options, got.Options)","+\t})","+","+\tt.Run(\"proto round trip\", func(t *testing.T) {","+\t\tb, err := withOpts.Marshal()","+\t\trequire.NoError(t, err)","+\t\tgot := &BlockMeta{}","+\t\trequire.NoError(t, got.Unmarshal(b))","+\t\trequire.Equal(t, withOpts.Options, got.Options)","+\t})","+","+\tt.Run(\"omitted when empty\", func(t *testing.T) {","+\t\tb, err := json.Marshal(noOpts)","+\t\trequire.NoError(t, err)","+\t\trequire.NotContains(t, string(b), \"options\")","+","+\t\tpb, err := noOpts.Marshal()","+\t\trequire.NoError(t, err)","+\t\tgot := &BlockMeta{}","+\t\trequire.NoError(t, got.Unmarshal(pb))","+\t\trequire.Nil(t, got.Options)","+\t})","+}"],"additions":36,"deletions":0,"truncated":false},{"path":"tempodb/backend/block_options.go","lines":["@@ -0,0 +1,36 @@","+package backend","+","+import (","+\t\"slices\"","+\t\"strings\"","+)","+","+var optionEscaper = strings.NewReplacer(`\\`, `\\\\`, `,`, `\\,`, `=`, `\\=`)","+","+// OptionsString renders the block options as \"[key=value, key2=value2]\", sorted by key so that","+// it is independent of map iteration order. It is empty when there are no options. Blocks with","+// different options must not be compacted together, so two option sets are equal exactly","+// when their strings are equal: the characters that delimit the format are escaped with a backslash.","+func (b *BlockMeta) OptionsString() string {","+\tif len(b.Options) == 0 {","+\t\treturn \"\"","+\t}","+\tkeys := make([]string, 0, len(b.Options))","+\tfor k := range b.Options {","+\t\tkeys = append(keys, k)","+\t}","+\tslices.Sort(keys)","+","+\tvar sb strings.Builder","+\tsb.WriteByte('[')","+\tfor i, k := range keys {","+\t\tif i > 0 {","+\t\t\tsb.WriteString(\", \")","+\t\t}","+\t\t_, _ = optionEscaper.WriteString(&sb, k)","+\t\tsb.WriteByte('=')","+\t\t_, _ = optionEscaper.WriteString(&sb, b.Options[k])","+\t}","+\tsb.WriteByte(']')","+\treturn sb.String()","+}"],"additions":36,"deletions":0,"truncated":false},{"path":"tempodb/backend/block_options_test.go","lines":["@@ -0,0 +1,33 @@","+package backend","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestOptionsString(t *testing.T) {","+\tstr := func(o map[string]string) string { return (&BlockMeta{Options: o}).OptionsString() }","+","+\trequire.Empty(t, str(nil))","+\trequire.Empty(t, str(map[string]string{}))","+\trequire.Equal(t, \"[a=1]\", str(map[string]string{\"a\": \"1\"}))","+","+\tfor range 20 { // sorted by key, so map iteration order must not matter","+\t\trequire.Equal(t, \"[a=1, b=2, c=3]\", str(map[string]string{\"c\": \"3\", \"b\": \"2\", \"a\": \"1\"}))","+\t}","+","+\ta := str(map[string]string{\"a\": \"1\", \"b\": \"2\"})","+\trequire.NotEqual(t, a, str(map[string]string{\"a\": \"1\", \"b\": \"3\"}))","+\trequire.NotEqual(t, a, str(map[string]string{\"a\": \"1\"}))","+\t// key/value boundaries are significant","+\trequire.NotEqual(t, str(map[string]string{\"ab\": \"c\"}), str(map[string]string{\"a\": \"bc\"}))","+","+\tt.Run(\"delimiters in keys and values cannot make different options equal\", func(t *testing.T) {","+\t\trequire.Equal(t, `[a=1\\, b\\=2]`, str(map[string]string{\"a\": \"1, b=2\"}))","+\t\trequire.NotEqual(t, str(map[string]string{\"a\": \"1, b=2\"}), str(map[string]string{\"a\": \"1\", \"b\": \"2\"}))","+\t\trequire.NotEqual(t, str(map[string]string{\"a=b\": \"c\"}), str(map[string]string{\"a\": \"b=c\"}))","+\t\trequire.NotEqual(t, str(map[string]string{`a\\`: \"b\"}), str(map[string]string{\"a\": `\\b`}))","+\t\trequire.NotEqual(t, str(map[string]string{\"a\": `1\\`, \"b\": \"2\"}), str(map[string]string{\"a\": `1\\, b=2`}))","+\t})","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"tempodb/backend/raw.go","lines":["@@ -145,11 +145,29 @@ func (w *writer) WriteTenantIndex(ctx context.Context, tenantID string, meta []*"," \t\t\treturn err"," \t\t}"," ","+\t\terr = w.w.Delete(ctx, TenantIndexNameV2, []string{tenantID}, nil)","+\t\tif err != nil && !errors.Is(err, ErrDoesNotExist) {","+\t\t\treturn err","+\t\t}","+"," \t\treturn nil"," \t}"," "," \tb := newTenantIndex(meta, compactedMeta, noCompact)"," ","+\t// Marshal and write the V2 object first so that, when readers prefer it, it is","+\t// never older than the proto object they would otherwise fall back to. It is always","+\t// written, so that enabling reads of it never serves a stale or missing file.","+\tindexBytesV2, err := b.marshalV2Zstd()","+\tif err != nil {","+\t\treturn err","+\t}","+","+\terr = w.w.Write(ctx, TenantIndexNameV2, KeyPath([]string{tenantID}), bytes.NewReader(indexBytesV2), int64(len(indexBytesV2)), nil)","+\tif err != nil {","+\t\treturn err","+\t}","+"," \t// Marshal and write the proto object."," \tindexBytesPb, err := b.marshalPb()"," \tif err != nil {","@@ -186,13 +204,15 @@ func (w *writer) DeleteNoCompactFlag(ctx context.Context, blockID uuid.UUID, ten"," }"," "," type reader struct {","-\tr RawReader","+\tr    RawReader","+\topts options"," }"," "," // NewReader returns an object that implements Reader and bridges to a RawReader","-func NewReader(r RawReader) Reader {","+func NewReader(r RawReader, opts ...Option) Reader {"," \treturn &reader{","-\t\tr: r,","+\t\tr:    r,","+\t\topts: newOptions(opts),"," \t}"," }"," ","@@ -288,6 +308,17 @@ func (r *reader) TenantIndex(ctx context.Context, tenantID string) (*TenantIndex"," \tctx, span := tracer.Start(ctx, \"reader.TenantIndex\")"," \tdefer span.End()"," ","+\tif r.opts.tenantIndexV2 {","+\t\tout, err := r.tenantIndexV2(ctx, tenantID)","+\t\tif err == nil {","+\t\t\treturn out, nil","+\t\t}","+\t\tif !errors.Is(err, ErrDoesNotExist) {","+\t\t\treturn nil, err","+\t\t}","+\t\tspan.AddEvent(EventProtoFallback)","+\t}","+"," \toutPb, err := r.tenantIndexProto(ctx, tenantID)"," \tif err == nil {"," \t\treturn outPb, nil"],"additions":34,"deletions":3,"truncated":false},{"path":"tempodb/backend/raw_test.go","lines":["@@ -85,7 +85,7 @@ func TestWriter(t *testing.T) {"," \terr = w.WriteTenantIndex(ctx, \"test\", nil, nil, nil)"," \tassert.NoError(t, err)"," ","-\texpectedDeleteMap := map[string]map[string]int{TenantIndexName: {\"test\": 1}, TenantIndexNamePb: {\"test\": 1}}","+\texpectedDeleteMap := map[string]map[string]int{TenantIndexName: {\"test\": 1}, TenantIndexNamePb: {\"test\": 1}, TenantIndexNameV2: {\"test\": 1}}"," \tassert.Equal(t, expectedDeleteMap, w.(*writer).w.(*MockRawWriter).deleteCalls)"," "," \t// When a backend returns ErrDoesNotExist, the tenant index should be deleted, but no error should be returned if the tenant index does not exist"],"additions":1,"deletions":1,"truncated":false},{"path":"tempodb/backend/raw_v2_test.go","lines":["@@ -0,0 +1,139 @@","+package backend","+","+import (","+\t\"bytes\"","+\t\"context\"","+\t\"fmt\"","+\t\"io\"","+\t\"path/filepath\"","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/google/uuid\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func v2TestIndex(t *testing.T) (*TenantIndex, *BlockMeta) {","+\tt.Helper()","+\tmeta := richBlockMeta(0, DedicatedColumns{{Scope: DedicatedColumnScopeSpan, Name: \"a\", Type: DedicatedColumnTypeString}})","+\tmeta.TenantID = tenantID","+\treturn &TenantIndex{CreatedAt: time.Unix(1700000000, 0), Meta: []*BlockMeta{meta}}, meta","+}","+","+func TestWriterTenantIndexV2(t *testing.T) {","+\tctx := context.Background()","+\t_, meta := v2TestIndex(t)","+\tv2Path := filepath.Join(tenantID, TenantIndexNameV2)","+","+\tt.Run(\"always writes it alongside proto and json\", func(t *testing.T) {","+\t\tm := &MockRawWriter{}","+\t\tw := NewWriter(m)","+\t\trequire.NoError(t, w.WriteTenantIndex(ctx, tenantID, []*BlockMeta{meta}, nil, nil))","+","+\t\trequire.Contains(t, m.writeBuffer, filepath.Join(tenantID, TenantIndexName))","+\t\trequire.Contains(t, m.writeBuffer, filepath.Join(tenantID, TenantIndexNamePb))","+","+\t\tgot := &TenantIndex{}","+\t\trequire.NoError(t, got.unmarshalV2Zstd(m.writeBuffer[v2Path]))","+\t\trequire.Len(t, got.Meta, 1)","+\t\trequireBlockMetaEqual(t, meta, got.Meta[0])","+\t})","+","+\tt.Run(\"empty tenant deletes it\", func(t *testing.T) {","+\t\tm := &MockRawWriter{}","+\t\trequire.NoError(t, NewWriter(m).WriteTenantIndex(ctx, tenantID, nil, nil, nil))","+\t\trequire.Equal(t, map[string]int{tenantID: 1}, m.deleteCalls[TenantIndexNameV2])","+\t})","+","+\tt.Run(\"missing on delete is not an error\", func(t *testing.T) {","+\t\tm := &MockRawWriter{err: ErrDoesNotExist}","+\t\trequire.NoError(t, NewWriter(m).WriteTenantIndex(ctx, tenantID, nil, nil, nil))","+\t})","+}","+","+func TestReaderTenantIndexV2(t *testing.T) {","+\tctx := context.Background()","+\tidx, _ := v2TestIndex(t)","+","+\tv2Bytes, err := idx.marshalV2Zstd()","+\trequire.NoError(t, err)","+\tpb, err := idx.marshalPb()","+\trequire.NoError(t, err)","+","+\t// a distinguishable proto index so tests can tell which one was read","+\tpbIdx := &TenantIndex{CreatedAt: time.Unix(1700000001, 0)}","+\tpbOnly, err := pbIdx.marshalPb()","+\trequire.NoError(t, err)","+","+\ttype fakeReader struct {","+\t\tmu    sync.Mutex","+\t\treads []string","+\t\tfiles map[string][]byte","+\t}","+\tnewReader := func(files map[string][]byte, opts ...Option) (Reader, *fakeReader) {","+\t\tf := &fakeReader{files: files}","+\t\tr := &MockRawReader{ReadFn: func(_ context.Context, name string, _ KeyPath, _ *CacheInfo) (io.ReadCloser, int64, error) {","+\t\t\tf.mu.Lock()","+\t\t\tdefer f.mu.Unlock()","+\t\t\tf.reads = append(f.reads, name)","+\t\t\tb, ok := f.files[name]","+\t\t\tif !ok {","+\t\t\t\treturn nil, 0, fmt.Errorf(\"nope: %w\", ErrDoesNotExist)","+\t\t\t}","+\t\t\treturn io.NopCloser(bytes.NewReader(b)), int64(len(b)), nil","+\t\t}}","+\t\treturn NewReader(r, opts...), f","+\t}","+","+\tt.Run(\"enabled prefers V2\", func(t *testing.T) {","+\t\tr, f := newReader(map[string][]byte{TenantIndexNameV2: v2Bytes, TenantIndexNamePb: pbOnly}, WithTenantIndexV2(true))","+\t\tgot, err := r.TenantIndex(ctx, tenantID)","+\t\trequire.NoError(t, err)","+\t\trequire.True(t, idx.CreatedAt.Equal(got.CreatedAt))","+\t\trequire.Len(t, got.Meta, 1)","+\t\trequire.Equal(t, []string{TenantIndexNameV2}, f.reads)","+\t})","+","+\tt.Run(\"enabled falls back to proto when missing\", func(t *testing.T) {","+\t\tr, f := newReader(map[string][]byte{TenantIndexNamePb: pb}, WithTenantIndexV2(true))","+\t\tgot, err := r.TenantIndex(ctx, tenantID)","+\t\trequire.NoError(t, err)","+\t\trequire.Len(t, got.Meta, 1)","+\t\trequire.Equal(t, []string{TenantIndexNameV2, TenantIndexNamePb}, f.reads)","+\t})","+","+\tt.Run(\"enabled does not fall back on a corrupt V2 index\", func(t *testing.T) {","+\t\tr, _ := newReader(map[string][]byte{TenantIndexNameV2: {0x00}, TenantIndexNamePb: pb}, WithTenantIndexV2(true))","+\t\tgot, err := r.TenantIndex(ctx, tenantID)","+\t\trequire.Error(t, err)","+\t\trequire.Nil(t, got)","+\t})","+","+\tt.Run(\"disabled never reads V2\", func(t *testing.T) {","+\t\tr, f := newReader(map[string][]byte{TenantIndexNameV2: v2Bytes, TenantIndexNamePb: pbOnly})","+\t\tgot, err := r.TenantIndex(ctx, tenantID)","+\t\trequire.NoError(t, err)","+\t\trequire.Empty(t, got.Meta)","+\t\trequire.Equal(t, []string{TenantIndexNamePb}, f.reads)","+\t})","+","+\tt.Run(\"round trip through writer and reader\", func(t *testing.T) {","+\t\tmw := &MockRawWriter{}","+\t\tw := NewWriter(mw)","+\t\tmeta := NewBlockMeta(tenantID, uuid.New(), \"vParquet5\")","+\t\trequire.NoError(t, w.WriteTenantIndex(ctx, tenantID, []*BlockMeta{meta}, nil, []UUID{meta.BlockID}))","+","+\t\tfiles := map[string][]byte{}","+\t\tfor path, b := range mw.writeBuffer {","+\t\t\tfiles[filepath.Base(path)] = b","+\t\t}","+\t\tr, f := newReader(files, WithTenantIndexV2(true))","+\t\tgot, err := r.TenantIndex(ctx, tenantID)","+\t\trequire.NoError(t, err)","+\t\trequire.Len(t, got.Meta, 1)","+\t\trequire.Equal(t, meta.BlockID, got.Meta[0].BlockID)","+\t\trequire.Equal(t, []UUID{meta.BlockID}, got.NoCompact)","+\t\trequire.Equal(t, []string{TenantIndexNameV2}, f.reads)","+\t})","+}"],"additions":139,"deletions":0,"truncated":false},{"path":"tempodb/backend/tenantindex_v2.go","lines":["@@ -0,0 +1,253 @@","+package backend","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"time\"","+","+\ttempo_io \"github.com/grafana/tempo/v3/pkg/io\"","+)","+","+const (","+\t// TenantIndexNameV2 is the V2 tenant index: shared block meta fields are stored once","+\t// per schema instead of per block.","+\tTenantIndexNameV2 = \"index.v2.zst\"","+","+\t// EventProtoFallback is the span event added when the V2 index is missing.","+\tEventProtoFallback = \"falling back to v1 index\"","+)","+","+// Option configures how a Reader or Writer behaves.","+type Option func(*options)","+","+type options struct {","+\ttenantIndexV2 bool","+}","+","+// WithTenantIndexV2 makes a reader prefer the V2 tenant index, falling back to the proto","+// index when it does not exist. Writers always write the V2 index, so this can be enabled","+// at any time without a stale or missing file. It has no effect on a writer.","+func WithTenantIndexV2(enabled bool) Option {","+\treturn func(o *options) { o.tenantIndexV2 = enabled }","+}","+","+func newOptions(opts []Option) options {","+\tvar o options","+\tfor _, opt := range opts {","+\t\topt(&o)","+\t}","+\treturn o","+}","+","+func (r *reader) tenantIndexV2(ctx context.Context, tenantID string) (*TenantIndex, error) {","+\trdr, size, err := r.r.Read(ctx, TenantIndexNameV2, KeyPath([]string{tenantID}), nil)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to read tenant index v2: %w\", err)","+\t}","+\tdefer rdr.Close()","+","+\tbuf, err := tempo_io.ReadAllWithEstimate(rdr, size)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to read all with estimate: %w\", err)","+\t}","+","+\tout := &TenantIndex{}","+\terr = out.unmarshalV2Zstd(buf)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to unmarshal tenant index v2: %w\", err)","+\t}","+","+\treturn out, nil","+}","+","+// The V2 tenant index (the TenantIndexV2 proto message) is a more compact encoding of the","+// same data as TenantIndex.","+//","+// Block metas in a tenant index repeat a lot of identical information: the version, tenant,","+// dedicated columns, replication factor, etc. are the same for most blocks. V2 hoists that","+// shared information into a small list of SchemaEntry messages and each BlockEntry references its","+// schema by position. The file is deduplicated by construction instead of relying on","+// zstd/gzip, and decoding allocates the shared fields once per schema rather than once per","+// block.","+//","+// New fields can be added to the proto messages like any other proto. Fields shared by many","+// blocks belong in SchemaEntry, the rest in BlockEntry.","+//","+// Options is a general purpose key/value set chosen when a block is created, so that new","+// features within an encoding don't require a new encoding. Blocks with different options","+// get different schemas, and blocks with the same options share one map.","+","+// schemaKey identifies a set of shared BlockMeta fields. Dedicated columns are compared by","+// hash and options by their string, which is also how compaction decides whether blocks are alike.","+type schemaKey struct {","+\tversion, tenantID string","+\treplicationFactor uint32","+\tindexPageSize     uint32","+\tdedicatedColumns  uint64","+\toptions           string","+}","+","+func schemaKeyOf(m *BlockMeta) schemaKey {","+\treturn schemaKey{","+\t\tversion:           m.Version,","+\t\ttenantID:          m.TenantID,","+\t\treplicationFactor: m.ReplicationFactor,","+\t\tindexPageSize:     m.IndexPageSize,","+\t\tdedicatedColumns:  m.DedicatedColumnsHash(),","+\t\toptions:           m.OptionsString(),","+\t}","+}","+","+func (b *TenantIndex) toV2() *TenantIndexV2 {","+\tout := &TenantIndexV2{","+\t\tCreatedAtUnixNanos: timeToNanos(b.CreatedAt),","+\t\tBlocks:             make([]BlockEntry, 0, len(b.Meta)),","+\t\tCompactedBlocks:    make([]CompactedBlockEntry, 0, len(b.CompactedMeta)),","+\t\tNoCompact:          b.NoCompact,","+\t}","+","+\tids := map[schemaKey]uint32{}","+\tentry := func(m *BlockMeta) BlockEntry {","+\t\tk := schemaKeyOf(m)","+\t\tid, ok := ids[k]","+\t\tif !ok {","+\t\t\tid = uint32(len(out.Schemas))","+\t\t\tids[k] = id","+\t\t\tout.Schemas = append(out.Schemas, SchemaEntry{","+\t\t\t\tVersion:           m.Version,","+\t\t\t\tTenantID:          m.TenantID,","+\t\t\t\tReplicationFactor: m.ReplicationFactor,","+\t\t\t\tIndexPageSize:     m.IndexPageSize,","+\t\t\t\tDedicatedColumns:  m.DedicatedColumns,","+\t\t\t\tOptions:           m.Options,","+\t\t\t})","+\t\t}","+\t\treturn BlockEntry{","+\t\t\tSchema:          id,","+\t\t\tBlockID:         m.BlockID,","+\t\t\tStartTime:       m.StartTime,","+\t\t\tEndTime:         m.EndTime,","+\t\t\tTotalObjects:    m.TotalObjects,","+\t\t\tSize_:           m.Size_,","+\t\t\tCompactionLevel: m.CompactionLevel,","+\t\t\tTotalRecords:    m.TotalRecords,","+\t\t\tBloomShardCount: m.BloomShardCount,","+\t\t\tFooterSize:      m.FooterSize,","+\t\t}","+\t}","+","+\tfor _, m := range b.Meta {","+\t\tout.Blocks = append(out.Blocks, entry(m))","+\t}","+\tfor _, m := range b.CompactedMeta {","+\t\tout.CompactedBlocks = append(out.CompactedBlocks, CompactedBlockEntry{","+\t\t\tBlockEntry:    entry(&m.BlockMeta),","+\t\t\tCompactedTime: m.CompactedTime,","+\t\t})","+\t}","+\treturn out","+}","+","+// fromV2 replaces b's contents. Blocks of the same schema share their strings, dedicated","+// columns and options, which must therefore not be mutated.","+//","+// TODO: This is backfilling from the better-structured v2 index into the old","+// shape of a slice of full metas, which eliminates some of the savings from the new","+// schematized format. In the future we could update the interface of TenantIndex to support","+// both like with iter.Seq[BlockMeta] and funcs like Overlapping(start,end) that does more","+// work on the fly, and would let us keep the original schemas+entries.","+func (b *TenantIndex) fromV2(in *TenantIndexV2) error {","+\tfill := func(m *BlockMeta, e *BlockEntry) error {","+\t\tif int(e.Schema) >= len(in.Schemas) {","+\t\t\treturn fmt.Errorf(\"tenant index v2: block references schema %d of %d\", e.Schema, len(in.Schemas))","+\t\t}","+\t\ts := &in.Schemas[e.Schema]","+\t\tm.Version = s.Version","+\t\tm.TenantID = s.TenantID","+\t\tm.ReplicationFactor = s.ReplicationFactor","+\t\tm.IndexPageSize = s.IndexPageSize","+\t\tm.DedicatedColumns = s.DedicatedColumns","+\t\tm.Options = s.Options","+","+\t\tm.BlockID = e.BlockID","+\t\tm.StartTime = e.StartTime","+\t\tm.EndTime = e.EndTime","+\t\tm.TotalObjects = e.TotalObjects","+\t\tm.Size_ = e.Size_","+\t\tm.CompactionLevel = e.CompactionLevel","+\t\tm.TotalRecords = e.TotalRecords","+\t\tm.BloomShardCount = e.BloomShardCount","+\t\tm.FooterSize = e.FooterSize","+\t\treturn nil","+\t}","+","+\t// one allocation for all blocks rather than one each","+\tmetas := make([]BlockMeta, len(in.Blocks))","+\tb.Meta = make([]*BlockMeta, len(metas))","+\tfor i := range metas {","+\t\tif err := fill(&metas[i], &in.Blocks[i]); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tb.Meta[i] = &metas[i]","+\t}","+","+\tcompacted := make([]CompactedBlockMeta, len(in.CompactedBlocks))","+\tb.CompactedMeta = make([]*CompactedBlockMeta, len(compacted))","+\tfor i := range compacted {","+\t\tif err := fill(&compacted[i].BlockMeta, &in.CompactedBlocks[i].BlockEntry); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tcompacted[i].CompactedTime = in.CompactedBlocks[i].CompactedTime","+\t\tb.CompactedMeta[i] = &compacted[i]","+\t}","+","+\tb.NoCompact = in.NoCompact","+\tb.CreatedAt = nanosToTime(in.CreatedAtUnixNanos)","+\treturn nil","+}","+","+// marshalV2 encodes the index in the V2 format without outer compression.","+func (b *TenantIndex) marshalV2() ([]byte, error) {","+\treturn b.toV2().Marshal()","+}","+","+// unmarshalV2 decodes data produced by marshalV2, replacing b's contents.","+func (b *TenantIndex) unmarshalV2(data []byte) error {","+\tin := &TenantIndexV2{}","+\tif err := in.Unmarshal(data); err != nil {","+\t\treturn err","+\t}","+\treturn b.fromV2(in)","+}","+","+// marshalV2Zstd encodes and compresses the index, matching how the proto index is stored.","+func (b *TenantIndex) marshalV2Zstd() ([]byte, error) {","+\traw, err := b.marshalV2()","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn Zstd.Encode(raw, nil)","+}","+","+func (b *TenantIndex) unmarshalV2Zstd(