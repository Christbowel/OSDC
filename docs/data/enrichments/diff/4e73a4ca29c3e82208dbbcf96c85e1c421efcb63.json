turn fillRealistic(makeTestTenantIndex(numBlocks))","+}","+","+func fillRealistic(idx *TenantIndex) *TenantIndex {","+\trng := rand.New(rand.NewPCG(1, 2))","+\tbase := time.Now().Add(-24 * time.Hour).Truncate(time.Second)","+","+\tfill := func(m *BlockMeta) {","+\t\tm.Version = \"vParquet5\"","+\t\tm.StartTime = base.Add(time.Duration(rng.IntN(86400)) * time.Second)","+\t\tm.EndTime = m.StartTime.Add(time.Duration(rng.IntN(600)) * time.Second)","+\t\tm.TotalObjects = rng.Int64N(5_000_000)","+\t\tm.Size_ = uint64(rng.Int64N(2 << 30))","+\t\tm.CompactionLevel = uint32(rng.IntN(4))","+\t\tm.TotalRecords = uint32(rng.IntN(5000))","+\t\tm.FooterSize = uint32(20000 + rng.IntN(20000))","+\t\tm.BloomShardCount = uint32(1 + rng.IntN(8))","+\t\tm.IndexPageSize = 250 * 1024","+\t\tif rng.IntN(5) == 0 {","+\t\t\tm.ReplicationFactor = MetricsGeneratorReplicationFactor","+\t\t}","+\t}","+\tfor _, m := range idx.Meta {","+\t\tfill(m)","+\t}","+\tfor _, m := range idx.CompactedMeta {","+\t\tfill(&m.BlockMeta)","+\t\tm.CompactedTime = m.EndTime.Add(time.Hour)","+\t}","+\treturn idx","+}","+","+func BenchmarkTenantIndexV2Marshal(b *testing.B) {","+\tfor _, f := range indexFormats {","+\t\tb.Run(\"format=\"+f.name, func(b *testing.B) {","+\t\t\tfor _, n := range benchBlockCounts {","+\t\t\t\tb.Run(fmt.Sprintf(\"blocks=%d\", n), func(b *testing.B) {","+\t\t\t\t\tidx := makeRealisticTenantIndex(n)","+\t\t\t\t\tb.ReportAllocs()","+\t\t\t\t\tfor b.Loop() {","+\t\t\t\t\t\tvar err error","+\t\t\t\t\t\tdoNotOptimizeBytes, err = f.marshal(idx)","+\t\t\t\t\t\trequire.NoError(b, err)","+\t\t\t\t\t}","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}","+","+// BenchmarkTenantIndexV2Unmarshal clears the dedicated columns cache each iteration so that","+// json and proto pay for parsing, as they do on the first read after a restart.","+func BenchmarkTenantIndexV2Unmarshal(b *testing.B) {","+\tfor _, f := range indexFormats {","+\t\tb.Run(\"format=\"+f.name, func(b *testing.B) {","+\t\t\tfor _, n := range benchBlockCounts {","+\t\t\t\tb.Run(fmt.Sprintf(\"blocks=%d\", n), func(b *testing.B) {","+\t\t\t\t\tbuf, err := f.marshal(makeRealisticTenantIndex(n))","+\t\t\t\t\trequire.NoError(b, err)","+\t\t\t\t\tb.ReportAllocs()","+\t\t\t\t\tfor b.Loop() {","+\t\t\t\t\t\tdedicatedColumnsCache.InvalidateAll()","+\t\t\t\t\t\tdoNotOptimizeTenantIndex = &TenantIndex{}","+\t\t\t\t\t\trequire.NoError(b, f.unmarshal(doNotOptimizeTenantIndex, buf))","+\t\t\t\t\t}","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}","+","+// BenchmarkTenantIndexV2UnmarshalWarm leaves the dedicated columns cache populated, which is","+// the steady state for the json and proto formats.","+func BenchmarkTenantIndexV2UnmarshalWarm(b *testing.B) {","+\tfor _, f := range indexFormats {","+\t\tb.Run(\"format=\"+f.name, func(b *testing.B) {","+\t\t\tfor _, n := range benchBlockCounts {","+\t\t\t\tb.Run(fmt.Sprintf(\"blocks=%d\", n), func(b *testing.B) {","+\t\t\t\t\tbuf, err := f.marshal(makeRealisticTenantIndex(n))","+\t\t\t\t\trequire.NoError(b, err)","+\t\t\t\t\trequire.NoError(b, f.unmarshal(&TenantIndex{}, buf)) // warm the cache","+\t\t\t\t\tb.ReportAllocs()","+\t\t\t\t\tfor b.Loop() {","+\t\t\t\t\t\tdoNotOptimizeTenantIndex = &TenantIndex{}","+\t\t\t\t\t\trequire.NoError(b, f.unmarshal(doNotOptimizeTenantIndex, buf))","+\t\t\t\t\t}","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}","+","+// BenchmarkTenantIndexV2Size reports the encoded size of each format. The time per op is","+// irrelevant: read the bytes and bytes/block metrics.","+func BenchmarkTenantIndexV2Size(b *testing.B) {","+\tfor _, f := range indexFormats {","+\t\tb.Run(\"format=\"+f.name, func(b *testing.B) {","+\t\t\tfor _, n := range benchBlockCounts {","+\t\t\t\tb.Run(fmt.Sprintf(\"blocks=%d\", n), func(b *testing.B) {","+\t\t\t\t\tidx := makeRealisticTenantIndex(n)","+\t\t\t\t\tvar size int","+\t\t\t\t\tfor b.Loop() {","+\t\t\t\t\t\tbuf, err := f.marshal(idx)","+\t\t\t\t\t\trequire.NoError(b, err)","+\t\t\t\t\t\tsize = len(buf)","+\t\t\t\t\t}","+\t\t\t\t\t// live and compacted blocks are both encoded","+\t\t\t\t\tb.ReportMetric(float64(size), \"bytes\")","+\t\t\t\t\tb.ReportMetric(float64(size)/float64(2*n), \"bytes/block\")","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}","+","+// BenchmarkTenantIndexV2Retained reports what stays resident after decoding: the live heap","+// once the decoded index is held and all transient garbage (the compressed and raw buffers,","+// intermediate messages) has been collected. This is what a long running poller carries per tenant.","+func BenchmarkTenantIndexV2Retained(b *testing.B) {","+\theap := func() (bytes, objects uint64) {","+\t\t// twice, so that sync.Pool contents (zstd decoders) are dropped from both readings","+\t\truntime.GC()","+\t\truntime.GC()","+\t\tvar ms runtime.MemStats","+\t\truntime.ReadMemStats(&ms)","+\t\treturn ms.HeapAlloc, ms.HeapObjects","+\t}","+","+\tfor _, f := range indexFormats {","+\t\t// Compression doesn't change what is retained, and the pooled zstd decoders make the","+\t\t// heap readings noisy.","+\t\tif strings.HasSuffix(f.name, \"zstd\") || strings.HasSuffix(f.name, \"gzip\") {","+\t\t\tcontinue","+\t\t}","+\t\tb.Run(\"format=\"+f.name, func(b *testing.B) {","+\t\t\tfor _, n := range benchBlockCounts {","+\t\t\t\tb.Run(fmt.Sprintf(\"blocks=%d\", n), func(b *testing.B) {"],"additions":171,"deletions":0,"truncated":false}],"additions":734,"deletions":4,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-14T15:13:49.231447+00:00"}