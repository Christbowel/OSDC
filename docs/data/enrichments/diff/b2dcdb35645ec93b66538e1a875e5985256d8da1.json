n.h\""," #include \"xla/autotune_cache.pb.h\""," #include \"xla/autotuning.pb.h\""," #include \"xla/backends/autotuner/autotuning.pb.h\"","+#include \"xla/backends/autotuner/backends.pb.h\""," #include \"xla/backends/autotuner/codegen_backend.h\""," #include \"xla/backends/autotuner/codegen_orchestrator.h\""," #include \"xla/backends/autotuner/profiler.h\"","@@ -63,7 +65,8 @@ absl::StatusOr<std::unique_ptr<ConfigRunner>> ConfigRunner::Create("," absl::StatusOr<std::vector<ConfigRunner::ConfigProfile>>"," ConfigRunner::ProfileAll(","     std::vector<ConfigRunner::ExecutableCandidate> candidates,","-    const HloInstruction* instr) {","+    const HloInstruction* instr,","+    absl::Span<const autotuner::Backend> excluded_backends) {","   std::vector<ConfigRunner::ConfigProfile> config_results(candidates.size());"," ","   absl::MutexLock lock(profiler_m_);","@@ -97,6 +100,9 @@ ConfigRunner::ProfileAll(","         ProfileCandidate(std::move(candidates[i]), *input_buffers, clusters,","                          /*is_trusted_config=*/true,","                          /*allow_new_cluster=*/true);","+    MaybeRecordValidatedCandidate(config_results[i], *input_buffers,","+                                  excluded_backends, clusters,","+                                  /*require_corroboration=*/false);","   }"," ","   const bool has_trusted_reference = !clusters.empty();","@@ -106,6 +112,10 @@ ConfigRunner::ProfileAll(","         ProfileCandidate(std::move(candidates[i]), *input_buffers, clusters,","                          /*is_trusted_config=*/false,","                          /*allow_new_cluster=*/!has_trusted_reference);","+    MaybeRecordValidatedCandidate(config_results[i], *input_buffers,","+                                  excluded_backends, clusters,","+                                  /*require_corroboration=*/","+                                  !has_trusted_reference);","   }"," ","   if (options_.enable_correctness_check) {","@@ -182,6 +192,44 @@ ConfigRunner::ConfigProfile ConfigRunner::ProfileCandidate(","                        std::move(diff_report_with_first_cluster)};"," }"," ","+void ConfigRunner::MaybeRecordValidatedCandidate(","+    const ConfigProfile& result, const InputBuffers& input_buffers,","+    absl::Span<const autotuner::Backend> excluded_backends,","+    std::vector<OutputCluster>& clusters, bool require_corroboration) {","+  if (result.failure.has_value()) {","+    return;","+  }","+  // With correctness checks enabled, only candidates whose output matched a","+  // reference cluster are eligible for selection.","+  if (options_.enable_correctness_check && result.cluster_index < 0) {","+    return;","+  }","+  const bool is_selectable =","+      result.config.codegen_backend == nullptr ||","+      !absl::c_linear_search(excluded_backends,","+                             result.config.codegen_backend->backend());","+  if (options_.enable_correctness_check && require_corroboration) {","+    // Without a trusted reference, a new cluster may be formed by a single","+    // wrong-output candidate that `DemoteNonWinningClusterConfigs` later","+    // rejects. Only report members once at least two candidates agree.","+    OutputCluster& cluster = clusters[result.cluster_index];","+    if (cluster.count < 2) {","+      if (is_selectable && !cluster.pending_selectable_duration.has_value()) {","+        cluster.pending_selectable_duration = result.duration;","+      }","+      return;","+    }","+    if (cluster.pending_selectable_duration.has_value()) {","+      profiler_->RecordValidatedCandidate(input_buffers,","+                                          *cluster.pending_selectable_duration);","+      cluster.pending_selectable_duration.reset();","+    }","+  }","+  if (is_selectable) {","+    profiler_->RecordValidatedCandidate(input_buffers, result.duration);","+  }","+}","+"," int ConfigRunner::AssignToOutputCluster(","     std::vector<OutputCluster>& clusters, ScopedShapedBuffer& output,","     bool is_trusted_config, bool allow_new_cluster,"],"additions":49,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/backends/autotuner/config_runner.h","lines":["@@ -26,10 +26,12 @@ limitations under the License."," #include \"absl/status/statusor.h\""," #include \"absl/synchronization/mutex.h\""," #include \"absl/time/time.h\"","+#include \"absl/types/span.h\""," #include \"xla/autotune_cache.pb.h\""," #include \"xla/autotune_results.pb.h\""," #include \"xla/autotuning.pb.h\""," #include \"xla/backends/autotuner/autotuning.pb.h\"","+#include \"xla/backends/autotuner/backends.pb.h\""," #include \"xla/backends/autotuner/codegen_orchestrator.h\""," #include \"xla/backends/autotuner/profiler.h\""," #include \"xla/hlo/ir/hlo_instruction.h\"","@@ -92,9 +94,14 @@ class ConfigRunner {","   static absl::StatusOr<std::unique_ptr<ConfigRunner>> Create(","       std::unique_ptr<Profiler> profiler, CorrectnessCheckOptions options);"," ","+  // Profiles all `candidates`. Candidates whose backend is in","+  // `excluded_backends` are still profiled, but are not reported to the","+  // profiler as a competitive baseline (see","+  // `Profiler::RecordValidatedCandidate`) since they cannot be selected.","   absl::StatusOr<std::vector<ConfigProfile>> ProfileAll(","       std::vector<ExecutableCandidate> candidates,","-      const HloInstruction* instr = nullptr);","+      const HloInstruction* instr = nullptr,","+      absl::Span<const autotuner::Backend> excluded_backends = {});"," ","  private:","   ConfigRunner(std::unique_ptr<Profiler> profiler,","@@ -105,6 +112,9 @@ class ConfigRunner {","     ScopedShapedBuffer representative;","     int count = 0;","     bool has_trusted_member = false;","+    // Duration of the first selectable member of an uncorroborated untrusted","+    // cluster (`count < 2`), deferred until a second member agrees with it.","+    std::optional<absl::Duration> pending_selectable_duration;","   };"," ","   ConfigProfile ProfileCandidate(ExecutableCandidate candidate,","@@ -113,6 +123,18 @@ class ConfigRunner {","                                  bool is_trusted_config, bool allow_new_cluster)","       ABSL_EXCLUSIVE_LOCKS_REQUIRED(profiler_m_);"," ","+  // Reports `result` to the profiler as a validated candidate if it succeeded,","+  // passed correctness checks, and its backend is not excluded from selection.","+  // If `require_corroboration` is true (untrusted candidates without a trusted","+  // reference), reporting is deferred until the candidate's output cluster has","+  // at least two agreeing members, so that a singleton wrong-output candidate","+  // that is later demoted cannot lower the competitive baseline.","+  void MaybeRecordValidatedCandidate(","+      const ConfigProfile& result, const InputBuffers& input_buffers,","+      absl::Span<const autotuner::Backend> excluded_backends,","+      std::vector<OutputCluster>& clusters, bool require_corroboration)","+      ABSL_EXCLUSIVE_LOCKS_REQUIRED(profiler_m_);","+","   int AssignToOutputCluster(","       std::vector<OutputCluster>& clusters, ScopedShapedBuffer& output,","       bool is_trusted_config, bool allow_new_cluster,"],"additions":23,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/backends/autotuner/config_runner_test.cc","lines":["@@ -30,6 +30,7 @@ limitations under the License."," #include \"absl/time/time.h\""," #include \"xla/autotuning.pb.h\""," #include \"xla/backends/autotuner/autotuning.pb.h\"","+#include \"xla/backends/autotuner/backends.pb.h\""," #include \"xla/backends/autotuner/mock_codegen_backend.h\""," #include \"xla/backends/autotuner/profiler.h\""," #include \"xla/hlo/ir/hlo_instruction.h\"","@@ -85,6 +86,9 @@ class MockProfiler : public Profiler {","               (ScopedShapedBuffer & output, ScopedShapedBuffer& reference,","                float rtol),","               (override));","+  MOCK_METHOD(void, RecordValidatedCandidate,","+              (const InputBuffers& buffers, absl::Duration duration),","+              (override));"," };"," "," class ConfigRunnerTest : public ::testing::Test {};","@@ -298,6 +302,158 @@ TEST_F(ConfigRunnerTest, FiltersWrongResultsAgainstTrusted) {","   EXPECT_THAT(profiles[1].failure->message, HasSubstr(\"Don't match\"));"," }"," ","+TEST_F(ConfigRunnerTest, RecordsOnlyCandidatesThatPassCorrectnessChecks) {","+  ConfigRunner::CorrectnessCheckOptions options;","+  options.enable_correctness_check = true;","+","+  auto profiler = std::make_unique<MockProfiler>();","+  ScopedShapedBuffer output_1(Shape(), nullptr, 0),","+      output_2(Shape(), nullptr, 0);","+  EXPECT_CALL(*profiler, CreateInputBuffers(_, _))","+      .WillOnce(Return(std::make_unique<InputBuffers>()));","+  EXPECT_CALL(*profiler, CheckInputBuffers(_))","+      .WillRepeatedly(Return(absl::OkStatus()));","+  EXPECT_CALL(*profiler, Profile(_, _))","+      .WillOnce(Return(ProfileResult({absl::Seconds(2), std::move(output_1)})))","+      .WillOnce(Return(ProfileResult({absl::Seconds(1), std::move(output_2)})));","+  EXPECT_CALL(*profiler, CheckOutputBuffer(_, _, _))","+      .WillOnce(Return(absl::InternalError(\"Don't match\")));","+  // The faster candidate produces wrong results, so it must not become the","+  // competitive baseline.","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(2)))","+      .Times(1);","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(1)))","+      .Times(0);","+","+  ASSERT_OK_AND_ASSIGN(auto runner,","+                       ConfigRunner::Create(std::move(profiler), options));","+","+  MockCodegenBackend trusted_backend;","+  MockCodegenBackendWithWrongResults untrusted_backend;","+","+  std::vector<ConfigRunner::ExecutableCandidate> candidates;","+  candidates.push_back({","+      /*config=*/{&trusted_backend, GetTestConfig(\"test_config_1\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+  candidates.push_back({","+      /*config=*/{&untrusted_backend, GetTestConfig(\"wrong_results_config\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+","+  ASSERT_OK_AND_ASSIGN(auto profiles,","+                       runner->ProfileAll(std::move(candidates)));","+  ASSERT_THAT(profiles, SizeIs(2));","+  EXPECT_FALSE(profiles[0].failure.has_value());","+  ASSERT_TRUE(profiles[1].failure.has_value());","+}","+","+TEST_F(ConfigRunnerTest, DoesNotRecordCandidatesOfExcludedBackends) {","+  ConfigRunner::CorrectnessCheckOptions options;","+  options.enable_correctness_check = false;","+","+  auto profiler = std::make_unique<MockProfiler>();","+  EXPECT_CALL(*profiler, CreateInputBuffers(_, _))","+      .WillOnce(Return(std::make_unique<InputBuffers>()));","+  EXPECT_CALL(*profiler, Profile(_, _))","+      .WillOnce(Return(ProfileResult({absl::Seconds(1), std::nullopt})))","+      .WillOnce(Return(ProfileResult({absl::Seconds(2), std::nullopt})));","+  // The faster candidate belongs to an excluded backend and cannot be","+  // selected, so it must not become the competitive baseline.","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(2)))","+      .Times(1);","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(1)))","+      .Times(0);","+","+  ASSERT_OK_AND_ASSIGN(auto runner,","+                       ConfigRunner::Create(std::move(profiler), options));","+","+  MockCodegenBackend excluded_backend;","+  EXPECT_CALL(excluded_backend, backend())","+      .WillRepeatedly(Return(autotuner::Backend::CUBLASLT_FISSION));","+  MockCodegenBackend allowed_backend;","+  EXPECT_CALL(allowed_backend, backend())","+      .WillRepeatedly(Return(autotuner::Backend::TRITON));","+","+  std::vector<ConfigRunner::ExecutableCandidate> candidates;","+  candidates.push_back({","+      /*config=*/{&excluded_backend, GetTestConfig(\"excluded_config\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+  candidates.push_back({","+      /*config=*/{&allowed_backend, GetTestConfig(\"allowed_config\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+","+  ASSERT_OK_AND_ASSIGN(","+      auto profiles,","+      runner->ProfileAll(std::move(candidates), /*instr=*/nullptr,","+                         /*excluded_backends=*/","+                         {autotuner::Backend::CUBLASLT_FISSION}));","+  ASSERT_THAT(profiles, SizeIs(2));","+  EXPECT_FALSE(profiles[0].failure.has_value());","+  EXPECT_FALSE(profiles[1].failure.has_value());","+}","+","+TEST_F(ConfigRunnerTest,","+       DefersRecordingUntrustedCandidatesUntilClusterIsCorroborated) {","+  ConfigRunner::CorrectnessCheckOptions options;","+  options.enable_correctness_check = true;","+","+  auto profiler = std::make_unique<MockProfiler>();","+  ScopedShapedBuffer out_a1(Shape(), nullptr, 0), out_b(Shape(), nullptr, 0),","+      out_a2(Shape(), nullptr, 0);","+  EXPECT_CALL(*profiler, CreateInputBuffers(_, _))","+      .WillOnce(Return(std::make_unique<InputBuffers>()));","+  EXPECT_CALL(*profiler, CheckInputBuffers(_))","+      .WillRepeatedly(Return(absl::OkStatus()));","+  EXPECT_CALL(*profiler, Profile(_, _))","+      .WillOnce(Return(ProfileResult({absl::Seconds(3), std::move(out_a1)})))","+      .WillOnce(Return(ProfileResult({absl::Seconds(1), std::move(out_b)})))","+      .WillOnce(Return(ProfileResult({absl::Seconds(2), std::move(out_a2)})));","+  // `out_b` does not match cluster 0 and forms a singleton cluster; `out_a2`","+  // matches cluster 0.","+  EXPECT_CALL(*profiler, CheckOutputBuffer(_, _, _))","+      .WillOnce(Return(absl::InternalError(\"minority\")))","+      .WillOnce(Return(absl::OkStatus()));","+  // Cluster 0 is corroborated once `out_a2` joins it, so both of its members","+  // are reported. The singleton (later demoted) fastest candidate is never","+  // reported, so it cannot lower the competitive baseline.","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(3)))","+      .Times(1);","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(2)))","+      .Times(1);","+  EXPECT_CALL(*profiler, RecordValidatedCandidate(_, absl::Seconds(1)))","+      .Times(0);","+","+  ASSERT_OK_AND_ASSIGN(auto runner,","+                       ConfigRunner::Create(std::move(profiler), options));","+","+  MockCodegenBackendWithWrongResults untrusted_backend;","+  std::vector<ConfigRunner::ExecutableCandidate> candidates;","+  candidates.push_back({","+      /*config=*/{&untrusted_backend, GetTestConfig(\"majority_slow\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+  candidates.push_back({","+      /*config=*/{&untrusted_backend, GetTestConfig(\"minority_fastest\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+  candidates.push_back({","+      /*config=*/{&untrusted_backend, GetTestConfig(\"majority_fast\")},","+      /*executable=*/std::make_unique<CountingDestructorExecutable>(),","+  });","+","+  ASSERT_OK_AND_ASSIGN(auto profiles,","+                       runner->ProfileAll(std::move(candidates)));","+  ASSERT_THAT(profiles, SizeIs(3));","+  EXPECT_FALSE(profiles[0].failure.has_value());","+  ASSERT_TRUE(profiles[1].failure.has_value());","+  EXPECT_EQ(profiles[1].failure->kind,","+            ConfigRunner::FailureKind::kWrongResults);","+  EXPECT_FALSE(profiles[2].failure.has_value());","+}","+"," TEST_F(ConfigRunnerTest, ClustersOutputsWhenAllBackendsUntrusted) {","   ConfigRunner::CorrectnessCheckOptions options;","   options.enable_correctness_check = true;"],"additions":156,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/autotuner/profiler.h","lines":["@@ -35,10 +35,19 @@ struct ProfileOptions {","   // Whether to initialize the buffers with random data or leave them","   // uninitialized.","   bool should_init_buffers = false;","-  // Number of timed runs of each executable. The reported duration is the","-  // mean over all timed runs, which reduces run-to-run noise and the","-  // quantization error of the device timer.","+  // Maximum number of timed runs of each executable. The reported duration is","+  // the mean over the executed timed runs, which reduces run-to-run noise and","+  // the quantization error of the device timer. When","+  // `adaptive_early_stopping` is enabled, profiler implementations may stop","+  // after the first timed run when additional passes cannot plausibly change","+  // candidate ranking.","   int num_timed_runs = 1;","+  // Whether to allow stopping after the first timed run when a candidate","+  // cannot plausibly beat the fastest candidate seen so far on the same","+  // `InputBuffers`, or when the kernel is long enough that transient timing","+  // noise is negligible. Set to false to run all `num_timed_runs` passes","+  // unconditionally.","+  bool adaptive_early_stopping = true;","   // Whether to flush the device caches before every timed run, so that the","   // executable reads its inputs from device memory. This matches production","   // workloads, where large operands such as weights are usually not cached","@@ -92,6 +101,15 @@ class Profiler {","   // for subsequent profiling.","   virtual absl::Status CheckInputBuffers(InputBuffers& buffers) = 0;"," ","+  // Notifies the profiler that a candidate profiled with `buffers` passed all","+  // correctness checks and is eligible for selection, with the given measured","+  // `duration`. Profilers may use this as the competitive baseline for","+  // `ProfileOptions::adaptive_early_stopping`. Candidates that fail","+  // validation or are excluded from selection are never reported, so they","+  // cannot cause slower valid candidates to be under-sampled.","+  virtual void RecordValidatedCandidate(const InputBuffers& buffers,","+                                        absl::Duration duration) {}","+","   // Compare the on device output buffer against the reference output buffer.","   // Returns ok if the buffers have the same content, otherwise returns an","   // error."],"additions":21,"deletions":3,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/gpu_profiler.cc","lines":["@@ -16,8 +16,11 @@ limitations under the License."," #include \"xla/backends/gpu/autotuner/gpu_profiler.h\""," "," #include <algorithm>","+#include <atomic>","+#include <cmath>"," #include <cstddef>"," #include <cstdint>","+#include <limits>"," #include <memory>"," #include <optional>"," #include <string>","@@ -77,6 +80,103 @@ namespace {"," // not report its L2 cache size."," constexpr int64_t kMinCacheFlushBytes = int64_t{64} << 20;  // 64 MiB"," ","+// First-principles hardware noise model and competitive margin-aware early","+// stopping for GPU autotuning (`GpuProfiler::Profile`).","+//","+// Let `mu_k` be the true steady-state execution time of candidate `k`. In","+// `GpuProfiler::Profile`, timed run `i` in `{0, ..., N - 1}` measures:","+//","+//   T_i = mu_k + delta_0 * I[i == 0] + eps_quant,i + eps_boundary,i","+//         + eta_i * mu_k","+//","+// with four physical error sources on modern GPUs:","+//   1. CUDA event timer quantization (`eps_quant`, sigma_q ~ 9 ns):","+//      `cuEventElapsedTime` samples the 32 ns GPU `GLOBALTIMER` tick at start","+//      and stop (`sqrt(2 / 12) * 32 ns ~= 13 ns`), which is negligible above","+//      1 us.","+//   2. Additive stream-boundary and cache-flush drain jitter (`eps_boundary`,","+//      `kBoundaryJitterStdDevNs = 1,000 ns`): each timed pass is preceded by a","+//      `2 * L2` `MemZero` (`FlushCaches()`, ~30-36 us on H100/B200/GB300).","+//      Residual L2/DRAM writeback drain, GPU front-end CTA launch latency, and","+//      last-wave tail drain contribute ~1 us of run-to-run standard deviation","+//      independent of kernel duration.","+//   3. First-run post-host-sync idle/clock transient (`delta_0`,","+//      `kFirstRunIdleBiasNs = 2,000 ns`): between the warm-up pass and","+//      `run == 0`, `Profile()` calls `stream_->BlockHostUntilDone()` and runs","+//      host-side `CheckRedzones()`, leaving the GPU idle while GPC boost clocks","+//      droop and power gates engage. A single ~33 us `MemZero` before","+//      `run == 0` is shorter than the ~100-200 us GPU DVFS ramp-up window,","+//      biasing `T_0` upward by up to ~2 us relative to runs `1..N-1` (which","+//      execute back-to-back on stream without host synchronization).","+//   4. Multiplicative memory-subsystem variance (`eta_i * mu_k`,","+//      `kRelativeNoiseStdDev = 0.01`): periodic HBM refresh (`tREFI ~ 3.9 us`)","+//      and L2/NoC partition arbitration scale proportionally (~1%) with kernel","+//      duration.","+//","+// From this model, additional timed runs after `run == 0` cannot improve","+// selection accuracy in two regimes:","+//   (a) Saturation / cost-regret cap (`T_0 >= kMaxMultiRunDurationNs`, 500 us):","+//       once `T_0 >= 500 us`, the combined relative error from the transient","+//       and boundary terms is `hypot(1 us, 2 us) / 500 us < 0.45%`, which is","+//       strictly dominated by the stationary 1% HBM variance floor while each","+//       extra pass costs `T_flush + T_0 > 530 us` (>15x the L2 flush cost).","+//   (b) Competitive 3-sigma contender test against `T_best`: let `T_best` be","+//       the lowest mean duration on the same `GpuInputBuffers` among","+//       candidates that passed `ConfigRunner` correctness checks and are","+//       eligible for selection (reported via `RecordValidatedCandidate`, with","+//       `ConfigRunner` profiling trusted reference backends first). Under","+//       the null hypothesis that candidate `k` is at least as fast as the","+//       leader (`mu_k <= mu_best`), `T_0` has upper idle bias `<= delta_0` and","+//       the difference `T_0 - T_best` (1 run vs. an N-run mean) has combined","+//       standard error:","+//","+//         sigma_diff(T_best, N) =","+//             sqrt(1 + 1 / N) * hypot(sigma_0, sigma_m * T_best)","+//","+//       At `z = 3` (99.87% one-sided normal confidence), any candidate with","+//","+//         T_0 > T_best + delta_0 + 3 * sigma_diff(T_best, N)","+//","+//       cannot plausibly beat the current leader and stops after `run == 0`.","+//       Contenders within this margin execute all `num_timed_runs` passes so","+//       first-run transients are averaged out before ranking close tiles.","+//       This test requires active L2 flushing before every timed run: without","+//       it, `run == 0` follows the L2-perturbing warm-up redzone check while","+//       runs `1..N-1` are L2-hot, so `T_0` carries an unbounded cold-cache","+//       bias relative to a multi-run `T_best` and only regime (a) applies.","+constexpr int64_t kMaxMultiRunDurationNs = 500'000;  // 500 us","+constexpr double kFirstRunIdleBiasNs = 2'000.0;      // 2.0 us","+constexpr double kBoundaryJitterStdDevNs = 1'000.0;  // 1.0 us","+constexpr double kRelativeNoiseStdDev = 0.01;        // 1.0%","+constexpr double kContenderConfidenceSigma = 3.0;    // 99.87% one-sided","+","+bool ShouldStopAfterFirstRun(int64_t first_run_ns, int64_t best_duration_ns,","+                             int num_timed_runs, bool l2_flush_active) {","+  if (num_timed_runs <= 1) {","+    return true;","+  }","+  // Mock or unprofiled executables may report <= 0 (`GpuExecutable` clamps real","+  // timings to >= 1 ns in `MaybeSyncAndProfile`), and kernels at or above","+  // `kMaxMultiRunDurationNs` have <0.45% transient/boundary error.","+  if (first_run_ns <= 0 || first_run_ns >= kMaxMultiRunDurationNs) {","+    return true;","+  }","+  if (!l2_flush_active || best_duration_ns <= 0 ||","+      best_duration_ns == std::numeric_limits<int64_t>::max() ||","+      first_run_ns <= best_duration_ns) {","+    return false;","+  }","+  const double best_ns = static_cast<double>(best_duration_ns);","+  const double per_run_sigma_ns =","+      std::hypot(kBoundaryJitterStdDevNs, kRelativeNoiseStdDev * best_ns);","+  const double diff_sigma_ns =","+      std::sqrt(1.0 + 1.0 / static_cast<double>(num_timed_runs)) *","+      per_run_sigma_ns;","+  const double contender_upper_bound_ns =","+      best_ns + kFirstRunIdleBiasNs + kContenderConfidenceSigma * diff_sigma_ns;","+  return static_cast<double>(first_run_ns) > contender_upper_bound_ns;","+}","+"," std::vector<ExecutionInput> CreateExecutionInputsFromBuffers(","     absl::Span<se::DeviceAddressBase const> buffers,","     absl::Span<Shape const> shapes) {","@@ -357,10 +457,11 @@ absl::StatusOr<ProfileResult> GpuProfiler::Profile(","     }","   }"," ","-  // Average over several timed runs. With a single run, the device timer's","-  // quantization and run-to-run noise are comparable to the differences","-  // between the best candidates, which makes the selection nondeterministic.","-  const int num_timed_runs = std::max(1, options_.num_timed_runs);","+  // Average over `num_timed_runs` for competitive candidates so run-to-run","+  // jitter and first-run post-host-sync transients do not flip selection among","+  // close tiles, while stopping after `run == 0` when `ShouldStopAfterFirstRun`","+  // determines extra passes cannot plausibly change the winner.","+  int num_timed_runs = std::max(1, options_.num_timed_runs);","   absl::Duration total_duration = absl::ZeroDuration();","   ExecutionProfile profile;","   for (int run = 0; run < num_timed_runs; ++run) {","@@ -375,7 +476,19 @@ absl::StatusOr<ProfileResult> GpuProfiler::Profile(","         ExecutionOutput execution_output,","         Execute(executable, std::move(execution_inputs), &profile, allocator_));"," ","-    total_duration += absl::Nanoseconds(profile.compute_time_ns());","+    const int64_t duration_ns = profile.compute_time_ns();","+    total_duration += absl::Nanoseconds(duration_ns);","+    // Evaluated after `FlushCaches()` so allocation failures on `run == 0`","+    // are reflected.","+    const bool l2_flush_active =","+        cache_flush_bytes_ > 0 && !cache_flush_alloc_failed_;","+    if (run == 0 && options_.adaptive_early_stopping &&","+        ShouldStopAfterFirstRun(","+            duration_ns,","+            gpu_buffers.best_duration_ns.load(std::memory_order_relaxed),","+            num_timed_runs, l2_flush_active)) {","+      num_timed_runs = 1;","+    }","     if (run == num_timed_runs - 1) {","       result.output_buffer = execution_output.Commit().ConsumeResult();","     }","@@ -384,6 +497,15 @@ absl::StatusOr<ProfileResult> GpuProfiler::Profile(","   return result;"," }"," ","+void GpuProfiler::RecordValidatedCandidate(const InputBuffers& buffers,","+                                           absl::Duration duration) {","+  if (!options_.adaptive_early_stopping) {","+    return;","+  }","+  absl::down_cast<const GpuInputBuffers&>(buffers).RecordCandidateDurationNs(","+      absl::ToInt64Nanoseconds(duration));","+}","+"," absl::Status GpuProfiler::FlushCaches() {","   if (cache_flush_bytes_ <= 0 || cache_flush_alloc_failed_) {","     return absl::OkStatus();"],"additions":127,"deletions":5,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/autotuner/gpu_profiler.h","lines":["@@ -16,7 +16,9 @@ limitations under the License."," #ifndef XLA_BACKENDS_GPU_AUTOTUNER_GPU_PROFILER_H_"," #define XLA_BACKENDS_GPU_AUTOTUNER_GPU_PROFILER_H_"," ","+#include <atomic>"," #include <cstdint>","+#include <limits>"," #include <memory>"," #include <utility>"," #include <vector>","@@ -24,6 +26,7 @@ limitations under the License."," #include \"absl/log/log.h\""," #include \"absl/status/status.h\""," #include \"absl/status/statusor.h\"","+#include \"absl/time/time.h\""," #include \"xla/backends/autotuner/profiler.h\""," #include \"xla/service/executable.h\""," #include \"xla/service/gpu/autotuning/redzone_buffers.h\"","@@ -38,6 +41,26 @@ namespace gpu {"," struct GpuInputBuffers : public InputBuffers {","   // We only use the input buffers from the redzone buffers.","   RedzoneBuffers redzone_buffers;","+","+  // Lowest positive mean duration (in nanoseconds) among candidates profiled","+  // with these input buffers that passed correctness checks and are eligible","+  // for selection (reported via `GpuProfiler::RecordValidatedCandidate`), or","+  // `max()` before the first such candidate. Scoped to `GpuInputBuffers` so","+  // each autotuned HLO instruction tracks its own competitive baseline","+  // independently.","+  mutable std::atomic<int64_t> best_duration_ns{","+      std::numeric_limits<int64_t>::max()};","+","+  void RecordCandidateDurationNs(int64_t duration_ns) const {","+    if (duration_ns <= 0) {","+      return;","+    }","+    int64_t prev = best_duration_ns.load(std::memory_order_relaxed);","+    while (duration_ns < prev &&","+           !best_duration_ns.compare_exchange_weak(prev, duration_ns,","+                                                   std::memory_order_relaxed)) {","+    }","+  }"," };"," "," class GpuProfiler : public Profiler {","@@ -60,6 +83,11 @@ class GpuProfiler : public Profiler {"," ","   absl::Status CheckInputBuffers(InputBuffers& buffers) override;"," ","+  // Updates the competitive baseline of `buffers` used by adaptive early","+  // stopping. No-op if `ProfileOptions::adaptive_early_stopping` is disabled.","+  void RecordValidatedCandidate(const InputBuffers& buffers,","+                                absl::Duration duration) override;","+","   absl::Status CheckOutputBuffer(ScopedShapedBuffer& output,","                                  ScopedShapedBuffer& reference,"],"additions":28,"deletions":0,"truncated":false}],"additions":409,"deletions":11,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-18T16:50:53.549834+00:00"}