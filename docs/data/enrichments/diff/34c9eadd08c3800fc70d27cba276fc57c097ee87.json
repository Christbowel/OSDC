tions":3,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/split-chunks/min-remaining-size/with-prelude.js","lines":["@@ -0,0 +1,3 @@","+import shared from './shared';","+import prelude from './prelude';","+export default `${shared}:${prelude}`;"],"additions":3,"deletions":0,"truncated":false},{"path":"tests/rspack-test/defaultsCases/cache/cache-filesystem-dev.mjs","lines":["@@ -51,6 +51,9 @@ export default {"," \t\t\t+     \"moduleIds\": \"named\","," \t\t\t+     \"nodeEnv\": \"development\","," \t\t\t@@ ... @@","+\t\t\t-       \"minRemainingSize\": undefined,","+\t\t\t+       \"minRemainingSize\": 0,","+\t\t\t@@ ... @@"," \t\t\t-           \"production\","," \t\t\t+           \"development\","," \t\t\t@@ ... @@"],"additions":3,"deletions":0,"truncated":false},{"path":"tests/rspack-test/defaultsCases/default/base.mjs","lines":["@@ -394,6 +394,7 @@ export default {"," \t\t\t      maxAsyncRequests: Infinity,"," \t\t\t      maxInitialRequests: Infinity,"," \t\t\t      minChunks: 1,","+\t\t\t      minRemainingSize: undefined,"," \t\t\t      minSize: 10000,"," \t\t\t      usedExports: false,"," \t\t\t    },"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/rspack-test/defaultsCases/mode/development.mjs","lines":["@@ -39,6 +39,9 @@ export default {"," \t\t\t+     \"moduleIds\": \"named\","," \t\t\t+     \"nodeEnv\": \"development\","," \t\t\t@@ ... @@","+\t\t\t-       \"minRemainingSize\": undefined,","+\t\t\t+       \"minRemainingSize\": 0,","+\t\t\t@@ ... @@"," \t\t\t-           \"production\","," \t\t\t+           \"development\","," \t\t\t@@ ... @@"],"additions":3,"deletions":0,"truncated":false},{"path":"website/docs/en/plugins/split-chunks-plugin.mdx","lines":["@@ -295,7 +295,7 @@ Maximum number of parallel requests at an entry point."," "," Set a size threshold that lets Rspack continue splitting once a candidate chunk is large enough."," ","-When a candidate reaches this threshold, Rspack ignores request-limit checks such as [`splitChunks.maxAsyncRequests`](#splitchunksmaxasyncrequests) and [`splitChunks.maxInitialRequests`](#splitchunksmaxinitialrequests).","+When a candidate reaches this threshold, Rspack ignores [`splitChunks.minRemainingSize`](#splitchunksminremainingsize) and request-limit checks such as [`splitChunks.maxAsyncRequests`](#splitchunksmaxasyncrequests) and [`splitChunks.maxInitialRequests`](#splitchunksmaxinitialrequests)."," "," Compared with [`splitChunks.cacheGroups.{cacheGroup}.enforce`](#splitchunkscachegroupscachegroupenforce), this is more targeted: only sufficiently large candidates are forced to keep splitting, while smaller ones still follow the normal heuristics."," ","@@ -371,6 +371,33 @@ export default {"," "," For example, the above configuration means that the minimum size of javascript modules in the split chunks needs to be at least 100KB, and the minimum size of css modules needs to be at least 300KB."," ","+### splitChunks.minRemainingSize","+","+#### splitChunks.cacheGroups.\\{cacheGroup\\}.minRemainingSize","+","+- **Type:** `number | Record<string, number>`","+- **Default:** `0` in development mode; falls back to `minSize` in other modes","+","+The minimum size, in bytes, of the modules left in the source chunk after splitting. This check applies only when the split has one source chunk, after excluding a reused destination chunk and applying request limits. It prevents splitting from leaving a very small chunk behind.","+","+For example, extracting CSS from a named asynchronous chunk can leave only a small JavaScript module in that chunk. In production mode, `minRemainingSize` can prevent this split, keeping the CSS in the original named chunk.","+","+The size is checked separately for each source type. A number applies to the types in [`defaultSizeTypes`](#splitchunksdefaultsizetypes); an object sets individual thresholds. Source types with no remaining modules or a remaining size of zero are skipped.","+","+```js title=\"rspack.config.mjs\"","+export default {","+  optimization: {","+    splitChunks: {","+      minRemainingSize: {","+        javascript: 20 * 1000,","+      },","+    },","+  },","+};","+```","+","+A cache group's explicit `minRemainingSize` takes precedence over its own `minSize`, which in turn takes precedence over the global `minRemainingSize`. A cache group with `enforce: true` does not inherit the global value, but its own `minRemainingSize` and `minSize` still apply. Reaching [`enforceSizeThreshold`](#splitchunksenforcesizethreshold) bypasses the remaining-size check.","+"," ### splitChunks.minSizeReduction"," "," #### splitChunks.cacheGroups.\\{cacheGroup\\}.minSizeReduction","@@ -709,7 +736,7 @@ Using the function type of `test` will significantly reduce build performance, a"," "," - **Type:** `boolean`"," ","-Tells Rspack to ignore `splitChunks.minSize`, splitChunks`.minChunks`, `splitChunks.maxAsyncRequests` and `splitChunks.maxInitialRequests` options and always create chunks for this cache group.","+Tells Rspack to ignore the global `splitChunks.minSize`, `splitChunks.minRemainingSize`, `splitChunks.minChunks`, `splitChunks.maxAsyncRequests` and `splitChunks.maxInitialRequests` options for this cache group. Values explicitly configured on the cache group still apply."],"additions":29,"deletions":2,"truncated":false}],"additions":508,"deletions":13,"truncated":true,"file_count":32},"error":null,"fetched_at":"2026-10-20T14:24:05.706692+00:00"}