                     )","+                         ORDER BY p.name\",","+                    params![catalog, ecosystem.as_str(), super::packument::ORDINARY],","+                )?,","+                Ecosystem::Cargo | Ecosystem::Pypi | Ecosystem::Oci => connection.query(","+                    \"SELECT name FROM packages WHERE catalog = ?1 AND ecosystem = ?2 ORDER BY name\",","+                    params![catalog, ecosystem.as_str()],","+                )?,","+            };","+            rows.into_iter()","+                .map(|mut row| row.get(0))","+                .collect()","+        })","+        .await","+    }"," }"],"additions":31,"deletions":0,"truncated":false},{"path":"pnpr/docs/discovery.md","lines":["@@ -47,8 +47,8 @@ results and are exact across every participating source."," "," Search includes locally hosted packages and upstreams with `search: true`. If"," no upstream opts in, a package available only upstream will not appear in search","-results. Hosted npm search results include maintainer usernames and omit the","-external package-page link.","+results. Hosted npm search results include maintainer and publisher usernames","+and omit the external package-page link."," "," ## Browsing without a search term"," "],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/docs/endpoints.md","lines":["@@ -467,7 +467,7 @@ a hosted registry."," | `PUT` | `/{package}/-rev/{rev}` | Replace a packument, used by partial unpublish. Requires the current [revision](#packument-revisions) and both `publish` and `unpublish`. Use a percent-encoded scoped package name, for example `@scope%2Fname`. |"," | `DELETE` | `/{name}` | Remove an entire unscoped package, used by force unpublish. Requires `unpublish`. Legacy `/{package}/-rev/{rev}` is also accepted. |"," | `DELETE` | `/@scope/{name}` | Remove an entire scoped package, used by force unpublish. Requires `unpublish`. Legacy `/@scope/{name}/-rev/{rev}` is also accepted. |","-| `DELETE` | `/{name}@{version}` | Unpublish an unscoped version, and reclaim its archives that no other file shares. A version the package no longer lists is left as it is. Requires `unpublish`. Legacy `/{name}@{version}/-rev/{rev}` is also accepted. |","+| `DELETE` | `/{name}@{version}` | Unpublish an unscoped version, and reclaim its archives that no other file shares. Unpublishing the last version removes the package. A version the package no longer lists is left as it is. Requires `unpublish`. Legacy `/{name}@{version}/-rev/{rev}` is also accepted. |"," | `DELETE` | `/@scope/{name}@{version}` | Unpublish a scoped version, as above. Requires `unpublish`. Legacy `/@scope/{name}@{version}/-rev/{rev}` is also accepted. |"," | `DELETE` | `/{name}/-/{filename}` | Unpublish the unscoped version the tarball belongs to, as above. Requires `unpublish`. Legacy `/{name}/-/{filename}/-rev/{rev}` is also accepted. |"," | `DELETE` | `/@scope/{name}/-/{filename}` | Unpublish the scoped version the tarball belongs to, as above. Requires `unpublish`. Legacy `/@scope/{name}/-/{filename}/-rev/{rev}` is also accepted. |",""],"additions":1,"deletions":1,"truncated":false}],"additions":261,"deletions":56,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-11T15:38:39.431545+00:00"}