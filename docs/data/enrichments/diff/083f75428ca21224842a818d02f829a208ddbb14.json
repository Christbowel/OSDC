{"id":"083f75428ca21224842a818d02f829a208ddbb14","axis":"silent","repo":"TYPO3/typo3","sha":"083f75428ca21224842a818d02f829a208ddbb14","parsed":{"files":[{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Feature-108866-PageRecordObjectInPageInformation.rst","lines":["@@ -0,0 +1,58 @@","+..  include:: /Includes.rst.txt","+","+..  _feature-108866-1793383685:","+","+==================================================================","+Feature: #108866 - Page record object in frontend page information","+==================================================================","+","+See :issue:`108866`","+","+Description","+===========","+","+The frontend request attribute :php:`frontend.page.information`, an instance","+of :php:`\\TYPO3\\CMS\\Frontend\\Page\\PageInformation`, provides the new method","+:php:`getRecord()`. It returns the current page as record object implementing","+:php:`\\TYPO3\\CMS\\Core\\Domain\\RecordInterface`, created by the Record API from","+the same page row :php:`getPageRecord()` returns. The row is the final one of","+the request: it reflects resolved shortcuts and mount points, and on a","+translated page it is the language overlay. As with :php:`getPageRecord()`,","+:php:`getUid()` returns the uid of the page in the default language, the uid","+of the translation is available via","+:php:`getComputedProperties()->getLocalizedUid()`.","+","+Like other resolved records, its fields are transformed according to their TCA","+configuration, for example relations such as :sql:`media` are resolved to file","+references. Only the fields of the page type are available, system fields such","+as :sql:`crdate` or :sql:`starttime` are not. Use :php:`getPageRecord()` or","+:html:`{page.pageRecord.crdate}` for those. The record is created once the","+page and language are resolved, after the event","+:php:`\\TYPO3\\CMS\\Frontend\\Event\\AfterPageAndLanguageIsResolvedEvent`.","+Relations are resolved lazily on first access.","+","+..  code-block:: php","+","+    $page = $request->getAttribute('frontend.page.information')->getRecord();","+    $title = $page->get('title');","+","+In Fluid templates rendered by :typoscript:`PAGEVIEW`, the record is","+available via the :html:`page` variable:","+","+..  code-block:: html","+","+    <h1>{page.record.title}</h1>","+    <f:for each=\"{page.record.media}\" as=\"image\">","+        <f:image image=\"{image}\" />","+    </f:for>","+","+:php:`getPageRecord()` continues to return the page row as array.","+","+Impact","+======","+","+Extensions and templates can access the current frontend page as record","+object with resolved relations, without creating it from the page row","+themselves.","+","+..  index:: Frontend, Fluid, PHP-API, ext:frontend"],"additions":58,"deletions":0,"truncated":false},{"path":"typo3/sysext/fluid/Classes/ViewHelpers/Render/TextViewHelper.php","lines":["@@ -20,7 +20,6 @@"," use Psr\\EventDispatcher\\EventDispatcherInterface;"," use Psr\\Http\\Message\\ServerRequestInterface;"," use TYPO3\\CMS\\Core\\Domain\\Exception\\RecordPropertyNotFoundException;","-use TYPO3\\CMS\\Core\\Domain\\RecordFactory;"," use TYPO3\\CMS\\Core\\Domain\\RecordInterface;"," use TYPO3\\CMS\\Core\\Http\\ApplicationType;"," use TYPO3\\CMS\\Core\\Schema\\Field\\InputFieldType;","@@ -70,7 +69,6 @@ final class TextViewHelper extends AbstractViewHelper"," ","     public function __construct(","         private readonly TcaSchemaFactory $tcaSchema,","-        private readonly RecordFactory $recordFactory,","         private readonly DataMapFactory $dataMapFactory,","         private readonly EventDispatcherInterface $eventDispatcher,","     ) {}","@@ -106,7 +104,7 @@ public function render(): ?UnsafeHTML","         $field = $this->arguments['field'];"," ","         if ($input instanceof PageInformation) {","-            $input = $this->recordFactory->createResolvedRecordFromDatabaseRow('pages', $input->getPageRecord());","+            $input = $input->getRecord();","         }"," ","         if (!$input instanceof RecordInterface && !$input instanceof DomainObjectInterface) {"],"additions":1,"deletions":3,"truncated":false},{"path":"typo3/sysext/fluid/Tests/Functional/ViewHelpers/Render/TextViewHelperTest.php","lines":["@@ -396,7 +396,7 @@ private static function createPageInformation(array $fields): PageInformation","     {","         $pageInformation = new PageInformation();","         $pageInformation->setId(1);","-        $pageInformation->setPageRecord([","+        $pageRecord = [","             'uid' => 1,","             'pid' => 0,","             'doktype' => 1,","@@ -417,7 +417,15 @@ private static function createPageInformation(array $fields): PageInformation","             'sorting' => 0,","             'fe_group' => '',","             ...$fields,","-        ]);","+        ];","+        $pageInformation->setPageRecord($pageRecord);","+        $pageInformation->setRecord(new RawRecord(","+            uid: 1,","+            pid: 0,","+            properties: $pageRecord,","+            computedProperties: new ComputedProperties(),","+            fullType: 'pages.1'","+        ));","         return $pageInformation;","     }"," "],"additions":10,"deletions":2,"truncated":false},{"path":"typo3/sysext/frontend/Classes/Page/PageInformation.php","lines":["@@ -17,6 +17,7 @@"," "," namespace TYPO3\\CMS\\Frontend\\Page;"," ","+use TYPO3\\CMS\\Core\\Domain\\RecordInterface;"," use TYPO3\\CMS\\Core\\Page\\PageLayout;"," "," /**","@@ -107,6 +108,8 @@ final class PageInformation","      */","     private ?PageLayout $pageLayout = null;"," ","+    private RecordInterface $record;","+","     /**","      * @internal Only to be set by core","      */","@@ -133,6 +136,22 @@ public function getPageRecord(): array","         return $this->pageRecord;","     }"," ","+    /**","+     * @internal Only to be set by core","+     */","+    public function setRecord(RecordInterface $record): void","+    {","+        $this->record = $record;","+    }","+","+    /**","+     * The page record as resolved record object, created from getPageRecord().","+     */","+    public function getRecord(): RecordInterface","+    {","+        return $this->record;","+    }","+","     /**","      * @internal Only to be set by core","      */"],"additions":19,"deletions":0,"truncated":false},{"path":"typo3/sysext/frontend/Classes/Page/PageInformationFactory.php","lines":["@@ -25,6 +25,7 @@"," use TYPO3\\CMS\\Core\\Context\\LanguageAspectFactory;"," use TYPO3\\CMS\\Core\\DataHandling\\PageDoktypeRegistry;"," use TYPO3\\CMS\\Core\\Domain\\Access\\RecordAccessVoter;","+use TYPO3\\CMS\\Core\\Domain\\RecordFactory;"," use TYPO3\\CMS\\Core\\Domain\\Repository\\PageRepository;"," use TYPO3\\CMS\\Core\\Error\\Http\\LinkedPageNotResolvableException;"," use TYPO3\\CMS\\Core\\Error\\Http\\ShortcutTargetPageNotFoundException;","@@ -82,6 +83,7 @@ public function __construct(","         private PageTypeLinkResolver $pageTypeLinkResolver,","         private PageDoktypeRegistry $pageDoktypeRegistry,","         private PageRepository $pageRepository,","+        private RecordFactory $recordFactory,","     ) {}"," ","     /**","@@ -134,6 +136,7 @@ public function create(ServerRequestInterface $request): PageInformation","             throw new PageInformationCreationFailedException($event->getResponse(), 1705420010);","         }","         $pageInformation = $event->getPageInformation();","+        $pageInformation->setRecord($this->recordFactory->createResolvedRecordFromDatabaseRow('pages', $pageInformation->getPageRecord()));"," ","         $pageInformation = $this->setSysTemplateRows($request, $pageInformation);","         $pageInformation = $this->setLocalRootLine($request, $pageInformation);"],"additions":3,"deletions":0,"truncated":false},{"path":"typo3/sysext/frontend/Tests/Functional/ContentObject/PageViewContentObjectTest.php","lines":["@@ -62,6 +62,7 @@ public static function renderWorksWithPlainRenderingInMultipleLanguagesDataProvi","               