actLocalEpochMicros;","+import static org.apache.hudi.common.avro.HoodieAvroUtils.extractLocalEpochMillis;","+","+/**","+ * Prebuilds a converter for each delete ordering field to match the comparison representation of","+ * {@link HoodieAvroUtils#convertValueForAvroLogicalTypes(Schema, Object, boolean)}.","+ * Preserves null field values and converts strings to Avro's comparable representation.","+ */","+public class AvroOrderingValueConverter {","+  private final List<Function<Comparable, Comparable>> converters;","+","+  private AvroOrderingValueConverter(HoodieSchema dataSchema, List<String> orderingFieldNames, boolean consistentLogicalTimestampEnabled) {","+    this.converters = orderingFieldNames.stream()","+        .map(field -> HoodieSchemaUtils.getNestedField(dataSchema, field)","+            .map(Pair::getRight).map(HoodieSchemaField::getNonNullSchema)","+            .orElseThrow(() -> new IllegalArgumentException(\"Ordering field '\" + field + \"' not found in table schema\")))","+        .map(schema -> createConverter(schema.toAvroSchema(), consistentLogicalTimestampEnabled))","+        .map(converter -> (Function<Comparable, Comparable>) value -> value == null ? null : converter.apply(value))","+        .collect(Collectors.toList());","+  }","+","+  public static AvroOrderingValueConverter create(HoodieSchema dataSchema, List<String> orderingFieldNames, boolean consistentLogicalTimestampEnabled) {","+    return new AvroOrderingValueConverter(dataSchema, orderingFieldNames, consistentLogicalTimestampEnabled);","+  }","+","+  public Comparable convert(Comparable value) {","+    if (converters.isEmpty()) {","+      return value;","+    }","+    return value instanceof ArrayComparable","+        ? ((ArrayComparable) value).apply(converters)","+        : converters.get(0).apply(value);","+  }","+","+  private static Function<Comparable, Comparable> createConverter(Schema schema, boolean consistentLogicalTimestampEnabled) {","+    LogicalType logicalType = schema.getLogicalType();","+    if (logicalType == LogicalTypes.date()) {","+      // Spark/Flink supply epoch days; Avro supplies LocalDate. Callers may supply java.sql.Date.","+      return value -> value instanceof Date ? ((Date) value).toLocalDate() : LocalDate.ofEpochDay(extractEpochDay(value));","+    }","+    if (logicalType == LogicalTypes.timestampMillis()) {","+      return consistentLogicalTimestampEnabled","+          ? value -> new Timestamp(toEpochMillis(value)) : AvroOrderingValueConverter::toEpochMillis;","+    }","+    if (logicalType == LogicalTypes.timestampMicros()) {","+      // Match the shared normalizer's millisecond truncation, including negative timestamps.","+      return consistentLogicalTimestampEnabled","+          ? value -> new Timestamp(toEpochMicros(value) / 1000) : AvroOrderingValueConverter::toEpochMicros;","+    }","+    // A caller-supplied Timestamp represents wall-clock fields for a local timestamp schema.","+    if (logicalType == LogicalTypes.localTimestampMillis()) {","+      return value -> extractLocalEpochMillis(value instanceof Timestamp ? ((Timestamp) value).toLocalDateTime() : value);","+    }","+    if (logicalType == LogicalTypes.localTimestampMicros()) {","+      return value -> extractLocalEpochMicros(value instanceof Timestamp ? ((Timestamp) value).toLocalDateTime() : value);","+    }","+    if (logicalType instanceof LogicalTypes.Decimal) {","+      // Spark/Flink and Avro extraction produce BigDecimal, preserved by DecimalWrapper decoding.","+      DecimalConversion decimalConversion = new DecimalConversion();","+      if (schema.getType() == Schema.Type.FIXED) {","+        return value -> value instanceof BigDecimal ? value","+            : decimalConversion.fromFixed((GenericFixed) value, schema, logicalType);","+      } else if (schema.getType() == Schema.Type.BYTES) {","+        return value -> {","+          if (value instanceof BigDecimal) {","+            return value;","+          }","+          ByteBuffer buffer = (ByteBuffer) value;","+          BigDecimal convertedValue = decimalConversion.fromBytes(buffer, schema, logicalType);","+          buffer.rewind();","+          return convertedValue;","+        };","+      }","+    }","+    if (schema.getType() == Schema.Type.STRING) {","+      // Spark/Flink Java value extraction and StringWrapper decoding produce String.","+      return value -> value instanceof String ? new Utf8((String) value) : value;","+    }","+    return value -> value;","+  }","+","+  private static long toEpochMillis(Comparable value) {","+    // Avro extraction with consistent logical timestamps enabled and wrapper decoding yield Timestamp.","+    return value instanceof Timestamp ? ((Timestamp) value).getTime() : extractEpochMillis(value);","+  }","+","+  private static long toEpochMicros(Comparable value) {","+    return extractEpochMicros(value instanceof Timestamp ? ((Timestamp) value).toInstant() : value);","+  }","+}"],"additions":136,"deletions":0,"truncated":false},{"path":"hudi-common/src/main/java/org/apache/hudi/common/avro/AvroRecordContext.java","lines":["@@ -19,6 +19,7 @@"," "," package org.apache.hudi.common.avro;"," ","+import org.apache.hudi.common.config.TypedProperties;"," import org.apache.hudi.common.engine.RecordContext;"," import org.apache.hudi.common.model.HoodieAvroIndexedRecord;"," import org.apache.hudi.common.model.HoodieEmptyRecord;","@@ -30,8 +31,10 @@"," import org.apache.hudi.common.table.HoodieTableConfig;"," import org.apache.hudi.common.table.read.BufferedRecord;"," import org.apache.hudi.common.util.AvroJavaTypeConverter;","+import org.apache.hudi.common.util.ConfigUtils;"," import org.apache.hudi.common.util.HoodieRecordUtils;"," import org.apache.hudi.common.util.Option;","+import org.apache.hudi.common.util.OrderingValues;"," import org.apache.hudi.exception.HoodieException;"," "," import org.apache.avro.generic.GenericData;","@@ -40,6 +43,7 @@"," import org.apache.avro.util.Utf8;"," "," import java.io.