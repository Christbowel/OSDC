:\\\"nested\\\",\\\"type\\\":{\\\"type\\\":\\\"record\\\",\\\"name\\\":\\\"nested_ordering\\\",\\\"fields\\\":[\"","+        + \"{\\\"name\\\":\\\"date\\\",\\\"type\\\":{\\\"type\\\":\\\"int\\\",\\\"logicalType\\\":\\\"date\\\"}}]}}]}\");","+    Map<String, Comparable> deleteValues = new LinkedHashMap<>();","+    deleteValues.put(\"date\", 20727);","+    deleteValues.put(\"ts_millis\", 1790812800123L);","+    deleteValues.put(\"ts_micros\", 1790812800123456L);","+    deleteValues.put(\"decimal_fixed\", new BigDecimal(\"1.50\"));","+    deleteValues.put(\"decimal_bytes\", new BigDecimal(\"2.50\"));","+    deleteValues.put(\"plain_int\", 20727);","+    deleteValues.put(\"plain_long\", 1790812800123456L);","+    deleteValues.put(\"text\", \"value\");","+    GenericRecord record = new GenericData.Record(schema);","+    deleteValues.forEach(record::put);","+    record.put(\"text\", new Utf8(\"value\"));","+    Schema fixedSchema = schema.getField(\"decimal_fixed\").schema();","+    Schema bytesSchema = schema.getField(\"decimal_bytes\").schema();","+    record.put(\"decimal_fixed\", new Conversions.DecimalConversion().toFixed(","+        (BigDecimal) deleteValues.get(\"decimal_fixed\"), fixedSchema, fixedSchema.getLogicalType()));","+    record.put(\"decimal_bytes\", new Conversions.DecimalConversion().toBytes(","+        (BigDecimal) deleteValues.get(\"decimal_bytes\"), bytesSchema, bytesSchema.getLogicalType()));","+    GenericRecord nested = new GenericData.Record(schema.getField(\"nested\").schema());","+    nested.put(\"date\", 20727);","+    record.put(\"nested\", nested);","+    deleteValues.put(\"nested.date\", 20727);","+    HoodieSchema hoodieSchema = HoodieSchema.fromAvroSchema(schema);","+    TypedProperties props = new TypedProperties();","+    props.setProperty(KeyGeneratorOptions.KEYGENERATOR_CONSISTENT_LOGICAL_TIMESTAMP_ENABLED.key(), String.valueOf(consistentTimestamp));","+    AvroRecordContext context = new AvroRecordContext(new HoodieTableConfig(), nu