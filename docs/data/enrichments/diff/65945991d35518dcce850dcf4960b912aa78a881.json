ter\",","+\t\t\tName:      \"breaker_transitions_total\",","+\t\t\tHelp:      \"Circuit breaker state changes, by group and the state entered: closed, half-open or open.\",","+\t\t}, []string{\"group\", \"state\"}),","+\t\tdiscoveryResults: prometheus.NewCounterVec(prometheus.CounterOpts{","+\t\t\tNamespace: \"grafana\",","+\t\t\tSubsystem: \"router\",","+\t\t\tName:      \"discovery_results_total\",","+\t\t\tHelp:      \"How each group's aggregated discovery was obtained: provided, cached, fetched, stale or unavailable.\",","+\t\t}, []string{\"group\", \"result\"}),"," \t}","-\treg.MustRegister(m.inFlight, m.longRunning, m.duration)","+\treg.MustRegister(m.inFlight, m.longRunning, m.duration, m.backendFailures, m.breakerTransitions, m.discoveryResults)"," \treturn m"," }"," ","+func (m *routerMetrics) breakerChanged(group string, to gobreaker.State) {","+\tm.breakerTransitions.WithLabelValues(group, to.String()).Inc()","+}","+","+func (m *routerMetrics) discoveryResult(group, result string) {","+\tm.discoveryResults.WithLabelValues(group, result).Inc()","+}","+","+// requestGroup returns the group a request is for: the group of an","+// /apis/<group>/... path, or of an /openapi/v3/apis/<group>/<version>","+// document, which is served by the same backend.","+func requestGroup(path string) string {","+\tif group, _, ok := parseOpenAPIGroupVersionPath(path); ok {","+\t\treturn group","+\t}","+\treturn GroupFromPath(path)","+}","+"," // instrument serves req through gr.HandleFunc with request metrics, then logs"," // the outcome. next is forwarded to HandleFunc unchanged."," func (m *routerMetrics) instrument(gr *GrafanaRouter, w http.ResponseWriter, req *http.Request, next http.Handler) {","-\tgroup := GroupFromPath(req.URL.Path)","+\tgroup := requestGroup(req.URL.Path)"," \tmetricGroup := group"," \tif group != \"\" && !gr.KnownGroup(group) {"," \t\tmetricGroup = unknownGroupLabel","@@ -62,11 +103,20 @@ func (m *routerMetrics) instrument(gr *GrafanaRouter, w http.ResponseWriter, req"," \tverb := requestVerb(req)"," \tstart := time.Now()"," \trec := newStatusRecorder(w)","+\treq, outcome := withRequestOutcome(req)","+\trecordFailure := func() {","+\t\tif outcome.failure != \"\" {","+\t\t\tm.backendFailures.WithLabelValues(metricGroup, outcome.failure).Inc()","+\t\t}","+\t}"," "," \tif verb == \"watch\" {"," \t\tm.longRunning.WithLabelValues(metricGroup).Inc()"," \t\tdefer m.longRunning.WithLabelValues(metricGroup).Dec()","-\t\tdefer func() { logRequest(req, group, rec.status, time.Since(start)) }()","+\t\tdefer func() {","+\t\t\trecordFailure()","+\t\t\tlogRequest(req, group, rec.status, time.Since(start))","+\t\t}()"," \t\tgr.HandleFunc(rec.writer(), req, next)"," \t\treturn"," \t}","@@ -75,8 +125,124 @@ func (m *routerMetrics) instrument(gr *GrafanaRouter, w http.ResponseWriter, req"," \tdefer m.inFlight.Dec()"," \tgr.HandleFunc(rec.writer(), req, next)"," \tduration := time.Since(start)","+\troute := outcome.route","+\tif route == \"\" {","+\t\troute = routeNext","+\t}"," \tm.duration.","-\t\tWithLabelValues(metricGroup, verb, strconv.Itoa(rec.status)).","+\t\tWithLabelValues(metricGroup, verb, route, strconv.Itoa(rec.status))."," \t\tObserve(duration.Seconds())","+\trecordFailure()"," \tlogRequest(req, group, rec.status, duration)"," }","+","+// routerCollector exports route state, read from the router when scraped, so","+// nothing needs updating as routes change and group labels stay limited to","+// served groups.","+type routerCollector struct {","+\trouter *GrafanaRouter","+","+\tready           *prometheus.Desc","+\tlastReconcile   *prometheus.Desc","+\treconciles      *prometheus.Desc","+\treconcileErrors *prometheus.Desc","+\tgroups          *prometheus.Desc","+\tbreaker         *prometheus.Desc","+\tshadowed        *prometheus.Desc","+\tlastSuccess     *prometheus.Desc","+\tpolls           *prometheus.Desc","+\tstackLookups    *prometheus.Desc","+}","+","+func newRouterCollector(router *GrafanaRouter) *routerCollector {","+\tname := func(n string) string { return prometheus.BuildFQName(\"grafana\", \"router\", n) }","+\treturn &routerCollector{","+\t\trouter: router,","+\t\tready: prometheus.NewDesc(name(\"ready\"),","+\t\t\t\"Whether the router is ready to serve traffic: 1 ready, 0 not.\", nil, nil),","+\t\tlastReconcile: prometheus.NewDesc(name(\"last_reconcile_timestamp_seconds\"),","+\t\t\t\"When the latest route reconcile finished, in seconds since the Unix epoch.\", nil, nil),","+\t\treconciles: prometheus.NewDesc(name(\"reconciles_total\"),","+\t\t\t\"Number of completed route reconciles.\", nil, nil),","+\t\treconcileErrors: prometheus.NewDesc(name(\"reconcile_errors_total\"),","+\t\t\t\"Number of route reconciles that completed with errors.\", nil, nil),","+\t\tgroups: prometheus.NewDesc(name(\"groups\"),","+\t\t\t\"Number of API groups the router serves, by route source.\", []string{\"source\"}, nil),","+\t\tbreaker: prometheus.NewDesc(name(\"breaker_state\"),","+\t\t\t\"Circuit breaker state of each group: 1 for its current state (closed, half-open or open), 0 for the others.\", []string{\"group\", \"state\"}, nil),","+\t\tshadowed: prometheus.NewDesc(name(\"shadowed_groups\"),","+\t\t\t\"Number of API groups a source offered that a higher-priority source serves instead, in the latest load.\", []string{\"source\"}, nil),","+\t\tlastSuccess: prometheus.NewDesc(name(\"source_last_success_timestamp_seconds\"),","+\t\t\t\"When each route source last loaded successfully, in seconds since the Unix epoch.\", []string{\"source\"}, nil),","+\t\tpolls: prometheus.NewDesc(name(\"source_polls_total\"),","+\t\t\t\"Load or poll attempts of each route source, by result: success or failure.\", []string{\"source\", \"result\"}, nil),","+\t\tstackLookups: prometheus.NewDesc(name(\"stack_lookups_total\"),","+\t\t\t\"Single-tenant stack lookups, by result: cache_hit, resolved, not_found, throttled or error.\", []string{\"result\"}, nil),","+\t}","+}","+","+func (c *routerCollector) Describe(ch chan<- *prometheus.Desc) {","+\tfor _, d := range []*prometheus.Desc{","+\t\tc.ready, c.lastReconcile, c.reconciles, c.reconcileErrors, c.groups, c.breaker,","+\t\tc.shadowed, c.lastSuccess, c.polls, c.stackLookups,","+\t} {","+\t\tch <- d","+\t}","+}","+","+var breakerStates = []gobreaker.State{gobreaker.StateClosed, gobreaker.StateHalfOpen, gobreaker.StateOpen}","+","+func (c *routerCollector) Collect(ch chan<- prometheus.Metric) {","+\tready := 0.0","+\tif c.router.Ready(context.Background()) == nil {","+\t\tready = 1","+\t}","+\tch <- prometheus.MustNewConstMetric(c.ready, prometheus.GaugeValue, ready)","+\tif ns := c.router.lastReconcile.Load(); ns != 0 {","+\t\tch <- prometheus.MustNewConstMetric(c.lastReconcile, prometheus.GaugeValue, float64(ns)/1e9)","+\t}","+\tch <- prometheus.MustNewConstMetric(c.reconciles, prometheus.CounterValue, float64(c.router.reconciles.Load()))","+\tch <- prometheus.MustNewConstMetric(c.reconcileErrors, prometheus.CounterValue, float64(c.router.reconcileErrors.Load()))","+","+\tperSource := map[string]int{}","+\tfor group, entry := range *c.router.snapshot.Load() {","+\t\tperSource[entry.source]++","+\t\t// The single-tenant fallback keeps a breaker per stack, not per group.","+\t\tif _, perDestination := entry.handler.(interface{ managesCircuitBreaking() }); perDestination || entry.breaker == nil {","+\t\t\tcontinue","+\t\t}","+\t\tcurrent := entry.breaker.State()","+\t\tfor _, state := range breakerStates {","+\t\t\tvalue := 0.0","+\t\t\tif state == current {","+\t\t\t\tvalue = 1","+\t\t\t}","+\t\t\tch <- prometheus.MustNewConstMetric(c.breaker, prometheus.GaugeValue, value, group, state.String())","+\t\t}","+\t}","+\tfor source, n := range perSource {","+\t\tch <- prometheus.MustNewConstMetric(c.groups, prometheus.GaugeValue, float64(n), source)","+\t}","+","+\tstatus, ok := c.router.loader.(loaderStatus)","+\tif !ok {","+\t\treturn","+\t}","+\tshadowed := map[string]int{}","+\tfor _, s := range status.shadowedGroups() {","+\t\tshadowed[s.Source]++","+\t}","+\tfor source, n := range shadowed {","+\t\tch <- prometheus.MustNewConstMetric(c.shadowed, prometheus.GaugeValue, float64(n), source)","+\t}","+\tfor _, s := range status.sourceStatuses() {","+\t\tif !s.LastSuccess.IsZero() {","+\t\t\tch <- prometheus.MustNewConstMetric(c.lastSuccess, prometheus.GaugeValue, float64(s.LastSuccess.UnixNano())/1e9, s.Source)","+\t\t}","+\t\tch <- prometheus.MustNewConstMetric(c.polls, prometheus.CounterValue, float64(s.Successes), s.Source, \"success\")","+\t\tch <- prometheus.MustNewConstMetric(c.polls, prometheus.CounterValue, float64(s.Failures), s.Source, \"failure\")","+\t}","+\tfor result, n := range status.stackLookups() {","+\t\tch <- prometheus.MustNewConstMetric(c.stackLookups, prometheus.CounterValue, float64(n), result)","+\t}","+}"],"additions":180,"deletions":14,"truncated":false},{"path":"pkg/router/metrics_test.go","lines":["@@ -0,0 +1,248 @@"],"additions":0,"deletions":0,"truncated":false}],"additions":377,"deletions":27,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-09-27T13:16:08.886503+00:00"}