ession with a token) verifies via","+    // assignUserToSession without calling verifySession, so it must reset the","+    // limiter on its own branch.","+    const getSession = createGetSession();","+","+    const findUserById = sinon.spy(async ({ id }) => ({ id }));","+    const getOriginOfRequest = sinon.stub().returns('https://admin.example.com');","+    const isStaffDeviceVerificationDisabled = sinon.stub().returns(false);","+    const resetVerificationEmailForUser = sinon.stub().resolves();","+","+    const sessionService = SessionService({","+      getSession,","+      findUserById,","+      getOriginOfRequest,","+      getSettingsCache,","+      isStaffDeviceVerificationDisabled,","+      urlUtils,","+      resetVerificationEmailForUser,","+    });","+","+    const req = Object.create(express.request, {","+      ip: {","+        value: '0.0.0.0',","+      },","+      headers: {","+        value: {","+          cookie: 'thing',","+        },","+      },","+      get: {","+        value: () => 'https://admin.example.com',","+      },","+    });","+    const res = Object.create(express.response);","+    const user = { id: 'egg' };","+","+    // Generate a valid token for the same session challenge","+    const previousSession = await getSession(req);","+    previousSession.user_id = 'egg';","+    const validToken = await sessionService.generateAuthCodeForUser(req, res);","+","+    req.body = { token: validToken };","+    await sessionService.createSessionForUser(req, res, user);","+","+    assert.equal(req.session.verified, true);","+    sinon.assert.calledOnceWithExactly(resetVerificationEmailForUser, 'egg');","+  });","+","   it('#createSessionForUser does not verify session when invalid token is provided on request', async function () {","     const getSession = createGetSession();"," ","@@ -718,6 +783,124 @@ describe('SessionService', function () {","     assert.equal(isValid, false);","   });"," ","+  describe('challenge attempt budget', function () {","+