{"id":"ebc2b964ea1b72451d5f70c4315a5f9d0cc2c6be","axis":"silent","repo":"TryGhost/Ghost","sha":"ebc2b964ea1b72451d5f70c4315a5f9d0cc2c6be","parsed":{"files":[{"path":"docs/codebase/authentication.md","lines":["@@ -73,6 +73,13 @@ rotates the session when signing in and after authentication resets so verified"," state cannot be carried to a different user. Verification codes are"," session-bound, short-lived, and invalidated after successful use."," ","+Both verification requests and sign-ins that include a code share a database-backed","+attempt budget per challenge, independent of IP or session ID changes. By default,","+`spam.user_verification_challenge` allows five attempts and blocks further attempts","+for the rest of the code's five-minute validity. Requesting a new code creates a","+new challenge and budget. The separate per-IP verification and resend limits still","+apply.","+"," The current flow lives in"," [`auth/session/session-service.js`](../../ghost/core/server/auth/session/session-service.js),"," with request middleware in"],"additions":7,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/session/index.js","lines":["@@ -12,8 +12,26 @@ const models = require('../../models');"," const urlUtils = require('../../../shared/url-utils').default;"," const config = require('../../../shared/config');"," const { blogIcon } = require('../../lib/image');","+const spamPrevention = require('../../web/shared/middleware/api/spam-prevention');","+const errors = require('@tryghost/errors');","+const moment = require('moment');"," const url = require('url');"," ","+// Share the email budget across sessions, IPs and Ghost instances.","+async function limitVerificationEmailForUser(userId) {","+  const result = await spamPrevention.verificationEmail().consume({ key: userId });","+  if (!result.allowed) {","+    throw new errors.TooManyRequestsError({","+      message: `Too many verification emails requested, try again in ${moment.duration(result.retryAfterMs).humanize()}`,","+      context: 'Too many attempts.',","+    });","+  }","+}","+","+function resetVerificationEmailForUser(userId) {","+  return spamPrevention.verificationEmail().reset({ key: userId });","+}","+"," // TODO: We have too many lines here, should move functions out into a utils module"," "," function getOriginOfRequest(req) {","@@ -52,6 +70,15 @@ function getOriginOfRequest(req) {"," const mailer = new GhostMailer();"," "," const sessionService = createSessionService({","+  async consumeAuthCodeAttempt(challenge) {","+    const result = await spamPrevention.userVerificationChallenge().consume({ key: challenge });","+    if (!result.allowed) {","+      throw new errors.TooManyRequestsError({","+        message: 'Too many verification attempts. Please request a new code.',","+        code: 'STAFF_VERIFICATION_ATTEMPTS_RATE_LIMITED',","+      });","+    }","+  },","   getOriginOfRequest,","   getSession: expressSession.getSession,","   findUserById({ id }) {","@@ -70,6 +97,8 @@ const sessionService = createSessionService({","       'https://static.ghost.org/v4.0.0/images/ghost-orb-1.png'","     );","   },","+  limitVerificationEmailForUser,","+  resetVerificationEmailForUser,","   mailer,","   urlUtils,","   t,"],"additions":29,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/session/session-service.js","lines":["@@ -60,6 +60,9 @@ const AUTH_CODE_CHALLENGE_BYTES = 16;","  * @param {import('../../../shared/i18n').t} deps.t","  * @param {import('../../../shared/url-utils').default} deps.urlUtils","  * @param {() => boolean} deps.isStaffDeviceVerificationDisabled","+ * @param {(userId: string) => Promise<void>} deps.limitVerificationEmailForUser","+ * @param {(userId: string) => Promise<void>} deps.resetVerificationEmailForUser","+ * @param {(challenge: string) => Promise<void>} deps.consumeAuthCodeAttempt","  * @returns {SessionService}","  */"," ","@@ -72,8 +75,20 @@ module.exports = function createSessionService({","   mailer,","   urlUtils,