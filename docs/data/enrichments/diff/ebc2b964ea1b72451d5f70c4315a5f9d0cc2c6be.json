sidesteps any","+      // per-session throttle).","+      for (let i = 0; i < 3; i++) {","+        agent.clearCookies();","+        await login().expectStatus(403);","+      }","+","+      agent.clearCookies();","+      await login()","+        .expectStatus(429)","+        .matchBodySnapshot({","+          errors: [","+            {","+              id: anyUuid,","+              message: stringMatching(/Too many verification emails requested/),","+            },","+          ],","+        });","+","+      // The blocked attempt must not have sent another email.","+      mail.assertSentEmailCount(3);","+    });","+","+    it('clears the per-user verification-email limit after a successful sign-in', async function () {","+      const owner = await fixtureManager.get('users', 0);","+","+      const login = () =>","+        agent.post('session/').body({","+          grant_type: 'password',","+          username: owner.email,","+          password: owner.password,","+        });","+","+      // Send one code and complete verification, which resets the counter.","+      await login().expectStatus(403);","+      const email = assert.sentEmail({","+        subject: /[0-9]{6} is your Ghost sign in verification code/,","+      });","+      const token = email.subject.match(/[0-9]{6}/)[0];","+      await agent.put('session/verify').body({ token }).expectStatus(200);","+","+      // With the counter reset, three more fresh-session sends all go through.","+      // Without the reset, the third login would have been blocked (429), as","+      // the login above already used one of the three allowed sends.","+      for (let i = 0; i < 3; i++) {","+        agent.clearCookies();","+        await login().expectStatus(403);","+      }","+    });","+","     it('can verify a session with 2FA code', async function () {","       const owner = await fixtureManager.get('users', 0);","       await agent","@@ -136,6 +203,51 @@ describe('Sessions API', function () {","         .expectEmptyBody();","     });"," ","+    it('caps a challenge across IPs and sign-in, and allows a resent code', async function () {","+      const owner = await fixtureManager.get('users', 0);","+      const credentials = {","+        grant_type: 'password',","+        username: owner.email,","+        password: owner.password,","+      };","+      await agent.post('session/').body(credentials).expectStatus(403);","+      const token = assert","+        .sentEmail({","+          subject: /[0-9]{6} is your Ghost sign in verification code/,","+        })","+        .subject.match(/[0-9]{6}/)[0];","+","+      for (let i = 0; i < 5; i++) {","+        await agent","+          .put('session/verify', { headers: { 'x-forwarded-for': `192.0.2.${i + 1}` } })","+          .body({ token: 'wrong-code' })","+          .expectStatus(401);","+      }","+      await agent","+        .put('session/verify', { headers: { 'x-forwarded-for': '192.0.2.6' } })","+        .body({ token })","+        .expectStatus(429);","+      await agent","+        .post('session/', { headers: { 'x-forwarded-for': '192.0.2.7' } })","+        .body({ ...credentials, token })","+        .expectStatus(429);","+      mail.assertSentEmailCount(1);","+","+      await agent","+        .post('session/verify', { headers: { 'x-forwarded-for': '192.0.2.8' } })","+        .expectStatus(200);","+      const freshToken = assert","+        .sentEmail({","+          subject: /[0-9]{6} is your Ghost sign in verification code/,","+        })","+        .subject.match(/[0-9]{6}/)[0];","+      await agent","+        .put('session/verify', { headers: { 'x-forwarded-for': '192.0.2.9' } })","+        .body({ token: freshToken })","+        .expectStatus(200);","+      await agent.get('/users/me/').expectStatus(200);","+    });","+","     it('rejects verification from a mismatched origin', async function () {","       const owner = await fixtureManager.get('users', 0);","       await agent"],"additions":112,"deletions":0,"truncated":false},{