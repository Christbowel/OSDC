 true,","+    onBlocked: (retryAfterMs) =>","+      new errors.TooManyRequestsError({","+        message: `Too many verification emails requested, try again in ${waitText(retryAfterMs)}`,","+        context: tpl(messages.tooManyAttempts),","+      }),","+  });","+"," // This protects a private blog from spam attacks. The defaults here allow 10 attempts per IP per hour"," // The endpoint is then locked for an hour"," const privateBlog = () =>","@@ -432,7 +453,9 @@ const spamPrevention = {","   globalReset,","   userLogin,","   sendVerificationCode,","+  verificationEmail,","   userVerification,","+  userVerificationChallenge,","   membersAuth,","   membersAuthEnumeration,","   checkoutSessionGlobal,"],"additions":23,"deletions":0,"truncated":false},{"path":"ghost/core/shared/config/defaults.json","lines":["@@ -131,12 +131,24 @@","       \"lifetime\": 3600,","       \"freeRetries\": 4","     },","+    \"user_verification_challenge\": {","+      \"minWait\": 300000,","+      \"maxWait\": 300000,","+      \"lifetime\": 300,","+      \"freeRetries\": 4","+    },","     \"send_verification_code\": {","       \"minWait\": 3600000,","       \"maxWait\": 3600000,","       \"lifetime\": 3600,","       \"freeRetries\": 4","     },","+    \"send_verification_code_user\": {","+      \"minWait\": 3600000,","+      \"maxWait\": 3600000,","+      \"lifetime\": 3600,","+      \"freeRetries\": 4","+    },","     \"global_reset\": {","       \"minWait\": 3600000,","       \"maxWait\": 3600000,"],"additions":12,"deletions":0,"truncated":false},{"path":"ghost/core/shared/config/env/config.testing-mysql.json","lines":["@@ -64,6 +64,12 @@","       \"lifetime\": 3600,","       \"freeRetries\": 4","     },","+    \"send_verification_code_user\": {","+      \"minWait\": 3600000,","+      \"maxWait\": 3600000,","+      \"lifetime\": 3600,","+      \"freeRetries\": 2","+    },","     \"global_reset\": {","       \"minWait\": 3600000,","       \"maxWait\": 3600000,"],"additions":6,"deletions":0