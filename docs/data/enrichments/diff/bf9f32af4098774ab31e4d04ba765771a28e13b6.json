ignature().AddParameter(\"expr\", LogicalType::ANY);","+\tfun.SetBindCallback(HasErrorBind);","+\treturn fun;","+}","+","+} // namespace duckdb"],"additions":27,"deletions":0,"truncated":false},{"path":"src/function/scalar/generic/try_rethrow.cpp","lines":["@@ -0,0 +1,41 @@","+#include \"duckdb/function/scalar/generic_functions.hpp\"","+#include \"duckdb/function/scalar/nested_functions.hpp\"","+","+namespace duckdb {","+","+namespace {","+","+void TryRethrowFunction(DataChunk &args, ExpressionState &state, Vector &result) {","+\tfor (auto entry : args.data[0].Values<bool>()) {","+\t\tif (entry.IsValid() && entry.GetValue()) {","+\t\t\tthrow InvalidInputException(","+\t\t\t    \"An error was raised in a nested subquery under TRY (the original message is not preserved)\");","+\t\t}","+\t}","+\tresult.Reference(args.data[1]);","+}","+","+unique_ptr<FunctionData> TryRethrowBind(BindScalarFunctionInput &input) {","+\tauto &bound_function = input.GetBoundFunction();","+\tauto &arguments = input.GetArguments();","+\tbound_function.SetReturnType(arguments[1]->GetReturnType());","+\treturn make_uniq<VariableReturnBindData>(bound_function.GetReturnType());","+}","+","+} // namespace","+","+ScalarFunction TryRethrowFun::GetFunction() {","+\tScalarFunction fun(Name, {}, LogicalType::ANY, TryRethrowFunction);","+\tfun.GetSignature().AddParameter(\"error\", LogicalType::BOOLEAN);","+\tfun.GetSignature().AddParameter(\"value\", LogicalType::ANY);","+\tfun.SetBindCallback(TryRethrowBind);","+\t// a NULL flag (from an empty subquery) must reach the function unchanged, and the value must not","+\t// be rewritten around it: the raise on flagged rows is the entire point of the function","+\tfun.SetNullHandling(FunctionNullHandling::SPECIAL_HANDLING);","+\t// deterministic in its inputs, so it does not poison surrounding expressions with volatility, but","+\t// fallible, so nothing evaluates it on rows the plan would not evaluate it on","+\tfun.SetFallible();","+\treturn fun;","+}","+"