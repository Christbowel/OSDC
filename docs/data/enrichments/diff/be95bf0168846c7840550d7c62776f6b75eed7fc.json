Id' => 'com.example.app',","+            'fingerprints' => [","+                '14:6D:E9:83:C5:73:06:50:D8:EE:B9:95:2F:34:FC:64:16:A0:83:42:E6:1D:BE:A8:8A:04:96:B2:3F:CF:44:E5',","+                \\implode(':', \\array_fill(0, 32, 'FA')),","+            ],","+        ]);","+        $this->assertSame(200, $response['headers']['status-code'], \\json_encode($response['body']));","+","+        $response = $this->client->call(Client::METHOD_GET, '/project/policies/passkey', $this->getServerHeaders($project));","+        $this->assertSame([$release, $debug, 'https://example.com'], $response['body']['origins']);","+","+        $challenge = $this->client->call(Client::METHOD_POST, '/account/passkeys', $headers);","+        $this->assertSame('example.com', $challenge['body']['publicKey']['rp']['id']);","+        $response = $this->client->call(Client::METHOD_PUT, '/account/passkeys/' . $challenge['body']['passkeyId'] . '/verification', $headers, [","+            'credential' => $authenticator->register($challenge['body']['publicKey'], $release),","+        ]);","+        $this->assertSame(200, $response['headers']['status-code'], \\json_encode($response['body']));","+","+        // A passkey made in the app also works on the website and in a build signed with the other key","+        foreach ([$release, $debug, 'https://example.com'] as $origin) {","+            $token = $this->signIn($project, $authenticator, $origin);","+            $this->assertSame(201, $token['headers']['status-code'], $origin);","+            $this->assertSame($user['$id'], $token['body']['userId']);","+        }","+","+        /**","+         * Test for FAILURE","+         */","+        // Another signing key or a malformed hash","+        foreach (['android:apk-key-hash:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA', 'android:apk-key-hash:' . \\substr($release, 21, 20), 'android:apk-key-hash:*'] as $origin) {","+            $this->assertSame(401, $this->signIn($project, $authenticator, $origin)['head