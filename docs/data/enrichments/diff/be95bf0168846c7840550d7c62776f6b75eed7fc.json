+","+namespace Appwrite\\Network\\Validator;","+","+use Utopia\\Validator\\Validator;","+","+/**","+ * SHA-256 fingerprint of an app signing certificate, as Play Console and `keytool` print it: 32 hex bytes","+ * separated by colons, such as `14:6D:E9:83:...`.","+ */","+class Fingerprint extends Validator","+{","+    private const int BYTES = 32;","+","+    public function getDescription(): string","+    {","+        return 'Value must be a SHA-256 certificate fingerprint of 32 colon-separated hex bytes, such as \"14:6D:E9:...:2B:6A\".';","+    }","+","+    public function isArray(): bool","+    {","+        return false;","+    }","+","+    public function getType(): string","+    {","+        return self::TYPE_STRING;","+    }","+","+    public function isValid($value): bool","+    {","+        if (!\\is_string($value)) {","+            return false;","+        }","+","+        $bytes = \\explode(':', $value);","+        if (\\count($bytes) !== self::BYTES) {","+            return false;","+        }","+","+        foreach ($bytes as $byte) {","+            if (\\strlen($byte) !== 2 || !\\ctype_xdigit($byte)) {","+                return false;","+            }","+        }","+","+        return true;","+    }","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"src/Appwrite/Platform/Modules/Project/Http/Project/Platforms/Android/Create.php","lines":["@@ -5,6 +5,7 @@"," use Appwrite\\Event\\Event as QueueEvent;"," use Appwrite\\Extend\\Exception;"," use Appwrite\\Network\\Platform;","+use Appwrite\\Network\\Validator\\Fingerprint;"," use Appwrite\\SDK\\AuthType;"," use Appwrite\\SDK\\Method;"," use Appwrite\\SDK\\Response as SDKResponse;","@@ -17,6 +18,7 @@"," use Utopia\\Database\\Validator\\Authorization;"," use Utopia\\Platform\\Action;"," use Utopia\\Platform\\Scope\\HTTP;","+use Utopia\\Validator\\ArrayList;"," use Utopia\\Validator\\Text;"," "," class Create extends Action","@@ -58,6 +60,7 @@ public function __construct()","             ->param('pl