est/sql/optimizer/struct_extract_struct_pack_collation.test","lines":["@@ -0,0 +1,33 @@","+# name: test/sql/optimizer/struct_extract_struct_pack_collation.test","+# description: Folding struct_extract(struct_pack(...)) keeps the collation of the extracted expression","+# group: [optimizer]","+","+statement ok","+CREATE TABLE c(s VARCHAR);","+","+statement ok","+INSERT INTO c VALUES ('a');","+","+query I","+SELECT s FROM c WHERE ({'b': s}).b COLLATE nocase = 'A';","+----","+a","+","+query I","+SELECT s FROM c WHERE ({'b': s}).b = 'A';","+----","+","+query I","+SELECT s FROM c WHERE ({'b': s}).b COLLATE nocase = 'A' COLLATE nocase;","+----","+a","+","+query I","+SELECT ({b: s}).b COLLATE nocase = 'A' FROM c;","+----","+true","+","+query I","+SELECT ({b: s})['b'] COLLATE nocase = 'A' FROM c;","+----","+true"],"additions":33,"deletions":0,"truncated":false},{"path":"test/sql/sql_export/dml_statements.test","lines":["@@ -366,6 +366,27 @@ SELECT a FROM d ORDER BY a LIMIT 1;"," statement ok"," RESET debug_verify_statement;"," ","+# INSERT OR REPLACE with only key columns exports a MERGE with DO NOTHING instead of an empty SET","+statement ok","+CREATE TABLE dml_key_only(k INTEGER PRIMARY KEY, v INTEGER);","+","+statement ok","+INSERT INTO dml_key_only VALUES (1, 10);","+","+query TT","+EXPLAIN (SQL) INSERT OR REPLACE INTO dml_key_only(k) VALUES (1), (2);","+----","+sql\t<REGEX>:(?s).*WHEN\\s+MATCHED\\s+THEN\\s+DO\\s+NOTHING\\s+WHEN\\s+NOT\\s+MATCHED\\s+THEN\\s+INSERT.*","+","+statement ok","+SET debug_verify_statement='explain_sql_strict';","+","+statement ok","+INSERT OR REPLACE INTO dml_key_only(k) VALUES (1), (2);","+","+statement ok","+RESET debug_verify_statement;","+"," # an ON CONFLICT insert binds to MERGE INTO, which SQL does not accept as a CTE body"," statement error"," EXPLAIN (SQL) WITH ups AS (INSERT INTO dml_keyed VALUES (1,'x') ON CONFLICT DO NOTHING RETURNING a) SELECT * FROM ups;"],"additions":21,"deletions":0,"truncated":false},{"path":"test/sql/storage/wal_torn_write.cpp","lines":["@@ -225,3 +225,190 @@ TEST_CASE(\"Test WAL checksums\", \"[storage][.]\") {"," \tDeleteDatabase(storage_database);"," \tDeleteDatabase(source_database);"," }","+","+TEST_CASE(\"Test WAL entry size that overflows the bound check\", \"[storage][.]\") {","+\tauto config = GetTestConfig();","+\tauto storage_database = TestCreatePath(\"wal_size_overflow\");","+\tauto storage_wal = storage_database + \".wal\";","+\tauto source_database = TestCreatePath(\"wal_size_overflow_source\");","+\tauto source_wal = source_database + \".wal\";","+","+\tLocalFileSystem lfs;","+\tconfig->options.checkpoint_wal_size = idx_t(-1);","+\tconfig->options.checkpoint_on_shutdown = false;","+\tconfig->options.abort_on_wal_failure = false;","+\tDeleteDatabase(storage_database);","+\tDeleteDatabase(source_database);","+\t{","+\t\tDuckDB db(source_database, config.get());","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE A (a INTEGER);\"));","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE B (a INTEGER);\"));","+\t}","+\tauto commit_boundaries = GetWALCommitBoundaries(lfs, source_wal);","+\tCopyFile(lfs, source_database, storage_database);","+\tCopyFile(lfs, source_wal, storage_wal);","+\tTruncateWAL(lfs, storage_wal, commit_boundaries.first);","+\t{","+\t\t// append an entry header with an entry size of 2^64 - 1: the size check must not overflow","+\t\tauto handle = lfs.OpenFile(storage_wal, FileFlags::FILE_FLAGS_WRITE);","+\t\tdata_t header[2 * sizeof(uint64_t)];","+\t\tmemset(header, 0xFF, sizeof(header));","+\t\thandle->Write(QueryContext(), header, sizeof(header), commit_boundaries.first);","+\t}","+\t{","+\t\t// the oversized entry is treated as a torn write: table A is replayed, table B is not","+\t\tDuckDB db(storage_database, config.get());","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"FROM A\"));","+\t\tREQUIRE_FAIL(con.Query(\"FROM B\"));","+\t}","+\tDeleteDatabase(storage_database);","+\tDeleteDatabase(source_database);","+}","+","+TEST_CASE(\"Test encrypted WAL version on an unencrypted database\", \"[storage][.]\") {","+\tauto config = GetTestConfig();","+\tauto storage_database = TestCreatePath(\"wal_version_encrypted\");","+\tauto storage_wal = storage_database + \".wal\";","+","+\tLocalFileSystem lfs;","+\tconfig->options.checkpoint_wal_size = idx_t(-1);","+\tconfig->options.checkpoint_on_shutdown = false;","+\tDeleteDatabase(storage_database);","+\t{","+\t\tDuckDB db(storage_database, config.get());","+\t\tConnection con(db);","+\t\tREQUIRE_NO_FAIL(con.Query(\"CREATE TABLE A (a INTEGER);\"));","+\t}","+\t// the version of the WAL is stored in the (unchecksummed) first entry at byte 5: change 2 into 3","+\tFlipWALByte(lfs, storage_wal, 5);","+\tREQUIRE_THROWS_WITH(DuckDB(storage_database, config.get()),","+\t                    Catch::Contains(\"marked as encrypted, but the database is not\"));","+\tDeleteDatabase(storage_database);","+}","+","+//! Renumber the first field (101) of the payload of the first framed WAL entry and fix up its checksum","+static void RenumberFirstEntryField(FileSystem &fs, const string &path) {","+\tauto handle = fs.OpenFile(path, FileFlags::FILE_FLAGS_WRITE | FileFlags::FILE_FLAGS_READ);","+\tauto wal_size = handle->GetFileSize();","+\tauto wal_contents = duckdb::unique_ptr<data_t[]>(new data_t[wal_size]);","+\thandle->Read(QueryContext(), wal_contents.get(), wal_size, 0);","+","+\t// find the first framed entry by trying every start offset: the first [size][checksum][payload] with a valid","+\t// checksum that is followed by another valid entry","+\tfor (idx_t start = 0; start + 2 * sizeof(uint64_t) <= wal_size; start++) {","+\t\tuint64_t entry_size;","+\t\tuint64_t stored_checksum;","+\t\tmemcpy(&entry_size, wal_contents.get() + start, sizeof(uint64_t));","+\t\tmemcpy(&stored_checksum, wal_contents.get() + start + sizeof(uint64_t), sizeof(uint64_t));","+\t\tauto payload_offset = start + 2 * sizeof(uint64_t);","+\t\tif (entry_size < 4 || entry_size > wal_size - payload_offset) {","+\t\t\tcontinue;","+\t\t}","+\t\tauto entry = duckdb::unique_ptr<data_t[]>(new data_t[entry_size]);","+\t\tmemcpy(entry.get(), wal_contents.get() + payload_offset, entry_size);","+\t\tif (Checksum(entry.get(), entry_size) != stored_checksum) {","+\t\t\tcontinue;","+\t\t}","+\t\t// the payload is a serialized object: the info property has field id 101 (little endian)"],"additions":87,"deletions":0,"truncated":false}],"additions":352,"deletions":80,"truncated":true,"file_count":18},"error":null,"fetched_at":"2026-11-07T15:04:48.582782+00:00"}