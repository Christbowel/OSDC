live\":","+        return client.live.connect(extra_query=query)","+    if product == \"live-sideband\":","+        return client.live.sideband.connect(session_id=\"live_1\", extra_query=query)","+    if product == \"live-forks\":","+        return client.live.forks.connect(session_id=\"live_1\", extra_query=query)","+    if product == \"translation\":","+        return client.realtime.translations.connect(\"test\", extra_query=query)","+    assert product == \"beta-realtime\"","+    return client.beta.realtime.connect(model=\"test\", extra_query=query)","+","+","+@pytest.mark.parametrize(\"mode\", [\"sync\", \"async\"])","+@pytest.mark.parametrize(","+    (\"provider\", \"product\"),","+    [(\"openai\", product) for product in (*PRODUCTS, \"beta-realtime\")]","+    + [(\"azure\", product) for product in (\"realtime\", \"beta-realtime\")],","+)","+@pytest.mark.parametrize(","+    (\"query\", \"expected\"),","+    [","+        pytest.param(","+            {\"route\": \"connection\", \"filter\": \"plain\"},","+            {\"route\": [\"connection\"], \"filter\": [\"plain\"]},","+            id=\"primitive\",","+        ),","+        pytest.param(","+            {\"route\": omit, \"filter\": omit, \"repeat\": omit},","+            {},","+            id=\"omit\",","+        ),","+        pytest.param(","+            {\"route\": None, \"filter\": {\"language\": \"fr\", \"empty\": None}, \"repeat\": [\"new\", None, \"last\"]},","+            {\"route\": [\"\"], \"filter[language]\": [\"fr\"], \"repeat\": [\"new\", \"\", \"last\"]},","+            id=\"structured\",","+        ),","+    ],","+)","+def test_websocket_query_tiers(","+    mode: Literal[\"sync\", \"async\"],","+    provider: Literal[\"openai\", \"azure\"],","+    product: str,","+    query: Query,","+    expected: dict[str, list[str]],","+    monkeypatch: pytest.MonkeyPatch,","+) -> None:","+    monkeypatch.setenv(\"NO_PROXY\", \"*\")","+    monkeypatch.setenv(\"no_proxy\", \"*\")","+    wire = b'{\"type\":\"future.event\",\"value\":\"received\"}'","+    observations: list[dict[str, list[str]]] = []","+    failures: list[Exception] = []","+    done = Event()","+    original = dict(query)","+","+    def accept(socket: ServerConnection) -> None:","+        try:","+            assert socket.request is not None","+            observations.append(parse_qs(urlsplit(socket.request.path).query, keep_blank_values=True))","+            socket.send(wire)","+            try:","+                socket.recv(timeout=5)","+            except ConnectionClosed:","+                # The client has received the event and is closing normally.","+                pass","+        except Exception as exc:","+            failures.append(exc)","+        finally:","+            done.set()","+","+    with serve(accept, \"127.0.0.1\", 0, close_timeout=1) as server:","+        thread = Thread(target=server.serve_forever)","+        thread.start()","+        try:","+            address = server.socket.getsockname()[1]","+            common: dict[str, Any] = {","+                \"api_key\": \"fake\",","+                \"websocket_base_url\": (","+                    f\"ws://127.0.0.1:{address}/v1?route=url&repeat=first&repeat=second&keep=one&keep=two\"","+                ),","+                \"default_query\": {","+                    \"route\": \"default\",","+                    \"filter\": {\"old\": \"discarded\"},","+                    \"global\": \"kept\",","+                    \"default_list\": [\"alpha\", \"beta\"],","+                    \"default_absent\": None,","+                },","+            }","+            if provider == \"azure\":","+                common.update(azure_endpoint=\"https://example.invalid/\", api_version=\"test-version\")","+                # Azure's required fields win even if omitted by this request.","+                actual_query: Query = {**query, \"api-version\": omit, \"deployment\": \"wrong\"}","+            else:","+                actual_query = query","+            if mode == \"sync\":","+                cls = OpenAI if provider == \"openai\" else AzureOpenAI","+                with cls(**common) as client:","+                    with connect(client, product, actual_query) as connection:","+                        assert connection.recv_bytes() == wire"],"additions":128,"deletions":0,"truncated":false}],"additions":266,"deletions":127,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-10-22T13:45:38.422687+00:00"}