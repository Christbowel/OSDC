lable while a compilation pass is updating it';","+","+function assertPluginStack(error, method, caller) {","+  assert(error instanceof Error);","+  const lines = error.stack.split('\\n');","+  const apiFrame = lines.findIndex((line) =>","+    line.startsWith(`    at ${method} (`),","+  );","+  const pluginFrame = lines.findIndex(","+    (line) =>","+      line.includes(caller) &&","+      /^\\s+at .*[/\\\\]module-graph-stack\\.mjs:\\d+:\\d+\\)$/.test(line),","+  );","+  assert(apiFrame > 0 && pluginFrame > apiFrame, error.stack);","+}","+","+function assertGraphError(method, message, fn) {","+  assert.throws(fn, (error) => {","+    assertPluginStack(error, method, fn.name);","+    assert.equal(error.message, message);","+    return true;","+  });","+}","+","+/** @type {import('@rspack/test-tools').TCompilerCaseConfig[]} */","+export default [","+  {","+    description:","+      'should throw catchable graph errors with the plugin stack during make',","+    async compiler(_, compiler) {","+      let checkedBuildModule = false;","+      compiler.hooks.thisCompilation.tap('ModuleGraphStack', (compilation) => {","+        compilation.hooks.buildModule.tap('ModuleGraphStack', (module) => {","+          const { moduleGraph } = compilation;","+          assertGraphError(","+            'ModuleGraph.getIssuer',","+            moduleGraphUnavailable,","+            function readIssuerDuringMake() {","+              moduleGraph.getIssuer(module);","+            },","+          );","+          assertGraphError(","+            'Entries.get',","+            moduleGraphUnavailable,","+            function readEntryDuringMake() {","+              compilation.entries.get('main');","+            },","+          );","+          checkedBuildModule = true;"],"additions":54,"deletions":0,"truncated":false}],"additions":236,"deletions":147,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-25T18:23:38.208829+00:00"}