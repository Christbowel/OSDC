s/models\"","+import type {OutputBackend} from \"@bokehjs/core/enums\"","+","+describe(\"Arrowhead angle overrides\", () => {","+  for (const Head of [NormalHead, OpenHead, TeeHead, VeeHead]) {","+    it(`should keep a fixed screen orientation for ${Head.name}`, async () => {","+      function plot(angle: number | null, output_backend: OutputBackend) {","+        const p = fig([220, 220], {","+          x_range: [-1, 5], y_range: [-1, 6], output_backend,","+          title: angle == null ? \"Automatic\" : `Fixed angle: ${output_backend}`,","+        })","+        const head = Head.create({size: 20})","+        const renderer = p.segment({","+          x0: [0, 0, 0], y0: [1, 3, 5],","+          x1: [4, 4, 4], y1: [1, 4, 3],","+          line_color: \"navy\", line_width: 2, level: \"annotation\",","+        })","+        for (const node of [\"start\", \"end\"] as const) {","+          renderer.add_path_decoration(head, {node, angle: angle ?? 0, angle_reference: angle == null ? \"auto\" : \"screen\"})","+        }","+        return p","+      }","+","+      await display(row([plot(null, \"canvas\"), plot(0, \"canvas\"), plot(0, \"svg\")]))","+    })","+  }","+","+  for (const output_backend of [\"canvas\", \"svg\"] as const) {","+    it(`should orient zero-length tee caps in ${output_backend}`, async () => {","+      const p = fig([300, 220], {","+        x_range: [0, 3], y_range: [0, 3], output_backend,","+      })","+      for (const [x, angle] of [[1, 0], [2, -Math.PI/2]]) {","+        const renderer = p.segment({x0: x, y0: 1.5, x1: x, y1: 1.5, line_alpha: 0, level: \"annotation\"})","+        renderer.add_path_decoration(TeeHead.create({size: 30, line_width: 3}), {node: \"end\", angle, angle_reference: \"screen\"})","+      }","+      await display(p)","+    })","+  }","+})"],"additions":41,"deletions":0,"truncated":false},{"path":"bokehjs/test/unit/models/annotations/arrow_head.ts","lines":["@@ -0,0 +1,68 @@","+import * as sinon from \"sinon\"","+import {expect} from \"#framework/assertions\"","+import {restorable} from \"#framework/util\"","+import {create_glyph_view} from \"../glyphs/_util\"","+import {NormalHead} from \"@bokehjs/models/annotations/arrow_head\"","+import {Segment} from \"@bokehjs/models/glyphs/segment\"","+import {MultiLine} from \"@bokehjs/models/glyphs/multi_line\"","+import {Arc} from \"@bokehjs/models/glyphs/arc\"","+import {PathMarking, PathMarkings} from \"@bokehjs/models/graphics/decoration\"","+import {hit_decoration, path_segments, position_decoration} from \"@bokehjs/models/glyphs/decorated_path\"","+","+describe(\"Arrowhead angle overrides\", () => {","+  it(\"should resolve field angles in degrees for each path\", async () => {","+    const decoration = PathMarking.create({","+      node: \"end\", marking: NormalHead.create(), angle: {field: \"rotation\", units: \"deg\"},","+    })","+    const data = {x0: [0, 0], y0: [0, 1], x1: [100, 100], y1: [0, 1], rotation: [0, 90]}","+    const view = await create_glyph_view(Segment.create({decorations: [decoration]}), data)","+    const placement = view.decorations.get(decoration)!","+    expect(placement.resolve_angle(0, Math.PI/2, Math.PI/2)).to.be.equal(Math.PI/2)","+    expect(Math.abs(placement.resolve_angle(1, Math.PI/2, Math.PI/2)) < 1e-6).to.be.true","+    expect(placement.shaft_inset(0)).to.be.equal(25)","+    expect(placement.shaft_inset(1)).to.be.equal(0)","+  })","+","+  for (const [reference, expected] of [[\"left\", 0], [\"right\", Math.PI]] as const) {","+    it(`should orient the ${reference} normal from the forward tangent at a named start`, async () => {","+      const decoration = PathMarking.create({node: \"start\", marking: NormalHead.create(), angle_reference: reference})","+      const view = await create_glyph_view(MultiLine.create({decorations: [decoration]}), {xs: [[0, 100]], ys: [[0, 0]]})","+      const placement = view.decorations.get(decoration)!","+      const segments = path_segments([0, 100], [0, 0])","+      expect(position_decoration(placement, 0, segments, 100).angle).to.be.equal(expected)","+    })","+  }","+","+  for (const [name, create] of [","+    [\"Segment\", (decoration: PathMarking | PathMarkings) => Segment.create({decorations: [decoration]})],","+    [\"MultiLine\", (decoration: PathMarking | PathMarkings) => MultiLine.create({decorations: [decoration]})],","+    [\"Arc\", (decoration: PathMarking | PathMarkings) => Arc.create({decorations: [decoration]})],","+  ] as const) {","+    for (const node of [\"start\", \"end\", 0.25] as const) {","+      it(`should paint the fixed angle at the ${node} of ${name}`, async () => {","+        const marking = NormalHead.create()","+        const decoration = typeof node == \"number\"","+          ? PathMarkings.create({positions: [node], marking, angle_reference: \"screen\", angle: 0.3})","+          : PathMarking.create({node, marking, angle_reference: \"screen\", angle: 0.3})","+        const glyph = create(decoration)","+        const data = glyph instanceof Segment ? {x0: [0], y0: [0], x1: [100], y1: [0]}","+          : glyph instanceof MultiLine ? {xs: [[0, 100]], ys: [[0, 0]]}","+          : {x: [0], y: [0], radius: [100], start_angle: [0], end_angle: [Math.PI]}","+        const view = await create_glyph_view(glyph, data as any)","+        const ctx = view.canvas.create_layer().ctx","+        using rotate = restorable(sinon.spy(ctx, \"rotate\"))","+        view.paint(ctx, new Int32Array([0]))","+        sinon.assert.calledWithExactly(rotate, -0.3)","+      })","+    }","+  }","+","+  it(\"should hit the head at its overridden orientation\", async () => {","+    const decoration = PathMarking.create({node: \"end\", marking: NormalHead.create({size: 20}), angle_reference: \"screen\"})","+    const view = await create_glyph_view(MultiLine.create({decorations: [decoration]}), {xs: [[0, 100]], ys: [[0, 0]]})","+    const marking = view.decorations.get(decoration)!","+    const segments = path_segments([0, 100], [0, 0])","+    expect(hit_decoration({x: 100, y: 10}, marking, 0, segments)).to.be.equal(0)","+    expect(hit_decoration({x: 90, y: 0}, marking, 0, segments)).to.be.null","+  })","+})"],"additions":68,"deletions":0,"truncated":false},{"path":"docs/bokeh/source/docs/user_guide/basic/annotations.rst","lines":["@@ -488,6 +488,29 @@ later, for example with ``decoration.inset = 10``. Decorations can also be added"," or removed after display, and replacing ``decoration.marking`` rebuilds its"," head view. These changes work through server document patches as well."," ","+Set a path marking's ``angle`` to rotate it counterclockwise around its anchor.","+The default ``angle_reference=\"auto\"`` uses the usual path orientation.","+Use ``\"left\"`` or ``\"right\"`` to start from the corresponding normal to the","+forward screen-space tangent, or ``\"screen\"`` to measure from straight up.","+The angle can be a fixed value or a source field. It defaults to zero radians.","+Only unrotated automatic placements trim the shaft.","+","+.. code-block:: python","+","+    from math import pi","+    from bokeh.models import NormalHead","+","+    renderer = plot.segment(0, 0, 1, 1)","+    renderer.add_path_decoration(","+        NormalHead(), node=\"end\", angle_reference=\"screen\", angle=-pi/2,","+    )","+","+The dot marks the start of the curve in each panel. The left and right","+normals point in opposite directions at the same positions.","+","+.. bokeh-plot:: __REPO__/examples/basic/annotations/path_marking_angles.py","+    :source-position: above","+"," Arrow endpoints use data coordinates. Arrowhead size, visuals, and decoration"," ``inset`` can refer to fields in the"," renderer's data source. Size and inset are measured in screen pixels. Head"],"additions":23,"deletions":0,"truncated":false},{"path":"examples/basic/annotations/path_marking_angles.py","lines":["@@ -0,0 +1,48 @@","+''' Compare arrowhead directions along a curve.","+","+.. bokeh-example-metadata::","+    :apis: bokeh.models.PathMarking, bokeh.models.GlyphRenderer.add_path_markings","+    :refs: :ref:`ug_basic_annotations_path_markings`","+    :keywords: arrowheads, paths, angles","+","+'''","+from math import pi, sin, tau","+","+from bokeh.layouts import column, row","+from bokeh.models import NormalHead","+from bokeh.plotting import figure, show","+","+x = [i / 24 for i in range(241)]","+y = [1.65 * sin(tau * (xi / 10 - 0.12)) for xi in x]","+positions = [0.17, 0.34, 0.51, 0.68, 0.85]","+","+","+def panel(title):","+    p = figure(width=335, height=205, title=title, x_range=(-0.6, 10.6),","+               y_range=(-2.65, 2.65), toolbar_location=None, tools=\"\")","+    p.title.text_font_size = \"14px\"","+    p.title.text_color = \"#1e293b\"","+    p.title.offset = 8","+    p.axis.visible = False","+    p.grid.visible = False","+    p.outline_line_color = \"#dbe3ed\"","+    p.min_border = 12","+    renderer = p.line(x, y, line_width=2.5, line_color=\"#64748b\")","+    p.scatter([x[0]], [y[0]], marker=\"circle\", size=6, color=\"#64748b\")","+    return p, renderer","+","+","+panels = []","+for title, reference, angle, color in [","+    (\"Auto · along the path\", \"auto\", 0, \"#334155\"),","+    (\"Left · normal to the path\", \"left\", 0, \"#0f766e\"),","+    (\"Right · normal to the path\", \"right\", 0, \"#b45309\"),","+    (\"Screen · fixed up\", \"screen\", 0, \"#2563eb\"),","+    (\"Auto + 30° · relative rotation\", \"auto\", pi / 6, \"#7c3aed\"),","+]:","+    p, renderer = panel(title)","+    head = NormalHead(size=15, fill_color=color, line_color=color)","+    renderer.add_path_markings(head, positions=positions, angle_reference=reference, angle=angle)","+    panels.append(p)","+","+show(column(row(*panels[:3]), row(*panels[3:])))"],"additions":48,"deletions":0,"truncated":false},{"path":"src/bokeh/core/enums.py","lines":["@@ -89,6 +89,7 @@ class MyModel(Model):","     'Align',","     'AlternationPolicy',","     'Anchor',","+    'AngleReference',","     'AngleUnits',","     'Auto',","     'AutosizeMode',","@@ -306,6 +307,10 @@ def _string_enumeration(alias: TypeAliasType, *, case_sensitive: bool = True, qu"," #: Specify an anchor position on a box/frame."," Anchor = _string_enumeration(AnchorType)"," ","+type AngleReferenceType = Literal[\"auto\", \"left\", \"right\", \"screen\"]","+#: Specify the reference direction for a path marking angle.","+AngleReference = _string_enumeration(AngleReferenceType)","+"," type AngleUnitsType = Literal[\"deg\", \"rad\", \"grad\", \"turn\"]"," #: Specify the units for an angle value."," AngleUnits = _string_enumeration(AngleUnitsType)"],"additions":5,"deletions":0,"truncated":false},{"path":"src/bokeh/models/graphics.py","lines":["@@ -18,13 +18,15 @@"," # Imports"," #-----------------------------------------------------------------------------"," ","+from ..core.enums import AngleReference"," from ..core.has_props import abstract"," from ..core.property.container import List","-from ..core.property.dataspec import DataSpec, NumberSpec","+from ..core.property.dataspec import AngleSpec, DataSpec, NumberSpec"," from ..core.property.enum import Enum"," from ..core.property.instance import Instance"," from ..core.property.numeric import Percent"," from ..core.property.required import Required","+from ..core.property_aliases import AngleUnits"," from ..model import Model"," "," #-----------------------------------------------------------------------------","@@ -82,6 +84,19 @@ class PathMarking(Decoration):","     This can be a fixed value or a field in the glyph renderer's data source.","     \"\"\")"," ","+    angle = AngleSpec(default=0, help=\"\"\"","+    Counterclockwise rotation from the direction selected by angle_reference.","+    A source field can supply a different angle for each path.","+    \"\"\")","+","+    angle_units = AngleUnits","+","+    angle_reference = Enum(AngleReference, help=\"\"\"","+    The direction before applying angle. Auto uses the usual placement direction.","+    Left and right use the normals to the forward screen-space tangent.","+    Screen points up.","+    \"\"\")","+"," "," class PathMarkings(Decoration):","     \"\"\"Repeated fractional markings along each path.\"\"\"","@@ -95,3 +110,16 @@ class PathMarkings(Decoration):","     subpath, without inset or shaft trimming. Fractions 0 and 1 retain this","     behavior and are not aliases for named endpoints. Visuals resolve per path.","     \"\"\")","+","+    angle = AngleSpec(default=0, help=\"\"\"","+    Counterclockwise rotation from the direction selected by angle_reference.","+    A source field can supply a different angle for each path.","+    \"\"\")","+","+    angle_units = AngleUnits","+","+    angle_reference = Enum(AngleReference, help=\"\"\"","+    The direction before applying angle. Auto uses the usual placement direction.","+    Left and right use the normals to the forward screen-space tangent.","+    Screen points up.","+    \"\"\")"],"additions":29,"deletions":1,"truncated":false},{"path":"src/bokeh/models/graphics.pyi","lines":["@@ -8,7 +8,11 @@"," from abc import abstractmethod"],"additions":0,"deletions":0,"truncated":false}],"additions":394,"deletions":9,"truncated":true,"file_count":26},"error":null,"fetched_at":"2026-11-12T17:13:29.772452+00:00"}