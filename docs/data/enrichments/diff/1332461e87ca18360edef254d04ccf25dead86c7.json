{"id":"1332461e87ca18360edef254d04ccf25dead86c7","axis":"silent","repo":"pnpm/pnpm","sha":"1332461e87ca18360edef254d04ccf25dead86c7","parsed":{"files":[{"path":".changeset/cross-version-workspace-settings.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/config.reader\": patch","+\"pnpm\": patch","+---","+","+The warning about unrecognized settings in `pnpm-workspace.yaml` and the global `config.yaml` now names `addMissingPeerTypes`, `autoDedupe`, `bootConfig`, `macosBackup`, `nodePackageMap`, `permissions`, `pipelineBase`, `publishWaitTimeout`, `python`, `remoteCache`, `saveTypes`, `skills`, `storeIndexFormat`, and `tools` as pnpm v12 settings [pnpm/tasks#167](https://github.com/pnpm/tasks/issues/167)."],"additions":6,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/known_settings.rs","lines":["@@ -49,7 +49,7 @@ const TYPED_WORKSPACE_MANIFEST_KEYS: &[&str] = &[","     \"requiredScripts\",","     \"sideEffectsCache\",","     \"supportedArchitectures\",","-    \"tools\",","+    \"tasks\",","     \"update\",","     \"updateConfig\",","     \"versioning\",","@@ -76,6 +76,7 @@ const CONFIG_ONLY_SETTING_KEYS: &[&str] = &[","     \"ignoreCurrentSpecifiers\",","     \"maxSockets\",","     \"minimumReleaseAgeExcludePrune\",","+    \"modulesDirsByProjectName\",","     \"packageConfigs\",","     \"packageManagerNetworkConfig\",","     \"packageManagerRegistries\","],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/known_settings/tests.rs","lines":["@@ -1,4 +1,11 @@","-use super::{annotate_unknown_setting, is_known_setting_key};","+use super::{","+    CONFIG_ONLY_SETTING_KEYS, SETTINGS_OF_OTHER_PNPM_VERSIONS, TYPED_WORKSPACE_MANIFEST_KEYS,","+    UNTYPED_WORKSPACE_SETTING_KEYS, annotate_unknown_setting, is_known_setting_key,","+    settings_field_keys,","+};","+use crate::naming_cases::to_camel_case;","+use pretty_assertions::assert_eq;","+use std::collections::BTreeSet;"," "," #[test]"," fn recognizes_type_keys_in_both_spellings() {","@@ -16,6 +23,8 @@ fn recognizes_structured_and_config_only_keys() {","     assert!(is_known_setting_key(\"executionEnv\"));","     assert!(is_known_setting_key(\"autoInstallPeersFromHighestMatch\"));","     assert!(is_known_setting_key(\"externalDependencies\"));","+    assert!(is_known_setting_key(\"modulesDirsByProjectName\"));","+    assert!(is_known_setting_key(\"tasks\"));"," }"," "," /// `globalShims` has no entry in the mirrored pnpm lists; it must enter","@@ -24,6 +33,7 @@ fn recognizes_structured_and_config_only_keys() {"," fn recognizes_pacquet_only_settings_via_the_struct_fields() {","     assert!(is_known_setting_key(\"globalShims\"));","     assert!(is_known_setting_key(\"cargo\"));","+    assert!(is_known_setting_key(\"tools\"));"," }"," "," #[test]","@@ -52,3 +62,111 @@ fn annotates_a_setting_from_another_pnpm_version() {"," fn annotates_an_unmatchable_key_bare() {","     assert_eq!(annotate_unknown_setting(\"zzzXqjWv\"), r#\"\"zzzXqjWv\"\"#);"," }","+","+fn read_reader_source(file: &str) -> String {","+    let path = format!(\"{}/../../../pnpm11/config/reader/src/{file}\", env!(\"CARGO_MANIFEST_DIR\"));","+    std::fs::read_to_string(&path).unwrap_or_else(|err| panic!(\"failed to read {path}: {err}\"))","+}","+","+fn block_between<'a>(source: &'a str, header: &str, footer: &str) -> &'a str {","+    source","+        .split_once(header)","+        .and_then(|(_, rest)| rest.split_once(footer))","+        .map_or_else(|| panic!(\"missing block `{header}`\"), |(body, _)| body)","+}","+","+fn quoted_array_items<'a>(source: &'a str, declaration: &str) -> Vec<&'a str> {","+    block_between(source, declaration, \"]\")","+        .lines()","+        .filter_map(|line| {","+            line.trim()","+                .strip_prefix('\\'')?","+                .strip_suffix(\"',\")","+        })","+        .collect()","+}","+","+fn ts_object_keys<'a>(source: &'a str, declaration: &str) -> Vec<&'a str> {","+    block_between(source, declaration, \"\\n}\")","+        .lines()","+        .filter_map(|line| {","+            let trimmed = line.trim();","+            if trimmed.is_empty() || trimmed.starts_with(\"//\") || trimmed.starts_with('*') {","+                return None;","+            }","+            let (key, _) = trimmed.split_once(':')?;","+            Some(key.trim().trim_matches('\\''))","+        })","+        .collect()","+}","+","+#[test]","+fn mirrored_lists_and_workspace_settings_match_unknown_settings_ts() {","+    let unknown_settings_ts = read_reader_source(\"unknownSettings.ts\");","+    let types_ts = read_reader_source(\"types.ts\");","+    let npm_config_types_ts = read_reader_source(\"npmConfigTypes.ts\");","+","+    let ts_typed =","+        quoted_array_items(&unknown_settings_ts, \"const TYPED_WORKSPACE_MANIFEST_KEYS = [\");","+    let ts_config_only =","+        quoted_array_items(&unknown_settings_ts, \"const CONFIG_ONLY_SETTING_KEYS = [\");","+    let ts_untyped =","+        quoted_array_items(&unknown_settings_ts, \"const UNTYPED_WORKSPACE_SETTING_KEYS = [\");","+","+    assert_eq!(TYPED_WORKSPACE_MANIFEST_KEYS, ts_typed.as_slice());","+    assert_eq!(CONFIG_ONLY_SETTING_KEYS, ts_config_only.as_slice());","+","+    let mut rust_untyped_and_v11: Vec<&str> = UNTYPED_WORKSPACE_SETTING_KEYS","+        .iter()","+        .copied()","+        .chain(SETTINGS_OF_OTHER_PNPM_VERSIONS.iter().map(|(key, _)| *key))","+        .collect();","+    rust_untyped_and_v11.sort_unstable();","+    assert_eq!(rust_untyped_and_v11, ts_untyped);","+","+    let v11_known_keys: BTreeSet<String> = ts_typed","+        .into_iter()","+        .chain(ts_config_only)","+        .chain(ts_untyped)","+        .map(str::to_string)","+        .chain(","+            ts_object_keys(&types_ts, \"export const pnpmTypes = {\")","+                .into_iter()","+                .chain(ts_object_keys(&npm_config_types_ts, \"export const npmConfigTypes = {\"))","+                .map(to_camel_case),","+        )","+        .collect();","+","+    let v11_other_versions: BTreeSet<String> = ts_object_keys(","+        &unknown_settings_ts,","+        \"const SETTINGS_OF_OTHER_PNPM_VERSIONS: Record<string, string> = {\",","+    )","+    .into_iter()","+    .map(str::to_string)","+    .collect();","+","+    let overlap: Vec<&String> = v11_known_keys.intersection(&v11_other_versions).collect();","+    assert_eq!(","+        overlap,","+        Vec::<&String>::new(),","+        \"keys in both KNOWN_SETTING_KEYS and SETTINGS_OF_OTHER_PNPM_VERSIONS\",","+    );","+","+    for key in &v11_other_versions {","+        assert!(","+            is_known_setting_key(key),","+            \"{key} is listed in unknownSettings.ts SETTINGS_OF_OTHER_PNPM_VERSIONS but is not known to v12\",","+        );","+    }","+","+    let unclassified: Vec<&String> = settings_field_keys()","+        .iter()","+        .filter(|key| key.as_str() != \"_auth\")","+        .filter(|key| !v11_known_keys.contains(*key) && !v11_other_versions.contains(*key))","+        .collect();","+    assert_eq!(","+        unclassified,","+        Vec::<&String>::new(),","+        \"WorkspaceSettings fields missing from both KNOWN_SETTING_KEYS and SETTINGS_OF_OTHER_PNPM_VERSIONS in unknownSettings.ts\",","+    );","+}"],"additions":119,"deletions":1,"truncated":false},{"path":"pnpm/scripts/test-affected.mjs","lines":["@@ -32,6 +32,7 @@ const WORKSPACE_WIDE = [","  */"," const EXTERNAL_TEST_INPUTS = [","   { prefix: 'fixtures/', packages: ['pnpm-deps-restorer'] },","+  { prefix: 'pnpm11/config/reader/src/', packages: ['pnpm-config'] },","   { prefix: 'pnpm11/installing/deps-installer/test/fixtures/patch-pkg/', packages: ['pnpm-cli'] },","   { prefix: 'pnpm11/deps/compliance/commands/test/sbom/fixtures/', packages: ['pnpm-cli'] },"," ]"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/scripts/test-affected.test.mjs","lines":["@@ -15,6 +15,7 @@ function repoWithOneCommit (context) {"," "," const manifests = [","   { name: 'pnpm-cli', dir: 'pnpm/crates/cli' },","+  { name: 'pnpm-config', dir: 'pnpm/crates/config' },","   { name: 'pnpm-lockfile', dir: 'pnpm/crates/lockfile' },","   { name: 'pnpm-registry-mock', dir: 'pnpm/tasks/registry-mock' },","   { name: 'pnpr', dir: 'pnpr/crates/pnpr' },","@@ -45,6 +46,7 @@ test('prefers the closest crate for a nested manifest', () => {"," "," test('selects the crates that read a fixture stored outside them', () => {","   assert.deepEqual(selectPackages(['fixtures/gvs-link-hash-parity.json'], manifests), ['pnpm-deps-restorer'])","+  assert.deepEqual(selectPackages(['pnpm11/config/reader/src/unknownSettings.ts'], manifests), ['pnpm-config'])","   assert.deepEqual(","     selectPackages(['pnpm11/installing/deps-installer/test/fixtures/patch-pkg/is-positive@1.0.0.patch'], manifests),","     ['pnpm-cli'])"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm11/config/reader/src/unknownSettings.ts","lines":["@@ -151,10 +151,24 @@ export function isKnownSettingKey (key: string): boolean {","  * this repository, so a line-exclusive setting is known at build time.","  */"," const SETTINGS_OF_OTHER_PNPM_VERSIONS: Record<string, string> = {","+  addMissingPeerTypes: 'pnpm v12',","+  autoDedupe: 'pnpm v12',","+  bootConfig: 'pnpm v12',","   cargo: 'pnpm v12',","   concurrencyGroups: 'pnpm v12',","   globalShims: 'pnpm v12',","+  macosBackup: 'pnpm v12',","+  nodePackageMap: 'pnpm v12',","+  permissions: 'pnpm v12',","+  pipelineBase: 'pnpm v12',","   pipelines: 'pnpm v12',","+  publishWaitTimeout: 'pnpm v12',","+  python: 'pnpm v12',","+  remoteCache: 'pnpm v12',","+  saveTypes: 'pnpm v12',","+  skills: 'pnpm v12',","+  storeIndexFormat: 'pnpm v12',","+  tools: 'pnpm v12',"," }"," "," const KNOWN_SETTING_KEYS_LIST = [...KNOWN_SETTING_KEYS]"],"additions":14,"deletions":0,"truncated":false},{"path":"pnpm11/config/reader/test/unknownSettings.test.ts","lines":["@@ -1,12 +1,58 @@","+import fs from 'node:fs'","+"," import { expect, test } from '@jest/globals'","+import camelcase from 'camelcase'"," ","-import { quoteAndAnnotateUnknown } from '../lib/unknownSettings.js'","+import { isKnownSettingKey, quoteAndAnnotateUnknown } from '../lib/unknownSettings.js'"," "," test('quoteAndAnnotateUnknown() names the pnpm version that reads a setting this one does not', () => {","-  expect(quoteAndAnnotateUnknown(['cargo', 'concurrencyGroups', 'globalShims', 'pipelines']))","-    .toBe('\"cargo\" (a pnpm v12 setting), \"concurrencyGroups\" (a pnpm v12 setting), \"globalShims\" (a pnpm v12 setting), \"pipelines\" (a pnpm v12 setting)')","+  const v12Settings = [","+    'addMissingPeerTypes',","+    'autoDedupe',","+    'bootConfig',","+    'cargo',","+    'concurrencyGroups',","+    'globalShims',","+    'macosBackup',","+    'nodePackageMap',","+    'permissions',","+    'pipelineBase',","+    'pipelines',","+    'publishWaitTimeout',","+    'python',","+    'remoteCache',","+    'saveTypes',","+    'skills',","+    'storeIndexFormat',","+    'tools',","+  ]","+  expect(v12Settings.filter(isKnownSettingKey)).toEqual([])","+  expect(quoteAndAnnotateUnknown(v12Settings))","+    .toBe(v12Settings.map((key) => `\"${key}\" (a pnpm v12 setting)`).join(', '))"," })"," "," test('quoteAndAnnotateUnknown() suggests a setting of this version for a typo', () => {","   expect(quoteAndAnnotateUnknown(['storeDur'])).toBe('\"storeDur\" (did you mean \"storeDir\"?)')"," })","+","+test('every WorkspaceSettings field is recognized or annotated as a pnpm v12 setting', () => {","+  const settingsRs = fs.readFileSync(","+    new URL('../../../../pnpm/crates/config/src/workspace_yaml/settings.rs', import.meta.url),","+    'utf8'","+  )","+  const structBody = settingsRs.split('pub struct WorkspaceSettings {')[1].split('\\n}')[0]","+  const skippedFields = new Set(['auth', 'key_issues', 'includes'])","+  const fields = structBody","+    .split('\\n')","+    .map((line) => line.trim())","+    .filter((line) => line.startsWith('pub '))","+    .map((line) => line.slice('pub '.length).split(':')[0].trim())","+    .filter((field) => !skippedFields.has(field))","+    .map((field) => camelcase(field, { locale: 'en-US' }))","+","+  expect(fields.length).toBeGreaterThan(0)","+  for (const key of fields) {","+    if (isKnownSettingKey(key)) continue","+    expect(quoteAndAnnotateUnknown([key])).toBe(`\"${key}\" (a pnpm v12 setting)`)","+  }","+})",""],"additions":49,"deletions":3,"truncated":false}],"additions":193,"deletions":5,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-21T13:27:22.633820+00:00"}