f ($apiKey !== null && !$apiKey->mayCreate(API_KEY_STANDARD, $scopes, $expire)) {","+            throw new Exception(Exception::KEY_CREATION_DENIED);","+        }","+","         $key = $authorization->skip(fn () => $dbForPlatform->getDocument('keys', $keyId));"," ","         if ($key->isEmpty() || $key->getAttribute('resourceType', '') !== 'projects' || $key->getAttribute('resourceInternalId', '') !== $project->getSequence()) {"],"additions":8,"deletions":0,"truncated":false},{"path":"tests/e2e/Services/Organization/KeysBase.php","lines":["@@ -4,6 +4,7 @@"," "," use Appwrite\\Tests\\Async;"," use Tests\\E2E\\Client;","+use Utopia\\Database\\DateTime;"," use Utopia\\Database\\Document;"," use Utopia\\Database\\Id;"," use Utopia\\Database\\Query;","@@ -915,6 +916,84 @@ public function testGetKeySecretRequiresWriteScope(): void","         $this->deleteKey($keyId);","     }"," ","+    /**","+     * A key hands out nothing beyond its own grant: no scope it does not hold,","+     * no expiry past its own. Otherwise a narrow or expiring key could widen or","+     * renew itself through the keys it creates or changes.","+     */","+    public function testKeysStayWithinTheirCallersGrant(): void","+    {","+        $delegate = $this->createEphemeralKey(['keys.read', 'keys.write', 'users.read'], 600);","+        $this->assertSame(201, $delegate['headers']['status-code']);","+","+        $asDelegate = [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $delegate['body']['secret'],","+        ];","+","+        $key = $this->createKey(Id::unique(), 'Delegated Key', ['users.read']);","+        $this->assertSame(201, $key['headers']['status-code']);","+        $keyId = $key['body']['$id'];","+","+        /**","+         * Test for SUCCESS","+         */","+        $ephemeral = $this->client->call(Client::METHOD_POST, $this->keysPath() . '/ephemeral', $asDelegate, [","+            'scopes' => ['users.read'],","+            'duration' => 60,","+        ]);","+        $this->assertSame(201, $ephemeral['headers']['status-code']);","+","+        $updated = $this->client->call(Client::METHOD_PUT, $this->keysPath() . '/' . $keyId, $asDelegate, [","+            'name' => 'Delegated Key',","+            'scopes' => ['users.read'],","+            'expire' => DateTime::addSeconds(new \\DateTime(), 300),","+        ]);","+        $this->assertSame(200, $updated['headers']['status-code']);","+","+        /**","+         * Test for FAILURE","+         */","+        $refused = [","+            'ephemeral key with a scope the caller lacks' => [Client::METHOD_POST, $this->keysPath() . '/ephemeral', ['scopes' => ['users.write'], 'duration' => 60]],","+            'ephemeral key that outlives the caller' => [Client::METHOD_POST, $this->keysPath() . '/ephemeral', ['scopes' => ['users.read'], 'duration' => 3600]],","+            'key widened past the caller' => [Client::METHOD_PUT, $this->keysPath() . '/' . $keyId, ['name' => 'Delegated Key', 'scopes' => ['users.read', 'users.write']]],","+            'key made to never expire' => [Client::METHOD_PUT, $this->keysPath() . '/' . $keyId, ['name' => 'Delegated Key', 'scopes' => ['users.read']]],","+            'key made to expire after the caller' => [Client::METHOD_PUT, $this->keysPath() . '/' . $keyId, ['name' => 'Delegated Key', 'scopes' => ['users.read'], 'expire' => DateTime::addSeconds(new \\DateTime(), 3600)]],","+        ];","+","+        foreach ($refused as $case => [$method, $path, $params]) {","+            $response = $this->client->call($method, $path, $asDelegate, $params);","+            $this->assertSame(403, $response['headers']['status-code'], $case);","+            $this->assertSame('key_creation_denied', $response['body']['type'], $case);","+        }","+","+        $unchanged = $this->getKey($keyId);","+        $this->assertSame(['users.read'], $unchanged['body']['scopes']);","+        $this->assertNotNull($unchanged['body']['expire']);","+","+        // A stored key with keys.write cannot widen itself either","+        $writer = $this->createKey(Id::unique(), 'Self Widening Key', ['keys.write', 'users.read']);","+        $this->assertSame(201, $writer['headers']['status-code']);","+","+        $widened = $this->client->call(Client::METHOD_PUT, $this->keysPath() . '/' . $writer['body']['$id'], [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $writer['body']['secret'],","+        ], [","+            'name' => 'Self Widening Key',","+            'scopes' => ['keys.write', 'users.read', 'users.write', 'databases.write'],","+        ]);","+        $this->assertSame(403, $widened['headers']['status-code']);","+        $this->assertSame('key_creation_denied', $widened['body']['type']);","+        $this->assertSame(['keys.write', 'users.read'], $this->getKey($writer['body']['$id'])['body']['scopes']);","+","+        // Cleanup","+        $this->deleteKey($keyId);","+        $this->deleteKey($writer['body']['$id']);","+    }","+","     /**","      * A JWT stands in for its session for minutes. Like it cannot create the next","      * JWT, it cannot create or change keys, or read their secrets."],"additions":79,"deletions":0,"truncated":false},{"path":"tests/e2e/Services/Project/KeysBase.php","lines":["@@ -171,4 +171,82 @@ public function testKeysLifecycle(): void"," ","         $this->client->call(Client::METHOD_DELETE, '/project/keys/' . $keyId, $projectHeaders);","     }","+","+    /**","+     * The project-scoped routes hold keys to their caller's grant like the","+     * organization routes do; see the organization suite for the full matrix.","+     */","+    public function testKeysStayWithinTheirCallersGrant(): void","+    {","+        $projectHeaders = array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders());","+","+        $consoleHeaders = [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'origin' => 'http://localhost',","+            'cookie' => 'a_session_console=' . $this->getRoot()['session'],","+            'x-appwrite-mode' => 'admin',","+        ];","+","+        $writer = $this->client->call(Client::METHOD_POST, '/project/keys', $consoleHeaders, [","+            'keyId' => Id::unique(),","+            'name' => 'Narrow Writer',","+            'scopes' => ['keys.read', 'keys.write', 'users.read'],","+        ]);","+        $this->assertSame(201, $writer['headers']['status-code']);","+","+        $asWriter = [","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'x-appwrite-key' => $writer['body']['secret'],","+        ];","+","+        /**","+         * Test for SUCCESS","+         */","+        $ephemeral = $this->client->call(Client::METHOD_POST, '/project/keys/ephemeral', $asWriter, [","+            'scopes' => ['users.read'],","+            'duration' => 60,","+        ]);","+        $this->assertSame(201, $ephemeral['headers']['status-code']);","+","+        /**","+         * Test for FAILURE","+         */","+        $ephemeral = $this->client->call(Client::METHOD_POST, '/project/keys/ephemeral', $asWriter, [","+            'scopes' => ['users.read', 'users.write'],","+            'duration' => 60,","+        ]);","+        $this->assertSame(403, $ephemeral['headers']['status-code']);","+        $this->assertSame('key_creation_denied', $ephemeral['body']['type']);","+","+        // The writer cannot widen itself","+        $widened = $this->client->call(Client::METHOD_PUT, '/project/keys/' . $writer['body']['$id'], $asWriter, [","+            'name' => 'Narrow Writer',","+            'scopes' => ['keys.read', 'keys.write', 'users.read', 'users.write'],","+        ]);","+        $this->assertSame(403, $widened['headers']['status-code']);","+        $this->assertSame('key_creation_denied', $widened['body']['type']);","+","+        // A JWT cannot create keys at all","+        $jwt = $this->client->call(Client::METHOD_POST, '/account/jwts', $consoleHeaders);","+        $this->assertSame(201, $jwt['headers']['status-code']);","+","+        $asJWT = $consoleHeaders;","+        unset($asJWT['cookie']);","+        $asJWT['x-appwrite-jwt'] = $jwt['body']['jwt'];","+","+        $fromJWT = $this->client->call(Client::METHOD_POST, '/project/keys/ephemeral', $asJWT, [","+            'scopes' => ['users.read'],","+            'duration' => 60,","+        ]);","+        $this->assertSame(403, $fromJWT['headers']['status-code']);","+        $this->assertSame('key_creation_denied', $fromJWT['body']['type']);","+","+        // Cleanup","+        $this->client->call(Client::METHOD_DELETE, '/project/keys/' . $writer['body']['$id'], $projectHeaders);","+    }"," }"],"additions":78,"deletions":0,"truncated":false},{"path":"tests/unit/Auth/KeyTest.php","lines":["@@ -441,6 +441,93 @@ public function testFindSkipsKeysWithoutAStringSecret(): void","         $this->assertSame($valid, Key::find([new Document(), new Document(['secret' => 1234]), $valid], '1234'));","     }"," ","+    public function testDecodeCarriesTheExpiry(): void","+    {","+        $decoded = Key::decode(","+            project: new Document(['$id' => 'test']),","+            team: new Document(),","+            user: new Document(),","+            key: self::generateKey('test', false, ['documents.read'], maxAge: 600),","+        );","+        $this->assertNotNull($decoded->getExpire());","+        $this->assertEqualsWithDelta(\\time() + 600, (new \\DateTimeImmutable($decoded->getExpire()))->getTimestamp(), 5);","+","+        $expire = '2030-01-01T00:00:00.000+00:00';","+        $decoded = Key::decode(","+            project: new Document(['$id' => 'test', 'keys' => [new Document(['$id' => 'k', 'secret' => 'standard_abcd', 'scopes' => [], 'expire' => $expire])]]),","+            team: new Document(),","+            user: new Document(),","+            key: 'standard_abcd',","+        );","+        $this->assertSame($expire, $decoded->getExpire());","+","+        $decoded = Key::decode(","+            project: new Document(['$id' => 'test', 'keys' => [new Document(['$id' => 'k', 'secret' => 'standard_abcd', 'scopes' => [], 'expire' => null])]]),","+            team: new Document(),","+            user: new Document(),","+            key: 'standard_abcd',","+        );","+        $this->assertNull($decoded->getExpire());","+    }","+","+    /**","+     * @return \\Iterator<string, array{string, array<string>, ?string, string, array<string>, ?string, bool}>","+     */","+    public static function creations(): \\Iterator","+    {","+        $soon = '2030-01-01T00:00:00.000+00:00';","+        $later = '2031-01-01T00:00:00.000+00:00';","+        $earlier = '2029-01-01T00:00:00.000+00:00';","+","+        // A key delegates downwards: never a scope it does not hold","+        yield 'standard key mints an ephemeral key with its scopes' => [API_KEY_STANDARD, ['keys.write', 'users.read'], null, API_KEY_EPHEMERAL, ['users.read'], $earlier, true];","+        yield 'standard key mints an ephemeral key with a scope it lacks' => [API_KEY_STANDARD, ['keys.write', 'users.read'], null, API_KEY_EPHEMERAL, ['users.write'], $earlier, false];","+        yield 'standard key widens a key to scopes it lacks' => [API_KEY_STANDARD, ['keys.write', 'users.read'], null, API_KEY_STANDARD, ['users.read', 'databases.write'], null, false];","+        yield 'standard key without expiry sets no expiry' => [API_KEY_STANDARD, ['keys.write', 'users.read'], null, API_KEY_STANDARD, ['users.read'], null, true];","+","+        // ... and never past its own expiry, so it cannot renew itself","+        yield 'ephemeral key mints one that expires after it' => [API_KEY_EPHEMERAL, ['keys.write'], $soon, API_KEY_EPHEMERAL, [], $later, false];","+        yield 'ephemeral key mints one that expires with it' => [API_KEY_EPHEMERAL, ['keys.write'], $soon, API_KEY_EPHEMERAL, [], $soon, true];","+        yield 'expiring standard key sets no expiry' => [API_KEY_STANDARD, ['keys.write'], $soon, API_KEY_STANDARD, [], null, false];","+        yield 'dynamic key mints one that expires after it' => ['dynamic', ['keys.write'], $soon, API_KEY_EPHEMERAL, [], $later, false];","+        yield 'expiring account key creates one that never expires' => [API_KEY_ACCOUNT, ['account'], $soon, API_KEY_ACCOUNT, ['account'], null, false];","+        yield 'account key creates one with a scope it lacks' => [API_KEY_ACCOUNT, ['account'], null, API_KEY_ACCOUNT, ['account', 'teams.write'], null, false];","+        yield 'organization key widens an organization key' => [API_KEY_ORGANIZATION, ['organization.keys.write'], null, API_KEY_ORGANIZATION, ['organization.keys.write', 'organization.write'], null, false];","+","+        // Organization keys provision project keys, within their own lifetime","+        yield 'organization creates project key with project scopes' => [API_KEY_ORGANIZATION, ['organization.projects.keys.write'], null, API_KEY_STANDARD, ['databases.write'], null, true];","+        yield 'expiring organization key creates a key that never expires' => [API_KEY_ORGANIZATION, ['organization.projects.keys.write'], $soon, API_KEY_STANDARD, ['databases.write'], null, false];","+        yield 'expiring organization key creates a key that expires later' => [API_KEY_ORGANIZATION, ['organization.projects.keys.write'], $soon, API_KEY_STANDARD, [], $later, false];","+        yield 'expiring organization key creates a key that expires with it' => [API_KEY_ORGANIZATION, ['organization.projects.keys.write'], $soon, API_KEY_STANDARD, [], $soon, true];","+        yield 'expiring organization key creates a key that expires sooner' => [API_