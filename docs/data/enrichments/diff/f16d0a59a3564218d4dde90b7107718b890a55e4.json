 body', async (t) => {"," ","   await t.completed"," })","+","+// Fails the test instead of hanging it when the promise does not settle.","+function settlesWithin (promise, ms = 2000) {","+  let timer","+  return Promise.race([","+    promise,","+    new Promise((resolve, reject) => {","+      timer = setTimeout(() => reject(new Error(`still pending after ${ms}ms`)), ms)","+    })","+  ]).finally(() => clearTimeout(timer))","+}","+","+// '/hold' responses wait until release() is called, routes answer their own","+// paths, everything else answers 'ok'.","+async function startServer (t, routes = {}) {","+  const held = []","+  let connections = 0","+  const server = createServer((req, res) => {","+    if (req.url === '/hold') {","+      held.push(res)","+    } else if (routes[req.url]) {","+      routes[req.url](req, res)","+    } else {","+      res.end('ok')","+    }","+  })","+  server.on('connection', () => { connections++ })","+  server.listen(0)","+  await once(server, 'listening')","+  t.after(() => {","+    for (const res of held) res.destroy()","+    server.closeAllConnections?.()","+    server.close()","+  })","+  return {","+    origin: `http://localhost:${server.address().port}`,","+    connections: () => connections,","+    waitForHeld: async (n = 1) => {","+      while (held.length < n) await new Promise(resolve => setImmediate(resolve))","+    },","+    release: () => {","+      for (const res of held.splice(0)) res.end('released')","+    }","+  }","+}","+","+// A connector that never completes, e.g. a TLS handshake that hangs.","+function hangingConnector () {","+  const sockets = []","+  const connect = (opts, callback) => {","+    connect.calls++","+    const socket = new net.Socket()","+    sockets.push(socket)","+  }","+  connect.calls = 0","+  connect.destroy = () => { for (const s of sockets) s.destroy() }","+  return connect","+}","+","+test('a request aborted in the Pool queue rejects at once', async (t) => {","+  const server = await startServer(t)","+  const pool = new Pool(server.origin, { connections: 1 })","+  t.after(() => pool.destroy())","+","+  const first = pool.request({ path: '/hold', method: 'GET' })","+  await server.waitForHeld()","+","+  const ac = new AbortController()","+  const second = pool.request({ path: '/', method: 'GET', signal: ac.signal })","+  assert.strictEqual(pool.stats.queued, 1)","+","+  ac.abort()","+  await assert.rejects(settlesWithin(second), { name: 'AbortError' })","+  assert.strictEqual(pool.stats.queued, 0)","+  assert.strictEqual(getEventListeners(ac.signal, 'abort').length, 0)","+","+  server.release()","+  const res = await first","+  assert.strictEqual(await res.body.text(), 'released')","+","+  const third = await settlesWithin(pool.request({ path: '/', method: 'GET' }))","+  assert.strictEqual(await third.body.text(), 'ok')","+  assert.strictEqual(server.connections(), 1)","+})","+","+test('the Pool queue rejects with the abort reason and keeps other requests', async (t) => {","+  const server = await startServer(t)","+  const pool = new Pool(server.origin, { connections: 1 })","+  t.after(() => pool.destroy())","+","+  const first = pool.request({ path: '/hold', method: 'GET' })","+  await server.waitForHeld()","+","+  const ac = new AbortController()","+  const reason = new Error('custom reason')","+  const before = pool.request({ path: '/', method: 'GET' })","+  const aborted = pool.request({ path: '/', method: 'GET', signal: ac.signal })","+  const after = pool.request({ path: '/', method: 'GET' })","+  assert.strictEqual(pool.stats.queued, 3)","+","+  ac.abort(reason)","+  await assert.rejects(settlesWithin(aborted), (err) => err === reason)","+  assert.strictEqual(pool.stats.queued, 2)","+","+  server.release()","+  await (await first).body.dump()","+  assert.strictEqual(await (await settlesWithin(before)).body.text(), 'ok')","+  assert.strictEqual(await (await settlesWithin(after)).body.text(), 'ok')","+})","+","+test('a request aborted while the Client connects rejects at once', async (t) => {","+  const connect = hangingConnector()","+  const client = new Client('http://localhost:1', { connect })","+  t.after(() => { connect.destroy(); return client.destroy() })","+","+  const ac = new AbortController()","+  const promise = client.request({ path: '/', method: 'GET', signal: ac.signal })","+  assert.strictEqual(connect.calls, 1)","+  assert.strictEqual(client.stats.pending, 1)","+","+  ac.abort()","+  await assert.rejects(settlesWithin(promise), { name: 'AbortError' })","+  assert.strictEqual(client.stats.pending, 0)","+  assert.strictEqual(getEventListeners(ac.signal, 'abort').length, 0)","+})","+","+test('a Pool reuses a connecting client after its only request is aborted', async (t) => {","+  const server = await startServer(t)","+  let release","+  let calls = 0","+  const connect = (opts, callback) => {","+    calls++","+    release = () => {","+      const socket = net.connect(opts.port, opts.hostname)","+      socket.once('connect', () => callback(null, socket))","+    }","+  }","+  const pool = new Pool(server.origin, { connections: 1, connect })","+  t.after(() => pool.destroy())","+","+  const ac = new AbortController()","+  const aborted = pool.request({ path: '/', method: 'GET', signal: ac.signal })","+  ac.abort()","+  await assert.rejects(settlesWithin(aborted), { name: 'AbortError' })","+","+  // The connection attempt goes on and serves the next request.","+  const next = pool.request({ path: '/', method: 'GET' })","+  release()","+  const res = await settlesWithin(next)","+  assert.strictEqual(await res.body.text(), 'ok')","+  assert.strictEqual(calls, 1)","+})","+","+test('a pending request behind a running one rejects at once', async (t) => {","+  const server = await startServer(t)","+  const client = new Client(server.origin)","+  t.after(() => client.destroy())","+","+  const first = client.request({ path: '/hold', method: 'GET' })","+  await server.waitForHeld()","+","+  const ac = new AbortController()","+  const second = client.request({ path: '/', method: 'GET', signal: ac.signal })","+  assert.strictEqual(client.stats.pending, 1)","+","+  ac.abort()","+  await assert.rejects(settlesWithin(second), { name: 'AbortError' })"],"additions":182,"deletions":9,"truncated":false}],"additions":463,"deletions":47,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-20T17:57:38.679568+00:00"}