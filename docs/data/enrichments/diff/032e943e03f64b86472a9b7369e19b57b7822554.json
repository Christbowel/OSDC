 false, expanded: 'false', selectionChanged: change === 'scope' });","+\t\t}));","+\t}","+"," \ttest('an empty creation group offers repositories without an environment or extension provider', async () => {"," \t\tconst providersService = disposables.add(new MockSessionsProvidersService());"," \t\tconst repositoryUri = URI.parse('vscode-vfs://github/microsoft/vscode/HEAD');"],"additions":200,"deletions":1,"truncated":false},{"path":"src/vs/sessions/contrib/providers/remoteAgentHost/REMOTE_AGENT_HOST_SESSIONS_PROVIDER.md","lines":["@@ -99,7 +99,7 @@ On web, an intentional tunnel disconnect keeps the host cached and selectable wh"," "," User-local Mission Control discovery requires remote agent hosts and AI features to be enabled and is owned by `IMissionControlEnvironmentService`, separately from managed sandbox task discovery. It restores credential-free host metadata and local display names from machine-local profile storage for the authenticated account before network refresh. Discovery creates neither relay connections nor tasks. A successful endpoint listing is authoritative: absent hosts are withdrawn and their cached metadata is removed across windows and restarts. Failed or cancelled refreshes retain the last known inventory. Local display names remain separate from cached metadata. Availability reported by Mission Control is not relay connection state or session activity. The local native host is excluded in favor of IPC."," ","-The Mission Control hosts picker displays cached inventory immediately and refreshes on opening. The workspace picker also starts host discovery after showing its cached remote entries on a fresh open; internal list rebuilds reuse the in-flight or completed inventory instead of restarting discovery.","+The Mission Control hosts picker displays cached online inventory immediately and refreshes on opening. Mission Control providers expose observable environment-picker visibility based on inventory availability; offline hosts are excluded from environment, host-filter, and workspace pickers without withdrawing their providers, saved sessions, or selected session scope. The workspace picker also starts host discovery after showing its cached remote entries on a fresh open; internal list rebuilds reuse the in-flight or completed inventory instead of restarting discovery."," "," Local Mission Control sharing separates filesystem grants, the browsing default, and the project catalogue. Sharing grants the host's home directory and local project folders outside it, and creates `~/.copilot` as the advertised default directory. The Agents Window supplies local-disk recent folders from its workspace-picker history as catalogue entries, including the picker's worktree-collapsing behavior; remote and virtual folders are excluded. Missing folders are omitted with a warning. Other editor windows supply their open local workspace folders. Catalogue updates do not require a relay reconnect, and neither home nor the default directory becomes a project unless explicitly included in the folder inventory."," "],"additions":1,"deletions":1,"truncated":false},{"path":"src/vs/sessions/contrib/providers/remoteAgentHost/browser/entryDrivenProviderContribution.ts","lines":["@@ -26,6 +26,7 @@ export interface IEntryDrivenProviderOptions {"," \treadonly retainSessionsOnDisconnect?: boolean;"," \treadonly readOnlyWhenDisconnected?: boolean;"," \treadonly hostDescription?: IRemoteAgentHostSessionsProviderConfig['hostDescription'];","+\treadonly isVisibleInEnvironmentPicker?: IRemoteAgentHostSessionsProviderConfig['isVisibleInEnvironmentPicker'];"," \treadonly removeLabel?: string;"," \treadonly disconnectLabel?: string;"," \treadonly connectionLabels?: IRemoteAgentHostSessionsProviderConfig['connectionLabels'];","@@ -121,6 +122,7 @@ export abstract class EntryDrivenProviderContribution extends Disposable {"," \t\t\tretainSessionsOnDisconnect: options.retainSessionsOnDisconnect,"," \t\t\treadOnlyWhenDisconnected: options.readOnlyWhenDisconnected,"," \t\t\thostDescription: options.hostDescription,","+\t\t\tisVisibleInEnvironmentPicker: options.isVisibleInEnvironmentPicker,"," \t\t\tremoveLabel: options.removeLabel,"," \t\t\tdisconnectLabel: options.disconnectLabel,"," \t\t\tconnectionLabels: options.connectionLabels,"],"additions":2,"deletions":0,"truncated":false},{"path":"src/vs/sessions/contrib/providers/remoteAgentHost/browser/missionControlAgentHostContribution.ts","lines":["@@ -244,6 +244,7 @@ export class MissionControlAgentHostContribution extends EntryDrivenProviderCont"," \t\t\tsessionCacheKey: `missionControl.userLocalSessions.v1.${encodeURIComponent(this._profileService.currentProfile.id)}.${encodeURIComponent(account)}.${id}`,"," \t\t\tretainSessionsOnDisconnect: true,"," \t\t\treadOnlyWhenDisconnected: true,","+\t\t\tisVisibleInEnvironmentPicker: derived(this, reader => this._inventory.hosts.read(reader).some(host => host.id === id && host.status === 'online')),"," \t\t\tdisconnectLabel: localize('missionControl.disconnectHost', \"Disconnect\"),"," \t\t\thostDescription: derived(this, reader => {"," \t\t\t\tconst hosts = this._inventory.hosts.read(reader);"],"additions":1,"deletions":0,"truncated":false},{"path":"src/vs/sessions/contrib/providers/remoteAgentHost/browser/remoteAgentHostSessionsProvider.ts","lines":["@@ -102,6 +102,7 @@ export interface IRemoteAgentHostSessionsProviderConfig {"," \treadonly autoConnect?: IAgentHostAutoConnect;"," \treadonly connectionLabels?: IAgentHostConnectionLabels;"," \treadonly hostDescription?: IObservable<string>;","+\treadonly isVisibleInEnvironmentPicker?: IObservable<boolean>;"," \treadonly removeLabel?: string;"," \treadonly disconnectLabel?: string;"," \t/**","@@ -187,6 +188,7 @@ export class RemoteAgentHostSessionsProvider extends DevContainerAgentHostSessio"," \treadonly autoConnect?: IAgentHostAutoConnect;"," \treadonly connectionLabels?: IAgentHostConnectionLabels;"," \treadonly hostDescription?: IObservable<string>;","+\tread