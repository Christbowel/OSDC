omputed on each reconcile. */","   remaining?: number;","   /** When the cascade started, in Unix milliseconds. */","   started?: number;","   /** Current phase of the cascade delete. */","   state: string;","-  /** Descendants discovered when the cascade started; the fixed denominator for remaining. */","+  /** Direct children discovered when the cascade started; the fixed denominator for remaining. */","   total?: number;"," };"," export type FolderStatus = {"],"additions":3,"deletions":3,"truncated":false},{"path":"packages/grafana-openapi/src/apis/folder.grafana.app-v1.json","lines":["@@ -1184,7 +1184,7 @@","         \"required\": [\"state\"],","         \"properties\": {","           \"errors\": {","-            \"description\": \"Errors encountered while deleting descendants.\",","+            \"description\": \"Errors encountered while deleting direct children.\",","             \"type\": \"array\",","             \"items\": {","               \"type\": \"string\"","@@ -1196,7 +1196,7 @@","             \"format\": \"int64\"","           },","           \"remaining\": {","-            \"description\": \"Descendants not yet deleted.\",","+            \"description\": \"Direct children not yet deleted, recomputed on each reconcile.\",","             \"type\": \"integer\",","             \"format\": \"int64\"","           },","@@ -1211,7 +1211,7 @@","             \"default\": \"\"","           },","           \"total\": {","-            \"description\": \"Descendants discovered when the cascade started; the fixed denominator for remaining.\",","+            \"description\": \"Direct children discovered when the cascade started; the fixed denominator for remaining.\",","             \"type\": \"integer\",","             \"format\": \"int64\"","           }"],"additions":3,"deletions":3,"truncated":false},{"path":"packages/grafana-openapi/src/apis/folder.grafana.app-v1beta1.json","lines":["@@ -1184,7 +1184,7 @@","         \"required\": [\"state\"],","         \"properties\": {","           \"errors\": {","-            \"description\": \"Errors encountered while deleting descendants.\",","+            \"description\": \"Errors encountered while deleting direct children.\",","             \"type\": \"array\",","             \"items\": {","               \"type\": \"string\"","@@ -1196,7 +1196,7 @@","             \"format\": \"int64\"","           },","           \"remaining\": {","-            \"description\": \"Descendants not yet deleted.\",","+            \"description\": \"Direct children not yet deleted, recomputed on each reconcile.\",","             \"type\": \"integer\",","             \"format\": \"int64\"","           },","@@ -1211,7 +1211,7 @@","             \"default\": \"\"","           },","           \"total\": {","-            \"description\": \"Descendants discovered when the cascade started; the fixed denominator for remaining.\",","+            \"description\": \"Direct children discovered when the cascade started; the fixed denominator for remaining.\",","             \"type\": \"integer\",","             \"format\": \"int64\"","           }"],"additions":3,"deletions":3,"truncated":false},{"path":"pkg/registry/apis/folders/cascade/client.go","lines":["@@ -0,0 +1,129 @@","+package cascade","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"fmt\"","+\t\"slices\"","+","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/types\"","+\t\"k8s.io/client-go/dynamic\"","+","+\tfoldersv1 \"github.com/grafana/grafana/apps/folder/pkg/apis/folder/v1\"","+\t\"github.com/grafana/grafana/pkg/apimachinery/utils\"","+)","+","+// DynamicClients deletes children and writes folder state through the apiservers, so hooks and","+// admission run exactly as for any other client. It works the same in-process and in an operator.","+type DynamicClients struct {","+\tclient dynamic.Interface","+}","+","+var (","+\t_ ChildDeleter = (*DynamicClients)(nil)","+\t_ FolderWriter = (*DynamicClients)(nil)","+)","+","+func NewDynamicClients(client dynamic.Interface) *DynamicClients {","+\treturn &DynamicClients{client: client}","+}","+","+func (d *DynamicClients) Delete(ctx context.Context, namespace, parentUID string, child Child) (DeleteOutcome, error) {","+\tswitch child.Kind {","+\tcase ChildDashboard:","+\t\treturn d.deleteChild(ctx, d.client.Resource(dashboardGVR).Namespace(namespace), parentUID, child.Name)","+\tcase ChildFolder:","+\t\treturn d.deleteChild(ctx, d.client.Resource(folderGVR).Namespace(namespace), parentUID, child.Name)","+\tdefault:","+\t\treturn 0, fmt.Errorf(\"unsupported child kind %q\", child.Kind)","+\t}","+}","+","+// deleteChild re-reads the child rather than trusting the search hit: the index can lag a move, and","+// deleting by name alone would then remove the child (and, for a folder, its subtree) from the folder","+// it moved to. The uid and resourceVersion preconditions make the delete fail instead of acting on a","+// child that was recreated or moved between this read and the delete. Terminating children are","+// skipped, since re-deleting them would only spend a batch slot.","+//","+// Deletes are forced (gracePeriodSeconds=0), as the synchronous cascade does: it gets a non-empty","+// subfolder past the emptiness check (with the cascade finalizer it only goes terminating and runs","+// its own cascade), and a file-provisioned dashboard past the check that otherwise rejects deleting","+// it, which would leave the folder stuck.","+func (d *DynamicClients) deleteChild(ctx context.Context, client dynamic.ResourceInterface, parentUID, name string) (DeleteOutcome, error) {","+\texisting, err := client.Get(ctx, name, metav1.GetOptions{})","+\tif apierrors.IsNotFound(err) {","+\t\treturn DeleteOutcomeGone, nil","+\t}","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tif existing.GetAnnotations()[utils.AnnoKeyFolder] != parentUID {","+\t\treturn DeleteOutcomeGone, nil","+\t}","+\tif existing.GetDeletionTimestamp() != nil {","+\t\treturn DeleteOutcomeTerminating, nil","+\t}","+","+\tuid, rv := existing.GetUID(), existing.GetResourceVersion()","+\tzero := int64(0)","+\terr = client.Delete(ctx, name, metav1.DeleteOptions{","+\t\tGracePeriodSeconds: &zero,","+\t\tPreconditions:      &metav1.Preconditions{UID: &uid, ResourceVersion: &rv},","+\t})","+\tif apierrors.IsNotFound(err) {","+\t\treturn DeleteOutcomeGone, nil","+\t}","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tif len(existing.GetFinalizers()) > 0 {","+\t\treturn DeleteOutcomePending, nil","+\t}","+\treturn DeleteOutcomeDeleted, nil","+}","+","+// UpdateCascadeStatus merge-patches status.cascadeDelete. Unset fields are sent as null, since a","+// merge patch otherwise keeps their old values (e.g. errors from an earlier failed pass).","+func (d *DynamicClients) UpdateCascadeStatus(ctx context.Context, namespace, name string, status foldersv1.FolderCascadeDeleteStatus) error {","+\tcascade := map[string]any{","+\t\t\"state\":     status.State,","+\t\t\"total\":     status.Total,","+\t\t\"remaining\": status.Remaining,","+\t\t\"errors\":    status.Errors,","+\t\t\"started\":   status.Started,","+\t\t\"finished\":  status.Finished,","+\t}","+\tif len(status.Errors) == 0 {","+\t\tcascade[\"errors\"] = nil","+\t}","+\tpatch, err := json.Marshal(map[string]any{\"status\": map[string]any{\"cascadeDelete\": cascade}})","+\tif err != nil {","+\t\treturn err","+\t}","+\t_, err = d.client.Resource(folderGVR).Namespace(namespace).Patch(ctx, name, types.MergePatchType, patch, metav1.PatchOptions{}, \"status\")","+\treturn err","+}","+","+// RemoveFinalizer removes only the cascade finalizer. The test op pins the entry's position, so a","+// concurrent change to the finalizer list fails the patch instead of removing someone else's entry.","+func (d *DynamicClients) RemoveFinalizer(ctx context.Context, namespace, name string, finalizers []string) error {","+\tidx := slices.Index(finalizers, foldersv1.CascadeDeleteFinalizer)","+\tif idx < 0 {","+\t\treturn nil","+\t}","+\tpath := fmt.Sprintf(\"/metadata/finalizers/%d\", idx)","+\tpatch, err := json.Marshal([]map[string]any{","+\t\t{\"op\": \"test\", \"path\": path, \"value\": foldersv1.CascadeDeleteFinalizer},","+\t\t{\"op\": \"remove\", \"path\": path},","+\t})","+\tif err != nil {","+\t\treturn err","+\t}","+\t_, err = d.client.Resource(folderGVR).Namespace(namespace).Patch(ctx, name, types.JSONPatchType, patch, metav1.PatchOptions{})","+\tif apierrors.IsNotFound(err) {","+\t\treturn nil","+\t}","+\treturn err","+}"],"additions":129,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/folders/cascade/client_test.go","lines":["@@ -0,0 +1,301 @@","+package cascade","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\t\"google.golang.org/grpc\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\t\"k8s.io/apimachinery/pkg/types\"","+\tdynamicfake \"k8s.io/client-go/dynamic/fake\"","+\tk8stesting \"k8s.io/client-go/testing\"","+","+\tdashv1 \"github.com/grafana/grafana/apps/dashboard/pkg/apis/dashboard/v1\"","+\tfoldersv1 \"github.com/grafana/grafana/apps/folder/pkg/apis/folder/v1\"","+\t\"github.com/grafana/grafana/pkg/apimachinery/utils\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+func newFake(objs ...runtime.Object) *dynamicfake.FakeDynamicClient {","+\treturn dynamicfake.NewSimpleDynamicClientWithCustomListKinds(runtime.NewScheme(), map[schema.GroupVersionResource]string{","+\t\tfolderGVR:    \"FolderList\",","+\t\tdashboardGVR: \"DashboardList\",","+\t}, objs...)","+}","+","+// testParent is the folder the child objects below live in.","+const testParent = \"a\"","+","+func childObject(gvk schema.GroupVersionKind, name string, terminating bool, finalizers ...string) *unstructured.Unstructured {","+\tu := &unstructured.Unstructured{}","+\tu.SetGroupVersionKind(gvk)","+\tu.SetNamespace(testNamespace)","+\tu.SetName(name)","+\tu.SetUID(types.UID(name + \"-uid\"))","+\tu.SetResourceVersion(\"7\")","+\tu.SetAnnotations(map[string]string{utils.AnnoKeyFolder: testParent})","+\tu.SetFinalizers(finalizers)","+\tif terminating {","+\t\tts := metav1.Now()","+\t\tu.SetDeletionTimestamp(&ts)","+\t}","+\treturn u","+}","+","+func unstructuredFolder(name string, terminating bool, finalizers ...string) *unstructured.Unstructured {","+\treturn childObject(foldersv1.FolderResourceInfo.GroupVersionKind(), name, terminating, finalizers...)","+}","+","+func unstructuredDashboard(name string, terminating bool, finalizers ...string) *unstructured.Unstructured {","+\treturn childObject(dashv1.DashboardResourceInfo.GroupVersionKind(), name, terminating, finalizers...)","+}","+","+func moved(u *unstructured.Unstructured) *unstructured.Unstructured {","+\tu.SetAnnotations(map[string]string{utils.AnnoKeyFolder: \"elsewhere\"})","+\treturn u","+}","+","+func deleteActions(dyn *dynamicfake.FakeDynamicClient) []k8stesting.DeleteActionImpl {","+\tvar out []k8stesting.DeleteActionImpl","+\tfor _, a := range dyn.Actions() {","+\t\tif d, ok := a.(k8stesting.DeleteActionImpl); ok {","+\t\t\tout = append(out, d)","+\t\t}","+\t}","+\treturn out","+}","+","+func deleteChild(t *testing.T, dyn *dynamicfake.FakeDynamicClient, kind ChildKind, name string) (DeleteOutcome, error) {","+\tt.Helper()","+\treturn NewDynamicClients(dyn).Delete(context.Background(), testNamespace, testParent, Child{Kind: kind, Name: name})","+}","+","+func TestDynamicClients_Delete(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tkind ChildKind","+\t\tgvr  schema.GroupVersionResource","+\t\tobj  func(name string, terminating bool, finalizers ...string) *unstructured.Unstructured","+\t}{","+\t\t{kind: ChildDashboard, gvr: dashboardGVR, obj: unstructuredDashboard},","+\t\t{kind: ChildFolder, gvr: folderGVR, obj: unstructuredFolder},","+\t} {","+\t\tt.Run(string(tc.kind), func(t *testing.T) {","+\t\t\tt.Run(\"force-deletes with uid and resourceVersion preconditions\", func(t *testing.T) {","+\t\t\t\tdyn := newFake(tc.obj(\"c\", false))","+\t\t\t\toutcome, err := deleteChild(t, dyn, tc.kind, \"c\")","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, DeleteOutcomeDeleted, outcome)","+","+\t\t\t\tdels := deleteActions(dyn)","+\t\t\t\trequire.Len(t, dels, 1)","+\t\t\t\trequire.Equal(t, tc.gvr, dels[0].GetResource())","+\t\t\t\tpre := dels[0].DeleteOptions.Preconditions","+\t\t\t\trequire.Equal(t, types.UID(\"c-uid\"), *pre.UID)","+\t\t\t\trequire.Equal(t, \"7\", *pre.ResourceVersion)","+\t\t\t\trequire.NotNil(t, dels[0].DeleteOptions.GracePeriodSeconds)","+\t\t\t\trequire.Equal(t, int64(0), *dels[0].DeleteOptions.GracePeriodSeconds)","+\t\t\t})","+\t\t\tt.Run(\"held by finalizers is pending\", func(t *testing.T) {","+\t\t\t\tdyn := newFake(tc.obj(\"c\", false, otherFinalizer))","+\t\t\t\toutcome, err := deleteChild(t, dyn, tc.kind, \"c\")","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, DeleteOutcomePending, outcome)","+\t\t\t\trequire.Len(t, deleteActions(dyn), 1)","+\t\t\t})","+\t\t\tt.Run(\"terminating is skipped\", func(t *testing.T) {","+\t\t\t\tdyn := newFake(tc.obj(\"c\", true, otherFinalizer))","+\t\t\t\toutcome, err := deleteChild(t, dyn, tc.kind, \"c\")","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, DeleteOutcomeTerminating, outcome)","+\t\t\t\trequire.Empty(t, deleteActions(dyn))","+\t\t\t})","+\t\t\tt.Run(\"moved to another folder is not deleted\", func(t *testing.T) {","+\t\t\t\t// A stale search hit must not delete the child from the folder it moved to.","+\t\t\t\tdyn := newFake(moved(tc.obj(\"c\", false)))","+\t\t\t\toutcome, err := deleteChild(t, dyn, tc.kind, \"c\")","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, DeleteOutcomeGone, outcome)","+\t\t\t\trequire.Empty(t, deleteActions(dyn))","+\t\t\t})","+\t\t\tt.Run(\"missing is gone\", func(t *testing.T) {","+\t\t\t\toutcome, err := deleteChild(t, newFake(), tc.kind, \"c\")","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, DeleteOutcomeGone, outcome)","+\t\t\t})","+\t\t\tt.Run(\"delete error is returned\", func(t *testing.T) {","+\t\t\t\tdyn := newFake(tc.obj(\"c\", false))","+\t\t\t\tdyn.PrependReactor(\"delete\", tc.gvr.Resource, func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\t\t\t\treturn true, nil, apierrors.NewConflict(tc.gvr.GroupResource(), \"c\", errors.New(\"changed\"))","+\t\t\t\t})","+\t\t\t\t_, err := deleteChild(t, dyn, tc.kind, \"c\")","+\t\t\t\trequire.True(t, apierrors.IsConflict(err))","+\t\t\t})","+\t\t})","+\t}","+}","+","+func patchActions(dyn *dynamicfake.FakeDynamicClient) []k8stesting.PatchActionImpl {","+\tvar out []k8stesting.PatchActionImpl","+\tfor _, a := range dyn.Actions() {","+\t\tif p, ok := a.(k8stesting.PatchActionImpl); ok {","+\t\t\tout = append(out, p)","+\t\t}","+\t}","+\treturn out","+}","+","+func TestDynamicClients_UpdateCascadeStatus(t *testing.T) {","+\tdyn := newFake(unstructuredFolder(\"a\", true, foldersv1.CascadeDeleteFinalizer))","+\tdyn.PrependReactor(\"patch\", \"folders\", func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\treturn true, unstructuredFolder(\"a\", true), nil","+\t})","+\tc := NewDynamicClients(dyn)","+\ttwo, started := int64(2), int64(1000)","+","+\trequire.NoError(t, c.UpdateCascadeStatus(context.Background(), testNamespace, \"a\", foldersv1.FolderCascadeDeleteStatus{","+\t\tState:     foldersv1.FolderCascadeDeleteStatusStateInProgress,","+\t\tTotal:     &two,","+\t\tRemaining: &two,","+\t\tStarted:   &started,","+\t}))","+","+\tpatches := patchActions(dyn)","+\trequire.Len(t, patches, 1)","+\trequire.Equal(t, \"status\", patches[0].GetSubresource())","+\trequire.Equal(t, types.MergePatchType, patches[0].GetPatchType())","+\trequire.JSONEq(t, `{\"status\":{\"cascadeDelete\":{","+\t\t\"state\":\"InProgress\",\"total\":2,\"remaining\":2,\"started\":1000,\"errors\":null,\"finished\":null","+\t}}}`, string(patches[0].GetPatch()))","+}","+","+func TestDynamicClients_RemoveFinalizer(t *testing.T) {","+\tt.Run(\"removes only ours\", func(t *testing.T) {","+\t\tdyn := newFake(unstructuredFolder(\"a\", true, otherFinalizer, foldersv1.CascadeDeleteFinalizer))","+\t\tc := NewDynamicClients(dyn)","+","+\t\trequire.NoError(t, c.RemoveFinalizer(context.Background(), testNamespace, \"a\", []string{otherFinalizer, foldersv1.CascadeDeleteFinalizer}))","+","+\t\tpatches := patchActions(dyn)","+\t\trequire.Len(t, patches, 1)","+\t\trequire.Equal(t, types.JSONPatchType, patches[0].GetPatchType())","+\t\trequire.Empty(t, patches[0].GetSubresource())","+\t\tvar ops []map[string]any","+\t\trequire.NoError(t, json.Unmarshal(patches[0].GetPatch(), &ops))","+\t\trequire.Equal(t, []map[string]any{","+\t\t\t{\"op\": \"test\", \"path\": \"/metadata/finalizers/1\", \"value\": foldersv1.CascadeDeleteFinalizer},","+\t\t\t{\"op\": \"remove\", \"path\": \"/metadata/finalizers/1\"},","+\t\t}, ops)","+","+\t\tgot, err := dyn.Resource(folderGVR).Namespace(testNamespace).Get(context.Background(), \"a\", metav1.GetOptions{})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, []string{otherFinalizer}, got.GetFinalizers())","+\t})","+\tt.Run(\"stale finalizer list fails instead of removing another entry\", func(t *testing.T) {","+\t\tdyn := newFake(unstructuredFolder(\"a\", true, otherFinalizer))","+\t\terr := NewDynamicClients(dyn).RemoveFinalizer(context.Background(), testNamespace, \"a\", []string{foldersv1.CascadeDeleteFinalizer})","+\t\trequire.Error(t, err)","+\t\tgot, getErr := dyn.Resource(folderGVR).Namespace(testNamespace).Get(context.Background(), \"a\", metav1.GetOptions{})","+\t\trequire.NoError(t, getErr)","+\t\trequire.Equal(t, []string{otherFinalizer}, got.GetFinalizers())","+\t})","+\tt.Run(\"no-op without our finalizer\", func(t *testing.T) {","+\t\tdyn := newFake(unstructuredFolder(\"a\", true, otherFinalizer))","+\t\trequire.NoError(t, NewDynamicClients(dyn).RemoveFinalizer(context.Background(), testNamespace, \"a\", []string{otherFinalizer}))","+\t\trequire.Empty(t, patchActions(dyn))","+\t})","+\tt.Run(\"already gone\", func(t *testing.T) {","+\t\tdyn := newFake()","+\t\trequire.NoError(t, NewDynamicClients(dyn).RemoveFinalizer(context.Background(), testNamespace, \"a\", []string{foldersv1.CascadeDeleteFinalizer}))","+\t})","+}","+","+// pagedSearcher serves names per resource in pages, honoring offset/limit.","+type pagedSearcher struct {","+\tresourcepb.ResourceIndexClient","+\tbyResource map[string][]string","+\terr        error","+\t// format overrides the result format the server reports; FIELD_VALUES when unset.","+\tformat   resourcepb.ResourceSearchRequest_ResultFormat","+\trequests []*resourcepb.ResourceSearchRequest","+}","+","+func (s *pagedSearcher) Search(_ context.Context, req *resourcepb.ResourceSearchRequest, _ ...grpc.CallOption) (*resourcepb.ResourceSearchResponse, error) {","+\ts.requests = append(s.requests, req)","+\tif s.err != nil {","+\t\treturn nil, s.err","+\t}","+\tnames := s.byResource[req.Options.Key.Resource]","+\ttotal := int64(len(names))","+\tstart := min(req.Offset, total)","+\tend := min(start+req.Limit, total)","+\trows := make([]*resourcepb.ResourceSearchRow, 0, end-start)","+\tfor _, n := range names[start:end] {","+\t\trows = append(rows, &resourcepb.ResourceSearchRow{Key: &resourcepb.ResourceKey{Name: n}})","+\t}","+\tformat := s.format","+\tif format == resourcepb.ResourceSearchRequest_UNSPECIFIED {","+\t\tformat = resourcepb.ResourceSearchRequest_FIELD_VALUES","+\t}","+\treturn &resourcepb.ResourceSearchResponse{ResultFormat: format, Rows: rows, TotalHits: total}, nil","+}","+","+func TestSearchChildLister(t *testing.T) {","+\ts := &pagedSearcher{byResource: map[string][]string{","+\t\tfolderGVR.Resource:    {\"f1\", \"f2\", \"f3\"},","+\t\tdashboardGVR.Resource: {\"d1\", \"d2\"},","+\t}}","+\tl := NewSearchChildLister(s)","+\tctx := context.Background()","+","+\tpage, total, err := l.ListChildren(ctx, testNamespace, \"parent\", ChildFolder, 0, 2)","+\trequire.NoError(t, err)","+\trequire.Equal(t, []Child{{ChildFolder, \"f1\"}, {ChildFolder, \"f2\"}}, page)","+\trequire.Equal(t, int64(3), total)","+","+\tpage, total, err = l.ListChildren(ctx, testNamespace, \"parent\", ChildFolder, 2, 2)","+\trequire.NoError(t, err)","+\trequire.Equal(t, []Child{{ChildFolder, \"f3\"}}, page)","+\trequire.Equal(t, int64(3), total)","+","+\tpage, total, err = l.ListChildren(ctx, testNamespace, \"parent\", ChildDashboard, 0, 100)","+\trequire.NoError(t, err)","+\trequire.Equal(t, []Child{{ChildDashboard, \"d1\"}, {ChildDashboard, \"d2\"}}, page)","+\trequire.Equal(t, int64(2), total)","+","+\trequire.Len(t, s.requests, 3)","+\tfor _, req := range s.requests {","+\t\trequire.Equal(t, testNamespace, req.Options.Key.Namespace)","+\t\trequire.Len(t, req.Options.Fields, 1)","+\t\trequire.Equal(t, resource.SEARCH_FIELD_FOLDER, req.Options.Fields[0].Key)","+\t\trequire.Equal(t, []string{\"parent\"}, req.Options.Fields[0].Values)","+\t}","+\trequire.Equal(t, folderGVR.Resource, s.requests[1].Options.Key.Resource)","+\trequire.Equal(t, int64(2), s.requests[1].Offset)","+\trequire.Equal(t, int64(2), s.requests[1].Limit)","+\trequire.Equal(t, dashboardGVR.Resource, s.requests[2].Options.Key.Resource)","+}","+","+func TestSearchChildLister_Error(t *testing.T) {","+\t_, _, err := NewSearchChildLister(&pagedSearcher{err: errors.New(\"index down\")}).ListChildren(context.Background(), testNamespace, \"parent\", ChildFolder, 0, 10)","+\trequire.ErrorContains(t, err, \"index down\")","+}","+","+func TestSearchChildLister_RejectsUnexpectedResultFormat(t *testing.T) {","+\t// A response in another format must not read as an empty folder, which would release it.","+\tfor _, format := range []resourcepb.ResourceSearchRequest_ResultFormat{","+\t\tresourcepb.ResourceSearchRequest_ResultFormat(99),","+\t\tresourcepb.ResourceSearchRequest_RESOURCE_TABLE,","+\t} {","+\t\ts := &pagedSearcher{byResource: map[string][]string{}, format: format}","+\t\t_, _, err := NewSearchChildLister(s).ListChildren(context.Background(), testNamespace, \"parent\", ChildDashboard, 0, 10)","+\t\trequire.ErrorContains(t, err, \"unexpected search result format\")","+\t}","+}"],"additions":301,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/folders/cascade/fake_test.go","lines":["@@ -0,0 +1,222 @@","+package cascade","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"slices\"","+\t\"sort\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+","+\tfoldersv1 \"github.com/grafana/grafana/apps/folder/pkg/apis/folder/v1\"","+)","+","+const (","+\ttestNamespace  = \"default\"","+\totherFinalizer = \"example.com/other\"","+)","+","+type memFolder struct {","+\tparent      string","+\tfinalizers  []string","+\tterminating bool","+\tstatus      *foldersv1.FolderCascadeDeleteStatus","+}","+","+// memStore is an in-memory folder/dashboard store with finalizer semantics: deleting an object that","+// carries finalizers marks it terminating, and it only disappears once its last finalizer is removed.","+type memStore struct {","+\tfolders    map[string]*memFolder","+\tdashboards map[string]string // name -> parent folder","+\t// failDelete makes Delete of the named child return the error.","+\tfailDelete map[string]error","+","+\tdeleteCalls  []string","+\tstatusWrites int","+\tlistedRows   int","+}","+","+func newMemStore() *memStore {","+\treturn &memStore{folders: map[string]*memFolder{}, dashboards: map[string]string{}, failDelete: map[string]error{}}","+}","+","+func (m *memStore) addFolder(name, parent string, finalizers ...string) {","+\tm.folders[name] = &memFolder{parent: parent, finalizers: finalizers}","+}","+","+func (m *memStore) addDashboards(parent string, names ...string) {","+\tfor _, n := range names {","+\t\tm.dashboards[n] = parent","+\t}","+}","+","+// userDelete is a DELETE on the folder, as the API would apply it.","+func (m *memStore) userDelete(name string) {","+\tf := m.folders[name]","+\tif len(f.finalizers) == 0 {","+\t\tdelete(m.folders, name)","+\t\treturn","+\t}","+\tf.terminating = true","+}","+","+func (m *memStore) get(name string) *foldersv1.Folder {","+\tf, ok := m.folders[name]","+\tif !ok {","+\t\treturn nil","+\t}","+\tout := &foldersv1.Folder{ObjectMeta: metav1.ObjectMeta{Namespace: testNamespace, Name: name, Finalizers: slices.Clone(f.finalizers)}}","+\tif f.terminating {","+\t\tts := metav1.Now()","+\t\tout.DeletionTimestamp = &ts","+\t}","+\tif f.status != nil {","+\t\tst := copyStatus(f.status)","+\t\tout.Status.CascadeDelete = &st","+\t}","+\treturn out","+}","+","+func (m *memStore) childrenOf(folderUID string, kind ChildKind) []Child {","+\tvar out []Child","+\tswitch kind {","+\tcase ChildFolder:","+\t\tfor _, name := range sortedKeys(m.folders) {","+\t\t\tif m.folders[name].parent == folderUID {","+\t\t\t\tout = append(out, Child{Kind: ChildFolder, Name: name})","+\t\t\t}","+\t\t}","+\tcase ChildDashboard:","+\t\tfor _, name := range sortedKeys(m.dashboards) {","+\t\t\tif m.dashboards[name] == folderUID {","+\t\t\t\tout = append(out, Child{Kind: ChildDashboard, Name: name})","+\t\t\t}","+\t\t}","+\t}","+\treturn out","+}","+","+func (m *memStore) ListChildren(_ context.Context, _, folderUID string, kind ChildKind, offset, limit int64) ([]Child, int64, error) {","+\tall := m.childrenOf(folderUID, kind)","+\tpage := pageOf(all, offset, limit)","+\tm.listedRows += len(page)","+\treturn page, int64(len(all)), nil","+}","+","+func pageOf(all []Child, offset, limit int64) []Child {","+\tn := int64(len(all))","+\tstart := min(offset, n)","+\tend := min(start+limit, n)","+\treturn all[start:end]","+}","+","+func (m *memStore) Delete(_ context.Context, _, parentUID string, c Child) (DeleteOutcome, error) {","+\tif err := m.failDelete[c.Name]; err != nil {","+\t\treturn 0, err","+\t}","+\tswitch c.Kind {","+\tcase ChildDashboard:","+\t\tif parent, ok := m.dashboards[c.Name]; !ok || parent != parentUID {","+\t\t\treturn DeleteOutcomeGone, nil","+\t\t}","+\t\tm.deleteCalls = append(m.deleteCalls, c.Name)","+\t\tdelete(m.dashboards, c.Name)","+\t\treturn DeleteOutcomeDeleted, nil","+\tdefault:","+\t\tf, ok := m.folders[c.Name]","+\t\tif !ok || f.parent != parentUID {","+\t\t\treturn DeleteOutcomeGone, nil","+\t\t}","+\t\tif f.terminating {","+\t\t\treturn DeleteOutcomeTerminating, nil","+\t\t}","+\t\tif len(f.finalizers) == 0 {","+\t\t\t// Mirrors validateOnDelete: without the finalizer a forced delete gets no bypass.","+\t\t\tif len(m.childrenOf(c.Name, ChildFolder))+len(m.childrenOf(c.Name, ChildDashboard)) > 0 {","+\t\t\t\treturn 0, errors.New(\"folder is not empty\")","+\t\t\t}","+\t\t\tm.deleteCalls = append(m.deleteCalls, c.Name)","+\t\t\tdelete(m.folders, c.Name)","+\t\t\treturn DeleteOutcomeDeleted, nil","+\t\t}","+\t\tm.deleteCalls = append(m.deleteCalls, c.Name)","+\t\tf.terminating = true","+\t\treturn DeleteOutcomePending, nil","+\t}","+}","+","+func (m *memStore) UpdateCascadeStatus(_ context.Context, _ string, name string, s foldersv1.FolderCascadeDeleteStatus) error {","+\tf, ok := m.folders[name]","+\tif !ok {","+\t\treturn apierrors.NewNotFound(foldersv1.FolderResourceInfo.GroupResource(), name)","+\t}","+\tm.statusWrites++","+\tst := copyStatus(&s)","+\tf.status = &st","+\treturn nil","+}","+","+func (m *memStore) RemoveFinalizer(_ context.Context, _ string, name string, _ []string) error {","+\tf, ok := m.folders[name]","+\tif !ok {","+\t\treturn apierrors.NewNotFound(foldersv1.FolderResourceInfo.GroupResource(), name)","+\t}","+\tf.finalizers = slices.DeleteFunc(f.finalizers, func(s string) bool { return s == foldersv1.CascadeDeleteFinalizer })","+\tif f.terminating && len(f.finalizers) == 0 {","+\t\tdelete(m.folders, name)","+\t}","+\treturn nil","+}","+","+func sortedKeys[V any](m map[string]V) []string {","+\tkeys := make([]string, 0, len(m))","+\tfor k := range m {","+\t\tkeys = append(keys, k)","+\t}","+\tsort.Strings(keys)","+\treturn keys","+}","+","+func newTestReconciler(m *memStore, batch int) *Reconciler {","+\treturn &Reconciler{","+\t\tChildren:  m,","+\t\tDeleter:   m,","+\t\tFolders:   m,","+\t\tBatchSize: batch,","+\t}","+}","+","+// reconcileOnce reconciles the named folder from its current stored state.","+func reconcileOnce(t *testing.T, r *Reconciler, m *memStore, name string) (Result, error) {","+\tt.Helper()","+\tf := m.get(name)","+\trequire.NotNil(t, f, \"folder %q is gone\", name)","+\treturn r.Reconcile(context.Background(), f)","+}","+","+// drain reconciles every terminating folder until a pass changes nothing, standing in for the","+// workqueue that drives the reconciler in production."],"additions":201,"deletions":0,"truncated":false}],"additions":649,"deletions":18,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-30T15:56:06.890018+00:00"}