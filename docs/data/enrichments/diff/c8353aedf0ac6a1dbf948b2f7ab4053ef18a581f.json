{"id":"c8353aedf0ac6a1dbf948b2f7ab4053ef18a581f","axis":"silent","repo":"pnpm/pnpm","sha":"c8353aedf0ac6a1dbf948b2f7ab4053ef18a581f","parsed":{"files":[{"path":".changeset/revalidate-release-age-upgrade.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+With `minimumReleaseAge` set, pnpm now revalidates a package's cached full metadata with its ETag, so an unchanged registry answers with `304`. Before, if the registry did not list a publish time for every version, pnpm downloaded that metadata again whenever the cached copy was older than `minimumReleaseAge`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/fetch_full_metadata.rs","lines":["@@ -27,7 +27,7 @@ use std::time::Duration;"," "," use crate::{","     FetchMetadataError,","-    metadata_cache_policy::{DocumentKind, MirrorWrite},","+    metadata_cache_policy::{DocumentKind, normalizes_to_abbreviated},","     mirror::clear_meta,","     registry_url::to_registry_url,"," };","@@ -286,13 +286,6 @@ fn to_http_date(value: &str) -> Option<String> {","     httpdate::parse_http_date(value).ok().map(httpdate::fmt_http_date)"," }"," ","-/// The outcome of a metadata request, with how a `2xx` body is recorded in","-/// a mirror.","-pub(crate) enum MetadataDocument {","-    Modified { meta: Box<Package>, mirror_write: MirrorWrite },","-    NotModified,","-}","-"," /// Fetch the registry metadata document for `pkg_name`. The"," /// `full_metadata` flag on [`FetchFullMetadataOptions`] picks"," /// between the full and abbreviated packument forms.","@@ -300,21 +293,8 @@ pub async fn fetch_full_metadata(","     pkg_name: &str,","     opts: &FetchFullMetadataOptions<'_>,"," ) -> Result<FetchFullMetadataOutcome, FetchMetadataError> {","-    let kind = DocumentKind::requested(opts.full_metadata);","-    Ok(match fetch_metadata_document(pkg_name, opts, kind).await? {","-        MetadataDocument::Modified { meta, .. } => FetchFullMetadataOutcome::Modified(meta),","-        MetadataDocument::NotModified => FetchFullMetadataOutcome::NotModified,","-    })","-}","-","-/// Fetch the `kind` document for `pkg_name`. `kind` replaces","-/// [`FetchFullMetadataOptions::full_metadata`].","-pub(crate) async fn fetch_metadata_document(","-    pkg_name: &str,","-    opts: &FetchFullMetadataOptions<'_>,","-    kind: DocumentKind,","-) -> Result<MetadataDocument, FetchMetadataError> {","     let url = to_registry_url(opts.registry, pkg_name);","+    let kind = DocumentKind::requested(opts.full_metadata);","     retry_async(&url, opts.http.retry_opts, FetchMetadataError::is_transient, || {","         one_metadata_attempt(pkg_name, opts, &url, kind)","     })","@@ -326,7 +306,7 @@ async fn one_metadata_attempt(","     opts: &FetchFullMetadataOptions<'_>,","     url: &str,","     kind: DocumentKind,","-) -> Result<MetadataDocument, FetchMetadataError> {","+) -> Result<FetchFullMetadataOutcome, FetchMetadataError> {","     let (client, response) = send_metadata_request(&MetadataRequestOptions {","         pkg_name,","         url,","@@ -339,16 +319,16 @@ async fn one_metadata_attempt(","     })","     .await?;","     if response.status() == StatusCode::NOT_MODIFIED {","-        return Ok(MetadataDocument::NotModified);","+        return Ok(FetchFullMetadataOutcome::NotModified);","     }","-    let mirror_write = MirrorWrite::on_response(kind, response.headers());","+    let normalize = normalizes_to_abbreviated(kind, response.headers());","     let meta = decode_metadata_response(","         MetadataResponse { client, response, url, http_client: opts.http.http_client },","-        mirror_write.normalizes_to_abbreviated(),","+        normalize,","         Ok,","     )","     .await?;","-    Ok(MetadataDocument::Modified { meta: Box::new(meta), mirror_write })","+    Ok(FetchFullMetadataOutcome::Modified(Box::new(meta)))"," }"," "," /// A metadata response together with the network permit it holds."],"additions":7,"deletions":27,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/fetch_full_metadata_cached.rs","lines":["@@ -79,7 +79,7 @@ pub async fn fetch_full_metadata_cached(","     pkg_name: &str,","     opts: &FetchFullMetadataCachedOptions<'_>,"," ) -> Result<Package, FetchMetadataError> {","-    let meta = fetch_metadata_cached(pkg_name, opts, false).await?;","+    let meta = fetch_metadata_cached(pkg_name, opts, CachedFetch::MIRROR_DOCUMENT).await?;","     meta.versions.read_every_mirror_fragment();","     if !meta.versions.corrupt_mirror_fragment_found() {","         return Ok(meta);","@@ -98,7 +98,7 @@ pub(crate) async fn fetch_full_metadata_projected<Projection>(","     opts: &FetchFullMetadataCachedOptions<'_>,","     project: impl Fn(&Package) -> Projection,"," ) -> Result<Projection, FetchMetadataError> {","-    let meta = fetch_metadata_cached(pkg_name, opts, false).await?;","+    let meta = fetch_metadata_cached(pkg_name, opts, CachedFetch::MIRROR_DOCUMENT).await?;","     let projection = project(&meta);","     if !meta.versions.corrupt_mirror_fragment_found() {","         return Ok(projection);","@@ -119,7 +119,7 @@ async fn refetch_damaged_mirror(","             hint: None,","         });","     }","-    fetch_metadata_cached(pkg_name, opts, true).await","+    fetch_metadata_cached(pkg_name, opts, CachedFetch::BYPASSING_MIRROR).await"," }"," "," /// [`fetch_full_metadata_cached`] without the up-front fragment check, for the","@@ -128,20 +128,71 @@ pub(crate) async fn fetch_full_metadata_cached_lazily(","     pkg_name: &str,","     opts: &FetchFullMetadataCachedOptions<'_>,"," ) -> Result<Package, FetchMetadataError> {","-    fetch_metadata_cached(pkg_name, opts, false).await","+    fetch_metadata_cached(pkg_name, opts, CachedFetch::MIRROR_DOCUMENT).await"," }"," "," pub(crate) async fn fetch_full_metadata_bypassing_cache(","     pkg_name: &str,","     opts: &FetchFullMetadataCachedOptions<'_>,"," ) -> Result<Package, FetchMetadataError> {","-    fetch_metadata_cached(pkg_name, opts, true).await","+    fetch_metadata_cached(pkg_name, opts, CachedFetch::BYPASSING_MIRROR).await","+}","+","+/// Fetch the full document a `minimumReleaseAge` upgrade stores in the","+/// abbreviated mirror `opts` names, as","+/// [`DocumentKind::FullInAbbreviatedMirror`]. With `write_mirror` off (a","+/// dry run) the mirror is read but never written or touched.","+pub(crate) async fn fetch_release_age_upgrade(","+    pkg_name: &str,","+    opts: &FetchFullMetadataCachedOptions<'_>,","+    write_mirror: bool,","+) -> Result<Package, FetchMetadataError> {","+    debug_assert!(!opts.full_metadata, \"an upgrade fills the abbreviated mirror\");","+    let fetch = CachedFetch {","+        document: CachedDocument::ReleaseAgeUpgrade,","+        bypass_mirror: false,","+        write_mirror,","+    };","+    fetch_metadata_cached(pkg_name, opts, fetch).await","+}","+","+/// What one [`fetch_metadata_cached`] call asks for and may do to the mirror.","+#[derive(Debug, Clone, Copy)]","+struct CachedFetch {","+    document: CachedDocument,","+    /// Ignore the mirror's validators, so only a body can answer.","+    bypass_mirror: bool,","+    write_mirror: bool,","+}","+","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+enum CachedDocument {","+    /// The document the mirror slot holds ([`DocumentKind::for_mirror`]).","+    MirrorSlot,","+    /// [`DocumentKind::FullInAbbreviatedMirror`].","+    ReleaseAgeUpgrade,","+}","+","+impl CachedFetch {","+    const MIRROR_DOCUMENT: Self = CachedFetch {","+        document: CachedDocument::MirrorSlot,","+        bypass_mirror: false,","+        write_mirror: true,","+    };","+    const BYPASSING_MIRROR: Self = CachedFetch { bypass_mirror: true, ..Self::MIRROR_DOCUMENT };","+","+    fn kind(self, full_metadata: bool, stored: Option<&MetaHeaders>) -> DocumentKind {","+        match self.document {","+            CachedDocument::MirrorSlot => DocumentKind::for_mirror(full_metadata, stored),","+            CachedDocument::ReleaseAgeUpgrade => DocumentKind::FullInAbbreviatedMirror,","+        }","+    }"," }"," "," async fn fetch_metadata_cached(","     pkg_name: &str,","     opts: &FetchFullMetadataCachedOptions<'_>,","-    bypass_cache: bool,","+    fetch: CachedFetch,"," ) -> Result<Package, FetchMetadataError> {","     let url = to_registry_url(opts.registry, pkg_name);","     let mirror_path = mirror_path_for(pkg_name, opts, &url);","@@ -158,16 +209,20 @@ async fn fetch_metadata_cached(","         });","     }"," ","-    let cache_headers =","-        if bypass_cache { None } else { load_meta_headers_async(mirror_path.as_deref()).await };","+    let cache_headers = if fetch.bypass_mirror {","+        None","+    } else {","+        load_meta_headers_async(mirror_path.as_deref()).await","+    };","     let attempt = FetchAttempt {","         pkg_name,","         url: &url,","         opts,","         mirror_path: mirror_path.as_deref(),","-        kind: DocumentKind::for_mirror(opts.full_metadata, cache_headers.as_ref()),","+        kind: fetch.kind(opts.full_metadata, cache_headers.as_ref()),","+        write_mirror: fetch.write_mirror,","         cache_headers,","-        cache_bypass: AtomicBool::new(bypass_cache),","+        cache_bypass: AtomicBool::new(fetch.bypass_mirror),","     };","     retry_async(&url, opts.http.retry_opts, FetchMetadataError::is_transient, || attempt.run())","         .await","@@ -181,6 +236,7 @@ struct FetchAttempt<'a> {","     opts: &'a FetchFullMetadataCachedOptions<'a>,","     mirror_path: Option<&'a Path>,","     kind: DocumentKind,","+    write_mirror: bool,","     cache_headers: Option<MetaHeaders>,","     cache_bypass: AtomicBool,"," }","@@ -192,9 +248,12 @@ impl FetchAttempt<'_> {","         let (client, response) = send_metadata_request(&request).await?;"," ","         let (client, response) = if response.status() == StatusCode::NOT_MODIFIED {","-            match recover_from_not_modified(client, &request, self.mirror_path, &self.cache_bypass)","-                .await?","-            {","+            let recovery = NotModifiedContext {","+                mirror_path: self.mirror_path,","+                cache_bypass: &self.cache_bypass,","+                renew_mirror: self.write_mirror,","+            };","+            match recover_from_not_modified(client, &request, recovery).await? {","                 NotModifiedRecovery::Serve(meta) => return Ok(meta),","                 NotModifiedRecovery::Refetched(client, response) => (client, response),","             }","@@ -219,7 +278,7 @@ impl FetchAttempt<'_> {","     fn mirror_store(&self, response: &Response) -> MirrorStore {","         MirrorStore {","             url: self.url.to_string(),","-            mirror_path: self.mirror_path.map(Path::to_path_buf),","+            mirror_path: self.mirror_path.filter(|_| self.write_mirror).map(Path::to_path_buf),","             mirror_write: MirrorWrite::on_response(self.kind, response.headers()),","             should_filter_metadata: self.opts.full_metadata && self.opts.filter_metadata,","         }","@@ -359,6 +418,15 @@ fn warn_mirror_write_failed(error: &impl std::fmt::Debug, path: &Path) {","     );"," }"," ","+/// The mirror a `304 Not Modified` is honoured against.","+#[derive(Clone, Copy)]","+struct NotModifiedContext<'a> {","+    mirror_path: Option<&'a Path>,","+    cache_bypass: &'a AtomicBool,","+    /// Whether the fetch may touch the mirror ([`renew_mirror_freshness`]).","+    renew_mirror: bool,","+}","+"," /// Outcome of a `304 Not Modified` once it is honoured against the mirror."," enum NotModifiedRecovery<'a> {","     /// The mirror body was still on disk; serve it.","@@ -378,9 +446,13 @@ enum NotModifiedRecovery<'a> {"," async fn recover_from_not_modified<'a>(","     client: ThrottledClientGuard<'a>,","     request: &MetadataRequestOptions<'a>,","-    mirror_path: Option<&Path>,","-    cache_bypass: &AtomicBool,","+    recovery: NotModifiedContext<'_>,"," ) -> Result<NotModifiedRecovery<'a>, FetchMetadataError> {","+    let NotModifiedContext {","+        mirror_path,","+        cache_bypass,","+        renew_mirror,","+    } = recovery;","     // No body to stream — release the connection and its network-concurrency","     // permit before the mirror disk read.","     drop(client);","@@ -390,7 +462,9 @@ async fn recover_from_not_modified<'a>(","         });","     };","     if let Some(meta) = load_meta_async(Some(path)).await {","-        renew_mirror_freshness(path);","+        if renew_mirror {","+            renew_mirror_freshness(path);","+        }","         return Ok(NotModifiedRecovery::Serve(meta));","     }","     cache_bypass.store(true, Ordering::Relaxed);"],"additions":91,"deletions":17,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/fetch_full_metadata_cached/tests.rs","lines":["@@ -9,6 +9,8 @@ mod metadata_cache_cold_cache_writes_mirror;"," #[cfg(unix)]"," mod metadata_cache_filtered_write_failure;"," ","+mod release_age_upgrade;","+"," use mockito::Matcher;"," use pnpm_network::{AuthHeaders, RetryOpts, ThrottledClient};"," use tempfile::TempDir;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/fetch_full_metadata_cached/tests/release_age_upgrade.rs","lines":["@@ -0,0 +1,218 @@","+use mockito::Matcher;","+use pnpm_network::{AuthHeaders, ThrottledClient};","+use pnpm_registry::Package;","+use tempfile::TempDir;","+","+use super::{","+    super::fetch_release_age_upgrade, ABBREVIATED_META_DIR, FetchFullMetadataCachedOptions,","+    PACKAGE_BODY, get_pkg_mirror_path, load_meta, load_meta_headers, no_retry_opts,","+    save_meta_indexed,","+};","+use crate::mirror::save_fail::fail_next_mirror_save;","+","+const ACCEPT_FULL: &str = \"application/json; q=1.0, */*\";","+const ABBREVIATED_ETAG: &str = r#\"\"abbreviated-etag\"\"#;","+const FULL_ETAG: &str = r#\"\"full-etag\"\"#;","+const MODIFIED: &str = \"2025-01-15T12:00:00.000Z\";","+","+/// A temporary cache directory holding the abbreviated mirror of `acme`, as","+/// the abbreviated fetch recorded it.","+struct AbbreviatedMirror {","+    cache: TempDir,","+    registry: String,","+    http_client: ThrottledClient,","+    auth_headers: AuthHeaders,","+}","+","+impl AbbreviatedMirror {","+    fn new(server: &mockito::ServerGuard) -> Self {","+        let mirror = AbbreviatedMirror {","+            cache: TempDir::new().expect(\"tempdir\"),","+            registry: format!(\"{}/\", server.url()),","+            http_client: ThrottledClient::default(),","+            auth_headers: AuthHeaders::default(),","+        };","+        let meta: Package = serde_json::from_str(PACKAGE_BODY).expect(\"parse packument\");","+        save_meta_indexed(&mirror.path(), &meta, Some(ABBREVIATED_ETAG), false)","+            .expect(\"seed abbreviated mirror\");","+        mirror","+    }","+","+    fn path(&self) -> std::path::PathBuf {","+        get_pkg_mirror_path(self.cache.path(), ABBREVIATED_META_DIR, &self.registry, \"acme\")","+            .expect(\"abbreviated mirror path\")","+    }","+","+    fn opts(&self) -> FetchFullMetadataCachedOptions<'_> {","+        FetchFullMetadataCachedOptions {","+            registry: &self.registry,","+            cache_dir: Some(self.cache.path()),","+            full_metadata: false,","+            filter_metadata: false,","+            offline: false,","+            priority: pnpm_network::UNPRIORITIZED,","+            http: crate::MetadataHttpClient {","+                http_client: &self.http_client,","+                auth_headers: &self.auth_headers,","+                retry_opts: no_retry_opts(),","+            },","+        }","+    }","+}","+","+async fn full_document_mock(","+    server: &mut mockito::ServerGuard,","+    cache_control: Option<&str>,","+) -> mockito::Mock {","+    let mut mock = server","+        .mock(\"GET\", \"/acme\")","+        .match_header(\"accept\", ACCEPT_FULL)","+        .match_header(\"if-none-match\", Matcher::Missing)","+        .match_header(\"if-modified-since\", Matcher::Missing)","+        .with_status(200)","+        .with_header(\"etag\", FULL_ETAG)","+        .with_body(PACKAGE_BODY);","+    if let Some(cache_control) = cache_control {","+        mock = mock.with_header(\"cache-control\", cache_control);","+    }","+    mock.expect(1).create_async().await","+}","+","+#[tokio::test]","+async fn an_upgrade_over_an_abbreviated_mirror_sends_no_validators_and_records_the_full_etag() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let mock = full_document_mock(&mut server, None).await;","+","+    let meta = fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await.expect(\"upgrade\");","+    assert_eq!(meta.name, \"acme\");","+    mock.assert_async().await;","+","+    let headers = load_meta_headers(&mirror.path()).expect(\"headers readable\");","+    assert_eq!(headers.etag, None);","+    assert_eq!(headers.full_etag.as_deref(), Some(FULL_ETAG));","+    assert_eq!(headers.modified.as_deref(), Some(MODIFIED));","+    assert!(!headers.uncacheable);","+}","+","+#[tokio::test]","+async fn an_upgrade_records_an_uncacheable_full_response() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let mock = full_document_mock(&mut server, Some(\"no-store\")).await;","+","+    fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await.expect(\"upgrade\");","+    mock.assert_async().await;","+","+    let headers = load_meta_headers(&mirror.path()).expect(\"headers readable\");","+    assert!(headers.uncacheable);","+    assert_eq!(headers.etag, None);","+}","+","+#[tokio::test]","+async fn an_upgraded_mirror_is_revalidated_with_its_full_etag() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let upgrade = full_document_mock(&mut server, None).await;","+    fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await.expect(\"first upgrade\");","+    upgrade.assert_async().await;","+","+    let revalidation = server","+        .mock(\"GET\", \"/acme\")","+        .match_header(\"accept\", ACCEPT_FULL)","+        .match_header(\"if-none-match\", FULL_ETAG)","+        .with_status(304)","+        .expect(1)","+        .create_async()","+        .await;","+    let meta =","+        fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await.expect(\"second upgrade\");","+    assert_eq!(meta.name, \"acme\");","+    revalidation.assert_async().await;","+}","+","+#[tokio::test]","+async fn a_dry_run_upgrade_leaves_the_mirror_untouched() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let backdated = std::time::UNIX_EPOCH + std::time::Duration::from_secs(1_700_000_000);","+    std::fs::OpenOptions::new()","+        .write(true)","+        .open(mirror.path())","+        .and_then(|file| file.set_modified(backdated))","+        .expect(\"backdate the mirror\");","+    let before = std::fs::read(mirror.path()).expect(\"read mirror\");","+    let mock = full_document_mock(&mut server, None).await;","+","+    let meta = fetch_release_age_upgrade(\"acme\", &mirror.opts(), false).await.expect(\"upgrade\");","+    assert_eq!(meta.name, \"acme\");","+    mock.assert_async().await;","+","+    assert_eq!(std::fs::read(mirror.path()).expect(\"read mirror\"), before);","+    let mtime = std::fs::metadata(mirror.path()).and_then(|metadata| metadata.modified());","+    assert_eq!(mtime.expect(\"mirror mtime\"), backdated);","+}","+","+#[tokio::test]","+async fn a_failed_save_of_an_uncacheable_upgrade_removes_the_previous_mirror() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let mock = full_document_mock(&mut server, Some(\"no-store\")).await;","+","+    fail_next_mirror_save(&mirror.path());","+    fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await.expect(\"upgrade\");","+    mock.assert_async().await;","+","+    assert!(!mirror.path().exists());","+}","+","+#[tokio::test]","+async fn a_failed_save_of_a_cacheable_upgrade_keeps_the_previous_mirror() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let mock = full_document_mock(&mut server, None).await;","+","+    fail_next_mirror_save(&mirror.path());","+    fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await.expect(\"upgrade\");","+    mock.assert_async().await;","+","+    let headers = load_meta_headers(&mirror.path()).expect(\"previous mirror remains\");","+    assert_eq!(headers.etag.as_deref(), Some(ABBREVIATED_ETAG));","+    assert!(load_meta(&mirror.path()).is_some());","+}","+","+/// A `304` to the validator-free upgrade request is about nothing the mirror","+/// holds. It must fail the upgrade, for the caller to decline, and leave the","+/// abbreviated mirror unchanged rather than renew it as revalidated.","+#[tokio::test]","+async fn an_unsolicited_304_to_an_upgrade_leaves_the_abbreviated_mirror_alone() {","+    let mut server = mockito::Server::new_async().await;","+    let mirror = AbbreviatedMirror::new(&server);","+    let backdated = std::time::UNIX_EPOCH + std::time::Duration::from_secs(1_700_000_000);","+    std::fs::OpenOptions::new()","+        .write(true)","+        .open(mirror.path())","+        .and_then(|file| file.set_modified(backdated))","+        .expect(\"backdate the mirror\");","+    let mock = server","+        .mock(\"GET\", \"/acme\")","+        .match_header(\"accept\", ACCEPT_FULL)","+        .match_header(\"if-none-match\", Matcher::Missing)","+        .with_status(304)","+        .expect(2)","+        .create_async()","+        .await;","+","+    let error = fetch_release_age_upgrade(\"acme\", &mirror.opts(), true).await","+        .expect_err(\"an unsolicited 304 cannot upgrade\");","+    assert!(","+        matches!(error, crate::FetchMetadataError::NotModifiedWithoutCache { .. }),","+        \"expected NotModifiedWithoutCache, got {error:?}\",","+    );","+    mock.assert_async().await;","+","+    let mtime = std::fs::metadata(mirror.path()).and_then(|metadata| metadata.modified());","+    assert_eq!(mtime.expect(\"mirror mtime\"), backdated);","+    let headers = load_meta_headers(&mirror.path()).expect(\"headers readable\");","+    assert_eq!(headers.etag.as_deref(), Some(ABBREVIATED_ETAG));","+}"],"additions":218,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/metadata_cache_policy.rs","lines":["@@ -68,11 +68,13 @@ impl DocumentKind {","         }","     }"," ","-    /// The request that revalidates `stored`, the mirror this kind was chosen","-    /// for.","+    /// The request for this kind of document over `stored`, the header line","+    /// of the mirror slot it fills.","     ///","     /// - `bypass` drops the mirror: no validators, and `Cache-Control:","     ///   no-cache`, so only a body can answer.","+    /// - A mirror that recorded another kind sends no validators: they","+    ///   describe the other representation.","     /// - A mirror the registry marked uncacheable keeps its validators and","     ///   adds `Cache-Control: no-cache`, so an intermediary must ask the","     ///   origin, which can still answer `304`.","@@ -81,7 +83,10 @@ impl DocumentKind {","         stored: Option<&MetaHeaders>,","         bypass: bool,","     ) -> Revalidation<'_> {","-        let Some(stored) = stored.filter(|_| !bypass) else {","+        let recorded_here = |stored: &&MetaHeaders| {","+            DocumentKind::for_mirror(self == DocumentKind::Full, Some(stored)) == self","+        };","+        let Some(stored) = stored.filter(|_| !bypass).filter(recorded_here) else {","             return Revalidation { etag: None, modified: None, bypass_cache: bypass };","         };","         let etag = ma