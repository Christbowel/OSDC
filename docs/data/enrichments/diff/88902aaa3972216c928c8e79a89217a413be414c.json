}","-\tauto bind_info_clone = func.BindInfo() ? func.BindInfo()->Copy() : nullptr;","-\tBoundFunctionExpression clone(func.Function(), std::move(children), std::move(bind_info_clone), func.IsOperator());","-\treturn ExpressionExecutor::TryEvaluateScalar(context, clone, result);","+\t// Functions such as alias() inspect expression metadata during execution.","+\tauto clone = func.Copy();","+\tclone->Cast<BoundFunctionExpression>().GetChildrenMutable() = std::move(children);","+\treturn ExpressionExecutor::TryEvaluateScalar(context, *clone, result);","+}","+","+// Equal bounds need not imply identical inputs for certain types, so we skip this optimization for those values.","+// Floating-point bounds only lose information for the sign of zero.","+bool CanInferConstantFromNumericBounds(const Value &value) {","+\tswitch (value.type().InternalType()) {","+\tcase PhysicalType::FLOAT:","+\t\treturn value.GetValue<float>() != 0.0F;","+\tcase PhysicalType::DOUBLE:","+\t\treturn value.GetValue<double>() != 0.0;","+\tcase PhysicalType::INTERVAL:","+\t\treturn false;","+\tdefault:","+\t\treturn true;","+\t}","+}","+","+bool TryInferConstantBounds(const BaseStatistics &stats, Value &constant) {","+\tif (stats.CanHaveNull()) {","+\t\treturn false;","+\t}","+\tif (stats.GetStatsType() == StatisticsType::NUMERIC_STATS && NumericStats::HasMinMax(stats)) {","+\t\tauto min = NumericStats::Min(stats);","+\t\tauto max = NumericStats::Max(stats);","+\t\tif (min != max || !CanInferConstantFromNumericBounds(min)) {","+\t\t\treturn false;","+\t\t}","+\t\tconstant = std::move(min);","+\t\treturn true;","+\t}","+\tif ((stats.GetType().id() == LogicalTypeId::VARCHAR || stats.GetType().id() == LogicalTypeId::BLOB) &&","+\t    StringStats::HasMinMax(stats) && StringStats::GetMinType(stats) == StringStatsType::EXACT_STATS &&","+\t    StringStats::GetMaxType(stats) == StringStatsType::EXACT_STATS &&","+\t    StringStats::Min(stats) == StringStats::Max(stats)) {","+\t\tconstant = Value::BLOB_RAW(StringStats::Min(stats)).WithType(stats.GetType());","+\t\treturn true;","+\t}","+\treturn false;","+}","+} // namespace","+","+unique_ptr<BaseStatistics> StatisticsPropagator::PropagateConstantInputs(ClientContext &context,","+                                                                         const BoundFunctionExpression &func,","+                                                                         const vector<BaseStatistics> &child_stats) {","+\tif (func.Function().GetStability() != FunctionStability::CONSISTENT || func.GetChildren().empty()) {","+\t\treturn nullptr;","+\t}","+\t// Lambda arguments are placeholders, not SQL values that can be evaluated independently.","+\tif (func.Function().HasBindLambdaCallback()) {","+\t\treturn nullptr;","+\t}","+\tvector<Value> values;","+\tvalues.reserve(func.GetChildren().size());","+\tfor (idx_t idx = 0; idx < func.GetChildren().size(); ++idx) {","+\t\tauto &child = *func.GetChildren()[idx];","+\t\tauto &stats = child_stats[idx];","+\t\tValue value;","+\t\tif (child.IsFoldable()) {","+\t\t\tif (!ExpressionExecutor::TryEvaluateScalar(context, child, value)) {","+\t\t\t\treturn nullptr;","+\t\t\t}","+\t\t} else if (!TryInferConstantBounds(stats, value)) {","+\t\t\treturn nullptr;","+\t\t}","+\t\tvalues.emplace_back(std::move(value));","+\t}","+\tValue result;","+\tif (!TryEvaluateAtConstants(context, func, values, result)) {","+\t\treturn nullptr;","+\t}","+\treturn BaseStatistics::FromConstant(result).ToUnique();"," }"," "," //! Evaluate `func` at the lo/hi corner of each child's value range to derive output min/max.","@@ -144,6 +218,10 @@ unique_ptr<BaseStatistics> StatisticsPropagator::PropagateExpression(BoundFuncti"," \t\t\tstats.push_back(stat->Copy());"," \t\t}"," \t}","+\tauto constant_stats = PropagateConstantInputs(context, func, stats);","+\tif (constant_stats) {","+\t\treturn constant_stats;","+\t}"," \tif (func.Function().HasStatisticsCallback()) {"," \t\tFunctionStatisticsInput input(func, func.BindInfo().get(), stats, &expr_ptr);"," \t\treturn func.Function().GetStatisticsCallback()(context, input);"],"additions":83,"deletions":5,"truncated":false},{"path":"src/planner/filter/expression_filter.cpp","lines":["@@ -273,6 +273,11 @@ static optional_ptr<const BaseStatistics> TryGetExpressionStats(optional_ptr<Cli"," \t\t\t\tchild_stats.push_back(child_stat->Copy());"," \t\t\t}"," ","+\t\t\tauto constant_stats = StatisticsPropagator::PropagateConstantInputs(*context_p, func, child_stats);","+\t\t\tif (constant_stats) {","+\t\t\t\towned_stats.push_back(std::move(constant_stats));","+\t\t\t\treturn owned_stats.back().get();","+\t\t\t}"," \t\t\t// Use copy to avoid expression rewritten"," \t\t\tauto expr_copy = func.Copy();"," \t\t\tauto &func_copy = expr_copy->Cast<BoundFunctionExpression>();","@@ -284,7 +289,7 @@ static optional_ptr<const BaseStatistics> TryGetExpressionStats(optional_ptr<Cli"," \t\t// No custom callback: fall back to the declared monotonicity (ArgProperties) and derive output"," \t\t// bounds by evaluating the function at the corners of each argument's range. This lets a"," \t\t// f(col) OP const filter prune row groups via the zonemap of the base column.","-\t\tif (func.Function().HasArgProperties()) {","+\t\tif (func.Function().GetStability() == FunctionStability::CONSISTENT) {"," \t\t\tvector<BaseStatistics> child_stats;"," \t\t\tchild_stats.reserve(func.GetChildren().size());"," \t\t\tfor (auto &child_expr : func.GetChildren()) {","@@ -292,7 +297,10 @@ static optional_ptr<const BaseStatistics> TryGetExpressionStats(optional_ptr<Cli"," \t\t\t\tchild_stats.push_back(child_stat ? child_stat->Copy()"," \t\t\t\t                                 : BaseStatistics::CreateUnknown(child_expr->GetReturnType()));"," \t\t\t}","-\t\t\tauto derived = StatisticsPropagator::PropagateMonotoneBounds(*context_p, func, child_stats);","+\t\t\tauto derived = StatisticsPropagator::PropagateConstantInputs(*context_p, func, child_stats);","+\t\t\tif (!derived) {","+\t\t\t\