{"id":"3aaf0c1b098e485929ed60c9b99d4d2247cde99a","axis":"silent","repo":"mongodb/mongo","sha":"3aaf0c1b098e485929ed60c9b99d4d2247cde99a","parsed":{"files":[{"path":"bazel/docs/developer_workflow.md","lines":["@@ -100,10 +100,17 @@ Configure the clang-format extension to use the repository's wrapper:"," "," Use `${workspaceRoot}` because the `xaver.clang-format` extension expands this placeholder."," ","-The wrapper queries Bazel for the pinned v5 toolchain repository, fetching it if necessary, then","-runs clang-format with the editor's arguments and input. Bazel must be on the editor's PATH. The","-first invocation can take longer while Bazel downloads the toolchain. Each invocation resolves the","-current repository so a branch change or toolchain update uses the current pin.","+The wrapper checks a local binary against `buildscripts/clang_format_version.txt` and runs it","+directly, so format-on-save does not wait for concurrent Bazel builds. It caches the resolved path","+in `.cache/clang-format-vscode` and checks the binary's version on each save, including after a","+branch change. It also looks for toolchains already downloaded by a build.","+","+If no matching binary is available, the wrapper queries Bazel to fetch and locate the pinned v5","+toolchain. Bazel must be on the editor's PATH for this initial setup. The query fails immediately if","+Bazel is busy; run `bazel run lint` after the build finishes to prepare the formatter.","+`bazel run lint` checks that the editor's version pin matches Bazel's binary, and","+`bazel run lint --fix` updates the pin when the toolchain changes. The pin check runs on Linux,","+where Bazel provides the native formatter toolchain."," "," ## Running clang-tidy via Bazel"," "],"additions":11,"deletions":4,"truncated":false},{"path":"buildscripts/BUILD.bazel","lines":["@@ -8,6 +8,7 @@ exports_files([","     \"candle_wrapper.py\",","     \"cheetah_source_generator.py\",","     \"clang_format_vscode.sh\",","+    \"clang_format_version.txt\",","     \"clang_tidy_config_gen.py\",","     \"jstoh.py\",","     \"msitrim.py\",","@@ -16,6 +17,23 @@ exports_files([","     \"symbols-al2023.orderfile\","," ])"," ","+py_library(","+    name = \"clang_format_version_lib\",","+    srcs = [\"clang_format_version.py\"],","+    visibility = [\"//visibility:public\"],","+)","+","+py_binary(","+    name = \"clang_format_version\",","+    srcs = [\"clang_format_version.py\"],","+    args = [","+        \"--clang-format\",","+        \"$(location @mongo_toolchain_v5//:clang_format)\",","+    ],","+    data = [\"@mongo_toolchain_v5//:clang_format\"],","+    visibility = [\"//visibility:public\"],","+)","+"," py_library(","     name = \"msitrim_deps\",","     visibility = [\"//visibility:public\"],"],"additions":18,"deletions":0,"truncated":false},{"path":"buildscripts/clang_format_version.py","lines":["@@ -0,0 +1,48 @@","+\"\"\"Keep the editor's version pin in sync with Bazel's clang-format.\"\"\"","+","+import argparse","+import os","+import subprocess","+import tempfile","+from pathlib import Path","+","+","+def check_version(binary: Path, version_file: Path, *, fix: bool) -> bool:","+    result = subprocess.run([str(binary), \"--version\"], capture_output=True, text=True, check=True)","+    version = result.stdout.strip()","+    if not version or \"clang-format version \" not in version or \"\\n\" in version:","+        raise ValueError(f\"Unexpected clang-format version: {version!r}\")","+    expected = version_file.read_text().strip() if version_file.exists() else \"\"","+    if expected == version:","+        return True","+    if fix:","+        version_file.write_text(f\"{version}\\n\")","+        print(f\"Updated {version_file} to {version}\")","+        return True","+    print(f\"{version_file} is out of date: expected {expected!r}, Bazel uses {version!r}.\")","+    print(\"Run bazel run lint --fix to update the editor formatter version pin.\")","+    return False","+","+","+def main() -> int:","+    parser = argparse.ArgumentParser(description=__doc__)","+    parser.add_argument(\"--clang-format\", required=True, type=Path)","+    parser.add_argument(\"--check\", action=\"store_true\")","+    args = parser.parse_args()","+    binary = args.clang_format.resolve()","+    root = Path(os.environ.get(\"BUILD_WORKSPACE_DIRECTORY\", Path(__file__).resolve().parents[1]))","+    if not check_version(","+        binary, root / \"buildscripts/clang_format_version.txt\", fix=not args.check","+    ):","+        return 1","+    # Prepare the editor cache even when Bazel convenience symlinks are disabled.","+    cache = root / \".cache/clang-format-vscode\"","+    cache.parent.mkdir(parents=True, exist_ok=True)","+    with tempfile.NamedTemporaryFile(mode=\"w\", dir=cache.parent, delete=False) as temporary:","+        temporary.write(f\"{binary}\\n\")","+    Path(temporary.name).replace(cache)","+    return 0","+","+","+if __name__ == \"__main__\":","+    raise SystemExit(main())"],"additions":48,"deletions":0,"truncated":false},{"path":"buildscripts/clang_format_version.txt","lines":["@@ -0,0 +1 @@","+MongoDB clang-format version 19.1.7 (https://github.com/10gen/toolchain-builder)"],"additions":1,"deletions":0,"truncated":false},{"path":"buildscripts/clang_format_vscode.sh","lines":["@@ -1,9 +1,49 @@"," #!/usr/bin/env bash"," set -euo pipefail"," ","-# Resolve the pinned repository through Bazel instead of depending on convenience","-# symlinks or a canonical repository name, which can change between Bazel versions."," REPO_ROOT=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")/..\" && pwd)\"","+EXPECTED_VERSION=\"$(cat -- \"$REPO_ROOT/buildscripts/clang_format_version.txt\")\"","+if [[ -z \"$EXPECTED_VERSION\" ]]; then","+    printf 'The clang-format version pin is empty. Run bazel run lint --fix.\\n' >&2","+    exit 1","+fi","+CACHE_FILE=\"$REPO_ROOT/.cache/clang-format-vscode\"","+","+matches_version() {","+    local version","+    [[ -f \"$1\" && -x \"$1\" ]] || return 1","+    version=\"$(\"$1\" --version </dev/null 2>/dev/null)\" || return 1","+    [[ \"$version\" == \"$EXPECTED_VERSION\" ]]","+}","+","+remember_formatter() {","+    local temporary","+    # The cache is optional (for example, a checkout may be read-only). Publish","+    # the path atomically so simultaneous saves cannot read a partial entry.","+    mkdir -p -- \"$REPO_ROOT/.cache\" 2>/dev/null || return 0","+    temporary=\"$(mktemp \"$CACHE_FILE.XXXXXX\" 2>/dev/null)\" || return 0","+    if ! { printf '%s\\n' \"$1\" >\"$temporary\" && mv -f -- \"$temporary\" \"$CACHE_FILE\"; } 2>/dev/null; then","+        rm -f -- \"$temporary\" 2>/dev/null || true","+    fi","+}","+","+# Probe the binary itself: a branch switch changes the pin and Bazel may replace","+# a toolchain at the same path. Neither check requires a Bazel server lock.","+if [[ -f \"$CACHE_FILE\" ]] && IFS= read -r CLANG_FORMAT <\"$CACHE_FILE\" && matches_version \"$CLANG_FORMAT\"; then","+    exec \"$CLANG_FORMAT\" \"$@\"","+fi","+","+# Discover repositories fetched by a build before the first editor invocation.","+# The wildcard accommodates Bazel canonical repository naming changes.","+for CLANG_FORMAT in \"$REPO_ROOT\"/bazel-*/external/*mongo_toolchain_v5*/v5/bin/clang-format; do","+    if matches_version \"$CLANG_FORMAT\"; then","+        remember_formatter \"$CLANG_FORMAT\"","+        exec \"$CLANG_FORMAT\" \"$@\"","+    fi","+done","+","+# Resolve the pinned repository through Bazel only when no matching local binary","+# is available. A busy server must never block an editor save."," # The editor extension rejects any stderr, even when the formatter succeeds."," # Keep Bazel's setup diagnostics for failures without hiding formatter diagnostics."," BAZEL_STDERR=\"$(mktemp)\"","@@ -12,7 +52,7 @@ trap 'rm -f -- \"$BAZEL_STDERR\"' EXIT"," # Keep comments outside command substitutions: Bash 3.2 misparses apostrophes in them."," if LOCATION=\"$(","     cd -- \"$REPO_ROOT\" || exit","-    bazel query --noshow_progress --bes_backend= --bes_results_url= \\","+    BAZELISK_SKIP_WRAPPER=1 bazel --noblock_for_lock query --noshow_progress --bes_backend= --bes_results_url= \\","         --output=location @mongo_toolchain_v5//:clang_format </dev/null 2>\"$BAZEL_STDERR\""," )\"; then","     rm -f -- \"$BAZEL_STDERR\"","@@ -20,6 +60,7 @@ if LOCATION=\"$("," else","     QUERY_STATUS=$?","     cat -- \"$BAZEL_STDERR\" >&2","+    printf 'Could not prepare clang-format. Run bazel run lint when Bazel is available.\\n' >&2","     exit \"$QUERY_STATUS\""," fi"," ","@@ -39,5 +80,11 @@ if [[ ! -f \"$CLANG_FORMAT\" || ! -x \"$CLANG_FORMAT\" ]]; then","     exit 1"," fi"," ","+if ! matches_version \"$CLANG_FORMAT\"; then","+    printf 'Bazel clang-format does not match the version pin. Run bazel run lint --fix.\\n' >&2","+    exit 1","+fi","+remember_formatter \"$CLANG_FORMAT\"","+"," # Preserve arguments, stdin, stdout, working directory, and the formatter's status."," exec \"$CLANG_FORMAT\" \"$@\""],"additions":50,"deletions":3,"truncated":false},{"path":"buildscripts/quality_checks/adapters.py","lines":["@@ -464,6 +464,17 @@ def _run_validator(","     return run_python_tool(lambda: callback(**kwargs))"," "," ","+def run_clang_format_version(context: CheckContext, _matched: tuple[str, ...]) -> RunOutcome:","+    if platform.system() != \"Linux\":","+        return RunOutcome(0, skipped_reason=\"Bazel's native clang-format toolchain requires Linux\")","+    return run_subprocess(","+        _bazel_run_command(","+            context, \"//buildscripts:clang_format_version\", [] if context.fix else [\"--check\"]","+        ),","+        cwd=context.repo_root,","+    )","+","+"," def run_clang_tidy_config(context: CheckContext, _matched: tuple[str, ...]) -> RunOutcome:","     from buildscripts.bazel_custom_formatter import validate_clang_tidy_configs"," "],"additions":11,"deletions":0,"truncated":false},{"path":"buildscripts/quality_checks/manifest.py","lines":["@@ -108,6 +108,18 @@ def _codeowners_file(candidate: CandidateFile) -> bool:","         _any_file,","         adapters.run_bazel_server,","     ),","+    RegisteredCheck(","+        CheckSpec(","+            \"lint.clang-format-version\",","+            \"Editor clang-format version pin\",","+            \"lint\",","+            CheckPhase.MUTATING_SERIAL,","+            dependencies=_BAZEL_SERVER_DEPENDENCY,","+            supports_fix=True,","+        ),","+        _any_file,","+        adapters.run_clang_format_version,","+    ),","     RegisteredCheck(","         CheckSpec(","             \"lint.clang-tidy-config\","],"additions":12,"deletions":0,"truncated":false},{"path":"buildscripts/quality_checks/quality_checks_test.py","lines":["@@ -92,6 +92,7 @@ def test_shipped_manifest_is_valid_and_ids_are_stable(self):","         self.assertIn(\"format.formatters\", ids)","         self.assertIn(\"bazel.server\", ids)","         self.assertIn(\"lint.target-coverage\", ids)","+        self.assertIn(\"lint.clang-format-version\", ids)","         self.assertIn(\"lint.module-lockfile\", ids)","         self.assertIn(\"lint.copybara-forbidden-text\", ids)","         self.assertIn(\"lint.rules-lint\", ids)","@@ -237,6 +238,14 @@ def test_bazel_backed_checks_run_after_bazel_server_preflight(self):","         server = next(check for check in selected.checks if check.spec.check_id == \"bazel.server\")","         self.assertEqual(server.spec.phase, CheckPhase.PREFLIGHT_SERIAL)"," ","+    def test_lint_always_checks_formatter_version_pin(self):","+        selected = select_checks(","+            (CandidateFile(\"README.md\", ChangeStatus.MODIFIED),), groups=[\"lint\"]","+        )","+        self.assertIn(","+            \"lint.clang-format-version\", {check.spec.check_id for check in selected.checks}","+        )","+"," "," class CandidateDiscoveryTest(unittest.TestCase):","     def test_name_status_preserves_add_modify_delete_and_rename(self):","@@ -557,6 +566,33 @@ def test_all_skipped_reports_no_applicable_checks(self):"," "," "," class AdapterTest(unittest.TestCase):","+    @mock.patch.object(adapters.platform, \"system\", return_value=\"Linux\")","+    @mock.patch.object(adapters, \"run_subprocess\", return_value=RunOutcome(0))","+    def test_formatter_version_pin_is_checked_and_fixable(self, run, _system):","+        with tempfile.TemporaryDirectory() as temp:","+            context = _context(Path(temp), ())","+            context.bazel_real = \"/opt/bazel\"","+            context.bazel_startup_options = (\"--output_base=/tmp/bazel\",)","+            for fix in (False, True):","+                with self.subTest(fix=fix):","+                    context.fix = fix","+                    adapters.run_clang_format_version(context, ())","+                    command = run.call_args.args[0]","+                    self.assertEqual(command[:3], [\"/opt/bazel\", \"--output_base=/tmp/bazel\", \"run\"])","+                    self.assertIn(\"//buildscripts:clang_format_version\", command)","+                    self.assertEqual(\"--check\" in command, not fix)","+","+    def test_formatter_version_pin_skips_unsupported_hosts(self):","+        for system in (\"Darwin\", \"Windows\"):","+            with (","+                self.subTest(system=system),","+                mock.patch.object(adapters.platform, \"system\", return_value=system),","+                mock.patch.object(adapters, \"run_subprocess\") as run,","+            ):","+                outcome = adapters.run_clang_format_version(_context(Path(\".\"), ()), ())","+            self.assertIsNotNone(outcome.skipped_reason)","+            run.assert_not_called()","+","     def test_progress_stream_is_not_captured_with_in_process_tool_output(self):","         with tempfile.TemporaryFile(mode=\"w+\", encoding=\"utf-8\") as terminal:","             saved_stderr_fd = os.dup(2)"],"additions":36,"deletions":0,"truncated":false},{"path":"buildscripts/tests/BUILD.bazel","lines":["@@ -58,6 +58,13 @@ py_test(","     visibility = [\"//visibility:public\"],"," )"," ","+py_test(","+    name = \"test_clang_format_version\",","+    srcs = [\"test_clang_format_version.py\"],","+    visibility = [\"//visibility:public\"],","+    deps = [\"//buildscripts:clang_format_version_lib\"],","+)","+"," py_test(","     name = \"test_mongo_toolchain\",","     srcs = [\"test_mongo_toolchain.py\"],"],"additions":7,"deletions":0,"truncated":false},{"path":"buildscripts/tests/test_clang_format_version.py","lines":["@@ -0,0 +1,95 @@","+\"\"\"Verify that lint detects and fixes drift in the editor formatter pin.\"\"\"","+","+import subprocess","+import tempfile","+import unittest","+from contextlib import redirect_stdout","+from io import StringIO","+from pathlib import Path","+from unittest import mock","+","+from buildscripts.clang_format_version import check_version, main","+","+","+class TestClangFormatVersion(unittest.TestCase):","+    def setUp(self) -> None:","+        self.tempdir = tempfile.TemporaryDirectory()","+        self.addCleanup(self.tempdir.cleanup)","+        self.pin = Path(self.tempdir.name) / \"clang_format_version.txt\"","+        self.pin.write_text(\"MongoDB clang-format version 18.1.0\\n\")","+        self.binary = Path(\"/toolchain/bin/clang-format\")","+","+    def check(self, version: str, *, fix: bool) -> bool:","+        with (","+            mock.patch(","+                \"buildscripts.clang_format_version.subprocess.run\",","+                return_value=subprocess.CompletedProcess([], 0, stdout=version),","+            ) as run,","+            redirect_stdout(StringIO()),","+        ):","+            result = check_version(self.binary, self.pin, fix=fix)","+        run.assert_called_once_with(","+            [str(self.binary), \"--version\"], capture_output=True, text=True, check=True","+        )","+        return result","+","+    def test_check_detects_drift_without_modifying_pin(self) -> None:","+        self.assertFalse(self.check(\"MongoDB clang-format version 19.1.7\\n\", fix=False))","+        self.assertEqual(self.pin.read_text(), \"MongoDB clang-format version 18.1.0\\n\")","+","+    def test_fix_updates_pin_and_subsequent_check_passes(self) -> None:","+        version = \"MongoDB clang-format version 19.1.7\\n\"","+        self.assertTrue(self.check(version, fix=True))","+        self.assertEqual(self.pin.read_text(), version)","+        self.assertTrue(self.check(version, fix=False))","+","+    def test_missing_pin_can_be_created(self) -> None:","+        self.pin.unlink()","+        self.assertFalse(self.check(\"MongoDB clang-format version 19.1.7\", fix=False))","+        self.assertTrue(self.check(\"MongoDB clang-format version 19.1.7\", fix=True))","+","+    def test_invalid_version_output_does_not_replace_pin(self) -> None:","+        for version in (\"\", \"noop\", \"clang-format version 19.1.7\\nextra output\"):","+            with self.subTest(version=version), self.assertRaises(ValueError):","+                self.check(version, fix=True)","+        self.assertEqual(self.pin.read_text(), \"MongoDB clang-format version 18.1.0\\n\")","+","+    def test_failed_probe_does_not_replace_pin(self) -> None:","+        with (","+            mock.patch(","+                \"buildscripts.clang_format_version.subprocess.run\",","+                side_effect=subprocess.CalledProcessError(23, [str(self.binary), \"--version\"]),","+            ),","+            self.assertRaises(subprocess.CalledProcessError),","+        ):","+            check_version(self.binary, self.pin, fix=True)","+        self.assertEqual(self.pin.read_text(), \"MongoDB clang-format version 18.1.0\\n\")","+","+    def test_lint_prepares_editor_cache_without_modifying_matching_pin(self) -> None:","+        # Use a relative path so this test exercises resolution on every host,","+        # including Windows adding the current drive to a drive-less path.","+        self.binary = Path(\"toolchain/bin/clang-format\")","+        root = Path(self.tempdir.name)","+        (root / \"buildscripts\").mkdir()","+        pin = root / \"buildscripts/clang_format_version.txt\"","+        version = \"MongoDB clang-format version 19.1.7\\n\"","+        pin.write_text(version)","+        with (","+            mock.patch.dict(\"os.environ\", {\"BUILD_WORKSPACE_DIRECTORY\": str(root)}),","+            mock.patch(","+                \"sys.argv\", [\"version-check\", \"--clang-format\", str(self.binary), \"--check\"]","+            ),","+            mock.patch(","+                \"buildscripts.clang_format_version.subprocess.run\",","+                return_value=subprocess.CompletedProcess([], 0, stdout=version),","+            ),","+        ):","+            self.assertEqual(main(), 0)","+        self.assertEqual(pin.read_text(), version)","+        self.assertEqual(","+            (root / \".cache/clang-format-vscode\").read_text(), f\"{self.binary.resolve()}\\n\"","+        )","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"additions":95,"deletions":0,"truncated":false},{"path":"buildscripts/tests/test_clang_format_vscode.py","lines":["@@ -24,16 +24,18 @@ def setUp(self) -> None:","         scripts.mkdir(parents=True)","         self.wrapper = scripts / \"clang_format_vscode.sh\"","         shutil.copy2(Path(__file__).parents[1] / self.wrapper.name, self.wrapper)","+        self.version_file = scripts / \"clang_format_version.txt\"","+        self.version_file.write_text(\"MongoDB clang-format version 19.1.7\\n\")","         self.caller = self.workspace / \"src\"","         self.caller.mkdir()","-        self.repo = self.root / \"output base:custom\" / \"external\" / \"+extension+toolchain\"","+        self.repo = self.root / \"output base:custom\" / \"external\" / \"+extension+mongo_toolchain_v5\"","         self.bin_dir = self.root / \"bin\"","         self.bin_dir.mkdir()","         bazel = self.bin_dir / \"bazel\"","         bazel.write_text(","             \"\"\"#!/usr/bin/env bash"," set -euo pipefail","-