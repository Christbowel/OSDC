ckage.json\");","+    fs::write(","+        &path,","+        \"{\\n  \\\"name\\\": \\\"test-pkg\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"zebra\\\": \\\"1.0.0\\\",\\n    \\\"alpha\\\": \\\"1.0.0\\\"\\n  }\\n}\\n\",","+    )","+    .unwrap();","+","+    pkg_set(&path, &[\"dependencies={}\".to_string()], true).unwrap();","+","+    assert_eq!(","+        fs::read_to_string(&path).unwrap(),","+        \"{\\n  \\\"name\\\": \\\"test-pkg\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"zebra\\\": \\\"1.0.0\\\",\\n    \\\"alpha\\\": \\\"1.0.0\\\"\\n  },\\n  \\\"dependencies\\\": {}\\n}\\n\",","+    );","+}","+","+#[test]","+fn test_pkg_fix_preserves_dev_engines_runtime_when_removing_invalid_dev_dependencies() {","+    let dir = tempdir().unwrap();","+    let path = dir.path().join(\"package.json\");","+    let runtime = json!({","+        \"name\": \"node\",","+        \"version\": \"22.14.0\",","+        \"onFail\": \"download\",","+    });","+    fs::write(","+        &path,","+        serde_json::to_string_pretty(&json!({","+            \"name\": \"test-pkg\",","+            \"devDependencies\": \"invalid\",","+            \"devEngines\": { \"runtime\": runtime },","+        }))","+        .unwrap(),","+    )","+    .unwrap();","+","+    pkg_fix(&path).unwrap();","+","+    let saved: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();","+    assert!(saved.get(\"devDependencies\").is_none());","+    assert_eq!(saved[\"devEngines\"][\"runtime\"], runtime);","+}"],"additions":136,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pkg_recursive.rs","lines":["@@ -1,8 +1,14 @@"," use command_extra::CommandExtra;","-use pnpm_testing_utils::bin::CommandTempCwd;","+use pnpm_testing_utils::{bin::CommandTempCwd, command_env::CommandTestExt};"," use pretty_assertions::assert_eq;"," use serde_json::{Value, json};","-use std::{fs, path::Path};","+use std::{fs, path::Path, process::Command};","+","+fn command(template: &Command) -> Command 