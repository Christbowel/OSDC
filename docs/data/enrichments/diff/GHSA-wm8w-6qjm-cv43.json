ession')","+  if (!session.value) {","+    return navigateTo('/login')","+  }","+})"],"additions":6,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/app/middleware/require-session.ts","lines":["@@ -0,0 +1,6 @@","+export default defineNuxtRouteMiddleware(() => {","+  const session = useCookie('session')","+  if (!session.value) {","+    return navigateTo('/login')","+  }","+})"],"additions":6,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/app/pages/login.vue","lines":["@@ -0,0 +1,8 @@","+<template>","+  <div>","+    <h1>login</h1>","+    <div data-testid=\"marker\">","+      no-marker","+    </div>","+  </div>","+</template>"],"additions":8,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/app/pages/protected/cache-cookie.vue","lines":["@@ -0,0 +1,20 @@","+<script setup lang=\"ts\">","+definePageMeta({ middleware: ['require-session'] })","+","+const { data } = await useFetch('/api/me', {","+  key: 'cache-cookie-me',","+  headers: useRequestHeaders(['cookie', 'authorization']),","+})","+</script>","+","+<template>","+  <div>","+    <h1>cache-cookie</h1>","+    <div data-testid=\"marker\">","+      {{ data?.marker }}","+    </div>","+    <div data-testid=\"secret\">","+      {{ data?.secret }}","+    </div>","+  </div>","+</template>"],"additions":20,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/app/pages/protected/isr-appmw.vue","lines":["@@ -0,0 +1,18 @@","+<script setup lang=\"ts\">","+const { data } = await useFetch('/api/me', {","+  key: 'isr-appmw-me',","+  headers: useRequestHeaders(['cookie', 'authorization']),","+})","+</script>","+","+<template>","+  <div>","+    <h1>isr-appmw</h1>","+    <div data-testid=\"marker\">","+      {{ data?.marker }}","+    </div>","+    <div data-testid=\"secret\">","+      {{ data?.secret }}","+    </div>","+  </div>","+</template>"],"additions":18,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/nuxt.config.ts","lines":["@@ -0,0 +1,9 @@","+import { isNuxtPrepare, projectSuffix, withMatrix } from '../../matrix'","+","+export default withMatrix({","+  ...(isNuxtPrepare ? {} : { buildDir: `.nuxt-${projectSuffix}` }),","+  routeRules: {","+    '/protected/cache-cookie': { cache: { maxAge: 60, varies: ['cookie'] } },","+    '/protected/isr-appmw': { isr: 60, appMiddleware: 'require-session-app' },","+  },","+})"],"additions":9,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/package.json","lines":["@@ -0,0 +1,11 @@","+{","+  \"name\": \"fixture-payload-cache-leak\",","+  \"private\": true,","+  \"type\": \"module\",","+  \"dependencies\": {","+    \"nuxt\": \"workspace:*\"","+  },","+  \"engines\": {","+    \"node\": \"^22.19.0 || ^24.11.0 || >=26.0.0\"","+  }","+}"],"additions":11,"deletions":0,"truncated":false},{"path":"test/fixtures/payload-cache-leak/server/api/me.ts","lines":["@@ -0,0 +1,13 @@","+export default defineEventHandler((event) => {","+  const cookie = getCookie(event, 'session')","+  const auth = getHeader(event, 'authorization')?.replace(/^Bearer\\s+/i, '')","+  const principal = cookie || auth || null","+  if (!principal) {","+    throw createError({ statusCode: 401, statusMessage: 'unauthenticated' })","+  }","+  return {","+    principal,","+    marker: `MARKER-${principal}`,","+    secret: `secret-for-${principal}`,","+  }","+})"],"additions":13,"deletions":0,"truncated":false},{"path":"test/payload-cache-leak.test.ts","lines":["@@ -0,0 +1,94 @@","+import { fileURLToPath } from 'node:url'","+import { describe, expect, it } from 'vitest'","+import { isWindows } from 'std-env'","+import { fetch, setup } from '@nuxt/test-utils/e2e'","+","+import { isDev, isRenderingJson, runsOncePerEnvInMatrix } from './matrix'","+","+// Regression coverage: a runtime payload cache keyed by path only would replay one","+// principal's `/_payload.json` to other users before middleware/guards ran. Two rule","+// shapes are covered: a `cache` route with `varies` + middleware (cross-user), and an","+// `isr` route with `appMiddleware` (unauthenticated).","+","+const USER_A = 'userA'","+const USER_B = 'userB'","+const MARKER_A = `MARKER-${USER_A}`","+const MARKER_B = `MARKER-${USER_B}`","+","+const payloadFile = isRenderingJson ? '_payload.json' : '_payload.js'","+","+// Only exercise this once per environment (dev + built); the leak is builder-independent.","+const shouldRun = runsOncePerEnvInMatrix","+","+if (shouldRun) {","+  await setup({","+    rootDir: fileURLToPath(new URL('./fixtures/payload-cache-leak', import.meta.url)),","+    dev: isDev,","+    server: true,","+    setupTimeout: (isWindows ? 360 : 120) * 1000,","+    nuxtConfig: {","+      hooks: {","+        'modules:done' () {","+          if (!isDev) {","+            process.env.NODE_ENV = 'production'","+          }","+        },","+      },","+    },","+  })","+}","+","+async function get (path: string, headers?: Record<string, string>) {","+  const res = await fetch(path, headers ? { headers } : undefined)","+  return { status: res.status, text: await res.text() }","+}","+","+const cookie = (user: string) => ({ cookie: `session=${user}` })","+","+describe.skipIf(!shouldRun)('payload cache cross-user / unauthenticated disclosure (GHSA-wm8w-6qjm-cv43)', () => {","+  it('does not serve a protected payload to an unauthenticated request before any warm', async () => {","+    const res = await get(`/protected/cache-cookie/${payloadFile}`)","+    expect(res.text).not.toContain(MARKER_A)","+    expect(res.text).not.toContain(MARKER_B)","+    expect(res.text).not.toContain('secret-for-')","+  })","+","+  describe('cache + cache.varies:[cookie] + named middleware', () => {","+    const page = '/protected/cache-cookie'","+","+    it('warms as user A', async () => {","+      const res = await get(page, cookie(USER_A))","+      expect(res.status).toBe(200)","+      expect(res.text).toContain(MARKER_A)","+    })","+","+    it('never returns user A payload to user B, and re-renders B their own payload', async () => {","+      const res = await get(`${page}/${payloadFile}`, cookie(USER_B))","+      expect(res.text).not.toContain(MARKER_A)","+      expect(res.text).not.toContain('secret-for-userA')","+      expect(res.text).toContain(MARKER_B)","+    })","+","+    it('serves user B only their own data over HTML and payload', async () => {","+      const html = await get(page, cookie(USER_B))","+      expect(html.text).toContain(MARKER_B)","+      expect(html.text).not.toContain(MARKER_A)","+    })","+  })","+","+  describe('isr + routeRules.appMiddleware', () => {","+    const page = '/protected/isr-appmw'","+","+    it('warms as user A', async () => {","+      const res = await get(page, cookie(USER_A))","+      expect(res.status).toBe(200)","+      expect(res.text).toContain(MARKER_A)","+    })","+","+    it('never returns user A payload to an unauthenticated request', async () => {","+      const res = await get(`${page}/${payloadFile}`)","+      expect(res.text).not.toContain(MARKER_A)","+      expect(res.text).not.toContain('secret-for-userA')","+    })","+  })","+})",""],"additions":94,"deletions":0,"truncated":false}],"additions":210,"deletions":23,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-08-06T10:23:36.296786+00:00"}