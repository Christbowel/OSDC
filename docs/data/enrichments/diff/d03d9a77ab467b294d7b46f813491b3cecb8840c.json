{"id":"d03d9a77ab467b294d7b46f813491b3cecb8840c","axis":"silent","repo":"tinacms/tinacms","sha":"d03d9a77ab467b294d7b46f813491b3cecb8840c","parsed":{"files":[{"path":"packages/v4/@tinacms/tinacms/e2e/foot-sheet-consumers.spec.ts","lines":["@@ -0,0 +1,404 @@","+import { expect, type Locator, type Page, test } from '@playwright/test';","+","+const SCREEN = { width: 390, height: 844 };","+const KEYBOARD = 336;","+","+const BRANCHES = '/branches.html?docs=1';","+const POSTS_FOLDER = '/#/collections/post/folder/guides';","+const MEDIA = '/#/screens/media';","+const HOME = `/#/collections/page/${encodeURIComponent('content/pages/home.mdx')}`;","+","+const SHEET = '[data-slot=foot-sheet]:not([hidden])';","+","+// The sheet rises over its slide-in time; measure once it has stopped.","+const settle = (page: Page) => page.waitForTimeout(400);","+","+const box = async (locator: Locator) => {","+  const found = await locator.boundingBox();","+  if (!found) throw new Error('no box');","+  return found;","+};","+","+// A keyboard shrinks the visual viewport and leaves the layout viewport alone.","+const fakeKeyboard = (page: Page, shrink: number) =>","+  page.evaluate((by) => {","+    const visual = window.visualViewport;","+    if (!visual) throw new Error('no visual viewport');","+    Object.defineProperty(visual, 'height', {","+      configurable: true,","+      value: window.innerHeight - by,","+    });","+    visual.dispatchEvent(new Event('resize'));","+  }, shrink);","+","+const foot = async (sheet: Locator) => {","+  const rect = await box(sheet);","+  return Math.round(rect.y + rect.height);","+};","+","+/** AC1: a foot sheet at the screen's foot, at least half the screen, with handle, x and focus inside. */","+const expectFootSheet = async (page: Page) => {","+  const sheet = page.locator(SHEET);","+  await expect(sheet).toBeVisible();","+  await settle(page);","+  const rect = await box(sheet);","+  expect(Math.abs(rect.y + rect.height - SCREEN.height)).toBeLessThanOrEqual(1);","+  expect(rect.height).toBeGreaterThanOrEqual(SCREEN.height / 2 - 1);","+  await expect(","+    sheet.getByRole('button', { name: 'Close sheet' })","+  ).toBeVisible();","+  await expect(","+    sheet.getByRole('button', { name: 'Close', exact: true })","+  ).toBeVisible();","+  expect(","+    await sheet.evaluate((el) => el.contains(document.activeElement))","+  ).toBe(true);","+  return sheet;","+};","+","+const expectClosed = (page: Page) => expect(page.locator(SHEET)).toHaveCount(0);","+","+const openRowMenu = async (page: Page, label: string, item: string) => {","+  await page.getByRole('button', { name: `Actions for ${label}` }).click();","+  await page.getByRole('menuitem', { name: item }).click();","+};","+","+test.use({ viewport: SCREEN });","+","+test.describe('dialogs as foot sheets on a phone', () => {","+  test('the branch switcher lists branches and its New branch form closes with Back to branches', async ({","+    page,","+  }) => {","+    await page.goto(BRANCHES);","+    await page.getByRole('button', { name: /^Branch: / }).click();","+    const sheet = await expectFootSheet(page);","+    await sheet.getByRole('button', { name: 'New branch' }).click();","+    await expect(","+      sheet.getByRole('form', { name: 'New branch form' })","+    ).toBeVisible();","+    await expectFootSheet(page);","+    await sheet.getByRole('button', { name: 'Back to branches' }).click();","+    await expect(","+      sheet.getByRole('form', { name: 'New branch form' })","+    ).toBeHidden();","+    await sheet.getByRole('button', { name: 'Close', exact: true }).click();","+    await expectClosed(page);","+  });","+","+  test('the collection table rename dialog', async ({ page }) => {","+    await page.goto(POSTS_FOLDER);","+    await openRowMenu(page, 'Getting started', 'Rename');","+    const sheet = await expectFootSheet(page);","+    await expect(","+      sheet.getByRole('textbox', { name: 'File name' })","+    ).toBeVisible();","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+","+  test('the collection table rename dialog rides on the keyboard with its field and buttons in view', async ({","+    page,","+  }) => {","+    await page.goto(POSTS_FOLDER);","+    await openRowMenu(page, 'Getting started', 'Rename');","+    const sheet = await expectFootSheet(page);","+    await fakeKeyboard(page, KEYBOARD);","+    await expect.poll(() => foot(sheet)).toBe(SCREEN.height - KEYBOARD);","+    await expect(","+      sheet.getByRole('textbox', { name: 'File name' })","+    ).toBeInViewport();","+    await expect(","+      sheet.getByRole('button', { name: 'Cancel' })","+    ).toBeInViewport();","+    await expect(","+      sheet.getByRole('button', { name: 'Rename' })","+    ).toBeInViewport();","+    await fakeKeyboard(page, 0);","+    await expect.poll(() => foot(sheet)).toBe(SCREEN.height);","+  });","+","+  test('the collection table document delete confirm', async ({ page }) => {","+    await page.goto(POSTS_FOLDER);","+    await openRowMenu(page, 'Getting started', 'Delete');","+    const sheet = await expectFootSheet(page);","+    await expect(page.getByRole('alertdialog')).toBeVisible();","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+","+  test('the collection table folder delete confirm', async ({ page }) => {","+    await page.goto('/#/collections/post?max');","+    await openRowMenu(page, 'guides', 'Delete');","+    const sheet = await expectFootSheet(page);","+    await expect(page.getByRole('alertdialog')).toBeVisible();","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+","+  test('the search dialog is laid out from the top with its field focused', async ({","+    page,","+  }) => {","+    await page.goto('/');","+    await page","+      .getByRole('button', { name: /Search/ })","+      .first()","+      .click();","+    const sheet = await expectFootSheet(page);","+    await expect(","+      sheet.getByRole('searchbox', { name: 'Search' })","+    ).toBeFocused();","+    const title = await box(sheet.getByText('Search', { exact: true }).first());","+    const field = await box(sheet.getByRole('searchbox', { name: 'Search' }));","+    expect(title.y).toBeLessThan(field.y);","+    await sheet.getByRole('button', { name: 'Close', exact: true }).click();","+    await expectClosed(page);","+  });","+","+  test('the image field confirm and its picker dialog', async ({ page }) => {","+    await page.goto(HOME);","+    const field = page.getByRole('group', { name: 'Hero image' });","+    await field.getByRole('button', { name: 'Choose from Media' }).click();","+    const picker = await expectFootSheet(page);","+    await expect(","+      picker.getByRole('heading', { name: 'Choose an image' })","+    ).toBeVisible();","+    await picker.getByRole('button', { name: 'preview.svg' }).click();","+    await picker.getByRole('button', { name: 'Insert' }).click();","+    await expectClosed(page);","+","+    const dataTransfer = await page.evaluateHandle(() => {","+      const transfer = new DataTransfer();","+      transfer.items.add(","+        new File(['<svg xmlns=\"http://www.w3.org/2000/svg\"/>'], 'dropped.svg', {","+          type: 'image/svg+xml',","+        })","+      );","+      return transfer;","+    });","+    await field.dispatchEvent('dragenter', { dataTransfer });","+    await field.dispatchEvent('dragover', { dataTransfer });","+    await field.dispatchEvent('drop', { dataTransfer });","+    const confirm = await expectFootSheet(page);","+    await expect(page.getByRole('alertdialog')).toBeVisible();","+    await confirm.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+});","+","+test.describe('media manager confirms as foot sheets on a phone', () => {","+  const pane = (page: Page) =>","+    page.getByRole('complementary', { name: 'Media' });","+","+  const select = async (page: Page) => {","+    await page.goto(MEDIA);","+    await pane(page)","+      .getByRole('button', { name: 'Select', exact: true })","+      .click();","+    await pane(page).getByRole('checkbox', { name: 'preview.svg' }).click();","+  };","+","+  test('the delete confirm', async ({ page }) => {","+    await select(page);","+    await pane(page)","+      .getByRole('button', { name: /^Delete/ })","+      .click();","+    const sheet = await expectFootSheet(page);","+    await expect(page.getByRole('alertdialog')).toBeVisible();","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+","+  test('the move dialog', async ({ page }) => {","+    await select(page);","+    await pane(page).getByRole('button', { name: 'Move', exact: true }).click();","+    const sheet = await expectFootSheet(page);","+    await expect(","+      sheet.getByRole('navigation', { name: 'Move to' })","+    ).toBeVisible();","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+","+  test('the New folder form keeps its field above the keyboard', async ({","+    page,","+  }) => {","+    await page.goto(MEDIA);","+    await pane(page).getByRole('button', { name: 'New folder' }).click();","+    const sheet = await expectFootSheet(page);","+    const field = sheet.getByRole('textbox', { name: 'Folder name' });","+    await field.focus();","+    await fakeKeyboard(page, KEYBOARD);","+    await expect.poll(() => foot(sheet)).toBe(SCREEN.height - KEYBOARD);","+    await expect(field).toBeInViewport();","+    expect(","+      (await box(field)).y + (await box(field)).height","+    ).toBeLessThanOrEqual(SCREEN.height - KEYBOARD);","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expectClosed(page);","+  });","+","+  test('the New folder form in the image picker keeps its field above the keyboard', async ({","+    page,","+  }) => {","+    await page.goto(HOME);","+    await page","+      .getByRole('group', { name: 'Hero image' })","+      .getByRole('button', { name: 'Choose from Media' })","+      .click();","+    await expectFootSheet(page);","+    await page.getByRole('button', { name: 'New Folder' }).click();","+    const sheet = page.locator(SHEET).last();","+    await settle(page);","+    const field = sheet.getByRole('textbox', { name: 'Folder name' });","+    await field.focus();","+    await fakeKeyboard(page, KEYBOARD);","+    await expect.poll(() => foot(sheet)).toBe(SCREEN.height - KEYBOARD);","+    expect(","+      (await box(field)).y + (await box(field)).height","+    ).toBeLessThanOrEqual(SCREEN.height - KEYBOARD);","+    await sheet.getByRole('button', { name: 'Cancel' }).click();","+    await expect(","+      page.getByRole('textbox', { name: 'Folder name' })","+    ).toHaveCount(0);","+  });","+});","+","+test.describe('a long usage list keeps the confirm usable on a small phone', () => {","+  const SIZES = [","+    { width: 375, height: 667 },","+    { width: 320, height: 568 },","+  ];","+","+  // Stored drafts count as unsaved uses, so ten of them make a ten-document usage list.","+  const seedUsage = (page: Page, count = 10) =>","+    page.addInitScript((uses) => {","+      for (let i = 0; i < uses; i++) {","+        const values = { title: `Used ${i}`, image: 'preview.svg' };","+        localStorage.setItem(","+          `tina-drafts:content/pages/used-with-a-long-file-name-${i}.mdx`,","+          JSON.stringify({","+            version: 2,","+            values,","+            baseline: { title: `Used ${i}` },","+          })","+        );","+      }","+    }, count);","+","+  // Forty folders beside the file, so the Move list fills its own box and the sheet overflows.","+  const manyFolders = (page: Page) =>","+    page.route('**/api/tina/media?*', (route) =>","+      route.fulfill({","+        json: {","+          items: [","+            { path: 'preview.svg', kind: 'file' },","+            ...Array.from({ length: 40 }, (_, i) => ({","+              path: `folder-${i}`,","+              kind: 'directory',","+            })),","+          ],","+        },","+      })","+    );","+","+  const expectReachable = async (page: Page, size: { height: number }) => {","+    const sheet = page.locator(SHEET);","+    await expect(sheet).toBeVisible();","+    await expect(","+      sheet.getByRole('button', { name: /^Open used-with-a-long-file-name-9/ })","+    ).toBeAttached();","+    await settle(page);","+    const header = await box(sheet.locator('[data-slot=alert-dialog-header]'));","+    const footer = await box(sheet.locator('[data-slot=alert-dialog-footer]'));","+    expect(header.height).toBeGreaterThan(0);","+    const natural = await sheet","+      .locator('[data-slot=alert-dialog-header]')","+      .evaluate((el) => el.scrollHeight);","+    expect(header.height).toBeGreaterThanOrEqual(","+      Math.min(natural, size.height * 0.4) - 1","+    );","+    expect(header.height).toBeLessThanOrEqual(size.height * 0.4 + 1);","+    expect(header.y + header.height).toBeLessThanOrEqual(footer.y + 1);","+    await expect(sheet.locator('[data-slot=alert-dialog-title]')).toBeVisible();","+    await expect(","+      sheet.getByRole('button', { name: 'Cancel' })","+    ).toBeInViewport();","+    return sheet;","+  };","+","+  const openMedia = async (","+    page: Page,","+    size: { width: number; height: number },","+    action: 'Delete' | 'Move',","+    uses: number","+  ) => {","+    await page.setViewportSize(size);","+    await seedUsage(page, uses);","+    await manyFolders(page);","+    await page.goto(MEDIA);","+    const pane = page.getByRole('complementary', { name: 'Media' });","+    await pane.getByRole('button', { name: 'Select', exact: true }).click();","+    await pane.getByRole('checkbox', { name: 'preview.svg' }).click();","+    await pane","+      .getByRole('button', {","+        name: action === 'Delete' ? /^Delete/ : 'Move',","+        exact: action === 'Move',","+      })","+      .click();","+  };","+","+  // The sheet scrolls instead of squeezing the folder list, in landscape too.","+  for (const size of [","+    { width: 667, height: 375 },","+    { width: 568, height: 320 },","+    { width: 375, height: 667 },","+    { width: 320, height: 568 },","+  ]) {","+    for (const uses of [0, 3, 8]) {","+      test(`the move folder list is usable at ${size.width}x${size.height} with the file used in ${uses}`, async ({","+        page,","+      }) => {","+        await openMedia(page, size, 'Move', uses);","+        const sheet = page.locator(SHEET);","+        await expect(sheet).toBeVisible();","+        await settle(page);","+        await expect(","+          sheet.locator('[data-slot=alert-dialog-title]')","+        ).toBeVisible();","+        const list = sheet.getByRole('list', { name: 'Folders' });","+        await expect(list.getByRole('button').first()).toBeVisible();","+        expect((await box(list)).height).toBeGreaterThanOrEqual(80);","+        const folder = list.getByRole('button', { name: 'folder-0' });","+        await folder.scrollIntoViewIfNeeded();","+        await expect(folder).toBeInViewport();","+        await folder.click();","+        const moveHere = sheet.getByRole('button', { name: 'Move here' });","+        await expect(moveHere).toBeEnabled();","+        await moveHere.scrollIntoViewIfNeeded();","+        await moveHere.click({ trial: true });","+      });","+    }","+  }","+","+  for (const size of SIZES) {","+    const label = `${size.width}x${size.height}`;","+    const open = (page: Page, action: 'Delete' | 'Move') =>","+      openMedia(page, size, action, 10);","+","+    test(`the delete confirm at ${label}`, async ({ page }) => {","+      await open(page, 'Delete');","+      const sheet = await expectReachable(page, size);","+      await expect(","+        sheet.getByRole('button', { name: 'Delete', exact: true })","+      ).toBeInViewport();","+    });","+","+    test(`the move dialog at ${label}`, async ({ page }) => {","+      await open(page, 'Move');","+      const sheet = await expectReachable(page, size);","+      await expect(","+        sheet.getByRole('button', { name: 'Move here' })","+      ).toBeInViewport();","+    });","+  }","+});"],"additions":404,"deletions":0,"truncated":false},{"path":"packages/v4/@tinacms/tinacms/e2e/foot-sheet-states.spec.ts","lines":["@@ -0,0 +1,895 @@","+import { expect, type Locator, type Page, test } from '@playwright/test';","+","+const BRANCH_DIALOG =","+  '/branches.html?docs=1&fail=branch-gone#/collections/post/content%2Fposts%2Fpost-01.mdx';","+const CHECKLIST =","+  '/#/collections/checklist/content%2Fchecklists%2Ftwo-errors.mdx';","+const POST = '/#/collections/post/content%2Fposts%2Fhello-world.mdx';","+const PHONE = { width: 390, height: 844 };","+","+const SHEET = '[data-slot=foot-sheet]:not([hidden])';","+const settle = (page: Page) => page.waitForTimeout(400);","+","+const box = async (locator: Locator) => {","+  const found = await locator.boundingBox();","+  if (!found) throw new Error('no box');","+  return found;","+};","+","+const edit = async (page: Page, name: RegExp, text: string) => {","+  const field = page.getByRole('textbox', { name });","+  await field.click();","+  await field.pressSequentially(text);","+};","+","+const save = (page: Page) =>","+  page","+    .locator('[data-slot=form-bar]')","+    .getByRole('button', { name: /^(Save|Resolve)/ });","+","+const drag = async (page: Page, handle: Locator, dy: number) => {","+  const { x, y, width, height } = await box(handle);","+  await page.mouse.move(x + width / 2, y + height / 2);","+  await page.mouse.down();","+  await page.mouse.move(x + width / 2, y + height / 2 + dy / 2, { steps: 4 });","+  await page.mouse.move(x + width / 2, y + height / 2 + dy, { steps: 4 });","+  await page.mouse.up();","+};","+","+const fakeKeyboard = (page: Page, shrink: number) =>","+  page.evaluate((by) => {","+    const visual = window.visualViewport;","+    if (!visual) throw new Error('no visual viewport');","+    Object.defineProperty(visual, 'height', {","+      configurable: true,","+      value: window.innerHeight - by,","+    });","+    visual.dispatchEvent(new Event('resize'));","+  }, shrink);","+","+const noSideways = (page: Page) =>","+  page.evaluate(","+    () => document.documentElement.scrollWidth <= window.innerWidth","+  );","+","+test.describe('a plain dialog on a phone', () => {","+  const open = async (page: Page) => {","+    await page.setViewportSize(PHONE);","+    await page.goto('/sheets.html?case=plain');","+    const trigger = page.getByRole('button', { name: 'Open' });","+    await trigger.click();","+    await expect(page.locator(SHEET)).toBeVisible();","+    await settle(page);","+    return { trigger, sheet: page.locator(SHEET) };","+  };","+","+  for (const route of [","+    '×',","+    'Cancel',","+    'scrim',","+    'Escape',","+    'handle tap',","+    '120px drag',","+  ]) {","+    test(`closes by ${route} and gives focus back to the button that opened it`, async ({","+      page,","+    }) => {","+      const { trigger, sheet } = await open(page);","+      const handle = sheet.getByRole('button', { name: 'Close sheet' });","+      if (route === '×') {","+        await sheet.getByRole('button', { name: 'Close', exact: true }).click();","+      } else if (route === 'Cancel') {","+        await sheet.getByRole('button', { name: 'Cancel' }).click();","+      } else if (route === 'scrim') {","+        await page.mouse.click(195, 10);","+      } else if (route === 'Escape') {","+        await page.keyboard.press('Escape');","+      } else if (route === 'handle tap') {","+        await handle.click();","+      } else {","+        await drag(page, handle, 120);","+      }","+      await expect(page.locator(SHEET)).toHaveCount(0);","+      await expect(trigger).toBeFocused();","+    });","+  }","+","+  test('springs back on a 30px drag and scrolls its body without moving', async ({","+    page,","+  }) => {","+    const { sheet } = await open(page);","+    const before = await box(sheet);","+    await drag(page, sheet.getByRole('button', { name: 'Close sheet' }), 30);","+    await settle(page);","+    await expect(sheet).toBeVisible();","+    expect(Math.round((await box(sheet)).y)).toBe(Math.round(before.y));","+    await page.mouse.move(195, 700);","+    await page.mouse.wheel(0, 300);","+    await expect","+      .poll(() => sheet.evaluate((el) => el.scrollTop))","+      .toBeGreaterThan(0);","+    expect(Math.round((await box(sheet)).y)).toBe(Math.round(before.y));","+  });","+});","+","+test.describe('a sheet taller than the screen at 375px', () => {","+  const open = async (page: Page) => {","+    await page.setViewportSize({ width: 375, height: 667 });","+    await page.goto('/sheets.html?case=plain');","+    const trigger = page.getByRole('button', { name: 'Open' });","+    await trigger.click();","+    const sheet = page.locator(SHEET);","+    await expect(sheet).toBeVisible();","+    await settle(page);","+    await sheet.evaluate((el) => el.scrollTo(0, el.scrollHeight));","+    await expect","+      .poll(() =>","+        sheet.evaluate((el) => el.scrollHeight - el.clientHeight - el.scrollTop)","+      )","+      .toBeLessThanOrEqual(1);","+    return { trigger, sheet };","+  };","+","+  test('keeps the handle, × and header in view, and the footer at the foot, scrolled to the end', async ({","+    page,","+  }) => {","+    const { sheet } = await open(page);","+    const top = (await box(sheet)).y;","+    for (const target of [","+      sheet.getByRole('button', { name: 'Close sheet' }),","+      sheet.getByRole('button', { name: 'Close', exact: true }),","+    ]) {","+      const rect = await box(target);","+      expect(rect.y).toBeGreaterThanOrEqual(top);","+      expect(rect.y + rect.height).toBeLessThanOrEqual(top + 48);","+    }","+    const header = await box(sheet.locator('[data-slot=dialog-header]'));","+    expect(Math.round(header.y - top)).toBe(36);","+    const footer = await box(sheet.locator('[data-slot=dialog-footer]'));","+    const sheetBox = await box(sheet);","+    expect(footer.y + footer.height).toBeLessThanOrEqual(","+      sheetBox.y + sheetBox.height + 1","+    );","+    expect(footer.y).toBeGreaterThan(sheetBox.y + sheetBox.height / 2);","+  });","+","+  for (const route of ['×', 'handle tap', '120px drag']) {","+    test(`closes by ${route} after scrolling to the end`, async ({ page }) => {","+      const { trigger, sheet } = await open(page);","+      const handle = sheet.getByRole('button', { name: 'Close sheet' });","+      if (route === '×') {","+        await sheet.getByRole('button', { name: 'Close', exact: true }).click();","+      } else if (route === 'handle tap') {","+        await handle.click();","+      } else {","+        await drag(page, handle, 120);","+      }","+      await expect(page.locator(SHEET)).toHaveCount(0);","+      await expect(trigger).toBeFocused();","+    });","+  }","+","+  test('Shift+Tab scrolls a field clear of the sticky handle strip and header', async ({","+    page,","+  }) => {","+    const { sheet } = await open(page);","+    await sheet.evaluate((el) => {","+      const body = el.querySelector('div[style]');","+      if (!body) throw new Error('no body');","+      body.innerHTML = Array.from(","+        { length: 30 },","+        (_, i) => `<input aria-label=\"f${i}\" style=\"height:40px\" />`","+      ).join('');","+    });","+    await sheet.evaluate((el) => el.scrollTo(0, el.scrollHeight));","+    await page.locator('input[aria-label=\"f29\"]').focus();","+    const header = await box(sheet.locator('[data-slot=dialog-header]'));","+    for (let i = 0; i < 25; i++) {","+      await page.keyboard.press('Shift+Tab');","+      const field = await box(page.locator(':focus'));","+      expect(field.y).toBeGreaterThanOrEqual(header.y + header.height - 1);","+    }","+  });",