} = useTranslation();","+  const { data: selectedTaskInstances = [], isLoading } = useGridSelectedTaskInstances(dagId, selection);","+","+  // Bulk actions report each updated task instance as `dag_id.run_id.task_id[map_index]`.","+  const deselectKeys = (keys: Array<string>) =>","+    deselectCells(","+      [...selection.entries()]","+        .filter(([, cell]) => keys.some((key) => key.startsWith(`${dagId}.${cell.runId}.${cell.taskId}[`)))","+        .map(([cellKey]) => cellKey),","+    );","+","+  return (","+    <ActionBar.Root closeOnInteractOutside={false} open={selection.size > 0}>","+      <ActionBar.Content>","+        {isLoading ? (","+          <Spinner size=\"sm\" />","+        ) : (","+          <>","+            <ActionBar.SelectionTrigger>","+              {formatNumber(selectedTaskInstances.length, i18n.language)} {translate(\"selected\")}","+            </ActionBar.SelectionTrigger>","+            <ActionBar.Separator />","+            <BulkClearTaskInstancesButton","+              clearSelections={clearSelection}","+              selectedTaskInstances={selectedTaskInstances}","+            />","+            <BulkMarkTaskInstancesAsButton","+              deselectKeys={deselectKeys}","+              selectedTaskInstances={selectedTaskInstances}","+            />","+            <BulkDeleteTaskInstancesButton","+              deselectKeys={deselectKeys}","+              selectedTaskInstances={selectedTaskInstances}","+            />","+          </>","+        )}","+        <ActionBar.CloseTrigger onClick={clearSelection} />","+      </ActionBar.Content>","+    </ActionBar.Root>","+  );","+};"],"additions":81,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/ui/src/layouts/Details/Grid/GridTI.test.tsx","lines":["@@ -55,6 +55,7 @@ type RenderGridTIOptions = {","   readonly instance?: LightGridTaskInstanceSummary;","   readonly isGroup?: boolean;","   readonly isMapped?: boolean;","+  readonly isMultiSelected?: boolean;","   readonly r