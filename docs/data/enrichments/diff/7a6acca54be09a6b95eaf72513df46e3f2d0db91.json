ui/react\";"," import { Link, useLocation, useParams, useSearchParams } from \"react-router-dom\";"," ","@@ -42,9 +44,11 @@ type Props = {","   readonly instance: LightGridTaskInstanceSummary;","   readonly isGroup?: boolean;","   readonly isMapped?: boolean | null;","+  // Set only while cells are multi-selected, and then it alone decides which cells are outlined.","+  readonly isMultiSelected?: boolean;","   readonly label: string;","   readonly loopMaxIterations?: number | null;","-  readonly onClick?: () => void;","+  readonly onClick?: (event: MouseEvent<HTMLAnchorElement>) => void;","   readonly runId: string;","   readonly taskId: string;"," };","@@ -55,6 +59,7 @@ export const GridTI = ({","   instance,","   isGroup,","   isMapped,","+  isMultiSelected,","   loopMaxIterations,","   onClick,","   runId,","@@ -85,7 +90,7 @@ export const GridTI = ({","   ).toString();"," ","   const isSelectedRow = selectedTaskId === taskId || selectedGroupId === taskId;","-  const isSelectedTaskInstance = selectedRunId === runId && isSelectedRow;","+  const isSelectedTaskInstance = isMultiSelected ?? (selectedRunId === runId && isSelectedRow);","   const selectedOutlineColor = SELECTED_TASK_OUTLINE_COLOR[colorMode];","   const isStacked = Boolean(isMapped) || Boolean(isGroup);","   const frontCardState = instance.state ?? \"none\";"],"additions":7,"deletions":2,"truncated":false},{"path":"airflow-core/src/airflow/ui/src/layouts/Details/Grid/TaskInstancesColumn.tsx","lines":["@@ -16,6 +16,8 @@","  * specific language governing permissions and limitations","  * under the License.","  */","+import type { MouseEvent } from \"react\";","+"," import { Box, type BoxProps } from \"@chakra-ui/react\";"," import type { VirtualItem } from \"@tanstack/react-virtual\";"," import { useParams } from \"react-router-dom\";","@@ -24,16 +26,19 @@ import type { GridRunsResponse, GridTISummaries } from \"openapi/requests\";"," import type { LightGridTaskInstanceSummary } from \"openapi/requests/types.gen\";"," "," import { VersionIndicatorOptions } from \"src/constants/showVersionIndicatorOptions\";","+import type { GridCell, GridSelection } from \"src/context/gridSelection\";"," "," import { GridTI } from \"./GridTI\";"," import { DagVersionIndicator } from \"./VersionIndicator\";"," import { ROW_HEIGHT } from \"./constants\";","+import { getCellKey } from \"./useGridSelection\";"," import type { GridTask } from \"./utils\";"," "," type Props = {","   readonly nodes: Array<GridTask>;","-  readonly onCellClick?: () => void;","+  readonly onCellClick?: (event: MouseEvent<HTMLAnchorElement>, cell: GridCell) => void;","   readonly run: GridRunsResponse;","+  readonly selection?: GridSelection;","   readonly showVersionIndicatorMode?: VersionIndicatorOptions;","   readonly tiSummaries?: GridTISummaries;","   readonly virtualItems?: Array<VirtualItem>;","@@ -54,6 +59,7 @@ export const TaskInstancesColumn = ({","   nodes,","   onCellClick,","   run,","+  selection,","   showVersionIndicatorMode,","   tiSummaries,","   virtualItems,","@@ -150,9 +156,14 @@ export const TaskInstancesColumn = ({","               instance={taskInstance}","               isGroup={node.isGroup}","               isMapped={node.is_mapped}","+              isMultiSelected={","+                selection === undefined || selection.size === 0","+                  ? undefined","+                  : selection.has(getCellKey(run.run_id, node.id))","+              }","               label={node.label}","               loopMaxIterations={node.loop_max_iterations}","-              onClick={onCellClick}","+              onClick={(event) => onCellClick?.(event, { runId: run.run_id, taskId: node.id })}","               runId={run.run_id}","               taskId={node.id}","             />"],"additions":13,"deletions":2,"truncated":false},{"path":"airflow-core/src/airflow/ui/src/layouts/Details/Grid/useGridSelectedTaskInstances.test.tsx","lines":["@@ -0,0 +1,97 @@","+/*!","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+import { renderHook, waitFor } from \"@testing-library/react\";","+import { afterEach, expect, it, vi } from \"vitest\";","+","+import { TaskInstanceService } from \"openapi/requests\";","+import { CancelablePromise } from \"openapi/requests/core/CancelablePromise\";","+import type { TaskInstanceResponse } from \"openapi/requests/types.gen\";","+","+import type { GridCell } from \"src/context/gridSelection\";","+import { Wrapper } from \"src/utils/Wrapper\";","+","+import { useGridSelectedTaskInstances } from \"./useGridSelectedTaskInstances\";","+import { getCellKey } from \"./useGridSelection\";","+","+afterEach(() => vi.restoreAllMocks());","+","+const taskInstance = (runId: string, taskId: string, mapIndex = -1) =>","+  ({","+    dag_id: \"dag\",","+    dag_run_id: runId,","+    id: `${runId}-${taskId}-${mapIndex}`,","+    map_index: mapIndex,","+    task_id: taskId,","+  }) as TaskInstanceResponse;","+","+const selectionOf = (cells: Array<GridCell>) =>","+  new Map(cells.map((cell) => [getCellKey(cell.runId, cell.taskId), cell]));","+","+it(\"loads every page and keeps only the selected cells, with all map indexes of a mapped task\", async () => {","+  // Selecting (r1, mapped) and (r2, plain) asks for both tasks in both runs.","+  const rows = [","+    ...Array.from({ length: 100 }, (_, mapIndex) => taskInstance(\"r1\", \"mapped\", mapIndex)),","+    taskInstance(\"r1\", \"plain\"),","+    taskInstance(\"r2\", \"mapped\", 0),","+    taskInstance(\"r2\", \"plain\"),","+  ];","+  const batch = vi","+    .spyOn(TaskInstanceService, \"getTaskInstancesBatch\")","+    .mockImplementation(({ requestBody }) => {","+      const offset = requestBody.page_offset ?? 0;","+","+      return new CancelablePromise((resolve) =>","+        resolve({ task_instances: rows.slice(offset, offset + 100), total_entries: rows.length }),","+      );","+    });","+","+  const { result } = renderHook(","+    () =>","+      useGridSelectedTaskInstances(","+        \"dag\",","+        selectionOf([","+          { runId: \"r1\", taskId: \"mapped\" },","+          { runId: \"r2\", taskId: \"plain\" },","+        ]),","+      ),","+    { wrapper: Wrapper },","+  );","+","+  await waitFor(() => expect(result.current.isSuccess).toBe(true));","+  expect(batch).toHaveBeenCalledTimes(2);","+  expect(batch.mock.calls[0]?.[0].requestBody).toMatchObject({","+    dag_ids: [\"dag\"],","+    dag_run_ids: [\"r1\", \"r2\"],","+    page_offset: 0,","+    task_ids: [\"mapped\", \"plain\"],","+  });","+  expect(batch.mock.calls[1]?.[0].requestBody.page_offset).toBe(100);","+  expect(result.current.data?.map((ti) => ti.id)).toEqual([","+    ...Array.from({ length: 100 }, (_, mapIndex) => `r1-mapped-${mapIndex}`),","+    \"r2-plain--1\",","+  ]);","+});","+","+it(\"does not load anything without a selection\", () => {","+  const batch = vi.spyOn(TaskInstanceService, \"getTaskInstancesBatch\");","+","+  renderHook(() => useGridSelectedTaskInstances(\"dag\", new Map()), { wrapper: Wrapper });","+","+  expect(batch).not.toHaveBeenCalled();","+});"],"additions":97,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/ui/src/layouts/Details/Grid/useGridSelectedTaskInstances.ts","lines":["@@ -0,0 +1,77 @@","+/*!","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+import { useQuery } from \"@tanstack/react-query\";","+","+import { useTaskInstanceServiceGetTaskInstancesKey } from \"openapi/queries\";","+import { TaskInstanceService } from \"openapi/requests/services.gen\";","+import type { TaskInstanceResponse } from \"openapi/requests/types.gen\";","+","+import type { GridSelection } from \"src/context/gridSelection\";","+","+import { getCellKey } from \"./useGridSelection\";","+","+const PAGE_LIMIT = 100;","+","+/**","+ * Load the task instances behind the selected grid cells. A mapped task's cell stands for all of","+ * its map indexes, as it does when the cell is clicked.","+ */","+export const useGridSelectedTaskInstances = (dagId: string, selection: GridSelection) => {","+  const cells = [...selection.values()];","+  const runIds = [...new Set(cells.map((cell) => cell.runId))].sort();","+  const taskIds = [...new Set(cells.map((cell) => cell.taskId))].sort();","+","+  return useQuery({","+    enabled: selection.size > 0,","+    queryFn: async () => {","+      const taskInstances: Array<TaskInstanceResponse> = [];","+      let done = false;","+","+      // The request asks for every selected task in every selected run, so a sparse selection","+      // returns cells that were not picked and they are dropped below.","+      while (!done) {","+        // eslint-disable-next-line no-await-in-loop","+        const page = await TaskInstanceService.getTaskInstancesBatch({","+          dagId: \"~\",","+          dagRunId: \"~\",","+          requestBody: {","+            dag_ids: [dagId],","+            dag_run_ids: runIds,","+            order_by: \"id\",","+            page_limit: PAGE_LIMIT,","+            page_offset: taskInstances.length,","+            task_ids: taskIds,","+          },","+        });","+","+        taskInstances.push(...page.task_instances);","+        done = page.task_instances.length === 0 || taskInstances.length >= (page.total_entries ?? Infinity);","+      }","+","+      return taskInstances.filter((ti) => selection.has(getCellKey(ti.dag_run_id, ti.task_id)));","+    },","+    // Under the task instances key so the bulk actions' invalidation refreshes the selection too.","+    queryKey: [","+      useTaskInstanceServiceGetTaskInstancesKey,","+      \"gridSelection\",","+      dagId,","+      [...selection.keys()].sort(),","+    ],","+  });","+};"],"additions":77,"deletions":0,"truncated":false},{"path":"airflow-core/src/airflow/ui/src/layouts/Details/Grid/useGridSelection.test.tsx","lines":["@@ -0,0 +1,251 @@","+/*!","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information"],"additions":4,"deletions":0,"truncated":false}],"additions":464,"deletions":14,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-10-30T15:55:59.942356+00:00"}