"+}","+","+func loadPrivateKey(encodedKey []byte, password string) (minisign.PrivateKey, error) {","+\tif minisign.IsEncrypted(encodedKey) {","+\t\treturn minisign.DecryptKey(password, encodedKey)","+\t}","+\tvar privateKey minisign.PrivateKey","+\tif err := privateKey.UnmarshalText(encodedKey); err != nil {","+\t\treturn minisign.PrivateKey{}, err","+\t}","+\treturn privateKey, nil","+}","+","+func requireTrustedSigner(privateKey minisign.PrivateKey, encodedKeys []string) error {","+\tfor _, encodedKey := range encodedKeys {","+\t\tencodedKey = strings.TrimSpace(encodedKey)","+\t\tif encodedKey == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\tvar publicKey minisign.PublicKey","+\t\tif err := publicKey.UnmarshalText([]byte(encodedKey)); err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif publicKey.ID() == privateKey.ID() {","+\t\t\treturn nil","+\t\t}","+\t}","+\treturn fmt.Errorf(\"private key ID %016X is not in the pinned release keys\", privateKey.ID())","+}","+","+func signArchive(privateKey minisign.PrivateKey, archivePath string) error {","+\tarchive, err := os.Open(archivePath)","+\tif err != nil {","+\t\treturn err","+\t}","+\tdefer archive.Close()","+","+\treader := minisign.NewReader(archive)","+\tif _, err = io.Copy(io.Discard, reader); err != nil {","+\t\treturn err","+\t}","+\treturn os.WriteFile(archivePath+\".minisig\", reader.Sign(privateKey), 0o644)","+}","+","+func fatal(format string, args ...any) {","+\tfmt.Fprintf(os.Stderr, format+\"\\n\", args...)","+\tos.Exit(1)","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"cmd/sign-release/main_test.go","lines":["@@ -0,0 +1,54 @@","+package main","+","+import (","+\t\"crypto/rand\"","+\t\"io\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+","+\t\"aead.dev/minisign\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestLoadEncryptedPrivateKeyAndSignArchive(t *testing.T) {","+\tpublicKey, privateKey, err := minisign.GenerateKey(rand.Reader)","+\trequire.NoError(t, err)","+\tencryptedKey, err := minisign.EncryptKey(\"release-password\", privateKey)","+\trequire.NoError(t, err)","+","+\tloadedPrivateKey, err := loadPrivateKey(encryptedKey, \"release-password\")","+\trequire.NoError(t, err)","+\tassert.Equal(t, privateKey.ID(), loadedPrivateKey.ID())","+","+\tpublicKeyText, err := publicKey.MarshalText()","+\trequire.NoError(t, err)","+\trequire.NoError(t, requireTrustedSigner(loadedPrivateKey, []string{string(publicKeyText)}))","+","+\tarchivePath := filepath.Join(t.TempDir(), \"nginx-ui-linux-64.tar.gz\")","+\trequire.NoError(t, os.WriteFile(archivePath, []byte(\"release archive\"), 0o600))","+\trequire.NoError(t, signArchive(loadedPrivateKey, archivePath))","+","+\tarchive, err := os.Open(archivePath)","+\trequire.NoError(t, err)","+\tdefer archive.Close()","+\treader := minisign.NewReader(archive)","+\t_, err = io.Copy(io.Discard, reader)","+\trequire.NoError(t, err)","+\tsignature, err := os.ReadFile(archivePath + \".minisig\")","+\trequire.NoError(t, err)","+\tassert.True(t, reader.Verify(publicKey, signature))","+}","+","+func TestRequireTrustedSignerRejectsUnknownKey(t *testing.T) {","+\ttrustedPublicKey, _, err := minisign.GenerateKey(rand.Reader)","+\trequire.NoError(t, err)","+\t_, unknownPrivateKey, err := minisign.GenerateKey(rand.Reader)","+\trequire.NoError(t, err)","+\ttrustedPublicKeyText, err := trustedPublicKey.MarshalText()","+\trequire.NoError(t, err)","+","+\terr = requireTrustedSigner(unknownPrivateKey, []string{string(trustedPublicKeyText)})","+\tassert.ErrorContains(t, err, \"is not in the pinned release keys\")","+}"],"additions":54,"deletions":0,"truncated":false},{"path":"go.mod","lines":["@@ -3,6 +3,7 @@ module github.com/0xJacky/Nginx-UI"," go 1.26.5"," "," require (","+\taead.dev/minisign v0.3.0"," \tcode.pfad.fr/risefront v1.0.0"," \tgithub.com/0xJacky/pofile v1.1.1"," \tgithub.com/Azure/azure-sdk-for-go/sdk/azcore v1.22.0","@@ -75,7 +76,6 @@ require ("," )"," "," 