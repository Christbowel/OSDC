    archiveDigest(originalArchive),","+\t\t},","+\t\t{","+\t\t\tname:      \"rejects archive tampering despite matching attacker digest\",","+\t\t\tarchive:   tamperedArchive,","+\t\t\tsignature: trustedSignature,","+\t\t\tdigest:    archiveDigest(tamperedArchive),","+\t\t\twantErr:   ErrSignatureInvalid,","+\t\t},","+\t\t{","+\t\t\tname:      \"rejects attacker signature from unknown key\",","+\t\t\tarchive:   tamperedArchive,","+\t\t\tsignature: unknownSignature,","+\t\t\tdigest:    archiveDigest(tamperedArchive),","+\t\t\twantErr:   ErrSignatureKeyUnknown,","+\t\t},","+\t\t{","+\t\t\tname:      \"retains digest as corruption check\",","+\t\t\tarchive:   originalArchive,","+\t\t\tsignature: trustedSignature,","+\t\t\tdigest:    archiveDigest(tamperedArchive),","+\t\t\twantErr:   ErrDigestMismatch,","+\t\t},","+\t}","+","+\tfor _, testCase := range testCases {","+\t\tt.Run(testCase.name, func(t *testing.T) {","+\t\t\tsetTrustedMinisignKeysForTest(t, string(trustedPublicKeyText))","+\t\t\toriginalProxy := settings.HTTPSettings.GithubProxy","+\t\t\tt.Cleanup(func() {","+\t\t\t\tsettings.HTTPSettings.GithubProxy = originalProxy","+\t\t\t})","+","+\t\t\tserver := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {","+\t\t\t\tswitch {","+\t\t\t\tcase strings.HasSuffix(request.URL.Path, \".tar.gz.minisig\"):","+\t\t\t\t\t_, _ = writer.Write(testCase.signature)","+\t\t\t\tcase strings.HasSuffix(request.URL.Path, \".tar.gz.digest\"):","+\t\t\t\t\t_, _ = writer.Write([]byte(testCase.digest))","+\t\t\t\tcase strings.HasSuffix(request.URL.Path, \".tar.gz\"):","+\t\t\t\t\twriter.Header().Set(\"Content-Length\", fmt.Sprintf(\"%d\", len(testCase.archive)))","+\t\t\t\t\t_, _ = writer.Write(testCase.archive)","+\t\t\t\tdefault:","+\t\t\t\t\thttp.NotFound(writer, request)","+\t\t\t\t}","+\t\t\t}))","+\t\t\tdefer server.Close()","+\t\t\tsettings.HTTPSettings.GithubProxy = server.URL","+","+\t\t\tdownloadDir := t.TempDir()","+\t\t\tupgrader :