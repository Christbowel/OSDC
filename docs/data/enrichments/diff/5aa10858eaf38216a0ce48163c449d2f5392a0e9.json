: ok, duration: time.Since(start)}","+\t}()","+","+\tselect {","+\tcase res := <-resultCh:","+\t\tif !res.ok {","+\t\t\tt.Fatalf(\"acquire() returned false; expected it to succeed after the hung attempt was abandoned\")","+\t\t}","+\t\t// The first attempt must have hung for RenewDeadline, or this isn't exercising the bug.","+\t\tif res.duration < renewDeadline {","+\t\t\tt.Errorf(\"acquire() returned after %v, faster than RenewDeadline (%v); \"+","+\t\t\t\t\"expected the hung attempt to be bounded by RenewDeadline before retrying\", res.duration, renewDeadline)","+\t\t}","+\t\tt.Logf(\"acquire() succeeded after %v (getCalls=%d)\", res.duration, lock.getCalls.Load())","+\tcase <-time.After(10 * time.Second):","+\t\tt.Fatal(\"acquire() did not return within 10s; the hung attempt appears to have parked the election permanently\")","+\t}","+}"],"additions":88,"deletions":0,"truncated":false},{"path":"pkg/config/schema/codegen/templates/clients.go.tmpl","lines":["@@ -78,18 +78,18 @@ func gvrToObject(g schema.GroupVersionResource) runtime.Object {"," }"," "," func getInformerFiltered(c ClientGetter, opts ktypes.InformerOptions, g schema.GroupVersionResource) informerfactory.StartableInformer {","-\tvar l func(options metav1.ListOptions) (runtime.Object, error)","-\tvar w func(options metav1.ListOptions) (watch.Interface, error)","+\tvar l func(ctx context.Context, options metav1.ListOptions) (runtime.Object, error)","+\tvar w func(ctx context.Context, options metav1.ListOptions) (watch.Interface, error)"," "," \tswitch g {"," {{- range .Entries }}"," \t{{- if not .Resource.Synthetic }}"," \tcase gvr.{{ .Resource.Identifier }}:","-\t\tl = func(options metav1.ListOptions) (runtime.Object, error) {","-\t\t\treturn c.{{.ClientGetter}}().{{ .ClientGroupPath }}().{{ .ClientTypePath }}({{if not .Resource.ClusterScoped}}opts.Namespace{{end}}).List(context.Background(), options)","+\t\tl = func(ctx context.Context, options metav1.ListOptions) (runtime.Object, error) {","+\t\t\tre