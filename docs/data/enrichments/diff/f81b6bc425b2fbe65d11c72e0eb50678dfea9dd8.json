X_SYSTEM_FILE_SIZE = 65536;","+","+namespace {","+","+enum class SystemFileArgument : uint8_t { NONE, PID, CGROUP_PATH };","+","+struct SystemFileInfo {","+\tconst char *path_format;","+\tSystemFileArgument argument;","+};","+","+SystemFileInfo GetSystemFileInfo(SystemFile file) {","+\tswitch (file) {","+\tcase SystemFile::PROCESS_CGROUPS:","+\t\treturn {\"/proc/self/cgroup\", SystemFileArgument::NONE};","+\tcase SystemFile::PROCESS_CMDLINE:","+\t\treturn {\"/proc/%s/cmdline\", SystemFileArgument::PID};","+\tcase SystemFile::PROCESS_LOGINUID:","+\t\treturn {\"/proc/%s/loginuid\", SystemFileArgument::PID};","+\tcase SystemFile::CGROUP_V1_CPU_QUOTA:","+\t\treturn {\"/sys/fs/cgroup/cpu%s/cpu.cfs_quota_us\", SystemFileArgument::CGROUP_PATH};","+\tcase SystemFile::CGROUP_V1_CPU_PERIOD:","+\t\treturn {\"/sys/fs/cgroup/cpu%s/cpu.cfs_period_us\", SystemFileArgument::CGROUP_PATH};","+\tcase SystemFile::CGROUP_V2_CPU_MAX:","+\t\treturn {\"/sys/fs/cgroup%s/cpu.max\", SystemFileArgument::CGROUP_PATH};","+\tcase SystemFile::CGROUP_V1_MEMORY_LIMIT:","+\t\treturn {\"/sys/fs/cgroup/memory%s/memory.limit_in_bytes\", SystemFileArgument::CGROUP_PATH};","+\tcase SystemFile::CGROUP_V2_MEMORY_MAX:","+\t\treturn {\"/sys/fs/cgroup%s/memory.max\", SystemFileArgument::CGROUP_PATH};","+\tdefault:","+\t\tthrow InternalException(\"Unknown system file\");","+\t}","+}","+","+bool IsValidSystemFileArgument(SystemFileArgument type, const string &argument) {","+\tswitch (type) {","+\tcase SystemFileArgument::NONE:","+\t\treturn argument.empty();","+\tcase SystemFileArgument::PID:","+\t\treturn !argument.empty() && argument.find_first_not_of(\"0123456789\") == string::npos;","+\tcase SystemFileArgument::CGROUP_PATH:","+\t\t// empty (the root) or an absolute path that cannot leave the cgroup directory","+\t\treturn argument.empty() || (argument[0] == '/' && argument.find(\"..\") == string::npos);","+\tdefault:","+\t\tthrow InternalException(\"Unknown system file argument\");","+\t}","+}","+","+} // namespace","+","+bool OSUtil::TryReadSystemFile(SystemFile file, const string &argument, string &contents) {","+\tauto info = GetSystemFileInfo(file);","+\tif (!IsValidSystemFileArgument(info.argument, argument)) {","+\t\treturn false;","+\t}","+\tauto path = info.argument == SystemFileArgument::NONE ? string(info.path_format)","+\t                                                      : StringUtil::Format(info.path_format, argument);","+\tstd::ifstream stream(path, std::ios::binary);","+\tif (!stream) {","+\t\treturn false;","+\t}","+\tcontents.assign(std::istreambuf_iterator<char>(stream), std::istreambuf_iterator<char>());","+\tif (contents.size() > MAX_SYSTEM_FILE_SIZE) {","+\t\tcontents.resize(MAX_SYSTEM_FILE_SIZE);","+\t}","+\treturn true;","+}","+"," bool OSUtil::IsConfigurationEnv(const string &name) {"," \t// the home directory, the resource limits of the job the database runs in, its proxy and its time zone"," \tstatic const char *CONFIGURATION_ENV[] = {"],"additions":71,"deletions":0,"truncated":false},{"path":"src/main/settings/custom_settings.cpp","lines":["@@ -1277,8 +1277,8 @@ void MaxMemorySetting::OnSet(SettingCallbackInfo &info, Value &input) {"," \t\t\tthrow InvalidInputException(\"%s setting cannot be NULL\", MaxMemorySetting::Name);"," \t\t}"," \t\t// a percentage is relative to the system memory, since resolving it against maximum_memory would be circular","-\t\tmaximum_memory = ParseMemoryLimitOrPercentage(","-\t\t    input.ToString(), [&]() { return DBConfig::GetSystemAvailableMemory(*info.config.file_system); });","+\t\tmaximum_memory =","+\t\t    ParseMemoryLimitOrPercentage(input.ToString(), [&]() { return DBConfig::GetSystemAvailableMemory(); });"," \t}"," \tif (info.db) {"," \t\tBufferManager::GetBufferManager(*info.db).SetMemoryLimit(maximum_memory);"],"additions":2,"deletions":2,"truncated":false},{"path":"test/api/test_process_util.cpp","lines":["@@ -1,7 +1,7 @@"," #include \"catch.hpp\""," #include \"test_helpers.hpp\"","-#include \"duc