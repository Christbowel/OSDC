ed through it rather than","+# dropped as a missing-tuple conflict.","+#","+# REINDEX CONCURRENTLY reaches the same state by swapping a new index in, but","+# the apply path is the same one, so it is not tested separately.","+","+SKIP:","+{","+\tskip 'Injection points not supported by this build', 5","+\t  unless $ENV{enable_injection_points} eq 'yes';","+\tskip 'Extension injection_points not installed', 5","+\t  unless $node_subscriber->check_extension('injection_points');","+","+\t$node_subscriber->safe_psql('postgres',","+\t\t'CREATE EXTENSION injection_points');","+","+\t# create tables pub and sub, using a unique index as replica identity","+\t$node_publisher->safe_psql(","+\t\t'postgres', q[","+\t\tCREATE TABLE test_dropri (x int NOT NULL, y int);","+\t\tCREATE UNIQUE INDEX test_dropri_ri ON test_dropri (x);","+\t\tALTER TABLE test_dropri REPLICA IDENTITY USING INDEX test_dropri_ri;","+\t\tINSERT INTO test_dropri SELECT i, i FROM generate_series(1,20) i;","+\t\tCREATE PUBLICATION tap_pub_dropri FOR TABLE test_dropri;","+\t]);","+\t$node_subscriber->safe_psql(","+\t\t'postgres', q[","+\t\tCREATE TABLE test_dropri (x int NOT NULL, y int);","+\t\tCREATE UNIQUE INDEX test_dropri_ri ON test_dropri (x);","+\t\tALTER TABLE test_dropri REPLICA IDENTITY USING INDEX test_dropri_ri;","+\t]);","+\t$node_subscriber->safe_psql('postgres',","+\t\t\"CREATE SUBSCRIPTION tap_sub_dropri CONNECTION '$publisher_connstr application_name=dropri' PUBLICATION tap_pub_dropri\"","+\t);","+","+\t# wait for initial table synchronization to finish","+\t$node_subscriber->wait_for_subscription_sync($node_publisher, 'dropri');","+","+\t# Let the worker take the index and stop before opening the relation's","+\t# indexes.  The point is attached server-wide: the apply worker is not a","+\t# session this test can attach anything in.","+\t$node_subscriber->safe_psql('postgres',","+\t\t\"SELECT injection_points_attach('apply-update-before-open-indices', 'wait')\"","+\t);","+\t$node_publisher->safe_psql('postgres',","+\t\t\"UPDATE test_dropri SET y = 99 WHERE x = 7\");","+\t$node_subscriber->wait_for_event(","+\t\t'logical replication apply worker',","+\t\t'apply-update-before-open-indices');","+","+\t# This commits the loss of the replica identity, leaving relreplident set","+\t# to 'i' with no index claiming to be that identity, then parks waiting","+\t# for the apply worker's lock on the table.","+\tmy $log_offset = -s $node_subscriber->logfile;","+\tmy $drop = $node_subscriber->background_psql('postgres');","+\t$drop->query_until(","+\t\tqr/starting_drop/, q[","+\t\t\\echo starting_drop","+\t\tDROP INDEX CONCURRENTLY test_dropri_ri;","+\t]);","+\t$node_subscriber->poll_query_until('postgres',","+\t\t\t\"SELECT count(*) = 0 FROM pg_index\"","+\t\t  . \" WHERE indrelid = 'test_dropri'::regclass AND indisreplident\")","+\t  or die \"timed out waiting for the identity index to be invalidated\";","+","+\t# Detach before waking, so the worker cannot park on the point again.","+\t$node_subscriber->safe_psql(","+\t\t'postgres',","+\t\t\"SELECT injection_points_detach('apply-update-before-open-indices');","+\t\t SELECT injection_points_wakeup('apply-update-before-open-indices');\"","+\t);","+","+\t# The straddling change goes through, found by the demoted index.","+\t$node_publisher->wait_for_catchup('dropri');","+\t$result = $node_subscriber->safe_psql('postgres',","+\t\t\"SELECT y FROM test_dropri WHERE x = 7\");","+\tis($result, qq(99), 'change straddling the drop is applied');","+\tok($drop->quit, 'DROP INDEX CONCURRENTLY completes');","+","+\t# From the next change on, the relation map entry is rebuilt, finds no","+\t# replica identity, and apply stops with the usual error.","+\t$node_publisher->safe_psql('postgres',","+\t\t\"UPDATE test_dropri SET y = 123 WHERE x = 8\");","+\tok( $node_subscriber->poll_query_until(","+\t\t\t'postgres', q[","+\t\t\tSELECT apply_error_count > 0 FROM pg_stat_subscription_stats","+\t\t\tWHERE subname = 'tap_sub_dropri']),","+\t\t'later changes wait for a replica identity');","+\tlike(","+\t\tslurp_file($node_subscriber->logfile, $log_offset),","+\t\tqr/logical replication target relation \"public\\.test_dropri\" has neither REPLICA IDENTITY index nor PRIMARY KEY/,","+\t\t'and say why');","+","+\t# Give the relation a replica identity again and they resume.","+\t$node_subscriber->safe_psql(","+\t\t'postgres', q[","+\t\tCREATE UNIQUE INDEX test_dropri_ri2 ON test_dropri (x);","+\t\tALTER TABLE test_dropri REPLICA IDENTITY USING INDEX test_dropri_ri2;","+\t]);","+\t$node_publisher->wait_for_catchup('dropri');","+\t$result = $node_subscriber->safe_psql('postgres',","+\t\t\"SELECT y FROM test_dropri WHERE x = 8\");","+\tis($result, qq(123), 'replication resumes');","+","+\t# cleanup pub","+\t$node_publisher->safe_psql('postgres', \"DROP PUBLICATION tap_pub_dropri\");","+\t$node_publisher->safe_psql('postgres', \"DROP TABLE test_dropri\");","+\t# cleanup sub","+\t$node_subscriber->safe_psql('postgres',","+\t\t\"DROP SUBSCRIPTION tap_sub_dropri\");","+\t$node_subscriber->safe_psql('postgres', \"DROP TABLE test_dropri\");","+\t$node_subscriber->safe_psql('postgres',","+\t\t\"DROP EXTENSION injection_points\");","+}","+","+# Testcase end: Subscription keeps using an index that concurrent DDL has","+# demoted from replica identity","+# =============================================================================","+"," $node_subscriber->stop('fast');"," $node_publisher->stop('fast');"," ",""],"additions":127,"deletions":0,"truncated":false}],"additions":217,"deletions":50,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-09-28T17:12:34.827477+00:00"}