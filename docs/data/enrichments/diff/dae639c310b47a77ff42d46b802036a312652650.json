nsaction","+  commits, which holds the user's rows until then.","+- The authentication reset (`POST /authentication/reset`) calls","+  `revokeAllSessions` after it deletes every legacy session, as it does under","+  either engine.","+","+Revoking a user's sessions also deletes their legacy `sessions` rows, so a","+rollback to `legacy` (plan §8) can't revive a session a security event ended.","+Under `legacy` nothing here runs: a password change and a reset already delete","+the user's legacy rows, and suspension and deletion keep legacy behaviour.","+Sessions that `createVerifiedSession` creates have no IP or user agent, since","+the API controllers don't see the request.","+"," ## Tables"," "," `user_accounts`, `user_sessions` and `verifications` are defined in"],"additions":27,"deletions":2,"truncated":false},{"path":"ghost/core/server/auth/better-auth/session-controller.ts","lines":["@@ -32,9 +32,40 @@ const isSessionCookie = (cookie: string) => {","   return name === SESSION_COOKIE_NAME || name === `__Secure-${SESSION_COOKIE_NAME}`;"," };"," ","+/** Better Auth's `Set-Cookie` headers, without the cookies Ghost never sets */","+export const sessionCookies = (headers: Headers) => headers.getSetCookie().filter(isSessionCookie);","+"," function forwardSessionCookie(headers: Headers, res: Response) {","   // An array, as express-session sends it","-  res.setHeader('Set-Cookie', headers.getSetCookie().filter(isSessionCookie));","+  res.setHeader('Set-Cookie', sessionCookies(headers));","+}","+","+type OriginDeps = Pick<SessionControllerDeps, 'getOriginOfRequest' | 'getAdminOrigin'>;","+","+// Server-side calls skip Better Auth's origin checks, so this is the login-CSRF check","+function assertAdminOrigin(deps: OriginDeps, req: Request) {","+  const origin = deps.getOriginOfRequest(req);","+  if (!origin) {","+    throw new errors.BadRequestError({ message: messages.noOrigin });","+  }","+  const adminOrigin = deps.getAdminOrigin();","+  if (origin !== adminOrigin) {",