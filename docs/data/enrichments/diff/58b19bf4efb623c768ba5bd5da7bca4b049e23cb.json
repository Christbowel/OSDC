{"id":"58b19bf4efb623c768ba5bd5da7bca4b049e23cb","axis":"silent","repo":"expo/expo","sha":"58b19bf4efb623c768ba5bd5da7bca4b049e23cb","parsed":{"files":[{"path":".changeset/expo-font-ios-argument-error-codes.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-font': patch","+---","+","+[iOS] Invalid arguments to the native font functions now fail with different errors. A wrong number of arguments fails with `ERR_ARGUMENTS_RANGE_MISMATCH` instead of `ERR_INVALID_ARGS_NUMBER`. A value that can't be converted to a URL or a color, such as the `localUri` of `loadAsync` or the `color` option of `renderToImageAsync`, fails with `ERR_CONVERTING_FAILED` instead of `ERR_ARGUMENT_CAST`. Any other argument of the wrong type fails with a `TypeError` instead of `ERR_ARGUMENT_CAST`. On macOS, `renderToImageAsync` is now defined and rejects with `ERR_RENDER_TO_IMAGE_UNAVAILABLE`."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/expo-font-ios-modules-api-2.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-font': patch","+---","+","+[iOS] Migrate to the Expo Modules API 2.0."],"additions":5,"deletions":0,"truncated":false},{"path":"apps/bare-expo/ios/Podfile.lock","lines":["@@ -400,6 +400,9 @@ PODS:","     - ExpoModulesTestCore","   - ExpoFont (58.0.10):","     - ExpoModulesCore","+  - ExpoFont/Tests (58.0.10):","+    - ExpoModulesCore","+    - ExpoModulesTestCore","   - ExpoGL (58.0.3):","     - ExpoModulesCore","     - ExpoModulesJSI","@@ -3686,6 +3689,7 @@ DEPENDENCIES:","   - ExpoFileSystem (from `../../../packages/expo-file-system/ios`)","   - ExpoFileSystem/Tests (from `../../../packages/expo-file-system/ios`)","   - ExpoFont (from `../../../packages/expo-font/ios`)","+  - ExpoFont/Tests (from `../../../packages/expo-font/ios`)","   - ExpoGL (from `../../../packages/expo-gl`)","   - ExpoGlassEffect (from `../../../packages/expo-glass-effect/ios`)","   - ExpoHaptics (from `../../../packages/expo-haptics/ios`)","@@ -4427,7 +4431,7 @@ SPEC CHECKSUMS:","   ExpoDocumentPicker: af0917aa6f1b54ab3a0f47977935a1e20ffb1537","   ExpoDomWebView: b2a6d681b9d34c23b1f584321386ca8da1d36afb","   ExpoFileSystem: f5536c9b2172dda07fec55c0b5ae46b6b225b435","-  ExpoFont: b215bc738b2e3fba7ffed79903a6fccf66959dd0","+  ExpoFont: 593353eb734e925cb9650bb35fe73cc0c7825575","   ExpoGL: 79eb0ca61f7e13317fac3beec5bd6ce94587ac8c","   ExpoGlassEffect: 6594e055df1e0b88d34cc189ba0b21589adec6bf","   ExpoHaptics: c95d1e2162895e710b68dd912eec619900ebdf33"],"additions":5,"deletions":1,"truncated":false},{"path":"packages/expo-font/Package.swift","lines":["@@ -22,7 +22,7 @@ let package = Package(","         .product(name: \"ExpoModulesCoreHeaders\", package: \"ExpoModulesCoreHeaders\")","       ],","       path: \"ios\",","-      exclude: [\"ExpoFont.podspec\"]","+      exclude: [\"ExpoFont.podspec\", \"Tests\"]","     )","   ],","   swiftLanguageModes: [.v5]"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/expo-font/expo-module.config.json","lines":["@@ -1,8 +1,5 @@"," {","   \"platforms\": [\"apple\", \"android\", \"web\"],","-  \"apple\": {","-    \"modules\": [\"FontLoaderModule\", \"FontUtilsModule\"]","-  },","   \"android\": {","     \"publication\": {","       \"groupId\": \"host.exp.exponent\","],"additions":0,"deletions":3,"truncated":false},{"path":"packages/expo-font/ios/ExpoFont.podspec","lines":["@@ -27,4 +27,12 @@ Pod::Spec.new do |s|","   }"," ","   s.source_files = \"**/*.{h,m,swift}\"","+","+  s.exclude_files = 'Tests/'","+  s.test_spec 'Tests' do |test_spec|","+    # ExpoModulesCore requires React-hermes or React-jsc in tests, add ExpoModulesTestCore for the underlying dependencies","+    test_spec.dependency 'ExpoModulesTestCore'","+","+    test_spec.source_files = 'Tests/**/*.{m,swift}'","+  end"," end"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/expo-font/ios/FontExceptions.swift","lines":["@@ -62,3 +62,9 @@ internal final class SaveImageException: GenericException<String> {","     \"Could not save image to '\\(param)'\"","   }"," }","+","+internal final class RenderToImageUnavailableException: Exception, @unchecked Sendable {","+  override var reason: String {","+    \"Rendering glyphs to an image is not available on macOS. Check `Platform.OS` before you call `renderToImageAsync`, and show the glyphs in a `Text` component on macOS instead\"","+  }","+}"],"additions":6,"deletions":0,"truncated":false},{"path":"packages/expo-font/ios/FontLoaderActor.swift","lines":["@@ -0,0 +1,37 @@","+import Foundation","+","+/**","+ Runs the font loads one at a time on a serial dispatch queue. Each load reads and then replaces the process-wide","+ alias registry and CoreText registrations, so loads must not overlap. A load also reads font files, so it doesn't","+ run on the JavaScript thread or the cooperative thread pool.","+ */","+@globalActor","+internal actor FontLoaderActor {","+  static let shared = FontLoaderActor()","+","+  private nonisolated let executor = FontLoaderExecutor(","+    queue: DispatchQueue(label: \"expo.modules.font.loader\", qos: .userInitiated)","+  )","+","+  nonisolated var unownedExecutor: UnownedSerialExecutor {","+    executor.asUnownedSerialExecutor()","+  }","+}","+","+private final class FontLoaderExecutor: SerialExecutor {","+  private let queue: DispatchQueue","+","+  init(queue: DispatchQueue) {","+    self.queue = queue","+  }","+","+  func enqueue(_ job: UnownedJob) {","+    queue.async {","+      job.runSynchronously(on: self.asUnownedSerialExecutor())","+    }","+  }","+","+  func asUnownedSerialExecutor() -> UnownedSerialExecutor {","+    UnownedSerialExecutor(ordinary: self)","+  }","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"packages/expo-font/ios/FontLoaderModule.swift","lines":["@@ -1,63 +1,80 @@"," import CoreGraphics"," import ExpoModulesCore"," ","+@ExpoModule(\"ExpoFontLoader\")"," public final class FontLoaderModule: Module {","   // could be a Set, but to be able to pass to JS we keep it as an array","-  private lazy var registeredFonts: [String] = queryCustomNativeFonts()","+  private let registeredFonts = Mutex<[String]?>(nil)","+","+  // NOTE: this is exposed in JS as globalThis.expo.modules.ExpoFontLoader.loadedFonts","+  // and potentially consumed outside of Expo (e.g. RN vector icons)","+  // do NOT change the property as it'll break consumers!","+  @JS","+  func getLoadedFonts() -> [String] {","+    return registeredFonts.withLock { cachedFonts in","+      let fonts = cachedFonts ?? queryCustomNativeFonts()","+      cachedFonts = fonts","+      return fonts","+    }","+  }"," ","-  public func definition() -> ModuleDefinition {","-    Name(\"ExpoFontLoader\")","+  // NOTE: this is exposed in JS as globalThis.expo.modules.ExpoFontLoader.loadAsync","+  // and potentially consumed outside of Expo (e.g. RN vector icons)","+  // do NOT change the function signature as it'll break consumers!","+  @JS","+  @FontLoaderActor","+  func loadAsync(fontFamilyAlias: String, localUri: URL) async throws {","+    try loadFont(alias: fontFamilyAlias, localUri: localUri)","+  }"," ","-    // NOTE: this is exposed in JS as globalThis.expo.modules.ExpoFontLoader.loadedFonts","-    // and potentially consumed outside of Expo (e.g. RN vector icons)","-    // do NOT change the property as it'll break consumers!","-    Function(\"getLoadedFonts\") {","-      return registeredFonts","-    }","+  @JS","+  @FontLoaderActor","+  func loadFontFamilyAsync(fontFamilyAlias: String, faces: [FontFaceRecord]) async throws {","+    try loadFontFamily(alias: fontFamilyAlias, faces: faces)","+  }"," ","-    // NOTE: this is exposed in JS as globalThis.expo.modules.ExpoFontLoader.loadAsync","-    // and potentially consumed outside of Expo (e.g. RN vector icons)","-    // do NOT change the function signature as it'll break consumers!","-    AsyncFunction(\"loadAsync\") { (fontFamilyAlias: String, localUri: URL) in","-      let fontUrl = localUri as CFURL","-      // If the font was already registered, unregister it first. Otherwise CTFontManagerRegisterFontsForURL","-      // would fail because of a duplicated font name when the app reloads. Note that re-registering","-      // under an existing alias is skipped in the JS layer.","-      if FontFamilyAliasManager.hasAlias(fontFamilyAlias) {","-        guard try unregisterFont(url: fontUrl) else {","-          return","-        }","+  private func loadFont(alias fontFamilyAlias: String, localUri: URL) throws {","+    let fontUrl = localUri as CFURL","+    // If the font was already registered, unregister it first. Otherwise CTFontManagerRegisterFontsForURL","+    // would fail because of a duplicated font name when the app reloads. Note that re-registering","+    // under an existing alias is skipped in the JS layer.","+    if FontFamilyAliasManager.hasAlias(fontFamilyAlias) {","+      guard try unregisterFont(url: fontUrl) else {","+        return","       }","+    }"," ","-      let registeredFont = try registerFont(fontUrl: fontUrl, fontFamilyAlias: fontFamilyAlias)","+    let registeredFont = try registerFont(fontUrl: fontUrl, fontFamilyAlias: fontFamilyAlias)"," ","-      // Alias every name the file provides to `fontFamilyAlias` — one per named instance for a","-      // variable font — that makes its weights reachable through the `fontWeight` style prop.","-      let aliasedNames = try postScriptNames(inFileAt: fontUrl, alias: fontFamilyAlias)","+    // Alias every name the file provides to `fontFamilyAlias` — one per named instance for a","+    // variable font — that makes its weights reachable through the `fontWeight` style prop.","+    let aliasedNames = try postScriptNames(inFileAt: fontUrl, alias: fontFamilyAlias)"," ","-      let previousUrls = FontFamilyAliasManager.registeredUrls(forAlias: fontFamilyAlias)","+    let previousUrls = FontFamilyAliasManager.registeredUrls(forAlias: fontFamilyAlias)"," ","-      FontFamilyAliasManager.setAlias(fontFamilyAlias, forPostScriptNames: aliasedNames, url: localUri)","+    FontFamilyAliasManager.setAlias(fontFamilyAlias, forPostScriptNames: aliasedNames, url: localUri)"," ","-      // A duplicate-name registration still depends on a previously registered URL. Do not","-      // unregister it when the incoming URL did not acquire its own registration. The registry","-      // then records the incoming URL while CoreText serves the previous one, until the next","-      // cold launch registers the incoming URL first.","-      if registeredFont {","-        for staleUrl in previousUrls where !FontFamilyAliasManager.hasRegisteredUrl(staleUrl) {","-          _ = try? unregisterFont(url: staleUrl as CFURL)","-        }","+    // A duplicate-name registration still depends on a previously registered URL. Do not","+    // unregister it when the incoming URL did not acquire its own registration. The registry","+    // then records the incoming URL while CoreText serves the previous one, until the next","+    // cold launch registers the incoming URL first.","+    if registeredFont {","+      for staleUrl in previousUrls where !FontFamilyAliasManager.hasRegisteredUrl(staleUrl) {","+        _ = try? unregisterFont(url: staleUrl as CFURL)","       }","-","-      // Only report names the app supplied. This list is what `Font.isLoaded` answers from, and","-      // what `loadAsync` skips on, so every entry takes a name the app can no longer load under.","-      // The names read out of the file stay in the alias registry above, where `fontWeight`","-      // resolution needs them.","-      registeredFonts = Array(Set(registeredFonts).union([fontFamilyAlias]))","     }"," ","-    AsyncFunction(\"loadFontFamilyAsync\") { (fontFamilyAlias: String, faces: [FontFaceRecord]) in","-      try self.loadFontFamily(alias: fontFamilyAlias, faces: faces)","+    // Only report names the app supplied. This list is what `Font.isLoaded` answers from, and","+    // what `loadAsync` skips on, so every entry takes a name the app can no longer load under.","+    // The names read out of the file stay in the alias registry above, where `fontWeight`","+    // resolution needs them.","+    addRegisteredFont(fontFamilyAlias)","+  }","+","+  private func addRegisteredFont(_ fontFamilyAlias: String) {","+    registeredFonts.withLock { cachedFonts in","+      let fonts = cachedFonts ?? queryCustomNativeFonts()","+      cachedFonts = Array(Set(fonts).union([fontFamilyAlias]))","     }","   }"," ","@@ -126,7 +143,7 @@ public final class FontLoaderModule: Module {","       }","     }"," ","-    registeredFonts = Array(Set(registeredFonts).union([fontFamilyAlias]))","+    addRegisteredFont(fontFamilyAlias)","   }"," }"," "],"additions":61,"deletions":44,"truncated":false},{"path":"packages/expo-font/ios/FontLoaderRecords.swift","lines":["@@ -2,9 +2,10 @@ import ExpoModulesCore"," "," // `weight`/`style` are the JS-declared values, used only as a fallback when the font file's"," // own traits can't be read.","-struct FontFaceRecord: Record {","-  @Field var localUri: URL?","-  @Field var weight: Int?","+@Record","+struct FontFaceRecord {","+  var localUri: URL?","+  var weight: Int?","   // \"normal\" | \"italic\"","-  @Field var style: String?","+  var style: String?"," }"],"additions":5,"deletions":4,"truncated":false},{"path":"packages/expo-font/ios/FontUtilsModule.swift","lines":["@@ -2,62 +2,62 @@"," "," import ExpoModulesCore"," ","+@ExpoModule(\"ExpoFontUtils\")"," public final class FontUtilsModule: Module {","-  public func definition() -> ModuleDefinition {","-    Name(\"ExpoFontUtils\")","-","-#if !os(macOS)","-    AsyncFunction(\"renderToImageAsync\") { (glyphs: String, options: RenderToImageOptions, promise: Promise) throws in","-      let font = if let fontName = UIFont.fontNames(forFamilyName: options.fontFamily).first,","-        let uiFont = UIFont(name: fontName, size: options.size) {","-        uiFont","-      } else {","-        UIFont.systemFont(ofSize: options.size)","-      }","-","-      var attributes: [NSAttributedString.Key: Any] = [","-        .font: font,","-        .foregroundColor: UIColor(options.color)","-      ]","-","-      if let lineHeight = options.lineHeight {","-        let paragraphStyle = NSMutableParagraphStyle()","-        paragraphStyle.minimumLineHeight = lineHeight","-        paragraphStyle.maximumLineHeight = lineHeight","-        attributes[.paragraphStyle] = paragraphStyle","-        // Adding baseline offset to vertically center the text within the specified line height","-        attributes[.baselineOffset] = (lineHeight - font.lineHeight) / 2","-      }","-","-      let attributedString = NSAttributedString(","-        string: glyphs,","-        attributes: attributes","-      )","-","-      let renderer = UIGraphicsImageRenderer(size: attributedString.size())","-      let image = renderer.image { _ in","-        attributedString.draw(at: .zero)","-      }","-","-      guard let data = image.pngData() else {","-        promise.reject(CreateImageException())","-        return","-      }","-","-      let outputURL = URL(fileURLWithPath: \"\\(NSTemporaryDirectory())\\(UUID().uuidString).png\")","-","-      do {","-        try data.write(to: outputURL, options: .atomic)","-        promise.resolve([","-          \"uri\": outputURL.absoluteString,","-          \"width\": image.size.width,","-          \"height\": image.size.height,","-          \"scale\": image.scale","-        ])","-      } catch {","-        promise.reject(SaveImageException(outputURL.absoluteString))","-      }","+  // The macros skip members inside `#if`, so the function exists on every platform.","+  @JS(.concurrent)","+  func renderToImageAsync(glyphs: String, options: RenderToImageOptions) async throws -> RenderToImageResult {","+#if os(macOS)","+    throw RenderToImageUnavailableException()","+#else","+    let font = if let fontName = UIFont.fontNames(forFamilyName: options.fontFamily).first,","+      let uiFont = UIFont(name: fontName, size: options.size) {","+      uiFont","+    } else {","+      UIFont.systemFont(ofSize: options.size)","     }","+","+    var attributes: [NSAttributedString.Key: Any] = [","+      .font: font,","+      .foregroundColor: UIColor(options.color)","+    ]","+","+    if let lineHeight = options.lineHeight {","+      let paragraphStyle = NSMutableParagraphStyle()","+      paragraphStyle.minimumLineHeight = lineHeight","+      paragraphStyle.maximumLineHeight = lineHeight","+      attributes[.paragraphStyle] = paragraphStyle","+      // Adding baseline offset to vertically center the text within the specified line height","+      attributes[.baselineOffset] = (lineHeight - font.lineHeight) / 2","+    }","+","+    let attributedString = NSAttributedString(","+      string: glyphs,","+      attributes: attributes","+    )","+","+    let renderer = UIGraphicsImageRenderer(size: attributedString.size())","+    let image = renderer.image { _ in","+      attributedString.draw(at: .zero)","+    }","+","+    guard let data = image.pngData() else {","+      throw CreateImageException()","+    }","+","+    let outputURL = URL(fileURLWithPath: \"\\(NSTemporaryDirectory())\\(UUID().uuidString).png\")","+","+    do {","+      try data.write(to: outputURL, options: .atomic)","+    } catch {","+      throw SaveImageException(outputURL.absoluteString)","+    }","+    return RenderToImageResult(","+      uri: outputURL.absoluteString,","+      width: image.size.width,","+      height: image.size.height,","+      scale: image.scale","+    )"," #endif","   }"," }"],"additions":54,"deletions":54,"truncated":false},{"path":"packages/expo-font/ios/FontUtilsRecords.swift","lines":["@@ -3,9 +3,18 @@"," import SwiftUI"," import ExpoModulesCore"," ","-struct RenderToImageOptions: Record {","-  @Field var fontFamily: String = \"\"","-  @Field var lineHeight: CGFloat? = nil","-  @Field var size: CGFloat = 24","-  @Field var color: Color = .black","+@Record","+struct RenderToImageOptions {","+  var fontFamily: String = \"\"","+  var lineHeight: CGFloat? = nil","+  var size: CGFloat = 24","+  var color: Color = .black","+}","+","+@Record","+struct RenderToImageResult {","+  var uri: String","+  var width: CGFloat","+  var height: CGFloat","+  var scale: CGFloat"," }"],"additions":14,"deletions":5,"truncated":false},{"path":"packages/expo-font/ios/Tests/FontModulesTests.swift","lines":["@@ -0,0 +1,140 @@","+// Copyright 2026-present 650 Industries. All rights reserved.","+","+import CoreText","+import ExpoModulesTestCore","+import Testing","+import UIKit","+","+@testable import ExpoFont","+@testable import ExpoModulesCore","+","+/// Calls the font modules from JavaScript, so the arguments and the results go through the same","+/// conversions as in an app.","+@Suite(\"FontModules\")","+@JavaScriptActor","+struct FontModulesTests {","+  let appContext: AppContext","+  let runtime: ExpoRuntime","+","+  init() async throws {","+    appContext = TestAppContext()","+    runtime = try appContext.runtime","+    appContext.moduleRegistry.register(module: FontLoaderModule(appContext: appContext), name: nil)","+    appContext.moduleRegistry.register(module: FontUtilsModule(appContext: appContext), name: nil)","+    try await runtime.execute { [runtime] in","+      _ = try runtime.eval(","+        \"\"\"","+        var FontLoader = expo.modules.ExpoFontLoader;","+        var FontUtils = expo.modules.ExpoFontUtils;","+        // Resolves to the code of the error that rejects the promise, or to 'resolved'.","+        function rejectionCode(promise) {","+          return promise.then(","+            function () {","+              return 'resolved';","+            },","+            function (error) {","+              return String(error.code);","+            }","+          );","+        }","+        \"\"\"","+      )","+    }","+  }","+","+  /// The file URL of a font that ships with the system, so the tests don't need a font fixture.","+  func systemFontUrl() throws -> URL {","+    let font = CTFontCreateWithName(\"Courier\" as CFString, 12, nil)","+    return try #require(CTFontCopyAttribute(font, kCTFontURLAttribute) as? URL)","+  }","+","+  /// An alias that no other test uses, because the alias registry is process-wide.","+  func uniqueAlias() -> String {","+    return \"ExpoFontTest-\\(UUID().uuidString)\"","+  }","+","+  func isLoaded(_ alias: String) async throws -> Bool {","+    try await runtime.execute {","+      try runtime.eval(\"FontLoader.getLoadedFonts().includes('\\(alias)')\").asBool()","+    }","+  }","+","+  // MARK: - ExpoFontLoader","+","+  @Test","+  func `loadAsync makes the font available under the alias`() async throws {","+    let alias = uniqueAlias()","+    let fontUrl = try systemFontUrl()","+","+    try await runtime.execute {","+      _ = try await runtime.evalAsync(\"FontLoader.loadAsync('\\(alias)', '\\(fontUrl.absoluteString)')\")","+    }","+","+    #expect(try await isLoaded(alias))","+    #expect(!UIFont.fontNames(forFamilyName: alias).isEmpty)","+  }","+","+  @Test","+  func `loadFontFamilyAsync makes the faces available under the alias`() async throws {","+    let alias = uniqueAlias()","+    let fontUrl = try systemFontUrl()","+","+    try await runtime.execute {","+      _ = try await runtime.evalAsync(","+        \"\"\"","+        FontLoader.loadFontFamilyAsync('\\(alias)', [","+          { localUri: '\\(fontUrl.absoluteString)', weight: 400, style: 'normal' },","+        ])","+        \"\"\"","+      )","+    }","+","+    #expect(try await isLoaded(alias))","+    #expect(!UIFont.fontNames(forFamilyName: alias).isEmpty)","+  }","+","+  @Test","+  func `loadFontFamilyAsync rejects a family without faces`() async throws {","+    let alias = uniqueAlias()","+    let code = try await runtime.execute {","+      try await runtime.evalAsync(\"rejectionCode(FontLoader.loadFontFamilyAsync('\\(alias)', []))\").asString()","+    }","+    #expect(code == FontFamilyEmptyFacesException(\"\").code)","+  }","+","+  @Test","+  func `loadFontFamilyAsync rejects a face without localUri`() async throws {","+    let alias = uniqueAlias()","+    let code = try await runtime.execute {","+      try await runtime.evalAsync(","+        \"rejectionCode(FontLoader.loadFontFamilyAsync('\\(alias)', [{ weight: 400 }]))\"","+      ).asString()","+    }","+    #expect(code == FontFaceMissingUriException(\"\").code)","+  }","+","+  // MARK: - ExpoFontUtils","+","+  @Test","+  func `renderToImageAsync resolves to a PNG file and its size`() async throws {","+    let joined = try await runtime.execute {","+      try await runtime.evalAsync(","+        \"\"\"","+        FontUtils.renderToImageAsync('Ag', { size: 32, color: 'red', lineHeight: 40 }).then(function (image) {","+          return [image.uri, image.width, image.height, image.scale].join(' ');","+        })","+        \"\"\"","+      ).asString()","+    }","+    let parts = joined.split(separator: \" \").map(String.init)","+    try #require(parts.count == 4)","+","+    let fileUrl = try #require(URL(string: parts[0]))","+    #expect(fileUrl.isFileURL)","+    #expect(UIImage(contentsOfFile: fileUrl.path) != nil)","+    #expect(try #require(Double(parts[1])) > 0)","+    #expect(try #require(Double(parts[2])) == 40)","+    #expect(try #require(Double(parts[3])) > 0)","+    try? FileManager.default.removeItem(at: fileUrl)","+  }","+}",""],"additions":140,"deletions":0,"truncated":false}],"additions":341,"deletions":112,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-20T17:58:00.369432+00:00"}