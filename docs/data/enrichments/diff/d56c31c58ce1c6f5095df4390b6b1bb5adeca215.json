eletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 0), BSON(kShardKey << 10));","+    auto completionFuture0 =","+        registerAndCreatePersistentTask(opCtx, task0->getTask(), task0->getOngoingQueriesFuture());","+","+    // Task 1: [20, 30) - does NOT overlap with task0","+    auto task1 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 20), BSON(kShardKey << 30));","+    auto completionFuture1 =","+        registerAndCreatePersistentTask(opCtx, task1->getTask(), task1->getOngoingQueriesFuture());","+","+    // Task 2: [40, 50) - does NOT overlap with any other task","+    auto task2 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 40), BSON(kShardKey << 50));","+    auto completionFuture2 =","+        registerAndCreatePersistentTask(opCtx, task2->getTask(), task2->getOngoingQueriesFuture());","+","+    ASSERT_EQ(3, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+","+    {","+        FailPointEnableBlock hangBeforeDoingDeletionFp(\"hangBeforeDoingDeletion\");","+        // Drain the 2 tasks and hang before deletion","+        task0->drainOngoingQueries();","+        task1->drainOngoingQueries();","+","+        hangBeforeDoingDeletionFp.wait(4);","+","+        verifyProcessingFlag(opCtx, uuidCollA, task0->getTask().getRange(), true);","+        verifyProcessingFlag(opCtx, uuidCollA, task1->getTask().getRange(), true);","+","+        FailPointEnableBlock rangeDeleterWaitingForWorkerCapacityFp(","+            \"rangeDeleterWaitingForWorkerCapacity\");","+        // Drain the third task","+        task2->drainOngoingQueries();","+        // Check that the dispatcher is waiting for worker to be available","+        rangeDeleterWaitingForWorkerCapacityFp.wait();","+        verifyProcessingFlag(opCtx, uuidCollA, task2->getTask().getRange(), false);","+    }","+","+    completionFuture0.get(opCtx);","+    completionFuture1.get(opCtx);","+    completionFuture2.get(opCtx);","+","+    ASSERT_EQ(0, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+}","+","+TEST_F(RangeDeleterServiceTest,","+       IncreasingTheRangeDeleterThreadCountCorrectlyAdjustsConcurrencyCap) {","+    auto rds = RangeDeleterService::get(opCtx);","+","+    // Set the number of worker threads to 2","+    unittest::ServerParameterGuard threadCount{\"rangeDeleterThreadsCount\", 2};","+","+    // Register non-overlapping tasks","+    // Task 0: [0, 10)","+    auto task0 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 0), BSON(kShardKey << 10));","+    auto completionFuture0 =","+        registerAndCreatePersistentTask(opCtx, task0->getTask(), task0->getOngoingQueriesFuture());","+","+    // Task 1: [20, 30) - does NOT overlap with task0","+    auto task1 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 20), BSON(kShardKey << 30));","+    auto completionFuture1 =","+        registerAndCreatePersistentTask(opCtx, task1->getTask(), task1->getOngoingQueriesFuture());","+","+    // Task 2: [40, 50) - does NOT overlap with any other task","+    auto task2 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 40), BSON(kShardKey << 50));","+    auto completionFuture2 =","+        registerAndCreatePersistentTask(opCtx, task2->getTask(), task2->getOngoingQueriesFuture());","+","+    ASSERT_EQ(3, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+","+    {","+        FailPointEnableBlock hangBeforeDoingDeletionFp(\"hangBeforeDoingDeletion\");","+        // Drain the 2 tasks and hang before deletion","+        task0->drainOngoingQueries();","+        task1->drainOngoingQueries();","+","+        hangBeforeDoingDeletionFp.wait(4);","+","+        verifyProcessingFlag(opCtx, uuidCollA, task0->getTask().getRange(), true);","+        verifyProcessingFlag(opCtx, uuidCollA, task1->getTask().getRange(), true);","+","+        FailPointEnableBlock rangeDeleterWaitingForWorkerCapacityFp(","+            \"rangeDeleterWaitingForWorkerCapacity\");","+        // Drain the third task","+        task2->drainOngoingQueries();","+        // Check that the dispatcher is waiting for worker to be available","+        rangeDeleterWaitingForWorkerCapacityFp.wait();","+        verifyProcessingFlag(opCtx, uuidCollA, task2->getTask().getRange(), false);","+","+        // Change the number of worker threads to 3","+        unittest::ServerParameterGuard threadCount{\"rangeDeleterThreadsCount\", 3};","+","+        hangBeforeDoingDeletionFp.wait(6);","+        verifyProcessingFlag(opCtx, uuidCollA, task2->getTask().getRange(), true);","+    }","+","+    completionFuture0.get(opCtx);","+    completionFuture1.get(opCtx);","+    completionFuture2.get(opCtx);","+","+    ASSERT_EQ(0, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+}","+","+TEST_F(RangeDeleterServiceTest,","+       DecreasingTheRangeDeleterThreadCountCorrectlyAdjustsConcurrencyCap) {","+    auto rds = RangeDeleterService::get(opCtx);","+","+    // Set the number of worker threads to 2","+    unittest::ServerParameterGuard threadCount{\"rangeDeleterThreadsCount\", 2};","+","+    // Register non-overlapping tasks","+    // Task 0: [0, 10)","+    auto task0 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 0), BSON(kShardKey << 10));","+    auto completionFuture0 =","+        registerAndCreatePersistentTask(opCtx, task0->getTask(), task0->getOngoingQueriesFuture());","+","+    // Task 1: [20, 30) - does NOT overlap with task0","+    auto task1 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 20), BSON(kShardKey << 30));","+    auto completionFuture1 =","+        registerAndCreatePersistentTask(opCtx, task1->getTask(), task1->getOngoingQueriesFuture());","+","+    ASSERT_EQ(2, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+","+    {","+        FailPointEnableBlock hangBeforeDoingDeletionFp(\"hangBeforeDoingDeletion\");","+        // Drain the one of the tasks and hang before deletion","+        task0->drainOngoingQueries();","+","+        hangBeforeDoingDeletionFp.wait(2);","+","+        verifyProcessingFlag(opCtx, uuidCollA, task0->getTask().getRange(), true);","+","+        // Change the number of worker threads to 1","+        unittest::ServerParameterGuard threadCount{\"rangeDeleterThreadsCount\", 1};","+","+        FailPointEnableBlock rangeDeleterWaitingForWorkerCapacityFp(","+            \"rangeDeleterWaitingForWorkerCapacity\");","+        task1->drainOngoingQueries();","+        // Check that the dispatcher is waiting for worker to be available","+        rangeDeleterWaitingForWorkerCapacityFp.wait();","+        verifyProcessingFlag(opCtx, uuidCollA, task1->getTask().getRange(), false);","+    }","+","+    completionFuture0.get(opCtx);","+    completionFuture1.get(opCtx);","+","+    ASSERT_EQ(0, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+}","+","+TEST_F(RangeDeleterServiceTest, StepDownKillsAllWorkers) {","+    auto rds = RangeDeleterService::get(opCtx);","+","+    // Set the number of worker threads to 2","+    unittest::ServerParameterGuard threadCount{\"rangeDeleterThreadsCount\", 2};","+","+    // Register non-overlapping tasks","+    // Task 0: [0, 10)","+    auto task0 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 0), BSON(kShardKey << 10));","+    auto completionFuture0 =","+        registerAndCreatePersistentTask(opCtx, task0->getTask(), task0->getOngoingQueriesFuture());","+","+    // Task 1: [20, 30) - does NOT overlap with task0","+    auto task1 = createRangeDeletionTaskWithOngoingQueries(","+        uuidCollA, BSON(kShardKey << 20), BSON(kShardKey << 30));","+    auto completionFuture1 =","+        registerAndCreatePersistentTask(opCtx, task1->getTask(), task1->getOngoingQueriesFuture());","+","+    ASSERT_EQ(2, rds->getNumRangeDeletionTasksForCollection(uuidCollA));","+","+    {","+        FailPointEnableBlock hangBeforeDoingDeletionFp(\"hangBeforeDoingDeletion\");","+        task0->drainOngoingQueries();","+        task1->drainOngoingQueries();","+","+        hangBeforeDoingDeletionFp.wait(4);","+","+        verifyProcessingFlag(opCtx, uuidCollA, task0->getTask().getRange(), true);","+        verifyProcessingFlag(opCtx, uuidCollA, task1->getTask().getRange(), true);","+","+        rds->onStepDown();","+    }","+","+    ASSERT_THROWS_CODE(completionFuture0.get(opCtx), DBException, ErrorCodes::Interrupted);","+    ASSERT_THROWS_CODE(completionFuture1.get(opCtx), DBException, ErrorCodes::Interrupted);","+}"," }  // namespace mongo"],"additions":406,"deletions":41,"truncated":false},{"path":"src/mongo/db/s/range_deletion_util.cpp","lines":["@@ -237,8 +237,9 @@ void ensureRangeDeletionTaskStillExists(OperationContext* opCtx,","     // document has already been deleted, then it is possible for the range in the user collection","     // to now be owned by this shard and for proceeding with the range deletion to result in data","     // corruption. The scheme for checking whether the range deletion task document still exists","-    // relies on the executor only having a single thread and that thread being solely responsible","-    // for deleting the range deletion task document.","+    // relies on each range-deletion worker deleting only the persistent task document identified by","+    // its own task ID. Since overlapping range deletions are serialized, no other worker can remove","+    // this task document while this operation context is running.","     PersistentTaskStore<RangeDeletionTask> store(NamespaceString::kRangeDeletionNamespace);","     const auto query =","         BSON(RangeDeletionTask::kCollectionUuidFieldName","@@ -344,7 +345,7 @@ StatusWith<std::pair<int, int>> deleteRangeInBatches(OperationContext* opCtx,","     int totalNumDeleted = 0, totalBytesDeleted = 0;","     // Delete all batches in this range unless a stepdown error occur