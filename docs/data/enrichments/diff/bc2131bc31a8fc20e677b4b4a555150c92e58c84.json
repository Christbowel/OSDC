NewSession(void* heap)"," #endif","         ret->type = WOLFSSL_SESSION_TYPE_HEAP;","         ret->heap = heap;","+#ifdef WOLFSSL_STATIC_MEMORY","+        wc_HeapHint_Ref(heap);","+#endif"," #ifdef WOLFSSL_CHECK_MEM_ZERO","         wc_MemZero_Add(\"SESSION master secret\", ret->masterSecret, SECRET_LEN);","         wc_MemZero_Add(\"SESSION id\", ret->sessionID, ID_LEN);","@@ -4607,8 +4610,15 @@ void wolfSSL_FreeSession(WOLFSSL_CTX* ctx, WOLFSSL_SESSION* session)","     ForceZero(session->sessionID, ID_LEN);"," ","     if (session->type == WOLFSSL_SESSION_TYPE_HEAP) {","+    #ifdef WOLFSSL_STATIC_MEMORY","+        void* heap = session->heap;","+    #endif","         /* // NOLINTNEXTLINE(clang-analyzer-unix.Malloc) */","         XFREE(session, session->heap, DYNAMIC_TYPE_SESSION);","+    #ifdef WOLFSSL_STATIC_MEMORY","+        /* after the XFREE: it may free the hint the session came from */","+        wc_HeapHint_Unref(heap);","+    #endif","     }"," }"," "],"additions":11,"deletions":1,"truncated":false},{"path":"src/x509.c","lines":["@@ -4278,6 +4278,9 @@ static void ExternalFreeX509(WOLFSSL_X509* x509)","             if (doFree)","         #endif /* OPENSSL_EXTRA_X509_SMALL || OPENSSL_EXTRA */","             {","+            #ifdef WOLFSSL_STATIC_MEMORY","+                void* heap = x509->heap;","+            #endif","             #ifdef HAVE_EX_DATA_CLEANUP_HOOKS","                 /* Only with the last reference, as other holders may still","                  * use the ex_data. */","@@ -4285,6 +4288,10 @@ static void ExternalFreeX509(WOLFSSL_X509* x509)","             #endif","                 FreeX509(x509);","                 XFREE(x509, x509->heap, DYNAMIC_TYPE_X509);","+            #ifdef WOLFSSL_STATIC_MEMORY","+                /* after the XFREE: it may free the hint x509 came from */","+                wc_HeapHint_Unref(heap);","+            #endif","             }","         }","         else {"],"additions":7,"deletions":0,"truncated":false},{"path":"tests/api.c","lines":["@@ -39781,6 +39781,391 @@ static int test_wolfSSL_set_SSL_CTX_static_heap(void)","     return EXPECT_RESULT();"," }"," ","+/* A session retained past wolfSSL_free() keeps using the per-connection","+ * static-memory heap hint, which stays alive until its last holder is freed. */","+static int test_wolfSSL_get1_session_static_heap(void)","+{","+    EXPECT_DECLS;","+#if defined(WOLFSSL_STATIC_MEMORY) && !defined(WOLFCRYPT_ONLY) && \\","+    !defined(NO_TLS) && !defined(NO_SESSION_CACHE) && \\","+    !defined(NO_WOLFSSL_CLIENT)","+    byte mem[TEST_TLS_STATIC_MEMSZ];","+    WOLFSSL_HEAP_HINT* heap = NULL;","+    WOLFSSL_CTX* ctx = NULL;","+    WOLFSSL* ssl = NULL;","+    WOLFSSL_SESSION* sess = NULL;","+    WOLFSSL_SESSION* dup = NULL;","+    WOLFSSL_HEAP_HINT* hint = NULL;","+    WOLFSSL_MEM_STATS before;","+    WOLFSSL_MEM_STATS after;","+","+    XMEMSET(&before, 0, sizeof(before));","+    XMEMSET(&after, 0, sizeof(after));","+    ExpectIntEQ(wc_LoadStaticMemory(&heap, mem, sizeof(mem),","+        WOLFMEM_GENERAL | WOLFMEM_TRACK_STATS, 1), 0);","+    ExpectNotNull(ctx = wolfSSL_CTX_new_ex(wolfSSLv23_client_method_ex(heap),","+        heap));","+    /* The first SSL makes a one-time allocation for the CTX; take the","+     * baseline after it. */","+    ExpectNotNull(ssl = wolfSSL_new(ctx));","+    wolfSSL_free(ssl);","+    ssl = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx, &before), 1);","+","+    ExpectNotNull(ssl = wolfSSL_new(ctx));","+    /* The per-SSL hint is held by the SSL and by ssl->session. */","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl->heap);","+    ExpectIntEQ(hint->sslOwned, 1);","+    ExpectIntEQ(hint->refCount, 2);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl));","+    ExpectPtrEq(sess->heap, hint);","+    /* A session reference is not a heap hint reference. */","+    ExpectIntEQ(hint->refCount, 2);","+    wolfSSL_SESSION_free(sess);","+    sess = NULL;","+    ExpectIntEQ(hint->refCount, 2);","+    /* No handshake done, so clear replaces the session. */","+    ExpectIntEQ(wolfSSL_clear(ssl), WOLFSSL_SUCCESS);","+    ExpectIntEQ(hint->refCount, 2);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl));","+    wolfSSL_free(ssl);","+    ssl = NULL;","+    /* Only the retained session keeps the hint alive now. */","+    ExpectPtrEq(sess->heap, hint);","+    ExpectIntEQ(hint->refCount, 1);","+","+    /* Both operations go through sess->heap after the SSL is gone. */","+    ExpectNotNull(dup = wolfSSL_SESSION_dup(sess));","+    ExpectPtrEq(dup->heap, hint);","+    ExpectIntEQ(hint->refCount, 2);","+    wolfSSL_SESSION_free(dup);","+    ExpectIntEQ(hint->refCount, 1);","+    /* The last reference: the hint goes back to the pool (checked below). */","+    wolfSSL_SESSION_free(sess);","+","+    /* Everything allocated for the SSL went back to the pool. Stats are not","+     * filled in with WOLFSSL_STATIC_MEMORY_LEAN. */","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx, &after), 1);","+#ifndef WOLFSSL_STATIC_MEMORY_LEAN","+    ExpectIntEQ(after.curAlloc, before.curAlloc);","+#endif","+","+    wolfSSL_CTX_free(ctx);","+    wc_UnloadStaticMemory(heap);","+#endif","+    return EXPECT_RESULT();","+}","+","+#if defined(WOLFSSL_STATIC_MEMORY) && !defined(WOLFSSL_STATIC_MEMORY_LEAN) && \\","+    defined(HAVE_MANUAL_MEMIO_TESTS_DEPENDENCIES) && \\","+    defined(WOLFSSL_TLS13) && defined(HAVE_SESSION_TICKET) && \\","+    !defined(NO_SESSION_CACHE) && !defined(NO_RSA) && \\","+    !defined(WOLFSSL_NO_DEF_TICKET_ENC_CB)","+static int test_session_static_heap_new_pair(struct test_memio_ctx* test_ctx,","+    WOLFSSL_CTX** ctx_c, WOLFSSL_CTX** ctx_s, WOLFSSL** ssl_c, WOLFSSL** ssl_s,","+    WOLFSSL_SESSION* sess)","+{","+    EXPECT_DECLS;","+    char buf[1];","+","+    test_memio_clear_buffer(test_ctx, 1);","+    test_memio_clear_buffer(test_ctx, 0);","+    ExpectIntEQ(test_memio_setup(test_ctx, ctx_c, ctx_s, ssl_c, ssl_s,","+        NULL, NULL), 0);","+    if (sess != NULL) {","+        ExpectIntEQ(wolfSSL_set_session(*ssl_c, sess), WOLFSSL_SUCCESS);","+    }","+    ExpectIntEQ(test_memio_do_handshake(*ssl_c, *ssl_s, 10, NULL), 0);","+    /* Process the NewSessionTicket sent after the handshake. */","+    ExpectIntEQ(wolfSSL_read(*ssl_c, buf, sizeof(buf)), -1);","+    ExpectIntEQ(wolfSSL_get_error(*ssl_c, -1), WOLFSSL_ERROR_WANT_READ);","+","+    return EXPECT_RESULT();","+}","+#endif","+","+/* Session tickets held by a session retained past wolfSSL_free() must come","+ * from, and go back to, the session's heap. */","+static int test_wolfSSL_session_ticket_static_heap(void)","+{","+    EXPECT_DECLS;","+#if defined(WOLFSSL_STATIC_MEMORY) && !defined(WOLFSSL_STATIC_MEMORY_LEAN) && \\","+    defined(HAVE_MANUAL_MEMIO_TESTS_DEPENDENCIES) && \\","+    defined(WOLFSSL_TLS13) && defined(HAVE_SESSION_TICKET) && \\","+    !defined(NO_SESSION_CACHE) && !defined(NO_RSA) && \\","+    !defined(WOLFSSL_NO_DEF_TICKET_ENC_CB)","+    byte cliMem[TEST_TLS_STATIC_MEMSZ];","+    byte svrMem[TEST_TLS_STATIC_MEMSZ];","+    byte bigTicket[SESSION_TICKET_LEN + 1];","+    struct test_memio_ctx test_ctx;","+    WOLFSSL_CTX* ctx_c = NULL;","+    WOLFSSL_CTX* ctx_s = NULL;","+    WOLFSSL* ssl_c = NULL;","+    WOLFSSL* ssl_s = NULL;","+    WOLFSSL_SESSION* sess = NULL;","+    WOLFSSL_SESSION* dup = NULL;","+    WOLFSSL_HEAP_HINT* hint = NULL;","+    WOLFSSL_MEM_STATS before;","+    WOLFSSL_MEM_STATS after;","+    char buf[1];","+","+    XMEMSET(&test_ctx, 0, sizeof(test_ctx));","+    XMEMSET(&before, 0, sizeof(before));","+    XMEMSET(&after, 0, sizeof(after));","+    XMEMSET(bigTicket, 0xA5, sizeof(bigTicket));","+","+    ExpectIntEQ(wolfSSL_CTX_load_static_memory(&ctx_c,","+        wolfTLSv1_3_client_method_ex, cliMem, sizeof(cliMem),","+        WOLFMEM_GENERAL | WOLFMEM_TRACK_STATS, 2), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_CTX_load_static_memory(&ctx_s,","+        wolfTLSv1_3_server_method_ex, svrMem, sizeof(svrMem),","+        WOLFMEM_GENERAL, 2), WOLFSSL_SUCCESS);","+    if (EXPECT_SUCCESS()) {","+        wolfSSL_CTX_set_verify(ctx_c, WOLFSSL_VERIFY_NONE, NULL);","+        wolfSSL_SetIORecv(ctx_c, test_memio_read_cb);","+        wolfSSL_SetIOSend(ctx_c, test_memio_write_cb);","+        wolfSSL_SetIORecv(ctx_s, test_memio_read_cb);","+        wolfSSL_SetIOSend(ctx_s, test_memio_write_cb);","+    }","+    ExpectIntEQ(wolfSSL_CTX_use_certificate_file(ctx_s, svrCertFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_CTX_use_PrivateKey_file(ctx_s, svrKeyFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+","+    /* A first connection makes the one-time allocations for the CTXs; take","+     * the baseline after it. */","+    ExpectIntEQ(test_session_static_heap_new_pair(&test_ctx, &ctx_c, &ctx_s,","+        &ssl_c, &ssl_s, NULL), TEST_SUCCESS);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_c, &before), 1);","+","+    /* Full handshake: keep the session with its ticket after the SSL. */","+    ExpectIntEQ(test_session_static_heap_new_pair(&test_ctx, &ctx_c, &ctx_s,","+        &ssl_c, &ssl_s, NULL), TEST_SUCCESS);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl_c));","+    ExpectIntGT(sess->ticketLen, 0);","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl_c->heap);","+    ExpectPtrEq(sess->heap, hint);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    /* The retained session keeps the client's per-SSL hint alive. */","+    ExpectIntEQ(hint->refCount, 1);","+","+    /* Resume with the session on a new SSL; a new ticket replaces the old. */","+    ExpectIntEQ(test_session_static_heap_new_pair(&test_ctx, &ctx_c, &ctx_s,","+        &ssl_c, &ssl_s, sess), TEST_SUCCESS);","+    ExpectIntEQ(wolfSSL_session_reused(ssl_c), 1);","+    /* The new SSL took sess, then copied it (from sess->heap) before storing","+     * the new ticket, so the first SSL's hint is held twice. */","+    ExpectPtrNE(ssl_c->heap, hint);","+    ExpectPtrNE(ssl_c->session, sess);","+    ExpectPtrEq(ssl_c->session->heap, hint);","+    ExpectIntEQ(hint->refCount, 2);","+    wolfSSL_SESSION_free(sess);","+    sess = NULL;","+    ExpectIntEQ(hint->refCount, 1);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl_c));","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    /* The hint has outlived both SSLs. */","+    ExpectIntEQ(hint->refCount, 1);","+    wolfSSL_SESSION_free(sess);","+    sess = NULL;","+","+    /* A ticket too big for the static buffer is allocated dynamically. */","+    ExpectNotNull(ssl_c = wolfSSL_new(ctx_c));","+    ExpectIntEQ(wolfSSL_set_SessionTicket(ssl_c, bigTicket,","+        (word32)sizeof(bigTicket)), WOLFSSL_SUCCESS);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl_c));","+    ExpectIntEQ(sess->ticketLenAlloc, sizeof(bigTicket));","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl_c->heap);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    ExpectIntEQ(hint->refCount, 1);","+    ExpectNotNull(dup = wolfSSL_SESSION_dup(sess));","+    ExpectIntEQ(hint->refCount, 2);","+    wolfSSL_SESSION_free(dup);","+    dup = NULL;","+    ExpectIntEQ(hint->refCount, 1);","+    wolfSSL_SESSION_free(sess);","+    sess = NULL;","+","+    /* A full handshake replaces the dynamic ticket with the new, smaller one,","+     * freeing the dynamic buffer through the session's heap. */","+    test_memio_clear_buffer(&test_ctx, 1);","+    test_memio_clear_buffer(&test_ctx, 0);","+    ExpectIntEQ(test_memio_setup(&test_ctx, &ctx_c, &ctx_s, &ssl_c, &ssl_s,","+        NULL, NULL), 0);","+    ExpectIntEQ(wolfSSL_set_SessionTicket(ssl_c, bigTicket,","+        (word32)sizeof(bigTicket)), WOLFSSL_SUCCESS);","+    ExpectIntEQ(ssl_c->session->ticketLenAlloc, sizeof(bigTicket));","+    ExpectIntEQ(test_memio_do_handshake(ssl_c, ssl_s, 10, NULL), 0);","+    ExpectIntEQ(wolfSSL_read(ssl_c, buf, sizeof(buf)), -1);","+    ExpectIntEQ(wolfSSL_get_error(ssl_c, -1), WOLFSSL_ERROR_WANT_READ);","+    ExpectIntEQ(ssl_c->session->ticketLenAlloc, 0);","+    ExpectIntGT(ssl_c->session->ticketLen, 0);","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl_c));","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    wolfSSL_SESSION_free(sess);","+","+    /* Everything allocated for the connections went back to the pool. */","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_c, &after), 1);","+    ExpectIntEQ(after.curAlloc, before.curAlloc);","+","+    wolfSSL_CTX_free(ctx_c);","+    wolfSSL_CTX_free(ctx_s);","+#endif","+    return EXPECT_RESULT();","+}","+","+#if defined(WOLFSSL_STATIC_MEMORY) && \\","+    defined(HAVE_MANUAL_MEMIO_TESTS_DEPENDENCIES) && \\","+    defined(SESSION_CERTS) && defined(OPENSSL_EXTRA) && !defined(NO_RSA) && \\","+    !defined(NO_SESSION_CACHE) && !defined(WOLFSSL_NO_CLIENT_AUTH)","+static int test_peer_cert_static_heap_connect(struct test_memio_ctx* test_ctx,","+    WOLFSSL_CTX** ctx_c, WOLFSSL_CTX** ctx_s, WOLFSSL** ssl_c, WOLFSSL** ssl_s)","+{","+    EXPECT_DECLS;","+","+    test_memio_clear_buffer(test_ctx, 1);","+    test_memio_clear_buffer(test_ctx, 0);","+    ExpectIntEQ(test_memio_setup(test_ctx, ctx_c, ctx_s, ssl_c, ssl_s,","+        wolfSSLv23_client_method, NULL), 0);","+    ExpectIntEQ(wolfSSL_use_certificate_file(*ssl_c, cliCertFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_use_PrivateKey_file(*ssl_c, cliKeyFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+    ExpectIntEQ(test_memio_do_handshake(*ssl_c, *ssl_s, 10, NULL), 0);","+","+    return EXPECT_RESULT();","+}","+#endif","+","+/* On the server, wolfSSL_get_peer_cert_chain() moves the leaf certificate into","+ * the session as its peer. Like any dynamic X509 on the per-connection","+ * static-memory hint, it holds a reference that keeps the hint alive after","+ * wolfSSL_free() until the last holder, session or X509, is freed. */","+static int test_wolfSSL_peer_cert_chain_static_heap(void)","+{","+    EXPECT_DECLS;","+#if defined(WOLFSSL_STATIC_MEMORY) && \\","+    defined(HAVE_MANUAL_MEMIO_TESTS_DEPENDENCIES) && \\","+    defined(SESSION_CERTS) && defined(OPENSSL_EXTRA) && !defined(NO_RSA) && \\","+    !defined(NO_SESSION_CACHE) && !defined(WOLFSSL_NO_CLIENT_AUTH)","+    byte svrMem[TEST_TLS_STATIC_MEMSZ];","+    struct test_memio_ctx test_ctx;","+    WOLFSSL_CTX* ctx_c = NULL;","+    WOLFSSL_CTX* ctx_s = NULL;","+    WOLFSSL* ssl_c = NULL;","+    WOLFSSL* ssl_s = NULL;","+    WOLFSSL_SESSION* sess = NULL;","+    WOLFSSL_HEAP_HINT* hint = NULL;","+#ifdef KEEP_PEER_CERT","+    WOLFSSL_X509* peer = NULL;","+#endif","+    WOLFSSL_MEM_STATS before;","+    WOLFSSL_MEM_STATS after;","+","+    XMEMSET(&test_ctx, 0, sizeof(test_ctx));","+    XMEMSET(&before, 0, sizeof(before));","+    XMEMSET(&after, 0, sizeof(after));","+","+    ExpectIntEQ(wolfSSL_CTX_load_static_memory(&ctx_s,","+        wolfSSLv23_server_method_ex, svrMem, sizeof(svrMem),","+        WOLFMEM_GENERAL | WOLFMEM_TRACK_STATS, 1), WOLFSSL_SUCCESS);","+    if (EXPECT_SUCCESS()) {","+        wolfSSL_SetIORecv(ctx_s, test_memio_read_cb);","+        wolfSSL_SetIOSend(ctx_s, test_memio_write_cb);","+        wolfSSL_CTX_set_verify(ctx_s, WOLFSSL_VERIFY_PEER |","+            WOLFSSL_VERIFY_FAIL_IF_NO_PEER_CERT, NULL);","+    }","+    ExpectIntEQ(wolfSSL_CTX_use_certificate_file(ctx_s, svrCertFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_CTX_use_PrivateKey_file(ctx_s, svrKeyFile,","+        CERT_FILETYPE), WOLFSSL_SUCCESS);","+    ExpectIntEQ(wolfSSL_CTX_load_verify_locations(ctx_s, cliCertFile, NULL),","+        WOLFSSL_SUCCESS);","+","+    /* A first connection makes the one-time allocations for the server CTX;","+     * take the baseline after it. */","+    ExpectIntEQ(test_peer_cert_static_heap_connect(&test_ctx, &ctx_c, &ctx_s,","+        &ssl_c, &ssl_s), TEST_SUCCESS);","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_s, &before), 1);","+","+    /* The session is the last holder. */","+    ExpectIntEQ(test_peer_cert_static_heap_connect(&test_ctx, &ctx_c, &ctx_s,","+        &ssl_c, &ssl_s), TEST_SUCCESS);","+    /* The server's per-SSL hint is held by the SSL and by ssl->session. */","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl_s->heap);","+    ExpectIntEQ(hint->refCount, 2);","+","+    ExpectNotNull(wolfSSL_get_peer_cert_chain(ssl_s));","+    ExpectNotNull(sess = wolfSSL_get1_session(ssl_s));","+    ExpectNotNull(sess->peer);","+    /* The leaf moved into the session is a dynamic X509 on the SSL's hint","+     * and holds its own reference. */","+    ExpectPtrEq(sess->peer->heap, hint);","+    ExpectIntGE(hint->refCount, 3);","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    /* Only the session and its peer keep the hint alive now. */","+    ExpectIntEQ(hint->refCount, 2);","+    /* The peer is still usable once the SSL is gone. */","+    ExpectNotNull(wolfSSL_SESSION_get0_peer(sess));","+    wolfSSL_SESSION_free(sess);","+    sess = NULL;","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+","+#ifdef KEEP_PEER_CERT","+    /* An X509 is the last holder. */","+    ExpectIntEQ(test_peer_cert_static_heap_connect(&test_ctx, &ctx_c, &ctx_s,","+        &ssl_c, &ssl_s), TEST_SUCCESS);","+    ExpectNotNull(hint = (WOLFSSL_HEAP_HINT*)ssl_s->heap);","+    ExpectIntEQ(hint->refCount, 2);","+    /* A copy of ssl->peerCert, so on the SSL's hint. */","+    ExpectNotNull(peer = wolfSSL_get_peer_certificate(ssl_s));","+    ExpectPtrEq(peer->heap, hint);","+    ExpectIntEQ(hint->refCount, 3);","+    wolfSSL_free(ssl_s);","+    ssl_s = NULL;","+    /* The SSL and its session are gone; only the X509 holds the hint. */","+    ExpectIntEQ(hint->refCount, 1);","+    ExpectNotNull(wolfSSL_X509_get_subject_name(peer));","+    /* The last reference: the hint goes back to the pool (checked below). */","+    wolfSSL_X509_free(peer);","+    peer = NULL;","+    wolfSSL_free(ssl_c);","+    ssl_c = NULL;","+#endif","+","+    /* Everything allocated for the connections went back to the pool. Stats","+     * are not filled in with WOLFSSL_STATIC_MEMORY_LEAN. */","+    ExpectIntEQ(wolfSSL_CTX_is_static_memory(ctx_s, &after), 1);","+#ifndef WOLFSSL_STATIC_MEMORY_LEAN","+    ExpectIntEQ(after.curAlloc, before.curAlloc);","+#endif","+","+    wolfSSL_CTX_free(ctx_c);","+    wolfSSL_CTX_free(ctx_s);","+#endif","+    return EXPECT_RESULT();","+}","+"," static int test_openssl_FIPS_drbg(void)"," {","     EXPECT_DECLS;","@@ -47349,6 +47734,9 @@ TEST_CASE testCases[] = {","     /* Can't memory test as client/server hangs. */","     TEST_DECL(test_wolfSSL_CTX_StaticMemory),","     TEST_DECL(test_wolfSSL_set_SSL_CTX_static_heap),","+    TEST_DECL(test_wolfSSL_get1_session_static_heap),","+    TEST_DECL(test_wolfSSL_session_ticket_static_heap),","+    TEST_DECL(test_wolfSSL_peer_cert_chain_static_heap),"," #if !defined(NO_FILESYSTEM) &&                                                 \\","      defined(WOLFSSL_DTLS) && !defined(WOLFSSL_NO_TLS12) &&                    \\","     !defined(NO_WOLFSSL_CLIENT) && !defined(NO_WOLFSSL_SERVER)"],"additions":388,"deletions":0,"truncated":false},{"path":"tests/api/test_session.c","lines":["@@ -513,11 +513,13 @@ static int twcase_server_sess_ctx_pre_shutdown(WOLFSSL* ssl)","         /* Now save the session in the internal store to make it available","          * for lookup. For TLS 1.3, we can't save the session without","          * WOLFSSL_TICKET_HAVE_ID because there is no way to retrieve the","-         * session from cache. */","+         * session from cache. The same holds for a TLS 1.2 ticket session,","+         * which has no session ID without WOLFSSL_TICKET_HAVE_ID. */","         if (wolfSSL_is_server(ssl)"," #ifndef WOLFSSL_TICKET_HAVE_ID","                 && wolfSSL_version(ssl) != TLS1_3_VERSION","                 && wolfSSL_version(ssl) != DTLS1_3_VERSION","+                && *sess != NULL && (*sess)->sessionIDSz > 0"," #endif","                 ) {","             ExpectIntEQ(wolfSSL_CTX_add_session(wolfSSL_get_SSL_CTX(ssl),","@@ -870,7 +872,13 @@ static WC_MAYBE_UNUSED int test_wolfSSL_CTX_add_session_ext(","                 else {","                     /* The ticket is reused, no new session */","                     ExpectIntEQ(twcase_new_session_called, 0);","+                #ifdef WOLFSSL_TICKET_HAVE_ID","                     ExpectIntEQ(twcase_remove_session_called, 1);","+                #else","+                    /* No session ID, so the session was not cached in","+                     * twcase_server_sess_ctx_pre_shutdown to be removed */","+                    ExpectIntEQ(twcase_remove_session_called, 0);","+                #endif","                 }","                 break;"," #ifdef WOLFSSL_EARLY_DATA"],"additions":9,"deletions":1,"truncated":false},{"path":"wolfcrypt/src/memory.c","lines":["@@ -856,6 +856,93 @@ void wc_UnloadStaticMemory(WOLFSSL_HEAP_HINT* heap)"," #endif"," }"," ","+","+/* Returns 1 if heap is a per-SSL hint created by InitSSL_StaticMemory. Only","+ * these are reference counted; CTX, user and global hints are left alone. */","+static int wc_HeapHint_IsRefCounted(const WOLFSSL_HEAP_HINT* hint)","+{","+    if (hint == NULL) {","+        return 0;","+    }","+#ifdef WOLFSSL_HEAP_TEST","+    /* avoid dereferencing a test value */","+    if (hint == (const WOLFSSL_HEAP_HINT*)WOLFSSL_HEAP_TEST) {","+        return 0;","+    }","+#endif","+    return hint->sslOwned && hint->memory != NULL;","+}","+","+/* Take a reference on a per-SSL heap hint so it stays valid after","+ * wolfSSL_free() for an object (e.g. a session) allocated from it. */","+void wc_HeapHint_Ref(void* heap)","+{","+    WOLFSSL_HEAP_HINT* hint = (WOLFSSL_HEAP_HINT*)heap;","+","+    int locked = 1;","+","+    if (!wc_HeapHint_IsRefCounted(hint)) {","+        return;","+    }","+#ifndef SINGLE_THREADED","+    if (wc_LockMutex(&hint->memory->memory_mutex) != 0) {","+        /* still take the reference: the caller's object is created either","+         * way and drops it when freed, so skipping it would free the hint","+         * early */","+        WOLFSSL_MSG(\"Bad memory_mutex lock\");","+        locked = 0;","+    }","+#endif","+    hint->refCount++;","+#ifndef SINGLE_THREADED","+    if (locked) {","+        wc_UnLockMutex(&hint->memory->memory_mutex);","+    }","+#endif","+    (void)locked;","+}","+","+/* Drop a reference on a per-SSL heap hint, freeing it back to its pool when","+ * the last one is gone. The hint must not be used by the caller after this. */","+void wc_HeapHint_Unref(void* heap)","+{","+    WOLFSSL_HEAP_HINT* hint = (WOLFSSL_HEAP_HINT*)heap;","+    WOLFSSL_HEAP_HINT  tmp;","+    WOLFSSL_HEAP*      mem;","+    word32             refCount;","+","+    if (!wc_HeapHint_IsRefCounted(hint)) {","+        return;","+    }","+    mem = hint->memory;","+#ifndef SINGLE_THREADED","+    if (wc_LockMutex(&mem->memory_mutex) != 0) {","+        WOLFSSL_MSG(\"Bad memory_mutex lock\");","+        return;","+    }","+#endif","+    if (hint->refCount == 0) {","+        /* unbalanced unref; leave the hint alone rather than wrap */","+        WOLFSSL_MSG(\"Heap hint reference count underflow\");","+    #ifndef SINGLE_THREADED","+        wc_UnLockMutex(&mem->memory_mutex);","+    #endif","+        return;","+    }","+    refCount = --hint->refCount;","+#ifndef SINGLE_THREADED","+    /* unlock before XFREE, which takes memory_mutex */","+    wc_UnLockMutex(&mem->memory_mutex);","+#endif","+    if (refCount == 0) {","+        /* free through a temporary hint on the same pool so neither the CTX","+         * nor the hint being freed is needed */","+        XMEMSET(&tmp, 0, sizeof(tmp));","+        tmp.memory = mem;","+        XFREE(hint, &tmp, DYNAMIC_TYPE_SSL);","+    }","+}","+"," #ifndef WOLFSSL_STATIC_MEMORY_LEAN"," /* returns the size of management memory needed for each bucket.","  * This is memory that is used to keep track of and align memory buckets. */"],"additions":87,"deletions":0,"truncated":false},{"path":"wolfssl/wolfcrypt/memory.h","lines":["@@ -277,6 +277,8 @@ WOLFSSL_API int wolfSSL_GetAllocators(wolfSSL_Malloc_cb* mf,","         wc_Memory*  inBuf;","         byte        haFlag; /* flag used for checking handshake count */","     #endif","+        word32      refCount; /* SSL ref + other refs */","+        byte        sslOwned; /* created by InitSSL_StaticMemory */","     } WOLFSSL_HEAP_HINT;"," ","     WOLFSSL_API void* wolfSSL_SetGlobalHeapHint(void* heap);","@@ -298,6 +300,8 @@ WOLFSSL_API int wolfSSL_GetAllocators(wolfSSL_Malloc_cb* mf,","     WOLFSSL_API int wc_LoadStaticMemory(WOLFSSL_HEAP_HINT** pHint,","             unsigned char* buf, unsigned int sz, int flag, int max);","     WOLFSSL_API void wc_UnloadStaticMemory(WOLFSSL_HEAP_HINT* heap);","+    WOLFSSL_LOCAL void wc_HeapHint_Ref(void* heap);","+    WOLFSSL_LOCAL void wc_HeapHint_Unref(void* heap);"," ","     WOLFSSL_API int wolfSSL_GetMemStats(WOLFSSL_HEAP* heap,","                                                       WOLFSSL_MEM_STATS* stats);",""],"additions":4,"deletions":0,"truncated":false}],"additions":537,"deletions":21,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-06T17:02:12.175071+00:00"}