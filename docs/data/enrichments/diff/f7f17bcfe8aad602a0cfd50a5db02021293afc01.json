{"id":"f7f17bcfe8aad602a0cfd50a5db02021293afc01","axis":"silent","repo":"vllm-project/vllm","sha":"f7f17bcfe8aad602a0cfd50a5db02021293afc01","parsed":{"files":[{"path":"docs/features/tool_calling.md","lines":["@@ -600,8 +600,8 @@ Flags: `--tool-call-parser apertus`"," The Muse parser supports the ATEM tool-call format used by Muse Spark Open."," Enable tool calling with `--enable-auto-tool-choice`,"," `--tool-call-parser muse`, and `--reasoning-parser muse`. `musespark` is an","-alias for both parsers. The `muse_glimmer` entry points share the Muse implementation while retaining","-their original channel semantics, including recipient-less tool-parser content.","+alias for both parsers. The `muse_glimmer` entry points keep their original channel semantics, including","+recipient-less tool-parser content."," "," The parsers route `to=self` and recipient-less messages to reasoning,"," `to=user` and `to=commentary` messages to content, and tool recipients to"],"additions":2,"deletions":2,"truncated":false},{"path":"tests/parser/engine/test_muse.py","lines":["@@ -0,0 +1,212 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Tests for the engine-based Muse Spark parser, streaming and non-streaming.\"\"\"","+","+import json","+","+import pytest","+","+from tests.parser.engine.replay_harness import (","+    MockTokenizer,","+    collect_output,","+    replay_streaming,","+    replay_with_text_holdback,","+)","+from vllm.entrypoints.openai.chat_completion.protocol import (","+    ChatCompletionRequest,","+    ChatCompletionToolsParam,","+)","+from vllm.parser.parser_manager import ParserManager","+from vllm.reasoning import ReasoningParserManager","+","+EOM, EOT, START, MESSAGE = \"<|eom|>\", \"<|eot|>\", \"<|start|>\", \"<|message|>\"","+VOCAB = {EOM: 200007, EOT: 200008, START: 200022, MESSAGE: 200023}","+H = f\"{START}assistant\"","+","+","+def _tool(name: str, properties: dict | None = None) -> dict:","+    return {","+        \"type\": \"function\",","+        \"function\": {","+            \"name\": name,","+            \"parameters\": {\"type\": \"object\", \"properties\": properties or {}},","+        },","+    }","+","+","+def _call(name: str, emitted: str | None = None, **params: str) -> str:","+    body = \"\".join(","+        f'<atem:parameter name=\"{key}\">{value}</atem:parameter>\\n'","+        for key, value in params.items()","+    )","+    return (","+        f\" to={emitted or name}{MESSAGE}<atem:function_calls>\\n\"","+        f'<atem:invoke name=\"{emitted or name}\">\\n{body}</atem:invoke>\\n'","+        \"</atem:function_calls>\"","+    )","+","+","+def _tokens(text: str) -> list[tuple[int, str]]:","+    tokens: list[tuple[int, str]] = []","+    i = 0","+    while i < len(text):","+        marker = next((m for m in VOCAB if text.startswith(m, i)), None)","+        if marker is not None:","+            tokens.append((VOCAB[marker], marker))","+            i += len(marker)","+        else:","+            tokens.append((ord(text[i]), text[i]))","+            i += 1","+    return tokens","+","+","+def _muse_parser(tokens: list[tuple[int, str]], tools: list[dict] | None = None):","+    parser_cls = ParserManager.get_parser(","+        tool_parser_name=\"muse\", reasoning_parser_name=\"muse\", enable_auto_tools=True","+    )","+    assert parser_cls is not None","+    tool_params = [ChatCompletionToolsParam.model_validate(t) for t in tools or []]","+    return parser_cls(MockTokenizer(dict(VOCAB), tokens), tool_params or None)","+","+","+def _parse(","+    raw: str, chunk: int | None, tools: list[dict] | None = None","+) -> tuple[str, str, list[tuple[str, dict]]]:","+    \"\"\"Return reasoning, content and calls; `chunk=None` parses non-streaming.\"\"\"","+    tokens = _tokens(raw)","+    parser = _muse_parser(tokens, tools)","+    if chunk is None:","+        request = ChatCompletionRequest(","+            model=\"muse\", messages=[{\"role\": \"user\", \"content\": \"hi\"}], tools=tools","+        )","+        reasoning, content, calls = parser.parse(","+            raw,","+            request,","+            enable_auto_tools=True,","+            model_output_token_ids=[tid for tid, _ in tokens],","+        )","+        found = [(c.name, json.loads(c.arguments)) for c in calls or []]","+        return reasoning or \"\", content or \"\", found","+    output = collect_output(","+        replay_streaming(","+            parser, tokens, chunk_size=chunk, finished_on_last=True, tools=tools","+        )","+    )","+    found = [(c[\"name\"], json.loads(c[\"arguments\"])) for c in output.tool_calls]","+    return output.reasoning, output.content, found","+","+","+MODES = pytest.mark.parametrize(\"chunk\", [1, 3, None], ids=[\"s1\", \"s3\", \"full\"])","+","+","+@MODES","+@pytest.mark.parametrize(","+    (\"raw\", \"reasoning\", \"content\"),","+    [","+        (","+            f\" to=self{MESSAGE}Plan.{EOM}{H} to=user{MESSAGE}Done.{EOT}\",","+            \"Plan.\",","+            \"Done.\",","+        ),","+        (f\" to=developer{MESSAGE}internal{EOM}{H} to=user{MESSAGE}Ok.\", \"\", \"Ok.\"),","+        (f\" to=commentary{MESSAGE}Wait. {EOM}{H} to=user{MESSAGE}Ok.\", \"\", \"Wait. Ok.\"),","+        (f\" to=self{MESSAGE}Think. to=user{MESSAGE}Done.{EOT}\", \"Think. \", \"Done.\"),","+        (\"Plain text.\", \"\", \"Plain text.\"),","+    ],","+    ids=[\"self-user\", \"developer\", \"commentary\", \"missing-eom\", \"unframed\"],","+)","+def test_recipient_routes_body(chunk, raw, reasoning, content):","+    assert _parse(raw, chunk) == (reasoning, content, [])","+","+","+@MODES","+def test_tool_header_after_body_without_eom_keeps_call(chunk):","+    raw = f\" to=self{MESSAGE}Need the time.\" + _call(\"time_now\") + EOT","+    assert _parse(raw, chunk, [_tool(\"time_now\")]) == (","+        \"Need the time. \",","+        \"\",","+        [(\"time_now\", {})],","+    )","+","+","+@MODES","+def test_atem_quoted_in_answer_is_not_a_call(chunk):","+    quoted = _call(\"get_weather\", city=\"Rome\").split(MESSAGE, 1)[1]","+    raw = f\" to=user{MESSAGE}Write {quoted} to call it.{EOT}\"","+    assert _parse(raw, chunk, [_tool(\"get_weather\")])[2] == []","+","+","+@MODES","+def test_arguments_follow_the_registered_tool(chunk):","+    tool = _tool(\"echo\", {\"text\": {\"type\": \"string\"}, \"count\": {\"type\": \"integer\"}})","+    raw = _call(\"echo\", \"echo.echo\", text=\"25\", count=\"25\") + EOT","+    assert _parse(raw, chunk, [tool])[2] == [(\"echo\", {\"text\": \"25\", \"count\": 25})]","+","+","+@MODES","+@pytest.mark.parametrize(\"emitted\", [\"Bash.command\", \"Bash.execute\", \"Bash.\"])","+def test_bare_tool_name_with_any_suffix_collapses(chunk, emitted):","+    tool = _tool(\"Bash\", {\"timeout\": {\"type\": \"integer\"}})","+    raw = _call(\"Bash\", emitted, timeout=\"5\") + EOT","+    assert _parse(raw, chunk, [tool])[2] == [(\"Bash\", {\"timeout\": 5})]","+","+","+@MODES","+def test_suffix_is_kept_when_a_sibling_is_registered(chunk):","+    raw = _call(\"Bash\", \"Bash.fetch\") + EOT","+    tools = [_tool(\"Bash\"), _tool(\"Bash.run\")]","+    assert _parse(raw, chunk, tools)[2] == [(\"Bash.fetch\", {})]","+","+","+def test_reasoning_ends_only_at_a_tool_header_of_the_current_turn():","+    prompt = _tokens(","+        f\"{H}{_call('get_weather', city='Paris')}{EOT}\"","+        f\"{START}tool get_weather{MESSAGE}21{EOT}{H}\"","+    )","+    output = _tokens(f\" to=self{MESSAGE}Check.{EOM}{H}\" + _call(\"time_now\"))","+    reasoner_cls = ReasoningParserManager.get_reasoning_parser(\"muse\")","+    reasoner = reasoner_cls(MockTokenizer(dict(VOCAB), prompt + output))","+    ids = [tid for tid, _ in prompt + output]","+    assert not reasoner.is_reasoning_end(ids[: len(prompt)])","+    ended = [","+        reasoner.is_reasoning_end_streaming(ids[: end + 1], ids[end : end + 1])","+        for end in range(len(prompt), len(ids))","+    ]","+    tool_message = len(ids) - ids[::-1].index(VOCAB[MESSAGE]) - 1","+    assert [i for i, e in enumerate(ended) if e] == [tool_message - len(prompt)]","+","+","+def test_reasoning_tokens_include_reasoning_after_tool_call():","+    tokens = _tokens(","+        f\" to=self{MESSAGE}ab{EOM}{H}\"","+        + _call(\"time_now\")","+        + f\"{EOM}{H} to=self{MESSAGE}cde{EOM}{H} to=user{MESSAGE}Ok.{EOT}\"","+    )","+    parser = _muse_parser(tokens)","+    replay_streaming(parser, tokens, chunk_size=1, finished_on_last=True)","+    assert parser.count_reasoning_tokens([tid for tid, _ in tokens]) == len(\"abcde\")","+","+","+def test_reasoning_tokens_count_text_held_back_by_the_detokenizer():","+    tokens = _tokens(f\" to=self{MESSAGE}abcd{EOM}{H} to=user{MESSAGE}Ok.{EOT}\")","+    parser = _muse_parser(tokens)","+    replay_with_text_holdback(parser, tokens, text_delay=3)","+    assert parser.count_reasoning_tokens([tid for tid, _ in tokens]) == len(\"abcd\")","+","+","+def test_parallel_tool_calls_survive_detokenizer_holdback():","+    tools = [_tool(\"get_weather\", {\"city\": {\"type\": \"string\"}})]","+    tokens = _tokens(","+        _call(\"get_weather\", city=\"Paris\")","+        + f\"{EOM}{H}\"","+        + _call(\"get_weather\", city=\"Rome\")","+        + EOT","+    )","+    parser = _muse_parser(tokens, tools)","+    output = collect_output(","+        replay_with_text_holdback(parser, tokens, text_delay=3, tools=tools)","+    )","+    assert [(c[\"name\"], json.loads(c[\"arguments\"])) for c in output.tool_calls] == [","+        (\"get_weather\", {\"city\": \"Paris\"}),","+        (\"get_weather\", {\"city\": \"Rome\"}),","+    ]"],"additions":212,"deletions":0,"truncated":false},{"path":"tests/parser/engine/test_replay.py","lines":["@@ -80,11 +80,11 @@ def _discover_parsers() -> list[_ParserInfo]:","         if cfg.name not in _BUILDERS:","             missing_builders.append(f\"{obj.__name__} (config.name={cfg.name!r})\")","             continue","-        if cfg.name in (\"inkling\", \"plamo3\", \"minimax_m3\", \"ripple\"):","+        if cfg.name in (\"inkling\", \"plamo3\", \"minimax_m3\", \"ripple\", \"muse\"):","             # Inkling uses typed structural blocks. PLaMo, MiniMax M3 and","-            # Ripple markers can span several token IDs. None fits this","-            # TOOL_END-token harness; their direct and delegating coverage lives","-            # in dedicated tests.","+            # Ripple markers can span several token IDs. Muse routes each","+            # message by its recipient. None fits this TOOL_END-token harness;","+            # their direct and delegating coverage lives in dedicated tests.","             continue","         if cfg.name == \"granite\":","             # Granite has a JSON-array tool body with no TOOL_END terminal, so"],"additions":4,"deletions":4,"truncated":false},{"path":"tests/parser/engine/trace_builder.py","lines":["@@ -43,6 +43,7 @@","     MiMoParser,","     MinimaxM2Parser,","     MinimaxM3Parser,","+    MuseParser,","     NemotronV3Parser,","     Plamo3Parser,","     Qwen3Parser,","@@ -1198,6 +1199,86 @@ def _build_inkling(scenario: Scenario, validate: bool = True) -> Sample:","     return sample"," "," ","+# ── Muse Spark (recipient-routed messages, ATEM tool calls) ──────────","+","+_MUSE_VOCAB: dict[str, int] = {","+    \"<|eom|>\": 200007,","+    \"<|eot|>\": 200008,","+    \"<|start|>\": 200022,","+    \"<|message|>\": 200023,","+}","+","+","+def _muse_atem_value(value: Any) -> str:","+    if isinstance(value, bool):","+        return \"true\" if value else \"false\"","+    if isinstance(value, (dict, list)):","+        return json.dumps(value, ensure_ascii=False)","+    return str(value)","+","+","+def _muse_message(","+    segs: list[tuple[str, bool]], recipient: str, body: str, end: str","+) -> None:","+    if segs:","+        segs.extend([(\"<|start|>\", True), (\"assistant\", False)])","+    segs.extend([(f\" to={recipient}\", False), (\"<|message|>\", True)])","+    if body:","+        segs.append((body, False))","+    segs.append((end, True))","+","+","+def _muse_segments(scenario: Scenario) -> list[tuple[str, bool]]:","+    segs: list[tuple[str, bool]] = []","+    tool_calls = scenario.tool_calls","+    if scenario.reasoning is not None:","+        _muse_message(segs, \"self\", scenario.reasoning, \"<|eom|>\")","+    if tool_calls is not None and not tool_calls:","+        _muse_message(","+            segs,","+            \"functions\",","+            \"<atem:function_calls>\\n</atem:function_calls>\",","+            \"<|eom|>\",","+        )","+    if scenario.content is not None:","+        if tool_calls:","+            _muse_message(segs, \"commentary\", scenario.content, \"<|eom|>\")","+        else:","+            _muse_message(segs, \"user\", scenario.content, \"<|eot|>\")","+    for i, tc in enumerate(tool_calls or []):","+        parameters = \"\".join(","+            f'<atem:parameter name=\"{key}\">{_muse_atem_value(value)}</atem:parameter>\\n'","+            for key, value in tc.arguments.items()","+        )","+        body = (","+            f'<atem:function_calls>\\n<atem:invoke name=\"{tc.name}\">\\n'","+            f\"{parameters}</atem:invoke>\\n</atem:function_calls>\"","+        )","+        end = \"<|eot|>\" if i == len(tool_calls) - 1 else \"<|eom|>\"","+        _muse_message(segs, tc.name, body, end)","+    return segs","+","+","+def _build_muse(scenario: Scenario, validate: bool = True) -> Sample:","+    prompt_token_ids = None","+    if scenario.after_tool_response:","+        prompt_token_ids = [_MUSE_VOCAB[\"<|eot|>\"], _MUSE_VOCAB[\"<|start|>\"]]","+    sample = _make_sample(","+        sample_id=f\"muse-{scenario.id}\",","+        description=scenario.description,","+        vocab=_MUSE_VOCAB,","+        segments=_muse_segments(scenario),","+        expected_reasoning=scenario.reasoning,","+        expected_content=_qwen3_expected_content(scenario),","+        expected_tool_calls=_expected_tc(scenario),","+        tools=_expected_tools(scenario),","+        prompt_token_ids=prompt_token_ids,","+    )","+    if validate:","+        _validate_sample(sample, MuseParser)","+    return sample","+","+"," # ── PLaMo3 (literal nested tool-request wrappers) ───────────────────"," "," _PLAMO3_MARKERS = (","@@ -1403,6 +1484,7 @@ def _build_granite(scenario: Scenario, validate: bool = True) -> Sample:","     \"plamo3\": _build_plamo3,","     \"ripple\": _build_ripple,","     \"zaya\": _build_zaya,","+    \"muse\": _build_muse,"," }"," "," "],"additions":82,"deletions":0,"truncated":false},{"path":"tools/pre_commit/test_tethering_allowlist.txt","lines":["@@ -111,6 +111,7 @@ tests/parser/engine/test_ling3.py  # CI jobs disabled pending locked cmake insta"," tests/parser/engine/test_minicpmv_reasoning.py  # CI jobs disabled pending locked cmake installation"," tests/parser/engine/test_minimax_m2.py  # CI jobs disabled pending locked cmake installation"," tests/parser/engine/test_minimax_m3.py  # CI jobs disabled pending locked cmake installation","+tests/parser/engine/test_muse.py  # CI jobs disabled pending locked cmake installation"," tests/parser/engine/test_nemotron_v3.py  # CI jobs disabled pending locked cmake installation"," tests/parser/engine/test_parser_engine.py  # CI jobs disabled pending locked cmake installation"," tests/parser/engine/test_plamo3.py  # CI jobs disabled pending locked cmake installation"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/parser/engine/parser_engine.py","lines":["@@ -143,6 +143,8 @@ class ParserEngine(Parser):","     complete output format for a model (reasoning + tool calls).","     \"\"\""," ","+    _streaming_engine_cls: type[StreamingParserEngine] = StreamingParserEngine","+","     def __init__(","         self,","         tokenizer: TokenizerLike,","@@ -164,7 +166,7 @@ def __init__(","         self._reasoning_parser = None","         self._tool_parser = None","         self.parser_engine_config = parser_engine_config","-        self._engine = StreamingParserEngine(","+        self._engine = self._streaming_engine_cls(","             parser_engine_config, tokenizer, vocab=self.vocab","         )"," "],"additions":3,"deletions":1,"truncated":false},{"path":"vllm/parser/engine/registered_adapters.py","lines":["@@ -23,6 +23,7 @@"," from vllm.parser.minimax_m2 import MinimaxM2Parser"," from vllm.parser.minimax_m3 import MinimaxM3Parser"," from vllm.parser.mistral import MistralParser","+from vllm.parser.muse import MuseParser"," from vllm.parser.nemotron_v3 import NemotronV3Parser"," from vllm.parser.plamo3 import Plamo3Parser"," from vllm.parser.qwen3 import Qwen3Parser","@@ -140,3 +141,8 @@","     RippleParserReasoningAdapter,","     RippleParserToolAdapter,"," ) = make_adapters(RippleParser)","+","+(","+    MuseParserReasoningAdapter,","+    MuseParserToolAdapter,","+) = make_adapters(MuseParser)"],"additions":6,"deletions":0,"truncated":false},{"path":"vllm/parser/muse.py","lines":["@@ -0,0 +1,353 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Muse Spark parser: recipient-routed messages parsed by one state machine.","+","+Muse Spark writes an assistant turn as a sequence of messages::","+","+    to=self<|message|>...reasoning...<|eom|><|start|>assistant","+    to=get_weather<|message|><atem:function_calls>","+    <atem:invoke name=\"get_weather\">","+    <atem:parameter name=\"city\">Paris</atem:parameter>","+    </atem:invoke>","+    </atem:function_calls><|eom|><|start|>assistant","+    to=user<|message|>...final answer...<|eot|>","+","+The recipient before `<|message|>` routes each body: `self` or none is","+reasoning, `user` and `commentary` are content, `developer` is dropped, and","+any other recipient is a tool. The model may write `to=NAME<|message|>` right","+after a body without `<|eom|>`, so a trailing `to=NAME` in a body is held back.","+\"\"\"","+","+from __future__ import annotations","+","+import functools","+import json","+from collections.abc import Iterable, Sequence","+from typing import TYPE_CHECKING","+","+import regex as re","+","+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionToolsParam","+from vllm.parser.engine.events import EventType, SemanticEvent","+from vllm.parser.engine.parser_engine import ParserEngine","+from vllm.parser.engine.parser_engine_config import (","+    ParserEngineConfig,","+    ParserState,","+    Transition,","+)","+from vllm.parser.engine.streaming_parser_engine import StreamingParserEngine","+from vllm.tool_parsers.schema_types import ParameterTypesCache, convert_value","+from vllm.tool_parsers.utils import find_tool_name, get_function_tools","+from vllm.v1.token_buffer import rfind_tokens","+","+if TYPE_CHECKING:","+    from vllm.tokenizers import TokenizerLike","+    from vllm.tool_parsers.abstract_tool_parser import Tool","+","+START = \"<|start|>\"","+MESSAGE = \"<|message|>\"","+EOM = \"<|eom|>\"","+EOT = \"<|eot|>\"","+","+_RECIPIENT_RE = re.compile(r\"to=([A-Za-z0-9_.\\-]+)\\s*$\")","+_HEADER_TAIL_RE = re.compile(r\"(?:t|to|to=[A-Za-z0-9_.\\-]{0,256})$\")","+_INVOKE_RE = re.compile(","+    r'<atem:invoke\\b[^<>]*?\\bname=\"([^\"]+)\"[^<>]*>(.*?)</atem:invoke>', re.DOTALL","+)","+_PARAMETER_RE = re.compile(","+    r'<atem:parameter\\b[^<>]*?\\bname=\"([^\"]+)\"[^<>]*?>(.*?)</atem:parameter>',","+    re.DOTALL,","+)","+_INVOKE_END = \"</atem:invoke>\"","+_BODY_STATES = frozenset({ParserState.CONTENT, ParserState.REASONING})","+_MAX_HEADER_TOKENS = 64","+","+","+def _route_header(header: str) -> tuple[str, str | None]:","+    match = _RECIPIENT_RE.search(header)","+    recipient = match.group(1) if match else None","+    if recipient in (None, \"self\"):","+        return \"REASONING_HEADER\", recipient","+    if recipient in (\"user\", \"commentary\"):","+        return \"CONTENT_HEADER\", recipient","+    if recipient == \"developer\":","+        return \"DROPPED_HEADER\", recipient","+    return \"TOOL_HEADER\", recipient","+","+","+def _decode_value(raw: str) -> object:","+    try:","+        return json.loads(raw)","+    except ValueError:","+        return raw","+","+","+@functools.cache","+def muse_config() -> ParserEngineConfig:","+    routes = {","+        \"REASONING_HEADER\": Transition(ParserState.REASONING),","+        \"CONTENT_HEADER\": Transition(ParserState.CONTENT),","+        # The dropped body is buffered as header text and discarded with it.","+        \"DROPPED_HEADER\": Transition(ParserState.MESSAGE_HEADER),","+        \"TOOL_HEADER\": Transition(","+            ParserState.TOOL_PREAMBLE, (EventType.REASONING_END,)","+        ),","+        \"START\": Transition(ParserState.MESSAGE_HEADER),","+        # Content keeps the bodies after a tool message when the tool pass","+        # re-parses the reasoning pass's content.","+        \"EOM\": Transition(ParserState.CONTENT),","+        \"EOT\": Transition(ParserState.CONTENT),","+    }","+    markers = {\"START\": START, \"MSG\": MESSAGE, \"EOM\": EOM, \"EOT\": EOT}","+    return ParserEngineConfig(","+        name=\"muse\",","+        terminals=markers,","+        token_id_terminals=markers,","+        transitions={","+            (state, terminal): transition","+            for state in (","+                ParserState.MESSAGE_HEADER,","+                ParserState.REASONING,","+                ParserState.CONTENT,","+                ParserState.TOOL_PREAMBLE,","+            )","+            for terminal, transition in routes.items()","+        },","+        initial_state=ParserState.MESSAGE_HEADER,","+        stream_arg_deltas=False,","+        tool_args_json=False,","+        strip_trailing_reasoning_whitespace=False,","+    )","+","+","+class MuseStreamingParserEngine(StreamingParserEngine):","+    def reset(self, initial_state: ParserState | None = None) -> None:","+        super().reset(initial_state)","+        self._header_tail = \"\"","+        self._header_tail_token_count = 0","+        self._tool_body = \"\"","+        self._tool_body_pos = 0","+        self._routed_header = False","+","+    def finish(self) -> list[SemanticEvent]:","+        events = self._process_scanner_items(self._scanner.flush_pending())","+        events.extend(self._process_lex_tokens(self._lexer.flush()))","+        events.extend(self._flush_header_tail())","+        events.extend(self._flush_unframed_text())","+        self._message_header_buffer = \"\"","+        self._message_header_token_count = 0","+        self._tool_body = \"\"","+        self._tool_body_pos = 0","+        self._record_reasoning_tokens(events)","+        return events","+","+    def _on_terminal(","+        self, terminal: str, value: str, token_count: int = 0","+    ) -> list[SemanticEvent]:","+        events: list[SemanticEvent] = []","+        if terminal == \"MSG\":","+            self._routed_header = True","+            terminal, recipient = _route_header(self._take_header(events))","+            # The tool pass routes the forwarded header again.","+            if recipient is not None:","+                value = f\"to={recipient}{value}\"","+        else:","+            events.extend(self._flush_unframed_text())","+        events.extend(self._flush_header_tail())","+        if (","+            self.state is ParserState.TOOL_PREAMBLE","+            and (ParserState.TOOL_PREAMBLE, terminal) in self.config.transitions","+        ):","+            self._tool_body = \"\"","+            self._tool_body_pos = 0","+        events.extend(super()._on_terminal(terminal, value, token_count))","+        return events","+","+    def _emit_for_state(self, text: str, token_count: int = 0) -> list[SemanticEvent]:","+        if self.state is ParserState.TOOL_PREAMBLE:","+            return self._feed_tool_body(text)","+        if self.state not in _BODY_STATES:","+            return super()._emit_for_state(text, token_count)","+        text = self._header_tail + text","+        token