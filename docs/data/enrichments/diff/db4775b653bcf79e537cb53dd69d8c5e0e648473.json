 since IAM auth supplies","+// a rotating token instead.","+func BuildAWSPostgresDSN(cfg *Configuration, isReadOnly bool) (string, error) {","+\tconnString := GetConnectionString(cfg, isReadOnly)","+\tc, err := pgx.ParseConfig(connString)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\tif c.Password != \"\" {","+\t\treturn \"\", errors.New(\"invalid postgres configuration: password should not be set when using IAM authentication\")","+\t}","+","+\tawsrdsConfig := &awsrds.Config{","+\t\tRegion:          cfg.DBTypeConfig.AWSPostgres.Region,","+\t\tAccessKeyID:     cfg.DBTypeConfig.AWSPostgres.AccessKeyID,","+\t\tSecretAccessKey: cfg.DBTypeConfig.AWSPostgres.SecretAccessKey,","+\t\tEndpoint:        fmt.Sprintf(\"%s:%d\", c.Host, c.Port),","+\t\tDbUser:          c.User,","+\t\tDriverName:      awsrds.PostgresDriverName,","+\t\tConnString:      connString,","+\t}","+\treturn awsrdsConfig.FormatDSN()","+}","+","+// BuildAWSMySQLDSN builds the AWS RDS / IAM DSN for a MySQL connection.","+// It rejects a connection string carrying a password, since IAM auth","+// supplies a rotating token instead.","+func BuildAWSMySQLDSN(cfg *Configuration, mysqlConfig *mysql.Config) (string, error) {","+\tif mysqlConfig.Passwd != \"\" {","+\t\treturn \"\", errors.New(\"invalid mysql configuration: password should not be set when using IAM authentication\")","+\t}","+","+\tawsrdsConfig := &awsrds.Config{","+\t\tRegion:          cfg.DBTypeConfig.AWSMySQL.Region,","+\t\tAccessKeyID:     cfg.DBTypeConfig.AWSMySQL.AccessKeyID,","+\t\tSecretAccessKey: cfg.DBTypeConfig.AWSMySQL.SecretAccessKey,","+\t\tEndpoint:        mysqlConfig.Addr,","+\t\tDbUser:          mysqlConfig.User,","+\t\tDriverName:      awsrds.MySQLDriverName,","+\t\tConnString:      mysqlConfig.FormatDSN(),","+\t}","+\treturn awsrdsConfig.FormatDSN()","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/awsdsn_test.go","lines":["@@ -0,0 +1,86 @@","+package sqlcommon","+","+import (","+\t\"path/filepath\"","+\t\"testing\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestBuildAWSPostgresDSNNoPassword(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\tdsn, err := BuildAWSPostgresDSN(awsPostgresConfig(","+\t\t\"postgres://dbuser@my-instance.rds.amazonaws.com:5432/spire\"), false)","+\trequire.NoError(t, err)","+\trequire.Contains(t, dsn, \"my-instance.rds.amazonaws.com:5432\")","+}","+","+func TestBuildAWSPostgresDSNUsesReadOnlyConnectionString(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\tcfg := awsPostgresConfig(\"postgres://dbuser@rw-host:5432/spire\")","+\tcfg.RoConnectionString = \"postgres://dbuser@ro-host:5432/spire\"","+","+\tdsn, err := BuildAWSPostgresDSN(cfg, true)","+\trequire.NoError(t, err)","+\trequire.Contains(t, dsn, \"ro-host:5432\")","+\trequire.NotContains(t, dsn, \"rw-host\")","+}","+","+func TestBuildAWSPostgresDSNRejectsPassword(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\tfor _, connString := range []string{","+\t\t\"postgres://dbuser:secret@host:5432/spire\",","+\t\t\"postgres://dbuser@host:5432/spire?password=secret\",","+\t\t\"host=host port=5432 user=dbuser password=secret dbname=spire\",","+\t\t\"host=host port=5432 user=dbuser password = secret dbname=spire\",","+\t} {","+\t\t_, err := BuildAWSPostgresDSN(awsPostgresConfig(connString), false)","+\t\trequire.ErrorContains(t, err, \"password should not be set when using IAM authentication\",","+\t\t\t\"connString=%q\", connString)","+\t}","+}","+","+func TestBuildAWSPostgresDSNAllowsEmptyPassword(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\t_, err := BuildAWSPostgresDSN(awsPostgresConfig(","+\t\t\"postgres://dbuser:@my-instance.rds.amazonaws.com:5432/spire\"), false)","+\trequire.NoError(t, err)","+}","+","+func TestBuildAWSMySQLDSN(t *testing.T) {","+\tcfg := &Configuration{","+\t\tDBTypeConfig: &DBTypeConfig{","+\t\t\tDatabaseType: AWSMySQL,","+\t\t\tAWSMySQL:     &AWSConfig{Region: \"us-west-2\", AccessKeyID: \"AKID\", SecretAccessKey: \"SECRET\"},","+\t\t},","+\t}","+","+\tdsn, err := BuildAWSMySQLDSN(cfg, &mysql.Config{User: \"dbuser\", Net: \"tcp\", Addr: \"my-instance.rds.amazonaws.com:3306\", DBName: \"spire\"})","+\trequire.NoError(t, err)","+\trequire.Contains(t, dsn, \"my-instance.rds.amazonaws.com:3306\")","+","+\t_, err = BuildAWSMySQLDSN(cfg, &mysql.Config{User: \"dbuser\", Passwd: \"secret\", Net: \"tcp\", Addr: \"host:3306\"})","+\trequire.ErrorContains(t, err, \"password should not be set when using IAM authentication\")","+}","+","+func awsPostgresConfig(connString string) *Configuration {","+\treturn &Configuration{","+\t\tConnectionString: connString,","+\t\tDBTypeConfig: &DBTypeConfig{","+\t\t\tDatabaseType: AWSPostgreSQL,","+\t\t\tAWSPostgres:  &AWSConfig{Region: \"us-west-2\", AccessKeyID: \"AKID\", SecretAccessKey: \"SECRET\"},","+\t\t},","+\t}","+}","+","+// isolatePostgresEnv keeps the developer's libpq environment out of the test:","+// pgx.ParseConfig falls back to PGPASSWORD and the passfile for a password.","+func isolatePostgresEnv(t *testing.T) {","+\tt.Setenv(\"PGPASSWORD\", \"\")","+\tt.Setenv(\"PGPASSFILE\", filepath.Join(t.TempDir(), \"nonexistent\"))","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/azuredsn.go","lines":["@@ -0,0 +1,58 @@","+package sqlcommon","+","+import (","+\t\"errors\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/jackc/pgx/v5\"","+\t\"github.com/spiffe/spire/pkg/server/datastore/sqldriver/azurerds\"","+)","+","+// BuildAzurePostgresDSN builds the Microsoft Entra ID DSN for an Azure","+// PostgreSQL connection. It rejects a connection string carrying a password,","+// since Entra ID auth supplies a rotating access token instead.","+func BuildAzurePostgresDSN(cfg *Configuration, isReadOnly bool) (string, error) {","+\tconnString := GetConnectionString(cfg, isReadOnly)","+\tc, err := pgx.ParseConfig(connString)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\tif c.Password != \"\" {","+\t\treturn \"\", errors.New(\"invalid postgres configuration: password should not be set when using Microsoft Entra ID authentication\")","+\t}","+","+\treturn buildAzureDSN(cfg.DBTypeConfig.AzurePostgres, azurerds.PostgresDriverName, connString)","+}","+","+// BuildAzureMySQLDSN builds the Microsoft Entra ID DSN for an Azure MySQL","+// connection. It rejects a connection string carrying a password, since","+// Entra ID auth supplies a rotating access token instead.","+func BuildAzureMySQLDSN(cfg *Configuration, mysqlConfig *mysql.Config) (string, error) {","+\tif mysqlConfig.Passwd != \"\" {","+\t\treturn \"\", errors.New(\"invalid mysql configuration: password should not be set when using Microsoft Entra ID authentication\")","+\t}","+","+\treturn buildAzureDSN(cfg.DBTypeConfig.AzureMySQL, azurerds.MySQLDriverName, mysqlConfig.FormatDSN())","+}","+","+func buildAzureDSN(azureConfig *AzureConfig, driverName, connString string) (string, error) {","+\tresolved, err := azureConfig.Resolve()","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+","+\tazurerdsConfig := &azurerds.Config{","+\t\tAuthType:                  resolved.AuthType,","+\t\tTenantID:                  resolved.TenantID,","+\t\tClientID:                  resolved.ClientID,","+\t\tClientSecret:              resolved.ClientSecret,","+\t\tClientCertificatePath:     resolved.ClientCertificatePath,","+\t\tClientCertificatePassword: resolved.ClientCertificatePassword,","+\t\tSendCertificateChain:      resolved.SendCertificateChain,","+\t\tFederatedTokenFile:        resolved.FederatedTokenFile,","+\t\tManagedIdentityResourceID: resolved.ManagedIdentityResourceID,","+\t\tDriverName:                driverName,","+\t\tConnString:                connString,","+\t}","+\treturn azurerdsConfig.FormatDSN()","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/azuredsn_test.go","lines":["@@ -0,0 +1,66 @@","+package sqlcommon","+","+import (","+\t\"testing\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestBuildAzurePostgresDSN(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\tcfg := azurePostgresConfig(\"postgres://dbuser@rw-host:5432/spire\")","+\tcfg.RoConnectionString = \"postgres://dbuser@ro-host:5432/spire\"","+","+\tdsn, err := BuildAzurePostgresDSN(cfg, false)","+\trequire.NoError(t, err)","+\trequire.Contains(t, dsn, \"rw-host\")","+\trequire.Contains(t, dsn, `\"auth_type\":\"system_managed_identity\"`)","+","+\tdsn, err = BuildAzurePostgresDSN(cfg, true)","+\trequire.NoError(t, err)","+\trequire.Contains(t, dsn, \"ro-host\")","+}","+","+func TestBuildAzurePostgresDSNRejectsPassword(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\t_, err := BuildAzurePostgresDSN(azurePostgresConfig(\"postgres://dbuser:secret@host:5432/spire\"), false)","+\trequire.ErrorContains(t, err, \"password should not be set when using Microsoft Entra ID authentication\")","+}","+","+func TestBuildAzurePostgresDSNResolveError(t *testing.T) {","+\tisolatePostgresEnv(t)","+","+\tcfg := azurePostgresConfig(\"postgres://dbuser@host:5432/spire\")","+\tcfg.DBTypeConfig.AzurePostgres.AuthType = \"unknown\"","+\t_, err := BuildAzurePostgresDSN(cfg, false)","+\trequire.Error(t, err)","+}","+","+func TestBuildAzureMySQLDSN(t *testing.T) {","+\tcfg := &Configuration{","+\t\tDBTypeConfig: &DBTypeConfig{","+\t\t\tDatabaseType: AzureMySQL,","+\t\t\tAzureMySQL:   &AzureConfig{AuthType: AzureAuthTypeSystemManagedIdentity},","+\t\t},","+\t}","+","+\tdsn, err := BuildAzureMySQLDSN(cfg, &mysql.Config{User: \"dbuser\", Net: \"tcp\", Addr: \"host:3306\", DBName: \"spire\"})","+\trequire.NoError(t, err)","+\trequire.Contains(t, dsn, \"host:3306\")","+","+\t_, err = BuildAzureMySQLDSN(cfg, &mysql.Config{User: \"dbuser\", Passwd: \"secret\", Net: \"tcp\", Addr: \"host:3306\"})","+\trequire.ErrorContains(t, err, \"password should not be set when using Microsoft Entra ID authentication\")","+}","+","+func azurePostgresConfig(connString string) *Configuration {","+\treturn &Configuration{","+\t\tConnectionString: connString,","+\t\tDBTypeConfig: &DBTypeConfig{","+\t\t\tDatabaseType:  AzurePostgreSQL,","+\t\t\tAzurePostgres: &AzureConfig{AuthType: AzureAuthTypeSystemManagedIdentity},","+\t\t},","+\t}","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/configparse.go","lines":["@@ -0,0 +1,172 @@","+package sqlcommon","+","+import (","+\t\"bytes\"","+\t\"errors\"","+\t\"fmt\"","+\t\"strings\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/hashicorp/hcl\"","+\t\"github.com/hashicorp/hcl/hcl/ast\"","+\t\"github.com/hashicorp/hcl/hcl/printer\"","+)","+","+const (","+\t// MySQL database type","+\tMySQL = \"mysql\"","+\t// PostgreSQL database type","+\tPostgreSQL = \"postgres\"","+\t// SQLite database type","+\tSQLite = \"sqlite3\"","+\t// AWSMySQL is a MySQL database provided by an AWS service","+\tAWSMySQL = \"aws_mysql\"","+\t// AWSPostgreSQL is a PostgreSQL database provided by an AWS service","+\tAWSPostgreSQL = \"aws_postgres\"","+\t// AzurePostgreSQL is a PostgreSQL database provided by an Azure service,","+\t// authenticated using Microsoft Entra ID (Azure AD)","+\tAzurePostgreSQL = \"azure_postgres\"","+\t// AzureMySQL is a MySQL database provided by an Azure service,","+\t// authenticated using Microsoft Entra ID (Azure AD)","+\tAzureMySQL = \"azure_mysql\"","+)","+","+// IsMySQLDbType reports whether dbType is a MySQL-family database type.","+func IsMySQLDbType(dbType string) bool {","+\treturn dbType == MySQL || dbType == AWSMySQL || dbType == AzureMySQL","+}","+","+// IsPostgresDbType reports whether dbType is a PostgreSQL-family database type.","+func IsPostgresDbType(dbType string) bool {","+\treturn dbType == PostgreSQL || dbType == AWSPostgreSQL || dbType == AzurePostgreSQL","+}","+","+// IsSQLiteDbType reports whether dbType is the SQLite database type.","+func IsSQLiteDbType(dbType string) bool {","+\treturn dbType == SQLite","+}","+","+// BuildConfig decodes the HCL datastore configuration and resolves the","+// database_type node into a DBTypeConfig.","+func BuildConfig(hclConfiguration string) (*Configuration, error) {","+\tconfig := &Configuration{}","+\tif err := hcl.Decode(config, hclConfiguration); err != nil {","+\t\treturn nil, err","+\t}","+","+\tdbTypeConfig, err := ParseDatabaseTypeASTNode(config.DatabaseTypeNode)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\tconfig.DBTypeConfig = dbTypeConfig","+\treturn config, nil","+}","+","+// ParseDatabaseTypeASTNode resolves the database_type HCL node, which may be","+// either a bare string (\"sqlite3\") or an object block (aws_mysql, aws_postgres, azure_mysql, azure_postgres).","+func ParseDatabaseTypeASTNode(node ast.Node) (*DBTypeConfig, error) {","+\tlt, ok := node.(*ast.LiteralType)","+\tif ok {","+\t\treturn &DBTypeConfig{DatabaseType: strings.Trim(lt.Token.Text, \"\\\"\")}, nil","+\t}","+","+\tobjectList, ok := node.(*ast.ObjectList)","+\tif !ok {","+\t\treturn nil, errors.New(\"malformed database type configuration\")","+\t}","+","+\tif len(objectList.Items) != 1 {","+\t\treturn nil, errors.New(\"exactly one database type is expected\")","+\t}","+","+\tif len(objectList.Items[0].Keys) != 1 {","+\t\treturn nil, errors.New(\"exactly one key is expected\")","+\t}","+","+\tvar data bytes.Buffer","+\tif err := printer.DefaultConfig.Fprint(&data, node); err != nil {","+\t\treturn nil, err","+\t}","+","+\tdbTypeConfig := new(DBTypeConfig)","+\tif err := hcl.Decode(dbTypeConfig, data.String()); err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to decode configuration: %w\", err)","+\t}","+","+\tdatabaseType := strings.Trim(objectList.Items[0].Keys[0].Token.Text, \"\\\"\")","+\tswitch databaseType {","+\tcase AWSMySQL:","+\tcase AWSPostgreSQL:","+\tcase AzurePostgreSQL:","+\tcase AzureMySQL:","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"unknown database type: %s\", databaseType)","+\t}","+","+\tdbTypeConfig.DatabaseType = databaseType","+\treturn dbTypeConfig, nil","+}","+","+// ConfigValidate performs static validation of a decoded datastore config.","+func ConfigValidate(cfg *Configuration) error {","+\tif cfg.DBTypeConfig.DatabaseType == \"\" {","+\t\treturn NewSQLError(\"database_type must be set\")","+\t}","+","+\tif cfg.ConnectionString == \"\" {","+\t\treturn NewSQLError(\"connection_string must be set\")","+\t}","+","+\tif IsMySQLDbType(cfg.DBTypeConfig.DatabaseType) {","+\t\tif err := ValidateMySQLConfig(cfg, false); err != nil {","+\t\t\treturn err","+\t\t}","+","+\t\tif cfg.RoConnectionString != \"\" {","+\t\t\tif err := ValidateMySQLConfig(cfg, true); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+\t}","+","+\tif cfg.DBTypeConfig.AWSMySQL != nil {","+\t\tif err := cfg.DBTypeConfig.AWSMySQL.Validate(); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\tif cfg.DBTypeConfig.AWSPostgres != nil {","+\t\tif err := cfg.DBTypeConfig.AWSPostgres.Validate(); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\tif cfg.DBTypeConfig.AzurePostgres != nil {","+\t\tif err := cfg.DBTypeConfig.AzurePostgres.Validate(); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\tif cfg.DBTypeConfig.AzureMySQL != nil {","+\t\tif err := cfg.DBTypeConfig.AzureMySQL.Validate(); err != nil {","+\t\t\treturn err","+\t\t}","+\t}","+","+\treturn nil","+}","+","+// ValidateMySQLConfig ensures the MySQL connection string requests parseTime.","+func ValidateMySQLConfig(cfg *Configuration, isReadOnly bool) error {","+\topts, err := mysql.ParseDSN(GetConnectionString(cfg, isReadOnly))","+\tif err != nil {","+\t\treturn NewWrappedSQLError(err)","+\t}","+","+\tif !opts.ParseTime {","+\t\treturn NewSQLError(\"invalid mysql config: missing parseTime=true param in connection_string\")","+\t}","+","+\treturn nil","+}"],"additions":172,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/configparse_test.go","lines":["@@ -0,0 +1,80 @@","+package sqlcommon","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestBuildConfigSQLite(t *testing.T) {","+\tcfg, err := BuildConfig(`","+\t\tdatabase_type = \"sqlite3\"","+\t\tconnection_string = \"file:test.db\"","+\t`)","+\trequire.NoError(t, err)","+\trequire.Equal(t, SQLite, cfg.DBTypeConfig.DatabaseType)","+\trequire.Equal(t, \"file:test.db\", cfg.ConnectionString)","+\trequire.NoError(t, ConfigValidate(cfg))","+}","+","+func TestBuildConfigAWSPostgres(t *testing.T) {","+\tcfg, err := BuildConfig(`","+\t\tdatabase_type \"aws_postgres\" {","+\t\t\tregion = \"us-west-2\"","+\t\t\taccess_key_id = \"AKID\"","+\t\t\tsecret_access_key = \"SECRET\"","+\t\t}","+\t\tconnection_string = \"postgres://host:5432/db\"","+\t`)","+\trequire.NoError(t, err)","+\trequire.Equal(t, AWSPostgreSQL, cfg.DBTypeConfig.DatabaseType)","+\trequire.NotNil(t, cfg.DBTypeConfig.AWSPostgres)","+\trequire.Equal(t, \"us-west-2\", cfg.DBTypeConfig.AWSPostgres.Region)","+\trequire.NoError(t, ConfigValidate(cfg))","+}","+","+func TestBuildConfigAzure(t *testing.T) {","+\tfor _, databaseType := range []string{AzurePostgreSQL, AzureMySQL} {","+\t\tt.Run(databaseType, func(t *testing.T) {","+\t\t\tcfg, err := BuildConfig(`","+\t\t\t\tdatabase_type \"` + databaseType + `\" {","+\t\t\t\t\tauth_type = \"system_managed_identity\"","+\t\t\t\t}","+\t\t\t\tconnection_string = \"user@tcp(host:3306)/db?parseTime=true\"","+\t\t\t`)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, databaseType, cfg.DBTypeConfig.DatabaseType)","+\t\t\trequire.NoError(t, ConfigValidate(cfg))","+\t\t})","+\t}","+}","+","+func TestConfigValidateAzureAuthType(t *testing.T) {","+\tcfg, err := BuildConfig(`","+\t\tdatabase_type \"azure_postgres\" {","+\t\t\tauth_type = \"unknown\"","+\t\t}","+\t\tconnection_string = \"postgres://host:5432/db\"","+\t`)","+\trequire.NoError(t, err)","+\trequire.Error(t, ConfigValidate(cfg))","+}","+","+func TestConfigValidateErrors(t *testing.T) {","+\t// database_type unset","+\terr := ConfigValidate(&Configuration{DBTypeConfig: &DBTypeConfig{}})","+\trequire.EqualError(t, err, \"datastore-sql: database_type must be set\")","+","+\t// connection_string unset","+\terr = ConfigValidate(&Configuration{DBTypeConfig: &DBTypeConfig{DatabaseType: SQLite}})","+\trequire.EqualError(t, err, \"datastore-sql: connection_string must be set\")","+}","+","+func TestValidateMySQLConfigRequiresParseTime(t *testing.T) {","+\tcfg := &Configuration{","+\t\tConnectionString: \"user:pass@tcp(localhost:3306)/db\",","+\t\tDBTypeConfig:     &DBTypeConfig{DatabaseType: MySQL},","+\t}","+\terr := ValidateMySQLConfig(cfg, false)","+\trequire.ErrorContains(t, err, \"missing parseTime=true param\")","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/constraint.go","lines":["@@ -2,16 +2,24 @@ package sqlcommon"," "," import ("," \t\"errors\"","+\t\"strings\""," "," \t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/jackc/pgx/v5/pgconn\""," \t\"github.com/lib/pq\""," )"," ","+// IsPostgresConstraintViolation reports whether err is a PostgreSQL","+// constraint violation (SQLSTATE class 23). It matches errors from both","+// lib/pq and pgx, since connections may be opened through either driver."," func IsPostgresConstraintViolation(err error) bool {","-\tvar e *pq.Error","-\tok := errors.As(err, &e)","-\t// \"23xxx\" is the constraint violation class for PostgreSQL","-\treturn ok && e.Code.Class() == \"23\"","+\tif pqErr, ok := errors.AsType[*pq.Error](err); ok {","+\t\treturn pqErr.Code.Class() == \"23\"","+\t}","+\tif pgErr, ok := errors.AsType[*pgconn.PgError](err); ok {","+\t\treturn strings.HasPrefix(pgErr.Code, \"23\")","+\t}","+\treturn false"," }"," "," func IsMySQLConstraintViolation(err error) bool {"],"additions":12,"deletions":4,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/constraint_test.go","lines":["@@ -0,0 +1,38 @@","+package sqlcommon","+","+import (","+\t\"errors\"","+\t\"fmt\"","+\t\"testing\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/jackc/pgx/v5/pgconn\"","+\t\"github.com/lib/pq\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestIsPostgresConstraintViolation(t *testing.T) {","+\tfor _, tt := range []struct {","+\t\tname     string","+\t\terr      error","+\t\texpected bool","+\t}{","+\t\t{name: \"pq unique violation\", err: &pq.Error{Code: \"23505\"}, expected: true},","+\t\t{name: \"pq other class\", err: &pq.Error{Code: \"42P01\"}},","+\t\t{name: \"pgx unique violation\", err: &pgconn.PgError{Code: \"23505\"}, expected: true},","+\t\t{name: \"pgx foreign key violation\", err: &pgconn.PgError{Code: \"23503\"}, expected: true},","+\t\t{name: \"pgx other class\", err: &pgconn.PgError{Code: \"42P01\"}},","+\t\t{name: \"wrapped pgx unique violation\", err: fmt.Errorf(\"insert: %w\", &pgconn.PgError{Code: \"23505\"}), expected: true},","+\t\t{name: \"unrelated error\", err: errors.New(\"oops\")},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\trequire.Equal(t, tt.expected, IsPostgresConstraintViolation(tt.err))","+\t\t})","+\t}","+}","+","+func TestIsMySQLConstraintViolation(t *testing.T) {","+\trequire.True(t, IsMySQLConstraintViolation(&mysql.MySQLError{Number: 1062}))","+\trequire.False(t, IsMySQLConstraintViolation(&mysql.MySQLError{Number: 1064}))","+\trequire.False(t, IsMySQLConstraintViolation(errors.New(\"oops\")))","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/mysql.go","lines":["@@ -0,0 +1,76 @@","+package sqlcommon","+","+import (","+\t\"crypto/tls\"","+\t\"crypto/x509\"","+\t\"errors\"","+\t\"fmt\"","+\t\"os\"","+","+\t\"github.com/go-sql-driver/mysql\"","+)","+","+// TLSConfigName is the key under which the custom MySQL TLS config is","+// registered with the go-sql-driver/mysql driver.","+const TLSConfigName = \"spireCustomTLS\"","+","+// HasTLSConfig reports whether the configuration requests custom TLS material","+// (a custom Root CA and/or a client certificate/key pair).","+func HasTLSConfig(cfg *Configuration) bool {","+\treturn len(cfg.RootCAPath) > 0 || len(cfg.ClientCertPath) > 0 && len(cfg.ClientKeyPath) > 0","+}","+","+// ConfigureMySQLConnection parses the connection string into a *mysql.Config","+// and, when custom TLS material is configured (root_ca_path / client_cert_path","+// / client_key_path), builds and registers a custom tls.Config with the","+// go-sql-driver/mysql driver and points the returned config at it. The","+// connection string must already have been validated by ValidateMySQLConfig.","+func ConfigureMySQLConnection(cfg *Configuration, isReadOnly bool) (*mysql.Config, error) {","+\tconnectionString := GetConnectionString(cfg, isReadOnly)","+\tmysqlConfig, err := mysql.ParseDSN(connectionString)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\tif !HasTLSConfig(cfg) {","+\t\t// connection string doesn't have to be modified","+\t\treturn mysqlConfig, nil","+\t}","+","+\tvar tlsConf tls.Config","+","+\t// load and configure Root CA if it exists","+\tif len(cfg.RootCAPath) > 0 {","+\t\trootCertPool := x509.NewCertPool()","+\t\tpem, err := os.ReadFile(cfg.RootCAPath)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"invalid mysql config: cannot find Root CA defined in root_ca_path: %w\", err)","+\t\t}","+","+\t\tif ok := rootCertPool.AppendCertsFromPEM(pem); !ok {","+\t\t\treturn nil, errors.New(\"invalid mysql config: failed to parse Root CA defined in root_ca_path\")","+\t\t}","+\t\ttlsConf.RootCAs = rootCertPool","+\t}","+","+\t// load and configure client certificate if it exists","+\tif len(cfg.ClientCertPath) > 0 && len(cfg.ClientKeyPath) > 0 {","+\t\tclientCert := make([]tls.Certificate, 0, 1)","+\t\tcerts, err := tls.LoadX509KeyPair(cfg.ClientCertPath, cfg.ClientKeyPath)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"invalid mysql config: failed to load client certificate defined in client_cert_path and client_key_path: %w\", err)","+\t\t}","+\t\tclientCert = append(clientCert, certs)","+\t\ttlsConf.Certificates = clientCert","+\t}","+","+\t// register a custom TLS config that uses custom Root CAs with the MySQL driver","+\tif err := mysql.RegisterTLSConfig(TLSConfigName, &tlsConf); err != nil {","+\t\treturn nil, fmt.Errorf(\"failed to register mysql TLS config: %w\", err)","+\t}","+","+\t// instruct MySQL driver to use the custom TLS config","+\tmysqlConfig.TLSConfig = TLSConfigName","+","+\treturn mysqlConfig, nil","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlcommon/mysql_test.go","lines":["@@ -0,0 +1,90 @@","+package sqlcommon","+","+import (","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/rand\"","+\t\"crypto/x509\"","+\t\"crypto/x509/pkix\"","+\t\"encoding/pem\"","+\t\"math/big\"","+\t\"os\"","+\t\"path/filepath\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/go-sql-driver/mysql\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestHasTLSConfig(t *testing.T) {","+\trequire.False(t, HasTLSConfig(&Configuration{}))","+\trequire.True(t, HasTLSConfig(&Configuration{RootCAPath: \"/ca.pem\"}))","+\trequire.True(t, HasTLSConfig(&Configuration{","+\t\tClientCertPath: \"/cert.pem\",","+\t\tClientKeyPath:  \"/key.pem\",","+\t}))","+\t// a client cert without its key does not count","+\trequire.False(t, HasTLSConfig(&Configuration{ClientCertPath: \"/cert.pem\"}))","+}","+","+func TestConfigureMySQLConnectionNoTLS(t *testing.T) {","+\tcfg := &Configuration{","+\t\tConnectionString: \"user:pass@tcp(localhost:3306)/spire?parseTime=true\",","+\t\tDBTypeConfig:     &DBTypeConfig{DatabaseType: MySQL},","+\t}","+\tmysqlConfig, err := ConfigureMySQLConnection(cfg, false)","+\trequire.NoError(t, err)","+\t// with no custom TLS material configured, the driver TLS config is untouched","+\trequire.Empty(t, mysqlConfig.TLSConfig)","+}","+","+func TestConfigureMySQLConnectionRegistersTLS(t *testing.T) {","+\t// generate a throwaway CA PEM so RootCAPath parses.","+\tcaPath := writeTestRootCA(t)","+","+\tcfg := &Configuration{","+\t\tConnectionString: \"user:pass@tcp(localhost:3306)/spire?parseTime=true\",","+\t\tRootCAPath:       caPath,","+\t\tDBTypeConfig:     &DBTypeConfig{DatabaseType: MySQL},","+\t}","+\tmysqlConfig, err := ConfigureMySQLConnection(cfg, false)","+\trequire.NoError(t, err)","+","+\t// the driver config must point at the custom TLS config, and that name must","+\t// resolve to a registered tls.Config in the driver's registry.","+\trequire.Equal(t, TLSConfigName, mysqlConfig.TLSConfig)","+\t_, err = mysql.ParseDSN(mysqlConfig.FormatDSN())","+\trequire.NoError(t, err, \"formatted DSN with custom TLS must be parseable\")","+}","+","+func TestConfigureMySQLConnectionBadRootCA(t *testing.T) {","+\tcfg := &Configuration{","+\t\tConnectionString: \"user:pass@tcp(localhost:3306)/spire?parseTime=true\",","+\t\tRootCAPath:       \"/does/not/exist.pem\",","+\t\tDBTypeConfig:     &DBTypeConfig{DatabaseType: MySQL},","+\t}","+\t_, err := ConfigureMySQLConnection(cfg, false)","+\trequire.ErrorContains(t, err, \"cannot find Root CA defined in root_ca_path\")","+}","+","+func writeTestRootCA(t *testing.T) string {","+\tkey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\trequire.NoError(t, err)","+","+\ttmpl := &x509.Certificate{","+\t\tSerialNumber:          big.NewInt(1),","+\t\tSubject:               pkix.Name{CommonName: \"test-root-ca\"},","+\t\tNotBefore:             time.Now().Add(-time.Hour),","+\t\tNotAfter:              time.Now().Add(time.Hour),","+\t\tIsCA:                  true,","+\t\tBasicConstraintsValid: true,","+\t}","+\tder, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)","+\trequire.NoError(t, err)","+","+\tpath := filepath.Join(t.TempDir(), \"root-ca.pem\")","+\tpemBytes := pem.EncodeToMemory(&pem.Block{Type: \"CERTIFICATE\", Bytes: der})","+\trequire.NoError(t, os.WriteFile(path, pemBytes, 0o600))","+\treturn path","+}"],"additions":90,"deletions":0,"truncated":false},{"path":"pkg/server/datastore/sqlstore/migration.go","lines":["@@ -481,7 +481,7 @@ func tableOptionsForDialect(tx *gorm.DB, dbType string) *gorm.DB {"," \t// This allows for setting table options for a particular DB type."," \t// For MySQL, (for compatibility reasons) we want to make sure that"," \t// we can support indexes on strings (varchar(255) in the DB).","-\tif isMySQLDbType(dbType) {","+\tif sqlcommon.IsMySQLDbType(dbType) {"," \t\treturn tx.Set(\"gorm:table_options\", \"ENGINE=InnoDB  ROW_FORMAT=DYNAMIC DEFAULT CHARSET=utf8\")"," \t}"," \treturn tx"],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/server/datastore/sqlstore/mysql.go","lines":["@@ -2,10 +2,7 @@ package sqlstore"," "," import ("," \t\"context\"","-\t\"crypto/tls\"","-\t\"crypto/x509\""," \t\"errors\"","-\t\"os\""," \t\"strings\""," "," \t\"github.com/go-sql-driver/mysql\"","@@ -27,12 +24,8 @@ type mysqlDB struct {"," \tlogger logrus.FieldLogger"," }"," ","-const (","-\ttlsConfigName = \"spireCustomTLS\"","-)","-"," func (my mysqlDB) connect(ctx context.Context, cfg *sqlcommon.Configuration, isReadOnly bool) (db *gorm.DB, version string, supportsCTE bool, err error) {"],"additions":0,"deletions":7,"truncated":false}],"additions":750,"deletions":13,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-10-08T16:16:57.879224+00:00"}