{"id":"32adf0de39f5bc822d6cbac94b8398bcc2f7f344","axis":"silent","repo":"envoyproxy/envoy","sha":"32adf0de39f5bc822d6cbac94b8398bcc2f7f344","parsed":{"files":[{"path":"api/envoy/extensions/filters/http/grpc_stats/v3/config.proto","lines":["@@ -61,9 +61,12 @@ message FilterConfig {","   bool enable_upstream_stats = 4;"," ","   // If true, the filter will replace dots in the grpc_service_name with underscores before emitting","-  // the metrics. Only works when :ref:`stats_for_all_methods","+  // the metrics. Works when :ref:`stats_for_all_methods","   // <envoy_v3_api_field_extensions.filters.http.grpc_stats.v3.FilterConfig.stats_for_all_methods>`","-  // is set to true. It could cause metrics to be merged if the edited service name conflicts with","+  // is set to true or :ref:`individual_method_stats_allowlist","+  // <envoy_v3_api_field_extensions.filters.http.grpc_stats.v3.FilterConfig.individual_method_stats_allowlist>`","+  // is configured. Allowlist entries must use the original service names, including dots.","+  // It could cause metrics to be merged if the edited service name conflicts with","   // an existing service. For example there are both service \"foo.bar\" & \"foo_bar\" running.","   // This config can fix incorrect gRPC metrics with dots because the existing stats tag extractor","   // assumes no dots in the gRPC service name. By default this is set as false."],"additions":5,"deletions":2,"truncated":false},{"path":"changelogs/current/minor_behavior_changes/http__grpc-stats-allowlist-dot-replacement.rst","lines":["@@ -0,0 +1,8 @@","+The gRPC statistics filter now applies","+:ref:`replace_dots_in_grpc_service_name","+<envoy_v3_api_field_extensions.filters.http.grpc_stats.v3.FilterConfig.replace_dots_in_grpc_service_name>`","+to allowlisted methods. Previously, this option only affected statistics emitted with","+``stats_for_all_methods`` set to ``true``. When enabled with ``individual_method_stats_allowlist``,","+dots in service names are now replaced with underscores in emitted metric names. Allowlist entries","+continue to use the original service names, including dots. Dashboards and alerts that refer to the","+previous metric names need to be updated."],"additions":8,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/grpc_stats/BUILD","lines":["@@ -38,6 +38,7 @@ envoy_cc_extension(","         \"//source/common/stream_info:utility_lib\",","         \"//source/extensions/filters/http/common:factory_base_lib\",","         \"//source/extensions/filters/http/common:pass_through_filter_lib\",","+        \"@abseil-cpp//absl/strings\",","         \"@envoy_api//envoy/extensions/filters/http/grpc_stats/v3:pkg_cc_proto\",","     ],"," )"],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/grpc_stats/grpc_stats_filter.cc","lines":["@@ -14,6 +14,8 @@"," #include \"source/extensions/filters/http/common/pass_through_filter.h\""," #include \"source/extensions/filters/http/grpc_stats/response_frame_counter.h\""," ","+#include \"absl/strings/str_replace.h\"","+"," namespace Envoy {"," namespace Extensions {"," namespace HttpFilters {","@@ -29,8 +31,9 @@ class GrpcServiceMethodToRequestNamesMap {"," public:","   // Construct a map populated with the services/methods in method_list.","   GrpcServiceMethodToRequestNamesMap(Stats::SymbolTable& symbol_table,","-                                     const envoy::config::core::v3::GrpcMethodList& method_list)","-      : stat_name_pool_(symbol_table), map_(populate(method_list)) {}","+                                     const envoy::config::core::v3::GrpcMethodList& method_list,","+                                     bool replace_dots_in_service_name)","+      : stat_name_pool_(symbol_table), map_(populate(method_list, replace_dots_in_service_name)) {}"," ","   std::optional<Grpc::Context::RequestStatNames>","   lookup(const Grpc::Common::RequestNames& request_names) const {","@@ -72,10 +75,14 @@ class GrpcServiceMethodToRequestNamesMap {","   using MapType = absl::flat_hash_map<OwningKey, Grpc::Context::RequestStatNames, MapHash, MapEq>;"," ","   // Helper for generating a populated MapType so that `map_` can be const.","-  MapType populate(const envoy::config::core::v3::GrpcMethodList& method_list) {","+  MapType populate(const envoy::config::core::v3::GrpcMethodList& method_list,","+                   bool replace_dots_in_service_name) {","     MapType map;","     for (const auto& service : method_list.services()) {","-      Stats::StatName stat_name_service = stat_name_pool_.add(service.name());","+      // The map is keyed by the original service name; only the stat name has dots replaced.","+      Stats::StatName stat_name_service = stat_name_pool_.add(","+          replace_dots_in_service_name ? absl::StrReplaceAll(service.name(), {{\".\", \"_\"}})","+                                       : service.name());"," ","       for (const auto& method_name : service.method_names()) {","         Stats::StatName stat_name_method = stat_name_pool_.add(method_name);","@@ -103,7 +110,8 @@ struct Config {","         envoy::extensions::filters::http::grpc_stats::v3::FilterConfig::","             kIndividualMethodStatsAllowlist) {","       allowlist_.emplace(context.scope().symbolTable(),","-                         proto_config.individual_method_stats_allowlist());","+                         proto_config.individual_method_stats_allowlist(),","+                         replace_dots_in_grpc_service_name_);","     }","   }","   Grpc::Context& context_;"],"additions":13,"deletions":5,"truncated":false},{"path":"test/extensions/filters/http/grpc_stats/config_test.cc","lines":["@@ -394,6 +394,30 @@ TEST_F(GrpcStatsFilterConfigTest, StatsAllowlistMatch) {","                      .value());"," }"," ","+// Test that replace_dots_in_grpc_service_name is applied to allowlisted methods.","+TEST_F(GrpcStatsFilterConfigTest, StatsAllowlistMatchReplaceDotsInGrpcServiceName) {","+  auto* service = config_.mutable_individual_method_stats_allowlist()->mutable_services()->Add();","+  service->set_name(\"lyft.users.BadCompanions\");","+  *service->mutable_method_names()->Add() = \"GetBadCompanions\";","+  config_.set_replace_dots_in_grpc_service_name(true);","+  initialize();","+","+  Http::TestRequestHeaderMapImpl request_headers{","+      {\"content-type\", \"application/grpc\"},","+      {\":path\", \"/lyft.users.BadCompanions/GetBadCompanions\"}};","+","+  doRequestResponse(request_headers);","+","+  EXPECT_EQ(1UL, decoder_callbacks_.clusterInfo()","+                     ->statsScope()","+                     .counterFromString(\"grpc.lyft_users_BadCompanions.GetBadCompanions.success\")","+                     .value());","+  EXPECT_EQ(1UL, decoder_callbacks_.clusterInfo()","+                     ->statsScope()","+                     .counterFromString(\"grpc.lyft_users_BadCompanions.GetBadCompanions.total\")","+                     .value());","+}","+"," // Test that an allowlist method mismatch results in going to the generic stat."," TEST_F(GrpcStatsFilterConfigTest, StatsAllowlistMismatchMethod) {","   addAllowlistEntry();",""],"additions":24,"deletions":0,"truncated":false}],"additions":51,"deletions":7,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-24T12:59:18.628200+00:00"}