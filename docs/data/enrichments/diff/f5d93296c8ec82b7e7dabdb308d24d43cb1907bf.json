{"id":"f5d93296c8ec82b7e7dabdb308d24d43cb1907bf","axis":"silent","repo":"vllm-project/vllm","sha":"f5d93296c8ec82b7e7dabdb308d24d43cb1907bf","parsed":{"files":[{"path":"docs/serving/online_serving/derenderer.md","lines":["@@ -90,8 +90,9 @@ Oversized payloads are rejected with a `400` before any `tokenizer.decode()` or"," "," The derenderer builds its tool and reasoning parsers from its own server flags plus the `chat_request` sent with each call. It can't see how the request was rendered or served anywhere else, so for its output to match a `vllm serve` server:"," ","-- Start the render server with the same `--tool-call-parser`, `--reasoning-parser`, `--enable-auto-tool-choice`, `--chat-template` and `--default-chat-template-kwargs` you'd give `vllm serve` for this model. If `/render` and `/derender` run on different servers, give both the same values.","+- Start the render server with the same `--tool-call-parser`, `--reasoning-parser`, `--enable-auto-tool-choice`, `--chat-template`, `--default-chat-template-kwargs` and `--response-role` you'd give `vllm serve` for this model. If `/render` and `/derender` run on different servers, give both the same values."," - Send the full `chat_request` that went to `/render`, not just `messages` and `tools`. Fields like `chat_template_kwargs`, `reasoning_effort`, `tool_choice` and `include_reasoning` change how the output is parsed.","+- The message `role` is `--response-role`, or the last message's role when `add_generation_prompt` is `false`. With `echo: true`, the last message's content is prepended when its role matches, as on `/v1/chat/completions`. Streaming puts the echoed text at the start of the first chunk's `content` instead of in a chunk of its own."," "," `/derender` decodes with the flags in `chat_request` which can differ from what the engine ran with. For parsers whose `adjust_request` changes decoding, use [`output_mode: \"derender\"`](token_in_token_out.md#derender) on `/inference/v1/generate`. It parses the engine's own text and matches coupled chat."," "],"additions":2,"deletions":1,"truncated":false},{"path":"docs/serving/online_serving/token_in_token_out.md","lines":["@@ -95,6 +95,7 @@ print(response[\"choices\"][0][\"token_ids\"])"," - `logprobs` follow coupled chat. `top_logprobs` is cut to `sampling_params.logprobs`, `logprob_token_ids` is honored. When a parser hides the reasoning with `include_reasoning: false`, `logprobs`, `token_ids` and `sampling_mask` are dropped so they don't expose it."," - `finish_reason` follows coupled chat too. It's `tool_calls` when the message has tool calls except with a named `tool_choice` or a `length` cut."," - With `stream: true`, each choice carries a chat `delta` (`role`, `content`, `reasoning`, `tool_calls`) instead of `text`, and `finish_reason` follows coupled chat. `role` is set on the first chunk of each choice, `n > 1` is supported, and `null` fields are left out of `delta`. A chunk is sent whenever the engine output carries a parsed delta, visible token IDs, logprobs or a `finish_reason`. Parsing runs on the API server event loop, so `--api-server-count` scales it.","+- The message `role` is the generate server's `--response-role`. `parse_context` doesn't carry `messages`, `add_generation_prompt` or `echo`, so the last message's role and `echo` aren't applied. Use [`/derender`](derenderer.md) for those."," - Cohere grounding citations aren't returned. The parser strips the citation spans from `content`, and the document map can't go over JSON in `parse_context`."," "," A streamed tool call looks like this, with the usage chunk and `data: [DONE]` framed as at the other levels:"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/entrypoints/openai/chat_completion/test_message_assembly.py","lines":["@@ -4,10 +4,12 @@"," from typing import Any"," "," import pytest","+from openai_harmony import Message, Role"," "," from vllm.entrypoints.generate.base.protocol import FunctionCall"," from vllm.entrypoints.openai.chat_completion.message_assembly import (","     assemble_chat_message_fields,","+    get_echo_content,"," )"," from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest"," ","@@ -106,3 +108,14 @@ def test_parallel_tool_calls_false_keeps_first():"," def test_include_reasoning(include_reasoning):","     fields = _assemble(_request(include_reasoning=include_reasoning))","     assert fields.reasoning == (\"think\" if include_reasoning else None)","+","+","+@pytest.mark.parametrize((\"role\", \"echoed\"), [(\"assistant\", \"1, 2,\"), (\"user\", \"\")])","+def test_echo_content_from_harmony_conversation(role, echoed):","+    \"\"\"gpt-oss conversations hold Harmony `Message` objects, not dicts.\"\"\"","+    conversation = [","+        Message.from_role_and_content(Role.USER, \"Count to five.\"),","+        Message.from_role_and_content(Role.ASSISTANT, \"1, 2,\").with_channel(\"final\"),","+    ]","+","+    assert get_echo_content(conversation, role) == echoed"],"additions":13,"deletions":0,"truncated":false},{"path":"tests/entrypoints/scale_out/derender/test_derender.py","lines":["@@ -16,7 +16,9 @@"," from vllm.entrypoints.scale_out.token_in_token_out.protocol import (","     GenerateTokensResponse,","     GenerateTokensStreamResponse,","+    ParseContext,"," )","+from vllm.outputs import CompletionOutput"," from vllm.renderers.online_derenderer import OnlineDerenderer"," from vllm.tokenizers import get_tokenizer"," from vllm.tokenizers.detokenizer_utils import convert_ids_list_to_tokens","@@ -2065,7 +2067,7 @@ def parse(self, model_output, request, **kwargs):","     assert choice.finish_reason == \"stop\""," "," ","-def _make_derenderer(tokenizer, generation_config: dict | None = None):","+def _make_derenderer(tokenizer, generation_config: dict | None = None, **kwargs):","     renderer = MagicMock()","     renderer.get_tokenizer.return_value = tokenizer","     renderer.get_eos_token_id.return_value = tokenizer.eos_token_id","@@ -2080,6 +2082,7 @@ def _make_derenderer(tokenizer, generation_config: dict | None = None):","         request_logger=None,","         chat_template=None,","         chat_template_content_format=\"string\",","+        **kwargs,","     )"," "," ","@@ -2154,6 +2157,120 @@ def test_derender_batch_trims_stop_like_engine(","     assert choice.stop_reason == reason"," "," ","+@pytest.mark.parametrize(\"tool_parser\", [None, \"hermes\"])","+@pytest.mark.parametrize(","+    (\"add_generation_prompt\", \"echo\", \"role\", \"echoed\"),","+    [","+        (True, True, \"bot\", \"\"),","+        (False, False, \"assistant\", \"\"),","+        (False, True, \"assistant\", \"1, 2,\"),","+    ],","+)","+def test_derender_chat_role_and_echo_match_chat_completion(","+    tokenizer, tool_parser, add_generation_prompt, echo, role, echoed","+):","+    \"\"\"Batch /derender takes the role from `--response-role` or, when the","+    last message is continued, from that message, and prepends it on","+    `echo`, as `/v1/chat/completions` does.\"\"\"","+    derenderer = _make_derenderer(","+        tokenizer,","+        response_role=\"bot\",","+        tool_parser=tool_parser,","+        enable_auto_tools=tool_parser is not None,","+    )","+    request = ChatCompletionRequest(","+        model=MODEL_NAME,","+        messages=[","+            {\"role\": \"user\", \"content\": \"Count to five.\"},","+            {\"role\": \"assistant\", \"content\": \"1, 2,\"},","+        ],","+        add_generation_prompt=add_generation_prompt,","+        continue_final_message=not add_generation_prompt,","+        echo=echo,","+    )","+    response = GenerateTokensResponse.model_validate(","+        _make_generate_response(","+            tokenizer.encode(\" 3, 4, 5\", add_special_tokens=False),","+            finish_reason=\"length\",","+        )","+    )","+","+    (choice,), _, _ = derenderer._derender_chat(response, request)","+    (plain,), _, _ = derenderer._derender_chat(","+        response, request.model_copy(update={\"echo\": False})","+    )","+","+    assert choice.message.role == role","+    assert choice.message.content == echoed + plain.message.content","+","+","+def test_derender_chat_empty_messages_uses_response_role(tokenizer):","+    \"\"\"With no message to continue, the role falls back to `--response-role`","+    instead of failing on `messages[-1]`.\"\"\"","+    derenderer = _make_derenderer(tokenizer, response_role=\"bot\")","+    request = ChatCompletionRequest(","+        model=MODEL_NAME, messages=[], add_generation_prompt=False, echo=True","+    )","+    response = GenerateTokensResponse.model_validate(","+        _make_generate_response(tokenizer.encode(\"Hi\", add_special_tokens=False))","+    )","+","+    (choice,), _, _ = derenderer._derender_chat(response, request)","+","+    assert choice.message.role == \"bot\"","+","+","+def test_derender_chat_echo_includes_refusal_parts(tokenizer):","+    \"\"\"`echo` takes text from every text-like part, as chat parsing does, not","+    only parts with a `text` key.\"\"\"","+    derenderer = _make_derenderer(tokenizer)","+    request = ChatCompletionRequest(","+        model=MODEL_NAME,","+        messages=[","+            {\"role\": \"user\", \"content\": \"Count to five.\"},","+            {","+                \"role\": \"assistant\",","+                \"content\": [","+                    {\"type\": \"refusal\", \"refusal\": \"No.\"},","+                    {\"type\": \"text\", \"text\": \"1, 2,\"},","+                ],","+            },","+        ],","+        add_generation_prompt=False,","+        continue_final_message=True,","+        echo=True,","+    )","+    response = GenerateTokensResponse.model_validate(","+        _make_generate_response(","+            tokenizer.encode(\" 3\", add_special_tokens=False),","+            finish_reason=\"length\",","+        )","+    )","+","+    (choice,), _, _ = derenderer._derender_chat(response, request)","+","+    assert choice.message.content.startswith(\"No.\\n1, 2,\")","+","+","+def test_generate_derender_role_is_response_role(tokenizer):","+    \"\"\"Generate `output_mode: \"derender\"` returns `--response-role`.\"\"\"","+    derenderer = _make_derenderer(tokenizer, response_role=\"bot\")","+    output = CompletionOutput(","+        index=0,","+        text=\"Hello\",","+        token_ids=[1],","+        cumulative_logprob=None,","+        logprobs=None,","+        finish_reason=\"stop\",","+    )","+","+    ((message, _),) = derenderer._derender_text_choices(","+        [output], ParseContext().to_chat_request(), 0, None","+    )","+","+    assert message.role == \"bot\"","+","+"," @pytest.mark.asyncio"," async def test_derender_completion_stream_leaves_out_stop_token(tokenizer):","     \"\"\"Streaming completions drops the final stop token like chat does and"],"additions":118,"deletions":1,"truncated":false},{"path":"tests/entrypoints/scale_out/derender/test_derender_parity.py","lines":["@@ -49,6 +49,9 @@","     \"--reasoning-parser\",","     \"deepseek_r1\",","     \"--enable-scale-out\",","+    # Not the default, so every case also checks the derender role.","+    \"--response-role\",","+    \"bot\","," ]"," "," TOOLS = [","@@ -160,6 +163,7 @@ def _engine_finish_reason(coupled_finish_reason: str) -> str:"," def _assert_parity(coupled: dict, disagg: dict) -> None:","     \"\"\"Both paths saw the same tokens, so they must agree unconditionally.\"\"\"","     c, d = coupled[\"choices\"][0], disagg[\"choices\"][0]","+    assert d[\"message\"][\"role\"] == c[\"message\"][\"role\"]","     assert d[\"message\"][\"content\"] == c[\"message\"][\"content\"]","     assert d[\"message\"].get(\"reasoning\") == c[\"message\"].get(\"reasoning\")","     assert _tool_sig(d) == _tool_sig(c)","@@ -207,6 +211,52 @@ async def test_parity_plain(client):","     _assert_parity(coupled, disagg)"," "," ","+@pytest.mark.asyncio","+async def test_parity_echo_continue_final_message(client):","+    \"\"\"`echo` with a continued assistant message: the role comes from that","+    message and its content is prepended.\"\"\"","+    messages = [","+        {\"role\": \"user\", \"content\": \"Count to five.\"},","+        {\"role\": \"assistant\", \"content\": \"1, 2,\"},","+    ]","+    coupled, disagg = await _run_parity_case(","+        client,","+        messages,","+        add_generation_prompt=False,","+        continue_final_message=True,","+        echo=True,","+        max_tokens=16,","+    )","+    _assert_parity(coupled, disagg)","+    assert disagg[\"choices\"][0][\"message\"][\"content\"].startswith(\"1, 2,\")","+","+","+@pytest.mark.asyncio","+async def test_parity_echo_refusal_part(client):","+    \"\"\"`echo` of list content with a `refusal` part which has no `text`","+    key: both paths include its text.\"\"\"","+    messages = [","+        {\"role\": \"user\", \"content\": \"Count to five.\"},","+        {","+            \"role\": \"assistant\",","+            \"content\": [","+                {\"type\": \"refusal\", \"refusal\": \"No.\"},","+                {\"type\": \"text\", \"text\": \"1, 2,\"},","+            ],","+        },","+    ]","+    coupled, disagg = await _run_parity_case(","+        client,","+        messages,","+        add_generation_prompt=False,","+        continue_final_message=True,","+        echo=True,","+        max_tokens=16,","+    )","+    _assert_parity(coupled, disagg)","+    assert disagg[\"choices\"][0][\"message\"][\"content\"].startswith(\"No.\\n1, 2,\")","+","+"," @pytest.mark.asyncio"," async def test_parity_reasoning(client):","     \"\"\"Reasoning/content split parity for <think>...</think> outputs.\"\"\"","@@ -940,6 +990,7 @@ async def _inline_derender("," def _assert_inline_parity(coupled: dict, inline: dict) -> None:","     assert len(inline[\"choices\"]) == len(coupled[\"choices\"])","     for c, i in zip(coupled[\"choices\"], inline[\"choices\"]):","+        assert i[\"message\"][\"role\"] == c[\"message\"][\"role\"]","         if c[\"token_ids\"] is None:","             # Hidden reasoning suppresses token ids on both paths, so the two","             # generations can't be shown to match and their text may differ."],"additions":51,"deletions":0,"truncated":false},{"path":"tests/entrypoints/scale_out/derender/test_derender_stream.py","lines":["@@ -1387,6 +1387,53 @@ def _chat_request(**kwargs):","     return ChatCompletionRequest(**kwargs)"," "," ","+@pytest.mark.asyncio","+@pytest.mark.parametrize(\"derenderer_fixture\", [\"derenderer\", \"parsed_derenderer\"])","+@pytest.mark.parametrize(","+    (\"add_generation_prompt\", \"role\", \"echoed\"),","+    [(True, \"bot\", \"\"), (False, \"assistant\", \"1, 2,\")],","+)","+async def test_stream_role_and_echo_match_chat_completion(","+    request, monkeypatch, derenderer_fixture, add_generation_prompt, role, echoed","+):","+    \"\"\"Streaming derender sends the role `/v1/chat/completions` would and","+    the `echo` text once, at the start of the first chunk's content.\"\"\"","+    dr = request.getfixturevalue(derenderer_fixture)","+    monkeypatch.setattr(dr, \"response_role\", \"bot\")","+    chat_request = _chat_request(","+        messages=[","+            {\"role\": \"user\", \"content\": \"Count to five.\"},","+            {\"role\": \"assistant\", \"content\": \"1, 2,\"},","+        ],","+        add_generation_prompt=add_generation_prompt,","+        continue_final_message=not add_generation_prompt,","+        echo=True,","+    )","+","+    async def stream(chat_request: ChatCompletionRequest) -> list[DeltaMessage]:","+        deltas = []","+        state = None","+        for _ in range(2):","+            chunk, state = await dr.derender_chat_stream(","+                model=MODEL_NAME,","+                generate_chunk=_make_stream_chunk([_FakeParser.CONTENT]),","+                state=state,","+                chat_request=chat_request,","+                prompt_token_ids=[1],","+            )","+            deltas.append(chunk.choices[0].delta)","+        return deltas","+","+    first, second = await stream(chat_request)","+    plain_first, plain_second = await stream(","+        chat_request.model_copy(update={\"echo\": False})","+    )","+","+    assert (first.role, second.role) == (role, None)","+    assert first.content == echoed + (plain_first.content or \"\") or None","+    assert second.content == plain_second.content","+","+"," class TestDerenderChatStreamParsed:","     \"\"\"derender_chat_stream: parser branch (replay + parse_delta) exercised","     against the deterministic `_FakeParser` so these pin OnlineDerenderer's"],"additions":47,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/launchers/api_server/app_state.py","lines":["@@ -111,6 +111,7 @@ async def init_app_state(","         chat_template=resolved_chat_template,","         chat_template_content_format=args.chat_template_content_format,","         trust_request_chat_template=args.trust_request_chat_template,","+        response_role=args.response_role,","         enable_auto_tools=args.enable_auto_tool_choice,","         exclude_tools_when_tool_choice_none=args.exclude_tools_when_tool_choice_none,","         tool_parser=args.tool_call_parser,"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/launchers/render/app_state.py","lines":["@@ -86,6 +86,7 @@ async def init_render_app_state(","         chat_template=resolved_chat_template,","         chat_template_content_format=args.chat_template_content_format,","         trust_request_chat_template=args.trust_request_chat_template,","+        response_role=args.response_role,","         enable_auto_tools=args.enable_auto_tool_choice,","         exclude_tools_when_tool_choice_none=args.exclude_tools_when_tool_choice_none,","         tool_parser=args.tool_call_parser,"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/entrypoints/openai/chat_completion/batch_serving.py","lines":["@@ -10,6 +10,9 @@"," from fastapi import Request"," "," from vllm.entrypoints.generate.base.protocol import RequestResponseMetadata","+from vllm.entrypoints.openai.chat_completion.message_assembly import (","+    get_echo_content,","+)"," from vllm.entrypoints.openai.chat_completion.protocol import (","     BatchChatCompletionRequest,","     ChatCompletionRequest,","@@ -327,18 +330,9 @@ async def chat_completion_full_generator_batch(","                 message = ChatMessage(role=role, reasoning=reasoning, content=content)"," ","                 if request.echo:","-                    conversation = all_conversations[prompt_idx]","-                    last_msg_content: str | list[dict[str, str]] = \"\"","-                    if (","-                        conversation","-                        and \"content\" in conversation[-1]","-                        and conversation[-1].get(\"role\") == role","-                    ):","-                        last_msg_content = conversation[-1][\"content\"] or \"\"","-                    if isinstance(last_msg_content, list):","-                        last_msg_content = \"\\n\".join(","-                            msg[\"text\"] for msg in last_msg_content","-                        )","+                    last_msg_content = get_echo_content(","+                        all_conversations[prompt_idx], role","+                    )","                     message.content = last_msg_content + (message.content or \"\")"," ","                 choice_data = ChatCompletionResponseChoice("],"additions":6,"deletions":12,"truncated":false},{"path":"vllm/entrypoints/openai/chat_completion/message_assembly.py","lines":["@@ -1,6 +1,9 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project","-from typing import NamedTuple","+from collections.abc import Mapping, Sequence","+from typing import Any, NamedTuple","+","+from openai_harmony import Message as HarmonyMessage"," "," from vllm.entrypoints.generate.base.protocol import FunctionCall, ToolCall"," from vllm.entrypoints.openai.chat_completion.protocol import (","@@ -13,6 +16,7 @@"," from vllm.logger import init_logger"," from vllm.parser.abstract_parser import Parser"," from vllm.renderers.chat_utils import make_tool_call_id","+from vllm.renderers.chat_utils.chat_message import MM_PARSER_MAP, TEXT_PART_TYPES"," "," logger = init_logger(__name__)"," ","@@ -109,6 +113,56 @@ def _forces_tool_calls(request: ChatCompletionRequest) -> bool:","     )"," "," ","+def get_chat_response_role(request: ChatCompletionRequest, response_role: str) -> str:","+    \"\"\"Role of the response message: `response_role` (the server's","+    `--response-role`), or the last message's role when the request continues","+    it (`add_generation_prompt=False`).","+    \"\"\"","+    if request.add_generation_prompt or not request.messages:","+        return response_role","+    return request.messages[-1][\"role\"]","+","+","+def get_echo_content(","+    messages: Sequence[Mapping[str, Any] | HarmonyMessage], role: str","+) -> str:","+    \"\"\"Text that `echo` prepends to the response content.","+","+    Args:","+        messages: The conversation, parsed (Harmony messages for gpt-oss) or","+            as sent in the request.","+        role: The response role from `get_chat_response_role`.","+","+    Returns:","+        The last message's text when its role is `role`, otherwise \"\". Text","+        parts of list content are extracted and joined with newlines, as chat","+        parsing does. Multimodal parts are left out.","+","+    \"\"\"","+    if not messages:","+        return \"\"","+    last = messages[-1]","+    if isinstance(last, HarmonyMessage):","+        last = last.to_dict()","+    if last.get(\"role\") != role:","+        return \"\"","+    content = last.get(\"content\") or \"\"","+    if isinstance(content, str):","+        return content","+    texts = (_part_text(part) for part in content)","+    return \"\\n\".join(text for text in texts if text is not None)","+","+"