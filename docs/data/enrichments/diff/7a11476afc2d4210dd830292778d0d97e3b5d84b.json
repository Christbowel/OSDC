     $isOpen = true;","             } else {","-                $nextCount = $this->getCount((int)$newID);","+                $nextCount = count($this->subpages[$newID] ?? []);","                 // Clear \"did expand\" flag","                 $isOpen = false;","             }","@@ -322,7 +333,6 @@ public function getTree(int $uid, int $depth = 999, string $depthData = ''): int","             ];","         }"," ","-        $res->free();","         $this->buffer_idH = $idH;","         return $c;","     }","@@ -334,77 +344,51 @@ public function getTree(int $uid, int $depth = 999, string $depthData = ''): int","      *","      ********************************/","     /**","-     * Returns the number of records having the parent id, $uid","+     * Fetches the workspace-resolved subpages of a page down to the given depth, and one","+     * level more to know whether the pages on the last level have subpages.","      *","-     * @param int $uid Id to count subitems for","-     */","-    protected function getCount(int $uid): int","-    {","-        $queryBuilder = GeneralUtility::makeInstance(ConnectionPool::class)->getQueryBuilderForTable($this->table);","-        $queryBuilder->getRestrictions()","-                ->removeAll()","-                ->add(GeneralUtility::makeInstance(DeletedRestriction::class))","-                ->add(GeneralUtility::makeInstance(WorkspaceRestriction::class, $this->getBackendUser()->workspace));","-        $count = $queryBuilder","-                ->count('uid')","-                ->from($this->table)","-                ->where(","-                    $queryBuilder->expr()->eq(","-                        $this->parentField,","-                        $queryBuilder->createNamedParameter($uid, Connection::PARAM_INT)","-                    ),","-                    QueryHelper::stripLogicalOperatorPrefix($this->clause)","-                )","-                ->executeQuery()","-                ->fetchOne();","-","-        return (int)$count;","-    }","-","-    /**","-     * Getting the tree data: Selecting/Initializing data pointer to items for a certain parent id.","-     * For tables: This will make a database query to select all children to \"parent\"","+     * @return array<int, list<array<string, mixed>>> Pages by parent page id, in the order of $this->orderByFields","      */","-    protected function getDataInit(int $parentId): Result","+    protected function fetchSubpages(int $uid, int $depth): array","     {","-        $queryBuilder = GeneralUtility::makeInstance(ConnectionPool::class)->getQueryBuilderForTable($this->table);","-        $queryBuilder->getRestrictions()","-                ->removeAll()","-                ->add(GeneralUtility::makeInstance(DeletedRestriction::class))","-                ->add(GeneralUtility::makeInstance(WorkspaceRestriction::class, $this->getBackendUser()->workspace));","-        $queryBuilder","-                ->select(...$this->fieldArray)","-                ->from($this->table)","-                ->where(","-                    $queryBuilder->expr()->eq(","-                        $this->parentField,","-                        $queryBuilder->createNamedParameter($parentId, Connection::PARAM_INT)","-                    ),","-                    QueryHelper::stripLogicalOperatorPrefix($this->clause)","-                );","-","-        foreach (QueryHelper::parseOrderBy($this->orderByFields) as $orderPair) {","-            [$fieldName, $order] = $orderPair;","-            $queryBuilder->addOrderBy($fieldName, $order);","+        $clause = QueryHelper::stripLogicalOperatorPrefix($this->clause);","+        $pages = GeneralUtility::makeInstance(PageDescendantsRepository::class)->findDescendants(","+            [$uid],","+            min($depth, PageDescendantsRepository::MAX_TRAVERSAL_LEVELS - 1) + 1,","+            (int)$this->getBackendUser()->workspace,","+            $clause !== '' ? static fn(): string => $clause : null,","+            [],","+            $this->fieldArray,","+            false,","+            true,","+        );","+        $subpages = [];","+        foreach ($pages as $page) {","+            $subpages[$page['pid']][] = $page;","         }","-","-        return $queryBuilder->executeQuery();","-    }","-","-    /**","-     * Getting the tree data: next entry","-     *","-     * @see getDataInit()","-     */","-    protected function getDataNext(Result $res): array|false","-    {","-        while ($row = $res->fetchAssociative()) {","-            BackendUtility::workspaceOL($this->table, $row, $this->getBackendUser()->workspace, true);","-            if (is_array($row)) {","-                break;","+        $orderBy = array_map(","+            static fn(array $orderByField): array => [preg_replace('/^pages\\./', '', $orderByField[0]), $orderByField[1]],","+            QueryHelper::parseOrderBy($this->orderByFields)","+        );","+        if ($orderBy !== [['sorting', null]]) {","+            foreach ($subpages as &$pagesOfParent) {","+                usort($pagesOfParent, static function (array $a, array $b) use ($orderBy): int {","+                    foreach ($orderBy as [$fieldName, $order]) {","+                        $valueA = $a[$fieldName] ?? null;","+                        $valueB = $b[$fieldName] ?? null;","+                        $result = is_string($valueA) && is_string($valueB) && !(is_numeric($valueA) && is_numeric($valueB))","+                            ? strnatcasecmp($valueA, $valueB)","+                            : $valueA <=> $valueB;","+                        if ($result !== 0) {","+                            return strtoupper((string)$order) === 'DESC' ? -$result : $result;","+                        }","+                    }","+                    return 0;","+                });","             }","+            unset($pagesOfParent);","         }","-        return $row;","+        return $subpages;","     }"," ","     protected function getLanguageService(): LanguageService"],"additions":78,"deletions":94,"truncated":false},{"path":"typo3/sysext/backend/Classes/Tree/View/PageTreeView.php","lines":["@@ -17,8 +17,6 @@"," "," namespace TYPO3\\CMS\\Backend\\Tree\\View;"," ","-use TYPO3\\CMS\\Core\\Schema\\LanguageMarker;","-"," /**","  * Generate a page-tree, non-browsable.","  *","@@ -37,7 +35,8 @@ class PageTreeView extends AbstractTreeView","      */","     public function init($clause = '', $orderByFields = '')","     {","-        parent::init(' AND deleted=0 AND sys_language_uid=' . LanguageMarker::DEFAULT_LANGUAGE . ' ' . $clause, $orderByFields);","+        // Deleted pages and translations are never part of the tree","+        parent::init($clause, $orderByFields);","     }"," ","     /**"],"additions":2,"deletions":3,"truncated":false},{"path":"typo3/sysext/backend/Tests/Functional/Tree/View/Fixtures/PageTree.csv","lines":["@@ -0,0 +1,21 @@","+\"pages\"","+,\"uid\",\"pid\",\"sorting\",\"deleted\",\"hidden\",\"sys_language_uid\",\"l10n_parent\",\"t3ver_oid\",\"t3ver_wsid\",\"t3ver_state\",\"title\",\"perms_everybody\"","+,1,0,256,0,0,0,0,0,0,0,\"Root\",1","+,2,1,512,0,0,0,0,0,0,0,\"Second\",1","+,3,1,256,0,0,0,0,0,0,0,\"First\",1","+,4,2,256,0,0,0,0,0,0,0,\"Second B\",1","+,5,2,128,0,0,0,0,0,0,0,\"second A\",1","+,6,3,256,0,0,0,0,0,0,0,\"First A\",1","+,7,6,256,0,0,0,0,0,0,0,\"First A A\",1","+,8,1,768,1,0,0,0,0,0,0,\"Deleted\",1","+,9,1,1024,0,0,0,0,0,0,0,\"Restricted\",0","+,10,1,512,0,0,1,2,0,0,0,\"Second translated\",1","+,11,3,64,0,0,0,0,4,1,4,\"Second B moved\",1","+,12,2,128,0,0,0,0,5,1,2,\"second A deleted\",1","+\"be_users\"","+,\"uid\",\"pid\",\"username\",\"admin\",\"workspace_perms\",\"db_mountpoints\"","+,1,0,\"admin\",1,1,\"\"","+,2,0,\"editor\",0,1,\"1\"","+\"sys_workspace\"","+,\"uid\",\"pid\",\"title\",\"members\"","+,1,0,\"Workspace\",\"be_users_2\""],"additions":21,"deletions":0,"truncated":false},{"path":"typo3/sysext/backend/Tests/Functional/Tree/View/PageTreeViewTest.php","lines":["@@ -0,0 +1,132 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Backend\\Tests\\Functional\\Tree\\View;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Backend\\Tree\\View\\PageTreeView;","+use TYPO3\\CMS\\Core\\Localization\\LanguageServiceFactory;","+use TYPO3\\CMS\\Core\\Tests\\Functional\\Domain\\Repository\\Fixtures\\QueryCountingMiddleware;","+use TYPO3\\CMS\\Core\\Type\\Bitmask\\Permission;","+use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class PageTreeViewTest extends FunctionalTestCase","+{","+    protected array $coreExtensionsToLoad = ['workspaces'];","+","+    protected array $configurationToUseInTestInstance = [","+        'DB' => [","+            'globalDriverMiddlewares' => [","+                'typo3-tests/query-counting' => [","+                    'target' => QueryCountingMiddleware::class,","+                ],","+            ],","+        ],","+    ];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/PageTree.csv');","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->create('default');","+    }","+","+    #[Test]","+    public function treeContainsSubpagesInPageTreeOrder(): void","+    {","+        $this->setUpBackendUser(1);","+        $subject = GeneralUtility::makeInstance(PageTreeView::class);","+        $subject->init();","+        $count = $subject->getTree(1, 2);","+","+        self::assertSame(3, $count);","+        self::assertSame(","+            [","+                [3, 2, true, true, false],","+                [6, 1, true, true, true],","+                [2, 2, true, false, false],","+                [5, 1, false, true, false],","+                [4, 1, false, false, true],","+                [9, 2, false, false, true],","+            ],","+            array_map(","+                static fn(array $item): array => [(int)$item['row']['uid'], $item['invertedDepth'], (bool)$item['hasSub'], $item['isFirst'], $item['isLast']],","+                $subject->tree","+            )","+        );","+        self::assertSame([2 => [3, 2, 9], 1 => [6, 5, 4]], $subject->orig_ids_hierarchy);","+    }","+","+    #[Test]","+    public function treeContainsPagesMovedAndDeletedInTheWorkspace(): void","+    {","+        $this->setUpBackendUser(1)->workspace = 1;","+        $subject = GeneralUtility::makeInstance(PageTreeView::class);","+        $subject->init();","+        $subject->getTree(1, 2);","+","+        self::assertSame([3, 4, 6, 2, 5, 9], array_map(static fn(array $item): int => (int)$item['row']['uid'], $subject->tree));","+        self::assertSame([2 => [3, 2, 9], 1 => [11, 6, 12]], $subject->orig_ids_hierarchy);","+        self::assertSame('Second B moved', $subject->tree[1]['row']['title']);","+    }","+","+    #[Test]","+    public function treeContainsOnlyPagesMatchingTheClause(): void","+    {","+        $backendUser = $this->setUpBackendUser(2);","+        $subject = GeneralUtility::makeInstance(PageTreeView::class);","+        $subject->init('AND ' . $backendUser->getPagePermsClause(Permission::PAGE_SHOW));","+        $subject->getTree(1, 99);","+","+        self::assertSame([3, 6, 7, 2, 5, 4], array_map(static fn(array $item): int => (int)$item['row']['uid'], $subject->tree));","+    }","+","+    #[Test]","+    public function treeContainsOnlyPagesMatchingAnUnqualifiedClauseInTheWorkspace(): void","+    {","+        $this->setUpBackendUser(1)->workspace = 1;","+        $subject = GeneralUtility::makeInstance(PageTreeView::class);","+        $subject->init(' AND perms_everybody <> 0 AND uid <> 2');","+        $subject->getTree(1, 99);","+","+        self::assertSame([3, 4, 6, 7], array_map(static fn(array $item): int => (int)$item['row']['uid'], $subject->tree));","+    }","+","+    #[Test]","+    public function treeIsOrderedByTitleIgnoringCase(): void","+    {","+        $this->setUpBackendUser(1);","+        $subject = GeneralUtility::makeInstance(PageTreeView::class);","+        $subject->init('', 'title');","+        $subject->getTree(2, 1);","+","+        self::assertSame([5, 4], array_map(static fn(array $item): int => (int)$item['row']['uid'], $subject->tree));","+    }","+","+    #[Test]","+    public function treeIsFetchedWithOneQuery(): void","+    {","+        $this->setUpBackendUser(1);","+        $subject = GeneralUtility::makeInstance(PageTreeView::class);","+        $subject->init();","+        QueryCountingMiddleware::$count = 0;","+        $subject->getTree(1, 99);","+","+        self::assertSame(1, QueryCountingMiddleware::$count);","+    }","+}"],"additions":132,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Domain/Repository/PageDescendantsRepository.php","lines":["@@ -0,0 +1,335 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Domain\\Repository;","+","+use Doctrine\\DBAL\\Platforms\\TrimMode;","+use Symfony\\Component\\DependencyInjection\\Attribute\\Autoconfigure;","+use TYPO3\\CMS\\Core\\Database\\Connection;","+use TYPO3\\CMS\\Core\\Database\\ConnectionPool;","+use TYPO3\\CMS\\Core\\Database\\Query\\Expression\\ExpressionBuilder;","+use TYPO3\\CMS\\Core\\Database\\Query\\QueryBuilder;","+use TYPO3\\CMS\\Core\\Database\\Query\\Restriction\\QueryRestrictionInterface;","+use TYPO3\\CMS\\Core\\Schema\\LanguageMarker;","+use TYPO3\\CMS\\Core\\Versioning\\VersionState;","+","+/**","+ * Fetches the descendants of pages - their subpages, the subpages of these and so on -","+ * with one recursive common table expression (CTE).","+ *","+ * Only pages of the default language are part of the page tree. Pages are resolved for","+ * the given workspace: a page with a workspace version is found at the position of its","+ * version, pages new in the workspace are included, and pages deleted in the workspace","+ * are left out together with their subpages, unless they are requested.","+ *","+ * Access restrictions are not applied by default, callers hand them in as constraints:","+ * a page not matching them is left out together with its subpages.","+ *","+ * @internal The building block for backend and frontend consumers, not part of the public API yet","+ */","+#[Autoconfigure(public: true)]","+final readonly class PageDescendantsRepository","+{","+    public const int MAX_TRAVERSAL_LEVELS = 100;","+","+    /**","+     * Fields of the page tree structure, which are part of every returned row.","+     */","+    private const array STRUCTURE_FIELDS = ['uid', 'pid', 'sorting'];","+","+    public function __construct(","+        private ConnectionPool $connectionPool,","+    ) {}","+","+    /**","+     * Returns the descendants of the given pages, without the given pages themselves,","+     * ordered depth-first: each page is followed by its subpages, pages with the same","+     * parent page are ordered by their \"sorting\" value.","+     *","+     * Each row holds the uid of the live page as \"uid\", the parent page uid (in the","+     * workspace) as \"pid\", \"sorting\" and the level below the given pages as \"_LEVEL\",","+     * starting with 1. A page with a workspace version additionally holds the uid of the","+     * version as \"_ORIG_uid\", other requested fields are then taken from the version.","+     *","+     * @param list<int> $pageIds Pages to start from, their descendants are returned in this order","+     * @param int $depth Number of levels below the given pages, 1 for their direct subpages only","+     * @param (\\Closure(ExpressionBuilder, string): string)|null $liveConstraint SQL constraint","+     *        evaluated on the live page, receiving the table alias of the live page (\"pages\"),","+     *        e.g. for the page permissions, which are not versioned. Column names may be","+     *        unqualified or qualified with \"pages\"","+     * @param list<QueryRestrictionInterface> $restrictions Restrictions evaluated on the page","+     *        (the workspace version, if there is one), e.g. to leave out hidden pages","+     * @param list<string> $fields Additional fields of the page records to return, '*' for all","+     * @param bool $includeDeleted Whether deleted pages and their subpages are included","+     * @param bool $includeDeletedInWorkspace Whether pages deleted in the workspace and their subpages are included","+     * @return list<array<string, mixed>>","+     */","+    public function findDescendants(","+        array $pageIds,","+        int $depth,","+        int $workspaceId,","+        ?\\Closure $liveConstraint = null,","+        array $restrictions = [],","+        array $fields = [],","+        bool $includeDeleted = false,","+        bool $includeDeletedInWorkspace = false,","+    ): array {","+        $pageIds = array_values(array_unique(array_map(intval(...), $pageIds)));","+        $depth = min($depth, self::MAX_TRAVERSAL_LEVELS);","+        if ($pageIds === [] || $depth < 1) {","+            return [];","+        }","+        $cte = $this->connectionPool->get