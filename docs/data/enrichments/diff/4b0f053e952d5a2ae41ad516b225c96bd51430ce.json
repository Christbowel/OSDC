ns.","+\t\tconst onDidReceiveData = Event.buffer(connection.data.event, 'agentHostClientForwarding.data', false, [], store);","+\t\tconst onDidClose = Event.buffer(connection.close.event, 'agentHostClientForwarding.close', false, [], store);","+\t\ttry {","+\t\t\tawait this._service.open(id, socket);","+\t\t} catch (error) {","+\t\t\tif (this._connections.get(id) === connection) {","+\t\t\t\tthis._connections.delete(id);","+\t\t\t}","+\t\t\tstore.dispose();","+\t\t\tthrow error;","+\t\t}","+\t\tif (this._store.isDisposed || !this._options.forwardCredentials()) {","+\t\t\t// Closing again, as the service may have still been opening when this was disposed or forwarding turned off.","+\t\t\tif (this._connections.get(id) === connection) {","+\t\t\t\tthis._connections.delete(id);","+\t\t\t}","+\t\t\tstore.dispose();","+\t\t\tvoid this._service.close(id).catch(() => { });","+\t\t\tthrow new Error('This client does not forward its agents');","+\t\t}","+\t\treturn {","+\t\t\tonDidReceiveData,","+\t\t\tonDidClose,","+\t\t\twrite: data => void this._service.write(id, data).catch(() => { }),","+\t\t\tdispose: () => {","+\t\t\t\tstore.dispose();","+\t\t\t\tif (this._connections.get(id) === connection) {","+\t\t\t\t\tthis._connections.delete(id);","+\t\t\t\t\tvoid this._service.close(id).catch(() => { });","+\t\t\t\t}","+\t\t\t},","+\t\t};","+\t}","+","+\tasync gitCredential(operation: ClientGitCredentialOperation, input: string): Promise<string> {","+\t\tif (!this._options.forwardCredentials()) {","+\t\t\treturn '';","+\t\t}","+\t\tconst output = await this._service.gitCredential(operation, input);","+\t\t// Forwarding may have turned off while a credential manager signed in.","+\t\treturn this._options.forwardCredentials() && !this._store.isDisposed ? output : '';","+\t}","+","+\tasync gpgKeys(): Promise<ClientGpgKeys> {","+\t\treturn this._options.forwardCredentials() ? this._service.gpgKeys() : {};","+\t}","+","+\tasync gitConfig(): Promise<ClientGitConfig> {","+\t\tconst gi