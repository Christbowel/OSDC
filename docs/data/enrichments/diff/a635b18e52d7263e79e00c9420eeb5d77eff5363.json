{"id":"a635b18e52d7263e79e00c9420eeb5d77eff5363","axis":"silent","repo":"envoyproxy/envoy","sha":"a635b18e52d7263e79e00c9420eeb5d77eff5363","parsed":{"files":[{"path":"changelogs/current/bug_fixes/mcp__protocol-version-meta-validation.rst","lines":["@@ -0,0 +1,6 @@","+Fixed handling of MCP ``2026-07-28`` requests whose ``params._meta[\"io.modelcontextprotocol/protocolVersion\"]`` is","+missing or is not a string. The :ref:`MCP filter <config_http_filters_mcp>` in ``REJECT_NO_MCP`` mode and the","+``mcp_json_rest_bridge`` HTTP filter now reject them with HTTP ``400`` and JSON-RPC error ``-32602``. Previously, the","+MCP filter accepted missing metadata and rejected non-string metadata as a ``-32020`` header mismatch counted in","+``header_mismatch``, and the bridge handled requests with an ``MCP-Protocol-Version: 2026-07-28`` header but without","+valid metadata as legacy requests."],"additions":6,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp/mcp_filter.cc","lines":["@@ -865,7 +865,7 @@ McpFilter::ProtocolVersionValidationResult McpFilter::validateProtocolVersion()","   }"," ","   if (it->second.kind_case() != Protobuf::Value::kStringValue) {","-    return ProtocolVersionValidationResult::Mismatch;","+    return ProtocolVersionValidationResult::Invalid;","   }"," ","   if (it->second.string_value() != *protocol_version_) {","@@ -920,6 +920,17 @@ Http::FilterDataStatus McpFilter::completeParsing() {","     }","   }"," ","+  if (shouldRejectRequest() &&","+      (version_validation == ProtocolVersionValidationResult::Invalid ||","+       (version_validation == ProtocolVersionValidationResult::Missing && !parser_->isResponse() &&","+        parser_->getNestedValue(Filters::Common::Mcp::McpConstants::ID_FIELD) != nullptr))) {","+    sendJsonRpcErrorReply(","+        Filters::Common::Mcp::McpConstants::JSONRPC_INVALID_PARAMS_ERROR_CODE,","+        absl::StrCat(\"Missing or invalid params._meta field: \",","+                     Filters::Common::Mcp::McpConstants::MCP_META_PROTOCOL_VERSION_FIELD));","+    return Http::FilterDataStatus::StopIterationNoBuffer;","+  }","+","   if (shouldRejectRequest() && !hasRequiredClientCapabilities()) {","     sendJsonRpcErrorReply(","         Filters::Common::Mcp::McpConstants::JSONRPC_INVALID_PARAMS_ERROR_CODE,"],"additions":12,"deletions":1,"truncated":false},{"path":"source/extensions/filters/http/mcp/mcp_filter.h","lines":["@@ -203,6 +203,7 @@ class McpFilter : public Http::PassThroughFilter, public Logger::Loggable<Logger","   enum class ProtocolVersionValidationResult {","     Ok,","     Missing,","+    Invalid,","     Mismatch,","   };","   ProtocolVersionValidationResult validateProtocolVersion() const;"],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/bridge_status.cc","lines":["@@ -19,6 +19,8 @@ absl::string_view bridgeStatusToString(BridgeStatus status) {","     return BridgeStatusValues::REQUEST_UNSUPPORTED_MCP_VERSION;","   case BridgeStatus::RequestMcpHeaderMismatch:","     return BridgeStatusValues::REQUEST_MCP_HEADER_MISMATCH;","+  case BridgeStatus::RequestMcpProtocolVersionMetaInvalid:","+    return BridgeStatusValues::REQUEST_MCP_PROTOCOL_VERSION_META_INVALID;","   case BridgeStatus::RequestMcpClientCapabilitiesInvalid:","     return BridgeStatusValues::REQUEST_MCP_CLIENT_CAPABILITIES_INVALID;","   case BridgeStatus::RequestInitializeNotValid:"],"additions":2,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/bridge_status.h","lines":["@@ -14,6 +14,7 @@ enum class BridgeStatus {","   RequestFailedToParseJsonRpc,","   RequestUnsupportedMcpVersion,","   RequestMcpHeaderMismatch,","+  RequestMcpProtocolVersionMetaInvalid,","   RequestMcpClientCapabilitiesInvalid,","   RequestInitializeNotValid,","   RequestMcpMethodNotSupported,","@@ -46,6 +47,8 @@ inline constexpr absl::string_view REQUEST_UNSUPPORTED_MCP_VERSION =","     \"mcp_json_rest_bridge_request_unsupported_mcp_version\";"," inline constexpr absl::string_view REQUEST_MCP_HEADER_MISMATCH =","     \"mcp_json_rest_bridge_request_mcp_header_mismatch\";","+inline constexpr absl::string_view REQUEST_MCP_PROTOCOL_VERSION_META_INVALID =","+    \"mcp_json_rest_bridge_request_mcp_protocol_version_meta_invalid\";"," inline constexpr absl::string_view REQUEST_MCP_CLIENT_CAPABILITIES_INVALID =","     \"mcp_json_rest_bridge_request_mcp_client_capabilities_invalid\";"," inline constexpr absl::string_view REQUEST_INITIALIZE_NOT_VALID ="],"additions":3,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/mcp_json_rest_bridge_filter.cc","lines":["@@ -89,12 +89,8 @@ bool isLegacyMcpProtocolVersionSupported(absl::string_view protocol_version) {","   return supported_legacy_mcp_versions->contains(protocol_version);"," }"," ","-bool isStatelessProtocolRequest(const json& json_rpc,","-                                absl::string_view max_supported_protocol_version) {","-  if (max_supported_protocol_version < McpConstants::MCP_VERSION_2026_07_28) {","-    return false;","-  }","-","+// Returns whether params._meta carries a string protocol version.","+bool hasProtocolVersionMeta(const json& json_rpc) {","   if (!json_rpc.contains(McpConstants::PARAMS_FIELD) ||","       !json_rpc[McpConstants::PARAMS_FIELD].is_object()) {","     return false;","@@ -110,6 +106,20 @@ bool isStatelessProtocolRequest(const json& json_rpc,","          meta[McpConstants::MCP_META_PROTOCOL_VERSION_FIELD].is_string();"," }"," ","+// A request with a stateless MCP-Protocol-Version header is stateless even if its protocol version","+// metadata is missing or invalid, so that it is rejected rather than handled as a legacy request.","+bool isStatelessProtocolRequest(const json& json_rpc,","+                                std::optional<absl::string_view> header_protocol_version,","+                                absl::string_view max_supported_protocol_version) {","+  if (max_supported_protocol_version < McpConstants::MCP_VERSION_2026_07_28) {","+    return false;","+  }","+","+  return hasProtocolVersionMeta(json_rpc) ||","+         (header_protocol_version.has_value() &&","+          isStatelessMcpProtocolVersionSupported(*header_protocol_version));","+}","+"," void addCompleteResultTypeIfStateless(json& response, bool is_stateless_request) {","   if (is_stateless_request && response.contains(McpConstants::RESULT_FIELD) &&","       response[McpConstants::RESULT_FIELD].is_object()) {","@@ -1401,6 +1411,17 @@ absl::Status McpJsonRestBridgeFilter::validateMcpProtocolVersionHeader(","     return absl::OkStatus();","   }"," ","+  if (!hasProtocolVersionMeta(json_rpc)) {","+    sendErrorResponse(","+        Http::Code::BadRequest, BridgeStatus::RequestMcpProtocolVersionMetaInvalid,","+        generateErrorJsonResponse(McpConstants::JSONRPC_INVALID_PARAMS_ERROR_CODE,","+                                  absl::StrCat(\"Missing or invalid params._meta field: \",","+                                               McpConstants::MCP_META_PROTOCOL_VERSION_FIELD))","+            .dump(),","+        nullptr, method, params);","+    return absl::InvalidArgumentError(\"Missing or invalid protocol version metadata\");","+  }","+","   const std::optional<absl::string_view> header_protocol_version =","       getRequestMcpProtocolVersionHeader(request_headers);","   const absl::string_view body_protocol_version =","@@ -1543,7 +1564,8 @@ void McpJsonRestBridgeFilter::handleMcpMethod(","   }"," ","   is_stateless_request_ =","-      isStatelessProtocolRequest(json_rpc, config_->maxSupportedProtocolVersion());","+      isStatelessProtocolRequest(json_rpc, getRequestMcpProtocolVersionHeader(request_headers),","+                                 config_->maxSupportedProtocolVersion());"," ","   std::string method = json_rpc[McpConstants::METHOD_FIELD];"," "],"additions":29,"deletions":7,"truncated":false},{"path":"source/extensions/filters/http/mcp_json_rest_bridge/mcp_json_rest_bridge_filter.h","lines":["@@ -259,9 +259,10 @@ class McpJsonRestBridgeFilter : public Http::PassThroughFilter,"," ","   // Validates that a stateless (2026-07-28) request carries the required","   // params._meta[\"io.modelcontextprotocol/clientCapabilities\"] field and that it is a JSON object.","-  // Individual capability contents are not validated. Must only be called for stateless requests,","-  // whose params._meta is guaranteed to be an object. Returns true when the field is valid.","-  // Otherwise sends a local error response and returns false.","+  // Individual capability contents are not validated. Must only be called for stateless requests","+  // after validateMcpProtocolVersionHeader() succeeds, which guarantees that params._meta is an","+  // object. Returns true when the field is valid. Otherwise sends a local error response and","+  // returns false.","   bool validateClientCapabilitiesMeta(const nlohmann::json& json_rpc, absl::string_view method);"," ","   // Validates that the \"Mcp-Method\" request header is present and matches the JSON-RPC \"method\"","@@ -302,8 +303,9 @@ class McpJsonRestBridgeFilter : public Http::PassThroughFilter,","   // 1. For JSON-RPC application/protocol errors in the request payload (-32600, -32601, -32602),","   //    MUST use Http::Code::OK (200). Many MCP SDK clients inspect HTTP status before JSON-RPC","   //    decoding and will fail with a transport exception on non-200 responses, discarding the","-  //    structured JSON-RPC error code/message. The only exception is -32601 for stateless MCP","-  //    2026-07-28 requests, which MUST use 404 Not Found (see below).","+  //    structured JSON-RPC error code/message. The only exceptions are stateless MCP 2026-07-28","+  //    requests, which MUST use 404 Not Found for -32601 (see below) and 400 Bad Request for","+  //    -32602 when required params._meta fields are missing or invalid.","   // 2. Only use non-200 HTTP codes (400, 401, 403, 404, 405, 413) in the following cases:","   //    - Transport-level or framing syntax failures (generated locally by this filter):","   //      * 405 Method Not Allowed (non-POST request)"],"additions":7,"deletions":5,"truncated":false},{"path":"test/extensions/filters/http/mcp/mcp_filter_integration_test.cc","lines":["@@ -304,6 +304,43 @@ name: envoy.filters.http.mcp","   EXPECT_EQ(nullptr, upstream_request_);"," }"," ","+TEST_P(McpFilterIntegrationTest, RejectsMissingProtocolVersionMeta) {","+  initializeFilter(R\"EOF(","+name: envoy.filters.http.mcp","+typed_config:","+  \"@type\": type.googleapis.com/envoy.extensions.filters.http.mcp.v3.Mcp","+  traffic_mode: REJECT_NO_MCP","+  max_supported_protocol_version: \"2026-07-28\"","+)EOF\");","+","+  codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+","+  const std::string request_body =","+      R\"({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tasks/get\",\"params\":{\"taskId\":\"task-123\"}})\";","+","+  auto response = codec_client_->makeRequestWithBody(","+      Http::TestRequestHeaderMapImpl{{\":method\", \"POST\"},","+                                     {\":path\", \"/\"},","+                                     {\":scheme\", \"http\"},","+                                     {\":authority\", \"host\"},","+                                     {\"accept\", \"application/json\"},","+                                     {\"accept\", \"text/event-stream\"},","+                                     {\"content-type\", \"application/json\"},","+                                     {\"mcp-protocol-version\", \"2026-07-28\"},","+                                     {\"mcp-method\", \"tasks/get\"},","+                                     {\"mcp-name\", \"task-123\"}},","+      request_body);","+","+  ASSERT_TRUE(response->waitForEndStream());","+","+  EXPECT_EQ(\"400\", response->headers().getStatusValue());","+  EXPECT_THAT(response->body(), testing::HasSubstr(\"\\\"code\\\":-32602\"));","+  EXPECT_THAT(respo