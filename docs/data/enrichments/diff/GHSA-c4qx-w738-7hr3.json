{"id":"GHSA-c4qx-w738-7hr3","axis":"advisories","repo":"ardatan/graphql-tools","sha":"19f5b3373fd7ace0688d19950fc529ce8347952a","parsed":{"files":[{"path":".changeset/codeql-proto-key-guard.md","lines":["@@ -0,0 +1,5 @@","+---","+'@graphql-tools/utils': patch","+---","+","+Compare incremental path keys to `__proto__` at the property access in `setObjectKeyPath`, in addition to the existing `isSafeObjectKey` check."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/utils/src/mergeIncrementalResult.ts","lines":["@@ -60,14 +60,22 @@ function setObjectKeyPath(obj: Record<string, any>, keyPath: readonly unknown[],","   let current = obj;","   let i: number;","   for (i = 0; i < keyPath.length - 1; i++) {","-    const key = keyPath[i] as string | number;","+    const key = keyPath[i];","+    // Direct comparison, not only isSafeObjectKey(): that helper already rejects","+    // this key, but the check has to sit on the value used as the property name.","+    if (key === '__proto__' || !isSafeObjectKey(key)) {","+      return;","+    }","     if (!hasOwnProperty(current, key) || current[key] == null) {","       // Determine if the next key is a number to create an array, otherwise create an object","       current[key] = typeof keyPath[i + 1] === 'number' ? [] : {};","     }","     current = current[key];","   }","-  const finalKey = keyPath[i] as string | number;","+  const finalKey = keyPath[i];","+  if (finalKey === '__proto__' || !isSafeObjectKey(finalKey)) {","+    return;","+  }","   const existingValue = hasOwnProperty(current, finalKey) ? current[finalKey] : undefined;","   current[finalKey] = existingValue != null ? mergeDeep([existingValue, value]) : value;"," }"],"additions":10,"deletions":2,"truncated":false},{"path":"packages/utils/tests/mergeIncrementalResult.spec.ts","lines":["@@ -225,6 +225,22 @@ describe('mergeIncrementalResult', () => {","     delete (Object.prototype as any).polluted;","   });"," ","+  it('rejects a plain-string __proto__ final segment', () => {","+    delete (Object.prototype as any).polluted;","+    const executionResult = { data: {} };","+    const incrementalResult = {","+      path: ['__proto__'],","+      data: { polluted: 'yes' },","+    };","+","+    mergeIncrementalResult({ incrementalResult, executionResult });","+","+    expect(({} as any).polluted).toBeUndefined();","+    expect(Object.getPrototypeOf(executionResult)).toBe(Object.prototype);","+    expect(executionResult).toEqual({ data: {} });","+    delete (Object.prototype as any).polluted;","+  });","+","   it('rejects object path segments that coerce via toString', () => {","     delete (Object.prototype as any).polluted;","     const executionResult = { data: {} };",""],"additions":16,"deletions":0,"truncated":false}],"additions":31,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-23T14:14:02.989893+00:00"}