{"id":"b3a483bc56749b476cb5012f20a37eb5fbc6481a","axis":"silent","repo":"vllm-project/vllm","sha":"b3a483bc56749b476cb5012f20a37eb5fbc6481a","parsed":{"files":[{"path":".buildkite/test_areas/models_basic.yaml","lines":["@@ -556,6 +556,7 @@ steps:","   - tests/models/test_alice_ai.py","   - tests/models/test_alice_ai_config.py","   - tests/models/test_indexer_logits_dtype_config.py","+  - tests/models/test_qwen3_5_slot.py","   - tests/models/test_beam_weight_mapping.py","   - tests/models/test_beam_numerics.py","   - tests/models/transformers/fusers/","@@ -590,6 +591,7 @@ steps:","       models/test_alice_ai.py","       models/test_alice_ai_config.py","       models/test_indexer_logits_dtype_config.py","+      models/test_qwen3_5_slot.py","       models/test_beam_weight_mapping.py","       models/test_beam_numerics.py","       models/test_cohere2_moe_parallel_block.py"],"additions":2,"deletions":0,"truncated":false},{"path":"docs/models/structured_decisions_models.md","lines":["@@ -13,6 +13,7 @@ used for classification and routing."," | `ClefFlashForJointSchema` | `ClefFlashStrategy` | `token_classify` | `JointSchemaHead` | `Cloudflare/clef-flash` |"," | `Gemma4ForCausalLM`       | `NextTokenStrategy` | `generate`       | N/A               | `google/gemma-4-E2B-it` |"," | `Qwen3ForCausalLM`        | `NextTokenStrategy` | `generate`       | N/A               | `Qwen/Qwen3-0.6B`, etc. |","+| `Qwen3_5ForSlotDecision`  | `SlotLMStrategy`    | `generate`       | LM head (fp32)    | `baselabs/mammoth-1`    |"," "," ### Multimodal Models"," ","@@ -393,3 +394,33 @@ vllm serve LiquidAI/d1-3B","   letters."," - When each request carries one question over a state that changes from","   request to request, `--disable-prefix-caching` lowers latency.","+","+### Mammoth-1 and Elephant-1","+","+Base Labs [`baselabs/mammoth-1`](https://huggingface.co/baselabs/mammoth-1)","+and [`baselabs/elephant-1`](https://huggingface.co/baselabs/elephant-1) are","+Qwen3.5 checkpoints whose `modeling_overrides` select `Qwen3_5ForSlotDecision`.","+","+```bash","+vllm serve baselabs/mammoth-1","+```","+","+- The full attention layers read the shared prefix and the question as two","+  bidirectional blocks, and each prompt is prefilled in one step. Chunked","+  prefill is therefore off for every request on the server, a","+  `--max-num-batched-tokens` below `--max-model-len` is raised to it, and a","+  smaller `--max-num-scheduled-tokens` is refused. `--max-model-len` defaults","+  to the trained 16,384 tokens.","+- Prefix caching (on by default) prefills the shared prefix once per decision","+  request instead of once per question. It needs FlashInfer's GatedDeltaNet","+  prefill (Hopper, or Blackwell with CUDA 13) and is turned off with other","+  backends.","+- A `choice` can have up to 255 options, labeled `A` to `Z` and then with","+  two-letter labels in the prompt. Media inputs return 400.","+- Only the `TRITON_ATTN` attention backend is supported, and it is selected","+  automatically. KV transfer connectors, `--kv-offloading-size`, speculative","+  decoding, context parallelism, micro-batching, `--prefix-match-unit` and","+  `--scheduler-cls` are refused.","+- `instructions` returns 400, as does any `chat_template_kwargs` other than","+  `{\"enable_thinking\": false}`. `/v1/decisions` reads every question as a","+  choice and returns 400 for score levels with the same label."],"additions":31,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes/tests.rs","lines":["@@ -5584,7 +5584,9 @@ async fn selected_logprobs_invalid_requests_return_client_errors() {","         };","         for invalid in [","             json!({\"logprob_token_ids\": [-1]}),","-            json!({\"logprob_token_ids\": vec![1; 129]}),","+            json!({","+                \"logprob_token_ids\": vec![1; vllm_text::SamplingLimits::MAX_LOGPROB_TOKEN_IDS + 1]","+            }),","             if chat_route {","                 json!({\"logprob_token_ids\": [1], \"logprobs\": false})","             } else {"],"additions":3,"deletions":1,"truncated":false},{"path":"rust/src/text/src/backend/mod.rs","lines":["@@ -94,7 +94,7 @@ impl SamplingLimits {","     pub const DEFAULT_MAX_LOGPROBS: i32 = 20;","     /// Original Python definition:","     /// <https://github.com/vllm-project/vllm/blob/b5adb027ad03c29b46181752ba3b1cb84eff1dd4/vllm/sampling_params.py#L30-L32>","-    pub const MAX_LOGPROB_TOKEN_IDS: usize = 128;","+    pub const MAX_LOGPROB_TOKEN_IDS: usize = 256;"," ","     /// Return the union bound used to validate token-ID prompts.","     pub fn prompt_token_vocab_size(&self) -> usize {"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/entrypoints/generate/structured_decisions/test_slot_decision_e2e.py","lines":["@@ -0,0 +1,139 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"/v1/systemone and /v1/decisions on Qwen3_5ForSlotDecision, served from the","+random four-layer checkpoint that test_block_bidirectional.py builds.\"\"\"","+","+import json","+","+import pytest","+import requests","+","+from tests.models.language.generation.test_block_bidirectional import (","+    build_tiny_checkpoint,","+)","+from tests.utils import RemoteOpenAIServer","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_cuda(), reason=\"block attention needs a CUDA GPU\"","+)","+","+MODEL_NAME = \"tiny-slot-decision\"","+# Long enough for the strategy to prefill the shared state once before the reads.","+STATE = {","+    \"ticket\": \"My card was charged twice for the same order. \" * 20,","+    \"customer\": {\"tenure_months\": 14, \"vip\": False},","+}","+QUESTIONS = {","+    \"refund\": {\"type\": \"noul\", \"instructions\": \"Is the customer asking for money?\"},","+    \"team\": {","+        \"type\": \"choice\",","+        \"instructions\": \"Which team should handle this?\",","+        \"criteria\": {\"billing\": \"charges\", \"technical\": \"bugs\", \"sales\": \"pricing\"},","+    },","+    \"mood\": {","+        \"type\": \"score\",","+        \"instructions\": \"How frustrated is the customer?\",","+        \"criteria\": [\"calm\", \"irritated\", \"angry\"],","+    },","+}","+","+","+@pytest.fixture(scope=\"module\")","+def server(tmp_path_factory):","+    checkpoint = str(tmp_path_factory.mktemp(\"slot-decision\"))","+    build_tiny_checkpoint(checkpoint)","+    args = [","+        \"--dtype\",","+        \"bfloat16\",","+        \"--served-model-name\",","+        MODEL_NAME,","+        \"--max-model-len\",","+        \"2048\",","+        \"--max-num-seqs\",","+        \"8\",","+        \"--enforce-eager\",","+        \"--gpu-memory-utilization\",","+        \"0.3\",","+        \"--limit-mm-per-prompt\",","+        json.dumps({\"image\": 0, \"video\": 0}),","+    ]","+    with RemoteOpenAIServer(checkpoint, args) as remote_server:","+        yield remote_server","+","+","+def systemone(server, **body):","+    return requests.post(","+        server.url_for(\"v1/systemone\"),","+        json={\"model\": MODEL_NAME, \"state\": STATE, \"questions\": QUESTIONS, **body},","+    )","+","+","+def check_probabilities(probabilities: dict[str, float], names: set[str]) -> None:","+    assert set(probabilities) == names","+    assert all(0.0 <= p <= 1.0 for p in probabilities.values())","+    assert sum(probabilities.values()) == pytest.approx(1.0, abs=1e-4)","+","+","+def test_systemone(server):","+    response = systemone(server)","+    assert response.status_code == 200, response.text","+    body = response.json()","+    assert body[\"object\"] == \"structured_decision\"","+    answers = body[\"answers\"]","+    assert list(answers) == list(QUESTIONS)","+","+    # The answers themselves are built by the question types, tested on CPU.","+    check_probabilities(answers[\"refund\"][\"probabilities\"], {\"yes\", \"no\"})","+    check_probabilities(","+        answers[\"team\"][\"probabilities\"], {\"billing\", \"technical\", \"sales\"}","+    )","+    check_probabilities(answers[\"mood\"][\"probabilities\"], {\"0\", \"1\", \"2\"})","+    for qid in answers:","+        assert 0.0 < body[\"diagnostics\"][qid][\"label_mass\"] <= 1.0 + 1e-6","+    # One sampled token per question.","+    assert body[\"usage\"][\"output_tokens\"] == len(QUESTIONS)","+","+    # The repeat reads the state from the prefix cache.","+    again = systemone(server)","+    assert again.status_code == 200, again.text","+    for qid, answer in again.json()[\"answers\"].items():","+        assert answer[\"probabilities\"] == pytest.approx(","+            answers[qid][\"probabilities\"], abs=1e-2","+        )","+","+","+@pytest.mark.parametrize(","+    \"extra,match\",","+    [","+        ({\"images\": [\"data:image/png;base64,AAAA\"]}, \"does not take image inputs\"),","+        ({\"instructions\": \"Be strict.\"}, \"takes no instructions\"),","+    ],","+)","+def test_systemone_refusals(server, extra, match):","+    response = systemone(server, **extra)","+    assert response.status_code == 400","+    assert match in response.json()[\"error\"][\"message\"]","+","+","+def test_decisions(server):","+    response = requests.post(","+        server.url_for(\"v1/decisions\"),","+        json={","+            \"model\": MODEL_NAME,","+            \"input\": \"The package arrived with a broken screen.\",","+            \"questions\": [","+                {\"type\": \"predicate\", \"instructions\": \"Is the screen broken?\"},","+                {","+                    \"type\": \"choice\",","+                    \"instructions\": \"Which department should handle this?\",","+                    \"choices\": [{\"value\": \"returns\"}, {\"value\": \"billing\"}],","+                },","+            ],","+        },","+    )","+    assert response.status_code == 200, response.text","+    predicate, choice = response.json()[\"answers\"]","+    assert 0.0 <= predicate[\"probability\"] <= 1.0","+    probabilities = {p[\"value\"]: p[\"probability\"] for p in choice[\"probabilities\"]}","+    check_probabilities(probabilities, {\"returns\", \"billing\"})"],"additions":139,"deletions":0,"truncated":false},{"path":"tests/entrypoints/generate/structured_decisions/test_slot_strategy.py","lines":["@@ -0,0 +1,237 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"SlotLMStrategy prompts and reads, against prompts rendered by qev, the","+checkpoints' reference runtime (`qev.engine.DecisionEngine`, installed by their","+`setup.sh`).\"\"\"","+","+import math","+from types import SimpleNamespace","+from unittest.mock import MagicMock","+","+import pytest","+import torch","+","+from vllm.engine.protocol import EngineClient","+from vllm.entrypoints.generate.structured_decisions.protocol import (","+    StructuredDecisionRequest,","+)","+from vllm.entrypoints.generate.structured_decisions.serving import parse_questions","+from vllm.entrypoints.openai.decisions import slot_prompt","+from vllm.entrypoints.openai.decisions.adapters import make_read_question","+from vllm.entrypoints.openai.decisions.protocol import ScoreQuestion","+from vllm.entrypoints.openai.decisions.question_types import StructuredDecisionError","+from vllm.entrypoints.openai.decisions.strategies import (","+    ReadContext,","+    SlotLMStrategy,","+)","+from vllm.logprobs import Logprob","+from vllm.tokenizers import get_tokenizer","+from vllm.v1.core.sched.prefix_lm_scheduler import prefix_lm_salt","+","+pytestmark = [pytest.mark.cpu_test, pytest.mark.skip_global_cleanup]","+","+#: The state and questions qev's DecisionEngine probes at load.","+PROBE_STATE = {","+    \"ticket\": \"My card was charged twice for the same order and support has \"","+    \"not replied in 3 days.\",","+    \"customer\": {\"tenure_months\": 14, \"vip\": False},","+}","+PROBE_QUESTIONS = {","+    \"a\": {\"type\": \"noul\", \"instructions\": \"Is the customer asking for money back?\"},","+    \"b\": {","+        \"type\": \"choice\",","+        \"instructions\": \"Which team should handle this?\",","+        \"criteria\": {","+            \"billing\": \"charges and refunds\",","+            \"technical\": \"bugs\",","+            \"sales\": \"pricing\",","+        },","+    },","+    \"c\": {","+        \"type\": \"score\",","+        \"instructions\": \"How frustrated is the customer?\",","+        \"criteria\": [\"calm\", \"irritated\", \"angry\"],","+    },","+}","+","+_PREFIX = (","+    \"<|im_start|>system\\nApply the question to the state. Choose exactly one of \"","+    \"the listed options. Respond with only its uppercase letter, with no \"","+    \"explanation or reasoning.<|im_end|>\\n<|im_start|>user\\n<state>\\n{\\n\"","+    '  \"ticket\": \"My card was charged twice for the same order and support has '","+    'not replied in 3 days.\",\\n  \"customer\": {\\n    \"tenure_months\": 14,\\n'","+    '    \"vip\": false\\n  }\\n}\\n</state>\\n\\n'","+)","+_TAIL = \"<|im_end|>\\n<|im_start|>assistant\\n<think>\\n\\n</think>\\n\\n\"","+#: qev's prompts for PROBE_QUESTIONS.","+QEV_PROMPTS = {","+    \"a\": _PREFIX + \"Question: Is the customer asking for money back?\\n\\nOptions:\\n\"","+    \"A. yes: the statement is true / the answer is yes\\n\"","+    \"B. no: the statement is false / the answer is no\\n\\n\"","+    \"Answer with one letter: A, B.\" + _TAIL,","+    \"b\": _PREFIX + \"Question: Which team should handle this?\\n\\nOptions:\\n\"","+    \"A. billing: charges and refunds\\nB. technical: bugs\\nC. sales: pricing\"","+    \"\\n\\nAnswer with one letter: A, B, C.\" + _TAIL,","+    \"c\": _PREFIX + \"Rate the state: How frustrated is the customer?\\n\\nOptions:\\n\"","+    \"A. level 0: calm\\nB. level 1: irritated\\nC. level 2: angry\\n\\n\"","+    \"Answer with one letter: A, B, C.\" + _TAIL,","+}","+#: qev's shared prefix for PROBE_STATE, ending in `</`, `state`, `>`, `ĊĊ`.","+QEV_PREFIX_LEN = 99","+","+","+@pytest.fixture(scope=\"module\")","+def tokenizer():","+    return get_tokenizer(\"baselabs/elephant-1\")","+","+","+def make_strategy(tokenizer, *, head_dtype=torch.float32, prefix_caching=False):","+    model_config = SimpleNamespace(","+        hf_config=SimpleNamespace(modeling_overrides={}),","+        head_dtype=head_dtype,","+        max_model_len=32768,","+        is_hybrid=True,","+        supports_multimodal_inputs=True,","+    )","+    engine = MagicMock(spec=EngineClient)","+    engine.model_config = model_config","+    engine.vllm_config = SimpleNamespace(","+        cache_config=SimpleNamespace(enable_prefix_caching=prefix_caching)","+    )","+","+    async def generate(prompt, params, request_id, **kwargs):","+        ids = params.logprob_token_ids or [0]","+        # The first slot gets twice the weight of each other slot.","+        logprobs = {t: Logprob(-2.0 + math.log(2) * (t == ids[0])) for t in ids}","+        out = SimpleNamespace(token_ids=ids[:1], logprobs=[logprobs], finish_reason=\"\")","+        yield SimpleNamespace(","+            outputs=[out],","+            prompt_token_ids=prompt[\"prompt_token_ids\"],","+            num_cached_tokens=0,","+            num_cache_creation_tokens=0,","+        )","+","+    engine.generate.side_effect = generate","+    renderer = SimpleNamespace(get_tokenizer=lambda: tokenizer)","+    context = ReadContext(engine, SimpleNamespace(renderer=renderer), None, \"auto\", {})","+    return SlotLMStrategy(context), engine","+","+","+async def read(strategy, request: StructuredDecisionRequest):","+    questions = parse_questions(request, strategy.limits())","+    reads = await strategy.read(","+        questions,","+        request.instructions,","+        strategy.render_state(request.state),","+        request_id=\"r\",","+        chat_template_kwargs=request.chat_template_kwargs,","+        lora_request=None,","+        priority=0,","+        cache_salt=request.cache_salt,","+    )","+    return questions, reads","+","+","+@pytest.mark.asyncio","+async def test_reads_match_qev_byte_for_byte(tokenizer):","+    strategy, engine = make_strategy(tokenizer)","+    # The Qwen3.5 base model takes images, but read() renders none.","+    assert strategy.modalities == frozenset()","+    request = StructuredDecisionRequest(","+        state=PROBE_STATE, questions=PROBE_QUESTIONS, cache_salt=\"salt\"","+    )","+    questions, reads = await read(strategy, request)","+","+    for q, call in zip(questions, engine.generate.call_args_list, strict=True):","+        prompt, params = call.args[0], call.args[1]","+        ids = tokenizer.encode(QEV_PROMPTS[q.id], add_special_tokens=False)","+        assert prompt[\"prompt_token_ids\"] == ids","+        # The prefix's digest, then the caller's salt.","+        assert prompt[\"cache_salt\"] == prefix_lm_salt(ids[:QEV_PREFIX_LEN], \"salt\")","+        assert params.extra_args == {\"prefix_lm_len\": QEV_PREFIX_LEN}","+        assert params.logprob_token_ids == strategy.slot_ids[: len(q.options)]","+","+    # Slot A, the first option, has twice the weight of each other slot.","+    assert reads[2].probs == pytest.approx([0.5, 0.25, 0.25])","+","+","+@pytest.mark.asyncio","+async def test_prefix_ends_at_the_state_block(tokenizer):","+    strategy, engine = make_strategy(tokenizer, prefix_caching=True)","+    # Both questions start with \"Question:\", so the token LCP runs past the","+    # state block. A long state makes the strategy warm the prefix first.","+    questions = {k: PROBE_QUESTIONS[k] for k in \"ab\"}","+    request = StructuredDecisionRequest(state=\"word \" * 200, questions=questions)","+    await read(strategy, request)","+    warm_up, *calls = engine.generate.call_args_list","+    prefix = warm_up.args[0][\"prompt_token_ids\"]","+    assert tokenizer.decode(prefix).endswith(\"</state>\\n\\n\")","+    salt = prefix_lm_salt(prefix, None)","+    for call in (warm_up, *calls):","+        assert call.args[0][\"prompt_token_ids\"][: len(prefix)] == prefix","+        assert call.args[1].extra_args == {\"prefix_lm_len\": len(prefix)}","+        assert call.args[0][\"cache_salt\"] == salt","+","+","+@pytest.mark.asyncio","+async def test_many_options_use_two_letter_slots(tokenizer):","+    strategy, engine = make_strategy(tokenizer)","+    assert strategy.limits().max_options == 255","+    criteria = {f\"option {i}\": {\"id\": i} if i % 2 else None for i in range(255)}","+    questions = {\"many\": {\"type\": \"choice\", \"criteria\": criteria}}","+    request = StructuredDecisionRequest(state=\"plain text\", questions=questions)","+    await read(strategy, request)","+    prompt, params = engine.generate.call_args.args[:2]","+    text = tokenizer.decode(prompt[\"prompt_token_ids\"])","+    assert \"<state>\\nplain text\\n</state>\\n\\nQuestion: Which option applies\" in text","+    assert '\\nAA. option 26\\nAB. option 27: {\\n  \"id\": 27\\n}\\n' in text","+    assert \"Answer with one label: A, B, C,\" in text","+    assert len(params.logprob_token_ids) == 255","+    assert len(set(strategy.slot_ids)) == 256","+    assert slot_prompt.SLOT_LABELS[-1] == \"JU\"","+","+","+def test_refuses_to_start_without_fp32_head(tokenizer):","+    with pytest.raises(ValueError, match=\"fp32 LM head\"):","+        make_strategy(tokenizer, head_dtype=torch.bfloat16)","+","+","+@pytest.mark.asyncio","+@pytest.mark.parametrize(","+    \"extra\",","+    [","+        {\"instructions\": \"Be strict.\"},","+        {\"chat_template_kwargs\": {\"enable_thinking\": True}},","+        # A score has at most 10 levels, as in training.","+        {\"questions\": {\"s\": {\"type\": \"score\", \"criteria\": list(\"0123456789X\")}}},","+    ],","+)","+async def test_refuses_untrained_prompt_options(tokenizer, extra):","+    strategy, engine = make_strategy(tokenizer)","+    request = StructuredDecisionRequest(","+        **{\"state\": PROBE_STATE, \"questions\": PROBE_QUESTIONS, **extra}","+    )","+    with pytest.raises(StructuredDecisionError):","+        await read(strategy, request)","+    engine.generate.assert_not_called()","+","+","+def test_decisions_api_refuses_duplicate_labels(tokenizer):","+    strategy, _ = make_strategy(tokenizer)","+    levels = [{\"label\": \"low\"}, {\"label\": \"high\"}, {\"label\": \"low\"}]","+    question = ScoreQuestion(type=\"score\", instructions=\"How urgent?\", levels=levels)","+    with pytest.raises(StructuredDecisionError, match=\"distinct\"):","+        strategy._suffix(make_read_question(0, question))","+","+","+@pytest.mark.asyncio","+async def test_refuses_a_prompt_without_room_for_the_answer(tokenizer):","+    strategy, engine = make_strategy(tokenizer)","+    ids = tokenizer.encode(QEV_PROMPTS[\"a\"], add_special_tokens=False)","+    # The engine refuses a generate prompt of max_model_len tokens.","+    strategy.max_model_len = len(ids)","+    questions = {\"a\": PROBE_QUESTIONS[\"a\"]}","+    request = StructuredDecisionRequest(state=PROBE_STATE, questions=questions)","+    with pytest.raises(StructuredDecisionError, match=\"max_model_len\"):","+        await read(strategy, request)","+    engine.generate.assert_not_called()"],"additions":237,"deletions":0,"truncated":false},{"path":"tests/models/language/generation/test_block_bidirectional.py","lines":["@@ -0,0 +1,166 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Qwen3_5ForSlotDecision's block attention against the transformers block mask,","+on a random four-layer model built from BLOCK_ATTN_BASE.\"\"\"","+","+import os","+from functools import partial","+","+import pytest","+import torch","+","+from tests.models.test_qwen3_5_slot import OVERRIDES","+from vllm.platforms import current_platform","+","+BASE = os.environ.get(\"BLOCK_ATTN_BASE\", \"baselabs/elephant-1\")","+NUM_SCORED = 256","+# bf16 vLLM against an fp32 reference.","+ATOL = 0.1","+","+pytestmark = [","+    pytest.mark.hybrid_model,","+    pytest.mark.skipif(","+        not current_platform.is_cuda(), reason=\"block attention needs a CUDA GPU\"","+    ),","+]","+","+","+def build_tiny_checkpoint(path: str) -> None:","+    from transformers import AutoConfig, AutoProcessor, Qwen3_5ForConditionalGeneration","+","+    config = AutoConfig.from_pretrained(BASE)","+    config.text_config.update({","+        \"hidden_size\": 256, \"intermediate_size\": 512, \"num_hidden_layers\": 4,","+        \"layer_types\": [\"linear_attention\", \"full_attention\"] * 2,","+        \"num_attention_heads\": 4, \"num_key_value_heads\": 2,","+        \"linear_num_key_heads\": 2, \"linear_num_value_heads\": 2,","+        \"mtp_num_hidden_layers\": 0, \"dtype\": \"float32\",","+    })  # fmt: skip","+    config.vision_config.update({","+        \"depth\": 1, \"hidden_size\": 64, \"num_heads\": 2, \"intermediate_size\": 128,","+        \"out_hidden_size\": 256,","+    })  # fmt: skip","+    config.modeling_overrides = OVERRIDES","+    torch.manual_seed(0)","+    model = Qwen3_5ForConditionalGeneration(config).to(torch.float32)","+    # Sharper weights and stronger attention values/outputs make the mask move","+    # the last token's logits well above bf16 noise.","+    with torch.no_grad():","+        for name, param in model.named_parameters():","+            if param.dim() > 1:","+                strong = \"self_attn.v_proj\" in name or \"self_attn.o_proj\" in name","+                param.normal_(0.0, 0.32 if strong else 0.08)","+    model.save_pretrained(path)","+    AutoProcessor.from_pretrained(BASE).save_pretrained(path)","+","+","+def hf_logprobs(path: str, prompts: dict, prefix_len: int) -> list[dict]:","+    \"\"\"Last-position logprobs over the first NUM_SCORED tokens of each prompt,","+    with the prefix and the rest as two blocks, then causal.\"\"\"","+    from transformers import Qwen3_5ForConditionalGeneration","+    from transformers.models.qwen3_5 import modeling_qwen3_5 as hf","+","+    model = Qwen3_5ForConditionalGeneration.from_pretrained(","+        path, dtype=torch.float32, attn_implementation=\"sdpa\"","+    ).to(\"cuda\")","+    mask = hf.create_causal_mask","+","+    def run(prompt: list[int], blocked: bool) -> torch.Tensor:","+        ids = (torch.arange(len(prompt), device=\"cuda\") >= prefix_len).long()[None]","+        patched = partial(mask, block_sequence_ids=ids if blocked else None)","+        monkeypatch.setattr(hf, \"create_causal_mask\", patched)","+        with torch.inference_mode():","+            logits = model(input_ids=torch.tensor([prompt], device=\"cuda\")).logits","+        return torch.log_softmax(logits[0, -1].float(), -1)[:NUM_SCORED].cpu()","+","+    with pytest.MonkeyPatch.context() as monkeypatch:","+        return [{q: run(p, b) for q, p in prompts.items()} for b in (True, False)]","+","+","+@pytest.mark.parametrize(\"enforce_eager\", [True, False])","+def test_block_attention_matches_transformers(vllm_runner, tmp_path, enforce_eager):","+    from vllm import SamplingParams","+    from vllm.inputs import TokensPrompt","+","+    checkpoint = str(tmp_path)","+    build_tiny_checkpoint(checkpoint)","+    g = torch.Generator().manual_seed(1)","+","+    def tokens(n: int) -> list[int]:","+        return torch.randint(1000, 100000, (n,), generator=g).tolist()","+","+    # A long shared prefix, then three questions.","+    prefix = tokens(700)","+    shared = tokens(40)","+    questions = {","+        \"q0\": prefix + tokens(90),","+        \"q1\": prefix + shared + tokens(50),","+        \"q2\": prefix + shared + tokens(50),","+    }","+    p = len(prefix)","+    expected, causal = hf_logprobs(checkpoint, questions, p)","+    torch.accelerator.empty_cache()","+    for q in questions:","+        # The mask must matter, or the comparison proves nothing.","+        assert (causal[q] - expected[q]).abs().max() > 5 * ATOL, q","+","+    def params(prefix_len: int | None) -> SamplingParams:","+        return SamplingParams(","+            max_tokens=1,","+            temperature=0.0,","+            logprob_token_ids=list(range(NUM_SCORED)),","+            extra_args=None if prefix_len is None else {\"prefix_lm_len\": prefix_len},","+        )","+","+    # Room for every prompt in one step, so the reads share a batch.","+    with vllm_runner(","+        checkpoint,","+        dtype=\"bfloat16\",","+        max_model_len=2048,","+        max_num_batched_tokens=4096,","+        enable_prefix_caching=True,","+        enforce_eager=enforce_eager,","+        gpu_memory_utilization=0.4,","+        limit_mm_per_prompt={\"image\": 0, \"video\": 0},","+    ) as runner:","+        llm = runner.llm","+        vllm_config = llm.llm_engine.vllm_config","+        assert vllm_config.model_config.head_dtype == torch.float32","+        # Prefix caching stays on with FlashInfer's GDN prefill only.","+        prefix_caching = vllm_config.cache_config.enable_prefix_caching","+        if prefix_caching:","+            scheduler_cls = vllm_config.scheduler_config.scheduler_cls","+            assert scheduler_cls.startswith(\"vllm.v1.core.sched.prefix_lm_scheduler.\")","+","+        # The three questions with their blocks, then q0 without a prefix length,","+        # which is read causally.","+        outputs = llm.generate(","+            [TokensPrompt(prompt_token_ids=questions[q]) for q in [*questions, \"q0\"]],","+            [params(p)] * len(questions) + [params(None)],","+            use_tqdm=False,","+        )","+        references = [*expected.values(), causal[\"q0\"]]","+","+        def check(name: str, out, reference) -> None:","+            logprobs = out.outputs[0].logprobs[0]","+            got = torch.tensor([logprobs[t].logprob for t in range(NUM_SCORED)])","+            error = (got - reference).abs().max().item()","+            assert error < ATOL, (name, error)","+","+        for args in zip([*questions, \"q0 causal\"], outputs, references):","+            check(*args)","+","+        if not prefix_caching:","+            return","+        # The prefix alone, as the strategy's warm-up sends it. The questions","+        # then reuse its cache, and never past it: q1 and q2 share 40 more","+        # tokens, and q2 comes twice.","+        llm.generate(TokensPrompt(prompt_token_ids=prefix), params(p), use_tqdm=False)","+        for name in (\"q1\", \"q2\", \"q2\"):","+            (out,) = llm.generate(","+                TokensPrompt(prompt_token_ids=questions[name]),","+                params(p),","+                use_tqdm=False,","+            )","+            check(f\"{name} cached\", out, expected[name])","+            assert 0 < (out.num_cached_tokens or 0) <= p, out.num_cached_tokens"],"additions":166,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -1333,6 +1333,11 @@ def check_available_online(","         \"Qwen/Qwen3.5-35B-A3B\",","         max_model_len=4096,","     ),","+    \"Qwen3_5ForSlotDecision\": _HfExamplesInfo(","+        \"baselabs/elephant-1\",","+        extras={\"mammoth\": \"baselabs/mammoth-1\"},","+        max_model_len=4096,","+    ),","     \"Qwen4ExpForConditionalGeneration\": _HfExamplesInfo(","         \"\",","         is_available_online=False,"],"additions":5,"deletions":0,"truncated":false},{"path":"tests/models/test_qwen3_5_slot.py","lines":["@@ -0,0 +1,237 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+from types import SimpleNamespace","+","+import numpy as np","+import pytest","+import torch","+from transformers.models.qwen3_5 import Qwen3_5Config","+","+from vllm.config import VllmConfig","+from vllm.engine.arg_utils import EngineArgs","+from vllm.model_executor.layers.mamba.gdn import qwen_gdn_linear_attn","+from vllm.model_executor.models.qwen3_5_slot import Qwen3_5SlotDecisionModelState","+from vllm.sampling_params import SamplingParams","+from vllm.v1.attention.backends.registry import AttentionBackendEnum","+from vllm.v1.core.sched.prefix_lm_scheduler import PREFIX_LM_LEN","+from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridModelState","+","+pytestmark = pytest.mark.cpu_test","+","+PREFIX_LM = \"vllm.v1.core.sched.prefix_lm_scheduler.PrefixLM\"","+TRITON, FLASH = AttentionBackendEnum.TRITON_ATTN, AttentionBackendEnum.FLASH_ATTN","+","+OVERRIDES = {","+    \"attention\": {","+        \"full_attention\": \"block_bidirectional\",","+        \"linear_attention\": \"causal\",","+    },","+    \"readout\": \"slot_lm\",","+    \"head_dim\": 256,","+    \"n_slots\": 256,","+}","+","+","+@pytest.fixture(autouse=True)","+def gdn_prefill_backend(monkeypatch):","+    \"\"\"Report FlashInfer's GDN prefill, which this CPU host lacks, unless a test","+    names another backend.\"\"\"","+    backend = {\"name\": \"flashinfer\"}","+    monkeypatch.setattr(","+        qwen_gdn_linear_attn,","+        \"_resolve_gdn_prefill_backend\",","+        lambda vllm_config: (\"auto\", backend[\"name\"]),","+    )","+    return backend","+","+","+def make_vllm_config(","+    tmp_path, overrides=OVERRIDES, head_dtype=None, **engine_args","+) -> VllmConfig:","+    \"\"\"The engine config of a checkpoint with only a config.json.\"\"\"","+    Qwen3_5Config(","+        architectures=[\"Qwen3_5ForConditionalGeneration\"],","+        modeling_overrides=overrides,","+        head_dtype=head_dtype,","+        # As in the checkpoints, far above the trained length.","+        text_config={\"max_position_embeddings\": 262144},","+    ).save_pretrained(tmp_path)","+    return EngineArgs(","+        model=str(tmp_path), skip_tokenizer_init=True, **engine_args","+    ).create_engine_config()","+","+","+@pytest.mark.parametrize(\"head_dtype,fp32\", [(None, True), (\"model\", False)])","+def test_detected_with_an_fp32_head_by_default(tmp_path, head_dtype, fp32):","+    model_config = make_vllm_config(tmp_path, head_dtype=head_dtype).model_config","+    assert model_config.architecture == \"Qwen3_5ForSlotDecision\"","+    assert (model_config.head_dtype == torch.float32) == fp32","+","+","+@pytest.mark.parametrize(\"max_model_len,expected\", [(None, 16384), (65536, 65536)])","+def test_model_config_defaults_to_the_trained_length(tmp_path, max_model_len, expected):"],"additions":72,"deletions":0,"truncated":false}],"additions":656,"deletions":2,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-18T16:50:50.675371+00:00"}