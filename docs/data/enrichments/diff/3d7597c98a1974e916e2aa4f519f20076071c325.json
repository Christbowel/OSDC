rketplace. Please contact your administrator.\"),"," \t\t\twhen: CONTEXT_EXTENSIONS_GALLERY_STATUS.isEqualTo(ExtensionGalleryManifestStatus.AccessDenied)"],"additions":6,"deletions":3,"truncated":false},{"path":"src/vs/workbench/services/extensionManagement/common/extensionGalleryAccount.ts","lines":["@@ -0,0 +1,57 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { Event } from '../../../../base/common/event.js';","+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';","+","+/** `accessToken` is only carried when the provider authenticates with a bearer. */","+export interface IExtensionGalleryAccount {","+\treadonly accessToken?: string;","+}","+","+export const enum ExtensionGalleryAccountStatus {","+\t/** None signed in, or several with no choice made. */","+\tSignedOut = 'signedOut',","+\tIneligible = 'ineligible',","+\tEligible = 'eligible',","+\t/** Could not be resolved — a transient auth failure, not a sign-out. */","+\tUnknown = 'unknown'","+}","+","+/**","+ * The authentication half of marketplace access. Implementations live in the Electron layer and","+ * are supplied through {@link IExtensionGalleryAccountService.setAccountProvider}, so the service","+ * itself never depends on authentication.","+ */","+export interface IExtensionGalleryAccountProvider {","+\treadonly accountStatus: ExtensionGalleryAccountStatus;","+\treadonly onDidChangeAccountStatus: Event<ExtensionGalleryAccountStatus>;","+\treadonly onDidChangeAccount: Event<void>;","+","+\t/** Never prompts. Check {@link accountStatus} for whether the account may actually be used. */","+\tgetAccount(): Promise<IExtensionGalleryAccount | undefined>;","+","+\t/** Interactive. The provider owns account selection and how the session is obtained. */","+\tsignIn(): Promise<void>;","+}","+","+export const IExtensionGalleryAccountService = createDecorator<IExtensionGalleryAccountService>('extensionGalleryAccountService');","+","+/** Identity and entitlement for the Private Marketplace. Knows nothing about URLs or HTTP. */","+export interface IExtensionGalleryAccountService {","+\treadonly _serviceBrand: undefined;","+","+\treadonly accountStatus: ExtensionGalleryAccountStatus;","+\treadonly onDidChangeAccountStatus: Event<ExtensionGalleryAccountStatus>;","+\treadonly onDidChangeAccount: Event<void>;","+","+\t/** Never prompts. Check {@link accountStatus} for whether the account may actually be used. */","+\tgetAccount(): Promise<IExtensionGalleryAccount | undefined>;","+","+\t/** Interactive sign-in for whichever provider the deployment configured. */","+\tsignIn(): Promise<void>;","+","+\tsetAccountProvider(provider: IExtensionGalleryAccountProvider): void;","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"src/vs/workbench/services/extensionManagement/electron-browser/extensionGalleryAccountService.ts","lines":["@@ -0,0 +1,370 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { IDefaultAccount } from '../../../../base/common/defaultAccount.js';","+import { Emitter, Event } from '../../../../base/common/event.js';","+import { Disposable, DisposableStore, MutableDisposable } from '../../../../base/common/lifecycle.js';","+import { getClaimsFromJWT } from '../../../../base/common/oauth.js';","+import { localize } from '../../../../nls.js';","+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';","+import { IDefaultAccountService } from '../../../../platform/defaultAccount/common/defaultAccount.js';","+import { ExtensionGalleryAuthProviderConfigKey } from '../../../../platform/extensionManagement/common/extensionGalleryManifest.js';","+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';","+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';","+import { ILogService } from '../../../../platform/log/common/log.js';","+import { IProductService } from '../../../../platform/product/common/productService.js';","+import { IQuickInputService, IQuickPickItem } from '../../../../platform/quickinput/common/quickInput.js';","+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';","+import { ITelemetryService } from '../../../../platform/telemetry/common/telemetry.js';","+import { AuthenticationSession, AuthenticationSessionAccount, IAuthenticationService } from '../../authentication/common/authentication.js';","+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';","+import { ExtensionGalleryAccountStatus, IExtensionGalleryAccount, IExtensionGalleryAccountProvider, IExtensionGalleryAccountService } from '../common/extensionGalleryAccount.js';","+","+/** The authentication provider that gates Private Marketplace access. */","+type ExtensionGalleryAccessProviderId = 'github' | 'microsoft';","+","+const PREFERRED_ACCOUNT_KEY = 'marketplace.account';","+","+// Well-known MSA (personal account) tenant ids. Duplicated from the microsoft-authentication","+// extension, which lives in the extension host and is not importable here.","+const MSA_TENANT_ID = '9188040d-6c67-4c5b-b112-36a304b66dad';","+const MSA_PASSTHROUGH_TENANT_ID = 'f8cdef31-a31e-4b4a-93e4-5f571e91255a';","+","+type MarketplaceAuthEvent = {","+\tauthProvider: string;","+\teligible: boolean;","+};","+","+type MarketplaceAuthClassification = {","+\tauthProvider: {","+\t\tclassification: 'SystemMetaData';","+\t\tpurpose: 'FeatureInsight';","+\t\tcomment: 'The auth provider used (github, microsoft).';","+\t};","+\teligible: {","+\t\tclassification: 'SystemMetaData';","+\t\tpurpose: 'FeatureInsight';","+\t\tisMeasurement: true;","+\t\tcomment: 'Whether the user was granted marketplace access.';","+\t};","+\towner: 'sandy081';","+\tcomment: 'Reports marketplace authentication results for enterprise marketplace access.';","+};","+","+/** The remembered account choice. `authProvider` scopes it so a provider switch ignores it. */","+interface IPreferredAccount {","+\treadonly authProvider: string;","+\treadonly id: string;","+}","+","+/** Status bookkeeping and eligibility reporting shared by the provider implementations. */","+abstract class AbstractGalleryAccountProvider extends Disposable implements IExtensionGalleryAccountProvider {","+","+\tprotected readonly _onDidChangeAccount = this._register(new Emitter<void>());","+\treadonly onDidChangeAccount: Event<void> = this._onDidChangeAccount.event;","+","+\tprivate _accountStatus = ExtensionGalleryAccountStatus.Unknown;","+\tget accountStatus(): ExtensionGalleryAccountStatus { return this._accountStatus; }","+\tprivate readonly _onDidChangeAccountStatus = this._register(new Emitter<ExtensionGalleryAccountStatus>());","+\treadonly onDidChangeAccountStatus: Event<ExtensionGalleryAccountStatus> = this._onDidChangeAccountStatus.event;","+","+\tconstructor(","+\t\tprotected readonly authProviderId: ExtensionGalleryAccessProviderId,","+\t\tprivate readonly telemetryService: ITelemetryService,","+\t\tprotected readonly logService: ILogService,","+\t) {","+\t\tsuper();","+\t}","+","+\tasync getAccount(): Promise<IExtensionGalleryAccount | undefined> {","+\t\ttry {","+\t\t\treturn await this.doGetAccount();","+\t\t} catch (error) {","+\t\t\t// Distinct from \"no account\" so the caller does not demand sign-in for a transient failure.","+\t\t\tthis.logService.error('[Marketplace] Unable to resolve the marketplace account', error);","+\t\t\tthis.setAccountStatus(ExtensionGalleryAccountStatus.Unknown);","+\t\t\treturn undefined;","+\t\t}","+\t}","+","+\tprotected abstract doGetAccount(): Promise<IExtensionGalleryAccount | undefined>;","+","+\tabstract signIn(): Promise<void>;","+","+\tprotected setAccountStatus(status: ExtensionGalleryAccountStatus): void {","+\t\tif (this._accountStatus !== status) {","+\t\t\tthis._accountStatus = status;","+\t\t\tthis._onDidChangeAccountStatus.fire(status);","+\t\t}","+\t}","+","+\tprotected reportEligibility(eligible: boolean): void {","+\t\tthis.telemetryService.publicLog2<MarketplaceAuthEvent, MarketplaceAuthClassification>('marketplace:auth:checked', {","+\t\t\tauthProvider: this.authProviderId,","+\t\t\teligible","+\t\t});","+\t}","+}","+","+/** Entitlement from the default account's SKU or enterprise flag. No bearer is carried. */","+export class GitHubGalleryAccountProvider extends AbstractGalleryAccountProvider {","+","+\tconstructor(","+\t\t@IDefaultAccountService private readonly defaultAccountService: IDefaultAccountService,","+\t\t@IProductService private readonly productService: IProductService,","+\t\t@ITelemetryService telemetryService: ITelemetryService,","+\t\t@ILogService logService: ILogService,","+\t) {","+\t\tsuper('github', telemetryService, logService);","+\t\tthis._register(this.defaultAccountService.onDidChangeDefaultAccount(() => this._onDidChangeAccount.fire()));","+\t}","+","+\tprotected override async doGetAccount(): Promise<IExtensionGalleryAccount | undefined> {","+\t\tconst account = await this.defaultAccountService.getDefaultAccount();","+\t\tif (!account) {","+\t\t\tthis.setAccountStatus(ExtensionGalleryAccountStatus.SignedOut);","+\t\t\treturn undefined;","+\t\t}","+\t\tconst eligible = this.checkAccess(account);","+\t\tthis.reportEligibility(eligible);","+\t\tthis.setAccountStatus(eligible ? ExtensionGalleryAccountStatus.Eligible : ExtensionGalleryAccountStatus.Ineligible);","+\t\t// A result is returned even when ineligible, so the caller can tell \"signed in but denied\"","+\t\t// apart from \"no account\" — the two map to different statuses.","+\t\treturn {};","+\t}","+","+\toverride async signIn(): Promise<void> {","+\t\tawait this.defaultAccountService.signIn();","+\t}","+","+\tprivate checkAccess(account: IDefaultAccount): boolean {","+\t\tthis.logService.debug('[Marketplace] Checking Account SKU access for configured gallery', account.entitlementsData?.access_type_sku);","+\t\tif (account.entitlementsData?.access_type_sku","+\t\t\t&& this.productService.extensionsGallery?.accessSKUs?.includes(account.entitlementsData.access_type_sku)) {","+\t\t\tthis.logService.debug('[Marketplace] Account has access to configured gallery');","+\t\t\treturn true;","+\t\t}","+\t\tthis.logService.debug('[Marketplace] Checking enterprise account access for configured gallery', account.enterprise);","+\t\treturn account.enterprise;","+\t}","+}","+","+/** Entitlement decided locally from the token's tenant claim. The bearer travels with it. */","+export class MicrosoftGalleryAccountProvider extends AbstractGalleryAccountProvider {","+","+\tconstructor(","+\t\t@IAuthenticationService private readonly authenticationService: IAuthenticationService,","+\t\t@IQuickInputService private readonly quickInputService: IQuickInputService,","+\t\t@IProductService private readonly productService: IProductService,","+\t\t@IStorageService private readonly storageService: IStorageService,","+\t\t@ITelemetryService telemetryService: ITelemetryService,","+\t\t@ILogService logService: ILogService,","+\t) {","+\t\tsuper('microsoft', telemetryService, logService);","+\t\tthis._register(this.authenticationService.onDidChangeSessions(e => {","+\t\t\tif (e.providerId === 'microsoft') {","+\t\t\t\tthis._onDidChangeAccount.fire();","+\t\t\t}","+\t\t}));","+\t}","+","+\t/**","+\t * Session lookup and interactive sign-in must request the same scopes, or the session created","+\t * by one is invisible to the other. Absent when the deployment did not configure them.","+\t */","+\tprivate get scopes(): string[] | undefined {","+\t\treturn this.productService.extensionsGallery?.accessScopes;","+\t}","+","+\tprotected override async doGetAccount(): Promise<IExtensionGalleryAccount | undefined> {","+\t\tconst session = await this.getSession();","+\t\tif (!session) {","+\t\t\tthis.setAccountStatus(ExtensionGalleryAccountStatus.SignedOut);","+\t\t\treturn undefined;","+\t\t}","+\t\tconst eligible = this.isEligible(session);","+\t\tthis.reportEligibility(eligible);","+\t\tthis.setAccountStatus(eligible ? ExtensionGalleryAccountStatus.Eligible : ExtensionGalleryAccountStatus.Ineligible);","+\t\t// The bearer is withheld when ineligible: that identity must never reach the marketplace.","+\t\treturn { accessToken: eligible ? session.accessToken : undefined };","+\t}","+","+\t/** Work/school tenant is eligible, personal is not. Fails closed on an unreadable token. */","+\tprivate isEligible(session: AuthenticationSession): boolean {","+\t\tconst rawToken = session.idToken ?? session.accessToken;","+\t\tlet tid: string | undefined;","+\t\ttry {","+\t\t\ttid = getClaimsFromJWT(rawToken).tid;","+\t\t} catch (error) {","+\t\t\tthis.logService.error('[Marketplace] Unable to decode the Microsoft token to determine account eligibility — treating as ineligible.', error);","+\t\t\treturn false;","+\t\t}","+\t\tif (!tid) {","+\t\t\treturn false;","+\t\t}","+\t\treturn tid !== MSA_TENANT_ID && tid !== MSA_PASSTHROUGH_TENANT_ID;","+\t}","+","+\t/**","+\t * Anchored to the remembered account rather than an arbitrary `sessions[0]`. Several accounts","+\t * with no preference returns `undefined` rather than guessing. Never prompts.","+\t */","+\tprivate async getSession(): Promise<AuthenticationSession | undefined> {","+\t\tconst scopes = this.scopes;","+\t\tif (!scopes) {","+\t\t\tthis.logService.error('[Marketplace] extensionsGallery.accessScopes is not configured — the Microsoft marketplace path cannot request a session.');","+\t\t\treturn undefined;","+\t\t}","+\t\tconst sessions = await this.authenticationService.getSessions('microsoft', scopes);","+\t\tif (sessions.length === 0) {","+\t\t\treturn undefined;","+\t\t}","+\t\tconst preferredId = this.readPreferredAccountId();","+\t\tif (preferredId) {","+\t\t\tconst remembered = sessions.find(session => session.account.id === preferredId);","+\t\t\t// Fall through rather than silently switching accounts.","+\t\t\tif (remembered) {","+\t\t\t\treturn remembered;","+\t\t\t}","+\t\t}","+\t\tif (sessions.length === 1) {","+\t\t\tthis.storePreferredAccountId(sessions[0].account.id);","+\t\t\treturn sessions[0];","+\t\t}","+\t\treturn undefined;","+\t}","+","+\toverride async signIn(): Promise<void> {","+\t\tconst scopes = this.scopes;","+\t\tif (!scopes) {","+\t\t\tthis.logService.error('[Marketplace] extensionsGallery.accessScopes is not configured — cannot sign in to the Microsoft marketplace path.');","+\t\t\treturn;","+\t\t}","+","+\t\t// Passing a known account binds to it without a fresh interactive login; omitting it falls","+\t\t// back to interactive sign-in, which is also how the user adds a different account.","+\t\tconst chooseAccount = async (account: AuthenticationSessionAccount | undefined): Promise<void> => {","+\t\t\t// Persist before creating the session so re-validation already sees the grounded account.","+\t\t\tif (account) {","+\t\t\t\tthis.storePreferredAccountId(account.id);","+\t\t\t}","+\t\t\tconst session = await this.authenticationService.createSession('microsoft', scopes, account ? { account } : undefined);","+\t\t\tthis.storePreferredAccountId(session.account.id);","+\t\t};","+","+\t\tconst accounts = await this.authenticationService.getAccounts('microsoft');","+\t\tif (accounts.length <= 1) {","+\t\t\tawait chooseAccount(accounts.at(0));","+\t\t\treturn;","+\t\t}","+","+\t\tinterface IAccountPickItem extends IQuickPickItem {","+\t\t\treadonly account?: AuthenticationSessionAccount;","+\t\t}","+\t\tconst picks: IAccountPickItem[] = accounts.map(account => ({ label: account.label, account }));","+\t\tpicks.push({ label: localize('marketplace.signInDifferentAccount', \"Sign in with a Different Account…\") });","+","+\t\tconst pick = await this.quickInputService.pick(picks, {","+\t\t\tplaceHolder: localize('marketplace.pickAccount', \"Select the account to use for the Extensions Marketplace\")","+\t\t});","+\t\tif (!pick) {","+\t\t\treturn; // cancelled","+\t\t}","+\t\tawait chooseAccount(pick.account);","+\t}","+","+\tprivate readPreferredAccountId(): string | undefined {","+\t\tconst raw = this.storageService.get(PREFERRED_ACCOUNT_KEY, StorageScope.APPLICATION);","+\t\tif (!raw) {","+\t\t\treturn undefined;","+\t\t}","+\t\tlet parsed: unknown;","+\t\ttry {","+\t\t\tparsed = JSON.parse(raw);","+\t\t} catch {","+\t\t\tthis.storageService.remove(PREFERRED_ACCOUNT_KEY, StorageScope.APPLICATION);","+\t\t\treturn undefined;","+\t\t}","+\t\tif (!parsed || typeof parsed !== 'object') {","+\t\t\treturn undefined;","+\t\t}","+\t\tconst candidate = parsed as Partial<IPreferredAccount>;","+\t\tif (candidate.authProvider !== this.authProviderId || typeof candidate.id !== 'string') {","+\t\t\treturn undefined;","+\t\t}","+\t\treturn candidate.id;","+\t}","+","+\tprivate storePreferredAccountId(accountId: string): void {","+\t\tconst preferred: IPreferredAccount = { authProvider: this.authProviderId, id: accountId };","+\t\tthis.storageService.store(PREFERRED_ACCOUNT_KEY, JSON.stringify(preferred), StorageScope.APPLICATION, StorageTarget.MACHINE);","+\t}","+}","+","+/**","+ * Forwards to whichever provider the deployment configured. Holds no authentication dependency of","+ * its own, so it can sit in the service graph that authentication itself depends on.","+ */","+export class ExtensionGalleryAccountService extends Disposable implements IExtensionGalleryAccountService {","+","+\tdeclare readonly _serviceBrand: undefined;","+","+\tprivate provider: IExtensionGalleryAccountProvider | undefined;","+\tprivate readonly providerListeners = this._register(new MutableDisposable<DisposableStore>());","+","+\tprivate readonly _onDidChangeAccount = this._register(new Emitter<void>());","+\treadonly onDidChangeAccount: Event<void> = this._onDidChangeAccount.event;","+","+\tprivate readonly _onDidChangeAccountStatus = this._register(new Emitter<ExtensionGalleryAccountStatus>());","+\treadonly onDidChangeAccountStatus: Event<ExtensionGalleryAccountStatus> = this._onDidChangeAccountStatus.event;","+","+\tget accountStatus(): ExtensionGalleryAccountStatus {","+\t\treturn this.provider?.accountStatus ?? ExtensionGalleryAccountStatus.Unknown;","+\t}","+","+\tsetAccountProvider(provider: IExtensionGalleryAccountProvider): void {","+\t\tthis.provider = provider;","+\t\tconst listeners = new DisposableStore();","+\t\tlisteners.add(provider.onDidChangeAccount(() => this._onDidChangeAccount.fire()));","+\t\tlisteners.add(provider.onDidChangeAccountStatus(status => this._onDidChangeAccountStatus.fire(status)));","+\t\tthis.providerListeners.value = listeners;","+\t\t// Anything that resolved before the provider arrived saw no account; let it try again.","+\t\tthis._onDidChangeAccount.fire();","+\t}","+","+\tasync getAccount(): Promise<IExtensionGalleryAccount | undefined> {","+\t\treturn this.provider?.getAccount();","+\t}","+","+\tasync signIn(): Promise<void> {","+\t\tawait this.provider?.signIn();","+\t}","+}","+","+registerSingleton(IExtensionGalleryAccountService, ExtensionGalleryAccountService, InstantiationType.Delayed);","+","+/**","+ * Creates the configured provider and hands it to the service. Lives outside the core service","+ * graph, so it can depend on authentication without forming the cycle the service must avoid.","+ */","+export class ExtensionGalleryAccountProviderContribution extends Disposable implements IWorkbenchContribution {","+","+\tstatic readonly ID = 'workbench.contrib.extensionGalleryAccountProvider';","+","+\tconstructor(","+\t\t@IConfigurationService configurationService: IConfigurationService,","+\t\t@IInstantiationService instantiationService: IInstantiationService,","+\t\t@IExtensionGalleryAccountService accountService: IExtensionGalleryAccountService,","+\t) {","+\t\tsuper();","+\t\tconst authProvider: ExtensionGalleryAccessProviderId = configurationService.getValue<string>(ExtensionGalleryAuthProviderConfigKey) === 'microsoft' ? 'microsoft' : 'github';","+\t\tconst provider = this._register(authProvider === 'microsoft'","+\t\t\t? instantiationService.createInstance(MicrosoftGalleryAccountProvider)","+\t\t\t: instantiationService.createInstance(GitHubGalleryAccountProvider));","+\t\taccountService.setAccountProvider(provider);","+\t}","+}","+","+registerWorkbenchContribution2(ExtensionGalleryAccountProviderContribution.ID, ExtensionGalleryAccountProviderContribution, WorkbenchPhase.BlockStartup);"],"additions":370,"deletions":0,"truncated":false},{"path":"src/vs/workbench/services/extensionManagement/electron-browser/extensionGalleryManifestService.ts","lines":["@@ -9,7 +9,7 @@ import { IHeaders } from '../../../../base/parts/request/common/request.js';"," import { localize } from '../../../../nls.js';"," import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';"," import { IEnvironmentService } from '../../../../platform/environment/common/environment.js';","-import { IExtensionGalleryManifestService, IExtensionGalleryManifest, ExtensionGalleryServiceUrlConfigKey, ExtensionGalleryManifestStatus } from '../../../../platform/extensionManagement/common/extensionGalleryManifest.js';","+import { IExtensionGalleryManifestService, IExtensionGalleryManifest, ExtensionGalleryServiceUrlConfigKey, ExtensionGalleryAuthProviderConfigKey, ExtensionGallery