yped values from configuration.","+/// </summary>","+/// <remarks>","+/// Provider packages compile this file as linked source.","+/// An absent or empty value leaves the caller's default in place, and an invalid value throws the same","+/// <see cref=\"InvalidOperationException\"/> message as <see cref=\"ConfigurationBinder\"/>.","+/// </remarks>","+internal static class ConfigurationValueParser","+{","+    /// <summary>","+    /// Parses the value at <paramref name=\"key\"/> using <see cref=\"CultureInfo.InvariantCulture\"/>.","+    /// </summary>","+    /// <returns><see langword=\"true\"/> when the key has a value; <see langword=\"false\"/> when it is absent or empty.</returns>","+    /// <exception cref=\"InvalidOperationException\">The configured value is not a valid <typeparamref name=\"T\"/>.</exception>","+    public static bool TryParseValue<T>(IConfiguration configuration, string key, [MaybeNullWhen(false)] out T value) where T : IParsable<T>","+    {","+        var text = configuration[key];","+        if (string.IsNullOrWhiteSpace(text))","+        {","+            value = default;","+            return false;","+        }","+","+        if (T.TryParse(text, CultureInfo.InvariantCulture, out value))","+        {","+            return true;","+        }","+","+        throw CreateInvalidValueException(configuration, key, typeof(T));","+    }","+","+    /// <summary>","+    /// Parses the <see cref=\"IPEndPoint\"/> value at <paramref name=\"key\"/>.","+    /// </summary>","+    /// <returns><see langword=\"true\"/> when the key has a value; <see langword=\"false\"/> when it is absent or empty.</returns>","+    /// <exception cref=\"InvalidOperationException\">The configured value is not a valid <see cref=\"IPEndPoint\"/>.</exception>","+    public static bool TryParseIPEndPoint(IConfiguration configuration, string key, [NotNullWhen(true)] out IPEndPoint? value)","+    {","+        var text = configuration[key];","+        if (string.IsNullOrWhiteSpace(text))","+        {","+            value = null;","+            return false;","+        }","+","+        if (IPEndPoint.TryParse(text, out value))","+        {","+            return true;","+        }","+","+        throw CreateInvalidValueException(configuration, key, typeof(IPEndPoint));","+    }","+","+    private static InvalidOperationException CreateInvalidValueException(IConfiguration configuration, string key, Type type)","+    {","+        var path = configuration is IConfigurationSection section ? ConfigurationPath.Combine(section.Path, key) : key;","+        return new InvalidOperationException($\"Failed to convert configuration value at '{path}' to type '{type}'.\");","+    }","+}"],"additions":68,"deletions":0,"truncated":false},{"path":"src/Orleans.Core/Core/DefaultClientServices.cs","lines":["@@ -185,7 +185,7 @@ private static void ApplyConfiguration(IClientBuilder builder)","             services.Configure<ClientMessagingOptions>(cfg.GetSection(\"Messaging\"));","             services.Configure<GatewayOptions>(cfg.GetSection(\"Gateway\"));"," ","-            if (bool.TryParse(cfg[\"EnableDistributedTracing\"], out var enableDistributedTracing) && enableDistributedTracing)","+            if (ConfigurationValueParser.TryParseValue<bool>(cfg, \"EnableDistributedTracing\", out var enableDistributedTracing) && enableDistributedTracing)","             {","                 builder.AddActivityPropagation();","             }"],"additions":1,"deletions":1,"truncated":false},{"path":"src/Orleans.Core/Messaging/StaticGatewayListProviderBuilder.cs","lines":["@@ -2,6 +2,7 @@"," using System.Net;"," using Microsoft.Extensions.Configuration;"," using Orleans;","+using Orleans.Configuration;"," using Orleans.Hosting;"," using Orleans.Providers;"," ","@@ -18,7 +19,7 @@ public void Configure(IClientBuilder builder, string? name, IConfigurationSectio","         var gatewaysSection = configurationSection.GetSection(\"Gateways\");","         foreach (var child in gatewaysSe