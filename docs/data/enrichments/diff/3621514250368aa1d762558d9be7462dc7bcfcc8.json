{"id":"3621514250368aa1d762558d9be7462dc7bcfcc8","axis":"silent","repo":"apache/struts","sha":"3621514250368aa1d762558d9be7462dc7bcfcc8","parsed":{"files":[{"path":"core/src/main/java/org/apache/struts2/config/ScopedConstantProvider.java","lines":["@@ -18,8 +18,10 @@","  */"," package org.apache.struts2.config;"," ","+import org.apache.struts2.config.entities.PackageConfig;","+"," /**","- * Resolves a scopable constant for the current action invocation: the package's {@code <scoped-constant>}, inherited","+ * Resolves a scopable constant for the current action invocation or a given package: the package's {@code <scoped-constant>}, inherited","  * through {@code extends}, or else the global constant.","  *","  * @since 7.5.0","@@ -32,4 +34,18 @@ public interface ScopedConstantProvider {","      * @throws IllegalArgumentException when {@code name} is not scopable","      */","     String getValue(String name);","+","+    /**","+     * @param name          a constant registered through a {@link ScopableConstants} bean","+     * @param packageConfig the package whose scoped constants, inherited ones included, take precedence; may be","+     *                      {@code null}","+     * @return the package's scoped value, or else {@link #getValue(String)}","+     * @throws IllegalArgumentException when {@code name} is not scopable; this default checks only on the","+     *                                  {@link #getValue(String)} fallback, as package values were validated at startup","+     * @since 7.5.0","+     */","+    default String getValue(String name, PackageConfig packageConfig) {","+        String value = packageConfig != null ? packageConfig.getAllScopedConstants().get(name) : null;","+        return value != null ? value : getValue(name);","+    }"," }"],"additions":17,"deletions":1,"truncated":false},{"path":"core/src/main/java/org/apache/struts2/config/providers/StrutsScopedConstantProvider.java","lines":["@@ -49,13 +49,29 @@ public void setContainer(Container container) {"," ","     @Override","     public String getValue(String name) {","+        requireScopable(name);","+        return resolve(name, currentPackage().orElse(null));","+    }","+","+    @Override","+    public String getValue(String name, PackageConfig packageConfig) {","+        if (packageConfig == null) {","+            return getValue(name);","+        }","+        requireScopable(name);","+        return resolve(name, packageConfig);","+    }","+","+    private void requireScopable(String name) {","         if (!scopableNames.contains(name)) {","             throw new IllegalArgumentException(String.format(","                     \"Constant [%s] is not scopable; register it through a %s bean\", name, ScopableConstants.class.getName()));","         }","-        return currentPackage()","-                .map(packageConfig -> packageConfig.getAllScopedConstants().get(name))","-                .orElseGet(() -> container.getInstance(String.class, name));","+    }","+","+    private String resolve(String name, PackageConfig packageConfig) {","+        String value = packageConfig != null ? packageConfig.getAllScopedConstants().get(name) : null;","+        return value != null ? value : container.getInstance(String.class, name);","     }"," ","     private Optional<PackageConfig> currentPackage() {"],"additions":19,"deletions":3,"truncated":false},{"path":"core/src/test/java/org/apache/struts2/config/providers/StrutsScopedConstantProviderTest.java","lines":["@@ -24,6 +24,7 @@"," import org.apache.struts2.config.ScopedConstantProvider;"," import org.apache.struts2.config.StrutsXmlConfigurationProvider;"," import org.apache.struts2.config.entities.ActionConfig;","+import org.apache.struts2.config.entities.PackageConfig;"," import org.apache.struts2.mock.MockActionInvocation;"," import org.apache.struts2.mock.MockActionProxy;"," ","@@ -121,6 +122,52 @@ public void testGlobalConstantUntouchedByScopedRead() {","         assertEquals(\"global\", container.getInstance(String.class, \"sample.scopable\"));","     }"," ","+    public void testExplicitPackageResolvesInheritedValue() {","+        assertEquals(\"base\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"child\")));","+    }","+","+    public void testExplicitPackageWinsOverInvocationPackage() {","+        enterPackage(\"override\");","+","+        assertEquals(\"base\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"child\")));","+    }","+","+    public void testExplicitPackageWithoutOverrideIgnoresInvocationPackage() {","+        enterPackage(\"override\");","+","+        assertEquals(\"global\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"plain\")));","+    }","+","+    public void testExplicitPackageWithoutOverrideGivesGlobalOutsideInvocation() {","+        assertEquals(\"global\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"plain\")));","+    }","+","+    public void testNullPackageFallsBackToInvocation() {","+        enterPackage(\"override\");","+","+        assertEquals(\"override\", provider.getValue(\"sample.scopable\", null));","+    }","+","+    public void testExplicitPackageEmptyOverrideIsReturnedAsIs() {","+        assertEquals(\"\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"empty\")));","+    }","+","+    public void testExplicitPackageRejectsUnregisteredName() {","+        PackageConfig plain = configuration.getPackageConfig(\"plain\");","+","+        assertThatThrownBy(() -> provider.getValue(\"sample.unknown\", plain))","+                .isInstanceOf(IllegalArgumentException.class)","+                .hasMessageContaining(\"[sample.unknown]\");","+    }","+","+    public void testLambdaProviderGetsPackageLookup() {","+        ScopedConstantProvider lambda = name -> \"fallback\";","+","+        assertEquals(\"base\", lambda.getValue(\"sample.scopable\", configuration.getPackageConfig(\"child\")));","+        assertEquals(\"fallback\", lambda.getValue(\"sample.scopable\", configuration.getPackageConfig(\"plain\")));","+        assertEquals(\"fallback\", lambda.getValue(\"sample.scopable\", null));","+    }","+","     private void enterPackage(String packageName) {","         MockActionProxy proxy = new MockActionProxy();","         proxy.setConfig(new ActionConfig.Builder(packageName, \"test\", ActionSupport.class.getName()).build());"],"additions":47,"deletions":0,"truncated":false},{"path":"docs/superpowers/plans/2026-10-14-WW-5770-scoped-convention-result-path.md","lines":["@@ -0,0 +1,986 @@","+# WW-5770 Scopable Convention Result Path Implementation Plan","+","+> **For agentic workers:** REQUIRED SUB-SKILL: Use superpowers:subagent-driven-development (recommended) or superpowers:executing-plans to implement this plan task-by-task. Steps use checkbox (`- [ ]`) syntax for tracking.","+","+**Goal:** Let `<scoped-constant name=\"struts.convention.result.path\">` on a parent package set the Convention","+result path for every action under it.","+","+**Architecture:** A `default` method `ScopedConstantProvider.getValue(name, PackageConfig)` resolves a constant","+against an explicit package. `ConventionsService` gains package-aware `default` overloads; `ConventionsServiceImpl`","+implements them with precedence `@ResultPath` → package scoped value → global. `DefaultResultMapBuilder` (startup)","+and `ConventionUnknownHandler` (runtime) pass the package they already hold.","+","+**Tech Stack:** Java 17, Struts container (`@Inject`), JUnit 4 + JUnit 3-style `TestCase`, EasyMock, AssertJ","+(core only — the Convention module has no AssertJ), `StrutsJUnit4TestCase` from `struts2-junit-plugin`.","+","+**Spec:** `docs/superpowers/specs/2026-10-14-WW-5770-scoped-convention-result-path-design.md`","+","+## Global Constraints","+","+- Fix version 7.5.0; new public API carries `@since 7.5.0`.","+- Tests are JUnit 3 or 4 — never Jupiter. Match the target file's style; an `@Test` in a `TestCase` subclass never runs.","+- `ScopedConstantProvider` must stay a functional interface (23 test sites stub it as `name -> ...`).","+- `ConventionsServiceImpl`'s constructor signature does not change.","+- No null guard on the injected `ScopedConstantProvider`; tests inject one.","+- No new comments beyond Javadoc on new public methods; match the file's density.","+- Commit messages: `WW-5770 <type>(<scope>): ...`, ending with `Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>`;","+  no session links.","+- Stage explicit paths only — never `git add -A`, never `git stash`.","+- Use `./mvnw` (there is no `mvn` on the PATH); log to a file and read Maven's exit code, not a grep of the output.","+","+## Review Focus","+","+1. **Override without a trailing slash** (`/WEB-INF/admin`) — must behave like the global constant does: a slash is","+   appended. Pinned in Task 3 (startup) and Task 4 (runtime).","+2. **Empty override** (`value=\"\"`) — must be used as-is, not fall back to the global path. Pinned in Task 2.","+3. **Package-level `@ResultPath` (`package-info.java`)** — must beat the scoped value just as the class-level one","+   does. Pinned in Task 2.","+4. **Action-less request when the default parent package has no override** — global path, unchanged from today.","+   Pinned in Task 4.","+5. **A custom `ConventionsService` that implements only the one-argument methods** — keeps its old behaviour.","+   Pinned in Task 2.","+","+---","+","+### Task 1: Package-aware lookup on `ScopedConstantProvider`","+","+**Files:**","+- Modify: `core/src/main/java/org/apache/struts2/config/ScopedConstantProvider.java`","+- Test: `core/src/test/java/org/apache/struts2/config/providers/StrutsScopedConstantProviderTest.java`","+","+**Interfaces:**","+- Produces: `default String getValue(String name, PackageConfig packageConfig)` on","+  `org.apache.struts2.config.ScopedConstantProvider` — the package's `getAllScopedConstants().get(name)` when","+  non-null, else `getValue(name)`; a `null` package goes straight to `getValue(name)`.","+","+- [ ] **Step 1: Write the failing tests**","+","+Append to `StrutsScopedConstantProviderTest` (JUnit 3 style, before `enterPackage`), and add imports","+`org.apache.struts2.config.entities.PackageConfig`:","+","+```java","+    public void testExplicitPackageResolvesInheritedValue() {","+        assertEquals(\"base\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"child\")));","+    }","+","+    public void testExplicitPackageWinsOverInvocationPackage() {","+        enterPackage(\"override\");","+","+        assertEquals(\"base\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"child\")));","+    }","+","+    public void testExplicitPackageWithoutOverrideFallsBackToInvocation() {","+        enterPackage(\"override\");","+","+        assertEquals(\"override\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"plain\")));","+    }","+","+    public void testExplicitPackageWithoutOverrideGivesGlobalOutsideInvocation() {","+        assertEquals(\"global\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"plain\")));","+    }","+","+    public void testNullPackageFallsBackToInvocation() {","+        enterPackage(\"override\");","+","+        assertEquals(\"override\", provider.getValue(\"sample.scopable\", null));","+    }","+","+    public void testExplicitPackageEmptyOverrideIsReturnedAsIs() {","+        assertEquals(\"\", provider.getValue(\"sample.scopable\", configuration.getPackageConfig(\"empty\")));","+    }","+","+    public void testExplicitPackageRejectsUnregisteredName() {","+        PackageConfig plain = configuration.getPackageConfig(\"plain\");","+","+        assertThatThrownBy(() -> provider.getValue(\"sample.unknown\", plain))","+                .isInstanceOf(IllegalArgumentException.class)","+                .hasMessageContaining(\"[sample.unknown]\");","+    }","+","+    public void testLambdaProviderGetsPackageLookup() {","+        ScopedConstantProvider lambda = name -> \"fallback\";","+","+        assertEquals(\"base\", lambda.getValue(\"sample.scopable\", configuration.getPackageConfig(\"child\")));","+        assertEquals(\"fallback\", lambda.getValue(\"sample.scopable\", configuration.getPackageConfig(\"plain\")));","+        assertEquals(\"fallback\", lambda.getValue(\"sample.scopable\", null));","+    }","+```","+","+- [ ] **Step 2: Run the tests to verify they fail**","+","+```bash","+./mvnw test -DskipAssembly -pl core -Dtest=StrutsScopedConstantProviderTest > /tmp/ww5770-t1.log 2>&1; echo \"exit=$?\"; grep -E \"ERROR|Tests run\" /tmp/ww5770-t1.log | head -20","+```","+Expected: non-zero exit, compilation error `method getValue in interface ScopedConstantProvider cannot be applied`.","+","+- [ ] **Step 3: Add the default method**","+","+In `ScopedConstantProvider.java` add the import `org.apache.struts2.config.entities.PackageConfig`, change the","+class Javadoc's first sentence to \"Resolves a scopable constant for the current action invocation or a given","+package:\" and add after `getValue(String name)`:","+","+```java","+    /**","+     * @param name          a constant registered through a {@link ScopableConstants} bean","+     * @param packageConfig the package whose scoped constants, inherited ones included, take precedence; may be","+     *                      {@code null}","+     * @return the package's scoped value, or else {@link #getValue(String)}","+     * @throws IllegalArgumentException when {@code name} is not scopable","+     * @since 7.5.0","+     */","+    default String getValue(String name, PackageConfig packageConfig) {","+        String value = packageConfig != null ? packageConfig.getAllScopedConstants().get(name) : null;","+        return value != null ? value : getValue(name);","+    }","+```","+","+- [ ] **Step 4: Run the tests to verify they pass**","+","+```bash","+./mvnw test -DskipAssembly -pl core -Dtest='StrutsScopedConstantProviderTest,ScopedConstantProviderWiringTest,StrutsJavaConfigurationProviderTest,ConstantConfigTest' > /tmp/ww5770-t1.log 2>&1; echo \"exit=$?\"; grep -E \"Tests run:|FAIL\" /tmp/ww5770-t1.log | tail -5","+```","+Expected: `exit=0`, no failures.","+","+- [ ] **Step 5: Install core so the Convention module compiles against it**","+","+```bash","+./mvnw install -DskipAssembly -DskipTests -pl core > /tmp/ww5770-install.log 2>&1; echo \"exit=$?\"","+```","+Expected: `exit=0`. Repeat this step whenever core changes again.","+","+- [ ] **Step 6: Commit**","+","+```bash","+git add core/src/main/java/org/apache/struts2/config/ScopedConstantProvider.java core/src/test/java/org/apache/struts2/config/providers/StrutsScopedConstantProviderTest.java","+git diff --cached --name-only","+git commit -m \"WW-5770 feat(core): resolve a scoped constant against an explicit package","+","+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\"","+```","+","+---","+","+### Task 2: Package-aware result path in `ConventionsService`","+","+**Files:**","+- Create: `plugins/convention/src/main/java/org/apache/struts2/convention/ConventionScopableConstants.java`","+- Modify: `plugins/convention/src/main/resources/struts-plugin.xml` (after the `ConventionsService` bean, line ~40)","+- Modify: `plugins/convention/src/main/java/org/apache/struts2/convention/ConventionsService.java`","+- Modify: `plugins/convention/src/main/java/org/apache/struts2/convention/ConventionsServiceImpl.java`","+- Create: `plugins/convention/src/test/java/org/apache/struts2/convention/ConventionsServiceImplTest.java`","+","+**Interfaces:**","+- Consumes: `ScopedConstantProvider.getValue(String, PackageConfig)` (Task 1).","+- Produces:","+  - `ConventionsService#determineResultPath(Class<?> actionClass, PackageConfig packageConfig)` — `default`, delegates to `determineResultPath(actionClass)`.","+  - `ConventionsService#determineResultPath(ActionConfig actionConfig, PackageConfig packageConfig)` — `default`, delegates to `determineResultPath(actionConfig)`.","+  - `ConventionsServiceImpl#setScopedConstantProvider(ScopedConstantProvider)` — `@Inject` setter.","+  - `ConventionScopableConstants` — `ScopableConstants` returning `Set.of(ConventionConstants.CONVENTION_RESULT_PATH)`.","+","+- [ ] **Step 1: Write the failing tests**","+","+Create `ConventionsServiceImplTest.java` with the ASF license header copied from `ConventionsServiceImpl.java`:","+","+```java","+package org.apache.struts2.convention;","+","+import org.apache.struts2.config.entities.ActionConfig;","+import org.apache.struts2.config.entities.PackageConfig;","+import org.apache.struts2.config.entities.ResultTypeConfig;","+import org.apache.struts2.convention.actions.NoAnnotationAction;","+import org.apache.struts2.convention.actions.resultpath.ClassLevelResultPathAction;","+import org.apache.struts2.convention.actions.resultpath.PackageLevelResultPathAction;","+import org.junit.Before;","+import org.junit.Test;","+","+import java.util.Collections;","+import java.util.Map;","+import java.util.Set;","+","+import static org.junit.Assert.assertEquals;","+import static org.junit.Assert.assertThrows;","+import static org.junit.Assert.assertTrue;","+","+public class ConventionsServiceImplTest {","+","+    private static final String GLOBAL = \"/WEB-INF/content/\";","+    private static final String SCOPED = \"/WEB-INF/admin/\";","+","+    private ConventionsServiceImpl service;","+    private PackageConfig scopedPackage;","+    private PackageConfig plainPackage;","+","+    @Before","+    public void setUp() {","+        service = new ConventionsServiceImpl(GLOBAL);","+        service.setScopedConstantProvider(name -> GLOBAL);","+        scopedPackage = childOf(SCOPED);","+        plainPackage = new PackageConfig.Builder(\"plain\").build();","+    }","+","+    @Test","+    public void scopedValueOfParentPackageWinsOverGlobal() {","+        assertEquals(SCOPED, service.determineResultPath(NoAnnotationAction.class, scopedPackage));","+    }","+","+    @Test","+    public void classLevelResultPathWinsOverScopedValue() {","+        assertEquals(\"/class-level\", service.determineResultPath(ClassLevelResultPathAction.class, scopedPackage));","+    }","+","+    @Test","+    public void packageLevelResultPathWinsOverScopedValue() {","+        assertEquals(\"/package-level\", service.determineResultPath(PackageLevelResultPathAction.class, scopedPackage));","+    }","+","+    @Test","+    public void packageWithoutScopedValueGivesGlobal() {","+        assertEquals(GLOBAL, service.determineResultPath(NoAnnotationAction.class, plainPackage));","+    }","+","+    @Test","+    public void emptyScopedValueIsUsedAsIs() {","+        assertEquals(\"\", service.determineResultPath(NoAnnotationAction.class, childOf(\"\")));","+    }","+","+    @Test","+    public void nullPackageGivesGlobalWithoutConsultingProvider() {","+        ConventionsServiceImpl withoutProvider = new ConventionsServiceImpl(GLOBAL);","+","+        assertEquals(GLOBAL, withoutProvider.determineResultPath(NoAnnotationAction.class, null));","+        assertEquals(GLOBAL, withoutProvider.determineResultPath(NoAnnotationAction.class));","+        assertEquals(GLOBAL, withoutProvider.determineResultPath((ActionConfig) null, null));","+        assertEquals(GLOBAL, withoutProvider.determineResultPath((ActionConfig) null));","+    }","+","+    @Test","+    public void actionlessRequestUsesScopedValueOfPackage() {","+        assertEquals(SCOPED, service.determineResultPath((ActionConfig) null, scopedPackage));","+    }","+","+    @Test","+    public void actionConfigResolvesThroughItsClass() {","+        ActionConfig annotated = actionConfig(ClassLevelResultPathAction.class.getName());","+        ActionConfig plain = actionConfig(NoAnnotationAction.class.getName());","+","+        assertEquals(\"/class-level\", service.determineResultPath(annotated, scopedPackage));","+        assertEquals(SCOPED, service.determineResultPath(plain, scopedPackage));","+    }","+","+    @Test","+    public void unknownActionClassStillFails() {","+        ActionConfig missing = actionConfig(\"com.example.MissingAction\");","+","+        RuntimeException e = assertThrows(RuntimeException.class,","+                () -> service.determineResultPath(missing, scopedPackage));","+        assertTrue(e.getMessage().contains(\"[com.example.MissingAction]\"));","+    }","+","+    @Test","+    public void customServiceWithOnlyOneArgumentMethodsKeepsItsBehaviour() {","+        ConventionsService custom = new ConventionsService() {","+            @Override","+            public String determineResultPath(Class<?> actionClass) {","+                return \"/custom/\";","+            }","+","+            @Override","+            public String determineResultPath(ActionConfig actionConfig) {","+                return \"/custom/\";","+            }","+","+            @Override","+            public Map<String, ResultTypeConfig> getResultTypesByExtension(PackageConfig packageConfig) {","+                return Collections.emptyMap();","+            }","+        };","+","+        assertEquals(\"/custom/\", custom.determineResultPath(NoAnnotationAction.class, scopedPackage));","+        assertEquals(\"/custom/\", custom.determineResultPath((ActionConfig) null, scopedPackage));","+    }","+","+    @Test","+    public void resultPathIsScopable() {","+        assertEquals(Set.of(ConventionConstants.CONVENTION_RESULT_PATH), new ConventionScopableConstants().getNames());","+    }","+","+    private static PackageConfig childOf(String scopedResultPath) {","+        PackageConfig parent = new PackageConfig.Builder(\"admin-base\")","+                .addScopedConstant(ConventionConstants.CONVENTION_RESULT_PATH, scopedResultPath)","+                .build();","+        return new PackageConfig.Builder(\"admin-base#/admin\").namespace(\"/admin\").addParent(parent).build();","+    }","+","+    private static ActionConfig actionConfig(String className) {","+        return new ActionConfig.Builder(\"admin-base#/admin\", \"foo\", className).build();","+    }","+}","+```","+","+- [ ] **Step 2: Run the tests to verify they fail**","+","+```bash","+./mvnw test -DskipAssembly -pl plugins/convention -Dtest=ConventionsServiceImplTest > /tmp/ww5770-t2.log 2>&1; echo \"exit=$?\"; grep -E \"ERROR|Tests run\" /tmp/ww5770-t2.log | head -20","+```","+Expected: non-zero exit, compilation errors for `setScopedConstantProvider`, `ConventionScopableConstants` and the","+two-argument `determineResultPath`.","+","+- [ ] **Step 3: Add `ConventionScopableConstants` and register it**","+","+Create `ConventionScopableConstants.java` (ASF header, same shape as","+`core/src/main/java/org/apache/struts2/components/StrutsUiScopableConstants.java`):","+","+```java","+package org.apache.struts2.convention;","+","+import org.apache.struts2.config.ScopableConstants;","+","+import java.util.Set;","+","+/**","+ * Lets a package override the Convention result path with {@code <scoped-constant>}.","+ *","+ * @since 7.5.0","+ */","+public class ConventionScopableConstants implements ScopableConstants {","+","+    @Override","+    public Set<String> getNames() {","+        return Set.of(ConventionConstants.CONVENTION_RESULT_PATH);","+    }","+}","+```","+","+In `struts-plugin.xml`, directly after the `ConventionsService` bean:","+","+```xml","+    <bean type=\"org.apache.struts2.config.ScopableConstants\" name=\"convention\"","+          class=\"org.apache.struts2.convention.ConventionScopableConstants\"/>","+```","+","+- [ ] **Step 4: Add the default methods to `ConventionsService`**","+","+After `String determineResultPath(ActionConfig actionConfig);`:","+","+```java","+    /**","+     * Locates the result location like {@link #determineResultPath(Class)}, using the package's scoped","+     * {@code struts.convention.result.path} when the action carries no {@code @ResultPath}.","+     *","+     * @param   actionClass The action class.","+     * @param   packageConfig The package the action belongs to, or null for the global default.","+     * @return  The result location.","+     * @since 7.5.0","+     */","+    default String determineResultPath(Class<?> actionClass, PackageConfig packageConfig) {","+        return determineResultPath(actionClass);","+    }","+","+    /**","+     * Locates the result location like {@link #determineResultPath(ActionConfig)}, using the package's scoped","+     * {@code struts.convention.result.path} when the action carries no {@code @ResultPath}.","+     *","+     * @param   actionConfig (Optional) The configuration for the action, or null when there is no action.","+     * @param   packageConfig The package whose scoped value applies, or null for the global default.","+     * @return  The result location.","+     * @since 7.5.0","+     */","+    default String determineResultPath(ActionConfig actionConfig, PackageConfig packageConfig) {","+        return determineResultPath(actionConfig);","+    }","+```","+","+- [ ] **Step 5: Implement them in `ConventionsServiceImpl`**","+","+Add imports `org.apache.struts2.config.ScopedConstantProvider`. Add the field and setter after the constructor:","+","+```java","+    private ScopedConstantProvider scopedConstantProvider;","+```","+(declare next to `private String resultPath;`)","+","+```java","+    @Inject","+    public void setScopedConstantProvider(ScopedConstantProvider scopedConstantProvider) {","+        this.scopedConstantProvider = scopedConstantProvider;","+    }","+```","+","+Replace both existing `determineResultPath` methods with:","+","+```java","+    /**","+     * {@inheritDoc}","+     */","+    public String determineResultPath(Class<?> actionClass) {","+        return determineResultPath(actionClass, null);","+    }","+","+    /**","+     * {@inheritDoc}","+     */","+    @Override","+    public String determineResultPath(Class<?> actionClass, PackageConfig packageConfig) {","+        String annotatedResultPath = findAnnotatedResultPath(actionClass);","+        return annotatedResultPath != null ? annotatedResultPath : scopedResultPath(packageConfig);","+    }","+","+    /**","+     * {@inheritDoc}","+     */","+    public String determineResultPath(ActionConfig actionConfig) {","+        return determineResultPath(actionConfig, null);","+    }","+","+    /**","+     * {@inheritDoc}","+     */","+    @Override","+    public String determineResultPath(ActionConfig actionConfig, PackageConfig packageConfig) {","+        if (actionConfig == null) {","+            return scopedResultPath(packageConfig);","+        }","+","+        try {","+            return determineResultPath(ClassLoaderUtil.loadClass(actionConfig.getClassName(), this.getClass()), packageConfig);","+        } catch (ClassNotFoundException e) {","+            throw new RuntimeException(\"Invalid action class configuration that references an unknown \" +","+                \"class named [\" + actionConfig.getClassName() + \"]\", e);","+        }","+    }","+","+    private String scopedResultPath(PackageConfig packageConfig) {","+        if (packageConfig == null) {","+            return resultPath;","+        }","+        return scopedConstantProvider.getValue(ConventionConstants.CONVENTION_RESULT_PATH, packageConfig);","+    }","+","+    private String findAnnotatedResultPath(Class<?> actionClass) {","+        ResultPath resultPathAnnotation = AnnotationUtils.findAnnotation(actionClass, ResultPath.class);","+        if (resultPathAnnotation == null) {","+            return null;","+        }","+        if (resultPathAnnotation.value().equals(\"\") && resultPathAnnotation.property().equals(\"\")) {","+            throw new ConfigurationException(\"The ResultPath annotation must have either\" +","+                \" a value or property specified.\");","+        }","+","+        String property = resultPathAnnotation.property();","+        if (property.equals(\"\")) {","+            return resultPathAnno