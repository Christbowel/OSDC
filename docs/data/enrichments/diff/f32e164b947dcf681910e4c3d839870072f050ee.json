{"id":"f32e164b947dcf681910e4c3d839870072f050ee","axis":"silent","repo":"microsoft/DeepSpeed","sha":"f32e164b947dcf681910e4c3d839870072f050ee","parsed":{"files":[{"path":"deepspeed/runtime/bf16_optimizer.py","lines":["@@ -130,6 +130,10 @@ def destroy(self):","             for p in self.bf16_groups[i]:","                 if getattr(p, '_hp_mapping', None):","                     p._hp_mapping = None","+                # _update_hp_grad() leaves a view of the fp32 gradient buffer here; a model kept after","+                # destroy() would otherwise keep the whole buffer alive.","+                if getattr(p, '_hp_grad', None) is not None:","+                    p._hp_grad = None","         for hook in self._grad_acc_hooks:","             hook.remove()","         print_rank_0(\"Removed grad acc hooks\")"],"additions":4,"deletions":0,"truncated":false},{"path":"deepspeed/runtime/engine.py","lines":["@@ -1253,6 +1253,10 @@ def finalize_autotp(autotp=None, attach_uc_metadata=False, require_vocab_paralle","         return replacement_sources"," ","     def __del__(self):","+        # An explicitly destroyed engine can be garbage-collected after a new engine has wrapped the same model;","+        # tearing it down again here would clear state that now belongs to the new engine.","+        if getattr(self, \"_destroyed\", False):","+            return","         try:","             self.destroy()","         except Exception as exc:","@@ -1260,6 +1264,7 @@ def __del__(self):","             logger.debug(\"DeepSpeedEngine.__del__ cleanup skipped: %s\", exc, exc_info=True)"," ","     def destroy(self):","+        self._destroyed = True","         try:","             # DeepEP buffers ask the library not to reclaim them, so they outlive","             # the engine unless something releases them here. Only this engine's","@@ -1276,6 +1281,14 @@ def destroy(self):","                 optimizer.destroy()","             if self.is_deepcompile_active() or getattr(self, \"_deepcompile