h `-Zimplicit-sysroot-deps=false`","+    rustc()","+        .input(\"bar.rs\")","+        .crate_type(\"lib\")","+        .sysroot(\"./testsysroot\")","+        .arg(\"-Zimplicit-sysroot-deps=false\")","+        .run_fail()","+        .assert_stderr_contains(\"can't find crate for `baz`\");","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"tests/ui/crate-loading/auxiliary/crate-dep-std.rs","lines":["@@ -0,0 +1,3 @@","+pub fn bar() {","+    println!(\"I depend on std.\");","+}"],"additions":3,"deletions":0,"truncated":false},{"path":"tests/ui/crate-loading/no-implicit-sysroot-deps-pass.rs","lines":["@@ -0,0 +1,16 @@","+//@ check-pass","+//@ aux-build:crate-dep-std.rs","+//@ compile-flags: --crate-type=lib -Zimplicit-sysroot-deps=false -Cpanic=abort","+","+// This test ensures that `-Zimplicit-sysroot-deps=false` allows loading transitive","+// dependencies from the sysroot when required.","+","+#![feature(no_core)]","+#![no_std]","+#![no_core]","+","+extern crate crate_dep_std as foo;","+use foo::bar;","+pub fn bark() {","+    bar();","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"tests/ui/crate-loading/no-implicit-sysroot-deps.rs","lines":["@@ -0,0 +1,14 @@","+//~ ERROR can't find crate for `std`","+//~| NOTE can't find crate","+//~| NOTE target may not be installed","+//~| HELP consider building the standard library from source with `cargo build -Zbuild-std`","+//~| HELP consider downloading the target with","+","+//@ compile-flags: --target x86_64-unknown-linux-gnu -Z implicit-sysroot-deps=false","+//@ needs-llvm-components: x86","+","+// This program has an implicit dependency on std, injected by rust. This test ensures that rustc","+// does not search in the sysroot for it when `-Zimplicit-sysroot-deps` is false, and that an","+// error is thrown when std is not available on any other search paths.","+","+fn main() {}"],"additions":14,"deletions":0,"truncated":false},{"path":"tests/ui/crate-loading/no-implicit-sysroot-deps.stderr","lines":["@@ -0,0 +1,9 @@","+error[E0463]: can't find crate for `std`","+   |","+   = note: the `x86_64-unknown-linux-gnu` target may not be installed","+   = help: consider downloading the target with `rustup target add x86_64-unknown-linux-gnu`","+   = help: consider building the standard library from source with `cargo build -Zbuild-std`","+","+error: aborting due to 1 previous error","+","+For more information about this error, try `rustc --explain E0463`.",""],"additions":9,"deletions":0,"truncated":false}],"additions":120,"deletions":5,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-07-30T10:12:44.478505+00:00"}