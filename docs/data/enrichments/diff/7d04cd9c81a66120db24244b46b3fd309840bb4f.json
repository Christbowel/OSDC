 boxes_shape});","+","+        auto pred_param = std::make_shared<ov::op::v0::Parameter>(ov::element::boolean, ov::PartialShape{});","+        auto boxes_param = std::make_shared<ov::op::v0::Parameter>(prc, ov::PartialShape{-1, 10, 4});","+","+        auto split_axis2 = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {2});","+        auto split_boxes = std::make_shared<ov::op::v1::Split>(boxes_param, split_axis2, 4);","+","+        auto build_passthrough_branch = [&](bool swap_outputs) {","+            auto p0 = std::make_shared<ov::op::v0::Parameter>(prc, ov::PartialShape{-1, 10, 1});","+            auto p1 = std::make_shared<ov::op::v0::Parameter>(prc, ov::PartialShape{-1, 10, 1});","+            auto r0 = std::make_shared<ov::op::v0::Result>(swap_outputs ? p1 : p0);","+            auto r1 = std::make_shared<ov::op::v0::Result>(swap_outputs ? p0 : p1);","+            return std::make_shared<ov::Model>(ov::ResultVector{r0, r1}, ov::ParameterVector{p0, p1});","+        };","+","+        auto then_y = build_passthrough_branch(false);","+        auto else_y = build_passthrough_branch(true);","+        auto if_y = std::make_shared<ov::op::v8::If>(pred_param);","+        if_y->set_then_body(then_y);","+        if_y->set_else_body(else_y);","+        if_y->set_input(split_boxes->output(0), then_y->get_parameters()[0], else_y->get_parameters()[0]);","+        if_y->set_input(split_boxes->output(2), then_y->get_parameters()[1], else_y->get_parameters()[1]);","+        auto y_min = if_y->set_output(then_y->get_results()[0], else_y->get_results()[0]);","+        auto y_max = if_y->set_output(then_y->get_results()[1], else_y->get_results()[1]);","+","+        auto then_x = build_passthrough_branch(false);","+        auto else_x = build_passthrough_branch(true);","+        auto if_x = std::make_shared<ov::op::v8::If>(pred_param);","+        if_x->set_then_body(then_x);","+        if_x->set_else_body(else_x);","+        if_x->set_input(split_boxes->output(1), then_x->get_parameters()[0], else_x->get_parameters()[0]);","+        if_x->set_input(split_boxes->output(3), then_x->get_parameters()[1], else_x->get_parameters()[1]);","+        auto x_min = if_x->set_output(then_x->get_results()[0], else_x->get_results()[0]);","+        auto x_max = if_x->set_output(then_x->get_results()[1], else_x->get_results()[1]);","+","+        auto canon_concat = std::make_shared<ov::op::v0::Concat>(ov::OutputVector{y_min, x_min, y_max, x_max}, 2);","+        auto reshape_2d = std::make_shared<ov::op::v1::Reshape>(","+            canon_concat,","+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{2}, {10, 4}),","+            false);","+        auto transpose_4x10 = std::make_shared<ov::op::v1::Transpose>(","+            reshape_2d,","+            ov::op::v0::Constant::create(ov::element::i64, ov::Shape{2}, {1, 0}));","+","+        auto split_axis0 = ov::op::v0::Constant::create(ov::element::i64, ov::Shape{}, {0});","+        auto clip_split = std::make_shared<ov::op::v1::Split>(transpose_4x10, split_axis0, 4);","+        auto zero_const = ov::op::v0::Constant::create(prc, ov::Shape{1, 1}, {0.0f});","+        auto one_const = ov::op::v0::Constant::create(prc, ov::Shape{1, 1}, {1.0f});","+","+        ov::OutputVector clipped_coords;","+        for (size_t i = 0; i < 4; ++i) {","+            auto clamped_upper = std::make_shared<ov::op::v1::Minimum>(clip_split->output(i), one_const);","+            auto clamped_lower = std::make_shared<ov::op::v1::Maximum>(clamped_upper, zero_const);","+            clipped_coords.push_back(clamped_lower);","+        }","+","+        auto clipped_concat = std::make_shared<ov::op::v0::Concat>(clipped_coords, 0);","+        auto area_split = std::make_shared<ov::op::v1::Split>(clipped_concat, split_axis0, 4);","+        auto height = std::make_shared<ov::op::v1::Subtract>(area_split->output(2), area_split->output(0));","+        auto width = std::make_shared<ov::op::v1::Subtract>(area_split->output(3), area_split->output(1));","+        auto area = std::make_shared<ov::op::v1::Multiply>(height, width);","+","+        auto res_boxes = std::make_shared<ov::op::v0::Result>(clipped_concat);","+        auto res_area = std::make_shared<ov::op::v0::Result>(area);","+        function = std::make_shared<ov::Model>(ov::ResultVector{res_boxes, res_area},","+                                               ov::ParameterVector{pred_param, boxes_param},","+                                               \"ConditionSplitConcatClip\");","+    }","+","+    void generate_inputs(const std::vector<ov::Shape>& targetInputStaticShapes) override {","+        inputs.clear();","+        const auto& params = function->get_parameters();","+        auto pred_tensor = ov::Tensor{ov::element::boolean, {}};","+        pred_tensor.data<ov::element_type_traits<ov::element::boolean>::value_type>()[0] = (iter++ % 2 == 0);","+        inputs.insert({params[0], pred_tensor});","+","+        auto boxes_tensor = ov::test::utils::create_and_fill_tensor_real_distribution(","+            params[1]->get_element_type(), targetInputStaticShapes[1], 0.05f, 0.95f, 42);","+        inputs.insert({params[1], boxes_tensor});","+    }","+","+    size_t iter = 0;","+};","+","+TEST_P(ConditionSplitConcatClipSubgraphGPUTest, CompareWithRefs) {","+    run();","+}","+","+INSTANTIATE_TEST_SUITE_P(smoke_ConditionSplitConcatClip,","+                         ConditionSplitConcatClipSubgraphGPUTest,","+                         testing::Values(ov::element::f32, ov::element::f16));"," } // namespace"],"additions":109,"deletions":0,"truncated":false},{"path":"src/plugins/intel_gpu/tests/unit/passes/prepare_buffer_fusing_test.cpp","lines":["@@ -40,6 +40,10 @@"," #include \"program_wrapper.h\""," #include \"primitive_inst_test_helper.h\""," ","+#include \"condition_inst.h\"","+#include \"loop_inst.h\"","+#include \"mutable_data_inst.h\"","+"," #include <memory>"," "," using namespace cldnn;","@@ -3742,3 +3746,308 @@ TEST(prepare_buffer_fusing, in_place_concat_rejected_for_shape_of_subgraph_input","     ASSERT_EQ(out_ptr[2], 3.f);","     ASSERT_EQ(out_ptr[3], 4.f);"," }","+","+TEST(prepare_buffer_fusing, in_place_concat_and_crop_along_batch_feature_only_safe_index) {","+    auto& engine = get_test_engine();","+","+    const int64_t num_slices = 4;","+    const int64_t feat_size = 10;","+    auto in_layout = layout{ov::PartialShape{num_slices, feat_size}, data_types::f32, format::bfyx};","+    auto input_mem = engine.allocate_memory(in_layout);","+    auto axis_mem = engine.allocate_memory({{}, data_types::i64, format::bfyx});","+    auto bound_min_mem = engine.allocate_memory({{1, 1}, data_types::f32, format::bfyx});","+    auto bound_max_mem = engine.allocate_memory({{1, 1}, data_types::f32, format::bfyx});","+","+    std::vector<float> input_data(static_cast<size_t>(num_slices * feat_size));","+    for (int64_t s = 0; s < num_slices; ++s) {","+        for (int64_t f = 0; f < feat_size; ++f) {","+            input_data[static_cast<size_t>(s * feat_size + f)] = static_cast<float>((s + 1) * 10 + f);","+        }","+    }","+    set_values(input_mem, input_data);","+    set_values<int64_t>(axis_mem, {0});","+    set_values<float>(bound_min_mem, {0.f});","+    set_values<float>(bound_max_mem, {100.f});","+","+    const auto op_mode = cldnn::crop_ngraph_op_mode::split;","+    auto offset0 = cldnn::tensor(cldnn::batch(0), cldnn::feature(0), cldnn::spatial(0, 0));","+    auto offset1 = cldnn::tensor(cldnn::batch(1), cldnn::feature(0), cldnn::spatial(0, 0));","+    auto offset2 = cldnn::tensor(cldnn::batch(2), cldnn::feature(0), cldnn::spatial(0, 0));","+    auto offset3 = cldnn::tensor(cldnn::batch(3), cldnn::feature(0), cldnn::spatial(0, 0));","+","+    topology topo(","+        input_layout(\"input\", in_layout),","+        data(\"axis\", axis_mem),","+        data(\"bound_min\", bound_min_mem),","+        data(\"bound_max\", bound_max_mem),","+        crop(\"split_in0\", {input_info(\"input\"), input_info(\"axis\")}, cldnn::tensor(1), offset0, op_mode, 0, 0, num_slices),","+        crop(\"split_in1\", {input_info(\"input\"), input_info(\"axis\")}, cldnn::tensor(1), offset1, op_mode, 1, 0, num_slices),","+        crop(\"split_in2\", {input_info(\"input\"), input_info(\"axis\")}, cldnn::tensor(1), offset2, op_mode, 2, 0, num_slices),","+        crop(\"split_in3\", {input_info(\"input\"), input_info(\"axis\")}, cldnn::tensor(1), offset3, op_mode, 3, 0, num_slices),","+        eltwise(\"min0\", {input_info(\"split_in0\"), input_info(\"bound_max\")}, eltwise_mode::min),","+        eltwise(\"max0\", {input_info(\"min0\"), input_info(\"bound_min\")}, eltwise_mode::max),","+        eltwise(\"min1\", {input_info(\"split_in1\"), input_info(\"bound_max\")}, eltwise_mode::min),","+        eltwise(\"max1\", {input_info(\"min1\"), input_info(\"bound_min\")}, eltwise_mode::max),","+        eltwise(\"min2\", {input_info(\"split_in2\"), input_info(\"bound_max\")}, eltwise_mode::min),","+        eltwise(\"max2\", {input_info(\"min2\"), input_info(\"bound_min\")}, eltwise_mode::max),","+        eltwise(\"min3\", {input_info(\"split_in3\"), input_info(\"bound_max\")}, eltwise_mode::min),","+        eltwise(\"max3\", {input_info(\"min3\"), input_info(\"bound_min\")}, eltwise_mode::max),","+        concatenation(\"concat\", {input_info(\"max0\"), input_info(\"max1\"), input_info(\"max2\"), input_info(\"max3\")}, 0),","+        crop(\"area_split0\", {input_info(\"concat\"), input_info(\"axis\")}, cldnn::tensor(1), offset0, op_mode, 0, 0, num_slices),","+        crop(\"area_split1\", {input_info(\"concat\"), input_info(\"axis\")}, cldnn::tensor(1), offset1, op_mode, 1, 0, num_slices),","+        crop(\"area_split2\", {input_info(\"concat\"), input_info(\"axis\")}, cldnn::tensor(1), offset2, op_mode, 2, 0, num_slices),","+        crop(\"area_split3\", {input_info(\"concat\"), input_info(\"axis\")}, cldnn::tensor(1), offset3, op_mode, 3, 0, num_slices),","+        eltwise(\"diff_y\", {input_info(\"area_split2\"), input_info(\"area_split0\")}, eltwise_mode::sub),","+        eltwise(\"diff_x\", {input_info(\"area_split3\"), input_info(\"area_split1\")}, eltwise_mode::sub),","+        eltwise(\"area\", {input_info(\"diff_y\"), input_info(\"diff_x\")}, eltwise_mode::prod),","+        reorder(\"output\", input_info(\"area\"), format::bfyx, data_types::f32)","+    );","+","+    ExecutionConfig config = get_test_default_config(engine);","+    config.set_property(ov::intel_gpu::allow_new_shape_infer(true));","+    config.set_property(ov::intel_gpu::optimize_data(true));","+","+    network net(engine, topo, config);","+    net.set_input_data(\"input\", input_mem);","+    auto outputs = net.execute();","+","+    ASSERT_TRUE(net.get_primitive(\"concat\")->can_be_optimized());","+    ASSERT_TRUE(net.get_primitive(\"area_split0\")->can_be_optimized());","+    ASSERT_TRUE(net.get_primitive(\"area_split1\")->can_be_optimized());","+    ASSERT_TRUE(net.get_primitive(\"area_split2\")->can_be_optimized());","+    ASSERT_TRUE(net.get_primitive(\"area_split3\")->can_be_optimized());","+","+    auto out_mem = outputs.at(\"output\").get_memory();","+    cldnn::mem_lock<float, mem_lock_type::read> out_ptr(out_mem, get_test_stream());","+    ASSERT_EQ(out_mem->count(), static_cast<size_t>(feat_size));","+    for (int64_t f = 0; f < feat_size; ++f) {","+        const float y0 = input_data[static_cast<size_t>(0 * feat_size + f)];","+        const float x0 = input_data[static_cast<size_t>(1 * feat_size + f)];","+        const float y1 = input_data[static_cast<size_t>(2 * feat_size + f)];","+        const float x1 = input_data[static_cast<size_t>(3 * feat_size + f)];","+        const float expected = (y1 - y0) * (x1 - x0);","+        ASSERT_FLOAT_EQ(out_ptr[static_cast<size_t>(f)], expected) << \"Mismatch at feature \" << f;","+    }","+}","+","+TEST(prepare_buffer_fusing, in_place_crop_rejected_around_condition) {","+    auto& engine = get_test_engine();","+    ExecutionConfig config = get_test_default_config(engine);","+    config.set_property(ov::intel_gpu::optimize_data(true));","+    config.set_property(ov::intel_gpu::allow_new_shape_infer(true));","+","+    const ov::PartialShape in_pshape = {-1, 4, 2};","+    const ov::PartialShape split_pshape = {-1, 4, 1};","+    auto in_mem = engine.allocate_memory({{1, 4, 2}, data_types::f32, format::bfyx});","+    auto pred_mem = engine.allocate_memory({{1}, data_types::u8, format::bfyx});","+    auto axis_mem = engine.allocate_memory({{}, data_types::i64, format::bfyx});","+","+    set_values<float>(in_mem, {1.f, 10.f, 2.f, 20.f, 3.f, 30.f, 4.f, 40.f});","+    set_values<uint8_t>(pred_mem, {1});","+    set_values<int64_t>(axis_mem, {2});","+","+    auto build_branch = [&](const std::string& prefix) {","+        topology branch_topo;","+        branch_topo.add(","+            input_layout(prefix + \"_in0\", {split_pshape, data_types::f32, format::bfyx}),","+            input_layout(prefix + \"_in1\", {split_pshape, data_types::f32, format::bfyx}),","+            concatenation(prefix + \"_concat\", {input_info(prefix + \"_in0\"), input_info(prefix + \"_in1\")}, 2)","+        );","+        condition::branch b;","+        b.inner_program = program::build_program(engine, branch_topo, config, false, false, true);","+        b.input_map.insert({\"crop_before0\", prefix + \"_in0\"});","+        b.input_map.insert({\"crop_before1\", prefix + \"_in1\"});","+        b.output_map.insert({0, prefix + \"_concat\"});","+        return b;","+    };","+","+    auto branch_true = build_branch(\"t\");","+    auto branch_false = build_branch(\"f\");","+","+    const auto op_mode = cldnn::crop_ngraph_op_mode::split;","+    auto offset0 = cldnn::tensor(0);","+    auto offset1 = cldnn::tensor(cldnn::batch(0), cldnn::feature(0), cldnn::spatial(0, 1));","+","+    topology topo(","+        input_layout(\"pred\", pred_mem->get_layout()),","+        input_layout(\"input\", {in_pshape, data_types::f32, format::bfy