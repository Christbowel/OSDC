xample.com.evil.net\"},","+\t\t\t\t{name: \"other origin\", path: \"/api/v2/silences\", origin: \"https://b.example.com\"},","+\t\t\t\t{name: \"metrics\", path: \"/metrics\", origin: allowed},","+\t\t\t\t{name: \"reload\", path: \"/-/reload\", origin: allowed},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:        \"enabled under a route prefix\",","+\t\t\troutePrefix: \"/alertmanager\",","+\t\t\tconfigure:   []func(*app.Options){withCORS},","+\t\t\tchecks: []check{","+\t\t\t\t{name: \"v2\", path: \"/api/v2/silences\", origin: allowed, wantAllowOrigin: allowed},","+\t\t\t\t{name: \"connect\", path: \"/api\" + statusv3alphaconnect.StatusServiceGetStatusProcedure, origin: allowed, wantAllowOrigin: allowed},","+\t\t\t\t{name: \"metrics\", path: \"/metrics\", origin: allowed},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"disabled\",","+\t\t\tchecks: []check{","+\t\t\t\t{name: \"v2\", path: \"/api/v2/silences\", origin: allowed},","+\t\t\t\t{name: \"connect\", path: \"/api\" + statusv3alphaconnect.StatusServiceGetStatusProcedure, origin: allowed},","+\t\t\t},","+\t\t},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tinst := startInstance(t, instanceOptions{routePrefix: tc.routePrefix}, tc.configure...)","+\t\t\tfor _, c := range tc.checks {","+\t\t\t\tt.Run(c.name, func(t *testing.T) {","+\t\t\t\t\treq, err := http.NewRequest(http.MethodOptions, inst.webURL(c.path), http.NoBody)","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\treq.Header.Set(\"Origin\", c.origin)","+\t\t\t\t\treq.Header.Set(\"Access-Control-Request-Method\", http.MethodPost)","+","+\t\t\t\t\tresp, err := inst.httpClient.Do(req)","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\tt.Cleanup(func() { _ = resp.Body.Close() })","+\t\t\t\t\trequire.Equal(t, c.wantAllowOrigin, resp.Header.Get(\"Access-Control-Allow-Origin\"))","+\t\t\t\t})","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":93,"deletions":0,"truncated":false},{"path":"test/e2e/harness_test.go","lines":["@@