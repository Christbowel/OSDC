{"id":"f2b319c6fb2dc4a0d533c7ba6837a2d2bef18e6f","axis":"silent","repo":"pnpm/pnpm","sha":"f2b319c6fb2dc4a0d533c7ba6837a2d2bef18e6f","parsed":{"files":[{"path":".changeset/refuse-modules-dir-from-another-store.md","lines":["@@ -0,0 +1,14 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add`, `pnpm remove`, and `pnpm update` now fail if `node_modules` does not match the current settings. Run `pnpm install` to recreate it. Previously, these commands removed and reinstalled `node_modules` without asking. They report:","+","+- `ERR_PNPM_UNEXPECTED_STORE` if `node_modules` was linked from a different store.","+- `ERR_PNPM_UNEXPECTED_VIRTUAL_STORE` if it was linked from a different virtual store directory.","+- `ERR_PNPM_MODULES_BREAKING_CHANGE` if it was installed by an incompatible pnpm version, or if `node_modules/.modules.yaml` cannot be read.","+- `ERR_PNPM_NODE_LINKER_DIFF` if it was installed with a different `nodeLinker`.","+","+`pnpm install` now recreates `node_modules` after a `storeDir` or `virtualStoreDir` change. It used to report \"Already up to date\".","+","+`pnpm update` now also fails with `ERR_PNPM_HOIST_PATTERN_DIFF` and the other errors `pnpm add` reports for a changed hoist pattern or `virtualStoreDirMaxLength`."],"additions":14,"deletions":0,"truncated":false},{"path":".changeset/reinstall-after-store-location-change.md","lines":["@@ -0,0 +1,9 @@","+---","+\"@pnpm/workspace.state\": patch","+\"@pnpm/deps.status\": patch","+\"@pnpm/exec.commands\": patch","+\"@pnpm/installing.commands\": patch","+\"pnpm\": patch","+---","+","+`pnpm install` now recreates `node_modules` after a `storeDir` or `virtualStoreDir` change. It used to report \"Already up to date\"."],"additions":9,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -11032,6 +11032,9 @@ importers:","       '@pnpm/config.reader':","         specifier: workspace:*","         version: link:../../config/reader","+      '@pnpm/constants':","+        specifier: workspace:*","+        version: link:../../core/constants","       '@pnpm/error':","         specifier: workspace:*","         version: link:../../core/error"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/main.rs","lines":["@@ -115,6 +115,7 @@ mod manifest_creation;"," mod metadata_request_log;"," mod minimum_release_age;"," mod modules_dir;","+mod modules_dir_compatibility;"," mod modules_dir_with_subdirectory;"," mod multiple_importers;"," mod named_registry_install;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/modules_dir_compatibility.rs","lines":["@@ -0,0 +1,262 @@","+//! A modules directory linked with another store, virtual store, or layout","+//! version: `add`, `remove`, and `update` refuse it, and `install`","+//! recreates it. Mirrors `validateModules` and `checkCompatibility` in","+//! `pnpm11/installing/deps-installer/src/install/`.","+","+use crate::_utils::{","+    append_workspace_yaml_key, enable_gvs_in_workspace_yaml, flatten_report, pacquet_in,","+};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pipe_trait::Pipe;","+use pnpm_testing_utils::bin::{AddMockedRegistry, CommandTempCwd};","+use std::{","+    fs,","+    path::{Path, PathBuf},","+};","+","+#[test]","+fn add_remove_and_update_refuse_a_modules_dir_linked_from_another_store() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    install_is_positive(&workspace);","+","+    switch_store_dir(&workspace);","+","+    for args in [&[\"add\", \"is-negative@1.0.0\"][..], &[\"remove\", \"is-positive\"], &[\"update\"]] {","+        assert_report_contains(","+            &run_failing(&workspace, args),","+            &[","+                \"ERR_PNPM_UNEXPECTED_STORE\",","+                \"Unexpected store location\",","+                \"are currently linked from the store at\",","+                \"pacquet-store\",","+                \"pnpm now wants to use the store at\",","+                \"other-store\",","+                \"to link dependencies.\",","+            ],","+        );","+        assert!(","+            workspace.join(\"node_modules/is-positive\").exists(),","+            \"{args:?} purged node_modules\",","+        );","+    }","+","+    let other_store = Path::new(\"other-store\").join(\"v11\");","+    install_records(&workspace, \"storeDir\", &other_store);","+    let workspace_state = read_json(&workspace.join(\"node_modules/.pnpm-workspace-state-v1.json\"));","+    let recorded_store_dir = recorded_path(&workspace_state[\"settings\"], \"storeDir\");","+    assert!(","+        recorded_store_dir.is_absolute() && recorded_store_dir.ends_with(&other_store),","+        \"{recorded_store_dir:?}\",","+    );","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn add_refuses_a_modules_dir_linked_from_another_virtual_store() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    install_is_positive(&workspace);","+    append_workspace_yaml_key(&workspace, \"virtualStoreDir\", \"node_modules/.vs\");","+","+    assert_report_contains(","+        &run_failing(&workspace, &[\"add\", \"is-negative@1.0.0\"]),","+        &[","+            \"ERR_PNPM_UNEXPECTED_VIRTUAL_STORE\",","+            \"Unexpected virtual store location\",","+            \"pnpm now wants to use the virtual store at\",","+        ],","+    );","+    assert!(workspace.join(\"node_modules/is-positive\").exists(), \"add purged node_modules\");","+","+    install_records(&workspace, \"virtualStoreDir\", Path::new(\".vs\"));","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn add_refuses_a_modules_dir_with_another_layout_version() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    install_is_positive(&workspace);","+","+    let modules_yaml_path = workspace.join(\"node_modules/.modules.yaml\");","+    let modules_yaml = fs::read_to_string(&modules_yaml_path).expect(\"read .modules.yaml\");","+    let downgraded = modules_yaml.replace(r#\"\"layoutVersion\": 5\"#, r#\"\"layoutVersion\": 4\"#);","+    assert_ne!(modules_yaml, downgraded, \"`.modules.yaml` should record layout version 5\");","+    fs::write(&modules_yaml_path, downgraded).expect(\"write .modules.yaml\");","+","+    assert_report_contains(","+        &run_failing(&workspace, &[\"add\", \"is-negative@1.0.0\"]),","+        &[","+            \"ERR_PNPM_MODULES_BREAKING_CHANGE\",","+            \"The current version of pnpm is not compatible with the available node_modules structure\",","+            \"Run pnpm install to recreate node_modules.\",","+        ],","+    );","+    assert!(workspace.join(\"node_modules/is-positive\").exists(), \"add purged node_modules\");","+","+    drop((root, mock_instance));","+}","+","+/// `add` refuses a modules directory installed with another `nodeLinker`.","+/// Keeping it would leave the hoisted layout's packages behind, and purging","+/// it could drop links a filtered `add` does not recreate.","+#[test]","+fn add_refuses_a_modules_dir_installed_with_another_node_linker() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    append_workspace_yaml_key(&workspace, \"nodeLinker\", \"hoisted\");","+    pacquet_in(&workspace)","+        .with_args([\"add\", \"@pnpm.e2e/pkg-with-1-dep@100.0.0\"])","+        .assert()","+        .success();","+    let hoisted = workspace.join(\"node_modules/@pnpm.e2e/dep-of-pkg-with-1-dep\");","+    assert!(hoisted.exists(), \"the hoisted linker should place the transitive at the root\");","+    let yaml = workspace.join(\"pnpm-workspace.yaml\");","+    let switched = fs::read_to_string(&yaml)","+        .expect(\"read pnpm-workspace.yaml\")","+        .replace(\"nodeLinker: hoisted\", \"nodeLinker: isolated\");","+    fs::write(&yaml, switched).expect(\"write pnpm-workspace.yaml\");","+","+    assert_report_contains(","+        &run_failing(&workspace, &[\"add\", \"is-positive@1.0.0\"]),","+        &[\"ERR_PNPM_NODE_LINKER_DIFF\"],","+    );","+    assert!(hoisted.exists(), \"add purged node_modules\");","+","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(fs::symlink_metadata(&hoisted).is_err(), \"install left the hoisted transitive behind\");","+","+    drop((root, mock_instance));","+}","+","+/// A script runs the same from whichever store `node_modules` was linked","+/// from, so `pnpm run` passes verification and keeps the recorded store for","+/// the install that recreates the tree.","+#[test]","+fn run_passes_verification_after_a_store_change_that_install_acts_on() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"scripts\": { \"start\": \"node --version\" },","+            \"dependencies\": { \"is-positive\": \"1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    pacquet_in(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    switch_store_dir(&workspace);","+","+    pacquet_in(&workspace)","+        .with_args([\"--config.verify-deps-before-run=error\", \"run\", \"start\"])","+        .assert()","+        .success();","+","+    let state = read_json(&workspace.join(\"node_modules/.pnpm-workspace-state-v1.json\"));","+    let recorded_store_dir = recorded_path(&state[\"settings\"], \"storeDir\");","+    assert!(","+        recorded_store_dir.ends_with(Path::new(\"pacquet-store\").join(\"v11\")),","+        \"{recorded_store_dir:?}\",","+    );","+    install_records(&workspace, \"storeDir\", &Path::new(\"other-store\").join(\"v11\"));","+","+    drop((root, mock_instance));","+}","+","+/// Under a global virtual store, the state records the configured","+/// `virtualStoreDir` anchored at the project, as pnpm v11 does, not the","+/// global virtual store.","+#[test]","+fn the_workspace_state_records_the_configured_virtual_store_dir_under_a_global_virtual_store() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    enable_gvs_in_workspace_yaml(","+        &workspace,","+        \"virtualStoreDir: node_modules/.vs\\nglobalVirtualStoreDir: ../gvs\\n\",","+    );","+    install_is_positive(&workspace);","+","+    let state = read_json(&workspace.join(\"node_modules/.pnpm-workspace-state-v1.json\"));","+    let recorded = recorded_path(&state[\"settings\"], \"virtualStoreDir\");","+    assert!(","+        recorded.is_absolute()","+            && recorded.ends_with(Path::new(\"workspace\").join(\"node_modules\").join(\".vs\")),","+        \"{recorded:?}\",","+    );","+","+    drop((root, mock_instance));","+}","+","+fn switch_store_dir(workspace: &Path) {","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&yaml_path).expect(\"read pnpm-workspace.yaml\");","+    let switched = yaml.replace(\"storeDir: ../pacquet-store\", \"storeDir: ../other-store\");","+    assert_ne!(yaml, switched, \"the harness should write `storeDir: ../pacquet-store`\");","+    fs::write(&yaml_path, switched).expect(\"write pnpm-workspace.yaml\");","+}","+","+fn install_is_positive(workspace: &Path) {","+    pacquet_in(workspace)","+        .with_args([\"add\", \"is-positive@1.0.0\"])","+        .assert()","+        .success();","+}","+","+/// `pnpm install` recreates the modules directory, whose `.modules.yaml`","+/// then records a `field` path ending in `expected`.","+fn install_records(workspace: &Path, field: &str, expected: &Path) {","+    pacquet_in(workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    assert!(workspace.join(\"node_modules/is-positive\").exists());","+    let modules = read_json(&workspace.join(\"node_modules/.modules.yaml\"));","+    let recorded = recorded_path(&modules, field);","+    assert!(recorded.ends_with(expected), \"{field}: {recorded:?}\");","+}","+","+fn read_json(path: &Path) -> serde_json::Value {","+    fs::read_to_string(path)","+        .expect(\"read the file\")","+        .pipe_as_ref(serde_json::from_str)","+        .expect(\"parse the file as JSON\")","+}","+","+fn recorded_path(record: &serde_json::Value, field: &str) -> PathBuf {","+    record[field]","+        .as_str()","+        .map(|raw| pnpm_fs::lexical_normalize(Path::new(raw)))","+        .unwrap_or_else(|| panic!(\"{field} is recorded\"))","+}","+","+fn run_failing(workspace: &Path, args: &[&str]) -> String {","+    let output = pacquet_in(workspace)","+        .with_args(args)","+        .assert()","+        .failure();","+    String::from_utf8_lossy(&output.get_output().stderr).into_owned()","+}","+","+fn assert_report_contains(stderr: &str, expected: &[&str]) {","+    let report = flatten_report(stderr);","+    for text in expected {","+        assert!(report.contains(&flatten_report(text)), \"expected {text:?} in {stderr}\");","+    }","+}"],"additions":262,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/layout.rs","lines":["@@ -588,7 +588,7 @@ impl Config {","     /// [`Self::install_state_dir`]. This is the `virtualStoreDir` pnpm","     /// records in `.modules.yaml` and emits in the `pnpm:context` event, so","     /// reading the install state directory instead makes the next install","-    /// fail with `ERR_PNPM_UNEXPECTED_VIRTUAL_STORE_DIR`.","+    /// fail with `ERR_PNPM_UNEXPECTED_VIRTUAL_STORE`.","     pub fn virtual_store_dir(&self) -> &Path {","         if self.enable_global_virtual_store {","             &self.global_virtual_store_dir"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/store_path.rs","lines":["@@ -16,8 +16,9 @@"," //! above it accepts a hard link. The store then goes to"," //! `<pkg_root>/node_modules/.pnpm-store`, where the project's VCS"," //! ignores it — deliberately not the `<pkg_root>/.pnpm-store` pnpm 11","-//! uses, so a project installed with both CLIs reports","-//! `ERR_PNPM_UNEXPECTED_STORE` once and reinstalls.","+//! uses. A project switched between both CLIs fails `pnpm add`,","+//! `pnpm remove`, and `pnpm update` with `ERR_PNPM_UNEXPECTED_STORE` until","+//! `pnpm install` recreates its modules directory."," //!"," //! Without this detection a developer with a separate"," //! case-sensitive workspace volume (for example"],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/install.rs","lines":["@@ -127,12 +127,12 @@ use lockfile_freshness::{"," };"," use materialize::{MaterializationInputs, Materialized, materialize};"," use modules_state::{","-    build_modules_manifest, check_modules_settings_diff, current_contains_dep_path,","-    drain_settled_projects, gvs_build_marker_present, gvs_build_markers_may_require_recovery,","+    build_modules_manifest, current_contains_dep_path, drain_settled_projects,","+    gvs_build_marker_present, gvs_build_markers_may_require_recovery,","     has_newly_allowed_ignored_builds, keep_recorded_layout, manifest_string_field,","     merge_filtered_modules_metadata, merge_pending_builds, modules_consistent_with,","     project_requires_implicit_gyp_build, project_requires_lifecycle_scripts,","-    recorded_allow_builds_differ, unapproved_recorded_ignored_builds,","+    recorded_allow_builds_differ, refuse_drifted_modules_dir, unapproved_recorded_ignored_builds,"," };"," use prepare_modules_state::{","     PrepareModulesStateInputs, PreparedModulesState, prepare_modules_state,"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization.rs","lines":["@@ -357,7 +357,7 @@ fn write_applied_workspace_state<Reporter: self::Reporter>(","             established_auto_dedupe: (config.auto_dedupe","                 && inputs.materialized.fresh_lockfile.is_some())","             .then_some(true),","-            kept_groups: None,","+            kept_settings: None,","         },","         vouched: &vouched,","     });"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/errors.rs","lines":["@@ -68,9 +68,9 @@ pub enum InstallError {","         #[error(source)] crate::package_extender::InvalidPackageExtensionSelector,","     ),"," ","-    // The `*_DIFF` errors below mirror pnpm's `validateModules`:","-    // a non-plain-install mutation refuses to touch a modules directory","-    // whose persisted layout settings disagree with the current config.","+    // The errors below mirror pnpm's `validateModules`: a","+    // non-plain-install mutation refuses to touch a modules directory","+    // whose recorded layout disagrees with the current config.","     #[display(","         r#\"This modules directory was created using a different hoist-pattern value. Run \"pnpm install\" to recreate the modules directory.\"#","     )]","@@ -89,6 +89,44 @@ pub enum InstallError {","     #[diagnostic(code(ERR_PNPM_VIRTUAL_STORE_DIR_MAX_LENGTH_DIFF))]","     VirtualStoreDirMaxLengthDiff,"," ","+    /// pnpm-only: upstream keeps such a tree on a mutation and leaves the","+    /// previous linker's packages behind.","+    #[display(","+        r#\"This modules directory was created using a different node-linker value. Run \"pnpm install\" to recreate the modules directory.\"#","+    )]","+    #[diagnostic(code(ERR_PNPM_NODE_LINKER_DIFF))]","+    NodeLinkerDiff,","+","+    #[display(","+        \"The current version of pnpm is not compatible with the available node_modules structure\"","+    )]","+    #[diagnostic(","+        code(ERR_PNPM_MODULES_BREAKING_CHANGE),","+        help(\"node_modules path: {modules_dir}\\n\\nRun pnpm install to recreate node_modules.\")","+    )]","+    ModulesBreakingChange {","+        #[error(not(source))]","+        modules_dir: String,","+    },","+","+    #[display(\"Unexpected store location\")]","+    #[diagnostic(","+        code(ERR_PNPM_UNEXPECTED_STORE),","+        help(","+            \"The dependencies at \\\"{modules_dir}\\\" are currently linked from the store at \\\"{expected_store_path}\\\".\\n\\npnpm now wants to use the store at \\\"{actual_store_path}\\\" to link dependencies.\\n\\nIf you want to use the new store location, reinstall your dependencies with \\\"pnpm install\\\".\\n\\nYou may change the global store location by running \\\"pnpm config set store-dir <dir> --global\\\".\\n(This error may happen if the node_modules was installed with a different major version of pnpm)\"","+        )","+    )]","+    UnexpectedStore { expected_store_path: String, actual_store_path: String, modules_dir: String },","+","+    #[display(\"Unexpected virtual store location\")]","+    #[diagnostic(","+        code(ERR_PNPM_UNEXPECTED_VIRTUAL_STORE),","+        help(","+            \"The dependencies at \\\"{modules_dir}\\\" are currently symlinked from the virtual store directory at \\\"{expected}\\\".\\n\\npnpm now wants to use the virtual store at \\\"{actual}\\\" to link dependencies from the store.\\n\\nIf you want to use the new virtual store location, reinstall your dependencies with \\\"pnpm install\\\".\\n\\nYou may change the virtual store location by changing the value of the virtual-store-dir config.\"","+        )","+    )]","+    UnexpectedVirtualStore { expected: String, actual: String, modules_dir: String },","+","     #[diagnostic(transparent)]","     WithFreshLockfile(#[error(source)] InstallWithFreshLockfileError),"," "],"additions":41,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/modules_state.rs","lines":["@@ -6,11 +6,14 @@ pub(super) use build_markers::{gvs_build_marker_present, gvs_build_markers_may_r"," pub(super) use merge_metadata::{","     current_contains_dep_path, merge_filtered_modules_metadata, merge_pending_builds,"," };","+pub(super) use settings_diff::{refuse_drifted_modules_dir, same_path};"," "," mod build_markers;"," "," mod merge_metadata;"," ","+mod settings_diff;","+"," mod integrity;"," "," use super::{","@@ -167,33 +170,6 @@ fn slot_bins_are_relocatable(","         })"," }"," ","-/// The `validateModules` half pacquet enforces: when the mutation is","-/// not a plain install (upstream `installsOnly === false`), a drift in","-/// the persisted layout settings fails with the upstream `*_DIFF`","-/// error instead of silently recreating the modules directory. Check","-/// order matches upstream `validateModules`. Drift in the fields this","-/// does not cover (store dir, node linker, layout version) still takes","-/// the recreate path.","-pub(super) fn check_modules_settings_diff(","-    modules: &pnpm_modules_yaml::ModulesLayout,","-    config: &Config,","-) -> Result<(), InstallError> {","-    if modules.virtual_store_dir_max_length != config.virtual_store_dir_max_length {","-        return Err(InstallError::VirtualStoreDirMaxLengthDiff);","-    }","-    if normalized_pattern(modules.public_hoist_pattern.as_deref())","-        != normalized_pattern(config.public_hoist_pattern.as_deref())","-    {","-        return Err(InstallError::PublicHoistPatternDiff);","-    }","-    if normalized_pattern(modules.hoist_pattern.as_deref())","-        != normalized_pattern(config.hoist_pattern.as_deref())","-    {","-        return Err(InstallError::HoistPatternDiff);","-    }","-    Ok(())","-}","-"," /// Upstream compares patterns with `?? []`: `None` and an empty list"," /// are the same disabled state."," pub(super) fn normalized_pattern(pattern: Option<&[String]>) -> &[String] {","@@ -237,12 +213,8 @@ pub(crate) fn modules_layout_consistent_with(","         && modules.node_linker == Some(map_node_linker(node_linker))","         && hoist_patterns_match","         && modules.virtual_store_dir_max_length == config.virtual_store_dir_max_length","-        && modules.store_dir == config.store_dir.display().to_string()","-        && modules.virtual_store_dir","-            == config","-                .virtual_store_dir()","-                .to_string_lossy()","-                .as_ref()","+        && same_path(Path::new(&modules.store_dir), config.store_dir.root())","+        && same_path(Path::new(&modules.virtual_store_dir), config.virtual_store_dir())"," }"," "," /// Whether `.modules.yaml` records any ignored build that the current"],"additions":5,"deletions":33,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/modules_state/settings_diff.rs","lines":["@@ -0,0 +1,125 @@","+use super::{","+    super::{Config, InstallError, LayoutVersion, NodeLinker, Path},","+    map_node_linker, normalized_pattern,","+};","+use pnpm_modules_yaml::NodeLinker as ModulesNodeLinker;","+","+/// Refuses a mutation other than a plain install on a drifted modules","+/// directory that only a plain install may recreate: the drift","+/// [`check_modules_settings_diff`] reports, a `nodeLinker` change, and a","+/// `.modules.yaml` that exists but does not parse. Purging for any of them","+/// could delete links that a filtered mutation does not recreate, or files","+/// pnpm does not own.","+pub(in super::super) fn refuse_drifted_modules_dir(","+    modules: Option<&pnpm_modules_yaml::ModulesLayout>,","+    config: &Config,","+    node_linker: NodeLinker,","+) -> Result<(), InstallError> {","+    let Some(modules) = modules else {","+        return Err(InstallError::ModulesBreakingChange {","+            modules_dir: config.modules_dir.display().to_string(),","+        });","+    };","+    check_modules_settings_diff(modules, config)?;","+    // A manifest from before `nodeLinker` existed omits it; those trees are","+    // isolated.","+    let recorded_linker = modules.node_linker.unwrap_or(ModulesNodeLinker::Isolated);","+    if recorded_linker != map_node_linker(node_linker) {","+        return Err(InstallError::NodeLinkerDiff);","+    }","+    Ok(())","+}","+","+/// The `validateModules` half pacquet enforces: when the mutation is","+/// not a plain install (upstream `installsOnly === false`), a modules","+/// directory whose recorded layout disagrees with the current config fails","+/// instead of being recreated. Check order matches upstream","+/// `validateModules`, then its `checkCompatibility`. Upstream checks no","+/// `nodeLinker` drift.","+fn check_modules_settings_diff(","+    modules: &pnpm_modules_yaml::ModulesLayout,","+    config: &Config,","+) -> Result<(), InstallError> {","+    if modules.virtual_store_dir_max_length != config.virtual_store_dir_max_length {","+        return Err(InstallError::VirtualStoreDirMaxLengthDiff);","+    }","+    // A `virtualStoreOnly` install (`pnpm fetch`) records empty hoist","+    // patterns; the follow-up install completes the linking.","+    if modules.virtual_store_only != Some(true) {","+        check_hoist_patterns_diff(modules, config)?;","+    }","+    check_compatibility(modules, config)","+}","+","+fn check_hoist_patterns_diff(","+    modules: &pnpm_modules_yaml::ModulesLayout,","+    config: &Config,","+) -> Result<(), InstallError> {","+    if normalized_pattern(modules.public_hoist_pattern.as_deref())","+        != normalized_pattern(config.public_hoist_pattern.as_deref())","+    {","+        return Err(InstallError::PublicHoistPatternDiff);","+    }","+    if normalized_pattern(modules.hoist_pattern.as_deref())","+        != normalized_pattern(config.hoist_pattern.as_deref())","+    {","+        return Err(InstallError::HoistPatternDiff);","+    }","+    Ok(())","+}","+","+/// Upstream `checkCompatibility`: the layout version, the store, and the","+/// virtual store the modules directory was linked with.","+fn check_compatibility(","+    modules: &pnpm_modules_yaml::ModulesLayout,","+    config: &Config,","+) -> Result<(), InstallError> {","+    let modules_dir = config.modules_dir.display().to_string();","+    if modules.layout_version != Some(LayoutVersion) {","+        return Err(InstallError::ModulesBreakingChange { modules_dir });","+    }","+    if !recorded_store_matches(&modules.store_dir, config.store_dir.root()) {","+        return Err(InstallError::UnexpectedStore {","+            expected_store_path: modules.store_dir.clone(),","+            actual_store_path: config.store_dir.display().to_string(),","+            modules_dir,","+        });","+    }","+    let virtual_store_dir = config.virtual_store_dir();","+    if !modules.virtual_store_dir.is_empty()","+        && !same_path(Path::new(&modules.virtual_store_dir), virtual_store_dir)","+    {","+        return Err(InstallError::UnexpectedVirtualStore {","+            expected: modules.virtual_store_dir.clone(),","+            actual: virtual_store_dir.display().to_string(),","+            modules_dir,","+        });","+    }","+    Ok(())","+}","+","+/// Upstream also accepts a modules directory linked from the `v3` store","+/// next to the current one.","+fn recorded_store_matches(recorded: &str, store_dir: &Path) -> bool {","+    let recorded = Path::new(recorded);","+    !recorded.as_os_str().is_empty()","+        && (same_path(recorded, store_dir)","+            || store_dir","+                .parent()","+                .is_some_and(|parent| same_path(recorded, &parent.join(\"v3\"))))","+}","+","+/// Upstream compares with `path.relative`: lexically, and on Windows after","+/// `toLowerCase`, which folds non-ASCII letters too.","+pub(in super::super) fn same_path(left: &Path, right: &Path) -> bool {","+    let left = pnpm_fs::lexical_normalize(left);","+    let right = pnpm_fs::lexical_normalize(right);","+    if cfg!(windows) {","+        left.to_string_lossy().to_lowercase() == right.to_string_lossy().to_lowercase()","+    } else {","+        left == right","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":125,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/modules_state/settings_diff/tests.rs","lines":["@@ -0,0 +1,49 @@","+use super::{super::super::InstallError, refuse_drifted_modules_dir, same_path};","+use pnpm_config::{Config, NodeLinker};","+use pnpm_modules_yaml::{LayoutVersion, ModulesLayout, NodeLinker as ModulesNodeLinker};","+use std::path::Path;","+","+#[test]","+fn same_path_compares_lexically() {","+    assert!(same_path(Path::new(\"/a/store/../store/v11\"), Path::new(\"/a/store/v11\")));","+    assert!(!same_path(Path::new(\"/a/store/v11\"), Path::new(\"/a/other/v11\")));","+}","+","+#[cfg(windows)]","+#[test]","+fn same_path_ignores_non_ascii_case_on_windows() {","+    assert!(same_path(Path::new(r\"C:\\Störe\\v11\"), Path::new(r\"c:\\STÖRE\\v11\")));","+    assert!(!same_path(Path::new(r\"C:\\Störe\\v11\"), Path::new(r\"C:\\Store\\v11\")));","+}","+","+#[test]","+fn an_unreadable_modules_manifest_is_refused() {","+    let result = refuse_drifted_modules_dir(None, &Config::new(), NodeLinker::Isolated);","+    assert!(matches!(result, Err(InstallError::ModulesBreakingChange { .. })), \"{result:?}\");","+}","+","+#[test]","+fn a_manifest_without_a_node_linker_is_an_isolated_layout() {","+    let config = Config::new();","+    let modules = ModulesLayout {","+        layout_version: Some(LayoutVersion),","+        store_dir: config.store_dir.display().to_string(),","+        virtual_store_dir: config","+            .virtual_store_dir()","+            .display()","+            .to_string(),","+        virtual_store_dir_max_length: config.virtual_store_dir_max_length,","+        hoist_pattern: config.hoist_pattern.clone(),","+        public_hoist_pattern: config.public_hoist_pattern.clone(),","+        node_linker: None,","+        ..ModulesLayout::default()","+    };","+    let isolated = refuse_drifted_modules_dir(Some(&modules), &config, NodeLinker::Isolated);","+    assert!(isolated.is_ok(), \"{isolated:?}\");","+    let hoisted = refuse_drifted_modules_dir(Some(&modules), &config, NodeLinker::Hoisted);","+    assert!(matches!(hoisted, Err(InstallError::NodeLinkerDiff)), \"{hoisted:?}\");","+    let recorded_hoisted =","+        ModulesLayout { node_linker: Some(ModulesNodeLinker::Hoisted), ..modules };","+    let result = refuse_drifted_modules_dir(Some(&recorded_hoisted), &config, NodeLinker::Isolated);","+    assert!(matches!(result, Err(InstallError::NodeLinkerDiff)), \"{result:?}\");","+}"],"additions":49,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/prepare_modules_state.rs","lines":["@@ -129,6 +129,7 @@ fn prepare_modules_layout(","             config: inputs.tree.config,","             workspace_root: inputs.tree.workspace_root,","             modules_manifest,","+            node_linker: inputs.tree.node_linker,","             installs_only: inputs.installs_only,","             filtered_install: inputs.repeat.filtered,","         })?;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/prepare_modules_state/purge.rs","lines":["@@ -1,6 +1,6 @@"," use super::super::{","-    Config, HashSet, IncludedDependencies, InstallError, Lockfile, Path, PathBuf,","-    check_modules_settings_diff,","+    Config, HashSet, IncludedDependencies, InstallError, Lockfile, NodeLinker, Path, PathBuf,"],"additions":1,"deletions":2,"truncated":false}],"additions":519,"deletions":45,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-10-25T13:32:41.637422+00:00"}