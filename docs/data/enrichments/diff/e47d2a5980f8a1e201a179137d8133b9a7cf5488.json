nt writers, while remaining valid on","+# old writers. Remove SELECT so SHOW GRANTS expands names instead of printing ALL.","+statement ok","+drop database if exists attach_table_compat;","+","+statement ok","+create database attach_table_compat;","+","+statement ok","+drop role if exists 'role_attach_table';","+","+statement ok","+create role 'role_attach_table';","+","+statement ok","+grant all on attach_table_compat.* to role 'role_attach_table';","+","+statement ok","+revoke select on attach_table_compat.* from role 'role_attach_table';"],"additions":21,"deletions":0,"truncated":false},{"path":"tests/sqllogictests/suites/base/05_ddl/05_0017_ddl_grant_role.test","lines":["@@ -177,8 +177,8 @@ OWNERSHIP s1 NULL ROLE account_admin (empty)"," query TTTTT"," select * EXCLUDE(object_id) from show_grants('database', 'db1', 'default');"," ----","-USAGE,CREATE,SELECT,INSERT,UPDATE,DELETE,DROP,ALTER,GRANT db1 ROLE role2 (empty)","-USAGE,CREATE,SELECT,INSERT,UPDATE,DELETE,DROP,ALTER,GRANT db1 ROLE role3 (empty)","+USAGE,CREATE,SELECT,INSERT,UPDATE,DELETE,DROP,ALTER,GRANT,ATTACH TABLE db1 ROLE role2 (empty)","+USAGE,CREATE,SELECT,INSERT,UPDATE,DELETE,DROP,ALTER,GRANT,ATTACH TABLE db1 ROLE role3 (empty)"," OWNERSHIP db1 ROLE account_admin (empty)"," "," query TTTTT"],"additions":2,"deletions":2,"truncated":false},{"path":"tests/suites/0_stateless/18_rbac/18_0020_attach_table_privilege.result","lines":["@@ -0,0 +1,9 @@","+CREATE-only role can create ordinary tables","+CREATE and SUPER do not imply ATTACH TABLE","+Database ownership does not imply ATTACH TABLE","+ATTACH TABLE does not replace CREATE","+CREATE with STORAGE_PREFIX cannot bypass ATTACH TABLE","+ATTACH TABLE cannot be granted on a table","+Administrator can grant and revoke ATTACH TABLE directly to USER","+Database ALL includes ATTACH TABLE","+Global ALL includes ATTACH TABLE"],"additions":9,"deletions":0,"truncated":false},{"path":"tests/suites/0_stateless/18_rbac/18_0020_attach_table_privilege.sh","lines":["@@ -0,0 +1,98 @@","+#!/usr/bin/env bash","+","+set -euo pipefail","+","+CURDIR=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)","+. \"$CURDIR\"/../../../shell_env.sh","+","+root_sql() {","+\tbendsql_connect_root_null --query=\"$1\"","+}","+","+user_sql() {","+\tlocal user=\"$1\"","+\tbendsql_connect_user \"$user\" password --output null --query=\"$2\"","+}","+","+expect_error() {","+\tlocal user=\"$1\" pattern=\"$2\" sql=\"$3\" output","+\tif output=$(user_sql \"$user\" \"$sql\" 2>&1); then","+\t\techo \"Expected failure: $sql\" >&2","+\t\texit 1","+\tfi","+\tif ! grep -Eq \"$pattern\" <<<\"$output\"; then","+\t\tprintf 'Unexpected error for %s:\\n%s\\n' \"$sql\" \"$output\" >&2","+\t\texit 1","+\tfi","+}","+","+cleanup() {","+\troot_sql \"","+DROP USER IF EXISTS attach_priv_creator;","+DROP USER IF EXISTS attach_priv_operator;","+DROP USER IF EXISTS attach_priv_owner;","+DROP DATABASE IF EXISTS attach_priv_db;","+DROP ROLE IF EXISTS attach_priv_creator;","+DROP ROLE IF EXISTS attach_priv_operator;","+DROP ROLE IF EXISTS attach_priv_owner;","+DROP ROLE IF EXISTS attach_priv_all;","+\"","+}","+","+cleanup","+trap cleanup EXIT","+root_sql \"","+CREATE DATABASE attach_priv_db;","+CREATE ROLE attach_priv_creator;","+CREATE ROLE attach_priv_operator;","+CREATE ROLE attach_priv_owner;","+CREATE ROLE attach_priv_all;","+CREATE USER attach_priv_creator IDENTIFIED BY 'password' WITH DEFAULT_ROLE = 'attach_priv_creator';","+CREATE USER attach_priv_operator IDENTIFIED BY 'password' WITH DEFAULT_ROLE = 'attach_priv_operator';","+CREATE USER attach_priv_owner IDENTIFIED BY 'password' WITH DEFAULT_ROLE = 'attach_priv_owner';","+GRANT ROLE attach_priv_creator TO USER attach_priv_creator;","+GRANT ROLE attach_priv_operator TO USER attach_priv_operator;","+GRANT ROLE attach_priv_owner TO USER attach_priv_owner;","+GRANT CREATE ON attach_priv_db.* TO ROLE attach_priv_creator;","+GRANT SUPER ON *.* TO ROLE attach_priv_creator;","+GRANT ATTACH TABLE ON attach_priv_db.* TO ROLE attach_priv_operator;","+GRANT OWNERSHIP ON attach_priv_db.* TO ROLE attach_priv_owner;","+\"","+","+echo \"CREATE-only role can create ordinary tables\"","+user_sql attach_priv_creator \"CREATE TABLE attach_priv_db.ordinary (a INT)\"","+","+# Use a valid local source so binding can finish before the execution access check.","+attach_sql=\"ATTACH TABLE attach_priv_db.attached 'fs:///tmp/1/2'\"","+echo \"CREATE and SUPER do not imply ATTACH TABLE\"","+expect_error attach_priv_creator '\\[1063\\].*\\[AttachTable\\]' \"$attach_sql\"","+echo \"Database ownership does not imply ATTACH TABLE\"","+expect_error attach_priv_owner '\\[1063\\].*\\[AttachTable\\]' \"$attach_sql\"","+echo \"ATTACH TABLE does not replace CREATE\"","+expect_error attach_priv_operator '\\[1063\\].*\\[Create\\]' \"$attach_sql\"","+echo \"CREATE with STORAGE_PREFIX cannot bypass ATTACH TABLE\"","+expect_error attach_priv_creator '\\[1063\\].*\\[AttachTable\\]' \"CREATE TABLE attach_priv_db.bypass (a INT) STORAGE_PREFIX = '1/2'\"","+","+echo \"ATTACH TABLE cannot be granted on a table\"","+if output=$(bendsql_connect_root --query=\"GRANT ATTACH TABLE ON attach_priv_db.ordinary TO ROLE attach_priv_operator\" 2>&1); then","+\techo \"Expected table-level GRANT to fail\" >&2","+\texit 1","+fi","+grep -q 'Illegal GRANT/REVOKE' <<<\"$output\"","+","+echo \"Administrator can grant and revoke ATTACH TABLE directly to USER\"","+root_sql \"GRANT ATTACH TABLE ON attach_priv_db.* TO USER attach_priv_creator\"","+output=$(bendsql_connect_root --query=\"SHOW GRANTS FOR USER attach_priv_creator\")","+grep -q 'ATTACH TABLE' <<<\"$output\"","+root_sql \"REVOKE ATTACH TABLE ON attach_priv_db.* FROM USER attach_priv_creator\"","+expect_error attach_priv_creator '\\[1063\\].*\\[AttachTable\\]' \"$attach_sql\"","+","+echo \"Database ALL includes ATTACH TABLE\"","+# Remove SELECT so SHOW GRANTS expands names instead of displaying the ALL shorthand.","+root_sql \"GRANT ALL ON attach_priv_db.* TO ROLE attach_priv_all; REVOKE SELECT ON attach_priv_db.* FROM ROLE attach_priv_all\"","+output=$(bendsql_connect_root --query=\"SHOW GRANTS FOR ROLE attach_priv_all\")","+grep -q 'ATTACH TABLE' <<<\"$output\"","+echo \"Global ALL includes ATTACH TABLE\"","+root_sql \"REVOKE ALL ON attach_priv_db.* FROM ROLE attach_priv_all; GRANT ALL ON *.* TO ROLE attach_priv_all; REVOKE SELECT ON *.* FROM ROLE attach_priv_all\"","+output=$(bendsql_connect_root --query=\"SHOW GRANTS FOR ROLE attach_priv_all\")","+grep -q 'ATTACH TABLE' <<<\"$output\"",""],"additions":98,"deletions":0,"truncated":false}],"additions":185,"deletions":13,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-16T14:20:25.077940+00:00"}