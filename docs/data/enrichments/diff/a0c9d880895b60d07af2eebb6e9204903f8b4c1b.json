tart,","+    int end, int step) {","+  if (start < 0 || end < 0) {","+    return emitError() << \"start, end must be zero or positive\";","+  }","+  if (step <= 0) {","+    return emitError() << \"step must be positive\";","+  }","+  if (start >= end) {","+    return emitError() << \"interval is empty\";","+  }","+  return mlir::success();","+}","+","+mlir::LogicalResult VifrtMappingV1Attr::verify(","+    llvm::function_ref<mlir::InFlightDiagnostic()> emitError,","+    VifrtIntervalV1Attr from_shards, VifrtIntervalV1Attr to_shards) {","+  if (from_shards == nullptr || to_shards == nullptr) {","+    return emitError() << \"expected non-null interval attributes\";","+  }","+  const int from_size = GetIntervalSize(from_shards);","+  const int to_size = GetIntervalSize(to_shards);","+  if (from_size != to_size) {","+    return emitError() << \"from has \" << from_size << \" and to has \" << to_size","+                       << \", but they must have the same number of shards.\";","+  }","+  return mlir::success();","+}","+","+mlir::LogicalResult VifrtArrayMappingV1Attr::verify(","+    llvm::function_ref<mlir::InFlightDiagnostic()> emitError,","+    int32_t in_array_index, int32_t out_array_index, mlir::ArrayAttr mappings) {","+  if (in_array_index < 0 || out_array_index < 0) {","+    return emitError()","+           << \"in_array_index and out_array_index must be non-negative\";","+  }","+  if (mappings == nullptr || mappings.empty() ||","+      !llvm::all_of(mappings.getValue(), llvm::IsaPred<VifrtMappingV1Attr>)) {","+    return emitError() << \"expected non-empty array of VifrtMappingV1Attr\";","+  }","+  return mlir::success();","+}","+","+mlir::LogicalResult VifrtTypeV1Attr::verify(","+    llvm::function_ref<mlir::InFlightDiagnostic()> emitError,","+    mlir::Type value) {","+  if (!isFromBuiltinOrVifrt(value)) {","+    return emitError() << \"expected VIFRT or builtin type\";","+  }","+  return mlir::success();","+}","+","+mlir::LogicalResult VifrtArrayV1Type::verify(","+    llvm::function_ref<mlir::InFlightDiagnostic()> emitError,","+    mlir::RankedTensorType shape, mlir::Attribute sharding_attr,","+    VifrtDevicesV1Attr devices_attr, mlir::StringAttr memory_kind_attr,","+    mlir::StringAttr layout_attr) {","+  if (shape == nullptr || devices_attr == nullptr ||","+      memory_kind_attr == nullptr || layout_attr == nullptr) {","+    return emitError() << \"expected non-null VifrtArrayV1Type parameters\";","+  }","+  if (sharding_attr == nullptr ||","+      !llvm::isa<VifrtShardingParamV2Attr, VifrtUnspecifiedShardingV1Attr>(","+          sharding_attr)) {","+    return emitError() << \"expected VIFRT sharding attribute\";","+  }","+  if (shape.getEncoding() != nullptr) {","+    return emitError() << \"Unexpected tensor encoding on array shape: \"","+                       << shape;","+  }","+  if (!shape.hasStaticShape()) {","+    return emitError() << \"Array shape must be static, got \" << shape;","+  }","+  int64_t num_elements = 1;","+  for (int64_t dim : shape.getShape()) {","+    if (__builtin_mul_overflow(num_elements, dim, &num_elements)) {","+      return emitError()","+             << \"Array shape element count overflows 64-bit signed integer: \"","+             << shape;","+    }","+  }","+  if (llvm::isa<VifrtTokenV1Type>(shape.getElementType())) {","+    if (!shape.getShape().empty()) {","+      return emitError() << \"Token type cannot have non-empty shape\";","+    }","+  } else if (!llvm::isa<VifrtStringV1Type>(shape.getElementType()) &&","+             shape.getElementType().getDialect().getNamespace() !=","+                 mlir::BuiltinDialect::getDialectNamespace()) {","+    return emitError() << \"Unsupported array element type: \"","+                       << shape.getElementType();","+  }","+  if (layout_attr.getValue() != kVifrtDefaultString) {","+    absl::StatusOr<xla::LayoutMode> layout_mode =","+        xla::LayoutMode::FromString(layout_attr.str());","+    if (!layout_mode.ok()) {","+      return emitError() << \"Invalid layout mode: \"","+                         << layout_mode.status().message();","+    }","+  }","+  if (auto sharding_param_attr =","+          llvm::dyn_cast<VifrtShardingParamV2Attr>(sharding_attr)) {","+    return sharding_param_attr.getSharding().CanApplyTo(emitError, shape,","+                                                        devices_attr.getIds());","+  }","+  return mlir::success();","+}","+","+mlir::LogicalResult VifrtFunctionV1Type::verify(","+    llvm::function_ref<mlir::InFlightDiagnostic()> emitError,","+    llvm::ArrayRef<mlir::Type> inputs, llvm::ArrayRef<mlir::Type> outputs) {","+  if (!allFromBuiltinOrVifrt(inputs) || !allFromBuiltinOrVifrt(outputs)) {","+    return emitError() << \"expected VIFRT or builtin types\";","+  }","+  return mlir::success();","+}","+","+//===----------------------------------------------------------------------===//","+// VIFRT Dialect","+//===----------------------------------------------------------------------===//"," "," VifrtDialect::VifrtDialect(mlir::MLIRContext* context)","     : mlir::Dialect(getDialectNamespace(), context,","@@ -192,9 +357,13 @@ VifrtDialect::VifrtDialect(mlir::MLIRContext* context)"," mlir::Type VifrtDialect::parseType(mlir::DialectAsmParser& parser) const {","   llvm::StringRef data_type;","   mlir::Type type;","-  auto parse_result_opt = parseVifrtType(parser, &data_type, type);","-  if (parse_result_opt.has_value() && mlir::succeeded(*parse_result_opt)) {","-    return type;","+  mlir::OptionalParseResult parse_result_opt =","+      parseVifrtType(parser, &data_type, type);","+  if (parse_result_opt.has_value()) {","+    if (mlir::succeeded(*parse_result_opt)) {","+      return type;","+    }","+    return nullptr;","   }","   parser.emitError(parser.getNameLoc()) << \"unknown vifrt type: \" << data_type;","   return nullptr;","@@ -212,11 +381,16 @@ mlir::Attribute VifrtDialect::parseAttribute(mlir::DialectAsmParser& parser,"],"additions":189,"deletions":2