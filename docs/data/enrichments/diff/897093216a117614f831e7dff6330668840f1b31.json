pth,","-\t}","-}","-","-func fromPublicQuery(q pub.Query) tracestore.TraceQueryParams {","-\treturn tracestore.TraceQueryParams{","-\t\tServiceName:   q.ServiceName,","-\t\tOperationName: q.OperationName,","-\t\tAttributes:    q.Attributes,","-\t\tStartTimeMin:  q.StartTimeMin,","-\t\tStartTimeMax:  q.StartTimeMax,","-\t\tDurationMin:   q.DurationMin,","-\t\tDurationMax:   q.DurationMax,","-\t\tSearchDepth:   q.SearchDepth,","-\t}","-}","-","-// onQuery runs every interceptor's OnQuery in order, threading the context each","-// returns into the next. The final context is returned so callers can pass it to","-// the storage reader and to onResult, letting an interceptor carry per-query state","-// (e.g. a resolved caller identity) from the pre-query hook to the return path.","-func (r *reader) onQuery(ctx context.Context, query tracestore.TraceQueryParams) (context.Context, tracestore.TraceQueryParams, error) {","-\tpq := toPublicQuery(query)","-\tvar err error","-\tfor _, interceptor := range r.interceptors {","-\t\tctx, pq, err = interceptor.OnQuery(ctx, pq)","-\t\tif err != nil {","-\t\t\treturn ctx, query, err","-\t\t}","-\t}","-\treturn ctx, fromPublicQuery(pq), nil","-}","-","-// onResult runs every interceptor's OnResult in order on one batch, threading the","-// context each returns into the next. The final context is returned so the caller","-// can feed it into onResult for the next batch, letting state accumulate across a","-// multi-batch result.","-func (r *reader) onResult(ctx context.Context, traces []ptrace.Traces) (context.Context, []ptrace.Traces, error) {","-\tvar err error","-\tfor _, interceptor := range r.interceptors {","-\t\tctx, traces, err = interceptor.OnResult(ctx, traces)","-\t\tif err != nil {","-\t\t\treturn ctx, nil, err","-\t\t}","-\t}","-\treturn ctx, traces, nil","-}","-","-func (r *reader) FindTraces(ctx context.Context, query tracestore.TraceQueryParams) iter.Seq2[[]ptrace.Traces, error] {","-\treturn func(yield func([]ptrace.Traces, error) bool) {","-\t\tvar err error","-\t\t// onQuery returns the (possibly enriched) context and gated query; assign","-\t\t// them back so every statement below sees the post-hook values, never the","-\t\t// originals. The same applies to onResult's context inside the loop.","-\t\tctx, query, err = r.onQuery(ctx, query)","-\t\tif err != nil {","-\t\t\tyield(nil, err)","-\t\t\treturn","-\t\t}","-\t\tfor traces, err := range r.next.FindTraces(ctx, query) {","-\t\t\tif err != nil {","-\t\t\t\tif !yield(nil, err) {","-\t\t\t\t\treturn","-\t\t\t\t}","-\t\t\t\tcontinue","-\t\t\t}","-\t\t\tctx, traces, err = r.onResult(ctx, traces)","-\t\t\tif err != nil {","-\t\t\t\t// Per the Interceptor contract, an OnResult error aborts the stream:","-\t\t\t\t// stop rather than emit further batches, which could leak results the","-\t\t\t\t// failed sanitize/redaction was meant to withhold.","-\t\t\t\tyield(nil, err)","-\t\t\t\treturn","-\t\t\t}","-\t\t\tif !yield(traces, nil) {","-\t\t\t\treturn","-\t\t\t}","-\t\t}","-\t}","-}","-","-func (r *reader) FindTraceIDs(ctx context.Context, query tracestore.TraceQueryParams) iter.Seq2[[]tracestore.FoundTraceID, error] {","-\treturn func(yield func([]tracestore.FoundTraceID, error) bool) {","-\t\tvar err error","-\t\tctx, query, err = r.onQuery(ctx, query)","-\t\tif err != nil {","-\t\t\tyield(nil, err)","-\t\t\treturn","-\t\t}","-\t\tfor ids, err := range r.next.FindTraceIDs(ctx, query) {","-\t\t\tif !yield(ids, err) {","-\t\t\t\treturn","-\t\t\t}","-\t\t}","-\t}","-}","-","-func (r *reader) GetTraces(ctx context.Context, traceIDs ...tracestore.GetTraceParams) iter.Seq2[[]ptrace.Traces, error] {","-\treturn func(yield func([]ptrace.Traces, error) bool) {","-\t\t// GetTraces has no pre-query hook, so OnResult's context chain seeds from","-\t\t// the inbound context; assigning it back threads across batches.","-\t\tfor traces, err := range r.next.GetTraces(ctx, traceIDs...) {","-\t\t\tif err != nil {","-\t\t\t\tif !yield(nil, err) {","-\t\t\t\t\treturn","-\t\t\t\t}","-\t\t\t\tcontinue","-\t\t\t}","-\t\t\tctx, traces, err = r.onResult(ctx, traces)","-\t\t\tif err != nil {","-\t\t\t\t// Per the Interceptor contract, an OnResult error aborts the stream:","-\t\t\t\t// stop rather than emit further batches, which could leak results the","-\t\t\t\t// failed sanitize/redaction was meant to withhold.","-\t\t\t\tyield(nil, err)","-\t\t\t\treturn","-\t\t\t}","-\t\t\tif !yield(traces, nil) {","-\t\t\t\treturn","-\t\t\t}","-\t\t}","-\t}","-}","-","-// SearchCapabilities forwards the wrapped reader's declaration: an interceptor gates","-// and sanitizes queries, it does not change which query shapes the backend accepts.","-func (r *reader) SearchCapabilities(ctx context.Context) (tracestore.SearchCapabilities, error) {","-\treturn r.next.SearchCapabilities(ctx)","-}","-","-func (r *reader) GetServices(ctx context.Context) ([]string, error) {","-\treturn r.next.GetServices(ctx)","-}","-","-func (r *reader) GetOperations(ctx context.Context, query tracestore.OperationQueryParams) ([]tracestore.Operation, error) {","-\treturn r.next.GetOperations(ctx, query)","-}","-","-// FindTraceSummaries forwards to the wrapped reader's FindTraceSummaries,","-// applying OnQuery gating to the search. When the wrapped reader has no native","-// summary support it yields errors.ErrUnsupported and the query service falls","-// back to FindTraces (which this decorator also gates). OnResult is not applied","-// here: summaries carry only per-trace metadata (not spans), and the Interceptor","-// contract has no summary hook — so an interceptor gates/constrains the summary","-// search via OnQuery, but cannot drop or redact individual summaries. A dedicated","-// summary hook is left as a contract extension.","-func (r *reader) FindTraceSummaries(ctx context.Context, query tracestore.TraceQueryParams) iter.Seq2[[]tracestore.TraceSummary, error] {","-\treturn func(yield func([]tracestore.TraceSummary, error) bool) {","-\t\tvar err err