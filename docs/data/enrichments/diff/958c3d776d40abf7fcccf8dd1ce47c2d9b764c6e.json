ion ? 'encrypted' : 'plaintext'),","+                RequestClientInterface::TAG => self::field(Ttlv::BYTES, str_repeat('t', 16)),","+            ];","+        });","+        $kms = new KmipKms($client, 12, self::CIPHER);","+        $encrypted = $kms->encrypt('key', 'plaintext', \"aad\\0bytes\");","+","+        $this->assertSame(self::HEADER, substr($encrypted->blob, 0, 10));","+        $this->assertSame('plaintext', $kms->decrypt($encrypted, \"aad\\0bytes\"));","+    }","+","+    public function testFactorySelectsTheCipher()","+    {","+        $kms = (new KmipKmsFactory())->create(Dsn::fromString('kmip://localhost?cert=a&key=b&version=2.0&cipher=chacha20-poly1305'));","+        $cipher = (new \\ReflectionProperty($kms, 'cipher'))->getValue($kms);","+        $encrypted = $cipher->encrypt(self::authenticatedClient(), 'key', 'plaintext', 'aad');","+","+        $this->assertStringStartsWith(self::HEADER, $encrypted->blob);","+    }","+","+    #[DataProvider('plaintexts')]","+    public function testBinaryAndEmptyPlaintextRoundTrip(string $plaintext)","+    {","+        $client = self::authenticatedClient();","+        $kms = new KmipKms($client, 12, self::CIPHER);","+        $encrypted = $kms->encrypt('key', $plaintext, 'aad');","+","+        $this->assertStringStartsWith(self::HEADER, $encrypted->blob);","+        $this->assertSame($plaintext, $kms->decrypt($encrypted, 'aad'));","+        $this->assertNotSame($encrypted->blob, $kms->encrypt('key', $plaintext, 'aad')->blob);","+    }","+","+    public static function plaintexts(): iterable","+    {","+        yield 'empty' => [''];","+        yield 'binary' => [\"plain\\0\\xFFtext\"];","+    }","+","+    public function testExistingAesGcmCiphertextRemainsReadable()","+    {","+        $client = self::authenticatedClient('42001105000000040000000900000000'","+            .'42002805000000040000000300000000'","+            .'4200cd02000000040000008000000000'","+            .'4200ce02000000040000001000000000');","+        $encrypted = (new KmipKms($client, 16))->encrypt('key', 'existing plaintext', 'aad');","+","+        $this->assertSame('existing plaintext', (new KmipKms($client, 12, self::CIPHER))->decrypt($encrypted, 'aad'));","+    }","+","+    public function testStoredCipherIsReadAfterSelectingAesGcm()","+    {","+        $client = self::authenticatedClient('42002805000000040000001e00000000');","+        $encrypted = (new KmipKms($client, 12, self::CIPHER))->encrypt('key', 'plaintext', 'aad');","+","+        $this->assertStringStartsWith(self::HEADER, $encrypted->blob);","+        $this->assertSame('plaintext', (new KmipKms($client, 16, 'aes-gcm'))->decrypt($encrypted, 'aad'));","+    }","+","+    #[DataProvider('tampering')]","+    public function testTamperedCiphertextAndAssociatedDataAreRejected(?int $offset, string $aad)","+    {","+        $client = self::authenticatedClient();","+        $kms = new KmipKms($client, 12, self::CIPHER);","+        $encrypted = $kms->encrypt('key', 'plaintext', 'aad');","+        $this->assertStringStartsWith(self::HEADER, $encrypted->blob);","+        $blob = $encrypted->blob;","+        if (null !== $offset) {","+            $blob[$offset] = \\chr(\\ord($blob[$offset]) ^ 1);","+        }","+","+        $this->expectException(DecryptionFailedException::class);","+        $kms->decrypt(new Ciphertext($blob, 'key'), $aad);","+    }","+","+    public static function tampering(): iterable","+    {","+        yield 'format' => [0, 'aad'];","+        yield 'algorithm' => [4, 'aad'];","+        yield 'mode' => [8, 'aad'];","+        yield 'nonce length' => [9, 'aad'];","+        yield 'nonce' => [10, 'aad'];","+        yield 'tag' => [22, 'aad'];","+        yield 'encrypted data' => [38, 'aad'];","+        yield 'wrong AAD' => [null, 'wrong'];","+        yield 'missing AAD' => [null, ''];","+    }","+","+    public function testDataKeyWrappingUsesTheSelectedCipher()","+    {","+        $client = self::authenticatedClient();","+        $kms = new KmipKms($client, 12, self::CIPHER);","+        $generated = $kms->generateDataKey('key', 32, 'aad');","+        $plaintext = $generated->use(static fn (string $value): string => $value);","+","+        $this->assertStringStartsWith(self::HEADER, $generated->wrapped->blob);","+        $this->assertSame($plaintext, $kms->unwrapDataKey($generated->wrapped, 'aad')->use(static fn (string $value): string => $value));","+        $this->assertSame($plaintext, $kms->decrypt($kms->wrapDataKey('key', $plaintext, 'aad'), 'aad'));","+    }","+","+    #[DataProvider('invalidResponses')]","+    public function testMalformedResponsesAreRejected(string $fault, string $message)","+    {","+        $client = self::client(static function (int $operation, string $payload) use ($fault): array {","+            $fields = self::fields($payload);","+            self::assertSame(self::HEADER.'aad', $fields[RequestClientInterface::AAD]['value']);","+            $response = [","+                RequestClientInterface::UNIQUE_IDENTIFIER => self::field(Ttlv::TEXT, 'key'),","+                RequestClientInterface::DATA => self::field(Ttlv::BYTES, 'x'),","+                RequestClientInterface::TAG => self::field(Ttlv::BYTES, str_repeat('t', 16)),","+            ];","+            match ($fault) {","+                'missing tag' => $response[RequestClientInterface::TAG] = null,"],"additions":154,"deletions":0,"truncated":false}],"additions":236,"deletions":44,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-01T15:16:25.801410+00:00"}