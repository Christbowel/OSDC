r cookieStore = await GetReferenceAsync().ConfigureAwait(false);","+        await cookieStore.InvokeVoidAsync(\"set\", name, value).ConfigureAwait(false);","+    }","+","+    /// <summary>","+    /// Sets a cookie with the specified options, replacing any existing cookie with the same name, domain, and path that has the same partitioning.","+    /// </summary>","+    /// <param name=\"options\">The name, value, and attributes of the cookie.</param>","+    /// <returns>A <see cref=\"ValueTask\"/> representing the completion of the operation.</returns>","+    /// <exception cref=\"ArgumentNullException\"><paramref name=\"options\"/> is <see langword=\"null\"/>.</exception>","+    /// <exception cref=\"NotSupportedException\">The browser does not provide the Cookie Store API for the current page.</exception>","+    [DynamicDependency(LinkerFlags.JsonSerialized, typeof(CookieInit))]","+    public async ValueTask SetAsync(CookieInit options)","+    {","+        ArgumentNullException.ThrowIfNull(options);","+","+        var cookieStore = await GetReferenceAsync().ConfigureAwait(false);","+        await cookieStore.InvokeVoidAsync(\"set\", options).ConfigureAwait(false);","+    }","+","+    /// <summary>","+    /// Deletes the unpartitioned cookie with the specified name that is restricted to the host of the current page and has the path <c>\"/\"</c>, if it exists.","+    /// A partitioned cookie, or a cookie with another domain or path, is not deleted.","+    /// </summary>","+    /// <param name=\"name\">The name of the cookie to delete.</param>","+    /// <returns>A <see cref=\"ValueTask\"/> representing the completion of the operation.</returns>","+    /// <exception cref=\"ArgumentNullException\"><paramref name=\"name\"/> is <see langword=\"null\"/>.</exception>","+    /// <exception cref=\"NotSupportedException\">The browser does not provide the Cookie Store API for the current page.</exception>","+    public async ValueTask DeleteAsync(string name)","+    {","+     