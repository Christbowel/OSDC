Http2Section_8_2_1.java","lines":["@@ -90,6 +90,58 @@ public void testInvalidResponseHeaders() throws Exception {","     }"," "," ","+    /*","+     * Pseudo header fields set by the application must not be sent. The only pseudo header field in a response is the","+     * :status that Tomcat generates and it must appear exactly once.","+     */","+    @Test","+    public void testApplicationSetPseudoHeaders() throws Exception {","+        enableHttp2();","+","+        Tomcat tomcat = getTomcatInstance();","+","+        Context ctxt = getProgrammaticRootContext();","+        Tomcat.addServlet(ctxt, \"simple\", new SimpleServlet());","+        ctxt.addServletMapping(\"/simple\", \"simple\");","+        Tomcat.addServlet(ctxt, \"pseudo\", new PseudoHeadersServlet());","+        ctxt.addServletMapping(\"/pseudo\", \"pseudo\");","+","+        tomcat.start();","+","+        openClientConnection();","+        doHttpUpgrade();","+        sendClientPreface();","+        validateHttp2InitialResponse();","+","+        // Repeat to check that the HPACK dynamic table is still consistent","+        for (int streamId = 3; streamId < 7; streamId += 2) {","+            byte[] frameHeader = new byte[9];","+            ByteBuffer headersPayload = ByteBuffer.allocate(128);","+            buildGetRequest(frameHeader, headersPayload, null, streamId, \"/pseudo\");","+            writeFrame(frameHeader, headersPayload);","+","+            // Headers","+            parser.readFrame();","+            // Body","+            parser.readFrame();","+","+            String id = Integer.toString(streamId);","+            String trace = output.getTrace();","+            // Exactly one :status and it is the one generated by Tomcat","+            Assert.assertTrue(trace, trace.contains(id + \"-Header-[:status]-[200]\\n\"));","+            Assert.assertEquals(trace, 1, trace.split(\":status\", -1).length - 1);","+            Assert.assertFalse(trace, trace.contains(\"-[999]\"));","+            Assert.