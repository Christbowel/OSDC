arValue();","+        return c == 9 || c == 32;","+    }","+","+","+    private void doTest(String input, String corrected, boolean edge) {","+        String result = HeaderUtil.sanitizeFieldValue(input);","+","+        if (isTooBig()) {","+            Assert.assertNull(result);","+        } else if (isCtl() || edge && isWhitespace()) {","+            Assert.assertEquals(corrected, result);","+        } else {","+            // Valid character. The value must be returned as is.","+            Assert.assertSame(input, result);","+        }","+    }","+","+","+    @Test","+    public void testAtStart() {","+        // A CTL is replaced with a space and whitespace is trimmed","+        doTest(charUnderTest + VALID_STRING, VALID_STRING, true);","+    }","+","+","+    @Test","+    public void testInMiddle() {","+        doTest(VALID_STRING + charUnderTest + VALID_STRING, VALID_STRING + ' ' + VALID_STRING, false);","+    }","+","+","+    @Test","+    public void testAtEnd() {","+        // A CTL is replaced with a space and whitespace is trimmed","+        doTest(VALID_STRING + charUnderTest, VALID_STRING, true);","+    }","+","+","+    @Test","+    public void testEmpty() {","+        Assert.assertEquals(\"\", HeaderUtil.sanitizeFieldValue(\"\"));","+    }","+","+","+    @Test","+    public void testWhitespaceOnly() {","+        Assert.assertEquals(\"\", HeaderUtil.sanitizeFieldValue(\" \\t \"));","+    }","+","+","+    @Test","+    public void testTrim() {","+        Assert.assertEquals(\"a b\", HeaderUtil.sanitizeFieldValue(\" \\ta b\\t \"));","+    }","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"webapps/docs/changelog.xml","lines":["@@ -326,6 +326,10 @@","         Accept an unknown complete length in the <code>Content-Range</code>.","         header. Pull request <pr>1107</pr> provided by Arturo Bernal. (markt)","       </fix>","+      <fix>","+        Add HTTP/2 response header filtering similar to that provided for","+        HTTP/1.1. Pull reques