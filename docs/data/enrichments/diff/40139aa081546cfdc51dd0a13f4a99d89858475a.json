edByEditorWithoutDefaultLanguageAccess(): void","+    {","+        $this->getConnectionPool()->getConnectionForTable('pages')->update('pages', ['perms_everybody' => 31], ['uid' => 1]);","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/be_users_language_restricted.csv');","+        $backendUser = $this->setUpBackendUser(20);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+","+        $subject = $this->get(ManualLocalizationHandler::class);","+","+        $result = $subject->processLocalization(new LocalizationInstructions(","+            mainRecordType: 'tt_content',","+            recordUid: 1,","+            sourceLanguageId: self::LANGUAGE_PRESETS['EN']['id'],","+            targetLanguageId: self::LANGUAGE_PRESETS['DA']['id'],","+            mode: LocalizationMode::TRANSLATE,","+            additionalData: []","+        ));","+","+        self::assertTrue($result->isSuccess(), 'Localization should succeed: ' . var_export($result->errors, true));","+","+        $queryBuilder = $this->getConnectionPool()->getQueryBuilderForTable('tt_content');","+        $queryBuilder->getRestrictions()->removeByType(HiddenRestriction::class);","+        $translations = $queryBuilder","+            ->select('uid', 'sys_language_uid', 'l18n_parent')","+            ->from('tt_content')","+            ->where($queryBuilder->expr()->eq('l18n_parent', $queryBuilder->createNamedParameter(1, Connection::PARAM_INT)))","+            ->executeQuery()","+            ->fetchAllAssociative();","+","+        self::assertCount(1, $translations);","+        self::assertSame(1, (int)$translations[0]['sys_language_uid']);","+    }","+","+    #[Test]","+    public function pageGetsTranslatedByEditorWithoutDefaultLanguageAccess(): void","+    {","+        $this->getConnectionPool()->getConnectionForTable('pages')->update('pages', ['perms_everybody' => 31], ['uid' => 1]);","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/be_users_language_restricted.csv');","+        $backendUser = $this->setUpBackendUser(20);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+","+        $subject = $this->get(ManualLocalizationHandler::class);","+","+        $result = $subject->processLocalization(new LocalizationInstructions(","+            mainRecordType: 'pages',","+            recordUid: 1,","+            sourceLanguageId: self::LANGUAGE_PRESETS['EN']['id'],","+            targetLanguageId: self::LANGUAGE_PRESETS['DA']['id'],","+            mode: LocalizationMode::TRANSLATE,","+            additionalData: ['selectedRecordUids' => [1, 2, 3]]","+        ));","+","+        self::assertTrue($result->isSuccess(), 'Localization should succeed: ' . var_export($result->errors, true));","+","+        $queryBuilder = $this->getConnectionPool()->getQueryBuilderForTable('pages');","+        $queryBuilder->getRestrictions()->removeByType(HiddenRestriction::class);","+        $translations = $queryBuilder","+            ->select('uid', 'sys_language_uid')","+            ->from('pages')","+            ->where($queryBuilder->expr()->eq('l10n_parent', $queryBuilder->createNamedParameter(1, Connection::PARAM_INT)))","+            ->executeQuery()","+            ->fetchAllAssociative();","+","+        self::assertCount(1, $translations);","+    }","+","+    #[Test]","+    public function recordsGetTranslatedByEditorWithoutExcludeFieldAccessForLanguageField(): void","+    {","+        $this->getConnectionPool()->getConnectionForTable('pages')->update('pages', ['perms_everybody' => 31], ['uid' => 1]);","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/be_users_editor.csv');","+        $backendUser = $this->setUpBackendUser(21);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+","+        $subject = $this->get(ManualLocalizationHandler::class);","+","+        $result = $subject->processLocalization(new LocalizationInstructions(","+            mainRecordType: 'tt_content',","+            recordUid: 1,","+            sourceLanguageId: self::LANGUAGE_PRESETS['EN']['id'],","+            targetLanguageId: self::LANGUAGE_PRESETS['DA']['id'],","+            mode: LocalizationMode::TRANSLATE,","+            additionalData: []","+        ));","+","+        self::assertTrue($result->isSuccess(), 'Localization should succeed: ' . var_export($result->errors, true));","+","+        $queryBuilder = $this->getConnectionPool()->getQueryBuilderForTable('tt_content');","+        $queryBuilder->getRestrictions()->removeByType(HiddenRestriction::class);","+        $translations = $queryBuilder","+            ->select('uid', 'sys_language_uid', 'l18n_parent')","+            ->from('tt_content')","+            ->where($queryBuilder->expr()->eq('l18n_parent', $queryBuilder->createNamedParameter(1, Connection::PARAM_INT)))","+            ->executeQuery()","+            ->fetchAllAssociative();","+","+        self::assertCount(1, $translations);","+        self::assertSame(1, (int)$translations[0]['sys_language_uid']);","+    }","+","+    #[Test]","+    public function plainCopyOfTranslatedRecordKeepsLanguageForEditorWithoutExcludeFieldAccess(): void","+    {","+        $this->importCSVDataSet(__DIR__ . '/../Controller/Page/Fixtures/tt_content-danish-language.csv');","+        $this->getConnectionPool()->getConnectionForTable('pages')->update('pages', ['perms_everybody' => 31], ['uid' => 1]);","+        $this->importCSVDataSet(__DIR__ . '/Fixtures/be_users_editor.csv');","+        $backendUser = $this->setUpBackendUser(21);","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+","+        $dataHandler = $this->get(DataHandler::class);","+        $dataHandler->start([], ['tt_content' => [4 => ['copy' => 1]]]);","+        $dataHandler->process_cmdmap();","+        self::assertSame([], $dataHandler->errorLog);","+","+        $newUid = (int)($dataHandler->copyMappingArray_merged['tt_content'][4] ?? 0);","+        self::assertGreaterThan(0, $newUid);","+","+        $queryBuilder = $this->getConnectionPool()->getQueryBuilderForTable('tt_content');","+        $queryBuilder->getRestrictions()->removeByType(HiddenRestriction::class);","+        $copy = $queryBuilder","+            ->select('uid', 'sys_language_uid')","+            ->from('tt_content')","+            ->where($queryBuilder->expr()->eq('uid', $queryBuilder->createNamedParameter($newUid, Connection::PARAM_INT)))","+            ->executeQuery()","+            ->fetchAssociative();","+","+        self::assertSame(1, (int)$copy['sys_language_uid']);","+    }","+","     #[Test]","     public function handlerReturnsCorrectMetadata(): void","     {"],"additions":130,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Configuration/Tca/TcaEnrichment.php","lines":["@@ -192,7 +192,6 @@ private function enrichLanguageField(array $tca): array","             $languageFieldName = $tableDefinition['ctrl']['languageField'] ?? null;","             if ($languageFieldName && !is_array($tableDefinition['columns'][$languageFieldName] ?? null)) {","                 $tca[$table]['columns'][$languageFieldName] = [","-                    'exclude' => true,","                     'label' => 'core.db.general:language',","                     'config' => [","                         'type' => 'language',"],"additions":0,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Classes/Configuration/Tca/TcaMigration.php","lines":["@@ -55,6 +55,7 @@ public function migrate(array $tca): TcaProcessingResult","         $tcaProcessingResult = $this->removeSetToDefaultOnCopy($tcaProcessingResult);","         $tcaProcessingResult = $this->removeEnableMultiSelectFilterTextfieldConfiguration($tcaProcessingResult);","         $tcaProcessingResult = $this->removeExcludeFieldForTransOrigPointerField($tcaProcessingResult);","+        $tcaProcessingResult = $this->removeExcludeFieldForLanguageField($tcaProcessingResult);","         $tcaProcessingResult = $this->removeShowRecordFieldListField($tcaProcessingResult);","         $tcaProcessingResult = $this->removeMaxDBListItems($tcaProcessingResult);","         $tcaProcessingResult = $this->removeWorkspacePlaceholderShadowColumnsConfiguration($tcaProcessingResult);","@@ -292,6 +293,35 @@ protected function removeExcludeFieldForTransOrigPointerField(TcaProcessingResul","         return $tcaProcessingResult->withTca($tca);","     }"," ","+    /**","+     * Removes $TCA[$mytable][columns][_languageField_][exclude] if enabled.","+     *","+     * Access to the language field is governed by the backend user group","+     * permission 'allowed_languages', not by 'non_exclude_fields'.","+     */","+    protected function removeExcludeFieldForLanguageField(TcaProcessingResult $tcaProcessingResult): TcaProcessingResult","+    {","+        $tca = $tcaProcessingResult->getTca();","+        foreach ($tca as $table => &$configuration) {","+            $languageField = $configuration['ctrl']['languageField'] ?? null;","+            if ($languageField === null) {","+                continue;","+            }","+            // The (bool) cast mirrors AbstractFieldType::supportsAccessControl(), so the","+            // legacy notation 'exclude' => 1 is migrated as well. An explicitly disabled","+            // flag is left untouched on purpose.","+            if ((bool)($configuration['columns'][$languageField]['exclude'] ?? false) !== true) {","+                continue;","+            }","+            $tcaProcessingResult = $tcaProcessingResult->withAdditionalMessages('The \\'' . $table . '\\' TCA tables languageField '","+                . '\\'' . $languageField . '\\' is defined as excluded field. Access to the language field is '","+                . 'governed by the backend user group permission \\'allowed_languages\\' instead, the \\'exclude\\' '","+                . 'flag is therefore ignored and should be removed.');","+            unset($configuration['columns'][$languageField]['exclude']);","+        }","+        return $tcaProcessingResult->withTca($tca);","+    }","+","     /**","      * Removes $TCA[$mytable]['interface']['showRecordFieldList'] and also $TCA[$mytable]['interface']","      * if `showRecordFieldList` was the only key in the array."],"additions":30,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Schema/Field/LanguageFieldType.php","lines":["@@ -24,6 +24,11 @@ public function getType(): string","         return 'language';","     }"," ","+    public function supportsAccessControl(): false","+    {","+        return false;","+    }","+","     public function isSearchable(): false","     {","         return false;"],"additions":5,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Configuration/TCA/Overrides/pages.php","lines":["@@ -18,9 +18,6 @@"," // 'editlock' has l10n_mode=exclude, note 'tt_content' does not have this ..."," $GLOBALS['TCA']['pages']['columns']['editlock']['l10n_mode'] = 'exclude';"," ","-// 'sys_language_uid' has exclude=true by default, unset this for pages","-unset($GLOBALS['TCA']['pages']['columns']['sys_language_uid']['exclude']);","-"," // transOrigPointerField needs an adaptions on pages table, deviating from default:"," // sys_language_uid = -1 is not allowed."," $GLOBALS['TCA']['pages']['columns']['l10n_parent']['config']['foreign_table_where'] = 'AND {#pages}.{#uid}=###CURRENT_PID### AND {#pages}.{#sys_language_uid} = ' . LanguageMarker::DEFAULT_LANGUAGE;"],"additions":0,"deletions":3,"truncated":false},{"path":"typo3/sysext/core/Configuration/TCA/Overrides/sys_file_metadata.php","lines":["@@ -2,9 +2,6 @@"," "," defined('TYPO3') or die();"," ","-// 'sys_language_uid' is part of a hidden palette, there is no access rights configuration for it.","-unset($GLOBALS['TCA']['sys_file_metadata']['columns']['sys_language_uid']['exclude']);","-"," // @todo: transOrigPointerField is configured differently. Needed? Possible to keep default?"," $GLOBALS['TCA']['sys_file_metadata']['columns']['l10n_parent']['config'] = [","     'type' => 'group',"],"additions":0,"deletions":3,"truncated":false},{"path":"typo3/sysext/core/Configuration/TCA/Overrides/sys_file_reference.php","lines":["@@ -2,8 +2,7 @@"," "," defined('TYPO3') or die();"," ","-// 'sys_language_uid' and 'hidden' are part of a hidden palette, there is no access rights configuration for them.","-unset($GLOBALS['TCA']['sys_file_reference']['columns']['sys_language_uid']['exclude']);","+// 'hidden' is part of a hidden palette, there is no access rights configuration for it."," unset($GLOBALS['TCA']['sys_file_reference']['columns']['hidden']['exclude']);"," "," // @todo: transOrigPointerField is configured differently. Needed? Possible to keep default?"],"additions":1,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Important-76274-LanguageFieldIsNoLongerAnExcludeField.rst","lines":["@@ -0,0 +1,59 @@","+..  include:: /Includes.rst.txt","+","+..  _important-76274-1789813130:","+","+================================================================","+Important: #76274 - Language field is no longer an exclude field","+================================================================","+","+See :issue:`76274`","+","+Description","+===========","+","+The TCA column referenced by :php:`$GLOBALS['TCA'][$table]['ctrl']['languageField']`","+is no longer marked as :php:`'exclude' => true`.","+","+Access to this field is governed by the backend user group permission","+:php:`allowed_languages`, which is evaluated in both the form and in","+:php:`DataHandler`. Marking the column as an \"exclude field\" added a second,","+unrelated permission on top of it: :php:`non_exclude_fields`.","+","+That second permission caused actual damage. Whenever a backend user without the","+exclude field right for the language field triggered a write, :php:`DataHandler`","+silently dropped the language value. Translating a record therefore created a","+record in the *default* language that still pointed to its source record, and","+copying a translated record moved the copy into the default language. No error","+was raised, and editors restricted to a non-default language could not see the","+resulting record at all.","+","+Three changes were made:","+","+*   The automatically created :php:`columns` definition for the language field no","+    longer contains :php:`exclude`.","+*   A TCA migration removes :php:`exclude` from the language field if a table","+    defines the column itself, or re-adds the flag in a","+    :file:`Configuration/TCA/Overrides` file.","+*   The TCA schema field type for :php:`'type' => 'language'` never reports","+    access control, so an :php:`exclude` flag set elsewhere, for example in","+    :php:`columnsOverrides`, is ignored as well.","+","+Impact","+======","+","+Entries of the form :php:`<table>:<languageField>` in the :php:`non_exclude_fields`","+permission of a backend user group no longer have any effect and can be removed.","+","+The visibility of the language field now follows the language permissions alone:","+:php:`TcaColumnsRemoveEmptyRelations` removes the field from the form when fewer","+than two languages are available to the current backend user, so editors","+restricted to a single language do not see it. Editors with access to two or more","+languages now see the language selector on tables that render it in a palette,","+and can pick any language covered by their :php:`allowed_languages`.","+","+Extensions that define the language column in their own","+:file:`Configuration/TCA/<table>.php` should remove the :php:`exclude` key from","+that definition. The migration logs a deprecation message naming the affected","+table until this is done.","+","+..  index:: Backend, TCA, ext:core"],"additions":59,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageOfNewParent.csv","lines":["rename from typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageOfNewParentWithoutLanguageAccess.csv","rename to typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/Fixtures/InlineChildLanguageOfNewParent.csv","@@ -1,8 +1,8 @@"," \"tx_testirrecsv_hotel\""," ,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"offers\""," ,1,1,\"Hotel #1\",0,0,\"1\"","-,2,1,\"Hotel #2\",0,0,\"2\"","+,2,1,\"Hotel #2\",0,-1,\"2\""," \"tx_testirrecsv_offer\""," ,\"uid\",\"pid\",\"title\",\"deleted\",\"sys_language_uid\",\"prices\""," ,1,1,\"Offer #1\",0,0,\"1\"","-,2,1,\"Offer #2\",0,0,\"\"","+,2,1,\"Offer #2\",0,-1,\"\""],"additions":2,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/DataHandling/DataHandler/InlineChildLanguageTest.php","lines":["@@ -49,7 +49,7 @@ public function childrenFollowStoredLanguageOfNewParent(): void","         ]);"," ","         self::assertSame([], $dataHandler->errorLog);","-        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageOfNewParentWithoutLanguageAccess.csv');","+        $this->assertCSVDataSet(__DIR__ . '/Fixtures/InlineChildLanguageOfNewParent.csv');","     }"," ","     #[Test]"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Tests/Unit/Configuration/Tca/TcaEnrichmentTest.php","lines":["@@ -326,7 +326,6 @@ public function languageFieldIsAddedToColumns(): void","             ],","         ];","         $expected = [","-            'exclude' => true,","             'label' => 'core.db.general:language',","             'config' => [","                 'type' => 'language',"],"additions":0,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Tests/Unit/Configuration/Tca/TcaMigrationTest.php","lines":["@@ -412,6 +412,26 @@ public function removeExcludeFieldForTransOrigPointerFieldIsRemoved(): void","         self::assertEquals($expected, $subject->migrate($input)->getTca());","     }"," ","+    public static function excludeFieldForLanguageFieldDataProvider(): iterable","+    {","+        $ctrl = ['languageField' => 'sys_language_uid'];","+        yield 'exclude true is removed' => [$ctrl, ['exclude' => true], []];","+        yield 'legacy notation exclude 1 is removed' => [$ctrl, ['exclude' => 1], []];","+        yield 'exclude false is kept' => [$ctrl, ['exclude' => false], ['exclude' => false]];","+        yield 'missing exclude is kept' => [$ctrl, [], []];","+        yield 'column without languageField in ctrl is kept' => [[], ['exclude' => true], ['exclude' => true]];","+    }","+","+    #[DataProvider('excludeFieldForLanguageFieldDataProvider')]","+    #[Test]","+    public function removeExcludeFieldForLanguageField(array $ctrl, array $column, array $expectedColumn): void","+    {","+        $config = ['config' => ['type' => 'language']];","+        $input = ['aTable' => ['ctrl' => $ctrl, 'columns' => ['sys_language_uid' => $column + $config]]];","+        $expected = ['aTable' => ['ctrl' => $ctrl, 'columns' => ['sys_language_uid' => $expectedColumn + $config]]];","+        self::assertEquals($expected, new TcaMigration()->migrate($input)->getTca());","+    }","+","     #[Test]","     public function removeShowRecordFieldListFieldIsRemoved(): void","     {"],"additions":20,"deletions":0,"truncated":false},{"path":"typo3/sysext/extbase/Tests/Functional/Fixtures/Extensions/extbase_upload/Configuration/TCA/tx_extbaseupload_domain_model_singlefile.php","lines":["@@ -45,7 +45,6 @@","     ],","     'columns' => [","         'sys_language_uid' => [","-            'exclude' => true,","             'label' => 'core.db.general:fe_group.language',","             'config' => [","                 'type' => 'language',",""],"additions":0,"deletions":1,"truncated":false}],"additions":260,"deletions":14,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-11-28T17:10:22.380255+00:00"}