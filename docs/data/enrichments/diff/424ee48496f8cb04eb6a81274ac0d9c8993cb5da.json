ce.php","lines":["@@ -0,0 +1,152 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+namespace OCA\\DAV\\CalDAV\\Federation;","+","+use OCA\\DAV\\AppInfo\\Application;","+use OCA\\DAV\\BackgroundJob\\FederatedCalendarSyncJob;","+use OCA\\Federation\\TrustedServers;","+use OCP\\App\\IAppManager;","+use OCP\\BackgroundJob\\IJobList;","+use OCP\\Federation\\ICloudIdManager;","+use OCP\\IURLGenerator;","+use OCP\\Notification\\IManager as INotificationManager;","+use OCP\\Server;","+use Psr\\Log\\LoggerInterface;","+","+class FederatedCalendarInvitationService {","+\tpublic const NOTIFICATION_OBJECT_TYPE = 'federated_calendar_share';","+\tpublic const NOTIFICATION_SUBJECT_NEW_SHARE = 'federated_calendar_share';","+","+\tprivate const PRINCIPAL_PREFIX = 'principals/users/';","+","+\tpublic function __construct(","+\t\tprivate readonly FederatedCalendarMapper $mapper,","+\t\tprivate readonly IJobList $jobList,","+\t\tprivate readonly INotificationManager $notificationManager,","+\t\tprivate readonly IURLGenerator $url,","+\t\tprivate readonly ICloudIdManager $cloudIdManager,","+\t\tprivate readonly CalendarFederationConfig $config,","+\t\tprivate readonly IAppManager $appManager,","+\t\tprivate readonly LoggerInterface $logger,","+\t) {","+\t}","+","+\tpublic function accept(FederatedCalendarEntity $calendar): void {","+\t\t$calendar->setState(FederatedCalendarEntity::STATE_ACCEPTED);","+\t\t$this->mapper->update($calendar);","+","+\t\t$this->jobList->add(FederatedCalendarSyncJob::class, [","+\t\t\tFederatedCalendarSyncJob::ARGUMENT_ID => $calendar->getId(),","+\t\t]);","+","+\t\t$this->dismissNotification($calendar);","+\t}","+","+\tpublic function decline(FederatedCalendarEntity $calendar): void {","+\t\t// Dismiss first: a leftover bell notification would offer actions for","+\t\t// a share that no longer exists","+\t\t$this->dismissNotification($calendar);","+\t\t$this->mapper->deleteById($calendar->getId());","+\t}","+","+\tpublic function notifyAboutNewShare(FederatedCalendarEntity $calendar): void {","+\t\t$notification = $this->notificationManager->createNotification();","+\t\t$notification->setApp(Application::APP_ID)","+\t\t\t->setUser($this->getUserId($calendar))","+\t\t\t->setDateTime(new \\DateTime())","+\t\t\t->setObject(self::NOTIFICATION_OBJECT_TYPE, (string)$calendar->getId())","+\t\t\t->setSubject(self::NOTIFICATION_SUBJECT_NEW_SHARE, [","+\t\t\t\t'sharedBy' => $calendar->getSharedBy(),","+\t\t\t\t'sharedByDisplayName' => $calendar->getSharedByDisplayName(),","+\t\t\t\t'calendarName' => $calendar->getDisplayName(),","+\t\t\t]);","+","+\t\t$endpointUrl = $this->url->linkToOCSRouteAbsolute('dav.federated_calendar.accept', [","+\t\t\t'id' => $calendar->getId(),","+\t\t]);","+","+\t\t$declineAction = $notification->createAction();","+\t\t$declineAction->setLabel('decline')","+\t\t\t->setLink($endpointUrl, 'DELETE');","+\t\t$notification->addAction($declineAction);","+","+\t\t$acceptAction = $notification->createAction();","+\t\t$acceptAction->setLabel('accept')","+\t\t\t->setLink($endpointUrl, 'POST');","+\t\t$notification->addAction($acceptAction);","+","+\t\t$this->notificationManager->notify($notification);","+\t}","+","+\tpublic function dismissNotification(FederatedCalendarEntity $calendar): void {","+\t\t$notification = $this->notificationManager->createNotification();","+\t\t$notification->setApp(Application::APP_ID)","+\t\t\t->setUser($this->getUserId($calendar))","+\t\t\t->setObject(self::NOTIFICATION_OBJECT_TYPE, (string)$calendar->getId());","+\t\t$this->notificationManager->markProcessed($notification);","+\t}","+","+\tpublic function shouldAutoAccept(?string $ownerCloudId, string $remoteUrl): bool {","+\t\tif ($ownerCloudId === null || $ownerCloudId === '') {","+\t\t\treturn false;","+\t\t}","+","+\t\tif (!$this->config->isTrustedShareAutoAcceptEnabled()) {","+\t\t\