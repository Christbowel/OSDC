alue::GetChildren(*value);"],"additions":1,"deletions":1,"truncated":false},{"path":"src/parser/keyword_helper.cpp","lines":["@@ -62,7 +62,7 @@ string KeywordHelper::WriteQuoted(const string &text, char quote) {"," static bool RequiresQuotesForPrinting(const string &text, bool allow_caps) {"," \t// After a qualification dot, an underscore followed by a digit can begin a decimal literal."," \tconst bool ambiguous_after_dot = text.size() > 1 && text[0] == '_' && StringUtil::CharacterIsDigit(text[1]);","-\treturn ambiguous_after_dot || KeywordHelper::RequiresQuotes(text, allow_caps);","+\treturn text.empty() || ambiguous_after_dot || KeywordHelper::RequiresQuotes(text, allow_caps);"," }"," "," string KeywordHelper::WriteOptionallyQuoted(const string &text, char quote, bool allow_caps) {"],"additions":1,"deletions":1,"truncated":false},{"path":"src/storage/table/struct_column_data.cpp","lines":["@@ -16,8 +16,6 @@ StructColumnData::StructColumnData(BlockManager &block_manager, DataTableInfo &i","     : ColumnData(block_manager, info, column_index, std::move(type_p), data_type, parent) {"," \tD_ASSERT(type.InternalType() == PhysicalType::STRUCT);"," \tauto &child_types = StructType::GetChildTypes(type);","-\t// unnamed structs are deserialized as TUPLEs and never produced as a column type otherwise","-\tD_ASSERT(type.id() != LogicalTypeId::STRUCT || child_types.empty() || !StructType::IsUnnamed(type));"," \tif (type.id() == LogicalTypeId::VARIANT) {"," \t\tthrow NotImplementedException(\"A table cannot be created from a VARIANT column yet\");"," \t}"],"additions":0,"deletions":2,"truncated":false},{"path":"test/sql/storage/types/variant/variant_shredding_empty_keys.test","lines":["@@ -30,9 +30,9 @@ CHECKPOINT"," query I"," select * from fails;"," ----","-(world, hello)","+{'': world, 'x': hello}"," "," query I"," select * from succeeds;"," ----","-(1, {'y': t})","+{'': 1, 'x': {'y': t}}"],"additions":2,"deletions":2,"truncated":false},{"path":"test/sql/types/struct/unnamed_struct_to_tuple.test","lines":["@@ -0,0 +1,98 @@","+# name: test/sql/types/struct/unnamed_struct_to_tuple.test","+# description: Structs created without member names are TUPLEs, structs with some empty member names stay STRUCTs","+# group: [struct]","+","+require parquet","+","+require json","+","+load {TEST_DIR}/unnamed_struct_to_tuple.db","+","+# a parquet group whose only field has an empty name is read as a TUPLE","+query IIII","+SELECT s, m, typeof(s), typeof(m) FROM 'data/parquet-testing/empty_field_names.parquet' ORDER BY ALL","+----","+(1,)\t{'': 1, 'x': a}\tTUPLE(INTEGER)\tSTRUCT(\"\" INTEGER, x VARCHAR)","+(2,)\t{'': 2, 'x': b}\tTUPLE(INTEGER)\tSTRUCT(\"\" INTEGER, x VARCHAR)","+(3,)\t{'': 3, 'x': c}\tTUPLE(INTEGER)\tSTRUCT(\"\" INTEGER, x VARCHAR)","+","+# filters, extracts and casts on both","+query II","+SELECT s[1], m.\"x\" FROM 'data/parquet-testing/empty_field_names.parquet' WHERE s[1] >= 2 ORDER BY ALL","+----","+2\tb","+3\tc","+","+query II","+SELECT s::JSON, m::JSON FROM 'data/parquet-testing/empty_field_names.parquet' ORDER BY ALL","+----","+[1]\t{\"\":1,\"x\":\"a\"}","+[2]\t{\"\":2,\"x\":\"b\"}","+[3]\t{\"\":3,\"x\":\"c\"}","+","+# a STRUCT with a leading empty member name is still a named STRUCT (cast by name, not positionally)","+query I","+SELECT m::STRUCT(x VARCHAR, y INTEGER) FROM (SELECT m FROM 'data/parquet-testing/empty_field_names.parquet' LIMIT 1)","+----","+{'x': a, 'y': NULL}","+","+statement error","+SELECT m::STRUCT(a INTEGER, b VARCHAR) FROM 'data/parquet-testing/empty_field_names.parquet'","+----","+<REGEX>:.*Binder Error.*","+","+# a top-level column with an empty name","+query I","+SELECT * FROM 'data/parquet-testing/empty_root_column_name.parquet'","+----","+1","+2","+","+# the types survive storage","+statement ok","+CREATE TABLE tbl AS FROM 'data/parquet-testing/empty_field_names.parquet'","+","+restart","+","+query II","+SELECT typeof(s), typeof(m) FROM tbl LIMIT 1","+----","+TUPLE(INTEGER)\tSTRUCT(\"\" INTEGER, x VARCHAR)","+","+query II","+SELECT s::JSON, m::JSON FROM tbl ORDER BY ALL LIMIT 1","+----","+[1]\t{\"\":1,\"x\":\"a\"}","+","+# json_transform rejects empty keys in the structure","+statement error","+SELECT json_transform('{\"\": \"a\"}', '{\"\": \"VARCHAR\"}')","+----","+Empty key in object in JSON structure","+","+statement error","+SELECT json_transform('{\"\": 1, \"a\": 2}', '{\"a\": \"INTEGER\", \"\": \"INTEGER\"}')","+----","+Empty key in object in JSON structure","+","+# JSON auto-detection falls back to a MAP for objects with an empty key","+query I","+SELECT typeof(a) FROM read_json('data/json/internal_3813.json', map_inference_threshold=10)","+----","+STRUCT(l1k2 MAP(VARCHAR, BIGINT))","+","+query I","+SELECT typeof(a) FROM read_json('data/json/internal_3813.json', map_inference_threshold=-1)","+----","+STRUCT(l1k2 JSON)","+","+# a VARIANT object with a single empty key is not converted to a TUPLE","+query II","+SELECT v::VARCHAR, v::JSON FROM (SELECT '{\"\": 1}'::JSON::VARIANT v)","+----","+{''=1}\t{\"\":1}","+","+query II","+SELECT v::VARCHAR, v::JSON FROM (SELECT '{\"\": 1, \"x\": {\"\": [2]}}'::JSON::VARIANT v)","+----","+{'': 1, 'x': {''=[2]}}\t{\"\":1,\"x\":{\"\":[2]}}",""],"additions":98,"deletions":0,"truncated":false}],"additions":163,"deletions":56,"truncated":false,"file_count":23},"error":null,"fetched_at":"2026-10-06T14:37:03.841259+00:00"}