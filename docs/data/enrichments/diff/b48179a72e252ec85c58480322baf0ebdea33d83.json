   (void)once;","     uWS::SocketContextOptions sco;","     static_assert(sizeof(sco) == sizeof(options));","     memcpy(&sco, &options, sizeof(sco));"],"additions":0,"deletions":2,"truncated":false},{"path":"src/uws_sys/quic.rs","lines":["@@ -26,13 +26,3 @@ pub use self::stream::Stream;"," "," pub use self::header::Header;"," pub use self::header::Qpack;","-","-unsafe extern \"C\" {","-    // safe: no args; idempotent C-side initialization with no preconditions.","-    pub(crate) safe fn us_quic_global_init();","-}","-","-#[inline]","-pub fn global_init() {","-    us_quic_global_init()","-}"],"additions":0,"deletions":10,"truncated":false},{"path":"src/uws_sys/quic/Context.rs","lines":["@@ -3,6 +3,7 @@"," //! lives for the process; the server creates one per `Bun.serve({http3:true})`."," "," use core::ffi::{CStr, c_char, c_int, c_uint, c_void};","+use core::ptr::NonNull;"," "," use crate::Loop;"," use crate::quic::{OwnedPendingConnect, Socket, Stream};","@@ -73,18 +74,12 @@ pub enum ConnectResult {"," }"," "," impl Context {","-    /// # Safety","-    /// `global_init` has run.","     #[inline]","-    pub unsafe fn create_client(","-        loop_: &'static Loop,","-        ext_size: c_uint,","-        conn_ext: c_uint,","-        stream_ext: c_uint,","-    ) -> Option<*mut Context> {","-        // SAFETY: thin FFI forward; all args are POD, return is nullable.","-        let p = unsafe { us_create_quic_client_context(loop_, ext_size, conn_ext, stream_ext) };","-        if p.is_null() { None } else { Some(p) }","+    pub fn create_client(loop_: &'static Loop) -> Option<NonNull<Context>> {","+        // The slot of `Socket::ext` and `Stream::ext`.","+        const EXT: c_uint = size_of::<*mut c_void>() as c_uint;","+        // SAFETY: the context keeps `loop_`, which is `'static`.","+        NonNull::new(unsafe { us_create_quic_client_context(loop_, 0, EXT, EXT) })","     }"," ","     pub fn connect("],"additions":6,"deletions":11,"truncated":false},{"path":"test/js/node/quic/quic-endpoint.test.ts","lines":["@@ -330,6 +330,33 @@ describe(\"node:quic in a Worker\", () => {","   }, 30000);"," });"," ","+describe(\"a handshake in flight\", () => {","+  test.concurrent.each([\"Bun.serve\", \"fetch\", \"node:quic\"])(","+    \"completes when %s makes its first QUIC engine\",","+    async api => {","+      await using proc = Bun.spawn({","+        cmd: [","+          bunExe(),","+          join(import.meta.dir, \"quic-handshake-in-flight-fixture.ts\"),","+          api,","+          join(keysDir, \"agent1-key.pem\"),","+          join(keysDir, \"agent1-cert.pem\"),","+        ],","+        env: bunEnv,","+        stdout: \"pipe\",","+        stderr: \"pipe\",","+      });","+      const [stdout, stderr, exitCode] = await Promise.all([proc.stdout.text(), proc.stderr.text(), proc.exited]);","+      // stderr contains the ExperimentalWarning.","+      expect({ stdout, stderr, exitCode }).toEqual({","+        stdout: '{\"result\":\"answered\",\"connections\":1}\\n',","+        stderr: expect.any(String),","+        exitCode: 0,","+      });","+    },","+  );","+});","+"," // lsquic queues a stateless reset for retry when its send fails. The endpoint socket sets IP_RECVERR,"," // so on Linux the ICMP port unreachable for one reset fails the next send with ECONNREFUSED."," describe(\"endpoint.close() with an unsent stateless reset\", () => {"],"additions":27,"deletions":0,"truncated":false},{"path":"test/js/node/quic/quic-handshake-in-flight-fixture.ts","lines":["@@ -0,0 +1,89 @@","+// Holds a QUIC handshake half way, and meanwhile makes the first lsquic engine of the API named in argv.","+import { createPrivateKey } from \"node:crypto\";","+import { readFileSync } from \"node:fs\";","+import { SocketAddress } from \"node:net\";","+import { connect, listen, type SessionOptions } from \"node:quic\";","+","+const [api, keyPath, certPath] = process.argv.slice(2);","+const key = readFileSync(keyPath);","+const cert = readFileSync(certPath);","+const hostname = \"127.0.0.1\";","+","+const serve = () =>","+  Bun.serve({ hostname, port: 0, tls: { key, cert }, http3: true, fetch: async req => new Response(await req.text()) });","+const post = (port: number) =>","+  fetch(`https://${hostname}:${port}/`, {","+    method: \"POST\",","+    body: \"answered\",","+    protocol: \"http3\",","+    tls: { rejectUnauthorized: false },","+  } as RequestInit);","+const listenQuic = () =>","+  listen(","+    session => {","+      session.onerror = () => {};","+      session.closed.catch(() => {});","+    },","+    { sni: { \"*\": { keys: [createPrivateKey(key)], certs: [cert] } }, alpn: [\"quic-test\"] },","+  );","+","+const serverPort = api === \"node:quic\" ? serve().port! : (await listenQuic()).address!.port;","+const serverAnswered = Promise.withResolvers<void>();","+let held: Buffer[] | undefined = [];","+let clientPort: number;","+// fetch() opens another connection if a handshake fails before the request is sent.","+const clientConnectionIds = new Set<string>();","+const relay = await Bun.udpSocket({","+  hostname,","+  socket: {","+    data(socket, bytes, port) {","+      if (port !== serverPort) {","+        clientPort = port;","+        // RFC 9000 section 17.2: the Source Connection ID of a long header.","+        if (bytes[0] & 0x80) {","+          const lengthAt = 6 + bytes[5];","+          clientConnectionIds.add(bytes.toString(\"hex\", lengthAt + 1, lengthAt + 1 + bytes[lengthAt]));","+        }","+        socket.send(bytes, serverPort, hostname);","+      } else if (held) {","+        held.push(Buffer.from(bytes));","+        serverAnswered.resolve();","+      } else {","+        socket.send(bytes, clientPort, hostname);","+      }","+    },","+  },","+});","+","+let result: Promise<string>;","+if (api === \"node:quic\") {","+  result = post(relay.port).then(res => res.text());","+} else {","+  const client = await connect(new SocketAddress({ address: hostname, port: relay.port }), {","+    alpn: \"quic-test\",","+    verifyPeer: \"manual\",","+    onerror() {},","+  } as SessionOptions);","+  client.closed.catch(() => {});","+  result = client.opened.then(() => \"answered\");","+}","+result.catch(serverAnswered.reject);","+await serverAnswered.promise;","+","+if (api === \"node:quic\") {","+  await listenQuic();","+} else if (api === \"Bun.serve\") {","+  serve();","+} else {","+  // The HTTP thread has its engine once it sends.","+  const sent = Promise.withResolvers<void>();","+  const silent = await Bun.udpSocket({ hostname, socket: { data: () => sent.resolve() } });","+  post(silent.port).catch(sent.reject);","+  await sent.promise;","+}","+","+for (const bytes of held) relay.send(bytes, clientPort!, hostname);","+held = undefined;","+","+console.log(JSON.stringify({ result: await result.catch(err => err.message), connections: clientConnectionIds.size }));","+process.exit(0);",""],"additions":89,"deletions":0,"truncated":false}],"additions":199,"deletions":108,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-16T17:22:50.546193+00:00"}