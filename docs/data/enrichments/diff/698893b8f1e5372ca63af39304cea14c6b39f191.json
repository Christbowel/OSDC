{"id":"698893b8f1e5372ca63af39304cea14c6b39f191","axis":"silent","repo":"pnpm/pnpm","sha":"698893b8f1e5372ca63af39304cea14c6b39f191","parsed":{"files":[{"path":".changeset/pnpr-metrics-and-request-ids.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+pnpr now exposes Prometheus metrics at `GET /-/metrics` and `GET /metrics`, tracks request IDs, and enriches access logs [pnpm/tasks#131](https://github.com/pnpm/tasks/issues/131). The metrics endpoint emits standard Prometheus text format with in-flight gauges, request counters, duration histograms, and cache statistics. Requests forward and echo `x-request-id` headers or receive generated UUIDs. Access logs under `pnpr::access` record request IDs, authenticated usernames, client IPs, user agents, status codes, latencies, and byte counts."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -1,4 +1,6 @@"," pub(crate) use client_ip::{ClientIp, resolve_client_ip};","+pub(crate) use metrics::{ServerMetrics, serve_metrics, serve_metrics_or_packument};","+pub(crate) use request_id::{RequestId, generate_request_id, is_valid_request_id};"," pub(crate) use tcp_listener::PeerAddr;"," "," pub(crate) use self::striped_locks::StripedLocks;","@@ -88,6 +90,7 @@ mod ecosystem;"," mod health;"," use health::shutdown_signal;"," mod managed_state;","+mod metrics;"," mod oci;"," mod oidc;"," mod oidc_groups;","@@ -97,6 +100,7 @@ mod pypi;"," mod rate_limit;"," use rate_limit::LoginRateLimiter;"," mod registry_directory;","+mod request_id;"," mod routing;"," mod rule_admin;"," mod rule_overrides;"],"additions":4,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/authentication.rs","lines":["@@ -40,7 +40,7 @@ impl Action {"," /// once, and the identity a handler sees is the same one the restriction"," /// gate already approved (no second lookup, no policy/identity race)."," #[derive(Clone)]","-pub(super) struct AuthedCaller(pub(super) Identity);","+pub(crate) struct AuthedCaller(pub(super) Identity);"," "," impl<RouterState: Send + Sync> FromRequestParts<RouterState> for AuthedCaller {","     type Rejection = Response;","@@ -99,10 +99,12 @@ pub(super) async fn authenticate(","                 if let Err(err) = refuse_deprovisioned(&state, &identity) {","                     return err.into_response();","                 }","-                request","-                    .extensions_mut()","-                    .insert(AuthedCaller(identity));","-                return next.run(request).await;","+                let caller = AuthedCaller(identity);","+                record_user_on_span(&caller.0);","+                request.extensions_mut().insert(caller.clone());","+                let mut response = next.run(request).await;","+                response.extensions_mut().insert(caller);","+                return response;","             }","             Ok(None) => {}","             Err(response) => return response,","@@ -117,10 +119,20 @@ pub(super) async fn authenticate(","         Ok(identity) => identity,","         Err(err) => return err.into_response(),","     };","-    request","-        .extensions_mut()","-        .insert(AuthedCaller(identity));","-    next.run(request).await","+    let caller = AuthedCaller(identity);","+    record_user_on_span(&caller.0);","+    request.extensions_mut().insert(caller.clone());","+    let mut response = next.run(request).await;","+    response.extensions_mut().insert(caller);","+    response","+}","+","+fn record_user_on_span(identity: &Identity) {","+    if let Some(username) = identity.username() {","+        tracing::Span::current().record(\"user\", tracing::field::display(username));","+    } else {","+        tracing::Span::current().record(\"user\", \"-\");","+    }"," }"," "," fn resolve_and_attach_client_ip(request: &mut Request, state: &AppState) -> Option<IpAddr> {"],"additions":21,"deletions":9,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/metrics.rs","lines":["@@ -0,0 +1,257 @@","+use std::{","+    fmt::Write,","+    sync::atomic::{AtomicI64, AtomicU64, Ordering},","+    time::Duration,","+};","+","+use axum::{","+    extract::State,","+    http::{HeaderMap, StatusCode, header},","+    response::{IntoResponse, Response},","+};","+use dashmap::DashMap;","+","+use super::{AppState, AuthedCaller, TargetRegistry, serve_packument};","+","+pub(crate) const DURATION_BUCKETS: [f64; 11] =","+    [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0];","+","+pub(crate) struct InFlightGuard<'a>(&'a AtomicI64);","+","+impl<'a> InFlightGuard<'a> {","+    pub(crate) fn new(counter: &'a AtomicI64) -> Self {","+        counter.fetch_add(1, Ordering::Relaxed);","+        Self(counter)","+    }","+}","+","+impl Drop for InFlightGuard<'_> {","+    fn drop(&mut self) {","+        self.0.fetch_sub(1, Ordering::Relaxed);","+    }","+}","+","+struct DurationHistogram {","+    buckets: [AtomicU64; 11],","+    sum_micros: AtomicU64,","+    count: AtomicU64,","+}","+","+impl DurationHistogram {","+    fn new() -> Self {","+        Self {","+            buckets: Default::default(),","+            sum_micros: AtomicU64::new(0),","+            count: AtomicU64::new(0),","+        }","+    }","+","+    fn record(&self, duration: Duration) {","+        let secs = duration.as_secs_f64();","+        for (index, &bound) in DURATION_BUCKETS.iter().enumerate() {","+            if secs <= bound {","+                self.buckets[index].fetch_add(1, Ordering::Relaxed);","+            }","+        }","+        self.sum_micros.fetch_add(duration.as_micros() as u64, Ordering::Relaxed);","+        self.count.fetch_add(1, Ordering::Relaxed);","+    }","+}","+","+fn normalize_method(method: &str) -> &'static str {","+    match method {","+        \"GET\" => \"GET\",","+        \"HEAD\" => \"HEAD\",","+        \"POST\" => \"POST\",","+        \"PUT\" => \"PUT\",","+        \"DELETE\" => \"DELETE\",","+        \"PATCH\" => \"PATCH\",","+        \"OPTIONS\" => \"OPTIONS\",","+        _ => \"OTHER\",","+    }","+}","+","+pub(crate) struct ServerMetrics {","+    pub(crate) in_flight: AtomicI64,","+    requests_total: DashMap<(&'static str, u16), AtomicU64>,","+    duration: DurationHistogram,","+    response_bytes_total: AtomicU64,","+    cache_hits_total: AtomicU64,","+    cache_misses_total: AtomicU64,","+    login_rate_limits_total: AtomicU64,","+}","+","+impl ServerMetrics {","+    pub(crate) fn new() -> Self {","+        Self {","+            in_flight: AtomicI64::new(0),","+            requests_total: DashMap::new(),","+            duration: DurationHistogram::new(),","+            response_bytes_total: AtomicU64::new(0),","+            cache_hits_total: AtomicU64::new(0),","+            cache_misses_total: AtomicU64::new(0),","+            login_rate_limits_total: AtomicU64::new(0),","+        }","+    }","+","+    pub(crate) fn start_in_flight(&self) -> InFlightGuard<'_> {","+        InFlightGuard::new(&self.in_flight)","+    }","+","+    pub(crate) fn record_request(&self, method: &str, status: u16, duration: Duration, bytes: u64) {","+        let key = (normalize_method(method), status);","+        if let Some(counter) = self.requests_total.get(&key) {","+            counter.fetch_add(1, Ordering::Relaxed);","+        } else {","+            self.requests_total","+                .entry(key)","+                .or_insert_with(|| AtomicU64::new(0))","+                .fetch_add(1, Ordering::Relaxed);","+        }","+","+        self.duration.record(duration);","+        self.response_bytes_total.fetch_add(bytes, Ordering::Relaxed);","+    }","+","+    pub(crate) fn record_cache_hit(&self) {","+        self.cache_hits_total.fetch_add(1, Ordering::Relaxed);","+    }","+","+    pub(crate) fn record_cache_miss(&self) {","+        self.cache_misses_total.fetch_add(1, Ordering::Relaxed);","+    }","+","+    pub(crate) fn record_login_throttled(&self) {","+        self.login_rate_limits_total.fetch_add(1, Ordering::Relaxed);","+    }","+","+    pub(crate) fn render_prometheus(&self) -> String {","+        let mut buffer = String::with_capacity(2048);","+","+        writeln!(buffer, \"# HELP pnpr_build_info Information about the pnpr build.\").unwrap();","+        writeln!(buffer, \"# TYPE pnpr_build_info gauge\").unwrap();","+        writeln!(buffer, \"pnpr_build_info{{version=\\\"{}\\\"}} 1\\n\", env!(\"CARGO_PKG_VERSION\"))","+            .unwrap();","+","+        writeln!(","+            buffer,","+            \"# HELP pnpr_http_requests_in_flight Current number of HTTP requests being processed.\",","+        )","+        .unwrap();","+        writeln!(buffer, \"# TYPE pnpr_http_requests_in_flight gauge\").unwrap();","+        let in_flight = self.in_flight.load(Ordering::Relaxed).max(0);","+        writeln!(buffer, \"pnpr_http_requests_in_flight {in_flight}\\n\").unwrap();","+","+        self.render_requests_total(&mut buffer);","+        self.render_duration_histogram(&mut buffer);","+","+        writeln!(buffer, \"# HELP pnpr_http_response_bytes_total Total response bytes served.\")","+            .unwrap();","+        writeln!(buffer, \"# TYPE pnpr_http_response_bytes_total counter\").unwrap();","+        let bytes = self.response_bytes_total.load(Ordering::Relaxed);","+        writeln!(buffer, \"pnpr_http_response_bytes_total {bytes}\\n\").unwrap();","+","+        self.render_counters(&mut buffer);","+        buffer","+    }","+","+    fn render_requests_total(&self, buffer: &mut String) {","+        writeln!(","+            buffer,","+            \"# HELP pnpr_http_requests_total Total number of HTTP requests processed.\",","+        )","+        .unwrap();","+        writeln!(buffer, \"# TYPE pnpr_http_requests_total counter\").unwrap();","+        let mut entries: Vec<_> = self.requests_total","+            .iter()","+            .map(|entry| (*entry.key(), entry.value().load(Ordering::Relaxed)))","+            .collect();","+        entries.sort_by(|entry_a, entry_b| entry_a.0.cmp(&entry_b.0));","+        for ((method, status), count) in entries {","+            writeln!(","+                buffer,","+                r#\"pnpr_http_requests_total{{method=\"{method}\",status=\"{status}\"}} {count}\"#,","+            )","+            .unwrap();","+        }","+        buffer.push('\\n');","+    }","+","+    fn render_duration_histogram(&self, buffer: &mut String) {","+        writeln!(","+            buffer,","+            \"# HELP pnpr_http_request_duration_seconds HTTP request latencies in seconds.\",","+        )","+        .unwrap();","+        writeln!(buffer, \"# TYPE pnpr_http_request_duration_seconds histogram\").unwrap();","+        for (index, &bound) in DURATION_BUCKETS.iter().enumerate() {","+            let count = self.duration.buckets[index].load(Ordering::Relaxed);","+            writeln!(","+                buffer,","+                r#\"pnpr_http_request_duration_seconds_bucket{{le=\"{bound}\"}} {count}\"#,","+            )","+            .unwrap();","+        }","+        let total = self.duration.count.load(Ordering::Relaxed);","+        writeln!(buffer, r#\"pnpr_http_request_duration_seconds_bucket{{le=\"+Inf\"}} {total}\"#)","+            .unwrap();","+        let sum = (self.duration.sum_micros.load(Ordering::Relaxed) as f64) / 1_000_000.0;","+        writeln!(buffer, \"pnpr_http_request_duration_seconds_sum {sum:.6}\").unwrap();","+        writeln!(buffer, \"pnpr_http_request_duration_seconds_count {total}\\n\").unwrap();","+    }","+","+    fn render_counters(&self, buffer: &mut String) {","+        writeln!(buffer, \"# HELP pnpr_cache_hits_total Total proxy cache hits.\").unwrap();","+        writeln!(buffer, \"# TYPE pnpr_cache_hits_total counter\").unwrap();","+        let hits = self.cache_hits_total.load(Ordering::Relaxed);","+        writeln!(buffer, \"pnpr_cache_hits_total {hits}\\n\").unwrap();","+","+        writeln!(buffer, \"# HELP pnpr_cache_misses_total Total proxy cache misses.\").unwrap();","+        writeln!(buffer, \"# TYPE pnpr_cache_misses_total counter\").unwrap();","+        let misses = self.cache_misses_total.load(Ordering::Relaxed);","+        writeln!(buffer, \"pnpr_cache_misses_total {misses}\\n\").unwrap();","+","+        writeln!(","+            buffer,","+            \"# HELP pnpr_login_rate_limits_total Total login requests throttled by rate limit.\",","+        )","+        .unwrap();","+        writeln!(buffer, \"# TYPE pnpr_login_rate_limits_total counter\").unwrap();","+        let rate_limits = self.login_rate_limits_total.load(Ordering::Relaxed);","+        writeln!(buffer, \"pnpr_login_rate_limits_total {rate_limits}\").unwrap();","+    }","+}","+","+/// Serve Prometheus metrics in standard text format.","+///","+/// Unauthenticated access is intentional to allow telemetry scrapers (such as","+/// Prometheus) to collect server metrics without credentials.","+pub(crate) async fn serve_metrics(State(state): State<AppState>) -> Response {","+    let rendered = state.inner.metrics.render_prometheus();","+    (StatusCode::OK, [(header::CONTENT_TYPE, \"text/plain; version=0.0.4; charset=utf-8\")], rendered)","+        .into_response()","+}","+","+/// Serve Prometheus metrics at `/metrics`, or delegate to packument lookup when","+/// requested with npm client accept headers.","+pub(crate) async fn serve_metrics_or_packument(","+    state: State<AppState>,","+    caller: AuthedCaller,","+    target: TargetRegistry,","+    headers: HeaderMap,","+) -> Response {","+    let is_npm_packument_request = headers","+        .get(header::ACCEPT)","+        .and_then(|value| value.to_str().ok())","+        .is_some_and(|accept| {","+            (accept.contains(\"application/vnd.npm.install-v1+json\")","+                || accept.contains(\"application/json\"))","+                && !accept.contains(\"text/plain\")","+        });","+","+    if is_npm_packument_request {","+        serve_packument(&state, &caller.0, &headers, target.0.as_deref(), \"metrics\").await","+    } else {","+        serve_metrics(state).await","+    }","+}"],"additions":257,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/request_id.rs","lines":["@@ -0,0 +1,60 @@","+use std::{fmt, sync::Arc};","+","+/// A validated request identifier, either echoed from an incoming `x-request-id` header","+/// or generated fresh as an RFC 4122 / RFC 9562 UUID v4.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub struct RequestId(pub Arc<str>);","+","+impl RequestId {","+    #[must_use]","+    pub fn as_str(&self) -> &str {","+        &self.0","+    }","+}","+","+impl fmt::Display for RequestId {","+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {","+        formatter.write_str(&self.0)","+    }","+}","+","+/// Validate whether an incoming `x-request-id` header value is safe to reuse.","+///","+/// Refuses empty values, strings longer than 128 characters, and any values","+/// containing ASCII whitespace or control characters.","+#[must_use]","+pub(crate) fn is_valid_request_id(value: &str) -> bool {","+    !value.is_empty()","+        && value.len() <= 128","+        && value","+            .bytes()","+            .all(|byte| (33..=126).contains(&byte))","+}","+","+/// Generate a fresh RFC 4122 UUID v4 request identifier.","+#[must_use]","+pub(crate) fn generate_request_id() -> String {","+    let mut bytes = [0u8; 16];","+    getrandom::fill(&mut bytes).expect(\"OS CSPRNG is available\");","+    bytes[6] = (bytes[6] & 0x0f) | 0x40;","+    bytes[8] = (bytes[8] & 0x3f) | 0x80;","+    format!(","+        \"{:02x}{:02x}{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}\",","+        bytes[0],","+        bytes[1],","+        bytes[2],","+        bytes[3],","+        bytes[4],","+        bytes[5],","+        bytes[6],","+        bytes[7],","+        bytes[8],","+        bytes[9],","+        bytes[10],","+        bytes[11],","+        bytes[12],","+        bytes[13],","+        bytes[14],","+        bytes[15],","+    )","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing.rs","lines":["@@ -44,11 +44,12 @@ use super::{","     not_found, oci, package_mutation, pnpr_protocols_disabled, private_no_cache, publish_package,","     put_login, pypi, remove_dist_tag, require_artifact_caller, require_pipeline_caller,","     require_resolver_caller, resolve_write_target, serve_artifact_blob, serve_artifact_blob_size,","-    serve_batch_publish, serve_get_pipeline_run, serve_list_pipeline_runs, serve_org_packages,","-    serve_packument, serve_pipeline_ui, serve_pnpr_handshake, serve_publish_artifact,","-    serve_publish_pipeline_run, serve_resolve, serve_resolve_artifacts, serve_revision_tarball,","-    serve_search, serve_tarball, serve_upload_artifact_blob, serve_verify_lockfile,","-    serve_version_manifest, set_dist_tag, staged,","+    serve_batch_publish, serve_get_pipeline_run, serve_list_pipeline_runs, serve_metrics,","+    serve_metrics_or_packument, serve_org_packages, serve_packument, serve_pipeline_ui,","+    serve_pnpr_handshake, serve_publish_artifact, serve_publish_pipeline_run, serve_resolve,","+    serve_resolve_artifacts, serve_revision_tarball, serve_search, serve_tarball,","+    serve_upload_artifact_blob, serve_verify_lockfile, serve_version_manifest, set_dist_tag,","+    staged,","     team_access::{grant_team_access, list_team_packages, revoke_team_access},","     team_mutations::{TeamScope, add_team_member, create_team, destroy_team, remove_team_member},","     update_packument,","@@ -112,9 +113,7 @@ fn finish_router(","                 .expose_headers([header::ETAG]),","         );","     }","-    let trusted_proxies = Arc::from(state.inner.config.http.trusted_proxies.clone());","-    let trusted_proxy_header = state.inner.config.http.trusted_proxy_header;","-    Ok(with_observability_layers(router, trusted_proxies, trusted_proxy_header).with_state(state))","+    Ok(with_observability_layers(router, state.clone()).with_state(state))"," }"," "," fn apply_request_timeout(","@@ -178,7 +177,9 @@ fn surface_routes(","         router = router","             .route(&path(\"/-/ping\"), get(serve_ping))","             .route(&path(\"/-/ready\"), get(serve_ready))","-            .route(&path(\"/-/live\"), get(serve_live));","+            .route(&path(\"/-/live\"), get(serve_live))","+            .route(&path(\"/-/metrics\"), get(serve_metrics))","+            .route(&path(\"/metrics\"), get(serve_metrics_or_packument));","     }","     router = router","         .merge(super::oidc::routes(ui_served))"],"additions":10,"deletions":9,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing/observability.rs","lines":["@@ -1,25 +1,30 @@","-use std::{sync::Arc, time::Duration};","-","-use axum::{Router, body::Body, extract::ConnectInfo, http::Request, response::Response};","-use pnpr_config::TrustedProxyHeader;","-use tower_http::{","-    compression::{","-        CompressionLayer,","-        predicate::{DefaultPredicate, NotForContentType, Predicate as _},","-    },","-    trace::TraceLayer,","+use std::{net::IpAddr, sync::Arc, time::Instant};","+","+use axum::{","+    Router,","+    extract::{ConnectInfo, Request, State},","+    http::{HeaderName, HeaderValue, Method, header},","+    middleware::Next,","+    response::Response,","+};","+use tower_http::compression::{","+    CompressionLayer,","+    predicate::{DefaultPredicate, NotForContentType, Predicate as _},"," };","-use tracing::Span;","+use tracing::Instrument;"," ","-use crate::server::{AppState, PeerAddr, loggable_uri, resolve_client_ip};","+use crate::server::{","+    AppState, AuthedCaller, ClientIp, PeerAddr, RequestId, generate_request_id,","+    is_valid_request_id, loggable_uri, resolve_client_ip,","+};"," "," pub(super) fn with_observability_layers(","     router: Router<AppState>,","-    trusted_proxies: Arc<[pnpr_config::IpNetwork]>,","-    trusted_proxy_header: T