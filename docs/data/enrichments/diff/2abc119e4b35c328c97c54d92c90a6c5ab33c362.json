l` tagged literals and Relay-specific docblocks"," /// from a JavaScript file."," pub fn extract_javascript_features_from_file(","-    file_source_result: &FileSourceResult,","     file: &File,","     config: &Config,"," ) -> Result<LocatedJavascriptSourceFeatures> {","-    let contents = read_file_to_string(file_source_result, file)?;","+    let contents = read_file_to_string(config, file)?;","     let features = extract_graphql::extract(&contents);","     let mut graphql_sources = Vec::new();","     let mut docblock_sources = Vec::new();"],"additions":1,"deletions":3,"truncated":false},{"path":"compiler/crates/relay-compiler/src/file_source/read_file_to_string.rs","lines":["@@ -6,20 +6,33 @@","  */"," "," use super::File;","-use super::FileSourceResult;","+use crate::config::Config;"," use crate::errors::Error;"," use crate::errors::Result;"," ","-/// Reads a file into a string.","-pub fn read_file_to_string(file_source_result: &FileSourceResult, file: &File) -> Result<String> {","+/// Reads a file into a string through the config's file system.","+pub fn read_file_to_string(config: &Config, file: &File) -> Result<String> {","     assert!(","         file.exists,","         \"Can't read from non-existent file: {:?}\",","-        &file.name","+        file.name","     );","-    let absolute_path = file.absolute_path(file_source_result.resolved_root());","-    std::fs::read_to_string(&absolute_path).map_err(|err| Error::FileRead {","-        file: absolute_path.clone(),","-        source: err,","-    })","+    config","+        .file_system","+        .read_to_string(&file.name)","+        .map_err(|err| Error::FileRead {","+            file: config.root_dir.join(&file.name),","+            source: err,","+        })","+}","+","+/// Reads a file's bytes through the config's file system.","+pub fn read_file_to_bytes(config: &Config, file: &File) -> Result<Vec<u8>> {","+    config","+        .file_system","+        .read(&file.name)","+        .map_err(|err| Error::ReadFileError {","+            file: config.root_dir.join(&file.name),","+            source: err,","+        })"," }"],"additions":22,"deletions":9,"truncated":false},{"path":"compiler/crates/relay-compiler/src/file_system.rs","lines":["@@ -0,0 +1,107 @@","+/*","+ * Copyright (c) Meta Platforms, Inc. and affiliates.","+ *","+ * This source code is licensed under the MIT license found in the","+ * LICENSE file in the root directory of this source tree.","+ */","+","+//! The compiler's view of the files under [`Config::root_dir`].","+//!","+//! Compiler inputs are read through a [`FileSystem`] injected as","+//! [`Config::file_system`] rather than through `std::fs` directly, so a host","+//! can supply a backend suited to its environment, such as one that queries a","+//! virtual file system for listings and content hashes instead of reading","+//! every file.","+//!","+//! Paths passed to a [`FileSystem`] are relative to its root, which is the","+//! config's `root_dir`.","+//!","+//! [`Config::root_dir`]: crate::config::Config::root_dir","+//! [`Config::file_system`]: crate::config::Config::file_system","+","+use std::fmt::Debug;","+use std::io;","+use std::path::Path;","+use std::path::PathBuf;","+","+/// Read access to the files under a root directory.","+///","+/// Every path a method takes is relative to the file system's root, which for","+/// [`Config::file_system`] is [`Config::root_dir`]. Paths are never resolved","+/// against the process's working directory.","+///","+/// [`Config::root_dir`]: crate::config::Config::root_dir","+/// [`Config::file_system`]: crate::config::Config::file_system","+pub trait FileSystem: Debug + Send + Sync {","+    /// Short identifier for the backend, recorded in build logs.","+    fn name(&self) -> &'static str;","+","+    /// Reads the whole file at `path`.","+    ///","+    /// `path` is relative to the file system's root (e.g. `src/Foo.js` for","+    /// `<root_dir>/src/Foo.js`), the same root-relative form as","+    /// [`File::name`](crate::File::name). It must not be absolute.","+    fn read(&self, path: &Path) -> io::Result<Vec<u8>>;","+","+    /// Reads the whole file at `path` as UTF-8.","+    ///","+    /// `path` is relative to the file system's root, as for","+    /// [`FileSystem::read`].","+    fn read_to_string(&self, path: &Path) -> io::Result<String> {","+        String::from_utf8(self.read(path)?)","+            .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))","+    }","+}","+","+/// A [`FileSystem`] backed by `std::fs`.","+#[derive(Debug)]","+pub struct StdFileSystem {","+    root: PathBuf,","+}","+","+impl StdFileSystem {","+    pub fn new(root: PathBuf) -> Self {","+        Self { root }","+    }","+}","+","+impl FileSystem for StdFileSystem {","+    fn name(&self) -> &'static str {","+        \"std\"","+    }","+","+    fn read(&self, path: &Path) -> io::Result<Vec<u8>> {","+        std::fs::read(self.root.join(path))","+    }","+","+    fn read_to_string(&self, path: &Path) -> io::Result<String> {","+        std::fs::read_to_string(self.root.join(path))","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[cfg(any(target_os = \"linux\", target_os = \"macos\"))]","+    #[test]","+    fn std_file_system_reads_relative_to_its_root() {","+        let dir = tempfile::tempdir().unwrap();","+        std::fs::create_dir(dir.path().join(\"src\")).unwrap();","+        std::fs::write(dir.path().join(\"src/a.js\"), \"graphql`query A { me }`\").unwrap();","+        let file_system = StdFileSystem::new(dir.path().to_path_buf());","+","+        assert_eq!(","+            file_system.read_to_string(Path::new(\"src/a.js\")).unwrap(),","+            \"graphql`query A { me }`\",","+        );","+        assert_eq!(","+            file_system","+                .read(Path::new(\"src/missing.js\"))","+                .unwrap_err()","+                .kind(),","+            io::ErrorKind::NotFound,","+            \"a missing file should surface as NotFound\",","+        );","+    }","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"compiler/crates/relay-compiler/src/lib.rs","lines":["@@ -18,6 +18,7 @@ pub mod config;"," mod docblocks;"," pub mod errors;"," pub mod file_source;","+pub mod file_system;"," mod get_programs;"," mod graphql_asts;"," mod operation_persister;","@@ -82,6 +83,8 @@ pub use file_source::SourceControlUpdateStatus;"," pub use file_source::SourceReader;"," pub use file_source::WalkDirFileSourceResult;"," pub use file_source::source_for_location;","+pub use file_system::FileSystem;","+pub use file_system::StdFileSystem;"," pub use get_programs::assert_programs;"," pub use get_programs::get_programs;"," pub use graphql_asts::GraphQLAsts;",""],"additions":3,"deletions":0,"truncated":false}],"additions":160,"deletions":53,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-17T12:24:57.157060+00:00"}