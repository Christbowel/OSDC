{"id":"5b0153a536e1c09525f2897d538d001ce7c3c9b2","axis":"silent","repo":"hibernate/hibernate-validator","sha":"5b0153a536e1c09525f2897d538d001ce7c3c9b2","parsed":{"files":[{"path":"annotation-processor/src/main/java/org/hibernate/validator/ap/internal/util/ConstraintHelper.java","lines":["@@ -317,6 +317,7 @@ public ConstraintHelper(Types typeUtils, AnnotationApiHelper annotationApiHelper"," \t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.KOR_RRN_CHECK, CharSequence.class );"," \t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.NOT_BLANK, CharSequence.class );"," \t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.NOT_COMPROMISED, CharSequence.class, char[].class );","+\t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.PASSWORD_POLICY, CharSequence.class, char[].class );"," \t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.PASSWORD_STRENGTH, CharSequence.class, char[].class );"," \t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.NOT_EMPTY, TYPES_SUPPORTED_BY_SIZE_AND_NOT_EMPTY_ANNOTATIONS );"," \t\tregisterAllowedTypesForBuiltInConstraint( HibernateValidatorTypes.PORT, Number.class, String.class );"],"additions":1,"deletions":0,"truncated":false},{"path":"annotation-processor/src/main/java/org/hibernate/validator/ap/internal/util/TypeNames.java","lines":["@@ -92,6 +92,7 @@ public static class HibernateValidatorTypes {"," \t\tpublic static final String RUC_CHECK = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".py.RUC\";"," \t\tpublic static final String INN_CHECK = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".ru.INN\";"," \t\tpublic static final String KOR_RRN_CHECK = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".kor.KorRRN\";","+\t\tpublic static final String PASSWORD_POLICY = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".PasswordPolicy\";"," \t\tpublic static final String PASSWORD_STRENGTH = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".PasswordStrength\";"," \t\tpublic static final String PORT = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".Port\";"," \t\tpublic static final String NOT_COMPROMISED = ORG_HIBERNATE_VALIDATOR_CONSTRAINTS + \".NotCompromised\";"],"additions":1,"deletions":0,"truncated":false},{"path":"annotation-processor/src/test/java/org/hibernate/validator/ap/ConstraintValidationProcessorIT.java","lines":["@@ -39,6 +39,7 @@"," import org.hibernate.validator.ap.testmodel.ModelWithNullOrNotEmptyConstraints;"," import org.hibernate.validator.ap.testmodel.ModelWithStartsWithConstraints;"," import org.hibernate.validator.ap.testmodel.ModelWithTrimmedConstraints;","+import org.hibernate.validator.ap.testmodel.ModelWithPasswordPolicyConstraints;"," import org.hibernate.validator.ap.testmodel.ModelWithPasswordStrengthConstraints;"," import org.hibernate.validator.ap.testmodel.ModelWithUUIDConstraints;"," import org.hibernate.validator.ap.testmodel.ModelWithUniqueElementsConstraints;","@@ -1077,6 +1078,22 @@ public void passwordStrengthConstraints() {"," \t\t);"," \t}"," ","+\t@Test","+\tpublic void passwordPolicyConstraints() {","+\t\tFile[] sourceFiles = new File[] {","+\t\t\t\tcompilerHelper.getSourceFile( ModelWithPasswordPolicyConstraints.class )","+\t\t};","+","+\t\tboolean compilationResult =","+\t\t\t\tcompilerHelper.compile( new ConstraintValidationProcessor(), diagnostics, false, true, sourceFiles );","+","+\t\tassertFalse( compilationResult );","+\t\tassertThatDiagnosticsMatch(","+\t\t\t\tdiagnostics,","+\t\t\t\tnew DiagnosticExpectation( Kind.ERROR, 27 )","+\t\t);","+\t}","+"," \t@Test"," \tpublic void notCompromisedConstraints() {"," \t\tFile[] sourceFiles = new File[] {"],"additions":17,"deletions":0,"truncated":false},{"path":"annotation-processor/src/test/java/org/hibernate/validator/ap/testmodel/ModelWithPasswordPolicyConstraints.java","lines":["@@ -0,0 +1,29 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.ap.testmodel;","+","+import org.hibernate.validator.constraints.PasswordPolicy;","+import org.hibernate.validator.constraintvalidation.HibernateConstraintValidatorInitializationContext;","+import org.hibernate.validator.spi.password.PasswordPolicyBuilder;","+import org.hibernate.validator.spi.password.PasswordPolicyDefinition;","+","+public class ModelWithPasswordPolicyConstraints {","+","+\tpublic static class TestPolicy implements PasswordPolicyDefinition {","+\t\t@Override","+\t\tpublic void configure(PasswordPolicyBuilder builder, HibernateConstraintValidatorInitializationContext context) {","+\t\t\tbuilder.minLength( 8 );","+\t\t}","+\t}","+","+\t@PasswordPolicy(TestPolicy.class)","+\tprivate String string;","+","+\t@PasswordPolicy(TestPolicy.class)","+\tprivate char[] charArray;","+","+\t@PasswordPolicy(TestPolicy.class)","+\tprivate Integer integer;","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"documentation/src/main/asciidoc/reference/_ch02.adoc","lines":["@@ -799,6 +799,9 @@ The default is `ANY`, which means both IPv4 and IPv6 addresses are considered va"," `@NotCompromised`:: Checks that the annotated password has not been compromised in a data breach, as determined by a registered `CompromisedPasswordChecker` validation service. `null` is considered valid. A `CompromisedPasswordChecker` must be registered via `addValidationService()` before using this constraint. See <<section-password-validation-services>> for example implementations.","         Supported data types::: `CharSequence`, `char[]`","         Hibernate metadata impact::: None","+`@PasswordPolicy(value=)`:: Validates that the annotated password meets all rules defined by the referenced `PasswordPolicyDefinition`. Each failing rule produces its own constraint violation. `null` is considered valid. The `value` parameter specifies the `PasswordPolicyDefinition` class that configures the policy rules. See <<section-password-policy>> for details and examples.","+        Supported data types::: `CharSequence`, `char[]`","+        Hibernate metadata impact::: None"," `@PasswordStrength(min=)`:: Checks that the annotated password meets a minimum strength score as determined by a registered `PasswordStrengthEstimator` validation service. `null` is considered valid. The `min` parameter defaults to `PasswordStrengthScore.FAIR`. A `PasswordStrengthEstimator` must be registered via `addValidationService()` before using this constraint. See <<section-password-validation-services>> for example implementations.","         Supported data types::: `CharSequence`, `char[]`","         Hibernate metadata impact::: None"],"additions":3,"deletions":0,"truncated":false},{"path":"documentation/src/main/asciidoc/reference/_ch09.adoc","lines":["@@ -691,6 +691,139 @@ include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/HaveIBeenP"," ----"," ===="," ","+[[section-password-policy]]","+==== Composable password policies","+","+The `@PasswordPolicy` constraint lets you define composable password validation rules in a single annotation.","+Unlike `@PasswordStrength` or `@NotCompromised`, which each check one aspect, `@PasswordPolicy` combines","+multiple rules -- and each failing rule produces its own constraint violation with a specific message.","+","+A policy is defined by implementing `PasswordPolicyDefinition` and configuring rules via the `PasswordPolicyBuilder`:","+","+[[example-password-policy-basic]]","+.Defining a password policy","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=policyDefinition]","+----","+====","+","+Apply it to a field using `@PasswordPolicy`:","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=policyUsage]","+----","+====","+","+===== Built-in rules","+","+The builder provides convenience methods for common password policy rules:","+","+[cols=\"3,5\", options=\"header\"]","+|===","+| Builder method | Description","+","+| `minLength(int min)` | Password must be at least `min` characters long","+| `maxLength(int max)` | Password must be at most `max` characters long","+| `requireCharacters(CharacterType type, int min)` | Password must contain at least `min` characters of the given type (`UPPERCASE`, `LOWERCASE`, `DIGIT`, `SPECIAL`)","+| `noSequence()` | Rejects passwords containing 3+ sequential characters (e.g. \"abc\", \"321\")","+| `noKeyboardWalk()` | Rejects passwords containing walks across adjacent keys (e.g. \"qwerty\", \"asdf\", \"4eszxdr5\"). Defaults to the QWERTY layout with a minimum walk length of 4. Use `noKeyboardWalk(KeyboardLayout...)` to specify different layouts (QWERTY, AZERTY, DVORAK, NORDIC, CYRILLIC_UA), or `noKeyboardWalk(int, KeyboardLayout...)` to also set a custom minimum walk length. Custom layouts can be created via `KeyboardLayout.of(...)`. Shifted and diacritical characters are mapped to their base key.","+| `noWhitespace()` | Rejects passwords containing whitespace characters","+| `noRepeatingCharacters(int max)` | Rejects passwords where the same character repeats more than `max` times consecutively (e.g. \"aaa\")","+| `allowedCharacters(char... chars)` | Restricts the password to only the specified characters","+| `illegalCharacters(char... chars)` | Rejects passwords containing any of the specified characters","+| `strengthEstimator(int minScore, PasswordStrengthEstimator)` | Requires a minimum strength score from a registered strength estimator (see <<section-password-validation-services>>)","+| `compromisedChecker(CompromisedPasswordChecker)` | Rejects passwords flagged as compromised by a registered compromised checker (see <<section-password-validation-services>>)","+|===","+","+===== Custom rules","+","+For requirements not covered by the built-in methods, use `addRule()` with either a lambda or a full","+`PasswordPolicyRule` implementation.","+","+====== Lambda rules","+","+Simple checks can be expressed as one-liners:","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=lambdaRules]","+----","+====","+","+====== Custom rules with external services","+","+Rules that depend on external resources -- dictionary lookups, password history checks, breach databases -- should","+delegate to an external service interface. The application provides the implementation; the rule only needs the contract.","+","+Define a service interface for each concern, or use one of your current application service interfaces.","+The implementation is the application's responsibility -- it decides where data comes from","+(file, database, external API) and how matching works (exact, substring, hashed comparison):","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/DictionaryService.java[tags=include]","+----","+====","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordHistoryService.java[tags=include]","+----","+====","+","+The rules receive the service via their constructor and delegate to it:","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/DictionaryRule.java[tags=include]","+----","+====","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordHistoryRule.java[tags=include]","+----","+====","+","+These services are application concerns -- they should be injected by your DI framework, not looked up","+via `getValidationService()` (which is reserved for Hibernate Validator's own validation service SPIs).","+Register a custom `PasswordPolicyDefinitionResolver` that delegates to CDI (or Arc, Spring, Guice, etc.),","+and let the policy definition receive its dependencies through standard injection:","+","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=serviceRules]","+----","+====","+","+See <<section-constraint-definition-resolver>> for how to register the resolver, and <<section-getting-started-cdi>>","+for CDI integration details.","+","+[[section-constraint-definition-resolver]]","+===== Custom policy definition resolver","+","+By default, `PasswordPolicyDefinition` classes are instantiated via their no-arg constructor.","+For dependency injection or custom initialization, register a `PasswordPolicyDefinitionResolver`","+as a validation service:","+","+[[example-password-policy-resolver]]","+====","+[source, java, indent=0]","+----","+include::{sourcedir}/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java[tags=resolverRegistration]","+----","+====","+"," ==== Logging of values under validation"," "," In some cases it might be useful to inspect logs produced by Hibernate Validator."],"additions":133,"deletions":0,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/DictionaryRule.java","lines":["@@ -0,0 +1,29 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.referenceguide.chapter09;","+","+//tag::include[]","+import org.hibernate.validator.constraintvalidation.HibernateConstraintValidatorContext;","+import org.hibernate.validator.spi.password.PasswordPolicyRule;","+","+public class DictionaryRule implements PasswordPolicyRule {","+","+\tprivate final DictionaryService dictionaryService;","+","+\tpublic DictionaryRule(DictionaryService dictionaryService) {","+\t\tthis.dictionaryService = dictionaryService;","+\t}","+","+\t@Override","+\tpublic String getMessage() {","+\t\treturn \"password must not contain a common dictionary word\";","+\t}","+","+\t@Override","+\tpublic boolean isValid(char[] password, HibernateConstraintValidatorContext context) {","+\t\treturn !dictionaryService.containsDictionaryWord( new String( password ) );","+\t}","+}","+//end::include[]"],"additions":29,"deletions":0,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/DictionaryService.java","lines":["@@ -0,0 +1,17 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.referenceguide.chapter09;","+","+//tag::include[]","+/**","+ * Application-provided service for checking passwords against a dictionary","+ * of common words. The implementation decides what constitutes a match","+ * (exact, substring, etc.) and where the dictionary is (file, database, etc.).","+ */","+public interface DictionaryService {","+","+\tboolean containsDictionaryWord(String password);","+}","+//end::include[]"],"additions":17,"deletions":0,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/PasswordHistoryRule.java","lines":["@@ -0,0 +1,29 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.referenceguide.chapter09;","+","+//tag::include[]","+import org.hibernate.validator.constraintvalidation.HibernateConstraintValidatorContext;","+import org.hibernate.validator.spi.password.PasswordPolicyRule;","+","+public class PasswordHistoryRule implements PasswordPolicyRule {","+","+\tprivate final PasswordHistoryService historyService;","+","+\tpublic PasswordHistoryRule(PasswordHistoryService historyService) {","+\t\tthis.historyService = historyService;","+\t}","+","+\t@Override","+\tpublic String getMessage() {","+\t\treturn \"password was used recently\";","+\t}","+","+\t@Override","+\tpublic boolean isValid(char[] password, HibernateConstraintValidatorContext context) {","+\t\treturn !historyService.isPreviouslyUsed( password );","+\t}","+}","+//end::include[]"],"additions":29,"deletions":0,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/PasswordHistoryService.java","lines":["@@ -0,0 +1,18 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.referenceguide.chapter09;","+","+//tag::include[]","+/**","+ * Application-provided service for checking whether a password was used","+ * previously by the current user. The implementation is responsible for","+ * resolving the current user identity (e.g. from a request-scoped context),","+ * hashing the candidate password, and comparing it against stored hashes.","+ */","+public interface PasswordHistoryService {","+","+\tboolean isPreviouslyUsed(char[] password);","+}","+//end::include[]"],"additions":18,"deletions":0,"truncated":false},{"path":"documentation/src/test/java/org/hibernate/validator/referenceguide/chapter09/PasswordPolicyTest.java","lines":["@@ -0,0 +1,181 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.referenceguide.chapter09;","+","+import static org.hibernate.validator.testutil.ConstraintViolationAssert.assertNoViolations;","+import static org.hibernate.validator.testutil.ConstraintViolationAssert.assertThat;","+import static org.hibernate.validator.testutil.ConstraintViolationAssert.violationOf;","+","+import java.util.Set;","+","+import jakarta.inject.Inject;","+import jakarta.validation.ConstraintViolation;","+import jakarta.validation.Validation;","+import jakarta.validation.Validator;","+","+import org.hibernate.validator.HibernateValidator;","+import org.hibernate.validator.constraints.PasswordPolicy;","+import org.hibernate.validator.constraintvalidation.HibernateConstraintValidatorInitializationContext;","+import org.hibernate.validator.spi.password.CharacterType;","+import org.hibernate.validator.spi.password.PasswordPolicyBuilder;","+import org.hibernate.validator.spi.password.PasswordPolicyDefinition;","+import org.hibernate.validator.spi.password.PasswordPolicyDefinitionResolver;","+","+import org.junit.Test;","+","+public class PasswordPolicyTest {","+","+\t//tag::policyDefinition[]","+\tpublic static class WebAppPolicy implements PasswordPolicyDefinition {","+","+\t\t@Override","+\t\tpublic void configure(PasswordPolicyBuilder builder,","+\t\t\t\tHibernateConstraintValidatorInitializationContext context) {","+\t\t\tbuilder.minLength( 8 )","+\t\t\t\t\t.requireCharacters( CharacterType.UPPERCASE, 1 )","+\t\t\t\t\t.requireCharacters( CharacterType.DIGIT, 1 )","+\t\t\t\t\t.noWhitespace();","+\t\t}","+\t}","+\t//end::policyDefinition[]","+","+\t//tag::policyUsage[]","+\tpublic static class UserAccount {","+","+\t\t@PasswordPolicy(WebAppPolicy.class)","+\t\tprivate final String password;","+","+\t\tpublic UserAccount(String password) {","+\t\t\tthis.password = password;","+\t\t}","+\t}","+\t//end::policyUsage[]","+","+\t//tag::lambdaRules[]","+\tpublic static class StrictPolicy implements PasswordPolicyDefinition {","+","+\t\t@Override","+\t\tpublic void configure(PasswordPolicyBuilder builder,","+\t\t\t\tHibernateConstraintValidatorInitializationContext context) {","+\t\t\tbuilder.minLength( 8 )","+\t\t\t\t\t// reject passwords containing the word \"password\"","+\t\t\t\t\t.addRule( \"must not contain 'password'\",","+\t\t\t\t\t\t\tpw -> !new String( pw ).toLowerCase().contains( \"password\" ) )","+\t\t\t\t\t// reject passwords containing a year (1900-2099)","+\t\t\t\t\t.addRule( \"must not contain a year\",","+\t\t\t\t\t\t\tpw -> !new String( pw ).matches( \".*(?:19|20)\\\\d{2}.*\" ) )","+\t\t\t\t\t// no single character more than 3 times total","+\t\t\t\t\t.addRule( \"no character may appear more than 3 times\",","+\t\t\t\t\t\t\tpw -> {","+\t\t\t\t\t\t\t\tint[] counts = new int[Character.MAX_VALUE + 1];","+\t\t\t\t\t\t\t\tfor ( char c : pw ) {","+\t\t\t\t\t\t\t\t\tif ( ++counts[c] > 3 ) {","+\t\t\t\t\t\t\t\t\t\treturn false;","+\t\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t\t}","+\t\t\t\t\t\t\t\treturn true;","+\t\t\t\t\t\t\t} );","+\t\t}","+\t}","+\t//end::lambdaRules[]","+","+\t//tag::serviceRules[]","+\tpublic static class EnterprisePolicy implements PasswordPolicyDefinition {","+","+\t\t@Inject","+\t\tprivate DictionaryService dictionaryService;","+","+\t\t@Inject","+\t\tprivate PasswordHistoryService historyService;","+","+\t\t@Override","+\t\tpublic void configure(PasswordPolicyBuilder builder,","+\t\t\t\tHibernateConstraintValidatorInitializationContext context) {","+\t\t\tbuilder.minLength( 8 )","+\t\t\t\t\t.noSequence()","+\t\t\t\t\t.addRule( new DictionaryRule( dictionaryService ) )","+\t\t\t\t\t.addRule( new PasswordHistoryRule( historyService ) );","+\t\t}","+\t}","+\t//end::serviceRules[]","+","+\tpublic static class MyResolver implements PasswordPolicyDefinitionResolver {","+","+\t\t@Override","+\t\tpublic <T extends PasswordPolicyDefinition> T resolve(Class<T> definitionClass) {","+\t\t\ttry {","+\t\t\t\treturn definitionClass.getDeclaredConstructor().newInstance();","+\t\t\t}","+\t\t\tcatch (ReflectiveOperationException e) {","+\t\t\t\tthrow new RuntimeException( e );","+\t\t\t}","+\t\t}","+\t}","+","+\t@Test","+\tpublic void basicPolicy() {","+\t\tValidator validator = Validation.byProvider( HibernateValidator.class )","+\t\t\t\t.configure()","+\t\t\t\t.buildValidatorFactory()","+\t\t\t\t.getValidator();","+","+\t\tSet<ConstraintViolation<UserAccount>> violations = validator.validate(","+\t\t\t\tnew UserAccount( \"Passw0rd!\" ) );","+\t\tassertNoViolations( violations );","+","+\t\tviolations = validator.validate( new UserAccount( \"ab\" ) );","+\t\tassertThat( violations ).containsOnlyViolations(","+\t\t\t\tviolationOf( PasswordPolicy.class ),","+\t\t\t\tviolationOf( PasswordPolicy.class ),","+\t\t\t\tviolationOf( PasswordPolicy.class )","+\t\t);","+\t}","+","+\t@Test","+\tpublic void lambdaRules() {","+\t\tValidator validator = Validation.byProvider( HibernateValidator.class )","+\t\t\t\t.configure()","+\t\t\t\t.buildValidatorFactory()","+\t\t\t\t.getValidator();","+","+\t\tSet<ConstraintViolation<StrictPolicyBean>> violations = validator.validate(","+\t\t\t\tnew StrictPolicyBean( \"mypassword\" ) );","+\t\tassertThat( violations ).containsOnlyViolations(","+\t\t\t\tviolationOf( PasswordPolicy.class )","+\t\t);","+","+\t\tviolations = validator.validate( new StrictPolicyBean( \"secure2025\" ) );","+\t\tassertThat( violations ).containsOnlyViolations(","+\t\t\t\tviolationOf( PasswordPolicy.class )","+\t\t);","+","+\t\tviolations = validator.validate( new StrictPolicyBean( \"S3cureV@lue\" ) );","+\t\tassertNoViolations( violations );","+\t}","+","+\t@Test","+\tpublic void customResolver() {","+\t\t//tag::resolverRegistration[]","+\t\tValidator validator = Validation.byProvider( HibernateValidator.class )","+\t\t\t\t.configure()","+\t\t\t\t.addValidationService( PasswordPolicyDefinitionResolver.class, new MyResolver() )","+\t\t\t\t.buildValidatorFactory()","+\t\t\t\t.getValidator();","+\t\t//end::resolverRegistration[]","+","+\t\tSet<ConstraintViolation<UserAccount>> violations = validator.validate(","+\t\t\t\tnew UserAccount( \"Passw0rd!\" ) );","+\t\tassertNoViolations( violations );","+\t}","+","+\tprivate static class StrictPolicyBean {","+\t\t@PasswordPolicy(StrictPolicy.class)","+\t\tprivate final String password;","+","+\t\tStrictPolicyBean(String password) {","+\t\t\tthis.password = password;","+\t\t}","+\t}","+}"],"additions":181,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/cfg/defs/PasswordPolicyDef.java","lines":["@@ -0,0 +1,22 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+","+package org.hibernate.validator.cfg.defs;","+","+import org.hibernate.validator.cfg.ConstraintDef;","+import org.hibernate.validator.constraints.PasswordPolicy;","+import org.hibernate.validator.spi.password.PasswordPolicyDefinition;","+","+public class PasswordPolicyDef extends ConstraintDef<PasswordPolicyDef, PasswordPolicy> {","+","+\tpublic PasswordPolicyDef() {","+\t\tsuper( PasswordPolicy.class );","+\t}","+","+\tpublic PasswordPolicyDef value(Class<? extends PasswordPolicyDefinition> definitionClass) {","+\t\taddParameter( \"value\", definitionClass );","+\t\treturn this;","+\t}","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/constraints/PasswordPolicy.java","lines":["@@ -0,0 +1,70 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ * Copyright Red Hat Inc. and Hibernate Authors","+ */","+package org.hibernate.validator.constraints;","+","+import static java.lang.annotation.ElementType.ANNOTATION_TYPE;","+import static java.lang.annotation.ElementType.CONSTRUCTOR;","+import static java.lang.annotation.ElementType.FIELD;","+import static java.lang.annotation.ElementType.METHOD;","+import static java.lang.annotation.ElementType.PARAMETER;","+import static java.lang.annotation.ElementType.TYPE_USE;","+import static java.lang.annotation.RetentionPolicy.RUNTIME;","+","+import java.lang.annotation.Documented;","+import java.lang.annotation.Repeatable;","+import java.lang.annotation.Retention;","+import java.lang.annotation.Target;","+","+import jakarta.validation.Constraint;","+import jakarta.validation.Payload;","+","+import org.hibernate.validator.Incubating;","+import org.hibernate.validator.constraints.PasswordPolicy.List;","+import org.hibernate.validator.spi.password.PasswordPolicyDefinition;","+","+/**","+ * Validates that the annotated password satisfies a set of policy rules defined by","+ * a {@link PasswordPolicyDefinition} implementation.","+ * <p>","+ * The supported types are {@code CharSequence} and {@code char[]}.","+ * {@code null} is considered valid.","+ * <p>","+ * Each policy rule that fails produces its own constraint violati