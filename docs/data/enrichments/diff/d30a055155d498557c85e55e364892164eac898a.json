d(*op, 0);","+\tright_pushdown.RewriteChild(*op, 1);"," "," \tbool left_empty = op->children[0]->type == LogicalOperatorType::LOGICAL_EMPTY_RESULT;"," \tbool right_empty = op->children[1]->type == LogicalOperatorType::LOGICAL_EMPTY_RESULT;"],"additions":2,"deletions":2,"truncated":false},{"path":"src/optimizer/pushdown/pushdown_single_join.cpp","lines":["@@ -22,8 +22,8 @@ unique_ptr<LogicalOperator> FilterPushdown::PushdownSingleJoin(unique_ptr<Logica"," \t\t\ti--;"," \t\t}"," \t}","-\top->children[0] = left_pushdown.Rewrite(std::move(op->children[0]));","-\top->children[1] = right_pushdown.Rewrite(std::move(op->children[1]));","+\tleft_pushdown.RewriteChild(*op, 0);","+\tright_pushdown.RewriteChild(*op, 1);"," \treturn PushFinalFilters(std::move(op));"," }"," "],"additions":2,"deletions":2,"truncated":false},{"path":"test/optimizer/joins/join_elimination_condition_reference.test","lines":["@@ -0,0 +1,47 @@","+# name: test/optimizer/joins/join_elimination_condition_reference.test","+# description: Join elimination keeps a join whose output is read by the condition of a join above it","+# group: [joins]","+","+statement ok","+CREATE TABLE supplier AS SELECT range AS s_suppkey, range % 5 AS s_nationkey FROM range(20);","+","+statement ok","+CREATE TABLE nation AS SELECT range AS n_nationkey FROM range(5);","+","+statement ok","+CREATE TABLE partsupp AS SELECT range % 20 AS ps_suppkey, range AS ps_partkey, range * 1.5 AS ps_supplycost FROM range(100);","+","+statement ok","+CREATE TABLE part AS SELECT range AS p_partkey, range % 3 AS p_mfgr FROM range(100);","+","+statement ok","+CREATE TABLE orders AS SELECT range AS o_orderkey, range % 7 AS o_custkey FROM range(50);","+","+statement ok","+CREATE TABLE lineitem AS SELECT range AS l_orderkey, range % 20 AS l_suppkey FROM range(50);","+","+statement ok","+CREATE TABLE customer AS SELECT range AS c_custkey FROM range(7);","+","+# the SINGLE join of the LIMIT 1 subquery sits below a filter and feeds the LEFT JOIN condition","+query IIII","+WITH rs AS (","+    SELECT s.s_suppkey, SUM(ps.ps_supplycost) AS total_cost,","+           RANK() OVER (PARTITION BY p.p_mfgr ORDER BY SUM(ps.ps_supplycost) DESC) AS rnk","+    FROM supplier s JOIN partsupp ps ON s.s_suppkey = ps.ps_suppkey JOIN part p ON ps.ps_partkey = p.p_partkey","+    GROUP BY s.s_suppkey, p.p_mfgr),","+tc AS (","+    SELECT c.c_custkey, COUNT(o.o_orderkey) AS n","+    FROM customer c LEFT JOIN orders o ON c.c_custkey = o.o_custkey GROUP BY c.c_custkey)","+SELECT ns.n_nationkey, rs.s_suppkey, MAX(rs.total_cost), tc.n","+FROM rs","+JOIN nation ns ON ns.n_nationkey = (SELECT s_nationkey FROM supplier WHERE s_suppkey = rs.s_suppkey)","+LEFT JOIN tc ON tc.c_custkey = (SELECT o.o_custkey FROM orders o JOIN lineitem l ON o.o_orderkey = l.l_orderkey","+                                WHERE l.l_suppkey = rs.s_suppkey LIMIT 1)","+WHERE rs.rnk = 1","+GROUP BY ns.n_nationkey, rs.s_suppkey, tc.n","+ORDER BY ALL;","+----","+2\t17\t201.0\t7","+3\t18\t204.0\t7","+4\t19\t207.0\t7"],"additions":47,"deletions":0,"truncated":false},{"path":"test/optimizer/pushdown/mark_to_semi_projection_map.test","lines":["@@ -0,0 +1,77 @@","+# name: test/optimizer/pushdown/mark_to_semi_projection_map.test","+# description: A MARK join turned into a SEMI or ANTI join keeps the projection maps above it valid","+# group: [pushdown]","+","+statement ok","+CREATE TABLE t1 AS SELECT range AS a FROM range(5);","+","+statement ok","+CREATE TABLE t2 AS SELECT range AS b FROM range(5);","+","+statement ok","+CREATE TABLE t3 AS SELECT range AS c FROM range(3);","+","+# a filter with a projection map above the converted join","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;","+----","+5","+","+query III","+SELECT t1.a, t2.b, t3.c FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1 ORDER BY ALL;","+----","+1\t2\t0","+1\t2\t1","+1\t2\t2","+1\t3\tNULL","+1\t4\tNULL","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) FULL JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;","+----","+5","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) RIGHT JOIN t3 ON t2.b IN (SELECT 2) WHERE t3.c > 0;","+----","+2","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON NOT EXISTS (SELECT 1 FROM t3 x WHERE x.c = t1.a) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;","+----","+10","+","+# a MARK join with a left projection map above the converted join","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT a FROM t1) LEFT JOIN t3 ON t2.b IN (SELECT c FROM t3) WHERE t2.b IN (SELECT c FROM t3);","+----","+45","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b NOT IN (SELECT c FROM t3);","+----","+2","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE EXISTS (SELECT 1 FROM t3 x WHERE x.c = t2.b);","+----","+5","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE NOT EXISTS (SELECT 1 FROM t3 x WHERE x.c = t2.b);","+----","+2","+","+# an inner join re-created by the pushdown above the converted join","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) JOIN t1 t4 ON t4.a = t2.b WHERE t2.b > 1;","+----","+5","+","+query I","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1","+UNION ALL","+SELECT count(*) FROM t1 JOIN t2 ON t1.a IN (SELECT 1) LEFT JOIN t3 ON t2.b IN (SELECT 2) WHERE t2.b > 1;","+----","+5","+5",""],"additions":77,"deletions":0,"truncated":false}],"additions":166,"deletions":18,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-09T17:52:22.325374+00:00"}