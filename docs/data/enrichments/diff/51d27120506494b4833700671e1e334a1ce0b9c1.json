{"id":"51d27120506494b4833700671e1e334a1ce0b9c1","axis":"silent","repo":"pnpm/pnpm","sha":"51d27120506494b4833700671e1e334a1ce0b9c1","parsed":{"files":[{"path":".changeset/allowed-versions-parent-range-gt.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`peerDependencyRules.allowedVersions` now accepts a parent version range that contains `>`, such as `\"foo@>=1.0.0>bar\": \"1\"`."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/peer-check-dedicated-lockfile-links.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+With `sharedWorkspaceLockfile: false`, `pnpm install` now reports missing peers of linked workspace packages, as `pnpm peers check` does."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/peer-check-injected-directory-version.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+The peer dependency check now reads the version of an injected workspace package from its `package.json`. `pnpm install` with `strictPeerDependencies: true` and `pnpm peers check` no longer report such a peer as unmet with a `file:` version."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/workspace-union-range.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install` now links a workspace package for a `workspace:` range that combines `^`, `~`, or `*` with other ranges, such as `workspace:^ || ^2.0.0`."],"additions":5,"deletions":0,"truncated":false},{"path":".config/crate-layers.toml","lines":["@@ -296,7 +296,7 @@ pnpm-config-parse-overrides = 3"," pnpm-crypto-shasums-file = 4"," pnpm-default-reporter = 6"," pnpm-deps-inspection = 11","-pnpm-deps-inspection-peers = 10","+pnpm-deps-inspection-peers = 11"," pnpm-deps-path = 2"," pnpm-deps-restorer = 34"," pnpm-detect-libc = 1"],"additions":1,"deletions":1,"truncated":false},{"path":"Cargo.lock","lines":["@@ -5274,6 +5274,7 @@ dependencies = [","  \"pnpm-catalogs-resolver\",","  \"