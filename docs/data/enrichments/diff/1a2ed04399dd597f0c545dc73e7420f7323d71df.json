RCH y USING AUTOMATIC COVERING INDEX (sheep_no=?) LEFT-JOIN"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"test/bloom1.test","lines":["@@ -125,16 +125,16 @@ do_eqp_test 3.2 {","   `--SEARCH t0 USING AUTOMATIC PARTIAL COVERING INDEX (x=?)"," }"," # ^^^^^--- The key feature in the previous result is that no Bloom filter","-# is used.  In the following, a Bloom filter is used because the data type","-# is INT instead of TEXT.","+# is used because of the COLLATE rtrim.  In the following, a Bloom filter","+# is omitted because collating sequence is binary instead."," do_execsql_test 3.3 {","-  CREATE TABLE t1(x INT COLLATE rtrim);","+  CREATE TABLE t1(x INT COLLATE binary);","   INSERT INTO t1(x) VALUES ('a'), ('b'), ('c');","   CREATE VIEW v1(y) AS SELECT DISTINCT x FROM t1;","-  SELECT count(*) FROM t1, v1 WHERE x='b ';","+  SELECT count(*) FROM t1, v1 WHERE x='b';"," } 3"," do_eqp_test 3.4 {","-  SELECT count(*) FROM t1, v1 WHERE x='b ';","+  SELECT count(*) FROM t1, v1 WHERE x='b';"," } {","   QUERY PLAN","   |--CO-ROUTINE v1","@@ -238,4 +238,54 @@ do_execsql_test 6.1 {","   );"," } 0"," ","+# Bug 2026-07-21T04:39:35Z  (Really an enhancement request, not a bug)","+#","+# Bloom filters are used for text comparisons as long as the collating","+# sequence is BINARY.  For any other collating sequence, the Bloom filter","+# is omitted.","+#","+reset_db","+do_execsql_test 7.1 {","+  CREATE TABLE big(a INTEGER PRIMARY KEY, b TEXT);","+  CREATE TABLE small(k TEXT PRIMARY KEY, v TEXT) WITHOUT ROWID;","+  WITH RECURSIVE c(n) AS(VALUES(0) UNION ALL SELECT n+1 FROM c WHERE n<9999)","+    INSERT INTO big(b) SELECT format('k%07d',n) FROM c;","+  WITH RECURSIVE c(n) AS(VALUES(0) UNION ALL SELECT n+1 FROM c WHERE n<99)","+    INSERT INTO small(k,v) SELECT format('k%07d',n), n*1000 FROM c;","+  ANALYZE;","+}","+do_execsql_test 7.2 {","+  SELECT count(*) FROM big CROSS JOIN small","+   WHERE small.k=big.b AND small.v<>'nope';","+} 100","+do_eqp_test 7.3 {","+  SELECT count(*) FROM big CROSS JOIN small","+   WHERE small.k=big.b AND small.v<>'nope';","+} {","+  QUERY PLAN","+  |--SCAN big","+  |--BLOOM FILTER ON small (k=?)","+  `--SEARCH small USING PRIMARY KEY (k=?)","+}","+do_execsql_test 7.4 {","+  CREATE TABLE big2(a INTEGER PRIMARY KEY, b TEXT);","+  INSERT INTO big2 SELECT * FROM big;","+  CREATE TABLE small2(k TEXT COLLATE nocase, v TEXT);","+  CREATE INDEX sx1 on small2(k);","+  INSERT INTO small2 SELECT * FROM small;","+  ANALYZE;","+}","+do_execsql_test 7.5 {","+  SELECT count(*) FROM big2, small2","+   WHERE small2.k=big2.b AND small2.v<>'nope';","+} 100","+do_eqp_test 7.6 {","+  SELECT count(*) FROM big2, small2","+   WHERE small2.k=big2.b AND small2.v<>'nope';","+} {","+  QUERY PLAN","+  |--SCAN big2","+  `--SEARCH small2 USING INDEX sx1 (k=?)","+}","+"," finish_test"],"additions":55,"deletions":5,"truncated":false},{"path":"test/subquery.test","lines":["@@ -637,6 +637,7 @@ do_eqp_test subquery-10.2 {","   |  |--SCAN t2","   |  `--USE TEMP B-TREE FOR GROUP BY","   |--SEARCH t1 USING INDEX x11 (bb=?)","+  |--BLOOM FILTER ON v2 (aa=?)","   `--SEARCH v2 USING AUTOMATIC COVERING INDEX (aa=?)"," }"," # ^^^^^^^^^^^^^","@@ -654,7 +655,7 @@ do_eqp_test subquery-10.2 {"," # Follow-up on 2025-04-14.  Performance issue found while working"," # on Fossil (Fossil check-in 2025-04-13T19:54)."," #","-do_execsql_test 10.3 {","+do_execsql_test subquery-10.3 {","   CREATE TABLE blob(","     rid INTEGER PRIMARY KEY,","     size INT,",""],"additions":2,"deletions":1,"truncated":false}],"additions":238,"deletions":80,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-07-24T10:17:54.590854+00:00"}