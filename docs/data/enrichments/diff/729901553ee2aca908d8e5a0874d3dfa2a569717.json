ll file group\") {","+    withTempDir { tmp =>","+      Seq(\"cow\", \"mor\").foreach { tableType =>","+        withSQLConf(\"hoodie.index.type\" -> \"GLOBAL_SIMPLE\") {","+          val targetTable = generateTableName","+          spark.sql(","+            s\"\"\"","+               | create table $targetTable (id int, name string, price double, ts long, dt string) using hudi","+               | tblproperties (type = '$tableType', primaryKey = 'id', orderingFields = 'ts')","+               | partitioned by (dt)","+               | location '${tmp.getCanonicalPath}/$targetTable'","+             \"\"\".stripMargin)","+          spark.sql(s\"insert into $targetTable values (1, 'a1', 10.0, 1000, 'p1'), (2, 'a2', 20.0, 1000, 'p2')\")","+          // The moved record and the new one are inserted into the small file group of partition p2","+          spark.sql(","+            s\"\"\"","+               | merge into $targetTable t using (","+               |   select 1 as id, 'a1m' as name, 5.0D as price, 2000L as ts, 'p2' as dt","+               |   union all select 3, 'a3', 30.0D, 2000L, 'p2') s","+               | on t.id = s.id","+               | when matched then update set id = s.id, name = s.name, price = s.price + 1, ts = s.ts, dt = s.dt","+               | when not matched then insert *","+             \"\"\".stripMargin)","+          checkAnswer(s\"select id, name, price, ts, dt from $targetTable order by id\")(","+            Seq(1, \"a1m\", 6.0, 2000, \"p2\"), Seq(2, \"a2\", 20.0, 1000, \"p2\"), Seq(3, \"a3\", 30.0, 2000, \"p2\"))","+        }","+      }","+    }","+  }","+","   test(\"Test MergeInto for MOR table\") {","     withTempDir { tmp =>","       withSQLConf(\"hoodie.payload.combined.schema.validate\" -> \"true\", MERGE_SMALL_FILE_GROUP_CANDIDATES_LIMIT.key() -> \"0\") {",""],"additions":63,"deletions":0,"truncated":false}],"additions":167,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-26T18:56:23.090829+00:00"}