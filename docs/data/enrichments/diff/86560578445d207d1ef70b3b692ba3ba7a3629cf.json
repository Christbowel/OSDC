K_TRACING_SUBMODULE)/dist/covera"," "," E2E_PHPUNIT_GROUP=integration,e2e"," PHPUNIT_GROUP=default","+SBX_BUILDER?=infection-sbx"," SBX_PROJECT_LOCAL_KIT=./devTools/sbx/kits/project-local","-SBX_PROJECT_LOCAL_KIT_SPEC=$(SBX_PROJECT_LOCAL_KIT)/spec.yaml","-SBX_PROJECT_LOCAL_KIT_TEMPLATE=./devTools/sbx/project-local-kit.yaml","+SBX_PROJECT_LOCAL_KIT_SPEC=$(SBX_PROJECT_LOCAL_KIT)/project-local.yaml","+SBX_PROJECT_LOCAL_KIT_TEMPLATE=./devTools/sbx/templates/project-local.yaml","+SBX_KIT_SPECS=$(foreach kit,$(wildcard ./devTools/sbx/kits/*),$(wildcard $(kit)/$(notdir $(kit)).yaml))","+SBX_KITS=$(sort $(patsubst %/,%,$(dir $(SBX_KIT_SPECS))) $(SBX_PROJECT_LOCAL_KIT))"," "," #"," # Commands (phony targets)","@@ -69,16 +72,24 @@ compile-docker:\t \t## Bundles Infection into a PHAR using docker"," compile-docker: $(DOCKER_FILE_IMAGE)"," \t$(DOCKER_RUN_83) make compile"," ","+# Local v3 kit builds use the OCI exporter, which needs docker-container","+# when Docker's containerd image store is disabled. Keep this builder local","+# to the sbx targets instead of changing the user's selected builder.","+sbx-create sbx-kit-validate sbx-kit-test: export BUILDX_BUILDER=$(SBX_BUILDER)","+","+.PHONY: sbx-builder","+sbx-builder:","+\tdocker buildx inspect \"$(SBX_BUILDER)\" >/dev/null 2>&1 || docker buildx create --name \"$(SBX_BUILDER)\" --driver docker-container","+"," .PHONY: sbx-create","-sbx-create:\t## Drops the existing PHP sbx image and create it anew","-sbx-create: sbx-image-build sbx-project-local-kit sbx-kit-validate","+sbx-create:\t## Creates the Codex sandbox with the PHP tooling mixin","+sbx-create: sbx-builder sbx-project-local-kit"," \tsbx rm codex-infection || true"," \tsbx run codex \\","-\t\t--template=infection-sbx-php-8.4:latest \\","-\t\t--kit=./devTools/sbx/kits/codex-otel \\","-\t\t--kit=./devTools/sbx/kits/gh-stack \\","-\t\t--kit=\"git+https://github.com/docker/sbx-kits-contrib#ref=1f2f62200d68b8e1f653730ab29134a1a06755db&dir=git-ssh-sign\" . \\","-\t\t--kit=$(SBX_PROJECT_LOCAL_KIT)","+\t\t--name=codex-infection \\","+\t\t--skills=off \\","+\t\t$(foreach kit,$(SBX_KITS),--kit=\"$(kit)\") \\","+\t\t--kit=\"git+https://github.com/docker/sbx-kits-contrib#ref=f17734585e96110334a7e9ea609d08d7b8f1c99d&dir=git-ssh-sign\" ."," "," .PHONY: sbx-project-local-kit"," sbx-project-local-kit: $(SBX_PROJECT_LOCAL_KIT_TEMPLATE)","@@ -87,26 +98,15 @@ sbx-project-local-kit: $(SBX_PROJECT_LOCAL_KIT_TEMPLATE)"," "," .PHONY: sbx-kit-validate"," sbx-kit-validate:\t## Validates the sbx kit specs","-sbx-kit-validate: sbx-project-local-kit","-\tsbx kit validate ./devTools/sbx/kits/codex-otel","-\tsbx kit validate ./devTools/sbx/kits/gh-stack","-\tsbx kit validate $(SBX_PROJECT_LOCAL_KIT)","-","-.PHONY: sbx-image-build","-sbx-image-build:\t## Builds the PHP sbx image","-sbx-image-build:","-\t./devTools/sbx/build-image.sh","-\t./devTools/sbx/load-template.sh","-","-.PHONY: _sbx-image-build","-_sbx-image-build:","-\tFORCE_REBUILD=1 ./devTools/sbx/build-image.sh","-\t./devTools/sbx/load-template.sh","-","-.PHONY: sbx-image-test","-sbx-image-test:\t## Verifies the PHP sbx image contains the expected tooling","-sbx-image-test:","-\tcontainer-structure-test test --image=infection-sbx-php-8.4:latest --config=./devTools/sbx/test.yaml","+sbx-kit-validate: sbx-builder sbx-project-local-kit","+\t@set -e; for kit in $(SBX_KITS); do \\","+\t\tsbx kit validate \"$$kit\"; \\","+\tdone","+","+.PHONY: sbx-kit-test","+sbx-kit-test:\t## Tests the shared kits in a disposable shell sandbox","+sbx-kit-test: sbx-builder","+\t./devTools/sbx/test-kits.sh"," "," .PHONY: check_trailing_whitespaces"," check_trailing_whitespaces:"],"additions":29,"deletions":29,"truncated":false},{"path":"devTools/sbx/README.md","lines":["@@ -1,94 +1,97 @@","-# PHP sbx image","+# Docker Sandbox"," ","-This directory contains a dedicated Docker image for [docker sandbox] with PHP.","+This directory contains Infection's [Docker Sandbox] setup. It requires sbx 0.51","+or later and Docker Buildx. Run the Make commands from the repository root."," ","-It extends [`docker/sandbox-templates:codex-docker`][docker-sandbox-templates-codex] and adds the PHP runtime/tooling needed by this repository. It is intentionally separate from `devTools/Dockerfile` as the usage is different.","-","-It uses [container-structure-test][container-structure-test] for testing the image.","+## Usage"," ","-The base image provides the GitHub CLI (`gh`). The `devTools/sbx/kits/gh-stack` kit","-installs the latest [`github/gh-stack`](https://github.com/github/gh-stack) release","-for the `agent` user during sandbox creation with `gh extension install`.","+Configure the GitHub credential used by gh-stack, then create the sandbox:"," ","-## Telemetry","+```shell","+sbx secret set github --command 'gh auth token'","+make sbx-create","+```"," ","-Codex telemetry is optional. The OpenTelemetry settings live in","-`devTools/sbx/codex-otel.toml` and are merged into the Codex user-level config","-by the `devTools/sbx/kits/codex-otel` kit when the sandbox starts.","+`make sbx-create` runs Codex with the repository mounted as its workspace.","+sbx builds the kits during creation. The Makefile prepares a Buildx builder","+automatically. After changing kits, run validation and tests manually."," ","-The provided template assumes the OTLP HTTP collector is reachable from","-the sandbox at `http://host.docker.internal:4318`. If it runs elsewhere,","-update `devTools/sbx/codex-otel.toml`.","+To use another workload or sandbox name, edit `sbx run codex` and","+`--name=codex-infection-test` in the [Makefile]'s `sbx-create` recipe before","+running it. Use a workload compatible with the PHP kit's Debian-based","+`sbx/shell:latest` base, and omit Codex-specific kits when using another agent."," ","-Note that depending on the port used or your network policies, the connection","-to the host may be denied. For example, with the value above, you will need to","-execute:","+Reopen the default sandbox with:"," "," ```shell","-sbx policy allow network localhost:4318","+sbx run --name codex-infection-test"," ```"," ","-## Usage","+Reopening an existing sandbox does not apply kit changes. To apply them, remove","+the sandbox, then recreate it with `make sbx-create`."," ","-Authenticate `gh` on the host, then configure the sandbox's GitHub credential:","+## Kits"," ","-```shell","-sbx secret set github --command 'gh auth token'","-```","+Local kits are stored under `kits/`. Each has a matching `<kit>/<kit>.yaml`","+descriptor and is automatically included in creation and validation."," ","-The host-side proxy injects the token into GitHub API requests. Approve the","-kit's use of the GitHub credential when prompted on first creation.","+| Kit | Contents |","+| --- | --- |","+| [php](kits/php) | PHP, coverage drivers, Composer, PIE, and extension build tools. |","+| [gh-stack](kits/gh-stack) | The GitHub CLI extension and its upstream skill. |","+| [sbx](kits/sbx) | The sbx CLI and Docker's official skills. |","+| [container-structure-test](kits/container-structure-test) | The container-structure-test CLI. |","+| [codex-otel](kits/codex-otel) | Codex telemetry settings and their configuration merge helper. |"," ","-```shell","-make sbx-create","-```","+The creation command also includes the pinned upstream `git-ssh-sign` kit and","+the personal `project-local` kit."," ","-This will create the Docker Sandbox image with the template, OTEL kit, and","-gh-stack kit for the current branch and will make it available with:","+## Telemetry"," ","-```shell","-sbx run codex-infection","-```","+The `codex-otel` kit merges [the telemetry settings](kits/codex-otel/codex-otel.toml)","+into Codex's user configuration when the sandbox starts. Edit that file to change the","+settings, then recreate the sandbox to apply them."," ","-Be aware that this command will drop the existing `codex-infection` sandbox.","+The default OTLP HTTP collector endpoint is `http://host.docker.internal:4318`.","+The kit declares runtime network access to `localhost:4318`. If you change the","+collector address, also update the kit's network policy."," ","-The command also creates `devTools/sbx/kits/project-local/spec.yaml` from","-`devTools/sbx/project-local-kit.yaml` when the local file is missing. The","-generated file is ignored by Git and is always included as a kit.","+Local kits are included automatically when you switch workloads. With Claude,","+`codex-otel` still creates Codex configuration and requests collector network","+access, but Claude ignores that configuration. Exclude the kit when using","+another agent."," ","-If you wish to only build the image:","+## Testing"," "," ```shell","-make sbx-image-build","-","-# Force the build, no caching","-make _sbx-image-build","+make sbx-kit-validate  # Validate local kit descriptors.","+make sbx-kit-test      # Run checks in a disposable shell sandbox."," ```"," ","-To run a sandbox manually with the loaded template from the repository root:","+Each shared kit defines its checks in `test.sh`. The test harness discovers","+the kits, creates a shell sandbox, runs their checks as the agent user through","+`sbx exec`, and removes the sandbox on success or failure. New shared kits must","+include a test script."," ","-```shell","-# In case the following gets outdated, you can check `make sbx-create`.","-sbx run codex \\","-  --template=infection-sbx-php-8.4:latest \\","-  --kit=./devTools/sbx/kits/codex-otel \\","-  --kit=./devTools/sbx/kits/gh-stack \\","-  --kit=\"git+https://github.com/docker/sbx-kits-contrib#ref=1f2f62200d68b8e1f653730ab29134a1a06755db&dir=git-ssh-sign\" \\","-  --kit=./devTools/sbx/kits/project-local","-```","+Tests exclude project-local customisations, the remote signing kit, and","+host-shared skills. The telemetry checks cover configuration merging; verifying","+Codex startup and telemetry delivery requires a Codex sandbox. Credential","+approvals must be granted in advance because the harness runs with `--no-input`."," ","-The `--kit` flag only applies when the sandbox is created. For an existing","-sandbox, recreate it. The Codex OTEL kit uses startup hooks and generated files","-that `sbx kit add` cannot apply to an existing sandbox.","+CI validates the shared kits with Docker Buildx and the kit frontend on the","+runner’s native architecture. This builds each kit without exporting an image","+or requiring an sbx login. Run the sandbox integration tests separately with","+`make sbx-kit-test` on a host with a working sbx daemon."," ","-To add user-specific sandbox customisation, edit:","+## Personal customisation"," ","-```text","-devTools/sbx/kits/project-local/spec.yaml","-```","+`make sbx-create` creates `kits/project-local/project-local.yaml` from","+[the template](templates/project-local.yaml) if it is missing. This file is","+ignored by Git and always included in your sandbox."," ","-You can use the `--clone` or `--name` option to further adjust your setup.","+Use this file for personal settings, tools, and install hooks. Existing contents","+are preserved. Downloads from additional hosts in install hooks may require","+install-phase network rules in the kit."," ","-[docker sandbox]: https://www.docker.com/products/docker-sandboxes/","-[docker-sandbox-templates-codex]: https://hub.docker.com/layers/docker/sandbox-templates/codex-docker/images","-[container-structure-test]: https://github.com/GoogleContainerTools/container-structure-test","+[Docker Sandbox]: https://docs.docker.com/ai/sandboxes/","+[Makefile]: ../../Makefile"],"additions":67,"deletions":64,"truncated":false},{"path":"devTools/sbx/build-image.sh","lines":["@@ -1,106 +0,0 @@","-#!/usr/bin/env bash","-","-set -euo pipefail","-","-. \"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)/config.sh\"","-","-mkdir -p \"${CACHE_DIR}\"","-","-tar_matches_cache() {","-    [[ -f \"${IMAGE_TAR}\" && -f \"${STAMP}\" && \"$(cat \"${STAMP}\")\" == \"${CACHE_KEY}\" ]]","-}","-","-if [[ \"${FORCE_REBUILD:-}\" != \"1\" ]] && tar_matches_cache; then","-    printf 'Using cached sbx image tar: %s\\n' \"${IMAGE_TAR}\"","-    exit 0","-fi","-","-save_image() {","-    local container_structure_test_options","-","-    container_structure_test_options=()","-","-    if [[ -n \"${IMAGE_PLATFORM:-}\" ]]; then","-        container_structure_test_options+=(","-            --platform=\"${IMAGE_PLATFORM}\"","-        )","-    fi","-","-    set -x","-    container-structure-test test \"${container_structure_test_options[@]}\" --image=\"${IMAGE_REF}\" --config=\"${TEST_CONFIG}\"","-    rm -f \"${IMAGE_TAR_TMP}\"","-    docker save --output=\"${IMAGE_TAR_TMP}\" \"${IMAGE_REF}\"","-    mv \"${IMAGE_TAR_TMP}\" \"${IMAGE_TAR}\"","-    set +x","-","-    printf '%s\\n' \"${CACHE_KEY}\" > \"${STAMP}\"","-    printf 'Saved sbx image tar: %s\\n' \"${IMAGE_TAR}\"","-}","-","-image_matches_cache() {","-    local image_cache_key","-","-    image_cache_key=\"$(docker image inspect \\","-        --format='{{ index .Config.Labels \"org.infection.sbx.cache-key\" }}' \\","-        \"${IMAGE_REF}\" 2>/dev/null || true)\"","-","-    [[ \"${image_cache_key}\" == \"${CACHE_KEY}\" ]]","-}","-","-DOCKER_BUILD_COMMAND=(","-    docker build","-)","-","-if [[ -n \"${IMAGE_PLATFORM:-}\" ]]; then","-    # This is relevant for the CI when the target platform may be different","-    # than the platform of the machine.","-    DOCKER_BUILD_COMMAND=(","-        docker buildx build","-            --load","-            --platform=\"${IMAGE_PLATFORM}\"","-    )","-fi","-","-DOCKER_BUILD_CACHE_OPTIONS=()","-","-if [[ -n \"${IMAGE_CACHE_FROM:-}\" ]]; then","-    DOCKER_BUILD_CACHE_OPTIONS+=(","-        --cache-from=\"${IMAGE_CACHE_FROM}\"","-    )","-fi","-","-if [[ -n \"${IMAGE_CACHE_TO:-}\" ]]; then","-    DOCKER_BUILD_CACHE_OPTIONS+=(","-        --cache-to=\"${IMAGE_CACHE_TO}\"","-    )","-fi","-","-if ! command -v container-structure-test >/dev/null 2>&1; then","-    cat >&2 <<'EOF'","-container-structure-test is