@ -0,0 +1,28 @@","+// Illustrates the behavior of the `rustc_show_spans` internal attribute","+// in the case of nested functions.","+","+//@ check-pass","+#![feature(rustc_attrs)]","+","+#[rustc_show_spans(expr)]","+fn outer() {","+    // No note because it's a nested function.","+    fn inner() {","+        let _ = 0;","+    }","+","+    // The span will be over the `ty` (i.e, `u8`), not the `expr` (i.e., `1`).","+    #[rustc_show_spans(ty)]","+    fn inner_annotated() {","+        let _: u8 = 1; //~ NOTE showing the spans of the ty","+    }","+","+    let _: u8 = 2; //~ NOTE showing the spans of the expr","+}","+","+// No note as the annotation of the previous function does not affect this one.","+fn not_annotated() {","+    let _ = 3;","+}","+","+fn main() {}"],"additions":28,"deletions":0,"truncated":false},{"path":"tests/ui/attributes/show_spans-nested-items.stderr","lines":["@@ -0,0 +1,12 @@","+note: showing the spans of the ty","+  --> $DIR/show_spans-nested-items.rs:17:16","+   |","+LL |         let _: u8 = 1;","+   |                ^^","+","+note: showing the spans of the expr","+  --> $DIR/show_spans-nested-items.rs:20:17","+   |","+LL |     let _: u8 = 2;","+   |                 ^","+"],"additions":12,"deletions":0,"truncated":false},{"path":"tests/ui/attributes/show_spans_macros.rs","lines":["@@ -0,0 +1,44 @@","+// Illustrates the behavior of the `rustc_show_spans` internal attribute.","+// It shows how the parser combines spans of nodes built from tokens of","+// different macro contexts.","+//","+// The objective is for a node's span to be a chain over its internal","+// members and not only from first to last. That is, we should converge","+// to `span(first).to(span(second))...to(span(last))` instead of just","+// `span(first).to(span(last))`. This way we can report spans inside","+// macro definitions when the children come from different contexts.","+","+//@ check-pass","+#![feature(rustc_attrs)]","+","+mod foo {","+    pub const BAR: u8 = 1;","+}","+","+// FIXME(#126763): the span should be `$a::$b` in the macro body.","+macro_rules! path {","+    ($a:tt, $b:tt) => {","+        let _ = $a::$b;","+    };","+}","+","+#[rustc_show_spans(path)]","+fn path_from_tts() {","+    path!(foo, BAR);","+}","+","+// FIXME(#126763): the field access span should be `$a.$f` in the macro body.","+macro_rules! field {","+    ($a:tt, $f:tt) => {","+        let _ = $a.$f;","+    };","+}","+","+const T: (u8,) = (1,);","+","+#[rustc_show_spans(expr)]","+fn field_access() {","+    field!(T, 0);","+}","+","+fn main() {}"],"additions":44,"deletions":0,"truncated":false},{"path":"tests/ui/attributes/show_spans_macros.stderr","lines":["@@ -0,0 +1,18 @@","+note: showing the spans of the path","+  --> $DIR/show_spans_macros.rs:27:11","+   |","+LL |     path!(foo, BAR);","+   |           ^^^^^^^^","+","+note: showing the spans of the expr","+  --> $DIR/show_spans_macros.rs:41:12","+   |","+LL |     field!(T, 0);","+   |            ^^^^","+","+note: showing the spans of the expr","+  --> $DIR/show_spans_macros.rs:41:12","+   |","+LL |     field!(T, 0);","+   |            ^","+",""],"additions":18,"deletions":0,"truncated":false}],"additions":240,"deletions":1,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-10-15T13:23:18.546241+00:00"}