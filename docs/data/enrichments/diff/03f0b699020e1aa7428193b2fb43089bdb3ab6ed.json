ue,","+                    RustcShowSpansKind::Path => self.path = true,","+                }","+            }","+        }","+        visit::walk_item(self, item);","+","+        // Recover the state. Needed if we are looking into nested items.","+        (self.expr, self.ty, self.path) = saved;","+    }","+","+    // We override it as to not report attribute paths as paths.","+    fn visit_attribute(&mut self, _: &'a ast::Attribute) {}","+","+    fn visit_expr(&mut self, e: &'a ast::Expr) {","+        if self.expr {","+            self.sess.dcx().emit_note(diagnostics::ShowSpan { span: e.span, kind: \"expr\" });","+        }","+        visit::walk_expr(self, e);","+    }","+","+    fn visit_ty(&mut self, t: &'a ast::Ty) {","+        if self.ty {","+            self.sess.dcx().emit_note(diagnostics::ShowSpan { span: t.span, kind: \"ty\" });","+        }","+        visit::walk_ty(self, t);","+    }","+","+    fn visit_path(&mut self, p: &'a ast::Path) {","+        if self.path {","+            self.sess.dcx().emit_note(diagnostics::ShowSpan { span: p.span, kind: \"path\" });","+        }","+        visit::walk_path(self, p);","+    }","+}","+","+pub fn check_crate(sess: &Session, krate: &ast::Crate) {","+    visit::walk_crate(&mut ShowSpans { sess, expr: false, ty: false, path: false }, krate);","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"compiler/rustc_attr_ir/src/data_structures.rs","lines":["@@ -577,6 +577,13 @@ impl<E: rustc_span::SpanEncoder> rustc_serialize::Encodable<E> for DocAttribute","     }"," }"," ","+#[derive(Clone, Debug, StableHash, Encodable, Decodable, PrintAttribute)]","+pub enum RustcShowSpansKind {","+    Expr,","+    Ty,","+    Path,","+}","+"," #[derive(Clone, Debug, StableHash, Encodable, Decodable, PrintAttribute)]"," pub enum RustcDumpLayoutKind {","     Align,","@@ -1426,6 +1433,9 @@ pub enum AttributeKind {","     /// Represents `#[rustc_should_not_be_called_on_const_items]`","     RustcShouldNotBeCalledOnConstItems,","