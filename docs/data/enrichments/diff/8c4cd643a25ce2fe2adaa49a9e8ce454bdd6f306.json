{"id":"8c4cd643a25ce2fe2adaa49a9e8ce454bdd6f306","axis":"silent","repo":"sanity-io/sanity","sha":"8c4cd643a25ce2fe2adaa49a9e8ce454bdd6f306","parsed":{"files":[{"path":"packages/@repo/test-dts-exports/test/fixtures/sanity._dangerously_use_private_internals_that_do_not_follow_semver.test-d.ts","lines":["@@ -559,6 +559,8 @@ import type {","   PrimitiveFieldProps,","   PUBLISHED,","   ReactHook,","+  recordStructurePaneKind,","+  recordStructureTool,","   Rect,","   ReferenceAutocomplete,","   ReferenceDiff,","@@ -662,6 +664,7 @@ import type {","   stringToPath,","   StructureBuilderOptions,","   StructureNodeIdValidationResult,","+  StructurePaneKind,","   StructureToolContextValue,","   StructureToolFeatures,","   StructureToolPaneActionHandler,","@@ -2567,6 +2570,12 @@ describe('sanity/_dangerously_use_private_internals_that_do_not_follow_semver',","   test('ReactHook', () => {","     expectTypeOf<ReactHook<any, any>>().not.toBeNever()","   })","+  test('recordStructurePaneKind', () => {","+    expectTypeOf<typeof recordStructurePaneKind>().toBeFunction()","+  })","+  test('recordStructureTool', () => {","+    expectTypeOf<typeof recordStructureTool>().toBeFunction()","+  })","   test('Rect', () => {","     expectTypeOf<Rect>().toBeObject()","   })","@@ -2877,6 +2886,9 @@ describe('sanity/_dangerously_use_private_internals_that_do_not_follow_semver',","   test('StructureNodeIdValidationResult', () => {","     expectTypeOf<StructureNodeIdValidationResult>().not.toBeNever()","   })","+  test('StructurePaneKind', () => {","+    expectTypeOf<StructurePaneKind>().not.toBeNever()","+  })","   test('StructureToolContextValue', () => {","     expectTypeOf<StructureToolContextValue>().toBeObject()","   })"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/sanity/src/_exports/_dangerously_use_private_internals_that_do_not_follow_semver.ts","lines":["@@ -914,6 +914,11 @@ export {"," } from '../core/studio/studioAnnouncements/utils'"," export {type NavbarContextValue} from '../core/studio/StudioLayout'"," export {StudioLayoutComponent} from '../core/studio/StudioLayoutComponent'","+export {","+  recordStructurePaneKind,","+  recordStructureTool,","+  type StructurePaneKind,","+} from '../core/studio/telemetry/paneKindRegistry'"," export {useTelemetryConsent} from '../core/studio/telemetry/useTelemetryConsent'"," export {","   UpsellDialogDismissed,"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/studio/telemetry/__tests__/paneKindRegistry.test.ts","lines":["@@ -0,0 +1,41 @@","+import {afterEach, describe, expect, it, vi} from 'vitest'","+","+function importFresh() {","+  return import('../paneKindRegistry')","+}","+","+async function importFreshAtCapacity() {","+  const registry = await importFresh()","+  Array.from({length: registry.MAX_ENTRIES}, (_unused, index) => `root;path-${index}`).forEach(","+    (resolverPath) => {","+      registry.recordStructurePaneKind('structure', resolverPath, 'document')","+    },","+  )","+  return registry","+}","+","+describe('paneKindRegistry', () => {","+  afterEach(() => {","+    vi.resetModules()","+  })","+","+  it('evicts the oldest recorded path once the cap is reached', async () => {","+    const {recordStructurePaneKind, getStructurePaneKind} = await importFreshAtCapacity()","+    expect(getStructurePaneKind('structure', 'path-0')).toBe('document')","+","+    recordStructurePaneKind('structure', 'root;path-overflow', 'list')","+","+    expect(getStructurePaneKind('structure', 'path-0')).toBeUndefined()","+    expect(getStructurePaneKind('structure', 'path-1')).toBe('document')","+    expect(getStructurePaneKind('structure', 'path-overflow')).toBe('list')","+  })","+","+  it('does not evict anything when overwriting an already-recorded path at the cap', async () => {","+    const {recordStructurePaneKind, getStructurePaneKind} = await importFreshAtCapacity()","+","+    recordStructurePaneKind('structure', 'root;path-0', 'list')","+","+    expect(getStructurePaneKind('structure', 'path-0')).toBe('list')","+    expect(getStructurePaneKind('structure', 'path-1')).toBe('document')","+  })","+})"],"additions":41,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/studio/telemetry/__tests__/softNavRoute.test.ts","lines":["@@ -0,0 +1,155 @@","+import {describe, expect, it} from 'vitest'","+","+import {recordStructurePaneKind, recordStructureTool} from '../paneKindRegistry'","+import {toSoftNavRoute, toToolPathSegments} from '../softNavRoute'","+","+const STUDIO_ORIGIN = 'https://my-studio.sanity.studio'","+const TOOL_NAMES = ['structure', 'cars', 'vision', 'media-library', 'presentation']","+","+recordStructureTool('structure')","+recordStructureTool('cars')","+","+function routeFor(path: string, basePath = '/'): string {","+  return toSoftNavRoute({","+    navigationURL: `${STUDIO_ORIGIN}${path}`,","+    basePath,","+    toolNames: TOOL_NAMES,","+  })","+}","+","+describe('toSoftNavRoute', () => {","+  it('classifies a list pane using the kind the structure tool recorded for that path', () => {","+    recordStructurePaneKind('structure', 'root;author', 'list')","+","+    expect(routeFor('/structure/author')).toBe('structure:list')","+  })","+","+  it('classifies a document pane the same way', () => {","+    recordStructurePaneKind('structure', 'root;author;knut', 'document')","+","+    expect(routeFor('/structure/author;knut')).toBe('structure:document')","+  })","+","+  it('looks up a pane carrying params by its id chain alone, decoding the group the router encodes', () => {","+    recordStructurePaneKind('structure', 'root;book;book-a', 'document')","+","+    const encodedGroup = encodeURIComponent('book-a,inspect=sanity%2Fstructure%2Fvalidation')","+    expect(routeFor(`/structure/book;${encodedGroup}`)).toBe('structure:document')","+  })","+","+  it('looks up a split-pane group by its first sibling, decoding the group the router encodes', () => {","+    recordStructurePaneKind('structure', 'root;book;book-a', 'list')","+","+    const encodedGroup = encodeURIComponent('book-a|,')","+    expect(routeFor(`/structure/book;${encodedGroup}`)).toBe('structure:list')","+  })","+","+  it('classifies a nested list opened inside a list as a list', () => {","+    recordStructurePaneKind('structure', 'root;photos', 'list')","+    recordStructurePaneKind('structure', 'root;photos;featured', 'list')","+","+    expect(routeFor('/structure/photos;featured')).toBe('structure:list')","+  })","+","+  it('classifies panes the same way for a renamed structure tool, with no collision against another tool', () => {","+    recordStructurePaneKind('cars', 'root;book;renamed-tool-knut', 'document')","+    recordStructurePaneKind('structure', 'root;book;renamed-tool-knut', 'list')","+","+    expect(routeFor('/cars/book;renamed-tool-knut')).toBe('structure:document')","+    expect(routeFor('/structure/book;renamed-tool-knut')).toBe('structure:list')","+  })","+","+  it('reports structure:other for a pane path nothing has recorded, rather than guessing', () => {","+    expect(routeFor('/structure/never-seen-before')).toBe('structure:other')","+  })","+","+  it('reports structure:other for a group with a malformed percent-encoding', () => {","+    expect(routeFor('/structure/author;%E0%A4%A')).toBe('structure:other')","+  })","+","+  it('reports a bare tool name for non-structure tools, with no pane kind', () => {","+    expect(routeFor('/vision')).toBe('vision')","+    expect(routeFor('/vision/anything/goes/here')).toBe('vision')","+  })","+","+  it('classifies known intent routes by intent name, unknown intents as other', () => {","+    expect(routeFor('/intent/edit/id=abc33')).toBe('intent:edit')","+    expect(routeFor('/intent/create/type=book')).toBe('intent:create')","+    expect(routeFor('/intent/some-future-intent/id=abc33')).toBe('intent:other')","+  })","+","+  it('classifies a tool-scoped intent route the same way, e.g. global search landing in structure', () => {","+    expect(routeFor('/structure/intent/edit/id=abc33;type=article')).toBe('intent:edit')","+  })","+","+  it('records through a root-prefixed resolver path and looks up from the real URL it maps to', () => {","+    recordStructurePaneKind('structure', 'root;book;knut', 'document')","+","+    expect(routeFor('/structure/book;knut')).toBe('structure:document')","+  })","+","+  it('falls back to other for an unknown tool name', () => {","+    expect(routeFor('/some-removed-tool/whatever')).toBe('other')","+  })","+","+  it('falls back to other for a URL outside the workspace basePath', () => {","+    expect(routeFor('/other-workspace/structure/author', '/my-workspace')).toBe('other')","+  })","+","+  it('falls back to other for an empty path', () => {","+    expect(routeFor('/')).toBe('other')","+  })","+","+  it('falls back to other for an unparseable URL', () => {","+    expect(toSoftNavRoute({navigationURL: 'not-a-url', basePath: '/', toolNames: TOOL_NAMES})).toBe(","+      'other',","+    )","+  })","+","+  it('respects a non-root workspace basePath', () => {","+    recordStructurePaneKind('structure', 'root;author;knut-scoped', 'document')","+","+    expect(routeFor('/my-workspace/structure/author;knut-scoped', '/my-workspace')).toBe(","+      'structure:document',","+    )","+  })","+","+  it('never includes a document id, slug, or raw query string in the result', () => {","+    recordStructurePaneKind('structure', 'root;author;very-specific-document-id-123', 'document')","+","+    expect(routeFor('/structure/author;very-specific-document-id-123?foo=bar')).toBe(","+      'structure:document',","+    )","+  })","+","+  it('derives the route from the reported navigationURL, not from a later navigation', () => {","+    recordStructurePaneKind('structure', 'root;author;first-opened', 'document')","+","+    const firstNavRoute = routeFor('/structure/author;first-opened')","+","+    // A metric can report after the user has already navigated again.","+    routeFor('/structure/second-opened')","+","+    expect(routeFor('/structure/author;first-opened')).toBe(firstNavRoute)","+    expect(firstNavRoute).toBe('structure:document')","+  })","+})","+","+describe('toToolPathSegments', () => {","+  it('returns the path segments after the workspace basePath', () => {","+    expect(toToolPathSegments(`${STUDIO_ORIGIN}/structure/author;knut`, '/')).toEqual([","+      'structure',","+      'author;knut',","+    ])","+  })","+","+  it('returns an empty array for a URL outside the workspace basePath', () => {","+    expect(","+      toToolPathSegments(`${STUDIO_ORIGIN}/other-workspace/structure`, '/my-workspace'),","+    ).toEqual([])","+  })","+","+  it('returns an empty array for an unparseable URL', () => {","+    expect(toToolPathSegments('not-a-url', '/')).toEqual([])","+  })","+})"],"additions":155,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/studio/telemetry/paneKindRegistry.ts","lines":["@@ -0,0 +1,50 @@","+/** @internal */","+export type StructurePaneKind = 'list' | 'document' | 'other'","+","+// Pane kinds are resolved inside `structure/`, which core cannot import, so the structure tool records them here.","+const paneKindByKey = new Map<string, StructurePaneKind>()","+const structureToolNames = new Set<string>()","+","+// Caps memory in a long-running session; eviction is oldest-recorded-key-first.","+export const MAX_ENTRIES = 500","+","+function toRegistryKey(toolName: string, registryPath: string): string {","+  return JSON.stringify([toolName, registryPath])","+}","+","+/** @internal */","+export function recordStructureTool(toolName: string): void {","+  structureToolNames.add(toolName)","+}","+","+/** @internal */","+export function isStructureTool(toolName: string): boolean {","+  return structureToolNames.has(toolName)","+}","+","+/** @internal */","+export function recordStructurePaneKind(","+  toolName: string,","+  resolverPath: string,","+  kind: StructurePaneKind,","+): void {","+  // The resolver path leads with the root node's id, absent from the URL; drop by position as custom structures rename it.","+  const registryPath = resolverPath.split(';').slice(1).join(';')","+  const key = toRegistryKey(toolName, registryPath)","+","+  paneKindByKey.delete(key)","+  paneKindByKey.set(key, kind)","+","+  if (paneKindByKey.size > MAX_ENTRIES) {","+    const [oldestKey] = paneKindByKey.keys()","+    paneKindByKey.delete(oldestKey)","+  }","+}","+","+/** @internal */","+export function getStructurePaneKind(","+  toolName: string,","+  registryPath: string,","+): StructurePaneKind | undefined {","+  return paneKindByKey.get(toRegistryKey(toolName, registryPath))","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/studio/telemetry/softNavRoute.ts","lines":["@@ -0,0 +1,71 @@","+import {getStructurePaneKind, isStructureTool} from './paneKindRegistry'","+","+const KNOWN_INTENT_NAMES = new Set(['create', 'edit', 'duplicate'])","+","+const OTHER = 'other'","+","+interface SoftNavRouteInput {","+  /** The `navigationURL` field of a soft-navigation web-vitals metric. */","+  navigationURL: string","+  basePath: string","+  toolNames: string[]","+}","+","+export function toToolPathSegments(navigationURL: string, basePath: string): string[] {","+  let pathname: string","+  try {","+    pathname = new URL(navigationURL).pathname","+  } catch {","+    return []","+  }","+","+  const pathSegments = pathname.split('/').filter(Boolean)","+  const baseSegments = basePath.split('/').filter(Boolean)","+","+  const matchesBase = baseSegments.every((segment, index) => pathSegments[index] === segment)","+  return matchesBase ? pathSegments.slice(baseSegments.length) : []","+}","+","+function toIntentRoute(intentName: string | undefined): string {","+  if (intentName && KNOWN_INTENT_NAMES.has(intentName)) return `intent:${intentName}`","+  return `intent:${OTHER}`","+}","+","+function decodePaneSegment(paneSegment: string): string | undefined {","+  try {","+    return decodeURIComponent(paneSegment)","+  } catch {","+    return undefined","+  }","+}","+","+function toRegistryPathFromUrl(decodedSegment: string): string {","+  return decodedSegment","+    .split(';')","+    .filter(Boolean)","+    .map((group) => group.split('|')[0].split(',')[0])","+    .join(';')","+}","+","+function toStructurePaneKind(toolName: string, paneSegment: string | undefined): string {","+  // The router percent-encodes each ';' group whole, so ',' params and '|' siblings are only literal once decoded.","+  const decodedSegment = decodePaneSegment(paneSegment ?? '')","+  if (decodedSegment === undefined) return OTHER","+  return getStructurePaneKind(toolName, toRegistryPathFromUrl(decodedSegment)) ?? OTHER","+}","+","+export function toSoftNavRoute(input: SoftNavRouteInput): string {","+  const toolSegments = toToolPathSegments(input.navigationURL, input.basePath)","+  if (toolSegments.length === 0) return OTHER","+","+  const [toolName, firstToolSegment, secondToolSegment] = toolSegments","+  if (toolName === 'intent') return toIntentRoute(firstToolSegment)","+  if (input.toolNames.includes(toolName)) {","+    if (firstToolSegment === 'intent') return toIntentRoute(secondToolSegment)","+    if (isStructureTool(toolName))","+      return `structure:${toStructurePaneKind(toolName, firstToolSegment)}`","+    return toolName","+  }","+","+  return OTHER","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"packages/sanity/src/structure/components/structureTool/StructureTool.tsx","lines":["@@ -20,6 +20,7 @@ import {StructureTitle} from './StructureTitle'"," "," interface StructureToolProps {","   onPaneChange: (panes: Array<PaneNode | typeof LOADING_PANE>) => void","+  toolName: string"," }"," "," const StyledPaneLayout = styled(PaneLayout)`","@@ -32,7 +33,10 @@ const isSaveHotkey = isHotkey('mod+s')"," /**","  * @internal","  */","-export const StructureTool = memo(function StructureTool({onPaneChange}: StructureToolProps) {","+export