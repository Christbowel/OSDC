      .iter()","+                .filter_map(|tag| match tag.as_str() {","+                    \"v4.2.0\" => Some((tag.clone(), CUTOFF - 60)),","+                    \"v5.0.0\" => Some((tag.clone(), CUTOFF + 60)),"],"additions":40,"deletions":0,"truncated":false}],"additions":465,"deletions":31,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-09-25T13:31:54.277810+00:00"}