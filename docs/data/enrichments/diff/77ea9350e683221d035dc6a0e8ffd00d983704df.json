network_id()","+\t\t\t\t)","+\t\t\t);","+\t\t} else {","+\t\t\t$value = $wpdb->get_var(","+\t\t\t\t$wpdb->prepare(","+\t\t\t\t\t\"SELECT option_value FROM $wpdb->options WHERE option_name = %s LIMIT 1\",","+\t\t\t\t\tself::ROOT_KEY_OPTION","+\t\t\t\t)","+\t\t\t);","+\t\t}","+","+\t\tif ( '' !== $wpdb->last_error ) {","+\t\t\treturn new WP_Error(","+\t\t\t\tWP_SECRETS_ERROR_STORE_UNAVAILABLE,","+\t\t\t\t__( 'Could not read the root key.' )","+\t\t\t);","+\t\t}","+","+\t\tif ( null === $value ) {","+\t\t\treturn false;","+\t\t}","+","+\t\t$this->forget_missing_root_key();","+","+\t\t$value = maybe_unserialize( $value );","+","+\t\tif ( ! is_string( $value ) ) {","+\t\t\treturn new WP_Error(","+\t\t\t\tWP_SECRETS_ERROR_RECORD_MALFORMED,","+\t\t\t\t__( 'The stored root key is not a string.' )","+\t\t\t);","+\t\t}","+","+\t\treturn $value;","+\t}","+","+\t/**","+\t * Removes the root key from the cache of options that do not exist.","+\t *","+\t * @since 7.2.0","+\t */","+\tprivate function forget_missing_root_key(): void {","+\t\tif ( is_multisite() ) {","+\t\t\t$network_id     = get_current_network_id();","+\t\t\t$group          = 'site-options';","+\t\t\t$notoptions_key = \"$network_id:notoptions\";","+","+\t\t\twp_cache_delete( \"$network_id:\" . self::ROOT_KEY_OPTION, $group );","+\t\t} else {","+\t\t\t$group          = 'options';","+\t\t\t$notoptions_key = 'notoptions';","+","+\t\t\twp_cache_delete( self::ROOT_KEY_OPTION, $group );","+\t\t}","+","+\t\t$notoptions = wp_cache_get( $notoptions_key, $group );","+","+\t\tif ( is_array( $notoptions ) && isset( $notoptions[ self::ROOT_KEY_OPTION ] ) ) {","+\t\t\tunset( $notoptions[ self::ROOT_KEY_OPTION ] );","+\t\t\twp_cache_set( $notoptions_key, $notoptions, $group );","+\t\t}","+\t}"," }"],"additions":185,"deletions":11,"truncated":false},{"path":"wp-includes/secrets/class-wp-secrets-libsodium-provider.php","lines":["@@ -495,7 +495,8 @@ public function get( string $name, string $version, bool $network = false ) {"," \t