ssert.Nil(t, err, \"SQL injection payload must not cause a query error\")","+\t// Runs are returned but without a matching metric value (NULL join), so","+\t// ordering is stable but no metric value is injected into SQL structure.","+\tassert.NotNil(t, runs)","+","+\t// Verify the run_metrics table was NOT dropped by confirming a normal","+\t// metric-sort query still works.","+\topts2, err := list.NewOptions(&model.Run{}, 10, \"metric:dummymetric\", nil)","+\tassert.Nil(t, err)","+\t_, _, _, err = runStore.ListRuns(","+\t\t&model.FilterContext{ReferenceKey: &model.ReferenceKey{Type: model.ExperimentResourceType, ID: defaultFakeExpId}},","+\t\topts2)","+\tassert.Nil(t, err, \"run_metrics table must still exist after injection attempt\")","+}","+","+// TestListRuns_HyphenatedMetricSort verifies that metric names containing","+// hyphens (e.g. \"log-loss\") can be used for pagination across multiple pages.","+// This is a regression test for a bug where token.unmarshal() validated","+// SortByFieldName with a SQL identifier regex that rejects \"-\", causing page-2","+// requests with hyphenated metric names to fail with \"Invalid sort field name\".","+func TestListRuns_HyphenatedMetricSort(t *testing.T) {","+\tdb, runStore := initializeRunStore()","+\tdefer db.Close()","+","+\t// Seed runs 1 and 2 with the hyphenated metric so pagination produces a page token.","+\trunStore.CreateMetric(&model.RunMetric{RunUUID: \"1\", NodeID: \"node1\", Name: \"log-loss\", NumberValue: 0.5, Format: \"RAW\"})","+\trunStore.CreateMetric(&model.RunMetric{RunUUID: \"2\", NodeID: \"node2\", Name: \"log-loss\", NumberValue: 0.3, Format: \"RAW\"})","+","+\t// Page 1: metric:log-loss — must not error even though \"log-loss\" contains \"-\".","+\topts, err := list.NewOptions(&model.Run{}, 1, \"metric:log-loss\", nil)","+\tassert.Nil(t, err, \"NewOptions must accept hyphenated metric name\")","+","+\t_, total, nextPageToken, err := runStore.ListRuns(","+\t\t&model.FilterContext{ReferenceKey: &model.ReferenceKey{Type: model.ExperimentResourceType, ID: defaultFakeExpId}},","+\t\topts)","+\tassert.Nil(t, err, \"page-1 ListRuns must succeed with hyphenated metric name\")","+\tassert.Equal(t, 2, total)","+\tassert.NotEmpty(t, nextPageToken, \"must produce a page token when there are 2 runs\")","+","+\t// Page 2: the page token carries SortByFieldName=\"log-loss\". Unmarshalling","+\t// it must succeed (i.e. the identifier regex must NOT be applied to metric names).","+\topts2, err := list.NewOptionsFromToken(nextPageToken, 1)","+\tassert.Nil(t, err, \"NewOptionsFromToken must not reject hyphenated metric name in pageToken\")","+\t_, _, _, err = runStore.ListRuns(","+\t\t&model.FilterContext{ReferenceKey: &model.ReferenceKey{Type: model.ExperimentResourceType, ID: defaultFakeExpId}},","+\t\topts2)","+\tassert.Nil(t, err, \"page-2 ListRuns must succeed with hyphenated metric name in pageToken\")","+}","+"," func TestListRuns_TotalSizeWithNoFilter(t *testing.T) {"," \tdb, runStore := initializeRunStore()"," \tdefer db.Close()",""],"additions":65,"deletions":0,"truncated":false}],"additions":270,"deletions":45,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-10T17:04:47.305111+00:00"}