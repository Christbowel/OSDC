pe does not match signature algorithm {}\".format(alg),","+    ):","+        await id_token.verify_firebase_token(token, request, audience=\"my-project-id\")","+","+","+@pytest.mark.asyncio","+async def test_verify_firebase_token_end_to_end():","+    with open(test_id_token.PRIVATE_KEY_FILE, \"rb\") as fh:","+        private_key = fh.read()","+    with open(test_id_token.PUBLIC_CERT_FILE, \"r\") as fh:","+        public_cert = fh.read()","+","+    signer = crypt.RSASigner.from_string(private_key, \"1\")","+    now = _helpers.datetime_to_secs(_helpers.utcnow())","+","+    valid_payload = {","+        \"aud\": \"my-project-id\",","+        \"iss\": \"https://securetoken.google.com/my-project-id\",","+        \"sub\": \"my-user-id\",","+        \"iat\": now,","+        \"exp\": now + 300,","+    }","+    valid_token = jwt.encode(signer, valid_payload)","+    request = make_request(200, {\"1\": public_cert})","+","+    result = await id_token.verify_firebase_token(","+        valid_token, request, audience=\"my-project-id\"","+    )","+    assert result == valid_payload","+","+    cross_tenant_token = jwt.encode(","+        signer,","+        {","+            \"aud\": \"other-project-id\",","+            \"iss\": \"https://securetoken.google.com/other-project-id\",","+            \"sub\": \"my-user-id\",","+            \"iat\": now,","+            \"exp\": now + 300,","+        },","+    )","+    request = make_request(200, {\"1\": public_cert})","+    with pytest.raises(exceptions.InvalidValue, match=\"Token has wrong audience\"):","+        await id_token.verify_firebase_token(","+            cross_tenant_token, request, audience=\"my-project-id\"","+        )","+","+"," @pytest.mark.asyncio"," @pytest.mark.parametrize(","     \"call_kwargs,expected_bind_id_token\",",""],"additions":204,"deletions":4,"truncated":false}],"additions":560,"deletions":25,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-07T15:03:49.990575+00:00"}