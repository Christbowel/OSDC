","+\t\t\t}","+\t\t\tsrv, err := rt.buildServer(t.Context())","+\t\t\tif err != nil {","+\t\t\t\tt.Fatal(err)","+\t\t\t}","+\t\t\trecorder := httptest.NewRecorder()","+\t\t\tsrv.Handler.ServeHTTP(recorder, httptest.NewRequest(http.MethodPost, \"/v1/data/test\", strings.NewReader(strings.Repeat(\" \", 17))))","+\t\t\tif recorder.Code != tc.status {","+\t\t\t\tt.Fatalf(\"got %d, want %d: %s\", recorder.Code, tc.status, recorder.Body.String())","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"v1/server/authorizer/authorizer.go","lines":["@@ -11,6 +11,7 @@ import ("," \t\"net/url\""," \t\"strings\""," ","+\t\"github.com/open-policy-agent/opa/internal/server/bodylimit\""," \t\"github.com/open-policy-agent/opa/v1/ast\""," \t\"github.com/open-policy-agent/opa/v1/rego\""," \t\"github.com/open-policy-agent/opa/v1/server/identifier\"","@@ -28,6 +29,7 @@ type Basic struct {"," \tcompiler               func() *ast.Compiler"," \tstore                  storage.Store"," \truntime                *ast.Term","+\tv2Compatible           bool"," \tdecision               func() ast.Ref"," \tprintHook              print.Hook"," \tenablePrintStatements  bool","@@ -43,6 +45,14 @@ func Runtime(term *ast.Term) func(*Basic) {"," \t}"," }"," ","+// V2Compatible enables v2-compatible request-body error responses on the authorizer.","+// Oversized request bodies return HTTP 413 instead of HTTP 400.","+func V2Compatible(yes bool) func(*Basic) {","+\treturn func(b *Basic) {","+\t\tb.v2Compatible = yes","+\t}","+}","+"," // Decision returns an argument that sets the path of the authorization decision"," // to query."," func Decision(ref func() ast.Ref) func(*Basic) {","@@ -109,7 +119,7 @@ func (b *Basic) ServeHTTP(w http.ResponseWriter, r *http.Request) {"," \t// conversions."," \tr, input, err := makeInput(r, b.urlPathExpectsBodyFunc)"," \tif err != nil {","-\t\twriter.ErrorString(w, http.StatusBadRequest, types.CodeInvalidParameter, err)","+\t\twriter.Erro