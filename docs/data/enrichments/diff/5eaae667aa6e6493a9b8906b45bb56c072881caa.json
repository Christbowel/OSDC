ct {","+\t\tname, method, path, body string","+\t\tchunked, gzip, tooLarge  bool","+\t\tstatus                   int","+\t}","+\tcases := []requestCase{","+\t\t{name: \"content length\", body: oversized, tooLarge: true},","+\t\t{name: \"chunked\", body: oversized, chunked: true, tooLarge: true},","+\t\t{name: \"gzip\", body: oversized, gzip: true, tooLarge: true},","+\t\t{name: \"under limit\", body: `{\"input\":{}}`, status: http.StatusOK},","+\t\t{name: \"boundary\", body: `{\"input\":\"` + strings.Repeat(\"x\", 52) + `\"}`, status: http.StatusOK},","+\t\t{name: \"malformed json\", body: `{\"input\":`, status: http.StatusBadRequest},","+\t}","+\tfor _, endpoint := range []struct{ method, path string }{","+\t\t{http.MethodPost, \"/\"}, {http.MethodPost, \"/v0/data/test\"},","+\t\t{http.MethodPost, \"/v1/query\"}, {http.MethodPost, \"/v1/compile\"},","+\t\t{http.MethodPost, \"/v1/compile/test\"}, {http.MethodPut, \"/v1/data/test\"},","+\t\t{http.MethodPatch, \"/v1/data/test\"}, {http.MethodPut, \"/v1/policies/test\"},","+\t} {","+\t\tcases = append(cases,","+\t\t\trequestCase{name: endpoint.method + \" \" + endpoint.path, method: endpoint.method, path: endpoint.path, body: oversized, chunked: true, tooLarge: true},","+\t\t\trequestCase{name: \"malformed \" + endpoint.method + \" \" + endpoint.path, method: endpoint.method, path: endpoint.path, body: \"{\", chunked: true, status: http.StatusBadRequest},","+\t\t)","+\t}","+\tfor _, authz := range []bool{false, true} {","+\t\tversions := []ast.RegoVersion{ast.RegoUndefined, ast.RegoV0, ast.RegoV1, ast.RegoV2}","+\t\tservers := map[ast.RegoVersion]*Server{}","+\t\t// Initialize all modes before serving requests to catch shared compatibility state.","+\t\tfor _, version := range versions {","+\t\t\tctx := t.Context()","+\t\t\tstore := inmem.New()","+\t\t\tif err := storage.Txn(ctx, store, storage.WriteParams, func(txn storage.Transaction) error {","+\t\t\t\treturn store.UpsertPolicy(ctx, txn, \"authz\", []byte(\"package 