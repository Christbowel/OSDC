{"id":"5eaae667aa6e6493a9b8906b45bb56c072881caa","axis":"silent","repo":"open-policy-agent/opa","sha":"5eaae667aa6e6493a9b8906b45bb56c072881caa","parsed":{"files":[{"path":"docs/docs/configuration.md","lines":["@@ -1083,6 +1083,13 @@ The `server` configuration sets:","   The gzip compression settings are used when the client sends `Accept-Encoding: gzip`"," - buckets for `http_request_duration_seconds` histogram"," ","+Requests that exceed a body-size limit return HTTP 400 by default. When v2","+compatibility is enabled (`--v2-compatible`), they return HTTP 413; the error","+response body is unchanged.","+","+Go integrations constructing an authorizer directly can enable this behavior with","+the `authorizer.V2Compatible(true)` option to `authorizer.NewBasic`.","+"," | Field                                                       | Type        | Required                                                                 | Description                                                                                                                                                                                                                          |"," | ----------------------------------------------------------- | ----------- | ------------------------------------------------------------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |"," | `server.decoding.max_length`                                | `int`       | No, (default: 268435456)                                                 | Specifies the maximum allowed number of bytes to read from a request body.                                                                                                                                                           |"],"additions":7,"deletions":0,"truncated":false},{"path":"internal/server/bodylimit/decoding.go","lines":["@@ -0,0 +1,72 @@","+// Copyright 2026 The OPA Authors.  All rights reserved.","+// Use of this source code is governed by an Apache2","+// license that can be found in the LICENSE file.","+","+package bodylimit","+","+import (","+\t\"errors\"","+\t\"net/http\"","+\t\"strings\"","+","+\t\"github.com/open-policy-agent/opa/v1/server/types\"","+\t\"github.com/open-policy-agent/opa/v1/server/writer\"","+\t\"github.com/open-policy-agent/opa/v1/util\"","+\tutil_decoding \"github.com/open-policy-agent/opa/v1/util/decoding\"","+)","+","+// Handler provides hard limits on the size of the request body, for both","+// the raw body content, and also for the decompressed size when gzip","+// compression is used.","+//","+// The Content-Length restriction happens here in the handler, but the","+// decompressed size limit is enforced later, in `util.ReadMaybeCompressedBody`.","+// The handler passes the gzip size limits down to that function through the","+// request context whenever gzip encoding is present.","+func Handler(handler http.Handler, maxLength, gzipMaxLength int64, v2Compatible bool) http.Handler {","+\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\t// Reject too-large requests before doing any further processing.","+\t\t// Note(philipc): This does nothing in the case of \"chunked\"","+\t\t// requests, since those should report a ContentLength of -1.","+\t\tif r.ContentLength > maxLength {","+\t\t\terr := &util.BodyTooLargeError{Limit: maxLength, Size: r.ContentLength}","+\t\t\twriter.Error(w, ErrorStatus(v2Compatible, err), types.NewErrorV1(types.CodeInvalidParameter, \"%v\", err))","+\t\t\treturn","+\t\t}","+\t\t// For requests where full size is not known in advance (such as chunked","+\t\t// requests), pass server.decoding.max_length down, using the request","+\t\t// context.","+","+\t\t// Note(philipc): Unknown request body size is signaled to the server","+\t\t// handler by net/http setting the Request.ContentLength field to -1. We","+\t\t// don't check for the `Transfer-Encoding: chunked` header explicitly,","+\t\t// because net/http will strip it out from requests automatically.","+\t\t// Ref: https://pkg.go.dev/net/http#Request","+\t\tif r.ContentLength < 0 {","+\t\t\tctx := util_decoding.AddServerDecodingMaxLen(r.Context(), maxLength)","+\t\t\tr = r.WithContext(ctx)","+\t\t}","+\t\t// Pass server.decoding.gzip.max_length down, using the request context.","+\t\tif strings.Contains(r.Header.Get(\"Content-Encoding\"), \"gzip\") {","+\t\t\tctx := util_decoding.AddServerDecodingGzipMaxLen(r.Context(), gzipMaxLength)","+\t\t\tr = r.WithContext(ctx)","+\t\t}","+","+\t\t// Copied over from the net/http package; enforces max body read limits.","+\t\tr2 := *r","+\t\tr2.Body = http.MaxBytesReader(w, r.Body, maxLength)","+\t\thandler.ServeHTTP(w, &r2)","+\t})","+}","+","+// ErrorStatus returns the status for a request-body error.","+func ErrorStatus(v2Compatible bool, err error) int {","+\tif v2Compatible {","+\t\t_, bodyTooLarge := errors.AsType[*util.BodyTooLargeError](err)","+\t\t_, maxBytes := errors.AsType[*http.MaxBytesError](err)","+\t\tif bodyTooLarge || maxBytes {","+\t\t\treturn http.StatusRequestEntityTooLarge","+\t\t}","+\t}","+\treturn http.StatusBadRequest","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"server/authorizer/authorizer.go","lines":["@@ -28,6 +28,12 @@ func Runtime(term *ast.Term) func(*Basic) {"," \treturn v1.Runtime(term)"," }"," ","+// V2Compatible enables v2-compatible request-body error responses on the authorizer.","+// Oversized request bodies return HTTP 413 instead of HTTP 400.","+func V2Compatible(yes bool) func(*Basic) {","+\treturn v1.V2Compatible(yes)","+}","+"," // Decision returns an argument that sets the path of the authorization decision"," // to query."," func Decision(ref func() ast.Ref) func(*Basic) {"],"additions":6,"deletions":0,"truncated":false},{"path":"server/handlers/handlers.go","lines":["