at value back as","+// page_token in an otherwise identical request returns the page that follows, so","+// that a caller walking the token chain sees every matching trace exactly once. An","+// empty next_page_token means the search is exhausted.","+//","+// Pagination replaces search_depth rather than refining it: the two are mutually","+// exclusive, and a request that sets both is refused with InvalidArgument.","+//","+// Only FindTraceIDs and FindTraceSummaries paginate, returning the token on","+// FindTraceIDsResponse and FindTraceSummariesResponse. FindTraces streams","+// opentelemetry.proto.trace.v1.TracesData, an OTLP type with no field to carry a","+// token, so FindTraces is not paginated at all: a FindTraces request that sets","+// pagination is refused with InvalidArgument, and search_depth bounds such a call","+// instead.","+//","+// A backend should only honor a Pagination if it declares","+// SearchCapabilities.paginated. One that does not serves a single page capped at","+// page_size and returns an empty next_page_token even when matches remain, and","+// refuses a request carrying a page_token with InvalidArgument, since it cannot","+// have minted a valid token.","+type Pagination struct {","+\t// page_size bounds the number of results in one page. A Pagination that leaves it","+\t// zero does not describe a page and is refused with InvalidArgument.","+\t//","+\t// This field is required.","+\tPageSize uint32 `protobuf:\"varint,1,opt,name=page_size,json=pageSize,proto3\" json:\"page_size,omitempty\"`","+\t// page_token is the next_page_token returned for the preceding page; empty starts","+\t// a new search. The value is opaque, and a caller MUST echo back exactly what the","+\t// backend returned without inspecting or modifying it. A token is only valid for","+\t// the query that produced it.","+\t//","+\t// This field is optional.","+\tPageToken            string   `protobuf:\"bytes,2,opt,name=page_token,json=pageToken,proto3\" json:\"page_token,omitempty\"`","+\tXXX_NoUnkeyedLiteral struct{} `json:\"-\"`","+\tXXX_unrecognized     []byte   `json:\"-\"`","+\tXXX_sizecache        int32    `json:\"-\"`","+}","+","+func (m *Pagination) Reset()         { *m = Pagination{} }","+func (m *Pagination) String() string { return proto.CompactTextString(m) }","+func (*Pagination) ProtoMessage()    {}","+func (*Pagination) Descriptor() ([]byte, []int) {","+\treturn fileDescriptor_3441c0fd9397413c, []int{12}","+}","+func (m *Pagination) XXX_Unmarshal(b []byte) error {","+\treturn m.Unmarshal(b)","+}","+func (m *Pagination) XXX_Marshal(b []byte, deterministic bool) ([]byte, error) {","+\tif deterministic {","+\t\treturn xxx_messageInfo_Pagination.Marshal(b, m, deterministic)","+\t} else {","+\t\tb = b[:cap(b)]","+\t\tn, err := m.MarshalToSizedBuffer(b)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\treturn b[:n], nil","+\t}","+}","+func (m *Pagination) XXX_Merge(src proto.Message) {","+\txxx_messageInfo_Pagination.Merge(m, src)","+}","+func (m *Pagination) XXX_Size() int {","+\treturn m.Size()","+}","+func (m *Pagination) XXX_DiscardUnknown() {","+\txxx_messageInfo_Pagination.DiscardUnknown(m)","+}","+","+var xxx_messageInfo_Pagination proto.InternalMessageInfo","+","+func (m *Pagination) GetPageSize() uint32 {","+\tif m != nil {","+\t\treturn m.PageSize","+\t}","+\treturn 0","+}","+","+func (m *Pagination) GetPageToken() string {","+\tif m != nil {","+\t\treturn m.PageToken","+\t}","+\treturn \"\"","+}","+"," // FindTracesRequest represents a request to find traces."," type FindTracesRequest struct {"," \tQuery                *TraceQueryParameters `protobuf:\"bytes,1,opt,name=query,proto3\" json:\"query,omitempty\"`","@@ -846,7 +947,7 @@ func (m *FindTracesRequest) Reset()         { *m = FindTracesRequest{} }"," func (m *FindTracesRequest) String() string { return proto.CompactTextString(m) }"," func (*FindTracesRequest) ProtoMessage()    {}"," func (*FindTracesRequest) Descriptor() ([]byte, []int) {"