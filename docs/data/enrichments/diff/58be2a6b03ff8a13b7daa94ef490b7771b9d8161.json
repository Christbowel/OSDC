model/0.6.2.envoy/MODULE.bazel\": \"40e1b9b9db52c3238fcc3e85c08ef35eb9157783e620009ed01eeed7631a9f67\","],"additions":3,"deletions":3,"truncated":false},{"path":"compat/openssl/AGENTS.md","lines":["@@ -50,7 +50,7 @@ Envoy is built against the BoringSSL API. The compat layer lets it run on OpenSS"," "," The BoringSSL sources come from the `@boringssl-source` repo"," (`bazel-envoy/external/boringssl-source+/`), **not** `@boringssl`. OpenSSL headers come","-from `bazel-envoy/external/openssl+/include/openssl/`.","+from `bazel-bin/compat/openssl/openssl_include/openssl/`."," "," ## Key files to modify"," ","@@ -152,7 +152,7 @@ since OpenSSL will never produce these BoringSSL-specific error codes."," "," If a constant must exist but its value collides with another constant's value (e.g.,"," `ERR_R_OVERFLOW` aliased to `ERR_R_INTERNAL_ERROR`), give it a unique value. Check","-OpenSSL's range for the constant family in `bazel-envoy/external/openssl+/include/openssl/`","+OpenSSL's range for the constant family in `bazel-bin/compat/openssl/openssl_include/openssl/`"," and pick a value above the highest used one."," "," ## Adapting to upstream refactors in BoringSSL","@@ -264,7 +264,7 @@ Check the `ossl.h` struct to see which OpenSSL functions are available as functi"," "," 3. **For each undeclared function:**","    - Check if it exists in BoringSSL (`bazel-envoy/external/boringssl-source+/include/openssl/`)","-   - Check if it exists in OpenSSL (`bazel-envoy/external/openssl+/include/openssl/`)","+   - Check if it exists in OpenSSL (`bazel-bin/compat/openssl/openssl_include/openssl/`)","    - Add `--uncomment-func-decl` to the patch script + entry in BUILD","    - If OpenSSL's semantics differ, or it has no OpenSSL equivalent, write a handwritten","      source file (and a test in `test/`)"],"additions":3,"deletions":3,"truncated":false},{"path":"compat/openssl/BUILD","lines":["@@ -1,9 +1,50 @@","+load(\"@rules_cc//cc:cc_shared_library.bzl\", \"cc_shared_library\")"," load(\"@rules_cc//cc:defs.bzl\", \"cc_library\")"," load(\"//bazel:toolchains.bzl\", \"LIBCLANG_CPP\", \"LIBLLVM\")","-load(\"//compat/openssl:bazel/rules.bzl\", \"mapping_func_filegroup\", \"patched_bssl_filegroup\")","+load(\"//compat/openssl:bazel/rules.bzl\", \"mapping_func_filegroup\", \"openssl_include_dir\", \"patched_bssl_filegroup\")"," "," licenses([\"notice\"])  # Apache 2"," ","+# Must match the major version of the @openssl module, as ossl_dlopen() loads","+# libcrypto.so.<major> and libssl.so.<major>.","+OPENSSL_SOVERSION = \"3\"","+","+# OpenSSL shared libraries, built from the @openssl module's static libraries.","+# They are only loaded at runtime with dlopen() (see source/ossl_dlutil.c), so","+# they are a *data* dependency of :bssl-compat, never a link dependency.","+cc_shared_library(","+    name = \"libcrypto\",","+    shared_lib_name = \"libcrypto.so.\" + OPENSSL_SOVERSION,","+    user_link_flags = [\"-Wl,-soname,libcrypto.so.\" + OPENSSL_SOVERSION],","+    visibility = [\"//visibility:private\"],","+    deps = [\"@openssl//:crypto\"],","+)","+","+cc_shared_library(","+    name = \"libssl\",","+    dynamic_deps = [\":libcrypto\"],","+    shared_lib_name = \"libssl.so.\" + OPENSSL_SOVERSION,","+    user_link_flags = [\"-Wl,-soname,libssl.so.\" + OPENSSL_SOVERSION],","+    visibility = [\"//visibility:private\"],","+    deps = [\"@openssl//:ssl\"],","+)","+","+filegroup(","+    name = \"openssl_libs\",","+    srcs = [","+        \":libcrypto\",","+        \":libssl\",","+    ],","+    visibility = [\"//visibility:private\"],","+)","+","+# Directory containing OpenSSL's public headers as openssl/*.h, for the prefixer.","+openssl_include_dir(","+    name = \"openssl_include\",","+    lib = \"@openssl//:ssl\",","+    visibility = [\"//visibility:private\"],","+)","+"," # This genrule runs the prefixer tool to process OpenSSL headers."," # It generates:"," # - source/ossl.c: Forwarding functions that call OpenSSL via dlopen/dlsym","@@ -12,7 +53,7 @@ licenses([\"notice\"])  # Apache 2"," genrule(","     name = \"prefixed_ossl_source\",","     srcs = [","-        \"@openssl//:include\",","+        \":openssl_include\",","         \"@llvm_toolchain_llvm//:include\",","     ],","     outs = [","@@ -180,7 +221,7 @@ genrule("," ","         # Run the prefixer with absolute source path and relative output path","         $(location //compat/openssl/prefixer:prefixer) \\","-            --src-path \"$(location @openssl//:include)\" \\","+            --src-path \"$(location :openssl_include)\" \\","             --src-incl \"openssl/*.h\" \\","             --src-skip \"openssl/asn1_mac.h\" \\","             --src-skip \"openssl/opensslconf-*.h\" \\","@@ -946,13 +987,16 @@ cc_library(","     # Add the OpenSSL shared libraries as a *data* dependency, so they get","     # propagated to dependant targets, and made available in their runfiles","     # directory when they run, so libbssl-compat.a can dlopen() them.","-    data = [\"@openssl//:libs\"],","+    data = [\":openssl_libs\"],","     includes = [","         \".\",","         \"include\",","         \"source\",","     ],","     linkopts = [\"-ldl\"],","+    local_defines = [","+        'OSSL_RUNFILES_LIB_DIR=\\\\\"%s/%s\\\\\"' % (repo_name() or \"_main\", package_name()),","+    ],","     linkstatic = True,","     copts = [\"-fvisibility=hidden\"],","     visibility = [\"//visibility:public\"],"],"additions":48,"deletions":4,"truncated":false},{"path":"compat/openssl/README.md","lines":["@@ -24,7 +24,9 @@ The `bssl-compat/BUILD` file also includes `ssl` and `crypto` aliases to the"," `bssl-compat` library for convenience."," "," Note that the `cc_library` rule for `libbssl-compat.a` also has a *data*","-dependency on the `@openssl//:libs` target. This is because `libbssl-compat.a`","+dependency on the `:openssl_libs` target, which builds `libcrypto.so.3` and","+`libssl.so.3` from the `@openssl//:crypto` and `@openssl//:ssl` targets of the","+BCR `openssl` module (using `cc_shared_library`). This is because `libbssl-compat.a`"," needs to dynamically load the OpenSSL shared libraries at runtime, and making"," them a *data* dependency of `libbssl-compat.a` ensures that Bazel will put them"," in the `runfiles` directory of the sanbox, when running executables that link"],"additions":3,"deletions":1,"truncated":false},{"path":"compat/openssl/bazel/rules.bzl","lines":["@@ -1,5 +1,7 @@"," \"\"\"Bazel macros for bssl-compat library.\"\"\""," ","+load(\"@rules_cc//cc/common:cc_info.bzl\", \"CcInfo\")","+"," def patched_bssl_filegroup(name, srcs):","     \"\"\"Copy BoringSSL files from @boringssl-source into bssl-compat, applying patches."," ","@@ -121,3 +123,42 @@ def mapping_func_filegroup(name, funcs):","         name = name,","         srcs = targets,","     )","+","+def _openssl_include_dir_impl(ctx):","+    out = ctx.actions.declare_directory(ctx.label.name)","+    hdrs = {}","+    for hdr in ctx.attr.lib[CcInfo].compilation_context.headers.to_list():","+        # short_path is \"../<repo>/<path>\" for files in external repositories,","+        # both for source and generated headers.","+        path = hdr.short_path","+        if path.startswith(\"../\"):","+            path = path.split(\"/\", 2)[2]","+        if not path.startswith(\"include/openssl/\") or path.count(\"/\") != 2:","+            continue","+        if hdr.basename in hdrs and hdrs[hdr.basename] != hdr:","+            fail(\"Duplicate OpenSSL header {}: {} and {}\".format(hdr.basename, hdrs[hdr.basename].path, hdr.path))","+        hdrs[hdr.basename] = hdr","+    if not hdrs:","+        fail(\"No include/openssl/*.h headers found in {}\".format(ctx.attr.lib.label))","+","+    args = ctx.actions.args()","+    args.add(out.path + \"/openssl\")","+    args.add_all(sorted(hdrs.values(), key = lambda f: f.basename))","+    ctx.actions.run_shell(","+        inputs = hdrs.values(),","+        outputs = [out],","+        arguments = [args],","+        command = 'dst=\"$1\"; shift; mkdir -p \"$dst\" && cp \"$@\" \"$dst/\"',","+        mnemonic = \"OpenSSLIncludeDir\",","+        progress_message = \"Collecting OpenSSL headers into %{output}\",","+    )","+    return [DefaultInfo(files = depset([out]))]","+","+openssl_include_dir = rule(","+    doc = \"\"\"Collects the include/openssl/*.h headers (source and generated) of","+    an OpenSSL cc_library into a single directory, laid out as openssl/*.h.\"\"\",","+    implementation = _openssl_include_dir_impl,","+    attrs = {","+        \"lib\": attr.label(mandatory = True, providers = [CcInfo]),","+    },","+)"],"additions":41,"deletions":0,"truncated":false},{"path":"compat/openssl/bssl-compat-build.drawio","lines":["@@ -4,7 +4,7 @@","       <root>","         <mxCell id=\"0\" />","         <mxCell id=\"1\" parent=\"0\" />","-        <mxCell id=\"zjDcmAN7GTpwJI0EFBDX-1\" parent=\"1\" style=\"rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;\" value=\"@openssl//:include\" vertex=\"1\">","+        <mxCell id=\"zjDcmAN7GTpwJI0EFBDX-1\" parent=\"1\" style=\"rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;\" value=\":openssl_include\" vertex=\"1\">","           <mxGeometry height=\"60\" width=\"120\" x=\"80\" y=\"520\" as=\"geometry\" />","         </mxCell>","         <mxCell id=\"zjDcmAN7GTpwJI0EFBDX-2\" parent=\"1\" style=\"rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;gradientColor=#B87700;strokeColor=#d79b00;\" value=\"&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;@boringssl//:&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;include/...&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;@boringssl//:crypto/...&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;@boringssl//:ssl/...&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;/span&gt;&lt;/div&gt;\" vertex=\"1\">","@@ -91,7 +91,7 @@","             <mxPoint x=\"310\" y=\"500\" as=\"targetPoint\" />","           </mxGeometry>","         </mxCell>","-        <mxCell id=\"zjDcmAN7GTpwJI0EFBDX-25\" parent=\"1\" style=\"rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;\" value=\"@openssl//:libs\" vertex=\"1\">","+        <mxCell id=\"zjDcmAN7GTpwJI0EFBDX-25\" parent=\"1\" style=\"rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;\" value=\":openssl_libs\" vertex=\"1\">","           <mxGeometry height=\"60\" width=\"120\" x=\"450\" y=\"710\" as=\"geometry\" />","         </mxCell>","         <mxCell id=\"zjDcmAN7GTpwJI0EFBDX-28\" edge=\"1\" parent=\"1\" source=\"zjDcmAN7GTpwJI0EFBDX-21\" style=\"endArrow=classic;html=1;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;\" target=\"zjDcmAN7GTpwJI0EFBDX-25\" value=\"dlopen()&lt;br&gt;dlsym()\">"],"additions":2,"deletions":2,"truncated":false},{"path":"compat/openssl/patch/crypto/pkcs8/pkcs12_test.cc.sh","lines":["@@ -2,18 +2,13 @@"," "," set -euo pipefail"," ","+# TestOpenSSL, TestNSS, TestWindows, TestEmptyPassword, TestNullPassword,","+# TestUnicode and TestWindowsCompat stay commented out: their .p12 files use","+# pbeWithSHA1And40BitRC2-CBC, which OpenSSL only provides via the legacy","+# provider, and we don't load it."," uncomment.sh \"$1\" --comment \\","   --uncomment-regex '#include' \\","   --uncomment-regex 'static .* kPassword\\[\\] = ' \\","-  --uncomment-regex 'static .* kUnicodePassword\\[\\] = ' \\","   --uncomment-static-func-impl TestImpl \\","-  --uncomment-func-impl TestCompat \\","-  --uncomment-gtest-func PKCS12Test TestOpenSSL \\","-  --uncomment-gtest-func PKCS12Test TestNSS \\","-  --uncomment-gtest-func PKCS12Test TestWindows \\","   --uncomment-gtest-func PKCS12Test TestPBES2 \\","   --uncomment-gtest-func PKCS12Test TestNoEncryption \\","-  --uncomment-gtest-func PKCS12Test TestEmptyPassword \\","-  --uncomment-gtest-func PKCS12Test TestNullPassword \\","-  --uncomment-gtest-func PKCS12Test TestUnicode \\","-  --uncomment-gtest-func PKCS12Test TestWindowsCompat \\"],"additions":4,"deletions":9,"truncated":false},{"path":"compat/openssl/source/ossl_dlutil.c","lines":["@@ -73,43 +73,15 @@ void ossl_dlopen(int expected_major, int expected_minor) {","     char ossl_path[PATH_MAX];","     char temp_path[PATH_MAX];"," ","-    // Locate the OpenSSL libraries in the runfiles tree. The repository","-    // directory name and layout depend on the build/runtime:","-    //  - WORKSPACE / Bazel 7 nests external repos under the workspace, using the","-    //    apparent name (e.g. {RUNFILES_DIR}/{TEST_WORKSPACE}/external/openssl/...).","-    //  - Bazel 8 places them directly under the runfiles root","-    //    (e.g. {RUNFILES_DIR}/openssl/...).","-    //  - bzlmod materialises them under their canonical name, which is the","-    //    apparent name with a trailing '+' (e.g. .../openssl+/...).","-    // Probe each candidate and use the first that exists, defaulting to the last","-    // so dlopen() reports a sensible path if none are found.","-    const char* repo_names[] = {\"openssl\", \"openssl+\"};","-    const size_t num_repo_names = sizeof(repo_names) / sizeof(repo_names[0]);","-    for (size_t i = 0; i < num_repo_names; i++) {","-      snprintf(ossl_path, sizeof(ossl_path), \"%s/%s/external/%s/openssl/lib\",","-                                              runfiles_dir, test_workspace, repo_names[i]);","-      if (access(ossl_path, F_OK) == 0) {","-        break;","-      }","-      snprintf(ossl_path, sizeof(ossl_path), \"%s/%s/openssl/lib\",","-                                              runfiles_dir, repo_names[i]);","-      if (access(ossl_path, F_OK) == 0) {","-        break;","-      }","-    }","+    // The shared libraries are built by //compat/openssl:libcrypto and :libssl.","+    // OSSL_RUNFILES_LIB_DIR is their runfiles directory, set by the BUILD file.","+    snprintf(ossl_path, sizeof(ossl_path), \"%s/%s\", runfiles_dir, OSSL_RUNFILES_LIB_DIR);"," ","     strcpy(temp_path, libcrypto_path);","     snprintf(libcrypto_path, sizeof(libcrypto_path), \"%s/%s\", ossl_path, temp_path);"," ","     strcpy(temp_path, libssl_path);","     snprintf(libssl_path, sizeof(libssl_path), \"%s/%s\", ossl_path, temp_path);","-","-    // When running under bazel, we also need to set the OPENSSL_MODULES","-    // environment variable, so that OpenSSL can find its modules at runtime,","-    // This is needed by some tests that load the legacy provider.","-    char ossl_modules_path[PATH_MAX];","-    snprintf(ossl_modules_path, sizeof(ossl_modules_path), \"%s/ossl-modules\", ossl_path);","-    setenv(\"OPENSSL_MODULES\", ossl_modules_path, 1);","   }"," ","   // Load libcrypto.so first, because libssl.so depends on it."],"additions":3,"deletions":31,"truncated":false},{"path":"compat/openssl/test/main.cc","lines":["@@ -28,19 +28,8 @@ static OpenSSLConf openssl_conf(R\"(","   openssl_conf = openssl_init"," ","   [openssl_init]","-  providers = providers_sect","   ssl_conf = ssl_sect"," ","-  [providers_sect]","-  default = default_sect","-  legacy = legacy_sect","-","-  [default_sect]","-  activate = 1","-","-  [legacy_sect]","-  activate = 1","-","   [ssl_sect]","   system_default = system_default_sect"," "],"additions":0,"deletions":11,"truncated":false},{"path":"docs/MODULE.bazel.lock","lines":["@@ -377,7 +377,7 @@","     \"https://bcr.bazel.build/modules/opencensus-proto/0.4.1.bcr.2/source.json\": \"aadf3f53e08b72376506b7c4ea3d167010c9efb160d7d6e1e304ed646bac1b36\",","     \"https://bcr.bazel.build/modules/opencensus-proto/0.4.1/MODULE.bazel\": \"4a2e8b4d0b544002502474d611a5a183aa282251e14f6a01afe841c0c1b10372\",","     \"https://bcr.bazel.build/modules/openssl/3.3.1.bcr.1/MODULE.bazel\": \"4