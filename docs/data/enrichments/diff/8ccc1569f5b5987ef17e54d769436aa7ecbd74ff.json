{"id":"8ccc1569f5b5987ef17e54d769436aa7ecbd74ff","axis":"silent","repo":"dotnet/runtime","sha":"8ccc1569f5b5987ef17e54d769436aa7ecbd74ff","parsed":{"files":[{"path":"src/tools/ilasm/KNOWN-ISSUES.md","lines":["@@ -1,10 +1,5 @@"," # Managed IL Assembler - Known Issues"," ","-## Win32 resources","-","-Embedding Win32 resources (in either `.obj` or `.res` format) is not","-supported by managed ilasm.","-"," ## -MSV is not supported"," "," Overriding the metadata stream version with `-MSV` is not supported by"],"additions":0,"deletions":5,"truncated":false},{"path":"src/tools/ilasm/src/ILAssembler/Actions/GrammarActions.BuildImage.cs","lines":["@@ -25,6 +25,14 @@ internal sealed partial class GrammarActions","     {","         public (ImmutableArray<Diagnostic> Diagnostics, CompilationResult? Image) BuildImage()","         {","+            ResourceSectionBuilder? nativeResources = null;","+            if (_options.Win32ResourceFile is string resourceFile)","+            {","+                byte[] resourceBytes = _resourceLocator(resourceFile) ??","+                    throw new FileNotFoundException($\"Win32 resource file not found: {resourceFile}\", resourceFile);","+                nativeResources = Win32ResourceSectionBuilder.Create(resourceBytes);","+            }","+","             // Default module name to output filename if no .module directive was provided","             if (_entityRegistry.Module.Name is null && _options.OutputFileName is not null)","             {","@@ -164,6 +172,7 @@ internal sealed partial class GrammarActions","                 ilStream,","                 _mappedFieldData,","                 _manifestResources,","+                nativeResources: nativeResources,","                 debugDirectoryBuilder: debugDirectoryBuilder,","                 entryPoint: entryPoint,","                 flags: corFlags,"],"additions":9,"deletions":0,"truncated":false},{"path":"src/tools/ilasm/src/ILAssembler/Options.cs","lines":["@@ -180,6 +180,12 @@ public sealed class Options","         /// </summary>","         public string? KeyFile { get; set; }"," ","+        /// <summary>","+        /// Gets or sets the name of the Win32 <c>.res</c> or COFF <c>.obj</c> resource file to embed.","+        /// </summary>","+        /// <remarks>The compiler loads this file through its resource locator, independently of managed manifest resources.</remarks>","+        public string? Win32ResourceFile { get; set; }","+","         /// <summary>","         /// Gets or sets a value that indicates whether instruction encodings are optimized.","         /// </summary>"],"additions":6,"deletions":0,"truncated":false},{"path":"src/tools/ilasm/src/ILAssembler/Win32ResourceSectionBuilder.cs","lines":["@@ -0,0 +1,376 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+// Copyright (c) .NET Foundation and Contributors.","+// Adapted from Roslyn's CvtRes.cs and PEWriter/NativeResourceWriter.cs:","+","+using System;","+using System.Buffers.Binary;","+using System.Collections.Generic;","+using System.IO;","+using System.Linq;","+using System.Reflection.Metadata;","+using System.Reflection.PortableExecutable;","+using System.Text;","+","+namespace ILAssembler;","+","+// Format specifications: https://learn.microsoft.com/windows/win32/menurc/resource-file-formats","+// and https://learn.microsoft.com/windows/win32/debug/pe-format#the-rsrc-section","+internal sealed class Win32ResourceSectionBuilder(byte[] sectionBytes, int[] relocations) : ResourceSectionBuilder","+{","+    private const int DirectoryHeaderSize = 16;","+    private const int DirectoryEntrySize = 8;","+    private const int DataEntrySize = 16;","+    private const uint SubdirectoryOrNameFlag = 0x80000000;","+    private const ushort DialogIncludeResourceType = 17;","+","+    internal static Win32ResourceSectionBuilder Create(byte[] bytes)","+    {","+        try","+        {","+            if (bytes.Length < sizeof(uint))","+            {","+                throw new InvalidDataException(\"The Win32 resource file is empty or truncated.\");","+            }","+","+            return BinaryPrimitives.ReadUInt32LittleEndian(bytes) == 0 ? ReadRes(bytes) : ReadCoff(bytes);","+        }","+        catch (Exception ex) when (ex is EndOfStreamException or BadImageFormatException or OverflowException)","+        {","+            throw new InvalidDataException(\"The Win32 resource file is malformed.\", ex);","+        }","+    }","+","+    protected override void Serialize(BlobBuilder builder, SectionLocation location)","+    {","+        var writer = new BlobWriter(builder.ReserveBytes(sectionBytes.Length));","+        writer.WriteBytes(sectionBytes);","+        foreach (int offset in relocations)","+        {","+            writer.Offset = offset;","+            writer.WriteUInt32(checked(BinaryPrimitives.ReadUInt32LittleEndian(sectionBytes.AsSpan(offset)) +","+                (uint)location.RelativeVirtualAddress));","+        }","+    }","+","+    private readonly record struct Identifier(ushort Id, string? Name = null) : IComparable<Identifier>","+    {","+        public int CompareTo(Identifier other) => Name is null","+            ? other.Name is null ? Id.CompareTo(other.Id) : 1","+            : other.Name is null ? -1 : StringComparer.OrdinalIgnoreCase.Compare(Name, other.Name);","+    }","+","+    private sealed class Node","+    {","+        internal readonly SortedDictionary<Identifier, Node> Children = new();","+        internal byte[]? Data;","+    }","+","+    private static Win32ResourceSectionBuilder ReadRes(byte[] bytes)","+    {","+        using var stream = new MemoryStream(bytes, writable: false);","+        using var reader = new BinaryReader(stream, Encoding.Unicode);","+        var root = new Node();","+        bool firstResource = true;","+        while (stream.Position < stream.Length)","+        {","+            int start = checked((int)stream.Position);","+            int dataSize = checked((int)reader.ReadUInt32());","+            int headerSize = checked((int)reader.ReadUInt32());","+            // Two empty UTF-16 identifiers are the shortest possible type and name.","+            const int MinimumHeaderSize = 2 * sizeof(uint) + 2 * sizeof(ushort) + 16;","+            if (headerSize < MinimumHeaderSize || (headerSize & 3) != 0)","+            {","+                throw new InvalidDataException($\"Invalid Win32 resource header at offset {start}.\");","+            }","+            CheckRange(start, headerSize, bytes.Length);","+            int headerEnd = checked(start + headerSize);","+            CheckRange(headerEnd, dataSize, bytes.Length);","+            Identifier type = ReadIdentifier(reader, headerEnd - 16);","+            Identifier name = ReadIdentifier(reader, headerEnd - 16);","+            stream.Position = Align(checked((int)stream.Position));","+            if (stream.Position > headerEnd - 16)","+            {","+                throw new InvalidDataException($\"Invalid Win32 resource identifiers at offset {start}.\");","+            }","+            reader.ReadUInt32(); // DataVersion","+            reader.ReadUInt16(); // MemoryFlags","+            ushort language = reader.ReadUInt16();","+            reader.ReadUInt32(); // Version","+            reader.ReadUInt32(); // Characteristics","+            stream.Position = headerEnd;","+            byte[] data = reader.ReadBytes(dataSize);","+            stream.Position = Align(checked(headerEnd + dataSize));","+","+            if (firstResource)","+            {","+                if (dataSize != 0 || type != new Identifier(0) || name != new Identifier(0))","+                {","+                    throw new InvalidDataException(\"The .res file does not begin with a null resource.\");","+                }","+                firstResource = false;","+                continue;","+            }","+            if (type == new Identifier(DialogIncludeResourceType))","+            {","+                continue;","+            }","+","+            Node languageDirectory = GetOrAdd(GetOrAdd(root, type), name);","+            if (!languageDirectory.Children.TryAdd(new Identifier(language), new Node { Data = data }))","+            {","+                throw new InvalidDataException(\"The .res file contains duplicate resource type, name, and language identifiers.\");","+            }","+        }","+","+        var builder = new BlobBuilder();","+        var relocations = new List<int>();","+        WriteDirectory(root, builder, relocations);","+        return new Win32ResourceSectionBuilder(builder.ToArray(), relocations.ToArray());","+    }","+","+    private static Node GetOrAdd(Node parent, Identifier key)","+    {","+        if (!parent.Children.TryGetValue(key, out Node? node))","+        {","+            node = new Node();","+            parent.Children.Add(key, node);","+        }","+","+        return node;","+    }","+","+    private static Identifier ReadIdentifier(BinaryReader reader, int end)","+    {","+        ushort first = ReadWord();","+        if (first == ushort.MaxValue)","+        {","+            return new Identifier(ReadWord());","+        }","+","+        var name = new StringBuilder();","+        for (ushort value = first; value != 0; value = ReadWord())","+        {","+            name.Append((char)value);","+        }","+","+        return new Identifier(0, name.ToString());","+","+        ushort ReadWord()","+        {","+            if (reader.BaseStream.Position > end - sizeof(ushort))","+            {","+                throw new InvalidDataException(\"A Win32 resource identifier extends beyond its header.\");","+            }","+","+            return reader.ReadUInt16();","+        }","+    }","+","+    private static void WriteDirectory(Node directory, BlobBuilder builder, List<int> relocations)","+    {","+        var writer = new BlobWriter(builder.ReserveBytes(checked(DirectoryHeaderSize + DirectoryEntrySize * directory.Children.Count)));","+        writer.WriteUInt32(0); // Characteristics","+        writer.WriteUInt32(0); // TimeDateStamp","+        writer.WriteUInt32(0); // MajorVersion, MinorVersion","+        int namedCount = directory.Children.Keys.Count(key => key.Name is not null);","+        writer.WriteUInt16(checked((ushort)namedCount));","+        writer.WriteUInt16(checked((ushort)(directory.Children.Count - namedCount)));","+        foreach ((Identifier identifier, Node child) in directory.Children)","+        {","+            if (identifier.Name is string name)","+            {","+                writer.WriteUInt32((uint)builder.Count | SubdirectoryOrNameFlag);","+                builder.WriteUInt16(checked((ushort)name.Length));","+                builder.WriteUTF16(name);","+                builder.Align(sizeof(uint));","+            }","+            else","+            {","+                writer.WriteUInt32(identifier.Id);","+            }","+","+            int offset = builder.Count;","+            if (child.Data is byte[] data)","+            {","+                writer.WriteUInt32((uint)offset);","+                relocations.Add(offset);","+                builder.WriteUInt32(checked((uint)(offset + DataEntrySize)));","+                builder.WriteUInt32((uint)data.Length);","+                builder.WriteUInt32(0); // CodePage","+                builder.WriteUInt32(0); // Reserved","+                builder.WriteBytes(data);","+                builder.Align(sizeof(uint));","+            }","+            else","+            {","+                writer.WriteUInt32((uint)offset | SubdirectoryOrNameFlag);","+                WriteDirectory(child, builder, relocations);","+            }","+        }","+    }","+","+    private static Win32ResourceSectionBuilder ReadCoff(byte[] bytes)","+    {","+        using var stream = new MemoryStream(bytes, writable: false);","+        var headers = new PEHeaders(stream);","+        SectionHeader directory = default;","+        SectionHeader data = default;","+        int directorySection = 0;","+        int dataSection = 0;","+        for (int i = 0; i < headers.SectionHeaders.Length; i++)","+        {","+            SectionHeader section = headers.SectionHeaders[i];","+            if (section.Name == \".rsrc$01\" && directorySection == 0)","+            {","+                directory = section;","+                directorySection = i + 1;","+            }","+            else if (section.Name == \".rsrc$02\" && dataSection == 0)","+            {","+                data = section;","+                dataSection = i + 1;","+            }","+            else if (section.Name is \".rsrc$01\" or \".rsrc$02\")","+            {","+                throw new InvalidDataException(\"The COFF resource file has duplicate resource sections.\");","+            }","+        }","+        if (headers.PEHeader is not null || directorySection == 0 || dataSection == 0 || directory.SizeOfRawData < DirectoryHeaderSize)","+        {","+            throw new InvalidDataException(\"The COFF resource file must contain .rsrc$01 and .rsrc$02 sections.\");","+        }","+","+        CheckRange(directory.PointerToRawData, directory.SizeOfRawData, bytes.Length);","+        CheckRange(data.PointerToRawData, data.SizeOfRawData, bytes.Length);","+        const int RelocationSize = 10;","+        const int SymbolSize = 18;","+        CheckRange(directory.PointerToRelocations, checked(directory.NumberOfRelocations * RelocationSize), bytes.Length);","+        CheckRange(headers.CoffHeader.PointerToSymbolTable, checked(headers.CoffHeader.NumberOfSymbols * SymbolSize), bytes.Length);","+        if (data.NumberOfRelocations != 0)","+        {","+            throw new InvalidDataException(\"The COFF resource data section must not contain relocations.\");","+        }","+        ushort expectedRelocation = headers.CoffHeader.Machine switch","+        {","+            Machine.I386 => 0x0007, // IMAGE_REL_I386_DIR32NB","+            Machine.Amd64 => 0x0003, // IMAGE_REL_AMD64_ADDR32NB","+            Machine.Arm64 => 0x0002, // IMAGE_REL_ARM64_ADDR32NB","+            _ => throw new InvalidDataException($\"Unsupported COFF resource machine '{headers.CoffHeader.Machine}'.\")","+        };","+","+        byte[] sectionBytes = new byte[checked(directory.SizeOfRawData + data.SizeOfRawData)];","+        bytes.AsSpan(directory.PointerToRawData, directory.SizeOfRawData).CopyTo(sectionBytes);","+        bytes.AsSpan(data.PointerToRawData, data.SizeOfRawData).CopyTo(sectionBytes.AsSpan(directory.SizeOfRawData));","+        int[] relocations = new int[directory.NumberOfRelocations];","+        var seenOffsets = new HashSet<int>();","+        for (int i = 0; i < relocations.Length; i++)","+        {","+            int relocation = directory.PointerToRelocations + i * RelocationSize;","+            int offset = checked((int)ReadUInt32(bytes, relocation));","+            uint symbolIndex = ReadUInt32(bytes, relocation + 4);","+            ushort relocationType = BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(relocation + 8));","+            CheckRange(offset, sizeof(uint), directory.SizeOfRawData);","+            if (symbolIndex >= headers.CoffHeader.NumberOfSymbols || relocationType != expectedRelocation || !seenOffsets.Add(offset))","+            {","+                throw new InvalidDataException(\"Invalid COFF resource relocation.\");","+            }","+","+            int symbol = checked(headers.CoffHeader.PointerToSymbolTable + (int)symbolIndex * SymbolSize);","+            uint value = ReadUInt32(bytes, symbol + 8);","+            short sectionNumber = BinaryPrimitives.ReadInt16LittleEndian(bytes.AsSpan(symbol + 12));","+            ushort symbolType = BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(symbol + 14));","+            if (sectionNumber != dataSection || symbolType != 0)","+            {","+                throw new InvalidDataException(\"A COFF resource relocation must refer to a symbol in .rsrc$02.\");","+            }","+","+            uint dataOffset = checked(value + ReadUInt32(sectionBytes, offset));","+            if (dataOffset > data.SizeOfRawData)","+            {","+                throw new InvalidDataException(\"A COFF resource relocation points outside .rsrc$02.\");","+            }","+            BinaryPrimitives.WriteUInt32LittleEndian(sectionBytes.AsSpan(offset), checked(dataOffset + (uint)directory.SizeOfRawData));","+            relocations[i] = offset;","+        }","+","+        ValidateCoffDirectory(sectionBytes, directory.SizeOfRawData, seenOffsets);","+        return new Win32ResourceSectionBuilder(sectionBytes, relocations);","+    }","+","+    private static void ValidateCoffDirectory(byte[] bytes, int directorySize, HashSet<int> relocations)","+    {","+        var directories = new HashSet<int>();","+        var dataEntries = new HashSet<int>();","+        ValidateDirectory(0, 0);","+        if (!dataEntries.SetEquals(relocations))","+        {","+            throw new InvalidDataException(\"COFF resource relocations must identify every resource data address and no other fields.\");","+        }","+","+        void ValidateDirectory(int offset, int level)","+        {","+            CheckRange(offset, DirectoryHeaderSize, directorySize);","+            if (!directories.Add(offset))","+            {","+                throw new InvalidDataException(\"The COFF resource directory contains a cycle or a shared subdirectory.\");","+            }","+","+            int namedCount = BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(offset + 12));","+            int idCount = BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(offset + 14));","+            int count = namedCount + idCount;","+            int entriesStart = checked(offset + DirectoryHeaderSize);","+            CheckRange(entriesStart, checked(count * DirectoryEntrySize), directorySize);","+            for (int i = 0; i < count; i++)","+            {","+                int entry = entriesStart + i * DirectoryEntrySize;","+                uint name = ReadUInt32(bytes, entry);","+                bool isNamed = (name & SubdirectoryOrNameFlag) != 0;","+                if (isNamed != (i < namedCount) || (level == 2 && isNamed))","+                {","+                    throw new InvalidDataException(\"Invalid COFF resource directory identifier.\");","+                }","+                if (isNamed)","+                {","+                    int nameOffset = (int)(name & ~SubdirectoryOrNameFlag);","+                    CheckRange(nameOffset, sizeof(ushort), directorySize);","+                    int length = BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(nameOffset));","+                    CheckRange(nameOffset + sizeof(ushort), length * sizeof(char), directorySize);","+                }","+","+                uint child = ReadUInt32(bytes, entry + sizeof(uint));","+                bool isDirectory = (child & SubdirectoryOrNameFlag) != 0;","+                if (isDirectory != (level < 2))","+                {","+                    throw new InvalidDataException(\"The COFF resource directory must have type, name, and language levels.\");","+                }","+                int childOffset = (int)(child & ~SubdirectoryOrNameFlag);","+                if (isDirectory)","+                {","+                    ValidateDirectory(childOffset, level + 1);","+                }","+                else","+                {","+                    CheckRange(childOffset, DataEntrySize, directorySize);","+                    int dataOffset = checked((int)ReadUInt32(bytes, childOffset));","+                    int dataSize = checked((int)ReadUInt32(bytes, childOffset + sizeof(uint)));","+                    CheckRange(dataOffset - directorySize, dataSize, bytes.Length - directorySize);","+                    dataEntries.Add(childOffset);","+                }","+            }","+        }","+    }","+","+    private static uint ReadUInt32(byte[] bytes, int offset) =>","+        BinaryPrimitives.ReadUInt32LittleEndian(bytes.AsSpan(offset));","+","+    private static int Align(int value) => checked(value + 3) & ~3;","+","+    private static void CheckRange(int offset, int size, int length)","+    {","+        if (offset < 0 || size < 0 || offset > length - size)","+        {","+            throw new InvalidDataException(\"The Win32 resource file contains an invalid offset or size.\");","+        }","+    }","+}"],"additions":376,"deletions":0,"truncated":false},{"path":"src/tools/ilasm/src/ilasm/IlasmRootCommand.cs","lines":["@@ -67,6 +67,9 @@ internal sealed class IlasmRootCommand : RootCommand","     public Option<string> IncludePath { get; } =","         new(\"--include\", \"-I\") { Description = \"Set path to search for #include'd files\" };"," ","+    public Option<string> ResourceFile { get; } =","+        new(\"--resource\") { Description = \"Embed Win32 resources from a .res or COFF .obj file\" };","+","     public Option<string[]> PathMap { get; } =","         new(\"--pathmap\") { Description = \"Map a path prefix to the path written in the PDB and the image: <path>=<sourcePath>[,<path>=<sourcePath>...], as the C# compiler's -pathmap\" };"," ","@@ -140,6 +143,7 @@ public IlasmRootCommand() : base(ProductName)","         Options.Add(KeyFile);","         Options.Add(AssemblyName);","         Options.Add(IncludePath);","+        Options.Add(ResourceFile);","         Options.Add(PathMap);","         Options.Add(Subsystem);","         Options.Add(SubsystemVersion);"],"additions":4,"deletions":0,"truncated":false},{"path":"src/tools/ilasm/src/ilasm/NativeCommandLine.cs","lines":["@@ -36,6 +36,7 @@ internal static class NativeCommandLine","         [\"PDB\"] = \"--pdb\",","         [\"PE6\"] = \"--pe64\",","         [\"QUI\"] = \"--quiet\",","+        [\"RES\"] = \"--resource\",","         [\"STA\"] = \"--stack\",","         [\"STR\"] = \"--stripreloc\",","         [\"SSV\"] = \"--ssver\",","@@ -132,11 +133,6 @@ private static string[] Normalize(string[] args, IlasmRootCommand command, bool","             else","             {","                 string prefix = optionName[..3];","-                if (prefix.Equals(\"RES\", StringComparison.OrdinalIgnoreCase))","-                {","-                    throw new ArgumentException(","-                        $\"Unsupported native option '{arg}'. The managed ilasm implementation does not support -RESOURCES.\");","-                }","                 if (prefix.Equals(\"MSV\", StringComparison.OrdinalIgnoreCase))","                 {","                     throw new ArgumentException("],"additions":1,"deletions":5,"truncated":false},{"path":"src/tools/ilasm/src/ilasm/Program.cs","lines":["@@ -182,6 +182,7 @@ public int Run()","             // Assembly options","             options.AssemblyName = Get(_command.AssemblyName);","             options.KeyFile = Get(_command.KeyFile);","+            options.Win32ResourceFile = Get(_command.ResourceFile);","             options.Optimize = Get(_command.Optimize);","             options.PseudoAttributes = Get(_command.PseudoAttributes);","             options.Fold = Get(_command.Fold);"],"additions":1,"deletions":0,"truncated":false},{"path":"src/tools/ilasm/tests/ILAssembler.Tests/CommandLineTests.cs","lines":["@@ -205,6 +205,7 @@ public void Pseudoattributes_LegacyOptionIsRejected(string argument, bool allowS","         { \"KEY\", \"--key\" },","         { \"MDV\", \"--mdv\" },","         { \"OUT\", \"--output\" },","+        { \"RES\", \"--resource\" },","         { \"SSV\", \"--ssver\" },","         { \"STA\", \"--stack\" },","         { \"SUB\", \"--subsystem\" },","@@ -219,6 +220,7 @@ public void Pseudoattributes_LegacyOptionIsRejected(string argument, bool allowS","         \"KEY\",","         \"MDV\",","         \"OUT\",","+        \"RES\",","         \"SSV\",","         \"STA\",","         \"SUB\",","@@ -447,9 +449,6 @@ public void UnsupportedOrInvalidArmOption_Throws(string argument)","     }"," ","     [Theory]","-    [InlineData(\"-res:file.res\", false)]","-    [InlineData(\"-RESOURCE=file.res\", false)]","-    [InlineData(\"/ReSAnything:file.res\", true)]","     [InlineData(\"-msv=2.0\", false)]","     [InlineData(\"-MSVersion:2.0\", false)]","     [InlineData(\"/MSV=2.0\", true)]"],"additions":2,"deletions":3,"truncated":false},{"path":"src/tools/ilasm/tests/ILAssembler.Tests/Win32ResourceTests.cs","lines":["@@ -0,0 +1,364 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.Buffers.Binary;","+using System.CommandLine;","+using System.Reflection.Metadata;","+using System.Reflection.PortableExecutable;","+using System.Text;","+using Xunit;","+","+namespace ILAssembler.Tests;","+","+public sealed class Win32ResourceTests : IDisposable","+{","+    private readonly string _directory = Directory.CreateTempSubdirectory(\"ilasm-win32-\").FullName;","+","+    public void Dispose() => Directory.Delete(_directory, recursive: true);","+","+    [Theory]","+    [InlineData(\"--resource\", \"\")]","+    [InlineData(\"-RESOURCE=\", \"-x64\")]","+    [InlineData(\"-res:\", \"-arm64\")]","+    public void ResFile_EmitsSortedDirectoriesAndPreservesManagedResources(string resourceOption, string machine)","+    {","+        byte[] resources = CreateResFile();","+        using PEReader pe = Assemble(resources, resourceOption, machine);","+        Assert.Equal(machine switch { \"-x64\" => Machine.Amd64, \"-arm64\" => Machine.Arm64, _ => Machine.I386 }, pe.PEHeaders.CoffHeader.Machine);","+        Dictionary<string, (uint CodePage, byte[] Data)> actual = ReadResources(pe);","+        Assert.Equal(4, actual.Count);","+        Assert.Equal(new byte[] { 1, 2, 3 }, actual[\"#10/#2/1033\"].Data);","+        Assert.Equal(new byte[] { 4 }, actual[\"#10/#2/1041\"].Data);","+        Assert.Empty(actual[\"TYPE/na\\u00efve/0\"].Data);","+        Assert.Equal(new byte[] { 5, 6 }, actual[\"//0\"].Data);","+        Assert.All(actual.Values, value => Assert.Equal(0u, value.CodePage));","+        MetadataReader metadata = pe.GetMetadataReader();","+        ManifestResource managedResource = metadata.GetManifestResource(Assert.Single(metadata.ManifestResources));","+        Assert.Equal(\"Managed\", metadata.GetString(managedResource.Name));","+        Assert.Equal(new byte[] { 3, 0, 0, 0, 7, 8, 9 },","+            pe.GetSectionData(pe.PEHeaders.CorHeader!.ResourcesDirectory.RelativeVirtualAddress).GetContent(0, 7));","+    }","+","+    [Theory]","+    [InlineData(Machine.I386, \"\")]","+    [InlineData(Machine.Amd64, \"-x64\")]","+    [InlineData(Machine.Arm64, \"-arm64\")]","+    public void CoffFile_RelocatesResourceDataUsingSymbolSectionAndAddend(Machine machine, string target)","+    {","+        using PEReader pe = Assemble(CreateCoffFile(machine), \"--resource\", target);","+        var resource = Assert.Single(ReadResources(pe));","+        Assert.Equal(\"#10/#2/1033\", resource.Key);","+        Assert.Equal(1252u, resource.Value.CodePage);","+        Assert.Equal(new byte[] { 1, 2, 3 }, resource.Value.Data);","+    }","+","+    [Theory]","+    [InlineData(0)]","+    [InlineData(4)]","+    public void CoffFile_PayloadCanEndAtSectionBoundary(int size)","+    {","+        byte[] bytes = CreateCoffFile(Machine.I386);","+        WriteUInt32(bytes, 172, size == 0 ? 8u : 4u);","+        WriteUInt32(bytes, 176, (uint)size);","+","+        using PEReader pe = Assemble(bytes);","+        var resource = Assert.Single(ReadResources(pe));","+        Assert.Equal(size == 0 ? Array.Empty<byte>() : new byte[] { 1, 2, 3, 0 }, resource.Value.Data);","+    }","+","+    [Theory]","+    [InlineData(false)]","+    [InlineData(true)]","+    public void ResourceFile_DeterministicAcrossCompilations(bool coff)","+    {","+        byte[] input = coff ? CreateCoffFile(Machine.I386) : CreateResFile();","+        using (PEReader first = Assemble(input))","+        {","+            Assert.NotEmpty(ReadResources(first));","+        }","+        byte[] expected = File.ReadAllBytes(Path.Combine(_directory, \"output.dll\"));","+        using PEReader second = Assemble(input);","+        Assert.Equal(expected, second.GetEntireImage().GetContent());","+    }","+","+    [Fact]","+    public void NullResFile_EmitsAnEmptyDirectory()","+    {","+        using PEReader pe = Assemble(CreateResFile(nullResourceOnly: true));","+        Assert.Empty(ReadResources(pe));","+    }","+","+    [Theory]","+    [InlineData(\"missing\")]","+    [InlineData(\"empty\")]","+    [InlineData(\"truncated-res\")]","+    [InlineData(\"res-header-size\")]","+    [InlineData(\"res-data-size\")]","+    [InlineData(\"res-duplicate\")]","+    [InlineData(\"coff-sections\")]","+    [InlineData(\"coff-section-size\")]","+    [InlineData(\"coff-relocation-table\")]","+    [InlineData(\"coff-relocation-offset\")]","+    [InlineData(\"coff-relocation-type\")]","+    [InlineData(\"coff-symbol-index\")]","+    [InlineData(\"coff-symbol-section\")]","+    [InlineData(\"coff-symbol-value\")]","+    [InlineData(\"coff-directory-offset\")]","+    [InlineData(\"coff-directory-header\")]","+    [InlineData(\"coff-directory-entries\")]","+    [InlineData(\"coff-directory-cycle\")]","+    [InlineData(\"coff-directory-depth\")]","+    [InlineData(\"coff-name-offset\")]","+    [InlineData(\"coff-name-length\")]","+    [InlineData(\"coff-data-entry\")]","+    [InlineData(\"coff-payload-size\")]","+    [InlineData(\"coff-payload-end\")]","+    [InlineData(\"coff-missing-relocation\")]","+    public void InvalidResource_DoesNotReplaceOutputOrPdb(string failure)","+    {","+        byte[] bytes = failure.StartsWith(\"coff-\", StringComparison.Ordinal) ? CreateCoffFile(Machine.I386) : CreateResFile();","+        switch (failure)","+        {","+            case \"empty\": bytes = []; break;","+            case \"truncated-res\": bytes = bytes[..^4]; break;","+            case \"res-header-size\": WriteUInt32(bytes, 36, uint.MaxValue); break;","+            case \"res-data-size\": WriteUInt32(bytes, 32, uint.MaxValue); break;","+            case \"res-duplicate\": bytes = [.. bytes, .. bytes.AsSpan(32).ToArray()]; break;","+            case \"coff-sections\": bytes[20 + 40 + 6] = (byte)'3'; break;","+            case \"coff-section-size\": WriteUInt32(bytes, 20 + 40 + 16, uint.MaxValue); break;","+            case \"coff-relocation-table\": WriteUInt32(bytes, 20 + 24, uint.MaxValue); break;","+            case \"coff-relocation-offset\": WriteUInt32(bytes, 200, 87); break;","+            case \"coff-relocation-type\": bytes[208] = 0xff; break;","+            case \"coff-symbol-index\": WriteUInt32(bytes, 204, 1); break;","+            case \"coff-symbol-section\": bytes[210 + 12] = 1; break;","+            case \"coff-symbol-value\": WriteUInt32(bytes, 210 + 8, uint.MaxValue); break;","+            case \"coff-directory-offset\": WriteUInt32(bytes, 120, 0xfffffff0); break;","+            case \"coff-directory-header\": WriteUInt32(bytes, 120, 0x80000050); break;","+            case \"coff-directory-entries\": bytes[114] = 10; break;","+            case \"coff-directory-cycle\": WriteUInt32(bytes, 120, 0x80000000); break;","+            case \"coff-directory-depth\": WriteUInt32(bytes, 168, 0x80000048); break;","+            case \"coff-name-offset\":","+                bytes[112] = 1;","+                bytes[114] = 0;","+                WriteUInt32(bytes, 116, 0xfffffff0);","+                break;"],"additions":144,"deletions":0,"truncated":false}],"additions":543,"deletions":13,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-29T15:20:52.360187+00:00"}