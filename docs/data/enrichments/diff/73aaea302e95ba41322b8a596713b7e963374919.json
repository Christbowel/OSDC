+8,9 @@ mod referrers;"," #[path = \"oci_registry/authorization.rs\"]"," mod authorization;"," ","+#[path = \"oci_registry/upload_authorization.rs\"]","+mod upload_authorization;","+"," #[path = \"oci_registry/discovery.rs\"]"," mod discovery;"," "],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/oci_registry/upload_authorization.rs","lines":["@@ -0,0 +1,509 @@","+use super::{","+    AccessList, AuthState, Body, Request, Router, ServiceExt, StatusCode, TempDir, Value,","+    body_bytes, digest_of, get, header, oci_config, pausing_store, push_blob, push_image,","+    router_with_auth,","+};","+","+fn hosted_backends() -> [pnpr::HostedStoreConfig; 2] {","+    [","+        pnpr::HostedStoreConfig::Fs,","+        pnpr::HostedStoreConfig::ObjectStore {","+            store: std::sync::Arc::new(object_store::memory::InMemory::new()),","+            prefix: \"uploads-auth/\".into(),","+        },","+    ]","+}","+","+async fn two_user_app(","+    tmp: &TempDir,","+    hosted_backend: pnpr::HostedStoreConfig,","+    default_publish: Option<AccessList>,","+) -> (Router, String, String) {","+    use base64::{Engine as _, engine::general_purpose::STANDARD};","+","+    let mut config = oci_config(tmp.path().to_path_buf(), \"$all\");","+    config.storage.hosted_backend = hosted_backend;","+    if let Some(publish) = default_publish {","+        let hosted = config.routing.hosted.get_mut(\"images\").unwrap();","+        hosted.rules = std::mem::take(&mut hosted.rules).with_default_publish(publish);","+    }","+    let auth = AuthState::in_memory();","+    let alice = crate::tokens::issue_token(&auth, \"alice\").await;","+    let bob = crate::tokens::issue_token(&auth, \"bob\").await;","+    let app = router_with_auth(config, auth);","+    let alice_auth = format!(\"Basic {}\", STANDARD.encode(format!(\"alice:{alice}\")));","+    let bob_auth = format!(\"Basic {}\", STANDARD.encode(format!(\"bob:{bob}\")));","+    (app, alice_auth, bob_auth)","+}","+","+async fn send(","+    app: &Router,","+    method: &str,","+    uri: &str,","+    auth: Option<&str>,","+    body: &'static [u8],","+) -> axum::response::Response {","+    let mut builder = Request::builder().method(method).uri(uri);","+    if let Some(caller) = auth {","+        builder = builder.header(header::AUTHORIZATION, caller);","+    }","+    app.clone()","+        .oneshot(builder.body(Body::from(body)).unwrap())","+        .await","+        .unwrap()","+}","+","+async fn open_upload(","+    app: &Router,","+    repository: &str,","+    auth: Option<&str>,","+    chunk: &'static [u8],","+) -> String {","+    let response =","+        send(app, \"POST\", &format!(\"/v2/{repository}/blobs/uploads/\"), auth, chunk).await;","+    assert_eq!(response.status(), StatusCode::ACCEPTED);","+    response.headers()[header::LOCATION]","+        .to_str()","+        .unwrap()","+        .to_string()","+}","+","+async fn assert_all_continuation_verbs_refused(","+    app: &Router,","+    location: &str,","+    auth: Option<&str>,","+    payload: &'static [u8],","+    expected_status: StatusCode,","+    expected_code: &str,","+) {","+    let digest = digest_of(payload);","+    let put_uri = format!(\"{location}?digest={digest}\");","+    for (method, uri, body) in [","+        (\"GET\", location, b\"\".as_slice()),","+        (\"PATCH\", location, payload),","+        (\"PUT\", put_uri.as_str(), payload),","+        (\"DELETE\", location, b\"\".as_slice()),","+    ] {","+        let response = send(app, method, uri, auth, body).await;","+        assert_eq!(response.status(), expected_status, \"{method} {uri}\");","+        let parsed: Value =","+            serde_json::from_slice(&body_bytes(response.into_body()).await).unwrap();","+        assert_eq!(parsed[\"errors\"][0][\"code\"], expected_code, \"{method} {uri}\");","+    }","+}","+","+#[tokio::test]","+async fn non_owner_cannot_hijack_corrupt_complete_or_abort_owners_upload_session() {","+    for backend in hoste