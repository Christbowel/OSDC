lity?: string;","+}","+","+export interface INodeCompileCachePaths {","+\treadonly application: string;","+\treadonly cacheDirectory: string;","+}","+","+export function shouldGenerateNodeCompileCache(platform: string, arch: string, product: INodeCompileCacheProduct): boolean {","+\tif (!product.quality) {","+\t\treturn false;","+\t}","+","+\treturn platform === 'darwin' ? arch === 'arm64' : (platform === 'linux' || platform === 'win32') && arch === 'x64';","+}","+","+export function getNodeCompileCachePaths(platform: string, outputDirectory: string, versionedResourcesFolder: string, product: INodeCompileCacheProduct): INodeCompileCachePaths {","+\tif (platform === 'darwin') {","+\t\tconst applicationRoot = path.join(outputDirectory, `${product.nameLong}.app`);","+\t\treturn {","+\t\t\tapplication: path.join(applicationRoot, 'Contents', 'MacOS', product.nameShort),","+\t\t\tcacheDirectory: path.join(applicationRoot, 'Contents', 'Resources', 'app', 'node-compile-cache')","+\t\t};","+\t}","+","+\tconst application = platform === 'win32'","+\t\t? path.join(outputDirectory, `${product.nameShort}.exe`)","+\t\t: path.join(outputDirectory, product.applicationName);","+","+\treturn {","+\t\tapplication,","+\t\tcacheDirectory: path.join(outputDirectory, versionedResourcesFolder, 'resources', 'app', 'node-compile-cache')","+\t};","+}","+","+export function createNodeCompileCacheGenerationEnvironment(portableDirectory: string, parentEnvironment: NodeJS.ProcessEnv = process.env): NodeJS.ProcessEnv {","+\tconst env = { ...parentEnvironment };","+\tdelete env.ELECTRON_RUN_AS_NODE;","+\tdelete env.NODE_COMPILE_CACHE;","+\tdelete env.NODE_COMPILE_CACHE_PORTABLE;","+\tdelete env.NODE_COMPILE_CACHE_READONLY;","+\tdelete env.NODE_DISABLE_COMPILE_CACHE;","+\tdelete env.VSCODE_DEV;","+\tdelete env.VSCODE_MEASURE_NODE_COMPILE_CACHE;","+\tdelete env.VSCODE_NODE_COMPILE_CACHE_KIND;","+\tdelete env.VSCODE_NODE_COMPILE_CACHE_MEASUREMENTS;","+\tdelete env.VSCODE_NODE_COMPILE_CACHE_ROOT;","+\tenv.VSCODE_GENERATE_NODE_COMPILE_CACHE = '1';","+\tenv.VSCODE_PORTABLE = portableDirectory;","+\treturn env;","+}","+","+export async function generateNodeCompileCache(platform: string, outputDirectory: string, versionedResourcesFolder: string, product: INodeCompileCacheProduct): Promise<void> {","+\tconst paths = getNodeCompileCachePaths(platform, outputDirectory, versionedResourcesFolder, product);","+\tconst temporaryDirectory = platform === 'win32' ? os.tmpdir() : '/tmp';","+\tconst portableDirectory = await fs.promises.mkdtemp(path.join(temporaryDirectory, 'vscode-cache-'));","+","+\tawait fs.promises.rm(paths.cacheDirectory, { recursive: true, force: true });","+","+\ttry {","+\t\tconst env = createNodeCompileCacheGenerationEnvironment(portableDirectory);","+\t\tawait runCacheGeneration(paths.application, paths.cacheDirectory, env);","+\t\tconst totalCacheEntryCount = await validateNodeCompileCache(paths.cacheDirectory, process.arch);","+\t\tconsole.log(`Generated ${totalCacheEntryCount} total Node.js compile cache entries in ${paths.cacheDirectory}.`);","+\t} finally {","+\t\tawait fs.promises.rm(portableDirectory, { recursive: true, force: true });","+\t}","+}","+","+export async function validateNodeCompileCache(rootDirectory: string, architecture: string): Promise<number> {","+\tlet totalCacheEntryCount = 0;","+\tfor (const kind of nodeCompileCacheKinds) {","+\t\tconst kindDirectory = path.join(rootDirectory, kind);","+\t\tconst entries = await fs.promises.readdir(kindDirectory, { withFileTypes: true });","+\t\tconst tagDirectories = entries.filter(entry => entry.isDirectory() && nodeCompileCacheTagPattern.exec(entry.name)?.[1] === architecture);","+\t\tif (tagDirectories.length !== 1) {","+\t\t\tthrow new Error(`Node.js compile cache generation produced ${tagDirectories.length} ${architecture} version-tag directories for ${kind} in ${kindDirectory}; expected exactly one.`);","+\t\t}","+\t\tif (!entries.some(entry => entry.isFile() && entry.name === '.ready')) {","+\t\t\tthrow new Error(`Node.js compile cache generation did not produce a readiness marker for ${kind} in ${kindDirectory}.`);","+\t\t}","+\t\tconst unexpectedEntries = entries.filter(entry => entry.name !== '.ready' && entry.name !== tagDirectories[0].name);","+\t\tif (unexpectedEntries.length > 0) {","+\t\t\tthrow new Error(`Node.js compile cache generation produced unexpected ${kind} entries in ${kindDirectory}: ${unexpectedEntries.map(entry => entry.name).join(', ')}.`);","+\t\t}","+","+\t\tconst cacheDirectory = path.join(kindDirectory, tagDirectories[0].name);","+\t\tconst cacheEntries = await fs.promises.readdir(cacheDirectory, { withFileTypes: true });","+\t\tconst validCacheEntries = cacheEntries.filter(entry => entry.isFile() && nodeCompileCacheEntryPattern.test(entry.name));","+\t\tconst cacheEntryCount = validCacheEntries.length;","+\t\tif (cacheEntryCount === 0) {","+\t\t\tthrow new Error(`Node.js compile cache generation produced no ${kind} cache entries in ${cacheDirectory}.`);","+\t\t}","+\t\tconst unexpectedCacheEntries = cacheEntries.filter(entry => !entry.isFile() || !nodeCompileCacheEntryPattern.test(entry.name));","+\t\tif (unexpectedCacheEntries.length > 0) {","+\t\t\tthrow new Error(`Node.js compile cache generation produced unexpected ${kind} cache entries in ${cacheDirectory}: ${unexpectedCacheEntries.map(entry => entry.name).join(', ')}.`);","+\t\t}","+\t\ttotalCacheEntryCount += cacheEntryCount;","+\t\tconsole.log(`Generated ${cacheEntryCount} ${kind} Node.js compile cache entries in ${cacheDirectory}.`);","+\t\tawait fs.promises.rm(path.join(kindDirectory, '.ready'));","+\t}","+\treturn totalCacheEntryCount;","+}","+","+function runCacheGeneration(application: string, cacheDirectory: string, env: NodeJS.ProcessEnv): Promise<void> {","+\treturn new Promise((resolve, reject) => {","+\t\tconst child = cp.spawn(application, [], {","+\t\t\tenv,","+\t\t\tstdio: ['ignore', 'pipe', 'pipe']","+\t\t});","+\t\tlet output = '';","+\t\tlet d