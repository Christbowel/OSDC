{"id":"71069b2f52591cf275948b23e0cb0793779f5542","axis":"silent","repo":"apache/hudi","sha":"71069b2f52591cf275948b23e0cb0793779f5542","parsed":{"files":[{"path":".github/workflows/agent_gateway_ci.yml","lines":["@@ -61,7 +61,7 @@ jobs:","           cache: pip","           cache-dependency-path: hudi-agent-gateway/pyproject.toml","       - name: Install","-        run: pip install -e \".[dev]\"","+        run: pip install -e \".[dev,spark-connect]\"","       - name: Fetch pinned Hudi Architect baseline","         run: >-","           git fetch --no-tags --depth=1 origin","@@ -98,6 +98,18 @@ jobs:","           ../hudi-ai-operator/skills/hudi-architect/validate_flink_capabilities.py","           ../hudi-ai-operator/skills/hudi-architect/validate_flink_design.py","           ../hudi-ai-operator/skills/hudi-architect/validate_flink_existing_table.py","+      - name: Test guardrails with minimum sqlglot","+        # Read the lower bound from project metadata so this test follows future bumps.","+        run: |","+          sqlglot_min_requirement=$(python - <<'PY'","+          import tomllib","+          with open(\"pyproject.toml\", \"rb\") as f:","+              dependencies = tomllib.load(f)[\"project\"][\"dependencies\"]","+          print(next(dep for dep in dependencies if dep.startswith(\"sqlglot>=\")).replace(\">=\", \"==\", 1))","+          PY","+          )","+          python -m pip install \"$sqlglot_min_requirement\"","+          python -m pytest tests/test_guardrails.py -q"," ","   flink-sql-fixtures:","     name: Hudi 1.2.0 / Flink 1.20.1 SQL fixtures","@@ -145,3 +157,7 @@ jobs:","               helm template \"$chart\" > /dev/null","             fi","           done","+          helm lint hudi-lakehouse/charts/hudi-agent-gateway \\","+            -f hudi-lakehouse/charts/hudi-agent-gateway/values-spark-connect.yaml","+          helm template hudi-lakehouse/charts/hudi-agent-gateway \\","+            -f hudi-lakehouse/charts/hudi-agent-gateway/values-spark-connect.yaml > /dev/null"],"additions":17,"deletions":1,"truncated":false},{"path":"hudi-agent-gateway/Dockerfile","lines":["@@ -27,7 +27,7 @@ WORKDIR /opt/hudi-agent-gateway"," COPY pyproject.toml README.md ./"," RUN mkdir -p src/hudi_agent_gateway \\","     && printf '__version__ = \"0.1.0\"\\n' > src/hudi_agent_gateway/__init__.py \\","-    && pip install --no-cache-dir . \\","+    && pip install --no-cache-dir '.[spark-connect]' \\","     && pip uninstall -y hudi-agent-gateway"," COPY src ./src"," RUN pip install --no-cache-dir --no-deps ."],"additions":1,"deletions":1,"truncated":false},{"path":"hudi-agent-gateway/README.md","lines":["@@ -26,17 +26,26 @@ process hosts three surfaces over the same set of guarded lakehouse tools:"," | MCP server | `/mcp` (streamable HTTP) | external agents (Claude, anything MCP) call the lakehouse tools directly |"," | Chat UI | `/ui/` | first-party ChatGPT-style web UI (zero third-party code) |"," ","-The v1 tools query the lakehouse through Trino: `query_lakehouse` (guarded,","+The tools query the lakehouse through Trino (default) or the official PySpark","+Connect client: `query_lakehouse` (guarded,"," read-only SQL), `list_tables`, `describe_table`. Every model-written query"," passes AST-level guardrails (single statement, SELECT-only, row cap injected"," as a real `LIMIT`) and every invocation is logged as structured JSON — the"," seed of the gateway's trace collection."," ","+For Spark, dynamic `IDENTIFIER(...)` calls and custom or qualified table functions","+are rejected. Allowed table functions are `range`, `explode`, `explode_outer`,","+`posexplode`, `posexplode_outer`, `inline`, `inline_outer`, `stack`, `json_tuple`,","+and `hudi_query`, `hudi_table_changes`, `hudi_query_timeline`, `hudi_filesystem_view`,","+`hudi_metadata`. Hudi functions require a literal catalog table name such as","+`'default.orders'`; paths and computed table names are rejected.","+`hudi_filesystem_view` accepts only the table argument, without a subpath.","+"," ## Quickstart (local process)"," "," ```bash"," cd hudi-agent-gateway","-python3.12 -m venv .venv && .venv/bin/pip install -e \".[dev]\"","+python3.12 -m venv .venv && .venv/bin/pip install -e \".[dev,spark-connect]\""," "," # point at a Trino with the Hudi connector (e.g. the local-dev stack, port-forwarded):"," GATEWAY_TRINO_HOST=localhost GATEWAY_TRINO_PORT=18080 \\","@@ -61,6 +70,14 @@ ollama pull qwen3:8b"," GATEWAY_LLM_PROVIDER=ollama GATEWAY_LLM_MODEL=qwen3:8b hudi-agent-gateway serve"," ```"," ","+The chat UI shows progress and elapsed time while a response is running. **Stop**","+closes the response stream and cancels the agent task. If the gateway does not","+accept the connection within 15 seconds, the UI reports a connection timeout.","+The server's chat timeout returns HTTP 504","+for JSON requests or a `chat_timeout` SSE error. Provider/SQL cancellation is","+best-effort; remote work may take time to stop. After Stop or an error the UI","+starts a new conversation on the next message to avoid incomplete tool-call history.","+"," Connect an MCP client:"," "," ```bash","@@ -85,7 +102,11 @@ Environment variables (prefix `GATEWAY_` except the standard key names):"," | `ANTHROPIC_API_KEY` / `OPENAI_API_KEY` | — | required by the matching provider |"," | `GATEWAY_OLLAMA_BASE_URL` | `http://localhost:11434` | Ollama endpoint |"," | `GATEWAY_OPENAI_BASE_URL` | — | endpoint for `openai-compatible` (vLLM, Together, …) |","-| `GATEWAY_LLM_TIMEOUT_SECONDS` | `120` | per-model-call timeout |","+| `GATEWAY_LLM_TIMEOUT_SECONDS` | `120` | HTTP operation/read timeout; streaming data can keep a call alive |","+| `GATEWAY_CHAT_TIMEOUT_SECONDS` | `300` | total wall-clock limit for one chat turn, including all model/tool calls |","+| `GATEWAY_SQL_BACKEND` | `trino` | `trino` or `spark-connect` |","+| `GATEWAY_SPARK_CONNECT_URI` | `sc://hudi-spark-connect.hudi-lakehouse.svc:15002` | PySpark Connect URI; optional `/;key=value` parameters |","+| `GATEWAY_SPARK_CONNECT_CATALOG` / `_SCHEMA` | `spark_catalog` / `default` | Spark query and metadata defaults |"," | `GATEWAY_TRINO_HOST` / `_PORT` | `hudi-trino.hudi-lakehouse.svc` / `8080` | Trino coordinator |"," | `GATEWAY_TRINO_CATALOG` / `_SCHEMA` / `_USER` | `hudi` / `default` / `hudi-agent-gateway` | query defaults |"," | `GATEWAY_SQL_ROW_CAP` | `200` | LIMIT enforced on every query |","@@ -98,10 +119,79 @@ Environment variables (prefix `GATEWAY_` except the standard key names):"," | `GATEWAY_MCP_ENABLED` | `true` | serve /mcp |"," | `GATEWAY_HOST` / `GATEWAY_PORT` / `GATEWAY_LOG_LEVEL` | `0.0.0.0` / `8000` / `INFO` | server basics |"," ","-Startup never depends on the LLM or Trino being reachable: `/health` is","+Startup never depends on the LLM or the selected SQL backend being reachable: `/health` is"," liveness, `/ready` reports per-dependency status (and gates the Kubernetes"," readiness probe)."," ","+## Spark Connect backend","+","+Install the gateway in a Python 3.11/3.12 environment with the `spark-connect`","+extra. It includes `pyspark-client==4.1.3`, matching the chart's Spark version,","+and PyArrow 18.1.0. The gateway image includes this extra.","+The official Python Connect client sends RPCs to the remote Spark server; the","+gateway image requires no Java runtime, Spark JARs, or native ADBC driver.","+PySpark also brings pandas, gRPC, and protobuf dependencies; use a dedicated","+environment and upgrade the client alongside the server.","+","+After deploying the [Spark Connect chart](../hudi-lakehouse/charts/hudi-spark-connect/README.md)","+and forwarding port 15002:","+","+```bash","+GATEWAY_SQL_BACKEND=spark-connect \\","+GATEWAY_SPARK_CONNECT_URI='sc://localhost:15002' \\","+  hudi-agent-gateway serve","+```","+","+Use Helm `sqlBackend: spark-connect` and `sparkConnect.uri/catalog/schema`,","+or apply the chart's `values-spark-connect.yaml` overlay. An optional","+`sparkConnect.existingSecret` supplies the URI via `sparkConnect.uriSecretKey`.","+`/ready` reports a `spark-connect` check (cached SELECT 1) and the LLM check;","+`/v1/info`, Agent prompts, MCP tool descriptions, and the UI reflect the selected","+backend. Connection credentials are omitted from `/v1/info`.","+","+`query_lakehouse` accepts Spark SQL with backtick identifiers and enforces the","+same single-SELECT/AST/LIMIT policy. `list_tables` uses SHOW TABLES and reports","+`TABLE` for persistent objects (Spark's SHOW TABLES does not distinguish views","+from tables), `TEMPORARY` for temporary objects. `describe_table` uses a zero-row","+SELECT and PySpark's schema, preserving column/type/nullability result columns.","+Types use Spark SQL names such as `int`, `bigint`, and `array<string>`. Each call","+creates an independent remote session, sets its catalog/schema, and stops that","+session in a finally block. Sessions are not shared across tool calls.","+","+**Bounds:** SQL LIMIT and DataFrame.limit before collect cap query result rows;","+the existing JSON size cap truncates tool responses. Wide rows can still consume","+substantial client memory, and SHOW TABLES can enumerate the whole namespace","+before returning limited rows. When capped, SHOW TABLES can return an arbitrary","+subset, since Spark does not guarantee its order. The JSON cap is a response limit, not a","+server/memory budget. Queries use at most eight workers with no accumulating","+queue. A timed-out call keeps its capacity slot until execution and cleanup","+actually finish.","+","+**Timeout/cancellation:** gateway timeouts return promptly and request","+`SparkSession.interruptAll()` on a separate thread; task cancellation follows","+the same path. Stopping a streaming chat also cancels the tool tasks belonging","+to that turn, including those running inside the agent. Each request owns its","+session, so this interrupts only that request's operations. Spark provides a","+server interruption RPC, but network","+failures and races with operation startup mean cancellation remains best-effort.","+A timeout does not prove Spark stopped. Hung RPCs can delay session cleanup;","+worker pools shut down without waiting, and Python cannot forcibly terminate","+worker threads. Restart the process if all eight slots remain stuck. Connect","+URIs can use `/;use_ssl=true;token=...` for an appropriately configured endpoint;","+the chart itself has no authentication or TLS. Gateway tools expose no DML;","+direct Superset/Zeppelin writes have their own","+[tutorials and limitations](../hudi-lakehouse/charts/hudi-spark-connect/README.md#spark-connect-client-tutorials).","+","+Opt-in live tests use an existing table and do not write data:","+","+```bash","+GATEWAY_IT_SPARK_CONNECT_URI='sc://localhost:15002' \\","+GATEWAY_IT_SPARK_TABLE=bi_adbc_demo.orders \\","+  .venv/bin/python -m pytest tests/integration/test_spark_connect_live.py -q","+```","+","+Add `GATEWAY_IT_LLM=1` to exercise the real Agent loop with the configured LLM.","+"," ## Development"," "," ```bash"],"additions":94,"deletions":4,"truncated":false},{"path":"hudi-agent-gateway/pyproject.toml","lines":["@@ -35,7 +35,8 @@ dependencies = [","   \"langchain-ollama>=1.0\",","   \"fastmcp>=2.10,<3\",","   \"trino>=0.330\",","-  \"sqlglot>=25.0\",","+  # Guardrails rely on AST shapes verified at this minimum version in CI.","+  \"sqlglot>=30.21.0\",","   \"pydantic>=2.7\",","   \"pydantic-settings>=2.3\",","   \"sse-starlette>=2.1\",","@@ -43,6 +44,11 @@ dependencies = ["," ]"," "," [project.optional-dependencies]","+spark-connect = [","+  # The session cleanup workaround relies on PySpark's private client API.","+  \"pyspark-client==4.1.3\",","+  \"pyarrow==18.1.0\",","+]"," dev = [","   \"pytest>=8.0\",","   \"pytest-asyncio>=0.24\","],"additions":7,"deletions":1,"truncated":false},{"path":"hudi-agent-gateway/src/hudi_agent_gateway/agent.py","lines":["@@ -31,13 +31,13 @@"," "," _SYSTEM_PROMPT = \"\"\"\\"," You are the Apache Hudi lakehouse analyst. You answer questions about data in \\","-an Apache Hudi lakehouse by querying it through Trino using your tools. The \\","+an Apache Hudi lakehouse by querying it through {backend} using your tools. The \\"," default catalog is `{catalog}` and the default schema is `{schema}`; tables \\"," are Hudi tables registered in the catalog's metastore."," "," Tool strategy:"," - For unfamiliar tables, call `list_tables` and `describe_table` BEFORE writing SQL.","-- `query_lakehouse` accepts exactly ONE read-only SELECT statement (Trino SQL). \\","+- `query_lakehouse` accepts exactly ONE read-only SELECT statement ({dialect} SQL). \\"," Qualify names as catalog.schema.table when querying outside the defaults."," - A server-side row cap of {row_cap} rows is enforced. Prefer aggregations, \\"," GROUP BY, and explicit LIMIT over raw row dumps.","@@ -55,8 +55,10 @@"," def build_system_prompt(settings: GatewaySettings) -> str:","     extra = f\"\\n{settings.system_prompt_extra}\" if settings.system_prompt_extra else \"\"","     return _SYSTEM_PROMPT.format(","-        catalog=settings.trino_catalog,","-        schema=settings.trino_schema,","+        backend=\"Spark Connect\" if settings.sql_backend == \"spark-connect\" else \"Trino\",","+        dialect=\"Spark\" if settings.sql_backend == \"spark-connect\" else \"Trino\",","+        catalog=settings.lakehouse_catalog,","+        schema=settings.lakehouse_schema,","         row_cap=settings.sql_row_cap,","         extra=extra,","     )"],"additions":6,"deletions":4,"truncated":false},{"path":"hudi-agent-gateway/src/hudi_agent_gateway/api/chat.py","lines":["@@ -18,9 +18,11 @@"," "," from __future__ import annotations"," ","+import asyncio"," import logging"," import uuid"," from collections.abc import AsyncIterator","+from contextlib import aclosing"," from typing import Any"," "," from fastapi import APIRouter, HTTPException, Request","@@ -33,11 +35,13 @@","     ChatResponse,","     DoneEvent,","     ErrorEvent,","+    StatusEvent,","     TokenEvent,","     ToolCallEvent,","     ToolResultEvent,","     ToolTraceEntry,"," )","+from hudi_agent_gateway.cancellation import ToolCancellationScope, tool_cancellation_scope"," from hudi_agent_gateway.log import log_event, request_id_var, session_id_var"," from hudi_agent_gateway.tools.registry import is_tool_error"," ","@@ -46,10 +50,10 @@"," "," def _message_text(msg: Any) -> str:","     text = getattr(msg, \"text\", None)","-    if callable(text):  # langchain-core < 1.x compatibility","-        return text()","     if isinstance(text, str):","         return text","+    if callable(text):  # langchain-core < 1.x compatibility","+        return text()","     return str(getattr(msg, \"content\", \"\"))"," "," ","@@ -97,10 +101,13 @@ async def chat(request: Request, body: ChatRequest) -> Any:","     if wants_stream:","         return EventSourceResponse(_stream_chat(request, body))"," ","-    agent = state.agents.get(body.model)","     inputs = {\"messages\": [HumanMessage(body.message)]}","     try:","-        result = await agent.ainvoke(inputs, config=_agent_config(request, body.session_id))","+        async with asyncio.timeout(state.settings.chat_timeout_seconds):","+            agent = state.agents.get(body.model)","+            result = await agent.ainvoke(inputs, config=_agent_config(request, body.session_id))","+    except TimeoutError as e:","+        raise HTTPException(status_code=504, detail=_timeout_message(request)) from e","     except GraphRecursionError as e:","         raise HTTPException(","             status_code=422,","@@ -126,27 +133,44 @@ async def chat(request: Request, body: ChatRequest) -> Any:"," "," async def _stream_chat(request: Request, body: ChatRequest) -> AsyncIterator[ServerSentEvent]:","     state = request.app.state","-    agent = state.agents.get(body.model)","     inputs = {\"messages\": [HumanMessage(body.message)]}","     final_text_parts: list[str] = []","+    yield _status_event(\"Preparing response…\")","+    scope = ToolCancellationScope()","+    scope_token = tool_cancellation_scope.set(scope)","     try:","-        async for mode, chunk in agent.astream(","-            inputs,","-            config=_agent_config(request, body.session_id),","-            stream_mode=[\"messages\", \"updates\"],","-        ):","-            if mode == \"messages\":","-                msg_chunk, _meta = chunk","-                if isinstance(msg_chunk, AIMessageChunk):","-                    text = _message_text(msg_chunk)","-                    if text:","-                        final_text_parts.append(text)","-                        yield ServerSentEvent(","-                            event=\"token\", data=TokenEvent(text=text).model_dump_json()","-                        )","-            elif mode == \"updates\" and isinstance(chunk, dict):","-                for events in _updates_to_events(chunk):","-                    yield events","+        async with asyncio.timeout(state.settings.chat_timeout_seconds):","+            agent = state.agents.get(body.model)","+            async with aclosing(agent.astream(","+                inputs,","+                config=_agent_config(request, body.session_id),","+                stream_mode=[\"messages\", \"updates\"],","+            )) as stream:","+                async for mode, chunk in stream:","+                    if mode == \"messages\":","+                        msg_chunk, _meta = chunk","+                        if isinstance(msg_chunk, AIMessageChunk):","+                            text = _message_text(msg_chunk)","+                            if text:","+                                final_text_parts.append(text)","+                                yield ServerSentEvent(","+                                    event=\"token\", data=TokenEvent(text=text).model_dump_json()","+                                )","+                    elif mode == \"updates\" and isinstance(chunk, dict):","+                        for event in _updates_to_events(chunk):","+                            yield event","+    except TimeoutError:","+        log_event(logger, \"chat_timeout\", timeout_seconds=state.settings.chat_timeout_seconds)","+        yield ServerSentEvent(","+            event=\"error\",","+            data=ErrorEvent(","+                code=\"chat_timeout\", message=_timeout_message(request)","+            ).model_dump_json(),","+        )","+        return","+    except asyncio.CancelledError:","+        log_event(logger, \"chat_cancelled\")","+        raise","     except GraphRecursionError:","         yield ServerSentEvent(","             event=\"error\",","@@ -163,6 +187,11 @@ async def _stream_chat(request: Request, body: ChatRequest) -> AsyncIterator[Ser","             data=ErrorEvent(code=\"agent_error\", message=str(e)).model_dump_json(),","         )","         return","+    finally:","+        # LangGraph may run tools in tasks that outlive its streaming iterator.","+        # Cancel only this turn's tasks when the stream ends or disconnects.","+        scope.cancel()","+        tool_cancellation_scope.reset(scope_token)"," ","     yield ServerSentEvent(","         event=\"done\",","@@ -172,8 +201,20 @@ async def _stream_chat(request: Request, body: ChatRequest) -> AsyncIterator[Ser","     )"," "," ","+def _timeout_message(request: Request) -> str:","+    seconds = request.app.state.settings.chat_timeout_seconds","+    return (f\"The response exceeded the {seconds:g}s time limit. Start a new session \"","+            \"before retrying, because this session may contain an incomplete tool call.\")","+","+","+def _status_event(message: str) -> ServerSentEvent:","+    return ServerSentEvent(event=\"status\", data=StatusEvent(message=message).model_dump_json())","+","+"," def _updates_to_events(update: dict[str, Any]) -> list[ServerSentEvent]:","     events: list[ServerSentEvent] = []","+    if \"pre_model_hook\" in update:","+        events.append(_status_event(\"Waiting for model…\"))","     agent_update = update.get(\"agent\") or {}","     for msg in agent_update.get(\"messages\", []):","         if isinstance(msg, AIMessage):"],"additions":63,"deletions":22,"truncated":false},{"path":"hudi-agent-gateway/src/hudi_agent_gateway/api/meta.py","lines":["@@ -19,6 +19,7 @@"," from __future__ import annotations"," "," import time","+from urllib.parse import urlparse"," "," from fastapi import APIRouter, Request, Response"," ","@@ -46,11 +47,12 @@ async def ready(request: Request, response: Response) -> ReadyResponse:","     state = request.app.state","     checks: dict[str, DependencyStatus] = {}"," ","-    trino_ok = await state.trino_client.ping()","-    checks[\"trino\"] = DependencyStatus(","-        ok=trino_ok,","-        detail=\"reachable\" if trino_ok else","-        f\"cannot reach trino at {state.settings.trino_host}:{state.settings.trino_port}\",","+    lakehouse_ok = await state.lakehouse_client.ping()","+    backend = state.settings.sql_backend","+    checks[backend] = DependencyStatus(","+        ok=lakehouse_ok,","+        detail=\"reachable\" if lakehouse_ok else","+        f\"cannot query {backend}; check connection settings, client driver, and server logs\",","     )"," ","     llm_ok, llm_detail = await state.llm_readiness.check()","@@ -86,14 +88,25 @@ async def models(request: Request) -> ModelsResponse:"," @router.get(\"/v1/info\", response_model=InfoResponse, response_model_by_alias=True)"," async def info(request: Request) -> InfoResponse:","     s = request.app.state.settings","+    lakehouse_url = f\"http://{s.trino_host}:{s.trino_port}\"","+    if s.sql_backend == \"spark-connect\":","+        uri = urlparse(\"http\" + s.spark_connect_uri[2:])","+        host = uri.hostname or \"\"","+        if \":\" in host:","+            host = f\"[{host}]\"","+        lakehouse_url = f\"sc://{host}:{uri.port or 15002}\"","     return InfoResponse(","         name=\"hudi-agent-gateway\",","         version=__version__,","         provider=s.llm_provider,","         model=s.llm_mod