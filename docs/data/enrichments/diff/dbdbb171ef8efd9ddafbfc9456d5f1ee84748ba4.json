ushtags --groups`","+reports cache groups that do not exist instead of throwing an exception."," "," Three new PSR-14 events replace the removed"," :ref:`hooks <breaking-111263-1793181136>`:","@@ -88,7 +100,8 @@ Three new PSR-14 events replace the removed"," :php:`\\TYPO3\\CMS\\Core\\Cache\\Event\\BeforeCacheFlushEvent`","     Dispatched once per flush with the complete","     :php-short:`\\TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushPlan`, which listeners","-    may change.","+    may change. Its tag methods take the cache group as an optional second","+    argument, \"pages\" by default."," "," :php:`\\TYPO3\\CMS\\Core\\Cache\\Event\\AfterCacheFlushedEvent`","     Dispatched once after the caches were flushed, with the"],"additions":18,"deletions":5,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Cache/Flush/CacheFlusherTest.php","lines":["@@ -55,6 +55,10 @@ final class CacheFlusherTest extends FunctionalTestCase","                         'backend' => FlushCountingBackend::class,","                         'groups' => [],","                     ],","+                    'cache_flusher_test_system_group' => [","+                        'backend' => FlushCountingBackend::class,","+                        'groups' => ['system'],","+                    ],","                 ],","             ],","         ],","@@ -420,6 +424,57 @@ public function allCommandFlushesEveryCacheOnce(string $cacheIdentifier): void","         self::assertSame(1, $backend->flushCount);","     }"," ","+    public static function tagsAreFlushedInTheirGroupDataProvider(): array","+    {","+        return [","+            'the \"pages\" group' => ['pages', ['pages', 'cache_flusher_test_pages_group']],","+            'another group' => ['system', ['cache_flusher_test_system_group']],","+            'all caches' => ['all', ['pages', 'cache_flusher_test_pages_group', 'cache_flusher_test_default_group', 'cache_flusher_test_without_group', 'cache_flusher_test_system_group']],","+        ];","+    }","+","+    #[Test]","+    #[DataProvider('tagsAreFlushedInTheirGroupDataProvider')]","+    public function tagsAreFlushedInTheirGroup(string $group, array $expectedFlushedCaches): void","+    {","+        $caches = ['pages', 'cache_flusher_test_pages_group', 'cache_flusher_test_default_group', 'cache_flusher_test_without_group', 'cache_flusher_test_system_group'];","+        $cacheManager = $this->get(CacheManager::class);","+        foreach ($caches as $cacheIdentifier) {","+            $cacheManager->getCache($cacheIdentifier)->set('entry', 'dummy', ['myTag']);","+        }","+","+        $result = $this->get(CacheFlusher::class)->flush(CacheFlushDemand::forTagsInGroup($group, 'myTag'));","+","+        $flushedCaches = array_values(array_filter($caches, static fn(string $cacheIdentifier): bool => !$cacheManager->getCache($cacheIdentifier)->has('entry')));","+        self::assertEqualsCanonicalizing($expectedFlushedCaches, $flushedCaches);","+        self::assertSame([$group => ['myTag']], $result->tags);","+    }","+","+    #[Test]","+    public function tagsOfAnUnknownGroupAreSkipped(): void","+    {","+        $pageCache = $this->get(CacheManager::class)->getCache('pages');","+        $pageCache->set('entry', 'dummy', ['myTag']);","+","+        $result = $this->get(CacheFlusher::class)->flush(CacheFlushDemand::forTagsInGroup('unknown', 'myTag')->withTagsInGroup('pages', 'otherTag'));","+","+        self::assertTrue($pageCache->has('entry'));","+        self::assertSame(['pages' => ['otherTag']], $result->tags);","+        self::assertSame(['unknown' => CacheFlushSkipReason::UnknownGroup], $result->skippedGroups);","+    }","+","+    #[Test]","+    public function resultListsTagsPerGroupAndAllTags(): void","+    {","+        $result = $this->get(CacheFlusher::class)->flush(","+            CacheFlushDemand::forTags('pageTag', 'sharedTag')->withTagsInGroup('all', 'sharedTag', 'fileTag')","+        );","+","+        self::assertSame(['pageTag', 'sharedTa