ntainer $container */","+        $container = $this->get('service_container');","+        $container->set('flush-cache-tag-test', static function (AfterCacheFlushedEvent $event) use (&$afterCacheFlushedEvents): void {","+            $afterCacheFlushedEvents[] = $event;","+        });","+        $this->get(ListenerProvider::class)->addListener(AfterCacheFlushedEvent::class, 'flush-cache-tag-test');","+","+        $this->get(EventDispatcherInterface::class)->dispatch(new AfterFileMetaDataUpdatedEvent(5, 7, []));","+","+        self::assertFalse($pageCache->has('file-entry'));","+        self::assertFalse($pageCache->has('metadata-entry'));","+        self::assertTrue($pageCache->has('other-entry'));","+        self::assertFalse($systemCache->has('file-entry'));","+        self::assertCount(1, $afterCacheFlushedEvents);","+        self::assertSame(['all' => ['sys_file_5', 'sys_file_metadata_7']], $afterCacheFlushedEvents[0]->result->tags);","+    }","+}",""],"additions":79,"deletions":0,"truncated":false}],"additions":329,"deletions":50,"truncated":false,"file_count":13},"error":null,"fetched_at":"2026-11-11T15:40:21.362629+00:00"}