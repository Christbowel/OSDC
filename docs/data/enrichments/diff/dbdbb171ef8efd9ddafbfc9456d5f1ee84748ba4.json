gs[$tag]);","+        unset($this->tags[$group][$tag]);","+        if (($this->tags[$group] ?? null) === []) {","+            unset($this->tags[$group]);","+        }","     }"," ","-    public function hasTag(string $tag): bool","+    public function hasTag(string $tag, string $group = 'pages'): bool","     {","-        return isset($this->tags[$tag]);","+        return isset($this->tags[$group][$tag]);","     }"," ","     /**","      * @return list<string>","      */","-    public function getTags(): array","+    public function getTags(string $group = 'pages'): array","+    {","+        return array_map(strval(...), array_keys($this->tags[$group] ?? []));","+    }","+","+    /**","+     * @return array<string, list<string>> cache group => tags","+     */","+    public function getTagsByGroup(): array","     {","-        return array_map(strval(...), array_keys($this->tags));","+        return array_map(static fn(array $tags): array => array_map(strval(...), array_keys($tags)), $this->tags);","     }"," ","     /**"],"additions":23,"deletions":12,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Flush/CacheFlushResult.php","lines":["@@ -18,14 +18,14 @@"," namespace TYPO3\\CMS\\Core\\Cache\\Flush;"," "," /**","- * What was flushed: cache tags of the \"pages\" group, cache groups, and the","+ * What was flushed: cache tags per cache group, cache groups, and the","  * records and cache commands this was resolved from, including what was","  * skipped and why.","  */"," final readonly class CacheFlushResult"," {","     /**","-     * @param list<string> $tags","+     * @param array<string, list<string>> $tags cache group => tags, \"all\" stands for all caches","      * @param list<string> $groups \"all\" stands for all caches","      * @param array<string, CacheFlushSkipReason> $skippedGroups","      * @param list<CacheFlushRecord> $records","@@ -44,7 +44,7 @@ public static function fromPlan(CacheFlushPlan $plan): self","     {","         return new self("," 