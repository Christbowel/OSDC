 in the cache group \"pages\". Cache groups are flushed","+ * Cache tags are flushed in the cache group \"pages\", unless the demand names","+ * another group or \"all\" for all caches. Cache groups are flushed","  * by dispatching CacheFlushEvent, like the \"cache:flush\" command does.","  * All events are dispatched here, callers only describe what to flush.","  * flush() resolves and executes a demand in one go, resolve() alone tells","@@ -77,13 +78,16 @@ public function resolve(CacheFlushDemand $demand, CacheFlushingContext $context","         foreach ($demand->pageIds as $pageId) {","             $plan->addTag('pageId_' . $pageId);","         }","-        foreach ($demand->tags as $tag) {","-            $plan->addTag($tag);","+        foreach ($demand->tags as $group => $tags) {","+            foreach ($tags as $tag) {","+                $plan->addTag($tag, (string)$group);","+            }","         }","         foreach ($demand->commands as $command) {","             $this->resolveCommand($command, $plan);","         }","         $this->eventDispatcher->dispatch(new BeforeCacheFlushEvent($plan));","+        $this->skipTagsOfUnknownGroups($plan);","         return $plan;","     }"," ","@@ -101,8 +105,13 @@ public function execute(CacheFlushPlan $plan): CacheFlushResult","             if ($plan->getGroups() !== []) {","                 $this->eventDispatcher->dispatch(new CacheFlushEvent($plan->getGroups()));","             }","-            if ($plan->getTags() !== []) {","-                $this->cacheManager->flushCachesInGroupByTags('pages', $plan->getTags());","+            $this->skipTagsOfUnknownGroups($plan);","+            foreach ($plan->getTagsByGroup() as $group => $tags) {","+                if ($group === 'all') {","+                    $this->cacheManager->flushCachesByTags($tags);","+                } elseif (!$plan->hasGroup($group)) {","+                    $this->cacheManager->flushCachesInGroupByTags($group, $tags);","+                }","             }","         }","         $result = CacheFlushResult::fromPlan($plan);","@@ -204,6 +213,20 @@ private function resolveCommand(string $command, CacheFlushPlan $plan): void","         }","     }"," ","+    private function skipTagsOfUnknownGroups(CacheFlushPlan $plan): void","+    {","+        $cacheGroups = $this->cacheManager->getCacheGroups();","+        foreach ($plan->getTagsByGroup() as $group => $tags) {","+            if ($group === 'all' || in_array($group, $cacheGroups, true)) {","+                continue;","+            }","+            foreach ($tags as $tag) {","+                $plan->removeTag($tag, $group);","+            }","+            $plan->skipGroup($group, CacheFlushSkipReason::UnknownGroup);","+        }","+    }","+","     private function flushDependencyInjectionCacheInDevelopment(): void","     {","         if (!Environment::getContext()->isDevelopment()) {"],"additions":28,"deletions":5,"truncated":false},{"path":"typo3/sysext/core/Classes/Command/CacheFlushTagsCommand.php","lines":["@@ -23,14 +23,15 @@"," use Symfony\\Component\\Console\\Input\\InputInterface;"," use Symfony\\Component\\Console\\Input\\InputOption;"," use Symfony\\Component\\Console\\Output\\OutputInterface;","-use TYPO3\\CMS\\Core\\Cache\\CacheManager;","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushDemand;","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher;"," use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;"," "," #[AsCommand('cache:flushtags', 'Flushes caches identified by one or more cache tags.')]"," class CacheFlushTagsCommand extends Command"," {","     public function __construct(","-        protected readonly CacheManager $cacheManager,","+        protected readonly CacheFlusher $cacheFlusher,","     ) {","         parent::__construct();","     }","@@ -66,15 +67,15 @@ protected function execute(InputInterface $input, OutputInterface $output): int","         $groups = GeneralUtility::trimExplode(',', $input->getOption('groups') ?? '', true);","         $tags = GeneralUtility::trimExplode(',', $input->getArgument('tags') ?? '', true);"," ","+        $demand = CacheFlushDemand::create();","         foreach ($groups as $group) {","-            if ($group === 'all') {","-                $this->cacheManager->flushCachesByTags($tags);","-                continue;","-            }","-","-            $this->cacheManager->flushCachesInGroupByTags($group, $tags);","+            $demand = $demand->withTagsInGroup($group, ...$tags);","         }","+        $result = $this->cacheFlusher->flush($demand);"," ","-        return Command::SUCCESS;","+        foreach (array_keys($result->skippedGroups) as $group) {","+            $output->writeln(sprintf('<error>Cache group \"%s\" does not exist.</error>', $group));","+        }","+        return $result->skippedGroups === [] ? Command::SUCCESS : Command::FAILURE;","     }"," }"],"additions":10,"deletions":9,"truncated":false},{"path":"typo3/sysext/core/Classes/Resource/Cache/FlushCacheTagForFile.php","lines":["@@ -19,7 +19,8 @@"," "," use Symfony\\Component\\DependencyInjection\\Attribute\\Autowire;"," use TYPO3\\CMS\\Core\\Attribute\\AsEventListener;","-use TYPO3\\CMS\\Core\\Cache\\CacheManager;","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushDemand;","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlusher;"," use TYPO3\\CMS\\Core\\Resource\\Event\\AfterFileContentsSetEvent;"," use TYPO3\\CMS\\Core\\Resource\\Event\\AfterFileDeletedEvent;"," use TYPO3\\CMS\\Core\\Resource\\Event\\AfterFileMovedEvent;","@@ -29,7 +30,7 @@"," final readonly class FlushCacheTagForFile"," {","     public function __construct(","-        private CacheManager $cacheManager,","+        private CacheFlusher $cacheFlusher,","         #[Autowire(expression: 'service(\"features\").isFeatureEnabled(\"frontend.cache.autoTagging\")')]","         private bool $autoTagging","     ) {}","@@ -45,6 +46,6 @@ public function __invoke(","         if (!$this->autoTagging) {","             return;","         }","-        $thi