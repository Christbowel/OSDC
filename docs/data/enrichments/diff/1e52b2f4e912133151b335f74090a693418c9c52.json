 }).data;","+};","+","+describe('Content API Folder Controller - findOne', () => {","+  beforeEach(() => {","+    mockGetService.mockImplementation(","+      () =>","+        ({","+          getNamePaths: jest.fn(async () => ({ '/1': '/Clients', '/1/2': '/Clients/Acme' })),","+        }) as any","+    );","+  });","+","+  test('returns `parent: null` for a root folder', async () => {","+    const data = await findOne(createController(rootFolder));","+","+    expect(data.parent).toBeNull();","+    expect(data.namePath).toBe('/Clients');","+  });","+","+  test.each([","+    ['root', rootFolder],","+    ['nested', nestedFolder],","+  ])('leaves `parent` out of a %s folder when the sanitizer removed it', async (_, folder) => {","+    const data = await findOne(createController(folder, (f) => omit(f, 'parent')));","+","+    expect(data).not.toHaveProperty('parent');","+  });","+","+  test('leaves `namePath` out when the sanitizer removed `name`', async () => {","+    const data = await findOne(createController(nestedFolder, (f) => omit(f, 'name')));","+","+    expect(data).not.toHaveProperty('namePath');","+    expect(data.parent).toEqual({ id: 1, documentId: 'root' });","+  });","+","+  test('leaves `namePath` out of a folder without a path', async () => {","+    const folder = { ...rootFolder, path: null } as unknown as Folder;","+","+    const data = await findOne(createController(folder));","+","+    expect(data.path).toBeNull();","+    expect(data).not.toHaveProperty('namePath');","+  });","+});"],"additions":102,"deletions":0,"truncated":false},{"path":"packages/core/upload/server/src/controllers/content-api-folder.ts","lines":["@@ -0,0 +1,124 @@","+import type { Context } from 'koa';","+import { omit } from 'lodash';","+import { errors, traverse } from '@strapi/utils';","+import type { Core, Data } from '@strapi/types';","+","+import { getService } from '../utils';","+import { FILE_MODEL_UID, FOLDER_MODEL_UID } from '../constants';","+import { findAndCountRestPage } from '../utils/rest-pagination';","+import { isIntegerId } from '../utils/integer-id';","+","+const FIELDS = ['documentId', 'name', 'path', 'createdAt', 'updatedAt'];","+const POPULATE = { parent: { fields: ['documentId'] } };","+","+type ContentApiFolder = {","+  id: Data.ID;","+  documentId: Data.DocumentID;","+  name: string;","+  path: string | null;","+  createdAt: string;","+  updatedAt: string;","+  parent?: { id: Data.ID; documentId: Data.DocumentID } | null;","+  namePath?: string;","+};","+","+// The response shape is fixed, so `fields` and `populate` are ignored on both routes.","+const omitShapeParams = (query: Record<string, unknown>) => omit(query, ['fields', 'populate']);","+","+// `file.folder` is private, so a folder can't be looked up through its files either.","+const throwFileRelations: Parameters<typeof traverse.traverseQueryFilters>[0] = ({","+  key,","+  attribute,","+  path,","+}) => {","+  if (attribute?.type === 'relation' && attribute.target === FILE_MODEL_UID) {","+    throw new errors.ValidationError(`Invalid key ${key}`, { key, path: path.attribute });","+  }","+};","+","+export default ({ strapi }: { strapi: Core.Strapi }) => {","+  const validateQuery = async (data: Record<string, unknown>, ctx: Context) => {","+    const schema = strapi.getModel(FOLDER_MODEL_UID);","+    const { auth, route } = ctx.state;","+    const options = { schema, getModel: strapi.getModel.bind(strapi) };","+","+    await traverse.traverseQueryFilters(throwFileRelations, options, data.filters);","+    await traverse.traverseQuerySort(throwFileRelations, options, data.sort);","+","+    return strapi.contentAPI.validate.query(data, schema, { auth, route });","+  };","+","+  const sanitizeQuery = async (data: Record<string, unknown>, ctx: Context) => {","+    const schema = strapi.getModel(FOLDER_MODEL_UID);","+    const { auth, route } = ctx.state;","+","+    return strapi.contentAPI.sanitize.query(data, schema, { auth, route });","+  };","+","+  const toResponse = async (folders: ContentApiFolder[], ctx: Context) => {","+    const schema = strapi.getModel(FOLDER_MODEL_UID);","+    const { auth } = ctx.state;","+","+    const namePaths = await getService('folder').getNamePaths(folders.map(({ path }) => path));","+    const sanitized = (await strapi.contentAPI.sanitize.output(folders, schema, {","+      auth,","+    })) as ContentApiFolder[];","+","+    return sanitized.map((folder, index) => {","+      const response = { ...folder };","+","+      // `parent` is left out when the sanitizer removed it, so it never looks like a root folder.","+      if ('parent' in folder) {","+        response.parent = folder.parent ?? null;","+      }","+","+      const { path } = folders[index];","+","+      if ('name' in folder && typeof path === 'string') {","+        response.namePath = namePaths[path];","+      }","+","+      return response;","+    });","+  };","+","+  return {","+    async find(ctx: Context) {","+      const query = omitShapeParams(ctx.query);","+","+      await validateQuery(query, ctx);","+      const { filters, sort, pagination } = await sanitizeQuery(query, ctx);","+","+      const { results, pagination: paginationInfo } = await findAndCountRestPage(","+        strapi,","+        FOLDER_MODEL_UID,","+        { filters, sort, pagination, fields: FIELDS, populate: POPULATE }","+      );","+","+      ctx.body = { data: await toResponse(results, ctx), meta: { pagination: paginationInfo } };","+    },","+","+    async findOne(ctx: Context) {","+      await validateQuery(omitShapeParams(ctx.query), ctx);","+","+      const { id } = ctx.params;","+      const filters = isIntegerId(id) ? { id } : { documentId: id };","+","+      const folder = await strapi.db","+        .query(FOLDER_MODEL_UID)","+        .findOne(","+          strapi","+            .get('query-params')","+            .transform(FOLDER_MODEL_UID, { filters, fields: FIELDS, populate: POPULATE })","+        );","+","+      if (!folder) {","+        return ctx.notFound('folder.notFound');","+      }","+","+      const [data] = await toResponse([folder], ctx);","+","+      ctx.body = { data };","+    },","+  };","+};"],"additions":124,"deletions":0,"truncated":false},{"path":"packages/core/upload/server/src/controllers/index.ts","lines":["@@ -4,6 +4,7 @@ import adminFolderFile from './admin-folder-file';"," import adminSettings from './admin-settings';"," import adminUpload from './admin-upload';"," import contentApi from './content-api';","+import contentApiFolder from './content-api-folder';"," import viewConfiguration from './view-configuration';"," "," export const controllers = {","@@ -13,5 +14,8 @@ export const controllers = {","   'admin-settings': adminSettings,","   'admin-upload': adminUpload,","   'content-api': contentApi,","+  // Named after the model, so the `parent` relation check (`plugin::upload.folder.find`)","+  // uses the same action as the folders list.","+  folder: contentApiFolder,","   'view-configuration': viewConfiguration,"," };"],"additions":4,"deletions":0,"truncated":false},{"path":"packages/core/upload/server/src/routes/content-api.ts","lines":["@@ -69,6 +69,28 @@ const createRoutes = createContentApiRoutesFactory((): Core.RouterInput['routes'","       },","       response: validator.file,","     },","+    {","+      method: 'GET',","+      path: '/folders',","+      handler: 'folder.find',","+      request: {","+        query: {","+          sort: validator.querySort.optional(),","+          pagination: validator.pagination.optional(),","+          filters: validator.filters.optional(),","+        },","+      },","+      response: validator.paginatedFolders,","+    },","+    {","+      method: 'GET',","+      path: '/folders/:id',","+      handler: 'folder.findOne',","+      request: {","+        params: { id: validator.folderIdOrDocumentId },","+      },","+      response: z.object({ data: validator.folder }),","+    },","   ];"," });"," "],"additions":22,"deletions":0,"truncated":f