ts to the `api.rest.withCount` config (true) when not specified on the request.","+ */","+const resolveWithCount = (strapi: Core.Strapi, pagination: Record<string, unknown>): boolean => {","+  if (Object.hasOwn(pagination, 'withCount')) {","+    const withCount = pagination.withCount;","+","+    if (typeof withCount === 'boolean') {","+      return withCount;","+    }","+","+    if (typeof withCount === 'undefined') {","+      return false;","+    }","+","+    if (['true', 't', '1', 1].includes(withCount as string | number)) {","+      return true;","+    }","+","+    if (['false', 'f', '0', 0].includes(withCount as string | number)) {","+      return false;","+    }","+","+    throw new errors.ValidationError(","+      'Invalid withCount parameter. Expected \"t\",\"1\",\"true\",\"false\",\"0\",\"f\"'","+    );","+  }","+","+  return Boolean(strapi.config.get('api.rest.withCount', true));","+};","+","+/**","+ * REST-aware paginated find for the content API.","+ *","+ * Unlike the database `findPage` (used by the admin API), this honors the standard nested","+ * `pagination` query object (`pagination[page]`, `pagination[pageSize]`,","+ * `pagination[start]`, `pagination[limit]`, `pagination[withCount]`) and the","+ * `api.rest.defaultLimit` / `api.rest.maxLimit` / `api.rest.withCount` config,","+ * exactly like every other Strapi REST collection-type endpoint.","+ */","+export const findAndCountRestPage = async (","+  strapi: Core.Strapi,","+  uid: UID.Schema,","+  query: any = {}","+) => {","+  const pagination = query.pagination ?? {};","+","+  const defaultLimit = toNumber(strapi.config.get('api.rest.defaultLimit', 25));","+  const maxLimit = toNumber(strapi.config.get('api.rest.maxLimit')) || null;","+","+  // Whether the consumer used page-based pagination (default) vs offset-based.","+  const isOffset = Object.hasOwn(pagination, 'start') || Object.hasOwn(pagination, 'limit');","+  const isPaged = !isOffset;","+","+  // Resolve start/limit applying defaults and the maxLimit cap.","+  const { start, limit } = paginationUtils.withDefaultPagination(pagination, {","+    defaults: { offset: { limit: defaultLimit }, page: { pageSize: defaultLimit } },","+    maxLimit: maxLimit || -1,","+  });","+","+  // Feed the transform the resolved offset/limit so it ignores the nested","+  // `pagination` object (which it cannot read) and applies real bounds.","+  const transformed = strapi","+    .get('query-params')","+    .transform(uid, { ...query, pagination: undefined, start, limit });","+","+  const shouldCount = resolveWithCount(strapi, pagination);","+","+  const [results, total] = await Promise.all([","+    strapi.db.query(uid).findMany(transformed),","+    shouldCount ? strapi.db.query(uid).count(transformed) : Promise.resolve(undefined),","+  ]);","+","+  const transform = isPaged","+    ? paginationUtils.transformPagedPaginationInfo","+    : paginationUtils.transformOffsetPaginationInfo;","+","+  const paginationInfo = transform({ start, limit }, total as number);","+","+  return {","+    results,","+    // Omit total & pageCount when counting is disabled (withCount=false).","+    pagination: total == null ? _.omit(paginationInfo, ['total', 'pageCount']) : paginationInfo,","+  };","+};"],"additions":91,"deletions":0,"truncated":false},{"path":"tests/api/core/upload/content-api/folders.test.api.js","lines":["@@ -0,0 +1,385 @@","+'use strict';","+","+const { createTestBuilder } = require('api-tests/builder');","+const { createStrapiInstance } = require('api-tests/strapi');","+const { createAgent } = require('api-tests/agent');","+const { createContentAPIRequest, createAuthRequest } = require('api-tests/request');","+","+const builder = createTestBuilder();","+let strapi;","+let rq;","+let rqAdmin;","+","+const folders = {};","+const tokenIds = [];","+","+const createFolder = async (name, parent = null) => {","+  const res = await rqAdmin({ method: 'POST', url: '/upload/folders', body: { name, parent } });","+","+  return res.body.data;","+};","+","+const deleteFolders = (folderIds) =>","+  rqAdmin({ method: 'POST', url: '/upload/actions/bulk-delete', body: { folderIds } });","+","+// Paths are made of unpadded pathIds, so `/1` alone would also match `/10`.","+const subtreeOf = (path) => ({","+  $or: [{ path: { $eq: path } }, { path: { $startsWith: `${path}/` } }],","+});","+","+const createTokenRequest = async (body) => {","+  const res = await rqAdmin({","+    method: 'POST',","+    url: '/admin/api-tokens',","+    body: { name: `folders-${tokenIds.length}`, lifespan: null, ...body },","+  });","+","+  tokenIds.push(res.body.data.id);","+","+  return createContentAPIRequest({ strapi, auth: { token: res.body.data.accessKey } });","+};","+","+describe('Upload content API - read-only folders routes', () => {","+  beforeAll(async () => {","+    await builder.build();","+    strapi = await createStrapiInstance({ bypassAuth: false });","+    rqAdmin = await createAuthRequest({ strapi });","+    rq = await createTokenRequest({ type: 'full-access' });","+","+    folders.clients = await createFolder('Clients');","+    folders.acme = await createFolder('Acme', folders.clients.id);","+    folders.year = await createFolder('2026', folders.acme.id);","+    folders.archive = await createFolder('Archive');","+  });","+","+  afterAll(async () => {","+    await deleteFolders([folders.clients.id, folders.archive.id]);","+    await Promise.all(","+      tokenIds.map((id) => rqAdmin({ method: 'DELETE', url: `/admin/api-tokens/${id}` }))","+    );","+","+    await strapi.destroy();","+    await builder.cleanup();","+  });","+","+  describe('Permissions', () => {","+    test('refuses a request without a token', async () => {","+      const rqPublic = createAgent(strapi, { urlPrefix: '/api' });","+","+      const res = await rqPublic({ method: 'GET', url: '/upload/folders' });","+","+      expect(res.statusCode).toBe(403);","+    });","+","+    test('refuses a custom token without the folder permissions', async () => {","+      const rqCustom = await createTokenRequest({","+        type: 'custom',","+        permissions: ['plugin::upload.content-api.find'],","+      });","+","+      const list = await rqCustom({ method: 'GET', url: '/upload/folders' });","+      const one = await rqCustom({ method: 'GET', url: `/upload/folders/${folders.acme.id}` });","+","+      expect(list.statusCode).toBe(403);","+      expect(one.statusCode).toBe(403);","+    });","+","+    test('grants listing and reading one folder separately', async () => {","+      const rqFind = await createTokenRequest({","+        type: 'custom',","+        permissions: ['plugin::upload.folder.find'],","+      });","+      const rqFindOne = await createTokenRequest({","+        type: 'custom',","+        permissions: ['plugin::upload.folder.findOne'],","+      });","+      const one = `/upload/folders/${folders.acme.id}`;","+","+      const findList = await rqFind({ method: 'GET', url: '/upload/folders' });","+      const findOne = await rqFind({ method: 'GET', url: one });","+      const findOneList = await rqFindOne({ method: 'GET', url: '/upload/folders' });","+      const findOneOne = await rqFindOne({ method: 'GET', url: one });","+","+      expect(findList.statusCode).toBe(200);","+      expect(findList.body.data.map((folder) => folder.id)).toEqual(","+        expect.arrayContaining([folders.clients.id, folders.acme.id])","+      );","+      expect(findOne.statusCode).toBe(403);","+      expect(findOneList.statusCode).toBe(403);","+      expect(findOneOne.statusCode).toBe(200);","+      expect(findOneOne.body.data.id).toBe(folders.acme.id);","+      // Listing the parent needs `folder.find`, so it is left out rather than shown as the root.","+      expect(findOneOne.body.data).not.toHaveProperty('parent');","+","+      const findOneRoot = await rqFindOne({","+        method: 'GET',","+        url: `/upload/folders/${folders.clients.id}`,","+      });","+      expect(findOneRoot.statusCode).toBe(200);","+      expect(findOneRoot.body.data).not.toHaveProperty('parent');","+    });","+","+    test.each([","+      ['full-access', { filters: { files: { id: 1 } } }],","+      ['full-access', { filters: { children: { files: { name: 'logo.png' } } } }],","+      ['full-access', { filters: { $or: [{ files: { hash: 'logo' } }] } }],","+      ['full-access', { sort: 'files.name:asc' }],","+      ['read-only', { filters: { files: { id: 1 } } }],","+      ['read-only', { sort: { parent: { files: { name: 'asc' } } } }],","+    ])('refuses to find folders through their files with a %s token', async (type, qs) => {","+      const rqToken = await createTokenRequest({ type });","+","+      const res = await rqToken({ method: 'GET', url: '/upload/folders', qs });","+","+      expect(res.statusCode).toBe(400);","+    });","+","+    test('lists folders with a read-only token', async () => {","+      const rqReadOnly = await createTokenRequest({ type: 'read-only' });","+","+      const res = await rqReadOnly({ method: 'GET', url: '/upload/folders' });","+","+      expect(res.statusCode).toBe(200);","+    });","+  });","+","+  describe('GET /upload/folders', () => {","+    test('returns a paginated flat list', async () => {","+      const res = await rq({","+        method: 'GET',","+        url: '/upload/folders',","+        qs: {","+          filters: subtreeOf(folders.clients.path),","+          pagination: { page: 2, pageSize: 2 },","+          sort: 'id:asc',","+        },","+      });","+","+      expect(res.statusCode).toBe(200);","+      expect(res.body.data.map((folder) => folder.id)).toEqual([folders.year.id]);","+      expect(res.body.meta.pagination).toEqual({ page: 2, pageSize: 2, pageCount: 2, total: 3 });","+    });"],"additions":161,"deletions":0,"truncated":false}],"additions":645,"deletions":85,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-11T15:38:44.650606+00:00"}