{"id":"6ec0da294ff6501226a42a222a313938e79d95e0","axis":"silent","repo":"aquasecurity/trivy","sha":"6ec0da294ff6501226a42a222a313938e79d95e0","parsed":{"files":[{"path":"docs/guide/scanner/crypto.md","lines":["@@ -49,7 +49,7 @@ The levels are estimates for an algorithm and its parameters, taken from NIST an"," | Algorithm | Classical security level (bits) | NIST quantum security level |"," | --- | --- | --- |"," | RSA, key size 1024 / 2048 / 3072 / 4096 / 6144 / 8192 bits | 80 / 112 / 128 / 152 / 176 / 200 | 0 |","-| EC, curve P-224 / P-256 / P-384 / P-521 | 112 / 128 / 192 / 256 | 0 |","+| EC, curve P-192 / P-224 / P-256 / P-384 / P-521 | 80 / 112 / 128 / 192 / 256 | 0 |"," | DSA, (L, N) of (1024, 160) / (2048, 224) / (2048, 256) / (3072, 256) | 80 / 112 / 112 / 128 | 0 |"," | Ed25519 / Ed448 | 128 / 224 | 0 |"," | ML-DSA-44 / ML-DSA-65 / ML-DSA-87 | - | 2 / 3 / 5 |","@@ -60,7 +60,7 @@ A dash means that the level is left out of the report."," The levels come from these publications:"," "," - RSA with a key size of 2048 bits and above takes the approximate maximum strengths in Appendix D, Table 4 of [NIST SP 800-56B Rev. 2](https://csrc.nist.gov/pubs/sp/800/56/b/r2/final). RSA with a key size of 1024 bits takes the nominal maximum of 80 from Table 2 of [NIST SP 800-57 Part 1 Rev. 5](https://csrc.nist.gov/pubs/sp/800/57/pt1/r5/final), whose row for a 1024-bit modulus states at most 80 bits.","-- EC takes the ECC strength ranges in Table 2 of NIST SP 800-57 Part 1 Rev. 5.","+- EC takes the ECC strength ranges in Table 2 of NIST SP 800-57 Part 1 Rev. 5. The curve P-192 takes the nominal maximum of 80 from the Table 2 row that states at most 80 bits."," - DSA takes the FFC entries in Table 2 of NIST SP 800-57 Part 1 Rev. 5 and the DSA strengths in Section 3 of [NIST SP 800-131A Rev. 2](https://csrc.nist.gov/pubs/sp/800/131/a/r2/final). The (1024, 160) pair takes the nominal maximum of 80 from the Table 2 row that states at most 80 bits."," - Ed25519 and Ed448 take their strengths from [RFC 8032, Section 8.5](https://datatracker.ietf.org/doc/html/rfc8032#section-8.5)."," - ML-DSA takes its categories from [FIPS 204](https://csrc.nist.gov/pubs/fips/204/final).","@@ -225,6 +225,8 @@ Files larger than 10 MB are skipped, because a file of that size with one of the"," "," Some objects are recognized and skipped. Certificate signing requests, CRLs and PKCS#7 bundles are not part of the inventory. OpenSSH keys, JKS and JCEKS keystores and OpenPGP keyrings are not covered yet. A certificate or key that uses an EC key with explicit curve parameters instead of a named curve cannot be parsed and is skipped as well. Private keys of X25519, X448 and Ed448 are skipped, although their public keys are reported."," ","+From certificates and keys on the curve P-192, only the `EC-P-192` algorithm is extracted.","+"," Trivy does not decrypt PKCS#12 keystores and does not report their private keys, so it reads only the certificates stored without encryption. keytool, OpenSSL and .NET encrypt the certificates unless encryption is turned off explicitly, such as with `-certpbe NONE` in OpenSSL or `-J-Dkeystore.pkcs12.certProtectionAlgorithm=NONE` in keytool. OpenSSL encrypts them even with an empty password. The `cacerts` trust store that ships with JDK 18 and later has no password and is read in full."," "," The `cacerts` of JDK 17 and earlier is a JKS keystore and is skipped. A PKCS#12 keystore protected by a public-key signature instead of a password-based MAC is not read. Parts of a keystore encoded in BER rather than DER are skipped. Trivy reads at most 10000 bags from one keystore."],"additions":4,"deletions":2,"truncated":false},{"path":"integration/testdata/crypto.cdx.json.golden","lines":["@@ -102,6 +102,37 @@","         \"oid\": \"1.2.840.10040.4.3\"","       }","     },","+    {","+      \"bom-ref\": \"crypto:algorithm:oid:1.2.840.10045.2.1:curve%3DP-192\",","+      \"type\": \"cryptographic-asset\",","+      \"name\": \"EC-P-192\",","+      \"evidence\": {","+        \"occurrences\": [","+          {","+            \"location\": \"etc/ssl/certs/p192.pem\",","+            \"additionalContext\": \"aquasecurity:trivy:LayerDiffID=sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","+          },","+          {","+            \"location\": \"etc/ssl/private/p192.key\",","+            \"additionalContext\": \"aquasecurity:trivy:LayerDiffID=sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","+          },","+          {","+            \"location\": \"etc/ssl/public/p192.pem\",","+            \"additionalContext\": \"aquasecurity:trivy:LayerDiffID=sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","+          }","+        ]","+      },","+      \"cryptoProperties\": {","+        \"assetType\": \"algorithm\",","+        \"algorithmProperties\": {","+          \"primitive\": \"unknown\",","+          \"ellipticCurve\": \"nist/P-192\",","+          \"classicalSecurityLevel\": 80,","+          \"nistQuantumSecurityLevel\": 0","+        },","+        \"oid\": \"1.2.840.10045.2.1\"","+      }","+    },","     {","       \"bom-ref\": \"crypto:algorithm:oid:1.2.840.10045.2.1:curve%3DP-256\",","       \"type\": \"cryptographic-asset\",","@@ -1773,6 +1804,10 @@","       \"ref\": \"crypto:algorithm:oid:1.2.840.10040.4.3\",","       \"dependsOn\": []","     },","+    {","+      \"ref\": \"crypto:algorithm:oid:1.2.840.10045.2.1:curve%3DP-192\",","+      \"dependsOn\": []","+    },","     {","       \"ref\": \"crypto:algorithm:oid:1.2.840.10045.2.1:curve%3DP-256\",","       \"dependsOn\": []"],"additions":35,"deletions":0,"truncated":false},{"path":"integration/testdata/crypto.json.golden","lines":["@@ -107,6 +107,66 @@","             \"DiffID\": \"sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","           }","         },","+        {","+          \"AssetID\": \"b8ababf0115fb157\",","+          \"Kind\": \"algorithm\",","+          \"Identity\": {","+            \"Method\": \"oid\",","+            \"Value\": \"1.2.840.10045.2.1\",","+            \"Parameters\": \"curve=P-192\"","+          },","+          \"Name\": \"EC-P-192\",","+          \"Algorithm\": {","+            \"Primitive\": \"unknown\",","+            \"ClassicalSecurityLevel\": 80,","+            \"NISTQuantumSecurityLevel\": 0","+          },","+          \"FilePath\": \"etc/ssl/certs/p192.pem\",","+          \"Layer\": {","+            \"Digest\": \"sha256:e7d05081011beef8ab3c013bab7b9110aaa546f789473ec203c5a88b56800fc3\",","+            \"DiffID\": \"sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","+          }","+        },","+        {","+          \"AssetID\": \"ba912ff4a9c6b357\",","+          \"Kind\": \"algorithm\",","+          \"Identity\": {","+            \"Method\": \"oid\",","+            \"Value\": \"1.2.840.10045.2.1\",","+            \"Parameters\": \"curve=P-192\"","+          },","+          \"Name\": \"EC-P-192\",","+          \"Algorithm\": {","+            \"Primitive\": \"unknown\",","+            \"ClassicalSecurityLevel\": 80,","+            \"NISTQuantumSecurityLevel\": 0","+          },","+          \"FilePath\": \"etc/ssl/private/p192.key\",","+          \"Layer\": {","+            \"Digest\": \"sha256:e7d05081011beef8ab3c013bab7b9110aaa546f789473ec203c5a88b56800fc3\",","+            \"DiffID\": \"sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","+          }","+        },","+        {","+          \"AssetID\": \"362831e38706a08f\",","+          \"Kind\": \"algorithm\",","+          \"Identity\": {","+            \"Method\": \"oid\",","+            \"Value\": \"1.2.840.10045.2.1\",","+            \"Parameters\": \"curve=P-192\"","+          },","+          \"Name\": \"EC-P-192\",","+          \"Algorithm\": {","+            \"Primitive\": \"unknown\",","+            \"ClassicalSecurityLevel\": 80,","+            \"NISTQuantumSecurityLevel\": 0","+          },","+          \"FilePath\": \"etc/ssl/public/p192.pem\",","+          \"Layer\": {","+            \"Digest\": \"sha256:e7d05081011beef8ab3c013bab7b9110aaa546f789473ec203c5a88b56800fc3\",","+            \"DiffID\": \"sha256:8be4950119af3d5904781c15c5ba7e01951daf465a3567077b031a9c58d5275f\"","+          }","+        },","         {","           \"AssetID\": \"10bb9f843a9330d1\",","           \"Kind\": \"algorithm\",","@@ -2409,6 +2469,16 @@","             \"SignatureAlgorithmOID\": \"1.2.840.10045.4.1\"","           }","         },","+        {","+          \"RuleID\": \"CRYPTO-0003\",","+          \"Title\": \"Weak elliptic curve\",","+          \"Severity\": \"HIGH\",","+          \"AssetID\": \"b8ababf0115fb157\",","+          \"Evidence\": {","+            \"Curve\": \"P-192\",","+            \"ClassicalSecurityLevel\": 80","+          }","+        },","         {","           \"RuleID\": \"CRYPTO-0001\",","           \"Title\": \"SHA-1 certificate signature\",","@@ -2446,6 +2516,16 @@","             \"NotAfter\": \"2020-01-01T00:00:00Z\"","           }","         },","+        {","+          \"RuleID\": \"CRYPTO-0003\",","+          \"Title\": \"Weak elliptic curve\",","+          \"Severity\": \"HIGH\",","+          \"AssetID\": \"ba912ff4a9c6b357\",","+          \"Evidence\": {","+            \"Curve\": \"P-192\",","+            \"ClassicalSecurityLevel\": 80","+          }","+        },","         {","           \"RuleID\": \"CRYPTO-0002\",","           \"Title\": \"Small RSA key\",","@@ -2455,6 +2535,16 @@","             \"KeySize\": 1024","           }","         },","+        {","+          \"RuleID\": \"CRYPTO-0003\",","+          \"Title\": \"Weak elliptic curve\",","+          \"Severity\": \"HIGH\",","+          \"AssetID\": \"362831e38706a08f\",","+          \"Evidence\": {","+            \"Curve\": \"P-192\",","+            \"ClassicalSecurityLevel\": 80","+          }","+        },","         {","           \"RuleID\": \"CRYPTO-0001\",","           \"Title\": \"SHA-1 certificate signature\","],"additions":90,"deletions":0,"truncated":false},{"path":"pkg/crypto/check/check_test.go","lines":["@@ -203,13 +203,13 @@ func TestEvaluate(t *testing.T) {"," \t\t},"," \t\t{"," \t\t\tname:   \"EC strength below 112 bits\",","-\t\t\tassets: []ftypes.CryptoAsset{algorithm(\"key.pem\", oidECPublicKey, \"curve=P-192\", new(96))},","+\t\t\tassets: []ftypes.CryptoAsset{algorithm(\"key.pem\", oidECPublicKey, \"curve=P-192\", new(80))},"," \t\t\twant: []types.CryptoFinding{"," \t\t\t\tfinding(\"CRYPTO-0003\", \"Weak elliptic curve\", \"HIGH\",","-\t\t\t\t\talgorithm(\"key.pem\", oidECPublicKey, \"curve=P-192\", new(96)),","+\t\t\t\t\talgorithm(\"key.pem\", oidECPublicKey, \"curve=P-192\", new(80)),"," \t\t\t\t\ttypes.CryptoEvidence{"," \t\t\t\t\t\tCurve:                  \"P-192\",","-\t\t\t\t\t\tClassicalSecurityLevel: new(96),","+\t\t\t\t\t\tClassicalSecurityLevel: new(80),"," \t\t\t\t\t}),"," \t\t\t},"," \t\t},"],"additions":3,"deletions":3,"truncated":false},{"path":"pkg/crypto/parser/x509/asset.go","lines":["@@ -26,6 +26,10 @@ func objectToAssets(obj object) ([]ftypes.CryptoAsset, error) {"," \t\treturn describeStandaloneKey(obj, ftypes.CryptoKeyTypePrivate)"," \tcase objectEncryptedPrivateKey:"," \t\treturn describeEncryptedPrivateKey(obj)","+\tcase objectECAlgorithm:","+\t\talgorithm := crypto.DescribeAlgorithm(oidECPublicKey.String(), 0, 0, obj.curve)","+\t\t// An algorithm has no format or encoding.","+\t\treturn []ftypes.CryptoAsset{{CryptoAssetInfo: algorithm}}, nil"," \tdefault:"," \t\treturn nil, xerrors.Errorf(\"object kind %d has no description\", obj.kind)"," \t}","@@ -126,7 +130,7 @@ func describeStandaloneKey(obj object, keyType ftypes.CryptoKeyType) ([]ftypes.C"," \t\t\tFormat:          obj.keyFormat,"," \t\t\tEncoding:        obj.encoding,"," \t\t},","-\t\t// The algorithm is derived and has no encoded form.","+\t\t// An algorithm has no format or encoding."," \t\t{CryptoAssetInfo: keyAlgorithm},"," \t}, nil"," }"],"additions":5,"deletions":1,"truncated":false},{"path":"pkg/crypto/parser/x509/export_test.go","lines":["@@ -14,5 +14,14 @@ type PKCS1AdditionalPrime = pkcs1AdditionalPrime"," // PKCS8PrivateKey exports pkcs8PrivateKey for testing."," type PKCS8PrivateKey = pkcs8PrivateKey"," ","+// ECPrivateKey exports ecPrivateKey for testing.","+type ECPrivateKey = ecPrivateKey","+"," // OIDRSAEncryption exports oidRSAEncryption for testing."," var OIDRSAEncryption = oidRSAEncryption","+","+// OIDECPublicKey exports oidECPublicKey for testing.","+var OIDECPublicKey = oidECPublicKey","+","+// OIDNamedCurveP192 exports oidNamedCurveP192 for testing.","+var OIDNamedCurveP192 = oidNamedCurveP192"],"additions":9,"deletions":0,"truncated":false},{"path":"pkg/crypto/parser/x509/parser.go","lines":["@@ -35,6 +35,9 @@ const ("," \tobjectPublicKey"," \t// objectEncryptedPrivateKey identifies an opaque encrypted private key."," \tobjectEncryptedPrivateKey","+\t// objectECAlgorithm identifies a certificate or key on an EC curve crypto/x509 does","+\t// not support. Only its algorithm is read.","+\tobjectECAlgorithm"," )"," "," // encryptionFormat identifies the container format of an encrypted private key.","@@ -69,6 +72,8 @@ type object struct {"," \tencrypted []byte"," \t// encryption identifies the encrypted private-key container format."," \tencryption encryptionFormat","+\t// curve names the curve of objectECAlgorithm.","+\tcurve string"," \t// encoding identifies the source encoding."," \tencoding ftypes.CryptoEncoding"," \t// keystore identifies the keystore the object is stored in.","@@ -107,8 +112,48 @@ type pkcs8PrivateKey struct {"," \tPrivateKey []byte"," }"," ","+// ecPrivateKey is an EC private key in SEC 1, as defined in RFC 5915.","+type ecPrivateKey struct {","+\tVersion       int","+\tPrivateKey    []byte","+\tNamedCurveOID asn1.ObjectIdentifier `asn1:\"optional,explicit,tag:0\"`","+\tPublicKey     asn1.BitString        `asn1:\"optional,explicit,tag:1\"`","+}","+","+// rawCertificate is an X.509 certificate without the TBSCertificate fields after","+// SubjectPublicKeyInfo. Only SubjectPublicKeyInfo is read. The other fields are not checked","+// and stand in their places, so that a certificate without a signature fails to parse.","+type rawCertificate struct {","+\tTBSCertificate struct {","+\t\tVersion              int `asn1:\"optional,explicit,default:0,tag:0\"`","+\t\tSerialNumber         asn1.RawValue","+\t\tSignature            asn1.RawValue","+\t\tIssuer               asn1.RawValue","+\t\tValidity             asn1.RawValue","+\t\tSubject              asn1.RawValue","+\t\tSubjectPublicKeyInfo asn1.RawValue","+\t}","+\tSignatureAlgorithm asn1.RawValue","+\tSignatureValue     asn1.BitString","+}","+"," var oidRSAEncryption = asn1.ObjectIdentifier{1, 2, 840, 113549, 1, 1, 1}"," ","+// oidECPublicKey identifies an EC public key, defined by RFC 5480 section 2.1.1.","+// See https://www.rfc-editor.org/rfc/rfc5480#section-2.1.1","+var oidECPublicKey = asn1.ObjectIdentifier{1, 2, 840, 10045, 2, 1}","+","+// oidNamedCurveP192 identifies the curve P-192, which RFC 5480 section 2.1.1.1 names secp192r1.","+// See https://www.rfc-editor.org/rfc/rfc5480#section-2.1.1.1","+var oidNamedCurveP192 = asn1.ObjectIdentifier{1, 2, 840, 10045, 3, 1, 1}","+","+// p192Size is the length in bytes of a P-192 field element and of a P-192 private key.","+const p192Size = 24","+","+// p192Order is the order of the base point of P-192, given in SEC 2 section 2.2.2.","+// See https://www.secg.org/sec2-v2.pdf","+var p192Order, _ = new(big.Int).SetString(\"FFFFFFFFFFFFFFFFFFFFFFFF99DEF836146BC9B1B4D22831\", 16)","+"," var ("," \terrNotCryptographic  = errors.New(\"not cryptographic\")"," \terrUnsupportedCrypto = errors.New(\"unsupported cryptographic object\")","@@ -289,7 +334,7 @@ func parsePEMObject(label string, der []byte) (object, error) {"," \tcase \"RSA PRIVATE KEY\":"," \t\treturn rsaPrivateKeyObject(der, ftypes.CryptoKeyFormatPKCS1)"," \tcase \"EC PRIVATE KEY\":","-\t\treturn privateKeyObject(der, ftypes.CryptoKeyFormatSEC1, stdx509.ParseECPrivateKey)","+\t\treturn ecPrivateKeyObject(der)"," \tcase \"PUBLIC KEY\":"," \t\treturn publicKeyObject(der)"," \tcase \"ENCRYPTED PRIVATE KEY\":","@@ -332,14 +377,122 @@ func privateKeyObject[K any](der []byte, format ftypes.CryptoKeyFormat, parseKey"," }"," "," // pkcs8PrivateKeyObject parses a private key in PKCS#8 and projects it to its public key.","+// A key on P-192 is described by its algorithm alone."," func pkcs8PrivateKeyObject(der []byte) (object, error) {"," \tvar key pkcs8PrivateKey","-\tif _, err := asn1.Unmarshal(der, &key); err == nil && key.Algo.Algorithm.Equal(oidRSAEncryption) {","-\t\treturn rsaPrivateKeyObject(key.PrivateKey, ftypes.CryptoKeyFormatPKCS8)","+\tif _, err := asn1.Unmarshal(der, &key); err == nil {","+\t\tswitch {","+\t\tcase key.Algo.Algorithm.Equal(oidRSAEncryption):","+\t\t\treturn rsaPrivateKeyObject(key.PrivateKey, ftypes.CryptoKeyFormatPKCS8)","+\t\tcase key.Algo.Algorithm.Equal(oidECPublicKey) && isP192(key.Algo.Parameters.FullBytes):","+\t\t\t// The curve is stored in the outer AlgorithmIdentifier, so the key may omit it.","+\t\t\tif _, ok := parseP192PrivateKey(key.PrivateKey); !ok {","+\t\t\t\treturn object{}, errMalformedCrypto","+\t\t\t}","+\t\t\treturn p192AlgorithmObject(), nil","+\t\t}"," \t}"," \treturn privateKeyObject(der, ftypes.CryptoKeyFormatPKCS8, stdx509.ParsePKCS8PrivateKey)"," }"," ","+// ecPrivateKeyObject parses an EC private key in SEC 1 and projects it to its public key.","+// A key on P-192 is described by its algorithm alone.","+func ecPrivateKeyObject(der []byte) (object, error) {","+\tobj, err := privateKeyObject(der, ftypes.CryptoKeyFormatSEC1, stdx509.ParseECPrivateKey)","+\tif !errors.Is(err, errMalformedCrypto) {","+\t\treturn obj, err","+\t}","+\t// Bare SEC 1 must name the curve.","+\tif key, ok := parseP192PrivateKey(der); ok && key.NamedCurveOID != nil {","+\t\treturn p192AlgorithmObject(), nil","+\t}","+\treturn object{}, errMalformedCrypto","+}","+","+// parseP192PrivateKey parses a SEC 1 EC private key and reports whether it can be a P-192 key.","+// The key must name P-192 or no curve, and be a valid scalar of at most 24 bytes. A key","+// without a curve is accepted, because PKCS#8 names the curve in the algorithm identifier.","+func parseP192PrivateKey(der []byte) (ecPrivateKey, bool) {","+\tvar key ecPrivateKey","+\trest, err := asn1.Unmarshal(der, &key)","+\tif err != nil || len(rest) > 0 || key.Version != 1 {","+\t\treturn ecPrivateKey{}, false","+\t}","+\tif key.NamedCurveOID != nil && !key.NamedCurveOID.Equal(oidNamedCurveP192) {","+\t\treturn ecPrivateKey{}, false","+\t}","+\tif len(key.PrivateKey) == 0 || len(key.PrivateKey) > p192Size {","+\t\treturn ecPrivateKey{}, false","+\t}","+\tif d := new(big.Int).SetBytes(key.PrivateKey); d.Sign() == 0 || d.Cmp(p192Order) >= 0 {","+\t\treturn ecPrivateKey{}, false","+\t}","+\treturn key, true","+}","+","+// isP192Certificate reports whether der is a certificate with a P-192 key, which crypto/x509","+// rejects.","+func isP192Certificate(der []byte) bool {","+\tvar cert rawCertificate","+\trest, err := asn1.Unmarshal(der, &cert)","+\tif err != nil || len(rest) > 0 {","+\t\treturn false","+\t}","+\treturn isP192PublicKey(cert.TBSCertificate.SubjectPublicKeyInfo.FullBytes)","+}","+","+// isP192PublicKey reports whether spki is a P-192 public key in SubjectPublicKeyInfo, which","+// crypto/x509 does not decode.","+func isP192PublicKey(spki []byte) bool {","+\tvar info struct {","+\t\tAlgorithm        pkix.AlgorithmIdentifier","+\t\tSubjectPublicKey asn1.BitString","+\t}","+\trest, err := asn1.Unmarshal(spki, &info)","+\tif err != nil || len(rest) > 0 {","+\t\treturn false","+\t}","+\tif !info.Algorithm.Algorithm.Equal(oidECPublicKey) || !isP192(info.Algorithm.Parameters.FullBytes) {","+\t\treturn false","+\t}","+\treturn isP192Point(info.SubjectPublicKey)","+}","+","+// isP192 reports whether the parameters of an EC algorithm identifier name the curve P-192.","+func isP192(parameters []byte) bool {","+\tvar curve asn1.ObjectIdentifier","+\trest, err := asn1.Unmarshal(parameters, &curve)","+\treturn err == nil && len(rest) == 0 && curve.Equal(oidNamedCurveP192)","+}","+","+// isP192Point reports whether point has the length and the leading byte of a P-192 point","+// in the uncompressed or the compressed form of SEC 1 section 2.3.3. RFC 5480 allows both","+// forms, so the compressed one is accepted although crypto/x509 reads only the uncompressed","+// one for the other curves. Whether the point lies on the curve is not checked.","+// See https://www.secg.org/sec1-v2.pdf","+func isP192Point(point asn1.BitString) bool {","+\tb := point.RightAlign()","+\tif point.BitLength%8 != 0 || len(b) == 0 {","+\t\treturn false","+\t}","+\tswitch b[0] {","+\tcase 4:","+\t\treturn len(b) == 1+2*p192Size","+\tcase 2, 3:","+\t\treturn len(b) == 1+p192Size","+\t}","+\treturn false","+}","+","+// p192AlgorithmObject is the object of a certificate or key on P-192, which is described by","+// its algorithm alone.","+func p192AlgorithmObject() object {","+\treturn object{","+\t\tkind:  objectECAlgorithm,","+\t\tcurve: \"P-192\",","+\t}","+}","+"," // rsaPrivateKeyObject reads an RSA private key in PKCS#1 and projects it to its public key."," // It checks the structure of the key but not its math, because crypto/x509 validates a key"," // with arithmetic whose cost grows with the size of its values, and a crafted key picks","@@ -390,8 +543,8 @@ func parseDERObject(der []byte) (object, error) {"," \t\treturn obj, err"," \t}"," ","-\tif privateKey, err := stdx509.ParseECPrivateKey(der); err == nil {","-\t\treturn privateKeyToObject(privateKey, ftypes.CryptoKeyFormatSEC1)","+\tif obj, err := ecPrivateKeyObject(der); !errors.Is(err, errMalformedCrypto) {","+\t\treturn obj, err"," \t}"," "," \tif obj, err := publicKeyObject(der); err == nil {","@@ -425,6 +578,9 @@ func parseDEROb