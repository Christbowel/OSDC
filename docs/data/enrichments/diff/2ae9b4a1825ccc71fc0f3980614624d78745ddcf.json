TO_LEFT","-\t\t);","-\t\twithoutSeparatorMod11Validator2.initialize(","-\t\t\t\t0, 9, 10, true, Integer.MAX_VALUE, '0', '0', Mod11Check.ProcessingDirection.RIGHT_TO_LEFT","-\t\t);","-\t}"," "," \t@Override"," \tpublic boolean isValid(CharSequence value, ConstraintValidatorContext context) {","@@ -54,13 +20,61 @@ public boolean isValid(CharSequence value, ConstraintValidatorContext context) {"," \t\t\treturn true;"," \t\t}"," ","-\t\tif ( DIGITS_ONLY.matcher( value ).matches() ) {","-\t\t\treturn withoutSeparatorMod11Validator1.isValid( value, context )","-\t\t\t\t\t&& withoutSeparatorMod11Validator2.isValid( value, context );","+\t\tint length = value.length();","+\t\tif ( length != 11 && length != 14 ) {","+\t\t\treturn false;"," \t\t}","-\t\telse {","-\t\t\treturn withSeparatorMod11Validator1.isValid( value, context )","-\t\t\t\t\t&& withSeparatorMod11Validator2.isValid( value, context );","+","+\t\t// The two check digits use weights 10..2 and 11..2, respectively.","+\t\tint firstSum = 0;","+\t\tint secondSum = 0;","+\t\tint digitIndex = 0;","+\t\tchar firstDigit = value.charAt( 0 );","+\t\tboolean allDigitsEqual = true;","+\t\tfor ( int i = 0; i < length; i++ ) {","+\t\t\tchar character = value.charAt( i );","+\t\t\tif ( length == 14 ) {","+\t\t\t\tif ( i == 3 || i == 7 ) {","+\t\t\t\t\tif ( character != '.' ) {","+\t\t\t\t\t\treturn false;","+\t\t\t\t\t}","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+\t\t\t\tif ( i == 11 ) {","+\t\t\t\t\tif ( character != '-' ) {","+\t\t\t\t\t\treturn false;","+\t\t\t\t\t}","+\t\t\t\t\tcontinue;","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tif ( character < '0' || character > '9' ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tallDigitsEqual &= character == firstDigit;","+\t\t\tint digit = character - '0';","+\t\t\tif ( digitIndex < 9 ) {","+\t\t\t\tfirstSum += digit * ( 10 - digitIndex );","+\t\t\t\tsecondSum += digit * ( 11 - digitIndex );","+\t\t\t}","+\t\t\telse if ( digitIndex == 9 ) {","+\t\t\t\tif ( digit != checkDigit( firstSum ) ) {","+\t\t\t\t\treturn false;","+\t\t\t\t}","+\t\t\t\tsecondSum += digit * 2;","+\t\t\t}","+\t\t\telse if ( digit != checkDigit( secondSum ) ) {","+\t\t\t\treturn false;","+\t\t\t}","+\t\t\tdigitIndex++;"," \t\t}","+","+\t\treturn !allDigitsEqual;","+\t}","+","+\tprivate static int checkDigit(int sum) {","+\t\t// Remainders zero and one both map to a zero check digit.","+\t\tint remainder = sum % 11;","+\t\treturn remainder < 2 ? 0 : 11 - remainder;"," \t}"," }"],"additions":54,"deletions":40,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/metadata/core/BuiltinConstraint.java","lines":["@@ -87,8 +87,7 @@ enum BuiltinConstraint {"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_AR_CUIT( \"org.hibernate.validator.constraints.ar.CUIT\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_BR_CNPJ( \"org.hibernate.validator.constraints.br.CNPJ\","," \t\t\tArrays.asList( JAKARTA_VALIDATION_CONSTRAINTS_PATTERN ) ),","-\tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_BR_CPF( \"org.hibernate.validator.constraints.br.CPF\",","-\t\t\tArrays.asList( JAKARTA_VALIDATION_CONSTRAINTS_PATTERN ) ),","+\tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_BR_CPF( \"org.hibernate.validator.constraints.br.CPF\" ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_BR_RENAVAM( \"org.hibernate.validator.constraints.br.RENAVAM\","," \t\t\tArrays.asList( JAKARTA_VALIDATION_CONSTRAINTS_PATTERN, ORG_HIBERNATE_VALIDATOR_CONSTRAINTS_MOD11_CHECK ) ),"," \tORG_HIBERNATE_VALIDATOR_CONSTRAINTS_BR_TITULO_ELEITORAL( \"org.hibernate.validator.constraints.br.TituloEleitoral\","],"additions":1,"deletions":2,"truncated":false},{"path":"engine/src/test/java/org/hibernate/validator/test/constraints/annotations/hv/br/CPFValidatorTest.java","lines":["@@ -7,15 +7,21 @@"," import static org.hibernate.validator.testutil.ConstraintViolationAssert.assertNoViolations;"," import static org.hibernate.validator.testutil.ConstraintViolationAssert.assertThat;"," import static org.hibernate.validator.testutil.ConstraintViolationAssert.violatio