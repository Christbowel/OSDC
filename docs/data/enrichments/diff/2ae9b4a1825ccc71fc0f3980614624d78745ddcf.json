ngleViolation;","-import jakarta.validation.constraints.Pattern;"," "," import org.hibernate.validator.constraints.br.CPF.List;"," "," /**","  * Validates a CPF (Cadastro de Pessoa F\\u00edsica - Brazilian individual taxpayer registry number).","+ * <p>","+ * Accepts either eleven ASCII digits or the format {@code ddd.ddd.ddd-dd}. Numbers consisting of a single","+ * repeated digit are invalid.","+ * <p>","+ * The supported type is {@code CharSequence}. {@code null} is considered valid.","  *","  * @author George Gastaldi","  * @author Victor Rezende dos Santos","  */","-@Pattern.List({","-\t\t@Pattern(regexp = \"([0-9]{3}\\\\.[0-9]{3}\\\\.[0-9]{3}-[0-9]{2})|([0-9]{11})\"),","-\t\t// XXX.XXX.XXX-XX where X is always the same digit are not a valid CPFs, but all of them passes the mod check. Needs to be singled out each one via regexp","-\t\t@Pattern(regexp = \"^(?:(?!000\\\\.?000\\\\.?000-?00).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!111\\\\.?111\\\\.?111-?11).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!222\\\\.?222\\\\.?222-?22).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!333\\\\.?333\\\\.?333-?33).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!444\\\\.?444\\\\.?444-?44).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!555\\\\.?555\\\\.?555-?55).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!666\\\\.?666\\\\.?666-?66).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!777\\\\.?777\\\\.?777-?77).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!888\\\\.?888\\\\.?888-?88).)*$\"),","-\t\t@Pattern(regexp = \"^(?:(?!999\\\\.?999\\\\.?999-?99).)*$\")","-})","-@ReportAsSingleViolation"," @Documented"," @Constraint(validatedBy = { })"," @Target({ METHOD, FIELD, ANNOTATION_TYPE, CONSTRUCTOR, PARAMETER, TYPE_USE })"],"additions":5,"deletions":17,"truncated":false},{"path":"engine/src/main/java/org/hibernate/validator/internal/constraintvalidators/hv/br/CPFValidator.java","lines":["@@ -4,49 +4,15 @@","  */"," package org.hibernate.validator.internal.constraintvalidators.hv.br;"," ","-import java.util.regex.Patter