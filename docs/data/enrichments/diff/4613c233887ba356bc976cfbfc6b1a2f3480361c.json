w DashboardWidgetContentRenderedEvent(widget));","       // Legacy event, kept for compatibility reasons","       this.dispatchEvent(new CustomEvent('widgetContentRendered', { bubbles: true, detail: this.widget.eventdata }));","+      this.restorePaginationFocus();","     }","   }"," ","@@ -1286,6 +1289,7 @@ export class DashboardWidget extends LitElement {","         </div>","       </div>","       <div class=\"widget-content\"","+        @click=${this.handlePaginationClick}","         @pointerenter=${(e: PointerEvent) => (e.target as HTMLElement).closest('.dashboard-item').removeAttribute('draggable')}","         @pointerleave=${(e: PointerEvent) => (e.target as HTMLElement).closest('.dashboard-item').setAttribute('draggable', 'true')}","         >${widgetContent(widget)}</div>","@@ -1304,6 +1308,32 @@ export class DashboardWidget extends LitElement {","     return html`<div class=\"widget ${this.moving ? ' widget-selected' : ''}\">${content}</div>`;","   }"," ","+  private restorePaginationFocus(): void {","+    const direction = this.paginationFocusDirection;","+    this.paginationFocusDirection = null;","+    if (direction === null) {","+      return;","+    }","+    const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('.widget-pagination [data-widget-pagination-direction]'));","+    const target = buttons.find(button => button.dataset.widgetPaginationDirection === direction && !button.disabled)","+      ?? buttons.find(button => !button.disabled);","+    target?.focus();","+  }","+","+  private handlePaginationClick(event: Event): void {","+    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.widget-pagination [data-widget-page]');","+    if (button === null || button.disabled) {","+      return;","+    }","+    const page = parseInt(button.dataset.widgetPage, 10);","+    if (isNaN(page) || page < 1) {","+      return;","+    }","+    event.preventDefault();","+    this.paginationFocusDirection = button.dataset.widgetPaginationDirection ?? null;","+    this.page = page;","+  }","+","   private moveStart(): void {","     if (this.moving === false) {","       this.moving = true;","@@ -1431,7 +1461,11 @@ export class DashboardWidget extends LitElement {","               });","             const data = await response.resolve();","             if (data.status === 'ok') {","-              this.handleRefresh();","+              if (this.page !== 1) {","+                this.page = 1;","+              } else {","+                this.handleRefresh();","+              }","               currentModal.hideModal();","             } else if (data.status === 'info') {","               Notification.info('', data.message);"],"additions":38,"deletions":4,"truncated":false},{"path":"Build/tests/playwright/e2e/dashboard/dashboard-module.spec.ts","lines":["@@ -77,6 +77,53 @@ test('Create, rename and delete dashboard',async ({ backend }) => {","   await expect(backend.contentFrame.locator('.dashboard-tab--active', { hasText: titleAfterRename })).not.toBeVisible();"," });"," ","+test('Browse pages of a paginated widget', async ({ backend }) => {","+  const contentFrame = backend.contentFrame;","+  const title = 'Pagination Dashboard';","+","+  await createDashboard(backend, title);","+  const addWidget = contentFrame.locator('.dashboard-add-item .btn-dashboard-add-widget').first();","+  const widgetModalContent = await backend.modal.open(addWidget);","+  await widgetModalContent.locator('[data-identifier=\"systemInfo\"]').click();","+  await widgetModalContent.locator('[data-identifier=\"latestBeLogins\"]').click();","+","+  const widget = contentFrame.locator('[data-widget-key=\"latestBeLogins\"]');","+  await setLoginsPerPage(backend, widget, 1);","+","+  const status = widget.locator('.widget-pagination-status');","+  const previous = widget.locator('[data-widget-pagination-direction=\"previous\"]');","+  const next = widget.locator('[data-widget-pagination-direction=\"next\"]');","+  await expect(status).toHaveText(/Page 1 of \\d+/);","+  await expect(previous).toBeDisabled();","+","+  await next.click();","+  await expect(status).toHaveText(/Page 2 of \\d+/);","+  await expect(previous).toBeEnabled();","+  await expect(next).toBeFocused();","+","+  // The previous button is disabled on the first page, the focus moves to the next button","+  await previous.click();","+  await expect(status).toHaveText(/Page 1 of \\d+/);","+  await expect(next).toBeFocused();","+","+  // Changing the settings starts over on the first page","+  await next.click();","+  await expect(status).toHaveText(/Page 2 of \\d+/);","+  await setLoginsPerPage(backend, widget, 2);","+  await expect(status).toHaveText(/Page 1 of \\d+/);","+","+  const deleteModal = await open(backend, 'actions-delete');","+  await backend.modal.click({ name: 'delete' });","+  await expect(deleteModal).not.toBeVisible();","+});","+","+async function setLoginsPerPage(backend: BackendPage, widget: Locator, limit: number): Promise<void> {","+  const settingsModal = await backend.modal.open(widget.locator('.widget-action-settings'));","+  await settingsModal.locator('input[type=\"number\"]').fill(String(limit));","+  await backend.modal.click({ name: 'save' });","+  await expect(backend.modal.element).toBeHidden();","+}","+"," function widgetTitle(contentFrame: FrameLocator, key: string): Locator {","   return contentFrame.locator(`[data-widget-key=\"${key}\"] .widget-title`);"," }"],"additions":47,"deletions":0,"truncated":false},{"path":"Build/tests/playwright/fixtures/BackendEnvironment.csv","lines":["@@ -83,3 +83,8 @@"," ,48,1,\"Dummy 1-48\",1,0,0,0"," ,49,1,\"Dummy 1-49\",1,0,0,0"," ,50,1,\"Dummy 1-50\",1,0,0,0","+\"sys_log\"","+,\"uid\",\"tstamp\",\"userid\",\"type\",\"action\",\"details\"","+,100001,1452944920,2,255,1,\"User %s logged in from ###IP###\"","+,100002,1452944930,3,255,1,\"User %s logged in from ###IP###\"","+,100003,1452944940,2,255,1,\"User %s logged in from ###IP###\""],"additions":5,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Feature-101534-PaginationForDashboardListWidgets.rst","lines":["@@ -0,0 +1,68 @@","+..  include:: /Includes.rst.txt","+","+..  _feature-101534-1790839494:","+","+========================================================","+Feature: #101534 - Pagination for dashboard list widgets","+========================================================","+","+See :issue:`101534`","+","+Description","+===========","+","+The dashboard :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\ListWidget` can now","+render a paginator in its footer. Widgets that list a series of records are","+typically limited to a few rows for space reasons - with pagination, editors","+can browse through all of them without leaving the dashboard.","+","+To enable pagination, the data provider of the list widget implements the new","+interface :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\PaginatedListDataProviderInterface`","+instead of :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\ListDataProviderInterface`:","+","+..  code-block:: php","+","+    use TYPO3\\CMS\\Core\\Pagination\\ArrayPaginator;","+    use TYPO3\\CMS\\Core\\Pagination\\PaginatorInterface;","+    use TYPO3\\CMS\\Dashboard\\Widgets\\PaginatedListDataProviderInterface;","+","+    final readonly class MyListDataProvider implements PaginatedListDataProviderInterface","+    {","+        public function getPaginator(int $currentPage, int $itemsPerPage): PaginatorInterface","+        {","+            return new ArrayPaginator($this->fetchItems(), $currentPage, $itemsPerPage);","+        }","+    }","+","+Any implementation of :php:`\\TYPO3\\CMS\\Core\\Pagination\\PaginatorInterface`","+can be returned, for example the","+:php:`\\TYPO3\\CMS\\Core\\Pagination\\QueryBuilderPaginator`, which only fetches","+the rows of the requested page from the database.","+","+The number of items per page is not defined by the data provider, but by the","+widget: backend users can change it in the settings of each widget instance","+(default: 10). Integrators can set the new option :yaml:`itemsPerPage` in the","+widget registration to change the default, which also locks the setting for","+editors.","+","+The widget displays compact \"previous\" and \"next\" buttons together with the","+current page number if there is more than one page. Switching pages reloads","+only the widget content via the existing AJAX route :php:`dashboard_widget_get`,","+which now accepts an additional :php:`page` query argument. Custom widgets","+implementing :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\WidgetRendererInterface` can","+read the argument from the request in their widget context and reuse the","+Fluid partial :html:`Widget/Pagination`.","+","+The \"Latest backend logins\" widget is the first widget making use of the","+pagination. Its existing :php:`limit` setting now defines how many logins are","+shown at once, and editors can browse through the older logins.","+","+Impact","+======","+","+List widgets can offer more than the first few items without additional","+dashboard space. Existing data providers implementing","+:php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\ListDataProviderInterface` continue to","+work unchanged.","+","+..  index:: Backend, PHP-API, ext:dashboard"],"additions":68,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Widgets/LatestBeLoginsWidget.php","lines":["@@ -19,6 +19,7 @@"," "," use TYPO3\\CMS\\Backend\\View\\BackendViewFactory;"," use TYPO3\\CMS\\Core\\Localization\\LanguageService;","+use TYPO3\\CMS\\Core\\Pagination\\SimplePagination;"," use TYPO3\\CMS\\Core\\Settings\\SettingDefinition;"," use TYPO3\\CMS\\Dashboard\\Widgets\\Provider\\LatestBeLoginsDataProvider;"," ","@@ -30,7 +31,7 @@","  * - login time","  *","  * The following options are available during registration:","- * - limit `int` number of logins to display","+ * - limit `int` number of logins to display at once, further logins are available via pagination","  */"," readonly class LatestBeLoginsWidget implements WidgetRendererInterface, AdminOnlyWidgetInterface"," {","@@ -59,12 +60,14 @@ public function getSettingsDefinitions(): array"," ","     public function renderWidget(WidgetContext $context): WidgetResult","     {","-        $limit = $context->settings->get('limit');","-        $items = $this->dataProvider->getItems($limit);","+        $currentPage = max(1, (int)($context->request->getQueryParams()['page'] ?? 1));","+        $paginator = $this->dataProvider->getPaginator($currentPage, max(1, (int)$context->settings->get('limit')));"," ","         $view = $this->backendViewFactory->create($context->request);","         $view->assignMultiple([","-            'items' => $items,","+            'items' => $this->dataProvider->enrichLogEntries($paginator->getPaginatedItems()),","+            'paginator' => $paginator,","+            'pagination' => new SimplePagination($paginator),","             'button' => $this->buttonProvider,","             'configuration' => $this->configuration,","             'dateFormat' => $GLOBALS['TYPO3_CONF_VARS']['SYS']['ddmmyy'] . ' ' . $GLOBALS['TYPO3_CONF_VARS']['SYS']['hhmm'],"],"additions":7,"deletions":4,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Widgets/ListWidget.php","lines":["@@ -18,6 +18,8 @@"," namespace TYPO3\\CMS\\Dashboard\\Widgets;"," "," use TYPO3\\CMS\\Backend\\View\\BackendViewFactory;","+use TYPO3\\CMS\\Core\\Pagination\\PaginatorInterface;","+use TYPO3\\CMS\\Core\\Pagination\\SimplePagination;"," use TYPO3\\CMS\\Core\\Settings\\SettingDefinition;"," "," /**","@@ -26,18 +28,27 @@","  * The widget will show a simple list with items provided by a data provider. You can add a button to the widget by","  * defining a button provider.","  *","- * There are no options available for this widget","+ * A data provider implementing PaginatedListDataProviderInterface makes the widget render a paginator","+ * in its footer. Editors can then configure the number of items per page in the widget settings.","+ *","+ * The following options are available during registration:","+ * - itemsPerPage   int     default: 10         Number of items per page. Only used for paginated data providers.","+ *                                              If set, editors cannot change the value.","  *","  * @see ListDataProviderInterface","+ * @see PaginatedListDataProviderInterface","  * @see ButtonProviderInterface","  */"," class ListWidget implements WidgetRendererInterface"," {","+    private const DEFAULT_ITEMS_PER_PAGE = 10;","+","     public function __construct(","         private readonly WidgetConfigurationInterface $configuration,","-        private readonly ListDataProviderInterface $dataProvider,","+        private readonly ListDataProviderInterface|PaginatedListDataProviderInterface $dataProvider,","         private readonly BackendViewFactory $backendViewFactory,","         private readonly ?ButtonProviderInterface $buttonProvider = null,","+        /** @var array{refreshAvailable?: bool, itemsPerPage?: int} */","         private readonly array $options = [],","     ) {}"," ","@@ -46,14 +57,33 @@ public function __construct(","      */","     public function getSettingsDefinitions(): array","     {","-        return [];","+        if (!$this->dataProvider instanceof PaginatedListDataProviderInterface) {","+            return [];","+        }","+        return [","+            new SettingDefinition(","+                key: 'itemsPerPage',","+                type: 'int',","+                default: (int)($this->options['itemsPerPage'] ?? self::DEFAULT_ITEMS_PER_PAGE),","+                label: 'LLL:EXT:dashboard/Resources/Private/Language/locallang.xlf:widget.pagination.setting.itemsPerPage.label',","+                description: 'LLL:EXT:dashboard/Resources/Private/Language/locallang.xlf:widget.pagination.setting.itemsPerPage.description',","+                readonly: array_key_exists('itemsPerPage', $this->options),","+                options: [","+                    'min' => 1,","+                    'max' => 100,","+                ],","+            ),","+        ];","     }"," ","     public function renderWidget(WidgetContext $context): WidgetResult","     {","+        $paginator = $this->getPaginator($context);","         $view = $this->backendViewFactory->create($context->request);","         $view->assignMultiple([","-            'items' => $this->getItems(),","+            'items' => $paginator !== null ? iterator_to_array($paginator->getPaginatedItems(), false) : $this->getItems(),","+            'paginator' => $paginator,","+            'pagination' => $paginator !== null ? new SimplePagination($paginator) : null,","             'options' => $this->options,","             'button' => $this->buttonProvider,","             'configuration' => $this->configuration,","@@ -66,6 +96,18 @@ public function renderWidget(WidgetContext $context): WidgetResult"," ","     protected function getItems(): array","     {","-        return $this->dataProvider->getItems();","+        return $this->dataProvider instanceof ListDataProviderInterface ? $this->dataProvider->getItems() : [];","+    }","+","+    protected function getPaginator(WidgetContext $context): ?PaginatorInterface","+    {","+        if (!$this->dataProvider instanceof PaginatedListDataProviderInterface) {","+            return null;","+        }","+        $currentPage = max(1, (int)($context->request->getQueryParams()['page'] ?? 1));","+        $itemsPerPage = $context->settings->has('itemsPerPage')","+            ? max(1, (int)$context->settings->get('itemsPerPage'))","+            : (int)($this->options['itemsPerPage'] ?? self::DEFAULT_ITEMS_PER_PAGE);","+        return $this->dataProvider->getPaginator($currentPage, $itemsPerPage);","     }"," }"],"additions":47,"deletions":5,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Widgets/PaginatedListDataProviderInterface.php","lines":["@@ -0,0 +1,34 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Dashboard\\Widgets;","+","+use TYPO3\\CMS\\Core\\Pagination\\PaginatorInterface;","+","+/**","+ * The data provider of a ListWidget can implement this interface instead of","+ * {@see ListDataProviderInterface} to let the widget render a paginator.","+ */","+interface PaginatedListDataProviderInterface","+{","+    /**","+     * Return a paginator for the requested page, showing the given number of items per page.","+     * The number of items per page is configured in the widget and can be changed by editors.","+     * The paginator corrects page numbers that exceed the number of available pages.","+     */","+    public function getPaginator(int $currentPage, int $itemsPerPage): PaginatorInterface;","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Classes/Widgets/Provider/LatestBeLoginsDataProvider.php","lines":["@@ -20,6 +20,10 @@"," use TYPO3\\CMS\\Backend\\Utility\\BackendUtility;"," use TYPO3\\CMS\\Core\\Database\\Connection;"," use TYPO3\\CMS\\Core\\Database\\ConnectionPool;","+use TYPO3\\CMS\\Core\\Database\\Query\\QueryBuilder;","+use TYPO3\\CMS\\Core\\Database\\Query\\Restriction\\DeletedRestriction;","+use TYPO3\\CMS\\Core\\Pagination\\PaginatorInterface;","+use TYPO3\\CMS\\Core\\Pagination\\QueryBuilderPaginator;"," use TYPO3\\CMS\\Core\\SysLog\\Action\\Login as SystemLogLoginAction;"," use TYPO3\\CMS\\Core\\SysLog\\Type as SystemLogType;"," ","@@ -35,27 +39,29 @@ public function __construct("," ","     public function getItems(int $limit = 10): array","     {","-        $queryBuilder = $this->connectionPool->getQueryBuilderForTable('sys_log');","-","-        $logEntries = $queryBuilder","-            ->select('uid', 'tstamp', 'userid', 'details')","-            ->from('sys_log')","-            ->where(","-                $queryBuilder->expr()->eq(","-                    'type',","-                    $queryBuilder->createNamedParameter(SystemLogType::LOGIN, Connection::PARAM_INT)","-                ),","-                $queryBuilder->expr()->eq(","-                    'action',","-                    $queryBuilder->createNamedParameter(SystemLogLoginAction::LOGIN, Connection::PARAM_INT)","-                )","-            )","-            ->orderBy('tstamp', 'DESC')","+        $logEntries = $this->createQueryBuilder()","             ->setMaxResults($limit)","             ->executeQuery()","             ->fetchAllAssociative();"," ","-        // Enrich with user information","+        return $this->enrichLogEntries($logEntries);","+    }","+","+    /**","+     * Provides the successful backend logins, newest first. The paginated items are raw","+     * log entries, which can be turned into widget items via enrichLogEntries().","+     */","+    public function getPaginator(int $currentPage, int $itemsPerPage): PaginatorInterface","+    {","+        return new QueryBuilderPaginator($this->createQueryBuilder(), $currentPage, $itemsPerPage);","+    }","+","+    /**","+     * Enriches log entries with the information of the backend users. Entries of","+     * unknown (e.g. deleted) users are omitted.","+     */","+    public function enrichLogEntries(iterable $logEntries): array","+    {","         $items = [];","         $userNames = BackendUtility::getUserNames('username,realName,uid');"," ","@@ -75,4 +81,36 @@ public function getItems(int $limit = 10): array"," ","         return $items;","     }","+","+    private function createQueryBuilder(): QueryBuilder","+    {","+        $queryBuilder = $this->connectionPool->getQueryBuilderForTable('sys_log');","+        // Only logins of existing users are shown, matching BackendUtility::getUserNames()","+        $queryBuilder->getRestrictions()->removeAll()->add(new DeletedRestriction());","+","+        return $queryBuilder","+            ->select('sys_log.uid', 'sys_log.tstamp', 'sys_log.userid', 'sys_log.details')","+            ->from('sys_log')","+            ->join(","+                'sys_log',","+                'be_users',","+                'be_users',","+                (string)$queryBuilder->expr()->and(","+                    $queryBuilder->expr()->eq('be_users.uid', $queryBuilder->quoteIdentifier('sys_log.userid')),","+                    $queryBuilder->expr()->eq('be_users.pid', $queryBuilder->createNamedParameter(0, Connection::PARAM_INT))","+                )","+            )","+            ->where(","+                $queryBuilder->expr()->eq(","+                    'sys_log.type',","+                    $queryBuilder->createNamedParameter(SystemLogType::LOGIN, Connection::PARAM_INT)","+                ),","+                $queryBuilder->expr()->eq(","+                    'sys_log.action',","+                    $queryBuilder->createNamedParameter(SystemLogLoginAction::LOGIN, Connection::PARAM_INT)","+                )","+            )","+            ->orderBy('sys_log.tstamp', 'DESC')","+            ->addOrderBy('sys_log.uid', 'DESC');","+    }"," }"],"additions":55,"deletions":17,"truncated":false},{"path":"typo3/sysext/dashboard/Documentation/Developer/Interfaces.rst","lines":["@@ -200,3 +200,13 @@ For up to date information, please check the source code.","       :returntype: array","       :returns: Provide the array if items.","                 Each entry should be a single string.","+","+.. php:class:: PaginatedListDataProviderInterface","+","+   .. php:method:: getPaginator(int $currentPage, int $itemsPerPage)","+","+      :returntype: \\TYPO3\\CMS\\Core\\Pagination\\PaginatorInterface","+      :returns: Provide a paginator for the requested page, showing the","+                configured number of items per page. Implement this","+                interface instead of :php:`ListDataProviderInterface` to make","+                the :ref:`list widget <list-widget>` render a paginator."],"additions":10,"deletions":0,"truncated":false},{"path":"typo3/sysext/dashboard/Documentation/Widgets/ListWidget.rst","lines":["@@ -49,15 +49,32 @@ Options"," "," .. include:: Options/RefreshAvailable.rst.txt"," ","+..  confval:: itemsPerPage","+    :type: integer","+    :default: :yaml:`10`","+    :name: list-widget-itemsPerPage","+","+    Number of items shown at once. Only used if the data provider implements","+    the :php-short:`\\TYPO3\\CMS\\Dashboard\\Widgets\\PaginatedListDataProviderInterface`.","+","+    Backend users can change the value in the widget settings, unless the","+    option is set in the widget registration. In that case the value is","+    fixed.","+"," ..  _list-widget-dependencies:"," "," Dependencies"," ------------"," "," ..  confval:: $dataProvider","-    :type: :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\NumberWithIconDataProviderInterface`","+    :type: :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\ListDataProviderInterface` or :php:`\\TYPO3\\CMS\\Dashboard\\Widgets\\PaginatedListDataProviderInterface`","     :name: list-widget-dataProvider"," ","     This class should provide the items to show.","     This data provider needs to implement the","-    :php-short:`\\TYPO3\\CMS\\Dashboard\\Widgets\\NumberWithIconDataProviderInterface`.","+    :php-short:`\\TYPO3\\CMS\\Dashboard\\Widgets\\ListDataProviderInterface`.","+","+    If the data provider implements the","+    :php-short:`\\TYPO3\\CMS\\Dashboard\\Widgets\\PaginatedListDataProviderInterface`","+    instead, the widget renders a paginator in its footer and requests the","+    items of the current page from the returned paginator."],"additions":19,"deletions":2,"truncated":false},{"path":"typo3/