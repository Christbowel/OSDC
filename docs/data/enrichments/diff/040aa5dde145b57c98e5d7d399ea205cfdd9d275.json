Collections.Immutable;","+using System.IO;","+using Microsoft.CodeAnalysis;","+using Microsoft.CodeAnalysis.CSharp;","+using Microsoft.CodeAnalysis.CSharp.Syntax;","+using Orleans.CodeGenerator.Model;","+","+namespace Orleans.CodeGenerator.Tests;","+","+[TestSuite(\"BVT\")]","+[TestProvider(\"None\")]","+[TestArea(\"CodeGen\")]","+public sealed class EnumSerializerPlanTests(ITestOutputHelper output)","+{","+    [Theory]","+    [InlineData(\"byte\", \"ByteCodec\")]","+    [InlineData(\"sbyte\", \"SByteCodec\")]","+    [InlineData(\"short\", \"Int16Codec\")]","+    [InlineData(\"ushort\", \"UInt16Codec\")]","+    [InlineData(\"int\", \"Int32Codec\")]","+    [InlineData(\"uint\", \"UInt32Codec\")]","+    [InlineData(\"long\", \"Int64Codec\")]","+    [InlineData(\"ulong\", \"UInt64Codec\")]","+    public async Task IntegralCodecs_MatchCompilationAwareEmission(string underlyingType, string codec)","+    {","+        var compilation = await TestCompilationHelper.CreateCompilation($$\"\"\"","+            namespace Example;","+            [Orleans.GenerateSerializer]","+            public enum @enum : {{underlyingType}} { Zero, One }","+            \"\"\");","+        var (_, result) = Run(CreateDriver(), compilation);","+        var entry = Assert.Single(GetSerializerEntries(result));","+        var legacy = Assert.Single(GenerateLegacy(compilation, \"Example.enum\"));","+        Assert.Equal(legacy.SourceEntry, entry);","+        var root = CSharpSyntaxTree.ParseText(entry.Source, cancellationToken: TestContext.Current.CancellationToken).GetRoot(TestContext.Current.CancellationToken);","+        var write = Assert.Single(root.DescendantNodes().OfType<InvocationExpressionSyntax>(),","+            invocation => invocation.Expression.ToString().EndsWith($\"{codec}.WriteField\", StringComparison.Ordinal));","+        var arguments = write.ArgumentList.Arguments;","+        Assert.Equal(5, arguments.Count);","+        Assert.Equal(\"ref writer\", arguments[0].ToString());","+        Assert.Equal(\"fieldIdDelta\", arguments[1].ToString());","+        Assert.Equal(\"expectedType\", arguments[2].ToString());","+        var cast = Assert.IsType<CastExpressionSyntax>(arguments[3].Expression);","+        Assert.Equal(underlyingType, cast.Type.ToString());","+        Assert.Equal(\"value\", Assert.IsType<IdentifierNameSyntax>(cast.Expression).Identifier.ValueText);","+        Assert.Equal(\"_codecFieldType\", arguments[4].ToString());","+        Assert.Contains($\"{codec}.ReadValue(ref reader, field);\", entry.Source, StringComparison.Ordinal);","+    }","+","+    [Fact]","+    public async Task UnrelatedBodyEdit_CachesEveryEmitterWithoutSourceConstruction()","+    {","+        const string source = \"\"\"","+            [Orleans.GenerateSerializer] public enum First { Zero, One }","+            [Orleans.GenerateSerializer] internal enum Second : long { Minus = -1, One = 1 }","+            public static class Unrelated { public static int Value() => 1; }","+            \"\"\";","+        var compilation = await TestCompilationHelper.CreateCompilation(source);","+        var (driver, first) = Run(CreateDriver(), compilation);","+        var plans = GetPlans(first);","+        Assert.Equal(2, plans.Length);","+","+        foreach (var plan in plans)","+        {","+            EnumSerializerGenerator.GenerateSource(plan);","+        }","+","+        var start = GC.GetAllocatedBytesForCurrentThread();","+        foreach (var plan in plans)","+        {","+            EnumSerializerGenerator.GenerateSource(plan);","+        }","+        var sourceConstructionBytes = GC.GetAllocatedBytesForCurrentThread() - start;","+        Assert.True(sourceConstructionBytes > 0);","+","+        var updated = ReplaceSource(compilation, source.Replace(\"=> 1\", \"=> 2\", StringComparison.Ordinal));","+        start = GC.GetAllocatedBytesForCurrentThread();","+        var (_, second) = Run(driver, updated);","+        var retainedRunBytes = GC.GetAllocatedBytesForCurrentThread() - start;","+        Assert.Equal(2, AssertCachedEmitters(second).Length);","+        Assert.Equal(GetSources(first), GetSources(second));","+        AssertFreshParity(updated, second);","+        output.WriteLine($\"Enum emitters: initial=2, retained-body-edit=0 (2 Cached, 0 Unchanged). \" +","+            $\"Direct source construction/formatting for these plans allocated {sourceConstructionBytes} bytes; \" +","+            $\"cached emission allocated 0 source-construction bytes. Retained driver plus output compilation validation allocated {retainedRunBytes} bytes.\");","+    }","+","+    [Fact]","+    public async Task UnderlyingTypeEdit_InvalidatesOnlyOwningEnum()","+    {","+        const string source = \"\"\"","+            [Orleans.GenerateSerializer] public enum First : int { One = 1 }","+            [Orleans.GenerateSerializer] public enum Second { One = 1 }","+            [Orleans.GenerateSerializer] public sealed class Holder { [Orleans.Id(17)] public First Value { get; set; } }","+            \"\"\";","+        var compilation = await TestCompilationHelper.CreateCompilation(source);","+        var (driver, first) = Run(CreateDriver(), compilation);","+        var updated = ReplaceSource(compilation, source.Replace(\"First : int\", \"First : long\", StringComparison.Ordinal));","+        var (_, second) = Run(driver, updated);","+        var emitters = GetEmitterOutputs(second);","+        Assert.Equal(2, emitters.Length);","+        Assert.Equal(IncrementalStepRunReason.Modified, Assert.Single(emitters, static entry => entry.Entry.Source.Contains(\"Codec_First\", StringComparison.Ordinal)).Reason);","+        Assert.Equal(IncrementalStepRunReason.Cached, Assert.Single(emitters, static entry => entry.Entry.Source.Contains(\"Codec_Second\", StringComparison.Ordinal)).Reason);","+        var changed = Assert.Single(GetSerializerEntries(second), static entry => entry.Source.Contains(\"sealed class Codec_First\", StringComparison.Ordinal));","+        Assert.Contains(\"Int64Codec.WriteField\", changed.Source, StringComparison.Ordinal);","+        var cast = Assert.Single(CSharpSyntaxTree.ParseText(changed.Source, cancellationToken: TestContext.Current.CancellationToken)","+            .GetRoot(TestContext.Current.CancellationToken).DescendantNodes().OfType<CastExpressionSyntax>(),","+            static cast => cast.Expression is IdentifierNameSyntax { Identifier.ValueText: \"value\" });","+        Assert.Equal(\"long\", cast.Type.ToString());","+        AssertFreshParity(updated, second);","+        Assert.NotEqual(GetSources(first), GetSources(second));","+    }","+","+    [Fact]","+    public async Task ConstantAliasAndOptionsEdits_PreserveCodecPlan()","+    {","+        const string source = \"\"\"","+            [Orleans.GenerateSerializer, Orleans.Alias(\"before\")]","+            public enum First { One = 1 }","+            \"\"\";","+        var compilation = await TestCompilationHelper.CreateCompilation(source);","+        var (driver, first) = Run(CreateDriver(), compilation);","+        var updated = ReplaceSource(compilation, source","+            .Replace(\"One = 1\", \"One = 2, Three = 3\", StringComparison.Ordinal)","+            .Replace(\"\\\"before\\\"\", \"\\\"after\\\"\", StringComparison.Ordinal));","+        var options = TestCompilationHelper.CreateOptionsProvider(new Dictionary<string, string>"],"additions":126,"deletions":0,"truncated":false}],"additions":333,"deletions":97,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-01T15:16:40.486531+00:00"}