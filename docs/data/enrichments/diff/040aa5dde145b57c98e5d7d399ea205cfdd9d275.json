ddAttributeLists(AttributeList(SingletonSeparatedList(GeneratedCodeUtilities.GetMethodImplAttributeSyntax())))","+            .AddBodyStatements(statement);","+    }","+","+    internal static MemberDeclarationSyntax GenerateReadMethod(EnumSerializerPlan plan)","+    {","+        var readerParam = \"reader\".ToIdentifierName();","+        var fieldParam = \"field\".ToIdentifierName();","+        var readValue = InvocationExpression(","+            ParseName(plan.StaticCodec.SyntaxString).Member(\"ReadValue\"),","+            ArgumentList(SeparatedList(","+            [","+                Argument(readerParam).WithRefOrOutKeyword(Token(SyntaxKind.RefKeyword)),","+                Argument(fieldParam)","+            ])));","+","+        return MethodDeclaration(ParseTypeName(plan.Type.SyntaxString), \"ReadValue\")","+            .AddTypeParameterListParameters(TypeParameter(\"TReaderInput\"))","+            .AddModifiers(Token(SyntaxKind.PublicKeyword))","+            .AddParameterListParameters(","+                Parameter(readerParam.Identifier).WithType(ParseTypeName(plan.Reader.SyntaxString)).WithModifiers(TokenList(Token(SyntaxKind.RefKeyword))),","+                Parameter(fieldParam.Identifier).WithType(ParseTypeName(plan.Field.SyntaxString)))","+            .AddAttributeLists(AttributeList(SingletonSeparatedList(GeneratedCodeUtilities.GetMethodImplAttributeSyntax())))","+            .AddBodyStatements(ReturnStatement(CastExpression(ParseTypeName(plan.Type.SyntaxString), readValue)));","+    }","+}"],"additions":125,"deletions":0,"truncated":false},{"path":"src/Orleans.CodeGenerator/Model/EnumSerializerPlan.cs","lines":["@@ -0,0 +1,21 @@","+namespace Orleans.CodeGenerator.Model;","+","+// Each type syntax is resolved against the current compilation before this symbol-free cache boundary.","+internal sealed record EnumSerializerPlan(","+    string Name,","+    bool IsPublic,","+    TypeRef Type,","+    TypeRef UnderlyingType,","+    TypeRef StaticCodec,","+    