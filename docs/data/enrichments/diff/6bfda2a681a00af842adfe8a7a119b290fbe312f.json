od. Instead, modify the","   // definition of |ExposeElectronRendererInterfacesToBrowser()| to ensure"],"additions":14,"deletions":0,"truncated":false},{"path":"shell/renderer/renderer_client_base.h","lines":["@@ -121,6 +121,7 @@ class RendererClientBase : public content::ContentRendererClient","   // content::ContentRendererClient:","   void RenderThreadStarted() override;","   void SetRuntimeFeaturesDefaultsBeforeBlinkInitialization() override;","+  void SetUpWebAssemblyTrapHandler() override;","   void ExposeInterfacesToBrowser(mojo::BinderMap* binders) override;","   void RenderFrameCreated(content::RenderFrame*) override;","   void SetPendingCreateNewWindowStartupData(mojo_base::BigBuffer data) override;"],"additions":1,"deletions":0,"truncated":false},{"path":"spec/chromium.spec.ts","lines":["@@ -36,6 +36,7 @@ import {","   ifdescribe,","   defer,","   focusWebContents,","+  getSpecTimeout,","   itremote,","   listen,","   spawnAndWait,","@@ -568,6 +569,52 @@ describe('web security', () => {","   });"," });"," ","+describe('WebAssembly traps', () => {","+  // The fixture runs the module in a separate app so a regression shows up as","+  // a crashed process rather than taking down the spec runner.","+  const runWasmTrapFixture = async (mode: string, ...args: string[]) => {","+    const appPath = path.join(fixturesPath, 'apps', 'wasm-trap', 'main.js');","+    const timeout = getSpecTimeout() - 5_000;","+    const result = await spawnAndWait(process.execPath, [appPath, mode, ...args], { timeout });","+    const resultLine = result.stdout.split(/\\r?\\n/).find((line) => line.startsWith('RESULT '));","+    return { ...result, resultLine };","+  };","+","+  const places = {","+    main: 'the main process',","+    sandboxed: 'a sandboxed renderer',","+    unsandboxed: 'an unsandboxed renderer'","+  };","+  for (const [mode, where] of Object.entries(places)) {","+    it(`throws a catchable RuntimeError for an out-of-bounds access in ${where}`, async () => {","+      const { code, signal, stderr, resultLine } = await runWasmTrapFixture(mode);","+      expect(resultLine, `code ${code} signal ${signal} stderr ${stderr}`).toBe(","+        'RESULT caught RuntimeError: memory access out of bounds'","+      );","+    });","+  }","+","+  ifit(process.platform === 'linux')(","+    'throws a catchable RuntimeError in the main process after crashReporter.start()',","+    async () => {","+      const crashesDir = await fs.promises.mkdtemp(path.join(os.tmpdir(), 'electron-wasm-trap-'));","+      defer(() => fs.promises.rm(crashesDir, { recursive: true, force: true }));","+      const { code, signal, stderr, resultLine } = await runWasmTrapFixture('main-crash-reporter', crashesDir);","+      // The Crashpad handler is a separate process, so give it a moment to","+      // finish writing a dump if the trap reached it.","+      await setTimeout(1000);","+      const dumps = ['completed', 'new', 'pending'].flatMap((dir) => {","+        const dirPath = path.join(crashesDir, dir);","+        return fs.existsSync(dirPath) ? fs.readdirSync(dirPath).filter((file) => file.endsWith('.dmp')) : [];","+      });","+      expect(resultLine, `code ${code} signal ${signal} stderr ${stderr}`).toBe(","+        'RESULT caught RuntimeError: memory access out of bounds'","+      );","+      expect(dumps).toEqual([]);","+    }","+  );","+});","+"," describe('command line switches', () => {","   let appProcess: ChildProcess.ChildProcessWithoutNullStreams | undefined;","   afterEach(() => {"],"additions":47,"deletions":0,"truncated":false},{"path":"spec/fixtures/apps/wasm-trap/main.js","lines":["@@ -0,0 +1,57 @@","+// Runs a WebAssembly function that reads past the end of its memory, either","+// in the main process or in a renderer, and prints how the trap was reported.","+// Usage: electron main.js <main|sandboxed|unsandboxed>","+//        electron main.js main-crash-reporter <crash dumps dir>","+const { app, BrowserWindow, crashReporter } = require('electron');","+","+// (module (memory 1) (func (export \"f\") (param i32) (result i32)","+//   local.get 0 i32.load))","+const wasmBytes = [","+  0, 97, 115, 109, 1, 0, 0, 0, 1, 6, 1, 96, 1, 127, 1, 127, 3, 2, 1, 0, 5, 3, 1, 0, 1, 7, 5, 1, 1, 102, 0, 0, 10, 9, 1,","+  7, 0, 32, 0, 40, 2, 0, 11","+];","+","+function runOutOfBoundsLoad(bytes) {","+  const instance = new WebAssembly.Instance(new WebAssembly.Module(new Uint8Array(bytes)));","+  try {","+    instance.exports.f(0x10000);","+    return 'no-trap';","+  } catch (e) {","+    return `caught ${e.name}: ${e.message}`;","+  }","+}","+","+const mode = process.argv[2];","+","+app.whenReady().then(async () => {","+  if (mode === 'main-crash-reporter') {","+    // Crashpad's signal handler goes in front of the one V8 uses for traps.","+    app.setPath('crashDumps', process.argv[3]);","+    crashReporter.start({","+      submitURL: 'http://127.0.0.1',","+      uploadToServer: false,","+      ignoreSystemCrashHandler: true","+    });","+  }","+","+  if (mode === 'main' || mode === 'main-crash-reporter') {","+    console.log(`RESULT ${runOutOfBoundsLoad(wasmBytes)}`);","+    app.exit(0);","+    return;","+  }","+","+  const w = new BrowserWindow({","+    show: false,","+    webPreferences: { sandbox: mode === 'sandboxed' }","+  });","+  w.webContents.on('render-process-gone', (_event, details) => {","+    console.log(`RESULT renderer-gone ${details.reason}`);","+    app.exit(0);","+  });","+  await w.loadURL('about:blank');","+  const result = await w.webContents.executeJavaScript(","+    `(${runOutOfBoundsLoad.toString()})(${JSON.stringify(wasmBytes)})`","+  );","+  console.log(`RESULT ${result}`);","+  app.exit(0);","+});",""],"additions":57,"deletions":0,"truncated":false}],"additions":138,"deletions":15,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-25T18:23:45.010807+00:00"}