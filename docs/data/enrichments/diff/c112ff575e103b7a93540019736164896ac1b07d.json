= rendered.element.querySelector('a')?.getAttribute('data-href') ?? null;","+\t\t\trendered.dispose();","+\t\t});","+\t\treturn result;","+\t}","+","+\ttest('allows all images by default', () => {","+\t\tconst sources = renderImageSources(undefined);","+\t\tassert.strictEqual(sources.remote, 'https://attacker.example/collect?leak=1');","+\t\tassert.strictEqual(sources.allowed, 'https://img.shields.io/badge.svg');","+\t});","+","+\ttest('blocks remote images when no origin is allowed, keeps data images and links', () => {","+\t\tconst sources = renderImageSources({ allowedOrigins: [] });","+\t\tassert.strictEqual(sources.remote, null);","+\t\tassert.strictEqual(sources.allowed, null);","+\t\tassert.strictEqual(sources.inline, 'data:image/png;base64,iVBORw0KGgo=');","+\t\tassert.strictEqual(sources.link, 'https://example.com/docs');","+\t});","+","+\ttest('allows images from the allowed origins only', () => {","+\t\tconst sources = renderImageSources({ allowedOrigins: ['https://img.shields.io/ignored-path'] });","+\t\tassert.strictEqual(sources.remote, null);","+\t\tassert.strictEqual(sources.allowed, 'https://img.shields.io/badge.svg');","+\t});","+","+\ttest('validates and normalizes allowed origins', () => {","+\t\twithTestCodeEditor('', { markdownImages: { allowedOrigins: ['HTTPS://A.example:443/x', 'http://b.example:8080', 'not a url', 'data:text/plain,x', 42 as unknown as string] } }, editor => {","+\t\t\tassert.deepStrictEqual(editor.getOption(EditorOption.markdownImages), { allowedOrigins: ['https://a.example', 'http://b.example:8080'] });","+","+\t\t\teditor.updateOptions({ markdownImages: { allowedOrigins: true } });","+\t\t\tassert.deepStrictEqual(editor.getOption(EditorOption.markdownImages), { allowedOrigins: true });","+\t\t});","+\t});","+});"],"additions":67,"deletions":0,"truncated":false},{"path":"src/vs/monaco.d.ts","lines":["@@ -3557,6 +3557,11 @@ declare namespace monaco.editor {"," \t\t * Configure the editor's hover."," \t\t */"," \t\thover?: IE