{"id":"db829f1cf96241215006acbaaa6c9138d6b24b09","axis":"silent","repo":"langchain-ai/langchainjs","sha":"db829f1cf96241215006acbaaa6c9138d6b24b09","parsed":{"files":[{"path":".changeset/trace-policy.md","lines":["@@ -0,0 +1,5 @@","+---","+\"langchain\": patch","+---","+","+Add `tracePolicy` to `createMiddleware`, applied to the middleware's lifecycle hook runs. It only changes what `LangChainTracer` sends to LangSmith (use `omitPayload` from `@langchain/core/tracers/tracer_langchain`). Requires `@langchain/langgraph` >= 1.6.1."],"additions":5,"deletions":0,"truncated":false},{"path":"libs/langchain/package.json","lines":["@@ -74,7 +74,7 @@","     \"@langchain/core\": \"workspace:^\"","   },","   \"dependencies\": {","-    \"@langchain/langgraph\": \"^1.4.18\",","+    \"@langchain/langgraph\": \"^1.6.1\",","     \"@langchain/langgraph-checkpoint\": \"^1.1.5\",","     \"langsmith\": \">=0.11.0 <1.0.0\",","     \"zod\": \"^3.25.76 || ^4\""],"additions":1,"deletions":1,"truncated":false},{"path":"libs/langchain/src/agents/middleware.ts","lines":["@@ -6,6 +6,7 @@ import type {","   StateDefinitionInit,","   StreamTransformer,"," } from \"@langchain/langgraph\";","+import type { TracePolicy } from \"@langchain/core/tracers/tracer_langchain\";"," import type { ClientTool, ServerTool } from \"@langchain/core/tools\";"," "," import {","@@ -114,6 +115,12 @@ export function createMiddleware<","    * Merged with `createAgent({ streamTransformers })` when the agent compiles.","    */","   streamTransformers?: TStreamTransformers;","+  /**","+   * Shapes what `LangChainTracer` sends to LangSmith for this middleware's","+   * lifecycle hook runs. Execution, streaming, and other callbacks still see","+   * the raw values.","+   */","+  tracePolicy?: TracePolicy;","   /**","    * Wraps tool execution with custom logic. This allows you to:","    * - Modify tool call parameters before execution","@@ -272,6 +279,7 @@ export function createMiddleware<","     afterAgent: config.afterAgent,","     tools: config.tools,","     streamTransformers: config.streamTransformers,","+    tracePolicy: config.tracePolicy,","   };"," ","   return middleware;"],"additions":8,"deletions":0,"truncated":false},{"path":"libs/langchain/src/agents/middleware/types.ts","lines":["@@ -21,6 +21,7 @@ import type {"," } from \"@langchain/core/messages\";"," import type { ToolCall } from \"@langchain/core/messages/tool\";"," import type { Command, StreamTransformer } from \"@langchain/langgraph\";","+import type { TracePolicy } from \"@langchain/core/tracers/tracer_langchain\";"," import type { ClientTool, ServerTool } from \"@langchain/core/tools\";"," "," import type { JumpToTarget } from \"../constants.js\";","@@ -469,6 +470,25 @@ export interface AgentMiddleware<","    */","   streamTransformers?: TStreamTransformers;"," ","+  /**","+   * Shapes what `LangChainTracer` sends to LangSmith for this middleware's","+   * lifecycle hook runs. Execution, streaming, and other callbacks still see","+   * the raw values.","+   *","+   * @example","+   * ```ts","+   * import { createMiddleware } from \"langchain\";","+   * import { omitPayload } from \"@langchain/core/tracers/tracer_langchain\";","+   *","+   * const middleware = createMiddleware({","+   *   name: \"PrivateMiddleware\",","+   *   tracePolicy: { processInputs: omitPayload },","+   *   beforeModel: () => undefined,","+   * });","+   * ```","+   */","+  tracePolicy?: TracePolicy;","+","   /**","    * Wraps tool execution with custom logic. This allows you to:","    * - Modify tool call parameters before execution"],"additions":20,"deletions":0,"truncated":false},{"path":"libs/langchain/src/agents/nodes/middleware.ts","lines":["@@ -187,6 +187,7 @@ export abstract class MiddlewareNode<","   get nodeOptions() {","     return {","       input: derivePrivateState(this.middleware.stateSchema),","+      tracePolicy: this.middleware.tracePolicy,","     };","   }"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"libs/langchain/src/agents/tests/tracePolicy.test-d.ts","lines":["@@ -0,0 +1,21 @@","+import { expectTypeOf, it } from \"vitest\";","+import {","+  omitPayload,","+  type TracePolicy,","+} from \"@langchain/core/tracers/tracer_langchain\";","+","+import { createMiddleware, type AgentMiddleware } from \"../index.js\";","+","+it(\"supports trace policies on middleware\", () => {","+  const middleware = createMiddleware({","+    name: \"TracePolicy\",","+    tracePolicy: {","+      processInputs: omitPayload,","+      processOutputs: (outputs) => ({ keys: Object.keys(outputs) }),","+    },","+    beforeModel: () => undefined,","+  });","+","+  expectTypeOf(middleware).toMatchTypeOf<AgentMiddleware>();","+  expectTypeOf(middleware.tracePolicy).toEqualTypeOf<TracePolicy | undefined>();","+});"],"additions":21,"deletions":0,"truncated":false},{"path":"libs/langchain/src/agents/tests/tracePolicy.test.ts","lines":["@@ -0,0 +1,168 @@","+import { describe, expect, it, vi } from \"vitest\";","+import { HumanMessage, ToolMessage } from \"@langchain/core/messages\";","+import { tool } from \"@langchain/core/tools\";","+import {","+  LangChainTracer,","+  omitPayload,","+} from \"@langchain/core/tracers/tracer_langchain\";","+import { z } from \"zod/v3\";","+","+import { createAgent, createMiddleware } from \"../index.js\";","+import { FakeToolCallingModel } from \"./utils.js\";","+","+// oxlint-disable-next-line @typescript-eslint/no-explicit-any","+type SentRun = Record<string, any>;","+","+/** A LangChainTracer whose client records what would be sent to LangSmith. */","+function mockTracer() {","+  const client = { createRun: vi.fn(), updateRun: vi.fn() };","+  const tracer = new LangChainTracer({","+    client: client as unknown as LangChainTracer[\"client\"],","+  });","+  /** The first run with this name, with its final outputs merged in. */","+  const sent = (name: string): SentRun => {","+    const run = client.createRun.mock.calls","+      .map(([r]) => r)","+      .find((r) => r.name === name);","+    const end = client.updateRun.mock.calls","+      .filter(([id]) => id === run?.id)","+      .at(-1)?.[1];","+    return { ...run, outputs: end?.outputs };","+  };","+  return { tracer, sent };","+}","+","+const hello = { messages: [new HumanMessage(\"hello\")] };","+","+describe(\"middleware tracePolicy\", () => {","+  it(\"applies each middleware's policy only to its own hook runs\", async () => {","+    const inputOnly = createMiddleware({","+      name: \"InputOnly\",","+      tracePolicy: { processInputs: omitPayload },","+      beforeModel: () => ({ messages: [] }),","+    });","+    const outputOnly = createMiddleware({","+      name: \"OutputOnly\",","+      tracePolicy: { processOutputs: omitPayload },","+      beforeModel: () => ({ messages: [] }),","+    });","+    const unfiltered = createMiddleware({","+      name: \"Unfiltered\",","+      beforeModel: () => ({ messages: [] }),","+    });","+    const agent = createAgent({","+      model: new FakeToolCallingModel(),","+      middleware: [inputOnly, outputOnly, unfiltered],","+      tools: [],","+    });","+    const { tracer, sent } = mockTracer();","+","+    const result = await agent.invoke(hello, { callbacks: [tracer] });","+","+    expect(result.messages.at(-1)?.content).toBe(\"hello\");","+    const raw = { messages: [expect.anything()] };","+    expect(sent(\"InputOnly.before_model\").inputs).toEqual({});","+    expect(sent(\"InputOnly.before_model\").outputs).toEqual({ messages: [] });","+    expect(sent(\"OutputOnly.before_model\").inputs).toMatchObject(raw);","+    expect(sent(\"OutputOnly.before_model\").outputs).toEqual({});","+    expect(sent(\"Unfiltered.before_model\").inputs).toMatchObject(raw);","+    expect(sent(\"Unfiltered.before_model\").outputs).toEqual({ messages: [] });","+  });","+","+  it(\"covers every lifecycle hook and leaves model runs raw\", async () => {","+    const middleware = createMiddleware({","+      name: \"Filtered\",","+      tracePolicy: { processInputs: omitPayload, processOutputs: omitPayload },","+      beforeAgent: () => undefined,","+      beforeModel: () => undefined,","+      afterModel: () => undefined,","+      afterAgent: () => undefined,","+    });","+    const agent = createAgent({","+      model: new FakeToolCallingModel(),","+      middleware: [middleware],","+      tools: [],","+    });","+    const { tracer, sent } = mockTracer();","+    const big = \"x\".repeat(10_000);","+","+    const result = await agent.invoke(","+      { messages: [new HumanMessage(big)] },","+      { callbacks: [tracer] }","+    );","+","+    expect(result.messages.at(-1)?.content).toBe(big);","+    for (const hook of [","+      \"before_agent\",","+      \"before_model\",","+      \"after_model\",","+      \"after_agent\",","+    ]) {","+      const run = sent(`Filtered.${hook}`);","+      expect(run.inputs).toEqual({});","+      expect(run.outputs).toEqual({});","+    }","+    expect(JSON.stringify(sent(\"FakeToolCallingModel\").inputs)).toContain(big);","+  });","+","+  it(\"leaves tool runs raw\", async () => {","+    const model = new FakeToolCallingModel({","+      toolCalls: [","+        [{ id: \"call_1\", name: \"weather\", args: { city: \"Tokyo\" } }],","+        [],","+      ],","+    });","+    const getWeather = tool(async () => \"sunny\", {","+      name: \"weather\",","+      description: \"Gets the weather\",","+      schema: z.object({ city: z.string() }),","+    });","+    const middleware = createMiddleware({","+      name: \"Filtered\",","+      tracePolicy: { processInputs: omitPayload, processOutputs: omitPayload },","+      afterModel: () => undefined,","+    });","+    const agent = createAgent({","+      model,","+      tools: [getWeather],","+      middleware: [middleware],","+    });","+    const { tracer, sent } = mockTracer();","+","+    const result = await agent.invoke(","+      { messages: [new HumanMessage(\"weather in Tokyo\")] },","+      { callbacks: [tracer] }","+    );","+","+    expect(result.messages.some(ToolMessage.isInstance)).toBe(true);","+    expect(sent(\"Filtered.after_model\")).toMatchObject({","+      inputs: {},","+      outputs: {},","+    });","+    expect(sent(\"weather\").inputs).toEqual({ city: \"Tokyo\" });","+    expect(JSON.stringify(sent(\"weather\").outputs)).toContain(\"sunny\");","+  });","+","+  it(\"leaves streamEvents payloads raw\", async () => {","+    const middleware = createMiddleware({","+      name: \"Filtered\",","+      tracePolicy: { processInputs: omitPayload, processOutputs: omitPayload },","+      beforeModel: () => undefined,","+    });","+    const agent = createAgent({","+      model: new FakeToolCallingModel(),","+      middleware: [middleware],","+      tools: [],","+    });","+","+    const events = [];","+    for await (const event of agent.streamEvents(hello, { version: \"v2\" })) {","+      events.push(event);","+    }","+","+    const start = events.find(","+      (e) => e.name === \"Filtered.before_model\" && e.event === \"on_chain_start\"","+    );","+    expect(start?.data.input).toMatchObject({ messages: [expect.anything()] });","+  });","+});"],"additions":168,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -623,8 +623,8 @@ importers:","   libs/langchain:","     dependencies:","       '@langchain/langgraph':","-        specifier: ^1.4.18","-        version: 1.4.18(@langchain/core@libs+langchain-core)(react-dom@19.2.5(react@19.2.5))(react@19.2.5)(zod@4.6.7)","+        specifier: ^1.6.1","+        version: 1.7.0(@langchain/core@libs+langchain-core)(react-dom@19.2.5(react@19.2.5))(react@19.2.5)(zod@4.6.7)","       '@langchain/langgraph-checkpoint':","         specifier: ^1.1.5","         version: 1.1.5(@langchain/core@libs+langchain-core)","@@ -652,7 +652,7 @@ importers:","         version: link:../providers/langchain-fireworks","       '@langchain/langgraph-api':","         specifier: ^1.5.1","-        version: 1.5.1(@langchain/core@libs+langchain-core)