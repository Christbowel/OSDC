wait context.GetAsync(cancellationToken);","+","+        if (snapshot.State != IdentityPermissionSnapshotState.Ready)","+        {","+            return UserPermissions.FromGrants([]);","+        }","+","+        var grants = snapshot.Grants.SelectMany(pair => pair.Value.Select(verb => new Permission(pair.Key, verb)));","+        return UserPermissions.FromGrants(grants);","+    }","+}"],"additions":31,"deletions":0,"truncated":false},{"path":"src/studio/modules/Elsa.Studio.Security/_Imports.razor","lines":["@@ -1,5 +1,7 @@","+@using Elsa.Studio.Authorization"," ﻿@using Elsa.Studio.Components"," @using Elsa.Studio.Security.Components","+@using Elsa.Studio.Security.Constants"," @using Elsa.Studio.Security.Contracts"," @using Elsa.Studio.Security.Models"," @using Microsoft.AspNetCore.Authorization",""],"additions":2,"deletions":0,"truncated":false}],"additions":45,"deletions":10,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-04T13:27:30.447003+00:00"}