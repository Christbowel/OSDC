esource UID (e.g. dashboard UID)"],"additions":38,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/search/embed/enrollment/registry.go","lines":["@@ -0,0 +1,156 @@","+package enrollment","+","+import (","+\t\"fmt\"","+\t\"slices\"","+\t\"strings\"","+","+\t\"github.com/grafana/grafana-app-sdk/app\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+","+\t\"github.com/grafana/grafana/pkg/infra/log\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search/embed\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search/embed/generic\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search/vector\"","+)","+","+type Registry struct {","+\tconfigs         *resource.EmbeddingConfigRegistry","+\tallowed         []schema.GroupResource","+\tcustom          map[schema.GroupResource]embed.Builder","+\tskippedVersions *prometheus.CounterVec","+\tlog             log.Logger","+}","+","+var _ embed.BuilderProvider = (*Registry)(nil)","+","+// New defers declaration lookup until Validate so the initial live manifest","+// snapshot can load before enrollment is checked.","+func New(configs *resource.EmbeddingConfigRegistry, allowed []string, custom []embed.Builder, skippedVersions *prometheus.CounterVec) (*Registry, error) {","+\tif configs == nil {","+\t\tconfigs = resource.NewEmbeddingConfigRegistry()","+\t}","+\tr := &Registry{","+\t\tconfigs:         configs,","+\t\tcustom:          make(map[schema.GroupResource]embed.Builder, len(custom)),","+\t\tskippedVersions: skippedVersions,","+\t\tlog:             log.New(\"embedding-enrollment\"),","+\t}","+\tseen := make(map[schema.GroupResource]bool, len(allowed))","+\tfor _, entry := range allowed {","+\t\tentry = strings.TrimSpace(entry)","+\t\tif entry == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\tgr, err := parseEntry(entry)","+\t\tif err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t\tif !seen[gr] {","+\t\t\tr.allowed = append(r.allowed, gr)","+\t\t\tseen[gr] = true","+\t\t}","+\t}","+\tslices.SortFunc(r.allowed, func(a, b schema.GroupResource) int {","+\t\tif c := strings.Compare(a.Group, b.Group); c != 0 {","+\t\t\treturn c","+\t\t}","+\t\treturn strings.Compare(a.Resource, b.Resource)","+\t})","+\tfor _, builder := range custom {","+\t\tif builder == nil {","+\t\t\treturn nil, fmt.Errorf(\"custom embedding builder must not be nil\")","+\t\t}","+\t\tgr, err := parseEntry(builder.Group() + \"/\" + builder.Resource())","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"custom embedding builder: %w\", err)","+\t\t}","+\t\tif _, exists := r.custom[gr]; exists {","+\t\t\treturn nil, fmt.Errorf(\"duplicate custom embedding builder for %s/%s\", gr.Group, gr.Resource)","+\t\t}","+\t\tr.custom[gr] = builder","+\t}","+\treturn r, nil","+}","+","+func parseEntry(entry string) (schema.GroupResource, error) {","+\tgroup, name, found := strings.Cut(entry, \"/\")","+\tif !found || group == \"\" || name == \"\" || strings.Contains(name, \"/\") || strings.ContainsAny(entry, \" \\t\\r\\n\") {","+\t\treturn schema.GroupResource{}, fmt.Errorf(\"invalid internal embedding collection %q: expected group/resource\", entry)","+\t}","+\treturn schema.GroupResource{Group: group, Resource: name}, nil","+}","+","+// Has checks current enrollment without constructing builders. Consumers using","+// a retained snapshot must use that snapshot's Has to keep a consistent view.","+func (r *Registry) Has(group, resource string) bool {","+\tgr := schema.GroupResource{Group: group, Resource: resource}","+\tif !slices.Contains(r.allowed, gr) {","+\t\treturn false","+\t}","+\tif _, ok := r.custom[gr]; ok {","+\t\treturn true","+\t}","+\treturn r.configs.HasResource(gr)","+}","+","+func (r *Registry) Validate() error {","+\tdeclared := make(map[schema.GroupResource]bool)","+\tfor gvr := range r.configs.Snapshot() {","+\t\tdeclared[gvr.GroupResource()] = true","+\t}","+\tpartitions := make(map[string]schema.GroupResource, len(r.allowed))","+\tfor _, gr := range r.allowed {","+\t\t_, isCustom := r.custom[gr]","+\t\tif !isCustom && !declared[gr] {","+\t\t\treturn fmt.Errorf(\"internal embedding collection %s/%s has no custom builder or manifest embedding declaration\", gr.Group, gr.Resource)","+\t\t}","+\t\tpartition, err := vector.InternalPartitionKey(gr.Resource)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"internal embedding collection %s/%s: %w\", gr.Group, gr.Resource, err)","+\t\t}","+\t\tif owner, exists := partitions[partition]; exists {","+\t\t\treturn fmt.Errorf(\"internal embedding collections %s/%s and %s/%s derive the same partition key %q\", owner.Group, owner.Resource, gr.Group, gr.Resource, partition)","+\t\t}","+\t\tpartitions[partition] = gr","+\t\tif isCustom && declared[gr] {","+\t\t\tr.log.Warn(\"Custom embedding builder overrides manifest embedding declarations\", \"group\", gr.Group, \"resource\", gr.Resource)","+\t\t}","+\t}","+\treturn nil","+}","+","+// Snapshot omits declarations removed at runtime without interrupting other","+// resources. Startup validation remains strict about missing declarations.","+func (r *Registry) Snapshot() embed.BuilderSnapshot {","+\ttype declaration struct {","+\t\trevision int","+\t\tfields   map[string][]app.ManifestVersionKindEmbedField","+\t}","+\tdeclared := make(map[schema.GroupResource]declaration)","+\tfor gvr, config := range r.configs.Snapshot() {","+\t\tgr := gvr.GroupResource()","+\t\td := declared[gr]","+\t\tif d.fields == nil {","+\t\t\td.fields = make(map[string][]app.ManifestVersionKindEmbedField)","+\t\t\td.revision = config.ReembedVersion","+\t\t}","+\t\td.fields[gvr.Version] = config.Fields","+\t\tdeclared[gr] = d","+\t}","+\tbuilders := make([]embed.Builder, 0, len(r.allowed))","+\tfor _, gr := range r.allowed {","+\t\td, hasDeclaration := declared[gr]","+\t\tbuilder, isCustom := r.custom[gr]","+\t\tif !isCustom {","+\t\t\tif !hasDeclaration {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tbuilder = generic.New(gr, app.ManifestResourceEmbed{ReembedVersion: d.revision}, d.fields, r.skippedVersions)","+\t\t}","+\t\tbuilders = append(builders, builder)","+\t}","+\treturn embed.NewBuilderSnapshot(builders)","+}"],"additions":156,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/search/embed/enrollment/registry_test.go","lines":["@@ -0,0 +1,301 @@","+package enrollment","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/grafana/grafana-app-sdk/app\"","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/grafana/grafana/pkg/storage/unified/resource\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search/embed\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search/embed/dashboard\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/search/embed/generic\"","+)","+","+func testManifest(group, plural string, revision int, versions map[string][]app.ManifestVersionKindEmbedField) *app.ManifestData {","+\tm := &app.ManifestData{","+\t\tGroup: group,","+\t\tEmbed: map[string]app.ManifestResourceEmbed{plural: {ReembedVersion: revision}},","+\t}","+\tfor version, fields := range versions {","+\t\tm.Versions = append(m.Versions, app.ManifestVersion{","+\t\t\tName: version,","+\t\t\tKinds: []app.ManifestVersionKind{{","+\t\t\t\tKind: \"Widget\", Plural: plural, Embed: &app.ManifestVersionKindEmbed{Fields: fields},","+\t\t\t}},","+\t\t})","+\t}","+\treturn m","+}","+","+func TestRegistrySelection(t *testing.T) {","+\tfields := []app.ManifestVersionKindEmbedField{{Name: \"title\", Path: \"spec.title\"}}","+\tconfigs := resource.NewEmbeddingConfigRegistry([]*app.ManifestData{","+\t\ttestManifest(\"widgets.example.test\", \"widgets\", 5, map[string][]app.ManifestVersionKindEmbedField{\"v1\": fields}),","+\t\ttestManifest(\"dashboard.grafana.app\", \"dashboards\", 99, map[string][]app.ManifestVersionKindEmbedField{\"v1\": fields}),","+\t})","+\tcustom := dashboard.New()","+\tfor _, tt := range []struct {","+\t\tname    string","+\t\tallowed []string","+\t\twant    []string","+\t}{","+\t\t{name: \"empty enrolls nothing\"},","+\t\t{name: \"dashboard default is supplied by config\", allowed: []string{\"dashboard.grafana.app/dashboards\"}, want: []string{\"dashboard.grafana.app/dashboards\"}},","+\t\t{name: \"generic only\", allowed: []string{\"widgets.example.test/widgets\"}, want: []string{\"widgets.example.test/widgets\"}},","+\t\t{name: \"sorted deduplicated selection\", allowed: []string{\"widgets.example.test/widgets\", \" dashboard.grafana.app/dashboards \", \"\", \"widgets.example.test/widgets\"}, want: []string{\"dashboard.grafana.app/dashboards\", \"widgets.example.test/widgets\"}},","+\t} {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tregistry, err := New(configs, tt.allowed, []embed.Builder{custom}, nil)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NoError(t, registry.Validate())","+\t\t\tsnapshot := registry.Snapshot()","+\t\t\tbuilders := snapshot.Builders()","+\t\t\tvar got []string","+\t\t\tfor _, b := range builders {","+\t\t\t\tassert.True(t, snapshot.Has(b.Group(), b.Resource()))","+\t\t\t\tgot = append(got, b.Group()+\"/\"+b.Resource())","+\t\t\t\tif b.Resource() == \"dashboards\" {","+\t\t\t\t\tassert.Same(t, custom, b)","+\t\t\t\t\tassert.Equal(t, custom.Version(), b.Version())","+\t\t\t\t} else {","+\t\t\t\t\tassert.IsType(t, &generic.Builder{}, b)","+\t\t\t\t\tassert.Equal(t, 5, b.Version())","+\t\t\t\t}","+\t\t\t}","+\t\t\tassert.Equal(t, tt.want, got)","+\t\t})","+\t}","+}","+","+func TestRegistryValidatesConfiguration(t *testing.T) {","+\tfor _, entry := range []string{\"dashboards\", \"/dashboards\", \"dashboard.grafana.app/\", \"group/widgets/extra\", \"group /widgets\", \"group/wid gets\"} {","+\t\tt.Run(entry, func(t *testing.T) {","+\t\t\t_, err := New(nil, []string{entry}, nil, nil)","+\t\t\trequire.ErrorContains(t, err, \"expected group/resource\")","+\t\t})","+\t}","+\t_, err := New(nil, nil, []embed.Builder{dashboard.New(), dashboard.New()}, nil)","+\trequire.ErrorContains(t, err, \"duplicate custom embedding builder\")","+\t_, err = New(nil, nil, []embed.Builder{nil}, nil)","+\trequire.ErrorContains(t, err, \"must not be nil\")","+\t_, err = New(nil, nil, []embed.Builder{&testCustomBuilder{group: \"group\"}}, nil)","+\trequire.ErrorContains(t, err, \"custom embedding builder\")","+}","+","+func TestRegistryDefersUnsupportedUntilValidation(t *testing.T) {","+\tconfigs := resource.NewEmbeddingConfigRegistry([]*app.ManifestData{","+\t\ttestManifest(\"widgets.example.test\", \"widgets\", 3, nil),","+\t})","+\tregistry, err := New(configs, []string{\"widgets.example.test/widgets\"}, nil, nil)","+\trequire.NoError(t, err)","+\trequire.ErrorContains(t, registry.Validate(), \"widgets.example.test/widgets has no custom builder or manifest embedding declaration\")","+\tassert.Empty(t, registry.Snapshot().Builders(), \"root revision alone has no versioned declaration\")","+\tassert.False(t, registry.Has(\"widgets.example.test\", \"widgets\"))","+","+\tconfigs.Reload([]*app.ManifestData{testManifest(\"widgets.example.test\", \"widgets\", 3, map[string][]app.ManifestVersionKindEmbedField{\"v1\": {}})})","+\trequire.NoError(t, registry.Validate())","+\tassert.True(t, registry.Has(\"widgets.example.test\", \"widgets\"), \"an explicitly empty version declaration is enrolled\")","+\tbuilders := registry.Snapshot().Builders()","+\trequire.Len(t, builders, 1)","+\titems, err := extract(t, builders[0], \"v1\", nil)","+\trequire.NoError(t, err)","+\tassert.Empty(t, items)","+}","+","+func TestRegistryCustomNeedsNoDeclaration(t *testing.T) {","+\tcustom := dashboard.New()","+\tregistry, err := New(nil, []string{\"dashboard.grafana.app/dashboards\"}, []embed.Builder{custom}, nil)","+\trequire.NoError(t, err)","+\trequire.NoError(t, registry.Validate())","+\tbuilders := registry.Snapshot().Builders()","+\trequire.Len(t, builders, 1)","+\tassert.Same(t, custom, builders[0])","+\tassert.True(t, registry.Has(custom.Group(), custom.Resource()))","+}","+","+func TestRegistrySnapshotsIsolateRemovedDeclarations(t *testing.T) {","+\tmanifests := []*app.ManifestData{","+\t\ttestManifest(\"widgets.example.test\", \"widgets\", 3, map[string][]app.ManifestVersionKindEmbedField{\"v1\": {}}),","+\t\ttestManifest(\"widgets.example.test\", \"gadgets\", 3, map[string][]app.ManifestVersionKindEmbedField{\"v1\": {}}),","+\t\ttestManifest(\"widgets.example.test\", \"excluded\", 3, map[string][]app.ManifestVersionKindEmbedField{\"v1\": {}}),","+\t}","+\tconfigs := resource.NewEmbeddingConfigRegistry(manifests)","+\tregistry, err := New(configs, []string{\"dashboard.grafana.app/dashboards\", \"widgets.example.test/widgets\", \"widgets.example.test/gadgets\"}, []embed.Builder{","+\t\tdashboard.New(), &testCustomBuilder{group: \"widgets.example.test\", resource: \"custom\"},"],"additions":132,"deletions":0,"truncated":false}],"additions":596,"deletions":3,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-09-22T12:51:12.245744+00:00"}