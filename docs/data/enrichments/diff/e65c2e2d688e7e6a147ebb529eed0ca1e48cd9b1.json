{"id":"e65c2e2d688e7e6a147ebb529eed0ca1e48cd9b1","axis":"silent","repo":"ray-project/ray","sha":"e65c2e2d688e7e6a147ebb529eed0ca1e48cd9b1","parsed":{"files":[{"path":"doc/source/serve/api/llm.md","lines":["@@ -23,6 +23,7 @@ The `ray.serve.llm` module builds and configures Serve applications that serve l"," ","    serve.llm.build_llm_deployment","    serve.llm.build_openai_app","+   serve.llm.mx.build_mx_app"," ```"," "," ## Configs"],"additions":1,"deletions":0,"truncated":false},{"path":"docker/ray-llm/Dockerfile","lines":["@@ -1,8 +1,53 @@"," # syntax=docker/dockerfile:1.3-labs"," "," ARG BASE_IMAGE","+","+# Build the ModelExpress (MX) server on the same base image, so the binary links","+# against the final image's glibc, and the matching Python client wheel from the","+# same commit; only these two are copied into the final image.","+FROM \"$BASE_IMAGE\" AS mx-server-builder","+","+ARG MODELEXPRESS_REF=\"e865b20f2771f594b06dede75fc6ef0718af186e\"","+ARG PROTOC_VERSION=\"29.3\"","+","+RUN <<EOF","+#!/bin/bash","+","+set -euo pipefail","+","+cd \"$HOME\"","+# The base image has wget but not curl.","+wget -qO- https://sh.rustup.rs | sh -s -- -y --profile minimal","+PROTOC_ARCH=\"$(uname -m)\"","+if [[ \"${PROTOC_ARCH}\" == \"aarch64\" ]]; then","+    PROTOC_ARCH=\"aarch_64\"","+fi","+wget -qO protoc.zip \\","+    \"https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip\"","+python -m zipfile -e protoc.zip protoc","+chmod +x protoc/bin/protoc","+","+git init -q modelexpress","+cd modelexpress","+git fetch -q --depth 1 https://github.com/ai-dynamo/modelexpress.git \"${MODELEXPRESS_REF}\"","+git checkout -q FETCH_HEAD","+","+# Redis and Kubernetes metadata backends are built by default; `memory`","+# (single server, no external store) needs the feature.","+PROTOC=\"$HOME/protoc/bin/protoc\" \"$HOME/.cargo/bin/cargo\" build --release \\","+    -p modelexpress-server --features memory-backend --bin modelexpress-server","+","+python -m pip wheel --no-deps --wheel-dir \"$HOME/mx-wheel\" modelexpress_client/python","+EOF","+"," FROM \"$BASE_IMAGE\""," ","+# Default for RAY_MX_SERVER_BINARY_PATH","+# (python/ray/llm/_internal/serve/serving_patterns/model_express/envs.py).","+COPY --from=mx-server-builder /home/ray/modelexpress/target/release/modelexpress-server \\","+    /usr/local/bin/modelexpress-server","+COPY --from=mx-server-builder /home/ray/mx-wheel/ ./mx-wheel/","+"," COPY python/deplocks/llm/rayllm_*.lock ./"," COPY python/requirements/llm/patches/vllm-device-aware-compile-cache.patch \\","     python/requirements/llm/patches/vllm-preserve-model-eos-tokens.patch \\","@@ -45,6 +90,11 @@ uv pip install --system --no-cache-dir --no-deps \\","     --no-verify-hashes \\","     -r \"rayllm_${PYTHON_CODE}_${CUDA_CODE}.lock\""," ","+# The MX client that load_format=\"modelexpress\" imports, from the same commit as","+# the server binary. Its import-time dependencies are already installed;","+# runai-model-streamer (streaming weights from object storage) is not.","+uv pip install --system --no-cache-dir --no-deps ./mx-wheel/modelexpress-*.whl","+"," # Include the CUDA device index in vLLM's compile cache paths so a worker never"," # reloads a torch.compile artifact built for a different physical GPU."," # vllm-project/vllm#38962 was reverted by #53304; still needed in vLLM 0.32.0."],"additions":50,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/common/utils/download_utils.py","lines":["@@ -20,6 +20,9 @@"," logger = get_logger(__name__)"," "," STREAMING_LOAD_FORMATS = [\"runai_streamer\", \"runai_streamer_sharded\", \"tensorizer\"]","+# ModelExpress pulls weights from a serving peer or streams them itself, so nodes","+# only need the non-weight files locally.","+MODEL_EXPRESS_LOAD_FORMATS = [\"modelexpress\", \"mx\"]"," "," "," class NodeModelDownloadable(enum.Enum):"],"additions":3,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/__init__.py","lines":["@@ -9,6 +9,13 @@"," "," "," def _worker_process_setup_hook():","-    \"\"\"Noop setup hook used for ENABLE_WORKER_PROCESS_SETUP_HOOK","+    \"\"\"Setup hook used for ENABLE_WORKER_PROCESS_SETUP_HOOK","     (see python/ray/llm/_internal/serve/configs/constants.py).\"\"\"","-    pass","+    # TODO(kourosh): Remove with compile_cache_compat.","+    try:","+        import vllm  # noqa: F401","+    except ImportError:","+        return","+    from ray.llm._internal.serve.engines.vllm.patches import compile_cache_compat","+","+    compile_cache_compat.apply()"],"additions":9,"deletions":2,"truncated":false},{"path":"python/ray/llm/_internal/serve/core/configs/llm_config.py","lines":["@@ -27,6 +27,7 @@","     is_remote_path,"," )"," from ray.llm._internal.common.utils.download_utils import (","+    MODEL_EXPRESS_LOAD_FORMATS,","     STREAMING_LOAD_FORMATS,","     NodeModelDownloadable,"," )","@@ -348,8 +349,11 @@ def get_or_create_callback(self) -> Optional[CallbackBase]:","         assert engine_config is not None","         pg = engine_config.get_or_create_pg()","         runtime_env = engine_config.get_runtime_env_with_local_env_vars()","-        if self.engine_kwargs.get(\"load_format\", None) in STREAMING_LOAD_FORMATS:","+        load_format = self.engine_kwargs.get(\"load_format\", None)","+        if load_format in STREAMING_LOAD_FORMATS:","             worker_node_download_model = NodeModelDownloadable.NONE","+        elif load_format in MODEL_EXPRESS_LOAD_FORMATS:","+            worker_node_download_model = NodeModelDownloadable.EXCLUDE_SAFETENSORS","         else:","             worker_node_download_model = NodeModelDownloadable.MODEL_AND_TOKENIZER"," "],"additions":5,"deletions":1,"truncated":false},{"path":"python/ray/llm/_internal/serve/engines/vllm/model_express.py","lines":["@@ -0,0 +1,149 @@","+\"\"\"ModelExpress (MX) integration for the vLLM engine.","+","+With ``load_format=\"modelexpress\"`` a new replica loads its weights (and JIT","+caches) from an already-serving peer over NIXL instead of from storage. The MX","+client runs inside vLLM's workers and only reads environment variables, so this","+module's job is to set those variables in the replica process before the engine","+starts, and to expose the readiness signal MX waits for before publishing the","+replica's JIT caches.","+\"\"\"","+","+import http.server","+import logging","+import os","+import threading","+from typing import Optional","+","+import ray","+from ray import serve","+from ray.llm._internal.common.utils.download_utils import MODEL_EXPRESS_LOAD_FORMATS","+from ray.llm._internal.serve.core.configs.llm_config import LLMConfig","+from ray.llm._internal.serve.engines.vllm.vllm_models import VLLMEngineConfig","+from ray.llm._internal.serve.serving_patterns.model_express.envs import (","+    get_mx_app_name,","+    get_mx_metadata_port_base,","+    get_mx_worker_grpc_port_base,","+)","+from ray.llm._internal.serve.serving_patterns.model_express.mx_server import (","+    MX_SERVER_DEPLOYMENT_NAME,","+)","+from ray.serve._private.constants import SERVE_LOGGER_NAME","+","+logger = logging.getLogger(SERVE_LOGGER_NAME)","+","+# The MX client's env vars. vLLM copies only a fixed set of env prefixes into","+# its Ray workers, so these are added to that set.","+_MX_ENV_PREFIXES = (\"MX_\", \"MODEL_EXPRESS_\")","+","+_engine_ready = threading.Event()","+_ready_server: Optional[http.server.ThreadingHTTPServer] = None","+","+","+def is_model_express(llm_config: LLMConfig) -> bool:","+    return llm_config.engine_kwargs.get(\"load_format\") in MODEL_EXPRESS_LOAD_FORMATS","+","+","+async def _mx_server_address(app_name: str) -> str:","+    try:","+        handle = serve.get_deployment_handle(","+            MX_SERVER_DEPLOYMENT_NAME, app_name=app_name","+        )","+    except KeyError as e:","+        raise RuntimeError(","+            f\"load_format='modelexpress' needs the MX server app {app_name!r}, which \"","+            \"isn't deployed. Deploy ray.serve.llm.mx:build_mx_app under that name, \"","+            \"or set RAY_MX_APP_NAME to its name.\"","+        ) from e","+    return await handle.address.remote()","+","+","+def _check_whole_gpus(llm_config: LLMConfig) -> None:","+    \"\"\"MX registers each worker's GPU with NIXL and transfers whole GPU state, so","+    workers can't share a GPU.\"\"\"","+    env_vars = (llm_config.runtime_env or {}).get(\"env_vars\") or {}","+    per_worker = env_vars.get(\"VLLM_RAY_PER_WORKER_GPUS\")","+    if per_worker is not None and float(per_worker) >= 1:","+        return","+    fraction = per_worker or VLLMEngineConfig._detect_fractional_gpu_from_pg(","+        llm_config.placement_group_config","+    )","+    if fraction is not None:","+        raise ValueError(","+            f\"load_format={llm_config.engine_kwargs['load_format']!r} doesn't \"","+            f\"support fractional GPUs (got {fraction} GPU per worker). Give each \"","+            \"vLLM worker a whole GPU, or use another load_format.\"","+        )","+","+","+def _set_default(name: str, value: str) -> None:","+    if name not in os.environ:","+        os.environ[name] = value","+","+","+def _append_env_prefixes_to_copy() -> None:","+    key = \"VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY\"","+    prefixes = [p for p in os.environ.get(key, \"\").split(\",\") if p]","+    prefixes += [p for p in _MX_ENV_PREFIXES if p not in prefixes]","+    os.environ[key] = \",\".join(prefixes)","+","+","+class _ReadyHandler(http.server.BaseHTTPRequestHandler):","+    # http.server dispatches GET requests to a method with exactly this name.","+    def do_GET(self):","+        self.send_response(200 if _engine_ready.is_set() else 503)","+        self.end_headers()","+","+    def log_message(self, format, *args):","+        pass","+","+","+def _start_ready_server(host: str) -> int:","+    \"\"\"Serve the readiness endpoint on a free port; returns the port.\"\"\"","+    global _ready_server","+    if _ready_server is None:","+        _ready_server = http.server.ThreadingHTTPServer((host, 0), _ReadyHandler)","+        threading.Thread(","+            target=_ready_server.serve_forever, name=\"mx-ready-server\", daemon=True","+        ).start()","+    return _ready_server.server_address[1]","+","+","+async def setup_model_express(llm_config: LLMConfig) -> None:","+    \"\"\"Configure the MX client for this replica. Runs before the engine starts.\"\"\"","+    _check_whole_gpus(llm_config)","+    engine_config = llm_config.get_engine_config()","+    node_ip = ray.util.get_node_ip_address()","+","+    if \"MX_SERVER_ADDRESS\" not in os.environ:","+        os.environ[\"MX_SERVER_ADDRESS\"] = await _mx_server_address(get_mx_app_name())","+    # MX adds each worker's device index to these. vLLM's Ray workers address","+    # GPUs by physical index, so the ports are unique per node without an offset.","+    _set_default(\"MX_METADATA_PORT\", str(get_mx_metadata_port_base()))","+    _set_default(\"MX_WORKER_GRPC_PORT\", str(get_mx_worker_grpc_port_base()))","+    # Leave MX_WORKER_HOST unset: vLLM copies the replica's MX_* env into every","+    # worker, and workers can span nodes, so each worker's MX client detects","+    # its own host instead.","+    # Node init may rewrite hf_model_id to a local path; keep the P2P identity","+    # on the model id so every replica matches.","+    _set_default(\"MX_MODEL_NAME_OVERRIDE\", engine_config.actual_hf_model_id)","+    if engine_config.mirror_config and engine_config.mirror_config.bucket_uri:","+        # Cold start with no peer streams the weights from the mirror.","+        _set_default(\"MX_MODEL_URI\", engine_config.mirror_config.bucket_uri)","+","+    _set_default(\"MX_ARTIFACT_TRANSFER\", \"1\")","+    _set_default(\"MX_ARTIFACT_BACKEND\", \"nixl\")","+    ready_port = _start_ready_server(node_ip)","+    os.environ[\"MX_ARTIFACT_READY_URL\"] = f\"http://{node_ip}:{ready_port}/ready\"","+","+    _append_env_prefixes_to_copy()","+    mx_env = \" \".join(","+        f\"{name}={value}\"","+        for name, value in sorted(os.environ.items())","+        if name.startswith(_MX_ENV_PREFIXES)","+    )","+    logger.info(\"ModelExpress enabled: %s\", mx_env)","+","+","+def mark_engine_ready() -> None:","+    \"\"\"Let MX publish this replica's JIT caches; call once the engine has started.\"\"\"","+    _engine_ready.set()"],"additions":149,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/engines/vllm/patches/__init__.py","lines":[],"additions":0,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/engines/vllm/patches/compile_cache_compat.py","lines":["@@ -0,0 +1,124 @@","+\"\"\"Backport: device-neutral torch.compile cache for vLLM's Ray workers.","+","+TODO(kourosh): Once Ray Serve LLM requires a vLLM with","+https://github.com/vllm-project/vllm/pull/63247 (and torch >= 2.14), replace","+this module with setting VLLM_COMPILE_ON_ONE_RANK=1.","+","+vLLM's Ray executor runs a replica's rank 0 on its physical GPU (cuda:1 for a","+replica placed on GPU 1), while the compile cache is keyed by rank. Inductor","+bakes the compile-time device index into the cached code and kernels, so a","+replica reusing a cache built by a replica on another GPU index crashes with","+\"CUDA driver error: invalid argument\". The vLLM fix uses torch's","+compile_on_one_rank mode behind the opt-in VLLM_COMPILE_ON_ONE_RANK, which this","+module turns on; torch 2.13 does not have the mode, so on torch 2.13 this","+module patches the two places Inductor bakes the device instead.","+","+`apply` runs in each vLLM worker process from Serve LLM's","+worker_process_setup_hook.","+\"\"\"","+","+import logging","+import os","+import re","+","+logger = logging.getLogger(__name__)","+","+# Generated wrapper code pins the compile-time device; resolve it at run time.","+_DEVICE_LITERALS = re.compile(","+    r\"(torch\\.cuda\\._DeviceGuard|torch\\.cuda\\.set_device|(?<![\\w.])get_raw_stream)\\(\\d+\\)\"","+)","+_CURRENT_DEVICE = \"__import__('torch').cuda.current_device()\"","+","+","+def apply() -> None:","+    import torch","+    import vllm.envs as envs","+    from torch.compiler import config as compiler_config","+","+    if hasattr(compiler_config, \"compile_on_one_rank\"):","+        if hasattr(envs, \"VLLM_COMPILE_ON_ONE_RANK\"):","+            # vLLM applies the mode during its compile and keys its cache on","+            # it, but leaves it off by default.","+            os.environ.setdefault(\"VLLM_COMPILE_ON_ONE_RANK\", \"1\")","+            return","+        compiler_config.compile_on_one_rank = True","+    elif torch.__version__.startswith(\"2.13.\"):","+        _patch_codegen()","+        _patch_static_launcher()","+    else:","+        logger.warning(","+            \"No device-neutral compile cache backport for torch %s; \"","+            \"replicas on different GPU indices must not share a compile cache.\",","+            torch.__version__,","+        )","+        return","+    _add_compile_cache_factor(envs)","+    logger.info(","+        \"Device-neutral compile cache backport applied (torch %s).\", torch.__version__","+    )","+","+","+def _rewrite(source_code: str) -> str:","+    return _DEVICE_LITERALS.sub(rf\"\\1({_CURRENT_DEVICE})\", source_code)","+","+","+def _patch_codegen() -> None:","+    # The wrapper and kernel modules are written and loaded through PyCodeCache,","+    # and the compile cache stores the source as written, so rewriting here also","+    # makes the cached copy device-neutral.","+    from torch._inductor.codecache import PyCodeCache","+","+    write, load = PyCodeCache.write.__func__, PyCodeCache.load.__func__","+","+    def patched_write(cls, source_code, *args, **kwargs):","+        return write(cls, _rewrite(source_code), *args, **kwargs)","+","+    def patched_load(cls, source_code, *args, **kwargs):","+        return load(cls, _rewrite(source_code), *args, **kwargs)","+","+    PyCodeCache.write = classmethod(patched_write)","+    PyCodeCache.load = classmethod(patched_load)","+","+","+def _patch_static_launcher() -> None:","+    # Cached kernels are loaded into one device's CUDA context when the cache is","+    # restored; load them into the device they are launched on instead.","+    import torch","+    from torch._inductor.runtime.static_triton_launcher import (","+        StaticallyLaunchedCudaKernel as Kernel,","+    )","+","+    load_kernel, run = Kernel.load_kernel, Kernel.run","+","+    def patched_load_kernel(self, device):","+        if self.function is not None:","+            return","+        cubin_path = self.cubin_path","+        load_kernel(self, device)","+        self._cubin_path_for_devices = cubin_path","+        self._handles_by_device = {device: (self.module, self.function)}","+","+    def patched_run(self, *args, **kwargs):","+        handles = getattr(self, \"_handles_by_device\", None)","+        if handles is not None and self._cubin_path_for_devices is not None:","+            device = torch.cuda.current_device()","+            if device not in handles:","+                module, function, _, _ = self.C_impl._load_kernel(","+                    self._cubin_path_for_devices, self.name, self.shared, device","+                )","+                handles[device] = (module, function)","+            self.module, self.function = handles[device]","+        return run(self, *args, **kwargs)","+","+    Kernel.load_kernel = patched_load_kernel","+    Kernel.run = patched_run","+","+","+def _add_compile_cache_factor(envs) -> None:","+    # Caches compiled before the backport bake in device indices; never reuse them.","+    compile_factors = envs.compile_factors","+","+    def patched_compile_factors():","+        return {**compile_factors(), \"RAY_LLM_DEVICE_NEUTRAL_COMPILE\": True}","+","+    envs.compile_factors = patched_compile_factors"],"additions":124,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/engines/vllm/vllm_engine.py","lines":["@@ -54,6 +54,11 @@"," )"," from ray.llm._internal.serve.core.engine.protocol import LLMEngine"," from ray.llm._internal.serve.core.protocol import RawRequestInfo","+from ray.llm._internal.serve.engines.vllm.model_express import (","+    is_model_express,","+    mark_engine_ready,","+    setup_model_express,","+)"," from ray.llm._internal.serve.engines.vllm.vllm_models import VLLMEngineConfig"," from ray.llm._internal.serve.observability.logging import get_logger"," from ray.llm._internal.serve.routing_policies.kv_aware import (","@@ -400,6 +405,9 @@ async def start(self) -> None:"," ","         from vllm.entrypoints.openai.api_server import init_app_state"," ","+        if is_model_express(self.llm_config):","+            await setup_model_express(self.llm_config)","+","         callback = self.llm_config.get_or_create_callback()","         await callback.run_callback(\"on_before_node_init\")","         if callback.ctx.run_init_node:","@@ -483,6 +491,8 @@ async def start(self) -> None:","         self._routing_stats.update(prompt_token_stats)"," ","         self._running = True","+        if is_model_express(self.llm_config):","+            mark_engine_ready()"," ","         logger.info(\"Started vLLM engine.\")"," "],"additions":10,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/serving_patterns/model_express/__init__.py","lines":[],"additions":0,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/serving_patterns/model_express/builder.py","lines":["@@ -0,0 +1,20 @@","+from typing import Optional","+","+from ray import serve","+from ray.llm._internal.serve.serving_patterns.model_express.mx_server import (","+    ModelExpressServer,","+)","+","+","+def build_model_express_app(builder_config: Optional[dict] = None) -> serve.Application:","+    \"\"\"Build the `mx` app. Deploy it with ``route_prefix=None``.","+","+    Takes one dict so it also works as a Serve config ``import_path`` builder.","+","+    Args:","+        builder_config: Keyword arguments for ``ModelExpressServer``.","+","+    Returns:","+        The `mx` application.","+    \"\"\"","+    return ModelExpressServer.bind(**(builder_config or {}))"],"additions":20,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/serving_patterns/model_express/envs.py","lines":["@@ -0,0 +1,62 @@","+import os","+","+# How often Serve health-checks the MX server replica.","+MX_SERVER_HEALTH_CHECK_PERIOD_S = float(","+    os.environ.get(\"RAY_MX_SERVER_HEALTH_CHECK_PERIOD_S\", \"10\")","+)","+","+","+def get_mx_server_binary() -> str:","+    \"\"\"Path of the MX server binary.","+","+    The ray-llm image installs it at /usr/local/bin/modelexpress-server","+    (docker/ray-llm/Dockerfile); set RAY_MX_SERVER_BINARY_PATH for a custom image.","+","+    Returns:","+        The binary's path.","+    \"\"\"","+    return os.environ.get(","+        \"RAY_MX_SERVER_BINARY_PATH\", \"/usr/local/bin/modelexpress-server\"","+    )","+","+","+def get_mx_app_name() -> str:","+    \"\"\"Name of the Serve app that runs the MX server.","+","+    LLM replicas look the server up in this app; set RAY_MX_APP_NAME when","+    deploying it under another name.","+","+    Returns:","+        The app name.","+    \"\"\"","+    return os.environ.get(\"RAY_MX_APP_NAME\", \"mx\")","+","+","+def get_mx_metadata_port_base() -> int:","+    \"\"\"Base of the LLM replicas' MX NIXL metadata ports (RAY_MX_METADATA_PORT_BASE).","+","+    Returns:","+        The base port; MX adds each worker's GPU index.","+    \"\"\"","+    return int(os.environ.get(\"RAY_MX_METADATA_PORT_BASE\", \"15555\"))","+","+","+def get_mx_worker_grpc_port_base() -> int:","+    \"\"\"Base of the LLM replicas' MX worker gRPC ports (RAY_MX_WORKER_GRPC_PORT_BASE).","+","+    Returns:","+        The base port; MX adds each worker's GPU index.","+    \"\"\"","+    return int(os.environ.get(\"RAY_MX_WORKER_GRPC_PORT_BASE\", \"16555\"))","+","+","+def get_mx_server_port() -> int:","+    \"\"\"gRPC port of the MX server.","+","+    The server listens on it and advertises it to LLM replicas, so set","+    RAY_MX_SERVER_PORT cluster-wide when overriding it.","+","+    Returns:","+        The port.","+    \"\"\"","+    return int(os.environ.get(\"RAY_MX_SERVER_PORT\", \"8931\"))"],"additions":62,"deletions":0,"truncated":false},{"path":"python/ray/llm/_internal/serve/serving_patterns/model_express/mx_server.py","lines":["@@ -0,0 +1,92 @@","+\"\"\"The ModelExpress (MX) server as a Serve deployment.","+","+One replica runs the MX server binary. It is a registry of serving peers: LLM","+replicas publish themselves to it and look up sources in it, while weights and","+JIT caches move directly between LLM replicas. LLM replicas find the server","+through this deployment's ``address()``, so they don't depend on where it runs.","+The server's output goes to this replica's log.","+\"\"\"","+","+import os","+import socket","+import subprocess","+import time","+","+import ray","+from ray import serve","+from ray._common.constants import HEAD_NODE_RESOURCE_NAME","+from ray.llm._internal.serve.serving_patterns.model_express.envs import (","+    MX_SERVER_HEALTH_CHECK_PERIOD_S,","+    get_mx_server_binary,","+    get_mx_server_port,","+)","+","+MX_SERVER_DEPLOYMENT_NAME = \"ModelExpressServer\"","+","+","+def _port_in_use(port: int) -> bool:","+    try:","+        socket.create_connection((\"127.0.0.1\", port), timeout=1).close()","+        return True","+    except OSError:","+        return False","+","+","+@serve.deployment(","+    name=MX_SERVER_DEPLOYMENT_NAME,","+    num_replicas=1,","+    # Like the Serve controller: on the head node, and schedulable when the head","+    # advertises no CPUs.","+    ray_actor_options={\"num_cpus\": 0, \"resources\": {HEAD_NODE_RESOURCE_NAME: 0.001}},","+    health_check_period_s=MX_SERVER_HEALTH_CHECK_PERIOD_S,","+)","+class ModelExpressServer:","+    def __init__(self, metadata_backend: str = \"memory\", startup_timeout_s: float = 60):","+        \"\"\"Start the MX server.","+","+        Args:","+            metadata_backend: \"memory\" or \"redis\". For \"redis\", set REDIS_URL","+                in the replica's environment.","+            startup_timeout_s: How long to wait for the port to be free and","+                then for the server to listen on it.","+        \"\"\"","+        binary = get_mx_server_binary()","+        if not os.access(binary, os.X_OK):","+            raise FileNotFoundError(","+                f\"MX server binary not found at {binary}. Set \"","+                \"RAY_MX_SERVER_BINARY_PATH when not using the ray-llm image.\"","+            )","+        port = get_mx_server_port()","+        env = dict(os.environ)","+        env.update(","+            MX_METADATA_BACKEND=metadata_backend,","+            MODEL_EXPRESS_SERVER_PORT=str(port),","+            MODEL_EXPRESS_SERVER_METRICS_PORT=\"0\",","+        )","+        deadline = time.monotonic() + startup_timeout_s","+        # A rolling update starts this replica while the one it replaces may","+        # still hold the port; starting now would fail to bind.","+        while _port_in_use(port):","+            if time.monotonic() > deadline:","+                raise TimeoutError(f\"Port {port} for the MX server is still in use\")","+            time.sleep(0.5)","+","+        self._proc = subprocess.Popen([binary], env=env)","+        self._address = f\"{ray.util.get_node_ip_address()}:{port}\"","+        while not _port_in_use(port):","+            self.check_health()","+            if time.monotonic() > deadline:","+                raise TimeoutError(f\"MX server did not listen on :{port}\")","+            time.sleep(0.5)","+        self.check_health()","+","+    def check_health(self):","+        if self._proc.poll() is not None:","+            raise RuntimeError(f\"MX server exited with code {self._proc.returncode}\")","+","+    def address(self) -> str:","+        return self._address","+","+    def __del__(self):","+        if getattr(self, \"_proc\", None) and self._proc.poll() is None:","+            self._proc.terminate()"],"additions":92,"deletions":0,"truncated":false},{"path":"python/ray/llm/tests/serve/cpu/deployments/llm/vllm/test_model_express.py","lines":["@@ -0,0 +1,332 @@","+import asyncio","+import importlib","+import os","+import socket","+import sys","+import threading","+import urllib.error","+import urllib.request","+from types import SimpleNamespace","+from unittest.mock import patch","+","+import pytest","+","+from ray.llm._internal.serve.engines.vllm import model_express","+from ray.llm._internal.serve.engines.vllm.patches.compile_cache_compat import _rewrite","+from ray.llm._internal.serve.serving_patterns.model_express import envs as mx_envs","+from ray.llm._internal.serve.serving_patterns.model_express.mx_server import (","+    ModelExpressServer,","+)","+from ray.serve.llm import LLMConfig","+from ray.serve.llm.mx import build_mx_app","+","+MX_ADDRESS = \"10.0.0.1:41000\"","+","+","+def _free_port() -> int:","+    with socket.socket() as s:","+        s.bind((\"127.0.0.1\", 0))","+        return s.getsockname()[1]","+","+","+@pytest.fixture(autouse=True)","+def reset_ready_server():","+    \"\"\"Reset the module's process-wide ready server between tests.\"\"\"","+    yield","+    if model_express._ready_server is not None:","+        model_express._ready_server.shutdown()","+        model_express._ready_server.server_close()","+    model_express._ready_server = None","+    model_express._engine_ready.clear()","+","+","+def _llm_config() -> LLMConfig:","+    return LLMConfig(","+        model_loading_config=dict(model_id=\"Qwen/Qwen3-0.6B\"),","+        engine_kwargs=dict(load_format=\"modelexpress\", tensor_parallel_size=2),","+    )","+","+","+def _setup(env: dict):","+    \"\"\"Run setup_model_express; returns the env and the app names looked up.\"\"\"","+    looked_up = []","+","+    def get_deployment_handle(deployment_name, app_name):","+        looked_up.append((deployment_name, app_name))","+","+        async def address():","+            return MX_ADDRESS","+","+        return SimpleNamespace(address=SimpleNamespace(remote=address))","+","+    with patch.dict(\"os.environ\", env, clear=True), patch(","+        \"ray.serve.get_deployment_handle\", get_deployment_handle","+    ), patch(\"ray.util.get_node_ip_address\", return_value=\"127.0.0.1\"):","+        asyncio.run(model_express.setup_model_express(_llm_config()))","+        return dict(os.environ), looked_up","+","+","+def test_is_model_express():","+    assert model_express.is_model_express(_llm_config())","+    assert not model_express.is_model_express(","+        LLMConfig(model_loading_config=dict(model_id=\"Qwen/Qwen3-0.6B\"))","+    )","+","+","+@pytest.mark.parametrize(","+    \"extra\",","+    [","+        dict(placement_group_config=dict(bundles=[{\"GPU\": 0.49}])),","+        dict(runtime_env=dict(env_vars={\"VLLM_RAY_PER_WORKER_GPUS\": \"0.5\"})),","+    ],","+)","+def test_setup_rejects_fractional_gpus(extra):","+    llm_config = LLMConfig(","+        model_loading_config=dict(model_id=\"Qwen/Qwen3-0.6B\"),","+        engine_kwargs=dict(load_format=\"modelexpress\"),","+        **extra,","+    )","+    with pytest.raises(ValueError, match=\"fractional GPUs\"):","+        asyncio.run(model_express.setup_model_express(llm_config))","+","+","+def test_setup_without_mx_app():","+    def get_deployment_handle(deployment_name, app_name):","+        raise KeyError(f\"{deployment_name} in {app_name} does not exist.\")","+","+    with patch.dict(\"os.environ\", {}, clear=True), patch(","+        \"ray.serve.get_deployment_handle\", get_deployment_handle","+    ), patch(\"ray.util.get_node_ip_address\", return_value=\"127.0.0.1\"):","+        with pytest.raises(RuntimeError, match=\"build_mx_app\"):","+            asyncio.run(model_express.setup_model_express(_llm_config()))","+","+","+def test_setup_sets_client_env():","+    env, looked_up = _setup(env={})","+","+    # The server's address comes from the `mx` app's deployment.","+    assert looked_up == [(\"ModelExpressServer\", \"mx\")]","+    assert env[\"MX_SERVER_ADDRESS\"] == MX_ADDRESS","+    # MX adds each worker's GPU index to the bases.","+    assert env[\"MX_METADATA_PORT\"] == \"15555\"","+    assert env[\"MX_WORKER_GRPC_PORT\"] == \"16555\"","+    # Copied to every vLLM worker, which can be on other nodes; MX detects it.","+    assert \"MX_WORKER_HOST\" not in env","+    assert env[\"MX_MODEL_NAME_OVERRIDE\"] == \"Qwen/Qwen3-0.6B\"","+    assert env[\"MX_ARTIFACT_TRANSFER\"] == \"1\"","+    # The ready endpoint listens on the port in the URL.","+    ready_port = model_express._ready_server.server_address[1]","+    assert env[\"MX_ARTIFACT_READY_URL\"] == f\"http://127.0.0.1:{ready_port}/ready\"","+    # vLLM only copies listed env prefixes into its Ray workers.","+    prefixes = env[\"VLLM_RAY_EXTRA_ENV_VAR_PREFIXES_TO_COPY\"].split(\",\")","+    assert {\"MX_\", \"MODEL_EXPRESS_\"} <= set(prefixes)","+","+","+def test_setup_uses_configured_env():","+    env, looked_up = _setup(","+        env={","+            \"RAY_MX_APP_NAME\": \"mx-2\",","+            \"RAY_MX_METADATA_PORT_BASE\": \"25555\",","+            \"RAY_MX_WORKER_GRPC_PORT_BASE\": \"26555\",","+        },","+    )","+    assert looked_up == [(\"ModelExpressServer\", \"mx-2\")]","+    assert env[\"MX_METADATA_PORT\"] == \"25555\"","+    assert env[\"MX_WORKER_GRPC_PORT\"] == \"26555\"","+","+","+def test_setup_logs_mx_env():","+    with patch.object(model_express.logger, \"info\") as info:","+        env, _ = _setup(env={\"OTHER\": \"x\"})","+    message = info.call_args.args[0] % info.call_args.args[1:]","+    logged = dict(item.split(\"=\", 1) for item in message.split(\": \", 1)[1].split())","+    assert logged == {","+        name: value","+        for name, value in env.items()","+        if name.startswith((\"MX_\", \"MODEL_EXPRESS_\"))"],"additions":146,"deletions":0,"truncated":false}],"additions":671,"deletions":3,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-11-05T16:28:15.150733+00:00"}