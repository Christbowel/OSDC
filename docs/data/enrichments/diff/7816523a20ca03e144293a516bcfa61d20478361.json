aFormat<string>(new StringSerializer(), new ArrayOnlyDataProtector(protector));","+","+        var input = new string('a', length) + \"\\u00e9\\u4e2d\";","+","+        Assert.Equal(input, arrayFormat.Unprotect(spanFormat.Protect(input)));","+        Assert.Equal(input, spanFormat.Unprotect(arrayFormat.Protect(input)));","+        Assert.Equal(input, arrayFormat.Unprotect(spanFormat.Protect(input, \"purpose1\"), \"purpose1\"));","+        Assert.Equal(input, spanFormat.Unprotect(arrayFormat.Protect(input, \"purpose1\"), \"purpose1\"));","+    }","+","+    [Fact]","+    public void UnprotectAcceptsStandardBase64()","+    {","+        var protector = ServiceProvider.GetRequiredService<IDataProtectionProvider>().CreateProtector(\"test\");","+        var secureDataFormat = new SecureDataFormat<string>(new StringSerializer(), protector);","+","+        var input = \"abcdefghijklmnopqrstuvwxyz0123456789\";","+        var found = false;","+        for (var i = 0; i < 100 && !found; i++)","+        {","+            // Ciphertext is random, so retry until the standard base64 form contains characters base64url does not allow.","+            var base64 = Convert.ToBase64String(protector.Protect(Encoding.UTF8.GetBytes(input)));","+            if (base64.AsSpan().IndexOfAny('+', '/') >= 0)","+            {","+                found = true;","+                Assert.Equal(input, secureDataFormat.Unprotect(base64));","+            }","+        }","+","+        Assert.True(found);","+    }","+","+    [Theory]","+    [InlineData(\"\")]","+    [InlineData(\"a\")]","+    [InlineData(\"!!!!\")]","+    [InlineData(\"ab+c-d\")]","+    [InlineData(\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\")]","+    public void UnprotectReturnsNullForInvalidInput(string protectedText)","+    {","+        var protector = ServiceProvider.GetRequiredService<IDataProtectionProvider>().CreateProtector(\"test\");","+        var spanFormat = new SecureDataFormat<string>(new StringSerializer(), protector);","+        var arrayFormat = new SecureDataFormat<string>(new StringSerializer(), new ArrayOnlyDataProtector(protector));","+","+        Assert.Null(spanFormat.Unprotect(protectedText));","+        Assert.Null(arrayFormat.Unprotect(protectedText));","+        Assert.Null(spanFormat.Unprotect(null));","+    }","+","+    private class ArrayOnlyDataProtector : IDataProtector","+    {","+        private readonly IDataProtector _inner;","+","+        public ArrayOnlyDataProtector(IDataProtector inner) => _inner = inner;","+","+        public IDataProtector CreateProtector(string purpose) => new ArrayOnlyDataProtector(_inner.CreateProtector(purpose));","+","+        public byte[] Protect(byte[] plaintext) => _inner.Protect(plaintext);","+","+        public byte[] Unprotect(byte[] protectedData) => _inner.Unprotect(protectedData);","+    }","+","     private class StringSerializer : IDataSerializer<string>","     {","         public byte[] Serialize(string model)"],"additions":84,"deletions":0,"truncated":false},{"path":"src/Security/perf/Microbenchmarks/CookieAuthenticationBenchmark.cs","lines":["@@ -0,0 +1,96 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.Security.Claims;","+using BenchmarkDotNet.Attributes;","+using Microsoft.AspNetCore.Authentication;","+using Microsoft.AspNetCore.Authentication.Cookies;","+using Microsoft.AspNetCore.DataProtection;","+using Microsoft.AspNetCore.Http;","+using Microsoft.Extensions.DependencyInjection;","+using Microsoft.Extensions.Logging;","+using Microsoft.Extensions.Logging.Abstractions;","+","+namespace Microsoft.AspNetCore.Security;","+","+[MemoryDiagnoser]","+public class CookieAuthenticationBenchmark","+{","+    private IServiceProvider _services;","+    private IServiceScopeFactory _scopeFactory;","+    private string _cookieHeader;","+    private string _chunkedCookieHeader;","+","+    [GlobalSetup]","+    public void GlobalSetup()","+    {","+        var services = new ServiceCollection();","+        services.AddSingleton<ILoggerFactory>(NullLoggerFactory.Instance);","+        services.AddSingleton(typeof(ILogger<>), typeof(NullLogger<>));","+        services.AddDataProtection().UseEphemeralDataProtectionProvider();","+        services.AddAuthentication(CookieAuthenticationDefaults.AuthenticationScheme).AddCookie();","+        services.AddAuthentication().AddCookie(\"chunked\", o => o.Cookie.Name = \"Big\");","+        _services = services.BuildServiceProvider();","+        _scopeFactory = _services.GetRequiredService<IServiceScopeFactory>();","+","+        _cookieHeader = SignIn(CookieAuthenticationDefaults.AuthenticationScheme, 10);","+        _chunkedCookieHeader = SignIn(\"chunked\", 120);","+","+        if (!Authenticate().GetAwaiter().GetResult() || !AuthenticateChunked().GetAwaiter().GetResult())","+        {","+            throw new InvalidOperationException(\"Authentication failed.\");","+        }","+    }","+","+    private string SignIn(string scheme, int claimCount)","+    {","+        var claims = new List<Claim> { new Claim(ClaimTypes.Name, \"bob\"), new Claim(ClaimTypes.NameIdentifier, \"0f8fad5b-d9cb-469f-a165-70867728950e\") };","+        for (var i = 0; i < claimCount; i++)","+        {","+            claims.Add(new Claim(\"custom-claim-\" + i, \"value-\" + i + \"-\" + new string('x', 20)));","+        }","+        using var scope = _services.CreateScope();","+        var context = NewContext(scope.ServiceProvider);","+        context.SignInAsync(scheme, new ClaimsPrincipal(new ClaimsIdentity(claims, \"test\"))).GetAwaiter().GetResult();","+        var setCookies = context.Response.Headers.SetCookie;","+        return string.Join(\"; \", setCookies.Select(c => c.Substring(0, c.IndexOf(';'))));","+    }","+","+    private static DefaultHttpContext NewContext(IServiceProvider services)","+    {","+        var context = new DefaultHttpContext { RequestServices = services };","+        context.Request.Scheme = \"https\";","+        context.Request.Host = new HostString(\"localhost\");","+        context.Request.Path = \"/\";","+        return context;","+    }","+","+    [Benchmark]","+    public async Task<bool> Authenticate()","+    {","+        await using var scope = _scopeFactory.CreateAsyncScope();","+        var context = NewContext(scope.ServiceProvider);","+        context.Request.Headers.Cookie = _cookieHeader;","+        var result = await context.AuthenticateAsync();","+        return result.Succeeded;","+    }","+","+    [Benchmark]","+    public async Task<bool> AuthenticateChunked()","+    {","+        await using var scope = _scopeFactory.CreateAsyncScope();","+        var context = NewContext(scope.ServiceProvider);","+        context.Request.Headers.Cookie = _chunkedCookieHeader;","+        var result = await context.AuthenticateAsync(\"chunked\");","+        return result.Succeeded;","+    }","+","+    [Benchmark]","+    public async Task<bool> AuthenticateNoCookie()","+    {","+        await using var scope = _scopeFactory.CreateAsyncScope();","+        var context = NewContext(scope.ServiceProvider);","+        var result = await context.AuthenticateAsync();","+        return result.Succeeded;","+    }","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"src/Security/perf/Microbenchmarks/Microsoft.AspNetCore.Security.Microbenchmarks.csproj","lines":["@@ -17,6 +17,9 @@","     <ProjectReference Include=\"$(RepoRoot)src\\Http\\Http.Abstractions\\src\\Microsoft.AspNetCore.Http.Abstractions.csproj\" />","     <ProjectReference Include=\"$(RepoRoot)src\\Http\\Http.Features\\src\\Microsoft.AspNetCore.Http.Features.csproj\" />","     <ProjectReference Include=\"$(RepoRoot)src\\Http\\Http\\src\\Microsoft.AspNetCore.Http.csproj\" />","+    <ProjectReference Include=\"$(RepoRoot)src\\Http\\Authentication.Core\\src\\Microsoft.AspNetCore.Authentication.Core.csproj\" />","+    <ProjectReference Include=\"$(RepoRoot)src\\DataProtection\\DataProtection\\src\\Microsoft.AspNetCore.DataProtection.csproj\" />","+    <ProjectReference Include=\"$(RepoRoot)src\\Security\\Authentication\\Core\\src\\Microsoft.AspNetCore.Authentication.csproj\" />","     <ProjectReference Include=\"$(RepoRoot)src\\Http\\Routing\\src\\Microsoft.AspNetCore.Routing.csproj\" />","     <ProjectReference Include=\"$(RepoRoot)src\\Security\\Authentication\\Cookies\\src\\Microsoft.AspNetCore.Authentication.Cookies.csproj\" />","     <ProjectReference Include=\"$(RepoRoot)src\\Security\\Authorization\\Policy\\src\\Microsoft.AspNetCore.Authorization.Policy.csproj\" />"],"additions":3,"deletions":0,"truncated":false},{"path":"src/Security/perf/Microbenchmarks/SecureDataFormatBenchmark.cs","lines":["@@ -0,0 +1,56 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System.Security.Claims;","+using BenchmarkDotNet.Attributes;","+using Microsoft.AspNetCore.Authentication;","+using Microsoft.AspNetCore.DataProtection;","+","+namespace Microsoft.AspNetCore.Security;","+","+[MemoryDiagnoser]","+public class SecureDataFormatBenchmark","+{","+    private TicketDataFormat _format;","+    private AuthenticationTicket _ticket;","+    private string _protectedTicket;","+","+    [Params(7, 100)]","+    public int ClaimCount { get; set; }","+","+    [GlobalSetup]","+    public void GlobalSetup()","+    {","+        var protector = new EphemeralDataProtectionProvider().CreateProtector(\"Microsoft.AspNetCore.Authentication.Cookies.CookieAuthenticationMiddleware\", \"Cookies\", \"v2\");","+        _format = new TicketDataFormat(protector);","+","+        var identity = new ClaimsIdentity(\"Identity.Application\");","+        identity.AddClaim(new Claim(ClaimTypes.NameIdentifier, \"0f8fad5b-d9cb-469f-a165-70867728950e\"));","+        identity.AddClaim(new Claim(ClaimTypes.Name, \"bob@contoso.com\"));","+        identity.AddClaim(new Claim(\"AspNet.Identity.SecurityStamp\", \"MUFAS2EV5RQ5ZGCCIUFQVCIPRUZQ5JWK\"));","+        for (var i = 3; i < ClaimCount; i++)","+        {","+            identity.AddClaim(new Claim(ClaimTypes.Role, \"role-\" + i));","+        }","+","+        var properties = new AuthenticationProperties","+        {","+            IssuedUtc = new DateTimeOffset(2025, 1, 1, 0, 0, 0, TimeSpan.Zero),","+            ExpiresUtc = new DateTimeOffset(2025, 1, 15, 0, 0, 0, TimeSpan.Zero),","+            IsPersistent = true,","+        };","+        _ticket = new AuthenticationTicket(new ClaimsPrincipal(identity), properties, \"Identity.Application\");","+        _protectedTicket = _format.Protect(_ticket);","+","+        if (_format.Unprotect(_protectedTicket) is null)","+        {","+            throw new InvalidOperationException(\"Round trip failed.\");","+        }","+    }","+","+    [Benchmark]","+    public string Protect() => _format.Protect(_ticket);","+","+    [Benchmark]","+    public AuthenticationTicket Unprotect() => _format.Unprotect(_protectedTicket);","+}",""],"additions":56,"deletions":0,"truncated":false}],"additions":307,"deletions":7,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-07T15:04:43.998985+00:00"}