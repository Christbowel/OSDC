ngs: { value: string }[] }>>()","+        .resolves({ settings: [{ value: dbHash }] }),","+    };","+    sinon.stub(models.User, 'getByEmail').resolves(user);","+    sinon.stub(models.User.prototype, 'fetch').resolves(user);","+    sinon","+      .stub(ghostBookshelf, 'transaction')","+      .callsFake(async (callback: (transaction: object) => Promise<unknown>) => callback({}));","+    changePassword = sinon.stub(models.User, 'changePassword').callsFake(async () => {","+      user.set('password', replacementHash);","+      return user;","+    });","+    sinon.stub(user, 'save').resolves(user);","+  });","+","+  afterEach(function () {","+    sinon.restore();","+  });","+","+  it('generates a reset token with the published security API', async function () {","+    const result = await passwordreset.generateToken(email, settingsAPI);","+    assert.equal(result.email, email);","+    assert.deepEqual(","+      security.tokens.resetToken.compare({ token: result.resetToken, dbHash, passwordHash }),","+      { correct: true },","+    );","+  });","+","+  it('accepts a pre-rename token through Ghost and invalidates it after the password changes', async function () {","+    const options = {","+      data: {","+        password_reset: [","+          {","+            token: legacyToken,","+            oldPassword: 'old-test-only',","+            newPassword: 'replacement-test-only',","+          },","+        ],","+      },","+    };","+    const parts = security.tokens.resetToken.extract({ token: legacyToken });","+    const result = await passwordreset.doReset(options, parts, settingsAPI);","+    assert.equal(result.user, user);","+    sinon.assert.calledOnce(changePassword);","+    assert.deepEqual(","+      security.tokens.resetToken.compare({","+        token: legacyToken,","+        dbHash,","+        passwordHash: user.get('password'),","+      }),","+      { correct: false, reason: 'invalid' },","+    );","+  });","+","+  it('rejects a token through Ghost if the stored password hash has changed', async function () {","+    user.set('password', replacementHash);","+    const options = {","+      data: { password_reset: [{ token: legacyToken, newPassword: 'replacement-test-only' }] },","+    };","+    await assert.rejects(","+      passwordreset.doReset(","+        options,","+        security.tokens.resetToken.extract({ token: legacyToken }),","+        settingsAPI,","+      ),","+      /Cannot reset password/,","+    );","+    sinon.assert.notCalled(changePassword);","+  });","+});"],"additions":110,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -377,6 +377,9 @@ catalogs:","     '@tryghost/request':","       specifier: 4.0.12","       version: 4.0.12","+    '@tryghost/security':","+      specifier: 4.0.0","+      version: 4.0.0","     '@tryghost/string':","       specifier: 0.3.8","       version: 0.3.8","@@ -2278,8 +2281,8 @@ importers:","         specifier: 2.3.18","         version: 2.3.18","       '@tryghost/security':","-        specifier: 3.3.18","-        version: 3.3.18","+        specifier: 'catalog:'","+        version: 4.0.0","       '@tryghost/social-urls':","         specifier: 0.1.66","         version: 0.1.66","@@ -8727,8 +8730,8 @@ packages:","   '@tryghost/root-utils@2.3.18':","     resolution: {integrity: sha512-4BPotmr+7+IGwqbvgCSKpO4/JUNci1YjSMJx22XjgWa38lM+coeNwr/uToGkcBbdxfaZBmFSig086FkCwlvDMg==}"," ","-  '@tryghost/security@3.3.18':","-    resolution: {integrity: sha512-rHkH+GQwVynzux7aZgyn52qTBrtToq2Ch8kARXiJfoOmnahzPuccVDfMT0X/s7cKvI51o5OwE8yRgcs7s2MU5A==}","+  '@tryghost/security@4.0.0':","+    resolution: {integrity: sha512-SP04r1gUrmrsxG1RCU3NCh9je7yWrfbeHUf7HVh14X2CQWn6+dPaEYQke9t7zKVkjSYhe2TL/byoTBnTu16yYw==}"," ","   '@tryghost/social-urls@0.1.66':","     resolution: {integrity: sha512-XcnhiRkvr1nhv+bq7pS78MrrLPCtJt/CzLq1FCUWRWAV+akIo2TT3Fo2WpCb0iLM4Zy+pwoGKDaXXebVww/3AQ==}","@@ -20994,7 +20997,7 @@ snapshots:","       caller: 1.1.0","       find-root: 1.1.0"," ","-  '@trygh