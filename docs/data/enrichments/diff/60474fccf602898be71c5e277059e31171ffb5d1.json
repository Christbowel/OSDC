:\"acme\"}\"#,","+        r#\"{\"name\":\"acme\",\"time\":{\"unpublished\":null}}\"#,","+        r#\"{\"name\":\"acme\",\"time\":{\"unpublished\":{}}}\"#,","+        r#\"{\"name\":\"acme\",\"time\":{\"unpublished\":{\"versions\":[]}}}\"#,","+        r#\"{\"name\":\"acme\",\"time\":{\"unpublished\":{\"versions\":[\"1.0.0\"]}},\"versions\":{}}\"#,","+        r#\"{\"name\":\"acme\",\"time\":{\"unpublished\":{\"versions\":[\"1.0.0\"]}},\"dist-tags\":{}}\"#,","+    ] {","+        assert!(!is_unpublished_packument(body), \"unexpected unpublish record: {body}\");","+    }","+}","+"," #[tokio::test]"," async fn fetch_full_metadata_surfaces_decode_failure_distinctly() {","     let mut server = mockito::Server::new_async().await;"],"additions":59,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/pick_package/fetch_pick.rs","lines":["@@ -171,18 +171,17 @@ impl PickState<'_> {"," ","     /// The mirror a failed fetch may fall back to, when","     /// [`fetch_failure_falls_back`] allows it. The fallback reads only the","-    /// scoped mirror `pkg_mirror` already points at.","-    ///","-    /// The fetcher already saved a 200 to disk before it returned (when it","-    /// returned Ok). If it returned Err, an existing mirror is good enough","-    /// to pick from, even if the latest sync failed.","+    /// scoped mirror `pkg_mirror` already points at. An unpublished package","+    /// never falls back, so its removed versions are not picked from the mirror.","     async fn disk_fallback(","         &self,","         error: &FetchMetadataError,","         disk_meta: Option<Arc<Package>>,","     ) -> Option<Arc<Package>> {","         let public_scope = matches!(self.scope, MetadataCacheScope::Public);","-        if !fetch_failure_falls_back(public_scope, error.is_access_denied()) {","+        if matches!(error, FetchMetadataError::Unpublished { .. })","+            || !fetch_failure_falls_back(public_scope, error.is_access_denied())","+        {","  