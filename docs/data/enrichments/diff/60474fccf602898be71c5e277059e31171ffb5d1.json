{"id":"60474fccf602898be71c5e277059e31171ffb5d1","axis":"silent","repo":"pnpm/pnpm","sha":"60474fccf602898be71c5e277059e31171ffb5d1","parsed":{"files":[{"path":".changeset/18428-info-unpublished-package.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+`pnpm info` and `pnpm view` now report a fully unpublished package with `ERR_PNPM_PACKAGE_NOT_FOUND`. They used to fail with a metadata decoding error, which stopped tools such as Changesets from checking the rest of a release. `pnpm add --save-types` now skips a `@types` package that was fully unpublished [#18428](https://github.com/pnpm/pnpm/issues/18428)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/view.rs","lines":["@@ -88,6 +88,13 @@ pub enum ViewError {","         spec: String,","     },"," ","+    #[display(\"No versions available for {name} because it was unpublished\")]","+    #[diagnostic(code(ERR_PNPM_PACKAGE_NOT_FOUND))]","+    PackageUnpublished {","+        #[error(not(source))]","+        name: String,","+    },","+","     #[display(\"GET {url}: Not Found - 404\")]","     #[diagnostic(code(ERR_PNPM_FETCH_404))]","     Fetch404 {","@@ -346,23 +353,25 @@ fn version_data(meta: &pnpm_registry::Package, picked: &pnpm_registry::PackageVe","         .unwrap_or_else(|| serde_json::to_value(picked).unwrap_or(Value::Null))"," }"," ","-/// Map a metadata-fetch failure to the matching pnpm error. A `404`","-/// becomes [`ViewError::Fetch404`] (pnpm's `ERR_PNPM_FETCH_404`); every","-/// other failure is surfaced verbatim."," fn map_fetch_error(","     error: pnpm_resolving_npm_resolver::FetchMetadataError,","     registry: &str,","     pkg_name: &str,"," ) -> miette::Report {","     use pnpm_resolving_npm_resolver::FetchMetadataError;","-    if let FetchMetadataError::Network { error: ref source, .. } = error","-        && source.status() == Some(reqwest::StatusCode::NOT_FOUND)","-    {","-        let url = package_endpoint_url(registry, pkg_name)","-            .unwrap_or_else(|_| format!(\"{registry}{pkg_name}\"));","-        return ViewError::Fetch404 { url: pnpm_network::redact_url_credentials(&url) }.into();","+    match error {","+        FetchMetadataError::Network { error: ref source, .. }","+            if source.status() == Some(reqwest::StatusCode::NOT_FOUND) =>","+        {","+            let url = package_endpoint_url(registry, pkg_name)","+                .unwrap_or_else(|_| format!(\"{registry}{pkg_name}\"));","+            ViewError::Fetch404 { url: pnpm_network::redact_url_credentials(&url) }.into()","+        }","+        FetchMetadataError::Unpublished { .. } => {","+            ViewError::PackageUnpublished { name: pkg_name.to_owned() }.into()","+        }","+        error => miette::Report::new(error),","     }","-    miette::Report::new(error)"," }"," "," #[cfg(test)]"],"additions":19,"deletions":10,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/add_types.rs","lines":["@@ -150,6 +150,33 @@ fn skips_bundled_types_and_missing_types_packages() {","     }"," }"," ","+/// <https://github.com/pnpm/pnpm/issues/18428>","+#[test]","+fn skips_an_unpublished_types_package() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let mut server = mockito::Server::new();","+    let _package = serve_package(&mut server, \"example\", &json!({}));","+    let unpublished = server","+        .mock(\"GET\", mockito::Matcher::Regex(\"(?i)^/@types%2fexample$\".to_string()))","+        .with_header(\"content-type\", \"application/json\")","+        .with_body(","+            json!({","+                \"name\": \"@types/example\",","+                \"time\": {\"unpublished\": {\"time\": \"2025-02-01T00:00:00.000Z\", \"versions\": [\"1.0.0\"]}}","+            })","+            .to_string(),","+        )","+        .expect(1)","+        .create();","+    setup(&workspace, &server.url());","+    add(&workspace, &[\"example\", \"--save-types\"]).assert().success();","+    let resu