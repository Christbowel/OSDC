ck) {","+            ret = WC_NO_ERR_TRACE(CRYPTOCB_UNAVAILABLE);","+        }","+        else if (!info->pk.ed448checkkey.checkPriv ||","+                (info->pk.ed448checkkey.pubKeySz != ED448_PUB_KEY_SIZE) ||"],"additions":123,"deletions":0,"truncated":false}],"additions":640,"deletions":6,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-13T15:29:15.213983+00:00"}