itted provided that the following conditions","+ * are met:","+ * 1. Redistributions of source code must retain the above copyright","+ *    notice, this list of conditions and the following disclaimer.","+ * 2. Redistributions in binary form must reproduce the above copyright","+ *    notice, this list of conditions and the following disclaimer in the","+ *    documentation and/or other materials provided with the distribution.","+ *","+ * THIS SOFTWARE IS PROVIDED BY THE AUTHOR ``AS IS'' AND ANY EXPRESS OR","+ * IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES","+ * OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.","+ * IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT,","+ * INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT","+ * NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,","+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY","+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT","+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF","+ * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.","+ */","+","+#include <sys/types.h>","+","+#include <stdio.h>","+#include <stdint.h>","+#include <stdbool.h>","+#include <string.h>","+#include <signal.h>","+#include <endian.h>","+","+#include \"sshkey.h\"","+#include \"kex.h\"","+#include \"sshbuf.h\"","+#include \"digest.h\"","+#include \"ssherr.h\"","+","+int","+kex_kem_mlkem768ecdh_keypair(struct kex *kex)","+{","+\tstruct sshbuf *buf = NULL;","+\tstruct sshbuf *ec_blob = NULL;","+\tEC_KEY *client_key = NULL;","+\tconst EC_GROUP *group;","+\tconst EC_POINT *public_key;","+\tu_char *cp = NULL;","+\tsize_t need;","+\tint r = SSH_ERR_INTERNAL_ERROR;","+","+\tif ((buf = sshbuf_new()) == NULL)","+\t\treturn SSH_ERR_ALLOC_FAIL;","+\tneed = MLKEM768_PUBLICKEYBYTES;","+\tif ((r = sshbuf_reserve(buf, need, &cp)) != 0)","+\t\tgoto out;","+\tif (crypto_kem_mlkem768_keypair(cp, kex->mlkem768_client_key) != 0) {","+\t\tr = SSH_ERR_INTERNAL_ERROR;","+\t\tgoto out;","+\t}","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"client public key mlkem768:\", cp,","+\t    MLKEM768_PUBLICKEYBYTES);","+#endif","+\tif ((client_key = EC_KEY_new_by_curve_name(kex->ec_nid)) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\tif (EC_KEY_generate_key(client_key) != 1) {","+\t\tr = SSH_ERR_LIBCRYPTO_ERROR;","+\t\tgoto out;","+\t}","+\tgroup = EC_KEY_get0_group(client_key);","+\tpublic_key = EC_KEY_get0_public_key(client_key);","+","+\tif ((ec_blob = sshbuf_new()) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\tif ((r = sshbuf_put_ec(ec_blob, public_key, group)) != 0 ||","+\t    (r = sshbuf_get_u32(ec_blob, NULL)) != 0 ||","+\t    (r = sshbuf_putb(buf, ec_blob)) != 0)","+\t\tgoto out;","+#ifdef DEBUG_KEXECDH","+\tfputs(\"client private key EC:\\n\", stderr);","+\tsshkey_dump_ec_key(client_key);","+#endif","+\t/* success */","+\tr = 0;","+\tkex->ec_client_key = client_key;","+\tkex->ec_group = group;","+\tclient_key = NULL;\t/* owned by the kex */","+\tkex->client_pub = buf;","+\tbuf = NULL;","+ out:","+\tsshbuf_free(buf);","+\tsshbuf_free(ec_blob);","+\tEC_KEY_free(client_key);","+\treturn r;","+}","+","+int","+kex_kem_mlkem768ecdh_enc(struct kex *kex,","+   const struct sshbuf *client_blob, struct sshbuf **server_blobp,","+   struct sshbuf **shared_secretp)","+{","+\tconst EC_GROUP *group;","+\tconst EC_POINT *pub_key;","+\tEC_KEY *server_key = NULL;","+\tstruct sshbuf *ec_pub = NULL;","+\tstruct sshbuf *ec_blob = NULL;","+\tstruct sshbuf *ec_shared = NULL;","+\tstruct sshbuf *server_blob = NULL;","+\tstruct sshbuf *buf = NULL;","+\tconst u_char *client_pub;","+\tu_char hash[SSH_DIGEST_MAX_LENGTH];","+\tu_char ct[MLKEM768_CIPHERTEXTBYTES];","+\tu_char shared_secret[MLKEM768_BYTES];","+\tsize_t need;","+\tint r = SSH_ERR_INTERNAL_ERROR;","+","+\t*server_blobp = NULL;","+\t*shared_secretp = NULL;","+","+\t/* client_blob contains both KEM and ECDH client pubkeys */","+\tneed = MLKEM768_PUBLICKEYBYTES;","+\tif (sshbuf_len(client_blob) <= need) {","+\t\tr = SSH_ERR_SIGNATURE_INVALID;","+\t\tgoto out;","+\t}","+\tclient_pub = sshbuf_ptr(client_blob);","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"client public key mlkem768:\", client_pub,","+\t    MLKEM768_PUBLICKEYBYTES);","+#endif","+","+\t/* allocate buffer for concatenation of KEM key and ECDH shared key */","+\t/* the buffer will be hashed and the result is the shared secret */","+\tif ((buf = sshbuf_new()) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\t/* allocate space for encrypted KEM key and ECDH pub key */","+\tif ((server_blob = sshbuf_new()) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\t/* generate and encrypt KEM key with client key */","+\tif (crypto_kem_mlkem768_enc(ct, shared_secret, client_pub) != 0) {","+\t\tr = SSH_ERR_INTERNAL_ERROR;","+\t\tgoto out;","+\t}","+\tif ((r = sshbuf_put(buf, shared_secret, sizeof(shared_secret))) != 0 ||","+\t    (r = sshbuf_put(server_blob, ct, sizeof(ct))) != 0)","+\t\tgoto out;","+","+\tclient_pub += MLKEM768_PUBLICKEYBYTES;","+\tif ((ec_pub = sshbuf_from(client_pub, sshbuf_len(client_blob) -","+\t    MLKEM768_PUBLICKEYBYTES)) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\t/* generate ECDH key pair */","+\tif ((server_key = EC_KEY_new_by_curve_name(kex->ec_nid)) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\tif (EC_KEY_generate_key(server_key) != 1) {","+\t\tr = SSH_ERR_LIBCRYPTO_ERROR;","+\t\tgoto out;","+\t}","+\tgroup = EC_KEY_get0_group(server_key);","+#ifdef DEBUG_KEXECDH","+\tfputs(\"server private key EC:\\n\", stderr);","+\tsshkey_dump_ec_key(server_key);","+#endif","+\t/* store server pubkey after ciphertext */","+\tpub_key = EC_KEY_get0_public_key(server_key);","+\tif ((ec_blob = sshbuf_new()) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\tif ((r = sshbuf_put_ec(ec_blob, pub_key, group)) != 0 ||","+\t    (r = sshbuf_get_u32(ec_blob, NULL)) != 0 ||","+\t    (r = sshbuf_putb(server_blob, ec_blob)) != 0)","+\t\tgoto out;","+","+\t/* append ECDH shared key */","+\tif ((r = kex_ecdh_dec_key_group(kex, ec_pub, server_key, group,","+\t    &ec_shared)) != 0 ||","+\t    (r = sshbuf_putb(buf, ec_shared)) != 0)","+\t\tgoto out;","+","+\tif ((r = ssh_digest_buffer(kex->hash_alg, buf, hash, sizeof(hash))) != 0)","+\t\tgoto out;","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"server cipher text:\", ct, sizeof(ct));","+\tdump_digest(\"server kem key:\", shared_secret, sizeof(shared_secret));","+\tdump_digest(\"concatenation of KEM key and ECDH shared key:\",","+\t    sshbuf_ptr(buf), sshbuf_len(buf));","+#endif","+\t/* string-encoded hash is resulting shared secret */","+\tsshbuf_reset(buf);","+\tif ((r = sshbuf_put_string(buf, hash,","+\t    ssh_digest_bytes(kex->hash_alg))) != 0)","+\t\tgoto out;","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"encoded shared secret:\", sshbuf_ptr(buf), sshbuf_len(buf));","+#endif","+\t/* success */","+\tr = 0;","+\t*server_blobp = server_blob;","+\t*shared_secretp = buf;","+\tserver_blob = NULL;","+\tbuf = NULL;","+ out:","+\texplicit_bzero(hash, sizeof(hash));","+\texplicit_bzero(shared_secret, sizeof(shared_secret));","+\tEC_KEY_free(server_key);","+\tsshbuf_free(ec_pub);","+\tsshbuf_free(ec_blob);","+\tsshbuf_free(ec_shared);","+\tsshbuf_free(server_blob);","+\tsshbuf_free(buf);","+\treturn r;","+}","+","+int","+kex_kem_mlkem768ecdh_dec(struct kex *kex,","+    const struct sshbuf *server_blob, struct sshbuf **shared_secretp)","+{","+\tstruct sshbuf *buf = NULL;","+\tstruct sshbuf *ec_pub = NULL;","+\tstruct sshbuf *ec_shared = NULL;","+\tu_char shared_secret[MLKEM768_BYTES];","+\tconst u_char *ciphertext, *server_pub;","+\tu_char hash[SSH_DIGEST_MAX_LENGTH];","+\tsize_t need;","+\tint r;","+","+\t*shared_secretp = NULL;","+","+\tneed = MLKEM768_CIPHERTEXTBYTES;","+\tif (sshbuf_len(server_blob) <= need) {","+\t\tr = SSH_ERR_SIGNATURE_INVALID;","+\t\tgoto out;","+\t}","+\tciphertext = sshbuf_ptr(server_blob);","+\tserver_pub = ciphertext + MLKEM768_CIPHERTEXTBYTES;","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"server cipher text (dec):\", ciphertext,","+\t    MLKEM768_CIPHERTEXTBYTES);","+#endif","+\t/* hash concatenation of KEM key and ECDH shared key */","+\tif ((buf = sshbuf_new()) == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\tif (crypto_kem_mlkem768_dec(shared_secret, ciphertext,","+\t    kex->mlkem768_client_key) != 0) {","+\t\tr = SSH_ERR_INTERNAL_ERROR;","+\t\tgoto out;","+\t}","+\tif ((r = sshbuf_put(buf, shared_secret, sizeof(shared_secret))) != 0)","+\t\tgoto out;","+\tif ((ec_pub = sshbuf_from(server_pub, sshbuf_len(server_blob) - need))","+\t    == NULL) {","+\t\tr = SSH_ERR_ALLOC_FAIL;","+\t\tgoto out;","+\t}","+\tif ((r = kex_ecdh_dec(kex, ec_pub, &ec_shared)) != 0 ||","+\t    (r = sshbuf_putb(buf, ec_shared)) != 0)","+\t\tgoto out;","+\tif ((r = ssh_digest_buffer(kex->hash_alg, buf,","+\t    hash, sizeof(hash))) != 0)","+\t\tgoto out;","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"client kem key:\", shared_secret, sizeof(shared_secret));","+\tdump_digest(\"concatenation of KEM key and ECDH shared key:\",","+\t    sshbuf_ptr(buf), sshbuf_len(buf));","+#endif","+\tsshbuf_reset(buf);","+\tif ((r = sshbuf_put_string(buf, hash,","+\t    ssh_digest_bytes(kex->hash_alg))) != 0)","+\t\tgoto out;","+#ifdef DEBUG_KEXECDH","+\tdump_digest(\"encoded shared secret:\", sshbuf_ptr(buf), sshbuf_len(buf));","+#endif","+\t/* success */","+\tr = 0;","+\t*shared_secretp = buf;","+\tbuf = NULL;","+ out:","+\texplicit_bzero(hash, sizeof(hash));","+\texplicit_bzero(shared_secret, sizeof(shared_secret));","+\tEC_KEY_free(kex->ec_client_key);","+\tkex->ec_client_key = NULL;","+\tsshbuf_free(ec_pub);","+\tsshbuf_free(ec_shared);","+\tsshbuf_free(buf);","+\treturn r;","+}"],"additions":303,"deletions":0,"truncated":false},{"path":"m