now + {@code freshFor}","+ * ({@code authentication.organizationCacheTTL}, 10m by default) on every answer from Comet, and to now +","+ * {@code retryAfterFailure} ({@code authentication.organizationCacheRetryAfterFailure}, 30s by default) when","+ * Comet fails.</li>","+ * </ul>","+ * The whole key expires {@code keptFor} ({@code authentication.organizationCacheStaleTTL}, 60m by default) after the","+ * last answer from Comet.","+ */","+@Slf4j","+@RequiredArgsConstructor","+class WorkspaceOrganizationCache {","+","+    private static final String KEY_FORMAT = \"opik:workspace-organization:%s\";","+    private static final String ORGANIZATION_ID = \"organizationId\";","+    private static final String REFRESH_AFTER = \"refreshAfter\";","+","+    @Builder(toBuilder = true)","+    record Entry(String organizationId, @NonNull Instant refreshAfter) {","+        boolean isFresh(@NonNull Instant now) {","+            return now.isBefore(refreshAfter);","+        }","+    }","+","+    private final @NonNull RedissonReactiveClient redisClient;","+    private final @NonNull Duration freshFor;","+    private final @NonNull Duration keptFor;","+    private final @NonNull Duration retryAfterFailure;","+    private final @NonNull Clock clock;","+","+    Mono<Entry> find(@NonNull String workspaceId) {","+        return map(workspaceId).readAllMap()","+                .filter(fields -> fields.containsKey(REFRESH_AFTER))","+                .map(fields -> Entry.builder()","+                        .organizationId(StringUtils.trimToNull(fields.get(ORGANIZATION_ID)))","+                        .refreshAfter(Instant.ofEpochMilli(Long.parseLong(fields.get(REFRESH_AFTER))))","+                        .build());","+    }","+","+    Mono<String> organizationId(@NonNull String workspaceId) {","+        return find(workspaceId)","+                .mapNotNull(Entry::organizationId)","+                .onErrorResume(error -> {","+                    log.warn(\"Could not read the cached organization, workspace '{}'\", workspaceId, error);","+                    return Mono.empty();","+                });","+    }","+","+    Mono<Void> save(@NonNull String workspaceId, String organizationId) {","+        var map = map(workspaceId);","+        return map.putAll(Map.of(","+                ORGANIZATION_ID, StringUtils.defaultString(organizationId),","+                REFRESH_AFTER, String.valueOf(now().plus(freshFor).toEpochMilli())))","+                .then(map.expire(keptFor))","+                .then();","+    }","+","+    /**","+     * Moves only the refresh time: the expiry stays where the last answer from Comet put it, so a stale copy is never","+     * kept for longer than {@code keptFor} while Comet keeps failing.","+     */","+    Mono<Void> retryLater(@NonNull String workspaceId) {","+        return map(workspaceId)","+                .fastPutIfExists(REFRESH_AFTER, String.valueOf(now().plus(retryAfterFailure).toEpochMilli()))","+                .then();","+    }","+","+    Instant now() {"],"additions":90,"deletions":0,"truncated":false}],"additions":392,"deletions":13,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-23T19:31:38.198181+00:00"}