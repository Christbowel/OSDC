ion(value = 60, unit = TimeUnit.MINUTES)","+    private Duration organizationCacheTTL;","+","+    @Valid @NotNull @JsonProperty","+    @MinDuration(value = 1, unit = TimeUnit.MINUTES)","+    @MaxDuration(value = 60, unit = TimeUnit.MINUTES)","+    private Duration organizationCacheStaleTTL;","+","+    @Valid @NotNull @JsonProperty","+    @MinDuration(value = 1, unit = TimeUnit.SECONDS)","+    @MaxDuration(value = 5, unit = TimeUnit.MINUTES)","+    private Duration organizationCacheRetryAfterFailure;","+","     /**","      * Cross-field constraint: a backoff whose minimum exceeds its maximum is contradictory, and","      * Reactor's {@code Retry.backoff} would clamp it silently rather than fail. Validate it at","@@ -93,4 +114,15 @@ public record UrlConfig(@Valid @JsonProperty @NotNull String url) {","                 || requestRetryMaxBackoff == null","                 || requestRetryMinBackoff.toMilliseconds() <= requestRetryMaxBackoff.toMilliseconds();","     }","+","+    /**","+     * Redis drops a cached organization after the stale TTL, so a stale TTL shorter than the fresh one would drop","+     * entries while they are still fresh: every request would ask Comet, and nothing would be left for Comet outages.","+     */","+    @JsonIgnore","+    @AssertTrue(message = \"authentication.organizationCacheStaleTTL must be at least authentication.organizationCacheTTL\") public boolean isOrganizationCacheTtlOrderValid() {","+        return organizationCacheTTL == null","+                || organizationCacheStaleTTL == null","+                || organizationCacheTTL.toMilliseconds() <= organizationCacheStaleTTL.toMilliseconds();","+    }"," }"],"additions":32,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/ServiceTogglesConfig.java","lines":["@@ -43,6 +43,8 @@ public class ServiceTogglesConfig {","     @JsonProperty","     @NotNull boolean costIntelligenceEnabled;","     @JsonProperty","+    @NotNull boolean modelPr