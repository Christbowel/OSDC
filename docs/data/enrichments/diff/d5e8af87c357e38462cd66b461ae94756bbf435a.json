me: 'test', federatedAssetSources: {enabled: 'yes' as never}},","+        initialValue: undefined,","+      }),","+    ).toThrow('Expected `federatedAssetSources.enabled` to be a boolean, but received string')","+  })","+","+  it('throws when filter is not a function', () => {","+    expect(() =>","+      federatedAssetSourcesReducer({","+        config: {name: 'test', federatedAssetSources: {filter: 'nope' as never}},","+        initialValue: undefined,","+      }),","+    ).toThrow('Expected `federatedAssetSources.filter` to be a function, but received string')","+  })","+","+  it('throws when uploads is not a function', () => {","+    expect(() =>","+      federatedAssetSourcesReducer({","+        config: {name: 'test', federatedAssetSources: {uploads: true as never}},","+        initialValue: undefined,","+      }),","+    ).toThrow('Expected `federatedAssetSources.uploads` to be a function, but received boolean')","+  })","+","+  it.each([","+    {label: 'a boolean', value: true, received: 'boolean'},","+    {label: 'null', value: null, received: 'null'},","+  ])('throws when the namespace itself is $label (raw JavaScript config)', ({value, received}) => {","+    expect(() =>","+      federatedAssetSourcesReducer({","+        config: {name: 'test', federatedAssetSources: value as never},","+        initialValue: undefined,","+      }),","+    ).toThrow(`Expected \\`federatedAssetSources\\` to be an object, but received ${received}`)","+  })","+})","+"," describe('mediaLibraryLibraryIdReducer', () => {","   it('returns the last string library id, with the root config winning', () => {","     expect("],"additions":65,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/config/__tests__/prepareConfig.federatedAssetSources.test.ts","lines":["@@ -0,0 +1,223 @@","+import {createClient} from '@sanity/client'","+import {type DashboardTopics, type ValueOf} from '@sanity/sdk/dashboard'","+import {beforeEach, describe, expect, it, vi} from 'vitest'","+","+import {stubMessageBusHost} from '../../../../test/testUtils/stubMessageBusHost'","+import {createMockAuthStore} from '../../store/auth/mock/createMockAuthStore'","+import {createSourceFromConfig} from '../resolveConfig'","+import {type SingleWorkspace} from '../types'","+","+/**","+ * Composition tests: `federatedAssetSources` and the brokered views published","+ * on the workbench message bus, resolved all the way through","+ * `prepareConfig`/`createSourceFromConfig` into `form.file.assetSources` and","+ * `form.image.assetSources`. The reducer's own precedence/validation behavior","+ * is covered in `configPropertyReducers.test.ts`; the bus-entry mapping in","+ * `federatedAssetSource/__tests__/discovery.test.ts`.","+ */","+","+type ApplicationsList = Extract<","+  NonNullable<ValueOf<'applications.list', DashboardTopics>>,","+  {ok: true}","+>['value']","+type ListedEntry = ApplicationsList[number]","+type ListedApplication = Extract<ListedEntry, {type: 'studio' | 'coreApp'}>","+type Deployment = NonNullable<ListedApplication['activeDeployment']>","+type InterfaceRecord = NonNullable<Deployment['interfaces']>[number]","+","+// Minimal fixture builders, mirroring discovery.test.ts.","+function assetSourceInterface(fields: {name: string; moduleId: string}): InterfaceRecord {","+  return {","+    id: `interface-${fields.name}`,","+    title: fields.name,","+    version: '1.0.0',","+    type: 'asset_source',","+    metadata: null,","+    ...fields,","+  }","+}","+","+function application(","+  fields: {id: string; name: string} & Partial<ListedApplication>,","+): ListedApplication {","+  return {","+    type: 'studio',","+    title: fields.name,","+    reference: '',","+    icon: null,","+    isSingleton: false,","+    visibility: 'default',","+    slug: null,","+    externalUrl: `https://${fields.id}.example`,","+    organizationId: 'org-1',","+    createdAt: '',","+    updatedAt: '',","+    config: {mfManifest: {}} as ListedApplication['config'],","+    activeDeployment: null,","+    ...fields,","+  }","+}","+","+function appWithView(fields: {id: string; name: string; viewName: string}): ListedApplication {","+  return application({","+    id: fields.id,","+    name: fields.name,","+    activeDeployment: {","+      id: `deployment-${fields.id}`,","+      applicationId: fields.id,","+      size: null,","+      version: null,","+      isAutoUpdating: null,","+      isActiveDeployment: true,","+      deployedBy: null,","+      createdAt: '',","+      updatedAt: '',","+      interfaces: [","+        assetSourceInterface({name: fields.viewName, moduleId: `views/${fields.viewName}`}),","+      ],","+    },","+  })","+}","+","+function publishViews(entries: ApplicationsList) {","+  stubMessageBusHost().publish('applications.list', {ok: true, value: entries})","+}","+","+/** An app list with the Media Library's own view and two third-party views. */","+function defaultEntries(): ApplicationsList {","+  return [","+    appWithView({id: 'media-app', name: 'media-library', viewName: 'select'}),","+    appWithView({id: 'stock-app', name: 'stock-photos', viewName: 'stock'}),","+    appWithView({id: 'dam-app', name: 'acme-dam', viewName: 'picker'}),","+  ]","+}","+","+// prepareConfig caches per raw workspace object — build a fresh one per test.","+// The mock auth store keeps source resolution offline (no getCurrentUser","+// request), matching resolveConfig.test.ts.","+function workspaceConfig(overrides: Partial<SingleWorkspace>): SingleWorkspace {","+  const projectId = 'ppsg7ml5'","+  const dataset = 'test'","+  return {","+    name: 'default',","+    projectId,","+    dataset,","+    auth: createMockAuthStore({","+      client: createClient({projectId, dataset, apiVersion: '2025-01-01', useCdn: false}),","+      currentUser: null,","+    }),","+    ...overrides,","+  }","+}","+","+async function resolveAssetSources(overrides: Partial<SingleWorkspace>) {","+  const source = await createSourceFromConfig(workspaceConfig(overrides))","+  return {file: source.form.file.assetSources, image: source.form.image.assetSources}","+}","+","+beforeEach(() => {","+  // The \"federated fallback\" console.info is a module-level one-shot in","+  // prepareConfig; silence it so the first test to trigger it stays quiet.","+  vi.spyOn(console, 'info').mockImplementation(() => {})","+})","+","+describe('prepareConfig — federatedAssetSources composition', () => {","+  it('adds no sources outside the workbench (no message bus), even when enabled', async () => {","+    const {file, image} = await resolveAssetSources({","+      federatedAssetSources: {enabled: true},","+    })","+","+    expect(file.map((s) => s.name)).toEqual(['sanity-default'])","+    expect(image.map((s) => s.name)).toEqual(['sanity-default'])","+  })","+","+  it('ignores brokered views when federatedAssetSources is not enabled', async () => {","+    publishViews(defaultEntries())","+","+    const {file, image} = await resolveAssetSources({","+      mediaLibrary: {enabled: true},","+    })","+","+    expect(file.map((s) => s.name)).toEqual(['sanity-media-library', 'sanity-default'])","+    expect(image.map((s) => s.name)).toEqual(['sanity-media-library', 'sanity-default'])","+  })","+","+  it('surfaces third-party brokered views as sources on both file and image, excluding the Media Library view', async () => {","+    publishViews(defaultEntries())","+","+    const {file, image} = await resolveAssetSources({","+      mediaLibrary: {enabled: true},","+      federatedAssetSources: {enabled: true},","+    })","+","+    const expected = ['sanity-media-library', 'sanity-default', 'stock-app:stock', 'dam-app:picker']","+    expect(file.map((s) => s.name)).toEqual(expected)","+    expect(image.map((s) => s.name)).toEqual(expected)","+    // The Media Library's own view replaces the built-in source's dialog; it","+    // must never double up as a third-party source.","+    expect(file.filter((s) => s.name.startsWith('media-app:'))).toEqual([])","+  })","+","+  it('passes each view through the filter and keeps only accepted ones', async () => {","+    publishViews(defaultEntries())","+    const filter = vi.fn(({name}: {name: string}) => name === 'stock')","+","+    const {file} = await resolveAssetSources({","+      federatedAssetSources: {enabled: true, filter},","+    })","+","+    expect(filter).toHaveBeenCalledTimes(2)","+    expect(filter).toHaveBeenCalledWith({","+      applicationId: 'stock-app',","+      applicationName: 'stock-photos',","+      applicationTitle: 'stock-photos',","+      name: 'stock',","+      title: 'stock',","+    })","+    expect(filter).toHaveBeenCalledWith({","+      applicationId: 'dam-app',","+      applicationName: 'acme-dam',","+      applicationTitle: 'acme-dam',","+      name: 'picker',","+      title: 'picker',","+    })","+    expect(file.map((s) => s.name)).toEqual(['sanity-default', 'stock-app:stock'])","+  })","+","+  it('advertises upload support only for views the uploads callback opts in', async () => {","+    publishViews(defaultEntries())","+","+    const {file} = await resolveAssetSources({","+      federatedAssetSources: {enabled: true, uploads: ({name}) => name === 'stock'},","+    })","+","+    const stock = file.find((s) => s.name === 'stock-app:stock')","+    const picker = file.find((s) => s.name === 'dam-app:picker')","+    expect(stock?.Uploader).toBeDefined()","+    expect(picker?.Uploader).toBeUndefined()","+  })","+","+  it('composes across plugins: a plugin enables brokered sources, the workspace filters them', async () => {","+    publishViews(defaultEntries())","+","+    const {file} = await resolveAssetSources({","+      plugins: [{name: 'enable-brokered-sources', federatedAssetSources: {enabled: true}}],","+      federatedAssetSources: {filter: ({name}) => name === 'picker'},","+    })","+","+    expect(file.map((s) => s.name)).toEqual(['sanity-default', 'dam-app:picker'])","+  })","+","+  it('never costs the Media Library source: the federated flag without a published view keeps the built-in source', async () => {","+    // Workbench bus is up, but the application list has no Media Library view","+    // (e.g. cold start before the list is published).","+    publishViews([])","+","+    const {file, image} = await resolveAssetSources({","+      mediaLibrary: {enabled: true, __internal: {federatedAssetSource: true}},","+    })","+","+    expect(file.map((s) => s.name)).toEqual(['sanity-media-library', 'sanity-default'])","+    expect(image.map((s) => s.name)).toEqual(['sanity-media-library', 'sanity-default'])","+  })","+})"],"additions":223,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/config/configPropertyReducers.ts","lines":["@@ -32,6 +32,7 @@ import {","   type DocumentInspectorContext,","   type DocumentLanguageFilterComponent,","   type DocumentLanguageFilterContext,","+  type FederatedAssetSourcesConfig,","   type NewDocumentOptionsContext,","   type PluginOptions,","   type ResolveProductionUrlContext,","@@ -863,6 +864,73 @@ export const mediaLibraryFrontendHostReducer = (opts: {","   return result"," }"," ","+export const mediaLibraryFederatedAssetSourceReducer = (opts: {","+  config: PluginOptions","+  initialValue: boolean","+}): boolean => {","+  const {config, initialValue} = opts","+  const flattenedConfig = flattenConfig(config, [])","+","+  return flattenedConfig.reduce((acc, {config: innerConfig}) => {","+    const resolver = innerConfig.mediaLibrary?.__internal?.federatedAssetSource","+","+    if (resolver === undefined) return acc","+    if (typeof resolver === 'boolean') return resolver","+","+    throw new Error(","+      `Expected \\`mediaLibrary.__internal.federatedAssetSource\\` to be a boolean, but received ${getPrintableType(","+        resolver,","+      )}`,","+    )","+  }, initialValue)","+}","+","+export const federatedAssetSourcesReducer = (opts: {","+  config: PluginOptions","+  initialValue: FederatedAssetSourcesConfig | undefined","+}): FederatedAssetSourcesConfig | undefined => {","+  const {config, initialValue} = opts","+  const flattenedConfig = flattenConfig(config, [])","+","+  return flattenedConfig.reduce((acc, {config: innerConfig}) => {","+    const value = innerConfig.federatedAssetSources","+    if (value === undefined) return acc","+","+    // Raw JavaScript configs can assign anything here; a non-object must fail","+    // loudly instead of silently spreading to an empty object (or throwing an","+    // unhelpful property-access error on null).","+    if (value === null || typeof value !== 'object') {","+      throw new Error(","+        `Expected \\`federatedAssetSources\\` to be an object, but received ${getPrintableType(","+          value,","+        )}`,","+      )","+    }","+    if (value.enabled !== undefined && typeof value.enabled !== 'boolean') {","+      throw new Error(","+        `Expected \\`federatedAssetSources.enabled\\` to be a boolean, but received ${getPrintableType(","+          value.enabled,","+        )}`,","+      )","+    }","+    if (value.filter !== undefined && typeof value.filter !== 'function') {","+      throw new Error(","+        `Expected \\`federatedAssetSources.filter\\` to be a function, but received ${getPrintableType(","+          value.filter,","+        )}`,","+      )","+    }","+    if (value.uploads !== undefined && typeof value.uploads !== 'function') {","+      throw new Error(","+        `Expected \\`federatedAssetSources.uploads\\` to be a function, but received ${getPrintableType(","+          value.uploads,","+        )}`,","+      )","+    }","+    return {...acc, ...value}","+  }, initialValue)","+}","+"," export const scheduledDraftsEnabledReducer = (opts: {","   config: PluginOptions","   initialValue: boolean"],"additions":68,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/config/prepareConfig.tsx","lines":["@@ -16,9 +16,16 @@ import {","   createDatasetImageAssetSource,"," } from '../form/studio/assetSourceDataset'"," import {","+  createFederatedSanityMediaLibraryFileSource,","+  createFederatedSanityMediaLibraryImageSource,","   createSanityMediaLibraryFileSource,","   createSanityMediaLibraryImageSource,"," } from '../form/studio/assetSourceMediaLibrary'","+import {","+  createFederatedAssetSource,","+  getCurrentFederatedAssetSourceViews,","+  isMediaLibraryView,","+} from '../form/studio/federatedAssetSource'"," import {prepareI18n} from '../i18n/i18nConfig'"," import {type LocaleSource} from '../i18n/types'"," import {createSchema} from '../schema/createSchema'","@@ -68,7 +75,9 @@ import {","   initialDocumentActions,","   initialDocumentBadges,","   initialLanguageFilter,","+  federatedAssetSourcesReducer,","   mediaLibraryEnabledReducer,","+  mediaLibraryFederatedAssetSourceReducer,","   mediaLibraryFrontendHostReducer,","   mediaLibraryLibraryIdReducer,","   newDocumentOptionsResolver,","@@ -239,25 +248,99 @@ function getObjectId(value: object): number {","   return id"," }"," ","+// The iframe fallback is legitimate (cold start, non-dashboard studio, org","+// without a brokered view) but easy to mistake for the federated view since","+// both render the full Media Library UI. Announce it once so a dev session","+// that silently degraded is diagnosable from the console.","+let notifiedFederatedFallback = false","+const notifyFederatedFallbackOnce = (reason: string) => {","+  if (notifiedFederatedFallback) return","+  notifiedFederatedFallback = true","+  // oxlint-disable-next-line no-console -- intentional one-shot diagnostic","+  console.info(","+    `[sanity] Media Library federated asset source unavailable (${reason}); ` +","+      'falling back to the iframe select dialog. In a dashboard dev session ' +","+      'this usually means the studio booted before the Media Library dev ' +","+      'server registered — reload once all dev servers are up.',","+  )","+}","+"," // Create media library sources with configuration"," const createMediaLibraryAssetSources = (config: PluginOptions) => {","   const libraryId = mediaLibraryLibraryIdReducer({config, initialValue: undefined})","   const enabled = mediaLibraryEnabledReducer({config, initialValue: false})","+  const federated = mediaLibraryFederatedAssetSourceReducer({config, initialValue: false})","+  // Third-party brokered views have their own gate (`federatedAssetSources`),","+  // decoupled from the Media Library's internal rollout flag.","+  const federatedSourcesConfig = federatedAssetSourcesReducer({config, initialValue: undefined})","+  const brokeredSourcesEnabled = federatedSourcesConfig?.enabled === true","+","+  // The `asset_source` views brokered over the workbench message bus, read","+  // synchronously since sources are resolved once here. `undefined` outside","+  // the workbench; on a cold start in which the workbench has not published","+  // its application list yet, `[]` — either way every brokered source is","+  // simply absent and the Media Library keeps its iframe select dialog, so","+  // the race can never cost the Media Library source itself.","+  const viewsFromBus =","+    federated || brokeredSourcesEnabled ? getCurrentFederatedAssetSourceViews() : undefined","+  const brokeredViews = viewsFromBus ?? []","+","+  // The Media Library's own view replaces the select dialog of the built-in","+  // source below; views from other applications become their own sources.","+  const mediaLibraryView = federated ? brokeredViews.find(isMediaLibraryView) : undefined","+","+  if (federated && enabled && !mediaLibraryView) {","+    notifyFederatedFallbackOnce(","+      viewsFromBus === undefined","+        ? 'no workbench message bus'","+        : 'no Media Library asset_source view in the brokered application list',","+    )","+  }","+  const viewFilter = federatedSourcesConfig?.filter","+  const viewUploads = federatedSourcesConfig?.uploads","+  const federatedSources = brokeredSourcesEnabled","+    ? brokeredViews","+        .filter((view) => !isMediaLibraryView(view))","+     