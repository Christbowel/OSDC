ast();","+    }","+}","+contract DeployAlpha is Script {","+    function run() external {","+        bytes memory raw = RAW;","+        vm.startBroadcast();","+        new Alpha();","+        vm.deployCode(\"src/Alpha.vy:Alpha\");","+        assembly { pop(create(0, add(raw, 0x20), mload(raw))) }","+        vm.stopBroadcast();","+    }","+}","+\"#,","+    );","+","+    let (_api, handle) = spawn(NodeConfig::test()).await;","+    let wallet = handle.dev_wallets().next().unwrap();","+    let pk = hex::encode(wallet.credential().to_bytes());","+    let rpc = handle.http_endpoint();","+    let (verifier_url, _, _server) = spawn_full_mock_verifier().await;","+    let script = |target: &str| {","+        [","+            \"script\".to_string(),","+            format!(\"script/Deploy.s.sol:{target}\"),","+            \"--rpc-url\".to_string(),","+            rpc.clone(),","+            \"--private-key\".to_string(),","+            pk.clone(),","+            \"--broadcast\".to_string(),","+        ]","+    };","+    let verify = [","+        \"--verify\",","+        \"--verifier\",","+        \"custom\",","+        \"--verifier-url\",","+        verifier_url.as_str(),","+        \"--verifier-api-key\",","+        \"VALID_KEY\",","+    ];","+","+    // Unmatched contracts that never exactly matched a project artifact only warn and count as","+    // skipped, on a fresh run and on resume: raw bytecode has no recorded name, and `Beta` with a","+    // flipped metadata byte is only named by fuzzy matching.","+    cmd.forge_fuse().args(script(\"DeployUnmatched\")).args(verify).assert_success().stderr_eq(str![[r#\"","+Warning: We haven't found any matching bytecode for the following contracts: [0x5fbdb2315678afecb367f032d93f642f64180aa3, 0xe7f1725e7734ce288f8367e1bb143e90bb3f0512].","+","+This may occur when resuming a verification, but the underlying source code or compiler version has changed.","+Run `forge clean` to make sure builds are in sync with project files, then try again. Alternatively, use `forge verify-contract` to verify contracts that are already deployed.","+##","+Start verification for (0) contracts","+Verified (0) contracts; skipped (2) contracts (see warnings above).","+","+\"#]]);","+    cmd.forge_fuse()","+        .args(script(\"DeployUnmatched\"))","+        .arg(\"--resume\")","+        .args(verify)","+        .assert_success()","+        .stderr_eq(str![[r#\"","+Warning: We haven't found any matching bytecode for the following contracts: [0x5fbdb2315678afecb367f032d93f642f64180aa3, 0xe7f1725e7734ce288f8367e1bb143e90bb3f0512].","+","+This may occur when resuming a verification, but the underlying source code or compiler version has changed.","+Run `forge clean` to make sure builds are in sync with project files, then try again. Alternatively, use `forge verify-contract` to verify contracts that are already deployed.","+##","+Start verification for (0) contracts","+Verified (0) contracts; skipped (2) contracts (see warnings above).","+","+\"#]]);","+","+    let broadcast: serde_json::Value = foundry_common::fs::read_json_file(","+        &prj.root().join(\"broadcast/Deploy.s.sol/31337/run-latest.json\"),","+    )","+    .unwrap();","+    assert_eq!(broadcast[\"transactions\"][1][\"contractName\"], \"Beta\");","+","+    // A Vyper contract is skipped even when a Solidity contract shares its name.","+    cmd.forge_fuse().args(script(\"DeployVyper\")).args(verify).assert_success().stderr_eq(str![[r#\"","+Warning: We haven't found any matching bytecode for the following contracts: [0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0].","+","+This may occur when resuming a verification, but the underlying source code or compiler version has changed.","+Run `forge clean` to make sure builds are in sync with project files, then try again. Alternatively, use `forge verify-contract` to verify contracts that are already deployed.","+##","+Start verification for (0) contracts","+Verified (0) contracts; skipped (1) contracts (see warnings above).","+","+\"#]]);","+","+    // After both `Alpha` sources change, the Solidity `Alpha` and its nested `Child` fail, while","+    // the Vyper `Alpha` and raw bytecode only warn.","+    cmd.forge_fuse().args(script(\"DeployAlpha\")).assert_success();","+    prj.add_raw_source(\"Alpha.vy\", \"x: public(uint256)\\nz: public(uint256)\\n\");","+    prj.add_source(","+        \"Alpha.sol\",","+        \"contract Child { uint256 public x = 2; } contract Alpha { Child public child = new Child(); }\",","+    );","+    cmd.forge_fuse()","+        .args(script(\"DeployAlpha\"))","+        .arg(\"--resume\")","+        .args(verify)","+        .assert_failure()","+        .stderr_eq(str![[r#\"","+Warning: We haven't found any matching bytecode for the following contracts: [0xcf7ed3acca5a467e9e704c703e8d87f634fb0fc9, 0xd8058efe0198ae9dd7d563e1b4938dcbc86a1f81, 0xdc64a140aa3e981100a9beca4e685f962f0cf6c9, 0x5fc8d32690cc91d4c39d9d3abcbd16989f875707].","+","+This may occur when resuming a verification, but the underlying source code or compiler version has changed.","+Run `forge clean` to make sure builds are in sync with project files, then try again. Alternatively, use `forge verify-contract` to verify contracts that are already deployed.","+##","+Start verification for (2) contracts","+Error: Not all (0 / 2) contracts were verified; no local artifact matches the creation code of Alpha at 0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9, Child at 0xd8058efe0198ae9dD7D563e1b4938Dcbc86A1F81!","+","+\"#]]);","+}","+","+// Equal sender nonces on different chains must not make one deployment inherit the other's","+// artifact identity when deciding whether verification is required.","+#[forgetest_init]","+async fn script_verify_fork_same_address_different_artifacts(prj: _, cmd: _) {","+    prj.add_source(\"Alpha.sol\", \"contract Alpha { uint256 public x = 1; }\");","+    prj.add_source(\"Beta.sol\", \"contract Beta { uint256 public y = 2; }\");","+    let (_api1, handle1) = spawn(Nod