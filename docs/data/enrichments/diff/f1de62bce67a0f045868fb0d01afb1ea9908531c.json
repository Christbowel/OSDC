","+      expect(await getDefaultDataSourceInstanceListItem(items)).toBeUndefined();","+    });","+","+    it('returns the first flagged item when more than one is flagged', async () => {","+      const items = [","+        listItem({ uid: 'uid-alpha', name: 'Alpha' }),","+        listItem({ uid: 'uid-bravo', name: 'Bravo', isDefault: true }),","+        listItem({ uid: 'uid-charlie', name: 'Charlie', isDefault: true }),","+      ];","+","+      expect((await getDefaultDataSourceInstanceListItem(items))?.name).toBe('Bravo');","+    });","+","+    it('returns undefined for an empty list', async () => {","+      expect(await getDefaultDataSourceInstanceListItem([])).toBeUndefined();","     });"," ","-    it('returns undefined when no instance of the type exists (does not return -- Grafana --)', async () => {","+    it('resolves the org default from an unfiltered list', async () => {","       initDataSourceInstanceSettings(fixtures, 'Bravo');","-      const item = await getDefaultDataSourceInstanceListItem('nonexistent');","-      expect(item).toBeUndefined();","+","+      const items = await getDataSourceInstanceList();","+","+      expect((await getDefaultDataSourceInstanceListItem(items))?.name).toBe('Bravo');","     });"," ","-    it('counts capability-less instances (all: true)', async () => {","-      const noCapability: Record<string, DataSourceInstanceSettings> = {","-        NoOp: ds({","-          id: 10,","-          uid: 'uid-noop',","-          name: 'NoOp',","-          type: 'noop',","-          isDefault: true,","-          meta: {","-            ...ds({}).meta,","-            id: 'noop',","-            metrics: false,","-            annotations: false,","-            tracing: false,","-            logs: false,","-            alerting: false,","-          },","-        }),","-      };","-      initDataSourceInstanceSettings(noCapability, 'NoOp');","-      const item = await getDefaultDataSourceInstanceListItem('noop');","-      expect(item?.name).toBe('