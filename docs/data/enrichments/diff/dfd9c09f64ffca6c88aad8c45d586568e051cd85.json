:OK);","+    assert!(query.error.is_none(), \"{query:?}\");","+","+    // A token polling request must use the claim's tenant without looking up","+    // user info, even if no tenant header is supplied (or it is misleading).","+    let mut token_owner = TestHttpQueryRequest::new(serde_json::json!({}));","+    token_owner.auth_header = format!(\"Bearer {token}\").parse()?;","+    token_owner.headers.insert(header::COOKIE, cookie.parse()?);","+    for tenant in [None, Some(\"other-tenant\")] {","+        if let Some(tenant) = tenant {","+            token_owner","+                .headers","+                .insert(\"x-databend-tenant\", tenant.parse()?);","+        }","+        let response = token_owner","+            .do_request_raw(Method::GET, &format!(\"/v1/query/{}\", query.id))","+            .await?;","+        assert_eq!(response.status(), StatusCode::OK);","+    }","+","+    // Same username and same client session ID, but a different tenant.","+    headers.insert(\"x-databend-tenant\", \"other-tenant\".parse()?);","+    let mut other = TestHttpQueryRequest::new(serde_json::json!({})).with_headers(headers);","+    for (method, suffix) in [","+        (Method::GET, \"\"),","+        (Method::GET, \"/page/0\"),","+        (Method::GET, \"/kill\"),","+        (Method::POST, \"/kill\"),","+        (Method::GET, \"/final\"),","+        (Method::POST, \"/final\"),","+    ] {","+        let response = other","+            .do_request_raw(method, &format!(\"/v1/query/{}{suffix}\", query.id))","+            .await?;","+        assert_eq!(response.status(), StatusCode::UNAUTHORIZED);","+        let body = response.into_body().into_string().await?;","+        for secret in [\"owner-tenant\", \"owner-session\", \"root\"] {","+            assert!(!body.contains(secret), \"{body}\");","+        }","+    }","+    other.json =","+        serde_json::json!({\"node_to_queries\": {query.node_id.clone(): [query.id.clone()]}});","+    let response = other","+        .do_request_raw(Method::POST, \"/v1/session/heartbeat\")","+        .await?;","+    assert_eq!(response.status(), StatusCode::OK);","+    let body: serde_json::Value = response.into_body().into_json().await?;","+    assert_eq!(body[\"queries_to_remove\"], serde_json::json!([query.id]));","+","+    // The denied close requests did not close the original query.","+    let response = token_owner","+        .do_request_raw(Method::GET, &make_page_uri(&query.id, 0))","+        .await?;","+    assert_eq!(response.status(), StatusCode::OK);","+","+    // Side-channel access needs the same tenant and user, not the same session.","+    let mut side_channel = TestHttpQueryRequest::new(serde_json::json!({}));","+    side_channel","+        .headers","+        .insert(\"x-databend-tenant\", \"owner-tenant\".parse()?);","+    for cookie in [None, Some(\"cookie_enabled=true; session_id=other-session\")] {","+        if let Some(cookie) = cookie {","+            side_channel.headers.insert(header::COOKIE, cookie.parse()?);","+        }","+        let response = side_channel","+            .do_request_raw(Method::GET, &format!(\"/v1/query/{}\", query.id))","+            .await?;","+        assert_eq!(response.status(), StatusCode::OK);","+        side_channel.json =","+            serde_json::json!({\"node_to_queries\": {query.node_id.clone(): [query.id.clone()]}});","+        let response = side_channel","+            .do_request_raw(Method::POST, \"/v1/session/heartbeat\")","+            .await?;","+        assert_eq!(response.status(), StatusCode::OK);","+        let body: serde_json::Value = response.into_body().into_json().await?;","+        assert_eq!(body[\"queries_to_remove\"], serde_json::json!([]));","+        for suffix in [\"/page/0\", \"/final\"] {","+            let response = side_channel","+                .do_request_raw(Method::GET, &format!(\"/v1/query/{}{suffix}\", query.id))","+                .await?;","+            assert_eq!(response.status(), StatusCode::UNAUTHORIZED);","+        }","+    }","+    let response = side_channel","+        .do_request_raw(Method::POST, &format!(\"/v1/query/{}/kill\", query.id))","+        .await?;","+    assert_eq!(response.status(), StatusCode::OK);","+    let response = token_owner","+        .do_request_raw(Method::POST, query.final_uri.as_ref().unwrap())","+        .await?;","+    assert_eq!(response.status(), StatusCode::OK);","+    Ok(())","+}","+"," #[tokio::test(flavor = \"current_thread\")]"," async fn test_arrow_query_page_keeps_negotiated_decimal64_feature() -> anyhow::Result<()> {","     let _fixture = TestFixture::setup().await?;"],"additions":200,"deletions":0,"truncated":false},{"path":"tests/nox/suites/http_handler/test_query_owner.py","lines":["@@ -0,0 +1,324 @@","+\"\"\"HTTP query ownership, session isolation and heartbeat forwarding.","+","+Run with: nox -f tests/nox/noxfile.py -s test_suites --","+    suites/http_handler/test_query_owner.py","+Remote cases use the standard cluster's second query node on port 8002.","+\"\"\"","+","+import time","+import uuid","+from contextlib import contextmanager","+","+import pytest","+import requests","+","+BASE_URL = \"http://localhost:8000\"","+PASSWORD = \"query_owner_password\"","+SESSION_ID = \"X-DATABEND-SESSION-ID\"","+STICKY = \"X-DATABEND-STICKY-NODE\"","+","+","+def client(auth):","+    session = requests.Session()","+    # The local test deployment must not go through an HTTP proxy.","+    session.trust_env = False","+    session.auth = auth","+    return session","+","+","+def request(session, method, path, base_url=BASE_URL, **kwargs):","+    return session.request(method, base_url + path, timeout=30, **kwargs)","+","+","+def command(session, sql):","+    response = request(session, \"POST\", \"/v1/query\", json={\"sql\": sql})","+    response.raise_for_status()","+    body = response.json()","+    rows = list(body.get(\"data\", []))","+    for _ in range(100):","+        assert body.get(\"error\") is None, body","+        uri = body.get(\"next_uri\")","+        if not uri:","+            return rows","+        response = request(session, \"GET\", uri)","+        response.raise_for_status()","+        body = response.json()","+        rows.extend(body.get(\"data\", []))","+    pytest.fail(\"SQL command did not finish within 100 pages\")","+","+","+@pytest.fixture","+def users():","+    suffix = uuid.uuid4().hex","+    names = [f\"http_owner_{suffix}\", f\"http_other_{suffix}\"]","+    with client((\"root\", \"\")) as root:","+        try:","+            for name in names:","+                command(root, f\"CREATE USER '{name}' IDENTIFIED BY '{PASSWORD}'\")","+                command(root, f\"GRANT SELECT ON *.* TO '{name}'\")","+            yield [(name, PASSWORD) for name in names]","+        finally:","+            for name in names:","+                command(root, f\"DROP USER IF EXISTS '{name}'\")","+","+","+@contextmanager","+def owner_client(auth, mode):","+    with client(auth) as session:","+        if mode in (\"cookie\", \"token\"):","+            session.cookies.set(\"cookie_enabled\", \"true\")","+        elif mode == \"header\":","+            session.headers[\"X-DATABEND-CLIENT-CAPS\"] = \"session_header\"","+        elif mode == \"worksheet\":","+            session.headers[\"User-Agent\"] = \"DatabendCloud/worksheet=owner-test\"","+            session.headers[SESSION_ID] = str(uuid.uuid4())","+        if mode != \"none\":","+            response = request(session, \"POST\", \"/v1/session/login\", json={})","+            response.raise_for_status()","+            body = response.json()","+            assert body.get(\"error\") is None, body","+            if mode == \"header\":","+                session.headers[\"X-DATABEND-SESSION\"] = response.headers[","+                    \"X-DATABEND-SESSION\"","+                ]","+            if mode == \"token\":","+                session.auth = None","+                session.headers[\"Authorization\"] = (","+                    f\"Bearer {body['tokens']['session_token']}\"","+                )","+        yield session","+","+","+@contextmanager","+def running_query(session, base_url=BASE_URL, sql=None, result_timeout=60):","+    query_id = f\"http_owner_{uuid.uuid4().hex}\"","+    response = request(","+        session,","+        \"POST\",","+        \"/v1/query\",","+        base_url,","+        headers={\"x-databend-query-id\": query_id},","+        json={","+            \"sql\": sql or \"SELECT sleep(0.5), number FROM numbers(15000000000)\",","+            \"pagination\": {","+                \"wait_time_secs\": 1,","+                \"max_rows_per_page\": 1,","+                \"max_rows_in_buffer\": 2,","+            },","+            \"session\": {","+                \"settings\": {","+                    \"http_handler_result_timeout_secs\": str(result_timeout),","+                    \"max_threads\": \"2\",","+                }","+            },","+        },","+    )","+    response.raise_for_status()","+    body = response.json()","+    assert body.get(\"error\") is None, body","+    assert body[\"id\"] == query_id, body","+    if sql is None:","+        assert body[\"state\"] == \"Running\", body","+    try:","+        yield body","+    finally:","+        response = request(session, \"GET\", body[\"final_uri\"], base_url)","+        response.raise_for_status()","+","+","+def state(session, query, base_url=BASE_URL):","+    response = request(session, \"GET\", f\"/v1/query/{query['id']}\", base_url)","+    response.raise_for_status()","+    return response.json()","+","+","+def assert_denied(response, owner_name, session_id):","+    assert response.status_code == 401, response.text","+    assert owner_name not in response.text, response.text","+    if session_id:","+        assert session_id not in response.text, response.text"],"additions":139,"deletions":0,"truncated":false}],"additions":433,"deletions":83,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-11-