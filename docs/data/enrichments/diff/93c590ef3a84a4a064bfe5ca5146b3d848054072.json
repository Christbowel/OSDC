del_config=target,","+            target_parallel_config=ParallelConfig(),","+            **lossy_kwargs,","+        )"],"additions":47,"deletions":0,"truncated":false},{"path":"vllm/config/model.py","lines":["@@ -383,6 +383,10 @@ class ModelConfig:","     used with `--generation-config auto`, the override parameters will be","     merged with the default config from the model. If used with","     `--generation-config vllm`, only the override parameters are used.\"\"\"","+    masked_token_ids: list[int] | None = None","+    \"\"\"Token ids that are never sampled (their logits are set to -inf before","+    sampling), e.g. the lm_head rows past the tokenizer or placeholder tokens.","+    Prompt logprobs are unaffected.\"\"\"","     enable_sleep_mode: bool = False","     \"\"\"Enable sleep mode for the engine (only cuda and","     hip platforms are supported).\"\"\"","@@ -521,6 +525,7 @@ def compile_factors(self) -> CompileFactors:","             \"skip_mm_profiling\",","             \"mm_ipc_gpu_memory_gb\",","             \"checkpoint_prepare_on_startup\",","+            \"masked_token_ids\",","         }"," ","         factors = get_compile_factors(self, ignored_factors)","@@ -969,6 +974,7 @@ def __post_init__(","         self._try_verify_and_update_model_config()","         self._verify_quantization()","         self._verify_cuda_graph()","+        self._verify_masked_token_ids()"," ","     def _supports_multimodal_inputs(self) -> bool:","         \"\"\"Checks if the model supports multimodal inputs.","@@ -1596,6 +1602,16 @@ def _verify_quantization(self) -> None:","                     self.quantization,","                 )"," ","+    def _verify_masked_token_ids(self) -> None:","+        if not self.masked_token_ids:","+            return","+        vocab_size = self.get_vocab_size()","+        invalid = [i for i in self.masked_token_ids if not 0 <= i < vocab_size]","+        if invalid:","+            raise ValueError(","+                f\"masked_token_ids mus