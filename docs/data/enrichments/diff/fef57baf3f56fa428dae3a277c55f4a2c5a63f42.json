{"id":"fef57baf3f56fa428dae3a277c55f4a2c5a63f42","axis":"silent","repo":"pnpm/pnpm","sha":"fef57baf3f56fa428dae3a277c55f4a2c5a63f42","parsed":{"files":[{"path":".changeset/pnpr-release-notes.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+With SQLite metadata, pnpr stores release notes for package versions and publications. A publish can include them in a `notes` field. Publishers can edit or delete a note later. npm clients read a version's note at `/npm/<name>/<version>/notes`. A package's notes are listed at `/npm/<name>/-/notes`. A publication's note is at `/-/publications/<org>/<id-or-name>/notes`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -115,6 +115,7 @@ mod health;"," use health::shutdown_signal;"," mod managed_state;"," mod metrics;","+mod notes;"," mod oci;"," mod oidc;"," mod oidc_groups;","@@ -155,7 +156,7 @@ use self::{","     },","     publishing::{","         PublishTarget, check_publish_tombstone, commit_publishes, publish_package,","-        resolve_publish_target_for, stage_publish, validate_publish_doc,","+        resolve_publish_target_for, routes_to_upstream, stage_publish, validate_publish_doc,","     },","     routing::{metrics_listener_router, router_with_auth_and_osv, state_and_router},"," };"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/batch.rs","lines":["@@ -27,9 +27,10 @@ use super::{","     cargo::{CratePublication, authorize_crate_publish, verify_crate_archive},","     oci::{OciPublication, authorize_publication},","     publishing::{","-        StagedPublish, cleanup_tmp_slots, commit_publication, publication_name,","-        publication_request, publish_committed_response, replayed_outcome, single_catalog,","-        stage_publish, validate_publish_doc,","+        StagedPublish, check_note_storage, cleanup_tmp_slots, commit_publication, publication_name,","+        publication_request, publish_committed_response, refuse_notes_of_published_python_versions,","+        replayed_outcome, single_catalog, stage_publish, take_note, take_version_note,","+        validate_publish_doc,","     },","     pypi::{PypiPublication, authorize_upload, verify_upload},"," };","@@ -45,7 +46,10 @@ use pnpr_error::RegistryError;"," use pnpr_package_name::CanonicalPackageName;"," use pnpr_pypi::Upload;"," use pnpr_registry::Ecosystem;","-use pnpr_storage::{metadata::PublicationRequest, publish::now_iso};","+use pnpr_storage::{","+    metadata::{PublicationRequest, PublishNotes},","+    publish::now_iso,","+};"," use serde::Deserialize;"," use serde_json::Value;"," use std::collections::HashSet;","@@ -159,7 +163,8 @@ async fn publish_batch(","     drop(body);","     let name = publication_name(&incoming)?;","     let request = publication_request(state, identity, &incoming, key, name, None);","-    let packages = take_packages(&mut incoming)?;","+    let mut packages = take_packages(&mut incoming)?;","+    let notes = batch_notes(state, &mut incoming, &mut packages)?;","     let validated = validate_batch_entries(state, identity, packages).await?;"," ","     // Hold every affected package's lock across the whole stage-and-commit,","@@ -177,12 +182,27 @@ async fn publish_batch(","     if let Some(replayed) = replayed_batch(state, request.as_ref(), &validated).await? {","         return Ok(replayed);","     }","+    refuse_late_python_notes(state, &validated, &notes).await?;"," ","     let staged = stage_entries(state, validated).await?;","-    let receipt = commit_publication(state, staged, request).await?;","+    let receipt = commit_publication(state, staged, notes, request).await?;","     Ok(publish_committed_response(&receipt))"," }"," ","+/// Refuse the batch's notes for Python versions already published, in the","+/// one catalog its entries target.","+async fn refuse_late_python_notes(","+    state: &AppState,","+    validated: &[ValidatedEntry],","+    notes: &PublishNotes,","+) -> Result<(), RegistryError> {","+    if notes.versions.is_empty() {","+        return Ok(());","+    }","+    let catalog = single_catalog(validated.iter().map(ValidatedEntry::org))?;","+    refuse_notes_of_published_python_versions(state, &catalog, notes).await","+}","+"," /// The recorded outcome of the batch `request` repeats, in the one catalog"," /// its entries target. A request exists only with `SQLite` metadata, whose"," /// publish targets one catalog.","@@ -219,6 +239,24 @@ async fn stage_entries(","     Ok(staged)"," }"," ","+/// The publication note at the top of a batch body and the version note of","+/// each entry, taken out of the body.","+fn batch_notes(","+    state: &AppState,","+    incoming: &mut Value,","+    packages: &mut [Value],","+) -> Result<PublishNotes, RegistryError> {","+    let publication = take_note(incoming)?;","+    let mut versions = Vec::new();","+    for package in packages {","+        let ecosystem = entry_ecosystem(package)?;","+        versions.extend(take_version_note(package, ecosystem)?);","+    }","+    let notes = PublishNotes { publication, versions };","+    check_note_storage(state, &notes)?;","+    Ok(notes)","+}","+"," /// The `packages` array of a batch body, which must not be empty."," fn take_packages(incoming: &mut Value) -> Result<Vec<Value>, RegistryError> {","     let Some(Value::Array(packages)) = incoming"],"additions":44,"deletions":6,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/notes.rs","lines":["@@ -0,0 +1,179 @@","+//! Release notes of hosted npm package versions:","+//!","+//! - `GET|PUT|DELETE {base}/{name}/{version}/notes` — one version's note.","+//!   `GET` also takes a dist-tag.","+//! - `GET {base}/{name}/-/notes` — the notes of every version, newest first.","+//!","+//! A version note has the access rules of its package: reading it needs read","+//! access, writing it the package's `publish` rule. Notes are served only","+//! when the metadata lives in `SQLite`. A version's publication note is","+//! referenced only when the caller may read every member of the publication.","+","+pub(super) use listing::serve_package_notes;","+pub(super) use responses::{NoteRequest, PublicationLink, note_text_response, read_note_body};","+","+mod listing;","+mod responses;","+","+use super::{","+    Action, AppState, Identity, RegistrySource, WriteTarget, authorize_package, not_found,","+    publications::{PublicationNoteLink, readable_publication_note},","+    resolve_write_target,","+};","+use axum::response::{IntoResponse, Response};","+use pnpr_error::RegistryError;","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};","+use pnpr_storage::metadata::{NoteChange, SqliteMetadata};","+use responses::version_note_response;","+use std::sync::Arc;","+","+/// The hosted package a notes request addresses, once the caller may reach","+/// it.","+struct NotesTarget {","+    database: Arc<SqliteMetadata>,","+    name: CanonicalPackageName,","+    target: WriteTarget,","+}","+","+/// Resolve the hosted package and check that the caller may read it, or for a","+/// write, publish it. A package that routes to an upstream has no notes.","+async fn notes_target(","+    state: &AppState,","+    identity: &Identity,","+    registry: Option<&str>,","+    raw_name: &str,","+    writes: bool,","+) -> Result<NotesTarget, Response> {","+    let database = state.inner.storage","+        .sqlite_metadata()","+        .cloned()","+        .ok_or_else(not_found)?;","+    let name = CanonicalPackageName::parse(raw_name, Ecosystem::Npm).map_err(|_| not_found())?;","+    let target = match resolve_write_target(state, identity, registry, &name) {","+        Ok(target) => target,","+        Err(RegistryError::BadRequest { .. }) => return Err(not_found()),","+        Err(err) => return Err(err.into_response()),","+    };","+    if writes {","+        let source = RegistrySource::Hosted(target.source.clone());","+        authorize_package(","+            state,","+            identity,","+            &source,","+            name.as_str(),","+            Action::Publish,","+            Some(&target.org),","+        )","+        .await","+        .map_err(IntoResponse::into_response)?;","+    }","+    Ok(NotesTarget { database, name, target })","+}","+","+/// `{base}/{name}/{version}/notes`.","+pub(super) async fn serve_version_note(","+    state: &AppState,","+    identity: &Identity,","+    registry: Option<&str>,","+    (raw_name, version): (&str, &str),","+    request: NoteRequest,","+) -> Response {","+    let writes = !matches!(request, NoteRequest::Read);","+    let notes = match notes_target(state, identity, registry, raw_name, writes).await {","+        Ok(notes) => notes,","+        Err(response) => return response,","+    };","+    let result = match request {","+        NoteRequest::Read => read_version_note(state, identity, &notes, version).await,","+        NoteRequest::Write(text) => write_version_note(identity, &notes, version, Some(text)).await,","+        NoteRequest::Delete => write_version_note(identity, &notes, version, None).await,","+    };","+    result.unwrap_or_else(IntoResponse::into_response)","+}","+","+async fn read_version_note(","+    state: &AppState,","+    identity: &Identity,","+    notes: &NotesTarget,","+    version_or_tag: &str,","+) -> Result<Response, RegistryError> {","+    let version = resolve_tag(state, notes, version_or_tag).await?;","+    let NotesTarget { database, name, target } = notes;","+    // A removed version keeps its note and publication on record, but no","+    // longer serves them.","+    if !database.has_version(name, &target.org, &version).await? {","+        return Err(RegistryError::NotFound);","+    }","+    let note = database.version_note(name, &target.org, &version).await?;","+    let publication = database.initial_publication(name, &target.org, &version).await?;","+    let access = match publication {","+        Some(publication) => {","+            readable_publication_note(state, identity, database, publication).await?","+        }","+        None => PublicationNoteLink { link: None, withheld: false },","+    };","+    let link = access.link;","+    // A response that leaves out a note the caller may not read differs from","+    // what another caller gets, so no shared cache may keep it.","+    let public =","+        !access.withheld && super::publications::anonymously_readable(state, &target.source, name);","+    Ok(version_note_response(","+        note.as_ref(),","+        link.as_ref(),","+        public,","+        &state.inner.config.http.public_url,","+    ))","+}","+","+/// The version a dist-tag names, or `version_or_tag` itself. A stored","+/// version wins over a dist-tag of the same spelling; a tag such as `v1.2.3`","+/// parses as semver but still names whatever version it points at.","+async fn resolve_tag(","+    state: &AppState,","+    notes: &NotesTarget,","+    version_or_tag: &str,","+) -> Result<String, RegistryError> {","+    if notes.database.has_version(&notes.name, &notes.target.org, version_or_tag).await? {","+        return Ok(version_or_tag.to_string());","+    }","+    let storage = state.inner.storage.for_hosted(&notes.target.org, Ecosystem::Npm);","+    let Some(view) = storage.read_hosted_package_view(&notes.name).await? else {","+        return Err(RegistryError::NotFound);","+    };","+    let document: serde_json::Value = serde_json::from_slice(&view.bytes)?;","+    let tagged = document","+        .get(\"dist-tags\")","+        .and_then(|tags| tags.get(version_or_tag));","+    Ok(tagged","+        .and_then(serde_json::Value::as_str)","+        .unwrap_or(version_or_tag)","+        .to_string())","+}","+","+async fn write_version_note(","+    identity: &Identity,","+    notes: &NotesTarget,","+    version: &str,","+    text: Option<String>,","+) -> Result<Response, RegistryError> {","+    let principal = identity","+        .username()","+        .unwrap_or(\"-\")","+        .to_string();","+    let deleted = text.is_none();","+    let change = NoteChange { text, principal: principal.clone() };","+    let NotesTarget { database, name, target } = notes;","+    if !database.set_version_note(name, &target.org, version, change).await? {","+        return Err(RegistryError::NotFound);","+    }","+    tracing::info!(","+        target: \"pnpr::audit\",","+        action = if deleted { \"package.note_delete\" } else { \"package.note_set\" },","+        actor = %principal,","+        package = %name.as_str(),","+        version = %version,","+        registry = %target.source,","+        \"package version note changed\",","+    );","+    Ok(axum::http::StatusCode::NO_CONTENT.into_response())","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/notes/listing.rs","lines":["@@ -0,0 +1,272 @@","+//! `GET {base}/{name}/-/notes`: every note of a package in one cacheable","+//! document, newest version first.","+","+use super::{","+    NotesTarget, notes_target,","+    responses::{PublicationLink, with_cache_rules},","+};","+use crate::server::{","+    AppState, Identity, PublishTarget,","+    publications::{PublicationNoteLink, readable_publication_note},","+    resolve_publish_target_for, routes_to_upstream,","+};","+use axum::{","+    Json,","+    response::{IntoResponse, Response},","+};","+use pnpr_error::RegistryError;","+use pnpr_registry::Ecosystem;","+use pnpr_storage::metadata::Note;","+use serde_json::{Map, Value, json};","+use std::collections::{BTreeMap, BTreeSet};","+","+/// Most entries the document lists.","+const MAX_ENTRIES: usize = 100;","+/// Most bytes of serialized entries the document holds.","+const MAX_BYTES: usize = 1024 * 1024;","+/// Most versions the listing examines for one document: the newest ones.","+const MAX_CANDIDATES: usize = 4 * MAX_ENTRIES;","+","+pub(in crate::server) async fn serve_package_notes(","+    state: &AppState,","+    identity: &Identity,","+    registry: Option<&str>,","+    raw_name: &str,","+) -> Response {","+    if upstream_without_notes(state, identity, registry, raw_name) {","+        return with_cache_rules(Json(json!({ \"notes\": [] })).into_response(), false);","+    }","+    let notes = match notes_target(state, identity, registry, raw_name, false).await {","+        Ok(notes) => notes,","+        Err(response) => return response,","+    };","+    match package_notes(state, identity, &notes).await {","+        Ok(response) => response,","+        Err(err) => err.into_response(),","+    }","+}","+","+/// Whether the package routes to an upstream registry the caller may read.","+/// An upstream such as npm's registry keeps no notes, so its packages list","+/// none. Forwarding to an upstream that is another pnpr is not done yet.","+fn upstream_without_notes(","+    state: &AppState,","+    identity: &Identity,","+    registry: Option<&str>,","+    raw_name: &str,","+) -> bool {","+    let target = resolve_publish_target_for(state, identity, registry, Ecosystem::Npm, raw_name);","+    matches!(target, PublishTarget::Reject(_))","+        && routes_to_upstream(state, registry, Ecosystem::Npm, raw_name)","+}","+","+/// Build the listing newest first, reading a version's note and resolving","+/// its publication only while the document still has room, so a package","+/// with a long history costs no more than the entries the document holds.","+async fn package_notes(","+    state: &AppState,","+    identity: &Identity,","+    notes: &NotesTarget,","+) -> Result<Response, RegistryError> {","+    let candidates = Candidates::load(notes).await?;","+    let package_public =","+        crate::server::publications::anonymously_readable(state, &notes.target.source, &notes.name);","+    let mut listing = Listing { public: package_public, ..Listing::default() };","+    let mut links = BTreeMap::new();","+    // Entries the caller may not read are skipped, so only the newest","+    // candidates are examined, long before a package's whole history.","+    let (newest, more) = candidates.newest();","+    for version in newest {","+        let Some((entry, public)) =","+            candidates.entry(state, identity, notes, &mut links, version).await?","+        else {","+            continue;","+        };","+        if !listing.push(entry, public) {","+            break;","+        }","+    }","+    listing.truncated |= more;","+    // A note left out because the caller may not read it makes the document","+    // differ between callers, so no shared cache may keep it.","+    listing.public &= !links.values().any(|link: &PublicationNoteLink| link.withheld);","+    Ok(listing.into_response())","+}","+","+/// The versions the listing may name, without their notes: those whose note","+/// holds text or a publish-time digest, and those whose publication's note","+/// does.","+struct Candidates {","+    noted: BTreeSet<String>,","+    published: BTreeMap<String, u64>,","+}","+","+impl Candidates {","+    async fn load(notes: &NotesTarget) -> Result<Self, RegistryError> {","+        let NotesTarget { database, name, target } = notes;","+        let noted = database.noted_versions(name, &target.org).await?;","+        let published = database.noted_publications(name, &target.org).await?;","+        Ok(Self { noted: noted.into_iter().collect(), published: published.into_iter().collect() })","+    }","+","+    /// The newest [`MAX_CANDIDATES`] versions, newest first, and whether","+    /// older ones were left out. Each version is parsed once, and only the","+    /// selected ones are sorted.","+    fn newest(&self) -> (Vec<&String>, bool) {","+        let versions: BTreeSet<&String> = self.noted","+            .iter()","+            .chain(self.published.keys())","+            .collect();","+        let mut keyed: Vec<(Option<node_semver::Version>, &String)> = versions","+            .into_iter()","+            .map(|version| (node_semver::Version::parse(version).ok(), version))","+            .collect();","+        let more = keyed.len() > MAX_CANDIDATES;","+        if more {","+            keyed.select_nth_unstable_by(MAX_CANDIDATES - 1, newest_first);","+            keyed.truncate(MAX_CANDIDATES);","+        }","+        keyed.sort_by(newest_first);","+        (","+            keyed","+                .into_iter()","+                .map(|(_, version)| version)","+                .collect(),","+            more,","+        )","+    }","+","+    /// The entry of `version`, and whether anyone may read it; `None` when","+    /// the caller may read nothing about it.","+    async fn entry(","+        &self,","+        state: &AppState,","+        identity: &Identity,","+        notes: &NotesTarget,","+        links: &mut BTreeMap<u64, PublicationNoteLink>,","+        version: &str,","+    ) -> Result<Option<(Value, bool)>, RegistryError> {","+        let note = if self.noted.contains(version) {","+            notes.database.version_note(&notes.name, &notes.target.org, version).await?","+        } else {","+            None","+        };","+        // A note added later and then deleted names nothing.","+        let note = note.filter(|note| note.text.is_some() || note.initial_digest.is_some());","+        let link = match self.published.get(version) {","+            Some(&id) => {","+                publication_link(state, identity, notes, links, id).await?.link","+            }","+            None => None,","+        };","+        if note.is_none() && link.is_none() {","+            return Ok(None);","+        }","+        let public_url = &state.inner.config.http.public_url;","+        Ok(Some(entry_json(version, note.as_ref(), link.as_ref(), public_url)))","+    }","+}","+","+/// The link to publication `id`'s note when the caller may read it, looked","+/// up once per publication.","+async fn publication_link(","+    state: &AppState,","+    identity: &Identity,","+    notes: &NotesTarget,","+    links: &mut BTreeMap<u64, PublicationNoteLink>,","+    id: u64,","+) -> Result<PublicationNoteLink, RegistryError> {","+    if let Some(link) = links.get(&id) {","+        return Ok(link.clone());","+    }","+    let link = match notes.database.publication(&notes.target.org, &id.to_string()).await? {","+        Some(publication) => {","+            readable_publication_note(state, identity, &notes.database, publication).await?","+        }","+        None => PublicationNoteLink { link: None, withheld: false },","+    };","+    links.insert(id, link.clone());","+    Ok(link)","+}","+","+/// The entries of the document, within its bounds.","+#[derive(Default)]","+struct Listing {","+    entries: Vec<Value>,","+    size: usize,","+    truncated: bool,","+    /// Whether every entry holds only what anyone may read.","+    public: bool,","+}","+","+impl Listing {","+    /// Add an entry, or report `false` once the document is full.","+    fn push(&mut self, entry: Value, public: bool) -> bool {","+        let size = entry.to_string().len();","+        if self.entries.len() == MAX_ENTRIES || self.size + size > MAX_BYTES {","+            self.truncated = true;","+            return false;","+        }","+        self.public &= public;","+        self.size += size;","+        self.entries.push(entry);","+        true","+    }","+","+    fn into_response(self) -> Response {","+        let mut body = json!({ \"notes\": self.entries });","+        if self.truncated {","+            body[\"truncated\"] = Value::Bool(true);","+        }","+        with_cache_rules(Json(body).into_response(), self.public)","+    }","+}","+","+/// A version's entry, and whether it holds only what anyone may read.","+fn entry_json(","+    version: &str,","+    note: Option<&Note>,","+    link: Option<&PublicationLink>,","+    public_url: &str,","+) -> (Value, bool) {","+    let mut entry = Map::new();","+    entry.insert(\"version\".to_string(), json!(version));","+    if let Some(note) = note {","+        entry.insert(\"modified\".to_string(), json!(note.modified));","+        if let Some(text) = &note.text {","+            entry.insert(\"text\".to_string(), json!(text));","+        }","+        if let Some(digest) = &note.initial_digest {","+            entry.insert(\"initialDigest\".to_string(), json!(digest));","+        }","+    }","+    if let Some(link) = link {","+        let org = if link.org.is_empty() { \"-\" } else { &link.org };","+        let reference = json!({","+            \"org\": org,","+            \"id\": link.id.to_string(),","+            \"name\": link.name,","+            \"initialDigest\": link.initial_digest,","+            \"url\": link.notes_path(public_url),","+        });","+        entry.insert(\"publication\".to_string(), reference);","+    }","+    (Value::Object(entry), link.is_none_or(|link| link.public))","+}","+","+/// Order parsed versions newest first: by semver, then any that are not","+/// semver.","+fn newest_first(","+    (left_semver, left): &(Option<node_semver::Version>, &String),","+    (right_semver, right): &(Option<node_semver::Version>, &String),","+) -> std::cmp::Ordering {","+    match (left_semver, right_semver) {","+        (Some(left), Some(right)) => right.cmp(left),","+        (Some(_), None) => std::cmp::Ordering::Less,","+        (None, Some(_)) => std::cmp::Ordering::Greater,","+        (None, None) => right.cmp(left),","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":272,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/notes/listing/tests.rs","lines":["@@ -0,0 +1,40 @@","+use super::{Candidates, MAX_CANDIDATES};","+use std::collections::{BTreeMap, BTreeSet};","+","+fn candidates(noted: &[&str], published: &[&str]) -> Candidates {","+    Candidates {","+        noted: noted","+            .iter()","+            .map(ToString::to_string)","+            .collect::<BTreeSet<_>>(),","+        published: published","+            .iter()","+            .map(|version| ((*version).to_string(), 1))","+            .collect::<BTreeMap<_, _>>(),","+    }","+}","+","+#[test]","+fn candidates_are_ordered_newest_first_with_non_semver_last() {","+    let candidates = candidates(&[\"1.0.0\", \"next\", \"10.0.0\"], &[\"2.0.0\", \"1.0.0\"]);","+    let (newest, more) = candidates.newest();","+    assert_eq!(newest, [\"10.0.0\", \"2.0.0\", \"1.0.0\", \"next\"]);","+    assert!(!more);","+}","+","+#[test]","+fn only_the_newest_candidates_are_kept() {","+    let versions: Vec<String> = (0..MAX_CANDIDATES + 50)","+        .map(|minor| format!(\"1.{minor}.0\"))","+        .collect();","+    let noted: Vec<&str> = versions","+        .iter()","+        .map(String::as_str)","+        .collect();","+    let candidates = candidates(&noted, &[]);","+    let (newest, more) = candidates.newest();","+    assert!(more);","+    assert_eq!(newest.len(), MAX_CANDIDATES);","+    assert_eq!(newest[0], &format!(\"1.{}.0\", MAX_CANDIDATES + 49));","+    assert_eq!(newest[MAX_CANDIDATES - 1], \"1.50.0\");","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/notes/responses.rs","lines":["@@ -0,0 +1,155 @@","+//! The responses of the note routes.","+","+use axum::{","+    body::{Body, Bytes},","+    http::{HeaderValue, StatusCode, header},","+    response::{IntoResponse, Response},","+};","+use pnpr_error::RegistryError;","+use pnpr_storage::metadata::{Note, note_digest};","+","+/// How long a shared cache may keep a public note response.","+pub(in super::super) const PUBLIC_NOTE_MAX_AGE: u64 = 300;","+","+/// What a note request does.","+pub(in crate::server) enum NoteRequest {","+    Read,","+    /// Replace the note with this text.","+    Write(String),","+    Delete,","+}","+","+/// The request a note route's method and body ask for.","+pub(in crate::server) fn read_note_body(","+    method: &axum::http::Method,","+    body: &Bytes,","+) -> Result<NoteRequest, Response> {","+    match *method {","+        axum::http::Method::GET | axum::http::Method::HEAD => Ok(NoteRequest::Read),","+        axum::http::Method::DELETE => Ok(NoteRequest::Delete),","+        axum::http::Method::PUT => String::from_utf8(body.to_vec())","+            .map(NoteRequest::Write)","+            .map_err(|_| {","+                RegistryError::BadRequest { reason: \"a note must be UTF-8\".to_string() }","+                    .into_response()","+            }),","+        _ => Err(StatusCode::METHOD_NOT_ALLOWED.into_response()),","+    }","+}","+","+/// The publication note a version note response links to.","+#[derive(Clone)]","+pub(in crate::server) struct PublicationLink {","+    pub(in crate::server) org: String,","+    pub(in crate::server) id: u64,","+    pub(in crate::server) name: Option<String>,","+    pub(in crate::server) initial_digest: Option<String>,","+    /// Whether every member of the publication is public.","+    pub(in crate::server) public: bool,","+}","+","+impl PublicationLink {","+    /// The absolute path of the publication's note on this server, under the","+    /// path prefix of `public_url`.","+    pub(in crate::server) fn notes_path(&self, public_url: &str) -> String {","+        let org = if self.org.is_empty() { \"-\" } else { &self.org };","+        format!(\"{}/-/publications/{org}/{}/notes\", path_prefix(public_url), self.id)","+    }","+}","+","+/// The path `public_url` serves pnpr under, without a trailing slash: empty","+/// at the root of its host.","+fn path_prefix(public_url: &str) -> String {","+    url::Url::parse(public_url)","+        .map(|url| {","+            url.path()","+                .trim_end_matches('/')","+                .to_string()","+        })","+        .unwrap_or_default()","+}","+","+/// `200` with the version's note, `204` when only its publication has one,","+/// `404` otherwise. A version published with a note keeps its initial digest","+/// header after the note is edited or deleted.","+pub(super) fn version_note_response(","+    note: Option<&Note>,","+    link: Option<&PublicationLink>,","+    public: bool,","+    public_url: &str,","+) -> Response {","+    let text = note.and_then(|note| note.text.as_deref());","+    let mut response = match (text, link) {","+        (Some(_), _) => note_text_response(note.expect(\"text implies a note\"), public),","+        (None, Some(_)) => StatusCode::NO_CONTENT.into_response(),","+        (None, None) => StatusCode::NOT_FOUND.into_response(),","+    };","+    let headers = response.headers_mut();","+    if let Some(digest) = note.and_then(|note| note.initial_digest.as_deref()) {","+        insert(headers, \"pnpr-note-initial-digest\", digest);","+    }","+    if let Some(link) = link {","+        insert_publication_link(headers, link, public_url);","+    }","+    with_cache_rules(response, public && link.is_none_or(|link| link.public))","+}","+","+fn insert_publication_link(","+    headers: &mut axum::http::HeaderMap,","+    link: &PublicationLink,","+    public_url: &str,","+) {","+    let target = format!(r#\"<{}>; rel=\"publication-notes\"\"#, link.notes_path(public_url));","+    insert(headers, header::LINK.as_str(), &target);","+    if let Some(name) = &link.name {","+        insert(headers, \"pnpr-publication-name\", name);","+    }","+    if let Some(digest) = &link.initial_digest {","+        insert(headers, \"pnpr-publication-initial-digest\", digest);","+    }","+}","+","+/// `200` with a note's text and its validators.","+pub(in crate::server) fn note_text_response(note: &Note, public: bool) -> Response {","+    let text = note.text.clone().unwrap_or_default();","+    let etag = format!(r#\"\"{}\"\"#, note_digest(&text));","+    let mut response = Response::builder()","+        .status(StatusCode::OK)","+        .header(header::CONTENT_TYPE, \"text/markdown; charset=utf-8\")","+        .header(header::ETAG, etag)","+        .body(Body::from(text))","+        .expect(\"static-shape response always builds\");","+    if let Some(modified) = http_date(&note.modified) {","+        insert(response.headers_mut(), header::LAST_MODIFIED.as_str(), &modified);","+    }","+    with_cache_rules(response, public)","+}","+","+/// A public response may be cached by anyone for a short while; any other","+/// depends on the caller's credentials.","+pub(in crate::server) fn with_cache_rules(mut response: Response, public: bool) -> Response {","+    if !public {","+        return crate::server::private_no_cache(response);","+    }","+    let value = format!(\"public, max-age={PUBLIC_NOTE_MAX_AGE}\");","+    insert(response.headers_mut(), header::CACHE_CONTROL.as_str(), &value);","+    response","+}","+","+fn http_date(iso: &str) -> Option<String> {","+    let parsed = chrono::DateTime::parse_from_rfc3339(iso).ok()?;","+    Some(","+        parsed","+            .with_timezone(&chrono::Utc)","+            .format(\"%a, %d %b %Y %H:%M:%S GMT\")","+            .to_string(),","+    )","+}","+","+fn insert(headers: &mut axum::http::HeaderMap, name: &str, value: &str) {","+    if let (Ok(name), Ok(value)) =","+        (axum::http::HeaderName::try_from(name), HeaderValue::from_str(value))","+    {","+        headers.insert(name, value);","+    }","+}"],"additions":155,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publications.rs","lines":["@@ -8,7 +8,10 @@"," //! when the metadata lives in `SQLite`."," "," use super::{","-    AppState, AuthedCaller, HostedGate, Identity, hosted_gate, not_found, private_no_cache,","+    Action, AppState, AuthedCaller, HostedGate, Identity, RegistrySource, authorize_package,","+    hosted_gate, not_found,","+    notes::{NoteRequest, note_text_response, read_note_body},","+    private_no_cache,"," };"," use axum::{","     Json,","@@ -18,9 +21,10 @@ use axum::{"," use pnpr_error::RegistryError;"," use pnpr_package_name::CanonicalPackageName;"," use pnpr_registry::{Ecosystem, Resolved};","-use pnpr_storage::metadata::{ArtifactMember, Publication};"],"additions":4,"deletions":2,"truncated":false}],"additions":701,"deletions":9,"truncated":true,"file_count":8},"error":null,"fe