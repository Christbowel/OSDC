Error } from '@azure/msal-common';","+import { strict as assert } from 'node:assert';","+import { DEFAULT_RETRY_POLICY } from './entra-id-credentials-provider-factory';","+","+describe('DEFAULT_RETRY_POLICY', () => {","+  it('retries a NetworkError', () => {","+    const error = new NetworkError(new AuthError('network_error'));","+    assert.equal(DEFAULT_RETRY_POLICY.isRetryable!(error, 1), true);","+  });","+","+  it('retries a NetworkError from another copy of msal-common', () => {","+    class OtherCopyNetworkError extends Error {","+      constructor() {","+        super('network_error');","+        this.name = 'NetworkError';","+      }","+    }","+    assert.equal(DEFAULT_RETRY_POLICY.isRetryable!(new OtherCopyNetworkError(), 1), true);","+  });","+","+  it('does not retry other errors', () => {","+    assert.equal(DEFAULT_RETRY_POLICY.isRetryable!(new AuthError('invalid_grant'), 1), false);","+    assert.equal(DEFAULT_RETRY_POLICY.isRetryable!(new Error('boom'), 1), false);","+    assert.equal(DEFAULT_RETRY_POLICY.isRetryable!({ name: 'NetworkError' }, 1), false);","+  });","+});"],"additions":26,"deletions":0,"truncated":false},{"path":"packages/entraid/lib/entra-id-credentials-provider-factory.ts","lines":["@@ -223,7 +223,7 @@ export class EntraIdCredentialsProviderFactory {","         const idp = new MSALIdentityProvider(","           async () => {","             if (!initialCredentialsAccount) {","-              let authResult = await authFlow.acquireTokenByCode(pkceParams);","+              const authResult = await authFlow.acquireTokenByCode(pkceParams);","               initialCredentialsAccount = authResult.account;","               return authResult;","             } else {","@@ -326,7 +326,10 @@ const loggerOptions = {","  */"," export const DEFAULT_RETRY_POLICY: RetryPolicy = {","   // currently only retry on network errors","-  isRetryable: (error: unknown) => error instanceof NetworkError,","+  // msal-node can load its own copy of msal-common, so `instanceof` alone can miss its errors","+  isRetryable: (error: unknown) =>","+    error instanceof NetworkError ||","+    (error instanceof Error && error.name === 'NetworkError'),","   maxAttempts: 10,","   initialDelayMs: 100,","   maxDelayMs: 100000,"],"additions":5,"deletions":2,"truncated":false},{"path":"packages/entraid/package.json","lines":["@@ -18,7 +18,7 @@","     \"release\": \"release-it\"","   },","   \"dependencies\": {","-    \"@azure/identity\": \"^4.13.1\",","+    \"@azure/core-auth\": \"^1.9.0\",","     \"@azure/msal-common\": \"^16.5.2\",","     \"@azure/msal-node\": \"^7.1.0\"","   },","@@ -26,6 +26,7 @@","     \"@redis/client\": \"^6.4.0-beta.0\"","   },","   \"devDependencies\": {","+    \"@azure/identity\": \"^4.14.1\",","     \"@types/express\": \"^4.17.21\",","     \"@types/express-session\": \"^1.18.0\",","     \"@types/node\": \"^22.9.0\",",""],"additions":2,"deletions":1,"truncated":false}],"additions":174,"deletions":27,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-03T16:47:28.290754+00:00"}