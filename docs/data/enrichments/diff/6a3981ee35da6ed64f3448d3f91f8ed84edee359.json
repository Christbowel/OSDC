T\"","-","-\t// DNSChain is the chain to redirect outbound DNS traffic to Consul DNS.","-\tDNSChain = \"CONSUL_DNS_REDIRECT\"","-","-\tDefaultTProxyOutboundPort = 15001","-)","-","-// Config is used to configure which traffic interception and redirection","-// rules should be applied with the iptables commands.","-type Config struct {","-\t// ConsulDNSIP is the IP for Consul DNS to direct DNS queries to.","-\tConsulDNSIP string","-","-\t// ConsulDNSPort is the port for Consul DNS to direct DNS queries to.","-\tConsulDNSPort int","-","-\t// ProxyUserID is the user ID of the proxy process.","-\tProxyUserID string","-","-\t// ProxyInboundPort is the port of the proxy's inbound listener.","-\tProxyInboundPort int","-","-\t// ProxyInboundPort is the port of the proxy's outbound listener.","-\tProxyOutboundPort int","-","-\t// ExcludeInboundPorts is the list of ports that should be excluded","-\t// from inbound traffic redirection.","-\tExcludeInboundPorts []string","-","-\t// ExcludeOutboundPorts is the list of ports that should be excluded","-\t// from outbound traffic redirection.","-\tExcludeOutboundPorts []string","-","-\t// ExcludeOutboundCIDRs is the list of IP CIDRs that should be excluded","-\t// from outbound traffic redirection.","-\tExcludeOutboundCIDRs []string","-","-\t// ExcludeUIDs is the list of additional user IDs to exclude","-\t// from traffic redirection.","-\tExcludeUIDs []string","-","-\t// NetNS is the network namespace where the traffic redirection rules","-\t// should be applied. This must be a path to the network namespace,","-\t// e.g. /var/run/netns/foo.","-\tNetNS string","-","-\t// IptablesProvider is the Provider that will apply iptables rules.","-\tIptablesProvider Provider","-}","-","-// AdditionalRulesFn can be implemented by the caller to","-// add environment specific rules (like ECS) that needs to","-// be executed for traffic redirection to work properly.","-//","-// This gets called by the Setup function after all the","-// first class iptable rules are added. The implemented","-// function should only call the `AddRule` and optionally","-// the `Rules` method of the provider.","-type AdditionalRulesFn func(iptablesProvider Provider)","-","-// Provider is an interface for executing iptables rules.","-type Provider interface {","-\t// AddRule adds a rule without executing it.","-\tAddRule(name string, args ...string)","-\t// ApplyRules executes rules that have been added via AddRule.","-\t// This operation is currently not atomic, and if there's an error applying rules,","-\t// you may be left in a state where partial rules were applied.","-\t// ApplyRules should not be called twice on the same instance in order to avoid","-\t// duplicate rule application.","-\tApplyRules(string) error","-\t// Rules returns the list of rules that have been added (including those not yet","-\t// applied).","-\tRules() []string","-","-\t// ClearAllRules clears all rules that are added","-\tClearAllRules()","-}","-","-func verifyDualStackConfig(cfg Config, dualStack bool) error {","-\tif dualStack {","-\t\tif cfg.ConsulDNSIP != \"\" {","-\t\t\tip := net.ParseIP(cfg.ConsulDNSIP)","-\t\t\tif ip == nil {","-\t\t\t\treturn fmt.Errorf(\"unable to parse consulDNSIP\")","-\t\t\t}","-\t\t\tif ip.To4() != nil {","-\t\t\t\treturn fmt.Errorf(\"for dual stack ipv6 consulDNSIP required\")","-\t\t\t}","-\t\t}","-\t} else {","-\t\tif cfg.ConsulDNSIP != \"\" {","-\t\t\tip := net.ParseIP(cfg.ConsulDNSIP)","-\t\t\tif ip == nil {","-\t\t\t\treturn fmt.Errorf(\"unable to parse consulDNSIP\")","-\t\t\t}","-\t\t\tif ip.To4() == nil {"],"additions":0,"deletions":120,"truncated":false}],"additions":188,"deletions":190,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-09-24T13:04:43.941687+00:00"}