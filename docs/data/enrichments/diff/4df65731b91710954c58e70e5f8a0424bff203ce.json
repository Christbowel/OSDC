is profile, from its open enforcement","+    actions and any identity check under review, by the first rule that applies:","+    `banned` while any open action is a `ban`; `pending` while a restriction that an","+    identity check can clear is open, the end user has submitted that check,","+    Anthropic's review of it has not ended, and no open action's `reason` is","+    `account_compromise`; `restricted` while any action is open; `unrestricted`","+    while none is. Absent under the `user-profiles-2026-09-04` and earlier beta","+    headers.","+    \"\"\"","+","     external_user_details: UserProfileExternalUserDetails","     \"\"\"","     Details about the entity this profile represents, as the platform states them;"],"additions":21,"deletions":1,"truncated":false},{"path":"src/anthropic/types/user_profile_enforcement_action.py","lines":["@@ -0,0 +1,12 @@","+from typing import Union","+from typing_extensions import Annotated, TypeAlias","+","+from .._models import UnionDiscriminator","+from .user_profile_enforcement_action_ban import UserProfileEnforcementActionBan","+from .user_profile_enforcement_action_restriction import UserProfileEnforcementActionRestriction","+","+__all__ = [\"UserProfileEnforcementAction\"]","+","+UserProfileEnforcementAction: TypeAlias = Annotated[","+    Union[UserProfileEnforcementActionRestriction, UserProfileEnforcementActionBan], UnionDiscriminator(\"type\")","+]"],"additions":12,"deletions":0,"truncated":false},{"path":"src/anthropic/types/user_profile_enforcement_action_ban.py","lines":["@@ -0,0 +1,35 @@","+from typing import Optional","+from datetime import datetime","+from typing_extensions import Literal","+","+from .._models import BaseModel","+from .user_profile_enforcement_action_reason import UserProfileEnforcementActionReason","+from .user_profile_enforcement_action_next_step import UserProfileEnforcementActionNextStep","+","+__all__ = [\"UserProfileEnforcementActionBan\"]","+","+","+class UserProfileEnforcementActionBan(BaseModel):","+    \"\"\"","+    Anthropic has stopped serving the end user where the ban applies and does not plan to serve them there again.","+    \"\"\"","+","+    id: str","+    \"\"\"The action's ID (`enac_...`), stable while the action is open.\"\"\"","+","+    action: Optional[UserProfileEnforcementActionNextStep] = None","+    \"\"\"Always `null`: the end user cannot clear a ban.\"\"\"","+","+    expires_at: Optional[datetime] = None","+    \"\"\"Always `null`: a ban has no end date.\"\"\"","+","+    opened_at: datetime","+    \"\"\"When Anthropic opened the action, in RFC 3339 format.\"\"\"","+","+    reason: UserProfileEnforcementActionReason","+    \"\"\"","+    Why Anthropic placed the limit: `unsupported_region`, `fraud_or_abuse`,","+    `high_harm`, `usage_policy_violation`, `account_compromise` or `unspecified`.","+    \"\"\"","+","+    type: Literal[\"ban\"]"],"additions":35,"deletions":0,"truncated":false},{"path":"src/anthropic/types/user_profile_enforcement_action_next_step.py","lines":["@@ -0,0 +1,5 @@","+from typing_extensions import Literal, TypeAlias","+","+__all__ = [\"UserProfileEnforcementActionNextStep\"]","+","+UserProfileEnforcementActionNextStep: TypeAlias = Literal[\"verify\"]"],"additions":5,"deletions":0,"truncated":false},{"path":"src/anthropic/types/user_profile_enforcement_action_reason.py","lines":["@@ -0,0 +1,7 @@","+from typing_extensions import Literal, TypeAlias","+","+__all__ = [\"UserProfileEnforcementActionReason\"]","+","+UserProfileEnforcementActionReason: TypeAlias = Literal[","+    \"unsupported_region\", \"fraud_or_abuse\", \"high_harm\", \"usage_policy_violation\", \"account_compromise\", \"unspecified\"","+]"],"additions":7,"deletions":0,"truncated":false},{"path":"src/anthropic/types/user_profile_enforcement_action_restriction.py","lines":["@@ -0,0 +1,45 @@","+from typing import Optional","+from datetime import datetime","+from typing_extensions import Literal","+","+from .._models import BaseModel","+from .user_p