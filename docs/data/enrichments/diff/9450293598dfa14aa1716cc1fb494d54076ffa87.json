{"id":"9450293598dfa14aa1716cc1fb494d54076ffa87","axis":"silent","repo":"facebook/folly","sha":"9450293598dfa14aa1716cc1fb494d54076ffa87","parsed":{"files":[{"path":"cmake/folly-config.h.cmake","lines":["@@ -65,6 +65,7 @@"," #cmakedefine01 FOLLY_HAVE_DWARF"," #cmakedefine01 FOLLY_HAVE_ELF"," #cmakedefine FOLLY_HAVE_SWAPCONTEXT 1","+#cmakedefine FOLLY_FIBERS_USE_BOOST_CONTEXT 1"," #cmakedefine FOLLY_HAVE_BACKTRACE 1"," #cmakedefine FOLLY_USE_SYMBOLIZER 1"," #define FOLLY_DEMANGLE_MAX_SYMBOL_SIZE 1024"],"additions":1,"deletions":0,"truncated":false},{"path":"cmake/folly-deps.cmake","lines":["@@ -56,7 +56,24 @@ set(Boost_USE_STATIC_LIBS \"${FOLLY_BOOST_LINK_STATIC}\")"," # Note: We find these components so the CMake targets exist, but we don't"," # link them globally. Targets that need specific Boost libraries should"," # add them to their EXTERNAL_DEPS (e.g., Boost::regex, Boost::context).","-set(FOLLY_BOOST_COMPONENTS context)","+set(FOLLY_BOOST_COMPONENTS \"\")","+","+# Fibers switch contexts with the assembly in folly/external/boost-fcontext","+# on x86_64 and arm64 outside Windows, and with Boost.Context elsewhere.","+set(FOLLY_FIBERS_USE_BOOST_CONTEXT OFF)","+set(folly_fcontext_archs ${CMAKE_SYSTEM_PROCESSOR})","+if (APPLE AND CMAKE_OSX_ARCHITECTURES)","+  set(folly_fcontext_archs ${CMAKE_OSX_ARCHITECTURES})","+endif ()","+foreach (arch IN LISTS folly_fcontext_archs)","+  if (NOT arch MATCHES \"^(x86_64|aarch64|arm64)$\")","+    set(FOLLY_FIBERS_USE_BOOST_CONTEXT ON)","+  endif ()","+endforeach ()","+if (WIN32 OR NOT folly_fcontext_archs OR FOLLY_FIBERS_USE_BOOST_CONTEXT)","+  set(FOLLY_FIBERS_USE_BOOST_CONTEXT ON)","+  list(APPEND FOLLY_BOOST_COMPONENTS context)","+endif ()"," "," # CMake 4 dropped FindBoost, so this config-only probe warns without QUIET."," # folly/cli's ProgramOptions is built only if Boost.ProgramOptions is found,"],"additions":18,"deletions":1,"truncated":false},{"path":"folly/external/CMakeLists.txt","lines":["@@ -14,6 +14,7 @@"," "," # @generated by folly/facebook/generate_cmake.py"," ","+add_subdirectory(boost-fcontext)"," add_subdirectory(farmhash)"," add_subdirectory(fast-crc32)"," add_subdirectory(nvidia)"],"additions":1,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/BUCK","lines":["@@ -0,0 +1,70 @@","+load(\"@fbsource//tools/build_defs/dirsync:fb_dirsync_cpp_library.bzl\", \"fb_dirsync_cpp_library\")","+","+oncall(\"fbcode_entropy_wardens_folly\")","+","+MACHO_SRCS = select({","+    \"DEFAULT\": [],","+    \"ovr_config//cpu:arm64\": [","+        \"jump_arm64_aapcs_macho_gas.S\",","+        \"make_arm64_aapcs_macho_gas.S\",","+    ],","+    \"ovr_config//cpu:x86_64\": [","+        \"jump_x86_64_sysv_macho_gas.S\",","+        \"make_x86_64_sysv_macho_gas.S\",","+    ],","+})","+","+ELF_ARM64_SRCS = [","+    \"jump_arm64_aapcs_elf_gas.S\",","+    \"make_arm64_aapcs_elf_gas.S\",","+]","+","+ELF_SRCS = {","+    \"ovr_config//cpu:arm32\": [","+        \"jump_arm_aapcs_elf_gas.S\",","+        \"make_arm_aapcs_elf_gas.S\",","+    ],","+    \"ovr_config//cpu:arm64\": ELF_ARM64_SRCS,","+    \"ovr_config//cpu:x86_32\": [","+        \"jump_i386_sysv_elf_gas.S\",","+        \"make_i386_sysv_elf_gas.S\",","+    ],","+    \"ovr_config//cpu:x86_64\": [","+        \"jump_x86_64_sysv_elf_gas.S\",","+        \"make_x86_64_sysv_elf_gas.S\",","+    ],","+}","+","+fb_dirsync_cpp_library(","+    name = \"fcontext\",","+    srcs = select({","+        \"DEFAULT\": select(dict(ELF_SRCS, DEFAULT = [])),","+        # Android configurations without a CPU constraint compile for arm64.","+        \"ovr_config//os:android\": select(dict(ELF_SRCS, DEFAULT = ELF_ARM64_SRCS)),","+        \"ovr_config//os:appletvos\": MACHO_SRCS,","+        \"ovr_config//os:iphoneos\": MACHO_SRCS,","+        \"ovr_config//os:macos\": MACHO_SRCS,","+        \"ovr_config//os:windows\": select({","+            \"DEFAULT\": [],","+            \"ovr_config//cpu:arm64\": [","+                \"jump_arm64_aapcs_pe_armasm.asm\",","+                \"make_arm64_aapcs_pe_armasm.asm\",","+            ],","+            \"ovr_config//cpu:x86_32\": [","+                \"jump_i386_ms_pe_masm.asm\",","+                \"make_i386_ms_pe_masm.asm\",","+            ],","+            \"ovr_config//cpu:x86_64\": [","+                \"jump_x86_64_ms_pe_masm.asm\",","+                \"make_x86_64_ms_pe_masm.asm\",","+            ],","+        }),","+    }),","+    headers = [\"fcontext.h\"],","+    compiler_flags = select({","+        \"DEFAULT\": [\"-Wno-unused-command-line-argument\"],","+        \"ovr_config//os:windows\": [],","+        \"ovr_config//os:windows-x86_32\": [\"/DBOOST_CONTEXT_EXPORT=\"],","+        \"ovr_config//os:windows-x86_64\": [\"/DBOOST_CONTEXT_EXPORT=\"],","+    }),","+)"],"additions":70,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/CMakeLists.txt","lines":["@@ -0,0 +1,41 @@","+# Copyright (c) Meta Platforms, Inc. and affiliates.","+#","+# Licensed under the Apache License, Version 2.0 (the \"License\");","+# you may not use this file except in compliance with the License.","+# You may obtain a copy of the License at","+#","+#     http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing, software","+# distributed under the License is distributed on an \"AS IS\" BASIS,","+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+# See the License for the specific language governing permissions and","+# limitations under the License.","+","+# NOTE: This file is manually maintained, not auto-generated.","+# Update this file when the corresponding BUCK file changes.","+","+if (FOLLY_FIBERS_USE_BOOST_CONTEXT)","+  folly_add_library(","+    NAME fcontext","+    HEADERS fcontext.h","+    EXTERNAL_DEPS Boost::context","+  )","+  return ()","+endif ()","+","+# On Apple platforms the wrappers pick the variant for each architecture in","+# CMAKE_OSX_ARCHITECTURES, which may differ from CMAKE_SYSTEM_PROCESSOR.","+if (APPLE)","+  set(abi macho_gas.S)","+elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL \"x86_64\")","+  set(abi x86_64_sysv_elf_gas.S)","+else ()","+  set(abi arm64_aapcs_elf_gas.S)","+endif ()","+","+folly_add_library(","+  NAME fcontext","+  SRCS make_${abi} jump_${abi}","+  HEADERS fcontext.h","+)"],"additions":41,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/LICENSE_1_0.txt","lines":["@@ -0,0 +1,23 @@","+Boost Software License - Version 1.0 - August 17th, 2003","+","+Permission is hereby granted, free of charge, to any person or organization","+obtaining a copy of the software and accompanying documentation covered by","+this license (the \"Software\") to use, reproduce, display, distribute,","+execute, and transmit the Software, and to prepare derivative works of the","+Software, and to permit third-parties to whom the Software is furnished to","+do so, all subject to the following:","+","+The copyright notices in the Software and this entire statement, including","+the above license grant, this restriction and the following disclaimer,","+must be included in all copies of the Software, in whole or in part, and","+all derivative works of the Software, unless such copies or derivative","+works are solely in the form of machine-executable object code generated by","+a source language processor.","+","+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR","+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,","+FITNESS FOR A PARTICULAR PURPOSE, TITLE AND NON-INFRINGEMENT. IN NO EVENT","+SHALL THE COPYRIGHT HOLDERS OR ANYONE DISTRIBUTING THE SOFTWARE BE LIABLE","+FOR ANY DAMAGES OR OTHER LIABILITY, WHETHER IN CONTRACT, TORT OR OTHERWISE,","+ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER","+DEALINGS IN THE SOFTWARE."],"additions":23,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/README.md","lines":["@@ -0,0 +1,20 @@","+# boost-fcontext","+","+The `make_fcontext` and `jump_fcontext` assembly from","+[Boost.Context](https://github.com/boostorg/context) 1.77.0, and a header","+declaring them, adapted from `boost/context/detail/fcontext.hpp`.","+","+The assembly matches Boost.Context 1.77.0 with two exceptions: the Windows arm64","+(armasm) files are backported from Boost.Context 1.80.0, which added them, and","+the arm64 ELF files add BTI landing pads (a `bti c` and the GNU BTI property","+note), functionally equivalent to those Boost.Context 1.90.0 later added.","+Otherwise, the only change to the assembly is that the functions are renamed to","+`folly_make_fcontext` and `folly_jump_fcontext`, so that they do not clash with","+Boost.Context in a program that links both. `update.sh` regenerates the","+assembly from a Boost source tree. `make_macho_gas.S` and `jump_macho_gas.S`","+include the Mach-O variant for the target architecture, so that CMake builds","+for any combination of arm64 and x86_64 in `CMAKE_OSX_ARCHITECTURES`, including","+universal binaries, and uses Boost.Context for other architectures.","+","+Distributed under the Boost Software License, Version 1.0 (see","+`LICENSE_1_0.txt`)."],"additions":20,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/fcontext.h","lines":["@@ -0,0 +1,30 @@","+//          Copyright Oliver Kowalke 2009.","+// Distributed under the Boost Software License, Version 1.0.","+//    (See accompanying file LICENSE_1_0.txt or copy at","+//          http://www.boost.org/LICENSE_1_0.txt)","+","+#pragma once","+","+#include <cstddef>","+","+#if defined(_MSC_VER) && defined(_M_IX86)","+#define FOLLY_FCONTEXT_CALLDECL __cdecl","+#else","+#define FOLLY_FCONTEXT_CALLDECL","+#endif","+","+namespace folly::detail::fcontext {","+","+using fcontext_t = void*;","+","+struct transfer_t {","+  fcontext_t fctx;","+  void* data;","+};","+","+extern \"C\" transfer_t FOLLY_FCONTEXT_CALLDECL","+folly_jump_fcontext(fcontext_t to, void* vp);","+extern \"C\" fcontext_t FOLLY_FCONTEXT_CALLDECL","+folly_make_fcontext(void* sp, std::size_t size, void (*fn)(transfer_t));","+","+} // namespace folly::detail::fcontext"],"additions":30,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_arm64_aapcs_elf_gas.S","lines":["@@ -0,0 +1,135 @@","+/*","+       Copyright Edward Nevill + Oliver Kowalke 2015","+   Distributed under the Boost Software License, Version 1.0.","+      (See accompanying file LICENSE_1_0.txt or copy at","+          http://www.boost.org/LICENSE_1_0.txt)","+*/","+/*******************************************************","+ *                                                     *","+ *  -------------------------------------------------  *","+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+ *  -------------------------------------------------  *","+ *  | 0x0 | 0x4 | 0x8 | 0xc | 0x10| 0x14| 0x18| 0x1c|  *","+ *  -------------------------------------------------  *","+ *  |    d8     |    d9     |    d10    |    d11    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *","+ *  -------------------------------------------------  *","+ *  | 0x20| 0x24| 0x28| 0x2c| 0x30| 0x34| 0x38| 0x3c|  *","+ *  -------------------------------------------------  *","+ *  |    d12    |    d13    |    d14    |    d15    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *","+ *  -------------------------------------------------  *","+ *  | 0x40| 0x44| 0x48| 0x4c| 0x50| 0x54| 0x58| 0x5c|  *","+ *  -------------------------------------------------  *","+ *  |    x19    |    x20    |    x21    |    x22    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  24 |  25 |  26 |  27 |  28 |  29 |  30 |  31 |  *","+ *  -------------------------------------------------  *","+ *  | 0x60| 0x64| 0x68| 0x6c| 0x70| 0x74| 0x78| 0x7c|  *","+ *  -------------------------------------------------  *","+ *  |    x23    |    x24    |    x25    |    x26    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  32 |  33 |  34 |  35 |  36 |  37 |  38 |  39 |  *","+ *  -------------------------------------------------  *","+ *  | 0x80| 0x84| 0x88| 0x8c| 0x90| 0x94| 0x98| 0x9c|  *","+ *  -------------------------------------------------  *","+ *  |    x27    |    x28    |    FP     |     LR    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  40 |  41 |  42 | 43  |           |           |  *","+ *  -------------------------------------------------  *","+ *  | 0xa0| 0xa4| 0xa8| 0xac|           |           |  *","+ *  -------------------------------------------------  *","+ *  |     PC    |   align   |           |           |  *","+ *  -------------------------------------------------  *","+ *                                                     *","+ *******************************************************/","+","+.file \"jump_arm64_aapcs_elf_gas.S\"","+","+#if defined(__ARM_FEATURE_BTI_DEFAULT) && (__ARM_FEATURE_BTI_DEFAULT == 1)","+// jump_fcontext starts with a BTI landing pad, so advertise BTI for the object","+// when branch-target enforcement is requested. Context switches resume","+// through `ret`, which BTI does not check.","+.pushsection .note.gnu.property, \"a\", %note","+.balign 8","+.long 4","+.long 0x10","+.long 0x5","+.asciz \"GNU\"","+.long 0xc0000000 // GNU_PROPERTY_AARCH64_FEATURE_1_AND","+.long 4","+.long 1 // GNU_PROPERTY_AARCH64_FEATURE_1_BTI","+.long 0","+.popsection","+#endif","+","+.text","+.align  2","+.global folly_jump_fcontext","+.type   folly_jump_fcontext, %function","+folly_jump_fcontext:","+#if defined(__ARM_FEATURE_BTI_DEFAULT) && (__ARM_FEATURE_BTI_DEFAULT == 1)","+    hint #34 // bti c","+#endif","+    # prepare stack for GP + FPU","+    sub  sp, sp, #0xb0","+","+    # save d8 - d15","+    stp  d8,  d9,  [sp, #0x00]","+    stp  d10, d11, [sp, #0x10]","+    stp  d12, d13, [sp, #0x20]","+    stp  d14, d15, [sp, #0x30]","+","+    # save x19-x30","+    stp  x19, x20, [sp, #0x40]","+    stp  x21, x22, [sp, #0x50]","+    stp  x23, x24, [sp, #0x60]","+    stp  x25, x26, [sp, #0x70]","+    stp  x27, x28, [sp, #0x80]","+    stp  x29, x30, [sp, #0x90]","+","+    # save LR as PC","+    str  x30, [sp, #0xa0]","+","+    # store RSP (pointing to context-data) in X0","+    mov  x4, sp","+","+    # restore RSP (pointing to context-data) from X1","+    mov  sp, x0","+","+    # load d8 - d15","+    ldp  d8,  d9,  [sp, #0x00]","+    ldp  d10, d11, [sp, #0x10]","+    ldp  d12, d13, [sp, #0x20]","+    ldp  d14, d15, [sp, #0x30]","+","+    # load x19-x30","+    ldp  x19, x20, [sp, #0x40]","+    ldp  x21, x22, [sp, #0x50]","+    ldp  x23, x24, [sp, #0x60]","+    ldp  x25, x26, [sp, #0x70]","+    ldp  x27, x28, [sp, #0x80]","+    ldp  x29, x30, [sp, #0x90]","+","+    # return transfer_t from jump","+    # pass transfer_t as first arg in context function","+    # X0 == FCTX, X1 == DATA","+    mov x0, x4","+","+    # load pc","+    ldr  x4, [sp, #0xa0]","+","+    # restore stack from GP + FPU","+    add  sp, sp, #0xb0","+","+    ret x4","+.size   folly_jump_fcontext,.-folly_jump_fcontext","+# Mark that we don't need executable stack.","+.section .note.GNU-stack,\"\",%progbits"],"additions":135,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_arm64_aapcs_macho_gas.S","lines":["@@ -0,0 +1,109 @@","+/*","+         Copyright Edward Nevill + Oliver Kowalke 2015","+   Distributed under the Boost Software License, Version 1.0.","+      (See accompanying file LICENSE_1_0.txt or copy at","+          http://www.boost.org/LICENSE_1_0.txt)","+*/","+/*******************************************************","+ *                                                     *","+ *  -------------------------------------------------  *","+ *  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+ *  -------------------------------------------------  *","+ *  | 0x0 | 0x4 | 0x8 | 0xc | 0x10| 0x14| 0x18| 0x1c|  *","+ *  -------------------------------------------------  *","+ *  |    d8     |    d9     |    d10    |    d11    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *","+ *  -------------------------------------------------  *","+ *  | 0x20| 0x24| 0x28| 0x2c| 0x30| 0x34| 0x38| 0x3c|  *","+ *  -------------------------------------------------  *","+ *  |    d12    |    d13    |    d14    |    d15    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *","+ *  -------------------------------------------------  *","+ *  | 0x40| 0x44| 0x48| 0x4c| 0x50| 0x54| 0x58| 0x5c|  *","+ *  -------------------------------------------------  *","+ *  |    x19    |    x20    |    x21    |    x22    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  24 |  25 |  26 |  27 |  28 |  29 |  30 |  31 |  *","+ *  -------------------------------------------------  *","+ *  | 0x60| 0x64| 0x68| 0x6c| 0x70| 0x74| 0x78| 0x7c|  *","+ *  -------------------------------------------------  *","+ *  |    x23    |    x24    |    x25    |    x26    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  32 |  33 |  34 |  35 |  36 |  37 |  38 |  39 |  *","+ *  -------------------------------------------------  *","+ *  | 0x80| 0x84| 0x88| 0x8c| 0x90| 0x94| 0x98| 0x9c|  *","+ *  -------------------------------------------------  *","+ *  |    x27    |    x28    |    FP     |     LR    |  *","+ *  -------------------------------------------------  *","+ *  -------------------------------------------------  *","+ *  |  40 |  41 |  42 | 43  |           |           |  *","+ *  -------------------------------------------------  *","+ *  | 0xa0| 0xa4| 0xa8| 0xac|           |           |  *","+ *  -------------------------------------------------  *","+ *  |     PC    |   align   |           |           |  *","+ *  -------------------------------------------------  *","+ *                                                     *","+ *******************************************************/","+","+.text","+.globl _folly_jump_fcontext","+.balign 16","+_folly_jump_fcontext:","+    ; prepare stack for GP + FPU","+    sub  sp, sp, #0xb0","+","+    ; save d8 - d15","+    stp  d8,  d9,  [sp, #0x00]","+    stp  d10, d11, [sp, #0x10]","+    stp  d12, d13, [sp, #0x20]","+    stp  d14, d15, [sp, #0x30]","+","+    ; save x19-x30","+    stp  x19, x20, [sp, #0x40]","+    stp  x21, x22, [sp, #0x50]","+    stp  x23, x24, [sp, #0x60]","+    stp  x25, x26, [sp, #0x70]","+    stp  x27, x28, [sp, #0x80]","+    stp  fp,  lr,  [sp, #0x90]","+","+    ; save LR as PC","+    str  lr, [sp, #0xa0]","+","+    ; store RSP (pointing to context-data) in X0","+    mov  x4, sp","+","+    ; restore RSP (pointing to context-data) from X1","+    mov  sp, x0","+","+    ; load d8 - d15","+    ldp  d8,  d9,  [sp, #0x00]","+    ldp  d10, d11, [sp, #0x10]","+    ldp  d12, d13, [sp, #0x20]","+    ldp  d14, d15, [sp, #0x30]","+","+    ; load x19-x30","+    ldp  x19, x20, [sp, #0x40]","+    ldp  x21, x22, [sp, #0x50]","+    ldp  x23, x24, [sp, #0x60]","+    ldp  x25, x26, [sp, #0x70]","+    ldp  x27, x28, [sp, #0x80]","+    ldp  fp,  lr,  [sp, #0x90]","+","+    ; return transfer_t from jump","+    ; pass transfer_t as first arg in context function","+    ; X0 == FCTX, X1 == DATA","+    mov x0, x4","+","+    ; load pc","+    ldr  x4, [sp, #0xa0]","+","+    ; restore stack from GP + FPU","+    add  sp, sp, #0xb0","+","+    ret x4"],"additions":109,"deletions":0,"truncated":false},{"path":"folly/external/boost-fcontext/jump_arm64_aapcs_pe_armasm.asm","lines":["@@ -0,0 +1,133 @@","+;      Copyright Edward Nevill + Oliver Kowalke 2015","+;  Distributed under the Boost Software License, Version 1.0.","+;     (See accompanying file LICENSE_1_0.txt or copy at","+;         http://www.boost.org/LICENSE_1_0.txt)","+","+;*******************************************************","+;*                                                     *","+;*  -------------------------------------------------  *","+;*  |  0  |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  *","+;*  -------------------------------------------------  *","+;*  | 0x0 | 0x4 | 0x8 | 0xc | 0x10| 0x14| 0x18| 0x1c|  *","+;*  -------------------------------------------------  *","+;*  |    d8     |    d9     |    d10    |    d11    |  *","+;*  -------------------------------------------------  *","+;*  -------------------------------------------------  *","+;*  |  8  |  9  |  10 |  11 |  12 |  13 |  14 |  15 |  *","+;*  -------------------------------------------------  *","+;*  | 0x20| 0x24| 0x28| 0x2c| 0x30| 0x34| 0x38| 0x3c|  *","+;*  -------------------------------------------------  *","+;*  |    d12    |    d13    |    d14    |    d15    |  *","+;*  -------------------------------------------------  *","+;*  -------------------------------------------------  *","+;*  |  16 |  17 |  18 |  19 |  20 |  21 |  22 |  23 |  *","+;*  -------------------------------------------------  *","+;*  | 0x40| 0x44| 0x48| 0x4c| 0x50| 0x54| 0x58| 0x5c|  *","+;*  -------------------------------------------------  *","+;*  |    x19    |    x20    |    x21    |    x22    |  *","+;*  -------------------------------------------------  *","+;*  -------------------------------------------------  *","+;*  |  24 |  25 |  26 |  27 |  28 |  29 |  30 |  31 |  *","+;*  -------------------------------------------------  *","+;*  | 0x60| 0x64| 0x68| 0x6c| 0x70| 0x74| 0x78| 0x7c|  *","+;*  -------------------------------------------------  *","+;*  |    x23    |    x24    |    x25    |    x26    |  *","+;*  -------------------------------------------------  *","+;*  -------------------------------------------------  *","+;*  |  32 |  33 |  34 |  35 |  36 |  37 |  38 |  39 |  *","+;*  -------------------------------------------------  *","+;*  | 0x80| 0x84| 0x88| 0x8c| 0x90| 0x94| 0x98| 0x9c|  *","+;*  -------------------------------------------------  *","+;*  |    x27    |    x28    |    FP     |     LR    |  *","+;*  -------------------------------------------------  *","+;*  -------------------------------------------------  *","+;*  |  40 |  41 |  42 |  43 |  44 |  45 |  46 |  47 |  *","+;*  -------------------------------------------------  *","+;*  | 0xa0| 0xa4| 0xa8| 0xac| 0xb0| 0xb4| 0xb8| 0xbc|  *","+;*  -------------------------------------------------  *","+;*  | fiber data|   base    |   limit   |  dealloc  |  *","+;*  -------------------------------------------------  *","+;*  -------------------------------------------------  *","+;*  |  48 |  49 |  50 | 51  |           |           |  *","+;*  -------------------------------------------------  *","+;*  | 0xc0| 0xc4| 0xc8| 0xcc|           |           |  *","+;*  -------------------------------------------------  *","+;*  |     PC    |   align   |           |           |  *","+;*  -------------------------------------------------  *","+;*                                                     *","+;*******************************************************","+","+    AREA |.text|, CODE, READONLY, ALIGN=4, CODEALIGN","+    EXPORT folly_jump_fcontext","+","+folly_jump_fcontext proc","+    ; prepare stack for GP + FPU","+    sub  sp, sp, #0xd0","+","+    ; save d8 - d15","+    stp  