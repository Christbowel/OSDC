{"id":"1795d7f5913fe6dc803281ef8217fb45e7b62455","axis":"silent","repo":"pnpm/pnpm","sha":"1795d7f5913fe6dc803281ef8217fb45e7b62455","parsed":{"files":[{"path":".changeset/pnpr-staged-archives.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+pnpr accepts release archives uploaded by integrity before the publish that references them, through `PUT /-/pnpr/v0/artifacts/blob?integrity=<sha512-…>` without an owner [#17608](https://github.com/pnpm/pnpm/pull/17608)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server.rs","lines":["@@ -137,6 +137,7 @@ mod security_audit;"," mod singleflight;"," use singleflight::Singleflight;"," mod staged;","+mod staged_archives;"," mod striped_locks;"," mod team_access;"," mod team_mutations;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/lifecycle.rs","lines":["@@ -62,6 +62,31 @@ async fn sweep_abandoned_uploads(config: &Config) -> pnpr_error::Result<()> {","     Ok(())"," }"," ","+/// Remove release archives staged for a publish that never claimed them","+/// before they expired, now and then every hour while the server runs.","+async fn sweep_expired_staged_archives(config: &Config) -> pnpr_error::Result<()> {","+    let storage = Storage::from_config(&config.storage)?;","+    report_staged_archive_sweep(storage.sweep_staged_archives().await?);","+    tokio::spawn(async move {","+        let mut interval = tokio::time::interval(std::time::Duration::from_hours(1));","+        interval.tick().await;","+        loop {","+            interval.tick().await;","+            match storage.sweep_staged_archives().await {","+                Ok(swept) => report_staged_archive_sweep(swept),","+                Err(err) => tracing::warn!(error = %err, \"sweeping staged release archives failed\"),","+            }","+        }","+    });","+    Ok(())","+}","+","+fn report_staged_archive_sweep(swept: usize) {","+    if swept > 0 {","+        tracing::info!(swept, \"reclaimed expired staged release archives\");","+    }","+}","+"," /// Run startup side effects and load the auth backends. The registry"," /// needs publish-journal recovery; auth loads on every tier because the"," /// account endpoints (which mint and manage tokens) are always served,","@@ -70,6 +95,7 @@ async fn load_startup_auth(config: &Config) -> pnpr_error::Result<AuthState> {","     if config.features.registry.enabled {","         recover_publish_journal(config).await?;","         sweep_abandoned_uploads(config).await?;","+        sweep_expired_staged_archives(config).await?;","         crate::cache_maintenance::prune_orphaned_namespaces_startup(config).await?;","     }","     AuthState::load(&config.identity.auth, &config.identity.backend).await"],"additions":26,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing.rs","lines":["@@ -17,7 +17,7 @@ mod account_handlers;"," use account_handlers::account_routes;"," "," mod protocol_routes;","-use protocol_routes::{artifacts_routes, pipeline_routes, resolver_routes};","+use protocol_routes::{artifacts_routes, pipeline_routes, resolver_routes, staged_archive_routes};"," "," mod team_handlers;"," use team_handlers::team_routes;","@@ -254,6 +254,8 @@ fn surface_routes(","     }","     if surfaces.artifacts {","         router = artifacts_routes(state, router);","+    } else if surfaces.registry {","+        router = staged_archive_routes(router);","     }","     if surfaces.pipeline {","         router = pipeline_routes(state, router);","@@ -312,8 +314,11 @@ fn npm_registry_routes() -> Router<AppState> {","     // Batch publish: one request carrying many packages' publish documents.","     // Mounted at both the server root (`registry_routes`) and the path-less npm","     // base (`/npm/-/pnpr/v0/publish`) so `pnpm publish --batch` can resolve it","-    // relative to the configured npm registry URL.","-    let mut router = Router::new().route(\"/-/pnpr/v0/publish\", put(batch::serve_ecosystem_publish));","+    // relative to the configured npm registry URL. The archives a batch","+    // references are staged beside it, under the same base.","+    let mut router = staged_archive_routes(","+        Router::new().route(\"/-/pnpr/v0/publish\", put(batch::serve_ecosystem_publish)),","+    );","     for base in [\"\", \"/~{registry}\"] {","         let path = |tail: &str| format!(\"{base}{tail}\");","         let with_teams = team_routes(staged_routes(ping_route(router, base), base), base);"],"additions":8,"deletions":3,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing/protocol_routes.rs","lines":["@@ -9,9 +9,9 @@ use crate::server::{","     AppState, MAX_ARTIFACT_BLOB_BODY_BYTES, MAX_ARTIFACT_PUBLISH_BODY_BYTES,","     MAX_ARTIFACT_RESOLVE_BODY_BYTES, MAX_PIPELINE_RUN_BODY_BYTES, compiler_cache,","     require_artifact_caller, require_pipeline_caller, require_resolver_caller, serve_artifact_blob,","-    serve_artifact_blob_size, serve_get_pipeline_run, serve_list_pipeline_runs, serve_pipeline_ui,","-    serve_publish_artifact, serve_publish_pipeline_run, serve_resolve, serve_resolve_artifacts,","-    serve_upload_artifact_blob, serve_verify_lockfile,","+    serve_get_pipeline_run, serve_list_pipeline_runs, serve_pipeline_ui, serve_publish_artifact,","+    serve_publish_pipeline_run, serve_resolve, serve_resolve_artifacts, serve_verify_lockfile,","+    staged_archives::{serve_head_blob, serve_put_blob},"," };"," "," pub(super) fn resolver_routes(state: &AppState, router: Router<AppState>) -> Router<AppState> {","@@ -54,18 +54,19 @@ pub(super) fn artifacts_routes(state: &AppState, router: Router<AppState>) -> Ro","                     require_artifact_caller,","                 )),","         )","-        // The limit bounds the lookup a `POST` sends. A `PUT` streams its","-        // body past it, and the store holds that to the declared size.","+        // The limit bounds the lookup a `POST` sends, and the layers apply to","+        // it alone. A `PUT` streams its body past the limit, and the store","+        // holds that to the declared size. A `PUT` or `HEAD` naming no owner","+        // stages a release archive instead, which the registry surface","+        // serves with the registry's own credentials; both handlers identify","+        // their caller themselves.","         .route(","             \"/-/pnpr/v0/artifacts/blob\",","             post(serve_artifact_blob)","-                .put(serve_upload_artifact_blob)","-                .head(serve_artifact_blob_size)","                 .route_layer(DefaultBodyLimit::max(MAX_ARTIFACT_BLOB_BODY_BYTES))","-                .route_layer(middleware::from_fn_with_state(","-                    state.clone(),","-                    require_artifact_caller,","-                )),","+                .route_layer(middleware::from_fn_with_state(state.clone(), require_artifact_caller))","+                .put(serve_put_blob)","+                .head(serve_head_blob),","         )"," }"," ","@@ -112,3 +113,9 @@ fn compiler_cache_routes(state: &AppState, router: Router<AppState>) -> Router<A","                 )),","         )"," }","+","+/// Release archive staging on a server without the artifact surface, which","+/// otherwise serves the route (see [`artifacts_routes`]).","+pub(super) fn staged_archive_routes(router: Router<AppState>) -> Router<AppState> {","+    router.route(\"/-/pnpr/v0/artifacts/blob\", put(serve_put_blob).head(serve_head_blob))","+}"],"additions":18,"deletions":11,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/staged_archives.rs","lines":["@@ -0,0 +1,384 @@","+//! `PUT` and `HEAD /-/pnpr/v0/artifacts/blob?integrity=<sha512-...>` with no","+//! owner: stage a release archive by integrity ahead of the publish commit","+//! that references it","+//! ([atomic workspace publication](https://github.com/pnpm/rfcs/blob/92d2b281af321ecf8f1e5fea63f698716ba4e9e7/pnpr/text/0000-atomic-workspace-publication.md)).","+//!","+//! The same route with an `organization` owner stores a shared build","+//! artifact's blob instead (see [`super::pnpr_protocol`]); [`serve_put_blob`]","+//! and [`serve_head_blob`] choose between the two by whether the query names","+//! an owner.","+//!","+//! A staged archive belongs to the principal that uploaded it, and only a","+//! commit by that principal can claim it. Nothing is published by staging:","+//! the commit authorizes every package it publishes as an inline publish","+//! would, and copies the archive into its package before it commits.","+","+use super::{","+    AppState, AuthedCaller, Body, Identity, MAX_TARBALL_BYTES, Response, State, StatusCode, header,","+    private_no_cache,","+};","+use axum::{","+    http::{HeaderMap, Uri},","+    response::IntoResponse,","+};","+use futures_util::StreamExt as _;","+use pnpm_shared_artifact_protocol::{blob_id, verify_blob_digest};","+use pnpr_error::RegistryError;","+use pnpr_storage::{StagedArchiveKey, Storage};","+use sha2::{Digest as _, Sha512};","+use std::{","+    collections::HashMap,","+    sync::{Arc, Mutex},","+};","+use tokio::sync::{OwnedSemaphorePermit, Semaphore};","+","+/// The most a principal may hold staged at once, across all its archives.","+/// Archives of a release wait here only until its commit, so this is many","+/// releases' worth.","+pub(super) const MAX_STAGED_BYTES_PER_PRINCIPAL: u64 = 2 * 1024 * 1024 * 1024;","+","+/// The most archives a principal may hold staged at once. Each upload of a","+/// new archive reads every record of its principal, so this bounds that","+/// work as well as the store.","+pub(super) const MAX_STAGED_ARCHIVES_PER_PRINCIPAL: usize = 256;","+","+/// Uploads received at once across the server. Each is buffered whole, up to","+/// one archive's limit, so this bounds their memory. Another upload waits","+/// for a permit rather than failing, so a publisher's parallel uploads queue.","+pub(super) const MAX_CONCURRENT_STAGED_UPLOADS: usize = 4;","+","+/// Uploads one principal may have received at once, of the server's","+/// [`MAX_CONCURRENT_STAGED_UPLOADS`].","+const MAX_CONCURRENT_STAGED_UPLOADS_PER_PRINCIPAL: usize = 2;","+","+/// A semaphore per principal with an upload in flight, bounding how many of","+/// the server's upload permits one principal holds. A principal's entry goes","+/// when its last upload does.","+#[derive(Default)]","+pub(super) struct PrincipalUploads(Mutex<HashMap<String, Arc<Semaphore>>>);","+","+impl PrincipalUploads {","+    /// Wait for one of `principal`'s upload permits.","+    async fn acquire(&self, principal: &str) -> PrincipalUpload<'_> {","+        let semaphore = Arc::clone(","+            self.0","+                .lock()","+                .expect(\"the principal upload map is never poisoned\")","+                .entry(principal.to_string())","+                .or_insert_with(|| {","+                    Arc::new(Semaphore::new(MAX_CONCURRENT_STAGED_UPLOADS_PER_PRINCIPAL))","+                }),","+        );","+        let permit = Arc::clone(&semaphore)","+            .acquire_owned()","+            .await","+            .expect(\"a principal's upload semaphore is never closed\");","+        PrincipalUpload { uploads: self, principal: principal.to_string(), permit: Some(permit) }","+    }","+}","+","+/// One principal's upload permit, which removes the principal's entry when","+/// it is the last one using it.","+struct PrincipalUpload<'a> {","+    uploads: &'a PrincipalUploads,","+    principal: String,","+    permit: Option<OwnedSemaphorePermit>,","+}","+","+impl Drop for PrincipalUpload<'_> {","+    fn drop(&mut self) {","+        drop(self.permit.take());","+        let mut uploads =","+            self.uploads.0.lock().expect(\"the principal upload map is never poisoned\");","+        // Only the map holds it: no upload is in flight or waiting.","+        if uploads","+            .get(&self.principal)","+            .is_some_and(|semaphore| Arc::strong_count(semaphore) == 1)","+        {","+            uploads.remove(&self.principal);","+        }","+    }","+}","+","+/// The slowest upload rate a staged archive is given time for.","+const MIN_UPLOAD_BYTES_PER_SECOND: u64 = 256 * 1024;","+","+/// The most an upload reserves before its bytes arrive.","+const INITIAL_BUFFER_BYTES: u64 = 1024 * 1024;","+","+/// `PUT /-/pnpr/v0/artifacts/blob`: a release archive without an owner, a","+/// shared artifact's blob with one.","+pub(super) async fn serve_put_blob(","+    state: State<AppState>,","+    caller: AuthedCaller,","+    uri: Uri,","+    headers: HeaderMap,","+    body: Body,","+) -> Response {","+    if names_owner(&uri) {","+        if let Err(response) = artifact_caller(&state, &headers).await {","+            return response;","+        }","+        return super::serve_upload_artifact_blob(state, caller, uri, headers, body).await;","+    }","+    if !state.inner.config.features.registry.enabled {","+        return private_no_cache(StatusCode::NOT_FOUND.into_response());","+    }","+    private_no_cache(","+        stage_archive(&state, &caller.0, &uri, &headers, body).await","+            .map_or_else(IntoResponse::into_response, |created| {","+                if created { StatusCode::CREATED } else { StatusCode::OK }.into_response()","+            }),","+    )","+}","+","+/// `HEAD /-/pnpr/v0/artifacts/blob`: whether a release archive is staged","+/// without an owner, whether a shared artifact's blob is stored with one.","+pub(super) async fn serve_head_blob(","+    state: State<AppState>,","+    caller: AuthedCaller,","+    uri: Uri,","+    headers: HeaderMap,","+) -> Response {","+    if names_owner(&uri) {","+        if let Err(response) = artifact_caller(&state, &headers).await {","+            return response;","+        }","+        return super::serve_artifact_blob_size(state, caller, uri).await;","+    }","+    if !state.inner.config.features.registry.enabled {","+        return private_no_cache(StatusCode::NOT_FOUND.into_response());","+    }","+    let result = async {","+        let principal = principal(&caller.0)?;","+        let digest = query_digest(&uri)?;","+        state.inner.storage.staged_archive_size(&StagedArchiveKey { principal, digest: &digest })","+            .await","+    }","+    .await;","+    private_no_cache(match result {","+        Ok(Some(size)) => ([(header::CONTENT_LENGTH, size.to_string())], ()).into_response(),","+        Ok(None) => StatusCode::NOT_FOUND.into_response(),","+        Err(err) => err.into_response(),","+    })","+}","+","+/// Admit a shared artifact's blob request as the artifact surface does for","+/// its other routes: only when the surface is served, and only for a caller","+/// its protocol credentials identify. The release archive routes skip this","+/// and accept the registry's credentials.","+async fn artifact_caller(state: &AppState, headers: &HeaderMap) -> Result<(), Response> {","+    if state.inner.builds.artifacts.is_none() {","+        return Err(private_no_cache(StatusCode::NOT_FOUND.into_response()));","+    }","+    match super::request_access::caller_username(state, headers).await {","+        Ok(Some(_)) => Ok(()),","+        Ok(None) => {","+            Err(RegistryError::Unauthenticated { resource: \"shared artifacts\".to_string() }","+                .into_response())","+        }","+        Err(error) => Err(error.into_response()),","+    }","+}","+","+/// Stage the archive streamed in `body` for the caller. `Ok(false)` when the","+/// caller had it staged already, which renews it.","+async fn stage_archive(","+    state: &AppState,","+    identity: &Identity,","+    uri: &Uri,","+    headers: &HeaderMap,","+    body: Body,","+) -> Result<bool, RegistryError> {","+    let principal = principal(identity)?;","+    let integrity = query_integrity(uri)?;","+    let digest = archive_digest(&integrity)?;","+    let size = declared_size(headers)?;","+    let storage = &state.inner.storage;","+    let key = StagedArchiveKey { principal, digest: &digest };","+    // The principal's own permit first, so its uploads queue behind each","+    // other rather than taking every permit of the server.","+    let _principal_upload = state.inner.locks","+        .staged_archive_uploads_by_principal","+        .acquire(principal)","+        .await;","+    let _upload = state.inner.locks.staged_archive_uploads","+        .acquire()","+        .await","+        .expect(\"the staged upload semaphore is never closed\");","+    // Uploading an archive staged already only renews it. Any other upload","+    // reserves its size first, so uploads running in parallel see each","+    // other's when they check the limits. The usage check counts only held","+    // archives, so a near-expiry archive being renewed and expired records","+    // do not block it.","+    let renewing = storage.staged_archive_size(&key).await?.is_some()","+        || !reserve_within_limits(storage, &key, size).await?;","+    let received =","+        tokio::time::timeout(receive_deadline(size), receive_archive(body, &integrity, size))","+            .await","+            .unwrap_or_else(|_| {","+                Err(bad_request(\"the archive upload was too slow to finish in time\".to_string()))","+            });","+    let staged = match received {","+        Ok(bytes) => storage.stage_archive(&key, bytes).await,","+        Err(err) => Err(err),","+    };","+    if staged.is_err() && !renewing {","+        storage.release_staged_archive(&key).await?;","+    }","+    staged","+}","+","+/// How long receiving an archive of `size` bytes may take while it holds an","+/// upload permit: a minute, plus the time to send it at","+/// [`MIN_UPLOAD_BYTES_PER_SECOND`]. A client that withholds its bytes would","+/// otherwise keep other publishers waiting for the permit.","+fn receive_deadline(size: u64) -> std::time::Duration {","+    std::time::Duration::from_secs(60 + size / MIN_UPLOAD_BYTES_PER_SECOND)","+}","+","+/// The `Content-Length` of a staged archive upload, within one archive's","+/// limit.","+fn declared_size(headers: &HeaderMap) -> Result<u64, RegistryError> {","+    let size = headers","+        .get(header::CONTENT_LENGTH)","+        .and_then(|length| {","+            length","+                .to_str()","+                .ok()?","+                .parse::<u64>()","+                .ok()","+        })","+        .ok_or_else(|| bad_request(\"a staged archive upload needs a Content-Length\".to_string()))?;","+    if size > MAX_TARBALL_BYTES {","+        return Err(bad_request(format!(","+            \"the archive is {size} bytes, over the {MAX_TARBALL_BYTES}-byte limit of one archive\",","+        )));","+    }","+    Ok(size)","+}","+","+/// Reserve `size` bytes for `key`'s archive, unless that takes its principal","+/// past its limits. `Ok(false)` when a concurrent upload of the same bytes","+/// staged the archive meanwhile, so this upload only renews it.","+async fn reserve_within_limits(","+    storage: &Storage,","+    key: &StagedArchiveKey<'_>,","+    size: u64,","+) -> Result<bool, RegistryError> {","+    // The listing alone bounds the records the check below reads. It counts","+    // expired records too, which the check does not, so it allows twice the","+    // limit; the archive's own record, renewed or reserved again, is no new","+    // one.","+    let listed = storage.staged_archive_count(key.principal).await?;","+    if listed >= 2 * MAX_STAGED_ARCHIVES_PER_PRINCIPAL {","+        return Err(over_limit(&format!(\"{MAX_STAGED_ARCHIVES_PER_PRINCIPAL} archives\")));","+    }","+    if !storage.reserve_staged_archive(key, size).await? {","+        return Ok(false);","+    }","+    let usage = storage.staged_archive_usage(key.principal).await?;","+    let refusal = if usage.bytes > MAX_STAGED_BYTES_PER_PRINCIPAL {","+        over_limit(&format!(\"{MAX_STAGED_BYTES_PER_PRINCIPAL} bytes\"))","+    } else if usage.archives > MAX_STAGED_ARCHIVES_PER_PRINCIPAL {","+        over_limit(&format!(\"{MAX_STAGED_ARCHIVES_PER_PRINCIPAL} archives\"))","+    } else {","+        return Ok(true);","+    };","+    storage.release_staged_archive(key).await?;","+    Err(refusal)","+}","+","+fn over_limit(limit: &str) -> RegistryError {","+    bad_request(format!(","+        \"staging this archive would hold more than {limit} that no publish has claimed yet; \\","+         publish or wait for staged archives to expire\",","+    ))","+}","+","+/// Read `body` whole, refusing it unless it is `size` bytes matching","+/// `integrity`.","+async fn receive_archive(body: Body, integrity: &str, size: u64) -> Result<Vec<u8>, RegistryError> {","+    let mut stream = body.into_data_stream();","+    // The declared size is the client's word, so the buffer grows with what","+    // arrives rather than reserving it up front.","+    let mut bytes =","+        Vec::with_capacity(usize::try_from(size.min(INITIAL_BUFFER_BYTES)).unwrap_or_default());","+    let mut hasher = Sha512::new();","+    while let Some(chunk) = stream.next().await {","+        let chunk =","+            chunk.map_err(|err| bad_request(format!(\"the archive upload was interrupted: {err}\")))?;","+        if (bytes.len() + chunk.len()) as u64 > size {","+            return Err(bad_request(format!(","+                \"the archive is larger than its declared {size} bytes\",","+            )));","+        }","+        hasher.update(&chunk);","+        // Past the first buffer the client is sending what it declared, so","+        // take the rest in one allocation rather than doubling into it.","+        if bytes.len() as u64 >= INITIAL_BUFFER_BYTES","+            && bytes.capacity() < bytes.len() + chunk.len()","+        {","+            bytes.reserve_exact(usize::try_from(size).unwrap_or_default() - bytes.len());","+        }","+        bytes.extend_from_slice(&chunk);","+    }","+    if bytes.len() as u64 != size {","+        return Err(bad_request(format!(","+            \"the archive has {} bytes but declares {size}\",","+            bytes.len(),","+        )));","+    }","+    verify_blob_digest(integrity, &hasher.finalize())","+        .map_err(|err| RegistryError::BadRequest { reason: format!(\"EINTEGRITY: {err}\") })?;","+    Ok(bytes)","+}","+","+/// The principal a staged archive belongs to: the caller's stable identity,","+/// the one an idempotent publish is scoped to.","+pub(super) fn principal(identity: &Identity) -> Result<&str, RegistryError> {","+    identity","+        .username()","+        .ok_or_else(|| RegistryError::Unauthenticated {","+            resource: \"release archive staging\".to_string(),","+        })","+}","+","+/// The hex SHA-512 digest a staged archive with `integrity` is stored under.","+pub(super) fn archive_digest(integrity: &str) -> Result<String, RegistryError> {","+    blob_id(integrity).map_err(|err| bad_request(err.to_string()))","+}","+","+/// Whether a blob request names a shared artifact's owner.","+fn names_owner(uri: &Uri) -> bool {","+    query_pairs(uri).any(|(key, _)| matches!(key.as_ref(), \"organization\" | \"publisher\"))","+}","+","+fn query_integrity(uri: &Uri) -> Result<String, RegistryError> {","+    let mut integrities = query_pairs(uri)","+        .filter(|(key, _)| key == \"integrity\")","+        .map(|(_, value)| value.into_owned());","+    match (integrities.next(), integrities.next()) {","+        (Some(integrity), None) => Ok(integrity),","+        _ => Err(bad_request(\"a staged archive request names one integrity\".to_string())),","+    }","+}","+","+fn query_digest(uri: &Uri) -> Result<String, RegistryError> {","+    archive_digest(&query_integrity(uri)?)","+}","+","+fn query_pairs(uri: &Uri) -> url::form_urlencoded::Parse<'_> {","+    url::form_urlencoded::parse(","+        uri.query()","+            .unwrap_or_default()","+            .as_bytes(),","+    )","+}","+","+fn bad_request(reason: String) -> RegistryError {","+    RegistryError::BadRequest { reason }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":384,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/staged_archives/tests.rs","lines":["@@ -0,0 +1,47 @@","+use super::{PrincipalUploads, archive_digest, names_owner, query_integrity};","+use axum::http::Uri;","+use std::time::Duration;","+","+#[test]","+fn only_an_owner_parameter_routes_a_blob_to_shared_artifacts() {","+    let uri = |query: &str| format!(\"/-/pnpr/v0/artifacts/blob?{query}\").parse::<Uri>().unwrap();","+    assert!(names_owner(&uri(\"organization=acme&integrity=sha512-AAAA\")));","+    assert!(names_owner(&uri(\"publisher=pkg&integrity=sha512-AAAA\")));","+    assert!(!names_owner(&uri(\"integrity=sha512-AAAA\")));","+}","+","+#[test]","+fn a_staged_archive_names_exactly_one_integrity() {","+    let uri = |query: &str| format!(\"/-/pnpr/v0/artifacts/blob?{query}\").parse::<Uri>().unwrap();","+    assert_eq!(query_integrity(&uri(\"integrity=sha512-AAAA\")).unwrap(), \"sha512-AAAA\");","+    assert!(query_integrity(&uri(\"\")).is_err());","+    assert!(query_integrity(&uri(\"integrity=sha512-AAAA&integrity=sha512-BBBB\")).is_err());","+}","+","+#[test]","+fn only_a_sha512_integrity_addresses_a_staged_archive() {","+    assert!(archive_digest(\"sha1-AAAA\").is_err());","+    let digest = archive_digest(&format!(\"sha512-{}==\", \"A\".repeat(86))).unwrap();","+    assert_eq!(digest.len(), 128);","+}","+","+#[tokio::test]","+async fn one_principal_holds_at_most_two_upload_permits() {","+    let uploads = PrincipalUploads::default();","+    let first = uploads.acquire(\"alice\").await;","+    let _second = uploads.acquire(\"alice\").await;","+    let _other = uploads.acquire(\"bob\").await;","+","+    let third = tokio::time::timeout(Duration::from_millis(50), uploads.acquire(\"alice\")).await;","+    assert!(third.is_err(), \"a third upload of one principal waits\");","+    drop(first);","+    let third = tokio::time::timeout(Duration::from_secs(5), uploads.acquire(\"alice\")).await;","+    assert!(third.is_ok(), \"it proceeds once a permit is free\");","+}","+","+#[tokio::test]","+async fn a_principal_without_uploads_leaves_no_entry() {","+    let uploads = PrincipalUploads::default();","+    drop(uploads.acquire(\"alice\").await);","+    assert!(uploads.0.lock().unwrap().is_empty());","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/state.rs","lines":["@@ -63,6 +63,12 @@ pub(super) struct MutationLocks {","     pub(super) packages: StripedLocks,","     pub(super) referrer_migrations: StripedLocks,","     pub(super) publish_concurrency: tokio::sync::Semaphore,","+    /// Release archives being received for staging, each buffered whole. See","+    /// [`super::staged_archives::MAX_CONCURRENT_STAGED_UPLOADS`].","+    pub(super) staged_archive_uploads: tokio::sync::Semaphore,","+    /// The same, per principal, so one account cannot hold every upload","+    /// permit. See [`super::staged_archives::PrincipalUploads`].","+    pub(super) staged_archive_uploads_by_principal: super::staged_archives::PrincipalUploads,"," }"," "," pub(super) struct IdentityServices {","@@ -95,6 +101,11 @@ impl AppInner {","                 packages: StripedLocks::new(),","                 referrer_migrations: StripedLocks::new(),","                 publish_concurrency: tokio::sync::Semaphore::new(16),","+                staged_archive_uploads: tokio::sync::Semaphore::new(","+                    super::staged_archives::MAX_CONCURRENT_STAGED_UPLOADS,","+                ),","+                staged_archive_uploads_by_principal:","+                    super::staged_archives::PrincipalUploads::default(),","             },","             identity,","             metrics: Arc::new(ServerMetrics::new()),"],"additions":11,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/staged_archives.rs","lines":["@@ -0,0 +1,184 @@","+//! Staging release archives by integrity ahead of the publish commit that","+//! references them: `PUT` and `HEAD /-/pnpr/v0/artifacts/blob?integrity=...`","+//! with no owner.","+","+use crate::npm::{npm_tgz, sri_sha512};","+","+use axum::{","+    Router,","+    body::{Body, to_bytes},","+    http::{Request, StatusCode, header},","+};","+use pnpr::{Config, MaxUsers, router};","+use pnpr_fixtures::MockConfigPresets;","+use serde_json::{Value, json};","+use std::{","+    net::{Ipv4Addr, SocketAddr, SocketAddrV4},","+    path::Path,","+};","+use tempfile::TempDir;","+use tower::ServiceExt;","+","+pub(crate) fn config(storage: &Path) -> Config {","+    let listen = SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST, 4873));","+    let mut config = Config::static_serve(listen, storage.to_path_buf());","+    config.http.public_url = \"http://example.test\".to_string();","+    config.identity.auth.htpasswd.max_users = MaxUsers::Unlimited;","+    config","+}","+","+pub(crate) struct Answer {","+    pub(crate) status: StatusCode,","+    pub(crate) length: Option<String>,","+    pub(crate) text: String,","+}","+","+/// Send one blob request. `body` is sent with its length declared.","+pub(crate) async fn blob(","+    app: &Router,","+    method: &str,","+    path: &str,","+    token: Option<&str>,","+    body: Option<&[u8]>,","+) -> Answer {","+    let mut request = Request::builder().method(method).uri(path);","+    if let Some(token) = token {","+        request = request.header(header::AUTHORIZATION, format!(\"Bearer {token}\"));","+    }","+    if let Some(body) = body {","+        request = request.header(header::CONTENT_LENGTH, body.len());","+    }","+    let body = body.map_or_else(Body::empty, |body| Body::from(body.to_vec()));","+    let response = app","+        .clone()","+        .oneshot(request.body(body).unwrap())","+        .await","+        .unwrap();","+    let status = response.status();","+    let length = response","+        .headers()","+        .get(header::CONTENT_LENGTH)","+        .map(|value| value.to_str().unwrap().to_string());","+    let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+    Answer { status, length, text: String::from_utf8_lossy(&bytes).into_owned() }","+}","+","+pub(crate) fn staging_path(integrity: &str) -> String {","+    let query = url::form_urlencoded::Serializer::new(String::new())","+        .append_pair(\"integrity\", integrity)","+        .finish();","+    format!(\"/-/pnpr/v0/artifacts/blob?{query}\")","+}","+","+pub(crate) async fn token_of(app: &Router, user: &str) -> String {","+    let body = json!({ \"name\": user, \"password\": \"secret\", \"type\": \"user\", \"roles\": [] });","+    let response = app","+        .clone()","+        .oneshot(","+            Request::put(format!(\"/-/user/org.couchdb.user:{user}\"))","+                .header(header::CONTENT_TYPE, \"application/json\")","+                .body(Body::from(body.to_string()))","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(response.status(), StatusCode::CREATED);","+    let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+    let body: Value = serde_json::from_slice(&bytes).unwrap();","+    body[\"token\"]","+        .as_str()","+        .unwrap()","+        .to_string()","+}","+","+#[tokio::test]","+async fn an_archive_is_staged_once_and_only_for_its_uploader() {","+    let tmp = TempDir::new().unwrap();","+    let app = router(config(tmp.path()));","+    let alice = token_of(&app, \"alice\").await;","+    let bob = token_of(&app, \"bob\").await;","+    let archive = npm_tgz(\"staged\", \"1.0.0\", b\"payload\");","+    let path = staging_path(&sri_sha512(&archive));","+","+    let missing = blob(&app, \"HEAD\", &path, Some(&alice), None).await;","+    assert_eq!(missing.status, StatusCode::NOT_FOUND);"],"additions":104,"deletions":0,"truncated":false}],"additions":604,"deletions":14,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-03T16:47:45.211565+00:00"}