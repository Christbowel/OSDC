ponent\\Security\\Http\\Tests\\EntryPoint;","+","+use PHPUnit\\Framework\\TestCase;","+use Symfony\\Component\\HttpFoundation\\Request;","+use Symfony\\Component\\Routing\\Generator\\UrlGeneratorInterface;","+use Symfony\\Component\\Security\\Core\\Exception\\AuthenticationException;","+use Symfony\\Component\\Security\\Http\\EntryPoint\\RedirectAuthenticationEntryPoint;","+use Symfony\\Component\\Security\\Http\\HttpUtils;","+","+class RedirectAuthenticationEntryPointTest extends TestCase","+{","+    public function testStartRedirectsToThePath()","+    {","+        $entryPoint = new RedirectAuthenticationEntryPoint(new HttpUtils(), '/login');","+","+        $response = $entryPoint->start(Request::create('https://example.com/admin'), new AuthenticationException());","+","+        $this->assertSame(302, $response->getStatusCode());","+        $this->assertSame('https://example.com/login', $response->getTargetUrl());","+    }","+","+    public function testStartRedirectsToTheAbsoluteUrl()","+    {","+        $entryPoint = new RedirectAuthenticationEntryPoint(new HttpUtils(null, null, '{^https?://%s$}i'), 'https://sso.example.com/login');","+","+        $response = $entryPoint->start(Request::create('https://example.com/admin'));","+","+        $this->assertSame('https://sso.example.com/login', $response->getTargetUrl());","+    }","+","+    public function testStartRedirectsToTheRoute()","+    {","+        $urlGenerator = $this->createMock(UrlGeneratorInterface::class);","+        $urlGenerator->expects($this->once())","+            ->method('generate')","+            ->with('app_login', [], UrlGeneratorInterface::ABSOLUTE_URL)","+            ->willReturn('https://example.com/login');","+","+        $entryPoint = new RedirectAuthenticationEntryPoint(new HttpUtils($urlGenerator), 'app_login');","+","+        $response = $entryPoint->start(Request::create('https://example.com/admin'));","+","+        $this->assertSame('https://example.com/login', $response->getTargetUrl());","+    }","+}"],"additions":56,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Security/Http/Tests/Firewall/ExceptionListenerTest.php","lines":["@@ -57,6 +57,7 @@"," use Symfony\\Component\\Security\\Http\\EntryPoint\\AuthenticationEntryPointInterface;"," use Symfony\\Component\\Security\\Http\\EntryPoint\\FallbackAuthenticationEntryPointInterface;"," use Symfony\\Component\\Security\\Http\\EntryPoint\\ReAuthenticationEntryPointInterface;","+use Symfony\\Component\\Security\\Http\\EntryPoint\\RedirectAuthenticationEntryPoint;"," use Symfony\\Component\\Security\\Http\\Firewall\\ExceptionListener;"," use Symfony\\Component\\Security\\Http\\HttpUtils;"," use Symfony\\Component\\Security\\Http\\SecurityRequestAttributes;","@@ -226,6 +227,17 @@ public function testTargetPathIsSavedForAnEntryPointThatStartsAnAuthentication()","         $this->assertSame('http://localhost/', $session->get('_security.key.target_path'));","     }"," ","+    public function testRedirectEntryPointSavesTheTargetPath()","+    {","+        $event = $this->createEvent(new AuthenticationException(), null, $session = new Session(new MockArraySessionStorage()));","+        $httpUtils = new HttpUtils();","+","+        $this->createExceptionListener(null, null, $httpUtils, new RedirectAuthenticationEntryPoint($httpUtils, '/login'))->onKernelException($event);","+","+        $this->assertSame('http://localhost/login', $event->getResponse()->getTargetUrl());","+        $this->assertSame('http://localhost/', $session->get('_security.key.target_path'));","+    }","+","     public function testNoTargetPathIsSavedForAnEntryPointThatOnlyStandsIn()","     {","         $entryPoint = $this->createMock(FallbackAuthenticationEntryPointInterface::class);",""],"additions":12,"deletions":0,"truncated":false}],"additions":194,"deletions":0,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-19T15:00:51.635607+00:00"}