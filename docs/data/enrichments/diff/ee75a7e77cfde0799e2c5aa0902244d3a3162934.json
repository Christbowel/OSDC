{"id":"ee75a7e77cfde0799e2c5aa0902244d3a3162934","axis":"silent","repo":"rails/rails","sha":"ee75a7e77cfde0799e2c5aa0902244d3a3162934","parsed":{"files":[{"path":"activerecord/CHANGELOG.md","lines":["@@ -1,3 +1,15 @@","+*   Add `enforced:` option to `add_check_constraint` for PostgreSQL 18+.","+","+    When `enforced: false` is passed, the constraint is created as `NOT ENFORCED`,","+    so PostgreSQL does not check it when rows are inserted or updated.","+","+    ```ruby","+    add_check_constraint :products, \"price > 0\", name: \"price_check\", enforced: false","+    # => ALTER TABLE \"products\" ADD CONSTRAINT price_check CHECK (price > 0) NOT ENFORCED","+    ```","+","+    *Juanito Fatas*","+"," *   Fix lazily loading a `disable_joins` association ignoring the rest of its","     scope, such as `select`, `limit`, `includes`, `readonly`, and","     `strict_loading`."],"additions":12,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/abstract/schema_definitions.rb","lines":["@@ -268,6 +268,10 @@ def validate?","       end","       alias validated? validate?"," ","+      def enforced?","+        options.fetch(:enforced, true)","+      end","+","       def export_name_on_schema_dump?","         !ActiveRecord::SchemaDumper.chk_ignore_pattern.match?(name) if name","       end"],"additions":4,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/abstract/schema_statements.rb","lines":["@@ -1409,6 +1409,14 @@ def check_constraints(table_name)","       #","       #   ALTER TABLE \"products\" ADD CONSTRAINT price_check CHECK (price > 0)","       #","+      # ====== Creating a not enforced check constraint (PostgreSQL 18+)","+      #","+      #   add_check_constraint :products, \"price > 0\", name: \"price_check\", enforced: false","+      #","+      # generates:","+      #","+      #   ALTER TABLE \"products\" ADD CONSTRAINT price_check CHECK (price > 0) NOT ENFORCED","+      #","       # The +options+ hash can include the following keys:","       # [<tt>:name</tt>]","       #   The constraint name. Defaults to <tt>chk_rails_<identifier></tt>.","@@ -1416,6 +1424,10 @@ def check_constraints(table_name)","       #   Silently ignore if the constraint already exists, rather than raise an error.","       # [<tt>:validate</tt>]","       #   (PostgreSQL only) Specify whether or not the constraint should be validated. Defaults to +true+.","+      # [<tt>:enforced</tt>]","+      #   (PostgreSQL 18+) Specify whether or not the constraint should be enforced. Defaults to +true+.","+      #   When set to +false+, the constraint is created as +NOT ENFORCED+, meaning it is not","+      #   checked when rows are inserted or updated.","       def add_check_constraint(table_name, expression, if_not_exists: false, **options)","         return unless supports_check_constraints?"," "],"additions":12,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/abstract_adapter.rb","lines":["@@ -139,6 +139,7 @@ def ractor_connection_capabilities # :nodoc:","           supports_ddl_transactions?: supports_ddl_transactions?,","           supports_deferrable_constraints?: supports_deferrable_constraints?,","           supports_disabling_indexes?: supports_disabling_indexes?,","+          supports_enforced_check_constraints?: supports_enforced_check_constraints?,","           supports_enforced_foreign_keys?: supports_enforced_foreign_keys?,","           supports_exclusion_constraints?: supports_exclusion_constraints?,","           supports_explain?: supports_explain?,","@@ -611,6 +612,11 @@ def supports_enforced_foreign_keys?","         false","       end"," ","+      # Does this adapter support NOT ENFORCED check constraints?","+      def supports_enforced_check_constraints?","+        false","+      end","+","       # Does this adapter support creating check constraints?","       def supports_check_constraints?","         false"],"additions":6,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql/schema_creation.rb","lines":["@@ -21,7 +21,10 @@ def visit_ForeignKeyDefinition(o)","           end"," ","           def visit_CheckConstraintDefinition(o)","-            super.dup.tap { |sql| sql << \" NOT VALID\" unless o.validate? }","+            super.dup.tap do |sql|","+              sql << \" NOT ENFORCED\" unless o.enforced?","+              sql << \" NOT VALID\" unless o.validate?","+            end","           end"," ","           def visit_ValidateConstraint(o)"],"additions":4,"deletions":1,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql/schema_statements.rb","lines":["@@ -661,6 +661,14 @@ def add_foreign_key(from_table, to_table, **options)","           super","         end"," ","+        def check_constraint_options(table_name, expression, options) # :nodoc:","+          if options.key?(:enforced) && !supports_enforced_check_constraints?","+            raise ArgumentError, \"NOT ENFORCED check constraints require PostgreSQL 18+ (got #{database_version})\"","+          end","+","+          super","+        end","+","         def foreign_keys(table_name)","           result = fetch_foreign_keys(Array(table_name).map(&:to_s))","           table_name.is_a?(Array) ? result : result[table_name.to_s]","@@ -1278,9 +1286,11 @@ def build_foreign_keys(table_name, fk_info)"," ","           def fetch_check_constraints(tables)","             fetch_by_schema(tables) do |schema, group|","+              conenforced_column = supports_enforced_check_constraints? ? \", c.conenforced AS enforced\" : \"\"","+","               rows = query_all(<<~SQL)","                 #{resolved_tables(schema, group)}","-                SELECT t.relname AS table_name, conname, pg_get_constraintdef(c.oid, true) AS constraintdef, c.convalidated AS valid","+                SELECT t.relname AS table_name, conname, pg_get_constraintdef(c.oid, true) AS constraintdef, c.convalidated AS valid#{conenforced_column}","                 FROM pg_constraint c","                 JOIN tables t ON c.conrelid = t.oid","                 WHERE c.contype = 'c'","@@ -1297,6 +1307,7 @@ def build_check_constraints(table_name, check_info)","                 name: row[\"conname\"],","                 validate: row[\"valid\"]","               }","+              options[:enforced] = row[\"enforced\"] if supports_enforced_check_constraints?","               expression = row[\"constraintdef\"][/CHECK \\((.+)\\)/m, 1]"," ","               CheckConstraintDefinition.new(table_name, expression, options)"],"additions":12,"deletions":1,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql_adapter.rb","lines":["@@ -296,6 +296,10 @@ def supports_enforced_foreign_keys?","         database_version >= 18_00_04","       end"," ","+      def supports_enforced_check_constraints?","+        database_version >= 18_00_00","+      end","+","       def supports_views?","         true","       end"],"additions":4,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/ractor_connection_handler/postgresql_proxy_adapter.rb","lines":["@@ -39,6 +39,10 @@ def supports_deferrable_constraints?","           pure_remote_dispatch(:supports_deferrable_constraints?)","         end"," ","+        def supports_enforced_check_constraints?","+          pure_remote_dispatch(:supports_enforced_check_constraints?)","+        end","+","         def supports_enforced_foreign_keys?","           pure_remote_dispatch(:supports_enforced_foreign_keys?)","         end"],"additions":4,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/schema_dumper.rb","lines":["@@ -365,6 +365,7 @@ def check_parts(check)","         check_parts = [ check.expression.inspect ]","         check_parts << \"name: #{check.name.inspect}\" if check.export_name_on_schema_dump?","         check_parts << \"validate: #{check.validate?.inspect}\" unless check.validate?","+        check_parts << \"enforced: #{check.enforced?.inspect}\" unless check.enforced?","         check_parts","       end"," "],"additions":1,"deletions":0,"truncated":false},{"path":"activerecord/test/cases/migration/check_constraint_test.rb","lines":["@@ -258,6 +258,109 @@ def test_add_invalid_check_constraint","           end","         end"," ","+        if ActiveRecord::Base.lease_connection.supports_enforced_check_constraints?","+          def test_enforced_check_constraint_default","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\"","+","+            assert_predicate @connection.check_constraints(\"trades\").first, :enforced?","+          end","+","+          def test_not_enforced_check_constraint","+            assert_queries_match(/CHECK \\(quantity > 0\\) NOT ENFORCED\\z/) do","+              @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+            end","+","+            check_constraints = @connection.check_constraints(\"trades\")","+            assert_equal 1, check_constraints.size","+","+            cc = check_constraints.first","+            assert_equal \"quantity > 0\", cc.expression","+            assert_not_predicate cc, :enforced?","+            assert_not_predicate cc, :validate?","+            assert @connection.check_constraint_exists?(:trades, name: \"quantity_check\", enforced: false)","+            assert_not @connection.check_constraint_exists?(:trades, name: \"quantity_check\", enforced: true)","+          end","+","+          def test_not_enforced_check_constraint_allows_invalid_values","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+","+            assert_nothing_raised do","+              Trade.create!(quantity: -1)","+            end","+          end","+","+          def test_not_enforced_check_constraint_with_validate_false","+            assert_queries_match(/CHECK \\(quantity > 0\\) NOT ENFORCED NOT VALID\\z/) do","+              @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false, validate: false","+            end","+","+            cc = @connection.check_constraints(\"trades\").first","+            assert_not_predicate cc, :enforced?","+            assert_not_predicate cc, :validate?","+          end","+","+          # PostgreSQL marks NOT ENFORCED constraints as NOT VALID internally, overriding `validate: true`.","+          def test_not_enforced_check_constraint_with_validate_true","+            assert_queries_match(/CHECK \\(quantity > 0\\) NOT ENFORCED\\z/) do","+              @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false, validate: true","+            end","+","+            cc = @connection.check_constraints(\"trades\").first","+            assert_not_predicate cc, :enforced?","+            assert_not_predicate cc, :validate?","+          end","+","+          def test_not_enforced_check_constraint_with_validate_true_and_if_not_exists","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false, validate: true","+","+            assert_nothing_raised do","+              @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false, validate: true, if_not_exists: true","+            end","+            assert_equal 1, @connection.check_constraints(\"trades\").size","+          end","+","+          def test_create_table_with_not_enforced_check_constraint","+            @connection.create_table :test_check_constraints, force: true do |t|","+              t.integer :quantity","+              t.check_constraint \"quantity > 0\", name: \"quantity_check\", enforced: false","+            end","+","+            cc = @connection.check_constraints(\"test_check_constraints\").first","+            assert_not_predicate cc, :enforced?","+          ensure","+            @connection.drop_table :test_check_constraints, if_exists: true","+          end","+","+          # PostgreSQL marks NOT ENFORCED constraints as NOT VALID, so they are dumped after the table.","+          def test_schema_dumping_with_enforced_false","+            @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+","+            output = dump_table_schema \"trades\"","+","+            assert_match %r{\\s+add_check_constraint \"trades\", \"quantity > 0\", name: \"quantity_check\", validate: false, enforced: false$}, output","+          end","+        end","+","+        if current_adapter?(:PostgreSQLAdapter)","+          def test_not_enforced_check_constraint_raises_when_unsupported","+            @connection.stub(:supports_enforced_check_constraints?, false) do","+              error = assert_raises(ArgumentError) do","+                @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\", enforced: false","+              end","+              assert_match(/NOT ENFORCED check constraints require PostgreSQL 18\\+/, error.message)","+","+              assert_raises(ArgumentError) do","+                @connection.create_table :test_check_constraints, force: true do |t|","+                  t.integer :quantity","+                  t.check_constraint \"quantity > 0\", enforced: false","+                end","+              end","+            end","+          ensure","+            @connection.drop_table :test_check_constraints, if_exists: true","+          end","+        end","+","         def test_check_constraint_exists","           @connection.add_check_constraint :trades, \"quantity > 0\", name: \"quantity_check\""," ",""],"additions":103,"deletions":0,"truncated":false}],"additions":162,"deletions":2,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-26T18:56:46.204208+00:00"}