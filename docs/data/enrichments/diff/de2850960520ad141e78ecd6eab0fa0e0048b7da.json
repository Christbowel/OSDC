{"id":"de2850960520ad141e78ecd6eab0fa0e0048b7da","axis":"silent","repo":"celery/celery","sha":"de2850960520ad141e78ecd6eab0fa0e0048b7da","parsed":{"files":[{"path":"celery/worker/consumer/consumer.py","lines":["@@ -218,6 +218,9 @@ def __init__(self, on_task_request,"," ","         self._does_info = logger.isEnabledFor(logging.INFO)","         self._limit_order = 0","+        #: ``(token, timer entry)`` of the pending timer of each rate limit","+        #: bucket that waits for tokens.","+        self._limit_timers = {}","         self.on_task_request = on_task_request","         self.on_task_message = set()","         self.amqheartbeat_rate = self.app.conf.broker_heartbeat_checkrate","@@ -362,15 +365,35 @@ def _schedule_bucket_request(self, bucket):","                 # requeue to head, keep the order.","                 bucket.contents.appendleft((request, tokens))"," ","-                pri = self._limit_order = (self._limit_order + 1) % 10","-                hold = bucket.expected_time(tokens)","-                self.timer.call_after(","-                    hold, self._schedule_bucket_request, (bucket,),","-                    priority=pri,","-                )","+                # One timer for each bucket is enough: when it fires, it","+                # moves the requests that have tokens and arms the next","+                # timer.  A timer for each request that arrives while the","+                # bucket waits would start a chain of timers that lives","+                # until the bucket is empty, so on a busy queue the number","+                # of timers would grow with the number of requests.","+                if bucket not in self._limit_timers:","+                    pri = self._limit_order = (self._limit_order + 1) % 10","+                    hold = bucket.expected_time(tokens)","+                    token = object()","+                    entry = self.timer.call_after(","+                        hold, self._on_bucket_wakeup, (bucket, token),","+                        priority=pri,","+                    )","+                    self._limit_timers[bucket] = (token, entry)","                 # no tokens, break","                 break"," ","+    def _on_bucket_wakeup(self, bucket, token):","+        armed = self._limit_timers.get(bucket)","+        if armed is None or armed[0] is not token:","+            # This timer is no longer the timer of the bucket: on_close()","+            # cancelled it, or a timer thread and the consumer both armed a","+            # timer at the same time.  The current timer moves the requests,","+            # so stop here, or two chains of timers would serve the bucket.","+            return","+        self._limit_timers.pop(bucket, None)","+        self._schedule_bucket_request(bucket)","+","     def _limit_task(self, request, bucket, tokens):","         bucket.add((request, tokens))","         return self._schedule_bucket_request(bucket)","@@ -587,6 +610,19 @@ def on_close(self):","         for bucket in self.task_buckets.values():","             if bucket:","                 bucket.clear_pending()","+        # The buckets are empty now, so their timers have nothing to do.","+        # Cancel them (asynloop only cancels the entries it registered for","+        # the connection, not these) and forget them, so that a bucket gets","+        # a timer again when a request waits for tokens on the next","+        # connection.","+        for _, entry in self._limit_timers.values():","+            if self.timer is not None:","+                try:","+                    self.timer.cancel(entry)","+                except Exception as exc:  # pylint: disable=broad-except","+                    logger.exception(","+                        'Error cancelling rate limit timer entry: %r', exc)","+        self._limit_timers.clear()","         for r in tuple(reserved_requests):","             if r not in active_requests:","                 requests.pop(r.id, None)"],"additions":42,"deletions":6,"truncated":false},{"path":"t/integration/tasks.py","lines":["@@ -50,6 +50,16 @@ def pending_operations_count(state, **kwargs):","     return len(state.consumer._pending_operations)"," "," ","+@inspect_command(visible=False)","+def rate_limit_timers_count(state, **kwargs):","+    \"\"\"Return the number of pending rate limit timers on the worker timer.\"\"\"","+    callbacks = ('_schedule_bucket_request', '_on_bucket_wakeup')","+    return sum(","+        1 for item in state.consumer.timer.queue","+        if getattr(item.entry.fun, '__name__', None) in callbacks","+    )","+","+"," @shared_task"," def identity(x):","     \"\"\"Return the argument.\"\"\""],"additions":10,"deletions":0,"truncated":false},{"path":"t/smoke/tasks.py","lines":["@@ -94,6 +94,11 @@ def non_eta_task_with_retries(self):","     return self.request.retries"," "," ","+@shared_task(rate_limit=\"5/s\")","+def rate_limited_noop():","+    \"\"\"Do nothing, at most 5 times each second on each worker. For rate limit tests.\"\"\"","+","+"," @shared_task"," def summarize_results(results):","     \"\"\"Sum a list of results. For chord callback tests.\"\"\""],"additions":5,"deletions":0,"truncated":false},{"path":"t/smoke/tests/test_rate_limit.py","lines":["@@ -0,0 +1,59 @@","+from __future__ import annotations","+","+import time","+","+import pytest","+from pytest_celery import RESULT_TIMEOUT, CeleryBrokerCluster, CeleryTestSetup, RabbitMQTestBroker","+","+from t.smoke.tasks import rate_limited_noop","+","+RATE = 5  # The rate limit of rate_limited_noop, in tasks each second.","+SECONDS = 10","+","+","+@pytest.fixture","+def celery_broker_cluster(celery_rabbitmq_broker: RabbitMQTestBroker) -> CeleryBrokerCluster:","+    # The rate limit is applied by the worker consumer, so one broker is enough.","+    cluster = CeleryBrokerCluster(celery_rabbitmq_broker)","+    yield cluster","+    cluster.teardown()","+","+","+def count_rate_limit_timers(celery_setup: CeleryTestSetup) -> int:","+    worker = celery_setup.worker","+    replies = celery_setup.app.control.broadcast(","+        \"rate_limit_timers_count\",","+        destination=[worker.hostname()],","+        reply=True,","+        timeout=RESULT_TIMEOUT,","+    )","+    assert len(replies) == 1, replies","+    return replies[0][worker.hostname()]","+","+","+class RateLimitTimers:","+    def test_one_timer_per_bucket(self, celery_setup: CeleryTestSetup):","+        # More tasks than the worker runs in the test, as with a backlog. Each task that waits","+        # for a token must not arm a timer of its own: each such timer arms the next one while","+        # the bucket has tasks, so the timers would grow with the tasks received (#5927).","+        for _ in range(RATE * SECONDS * 3):","+            rate_limited_noop.s().apply_async(queue=celery_setup.worker.worker_queue)","+","+        counts = []","+        for _ in range(SECONDS):","+            time.sleep(1)","+            counts.append(count_rate_limit_timers(celery_setup))","+","+        assert max(counts) <= 1, counts","+","+","+class test_rate_limit_timers_prefork(RateLimitTimers):","+    @pytest.fixture","+    def default_worker_command(self, default_worker_container_cls):","+        return default_worker_container_cls.command(\"--pool=prefork\", \"--concurrency=4\")","+","+","+class test_rate_limit_timers_gevent(RateLimitTimers):","+    @pytest.fixture","+    def default_worker_command(self, default_worker_container_cls):","+        return default_worker_container_cls.command(\"--pool=gevent\", \"--concurrency=4\")"],"additions":59,"deletions":0,"truncated":false},{"path":"t/unit/worker/test_consumer.py","lines":["@@ -5,7 +5,7 @@"," from collections import deque"," from time import monotonic"," from types import SimpleNamespace","-from unittest.mock import MagicMock, Mock, call, patch","+from unittest.mock import ANY, MagicMock, Mock, call, patch"," "," import pytest"," from amqp import ChannelError","@@ -13,6 +13,7 @@"," from kombu import Queue"," from kombu.asynchronous import Hub"," from kombu.asynchronous.timer import Timer","+from kombu.utils.limits import TokenBucket"," "," from celery import bootsteps"," from celery.contrib.testing.mocks import ContextMock","@@ -59,6 +60,7 @@ def on_close_ctx():","     consumer.controller = Mock()","     consumer.controller.semaphore = Mock()","     consumer.task_buckets = {}","+    consumer._limit_timers = {}","     consumer.pool = Mock()","     consumer.pool.flush = Mock()"," ","@@ -440,7 +442,7 @@ def test_schedule_bucket_request(self):","         assert c._limit_order == limit_order + 1","         bucket.can_consume.assert_called_with(4)","         c.timer.call_after.assert_called_with(","-            3.33, c._schedule_bucket_request, (bucket,),","+            3.33, c._on_bucket_wakeup, (bucket, ANY),","             priority=c._limit_order,","         )","         bucket.expected_time.assert_called_with(4)","@@ -477,6 +479,129 @@ def test_post_eta(self):","             bucket.add.assert_called_with((request, 1))","             task_reserved.assert_called_with(bucket)"," ","+    def waiting_bucket(self):","+        bucket = Mock(name='bucket')","+        bucket.contents = deque()","+        bucket.add = bucket.contents.append","+        bucket.pop = bucket.contents.popleft","+        bucket.can_consume.return_value = False","+        bucket.expected_time.return_value = 1.0","+        return bucket","+","+    def fire_bucket_timer(self, c, bucket):","+        \"\"\"Run the callback of the last timer armed for ``bucket``.\"\"\"","+        _, callback, args = c.timer.call_after.call_args.args","+        assert args[0] is bucket","+        callback(*args)","+","+    def test_limit_task_arms_one_timer_per_bucket(self):","+        # Each request that waits for tokens must not arm a timer of its","+        # own: every such timer re-arms itself until the bucket is empty,","+        # so on a busy queue the timers would grow with the requests.","+        c = self.get_consumer()","+        c.timer = Timer()","+        bucket = TokenBucket(fill_rate=1, capacity=1)","+        assert bucket.can_consume(1)  # use the only token","+","+        with patch(","+            'celery.worker.consumer.consumer.Consumer._limit_move_to_pool'","+        ) as move_to_pool:","+            for _ in range(10):","+                c._limit_task(Mock(), bucket, 1)","+","+        move_to_pool.assert_not_called()","+        assert len(bucket.contents) == 10","+        assert len(c.timer.queue) == 1","+","+    def test_limit_task_arms_a_timer_for_each_bucket(self):","+        c = self.get_consumer()","+        c.timer = Mock()","+        first, second = self.waiting_bucket(), self.waiting_bucket()","+","+        c._limit_task(Mock(), first, 1)","+        c._limit_task(Mock(), second, 1)","+        c._limit_task(Mock(), first, 1)","+","+        assert c.timer.call_after.call_count == 2","+","+    def test_on_bucket_wakeup_arms_the_next_timer(self):","+        c = self.get_consumer()","+        c.timer = Mock()","+        bucket = self.waiting_bucket()","+        first, second = Mock(), Mock()","+        c._limit_task(first, bucket, 1)","+        c._limit_task(second, bucket, 1)","+        assert c.timer.call_after.call_count == 1","+        bucket.can_consume.side_effect = [True, False]","+","+        with patch(","+            'celery.worker.consumer.consumer.Consumer._limit_move_to_pool'","+        ) as move_to_pool:","+            self.fire_bucket_timer(c, bucket)","+","+        move_to_pool.assert_called_once_with(first)","+        assert list(bucket.contents) == [(second, 1)]","+        assert c.timer.call_after.call_count == 2","+        assert c._limit_timers[bucket][1] is c.timer.call_after.return_value","+","+    def test_on_bucket_wakeup_of_a_replaced_timer_does_nothing(self):","+        # If two timers were armed for one bucket, for example by the timer","+        # thread and the consumer at the same time, the timer that is no","+        # longer recorded must stop.  Otherwise both chains of timers would","+        # serve the bucket until it is empty.","+        c = self.get_consumer()","+        c.timer = Mock()","+        bucket = self.waiting_bucket()","+        c._limit_task(Mock(), bucket, 1)","+        _, callback, stale_args = c.timer.call_after.call_args.args","+        c._limit_timers.clear()","+        c._limit_task(Mock(), bucket, 1)  # arms the recorded timer","+        armed = c._limit_timers[bucket]","+","+        callback(*stale_args)","+","+        assert c.timer.call_after.call_count == 2","+        assert c._limit_timers[bucket] is armed","+        bucket.can_consume.assert_called_with(1)","+        assert len(bucket.contents) == 2","+","+    def test_on_bucket_wakeup_forgets_the_timer_of_an_empty_bucket(self):","+        c = self.get_consumer()","+        c.timer = Mock()","+        bucket = self.waiting_bucket()","+        request = Mock()","+        c._limit_task(request, bucket, 1)","+        bucket.can_consume.return_value = True","+","+        with patch(","+            'celery.worker.consumer.consumer.Consumer._limit_move_to_pool'","+        ) as move_to_pool:","+            self.fire_bucket_timer(c, bucket)","+","+        move_to_pool.assert_called_once_with(request)","+        assert c.timer.call_after.call_count == 1","+        assert bucket not in c._limit_timers","+","+        c._limit_task(Mock(), bucket, 1)  # tokens are available","+","+        assert c.timer.call_after.call_count == 1","+","+    def test_limit_task_arms_a_timer_again_after_on_close(self):","+        # on_close() empties the buckets and cancels their timers, so the","+        # cancelled timers never fire.  A bucket must not count as armed","+        # after that, or its requests would wait for ever.","+        c = self.get_consumer()","+        c.timer = Mock()","+        bucket = self.waiting_bucket()","+        c._limit_task(Mock(), bucket, 1)","+        _, entry = c._limit_timers[bucket]","+","+        c.on_close()","+        c._limit_task(Mock(), bucket, 1)","+","+        c.timer.cancel.assert_called_once_with(entry)","+        assert c.timer.call_after.call_count == 2","+","     def test_max_restarts_exceeded(self):","         c = self.get_consumer()"," ","@@ -832,6 +957,46 @@ def test_on_close_keeps_running_task_that_is_also_scheduled(self, on_close_ctx):","         assert running in state.active_requests","         assert running not in state.scheduled_requests"," ","+    def test_on_close_cancels_and_forgets_rate_limit_timers(self, on_close_ctx):","+        \"\"\"The buckets are emptied, so their pending timers have nothing","+        to do.  They must be cancelled through ``self.timer.cancel(entry)``","+        and forgotten, so that the next connection can arm new ones.","+        \"\"\"","+        state, Consumer, consumer = on_close_ctx","+        bucket, entry = Mock(name='bucket'), Mock(name='entry')","+        consumer._limit_timers = {bucket: (object(), entry)}","+","+        Consumer.on_close(consumer)","+","+        consumer.timer.cancel.assert_called_once_with(entry)","+        entry.cancel.assert_not_called()","+        assert consumer._limit_timers == {}","+","+    def test_on_close_forgets_rate_limit_timers_if_cancel_raises(self, on_close_ctx):","+        state, Consumer, consumer = on_close_ctx","+        consumer.timer.cancel.side_effect = RuntimeError('boom')","+        consumer._limit_timers = {","+            Mock(name='bucket'): (object(), Mock(name='entry')),","+        }","+","+        Consumer.on_close(consumer)","+","+        assert consumer._limit_timers == {}","+","+    def test_on_close_forgets_rate_limit_timers_without_timer(self, on_close_ctx):","+        \"\"\"A consumer can have no timer.  on_close() must not try to cancel","+        the timer entries then, but it must still forget them.","+        \"\"\"","+        state, Consumer, consumer = on_close_ctx","+        consumer.timer = None","+        entry = Mock(name='entry')","+        consumer._limit_timers = {Mock(name='bucket'): (object(), entry)}","+","+        Consumer.on_close(consumer)","+","+        entry.cancel.assert_not_called()","+        assert consumer._limit_timers == {}","+","     def test_connect_error_handler(self):","         self.app._connection = _amqp_connection()","         conn = self.app._connection.return_value","@@ -1332,6 +1497,7 @@ def __init__(self, id):","         consumer.controller.max_concurrency = None","         consumer.controller.semaphore = Mock()","         consumer.task_buckets = {}","+        consumer._limit_timers = {}","         consumer.initial_prefetch_count = 1","         consumer.connection = Mock()","         consumer.connection.connection_errors = ()"],"additions":168,"deletions":2,"truncated":false},{"path":"t/unit/worker/test_control.py","lines":["@@ -48,6 +48,7 @@ def __init__(self, app):","         from celery.concurrency.base import BasePool","         self.pool = BasePool(10)","         self.task_buckets = defaultdict(lambda: None)","+        self._limit_timers = {}","         self.hub = None"," ","     def call_soon(self, p, *args, **kwargs):"],"additions":1,"deletions":0,"truncated":false},{"path":"t/unit/worker/test_eta_query_task.py","lines":["@@ -47,6 +47,7 @@ def __init__(self, app):","         # whole test session. It already starts out empty.","         self.task_consumer = Mock()","         self.task_buckets = defaultdict(lambda: None)","+        self._limit_timers = {}","         self.qos = Mock()","         self.on_task_request = Mock()","         self.disable_rate_limits = True",""],"additions":1,"deletions":0,"truncated":false}],"additions":286,"deletions":8,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-26T18:55:51.749963+00:00"}