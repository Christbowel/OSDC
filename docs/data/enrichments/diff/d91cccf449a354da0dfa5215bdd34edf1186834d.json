nk preview thumbnails and","+the Google Drive OAuth entry point were affected.","+","+Every such route url has lost its .php suffix so that no route url resolves to","+a file on disk any more, and the affected javascript callers now build routed","+urls through OC.generateUrl(). Route names are unchanged, so linkToRoute()","+callers keep working. The legacy .php urls are gone and no alias is provided -","+an alias would re-introduce the very shadowing this change removes.","+/core/ajax/update.php keeps its suffix by design: it bootstraps itself and is","+excluded from the rewrite. Five routes whose include target no longer existed","+were removed. Third-party apps posting to their own shadowed .php route urls","+need the same treatment.","+","+https://github.com/owncloud/core/issues/41740","+https://github.com/owncloud/core/pull/41742"],"additions":23,"deletions":0,"truncated":false},{"path":"core/js/js.js","lines":["@@ -43,7 +43,7 @@ function escapeHTML(s) {","  * @deprecated use Files.getDownloadURL() instead","  */"," function fileDownloadPath(dir, file) {","-\treturn OC.filePath('files', 'ajax', 'download.php') + '?files=' + encodeURIComponent(file) + '&dir=' + encodeURIComponent(dir);","+\treturn OC.generateUrl('/apps/files/ajax/download') + '?files=' + encodeURIComponent(file) + '&dir=' + encodeURIComponent(dir);"," }"," "," /** @namespace */"],"additions":1,"deletions":1,"truncated":false},{"path":"core/js/oc-dialogs.js","lines":["@@ -745,7 +745,7 @@ var OCdialogs = {"," \t\t}"," "," \t\treturn $.getJSON(","-\t\t\tOC.filePath('files', 'ajax', 'list.php'),","+\t\t\tOC.generateUrl('/apps/files/ajax/list'),"," \t\t\t{"," \t\t\t\tdir: dir,"," \t\t\t\tmimetypes: JSON.stringify(mimeType)"],"additions":1,"deletions":1,"truncated":false},{"path":"core/js/share.js","lines":["@@ -299,7 +299,7 @@ OC.Share = _.extend(OC.Share || {}, {"," \t\t} else {"," \t\t\tvar checkShares = true;"," \t\t}","-\t\t$.ajax({type: 'GET', url: OC.filePath('core', 'ajax', 'share.php'), data: