enDict::type_object_raw(py) as usize","+    }","+    #[cfg(not(Py_3_15))]","+    {","+        0","+    }","+}","+","+/// Returns `value` as a mapping if it is an instance of `frozendict` (or a subclass).","+#[cfg_attr(not(Py_3_15), allow(unused_variables))]","+pub fn as_frozendict<'a, 'py>(value: &'a Bound<'py, PyAny>) -> Option<&'a Bound<'py, PyMapping>> {","+    #[cfg(Py_3_15)]","+    {","+        value.cast::<PyFrozenDict>().ok().map(PyFrozenDictMethods::as_mapping)","+    }","+    #[cfg(not(Py_3_15))]","+    {","+        None","+    }","+}","+","+/// Creates a new `frozendict` from `mapping` (e.g. a `dict`).","+#[cfg_attr(not(Py_3_15), allow(unused_variables))]","+pub fn new_frozendict<'py>(mapping: &Bound<'py, PyAny>) -> PyResult<Bound<'py, PyAny>> {","+    #[cfg(Py_3_15)]","+    {","+        PyFrozenDict::from_sequence(mapping).map(Bound::into_any)","+    }","+    #[cfg(not(Py_3_15))]","+    {","+        Err(pyo3::exceptions::PyRuntimeError::new_err(","+            \"The `frozendict` builtin type is only available on Python 3.15 and above\",","+        ))","+    }","+}","+","+/// Iterates over the `(key, value)` pairs of `value`, which must be a `frozendict` (or a subclass).","+#[cfg(Py_3_15)]","+pub fn frozendict_items<'py>(","+    value: &Bound<'py, PyAny>,","+) -> PyResult<impl Iterator<Item = (Bound<'py, PyAny>, Bound<'py, PyAny>)>> {","+    Ok(value.cast::<PyFrozenDict>()?.iter())","+}"," ","-// TODO: remove when https://github.com/PyO3/pyo3/pull/6174 gets released and use `PyFrozenDict` instead:","-pub fn get_frozendict_type(py: Python<'_>) -> PyResult<&Bound<'_, PyType>> {","-    FROZENDICT_TYPE.import(py, \"builtins\", \"frozendict\")","+/// Iterates over the `(key, value)` pairs of `value`, which must be a `frozendict` (or a subclass).","+#[cfg(not(Py_3_15))]","+pub fn frozendict_items<'py>(","+    _value: &Bound<'py, PyAny>,","+) -> PyResult<std::iter::Empty<(Bound<'py, PyAny>, Bound<'py, PyAny>)>> {","+    Err(pyo3::exceptions::PyRuntimeError::new_e