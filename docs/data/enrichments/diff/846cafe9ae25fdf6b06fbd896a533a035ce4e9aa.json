))","                 return log_error_errno(SYNTHETIC_ERRNO(EINVAL),"],"additions":5,"deletions":2,"truncated":false},{"path":"src/analyze/meson.build","lines":["@@ -20,6 +20,7 @@ systemd_analyze_sources = files(","         'analyze-has-tpm2.c',","         'analyze-image-policy.c',","         'analyze-inspect-elf.c',","+        'analyze-io-uring-filter.c',","         'analyze-log-control.c',","         'analyze-malloc.c',","         'analyze-nvpcrs.c',"],"additions":1,"deletions":0,"truncated":false},{"path":"test/units/TEST-65-ANALYZE.sh","lines":["@@ -150,6 +150,10 @@ systemd-analyze syscall-filter @chown @sync"," systemd-analyze syscall-filter @sync @sync @sync"," (! systemd-analyze syscall-filter @chown @sync @foobar)"," (! systemd-analyze syscall-filter --global)","+systemd-analyze io-uring-filter >/dev/null","+systemd-analyze io-uring-filter nop read uring_cmd","+systemd-analyze io-uring-filter --json=short socket | jq -e '.[0] == {\"name\": \"socket\", \"syscalls\": [\"socket\"]}'","+(! systemd-analyze io-uring-filter read foobar)"," # filesystems (requires libbpf support)"," if systemctl --version | grep \"+BPF_FRAMEWORK\"; then","     systemd-analyze filesystems >/dev/null",""],"additions":4,"deletions":0,"truncated":false}],"additions":147,"deletions":4,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-04T16:06:57.050775+00:00"}