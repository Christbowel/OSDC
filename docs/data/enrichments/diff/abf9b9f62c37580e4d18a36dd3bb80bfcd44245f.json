Handler(thread.looper)","+  val dispatcher = handler.asCoroutineDispatcher(\"expo-media-session\")","+}"],"additions":11,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/android/src/main/java/expo/modules/mediasession/SessionBackend.kt","lines":["@@ -0,0 +1,75 @@","+package expo.modules.mediasession","+","+import android.content.Context","+import android.media.AudioAttributes","+import android.media.AudioFocusRequest","+import android.media.AudioManager","+import android.os.Build","+import android.os.Handler","+","+internal enum class FocusResult { GRANTED, DELAYED }","+","+internal interface SessionBackend {","+  var onFocusChange: (Int) -> Unit","+  fun requestFocus(spec: FocusSpec): FocusResult","+  fun abandonFocus()","+}","+","+internal class AudioManagerBackend(context: Context, private val handler: Handler) : SessionBackend {","+  private val audioManager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager","+  private var request: AudioFocusRequest? = null","+  private var holdsLegacyFocus = false","+","+  override var onFocusChange: (Int) -> Unit = {}","+","+  private val listener = AudioManager.OnAudioFocusChangeListener { onFocusChange(it) }","+","+  override fun requestFocus(spec: FocusSpec): FocusResult {","+    val result = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {","+      val newRequest = AudioFocusRequest.Builder(spec.gain)","+        .setAudioAttributes(","+          AudioAttributes.Builder()","+            .setUsage(spec.usage)","+            .setContentType(spec.contentType)","+            .build()","+        )","+        .setAcceptsDelayedFocusGain(spec.acceptsDelayedFocusGain)","+        .setWillPauseWhenDucked(spec.pausesWhenDucked)","+        .setOnAudioFocusChangeListener(listener, handler)","+        .build()","+      audioManager.requestAudioFocus(newRequest).also {","+        if (it != AudioManager.AUDIOFOCUS_REQUEST_FAILED) {","+          request = newRequest","+        }","+      }","+    } else {","+      val stream = if (spec.usage == AudioAttributes.USAGE_VOICE_COMMUNICATION) {","+        AudioManager.STREAM_VOICE_CALL","+      } else {","+        AudioManager.STREAM_MUSIC","+      }","+      @Suppress(\"DEPRECATION\")","+      audioManager.requestAudioFocus(listener, stream, spec.gain).also {","+        if (it != AudioManager.AUDIOFOCUS_REQUEST_FAILED) {","+          holdsLegacyFocus = true","+        }","+      }","+    }","+    return when (result) {","+      AudioManager.AUDIOFOCUS_REQUEST_GRANTED -> FocusResult.GRANTED","+      AudioManager.AUDIOFOCUS_REQUEST_DELAYED -> FocusResult.DELAYED","+      else -> throw IllegalStateException(\"AudioManager.requestAudioFocus returned AUDIOFOCUS_REQUEST_FAILED\")","+    }","+  }","+","+  override fun abandonFocus() {","+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {","+      request?.let { audioManager.abandonAudioFocusRequest(it) }","+      request = null","+    } else if (holdsLegacyFocus) {","+      @Suppress(\"DEPRECATION\")","+      audioManager.abandonAudioFocus(listener)","+      holdsLegacyFocus = false","+    }","+  }","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/android/src/main/java/expo/modules/mediasession/SessionCoordinator.kt","lines":["@@ -0,0 +1,383 @@","+package expo.modules.mediasession","+","+import android.media.AudioManager","+import android.util.Log","+import androidx.annotation.VisibleForTesting","+import java.lang.ref.WeakReference","+import java.util.concurrent.atomic.AtomicLong","+import java.util.concurrent.atomic.AtomicReference","+import kotlinx.coroutines.CancellationException","+import kotlinx.coroutines.CompletableDeferred","+import kotlinx.coroutines.CoroutineDispatcher","+import kotlinx.coroutines.CoroutineExceptionHandler","+import kotlinx.coroutines.CoroutineScope","+import kotlinx.coroutines.Job","+import kotlinx.coroutines.SupervisorJob","+import kotlinx.coroutines.cancel","+import kotlinx.coroutines.delay","+import kotlinx.coroutines.launch","+","+internal class SessionCoordinator(","+  private val backend: SessionBackend,","+  dispatcher: CoroutineDispatcher","+) {","+  internal class Snapshot(","+    val useCount: Int = 0,","+    val heldFocus: FocusSpec? = null,","+    val isFocusDelayed: Boolean = false,","+    val pendingActivationCount: Int = 0","+  )","+","+  private class Entry(","+    val id: Long,","+    val client: String,","+    var requirements: SessionRequirements,","+    val token: WeakReference<Any>,","+    val activation: CompletableDeferred<Unit>","+  )","+","+  var log: (String) -> Unit = { Log.w(TAG, it) }","+","+  private val scope = CoroutineScope(","+    SupervisorJob() + dispatcher + CoroutineExceptionHandler { _, error ->","+      log(\"Coordinator task failed: $error\")","+    }","+  )","+  private val policyState = AtomicReference(AudioPolicy.DEFAULT)","+  private val nextId = AtomicLong()","+  private val releaseGeneration = AtomicLong()","+","+  private val entries = mutableListOf<Entry>()","+  private val observers = mutableListOf<Pair<Long, MediaSessionObserver>>()","+  private val pendingActivations = mutableListOf<CompletableDeferred<Unit>>()","+  private var suspendCount = 0","+  private var activated = false","+  private var currentFocus: FocusSpec? = null","+  private var focusDelayed = false","+  private var releaseJob: Job? = null","+","+  @Volatile","+  private var snapshot = Snapshot()","+","+  val policy: AudioPolicy","+    get() = policyState.get()","+","+  @get:VisibleForTesting","+  val useCount: Int","+    get() = snapshot.useCount","+","+  @get:VisibleForTesting","+  val heldFocus: FocusSpec?","+    get() = snapshot.heldFocus","+","+  @get:VisibleForTesting","+  val isFocusDelayed: Boolean","+    get() = snapshot.isFocusDelayed","+","+  @get:VisibleForTesting","+  val pendingActivationCount: Int","+    get() = snapshot.pendingActivationCount","+","+  init {","+    backend.onFocusChange = ::onFocusChange","+  }","+","+  fun nextId(): Long = nextId.incrementAndGet()","+","+  fun begin(","+    id: Long,","+    client: String,","+    requirements: SessionRequirements,","+    activation: CompletableDeferred<Unit>,","+    token: Any","+  ) {","+    releaseGeneration.incrementAndGet()","+    val reference = WeakReference(token)","+    task {","+      entries.add(Entry(id, client, requirements, reference, activation))","+      reconcile(client, activating = true, activation)","+    }.invokeOnCompletion { cause ->","+      when (cause) {","+        null -> Unit","+        is CancellationException -> activation.completeExceptionally(","+          MediaSessionException(","+            \"Audio focus was not requested for $client because the media session manager shut down. \" +","+              \"Begin a new use on a running manager\",","+            cause","+          )","+        )","+        else -> activation.completeExceptionally(","+          MediaSessionException(","+            \"Audio focus was not requested for $client because the coordinator task failed: $cause. \" +","+              \"Begin the use again, and report the cause if it repeats\",","+            cause","+          )","+        )","+      }","+    }","+  }","+","+  fun update(id: Long, requirements: SessionRequirements) {","+    task {","+      val entry = entries.firstOrNull { it.id == id } ?: return@task","+      entry.requirements = requirements","+      reconcile(entry.client, activating = false, activation = null)","+    }","+  }","+","+  fun end(id: Long) {","+    task {","+      val entry = entries.firstOrNull { it.id == id } ?: return@task","+      entries.remove(entry)","+      pendingActivations.remove(entry.activation)","+      if (entries.isEmpty()) {","+        scheduleRelease()","+      } else {","+        reconcile(client = null, activating = false, activation = null)","+      }","+    }","+  }","+","+  fun setPolicy(update: AudioPolicyUpdate) {","+    policyState.updateAndGet { it.merged(update) }","+    task {","+      reconcile(client = null, activating = false, activation = null)","+    }","+  }","+","+  fun suspendWrites(reason: String) {","+    task {","+      suspendCount += 1","+      if (suspendCount != 1) {","+        return@task","+      }","+      cancelRelease()","+      notify { it.mediaSessionDidSuspendWrites(reason) }","+    }","+  }","+","+  fun resumeWrites() {","+    task {","+      if (suspendCount == 0) {","+        return@task","+      }","+      suspendCount -= 1","+      if (suspendCount != 0) {","+        return@task","+      }","+      notify { it.mediaSessionDidResumeWrites() }","+      if (entries.isEmpty()) {","+        scheduleRelease()","+      } else {","+        currentFocus = null","+        reconcile(client = null, activating = true, activation = null)","+      }","+    }","+  }","+","+  fun onFocusChange(change: Int) {","+    task {","+      when (change) {","+        AudioManager.AUDIOFOCUS_GAIN -> onFocusGained()","+        AudioManager.AUDIOFOCUS_LOSS -> onFocusLost()","+      }","+    }","+  }","+","+  private fun onFocusGained() {","+    if (!focusDelayed) {","+      return","+    }","+    focusDelayed = false","+    activated = true","+    completePending(Result.success(Unit))","+    reconcile(client = null, activating = false, activation = null)","+  }","+","+  private fun onFocusLost() {","+    currentFocus = null","+    focusDelayed = false","+    val client = entries.lastOrNull()?.client ?: return","+    completePending(","+      Result.failure(","+        MediaSessionException(","+          \"Audio focus for $client was lost before the system granted it. \" +","+            \"Another app or a call took focus. Begin the use again after the other audio stops\"","+        )","+      )","+    )","+  }","+","+  fun addObserver(observer: MediaSessionObserver): ObserverRegistration {","+    val id = nextId()","+    task {","+      observers.add(id to observer)","+    }","+    return ObserverRegistration {","+      task {","+        observers.removeAll { it.first == id }","+      }","+    }","+  }","+","+  fun clearTokenReference(id: Long) {","+    task {","+      entries.firstOrNull { it.id == id }?.token?.clear()","+    }","+  }","+","+  @VisibleForTesting","+  fun close() {","+    scope.launch {","+      try {","+        cancelRelease()","+        if (currentFocus != null) {","+          abandon()","+        }","+        completePending(","+          Result.failure(","+            MediaSessionException(","+              \"Audio focus was not requested because the media session manager shut down. \" +","+                \"Begin a new use on a running manager\"","+            )","+          )","+        )","+        publishSnapshot()","+      } finally {","+        scope.cancel()","+      }","+    }","+  }","+","+  private fun task(body: () -> Unit) = scope.launch {","+    if (pruneCollectedTokens()) {","+      if (entries.isEmpty()) {","+        scheduleRelease()","+      } else {","+        reconcile(client = null, activating = false, activation = null)","+      }","+    }","+    body()","+    publishSnapshot()","+  }","+","+  private fun publishSnapshot() {","+    snapshot = Snapshot(entries.size, currentFocus, focusDelayed, pendingActivations.size)","+  }","+","+  private fun pruneCollectedTokens(): Boolean {","+    val collected = entries.filter { it.token.get() == null }","+    for (entry in collected) {","+      log(\"${entry.client} did not end its session use before it was garbage collected\")","+      pendingActivations.remove(entry.activation)","+      entry.activation.completeExceptionally(","+        MediaSessionException(","+          \"The session use for ${entry.client} was garbage collected before it was activated. \" +","+            \"Keep a reference to the use and close it when playback stops\"","+        )","+      )","+    }","+    return entries.removeAll(collected)","+  }","+","+  private fun reconcile(client: String?, activating: Boolean, activation: CompletableDeferred<Unit>?) {","+    activation?.let { pendingActivations.add(it) }","+    val reportedClient = client ?: entries.lastOrNull()?.client","+    if (suspendCount > 0 || reportedClient == null) {","+      return","+    }","+    cancelRelease()","+","+    val focus = SessionResolver.resolve(policy, entries.map { it.requirements }).focus","+    if (focus == null) {","+      if (currentFocus != null) {","+        abandon()","+      }","+    } else if (focus != currentFocus && (activating || activated)) {","+      try {","+        val result = backend.requestFocus(focus)","+        currentFocus = focus","+        focusDelayed = result == FocusResult.DELAYED","+      } catch (e: Exception) {","+        if (focusDelayed) {","+          currentFocus = null","+          focusDelayed = false","+        }","+        val error = MediaSessionException(","+          \"Audio focus could not be acquired for $reportedClient. Another app or a phone call may hold focus \" +","+            \"that does not allow others to play, or the app may be in the background without a foreground service, \" +","+            \"where Android 15 and later refuse focus. Begin the use again after the other audio stops, or start \" +","+            \"playback while the app is visible\",","+          e","+        )","+        completePending(Result.failure(error))","+        notify { it.mediaSessionDidFail(error, reportedClient) }","+        return","+      }","+    }","+    if (focusDelayed) {","+      return","+    }","+    if (activating) {","+      activated = true","+    }","+    completePending(Result.success(Unit))","+  }","+","+  private fun completePending(result: Result<Unit>) {","+    val waiting = pendingActivations.toList()","+    pendingActivations.clear()","+    waiting.forEach { deferred ->","+      result.fold({ deferred.complete(Unit) }, { deferred.completeExceptionally(it) })","+    }","+  }","+","+  private fun scheduleRelease() {","+    if (suspendCount > 0) {","+      return","+    }","+    if (currentFocus == null) {","+      activated = false","+      return","+    }","+    cancelRelease()","+    val generation = releaseGeneration.get()","+    releaseJob = scope.launch {","+      delay(RELEASE_DELAY_MS)","+      releaseJob = null","+      pruneCollectedTokens()","+      if (generation == releaseGeneration.get() && entries.isEmpty() && suspendCount == 0 && currentFocus != null) {","+        abandon()","+        activated = false","+      }","+      publishSnapshot()","+    }","+  }","+","+  private fun cancelRelease() {","+    releaseJob?.cancel()","+    releaseJob = null","+  }","+","+  private fun abandon() {","+    backend.abandonFocus()","+    currentFocus = null","+    focusDelayed = false","+  }","+","+  private fun notify(body: (MediaSessionObserver) -> Unit) {","+    publishSnapshot()","+    observers.toList().forEach { (_, observer) ->","+      try {","+        body(observer)","+      } catch (e: Exception) {","+        log(\"Observer failed: $e\")","+      }","+    }","+  }","+","+  companion object {","+    const val RELEASE_DELAY_MS = 1000L","+    private const val TAG = \"ExpoMediaSession\"","+  }","+}"],"additions":383,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/android/src/test/java/expo/modules/mediasession/Fakes.kt","lines":["@@ -0,0 +1,61 @@","+package expo.modules.mediasession","+","+import expo.modules.kotlin.exception.CodedException","+","+internal class FakeSessionBackend : SessionBackend {","+  sealed class Call {","+    data class Request(val spec: FocusSpec) : Call()","+    object Abandon : Call()","+  }","+","+  val calls = mutableListOf<Call>()","+  var requestError: Throwable? = null","+  var duringAbandon: (() -> Unit)? = null","+  var result = FocusResult.GRANTED","+  override var onFocusChange: (Int) -> Unit = {}","+","+  val requests: Int","+    get() = calls.count { it is Call.Request }","+","+  val abandons: Int","+    get() = calls.count { it == Call.Abandon }","+","+  override fun requestFocus(spec: FocusSpec): FocusResult {","+    calls.add(Call.Request(spec))","+    requestError?.let { throw it }","+    return result","+  }","+","+  override fun abandonFocus() {","+    calls.add(Call.Abandon)","+    duringAbandon?.invoke()","+  }","+","+  fun emitFocusChange(change: Int) {","+    onFocusChange(change)","+  }","+}","+","+internal class RecordingObserver : MediaSessionObserver {","+  sealed class Event {","+    data class Failed(val client: String) : Event()","+    data class Suspended(val reason: String) : Event()","+    object Resumed : Event()","+  }","+","+  val events = mutableListOf<Event>()","+  var error: CodedException? = null","+","+  override fun mediaSessionDidFail(error: CodedException, client: String) {","+    events.add(Event.Failed(client))","+    this.error = error","+  }","+","+  override fun mediaSessionDidSuspendWrites(reason: String) {","+    events.add(Event.Suspended(reason))","+  }","+","+  override fun mediaSessionDidResumeWrites() {","+    events.add(Event.Resumed)","+  }","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"packages/expo-media-session/android/src/test/java/expo/modules/mediasession/SessionCoordinatorTest.kt","lines":["@@ -0,0 +1,442 @@","+package expo.modules.mediasession","+","+import android.media.AudioAttributes","+import android.media.AudioManager","+import java.util.concurrent.CountDownLatch","+import kotlinx.coroutines.ExperimentalCoroutinesApi","+import kotlinx.coroutines.test.StandardTestDispatcher","+import kotlinx.coroutines.test.TestCoroutineScheduler","+import kotlinx.coroutines.test.runTest","+import org.junit.After","+import org.junit.Assert.assertEquals","+import org.junit.Assert.assertFalse","+import org.junit.Assert.assertNull","+import org.junit.Assert.assertSame","+import org.junit.Assert.assertTrue","+import org.junit.Assert.fail","+import org.junit.Test","+","+@OptIn(ExperimentalCoroutinesApi::class)","+class SessionCoordinatorTest {","+  private val scheduler = TestCoroutineScheduler()","+  private val backend = FakeSessionBackend()","+  private val observer = RecordingObserver()","+  private val manager = MediaSessionManager(backend, StandardTestDispatcher(scheduler)).apply {","+    coordinator.log = {}","+    addObserver(observer)","+    setPolicy(AudioPolicyUpdate(interruptionMode = InterruptionMode.DO_NOT_MIX))","+  }","+","+  @After","+  fun tearDown() {","+    manager.coordinator.close()","+    runCurrent()","+  }","+","+  private fun runCurrent() = scheduler.runCurrent()","+","+  private fun advance(milliseconds: Long) {","+    scheduler.advanceTimeBy(milliseconds)","+    scheduler.runCurrent()","+  }","+","+  private fun focus(requirements: SessionRequirements = SessionRequirements()) =","+    SessionResolver.resolve(manager.policy, listOf(requirements)).focus!!","+","+  @Test","+  fun firstUseRequestsFocus() = runTest(scheduler) {","+    val use = manager.beginUse(\"a\")","+    use.awaitActivation()","+","+    assertEquals(listOf(FakeSessionBackend.Call.Request(focus())), backend.calls)","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT, focus().gain)","+    use.end()","+  }","+","+  @Test","+  fun releaseAfterOneSecondHold() {","+    manager.beginUse(\"a\").end()","+    runCurrent()","+","+    advance(999)","+    assertEquals(0, backend.abandons)","+    advance(1)","+    assertEquals(FakeSessionBackend.Call.Abandon, backend.calls.last())","+    assertEquals(1, backend.abandons)","+  }","+","+  @Test","+  fun newUseCancelsPendingRelease() {","+    manager.beginUse(\"a\").end()","+    runCurrent()","+    advance(500)","+    val second = manager.beginUse(\"b\")","+    advance(2000)","+","+    assertEquals(0, backend.abandons)","+    assertEquals(1, backend.requests)","+    second.end()","+  }","+","+  @Test","+  fun beginDuringReleaseRequestsFocusAgain() {","+    manager.beginUse(\"a\").end()","+    runCurrent()","+    var second: SessionUse? = null","+    backend.duringAbandon = { second = manager.beginUse(\"b\") }","+    advance(1000)","+","+    assertEquals(","+      listOf(FakeSessionBackend.Call.Abandon, FakeSessionBackend.Call.Request(focus())),","+      backend.calls.takeLast(2)","+    )","+    assertEquals(1, manager.coordinator.useCount)","+    second?.end()","+  }","+","+  @Test","+  fun beginAfterReleaseIsDueCancelsIt() {","+    manager.beginUse(\"a\").end()","+    runCurrent()","+    scheduler.advanceTimeBy(1000)","+    val second = manager.beginUse(\"b\")","+    runCurrent()","+","+    assertEquals(0, backend.abandons)","+    assertEquals(1, backend.requests)","+    second.end()","+  }","+","+  @Test","+  fun focusReturnsAfterMixWithOthersStep() {","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    manager.setPolicy(AudioPolicyUpdate(interruptionMode = InterruptionMode.MIX_WITH_OTHERS))","+    runCurrent()","+    assertEquals(FakeSessionBackend.Call.Abandon, backend.calls.last())","+","+    manager.setPolicy(AudioPolicyUpdate(interruptionMode = InterruptionMode.DO_NOT_MIX))","+    runCurrent()","+    assertEquals(FakeSessionBackend.Call.Request(focus()), backend.calls.last())","+    assertEquals(2, backend.requests)","+    use.end()","+  }","+","+  @Test","+  fun delayedFocusWaitsForGrant() {","+    backend.result = FocusResult.DELAYED","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    assertFalse(use.activation.isCompleted)","+","+    backend.emitFocusChange(AudioManager.AUDIOFOCUS_GAIN)","+    runCurrent()","+    assertTrue(use.activation.isCompleted)","+    assertFalse(use.activation.isCancelled)","+    use.end()","+  }","+","+  @Test","+  fun delayedFocusFailsWhenLost() {","+    backend.result = FocusResult.DELAYED","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    backend.emitFocusChange(AudioManager.AUDIOFOCUS_LOSS)","+    runCurrent()","+","+    assertTrue(use.activation.getCompletionExceptionOrNull() is MediaSessionException)","+    use.end()","+  }","+","+  @Test","+  fun updateDuringDelayedWaitAppliesAfterGrant() {","+    backend.result = FocusResult.DELAYED","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    val movie = SessionRequirements(contentType = AudioAttributes.CONTENT_TYPE_MOVIE)","+    use.update(movie)","+    runCurrent()","+","+    backend.result = FocusResult.GRANTED","+    backend.emitFocusChange(AudioManager.AUDIOFOCUS_GAIN)","+    runCurrent()","+    assertEquals(FakeSessionBackend.Call.Request(focus(movie)), backend.calls.last())","+    use.end()","+  }","+","+  @Test","+  fun failedRequestClearsDelayedState() {","+    backend.result = FocusResult.DELAYED","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    manager.suspendWrites(\"call\")","+    backend.requestError = IllegalStateException(\"AUDIOFOCUS_REQUEST_FAILED\")","+    manager.resumeWrites()","+    runCurrent()","+","+    assertFalse(manager.coordinator.isFocusDelayed)","+    use.end()","+  }","+","+  @Test","+  fun pruneFailsPendingActivationAndReconcilesTheRest() {","+    val kept = manager.beginUse(\"kept\")","+    runCurrent()","+    manager.suspendWrites(\"call\")","+    val leaked = manager.beginUse(\"leaked\", SessionRequirements(contentType = AudioAttributes.CONTENT_TYPE_MOVIE))","+    runCurrent()","+    manager.coordinator.clearTokenReference(leaked.id)","+    manager.resumeWrites()","+    runCurrent()","+","+    assertTrue(leaked.activation.getCompletionExceptionOrNull() is MediaSessionException)","+    assertEquals(1, manager.coordinator.useCount)","+    assertEquals(FakeSessionBackend.Call.Request(focus()), backend.calls.last())","+    kept.end()","+  }","+","+  @Test","+  fun collectedTokenIsPruned() {","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    manager.coordinator.clearTokenReference(use.id)","+    manager.setPolicy(AudioPolicyUpdate())","+    runCurrent()","+    assertEquals(0, manager.coordinator.useCount)","+","+    advance(1000)","+    assertEquals(1, backend.abandons)","+  }","+","+  @Test","+  fun activationWaitsForResume() {","+    manager.suspendWrites(\"call\")","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    assertFalse(use.activation.isCompleted)","+","+    manager.resumeWrites()","+    runCurrent()","+    assertTrue(use.activation.isCompleted)","+    assertEquals(listOf(FakeSessionBackend.Call.Request(focus())), backend.calls)","+    use.end()","+  }","+","+  @Test","+  fun holdTokensAreIndependent() {","+    val first = manager.hold(\"a\")","+    val second = manager.hold(\"b\")","+    first.release()","+    first.close()","+    advance(2000)","+    assertEquals(0, backend.abandons)","+","+    second.close()","+    runCurrent()","+    advance(999)","+    assertEquals(0, backend.abandons)","+    advance(1)","+    assertEquals(1, backend.abandons)","+  }","+","+  @Test","+  fun setPolicyWithoutUseWritesNothing() {","+    manager.setPolicy(AudioPolicyUpdate(interruptionMode = InterruptionMode.DO_NOT_MIX_PERSISTENT))","+    advance(2000)","+    assertTrue(backend.calls.isEmpty())","+    assertEquals(InterruptionMode.DO_NOT_MIX_PERSISTENT, manager.policy.interruptionMode)","+","+    val use = manager.beginUse(\"a\")","+    runCurrent()","+    assertEquals(listOf(FakeSessionBackend.Call.Request(focus())), backend.calls)","+    assertEquals(AudioManager.AUDIOFOCUS_GAIN, focus().gain)","+    use.end()","+  }","+","+  @Test","+  fun suspendFreezesWrites() {","+    val requirements = SessionRequirements(contentType = AudioAttributes.CONTENT_TYPE_SPEECH)","+    manager.suspendWrites(\"call\")","+    manager.beginUse(\"a\").end()","+    manager.setPolicy(AudioPolicyUpdate(interruptionMode = InterruptionMode.DUCK_OTHERS))","+    val use = manager.beginUse(\"b\", requirements)","+    advance(2000)","+","+    assertTrue(backend.calls.isEmpty())","+    assertEquals(listOf(RecordingObserver.Event.Suspended(\"call\")), observer.events)","+    assertEquals(1, manager.coordinator.useCount)"],"additions":267,"deletions":0,"truncated":false}],"additions":945,"deletions":0,"