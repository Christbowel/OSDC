     IsVNHWIntrinsicFunc(vn, &funcApp, &id, &simdSize, &simdBaseType))","             {","                 if (HWIntrinsicInfo::ReturnsBoolean(id))","                 {","@@ -7295,7 +7296,6 @@ bool ValueNumStore::IsVNNeverNegative(ValueNum vn)","                 case VNF_GT_UN:","                 case VNF_LE_UN:","                 case VNF_LT_UN:","-                case VNF_MDArrLowerBound:","                 {","                     return VNVisit::Continue;","                 }","@@ -11814,7 +11814,7 @@ void ValueNumStore::RunTests(Compiler* comp)","     VNFuncApp fa2a;","     bool      b = vns->GetVNFunc(vnForFunc2a, &fa2a);","     assert(b);","-    assert(fa2a.FuncIs(VNF_Add) && fa2a.GetArity() == 2 && fa2a.GetArg(0) == vnFor1 && fa2a.GetArg(1) == vnRandom1);","+    assert(fa2a.FuncIs(VNF_Add) && fa2a.GetArity() == 2 && fa2a.GetArg(0) == vnRandom1 && fa2a.GetArg(1) == vnFor1);"," ","     ValueNum vnForFunc2b = vns->VNForFunc(TYP_INT, VNF_Add, vnFor1, vnFor100);","     assert(vnForFunc2b == vns->VNForFunc(TYP_INT, VNF_Add, vnFor1, vnFor100));","@@ -11823,6 +11823,11 @@ void ValueNumStore::RunTests(Compiler* comp)","     assert(vns->IsVNConstant(vnForFunc2b));","     assert(vns->ConstantValue<int>(vnForFunc2b) == 101);"," ","+    ValueNum array = vns->VNForExpr(nullptr, TYP_REF);","+    ValueNum dim   = vns->VNForIntCon(0);","+    assert(vns->IsVNNeverNegative(vns->VNForFunc(TYP_INT, VNF_MDArrLength, array, dim)));","+    assert(!vns->IsVNNeverNegative(vns->VNForFunc(TYP_INT, VNF_MDArrLowerBound, array, dim)));","+","     // printf(\"Did ValueNumStore::RunTests.\\n\");"," }"," #endif // DEBUG","@@ -13578,6 +13583,16 @@ void Compiler::fgValueNumberTree(GenTree* tree)","                     // An untracked local, and other odd cases.","                     lclFld->gtVNPair.SetBoth(vnStore->VNForExpr(compCurBB, lclFld->TypeGet()));","                 }","+","+                // Treat Span lengths like array lengths: comparisons against them are worth analyzing.","+                if (gtIsSpanLength(tree))","+                {","+                    ValueNum lenVN = vnStore->VNConservativeNormalValue(tree->gtVNPair);","+                    if (!vnStore->IsVNConstant(lenVN))","+                    {","+                        vnStore->SetVNIsCheckedBound(lenVN);","+                    }","+                }","             }","             break;"," ","@@ -13806,6 +13821,16 @@ void Compiler::fgValueNumberTree(GenTree* tree)"," ","                 tree->gtVNPair = vnStore->VNPWithExc(tree->gtVNPair, addrXvnp);","             }","+","+            // Treat Span lengths like array lengths: comparisons against them are worth analyzing.","+            if (gtIsSpanLength(tree))","+            {","+                ValueNum lenVN = vnStore->VNConservativeNormalValue(tree->gtVNPair);","+                if (!vnStore->IsVNConstant(lenVN))","+                {","+                    vnStore->SetVNIsCheckedBound(lenVN);","+                }","+            }","         }","         else if (tree->OperIs(GT_CAST))","         {"],"additions":34,"deletions":9,"truncated":false},{"path":"src/tests/JIT/opt/AssertionPropagation/UnpromotedSpanLength.cs","lines":["@@ -0,0 +1,60 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System;","+using System.Runtime.CompilerServices;","+using Xunit;","+","+public class UnpromotedSpanLength","+{","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static void ExposeSpan(ref ReadOnlySpan<byte> span) { }","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static void ClearSpan(ref ReadOnlySpan<byte> span) => span = default;","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static int GuardExposedSpan(ReadOnlySpan<byte> span, int count)","+    {","+        // CHECK-NOT: ThrowArgumentOutOfRangeException","+        ExposeSpan(ref span);","+        if (count < 0 || count > span.Length)","+            return -1;","+        // Bounds check from Slice(0, count).","+        if ((uint)count > (uint)span.Length)","+            ThrowArgumentOutOfRangeException();","+        return count;","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static int SliceAfterWrite(ReadOnlySpan<byte> span, int count, bool throughCall)","+    {","+        ExposeSpan(ref span);","+        if (count < 0 || count > span.Length)","+            return -1;","+        if (throughCall)","+            ClearSpan(ref span);","+        else","+            span = default;","+        // Bounds check from Slice(0, count).","+        if ((uint)count > (uint)span.Length)","+            ThrowArgumentOutOfRangeException();","+        return count;","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static void ThrowArgumentOutOfRangeException() => throw new ArgumentOutOfRangeException();","+","+    [Fact]","+    public static void TestEntryPoint()","+    {","+        byte[] array = new byte[8];","+        foreach (int count in new[] { int.MinValue, -1, 0, 1, 8, 9, int.MaxValue })","+            Assert.Equal(count >= 0 && count <= 8 ? count : -1, GuardExposedSpan(array, count));","+        foreach (bool throughCall in new[] { false, true })","+        {","+            Assert.Equal(0, SliceAfterWrite(array, 0, throughCall));","+            Assert.Throws<ArgumentOutOfRangeException>(() => SliceAfterWrite(array, 1, throughCall));","+        }","+    }","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"src/tests/JIT/opt/AssertionPropagation/UnpromotedSpanLength.csproj","lines":["@@ -0,0 +1,20 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+  <PropertyGroup>","+    <!-- Needed for CLRTestEnvironmentVariable -->","+    <RequiresProcessIsolation>true</RequiresProcessIsolation>","+  </PropertyGroup>","+  <PropertyGroup>","+    <DebugType>None</DebugType>","+    <Optimize>True</Optimize>","+  </PropertyGroup>","+  <ItemGroup>","+    <Compile Include=\"UnpromotedSpanLength.cs\">","+      <HasDisasmCheck>true</HasDisasmCheck>","+    </Compile>","+    <CLRTestEnvironmentVariable Include=\"DOTNET_TieredCompilation\" Value=\"0\" />","+    <CLRTestEnvironmentVariable Include=\"DOTNET_JITMinOpts\" Value=\"0\" />","+    <!-- Exercise field loads even on ABIs that normally promote the span. -->","+    <CLRTestEnvironmentVariable Include=\"DOTNET_JitNoStructPromotion\" Value=\"1\" />","+    <CLRTestEnvironmentVariable Include=\"DOTNET_JitEnablePhysicalPromotion\" Value=\"0\" />","+  </ItemGroup>","+</Project>",""],"additions":20,"deletions":0,"truncated":false}],"additions":188,"deletions":43,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-25T18:26:10.511097+00:00"}