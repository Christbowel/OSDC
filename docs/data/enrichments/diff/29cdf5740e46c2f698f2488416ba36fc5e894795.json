PNPM_NO_MATURE_MATCHING_VERSION`. With `--fix=update`, the update still follows [`minimumReleaseAgeExcludePrune`](../settings/dependency-resolution.md#minimumreleaseageexcludeprune)."," "," ### --interactive, -i"," ",""],"additions":5,"deletions":1,"truncated":false}],"additions":188,"deletions":44,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-20T17:58:11.568011+00:00"}