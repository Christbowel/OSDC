erable has no update that"," /// fixes it. The run must still fix what it can elsewhere and report the rest"," /// as remaining, rather than failing resolution outright."],"additions":92,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/update.rs","lines":["@@ -392,6 +392,8 @@ pub struct UpdateExplicitGroups {"," "," /// The update's owned inputs, consumed by the install it runs."," pub struct UpdateResources {","+    /// Override how the install handles release-age exclusions for this update.","+    pub policy_excludes: Option<crate::PolicyExcludes>,","     pub tarball_mem_cache: Arc<MemCache>,","     pub http_client_arc: Arc<ThrottledClient>,","     /// Dependency groups the update considers when choosing which direct"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/update/install.rs","lines":["@@ -156,7 +156,7 @@ pub(super) fn update_install<'i>("," ) -> Install<'i, Vec<DependencyGroup>> {","     let dependency_groups = update_dependency_groups(&update, &owned);","     Install {","-        lockfile_policy: update.lockfile_policy(),","+        lockfile_policy: update.lockfile_policy(owned.policy_excludes),","         execution: update_execution(&update),","         resolution: crate::ResolutionInputs {","             update_seed_policy: seed.policy,","@@ -331,18 +331,21 @@ impl UpdateOptions<'_> {","         update_mutation(self.selection.packages, self.version.reaches_past_declared_range())","     }"," ","-    fn lockfile_policy(self) -> crate::InstallLockfilePolicy {","+    fn lockfile_policy(","+        self,","+        policy_excludes: Option<PolicyExcludes>,","+    ) -> crate::InstallLockfilePolicy {","         crate::InstallLockfilePolicy {","             frozen: false,","             prefer_frozen: Some(false),","             ignore_manifest_check: false,","             trust: self.config.trust_lockfile,","             update_checksums: self.version.patches,","-            excludes: if self.ve