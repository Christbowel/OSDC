ce.yaml\");","+    let manifest = fs::read_to_string(&manifest_path).expect(\"read workspace manifest\");","+    assert!(manifest.contains(\"overrides:\"), \"{manifest}\");","+    assert!(manifest.contains(\"existing@1.0.0\"), \"{manifest}\");","+    assert!(!manifest.contains(\"vulnerable@2.0.0\"), \"{manifest}\");","+    assert!(!stdout(&output).contains(\"entries were added to minimumReleaseAgeExclude\"));"," ","     let output = pacquet","         .arg(\"audit\")","@@ -1035,6 +1051,80 @@ fn audit_fix_update_moves_to_a_non_vulnerable_version() {","     drop((root, npmrc_info));"," }"," ","+#[test]","+fn audit_fix_update_skips_adding_release_age_exclusions() {","+    const PKG: &str = \"@pnpm.e2e/bravo-dep\";","+    let CommandTempCwd {","+        workspace, npmrc_info, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+","+    fs::write(","+        workspace.join(\"package.json\"),","+        format!(","+            r#\"{{\"name\":\"audit-no-age-exclusions\",\"version\":\"1.0.0\",\"dependencies\":{{\"{PKG}\":\"~1.0.0\"}}}}\"#,","+        ),","+    )","+    .expect(\"write package.json\");","+","+    // Put the cutoff between the fixture's 1.0.0 and 1.0.1 publish dates.","+    let cutoff: jiff::Timestamp = \"2022-02-10T00:00:00Z\".parse().unwrap();","+    let age =","+        u64::try_from((jiff::Timestamp::now().as_second() - cutoff.as_second()) / 60).unwrap();","+    set_minimum_release_age(&workspace, age);","+    pacquet_cmd(&workspace, [\"install\"]).assert().success();","+","+    let mut audit_registry = mockito::Server::new();","+    let mock = audit_mock(","+        &mut audit_registry,","+        &advisory_response(","+            PKG,","+            9001,","+            \"high\",","+            \"<1.0.1\",","+            \"test vulnerability\",","+            \"GHSA-test-1111-2222\",","+        ),","+    )","+    .expect(2)","+    .create();","+    fs::write(","+        workspace.join(\".npmrc\"),","+        format!(","+         