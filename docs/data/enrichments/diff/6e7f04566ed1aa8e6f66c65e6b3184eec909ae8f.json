{"id":"6e7f04566ed1aa8e6f66c65e6b3184eec909ae8f","axis":"silent","repo":"mongodb/mongo","sha":"6e7f04566ed1aa8e6f66c65e6b3184eec909ae8f","parsed":{"files":[{"path":"src/mongo/db/commands/query_cmd/run_aggregate.cpp","lines":["@@ -29,6 +29,7 @@"," #include \"mongo/db/pipeline/aggregation_hint_translation.h\""," #include \"mongo/db/pipeline/aggregation_request_helper.h\""," #include \"mongo/db/pipeline/change_stream_invalidation_info.h\"","+#include \"mongo/db/pipeline/change_stream_pipeline_helpers.h\""," #include \"mongo/db/pipeline/document_source_exchange.h\""," #include \"mongo/db/pipeline/document_source_geo_near.h\""," #include \"mongo/db/pipeline/document_source_internal_document_results_and_metadata.h\"","@@ -802,6 +803,10 @@ std::vector<std::unique_ptr<PlanExecutor, PlanExecutor::Deleter>> prepareExecuto","         }"," ","         for (auto&& pipelineIt : pipelines) {","+            // Add a top-level error conversion stage if requested, which wraps recoverable","+            // failures as error events and makes them visible in explain.","+            change_stream::pipeline_helpers::addErrorConversionStageIfNeeded(*pipelineIt);","+","             // There are separate ExpressionContexts for each exchange pipeline, so make sure to","             // pass the pipeline's ExpressionContext to the plan executor factory.","             auto pipelineExpCtx = pipelineIt->getContext();"],"additions":5,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/BUILD.bazel","lines":["@@ -1643,6 +1643,7 @@ mongo_cc_unit_test(","     srcs = [","         \"aggregation_request_test.cpp\",","         \"change_stream_convert_errors_stage_test.cpp\",","+        \"change_stream_pipeline_helpers_test.cpp\",","         \"data_to_shards_allocation_query_service_test.cpp\",","         \"dependencies_test.cpp\",","         \"dispatch_shard_pipeline_test.cpp\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/change_stream_convert_errors_stage_test.cpp","lines":["@@ -215,6 +215,21 @@ TEST(ChangeStreamConvertErrorsDocumentSourceTest, SerializesForWire) {","                       BSON(\"$_internalChangeStreamConvertErrors\" << BSONObj()));"," }"," ","+// The stage is injected internally by the change stream pipeline, so it must not affect the query","+// shape of a change stream: shapifying omits it (returns missing), like the other internal","+// change-stream stages.","+TEST(ChangeStreamConvertErrorsDocumentSourceTest, EmptyForQueryShape) {","+    auto expCtx = make_intrusive<ExpressionContextForTest>();","+    auto ds = DocumentSourceChangeStreamConvertErrors::create(expCtx);","+","+    ASSERT_BSONOBJ_EQ(ds->serialize().getDocument().toBson(),","+                      BSON(\"$_internalChangeStreamConvertErrors\" << BSONObj()));","+","+    const auto shapifying = query_shape::SerializationOptions{","+        .literalPolicy = query_shape::LiteralSerializationPolicy::kToRepresentativeParseableValue};","+    ASSERT(ds->serialize(shapifying).missing());","+}","+"," // The stage must be the final stage of the pipeline: an error event is built there, above every"," // user stage, and must never be observed by a user stage below it."," TEST(ChangeStreamConvertErrorsConstraintTest, MustBeFinalStage) {"],"additions":15,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/change_stream_pipeline_helpers.cpp","lines":["@@ -12,6 +12,7 @@"," #include \"mongo/db/pipeline/document_source_change_stream_add_pre_image.h\""," #include \"mongo/db/pipeline/document_source_change_stream_check_invalidate.h\""," #include \"mongo/db/pipeline/document_source_change_stream_check_resumability.h\"","+#include \"mongo/db/pipeline/document_source_change_stream_convert_errors.h\""," #include \"mongo/db/pipeline/document_source_change_stream_end_of_transaction.h\""," #include \"mongo/db/pipeline/document_source_change_stream_ensure_resume_token_present.h\""," #include \"mongo/db/pipeline/document_source_change_stream_gen.h\"","@@ -55,6 +56,23 @@ const StringDataSet kExpectedUserStages = {"," "," }  // namespace"," ","+void addErrorConversionStageIfNeeded(Pipeline& pipeline) {","+    const auto& expCtx = pipeline.getContext();","+    if (!changeStreamShowsErrorsAsEvents(expCtx)) {","+        return;","+    }","+","+    // Idempotent: the stage is added at most once, even if this is called on a pipeline that was","+    // already injected (for example, a pipeline that is re-optimized).","+    const auto& sources = pipeline.getSources();","+    if (!sources.empty() &&","+        sources.back()->isInstanceOf<DocumentSourceChangeStreamConvertErrors>()) {","+        return;","+    }","+","+    pipeline.addFinalSource(DocumentSourceChangeStreamConvertErrors::create(expCtx));","+}","+"," std::vector<BSONObj> buildPipelineForConfigServerV2(","     const boost::intrusive_ptr<ExpressionContext>& expCtx,","     OperationContext* opCtx,"],"additions":18,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/change_stream_pipeline_helpers.h","lines":["@@ -20,8 +20,22 @@"," "," #include <boost/smart_ptr/intrusive_ptr.hpp>"," ","+namespace mongo {","+class Pipeline;","+}  // namespace mongo","+"," namespace mongo::change_stream::pipeline_helpers {"," ","+/**","+ * Adds the top-level error-conversion stage ('$_internalChangeStreamConvertErrors') to an","+ * opted-in ('showErrorsAsEvents: true') change stream pipeline, if it is not already present.","+ *","+ * Must be called after optimization and before the pipeline is frozen, so that the optimizer never","+ * sees the stage while explain still reports it. No-op for non-change-stream pipelines and when the","+ * flag is off, and idempotent if called more than once.","+ */","+void addErrorConversionStageIfNeeded(Pipeline& pipeline);","+"," /**","  * Build a change stream pipeline for the config server, used by v2 change streams.","  */"],"additions":14,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/change_stream_pipeline_helpers_test.cpp","lines":["@@ -0,0 +1,61 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/pipeline/change_stream_pipeline_helpers.h\"","+","+#include \"mongo/db/exec/document_value/document.h\"","+#include \"mongo/db/pipeline/document_source_change_stream_convert_errors.h\"","+#include \"mongo/db/pipeline/document_source_change_stream_gen.h\"","+#include \"mongo/db/pipeline/document_source_mock.h\"","+#include \"mongo/db/pipeline/expression_context.h\"","+#include \"mongo/db/pipeline/expression_context_for_test.h\"","+#include \"mongo/db/pipeline/pipeline.h\"","+#include \"mongo/unittest/unittest.h\"","+","+#include <boost/smart_ptr/intrusive_ptr.hpp>","+","+namespace mongo {","+namespace {","+","+using change_stream::pipeline_helpers::addErrorConversionStageIfNeeded;","+","+// The injection helper appends the conversion stage above every user stage of an opted-in pipeline,","+// is a no-op when the option is off, and does not append a second stage when called twice.","+TEST(ChangeStreamConvertErrorsInjectionTest, AppendsStageOnlyWhenOptedIn) {","+    auto buildPipeline = [](const boost::intrusive_ptr<ExpressionContext>& expCtx) {","+        return Pipeline::create({DocumentSourceMock::createForTest({Document{}}, expCtx)}, expCtx);","+    };","+","+    // Option off: the pipeline is untouched.","+    {","+        auto expCtx = make_intrusive<ExpressionContextForTest>();","+        auto pipeline = buildPipeline(expCtx);","+        addErrorConversionStageIfNeeded(*pipeline);","+        ASSERT_FALSE(pipeline->getSources().empty());","+        ASSERT_FALSE(","+            pipeline->getSources().back()->isInstanceOf<DocumentSourceChangeStreamConvertErrors>());","+    }","+","+    // Option on: the stage is appended above every user stage.","+    {","+        auto expCtx = make_intrusive<ExpressionContextForTest>();","+        DocumentSourceChangeStreamSpec spec;","+        spec.setShowErrorsAsEvents(true);","+        expCtx->setChangeStreamSpec(spec);","+        auto pipeline = buildPipeline(expCtx);","+        addErrorConversionStageIfNeeded(*pipeline);","+        ASSERT_TRUE(","+            pipeline->getSources().back()->isInstanceOf<DocumentSourceChangeStreamConvertErrors>());","+","+        // Idempotent: calling again does not append a second stage.","+        addErrorConversionStageIfNeeded(*pipeline);","+        size_t count = 0;","+        for (const auto& source : pipeline->getSources()) {","+            count += source->isInstanceOf<DocumentSourceChangeStreamConvertErrors>();","+        }","+        ASSERT_EQ(count, 1u);","+    }","+}","+","+}  // namespace","+}  // namespace mongo"],"additions":61,"deletions":0,"truncated":false},{"path":"src/mongo/s/query/planner/cluster_aggregation_planner.cpp","lines":["@@ -838,6 +838,10 @@ ClusterClientCursorGuard buildClusterCursor(OperationContext* opCtx,","         // skip the expensive BSON->Document->BSON conversion.","         return convertPipelineToRouterStages(std::move(pipeline), std::move(cursorParams));","     }","+","+    // Opted-in change streams get a top-level error-conversion stage, above the router's user","+    // stages, so that recoverable failures become error events and are visible in explain.","+    change_stream::pipeline_helpers::addErrorConversionStageIfNeeded(*pipeline);","     return ClusterClientCursorImpl::make(","         opCtx, std::make_unique<RouterStagePipeline>(std::move(pipeline)), std::move(cursorParams));"," }",""],"additions":4,"deletions":0,"truncated":false}],"additions":118,"deletions":0,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-18T16:52:23.218756+00:00"}