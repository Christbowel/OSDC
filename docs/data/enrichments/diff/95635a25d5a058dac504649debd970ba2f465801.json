from less than 3 to 4, as that will corrupt any preexisting DESC","     ** index.","@@ -3045,6 +3048,9 @@ void sqlite3AlterSetNotNull(","   pCons = pFirst->z;","   nCons = alterRtrimFragment(pParse->db, pCons, pParse->sLastToken.z - pCons);"," ","+  /* No concurrent writers of table being changed */","+  sqlite3FailIfConcurrentWriter(pParse, pTab); VdbeCoverage(pParse->pVdbe);","+","   /* Search for a constraint violation. Throw an exception if one is found. */","   sqlite3NestedParse(pParse,","       \"SELECT sqlite_fail('constraint failed', %d) \"","@@ -3166,6 +3172,9 @@ void sqlite3AlterAddConstraint(","     sqlite3DbFree(pParse->db, zName);","   }"," ","+  /* No concurrent writers of the table being changed */","+  sqlite3FailIfConcurrentWriter(pParse, pTab); VdbeCoverage(pParse->pVdbe);","+","   /* Search for a constraint violation. Throw an exception if one is found. */","   sqlite3NestedParse(pParse,","       \"SELECT sqlite_fail('constraint failed', %d) \""],"additions":9,"deletions":0,"truncated":false},{"path":"src/build.c","lines":["@@ -4049,6 +4049,20 @@ int sqlite3HasExplicitNulls(Parse *pParse, ExprList *pList){","   return 0;"," }"," ","+/*","+** Use the OP_NoWriter opcode to cause the current program to abort","+** if there are concurrent writers on the table iRoot of schema iDb.","+**","+** Calls to this routine must be followed by VdbeCoverage(v) in order to","+** measure coverage of the inserted OP_NoWriter opcode.","+*/","+void sqlite3FailIfConcurrentWriter(Parse *pParse, Table *pTab){","+  Vdbe *v = sqlite3GetVdbe(pParse);","+  int iDb = sqlite3SchemaToIndex(pParse->db, pTab->pSchema);","+  assert( v!=0 || pParse->nErr>0 );","+  if( v ) sqlite3VdbeAddOp2(v, OP_NoWriter, (int)pTab->tnum, iDb);","+}","+"," /*"," ** Create a new index for an SQL table.  pName1.pName2 is the name of the index"," ** and pTblList is the name of the table that is to be indexed.  Both will","@@ -4559,6 +4573,7 @@ void sqlite3CreateIndex(","       if( v==0 ) goto exit_create_index;"," ","       sqlite3BeginWriteOperation(pParse, 1, iDb);","+      sqlite3FailIfConcurrentWriter(pParse, pTab); VdbeCoverage(v);"," ","       /* Create the rootpage for the index using CreateIndex. But before","       ** doing so, code a Noop instruction and store its address in"],"additions":15,"deletions":0,"truncated":false},{"path":"src/sqliteInt.h","lines":["@@ -5227,6 +5227,7 @@ void sqlite3ClearOnOrUsing(sqlite3*, OnOrUsing*);"," void sqlite3SrcListDelete(sqlite3*, SrcList*);"," Index *sqlite3AllocateIndexObject(sqlite3*,int,int,char**);"," int sqlite3IndexBloomable(const Index*,int);","+void sqlite3FailIfConcurrentWriter(Parse*,Table*);"," void sqlite3CreateIndex(Parse*,Token*,Token*,SrcList*,ExprList*,int,Token*,","                           Expr*, int, int, u8);"," void sqlite3DropIndex(Parse*, SrcList*, int);"],"additions":1,"deletions":0,"truncated":false},{"path":"src/vdbe.c","lines":["@@ -7207,6 +7207,29 @@ case OP_DbLock: {","   break;"," };"," ","+/* Opcode: NoWriter P1 P2 * * *","+**","+** Raise an SQLITE_LOCKED error if any other statement in the current","+** database connection is currently running and has opened or can","+** potentially open a write cursor on the table at root page P1 of","+** schema P2.","+**","+** Used by DDL statements (ALTER TABLE, CREATE INDEX) to prevent a","+** schema changes from undermining another actively running prepared","+** statement that is writing to the table being modified.","+*/","+case OP_NoWriter: {","+  assert( pOp->p2>=0 && pOp->p2<db->nDb );","+  if( sqlite3VdbeOtherWriter(db, p, (Pgno)pOp->p1, pOp->p2) ){","+    VdbeBranchTaken(1,2);","+    rc = SQLITE_LOCKED;","+    p->errorAction = OE_Abort;","+    goto abort_due_to_error;","+  }","+  VdbeBranchTaken(0,2);","+  break;","+}","+"," /* Opcode: Clear P1 P2 P3"," **"," ** Delete all contents of the database table or index whose root page"],"additions":23,"deletions":0,"truncated":false},{"path":"src/vdbeInt.h","lines":["@@ -695,6 +695,7 @@ int sqlite3VdbeFrameIsValid(VdbeFrame*);"," void sqlite3VdbeFrameMemDel(void*);      /* Destructor on Mem */"," void sqlite3VdbeFrameDelete(VdbeFrame*); /* Actually deletes the Frame */"," int sqlite3VdbeFrameRestore(VdbeFrame *);","+int sqlite3VdbeOtherWriter(sqlite3*, Vdbe*, Pgno, int);"," #ifdef SQLITE_ENABLE_PREUPDATE_HOOK"," void sqlite3VdbePreUpdateHook(","     Vdbe*,VdbeCursor*,int,const char*,Table*,i64,int,int);"],"additions":1,"deletions":0,"truncated":false},{"path":"src/vdbeaux.c","lines":["@@ -1704,7 +1704,7 @@ void sqlite3VdbeNoopComment(Vdbe *p, const char *zFormat, ...){"," ** Set the value if the iSrcLine field for the previously coded instruction."," */"," void sqlite3VdbeSetLineNumber(Vdbe *v, int iLine){","-  sqlite3VdbeGetLastOp(v)->iSrcLine = iLine;","+  if( v ) sqlite3VdbeGetLastOp(v)->iSrcLine = iLine;"," }"," #endif /* SQLITE_VDBE_COVERAGE */"," ","@@ -5316,6 +5316,49 @@ void sqlite3VdbeCountChanges(Vdbe *v){","   v->changeCntOn = 1;"," }"," ","+/*","+** Return true if the aOp[0..nOp-1] program contains an OP_OpenWrite that","+** opens a write cursor on the table with root page iRoot in database iDb.","+*/","+static int vdbeProgramOpensWriter(Op *aOp, int nOp, Pgno iRoot, int iDb){","+  int i;","+  for(i=0; i<nOp; i++){","+    Op *pOp = &aOp[i];","+    if( pOp->opcode==OP_OpenWrite","+     && (pOp->p5 & OPFLAG_P2ISREG)==0","+     && pOp->p3==iDb","+     && pOp->p2==(int)iRoot","+    ){","+      return 1;","+    }","+  }","+  return 0;","+}","+","+/*","+** Return true if some statement of database connection db other than","+** pExcept is currently running and might write the table with root page","+** iRoot in database iDb.  The test looks at the bytecode of each running","+** statement and of all of its trigger sub-programs.","+*/","+SQLITE_NOINLINE int sqlite3VdbeOtherWriter(","+  sqlite3 *db,       /* Database connection to scan */","+  Vdbe *pExcept,     /* Disregard this particular prepared statement */","+  Pgno iRoot,        /* Look for cursors on this root page... */","+  int iDb            /* ... of this schema */","+){","+  Vdbe *p;","+  for(p=db->pVdbe; p; p=p->pVNext){","+    SubProgram *pSub;","+    if( p==pExcept || p->eVdbeState!=VDBE_RUN_STATE || p->readOnly ) continue;","+    if( vdbeProgramOpensWriter(p->aOp, p->nOp, iRoot, iDb) ) return 1;","+    for(pSub=p->pProgram; pSub; pSub=pSub->pNext){","+      if( vdbeProgramOpensWriter(pSub->aOp, pSub->nOp, iRoot, iDb) ) return 1;","+    }","+  }","+  return 0;","+}","+"," /*"," ** Mark every prepared statement associated with a database connection"," ** as expired."],"additions":44,"deletions":1,"truncated":false},{"path":"test/incrblob3.test","lines":["@@ -346,5 +346,32 @@ do_test 9.5 {","        [catch { db incrblob t3 z 1 } msg] $msg"," } {1 {cannot open indexed column for writing} 1 {cannot open indexed column for writing}}"," ","+# CREATE INDEX must fail while an incremental BLOB write handle is open on","+# the table, since the handle would write the column without updating the","+# new index.  A read-only handle is not a problem.","+#","+do_test 10.1 {","+  execsql {","+    CREATE TABLE t4(a INTEGER PRIMARY KEY, b, c);","+    INSERT INTO t4 VALUES(1, zeroblob(10), 'one');","+  }","+  set ::blob [db incrblob t4 b 1]","+  list [catch { execsql { CREATE INDEX t4b ON t4(b) } } msg] $msg","+} {1 {database table is locked}}","+do_test 10.2 {","+  puts -nonewline $::blob 0123456789","+  close $::blob","+  execsql { CREATE UNIQUE INDEX t4b ON t4(b); PRAGMA integrity_check }","+} {ok}","+do_test 10.3 {","+  set ::blob [db incrblob -readonly t4 c 1]","+  execsql { CREATE INDEX t4c ON t4(c) }","+  read $::blob","+} {one}","+do_test 10.4 {","+  close $::blob","+  execsql { PRAGMA integrity_check }","+} {ok}","+"," db close"," finish_test"],"additions":27,"deletions":0,"truncated":false},{"path":"test/misc03.sql","lines":["@@ -983,57 +983,109 @@ SELECT count(*) FROM ("," );"," .check 3"," ","-# Bug 2026-11-23T05:50:38Z sqlite.org/bugs/info/15e8d2bde51