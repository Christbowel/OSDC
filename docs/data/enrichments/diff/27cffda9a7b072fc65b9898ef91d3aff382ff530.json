{"id":"27cffda9a7b072fc65b9898ef91d3aff382ff530","axis":"silent","repo":"hashicorp/consul","sha":"27cffda9a7b072fc65b9898ef91d3aff382ff530","parsed":{"files":[{"path":".changelog/24062.txt","lines":["@@ -0,0 +1,15 @@","+```release-note:bug","+acl: Fixed Envoy escape-hatch key matching in `Proxy.Config` and per-upstream config so it follows the same case-folding rules as the config decoders. Keys that differ only by Unicode case folding (for example `envoy_local_cluſter_json`), and Go field-name forms such as `EnvoyListenerJSON`, now require `mesh:write` like their canonical spellings.","+```","+```release-note:breaking-change","+agent: Agent HTTP API request bodies are now limited to 512 KiB by default, including chunked requests and requests with an unsupported method, and oversized requests return HTTP 413 before the body is read in full. Very large `/v1/config` writes that previously succeeded can now fail. Raise the limit with the new `limits.http_max_request_body_size` setting if needed.","+```","+```release-note:breaking-change","+agent: Resource API (`/api/...`) request bodies are now subject to the same `limits.http_max_request_body_size` limit (512 KiB by default), and oversized requests return HTTP 413.","+```","+```release-note:bug","+agent: Fixed `PUT /v1/kv/` so chunked request bodies are bounded by `kv_max_value_size`, matching the existing `Content-Length` check.","+```","+```release-note:breaking-change","+catalog: `Catalog.Register` now requires write permission on the node or service of an existing health check when updating it. Tokens that previously updated checks without that permission now receive a permission denied error.","+```"],"additions":15,"deletions":0,"truncated":false},{"path":"agent/acl_endpoint_test.go","lines":["@@ -1491,6 +1491,41 @@ func TestACL_LoginProcedure_HTTP(t *testing.T) {"," "," \ttestrpc.WaitForLeader(t, a.RPC, \"dc1\")"," ","+\tt.Run(\"oversized request bodies are rejected before decode\", func(t *testing.T) {","+\t\ttests := []struct {","+\t\t\tname    string","+\t\t\tmethod  string","+\t\t\tpath    string","+\t\t\tchunked bool","+\t\t}{","+\t\t\t{name: \"anonymous login with content length\", method: http.MethodPost, path: \"/v1/acl/login\"},","+\t\t\t{name: \"anonymous login chunked\", method: http.MethodPost, path: \"/v1/acl/login\", chunked: true},","+\t\t\t{name: \"anonymous bootstrap\", method: http.MethodPut, path: \"/v1/acl/bootstrap\"},","+\t\t\t{name: \"generic config map chunked\", method: http.MethodPut, path: \"/v1/config\", chunked: true},","+\t\t\t{name: \"generic discovery map chunked\", method: http.MethodPost, path: \"/v1/discovery-chain/db\", chunked: true},","+\t\t\t{name: \"wrong method body\", method: http.MethodPut, path: \"/v1/agent/self\"},","+\t\t\t{name: \"resource api content length\", method: http.MethodPut, path: \"/api/demo/v2/artist/foo\"},","+\t\t\t{name: \"chunked kv\", method: http.MethodPut, path: \"/v1/kv/foo\", chunked: true},","+\t\t\t{name: \"encoded chunked kv\", method: http.MethodPut, path: \"/v1/k%76/foo\", chunked: true},","+\t\t\t{name: \"chunked transaction\", method: http.MethodPut, path: \"/v1/txn\", chunked: true},","+\t\t}","+\t\tfor _, tc := range tests {","+\t\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\t\tbody := bytes.NewReader(bytes.Repeat([]byte(\" \"), maxRequestBodyBytes+1))","+\t\t\t\treq, err := http.NewRequest(tc.method, tc.path, body)","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tif tc.chunked {","+\t\t\t\t\treq.ContentLength = -1","+\t\t\t\t\treq.TransferEncoding = []string{\"chunked\"}","+\t\t\t\t}","+","+\t\t\t\tresp := httptest.NewRecorder()","+\t\t\t\ta.srv.h.ServeHTTP(resp, req)","+\t\t\t\trequire.Equal(t, http.StatusRequestEntityTooLarge, resp.Code)","+\t\t\t})","+\t\t}","+\t})","+"," \tidMap := make(map[string]string)"," \tmethodMap := make(map[string]*structs.ACLAuthMethod)"," \truleMap := make(map[string]*structs.ACLBindingRule)","@@ -2043,6 +2078,19 @@ func TestACL_LoginProcedure_HTTP(t *testing.T) {"," \t})"," }"," ","+func TestHTTPMaxRequestBodySizeConfigurable(t *testing.T) {","+\tconst configuredLimit = 700 * 1024","+\ta := NewTestAgent(t, fmt.Sprintf(\"limits { http_max_request_body_size = %d }\", configuredLimit))","+\tdefer a.Shutdown()","+","+\tbody := bytes.NewReader(bytes.Repeat([]byte(\" \"), 600*1024))","+\treq, err := http.NewRequest(http.MethodPut, \"/v1/config\", body)","+\trequire.NoError(t, err)","+\tresp := httptest.NewRecorder()","+\ta.srv.h.ServeHTTP(resp, req)","+\trequire.NotEqual(t, http.StatusRequestEntityTooLarge, resp.Code)","+}","+"," func TestACLEndpoint_LoginLogout_jwt(t *testing.T) {"," \tif testing.Short() {"," \t\tt.Skip(\"too slow for testing.Short\")"],"additions":48,"deletions":0,"truncated":false},{"path":"agent/acl_test.go","lines":["@@ -10,10 +10,10 @@ import ("," \t\"testing\""," \t\"time\""," ","-\t\"github.com/hashicorp/go-metrics\""," \t\"github.com/stretchr/testify/require\""," "," \t\"github.com/hashicorp/go-hclog\"","+\t\"github.com/hashicorp/go-metrics\""," \t\"github.com/hashicorp/serf/serf\""," "," \t\"github.com/hashicorp/consul/acl\"","@@ -393,9 +393,25 @@ func TestACL_vetServiceRegister_bootstrapEscapeHatch_Upstream(t *testing.T) {"," \tauthzServiceOnly := newAuthz(t, `service_prefix \"\" { policy = \"write\" }`)"," \tauthzWithMesh := newAuthz(t, `service_prefix \"\" { policy = \"write\" } mesh = \"write\"`)"," ","-\tfor _, key := range []string{\"envoy_listener_json\", \"envoy_cluster_json\"} {","+\tfor _, key := range []string{","+\t\t\"envoy_listener_json\",","+\t\t\"envoy_cluster_json\",","+\t\t\"EnvoyListenerJSON\",","+\t\t\"ENVOYLISTENERJSON\",","+\t\t\"EnvoyClusterJSON\",","+\t\t\"ENVOYCLUSTERJSON\",","+\t} {"," \t\tkey := key"," \t\tt.Run(key, func(t *testing.T) {","+\t\t\tdecoded, decodeErr := structs.ParseUpstreamConfigNoDefaults(map[string]interface{}{key: `{}`})","+\t\t\trequire.NoError(t, decodeErr)","+\t\t\tswitch key {","+\t\t\tcase \"envoy_listener_json\", \"EnvoyListenerJSON\", \"ENVOYLISTENERJSO