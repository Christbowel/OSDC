ires_grad=False)","@@ -1542,3 +1550,68 @@ def test_online_quantize_reload(","         mul_perp = llm.generate_prompt_perplexity([\"3 4 = 12\"], mask=[\"3 4 =\"])[0]","         add_perp = llm.generate_prompt_perplexity([\"3 4 = 7\"], mask=[\"3 4 =\"])[0]","         assert add_perp < mul_perp","+","+","+class _TwoLayerModel(torch.nn.Module):","+    def __init__(self) -> None:","+        super().__init__()","+        self.a = torch.nn.Linear(2, 2, bias=False)","+        self.b = torch.nn.Linear(2, 2, bias=False)","+        self.hook_saw: list[tuple[float, float]] = []","+","+    def load_weights(self, weights) -> set[str]:","+        params = dict(self.named_parameters())","+        loaded = set()","+        for name, tensor in weights:","+            param = params[name]","+            getattr(param, \"weight_loader\", default_weight_loader)(param, tensor)","+            loaded.add(name)","+        return loaded","+","+    def process_weights_after_loading(self) -> None:","+        a, b = self.a.weight.mean().item(), self.b.weight.mean().item()","+        self.hook_saw.append((a, b))","+","+","+def _full(value: float) -> torch.Tensor:","+    return torch.full((2, 2), value)","+","+","+def _loaded_model() -> _TwoLayerModel:","+    model = _TwoLayerModel()","+    model.load_weights([(\"a.weight\", _full(1.0)), (\"b.weight\", _full(2.0))])","+    return model","+","+","+class TestModelHookOnSplitLoad:","+    def test_layerwise_reload(self):","+        model = _loaded_model()","+        record_metadata_for_reloading(model)","+        config = SimpleNamespace(dtype=torch.float32)","+","+        initialize_layerwise_reload(model)","+        model.load_weights([(\"a.weight\", _full(3.0))])","+        model.load_weights([(\"b.weight\", _full(4.0))])","+        assert model.hook_saw == []","+        finalize_layerwise_reload(model, config)","+        assert model.hook_saw == [(3.0, 4.0)]","+","+        # Partial update: the untouched layer is restored before the hook runs.","+        initialize_layerwise_reload(model)","+        model.load_weights([(\"a.weight\", _full(5.0))])","+        finalize_layerwise_reload(model, config)","+        assert model.hook_saw == [(3.0, 4.0), (5.0, 4.0)]","+","+    def test_sparse_update(self):","+        model = _loaded_model()","+        engine = object.__new__(SparseNCCLWeightTransferEngine)","+        engine.model = model","+","+        engine.start_weight_update()","+        for name, value in ((\"a.weight\", 5.0), (\"b.weight\", 6.0)):","+            values, indices = torch.full((4,), value), torch.arange(4)","+            patch = CheckpointWeightPatch(name, (2, 2), torch.float32, values, indices)","+            load_checkpoint_weight_patches(model, [patch])","+        assert model.hook_saw == []","+        engine.finish_weight_update()","+        assert model.hook_saw == [(5.0, 6.0)]"],"additions":73,"deletions":0,"truncated":false},{"path":"tests/models/test_deepseek_v4_vl.py","lines":["@@ -0,0 +1,69 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"VL wrapper finalization contract with the language model.\"\"\"","+","+import importlib","+","+import pytest","+import torch","+from torch import nn","+","+from vllm.model_executor.models.utils import WeightsMapper","+","+","+class _FakeLanguageModel(nn.Module):","+    def __init__(self) -> None:","+        super().__init__()","+        self.tensor_a = nn.Parameter(torch.zeros(1))","+        self.tensor_c = nn.Parameter(torch.zeros(1))","+        self.finalized_values: list[tuple[float, float]] = []","+","+    def process_weights_after_loading(self) -> None:","+        self.finalized_values.append((self.tensor_a.item(), self.tensor_c.item()))","+","+","+@pytest.mark.parametrize(","+    \"module,cls_name\",","+    [","+        (","+            \"vllm.models.deepseek_v4.common.vl_model\",","+            \"DeepseekV4ForConditionalGeneration\",","+        ),","+        (\"vllm.models.deepseek_v41.nvidia.vl_model\", \"DeepseekV41ForCausalLM\"),","+        (\"vllm.models.deepseek_v41.amd.vl_model\", \"DeepseekV41ForCausalLM\"),","+    ],","+    ids=[\"v4\", \"v41-nvidia\", \"v41-amd\"],","+)","+def test_vl_wrapper_delegates_finalization_to_hook(module, cls_name) -> None:","+    wrapper_cls = getattr(importlib.import_module(module), cls_name)","+","+    model = object.__new__(wrapper_cls)","+    nn.Module.__init__(model)","+    model.language_model = _FakeLanguageModel()","+    model.vision = nn.Module()","+    model.vision.tensor_b = nn.Parameter(torch.zeros(1))","+    model.hf_to_vllm_mapper = WeightsMapper()","+","+    def interleaved_weights():","+        yield \"language_model.tensor_a\", torch.tensor([1.0])","+        assert model.language_model.tensor_a.item() == 1.0","+        yield \"vision.tensor_b\", torch.tensor([2.0])","+        assert model.vision.tensor_b.item() == 2.0","+        yield \"language_model.tensor_c\", torch.tensor([3.0])","+","+    loaded = model.load_weights(interleaved_weights())","+","+    assert loaded == {","+        \"language_model.tensor_a\",","+        \"vision.tensor_b\",","+        \"language_model.tensor_c\",","+    }","+    assert model.language_model.finalized_values == []","+","+    model.process_weights_after_loading()","+","+    assert model.language_model.finalized_values == [(1.0, 3.0)]","+","+    # A reload reruns the hook: no one-shot guard may skip it.","+    model.process_weights_after_loading()","+    assert model.language_model.finalized_values == [(1.0, 3.0)] * 2"],"additions":69,"deletions":0,"truncated":false},{"path":"tests/models/test_deepseek_v4_vl_rocm.py","lines":["@@ -8,7 +8,6 @@"," from torch import nn"," "," from vllm.config import KernelConfig, ParallelConfig","-from vllm.model_executor.models.utils import WeightsMapper"," from vllm.platforms import current_platform"," "," pytestmark = pytest.mark.skipif(","@@ -408,127 +407,3 @@ def logits_processor("," ","     assert torch.equal(r