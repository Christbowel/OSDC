{"id":"4c05cd59e537e13b9ba0808d8919ddcda234550d","axis":"silent","repo":"mongodb/mongo","sha":"4c05cd59e537e13b9ba0808d8919ddcda234550d","parsed":{"files":[{"path":"jstests/core/query/OWNERS.yml","lines":["@@ -18,6 +18,9 @@ filters:","   - \"write_change_stream_pit_preimage.js\":","     approvers:","       - 10gen/query-execution-change-streams","+  - \"persistent_stats_config_in_create_and_collmod.js\":","+    approvers:","+      - 10gen/query-optimization-persistent-stats","   - \"release_memory/*\":","     approvers:","       - 10gen/query-execution"],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/core/query/persistent_stats_config_in_create_and_collmod.js","lines":["@@ -0,0 +1,175 @@","+/**","+ * Tests the 'persistentStatsConfig' collection option on both 'create' and 'collMod'. The option","+ * configures the persistent statistics collected for a collection, which are used by the cost-based","+ * ranker and the join optimizer.","+ *","+ * @tags: [","+ *   # TODO(SERVER-138605): Remove once persistentStatsConfig is stripped from collection options on","+ *   # FCV downgrade.","+ *   cannot_run_during_upgrade_downgrade,","+ *   featureFlagPersistentStatsCatalog,","+ * ]","+ */","+import {afterEach, beforeEach, describe, it} from \"jstests/libs/mochalite.js\";","+import {assertDropCollection} from \"jstests/libs/collection_drop_recreate.js\";","+import {readPersistentStatsConfig} from \"jstests/libs/query/persistent_samples_utils.js\";","+","+const collName = jsTestName();","+","+const createWithConfig = (config) => db.createCollection(collName, {persistentStatsConfig: config});","+const collModWithConfig = (config) =>","+    db.runCommand({collMod: collName, persistentStatsConfig: config});","+","+describe(\"persistentStatsConfig on create\", function () {","+    beforeEach(function () {","+        assertDropCollection(db, collName);","+    });","+","+    afterEach(function () {","+        assertDropCollection(db, collName);","+    });","+","+    it(\"persists the configuration\", function () {","+        const config = {samples: {sampleSize: 1000, joinSampleSize: 2000}};","+        assert.commandWorked(createWithConfig(config));","+        assert.docEq(readPersistentStatsConfig(db, collName), config);","+    });","+","+    it(\"persists a single sample size\", function () {","+        const config = {samples: {joinSampleSize: 500}};","+        assert.commandWorked(createWithConfig(config));","+        assert.docEq(readPersistentStatsConfig(db, collName), config);","+    });","+","+    it(\"rejects an empty configuration\", function () {","+        assert.commandFailedWithCode(createWithConfig({}), ErrorCodes.InvalidOptions);","+        assert.commandFailedWithCode(createWithConfig({samples: {}}), ErrorCodes.InvalidOptions);","+    });","+","+    it(\"rejects non-positive sample sizes\", function () {","+        assert.commandFailedWithCode(","+            createWithConfig({samples: {sampleSize: 0}}),","+            ErrorCodes.BadValue,","+        );","+        assert.commandFailedWithCode(","+            createWithConfig({samples: {joinSampleSize: -1}}),","+            ErrorCodes.BadValue,","+        );","+    });","+","+    it(\"rejects unknown fields\", function () {","+        assert.commandFailedWithCode(","+            createWithConfig({samples: {sampleSize: 100, unknownField: 1}}),","+            ErrorCodes.IDLUnknownField,","+        );","+    });","+});","+","+describe(\"persistentStatsConfig on collMod\", function () {","+    beforeEach(function () {","+        assertDropCollection(db, collName);","+        assert.commandWorked(db.createCollection(collName));","+    });","+","+    afterEach(function () {","+        assertDropCollection(db, collName);","+    });","+","+    it(\"persists the configuration\", function () {","+        const config = {samples: {sampleSize: 1000, joinSampleSize: 2000}};","+        assert.commandWorked(collModWithConfig(config));","+        assert.docEq(readPersistentStatsConfig(db, collName), config);","+    });","+","+    it(\"updates a sample size without changing the other\", function () {","+        assert.commandWorked(","+            collModWithConfig({samples: {sampleSize: 1000, joinSampleSize: 2000}}),","+        );","+        assert.commandWorked(collModWithConfig({samples: {sampleSize: 384}}));","+        assert.docEq(readPersistentStatsConfig(db, collName), {","+            samples: {sampleSize: 384, joinSampleSize: 2000},","+        });","+    });","+","+    it(\"removes a sample size without changing the other\", function () {","+        assert.commandWorked(","+            collModWithConfig({samples: {sampleSize: 1000, joinSampleSize: 2000}}),","+        );","+        assert.commandWorked(collModWithConfig({samples: {sampleSize: null}}));","+        assert.docEq(readPersistentStatsConfig(db, collName), {samples: {joinSampleSize: 2000}});","+    });","+","+    it(\"removes a sample size that is not set\", function () {","+        assert.commandWorked(collModWithConfig({samples: {joinSampleSize: 2000}}));","+        assert.commandWorked(collModWithConfig({samples: {sampleSize: null}}));","+        assert.docEq(readPersistentStatsConfig(db, collName), {samples: {joinSampleSize: 2000}});","+    });","+","+    it(\"unsets the configuration when the last sample size is removed\", function () {","+        assert.commandWorked(","+            collModWithConfig({samples: {sampleSize: 1000, joinSampleSize: 2000}}),","+        );","+        assert.commandWorked(","+            collModWithConfig({samples: {sampleSize: null, joinSampleSize: null}}),","+        );","+        assert.eq(readPersistentStatsConfig(db, collName), undefined);","+    });","+","+    it(\"rejects a delta that specifies no sample size\", function () {","+        assert.commandFailedWithCode(collModWithConfig({}), ErrorCodes.InvalidOptions);","+        assert.commandFailedWithCode(collModWithConfig({samples: {}}), ErrorCodes.InvalidOptions);","+    });","+","+    it(\"rejects non-positive sample sizes\", function () {","+        assert.commandFailedWithCode(","+            collModWithConfig({samples: {sampleSize: 0}}),","+            ErrorCodes.BadValue,","+        );","+        assert.commandFailedWithCode(","+            collModWithConfig({samples: {joinSampleSize: -1}}),","+            ErrorCodes.BadValue,","+        );","+    });","+","+    it(\"rejects unknown fields\", function () {","+        assert.commandFailedWithCode(","+            collModWithConfig({samples: {sampleSize: 100, unknownField: 1}}),","+            ErrorCodes.IDLUnknownField,","+        );","+    });","+});","+","+describe(\"persistentStatsConfig on views\", function () {","+    const backingName = collName + \"_backing\";","+    const viewName = collName + \"_view\";","+","+    beforeEach(function () {","+        assertDropCollection(db, viewName);","+        assertDropCollection(db, backingName);","+    });","+","+    afterEach(function () {","+        assertDropCollection(db, viewName);","+        assertDropCollection(db, backingName);","+    });","+","+    it(\"is not supported on create\", function () {","+        assert.commandFailedWithCode(","+            db.createCollection(viewName, {","+                viewOn: backingName,","+                pipeline: [],","+                persistentStatsConfig: {samples: {sampleSize: 100}},","+            }),","+            ErrorCodes.InvalidOptions,","+        );","+    });","+","+    it(\"is not supported on collMod\", function () {","+        assert.commandWorked(db.createCollection(backingName));","+        assert.commandWorked(db.createView(viewName, backingName, []));","+        assert.commandFailedWithCode(","+            db.runCommand({collMod: viewName, persistentStatsConfig: {samples: {sampleSize: 100}}}),","+            ErrorCodes.InvalidOptions,","+        );","+    });","+});"],"additions":175,"deletions":0,"truncated":false},{"path":"jstests/libs/query/OWNERS.yml","lines":["@@ -42,3 +42,6 @@ filters:","   - \"proactive_view_resolution_util.js\":","     approvers:","       - 10gen/query-integration-search","+  - \"persistent_samples_utils.js\":","+    approvers:","+      - 10gen/query-optimization-persistent-stats"],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/libs/query/persistent_samples_utils.js","lines":["@@ -160,6 +160,12 @@ export function getCollUUID(db, collName) {","     return extractUUIDFromObject(db.getCollectionInfos({name: collName})[0].info.uuid);"," }"," ","+// Returns the 'persistentStatsConfig' collection option of a collection, or undefined when the","+// collection has no such option set.","+export function readPersistentStatsConfig(db, collName) {","+    return db.getCollectionInfos({name: collName}).at(0)?.options?.persistentStatsConfig;","+}","+"," export function getSamplesColl(db) {","     return db[samplesCollName];"," }"],"additions":6,"deletions":0,"truncated":false},{"path":"jstests/sharding/OWNERS.yml","lines":["@@ -239,3 +239,6 @@ filters:","   - \"fcv_suite_selftest.js\":","     approvers:","       - 10gen/server-catalog-and-routing-routing-and-topology","+  - \"persistent_stats_config_sharded_collections.js\":","+    approvers:","+      - 10gen/query-optimization-persistent-stats"],"additions":3,"deletions":0,"truncated":false},{"path":"jstests/sharding/persistent_stats_config_sharded_collections.js","lines":["@@ -0,0 +1,137 @@","+/**","+ * Tests that the 'persistentStatsConfig' collection option is kept when a collection is sharded,","+ * when its chunks are migrated to another shard and when it is resharded.","+ *","+ * @tags: [","+ *   featureFlagPersistentStatsCatalog,","+ * ]","+ */","+import {after, before, describe, it} from \"jstests/libs/mochalite.js\";","+import {readPersistentStatsConfig} from \"jstests/libs/query/persistent_samples_utils.js\";","+import {ShardingTest} from \"jstests/libs/shardingtest.js\";","+","+const dbName = jsTestName();","+const config = {samples: {sampleSize: 100, joinSampleSize: 200}};","+","+describe(\"persistentStatsConfig on a sharded cluster\", function () {","+    before(function () {","+        this.st = new ShardingTest({","+            shards: 2,","+            other: {","+                configOptions: {setParameter: {reshardingMinimumOperationDurationMillis: 0}},","+                rsOptions: {setParameter: {reshardingMinimumOperationDurationMillis: 0}},","+            },","+        });","+        assert.commandWorked(","+            this.st.s.adminCommand({","+                enableSharding: dbName,","+                primaryShard: this.st.shard0.shardName,","+            }),","+        );","+        this.db = this.st.s.getDB(dbName);","+","+        this.configOnShards = (collName) =>","+            [this.st.rs0, this.st.rs1].map((rs) =>","+                readPersistentStatsConfig(rs.getPrimary().getDB(dbName), collName),","+            );","+","+        // Shards the collection on '_id' and leaves one chunk on each shard.","+        this.shardAndSplit = (collName) => {","+            const ns = dbName + \".\" + collName;","+            assert.commandWorked(","+                this.db[collName].insert([","+                    {_id: -5, x: 1},","+                    {_id: 5, x: 2},","+                ]),","+            );","+            assert.commandWorked(this.st.s.adminCommand({shardCollection: ns, key: {_id: 1}}));","+            assert.commandWorked(this.st.s.adminCommand({split: ns, middle: {_id: 0}}));","+            assert.commandWorked(","+                this.st.s.adminCommand({","+                    moveChunk: ns,","+                    find: {_id: 5},","+                    to: this.st.shard1.shardName,","+                    _waitForDelete: true,","+                }),","+            );","+        };","+    });","+","+    after(function () {","+        this.st.stop();","+    });","+","+    it(\"is kept when a collection that was modified is sharded and a chunk is moved\", function () {","+        const collName = \"collMod\";","+        assert.commandWorked(this.db.createCollection(collName));","+        assert.commandWorked(","+            this.db.runCommand({collMod: collName, persistentStatsConfig: config}),","+        );","+        assert.docEq(readPersistentStatsConfig(this.db, collName), config);","+","+        this.shardAndSplit(collName);","+","+        assert.docEq(this.configOnShards(collName), [config, config]);","+        assert.docEq(readPersistentStatsConfig(this.db, collName), config);","+    });","+","+    it(\"is kept when a collection created with it is sharded and a chunk is moved\", function () {","+        const collName = \"create\";","+        assert.commandWorked(this.db.createCollection(collName, {persistentStatsConfig: config}));","+        assert.docEq(readPersistentStatsConfig(this.db, collName), config);","+","+        this.shardAndSplit(collName);","+","+        assert.docEq(this.configOnShards(collName), [config, config]);","+    });","+","+    it(\"applies a collMod delta on every shard of a sharded collection\", function () {","+        const collName = \"collMod\";","+        assert.commandWorked(","+            this.db.runCommand({","+                collMod: collName,","+                persistentStatsConfig: {samples: {sampleSize: null}},","+            }),","+        );","+","+        const expected = {samples: {joinSampleSize: 200}};","+        assert.docEq(this.configOnShards(collName), [expected, expected]);","+        assert.docEq(readPersistentStatsConfig(this.db, collName), expected);","+    });","+","+    it(\"is not applied by shardCollection on a non-existing namespace\", function () {","+        const collName = \"shardCollection\";","+        assert.commandWorked(","+            this.st.s.adminCommand({","+                shardCollection: dbName + \".\" + collName,","+                key: {_id: 1},","+                persistentStatsConfig: config,","+            }),","+        );","+        assert.eq(undefined, readPersistentStatsConfig(this.db, collName));","+    });","+","+    it(\"is kept when the collection is resharded\", function () {","+        const collName = \"create\";","+        assert.commandWorked(","+            this.st.s.adminCommand({","+                reshardCollection: dbName + \".\" + collName,","+                key: {x: 1},","+                numInitialChunks: 2,","+            }),","+        );","+","+        // Resharding may leave a shard without any chunk, in which case it no longer has the","+        // collection. Every shard that does have it must keep the option.","+        const infos = [this.st.rs0, this.st.rs1].flatMap((rs) =>","+            rs.getPrimary().getDB(dbName).getCollectionInfos({name: collName}),","+        );","+        assert.gte(infos.length, 1, \"expected at least one shard to own the collection\");","+        for (const info of infos) {","+            assert.docEq(info.options.persistentStatsConfig, config, \"shard lost the option\", {","+                info,","+            });","+        }","+        assert.docEq(readPersistentStatsConfig(this.db, collName), config);","+    });","+});"],"additions":137,"deletions":0,"truncated":false},{"path":"src/mongo/db/global_catalog/ddl/create_collection_coordinator.cpp","lines":["@@ -215,6 +215,7 @@ CreateCommand makeCreateCommand(OperationContext* opCtx,","     }","     createRequest.setEncryptedFields(request.getEncryptedFields());","     createRequest.setChangeStreamPreAndPostImages(request.getChangeStreamPreAndPostImages());","+    createRequest.setPersistentStatsConfig(request.getPersistentStatsConfig());","     createRequest.setMax(request.getMax());","     createRequest.setFlags(request.getFlags());","     createRequest.setTemp(request.getTemp());"],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/global_catalog/ddl/sharded_ddl_commands.idl","lines":["@@ -259,6 +259,13 @@ structs:","                 description: \"The options for point-in-time pre- and post-images in change streams opened on this collection.\"","                 type: ChangeStreamPreAndPostImagesOptions","                 optional: true","+            persistentStatsConfig:","+                description: >-","+                    The configuration for the persistent statistics collected for this collection,","+                    used by the cost-based ranker and the join optimizer.","+                type: PersistentStatsConfig","+                optional: true","+                stability: unstable","             timeseries:","                 description: \"The options to create the time-series collection with.\"","                 type: TimeseriesOptions"],"additions":7,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/BUILD.bazel","lines":["@@ -35,6 +35,7 @@ mongo_cc_library(","     ],","     deps = [","         \"//src/mongo/db:server_base\",","+        \"//src/mongo/db:server_feature_flags\",","         \"//src/mongo/db/query:query_knobs\",","     ],"," )","@@ -59,6 +60,7 @@ mongo_cc_unit_test(","     tags = [\"mongo_unittest_sixth_group\"],","     deps = [","         \":persistent_stats_config\",","+        \"//src/mongo/db:server_base\",","         \"//src/mongo/db:service_context_test_fixture\",","         \"//src/mongo/unittest\",","         \"//src/mongo/unittest:server_parameter_guard\","],"additions":2,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation.cpp","lines":["@@ -4,16 +4,15 @@"," #include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation.h\""," "," #include \"mongo/base/error_codes.h\"","-#include \"mongo/db/query/query_feature_flags_gen.h\"","-#include \"mongo/db/server_options.h\"","+#include \"mongo/db/server_feature_flags_gen.h\""," #include \"mongo/db/version_context.h\""," "," namespace mongo {"," "," Status validatePersistentStatsConfigIsApplicable(OperationContext* opCtx, bool isView) {","-    if (!feature_flags::gFeatureFlagPersistentStats.isEnabled(","-            VersionContext::getDecoration(opCtx),","-            serverGlobalParams.featureCompatibility.acquireFCVSnapshot())) {","+    // The DDL flag is operation_fcv_only: it is checked against the operation's pinned FCV so that","+    // create/collMod behave consistently even if a setFCV interleaves with their execution.","+    if (!gFeatureFlagPersistentStatsCatalog.isEnabled(VersionContext::getDecoration(opCtx))) {","         return {ErrorCodes::InvalidOptions, \"unknown option: persistentStatsConfig\"};","     }"," "],"additions":4,"deletions":5,"truncated":false},{"path":"src/mongo/db/query/compiler/ce/persistence/persistent_stats_config_validation_test.cpp","lines":["@@ -6,6 +6,7 @@"," #include \"mongo/bson/json.h\""," #include \"mongo/db/query/compiler/ce/persistence/persistent_stats_config_gen.h\""," #include \"mongo/db/service_context_test_fixture.h\"","+#include \"mongo/db/version_context.h\""," #include \"mongo/idl/idl_parser.h\""," #include \"mongo/unittest/server_parameter_guard.h\""," #include \"mongo/unittest/unittest.h\"","@@ -37,8 +38,10 @@ class PersistentStatsConfigValidationTest : public ServiceContextTest {"," public:","     void setUp() override {","         ServiceContextTest::setUp();","-        _featureFlag.emplace(\"featureFlagPersistentStats\", kFeatureFlagEnabled);","+        _featureFlag.emplace(\"featureFlagPersistentStatsCatalog\", kFeatureFlagEnabled);","         _opCtx = makeOperationContext();","+        // (Generic FCV reference): used for testing, should exist across LTS binary versions.","+        _versionContext.emplace(_opCtx.get(), VersionContext{multiversion::GenericFCV::kLatest});","     }"," ","     OperationContext* opCtx() const {","@@ -48,6 +51,7 @@ class PersistentStatsConfigValidationTest : public ServiceContextTest {"," private:","     boost::optional<unittest::ServerParameterGuard> _featureFlag;","     ServiceContext::UniqueOperationContext _opCtx;","+    boost::optional<VersionContext::ScopedSetDecoration> _versionContext;"," };"," "," using FeatureFlagDisabledTest = PersistentStatsConfigValidationTest<false>;"],"additions":5,"deletions":1,"truncated":false},{"path":"src/mongo/db/s/migration_chunk_cloner_source_test.cpp","lines":["@@ -273,6 +273,21 @@ class CollectionWithFault : public Collection {","         MONGO_UNREACHABLE;","     }"," ","+    const boost::optional<PersistentStatsConfig>& getPersistentStatsConfig() const override {","+        return _coll->getPersistentStatsConfig();","+    }","+","+    void setPersistentStatsConfig(","+        OperationContext* opCtx,","+        const boost::optional<PersistentStatsConfig>& persistentStatsConfig) override {","+        MONGO_UNREACHABLE;","+    }","+","+    void updatePersistentStatsConfig(OperationContext* opCtx,","+                                     const PersistentStatsConfigUpdate& update) override {","+        MONGO_UNREACHABLE;","+    }","+","     bool isTemporary() const override {","         return _coll->isTemporary();","     }"],"additions":15,"deletions":0,"truncated":false},{"path":"src/mongo/db/server_feature_flags.idl","lines":["@@ -196,6 +196,15 @@ feature_flags:","         version: 9.0","         fcv_gated: true","         check_against_fcv: operation_fcv_only","+    # Gates the generation of persisted statistics metadata (the 'persistentStatsConfig' collection","+    # option) in create and collMod. featureFlagPersistentStats gates its consumption.","+    featureFlagPersistentStatsCatalog:","+        description: >-","+            Enables the 'persistentStatsConfig' collection option in create and collMod.","+        cpp_varname: gFeatureFlagPersistentStatsCatalog","+        default: false","+        fcv_gated: true","+        check_against_fcv: operation_fcv_only","     featureFlagMongodProxyProtocolSupport:","         description: \"Enables non-OCS proxy protocol connections on Mongos and Mongod\"","         cpp_varname: gFeatureF