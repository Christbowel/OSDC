unstubAllGlobals();","+\t});","+","+\tit('takes audio from the pipeline tag and vision from the mmproj before its header is read', () => {","+\t\texpect(HuggingFaceService.getModalities('org/unread', 'text-to-speech', 'mmproj.gguf')).toEqual(","+\t\t\t{ audio: true, video: false, vision: true }","+\t\t);","+\t\texpect(HuggingFaceService.getModalities('org/plain', 'text-generation', undefined)).toEqual({","+\t\t\taudio: false,","+\t\t\tvideo: false,","+\t\t\tvision: false","+\t\t});","+\t});","+","+\tit('adds audio for an omni mmproj, with a ranged read of an encoded path', async () => {","+\t\tconst fetchMock = respond(","+\t\t\tmmprojHeader({ 'clip.has_audio_encoder': true, 'clip.has_vision_encoder': true }),","+\t\t\t206","+\t\t);","+","+\t\tawait HuggingFaceService.getMmprojEncoders('org/omni', 'sub dir/mmproj#1.gguf');","+","+\t\texpect(fetchMock).toHaveBeenCalledWith(","+\t\t\t'https://huggingface.co/org/omni/resolve/main/sub%20dir/mmproj%231.gguf',","+\t\t\t{ headers: { Range: 'bytes=0-65535' } }","+\t\t);","+\t\texpect(HuggingFaceService.getModalities('org/omni', 'any-to-any', 'mmproj.gguf')).toEqual({","+\t\t\taudio: true,","+\t\t\tvideo: false,","+\t\t\tvision: true","+\t\t});","+\t});","+","+\tit('drops vision for an audio-only mmproj', async () => {","+\t\t// the converter writes the vision key only when true","+\t\trespond(mmprojHeader({ 'clip.has_audio_encoder': true }), 206);","+","+\t\tawait HuggingFaceService.getMmprojEncoders('org/audio-only', 'mmproj.gguf');","+","+\t\texpect(HuggingFaceService.getModalities('org/audio-only', undefined, 'mmproj.gguf')).toEqual({","+\t\t\taudio: true,","+\t\t\tvideo: false,","+\t\t\tvision: false","+\t\t});","+\t});","+","+\tit('keeps vision when a header cut short never said', async () => {","+\t\tconst header = mmprojHeader({","+\t\t\t'clip.has_audio_encoder': true,","+\t\t\t'clip.has_vision_encoder': true","+\t\t});","+","+\t\trespond(header.slice(0, header.byteLength - 4), 206);","+","+\t\texpect(await HuggingFaceService.getMmprojEncoders('org/cut', 'mmproj.gguf')).toEqual({","+\t\t\taudio: true,","+\t\t\tvision: null","+\t\t});","+\t\texpect(HuggingFaceService.getModalities('org/cut', undefined, 'mmproj.gguf').vision).toBe(true);","+\t});","+","+\tit('keeps vision only for a vision mmproj', async () => {","+\t\trespond(mmprojHeader({ 'clip.has_vision_encoder': true }), 206);","+","+\t\tawait HuggingFaceService.getMmprojEncoders('org/vision', 'mmproj.gguf');","+","+\t\texpect(HuggingFaceService.getModalities('org/vision', 'image-text-to-text', 'm.gguf')).toEqual({","+\t\t\taudio: false,","+\t\t\tvideo: false,","+\t\t\tvision: true","+\t\t});","+\t});","+","+\tit('keeps what the repo says for a gated mmproj, without reading it again', async () => {","+\t\tconst fetchMock = respond(new ArrayBuffer(0), 401);","+","+\t\texpect(await HuggingFaceService.getMmprojEncoders('org/gated', 'mmproj.gguf')).toEqual({","+\t\t\taudio: false,","+\t\t\tvision: null","+\t\t});","+\t\tawait HuggingFaceService.getMmprojEncoders('org/gated', 'mmproj.gguf');","+","+\t\texpect(fetchMock).toHaveBeenCalledTimes(1);","+\t\texpect(HuggingFaceService.getModalities('org/gated', undefined, 'mmproj.gguf')).toEqual({","+\t\t\taudio: false,","+\t\t\tvideo: false,","+\t\t\tvision: true","+\t\t});","+\t});","+","+\tit('rejects a full response that ignored the range, and retries on the next call', async () => {","+\t\trespond(mmprojHeader({ 'clip.has_audio_encoder': true }), 200);","+","+\t\texpect(await HuggingFaceService.getMmprojEncoders('org/no-range', 'mmproj.gguf')).toBeNull();","+\t\texpect(HuggingFaceService.getModalities('org/no-range', undefined, 'mmproj.gguf').audio).toBe(","+\t\t\tfalse","+\t\t);","+","+\t\trespond(mmprojHeader({ 'clip.has_audio_encoder': true }), 206);","+","+\t\texpect(await HuggingFaceService.getMmprojEncoders('org/no-range', 'mmproj.gguf')).toEqual({","+\t\t\taudio: true,","+\t\t\tvision: false","+\t\t});","+\t});","+});",""],"additions":148,"deletions":0,"truncated":false}],"