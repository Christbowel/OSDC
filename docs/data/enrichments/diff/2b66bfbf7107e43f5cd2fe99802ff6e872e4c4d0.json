ame.","@@ -355,8 +372,6 @@ export class HuggingFaceService {"," \t\treturn `${Math.floor(diffDays / DAYS_PER_YEAR)} ${YEARS_AGO_LABEL}`;"," \t}"," ","-\t// Model Details & Files","-"," \t/**"," \t * Format a min-max size range with one shared unit, e.g. `19.0-28.6 GB`."," \t */","@@ -382,6 +397,8 @@ export class HuggingFaceService {"," \t\treturn `${fmt(min)}-${fmt(max)} ${unit}`;"," \t}"," ","+\t// Model Details & Files","+"," \t/**"," \t * Avatar URL for an author (org or user). 404s when the author does not"," \t * exist, so callers should provide a fallback.","@@ -544,6 +561,97 @@ export class HuggingFaceService {"," \t\treturn promise;"," \t}"," ","+\t/**","+\t * Which encoders a repo's mmproj carries, from the metadata at the start of the file: a ranged read of its","+\t * first bytes, so the file itself is never downloaded. The pipeline tag can't say this: omni models are","+\t * `any-to-any`, and their audio encoder lives in the same mmproj as the vision one. Null when the read fails.","+\t */","+\tstatic getMmprojEncoders(modelId: string, mmprojPath: string): Promise<HfMmprojEncoders | null> {","+\t\tif (!HuggingFaceService.isEnabled()) return Promise.resolve(null);","+","+\t\tconst cached = HuggingFaceService.mmprojEncodersCache.get(modelId);","+","+\t\tif (cached) return Promise.resolve(cached);","+","+\t\tconst pending = HuggingFaceService.mmprojEncodersPending.get(modelId);","+","+\t\tif (pending) return pending;","+","+\t\t// Do not encode the modelId, it contains slashes for author/name","+\t\tconst url = `${HF_BASE_URL}${PATH_SEPARATOR}${modelId}${PATH_SEPARATOR}${HF_RESOLVE_PATH}${PATH_SEPARATOR}${HF_MAIN_BRANCH}${PATH_SEPARATOR}${mmprojPath.split(PATH_SEPARATOR).map(encodeURIComponent).join(PATH_SEPARATOR)}`;","+\t\tconst promise = (async () => {","+\t\t\tconst response = await fetch(url, {","+\t\t\t\theaders: { Range: `bytes=0-${HF_MMPROJ_HEADER_BYTES - 1}` }","+\t\t\t});","+","+\t\t\t// anything but a partial response would stream the whole file, which can be gigabytes","+\t\t\tif (response.status !== HF_HTTP_PARTIAL_CONTENT) {","+\t\t\t\tvoid response.body?.cancel();","+","+\t\t\t\t// a gated, private or missing file answers the same on every read: keep what the repo says","+\t\t\t\tif (HF_HTTP_NO_ACCESS_STATUSES.includes(response.status)) {","+\t\t\t\t\tconst unknown: HfMmprojEncoders = { audio: false, vision: null };","+","+\t\t\t\t\tHuggingFaceService.mmprojEncodersCache.set(modelId, unknown);","+","+\t\t\t\t\treturn unknown;","+\t\t\t\t}","+","+\t\t\t\tthrow new Error(`Failed to read ${mmprojPath}: ${response.status}`);","+\t\t\t}","+","+\t\t\tconst { complete, metadata } = readGgufMetadata(await response.arrayBuffer());","+","+\t\t\tif (metadata.size === 0) throw new Error(`${mmprojPath} has no GGUF metadata`);","+","+\t\t\t// the converter writes these keys only when true, so one missing from a header read in full means no","+\t\t\t// such encoder; a header cut short leaves vision unknown","+\t\t\tconst hasVision = metadata.get(GGUF_KEY_HAS_VISION_ENCODER) === true;","+\t\t\tconst encoders: HfMmprojEncoders = {","+\t\t\t\taudio: metadata.get(GGUF_KEY_HAS_AUDIO_ENCODER) === true,","+\t\t\t\tvision: hasVision || (complete ? false : null)","+\t\t\t};","+","+\t\t\tHuggingFaceService.mmprojEncodersCache.set(modelId, encoders);","+","+\t\t\treturn encoders;","+\t\t})()","+\t\t\t.catch((error: unknown) => {","+\t\t\t\t// not cached: a rate limited or failed read should retry on the next mount","+\t\t\t\tconsole.error(`Error reading the mmproj of ${modelId}:`, error);","+","+\t\t\t\treturn null;","+\t\t\t})","+\t\t\t.finally(() => HuggingFaceService.mmprojEncodersPending.delete(modelId));","+","+\t\tHuggingFaceService.mmprojEncodersPending.set(modelId, promise);","+","+\t\treturn promise;","+\t}","+","+\t/**","+\t * Modalities a repo offers, from its pipeline tag and its mmproj: vision from a vision tag or an mmproj","+\t * (unless its header has no vision encoder, as in audio-only models), audio from an audio tag or","+\t * an audio encoder in the mmproj (omni models are `any-to-any`), video from a video tag. Reactive: it","+\t * updates once {@link getMmprojEncoders} has read the mmproj.","+\t */","+\tstatic getModalities(","+\t\tmodelId: string,","+\t\tpipelineTag: string | null | undefined,","+\t\tmmprojPath: string | undefined","+\t): ModelModalities {","+\t\tconst tag = pipelineTag ?? '';","+\t\tconst encoders = mmprojPath ? HuggingFaceService.mmprojEncodersCache.get(modelId) : undefined;","+","+\t\treturn {","+\t\t\taudio: HF_MODALITY_PIPELINE_TAGS.audio.includes(tag) || encoders?.audio === true,","+\t\t\tvideo: HF_MODALITY_PIPELINE_TAGS.video.includes(tag),","+\t\t\tvision:","+\t\t\t\tHF_MODALITY_PIPELINE_TAGS.vision.includes(tag) ||","+\t\t\t\t(Boolean(mmprojPath) && encoders?.vision !== false)","+\t\t};","+\t}","+"," \tstatic getModelUrl(modelId: string): string {"," \t\treturn `${HF_BASE_URL}${PATH_SEPARATOR}${modelId}`;"," \t}"],"additions":114,"deletions":6,"truncated":false},{"path":"tools/ui/src/lib/types/huggingface.d.ts","lines":["@@ -172,6 +172,12 @@ export interface HfModelDetailInfo extends HfModelInfo {"," }"," "," /** A single entry in a model repository's file tree (`/tree` responses) */","+/** Encoders an mmproj's header says it carries; vision is null when the header was cut short before it said. */","+export interface HfMmprojEncoders {","+\taudio: boolean;","+\tvision: boolean | null;","+}","+"," export interface HfModelSibling {"," \t/** Relative path of the file or directory within the repo */"," \tpath: string;"],"additions":6,"deletions":0,"truncated":false},{"path":"tools/ui/src/lib/types/index.ts","lines":["@@ -47,6 +47,7 @@ export type {"," \tHfModelGguf,"," \tHfModelInfo,"," \tHfModelSearchParams,","+\tHfMmprojEncoders,"," \tHfModelSibling,"," \tHfModelSiblingRef"," } from './huggingface';"],"additions":1,"deletions":0,"truncated":false},{"path":"tools/ui/src/lib/utils/gguf-metadata.ts","lines":["@@ -0,0 +1,153 @@","+/**","+ * Reads the metadata key/value pairs at the start of a GGUF file, from as many bytes of it as are given.","+ * Format: https://github.com/ggml-org/ggml/blob/master/docs/gguf.md","+ */","+","+const GGUF_MAGIC = 0x46554747; // \"GGUF\", little-endian","+","+enum GgufType {","+\tUINT8 = 0,","+\tINT8 = 1,","+\tUINT16 = 2,","+\tINT16 = 3,","+\tUINT32 = 4,","+\tINT32 = 5,","+\tFLOAT32 = 6,","+\tBOOL = 7,","+\tSTRING = 8,","+\tARRAY = 9,","+\tUINT64 = 10,","+\tINT64 = 11,","+\tFLOAT64 = 12","+}","+","+const SCALAR_SIZE: Partial<Record<GgufType, number>> = {","+\t[GgufType.BOOL]: 1,","+\t[GgufType.FLOAT32]: 4,","+\t[GgufType.FLOAT64]: 8,","+\t[GgufType.INT8]: 1,","+\t[GgufType.INT16]: 2,","+\t[GgufType.INT32]: 4,","+\t[GgufType.INT64]: 8,","+\t[GgufType.UINT8]: 1,","+\t[GgufType.UINT16]: 2,","+\t[GgufType.UINT32]: 4,","+\t[GgufType.UINT64]: 8","+};","+","+export type GgufValue = boolean | number | bigint | string;","+","+export interface GgufMetadata {","+\t/** True when every pair was read; false when the buffer ended first or is not GGUF. */","+\tcomplete: boolean;","+\tmetadata: Map<string, GgufValue>;","+}","+","+/**","+ * The scalar and string metadata of a GGUF file (arrays are skipped). A buffer cut short returns the pairs read","+ * before the cut; a buffer that is not GGUF returns an empty map.","+ */","+export function readGgufMetadata(buffer: ArrayBuffer): GgufMetadata {","+\tconst view = new DataView(buffer);","+\tconst decoder = new TextDecoder();","+\tconst metadata = new Map<string, GgufValue>();","+","+\tlet offset = 0;","+","+\tconst fits = (bytes: number) => offset + bytes <= view.byteLength;","+\tconst readString = (): string | null => {","+\t\tif (!fits(8)) return null;","+","+\t\tconst length = Number(view.getBigUint64(offset, true));","+","+\t\tif (!fits(8 + length)) return null;","+","+\t\tconst text = decoder.decode(new Uint8Array(buffer, offset + 8, length));","+","+\t\toffset += 8 + length;","+","+\t\treturn text;","+\t};","+\tconst readScalar = (type: GgufType): GgufValue | null => {","+\t\tconst size = SCALAR_SIZE[type];","+","+\t\tif (size === undefined || !fits(size)) return null;","+","+\t\tconst at = offset;","+","+\t\toffset += size;","+","+\t\tswitch (type) {","+\t\t\tcase GgufType.UINT8:","+\t\t\t\treturn view.getUint8(at);","+\t\t\tcase GgufType.INT8:","+\t\t\t\treturn view.getInt8(at);","+\t\t\tcase GgufType.UINT16:","+\t\t\t\treturn view.getUint16(at, true);","+\t\t\tcase GgufType.INT16:","+\t\t\t\treturn view.getInt16(at, true);","+\t\t\tcase GgufType.UINT32:","+\t\t\t\treturn view.getUint32(at, true);","+\t\t\tcase GgufType.INT32:","+\t\t\t\treturn view.getInt32(at, true);","+\t\t\tcase GgufType.FLOAT32:","+\t\t\t\treturn view.getFloat32(at, true);","+\t\t\tcase GgufType.BOOL:","+\t\t\t\treturn view.getUint8(at) !== 0;","+\t\t\tcase GgufType.UINT64:","+\t\t\t\treturn view.getBigUint64(at, true);","+\t\t\tcase GgufType.INT64:","+\t\t\t\treturn view.getBigInt64(at, true);","+\t\t\tdefault:","+\t\t\t\treturn view.getFloat64(at, true);","+\t\t}","+\t};","+\t// moves past an array's elements; false when the buffer ends inside it","+\tconst skipArray = (): boolean => {","+\t\tif (!fits(12)) return false;","+","+\t\tconst type = view.getUint32(offset, true) as GgufType;","+\t\tconst count = Number(view.getBigUint64(offset + 4, true));","+","+\t\toffset += 12;","+","+\t\tfor (let i = 0; i < count; i++) {","+\t\t\tconst value = type === GgufType.STRING ? readString() : readScalar(type);","+","+\t\t\tif (value === null) return false;","+\t\t}","+","+\t\treturn true;","+\t};","+","+\t// magic, version, tensor count, metadata count","+\tif (!fits(24) || view.getUint32(0, true) !== GGUF_MAGIC) return { complete: false, metadata };","+","+\tconst count = Number(view.getBigUint64(16, true));","+","+\toffset = 24;","+","+\tfor (let i = 0; i < count; i++) {","+\t\tconst key = readString();","+","+\t\tif (key === null || !fits(4)) return { complete: false, metadata };","+","+\t\tconst type = view.getUint32(offset, true) as GgufType;","+","+\t\toffset += 4;","+","+\t\tif (type === GgufType.ARRAY) {","+\t\t\tif (!skipArray()) return { complete: false, metadata };","+","+\t\t\tcontinue;","+\t\t}","+","+\t\tconst value = type === GgufType.STRING ? readString() : readScalar(type);","+","+\t\tif (value === null) return { complete: false, metadata };","+","+\t\tmetadata.set(key, value);","+\t}","+","+\treturn { complete: true, metadata };","+}"],"additions":153,"deletions":0,"truncated":false},{"path":"tools/ui/src/lib/utils/index.ts","lines":["@@ -366,6 +366,9 @@ export { detectToolUseSupport } from './chat-template-tool-detector';"," // Model memory estimation"," export { minMemoryTierGb } from './model-compatibility';"," ","+// GGUF file metadata, e.g. which encoders an mmproj carries","+export { type GgufMetadata, type GgufValue, readGgufMetadata } from './gguf-metadata';","+"," // Cryptography utilities"," "," export { uuid } from './uuid';"],"additions":3,"deletions":0,"truncated":false},{"path":"tools/ui/tests/unit/gguf-metadata.test.ts","lines":["@@ -0,0 +1,98 @@","+import { readGgufMetadata } from '$lib/utils/gguf-metadata';","+import { describe, expect, it } from 'vitest';","+","+type Entry =","+\t| [key: string, type: 'bool', value: boolean]","+\t| [key: string, type: 'u32', value: number]","+\t| [key: string, type: 'string', value: string]","+\t| [key: string, type: 'string[]', value: string[]]","+\t| [key: string, type: 'f32[]', value: number[]];","+","+/** A GGUF header with the given metadata and no tensors. */","+function gguf(entries: Entry[]): ArrayBuffer {","+\tconst bytes: number[] = [];","+\tconst u32 = (n: number) => bytes.push(...new Uint8Array(new Uint32Array([n]).buffer));","+\tconst u64 = (n: number) => bytes.push(...new Uint8Array(new BigUint64Array([BigInt(n)]).buffer));","+\tconst str = (s: string) => {","+\t\tconst encoded = new TextEncoder().encode(s);","+","+\t\tu64(encoded.length);","+\t\tbytes.push(...encoded);","+\t};","+","+\tu32(0x46554747);","+\tu32(3);","+\tu64(0);","+\tu64(entries.length);","+","+\tfor (const [key, type, value] of entries) {","+\t\tstr(key);","+","+\t\tif (type === 'bool') {","+\t\t\tu32(7);","+\t\t\tbytes.push(value ? 1 : 0);","+\t\t} else if (type === 'u32') {","+\t\t\tu32(4);","+\t\t\tu32(value);","+\t\t} else if (type === 'string') {","+\t\t\tu32(8);","+\t\t\tstr(value);","+\t\t} else if (type === 'string[]') {","+\t\t\tu32(9);","+\t\t\tu32(8);","+\t\t\tu64(value.length);","+\t\t\tvalue.forEach(str);","+\t\t} else {","+\t\t\tu32(9);","+\t\t\tu32(6);","+\t\t\tu64(value.length);","+\t\t\tvalue.forEach((n) => bytes.push(...new Uint8Array(new Float32Array([n]).buffer)));","+\t\t}","+\t}","+","+\treturn new Uint8Array(bytes).buffer;","+}","+","+const MMPROJ: Entry[] = [","+\t['general.architecture', 'string', 'clip'],","+\t['clip.projector_type', 'string', 'gemma4'],","+\t['clip.vision.image_mean', 'f32[]', [0.5, 0.5, 0.5]],","+\t['tokenizer.ggml.tokens', 'string[]', ['<a>', '<b>']],","+\t['clip.has_vision_encoder', 'bool', true],","+\t['clip.has_audio_encoder', 'bool', true],","+\t['clip.audio.num_mel_bins', 'u32', 128]","+];","+","+describe('readGgufMetadata', () => {","+\tit('reads scalars and strings, skipping arrays', () => {","+\t\tconst { complete, metadata } = readGgufMetadata(gguf(MMPROJ));","+","+\t\texpect(complete).toBe(true);","+","+\t\texpect(metadata.get('general.architecture')).toBe('clip');","+\t\texpect(metadata.get('clip.has_vision_encoder')).toBe(true);","+\t\texpect(metadata.get('clip.has_audio_encoder')).toBe(true);","+\t\texpect(metadata.get('clip.audio.num_mel_bins')).toBe(128);","+\t\texpect(metadata.has('clip.vision.image_mean')).toBe(false);","+\t});","+","+\tit('returns what it read before a buffer cut short', () => {","+\t\tconst full = gguf(MMPROJ);","+\t\tconst { complete, metadata } = readGgufMetadata(full.slice(0, full.byteLength - 20));","+","+\t\texpect(complete).toBe(false);","+","+\t\texpect(metadata.get('clip.has_vision_encoder')).toBe(true);","+\t\texpect(m