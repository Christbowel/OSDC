{"id":"820fce0d6755e3ebd72abf01be099df4001835ca","axis":"silent","repo":"vllm-project/vllm","sha":"820fce0d6755e3ebd72abf01be099df4001835ca","parsed":{"files":[{"path":"tests/v1/attention/test_encoder_only_attention_hooks.py","lines":["@@ -0,0 +1,242 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Hooks that let a model (in-tree or a plugin) own its encoder attention:","+`EncoderOnlyAttention(attn_backend=...)`, `FlexAttentionMetadataBuilder.","+_make_metadata` and `register_model_config`.\"\"\"","+","+from dataclasses import dataclass","+","+import pytest","+import torch","+","+from tests.v1.attention.utils import (","+    BatchSpec,","+    create_common_attn_metadata,","+    create_standard_kv_cache_spec,","+    create_vllm_config,","+    registered_attention_layers,","+)","+from vllm.model_executor.layers.attention import encoder_only_attention","+from vllm.model_executor.models import register_model_config","+from vllm.model_executor.models.config import (","+    MODELS_CONFIG_MAP,","+    VerifyAndUpdateConfig,","+)","+from vllm.v1.attention.backend import AttentionType","+from vllm.v1.attention.backends import flex_attention","+from vllm.v1.attention.backends.flex_attention import (","+    FlexAttentionBackend,","+    FlexAttentionMetadata,","+    FlexAttentionMetadataBuilder,","+)","+","+pytestmark = pytest.mark.cpu_test","+","+","+def test_encoder_only_attention_takes_a_backend(monkeypatch):","+    def no_selection(*args, **kwargs):","+        raise AssertionError(\"a given backend must not be re-selected\")","+","+    seen = {}","+","+    def record(self, **kwargs):","+        seen.update(kwargs)","+","+    monkeypatch.setattr(encoder_only_attention, \"get_attn_backend\", no_selection)","+    monkeypatch.setattr(encoder_only_attention.Attention, \"__init__\", record)","+    encoder_only_attention.EncoderOnlyAttention(","+        num_heads=2, head_size=64, scale=1.0, attn_backend=FlexAttentionBackend","+    )","+    # Wrapped like a selected backend: non-causal metadata, same impl.","+    backend = seen[\"attn_backend\"]","+    assert issubclass(backend, FlexAttentionBackend)","+    assert backend is encoder_only_attention.create_encoder_only_attention_backend(","+        FlexAttentionBackend","+    )","+    assert seen[\"attn_type\"] == AttentionType.ENCODER_ONLY","+","+","+def test_given_backend_logs_a_warning(monkeypatch, caplog_vllm):","+    from vllm.config import AttentionConfig, VllmConfig, set_current_vllm_config","+    from vllm.v1.attention.backends.registry import AttentionBackendEnum","+","+    monkeypatch.setattr(","+        encoder_only_attention.Attention, \"__init__\", lambda self, **kwargs: None","+    )","+    vllm_config = VllmConfig(","+        attention_config=AttentionConfig(backend=AttentionBackendEnum.TRITON_ATTN)","+    )","+    with set_current_vllm_config(vllm_config):","+        encoder_only_attention.EncoderOnlyAttention(","+            num_heads=2, head_size=64, scale=1.0, attn_backend=FlexAttentionBackend","+        )","+    # It names the backend that is used and the one it overrides.","+    assert \"FlexAttentionBackend\" in caplog_vllm.text","+    assert \"--attention-backend: TRITON_ATTN\" in caplog_vllm.text","+","+","+# A model's own backend with the same class name as a stock one, defined in","+# another module (here: this test module).","+_SameNameFlexBackend = type(","+    \"FlexAttentionBackend\",","+    (FlexAttentionBackend,),","+    {\"__module__\": __name__, \"__qualname__\": \"FlexAttentionBackend\"},","+)","+","+","+def test_wrapped_backends_keep_their_identity():","+    stock = encoder_only_attention.create_encoder_only_attention_backend(","+        FlexAttentionBackend","+    )","+    own = encoder_only_attention.create_encoder_only_attention_backend(","+        _SameNameFlexBackend","+    )","+    # Attention groups are keyed by `full_cls_name()`: the two must not share one.","+    assert stock.full_cls_name() == (","+        FlexAttentionBackend.__module__,","+        \"EncoderOnlyAttention_FlexAttentionBackend\",","+    )","+    assert own.full_cls_name() == (","+        __name__,","+        \"EncoderOnlyAttention_FlexAttentionBackend\",","+    )","+    assert stock.full_cls_name() != own.full_cls_name()","+","+","+@pytest.mark.parametrize(\"model_cls\", [\"BertModel\", \"BertPoolingModel\"])","+def test_bert_layers_receive_the_backend(monkeypatch, dist_init, model_cls):","+    from vllm.config import ModelConfig, VllmConfig, set_current_vllm_config","+    from vllm.model_executor.models import bert","+","+    seen = []","+","+    def record(self, *args, attn_backend=None, **kwargs):","+        torch.nn.Module.__init__(self)","+        seen.append(attn_backend)","+","+    monkeypatch.setattr(encoder_only_attention.EncoderOnlyAttention, \"__init__\", record)","+    vllm_config = VllmConfig(","+        model_config=ModelConfig(","+            \"sentence-transformers/all-MiniLM-L6-v2\", runner=\"pooling\"","+        )","+    )","+    with set_current_vllm_config(vllm_config):","+        getattr(bert, model_cls)(","+            vllm_config=vllm_config, prefix=\"model\", attn_backend=FlexAttentionBackend","+        )","+    # Every encoder layer gets the model's backend.","+    assert len(seen) == vllm_config.model_config.hf_config.num_hidden_layers","+    assert all(backend is FlexAttentionBackend for backend in seen)","+","+","+def _only_self(b, h, q_idx, kv_idx):","+    return q_idx == kv_idx","+","+","+class _OwnMetadata(FlexAttentionMetadata):","+    def get_mask_mod(self):","+        return _only_self","+","+","+class _OwnBuilder(FlexAttentionMetadataBuilder):","+    def _make_metadata(self, **kwargs):","+        return _OwnMetadata(**kwargs)","+","+","+@dataclass","+class _LimitMetadata(FlexAttentionMetadata):","+    kv_limit: int = 0","+","+    def get_mask_mod(self):","+        kv_limit = self.kv_limit","+","+        def below_limit(b, h, q_idx, kv_idx):","+            return kv_idx < kv_limit","+","+        return below_limit","+","+","+class _LimitBuilder(FlexAttentionMetadataBuilder):","+    # Per-builder data the mask reads, set on each instance.","+    kv_limit = 0","+","+    def _make_metadata(self, **kwargs):","+        return _LimitMetadata(**kwargs, kv_limit=self.kv_limit)","+","+","+def _build(builder_cls, monkeypatch, configure=None):","+    # CPU test: build the block mask eagerly, without torch.compile.","+    monkeypatch.setattr(","+        flex_attention, \"create_block_mask_compiled\", flex_attention.create_block_mask","+    )","+    vllm_config = create_vllm_config(max_model_len=256, block_size=16)","+    device = torch.device(\"cpu\")","+    layer_names = [\"layer.0\"]","+    with registered_attention_layers(","+        vllm_config, layer_names, AttentionType.ENCODER_ONLY, None","+    ):","+        builder = builder_cls(","+            create_standard_kv_cache_spec(vllm_config),","+            layer_names,","+            vllm_config,","+            device,","+        )","+        if configure is not None:","+            configure(builder)","+        return builder.build(","+            common_prefix_len=0,","+            common_attn_metadata=create_common_attn_metadata(","+                BatchSpec(seq_lens=[8, 5], query_lens=[8, 5]),","+                16,","+                device,","+                arange_block_indices=True,","+            ),","+        )","+","+","+def test_flex_builder_builds_its_own_metadata(monkeypatch):","+    metadata = _build(_OwnBuilder, monkeypatch)","+    assert type(metadata) is _OwnMetadata","+    # The block mask is built from the subclass's mask.","+    assert metadata.block_mask is not None","+    assert metadata.block_mask.mask_mod is _only_self","+","+","+def test_flex_builders_keep_their_own_data(monkeypatch):","+    def limit(value):","+        def configure(builder):","+            builder.kv_limit = value","+","+        return configure","+","+    # Two builders of one class, each with its own data for its mask.","+    first = _build(_LimitBuilder, monkeypatch, limit(2))","+    second = _build(_LimitBuilder, monkeypatch, limit(5))","+    q_idx, kv_idx = torch.tensor(0), torch.tensor(3)","+    for metadata, kv_limit in ((first, 2), (second, 5)):","+        assert type(metadata) is _LimitMetadata","+        assert metadata.kv_limit == kv_limit","+        assert metadata.block_mask is not None","+        allowed = metadata.block_mask.mask_mod(0, 0, q_idx, kv_idx)","+        assert bool(allowed) == (kv_limit > 3)","+","+","+class _HookA(VerifyAndUpdateConfig):","+    pass","+","+","+class _HookB(VerifyAndUpdateConfig):","+    pass","+","+","+def test_register_model_config(monkeypatch, caplog_vllm):","+    # Restored (absent) after the test.","+    monkeypatch.delitem(MODELS_CONFIG_MAP, \"PluginArchForTest\", raising=False)","+    register_model_config(\"PluginArchForTest\", _HookA)","+    assert MODELS_CONFIG_MAP[\"PluginArchForTest\"] is _HookA","+    register_model_config(\"PluginArchForTest\", _HookA)  # idempotent, no warning","+    assert \"already has the config hook\" not in caplog_vllm.text","+    # Like `ModelRegistry.register_model`: a later registration overwrites.","+    register_model_config(\"PluginArchForTest\", _HookB)","+    assert MODELS_CONFIG_MAP[\"PluginArchForTest\"] is _HookB","+    assert \"already has the config hook _HookA\" in caplog_vllm.text"],"additions":242,"deletions":0,"truncated":false},{"path":"tests/v1/attention/test_encoder_only_attention_hooks_e2e.py","lines":["@@ -0,0 +1,229 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"End-to-end test of the encoder attention hooks through `LLM`: a BERT model","+registered in-process runs its own Flex backend and metadata (a causal mask","+within each request) on half of its layers and the selected backend on the","+rest. Its outputs must match a reference that applies the two masks per layer,","+and the stock model must be unchanged.\"\"\"","+","+from collections.abc import Iterable","+","+import pytest","+import torch","+from torch import nn","+","+from vllm import ModelRegistry","+from vllm.compilation.decorators import support_torch_compile","+from vllm.config import PoolerConfig, VllmConfig","+from vllm.model_executor.models.bert import (","+    BertEmbedding,","+    BertEmbeddingModel,","+    BertLayer,","+    BertModel,","+)","+from vllm.model_executor.models.utils import AutoWeightsLoader","+from vllm.sequence import IntermediateTensors","+from vllm.v1.attention.backends import flex_attention","+","+MODEL = \"sentence-transformers/all-MiniLM-L6-v2\"","+ARCH = \"HalfCausalBertForHookTest\"","+PROMPTS = [","+    \"The quick brown fox jumps over the lazy dog.\",","+    \"Hello\",","+    (","+        \"Encoder attention hooks let a model own the attention layout of some \"","+        \"of its layers while the remaining layers keep the backend vLLM selects.\"","+    ),","+]","+","+","+def _causal_within_request(mask_mod):","+    def mask(b, h, q_idx, kv_idx):","+        return mask_mod(b, h, q_idx, kv_idx) & (kv_idx <= q_idx)","+","+    return mask","+","+","+class _CausalMetadata(flex_attention.FlexAttentionMetadata):","+    def get_mask_mod(self):","+        return _causal_within_request(super().get_mask_mod())","+","+","+class _CausalBuilder(flex_attention.FlexAttentionMetadataBuilder):","+    def _make_metadata(self, **kwargs):","+        return _CausalMetadata(**kwargs)","+","+","+# Same class name as the stock backend, as is natural in a plugin's module: the","+# model's layers must still get their own attention group.","+class FlexAttentionBackend(flex_attention.FlexAttentionBackend):","+    @staticmethod","+    def get_builder_cls():","+        return _CausalBuilder","+","+","+def _num_own_layers(num_hidden_layers: int) -> int:","+    return num_hidden_layers // 2","+","+","+@support_torch_compile","+class _HalfCausalBertModel(nn.Module):","+    hf_to_vllm_mapper = BertModel.hf_to_vllm_mapper","+","+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\"):","+        super().__init__()","+        config = vllm_config.model_config.hf_config","+        num_own = _num_own_layers(config.num_hidden_layers)","+        self.embeddings = BertEmbedding(config)","+        self.encoder = nn.Module()","+        self.encoder.layer = nn.ModuleList(","+            [","+                BertLayer(","+                    config=config,","+                    cache_config=vllm_config.cache_config,","+                    quant_config=vllm_config.quant_config,","+                    prefix=f\"{prefix}.encoder.layer.{layer_idx}\",","+                    attn_backend=FlexAttentionBackend if layer_idx < num_own else None,","+                )","+                for layer_idx in range(config.num_hidden_layers)","+            ]","+        )","+","+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:","+        return self.embeddings.word_embeddings(input_ids)","+","+    def forward(","+        self,","+        input_ids: torch.Tensor,","+        positions: torch.Tensor,","+        intermediate_tensors: IntermediateTensors | None = None,","+        inputs_embeds: torch.Tensor | None = None,","+    ) -> torch.Tensor:","+        hidden_states = self.embeddings(","+            input_ids=input_ids,","+            position_ids=positions,","+            inputs_embeds=inputs_embeds,","+        )","+        for layer in self.encoder.layer:","+            hidden_states = layer(hidden_states)","+        return hidden_states","+","+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:","+        loader = AutoWeightsLoader(self)","+        return loader.load_weights(weights, mapper=self.hf_to_vllm_mapper)","+","+","+class _HalfCausalBertEmbeddingModel(BertEmbeddingModel):","+    def _build_model(self, vllm_config: VllmConfig, prefix: str = \"\"):","+        return _HalfCausalBertModel(vllm_config=vllm_config, prefix=prefix)","+","+","+def _token_embeddings(vllm_runner, model_kwargs) -> list[torch.Tensor]:","+    with vllm_runner(","+        MODEL,","+        runner=\"pooling\",","+        dtype=\"float32\",","+        max_model_len=256,","+        pooler_config=PoolerConfig(task=\"token_embed\"),","+        **model_kwargs,","+    ) as m:","+        outputs = m.token_embed(PROMPTS)","+    return [torch.as_tensor(out, dtype=torch.float32) for out in outputs]","+","+","+@torch.inference_mode()","+def _reference(num_own: int) -> list[torch.Tensor]:","+    \"\"\"Transformers forward with a causal mask on the first `num_own` layers","+    and the full (bidirectional) mask on the rest.\"\"\"","+    from transformers import AutoModel, AutoTokenizer","+","+    tokenizer = AutoTokenizer.from_pretrained(MODEL)","+    model = AutoModel.from_pretrained(","+        MODEL, torch_dtype=torch.float32, attn_implementation=\"eager\"","+    ).to(\"cuda\")","+    min_value = torch.finfo(torch.float32).min","+    outputs = []","+    for prompt in PROMPTS:","+        input_ids = tokenizer(prompt, return_tensors=\"pt\").input_ids.to(\"cuda\")","+        length = input_ids.shape[1]","+        full = torch.zeros(1, 1, length, length, device=\"cuda\")","+        causal = torch.full_like(full, min_value).triu(1)","+        hidden_states = model.embeddings(input_ids=input_ids)","+        for layer_idx, layer in enumerate(model.encoder.layer):","+            out = layer(","+                hidden_states, attention_mask=causal if layer_idx < num_own else full","+            )","+            hidden_states = out[0] if isinstance(out, tuple) else out","+        outputs.append(hidden_states[0].float().cpu())","+    del model","+    torch.accelerator.empty_cache()","+    return outputs","+","+","+def _assert_close(actual: list[torch.Tensor], expected: list[torch.Tensor]):","+    # Compare directions: the pooler may normalize token embeddings. The","+    # tolerance covers FP32 kernel differences (up to ~3e-4 between vLLM's","+    # stock layers and Transformers); the masks differ by far more.","+    for got, want in zip(actual, expected, strict=True):","+        assert got.shape == want.shape","+        got = nn.functional.normalize(got, dim=-1)","+        want = nn.functional.normalize(want, dim=-1)","+        torch.testing.assert_close(got, want, rtol=0, atol=1e-3)","+","+","+def _max_diff(actual: list[torch.Tensor], expected: list[torch.Tensor]) -> float:","+    return max(","+        (nn.functional.normalize(got, dim=-1) - nn.functional.normalize(want, dim=-1))","+        .abs()","+        .max()","+        .item()","+        for got, want in zip(actual, expected, strict=True)","+    )","+","+","+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"needs a CUDA GPU\")","+@pytest.mark.parametrize(\"enforce_eager\", [True, False])","+@pytest.mark.parametrize(","+    \"stock_backend\",","+    [","+        \"TRITON_ATTN\",","+        pytest.param(","+            \"FLEX_ATTENTION\",","+            marks=pytest.mark.skip(","+                reason=\"Two FlexAttention groups need \"","+                \"https://github.com/vllm-project/vllm/pull/63985\"","+            ),","+        ),","+    ],","+)","+def test_model_owned_backend_on_half_the_layers(","+    vllm_runner, monkeypatch, enforce_eager, stock_backend","+):","+    # The model is registered in this process, so the engine core runs here too.","+    monkeypatch.setenv(\"VLLM_ENABLE_V1_MULTIPROCESSING\", \"0\")","+    ModelRegistry.register_model(ARCH, _HalfCausalBertEmbeddingModel)","+    common = dict(","+        enforce_eager=enforce_eager,","+        attention_config={\"backend\": stock_backend},","+    )","+","+    stock = _token_embeddings(vllm_runner, common)","+    mixed = _token_embeddings(","+        vllm_runner, dict(common, hf_overrides={\"architectures\": [ARCH]})","+    )","+","+    from transformers import AutoConfig","+","+    num_own = _num_own_layers(AutoConfig.from_pretrained(MODEL).num_hidden_layers)","+    stock_reference = _reference(num_own=0)","+    mixed_reference = _reference(num_own=num_own)","+","+    print(","+        f\"max diff: stock vs reference {_max_diff(stock, stock_reference):.2e}, \"","+        f\"mixed vs two-mask reference {_max_diff(mixed, mixed_reference):.2e}, \"","+        f\"mixed vs stock reference {_max_diff(mixed, stock_reference):.2e}\"","+    )","+    # The stock model is unchanged; the model's layers run its own mask.","+    _assert_close(stock, stock_reference)","+    _assert_close(mixed, mixed_reference)","+    assert _max_diff(mixed, stock_reference) > 1e-1"],"additions":229,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/attention/encoder_only_attention.py","lines":["@@ -6,7 +6,8 @@"," import torch"," "," from vllm.config import CacheConfig","-from vllm.config.vllm import VllmConfig","+from vllm.config.vllm import VllmConfig, get_current_vllm_config_or_none","+from vllm.logger import init_logger"," from vllm.model_executor.layers.attention import Attention"," from vllm.v1.attention.backend import (","     AttentionBackend,","@@ -18,6 +19,8 @@"," from vllm.v1.attention.selector import get_attn_backend"," from vllm.v1.kv_cache_interface import KVCacheLayerConfig"," ","+logger = init_logger(__name__)","+"," "," @functools.lru_cache"," def create_encoder_only_attention_backend(","@@ -48,6 +51,26 @@ def build(","     return attn_backend"," "," ","+def _warn_given_attn_backend(attn_backend: type[AttentionBackend]) -> None:","+    vllm_config = get_current_vllm_config_or_none()","+    requested = \"auto\"","+    if vllm_config is not None:","+        attention_config = vllm_config.attention_config","+        if attention_config.backend is not None:","+            requested = attention_config.backend.name","+        if attention_config.backend_per_kind:","+            requested += f\" (per kind: {attention_config.backend_per_kind})\"","+    module, qualname = attn_backend.full_cls_name()","+    logger.warning_once(","+        \"EncoderOnlyAttention uses the model's attention backend %s.%s instead \"","+        \"of the selected one (--attention-backend: %s); the selector's \"","+        \"validation is skipped for it.\",","+        module,","+        qualname,","+        requested,","+    )","+","+"," class EncoderOnlyAttention(Attention):","     \"\"\"Encoder attention is a special case that doesn't need a KV Cache.\"\"\""," ","@@ -58,8 +81,20 @@ def __init__(","         scale: float,","         cache_config: CacheConfig | None = None,","         attn_type: str | None = None,","+        attn_backend: type[AttentionBackend] | None = None,","         **kwargs,","     ):","+        \"\"\"`attn_backend` replaces the selected backend (e.g. a model's own","+        subclass); it is wrapped for non-causal metadata like the default.","+        A given backend skips the backend selector and its validation, and","+        overrides `--attention-backend`: checking that it supports the head","+        size, dtype, KV cache dtype and platform is the caller's","+        responsibility. A warning names the backend that is used. Its","+        `get_name()` must be the name of a registered `AttentionBackendEnum`","+        member.","+","+        Of the in-tree models, only the BERT classes (`BertModel`,","+        `BertPoolingModel` and their layers) pass `attn_backend` through.\"\"\"","         dtype = torch.get_default_dtype()"," ","         if cache_config is not None:","@@ -67,14 +102,15 @@ def __init__(","         else:","             kv_cache_dtype = \"auto\""," ","-        underlying_attn_backend = get_attn_backend(","-            head_size,","-            dtype,","-            kv_cache_dtype,","-            attn_type=AttentionType.ENCODER_ONLY,","-        )","-","-        attn_backend = create_encoder_only_attention_backend(underlying_attn_backend)","+        if attn_backend is None:","+            attn_backend = 