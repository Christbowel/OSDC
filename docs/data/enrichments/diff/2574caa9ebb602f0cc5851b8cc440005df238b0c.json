Add(-renewal.Age)"," "," \t\t\t// Grab the lease duration"," \t\t\tinitLeaseDuration = renewal.LeaseDuration","@@ -350,7 +352,7 @@ func (r *LifetimeWatcher) doRenewWithOptions(tokenMode bool, nonRenewable bool,"," \t\t\t\tinitLeaseDuration = renewal.Auth.LeaseDuration"," \t\t\t}"," ","-\t\t\tremainingLeaseDuration = time.Duration(initLeaseDuration) * time.Second","+\t\t\tremainingLeaseDuration = remainingLease(time.Duration(initLeaseDuration)*time.Second, renewal.Age)"," \t\t}"," "," \t\tvar sleepDuration time.Duration","@@ -425,6 +427,21 @@ func (r *LifetimeWatcher) calculateGrace(leaseDuration, increment time.Duration)"," \tr.grace = time.Duration(jitterMax) + time.Duration(uint64(r.random.Int63())%uint64(jitterMax))"," }"," ","+// remainingLease reports how much of a lease is left once the time its","+// response spent in an intermediate cache is discounted.","+//","+// A cached response reports the lease duration measured from when the lease was","+// issued rather than from when the client received it, so trusting that value","+// directly overestimates the remaining lifetime by the age of the response.","+func remainingLease(leaseDuration time.Duration, age time.Duration) time.Duration {","+\tremaining := leaseDuration - age","+\tif remaining < 0 {","+\t\treturn 0","+\t}","+","+\treturn remaining","+}","+"," type ("," \tRenewer      = LifetimeWatcher"," \tRenewerInput = LifetimeWatcherInput"],"additions":20,"deletions":3,"truncated":false},{"path":"api/lifetime_watcher_cache_age_test.go","lines":["@@ -0,0 +1,179 @@","+// Copyright IBM Corp. 2016, 2025","+// SPDX-License-Identifier: MPL-2.0","+","+package api","+","+import (","+\t\"fmt\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"slices\"","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+const (","+\ttestCachedLeaseID              = \"database/creds/readonly/abcd1234\"","+\ttestCachedLeaseDurationSeconds = 6","+\ttestCachedLeaseAgeSeconds      = 5","+)","+","+// fakeCachedSecretServer stands in for a caching proxy serving a hit: it replays","+// a lease that was issued ageSeconds ago, with the body still reporting the","+// duration the lease had when it was issued.","+//","+// Renewals are timed from server start, so a test can tell whether one was","+// attempted after the lease it renews had already expired.","+func fakeCachedSecretServer(t *testing.T, leaseDurationSeconds int, ageSeconds int) (*httptest.Server, func() []time.Duration) {","+\tt.Helper()","+","+\tvar (","+\t\tmu       sync.Mutex","+\t\trenewals []time.Duration","+\t)","+\tstart := time.Now()","+","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tmu.Lock()","+\t\trenewals = append(renewals, time.Since(start))","+\t\tmu.Unlock()","+","+\t\tw.Header().Set(\"Age\", fmt.Sprintf(\"%d\", ageSeconds))","+\t\tw.Header().Set(\"X-Cache\", \"HIT\")","+\t\tw.Header().Set(\"Date\", time.Now().Format(http.TimeFormat))","+\t\tw.Header().Set(\"Content-Type\", \"application/json\")","+\t\tfmt.Fprintf(w, `{\"lease_id\":%q,\"lease_duration\":%d,\"renewable\":true}`,","+\t\t\ttestCachedLeaseID, leaseDurationSeconds)","+\t}))","+","+\treturn server, func() []time.Duration {","+\t\tmu.Lock()","+\t\tdefer mu.Unlock()","+","+\t\treturn slices.Clone(renewals)","+\t}","+}","+","+// testWatchCachedLease starts a watcher over a lease whose renewals are served by","+// the given caching proxy.","+func testWatchCachedLease(t *testing.T, server *httptest.Server) *LifetimeWatcher {","+\tt.Helper()","+","+\tclient, err := NewClient(&Config{Address: server.URL})","+\trequire.NoError(t, err)","+","+\twatcher, err := client.NewLifetimeWatcher(&LifetimeWatcherInput{","+\t\tSecret: &Secret{","+\t\t\tLeaseID:       testCachedLeaseID,","+\t\t\tLeaseDuration: testCachedLeaseDurationSeconds,","+\t\t\tRenewable:     true,","+\t\t},","+\t})","+\trequire.NoError(t, err)","+","+\tgo watcher.Start()","+","+\treturn watcher","+}","+","+// TestLifetimeWatcher_SignalsReReadOfAgedLease asserts that the watcher gives up","+// and reports that the secret must be re-read, rather than renewing forever.","+//","+// A caching proxy reports how stale its response is in the HTTP Age header, but","+// the lease_duration in the body still reads from issuance. A watcher that","+// ignored Age would compute a remaining lifetime that never falls, so the","+// threshold at which it gives up would never be reached.","+//","+// See https://github.com/hashicorp/vault/issues/19227.","+func TestLifetimeWatcher_SignalsReReadOfAgedLease(t *testing.T) {","+\tt.Parallel()","+","+\tserver, _ := fakeCachedSecretServer(t, testCachedLeaseDurationSeconds, testCachedLeaseAgeSeconds)","+\tdefer server.Close()","+","+\twatcher := testWatchCachedLease(t, server)","+\tdefer watcher.Stop()","+","+\tselect {","+\tcase err := <-watcher.DoneCh():","+\t\trequire.NoError(t, err)","+\tcase <-time.After(3 * time.Second):","+\t\tt.Fatalf(\"watcher never signalled a re-read for a %ds lease already %ds old\",","+\t\t\ttestCachedLeaseDurationSeconds, testCachedLeaseAgeSeconds)","+\t}","+}","+","+// TestLifetimeWatcher_DoesNotRenewExpiredLease asserts that the watcher stops","+// rather than going on renewing a lease that has already run out.","+//","+// The lease has only its duration less its age left when it arrives, but a","+// watcher that reads lease_duration alone sleeps for two thirds of the full","+// duration before renewing again, by which time the credential is long dead.","+// Each such renewal is a request Vault and its secrets backend must serve for a","+// lease that no longer exists.","+func TestLifetimeWatcher_DoesNotRenewExpiredLease(t *testing.T) {","+\tt.Parallel()","+","+\tremaining := time.Duration(testCachedLeaseDurationSeconds-testCachedLeaseAgeSeconds) * time.Second","+","+\tserver, renewals := fakeCachedSecretServer(t, testCachedLeaseDurationSeconds, testCachedLeaseAgeSeconds)","+\tdefer server.Close()","+","+\twatcher := testWatchCachedLease(t, server)","+\tdefer watcher.Stop()","+","+\t// Wait long enough to catch a second renewal, which a watcher that ignores","+\t// Age schedules for roughly two thirds of the reported lease duration.","+\tselect {","+\tcase <-watcher.DoneCh():","+\tcase <-time.After(5 * time.Second):","+\t}","+","+\tfor _, at := range renewals() {","+\t\tif at > remaining {","+\t\t\tt.Fatalf(\"renewed %s after the lease expired (renewal at %s, only %s of life left on arrival)\",","+\t\t\t\tat-remaining, at, remaining)","+\t\t}","+\t}","+}","+","+func TestRemainingLease(t *testing.T) {","+\tt.Parallel()","+","+\tcases := []struct {","+\t\tname          string","+\t\tleaseDuration time.Duration","+\t\tage           time.Duration","+\t\twant          time.Duration","+\t}{","+\t\t{","+\t\t\tname:          \"uncached response is unaffected\",","+\t\t\tleaseDuration: 30 * time.Second,","+\t\t\tage:           0,","+\t\t\twant:          30 * time.Second,","+\t\t},","+\t\t{","+\t\t\tname:          \"cached response discounts time spent in cache\",","+\t\t\tleaseDuration: 30 * time.Second,","+\t\t\tage:           25 * time.Second,","+\t\t\twant:          5 * time.Second,","+\t\t},","+\t\t{","+\t\t\tname:          \"age beyond the lease duration clamps to zero\",","+\t\t\tleaseDuration: 30 * time.Second,","+\t\t\tage:           45 * time.Second,","+\t\t\twant:          0,","+\t\t},","+\t}","+","+\tfor _, tc := range cases {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\trequire.Equal(t, tc.want, remainingLease(tc.leaseDuration, tc.age))","+\t\t})","+\t}","+}"],"additions":179,"deletions":0,"truncated":false},{"path":"api/logical.go","lines":["@@ -157,7 +157,7 @@ func (c *Logical) ParseRawResponseAndCloseBody(resp *Response, err error) (*Secr"," \t\treturn nil, err"," \t}"," ","-\treturn ParseSecret(resp.Body)","+\treturn resp.toSecret()"," }"," "," func (c *Logical) readRawWithDataWithContext(ctx context.Context, path string, values url.Values, extraHeaders http.Header) (*Response, error) {","@@ -374,7 +374,7 @@ func (c *Logical) write(ctx context.Context, path string, request *Request) (*Se"," \t\treturn nil, err"," \t}"," ","-\treturn ParseSecret(resp.Body)","+\treturn resp.toSecret()"," }"," "," func (c *Logical) writeRaw(ctx context.Context, request *Request) (*Response, error) {"],"additions":2,"deletions":2,"truncated":false},{"path":"api/response.go","lines":["@@ -9,6 +9,9 @@ import ("," \t\"fmt\""," \t\"io\""," \t\"net/http\"","+\t\"strconv\"","+\t\"strings\"","+\t\"time\""," )"," "," // Response is a raw response that wraps an HTTP response.","@@ -16,6 +19,31 @@ type Response struct {"," \t*http.Response"," }"," ","+// cacheAge reports how long an intermediate cache held this response. It is","+// zero when no cache handled the response, or when the age it reported cannot","+// be understood, so that an unusable value is treated as a direct response","+// rather than failing the request that carried it.","+func (r *Response) cacheAge() time.Duration {","+\tseconds, err := strconv.Atoi(strings.TrimSpace(r.Header.Get(\"Age\")))","+\tif err != nil || seconds < 0 {","+\t\treturn 0","+\t}","+","+\treturn time.Duration(seconds) * time.Second","+}","+","+// toSecret reads the secret carried by this response, recording how long an","+// intermediate cache held it.","+func (r *Response) toSecret() (*Secret, error) {","+\tsecret, err := ParseSecret(r.Body)","+\tif err != nil || secret == nil {","+\t\treturn secret, err","+\t}","+\tsecret.Age = r.cacheAge()","+","+\treturn secret, nil","+}","+"," // DecodeJSON will decode the response body to a JSON structure. This"," // will consume the response body, but will not close it. Close must"," // still be called."],"additions":28,"deletions":0,"truncated":false},{"path":"api/response_cache_age_test.go","lines":["@@ -0,0 +1,59 @@","+// Copyright IBM Corp. 2016, 2025","+// SPDX-License-Identifier: MPL-2.0","+","+package api","+","+import (","+\t\"fmt\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+// TestSysRenew_PopulatesAgeFromCachedResponse asserts that a lease renewed","+// through a caching proxy reports how long its response sat in that cache.","+func TestSysRenew_PopulatesAgeFromCachedResponse(t *testing.T) {","+\tt.Parallel()","+","+\tconst (","+\t\tleaseDurationSeconds = 30","+\t\tageSeconds           = 25","+\t)","+","+\tserver, _ := fakeCachedSecretServer(t, leaseDurationSeconds, ageSeconds)","+\tdefer server.Close()","+","+\tclient, err := NewClient(&Config{Address: server.URL})","+\trequire.NoError(t, err)","+","+\tsecret, err := client.Sys().Renew(testCachedLeaseID, leaseDurationSeconds)","+\trequire.NoError(t, err)","+","+\trequire.Equal(t, leaseDurationSeconds, secret.LeaseDuration,","+\t\t\"lease_duration should be reported as the server sent it\")","+\trequire.Equal(t, ageSeconds*time.Second, secret.Age,","+\t\t\"Age header should be surfaced to the caller\")","+}","+","+// TestSysRenew_UncachedResponseHasNoAge asserts that a response served directly","+// by Vault, with no Age header, reports no age.","+func TestSysRenew_UncachedResponseHasNoAge(t *testing.T) {","+\tt.Parallel()","+","+\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tw.Header().Set(\"Content-Type\", \"application/json\")","+\t\tfmt.Fprintf(w, `{\"lease_id\":%q,\"lease_duration\":30,\"renewable\":true}`, testCachedLeaseID)","+\t}))","+\tdefer server.Close()","+","+\tclient, err := NewClient(&Config{Address: server.URL})","+\trequire.NoError(t, err)","+","+\tsecret, err := client.Sys().Renew(testCachedLeaseID, 30)","+\trequire.NoError(t, err)","+","+\trequire.Zero(t, secret.Age, \"a response served directly by Vault has no age\")","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"api/secret.go","lines":["@@ -47,6 +47,14 @@ type Secret struct {"," \t// MountType, if non-empty, provides some information about what kind"," \t// of mount this secret came from."," \tMountType string `json:\"mount_type,omitempty\"`","+","+\t// Age reports how long this response was held by an intermediate cache","+\t// before reaching the client. It is zero for a response served directly by","+\t// Vault. The lifetime a lease has left is its LeaseDuration less its Age.","+\t//","+\t// It is never serialized, because it describes the delivery of a response","+\t// rather than the secret that response carries.","+\tAge time.Duration `json:\"-\"`"," }"," "," // TokenID returns the standardized token ID (token) for the given secret."],"additions":8,"deletions":0,"truncated":false},{"path":"api/ssh.go","lines":["@@ -49,7 +49,7 @@ func (c *SSH) CredentialWithContext(ctx context.Context, role string, data map[s"," \t}"," \tdefer resp.Body.Close()"," ","-\treturn ParseSecret(resp.Body)","+\treturn resp.toSecret()"," }"," "," // SignKey wraps SignKeyWithContext using context.Background.","@@ -74,5 +74,5 @@ func (c *SSH) SignKeyWithContext(ctx context.Context, role string, data map[stri"," \t}"," \tdefer resp.Body.Close()"," ","-\treturn ParseSecret(resp.Body)","+\treturn resp.toSecret()"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"api/sys_leases.go","lines":["@@ -33,7 +33,7 @@ func (c *Sys) RenewWithContext(ctx context.Context, id string, increment int) (*"," \t}"," \tdefer resp.Body.Close()"," ","-\treturn ParseSecret(resp.Body)","+\treturn resp.toSecret()"," }"," "," func (c *Sys) Lookup(id string) (*Secret, error) {","@@ -59,7 +59,7 @@ func (c *Sys) LookupWithContext(ctx context.Context, id string) (*Secret, error)"," \t}"," \tdefer resp.Body.Close()"," ","-\treturn ParseSecret(resp.Body)","+\treturn resp.toSecret()"," }"," "," func (c *Sys) Revoke(id string) error {"],"additions":2,"deletions":2,"truncated":false},{"path":"command/agentproxyshared/cache/cache_test.go","lines":["@@ -969,6 +969,15 @@ func TestCache_Caching_LeaseResponse(t *testing.T) {"," \t\t\tt.Fatal(err)"," \t\t}"," ","+\t\t// Only the cached response was held by the cache, so only it reports an","+\t\t// age; the secret the two carry is otherwise identical. The age itself","+\t\t// is reported in whole seconds, so it rounds to zero on a fast enough","+\t\t// hit and cannot be asserted on here.","+\t\tif proxiedResp.Age != 0 {","+\t\t\tt.Fatalf(\"expected proxied response to report no age, got %s\", proxiedResp.Age)","+\t\t}","+\t\tcachedResp.Age = 0","+"," \t\tif diff := deep.Equal(proxiedResp, cachedResp); diff != nil {"," \t\t\tt.Fatal(diff)"," \t\t}",""],"additions":9,"deletions":0,"truncated":false}],"additions":319,"deletions":19,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-08-11T08:47:40.569870+00:00"}