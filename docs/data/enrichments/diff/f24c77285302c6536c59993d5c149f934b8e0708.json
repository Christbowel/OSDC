 });","+","+      it('keeps the subtitle out of the name button', () => {","+        setup({ assets: [{ ...createMockAsset(1, 'photo.png'), size: 2300 }] });","+        expect(screen.getByRole('button', { name: 'photo.png' })).toBeInTheDocument();","+        expect(screen.getByText('PNG - 2.3MB')).toBeInTheDocument();","+      });","+","+      it('renders no subtitle when nothing is known about the file', () => {","+        const asset = createMockAsset(1, 'file', 'application/octet-stream', '');","+        asset.ext = undefined;","+        setup({ assets: [asset] });","+        expect(screen.queryByText(/ - |KB|×/)).not.toBeInTheDocument();","+      });","+    });","+","     describe('Edge cases', () => {","       it('handles missing mime type', () => {","         const asset = createMockAsset(1, 'file.txt', '', '.txt');"],"additions":29,"deletions":0,"truncated":false},{"path":"packages/core/upload/admin/src/utils/files.ts","lines":["@@ -1,5 +1,7 @@"," import byteSize from 'byte-size';"," ","+import type { File } from '../../../shared/contracts/files';","+"," const MAX_URLS = 20;"," "," /**","@@ -41,6 +43,39 @@ export function formatBytes(receivedBytes: number | string, decimals = 0) {"," export const getFileExtension = (ext?: string | null) =>","   ext && ext[0] === '.' ? ext.substring(1) : ext;"," ","+type AssetSubtitleInput = Pick<File, 'ext' | 'width' | 'height' | 'size'>;","+","+/**","+ * Lists the parts of the secondary line shown under an asset's name: the file","+ * type, the dimensions when the asset has them, and the size. Missing parts are","+ * skipped.","+ *","+ * @param asset - The asset to describe","+ * @returns The known parts, in order (e.g. ['PNG', '2500×3209', '2.3MB'])","+ */","+export const getAssetSubtitleParts = ({ ext, width, height, size }: AssetSubtitleInput) =>","+  [","+    getFileExtension(ext)?.toUpperCase(),","+    width && height ? `${width}×${height}` : null,","+    size ? formatBytes(size, 1) : null,","+  ].filter((part): part is string => Boolean(part));","+","+/**","+ * Builds the secondary line shown under an asset's name on its card. An empty","+ * string is returned when no part is known.","+ *","+ * @param asset - The asset to describe","+ * @returns The parts joined with ' - ' (e.g. \"PNG - 2500×3209 - 2.3MB\")","+ *","+ * @example","+ * ```ts","+ * getAssetSubtitle({ ext: '.png', width: 2500, height: 3209, size: 2300 }) // 'PNG - 2500×3209 - 2.3MB'","+ * getAssetSubtitle({ ext: '.pdf', size: 120 }) // 'PDF - 120.0KB'","+ * ```","+ */","+export const getAssetSubtitle = (asset: AssetSubtitleInput) =>","+  getAssetSubtitleParts(asset).join(' - ');","+"," /**","  * Prefixes a relative file URL with the backend URL if needed.","  *"],"additions":35,"deletions":0,"truncated":false},{"path":"packages/core/upload/admin/src/utils/tests/files.test.ts","lines":["@@ -0,0 +1,45 @@","+import { getAssetSubtitle, getAssetSubtitleParts } from '../files';","+","+describe('getAssetSubtitle', () => {","+  it('shows the type, dimensions and size of an image', () => {","+    expect(getAssetSubtitle({ ext: '.png', width: 2500, height: 3209, size: 2300 })).toBe(","+      'PNG - 2500×3209 - 2.3MB'","+    );","+  });","+","+  it('shows the type and size of an asset without dimensions', () => {","+    expect(getAssetSubtitle({ ext: '.pdf', width: null, height: null, size: 120 })).toBe(","+      'PDF - 120.0KB'","+    );","+  });","+","+  it('skips the dimensions when only one of them is known', () => {","+    expect(getAssetSubtitle({ ext: '.mp4', width: 1920, height: null, size: 1500 })).toBe(","+      'MP4 - 1.5MB'","+    );","+  });","+","+  it('skips missing parts without leaving empty separators', () => {","+    expect(getAssetSubtitle({ width: 800, height: 600, size: 42 })).toBe('800×600 - 42.0KB');","+    expect(getAssetSubtitle({ ext: '.txt' })).toBe('TXT');","+    expect(getAssetSubtitle({ ext: '', size: 0 })).toBe('');","+  });","+","+  it('returns an empty string when nothing is known', () => {","+    expect(getAssetSubtitle({})).toBe('');","+  });","+});","+","+describe('getAssetSubtitleParts', () => {","+  it('lists the known parts in order', () => {","+    expect(getAssetSubtitleParts({ ext: '.png', width: 2500, height: 3209, size: 2300 })).toEqual([","+      'PNG',","+      '2500×3209',","+      '2.3MB',","+    ]);","+  });","+","+  it('returns no parts when nothing is known', () => {","+    expect(getAssetSubtitleParts({})).toEqual([]);","+  });","+});",""],"additions":45,"deletions":0,"truncated":false}],"additions":227,"deletions":8,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-26T18:55:32.534047+00:00"}