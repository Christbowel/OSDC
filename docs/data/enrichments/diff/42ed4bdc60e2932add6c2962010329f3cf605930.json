or) => return Err(error),","+    };","+    if !doc.prepared.is_empty() {","+        return Err(invalid);","+    }","+    let storage = hosted_storage(state, Some(org));","+    let mut base = read_staged_base(&storage, &doc).await?;","+    prepare_publish_document(&storage, &mut doc, &mut base, &now_iso()).await?;","+    Ok(())","+}","+"," /// A publish whose document is computed and whose blobs are fully written to"," /// tmp slots — everything verified, nothing visible to readers yet."," /// [`commit_publishes`](super::commit_publishes) makes it visible. Every surface stages into this, so","@@ -258,6 +278,8 @@ async fn prepare_publish_document(","             &mut doc.incoming,","         )?;","         base.revision_checked = true;","+    } else {","+        doc.name.validate_npm_publish()?;","     }","     if let Some(object) = doc.incoming.as_object_mut() {","         object.remove(\"_rev\");"],"additions":23,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/tests.rs","lines":["@@ -189,3 +189,5 @@ fn semver_validation_is_strict() {"," }"," "," mod fence;","+","+mod names;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/publishing/tests/names.rs","lines":["@@ -0,0 +1,81 @@","+use crate::server::{","+    AuthedCaller,","+    batch::serve_ecosystem_publish,","+    publishing::{atomic::publication_request, publish_package},","+    routing::state_and_router,","+};","+use axum::{","+    body::{Bytes, to_bytes},","+    extract::State,","+    http::{HeaderMap, StatusCode},","+};","+use pnpr_auth::AuthState;","+use pnpr_fixtures::MockConfigPresets;","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};","+use pnpr_policy::Identity;","+use pnpr_storage::metadata::{BatchDocument, PublishNotes, ReleaseRecords};","+use serde_json::{Value, json};","+use tempfile::TempDir;","+","+#[tokio::test]","+async fn legacy_name_retries_return_the_recorded_outcome() {","+    let name = CanonicalPackageName::parse(\"Upper\", Ecosystem::Npm).unwrap();","+    for target in [Some(&name), None] {","+        let temp = TempDir::new().unwrap();","+        let config =","+            crate::Config::static_serve(\"127.0.0.1:0\".parse().unwrap(), temp.path().join(\"store\"));","+        let (state, _) = state_and_router(config, AuthState::in_memory(), None).unwrap();","+        let identity = Identity::user(\"publisher\");","+        let document = json!({","+            \"name\": \"Upper\",","+            \"versions\": { \"1.0.0\": { \"name\": \"Upper\", \"version\": \"1.0.0\" } },","+            \"dist-tags\": { \"latest\": \"1.0.0\" },","+        });","+        let body = match target {","+            Some(_) => document.clone(),","+            None => json!({ \"packages\": [document] }),","+        };","+        let request = publication_request(&identity, &body, None, None, target);","+        let committed = state.inner.storage","+            .sql_metadata()","+            .commit_publication(","+                \"\",","+                vec![BatchDocument {","+                    ecosystem: Ecosystem::Npm,","+                    name: \"Upper\".to_string(),","+                    bytes: serde_json::to_vec(&document).unwrap(),","+                    expected: None,","+                    principal: Some(\"publisher\".to_string()),","+                    records: ReleaseRecords::new(),","+                }],","+                Vec::new(),","+                PublishNotes::default(),","+                request,","+            )","+            .await","+            .unwrap();","+        let bytes = Bytes::from(serde_json::to_vec(&body).unwrap());","+        let response = match target {","+            Some(_) => publish_package(&state, &identity, None, \"Upper\", bytes).await,","+            None => {","+                serve_ecosystem_publish(","+                    State(state),","+                    AuthedCaller(identity),","+                    None,","+                    HeaderMap::new(),","+                    bytes,","+                )","+                .await","+            }","+        };","+        assert_eq!(","+            response.headers()[\"pnpr-generation\"].to_str().unwrap(),","+            format!(\":{}\", committed.generation.value),","+        );","+        let status = response.status();","+        let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+        assert_eq!(status, StatusCode::CREATED, \"{}\", String::from_utf8_lossy(&bytes));","+        let outcome: Value = serde_json::from_slice(&bytes).unwrap();","+        assert_eq!(outcome[\"publication\"], json!(committed.publication));","+    }","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/staged.rs","lines":["@@ -40,7 +40,9 @@ use serde_json::{Value, json};"," use super::{","     Action, AppState, AuthedCaller, Identity, RegistrySource, TargetRegistry, authorize_package,","     commit_publishes, json_response, not_found, private_no_cache,","-    publishing::{ValidatedPublish, cleanup_tmp_slots},","+    publishing::{","+        ValidatedPublish, check_body_name, cleanup_tmp_slots, validate_staged_publish_name,","+    },","     resolve_write_target, stage_publish, validate_publish_doc,"," };"," use pnpr_error::RegistryError;","@@ -223,22 +225,14 @@ async fn serve_staged_publish(","         Ok(value) => value,","         Err(err) => return RegistryError::Json(err).into_response(),","     };","-    let body_name = incoming.get(\"name\").and_then(Value::as_str);","-    if body_name.is_some_and(|body_name| body_name != name.as_str()) {","-        return RegistryError::BadRequest {","-            reason: format!(","-                \"package in URL ({:?}) does not match body ({:?})\",","-                name.as_str(),","-                body_name.unwrap_or(\"\"),","-            ),","-        }","-        .into_response();","+    if let Err(err) = check_body_name(&name, &incoming) {","+        return err.into_response();","     }"," ","     // The same routing + `publish`-rule + attachment validation a direct","     // publish runs; conflicts with already-published versions are checked","     // when the stage is approved, against the registry state at that time.","-    let (validated, _target) =","+    let (validated, target) =","         match validate_publish_doc(state, identity, registry, name, incoming).await {","             Ok(validated) => validated,","             Err(err) => return err.into_response(),","@@ -259,6 +253,9 @@ async fn serve_staged_publish("," ","     let stage_id = generate_stage_id();","     let record = staged_record(&validated, identity, registry, &stage_id);","+    if let Err(err) = validate_staged_publish_name(state, validated, &target.org).await {","+        return err.into_response();","+    }"," ","     if let Err(err) = store_staged(state, &stage_id, body, &record).await {","         return err.into_response();"],"additions":9,"deletions":12,"truncated":false},{"path":"pnpr/crates/pnpr/tests/auth_publish.rs","lines":["@@ -4,6 +4,9 @@"," #[path = \"auth_publish/scoped_publishing.rs\"]"," mod scoped_publishing;"," ","+#[path = \"auth_publish/package_names.rs\"]","+mod package_names;","+"," #[path = \"auth_publish/publish_validation.rs\"]"," mod publish_validation;"," "],"additions":3,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/auth_publish/package_names.rs","lines":["@@ -0,0 +1,205 @@","+use super::{","+    Body, Request, ServiceExt, StatusCode, TempDir, add_user_and_get_token, body_bytes,","+    publish_doc, router, static_config,","+};","+","+#[tokio::test]","+async fn publishing_rejects_invalid_new_names_before_storing_them() {","+    let temp = TempDir::new().unwrap();","+    let app = router(static_config(temp.path().to_path_buf()));","+    let (app, token) = add_user_and_get_token(app, \"publisher\", \"secret\").await;","+    for (name, path) in [","+        (\"demo-UPPER\", \"demo-UPPER\"),","+        (\"demo~pkg\", \"demo%7Epkg\"),","+        (\"demo'pkg\", \"demo%27pkg\"),","+        (\"demo!pkg\", \"demo%21pkg\"),","+        (\"demo(pkg\", \"demo%28pkg\"),","+        (\"demo)pkg\", \"demo%29pkg\"),","+        (\"demo*pkg\", \"demo%2Apkg\"),","+        (\"demoé\", \"demo%C3%A9\"),","+        (\"_demo\", \"_demo\"),","+        (\"http\", \"http\"),","+        (\"node_modules\", \"node_modules\"),","+        (\"demo@x\", \"demo%40x\"),","+        (\"@scope/demo@x\", \"@scope%2Fdemo%40x\"),","+        (\"@Scope/demo\", \"@Scope%2Fdemo\"),","+    ] {","+        let response = app","+            .clone()","+            .oneshot(","+                Request::put(format!(\"/npm/{path}\"))","+                    .header(\"content-type\", \"application/json\")","+                    .header(\"authorization\", format!(\"Bearer {token}\"))","+                    .body(Body::from(","+                        serde_json::to_vec(&publish_doc(name, \"1.0.0\", b\"data\")).unwrap(),","+                    ))","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::BAD_REQUEST, \"{name}\");","+        let error = String::from_utf8(body_bytes(response.into_body()).await).unwrap();","+        assert!(error.contains(name), \"{error}\");","+        assert!(","+            pnpr_fixtures::read_hosted_document(","+                temp.path(),","+                \"\",","+                pnpr_storage::Ecosystem::Npm,","+                name,","+            )","+            .is_none(),","+            \"{name}\",","+        );","+    }","+}","+","+#[tokio::test]","+async fn staged_and_batch_publishes_reject_invalid_new_names() {","+    let temp = TempDir::new().unwrap();","+    let app = router(static_config(temp.path().to_path_buf()));","+    let (app, token) = add_user_and_get_token(app, \"publisher\", \"secret\").await;","+    let invalid = publish_doc(\"demo-UPPER\", \"1.0.0\", b\"data\");","+    for (method, path, body) in [","+        (\"POST\", \"/npm/-/stage/package/demo-UPPER\", invalid.clone()),","+        (\"PUT\", \"/npm/-/pnpr/v0/publish\", serde_json::json!({ \"packages\": [invalid] })),","+    ] {","+        let response = app","+            .clone()","+            .oneshot(","+                Request::builder()","+                    .method(method)","+                    .uri(path)","+                    .header(\"content-type\", \"application/json\")","+                    .header(\"authorization\", format!(\"Bearer {token}\"))","+                    .body(Body::from(serde_json::to_vec(&body).unwrap()))","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), StatusCode::BAD_REQUEST, \"{path}\");","+        let error = String::from_utf8(body_bytes(response.into_body()).await).unwrap();","+        assert!(error.contains(\"demo-UPPER\"), \"{error}\");","+        assert!(","+            pnpr_fixtures::read_hosted_document(","+                temp.path(),","+                \"\",","+                pnpr_storage::Ecosystem::Npm,","+                \"demo-UPPER\",","+            )","+            .is_none(),","+        );","+    }","+}","+","+#[tokio::test]","+async fn legacy_names_allow_direct_and_staged_deprecation_but_not_new_versions() {","+    let temp = TempDir::new().unwrap();","+    pnpr_storage::layout::write_local_layout_marker(temp.path()).unwrap();","+    let mut legacy = publish_doc(\"Upper\", \"1.0.0\", b\"data\");","+    legacy","+        .as_object_mut()","+        .unwrap()","+        .remove(\"_attachments\");","+    pnpr_fixtures::write_hosted_document(","+        temp.path(),","+        \"\",","+        pnpr_storage::Ecosystem::Npm,","+        \"Upper\",","+        &serde_json::to_vec(&legacy).unwrap(),","+    );","+    let app = router(static_config(temp.path().to_path_buf()));","+    let (app, token) = add_user_and_get_token(app, \"publisher\", \"secret\