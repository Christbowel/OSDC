mes retain their legacy","+read behavior.","+"," The npm base (`/npm/`) aliases the registry named by `defaultRegistry`. With"," no `defaultRegistry` configured, it serves no registry and only the"," `/npm/~<name>/` bases answer.",""],"additions":6,"deletions":0,"truncated":false}],"additions":484,"deletions":30,"truncated":false,"file_count":19},"error":null,"fetched_at":"2026-11-07T15:03:35.421236+00:00"}