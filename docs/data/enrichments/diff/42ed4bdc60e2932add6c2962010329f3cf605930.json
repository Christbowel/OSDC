           let response = app","+                .clone()","+                .oneshot(","+                    Request::post(format!(\"/npm/-/stage/{stage_id}/approve\"))","+                        .header(\"authorization\", format!(\"Bearer {token}\"))","+                        .body(Body::empty())","+                        .unwrap(),","+                )","+                .await","+                .unwrap();","+            let status = response.status();","+            let error = body_bytes(response.into_body()).await;","+            assert_eq!(status, StatusCode::CREATED, \"{}\", String::from_utf8_lossy(&error));","+        }","+        let response = app","+            .clone()","+            .oneshot(get())","+            .await","+            .unwrap();","+        let stored: serde_json::Value =","+            serde_json::from_slice(&body_bytes(response.into_body()).await).unwrap();","+        assert_eq!(stored[\"versions\"][\"1.0.0\"][\"deprecated\"].as_str(), deprecated);","+    }","+    let new_version = publish_doc(\"Upper\", \"2.0.0\", b\"data\");","+    let mut without_attachment = new_version.clone();","+    without_attachment","+        .as_object_mut()","+        .unwrap()","+        .remove(\"_attachments\");","+    for (method, path, body) in [","+        (\"PUT\", \"/npm/Upper\", new_version.clone()),","+        (\"POST\", \"/npm/-/stage/package/Upper\", new_version),","+        (\"POST\", \"/npm/-/stage/package/Upper\", without_attachment),","+    ] {","+        let response = app","+            .clone()","+            .oneshot(","+                Request::builder()","+                    .method(method)","+                    .uri(path)","+                    .header(\"content-type\", \"application/json\")","+                    .header(\"authorization\", format!(\"Bearer {token}\"))","+                    .body(Body::from(serde_json::to_vec(&body).unwrap()))","+                    .unwrap(),","+            )","+            .await","+         