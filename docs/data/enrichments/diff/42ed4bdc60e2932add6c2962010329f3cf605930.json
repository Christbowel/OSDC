,"     drop(root);"," }"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-name/src/lib.rs","lines":["@@ -1,4 +1,4 @@","-//! npm package-name validation using the `validForOldPackages` rules.","+//! npm package-name validation for dependencies and new publications."," "," pub use is_valid_old_npm_package_name as is_valid_dependency_alias;"," ","@@ -14,6 +14,63 @@ pub fn is_valid_package_version(version: &str) -> bool {","         && components.next().is_none()"," }"," ","+/// Whether npm's `validate-npm-package-name` v7 accepts `name` for new packages.","+#[must_use]","+pub fn is_valid_new_npm_package_name(name: &str) -> bool {","+    let basename = name.rsplit('/').next().unwrap_or(name);","+    is_valid_old_npm_package_name(name)","+        && name.len() <= 214","+        && !name.bytes().any(|byte| byte.is_ascii_uppercase())","+        && !basename.contains(['~', '\\'', '!', '(', ')', '*'])","+        && !BUILTIN_MODULES.contains(&name)","+}","+","+// validate-npm-package-name's built-ins that can pass the old-name grammar.","+const BUILTIN_MODULES: &[&str] = &[","+    \"assert\",","+    \"async_hooks\",","+    \"buffer\",","+    \"child_process\",","+    \"cluster\",","+    \"console\",","+    \"constants\",","+    \"crypto\",","+    \"dgram\",","+    \"diagnostics_channel\",","+    \"dns\",","+    \"domain\",","+    \"events\",","+    \"fs\",","+    \"http\",","+    \"http2\",","+    \"https\",","+    \"inspector\",","+    \"module\",","+    \"net\",","+    \"os\",","+    \"path\",","+    \"perf_hooks\",","+    \"process\",","+    \"punycode\",","+    \"querystring\",","+    \"readline\",","+    \"repl\",","+    \"stream\",","+    \"string_decoder\",","+    \"sys\",","+    \"timers\",","+    \"tls\",","+    \"trace_events\",","+    \"tty\",","+    \"url\",","+    \"util\",","+    \"v8\",","+    \"vm\",","+    \"wasi\",","+    \"worker_threads\",","+    \"zlib\",","+];","+"," /// Whether npm's `validate-npm-package-name` v7 accepts `name` for old packages."," /// Warning-only names remain valid, including uppercase names and legacy lengths."," #[must_use]"],"additions":58,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-name/src/tests.rs","lines":["@@ -59,3 +59,47 @@ fn is_valid_package_version_rejects_traversals_and_separators() {","         assert!(!is_valid_package_version(bad), \"{bad:?} should be invalid\");","     }"," }","+","+#[test]","+fn new_package_names_reject_legacy_warnings() {","+    for name in [\"Upper\", \"@Upper/pkg\", \"a~b\", \"a'b\", \"a!b\", \"a(b\", \"a)b\", \"a*b\", \"http\", \"fs\"] {","+        assert!(super::is_valid_old_npm_package_name(name), \"{name}\");","+        assert!(!super::is_valid_new_npm_package_name(name), \"{name}\");","+    }","+    assert!(!super::is_valid_new_npm_package_name(&\"a\".repeat(215)));","+    assert!(super::is_valid_new_npm_package_name(&\"a\".repeat(214)));","+}","+","+#[test]","+fn new_package_names_follow_npm_scoped_rules() {","+    for name in [","+        \"pkg\",","+        \"pkg.name\",","+        \"pkg_name\",","+        \"1\",","+        \"@scope/pkg\",","+        \"@scope/_pkg\",","+        \"@scope/-pkg\",","+        \"@~scope/pkg\",","+        \"@scope/http\",","+    ] {","+        assert!(super::is_valid_new_npm_package_name(name), \"{name}\");","+    }","+    for name in [","+        \"\",","+        \"-pkg\",","+        \"_pkg\",","+        \".pkg\",","+        \"node_modules\",","+        \"favicon.ico\",","+        \"pkg@x\",","+        \"@scope/pkg@x\",","+        \"@scope/.pkg\",","+        \"@scope/pkg~\",","+        \"café\",","+        \"@scope/café\",","+        \"@scope/pkg/extra\",","+    ] {","+        assert!(!super::is_valid_new_npm_package_name(name), \"{name}\");","+    }","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"pnpr/crates/package-name/Cargo.toml","lines":["@@ -11,6 +11,7 @@ license-file = \"../../LICENSE.md\""," repository.workspace = true"," "," [dependencies]","+pnpm-pac