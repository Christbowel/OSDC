tart\":","+                self.send_response(302)","+                self.send_header(\"Location\", \"/next\")","+                self.end_headers()","+            else:","+                self.send_response(200)","+                self.end_headers()","+                self.wfile.write(b\"final\")","+","+        def log_message(self, format, *args):","+            pass","+","+    target = ThreadingHTTPServer((\"127.0.0.1\", 0), RedirectHandler)","+    target_thread = threading.Thread(target=target.serve_forever, daemon=True)","+    target_thread.start()","+","+    try:","+        global server","+        server.ui_mcp_proxy = True","+        server.debug_proxy_allow_private = True","+        server.start()","+","+        url = server.make_url(f\"/cors-proxy?url=http://127.0.0.1:{target.server_port}/start\")","+        # redirect points back to the proxy","+        res = requests.get(url, allow_redirects=False)","+        assert res.status_code == 302","+        assert res.headers[\"Location\"] == f\"?url=http%3A%2F%2F127.0.0.1%3A{target.server_port}%2Fnext\"","+        res = requests.get(url)","+        assert res.status_code == 200","+        assert res.text == \"final\"","+    finally:","+        target.shutdown()","+        target.server_close()"],"additions":61,"deletions":0,"truncated":false},{"path":"tools/server/tests/unit/test_security.py","lines":["@@ -314,6 +314,7 @@ def log_message(self, format, *args):","         server = ServerPreset.tinyllama2()","         server.api_key = TEST_API_KEY","         server.ui_mcp_proxy = True","+        server.debug_proxy_allow_private = True","         server.start()"," ","         res = server.make_request(\"GET\", f\"/cors-proxy?url=http://127.0.0.1:{target.server_port}/capture\", headers={"],"additions":1,"deletions":0,"truncated":false},{"path":"tools/server/tests/unit/test_vision_api.py","lines":["@@ -204,3 +204,41 @@ def test_vision_embeddings_oai_content():","     # same prompt and image in both formats","     as