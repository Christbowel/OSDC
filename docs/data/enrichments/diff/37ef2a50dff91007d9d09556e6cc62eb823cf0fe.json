$final_:path","@@ -67,11 +66,9 @@ macro_rules! new_hasher {","             }"," ","             pub fn hash(bytes: &[u8], out: &mut [u8; $digest_size]) {","-                // SAFETY: `out` is exactly DIGEST bytes; BoringSSL one-shot hashers","-                // accept (ptr, len, out) and never read past `len`.","-                unsafe {","-                    let _ = $full(bytes.as_ptr(), bytes.len(), out.as_mut_ptr());","-                }","+                let mut this = Self::init();","+                this.update(bytes);","+                this.r#final(out);","             }"," ","             pub fn update(&mut self, data: &[u8]) {","@@ -258,7 +255,6 @@ pub mod hashers {","         SHA1,","         SHA1_DIGEST_LENGTH,","         boringssl_sys::SHA_CTX,","-        boringssl_sys::SHA1,","         boringssl_sys::SHA1_Init,","         boringssl_sys::SHA1_Update,","         boringssl_sys::SHA1_Final","@@ -268,7 +264,6 @@ pub mod hashers {","         SHA256,","         SHA256_DIGEST_LENGTH,","         boringssl_sys::SHA256_CTX,","-        boringssl_sys::SHA256,","         boringssl_sys::SHA256_Init,","         boringssl_sys::SHA256_Update,","         boringssl_sys::SHA256_Final"],"additions":4,"deletions":9,"truncated":false},{"path":"test/js/bun/test/parallel/test-http-should-not-accept-untrusted-certificates.ts","lines":["@@ -7,9 +7,8 @@ const { expect } = createTest(import.meta.path);"," "," await using server = https.createServer(","   {","-    key: nodefs.readFileSync(path.join(import.meta.dir, \"../../..\", \"node/http/fixtures\", \"openssl.key\")),","-    cert: nodefs.readFileSync(path.join(import.meta.dir, \"../../..\", \"node/http/fixtures\", \"openssl.crt\")),","-    passphrase: \"123123123\",","+    key: nodefs.readFileSync(path.join(import.meta.dir, \"../../..\", \"node/tls/fixtures\", \"agent1-key.pem\")),","+    cert: nodefs.readFileSync(path.join(import.meta.dir, \"../../..\", \"node/tls/fixtures\", \"agent1-cert.pem\")),","   },","   (req, res) => {","     res.write(\"Hello from https server\");"],"additions":2,"deletions":3,"truncated":false},{"path":"test/js/node/quic/quic-sni.test.ts","lines":["@@ -212,6 +212,25 @@ test(\"opened reports CERT_REVOKED for a chain through a blocked public key\", asy","   }"," });"," ","+test(\"an expired intermediate in `ca` does not shadow the valid one the server sends\", async () => {","+  const read = (name: string) =>","+    readFileSync(join(import.meta.dir, \"..\", \"tls\", \"fixtures\", \"expired-intermediate\", name));","+  const identity = {","+    keys: [createPrivateKey(read(\"leaf.key\"))],","+    certs: [Buffer.concat([read(\"leaf.pem\"), read(\"int-valid.pem\")])],","+  };","+  await using server = await listen(ignoreErrors, { sni: { \"*\": identity }, alpn: [\"quic-test\"] });","+  const session = await connect(server.address!, {","+    alpn: \"quic-test\",","+    servername: \"localhost\",","+    verifyPeer: \"manual\",","+    ca: [read(\"root.pem\"), read(\"int-expired.pem\")],","+  } as SessionOptions);","+  const info = await session.opened;","+  await session.close();","+  expect(info.validationErrorCode).toBeUndefined();","+});","+"," test(\"verifyPeer 'strict' and 'auto' refuse a certificate with a blocked public key\", async () => {","   // Unlike agent6's, this certificate names its host, which both modes check.","   const fixtures = join(import.meta.dir, \"..\", \"tls\", \"fixtures\");"],"additions":19,"deletions":0,"truncated":false},{"path":"test/js/node/tls/fixtures/trust-anchor/gen.sh","lines":["@@ -0,0 +1,49 @@","+#!/bin/bash","+# Regenerates the certificates of this directory, in the current directory. Needs OpenSSL 3.","+set -e","+tmp=$(mktemp -d)","+key() { openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out \"$1\"; }","+# sign <name> <key> <subject> <\"self\" or the name of the issuer> <extensions>","+sign() {","+  openssl req -new -key \"$2\" -subj \"$3\" -out \"$tmp/csr\"","+  printf \"$5\" > \"$tmp/ext\"","+  if [ \"$4\" = self ]; then signer=(-signkey \"$2\"); else signer=(-CA \"$4.pem\" -CAkey \"$tmp/$4.key\" -set_serial \"0x$(openssl rand -hex 8)\"); fi","+  openssl x509 -req -in \"$tmp/csr\" \"${signer[@]}\" -extfile \"$tmp/ext\" -days 36500 -sha256 -out \"$1.pem\" 2> /dev/null","+}","+key \"$tmp/root.key\"","+key \"$tmp/intermediate.key\"","+key leaf.key","+ca='basicConstraints=critical,CA:TRUE\\nkeyUsage=critical,keyCertSign,cRLSign\\n'","+# Every root has the same name and key, so each of them issued the intermediate.","+sign root \"$tmp/root.key\" /CN=trust-anchor-root self \"$ca\"","+sign root-pathlen-0 \"$tmp/root.key\" /CN=trust-anchor-root self 'basicConstraints=critical,CA:TRUE,pathlen:0\\nkeyUsage=critical,keyCertSign\\n'","+sign root-client-eku \"$tmp/root.key\" /CN=trust-anchor-root self \"${ca}extendedKeyUsage=clientAuth\\n\"","+sign root-not-a-ca \"$tmp/root.key\" /CN=trust-anchor-root self 'basicConstraints=critical,CA:FALSE\\n'","+sign root-unknown-critical \"$tmp/root.key\" /CN=trust-anchor-root self \"${ca}1.2.3.4=critical,ASN1:NULL\\n\"","+sign root-key-usage-only \"$tmp/root.key\" /CN=trust-anchor-root self 'keyUsage=critical,keyCertSign\\n'","+sign intermediate \"$tmp/intermediate.key\" /CN=trust-anchor-intermediate root \"${ca}authorityKeyIdentifier=keyid\\n\"","+sign leaf leaf.key /CN=localhost intermediate 'basicConstraints=critical,CA:FALSE\\nextendedKeyUsage=serverAuth\\nsubjectAltName=DNS:localhost\\n'","+sign self-signed-client-eku leaf.key /CN=localhost self 'extendedKeyUsage=clientAuth\\nsubjectAltName=DNS:localhost\\n'","+sign self-signed leaf.key /CN=localhost self 'subjectAltName=DNS:localhost\\n'","+cp leaf.key \"$tmp/self-signed.key\"","+# crl <name> <issuer> <extensions> [revoked certificate] [arguments of -gencrl]","+crl() {","+  : > \"$tmp/index.txt\"","+  printf \"[ca]\\ndefault_ca=d\\n[d]\\ndatabase=$tmp/index.txt\\ndefault_md=sha256\\ndefault_crl_days=36500\\ncrl_extensions=e\\n[e]\\nauthorityKeyIdentifier=keyid\\n$3\" > \"$tmp/cnf\"","+  signer=(-config \"$tmp/cnf\" -keyfile \"$tmp/$2.key\" -cert \"$2.pem\")","+  if [ -n \"$4\" ]; then openssl ca \"${signer[@]}\" -revoke \"$4.pem\" 2> /dev/null; fi","+  openssl ca \"${signer[@]}\" -gencrl \"${@:5}\" -out \"$1.crl\" 2> /dev/null","+}","+crl root-empty root","+crl root-revokes-intermediate root '' intermediate","+crl root-revokes-itself root '' root","+crl self-signed-empty self-signed","+crl self-signed-revokes-itself self-signed '' self-signed","+crl self-signed-expired self-signed '' '' -crl_lastupdate 20200101000000Z -crl_nextupdate 20200102000000Z","+crl self-signed-not-yet-valid self-signed '' '' -crl_lastupdate 21000101000000Z -crl_nextupdate 21000102000000Z","+crl intermediate-empty intermediate","+crl intermediate-revokes-leaf intermediate '' leaf","+# Newer than the one above, so that it wins if it is taken for a CRL of the same scope.","+sleep 2","+crl intermediate-attribute-certificates intermediate 'issuingDistributionPoint=critical,@idp\\n[idp]\\nonlyAA=TRUE\\n'","+rm -r \"$tmp\""],"additions":49,"deletions":0,"truncated":false},{"path":"test/js/node/tls/fixtures/trust-anchor/intermediate-attribute-certificates.crl","lines":["@@ -0,0 +1,7 @@","+-----BEGIN X509 CRL-----","+MIHlMIGLAgEBMAoGCCqGSM49BAMCMCQxIjAgBgNVBAMMGXRydXN0LWFuY2hvci1p","+bnRlcm1lZGlhdGUXDTI2MTExNzAxNDYyN1oYDzIxMjYxMDI0MDE0NjI3WqA0MDIw","+HwYDVR0jBBgwFoAUJ8PSXWaN2v6fHmMYq/EKiMFy2UUwDwYDVR0cAQH/BAUwA4UB","+/zAKBggqhkjOPQQDAgNJADBGAiEAovVJJx062LC6UBmmgmvEvZ6a+sUNv36Ejrvs","+hLn0jB0CIQCiPxSwXdCLGeJsNr8buR4oJJXIdVgn7dqHqSW2A7v9Mw==","+-----END X509 CRL-----"],"additions":7,"deletions":0,"truncated":false},{"path":"test/js/node/tls/fixtures/trust-anchor/intermediate-empty.crl","lines":["@@ -0,0 +1,7 @@","+-----BEGIN X509 CRL-----","+MIHSMHoCAQEwCgYIKoZIzj0EAwIwJDEiMCAGA1UEAwwZdHJ1c3QtYW5jaG9yLWlu","+dGVybWVkaWF0ZRcNMjYxMTE3MDE0NjI1WhgPMjEyNjEwMjQwMTQ2MjVaoCMwITAf","+BgNVHSMEGDAWgBQnw9JdZo3a/p8eYxir8QqIwXLZRTAKBggqhkjOPQQDAgNIADBF","+AiEAlJW4T5msP8PL6SZuQJkI+