on                *prometheus.HistogramVec","+\tEmbedTokensTotal             *prometheus.CounterVec"," \tRerankDuration               *prometheus.HistogramVec"," \tRerankCandidatesTotal        *prometheus.CounterVec"," \tRerankDroppedResultsTotal    *prometheus.CounterVec","@@ -51,6 +52,10 @@ func ProvideVectorMetrics(reg prometheus.Registerer) *VectorMetrics {"," \t\t\tNativeHistogramMaxBucketNumber:  160,"," \t\t\tNativeHistogramMinResetDuration: time.Hour,"," \t\t}, []string{\"model\", \"task\", \"status\"}),","+\t\tEmbedTokensTotal: promauto.With(reg).NewCounterVec(prometheus.CounterOpts{","+\t\t\tName: \"vector_storage_embed_tokens_total\",","+\t\t\tHelp: \"Total input tokens sent to the embedding provider, as reported by the provider. Multiply by the model's per-token price for spend.\",","+\t\t}, []string{\"model\", \"task\"}),"," \t\tRerankDuration: promauto.With(reg).NewHistogramVec(prometheus.HistogramOpts{"," \t\t\tName:                            \"vector_storage_rerank_duration_seconds\","," \t\t\tHelp:                            \"Time (in seconds) spent in a single rerank Scorer call to the provider (Vertex/Bedrock), labeled by model and status (ok|error|timeout).\","],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/storage/unified/search/embed/backfill/backfill_test.go","lines":["@@ -16,6 +16,7 @@ import ("," \t\"github.com/openai/openai-go/v3\""," \t\"github.com/prometheus/client_golang/prometheus\""," \t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\tdto \"github.com/prometheus/client_model/go\""," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\""," \tgrpccodes \"google.golang.org/grpc/codes\"","@@ -58,19 +59,90 @@ func makeListItem(ns, name string, rv int64) listItem {"," \t}"," }"," ","+// dashboardJSONWithFolder is minimalDashboardJSON annotated with a folder UID.","+func dashboardJSONWithFolder(uid, title, folderUID string) []byte {","+\tbody, _ := json.Marshal(map[string]any{","+\t\t\"uid\":   uid,","+\t\t\"title\": title,","+\t\t\"panels\": []any{","+\t\t\tmap[string]any{","+\t\t\t\t\"id\":          1,","+\t\t\t\t\"title\":       \"CPU\",","+\t\t\t\t\"description\": \"CPU usage\",","+\t\t\t},","+\t\t},","+\t\t\"metadata\": map[string]any{","+\t\t\t\"annotations\": map[string]any{","+\t\t\t\t\"grafana.app/folder\": folderUID,","+\t\t\t},","+\t\t},","+\t})","+\treturn body","+}","+","+// makeListItemWithFolder is makeListItem plus a folder annotation.","+func makeListItemWithFolder(ns, name string, rv int64, folderUID string) listItem {","+\treturn listItem{","+\t\tNamespace: ns,","+\t\tName:      name,","+\t\tRV:        rv,","+\t\tValue:     dashboardJSONWithFolder(name, name+\"-title\", folderUID),","+\t}","+}","+","+// seedFolder makes a folder resource readable by fakeStorage.ReadResource so","+// FolderTitleResolver.Title can resolve it.","+func (f *fakeStorage) seedFolder(ns, uid, title string) {","+\tvalue, _ := json.Marshal(map[string]any{\"spec\": map[string]any{\"title\": title}})","+\tf.resources[storeKey(ns, \"folder.grafana.app\", \"folders\", uid)] = storedResource{Value: value}","+}","+"," func newBackfiller(t *testing.T, storage *fakeStorage, vec *fakeVector) *VectorBackfiller {","+\tt.Helper()","+\treturn newBackfillerWithBuilders(t, storage, vec, dashboard.New())","+}","+","+// newBackfillerWithBuilders lets version-aware tests swap in a builder that","+// reports a different Version() than the real dashboard extractor.","+func newBackfillerWithBuilders(t *testing.T, storage *fakeStorage, vec *fakeVector, builders ...embed.Builder) *VectorBackfiller {"," \tt.Helper()"," \temb := newFakeEmbedder(&fakeText{dim: 4})"," \tb, err := NewVectorBackfiller(Options{"," \t\tStorage:       storage,"," \t\tVectorBackend: vec,"," \t\tBatchEmbedder: embedder.NewBatchEmbedder(*emb),","-\t\tBuilders:      []embed.Builder{dashboard.New()},","+\t\tBuilders:      builders,"," \t})"," \trequire.NoError(t, err)"," \treturn b"," }"," ","+// newBackfillerWithEmbedder is newBackfiller exposing the fake embedder so","+// tests can assert whether the provider was called.","+func newBackfillerWithEmbedder(t *testing.T, storage *fakeStorage, vec *fakeVector) (*VectorBackfiller, *fakeText) {","+\tt.Helper()","+\ttext := &fakeText{dim: 4}","+\temb := newFakeEmbedder(text)","+\tb, err := NewVectorBackfiller(Options{","+\t\tStorage:       storage,","+\t\tVectorBackend: vec,","+\t\tBatchEmbedder: embedder.NewBatchEmbedder(*emb),","+\t\tBuilders:      []embed.Builder{dashboard.New()},","+\t})","+\trequire.NoError(t, err)","+\treturn b, text","+}","+","+// versionedBuilder wraps a real Builder but reports a different Version(),","+// so tests can simulate an extractor content-shape bump without a second","+// real extractor implementation.","+type versionedBuilder struct {","+\tembed.Builder","+\tversion int","+}","+","+func (v versionedBuilder) Version() int { return v.version }","+"," func TestRunBackfill_NoIncompleteJobs_NoOp(t *testing.T) {"," \tvec := newFakeVector()"," \to := newBackfiller(t, newFakeStorage(), vec)","@@ -149,6 +221,68 @@ func TestBackfill_ObservesItemDuration(t *testing.T) {"," \trequire.Equal(t, 1, testutil.CollectAndCount(m.BackfillItemDuration, \"vector_storage_backfill_item_duration_seconds\"))"," }"," ","+// TestRunBackfillJob_FolderTitle_PrefixesBreadcrumb covers the wiring: the","+// backfiller resolves the folder title via storage and passes it to Extract,","+// which prefixes the breadcrumb.","+func TestRunBackfillJob_FolderTitle_PrefixesBreadcrumb(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItemWithFolder(\"ns-1\", \"dash-a\", 50, \"folder-uid\")}","+\tstorage.seedFolder(\"ns-1\", \"folder-uid\", \"Production\")","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.upserts, 1)","+\trequire.NotEmpty(t, vec.upserts[0])","+\tassert.Contains(t, vec.upserts[0][0].Content, \"Production → dash-a-title\")","+}","+","+// TestRunBackfillJob_FolderTitleCache_ScopedToJobRun covers the per-job-run","+// cache: two dashboards sharing a folder within one job run resolve it once.","+func TestRunBackfillJob_FolderTitleCache_ScopedToJobRun(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{","+\t\tmakeListItemWithFolder(\"ns-1\", \"dash-a\", 50, \"folder-uid\"),","+\t\tmakeListItemWithFolder(\"ns-1\", \"dash-b\", 60, \"folder-uid\"),","+\t}","+\tstorage.seedFolder(\"ns-1\", \"folder-uid\", \"Production\")","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.upserts, 2)","+\tassert.Contains(t, vec.upserts[0][0].Content, \"Production →\")","+\tassert.Contains(t, vec.upserts[1][0].Content, \"Production →\")","+\tassert.Len(t, o.folderTitleCache, 1, \"one cache entry shared across both dashboards in the same folder\")","+\tassert.Equal(t, \"Production\", o.folderTitleCache[\"ns-1/folder-uid\"])","+}","+","+// TestRunBackfillJob_FolderTitleResolveError_FailsJob covers the retry","+// contract: a folder-title storage error is a transient item error, so the","+// whole job is marked errored for the next tick — not skipped like a","+// deterministic Extract failure.","+func TestRunBackfillJob_FolderTitleResolveError_FailsJob(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItemWithFolder(\"ns-1\", \"dash-a\", 50, \"folder-uid\")}","+\tstorage.readErr = errors.New(\"connection refused\")","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts)","+\trequire.Len(t, vec.errorMarks, 1, \"resolver error must fail the job for retry, not skip the item\")","+\tassert.Empty(t, vec.completedJobIDs)","+}","+"," func TestRunBackfillJob_HappyPath_EmbedsAndCompletes(t *testing.T) {"," \tstorage := newFakeStorage()"," \tstorage.listItems = []listItem{","@@ -179,6 +313,450 @@ func TestRunBackfillJob_HappyPath_EmbedsAndCompletes(t *testing.T) {"," \t}"," }"," ","+func TestRunBackfillJob_StampsBuilderVersion(t *testing.T) {","+\t// Upserted vectors carry the builder's content-format version, not","+\t// whatever the RV or an arbitrary literal happens to be.","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns-1\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.upserts, 1)","+\trequire.NotEmpty(t, vec.upserts[0])","+\tfor _, v := range vec.upserts[0] {","+\t\tassert.Equal(t, dashboard.New().Version(), v.ContentVersion)","+\t}","+}","+","+// TestRunBackfillJob_VersionBump_ReEmbedsAtNewVersion covers the incremental","+// re-embed case: a uid embedded under an older extractor version is not","+// skipped, and the rewritten rows carry the current builder version.","+func TestRunBackfillJob_VersionBump_ReEmbedsAtNewVersion(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 1, \"panel/1\")","+","+\tbuilder := versionedBuilder{dashboard.New(), 2}","+\to := newBackfillerWithBuilders(t, storage, vec, builder)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.upserts, 1, \"version bump must re-embed, not skip\")","+\tfor _, v := range vec.upserts[0] {","+\t\tassert.Equal(t, 2, v.ContentVersion, \"re-embedded rows carry the builder's current version\")","+\t}","+}","+","+// TestRunBackfillJob_SameVersion_Skips is the ContentVersion analogue of the","+// old Exists-based skip: a uid already at the builder's version is left alone.","+func TestRunBackfillJob_SameVersion_Skips(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 2, \"panel/1\")","+","+\tbuilder := versionedBuilder{dashboard.New(), 2}","+\to := newBackfillerWithBuilders(t, storage, vec, builder)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts, \"same version must skip re-embedding\")","+}","+","+// TestRunBackfillJob_StoredVersionAheadOfBuilder_Skips covers a builder","+// rollback: stored rows are ahead of the (rolled-back) builder version. The","+// >= rule in the skip check means this still counts as already embedded.","+func TestRunBackfillJob_StoredVersionAheadOfBuilder_Skips(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 3, \"panel/1\")","+","+\tbuilder := versionedBuilder{dashboard.New(), 2}","+\to := newBackfillerWithBuilders(t, storage, vec, builder)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts, \"stored version ahead of the builder must still skip\")","+}","+","+// TestRunBackfillJob_ReEmbedDropsStalePanel_DeletesStaleSubresource proves","+// the backfiller's write path uses UpsertReplaceSubresources (not a plain","+// Upsert): when a re-embed's extractor output no longer includes a panel","+// that was previously stored, that stale row is gone afterward.","+func TestRunBackfillJob_ReEmbedDropsStalePanel_DeletesStaleSubresource(t *testing.T) {","+\tstorage := newFakeStorage()","+\t// minimalDashboardJSON only ever emits panel/1; panel/2 below is stale","+\t// content left over from a previous version of this dashboard.","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 1, \"panel/1\", \"panel/2\")","+","+\tbuilder := versionedBuilder{dashboard.New(), 2}","+\to := newBackfillerWithBuilders(t, storage, vec, builder)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.replaceCalls, 1)","+\tassert.Equal(t, []string{\"panel/1\"}, vec.replaceCalls[0].Desired, \"extractor no longer emits panel/2\")","+","+\t_, stillThere := vec.rows[rowsKey(\"ns\", \"test-model\", \"dashboards\", \"dash-a\")][\"panel/2\"]","+\tassert.False(t, stillThere, \"stale subresource row must be gone after the replace\")","+}","+","+// extractDashboardItems runs the real dashboard extractor so tests can seed","+// a fakeVector with ground-truth content instead of guessing the breadcrumb","+// string by hand.","+func extractDashboardItems(t *testing.T, ns, name string, value []byte, folderTitle string) []embed.Item {","+\tt.Helper()","+\tkey := &resourcepb.ResourceKey{Group: \"dashboard.grafana.app\", Resource: \"dashboards\", Namespace: ns, Name: name}","+\titems, err := dashboard.New().Extract(context.Background(), key, value, folderTitle)","+\trequire.NoError(t, err)","+\treturn items","+}","+","+// TestRunBackfillJob_VersionStale_IdenticalContent_SkipsEmbedAndTouchesVersion","+// covers the version-bump short-circuit this task adds: a root-folder","+// dashboard's v1 and v2 extracted content are byte-identical (root-folder","+// dashboards have no folder title to prefix onto the breadcrumb), so the","+// backfiller must not pay a provider call — it just stamps the row at the","+// builder's current version.","+// The identical-content path adds two new failure modes; both must be item","+// errors that fail the job (retry path), never silent skips — a swallowed","+// UpdateContentVersion error would leave the uid version-stale and rescanned","+// on every tick forever.","+// A concurrent edit must not lose its embeddings to a stale empty-extract delete.","+func TestRunBackfillJob_EmptyExtractDelete_GuardedByLiveRV(t *testing.T) {","+\tstorage := newFakeStorage()","+\t// Scanned snapshot (RV 50) has no embeddable panels; the live resource","+\t// has moved on (RV 60) — the reconciler owns the newer revision.","+\tbody, _ := json.Marshal(map[string]any{\"uid\": \"dash-a\", \"title\": \"empty\"})","+\tstorage.listItems = []listItem{{Namespace: \"ns\", Name: \"dash-a\", RV: 50, Value: body}}","+\tstorage.resources[storeKey(\"ns\", \"dashboard.grafana.app\", \"dashboards\", \"dash-a\")] = storedResource{","+\t\tValue: minimalDashboardJSON(\"dash-a\", \"dash-a-title\"), RV: 60,","+\t}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 1, \"panel/1\")","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.deletes, \"stale empty extract must not delete the newer revision's rows\")","+}","+","+// A dashboard deleted after the scan must not be re-created from the stale snapshot.","+func TestRunBackfillJob_DeletedSinceScan_SkipsWrite(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+\tstorage.markNotFound(\"ns\", \"dashboard.grafana.app\", \"dashboards\", \"dash-a\")","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts, \"deleted dashboard must not be re-embedded\")","+\tassert.Empty(t, vec.replaceCalls)","+\trequire.Len(t, vec.completedJobIDs, 1)","+}","+","+// A transient live-read failure retries the item instead of writing stale content.","+func TestRunBackfillJob_LiveReadError_FailsJob(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+\tstorage.readErr = errors.New(\"storage flake\")","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts)","+\tassert.Empty(t, vec.replaceCalls)","+\trequire.Len(t, vec.errorMarks, 1, \"read failure must mark the job errored for retry\")","+\tassert.Empty(t, vec.completedJobIDs)","+}","+","+// A concurrent edit between scan and write must not be overwritten with stale content.","+func TestRunBackfillJob_RVChangedSinceScan_SkipsWrite(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+\t// Live resource has moved past the scanned RV (a concurrent edit).","+\tstorage.resources[storeKey(\"ns\", \"dashboard.grafana.app\", \"dashboards\", \"dash-a\")] = storedResource{","+\t\tValue: minimalDashboardJSON(\"dash-a\", \"dash-a-title\"), RV: 60,","+\t}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts, \"stale scan must not overwrite the newer revision\")","+\tassert.Empty(t, vec.replaceCalls)","+\trequire.Len(t, vec.completedJobIDs, 1, \"skip is per-item; the job still completes\")","+}","+","+// A version-stale uid whose new extractor output is empty sheds its old rows.","+func TestRunBackfillJob_VersionStale_EmptyExtract_DeletesOldRows(t *testing.T) {","+\tstorage := newFakeStorage()","+\t// Dashboard JSON with no panels: extractor produces zero items.","+\tbody, _ := json.Marshal(map[string]any{\"uid\": \"dash-a\", \"title\": \"empty\"})","+\tstorage.listItems = []listItem{{Namespace: \"ns\", Name: \"dash-a\", RV: 50, Value: body}}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 1, \"panel/1\")","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.deletes, 1, \"stale rows must be deleted when the new extract is empty\")","+\tassert.Equal(t, \"dash-a\", vec.deletes[0].UID)","+\tassert.Empty(t, vec.upserts)","+}","+","+// A never-embedded uid with an empty extract keeps the plain skip (nothing to delete).","+func TestRunBackfillJob_Fresh_EmptyExtract_StillSkips(t *testing.T) {","+\tstorage := newFakeStorage()","+\tbody, _ := json.Marshal(map[string]any{\"uid\": \"dash-a\", \"title\": \"empty\"})","+\tstorage.listItems = []listItem{{Namespace: \"ns\", Name: \"dash-a\", RV: 50, Value: body}}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.deletes)","+\tassert.Empty(t, vec.upserts)","+}","+","+func TestRunBackfillJob_GetSubresourceContentError_FailsJob(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\tvec.seedEmbeddedRows(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", 1, \"panel/1\")","+\tvec.getContentErr = errors.New(\"pg connection reset\")","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.errorMarks, 1, \"stored-content read failure must mark the job errored\")","+\tassert.Empty(t, vec.completedJobIDs, \"job must not complete on the same tick\")","+\tassert.Empty(t, vec.updateCalls)","+\tassert.Empty(t, vec.upserts)","+}","+","+func TestRunBackfillJob_UpdateContentVersionError_FailsJob(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\titems := extractDashboardItems(t, \"ns\", \"dash-a\", minimalDashboardJSON(\"dash-a\", \"dash-a-title\"), \"\")","+\trequire.Len(t, items, 1)","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\tvec.seedStoredContent(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", items[0].Subresource, items[0].Content, 1)","+\tvec.updateErr = errors.New(\"pg connection reset\")","+","+\to := newBackfiller(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.errorMarks, 1, \"version-stamp failure must mark the job errored, not skip silently\")","+\tassert.Empty(t, vec.completedJobIDs)","+\tassert.Empty(t, vec.upserts, \"identical content must still not re-embed on the error path\")","+}","+","+func TestRunBackfillJob_VersionStale_IdenticalContent_SkipsEmbedAndTouchesVersion(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\titems := extractDashboardItems(t, \"ns\", \"dash-a\", minimalDashboardJSON(\"dash-a\", \"dash-a-title\"), \"\")","+\trequire.Len(t, items, 1)","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\t// Job already at the builder's current version, so ReopenStaleBackfillJobs","+\t// doesn't reset stopping_rv/cursor out from under this test.","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\t// Stored row is at content_version 1 (stale) but its content is exactly","+\t// what the current (v2) extractor produces for this root-folder dashboard.","+\tvec.seedStoredContent(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", items[0].Subresource, items[0].Content, 1)","+","+\treg := prometheus.NewPedanticRegistry()","+\tm := resource.ProvideVectorMetrics(reg)","+\ttext := &fakeText{dim: 4}","+\temb := newFakeEmbedder(text)","+\to, err := NewVectorBackfiller(Options{","+\t\tStorage:       storage,","+\t\tVectorBackend: vec,","+\t\tBatchEmbedder: embedder.NewBatchEmbedder(*emb),","+\t\tBuilders:      []embed.Builder{dashboard.New()},","+\t\tMetrics:       m,","+\t})","+\trequire.NoError(t, err)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.upserts, \"identical content must not be re-embedded\")","+\tassert.Empty(t, vec.replaceCalls)","+\tassert.Equal(t, 0, text.calls, \"embedder must not be called when content is identical\")","+\trequire.Len(t, vec.updateCalls, 1)","+\tassert.Equal(t, updateCall{\"ns\", \"test-model\", \"dashboards\", \"dash-a\", dashboard.New().Version()}, vec.updateCalls[0])","+\trequire.Len(t, vec.completedJobIDs, 1)","+","+\tvar got dto.Metric","+\tobs := m.BackfillItemDuration.WithLabelValues(\"dashboard.grafana.app\", \"dashboards\", \"skipped_identical_content\")","+\trequire.NoError(t, obs.(prometheus.Metric).Write(&got))","+\tassert.Equal(t, uint64(1), got.GetHistogram().GetSampleCount(), \"the skipped_identical_content status label must be observed\")","+}","+","+// TestRunBackfillJob_VersionStale_FolderedDashboard_ContentDiffers_FullReEmbed","+// covers the case the identity check must NOT short-circuit: a foldered","+// dashboard's v2 content gets the folder-title breadcrumb prefix, so it","+// differs from the stored v1 content and the full re-embed path still runs.","+func TestRunBackfillJob_VersionStale_FolderedDashboard_ContentDiffers_FullReEmbed(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItemWithFolder(\"ns\", \"dash-a\", 50, \"folder-uid\")}","+\tstorage.seedFolder(\"ns\", \"folder-uid\", \"Production\")","+","+\t// Simulate the old (pre-breadcrumb) v1 shape: extracted with an empty","+\t// folder title, so it lacks the prefix the live run will add via the","+\t// real folder title resolved above.","+\toldItems := extractDashboardItems(t, \"ns\", \"dash-a\", dashboardJSONWithFolder(\"dash-a\", \"dash-a-title\", \"folder-uid\"), \"\")","+\trequire.Len(t, oldItems, 1)","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\tvec.seedStoredContent(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", oldItems[0].Subresource, oldItems[0].Content, 1)","+","+\to, text := newBackfillerWithEmbedder(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.upserts, 1, \"folder-title prefix makes the content differ, so the full re-embed path must run\")","+\tassert.Equal(t, 1, text.calls, \"embedder must be called on the full re-embed path\")","+\tassert.Empty(t, vec.updateCalls, \"content differs, so UpdateContentVersion must not be called\")","+\tfor _, v := range vec.upserts[0] {","+\t\tassert.Equal(t, dashboard.New().Version(), v.ContentVersion)","+\t}","+\trequire.Len(t, vec.completedJobIDs, 1)","+}","+","+// TestRunBackfillJob_VersionStale_SubresourceSetDiffers_FullReEmbed covers","+// the other non-identical case: the surviving panel's content is unchanged,","+// but a stored panel no longer exists in the extractor's output (e.g. a","+// deleted panel). The key-set mismatch alone must force the full path.","+func TestRunBackfillJob_VersionStale_SubresourceSetDiffers_FullReEmbed(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\titems := extractDashboardItems(t, \"ns\", \"dash-a\", minimalDashboardJSON(\"dash-a\", \"dash-a-title\"), \"\")","+\trequire.Len(t, items, 1)","+","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100}}","+\tvec.jobContentVersion = map[int64]int{1: dashboard.New().Version()}","+\tvec.seedStoredContent(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", items[0].Subresource, items[0].Content, 1)","+\t// panel/2 is stale content the extractor no longer produces (e.g. a","+\t// removed panel); its content is irrelevant, only its presence matters.","+\tvec.seedStoredContent(\"ns\", \"test-model\", \"dashboards\", \"dash-a\", \"panel/2\", \"stale content\", 1)","+","+\to, text := newBackfillerWithEmbedder(t, storage, vec)","+\to.runBackfill(context.Background())","+","+\trequire.Len(t, vec.replaceCalls, 1, \"subresource-set drift must force the full re-embed path\")","+\tassert.Equal(t, []string{items[0].Subresource}, vec.replaceCalls[0].Desired)","+\tassert.Equal(t, 1, text.calls)","+\tassert.Empty(t, vec.updateCalls)","+","+\t_, stillThere := vec.rows[rowsKey(\"ns\", \"test-model\", \"dashboards\", \"dash-a\")][\"panel/2\"]","+\tassert.False(t, stillThere, \"stale subresource must be dropped by the replace\")","+}","+","+// TestRunBackfill_CompletedJobStaleVersion_ReopensAndProcesses covers job","+// reopening: a job that finished under an older content_version is reopened","+// (is_complete=false, cursor/error reset) and drained on the same tick.","+// A zero reconciler checkpoint means nothing was ever embedded; reopening","+// then would complete the job against an empty bound and strand it.","+func TestReopenStaleJobs_ZeroCheckpoint_SkipsReopen(t *testing.T) {","+\tvec := newFakeVector()","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100, IsComplete: true}}","+","+\to := newBackfiller(t, newFakeStorage(), vec)","+\to.runBackfill(context.Background())","+","+\tassert.Empty(t, vec.reopenCalls)","+}","+","+// The reopened job's stopping RV is the reconciler checkpoint, not wall clock.","+func TestReopenStaleJobs_UsesCheckpointAsStoppingRV(t *testing.T) {","+\tvec := newFakeVector()","+\tvec.latestRV = 424242","+\tvec.jobs = []vector.BackfillJob{{ID: 1, Model: \"test-model\", StoppingRV: 100, IsComplete: true}}","+","+\to := newBackfiller(t, newFakeStorage(), vec)","+\to.runBackfill(context.Background())","+","+\trequire.NotEmpty(t, vec.reopenCalls)","+\tassert.Equal(t, int64(424242), vec.reopenCalls[0].StoppingRV)","+}","+","+func TestRunBackfill_CompletedJobStaleVersion_ReopensAndProcesses(t *testing.T) {","+\tstorage := newFakeStorage()","+\tstorage.listItems = []listItem{makeListItem(\"ns\", \"dash-a\", 50)}","+","+\tvec := newFakeVector()","+\tvec.latestRV = 100 // reconciler checkpoint feeds the reopened job's stopping RV","+\tvec.jobs = []vector.BackfillJob{{","+\t\tID:          1,","+\t\tModel:       \"test-model\",","+\t\tStoppingRV:  100,","+\t\tIsComplete:  true,","+\t\tLastSeenKey: encodeCursor(\"dashboards\", \"tok-stale\"),","+\t\tLastError:   \"old error\",","+\t}}","+\t// Job's content_version defaults to 1 (the fake's DB-default stand-in);"],"additions":618,"deletions":5,"trun