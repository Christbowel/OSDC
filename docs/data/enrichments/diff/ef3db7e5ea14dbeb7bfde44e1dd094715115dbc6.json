es([TARGETS.index(target)]) + data  # type: ignore[arg-type]","+def seeds() -> dict[Callable[[bytes], None], list[bytes]]:","+    \"\"\"Seed inputs for each parser, from tornado's regression corpus.\"\"\"","+    # Only needed for seeds, so it's imported here (and not instrumented)","+    # to keep it out of every fuzzer process's startup.","+    from tornado.test import security_corpus_test"," ","-    result = []","+    result: dict[Callable[[bytes], None], list[bytes]] = {","+        t: []","+        for t in [","+            headers,","+            start_line,","+            response_start_line,","+            cookie,","+            header_params,","+            multipart,","+            body,","+        ]","+    }","     requests = [c.request for c in security_corpus_test.CASES] + [","         s.build(n) for s in security_corpus_test.SCALING for n in (1, 10)","     ]","     for request in requests:","         head, _, rest = request.partition(b\"\\r\\n\\r\\n\")","         line, _, header_block = head.partition(b\"\\r\\n\")","-        result.append(seed(start_line, line))","-        result.append(seed(headers, header_block + b\"\\r\\n\"))","+        result[start_line].append(line)","+        result[headers].append(header_block + b\"\\r\\n\")","         h = httputil.HTTPHeaders.parse(header_block.decode(\"latin1\") + \"\\r\\n\")","         for value in h.get_list(\"Cookie\"):","-            result.append(seed(cookie, value.encode(\"latin1\")))","+            result[cookie].append(value.encode(\"latin1\"))","         if \"Content-Type\" in h:","             content_type = h[\"Content-Type\"].encode(\"latin1\")","-            result.append(seed(header_params, content_type))","-            result.append(seed(body, content_type + b\"\\n\" + rest))","+            result[header_params].append(content_type)","+            result[body].append(content_type + b\"\\n\" + rest)","             if content_type.startswith(b\"multipart/\"):","-                result.append(seed(mu