er-instance\": \"server-fn:1\",","+      \"x-start-build\": \"build-b\",","+    });","+    expect(response.status).toBe(200);","+    expect(fn).toHaveBeenCalled();","+  });","+","+  it(\"runs a call without a build ID\", async () => {","+    const { fn } = await call({ \"x-server-instance\": \"server-fn:1\" });","+    expect(fn).toHaveBeenCalled();","+  });","+","+  it(\"runs every call when skew protection is off\", async () => {","+    vi.stubEnv(\"START_BUILD_ID\", \"\");","+    const { fn } = await call({","+      \"x-server-instance\": \"server-fn:1\",","+      \"x-start-build\": \"build-a\",","+    });","+    expect(fn).toHaveBeenCalled();","+  });","+});"],"additions":64,"deletions":0,"truncated":false},{"path":"packages/start/src/fns/handler.ts","lines":["@@ -11,7 +11,14 @@ import {","   serializeToJSONStream,","   serializeToJSStream,"," } from \"./serialization.ts\";","-import { BODY_FORMAT_KEY, BodyFormat, extractBody, getHeadersAndBody } from \"./shared.ts\";","+import {","+  BODY_FORMAT_KEY,","+  BodyFormat,","+  BUILD_ID_KEY,","+  extractBody,","+  getHeadersAndBody,","+  SKEW_KEY,","+} from \"./shared.ts\";"," import \"solid-start:server-fn-manifest\";"," "," import { getServerFunction, hasServerFunction } from \"./registration.ts\";","@@ -55,6 +62,19 @@ function isCrossSiteRequest(request: Request, url: URL): boolean {","   return false;"," }"," ","+/**","+ * With skew protection on, a client from another build may call a function","+ * that changed or no longer exists, so its call is refused before it runs. A","+ * request without a build ID (a no-JS form submission, a page from a","+ * build without skew protection) is let through.","+ */","+function isSkewedRequest(request: Request): boolean {","+  const buildId = import.meta.env.START_BUILD_ID;","+  if (!buildId) return false;","+  const clientBuildId = request.headers.get(BUILD_ID_KEY);","+  return !!clientBuildId && clientBuildId !== buildId;","+}","+"," const CACHE_CONTROL = \"Cache-Control\";"," const DEFAULT_CACHE_CONTROL = \"no-store\";"," ","@@ -132,6 +152,10 @@ async function runServerFunction(h3Event: H3Event) {","     );","   }"," ","+  if (isSkewedRequest(request)) {","+    return new Response(null, { status: 409, headers: { [SKEW_KEY]: \"true\" } });","+  }","+","   const serverReference = request.headers.get(\"X-Server-Id\");","   const instance = request.headers.get(\"X-Server-Instance\");","   const singleFlight = request.headers.has(\"X-Single-Flight\");"],"additions":25,"deletions":1,"truncated":false},{"path":"packages/start/src/fns/shared.ts","lines":["@@ -10,6 +10,12 @@ export const BODY_FORMAT_KEY = \"X-Start-Type\";"," "," export const BODY_FORMAL_FILE = \"__START__\";"," ","+/** Carries the client's build ID on a server function call. */","+export const BUILD_ID_KEY = \"X-Start-Build\";","+","+/** Marks a call rejected because the client and server builds differ. */","+export const SKEW_KEY = \"X-Start-Skew\";","+"," export const enum BodyFormat {","   Seroval = \"0\",","   String = \"1\","],"additions":6,"deletions":0,"truncated":false},{"path":"packages/start/src/shared/route-chunk-reload.ts","lines":["@@ -48,7 +48,7 @@ function reloadAfterNavigation(from: string): void {","  * Records a reload. Returns false when one already happened within","  * `RELOAD_WINDOW_MS`, or when it cannot be recorded.","  */","-function recordReload(): boolean {","+export function recordReload(): boolean {","   try {","     const now = Date.now();","     const last = Number(sessionStorage.getItem(STORAGE_KEY));",""],"additions":1,"deletions":1,"truncated":false}],"additions":279,"deletions":3,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-31T14:35:37.469447+00:00"}