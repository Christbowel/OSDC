{"id":"876881b8a23d276ac463a84cca0d0870e5b93182","axis":"silent","repo":"solidjs/solid-start","sha":"876881b8a23d276ac463a84cca0d0870e5b93182","parsed":{"files":[{"path":".changeset/server-function-skew.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@solidjs/start\": minor","+---","+","+Add `serverFunctions.skewProtection`. When it is on, a page loaded before a deploy can no longer call the new server's functions with an outdated client. The server answers such a call with `409` instead of running the function, and the page reloads once to load the new version. Each build gets a random ID, or pass `{ buildId }` (such as a commit hash) when several machines build the same deploy. Only applies to production builds, and is off by default."],"additions":5,"deletions":0,"truncated":false},{"path":"packages/start/src/config/index.spec.ts","lines":["@@ -117,3 +117,42 @@ describe(\"resolve conditions\", () => {","     );","   });"," });","+","+describe(\"START_BUILD_ID\", () => {","+  async function buildId(","+    options: Parameters<typeof solidStart>[0],","+    command: ConfigEnv[\"command\"] = \"build\",","+  ) {","+    const plugin = solidStart(options)","+      .flat()","+      .find(","+        (p): p is Plugin =>","+          !!p && typeof p === \"object\" && \"name\" in p && p.name === \"solid-start:config\",","+      );","+    const hook = plugin!.config as (config: UserConfig, env: ConfigEnv) => Promise<UserConfig>;","+    const mode = command === \"build\" ? \"production\" : \"development\";","+    const resolved = await hook({}, { command, mode });","+    return JSON.parse(resolved.define![\"import.meta.env.START_BUILD_ID\"] as string) as string;","+  }","+","+  it(\"is empty when skew protection is off\", async () => {","+    await expect(buildId(undefined)).resolves.toBe(\"\");","+  });","+","+  it(\"is empty in dev\", async () => {","+    await expect(buildId({ serverFunctions: { skewProtection: true } }, \"serve\")).resolves.toBe(\"\");","+  });","+","+  it(\"is random per build\", async () => {","+    const a = await buildId({ serverFunctions: { skewProtection: true } });","+    const b = await buildId({ serverFunctions: { skewProtection: true } });","+    expect(a).not.toBe(\"\");","+    expect(a).not.toBe(b);","+  });","+","+  it(\"uses the configured build ID\", async () => {","+    await expect(","+      buildId({ serverFunctions: { skewProtection: { buildId: \"abc123\" } } }),","+    ).resolves.toBe(\"abc123\");","+  });","+});"],"additions":39,"deletions":0,"truncated":false},{"path":"packages/start/src/config/index.ts","lines":["@@ -1,4 +1,5 @@"," import { defu } from \"defu\";","+import { randomUUID } from \"node:crypto\";"," import { globSync } from \"node:fs\";"," import { basename, extname, isAbsolute, join } from \"node:path\";"," import type { PluginOption, FilterPattern, UserConfig } from \"vite\";","@@ -221,6 +222,33 @@ export interface SolidStartOptions {","      * @example \"src/server-fn-error.ts\"","      */","     onError?: string;","+","+    /**","+     * Reject server function calls from a page loaded before the latest","+     * deploy, and reload that page so it runs the new version.","+     *","+     * Each production build gets an ID that is baked into both the client and","+     * the server. The client sends its ID with every server function call. A","+     * server with a different ID answers with `409` instead of running the","+     * function, and the client reloads the page once. A call that still fails","+     * right after the reload rejects instead of reloading again.","+     *","+     * Every deploy invalidates every open page this way, even when the","+     * function did not change, because a changed argument or return type","+     * cannot be told apart from an unchanged one.","+     *","+     * Requests without the ID, such as no-JS form submissions or","+     * pages built before this option was turned on, are not checked.","+     *","+     * Pass `{ buildId }` when several machines build the same code for one","+     * deploy, such as a commit hash, so their IDs match. Otherwise each build","+     * gets a random ID.","+     *","+     * Only applies to production builds.","+     *","+     * @default false","+     */","+    skewProtection?: boolean | { buildId?: string };","   };"," }"," ","@@ -256,6 +284,16 @@ function resolveServerBaseUrl(config: UserConfig) {","   return withSlashes(new URL(base, \"http://vite.dev\").pathname);"," }"," ","+// An empty ID turns the check off on both sides.","+function resolveBuildId(","+  skewProtection: NonNullable<SolidStartOptions[\"serverFunctions\"]>[\"skewProtection\"],","+  command: \"build\" | \"serve\",","+  fallback: string,","+) {","+  if (!skewProtection || command !== \"build\") return \"\";","+  return (typeof skewProtection === \"object\" && skewProtection.buildId) || fallback;","+}","+"," export function solidStart(options?: SolidStartOptions): Array<PluginOption> {","   const start = defu(options ?? {}, {","     appRoot: \"./src\",","@@ -278,6 +316,8 @@ export function solidStart(options?: SolidStartOptions): Array<PluginOption> {","     throw new Error(`Could not find an app jsx/tsx entry in ${start.appRoot}.`);","   }","   const entryExtension = extname(appEntryPath);","+  // created once, so every environment of the build gets the same ID","+  const randomBuildId = randomUUID();","   const handlers = {","     client: `${start.appRoot}/entry-client${entryExtension}`,","     server: `${start.appRoot}/entry-server${entryExtension}`,","@@ -319,6 +359,11 @@ export function solidStart(options?: SolidStartOptions): Array<PluginOption> {","           env.command === \"serve\" && config.experimental?.bundledDev","             ? `assets/${basename(handlers.client, entryExtension)}.js`","             : handlers.client;","+        const buildId = resolveBuildId(","+          options?.serverFunctions?.skewProtection,","+          env.command,","+          randomBuildId,","+        );","         if (env.command === \"build\") {","           const clientRouter: BaseFileSystemRouter = (globalThis as any).ROUTERS.client;","           for (const route of await clientRouter.getRoutes()) {","@@ -422,6 +467,7 @@ export function solidStart(options?: SolidStartOptions): Array<PluginOption> {","             ),","             \"import.meta.env.SERVER_BASE_URL\": JSON.stringify(resolveServerBaseUrl(config)),","             \"import.meta.env.SEROVAL_MODE\": JSON.stringify(start.serialization?.mode || \"json\"),","+            \"import.meta.env.START_BUILD_ID\": JSON.stringify(buildId),","           },","           builder: {","             sharedPlugins: true,"],"additions":46,"deletions":0,"truncated":false},{"path":"packages/start/src/env.d.ts","lines":["@@ -16,5 +16,6 @@ interface SolidStartMetaEnv {","   START_ISLANDS: boolean;","   START_EARLY_HINTS: boolean;","   START_RELOAD_ON_ROUTE_CHUNK_ERROR: boolean;","+  START_BUILD_ID: string;","   // START_DEV_OVERLAY: boolean;"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/start/src/fns/client.spec.ts","lines":["@@ -98,3 +98,64 @@ describe(\"server function URL\", () => {","     expect(fn.url).toBe(\"/app/_server?id=test-fn\");","   });"," });","+","+describe(\"skew protection\", () => {","+  let location: { reload: ReturnType<typeof vi.fn> };","+","+  const sentBuildId = () => {","+    const call = (fetch as unknown as ReturnType<typeof vi.fn>).mock.calls[0];","+    return (call![0] as Request).headers.get(\"X-Start-Build\");","+  };","+","+  beforeEach(() => {","+    vi.stubEnv(\"SERVER_BASE_URL\", \"http://localhost/\");","+    vi.stubEnv(\"START_BUILD_ID\", \"build-a\");","+    location = { reload: vi.fn() };","+    vi.stubGlobal(\"location\", location);","+    const values = new Map<string, string>();","+    vi.stubGlobal(\"sessionStorage\", {","+      getItem: (key: string) => values.get(key) ?? null,","+      setItem: (key: string, value: string) => void values.set(key, value),","+    });","+    vi.spyOn(console, \"warn\").mockImplementation(() => {});","+  });","+","+  afterEach(() => {","+    vi.unstubAllEnvs();","+    vi.unstubAllGlobals();","+    vi.restoreAllMocks();","+  });","+","+  it(\"sends the build ID\", async () => {","+    respondWith(200);","+    await callServerFunction();","+    expect(sentBuildId()).toBe(\"build-a\");","+  });","+","+  it(\"does not send a build ID when skew protection is off\", async () => {","+    vi.stubEnv(\"START_BUILD_ID\", \"\");","+    respondWith(200);","+    await callServerFunction();","+    expect(sentBuildId()).toBeNull();","+  });","+","+  it(\"reloads the page and leaves the call pending on a skew response\", async () => {","+    respondWith(409, { \"X-Start-Skew\": \"true\" });","+    const settled = vi.fn();","+    callServerFunction().then(settled, settled);","+","+    await vi.waitFor(() => expect(location.reload).toHaveBeenCalledTimes(1));","+    await new Promise(resolve => setTimeout(resolve, 0));","+    expect(settled).not.toHaveBeenCalled();","+  });","+","+  it(\"rejects instead of reloading again right after a reload\", async () => {","+    respondWith(409, { \"X-Start-Skew\": \"true\" });","+    void callServerFunction();","+    await vi.waitFor(() => expect(location.reload).toHaveBeenCalledTimes(1));","+","+    const rejection = await rejectionOf(callServerFunction());","+    expect(rejection).toBeInstanceOf(Error);","+    expect(location.reload).toHaveBeenCalledTimes(1);","+  });","+});"],"additions":61,"deletions":0,"truncated":false},{"path":"packages/start/src/fns/client.ts","lines":["@@ -1,10 +1,18 @@"," import { type Component } from \"solid-js\";"," import { pushRequest, pushResponse } from \"../shared/dev-toolbar/functions/tracker.ts\";","+import { recordReload } from \"../shared/route-chunk-reload.ts\";"," import {","   // serializeToJSONStream,","   serializeToJSONString,"," } from \"./serialization.ts\";","-import { BODY_FORMAT_KEY, BodyFormat, extractBody, getHeadersAndBody } from \"./shared.ts\";","+import {","+  BODY_FORMAT_KEY,","+  BodyFormat,","+  BUILD_ID_KEY,","+  extractBody,","+  getHeadersAndBody,","+  SKEW_KEY,","+} from \"./shared.ts\";"," import { appendUploads, ARGS_PART, createUploadSerializer } from \"./uploads.ts\";"," "," let INSTANCE = 0;","@@ -17,6 +25,7 @@ async function createRequest(base: string, id: string, instance: string, options","       ...options.headers,","       \"X-Server-Id\": id,","       \"X-Server-Instance\": instance,","+      ...(import.meta.env.START_BUILD_ID ? { [BUILD_ID_KEY]: import.meta.env.START_BUILD_ID } : {}),","     },","   });","   if (import.meta.env.DEV) {","@@ -96,6 +105,10 @@ async function fetchServerFunction("," ","   const response = await initializeResponse(base, id, instance, options, args);"," ","+  if (import.meta.env.START_BUILD_ID && response.headers.has(SKEW_KEY)) {","+    return handleSkew();","+  }","+","   if (","     response.headers.has(\"Location\") ||","     response.headers.has(\"X-Revalidate\") ||","@@ -117,6 +130,23 @@ async function fetchServerFunction(","   return result;"," }"," ","+/**","+ * The server was deployed with a different build since this page loaded, so","+ * the page reloads to run the new version. The call never settles, so the","+ * page does not show an error in the moment before the reload. A second skew","+ * within the reload window rejects instead, so a server that keeps answering","+ * from another build (a load balancer mixing old and new instances) does not","+ * reload the page in a loop.","+ */","+function handleSkew(): Promise<never> {","+  if (!recordReload()) {","+    throw new Error(\"Server function call rejected: the server runs a different build\");","+  }","+  console.warn(\"[solid-start] The server was updated, reloading the page.\");","+  location.reload();","+  return new Promise(() => {});","+}","+"," export function cloneServerReference(id: string) {","   let baseURL = import.meta.env.SERVER_BASE_URL || \"/\";","   if (!baseURL.en