amed run goes through the reporter, which may be redrawing its"," /// frame in place: a line written past it would shift the rows the frame","-/// moves the cursor over.","+/// moves the cursor over. An inherited run under the default reporter","+/// writes the line to stderr after the script's own output; under any","+/// other reporter it goes through the reporter too, so the ndjson","+/// reporter writes a record and the silent reporter drops it."," fn report_lifecycle_failure(ctx: &RunContext<'_>, message: &str) {","-    match ctx.output {","-        ScriptOutput::Streamed { .. } => (ctx.emit)(&LogEvent::Pnpm(PnpmLog {","-            level: LogLevel::Error,","-            message: message.to_string(),","-            prefix: String::new(),","-        })),","-        ScriptOutput::Inherit if selected_reporter() == ReporterType::Silent => {}","-        ScriptOutput::Inherit => pnpm_diagnostics::eprintln!(\"{message}\"),","+    if matches!(ctx.output, ScriptOutput::Inherit) && default_reporter_selected() {","+        pnpm_diagnostics::eprintln!(\"{message}\");","+        return;","     }","+    (ctx.emit)(&LogEvent::Pnpm(PnpmLog {","+        level: LogLevel::Error,","+        message: message.to_string(),","+        prefix: String::new(),","+    }));"," }"," "," pub(crate) fn exec_scripts_prepend_node_path("],"additions":13,"deletions":10,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/_utils/mod.rs","lines":["@@ -625,6 +625,18 @@ pub fn ndjson_records(output: &Output) -> Vec<Value> {","         .collect()"," }"," ","+/// Whether a `name: \"pnpm\" / level: \"error\"` log carries `message`.","+#[must_use]","+pub fn has_pnpm_error_log(records: &[Value], message: &str) -> bool {","+    records","+        .iter()","+        .any(|record| {","+            record.get(\"name\").and_then(Value::as_str) == Some(\"pnpm\")","+                && record.get(\"level\").and_then(Value::as_str) == Some(\"error\")","+                && record.get(\"message\").and_then(Value: