atar","+\t\t\t\t\t\t:size=\"32\"","+\t\t\t\t\t\t:isNoUser=\"isNoUserRecipient(recipient)\"","+\t\t\t\t\t\t:user=\"isNoUserRecipient(recipient) ? undefined : recipient.value\"","+\t\t\t\t\t\t:displayName=\"recipient.display_name\" />","+\t\t\t\t</template>","+\t\t\t\t<NcActionButton :aria-label=\"t('files_sharing', 'Remove participant')\" @click=\"removeOne(recipient)\">","+\t\t\t\t\t<template #icon>","+\t\t\t\t\t\t<DeleteIcon :size=\"20\" />","+\t\t\t\t\t</template>","+\t\t\t\t\t{{ t('files_sharing', 'Remove participant') }}","+\t\t\t\t</NcActionButton>","+\t\t\t</SharingEntrySimple>","+\t\t</template>","+\t</ul>","+</template>","+","+<script setup lang=\"ts\">","+import type { SharingRecipient, SharingShare } from '../types/unifiedSharing.ts'","+","+import { DialogBuilder } from '@nextcloud/dialogs'","+import { translate as t } from '@nextcloud/l10n'","+import { computed, ref } from 'vue'","+import NcActionButton from '@nextcloud/vue/components/NcActionButton'","+import NcAvatar from '@nextcloud/vue/components/NcAvatar'","+import NcButton from '@nextcloud/vue/components/NcButton'","+import ChevronDownIcon from 'vue-material-design-icons/ChevronDown.vue'","+import ChevronRightIcon from 'vue-material-design-icons/ChevronRight.vue'","+import DeleteIcon from 'vue-material-design-icons/Delete.vue'","+import PencilIcon from 'vue-material-design-icons/Pencil.vue'","+import AvatarStack from './AvatarStack.vue'","+import SharingEntrySimple from './SharingEntrySimple.vue'","+import { isNoUserRecipient, recipientPermissionLabel, recipientSummary, reshareSubtitle } from '../lib/unifiedSharing.ts'","+import logger from '../services/logger.ts'","+import { openShareEditDialog } from '../services/SharingDialog.ts'","+import { deleteShare, removeRecipient } from '../services/unifiedShares.ts'","+","+const props = defineProps<{","+\tshare: SharingShare","+\tfileInfo: { node?: unknown }","+}>()","+","+const emit = defineEmits<{","+\t(e: 'refresh'): void","+}>()","+","+// Expanded by default; collapse is optional (e.g. long lists).","+const expanded = ref(true)","+","+const recipients = computed(() => props.share.recipients)","+const isSingle = computed(() => recipients.value.length === 1)","+const summaryTitle = computed(() => recipientSummary(recipients.value))","+const reshareLine = computed(() => reshareSubtitle(props.share))","+","+/**","+ * Show a confirmation dialog and resolve to the user's choice.","+ *","+ * @param text The confirmation prompt","+ */","+async function confirm(text: string): Promise<boolean> {","+\tlet confirmed = false","+\tconst dialog = (new DialogBuilder())","+\t\t.setName(t('files_sharing', 'Delete share'))","+\t\t.setText(text)","+\t\t.setButtons([","+\t\t\t{","+\t\t\t\tlabel: t('files_sharing', 'Cancel'),","+\t\t\t\tvariant: 'secondary',","+\t\t\t\tcallback: () => {},","+\t\t\t},","+\t\t\t{","+\t\t\t\tlabel: t('files_sharing', 'Delete'),","+\t\t\t\tvariant: 'error',","+\t\t\t\tcallback: () => {","+\t\t\t\t\tconfirmed = true","+\t\t\t\t},","+\t\t\t},","+\t\t])","+\t\t.build()","+\ttry {","+\t\tawait dialog.show()","+\t} catch (error) {","+\t\tlogger.debug('Delete confirmation dialog closed', { error })","+\t}","+\treturn confirmed","+}","+","+/**","+ * Open the unified sharing dialog to edit this share.","+ */","+async function openEditDialog(): Promise<void> {","+\ttry {","+\t\tawait openShareEditDialog(props.share.id, props.fileInfo.node)","+\t} catch (error) {","+\t\tlogger.error('Failed to open the sharing dialog', { error })","+\t} finally {","+\t\t// Refresh even if the dialog errored, it may still have applied","+\t\t// changes (recipients, permissions) before closing.","+\t\temit('refresh')","+\t}","+}","+","+/**","+ * Ask for confirmation, then delete the whole share.","+ */","+async function confirmDeleteShare(): Promise<void> {","+\tif (!await confirm(t('files_sharing', 'Are you sure you want to delete this share? This operation cannot be undone.'))) {","+\t\treturn","+\t}","+\ttry {","+\t\tawait deleteShare(props.share.id)","+\t\temit('refresh')","+\t} catch (error) {","+\t\tlogger.error('Failed to delete share', { error })","+\t}","+}","+","+/**","+ * Remove a single recipient from the share.","+ *","+ * @param recipient The recipient to remove","+ */","+async function removeOne(recipient: SharingRecipient): Promise<void> {","+\ttry {","+\t\tawait removeRecipient(props.share.id, recipient.class, recipient.value, recipient.instance)","+\t\temit('refresh')","+\t} catch (error) {","+\t\tlogger.error('Failed to remove recipient', { error })","+\t}","+}","+</script>","+","+<style lang=\"scss\" scoped>","+.unified-share {","+\t// Unify every share row to 52px.","+\t:deep(.sharing-entry) {","+\t\tmin-height: 52px;","+\t}","+","+\t&__recipient {","+\t\tpadding-inline-start: 24px;","+\t}","+}","+</style>"],"additions":222,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/components/UnifiedShareList.vue","lines":["@@ -0,0 +1,34 @@","+<!--","+  - SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+  - SPDX-License-Identifier: AGPL-3.0-or-later","+-->","+","+<template>","+\t<div class=\"unified-share-list\">","+\t\t<UnifiedShareEntry","+\t\t\tv-for=\"share in sortedShares\"","+\t\t\t:key=\"share.id\"","+\t\t\t:share=\"share\"","+\t\t\t:fileInfo=\"fileInfo\"","+\t\t\t@refresh=\"$emit('refresh')\" />","+\t</div>","+</template>","+","+<script setup lang=\"ts\">","+import type { SharingShare } from '../types/unifiedSharing.ts'","+","+import { computed } from 'vue'","+import UnifiedShareEntry from './UnifiedShareEntry.vue'","+import { sortSharesByPermission } from '../lib/unifiedSharing.ts'","+","+const props = defineProps<{","+\tshares: SharingShare[]","+\tfileInfo: object","+}>()","+","+defineEmits<{","+\t(e: 'refresh'): void","+}>()","+","+const sortedShares = computed(() => sortSharesByPermission(props.shares))","+</script>"],"additions":34,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/components/UnifiedShareListSkeleton.vue","lines":["@@ -0,0 +1,85 @@","+<!--","+  - SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+  - SPDX-License-Identifier: AGPL-3.0-or-later","+-->","+","+<template>","+\t<ul class=\"share-skeleton\" aria-hidden=\"true\">","+\t\t<li v-for=\"i in count\" :key=\"i\" class=\"share-skeleton__row\">","+\t\t\t<span class=\"share-skeleton__avatar\" />","+\t\t\t<span class=\"share-skeleton__lines\">","+\t\t\t\t<span class=\"share-skeleton__line share-skeleton__line--title\" />","+\t\t\t\t<span class=\"share-skeleton__line share-skeleton__line--subtitle\" />","+\t\t\t</span>","+\t\t</li>","+\t</ul>","+</template>","+","+<script setup lang=\"ts\">","+withDefaults(defineProps<{","+\t/** How many placeholder rows to render. */","+\tcount?: number","+}>(), {","+\tcount: 3,","+})","+</script>","+","+<style lang=\"scss\" scoped>","+.share-skeleton {","+\t&__row {","+\t\tdisplay: flex;","+\t\talign-items: center;","+\t\tgap: 8px;","+\t\tmin-height: 52px;","+\t}","+","+\t&__avatar {","+\t\tflex: 0 0 auto;","+\t\twidth: 32px;","+\t\theight: 32px;","+\t\tborder-radius: 50%;","+\t}","+","+\t&__lines {","+\t\tdisplay: flex;","+\t\tflex-direction: column;","+\t\tgap: 6px;","+\t\tflex: 1 1 auto;","+\t}","+","+\t&__line {","+\t\theight: 12px;","+\t\tborder-radius: 6px;","+","+\t\t&--title {","+\t\t\twidth: 40%;","+\t\t}","+","+\t\t&--subtitle {","+\t\t\twidth: 25%;","+\t\t}","+\t}","+","+\t&__avatar,","+\t&__line {","+\t\tbackground-color: var(--color-background-dark);","+\t\tanimation: share-skeleton-pulse 1.5s ease-in-out infinite;","+\t}","+}","+","+@keyframes share-skeleton-pulse {","+\t0%, 100% {","+\t\topacity: 1;","+\t}","+\t50% {","+\t\topacity: 0.5;","+\t}","+}","+","+@media (prefers-reduced-motion: reduce) {","+\t.share-skeleton__avatar,","+\t.share-skeleton__line {","+\t\tanimation: none;","+\t}","+}","+</style>"],"additions":85,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/lib/unifiedSharing.ts","lines":["@@ -0,0 +1,168 @@","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import type { SharingPermission, SharingRecipient, SharingShare } from '../types/unifiedSharing.ts'","+","+import { getCapabilities } from '@nextcloud/capabilities'","+import { translatePlural as n, translate as t } from '@nextcloud/l10n'","+import {","+\tRECIPIENT_TYPE_EMAIL,","+\tRECIPIENT_TYPE_GROUP,","+\tRECIPIENT_TYPE_TEAM,","+\tRECIPIENT_TYPE_TOKEN,","+\tRECIPIENT_TYPE_USER,","+} from './unifiedSharingConstants.ts'","+","+/**","+ * Rank a share by its highest granted permissions: the sum of priorities of its","+ * enabled permissions. Used to order the flat share list (highest first).","+ *","+ * @param share The share to rank","+ */","+export function sharePermissionRank(share: SharingShare): number {","+\treturn share.permissions","+\t\t.filter((permission) => permission.enabled)","+\t\t.reduce((sum, permission) => sum + permission.priority, 0)","+}","+","+/**","+ * Sort shares by highest permissions first, then by recipient count, then by id","+ * for a stable order.","+ *","+ * @param shares The shares to sort (not mutated)","+ */","+export function sortSharesByPermission(shares: SharingShare[]): SharingShare[] {","+\treturn [...shares].sort((a, b) => {","+\t\tconst rank = sharePermissionRank(b) - sharePermissionRank(a)","+\t\tif (rank !== 0) {","+\t\t\treturn rank","+\t\t}","+\t\tconst count = b.recipients.length - a.recipients.length","+\t\tif (count !== 0) {","+\t\t\treturn count","+\t\t}","+\t\treturn a.id.localeCompare(b.id)","+\t})","+}","+","+type CapabilitiesWithPresets = {","+\tsharing?: {","+\t\tpermission_presets?: { class: string, display_name: string }[]","+\t}","+}","+","+/**","+ * Human-readable label for a share's permission preset, e.g. \"Can edit\". Falls","+ * back to \"Custom permissions\" when the enabled permissions match no preset.","+ *","+ * @param share The share","+ */","+export function permissionLabel(share: SharingShare): string {","+\tif (share.permission_preset === null) {","+\t\treturn t('files_sharing', 'Custom permissions')","+\t}","+\tconst capabilities = getCapabilities() as CapabilitiesWithPresets","+\tconst preset = (capabilities.sharing?.permission_presets ?? []).find((p) => p.class === share.permission_preset)","+\treturn preset?.display_name ?? t('files_sharing', 'Custom permissions')","+}","+","+/**","+ * Human-readable label for a set of permissions: the preset whose member","+ * permissions are exactly the enabled ones, else \"Custom permissions\".","+ *","+ * @param permissions The permissions to label","+ */","+function labelForPermissions(permissions: SharingPermission[]): string {","+\tconst capabilities = getCapabilities() as CapabilitiesWithPresets","+\tconst enabled = new Set(permissions.filter((permission) => permission.enabled).map((permission) => permission.class))","+\tfor (const preset of capabilities.sharing?.permission_presets ?? []) {","+\t\tconst members = permissions.filter((permission) => permission.presets.includes(preset.class))","+\t\tif (members.length > 0 && members.length === enabled.size && members.every((permission) => enabled.has(permission.class))) {","+\t\t\treturn preset.display_name","+\t\t}","+\t}","+\treturn t('files_sharing', 'Custom permissions')","+}","+","+/**","+ * Human-readable permission label for a single recipient.","+ *","+ * A recipient's permissions are sparse overrides on top of the share's, so the","+ * effective state is the share's permissions with the recipient's applied.","+ *","+ * @param share The share the recipient belongs to","+ * @param recipient The recipient","+ */","+export function recipientPermissionLabel(share: SharingShare, recipient: SharingRecipient): string {","+\tconst overrides = new Map((recipient.permissions ?? []).map((permission) => [permission.class, permission]))","+\treturn labelForPermissions(share.permissions.map((permission) => ({","+\t\t...permission,","+\t\tenabled: overrides.get(permission.class)?.enabled ?? permission.enabled,","+\t})))","+}","+","+/**","+ * Whether a recipient should render a non-user (initials) avatar.","+ *","+ * @param recipient The recipient","+ */","+export function isNoUserRecipient(recipient: SharingRecipient): boolean {","+\treturn recipient.class !== RECIPIENT_TYPE_USER","+}","+","+/**","+ * Build a human-readable summary of a share's recipients, e.g.","+ * \"1 person, 2 groups\". Categories are listed in a stable order and only","+ * non-empty ones are included.","+ *","+ * @param recipients The share's recipients","+ */","+export function recipientSummary(recipients: SharingRecipient[]): string {","+\tconst counts: Record<string, number> = {}","+\tfor (const recipient of recipients) {","+\t\tcounts[recipient.class] = (counts[recipient.class] ?? 0) + 1","+\t}","+","+\tconst parts: string[] = []","+\tconst push = (count: number, singular: string, plural: string) => {","+\t\tif (count > 0) {","+\t\t\tparts.push(n('files_sharing', singular, plural, count))","+\t\t}","+\t}","+","+\tpush(counts[RECIPIENT_TYPE_USER] ?? 0, '%n person', '%n people')","+\tpush(counts[RECIPIENT_TYPE_GROUP] ?? 0, '%n group', '%n groups')","+\tpush(counts[RECIPIENT_TYPE_TEAM] ?? 0, '%n team', '%n teams')","+\tpush(counts[RECIPIENT_TYPE_EMAIL] ?? 0, '%n email', '%n emails')","+\tpush(counts[RECIPIENT_TYPE_TOKEN] ?? 0, '%n link', '%n links')","+","+\t// Fallback for any unknown recipient class not covered above.","+\tconst known = new Set([","+\t\tRECIPIENT_TYPE_USER,","+\t\tRECIPIENT_TYPE_GROUP,","+\t\tRECIPIENT_TYPE_TEAM,","+\t\tRECIPIENT_TYPE_EMAIL,","+\t\tRECIPIENT_TYPE_TOKEN,","+\t])","+\tconst otherCount = recipients.filter((r) => !known.has(r.class)).length","+\tpush(otherCount, '%n recipient', '%n recipients')","+","+\treturn parts.join(t('files_sharing', ', '))","+}","+","+/**","+ * Best-effort \"Reshared with N people\" subtitle: counts recipients that were","+ * added by someone other than the share owner (i.e. via a reshare). Returns an","+ * empty string when there are none.","+ *","+ * @param share The share","+ */","+export function reshareSubtitle(share: SharingShare): string {","+\tconst reshared = share.recipients.filter((recipient) => recipient.initiator !== null && recipient.initiator.user_id !== share.owner.user_id).length","+\tif (reshared === 0) {","+\t\treturn ''","+\t}","+\treturn n('files_sharing', 'Reshared with %n person', 'Reshared with %n people', reshared)","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/lib/unifiedSharingConstants.ts","lines":["@@ -0,0 +1,20 @@","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+/**","+ * Hardcoded backend class strings from the unified sharing API, mirrored from","+ * the dialog library's constants. They are validated against the server","+ * capabilities at runtime before use (see `unifiedShares.ts`).","+ */","+","+/** Node (file/folder) source type. */","+export const SOURCE_TYPE_NODE = 'OCA\\\\Files\\\\Sharing\\\\Source\\\\NodeShareSourceType'","+","+/** Recipient type classes. */","+export const RECIPIENT_TYPE_USER = 'OC\\\\Core\\\\Sharing\\\\Recipient\\\\UserShareRecipientType'","+export const RECIPIENT_TYPE_EMAIL = 'OC\\\\Core\\\\Sharing\\\\Recipient\\\\EmailShareRecipientType'","+export const RECIPIENT_TYPE_GROUP = 'OC\\\\Core\\\\Sharing\\\\Recipient\\\\GroupShareRecipientType'","+export const RECIPIENT_TYPE_TEAM = 'OC\\\\Core\\\\Sharing\\\\Recipient\\\\TeamShareRecipientType'","+export const RECIPIENT_TYPE_TOKEN = 'OC\\\\Core\\\\Sharing\\\\Recipient\\\\TokenShareRecipientType'"],"additions":20,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/services/ConfigService.ts","lines":["@@ -4,6 +4,7 @@","  */"," import { getCapabilities } from '@nextcloud/capabilities'"," import { loadState } from '@nextcloud/initial-state'","+import { isSharingDialogAvailable } from './SharingDialog.ts'"," "," type PasswordPolicySettings = {"," \tenforceNonCommonPassword: boolean","@@ -354,4 +355,13 @@ export default class Config {"," \tget showExternalSharing(): boolean {"," \t\treturn loadState('files_sharing', 'showExternalSharing', true)"," \t}","+","+\t/**","+\t * Whether the new unified sharing dialog replaces the legacy inline sharing UI.","+\t * Derived from the server capabilities: when the unified sharing API is not","+\t * advertised (capability empty), the legacy inputs and menus are used instead.","+\t */","+\tget sharingDialogEnabled(): boolean {","+\t\treturn isSharingDialogAvailable()","+\t}"," }"],"additions":10,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/services/SharingDialog.ts","lines":["@@ -0,0 +1,63 @@","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import type { Node } from '@nextcloud/files'","+","+import { getCapabilities } from '@nextcloud/capabilities'","+","+/**","+ * The unified sharing dialog is a Vue 3 component. It is registered on the","+ * global `OCA.Sharing` namespace by the Vue 3 bridge entry point","+ * (`sharing-dialog-bridge.ts`), so this Vue 2 frontend can trigger it without","+ * pulling Vue 3 into its bundle.","+ */","+type SharingDialogApi = {","+\topenSharingDialog(node: Node): Promise<unknown>","+\topenShareEditDialog(shareId: string | number, node?: Node): Promise<unknown>","+}","+","+/**","+ * Get the sharing dialog API registered by the Vue 3 bridge, if loaded.","+ */","+function sharingDialogApi(): SharingDialogApi | undefined {","+\treturn (window.OCA?.Sharing as Partial<SharingDialogApi> | undefined) as SharingDialogApi | undefined","+}","+","+/**","+ * Whether the server provides the unified sharing API this dialog talks to.","+ * Mirrors the library check so the sidebar can gate on it without importing","+ * the Vue 3 code.","+ */","+export function isSharingDialogAvailable(): boolean {","+\tconst capabilities = getCapabilities() as { sharing?: { api_versions?: unknown[] } }","+\treturn (capabilities.sharing?.api_versions?.length ?? 0) > 0","+}","+","+/**","+ * Open the unified sharing dialog to create a new share for a node.","+ *","+ * @param node The file or folder to share","+ */","+export function openShareCreateDialog(node: Node): Promise<unknown> {","+\tconst api = sharingDialogApi()","+\tif (!api?.openSharingDialog) {","+\t\treturn Promise.reject(new Error('The unified sharing dialog is not available'))","+\t}","+\treturn api.openSharingDialog(node)","+}","+","+/**","+ * Open the unified sharing dialog to edit an existing share.","+ *","+ * @param shareId The share id (mapped to the unified API by the legacy bridge)","+ * @param node The backing node, used for the dialog title","+ */","+export function openShareEditDialog(shareId: string | number, node?: Node): Promise<unknown> {","+\tconst api = sharingDialogApi()","+\tif (!api?.openShareEditDialog) {","+\t\treturn Promise.reject(new Error('The unified sharing dialog is not available'))","+\t}","+\treturn api.openShareEditDialog(shareId, node)","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"apps/files_sharing/src/services/unifiedShares.ts","lines":["@@ -0,0 +1,96 @@","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+import type { Node } from '@nextcloud/files'","+import type { SharingShare } from '../types/unifiedSharing.ts'","+","+import axios from '@nextcloud/axios'","+import { getCapabilities } from '@nextcloud/capabilities'","+import { generateOcsUrl } from '@nextcloud/router'","+import { SOURCE_TYPE_NODE } from '../lib/unifiedSharingConstants.ts'","+import logger from './logger.ts'","+","+const PAGE_SIZE = 100","+","+type Capabilities = {","+\tsharing?: {","+\t\tsource_types?: { class: string }[]","+\t}","+}","+","+/**","+ * Whether the node source type is registered on the server. The hardcoded class","+ * string must match a capability entry, otherwise listing would silently return","+ * nothing.","+ */","+function isNodeSourceTypeAvailable(): boolean {","+\tconst capabilities = getCapabilities() as Capabilities","+\treturn (capabilities.sharing?.source_types ?? []).some((type) => type.class === SOURCE_TYPE_NODE)","+}","+","+/**","+ * Fetch every active share whose source is the given node, from the unified","+ * sharing API. Results are paginated by the backend; this walks all pages.","+ *","+ * @param node The file or folder whose shares to list","+ */","+export async function getSharesForNode(node: Node): Promise<SharingShare[]> {","+\tif (!isNodeSourceTypeAvailable()) {","+\t\tlogger.warn('Node source type is not advertised by the sharing capability; cannot list unified shares')","+\t\treturn []","+\t}","+","+\tconst url = generateOcsUrl('/apps/sharing/api/v1/shares')","+\tconst shares: SharingShare[] = []","+\tlet lastShareID: string | undefined","+","+\t// Walk pages until the backend returns a short (final) page.","+\tfor (;;) {","+\t\tconst response = await axios.get(url, {","+\t\t\tparams: {","+\t\t\t\tfilterSourceTypeClass: SOURCE_TYPE_NODE,","+\t\t\t\tfilterSourceTypeValue: String(node.fileid),","+\t\t\t\tfilterState: 'active',","+\t\t\t\tlimit: PAGE_SIZE,","+\t\t\t\t...(lastShareID ? { lastShareID } : {}),","+\t\t\t},","+\t\t})","+\t\tconst page: SharingShare[] = response.data.ocs.data","+\t\tshares.push(...page)","+\t\tif (page.length < PAGE_SIZE) {","+\t\t\tbreak","+\t\t}","+\t\tlastShareID = page[page.length - 1].id","+\t}","+","+\treturn shares","+}","+","+/**","+ * Delete a share by id.","+ *","+ * @param id The share id","+ */","+export async function deleteShare(id: string): Promise<void> {","+\tawait axios.delete(generateOcsUrl('/apps/sharing/api/v1/share/{id}', { id }))","+}","+","+/**","+ * Remove a single recipient from a share.","+ *","+ * @param id The share id","+ * @param recipientClass The