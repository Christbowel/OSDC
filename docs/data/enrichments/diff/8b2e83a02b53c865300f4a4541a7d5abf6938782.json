inherit perf enabled state\"","-            );","+            let _guard = ThreadTracker::tracking_inner(payload.clone());","+            assert!(!QueryPerf::flag(), \"no profiler is running\");","         }","-    }"," ","-    #[tokio::test]","-    async fn test_tracking_future_perf_inheritance() {","-        ThreadTracker::init();","+        // Set by `CpuProfiler::start`, which also starts the process-wide","+        // profiler that this test does not need.","+        {","+            let _guard = ThreadTracker::tracking_inner(payload.clone());","+            PROFILER_SCOPE.store(token, Ordering::Relaxed);","+            assert!(QueryPerf::flag(), \"a running query is picked up at once\");"," ","-        // Create payload with perf enabled","-        let mut payload = ThreadTracker::new_tracking_payload();","-        payload.perf_enabled = true;","+            let inherited = ThreadTracker::tracking_function(QueryPerf::flag);","+            assert!(inherited(), \"tracking function inherits the token\");"," ","-        {","-            assert!(","-                !QueryPerf::flag(),","-                \"Perf should NOT be enabled in outer scope\"","-            );","-","-            // Create a tracking future that should inherit the perf state","-            let tracked_future = payload.tracking(async {","-                // The future should see the perf state from TrackingPayload","-                QueryPerf::flag()","-            });","-","-            let result = tracked_future.await;","-            assert!(result, \"Tracking future should inherit perf enabled state\");","-        }","+            // Profiling another query while this one is still in `process()`.","+            PROFILER_SCOPE.store(QueryPerf::next_query_token(), Ordering::Relaxed);","+            assert!(!QueryPerf::flag(), \"another query is profiled\");"," ","-        // Test with perf disabled","-        let mut payload_disabled = ThreadTracker::new_tracking_payload();","-        payload