n meta.GetFolder(), nil","+\treturn v.(string), nil"," }"," "," type dashboardClient struct {"],"additions":67,"deletions":20,"truncated":false},{"path":"pkg/registry/apps/annotation/dashboard_folder_lookup_test.go","lines":["@@ -0,0 +1,196 @@","+package annotation","+","+import (","+\t\"context\"","+\t\"sync\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/prometheus/client_golang/prometheus\"","+\t\"github.com/prometheus/client_golang/prometheus/testutil\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\t\"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\tdynamicfake \"k8s.io/client-go/dynamic/fake\"","+\tk8stesting \"k8s.io/client-go/testing\"","+","+\tdashboardv1 \"github.com/grafana/grafana/apps/dashboard/pkg/apis/dashboard/v1\"","+\t\"github.com/grafana/grafana/pkg/apimachinery/identity\"","+\t\"github.com/grafana/grafana/pkg/infra/localcache\"","+)","+","+func newTestDashboardFolderResolver(cacheEnabled bool, objects ...runtime.Object) (*dashboardFolderResolver, *dynamicfake.FakeDynamicClient) {","+\tgvr := dashboardv1.DashboardResourceInfo.GroupVersionResource()","+\tscheme := runtime.NewScheme()","+\tlistKinds := map[schema.GroupVersionResource]string{gvr: \"DashboardList\"}","+\tfakeDyn := dynamicfake.NewSimpleDynamicClientWithCustomListKinds(scheme, listKinds, objects...)","+","+\tconst testCacheTTL = time.Minute","+\tr := &dashboardFolderResolver{","+\t\tclient:       &dashboardClient{gvr: gvr, dyn: fakeDyn},","+\t\ttracer:       testTracer,","+\t\tmetrics:      ProvideMetrics(prometheus.NewRegistry()),","+\t\tfetchTimeout: defaultFolderFetchTimeout,","+\t}","+\tif cacheEnabled {","+\t\tr.cache = localcache.New(testCacheTTL, time.Minute)","+\t\tr.cacheTTL = testCacheTTL","+\t}","+\treturn r, fakeDyn","+}","+","+type blockingDashboardGetter struct{}","+","+func (blockingDashboardGetter) Get(ctx context.Context, _, _ string) (*unstructured.Unstructured, error) {","+\t<-ctx.Done()","+\treturn nil, ctx.Err()","+}","+","+func newFakeDashboard(namespace, uid, folder string) *unstructured.Unstructured {","+\tdash := &unstructured.Unstructured{}","+\tdash.SetAPIVersion(dashboardv1.DashboardResourceInfo.GroupVersionKind().GroupVersion().String())","+\tdash.SetKind(\"Dashboard\")","+\tdash.SetNamespace(namespace)","+\tdash.SetName(uid)","+\tif folder != \"\" {","+\t\tdash.SetAnnotations(map[string]string{\"grafana.app/folder\": folder})","+\t}","+\treturn dash","+}","+","+func TestDashboardFolderResolver_ResolveFolder(t *testing.T) {","+\tconst (","+\t\tns        = \"default\"","+\t\tdashUID   = \"dash-abc\"","+\t\tfolderUID = \"folder-xyz\"","+\t)","+\tctx := identity.WithServiceIdentityContext(t.Context(), 1)","+","+\tcountGets := func(fakeDyn *dynamicfake.FakeDynamicClient) int {","+\t\tcount := 0","+\t\tfor _, a := range fakeDyn.Actions() {","+\t\t\tif a.GetVerb() == \"get\" {","+\t\t\t\tcount++","+\t\t\t}","+\t\t}","+\t\treturn count","+\t}","+","+\tt.Run(\"resolves folder and caches result\", func(t *testing.T) {","+\t\tresolver, fakeDyn := newTestDashboardFolderResolver(true, newFakeDashboard(ns, dashUID, folderUID))","+","+\t\tfolder, err := resolver.ResolveFolder(ctx, ns, dashUID)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, folderUID, folder)","+","+\t\tfolder, err = resolver.ResolveFolder(ctx, ns, dashUID)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, folderUID, folder)","+","+\t\tassert.Equal(t, 1, countGets(fakeDyn), \"subsequent ResolveFolder calls should be served from cache, not the apiserver\")","+\t\tassert.Equal(t, float64(1), testutil.ToFloat64(resolver.metrics.FolderCacheHits))","+\t\tassert.Equal(t, float64(1), testutil.ToFloat64(resolver.metrics.FolderCacheMisses))","+\t})","+","+\tt.Run(\"cache disabled resolves every call from the apiserver\", func(t *testing.T) {","+\t\tresolver, fakeDyn := newTestDashboardFolderResolver(false, newFakeDashboard(ns, dashUID, folderUID))","+","+\t\tfolder, err := resolver.ResolveFolder(ctx, ns, dashUID)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, folderUID, folder)","+","+\t\tfolder, err = resolver.ResolveFolder(ctx, ns, dashUID)","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, folderUID, folder)","+","+\t\tassert.Equal(t, 2, countGets(fakeDyn), \"every call should hit the apiserver when caching is disabled\")","+\t})","+","+\tt.Run(\"missing dashboard returns empty folder\", func(t *testing.T) {","+\t\tresolver, _ := newTestDashboardFolderResolver(true)","+","+\t\tfolder, err := resolver.ResolveFolder(ctx, ns, \"missing-uid\")","+\t\trequire.NoError(t, err)","+\t\tassert.Equal(t, \"\", folder)","+\t})","+","+\tt.Run(\"concurrent calls for the same dashboard groups into one fetch\", func(t *testing.T) {","+\t\tresolver, fakeDyn := newTestDashboardFolderResolver(true, newFakeDashboard(ns, dashUID, folderUID))","+","+\t\trelease := make(chan struct{})","+\t\tvar hits atomic.Int32","+\t\tfakeDyn.PrependReactor(\"get\", \"dashboards\", func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\t\thits.Add(1)","+\t\t\t<-release","+\t\t\treturn false, nil, nil","+\t\t})","+","+\t\tconst callers = 10","+\t\tvar wg sync.WaitGroup","+\t\tresults := make([]string, callers)","+\t\terrs := make([]error, callers)","+\t\tfor i := range callers {","+\t\t\twg.Add(1)","+\t\t\tgo func(idx int) {","+\t\t\t\tdefer wg.Done()","+\t\t\t\tresults[idx], errs[idx] = resolver.ResolveFolder(ctx, ns, dashUID)","+\t\t\t}(i)","+\t\t}","+","+\t\tassert.Eventually(t, func() bool { return hits.Load() > 0 }, time.Second, time.Millisecond)","+\t\tclose(release)","+\t\twg.Wait()","+","+\t\tfor i := range callers {","+\t\t\trequire.NoError(t, errs[i])","+\t\t\tassert.Equal(t, folderUID, results[i])","+\t\t}","+\t\tassert.Equal(t, int32(1), hits.Load(), \"concurrent lookups for the same dashboard should share a single apiserver fetch\")","+\t})","+","+\tt.Run(\"cancelling one caller does not fail others sharing the fetch\", func(t *testing.T) {","+\t\tresolver, fakeDyn := newTestDashboardFolderResolver(true, newFakeDashboard(ns, dashUID, folderUID))","+","+\t\trelease := make(chan struct{})","+\t\tentered := make(chan struct{})","+\t\tfakeDyn.PrependReactor(\"get\", \"dashboards\", func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\t\tclose(entered)","+\t\t\t<-release","+\t\t\treturn false, nil, nil","+\t\t})","+","+\t\tcancelCtx, cancel := context.WithCancel(ctx)","+","+\t\tvar wg sync.WaitGroup","+\t\twg.Go(func() {","+\t\t\t_, _ = resolver.ResolveFolder(cancelCtx, ns, dashUID)","+\t\t})","+","+\t\t<-entered","+\t\tcancel()","+","+\t\tvar waiterFolder string","+\t\tvar waiterErr error","+\t\twg.Go(func() {","+\t\t\twaiterFolder, waiterErr = resolver.ResolveFolder(ctx, ns, dashUID)","+\t\t})","+","+\t\tclose(release)","+\t\twg.Wait()","+","+\t\trequire.NoError(t, waiterErr, \"a waiter with a valid context should not fail because another caller's context was cancelled\")","+\t\tassert.Equal(t, folderUID, waiterFolder)","+\t})","+","+\tt.Run(\"shared fetch times out if the downstream call hangs\", func(t *testing.T) {","+\t\tresolver, _ := newTestDashboardFolderResolver(true, newFakeDashboard(ns, dashUID, folderUID))","+\t\tresolver.fetchTimeout = 10 * time.Millisecond","+\t\tresolver.client = blockingDashboardGetter{}","+","+\t\t_, err := resolver.ResolveFolder(ctx, ns, dashUID)","+\t\trequire.Error(t, err, \"the shared fetch should time out if the downstream call hangs\")","+\t})","+}"],"additions":196,"deletions":0,"truncated":false},{"path":"pkg/registry/apps/annotation/metrics.go","lines":["@@ -25,6 +25,9 @@ type Metrics struct {"," "," \tTagCacheHits   prometheus.Counter"," \tTagCacheMisses prometheus.Counter","+","+\tFolderCacheHits   prometheus.Counter","+\tFolderCacheMisses prometheus.Counter"," }"," "," // ProvideMetrics builds and registers the metrics collectors","@@ -88,6 +91,18 @@ func ProvideMetrics(reg 