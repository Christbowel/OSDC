e cache entry\", {stats});","-        const baseline = stats[0].baseline;","-        assert(baseline !== undefined, \"cache entry missing baseline\", {stats});","-        assert.gt(baseline.numReads + baseline.numIntermediateRows, 0, {baseline});","-        assert.eq(baseline.spilled, false, {baseline});","-","-        // baselineOverThreshold metric should not increment.","-        const baselineOverThresholdBefore = joinMetrics(this.db).baselineOverThreshold;","-        assert.eq(joinMetrics(this.db).baselineOverThreshold, baselineOverThresholdBefore, {","-            baselineOverThresholdBefore,","-        });","-    });","-","-    it(\"records a baseline independently of the request's batch size\", function () {","-        // The baseline is recorded from a fixed window of documents, unaffected by the request's","-        // batch size: batchSize: 0 gives the client an empty first batch, but the baseline run","-        // still executes the full window.","-        const cursor = this.baseColl.aggregate(this.pipeline, {cursor: {batchSize: 0}});","-        assert.eq(450, cursor.toArray().length);","-","-        const stats = entries(this.db);","-        assert.eq(1, stats.length, \"expected exactly one cache entry\", {stats});","-        const baseline = stats[0].baseline;","-        assert(baseline !== undefined, \"cache entry missing baseline\", {stats});","-        assert.gt(baseline.numReads + baseline.numIntermediateRows, 0, {baseline});","-        assert.eq(baseline.spilled, false, {baseline});","-    });","-","-    it(\"does not cache a plan whose baseline exceeds the gate\", function () {","-        runWithKnobs(","-            this.db,","-            () => {","-                const baselineOverThresholdBefore = joinMetrics(this.db).baselineOverThreshold;","-                assert.eq(450, this.baseColl.aggregate(this.pipeline).toArray().length);","-                assert.eq(0, entries(this.db).length, \"expected no cache entry\");","-                asser