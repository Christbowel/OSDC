","+        $ip = '2001:db8::' . \\dechex(\\random_int(1, 0xffff)) . ':' . \\dechex(\\random_int(1, 0xffff));","+","+        $this->startCountingInOneWindow(3600);","+        $response = $this->client->call(Client::METHOD_POST, '/account/sessions/email', $headers($ip), [","+            'email' => $email,","+            'password' => $password,","+        ]);","+        $this->assertSame(201, $response['headers']['status-code']);","+","+        // A new email every attempt, so the per-email limit never applies.","+        for ($i = 0; $i < 100; $i++) {","+            $response = $this->client->call(Client::METHOD_POST, '/account/sessions/email', $headers($ip), [","+                'email' => 'spray.' . \\bin2hex(\\random_bytes(8)) . '@example.com',","+                'password' => 'wrong-password',","+            ]);","+            $this->assertSame(401, $response['headers']['status-code'], 'Failure ' . ($i + 1) . ' is within the limit');","+        }","+","+        $response = $this->client->call(Client::METHOD_POST, '/account/sessions/email', $headers($ip), [","+            'email' => $email,","+            'password' => $password,","+        ]);","+        $this->assertSame(429, $response['headers']['status-code'], 'An IP over its failures is refused even with the right password, and the earlier success did not reset the count');","+","+        $response = $this->client->call(Client::METHOD_POST, '/account/sessions/email', $headers('2001:db8::' . \\dechex(\\random_int(1, 0xffff)) . ':1'), [","+            'email' => $email,","+            'password' => $password,","+        ]);","+        $this->assertSame(201, $response['headers']['status-code'], 'Another IP keeps its own count');","+    }","+","     #[Group('abuseEnabled')]","     public function testAbuseLimitIgnoresHost(): void","     {",""],"additions":55,"deletions":0,"truncated":false}],"additions":99,"deletions":0,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-03T16:48:07.356288+00:00