,"         }","         $duration ??= $maxDuration;"," ","+        // Only failures count, and a success does not reset the count: logging in to an account of one's own","+        // between guesses buys nothing. Requests with a key or a privileged session are exempt, as from every abuse limit.","+        $roles = $authorization->getRoles();","+        $countFailures = System::getEnv('_APP_OPTIONS_ABUSE', 'enabled') !== 'disabled'","+            && ! $user->isKey($roles)","+            && ! $user->isPrivileged($roles);","+        $failedLoginsLimit = self::FAILED_LOGINS_LIMIT;","+        $increasedLimitProjects = \\array_filter(\\array_map('trim', \\explode(',', System::getEnv('_APP_OPTIONS_ABUSE_INCREASED_LIMIT_PROJECTS', ''))));","+        if (\\in_array($project->getId(), $increasedLimitProjects, true)) {","+            $failedLoginsLimit *= 100;","+        }","+        $failedLogins = function (callable $callback) use ($timelimit, $failedLoginsLimit, $project, $request): mixed {","+            try {","+                return $timelimit('failed-logins:{projectId}:{ip}', $failedLoginsLimit, 3600, fn (TimeLimit $timeLimit): mixed => $callback($timeLimit->withParams([","+                    '{projectId}' => $project->getId(),","+                    '{ip}' => $request->getIP(),","+                ])));","+            } catch (\\Throwable $th) {","+                // A limiter outage fails open, as in the shared abuse check, rather than refusing every login.","+                \\error_log((string) $th);","+","+                return false;","+            }","+        };","+","+        if ($countFailures && $failedLogins(fn (TimeLimit $timeLimit): bool => $timeLimit->peek()->limited)) {","+            throw new Exception(Exception::GENERAL_RATE_LIMIT_EXCEEDED, 'Too many failed logins from this IP. Try again later.');","+        }","+","         $profile = $dbForProject->findOne('users', [","             Query::equal('email', [$email]),","         ]);","@@ -140,6 +180,1