{"id":"fb8bfaaade9c517be99194ab24dafa38e8dab16c","axis":"silent","repo":"microsoft/onnxruntime","sha":"fb8bfaaade9c517be99194ab24dafa38e8dab16c","parsed":{"files":[{"path":".github/workflows/windows_webgpu.yml","lines":["@@ -99,6 +99,13 @@ jobs:","         with:","           dotnet-version: \"8.x\""," ","+      - name: Test WebGPU NuGet packaging","+        run: python -m unittest plugin-ep-webgpu\\csharp\\test\\test_pack_nuget.py -v","+        shell: cmd","+        working-directory: ${{ github.workspace }}","+        env:","+          ORT_WEBGPU_TEST_REQUIRE_DOTNET_SDK: \"1\"","+","       - name: Use Nuget 6.x","         uses: nuget/setup-nuget@d105a947828025cd7a980103c35ba2bfae586d0f # v2.0.2","         with:"],"additions":7,"deletions":0,"truncated":false},{"path":"cmake/external/onnxruntime_external_deps.cmake","lines":["@@ -754,13 +754,6 @@ if (onnxruntime_USE_WEBGPU)","     if (NOT onnxruntime_ENABLE_DAWN_BACKEND_D3D12)","       message(FATAL_ERROR \"DAWN_USE_AGILITY_SDK requires the Dawn D3D12 backend.\")","     endif()","-    if (onnxruntime_USE_EP_API_ADAPTERS)","-      # Plugin EP packages cannot guarantee that the Agility SDK runtime DLLs are deployed","-      # next to the host executable.","-      message(FATAL_ERROR","-              \"DAWN_USE_AGILITY_SDK is not supported with onnxruntime_USE_EP_API_ADAPTERS=ON (plugin EP build). \"","-              \"It is intended for local development builds only.\")","-    endif()","   endif()"," ","   # TODO: the following code is used to disable building Dawn using vcpkg temporarily"],"additions":0,"deletions":7,"truncated":false},{"path":"cmake/onnxruntime_providers_webgpu.cmake","lines":["@@ -312,6 +312,10 @@","       endif()","     endif()"," ","+    if (DAWN_USE_AGILITY_SDK)","+      add_dependencies(onnxruntime_providers_webgpu copy_agility_sdk_dlls)","+    endif()","+","     # In the plugin EP shared library build the WebGPU EP is its own DLL","     # (onnxruntime_providers_webgpu.dll) rather than being linked into onnxruntime.dll, so the","     # delay-load flags accumulated above (notably /DELAYLOAD:user32.dll) must be applied to THIS target."],"additions":4,"deletions":0,"truncated":false},{"path":"cmake/onnxruntime_python.cmake","lines":["@@ -1267,6 +1267,19 @@ if (onnxruntime_USE_WEBGPU)","             $<TARGET_FILE_DIR:${build_output_target}>/onnxruntime/capi/","       )","     endif()","+","+    if (DAWN_USE_AGILITY_SDK)","+      add_dependencies(onnxruntime_pybind11_state copy_agility_sdk_dlls)","+      add_custom_command(","+        TARGET onnxruntime_pybind11_state POST_BUILD","+        COMMAND ${CMAKE_COMMAND} -E make_directory","+            $<TARGET_FILE_DIR:${build_output_target}>/onnxruntime/capi/D3D12","+        COMMAND ${CMAKE_COMMAND} -E copy_if_different","+            $<TARGET_FILE_DIR:${build_output_target}>/D3D12/D3D12Core.dll","+            $<TARGET_FILE_DIR:${build_output_target}>/D3D12/d3d12SDKLayers.dll","+            $<TARGET_FILE_DIR:${build_output_target}>/onnxruntime/capi/D3D12","+      )","+    endif()","   endif()","   if (onnxruntime_BUILD_DAWN_SHARED_LIBRARY)","     add_custom_command("],"additions":13,"deletions":0,"truncated":false},{"path":"docs/BuildWithDawnAgilitySDK.md","lines":["@@ -1,6 +1,28 @@"," # Build WebGPU with the D3D12 Agility SDK"," ","-Use `--use_dawn_agility_sdk` to build Dawn's D3D12 backend with ONNX Runtime's pinned preview D3D12 Agility SDK:","+Use `--use_dawn_agility_sdk` to build Dawn's D3D12 backend with ONNX Runtime's pinned preview D3D12 Agility SDK.","+","+For the WebGPU Plugin EP wheel (`onnxruntime-ep-webgpu`), first build the shared plugin library and then package it:","+","+```powershell","+python tools\\ci_build\\build.py `","+  --build_dir build\\WebGpuPlugin `","+  --no_telemetry `","+  --config Release `","+  --update --build `","+  --use_webgpu shared_lib `","+  --use_dawn_agility_sdk `","+  --skip_tests `","+  --parallel","+","+python plugin-ep-webgpu\\python\\build_wheel.py `","+  --binary_dir build\\WebGpuPlugin\\Release\\Release `","+  --version 0.1.0.devYYYYMMDD `","+  --use-dawn-agility-sdk `","+  --output_dir dist","+```","+","+For a local ONNX Runtime Python wheel with the built-in WebGPU EP:"," "," ```powershell"," python tools\\ci_build\\build.py `","@@ -10,14 +32,19 @@ python tools\\ci_build\\build.py `","   --update --build `","   --use_webgpu `","   --use_dawn_agility_sdk `","-  --build_shared_lib `","-  --skip_tests","+  --build_wheel `","+  --skip_tests `","+  --parallel"," ```"," ","-This option is intended for local development and supports Windows desktop x86, x64, and ARM64 targets. Windows ARM32,","-ARM64EC, and WindowsStore/UWP targets are not supported. WebGPU Plugin EP, Python wheels, C#, NuGet, Java, and Node.js","-packages are also not supported because they do not deploy the required D3D12 runtime DLLs. Custom Dawn checkouts","-selected with `onnxruntime_CUSTOM_DAWN_SRC_PATH` are not supported.","+Wheels with the built-in WebGPU EP are no longer officially published. Local builds retain Agility SDK support","+for now; the built-in WebGPU EP is planned for removal. Use the plugin EP for the published package workflow.","+","+This option supports Windows desktop x86, x64, and ARM64 targets. Windows ARM32, ARM64EC, and WindowsStore/UWP targets","+are not supported. Both local built-in WebGPU EP Python wheels and WebGPU Plugin EP Python wheels are supported.","+C#, NuGet, Java, and Node.js packaging through `build.py` is not supported because those paths do not deploy the","+required DLLs; plugin NuGet packaging uses the separate `plugin-ep-webgpu/csharp/pack_nuget.py` script.","+Custom Dawn checkouts selected with `onnxruntime_CUSTOM_DAWN_SRC_PATH` are not supported."," "," The pinned SDK requires Windows 10 version 1909 or newer. For versions 1909, 2004, and 20H2, the minimum OS build"," revisions are:","@@ -33,8 +60,9 @@ Because the pinned SDK is a preview release, Windows Developer Mode must be enab"," and consult Microsoft's"," [AgilitySDK 721 Preview announcement](https://devblogs.microsoft.com/directx/announcing-agilitysdk-721-preview-and-more-shader-model-6-10-features/)"," for the current per-vendor driver links and feature-support table. Feature availability depends on the GPU and driver.","-At runtime, Dawn loads the SDK DLLs from the `D3D12` directory next to the executable. Look for `[AgilitySDK] active`","-in the Dawn log to confirm successful activation.","+At runtime, Dawn loads the SDK DLLs from the `D3D12` directory next to the Dawn module. In a local wheel with the","+built-in WebGPU EP this is `onnxruntime/capi/D3D12`; in the WebGPU plugin wheel it is `onnxruntime_ep_webgpu/D3D12`.","+Look for `[AgilitySDK] active` in the Dawn log to confirm successful activation."," "," For direct CMake configuration, enable `onnxruntime_USE_WEBGPU`, `onnxruntime_ENABLE_DAWN_BACKEND_D3D12`, and"," `DAWN_USE_AGILITY_SDK`. The SDK is downloaded to `third_party/agility-sdk` in the Dawn source tree managed by ONNX"],"additions":37,"deletions":9,"truncated":false},{"path":"plugin-ep-webgpu/README.md","lines":["@@ -32,7 +32,10 @@ build (`--use_webgpu shared_lib`). The resulting binaries are then packaged into"," - Per-platform zip packages for Foundry Local consumption."," "," On Windows, the packages also bundle the DirectX Shader Compiler runtime (`dxcompiler.dll`) from the","-[DXC GitHub releases](https://github.com/microsoft/DirectXShaderCompiler/releases); CI fetches these automatically.","+[DXC GitHub releases](https://github.com/microsoft/DirectXShaderCompiler/releases); CI fetches it automatically.","+The Windows Python wheels, NuGet package, and Foundry Local zip packages produced by CI also bundle the pinned preview","+D3D12 Agility SDK runtime. See the [Agility SDK guidance](../docs/BuildWithDawnAgilitySDK.md) for Windows, driver, and","+Developer Mode prerequisites."," "," Packaging is driven by the *WebGPU Plugin EP Packaging Pipeline*"," ([`plugin-webgpu-pipeline.yml`](../tools/ci_build/github/azure-pipelines/plugin-webgpu-pipeline.yml)),"],"additions":4,"deletions":1,"truncated":false},{"path":"plugin-ep-webgpu/_packaging_utils.py","lines":["@@ -11,6 +11,31 @@"," # Matches \"@var@\" template variables."," _TEMPLATE_VARIABLE_PATTERN = re.compile(r\"@(\\w+)@\")"," ","+PLUGIN_BINARIES = {","+    \"Windows\": (Path(\"onnxruntime_providers_webgpu.dll\"), Path(\"dxcompiler.dll\")),","+    \"Linux\": (Path(\"libonnxruntime_providers_webgpu.so\"),),","+    \"Darwin\": (Path(\"libonnxruntime_providers_webgpu.dylib\"),),","+}","+","+WINDOWS_AGILITY_SDK_BINARIES = (Path(\"D3D12/D3D12Core.dll\"), Path(\"D3D12/d3d12SDKLayers.dll\"))","+","+","+def get_plugin_binaries(target_platform: str, *, include_agility_sdk_files: bool = False) -> tuple[Path, ...]:","+    \"\"\"Return the required plugin binaries for a target platform.","+","+    Returned paths are relative to the binary directory provided by the caller.","+    `target_platform` uses `platform.system()` names such as \"Windows\", \"Linux\", and \"Darwin\".","+    \"\"\"","+    try:","+        binaries = list(PLUGIN_BINARIES[target_platform])","+    except KeyError as e:","+        raise ValueError(f\"Unsupported WebGPU packaging platform: {target_platform}\") from e","+","+    if target_platform == \"Windows\" and include_agility_sdk_files:","+        binaries.extend(WINDOWS_AGILITY_SDK_BINARIES)","+","+    return tuple(binaries)","+"," "," def gen_file_from_template(","     template_file: Path, output_file: Path, variable_substitutions: dict[str, str], strict: bool = True"],"additions":25,"deletions":0,"truncated":false},{"path":"plugin-ep-webgpu/csharp/Microsoft.ML.OnnxRuntime.EP.WebGpu/Microsoft.ML.OnnxRuntime.EP.WebGpu.csproj","lines":["@@ -33,6 +33,9 @@","     <!-- LICENSE and ThirdPartyNotices.txt are staged here from the repo root by pack_nuget.py. -->","     <None Include=\"LICENSE\" Pack=\"true\" PackagePath=\"\" Visible=\"false\" />","     <None Include=\"ThirdPartyNotices.txt\" Pack=\"true\" PackagePath=\"\" Visible=\"false\" />","+    <None Include=\"Microsoft.ML.OnnxRuntime.EP.WebGpu.targets\"","+          Pack=\"true\"","+          PackagePath=\"buildTransitive/\" />","   </ItemGroup>"," ","   <!-- Native binaries per platform. Each ItemGroup is conditioned on the runtimes/ directory"],"additions":3,"deletions":0,"truncated":false},{"path":"plugin-ep-webgpu/csharp/Microsoft.ML.OnnxRuntime.EP.WebGpu/Microsoft.ML.OnnxRuntime.EP.WebGpu.targets","lines":["@@ -0,0 +1,33 @@","+<Project>","+  <PropertyGroup>","+    <_OrtWebGpuPackageId>Microsoft.ML.OnnxRuntime.EP.WebGpu</_OrtWebGpuPackageId>","+  </PropertyGroup>","+","+  <Target Name=\"_OrtWebGpuCopyAgilitySdkToOutput\"","+          AfterTargets=\"CopyFilesToOutputDirectory\">","+    <ItemGroup>","+      <_OrtWebGpuOutputProvider Include=\"@(ReferenceCopyLocalPaths)\"","+                               Condition=\"'%(ReferenceCopyLocalPaths.NuGetPackageId)' == '$(_OrtWebGpuPackageId)' and '%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'onnxruntime_providers_webgpu.dll'\" />","+      <_OrtWebGpuAgilitySdkDll Include=\"%(_OrtWebGpuOutputProvider.RootDir)%(_OrtWebGpuOutputProvider.Directory)D3D12\\*.dll\">","+        <SdkDestinationDirectory>$(TargetDir)%(_OrtWebGpuOutputProvider.DestinationSubDirectory)D3D12\\</SdkDestinationDirectory>","+      </_OrtWebGpuAgilitySdkDll>","+    </ItemGroup>","+    <Copy SourceFiles=\"@(_OrtWebGpuAgilitySdkDll)\"","+          DestinationFiles=\"@(_OrtWebGpuAgilitySdkDll->'%(SdkDestinationDirectory)%(Filename)%(Extension)')\"","+          SkipUnchangedFiles=\"true\" />","+  </Target>","+","+  <Target Name=\"_OrtWebGpuCopyAgilitySdkToPublish\"","+          AfterTargets=\"Publish\">","+    <ItemGroup>","+      <_OrtWebGpuPublishProvider Include=\"@(ResolvedFileToPublish)\"","+                                Condition=\"'%(ResolvedFileToPublish.NuGetPackageId)' == '$(_OrtWebGpuPackageId)' and '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_webgpu.dll'\" />","+      <_OrtWebGpuAgilitySdkPublishDll Include=\"%(_OrtWebGpuPublishProvider.RootDir)%(_OrtWebGpuPublishProvider.Directory)D3D12\\*.dll\">","+        <SdkDestinationDirectory>$(PublishDir)$([System.IO.Path]::GetDirectoryName('%(_OrtWebGpuPublishProvider.RelativePath)'))\\D3D12\\</SdkDestinationDirectory>","+      </_OrtWebGpuAgilitySdkPublishDll>","+    </ItemGroup>","+    <Copy SourceFiles=\"@(_OrtWebGpuAgilitySdkPublishDll)\"","+          DestinationFiles=\"@(_OrtWebGpuAgilitySdkPublishDll->'%(SdkDestinationDirectory)%(Filename)%(Extension)')\"","+          SkipUnchangedFiles=\"true\" />","+  </Target>","+</Project>"],"additions":33,"deletions":0,"truncated":false},{"path":"plugin-ep-webgpu/csharp/Microsoft.ML.OnnxRuntime.EP.WebGpu/README.md","lines":["@@ -12,6 +12,18 @@ registered."," "," On Linux, a system Vulkan loader (`libvulkan.so.1`) must be installed and available at runtime."," ","+On Windows, Agility-enabled builds of this package include the pinned preview D3D12 Agility SDK runtime. The","+`buildTransitive` target copies the SDK DLLs into a `D3D12` directory next to the WebGPU provider after build and","+publish. Activation requires a supported Windows version with the Agility SDK loader update, Windows Developer Mode","+because the SDK is a preview release, and a compatible GPU driver. The pinned SDK requires Windows 10 version 1909 or","+newer. For Windows 10 versions 1909, 2004, and 20H2, version 1909 requires build 18363.1350 or newer, while versions","+2004 and 20H2 require revision 789 or newer. Later Windows versions do not require a separate revision check. The","+presence of `%SystemRoot%\\System32\\D3D12Core.dll` also confirms that the system has the Agility SDK loader update. For","+setup details and current driver guidance, see Microsoft's","+[DirectX 12 Agility SDK setup guide](https://devblogs.microsoft.com/directx/gettingstarted-dx12agility/#setup)","+and the","+[Agility SDK 721 Preview announcement](https://devblogs.microsoft.com/directx/announcing-agilitysdk-721-preview-and-more-shader-model-6-10-features/).","+"," ### Supported Platforms"," "," | Runtime Identifier (RID) |"],"additions":12,"deletions":0,"truncated":false},{"path":"plugin-ep-webgpu/csharp/README.md","lines":["@@ -22,6 +22,25 @@ csharp/"," "," - .NET SDK 8.0 or later"," - Pre-built WebGPU plugin EP binaries (from CI or a local build)","+- For Agility-enabled Windows x64 and ARM64 plugins, provide the matching D3D12 Agility SDK DLLs.","+","+### Windows Agility SDK inputs","+","+Windows plugins built without `--use_dawn_agility_sdk` can be packaged without SDK DLLs. For an","+Agility-enabled plugin, provide the following files under `--binary-dir-win-*` or the corresponding","+`--artifacts-dir` directory:","+","+```text","+onnxruntime_providers_webgpu.dll","+dxcompiler.dll","+D3D12/","+  D3D12Core.dll","+  d3d12SDKLayers.dll","+```","+","+Use `--use-dawn-agility-sdk` to include and require both SDK DLLs when packaging an Agility-enabled plugin. Without this","+option, the SDK DLLs are not staged. In a two-phase workflow, pass it to `--build-only`; the resulting staging directory","+is reused by `--pack-only`."," "," ## Building the NuGet Package"," ","@@ -41,6 +60,14 @@ python pack_nuget.py --version 0.1.0-dev `","   --binary-dir-win-x64 <path-to-win-x64-binaries>"," ```"," ","+For an Agility-enabled input, require the SDK explicitly:","+","+```powershell","+python pack_nuget.py --version 0.1.0-dev `","+  --binary-dir-win-x64 <path-to-win-x64-binaries> `","+  --use-dawn-agility-sdk","+```","+"," ### Pack multiple platforms"," "," Each `--binary-dir-*` points at the directory containing that platform's already-built native binaries. In practice"],"additions":27,"deletions":0,"truncated":false},{"path":"plugin-ep-webgpu/csharp/pack_nuget.py","lines":["@@ -34,13 +34,13 @@"," import tempfile"," from pathlib import Path"," ","-# Platform name -> (RID, list of native binary filenames expected in the source dir).","-PLATFORMS: dict[str, tuple[str, tuple[str, ...]]] = {","-    \"win_x64\": (\"win-x64\", (\"onnxruntime_providers_webgpu.dll\", \"dxcompiler.dll\")),","-    \"win_arm64\": (\"win-arm64\", (\"onnxruntime_providers_webgpu.dll\", \"dxcompiler.dll\")),","-    \"linux_x64\": (\"linux-x64\", (\"libonnxruntime_providers_webgpu.so\",)),","-    \"linux_aarch64\": (\"linux-arm64\", (\"libonnxruntime_providers_webgpu.so\",)),","-    \"macos_arm64\": (\"osx-arm64\", (\"libonnxruntime_providers_webgpu.dylib\",)),","+# Packaging platform key -> (NuGet runtime identifier, target platform name).","+PLATFORM_TARGETS: dict[str, tuple[str, str]] = {","+    \"win_x64\": (\"win-x64\", \"Windows\"),","+    \"win_arm64\": (\"win-arm64\", \"Windows\"),","+    \"linux_x64\": (\"linux-x64\", \"Linux\"),","+    \"linux_aarch64\": (\"linux-arm64\", \"Linux\"),","+    \"macos_arm64\": (\"osx-arm64\", \"Darwin\"),"," }"," "," SCRIPT_DIR = Path(__file__).resolve().parent","@@ -55,7 +55,29 @@"," "," # Import the shared template helper from _packaging_utils.py in the parent directory."," sys.path.insert(0, str(SCRIPT_DIR.parent))","-from _packaging_utils import gen_file_from_template  # noqa: E402  (path setup must precede import)","+from _packaging_utils import (  # noqa: E402  (path setup must precede import)","+    gen_file_from_template,","+    get_plugin_binaries,","+)","+","+","+def get_platforms(*, include_agility_sdk_files: bool = False) -> dict[str, tuple[str, tuple[str, ...]]]:","+    return {","+        name: (","+            rid,","+            tuple(","+                path.as_posix()","+                for path in get_plugin_binaries(","+                    target_platform,","+                    include_agility_sdk_files=include_agility_sdk_files,","+                )","+            ),","+        )","+        for name, (rid, target_platform) in PLATFORM_TARGETS.items()","+    }","+","+","+PLATFORM_NAMES = tuple(PLATFORM_TARGETS)"," "," "," class PackError(RuntimeError):","@@ -79,6 +101,11 @@ def _absolute_path(value: str) -> Path:","         help=\"Directory for the .nupkg / .snupkg output (default: ./nuget_output).\",","     )","     p.add_argument(\"--configuration\", default=\"Release\", help=\"Build configuration (default: Release).\")","+    p.add_argument(","+        \"--use-dawn-agility-sdk\",","+        action=\"store_true\",","+        help=\"Include and require both Agility SDK DLLs for each Windows platform.\",","+    )"," ","     # CI mode: a single root containing per-platform subdirectories.","     p.add_argument(","@@ -89,7 +116,7 @@ def _absolute_path(value: str) -> Path:"," ","     # Local mode: explicit per-platform binary directories. Each takes precedence over","     # --artifacts-dir for that platform.","-    for name in PLATFORMS:","+    for name in PLATFORM_NAMES:","         flag = f\"--binary-dir-{name.replace('_', '-')}\"","         p.add_argument(flag, type=_absolute_path, dest=f\"binary_dir_{name}\", help=f\"Path to {name} native binaries.\")"," ","@@ -132,10 +159,10 @@ def _absolute_path(value: str) -> Path:"," "," def parse_required_platforms(value: str) -> list[str]:","     names = [tok.strip() for tok in value.split(\",\") if tok.strip()]","-    invalid = [n for n in names if n not in PLATFORMS]","+    invalid = [n for n in names if n not in PLATFORM_NAMES]","     if invalid:","         raise PackError(","-            f\"unknown platform(s) in --required-platforms: {', '.join(invalid)}. valid: {', '.join(PLATFORMS)}.\"","+            f\"unknown platform(s) in --required-platforms: {', '.join(invalid)}. valid: {', '.join(PLATFORM_NAMES)}.\"","         )","     return names"," ","@@ -194,8 +221,9 @@ def stage_binaries(","     required_platforms: list[str],"," ) -> None:","     staged: set[str] = set()","+    platforms = get_platforms(include_agility_sdk_files=args.use_dawn_agility_sdk)"," ","-    for name, (rid, files) in PLATFORMS.items():","+    for name, (rid, platform_files) in pla