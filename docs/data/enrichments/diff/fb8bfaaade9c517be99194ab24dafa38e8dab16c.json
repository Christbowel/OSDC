       pack_args = [","+            \"dotnet\",","+            \"pack\",","+            *dotnet_common_args(staged_csproj, args),","+            \"--output\",","+            str(pack_output_dir),","+        ]","+        if args.pack_only:","+            pack_args.append(\"--no-build\")","+        print(\"+ \" + \" \".join(pack_args))","+        subprocess.run(pack_args, check=True)","+","+        print()","+        nupkgs = sorted(pack_output_dir.glob(\"*.nupkg\"))","+        if not nupkgs:","+            raise PackError(f\"no .nupkg files found in {pack_output_dir}\")","+","+        output_dir.mkdir(parents=True, exist_ok=True)","+        for pkg in nupkgs + sorted(pack_output_dir.glob(\"*.snupkg\")):","+            shutil.copy2(pkg, output_dir / pkg.name)","+            print(f\"Produced: {pkg.name} ({pkg.stat().st_size / (1024 * 1024):.2f} MB)\")"," "," "," def render_readme(staging_dir: Path, min_ort_version: str) -> None:"],"additions":67,"deletions":34,"truncated":false},{"path":"plugin-ep-webgpu/csharp/test/test_pack_nuget.py","lines":["@@ -0,0 +1,312 @@","+import argparse","+import contextlib","+import io","+import os","+import shutil","+import subprocess","+import sys","+import tempfile","+import unittest","+import unittest.mock","+import xml.etree.ElementTree as ET","+import zipfile","+from pathlib import Path","+from typing import cast","+","+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))","+import pack_nuget","+","+","+def get_dotnet_sdk_major():","+    dotnet = shutil.which(\"dotnet\")","+    if not dotnet:","+        return None","+","+    try:","+        result = subprocess.run(","+            [dotnet, \"--list-sdks\"],","+            check=False,","+            capture_output=True,","+            text=True,","+            timeout=30,","+        )","+    except (OSError, subprocess.TimeoutExpired):","+        return None","+","+    if result.returncode != 0:","+        return None","+","+    sdk_majors = []","+    for line in result.stdout.splitlines():","+        try:","+            sdk_majors.append(int(line.partition(\".\")[0]))","+        except ValueError:","+            continue","+    return max(sdk_majors, default=None)","+","+","+DOTNET_SDK_MAJOR = get_dotnet_sdk_major()","+DOTNET_SDK_REQUIRED = os.environ.get(\"ORT_WEBGPU_TEST_REQUIRE_DOTNET_SDK\") == \"1\"","+WINDOWS_BINARIES = pack_nuget.get_platforms()[\"win_x64\"][1]","+WINDOWS_BINARIES_WITH_AGILITY_SDK = pack_nuget.get_platforms(include_agility_sdk_files=True)[\"win_x64\"][1]","+WINDOWS_AGILITY_SDK_BINARIES = tuple(","+    filename for filename in WINDOWS_BINARIES_WITH_AGILITY_SDK if filename not in WINDOWS_BINARIES","+)","+","+","+def should_run_dotnet_sdk_test(sdk_major, sdk_required):","+    return sdk_required or (sdk_major is not None and sdk_major >= 8)","+","+","+class PackNugetTest(unittest.TestCase):","+    def setUp(self):","+        temporary = tempfile.TemporaryDirectory()","+        self.addCleanup(temporary.cleanup)","+        self.root = Path(temporary.name)","+        self.staging = self.root / \"staging\"","+","+    def stage_platform(self, platform, missing=None, *, include_agility_sdk=True, use_dawn_agility_sdk=False):","+        source = Path(tempfile.mkdtemp(dir=self.root))","+        platforms = pack_nuget.get_platforms()","+        files = list(platforms[platform][1])","+        if platform.startswith(\"win_\") and include_agility_sdk:","+            files.extend(WINDOWS_AGILITY_SDK_BINARIES)","+        for filename in files:","+            if filename != missing:","+                path = source / filename","+                path.parent.mkdir(parents=True, exist_ok=True)","+                path.write_bytes(filename.encode())","+        args = argparse.Namespace(","+            artifacts_dir=None,","+            use_dawn_agility_sdk=use_dawn_agility_sdk,","+            **{f\"binary_dir_{name}\": source if name == platform else None for name in pack_nuget.PLATFORM_NAMES},","+        )","+        with contextlib.redirect_stdout(io.StringIO()):","+            pack_nuget.stage_binaries(self.staging, args, [platform])","+","+    def write_staged_package(self, package):","+        with zipfile.ZipFile(package, \"w\") as archive:","+            for path in self.staging.rglob(\"*\"):","+                if path.is_file():","+                    archive.write(path, path.relative_to(self.staging).as_posix())","+            archive.writestr(\"buildTransitive/Microsoft.ML.OnnxRuntime.EP.WebGpu.targets\", b\"test\")","+","+    def test_stage_binaries_preserves_layout(self):","+        for platform, (rid, files) in pack_nuget.get_platforms().items():","+            with self.subTest(platform=platform):","+                use_dawn_agility_sdk = rid.startswith(\"win-\")","+                self.stage_platform(platform, use_dawn_agility_sdk=use_dawn_agility_sdk)","+                expected_files = list(files)","+                if use_dawn_agility_sdk:","+                    expected_files.extend(WINDOWS_AGILITY_SDK_BINARIES)","+                for filename in expected_files:","+                    destination = self.staging / \"runtimes\" / rid / \"native\" / filename","+                    self.assertEqual(destination.read_bytes(), filename.encode())","+","+    def test_stage_binaries_rejects_missing_agility_dll(self):","+        for platform in (\"win_x64\", \"win_arm64\"):","+            for missing in WINDOWS_AGILITY_SDK_BINARIES:","+                with self.subTest(platform=platform, missing=missing), self.assertRaises(pack_nuget.PackError):","+                    self.stage_platform(platform, missing, use_dawn_agility_sdk=True)","+","+    def test_parse_agility_requirement(self):","+        for required in (False, True):","+            with self.subTest(required=required):","+                argv = [\"pack_nuget.py\", \"--version\", \"0.1.0\"]","+                if required:","+                    argv.append(\"--use-dawn-agility-sdk\")","+                with unittest.mock.patch.object(sys, \"argv\", argv):","+                    self.assertEqual(pack_nuget.parse_args().use_dawn_agility_sdk, required)","+","+    def test_get_dotnet_sdk_major(self):","+        with (","+            unittest.mock.patch.object(shutil, \"which\", return_value=\"dotnet\"),","+            unittest.mock.patch.object(","+                subprocess,","+                \"run\",","+                return_value=subprocess.CompletedProcess(","+                    args=[], returncode=0, stdout=\"7.0.410 [sdk-path]\\n8.0.408 [sdk-path]\\n\", stderr=\"\"","+                ),","+            ),","+        ):","+            self.assertEqual(get_dotnet_sdk_major(), 8)","+","+        with (","+            unittest.mock.patch.object(shutil, \"which\", return_value=\"dotnet\"),","+            unittest.mock.patch.object(","+                subprocess,","+                \"run\",","+                return_value=subprocess.CompletedProcess(args=[], returncode=0, stdout=\"\", stderr=\"\"),","+            ),","+        ):","+            self.assertIsNone(get_dotnet_sdk_major())","+","+        with unittest.mock.patch.object(shutil, \"which\", return_value=None):","+            self.assertIsNone(get_dotnet_sdk_major())","+","+        self.assertFalse(should_run_dotnet_sdk_test(None, False))","+        self.assertFalse(should_run_dotnet_sdk_test(7, False))","+        self.assertTrue(should_run_dotnet_sdk_test(8, False))","+        self.assertTrue(should_run_dotnet_sdk_test(None, True))","+","+    def test_stage_binaries_agility_requirement(self):","+        platforms = pack_nuget.get_platforms()","+        for platform in platforms:","+            for include_sdk in (False, True):","+                for required in (False, True):","+                    with self.subTest(platform=platform, include_sdk=include_sdk, required=required):","+                        self.staging = self.root / f\"{platform}-{include_sdk}-{required}\"","+                        if platform.startswith(\"win_\") and required and not include_sdk:","+                            with self.assertRaises(pack_nuget.PackError):","+                                self.stage_platform(platform, include_agility_sdk=False, use_dawn_agility_sdk=True)","+                        else:","+                            self.stage_platform(","+                                platform, include_agility_sdk=include_sdk, use_dawn_agility_sdk=required","+                            )","+                            rid = platforms[platform][0]","+                            sdk_dir = self.staging / \"runtimes\" / rid / \"native\" / \"D3D12\"","+                            self.assertEqual(sdk_dir.is_dir(), platform.startswith(\"win_\") and include_sdk and required)","+","+    def test_pack_preserves_history_and_replaces_only_current_packages(self):","+        self.stage_platform(\"win_x64\", use_dawn_agility_sdk=True)","+        output = self.root / \"output\"","+        output.mkdir()","+        package_id = \"Microsoft.ML.OnnxRuntime.EP.WebGpu\"","+        old_package = output / f\"{package_id}.0.1.0.nupkg\"","+        old_symbols = output / f\"{package_id}.0.1.0.snupkg\"","+        current_package = output / f\"{package_id}.0.2.0.nupkg\"","+        current_symbols = output / f\"{package_id}.0.2.0.snupkg\"","+        for package in (old_package, old_symbols, current_package, current_symbols):","+            package.write_bytes(b\"previous build\")","+","+        def produce_package(command, *, check):","+            self.assertTrue(check)","+            temporary_output = Path(command[command.index(\"--output\") + 1])","+            self.assertNotEqual(temporary_output, output)","+            self.write_staged_package(temporary_output / current_package.name)","+            (temporary_output / current_symbols.name).write_bytes(b\"current symbols\")"],"additions":187,"deletions":0,"truncated":false}],"additions":419,"deletions":51,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-10-21