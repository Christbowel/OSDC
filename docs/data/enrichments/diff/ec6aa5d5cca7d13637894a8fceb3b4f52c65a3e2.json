soft.Extensions.DependencyInjection;","@@ -366,6 +367,42 @@ public IAsyncStream<T> GetStream<T>(StreamId streamId)"," ","     #region QualifiedStreamId JSON identity contracts (InternalStreamId.cs)"," ","+    [Fact]","+    public void QualifiedStreamId_GetObjectDataRejectsNullAndPreservesLegacyEntries()","+    {","+        var streamId = StreamId.Create(\"orders\", \"order-42\");","+        var value = new QualifiedStreamId(\"fake\", streamId);","+        Assert.Throws<ArgumentNullException>(\"info\", () => value.GetObjectData(null!, default));","+","+#pragma warning disable SYSLIB0050 // Exercise the existing ISerializable metadata contract, not formatter serialization.","+        var info = new SerializationInfo(typeof(QualifiedStreamId), new FormatterConverter());","+#pragma warning restore SYSLIB0050","+        value.GetObjectData(info, default);","+","+        Assert.Equal(2, info.MemberCount);","+        var entries = info.GetEnumerator();","+        Assert.True(entries.MoveNext());","+        Assert.Equal(\"pvn\", entries.Name);","+        Assert.Equal(typeof(string), entries.ObjectType);","+        Assert.Equal(\"fake\", entries.Value);","+        Assert.True(entries.MoveNext());","+        Assert.Equal(\"sid\", entries.Name);","+        Assert.Equal(typeof(StreamId), entries.ObjectType);","+        Assert.Equal(streamId, Assert.IsType<StreamId>(entries.Value));","+        Assert.False(entries.MoveNext());","+    }","+","+    [Fact]","+    public void QualifiedStreamIdJsonConverterRejectsNullWriters()","+    {","+        var converter = new QualifiedStreamIdJsonConverter();","+        var value = new QualifiedStreamId(\"fake\", StreamId.Create(\"orders\", \"order-42\"));","+        var options = new JsonSerializerOptions();","+","+        Assert.Throws<ArgumentNullException>(\"writer\", () => converter.Write(null!, value, options));","+        Assert.Throws<ArgumentNullException>(\"writer\", () => converter.WriteAsPropertyName(null!, value, options));","+   