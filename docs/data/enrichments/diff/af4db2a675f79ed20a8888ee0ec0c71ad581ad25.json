st.LogCaptureFixture,","+    reason: str,","+    enable_ep: bool,"," ) -> None:","     monkeypatch.setattr(","         fused_moe_utils.rocm_aiter_ops,","@@ -414,13 +540,20 @@ def test_resolve_layer_fused_shared_expert_rejects_incompatible_quantization(","     monkeypatch.setattr(","         fused_moe_utils,","         \"is_shared_expert_quant_fse_compatible\",","-        lambda *_, **__: (False, \"shared experts are excluded\"),","+        lambda *_, **__: (False, reason),","+    )","+    monkeypatch.setattr(","+        \"vllm.config.get_current_vllm_config_or_none\",","+        lambda: SimpleNamespace(","+            parallel_config=SimpleNamespace(enable_expert_parallel=enable_ep)","+        ),","     )","+    _print_warning_once.cache_clear()"," ","     assert not fused_moe_utils.resolve_layer_fused_shared_expert(","-        ExpertsInt8Config(), \"model.layers.0.mlp\"","+        ExpertsInt8Config(), \"model.layers.0.mlp\", disable_under_ep=enable_ep","     )","-    assert \"shared experts are excluded\" in caplog.text","+    assert reason in caplog.text"," "," "," def test_deepseek_v4_shared_expert_fse_uses_mtp_quantization_config_prefix(","@@ -884,45 +1017,409 @@ def test_aiter_fused_moe_validates_shared_expert_arguments() -> None:","     assert validate(shared_tensor, shared_tensor, shared_tensor, shared_tensor, 0)"," "," ","-def test_is_model_fused_shared_expert_compatible() -> None:","-    class MoE(nn.Module):","-        def __init__(self, enabled: bool) -> None:","-            super().__init__()","-            self.is_fused_shared_expert_enabled = enabled","+def test_deepseek_v4_shared_expert_mapper_fallback() -> None:","+    \"\"\"Mixed and all-excluded DSV4 checkpoints map shared experts correctly.\"\"\"","+    from vllm.models.deepseek_v4.amd.model import (","+        _make_deepseek_v4_weights_mapper,","+        _redirect_shared_expert_name,","+    )","+","+    tensor = torch.empty(0)","+    fuse_by_layer = frozenset({6})","+    # Mixed: any fused layer puts the mapper in fused mode, which leaves the","+    # checkpoint .w2 names untouched; the loader redirects per layer.","+    mapper = _make_deepseek_v4_weights_mapper(\"fp8\", fuse_shared_experts=True)","+    for raw, expected in [","+        (","+            \"layers.5.ffn.shared_experts.w2.weight\",","+            \"model.layers.5.ffn.shared_experts.down_proj.weight\",","+        ),","+        (","+            \"layers.5.ffn.shared_experts.w2.scale\",","+            \"model.layers.5.ffn.shared_experts.down_proj.weight_scale_inv\",","+        ),","+        (","+            \"layers.6.ffn.shared_experts.w2.weight\",","+            \"model.layers.6.ffn.experts.4.w2.weight\",","+        ),","+        (","+            \"layers.6.ffn.shared_experts.w2.scale\",","+            \"model.layers.6.ffn.experts.4.w2.weight_scale_inv\",","+        ),","+    ]:","+        [(mapped, _)] = list(mapper.apply([(raw, tensor)]))","+        assert _redirect_shared_expert_name(mapped, fuse_by_layer, 4) == expected","+","+    # All layers excluded (fused_shared_expert_layers == frozenset()) selects","+    # the unfused mapper, which renames .w2 -> .down_proj itself.","+    mapper = _make_deepseek_v4_weights_mapper(\"fp8\", fuse_shared_experts=False)","+    for raw, expected in [","+        (","+            \"layers.5.ffn.shared_experts.w2.weight\",","+            \"model.layers.5.ffn.shared_experts.down_proj.weight\",","+        ),","+        (","+            \"layers.5.ffn.shared_experts.w2.scale\",","+            \"model.layers.5.ffn.shared_experts.down_proj.weight_scale_inv\",","+        ),","+    ]:","+        [(mapped, _)] = list(mapper.apply([(raw, tensor)]))","+        assert _redirect_shared_expert_name(mapped, frozenset(), 4) == expected","+"," ","-    class Layer(nn.Module):","-        def __init__(self, enabled: bool) -> None:","-            super().__init__()","-            self.mlp = MoE(enabled)","+class _FakeMoE(nn.Module):","+    def __init__(self, enabled: bool) -> None:","+        super().__init__()","+        self.is_fused_shared_expert_enabled = enabled"," ","-    enabled_layers = nn.ModuleList([Layer(True)])","-    disabled_layers = nn.ModuleList([Layer(False)])","-    mixed_layers = nn.ModuleList([Layer(True), Layer(False)])","-    empty_layers = nn.ModuleList()","-    pipeline_layers = nn.ModuleList([Layer(True), PPMissingLayer()])"," ","-    assert fused_moe_utils.is_model_fused_shared_expert_compatible(","-        enabled_layers, MoE, \"mlp\"","+def _make_fake_moe_model(","+    layer_names: list[str], enabled: list[bool], use_dict: bool","+) -> nn.Module:","+    layers = []","+    for flag in enabled:","+        layer = nn.Module()","+        layer.mlp = _FakeMoE(flag)","+        layers.append(layer)","+    model = nn.Module()","+    model.layers = (","+        nn.ModuleDict(dict(zip(layer_names, layers, strict=True)))","+        if use_dict","+        else nn.ModuleList(layers)","     )","-    assert not fused_moe_utils.is_model_fused_shared_expert_compatible(","-        disabled_layers, MoE, \"mlp\"","+    return model","+","+","+def test_fused_shared_expert_layers_matches_container_index_space() -> None:","+    \"\"\"The fused-layer set follows the module tree, not a hard-coded offset.","+","+    ``nn.ModuleList`` MTP layers (Qwen3 Next/3.5, Qwen4 Exp) are 0-based,","+    while ``nn.ModuleDict`` MTP layers (GLM4, DeepSeek) are keyed by absolute","+    layer index. Both must redirect without a per-loader offset.","+    \"\"\"","+    list_model = _make_fake_moe_model([\"0\", \"1\"], [True, False], use_dict=False)","+    dict_model = _make_fake_moe_model([\"28\", \"29\"], [False, True], use_dict=True)","+    list_layers = get_fused_shared_expert_layers(list_model, _FakeMoE)","+    dict_layers = get_fused_shared_expert_layers(dict_model, _FakeMoE)","+    assert list_layers == frozenset({0})","+    assert dict_layers == frozenset({29})","+","+    weight = torch.arange(8.0).reshape(4, 2)","+","+    def redirected(name: str, fused_shared_expert_layers: frozenset[int]) -> bool:","+        [(out_name, _)] = list(","+            maybe_fuse_shared_experts(","+                [(name, weight)],","+                n_routed_experts=4,","+                n_shared_experts=1,","+                fused_shared_expert_layers=fused_shared_expert_layers,","+                ckpt_prefix=\"mlp.shared_expert\",","+            )","+        )","+        return \".experts.\" in out_name","+","+    # ModuleList: 0-based names, including the Qwen4 Exp MTP case where the","+    # quant-config prefix uses an absolute index but the weight names do not.","+    assert redirected(\"layers.0.mlp.shared_expert.down_proj.weight\", list_layers)","+    assert not redirected(\"layers.1.mlp.shared_expert.down_proj.weight\", list_layers)","+    # ModuleDict: absolute names, including the MTP layer offset.","+    assert redirected(\"layers.29.mlp.shared_expert.down_proj.weight\", dict_layers)","+    assert not redirected(\"layers.28.mlp.shared_expert.down_proj.weight\", dict_layers)","+","+","+@pytest.mark.parametrize(","+    (\"enable_expert_parallel\", \"match\"),","+    [","+        (True, \"expert parallelism is not tested\"),","+        (False, \"nixl_ep\"),","+    ],","+)","+def test_mixed_fused_shared_experts_rejected_with_ep_or_nixl_ep(","+    enable_expert_parallel: bool, match: str","+) -> None:","+    \"\"\"Mixed FSE must be rejected with EP or a shared-workspace all2all backend.","+","+    With EP, per-layer geometry differences are not validated. ``nixl_ep``","+    additionally keeps a single process-wide buffer initialized from the first","+    MoE layer's ``num_experts_per_rank`` and ignores later geometries. A mixed","+    model has fused layers with ``n_routed + n_shared`` experts and non-fused","+    layers with ``n_routed``, so reusing that buffer would silently map experts","+    to the wrong slots. Construction must fail cleanly instead of running the","+    untested mixed path.","+    \"\"\"","+    model = _make_fake_moe_model([\"0\", \"1\"], [True, False], use_dict=False)","+","+    vllm_config = VllmConfig()","+    vllm_config.parallel_config.enable_expert_parallel = enable_expert_parallel","+    vllm_config.parallel_config.data_parallel_size = 2","+    vllm_config.parallel_config.all2all_backend = \"nixl_ep\"","+","+    with (","+        set_current_vllm_config(vllm_config),","+        pytest.raises(NotImplementedError, match=match),","+    ):","+        get_fused_shared_expert_layers(model, _FakeMoE)","+","+","+def _assert_mtp_fused_shared_expert_redirect(","+    mtp: nn.Module, ckpt_prefix: str, moe: nn.Module, n_routed_experts: int","+) -> None:","+    \"\"\"Load a fused MTP shared expert and verify it lands in the appended slot.","+","+    The MTP loaders see different name/index spaces (0-based ``ModuleList`` or","+    absolute ``ModuleDict``); using the live module map must redirect either.","+    \"\"\"","+    packed_down = torch.full((128, 16), 3, dtype=torch.uint8)","+    down_scale = torch.full((128, 1), 127, dtype=torch.uint8)","+    mtp.load_weights(","+        [","+            (f\"{ckpt_prefix}.down_proj.weight\", packed_down),","+            (f\"{ckpt_prefix}.down_proj.weight_scale\", down_scale),","+        ]","     )","-    assert not fused_moe_utils.is_model_fused_shared_expert_compatible(","-        empty_layers, MoE, \"mlp\"","+    torch.testing.assert_close(","+        moe.experts.routed_experts.w2_weight[n_routed_experts][:128, :16].float(),","+        packed_down.float(),","     )","-    assert fused_moe_utils.is_model_fused_shared_expert_compatible(","-        pipeline_layers, MoE, \"mlp\"","+","+","+def _assert_mtp_shared_expert_not_fused(","+    mtp: nn.Module, ckpt_prefix: str, moe: nn.Module, n_routed_experts: int","+) -> None:","+    \"\"\"Load an unfused MTP shared expert and verify no fused slot is appended.","+","+    Without AITER the shared expert stays a separate MLP, so the routed tensor must","+    keep exactly ``n_routed_experts`` rows.","+    \"\"\"","+    packed_down = torch.full((128, 16), 3, dtype=torch.uint8)","+    down_scale = torch.full((128, 1), 127, dtype=torch.uint8)","+    mtp.load_weights(","+        [","+            (f\"{ckpt_prefix}.down_proj.weight\", packed_down),","+            (f\"{ckpt_prefix}.down_proj.weight_scale\", down_scale),","+        ]","     )","-    with pytest.raises(NotImplementedError, match=\"1 enabled and 1 disabled layers\"):","-        fused_moe_utils.is_model_fused_shared_expert_compatible(","-            mixed_layers, MoE, \"mlp\"","+    assert moe.experts.routed_experts.w2_weight.shape[0] == n_routed_experts","+","+","+def _make_deepseek_v4_shared_expert_checkpoint(","+    layer: nn.Module, idx: int, fused: bool, exclude: bool","+) -> tuple[list[tuple[str, torch.Tensor]], list[tuple[torch.Tensor, torch.Tensor]]]:","+    \"\"\"Build DSV4's FP8 shared-expert / MXFP4 routed-slot checkpoint pairs.\"\"\"","+    ffn = layer.ffn","+    if not fused:","+        dtype = torch.bfloat16 if exclude else torch.float8_e4m3fn","+        hidden = ffn.shared_experts.gate_up_proj.weight.shape[1]","+        intermediate = ffn.shared_experts.down_proj.weight.shape[1]","+        gate_up = torch.full((2 * intermediate, hidden), idx + 1, dtype=dtype)","+        down = torch.full((hidden, intermediate), idx + 1, dtype=dtype)","+        return (","+            [","+                (f\"layers.{idx}.ffn.shared_experts.gate_up_proj.weight\", gate_up),","+                (f\"layers.{idx}.ffn.shared_experts.down_proj.weight\", down),","+            ],","+            [","+                (ffn.shared_experts.gate_up_proj.weight, gate_up),","+                (ffn.shared_experts.down_proj.weight, down),","+            ],","+        )","+","+    routed = ffn.experts.routed_experts","+    slot = routed.w13_weight.shape[0] - 1","+    w13_rows, hidden_half = routed.w13_weight[slot].shape","+    intermediate = w13_rows // 2","+    hidden = hidden_half * 2","+    w1 = torch.full((intermediate, hidden_half), idx + 1, dtype=torch.uint8)","+    w3 = torch.full((intermediate, hidden_half), idx + 1, dtype=torch.uint8)","+    w2 = torch.full((hidden, intermediate // 2), idx + 1, dtype=torch.uint8)","+    return (","+        [","+            (f\"layers.{idx}.ffn.shared_experts.w1.weight\", w1),","+            (f\"layers.{idx}.ffn.shared_experts.w3.weight\", w3),","+            (f\"layers.{idx}.ffn.shared_experts.w2.weight\", w2),","+        ],","+        [","+            (routed.w13_weight[slot].chunk(2, dim=0)[0], w1),","+            (routed.w13_weight[slot].chunk(2, dim=0)[1], w3),","+            (routed.w2_weight[slot], w2),","+        ],","+    )","+","+","+def _build_mtp_model(","+    mtp_cls: Any,","+    vllm_config: VllmConfig,","+    config: object,","+    *,","+    with_text_config: bool = False,","+    with_target_model: bool = False,","+) -> nn.Module:","+    draft_model_config: dict[str, object] = {\"hf_config\": config}","+    if with_text_config:","+        draft_model_config[\"hf_text_config\"] = config","+    speculative_config: dict[str, object] = {","+        \"draft_model_config\": SimpleNamespace(**draft_model_config),","+        \"method\": \"mtp\",","+        \"parallel_drafting\": False,","+        \"enable_adaptive_verification\": False,","+        \"use_dspark\": lambda: False,","+    }","+    if with_target_model:","+        speculative_config[\"target_model_config\"] = vllm_config.model_config","+    vllm_config.speculative_config = SimpleNamespace(**speculative_config)","+    return mtp_cls(vllm_config=vllm_config)","+","+","+_MTP_FACTORIES: dict[str, tuple[str, str, dict[str, bool]]] = {","+    \"deepseek_v4\": (\"vllm.models.deepseek_v4.amd.mtp\", \"DeepSeekV4MTP\", {}),","+    \"glm4_moe\": (","+        \"vllm.model_executor.models.glm4_moe_mtp\",","+        \"Glm4MoeMTP\",","+        {},"],"additions":882,"deletions":98,"truncated":true},{"path":"tests/model_executor/model_loader/test_reload.py","lines":["@@ -720,6 +720,7 