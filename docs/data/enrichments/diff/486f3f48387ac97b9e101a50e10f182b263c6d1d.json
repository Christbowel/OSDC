{"id":"486f3f48387ac97b9e101a50e10f182b263c6d1d","axis":"silent","repo":"elastic/elasticsearch","sha":"486f3f48387ac97b9e101a50e10f182b263c6d1d","parsed":{"files":[{"path":"docs/changelog/161500.yaml","lines":["@@ -0,0 +1,5 @@","+area: Authorization","+issues: []","+pr: 161500","+summary: Grant Nightshift source view read privileges implicitly per space","+type: enhancement"],"additions":5,"deletions":0,"truncated":false},{"path":"x-pack/plugin/core/src/main/java/org/elasticsearch/xpack/core/security/authz/store/KibanaOwnedReservedRoleDescriptors.java","lines":["@@ -299,6 +299,12 @@ static RoleDescriptor kibanaSystem(String name) {","                     .indices(ReservedRolesStore.ALERTING_V2_ALERT_VIEWS, ReservedRolesStore.ALERTING_V2_RULE_VIEWS)","                     .privileges(\"create_view\")","                     .build(),","+                // Nightshift source views. Kibana creates, updates and deletes them as the Kibana system user, so end users","+                // need no write privileges on them and cannot let a view drift from its saved object. Reads run as the user.","+                RoleDescriptor.IndicesPrivileges.builder()","+                    .indices(ReservedRolesStore.NIGHTSHIFT_SOURCE_VIEWS)","+                    .privileges(\"create_view\", \"delete_view\")","+                    .build(),","                 // \"Alerts as data\" public index aliases used in Security Solution,","                 // Observability, etc.","                 // Kibana system user uses them to read / write alerts."],"additions":6,"deletions":0,"truncated":false},{"path":"x-pack/plugin/core/src/main/java/org/elasticsearch/xpack/core/security/authz/store/ReservedRolesStore.java","lines":["@@ -58,6 +58,9 @@ public class ReservedRolesStore implements BiConsumer<Set<String>, ActionListene","     public static final String ALERTING_V2_ALERT_VIEWS = \"$.alert*\";","     public static final String ALERTING_V2_RULE_VIEWS = \"$.rule*\";"," ","+    /** Nightshift source