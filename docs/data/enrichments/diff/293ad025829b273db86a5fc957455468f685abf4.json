{"id":"293ad025829b273db86a5fc957455468f685abf4","axis":"silent","repo":"elsa-workflows/elsa-core","sha":"293ad025829b273db86a5fc957455468f685abf4","parsed":{"files":[{"path":"studio/docs/specs/bpmn-designer-contract/contract.md","lines":["@@ -181,9 +181,14 @@ BPMN-imported workflow's whole document in it. Without one, the workflow keeps t","   document replaces it when the designer has nothing unsaved; otherwise the next save is refused as a conflict."," - Diagram changes are saved with Save only; auto-save covers the workflow's other properties, as it does for the","   \"Performed by\" panel. Publishing is refused while the diagram has unsaved changes.","-- The editor shows the selected element. Choosing the activity that performs a task through `getBinding` and","-  `setBinding` is not wired yet, and neither are the viewport tools (Zoom to fit, Center), which this contract does not","-  have.","+- The panel shows the selected element and, for a task, its \"Performed by\" section: the activity picker and that","+  activity's input editors. It reads the binding with `getBinding` and writes every pick and input edit with","+  `setBinding`, so each is one undoable edit saved with the diagram. It reads the binding again after every `change`,","+  and keeps the draft being edited when the binding read back is the one it wrote. A refusal is shown, and the binding","+  the document kept is read back in place of the refused draft. While the document is read again, and until the designer","+  has loaded what the read returned, the editors are hidden and `setBinding` is not called, since loading the document","+  discards the designer's edits.","+- The viewport tools (Zoom to fit, Center) do nothing on this canvas; this contract does not have them."," "," ## Versioning"," "],"additions":8,"deletions":3,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows.Tests/BpmnDesignerBindingsTests.cs","lines":["@@ -0,0 +1,75 @@","+using System.Text.Json.Nodes;","+using Elsa.Studio.Bpmn.Designers;","+using Elsa.Studio.Workflows.DiagramDesigners.Bpmn;","+using Elsa.Studio.Workflows.Domain.Models.Bpmn;","+using Xunit;","+using static Elsa.Studio.Workflows.Tests.Support.BpmnDocumentFixtures;","+","+namespace Elsa.Studio.Workflows.Tests;","+","+/// <summary>","+/// Covers <see cref=\"BpmnDesignerBindings\"/>: a binding read from a designer and written back from a draft keeps every","+/// input value exactly, and is refused by the same rules elsa-core's reader applies.","+/// </summary>","+public class BpmnDesignerBindingsTests","+{","+    private static readonly BpmnDesignerBinding Binding = new(\"Elsa.WriteLine\", [new(\"text\", \"\"\"{\"typeName\":\"String\",\"expression\":{\"type\":\"Literal\",\"value\":\"a < b\"}}\"\"\")]);","+","+    [Fact(DisplayName = \"A binding read into a draft and written back is the same binding, with readable JSON\")]","+    public void RoundTripsThroughADraft()","+    {","+        var draft = BpmnActivityBindingDraft.FromBinding(BpmnDesignerBindings.Read(Binding), WriteLine(), TaskId);","+","+        var written = BpmnDesignerBindings.From(draft);","+","+        Assert.True(BpmnDesignerBindings.AreEquivalent(Binding, written));","+        Assert.Contains(\"a < b\", Assert.Single(written.Inputs).Value);","+    }","+","+    [Fact(DisplayName = \"An input named twice is refused\")]","+    public void RefusesARepeatedInput() =>","+        Assert.Throws<BpmnActivityBindingFormatException>(() => BpmnDesignerBindings.Read(new(\"Elsa.WriteLine\", [new(\"text\", \"1\"), new(\"text\", \"2\")])));","+","+    [Fact(DisplayName = \"An input that is not JSON is refused\")]","+    public void RefusesAnInputThatIsNotJson() =>","+        Assert.Throws<BpmnActivityBindingFormatException>(() => BpmnDesignerBindings.Read(new(\"Elsa.WriteLine\", [new(\"text\", \"{not json\")])));","+","+    [Fact(DisplayName = \"Bindings are the same whatever their input order or JSON spacing, and differ on any value or type\")]","+    public void ComparesByMeaning()","+    {","+        BpmnDesignerBinding Make(string type, params (string Name, string Value)[] inputs) => new(type, inputs.Select(input => new BpmnDesignerBindingInput(input.Name, input.Value)).ToList());","+","+        Assert.True(BpmnDesignerBindings.AreEquivalent(Make(\"A\", (\"x\", \"{\\\"a\\\":1}\"), (\"y\", \"2\")), Make(\"A\", (\"y\", \"2\"), (\"x\", \"{ \\\"a\\\": 1 }\"))));","+        Assert.False(BpmnDesignerBindings.AreEquivalent(Make(\"A\", (\"x\", \"1\")), Make(\"A\", (\"x\", \"2\"))));","+        Assert.False(BpmnDesignerBindings.AreEquivalent(Make(\"A\", (\"x\", \"1\")), Make(\"B\", (\"x\", \"1\"))));","+        Assert.False(BpmnDesignerBindings.AreEquivalent(Make(\"A\", (\"x\", \"1\")), null));","+        Assert.True(BpmnDesignerBindings.AreEquivalent(null, null));","+    }","+","+    [Fact(DisplayName = \"An input whose value is JSON null counts as absent, as a written binding leaves it out\")]","+    public void TreatsANullInputAsAbsent()","+    {","+        var withNull = new BpmnDesignerBinding(\"Elsa.WriteLine\", [new(\"text\", \"\\\"hi\\\"\"), new(\"delay\", \"null\")]);","+        var draft = BpmnActivityBindingDraft.FromBinding(BpmnDesignerBindings.Read(withNull), WriteLine(), TaskId);","+","+        Assert.True(BpmnDesignerBindings.AreEquivalent(withNull, BpmnDesignerBindings.From(draft)));","+        Assert.False(BpmnDesignerBindings.AreEquivalent(withNull, new(\"Elsa.WriteLine\", [new(\"text\", \"\\\"bye\\\"\")])));","+    }","+","+    [Fact(DisplayName = \"A binding that names an input twice matches nothing, even when one of the two is null\")]","+    public void ARepeatedName_MatchesNothing()","+    {","+        var repeated = new BpmnDesignerBinding(\"Elsa.WriteLine\", [new(\"text\", \"\\\"hi\\\"\"), new(\"text\", \"null\")]);","+","+        Assert.False(BpmnDesignerBindings.AreEquivalent(repeated, new(\"Elsa.WriteLine\", [new(\"text\", \"\\\"hi\\\"\")])));","+    }","+","+    [Fact(DisplayName = \"Each value is read as the JSON node it holds\")]","+    public void ReadsValuesAsJson()","+    {","+        var read = BpmnDesignerBindings.Read(Binding);","+","+        Assert.Equal(\"a < b\", Assert.Single(read.Inputs).Value![\"expression\"]![\"value\"]!.GetValue<string>());","+        Assert.IsType<JsonObject>(read.Inputs[0].Value);","+    }","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows.Tests/BpmnModelerBindingSectionTests.cs","lines":["@@ -0,0 +1,226 @@","+using System.Text.Json.Nodes;","+using Bunit;","+using Elsa.Studio.Bpmn.Designers;","+using Elsa.Studio.Workflows.Components.WorkflowDefinitionEditor.Components.ActivityProperties.Tabs;","+using Elsa.Studio.Workflows.DiagramDesigners.Bpmn;","+using Elsa.Studio.Workflows.Domain.Models.Bpmn;","+using Elsa.Studio.Workflows.Tests.Support;","+using Microsoft.AspNetCore.Components.Rendering;","+using MudBlazor;","+using Xunit;","+using static Elsa.Studio.Workflows.Tests.Support.BpmnDocumentFixtures;","+","+namespace Elsa.Studio.Workflows.Tests;","+","+/// <summary>","+/// Covers the \"Performed by\" section of the BPMN designer's panel: it reads a task's binding through the designer's","+/// <c>getBinding</c>, writes picks and input edits through <c>setBinding</c> and nothing else, keeps the draft being","+/// edited when the binding read back is its own, and follows the document when an undo or a reload changes it.","+/// </summary>","+public sealed class BpmnModelerBindingSectionTests : BunitContext, IAsyncLifetime","+{","+    private static readonly BpmnDesignerSelectedElement Task = new(TaskId, \"bpmn:ServiceTask\", \"Notify Warehouse\");","+","+    private static readonly BpmnDesignerBinding WriteLineBinding =","+        new(\"Elsa.WriteLine\", [new(\"text\", \"\"\"{\"typeName\":\"String\",\"expression\":{\"type\":\"Literal\",\"value\":\"Notifying the warehouse\"}}\"\"\")]);","+","+    private readonly FakeModelerCanvas _canvas = new();","+    private readonly FakeBpmnXmlService _service = new();","+    private readonly IRenderedComponent<MudDialogProvider> _dialogProvider;","+    private readonly BpmnModelerSession _session;","+","+    public BpmnModelerBindingSectionTests()","+    {","+        JSInterop.Mode = JSRuntimeMode.Loose;","+        Services.AddBpmnEditing(new FakeBpmnDocumentService());","+        ComponentFactories.Add<InputsTab, InputsTabStandIn>();","+        Render<MudPopoverProvider>();","+        _dialogProvider = Render<MudDialogProvider>();","+","+        _session = new(_service.ReturnsXml(\"<definitions/>\", \"\\\"REVISION-1\\\"\"), DefinitionId);","+        _session.EnsureLoadedAsync().GetAwaiter().GetResult();","+        _session.AttachCanvas(_canvas);","+        _session.CanvasLoaded(new(true, null, []), _session.DocumentVersion);","+        _canvas.BindingApplied = elementId => _session.CanvasChanged(new([elementId], IsDirty: true, CanUndo: true, CanRedo: false));","+        _canvas.Bindings[TaskId] = WriteLineBinding;","+    }","+","+    Task IAsyncLifetime.InitializeAsync() => System.Threading.Tasks.Task.CompletedTask;","+    async Task IAsyncLifetime.DisposeAsync() => await base.DisposeAsync();","+","+    [Fact(DisplayName = \"A bound task shows its activity and that activity's own input editors, read through getBinding\")]","+    public void ShowsTheBoundActivity()","+    {","+        var cut = RenderSection(Task);","+","+        Assert.Contains(\"Write Line (Elsa.WriteLine)\", cut.Find(\"[data-testid='bpmn-bound-activity']\").TextContent);","+        var inputs = cut.FindComponent<InputsTab>().Instance;","+        Assert.Equal(\"Elsa.WriteLine\", inputs.ActivityDescriptor!.TypeName);","+        Assert.Equal(\"Notifying the warehouse\", inputs.Activity![\"text\"]![\"expression\"]![\"value\"]!.GetValue<string>());","+    }","+","+    [Fact(DisplayName = \"Editing an input writes the binding through setBinding and keeps the editors open\")]","+    public async Task EditingAnInput_SetsTheBinding()","+    {","+        var cut = RenderSection(Task);","+        var inputs = cut.FindComponent<InputsTab>().Instance;","+","+        inputs.Activity![\"text\"] = JsonNode.Parse(\"\"\"{\"typeName\":\"String\",\"expression\":{\"type\":\"JavaScript\",\"value\":\"getMessage()\"}}\"\"\");","+        await cut.InvokeAsync(() => inputs.OnActivityUpdated!(inputs.Activity!));","+","+        var (elementId, binding) = Assert.Single(_canvas.SetBindings);","+        Assert.Equal(TaskId, elementId);","+        Assert.Equal(\"Elsa.WriteLine\", binding.ActivityType);","+        Assert.Contains(\"getMessage()\", Assert.Single(binding.Inputs).Value);","+        Assert.True(_session.IsDirty);","+        Assert.Same(inputs, cut.FindComponent<InputsTab>().Instance);","+    }","+","+    [Fact(DisplayName = \"Picking an activity binds it through setBinding and shows its inputs\")]","+    public async Task PickingAnActivity_SetsTheBinding()","+    {","+        var cut = RenderSection(Task);","+","+        await cut.InvokeAsync(() => cut.Find(\"[data-testid='bpmn-pick-activity']\").Click());","+        _dialogProvider.WaitForAssertion(() => Assert.NotEmpty(_dialogProvider.FindAll(\"[data-testid='state-machine-activity-option']\")));","+        _dialogProvider.FindAll(\"button\").Single(button => button.TextContent.Contains(\"All activities\", StringComparison.Ordinal)).Click();","+        _dialogProvider.Find(\"[data-testid='state-machine-activity-option'][data-activity-type='Elsa.HttpRequest']\").Click();","+        _dialogProvider.Find(\"[data-testid='state-machine-activity-picker-commit']\").Click();","+","+        cut.WaitForAssertion(() => Assert.Equal(\"Elsa.HttpRequest\", Assert.Single(_canvas.SetBindings).Binding.ActivityType));","+        cut.WaitForAssertion(() => Assert.Equal(\"Elsa.HttpRequest\", cut.FindComponent<InputsTab>().Instance.ActivityDescriptor!.TypeName));","+    }","+","+    [Fact(DisplayName = \"An undo that changes the binding replaces the draft with the binding read back\")]","+    public async Task AChangeFromTheDesigner_ReplacesTheDraft()","+    {","+        var cut = RenderSection(Task);","+        _canvas.Bindings[TaskId] = new(\"Elsa.Delay\", []);","+","+        await cut.InvokeAsync(() => _session.CanvasChanged(new([TaskId], IsDirty: false, CanUndo: false, CanRedo: true)));","+","+        cut.WaitForAssertion(() => Assert.Equal(\"Elsa.Delay\", cut.FindComponent<InputsTab>().Instance.ActivityDescriptor!.TypeName));","+    }","+","+    [Fact(DisplayName = \"A task the designer refuses to bind says why, and the document keeps its binding\")]","+    public async Task ARefusal_IsShown()","+    {","+        var cut = RenderSection(Task);","+        _canvas.SetBindingRefusal = BpmnDesignerSetBindingRefusals.NotBindable;","+        var inputs = cut.FindComponent<InputsTab>().Instance;","+","+        await cut.InvokeAsync(() => inputs.OnActivityUpdated!(inputs.Activity!));","+","+        Assert.Contains(\"sends or waits for a message\", cut.Find(\"[data-testid='bpmn-binding-refused']\").TextContent);","+        Assert.Same(WriteLineBinding, _canvas.Bindings[TaskId]);","+        Assert.False(_session.IsDirty);","+    }","+","+    [Fact(DisplayName = \"A pick the designer refuses is not shown; the activity the document keeps is\")]","+    public async Task ARefusedPick_ShowsTheKeptBinding()","+    {","+        var cut = RenderSection(Task);","+        _canvas.SetBindingRefusal = BpmnDesignerSetBindingRefusals.NotBindable;","+","+        await cut.InvokeAsync(() => cut.Find(\"[data-testid='bpmn-pick-activity']\").Click());","+        _dialogProvider.WaitForAssertion(() => Assert.NotEmpty(_dialogProvider.FindAll(\"[data-testid='state-machine-activity-option']\")));","+        _dialogProvider.FindAll(\"button\").Single(button => button.TextContent.Contains(\"All activities\", StringComparison.Ordinal)).Click();","+        _dialogProvider.Find(\"[data-testid='state-machine-activity-option'][data-activity-type='Elsa.HttpRequest']\").Click();","+        _dialogProvider.Find(\"[data-testid='state-machine-activity-picker-commit']\").Click();","+","+        cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll(\"[data-testid='bpmn-binding-refused']\")));","+        Assert.Contains(\"Write Line (Elsa.WriteLine)\", cut.Find(\"[data-testid='bpmn-bound-activity']\").TextContent);","+        Assert.Equal(\"Elsa.WriteLine\", cut.FindComponent<InputsTab>().Instance.ActivityDescriptor!.TypeName);","+    }","+","+    [Fact(DisplayName = \"A read that started before an input edit does not replace the editors while the edit is being applied\")]","+    public async Task AReadFromBeforeAnEdit_DoesNotReplaceTheEditors()","+    {","+        var cut = RenderSection(Task);","+        var inputs = cut.FindComponent<InputsTab>().Instance;","+        var staleRead = _canvas.NextGetBindingGate = new();","+        await cut.InvokeAsync(() => _session.CanvasChanged(new([\"Shape_1\"], IsDirty: true, CanUndo: true, CanRedo: false)));","+","+        var write = _canvas.NextSetBindingGate = new();","+        inputs.Activity![\"text\"] = JsonNode.Parse(\"\"\"{\"typeName\":\"String\",\"expression\":{\"type\":\"Literal\",\"value\":\"Edited\"}}\"\"\");","+        var edit = cut.InvokeAsync(() => inputs.OnActivityUpdated!(inputs.Activity!));","+        await cut.InvokeAsync(staleRead.SetResult);","+        Assert.Same(inputs, cut.FindComponent<InputsTab>().Instance);","+","+        await cut.InvokeAsync(write.SetResult);","+        await edit;","+","+        Assert.Same(inputs, cut.FindComponent<InputsTab>().Instance);","+        Assert.Contains(\"Edited\", Assert.Single(_canvas.Bindings[TaskId].Inputs).Value);","+    }","+","+    [Fact(DisplayName = \"While the diagram is read again, the editors are hidden and the picker is off; then the binding of the document shown is read\")]","+    public async Task WhileTheDiagramIsReadAgain_NothingCanBeEdited()","+    {","+        var cut = RenderSection(Task);","+        _service.ReturnsXml(\"<definitions/>\", \"\\\"REVISION-2\\\"\");","+        _service.GetGate = new();","+","+        var reload = System.Threading.Tasks.Task.CompletedTask;","+        await cut.InvokeAsync(() => { reload = _session.ReloadAsync(); });","+        cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll(\"[data-testid='bpmn-binding-loading']\")));","+        Assert.Empty(cut.FindComponents<InputsTab>());","+        Assert.True(cut.Find(\"[data-testid='bpmn-pick-activity']\").HasAttribute(\"disabled\"));","+","+        await cut.InvokeAsync(_service.GetGate.SetResult);","+        await reload;","+        _canvas.Bindings[TaskId] = new(\"Elsa.Delay\", []);","+        await cut.InvokeAsync(() => _session.CanvasLoaded(new(true, null, []), _session.DocumentVersion));","+","+        cut.WaitForAssertion(() => Assert.Equal(\"Elsa.Delay\", cut.FindComponent<InputsTab>().Instance.ActivityDescriptor!.TypeName));","+        Assert.False(cut.Find(\"[data-testid='bpmn-pick-activity']\").HasAttribute(\"disabled\"));","+    }","+","+    [Fact(DisplayName = \"An unbound task offers the picker\")]","+    public void AnUnboundTask_OffersThePicker()","+    {","+        _canvas.Bindings.Clear();","+","+        var cut = RenderSection(Task);","+","+        Assert.Equal(\"Not bound\", cut.Find(\"[data-testid='bpmn-bound-activity']\").TextContent.Trim());","+        Assert.Equal(\"Choose activity\", cut.Find(\"[data-testid='bpmn-pick-activity']\").TextContent.Trim());","+        Assert.Empty(cut.FindComponents<InputsTab>());","+    }","+","+    [Fact(DisplayName = \"An element that is not a task performs no work, and nothing is read for it\")]","+    public void AGateway_PerformsNoWork()","+    {","+        var cut = RenderSection(new(\"Gateway_1\", \"bpmn:ExclusiveGateway\", \"Approved?\"));","+","+        Assert.NotEmpty(cut.FindAll(\"[data-testid='bpmn-no-work']\"));","+        Assert.Empty(cut.FindAll(\"[data-testid='bpmn-pick-activity']\"));","+        Assert.Empty(_canvas.SetBindings);","+    }","+","+    [Fact(DisplayName = \"A binding whose input is not JSON is reported, not shown as editable\")]","+    public void AnUnreadableBinding_IsReported()","+    {","+        _canvas.Bindings[TaskId] = new(\"Elsa.WriteLine\", [new(\"text\", \"{not json\")]);","+","+        var cut = RenderSection(Task);","+","+        Assert.Contains(\"is not JSON\", cut.Find(\"[data-testid='bpmn-binding-unreadable']\").TextContent);","+        Assert.Empty(cut.FindComponents<InputsTab>());","+    }","+","+    private IRenderedComponent<BpmnModelerBindingSection> RenderSection(BpmnDesignerSelectedElement element) =>","+        Render<BpmnModelerBindingSection>(parameters => parameters","+            .Add(x => x.Session, _session)","+            .Add(x => x.Element, element));","+","+    /// <summary>Stands in for the real input editors, which need a browser, keeping the parameters the section hands it.</summary>","+    private sealed class InputsTabStandIn : InputsTab","+    {","+        protected override Task OnParametersSetAsync() => System.Threading.Tasks.Task.CompletedTask;","+","+        protected override void BuildRenderTree(RenderTreeBuilder builder)","+        {","+        }","+    }","+}"],"additions":226,"deletions":0,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows.Tests/BpmnModelerSessionTests.cs","lines":["@@ -344,6 +344,28 @@ public async Task UndoRedo_GoToTheDesigner()","         Assert.Equal((1, 1), (_canvas.Undos, _canvas.Redos));","     }"," ","+    [Fact(DisplayName = \"A binding is set only in the document the designer shows as current: not while it is read again, nor before the canvas loads it\")]","+    public async Task SetBinding_WaitsForTheCurrentDocument()","+    {","+        await OpenAsync();","+        _service.ReturnsXml(\"<newer/>\", \"\\\"REVISION-2\\\"\");","+        _service.GetGate = new();","+        var binding = new BpmnDesignerBinding(\"Elsa.WriteLine\", []);","+","+        var reload = _session.ReloadAsync();","+        var whileReading = await _session.SetBindingAsync(\"Task_1\", binding);","+        _service.GetGate.SetResult();","+        await reload;","+        var beforeTheCanvasLoads = await _session.SetBindingAsync(\"Task_1\", binding);","+        _session.CanvasLoaded(new(true, null, []), _session.DocumentVersion);","+        var afterTheCanvasLoads = await _session.SetBindingAsync(\"Task_1\", binding);","+","+        Assert.Equal(new BpmnDesignerSetBindingResult(false, BpmnModelerSession.DocumentNotReadyRefusal), whileReading);","+        Assert.Equal(new BpmnDesignerSetBindingResult(false, BpmnModelerSession.DocumentNotReadyRefusal), beforeTheCanvasLoads);","+        Assert.True(afterTheCanvasLoads.Applied);","+        Assert.Single(_canvas.SetBindings);","+    }","+","     private async Task OpenAsync(IReadOnlyList<BpmnDesignerLoadWarning>? warnings = null)","     {","         await _session.EnsureLoadedAsync();"],"additions":22,"deletions":0,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows.Tests/Support/FakeBpmnXmlService.cs","lines":["@@ -1,3 +1,4 @@","+using Elsa.Studio.Bpmn.Designers;"," using Elsa.Studio.Models;"," using Elsa.Studio.Workflows.DiagramDesigners.Bpmn;"," using Elsa.Studio.Workflows.Domain.Contracts;","@@ -66,9 +67,24 @@ private static T Next<T>(List<T> results, int index) =>","         results.Count == 0 ? throw new InvalidOperationException(\"No result was queued for this call.\") : results[Math.Min(index, results.Count - 1)];"," }"," ","-/// <summary>A canvas whose designer exports <see cref=\"Xml\"/>, or throws <see cref=\"SaveException\"/>, and counts undo and redo.</summary>","+/// <summary>","+/// A canvas whose designer exports <see cref=\"Xml\"/>, or throws <see cref=\"SaveException\"/>, counts undo and redo, and","+/// keeps each element's binding in <see cref=\"Bindings\"/>.","+/// </summary>"," internal sealed class FakeModelerCanvas : IBpmnModelerCanvas"," {","+    /// <summary>Each element's binding, as the designer's document holds it.</summary>","+    public Dictionary<string, BpmnDesignerBinding> Bindings { get; } = new(StringComparer.Ordinal);","+","+    /// <summary>Every binding the designer was asked to set, in order.</summary>","+    public List<(string ElementId, BpmnDesignerBinding Binding)> SetBindings { get; } = [];","+","+    /// <summary>When set, <c>setBinding</c> refuses with this reason instead of applying the binding.</summary>","+    public string? SetBindingRefusal { get; set; }","+","+    /// <summary>Raised after a binding is applied, as the designer raises <c>change</c>.</summary>","+    public Action<string>? BindingApplied { get; set; }","+","     public string Xml { get; set; } = \"<edited/>\";","     public Exception? SaveException { get; set; }"," ","@@ -97,4 +113,45 @@ public Task RedoAsync()","         Redos++;","         return Task.CompletedTask;","     }","+","+    /// <summary>When set, the next <c>getBinding</c> reads the binding at once but returns it only once this completes.</summary>","+    public TaskCompletionSource? NextGetBindingGate { get; set; }","+","+    /// <summary>When set, the next <c>setBinding</c> applies the binding only once this completes.</summary>","+    public TaskCompletionSource? NextSetBindingGate { get; set; }","+","+    public async Task<BpmnDesignerBinding?> GetBindingAsync(string elementId)","+    {","+        var gate = NextGetBindingGate;","+        NextGetBindingGate = null;","+        var binding = Bindings.TryGetValue(elementId, out var found) ? found : null;","+","+        if (gate != null)","+        {","+            await gate.Task;","+        }","+","+        return binding;","+    }","+","+    public async Task<BpmnDesignerSetBindingResult> SetBindingAsync(string elementId, BpmnDesignerBinding binding)","+    {","+        var gate = NextSetBindingGate;","+        NextSetBindingGate = null;","+        SetBindings.Add((elementId, binding));","+","+        if (gate != null)","+        {","+            await gate.Task;","+        }","+","+        if (SetBindingRefusal != null)","+        {","+            return new(false, SetBindingRefusal);","+        }","+","+        Bindings[elementId] = binding;","+        BindingApplied?.Invoke(elementId);","+        return new(true);","+    }"," }"],"additions":58,"deletions":1,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows/Components/WorkflowDefinitionEditor/Components/WorkflowEditor.razor","lines":["@@ -83,7 +83,7 @@","         @if (_bpmnModelerSession is { } bpmnModelerSession)","         {","             @* The enabled BPMN designer edits the whole document; the panel reports on it and on the selected element. *@","-            <BpmnModelerPanel Session=\"@bpmnModelerSession\" SaveRequested=\"@SaveBpmnModelerDefinitionAsync\" ReloadRequested=\"@ReloadBpmnDocumentBackedDefinitionAsync\"","+            <BpmnModelerPanel Session=\"@bpmnModelerSession\" WorkflowDefinition=\"@_workflowDefinition\" SaveRequested=\"@SaveBpmnModelerDefinitionAsync\" ReloadRequested=\"@ReloadBpmnDocumentBackedDefinitionAsync\"","                               VisiblePaneHeight=\"@_activityPropertiesPaneHeight\" />","         }","         else if (_bpmnDocumentSession is { } bpmnDocumentSession)"],"additions":1,"deletions":1,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows/DiagramDesigners/Bpmn/BpmnDesignerBindings.cs","lines":["@@ -0,0 +1,119 @@","+using System.Text.Encodings.Web;","+using System.Text.Json;","+using System.Text.Json.Nodes;","+using Elsa.Studio.Bpmn.Designers;","+using Elsa.Studio.Workflows.Domain.Models.Bpmn;","+","+namespace Elsa.Studio.Workflows.DiagramDesigners.Bpmn;","+","+/// <summary>","+/// Converts between the binding a BPMN designer's <c>getBinding</c> and <c>setBinding</c> exchange, whose input values","+/// are JSON text, and the <see cref=\"BpmnActivityBinding\"/> the \"Performed by\" drafts are built from.","+/// </summary>","+internal static class BpmnDesignerBindings","+{","+    /// <summary>Writes an input's JSON the way <see cref=\"BpmnActivityBindingFormat.Create\"/> does, so the text reads the same in the document.</summary>","+    private static readonly JsonSerializerOptions InputTextOptions = new() { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };","+","+    /// <summary>","+    /// Reads <paramref name=\"binding\"/> with the rules <see cref=\"BpmnActivityBindingFormat.Read\"/> applies: every input","+    /// named once, and every value JSON.","+    /// </summary>","+    /// <exception cref=\"BpmnActivityBindingFormatException\">The binding breaks one of those rules.</exception>","+    public static BpmnActivityBinding Read(BpmnDesignerBinding binding)","+    {","+        var names = new HashSet<string>(StringComparer.Ordinal);","+        var inputs = new List<BpmnActivityBindingInput>();","+","+        foreach (var input in binding.Inputs)","+        {","+            if (!names.Add(input.Name))","+            {","+                throw new BpmnActivityBindingFormatException($\"The '{binding.ActivityType}' binding declares the input '{input.Name}' more than once.\");","+            }","+","+            inputs.Add(new(input.Name, Parse(input, binding.ActivityType)));","+        }","+","+        return new(binding.ActivityType, inputs);","+    }","+","+    /// <summary>The binding <paramref name=\"draft\"/> describes, as a designer's <c>setBinding</c> takes it.</summary>","+    public static BpmnDesignerBinding From(BpmnActivityBindingDraft draft)","+    {","+        var binding = BpmnActivityBindingFormat.Read(draft.ToBinding());","+        return new(binding.ActivityType, binding.Inputs.Select(input => new BpmnDesignerBindingInput(input.Name, input.Value!.ToJsonString(InputTextOptions))).ToList());","+    }","+","+    /// <summary>","+    /// Whether two bindings name the same activity with the same input values, whatever their order or spacing. An input","+    /// whose value is JSON <c>null</c> counts as absent, since <see cref=\"BpmnActivityBindingFormat.Create\"/> writes none.","+    /// A binding that names an input twice matches nothing, so the section reads it and reports it as <see cref=\"Read\"/> does.","+    /// </summary>","+    public static bool AreEquivalent(BpmnDesignerBinding? left, BpmnDesignerBinding? right)","+    {","+        if (left is null || right is null)","+        {","+            return left is null && right is null;","+        }","+","+        if (HasRepeatedName(left) || HasRepeatedName(right))","+        {","+            return false;","+        }","+","+        var leftInputs = ValuedInputs(left);","+        var rightInputs = ValuedInputs(right);","+","+        if (left.ActivityType != right.ActivityType || leftInputs.Count != rightInputs.Count)","+        {","+            return false;","+        }","+","+        var rightByName = rightInputs.ToDictionary(input => input.Name, StringComparer.Ordinal);","+","+        return leftInputs.All(input => rightByName.TryGetValue(input.Name, out var other) && IsSameJson(input.Value, other.Value));","+    }","+","+    private static bool HasRepeatedName(BpmnDesignerBinding binding) =>","+        binding.Inputs.Select(input => input.Name).Distinct(StringComparer.Ordinal).Count() != binding.Inputs.Count;","+","+    private static List<BpmnDesignerBindingInput> ValuedInputs(BpmnDesignerBinding binding) =>","+        binding.Inputs.Where(input => !IsJsonNull(input.Value)).ToList();","+","+    private static bool IsJsonNull(string value)","+    {","+        try","+        {","+            return JsonNode.Parse(value) is null;","+        }","+        catch (JsonException)","+        {","+            return false;","+        }","+    }","+","+    private static JsonNode? Parse(BpmnDesignerBindingInput input, string activityType)","+    {","+        try","+        {","+            return JsonNode.Parse(input.Value);","+        }","+        catch (JsonException exception)","+        {","+            throw new BpmnActivityBindingFormatException($\"The input '{input.Name}' of the '{activityType}' binding is not JSON: {exception.Message}\");","+        }","+    }","+","+    private static bool IsSameJson(string left, string right)","+    {","+        try","+        {","+            return JsonNode.DeepEquals(JsonNode.Parse(left), JsonNode.Parse(right));","+        }","+        catch (JsonException)","+        {","+            return left == right;","+        }","+    }","+}"],"additions":119,"deletions":0,"truncated":false},{"path":"studio/src/modules/Elsa.Studio.Workflows/DiagramDesigners/Bpmn/BpmnModelerBindingSection.razor","lines":["@@ -0,0 +1,53 @@","+@using Elsa.Studio.Workflows.Components.WorkflowDefinitionEditor.Components.ActivityProperties.Tabs","+@using Variant = MudBlazor.Variant","+@inherits StudioComponentBase","+@inject ILocalizer Localizer","+","+<CascadingValue Value=\"_expressionDescriptorProvider\">","+    <MudStack Spacing=\"2\" data-testid=\"bpmn-modeler-binding\">","+        @if (!IsTask)","+        {","+            <MudText Typo=\"Typo.body2\" data-testid=\"bpmn-no-work\">@Localizer[\"'{0}' performs no work, so no activity is bound to it.\", ElementLabel]</MudText>","+        }","+        else","+        {","+            <MudText Typo=\"Typo.h6\">@Localizer[\"Performed by\"]</MudText>","+","+            @if (_bindingError != null)","+            {","+                <MudAlert Severity=\"Severity.Error\" data-testid=\"bpmn-binding-unreadable\">@Localizer[\"The binding the document declares for this task cannot be read: {0}\", _bindingError]</MudAlert>"],"additions":18,"deletions":0,"truncated":false}],"additions":527,"deletions":5,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-23T14:16:42.665346+00:00"}