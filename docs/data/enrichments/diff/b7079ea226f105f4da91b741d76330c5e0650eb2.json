{"id":"b7079ea226f105f4da91b741d76330c5e0650eb2","axis":"silent","repo":"matomo-org/matomo","sha":"b7079ea226f105f4da91b741d76330c5e0650eb2","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -22,6 +22,7 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," * `[General] enable_processing_estimated_unique_visitors_week`, `_month`, `_year` and `_range` (default `0`) estimate a website's unique visitors and users for that period instead of counting them from the visit logs. To estimate periods archived before, invalidate their days."," * `[General] unique_visitors_estimate_precision` (default `14`, from `4` to `18`) sets how accurate the estimate is."," * `[General] archive_failure_retry_delays` and `[General] archive_failure_max_attempts` set how long `core:archive` waits before retrying a failed archive and after how many failed attempts it stops retrying. Jobs still running after `[General] archive_failure_recovery_timeout` now count as a failed attempt instead of being queued again right away.","+* `[mail] oauth_token_url`, `[mail] oauth_client_id`, `[mail] oauth_scope`, `[mail] oauth_credential_type`, `[mail] oauth_client_secret`, `[mail] oauth_certificate_path`, `[mail] oauth_private_key_path` and `[mail] oauth_private_key_password` configure OAuth 2.0 authentication for SMTP. They are used when `[mail] type` is set to the new value `Xoauth2`: Matomo then requests an access token with the client credentials flow and authenticates against the SMTP server with XOAUTH2, using `[mail] username` as the mailbox that sends the emails. Matomo proves its identity to the token endpoint with either a client secret or a certificate (`[mail] oauth_credential_type`). This works with Microsoft 365 (Exchange Online), where password-based SMTP authentication is being switched off."," "," ### New APIs"," * Controller actions can ask the user to confirm with their second factor, e.g. a two-factor authentication code, by calling `Piwik\\Plugins\\Login\\SecondFactorVerifier::requireSecondFactorConfirmed()`. Each confirmation can be used once, for that action only."],"additions":1,"deletions":0,"truncated":false},{"path":"config/global.ini.php","lines":["@@ -1256,9 +1256,25 @@"," transport = ; smtp (using the configuration below) or empty (using built-in mail() function)"," port = ; optional; defaults to 25 when security is none or tls; 465 for ssl"," host = ; SMTP server address","-type = ; SMTP Auth type. By default: NONE. For example: LOGIN","-username = ; SMTP username","-password = ; SMTP password","+type = ; SMTP Auth type. By default: NONE. For example: LOGIN. Use Xoauth2 to authenticate with OAuth 2.0 (see the oauth_ settings below)","+username = ; SMTP username. When type is Xoauth2: the address of the mailbox that sends the emails","+password = ; SMTP password. Not used when type is Xoauth2","+; Used when type is Xoauth2: the https:// URL Matomo requests access tokens from","+oauth_token_url = \"\"","+; Used when type is Xoauth2: the client ID (application ID) of the app registered with your email provider","+oauth_client_id = \"\"","+; Used when type is Xoauth2: the scope the access token is requested for","+oauth_scope = \"\"","+; Used when type is Xoauth2: \"secret\" to sign in with oauth_client_secret, or \"certificate\" to sign in with the certificate in oauth_certificate_path","+oauth_credential_type = \"secret\"","+; The client secret of the registered app. Only used when oauth_credential_type is \"secret\"","+oauth_client_secret = \"\"","+; Absolute path to the PEM certificate uploaded to the registered app. Only used when oauth_credential_type is \"certificate\"","+oauth_certificate_path = \"\"","+; Absolute path to the PEM private key of the certificate. Leave empty when the key is in the certificate file","+oauth_private_key_path = \"\"","+; Passphrase of the private key. Leave empty when the key has none","+oauth_private_key_password = \"\""," encryption = ; SMTP transport-layer encryption, either 'none', 'ssl', 'tls', or empty (i.e., auto)."," ssl_disallow_self_signed = 1 ; set to 0 to allow email server with self signed cert (not recommended)"," ssl_verify_peer = 1 ; set to 0 to disable verifying the authenticity of the peer's certificate (not recommended)"],"additions":19,"deletions":3,"truncated":false},{"path":"core/ExceptionHandler.php","lines":["@@ -135,6 +135,14 @@ public static function replaceSensitiveValues(string $message): string","             $valuesToReplace['smtppass'] = $mailConfig['password'];","         }"," ","+        if (!empty($mailConfig['oauth_client_secret'])) {","+            $valuesToReplace['smtpoauthclientsecret'] = $mailConfig['oauth_client_secret'];","+        }","+","+        if (!empty($mailConfig['oauth_private_key_password'])) {","+            $valuesToReplace['smtpoauthprivatekeypassword'] = $mailConfig['oauth_private_key_password'];","+        }","+","         // Remove possible empty entries","         $valuesToReplace = array_filter($valuesToReplace);"," "],"additions":8,"deletions":0,"truncated":false},{"path":"core/Http.php","lines":["@@ -249,9 +249,9 @@ private static function convertWildcardToPattern(string $wildcardHost): string","      * @param bool $validateEgressIp when true, the request is served over the SSRF-safe path: public-IP validation,","      *                               manual per-hop redirect re-validation and connection pinning. See","      *                               {@see sendHttpRequest()} for the full contract.","+     * @param bool $followRedirects when false, the redirect response is returned, so a secret is not sent to another URL","      *","      * @return ($destinationPath is null ? ($getExtendedInfo is true ? array{status: ?int, headers?: ?array, data?: ?string, effectiveUrl?: string} : string|false) : bool)","-     * @throws Exception","      */","     public static function sendHttpRequestBy(","         $method,","@@ -272,7 +272,8 @@ public static function sendHttpRequestBy(","         $additionalHeaders = array(),","         $forcePost = null,","         $checkHostIsAllowed = true,","-        $validateEgressIp = false","+        $validateEgressIp = false,","+        $followRedirects = true","     ) {","         if ($followDepth > 5) {","             throw new Exception('Too many redirects (' . $followDepth . ')');","@@ -418,6 +419,7 @@ public static function sendHttpRequestBy(","             'verifySsl' => !$acceptInvalidSslCertificate,","             'destinationPath' => $destinationPath,","             'validateEgressIp' => $validateEgressIp,","+            'followRedirects' => $followRedirects,","         );"," ","         /**","@@ -435,6 +437,8 @@ public static function sendHttpRequestBy(","          *                      - 'destinationPath' If set, the response of the HTTP request should be saved to this file","          *                      - 'validateEgressIp' Whether the caller asked for SSRF-safe semantics. A listener","          *                        resolving the request itself must honour them or leave it unhandled","+         *                      - 'followRedirects' When false, a listener resolving the request itself must not","+         *                        follow a redirect, as the request carries a secret","          * @param string &$response A plugin listening to this event should assign the HTTP response it received to this variable, for example \"{value: true}\"","          * @param int &$status A plugin listening to this event should assign the HTTP status code it received to this variable, for example \"200\"","          * @param array &$headers A plugin listening to this event should assign the HTTP headers it received to this variable, eg array('Content-Length' => '5')","@@ -602,7 +606,7 @@ public static function sendHttpRequestBy(","                 }"," ","                 // handle redirect","-                if (preg_match('/^Location:\\s*(.+)/', rtrim($line, \"\\r\\n\"), $m)) {","+                if ($followRedirects && preg_match('/^Location:\\s*(.+)/', rtrim($line, \"\\r\\n\"), $m)) {","                     if (is_resource($file)) {","                         @fclose($file);","                     }","@@ -639,9 +643,13 @@ public static function sendHttpRequestBy(","                 self::parseHeaderLine($headers, $line);","             }"," ","+            // a redirect that is not followed may have no body (4xx and 5xx statuses were handled above)","+            $isUnfollowedRedirect = !$followRedirects && $status >= 300;","+","             if (","                 feof($fsock)","                 && $httpMethod != 'HEAD'","+                && !$isUnfollowedRedirect","             ) {","                 throw new Exception('Unexpected end of transmission');","             }","@@ -694,6 +702,7 @@ public static function sendHttpRequestBy(","                             . (!empty($additionalHeaders) ? implode(\"\\r\\n\", $additionalHeaders) . \"\\r\\n\" : '')","                             . $rangeHeader,","                         'max_redirects' => 5,","+                        'follow_location' => $followRedirects ? 1 : 0,","                         'timeout'       => $timeout,","                     ),","                 );","@@ -843,7 +852,9 @@ public static function sendHttpRequestBy(","             }"," ","             // CURLOPT_FOLLOWLOCATION cannot be set when open_basedir is set","-            if (!$validateEgressIp && ini_get('open_basedir') == '') {","+            if (!$followRedirects) {","+                @curl_setopt($ch, CURLOPT_FOLLOWLOCATION, false);","+            } elseif (!$validateEgressIp && ini_get('open_basedir') == '') {","                 $protocols = 0;"," ","                 foreach (explode(',', $allowedProtocols) as $protocol) {","@@ -919,7 +930,7 @@ public static function sendHttpRequestBy(","             unset($ch);"," ","             // SSRF-safe path follows redirects manually so each hop is re-validated and re-pinned.","-            if ($validateEgressIp && $status >= 300 && $status < 400 && $status !== 304) {","+            if ($followRedirects && $validateEgressIp && $status >= 300 && $status < 400 && $status !== 304) {","                 if (is_resource($file)) {","                     // CURLOPT_HEADER is off for file downloads, so the Location cannot be re-validated: fail closed.","                     @fclose($file);","@@ -1005,6 +1016,8 @@ public static function sendHttpRequestBy(","          *                      - 'destinationPath' If set, the response of the HTTP request should be saved to this file","          *                      - 'validateEgressIp' Whether the caller asked for SSRF-safe semantics. A listener","          *                        resolving the request itself must honour them or leave it unhandled","+         *                      - 'followRedirects' When false, a redirect was not followed and the response is the","+         *                        redirect response itself","          * @param string &$response The response of the HTTP request, for example \"{value: true}\"","          * @param int &$status The returned HTTP status code, for example \"200\"","          * @param array &$headers The returned headers, eg array('Content-Length' => '5')"],"additions":18,"deletions":5,"truncated":false},{"path":"core/Http/OAuth/AccessTokenProvider.php","lines":["@@ -0,0 +1,27 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Http\\OAuth;","+","+/**","+ * Provides an OAuth 2.0 access token for a connection to another service.","+ *","+ * @internal","+ */","+interface AccessTokenProvider","+{","+    public function getAccessToken(): string;","+","+    /**","+     * Drops a cached access token, so the next call requests a new one.","+     */","+    public function forgetAccessToken(): void;","+}"],"additions":27,"deletions":0,"truncated":false},{"path":"core/Http/OAuth/ClientAssertion.php","lines":["@@ -0,0 +1,106 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Http\\OAuth;","+","+/**","+ * Builds the signed JWT a client sends instead of a client secret when it authenticates with a certificate.","+ *","+ * @internal","+ */","+class ClientAssertion","+{","+    public const ASSERTION_TYPE = 'urn:ietf:params:oauth:client-assertion-type:jwt-bearer';","+","+    public static function create(","+        string $clientId,","+        string $tokenUrl,","+        string $certificatePath,","+        string $privateKeyPath,","+        #[\\SensitiveParameter]","+        string $privateKeyPassword,","+        int $now","+    ): string {","+        if (!extension_loaded('openssl')) {","+            throw new TokenRequestFailedException(","+                'The OAuth certificate or private key could not be used.',","+                'The openssl PHP extension is needed to use a certificate.'","+            );","+        }","+","+        // drop errors left over from earlier openssl calls, so they don't end up in the detail","+        self::getOpenSslErrors();","+","+        $certificate = @openssl_x509_read('file://' . $certificatePath);","+        if ($certificate === false) {","+            self::fail('Could not read a PEM encoded certificate from ' . $certificatePath . '.');","+        }","+","+        $privateKey = @openssl_pkey_get_private('file://' . ($privateKeyPath ?: $certificatePath), $privateKeyPassword);","+        if ($privateKey === false) {","+            self::fail('Could not read the private key. Check that it is PEM encoded and that the private key password is correct.');","+        }","+","+        if (!openssl_x509_check_private_key($certificate, $privateKey)) {","+            self::fail('The private key does not belong to the certificate.');","+        }","+","+        $header = [","+            'alg'      => 'RS256',","+            'typ'      => 'JWT',","+            'x5t#S256' => self::base64UrlEncode((string) openssl_x509_fingerprint($certificate, 'sha256', true)),","+        ];","+        $claims = [","+            'aud' => $tokenUrl,","+            'iss' => $clientId,","+            'sub' => $clientId,","+            'jti' => bin2hex(random_bytes(16)),","+            'nbf' => $now,","+            'iat' => $now,","+            'exp' => $now + 300,","+        ];","+","+        $unsignedToken = self::base64UrlEncode((string) json_encode($header, JSON_UNESCAPED_SLASHES))","+            . '.' . self::base64UrlEncode((string) json_encode($claims, JSON_UNESCAPED_SLASHES));","+","+        if (!openssl_sign($unsignedToken, $signature, $privateKey, OPENSSL_ALGO_SHA256)) {","+            self::fail('Could not sign the client assertion.');","+        }","+","+        return $unsignedToken . '.' . self::base64UrlEncode($signature);","+    }","+","+    private static function fail(string $reason): never","+    {","+        $openSslErrors = self::getOpenSslErrors();","+","+        // the message can be shown to visitors who are not logged in, so the reason only goes in the detail","+        throw new TokenRequestFailedException(","+            'The OAuth certificate or private key could not be used.',","+            $reason . ($openSslErrors !== '' ? ' (' . $openSslErrors . ')' : '')","+        );","+    }","+","+    private static function getOpenSslErrors(): string","+    {","+        $errors = [];","+        while (($error = openssl_error_string()) !== false) {","+            $errors[] = $error;","+        }","+","+        return implode('; ', $errors);","+    }","+","+    private static function base64UrlEncode(string $data): string","+    {","+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');","+    }","+}"],"additions":106,"deletions":0,"truncated":false},{"path":"core/Http/OAuth/ClientCredentials.php","lines":["@@ -0,0 +1,131 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Http\\OAuth;","+","+/**","+ * The settings to request an OAuth 2.0 access token with, using either a client secret or a certificate.","+ *","+ * @internal","+ */","+class ClientCredentials","+{","+    public const CREDENTIAL_TYPE_SECRET = 'secret';","+    public const CREDENTIAL_TYPE_CERTIFICATE = 'certificate';","+","+    private string $tokenUrl;","+    private string $clientId;","+    private string $scope;","+    private string $credentialType;","+    private string $clientSecret;","+    private string $certificatePath;","+    private string $privateKeyPath;","+    private string $privateKeyPassword;","+","+    /**","+     * @param string $privateKeyPath when empty, the private key is read from the certificate file","+     */","+    public function __construct(","+        string $tokenUrl,","+        string $clientId,","+        string $scope,","+        string $credentialType,","+        #[\\SensitiveParameter]","+        string $clientSecret = '',","+        string $certificatePath = '',","+        string $privateKeyPath = '',","+        #[\\SensitiveParameter]","+        string $privateKeyPassword = ''","+    ) {","+        $this->tokenUrl = $tokenUrl;","+        $this->clientId = $clientId;","+        $this->scope = $scope;","+        $this->credentialType = $credentialType;","+        $this->clientSecret = $clientSecret;","+        $this->certificatePath = $certificatePath;","+        $this->privateKeyPath = $privateKeyPath;","+        $this->privateKeyPassword = $privateKeyPassword;","+    }","+","+    public function getTokenUrl(): string","+    {","+        return $this->tokenUrl;","+    }","+","+    public function getClientId(): string","+    {","+        return $this->clientId;","+    }","+","+    public function getScope(): string","+    {","+        return $this->scope;","+    }","+","+    public function getCredentialType(): string","+    {","+        return $this->credentialType;","+    }","+","+    public function getClientSecret(): string","+    {","+        return $this->clientSecret;","+    }","+","+    public function getCertificatePath(): string","+    {","+        return $this->certificatePath;","+    }","+","+    public function getPrivateKeyPath(): string","+    {","+        return $this->privateKeyPath;","+    }","+","+    public function getPrivateKeyPassword(): string","+    {","+        return $this->privateKeyPassword;","+    }","+","+    public function isCertificate(): bool","+    {","+        return $this->credentialType === self::CREDENTIAL_TYPE_CERTIFICATE;","+    }","+","+    public function hasValidCredentialType(): bool","+    {","+        return in_array($this->credentialType, [self::CREDENTIAL_TYPE_SECRET, self::CREDENTIAL_TYPE_CERTIFICATE], true);","+    }","+","+    public function isComplete(): bool","+    {","+        $credential = $this->isCertificate() ? $this->certificatePath : $this->clientSecret;","+","+        return $this->tokenUrl !== '' && $this->clientId !== '' && $credential !== '';","+    }","+","+    /**","+     * Identifies these settings, without revealing the secret, so a token can be cached for them.","+     */","+    public function getHash(): string","+    {","+        return hash('sha256', implode(\"\\n\", [","+            $this->tokenUrl,","+            $this->clientId,","+            $this->scope,","+            $this->credentialType,","+            $this->clientSecret,","+            $this->certificatePath,","+            $this->privateKeyPath,","+            $this->privateKeyPassword,","+        ]));","+    }","+}"],"additions":131,"deletions":0,"truncated":false},{"path":"core/Http/OAuth/ClientCredentialsTokenProvider.php","lines":["@@ -0,0 +1,278 @@","+<?php","+","+/**","+ * Matomo - free/libre analytics platform","+ *","+ * @link    https://matomo.org","+ * @license https://www.gnu.org/licenses/gpl-3.0.html GPL v3 or later","+ */","+","+declare(strict_types=1);","+","+namespace Piwik\\Http\\OAuth;","+","+use Matomo\\Cache\\Lazy;","+use Piwik\\Date;","+use Piwik\\Http;","+use Psr\\Log\\LoggerInterface;","+","+/**","+ * Gets an access token with the OAuth 2.0 client credentials flow and caches it until shortly before it expires.","+ *","+ * @internal","+ */","+abstract class ClientCredentialsTokenProvider implements AccessTokenProvider","+{","+    private const TIMEOUT_IN_SECONDS = 10;","+    private const EXPIRY_MARGIN_IN_SECONDS = 60;","+    private const FAILURE_LIFETIME_IN_SECONDS = 60;","+    private const MAX_ERROR_DETAIL_LENGTH = 500;","+","+    private Lazy $cache;","+","+    private LoggerInterface $logger;","+","+    public function __construct(Lazy $cache, LoggerInterface $logger)","+    {","+        $this->cache = $cache;","+        $this->logger = $logger;","+    }","+","+    /**","+     * Called on every request, so changed settings are used right away.","+     */","+    abstract protected function getClientCredentials(): ClientCredentials;","+","+    /**","+     * Names the connection in error messages, for example \"SMTP\".","+     */","+    abstract protected function getConnectionName(): string;","+","+    public function getAccessToken(): string","+    {","+        $credentials = $this->getClientCredentials();","+        $tokenUrl = $credentials->getTokenUrl();","+","+        if (!$credentials->hasValidCredentialType() || !$credentials->isComplete()) {","+            throw new TokenRequestFailedException($this->getMessage('The %s OAuth settings are incomplete.'));","+        }","+","+        if (stripos($tokenUrl, 'https://') !== 0) {","+            throw new TokenRequestFailedException($this->getMessage('The %s OAuth token URL has to start with https://.'));","+        }","+","+        $cacheId = $this->getCacheId($credentials);","+","+        $cachedToken = $this->fetchUnexpired($cacheId);","+        if ($cachedToken !== null) {","+            return (string) $cachedToken['token'];","+        }","+","+        // a failed request is remembered for a short time, so a batch of calls does not wait for each of them","+        $failure = $this->fetchUnexpired($this->getFailureCacheId($credentials));","+        if ($failure !== null) {","+            throw new TokenRequestFailedException((string) $failure['message'], (string) $failure['detail']);","+        }","+","+        try {","+            $token = $this->requestToken($tokenUrl, $this->getRequestBody($credentials));","+        } catch (TokenRequestFailedException $e) {","+            $this->saveWithExpiry(","+                $this->getFailureCacheId($credentials),","+                ['message' => $e->getMessage(), 'detail' => $e->getDetail()],","+                self::FAILURE_LIFETIME_IN_SECONDS","+            );","+","+            // the message stays generic because it can be shown to visitors, so the reason is only logged","+            $this->logger->warning('{message} Reason: {detail}', [","+                'message' => $e->getMessage(),","+                'detail' => $e->getDetail(),","+                'ignoreInScreenWriter' => true,","+            ]);","+","+            throw $e;","+        }","+","+        $lifetime = (int) ($token['expires_in'] ?? 0) - self::EXPIRY_MARGIN_IN_SECONDS;","+        if ($lifetime > 0) {","+            $this->saveWithExpiry($cacheId, ['token' => $token['access_token']], $lifetime);","+        }","+","+        return $token['access_token'];","+    }","+","+    public function forgetAccessToken(): void","+    {","+        try {","+            $credentials = $this->getClientCredentials();","+        } catch (TokenRequestFailedException $e) {","+            // no token was cached for settings that cannot be used","+            return;","+        }","+","+        $this->cache->delete($this->getCacheId($credentials));","+        $this->cache->delete($this->getFailureCacheId($credentials));","+    }","+","+    /**","+     * The expiry is stored with the entry, because not every cache backend removes expired entries.","+     *","+     * @param array<string, string> $entry","+     */","+    private function saveWithExpiry(string $cacheId, array $entry, int $lifetime): void","+    {","+        $entry['expires'] = Date::getNowTimestamp() + $lifetime;","+","+        $this->cache->save($cacheId, $entry, $lifetime);","+    }","+","+    /**","+     * @return array<string, mixed>|null","+     */","+    private function fetchUnexpired(string $cacheId): ?array","+    {","+        $entry = $this->cache->fetch($cacheId);","+","+        if (!is_array($entry) || (int) ($entry['expires'] ?? 0) <= Date::getNowTimestamp()) {","+            return null;","+        }","+","+        return $entry;","+    }","+","+    /**","+     * @param array<string, string> $requestBody","+     * @return array{access_token: string, expires_in?: mixed}","+     */","+    private function requestToken(","+        string $tokenUrl,","+        #[\\SensitiveParameter]","+        array $requestBody","+    ): array {","+        try {","+            $response = $this->sendTokenRequest($tokenUrl, $requestBody);","+        } catch (\\Exception $e) {","+            // the reason can name the token URL, so it is kept out of the message","+            throw new TokenRequestFailedException($this->getMessage('The %s OAuth token endpoint could not be reached.'), $e->getMessage());","+        }","+","+        return $this->parseResponse($response);","+    }","+","+    /**","+     * @return array<string, string>","+     */","+    private function getRequestBody(ClientCredentials $credentials): array","+    {","+        $requestBody = [","+            'grant_type' => 'client_credentials',","+            'client_id'  => $credentials->getClientId(),","+        ];","+","+        if ($credentials->isCertificate()) {","+            try {","+                $assertion = ClientAssertion::create(","+                    $credentials->getClientId(),","+                    $credentials->getTokenUrl(),","+                    $credentials->getCertificatePath(),","+                    $credentials->getPrivateKeyPath(),","+                    $credentials->getPrivateKeyPassword(),","+                    Date::getNowTimestamp()","+                );","+            } catch (TokenRequestFailedException $e) {","+                throw new TokenRequestFailedException(","+                    $this->getMessage('The %s OAuth certificate or private key could not be used.'),","+                    $e->getDetail()","+                );","+            }","+","+            $requestBody['client_assertion_type'] = ClientAssertion::ASSERTION_TYPE;","+            $requestBody['client_assertion'] = $assertion;","+        } else {","+            $requestBody['client_secret'] = $credentials->getClientSecret();","+        }","+","+        if ($credentials->getScope() !== '') {","+            $requestBody['scope'] = $credentials->getScope();","+        }","+","+        return $requestBody;","+    }","+","+    private function getCacheId(ClientCredentials $credentials): string","+    {","+        return 'OAuthAccessToken_' . $credentials->getHash();","+    }","+","+    private function getFailureCacheId(ClientCredentials $credentials): string","+    {","+        return $this->getCacheId($credentials) . '_failed';","+    }","+","+    private function getMessage(string $message): string","+    {","+        return sprintf($message, $this->getConnectionName());","+    }","+","+    /**","+     * @param array<string, string> $requestBody","+     * @return array{status: ?int, data?: ?string}","+     */","+    protected function sendTokenRequest(","+        string $tokenUrl,","+        #[\\SensitiveParamete