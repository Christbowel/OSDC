"+\t'classid',","+\t'codebase',","+\t'data',","+\t'formaction',","+\t'from',","+\t'href',","+\t'icon',","+\t'longdesc',","+\t'manifest',","+\t'poster',","+\t'profile',","+\t'src',","+\t'to',","+\t'usemap',","+\t'values',","+\t'xlink:href',","+\t'xlinkhref',","+\t'xmlns',","+] );","+","+// Same pattern as the Interactivity API: browsers ignore leading C0 controls","+// and spaces, and tabs and newlines anywhere, in a URL's scheme.","+const JAVASCRIPT_URL =","+\t/^[\\u0000-\\u001F ]*j[\\r\\n\\t]*a[\\r\\n\\t]*v[\\r\\n\\t]*a[\\r\\n\\t]*s[\\r\\n\\t]*c[\\r\\n\\t]*r[\\r\\n\\t]*i[\\r\\n\\t]*p[\\r\\n\\t]*t[\\r\\n\\t]*\\:/i;","+","+function isJavaScriptURL( key: string, value: string ): boolean {","+\tif ( ! URL_ATTRIBUTES.has( key ) ) {","+\t\treturn false;","+\t}","+","+\t// SVG animation values are a semicolon separated list.","+\tconst urls = key === 'values' ? value.split( ';' ) : [ value ];","+\treturn urls.some( ( url ) => JAVASCRIPT_URL.test( url ) );","+}","+","+function isCrossOriginURL( src: string | null ): boolean {","+\ttry {","+\t\tconst { origin, protocol } = new URL( src ?? '', document.baseURI );","+\t\treturn (","+\t\t\t( protocol === 'https:' || protocol === 'http:' ) &&","+\t\t\torigin !== window.location.origin","+\t\t);","+\t} catch {","+\t\treturn false;","+\t}","+}","+","+function sanitize( html: string ): string {"," \tconst { body } = document.implementation.createHTMLDocument( '' );"," \tbody.innerHTML = html;"," \tconst elements = body.getElementsByTagName( '*' );"," \tlet elementIndex = elements.length;"," ","+\t// Named form controls can shadow these on the element itself.","+\tconst { getAttribute, getAttributeNames, removeAttribute, setAttribute } =","+\t\tElement.prototype;","+"," \twhile ( elementIndex-- ) {"," \t\tconst element = elements[ elementIndex ];"," ","-\t\tif ( element.tagName === 'SCRIPT' ) {","+\t\tif ( UNSAFE_ELEMENTS.has( element.localName ) ) {"," \t\t\tremove( element );","-\t\t} else {","-\t\t\tlet attributeIndex = element.attributes.length;","+\t\t\tcontinue;","+\t\t}"," ","-\t\t\twhile ( attributeIndex-- ) {","-\t\t\t\tconst { name: key } = element.attributes[ attributeIndex ];","+\t\tfor ( const key of getAttributeNames.call( element ) ) {","+\t\t\tconst value = getAttribute.call( element, key ) ?? '';"," ","-\t\t\t\tif ( key.startsWith( 'on' ) ) {","-\t\t\t\t\telement.removeAttribute( key );","-\t\t\t\t}","+\t\t\tif ( key.startsWith( 'on' ) || isJavaScriptURL( key, value ) ) {","+\t\t\t\tremoveAttribute.call( element, key );"," \t\t\t}"," \t\t}","+","+\t\tif (","+\t\t\telement.localName === 'iframe' &&","+\t\t\t( getAttribute.call( element, 'srcdoc' ) !== null ||","+\t\t\t\t! isCrossOriginURL( getAttribute.call( element, 'src' ) ) )","+\t\t) {","+\t\t\tsetAttribute.call( element, 'sandbox', IFRAME_SANDBOX );","+\t\t}"," \t}"," "," \treturn body.innerHTML;"," }","+","+/**","+ * Strips scripts, on* attributes, script URLs and other active content from","+ * HTML, and sandboxes iframes that the same-origin policy doesn't isolate.","+ *","+ * @param html HTML to sanitize.","+ *","+ * @return The sanitized HTML.","+ */","+export default function safeHTML( html: string ): string {","+\tlet output = html;","+","+\t// Parsing serialized markup can change its structure (mutation XSS), so","+\t// repeat until the output is stable.","+\tfor ( let pass = 0; pass < MAX_PASSES; pass++ ) {","+\t\tconst sanitized = sanitize( output );","+","+\t\tif ( sanitized === output ) {","+\t\t\treturn sanitized;","+\t\t}","+","+\t\toutput = sanitized;","+\t}","+","+\treturn '';","+}"],"additions":113,"deletions":16,"truncated":false},{"path":"packages/dom/src/dom/test/safe-html.jsdom.test.ts","lines":["@@ -26,4 +26,131 @@ describe( 'safeHTML', () => {"," \t\tconst output = '';"," \t\texpect( safeHTML( input ) ).toBe( output );"," \t} );","+","+\tit( 'should strip svg script tags', () => {","+\t\texpect( safeHTML( '<svg><script>alert(1)</script></svg>' ) ).toBe(","+\t\t\t'<svg></svg>'","+\t\t);","+\t} );","+