args...) }","+","+\tbound, err := govaluate.NewEvaluableExpressionWithFunctions(expression.String(), functions)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\treturn bound.Evaluate(values)","+}","+","+// This check only avoids rebinding pure expressions. The global registry denies","+// all network helpers, so an unrecognized spelling cannot bypass the gate.","+func hasNetworkHelper(expression string) bool {","+\tfor _, name := range []string{\"resolve\", \"public_ip\", \"publicip\", \"jarm\"} {","+\t\tif strings.Contains(expression, name) {","+\t\t\treturn true","+\t\t}","+\t}","+","+\treturn false","+}","+","+func networkDialers(options *types.Options) (*protocolstate.Dialers, error) {","+\tif options == nil {","+\t\treturn nil, ErrNetworkHelpersDisabled","+\t}","+","+\tstate := protocolstate.GetDialersWithId(options.ExecutionId)","+\tif state == nil || state.Fastdialer == nil || state.NetworkPolicy == nil {","+\t\treturn nil, fmt.Errorf(\"network DSL helpers require initialized scan dialers\")","+\t}","+","+\treturn state, nil","+}","+","+func canonicalNetworkHost(host string) (string, error) {","+\tif strings.Contains(host, `\\`) {","+\t\t// Decode DNS presentation escapes before checking the host policy, using","+\t\t// the same wire representation as the resolver. Preserve escaped label dots.","+\t\tvar wire [255]byte","+","+\t\tn, err := dns.PackDomainName(dns.Fqdn(host), wire[:], 0, nil, false)","+\t\tif err != nil {","+\t\t\treturn \"\", err","+\t\t}","+","+\t\thost, _, err = dns.UnpackDomainName(wire[:n], 0)","+\t\tif err != nil {","+\t\t\treturn \"\", err","+\t\t}","+\t}","+","+\thost = strings.TrimSuffix(host, \".\")","+\tif ip := net.ParseIP(host); ip != nil {","+\t\treturn ip.String(), nil","+\t}","+","+\t// Match the dialer's IDNA conversion without rejecting DNS service labels.","+\treturn idna.ToASCII(strings.ToLower(host))","+}","+","+func networkHost(state *protocolstate.Dialers, host string) (string, error) {","+\tcanonical, err := canonicalNetworkHost(host)","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"normalize network DSL host %q: %w\", host, err)","+\t}","+","+\tallowed := state.NetworkPolicy.Validate(host) &&","+\t\tstate.NetworkPolicy.Validate(strings.TrimSuffix(host, \".\")) &&","+\t\tstate.NetworkPolicy.Validate(canonical)","+","+\t// Also canonicalize plain hostname exclusions. Keep explicit regex rules","+\t// intact and check them against both the original and canonical host above.","+\tfor excluded := range state.NetworkPolicy.DenyRules {","+\t\tif !allowed {","+\t\t\tbreak","+\t\t}","+","+\t\tif strings.ContainsAny(excluded, `\\^$*+?()[]{}|`) {","+\t\t\tcontinue","+\t\t}","+","+\t\tnormalized, err := canonicalNetworkHost(excluded)","+\t\tif err != nil {","+\t\t\treturn \"\", fmt.Errorf(\"normalize network DSL exclusion %q: %w\", excluded, err)","+\t\t}","+","+\t\tif normalized == excluded {","+\t\t\tcontinue","+\t\t}","+","+\t\tmatched, err := regexp.MatchString(normalized, canonical)","+\t\tif err != nil {","+\t\t\treturn \"\", fmt.Errorf(\"match network DSL exclusion %q: %w\", excluded, err)","+\t\t}","+","+\t\tallowed = !matched","+\t}","+","+\tif !allowed {","+\t\treturn \"\", fmt.Errorf(\"host %s denied by network policy\", host)","+\t}","+","+\treturn canonical, nil","+}","+","+func dialNetwork(ctx context.Context, state *protocolstate.Dialers, network, address string) (net.Conn, error) {","+\thost, port, err := net.SplitHostPort(address)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\thost, err = networkHost(state, host)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\t// The dialer checks resolved IPs, including connections made through a proxy.","+\treturn state.Fastdialer.Dial(ctx, network, net.JoinHostPort(host, port))","+}","+","+func resolve(options *types.Options, args ...interface{}) (interface{}, error) {","+\targCount := len(args)","+\tif argCount == 0 || argCount > 2 {","+\t\treturn nil, dsl.ErrInvalidDslFunction","+\t}","+","+\tformat := \"4\"","+","+\tvar dnsType uint16","+","+\tif len(args) > 1 {","+\t\tformat = strings.ToLower(types.ToString(args[1]))","+\t}","+","+\tswitch format {","+\tcase \"4\", \"a\":","+\t\tdnsType = dns.TypeA","+\tcase \"6\", \"aaaa\":","+\t\tdnsType = dns.TypeAAAA","+\tcase \"cname\":","+\t\tdnsType = dns.TypeCNAME","+\tcase \"ns\":","+\t\tdnsType = dns.TypeNS","+\tcase \"txt\":","+\t\tdnsType = dns.TypeTXT","+\tcase \"srv\":","+\t\tdnsType = dns.TypeSRV","+\tcase \"ptr\":","+\t\tdnsType = dns.TypePTR","+\tcase \"mx\":","+\t\tdnsType = dns.TypeMX","+\tcase \"soa\":","+\t\tdnsType = dns.TypeSOA","+\tcase \"caa\":","+\t\tdnsType = dns.TypeCAA","+\tdefault:","+\t\treturn nil, fmt.Errorf(\"invalid dns type\")","+\t}","+","+\tstate, err := networkDialers(options)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\thost, err := networkHost(state, types.ToString(args[0]))","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"resolve: %w\", err)","+\t}","+","+\tdnsOptions := retryabledns.DefaultOptions","+\tif len(options.InternalResolversList) > 0 {","+\t\tdnsOptions.BaseResolvers = options.InternalResolversList","+\t}","+\tdnsOptions.Proxy = options.AliveSocksProxy","+","+\tdnsClient, err := retryabledns.NewWithOptions(dnsOptions)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tdefer dnsClient.Close()","+","+\t// query","+\trawResp, err := dnsClient.Query(host, dnsType)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\t// A DNS answer must not reveal addresses that the scan excludes.","+\tfor _, addresses := range [][]string{rawResp.A, rawResp.AAAA} {","+\t\tfor _, address := range addresses {","+\t\t\tif !state.NetworkPolicy.Validate(address) {","+\t\t\t\treturn nil, fmt.Errorf(\"resolve: address %s denied by network policy\", address)","+\t\t\t}","+\t\t}","+\t}","+","+\tdnsValues := map[uint16][]string{","+\t\tdns.TypeA:     rawResp.A,","+\t\tdns.TypeAAAA:  rawResp.AAAA,","+\t\tdns.TypeCNAME: rawResp.CNAME,","+\t\tdns.TypeNS:    rawResp.NS,","+\t\tdns.TypeTXT:   rawResp.TXT,","+\t\tdns.TypeSRV:   rawResp.SRV,","+\t\tdns.TypePTR:   rawResp.PTR,","+\t\tdns.TypeMX:    rawResp.MX,","+\t\tdns.TypeCAA:   rawResp.CAA,","+\t\tdns.TypeSOA:   rawResp.GetSOARecords(),","+\t}","+","+\tif values, ok := dnsValues[dnsType]; ok {","+\t\tfirstFound, found := sliceutil.FirstNonZero(values)","+\t\tif found {","+\t\t\treturn firstFound, nil","+\t\t}","+\t}","+","+\treturn \"\", fmt.Errorf(\"no records found\")","+}","+","+func publicIP(options *types.Options, args ...interface{}) (interface{}, error) {","+\tif len(args) != 0 {","+\t\treturn nil, dsl.ErrInvalidDslFunction","+\t}","+","+\tstate, err := networkDialers(options)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\ttransport := &http.Transport{DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {","+\t\treturn dialNetwork(ctx, state, network, address)","+\t}}","+\tdefer transport.CloseIdleConnections()","+","+\tclient := &http.Client{Transport: transport, Timeout: 2 * time.Second}","+","+\tresponse, err := client.Get(\"https://checkip.amazonaws.com/\")","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"public_ip: %w\", err)","+\t}","+\tdefer response.Body.Close()","+","+\tif response.StatusCode != http.StatusOK {","+\t\treturn nil, fmt.Errorf(\"public_ip: unexpected HTTP status %s\", response.Status)","+\t}","+","+\tbody, err := io.ReadAll(io.LimitReader(response.Body, 4096))","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"public_ip: read response: %w\", err)","+\t}","+","+\taddress := strings.TrimSpace(string(body))","+\tif net.ParseIP(address) == nil {","+\t\treturn nil, fmt.Errorf(\"public_ip: service returned an invalid IP address\")","+\t}","+","+\treturn address, nil","+}","+","+func jarm(options *types.Options, args ...interface{}) (interface{}, error) {","+\tif len(args) != 1 {","+\t\treturn nil, dsl.ErrInvalidDslFunction","+\t}","+","+\ttarget, ok := args[0].(string)","+\tif !ok {","+\t\treturn nil, fmt.Errorf(\"jarm: target must be a host:port string\")","+\t}","+","+\thost, portText, err := net.SplitHostPort(target)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"jarm: %w\", err)","+\t}","+","+\tport, err := strconv.Atoi(portText)","+\tif err != nil || port < 1 || port > 65535 {","+\t\treturn nil, fmt.Errorf(\"jarm: invalid port %q\", portText)","+\t}","+","+\tstate, err := networkDialers(options)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\thost, err = networkHost(state, host)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"jarm: %w\", err)","+\t}","+","+\ttarget = net.JoinHostPort(host, portText)","+","+\tctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)","+\tdefer cancel()","+","+\tprobes := gojarm.GetProbes(host, port)","+\tresults := make([]string, 0, len(probes))","+","+\tfor _, probe := range probes {","+\t\tconn, err := dialNetwork(ctx, state, \"tcp\", target)","+\t\tif err != nil {","+\t\t\treturn nil, fmt.Errorf(\"jarm: dial target: %w\", err)","+\t\t}","+","+\t\t// Each probe uses a fresh TCP connection and the scan's dial-time policy.","+\t\terr = conn.SetDeadline(time.Now().Add(10 * time.Second))","+\t\tif err == nil {","+\t\t\t_, err = conn.Write(gojarm.BuildProbe(probe))","+\t\t}","+","+\t\tvar answer string","+","+\t\tif err == nil {","+\t\t\tbuffer := make([]byte, 1484)","+\t\t\t_, _ = conn.Read(buffer)","+\t\t\tanswer, _ = gojarm.ParseServerHello(buffer, probe)","+\t\t}","+","+\t\t_ = conn.Close()","+","+\t\tresults = append(results, answer)","+\t}","+","+\treturn gojarm.RawHashToFuzzyHash(strings.Join(results, \",\")), nil","+}"],"additions":361,"deletions":0,"truncated":false},{"path":"pkg/operators/common/dsl/network_policy_test.go","lines":["@@ -0,0 +1,336 @@","+package dsl","+","+import (","+\t\"fmt\"","+\t\"net\"","+\t\"strings\"","+\t\"sync\"","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/miekg/dns\"","+\t\"github.com/projectdiscovery/fastdialer/fastdialer\"","+\t\"github.com/projectdiscovery/govaluate\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/protocols/common/protocolstate\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/types\"","+\t\"github.com/stretchr/testify/require\"","+\t\"golang.org/x/net/proxy\"","+)","+","+func networkTestDNS(t *testing.T, address string) (string, *atomic.Int32) {","+\tt.Helper()","+\tlistener, err := net.ListenPacket(\"udp\", \"127.0.0.1:0\")","+\trequire.NoError(t, err)","+\tqueries := new(atomic.Int32)","+\tserver := &dns.Server{PacketConn: listener, Handler: dns.HandlerFunc(func(writer dns.ResponseWriter, request *dns.Msg) {","+\t\tqueries.Add(1)","+\t\tresponse := new(dns.Msg).SetReply(request)","+\t\tfor _, question := range request.Question {","+\t\t\tif question.Qtype == dns.TypeA {","+\t\t\t\tresponse.Answer = append(response.Answer, &dns.A{Hdr: dns.RR_Header{Name: question.Name, Rrtype: dns.TypeA, Class: dns.ClassINET}, A: net.ParseIP(address)})","+\t\t\t}","+\t\t}","+\t\t_ = writer.WriteMsg(response)","+\t})}","+\tstarted := make(chan struct{})","+\tserver.NotifyStartedFunc = func() { close(started) }","+\tdone := make(chan error, 1)","+\tgo func() { done <- server.ActivateAndServe() }()","+\t<-started","+\tt.Cleanup(func() { require.NoError(t, server.Shutdown()); require.NoError(t, <-done) })","+\treturn listener.LocalAddr().String(), queries","+}","+","+func networkTestOptions(t *testing.T, options *types.Options) *types.Options {","+\tt.Helper()","+\tif options.ExecutionId == \"\" {","+\t\toptions.ExecutionId = t.Name()","+\t}","+\trequire.NoError(t, protocolstate.Init(options))","+\tt.Cleanup(func() { protocolstate.Close(options.ExecutionId) })","+\treturn options","+}","+","+func evalNetworkTest(t *testing.T, source string, options *types.Options) (interface{}, error) {","+\tt.Helper()","+\texpression, err := govaluate.NewEvaluableExpressionWithFunctions(source, HelperFunctions)","+\trequire.NoError(t, err)","+\treturn EvalWithOptions(expression, nil, options)","+}","+","+func TestNetworkHelpersRequireInitializedScan(t *testing.T) {","+\tfor _, restricted := range []bool{false, true} {","+\t\tt.Run(fmt.Sprint(restricted), func(t *testing.T) {","+\t\t\toptions := &types.Options{ExecutionId: t.Name(), RestrictLocalNetworkAccess: restricted}","+\t\t\tfor _, expression := range []string{`resolve(\"example.com\")`, `jarm(\"8.8.8.8:443\")`, `public_ip()`, `publicip()`} {","+\t\t\t\t_, err := evalNetworkTest(t, expression, options)","+\t\t\t\trequire.ErrorContains(t, err, \"initialized scan dialers\")","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestResolveNetworkPolicy(t *testing.T) {","+\tfor _, item := range []struct {","+\t\tname, address, exclude string","+\t\trestricted, wantError  bool","+\t}{","+\t\t{name: \"public without lna\", address: \"8.8.8.8\"},","+\t\t{name: \"public with lna\", address: \"8.8.8.8\", restricted: true},","+\t\t{name: \"private without lna\", address: \"127.0.0.1\"},","+\t\t{name: \"private with lna\", address: \"127.0.0.1\", restricted: true, wantError: true},","+\t\t{name: \"excluded address\", address: \"8.8.8.8\", exclude: \"8.8.8.8\", wantError: true},","+\t\t{name: \"excluded CIDR\", address: \"8.8.8.8\", exclude: \"8.8.8.0/24\", wantError: true},","+\t\t{name: \"excluded hostname\", address: \"8.8.8.8\", exclude: \"fixture.example\", wantError: true},","+\t\t{name: \"excluded with lna\", address: \"8.8.8.8\", exclude: \"8.8.8.0/24\", restricted: true, wantError: true},","+\t} {","+\t\tt.Run(item.name, func(t *testing.T) {","+\t\t\tresolver, queries := networkTestDNS(t, item.address)","+\t\t\toptions := &types.Options{RestrictLocalNetworkAccess: item.restricted, InternalResolversList: []string{resolver}}","+\t\t\tif item.exclude != \"\" {","+\t\t\t\toptions.ExcludeTargets = []string{item.exclude}","+\t\t\t}","+\t\t\tnetworkTestOptions(t, options)","+\t\t\tresult, err := evalNetworkTest(t, `resolve(\"fixture.example.\")`, options)","+\t\t\tif item.wantError {","+\t\t\t\trequire.ErrorContains(t, err, \"network policy\")","+\t\t\t} else {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Equal(t, item.address, result)","+\t\t\t}","+\t\t\tif item.exclude == \"fixture.example\" {","+\t\t\t\trequire.Zero(t, queries.Load())","+\t\t\t} else {","+\t\t\t\trequire.Positive(t, queries.Load())","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestJARMNetworkPolicy(t *testing.T) {","+\tfor _, target := range []string{\"127.0.0.1:443\", \"[::1]:443\", \"[::ffff:127.0.0.1]:443\", \"8.8.8.8:443\", \"fixture.example:443\"} {","+\t\tt.Run(target, func(t *testing.T) {","+\t\t\tresolver, _ := networkTestDNS(t, \"127.0.0.1\")","+\t\t\toptions := networkTestOptions(t, &types.Options{RestrictLocalNetworkAccess: true, ExcludeTargets: []string{\"8.8.8.0/24\"}, InternalResolversList: []string{resolver}})","+\t\t\t_, err := evalNetworkTest(t, fmt.Sprintf(\"jarm(%q)\", target), options)","+\t\t\tif target == \"fixture.example:443\" {","+\t\t\t\trequire.ErrorIs(t, err, fastdialer.NoAddressAllowedError)","+\t\t\t} else {","+\t\t\t\trequire.ErrorContains(t, err, \"network policy\")","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestJARMLocalNetworkMakesNoConnections(t *testing.T) {","+\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")","+\trequire.NoError(t, err)","+\tvar accepts atomic.Int32","+\tdone := make(chan struct{})","+\tgo func() {","+\t\tdefer close(done)","+\t\tfor {","+\t\t\tconn, err := listener.Accept()","+\t\t\tif err != nil {","+\t\t\t\treturn","+\t\t\t}","+\t\t\taccepts.Add(1)","+\t\t\t_ = conn.Close()","+\t\t}","+\t}()","+\tt.Cleanup(func() { _ = listener.Close(); <-done })","+\toptions := networkTestOptions(t, &types.Options{RestrictLocalNetworkAccess: true})","+\t_, err = evalNetworkTest(t, fmt.Sprintf(\"jarm(%q)\", listener.Addr().String()), options)","+\trequire.ErrorContains(t, err, \"network policy\")","+\trequire.NoError(t, listener.Close())","+\t<-done","+\trequire.Zero(t, accepts.Load())","+}","+","+type jarmTestProxy struct {","+\tcalls atomic.Int32","+\twg    sync.WaitGroup","+}","+","+func (p *jarmTestProxy) Dial(network, address string) (net.Conn, error) {","+\tp.calls.Add(1)","+\tclient, server := net.Pipe()","+\tp.wg.Add(1)","+\tgo func() {","+\t\tdefer p.wg.Done()","+\t\tdefer server.Close()","+\t\t_ = server.SetDeadline(time.Now().Add(time.Second))","+\t\tbuffer := make([]byte, 4096)","+\t\t_, _ = server.Read(buffer)","+\t}()","+\treturn client, nil","+}","+","+func networkTestProxyDialer(t *testing.T, options *types.Options) *jarmTestProxy {","+\tt.Helper()","+\tstate := protocolstate.GetDialersWithId(options.ExecutionId)","+\tcontrolledProxy := &jarmTestProxy{}","+\tvar proxyDialer proxy.Dialer = controlledProxy","+\tdialerOptions := fastdialer.DefaultOptions","+\tdialerOptions.ResolversFile = false","+\tif len(options.InternalResolversList) > 0 {","+\t\tdialerOptions.BaseResolvers = options.InternalResolversList","+\t}","+\tdialerOptions.NetworkPolicy = state.NetworkPolicy","+\tdialerOptions.ProxyDialer = &proxyDialer","+\tcontrolledDialer, err := fastdialer.NewDialer(dialerOptions)","+\trequire.NoError(t, err)","+\tstate.Fastdialer.Close()","+\tstate.Fastdialer = controlledDialer","+\tt.Cleanup(controlledProxy.wg.Wait)","+\treturn controlledProxy","+}","+","+func TestJARMAllowedUsesScanDialer(t *testing.T) {","+\tfor _, item := range []struct {","+\t\tname, address, exclude string","+\t\trestricted, denied     bool","+\t}{","+\t\t{name: \"public without lna\", address: \"8.8.8.8\"},","+\t\t{name: \"local without lna\", address: \"127.0.0.1\"},","+\t\t{name: \"public with lna\", address: \"8.8.8.8\", restricted: true},","+\t\t{name: \"local with lna\", address: \"127.0.0.1\", restricted: true, denied: true},","+\t\t{name: \"excluded IP without lna\", address: \"8.8.8.8\", exclude: \"8.8.8.8\", denied: true},","+\t\t{name: \"excluded CIDR without lna\", address: \"8.8.8.8\", exclude: \"8.8.8.0/24\", denied: true},","+\t\t{name: \"excluded with lna\", address: \"8.8.8.8\", exclude: \"8.8.8.8\", restricted: true, denied: true},