e\"},","+\t\t{`\\066LOCKED.EXAMPLE`, \"blocked.example\"},","+\t\t{`bl\\ocked.example`, \"blocked.example\"},","+\t\t{\"blocked.example.\", `^blocked\\.example\\.$`},","+\t} {","+\t\tfor _, restricted := range []bool{false, true} {","+\t\t\tt.Run(fmt.Sprintf(\"%s/%s/lna-%t\", item.host, item.exclude, restricted), func(t *testing.T) {","+\t\t\t\tresolver, queries := networkTestDNS(t, \"8.8.8.8\")","+\t\t\t\toptions := networkTestOptions(t, &types.Options{RestrictLocalNetworkAccess: restricted, ExcludeTargets: []string{item.exclude}, InternalResolversList: []string{resolver}})","+\t\t\t\tcontrolledProxy := networkTestProxyDialer(t, options)","+\t\t\t\tfor _, expression := range []string{fmt.Sprintf(\"resolve(%q)\", item.host), fmt.Sprintf(\"jarm(%q)\", net.JoinHostPort(item.host, \"443\"))} {","+\t\t\t\t\tt.Run(expression, func(t *testing.T) {","+\t\t\t\t\t\t_, err := evalNetworkTest(t, expression, options)","+\t\t\t\t\t\tcontrolledProxy.wg.Wait()","+\t\t\t\t\t\trequire.ErrorContains(t, err, \"network policy\")","+\t\t\t\t\t\trequire.Zero(t, queries.Load(), \"excluded host caused a DNS query\")","+\t\t\t\t\t\trequire.Zero(t, controlledProxy.calls.Load(), \"excluded host reached the proxy dialer\")","+\t\t\t\t\t})","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestPublicIPNetworkPolicy(t *testing.T) {","+\tfor _, item := range []struct{ name, address, exclude string }{","+\t\t{\"hostname\", \"8.8.8.8\", \"checkip.amazonaws.com\"},","+\t\t{\"uppercase hostname\", \"8.8.8.8\", \"CHECKIP.AMAZONAWS.COM\"},","+\t\t{\"IP\", \"8.8.8.8\", \"8.8.8.8\"},","+\t\t{\"CIDR\", \"8.8.8.8\", \"8.8.8.0/24\"},","+\t\t{\"private DNS answer\", \"127.0.0.1\", \"\"},","+\t} {","+\t\tt.Run(item.name, func(t *testing.T) {","+\t\t\tresolver, _ := networkTestDNS(t, item.address)","+\t\t\toptions := &types.Options{RestrictLocalNetworkAccess: true, InternalResolversList: []string{resolver}}","+\t\t\tif item.exclude != \"\" {","+\t\t\t\toptions.ExcludeTargets = []string{item.exclude}"],"