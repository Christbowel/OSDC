b5acf947aa0d3dc7d27b2e1e8eda2be8970586c3274\", size = 11050, upload-time = \"2024-12-04T17:35:26.475Z\" },"," ]"," ","+[[package]]","+name = \"smmap\"","+version = \"5.0.3\"","+source = { registry = \"https://pypi.org/simple\" }","+sdist = { url = \"https://files.pythonhosted.org/packages/1f/ea/49c993d6dfdd7338c9b1000a0f36817ed7ec84577ae2e52f890d1a4ff909/smmap-5.0.3.tar.gz\", hash = \"sha256:4d9debb8b99007ae47165abc08670bd74cb74b5227dda7f643eccc4e9eb5642c\", size = 22506, upload-time = \"2026-03-09T03:43:26.1Z\" }","+wheels = [","+    { url = \"https://files.pythonhosted.org/packages/c1/d4/59e74daffcb57a07668852eeeb6035af9f32cbfd7a1d2511f17d2fe6a738/smmap-5.0.3-py3-none-any.whl\", hash = \"sha256:c106e05d5a61449cf6ba9a1e650227ecfb141590d2a98412103ff35d89fc7b2f\", size = 24390, upload-time = \"2026-03-09T03:43:24.361Z\" },","+]","+"," [[package]]"," name = \"sqlalchemy\""," version = \"2.0.49\""],"additions":35,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli/commands/ci/__init__.py","lines":["@@ -37,7 +37,7 @@","     get_org_url,","     get_user_token,"," )","-from dagster_cloud_cli.core import pex_builder","+from dagster_cloud_cli.core import git_repo_context, pex_builder"," from dagster_cloud_cli.core.artifacts import (","     download_organization_artifact,","     upload_organization_artifact,","@@ -446,7 +446,13 @@ def init_impl(","     status_url: str | None,","     snapshot_base_condition: SnapshotBaseDeploymentCondition | None,","     require_branch_deployment: bool,","+    defs_base_path: str | None = None,"," ):","+    # Best-effort: a deploy that isn't run from a checkout reports nothing, and","+    # the server falls back to whatever binding was set by hand.","+    repo_owner, repo_name = git_repo_context.discover_repo_owner_and_name(project_dir)","+    base_branch = git_repo_context.discover_base_branch(project_dir)","+","     yaml_path = pathlib.Path(project_dir) / dagster_cloud_yaml_path","     if not yaml_path.exists():","         raise ui.error(","@@ -525,6 +531,10 @@ def init_impl(","                 git_url=git_url,","                 commit_hash=commit_hash,","                 build_config=location.build,","+                repo_owner=repo_owner,","+                repo_name=repo_name,","+                base_branch=base_branch,","+                defs_base_path=defs_base_path,","             ),","             build_output=None,","             status_url=status_url,","@@ -1233,6 +1243,10 @@ def _deploy(","             \"location_file\": location_state.location_file,","             \"git_url\": location_state.build.git_url,","             \"commit_hash\": location_state.build.commit_hash,","+            \"repo_owner\": location_state.build.repo_owner,","+            \"repo_name\": location_state.build.repo_name,","+            \"base_branch\": location_state.build.base_branch,","+            \"defs_base_path\": location_state.build.defs_base_path,","             **(","                 {\"defs_state_info\": location_state.defs_state_info.model_dump()}","                 if location_state.defs_state_info"],"additions":15,"deletions":1,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli/commands/ci/state.py","lines":["@@ -32,6 +32,13 @@ class BuildMetadata(BaseModel):","     git_url: str | None","     commit_hash: str | None","     build_config: models.Build | None  # copied from dagster_cloud.yaml","+    # Where UI-authored components belong. Written at session init and read back","+    # by ``finish`` in a separate process, so these have to live in the statedir.","+    # Default to None so a statedir written before these existed still loads.","+    repo_owner: str | None = None","+    repo_name: str | None = None","+    base_branch: str | None = None","+    defs_base_path: str | None = None"," "," "," class LocationStatus(Enum):"],"additions":7,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli/config_utils.py","lines":["@@ -495,6 +495,12 @@ def get_location_document(name: str | None, kwargs: dict[str, Any]) -> dict[str,","             \"git\": {","                 \"commit_hash\": kwargs.get(\"commit_hash\"),","                 \"url\": kwargs.get(\"git_url\"),","+                # Where this location's UI-authored components belong. Absent for","+                # deploys from CLIs that predate them.","+                \"repo_owner\": kwargs.get(\"repo_owner\"),","+                \"repo_name\": kwargs.get(\"repo_name\"),","+                \"base_branch\": kwargs.get(\"base_branch\"),","+                \"defs_base_path\": kwargs.get(\"defs_base_path\"),","             },","             \"pex_metadata\": (","                 {"],"additions":6,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli/core/git_repo_context.py","lines":["@@ -0,0 +1,126 @@","+\"\"\"Discover which repo, and which branch, a deploy is running against.","+","+Reported with the deploy so the server knows where a code location's UI-authored","+components belong. Everything here is best-effort: a deploy that isn't run from","+a checkout, or has no remote, simply reports nothing.","+\"\"\"","+","+import json","+import logging","+import os","+import re","+from typing import TYPE_CHECKING","+","+if TYPE_CHECKING:","+    from git import Repo","+","+logger = logging.getLogger(\"dagster_cloud_cli\")","+","+# git@github.com:acme/proj.git, https://github.com/acme/proj.git, ssh://git@host/acme/proj.","+# The owner may span several segments: GitLab namespaces nest (``group/subgroup``).","+_REMOTE_PATTERN = re.compile(","+    r\"^(?:[a-z+]+://[^/]+/|[^@/:]+@[^:/]+:)(?P<owner>.+)/(?P<repo>[^/]+?)(?:\\.git)?/?$\"","+)","+","+","+def _open_repo(project_dir: str) -> \"Repo | None\":","+    try:","+        # Imported lazily: GitPython raises at import time when no git binary is on PATH.","+        from git import InvalidGitRepositoryError, NoSuchPathError, Repo","+    except ImportError:","+        logger.debug(\"git is unavailable\", exc_info=True)","+        return None","+    try:","+        return Repo(project_dir, search_parent_directories=True)","+    except (InvalidGitRepositoryError, NoSuchPathError):","+        return None","+","+","+def parse_owner_and_repo(remote_url: str) -> tuple[str, str] | None:","+    \"\"\"``(owner, repo)`` from a git remote URL, or None if it isn't one.\"\"\"","+    match = _REMOTE_PATTERN.search(remote_url.strip())","+    if not match:","+        return None","+    return match.group(\"owner\"), match.group(\"repo\")","+","+","+def discover_repo_owner_and_name(project_dir: str) -> tuple[str | None, str | None]:","+    \"\"\"The owner and repo this deploy is running against.","+","+    Prefers ``GITHUB_REPOSITORY`` / ``CI_PROJECT_PATH`` (``owner/repo``), which","+    CI sets from the provider's own event rather than from anything a user typed.","+    \"\"\"","+    from_env = os.environ.get(\"GITHUB_REPOSITORY\") or os.environ.get(\"CI_PROJECT_PATH\")","+    if from_env and \"/\" in from_env:","+        owner, _, name = from_env.rpartition(\"/\")","+        return owner, name","+","+    repo = _open_repo(project_dir)","+    if repo is None:","+        return None, None","+    from git import GitCommandError","+","+    try:","+        remote = repo.remote(\"origin\").url","+    except (ValueError, GitCommandError):","+        return None, None","+    parsed = parse_owner_and_repo(remote)","+    return parsed if parsed else (None, None)","+","+","+def _github_default_branch() -> str | None:","+    \"\"\"The repo's default branch, from the GitHub Actions event payload.\"\"\"","+    event_path = os.environ.get(\"GITHUB_EVENT_PATH\")","+    if not event_path:","+        return None","+    try:","+        with open(event_path, encoding=\"utf-8\") as f:","+            return json.load(f).get(\"repository\", {}).get(\"default_branch\")","+    except (OSError, ValueError, AttributeError):","+        return None","+","+","+def discover_base_branch(project_dir: str) -> str | None:","+    \"\"\"The branch pull requests should target.","+","+    Deliberately **not** the checked-out branch: on a pull request the checkout","+    is the head branch, and recording that would point every authoring pull","+    request at a feature branch that may already be merged.","+","+    - ``GITHUB_BASE_REF`` / ``CI_MERGE_REQUEST_TARGET_BRANCH_NAME``: set only on","+      pull/merge-request runs.","+    - ``GITHUB_REF_NAME``: trusted only on a push to the default branch; on other","+      pushes, tags, or manual runs it names a feature branch or tag.","+    - ``CI_DEFAULT_BRANCH``: GitLab sets the default branch directly.","+    - Otherwise, the remote's default branch.","+    \"\"\"","+    base_ref = os.environ.get(\"GITHUB_BASE_REF\") or os.environ.get(","+        \"CI_MERGE_REQUEST_TARGET_BRANCH_NAME\"","+    )","+    if base_ref:","+        return base_ref","+","+    gitlab_default_branch = os.environ.get(\"CI_DEFAULT_BRANCH\")","+    if gitlab_default_branch:","+        return gitlab_default_branch","+","+    ref_name = os.environ.get(\"GITHUB_REF_NAME\")","+    if (","+        ref_name","+        and os.environ.get(\"GITHUB_EVENT_NAME\") == \"push\"","+        and os.environ.get(\"GITHUB_REF_TYPE\") == \"branch\"","+        and ref_name == _github_default_branch()","+    ):","+        return ref_name","+","+    repo = _open_repo(project_dir)","+    if repo is None:","+        return None","+    from git import RemoteReference, SymbolicReference","+","+    try:","+        target = SymbolicReference(repo, \"refs/remotes/origin/HEAD\").reference","+    except (TypeError, ValueError):","+        # No origin/HEAD, or it isn't symbolic.","+        return None","+    return target.remote_head if isinstance(target, RemoteReference) else None"],"additions":126,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli/core/workspace.py","lines":[],"additions":0,"deletions":0,"truncated":false}],"additions":349,"deletions":1,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-21T13:28:08.510664+00:00"}