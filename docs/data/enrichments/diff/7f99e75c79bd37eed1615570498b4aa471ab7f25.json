{"id":"7f99e75c79bd37eed1615570498b4aa471ab7f25","axis":"silent","repo":"pnpm/pnpm","sha":"7f99e75c79bd37eed1615570498b4aa471ab7f25","parsed":{"files":[{"path":".changeset/strict-ssl-local-address-in-yaml.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm now reads the `strictSsl` and `localAddress` settings from `pnpm-workspace.yaml`, the global `config.yaml`, `PNPM_CONFIG_*` environment variables, and `--config.*` options. Before, pnpm read them only from `.npmrc` as `strict-ssl` and `local-address` and ignored the other sources."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests.rs","lines":["@@ -693,6 +693,8 @@ mod paths;"," "," mod bare_flags;"," ","+mod tls_settings;","+"," /// A setting no table claims is handed to [`Config::current`], keyed by its"," /// kebab-case name whichever spelling the command line used."," #[test]"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_overrides/tests/tls_settings.rs","lines":["@@ -0,0 +1,64 @@","+use super::{","+    Config, ConfigOverrides, EnvVar, GetCurrentDir, GetHomeDir, LinkProbe, Path, PathBuf, argv,","+    assert_eq,","+};","+use pnpm_config::EnvVarOs;","+use std::ffi::OsString;","+","+/// No environment and no home directory, so only the fixture's files and","+/// the command line reach the config.","+struct NoEnv;","+","+impl EnvVar for NoEnv {","+    fn var(_: &str) -> Option<String> {","+        None","+    }","+}","+","+impl EnvVarOs for NoEnv {","+    fn var_os(_: &str) -> Option<OsString> {","+        None","+    }","+}","+","+impl GetHomeDir for NoEnv {","+    fn home_dir() -> Option<PathBuf> {","+        None","+    }","+}","+","+impl GetCurrentDir for NoEnv {","+    fn current_dir() -> std::io::Result<PathBuf> {","+        std::env::current_dir()","+    }","+}","+","+impl LinkProbe for NoEnv {","+    fn can_link_between_dirs(_: &Path, _: &Path) -> bool {","+        true","+    }","+}","+","+#[test]","+fn dotted_tls_settings_override_the_workspace_yaml() {","+    let project = tempfile::tempdir().expect(\"project tempdir\");","+    std::fs::write(","+        project.path().join(\"pnpm-workspace.yaml\"),","+        \"strictSsl: true\\nlocalAddress: 127.0.0.3\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    let (overrides, _) = ConfigOverrides::extract(argv([","+        \"pacquet\",","+        \"--config.strict-ssl=false\",","+        \"--config.localAddress=127.0.0.2\",","+        \"install\",","+    ]));","+","+    let config = Config { cli: overrides.cli_layer(None), ..Config::default() }","+        .current::<NoEnv>(project.path())","+        .expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, Some([127, 0, 0, 2].into()));","+    assert_eq!(config.package_manager_bootstrap.tls.strict_ssl, Some(false));","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay.rs","lines":["@@ -298,6 +298,8 @@ impl WorkspaceSettings {","         json_field!(settings, reader, fetch_min_speed_ki_bps, \"FETCH_MIN_SPEED_KI_BPS\");","         json_field!(settings, reader, max_tarball_unpacked_size, \"MAX_TARBALL_UNPACKED_SIZE\");","         string_field!(settings, reader, user_agent, \"USER_AGENT\");","+        json_field!(settings, reader, strict_ssl, \"STRICT_SSL\");","+        string_field!(settings, reader, local_address, \"LOCAL_ADDRESS\");","     }"," ","     fn read_scripts_env(&mut self, reader: &StringReader<'_>) {"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/loading.rs","lines":["@@ -261,8 +261,7 @@ impl Config {","         // is found — because the env-var fallback is a normalization step","         // on the resolved config, not a function of `.npmrc` presence.","         npmrc_auth.proxy.apply_proxy_cascade::<Sys>(self);","-        // TLS + local-address are sourced from `.npmrc` only — pnpm","-        // does not honor env vars (`NODE_EXTRA_CA_CERTS`,","+        // pnpm does not honor Node's TLS env vars (`NODE_EXTRA_CA_CERTS`,","         // `NODE_TLS_REJECT_UNAUTHORIZED`, etc.) for these keys","         // (Node's runtime does, but pnpm's reader does not).","         npmrc_auth.tls.apply_tls_and_local_address(self);"],"additions":1,"deletions":2,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -687,7 +687,9 @@ pub struct Config {","     pub proxy_keys: crate::proxy_keys::ProxyKeys,"," ","     /// Resolved TLS + `local-address` configuration — `ca`, `cafile`,","-    /// `cert`, `key`, `strict-ssl`, `local-address` from `.npmrc`. The","+    /// `cert`, `key`, `strict-ssl`, `local-address` from `.npmrc`, with","+    /// `strictSsl` and `localAddress` also read from the yaml settings,","+    /// the environment, and the command line. The","     /// type lives in `pnpm-network` for the same reason as","     /// [`Self::proxy`]. `strict_ssl: None` here means \"unset\"; the","     /// `true` default is applied at client-build time by"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/tests.rs","lines":["@@ -402,3 +402,5 @@ mod json_env_multiple_registries;"," mod cli_setting_values;"," "," mod includes;","+","+mod tls_settings;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/tests/tls_settings.rs","lines":["@@ -0,0 +1,143 @@","+use super::{","+    Config, EnvVar, EnvVarOs, GetCurrentDir, GetHomeDir, HostNoHome, LinkProbe, OsString, Path,","+    PathBuf, assert_eq, fs, io, tempdir, write_file,","+};","+use std::{collections::BTreeMap, net::IpAddr};","+","+const LOCAL_ADDRESS: &str = \"127.0.0.2\";","+","+fn local_address(raw: &str) -> Option<IpAddr> {","+    Some(raw.parse().expect(\"parse IP address\"))","+}","+","+#[test]","+fn workspace_yaml_supplies_strict_ssl_and_local_address() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        &format!(\"strictSsl: false\\nlocalAddress: {LOCAL_ADDRESS}\\n\"),","+    );","+","+    let config = Config::new().current::<HostNoHome>(project.path()).expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+#[test]","+fn workspace_yaml_tls_settings_override_project_npmrc() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(&project.path().join(\".npmrc\"), \"strict-ssl=true\\nlocal-address=127.0.0.3\\n\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        &format!(\"strictSsl: false\\nlocalAddress: {LOCAL_ADDRESS}\\n\"),","+    );","+","+    let config = Config::new().current::<HostNoHome>(project.path()).expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+#[test]","+fn project_npmrc_tls_settings_apply_without_yaml_ones() {","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(&project.path().join(\".npmrc\"), \"strict-ssl=false\\nlocal-address=127.0.0.3\\n\");","+    write_file(&project.path().join(\"pnpm-workspace.yaml\"), \"networkConcurrency: 2\\n\");","+","+    let config = Config::new().current::<HostNoHome>(project.path()).expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(\"127.0.0.3\"));","+}","+","+#[test]","+fn global_config_yaml_supplies_tls_settings_below_the_workspace_yaml() {","+    fake_env!(load_with_fake_env);","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(&project.path().join(\"pnpm-workspace.yaml\"), \"strictSsl: true\\n\");","+    let xdg = tempdir().expect(\"config tempdir\");","+    let config_dir = xdg.path().join(\"pnpm\");","+    fs::create_dir_all(&config_dir).expect(\"create global config dir\");","+    write_file(","+        &config_dir.join(\"config.yaml\"),","+        &format!(\"strictSsl: false\\nlocalAddress: {LOCAL_ADDRESS}\\n\"),","+    );","+","+    set_fake_env(&[(\"XDG_CONFIG_HOME\", xdg.path().to_str().unwrap())]);","+    let config = load_with_fake_env(project.path());","+","+    assert_eq!(config.tls.strict_ssl, Some(true));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+#[test]","+fn global_config_yaml_tls_settings_override_project_npmrc() {","+    fake_env!(load_with_fake_env);","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(&project.path().join(\".npmrc\"), \"strict-ssl=true\\nlocal-address=127.0.0.3\\n\");","+    let xdg = tempdir().expect(\"config tempdir\");","+    let config_dir = xdg.path().join(\"pnpm\");","+    fs::create_dir_all(&config_dir).expect(\"create global config dir\");","+    write_file(","+        &config_dir.join(\"config.yaml\"),","+        &format!(\"strictSsl: false\\nlocalAddress: {LOCAL_ADDRESS}\\n\"),","+    );","+","+    set_fake_env(&[(\"XDG_CONFIG_HOME\", xdg.path().to_str().unwrap())]);","+    let config = load_with_fake_env(project.path());","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+#[test]","+fn pnpm_config_env_tls_settings_override_the_workspace_yaml() {","+    fake_env!(load_with_fake_env);","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        \"strictSsl: true\\nlocalAddress: 127.0.0.3\\n\",","+    );","+","+    set_fake_env(&[","+        (\"PNPM_CONFIG_STRICT_SSL\", \"false\"),","+        (\"pnpm_config_local_address\", LOCAL_ADDRESS),","+    ]);","+    let config = load_with_fake_env(project.path());","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+}","+","+#[test]","+fn cli_tls_settings_override_the_environment_and_the_workspace_yaml() {","+    fake_env!();","+    let project = tempdir().expect(\"project tempdir\");","+    write_file(","+        &project.path().join(\"pnpm-workspace.yaml\"),","+        \"strictSsl: true\\nlocalAddress: 127.0.0.3\\n\",","+    );","+    set_fake_env(&[(\"PNPM_CONFIG_STRICT_SSL\", \"true\")]);","+    let cli_settings = [(\"strict-ssl\", \"false\"), (\"local-address\", LOCAL_ADDRESS)];","+","+    let config = Config {","+        cli: crate::CliLayer {","+            npmrc_tokens: cli_settings","+                .iter()","+                .map(|&(key, value)| (key.to_string(), value.to_string()))","+                .collect(),","+            setting_values: cli_settings","+                .iter()","+                .map(|&(key, value)| (key.to_string(), value.to_string()))","+                .collect::<BTreeMap<_, _>>(),","+            ..crate::CliLayer::default()","+        },","+        ..Config::default()","+    }","+    .current::<FakeEnv>(project.path())","+    .expect(\"load config\");","+","+    assert_eq!(config.tls.strict_ssl, Some(false));","+    assert_eq!(config.tls.local_address, local_address(LOCAL_ADDRESS));","+}"],"additions":143,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/apply.rs","lines":["@@ -186,6 +186,7 @@ impl WorkspaceSettings {"," ","     /// Registry endpoints, their credentials, and the caches keyed by them.","     pub(super) fn apply_registry_settings(&mut self, config: &mut Config) {","+        self.apply_tls_to(&mut config.tls);","         let declared_prefixes = self.apply_registry_declarations(config);","         if let Some(v) = self.registry.take() {","             config.registry = normalize_registry_url(&v).into_owned();","@@ -438,6 +439,15 @@ impl WorkspaceSettings {","         overlay_some(&mut config.audit_ignore_prune, audit.ignore_prune);","     }"," ","+    /// An invalid `localAddress` clears the one a lower source set, as","+    /// it does between `.npmrc` layers.","+    fn apply_tls_to(&mut self, tls: &mut pnpm_network::TlsConfig) {","+        overlay_some(&mut tls.strict_ssl, self.strict_ssl.take());","+        if let Some(local_address) = self.local_address.take() {","+            tls.local_address = local_address.parse().ok();","+        }","+    }","+","     /// Overlay this file's proxy keys onto the merged view and re-resolve.","     ///","     /// A key named here occupies it even when the value reads as unset —"],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/env.rs","lines":["@@ -113,6 +113,7 @@ impl WorkspaceSettings {","         substitute_optional_string::<Sys>(&mut self.lockfile_dir);","         substitute_optional_string::<Sys>(&mut self.patches_dir);","         substitute_optional_string::<Sys>(&mut self.cache_dir);","+        substitute_optional_string::<Sys>(&mut self.local_address);","         substitute_optional_inner_string::<Sys>(&mut self.script_shell);","         substitute_optional_inner_string::<Sys>(&mut self.node_options);","     }"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/reset.rs","lines":["@@ -92,6 +92,19 @@ fn reset_proxy_setting(config: &mut Config, defaults: &Config, key: &str) {","     config.proxy = config.proxy_keys.resolve();"," }"," ","+fn reset_audit_settings(config: &mut Config, defaults: &Config) {","+    config.audit_level = defaults.audit_level;","+    config.audit_config.clone_from(&defaults.audit_config);","+    config.audit_ignore_prune = defaults.audit_ignore_prune;","+}","+","+fn reset_tls_setting(config: &mut Config, defaults: &Config, key: &str) {","+    match key {","+        \"strictSsl\" => config.tls.strict_ssl = defaults.tls.strict_ssl,","+        _ => config.tls.local_address = defaults.tls.local_address,","+    }","+}","+"," /// Leave `virtualStoreOnly` mode with the hoist patterns the mode"," /// snapshotted, a pattern a source explicitly disabled included, unless a"," /// source still sets a pattern, and with the derivations that read the","@@ -268,11 +281,8 @@ impl WorkspaceSettings {","             \"httpsProxy\" | \"httpProxy\" | \"proxy\" | \"noProxy\" | \"noproxy\" => {","                 reset_proxy_setting(config, defaults, key);","             }","-            \"audit\" | \"auditLevel\" | \"auditConfig\" => {","-                config.audit_level = defaults.audit_level;","-                config.audit_config.clone_from(&defaults.audit_config);","-                config.audit_ignore_prune = defaults.audit_ignore_prune;","-            }","+            \"strictSsl\" | \"localAddress\" => reset_tls_setting(config, defaults, key),","+            \"audit\" | \"auditLevel\" | \"auditConfig\" => reset_audit_settings(config, defaults),","             \"update\" | \"updateConfig\" => config.update_config.clone_from(&defaults.update_config),","             \"cleanupUnusedCatalogs\" => config.catalog_prune = defaults.catalog_prune,","             \"virtualStoreType\" => {"],"additions":15,"deletions":5,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/resolved.rs","lines":["@@ -262,6 +262,8 @@ impl WorkspaceSettings {","                         serde_json::Value::String(hosts.join(\",\"))","                     }","                 }),","+            strict_ssl: config.tls.strict_ssl,","+            local_address: config.tls.local_address.map(|address| address.to_string()),"," ","             // `audit` and `update` are the canonical spellings, so the","             // deprecated `auditLevel`, `auditConfig`, and `updateConfig`"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/settings.rs","lines":["@@ -317,6 +317,8 @@ pub struct WorkspaceSettings {","     pub no_proxy: Option<serde_json::Value>,","     pub proxy: Option<String>,","     pub noproxy: Option<serde_json::Value>,","+    pub strict_ssl: Option<bool>,","+    pub local_address: Option<String>,"," ","     /// User-defined named-registry aliases. Outer key is the alias","     /// name (`gh`, `work`, ...); inner string is the registry URL the"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/configuration_from_resolved_reports_every.rs","lines":["@@ -79,6 +79,11 @@ fn from_resolved_reports_every_setting() {","             http_proxy: Some(\"http://proxy.example\".to_string()),","             no_proxy: Some(pnpm_network::NoProxySetting::List(vec![\"example.com\".to_string()])),","         },","+        tls: pnpm_network::TlsConfig {","+            strict_ssl: Some(false),","+            local_address: Some([127, 0, 0, 2].into()),","+            ..pnpm_network::TlsConfig::default()","+        },","         update_config: UpdateConfig { changeset: Some(true), ..UpdateConfig::default() },","         // The settings that report as written, rather than as resolved.","         explicit_settings: ["],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/network/src/tls.rs","lines":["@@ -4,7 +4,8 @@"," //! [`TlsConfig`] holds the resolved `(ca, client_identity_pem, strict_ssl,"," //! local_address)` quadruple. Built by `pnpm-config` from the"," //! `.npmrc` keys `ca`, `cafile`, `cert`, `key`, `strict-ssl`, and","-//! `local-address`. Lives in `pnpm-network` for the same reason","+//! `local-address`, and from the `strictSsl` and `localAddress`","+//! settings. Lives in `pnpm-network` for the same reason"," //! [`crate::ProxyConfig`] does."," //!"," //! Parity policy: pnpm performs no PEM parsing in user-space (PEM",""],"additions":2,"deletions":1,"truncated":false}],"additions":259,"deletions":9,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-10-24T12:58:48.927282+00:00"}