{"id":"afb35f85e7e25720a9acb656d0b20b20d33ffcd0","axis":"silent","repo":"vllm-project/vllm","sha":"afb35f85e7e25720a9acb656d0b20b20d33ffcd0","parsed":{"files":[{"path":"docs/features/sleep_mode.md","lines":["@@ -291,6 +291,27 @@ curl -X POST 'http://localhost:8000/wake_up?tags=kv_cache'"," !!! note","     These endpoints are only available when passing `VLLM_SERVER_DEV_MODE=1`."," ","+## Custom model loaders","+","+A custom `BaseModelLoader` can react to sleep and wake-up by overriding three optional methods. All keep today's behavior by default, so existing loaders are unaffected. For example, a loader that serves weights to other processes over RDMA directly from GPU memory must stop serving before that memory is freed.","+","+| Method | Called | Default |","+| --- | --- | --- |","+| `on_sleep(level)` | Before `Worker.sleep(level)` frees GPU memory. Pause anything that reads that memory. | No-op |","+| `on_wake_up(tags)` | After `Worker.wake_up(tags)` returns. | No-op |","+| `reload_model(vllm_config, model_config, model, *, is_checkpoint_format)` | From `reload_weights()`, when no weights are passed. | `get_all_weights()` + `model.load_weights()` |","+","+What the weights contain when `on_wake_up` runs for a wake-up that includes them (`tags` is `None` or contains `\"weights\"`) depends on the sleep level:","+","+| Sleep level | Weights in `on_wake_up` | When to resume |","+| --- | --- | --- |","+| 1 | Restored and valid | In `on_wake_up` |","+| 2 | Discarded; memory is re-allocated but empty | After `reload_model` completes |","+","+The hooks go to the loader instance that loaded the model, which records itself in `BaseModelLoader.load_model()`. A loader that overrides `load_model()` must call `bind_model_loader(model, self)` to receive them. When a loader overrides `reload_model`, `reload_weights()` reuses that same instance, so state kept across `on_sleep` and `on_wake_up` sees the reload. Loaders that keep the default get a fresh instance, as before.","+","+See the docstrings on `BaseModelLoader` for the exact contract.","+"," ## Limitation"," "," On ROCm, the virtual memory allocation on ROCm is done through chunked memory allocation. You can control the chunk size through `VLLM_ROCM_SLEEP_MEM_CHUNK_SIZE` (in MB). The default value is set at 256MB. The larger the chunk size the faster the performance. However, setting it too large will cause OOM. So if you encounter OOM when using sleep mode. Try reducing the chunk size. It is recommended to define the chunk size as a power of 2."],"additions":21,"deletions":0,"truncated":false},{"path":"tests/model_executor/model_loader/test_modelexpress_loader.py","lines":["@@ -3,10 +3,12 @@"," "," import sys"," from types import ModuleType, SimpleNamespace","+from unittest.mock import Mock"," "," import pytest"," from torch import nn"," ","+import vllm.model_executor.model_loader.reload.inplace as reload_inplace_module"," from vllm.config import VllmConfig"," from vllm.config.load import LoadConfig"," from vllm.model_executor.model_loader import get_model_loader","@@ -32,6 +34,32 @@ def load_model(self, *args, **kwargs):","         self.calls.append((\"load_model\", args, kwargs))","         return self.loaded_model"," ","+    def on_sleep(self, *args, **kwargs):","+        self.calls.append((\"on_sleep\", args, kwargs))","+","+    def on_wake_up(self, *args, **kwargs):","+        self.calls.append((\"on_wake_up\", args, kwargs))","+","+    def reload_model(self, *args, **kwargs):","+        self.calls.append((\"reload_model\", args, kwargs))","+        return kwargs[\"model\"]","+","+","+class FakeModelexpressLoaderWithoutSleepHooks:","+    \"\"\"Mimics an older modelexpress install without the lifecycle hooks.\"\"\"","+","+    def __init__(self, load_config: LoadConfig):","+        self.load_config = load_config","+","+    def download_model(self, *args, **kwargs):","+        pass","+","+    def load_weights(self, *args, **kwargs):","+        pass","+","+    def load_model(self, *args, **kwargs):","+        pass","+"," "," def _install_fake_modelexpress(monkeypatch):","     FakeModelexpressLoader.calls = []","@@ -90,6 +118,80 @@ def test_modelexpress_loader_delegates_to_modelexpress(monkeypatch):","     ]"," "," ","+def test_modelexpress_loader_delegates_sleep_hooks(monkeypatch):","+    _install_fake_modelexpress(monkeypatch)","+    loader = ModelExpressModelLoader(LoadConfig(load_format=\"modelexpress\"))","+","+    loader.on_sleep(1)","+    loader.on_wake_up([\"weights\"])","+","+    assert FakeModelexpressLoader.calls == [","+        (\"on_sleep\", (1,), {}),","+        (\"on_wake_up\", ([\"weights\"],), {}),","+    ]","+","+","+def test_modelexpress_loader_tolerates_missing_sleep_hooks(monkeypatch):","+    _install_fake_modelexpress(monkeypatch)","+    module = sys.modules[\"modelexpress.engines.vllm.loader\"]","+    module.__dict__[\"MxModelLoader\"] = FakeModelexpressLoaderWithoutSleepHooks","+    loader = ModelExpressModelLoader(LoadConfig(load_format=\"modelexpress\"))","+","+    loader.on_sleep(1)","+    loader.on_wake_up([\"weights\"])","+","+","+def test_modelexpress_loader_reloads_through_modelexpress(monkeypatch):","+    _install_fake_modelexpress(monkeypatch)","+    loader = ModelExpressModelLoader(LoadConfig(load_format=\"modelexpress\"))","+    model = nn.Module()","+    model_config = SimpleNamespace()","+    vllm_config = SimpleNamespace()","+","+    loader.reload_model(vllm_config, model_config, model)","+","+    assert FakeModelexpressLoader.calls == [","+        (","+            \"reload_model\",","+            (),","+            {\"vllm_config\": vllm_config, \"model_config\": model_config, \"model\": model},","+        ),","+    ]","+","+","+def test_reload_weights_reuses_loader_that_loaded_model(monkeypatch):","+    \"\"\"ModelExpress keeps sleep state on the loader instance, so the reload","+    after a level-2 sleep must reach the instance that got `on_sleep`.\"\"\"","+    _install_fake_modelexpress(monkeypatch)","+    load_config = LoadConfig(load_format=\"modelexpress\")","+    loader = ModelExpressModelLoader(load_config)","+    vllm_config = SimpleNamespace(load_config=load_config, model_config=None)","+    model = loader.load_model(vllm_config=vllm_config, model_config=None)","+    monkeypatch.setattr(","+        reload_inplace_module, \"get_model_loader\", Mock(side_effect=AssertionError)","+    )","+","+    reload_inplace_module.reload_weights(","+        vllm_config,","+        model,","+        weights_iterator=None,","+        weights_path=None,","+        is_checkpoint_format=True,","+    )","+","+    assert FakeModelexpressLoader.calls[-1][0] == \"reload_model\"","+","+","+def test_modelexpress_loader_without_reload_model_falls_back(monkeypatch):","+    _install_fake_modelexpress(monkeypatch)","+    module = sys.modules[\"modelexpress.engines.vllm.loader\"]","+    module.__dict__[\"MxModelLoader\"] = FakeModelexpressLoaderWithoutSleepHooks","+    loader = ModelExpressModelLoader(LoadConfig(load_format=\"modelexpress\"))","+","+    with pytest.raises(NotImplementedError, match=\"iterating weights\"):","+        loader.reload_model(SimpleNamespace(), SimpleNamespace(), nn.Module())","+","+"," def test_modelexpress_loader_missing_modelexpress_error(monkeypatch):","     import importlib"," "],"additions":102,"deletions":0,"truncated":false},{"path":"tests/model_executor/model_loader/test_registry.py","lines":["@@ -170,3 +170,52 @@ def __init__(self):","     weights = [(\"experts.w13_weight\", torch.zeros(2, 8, 4))]","     loaded = AutoWeightsLoader(model).load_weights(weights)","     assert loaded == {\"experts.routed_experts.w13_weight\"}","+","+","+def test_custom_loader_reload_reaches_the_loader_that_loaded_the_model(monkeypatch):","+    \"\"\"`BaseModelLoader.load_model` records the loader, so a loader overriding","+    `reload_model` gets the reload of the model it loaded, keeping any state","+    it holds across sleep and wake-up.\"\"\"","+    from types import SimpleNamespace","+","+    import vllm.model_executor.model_loader as model_loader_module","+    import vllm.model_executor.model_loader.base_loader as base_loader_module","+    import vllm.model_executor.model_loader.reload.inplace as reload_inplace_module","+","+    class ReloadingModelLoader(CustomModelLoader):","+        reloaded: nn.Module | None = None","+","+        def create_model(self, vllm_config, model_config, prefix=\"\"):","+            return nn.Linear(2, 2)","+","+        def reload_model(self, vllm_config, model_config, model, **kwargs):","+            self.reloaded = model","+","+    monkeypatch.setitem(","+        model_loader_module._LOAD_FORMAT_TO_MODEL_LOADER,","+        \"reloading_load_format\",","+        ReloadingModelLoader,","+    )","+    monkeypatch.setattr(","+        base_loader_module, \"process_weights_after_loading\", lambda *args: None","+    )","+    load_config = LoadConfig(load_format=\"reloading_load_format\")","+    vllm_config = SimpleNamespace(","+        device_config=SimpleNamespace(device=\"cpu\"),","+        load_config=load_config,","+        model_config=SimpleNamespace(dtype=torch.float32),","+        quant_config=None,","+    )","+    loader = get_model_loader(load_config)","+    assert isinstance(loader, ReloadingModelLoader)","+    model = loader.load_model(vllm_config, vllm_config.model_config)","+","+    reload_inplace_module.reload_weights(","+        vllm_config,","+        model,","+        weights_iterator=None,","+        weights_path=None,","+        is_checkpoint_format=True,","+    )","+","+    assert loader.reloaded is model"],"additions":49,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_gpu_model_runner.py","lines":["@@ -1,17 +1,25 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+from functools import partial"," from types import SimpleNamespace"," from unittest.mock import Mock"," "," import pytest"," import torch","+from torch import nn"," "," import vllm.model_executor.model_loader.reload.inplace as reload_inplace_module","+from vllm.config.load import LoadConfig"," from vllm.lora.layers import LoRAMappingType"," from vllm.lora.request import LoRARequest"," from vllm.model_executor.layers.attention import Attention"," from vllm.model_executor.layers.mamba.abstract import MambaBase","+from vllm.model_executor.model_loader.base_loader import (","+    BaseModelLoader,","+    bind_model_loader,","+)","+from vllm.model_executor.model_loader.default_loader import DefaultModelLoader"," from vllm.multimodal.inputs import (","     MultiModalFeatureSpec,","     MultiModalKwargsItem,","@@ -490,6 +498,7 @@ def test_reload_weights_path_replaces_object_storage_source(monkeypatch):","     # silently re-streams the original checkpoint.","     loader = Mock()","     loader.get_all_weights.return_value = iter(())","+    loader.reload_model.side_effect = partial(BaseModelLoader.reload_model, loader)","     monkeypatch.setattr(reload_inplace_module, \"get_model_loader\", lambda _: loader)","     monkeypatch.setattr(reload_inplace_module, \"start_reload\", Mock())","     monkeypatch.setattr(reload_inplace_module, \"finish_reload\", Mock())","@@ -525,6 +534,26 @@ def load_weights(self, weights):","     assert (cfg.model, cfg.model_weights, cfg.revision) == (\"org/new-model\", \"\", None)"," "," ","+def test_reload_weights_uses_fresh_generic_loader(monkeypatch):","+    \"\"\"A loader without its own `reload_model` keeps per-load state (e.g. EP","+    expert filters) that must not leak into a reload.\"\"\"","+    load_config = LoadConfig(load_format=\"auto\")","+    model = nn.Module()","+    bind_model_loader(model, DefaultModelLoader(load_config))","+    fresh = Mock()","+    monkeypatch.setattr(reload_inplace_module, \"get_model_loader\", lambda _: fresh)","+","+    reload_inplace_module.reload_weights(","+        SimpleNamespace(load_config=load_config, model_config=SimpleNamespace()),","+        model,","+        weights_iterator=None,","+        weights_path=None,","+        is_checkpoint_format=True,","+    )","+","+    fresh.reload_model.assert_called_once()","+","+"," def test_init_kv_cache_with_kv_sharing_invalid_target_layer_order(default_vllm_config):","     torch.set_default_dtype(torch.float16)","     layer_0 = \"model.layers.0.self_attn.attn\""],"additions":29,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_gpu_worker.py","lines":["@@ -1110,6 +1110,34 @@ def test_discarding_the_kv_cache_releases_an_extensible_one(","     assert log == [\"release\", \"pool\", \"pool\"]"," "," ","+def test_shutdown_frees_a_model_whose_loader_references_it():","+    \"\"\"A loader such as ModelExpress keeps a reference to the model it loaded.","+    Shutdown must drop the model-to-loader binding, or that model and its","+    memory outlive an engine that ran in-process.\"\"\"","+    import weakref","+","+    from torch import nn","+","+    from vllm.model_executor.model_loader.base_loader import bind_model_loader","+    from vllm.v1.worker.gpu_worker import Worker","+","+    model = nn.Module()","+    bind_model_loader(model, SimpleNamespace(model=model))","+    worker = object.__new__(Worker)","+    worker.profiler = None","+    worker.elastic_ep_executor = SimpleNamespace(shutdown=lambda: None)","+    worker.model_runner = SimpleNamespace(","+        model=model, eplb_state=None, shutdown=lambda: None","+    )","+","+    worker.shutdown()","+    model_ref = weakref.ref(model)","+    del model, worker","+    gc.collect()","+","+    assert model_ref() is None","+","+"," @create_new_process_for_each_test(\"spawn\")"," def test_startup_heap_frozen_before_weight_loading(monkeypatch):","     \"\"\"Ensure objects alive before startup are frozen by the time weights"],"additions":28,"deletions":0,"truncated":false},{"path":"tests/v1/worker/test_sleep_mode_backend.py","lines":["@@ -40,9 +40,13 @@ def test_new_backend_starts_in_running_state():"," "," @pytest.mark.parametrize(\"enable_nccl_comm_suspend\", [True, False])"," def test_worker_drives_communicator_suspension(monkeypatch, enable_nccl_comm_suspend):","-    \"\"\"Comm walkers run around sleep/wake only when explicitly enabled.\"\"\"","+    \"\"\"Comm walkers run around sleep/wake only when explicitly enabled. The","+    model's loader is told before memory is freed and after it is restored.\"\"\"","     from types import SimpleNamespace"," ","+    from torch import nn","+","+    from vllm.model_executor.model_loader.base_loader import bind_model_loader","     from vllm.v1.worker.gpu_worker import Worker"," ","     calls: list[tuple[str, object]] = []","@@ -56,7 +60,15 @@ def resume(self, tags: list[str] | None = None) -> None:"," ","     worker = object.__new__(Worker)","     worker._sleep_mode_backend = Backend()","-    worker.model_runner = SimpleNamespace(extensible_kv_cache=None)","+    model = nn.Module()","+    bind_model_loader(","+        model,","+        SimpleNamespace(","+            on_sleep=lambda level: calls.append((\"loader.on_sleep\", level)),","+            on_wake_up=lambda tags: calls.append((\"loader.on_wake_up\", tuple(tags))),","+        ),","+    )","+    worker.model_runner = SimpleNamespace(extensible_kv_cache=None, model=model)","     worker.vllm_config = SimpleNamespace(","         model_config=SimpleNamespace(enable_nccl_comm_suspend=enable_nccl_comm_suspend)","     )","@@ -76,10 +88,12 @@ def resume(self, tags: list[str] | None = None) -> None:","     worker.wake_up(tags=[\"weights\"])"," ","     expected: list[tuple[str, object]] = [","+        (\"loader.on_sleep\", 1),","         (\"backend.suspend\", set()),","         (\"comms.suspend\", None),","         (\"backend.resume\", (\"weights\",)),","         (\"comms.resume\", None),","+        (\"loader.on_wake_up\", (\"weights\",)),","     ]","     if not enable_nccl_comm_suspend:","         expected = [c for c in expected if not c[0].startswith(\"comms.\")]"],"additions":16,"deletions":2,"truncated":false},{"path":"vllm/model_executor/model_loader/__init__.py","lines":["@@ -8,7 +8,10 @@"," from vllm.config import ModelConfig, VllmConfig"," from vllm.config.load import LoadConfig"," from vllm.logger import init_logger","-from vllm.model_executor.model_loader.base_loader import BaseModelLoader","+from vllm.model_executor.model_loader.base_loader import (","+    BaseModelLoader,","+    bind_model_loader,","+)"," from vllm.model_executor.model_loader.default_loader import DefaultModelLoader"," from vllm.model_executor.model_loader.dummy_loader import DummyModelLoader"," from vllm.model_executor.model_loader.modelexpress_loader import (","@@ -125,12 +128,17 @@ def _wrapper(model_loader_cls):","     return _wrapper"," "," ","-def get_model_loader(load_config: LoadConfig) -> BaseModelLoader:","-    \"\"\"Get a model loader based on the load format.\"\"\"","+def get_model_loader_cls(load_config: LoadConfig) -> type[BaseModelLoader]:","+    \"\"\"Get the model loader class for the load format.\"\"\"","     load_format = load_config.load_format","     if load_format not in _LOAD_FORMAT_TO_MODEL_LOADER:","         raise ValueError(f\"Load format `{load_format}` is not supported\")","-    return _LOAD_FORMAT_TO_MODEL_LOADER[load_format](load_config)","+    return _LOAD_FORMAT_TO_MODEL_LOADER[load_format]","+","+","+def get_model_loader(load_config: LoadConfig) -> BaseModelLoader:","+    \"\"\"Get a model loader based on the load format.\"\"\"","+    return get_model_loader_cls(load_config)(load_config)"," "," "," def get_model(","@@ -149,8 +157,10 @@ def get_model("," "," "," __all__ = [","+    \"bind_model_loader\",","     \"get_model\",","     \"get_model_loader\",","+    \"get_model_loader_cls\",","     \"get_architecture_class_name\",","     \"get_model_architecture\",","     \"get_model_cls\","],"additions":14,"deletions":4,"truncated":false},{"path":"vllm/model_executor/model_loader/base_loader.py","lines":["@@ -4,6 +4,7 @@"," import time"," from abc import ABC, abstractmethod"," from collections.abc import Generator","+from weakref import WeakKeyDictionary"," "," import torch"," import torch.nn as nn","@@ -52,6 +53,54 @@ def load_weights(self, model: nn.Module, model_config: ModelConfig) -> None:","         inplace weights loading for an already-initialized model\"\"\"","         raise NotImplementedError"," ","+    def on_sleep(self, level: int) -> None:  # noqa: B027","+        \"\"\"Called before `Worker.sleep(level)` frees the GPU memory holding","+        the weights of the model this loader loaded.","+","+        No-op by default. Override to release or pause any external state","+        that depends on that memory remaining valid before it becomes","+        invalid.","+        \"\"\"","+","+    def on_wake_up(self, tags: list[str] | None) -> None:  # noqa: B027","+        \"\"\"Called after `Worker.wake_up(tags)` returns.","+","+        No-op by default. Override to resume whatever `on_sleep` paused.","+        `tags` is the same argument `wake_up` was called with; the weights","+        are woken only when it is `None` or includes `\"weights\"`. Once woken","+        after a level-1 sleep, the weights are valid here. After a level-2","+        sleep they are not: they only become valid once the `reload_model`","+        call that follows has completed.","+        \"\"\"","+","+    def reload_model(","+        self,","+        vllm_config: VllmConfig,","+        model_config: ModelConfig,","+        model: nn.Module,","+        *,","+        is_checkpoint_format: bool = True,","+    ) -> None:","+        \"\"\"Reload `model`'s weights in place from this loader's source.","+","+        Used by `reload_weights()` when no weights are provided. After a","+        level-2 sleep this is the point where weights become valid again.","+        The default streams `get_all_weights()` through the generic in-place","+        reload. Loaders that write final weights into the model themselves","+        override it; the instance that loaded `model` is then reused, so","+        state it keeps across `on_sleep`/`on_wake_up` sees the reload.","+        \"\"\"","+        from vllm.model_executor.model_loader.reload.inplace import (","+            reload_weights_from_iterator,","+        )","+","+        reload_weights_from_iterator(","+            vllm_config,","+            model,","+            self.get_all_weights(model_config, model),","+            is_checkpoint_format,","+        )","+","     def create_model(","         self, vllm_config: VllmConfig, model_config: ModelConfig, prefix: str = \"\"","     ) -> nn.Module:","@@ -138,7 +187,29 @@ def load_model(","             gc.collect()","             torch.accelerator.empty_cache()"," ","-        return model.eval()","+        model = model.eval()","+        bind_model_loader(model, self)","+        return model","+","+","+_MODEL_LOADERS: WeakKeyDictionary[nn.Module, BaseModelLoader] = WeakKeyDictionary()","+","+","+def bind_model_loader(model: nn.Module, loader: BaseModelLoader) -> None:","+    \"\"\"Record `loader` as the loader that loaded `model`.\"\"\"","+    _MODEL_LOADERS[model] = loader","+","+","+def get_bound_model_loader(model: nn.Module | None) -> BaseModelLoader | None:","+    \"\"\"Return the loader that loaded `model`, if it was recorded.\"\"\"","+    return None if model is None else _MODEL_LOADERS.get(model)","+","+","+def unbind_model_loader(model: nn.Module | None) -> None:","+    \"\"\"Forget the loader recorded for `model`. A loader that references its","+    model keeps the entry, and so the model, alive until this is called.\"\"\"","+    if model is not None:","+        _MODEL_LOADERS.pop(model, None)"," "," "," def log_model_inspection(model: nn.Module) -> None:"],"additions":72,"deletions":1,"truncated":false},{"path":"vllm/model_executor/model_loader/modelexpress_loader.py","lines":["@@ -9,7 +9,10 @@"," "," from vllm.config import ModelConfig, VllmConfig"," from vllm.config.load import LoadC