{"id":"bc4dd45a87992a61c5cecbbf7d025c80943839b6","axis":"silent","repo":"pnpm/pnpm","sha":"bc4dd45a87992a61c5cecbbf7d025c80943839b6","parsed":{"files":[{"path":".changeset/global-add-summary-every-group.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add -g` with several space-separated packages now lists every installed package in its summary. Only the packages of the first one were listed."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/global-packages-config-auth.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add -g`, `pnpm update -g`, and `pnpm outdated -g` now use the `_auth` and `npmrcAuthFile` settings under `globalPackagesConfig` in the global `config.yaml`."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/global-top-level-allow-all-builds.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Commands that act on global packages, such as `pnpm add -g`, now honor `dangerouslyAllowAllBuilds` set at the top level of the global `config.yaml`. pnpm ignored it for global packages unless it was set under `globalPackagesConfig`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global.rs","lines":["@@ -308,16 +308,8 @@ pub async fn handle_global_add<Reporter: self::Reporter + 'static>(","         global_pkg_dir: &global_pkg_dir,","         global_bin_dir: &global_bin_dir,","     };","-    for group in groups {","-        target.add_group::<Reporter>(","-            &group,","-            range_spec_style,","-            supported_architectures.clone(),","-            allow_build,","-        )","-        .await?;","-    }","-    Ok(())","+    target.add_groups::<Reporter>(&groups, range_spec_style, supported_architectures, allow_build)","+        .await"," }"," "," /// `pnpm update -g`. Reinstalls each matching group (within its existing","@@ -449,6 +441,11 @@ fn emit_global_update_result<Reporter: self::Reporter>(global_pkg_dir: &Path, up","             prefix: String::new(),","         }));","     }","+    emit_global_summary::<Reporter>(global_pkg_dir);","+}","+","+/// Close a global command that installs several groups with one summary.","+fn emit_global_summary<Reporter: self::Reporter>(global_pkg_dir: &Path) {","     let prefix = global_pkg_dir.to_string_lossy().into_owned();","     Reporter::emit(&LogEvent::Summary(SummaryLog {","         level: LogLevel::Debug,"],"additions":7,"deletions":10,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/build_policy.rs","lines":["@@ -27,8 +27,9 @@ pub(super) fn global_approval_store<'a>("," }"," "," /// Complete `cfg`'s build policy for a global group. The loader already","-/// applied `globalPackagesConfig`, the environment, and the command line, in","-/// that order, and dropped the policy of the layers below them. Beneath those","+/// applied the top level of `config.yaml`, `globalPackagesConfig`, the","+/// environment, and the command line, in that order, and dropped the policy","+/// of the workspace layer. Beneath those"," /// come the decisions this command recorded since `cfg` was loaded, which an"," /// earlier group may have moved there, then the legacy decisions of the"," /// global packages directory's `pnpm-workspace.yaml`."],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/global/groups.rs","lines":["@@ -29,6 +29,7 @@ use super::{","     create_global_cache_key,","     create_install_dir,","     discard_install_dir_on_error,","+    emit_global_summary,","     fs,","     get_actual_bin_names,","     get_hash_link,","@@ -55,6 +56,33 @@ use pnpm_modules_yaml::{"," };"," "," impl GlobalInstallTarget<'_> {","+    /// Install each `add -g` group in turn, stopping at the first that fails.","+    /// The reporter prints only the first summary, so the groups close with","+    /// one summary that lists the packages of all of them. A failed command","+    /// prints none: a group that fails activation has already reported its","+    /// packages as added.","+    pub(super) async fn add_groups<Reporter: self::Reporter + 'static>(","+        &self,","+        groups: &[Vec<String>],","+        range_spec_style: RangeSpecStyle,","+        supported_architectures: Option<SupportedArchitectures>,","+        allow_build: &[String],","+    ) -> miette::Result<()> {","+        let filter = EventFilter::GlobalUpdateMaterialization.apply();","+        for group in groups {","+            self.add_group::<Reporter>(","+                group,","+                range_spec_style,","+                supported_architectures.clone(),","+                allow_build,","+            )","+            .await?;","+        }","+        drop(filter);","+        emit_global_summary::<Reporter>(self.global_pkg_dir);","+        Ok(())","+    }","+","     /// Install one `add -g` group and activate it over the groups it","     /// replaces.","     pub(super) async fn add_group<Reporter: self::Reporter + 'static>("],"additions":28,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/reporter.rs","lines":["@@ -235,7 +235,8 @@ pub(crate) enum EventFilter {","     /// The lockfile-only comparison pass: hide the install-tree events and the","     /// terminal \"Already up to date\".","     GlobalUpdateResolution = 1,","-    /// A materializing pass: `update -g` prints one summary of its own.","+    /// A materializing pass: `add -g` and `update -g` print one summary of","+    /// their own.","     GlobalUpdateMaterialization = 2,","     /// Work that runs quietly regardless of `--reporter`, such as provisioning","     /// the pnpm version a project pins."],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global.rs","lines":["@@ -285,6 +285,66 @@ fn global_add_list_remove_round_trip() {","     drop(root);"," }"," ","+#[cfg(unix)]","+#[test]","+fn global_add_of_several_groups_summarizes_every_group() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let pnpm_home = root.path().join(\"pnpm-home\");","+    prepare_global_home(&pnpm_home, &npmrc_info);","+","+    let output = without_colors(global_command(&workspace, &pnpm_home))","+        .with_args([\"add\", \"-g\", \"is-positive\", \"is-negative\"])","+        .output()","+        .expect(\"run add -g\");","+","+    let stdout = String::from_utf8_lossy(&output.stdout);","+    assert!(output.status.success(), \"add -g failed: {stdout}\");","+    assert!(stdout.contains(\"+ is-positive\"), \"{stdout}\");","+    assert!(stdout.contains(\"+ is-negative\"), \"{stdout}\");","+","+    drop(npmrc_info);","+    drop(root);","+}","+","+#[cfg(unix)]","+#[test]","+fn global_add_prints_no_summary_when_a_group_fails_activation() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let pnpm_home = root.path().join(\"pnpm-home\");","+    prepare_global_home(&pnpm_home, &npmrc_info);","+    let selectors = [\"alpha\", \"beta\"].map(|name| {","+        let dir = root.path().join(name);","+        fs::create_dir_all(&dir).expect(\"create package dir\");","+        fs::write(","+            dir.join(\"package.json\"),","+            serde_json::json!({ \"name\": name, \"version\": \"1.0.0\", \"bin\": { \"shared-tool\": \"cli.js\" } })","+                .to_string(),","+        )","+        .expect(\"write manifest\");","+        fs::write(dir.join(\"cli.js\"), \"#!/usr/bin/env node\\n\").expect(\"write bin\");","+        format!(\"file:{}\", dir.display())","+    });","+","+    let output = without_colors(global_command(&workspace, &pnpm_home))","+        .with_arg(\"add\")","+        .with_arg(\"-g\")","+        .with_args(&selectors)","+        .output()","+        .expect(\"run add -g\");","+","+    let stdout = String::from_utf8_lossy(&output.stdout);","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(!output.status.success(), \"add -g should fail: {stdout}\");","+    assert!(stderr.contains(\"ERR_PNPM_GLOBAL_BIN_CONFLICT\"), \"{stderr}\");","+    assert!(!stdout.contains(\"+ alpha\"), \"{stdout}\");","+    assert!(!stdout.contains(\"+ beta\"), \"{stdout}\");","+","+    drop(npmrc_info);","+    drop(root);","+}","+"," /// A mutating global command must create a missing global bin directory"," /// instead of failing `ERR_PNPM_PNPM_DIR_NOT_WRITABLE`, pnpm's config"," /// reader runs `mkdir -p` on the bin dir for every `--global` command. A"],"additions":60,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/auth_sources.rs","lines":["@@ -1,3 +1,5 @@","+use std::borrow::Cow;","+"," use super::{","     Config,","     EnvVar,","@@ -237,14 +239,39 @@ impl Config {","         if self.settings_read == crate::SettingsRead::PinDecision {","             return Ok(AuthSources::none());","         }","+        let global_settings = global_settings.map(|global| self.global_auth_settings(global));","         self.collect_auth_sources::<Sys>(","             start_dir,","             workspace_yaml,","-            global_settings.map(|global| &global.settings),","+            global_settings.as_deref(),","             global_config_dir,","         )","     }"," ","+    /// The global `config.yaml` settings that name credential sources. A","+    /// command that acts on the global packages takes `_auth` and","+    /// `npmrcAuthFile` from `globalPackagesConfig` over the top level.","+    fn global_auth_settings<'global>(","+        &self,","+        global: &'global TrustedSettings,","+    ) -> Cow<'global, WorkspaceSettings> {","+        let section = global.machine.global_packages_config","+            .as_deref()","+            .filter(|_| self.cli.command_target == crate::CommandTarget::GlobalPackages)","+            .filter(|section| section.auth.is_some() || section.npmrc_auth_file.is_some());","+        let Some(section) = section else {","+            return Cow::Borrowed(&global.settings);","+        };","+        let mut settings = global.settings.clone();","+        if section.auth.is_some() {","+            settings.auth.clone_from(&section.auth);","+        }","+        if section.npmrc_auth_file.is_some() {","+            settings.npmrc_auth_file.clone_from(&section.npmrc_auth_file);","+        }","+        Cow::Owned(settings)","+    }","+","     /// The `.npmrc` layers that contribute credentials, folded into the merged","     /// view plus the trusted-only view the bootstrap and the `tokenHelper`","     /// check need."],"additions":28,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/global_packages.rs","lines":["@@ -19,19 +19,30 @@ pub const GLOBAL_PACKAGES_UNSUPPORTED_KEYS: &[&str] ="," /// The settings that decide which lifecycle scripts run."," const BUILD_POLICY_KEYS: &[&str] = &[\"allowBuilds\", \"dangerouslyAllowAllBuilds\", \"permissions\"];"," ","+/// The build policy the layers below the workspace layer set, restored over","+/// the workspace layer's own by [`Config::apply_global_packages_layer`].","+pub(super) struct BuildPolicy {","+    allow_builds: std::collections::HashMap<String, bool>,","+    dangerously_allow_all_builds: bool,","+    explicit_settings: Vec<(String, serde_json::Value)>,","+}","+"," impl Config {","     /// Apply [`Config::global_packages_config`] when the command acts on the global","     /// packages, in the slot of the workspace layer. Relative paths resolve","     /// against [`Config::dir`], as the rest of the global `config.yaml` does.","+    /// `below_workspace` is [`Config::global_packages_build_policy`], taken","+    /// before the workspace layer applied.","     pub(super) fn apply_global_packages_layer(","         &mut self,","+        below_workspace: Option<BuildPolicy>,","         explicit: &mut ExplicitPaths,","         declared_registries: &mut crate::npmrc_auth::DeclaredRegistries,","     ) {","-        if self.cli.command_target != CommandTarget::GlobalPackages {","+        let Some(below_workspace) = below_workspace else {","             return;","-        }","-        self.drop_build_policy();","+        };","+        self.restore_build_policy(below_workspace);","         let Some(settings) = self.global_packages_config.as_deref().cloned() else {","             return;","         };","@@ -45,15 +56,32 @@ impl Config {","         self.workspace_dir = saved_workspace_dir;","     }"," ","-    /// Drop the build policy the layers below set. The workspace layer may be","-    /// a repository's, through `PNPM_CONFIG_WORKSPACE_DIR`, and it must not","-    /// decide which lifecycle scripts a global install runs.","-    fn drop_build_policy(&mut self) {","-        self.allow_builds.clear();","-        self.dangerously_allow_all_builds = false;","+    /// The build policy so far, for a command that acts on the global packages.","+    pub(super) fn global_packages_build_policy(&self) -> Option<BuildPolicy> {","+        (self.cli.command_target == CommandTarget::GlobalPackages).then(|| BuildPolicy {","+            allow_builds: self.allow_builds.clone(),","+            dangerously_allow_all_builds: self.dangerously_allow_all_builds,","+            explicit_settings: BUILD_POLICY_KEYS","+                .iter()","+                .filter_map(|key| {","+                    self.explicit_settings","+                        .get(*key)","+                        .map(|value| ((*key).to_string(), value.clone()))","+                })","+                .collect(),","+        })","+    }","+","+    /// Replace the workspace layer's build policy with `policy`, the one of","+    /// the layers below it. The global install fills in the decisions of the","+    /// global packages directory's `pnpm-workspace.yaml` beneath every layer.","+    fn restore_build_policy(&mut self, policy: BuildPolicy) {","+        self.allow_builds = policy.allow_builds;","+        self.dangerously_allow_all_builds = policy.dangerously_allow_all_builds;","         for key in BUILD_POLICY_KEYS {","             self.explicit_settings.remove(*key);","         }","+        self.explicit_settings.extend(policy.explicit_settings);","     }"," ","     fn warn_about_unsupported_global_packages_keys(&mut self, settings: &WorkspaceSettings) {"],"additions":37,"deletions":9,"truncated":false},{"path":"pnpm/crates/config/src/tests/global_packages.rs","lines":["@@ -179,6 +179,23 @@ fn a_global_packages_load_drops_the_build_policy_of_the_workspace_layer() {","     assert!(config.allow_builds.is_empty());"," }"," ","+#[test]","+fn a_global_packages_load_keeps_the_top_level_build_policy() {","+    fake_env!();","+    let machine = Machine::with_global_config(\"dangerouslyAllowAllBuilds: true\\n\");","+    write_file(","+        &machine.pnpm_home.path().join(\"pnpm-workspace.yaml\"),","+        \"dangerouslyAllowAllBuilds: false\\n\",","+    );","+    set_fake_env(&[(\"XDG_CONFIG_HOME\", machine.xdg_config_home())]);","+","+    let config =","+        global_packages_load().current::<FakeEnv>(machine.pnpm_home.path()).expect(\"load config\");","+","+    assert!(config.dangerously_allow_all_builds);","+    assert_eq!(config.explicit_settings.get(\"dangerouslyAllowAllBuilds\"), Some(&true.into()));","+}","+"," #[test]"," fn a_global_packages_load_ignores_workspace_env_vars_and_parent_workspaces() {","     fake_env!();","@@ -207,3 +224,46 @@ fn a_global_packages_load_ignores_workspace_env_vars_and_parent_workspaces() {","     assert_eq!(config.workspace_dir, None);","     assert_eq!(config.pnpmfile, None);"," }","+","+#[test]","+fn global_packages_auth_applies_to_a_global_packages_load() {","+    fake_env!();","+    let machine = Machine::with_global_config(","+        \"_auth:\\n  \\\"https://shared.example.com\\\":\\n    \\\"@\\\":\\n      authToken: top-level-token\\n\\","+         globalPackagesConfig:\\n  _auth:\\n    \\\"https://shared.example.com\\\":\\n      \\\"@\\\":\\n        authToken: global-packages-token\\n\",","+    );","+    set_fake_env(&[(\"XDG_CONFIG_HOME\", machine.xdg_config_home())]);","+","+    let global = global_packages_load()","+        .current::<FakeEnv>(machine.pnpm_home.path())","+        .expect(\"load global packages config\");","+    let project =","+        Config::default().current::<FakeEnv>(machine.pnpm_home.path()).expect(\"load config\");","+","+    let header = |config: &Config| config.auth_headers.for_url(\"https://shared.example.com/pkg\");","+    assert_eq!(header(&global).as_deref(), Some(\"Bearer global-packages-token\"));","+    assert_eq!(header(&project).as_deref(), Some(\"Bearer top-level-token\"));","+}","+","+#[test]","+fn global_packages_npmrc_auth_file_applies_to_a_global_packages_load() {","+    fake_env!();","+    let auth = tempdir().expect(\"auth tempdir\");","+    let auth_file = auth.path().join(\"global-npmrc\");","+    write_file(&auth_file, \"//registry.example.com/:_authToken=global-packages-token\\n\");","+    let machine = Machine::with_global_config(&format!(","+        \"globalPackagesConfig:\\n  npmrcAuthFile: {}\\n\",","+        auth_file.to_str().expect(\"UTF-8 path\"),","+    ));","+    set_fake_env(&[(\"XDG_CONFIG_HOME\", machine.xdg_config_home())]);","+","+    let global = global_packages_load()","+        .current::<FakeEnv>(machine.pnpm_home.path())","+        .expect(\"load global packages config\");","+    let project =","+        Config::default().current::<FakeEnv>(machine.pnpm_home.path()).expect(\"load config\");","+","+    let header = |config: &Config| config.auth_headers.for_url(\"https://registry.example.com/pkg\");","+    assert_eq!(header(&global).as_deref(), Some(\"Bearer global-packages-token\"));","+    assert_eq!(header(&project), None);","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_settings.rs","lines":["@@ -35,6 +35,7 @@ impl Config {","     where","         Sys: EnvVar + EnvVarOs + GetCurrentDir + GetH