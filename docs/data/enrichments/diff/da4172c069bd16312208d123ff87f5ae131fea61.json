{"id":"da4172c069bd16312208d123ff87f5ae131fea61","axis":"silent","repo":"pnpm/pnpm","sha":"da4172c069bd16312208d123ff87f5ae131fea61","parsed":{"files":[{"path":".changeset/root-catalog-local-paths.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Fixed relative local paths in root catalogs failing for dependencies and peers [pnpm/pnpm#17690](https://github.com/pnpm/pnpm/issues/17690)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/catalogs-resolver/src/lib.rs","lines":["@@ -34,7 +34,9 @@ pub struct WantedDependency {"," pub enum CatalogAnchor<'a> {","     /// Re-anchor the entry from `workspace_dir` to `consumer_dir`. A","     /// `None` consumer yields the absolute path, for a consumer that","-    /// installs somewhere unrelated to the workspace.","+    /// installs somewhere unrelated to the workspace. A `workspace:` path","+    /// stays relative to `workspace_dir` instead, because the resolver","+    /// reads it as a path only while it is relative.","     Reanchor { workspace_dir: &'a Path, consumer_dir: Option<&'a Path> },","     /// Return the entry exactly as it is written. For call sites that","     /// compare or display an entry rather than install from it, and for","@@ -140,8 +142,14 @@ fn anchored_specifier(catalog_lookup: &str, anchor: CatalogAnchor<'_>) -> String","     let CatalogAnchor::Reanchor { workspace_dir, consumer_dir } = anchor else {","         return catalog_lookup.to_string();","     };","-    LocalSpec::parse_filesystem(catalog_lookup, workspace_dir)","-        .map_or_else(|| catalog_lookup.to_string(), |spec| spec.render(consumer_dir))","+    if let Some(spec) = LocalSpec::parse_filesystem(catalog_lookup, workspace_dir) {","+        return spec.render(consumer_dir);","+    }","+    LocalSpec::parse_workspace_path(catalog_lookup, workspace_dir)","+        .map_or_else(","+            || catalog_lookup.to_string(),","+            |spec| spec.render(Some(consumer_dir.unwrap_or(workspace_dir))