t\");","+","+    pacquet","+        .with_args([\"install\", \"--offline\", \"--ignore-scripts\", \"--no-frozen-lockfile\"])","+        .with_arg(\"--store-dir\")","+        .with_arg(root.path().join(\"store\"))","+        .assert()","+        .success();","+    Command::new(\"node\")","+        .with_current_dir(&consumer)","+        .with_args([\"-p\", \"require('b')\"])","+        .assert()","+        .success()","+        .stdout(\"correct-b\\n\");","+    Command::new(\"node\")","+        .with_current_dir(&peer_consumer)","+        .with_args([\"-p\", \"require('a')\"])","+        .assert()","+        .success()","+        .stdout(\"correct-b\\n\");","+    drop((root, npmrc_info));","+}","+"," fn read_packed_manifest(tarball: &Path) -> serde_json::Value {","     use std::io::Read as _;"," "],"additions":80,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree.rs","lines":["@@ -27,7 +27,7 @@ use derive_more::{Display, Error};"," use futures_util::future;"," use miette::Diagnostic;"," use pipe_trait::Pipe;","-use pnpm_catalogs_resolver::{CatalogAnchor, CatalogResolutionError};","+use pnpm_catalogs_resolver::CatalogResolutionError;"," use pnpm_hooks::PnpmfileHooks;"," use pnpm_package_manifest::{DependencyGroup, PackageManifest};"," use pnpm_patching::{PatchGroupRecord, PatchKeyConflictError};"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/manifest.rs","lines":["@@ -12,8 +12,9 @@ use std::collections::BTreeMap;"," use crate::resolved_tree::PeerSet;"," "," use super::{","-    CatalogAnchor, DependencySpec, Deprecation, ResolveDependencyTreeError,","-    catalogs::resolve_catalog_specifier, dependency_is_injected, lock_recoverable,","+    DependencySpec, Deprecation, ResolveDependencyTreeError,","+    catalogs::{catalog_anchor, resolve_catalog_specifier},","+    dependency_is_injected, lock_recoverable,","     tree_ctx::TreeCtx,"," };"," ",