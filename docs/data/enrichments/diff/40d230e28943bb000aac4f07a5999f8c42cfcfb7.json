t(ctx, obj.Name, metav1.GetOptions{})","+\tif err != nil {","+\t\tif k8sErrors.IsNotFound(err) {","+\t\t\t// cluster config has been deleted before we had a chance to update it, no need to retry","+\t\t\treturn nil","+\t\t}","+\t\treturn fmt.Errorf(\"failed to get network driver cluster config %s: %w\", obj.Name, err)","+\t}","+","+\tif hasDesiredConflictStatus(cfg.Status.Conditions, obj.IsConflicting) {","+\t\treturn nil","+\t}","+","+\tnewCfg := cfg.DeepCopy()","+\tif obj.IsConflicting {","+\t\tmeta.SetStatusCondition(&newCfg.Status.Conditions, metav1.Condition{","+\t\t\tType:               cilium_v2alpha1_api.NetworkDriverClusterConfigConditionConflict,","+\t\t\tStatus:             metav1.ConditionTrue,","+\t\t\tLastTransitionTime: metav1.Time{Time: time.Now()},","+\t\t\tReason:             cilium_v2alpha1_api.NetworkDriverClusterConfigReasonConflict,","+\t\t})","+\t} else {","+\t\tmeta.RemoveStatusCondition(","+\t\t\t&newCfg.Status.Conditions,","+\t\t\tcilium_v2alpha1_api.NetworkDriverClusterConfigConditionConflict,","+\t\t)","+\t}","+","+\t_, err = ops.client.UpdateStatus(ctx, newCfg, metav1.UpdateOptions{})","+\treturn err","+}","+","+func hasDesiredConflictStatus(conditions []metav1.Condition, isConflicting bool) bool {","+\tif isConflicting {","+\t\treturn meta.IsStatusConditionTrue(conditions, cilium_v2alpha1_api.NetworkDriverClusterConfigConditionConflict)","+\t}","+","+\tcond := meta.FindStatusCondition(","+\t\tconditions,","+\t\tcilium_v2alpha1_api.NetworkDriverClusterConfigConditionConflict,","+\t)","+\treturn cond == nil || cond.Status == metav1.ConditionFalse","+}","+","+func (ops *driverClusterConfigOps) Delete(ctx context.Context, _ statedb.ReadTxn, _ statedb.Revision, _ *driverClusterConfig) error {","+\treturn nil","+}","+","+func (ops *driverClusterConfigOps) Prune(ctx context.Context, _ statedb.ReadTxn, _ iter.Seq2[*driverClusterConfig, statedb.Revision]) error {","+\treturn nil","+}","+","+var _ reconciler.Operations[*driverClusterConfig] = &dr