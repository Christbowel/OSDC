rt rejects incomplete secure view metadata\","," \t}"," }"," ","+// SQL cannot supply a typed replacement for an existing operator, forge an invalid","+// boundary, or observe whether verification repaired the caller's type vector.","+TEST_CASE(\"Resolved subtree export preserves its original plan\", \"[sql_export][logical_plan_sql_export][plan_views]\") {","+\tDuckDB db(nullptr);","+\tConnection connection(db);","+\tconnection.BeginTransaction();","+\tauto plan = OptimizeLogicalPlanExportQuery(","+\t    connection, \"WITH q AS MATERIALIZED (SELECT i FROM range(3) t(i)) SELECT i+1 FROM q\");","+\tREQUIRE(LogicalPlanVerifier::VerifyAlways(*plan).IsSuccess());","+\tauto source = FindLogicalPlanExportOperator(*plan, LogicalOperatorType::LOGICAL_GET);","+\tREQUIRE(source);","+\tauto &get = source->Cast<LogicalGet>();","+\tauto original_owner = plan.get();","+\tauto original_bind_data = get.bind_data.get();","+\tauto original_types = plan->types;","+\tauto original_bindings = plan->GetColumnBindings();","+\tauto source_bindings = get.GetColumnBindings();","+\tget.function.to_sql = [](ClientContext &, const LogicalGet &) -> TableFunctionToSQLResult {","+\t\treturn {nullptr, \"opaque_original_source\"};","+\t};","+\tauto relation = [&]() {","+\t\tParser parser(*connection.context);","+\t\tparser.ParseQuery(\"SELECT 42::BIGINT AS i\");","+\t\tvector<LogicalPlanSQLExportField> fields;","+\t\tfor (idx_t i = 0; i < get.types.size(); i++) {","+\t\t\tfields.push_back({source_bindings[i], get.types[i]});","+\t\t}","+\t\treturn LogicalPlanSQLExportRelation {std::move(parser.statements[0]->Cast<SelectStatement>().node),","+\t\t                                     std::move(fields)};","+\t};","+","+\tSECTION(\"sources precede materialized CTE consumers\") {","+\t\tfor (idx_t repeat = 0; repeat < 2; repeat++) {","+\t\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\t\treplacements.push_back({get, relation()});","+\t\t\tauto exported = LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements);","+\t\t\tREQUIRE(exported.IsSuccess());","+\t\t\tauto result = connection.Query(exported.GetValue().query->ToString());","+\t\t\tREQUIRE_NO_FAIL(*result);","+\t\t\tREQUIRE(result->RowCount() == 1);","+\t\t\tREQUIRE(result->Collection().GetValue(0, 0) == Value::BIGINT(43));","+\t\t}","+\t}","+\tSECTION(\"unreplaced sources remain opaque\") {","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, get, {}),","+\t\t                       LogicalPlanVerificationIssueCode::UNSUPPORTED_SOURCE);","+\t}","+\tSECTION(\"incomplete fields\") {","+\t\tauto replacement = relation();","+\t\treplacement.fields.clear();","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({get, std::move(replacement)});","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements),","+\t\t                       LogicalPlanVerificationIssueCode::INTERNAL_INVARIANT);","+\t}","+\tSECTION(\"wrong type\") {","+\t\tauto replacement = relation();","+\t\treplacement.fields[0].type = LogicalType::INTEGER;","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({get, std::move(replacement)});","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements),","+\t\t                       LogicalPlanVerificationIssueCode::INTERNAL_INVARIANT);","+\t}","+\tSECTION(\"duplicate boundary\") {","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({get, relation()});","+\t\treplacements.push_back({get, relation()});","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements),","+\t\t                       LogicalPlanVerificationIssueCode::INTERNAL_INVARIANT);","+\t}","+\tSECTION(\"overlapping boundaries\") {","+\t\tauto root_relation = relation();","+\t\troot_relation.fields[0].source_binding = original_bindings[0];","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({*plan, std::move(root_relation)});","+\t\treplacements.push_back({get, relation()});","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements),","+\t\t                       LogicalPlanVerificationIssueCode::INTERNAL_INVARIANT);","+\t}","+\tSECTION(\"foreign boundary\") {","+\t\tauto other = OptimizeLogicalPlanExportQuery(connection, \"SELECT i FROM range(4) t(i)\");","+\t\tREQUIRE(LogicalPlanVerifier::VerifyAlways(*other).IsSuccess());","+\t\tauto other_get = FindLogicalPlanExportOperator(*other, LogicalOperatorType::LOGICAL_GET);","+\t\tREQUIRE(other_get);","+\t\tauto replacement = relation();","+\t\treplacement.fields[0].source_binding = other_get->GetColumnBindings()[0];","+\t\tvector<LogicalPlanSQLExportReplacement> replacements;","+\t\treplacements.push_back({*other_get, std::move(replacement)});","+\t\tRequirePlanExportIssue(LogicalPlanSQLExporter::ExportWithSources(*connection.context, *plan, replacements),","+\t\t                       LogicalPlanVerificationIssueCode::INTERNAL_INVARIANT);","+\t}","+\tSECTION(\"read-only verification never repairs unresolved types\") {","+\t\tplan->types.clear();","+\t\tREQUIRE(LogicalPlanVerifier::VerifyResolvedBindings(*plan).HasError());","+\t\tREQUIRE(plan->types.empty());","+\t\tplan->types = original_types;","+\t\tREQUIRE(LogicalPlanVerifier::VerifyResolvedBindings(*plan).IsSuccess());","+\t}","+\tREQUIRE(plan.get() == original_owner);","+\tREQUIRE(get.bind_data.get() == original_bind_data);","+\tREQUIRE(plan->types == original_types);","+\tREQUIRE(plan->GetColumnBindings() == original_bindings);","+\tREQUIRE(get.GetColumnBindings() == source_bindings);","+\tconnection.Rollback();","+}","+","+static unique_ptr<LogicalOperator> BindResolvedReplacementPlan(Connection &connection, const string &sql) {","+\tParser parser(*connectio