{"id":"772d15bc5ec7018d2596be6c608b6fb0eb7e0539","axis":"silent","repo":"opensearch-project/OpenSearch","sha":"772d15bc5ec7018d2596be6c608b6fb0eb7e0539","parsed":{"files":[{"path":"plugins/workload-management/src/internalClusterTest/java/org/opensearch/plugin/wlm/WlmCrossClusterSearchSettingsIT.java","lines":["@@ -0,0 +1,285 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.plugin.wlm;","+","+import org.opensearch.ExceptionsHelper;","+import org.opensearch.action.ActionRequest;","+import org.opensearch.action.search.SearchAction;","+import org.opensearch.action.search.SearchRequest;","+import org.opensearch.action.search.SearchResponse;","+import org.opensearch.action.search.SearchShardTask;","+import org.opensearch.action.search.SearchTask;","+import org.opensearch.action.support.WriteRequest;","+import org.opensearch.cluster.metadata.WorkloadGroup;","+import org.opensearch.cluster.service.ClusterService;","+import org.opensearch.common.action.ActionFuture;","+import org.opensearch.common.settings.Settings;","+import org.opensearch.common.unit.TimeValue;","+import org.opensearch.core.action.ActionResponse;","+import org.opensearch.core.tasks.TaskCancelledException;","+import org.opensearch.core.tasks.TaskId;","+import org.opensearch.index.query.QueryBuilder;","+import org.opensearch.plugin.wlm.WlmNodeThrottlingIT.ScriptedBlockPlugin;","+import org.opensearch.plugins.ActionPlugin;","+import org.opensearch.plugins.Plugin;","+import org.opensearch.plugins.PluginsService;","+import org.opensearch.script.Script;","+import org.opensearch.script.ScriptType;","+import org.opensearch.search.builder.SearchSourceBuilder;","+import org.opensearch.tasks.Task;","+import org.opensearch.test.AbstractMultiClustersTestCase;","+import org.opensearch.test.InternalTestCluster;","+import org.opensearch.transport.TransportService;","+import org.opensearch.transport.client.Client;","+import org.opensearch.wlm.MutableWorkloadGroupFragment;","+import org.opensearch.wlm.ResourceType;","+import org.opensearch.wlm.WorkloadGroupSearchSettings;","+import org.opensearch.wlm.WorkloadGroupTask;","+import org.joda.time.Instant;","+import org.junit.Before;","+","+import java.util.ArrayList;","+import java.util.Collection;","+import java.util.Collections;","+import java.util.List;","+import java.util.Map;","+import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.AtomicReference;","+","+import static org.opensearch.index.query.QueryBuilders.scriptQuery;","+import static org.opensearch.test.hamcrest.OpenSearchAssertions.assertAcked;","+","+/**","+ * End-to-end tests of a workload group's {@code search.cancel_after_time_interval} on cross-cluster searches. Only the local","+ * cluster has the group, and a search reaches it through the workloadGroupId header, which travels with its remote legs too.","+ */","+public class WlmCrossClusterSearchSettingsIT extends AbstractMultiClustersTestCase {","+","+    private static final String REMOTE_CLUSTER = \"cluster_a\";","+    private static final String REMOTE_INDEX = \"remote_index\";","+    private static final String WORKLOAD_GROUP_ID = \"wlm_ccs_cancel_after_group\";","+    private static final TimeValue GROUP_CANCEL_AFTER = TimeValue.timeValueSeconds(1);","+    private static final TimeValue TIMEOUT = TimeValue.timeValueSeconds(30);","+","+    @Override","+    protected Collection<String> remoteClusterAlias() {","+        return List.of(REMOTE_CLUSTER);","+    }","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins(String clusterAlias) {","+        List<Class<? extends Plugin>> plugins = new ArrayList<>(super.nodePlugins(clusterAlias));","+        plugins.add(ScriptedBlockPlugin.class);","+        if (LOCAL_CLUSTER.equals(clusterAlias)) {","+            plugins.add(WorkloadGroupUpdatePlugin.class);","+        }","+        return plugins;","+    }","+","+    @Before","+    public void createRemoteIndexAndLocalWorkloadGroup() throws Exception {","+        assertAcked(","+            client(REMOTE_CLUSTER).admin()","+                .indices()","+                .prepareCreate(REMOTE_INDEX)","+                .setSettings(Settings.builder().put(\"index.number_of_shards\", 1).put(\"index.number_of_replicas\", 0))","+        );","+        client(REMOTE_CLUSTER).prepareIndex(REMOTE_INDEX)","+            .setId(\"1\")","+            .setSource(Map.of(\"field\", \"value\"))","+            .setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE)","+            .get();","+","+        WorkloadGroup workloadGroup = new WorkloadGroup(","+            \"ccs_cancel_after_group\",","+            WORKLOAD_GROUP_ID,","+            new MutableWorkloadGroupFragment(","+                MutableWorkloadGroupFragment.ResiliencyMode.SOFT,","+                Map.of(ResourceType.CPU, 0.4, ResourceType.MEMORY, 0.4),","+                Settings.builder().put(WorkloadGroupSearchSettings.WLM_CANCEL_AFTER_TIME_INTERVAL.getKey(), GROUP_CANCEL_AFTER).build()","+            ),","+            Instant.now().getMillis()","+        );","+        WlmAutoTaggingIT.ExceptionCatchingListener listener = new WlmAutoTaggingIT.ExceptionCatchingListener();","+        client().execute(","+            WlmAutoTaggingIT.TestClusterUpdateTransportAction.ACTION,","+            new WlmAutoTaggingIT.TestClusterUpdateRequest(workloadGroup, \"PUT\"),","+            listener","+        );","+        assertTrue(\"cluster-state update did not complete in time\", listener.getLatch().await(TIMEOUT.getSeconds(), TimeUnit.SECONDS));","+        if (listener.getException() != null) {","+            throw new AssertionError(\"cluster-state update failed\", listener.getException());","+        }","+        assertBusy(() -> {","+            for (ClusterService clusterService : cluster(LOCAL_CLUSTER).getInstances(ClusterService.class)) {","+                assertTrue(clusterService.state().metadata().workloadGroups().containsKey(WORKLOAD_GROUP_ID));","+            }","+        });","+    }","+","+    public void testMinimizeRoundtripsCancelsTheCoordinatorAndEachRemoteLegAtTheGroupInterval() throws Exception {","+        List<ScriptedBlockPlugin> plugins = enableBlocks();","+        SearchRequest request = blockingRemoteSearch();","+        request.setCcsMinimizeRoundtrips(true);","+        ActionFuture<SearchResponse> response = groupClient().search(request);","+        try {","+            SearchShardTask remoteShardTask = awaitBlockedShardTask(REMOTE_CLUSTER, REMOTE_INDEX, response);","+            SearchTask remoteLeg = (SearchTask) task(REMOTE_CLUSTER, remoteShardTask.getParentTaskId());","+            assertFalse(\"a remote leg must not be a child of the coordinator's task\", remoteLeg.getParentTaskId().isSet());","+            // The leg copies the interval that the coordinator wrote onto the request, so the remote cluster, which has no such","+            // group, creates its task with that interval and arms its own timer with it.","+            assertEquals(GROUP_CANCEL_AFTER, remoteLeg.getCancellationTimeout());","+            SearchTask coordinator = awaitLocalSearchTask().task();","+            assertBusy(() -> {","+                assertTrue(\"the coordinator's timer must cancel its task at the group's interval\", coordinator.isCancelled());","+                assertTrue(\"the remote leg's own timer must cancel it at the group's interval\", remoteLeg.isCancelled());","+                assertTrue(\"the remote cancellation has not reached the shard yet\", remoteShardTask.isCancelled());","+            }, 10, TimeUnit.SECONDS);","+        } finally {","+            disableBlocks(plugins);","+        }","+        assertFailedAsCancelled(expectThrows(Exception.class, () -> response.actionGet(TIMEOUT)));","+    }","+","+    public void testWithoutMinimizeRoundtripsTheCoordinatorTimerCancelsTheSearch() throws Exception {","+        List<ScriptedBlockPlugin> plugins = enableBlocks();","+        SearchRequest request = blockingRemoteSearch();","+        request.setCcsMinimizeRoundtrips(false);","+        ActionFuture<SearchResponse> response = groupClient().search(request);","+        try {","+            SearchShardTask remoteShardTask = awaitBlockedShardTask(REMOTE_CLUSTER, REMOTE_INDEX, response);","+            LocalSearch coordinator = awaitLocalSearchTask();","+            // The remote shard runs a child request of the coordinator's task, and a shard request doesn't carry the interval, so the","+            // coordinator's timer is the only one. Its cancellation can't ban children on a remote cluster's nodes, so the remote shard","+            // runs on until it is released, and the search fails once the cancelled coordinator consumes the shard's result.","+            assertEquals(new TaskId(coordinator.nodeId(), coordinator.task().getId()), remoteShardTask.getParentTaskId());","+            assertBusy(","+                () -> assertTrue(\"the coordinator's timer must cancel its task at the group's interval\", coordinator.task().isCancelled()),","+                10,","+                TimeUnit.SECONDS","+            );","+        } finally {","+            disableBlocks(plugins);","+        }","+        assertFailedAsCancelled(expectThrows(Exception.class, () -> response.actionGet(TIMEOUT)));","+    }","+","+    // Helpers","+","+    /** Fails at once, with the search's own failure when it has one, if {@code response} has completed. */","+    private static void assertStillRunning(ActionFuture<?> response) {","+        if (response.isDone()) {","+            // assertBusy retries only assertion errors, so the search's failure, or this, ends the wait at once.","+            response.actionGet();","+            throw new IllegalStateException(\"the search completed before it reached its shard\");","+        }","+    }","+","+    private static void assertFailedAsCancelled(Exception e) {","+        assertNotNull(\"expected the search to fail as cancelled but got: \" + e, ExceptionsHelper.unwrap(e, TaskCancelledException.class));","+    }","+","+    private Client groupClient() {","+        return client().filterWithHeader(Map.of(WorkloadGroupTask.WORKLOAD_GROUP_ID_HEADER, WORKLOAD_GROUP_ID));","+    }","+","+    /** A search on the remote index with a query that blocks on its shard. */","+    private static SearchRequest blockingRemoteSearch() {","+        QueryBuilder blockingQuery = scriptQuery(","+            new Script(ScriptType.INLINE, \"mockscript\", ScriptedBlockPlugin.SCRIPT_NAME, Collections.emptyMap())","+        );","+        return new SearchRequest(REMOTE_CLUSTER + \":\" + REMOTE_INDEX).source(new SearchSourceBuilder().query(blockingQuery));","+    }","+","+    /** The coordinator's search task and the id of the local node that runs it. */","+    private record LocalSearch(String nodeId, SearchTask task) {","+    }","+","+    /** The local cluster's task for the search on the remote index. */","+    private LocalSearch awaitLocalSearchTask() throws Exception {","+        AtomicReference<LocalSearch> found = new AtomicReference<>();","+        assertBusy(() -> {","+            for (TransportService transportService : cluster(LOCAL_CLUSTER).getInstances(TransportService.class)) {","+                for (Task task : transportService.getTaskManager().getTasks().values()) {","+                    if (task instanceof SearchTask searchTask","+                        && SearchAction.NAME.equals(task.getAction())","+                        && task.getDescription().contains(REMOTE_CLUSTER + \":\" + REMOTE_INDEX)) {","+                        found.set(new LocalSearch(transportService.getLocalNode().getId(), searchTask));","+                    }","+                }","+            }","+            assertNotNull(\"the coordinator's search task is not registered yet\", found.get());","+        });","+        return found.get();","+    }","+","+    /**","+     * The shard task of the search on {@code indexName} in {@code clusterAlias}, once it has reached the shard, where it blocks. Fails","+     * at once if {@code response}, which the search completes, completes first.","+     */","+    private SearchShardTask awaitBlockedShardTask(String clusterAlias, String indexName, ActionFuture<?> response) throws Exception {","+        AtomicReference<SearchShardTask> found = new AtomicReference<>();","+        assertBusy(() -> {","+            assertStillRunning(response);","+            for (TransportService transportService : cluster(clusterAlias).getInstances(TransportService.class)) {","+                for (Task task : transportService.getTaskManager().getTasks().values()) {","+                    if (task instanceof SearchShardTask shardTask && task.getDescription().contains(\"[\" + indexName + \"]\")) {","+                        found.set(shardTask);","+                    }","+                }","+            }","+            assertNotNull(\"the search has not reached its shard in [\" + clusterAlias + \"] yet\", found.get());","+        });","+        return found.get();","+    }","+","+    /** The task {@code taskId} of a node in {@code clusterAlias}. */","+    private Task task(String clusterAlias, TaskId taskId) {","+        for (TransportService transportService : cluster(clusterAlias).getInstances(TransportService.class)) {","+            if (transportService.getLocalNode().getId().equals(taskId.getNodeId())) {","+                Task task = transportService.getTaskManager().getTask(taskId.getId());","+                assertNotNull(\"task [\" + taskId + \"] is not running\", task);","+                return task;","+            }","+        }","+        throw new AssertionError(\"no node of cluster [\" + clusterAlias + \"] has the id [\" + taskId.getNodeId() + \"]\");","+    }","+","+    private List<ScriptedBlockPlugin> enableBlocks() {","+        List<ScriptedBlockPlugin> plugins = new ArrayList<>();","+        for (InternalTestCluster cluster : clusters().values()) {","+            for (PluginsService pluginsService : cluster.getDataNodeInstances(PluginsService.class)) {","+                plugins.addAll(pluginsService.filterPlugins(ScriptedBlockPlugin.class));","+            }","+        }","+        for (ScriptedBlockPlugin plugin : plugins) {","+            plugin.enableBlock();","+        }","+        return plugins;","+    }","+","+    private void disableBlocks(List<ScriptedBlockPlugin> plugins) {","+        for (ScriptedBlockPlugin plugin : plugins) {","+            plugin.disableBlock();","+        }","+    }","+","+    /** Registers the test action that writes a workload group straight into the cluster state. */","+    public static class WorkloadGroupUpdatePlugin extends Plugin implements ActionPlugin {","+        @Override","+        public List<ActionHandler<? extends ActionRequest, ? extends ActionResponse>> getActions() {","+            return List.of(","+                new ActionHandler<>(","+                    WlmAutoTaggingIT.TestClusterUpdateTransportAction.ACTION,","+                    WlmAutoTaggingIT.TestClusterUpdateTransportAction.class","+                )","+            );","+        }","+    }","+}"],"additions":285,"deletions":0,"truncated":false},{"path":"plugins/workload-management/src/internalClusterTest/java/org/opensearch/plugin/wlm/WlmSearchSettingsIT.java","lines":["@@ -0,0 +1,663 @@","+/*","+ * SPDX-License-Identifier: Apache-2.0","+ *","+ * The OpenSearch Contributors require contributions made to","+ * this file be licensed under the Apache-2.0 license or a","+ * compatible open source license.","+ */","+","+package org.opensearch.plugin.wlm;","+","+import org.opensearch.ExceptionsHelper;","+import org.opensearch.action.DocWriteResponse;","+import org.opensearch.action.admin.cluster.settings.ClusterUpdateSettingsRequest;","+import org.opensearch.action.admin.cluster.wlm.WlmStatsAction;","+import org.opensearch.action.admin.cluster.wlm.WlmStatsRequest;","+import org.opensearch.action.index.IndexResponse;","+import org.opensearch.action.search.CreatePitAction;","+import org.opensearch.action.search.CreatePitRequest;","+import org.opensearch.action.search.DeletePitAction;","+import org.opensearch.action.search.DeletePitRequest;","+import org.opensearch.action.search.MultiSearchRequest;","+import org.opensearch.action.search.MultiSearchResponse;","+import org.opensearch.action.search.SearchRequestBuilder;","+import org.opensearch.action.search.SearchResponse;","+import org.opensearch.action.search.SearchScrollAction;","+import org.opensearch.action.search.SearchShardTask;","+import org.opensearch.action.search.SearchTask;","+import org.opensearch.action.support.WriteRequest;","+import org.opensearch.cluster.metadata.WorkloadGroup;","+import org.opensearch.common.action.ActionFuture;","+import org.opensearch.common.settings.Settings;","+import org.opensearch.common.unit.TimeValue;","+import org.opensearch.core.common.Strings;","+import org.opensearch.core.common.bytes.BytesArray;","+import org.opensearch.core.tasks.TaskCancelledException;","+import org.opensearch.core.xcontent.MediaTypeRegistry;","+import org.opensearch.index.query.QueryBuilder;","+import org.opensearch.index.query.QueryBuilders;","+import org.opensearch.indices.TermsLookup;","+import org.opensearch.plugin.wlm.WlmNodeThrottlingIT.ScriptedBlockPlugin;","+import org.opensearch.plugin.wlm.rule.WorkloadGroupFeatureType;","+import org.opensearch.plugin.wlm.rule.sync.RefreshBasedSyncMechanism;","+import org.opensearch.plugins.Plugin;","+import org.opensearch.plugins.PluginsService;","+import org.opensearch.rest.action.search.RestMultiSearchAction;","+import org.opensearch.rule.RuleAttribute;","+import org.opensearch.rule.RuleFrameworkPlugin;","+import org.opensearch.rule.RulePersistenceServiceRegistry;","+import org.opensearch.rule.RuleRoutingServiceRegistry;","+import org.opensearch.rule.action.CreateRuleAction;","+import org.opensearch.rule.action.CreateRuleRequest;","+import org.opensearch.rule.autotagging.AutoTaggingRegistry;","+import org.opensearch.rule.autotagging.FeatureType;","+import org.opensearch.rule.autotagging.Rule;","+import org.opensearch.script.Script;","+import org.opensearch.script.ScriptType;","+import org.opensearch.search.SearchService;","+import org.opensearch.search.builder.PointInTimeBuilder;","+import org.opensearch.tasks.Task;","+import org.opensearch.tasks.TaskManager;","+import org.opensearch.tasks.TaskResourceTrackingService;","+import org.opensearch.test.OpenSearchIntegTestCase;","+import org.opensearch.test.rest.FakeRestRequest;","+import org.opensearch.transport.TransportService;","+import org.opensearch.transport.client.Client;","+import org.opensearch.wlm.MutableWorkloadGroupFragment;","+import org.opensearch.wlm.ResourceType;","+import org.opensearch.wlm.WorkloadGroupSearchSettings;","+import org.opensearch.wlm.WorkloadGroupTask;","+import org.opensearch.wlm.WorkloadManagementSettings;","+import org.opensearch.wlm.stats.WlmStats;","+import org.opensearch.wlm.stats.WorkloadGroupStats.WorkloadGroupStatsHolder;","+import org.joda.time.Instant;","+import org.junit.After;","+import org.junit.Before;","+","+import java.util.ArrayList;","+import java.util.Collection;","+import java.util.Collections;","+import java.util.HashSet;","+import java.util.List;","+import java.util.Map;","+import java.util.Objects;","+import java.util.Set;","+import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.AtomicReference;","+","+import static org.opensearch.index.query.QueryBuilders.scriptQuery;","+import static org.opensearch.test.hamcrest.OpenSearchAssertions.assertAcked;","+","+/**","+ * End-to-end integration test for the search settings a workload group applies to the searches assigned to it.","+ */","+@OpenSearchIntegTestCase.ClusterScope(scope = OpenSearchIntegTestCase.Scope.TEST, numDataNodes = 1, numClientNodes = 0, supportsDedicatedMasters = false)","+public class WlmSearchSettingsIT extends OpenSearchIntegTestCase {","+","+    private static final TimeValue TIMEOUT = new TimeValue(30, TimeUnit.SECONDS);","+    private static final String PUT = \"PUT\";","+    private static final String DELETE = \"DELETE\";","+    private static final String WORKLOAD_GROUP_ID = \"wlm_cancel_after_group\";","+    private static final String OTHER_WORKLOAD_GROUP_ID = \"wlm_other_group\";","+    private static final String INDEX_NAME = \"cancel_after_index\";","+    private static final String OTHER_INDEX_NAME = \"other_index\";","+    private static final String LOOKUP_INDEX_NAME = \"lookup_index\";","+    private static final String CANCEL_AFTER_TIME_INTERVAL = WorkloadGroupSearchSettings.WLM_CANCEL_AFTER_TIME_INTERVAL.getKey();","+    private static final String OVERRIDE_REQUEST_VALUES = WorkloadGroupSearchSettings.WLM_OVERRIDE_REQUEST_VALUES.getKey();","+    private static final TimeValue GROUP_CANCEL_AFTER = TimeValue.timeValueSeconds(1);","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins() {","+        List<Class<? extends Plugin>> plugins = new ArrayList<>(super.nodePlugins());","+        plugins.add(WlmAutoTaggingIT.TestWorkloadManagementPlugin.class);","+        plugins.add(RuleFrameworkPlugin.class);","+        plugins.add(ScriptedBlockPlugin.class);","+        return plugins;","+    }","+","+    @Override","+    protected Settings nodeSettings(int nodeOrdinal) {","+        // A new rule tags searches only once the rule sync runs, so its shortest interval keeps each wait for tagging short.","+        return Settings.builder()","+            .put(super.nodeSettings(nodeOrdinal))","+            .put(RefreshBasedSyncMechanism.RULE_SYNC_REFRESH_INTERVAL_SETTING_NAME, 1000)","+            .build();","+    }","+","+    @Before","+    public void registerFeatureTypeIfMissingOnAllNodes() {","+        // The registry is JVM-static but each test gets a new cluster, so re-register this cluster's feature type.","+        AutoTaggingRegistry.featureTypesRegistryMap.remove(WorkloadGroupFeatureType.NAME);","+        FeatureType featureType = WlmAutoTaggingIT.TestWorkloadManagementPlugin.featureType;","+        AutoTaggingRegistry.registerFeatureType(featureType);","+","+        for (String node : internalCluster().getNodeNames()) {","+            RulePersistenceServiceRegistry persistenceRegistry = internalCluster().getInstance(RulePersistenceServiceRegistry.class, node);","+            RuleRoutingServiceRegistry routingRegistry = internalCluster().getInstance(RuleRoutingServiceRegistry.class, node);","+            try {","+                routingRegistry.getRuleRoutingService(featureType);","+            } catch (IllegalArgumentException ex) {","+                persistenceRegistry.register(featureType, WlmAutoTaggingIT.TestWorkloadManagementPlugin.rulePersistenceService);","+                routingRegistry.register(featureType, WlmAutoTaggingIT.TestWorkloadManagementPlugin.ruleRoutingService);","+            }","+        }","+    }","+","+    @After","+    public void clearWlmModeSetting() {","+        Settings.Builder builder = Settings.builder().putNull(WorkloadManagementSettings.WLM_MODE_SETTING.getKey());","+        assertAcked(client().admin().cluster().prepareUpdateSettings().setPersistentSettings(builder).get());","+    }","+","+    public void testGroupCancelAfterTimeIntervalCancelsSearch() throws Exception {","+        createWorkloadGroupForIndex(Settings.builder().put(CANCEL_AFTER_TIME_INTERVAL, GROUP_CANCEL_AFTER).build());","+        // Neither the request nor the cluster sets search.cancel_after_time_interval, so only the group's value can cancel it.","+        assertCancelledByGroup(client().prepareSearch(INDEX_NAME));","+    }","+","+    public void testRequestThatTurnsOffCancellationIsNotCancelledWithoutOverride() throws Exception {","+        createWorkloadGroupForIndex(Settings.builder().put(CANCEL_AFTER_TIME_INTERVAL, GROUP_CANCEL_AFTER).build());","+        // Without override_request_values the request's own value wins, and -1 turns off its cancellation.","+        assertNotCancelledByGroup(client().prepareSearch(INDEX_NAME).setCancelAfterTimeInterval(SearchService.NO_TIMEOUT));","+    }","+","+    public void testGroupThatOverridesRequestValuesCancelsSearchWhateverTheRequestSet() throws Exception {","+        createWorkloadGroupForIndex(","+            Settings.builder().put(CANCEL_AFTER_TIME_INTERVAL, GROUP_CANCEL_AFTER).put(OVERRIDE_REQUEST_VALUES, true).build()","+        );","+        assertCancelledByGroup(client().prepareSearch(INDEX_NAME).setCancelAfterTimeInterval(TimeValue.timeValueHours(1)));","+        assertCancelledByGroup(client().prepareSearch(INDEX_NAME).setCancelAfterTimeInterval(SearchService.NO_TIMEOUT));","+    }","+","+    public void testEachSubSearchOfAMultiSearchGetsItsOwnTimer() throws Exception {","+        createWorkloadGroupForIndex(Settings.builder().put(CANCEL_AFTER_TIME_INTERVAL, GROUP_CANCEL_AFTER).build());","+        List<ScriptedBlockPlugin> plugins = enableBlocks();","+        // Each sub-search consults the resolver in its own doExecute. Without override_request_values a sub-search's own interval","+        // wins, so the sub-search that turns its cancellation off outlives the group's interval, and only the other one is cancelled.","+        ActionFuture<MultiSearchResponse> response = client().prepareMultiSearch()","+            .setMaxConcurrentSearchRequests(2)","+            .add(client().prepareSearch(INDEX_NAME).setCancelAfterTimeInterval(SearchService.NO_TIMEOUT).setQuery(blockingQuery()))","+            .add(client().prepareSearch(INDEX_NAME).setQuery(blockingQuery()))","+            .execute();","+        try {","+            List<BlockedSearch> blocked = awaitBlockedSearches(INDEX_NAME, WORKLOAD_GROUP_ID, 2, response);","+            awaitCancelled(withTaskTimeout(blocked, null));","+            assertOutlivesTheGroupInterval(withTaskTimeout(blocked, SearchService.NO_TIMEOUT), response);","+        } finally {","+            disableBlocks(plugins);","+        }","+        MultiSearchResponse.Item[] items = response.actionGet(TIMEOUT).getResponses();","+        assertSucceeded(items[0]);","+        assertFailedAsCancelled(items[1].getFailure());","+    }","+","+    public void testGroupThatOverridesRequestValuesCancelsEverySubSearch() throws Exception {","+        createWorkloadGroupForIndex(","+            Settings.builder().put(CANCEL_AFTER_TIME_INTERVAL, GROUP_CANCEL_AFTER).put(OVERRIDE_REQUEST_VALUES, true).build()","+        );","+        List<ScriptedBlockPlugin> plugins = enableBlocks();","+        ActionFuture<MultiSearchResponse> response = client().prepareMultiSearch()","+            .setMaxConcurrentSearchRequests(2)","+            .add(client().prepareSearch(INDEX_NAME).setCancelAfterTimeInterval(SearchService.NO_TIMEOUT).setQuery(blockingQuery()))","+            .add(client().prepareSearch(INDEX_NAME).setQuery(blockingQuery()))","+            .execute();","+        try {","+            for (BlockedSearch blocked : awaitBlockedSearches(INDEX_NAME, WORKLOAD_GROUP_ID, 2, response)) {","+                awaitCancelled(blocked);","+            }","+        } finally {","+            disableBlocks(plugins);","+        }","+        for (MultiSearchResponse.Item item : response.actionGet(TIMEOUT).getResponses()) {","+            assertFailedAsCancelled(item.getFailure());","+        }","+    }","+","+    public void testMultiSearchLevelIntervalCountsAsEachSubSearchsOwn() throws Exception {","+        // Guards existing behavior: without the resolver no group interval reaches the coordinator's timer at all. With it, the","+        // msearch-level interval must keep beating a group without override_request_values.","+        createWorkloadGroupForIndex(Settings.builder().put(CANCEL_AFTER_TIME_INTERVAL, GROUP_CANCEL_AFTER).build());","+        String body = \"{\\\"index\\\":\\\"\" + INDEX_NAME + \"\\\"}\\n{\\\"query\\\":\" + Strings.toString(MediaTypeRegistry.JSON, blockingQuery()) + \"}\\n\";","+        FakeRestRequest restRequest = new FakeRestRequest.Builder(xContentRegistry()).withContent(","+            new BytesArray(body),","+            MediaTypeRegistry.JSON","+        ).withParams(Map.of(\"cancel_after_time_interval\", \"-1\")).build();","+        MultiSearchRequest request = RestMultiSearchAction.parseRequest(restRequest, null, true);","+        // RestMultiSearchAction gives the msearch-level interval to each sub-search that sets none, before its task is created.","+        assertEquals(SearchService.NO_TIMEOUT, request.requests().get(0).getCancelAfterTimeInterval());","+        List<ScriptedBlockPlugin> plugins = enableBlocks();","+        ActionFuture<MultiSearchResponse> response = client().multiSearch(request);","+        try {","+            assertOutlivesTheGroupInterval(awaitBlockedSearch(INDEX_NAME, WORKLOAD_GROUP_ID, response), response);","+        } finally {","+            disableBlocks(plugins);","+        }","+        assertSucceeded(response.actionGet(TIMEOUT).getResponses()[0]);","+    }","+","+    public void testSubSearchesOfAMultiSearchRunInTheGroupsOfTheirIndices() throws Exception {","+        // Each sub-search is tagged by its own indices only because TransportAction#execute restores the msearch thread's context","+        // after starting each one, which it does while task resource tracking is enabled and supported.","+        TaskResourceTrackingService taskResourceTrackingService = internalCluster().getInstance(TaskResourceTrackingService.class);","+        assumeTrue(","+            \"the msearch thread's context is restored only while task resource tracking is enabled and supported\",","+            taskResourceTrackingService.isTaskResourceTrackingEnabled() && taskResourceTrackingService.isTaskResourceTrackingSupported()","+        );","+  