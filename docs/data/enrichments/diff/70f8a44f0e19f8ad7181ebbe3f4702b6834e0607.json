/filter_chain_manager_impl.h\""," #include \"source/common/listener_manager/listener_impl.h\""," #include \"source/common/listener_manager/listener_info_impl.h\"","@@ -34,6 +35,7 @@"," #include \"test/mocks/stream_info/mocks.h\""," #include \"test/server/utility.h\""," #include \"test/test_common/environment.h\"","+#include \"test/test_common/registry.h\""," #include \"test/test_common/status_utility.h\""," #include \"test/test_common/threadsafe_singleton_injector.h\""," #include \"test/test_common/utility.h\"","@@ -467,6 +469,25 @@ class MockFcdsClientCallbacks : public FcdsClientCallbacks {","               (override));"," };"," ","+// A transport socket whose factory adds an init target to the init manager of its context.","+class InitTargetTransportSocketConfigFactory","+    : public Configuration::DownstreamTransportSocketConfigFactory {","+public:","+  std::string name() const override { return \"envoy.transport_sockets.init_target_for_test\"; }","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<Protobuf::BoolValue>();","+  }","+  absl::StatusOr<Network::DownstreamTransportSocketFactoryPtr>","+  createTransportSocketFactory(const Protobuf::Message&,","+                               Configuration::TransportSocketFactoryContext& context,","+                               const std::vector<std::string>&) override {","+    context.initManager().add(init_target_);","+    return std::make_unique<NiceMock<Network::MockDownstreamTransportSocketFactory>>();","+  }","+","+  Init::TargetImpl init_target_{\"transport socket\", [] {}};","+};","+"," TEST_P(FilterChainManagerImplTest, FcdsSharedFilterChainManagerBasic) {","   NiceMock<MockListenerComponentFactory> listener_component_factory;"," ","@@ -625,6 +646,51 @@ TEST_P(FilterChainManagerImplTest, FcdsSubscriptionHandleIsActive) {","   EXPECT_EQ(fcds_shared_manager->activeFilterChain(filter_chain_name), nullptr);"," }"," ","+// A filter chain from FCDS warms until the init targets of its transport socket are ready. The","+// server init manager does not get them, since it has completed once the server serves.","+TEST_P(FilterChainManagerImplTest, FcdsFilterChainWarmsOnTransportSocketInitTargets) {","+  InitTargetTransportSocketConfigFactory transport_socket_config_factory;","+  Registry::InjectFactory<Configuration::DownstreamTransportSocketConfigFactory>","+      registered_transport_socket_config_factory(transport_socket_config_factory);","+  NiceMock<MockListenerComponentFactory> listener_component_factory;","+  auto fcds_shared_manager = createFcdsSharedManager(listener_component_factory);","+  setupFcdsUpdateMocks(listener_component_factory);","+","+  envoy::config::core::v3::ConfigSource config_source;","+  config_source.mutable_api_config_source()->set_api_type(","+      envoy::config::core::v3::ApiConfigSource::GRPC);","+  config_source.mutable_api_config_source()->set_transport_api_version(","+      envoy::config::core::v3::ApiVersion::V3);","+  testing::StrictMock<MockFcdsClientCallbacks> callbacks;","+  auto handle_or_status =","+      fcds_shared_manager->subscribe(config_source, \"chain\", callbacks, init_manager_);","+  ASSERT_TRUE(handle_or_status.ok());","+  auto handle = std::move(handle_or_status).value();","+  ASSERT_EQ(fcds_subscription_callbacks_.size(), 1);","+  Init::ExpectableWatcherImpl init_watcher;","+  EXPECT_CALL(init_watcher, ready());","+  init_manager_.initialize(init_watcher);","+","+  EXPECT_CALL(parent_context_.server_factory_context_.init_manager_, add(_)).Times(0);","+  envoy::config::listener::v3::FilterChain filter_chain;","+  filter_chain.set_name(\"chain\");","+  auto* transport_socket = filter_chain.mutable_transport_socket();","+  transport_socket->set_name(transport_socket_config_factory.name());","+  ASSERT_TRUE(transport_socket->mutable_typed_config()->PackFrom(Protobuf::BoolValue()));","+  const auto decoded_resources = TestUtility::decodeResources({filter_chain});","+  Protobuf::RepeatedPtrField<std::string> removed_resources;","+  EXPECT_OK(fcds_subscription_callbacks_[0]->onConfigUpdate(decoded_resources.refvec_,","+                                                            removed_resources, \"v1\"));","+  flushFcdsTlsUpdate();","+  EXPECT_FALSE(handle->isActive());","+  EXPECT_EQ(fcds_shared_manager->findThreadLocalFilterChain(\"chain\"), nullptr);","+","+  transport_socket_config_factory.init_target_.ready();","+  EXPECT_TRUE(handle->isActive());","+  flushFcdsTlsUpdate();","+  EXPECT_NE(fcds_shared_manager->findThreadLocalFilterChain(\"chain\"), nullptr);","+}","+"," // Warming a batch of filter chains in one event loop iteration publishes to workers only once."," TEST_P(FilterChainManagerImplTest, FcdsCoalescesThreadLocalUpdates) {","   NiceMock<MockListenerComponentFactory> listener_component_factory;"],"additions":66,"deletions":0,"truncated":false},{"path":"test/integration/BUILD","lines":["@@ -2814,6 +2814,9 @@ envoy_cc_test(","     srcs = [","         \"listener_fcds_integration_test.cc\",","     ],","+    data = [","+        \"//test/config/integration/certs\",","+    ],","     rbe_pool = \"linux_x64_medium\",","     shard_count = 4,","     tags = [","@@ -2827,8 +2830,10 @@ envoy_cc_test(","         \"//source/common/network:connection_lib\",","         \"//source/common/network:utility_lib\",","         \"//source/extensions/filters/network/tcp_proxy:config\",","+        \"//source/extensions/transport_sockets/tls:config\",","         \"//test/common/grpc:grpc_client_integration_lib\",","         \"//test/config:v2_link_hacks\",","+        \"//test/test_common:environment_lib\",","         \"//test/test_common:network_utility_lib\",","         \"//test/test_common:resources_lib\",","         \"//test/test_common:utility_lib\",","@@ -2837,6 +2842,7 @@ envoy_cc_test(","         \"@envoy_api//envoy/config/route/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/filters/network/http_connection_manager/v3:pkg_cc_proto\",","    