dd_tls_certificate_sds_secret_configs();","+    secret_config->set_name(\"server_cert\");","+    auto* sds_config = secret_config->mutable_sds_config();","+    sds_config->set_resource_api_version(envoy::config::core::v3::ApiVersion::V3);","+    sds_config->mutable_path_config_source()->set_path(sds_path);","+    auto* transport_socket = filter_chain.mutable_transport_socket();","+    transport_socket->set_name(\"envoy.transport_sockets.tls\");","+    std::ignore = transport_socket->mutable_typed_config()->PackFrom(tls_context);","+    return filter_chain;","+  }","+","   void","   sendFcdsResponse(const std::vector<envoy::config::listener::v3::FilterChain>& added_or_updated,","                    const std::vector<std::string>& removed, const std::string& version) {","@@ -454,6 +477,49 @@ TEST_P(ListenerFcdsIntegrationTest, BasicFcdsInPlaceUpdate) {","   EXPECT_EQ(1, test_server_->counter(\"listener_manager.listener_added\")->value());"," }"," ","+// A filter chain that FCDS updates after startup loads the SDS secret of its TLS context before it","+// serves, since its transport socket warms with the filter chain instead of the started server.","+TEST_P(ListenerFcdsIntegrationTest, FcdsUpdateAfterStartupLoadsSdsSecret) {","+  on_server_init_function_ = [&]() {","+    waitXdsStream();","+    sendFcdsResponse({buildFilterChain(\"dynamic_filter_chain_1\", 200)}, \"1\");","+  };","+  initialize();","+  test_server_->waitForCounter(\"listener_manager.listener_create_success\", Ge(1));","+  registerTestServerPorts({listener_name_});","+  IntegrationCodecClientPtr codec_client = makeHttpConnection(lookupPort(listener_name_));","+  sendRequest(*codec_client);","+  codec_client->close();","+","+  const std::string sds_path = TestEnvironment::writeStringToFileForTest(","+      \"fcds_server_cert.sds.yaml\",","+      fmt::format(R\"EOF(","+resources:","+- \"@type\": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.Secret","+  name: server_cert","+  tls_certificate:","+    certificate_chain:","+      filename: \"{}\"","+    private_key:","+      filename: \"{}\"","+)EOF\",","+                  TestEnvironment::runfilesPath(\"test/config/integration/certs/servercert.pem\"),","+                  TestEnvironment::runfilesPath(\"test/config/integration/certs/serverkey.pem\")));","+  sendFcdsResponse({buildSdsTlsFilterChain(\"dynamic_filter_chain_1\", 404, sds_path)}, \"2\");","+  ASSERT_TRUE(waitForFcdsUpdate(\"2\"));","+","+  Network::UpstreamTransportSocketFactoryPtr tls_client_factory =","+      Ssl::createClientSslTransportSocketFactory({}, context_manager_, *api_,","+                                                 &server_factory_context_.serverScope());","+  IntegrationCodecClientPtr tls_codec_client =","+      makeHttpConnection(dispatcher_->createClientConnection(","+          Ssl::getSslAddress(version_, lookupPort(listener_name_)),","+          Network::Address::InstanceConstSharedPtr(),","+          tls_client_factory->createTransportSocket(nullptr, nullptr), nullptr, nullptr));","+  sendRequest(*tls_codec_client, \"404\");","+  tls_codec_client->close();","+}","+"," // Tests that a single FCDS push warming several filter chains leaves every chain serving traffic,"," // exercising the coalesced thread local update path for a batch of warmed chains."," TEST_P(ListenerFcdsIntegrationTest, FcdsBatchWarmsMultipleFilterChains) {",""],"additions":66,"deletions":0,"truncated":false}],"additions":164,"deletions":8,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-04T16:05:55.433255+00:00"}