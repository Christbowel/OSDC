{"id":"175cc8b9762bf8b8fadc076020deb5792a18b357","axis":"silent","repo":"grafana/grafana","sha":"175cc8b9762bf8b8fadc076020deb5792a18b357","parsed":{"files":[{"path":"pkg/registry/apis/iam/resourcepermission/securevalues_test.go","lines":["@@ -0,0 +1,97 @@","+package resourcepermission","+","+import (","+\t\"context\"","+\t\"strings\"","+\t\"testing\"","+","+\t\"github.com/grafana/authlib/types\"","+\tiamv0 \"github.com/grafana/grafana/apps/iam/pkg/apis/iam/v0alpha1\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/sqlstore/session\"","+\t\"github.com/grafana/grafana/pkg/util/testutil\"","+\t\"github.com/stretchr/testify/require\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+)","+","+func TestIntegrationSecureValueResourcePermissions(t *testing.T) {","+\ttestutil.SkipIntegrationTestInShortMode(t)","+\tctx := context.Background()","+\tbackend := setupBackend(t)","+\tbackend.mappers.RegisterMapper(","+\t\tschema.GroupResource{Group: \"secret.grafana.app\", Resource: \"securevalues\"},","+\t\tNewMapper(\"secret.securevalues\", defaultLevels), nil,","+\t)","+\tbackend.identityStore = NewFakeIdentityStore(t)","+\tdb, err := backend.dbProvider(ctx)","+\trequire.NoError(t, err)","+\t_, err = db.DB.GetSqlxSession().Exec(ctx,","+\t\t\"INSERT INTO \"+db.DB.GetDialect().Quote(\"user\")+\" (id, org_id, uid, login, email, is_admin, is_service_account, created, updated, version) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\",","+\t\t101, 1, \"captain\", \"captain\", \"captain@example.com\", false, false, timeNow(), timeNow(), 0)","+\trequire.NoError(t, err)","+\tns := types.NamespaceInfo{Value: \"default\", OrgID: 1}","+\tfor _, name := range []string{\"personal-one\", \"personal-two\"} {","+\t\trp := &iamv0.ResourcePermission{","+\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"secret.grafana.app-securevalues-\" + name, Namespace: \"default\"},","+\t\t\tSpec: iamv0.ResourcePermissionSpec{","+\t\t\t\tResource:    iamv0.ResourcePermissionspecResource{ApiGroup: \"secret.grafana.app\", Resource: \"securevalues\", Name: name},","+\t\t\t\tPermissions: []iamv0.ResourcePermissionspecPermission{{Kind: iamv0.ResourcePermissionSpecPermissionKindUser, Name: \"captain\", Verb: \"Edit\"}},","+\t\t\t},","+\t\t}","+\t\trequire.NoError(t, ValidateCreateAndUpdateInput(ctx, rp, backend.mappers))","+\t\tgrn, err := splitResourceName(rp.Name)","+\t\trequire.NoError(t, err)","+\t\tmapper, err := backend.getResourceMapper(grn.Group, grn.Resource)","+\t\trequire.NoError(t, err)","+\t\t_, err = backend.createResourcePermission(ctx, db, ns, mapper, grn, rp)","+\t\trequire.NoError(t, err)","+\t\tvar stored *iamv0.ResourcePermission","+\t\trequire.NoError(t, db.DB.GetSqlxSession().WithTransaction(ctx, func(tx *session.SessionTx) error {","+\t\t\tstored, err = backend.getResourcePermission(ctx, db, tx, ns, rp.Name)","+\t\t\treturn err","+\t\t}))","+\t\trequire.Equal(t, rp.Spec.Resource, stored.Spec.Resource)","+\t\trequire.Equal(t, []iamv0.ResourcePermissionspecPermission{{Kind: iamv0.ResourcePermissionSpecPermissionKindUser, Name: \"captain\", Verb: \"edit\"}}, stored.Spec.Permissions)","+\t}","+\tvar roles []string","+\trequire.NoError(t, db.DB.GetSqlxSession().Select(ctx, &roles, \"SELECT name FROM role WHERE org_id = ?\", 1))","+\trequire.Equal(t, []string{\"managed:users:101:permissions\"}, roles)","+\tvar perms []accesscontrol.Permission","+\trequire.NoError(t, db.DB.GetSqlxSession().Select(ctx, &perms, \"SELECT action, scope FROM permission\"))","+\trequire.ElementsMatch(t, []accesscontrol.Permission{","+\t\t{Action: \"secret.securevalues:edit\", Scope: \"secret.securevalues:uid:personal-one\"},","+\t\t{Action: \"secret.securevalues:edit\", Scope: \"secret.securevalues:uid:personal-two\"},","+\t}, perms)","+\trequire.NoError(t, backend.deleteResourcePermission(ctx, db, ns, \"secret.grafana.app-securevalues-personal-one\"))","+\tperms = nil","+\trequire.NoError(t, db.DB.GetSqlxSession().Select(ctx, &perms, \"SELECT action, scope FROM permission\"))","+\trequire.Equal(t, []accesscontrol.Permission{{Action: \"secret.securevalues:edit\", Scope: \"secret.securevalues:uid:personal-two\"}}, perms)","+}","+","+func TestSecureValueResourcePermissionStorageLimits(t *testing.T) {","+\tmappers := NewMappersRegistry()","+\tmappers.RegisterMapper(schema.GroupResource{Group: \"secret.grafana.app\", Resource: \"securevalues\"}, NewMapper(\"secret.securevalues\", defaultLevels), nil)","+\tfor _, length := range []int{40, 41, 166, 167} {","+\t\tname := strings.Repeat(\"a\", length)","+\t\tpermission := &iamv0.ResourcePermission{","+\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"secret.grafana.app-securevalues-\" + name},","+\t\t\tSpec: iamv0.ResourcePermissionSpec{","+\t\t\t\tResource:    iamv0.ResourcePermissionspecResource{ApiGroup: \"secret.grafana.app\", Resource: \"securevalues\", Name: name},","+\t\t\t\tPermissions: []iamv0.ResourcePermissionspecPermission{{Kind: iamv0.ResourcePermissionSpecPermissionKindUser, Name: \"owner\", Verb: \"View\"}},","+\t\t\t},","+\t\t}","+\t\terr := ValidateCreateAndUpdateInput(t.Context(), permission, mappers)","+\t\tif length == 40 {","+\t\t\trequire.NoError(t, err)","+\t\t} else {","+\t\t\trequire.True(t, apierrors.IsBadRequest(err))","+\t\t\tif length > 166 {","+\t\t\t\trequire.ErrorContains(t, err, \"scope must not exceed 190 characters\")","+\t\t\t} else {","+\t\t\t\trequire.ErrorContains(t, err, \"identifier must not exceed 40 characters\")","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":97,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/iam/resourcepermission/validate.go","lines":["@@ -8,6 +8,7 @@ import ("," \t\"k8s.io/apimachinery/pkg/runtime/schema\""," "," \t\"github.com/grafana/grafana/apps/iam/pkg/apis/iam/v0alpha1\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol\""," )"," "," func ValidateCreateAndUpdateInput(ctx context.Context, v0ResourcePerm *v0alpha1.ResourcePermission, mappers *MappersRegistry) error {","@@ -46,6 +47,18 @@ func ValidateCreateAndUpdateInput(ctx context.Context, v0ResourcePerm *v0alpha1."," \t\treturn apierrors.NewBadRequest(fmt.Sprintf(\"mapper not found for group/resource %s/%s\", grn.Group, grn.Resource))"," \t}"," ","+\t// The legacy permission table stores the entire scope in varchar(190).","+\tscope := mapper.Scope(grn.Name)","+\tif len(scope) > 190 {","+\t\treturn apierrors.NewBadRequest(\"resource permission scope must not exceed 190 characters\")","+\t}","+","+\t// The same permission row stores the resource identifier in varchar(40).","+\t_, _, identifier := accesscontrol.SplitScope(scope)","+\tif len(identifier) > 40 {","+\t\treturn apierrors.NewBadRequest(\"resource permission identifier must not exceed 40 characters\")","+\t}","+"," \t// Check for duplicate entities and validate kind/verb per permission"," \tseen := make(map[string]bool)"," \tfor _, perm := range v0ResourcePerm.Spec.Permissions {"],"additions":13,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/secret/RESOURCE_PERMISSIONS.md","lines":["@@ -0,0 +1,93 @@","+# Secure-value resource permissions","+","+The IAM ResourcePermission API supports View, Edit, and Admin assignments for","+`secret.grafana.app/securevalues`. The target is the secure value's **name**, not","+its Kubernetes UID. New secure-value names are limited to 40 characters so","+the complete name fits the legacy permission table's identifier column. The","+full `secret.securevalues:uid:<name>` scope and the prefixed ResourcePermission","+name also fit their storage limits. IAM rejects oversized identifiers and scopes","+before storage, including grants for existing secrets with longer names. Existing","+longer secrets remain updatable and deletable. Assignments reuse the subject's","+managed permissions role.","+","+| Level | Access to the named secure value |","+| --- | --- |","+| View | Read metadata and include the value in authorized list results. |","+| Edit | View, update, and delete. |","+| Admin | Edit, plus read and change permission assignments. |","+","+These levels grant neither creation nor direct decryption. Existing granular","+roles and broad administrator grants remain additive. No existing secret gains","+an owner, and no stored secret or role is migrated.","+","+Secure-value list requests use the existing per-secret authorization filter. A","+caller with no readable secrets receives an empty list instead of a collection","+permission error. The calling service still needs permission to list secrets.","+Other operations retain their resource-level authorization checks.","+","+## Availability and administration","+","+The Enterprise registration checks the existing `secretsManager` entitlement.","+It registers the mapper in embedded Grafana and the multitenant IAM server. The","+mapper remains available to interpret stored assignments when the entitlement","+is unavailable; IAM mutation validation still follows the license check.","+","+The IAM resource-permissions API must also be enabled through `[iam] api` or","+`kubernetesAuthzResourcePermissionApis`. This change does not enable it by","+default or add legacy `/api/access-control/` routes. Licensed self-hosted","+Enterprise can use the same API when it is explicitly enabled.","+","+Two fixed roles follow the existing resource-permission conventions:","+","+- `fixed:secret.securevalues.permissions:reader` grants permission reads.","+- `fixed:secret.securevalues.permissions:writer` grants permission reads and writes.","+","+Both default to organization Admin, subject to existing grant overrides. The","+four existing secret CRUD fixed roles retain their permissions. The creator role","+still uses the existing `secret.securevalues:*` collection scope. Named creation","+grants are not portable across RBAC and Zanzana; creation is not part of the","+View/Edit/Admin grants. A provisioning","+identity needs create authority and permission-write authority separately;","+granting a recipient Edit does not give that recipient either capability.","+","+## Lifecycle contract for callers","+","+Secure values and ResourcePermissions have separate lifecycles. GSM deletion","+does not remove the IAM object. A client that creates both must own cleanup of","+both, including unsuccessful creation, deletion, and owner removal.","+","+For personal-secret clients:","+","+1. Allocate a fresh opaque name for every new secret. Keep display names and","+   environment-variable names separate. Never reuse a retired resource name.","+2. Create the secure value, then its grant. Expose the secret as ready only","+   after the grant succeeds. On failure, retire the name and clean up both","+   records, accounting for an ambiguous permission-write response.","+3. Authorize ordinary reads, updates, and deletion as the requesting user.","+   After deletion, remove the corresponding ResourcePermission using the","+   provisioning identity. Treat an already-absent record as successful cleanup.","+4. Retain failed cleanup work for retry. Deleting a user does not itself delete","+   their secrets. The owning application must retire those secrets and clean up","+   their grants without transferring ownership by matching a login or email.","+","+For other clients that intentionally reuse names, removing the IAM object is","+not sufficient evidence of immediate revocation in every authorization backend.","+Zanzana hooks are asynchronous and failures are logged after the IAM write.","+The Zanzana client also caches authorization decisions for five minutes by","+default. This change does not alter cache invalidation or promise immediate","+revocation. Such clients must confirm revocation before publishing a replacement under the","+same name. Fresh names avoid inheriting a prior object's grants.","+","+## Rollout","+","+Deploy action-set expansion and the Zanzana scope translations to authorization","+readers before clients write these new grants. The Enterprise mapper and API","+must be available on the serving path. For Zanzana, enable the existing IAM sync","+path and use a storage mode that reaches its hooks. An API success alone does","+not establish that synchronization finished.","+","+Validate grant creation, level changes, and revocation through IAM against the","+configured authorization backend before enabling a client. Clients should","+handle unavailable APIs or entitlement failures explicitly, without falling","+back to broader user access. Roll back client creation first; retain the","+reader support needed to interpret existing grants."],"additions":93,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/secret/accesscontrol.go","lines":["@@ -2,6 +2,7 @@ package secret"," "," import ("," \t\"github.com/grafana/grafana/pkg/services/accesscontrol\"","+\t\"github.com/grafana/grafana/pkg/services/accesscontrol/resourcepermissions\""," \t\"github.com/grafana/grafana/pkg/services/org\""," )"," ","@@ -142,14 +143,19 @@ func FixedRoleRegistrations() []accesscontrol.RoleRegistration {"," \t\tGrants: []string{string(org.RoleAdmin)},"," \t}"," ","-\treturn []accesscontrol.RoleRegistration{","+\treturn append([]accesscontrol.RoleRegistration{"," \t\tsecureValuesCreator,"," \t\tsecureValuesReader,"," \t\tsecureValuesUpdater,"," \t\tsecureValuesDeleter,"," \t\tkeepersReader,"," \t\tkeepersWriter,","-\t}","+\t}, resourcepermissions.FixedRoleRegistrations(resourcepermissions.Options{","+\t\tResource:       \"secret.securevalues\",","+\t\tReaderRoleName: \"Secure Value Permissions Reader\",","+\t\tWriterRoleName: \"Secure Value Permissions Writer\",","+\t\tRoleGroup:      \"Secrets Manager\",","+\t})...)"," }"," "," func registerAccessControlRoles(service accesscontrol.Service) error {"],"additions":8,"deletions":2,"truncated":false},{"path":"pkg/registry/apis/secret/contracts/secure_value.go","lines":["@@ -13,6 +13,9 @@ import ("," // The maximum size of a secure value in bytes when written as raw input."," const SecureValueRawInputMaxSizeBytes = 24 << 10 // 24 KiB"," ","+// The legacy permission table stores resource identifiers in 40 characters.","+const SecureValueNameMaxLength = 40","+"," type DecryptSecureValue struct {"," \tKeeper     *string"," \tRef        string"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/secret/validator/secure_value.go","lines":["@@ -46,6 +46,11 @@ func (v *secureValueValidator) Validate(sv, oldSv *secretv1beta1.SecureValue, op"," "," \t\treturn errs"," \t}","+\t// Keep resource identifiers within the legacy permission table limit.","+\tif operation == admission.Create && len(sv.Name) > contracts.SecureValueNameMaxLength {","+\t\terrs = append(errs, field.TooLong(field.NewPath(\"metadata\", \"name\"), sv.Name, contracts.SecureValueNameMaxLength))","+\t}","+"," \tif err := validation.IsDNS1123Subdomain(sv.Namespace); len(err) > 0 {"," \t\terrs = append("," \t\t\terrs,"],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/secret/validator/secure_value_test.go","lines":["@@ -29,6 +29,18 @@ func TestValidateSecureValue(t *testing.T) {"," \t\t\tStatus: secretv1beta1.SecureValueStatus{Keeper: keeper},"," \t\t}"," ","+\t\tt.Run(\"name fits the permission identifier\", func(t *testing.T) {","+\t\t\tsv := validSecureValue.DeepCopy()","+\t\t\tsv.Name = strings.Repeat(\"a\", 40)","+\t\t\trequire.Empty(t, validator.Validate(sv, nil, admission.Create))","+\t\t\tsv.Name += \"a\"","+\t\t\terrs := validator.Validate(sv, nil, admission.Create)","+\t\t\trequire.Len(t, errs, 1)","+\t\t\trequire.Equal(t, \"metadata.name\", errs[0].Field)","+\t\t\trequire.Empty(t, validator.Validate(sv, sv.DeepCopy(), admission.Update))","+\t\t\trequire.Empty(t, validator.Validate(sv, sv.DeepCopy(), admission.Delete))","+\t\t})","+"," \t\tt.Run(\"the `description` must be present\", func(t *testing.T) {"," \t\t\tsv := validSecureValue.DeepCopy()"," \t\t\tsv.Spec.Description = \"\""],"additions":12,"deletions":0,"truncated":false},{"path":"pkg/services/accesscontrol/resourcepermissions/service.go","lines":["@@ -918,7 +918,8 @@ func (a *ActionSetSvc) RegisterActionSets(ctx context.Context, pluginID string,"," }"," "," func isActionSetEnabledResource(action string) bool {","-\treturn strings.HasPrefix(action, dashboards.ScopeDashboardsRoot) ||","+\treturn strings.HasPrefix(action, \"secret.securevalues:\") ||","+\t\tstrings.HasPrefix(action, dashboards.ScopeDashboardsRoot) ||"," \t\tstrings.HasPrefix(action, notebooks.ScopeNotebooksRoot) ||"," \t\tstrings.HasPrefix(action, folder.ScopeFoldersRoot) ||"," \t\tstrings.HasPrefix(action, accesscontrol.AlertingRoutesKind) ||"],"additions":2,"deletions":1,"truncated":false},{"path":"pkg/services/authz/rbac/legacypermissions/securevalues_test.go","lines":["@@ -0,0 +1,38 @@","+package legacypermissions","+","+import (","+\t\"testing\"","+","+\tauthzv1 \"github.com/grafana/authlib/authz/proto/v1\"","+\t\"github.com/stretchr/testify/require\"","+","+\tac \"github.com/grafana/grafana/pkg/services/accesscontrol\"","+)","+","+func TestListPermissionsSecureValueScopes(t *testing.T) {","+\tfor _, action := range []string{","+\t\t\"secret.securevalues:read\",","+\t\t\"secret.securevalues:write\",","+\t\t\"secret.securevalues:delete\",","+\t\t\"secret.securevalues:create\",","+\t\t\"secret.securevalues.permissions:read\",","+\t\t\"secret.securevalues.permissions:write\",","+\t} {","+\t\tfor _, tc := range []struct {","+\t\t\tname     string","+\t\t\tresponse *authzv1.ListResponse","+\t\t\tscope    string","+\t\t}{","+\t\t\t{\"named\", &authzv1.ListResponse{Items: []string{\"personal-one\"}}, \"secret.securevalues:uid:personal-one\"},","+\t\t\t{\"wildcard\", &authzv1.ListResponse{All: true}, \"secret.securevalues:*\"},","+\t\t} {","+\t\t\tt.Run(action+\"/\"+tc.name, func(t *testing.T) {","+\t\t\t\tfor _, filter := range []string{\"\", \"secret.securevalues:uid:personal-one\"} {","+\t\t\t\t\tperms, er