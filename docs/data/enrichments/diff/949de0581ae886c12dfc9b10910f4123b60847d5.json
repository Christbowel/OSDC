Async scheduling: steps that sample are still in flight.","+            min_num_output_tokens += self._min_in_flight_output_tokens(request)","         # Reaching max_tokens finishes the request, so no step verifies the drafts.","         return min_num_output_tokens >= request.max_tokens"," ","+    def _min_in_flight_output_tokens(self, request: Request) -> int:","+        \"\"\"Min output tokens added by in-flight steps, even if all drafts are","+        rejected. At least one, for diffusion (no bonus token per step).\"\"\"","+        return max(","+            1, request.num_output_placeholder_steps * self.num_sampled_tokens_per_step","+        )","+","     def _mamba_block_aligned_split(","         self,","         request: Request,","@@ -788,16 +794,16 @@ def schedule(self, throttle_prefills: bool = False) -> SchedulerOutput:"," ","             if (","                 request.num_output_placeholders > 0","-                # This is (num_computed_tokens + 1) - (num_output_placeholders - 1).","-                # Since output placeholders are also included in the computed tokens","-                # count, we subtract (num_output_placeholders - 1) to remove any draft","-                # tokens, so that we can be sure no further steps are needed even if","-                # they are all rejected.","-                and request.num_computed_tokens + 2 - request.num_output_placeholders","+                # Placeholders are included in num_computed_tokens; subtract them","+                # and add the tokens in-flight steps are sure to produce, so no","+                # further steps are needed even if all drafts are rejected.","+                and request.num_computed_tokens","+                + (1 + self._min_in_flight_output_tokens(request))","+                - request.num_output_placeholders","                 >= request.num_prompt_tokens + request.max_tokens","             ):","                 # Async scheduling: Avoid scheduling an extra step when we are sure that","-                # the previous step has reached request.max_tokens. We don't schedule","+                # the in-flight steps reach request.max_tokens. We don't schedule","                 # partial draft tokens since this prevents uniform decode optimizations.","                 req_index += 1","                 continue","@@ -1870,6 +1876,7 @@ def _preempt_request(","         )","         request.num_stale_output_tokens = request.num_in_flight_tokens","         request.num_output_placeholders = 0","+        request.num_output_placeholder_steps = 0","         request.num_preemptions += 1","         if self.log_stats:","             self._num_preempted_reqs += 1","@@ -2396,6 +2403,11 @@ def update_from_output(","             scheduled_spec_token_ids = (","                 scheduler_output.scheduled_spec_decode_tokens.get(req_id)","             )","+            if (not output_is_stale and request.num_output_placeholder_steps > 0) and (","+                generated_token_ids or scheduled_spec_token_ids","+            ):","+                # Not a prefill chunk, so this step added placeholders.","+                request.num_output_placeholder_steps -= 1","             if scheduled_spec_token_ids and (","                 generated_token_ids or self.num_sampled_tokens_per_step == 0","             ):","@@ -2873,6 +2885,7 @@ def _handle_stopped_request(self, request: Request) -> bool:","         request.drop_stale_output = True","         request.num_stale_output_tokens = request.num_in_flight_tokens","         request.num_output_placeholders = 0","+        request.num_output_placeholder_steps = 0"," ","         while request.streaming_queue:","             update = request.streaming_queue.popleft()"],"additions":23,"deletions":10,"truncated":false},{"path":"vllm/v1/engine/core.py","lines":["@@ -234,6 +234,8 @@ def __init__(","         if self.batch_queue_size > 1:","             logger.debug(\"Batch queue is enabled with size %d\", self.batch_queue_size)","  