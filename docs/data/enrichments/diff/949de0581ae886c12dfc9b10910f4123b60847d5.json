e, num_speculative_steps=1, max_num_reqs=2)","+    manager = AdaptiveVerificationManager(","+        req_states,","+        torch.zeros(3, dtype=torch.int32, device=device),","+        num_bonus_tokens=1,","+        max_total_logits=16,","+        max_concurrent_batches=3,","+    )","+    batch = SimpleNamespace(num_reqs=2, idx_mapping=torch.arange(2, device=device))","+","+    def record_and_read(step: int) -> list[float]:","+        probs = torch.full((2, 1), step / 10, dtype=torch.float32, device=device)","+        manager.record_confidences(probs, batch)  # type: ignore[arg-type]","+        return manager._stale_confidences[manager._stale_idx].np[:, 0].tolist()","+","+    assert record_and_read(1) == [1.0, 1.0]","+    assert record_and_read(2) == [1.0, 1.0]","+    assert record_and_read(3) == pytest.approx([0.1, 0.1])","+    assert record_and_read(4) == pytest.approx([0.2, 0.2])","+    # Slots copied before the add hold the previous request's row.","+    manager.add_request(1)","+    assert record_and_read(5) == pytest.approx([0.3, 1.0])","+    assert record_and_read(6) == pytest.approx([0.4, 1.0])","+    # Copied after the add: the new request's own confidences.","+    assert record_and_read(7) == pytest.approx([0.5, 0.5])","+","+"," def test_budget_stops_where_marginal_drafts_stop_paying_for_themselves():","     # Verification is cheap up to two extra tokens, then jumps 100x; only the","     # highest-confidence draft is worth the cheap slot."],"additions":37,"deletions":1,"truncated":false},{"path":"vllm/config/scheduler.py","lines":["@@ -272,6 +272,15 @@ class SchedulerConfig:","     avoid gaps in GPU utilization, leading to better latency and throughput.","     \"\"\""," ","+    async_scheduling_depth: int = Field(default=2, ge=2)","+    \"\"\"Steps in flight with async scheduling: the step on the GPU plus","+    `async_scheduling_depth - 1` steps scheduled ahead of it (per pipeline","+    stage beyond the first). The default 2 overlaps one step's host work","+    (output processing, scheduling, input preparation) with the next step's GPU","+    work. A deeper queue helps when the host round trip is longer than a GPU","+    step, as in low-batch decode across nodes with speculative decoding.","+    Ignored without async scheduling.\"\"\"","+","     stream_interval: int = Field(default=1, ge=1)","     \"\"\"The interval (or buffer size) for streaming in terms of token length.","     A smaller value (1) makes streaming smoother by sending each token immediately,"],"additions":9,"deletions":0,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -650,7 +650,7 @@ def max_concurrent_batches(self) -> int:","         # Async scheduling requires 2 concurrent batches to overlap.","         pp_size = self.parallel_config.pipeline_parallel_size","         if self.scheduler_config.async_scheduling:","-            return pp_size + 1","+            return pp_size + self.scheduler_config.async_scheduling_depth - 1","         return pp_size"," ","     @property"],"additions":1,"deletions":1,"truncated":false},{"path":"vllm/engine/arg_utils.py","lines":["@@ -841,6 +841,7 @@ class EngineArgs:","     \"\"\"Custom logitproc types\"\"\""," ","     async_scheduling: bool | None = SchedulerConfig.async_scheduling","+    async_scheduling_depth: int = SchedulerConfig.async_scheduling_depth"," ","     stream_interval: int = SchedulerConfig.stream_interval"," ","@@ -1834,6 +1835,9 @@ def add_cli_args(parser: FlexibleArgumentParser) -> FlexibleArgumentParser:","         scheduler_group.add_argument(","             \"--async-scheduling\", **scheduler_kwargs[\"async_scheduling\"]","         )","+        scheduler_group.add_argument(","+            \"--async-scheduling-depth\", **scheduler_kwargs[\"async_scheduling_depth\"]","+        )","         scheduler_group.add_argument(","             \"--stream-interval\", **scheduler_kwargs[\"stream_interval\"]","         )","@@ -2716,6 +2720,7 @@ def create_engine_config(","             cache_awar