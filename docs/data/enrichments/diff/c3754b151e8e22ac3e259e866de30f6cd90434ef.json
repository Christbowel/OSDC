{"id":"c3754b151e8e22ac3e259e866de30f6cd90434ef","axis":"silent","repo":"pnpm/pnpm","sha":"c3754b151e8e22ac3e259e866de30f6cd90434ef","parsed":{"files":[{"path":".changeset/pacquet-script-shortcut-args.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm test`, `pnpm start`, and `pnpm stop` now forward their arguments to the script, matching the pnpm CLI. `pnpm test --watch` and `pnpm start --port 3000` previously failed with a usage error, and `pnpm stop` claimed `--if-present` and `-s` for itself instead of passing them on. As with `pnpm run`, every token after the command name reaches the script verbatim, a `--` separator included."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args.rs","lines":["@@ -62,6 +62,7 @@ pub mod run;"," pub mod runtime;"," pub mod sanitize;"," pub mod sbom;","+pub mod script_shortcut;"," pub mod search;"," pub mod self_update;"," pub mod set_script;","@@ -69,7 +70,6 @@ pub mod setup;"," pub mod stage;"," pub mod star;"," pub mod stars;","-pub mod stop;"," pub mod store;"," pub mod supported_architectures;"," pub mod team;"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command.rs","lines":["@@ -56,6 +56,7 @@ use super::{","     run::RunArgs,","     runtime::RuntimeArgs,","     sbom::SbomArgs,","+    script_shortcut::ScriptShortcutArgs,","     search::SearchArgs,","     self_update::SelfUpdateArgs,","     set_script::SetScriptArgs,","@@ -63,7 +64,6 @@ use super::{","     stage::StageArgs,","     star::StarArgs,","     stars::StarsArgs,","-    stop::StopArgs,","     store::StoreCommand,","     team::TeamArgs,","     undeprecate::UndeprecateArgs,","@@ -324,8 +324,8 @@ impl CliArgs {","             CliCommand::Run(_)","                 | CliCommand::Exec(_)","                 | CliCommand::External(_)","-                | CliCommand::Test","-                | CliCommand::Start","+                | CliCommand::Test(_)","+                | CliCommand::Start(_)","                 | CliCommand::Stop(_),","         ) {","             return Ok(());","@@ -472,7 +472,7 @@ pub enum CliCommand {","     #[clap(visible_alias = \"ss\")]","     SetScript(SetScriptArgs),","     /// Runs a package's \"test\" script, if one was provided.","-    Test,","+    Test(ScriptShortcutArgs),","     /// Runs a defined package script.","     Run(RunArgs),","     /// Run a shell command in the context of a project.","@@ -487,9 +487,9 @@ pub enum CliCommand {","     #[clap(name = \"completion-server\", hide = true)]","     CompletionServer(CompletionServerArgs),","     /// Runs an arbitrary command specified in the package's start property of its scripts object.","-    Start,","+    Start(ScriptShortcutArgs),","     /// Runs a package's \"stop\" script, if one was provided.","-    Stop(StopArgs),","+    Stop(ScriptShortcutArgs),","     /// Restarts a package. Runs \"stop\", \"restart\", and \"start\" scripts,","     /// and associated pre- and post- scripts.","     Restart(RestartArgs),"],"additions":6,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch.rs","lines":["@@ -399,13 +399,13 @@ fn route<'a>(command: CliCommand, ctx: &RunCtx<'a>) -> miette::Result<CommandFut","         CliCommand::PatchRemove(args) => dispatch_install::patch_remove(ctx, args),","         CliCommand::Peers(args) => dispatch_query::peers(ctx, args),","         CliCommand::SetScript(args) => dispatch_script::set_script(ctx, args),","-        CliCommand::Test => dispatch_script::test(ctx),","+        CliCommand::Test(args) => dispatch_script::test(ctx, args),","         CliCommand::Run(args) => dispatch_script::run(ctx, args),","         CliCommand::External(command) => dispatch_script::fallback(ctx, command),","         CliCommand::Exec(args) => dispatch_script::exec(ctx, args),","         CliCommand::Dlx(args) => dispatch_install::dlx(ctx, args),","         CliCommand::Create(args) => dispatch_install::create(ctx, args),","-  