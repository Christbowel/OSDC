nceServicePartOfValue      = \"llminferenceservice\""," \t// LLMInferenceService component label values (for KubernetesComponentLabelKey)"," \tLLMComponentRouter                = \"llminferenceservice-router\""," \tLLMComponentRouterScheduler       = \"llminferenceservice-router-scheduler\""],"additions":2,"deletions":1,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/config_loader.go","lines":["@@ -182,6 +182,10 @@ type Config struct {"," \t// so that resolution is tied to the config-merge step and all downstream workload functions"," \t// share a single consistent result."," \tResolvedLoRAAdapters []resolvedLoRAAdapter `json:\"-\"`","+","+\t// WorkloadRevision is the generated compatibility boundary shared by all","+\t// prefill and decode Pod templates. It is populated per reconciliation.","+\tWorkloadRevision string `json:\"-\"`"," }"," "," // PrometheusConfig holds Prometheus connection and authentication settings used by KEDA"],"additions":4,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/workload.go","lines":["@@ -65,6 +65,11 @@ func (r *LLMISVCReconciler) reconcileWorkload(ctx context.Context, llmSvc *v1alp"," \t\tllmSvc.MarkMainWorkloadNotReady(\"Stopped\", \"Service is stopped\")"," \t}"," ","+\tif err := r.reconcileWorkloadRevision(ctx, llmSvc, config); err != nil {","+\t\tllmSvc.MarkMainWorkloadNotReady(\"ComputeWorkloadRevisionError\", err.Error())","+\t\treturn fmt.Errorf(\"failed to compute workload revision: %w\", err)","+\t}","+"," \t// Set up TLS certificates for secure communication"," \tif err := r.reconcileSelfSignedCertsSecret(ctx, llmSvc, config.SchedulerConfig); err != nil {"," \t\tllmSvc.MarkMainWorkloadNotReady(\"ReconcileCertsError\", err.Error())"],"additions":5,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/workload_multi_node.go","lines":["@@ -287,6 +287,8 @@ func (r *LLMISVCReconciler) expectedMainMultiNodeLWS(ctx context.Context, llmSvc"," \t\tinjectServerTracingIntoPodSpec(llmSvc.Spec.Tracing, llmSvc.GetNamespace(), llmSvc.GetName(), \"-decode\", &expected.Spec.LeaderWorkerTemplate.WorkerTemplate.Spec)"," \t}"," ","+\tapplyLeaderWorkerSetWorkloadRevision(&expected.Spec.LeaderWorkerTemplate, config)","+"," \tlog.FromContext(ctx).V(2).Info(\"Expected main LWS\", \"leaderworkerset\", expected)"," "," \treturn expected, nil","@@ -422,6 +424,8 @@ func (r *LLMISVCReconciler) expectedPrefillMultiNodeLWS(ctx context.Context, llm"," \t\tutils.PropagateMap(llmSvc.Spec.Prefill.Annotations, &expected.Spec.LeaderWorkerTemplate.WorkerTemplate.Annotations, AnnotationModelBasedRoutingEnabled)"," \t}"," ","+\tapplyLeaderWorkerSetWorkloadRevision(&expected.Spec.LeaderWorkerTemplate, config)","+"," \tlog.FromContext(ctx).V(2).Info(\"Expected prefill LWS\", \"leaderworkerset\", expected)"," "," \treturn expected, nil"],"additions":4,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/workload_revision.go","lines":["@@ -0,0 +1,207 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package llmisvc","+","+import (","+\t\"context\"","+\t\"crypto/sha256\"","+\t\"encoding/hex\"","+\t\"encoding/json\"","+\t\"fmt\"","+","+\tcorev1 \"k8s.io/api/core/v1\"","+\tlwsapi \"sigs.k8s.io/lws/api/leaderworkerset/v1\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha2\"","+\t\"github.com/kserve/kserve/pkg/constants\"","+)","+","+const workloadRevisionLength = 8","+","+// workloadRevisionRole is the rollout-relevant template for one disaggregated","+// role. Replicas and rollout strategy are intentionally absent: scaling a role","+// must not create a new compatibility boundary.","+type workloadRevisionRole struct {","+\tName               string                  `json:\"name\"`","+\tDeploymentTemplate *corev1.PodTemplateSpec `json:\"deploymentTemplate,omitempty\"`","+\tLeaderTemplate     *corev1.PodTemplateSpec `json:\"leaderTemplate,omitempty\"`","+\tWorkerTemplate     *corev1.PodTemplateSpec `json:\"workerTemplate,omitempty\"`","+\tSize               *int32                  `json:\"size,omitempty\"`","+}","+","+// reconcileWorkloadRevision computes one revision from the fully rendered","+// prefill and decode templates. Both roles therefore move to the same revision","+// even though KServe reconciles them as independent workload resources.","+func (r *LLMISVCReconciler) reconcileWorkloadRevision(","+\tctx context.Context,","+\tllmSvc *v1alpha2.LLMInferenceService,","+\tconfig *Config,","+) error {","+\tif llmSvc.Spec.Prefill == nil || !workloadRevisionEnabled(llmSvc) {","+\t\tconfig.WorkloadRevision = \"\"","+\t\treturn nil","+\t}","+","+\t// Build without a generated revision label so the label cannot feed back","+\t// into its own hash. The normal reconciliation rebuilds these resources","+\t// after WorkloadRevision has been assigned.","+\tconfigWithoutRevision := *config","+\tconfigWithoutRevision.WorkloadRevision = \"\"","+","+\troles := make([]workloadRevisionRole, 0, 2)","+\tif llmSvc.Spec.Worker == nil {","+\t\tdecode, err := r.expectedSingleNodeMainDeployment(ctx, llmSvc, &configWithoutRevision)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"failed to build decode template for workload revision: %w\", err)","+\t\t}","+\t\troles = append(roles, workloadRevisionRole{","+\t\t\tName:               constants.LLMDRoleDecode,","+\t\t\tDeploymentTemplate: decode.Spec.Template.DeepCopy(),","+\t\t})","+\t} else {","+\t\tdecode, err := r.expectedMainMultiNodeLWS(ctx, llmSvc, &configWithoutRevision)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"failed to build decode template for workload revision: %w\", err)","+\t\t}","+\t\troles = append(roles, leaderWorkerRevisionRole(","+\t\t\tconstants.LLMDRoleDecode,","+\t\t\t&decode.Spec.LeaderWorkerTemplate,","+\t\t))","+\t}","+","+\tif llmSvc.Spec.Prefill.Worker == nil {","+\t\tprefill, err := r.expectedPrefillMainDeployment(ctx, llmSvc, &configWithoutRevision)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"failed to build prefill template for workload revision: %w\", err)","+\t\t}","+\t\troles = append(roles, workloadRevisionRole{","+\t\t\tName:               constants.LLMDRolePrefill,","+\t\t\tDeploymentTemplate: prefill.Spec.Template.DeepCopy(),","+\t\t})","+\t} else {","+\t\tprefill, err := r.expectedPrefillMultiNodeLWS(ctx, llmSvc, &configWithoutRevision)","+\t\tif err != nil {","+\t\t\treturn fmt.Errorf(\"failed to build prefill template for workload revision: %w\", err)","+\t\t}","+\t\troles = append(roles, leaderWorkerRevisionRole(","+\t\t\tconstants.LLMDRolePrefill,","+\t\t\t&prefill.Spec.LeaderWorkerTemplate,","+\t\t))","+\t}","+","+\trevision, err := computeWorkloadRevision(roles)","+\tif err != nil {","+\t\treturn err","+\t}","+\tconfig.WorkloadRevision = revision","+\treturn nil","+}","+","+// workloadRevisionEnabled checks for the placeholders supplied by revision-aware","+// P/D configs. Older, pinned configs do not contain them, preventing a controller","+// upgrade from changing existing Pod templates and restarting their workloads.","+func workloadRevisionEnabled(llmSvc *v1alpha2.LLMInferenceService) bool {","+\tif llmSvc == nil || llmSvc.Spec.Prefill == nil {","+\t\treturn false","+\t}","+\t_, decodeEnabled := llmSvc.Spec.Labels[constants.LLMInferenceServiceRevisionLabelKey]","+\t_, prefillEnabled := llmSvc.Spec.Prefill.Labels[constants.LLMInferenceServiceRevisionLabelKey]","+\treturn decodeEnabled && prefillEnabled","+}","+","+func leaderWorkerRevisionRole(name string, template *lwsapi.LeaderWorkerTemplate) workloadRevisionRole {","+\trole := workloadRevisionRole{Name: name}","+\tif template == nil {","+\t\treturn role","+\t}","+\tif template.LeaderTemplate != nil {","+\t\trole.LeaderTemplate = template.LeaderTemplate.DeepCopy()","+\t}","+\trole.WorkerTemplate = template.WorkerTemplate.DeepCopy()","+\tif template.Size != nil {","+\t\tsize := *template.Size","+\t\trole.Size = &size","+\t}","+\treturn role","+}","+","+func computeWorkloadRevision(roles []workloadRevisionRole) (string, error) {","+\troles = deepCopyRevisionRoles(roles)","+\tfor i := range roles {","+\t\tclearRevisionLabel(roles[i].DeploymentTemplate)","+\t\tclearRevisionLabel(roles[i].LeaderTemplate)","+\t\tclearRevisionLabel(roles[i].WorkerTemplate)","+\t}","+","+\tdata, err := json.Marshal(roles)","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"failed to marshal workload templates for revision: %w\", err)","+\t}","+\tdigest := sha256.Sum256(data)","+\treturn hex.EncodeToString(digest[:])[:workloadRevisionLength], nil","+}","+","+func deepCopyRevisionRoles(in []workloadRevisionRole) []workloadRevisionRole {","+\tout := make([]workloadRevisionRole, len(in))","+\tfor i := range in {","+\t\tout[i].Name = in[i].Name","+\t\tif in[i].DeploymentTemplate != nil {","+\t\t\tout[i].DeploymentTemplate = in[i].DeploymentTemplate.DeepCopy()","+\t\t}","+\t\tif in[i].LeaderTemplate != nil {","+\t\t\tout[i].LeaderTemplate = in[i].LeaderTemplate.DeepCopy()","+\t\t}","+\t\tif in[i].WorkerTemplate != nil {","+\t\t\tout[i].WorkerTemplate = in[i].WorkerTemplate.DeepCopy()","+\t\t}","+\t\tif in[i].Size != nil {","+\t\t\tsize := *in[i].Size","+\t\t\tout[i].Size = &size","+\t\t}","+\t}","+\treturn out","+}","+","+func clearRevisionLabel(template *corev1.PodTemplateSpec) {","+\tif template != nil {","+\t\tdelete(template.Labels, constants.LLMInferenceServiceRevisionLabelKey)","+\t}","+}","+","+func applyWorkloadRevision(template *corev1.PodTemplateSpec, config *Config) {","+\tif template == nil || config == nil || config.WorkloadRevision == \"\" {","+\t\treturn","+\t}","+","+\t// Clone the labels before adding the generated revision. This helper must","+\t// not mutate a label map that may also be referenced by another workload","+\t// field, such as an immutable Deployment selector.","+\tlabels := make(map[string]string, len(template.Labels)+1)","+\tfor key, value := range template.Labels {","+\t\tlabels[key] = value","+\t}","+\tlabels[constants.LLMInferenceServiceRevisionLabelKey] = config.WorkloadRevision","+\ttemplate.Labels = labels","+}","+","+func applyLeaderWorkerSetWorkloadRevision(template *lwsapi.LeaderWorkerTemplate, config *Config) {","+\tif template == nil {","+\t\treturn","+\t}","+\tapplyWorkloadRevision(&template.WorkerTemplate, config)","+\tapplyWorkloadRevision(template.LeaderTemplate, config)","+}"],"additions":207,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha2/llmisvc/workload_revision_test.go","lines":["@@ -0,0 +1,244 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package llmisvc","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\tk8sfake \"k8s.io/client-go/kubernetes/fake\"","+\tlwsapi \"sigs.k8s.io/lws/api/leaderworkerset/v1\"","+","+\t\"github.com/kserve/kserve/pkg/apis/serving/v1alpha2\"","+\t\"github.com/kserve/kserve/pkg/constants\"","+\t\"github.com/kserve/kserve/pkg/credentials\"","+)","+","+func TestComputeWorkloadRevision(t *testing.T) {","+\troles := []workloadRevisionRole{","+\t\t{","+\t\t\tName: \"decode\",","+\t\t\tDeploymentTemplate: &corev1.PodTemplateSpec{","+\t\t\t\tObjectMeta: metav1.ObjectMeta{Labels: map[string]string{\"team\": \"inference\"}},","+\t\t\t\tSpec:       corev1.PodSpec{Containers: []corev1.Container{{Name: \"main\", Image: \"vllm:v1\"}}},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tName: \"prefill\",","+\t\t\tDeploymentTemplate: &corev1.PodTemplateSpec{","+\t\t\t\tSpec: corev1.PodSpec{Containers: []corev1.Container{{Name: \"main\", Image: \"vllm:v1\"}}},","+\t\t\t},","+\t\t},","+\t}","+","+\trevision, err := computeWorkloadRevision(roles)","+\trequire.NoError(t, err)","+\tassert.Len(t, revision, workloadRevisionLength)","+","+\tsameRevision, err := computeWorkloadRevision(roles)","+\trequire.NoError(t, err)","+\tassert.Equal(t, revision, sameRevision)","+","+\tchanged := deepCopyRevisionRoles(roles)","+\tchanged[1].DeploymentTemplate.Spec.Containers[0].Image = \"vllm:v2\"","+\tchangedRevision, err := computeWorkloadRevision(changed)","+\trequire.NoError(t, err)","+\tassert.NotEqual(t, revision, changedRevision)","+","+\twithRevisionLabel := deepCopyRevisionRoles(roles)","+\twithRevisionLabel[0].DeploymentTemplate.Labels[constants.LLMInferenceServiceRevisionLabelKey] = \"previous\"","+\twithRevisionLabel[1].DeploymentTemplate.Labels = map[string]string{","+\t\tconstants.LLMInferenceServiceRevisionLabelKey: \"previous\",","+\t}","+\tignoredLabelRevision, err := computeWorkloadRevision(withRevisionLabel)","+\trequire.NoError(t, err)","+\tassert.Equal(t, revision, ignoredLabelRevision, \"the generated label must not feed back into its own hash\")","+}","+","+func TestWorkloadRevisionEnabled(t *testing.T) {","+\trevisionLabel := map[string]string{","+\t\tconstants.LLMInferenceServiceRevisionLabelKey: \"\",","+\t}","+\ttests := []struct {","+\t\tname string","+\t\tsvc  *v1alpha2.LLMInferenceService","+\t\twant bool","+\t}{","+\t\t{name: \"nil service\"},","+\t\t{","+\t\t\tname: \"non-disaggregated service\",","+\t\t\tsvc: &v1alpha2.LLMInferenceService{Spec: v1alpha2.LLMInferenceServiceSpec{","+\t\t\t\tWorkloadSpec: v1alpha2.WorkloadSpec{Labels: revisionLabel},","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tname: \"neither role opts in\",","+\t\t\tsvc: &v1alpha2.LLMInferenceService{Spec: v1alpha2.LLMInferenceServiceSpec{","+\t\t\t\tPrefill: &v1alpha2.WorkloadSpec{},","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tname: \"decode only\",","+\t\t\tsvc: &v1alpha2.LLMInferenceService{Spec: v1alpha2.LLMInferenceServiceSpec{","+\t\t\t\tWorkloadSpec: v1alpha2.WorkloadSpec{Labels: revisionLabel},","+\t\t\t\tPrefill:      &v1alpha2.WorkloadSpec{},","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tname: \"prefill only\",","+\t\t\tsvc: &v1alpha2.LLMInferenceService{Spec: v1alpha2.LLMInferenceServiceSpec{","+\t\t\t\tPrefill: &v1alpha2.WorkloadSpec{Labels: revisionLabel},","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tname: \"both roles opt in\",","+\t\t\tsvc: &v1alpha2.LLMInferenceService{Spec: v1alpha2.LLMInferenceServiceSpec{","+\t\t\t\tWorkloadSpec: v1alpha2.WorkloadSpec{Labels: revisionLabel},","+\t\t\t\tPrefill:      &v1alpha2.WorkloadSpec{Labels: revisionLabel},","+\t\t\t}},","+\t\t\twant: true,","+\t\t},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tassert.Equal(t, tt.want, workloadRevisionEnabled(tt.svc))","+\t\t})","+\t}","+}","+","+func TestApplyWorkloadRevisionDoesNotMutateSharedLabels(t *testing.T) {","+\tsharedLabels := map[string]string{\"app\": \"pd\"}","+\tselectorLabels := sharedLabels","+\ttemplate := &corev1.PodTemplateSpec{","+\t\tObjectMeta: metav1.ObjectMeta{Labels: sharedLabels},","+\t}","+","+\tapplyWorkloadRevision(template, &Config{WorkloadRevision: \"revision-2\"})","+","+\t