s in `CurlHttpClient` and `AmpHttpClient`","  * Stop following redirects from `https://` to `http://` URLs","+ * Make `AmpHttpClient`, `CurlHttpClient`, `DnsResolvingHttpClient`, `HttplugClient`, `NoPrivateNetworkHttpClient`, `Psr18Client` and `TraceableHttpClient` implement `ShutdownInterface`","+ * Add argument `$shutdown` to `reset()` in `DecoratorTrait`, `ScopingHttpClient` and `ThrottlingHttpClient`","+ * Close the idle connections of `CurlHttpClient` and `AmpHttpClient` when `reset(true)` is called at shutdown"," "," 8.1"," ---"],"additions":3,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/HttpClient/CurlHttpClient.php","lines":["@@ -22,7 +22,7 @@"," use Symfony\\Contracts\\HttpClient\\HttpClientInterface;"," use Symfony\\Contracts\\HttpClient\\ResponseInterface;"," use Symfony\\Contracts\\HttpClient\\ResponseStreamInterface;","-use Symfony\\Contracts\\Service\\ResetInterface;","+use Symfony\\Contracts\\Service\\ShutdownInterface;"," "," /**","  * A performant implementation of the HttpClientInterface contracts based on the curl extension.","@@ -32,7 +32,7 @@","  *","  * @author Nicolas Grekas <p@tchwork.com>","  */","-final class CurlHttpClient implements HttpClientInterface, LoggerAwareInterface, ResetInterface","+final class CurlHttpClient implements HttpClientInterface, LoggerAwareInterface, ShutdownInterface"," {","     use HttpClientTrait;"," ","@@ -359,9 +359,9 @@ public function stream(ResponseInterface|iterable $responses, ?float $timeout =","         return new ResponseStream(CurlResponse::stream($responses, $timeout));","     }"," ","-    public function reset(): void","+    public function reset(bool $shutdown = false): void","     {","-        $this->multi->reset();","+        $this->multi->reset($shutdown);","     }"," ","     /**"],"additions":4,"deletions":4,"truncated":false},{"path":"src/Symfony/Component/HttpClient/DecoratorTrait.php","lines":["@@ -15,6 +15,7 @@"," use Symfony\\Contracts\\HttpClient\\ResponseInterface;"," us