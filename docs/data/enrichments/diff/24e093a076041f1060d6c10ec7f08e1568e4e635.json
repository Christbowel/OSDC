efault.","+ *","+ * Each policy is written as the list of the arguments passed after the two loaders, so that passing no third argument","+ * at all is tested as well as passing null.","  *","  * @internal","  */","@@ -55,84 +71,103 @@ final class ContentTypeHeaderLocationTest extends TestCase"," ","     private const OTHER_SIGNATURE_KEY = 'the HS256 key of someone else entirely';"," ","+    private const DEPRECATION = 'Since web-token/jwt-library 4.3.0: Loading a nested token whose \"cty\" header parameter is not in the protected header is deprecated and \"%s\" will refuse such a token by default in 5.0.0, as the unprotected headers of a JWE are not authenticated. Have the issuer set \"cty\" in the protected header, or pass true as the third argument of the constructor to keep loading these tokens, or false to refuse them. With the bundle, set the \"allow_unprotected_content_type\" option of the nested token loader.';","+","+    private const REFUSAL = 'The \"cty\" header parameter must be in the protected header.';","+","+    /**","+     * @param list<bool|null> $policy","+     */","     #[Test]","-    #[DataProvider('protectedContentTypes')]","-    public function aTokenMarkedInTheProtectedHeaderLoadsWithoutDeprecation(string $token): void","+    #[DataProvider('protectedContentTypesAndPolicies')]","+    public function aTokenMarkedInTheProtectedHeaderLoadsWithoutDeprecation(string $token, array $policy): void","     {","-        $deprecations = $this->collectDeprecations(static function () use ($token): void {","-            static::assertSame(self::CLAIMS, self::load($token)->getPayload());","+        $deprecations = $this->collectDeprecations(static function () use ($token, $policy): void {","+            static::assertSame(self::CLAIMS, self::load($token, $policy)->getPayload());","         });"," ","         static::assertSame([], $deprecations);","     }"," ","     /**","-     * @return iterable<string, array{string}>","+     * @return iterable<string, arra