lements NestedTokenLoaderInterface"," {","+    private readonly ?bool $allowUnprotectedContentType;","+","+    /**","+     * A JWE carries a nested token when its \"cty\" header parameter is \"JWT\". Its authentication tag covers its protected","+     * header only, so a \"cty\" in the shared unprotected header or in the header of a recipient can be added to a token","+     * without any key. A third argument sets what happens to a token marked that way: true loads it, false refuses it","+     * before its payload is read. Without it, or with null, the token loads, but triggers a deprecation, as 5.0.0","+     * refuses it by default. That argument is not part of the signature yet (it will be in 5.0.0) and is read with","+     * func_num_args()/func_get_arg(2), so that classes extending this one remain compatible.","+     */","     public function __construct(","         private readonly JWELoaderInterface $jweLoader,","         private readonly JWSLoaderInterface $jwsLoader","     ) {","         InheritanceChecker::warnIfExtended(static::class, self::class, NestedTokenLoaderInterface::class);","+        $allowUnprotectedContentType = func_num_args() > 2 ? func_get_arg(2) : null;","+        if ($allowUnprotectedContentType !== null && ! is_bool($allowUnprotectedContentType)) {","+            throw new InvalidArgumentException(","+                'The policy for a \"cty\" header parameter outside the protected header must be a boolean: true accepts it, false refuses it.'","+            );","+        }","+        $this->allowUnprotectedContentType = $allowUnprotectedContentType;","     }"," ","     /**","@@ -72,11 +91,12 @@ public function loadAndVerify(string $token, JWKSet $encryptionKeySet, JWKSet $s","             throw new InvalidPayloadException('The token has no payload.');","         }","         $result = $this->jwsLoader->loadAndVerify($payload, $signatureKeySet);","-        if (! $jwe->hasSharedProtectedHeaderParameter('cty')) {","+        if ($this->allowUn