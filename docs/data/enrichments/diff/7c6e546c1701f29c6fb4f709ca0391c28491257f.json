{"id":"7c6e546c1701f29c6fb4f709ca0391c28491257f","axis":"silent","repo":"pnpm/pnpm","sha":"7c6e546c1701f29c6fb4f709ca0391c28491257f","parsed":{"files":[{"path":".changeset/pack-reinclude-main-browser-dirs.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm pack` and `pnpm publish` now ship the whole gitignored directory that `main`, `browser`, or `bin` points into, as npm does. Previously only the `main` and `bin` files themselves were packed, and `browser` was not packed at all [#16908](https://github.com/pnpm/pnpm/issues/16908)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/ignore_walk.rs","lines":["@@ -29,7 +29,12 @@ pub(crate) enum IgnoreFiles<'a> {","     /// `.npmignore`, the ignore files of the directories from `workspace_dir`","     /// down to the package's parent apply too, matched against paths","     /// relative to the package.","-    Read { workspace_dir: Option<&'a Path> },","+    Read {","+        workspace_dir: Option<&'a Path>,","+        /// Package-relative paths that the root re-includes after its ignore","+        /// files, see [`IgnoreRule::reinclude_path`].","+        required_paths: &'a [String],","+    },"," }"," "," /// Calls `on_file` with every non-directory entry under `pkg_dir` that the","@@ -42,9 +47,10 @@ pub(crate) fn walk_files("," ) -> io::Result<()> {","     let (root_rules, named_files) = match ignore_files {","         IgnoreFiles::SubdirectoriesOnly { named_files } => (Vec::new(), Some(named_files)),","-        IgnoreFiles::Read { workspace_dir } => {","+        IgnoreFiles::Read { workspace_dir, required_paths } => {","             let mut rules = inherited_rules(pkg_dir, workspace_dir)?;","             rules.extend(read_dir_rules(pkg_dir)?);","+            rules.extend(required_paths.iter().map(|path| IgnoreRule::reinclude_path(path)));","             (rules, None)","         }","     };"],"additions":8,"deletions":2,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/ignore_walk/rule.rs","lines":["@@ -38,6 +38,16 @@ impl IgnoreRule {","         IgnoreRule { negate: negations % 2 == 1, alternatives }","     }"," ","+    /// npm-packlist's `!/<path>` strict rule for a package-relative path,","+    /// except that `path` matches only itself, with exact case.","+    pub(super) fn reinclude_path(path: &str) -> Self {","+        let segments = split_on_slash_runs(&format!(\"/{path}\"))","+            .into_iter()","+            .map(|segment| Segment::Pattern(SegmentPattern::exact(segment)))","+            .collect();","+        IgnoreRule { negate: true, alternatives: vec![segments] }","+    }","+","     /// Whether some alternative is a single segment, optionally followed by","     /// a trailing `/`.","     pub(super) fn is_relative(&self) -> bool {"],"additions":10,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/ignore_walk/segment.rs","lines":["@@ -1,5 +1,6 @@"," //! One `/`-free segment of an ignore rule: minimatch's wildcards, character","-//! classes, and extglobs, matched case-insensitively.","+//! classes, and extglobs, matched case-insensitively, or a literal name","+//! matched with exact case."," "," use std::cell::Cell;"," ","@@ -13,6 +14,7 @@ pub(super) struct SegmentPattern {"," #[derive(Debug)]"," enum Node {","     Literal(char),","+    ExactLiteral(char),","     AnyChar,","     AnyRun,","     Class(CharClass),","@@ -72,6 +74,15 @@ impl SegmentPattern {","         SegmentPattern { nodes, has_extglob }","     }"," ","+    /// Matches `segment` itself, with exact case and no glob syntax.","+    pub(super) fn exact(segment: &str) -> Self {","+        let nodes = segment","+            .chars()","+            .map(Node::ExactLiteral)","+            .collect();","+        SegmentPattern { nodes, has_extglob: false }","+    }","+","     pub(super) fn is_empty(&self) -> bool {","         self.nodes.is_empty()","     }","@@ -389,6 +400,7 @@ impl Node {","     fn matches_char(&self, current: char) -> bool {","         match self {","             Node::Literal(literal) => chars_eq_ignoring_case(current, *literal),","+            Node::ExactLiteral(literal) => current == *literal,","             Node::AnyChar => true,","             Node::Class(class) => class.matches(current),","             Node::AnyRun | Node::Extglob(..) => false,"],"additions":13,"deletions":1,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/ignore_walk/tests.rs","lines":["@@ -103,3 +103,20 @@ fn a_wide_brace_group_expands_to_a_bounded_number_of_alternatives() {","     assert!(rule.matches(\"x\", false));","     assert!(!rule.matches(\"xy\", false));"," }","+","+#[test]","+fn reinclude_path_matches_only_the_path_itself() {","+    let rule = IgnoreRule::reinclude_path(\"dist/[id].js\");","+    assert!(rule.negate);","+    let cases = [","+        (\"/dist/[id].js\", false, true),","+        (\"/dist\", true, true),","+        (\"/Dist\", true, false),","+        (\"/DIST/[id].js\", false, false),","+        (\"/dist/i.js\", false, false),","+        (\"/dist/[ID].js\", false, false),","+    ];","+    for (path, partial, expected) in cases {","+        assert_eq!(rule.matches(path, partial), expected, \"{path:?} (partial: {partial})\");","+    }","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/lib.rs","lines":["@@ -12,14 +12,17 @@"," //!    way [`ignore-walk`](https://github.com/npm/ignore-walk) matches them."," //!    A `files` allowlist replaces the package root's ignore files and any"," //!    workspace-inherited ones. Subdirectories' still apply within their","-//!    subtree, except to a file the allowlist names.","+//!    subtree, except to a file the allowlist names. Without an allowlist,","+//!    the root then re-includes the paths declared in `main` / `browser` /","+//!    `bin`, which also re-includes the ignored directories holding them,","+//!    as npm-packlist does."," //! 2. **Apply the `files` field allowlist** on top of the walk's"," //!    output: when the manifest sets `files: [\"dist/**\"]`, drop"," //!    anything outside that set (except the always-included files"," //!    handled in pass 3)."," //! 3. **Always-include** the standard files: `package.json`,"," //!    `README`, `COPYING`, and `LICEN[SC]E`, with any extension, at","-//!    the root, plus the paths declared in `main` / `bin`. The packed","+//!    the root, plus the paths declared in `main` / `browser` / `bin`. The packed"," //!    package's `package.yaml` / `package.json5` are included too, but"," //!    a bundled dependency's are not. These survive `.npmignore`"," //!    rejection and the `files`-field filter.","@@ -161,7 +164,7 @@ pub fn packlist_with_sources("," "," /// Collect the forward-slash relative paths for a single package's own"," /// files — the `.npmignore` / `.gitignore` walk, the `files`-field","-/// allowlist, and the always-included / `main` / `bin` force-includes.","+/// allowlist, and the always-included / `main` / `browser` / `bin` force-includes."," /// This is the per-package packlist with no `bundleDependencies`"," /// traversal; [`collect_bundled_files`] layers the closure on top."," fn collect_own_files(","@@ -173,38 +176,47 @@ fn collect_own_files(","     let files_matcher: Option<Gitignore> = files_field.map(|arr| build_files_matcher(pkg_dir, arr));","     let named_files: BTreeSet<String> =","         files_field.map(|arr| named_file_entries(pkg_dir, arr)).unwrap_or_default();","-    let main_path = manifest.get(\"main\").and_then(Value::as_str);","-    let bin_paths: Vec<&str> = manifest","-        .get(\"bin\")","-        .map(|bin| match bin {","-            Value::String(s) => vec![s.as_str()],","-            Value::Object(map) => map","-                .values()","-                .filter_map(Value::as_str)","-                .collect(),","-            _ => Vec::new(),","-        })","-        .unwrap_or_default();","+    let required_paths = required_field_paths(manifest);"," ","     let mut out: BTreeSet<String> = BTreeSet::new();"," ","     let selection = FileSelection {","         files_matcher: files_matcher.as_ref(),","         named_files: &named_files,","-        main_path,","-        bin_paths: &bin_paths,","+        required_paths: &required_paths,","     };","     let ignore_files = if files_matcher.is_some() {","         IgnoreFiles::SubdirectoriesOnly { named_files: &named_files }","     } else {","-        IgnoreFiles::Read { workspace_dir }","+        IgnoreFiles::Read { workspace_dir, required_paths: &required_paths }","     };","     collect_walked_files(pkg_dir, ignore_files, &selection, &mut out)?;","     collect_always_included_at_root(pkg_dir, &mut out)?;","-    force_include_main_and_bin(pkg_dir, &selection, &mut out);","+    force_include_required_paths(pkg_dir, &selection, &mut out);","     Ok(out)"," }"," ","+/// The [`normalize_field_path`]-ed `main`, `browser`, and `bin` paths that","+/// stay inside the package (see [`is_contained_field_path`]). A non-string","+/// value, such as a `browser` replacement map, is skipped.","+fn required_field_paths(manifest: &Value) -> Vec<String> {","+    let bin_paths = match manifest.get(\"bin\") {","+        Some(Value::String(bin)) => vec![bin.as_str()],","+        Some(Value::Object(map)) => map","+            .values()","+            .filter_map(Value::as_str)","+            .collect(),","+        _ => Vec::new(),","+    };","+    [\"main\", \"browser\"]","+        .into_iter()","+        .filter_map(|field| manifest.get(field).and_then(Value::as_str))","+        .chain(bin_paths)","+        .map(normalize_field_path)","+        .filter(|path| is_contained_field_path(path))","+        .collect()","+}","+"," /// What a package's own manifest says should ship, beyond what the walk finds."," struct FileSelection<'a> {","     /// The `files` allowlist, when the manifest declares one.","@@ -212,8 +224,8 @@ struct FileSelection<'a> {","     /// The `files` entries that name an existing file; they ship even when","     /// another entry excludes the directory holding them.","     named_files: &'a BTreeSet<String>,","-    main_path: Option<&'a str>,","-    bin_paths: &'a [&'a str],","+    /// See [`required_field_paths`].","+    required_paths: &'a [String],"," }"," "," /// Pass 1: every walked file the ignore rules and the `files` allowlist keep.","@@ -256,7 +268,9 @@ fn walked_file_is_excluded(rel: &str, selection: &FileSelection<'_>) -> bool {","     }","     !files_field_includes(matcher, rel, selection.named_files)","         && !is_always_included_at_root(rel)","-        && !is_main_or_bin(rel, selection.main_path, selection.bin_paths)","+        && !selection.required_paths","+            .iter()","+            .any(|path| path == rel)"," }"," "," /// Pass 2: scan the root for always-included names (README, LICENSE, etc.)","@@ -313,30 +327,26 @@ fn collect_root_files_matching(","     Ok(())"," }"," ","-/// Pass 3: force-include `main` / `bin` paths, which always ship regardless of","-/// `.npmignore`. (A `files`-field rejection is already overridden in pass 1.)","+/// Pass 3: force-include `main` / `browser` / `bin` paths, which always ship","+/// regardless of `.npmignore`. (A `files`-field rejection is already overridden in pass 1.)"," /// [`should_always_exclude`] is still consulted first so the always-excluded set"," /// wins over manifest fields; npm-packlist does the same and emits no warning,"," /// so this stays silent too — a `tracing::debug!` would be lost in install"," /// logs. An ignore file ships this way only at the package root: npm-packlist","-/// re-applies its default rules in each subdirectory, after the `main` / `bin`","-/// rules the root adds.","-fn force_include_main_and_bin(","+/// re-applies its default rules in each subdirectory, after the rules the root","+/// adds for these paths.","+fn force_include_required_paths(","     pkg_dir: &Path,","     selection: &FileSelection<'_>,","     out: &mut BTreeSet<String>,"," ) {","-    let declared = selection.main_path","-        .into_iter()","-        .chain(selection.bin_paths.iter().copied());","-    for path in declared {","-        let normalized = normalize_field_path(path);","-        if is_contained_field_path(&normalized)","-            && !should_always_exclude(&normalized)","-            && !(is_ignore_file(&normalized) && normalized.contains('/'))","-            && is_regular_file_within(pkg_dir, &pkg_dir.join(&normalized))","+    for path in selection.required_paths {","+        let is_nested_ignore_file = is_ignore_file(path) && path.contains('/');","+        if !should_always_exclude(path)","+            && !is_nested_ignore_file","+            && is_regular_file_within(pkg_dir, &pkg_dir.join(path))","         {","-            out.insert(normalized);","+            out.insert(path.clone());","         }","     }"," }","@@ -367,16 +377,6 @@ fn is_always_included_at_root(rel: &str) -> bool {","         })"," }"," ","-fn is_main_or_bin(rel: &str, main: Option<&str>, bins: &[&str]) -> bool {","-    if let Some(main) = main","-        && normalize_field_path(main) == rel","-    {","-        return true;","-    }","-    bins.iter()","-        .any(|bin| normalize_field_path(bin) == rel)","-}","-"," fn should_always_exclude(rel: &str) -> bool {","     let basename = rel.rsplit('/').next().unwrap_or(rel);","     if ALWAYS_EXCLUDED_BASENAMES.contains(&basename) {","@@ -410,7 +410,7 @@ fn relative_forward_slash(root: &Path, full: &Path) -> String {","     buf"," }"," ","-/// Whether a [`normalize_field_path`]-ed `main` / `bin` value stays inside","+/// Whether a [`normalize_field_path`]-ed `main` / `browser` / `bin` value stays inside"," /// the package: non-empty, only normal path components (no `..`, root, or"," /// drive/UNC prefix), and no backslash (a separator on Windows, where the"," /// git fetcher may import a package). The packlist feeds both `pack` and"],"additions":48,"deletions":48,"truncated":false},{"path":"pnpm/crates/fs-packlist/src/tests/runtime.rs","lines":["@@ -41,6 +41,109 @@ fn main_and_bin_paths_are_force_included_under_files_field() {","     assert!(out.contains(&\"dist/index.js\".to_string()));"," }"," ","+/// npm-packlist re-includes `main` / `browser` / `bin` with root rules that","+/// also re-include the ignored directories holding them, so their whole","+/// contents ship. Expected lists recorded from `npm pack --dry-run`.","+#[test]","+fn main_browser_and_bin_reinclude_ignored_directories() {","+    let cases = [","+        (","+            \".gitignore\",","+            \"dist/\\nout/\\n\",","+            json!({ \"main\": \"dist/lib/app.js\", \"browser\": \"out/browser.js\" }),","+        ),","+        (","+            \".gitignore\",","+            \"dist\\nout\\n\",","+            json!({ \"main\": \"dist/lib/app.js\", \"bin\": { \"x\": \"out/browser.js\" } }),","+        ),","+        (","+            \".npmignore\",","+            \"dist/\\nout/\\n\",","+            json!({ \"main\": \"dist/lib/app.js\", \"bin\": \"out/browser.js\" }),","+        ),","+    ];","+    for (ignore_file, ignore_rules, manifest) in cases {","+        let dir = tempdir().unwrap();","+        let root = dir.path();","+        touch(root, \"package.json\");","+        touch(root, \"dist/lib/app.js\");","+        touch(root, \"dist/lib/other.js\");","+        touch(root, \"dist/top.js\");","+        touch(root, \"out/browser.js\");","+        touch(root, \"out/chunk.js\");","+        touch(root, \"src/a.ts\");","+        write(root, ignore_file, ignore_rules);","+","+        let mut out = packlist(root, &manifest).unwrap();","+        out.sort();","+","+        assert_eq!(","+            out,","+            [","+                \"dist/lib/app.js\",","+                \"dist/lib/other.js\",","+                \"dist/top.js\",","+                \"out/browser.js\",","+                \"out/chunk.js\",","+                \"package.json\",","+                \"src/a.ts\",","+            ],","+            \"{ignore_file}: {ignore_rules:?}, manifest: {manifest}\",","+        );","+    }","+}","+","+#[test]","+fn browser_path_is_force_included_under_files_field() {","+    let dir = tempdir().unwrap();","+    let root = dir.path();","+    touch(root, \"package.json\");","+    touch(root, \"dist/top.js\");","+    touch(root, \"out/browser.js\");","+    touch(root, \"out/chunk.js\");","+    write(root, \".gitignore\", \"out/\\n\");","+","+    let manifest = json!({ \"files\": [\"dist/top.js\"], \"browser\": \"out/browser.js\" });","+    let mut out = packlist(root, &manifest).unwrap();","+    out.sort();","+","+    assert_eq!(out, [\"dist/top.js\", \"out/browser.js\", \"package.json\"]);","+}","+","+#[test]","+fn browser_replacement_map_is_not_a_required_path() {","+    let dir = tempdir().unwrap();","+    let root = dir.path();","+    touch(root, \"package.json\");","+    touch(root, \"index.js\");","+    touch(root, \"out/browser.js\");","+    write(root, \".gitignore\", \"out/\\n\");","+","+    let manifest = json!({ \"browser\": { \"./index.js\": \"./out/browser.js\" } });","+    let mut out = packlist(root, &manifest).unwrap();","+    out.sort();","+","+    assert_eq!(out, [\"index.js\", \"package.json\"]);","+}","+","+#[test]","+fn required_paths_match_literally() {","+    let dir = tempdir().unwrap();","+    let root = dir.path();","+    touch(root, \"package.json\");","+    touch(root, \"a.txt\");","+    touch(root, \"dist/[id].js\");","+    touch(root, \"dist/chunk.js\");","+    write(root, \".npmignore\", \"*.txt\\ndist/\\n\");","+","+    let manifest = json!({ \"main\": \"*.txt\", \"bin\": \"dist/[id].js\" });","+    let mut out = packlist(root, &manifest).unwrap();","+    out.sort();","+","+    assert_eq!(out, [\"dist/[id].js\", \"dist/chunk.js\", \"package.json\"]);","+}","+"," #[test]"," fn bin_field_pointing_at_vcs_segment_is_refused() {","     // Uses a basename inside a `.git` segment to hit the dir-segment",""],"additions":103,"deletions":0,"truncated":false}],"additions":204,"deletions":51,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-14T13:04:54.986688+00:00"}