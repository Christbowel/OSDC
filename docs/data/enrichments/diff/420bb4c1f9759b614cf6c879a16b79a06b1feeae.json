sion/core_functions/scalar/list/list_transform.cpp","lines":["@@ -3,6 +3,9 @@"," #include \"duckdb/function/lambda_functions.hpp\""," #include \"duckdb/planner/expression/bound_cast_expression.hpp\""," #include \"duckdb/planner/expression/bound_lambda_expression.hpp\"","+#include \"duckdb/planner/expression/bound_function_expression.hpp\"","+#include \"duckdb/planner/filter/expression_filter.hpp\"","+#include \"duckdb/storage/statistics/list_stats.hpp\""," "," namespace duckdb {"," ","@@ -30,6 +33,65 @@ static LogicalType ListTransformBindLambda(ClientContext &context, const vector<"," \treturn LambdaFunctions::BindBinaryChildren(function_child_types, parameter_idx);"," }"," ","+//! Whether the expression is the element, or a monotone function of it whose bounds come only from those of the element","+static bool IsMonotoneInElement(const Expression &expr) {","+\tif (expr.GetExpressionClass() == ExpressionClass::BOUND_REF) {","+\t\treturn true;","+\t}","+\tif (expr.GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {","+\t\treturn false;","+\t}","+\tauto &func = expr.Cast<BoundFunctionExpression>();","+\tauto &children = func.GetChildren();","+\tif (children.size() != 1 || func.Function().HasStatisticsCallback()) {","+\t\treturn false;","+\t}","+\tauto monotonicity = func.Function().GetArgProperties(0).monotonicity;","+\tif (!IsMonotonicIncreasing(monotonicity) && !IsMonotonicDecreasing(monotonicity)) {","+\t\treturn false;","+\t}","+\treturn IsMonotoneInElement(*children[0]);","+}","+","+//! The elements of the result have the statistics of the lambda applied to the elements of the list","+static unique_ptr<BaseStatistics> ListTransformStats(ClientContext &context, FunctionStatisticsInput &input) {","+\t// only a lambda that reads the element alone, without its index or other columns","+\tif (!input.bind_data || input.child_stats.size() != 2) {","+\t\treturn nullptr;","+\t}","+\tauto &bind_data = input.bind_data->Cast<ListLambdaBindData>();","+\tauto &list_sta