ROM s WHERE instr(x, CASE WHEN true THEN NULL ELSE 'a' END) = 1;","+----","+0","+","+# a needle that is not NULL is still rewritten to prefix","+query II","+EXPLAIN SELECT instr(x, 'ab') = 1 FROM s;","+----","+physical_plan\t<REGEX>:.*prefix.*","+","+query I","+SELECT instr(x, 'ab') = 1 FROM s ORDER BY x;","+----","+true","+false"],"additions":35,"deletions":0,"truncated":false},{"path":"test/optimizer/statistics/right_semi_join_filter.test","lines":["@@ -0,0 +1,50 @@","+# name: test/optimizer/statistics/right_semi_join_filter.test","+# description: The statistics of one side of a RIGHT_SEMI join filter the other side, also below a DISTINCT (duckdblabs/bot-issue-tracker#491)","+# group: [statistics]","+","+statement ok","+CREATE TABLE probe(k INTEGER);","+","+statement ok","+INSERT INTO probe VALUES (5), (7), (NULL), (200000);","+","+statement ok","+CREATE TABLE build AS SELECT i::INTEGER AS k FROM range(100000) r(i) UNION ALL SELECT NULL;","+","+# the smaller probe table becomes the build side, and its keys filter the scan below the DISTINCT","+query II","+EXPLAIN SELECT count(*) FROM probe WHERE k IN (SELECT DISTINCT k FROM build);","+----","+physical_plan\t<REGEX>:.*RIGHT_SEMI.*Hash Group By.*Filters: k <= 99999.*Filters: k >= 5.*","+","+query II","+EXPLAIN SELECT count(*) FROM probe WHERE k IN (SELECT k FROM build GROUP BY k);","+----","+physical_plan\t<REGEX>:.*RIGHT_SEMI.*Hash Group By.*Filters: k <= 99999.*Filters: k >= 5.*","+","+query I","+SELECT count(*) FROM probe WHERE k IN (SELECT DISTINCT k FROM build);","+----","+2","+","+query I","+SELECT count(*) FROM probe WHERE k IN (SELECT k FROM build GROUP BY k);","+----","+2","+","+query I","+SELECT k FROM probe WHERE EXISTS (SELECT 1 FROM (SELECT DISTINCT k FROM build) b WHERE b.k = probe.k) ORDER BY k;","+----","+5","+7","+","+query I","+SELECT count(*) FROM probe WHERE k NOT IN (SELECT DISTINCT k FROM build WHERE k IS NOT NULL);","+----","+1","+","+query I","+SELECT k FROM (SELECT DISTINCT k FROM build) b WHERE k IN (SELECT k FROM probe) ORDER BY k;","+----","+5","+7"],"additions":50,"deletions":0,"truncated":false},{"path":"test/sql/collate/test_default_collation_functions.test","lines":["@@ -0,0 +1,64 @@","+# name: test/sql/collate/test_default_collation_functions.test","+# description: functions that push combinable collations apply the default collation like an explicit one","+# group: [collate]","+","+statement ok","+CREATE TABLE strings AS SELECT i, CASE WHEN i % 2 = 0 THEN 'ABC' ELSE 'xyz' END AS s FROM range(5000) t(i);","+","+# without a default collation the comparison stays binary","+query IIIIII","+SELECT contains('ABC', 'b'), 'ABC' LIKE '%b%', starts_with('ABC', 'a'), 'ABC' GLOB '*b*', instr('ABC', 'b'), list_contains(['A'], 'a')","+----","+false\tfalse\tfalse\tfalse\t0\tfalse","+","+# a statement prepared before the setting changes follows it","+statement ok","+PREPARE contains_b AS SELECT contains(?, 'b');","+","+statement ok","+SET default_collation = 'nocase';","+","+query I","+EXECUTE contains_b('ABC')","+----","+true","+","+query IIIIIII","+SELECT contains('ABC', 'b'), 'ABC' LIKE '%b%', starts_with('ABC', 'a'), 'ABC' GLOB '*b*', instr('ABC', 'b'), list_contains(['A'], 'a'), 'A' = 'a'","+----","+true\ttrue\ttrue\ttrue\t2\ttrue\ttrue","+","+# the same as with an explicit collation, also for columns over more than one vector","+query IIII","+SELECT count(*) FILTER (WHERE contains(s, 'b')), count(*) FILTER (WHERE s LIKE 'a%'), count(*) FILTER (WHERE starts_with(s, 'XY')),","+       count(*) FILTER (WHERE contains(s, 'b') = contains(s COLLATE NOCASE, 'b'))","+FROM strings","+----","+2500\t2500\t2500\t5000","+","+query I","+SELECT count(*) FROM strings WHERE list_contains(['abc'], s)","+----","+2500","+","+query IIIII","+SELECT list_position(['x', 'A'], 'a'), 'ABC' NOT LIKE '%b%', 'ABC' NOT ILIKE '%b%', 'A_C' LIKE 'aX_c' ESCAPE 'X',","+       ('A_C' LIKE 'aX_c' ESCAPE 'X') = ('A_C' COLLATE NOCASE LIKE 'aX_c' ESCAPE 'X')","+----","+2\tfalse\tfalse\ttrue\ttrue","+","+statement ok","+SET default_collation = 'noaccent.nocase';","+","+query II","+SELECT contains('HÉLLO', 'e'), list_contains(['héllo'], 'HELLO')","+----","+true\ttrue","+","+statement ok","+RESET default_collation;","+","+query II","+SELECT contains('ABC', 'b'), list_contains(['A'], 'a')","+----","+false\tfalse"],"additions":64,"deletions":0,"truncated":false},{"path":"test/sql/function/generic/hash_comparison_keys.test","lines":["@@ -0,0 +1,195 @@","+# name: test/sql/function/generic/hash_comparison_keys.test","+# description: values that compare equal hash equally, for VARIANT, combinable string collations, TIMETZ, BIT and INTERVAL","+# group: [generic]","+","+load {TEST_DIR}/hash_comparison_keys.db","+","+statement ok","+CREATE TABLE vals AS SELECT * FROM (VALUES (1::TINYINT::VARIANT, 'i8'), (1::BIGINT::VARIANT, 'i64'), (1::UINTEGER::VARIANT, 'u32'), (1.00::DECIMAL(5,2)::VARIANT, 'dec'), (1::BIGNUM::VARIANT, 'bignum'), (1.0::DOUBLE::VARIANT, 'dbl'), (1.0::FLOAT::VARIANT, 'flt'), (2::INTEGER::VARIANT, 'two'), ('1'::VARIANT, 'str')) t(v, label);","+","+# equality puts the integers, decimal and bignum in one class, and the float and double in another","+query I","+SELECT count(*) FROM vals a JOIN vals b ON a.v = b.v","+----","+31","+","+query I","+SELECT count(*) FROM vals a JOIN vals b ON a.v = b.v WHERE hash(a.v) <> hash(b.v)","+----","+0","+","+query I","+SELECT count(*) FROM vals a JOIN vals b ON hash(a.v) = hash(b.v) WHERE a.v <> b.v","+----","+0","+","+query III","+SELECT count(DISTINCT v), count(DISTINCT hash(v)), count(DISTINCT hash(v, label = 'two'))","+FROM vals","+----","+4\t4\t4","+","+query II","+SELECT list(label ORDER BY label), count(*) FROM vals GROUP BY hash(v) ORDER BY ALL","+----","+[bignum, dec, i64, i8, u32]\t5","+[dbl, flt]\t2","+[str]\t1","+[two]\t1","+","+# nested values","+query III","+SELECT hash({'a': 1::TINYINT::VARIANT, 'b': 'x'}) = hash({'a': 1::BIGINT::VARIANT, 'b': 'x'}),","+       hash([1::TINYINT::VARIANT, NULL]) = hash([1.00::DECIMAL(5,2)::VARIANT, NULL]),","+       hash([1::UINTEGER::VARIANT, 2::INTEGER::VARIANT]::VARIANT[2]) = hash([1::BIGNUM::VARIANT, 2.0::DECIMAL(3,1)::VARIANT]::VARIANT[2])","+----","+true\ttrue\ttrue","+","+query II","+SELECT hash({'a': 1::TINYINT, 'b': [2::SMALLINT]}::VARIANT) = hash({'b': [2::BIGINT], 'a': 1::INTEGER}::VARIANT),","+       hash({'a': 1}::VARIANT) = hash({'a': 2}::VARIANT)","+----","+true\tfalse","+","+query II","+SELECT hash(1::TINYINT::VARIANT, 'x') = hash(1::BIGINT::VARIANT, 'x'), hash(0, 'x', 1::TINYINT::VARIANT) = hash(0, 'x', 1::BIGINT::VARIANT)","+----","+true\ttrue","+","+# NULL hashes like the NULL of any other type","+query II","+SELECT hash(NULL::VARIANT) = hash(NULL), hash({'a': NULL::VARIANT}) = hash({'a': NULL::INTEGER})","+----","+true\ttrue","+","+# nested values in a table, with NULL containers, empty lists and NULL elements","+statement ok","+CREATE TABLE nested AS SELECT * FROM (VALUES","+\t(1, [1::TINYINT::VARIANT, NULL], {'a': 1::TINYINT::VARIANT, 'b': [2::SMALLINT::VARIANT]}, (1::TINYINT::VARIANT, 'x')),","+\t(2, [1.00::DECIMAL(5,2)::VARIANT, NULL], {'a': 1::BIGINT::VARIANT, 'b': [2.0::DECIMAL(3,1)::VARIANT]}, (1::BIGNUM::VARIANT, 'x')),","+\t(3, [], {'a': NULL, 'b': []}, (NULL, NULL)),","+\t(4, [], {'a': NULL, 'b': []}, (NULL, NULL)),","+\t(5, NULL, NULL, NULL),","+\t(6, NULL, NULL, NULL)","+) t(id, l, s, r);","+","+# rows 1 and 2, 3 and 4, and 5 and 6 are equal","+query I","+SELECT count(*) FROM nested a JOIN nested b ON a.l IS NOT DISTINCT FROM b.l AND a.s IS NOT DISTINCT FROM b.s AND a.r IS NOT DISTINCT FROM b.r","+----","+12","+","+query I","+SELECT count(*) FROM nested a JOIN nested b ON a.l IS NOT DISTINCT FROM b.l AND a.s IS NOT DISTINCT FROM b.s AND a.r IS NOT DISTINCT FROM b.r WHERE hash(a.l, a.s, a.r) <> hash(b.l, b.s, b.r)","+----","+0","+","+query I","+SELECT count(*) FROM (SELECT id, hash(l, s, r) AS h FROM nested WHERE id % 2 = 0) even JOIN (SELECT id, hash(l, s, r) AS h FROM nested WHERE id % 2 = 1) odd ON even.id = odd.id + 1 AND even.h = odd.h","+----","+3","+","+# VARIANT values stored as typed (shredded) columns","+statement ok","+SET variant_minimum_shredding_size = 0;","+","+statement ok","+CREATE TABLE stored AS SELECT i, (i % 3)::TINYINT::VARIANT AS a, (i % 3)::DECIMAL(10, 1)::VARIANT AS b FROM range(5000) t(i);","+","+statement ok","+CHECKPOINT","+","+restart","+","+query I","+SELECT DISTINCT segment_type FROM pragma_storage_info('stored') WHERE segment_type IN ('TINYINT', 'DECIMAL(10,1)') ORDER BY segment_type","+----","+DECIMAL(10,1)","+TINYINT","+","+query II","+SELECT count(*), count(*) FILTER (WHERE hash(a) = hash(b) AND hash(a) = hash((i % 3)::BIGINT::VARIANT))","+FROM stored","+----","+5000\t5000","+","+query I","+SELECT count(DISTINCT hash(v)) FROM (SELECT a AS v FROM stored UNION ALL SELECT b FROM stored)","+----","+3","+","+# collated strings hash their collated value","+query IIII","+SELECT hash('A' COLLATE NOCASE) = hash('a' COLLATE NOCASE), hash('é' COLLATE NOACCENT) = hash('e' COLLATE NOACCENT),","+       hash({'s': 'A' COLLATE NOCASE}) = hash({'s': 'a' COLLATE NOCASE}), hash('A' COLLATE NOCASE) = hash('b' COLLATE NOCASE)","+----","+true\ttrue\ttrue\tfalse","+","+statement ok","+CREATE TABLE collated AS SELECT i, CASE WHEN i % 2 = 0 THEN 'ABC' ELSE 'abc' END::VARCHAR COLLATE NOCASE AS s FROM range(5000) t(i);","+","+query II","+SELECT count(DISTINCT s), count(DISTINCT hash(s)) FROM collated","+----","+1\t1","+","+# TIMETZ, BIT and INTERVAL hash their comparison keys, also at the limits of the interval fields","+query I","+SELECT count(*) FROM (VALUES","+\t(INTERVAL '-2147483648 months -2147483648 days -9223372036854775807 microseconds', INTERVAL '-2147483648 months -2147483648 days -9223372036854775806 microseconds'),","+\t(INTERVAL '-2147483648 months -2147483648 days -9223372036854775807 microseconds', INTERVAL '-2147483648 months -2147483647 days -9223372036854775807 microseconds'),","+\t(INTERVAL '2147483647 months 2147483647 days 9223372036854775806 microseconds', INTERVAL '2147483647 months 2147483647 days 9223372036854775807 microseconds'),","+\t(INTERVAL '1 month', INTERVAL '30 days'),","+\t(INTERVAL '1 month', INTERVAL '31 days')"],"additions":143,"deletions":0,"truncated":false}],"additions":448,"deletions":14,"truncated":true,"file_count":23},"error":null,"fetched_at":"2026-11-02T17:25:39.563615+00:00"}