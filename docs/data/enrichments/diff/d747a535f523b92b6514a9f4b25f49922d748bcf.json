alse,","+\t\t\t\tg: true,","+\t\t\t});","+\t\t});","+","+\t\tit('camel-cases dashed flags and preserves mixed-case flags', () => {","+\t\t\tassert.deepEqual(parser.parse(['dev', '--ignore-lock', '--out-dir=dist', '--noSync']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\tignoreLock: true,","+\t\t\t\toutDir: 'dist',","+\t\t\t\tnoSync: true,","+\t\t\t});","+\t\t});","+","+\t\tit('parses string and numeric option values before and after positionals', () => {","+\t\t\tassert.deepEqual(parser.parse(['--root', 'site', 'dev', '--port', '4321']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\troot: 'site',","+\t\t\t\tport: 4321,","+\t\t\t});","+\t\t\tassert.deepEqual(parser.parse(['dev', '--port', '-1']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\tport: -1,","+\t\t\t});","+\t\t});","+","+\t\tit('collects repeated string options into arrays', () => {","+\t\t\tassert.deepEqual(parser.parse(['dev', '--root', 'first', '--root', 'second']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\troot: ['first', 'second'],","+\t\t\t});","+\t\t});","+","+\t\tit('supports flags that accept either a value or no value', () => {","+\t\t\tassert.deepEqual(parser.parse(['dev', '--host', '--open', '--allowed-hosts']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\thost: true,","+\t\t\t\topen: true,","+\t\t\t\tallowedHosts: true,","+\t\t\t});","+\t\t\tassert.deepEqual(parser.parse(['dev', '--host', '127.0.0.1', '--open', 'docs']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\thost: '127.0.0.1',","+\t\t\t\topen: 'docs',","+\t\t\t});","+\t\t});","+","+\t\tit('accepts unknown options and their values', () => {","+\t\t\tassert.deepEqual(parser.parse(['add', '--custom-value', 'value', 'integration']), {","+\t\t\t\t_: ['add', 'integration'],","+\t\t\t\tcustomValue: 'value',","+\t\t\t});","+\t\t\tassert.deepEqual(parser.parse(['dev', '--custom-value', '123']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\tcustomValue: 123,","+\t\t\t});","+\t\t});","+","+\t\tit('treats arguments after the delimiter as positionals', () => {","+\t\t\tassert.deepEqual(parser.parse(['dev', '--', '--root', 'site']), {","+\t\t\t\t_: ['dev', '--root', 'site'],","+\t\t\t});","+\t\t\tassert.deepEqual(parser.parse(['dev', '--', '--port', '-1']), {","+\t\t\t\t_: ['dev', '--port', '-1'],","+\t\t\t});","+\t\t});","+","+\t\tit('does not consume another option when a value is omitted', () => {","+\t\t\tassert.deepEqual(parser.parse(['dev', '--root', '--force']), {","+\t\t\t\t_: ['dev'],","+\t\t\t\troot: true,","+\t\t\t\tforce: true,","+\t\t\t});","+\t\t});","+\t});","+}"],"additions":98,"deletions":0,"truncated":false},{"path":"packages/astro/test/units/cli/argument-parser.test.ts","lines":["@@ -0,0 +1,5 @@","+import { MriCliArgumentParser } from '../../../dist/cli/infra/mri-cli-argument-parser.js';","+import { cliArgumentParserContract } from './argument-parser.contract.ts';","+","+const parser = new MriCliArgumentParser();","+cliArgumentParserContract(parser);"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -613,6 +613,9 @@ importers:","       magicast:","         specifier: ^0.5.5","         version: 0.5.5","+      mri:","+        specifier: ^1.2.0","+        version: 1.2.0","       mrmime:","         specifier: ^2.0.1","         version: 2.0.1","@@ -682,9 +685,6 @@ importers:","       xxhash-wasm:","         specifier: ^1.1.0","         version: 1.1.0","-      yargs-parser:","-        specifier: ^22.0.0","-        version: 22.0.0","       zod:","         specifier: ^4.6.7","         version: 4.6.7","@@ -713,9 +713,6 @@ importers:","       '@types/picomatch':","         specifier: ^4.0.3","         version: 4.0.3","-      '@types/yargs-parser':","-        specifier: ^21.0.3","-        version: 21.0.3","       astro-scripts:","         specifier: workspace:*","         version: link:../../scripts",""],"additions":3,"deletions":6,"truncated":false}],"additions":163,"deletions":21,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-06T17:00:00.205031+00:00"}