wrap %v\", err, ErrNoSocket)","+\t\t}","+\t\tif calls != 0 {","+\t\t\tt.Errorf(\"fn called %d times, want 0\", calls)","+\t\t}","+\t})","+","+\tt.Run(\"nosocket\", func(t *testing.T) {","+\t\ttype noSocketConn struct{ nettype.PacketConn } // mask syscall.Conn","+\t\tconst sockets = 3","+\t\tfor bad := range sockets {","+\t\t\tpconns := udpConns(t, sockets)","+\t\t\tpconns[bad] = noSocketConn{}","+\t\t\tvar calls int","+\t\t\terr := ControlEach(pconns, func(uintptr) error { calls++; return nil })","+\t\t\tif !errors.Is(err, ErrNoSocket) {","+\t\t\t\tt.Errorf(\"bad=%d: err = %v, want it to wrap %v\", bad, err, ErrNoSocket)","+\t\t\t}","+\t\t\tif calls != 0 {","+\t\t\t\tt.Errorf(\"bad=%d: fn called %d times, want 0\", bad, calls)","+\t\t\t}","+\t\t}","+\t})","+","+\tt.Run(\"eachsocket\", func(t *testing.T) {","+\t\tconst sockets = 4","+\t\tpconns := udpConns(t, sockets)","+\t\twantErr := errors.New(\"boom\")","+\t\t// failAt == sockets doesn't fail.","+\t\tfor failAt := range sockets + 1 {","+\t\t\tvar calls int","+\t\t\terr := ControlEach(pconns, func(uintptr) error {","+\t\t\t\tdefer func() { calls++ }()","+\t\t\t\tif calls == failAt {","+\t\t\t\t\treturn wantErr","+\t\t\t\t}","+\t\t\t\treturn nil","+\t\t\t})","+\t\t\tif calls != sockets {","+\t\t\t\tt.Errorf(\"failAt=%d: fn called %d times, want %d\", failAt, calls, sockets)","+\t\t\t}","+\t\t\tif failAt == sockets {","+\t\t\t\tif err != nil {","+\t\t\t\t\tt.Errorf(\"all sockets succeeded, but err = %v\", err)","+\t\t\t\t}","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif !errors.Is(err, wantErr) {","+\t\t\t\tt.Errorf(\"failAt=%d: err = %v, want it to wrap %v\", failAt, err, wantErr)","+\t\t\t}","+\t\t\tif errors.Is(err, ErrNoSocket) {","+\t\t\t\tt.Errorf(\"failAt=%d: err = %v, want it not to match %v\", failAt, err, ErrNoSocket)","+\t\t\t}","+\t\t}","+\t})","+}"],"additions":89,"deletions":0,"truncated":false},{"path":"shell.nix","lines":["@@ -16,4 +16,4 @@"," ) {","   src =  ./.;"," }).shellNix","-# nix-direnv cache bust