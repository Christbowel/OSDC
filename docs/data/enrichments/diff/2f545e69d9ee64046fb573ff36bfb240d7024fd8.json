{"id":"2f545e69d9ee64046fb573ff36bfb240d7024fd8","axis":"silent","repo":"ray-project/ray","sha":"2f545e69d9ee64046fb573ff36bfb240d7024fd8","parsed":{"files":[{"path":"python/ray/experimental/sandbox/_internal/cgroup.py","lines":["@@ -129,6 +129,37 @@ def _shared_affinity(","     return sorted(sorted(load, key=lambda c: (load[c], c))[:count])"," "," ","+def wrap_command(","+    command: List[str],","+    cgroup: Optional[\"SandboxCgroup\"] = None,","+    oom_score_adj: Optional[int] = None,","+) -> List[str]:","+    \"\"\"Apply sandbox placement and OOM priority in a child launcher.","+","+    Args:","+        command: The workload to execute.","+        cgroup: The sandbox's cgroup, or None to leave placement unchanged.","+        oom_score_adj: OOM score adjustment, or None to inherit it.","+","+    Returns:","+        The wrapped command, or the original when no changes are requested.","+    \"\"\"","+    if cgroup is None and oom_score_adj is None:","+        return command","+    launcher = Path(__file__).with_name(\"cgroup_launcher.py\")","+    args = [","+        sys.executable,","+        \"-S\",","+        str(launcher),","+        str(cgroup.path) if cgroup is not None else \"\",","+    ]","+    if cgroup is not None and cgroup.affinity:","+        args.extend([\"--cpus\", _cpu_list(set(cgroup.affinity))])","+    if oom_score_adj is not None:","+        args.extend([\"--oom-score-adj\", str(oom_score_adj)])","+    return [*args, *command]","+","+"," class SandboxCgroup:","     \"\"\"An enforced sandbox budget.\"\"\""," ","@@ -143,9 +174,7 @@ def __init__(","         self.affinity = affinity or []"," ","     def wrap(self, command: List[str]) -> List[str]:","-        launcher = Path(__file__).with_name(\"cgroup_launcher.py\")","-        cpus = [\"--cpus\", _cpu_list(set(self.affinity))] if self.affinity else []","-        return [sys.executable, \"-S\", str(launcher), str(self.path), *cpus, *command]","+        return wrap_command(command, self)"," ","     def verify(self, pid: int) -> None:","         for name, value in self.limits.items():"],"additions":32,"deletions":3,"truncated":false},{"path":"python/ray/experimental/sandbox/_internal/cgroup_launcher.py","lines":["@@ -1,4 +1,4 @@","-\"\"\"Join an already configured sandbox cgroup before executing any workload.","+\"\"\"Apply a sandbox's cgroup, CPU affinity and OOM priority before execution."," "," Execute this file directly with Python -S. It must not import Ray, spawn"," children, or start threads before entering the cgroup. Unlike preexec_fn,","@@ -22,12 +22,19 @@ def main() -> None:","     cpus = None","     if command[:1] == [\"--cpus\"]:","         cpus, command = _cpus(command[1]), command[2:]","+    oom_score_adj = None","+    if command[:1] == [\"--oom-score-adj\"]:","+        oom_score_adj, command = int(command[1]), command[2:]","     if not command:","         raise ValueError(\"A sandbox launch command is required\")","-    with os.fdopen(","-        os.open(os.path.join(cgroup, \"cgroup.procs\"), os.O_WRONLY), \"w\"","-    ) as stream:","-        stream.write(str(os.getpid()))","+    if cgroup:","+        with os.fdopen(","+            os.open(os.path.join(cgroup, \"cgroup.procs\"), os.O_WRONLY), \"w\"","+        ) as stream:","+            stream.write(str(os.getpid()))","+    if oom_score_adj is not None:","+        with open(\"/proc/self/oom_score_adj\", \"w\", encoding=\"utf-8\") as stream:","+            stream.write(str(oom_score_adj))","     if cpus:","         # gVisor sizes the sandbox's vCPUs from these CPUs, and every process","         # the command starts inherits them."],"additions":12,"deletions":5,"truncated":false},{"path":"python/ray/experimental/sandbox/backend/checkpoint_utils.py","lines":["@@ -203,6 +203,7 @@ def create_manifest(","             \"cidr_allowlist\": cidr_allowlist,","             \"disk\": config.disk,","             \"mounts\": config.mounts,","+            \"oom_score_adj\": config.oom_score_adj,","             