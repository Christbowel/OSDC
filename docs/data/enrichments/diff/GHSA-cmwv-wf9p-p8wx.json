{"id":"GHSA-cmwv-wf9p-p8wx","axis":"advisories","repo":"GeiserX/genieacs-mcp","sha":"577306d78190622eee97e362b042a69499ef373f","parsed":{"files":[{"path":".env.example","lines":["@@ -7,4 +7,13 @@ ACS_PASS="," # DEVICE_LIMIT=500"," "," # HTTP listen address (only used when TRANSPORT is not stdio, default 127.0.0.1:8080)","-# MCP_LISTEN_ADDR=127.0.0.1:8080","\\ No newline at end of file","+# MCP_LISTEN_ADDR=127.0.0.1:8080","+","+# Bearer token for HTTP transport auth. Required when MCP_LISTEN_ADDR is non-loopback.","+# MCP_AUTH_TOKEN=","+","+# DNS-rebinding protection (HTTP transport). Loopback Host/Origin values are","+# always accepted. Add extra comma-separated names if you expose the server","+# behind a reverse proxy or hostname, or to allow a browser-based MCP client.","+# MCP_ALLOWED_HOSTS=acs.example.com","+# MCP_ALLOWED_ORIGINS=https://my-ai-app.com","\\ No newline at end of file"],"additions":10,"deletions":1,"truncated":false},{"path":"README.md","lines":["@@ -79,6 +79,17 @@ go run ./cmd/server"," | `DEVICE_LIMIT` | 500 | Max devices returned by `genieacs://devices/list` |"," | `MCP_LISTEN_ADDR` | 127.0.0.1:8080 | HTTP listen address (only used when TRANSPORT is not stdio) |"," | `MCP_AUTH_TOKEN` | _(empty)_ | Bearer token for HTTP transport auth. **Required** when `MCP_LISTEN_ADDR` is non-loopback |","+| `MCP_ALLOWED_HOSTS` | _(empty)_ | Comma-separated extra `Host` header values to accept (e.g. a reverse-proxy domain). Loopback names on the listen port are always allowed |","+| `MCP_ALLOWED_ORIGINS` | _(empty)_ | Comma-separated extra browser `Origin` values to accept (e.g. `https://my-ai-app.com`) |","+","+> **Security — HTTP transport.** The HTTP transport validates the `Host` and","+> `Origin` headers on every request to prevent [DNS rebinding](https://en.wikipedia.org/wiki/DNS_rebinding)","+> from a malicious web page reaching a local listener. Requests with an","+> untrusted `Host`, or a present-but-untrusted `Origin`, are rejected with","+> `403`. Loopback access works with no configuration; if you expose the server","+> through a reverse proxy or a hostname, add that name to `MCP_ALLOWED_HOSTS`","+> (and `MCP_ALLOWED_ORIGINS` for browser clients). The `stdio` transport is","+> unaffected and remains the recommended mode for local MCP clients."," "," Put them in a `.env` file (from `.env.example`) or set them in the environment. "," "],"additions":11,"deletions":0,"truncated":false},{"path":"cmd/server/main.go","lines":["@@ -3,11 +3,16 @@ package main"," import ("," \t\"context\""," \t\"crypto/subtle\"","+\t\"errors\"","+\t\"io\""," \t\"log\""," \t\"net\""," \t\"net/http\""," \t\"os\"","+\t\"os/signal\""," \t\"strings\"","+\t\"syscall\"","+\t\"time\""," "," \t\"github.com/geiserx/genieacs-mcp/client\""," \t\"github.com/geiserx/genieacs-mcp/config\"","@@ -30,6 +35,140 @@ func isLoopbackAddr(addr string) bool {"," \treturn ip != nil && ip.IsLoopback()"," }"," ","+func isWildcardHost(host string) bool {","+\tswitch host {","+\tcase \"\", \"0.0.0.0\", \"::\", \"[::]\":","+\t\treturn true","+\t}","+\treturn false","+}","+","+// splitList parses a comma-separated environment value into a trimmed,","+// non-empty slice.","+func splitList(v string) []string {","+\tvar out []string","+\tfor _, item := range strings.Split(v, \",\") {","+\t\tif item = strings.TrimSpace(item); item != \"\" {","+\t\t\tout = append(out, item)","+\t\t}","+\t}","+\treturn out","+}","+","+// allowedHostSet builds the set of acceptable Host header values for a","+// listener on addr. Loopback names on the listen port are always trusted so","+// the documented local setup works with zero configuration. A concrete","+// (non-wildcard) bind host is trusted as well, and operators can add extra","+// names — e.g. a reverse-proxy domain — via MCP_ALLOWED_HOSTS.","+func allowedHostSet(addr string, extra []string) map[string]bool {","+\tset := map[string]bool{}","+\thost, port, err := net.SplitHostPort(addr)","+\tif err == nil && port != \"\" {","+\t\tfor _, h := range []string{\"127.0.0.1\", \"localhost\", \"::1\"} {","+\t\t\tset[net.JoinHostPort(h, port)] = true","+\t\t}","+\t\tif !isWildcardHost(host) {","+\t\t\tset[net.JoinHostPort(host, port)] = true","+\t\t}","+\t}","+\tfor _, h := range extra {","+\t\tset[h] = true","+\t}","+\treturn set","+}","+","+// allowedOriginSet derives acceptable browser Origin values (http/https) from","+// the allowed hosts, plus any explicit MCP_ALLOWED_ORIGINS entries.","+func allowedOriginSet(hosts map[string]bool, extra []string) map[string]bool {","+\tset := map[string]bool{}","+\tfor h := range hosts {","+\t\tset[\"http://\"+h] = true","+\t\tset[\"https://\"+h] = true","+\t}","+\tfor _, o := range extra {","+\t\tset[strings.TrimRight(o, \"/\")] = true","+\t}","+\treturn set","+}","+","+// dnsRebindGuard rejects requests whose Host header is not in the allowed set,","+// and requests carrying an Origin that is not allowed. This blocks DNS","+// rebinding: after a rebind the browser still sends the attacker's Host/Origin","+// (e.g. \"attacker.example:8080\"), which is not trusted. A missing Origin is","+// permitted because non-browser MCP clients do not send one; the Host check is","+// what stops the browser-driven attack.","+func dnsRebindGuard(next http.Handler, hosts, origins map[string]bool) http.Handler {","+\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tif !hosts[r.Host] {","+\t\t\thttp.Error(w, \"forbidden: untrusted Host header\", http.StatusForbidden)","+\t\t\treturn","+\t\t}","+\t\tif origin := r.Header.Get(\"Origin\"); origin != \"\" && !origins[strings.TrimRight(origin, \"/\")] {","+\t\t\thttp.Error(w, \"forbidden: untrusted Origin header\", http.StatusForbidden)","+\t\t\treturn","+\t\t}","+\t\tnext.ServeHTTP(w, r)","+\t})","+}","+","+// buildHTTPHandler wraps the MCP handler for the HTTP transport: an outer","+// DNS-rebinding guard (Host/Origin validation derived from addr plus the","+// MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS allowlists) and, when authToken is","+// set, an inner bearer-auth check.","+func buildHTTPHandler(mcpHandler http.Handler, addr, authToken, extraHosts, extraOrigins string) http.Handler {","+\tallowedHosts := allowedHostSet(addr, splitList(extraHosts))","+\tallowedOrigins := allowedOriginSet(allowedHosts, splitList(extraOrigins))","+","+\thandler := mcpHandler","+\tif authToken != \"\" {","+\t\thandler = bearerAuth(handler, authToken)","+\t}","+\treturn dnsRebindGuard(handler, allowedHosts, allowedOrigins)","+}","+","+// httpEnv is the subset of environment configuration the HTTP transport needs.","+type httpEnv struct {","+\taddr          string","+\tauthToken     string","+\tallowedHosts  string","+\tallowedOrigin string","+}","+","+// loadHTTPEnv reads the HTTP-transport settings from the environment, applying","+// the loopback default for the listen address.","+func loadHTTPEnv() httpEnv {","+\taddr := os.Getenv(\"MCP_LISTEN_ADDR\")","+\tif addr == \"\" {","+\t\taddr = \"127.0.0.1:8080\"","+\t}","+\treturn httpEnv{","+\t\taddr:          addr,","+\t\tauthToken:     os.Getenv(\"MCP_AUTH_TOKEN\"),","+\t\tallowedHosts:  os.Getenv(\"MCP_ALLOWED_HOSTS\"),","+\t\tallowedOrigin: os.Getenv(\"MCP_ALLOWED_ORIGINS\"),","+\t}","+}","+","+// newHTTPServer builds the listening address and *http.Server for the HTTP","+// transport, mounting the guarded MCP handler at /mcp. It returns an error","+// when an auth token is required (non-loopback listener) but absent, so the","+// caller can decide how to fail. The returned server is not yet listening.","+func newHTTPServer(mcpHandler http.Handler, env httpEnv) (string, *http.Server, error) {","+\tif env.authToken == \"\" && !isLoopbackAddr(env.addr) {","+\t\treturn \"\", nil, errAuthTokenRequired","+\t}","+","+\t// Validate Host/Origin on every request to prevent DNS rebinding from a","+\t// malicious web page reaching this listener (GHSA-cmwv-wf9p-p8wx).","+\thandler := buildHTTPHandler(mcpHandler, env.addr, env.authToken, env.allowedHosts, env.allowedOrigin)","+","+\tmux := http.NewServeMux()","+\tmux.Handle(\"/mcp\", handler)","+\treturn env.addr, &http.Server{Addr: env.addr, Handler: mux}, nil","+}","+","+var errAuthTokenRequired = errors.New(\"MCP_AUTH_TOKEN is required when MCP_LISTEN_ADDR is not loopback\")","+"," func bearerAuth(next http.Handler, token string) http.Handler {"," \treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {"," \t\tgot := strings.TrimPrefix(r.Header.Get(\"Authorization\"), \"Bearer \")","@@ -41,12 +180,9 @@ func bearerAuth(next http.Handler, token string) http.Handler {"," \t})"," }"," ","-func main() {","-\tlog.Printf(\"GenieACS MCP %s starting…\", version.String())","-\t// Load config & initialise GenieACS client","-\tcfg := config.LoadACSConfig()","-\tacs := client.NewACS(cfg.BaseURL, cfg.User, cfg.Pass)","-\t// Create MCP server","+// newMCPServer builds the MCP server with all GenieACS resources and tools","+// registered against acs.","+func newMCPServer(acs *client.ACSClient, deviceLimit int) *server.MCPServer {"," \ts := server.NewMCPServer("," \t\t\"GenieACS MCP Bridge\","," \t\tversion.Version,","@@ -58,7 +194,7 @@ func main() {"," \tresources.RegisterDevice(s, acs)"," \tresources.RegisterFile(s, acs)"," \tresources.RegisterTasks(s, acs)","-\tresources.RegisterCatalogue(s, acs, cfg.DeviceLimit)","+\tresources.RegisterCatalogue(s, acs, deviceLimit)"," \tresources.RegisterPresets(s, acs)"," \tresources.RegisterProvisions(s, acs)"," \tresources.RegisterFaults(s, acs)","@@ -81,35 +217,73 @@ func main() {"," \tregister(tools.NewDeleteTask)"," \tregister(tools.NewRetryTask)"," ","-\ttransport := strings.ToLower(os.Getenv(\"TRANSPORT\"))","-\tif transport == \"stdio\" {","-\t\tstdioSrv := server.NewStdioServer(s)","-\t\tlog.Println(\"GenieACS MCP bridge running on stdio\")","-\t\tif err := stdioSrv.Listen(context.Background(), os.Stdin, os.Stdout); err != nil {","-\t\t\tlog.Fatalf(\"stdio server error: %v\", err)","-\t\t}","-\t} else {","-\t\thttpSrv := server.NewStreamableHTTPServer(s)","-\t\taddr := os.Getenv(\"MCP_LISTEN_ADDR\")","-\t\tif addr == \"\" {","-\t\t\taddr = \"127.0.0.1:8080\"","-\t\t}","-\t\tauthToken := os.Getenv(\"MCP_AUTH_TOKEN\")","-\t\tif authToken == \"\" && !isLoopbackAddr(addr) {","-\t\t\tlog.Fatal(\"MCP_AUTH_TOKEN is required when MCP_LISTEN_ADDR is not loopback\")","-\t\t}","-\t\tif authToken != \"\" {","-\t\t\tmux := http.NewServeMux()","-\t\t\tmux.Handle(\"/mcp\", bearerAuth(httpSrv, authToken))","-\t\t\tlog.Printf(\"GenieACS MCP bridge listening on %s (auth enabled)\", addr)","-\t\t\tif err := http.ListenAndServe(addr, mux); err != nil {","-\t\t\t\tlog.Fatalf(\"server error: %v\", err)","-\t\t\t}","-\t\t} else {","-\t\t\tlog.Printf(\"GenieACS MCP bridge listening on %s\", addr)","-\t\t\tif err := httpSrv.Start(addr); err != nil {","-\t\t\t\tlog.Fatalf(\"server error: %v\", err)","-\t\t\t}","+\treturn s","+}","+","+// runStdio serves the MCP server over the stdio transport until ctx is","+// cancelled or the input stream closes.","+func runStdio(ctx context.Context, s *server.MCPServer, in io.Reader, out io.Writer) error {","+\tlog.Println(\"GenieACS MCP bridge running on stdio\")","+\treturn server.NewStdioServer(s).Listen(ctx, in, out)","+}","+","+// serveHTTP starts srv and blocks until ctx is cancelled, then shuts the","+// server down gracefully. A clean shutdown (http.ErrServerClosed) is not","+// treated as an error.","+func serveHTTP(ctx context.Context, srv *http.Server) error {","+\terrCh := make(chan error, 1)","+\tgo func() {","+\t\terr := srv.ListenAndServe()","+\t\tif errors.Is(err, http.ErrServerClosed) {","+\t\t\terr = nil"," \t\t}","+\t\terrCh <- err","+\t}()","+","+\tselect {","+\tcase <-ctx.Done():","+\t\tshutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)","+\t\tdefer cancel()","+\t\treturn srv.Shutdown(shutdownCtx)","+\tcase err := <-errCh:","+\t\treturn err","+\t}","+}","+","+// run wires the MCP server to the requested transport. It is the testable","+// core of main(): all configuration comes from the environment, but the","+// blocking serve loops honour ctx so callers (and tests) can stop them.","+func run(ctx context.Context, s *server.MCPServer, in io.Reader, out io.Writer) error {","+\tif strings.ToLower(os.Getenv(\"TRANSPORT\")) == \"stdio\" {","+\t\treturn runStdio(ctx, s, in, out)","+\t}","+","+\tenv := loadHTTPEnv()","+\taddr, srv, err := newHTTPServer(server.NewStreamableHTTPServer(s), env)","+\tif err != nil {","+\t\treturn err","+\t}","+","+\tauthState := \"no auth token\"","+\tif env.authToken != \"\" {","+\t\tauthState = \"auth enabled\"","+\t}","+\tlog.Printf(\"GenieACS MCP bridge listening on %s/mcp (Host/Origin guard enabled, %s)\", addr, authState)","+\treturn serveHTTP(ctx, srv)","+}","+","+func main() {","+\tlog.Printf(\"GenieACS MCP %s starting…\", version.String())","+\t// Load config & initialise GenieACS client","+\tcfg := config.LoadACSConfig()","+\tacs := client.NewACS(cfg.BaseURL, cfg.User, cfg.Pass)","+\ts := newMCPServer(acs, cfg.DeviceLimit)","+","+\t// Stop cleanly on SIGINT/SIGTERM so containers shut down gracefully.","+\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)","+\tdefer stop()","+","+\tif err := run(ctx, s, os.Stdin, os.Stdout); err != nil {","+\t\tlog.Fatalf(\"server error: %v\", err)"," \t}"," }"],"additions":210,"deletions":36,"truncated":false},{"path":"cmd/server/main_test.go","lines":["@@ -0,0 +1,436 @@","+package main","+","+import (","+\t\"context\"","+\t\"errors\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/geiserx/genieacs-mcp/client\"","+\t\"github.com/mark3labs/mcp-go/server\"","+)","+","+func TestIsLoopbackAddr(t *testing.T) {","+\tcases := map[string]bool{","+\t\t\"127.0.0.1:8080\": true,","+\t\t\"localhost:8080\": true,","+\t\t\"[::1]:8080\":     true,","+\t\t\"0.0.0.0:8080\":   false,","+\t\t\"192.168.1.5:80\": false,","+\t\t\"example.com:80\": false,","+\t\t\"garbage\":        false,","+\t}","+\tfor addr, want := range cases {","+\t\tif got := isLoopbackAddr(addr); got != want {","+\t\t\tt.Errorf(\"isLoopbackAddr(%q) = %v, want %v\", addr, got, want)","+\t\t}","+\t}","+}","+","+func TestAllowedHostSet_LoopbackDefaults(t *testing.T) {","+\thosts := allowedHostSet(\"127.0.0.1:8080\", nil)","+\tfor _, want := range []string{\"127.0.0.1:8080\", \"localhost:8080\", \"[::1]:8080\"} {","+\t\tif !hosts[want] {","+\t\t\tt.Errorf(\"expected host %q to be allowed; set=%v\", want, hosts)","+\t\t}","+\t}","+\tif hosts[\"attacker.example:8080\"] {","+\t\tt.Error(\"attacker host must not be allowed\")","+\t}","+}","+","+func TestAllowedHostSet_WildcardBindStillTrustsLoopback(t *testing.T) {","+\t// Binding 0.0.0.0 must not add a literal \"0.0.0.0:8080\" Host entry, but","+\t// loopback names on the port stay trusted.","+\thosts := allowedHostSet(\"0.0.0.0:8080\", nil)","+\tif hosts[\"0.0.0.0:8080\"] {","+\t\tt.Error(\"wildcard bind host should not be a trusted Host value\")","+\t}","+\tif !hosts[\"127.0.0.1:8080\"] {","+\t\tt.Error(\"loopback host should remain trusted under wildcard bind\")","+\t}","+}","+","+func TestAllowedHostSet_Extra(t *testing.T) {","+\thosts := allowedHostSet(\"127.0.0.1:8080\", []string{\"acs.example.com\"})","+\tif !hosts[\"acs.example.com\"] {","+\t\tt.Error(\"explicit extra host should be allowed\")","+\t}","+}","+","+func TestAllowedOriginSet(t *testing.T) {","+\thosts := allowedHostSet(\"127.0.0.1:8080\", nil)","+\torigins := allowedOriginSet(hosts, []string{\"https://app.example.com/\"})","+\tfor _, want := range []string{\"http://127.0.0.1:8080\", \"https://localhost:8080\"} {","+\t\tif !origins[want] {","+\t\t\tt.Errorf(\"expected origin %q to be derived from hosts\", want)","+\t\t}","+\t}","+\tif !origins[\"https://app.example.com\"] {","+\t\tt.Error(\"explicit origin should be allowed (trailing slash trimmed)\")","+\t}","+\tif origins[\"http://attacker.example:8080\"] {","+\t\tt.Error(\"attacker origin must not be allowed\")","+\t}","+}","+","+func TestSplitList(t *testing.T) {","+\tcases := []struct {","+\t\tin   string","+\t\twant []string","+\t}{","+\t\t{\"\", nil},","+\t\t{\"   \", nil},","+\t\t{\"a\", []string{\"a\"}},","+\t\t{\"a,b , c\", []string{\"a\", \"b\", \"c\"}},","+\t\t{\",,a,,\", []string{\"a\"}},","+\t}","+\tfor _, c := range cases {","+\t\tgot := splitList(c.in)","+\t\tif len(got) != len(c.want) {","+\t\t\tt.Errorf(\"splitList(%q) = %v, want %v\", c.in, got, c.want)","+\t\t\tcontinue","+\t\t}","+\t\tfor i := range got {","+\t\t\tif got[i] != c.want[i] {","+\t\t\t\tt.Errorf(\"splitList(%q)[%d] = %q, want %q\", c.in, i, got[i], c.want[i])","+\t\t\t}","+\t\t}","+\t}","+}","+","+func TestBearerAuth(t *testing.T) {","+\tbackend := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tw.WriteHeader(http.StatusOK)","+\t})","+\th := bearerAuth(backend, \"s3cret\")","+","+\tt.Run(\"valid token\", func(t *testing.T) {","+\t\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\t\treq.Header.Set(\"Authorization\", \"Bearer s3cret\")","+\t\trec := httptest.NewRecorder()","+\t\th.ServeHTTP(rec, req)","+\t\tif rec.Code != http.StatusOK {","+\t\t\tt.Fatalf(\"valid token got %d, want 200\", rec.Code)","+\t\t}","+\t})","+","+\tt.Run(\"wrong token\", func(t *testing.T) {","+\t\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\t\treq.Header.Set(\"Authorization\", \"Bearer nope\")","+\t\trec := httptest.NewRecorder()","+\t\th.ServeHTTP(rec, req)","+\t\tif rec.Code != http.StatusUnauthorized {","+\t\t\tt.Fatalf(\"wrong token got %d, want 401\", rec.Code)","+\t\t}","+\t})","+","+\tt.Run(\"missing token\", func(t *testing.T) {","+\t\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\t\trec := httptest.NewRecorder()","+\t\th.ServeHTTP(rec, req)","+\t\tif rec.Code != http.StatusUnauthorized {","+\t\t\tt.Fatalf(\"missing token got %d, want 401\", rec.Code)","+\t\t}","+\t})","+}","+","+func TestNewMCPServer(t *testing.T) {","+\t// Registering all resources and tools must not panic, and the server must","+\t// be usable as an HTTP handler backend.","+\tacs := client.NewACS(\"http://127.0.0.1:7557\", \"\", \"\")","+\ts := newMCPServer(acs, 500)","+\tif s == nil {","+\t\tt.Fatal(\"newMCPServer returned nil\")","+\t}","+\thttpSrv := server.NewStreamableHTTPServer(s)","+\t_, srv, err := newHTTPServer(httpSrv, httpEnv{addr: \"127.0.0.1:8080\"})","+\tif err != nil || srv == nil {","+\t\tt.Fatalf(\"server build failed: %v\", err)","+\t}","+}","+","+func TestRunStdio_ReturnsOnEOF(t *testing.T) {","+\tacs := client.NewACS(\"http://127.0.0.1:7557\", \"\", \"\")","+\ts := newMCPServer(acs, 500)","+\t// An empty reader is immediately at EOF, so Listen returns cleanly.","+\tdone := make(chan error, 1)","+\tgo func() { done <- runStdio(context.Background(), s, strings.NewReader(\"\"), io.Discard) }()","+\tselect {","+\tcase err := <-done:","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"runStdio returned error: %v\", err)","+\t\t}","+\tcase <-time.After(5 * time.Second):","+\t\tt.Fatal(\"runStdio did not return on EOF\")","+\t}","+}","+","+func TestRun_StdioTransport(t *testing.T) {","+\tt.Setenv(\"TRANSPORT\", \"stdio\")","+\tacs := client.NewACS(\"http://127.0.0.1:7557\", \"\", \"\")","+\ts := newMCPServer(acs, 500)","+\tdone := make(chan error, 1)","+\tgo func() { done <- run(context.Background(), s, strings.NewReader(\"\"), io.Discard) }()","+\tselect {","+\tcase err := <-done:","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"run(stdio) returned error: %v\", err)","+\t\t}","+\tcase <-time.After(5 * time.Second):","+\t\tt.Fatal(\"run(stdio) did not return on EOF\")","+\t}","+}","+","+func TestRun_HTTPTransport_ShutsDownOnContextCancel(t *testing.T) {","+\tt.Setenv(\"TRANSPORT\", \"\")","+\tt.Setenv(\"MCP_LISTEN_ADDR\", \"127.0.0.1:0\") // ephemeral port, avoids clashes","+\tt.Setenv(\"MCP_AUTH_TOKEN\", \"\")","+\tacs := client.NewACS(\"http://127.0.0.1:7557\", \"\", \"\")","+\ts := newMCPServer(acs, 500)","+","+\tctx, cancel := context.WithCancel(context.Background())","+\tdone := make(chan error, 1)","+\tgo func() { done <- run(ctx, s, nil, nil) }()","+","+\t// Give the listener a moment to start, then cancel for graceful shutdown.","+\ttime.Sleep(200 * time.Millisecond)","+\tcancel()","+","+\tselect {","+\tcase err := <-done:","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"run(http) returned error on shutdown: %v\", err)","+\t\t}","+\tcase <-time.After(5 * time.Second):","+\t\tt.Fatal(\"run(http) did not shut down on context cancel\")","+\t}","+}","+","+func TestRun_HTTPTransport_AuthRequiredError(t *testing.T) {","+\tt.Setenv(\"TRANSPORT\", \"\")","+\tt.Setenv(\"MCP_LISTEN_ADDR\", \"0.0.0.0:0\")","+\tt.Setenv(\"MCP_AUTH_TOKEN\", \"\")","+\tacs := client.NewACS(\"http://127.0.0.1:7557\", \"\", \"\")","+\ts := newMCPServer(acs, 500)","+\terr := run(context.Background(), s, nil, nil)","+\tif !errors.Is(err, errAuthTokenRequired) {","+\t\tt.Fatalf(\"run() err = %v, want errAuthTokenRequired\", err)","+\t}","+}","+","+func TestServeHTTP_GracefulShutdown(t *testing.T) {","+\tsrv := &http.Server{","+\t\tAddr: \"127.0.0.1:0\",","+\t\tHandler: http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\t\tw.WriteHeader(http.StatusOK)","+\t\t}),","+\t}","+\tctx, cancel := context.WithCancel(context.Background())","+\tdone := make(chan error, 1)","+\tgo func() { done <- serveHTTP(ctx, srv) }()","+\ttime.Sleep(150 * time.Millisecond)","+\tcancel()","+\tselect {","+\tcase err := <-done:","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"serveHTTP shutdown error: %v\", err)","+\t\t}","+\tcase <-time.After(5 * time.Second):","+\t\tt.Fatal(\"serveHTTP did not return after cancel\")","+\t}","+}","+","+func TestServeHTTP_ListenError(t *testing.T) {","+\t// An invalid address makes ListenAndServe fail immediately; serveHTTP must","+\t// surface that error rather than hang.","+\tsrv := &http.Server{Addr: \"256.256.256.256:99999\"}","+\terr := serveHTTP(context.Background(), srv)","+\tif err == nil {","+\t\tt.Fatal(\"serveHTTP expected an error for an invalid listen address\")","+\t}","+}","+","+func TestLoadHTTPEnv(t *testing.T) {","+\tt.Setenv(\"MCP_LISTEN_ADDR\", \"\")","+\tt.Setenv(\"MCP_AUTH_TOKEN\", \"\")","+\tt.Setenv(\"MCP_ALLOWED_HOSTS\", \"\")","+\tt.Setenv(\"MCP_ALLOWED_ORIGINS\", \"\")","+\tif env := loadHTTPEnv(); env.addr != \"127.0.0.1:8080\" {","+\t\tt.Errorf(\"default addr = %q, want 127.0.0.1:8080\", env.addr)","+\t}","+","+\tt.Setenv(\"MCP_LISTEN_ADDR\", \"0.0.0.0:9000\")","+\tt.Setenv(\"MCP_AUTH_TOKEN\", \"tok\")","+\tt.Setenv(\"MCP_ALLOWED_HOSTS\", \"a.example\")","+\tt.Setenv(\"MCP_ALLOWED_ORIGINS\", \"https://a.example\")","+\tenv := loadHTTPEnv()","+\tif env.addr != \"0.0.0.0:9000\" || env.authToken != \"tok\" ||","+\t\tenv.allowedHosts != \"a.example\" || env.allowedOrigin != \"https://a.example\" {","+\t\tt.Errorf(\"loadHTTPEnv did not read all vars: %+v\", env)","+\t}","+}","+","+func TestNewHTTPServer(t *testing.T) {","+\tbackend := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tw.WriteHeader(http.StatusOK)","+\t})","+","+\tt.Run(\"loopback without token is allowed and guards /mcp\", func(t *testing.T) {","+\t\taddr, srv, err := newHTTPServer(backend, httpEnv{addr: \"127.0.0.1:8080\"})","+\t\tif err != nil {","+\t\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t\t}","+\t\tif addr != \"127.0.0.1:8080\" || srv == nil || srv.Addr != \"127.0.0.1:8080\" {","+\t\t\tt.Fatalf(\"unexpected addr/srv: addr=%q srv=%v\", addr, srv)","+\t\t}","+\t\t// Legitimate loopback request passes the mounted guard.","+\t\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\t\treq.Host = \"127.0.0.1:8080\"","+\t\trec := httptest.NewRecorder()","+\t\tsrv.Handler.ServeHTTP(rec, req)","+\t\tif rec.Code != http.StatusOK {","+\t\t\tt.Errorf(\"loopback /mcp got %d, want 200\", rec.Code)","+\t\t}","+\t\t// Rebind request is rejected.","+\t\treq2 := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\t\treq2.Host = \"attacker.example:8080\"","+\t\trec2 := httptest.NewRecorder()","+\t\tsrv.Handler.ServeHTTP(rec2, req2)","+\t\tif rec2.Code != http.StatusForbidden {","+\t\t\tt.Errorf(\"rebind /mcp got %d, want 403\", rec2.Code)","+\t\t}","+\t})","+","+\tt.Run(\"non-loopback without token errors\", func(t *testing.T) {","+\t\t_, _, err := newHTTPServer(backend, httpEnv{addr: \"0.0.0.0:8080\"})","+\t\tif !errors.Is(err, errAuthTokenRequired) {","+\t\t\tt.Fatalf(\"err = %v, want errAuthTokenRequired\", err)","+\t\t}","+\t})","+","+\tt.Run(\"non-loopback with token is allowed\", func(t *testing.T) {","+\t\t_, srv, err := newHTTPServer(backend, httpEnv{addr: \"0.0.0.0:8080\", authToken: \"tok\", allowedHosts: \"acs.example.com\"})","+\t\tif err != nil || srv == nil {","+\t\t\tt.Fatalf(\"unexpected error: %v\", err)","+\t\t}","+\t})","+}","+","+// newGuardedHandler builds the same handler chain as main() for a loopback","+// listener: a 200-returning backend wrapped in the DNS-rebinding guard.","+func newGuardedHandler(addr string) http.Handler {","+\tbackend := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tw.WriteHeader(http.StatusOK)","+\t})","+\thosts := allowedHostSet(addr, nil)","+\torigins := allowedOriginSet(hosts, nil)","+\treturn dnsRebindGuard(backend, hosts, origins)","+}","+","+func TestDNSRebindGuard_AllowsLoopbackClient(t *testing.T) {","+\th := newGuardedHandler(\"127.0.0.1:8080\")","+\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\treq.Host = \"127.0.0.1:8080\"","+\trec := httptest.NewRecorder()","+\th.ServeHTTP(rec, req)","+\tif rec.Code != http.StatusOK {","+\t\tt.Fatalf(\"loopback client got %d, want 200\", rec.Code)","+\t}","+}","+","+func TestDNSRebindGuard_AllowsNonBrowserClientWithoutOrigin(t *testing.T) {","+\t// Trusted Host, no Origin header (typical CLI / LLM MCP client).","+\th := newGuardedHandler(\"127.0.0.1:8080\")","+\treq := httptest.NewRequest(http.MethodPost, \"http://localhost:8080/mcp\", nil)","+\treq.Host = \"localhost:8080\"","+\trec := httptest.NewRecorder()","+\th.ServeHTTP(rec, req)","+\tif rec.Code != http.StatusOK {","+\t\tt.Fatalf(\"non-browser client got %d, want 200\", rec.Code)","+\t}","+}","+","+func TestDNSRebindGuard_BlocksRebindHost(t *testing.T) {","+\t// The exact PoC shape from GHSA-cmwv-wf9p-p8wx: attacker Host + Origin.","+\th := newGuardedHandler(\"127.0.0.1:8080\")","+\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\treq.Host = \"attacker.example:8080\"","+\treq.Header.Set(\"Origin\", \"http://attacker.example:8080\")","+\trec := httptest.NewRecorder()","+\th.ServeHTTP(rec, req)","+\tif rec.Code != http.StatusForbidden {","+\t\tt.Fatalf(\"rebind request got %d, want 403\", rec.Code)","+\t}","+}","+","+func TestDNSRebindGuard_BlocksUntrustedOriginOnTrustedHost(t *testing.T) {","+\t// Host looks local but the browser Origin is the attacker's page.","+\th := newGuardedHandler(\"127.0.0.1:8080\")","+\treq := httptest.NewRequest(http.MethodPost, \"http://127.0.0.1:8080/mcp\", nil)","+\treq.Host = \"127.0.0.1:8080\"","+\treq.Header.Set(\"Origin\", \"https://evil.example\")","+\trec := httptest.NewRecorder()","+\th.ServeHTTP(rec, req)","+\tif rec.Code != http.StatusForbidden {","+\t\tt.Fatalf(\"untrusted-origin request got %d, want 403\", rec.Code)","+\t}","+}","+","+func TestBuildHTTPHandler(t *testing.T) {","+\tbackend := http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {","+\t\tw.WriteHeader(http.StatusOK)","+\t})","+","+\t// request is a helper that runs one request through h.","+\trequest := func(h http.Handler, host, origin, auth string) int {","+\t\treq := httptest.NewRequest(http.MethodPost, \"http://\"+host+\"/mcp\", nil)","+\t\treq.Host = host","+\t\tif origin != \"\" {","+\t\t\treq.Header.Set(\"Origin\", origin)","+\t\t}","+\t\tif auth != \"\" {","+\t\t\treq.Header.Set(\"Authorization\", auth)","+\t\t}","+\t\trec := httptest.NewRecorder()","+\t\th.ServeHTTP(rec, req)","+\t\treturn rec.Code","+\t}","+","+\tt.Run(\"no auth: guard still enforced\", func(t *testing.T) {","+\t\th := buildHTTPHandler(backend, \"127.0.0.1:8080\", \"\", \"\", \"\")","+\t\tif code := request(h, \"127.0.0.1:8080\", \"\", \"\"); code != http.StatusOK {","+\t\t\tt.Errorf(\"loopback request got %d, want 200\", code)","+\t\t}","+\t\tif code := request(h, \"attacker.example:8080\", \"http://attacker.example:8080\", \"\"); code != http.StatusForbidden {","+\t\t\tt.Errorf(\"rebind request got %d, want 403\", code)","+\t\t}","+\t})","+","+\tt.Run(\"auth: guard runs and bearer required\", func(t *testing.T) {","+\t\th := buildHTTPHandler(backend, \"127.0.0.1:8080\", \"tok\", \"\", \"\")","+\t\t// Trusted host but missing token -> 401.","+\t\tif code := request(h, \"127.0.0.1:8080\", \"\", \"\"); code != http.StatusUnauthorized {","+\t\t\tt.Errorf(\"missing token got %d, want 401\", code)","+\t\t}","+\t\t// Trusted host with valid token -> 200.","+\t\tif code := request(h, \"127.0.0.1:8080\", \"\", \"Bearer tok\"); code != http.StatusOK {","+\t\t\tt.Errorf(\"valid token got %d, want 200\", code)","+\t\t}","+\t\t// Untrusted host is rejected before auth is even checked -> 403.","+\t\tif code := request(h, \"attacker.example:8080\", \"\", \"Bearer tok\"); code != http.StatusForbidden {","+\t\t\tt.Errorf(\"untrusted host got %d, want 403\", code)","+\t\t}","+\t})","+","+\tt.Run(\"extra allowlists honoured\", func(t *testing.T) {","+\t\th := buildHTTPHandler(backend, \"127.0.0.1:8080\", \"\", \"acs.example.com\", \"https://app.example.com\")","+\t\tif code := request(h, \"acs.example.com\", \"https://app.example.com\", \"\"); code != http.StatusOK {","+\t\t\tt.Errorf(\"allowlisted host/origin got %d, want 200\", code)","+\t\t}","+\t})","+}",""],"additions":436,"deletions":0,"truncated":false}],"additions":667,