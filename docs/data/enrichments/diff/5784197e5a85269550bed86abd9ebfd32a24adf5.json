ault.');","+\t\t}","+\t}","+\tif (isAutoModeTier(value)) {","+\t\treturn value;","+\t}","+\tthrow new Error('Invalid managed Auto tier default.');","+}","+","+export function isAutoModeRoutingTier(value: unknown): value is AutoModeRoutingTier {","+\treturn value === 'fast' || isAutoModeTier(value);","+}","+","+export function isInheritedAutoTier(configuration: Readonly<Record<string, unknown>> | undefined): boolean {","+\treturn configuration?.[AutoTierSourceConfigKey] === 'default'","+\t\t|| configuration?.[AutoTierSourceConfigKey] === 'preference'","+\t\t|| configuration?.[AutoTierSourceConfigKey] === 'managedFallback'","+\t\t|| configuration?.[AutoTierSourceConfigKey] === 'managed';","+}","+","+/** A choice carried into another conversation is a preference there, not a new explicit selection. */","+export function inheritAutoTierConfiguration(configuration: Record<string, unknown> | undefined): Record<string, unknown> | undefined {","+\tif (!configuration || isInheritedAutoTier(configuration) || !Object.hasOwn(configuration, 'tier')) {","+\t\treturn configuration;","+\t}","+\treturn { ...configuration, [AutoTierSourceConfigKey]: 'preference' };","+}","+"," /** The profile used when the user has not picked one. Also the picker's default. */"," export const defaultAutoModeTier: AutoModeTier = 'balance';"," "],"additions":42,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/copilotAgent.test.ts","lines":["@@ -12903,6 +12903,67 @@ suite('CopilotAgent', () => {"," \t\t\t}"," \t\t});"," ","+\t\tfor (const selectedTier of ['balance', 'efficiency'] as const) {","+\t\t\ttest(`explicit ${selectedTier} selected during Auto initialization wins after the captured send`, async () => {","+\t\t\t\tconst sessionDataService = disposables.add(new TestSessionDataService());","+\t\t\t\tconst client = new TestCopilotClient([], [{ id: 'auto', name: 'Auto' }]);","+\t\t\t\tconst launchStarted = new DeferredPromise<void>();","+\t\t\t\tconst launchGate = new DeferredPromise<void>();","+\t\t\t\tlet initialTier: SessionConfig['capi'];","+\t\t\t\tconst sentTiers: (string | null | undefined)[] = [];","+\t\t\t\tconst sdkSession = new class extends MockCopilotSession {","+\t\t\t\t\toverride async send(): Promise<string> {","+\t\t\t\t\t\tsentTiers.push(this.setModelCalls.at(-1)?.[1]?.autoTier ?? initialTier?.autoTier);","+\t\t\t\t\t\treturn '';","+\t\t\t\t\t}","+\t\t\t\t}();","+\t\t\t\tclient.createSession = async config => {","+\t\t\t\t\tinitialTier = config.capi;","+\t\t\t\t\treportManagedSettings(config);","+\t\t\t\t\tlaunchStarted.complete();","+\t\t\t\t\tawait launchGate.p;","+\t\t\t\t\treturn sdkSession as unknown as CopilotSession;","+\t\t\t\t};","+\t\t\t\tconst { agent } = createTestAgentContext(disposables, { sessionDataService, copilotClient: client });","+\t\t\t\ttry {","+\t\t\t\t\tawait agent.authenticate('https://api.github.com', 'token');","+\t\t\t\t\tawait waitForState(agent.models, models => models.length > 0);","+\t\t\t\t\tconst session = AgentSession.uri('copilotcli', `auto-default-race-${selectedTier}`);","+\t\t\t\t\tconst chat = defaultChatUri(session);","+\t\t\t\t\tconst created = await provisionSession(agent, {","+\t\t\t\t\t\tsession, workingDirectories: [URI.file('/workspace')],","+\t\t\t\t\t\tmodel: { id: 'auto', config: { tier: 'intelligence', tierSource: 'managed' } },","+\t\t\t\t\t});","+\t\t\t\t\tconst context = exactChatContext(created.session, chat, created.session);","+\t\t\t\t\tconst firstSend = agent.chats.sendMessage(chat, 'first', undefined, undefined, undefined, undefined, context);","+\t\t\t\t\tawait launchStarted.p;","+\t\t\t\t\tconst explicit: ModelSelection = { id: 'auto', config: { tier: selectedTier, tierSource: 'explicit' } };","+\t\t\t\t\tconst selection = agent.chats.changeModel(chat, explicit, context);","+\t\t\t\t\tawait Promise.resolve();","+\t\t\t\t\tconst callsWhileInitializing = sdkSession.setModelCalls.length;","+\t\t\t\t\tlaunchGate.complete();","+\t\t\t\t\tawait Promise.all([firstSend, selection]);","+\t\t\t\t\tawait agent.chats.sendMessage(chat, 'next', undefined, undefined, undefined, undefined, context);","+\t\t\t\t\tconst database = disposables.add(sessionDataService.openDatabase(session));","+\t\t\t\t\tassert.deepStrictEqual({","+\t\t\t\t\t\tcallsWhileInitializing, initialTier, sentTiers,","+\t\t\t\t\t\tmodelCalls: sdkSession.setModelCalls,","+\t\t\t\t\t\tstored: JSON.parse(await database.object.getMetadata('copilot.model') ?? 'null'),","+\t\t\t\t\t}, {","+\t\t\t\t\t\tcallsWhileInitializing: 0, initialTier: { autoTier: 'intelligence' },","+\t\t\t\t\t\tsentTiers: ['intelligence', selectedTier],","+\t\t\t\t\t\tmodelCalls: [['auto', { reasoningEffort: undefined, contextTier: undefined, autoTier: selectedTier }]],","+\t\t\t\t\t\tstored: explicit,","+\t\t\t\t\t});","+\t\t\t\t} finally {","+\t\t\t\t\tif (!launchGate.isSettled) {","+\t\t\t\t\t\tlaunchGate.complete();","+\t\t\t\t\t}","+\t\t\t\t\tawait disposeAgent(agent);","+\t\t\t\t}","+\t\t\t});","+\t\t}","+"," \t\ttest('changeAgent resolves and applies the agent to the targeted chat, and clears it with undefined', async () => {"," \t\t\tconst agent = createTestAgent(disposables);"," \t\t\ttry {"],"additions":61,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/copilotSessionLauncher.test.ts","lines":["@@ -1680,7 +1680,9 @@ suite('CopilotSessionLauncher auto tier', () => {"," \t\t\tsessionId: 'session-1',"," \t\t\ton: () => () => { },"," \t\t\tdisconnect: async () => { },","-\t\t\trpc: { options: { update: async () => ({ success: true }) } },","+\t\t\trpc: {","+\t\t\t\toptions: { update: async () => ({ success: true }) },","+\t\t\t},"," \t\t} as unknown as CopilotSession;"," \t\tconst client: Pick<CopilotClient, 'createSession' | 'resumeSession'> = {"," \t\t\tcreateSession: async config => {","@@ -1756,4 +1758,19 @@ suite('CopilotSessionLauncher auto tier', () => {"," \t\t\t]"," \t\t);"," \t});","+","+\tfor (const [tier, tierSource] of [['intelligence', 'managed'], ['balance', 'explicit'], ['efficiency', 'explicit']] as const) {","+\t\ttest(`passes the advertised ${tierSource} ${tier} at creation without post-create policy mutation`, async () => {","+\t\t\tconst model: ModelSelection = JSON.parse(JSON.stringify({ id: 'auto', config: { tier, tierSource } }));","+\t\t\tassert.deepStrictEqual({","+\t\t\t\tcreated: await capiOptionsFor('create', model),","+\t\t\t\tresumed: await capiOptionsFor('resume', model),","+\t\t\t\temptyFallback: await capiOptionsFor('fallback', model),","+\t\t\t}, {","+\t\t\t\tcreated: [{ autoTier: tier }],","+\t\t\t\tresumed: [undefined],","+\t\t\t\temptyFallback: [undefined, { autoTier: tier }],","+\t\t\t});","+\t\t});","+\t}"," });"],"additions":18,"deletions":1,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/providerIntegration/README.md","lines":["@@ -11,3 +11,5 @@ Run one suite with:"," ```bash"," ./scripts/test-integration.sh --run src/vs/platform/agentHost/test/node/providerIntegration/copilotMockLlm.integrationTest.ts"," ```","+","+`copilotAutoTier.integrationTest.ts` checks that a scalar default selected by the client travels through the existing `ModelSelection.config.tier` / SDK `capi.autoTier` boundary to the actual first `/auto` request and survives resume. It uses the production scalar reader and tier accessor with the bundled SDK and isolated HTTP service. Picker scope/lifecycle and send/model-change ordering are covered separately in the browser store and Copilot agent unit suites. These tests characterize client startup preferences, not runtime policy enforcement or backend authoring semantics; they do not require a real account or modify device policy."],"additions":2,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/node/providerIntegration/copilotAutoTier.integrationTest.ts","lines":["@@ -0,0 +1,192 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import { CopilotClient } from '@github/copilot-sdk';","+import assert from 'assert';","+import { mkdtemp, rm } from 'fs/promises';","+import type { Server } from 'http';","+import { tmpdir } from 'os';","+import { join } from '../../../../../base/common/path.js';","+import { toDisposable } from '../../../../../base/common/lifecycle.js';","+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';","+import { parseManagedAutoTierDefault, type AutoModeTier } from '../../../common/autoModeTiers.js';","+import type { ModelSelection } from '../../../common/state/sessionState.js';","+import { getCopilotAutoTier } from '../../../node/copilot/copilotSessionLauncher.js';","+import { getAncillaryStub } from '../e2e/harness/capiStubs.js';","+import { createIsolatedProviderEnvironment } from '../providerTestEnvironment.js';","+","+suite('Copilot SDK client-selected Auto startup defaults', function () {","+\tconst disposables = ensureNoDisposablesAreLeakedInTestSuite();","+\tthis.timeout(60_000);","+","+\tlet client: CopilotClient;","+\tlet server: Server;","+\tlet home: string;","+\tlet policy: { autoTier?: string };","+\tlet routedTiers: unknown[];","+\tlet unexpectedRequests: string[];","+","+\tsetup(async () => {","+\t\thome = await mkdtemp(join(tmpdir(), 'copilot-auto-default-'));","+\t\tpolicy = {};","+\t\troutedTiers = [];","+\t\tunexpectedRequests = [];","+\t\tlet baseUrl = '';","+\t\tconst { createServer } = await import('http');","+\t\tserver = createServer(async (request, response) => {","+\t\t\tconst path = new URL(request.url ?? '/', 'http://localhost').pathname;","+\t\t\tlet body = '';","+\t\t\tfor await (const chunk of request) {","+\t\t\t\tbody += chunk;","+\t\t\t}","+\t\t\tconst json = (value: object) => {","+\t\t\t\tresponse.writeHead(200, { 'content-type': 'application/json' });","+\t\t\t\tresponse.end(JSON.stringify(value));","+\t\t\t};","+\t\t\tif (path === '/copilot_internal/managed_settings') {","+\t\t\t\tjson(policy);","+\t\t\t} else if (path === '/user') {","+\t\t\t\tjson({ login: 'replay-user', id: 1 });","+\t\t\t} else if (path === '/auto' && request.method === 'POST') {","+\t\t\t\tconst routing: { tier?: unknown } = JSON.parse(body);","+\t\t\t\troutedTiers.push(routing.tier);","+\t\t\t\tconst catalog: { data: { id: string }[] } = JSON.parse(getAncillaryStub('GET', '/models')!.body);","+\t\t\t\tjson({","+\t\t\t\t\tsession_token: 'auto-test-token',","+\t\t\t\t\texpires_at: Math.floor(Date.now() / 1000) + 3600,","+\t\t\t\t\tselected_model: catalog.data.find(model => model.id === 'gpt-4o'),","+\t\t\t\t});","+\t\t\t} else if (path === '/chat/completions' && request.method === 'POST') {","+\t\t\t\tjson({","+\t\t\t\t\tid: 'test-completion',","+\t\t\t\t\tchoices: [{ index: 0, message: { role: 'assistant', content: 'OK' }, finish_reason: 'stop' }],","+\t\t\t\t\tusage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },","+\t\t\t\t});","+\t\t\t} else {","+\t\t\t\tconst stub = getAncillaryStub(request.method ?? 'GET', path, body);","+\t\t\t\tif (stub) {","+\t\t\t\t\tresponse.writeHead(stub.status, stub.headers);","+\t\t\t\t\tresponse.end(stub.body.replaceAll('${capi}', baseUrl));","+\t\t\t\t} else {","+\t\t\t\t\tunexpectedRequests.push(`${request.method} ${path}`);","+\t\t\t\t\tresponse.writeHead(500, { 'x-should-retry': 'false' });","+\t\t\t\t\tresponse.end('Unexpected test endpoint');","+\t\t\t\t}","+\t\t\t}","+\t\t});","+\t\tawait new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));","+\t\tconst address = server.address();","+\t\tassert.ok(address && typeof address !== 'string');","+\t\tbaseUrl = `http://127.0.0.1:${address.port}`;","+\t\tclient = new CopilotClient({","+\t\t\tworkingDirectory: home,","+\t\t\tbaseDirectory: join(