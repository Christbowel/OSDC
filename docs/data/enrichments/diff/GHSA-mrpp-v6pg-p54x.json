{"id":"GHSA-mrpp-v6pg-p54x","axis":"advisories","repo":"klever-io/klever-go","sha":"8bcc600b0ac88070740c63c7ce1c8a968dd85251","parsed":{"files":[{"path":"common/errors.go","lines":["@@ -5,6 +5,9 @@ import \"errors\""," // ErrInvalidValue signals that a nil value has been provided"," var ErrInvalidValue = errors.New(\"invalid value provided\")"," ","+// ErrAccountFrozen signals that a transaction was sent from a consensus-frozen account","+var ErrAccountFrozen = errors.New(\"account is frozen\")","+"," // ErrNilSignalChan returns whenever a nil signal channel is provided"," var ErrNilSignalChan = errors.New(\"nil signal channel\")"," "],"additions":3,"deletions":0,"truncated":false},{"path":"common/frozenAccounts.go","lines":["@@ -0,0 +1,59 @@","+package common","+","+import \"encoding/hex\"","+","+// frozenAccounts is the canonical set of accounts from the GHSA-p7gw-2pcp-5pf8","+// marketplace value-creation exploit, confirmed against the on-chain mint trace and","+// consulted by IsAccountFrozen (the consensus freeze, gated by the FixMarketBuyOverflow","+// fork flag, enforced in txProcessor.ProcessTransaction and the proposer build path).","+//","+// It only immobilises (blocks outgoing txs); the supply correction is deferred.","+// Freezing is reversible (thaw in a later fork); the correction is not.","+//","+// Replay safety: the template keeps the epoch at 0 like every other fork; the REAL","+// activation epoch is set in the operator config and MUST be a future epoch (after the","+// last outgoing tx of every address below, after fleet rollout). Never ship a live","+// config active from genesis or a past epoch, or a re-sync / import-db reindex replays","+// these accounts' historical txs, rejects them, and diverges from chain history.","+var frozenAccounts = map[string]struct{}{","+\t// klv12n4z3ef86sfk2z97j4fhfta9f2xztsv6frr8faqj7l8q9kc0fcdsfjfqez (root / minter)","+\t\"54ea28e527d4136508be955374afa54a8c25c19a48c674f412f7ce02db0f4e1b\": {},","+\t// klv1fzemma2s9d35l0hm38wt88srdyyqweufljqtps9jqkv32due3yqswqlfae (direct send from attacker)","+\t\"48b3bdf5502b634fbefb89dcb39e036908076789fc80b0c0b205991537998901\": {},","+\t// klv1qfhu856w9gu8k9skay5sgquvl95erjygkmemycq07xspykqzm6vsqpty2m (direct send from attacker)","+\t\"026fc3d34e2a387b1616e92904038cf96991c888b6f3b2600ff1a0125802de99\": {},","+\t// klv1wuug6007dnvgard8yvj5cydt70vuejm0kaasqrjs8r7rl7ftjexsglalf6 (direct recipient, 25.6M, idle)","+\t\"77388d3dfe6cd88e8da723254c11abf3d9cccb6fb77b000e5038fc3ff92b964d\": {},","+\t// klv1hd58mwaz8cvyflkxwj3jewyqnuxnyp6sd3flc0tr0eqdc4ns343skngdjq (collector hop, ~125M KLV)","+\t\"bb687dbba23e1844fec674a32cb8809f0d3207506c53fc3d637e40dc56708d63\": {},","+\t// klv1qh5swknt7z4zr9e73ax87vflpvv7u4z9cce4wsa5uccsjffq4tpquv67ej (NFT buy/sell operations account, attacker-controlled)","+\t\"05e9075a6bf0aa21973e8f4c7f313f0b19ee5445c6335743b4e631092520aac2\": {},","+}","+","+// frozenAccountKeys is frozenAccounts keyed by raw public key (decoded once), so the","+// hot-path IsAccountFrozen lookup is a zero-allocation map access with no per-call hex.","+var frozenAccountKeys = buildFrozenAccountKeys()","+","+func buildFrozenAccountKeys() map[string]struct{} {","+\tkeys := make(map[string]struct{}, len(frozenAccounts))","+\tfor hexKey := range frozenAccounts {","+\t\traw, err := hex.DecodeString(hexKey)","+\t\tif err != nil {","+\t\t\t// A malformed key would silently fail to freeze; fail loud at start-up.","+\t\t\tpanic(\"common: invalid frozen account hex key: \" + hexKey)","+\t\t}","+\t\tkeys[string(raw)] = struct{}{}","+\t}","+\treturn keys","+}","+","+// IsAccountFrozen reports whether the given raw public key belongs to a","+// consensus-frozen account. Callers MUST gate this behind the FixMarketBuyOverflow","+// fork flag so it only takes effect from the activation epoch onward.","+func IsAccountFrozen(address []byte) bool {","+\tif len(address) == 0 {","+\t\treturn false","+\t}","+\t_, frozen := frozenAccountKeys[string(address)]","+\treturn frozen","+}"],"additions":59,"deletions":0,"truncated":false},{"path":"common/frozenAccounts_test.go","lines":["@@ -0,0 +1,28 @@","+package common","+","+import (","+\t\"encoding/hex\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+func Test_IsAccountFrozen(t *testing.T) {","+\tt.Run(\"frozen account is detected\", func(t *testing.T) {","+\t\tfor hexAddr := range frozenAccounts {","+\t\t\taddr, err := hex.DecodeString(hexAddr)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.True(t, IsAccountFrozen(addr), \"expected %s to be frozen\", hexAddr)","+\t\t}","+\t})","+","+\tt.Run(\"unrelated account is not frozen\", func(t *testing.T) {","+\t\taddr, _ := hex.DecodeString(\"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\")","+\t\trequire.False(t, IsAccountFrozen(addr))","+\t})","+","+\tt.Run(\"empty and nil are not frozen\", func(t *testing.T) {","+\t\trequire.False(t, IsAccountFrozen(nil))","+\t\trequire.False(t, IsAccountFrozen([]byte{}))","+\t})","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"common/mock/accCacherStub.go","lines":["@@ -3,15 +3,16 @@ package mock"," import \"github.com/klever-io/klever-go/data/state\""," "," type AccountsCacherStub struct {","-\tGetExistingUserCalled func(address []byte) (state.UserAccountHandler, error)","-\tGetExistingKappCalled func(address []byte) (state.KAppAccountHandler, error)","-\tGetExistingPeerCalled func(address []byte) (state.PeerAccountHandler, error)","-\tLoadUserCalled        func(address []byte) (state.UserAccountHandler, error)","-\tLoadKAppCalled        func(address []byte) (state.KAppAccountHandler, error)","-\tLoadPeerCalled        func(address []byte) (state.PeerAccountHandler, error)","-\tResetAllCalled        func(enableCache bool)","-\tSaveAllCalled         func() error","-\tSaveUserCalled        func(account state.AccountHandler) error","+\tGetExistingUserCalled  func(address []byte) (state.UserAccountHandler, error)","+\tGetExistingKapp