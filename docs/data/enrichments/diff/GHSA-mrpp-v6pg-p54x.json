e},{"path":"core/kapp/accounts/accounts.go","lines":["@@ -288,6 +288,11 @@ func (a *accountsKapp) computeSplitRoyalties(address string, assetID []byte, ass"," \tif err != nil {"," \t\treturn transaction.Transaction_ParameterInvalid, err"," \t}","+\tif a.forkController.FixMarketBuyOverflow() && splitToPay > *royaltiesToPay {","+\t\tsplitCtx := a.KAppController.GetCurrentKAppContext()","+\t\tsplitCtx.Receipts().AddError(splitCtx.ContractID(), common.ErrFieldInvalidRoyalties, common.ErrInvalidValue.Error())","+\t\treturn transaction.Transaction_ParameterInvalid, common.ErrInvalidValue","+\t}"," \t*royaltiesToPay -= splitToPay"," "," \terr = splitRoyalty.AddToBalance(splitToPay, assetID, a.forkController.EnableSmartContracts())","@@ -426,6 +431,14 @@ func (a *accountsKapp) processPercentageRoyaltiesTransfer(tc *transaction.Transf"," \t}"," "," \troyaltiesToPay := royaltyAmount","+","+\tif a.forkController.FixMarketBuyOverflow() {","+\t\terr = acntSrc.SubFromBalance(royaltyAmount, assetID, a.forkController.EnableSmartContracts())","+\t\tif err != nil {","+\t\t\treturn transaction.Transaction_BalanceError, err","+\t\t}","+\t}","+"," \tfor key, value := range kda.Royalties.SplitRoyalties {"," \t\tstatus, err := a.computeSplitRoyalties(key, assetID, kda.AssetType, acntSrc, royaltyAmount, int64(value.PercentTransferPercentage), &royaltiesToPay)"," \t\tif err != nil {","@@ -442,9 +455,11 @@ func (a *accountsKapp) processPercentageRoyaltiesTransfer(tc *transaction.Transf"," \t\treturn transaction.Transaction_LoadAccountError, err"," \t}"," ","-\terr = acntSrc.SubFromBalance(royaltyAmount, assetID, a.forkController.EnableSmartContracts())","-\tif err != nil {","-\t\treturn transaction.Transaction_BalanceError, err","+\tif !a.forkController.FixMarketBuyOverflow() {","+\t\terr = acntSrc.SubFromBalance(royaltyAmount, assetID, a.forkController.EnableSmartContracts())","+\t\tif err != nil {","+\t\t\treturn transaction.Transaction_BalanceError, err","+\t\t}"," \t}"," "," \terr = roya