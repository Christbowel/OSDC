iting is answered once that run","+// finishes. The run is placed by its start; one with no recorded start is","+// placed by its end.","+func scheduledRestartState(app *v1beta1.Application) scheduledRestart {"," \tif app.Status.WorkflowRestartScheduledAt == nil || app.Status.Workflow == nil || !app.Status.Workflow.Finished {","-\t\treturn false","+\t\treturn restartNotYet"," \t}"," \trestartTime := app.Status.WorkflowRestartScheduledAt.Time"," \tif time.Now().Before(restartTime) {","-\t\treturn false","+\t\treturn restartNotYet","+\t}","+\trun := app.Status.Workflow.StartTime.Time","+\tif run.IsZero() {","+\t\trun = app.Status.Workflow.EndTime.Time"," \t}","-\treturn app.Status.Workflow.EndTime.IsZero() || restartTime.After(app.Status.Workflow.EndTime.Time)","+\tif run.IsZero() || restartTime.After(run) {","+\t\treturn restartDue","+\t}","+\treturn restartSuperseded"," }"," "," // checkWorkflowRestart checks if application workflow needs restart.","@@ -117,9 +141,16 @@ func scheduledRestartDue(app *v1beta1.Application) bool {"," func (r *Reconciler) checkWorkflowRestart(ctx monitorContext.Context, app *v1beta1.Application, handler *AppHandler) {"," \t// A scheduled restart that is not due leaves the revision check below to"," \t// run, so a new application still starts and a new revision still restarts.","-\tif scheduledRestartDue(app) {","-\t\t// Time arrived, workflow finished, and restart time > last execution.","-\t\t// Clear the status field and proceed with restart","+\tswitch scheduledRestartState(app) {","+\tcase restartNotYet:","+\tcase restartSuperseded:","+\t\t// The last run already answered it; clearing it keeps a stale request","+\t\t// from showing as pending.","+\t\tapp.Status.WorkflowRestartScheduledAt = nil","+\t\tif err := r.Status().Update(ctx, app); err != nil {","+\t\t\tctx.Error(err, \"failed to clear a superseded workflow restart\")","+\t\t}","+\tcase restartDue:"," \t\tapp.Status.WorkflowRestartScheduledAt = nil"," \t\tif err := r.Status().