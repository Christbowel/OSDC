x-\\(parameter.team)\"","+\t}","+}","+parameter: team: string","+`","+\tconst labels = `","+// +patchStrategy=jsonMergePatch","+patch: {","+\tmetadata: labels: {","+\t\tfor k, v in parameter {","+\t\t\t(k): v","+\t\t}","+\t}","+}","+parameter: [string]: string | null","+`","+\tconst jsonPatch = `","+parameter: operations: [...{...}]","+// +patchStrategy=jsonPatch","+patch: parameter","+`","+\top := func(op, path string, value interface{}) map[string]interface{} {","+\t\treturn map[string]interface{}{\"op\": op, \"path\": path, \"value\": value}","+\t}","+\trender := func(t *testing.T, open func(context.Context) context.Context, trait string, params map[string]interface{}) (wfprocess.Context, error) {","+\t\tctx := openCtx(open)","+\t\trequire.NoError(t, NewWorkloadAbstractEngine(\"webservice\").Complete(ctx, openWorkload,","+\t\t\tmap[string]interface{}{\"image\": \"acme/billing:1.4.2\"}))","+\t\treturn ctx, NewTraitAbstractEngine(\"patcher\").Complete(ctx, trait, params)","+\t}","+\tfor name, open := range openRenders {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tt.Run(\"merge patch with an unknowable value\", func(t *testing.T) {","+\t\t\t\tctx, err := render(t, open, mergePatch, map[string]interface{}{\"team\": unknown()})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tbase, _ := ctx.Output()","+\t\t\t\tw := marshalled(t, base)","+\t\t\t\trequire.NotContains(t, w.GetLabels(), \"team\")","+\t\t\t\trequire.Equal(t, \"acme/billing:1.4.2\", w.GetAnnotations()[\"image\"], \"the workload's own fields are kept\")","+\t\t\t})","+\t\t\tt.Run(\"the labels trait with an unknowable value\", func(t *testing.T) {","+\t\t\t\tctx, err := render(t, open, labels, map[string]interface{}{\"team\": unknown()})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\tbase, _ := ctx.Output()","+\t\t\t\trequire.NotContains(t, marshalled(t, base).GetLabels(), \"team\")","+\t\t\t})","+\t\t\tt.Run(\"json patch add with an unknowable value\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"add\", \"/metadata/labels\", map[string]interface{}{}),","+\t\t\t\t\top(\"add\", \"/metadata/labels/team\", unknown()),","+\t\t\t\t}})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t})","+\t\t\tt.Run(\"json patch add to a path the workload lacks is still refused\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"add\", \"/spec/nosuch/team\", unknown()),","+\t\t\t\t}})","+\t\t\t\trequire.Error(t, err)","+\t\t\t})","+\t\t\tt.Run(\"json patch test with an unknowable value is left out\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"test\", \"/kind\", unknown()),","+\t\t\t\t}})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t})","+\t\t\tt.Run(\"json patch test of a struct with an unknowable leaf is left out\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"test\", \"/metadata\", map[string]interface{}{\"name\": \"billing-api\", \"annotations\": map[string]interface{}{\"image\": unknown()}}),","+\t\t\t\t}})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t})","+\t\t\tt.Run(\"json patch add keeps what of its value is known\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"add\", \"/metadata/labels\", map[string]interface{}{\"team\": unknown(), \"owner\": \"y\"}),","+\t\t\t\t\top(\"test\", \"/metadata/labels/owner\", \"y\"),","+\t\t\t\t}})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t})","+\t\t\tt.Run(\"json patch add of a list with nothing known is an empty list\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"add\", \"/spec/args\", []interface{}{unknown(), \"b\"}),","+\t\t\t\t\top(\"add\", \"/spec/args/-\", \"c\"),","+\t\t\t\t}})","+\t\t\t\trequire.NoError(t, err)","+\t\t\t})","+\t\t\tt.Run(\"json patch test with a literal is still applied\", func(t *testing.T) {","+\t\t\t\t_, err := render(t, open, jsonPatch, map[string]interface{}{\"operations\": []interface{}{","+\t\t\t\t\top(\"test\", \"/kind\", \"Service\"),","+\t\t\t\t}})","+\t\t\t\trequire.Error(t, err)","+\t\t\t})","+\t\t})","+\t}","+}","+","+// Outside an open render nothing is pruned: a concrete value is patched in.","+func TestRenderOfAJSONPatchingTraitIsUnchanged(t *testing.T) {","+\tconst labels = `","+// +patchStrategy=jsonMergePatch","+patch: {","+\tmetadata: labels: {","+\t\tfor k, v in parameter {","+\t\t\t(k): v","+\t\t}","+\t}","+}","+parameter: [string]: string | null","+`","+\tctx := openCtx(func(c context.Context) context.Context { return c })","+\trequire.NoError(t, NewWorkloadAbstractEngine(\"webservice\").Complete(ctx, openWorkload,","+\t\tmap[string]interface{}{\"image\": \"acme/billing:1.4.2\"}))","+\trequire.NoError(t, NewTraitAbstractEngine(\"labels\").Complete(ctx, labels,","+\t\tmap[string]interface{}{\"team\": \"x-acme-billing\"}))","+\tbase, _ := ctx.Output()","+\trequire.Equal(t, \"x-acme-billing\", marshalled(t, base).GetLabels()[\"team\"])","+}"],"additions":126,"deletions":0,"truncated":false},{"path":"pkg/cue/definition/template.go","lines":["@@ -40,6 +40,7 @@ import ("," \t\"sigs.k8s.io/controller-runtime/pkg/client\""," "," \t\"github.com/kubevela/workflow/pkg/cue/model\"","+\t\"github.com/kubevela/workflow/pkg/cue/model/sets\""," \t\"github.com/kubevela/workflow/pkg/cue/model/value\""," \t\"github.com/kubevela/workflow/pkg/cue/process\""," ","@@ -461,7 +462,8 @@ func (td *traitDef) Complete(ctx process.Context, abstractTemplate string, param"," \t\tif base == nil {"," \t\t\treturn fmt.Errorf(\"patch trait %s into an invalid workload\", td.name)"," \t\t}","-\t\tif err := base.Unify(patcher, patchOptionsFromLevels(levels, patcher)...); err != nil {","+\t\topts := patchOptionsFromLevels(levels, patcher)","+\t\tif err := base.Unify(marshalablePatch(ctx, patcher, opts), opts...); err != nil {"," \t\t\treturn errors.WithMessagef(err, \"invalid patch trait %s into workload\", td.name)"," \t\t}"," \t\t// The patch carries the trait's own parameters, so a source-fed one","@@ -798,3 +800,75 @@ func repruneAuxiliary(ctx process.Context, auxiliaries []process.Auxiliary, i in"," \tauxiliaries[i].Ins = next"," \treturn nil"," }","+","+// marshalablePatch prunes what an open render cannot know from a patch whose","+// strategy hands it to a JSON patch library, which takes concrete JSON only.","+// Elsewhere CUE unifies the patch and an open value is no obstacle.","+//","+// For a JSON patch, an operation keeps its path, so admission still checks the","+// path exists, and loses only what of its value is unknowable; a value with","+// nothing left is applied as an empty list for a list and as null otherwise. A test with anything unknowable in its value","+// is left out instead, since comparing against what remains would refuse a value","+// that may well match.","+func marshalablePatch(ctx process.Context, patcher cue.Value, opts []sets.UnifyOption) cue.Value {","+\tif !sources.OpenParams(ctx.GetCtx()) {","+\t\treturn patcher","+\t}","+\tparams := &sets.UnifyParams{}","+\tfor _, o := range opts {","+\t\to.ApplyToOption(params)","+\t}","+\tswitch params.PatchStrategy {","+\tcase sets.StrategyJSONMergePatch:","+\t\tpruned, _ := sources.ConcreteForOpenRender(ctx.GetCtx(), patcher)","+\t\treturn pruned","+\tcase sets.StrategyJSONPatch:","+\t\treturn marshalableJSONPatch(ctx, patcher)","+\tdefault:","+\t\treturn patcher","+\t}","+}","+","+// marshalableJSONPatch prunes each operation of a JSON patch on its own, so one","+// unknowable value does not take the whole operations list with it.","+func marshalableJSONPatch(ctx process.Context, patcher cue.Value) cue.Value {","+\titer, err := patcher.LookupPath(cue.ParsePath(\"operations\")).List()","+\tif err != nil {","+\t\tpruned, _ := sources.ConcreteForOpenRender(ctx.GetCtx(), patcher)","+\t\treturn pruned","+\t}","+\tops := []any{}","+\tfor iter.Next() {","+\t\top := iter.Value()","+\t\tval := op.LookupPath(cue.ParsePath(\"value\"))","+\t\t// A struct or list is concrete even with an unknowable leaf, so the","+\t\t// prune decides.","+\t\tknown := true","+\t\tif val.Exists() {","+\t\t\t_, pruned := sources.ConcreteForOpenRender(ctx.GetCtx(), val)","+\t\t\tknown = !pruned","+\t\t}","+\t\tif !known {","+\t\t\tif kind, _ := op.LookupPath(cue.ParsePath(\"op\")).String(); kind == \"test\" {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t}","+\t\tpruned, _ := sources.ConcreteForOpenRender(ctx.GetCtx(), op)","+\t\tvar decoded map[string]any","+\t\tif err := pruned.Decode(&decoded); err != nil {","+\t\t\treturn patcher","+\t\t}","+\t\tif _, kept := decoded[\"value\"]; val.Exists() && !kept {","+\t\t\tdecoded[\"value\"] = nil","+\t\t\tif val.IncompleteKind() == cue.ListKind {","+\t\t\t\tdecoded[\"value\"] = []any{}","+\t\t\t}","+\t\t}","+\t\tops = append(ops, decoded)","+\t}","+\tout := patcher.Context().Encode(map[string]any{\"operations\": ops})","+\tif out.Err() != nil {","+\t\treturn patcher","+\t}","+\treturn out","+}"],"additions":75,"deletions":1,"truncated":false},{"path":"pkg/webhook/core.oam.dev/v1beta1/application/validation.go","lines":["@@ -82,9 +82,12 @@ func (h *ValidatingHandler) ValidateWorkflow(_ context.Context, app *v1beta1.App"," \t\tstepsPath := field.NewPath(\"spec\", \"workflow\", \"steps\")"," \t\tenabled := sources.ExpressionsEnabledFor(app.GetAnnotations())"," \t\terrs = append(errs, wfbuiltin.ValidateForEachSteps(stepsPath, app.Spec.Workflow.Steps, enabled)...)","+\t\terrs = append(errs, misplacedConditions(stepsPath, app.Spec.Workflow.Steps)...)"," \t\tif enabled {"," \t\t\terrs = append(errs, wfexpressions.Validate(stepsPath, app.Spec.Workflow.Steps, app.Spec.Workflow.Mode,"," \t\t\t\tcelexpr.Roots...)...)","+\t\t} else {","+\t\t\terrs = append(errs, conditionsWithoutExpressions(stepsPath, app.Spec.Workflow.Steps)...)"," \t\t}"," \t}"," \treturn errs"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/webhook/core.oam.dev/v1beta1/application/validation_conditions_disabled.go","lines":["@@ -0,0 +1,147 @@","+/*","+Copyright 2026 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package application","+","+import (","+\t\"fmt\"","+\t\"strings\"","+","+\twfv1alpha1 \"github.com/kubevela/pkg/apis/oam/v1alpha1\"","+\twfexpressions \"github.com/kubevela/workflow/pkg/expressions\"","+\t\"k8s.io/apimachinery/pkg/util/validation/field\"","+\tutilfeature \"k8s.io/apiserver/pkg/util/feature\"","+","+\t\"github.com/oam-dev/kubevela/pkg/features\"","+\t\"github.com/oam-dev/kubevela/pkg/oam\"","+)","+","+// conditionsWithoutExpressions refuses every $( ) if, on a step or a sub-step, of","+// an Application that does not read expressions. Without an evaluator the","+// workflow reads such an if as CUE, which it is not, and skips the step.","+func conditionsWithoutExpressions(stepsPath *field.Path, steps []wfv1alpha1.WorkflowStep) field.ErrorList {","+\tvar errs field.ErrorList","+\tfor i, step := range steps {","+\t\tif wfexpressions.IsCondition(step.If) {","+\t\t\terrs = append(errs, field.Forbidden(stepsPath.Index(i).Child(\"if\"), conditionsDisabledMessage()))","+\t\t}","+\t\tfor j, sub := range step.SubSteps {","+\t\t\tif wfexpressions.IsCondition(sub.If) {","+\t\t\t\terrs = append(errs, field.Forbidden(stepsPath.Index(i).Child(\"subSteps\").Index(j).Child(\"if\"),","+\t\t\t\t\tconditionsDisabledMessage()))","+\t\t\t}","+\t\t}","+\t}","+\treturn errs","+}","+","+// conditionsDisabledMessage says which of the two switches is off.","+func conditionsDisabledMessage() string {","+\tif !utilfeature.DefaultMutableFeatureGate.Enabled(features.EnableCelExpressions) {","+\t\treturn \"a $( ) condition needs expressions, which are not enabled on this cluster; \" +","+\t\t\t\"an operator enables them with the EnableCelExpressions feature gate\"","+\t}","+\treturn fmt.Sprintf(\"a $( ) condition needs expressions, and this Application has not opted in to them; \"+","+\t\t\"set the %s annotation to \\\"true\\\"\", oam.AnnotationCelExpressions)","+}","+","+// misplacedConditionMessage refuses an if holding a $( ) that is not the whole","+// of it.","+const misplacedConditionMessage = \"a $( ) condition must be the whole if, one expression: \" +","+\t\"write $(a && b), not $(a) && $(b)\"","+","+// misplacedConditions refuses every if, on a step or a sub-step, that holds a","+// $( ) outside a CUE string without being one $( ) expression. Such an if is not","+// a condition, and as CUE it never compiles, so the step would be skipped. The","+// workflow exports the same check from the version after the one pinned here.","+func misplacedConditions(stepsPath *field.Path, steps []wfv1alpha1.WorkflowStep) field.ErrorList {","+\tvar errs field.ErrorList","+\tfor i, step := range steps {","+\t\tif misplacedCondition(step.If) {","+\t\t\terrs = append(errs, field.Invalid(stepsPath.Index(i).Child(\"if\"), step.If, misplacedConditionMessage))","+\t\t}","+\t\tfor j, sub := range step.SubSteps {","+\t\t\tif misplacedCondition(sub.If) {","+\t\t\t\terrs = append(errs, field.Invalid(stepsPath.Index(i).Child(\"subSteps\").Index(j).Child(\"if\"),","+\t\t\t\t\tsub.If, misplacedConditionMessage))","+\t\t\t}","+\t\t}","+\t}","+\treturn errs","+}","+","+// misplacedCondition reports an if with a $( ) outside its CUE strings and","+// comments that is not one $( ) expression. A $$( is an escape, not an expression.","+func misplacedCondition(cond string) bool {","+\treturn !wfexpressions.IsCondition(cond) && expressionOutsideStrings(cond)","+}","+","+// expressionOutsideStrings reports a $( ) in CUE source outside its string and","+// bytes literals and its comments.","+func expressionOutsideStrings(src string) bool {","+\tfor i := 0; i < len(src); i++ {","+\t\tswitch c := src[i]; c {","+\t\tcase '\"', '\\'':","+\t\t\ti = endOfLiteral(src, i, 0)","+\t\tcase '#':","+\t\t\thashes := len(src[i:]) - len(strings.TrimLeft(src[i:], \"#\"))","+\t\t\tif next := i + hashes; next < len(src) && (src[next] == '\"' || src[next] == '\\'') {","+\t\t\t\ti = endOfLiteral(src, next, hashes)","+\t\t\t} else {","+\t\t\t\ti = next - 1","+\t\t\t}","+\t\tcase '/':","+\t\t\tif strings.HasPrefix(src[i:], \"//\") {","+\t\t\t\tif nl := strings.IndexByte(src[i:], '\\n'); nl >= 0 {","+\t\t\t\t\ti += nl","+\t\t\t\t} else {","+\t\t\t\t\treturn false","+\t\t\t\t}","+\t\t\t}","+\t\tcase '$':","+\t\t\tif strings.HasPrefix(src[i:], \"$$(\") {","+\t\t\t\ti += 2","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif strings.HasPrefix(src[i:], \"$(\") {","+\t\t\t\treturn true","+\t\t\t}","+\t\t}","+\t}","+\treturn false","+}","+","+// endOfLiteral returns the index of the last byte of the literal whose opening","+// quote is at src[start], or the last index when it is unclosed. The literal is","+// single-line or, opened with three quotes, multiline; with hashes before its","+// quote it is raw, closed by the quote and as many hashes, with no escapes.","+func endOfLiteral(src string, start, hashes int) int {","+\tquote := src[start : start+1]","+\tif strings.HasPrefix(src[start:], strings.Repeat(quote, 3)) {","+\t\tquote = strings.Repeat(quote, 3)","+\t}","+\tclosing := quote + strings.Repeat(\"#\", hashes)","+\tfor i := start + len(quote); i < len(src); i++ {","+\t\tif hashes == 0 && src[i] == '\\\\' {","+\t\t\ti++","+\t\t\tcontinue","+\t\t}","+\t\tif strings.HasPrefix(src[i:], closing) {","+\t\t\treturn i + len(closing) - 1","+\t\t}","+\t}","+\treturn len(src) - 1","+}"],"additions":147,"deletions":0,"truncated":false},{"path":"pkg/webhook/core.oam.dev/v1beta1/application/validation_conditions_disabled_test.go","lines":["@@ -0,0 +1,113 @@","+/*","+Copyright 2026 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package application","+","+import (","+\t\"context\"","+\t\"testing\"","+","+\twfv1alpha1 \"github.com/kubevela/pkg/apis/oam/v1alpha1\"","+\t\"github.com/stretchr/testify/require\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\tutilfeature \"k8s.io/apiserver/pkg/util/feature\"","+\tfeaturegatetesting \"k8s.io/component-base/featuregate/testing\"","+","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\"","+\t\"github.com/oam-dev/kubevela/pkg/features\"","+\t\"github.com/oam-dev/kubevela/pkg/oam\"","+)","+","+func conditionApp(annotations map[string]string, ifs ...string) *v1beta1.Application {","+\tsteps := []wfv1alpha1.WorkflowStep{{","+\t\tWorkflowStepBase: wfv1alpha1.WorkflowStepBase{Name: \"a\", Type: \"apply-component\"},","+\t}}","+\tfor i, cond := range ifs {","+\t\tsteps = append(steps, wfv1alpha1.WorkflowStep{","+\t\t\tWorkflowStepBase: wfv1alpha1.WorkflowStepBase{Name: string(rune('b' + i)), Type: \"apply-component\", If: cond},","+\t\t})","+\t}","+\treturn &v1beta1.Application{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"app\", Namespace: \"default\", Annotations: annotations},","+\t\tSpec:       v1beta1.ApplicationSpec{Workflow: &v1beta1.Workflow{Steps: steps}},","+\t}","+}","+","+// A $( ) if is refused when expressions are off for the Application, naming the","+// switch, rather than admitted and then skipped as an invalid CUE condition.","+func TestStepConditionsRefusedWithoutExpressions(t *testing.T) {","+\th := &ValidatingHandler{}","+","+\tt.Run(\"not opted in\", func(t *testing.T) {","+\t\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.RequireCelExpressionOptIn, true)","+\t\terrs := h.ValidateWorkflow(context.Background(), conditionApp(nil, \"$(steps.a.succeeded)\")).ToAggregate()","+\t\trequire.Error(t, errs)","+\t\trequire.Contains(t, errs.Error(), \"spec.workflow.steps[1].if\")","+\t\trequire.Contains(t, errs.Error(), oam.AnnotationCelExpressions)","+\t})","+","+\tt.Run(\"gate off\", func(t *testing.T) {","+\t\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.EnableCelExpressions, false)","+\t\terrs := h.ValidateWorkflow(context.Background(), conditionApp(nil, \"$(steps.a.succeeded)\")).ToAggregate()","+\t\trequire.Error(t, errs)","+\t\trequire.Contains(t, errs.Error(), \"EnableCelExpressions feature gate\")","+\t})","+","+\tt.Run(\"a sub-step condition\", func(t *testing.T) {","+\t\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.RequireCelExpressionOptIn, true)","+\t\tapp := conditionApp(nil)","+\t\tapp.Spec.Workflow.Steps = append(app.Spec.Workflow.Steps, wfv1alpha1.WorkflowStep{","+\t\t\tWorkflowStepBase: wfv1alpha1.WorkflowStepBase{Name: \"group\", Type: \"step-group\"},","+\t\t\tSubSteps:         []wfv1alpha1.WorkflowStepBase{{Name: \"inner\", Type: \"apply-component\", If: \"$(steps.a.succeeded)\"}},","+\t\t})","+\t\terrs := h.ValidateWorkflow(context.Background(), app).ToAggregate()","+\t\trequire.Error(t, errs)","+\t\trequire.Contains(t, errs.Error(), \"spec.workflow.steps[1].subSteps[0].if\")","+\t})","+","+\tt.Run(\"CUE conditions are unaffected\", func(t *testing.T) {","+\t\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.RequireCelExpressionOptIn, true)","+\t\trequire.Empty(t, h.ValidateWorkflow(context.Background(),","+\t\t\tconditionApp(nil, \"status.a.succeeded\", \"always\", `inputs.msg == \"cost $(5)\"`)))","+\t})","+","+\tt.Run(\"opted in, the condition is admitted\", func(t *testing.T) {","+\t\tfeaturegatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.RequireCelExpressionOptIn, true)","+\t\trequire.Empty(t, h.ValidateWorkflow(context.Background(),","+\t\t\tconditionApp(map[string]string{oam.AnnotationCelExpressions: \"true\"}, \"$(steps.a.succeeded)\")))","+\t})","+}","+","+// An if holding a $( ) that is not the whole of it is refused whether or not the","+// Application reads expressions; a $( ) inside a CUE string is text.","+func TestMisplacedStepConditionsRefused(t *testing.T) {","+\th := &ValidatingHandler{}","+\tfor _, annotations := range []map[string]string{nil, {oam.AnnotationCelExpressions: \"true\"}} {","+\t\terrs := h.ValidateWorkflow(context.Background(),","+\t\t\tconditionApp(annotations, \"$(steps.a.succeeded) && $(steps.a.failed)\")).ToAggregate()","+\t\trequire.Error(t, errs)","+\t\trequire.Contains(t, errs.Error(), \"spec.workflow.steps[1].if\")","+\t\trequire.Contains(t, errs.Error(), \"must be the whole if\")","+\t}","+\trequire.Empty(t, h.ValidateWorkflow(context.Background(),","+\t\tconditionApp(nil, `inputs.msg == \"cost $(5)\"`, \"status.a.succeeded\", \"status.a.succeeded // see $(docs)\")))","+\trequire.Error(t, h.ValidateWorkflow(context.Background(),","+\t\tconditionApp(nil, \"status.a.succeeded // don't\\n&& $(steps.a.succeeded)\")).ToAggregate())","+\trequire.Empty(t, h.ValidateWorkflow(context.Background(),","+\t\tconditionApp(nil, `x == #\"say \"$(x)\" now\"#`, \"x == \\\"\\\"\\\"\\n\\tsay \\\"$(x)\\\"\\n\\t\\\"\\\"\\\"\", \"x == '''\\n\\tit's $(x)\\n\\t'''\")))","+\trequire.Error(t, h.ValidateWorkflow(context.Background(),","+\t\tconditionApp(nil, `#\"a\"# && $(steps.a.succeeded)`)).ToAggregate())","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"pkg/workflow/operation/operation.go","lines":["@@ -437,6 +437,7 @@ func (wo appWorkflowStepOperator) Restart(ctx context.Context, step string) erro"," \t}"," \tvar cm *corev1.ConfigMap"," \tif status.ContextBackend != nil {","+\t\tcm = &corev1.ConfigMap{}"," \t\tif err := wo.cli.Get(ctx, client.ObjectKey{Namespace: app.Namespace, Name: status.ContextBackend.Name}, cm); err != nil {"," \t\t\treturn err"," \t\t}"],"additions":1,"deletions":0,"truncated":false},{"path":"pkg/workflow/operation/operation_test.go","lines":["@@ -144,6 +144,30 @@ var _ = Describe(\"Kruise rollout test\", func() {"," \t\tExpect(checkApp.Status.Workflow.Steps).Should(BeNil())"," \t})"," ","+\tIt(\"Restart workflow from step with a context ConfigMap\", func() {","+\t\tctxCM := &v1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Namespace: \"default\", Name: \"opt-app-context\"}}","+\t\tExpect(k8sClient.Create(ctx, ctxCM)).Should(SatisfyAny(BeNil(), util.AlreadyExistMatcher{}))","+\t\tcheckApp := v1beta1.Application{}","+\t\tExpect(k8sClient.Get(ctx, types.NamespacedName{Namespace: \"default\", Name: \"opt-app\"}, &checkApp)).Should(BeNil())","+\t\tcheckApp.Status.Workflow = &common.WorkflowStatus{","+\t\t\tContextBackend: &v1.ObjectReference{Namespace: \"default\", Name: \"opt-app-context\"},","+\t\t\tSteps: []workflowv1alpha1.WorkflowStepStatus{","+\t\t\t\t{","+\t\t\t\t\tStepStatus: workflowv1alpha1.StepStatus{","+\t\t\t\t\t\tName:  \"step1\",","+\t\t\t\t\t\tPhase: workflowv1alpha1.WorkflowStepPhaseFailed,","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t\tExpect(k8sClient.Status().Update(ctx, &checkApp)).Should(BeNil())","+\t\toperator := NewApplicationWorkflowStepOperator(k8sClient, nil, checkApp.DeepCopy())","+\t\tExpect(operator.Restart(ctx, \"step1\")).Should(BeNil())","+\t\tcheckApp = v1beta1.Application{}","+\t\tExpect(k8sClient.Get(ctx, types.NamespacedName{Namespace: \"default\", Name: \"opt-app\"}, &checkApp)).Should(BeNil())","+\t\tExpect(checkApp.Status.Workflow.Steps).Should(BeNil())","+\t})","+"," \tIt(\"Rollback workflow\", func() {"," \t\tExpect(k8sClient.Create(ctx, &appRev)).Should(BeNil())"," \t\tcheckAppRev := v1beta1.ApplicationRevision{}"],"additions":24,"deletions":0,"truncated":false},{"path":"pkg/workflow/providers/legacy/multicluster/deploy.go","lines":["@@ -257,7 +257,7 @@ func (t *applyTask) generateOutput(output *unstructured.Unstructured, outputs []"," \tfor _, os := range outputs {"," \t\tname := os.GetLabels()[oam.TraitResource]"," \t\tif name != \"\" {","-\t\t\tcomponentVal = componentVal.FillPath(cue.ParsePath(fmt.Sprintf(\"outputs.%s\", name)), os.Object)","+\t\t\tcomponentVal = componentVal.FillPath(cue.MakePath(cue.Str(\"outputs\"), cue.Str(name)), os.Object)"],"additions":1,"deletions":1,"truncated":false}],"additions":576,"deletions":15,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-10-20T14:25:08.474026+00:00"}