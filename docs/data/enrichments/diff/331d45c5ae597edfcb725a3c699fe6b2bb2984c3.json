{"id":"331d45c5ae597edfcb725a3c699fe6b2bb2984c3","axis":"silent","repo":"envoyproxy/envoy","sha":"331d45c5ae597edfcb725a3c699fe6b2bb2984c3","parsed":{"files":[{"path":"CODEOWNERS","lines":["@@ -478,6 +478,7 @@"," /*/extensions/router/cluster_specifiers/priority_group @wbpcode @kanurag94"," "," # Queue policy","+/*/extensions/queue_policy/adaptive_lifo @nezdolik @tonya11en @yanavlasov"," /*/extensions/queue_policy/common @nezdolik @yanavlasov @tonya11en @balrawi-figma"," /*/extensions/queue_policy/fifo @nezdolik @yanavlasov @tonya11en @balrawi-figma"," "],"additions":1,"deletions":0,"truncated":false},{"path":"api/BUILD","lines":["@@ -411,6 +411,7 @@ proto_library(","         \"//envoy/extensions/outlier_detection_monitors/consecutive_errors/v3:pkg\",","         \"//envoy/extensions/path/match/uri_template/v3:pkg\",","         \"//envoy/extensions/path/rewrite/uri_template/v3:pkg\",","+        \"//envoy/extensions/queue_policy/adaptive_lifo/v3:pkg\",","         \"//envoy/extensions/queue_policy/fifo/v3:pkg\",","         \"//envoy/extensions/quic/client_writer_factory/v3:pkg\",","         \"//envoy/extensions/quic/connection_debug_visitor/quic_stats/v3:pkg\","],"additions":1,"deletions":0,"truncated":false},{"path":"api/envoy/extensions/queue_policy/adaptive_lifo/v3/BUILD","lines":["@@ -0,0 +1,9 @@","+# DO NOT EDIT. This file is generated by tools/proto_format/proto_sync.py.","+","+load(\"@envoy_api//bazel:api_build_system.bzl\", \"api_proto_package\")","+","+licenses([\"notice\"])  # Apache 2","+","+api_proto_package(","+    deps = [\"@xds//udpa/annotations:pkg\"],","+)"],"additions":9,"deletions":0,"truncated":false},{"path":"api/envoy/extensions/queue_policy/adaptive_lifo/v3/adaptive_lifo.proto","lines":["@@ -0,0 +1,30 @@","+syntax = \"proto3\";","+","+package envoy.extensions.queue_policy.adaptive_lifo.v3;","+","+import \"udpa/annotations/status.proto\";","+import \"validate/validate.proto\";","+","+option java_package = \"io.envoyproxy.envoy.extensions.queue_policy.adaptive_lifo.v3\";","+option java_outer_classname = \"AdaptiveLifoProto\";","+option java_multiple_files = true;","+option go_package = \"github.com/envoyproxy/go-control-plane/envoy/extensions/queue_policy/adaptive_lifo/v3;adaptive_lifov3\";","+option (udpa.annotations.file_status).package_version_status = ACTIVE;","+","+// [#protodoc-title: Adaptive LIFO Queue Policy]","+// [#extension: envoy.queue_policy.adaptive_lifo]","+","+// Configuration for the adaptive LIFO pending requests queue policy. Watermarks are absolute","+// numbers of requests. Each connection pool applies them to its own pending request queue.","+//","+// Requests are dequeued in FIFO order until the queue size reaches the high watermark. Requests","+// are then dequeued in LIFO order until the queue size reaches or falls below the low watermark.","+message AdaptiveLifoQueuePolicyConfig {","+  // Number of queued requests at which the queue switches from FIFO to LIFO ordering.","+  // This must be greater than zero and greater than ``low_watermark``.","+  uint32 high_watermark = 1 [(validate.rules).uint32 = {gt: 0}];","+","+  // Number of queued requests at or below which the queue switches from LIFO back to FIFO","+  // ordering. This may be zero and must be less than ``high_watermark``.","+  uint32 low_watermark = 2;","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"api/versioning/BUILD","lines":["@@ -346,6 +346,7 @@ proto_library(","         \"//envoy/extensions/outlier_detection_monitors/consecutive_errors/v3:pkg\",","         \"//envoy/extensions/path/match/uri_template/v3:pkg\",","         \"//envoy/extensions/path/rewrite/uri_template/v3:pkg\",","+        \"//envoy/extensions/queue_policy/adaptive_lifo/v3:pkg\",","         \"//envoy/extensions/queue_policy/fifo/v3:pkg\",","         \"//envoy/extensions/quic/client_writer_factory/v3:pkg\",","         \"//envoy/extensions/quic/connection_debug_visitor/quic_stats/v3:pkg\","],"additions":1,"deletions":0,"truncated":false},{"path":"changelogs/current/new_features/upstream__adaptive-lifo-queue-policy.rst","lines":["@@ -0,0 +1,5 @@","+Added an :ref:`adaptive LIFO queue policy","+<envoy_v3_api_msg_extensions.queue_policy.adaptive_lifo.v3.AdaptiveLifoQueuePolicyConfig>` for","+pending requests. The policy uses FIFO ordering until a connection pool's queue reaches a","+configured high watermark and LIFO ordering until the size reaches a lower configured watermark.","+Separate watermarks avoid repeated order changes near the overload boundary."],"additions":5,"deletions":0,"truncated":false},{"path":"docs/root/configuration/upstream/cluster_manager/cluster_manager.rst","lines":["@@ -12,3 +12,4 @@ Cluster manager","   cds","   cluster_hc","   cluster_circuit_breakers","+  pending_request_queueing"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/root/configuration/upstream/cluster_manager/cluster_stats.rst","lines":["@@ -99,6 +99,7 @@ Every cluster has a statistics tree rooted at *cluster.<name>.* with the followi","   upstream_cx_protocol_error, Counter, Total connection protocol errors","   upstream_cx_max_requests, Counter, Total connections closed due to maximum requests","   upstream_cx_none_healthy, Counter, Total times connection not established due to no healthy hosts","+  upstream_queue_overloaded, Gauge, Number of connection pool pending request queues currently reporting an overloaded state","   upstream_rq_total, Counter, Total requests","   upstream_rq_active, Gauge, Total active requests","   upstream_rq_pending_total, Counter, Total requests pending a connection pool connection"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/root/configuration/upstream/cluster_manager/pending_request_queueing.rst","lines":["@@ -0,0 +1,62 @@","+.. _config_cluster_manager_pending_request_queueing:","+","+Pending request queueing","+========================","+","+When no upstream connection is immediately available, a connection pool may queue a request while","+it establishes a connection or waits for connection capacity. The","+:ref:`maximum pending requests circuit breaker","+<envoy_v3_api_field_config.cluster.v3.CircuitBreakers.Thresholds.max_pending_requests>` limits how","+many requests may wait. A queue policy controls the order in which those requests are selected when","+capacity becomes available; it does not change the circuit breaker limit.","+","+The policy is configured with","+:ref:`Cluster.queuing_policies","+<envoy_v3_api_field_config.cluster.v3.Cluster.queuing_policies>`. If no policy is configured, Envoy","+uses FIFO ordering.","+","+Queue policies","+--------------","+","+FIFO","+~~~~","+","+The :ref:`FIFO queue policy","+<envoy_v3_api_msg_extensions.queue_policy.fifo.v3.FifoQueuePolicyConfig>` selects the oldest","+pending request first.","+","+Adaptive LIFO","+~~~~~~~~~~~~~","+","+The :ref:`adaptive LIFO queue policy","+<envoy_v3_api_msg_extensions.queue_policy.adaptive_lifo.v3.AdaptiveLifoQueuePolicyConfig>` uses FIFO","+ordering until the queue size reaches the configured high watermark. It then selects the most","+recently queued request until the queue size reaches or falls below the low watermark. The","+watermarks are absolute request counts applied independently to each connection pool's pending","+request queue.","+Separate watermarks prevent the policy from repeatedly switching order near the overload boundary.","+","+Adaptive LIFO prioritizes newer requests during overload. Older requests may wait longer, and under","+sustained overload they may time out before being selected.","+","+The following cluster fragment configures each connection pool to enter LIFO mode when it has 80","+pending requests and return to FIFO mode when it has 60 or fewer pending requests:","+","+.. code-block:: yaml","+","+  queuing_policies:","+    pending_rq_policy:","+      name: envoy.queue_policy.adaptive_lifo","+      typed_config:","+        \"@type\": type.googleapis.com/envoy.extensions.queue_policy.adaptive_lifo.v3.AdaptiveLifoQueuePolicyConfig","+        high_watermark: 80","+        low_watermark: 60","+","+Observability","+-------------","+","+The ``upstream_rq_pending_active`` gauge reports the number of requests currently waiting for a","+connection pool connection. For queue policies that report an overloaded state, such as adaptive","+LIFO, ``upstream_queue_overloaded`` reports the number of connection pool pending request queues","+currently overloaded. Both are documented in the :ref:`cluster statistics","+<config_cluster_manager_cluster_stats>`."],"additions":62,"deletions":0,"truncated":false},{"path":"source/common/conn_pool/conn_pool_base.cc","lines":["@@ -95,8 +95,7 @@ size_t ConnPoolImplBase::pendingStreamCount() const { return pending_streams_.si"," "," PendingStreamPtr ConnPoolImplBase::popPendingStream() {","   ASSERT(!pending_streams_.empty());","-  PendingStream& stream = pending_stream_queue_->peek();","-  pending_stream_queue_->pop();","+  PendingStream& stream = pending_stream_queue_->pop();","   PendingStreamPtr pending_stream = stream.removeFromList(pending_streams_);","   ASSERT(pending_streams_.size() == pending_stream_queue_->size());","   return pending_stream;","@@ -116,6 +115,8 @@ void ConnPoolImplBase::updateQueueOverloadedGauge() {","   }"," ","   queue_overloaded_ = queue_overloaded;","+  // TODO(nezdolik): Count transitions into the overloaded state. Short-lived overloads between","+  // stats scrapes are not visible through the gauge alone.","   if (queue_overloaded_) {","     host_->cluster().trafficStats()->upstream_queue_overloaded_.inc();","   } else {","@@ -473,16 +474,15 @@ void ConnPoolImplBase::scheduleOnUpstreamReady() {"," "," void ConnPoolImplBase::onUpstreamReady() {","   while (hasPendingStreams() && !ready_clients_.empty()) {","-    PendingStream& stream = pending_stream_queue_->peek();","     ActiveClientPtr& client = ready_clients_.front();","     ENVOY_CONN_LOG(debug, \"attaching to next stream\", *client);","-    // FIFO pending streams are pulled from the front, where the oldest stream is stored.","     if (Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.conn_pool_fix_reentrancy\")) {","       PendingStreamPtr pending_stream = popPendingStream();","       cluster_connectivity_state_.decrPendingStreams(1);","       updateQueueOverloadedGauge();","       attachStreamToClient(*client, pending_stream->context());","     } else {","+      PendingStream& stream = pending_stream_queue_->peek();","       attachStreamToClient(*client, stream.context());","       cluster_connectivity_state_.decrPendingStreams(1);","       removePendingStream(stream);"],"additions":4,"deletions":4,"truncated":false},{"path":"source/common/queue_policy/BUILD","lines":["@@ -11,7 +11,9 @@ envoy_package()"," envoy_cc_library(","     name = \"queue_policy_base_lib\",","     hdrs = [","+        \"adaptive_lifo_queue.h\",","         \"fifo_queue_policy.h\",","+        \"list_queue_base.h\",","         \"queue_policy_base.h\",","     ],","     deps = ["],"additions":2,"deletions":0,"truncated":false},{"path":"source/common/queue_policy/adaptive_lifo_queue.h","lines":["@@ -0,0 +1,53 @@","+#pragma once","+","+#include <cstdint>","+","+#include \"source/common/common/assert.h\"","+#include \"source/common/queue_policy/list_queue_base.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace QueuePolicy {","+","+template <class ItemType> class AdaptiveLifoQueue : public ListQueueBase<ItemType> {","+public:","+  AdaptiveLifoQueue(uint32_t high_watermark, uint32_t low_watermark)","+      : high_watermark_(high_watermark), low_watermark_(low_watermark) {","+    ASSERT(high_watermark > 0);","+    ASSERT(low_watermark < high_watermark);","+  }","+","+  void add(ItemType& item, QueueItemMetadata metadata) override {","+    ListQueueBase<ItemType>::add(item, metadata);","+    updateMode();","+  }","+","+  void remove(ItemType& item) override {","+    ListQueueBase<ItemType>::remove(item);","+    updateMode();","+  }","+","+  bool isOverloaded() const override { return lifo_mode_; }","+","+protected:","+  bool shouldDequeueFromBack() const override { return lifo_mode_; }","+","+private:","+  void updateMode() {","+    if (lifo_mode_) {","+      if (this->size() <= low_watermark_) {","+        lifo_mode_ = false;","+      }","+    } else if (this->size() >= high_watermark_) {","+      lifo_mode_ = true;","+    }","+  }","+","+  const uint32_t high_watermark_;","+  const uint32_t low_watermark_;","+  bool lifo_mode_{false};","+};","+","+} // namespace QueuePolicy","+} // namespace Extensions","+} // namespace Envoy"],"additions":53,"deletions":0,"truncated":false},{"path":"source/common/queue_policy/fifo_queue_policy.h","lines":["@@ -1,71 +1,17 @@"," #pragma once"," ","-#include <list>","-","-#include \"source/common/common/assert.h\"","-#include \"source/common/queue_policy/queue_policy_base.h\"","-","-#include \"absl/container/flat_hash_map.h\"","-#include \"absl/functional/function_ref.h\"","+#include \"source/common/queue_policy/list_queue_base.h\""," "," namespace Envoy {"," namespace Extensions {"," namespace QueuePolicy {"," ","-template <class ItemType> class FifoQueue : public QueueBase<ItemType> {","+template <class ItemType> class FifoQueue : public ListQueueBase<ItemType> {"," public:","-  FifoQueue() = default;","-  ~FifoQueue() override = default;","-","-  size_t size() const override { return items_.size(); }","-","-  bool empty() const override { return items_.empty(); }","-","-  void add(ItemType& item, QueueItemMetadata) override {","-    ASSERT(item_index_.find(&item) == item_index_.end());","-    item_index_.emplace(&item, items_.insert(items_.end(), &item));","-  }","-","-  const ItemType& peek() const override {","-    ASSERT(!items_.empty());","-    return *items_.front();","-  }","-","-  ItemType& peek() override {","-    ASSERT(!items_.empty());","-    return *items_.front();","-  }","-","-  void pop() override {","-    ASSERT(!items_.empty());","-    remove(*items_.front());","-  }","-","-  void remove(ItemType& item) override {","-    auto entry = item_index_.find(&item);","-    ASSERT(entry != item_index_.end());","-    items_.erase(entry->second);","-    item_index_.erase(entry);","-  }","-","   bool isOverloaded() const override { return false; }"," ","-  void forEach(absl::FunctionRef<bool(ItemType&)> cb) override {","-    for (auto it = items_.begin(); it != items_.end();) {","-      // Advance before invoking the callback so that the callback may safely remove the","-      // visited item from the queue.","-      ItemType& item = **it;","-      ++it;","-      if (!cb(item)) {","-        return;","-      }","-    }","-  }","-","-private:","-  using ItemList = std::list<ItemType*>;","-  ItemList items_;","-  absl::flat_hash_map<ItemType*, typename ItemList::iterator> item_index_;","+protected:","+  bool shouldDequeueFromBack() const override { return false; }"," };"," "," } // namespace QueuePolicy"],"additions":4,"deletions":58,"truncated":false},{"path":"source/common/queue_policy/list_queue_base.h","lines":["@@ -0,0 +1,95 @@","+#pragma once","+","+#include <list>","+","+#include \"source/common/common/assert.h\"","+#include \"source/common/queue_policy/queue_policy_base.h\"","+","+#include \"absl/container/flat_hash_map.h\"","+#include \"absl/functional/function_ref.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace QueuePolicy {","+","+// Shared list storage for queue policies that select from either end of the list.","+template <class ItemType> class ListQueueBase : public QueueBase<ItemType> {","+public:","+  size_t size() const override { return items_.size(); }","+","+  bool empty() const override { return items_.empty(); }","+","+  void add(ItemType& item, QueueItemMetadata) override {","+    ASSERT(item_index_.find(&item) == item_index_.end());","+    item_index_.emplace(&item, items_.insert(items_.end(), &item));","+  }","+","+  const ItemType& peek() const override { return *nextItem(); }","+","+  ItemType& peek() override { return *nextItem(); }","+","+  ItemType& pop() override {","+    ItemType& item = *nextItem();","+    remove(item);","+    return item;","+  }","+","+  void remove(ItemType& item) override {","+    auto entry = item_index_.find(&item);","+    ASSERT(entry != item_index_.end());","+    items_.erase(entry->second);","+    item_index_.erase(entry);","+  }","+","+  void forEach(absl::FunctionRef<bool(ItemType&)> cb) override {","+    if (items_.empty()) {","+      return;","+    }","+","+    size_t remaining = items_.size();","+    ItemType* next_fifo = items_.front();","+    ItemType* next_lifo = items_.back();","+    while (remaining > 0) {","+      const bool use_lifo = shouldDequeueFromBack();","+      ItemType* item = use_lifo ? next_lifo : next_fifo;","+      auto entry = item_index_.find(item);","+      ASSERT(entry != item_index_.end());","+","+      --remaining;","+      if (remaining > 0) {","+        auto next = entry->second;","+        if (use_lifo) {","+          ASSERT(next != items_.begin());","+          --next;","+          next_lifo = *next;","+        } else {","+          ++next;","+          ASSERT(next != items_.end());","+          next_fifo = *next;","+        }","+      }","+","+      if (!cb(*item)) {","+        return;","+      }","+    }","+  }","+","+protected:","+  // Re-evaluated during traversal because callback removal can change the dequeue order.","+  virtual bool shouldDequeueFromBack() const PURE;","+","+private:","+  ItemType* nextItem() const {","+    ASSERT(!items_.empty());","+    return shouldDequeueFromBack() ? items_.back() : items_.front();","+  }","+","+  using ItemList = std::list<ItemType*>;","+  ItemList items_;","+  absl::flat_hash_map<ItemType*, typename ItemList::iterator> item_index_;","+};","+","+} // namespace QueuePolicy","+} // namespace Extensions","+} // namespace Envoy"],"additions":95,"deletions":0,"truncated":false},{"path":"source/common/queue_policy/queue_policy_base.h","lines":["@@ -1,5 +1,6 @@"," #pragma once"," ","+#include <cstddef>"," #include <memory>"," "," #include \"envoy/common/time.h\"","@@ -37,8 +38,9 @@ template <class ItemType> class QueueBase {","   virtual const ItemType& peek() const PURE;","   virtual ItemType& peek() PURE;"," ","-  // Removes the next item from the queue without destroying it.","-  virtual void pop() PURE;","+  // Removes and returns the next item from the queue without destroying it. The caller retains","+  // ownership of the returned item.","+  virtual ItemType& pop() PURE;"," ","   // Removes a specific item from the queue without destroying it.","   virtual void remove(ItemType& item) PURE;"],"additions":4,"deletions":2,"truncated":false},{"path":"source/common/upstream/upstream_impl.cc","lines":["@@ -115,6 +115,7 @@ resolvePendingRqQueuePolicy(","   RETURN_IF_NOT_OK(Config::Utility::translateOpaqueConfig(queue_policy_config.typed_config(),","                                                           server_context.messageValidationVisitor(),","                                                           *factory_config));","+  // This instance is only used to run factory-specific validation.","   auto queue = factory->createQueuePolicy(*factory_config, stat_prefix,","                                           server_context.messageValidationVisitor());","   RETURN_IF_NOT_OK(queue.status());"],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/extensions_build_config.bzl","lines":["@@ -706,6 +706,7 @@ EXTENSIONS = {","     #","     # Queue policy","     #","+    \"envoy.queue_policy.adaptive_lifo\": \"//source/extensions/queue_policy/adaptive_lifo:adaptive_lifo_queue_policy_impl\",","     \"envoy.queue_policy.fifo\":   \"//source/extensions/queue_policy/fifo:fifo_queue_policy_impl\","," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/extensions_metadata.yaml","lines":["@@ -1461,6 +1461,13 @@ envoy.udp_packet_writer.gso:","   status: stable","   type_urls:","   - envoy.extensions.udp_packet_writer.v3.UdpGsoBatchWriterFactory","+envoy.queue_policy.adaptive_lifo:","+  categories:","+  - envoy.queue_policy","+  security_posture: robust_to_untrusted_downstream_and_upstream","+  status: alpha","+  type_urls:","+  - envoy.extensions.queue_policy.adaptive_lifo.v3.AdaptiveLifoQueuePolicyConfig"," envoy.queue_policy.fifo:","   categories:","   - envoy.queue_policy"],"additions":7,"deletions":0,"truncated":false},{"path":"source/extensions/queue_policy/adaptive_lifo/BUILD","lines":["@@ -0,0 +1,25 @@","+load(","+    \"//bazel:envoy_build_system.bzl\",","+    \"envoy_cc_extension\",","+    \"envoy_extension_package\",","+)","+","+licenses([\"notice\"])  # Apache 2","+","+envoy_extension_package()","+","+envoy_cc_extension(","+    name = \"adaptive_lifo_queue_policy_impl\",","+    srcs = [\"adaptive_lifo_queue_policy.cc\"],","+    hdrs = [\"adaptive_lifo_queue_policy.h\"],","+    deps = [","+        \"//envoy/registry\",","+        \"//source/common/config:utility_lib\",","+        \"//source/common/conn_pool:conn_pool_base_lib\",","+        \"//source/common/protobuf:utility_lib\",","+        \"//source/common/queue_policy:queue_policy_base_lib\",","+        \"@abseil-cpp//absl/status\",","+        \"@abseil-cpp//absl/status:statusor\",","+        \"@envoy_api//envoy/extensions/queue_policy/adaptive_lifo/v3:pkg_cc_proto\",","+    ],","+)"],"additions":25,"deletions":0,"truncated":false},{"path":"source/extensions/queue_policy/adaptive_lifo/adaptive_lifo_queue_policy.cc","lines":["@@ -0,0 +1,20 @@","+#include \"source/extensions/queue_policy/adaptive_lifo/adaptive_lifo_queue_policy.h\"","+","+#include \"envoy/registry/registry.h\"","+","+#include \"source/common/conn_pool/pending_stream.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace QueuePolicy {","+namespace {","+using PendingStreamAdaptiveLifoQueueFactory =","+    AdaptiveLifoQueueFactory<ConnectionPool::PendingStream>;","+}","+","+REGISTER_FACTORY(PendingStreamAdaptiveLifoQueueFactory,","+                 QueuePolicyFactory<ConnectionPool::PendingStream>);","+","+} // namespace QueuePolicy","+} // namespace Extensions","+} // namespace Envoy"],"additions":20,"deletions":0,"truncated":false},{"path":"source/extensions/queue_policy/adaptive_lifo/adaptive_lifo_queue_policy.h","lines":["@@ -0,0 +1,51 @@","+#pragma once","+","+#include \"envoy/extensions/queue_policy/adaptive_lifo/v3/adaptive_lifo.pb.h\"","+#include \"envoy/extensions/queue_policy/adaptive_lifo/v3/adaptive_lifo.pb.validate.h\"","+","+#include \"source/common/protobuf/utility.h\"","+#include \"source/common/queue_policy/adaptive_lifo_queue.h\"","+#include \"source/common/queue_policy/queue_policy_base.h\"","+","+#include \"absl/status/status.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace QueuePolicy {","+","+template <class ItemType> class AdaptiveLifoQueueFactory : public QueuePolicyFactory<ItemType> {","+public:","+  ProtobufTypes::MessagePtr createEmptyConfigProto() override {","+    return std::make_unique<","+        envoy::extensions::queue_policy::adaptive_lifo::v3::AdaptiveLifoQueuePolicyConfig>();","+  }","+","+  absl::StatusOr<QueuePolicyUniquePtr<ItemType>>","+  createQueuePolicy(const Protobuf::Message& config, const std::string& stat_prefix,","+                    ProtobufMessage::ValidationVisitor& validation_visitor) override {","+    return createQueuePolicyTyped(","+        MessageUtil::downcastAndValidate<const envoy::extensions::queue_policy::adaptive_lifo::v3::","+                                             AdaptiveLifoQueuePolicyConfig&>(config,","+                                                                             validation_visitor),","+        stat_prefix);","+  }","+","+  std::string name() const override { return \"envoy.queue_policy.adaptive_lifo\"; }","+","+private:","+  absl::StatusOr<QueuePolicyUniquePtr<ItemType>> createQueuePolicyTyped(","+      const envoy::extensions::queue_policy::adaptive_lifo::v3::AdaptiveLifoQueuePolicyConfig&","+          config,","+      const std::string&) {","+    if (config.low_watermark() >= config.high_watermark()) {","+      return absl::InvalidArgumentError(","+          \"adaptive LIFO low_watermark must be less than high_watermark\");","+    }","+    return std::make_unique<AdaptiveLifoQueue<ItemType>>(config.high_watermark(),","+                                                         config.low_watermark());","+  }","+};","+","+} // namespace QueuePolicy","+} // namespace Extensions","+} // namespace Envoy"],"additions":51,"deletions":0,"truncated":false},{"path":"test/common/conn_pool/conn_pool_base_test.cc","lines":["@@ -106,9 +106,11 @@ class TestPendingStreamQueue : public Extensions::QueuePolicy::QueueBase<Pending","   const PendingStream& peek() const override { return *items_.back(); }","   PendingStream& peek() override { return *items_.back(); }"," ","-  void pop() override {","+  PendingStream& pop() override {","     ASSERT(!items_.empty());","+    PendingStream& item = *items_.back();","     items_.pop_back();","+    return item;","   }"," ","   bool isOverloaded() const override { return items_.size() > 1; }"],"additions":3,"deletions":1,"truncated":false},{"path":"test/extensions/queue_policy/adaptive_lifo/BUILD","lines":["@@ -0,0 +1,24 @@","+load(","+    \"//bazel:envoy_build_system.bzl\",","+    \"envoy_package\",","+)","+load(","+    \"//test/extensions:extensions_build_system.bzl\",","+    \"envoy_extension_cc_test\",","+)","+","+licenses([\"notice\"])  # Apache 2","+","+envoy_package()","+","+envoy_extension_cc_test(","+    name = \"adaptive_lifo_queue_policy_test\",","+    srcs = [\"adaptive_lifo_queue_policy_test.cc\"],","+    extension_names = [\"envoy.queue_policy.adaptive_lifo\"],","+    deps = [","+        \"//source/common/protobuf:message_validator_lib\",","+        \"//source/extensions/queue_policy/adaptive_lifo:adaptive_lifo_queue_policy_impl\",","+        \"@abseil-cpp//absl/status\",","+        \"@abseil-cpp//absl/status:statusor\",","+    ],","+)"],"additions":24,"deletions":0,"truncated":false},{"path":"test/extensions/queue_policy/adaptive_lifo/adaptive_lifo_queue_policy_test.cc","lines":["@@ -0,0 +1,219 @@","+#include <cstdint>","+#include <type_traits>","+#include <utility>","+#include <vector>","+","+#include \"source/common/protobuf/message_validator_impl.h\"","+#include \"source/extensions/queue_policy/adaptive_lifo/adaptive_lifo_queue_policy.h\"","+","+#include \"absl/status/status.h\"","+#include \"gtest/gtest.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace QueuePolicy {","+namespace {","+","+class TestQueueItem {","+public:","+  explicit TestQueueItem(int value) : value_(value) {}","+  int value() const { return value_; }","+","+private:","+  const int value_;","+};","+","+using AdaptiveLifoQueuePolicyConfig =","+    envoy::extensions::queue_policy::adaptive_lifo::v3::AdaptiveLifoQueuePolicyConfig;","+","+TEST(AdaptiveLifoQueueTest, SwitchesBetweenFifoAndLifo) {","+  TestQueueItem first(1);","+  TestQueueItem second(2);","+  TestQueueItem third(3);","+  TestQueueItem fourth(4);","+  AdaptiveLifoQueue<TestQueueItem> queue(3, 1);","+","+  queue.add(first, {MonotonicTime{}});","+  queue.add(second, {MonotonicTime{}});","+  EXPECT_FALSE(queue.isOverloaded());","+  EXPECT_EQ(queue.peek().value(), 1);","+","+  queue.add(third, {MonotonicTime{}});","+  EXPECT_TRUE(queue.isOverloaded());","+  EXPECT_EQ(queue.peek().value(), 3);","+","+  static_assert(std::is_same_v<decltype(queue.pop()), TestQueueItem&>);","+  EXPECT_EQ(queue.pop().value(), 3);","+  EXPECT_TRUE(queue.isOverloaded());","+  EXPECT_EQ(queue.peek().value(), 2);","+","+  EXPECT_EQ(queue.pop().value(), 2);","+  EXPECT_FALSE(queue.isOverloaded());","+  EXPECT_EQ(queue.peek().value(), 1);","+","+  queue.add(fourth, {MonotonicTime{}});","+  EXPECT_FALSE(queue.isOverloaded());","+  const AdaptiveLifoQueue<TestQueueItem>& const_queue = queue;","+  static_assert(std::is_same_v<decltype(const_queue.peek()), const TestQueueItem&>);","+  EXPECT_EQ(const_queue.peek().value(), 1);","+","+  queue.remove(first);","+  EXPECT_FALSE(queue.isOverloaded());","+  EXPECT_EQ(queue.pop().value(), 4);","+  EXPECT_TRUE(queue.empty());","+}","+","+TEST(AdaptiveLifoQueueTest, ForEachUsesCurrentDequeueOrder) {","+  TestQueueItem first(1);","+  TestQueueItem second(2);","+  TestQueueItem third(3);","+  AdaptiveLifoQueue<TestQueueItem> queue(3, 1);","+  queue.add(first, {MonotonicTime{}});","+  queue.add(second, {MonotonicTime{}});","+","+  std::vector<int> visited;","+  queue.forEach([&visited](TestQueueItem& item) -> bool {","+    visited.push_back(item.value());","+    return true;","+  });","+  EXPECT_EQ(visited, (std::vector<int>{1, 2}));","+","+  queue.add(third, {MonotonicTime{}});","+  visited.clear();","+  queue.forEach([&queue, &visited](TestQueueItem& item) -> bool {","+    visited.push_back(item.value());","+    if (item.value() == 2) {","+      queue.remove(item);","+    }","+    return true;","+  });","+  EXPECT_EQ(visited, (std::vector<int>{3, 2, 1}));","+  EXPECT_EQ(queue.size(), 2);","+  EXPECT_TRUE(queue.isOverloaded());","+  EXPECT_EQ(queue.peek().value(), 3);","+}","+","+TEST(AdaptiveLifoQueueTest, ForEachTracksDequeueOrderAcrossModeChange) {","+  std::vector<TestQueueItem> items;","+  for (int value = 1; value <= 8; ++value) {","+    items.emplace_back(value);","+  }","+","+  AdaptiveLifoQueue<TestQueueItem> queue(8, 6);","+  for (TestQueueItem& item : items) {","+    queue.add(item, {MonotonicTime{}});","+  }","+","+  std::vector<int> visited;","+  queue.forEach([&queue, &visited](TestQueueItem& item) -> bool {","+    visited.push_back(item.value());","+    queue.remove(item);","+    return true;","+  });","+","+  EXPECT_EQ(visited, (std::vector<int>{8, 7, 1, 2, 3, 4, 5, 6}));","+  EXPECT_TRUE(queue.empty());","+}","+","+TEST(AdaptiveLifoQueueTest, ForEachStopsEarly) {","+  TestQueueItem first(1);","+  TestQueueItem second(2);","+  AdaptiveLifoQueue<TestQueueItem> queue(2, 1);","+  queue.add(first, {MonotonicTime{}});","+  queue.add(second, {MonotonicTime{}});","+","+  std::vector<int> visited;","+  queue.forEach([&visited](TestQueueItem& item) -> bool {","+    visited.push_back(item.value());","+    return false;","+  });","+  EXPECT_EQ(visited, (std::vector<int>{2}));","+}","+","+TEST(AdaptiveLifoQueueTest, ThresholdOneUsesLifoUntilEmpty) {","+  TestQueueItem first(1);","+  TestQueueItem second(2);","+  AdaptiveLifoQueue<TestQueueItem> queue(1, 0);","+","+  queue.add(first, {MonotonicTime{}});","+  EXPECT_TRUE(queue.isOverloaded());","+  EXPECT_EQ(queue.peek().value(), 1);","+","+  queue.add(second, {MonotonicTime{}});","+  EXPECT_EQ(queue.pop().value(), 2);","+  EXPECT_TRUE(queue.isOverloaded());","+  EXPECT_EQ(queue.pop().value(), 1);","+  EXPECT_FALSE(queue.isOverloaded());","+  EXPECT_TRUE(queue.empty());","+}","+","+TEST(AdaptiveLifoQueueTest, DrainAndRefillResetsLifoMode) {","+  TestQueueItem first(1);","+  TestQueueItem second(2);","+  TestQueueItem third(3);","+  TestQueueItem fourth(4);","+  TestQueueItem fifth(5);","+  AdaptiveLifoQueue<TestQueueItem> queue(3, 0);","+","+  queue.add(first, {MonotonicTime{}});","+  queue.add(second, {MonotonicTime{}});","+  queue.add(third, {MonotonicTime{}});","+  EXPECT_TRUE(queue.isOverloaded());","+","+  EXPECT_EQ(queue.pop().value(), 3);","+  EXPECT_EQ(queue.pop().value(), 2);","+  EXPECT_EQ(queue.pop().value(), 1);","+","+  // Do not query the empty queue before refilling it.","+  queue.add(fourth, {MonotonicTime{}});","+  queue.add(fifth, {MonotonicTime{}});","+  EXPECT_FALSE(queue.isOverloaded());","+  EXPECT_EQ(queue.pop().value(), 4);","+  EXPECT_EQ(queue.pop().value(), 5);","+}","+","+class AdaptiveLifoQueueFactoryTest : public testing::Test {","+protected:","+  absl::StatusOr<QueuePolicyUniquePtr<TestQueueItem>>"],"additions":177,"deletions":0,"truncated":false}],"additions":582,"deletions":65,"truncated":true,"file_count":24},"error":null,"fetched_at":"2026-10-30T15:56:13.344024+00:00"}