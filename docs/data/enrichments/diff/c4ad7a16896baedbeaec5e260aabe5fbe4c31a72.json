+        })","+        const wasChecked = await toggle.isChecked()","+        const stateHistory = await columns.evaluateHandle(","+          (container, label) => {","+            const readChecked = () =>","+              container.querySelector<HTMLInputElement>(`input[aria-label=\"${label}\"]`)?.checked","+            const states = [readChecked()]","+            const observer = new MutationObserver(() => {","+              const checked = readChecked()","+","+              if (checked !== undefined && states.at(-1) !== checked) {","+                states.push(checked)","+              }","+            })","+","+            observer.observe(container, {","+              attributes: true,","+              childList: true,","+              subtree: true,","+            })","+            return { observer, states }","+          },","+          isInDrawer ? 'Email' : 'Title',","+        )","+        let hasDisposedHistory = false","+        let releaseNavigation: () => void","+        let hasHeldRequest = false","+        const navigationGate = new Promise<void>((resolve) => {","+          releaseNavigation = resolve","+        })","+        const holdNavigation = async (route: Route) => {","+          const request = route.request()","+","+          if (","+            !['fetch', 'xhr'].includes(request.resourceType()) ||","+            new URL(request.url()).origin !== new URL(serverURL).origin","+          ) {","+            await route.continue()","+            return","+          }","+","+          hasHeldRequest = true","+          await navigationGate","+          if (!request.failure()) {","+            await route.continue()","+          }","+        }","+","+        await page.route('**/*', holdNavigation)","+","+        try {","+          await toggle.click()","+          await expect.poll(() => hasHeldRequest).toBe(true)","+          // Flush rendering while the navigation request is still withheld.","+          await page.evaluate(","+            () =>","+              new Promise<void>((resolve) => {","+                requestAnimationFrame(() => requestAnimationFrame(() => resolve()))","+              }),","+          )","+          await expect(toggle).toBeChecked({ checked: !wasChecked })","+          await expect(page.locator('.progress-bar')).toBeVisible()","+","+          if (shouldToggleTwice) {","+            await toggle.click()","+            await expect(toggle).toBeChecked({ checked: wasChecked })","+          }","+          releaseNavigation!()","+          // Superseded navigations can cancel a held request.","+          await page.unrouteAll({ behavior: shouldToggleTwice ? 'ignoreErrors' : 'wait' })","+","+          await expect(page.locator('.progress-bar')).toBeHidden()","+          const states = await stateHistory.evaluate(({ observer, states }) => {","+            observer.disconnect()","+            return states","+          })","+","+          await stateHistory.dispose()","+          hasDisposedHistory = true","+          expect(states).toEqual(","+            shouldToggleTwice ? [wasChecked, !wasChecked, wasChecked] : [wasChecked, !wasChecked],","+          )","+","+          if (!isInDrawer) {","+            await page.reload()","+            await page.getByRole('button', { name: 'Columns', exact: true }).click()","+          }","+          await expect(toggle).toBeChecked({","+            checked: shouldToggleTwice ? wasChecked : !wasChecked,","+          })","+        } finally {","+          releaseNavigation!()","+          await page.unrouteAll({ behavior: 'ignoreErrors' })"],"additions":113,"deletions":1,"truncated":false}],"additions":235,"deletions":95,"truncated":true,"file_count":31},"error":null,"fetched_at":"2026-10-21T13:27:35.439889+00:00"}