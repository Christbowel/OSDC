page for param-less `/buy` deep links: routed into the in-app","+ * flow with nothing to pre-select, so it opens token selection instead of","+ * build-quote.","+ */","+class RampsTokenSelectionPage {","+  private driver: Driver;","+","+  // Private selector properties (sorted alphabetically)","+  private readonly rampsTokenSelectionBackButton =","+    '[data-testid=\"ramps-token-selection-back\"]';","+","+  private readonly rampsTokenSelectionHashPath = '#/ramps/token-selection';","+","+  constructor(driver: Driver) {","+    this.driver = driver;","+  }","+","+  // Public methods (sorted alphabetically)","+  async checkPageIsLoaded(): Promise<void> {","+    await this.driver.waitForUrlContaining({","+      url: this.rampsTokenSelectionHashPath,","+    });","+    await this.driver.waitForSelector(this.rampsTokenSelectionBackButton);","+  }","+}","+","+export default RampsTokenSelectionPage;"],"additions":30,"deletions":0,"truncated":false},{"path":"test/e2e/route-registry/route-registry.ts","lines":["@@ -191,6 +191,7 @@ export const ROUTE_PAGE_OBJECT_REGISTRY: RoutePageObjectRegistry = {","   '/ramps/token-selection': null,","   '/ramps/payment-method': null,","   '/ramps/complete-buy': null,","+  '/ramps/buy-interstitial': null,"," ","   // Send, swap and bridge","   '/send/:page?': SendPage,"],"additions":1,"deletions":0,"truncated":false},{"path":"test/e2e/tests/deep-link/deep-link-route-buy-ramps.spec.ts","lines":["@@ -0,0 +1,84 @@","+import { withFixtures } from '../../helpers';","+import { Driver } from '../../webdriver/driver';","+import LoginPage from '../../page-objects/pages/onboarding/login-page';","+import HomePage from '../../page-objects/pages/home/homepage';","+import RampsBuildQuotePage from '../../page-objects/pages/ramps/ramps-build-quote-page';","+import RampsTokenSelectionPage from '../../page-objects/pages/ramps/ramps-token-selection-page';","+import { navigateDeepLinkToDestination } from '../../page-objects/flows/deep-link.flow';","+import {","