        verifyException(e, \"unrecognized token\");","         TokenStreamLocation loc = e.getLocation();","         assertNull(loc.contentReference().getRawContent());","+        assertTrue(loc.contentReference().hasTextualContent());","         assertThat(loc.sourceDescription()).startsWith(\"REDACTED\");","+        assertEquals(\"line: 1, column: 3\", loc.offsetDescription());","+    }","+","+    // for [jackson-core#1833]","+    @Test","+    void redactedLocationPreservesTextualLineAndColumn() throws Exception","+    {","+        final String DOC = \"{\\n  \\\"a\\\": 1,\\n  \\\"b\\\": x\\n}\";","+        final JsonFactory fDisabled = JsonFactory.builder()","+                .disable(StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION)","+                .build();","+        final JsonFactory fEnabled = JsonFactory.builder()","+                .enable(StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION)","+                .build();","+","+        // Textual inputs (String, char[], Reader, byte[], InputStream) should report line & column","+        // regardless of whether INCLUDE_SOURCE_IN_LOCATION is enabled or disabled","+        for (JsonFactory f : new JsonFactory[] { fDisabled, fEnabled }) {","+            boolean incl = f.isEnabled(StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION);","+            _verifyTextualErrorLocation(f.createParser(ObjectReadContext.empty(), DOC),","+                    incl, \"line: 3, column: 8\");","+            _verifyTextualErrorLocation(f.createParser(ObjectReadContext.empty(), DOC.toCharArray()),","+                    incl, \"line: 3, column: 8\");","+            _verifyTextualErrorLocation(f.createParser(ObjectReadContext.empty(), new StringReader(DOC)),","+                    incl, \"line: 3, column: 8\");","+            _verifyTextualErrorLocation(f.createParser(ObjectReadContext.empty(), utf8Bytes(DOC)),","+                    incl, \"line: 3, column: 8\");","+            _verifyTextualErrorLocation(f.createParser(ObjectReadContext.empty(), new ByteArrayInputStream(utf8Bytes(DOC))),","+                    incl, \"line: 3, column: 8\");","+            _verifyTextualErrorLocation(f.createParser(ObjectReadContext.empty(), (DataInput) new MockDataInput(DOC)),","+                    incl, \"line: 3, column: UNKNOWN\");","+","+            // Non-blocking parser too","+            JsonParser asyncP = f.createNonBlockingByteArrayParser(ObjectReadContext.empty());","+            ByteArrayFeeder feeder = (ByteArrayFeeder) asyncP.nonBlockingInputFeeder();","+            byte[] bytes = utf8Bytes(DOC);","+            feeder.feedInput(bytes, 0, bytes.length);","+            feeder.endOfInput();","+            _verifyTextualErrorLocation(asyncP, incl, \"line: 3, column: 8\");","+        }","+","+        // Also check direct ContentReference.redacted(boolean)","+        ContentReference binaryRedacted = ContentReference.redacted(false);","+        assertFalse(binaryRedacted.hasTextualContent());","+        assertThat(binaryRedacted.buildSourceDescription()).startsWith(\"REDACTED\");","+        assertEquals(\"[Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); byte offset: #19]\",","+                new TokenStreamLocation(binaryRedacted, 19L, -1L, -1, -1).toString());","+","+        ContentReference textualRedacted = ContentReference.redacted(true);","+        assertTrue(textualRedacted.hasTextualContent());","+        assertThat(textualRedacted.buildSourceDescription()).startsWith(\"REDACTED\");","+        assertEquals(\"[Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 3, column: 8]\",","+                new TokenStreamLocation(textualRedacted, 19L, 19L, 3, 8).toString());","+    }","+","+    private void _verifyTextualErrorLocation(JsonParser p, boolean includeSource, String expectedOffsetDesc)","+    {","+        try (p) {","+            while (p.nextToken() != null) { }","+            fail(\"Should not pass\");","+        } catch (StreamReadException e) {","+            TokenStreamLocation loc = e.getLocation();","+            assertTrue(loc.contentReference().hasTextualContent());","+            assertEquals(3, loc.getLineNr());","+            assertEquals(expectedOffsetDesc, loc.offsetDescription());","+            if (includeSource) {","+                assertThat(loc.sourceDescription()).doesNotStartWith(\"REDACTED\");","+            } else {","+                assertNull(loc.contentReference().getRawContent());","+                assertThat(loc.sourceDescription()).startsWith(\"REDACTED\");","+                assertThat(e.getMessage()).contains(\"REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); \"","+                        + expectedOffsetDesc);","+            }","+        }","     }"," ","     // for [jackson-core#739]: try to support equality","@@ -174,6 +253,15 @@ void locationEquality() throws Exception","                 5L, 0L, 1, 2);","         assertNotEquals(loc1, loc2);","         assertNotEquals(loc2, loc1);","+","+        // [core#1833]: textual vs binary must also match","+        assertNotEquals(ContentReference.redacted(true), ContentReference.redacted(false));","+        assertNotEquals(_rawSourceRef(true, src1), _rawSourceRef(false, src1));","+        loc1 = new TokenStreamLocation(ContentReference.redacted(true), 19L, 19L, 3, 8);","+        loc2 = new TokenStreamLocation(ContentReference.redacted(false), 19L, 19L, 3, 8);","+        assertNotEquals(loc1.offsetDescription(), loc2.offsetDescription());","+        assertNotEquals(loc1, loc2);","+        assertNotEquals(loc2, loc1);","     }"," ","     private ContentReference _sourceRef(String rawSrc) {"],"additions":88,"deletions":0,"truncated":false},{"path":"src/test/java/tools/jackson/core/unittest/read/loc/SourceLocationNote1158Test.java","lines":["@@ -29,6 +29,10 @@ void omitsRedactionNoteAcrossInputModes() throws Exception","                 _verifySuppressed(e.getLocation());","                 assertFalse(e.getMessage