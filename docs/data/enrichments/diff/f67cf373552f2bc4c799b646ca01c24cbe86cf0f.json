ions":1207,"truncated":true},{"path":"Cargo.toml","lines":["@@ -22,6 +22,7 @@ members = [","     \"server-cli\",","     \"voxygen\",","     \"voxygen/anim\",","+    \"voxygen/credentialstore\",","     \"voxygen/egui\",","     \"voxygen/i18n-helpers\",","     \"world\",","@@ -248,5 +249,3 @@ specs = { git = \"https://github.com/amethyst/specs.git\", rev = \"4e2da1df29ee840b"," # wgpu-core = { path = \"../wgpu/wgpu-core\" }"," # wgpu-types = { path = \"../wgpu/wgpu-types\" }"," # naga = { path = \"../wgpu/naga\" }","-","-"],"additions":1,"deletions":2,"truncated":false},{"path":"assets/voxygen/i18n/en/main.ftl","lines":["@@ -1,6 +1,7 @@"," main-username = Username"," main-server = Server"," main-password = Password","+main-remember-password = Remember password"," main-connecting = Connecting"," main-creating_world = Creating world"," main-tip = Tip:"],"additions":1,"deletions":0,"truncated":false},{"path":"voxygen/Cargo.toml","lines":["@@ -59,6 +59,7 @@ common-state = { package = \"veloren-common-state\", path = \"../common/state\" }"," common-systems = { package = \"veloren-common-systems\", path = \"../common/systems\" }"," "," anim = { package = \"veloren-voxygen-anim\", path = \"anim\" }","+credentialstore = { package = \"veloren-voxygen-credentialstore\", path = \"credentialstore\" }"," i18n = { package = \"veloren-client-i18n\", path = \"../client/i18n\" }"," i18n-helpers = { package = \"veloren-voxygen-i18n-helpers\", path = \"i18n-helpers\" }"," voxygen-egui = { package = \"veloren-voxygen-egui\", path = \"egui\", optional = true }"],"additions":1,"deletions":0,"truncated":false},{"path":"voxygen/credentialstore/Cargo.toml","lines":["@@ -0,0 +1,15 @@","+[package]","+name = \"veloren-voxygen-credentialstore\"","+version.workspace = true","+edition.workspace = true","+license.workspace = true","+","+[dependencies]","+tokio = { workspace = true }","+thiserror = { version = \"2.0\" }","+","+[target.'cfg(target_os = \"linux\")'.dependencies]","+secret-service = { version = \"5\", features = [\"rt-tokio\", \"crypto-rust\"] }","+","+[lints]","+workspace = true"],"additions":15,"deletions":0,"truncated":false},{"path":"voxygen/credentialstore/src/fake.rs","lines":["@@ -0,0 +1,23 @@","+use super::{CredentialError, CredentialStatus, CredentialStore, Credentials};","+","+#[allow(dead_code)]","+#[derive(Clone, Default)]","+pub struct SecretService;","+","+impl CredentialStore for SecretService {","+    fn is_supported(&self) -> bool { false }","+","+    async fn status(&self) -> CredentialStatus { CredentialStatus::Disabled }","+","+    async fn load(","+        &self,","+        _auth_server: String,","+        _username: String,","+    ) -> Result<String, CredentialError> {","+        Err(CredentialError::Connection)","+    }","+","+    async fn save(&self, _credentials: Credentials) -> Result<(), CredentialError> {","+        Err(CredentialError::Connection)","+    }","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"voxygen/credentialstore/src/lib.rs","lines":["@@ -0,0 +1,62 @@","+mod fake;","+#[cfg(target_os = \"linux\")] mod linux;","+","+use thiserror::Error;","+","+#[cfg(not(target_os = \"linux\"))]","+pub type SecureService = fake::SecretService;","+#[cfg(target_os = \"linux\")]","+pub type SecureService = linux::SecretService;","+","+pub struct Credentials {","+    pub auth_server: String,","+    pub username: String,","+    pub password: String,","+}","+","+#[derive(Debug, Error)]","+pub enum CredentialError {","+    #[error(\"Failed to connect to credential store\")]","+    Connection,","+    #[error(\"Failed to get credential store collection\")]","+    Collection,","+    #[error(\"Failed to determine credential store collection lock state\")]","+    State,","+    #[error(\"Failed to search credentials in credential store\")]","+    Search,","+    #[error(\"Failed to unlock stored credentials\")]","+    Unlock,","+    #[error(\"No stored credentials found in credential store\")]","+    Empty,","+    #[error(\"Failed to get stored credential secret\")]","+    Secret,","+    #[error(\"Stored credential secret is not valid UTF-8\")]","+    Utf8,","+    #[error(\"Failed to save credentials to credential store\")]","+    Save,","+}","+","+#[derive(Clone, Copy, PartialEq, PartialOrd)]","+pub enum CredentialStatus {","+    /// Password manager isn't running yet (user can launch it later).","+    Disabled,","+    /// Password manager is running but locked (user can unlock it).","+    Locked,","+    /// Password manager is active and ready to use.","+    Ready,","+}","+","+pub trait CredentialStore {","+    /// Check if the credential store service is supported on this system.","+    fn is_supported(&self) -> bool;","+    /// Get the current service status.","+    fn status(&self) -> impl Future<Output = CredentialStatus>;","+    /// Load password for the specific user.","+    fn load(","+        &self,","+        auth_server: String,","+        username: String,","+    ) -> impl Future<Output = Result<String, CredentialError>>;","+    /// Save credentials.","+    fn save(&self, credentials: Credentials) -> impl Future<Output = Result<(), CredentialError>>;","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"voxygen/credentialstore/src/linux.rs","lines":["@@ -0,0 +1,131 @@","+use super::{CredentialError, CredentialStatus, CredentialStore, Credentials};","+use secret_service::{EncryptionType, SecretService as Provider};","+use std::{collections::HashMap, sync::Arc};","+use tokio::sync::{Mutex, MutexGuard};","+","+const TITLE: &str = \"Veloren\";","+const APPLICATION: &str = \"application\";","+const AUTH_SERVER: &str = \"auth_server\";","+const USERNAME: &str = \"username\";","+const CONTENT_TYPE: &str = \"text/plain\";","+","+#[derive(Clone, Default)]","+pub struct SecretService {","+    provider: Arc<Mutex<Option<Provider<'static>>>>,","+}","+","+impl SecretService {","+    // Status, Load and Save are independent operations. Any of them can initiate a","+    // connection. It will be (re)created the next time this function is called. And","+    // any of them can drop it to prevent a potentially faulty connection.","+    async fn get_or_create_provider(&self) -> MutexGuard<'_, Option<Provider<'static>>> {","+        let mut provider = self.provider.lock().await;","+","+        if provider.is_none() {","+            // `None` is equivalent to `CredentialError::Connection`.","+            *provider = Provider::connect(EncryptionType::Dh).await.ok();","+        }","+","+        provider","+    }","+}","+","+impl CredentialStore for SecretService {","+    fn is_supported(&self) -> bool { true }","+","+    async fn status(&self) -> CredentialStatus {","+        let mut provider = self.get_or_create_provider().await;","+","+        if let Some(provider_ref) = provider.as_ref()","+            && let Ok(collection) = provider_ref.get_default_collection().await","+            && let Ok(locked) = collection.is_locked().await","+        {","+            if locked {","+                return CredentialStatus::Locked;","+            } else {","+                return CredentialStatus::Ready;","+            }","+        }","+","+        *provider = None;","+        CredentialStatus::Disabled","+    }","+","+    async fn load(&self, auth_server: String, username: String) -> Result<String, CredentialError> {","+        let mut provider = self.get_or_create_provider().await;","+        let mut error = CredentialError::Connection;","+        let attributes = HashMap::from([","+            (APPLICATION, TITLE),","+            (AUTH_SERVER, auth_server.as_str()),","+            (USERNAME, username.as_str()),","+        ]);","+","+        if let Some(provider_ref) = provider.as_ref()","+            && let Ok(search_items) = provider_ref","+                .search_items(attributes)","+                .await","+                .map_err(|_| error = CredentialError::Search)","+            && let Some(item) = match search_items.unlocked.first() {","+                Some(item) => Some(item),","+                None => match search_items.locked.first() {","+                    Some(item) => {","+                        if item.unlock().await.is_ok() {","+                            Some(item)","+                        } else {","+                            error = CredentialError::Unlock;","+                            None","+                        }","+                    },","+                    None => {","+                        // We don't need to drop provider here.","+                        return Err(CredentialError::Empty);","+                    },","+                },","+            }","+            && let Ok(secret) = item","+                .get_secret()","+                .await","+                .map_err(|_| error = CredentialError::Secret)","+            && let Ok(password) =","+                String::from_utf8(secret).map_err(|_| error = CredentialError::Utf8)","+        {","+            return Ok(password);","+        }","+","+        *provider = None;","+        Err(error)","+    }","+","+    async fn save(&self, credentials: Credentials) -> Result<(), CredentialError> {","+        let mut provider = self.get_or_create_provider().await;","+        let mut error = CredentialError::Connection;","+        let attributes = HashMap::from([","+            (APPLICATION, TITLE),","+            (AUTH_SERVER, credentials.auth_server.as_str()),","+            (USERNAME, credentials.username.as_str()),","+        ]);","+        let formatted_title = format!(\"{} ({})\", TITLE, credentials.username);","+","+        if let Some(provider_ref) = provider.as_ref()","+            && let Ok(collection) = provider_ref","+                .get_default_collection()","+                .await","+                .map_err(|_| error = CredentialError::Collection)","+            && let Ok(_) = collection","+                .create_item(","+                    &formatted_title,","+                    attributes,","+                    credentials.password.as_bytes(),","+                    true,","+                    CONTENT_TYPE,","+                )","+                .await","+                .map_err(|_| error = CredentialError::Save)","+        {","+            return Ok(());","+        }","+","+        *provider = None;","+        Err(error)","+    }","+}"],"additions":131,"deletions":0,"truncated":false},{"path":"voxygen/src/lib.rs","lines":["@@ -50,9 +50,7 @@ use crate::{"," use common::clock::Clock;"," use common_base::span;"," use i18n::LocalizationHandle;","-use std::path::PathBuf;","-","-use std::sync::Arc;","+use std::{path::PathBuf, sync::Arc};"," use tokio::runtime::Runtime;"," "," /// A type used to store state that is shared between all play states."],"additions":1,"deletions":3,"truncated":false},{"path":"voxygen/src/menu/main/mod.rs","lines":["@@ -23,18 +23,28 @@ use common_base::span;"," use common_net::msg::ClientType;"," #[cfg(feature = \"plugins\")]"," use common_state::plugin::PluginMgr;","+use credentialstore::*;"," use i18n::{LocalizationGuard, LocalizationHandle, fluent_args};"," #[cfg(feature = \"singleplayer\")]"," use server::ServerInitStage;"," #[cfg(any(feature = \"singleplayer\", feature = \"plugins\"))]"," use specs::WorldExt;"," use std::{cell::RefCell, path::Path, rc::Rc, sync::Arc};","-use tokio::runtime;","+use tokio::{","+    runtime,","+    sync::mpsc,","+    time::{Duration, interval},","+};"," use tracing::error;"," use ui::{Event as MainMenuEvent, MainMenuUi};"," "," pub use ui::rand_bg_image_spec;"," ","+pub enum CredentialResponse {","+    Status(CredentialStatus),","+    Password(Result<String, CredentialError>),","+}","+"," #[derive(Debug)]"," pub enum DetailedInitializationStage {","     #[cfg(feature = \"singleplayer\")]","@@ -68,6 +78,10 @@ pub struct MainMenuState {","     main_menu_ui: MainMenuUi,","     init: InitState,","     scene: Scene,","+    secure_service: SecureService,","+    secure_service_rx: Option<mpsc::UnboundedReceiver<CredentialResponse>>,","+    secure_service_tx: Option<mpsc::Sender<String>>,","+    pending_credentials: Option<Credentials>,"," }"," "," impl MainMenuState {","@@ -77,6 +91,10 @@ impl MainMenuState {","             main_menu_ui: MainMenuUi::new(global_state),","             init: InitState::None,","             scene: Scene::new(global_state.window.renderer_mut()),","+            secure_service: SecureService::default(),","+            secure_service_rx: None,","+            secure_service_tx: None,","+            pending_credentials: None,","         }","     }"," }","@@ -108,6 +126,31 @@ impl PlayState for MainMenuState {","     fn tick(&mut self, global_state: &mut GlobalState, events: Vec<Event>) -> PlayStateResult {","         span!(_guard, \"tick\", \"<MainMenuState as PlayState>::tick\");"," ","+        // Poll the credential store status to auto-fill password on unlock.","+        // Update UI on status changes.","+        if let Some(receiver) = &mut self.secure_service_rx","+            && let Some(transmitter) = &mut self.secure_service_tx","+        {","+            while let Ok(response) = receiver.try_recv() {","+                match response {","+                    CredentialResponse::Status(status) => {","+                        self.main_menu_ui.update_secure_service_status(status);"],"additions":28,"deletions":1,"truncated":false}],"additions":1691,"deletions":1213,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-10-15T13:23:20.761694+00:00"}