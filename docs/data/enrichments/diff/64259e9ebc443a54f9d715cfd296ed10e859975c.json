"+","+test('renderPeerIssues() names the root project when other projects are listed', () => {","+  const rendered = stripAnsi(renderPeerIssues({","+    '.': missingReactIssues(),","+    'apps/web': { ...missingReactIssues(), intersections: {} },","+  }))","+  expect(rendered).toMatch(/^\\.\\n {2}✕ missing peer react\\n/)","+  expect(rendered).not.toContain('apps/web')","+})","+","+test('renderPeerIssues() strips control characters from the project heading', () => {","+  const rendered = renderPeerIssues({","+    'apps/\\u001b[2J\\n-web\\u202e': missingReactIssues(),","+  })","+  expect(rendered).not.toContain('\\u001b[2J')","+  expect(rendered).not.toContain('\\u202e')","+  expect(stripAnsi(rendered)).toMatch(/^apps\\/\\[2J-web\\n/)","+})"],"additions":67,"deletions":0,"truncated":false},{"path":"pnpm11/deps/inspection/peers-issues-renderer/tsconfig.json","lines":["@@ -11,6 +11,9 @@","   \"references\": [","     {","       \"path\": \"../../../core/types\"","+    },","+    {","+      \"path\": \"../../../text/sanitize\"","     }","   ]"," }",""],"additions":3,"deletions":0,"truncated":false}],"additions":307,"deletions":24,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-09-24T13:03:56.361001+00:00"}