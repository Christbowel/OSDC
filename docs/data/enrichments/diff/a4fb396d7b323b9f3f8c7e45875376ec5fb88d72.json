{"id":"a4fb396d7b323b9f3f8c7e45875376ec5fb88d72","axis":"silent","repo":"langchain-ai/langchainjs","sha":"a4fb396d7b323b9f3f8c7e45875376ec5fb88d72","parsed":{"files":[{"path":".changeset/refusal-content-block.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@langchain/core\": patch","+---","+","+feat(core): add a standard `refusal` content block and `ModelRefusalError`","+","+Model refusals from OpenAI, Anthropic, and Gemini now appear as a `refusal` content block in `message.contentBlocks`. JSON, tool-call, and structured output parsers throw `ModelRefusalError` (from `@langchain/core/errors`) when the model refuses, instead of a generic parsing error."],"additions":7,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/errors/index.ts","lines":["@@ -1,6 +1,8 @@"," /* oxlint-disable @typescript-eslint/no-explicit-any */"," "," import type { AIMessageChunk } from \"../messages/ai.js\";","+import type { BaseMessage } from \"../messages/base.js\";","+import type { ContentBlock } from \"../messages/content/index.js\";"," import { ns as baseNs } from \"../utils/namespace.js\";"," "," export type { BrandedClass } from \"../utils/namespace.js\";","@@ -230,3 +232,72 @@ export class ContextOverflowError extends ns.brand(","     return error;","   }"," }","+","+const DEFAULT_REFUSAL_MESSAGE = \"Model refused to produce the requested output\";","+","+/**","+ * Error class representing a model refusal.","+ *","+ * Providers report a refusal, such as a safety-policy refusal, as a successful","+ * response rather than an error. LangChain raises this error where a refusal","+ * cannot be treated as an answer, for example when structured output has","+ * nothing to parse, or when an agent uses refusal middleware.","+ *","+ * The {@link ModelRefusalError} extends the {@link LangChainError} base class with","+ * the marker `\"model-refusal\"`. Retrying the same request is unlikely to succeed,","+ * so the error is marked as not retryable.","+ *","+ * @example","+ * ```typescript","+ * try {","+ *   await model.withStructuredOutput(schema).invoke(input);","+ * } catch (err) {","+ *   if (ModelRefusalError.isInstance(err)) {","+ *     console.warn(\"Model refused:\", err.message, err.rawMessage);","+ *   } else {","+ *     throw err;","+ *   }","+ * }","+ * ```","+ */","+export class ModelRefusalError extends ns.brand(","+  LangChainError,","+  \"model-refusal\"","+) {","+  readonly name = \"ModelRefusalError\";","+","+  /**","+   * The refused model response, if available.","+   */","+  rawMessage?: BaseMessage;","+","+  constructor(message?: string, fields?: { rawMessage?: BaseMessage }) {","+    super(message ?? DEFAULT_REFUSAL_MESSAGE);","+    this.rawMessage = fields?.rawMessage;","+    stampRetryable(this, false);","+  }","+","+  /**","+   * Creates a {@link ModelRefusalError} from a refusal content block.","+   *","+   * The message includes the provider's refusal `category`, when present, and","+   * the refusal text.","+   *","+   * @param refusal - The refusal content block from the model response.","+   * @param rawMessage - The refused model response.","+   */","+  static fromRefusal(","+    refusal: ContentBlock.Refusal,","+    rawMessage?: BaseMessage","+  ): ModelRefusalError {","+    let message = DEFAULT_REFUSAL_MESSAGE;","+    const category = refusal.extras?.category;","+    if (category) {","+      message += ` (category='${String(category)}')`;","+    }","+    if (refusal.refusal) {","+      message += `: ${refusal.refusal}`;","+    }","+    return new ModelRefusalError(message, { rawMessage });","+  }","+}"],"additions":71,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/errors/tests/refusal.test.ts","lines":["@@ -0,0 +1,39 @@","+import { describe, expect, it } from \"vitest\";","+import { AIMessage } from \"../../messages/ai.js\";","+import {","+  ContextOverflowError,","+  getRetryable,","+  LangChainError,","+  ModelRefusalError,","+} from \"../index.js\";","+","+describe(\"ModelRefusalError\", () => {","+  it(\"is a non-retryable LangChainError with a default message\", () => {","+    const error = new ModelRefusalError();","+    expect(error.message).toBe(\"Model refused to produce the requested output\");","+    expect(error.name).toBe(\"ModelRefusalError\");","+    expect(LangChainError.isInstance(error)).toBe(true);","+    expect(ContextOverflowError.isInstance(error)).toBe(false);","+    expect(getRetryable(error)).toBe(false);","+  });","+","+  it(\"builds its message from a refusal block\", () => {","+    const rawMessage = new AIMessage(\"\");","+    const error = ModelRefusalError.fromRefusal(","+      { type: \"refusal\", refusal: \"Blocked.\", extras: { category: \"cyber\" } },","+      rawMessage","+    );","+    expect(error.message).toBe(","+      \"Model refused to produce the requested output (category='cyber'): Blocked.\"","+    );","+    expect(error.rawMessage).toBe(rawMessage);","+  });","+","+  it(\"omits an empty refusal text\", () => {","+    const error = ModelRefusalError.fromRefusal({","+      type: \"refusal\",","+      refusal: \"\",","+    });","+    expect(error.message).toBe(\"Model refused to produce the requested output\");","+  });","+});"],"additions":39,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/messages/block_translators/anthropic.ts","lines":["@@ -288,6 +288,7 @@ export function convertToV1FromAnthropicInput("," export function convertToV1FromAnthropicMessage(","   message: AIMessage"," ): Array<ContentBlock.Standard> {","+  let hasRefusal = false;","   function* iterateContent(): Iterable<ContentBlock.Standard> {","     const content =","       typeof message.content === \"string\"","@@ -507,6 +508,12 @@ export function convertToV1FromAnthropicMessage(","         yield { id: block.id, type: \"non_standard\", value: block };","         continue;","       } else {","+        // Anthropic has no refusal part; this is a stored standard block.","+        if (_isContentBlock(block, \"refusal\") && _isString(block.refusal)) {","+          hasRefusal = true;","+          yield block as ContentBlock.Refusal;","+          continue;","+        }","         // For all other blocks, we try to convert them to a standard block","         const stdBlock = convertToV1FromAnthropicContentBlock(block);","         if (stdBlock) {","@@ -516,10 +523,29 @@ export function convertToV1FromAnthropicMessage(","       }","       yield { type: \"non_standard\", value: block };","     }","+    // Streamed chunks carry `message_delta` fields in `additional_kwargs`.","+    const stopFields =","+      message.response_metadata.stop_reason !== undefined","+        ? message.response_metadata","+        : message.additional_kwargs;","+    if (!hasRefusal && stopFields.stop_reason === \"refusal\") {","+      yield refusalFromStopDetails(stopFields.stop_details);","+    }","   }","   return Array.from(iterateContent());"," }"," ","+function refusalFromStopDetails(details: unknown): ContentBlock.Refusal {","+  const stopDetails = _isObject(details) ? details : {};","+  const explanation = stopDetails.explanation;","+  const category = stopDetails.category;","+  return {","+    type: \"refusal\",","+    refusal: _isString(explanation) ? explanation : \"\",","+    ...(_isString(category) ? { extras: { category } } : {}),","+  };","+}","+"," export const ChatAnthropicTranslator: StandardContentBlockTranslator = {","   translateContent: convertToV1FromAnthropicMessage,","   translateContentChunk: convertToV1FromAnthropicMessage,"],"additions":26,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/messages/block_translators/google.ts","lines":["@@ -3,6 +3,41 @@ import { ContentBlock } from \"../content/index.js\";"," import type { StandardContentBlockTranslator } from \"./index.js\";"," import { iife, _isContentBlock, _isObject, _isString } from \"./utils.js\";"," ","+const GEMINI_REFUSAL_FINISH_REASONS = new Set([","+  \"SAFETY\",","+  \"PROHIBITED_CONTENT\",","+  \"BLOCKLIST\",","+]);","+","+/**","+ * Builds a refusal block from a Gemini finish reason.","+ *","+ * A blocked prompt has no message: `@langchain/google` throws","+ * `PromptBlockedError` for it instead.","+ */","+function refusalFromMetadata(","+  message: AIMessage","+): ContentBlock.Refusal | undefined {","+  const metadata = message.response_metadata;","+  const kwargs = message.additional_kwargs;","+  // `invoke` sets `finish_reason`, stream events set `finishReason`, and","+  // streamed chunks keep both fields only in `additional_kwargs`.","+  const finishReason =","+    metadata.finishReason ?? metadata.finish_reason ?? kwargs.finishReason;","+  if (","+    !_isString(finishReason) ||","+    !GEMINI_REFUSAL_FINISH_REASONS.has(finishReason)","+  ) {","+    return undefined;","+  }","+  const finishMessage = metadata.finishMessage ?? kwargs.finishMessage;","+  return {","+    type: \"refusal\",","+    refusal: _isString(finishMessage) ? finishMessage : \"\",","+    extras: { finishReason },","+  };","+}","+"," function convertToV1FromChatGoogleMessage(","   message: AIMessage"," ): Array<ContentBlock.Standard> {","@@ -125,7 +160,10 @@ function convertToV1FromChatGoogleMessage(","       continue;","     }","   }","-  return Array.from(iterateContent());","+  const blocks = Array.from(iterateContent());","+  const refusal = refusalFromMetadata(message);","+  if (refusal) blocks.push(refusal);","+  return blocks;"," }"," "," export const ChatGoogleTranslator: StandardContentBlockTranslator = {"],"additions":39,"deletions":1,"truncated":false},{"path":"libs/langchain-core/src/messages/block_translators/openai.ts","lines":["@@ -10,6 +10,16 @@ import {","   iife,"," } from \"./utils.js\";"," ","+/** The refusal Chat Completions and Responses keep in `additional_kwargs`. */","+function refusalFromAdditionalKwargs(","+  message: AIMessage","+): ContentBlock.Refusal | undefined {","+  const refusal = message.additional_kwargs.refusal;","+  return _isString(refusal) && refusal.length > 0","+    ? { type: \"refusal\", refusal }","+    : undefined;","+}","+"," /**","  * Converts a ChatOpenAICompletions message to an array of v1 standard content blocks.","  *","@@ -69,6 +79,8 @@ export function convertToV1FromChatCompletions(","       args: toolCall.args,","     });","   }","+  const refusal = refusalFromAdditionalKwargs(message);","+  if (refusal) blocks.push(refusal);","   return blocks;"," }"," ","@@ -131,6 +143,8 @@ export function convertToV1FromChatCompletionsChunk(","       args: toolCall.args,","     });","   }","+  const refusal = refusalFromAdditionalKwargs(message);","+  if (refusal) blocks.push(refusal);","   return blocks;"," }"," ","@@ -554,6 +568,24 @@ export function convertToV1FromResponses(","         ];","       }","     }","+    let hasRefusalPart = false;","+    for (const block of content) {","+      if (_isContentBlock(block, \"refusal\") && _isString(block.refusal)) {","+        hasRefusalPart = true;","+        yield [","+          {","+            type: \"refusal\",","+            refusal: block.refusal,","+            ...(_isString(block.id) ? { id: block.id } : {}),","+          },","+          textBlockKey,","+        ];","+      }","+    }","+    if (!hasRefusalPart) {","+      const refusal = refusalFromAdditionalKwargs(message);","+      if (refusal) yield [refusal, textBlockKey];","+    }","     for (const toolCall of message.tool_calls ?? []) {","       yield [","         {"],"additions":32,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/messages/block_translators/tests/refusal.test.ts","lines":["@@ -0,0 +1,242 @@","+import { describe, expect, it } from \"vitest\";","+import { AIMessage, AIMessageChunk } from \"../../ai.js\";","+","+const refusals = (message: AIMessage) =>","+  message.contentBlocks.filter((block) => block.type === \"refusal\");","+","+describe(\"OpenAI refusals\", () => {","+  it(\"reads a Chat Completions refusal from additional_kwargs\", () => {","+    const message = new AIMessage({","+      content: \"\",","+      additional_kwargs: { refusal: \"I can't help with that.\" },","+      response_metadata: { model_provider: \"openai\" },","+    });","+    expect(refusals(message)).toEqual([","+      { type: \"refusal\", refusal: \"I can't help with that.\" },","+    ]);","+  });","+","+  it(\"reads a streamed Chat Completions refusal\", () => {","+    const chunk = new AIMessageChunk({","+      content: \"\",","+      additional_kwargs: { refusal: \"No.\" },","+      response_metadata: { model_provider: \"openai\" },","+    });","+    expect(refusals(chunk)).toEqual([{ type: \"refusal\", refusal: \"No.\" }]);","+  });","+","+  it(\"reads a Responses refusal content part once\", () => {","+    const message = new AIMessage({","+      content: [{ type: \"refusal\", refusal: \"No.\", id: \"msg_1\" }],","+      additional_kwargs: { refusal: \"No.\" },","+      response_metadata: { model_provider: \"openai\" },","+    });","+    expect(refusals(message)).toEqual([","+      { type: \"refusal\", refusal: \"No.\", id: \"msg_1\" },","+    ]);","+  });","+","+  it(\"reads a Responses refusal stored in additional_kwargs\", () => {","+    const message = new AIMessage({","+      content: [{ type: \"text\", text: \"Here is\" }],","+      additional_kwargs: { refusal: \"No.\" },","+      response_metadata: { model_provider: \"openai\" },","+    });","+    expect(message.contentBlocks).toEqual([","+      { type: \"text\", text: \"Here is\" },","+      { type: \"refusal\", refusal: \"No.\" },","+    ]);","+  });","+","+  it(\"keeps a Responses refusal next to its message item\", () => {","+    const message = new AIMessage({","+      content: [{ type: \"refusal\", refusal: \"No.\", id: \"msg_1\" }],","+      tool_calls: [{ id: \"call_1\", name: \"search\", args: {} }],","+      response_metadata: {","+        model_provider: \"openai\",","+        output: [","+          { type: \"message\", id: \"msg_1\" },","+          { type: \"function_call\", call_id: \"call_1\" },","+        ],","+      },","+    });","+    expect(message.contentBlocks.map((block) => block.type)).toEqual([","+      \"refusal\",","+      \"tool_call\",","+    ]);","+  });","+","+  it(\"ignores an empty refusal\", () => {","+    const message = new AIMessage({","+      content: \"Hello\",","+      additional_kwargs: { refusal: \"\" },","+      response_metadata: { model_provider: \"openai\" },","+    });","+    expect(refusals(message)).toEqual([]);","+  });","+});","+","+describe(\"Anthropic refusals\", () => {","+  it(\"builds a refusal from stop_reason and stop_details\", () => {","+    const message = new AIMessage({","+      content: [],","+      response_metadata: {","+        model_provider: \"anthropic\",","+        stop_reason: \"refusal\",","+        stop_details: {","+          type: \"refusal\",","+          category: \"cyber\",","+          explanation: \"Blocked under the usage policy.\",","+        },","+      },","+    });","+    expect(refusals(message)).toEqual([","+      {","+        type: \"refusal\",","+        refusal: \"Blocked under the usage policy.\",","+        extras: { category: \"cyber\" },","+      },","+    ]);","+  });","+","+  it(\"reads streamed stop fields from additional_kwargs\", () => {","+    const chunk = new AIMessageChunk({","+      content: [],","+      additional_kwargs: {","+        stop_reason: \"refusal\",","+        stop_details: { category: \"cyber\", explanation: \"Blocked.\" },","+      },","+      response_metadata: { model_provider: \"anthropic\" },","+    });","+    expect(refusals(chunk)).toEqual([","+      { type: \"refusal\", refusal: \"Blocked.\", extras: { category: \"cyber\" } },","+    ]);","+  });","+","+  it(\"keeps partial text before the refusal\", () => {","+    const message = new AIMessage({","+      content: \"Here is\",","+      response_metadata: {","+        model_provider: \"anthropic\",","+        stop_reason: \"refusal\",","+      },","+    });","+    expect(message.contentBlocks).toEqual([","+      { type: \"text\", text: \"Here is\" },","+      { type: \"refusal\", refusal: \"\" },","+    ]);","+  });","+","+  it(\"does not duplicate a stored refusal block\", () => {","+    const message = new AIMessage({","+      content: [{ type: \"refusal\", refusal: \"No.\" }],","+      response_metadata: {","+        model_provider: \"anthropic\",","+        stop_reason: \"refusal\",","+      },","+    });","+    expect(refusals(message)).toEqual([{ type: \"refusal\", refusal: \"No.\" }]);","+  });","+","+  it(\"tolerates malformed stop_details\", () => {","+    const message = new AIMessage({","+      content: [],","+      response_metadata: {","+        model_provider: \"anthropic\",","+        stop_reason: \"refusal\",","+        stop_details: \"unexpected\",","+      },","+    });","+    expect(refusals(message)).toEqual([{ type: \"refusal\", refusal: \"\" }]);","+  });","+","+  it(\"is not a refusal on a normal stop\", () => {","+    const message = new AIMessage({","+      content: \"Hi.\",","+      response_metadata: {","+        model_provider: \"anthropic\",","+        stop_reason: \"end_turn\",","+      },","+    });","+    expect(refusals(message)).toEqual([]);","+  });","+});","+","+describe(\"Gemini refusals\", () => {","+  const provider = \"google\";","+  it.each([\"SAFETY\", \"PROHIBITED_CONTENT\", \"BLOCKLIST\"])(","+    \"treats finishReason %s as a refusal\",","+    (finishReason) => {","+      const message = new AIMessage({","+        content: \"\",","+        response_metadata: {","+          model_provider: provider,","+          finishReason,","+          finishMessage: \"Blocked.\",","+        },","+      });","+      expect(refusals(message)).toEqual([","+        { type: \"refusal\", refusal: \"Blocked.\", extras: { finishReason } },","+      ]);","+    }","+  );","+","+  it(\"reads a refusal from a chunk\", () => {","+    const chunk = new AIMessageChunk({","+      content: \"\",","+      response_metadata: { model_provider: provider, finishReason: \"SAFETY\" },","+    });","+    expect(refusals(chunk)).toEqual([","+      { type: \"refusal\", refusal: \"\", extras: { finishReason: \"SAFETY\" } },","+    ]);","+  });","+","+  it(\"reads the snake_case finish_reason that invoke sets\", () => {","+    const message = new AIMessage({","+      content: \"\",","+      response_metadata: { model_provider: provider, finish_reason: \"SAFETY\" },","+    });","+    expect(refusals(message)).toEqual([","+      { type: \"refusal\", refusal: \"\", extras: { finishReason: \"SAFETY\" } },","+    ]);","+  });","+","+  it(\"reads a streamed chunk's finish reason from additional_kwargs\", () => {","+    const chunk = new AIMessageChunk({","+      content: \"Partial\",","+      response_metadata: { model_provider: provider },","+      additional_kwargs: { finishReason: \"SAFETY\", finishMessage: \"Blocked.\" },","+    });","+    expect(refusals(chunk)).toEqual([","+      {","+        type: \"refusal\",","+        refusal: \"Blocked.\",","+        extras: { finishReason: \"SAFETY\" },","+      },","+    ]);","+  });","+","+  it.each([\"STOP\", \"MAX_TOKENS\", \"RECITATION\"])(","+    \"does not treat finishReason %s as a refusal\",","+    (finishReason) => {","+      const message = new AIMessage({","+        content: \"Hi.\",","+        response_metadata: { model_provider: provider, finishReason },","+      });","+      expect(refusals(message)).toEqual([]);","+    }","+  );","+});","+","+describe(\"v1 messages\", () => {","+  it(\"returns a stored refusal block as is\", () => {","+    const message = new AIMessage({","+      content: [","+        { type: \"text\", text: \"Here is\" },","+        { type: \"refusal\", refusal: \"No.\" },","+      ],","+      response_metadata: { model_provider: \"openai\", output_version: \"v1\" },","+    });","+    expect(refusals(message)).toEqual([{ type: \"refusal\", refusal: \"No.\" }]);","+  });","+});"],"additions":242,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/messages/content/index.ts","lines":["@@ -19,6 +19,7 @@ export type PartialContentBlock<T extends ContentBlock = ContentBlock> = {"," export const KNOWN_BLOCK_TYPES = [","   \"text\",","   \"reasoning\",","+  \"refusal\",","   ...KNOWN_TOOL_BLOCK_TYPES,","   ...KNOWN_MULTIMODAL_BLOCK_TYPES,"," ];","@@ -111,6 +112,29 @@ export declare namespace ContentBlock {","     index?: string | number;","   }"," ","+  /**","+   * An explicit refusal reported by the model provider.","+   *","+   * Providers report refusals, such as safety-policy refusals, as successful","+   * responses. This block marks them so callers can tell a refusal apart from","+   * an empty or unparsable answer. Refusals the model writes as ordinary text","+   * are not detected.","+   */","+  export interface Refusal extends ContentBlock {","+    /**","+     * Type of the content block","+     */","+    readonly type: \"refusal\";","+    /**","+     * The refusal message, or an empty string if the provider sent none.","+     */","+    refusal: string;","+    /**","+     * Additional provider-specific data, such as Anthropic's refusal `category`.","+     */","+    extras?: Record<string, unknown>;","+  }","+","   /**","    * Provider-specific content block.","    *","@@ -139,6 +163,7 @@ export declare namespace ContentBlock {","   export type Standard =","     | Text","     | Reasoning","+    | Refusal","     | NonStandard","     | Tools.Standard","     | Multimodal.Standard;"],"additions":25,"deletions":0,"truncated":false},{"path":"libs/langchain-core/src/output_parsers/json.ts","lines":["@@ -3,6 +3,8 @@ import { Operation, compare } from \"../utils/json_patch.js\";"," import { ChatGeneration, Generation } from \"../outputs.js\";"," import { parseJsonMarkdown, parsePartialJson } from \"../utils/json.js\";"," import type { BaseMessage } from \"../messages/index.js\";","+import type { Callbacks } from \"../callbacks/manager.js\";","+import { throwIfRefused } from \"./refusal.js\";","