lines":["@@ -618,15 +618,29 @@ func (c *Controller) List(typ config.GroupVersionKind, namespace string) []confi"," "," func (c *Controller) SetStatusWrite(enabled bool, statusManager *status.Manager) {"," \tif enabled && features.EnableGatewayAPIStatus && statusManager != nil {","-\t\tvar q status.Queue = statusManager.CreateGenericController(func(status status.Manipulator, context any) {","-\t\t\tstatus.SetInner(context)","-\t\t})","+\t\tvar q status.Queue = statusManager.CreateGenericController(updateStatus)"," \t\tc.status.SetQueue(q)"," \t} else {"," \t\tc.status.UnsetQueue()"," \t}"," }"," ","+func updateStatus(s status.Manipulator, desired any) {","+\tlive, liveOK := s.Unwrap().(*gatewayv1.PolicyStatus)","+\twanted, desiredOK := desired.(*gatewayv1.PolicyStatus)","+\tif liveOK && desiredOK && live != nil && wanted != nil {","+\t\t// The desired status can contain stale entries from other controllers. Merge","+\t\t// only our entries onto the current status at write time.","+\t\tmerged := wanted.DeepCopy()","+\t\tours := slices.Filter(merged.Ancestors, func(a gatewayv1.PolicyAncestorStatus) bool {","+\t\t\treturn a.ControllerName == constants.ManagedAgentgatewayController","+\t\t})","+\t\tmerged.Ancestors = btlsMergeAncestors(constants.ManagedAgentgatewayController, live.Ancestors, ours)","+\t\tdesired = merged","+\t}","+\ts.SetInner(desired)","+}","+"," // Reconcile is called each time the `gatewayContext` may change. We use this to mark it as updated."," func (c *Controller) Reconcile(ps *model.PushContext) {"," \tctx := gatewaycommon.NewGatewayContext(ps, c.cluster)"],"additions":17,"deletions":3,"truncated":false},{"path":"pilot/pkg/config/kube/agentgateway/agentgateway_controller_test.go","lines":["@@ -20,10 +20,13 @@ import ("," "," \t\"github.com/agentgateway/agentgateway/api\""," \t\"github.com/google/go-cmp/cmp\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," \t\"k8s.io/apimachinery/pkg/types\""," \tgatewayv1 \"sigs.k8s.io/gateway-api/apis/v1\""," ","+\t\"istio.io/istio/pilot/pkg/status\""," \t\"istio.io/istio/pkg/config/constants\"","+\t\"istio.io/istio/pkg/test/util/assert\""," )"," "," // agwBindListener builds a minimal GatewayListener with only the fields","@@ -151,3 +154,32 @@ func TestBuildBindsFromGateway(t *testing.T) {"," \t\t})"," \t}"," }","+","+func TestUpdateStatusPreservesOtherControllers(t *testing.T) {","+\tancestor := func(name string, controller gatewayv1.GatewayController, gen int64) gatewayv1.PolicyAncestorStatus {","+\t\treturn gatewayv1.PolicyAncestorStatus{","+\t\t\tAncestorRef:    gatewayv1.ParentReference{Name: gatewayv1.ObjectName(name)},","+\t\t\tControllerName: controller,","+\t\t\tConditions:     []metav1.Condition{{Type: \"Accepted\", ObservedGeneration: gen}},","+\t\t}","+\t}","+\tmesh := gatewayv1.GatewayController(constants.ManagedGatewayMeshController)","+\tagw := gatewayv1.GatewayController(constants.ManagedAgentgatewayController)","+\tlive := &gatewayv1.PolicyStatus{Ancestors: []gatewayv1.PolicyAncestorStatus{","+\t\tancestor(\"svc\", mesh, 2), ancestor(\"gateway\", agw, 1),","+\t}}","+\tdesired := &gatewayv1.PolicyStatus{Ancestors: []gatewayv1.PolicyAncestorStatus{","+\t\tancestor(\"svc\", mesh, 1), ancestor(\"gateway\", agw, 2),","+\t}}","+\tbeforeLive, beforeDesired := live.DeepCopy(), desired.DeepCopy()","+\ts := status.GetStatusManipulator(live)","+\tupdateStatus(s, desired)","+\tassert.Equal(t, s.Unwrap(), any(&gatewayv1.PolicyStatus{Ancestors: []gatewayv1.PolicyAncestorStatus{","+\t\tancestor(\"svc\", mesh, 2), ancestor(\"gateway\", agw, 2),","+\t}}))","+\tassert.Equal(t, live, beforeLive)","+\tassert.Equal(t, desired, beforeDesired)","+\t// Removing our last ancestor must not remove the other controller's entry.","+\tupdateStatus(s, &gatewayv1.PolicyStatus{Ancestors: []gatewayv1.PolicyAncestorStatus{ancestor(\"svc\", mesh, 1)}})","+\tassert.Equal(t, s.Unwrap(), any(&gatewayv1.PolicyStatus{Ancestors: []gatewayv1.PolicyAncestorStatus{ancestor(\"svc\", mesh, 2)}}