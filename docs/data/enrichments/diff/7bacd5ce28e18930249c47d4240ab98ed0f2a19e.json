e length in the prefill model.","+            for (const auto& dim : dynamic_dims) {","+                OPENVINO_ASSERT(dim < static_shape.size(),","+                                \"Dimension index \" + std::to_string(dim) +","+                                    \" is out of range for the static shape of output port: \" + port.get_any_name());","+                if (static_shape[dim] == expected_seqdim_value) {","+                    matched_dyn_dim = dim;","+                    ++match_count;","+                }","+            }","+","+            if (match_count == 0) {","+                // NB: such an output is not accumulated across chunks, so in chunked prefill","+                //     it will only hold the value computed from the last processed chunk.","+                LOG_WARN(\"No dynamic dimension matched the max sequence length for output port: \"","+                         << port.get_any_name()","+                         << \", assuming that given output doesn't need accumulation. \"","+                            \"Its value will reflect only the last processed prefill chunk.\");","+                continue;","+            }","+","+            // Assert that only one match is found:","+            OPENVINO_ASSERT(match_count == 1,","+                            \"Only one dynamic dimension is expected to be reshaped to the max sequence length, but \"","+                            \"found \" +","+                                std::to_string(match_count) + \" matches for output port: \" + port.get_any_name());","+            other_outputs_with_seqdim.emplace(port, matched_dyn_dim);","+        } else {","+            LOG_WARN(\"Output port with name: \" << name","+                                               << \" was marked as dynamic additional output to the \\\"logits\\\",\"","+                                                  \"but it wasn't found in outputs of prefill model!\");","+        }","+    }","+    return other_outputs_with_seqdim;","+}","+"," }  // namespace"," "," // Apply DEVICE_ROUTED MoE transformations to models","@@ -882,6 +889,17 @@ ov::npuw::LLMCompiledModel::LLMCompiledModel(const std::shared_ptr<ov::Model>& m","     const uint32_t seq_len_dim = m_cfg.get<::intel_npu::NPUW_LLM_SEQ_LEN_DIM>();","     KVAxesPosition axes{batch_dim, seq_len_dim};"," ","+    std::map<std::string, std::vector<std::size_t>> other_dynamic_outputs;","+    if (m_use_chunk_prefill) {","+        LOG_VERB(\"Find all models outputs besides logits that also have dynamic shapes to handle in chunked prefill.\");","+        other_dynamic_outputs = find_other_dynamic_outputs(model);","+        // Chunk size 1 makes the batch and sequence axes indistinguishable (both are 1),","+        // which breaks sequence-axis detection for non-logits outputs below.","+        OPENVINO_ASSERT(m_prefill_chunk_size != 1 || other_dynamic_outputs.empty(),","+                        \"NPUW_LLM_PREFILL_CHUNK_SIZE=1 is not supported together with non-logits outputs. \"","+                        \"Please use a larger chunk size.\");","+    }","+","     LOG_DEBUG(\"Creating kvcache model as clone of passed one.\");","     auto kvcache_model = model->clone();"," ","@@ -1241,6 +1259,13 @@ ov::npuw::LLMCompiledModel::LLMCompiledModel(const std::shared_ptr<ov::Model>& m","     merge_config_with(prefill_config, other_props);","     merge_config_with(generate_config, other_props);","     merge_config_with(prefill_config, prefill_config_addition_value);","+    // If model has multiple outputs, only logits will be extracted to a separate model.","+    // Prefill will have all other outputs. It might be a wrong assumption that all of","+    // them need to be sliced for, for instance, 1 token.","+    if (lm_head_model) {","+        LOG_DEBUG(\"LM head model is present, erasing NPUW_SLICE_OUT from prefill config.\");","+        prefill_config.erase(\"NPUW_SLICE_OUT\");","+    }","     merge_config_with(generate_config, generate_config_addition_