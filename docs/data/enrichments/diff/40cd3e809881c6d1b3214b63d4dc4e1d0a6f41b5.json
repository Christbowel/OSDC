erWidth] = useState<null | number>(null)","   const [isAnimating, setIsAnimating] = useState(false)"," ","@@ -29,23 +29,29 @@ export function AnimatedTextWidth({children, text}: {children: ReactNode; text:","     <motion.div","       style={{","         display: 'inline-block',","+        // Top alignment, not the default baseline. An inline-block whose overflow is","+        // anything but `visible` reports its bottom edge as its baseline, and the","+        // button's line box grows by that shift for the whole animation.","+        verticalAlign: 'top',","         width: containerWidth === null ? 'auto' : containerWidth,","-        overflow: isAnimating ? 'hidden' : 'visible',","       }}","       animate={{width: containerWidth || 'auto'}}","       transition={{type: 'spring', bounce: 0, duration: 0.3}}","       onAnimationStart={onAnimationStart}","       onAnimationComplete={onAnimationComplete}","     >","-      <div","-        ref={textRef}","-        style={{","-          display: 'inline-block',","-          whiteSpace: 'nowrap',","-          verticalAlign: 'middle',","-        }}","-      >","-        {children}","+      {/* Clip on this block, not on the inline-block above, so the baseline stays put. */}","+      <div style={{overflow: isAnimating ? 'hidden' : 'visible'}}>","+        <span","+          ref={textRef}","+          style={{","+            display: 'inline-block',","+            whiteSpace: 'nowrap',","+            verticalAlign: 'top',","+          }}","+        >","+          {children}","+        </span>","       </div>","     </motion.div>","   )"],"additions":17,"deletions":11,"truncated":false},{"path":"packages/sanity/src/core/perspective/navbar/GlobalPerspectiveButton.css.ts","lines":["@@ -0,0 +1,71 @@","+import {css} from '#styled-system/css'","+","+/** `@sanity/ui` `radius=\"full\"`. Large enough that the 31px controls become a pill. */","+const pillRadius = '9999px'","+","+/**","+ * The height of the pill.","+ * This is hardcoded to match the rest of the items in the navbar in height. It has 31px which then makes it into a 33px tall component when the border is applied.","+ */","+const pillHeight = '31px'","+","+/**","+ * Centers the trigger and the clear control in the pill, and clips their","+ * hover fill to it. The clip also cuts off a square focus ring at the","+ * corners, so each control rounds the corners that meet the pill.","+ */","+export const perspectiveButtonCard = css({","+  'overflow': 'hidden',","+  // A block-level card stretches to its parent. The chip should stay as wide","+  // as the trigger, including when it is not a flex item.","+  'width': 'fit-content',","+  '&&': {","+    alignItems: 'center',","+  },","+})","+","+/** Hairline between the trigger and the clear control. */","+export const perspectiveButtonDivider = css({","+  width: '1px',","+  height: pillHeight,","+  alignSelf: 'stretch',","+  backgroundColor: 'var(--card-border-color)',","+})","+","+/**","+ * Clear control. The button root ships `padding: 0`, and the padding prop is","+ * applied to the inner span — `&&` wins on both, so this padding is the one","+ * that shows.","+ */","+export const perspectiveButtonClear = css({","+  '&&': {","+    height: pillHeight,","+    padding: '0 2px',","+    borderTopRightRadius: pillRadius,","+    borderBottomRightRadius: pillRadius,","+    borderTopLeftRadius: '0',","+    borderBottomLeftRadius: '0',","+  },","+  '& [data-sanity-icon]': {","+    transform: 'scale(0.65)',","+  },","+})","+","+/**","+ * Trigger. The button root ships `padding: 0` and `radius={0}`; `&&` wins","+ * over both. The left corners follow the pill. The right corners do too when","+ * this is the only control — a clear button beside it keeps that edge square.","+ */","+export const perspectiveButtonTrigger = css({","+  '&&': {","+    height: pillHeight,","+    paddingLeft: '6px',","+    paddingRight: '4px',","+    borderTopLeftRadius: pillRadius,","+    borderBottomLeftRadius: pillRadius,","+  },","+  '&:only-child': {","+    borderTopRightRadius: pillRadius,","+    borderBottomRightRadius: pillRadius,","+  },","+})"],"additions":71,"deletions":0,"truncated":false},{"path":"packages/sanity/src/core/perspective/navbar/GlobalPerspectiveButton.tsx","lines":["@@ -0,0 +1,91 @@","+import {ChevronDownIcon} from '@sanity/icons/ChevronDown'","+import {CloseIcon} from '@sanity/icons/Close'","+// oxlint-disable-next-line no-restricted-imports -- the label is an animated node; the studio Button types `text` as a string","+import {Button as UIButton, Card, type ButtonProps as UIButtonProps} from '@sanity/ui'","+import {type MouseEvent, useCallback} from 'react'","+","+import {Button} from '../../../ui-components/button/Button'","+import {useTranslation} from '../../i18n/hooks/useTranslation'","+import {AnimatedTextWidth} from './AnimatedTextWidth'","+import {","+  perspectiveButtonCard,","+  perspectiveButtonClear,","+  perspectiveButtonDivider,","+  perspectiveButtonTrigger,","+} from './GlobalPerspectiveButton.css'","+","+type GlobalPerspectiveButtonProps = {","+  /** Label shown in the chip. Its width animates when the label changes. */","+  text: string","+  /** Icon rendered before the label. */","+  icon: UIButtonProps['icon']","+  /**","+   * Clears a non-default perspective. When omitted, the chip is the default","+   * selection and the remove control stays hidden.","+   */","+  handleClearPerspective?: () => void","+} & Omit<UIButtonProps, 'children' | 'icon' | 'iconRight' | 'mode' | 'text'>","+","+/**","+ * Shared chip for the global perspective pickers (releases and variants).","+ * A pill trigger with a caret; a clear control sits beside it once a","+ * non-default perspective is selected.","+ *","+ * @internal","+ */","+export function GlobalPerspectiveButton(props: GlobalPerspectiveButtonProps) {","+  const {text, icon, handleClearPerspective, ref, ...buttonProps} = props","+  const {t} = useTranslation()","+  const clearLabel = t('perspective.action.