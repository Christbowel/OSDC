iants/VariantsStudioNavbar.tsx","lines":["@@ -0,0 +1,74 @@","+import {clsx} from 'clsx'","+import {useCallback} from 'react'","+","+import {RhombusIconLarge} from '../../../components/temporary-icons/Rhombus'","+import {useTranslation} from '../../../i18n/hooks/useTranslation'","+import {useVariantTypes} from '../../../variants/hooks/useVariantConditions'","+import {useAllVariants} from '../../../variants/store/useAllVariants'","+import {getVariantId, getVariantTitle} from '../../../variants/tool/util'","+import {type SystemVariant} from '../../../variants/types'","+import {type VariantSelection} from '../../../variants/util/variantSelection'","+import {DEFAULT_VARIANT_TYPE_KEY} from '../../../variants/util/variantType'","+import {useSetVariant} from '../../useSetVariant'","+import {GlobalPerspectiveButton} from '../GlobalPerspectiveButton'","+import {VariantsMenu} from './VariantsMenu'","+import {rhombusIconLarge, suggestIconColor} from './VariantsNav.css'","+","+function VariantTypeFilter(props: {","+  selectedId: string | undefined","+  typeKey: string","+  variants: SystemVariant[]","+}) {","+  const {selectedId, typeKey, variants} = props","+  const {t} = useTranslation()","+  const setVariant = useSetVariant()","+  const selectedVariant = selectedId","+    ? variants.find((variant) => getVariantId(variant._id) === selectedId)","+    : undefined","+  const variantLabel = selectedVariant","+    ? getVariantTitle(selectedVariant)","+    : t('navbar.variant.default')","+  const handleClear = useCallback(() => {","+    setVariant({type: typeKey, variantId: undefined})","+  }, [setVariant, typeKey])","+","+  return (","+    <VariantsMenu","+      typeKey={typeKey}","+      trigger={","+        <GlobalPerspectiveButton","+          data-testid={","+            typeKey === DEFAULT_VARIANT_TYPE_KEY","+              ? 'variants-nav-menu-button'","+              : `variants-nav-menu-button-${typeKey}`","+          }","+          handleClearPerspective={selectedId ? handl