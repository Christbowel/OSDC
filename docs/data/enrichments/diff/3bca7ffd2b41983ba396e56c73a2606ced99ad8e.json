{"id":"3bca7ffd2b41983ba396e56c73a2606ced99ad8e","axis":"silent","repo":"pnpm/pnpm","sha":"3bca7ffd2b41983ba396e56c73a2606ced99ad8e","parsed":{"files":[{"path":".changeset/token-last-used-off-request-path.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+Token-authenticated requests are now handled without waiting for the token's last-used time to be written to the auth database. Every such request waited for that write, a database round trip on a shared or replicated database. The server now records a token's last use in the background, at most once a minute per token [pnpm/tasks#194](https://github.com/pnpm/tasks/issues/194)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/last_used.rs","lines":["@@ -0,0 +1,128 @@","+use super::{TokenBackend, sha256_hex, unix_seconds};","+use std::{","+    collections::HashMap,","+    sync::{Arc, Mutex},","+};","+use tokio::sync::Semaphore;","+","+/// The interval that limits last-used writes, in seconds. A token in steady","+/// use costs one write per interval, not one per request.","+pub const LAST_USED_GRANULARITY_SECS: u64 = 60;","+","+/// How many writes may run at once. They share the token store's connection","+/// pool with the lookups that authenticate requests, so a burst of distinct","+/// tokens must not take the pool from those.","+const MAX_WRITES_IN_FLIGHT: usize = 4;","+","+/// The smallest claim count that triggers a prune. Below it the map is","+/// cheaper to keep than to scan.","+const MIN_CLAIMS_BEFORE_PRUNE: usize = 1024;","+","+/// Records when tokens are used. The write to the token store happens off","+/// the request path, at most once per [`LAST_USED_GRANULARITY_SECS`] per","+/// token. A request never waits for it or learns that it failed: a failed","+/// write keeps its claim, so the token's next write is due an interval","+/// later.","+pub struct LastUsedWriter {","+    tokens: Arc<dyn TokenBackend>,","+    claims: Mutex<Claims>,","+    writes_in_flight: Arc<Semaphore>,","+}","+","+/// The tokens whose write for the current interval is already claimed, by","+/// key, so concurrent requests from one token write once even before the","+/// first write lands or an embedded replica syncs it back. Entries older","+/// than an interval are dropped once the map outgrows `prune_at`, which","+/// doubles each time so pruning stays amortized.","+struct Claims {","+    written_at: HashMap<String, u64>,","+    prune_at: usize,","+}","+","+impl LastUsedWriter {","+    #[must_use]","+    pub fn new(tokens: Arc<dyn TokenBackend>) -> Self {","+        Self {","+            tokens,","+            claims: Mutex::new(Claims {","+                written_at: HashMap::new(),","+                prune_at: MIN_CLAIMS_BEFORE_PRUNE,","+            }),","+            writes_in_flight: Arc::new(Semaphore::new(MAX_WRITES_IN_FLIGHT)),","+        }","+    }","+","+    /// Record that the token with `key` was used now. `last_used_at` is the","+    /// time the store holds for it, which the lookup that authenticated the","+    /// request already read.","+    pub fn record(&self, key: &str, last_used_at: u64) {","+        self.record_with(last_used_at, || key.to_owned());","+    }","+","+    /// [`Self::record`] for a raw token. It is hashed to its key only once a","+    /// write is due.","+    pub fn record_raw(&self, raw: &str, last_used_at: u64) {","+        self.record_with(last_used_at, || sha256_hex(raw.as_bytes()));","+    }","+","+    /// Whether a write was started.","+    fn record_with(&self, last_used_at: u64, key: impl FnOnce() -> String) -> bool {","+        let now = unix_seconds();","+        if within_interval(last_used_at, now) {","+            return false;","+        }","+        let key = key();","+        if !self.claim(&key, now) {","+            return false;","+        }","+        let Ok(permit) = Arc::clone(&self.writes_in_flight).try_acquire_owned() else {","+            // The pool is busy with writes; the next request from this token","+            // gets to try again.","+            self.release(&key);","+            return false;","+        };","+        let tokens = Arc::clone(&self.tokens);","+        tokio::spawn(async move {","+            let _permit = permit;","+            if let Err(err) = tokens.touch_key(&key, now).await {","+                tracing::debug!(error = %err, \"could not record a token's last use\");","+            }","+        });","+        true","+    }","+","+    /// Whether the interval at `now` is free for `key`, claiming it when so.","+    fn claim(&self, key: &str, now: u64) -> bool {","+        let mut claims = self.claims.lock().expect(\"LastUsedWriter mutex poisoned\");","+        if claims.written_at.get(key).is_some_and(|&written_at| within_interval(written_at, now)) {","+            return false;","+        }","+        claims.insert(key, now);","+        true","+    }","+","+    fn release(&self, key: &str) {","+        self.claims","+            .lock()","+            .expect(\"LastUsedWriter mutex poisoned\")","+            .written_at","+            .remove(key);","+    }","+}","+","+impl Claims {","+    fn insert(&mut self, key: &str, now: u64) {","+        if self.written_at.len() >= self.prune_at {","+            self.written_at.retain(|_, &mut written_at| within_interval(written_at, now));","+            self.prune_at = (self.written_at.len() * 2).max(MIN_CLAIMS_BEFORE_PRUNE);","+        }","+        self.written_at.insert(key.to_owned(), now);","+    }","+}","+","+fn within_interval(written_at: u64, now: u64) -> bool {","+    now < written_at.saturating_add(LAST_USED_GRANULARITY_SECS)","+}","+","+#[cfg(test)]","+mod tests;"],"additions":128,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/last_used/tests.rs","lines":["@@ -0,0 +1,171 @@","+use super::{","+    LAST_USED_GRANULARITY_SECS, LastUsedWriter, MAX_WRITES_IN_FLIGHT, MIN_CLAIMS_BEFORE_PRUNE,","+};","+use crate::{NewToken, Result, TokenBackend, TokenRecord, sha256_hex, unix_seconds};","+use async_trait::async_trait;","+use pnpr_error::RegistryError;","+use std::{","+    sync::{Arc, Mutex},","+    time::Duration,","+};","+use tokio::sync::Semaphore;","+","+/// A token store that only remembers which keys were touched, and when. With","+/// `gate` set, a touch takes a permit from it before it is remembered; with","+/// `fail` set, every touch fails after that.","+#[derive(Default)]","+struct TouchLog {","+    touches: Mutex<Vec<(String, u64)>>,","+    gate: Option<Semaphore>,","+    fail: bool,","+}","+","+#[async_trait]","+impl TokenBackend for TouchLog {","+    async fn issue_token(","+        &self,","+        _username: &str,","+        _new_token: NewToken,","+    ) -> Result<(String, TokenRecord)> {","+        Err(RegistryError::Internal { reason: \"TouchLog cannot issue tokens\".to_string() })","+    }","+","+    async fn lookup(&self, _raw: &str) -> Result<Option<String>> {","+        Ok(None)","+    }","+","+    async fn touch_key(&self, key: &str, now: u64) -> Result<()> {","+        if let Some(gate) = &self.gate {","+            gate.acquire().await.unwrap().forget();","+        }","+        if self.fail {","+            return Err(RegistryError::Internal { reason: \"TouchLog is failing\".to_string() });","+        }","+        self.touches","+            .lock()","+            .unwrap()","+            .push((key.to_string(), now));","+        Ok(())","+    }","+","+    async fn find_by_key(&self, _key: &str) -> Result<Option<TokenRecord>> {","+        Ok(None)","+    }","+","+    async fn list_for_user(&self, _username: &str) -> Result<Vec<(String, TokenRecord)>> {","+        Ok(Vec::new())","+    }","+","+    async fn revoke_by_key(&self, _key: &str) -> Result<Option<TokenRecord>> {","+        Ok(None)","+    }","+}","+","+fn writer_over(log: TouchLog) -> (Arc<LastUsedWriter>, Arc<TouchLog>) {","+    let log = Arc::new(log);","+    let writer = LastUsedWriter::new(Arc::clone(&log) as Arc<dyn TokenBackend>);","+    (Arc::new(writer), log)","+}","+","+fn writer() -> (Arc<LastUsedWriter>, Arc<TouchLog>) {","+    writer_over(TouchLog::default())","+}","+","+async fn wait_until(condition: impl Fn() -> bool + Send + Sync) {","+    tokio::time::timeout(Duration::from_secs(5), async {","+        while !condition() {","+            tokio::task::yield_now().await;","+        }","+    })","+    .await","+    .expect(\"the spawned writes land\");","+}","+","+/// A stored time every test treats as due for a write.","+const STALE: u64 = 0;","+const NOW: u64 = 1_000;","+","+#[test]","+fn an_interval_is_claimed_once_per_token() {","+    let (writer, _) = writer();","+    assert!(writer.claim(\"k\", NOW));","+    assert!(!writer.claim(\"k\", NOW));","+    assert!(!writer.claim(\"k\", NOW + LAST_USED_GRANULARITY_SECS - 1));","+    assert!(writer.claim(\"other\", NOW));","+    assert!(writer.claim(\"k\", NOW + LAST_USED_GRANULARITY_SECS));","+}","+","+#[test]","+fn expired_claims_are_pruned() {","+    let (writer, _) = writer();","+    for index in 0..MIN_CLAIMS_BEFORE_PRUNE {","+        assert!(writer.claim(&format!(\"old-{index}\"), NOW));","+    }","+    assert!(writer.claim(\"new\", NOW + LAST_USED_GRANULARITY_SECS));","+    let claims = writer.claims.lock().unwrap();","+    assert_eq!(claims.written_at.len(), 1);","+    assert!(claims.written_at.contains_key(\"new\"));","+}","+","+#[tokio::test]","+async fn a_fresh_stored_time_needs_no_write_and_no_key() {","+    let (writer, log) = writer();","+    assert!(!writer.record_with(unix_seconds(), || panic!(\"a fresh time derives no key\")));","+    assert!(writer.record_with(STALE, || \"k\".to_string()));","+    wait_until(|| !log.touches.lock().unwrap().is_empty()).await;","+    let touches = log.touches.lock().unwrap();","+    assert_eq!(touches.len(), 1);","+    assert_eq!(touches[0].0, \"k\");","+    assert!(touches[0].1 > STALE, \"written with the current time, not the stored one\");","+}","+","+#[tokio::test]","+async fn a_raw_token_is_written_under_its_key() {","+    let (writer, log) = writer();","+    writer.record_raw(\"raw-token\", STALE);","+    wait_until(|| !log.touches.lock().unwrap().is_empty()).await;","+    assert_eq!(log.touches.lock().unwrap()[0].0, sha256_hex(b\"raw-token\"));","+}","+","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 4)]","+async fn concurrent_uses_of_one_token_write_once() {","+    let (writer, log) = writer();","+    let uses = (0..64).map(|_| {","+        let writer = Arc::clone(&writer);","+        tokio::spawn(async move { writer.record_with(STALE, || \"k\".to_string()) })","+    });","+    let mut started = 0;","+    for handle in uses {","+        if handle.await.unwrap() {","+            started += 1;","+        }","+    }","+    assert_eq!(started, 1);","+    wait_until(|| !log.touches.lock().unwrap().is_empty()).await;","+    assert_eq!(log.touches.lock().unwrap().len(), 1);","+}","+","+#[tokio::test]","+async fn writes_in_flight_are_bounded_and_a_refused_token_retries() {","+    let (writer, log) =","+        writer_over(TouchLog { gate: Some(Semaphore::new(0)), ..TouchLog::default() });","+    for index in 0..MAX_WRITES_IN_FLIGHT {","+        assert!(writer.record_with(STALE, || format!(\"in-flight-{index}\")));","+    }","+    assert!(!writer.record_with(STALE, || \"refused\".to_string()));","+","+    let gate = log.gate.as_ref().unwrap();","+    gate.add_permits(MAX_WRITES_IN_FLIGHT);","+    wait_until(|| log.touches.lock().unwrap().len() == MAX_WRITES_IN_FLIGHT).await;","+    assert!(writer.record_with(STALE, || \"refused\".to_string()));","+    gate.add_permits(1);","+    wait_until(|| log.touches.lock().unwrap().len() == MAX_WRITES_IN_FLIGHT + 1).await;","+}","+","+#[tokio::test]","+async fn a_failed_write_frees_its_slot_but_keeps_its_claim() {","+    let (writer, _) = writer_over(TouchLog { fail: true, ..TouchLog::default() });","+    assert!(writer.record_with(STALE, || \"k\".to_string()));","+    wait_until(|| writer.writes_in_flight.available_permits() == MAX_WRITES_IN_FLIGHT).await;","+    assert!(!writer.record_with(STALE, || \"k\".to_string()));","+}"],"additions":171,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/lib.rs","lines":["@@ -37,6 +37,7 @@ pub use htpasswd::{","     is_bcrypt_hash, is_sha_hash, parse_htpasswd, parse_htpasswd_line, verify_bcrypt, write_atomic,"," };"," pub use identify::identify;","+pub use last_used::{LAST_USED_GRANULARITY_SECS, LastUsedWriter};"," pub use owned_tokens::OwnedTokens;"," pub use schema::CURRENT_SCHEMA_VERSION;"," pub use token_store::{NewToken, TokenRecord, TokenStore};","@@ -50,6 +51,7 @@ mod token_store;"," use token_store::{fresh_secret, sha256_hex, unix_seconds};"," "," mod identify;","+mod last_used;"," mod owned_tokens;"," mod user_store;"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/libsql_backend/tokens.rs","lines":["@@ -52,9 +52,9 @@ impl TokenBackend for LibsqlAuth {"," ","     async fn touch_key(&self, key: &str, now: u64) -> Result<()> {","         let sql_now = token_timestamp_to_sql(now);","-        // Not synced back into a replica: this runs on authenticated","-        // requests, and the background sync carries the timestamp. It runs","-        // under the read deadline: losing a timestamp to it is harmless.","+        // Not synced back into a replica: the background sync carries the","+        // timestamp. It runs under the read deadline: losing a timestamp to","+        // it is harmless.","         self.pool.read(|conn| async move {","             conn.execute(","                 \"UPDATE tokens SET last_used_at = ?1 WHERE token_hash = ?2\","],"additions":3,"deletions":3,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/authentication.rs","lines":["@@ -204,11 +204,7 @@ async fn bearer_token_identity(","         Ok(Some(record)) => {","             check_token_restrictions(&record, method, path, client_ip)","                 .map_err(axum::response::IntoResponse::into_response)?;","-            let now = SystemTime::now()","-                .duration_since(UNIX_EPOCH)","-                .unwrap_or_default()","-                .as_secs();","-            let _ = state.inner.identity.auth.tokens.touch_key(parent, now).await;","+            state.inner.identity.last_used.record(parent, record.last_used_at);","             Ok(Some(Identity::user(record.username)))","         }","         Ok(None) => Err(super::oci::tokens::rejected(state, path, method)),","@@ -269,10 +265,7 @@ async fn resolve_caller(","         }","         if let Some(record) = state.inner.identity.auth.tokens.lookup_record(&raw_token).await? {","             check_token_restrictions(&record, method, path, client_ip)?;","-            let now = std::time::SystemTime::now()","-                .duration_since(std::time::UNIX_EPOCH)","-                .map_or(0, |d| d.as_secs());","-            let _ = state.inner.identity.auth.tokens.touch(&raw_token, now).await;","+            state.inner.identity.last_used.record_raw(&raw_token, record.last_used_at);","             return Ok(Identity::user(record.username));","         }","     }"],"additions":2,"deletions":9,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/state.rs","lines":["@@ -67,6 +67,7 @@ pub(super) struct MutationLocks {"," "," pub(super) struct IdentityServices {","     pub(super) auth: AuthState,","+    pub(super) last_used: pnpr_auth::LastUsedWriter,","     pub(super) oidc: pnpr_auth::oidc::OidcState,","     pub(super) managed: super::managed_state::ManagedState,","     pub(super) login_rate_limiter: LoginRateLimiter,","@@ -143,6 +144,7 @@ impl IdentityServices {","         let oidc =","             pnpr_auth::oidc::OidcState::new(&config.identity.auth.oidc, &config.http.public_url)?;","         Ok(Self {","+            last_used: pnpr_auth::LastUsedWriter::new(Arc::clone(&auth.tokens)),","             auth,","             oidc,","             managed: super::managed_state::ManagedState::new(config),"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/common/tokens.rs","lines":["@@ -1,6 +1,8 @@"," //! Tokens for tests that drive a router built on an in-memory `AuthState`."," ","-use pnpr::AuthState;","+use pnpr::{AuthState, TokenBackend};","+use pnpr_auth::LAST_USED_GRANULARITY_SECS;","+use std::{sync::Arc, time::Duration};"," "," /// A token for `username`, stored as an account first: pnpr honors only"," /// tokens whose owner is an account.","@@ -8,3 +10,39 @@ pub(crate) async fn issue_token(auth: &AuthState, username: &str) -> String {","     auth.users.create_user(username, \"password\").await.unwrap();","     auth.tokens.issue(username).await.unwrap()"," }","+","+/// Set the stored last-used time of `raw` back far enough that its next","+/// use is due for a write, and return that time.","+pub(crate) async fn age_last_use(tokens: &Arc<dyn TokenBackend>, raw: &str) -> u64 {","+    let record = tokens","+        .lookup_record(raw)","+        .await","+        .unwrap()","+        .unwrap();","+    let aged = record.last_used_at - 2 * LAST_USED_GRANULARITY_SECS;","+    tokens.touch(raw, aged).await.unwrap();","+    aged","+}","+","+/// Wait until a use recorded off the request path has advanced the stored","+/// last-used time of `raw` past `previous`.","+pub(crate) async fn wait_for_last_use_after(","+    tokens: &Arc<dyn TokenBackend>,","+    raw: &str,","+    previous: u64,","+) {","+    tokio::time::timeout(Duration::from_secs(10), async {","+        while tokens","+            .lookup_record(raw)","+            .await","+            .unwrap()","+            .unwrap()","+            .last_used_at","+            <= previous","+        {","+            tokio::time::sleep(Duration::from_millis(10)).await;","+        }","+    })","+    .await","+    .expect(\"the last-used write lands\");","+}"],"additions":39,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/tests/oci_registry/authorization.rs","lines":["@@ -148,17 +148,9 @@ async fn oci_bearer_updates_parent_token_last_used_at() {","     let oci_res: Value = serde_json::from_slice(&body_bytes(res.into_body()).await).unwrap();","     let oci_token = oci_res[\"token\"].as_str().unwrap();"," ","-    let parent_minted = tokens","-        .lookup_record(&raw_parent)","-        .await","-        .unwrap()","-        .unwrap();","-    assert!(parent_minted.last_used_at > 0);","-","-    // Sleep past the second boundary so any subsequent update will advance last_used_at.","-    tokio::time::sleep(std::time::Duration::from_millis(1100)).await;","+    let aged = crate::tokens::age_last_use(&tokens, &raw_parent).await;"," ","-    // An unauthorized request (not permitted by scope) is rejected and does not update last_used_at.","+    // A request the scope does not permit is rejected before it counts as a use.","     let req = Request::get(\"/v2/_catalog\")","         .header(header::AUTHORIZATION, format!(\"Bearer {oci_token}\"))","         .body(Body::empty())","@@ -171,9 +163,8 @@ async fn oci_bearer_updates_parent_token_last_used_at() {","         .await","         .unwrap()","         .unwrap();","-    assert_eq!(parent_mid.last_used_at, parent_minted.last_used_at);","+    assert_eq!(parent_mid.last_used_at, aged);"," ","-    // An authorized request (permitted by scope and parent) updates last_used_at.","     let req = Request::get(\"/v2/acme/app/manifests/latest\")","         .header(header::AUTHORIZATION, format!(\"Bearer {oci_token}\"))","         .body(Body::empty())","@@ -181,10 +172,5 @@ async fn oci_bearer_updates_parent_token_last_used_at() {","     let res = app.clone().oneshot(req).await.unwrap();","     assert_eq!(res.status(), StatusCode::NOT_FOUND);"," ","-    let parent_after = tokens","-        .lookup_record(&raw_parent)","-        .await","-        .unwrap()","-        .unwrap();","-    assert!(parent_after.last_used_at > parent_minted.last_used_at);","+    crate::tokens::wait_for_last_use_after(&tokens, &raw_parent, aged).await;"," }"],"additions":4,"deletions":18,"truncated":false},{"path":"pnpr/crates/pnpr/tests/token_management.rs","lines":["@@ -1,13 +1,14 @@"," use std::{","     net::{Ipv4Addr, SocketAddr, SocketAddrV4},","     path::PathBuf,","+    sync::Arc,"," };"," "," use axum::{","     body::{Body, to_bytes},","     http::{Request, StatusCode, header},"," };","-use pnpr::{Config, MaxUsers, router};","+use pnpr::{AuthState, Config, MaxUsers, router, router_with_auth};"," use pnpr_fixtures::MockConfigPresets;"," use serde_json::{Value, json};"," use tempfile::TempDir;","@@ -284,7 +285,9 @@ async fn expired_token_cannot_authenticate() {"," #[tokio::test]"," async fn token_authentication_updates_last_used_at() {","     let tmp = TempDir::new().unwrap();","-    let app = router(static_config(tmp.path().to_path_buf()));","+    let auth = AuthState::in_memory();","+    let tokens = Arc::clone(&auth.tokens);","+    let app = router_with_auth(static_config(tmp.path().to_path_buf()), auth);","     let login_token = add_user_and_get_token(&app, \"alice\", \"secret123\").await;"," ","     let payload = json!({","@@ -300,6 +303,7 @@ async fn token_authentication_updates_last_used_at() {","     let new_token = body[\"token\"].as_str().unwrap();"," ","     assert_eq!(body[\"updated\"], body[\"created\"]);","+    let aged = crate::tokens::age_last_use(&tokens, new_token).await;"," ","     let whoami = app","         .clone()","@@ -307,6 +311,7 @@ async fn token_authentication_updates_last_used_at() {","         .await","         .unwrap();","     assert_eq!(whoami.status(), StatusCode::OK);","+    crate::tokens::wait_for_last_use_after(&tokens, new_token, aged).await;"," ","     let list_res = app","         .clone()","@@ -320,7 +325,7 @@ async fn token_authentication_updates_last_used_at() {","         .iter()","         .find(|token| token[\"name\"] == \"touch-test\")","         .unwrap();","-    assert!(entry[\"updated\"].is_string());","+    assert!(entry[\"updated\"].as_str().unwrap() >= entry[\"created\"].as_str().unwrap());"," }"," "," #[tokio::test]"],"additions":8,"deletions":3,"truncated":false},{"path":"pnpr/docs/endpoints.md","lines":["@@ -384,7 +384,7 @@ resolver-only server that exposes no registry surface."," | `PUT` | `/-/user/org.couchdb.user:{name}` | npm adduser/login endpoint. Creates a user only when `auth.htpasswd.max_users` allows registration; existing users can log in with the correct password. Returns a bearer token. |"," | `GET` | `/-/whoami` | Returns `{\"username\": ...}` for the authenticated caller. |"," | `GET` | `/-/npm/v1/user` | npm profile endpoint. Returns the authenticated username and placeholder profile fields. |","-| `GET` | `/-/npm/v1/tokens` | Lists bearer tokens for the authenticated caller in npm-compatible shape. |","+| `GET` | `/-/npm/v1/tokens` | Lists bearer tokens for the authenticated caller in npm-compatible shape. The server records a token's last use at most once a minute. |"," | `DELETE` | `/-/npm/v1/tokens/token/{key}` | Revokes one of the caller's tokens by listing-side token key. |"," | `DELETE` | `/-/user/token/{token}` | npm logout endpoint. Revokes the raw bearer token in the path when it belongs to the authenticated caller. |"," ",""],"additions":1,"deletions":1,"truncated":false}],"additions":365,"deletions":35,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-23T14:14:42.587895+00:00"}