{[styles.heading, { color: theme.text.default }]}>Five-star rating</Text>","+        <StarFeedback />","+      </ScrollView>","+      <FeedbackButton />","+    </View>","+  );","+}","+","+const styles = StyleSheet.create({","+  container: {","+    flex: 1,","+  },","+  content: {","+    padding: 20,","+    paddingBottom: Platform.select({ ios: 30, android: 150 }),","+  },","+  heading: {","+    fontSize: 16,","+    fontWeight: '600',","+    marginTop: 12,","+    marginBottom: 8,","+  },","+});"],"additions":40,"deletions":0,"truncated":false},{"path":"apps/observe-tester/app/(tabs)/examples/index.tsx","lines":["@@ -48,6 +48,11 @@ export default function ExamplesIndex() {","         description=\"Custom spans (startSpan / withSpan / recordSpan) and network span capture\"","         onPress={() => router.push('/examples/traces')}","       />","+      <Button","+        title=\"Feedback\"","+        description=\"reportFeedback from a form sheet, thumbs, and a star rating\"","+        onPress={() => router.push('/examples/feedback')}","+      />","     </ScrollView>","   );"," }"],"additions":5,"deletions":0,"truncated":false},{"path":"apps/observe-tester/components/FeedbackButton.tsx","lines":["@@ -0,0 +1,33 @@","+import { useRouter, useSegments } from 'expo-router';","+import { Pressable, StyleSheet, Text } from 'react-native';","+import { useSafeAreaInsets } from 'react-native-safe-area-context';","+","+export function FeedbackButton() {","+  const router = useRouter();","+  const segments = useSegments();","+  const insets = useSafeAreaInsets();","+","+  const from = `/${segments.join('/')}`;","+  // 72 adds room for the iOS floating tab bar to the 16-point margin.","+  const bottom = insets.bottom + (process.env.EXPO_OS === 'ios' ? 72 : 16);","+","+  return (","+    <Pressable","+      style={[styles.button, { bottom }]}","+      onPress={() => router.push({ pathname: '/examples/feedback/form', params: { from } })}>","+      <Text style={styles.label}>Feedback</Text>","+    </Pressable>","+  );","+}","+","+const styles = StyleSheet.create({","+  button: {","+    position: 'absolute',","+    right: 16,","+    paddingHorizontal: 16,","+    paddingVertical: 10,","+    borderRadius: 20,","+    backgroundColor: '#000',","+  },","+  label: { color: '#fff', fontWeight: '600' },","+});"],"additions":33,"deletions":0,"truncated":false},{"path":"apps/observe-tester/components/StarFeedback.tsx","lines":["@@ -0,0 +1,20 @@","+import { Observe } from 'expo-observe';","+import { Pressable, Text, View } from 'react-native';","+","+const STARS = [1, 2, 3, 4, 5];","+","+export function StarFeedback() {","+  function send(stars: number) {","+    Observe.reportFeedback({ id: 'order-rating', rating: stars, scale: { min: 1, max: 5 } });","+  }","+","+  return (","+    <View style={{ flexDirection: 'row', gap: 8 }}>","+      {STARS.map((stars) => (","+        <Pressable key={stars} accessibilityLabel={`${stars} stars`} onPress={() => send(stars)}>","+          <Text style={{ fontSize: 32 }}>★</Text>","+        </Pressable>","+      ))}","+    </View>","+  );","+}"],"additions":20,"deletions":0,"truncated":false},{"path":"apps/observe-tester/components/ThumbsFeedback.tsx","lines":["@@ -0,0 +1,15 @@","+import { Observe } from 'expo-observe';","+import { Button, View } from 'react-native';","+","+export function ThumbsFeedback() {","+  function send(rating: number) {","+    Observe.reportFeedback({ id: 'article-helpful', rating, scale: { min: 0, max: 1 } });","+  }","+","+  return (","+    <View style={{ flexDirection: 'row', gap: 12 }}>","+      <Button title=\"Thumbs down\" onPress={() => send(0)} />","+      <Button title=\"Thumbs up\" onPress={() => send(1)} />","+    </View>","+  );","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"packages/expo-app-metrics/android/src/main/java/expo/modules/appmetrics/AppMetricsModule.kt","lines":["@@ -12,6 +12,7 @@ import expo.modules.appmetrics.crashreporting.ExitInfoProviderImpl"," import expo.modules.appmetrics.crashreporting.JvmCrashHandler"," import expo.modules.appmetrics.crashreporting.PreferencesLastProcessedExitStore"," import expo.modules.appmetrics.crashreporting.attributeAndStoreCrashReport","+import expo.modules.appmetrics.logevents.FeedbackReport"," import expo.modules.appmetrics.logevents.LogEventOptions"," import expo.modules.appmetrics.networkrequests.NetworkRequestFilter"," import expo.modules.appmetrics.networkrequests.NetworkRequestMonitor","@@ -408,6 +409,13 @@ class AppMetricsModule : Module(), UpdatesStateChangeListener {","         }","       }"," ","+      Function(\"reportFeedback\") { report: FeedbackReport ->","+        val record = report.toLogRecord(mainSession.sessionId)","+        scope.launch {","+          mainSession.addLogs(listOf(record))","+        }","+      }","+","       Function(\"getMainSession\") {","         mainSession","       }"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/expo-app-metrics/android/src/main/java/expo/modules/appmetrics/logevents/EventBodyValidation.kt","lines":["@@ -18,13 +18,13 @@ private const val MAX_EVENT_BODY_LENGTH = 4096","  * logging a warning when truncation happens. Returns `null` for `null` input so","  * the call site can pass the result through unchanged.","  */","-internal fun validateEventBody(body: String?): String? {","+internal fun validateEventBody(body: String?, source: String = \"logEvent\"): String? {","   if (body == null) {","     return null","   }","   return truncateToMaxLength(","     body,","     MAX_EVENT_BODY_LENGTH,","-    \"[AppMetrics] logEvent truncated body from ${body.length} characters to the $MAX_EVENT_BODY_LENGTH-character limit.\"","+    \"[AppMetrics] $source truncated body from ${body.length} characters to the $MAX_EVENT_BODY_LENGTH-character limit.\"","   )"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/expo-app-metrics/android/src/main/java/expo/modules/appmetrics/logevents/FeedbackReport.kt","lines":["@@ -0,0 +1,49 @@","+package expo.modules.appmetrics.logevents","+","+import expo.modules.appmetrics.storage.LogRecord","+import expo.modules.appmetrics.utils.JsonAny","+import expo.modules.appmetrics.utils.TimeUtils","+import expo.modules.kotlin.records.Field","+import expo.modules.kotlin.records.Record","+import expo.modules.kotlin.types.OptimizedRecord","+","+const val FEEDBACK_LOG_NAME = \"expo.feedback\"","+","+/** User feedback from `Observe.reportFeedback`. The JS layer validates it and adds the scale to every rating. */","+@OptimizedRecord","+data class FeedbackReport(","+  @Field val id: String = \"\",","+  @Field val message: String? = null,","+  @Field val rating: Long? = null,","+  @Field val scale: FeedbackScale? = null,","+  @Field val attributes: Map<String, Any?>? = null","+) : Record {","+  fun toLogRecord(sessionId: String): LogRecord {","+    val sanitized = sanitizeLogEventAttributes(attributes, source = \"reportFeedback\")","+    // Added after sanitization, so caller attributes cannot replace them.","+    val attributes = buildMap {","+      sanitized.attributes?.let { putAll(it) }","+      put(\"expo.feedback.id\", id)","+      rating?.let { put(\"expo.feedback.rating\", it) }","+      scale?.let {","+        put(\"expo.feedback.scale.min\", it.min)","+        put(\"expo.feedback.scale.max\", it.max)","+      }","+    }","+    return LogRecord(","+      sessionId = sessionId,","+      timestamp = TimeUtils.getCurrentTimestampInISOFormat(),","+      name = FEEDBACK_LOG_NAME,","+      body = validateEventBody(message, source = \"reportFeedback\"),","+      severity = Severity.INFO.rawValue,","+      attributes = JsonAny.encodeMapToJsonString(attributes),","+      droppedAttributesCount = sanitized.droppedCount","+    )","+  }","+}","+","+@OptimizedRecord","+data class FeedbackScale(","+  @Field val min: Long = 0,","+  @Field val max: Long = 0","+) : Record"],"additions":49,"deletions":0,"truncated":false},{"path":"packages/expo-app-metrics/android/src/test/java/expo/modules/appmetrics/logevents/FeedbackReportTest.kt","lines":["@@ -0,0 +1,80 @@","+package expo.modules.appmetrics.logevents","+","+import kotlinx.serialization.json.Json","+import kotlinx.serialization.json.JsonObject","+import kotlinx.serialization.json.JsonPrimitive","+import kotlinx.serialization.json.jsonObject","+import org.junit.Assert.assertEquals","+import org.junit.Assert.assertFalse","+import org.junit.Test","+import org.junit.runner.RunWith","+import org.robolectric.RobolectricTestRunner","+import org.robolectric.annotation.Config","+","+@RunWith(RobolectricTestRunner::class)","+@Config(manifest = Config.NONE, sdk = [28])","+class FeedbackReportTest {","+  private fun attributesOf(report: FeedbackReport): JsonObject =","+    Json.parseToJsonElement(report.toLogRecord(sessionId = \"s\").attributes!!).jsonObject","+","+  @Test","+  fun `records an expo_feedback event with the id, rating, and message`() {","+    val report = FeedbackReport(id = \"checkout\", message = \"Great\", rating = 7, attributes = mapOf(\"plan\" to \"pro\"))","+    val record = report.toLogRecord(sessionId = \"s\")","+    val attributes = attributesOf(report)","+","+    assertEquals(\"expo.feedback\", record.name)","+    assertEquals(\"Great\", record.body)","+    assertEquals(\"info\", record.severity)","+    assertEquals(JsonPrimitive(\"checkout\"), attributes[\"expo.feedback.id\"])","+    assertEquals(JsonPrimitive(7), attributes[\"expo.feedback.rating\"])","+    assertEquals(JsonPrimitive(\"pro\"), attributes[\"plan\"])","+  }","+","+  @Test","+  fun `records the rating scale`() {","+    val attributes = attributesOf(FeedbackReport(id = \"checkout\", rating = 4, scale = FeedbackScale(min = 1, max = 5)))","+","+    assertEquals(JsonPrimitive(4), attributes[\"expo.feedback.rating\"])","+    assertEquals(JsonPrimitive(1), attributes[\"expo.feedback.scale.min\"])","+    assertEquals(JsonPrimitive(5), attributes[\"expo.feedback.scale.max\"])","+  }","+","+  @Test","+  fun `user attributes cannot overwrite the feedback attributes`() {","+    val report = FeedbackReport(","+      id = \"checkout\",","+      rating = 3,","+      scale = FeedbackScale(min = 0, max = 10),","+      attributes = mapOf(","+        \"expo.feedback.id\" to \"spoofed\",","+        \"expo.feedback.rating\" to 10,","+        \"expo.feedback.scale.min\" to 5,","+        \"expo.feedback.scale.max\" to 5","+      )","+    )","+    val attributes = attributesOf(report)","+","+    assertEquals(JsonPrimitive(\"checkout\"), attributes[\"expo.feedback.id\"])","+    assertEquals(JsonPrimitive(3), attributes[\"expo.feedback.rating\"])","+    assertEquals(JsonPrimitive(0), attributes[\"expo.feedback.scale.min\"])","+    assertEquals(JsonPrimitive(10), attributes[\"expo.feedback.scale.max\"])","+    assertEquals(4, report.toLogRecord(sessionId = \"s\").droppedAttributesCount)","+  }","+","+  @Test","+  fun `omits the rating and scale attributes when no rating is set`() {","+    val attributes = attributesOf(FeedbackReport(id = \"checkout\", message = \"Great\"))","+","+    assertFalse(attributes.containsKey(\"expo.feedback.rating\"))","+    assertFalse(attributes.containsKey(\"expo.feedback.scale.min\"))","+    assertFalse(attributes.containsKey(\"expo.feedback.scale.max\"))","+  }","+","+  @Test","+  fun `cuts the message to 4096 characters`() {","+    val record = FeedbackReport(id = \"checkout\", message = \"a\".repeat(5000)).toLogRecord(sessionId = \"s\")","+","+    assertEquals(4096, record.body?.length)","+  }","+}"],"additions":80,"deletions":0,"truncated":false},{"path":"packages/expo-app-metrics/ios/AppMetricsModule.swift","lines":["@@ -171,6 +171,13 @@ public final class AppMetricsModule: Module, UpdatesStateChangeListener {","       }","     }"," ","+    Function(\"reportFeedback\") { (report: FeedbackReport) in","+      let record = report.toLogRecord()","+      AppMetricsActor.isolated {","+        AppMetrics.mainSession.receiveLog(record)","+      }","+    }","+","     Class(NetworkRequestObserver.self) {","       Constructor { (filter: NetworkRequestFilter?) in","         return NetworkRequestObserver(filter: filter)"],"additions":7,"deletions":0,"truncated":false},{"path":"packages/expo-app-metrics/ios/LogEvents/EventBodyValidation.swift","lines":["@@ -9,7 +9,7 @@ private let maxEventBodyLength = 4096"," /// Truncates a caller-provided log event body to `maxEventBodyLength` characters,"," /// logging a warning when truncation happens. Returns `nil` for `nil` input so"," /// the call site can pass the result through unchanged.","-func validateEventBody(_ body: String?) -> String? {","+func validateEventBody(_ body: String?, source: String = \"logEvent\") -> String? {","   guard let body else {","     return nil","   }","@@ -17,7 +17,7 @@ func validateEventBody(_ body: String?) -> String? {","     body,","     maxLength: maxEventBodyLength,","     warningMessage:","-      \"[AppMetrics] logEvent truncated body from \\(body.count) characters \"","+      \"[AppMetrics] \\(source) truncated body from \\(body.count) characters \"","       + \"to the \\(maxEventBodyLength)-character limit.\"","   )"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/expo-app-metrics/ios/LogEvents/FeedbackReport.swift","lines":["@@ -0,0 +1,39 @@","+// Copyright 2025-present 650 Industries. All rights reserved.","+","+import ExpoModulesCore","+","+public let feedbackLogName = \"expo.feedback\"","+","+/// User feedback from `Observe.reportFeedback`. The JS layer validates it and adds the scale to every rating.","+struct FeedbackReport: Record {","+  @Field var id: String = \"\"","+  @Field var message: String?","+  @Field var rating: Int?","+  @Field var scale: FeedbackScale?","+  @Field var attributes: [String: Any]?","+","+  func toLogRecord() -> LogRecord {","+    let sanitized = sanitizeLogEventAttributes(attributes, source: \"reportFeedback\")","+    // Added after sanitization, so caller attributes cannot replace them.","+    var attributes = sanitized.attributes ?? [:]","+    attributes[\"expo.feedback.id\"] = id","+    if let rating {","+      attributes[\"expo.feedback.rating\"] = rating","+    }","+    if let scale {","+      attributes[\"expo.feedback.scale.min\"] = scale.min","+      attributes[\"expo.feedback.scale.max\"] = scale.max","+    }","+    return LogRecord(","+      name: feedbackLogName,","+      body: validateEventBody(message, source: \"reportFeedback\"),","+      attributes: attributes,","+      droppedAttributesCount: sanitized.droppedCount","+    )","+  }","+}","+","+struct FeedbackScale: Record {","+  @Field var min: Int = 0","+  @Field var max: Int = 0","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"packages/expo-app-metrics/ios/Tests/FeedbackReportTests.swift","lines":["@@ -0,0 +1,92 @@","+// Copyright 2025-present 650 Industries. All rights reserved.","+","+import Testing","+","+@testable import ExpoAppMetrics","+","+@Suite(\"FeedbackReport\")","+struct FeedbackReportTests {","+  private func report(","+    id: String = \"checkout\",","+    message: String? = nil,","+    rating: Int? = nil,","+    scale: FeedbackScale? = nil,","+    attributes: [String: Any]? = nil","+  ) -> FeedbackReport {","+    var report = FeedbackReport()","+    report.id = id","+    report.message = message","+    report.rating = rating","+    report.scale = scale","+    report.attributes = attributes","+    return report","+  }","+","+  private func scale(min: Int, max: Int) -> FeedbackScale {","+    var scale = FeedbackScale()","+    scale.min = min","+    scale.max = max","+    return scale","+  }","+","+  @Test","+  func `records an expo.feedback event with the id, rating, and message`() throws {","+    let record = report(message: \"Great\", rating: 7, attributes: [\"plan\": \"pro\"]).toLogRecord()","+","+    let attributes = try #require(record.attributes?.value as? [String: Any])","+    #expect(record.name == \"expo.feedback\")","+    #expect(record.body