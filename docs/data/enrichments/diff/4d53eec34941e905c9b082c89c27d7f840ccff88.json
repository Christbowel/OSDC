range raws {","+\t\t\tif raw == nil || len(raw.Raw) == 0 {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tvar decoded interface{}","+\t\t\tif err := json.Unmarshal(raw.Raw, &decoded); err != nil {","+\t\t\t\t// Malformed properties are reported by the step's own parsing.","+\t\t\t\t//nolint:nilerr // reported elsewhere, deliberately not twice","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif !celtemplate.HasExpression(decoded) {","+\t\t\t\tcontinue","+\t\t\t}","+\t\t\tif pCtx == nil {","+\t\t\t\tpCtx = velaprocess.NewContext(appfile.GenerateContextDataFromAppFile(af, name))","+\t\t\t\t// The step's own identity. context.name is the step here too, but only by","+\t\t\t\t// coincidence of how the context is built - stepName says what it is, and","+\t\t\t\t// is what a source resolving on this surface can rely on.","+\t\t\t\tpCtx.PushData(velaprocess.ContextStepName, name)","+\t\t\t\tpCtx.PushData(velaprocess.ContextStepType, stepType)","+\t\t\t}","+\t\t\tresolved, err := sources.ResolveSourceExpressions(pCtx, decoded, sources.SurfaceWorkflowStep)","+\t\t\tif err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t\tout, err := json.Marshal(resolved)","+\t\t\tif err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t\traw.Raw = out"," \t\t}","-\t\traw.Raw = out","-\t\tif record != nil {","+\t\tif record != nil && pCtx != nil {"," \t\t\tstatuses, _ := pCtx.GetData(sources.SourceResolutionStatusKey).(map[string]sources.SourceResolutionStatus)"," \t\t\trecord(name, stepType, statuses)"," \t\t}","@@ -642,9 +651,17 @@ func resolveWorkflowStepSources(af *appfile.Appfile, steps []wfTypesv1alpha1.Wor"," \t}"," "," \tfor i := range steps {","-\t\tif err := substitute(steps[i].Name, steps[i].Type, steps[i].Properties); err != nil {","+\t\t// forEach.items resolves here too, so the engine only ever receives a list.","+\t\tvar items *runtime.RawExtension","+\t\tif forEach := steps[i].ForEach; forEach != nil && forEach.Items != nil {","+\t\t\titems = &runtime.RawExtension{Raw: forEach.Items.Raw}","+\